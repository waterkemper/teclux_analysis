end;

procedure TdtmImpostos.Setartrib_imposto_ClassTrib;
begin
  if (qryTrib_Regraid_situacao.AsLargeInt <>
      qrytrib_imposto_situacaoid_situacao.AsLargeInt) or

      (qryTrib_Regracclasstrib.AsString <>
       qrytrib_imposto_classtribcclasstrib.AsString) then

  begin
    qryTrib_Regra.edit;
    qryTrib_Regraid_situacao.AsLargeInt :=
      qrytrib_imposto_situacaoid_situacao.AsLargeInt;


    qryTrib_Regra.edit;
    qryTrib_Regracclasstrib.AsString :=
      qrytrib_imposto_classtribcclasstrib.AsString;
    qryTrib_Regra.post;

  end
  else
  begin
    qryTrib_Regra.edit;
    qryTrib_Regraid_situacao.clear;
    qryTrib_Regra.edit;
    qryTrib_Regracclasstrib.clear;
    qryTrib_Regra.post;
  end;



end;

