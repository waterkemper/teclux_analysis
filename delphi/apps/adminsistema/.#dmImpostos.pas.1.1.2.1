procedure TdtmImpostos.qryTrib_RegraAfterScroll(DataSet: TDataSet);
begin
  inherited;

  RefazConsultaPorNome(qryEvento_Fiscal,
     ['id_regra','id_imposto'],
     [qryTrib_Regraid_regra.asinteger, qryTrib_Regraid_imposto.asinteger]);

  RefazConsultaPorNome(qryTrib_FinalidadeNFe,
     ['id_regra'],
     [qryTrib_Regraid_regra.asinteger]);

  RefazConsultaPorNome(qrymodalidadebc_icms,
     ['id_regra'],
     [qryTrib_Regraid_regra.asinteger]);

  RefazConsultaPorNome(qrymodalidadebc_icms_st,
     ['id_regra'],
     [qryTrib_Regraid_regra.asinteger]);

  RefazConsultaPorNome(qrytrib_tipodocumento,
     ['id_regra'],
     [qryTrib_Regraid_regra.asinteger]);

  RefazConsultaPorNome(qryTrib_Regime_Emissor,
     ['id_regra'],
     [qryTrib_Regraid_regra.asinteger]);

  RefazConsultaPorNome(qryTrib_Regime_Destinatario,
     ['id_regra'],
     [qryTrib_Regraid_regra.asinteger]);
                             
  RefazConsultaPorNome(qryOrigemMercadorias,
     ['id_regra'],
     [qryTrib_Regraid_regra.asinteger]);

  RefazConsultaPorNome(qrynfe_natureza_operacao,
     ['id_regra','contexto'],
     [qryTrib_Regraid_regra.asinteger,
      qryTrib_Regracontexto.asString]);

  RefazConsultaPorNome(qryCodigosFiscais,
     ['id_regra'],
     [qryTrib_Regraid_regra.asinteger]);

  RefazConsultaPorNome(qrytrib_grupo_ncm,
     ['id_regra'],
     [qryTrib_Regraid_regra.asinteger]);

  qrytrib_grupo_ncm_itens.close;
  qrytrib_grupo_ncm_itens.open;

  RefazConsultaPorNome(qryEstadosOrigem,
     ['id_regra'],
     [qryTrib_Regraid_regra.asinteger]);

  RefazConsultaPorNome(qryEstadosDestino,
     ['id_regra'],
     [qryTrib_Regraid_regra.asinteger]);





end;

