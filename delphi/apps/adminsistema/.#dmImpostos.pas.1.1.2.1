    if valor then
    begin
      qryTrib_Impostocodigo_cst_default.AsString := qrytrib_imposto_classtribcodigo_cst.asString;
      qryTrib_Impostocclasstrib_default.AsString := qrytrib_imposto_classtribcclasstrib.AsString;
    end
    else
    begin
      qryTrib_Impostocodigo_cst_default.clear;
      qryTrib_Impostocclasstrib_default.clear;
    end;
    qrytrib_imposto.post;
  end;

begin
  inherited;
