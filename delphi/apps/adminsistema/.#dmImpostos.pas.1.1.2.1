function TdtmImpostos.GravarRegra(

      CKBsIMDesstinatarioContribICMS,
      ckbNaoDesstinatarioContribICMS,
      ckbSimDestinatarioOrgaoPublico,
      ckbNaoDestinatarioOrgaoPublico,
      ckbSimDestinatarioConsumidorFinal,
      ckbNaoDestinatarioConsumidorFinal: Boolean

)
: Boolean;
var
 Criterio: string;

begin
  result := qrytrib_grupo_ncm.CheckRequiredFields(true, false, true, self.Owner, true, false);

  if result then
  begin
    Criterio := '';

    Criterio := MergeJsonObjects(Criterio,
      BuildBoolChoiceCriterioJson('contribuinteIcms', CKBsIMDesstinatarioContribICMS, ckbNaoDesstinatarioContribICMS));

    Criterio := MergeJsonObjects(Criterio,
      BuildBoolChoiceCriterioJson('orgaoPublico', ckbSimDestinatarioOrgaoPublico, ckbNaoDestinatarioOrgaoPublico));

    Criterio := MergeJsonObjects(Criterio,
      BuildBoolChoiceCriterioJson('consumidorFinal', ckbSimDestinatarioConsumidorFinal, ckbNaoDestinatarioConsumidorFinal));


    Criterio := MergeJsonObjects(Criterio,
      BuildCriterioJsonFromDataSet('trib_tipodocumento', qrytrib_tipodocumento, 'codigo', 'selecionado', jvkInt));

    Criterio := MergeJsonObjects(Criterio,
      BuildCriterioJsonFromDataSet('trib_finalidadenfe', qryTrib_FinalidadeNFe, 'codigo', 'selecionado', jvkInt));

    Criterio := MergeJsonObjects(Criterio,
      BuildCriterioJsonFromDataSet('regime_emissor', qryTrib_Regime_Emissor, 'codigo', 'selecionado', jvkInt));

    Criterio := MergeJsonObjects(Criterio,
      BuildCriterioJsonFromDataSet('regime_destinatario', qryTrib_Regime_destinatario, 'codigo', 'selecionado', jvkInt));

    Criterio := MergeJsonObjects(Criterio,
      BuildCriterioJsonFromDataSet('origemmercadorias', qryOrigemMercadorias, 'codigo', 'selecionado', jvkInt));
                                    
    Criterio := MergeJsonObjects(Criterio,
      BuildCriterioJsonFromDataSet('modalidadebc_icms', qrymodalidadebc_icms, 'codigo', 'selecionado', jvkInt));

    Criterio := MergeJsonObjects(Criterio,
      BuildCriterioJsonFromDataSet('modalidadebc_icms_st', qrymodalidadebc_icms_st, 'codigo', 'selecionado', jvkInt));

    Criterio := MergeJsonObjects(Criterio,
      BuildCriterioJsonFromDataSet('estados_origem', qryEstadosOrigem, 'codigo', 'selecionado', jvkString));

    Criterio := MergeJsonObjects(Criterio,
      BuildCriterioJsonFromDataSet('estados_destino', qryEstadosDestino, 'codigo', 'selecionado', jvkString));

    Criterio := MergeJsonObjects(Criterio,
      BuildCriterioJsonFromDataSet('evento_fiscal', qryEvento_Fiscal, 'codigo', 'selecionado', jvkString));

    Criterio := MergeJsonObjects(Criterio,
      BuildCriterioJsonFromTwoDataSet(
          qrynfe_natureza_operacao,   // dsNatureza
          qryCodigosFiscais,     // dsCodigos

          'operacao_cf',         // KeyName
          'id_natureza',
          'id_natureza',         // FieldIdNaturezaNat

          'codigo',
          'codigo',            // FieldOperacaoNat  (VENDA_MERCADORIA)
          'selecionado',         // FieldSelecionadoNat

          'codigosfiscais',

          'id_natureza',         // FieldIdNaturezaCod
          'codigo',                // FieldCodigoFiscal (ou CODIGO)
          'selecionado',         // FieldSelecionadoCod

          jvkInt                 // CFOP inteiro
        ));

    Criterio := MergeJsonObjects(Criterio,
      BuildCriterioJsonFromTwoDataSet(
          qrytrib_grupo_ncm,   // dsNatureza
          qrytrib_grupo_ncm_itens,     // dsCodigos

          'grupo_ncm_itens',         // KeyName
          'id_grupo',
          'id_grupo',         // FieldIdNaturezaNat
          'codigo',
          'codigo',            // FieldOperacaoNat  (VENDA_MERCADORIA)
          'selecionado',         // FieldSelecionadoNat

          'ncm_itens',

          'id_grupo',         // FieldIdNaturezaCod
          'ncm',                // FieldCodigoFiscal (ou CODIGO)
          '',         // FieldSelecionadoCod

          jvkInt                 // CFOP inteiro
        ));


    result := perpetrar([qryTrib_Regra, qrytrib_grupo_ncm, qrytrib_grupo_ncm_itens]);

    if result then
    begin
      qryUpdateTrib_Regra_criterio.ParamByName('id_regra').asinteger :=
        qryTrib_Regraid_regra.asinteger;
      qryUpdateTrib_Regra_criterio.ParamByName('criterio_text').asString :=
        Criterio;
      qryUpdateTrib_Regra_criterio.ExecSql;

      perpetrar([]);

      qryTrib_Imposto.post;
    end;


    if result then
    begin
      if not qryTrib_Impostoagrupamento.IsNull then
      begin
        qryUpdateTrib_Regra_CBSIBS.ParamByName('p_id_regra_origem').AsInteger :=
          qryTrib_Regraid_regra.AsInteger;
        qryUpdateTrib_Regra_CBSIBS.ParamByName('p_aliquota_ibusuf').AsCurrency :=
         qryTrib_Regraaliquota_ibsuf.AsCurrency;
        qryUpdateTrib_Regra_CBSIBS.ParamByName('p_aliquota_ibsmun').AsCurrency :=
         qryTrib_Regraaliquota_ibsmun.AsCurrency;
        qryUpdateTrib_Regra_CBSIBS.execsql;
        perpetrar([]);
      end;
    end;

  end;

end;


