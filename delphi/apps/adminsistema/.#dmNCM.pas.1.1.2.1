begin
  result := qryConsultaTipoPagamento;
end;

function TdtmNCM.ExisteTabelaTipoPagamento(
  NomeCampo: String; Value: Variant): boolean;
begin
  result:=ExisteCodigo(qryConsultaTipoPagamento, NomeCampo, Value);
end;

