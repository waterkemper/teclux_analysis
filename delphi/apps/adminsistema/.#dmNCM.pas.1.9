    UltimoMVAProdutosNCM := qryMVAProdutosNCMItem.asinteger;

  qryMVAProdutosNCMGrupo.AsInteger := qryMVAGruposGrupo.asinteger;
end;

procedure TdtmNCM.qryMVAGruposBeforePost(DataSet: TDataSet);
