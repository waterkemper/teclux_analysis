  object qryAgencias: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterDelete = qryAgenciasAfterDelete
    AfterScroll = qryAgenciasAfterScroll
    OnDeleteError = PostError
    OnEditError = PostError
    OnPostError = PostError
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select a.*,'
      '       (Select c.nome From cidades c Where (c.estado = a.estado)'
      
        '                                       and (c.codigo = a.cidade)' +
        ') as nomecidade,'
      '       (Select b.nome From bairros b Where (b.estado = a.estado)'
      
        '                                        and (b.cidade = a.cidade' +
        ')'
      
        '                                        and (b.codigo = a.bairro' +
        ')) as nomebairro'
      'From agencias a'
      'Where a.banco = :banco'
      'order by a.codigo')
    RequestLive = True
    Left = 69
    Top = 88
    ParamData = <
      item
        DataType = ftInteger
        Name = 'banco'
        ParamType = ptUnknown
      end>
