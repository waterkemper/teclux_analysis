    Macros = <>
    Sql.Strings = (
      'SELECT b.Sigla,'
      '       b.Nome,'
      '       b.Codigo'
      ''
      'FROM   bancos b'
      ''
      'WHERE  b.Inativo IS NULL'
      ''
      'ORDER BY UPPER(TO_ASCII(b.sigla,'#39'LATIN1'#39'))')
    RequestLive = False
    Left = 287
    Top = 15
