implementation


{$R *.dfm}

procedure TdtmCadastroBancos.AbrirTabelas(TipoPesquisa: TtecCadastroBancos);
begin
  case TipoPesquisa of
    tcbBANCOS       : Abre(ctConsultaBancos);
    tcbMODELOSCHEQUE: Abre(ctConsultaModelosCheques);
  end;
end;

constructor TdtmCadastroBancos.Create(AOwner: TComponent);
begin
  inherited;
  qryBancos.        Tag:= ctTabelas;
  qryAgencias.      Tag:= ctTabelas;
  qryContas.        Tag:= ctTabelas;
  qryModelosCheque. Tag:= ctTabelas;

  qryConsultaBancos. Tag:= ctConsultaBancos;
  qryConsultaModelos.Tag:= ctConsultaModelosCheques;
end;

function TdtmCadastroBancos.ExcluirContas: Boolean;
begin
  Result:= True;
  if MensagemConfirmacao(Format(ctCONFIRMEEXCLUIR, ['a CONTA'])) = smbOk then begin
    if not qryContas.IsEmpty then
       qryContas.Delete
    else
       qryContas.Cancel;
    Perpetrar([qryContas]);
  end;
  Result:= True;
end;

function TdtmCadastroBancos.ExcluirAgencia: Boolean;
begin
  Result:= True;
  if MensagemConfirmacao(Format(ctCONFIRMEEXCLUIR, ['a AGÊNCIA'])) = smbOk then begin
    if not qryAgencias.IsEmpty then
       qryAgencias.Delete
    else
       qryAgencias.Cancel;
    Perpetrar([qryAgencias, qryContas]);
  end;
  Result:= True;
end;

function TdtmCadastroBancos.ExcluirBancos: Boolean;
begin
  if MensagemConfirmacao(Format(ctCONFIRMEEXCLUIR, ['o BANCO'])) = smbOk then begin
    if not (qryBancos.IsEmpty) then
       qryBancos.Delete
    else
       qryBancos.Cancel;
    Perpetrar([qryBancos]);
  end;
  Result:= True;
end;

function TdtmCadastroBancos.ExisteBanco(campo, codigo: string): boolean;
begin
  Result:= ExisteCodigo(qryConsultaBancos, campo, codigo);
end;

function TdtmCadastroBancos.ExisteCodigoAgencia(campo, codigo: String): boolean;
begin
  Result:= ExisteCodigo(qryAgencias, campo, codigo);
end;

function TdtmCadastroBancos.ExisteConta(campo, codigo: String): boolean;
begin
  Result:= ExisteCodigo(qryContas, campo, codigo);
end;

function TdtmCadastroBancos.ExisteModeloCheque(campo, codigo: string): boolean;
begin
  Result:= ExisteCodigo(qryConsultaModelos, campo, codigo);
end;

procedure TdtmCadastroBancos.FecharTabelas(TipoPesquisa: TtecCadastroBancos);
begin
  case TipoPesquisa of
    tcbBANCOS       : Fecha(ctConsultaBancos);
    tcbMODELOSCHEQUE: Fecha(ctConsultaModelosCheques);
  end;
end;

