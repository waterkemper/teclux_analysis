begin
  Result := qryAgencias;
end;

function TdtmCadastroBancos.GetTabelaContas: TZDataset;
begin
  Result := qryContas;
end;

function TdtmCadastroBancos.GetTabelaBancos: TZDataSet;
begin
  Result:= qryBancos;
end;

function TdtmCadastroBancos.GetTabelaConsultarBanco: TTecQuery;
begin
  Result := qryConsultaBancos;
end;

function TdtmCadastroBancos.GetTabelaConsultarModeloCheque: TtecQuery;
begin
  Result:= qryConsultaModelos;
end;

function TdtmCadastroBancos.GravarAgencia: Boolean;
begin
  qryAgenciasBanco.Value := qryBancosCodigo.Value;
  Result:=False;
  if qryAgencias.CheckRequiredFields then begin
     qryAgencias.Post;
     if not (qryBancos.State in [dsedit, dsinsert]) then
        qryBancos.Edit;

    Result := True;
  end;  
end;

function TdtmCadastroBancos.GravarConta: Boolean;
begin
  qryContasBanco.AsInteger   := qryBancosCodigo.AsInteger;
  qryContasAgencia.AsInteger := qryAgenciasCodigo.AsInteger;
  if qryContasbancoreferencia.AsString = '' then
    qryContasbancoreferencia.clear;

  Result:=False;
  if qryContasNrViasBoleto.AsInteger = 0 then
    qryContasNrViasBoleto.AsInteger := 1;


  if qryContas.CheckRequiredFields then
     qryContas.Post;

  if not (qryBancos.State in [dsedit, dsinsert]) then
     qryBancos.Edit;
end;

function TdtmCadastroBancos.GravarBancos: Boolean;
var
 RegistroAtual: TBookMark;
begin
  Result:=False;
  if qryBancos.CheckRequiredFields then
  begin
    try
     qryContas.DisableControls;
     RegistroAtual := qryContas.GetBookmark;
     qryContas.First;
     While not qryContas.Eof do
     begin
      qryContas.Edit;
      qryContasBanco.Value   := qryBancosCodigo.Value;
      qryContasAgencia.Value := qryAgenciasCodigo.Value;
      qryContas.Post;
      qryContas.Next;
     end;
    finally
     qryContas.GotoBookmark(RegistroAtual);
     qryContas.FreeBookmark(RegistroAtual);
     qryContas.EnableControls;
    end;

    Try
     qryAgencias.DisableControls;
     RegistroAtual := qryAgencias.GetBookmark;
     qryAgencias.First;
     While not qryAgencias.Eof do
     begin
      qryAgencias.Edit;
      qryAgenciasbanco.Value:=qryBancoscodigo.Value;
      qryAgencias.Post;
      qryAgencias.Next;
     end;
    finally
     qryAgencias.GotoBookmark(RegistroAtual);
     qryAgencias.FreeBookmark(RegistroAtual);
     qryAgencias.EnableControls;
    end;

    qryBancos.Post;
    Perpetrar([qryBancos, qryAgencias, qryContas]);
    Result := True;
  end;
end;

function TdtmCadastroBancos.IncluirAgencias(Editar: boolean): Boolean;
begin
  if not editar or qryAgencias.IsEmpty then
    qryAgencias.Append;
  Result:=True;
end;

function TdtmCadastroBancos.IncluirContas(Editar: boolean): Boolean;
begin
  if not editar or qryContas.IsEmpty then begin
     qryContas.Append;
     qryContasBanco.Value   := qryBancosCodigo.Value;
     qryContasAgencia.Value := qryAgenciasCodigo.Value;
     qryContas.Edit;
  end;
  Result:=True;
end;

function TdtmCadastroBancos.IncluirBancos: Boolean;
begin
  qryBancos.Insert;
  Result := True;
end;

procedure TdtmCadastroBancos.qryAgenciasAfterDelete(DataSet: TDataSet);
begin
  inherited;
  if not (qryBancos.State in [dsEdit, dsInsert]) then
    qryBancos.Edit;
end;

procedure TdtmCadastroBancos.qryAgenciasGRIDAfterDelete(DataSet: TDataSet);
begin
  inherited;
  if not (qryBancos.State in [dsEdit, dsInsert]) then
     qryBancos.Edit;
end;

procedure TdtmCadastroBancos.qryContasGRIDAfterDelete(DataSet: TDataSet);
begin
  inherited;
  if not (qryBancos.State in [dsEdit, dsInsert]) then
     qryBancos.Edit;
end;

procedure TdtmCadastroBancos.qryBancosAfterScroll(DataSet: TDataSet);
begin
  inherited;
  ReFazConsulta(qryAgencias,[0],[qryBancosCodigo.AsInteger]);
  ReFazConsulta(qryContas,[0,1],
    [qryAgenciasBanco.AsInteger,
     qryAgenciasCodigo.AsInteger]);
end;

procedure TdtmCadastroBancos.Selecionar(TipoPesquisa: TtecCadastroBancos);
begin
  case TipoPesquisa of
    tcbBANCOS       : ReFazConsulta(qryBancos,[0],[qryConsultaBancoscodigo.AsInteger]);
    tcbMODELOSCHEQUE: begin
                        qryBancos.Edit;
                        qryBancosmodelocheque.AsInteger:= qryConsultaModelosCodigo.AsInteger;
                      end;
  end;
end;


procedure TdtmCadastroBancos.SetCodigoAgencia(const Value: String);
begin
  FCodigoAgencia := Value;
end;

procedure TdtmCadastroBancos.SetNumeroConta(const Value: String);
begin
  FNumeroConta := Value;
end;


procedure TdtmCadastroBancos.SetDigitoConta(const Value: String);
begin
  FDigitoConta := Value;
end;

procedure TdtmCadastroBancos.qryAgenciasAfterScroll(DataSet: TDataSet);
begin
  inherited;
  CodigoAgencia := qryAgenciascodigo.AsString;
end;

procedure TdtmCadastroBancos.VerificarAgencia(Agencia: String);
begin
  if (Agencia <> CodigoAgencia) then
  begin
   qryAgencias.Cancel;
   if not qryAgencias.Locate('codigo', Agencia,[]) then
   begin
    IncluirAgencias(false);
    qryAgenciascodigo.AsString:=Agencia;
   end;
  end;
end;

procedure TdtmCadastroBancos.qryContasAfterDelete(DataSet: TDataSet);
begin
  inherited;
  if not (qryBancos.State in [dsEdit, dsInsert]) then
     qryBancos.Edit;
end;


procedure TdtmCadastroBancos.qryContasNewRecord(DataSet: TDataSet);
begin
  inherited;
  qryContasFluxoCaixa.  AsBoolean:= false;
  qryContasNrViasBoleto.AsInteger:= 1;
  qryContasPadraoCNAB.  AsString := '4'; 
end;

end.
