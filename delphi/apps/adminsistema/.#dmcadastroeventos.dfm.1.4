        '             and codigo <> :codigoselecionado) as nanaliticasult' +
        'ima'
      ''
      ''
      'FROM     eventos e'
      ''
      'WHERE e.tipo = '#39'S'#39'   '
      '     AND e.Inativo IS NULL'
      '%WhereClassificacao'
      ''
      'ORDER BY e.classificacao')
