procedure TdtmCadastroServicos.dsrServicosDataChange(Sender: TObject;
  Field: TField);
begin
  inherited;
  if Field = qryServicosdebitarvendaavista then
    qryProcuraCreditaraVista.Params[1].AsInteger := qryServicosdebitarvendaavista.AsInteger
  else if field = qryServicoscreditarvendaavista then
    qryProcuraDebitaraVista.Params[1].AsInteger := qryServicoscreditarvendaavista.AsInteger
  else if Field = qryServicosdebitarvendaaprazo then
    qryProcuraCreditaraPrazo.Params[1].AsInteger := qryServicosdebitarvendaaprazo.AsInteger
  else if field = qryServicoscreditarvendaaprazo then
    qryProcuraDebitaraPrazo.Params[1].AsInteger := qryServicoscreditarvendaaprazo.AsInteger
  else if Field = qryServicosdebitarabatimentos then
    qryProcuraCreditarAbatimentos.Params[1].AsInteger := qryServicosdebitarabatimentos.AsInteger
  else if field = qryServicoscreditarabatimentos then
    qryProcuraDebitarAbatimentos.Params[1].AsInteger := qryServicoscreditarabatimentos.AsInteger
  else if Field = qryServicosdebitardevolucoes then
    qryProcuraCreditarDevolucoes.Params[1].AsInteger := qryServicosdebitardevolucoes.AsInteger
  else if field = qryServicoscreditardevolucoes then
    qryProcuraDebitarDevolucoes.Params[1].AsInteger := qryServicoscreditardevolucoes.AsInteger
  else
  if field = qryServicoscnae then
    RefazConsultapornome(qryListaAtividadesEconomicasMunicipios, ['servico','codigo'], [qryServicoscodigo.asinteger, qryServicoscnae.asinteger]);
    
end;

procedure TdtmCadastroServicos.AtribuirContasContabeisPadrao;
var
 i: byte;
begin
  if not qryParametrosContas.Active then
    qryParametrosContas.Open;
  if not (qryServicos.State in [dsinsert, dsedit]) then
    qryServicos.Edit;

  for i:=0 to qryParametrosContas.FieldCount-1 do
    qryservicos.FieldByName(qryParametrosContas.Fields[i].fieldname).asstring :=
      qryParametrosContas.Fields[i].AsString
end;

procedure TdtmCadastroServicos.qryServicosNewRecord(DataSet: TDataSet);
begin
  inherited;
  qryServicoscomissao.AsFloat:= 0;
  qryServicostipocomissao.AsString:= '%';
  qryServicoscomissaoindicador.AsFloat:= 0;
  qryServicostipocomissaoindicador.AsString:= '%';

  if ParSistema.GerarContabilidade then
    AtribuirContasContabeisPadrao;
end;

procedure TdtmCadastroServicos.MarcarAtividadeMunicipioAtiva;
begin

   if not qryListaAtividadesEconomicasMunicipiosativo.asboolean then
   begin

     qryServicos.edit;

     qryListaAtividadesEconomicasMunicipios.edit;
     qryListaAtividadesEconomicasMunicipiosativo.asboolean := true;
     qryListaAtividadesEconomicasMunicipios.post;

     AtribuirDados(qryListaAtividadesEconomicasMunicipios,
       [qryListaAtividadesEconomicasMunicipiosativo],
       [false],
       [qryListaAtividadesEconomicasMunicipioscidadeibge,
        qryListaAtividadesEconomicasMunicipiosidcnae],
       [qryListaAtividadesEconomicasMunicipioscidadeibge.asinteger,
        qryListaAtividadesEconomicasMunicipiosidcnae.asinteger],
       ['=','<>'],
       true, false);

   end;
end;

procedure TdtmCadastroServicos.AtualizarrAtividadeMunicipioAtiva;
begin
  RefazConsultapornome(qryServicosAtividadesEconomicasMunicipios, ['servico','atividade'],
          [qryServicoscodigo.asinteger, qryServicoscnae.asinteger]);

  qryListaAtividadesEconomicasMunicipios.first;

  while not qryListaAtividadesEconomicasMunicipios.eof do
  begin
    if qryListaAtividadesEconomicasMunicipiosativo.asBoolean then
    begin

      if qryServicosAtividadesEconomicasMunicipios.locate('atividade;cidadeibge',
             VarArrayOf([qryListaAtividadesEconomicasMunicipioscodigo.asinteger,
                         qryListaAtividadesEconomicasMunicipioscidadeibge.asinteger]), []) then
      begin
        qryServicosAtividadesEconomicasMunicipios.edit;
        qryservicosAtividadesEconomicasMunicipioscodigoatividademunicipio.asinteger :=
          qryListaAtividadesEconomicasMunicipioscodigoatividademunicipio.asinteger;
        qryServicosAtividadesEconomicasMunicipios.post;
      end
      else
      begin
        qryServicosAtividadesEconomicasMunicipios.append;
        qryservicosAtividadesEconomicasMunicipiosservico.asinteger := qryservicoscodigo.asinteger;
        qryservicosAtividadesEconomicasMunicipiosatividade.asinteger := qryListaAtividadesEconomicasMunicipioscodigo.asinteger;
        qryservicosAtividadesEconomicasMunicipioscodigoatividademunicipio.asinteger := qryListaAtividadesEconomicasMunicipioscodigoatividademunicipio.asinteger;
        qryServicosAtividadesEconomicasMunicipios.post;
      end;

    end;
    qryListaAtividadesEconomicasMunicipios.next;
  end;

end;

procedure TdtmCadastroServicos.qryServicosAfterScroll(DataSet: TDataSet);
begin
  inherited;
  RefazConsultapornome(qryListaAtividadesEconomicasMunicipios, ['servico','codigo'], [qryServicoscodigo.asinteger, qryServicoscnae.asinteger]);
end;

end.

