constructor TdtmCadastroServicos.Create(AOwner: TComponent);
begin
  inherited;
  qryServicos.Tag         := ctTabelas;
  qryProcuraCNAE.Tag      := ctTabelas;
  qryConsultaServicos.Tag := ctConsultaServicos;
  qryConsultaCNAE.Tag     := ctConsultaAtividadesEconomicas;
  qryConsultaContaContabil.Tag := ctConsultaContaContabil;
  qryProcuraDebitaraVista.Params[1].AsInteger   := 0;
  qryProcuraCreditaraVista.Params[1].AsInteger  := 0;
  qryProcuraDebitaraPrazo.Params[1].AsInteger   := 0;
  qryProcuraCreditaraPrazo.Params[1].AsInteger  := 0;
  qryProcuraDebitarAbatimentos.Params[1].AsInteger := 0;
  qryProcuraCreditarAbatimentos.Params[1].AsInteger := 0;
  qryProcuraDebitarDevolucoes.Params[1].AsInteger := 0;
  qryProcuraCreditarDevolucoes.Params[1].AsInteger := 0;
  qryConsultaHistorico.Tag := ctConsultaHistoricos;
  
end;

function TdtmCadastroServicos.ExcluirServico: Boolean;
begin
  qryServicos.Delete;
  Perpetrar([qryServicos]);
  Result := True;
end;

function TdtmCadastroServicos.ExisteServico(campo, codigo: string): boolean;
begin
  Result := ExisteCodigo(qryConsultaServicos, campo, codigo);
end;

function TdtmCadastroServicos.GetTabelaServicos: TtecQuery;
begin
  Result := qryServicos;
end;

function TdtmCadastroServicos.GetTabelaConsultaServicos: TtecQuery;
begin
  Result := qryConsultaServicos
end;

function TdtmCadastroServicos.GravarServico: Boolean;
begin
  Result := False;
  if qryServicos.CheckRequiredFields then
  begin

    if qryServicos.State = dsInsert then begin
      spcServicosProximoCodigo.Open;
      qryServicoscodigo.AsInteger:= spcServicosProximoCodigocodigo.AsInteger;
      spcServicosProximoCodigo.Close;
    end;
    qryServicos.Post;
    AtualizarrAtividadeMunicipioAtiva;
    Perpetrar([qryServicos, qryservicosAtividadesEconomicasMunicipios]);    RefazConsultapornome(qryListaAtividadesEconomicasMunicipios, ['servico','codigo'], [qryServicoscodigo.asinteger, qryServicoscnae.asinteger]);
    Result := True;

  end;
end;

function TdtmCadastroServicos.IncluirServico: Boolean;
begin
  qryServicos.Insert;
  Result := True;
end;

function TdtmCadastroServicos.ExisteCNAE(campo, codigo: string): boolean;
begin
  Result := ExisteCodigo(qryConsultaCNAE, campo, codigo);
end;

procedure TdtmCadastroServicos.AbrirTabelas(TipoPesquisa: TtecCadastroServicos);
begin
  case TipoPesquisa of
     csrSERVICO            : Abre(ctConsultaServicos);
     csrCNAE               : Abre(ctConsultaAtividadesEconomicas);
     csrDebitarVendaaVista : begin
                              if qryServicoscreditarvendaavista.AsInteger<>0 then
                                 qryConsultaContaContabil.MacroByName('consulta').AsString :=
                                    'and codigo <> '+qryServicoscreditarvendaavista.AsString;
                              Abre(ctConsultaContaContabil);
                             end;
     csrCreditarVendaaVista: begin
                              if qryServicosdebitarvendaavista.AsInteger<>0 then
                                 qryConsultaContaContabil.MacroByName('consulta').AsString :=
                                    'and codigo <> '+qryServicosdebitarvendaavista.AsString;
                              Abre(ctConsultaContaContabil);
                             end;
     csrDebitarVendaaPrazo : begin
                              if qryServicoscreditarvendaaprazo.AsInteger<>0 then
                                 qryConsultaContaContabil.MacroByName('consulta').AsString :=
                                    'and codigo <> '+qryServicoscreditarvendaaprazo.AsString;
                              Abre(ctConsultaContaContabil);
                             end;
     csrCreditarVendaaPrazo: begin
                              if qryServicosdebitarvendaaprazo.AsInteger<>0 then
                                 qryConsultaContaContabil.MacroByName('consulta').AsString :=
                                    'and codigo <> '+qryServicosdebitarvendaaprazo.AsString;
                              Abre(ctConsultaContaContabil);
                             end;
     csrDebitarAbatimentos : begin
                              if qryServicoscreditarabatimentos.AsInteger<>0 then
                                 qryConsultaContaContabil.MacroByName('consulta').AsString :=
                                    'and codigo <> '+qryServicoscreditarabatimentos.AsString;
                              Abre(ctConsultaContaContabil);
                             end;
    csrCreditarAbatimentos : begin
                              if qryServicosdebitarabatimentos.AsInteger<>0 then
                                 qryConsultaContaContabil.MacroByName('consulta').AsString :=
                                    'and codigo <> '+qryServicosdebitarabatimentos.AsString;
                              Abre(ctConsultaContaContabil);
                             end;
     csrDebitarDevolucoes : begin
                              if qryServicoscreditardevolucoes.AsInteger<>0 then
                                 qryConsultaContaContabil.MacroByName('consulta').AsString :=
                                    'and codigo <> '+qryServicoscreditardevolucoes.AsString;
                              Abre(ctConsultaContaContabil);
                             end;
    csrCreditarDevolucoes : begin
                              if qryServicosdebitarabatimentos.AsInteger<>0 then
                                 qryConsultaContaContabil.MacroByName('consulta').AsString :=
                                    'and codigo <> '+qryServicosdebitardevolucoes.AsString;
                              Abre(ctConsultaContaContabil);
                             end;
    csrHistoricoVendaaVista,
    csrHistoricoVendaaPrazo,
    csrHistoricoAbatimentos,
    csrHistoricoDevolucoes : abre(ctConsultaHistoricos);
  end;
end;

procedure TdtmCadastroServicos.FecharTabelas(TipoPesquisa: TtecCadastroServicos);
begin
  case TipoPesquisa of
    csrSERVICO: Fecha(ctConsultaServicos);
    csrCNAE   : Fecha(ctConsultaAtividadesEconomicas);
    csrDebitarVendaaVista,
    csrCreditarVendaaVista,
    csrDebitarAbatimentos,
    csrCreditarDevolucoes  : fecha(ctConsultaContaContabil);
    csrHistoricoVendaaVista,
    csrHistoricoVendaaPrazo,
    csrHistoricoAbatimentos,
    csrHistoricoDevolucoes : fecha(ctConsultaHistoricos);
  end;
end;

