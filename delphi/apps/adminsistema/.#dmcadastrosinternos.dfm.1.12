      '    f.spc_operador,'
      '    f.spc_codigoinformante,'
      '    f.exibircomplementonf,'
      '    f.inicioatividades,'
      '    f.filialconsolidadoradime,'
      '    f.debito,'
      '    f.credito,'
      '    f.contribicms,'
      '    f.contribiss,'
      '    f.contribipi,'
      '    f.site,'
      '    f.aliquotacreditoicms,'
      '    f.suframa,'
      '    f.ind_perfil,'
      '    f.ind_ativ,'
      '    f.regimetributario,'
      '    f.regimesubstituicao,'
      '    f.classificacaoipi,'
      '    f.QUALI_PJ,'
      '    f.Form_apur,'
      '    f.Form_tribut,'
      '    f.sped_pis_cofins,'
      '    f.sped_pis_cofins_rb,'
      '    f.sped_pis_cofins_rem,'
      '    f.sped_fiscal,'
      '    f.cnaefiscal,'
      '    f.tipoemissaonfeservico,'
      '    f.aedffatura  '
      ''
      ''
      'From filiais f, estados e, cidades c, bairros b'
      'where (f.estado = e.codigo) and'
      '      (f.estado = c.estado) and'
      '      (f.cidade = c.codigo) and'
      '      (f.estado = b.estado) and'
      '      (f.cidade = b.cidade) and'
      '      (f.bairro = b.codigo) and'
      '      (f.codigo = :codigo)')
