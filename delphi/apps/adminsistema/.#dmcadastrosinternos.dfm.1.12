      DisplayLabel = 'CNPJ'
      FieldName = 'cnpj'
      Size = 18
    end
    object qryConsultaFiliaiscodigo: TIntegerField
      DisplayLabel = 'C'#243'digo'
      FieldName = 'codigo'
    end
  end
  object qryUsuarios: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryUsuariosAfterOpen
    BeforeInsert = qryUsuariosBeforeInsert
    BeforePost = qryUsuariosBeforePost
    AfterCancel = qryUsuariosAfterCancel
    AfterScroll = qryUsuariosAfterScroll
    OnDeleteError = PostError
    OnEditError = PostError
    OnPostError = PostError
    OnNewRecord = qryUsuariosNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Autorizado'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select codigo,'
      '       nome,'
      '       codigofolha,'
      '       credito,'
      '       reserva, excluireserva,'
      '       tipocomissao,'
      '       inativo,'
      '       administrador,'
      '       cobranca,'
      '       cobranca as cobrancaanterior,'
      '       venda,'
      '       atendimento,'
      '       caixa,'
      '       filtrosac,'
      
        '       (select usename from pg_user where usename = usuarios.use' +
        'name) as login,'
      '       ligacao,'
      '       operador,'
      '       pagamento,'
      '       alterarprecocontrato,'
      '       descontoextra,'
      '       devolucaoproduto,'
      '       trocaproduto,'
      '       devolucaonumerario,'
      '       alterarfilial,'
      '       gerenteestoque,'
      '       gerenteproducao,'
      '       gerentecaixa,'
      '       montador,'
      '       confirmartransfitem,'
      '       restringirfichacliente,'
      '       emissornotafiscal,'
      '       iteclux,'
      '       alterardadoscontabeis,'
      '       grupo,'
      '       email,'
      '       usuarioemail,'
      '       senhaemail,'
      '       hostpop,'
      '       portapop,'
      '       hostsmtp,'
      '       portasmtp,'
      '       usuarioiteclux,'
      '       usename,'
      '       expiracaosenha,'
      '       diasvalidadesenha,'
      '       diasavisosenha,'
      '       assunto,'
      '       introducao,'
      '       conclusao,'
      '       autenticarsmtp,'
      '       salariohora,'
      '       anuenio,'
      '       turno,'
      '       gerentetecnico,'
      '       analistasite,'
      '       setorvenda,'
      '       rua,'
      '       nrrua,'
      '       complemento,'
      '       bairro,'
      '       cep,'
      '       cidade,'
      '       estado,'
      '      (Select cd.nome'
      '       From cidades cd'
      '       Where cd.estado = usuarios.estado'
      '         and cd.codigo = usuarios.cidade) as nomecidadeusuario,'
      ''
      '      (Select ba.nome'
      '       From bairros ba'
      '       Where ba.estado = usuarios.estado'
      '         and ba.cidade = usuarios.cidade'
      '         and ba.codigo = usuarios.bairro) as nomebairrousuario,'
      '      pessoatipo,'
      '      pessoanumero   '
      ''
      'from usuarios'
      'where (codigo = :codigo)'
      '%Autorizado')
    RequestLive = True
    Left = 52
    Top = 134
    ParamData = <
      item
        DataType = ftInteger
        Name = 'codigo'
        ParamType = ptUnknown
      end>
