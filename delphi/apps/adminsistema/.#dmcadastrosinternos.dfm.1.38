      '      pessoanumero,'
      '      gerentevendas,'
      '      usuario_indicou,'
      '      smtprequerssl,'
      '      smtprequertls      '
      ''
      'from usuarios'
      'where (codigo = :codigo)'
      '%Autorizado')
