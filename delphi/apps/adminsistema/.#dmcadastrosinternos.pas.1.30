  RefazConsulta(qryIESubstTributario,[0],[qryFiliaiscodigo.AsInteger]);
  RefazConsulta(qryEstoquesFiliais,[0],[qryFiliaiscodigo.AsInteger]);
  RefazConsulta(qryRespAdmCadastro,[0],[qryFiliaiscodigo.AsInteger]);
  RefazConsultaPorNome(qryAliquotasSimplesNacional,['filial'],[qryFiliaiscodigo.AsInteger]);

end;

procedure TdtmCadastrosInternos.VerificarSerieFilial(Serie, inicial, final, modelo: String);
var
 EstadoTabelaSerie : TDataSetState;
begin
  if (Serie<>SerieFilial) then
  begin
   EstadoTabelaSerie := qrySeriesFiliais.State;
   qrySeriesFiliais.Cancel;
   if not qrySeriesFiliais.Locate('valor', Serie,[]) then
   begin
    if EstadoTabelaSerie = dsinsert then
     IncluirSerieFilial
    else
     qrySeriesFiliais.Edit;
    qrySeriesFiliaisvalor.AsString:=Serie;
    qrySeriesFiliaisnumeroinicial.AsString:=inicial;
    qrySeriesFiliaisnumerofinal.AsString:=final;
    qrySeriesFiliaismodelonota.AsString:=modelo;
   end;
  end;
end;

procedure TdtmCadastrosInternos.SetSerieFilial(const Value: String);
begin
  FSerieFilial := Value;
end;

procedure TdtmCadastrosInternos.qrySeriesFiliaisAfterScroll(
  DataSet: TDataSet);
begin
  inherited;
  SerieFilial := qrySeriesFiliaisvalor.AsString;
  ReFazConsulta(qryExisteSerieFilialNotasPag,[],[]);
  ReFazConsulta(qryExisteSerieFilialNotas, [0,1],
             [qrySeriesFiliaisfilial.AsVariant,
              qrySeriesFiliaisvalor.AsVariant]);
  if qryExisteSerieFilialNotas.IsEmpty then
    qrySeriesFiliaisvalor.ReadOnly := False
  else qrySeriesFiliaisvalor.ReadOnly := True;
  if qryExisteSerieFilialNotas.IsEmpty then
  begin
   ReFazConsulta(qryExisteSerieFilialNotasPag, [0,1],
              [qrySeriesFiliaisfilial.AsVariant,
               qrySeriesFiliaisvalor.AsVariant]);
   if qryExisteSerieFilialNotasPag.IsEmpty then
     qrySeriesFiliaisvalor.ReadOnly := False
   else qrySeriesFiliaisvalor.ReadOnly := true;
  end;
end;

function TdtmCadastrosInternos.GetExisteSerieFilialUtilizada: Boolean;
begin
  result := not qryExisteSerieFilialNotas.IsEmpty or
            not qryExisteSerieFilialNotasPag.IsEmpty
end;


function TdtmCadastrosInternos.VerificaIntervaloSerieFilial(numero: integer): Boolean;

begin
 qrySeriesFiliaisAfterScroll(qrySeriesFiliais);
 result := ((numero >= qryExisteSerieFilialNotasmenornumero.AsInteger) and
            (numero <= qryExisteSerieFilialNotasmaiornumero.AsInteger)) or
           ((numero >= qryExisteSerieFilialNotasPagmenornumero.AsInteger) and
            (numero <= qryExisteSerieFilialNotasPagmaiornumero.AsInteger))
end;

function TdtmCadastrosInternos.IncluirSetoresUsuarios(Editar: Boolean): Boolean;

  procedure Setores(Editando: Boolean);
  var
    Campos,
    Setor: String;
    Pos  : TBookmark;
  begin
    Campos := '';
    Setor:= qrySetoresUsuariosgrupo.AsString;
    Pos:= qrySetoresUsuarios.GetBookmark;
    try
      qrySetoresUsuarios.DisableControls;
      qrySetoresUsuarios.First;
      while not qrySetoresUsuarios.Eof do begin
        if (qrySetoresUsuariosgrupo.AsString <> '') then begin
          if not Editando then
            Campos := Campos + '' + QuotedStr(qrySetoresUsuariosGrupo.AsString) + ','
          else if (qrySetoresUsuariosGrupo.AsString <> Setor) then
            Campos := Campos + '' + QuotedStr(qrySetoresUsuariosgrupo.AsString) + ',';
        end;
        qrySetoresUsuarios.Next;
      end;
    finally
      qrySetoresUsuarios.EnableControls;
      qrySetoresUsuarios.GotoBookmark(Pos);
      qrySetoresUsuarios.FreeBookmark(Pos);
      Delete(Campos,Length(Campos),1);
    end;
    if Campos <> '' then begin
      qryProcuraSetores.Sql[04] := Format('and not (codigo in (%s))', [Campos]);
      qryConsultaSetores.Sql[03]:= Format('Where not (codigo in (%s))', [Campos]);
    end
    else begin
      qryProcuraSetores.Sql[04] := '';
      qryConsultaSetores.Sql[03]:= '';
    end;
  end;

begin
  Result:= True;
  Setores(Editar);
  if not Editar or qrySetoresUsuarios.IsEmpty then begin
    qrySetoresUsuarios.Append;
    qrySetoresUsuariosusuario.AsInteger:= qryUsuarioscodigo.AsInteger;
  end
  else begin
    qrySetoresUsuarios.Edit;
    qrySetoresUsuarios.Cancel;
  end;
end;

function TdtmCadastrosInternos.GravarSetoresUsuarios: Boolean;

begin
  Result:= False;
  if qrySetoresUsuarios.CheckRequiredFields then begin
    qrySetoresUsuariosdescricao.AsString:= qryProcuraSetoresdescricao.AsString;
    qrySetoresUsuarios.Post;
    qryUsuarios.Edit;
    Result:= True;
  end;
end;

