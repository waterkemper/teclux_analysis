    qryConsultaUsuarios.Sql[3] := 'where codigo = ' + IntToStr(UsuarioLogin.CodigoUsuario);
    qryUsuarios.MacroByName('Autorizado').AsString := 'and codigo = ' + IntToStr(UsuarioLogin.CodigoUsuario);
  end else begin
    qryConsultaUsuarios.Sql[3] := '';
    qryUsuarios.MacroByName('Autorizado').AsString := '';
