function TdtmCadastrosInternos.IncluirComissoesUsuariosGrupos(
  Editar: Boolean): boolean;

  procedure Grupos(Editando: Boolean);
  var
    Campos,
    Grupo: String;
    Pos  : TBookmark;
  begin
    Campos := '';
    Grupo:= qryComissoesUsuariosGruposgrupo.AsString;
    Pos:= qryComissoesUsuariosGrupos.GetBookmark;
    try
      qryComissoesUsuariosGrupos.DisableControls;
      qryComissoesUsuariosGrupos.First;
      while not qryComissoesUsuariosGrupos.Eof do begin
        if (qryComissoesUsuariosGruposgrupo.AsString <> '') then begin
          if not Editando then
            Campos := Campos + '' + QuotedStr(qryComissoesUsuariosGruposgrupo.AsString) + ','
          else if (qryComissoesUsuariosGruposgrupo.AsString <> grupo) then
            Campos := Campos + '' + QuotedStr(qryComissoesUsuariosGruposgrupo.AsString) + ',';
        end;
        qryComissoesUsuariosGrupos.Next;
      end;
    finally
      qryComissoesUsuariosGrupos.EnableControls;
      qryComissoesUsuariosGrupos.GotoBookmark(Pos);
      qryComissoesUsuariosGrupos.FreeBookmark(Pos);
      Delete(Campos,Length(Campos),1);
    end;
    if Campos <> '' then begin
      qryProcuraGrupos.Sql[03] := Format('and not (codigo in (%s))', [Campos]);
      qryConsultaGrupos.Sql[03]:= Format('Where not (codigo in (%s))', [Campos]);
    end
    else begin
      qryProcuragrupos.Sql[03] := '';
      qryConsultagrupos.Sql[03]:= '';
    end;
  end;

begin
  Result := True;
  Grupos(Editar);
  if not Editar or qryComissoesUsuariosGrupos.IsEmpty then begin
    qryComissoesUsuariosGrupos.Append;
    qryComissoesUsuariosGruposusuario.AsInteger:= qryUsuarioscodigo.AsInteger;
  end
  else begin
    qryComissoesUsuariosGrupos.Edit;
    qryComissoesUsuariosGrupos.Cancel;
  end;
end;

