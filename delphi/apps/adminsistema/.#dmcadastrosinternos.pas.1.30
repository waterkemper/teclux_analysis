procedure TdtmCadastrosInternos.GravarUsuarioItecLUX(Usuario,
  Senha: String);
begin
  if qryUsuarioIteclux.Active then
    qryUsuarioIteclux.Close;
  qryUsuarioIteclux.Params[0].AsString := '' + Usuario + '';
  qryUsuarioIteclux.Params[1].AsString := '' + Senha + '';
  qryUsuarioIteclux.Params[2].AsString := qryUsuarioscodigo.AsString;
  qryUsuarioIteclux.ExecSql;
end;

procedure TdtmCadastrosInternos.dsrUsuariosDataChange(Sender: TObject;
  Field: TField);
begin
  inherited;
  if Field = qryUsuariosdiasvalidadesenha then
  begin
    if qryUsuariosdiasvalidadesenha.AsInteger > 0 then
      qryUsuariosexpiracaosenha.AsDateTime := SomarDia(DataLocal, qryUsuariosdiasvalidadesenha.AsInteger, 'N')
    else
      qryUsuariosexpiracaosenha.AsString := '';
  end
  else
  if field = qryUsuarioscobranca then
  begin
    if qryUsuarioscobranca.AsBoolean then
        IncluirComissoesCobranca(False)
    else
      if (qryUsuarios.state in [dsedit, dsinsert]) then
      begin
        if not qryComissoesUsuarios.isempty or not qryComissoesCobranca.isempty then
        begin
          if not ExcluirComissoesUsuarios then
          begin
            dsrUsuarios.onDataChange := nil;
            qryUsuarioscobranca.AsBoolean := true;
            dsrUsuarios.onDataChange := dsrUsuariosDataChange
          end;  
        end;
      end;
  end;

end;

