function TdtmCadastrosInternos.IncluirComissoesUsuariosClasses(
  Editar: Boolean): Boolean;

  procedure Classes(Editando: Boolean);
  var
    Campos,
    Classe: String;
    Pos  : TBookmark;
  begin
    Campos := '';
    Classe:= qryComissoesUsuariosClassesclasse.AsString;
    Pos:= qryComissoesUsuariosClasses.GetBookmark;
    try
      qryComissoesUsuariosClasses.DisableControls;
      qryComissoesUsuariosClasses.First;
      while not qryComissoesUsuariosClasses.Eof do begin
        if (qryComissoesUsuariosClassesclasse.AsString <> '') then begin
          if not Editando then
            Campos := Campos + '' + QuotedStr(qryComissoesUsuariosClassesclasse.AsString) + ','
          else if (qryComissoesUsuariosClassesclasse.AsString <> classe) then
            Campos := Campos + '' + QuotedStr(qryComissoesUsuariosClassesclasse.AsString) + ',';
        end;
        qryComissoesUsuariosClasses.Next;
      end;
    finally
      qryComissoesUsuariosClasses.EnableControls;
      qryComissoesUsuariosClasses.GotoBookmark(Pos);
      qryComissoesUsuariosClasses.FreeBookmark(Pos);
      Delete(Campos,Length(Campos),1);
    end;
    if Campos <> '' then begin
      qryProcuraClasses.Sql[03] := Format('and not (codigo in (%s))', [Campos]);
      qryConsultaClasses.Sql[03]:= Format('Where not (codigo in (%s))', [Campos]);
    end
    else begin
      qryProcuraClasses.Sql[03] := '';
      qryConsultaClasses.Sql[03]:= '';
    end;
  end;

begin
  Result := True;
  classes(Editar);
  if not Editar or qryComissoesUsuariosClasses.IsEmpty then begin
    qryComissoesUsuariosClasses.Append;
    qryComissoesUsuariosClassesusuario.AsInteger:= qryUsuarioscodigo.AsInteger;
  end
  else begin
    qryComissoesUsuariosClasses.Edit;
    qryComissoesUsuariosClasses.Cancel;
  end;
end;

function TdtmCadastrosInternos.ExcluirComissoesUsuariosClasses: Boolean;
begin
  Result:= False;
  if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['a CLASSE DESTA COMISSÃO DO USUÁRIO'])) = smbOk then begin
    if not qryComissoesUsuariosClasses.IsEmpty then
