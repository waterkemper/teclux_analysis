  DataSet: TDataSet);
begin
  inherited;
  qryFiliais.Edit;

end;

procedure TdtmCadastrosInternos.qryAliquotasSimplesNacionalAfterPost(
  DataSet: TDataSet);
var
  vMesAno : String;
begin
  inherited;
  vmesAno := qryAliquotasSimplesNacionalMesAno.asString;

  qryFiliais.Edit;
  perpetrar([qryAliquotasSimplesNacional]);
  RefazConsultaPorNome(qryAliquotasSimplesNacional,['filial'],[qryFiliaiscodigo.AsInteger]);
  qryAliquotasSimplesNacional.locate('mesano', vMesAno, []);


end;

procedure TdtmCadastrosInternos.qryAliquotasSimplesNacionalNewRecord(
  DataSet: TDataSet);
begin
  inherited;
  qryAliquotasSimplesNacionalfilial.AsInteger := qryFiliaiscodigo.AsInteger;
end;

function TdtmCadastrosInternos.VerificarAliquotasSimplesNacional: Boolean;
var
  vMesAno, vMesAnoAux : String;

begin
  vMesAno := qryAliquotasSimplesNacionalmesano.AsString;
  qryAliquotasSimplesNacional.SortByField('mesano');
  qryAliquotasSimplesNacional.First;
  vMesAnoAux := qryAliquotasSimplesNacionalmesano.AsString;
  while not qryAliquotasSimplesNacional.eof do
  begin
   qryAliquotasSimplesNacional.Next;
   if qryAliquotasSimplesNacionalmesano.AsString=vMesAnoAux then
   begin
      MensagemAviso('')
   end;
  end;

end;

procedure TdtmCadastrosInternos.qryAliquotasSimplesNacionalMesAnoChange(
  Sender: TField);
begin
  inherited;
  RefazConsultaPorNome(qryAliquotas,['filial','mesano'],[qryFiliaiscodigo.AsVariant,qryAliquotasSimplesNacionalmesano.AsVariant]);
  if qryAliquotasn.AsInteger > 0 then
  begin
    MensagemErro('Aliquota já cadastrada');
    if qryAliquotasSimplesNacional.State = dsinsert then
      qryAliquotasSimplesNacionalmesano.clear
    else
      qryAliquotasSimplesNacional.cancel
  end;
end;

