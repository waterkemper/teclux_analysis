function TdtmCadastrosInternos.GravarMetasUsuarios(MesAno:String): Boolean;

  function VerificarPeriodoMeta: Boolean;
  var
    I: Integer;
  begin
    I:= 0;
    qryMetasUsuarios.First;
    qryMetasUsuarios.DisableControls;
    while not qryMetasUsuarios.Eof do begin
      if qryMetasUsuariosmesano.AsString = MesAno then
        Inc(I);
      qryMetasUsuarios.Next;
    end;
    qryMetasUsuarios.EnableControls;
    Result:= (I > 1);
  end;

begin
  Result:= False;
  if qryMetasUsuarios.CheckRequiredFields then begin
    Delete(MesAno,3,1);
    qryMetasUsuariosmesano.AsString:= MesAno;
    if not VerificarPeriodoMeta then begin
      qryUsuarios.Edit;
      Result := True;
    end
    else begin
      MensagemAviso('O período ' + qryMetasUsuariosmesanoeditado.AsString + ' já foi especificado.');
      qryMetasUsuarios.Delete;
    end;
  end;
end;

