procedure TdtmCadastrosInternos.AbreTabelasParametrosSistemas(Procura: TtecParametroSistemas);
begin
  case Procura of
    psMODULO    : Abre(ctTabelaConsultaModulos);
    psPARAMETRO : Abre(ctTabelaConsultaParametros);
    psFILIAL    : Abre(ctCrediarioTabelaConsultaFiliais);
  end;
end;

procedure TdtmCadastrosInternos.AbreTabelasConsulta(Procura: TtecProcuraFiliais);
begin
  case Procura of
    tpFILIAIS,
    tpFILIALCONTABILFILIAIS,
    tpFILIALMONTAGEMFILIAIS :
    begin
      qryConsultaFiliais.MacroByName('Filtro').AsString := '';
      Abre(ctCrediarioTabelaConsultaFiliais);
    end;
    tpFILIALCONSOLIDADORADIME   :
    begin
      qryConsultaFiliais.MacroByName('Filtro').AsString := 'where filialconsolidadoradime is null';
      Abre(ctCrediarioTabelaConsultaFiliais);
    end;
    tpCOLUNASPRECONORMALFILIAIS,
    tpCOLUNASPRECOPROMOCAOFILIAIS: Abre(ctTabelasConsultaColunas);
  end;
end;

procedure TdtmCadastrosInternos.FechaTabelasConsulta(Procura: TtecProcuraFiliais);
begin
  case Procura of
    tpFILIAIS,
    tpFILIALCONTABILFILIAIS,
    tpFILIALMONTAGEMFILIAIS,
    tpFILIALCONSOLIDADORADIME : Fecha(ctCrediarioTabelaConsultaFiliais);
    tpCOLUNASPRECONORMALFILIAIS,
    tpCOLUNASPRECOPROMOCAOFILIAIS: Fecha(ctTabelasConsultaColunas);
    tpfCONTADEBITO,
    tpfCONTACREDITO         : Fecha(ctConsultaContaContabil);
  end;
end;

procedure TdtmCadastrosInternos.Selecionar(Pesquisa: TtecProcuraFiliais);
begin
  case Pesquisa of
    tpFILIAIS                    : RefazConsulta(qryFiliais, [0], [qryConsultaFiliaisCodigo.AsInteger]);
    tpFILIALCONTABILFILIAIS      : begin
                                     qryFiliais.Edit;
                                     qryFiliaiscontabil.AsInteger  := qryConsultaFiliaiscodigo.AsInteger;
                                   end;
    tpFILIALMONTAGEMFILIAIS      : begin
                                     qryFiliais.Edit;
                                     qryFiliaismontagem.AsInteger  := qryConsultaFiliaiscodigo.AsInteger;
                                   end;
    tpFILIALCONSOLIDADORADIME      : begin
                                     qryFiliais.Edit;
                                     qryFiliaisfilialconsolidadoradime.AsInteger  := qryConsultaFiliaiscodigo.AsInteger;
                                   end;
    tpCOLUNASPRECONORMALFILIAIS  : begin
                                     qryFiliais.Edit;
                                     qryFiliaispreconormal.AsInteger:= qryConsultaColunascodigo.AsInteger;
                                   end;
    tpCOLUNASPRECOPROMOCAOFILIAIS: begin
                                     qryFiliais.Edit;
                                     qryFiliaisprecopromocao.AsInteger:= qryConsultaColunascodigo.AsInteger;
                                   end;

  end;
end;

procedure TdtmCadastrosInternos.qryFiliaisNewRecord(DataSet: TDataSet);
begin
  inherited;
  qryFiliaistipofilial.AsString:= 'L';
  qryFiliaisporte.AsString     := 'O';
  qryFiliaissimples.AsString   := 'N';
  qryFiliaisregime.AsInteger   := 1;
  qryFiliaisinscricaoestadual.asString:= 'ISENTO';
  qryFiliaisexibircomplementonf.AsBoolean := true;
  qryFiliaiscontribicms.AsBoolean := false;
  qryFiliaiscontribipi.AsBoolean := false;
  qryFiliaiscontribiss.AsBoolean := false;
  qryFiliaisind_perfil.AsString := 'A';
  qryFiliaisind_ativ.AsString := '0';
  qryFiliaisregimetributario.AsInteger := 1;
  qryFiliaisquali_pj.AsString := '10';
  qryFiliaisform_apur.AsString := 'A';
  qryFiliaisform_tribut.AsString := '1';
  qryFiliaissped_pis_cofins.AsBoolean := false;
  qryFiliaissped_fiscal.AsBoolean := false;
  qryFiliaissped_pis_cofins_rb.AsBoolean := false;
  qryFiliaissped_pis_cofins_rem.AsBoolean := false;
  qryFiliaistipoemissaonfeservico.asinteger := 1;
{
'Indicador do tipo de ECD:
0 – ECD de empresa não participante de SCP como sócio ostensivo.
1 – ECD de empresa participante de SCP como sócio ostensivo.
2 – ECD da SCP.'
}
  qryFiliaistip_ecd.asinteger := 0;
end;

