function TdtmCadastrosInternos.ExcluirMetasUsuarios: Boolean;
begin
  Result:= False;
  if not qryMetasUsuarios.IsEmpty then begin
    if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['a META DO USUÁRIO'])) = smbOk then begin
      if qryMetasUsuarios.State in [dsEdit, dsInsert] then
           qryMetasUsuarios.Cancel
      else begin
        qryMetasUsuarios.Delete;
        qryUsuarios.Edit;
      end;
      Result:= True;
    end;
  end
end;

function TdtmCadastrosInternos.ExcluirSerieFilial: Boolean;
begin
  Result := False;
  if qrySeriesFiliais.RecordCount > 0 then begin
    if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['a SÉRIE FILIAL'])) = smbOk then begin
      qrySeriesFiliais.Delete;
//      Perpetrar([qrySeriesFiliais]);
      if qryFiliais.State = dsBrowse then
        qryFiliais.Edit;
      Result := True;
    end;
  end;
end;

