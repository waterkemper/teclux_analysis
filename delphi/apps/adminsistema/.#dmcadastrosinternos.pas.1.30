procedure TdtmCadastrosInternos.SelecionarUsuario(Pesquisa: TtecProcuraUsuarios);
begin
  case Pesquisa of
    tpSETORES : begin
                  qrySetoresUsuarios.Edit;
                  qrySetoresUsuariosgrupo.AsString:= qryConsultaSetorescodigo.AsString;
                end;
    tpFILIAL  : begin
                  qryUsuariosFiliais.Edit;
                  qryUsuariosFiliaisfilial.asInteger := qryConsultaFiliaiscodigo.AsInteger;
                end;
    tpFILTRO  : begin
                  qryUsuarios.Edit;
                  qryUsuariosfiltrosac.asInteger:= qryConsultaFiltrosnumero.asInteger;
                end;
    tpUSUARIO : ReFazConsulta(qryUsuarios,[0],[qryConsultaUsuarioscodigo.asInteger]);
    tpGRUPOSUSUARIOS: begin
                        qryUsuarios.Edit;
                        qryUsuariosgrupo.AsInteger := qryConsultaGruposUsuarioscodigo.AsInteger;
                      end;
    tpCOMISSOESGRUPOS  : begin
                          qryComissoesUsuariosGrupos.Edit;
                          qryComissoesUsuariosGruposgrupo.AsString := qryConsultaGruposcodigo.AsString;
                         end;
    tpCOMISSOESCLASSES : begin
                          qryComissoesUsuariosClasses.Edit;
                          qryComissoesUsuariosClassesclasse.AsString := qryConsultaClassescodigo.AsString;
                         end;
  end;
end;

