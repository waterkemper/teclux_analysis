function TdtmCadastrosInternos.IncluirFatoresPrecosFilial(Incluindo: Boolean): Boolean;

  procedure MontarSQLFatoresPrecos;
  var
    Campos : String;
    FP     : String;
    Pos    : TBookmark;
  begin
    Campos := '';
    FP := qryFatoresPrecosFilialfatorpreco.AsString;
    qryFatoresPrecosFilial.DisableControls;
    Pos:= qryFatoresPrecosFilial.GetBookmark;
    try
      qryFatoresPrecosFilial.First;
      while not qryFatoresPrecosFilial.Eof do begin
        if (qryFatoresPrecosFilialfatorpreco.AsString <> '') then begin
          if Incluindo then
            Campos := Campos + '' + QuotedStr(qryFatoresPrecosFilialfatorpreco.AsString) + ','
          else if (qryFatoresPrecosFilialfatorpreco.AsString <> FP) then
            Campos := Campos + '' + QuotedStr(qryFatoresPrecosFilialfatorpreco.AsString) + ',';
        end;
        qryFatoresPrecosFilial.Next;
      end;
    finally
      qryFatoresPrecosFilial.GotoBookmark(Pos);
      qryFatoresPrecosFilial.FreeBookmark(Pos);
      qryFatoresPrecosFilial.EnableControls;
      Delete(Campos,Length(Campos),1);
      if Campos = '' then Campos:= '0';
    end;
    qryProcuraFatoresPrecos.Sql[04] := Format('and not (codigo in (%s))', [Campos]);
    qryConsultaFatoresPrecos.Sql[03]:= Format('Where not (codigo in (%s))', [Campos]);
  end;

begin
  Result:= True;
  MontarSQLFatoresPrecos;
  if Incluindo or qryFatoresPrecosFilial.IsEmpty then begin
    qryFatoresPrecosFilial.Append;
    qryFatoresPrecosFilialfator.AsCurrency:= 0;
  end
  else begin
    qryFatoresPrecosFilial.Edit;
    qryFatoresPrecosFilial.Cancel;
  end;
end;

function TdtmCadastrosInternos.ExcluirFatoresPrecosFilial: Boolean;
begin
  Result:= False;
  if (qryFatoresPrecosFilial.RecordCount > 0) then begin
    if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o FATOR DE PREÇO'])) = smbOk then begin
      if qryFatoresPrecosFilial.State in [dsEdit, dsInsert] then
           qryFatoresPrecosFilial.Cancel
      else qryFatoresPrecosFilial.Delete;
      if qryFiliais.State = dsBrowse then
        qryFiliais.Edit;
      Result:= True;
    end;
  end;
end;

function TdtmCadastrosInternos.GravarFatoresPrecosFilial: Boolean;
begin
  Result:= False;
  if qryFatoresPrecosFilial.CheckRequiredFields then begin
    qryFatoresPrecosFilial.Post;
    if qryFiliais.State = dsBrowse then
      qryFiliais.Edit;
    Result:= True;
  end;
end;

