procedure TdtmCadastrosInternos.qryUsuariosAfterScroll(DataSet: TDataSet);
begin
  inherited;
  ReFazConsulta(qryMetasUsuarios,    [0],[qryUsuarioscodigo.AsInteger]);
  ReFazConsulta(qryComissoesUsuarios,[0],[qryUsuarioscodigo.AsInteger]);
  ReFazConsulta(qryComissoesUsuariosIndicados,[0],[qryUsuarioscodigo.AsInteger]);
  ReFazConsulta(qryMeusIndicados,[0],[qryUsuarioscodigo.AsInteger]);


  ReFazConsulta(qryComissoesUsuariosgrupos,[0],[qryUsuarioscodigo.AsInteger]);
  ReFazConsulta(qryComissoesUsuariosClasses,[0],[qryUsuarioscodigo.AsInteger]);
  ReFazConsulta(qryComissoesCobranca,[0],[qryUsuarioscodigo.AsInteger]);
  ReFazConsulta(qrySetoresUsuarios,  [0],[qryUsuarioscodigo.AsInteger]);
  ReFazConsulta(qryUsuariosFiliais,  [0],[qryUsuarioscodigo.AsInteger]);
  RefazConsultaPorNome(qryUsuariosOperacoesProducao,  ['usuario'],[qryUsuarioscodigo.AsInteger]);

//  if Assigned(OnScrollInternet) then
//    OnScrollInternet(qryUsuarios);
end;

