procedure TdtmCadastrosInternos.EditarUsuariosOperacaoProducao;
begin
  if not (qryUsuariosOperacoesProducao.State in [dsedit, dsinsert]) then
    qryUsuariosOperacoesProducao.Edit;


end;

procedure TdtmCadastrosInternos.AtualizaListaOperacoes;
var
  Pos: TBookmark;
begin
  Pos := qryUsuariosOperacoesProducao.GetBookmark;
  qryUsuariosOperacoesProducao.DisableControls;
  try
    ListaOperacoesSelecionadas := '';
    qryUsuariosOperacoesProducao.First;
    while Not qryUsuariosOperacoesProducao.Eof do
    begin
      if qryUsuariosOperacoesProducaooperacao.AsString<>'' then
      begin
        ListaOperacoesSelecionadas := ListaOperacoesSelecionadas +
                                     qryUsuariosOperacoesProducaooperacao.AsString + ',';
      end;
      qryUsuariosOperacoesProducao.Next
    end;

    if ListaOperacoesSelecionadas <> '' then
      ListaOperacoesSelecionadas := copy(ListaOperacoesSelecionadas,0, Length(ListaOperacoesSelecionadas)-1)
    else
      ListaOperacoesSelecionadas := '0';

  finally
    qryUsuariosOperacoesProducao.GotoBookmark(Pos);
    qryUsuariosOperacoesProducao.FreeBookmark(Pos);
    qryUsuariosOperacoesProducao.EnableControls;
  end
end;

procedure TdtmCadastrosInternos.qryUsuariosOperacoesProducaoAfterOpen(
  DataSet: TDataSet);
begin
  inherited;
  AtualizaListaOperacoes;
  qryUsuariosOperacoesProducao.First;
end;

procedure TdtmCadastrosInternos.qryUsuariosOperacoesProducaoAfterPost(
  DataSet: TDataSet);
begin
  inherited;
  EditarUsuarios;
  AtualizaListaOperacoes;
end;

procedure TdtmCadastrosInternos.qryUsuariosOperacoesProducaoAfterDelete(
  DataSet: TDataSet);
begin
  inherited;
  EditarUsuarios;
  AtualizaListaOperacoes;

end;

function TdtmCadastrosInternos.SalvarUsuariosOperacoesProducao(gravar: Boolean): boolean;
begin
  result := true;
  if (qryUsuariosOperacoesProducao.State in [dsedit, dsinsert]) then
  begin
    if qryUsuariosOperacoesProducao.CheckRequiredFields then
    begin
      if gravar then
        qryUsuariosOperacoesProducao.Post
    end
    else
      result := false;
  end;
end;

procedure TdtmCadastrosInternos.qryUsuariosOperacoesProducaoBeforePost(
  DataSet: TDataSet);
begin
  inherited;
  SalvarUsuariosOperacoesProducao(false);
end;

