var
  dtmCadastrosInternos: TdtmCadastrosInternos;



implementation

{$R *.dfm}

uses clusuario;

constructor TdtmCadastrosInternos.Create(AOwner: TComponent);
begin
  inherited;
  qryFiliais.Tag                     := ctCadastroFiliais;
  qrySeriesFiliais.Tag               := ctCadastroFiliais;
  qryFatoresPrecosFilial.Tag         := ctCadastroFiliais;
  qryNaturezaJuridica.Tag            := ctCadastroFiliais;
  
  qryConsultaModelosNotasFiscais.Tag := ctConsultaModeloNotaFiscal;
  qryUsuarios.Tag                    := ctCadastroUsuarios;
  qryMetasUsuarios.Tag               := ctCadastroUsuarios;
  qryComissoesUsuarios.Tag           := ctCadastroUsuarios;
  qryComissoesUsuariosGrupos.Tag     := ctCadastroUsuarios;
  qryComissoesUsuariosClasses.Tag    := ctCadastroUsuarios;
  qryComissoesCobranca.Tag           := ctCadastroUsuarios;
  qryEventosCobranca.Tag             := ctCadastroUsuarios;
  qrySetoresUsuarios.Tag             := ctCadastroUsuarios;
  qryUsuariosFiliais.Tag             := ctCadastroUsuarios;

  qryGruposUsuarios.Tag              := ctTabelaGruposUsuarios;
  qryConsultaFiliais.Tag             := ctCrediarioTabelaConsultaFiliais;
  qryConsultaColunas.Tag             := ctTabelasConsultaColunas;
  qryConsultaFornecedores.Tag        := ctTabelasFornecedoresConsulta;
  qryConsultaUsuarios.Tag            := ctTabelasConsultaUsuarios;
  qryConsultaFiltros.Tag             := ctTabelasConsultaFiltrosSAC;
  qryConsultaModulos.Tag             := ctTabelaConsultaModulos;
  qryConsultaGruposUsuarios.Tag      := ctTabelaConsultaGrupoUsuarios;
  qryConsultaGrupoPostgreSQL.Tag     := ctTabelaConsultaGrupoPostgreSQL;
  qryConsultaSetores.Tag             := ctTabelaConsultaSetores;
  qryConsultaFatoresPrecos.Tag       := ctConsultaFatoresPreco;
  qryConsultaGrupos.Tag              := ctConsultaGrupos;
  qryConsultaClasses.Tag             := ctConsultaClasses;

  FListaOperacoesSelecionadas := '0';
end;

procedure TdtmCadastrosInternos.CancelarSerieFilial;
begin
  qrySeriesFiliais.Cancel;
  ReFazConsulta(qrySeriesFiliais, [0], [qryFiliaiscodigo.AsInteger]);
  Rollback([qryAliquotasSimplesNacional]);
end;

procedure TdtmCadastrosInternos.EditarUsuarios;
begin
  if Not (qryUsuarios.State in [dsEdit, dsInsert]) then
    qryUsuarios.Edit
end;

function TdtmCadastrosInternos.ExcluirFilial: Boolean;
begin
  if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['a FILIAL'])) = smbOk then begin
    if not (qryFiliais.IsEmpty) then
         qryFiliais.Delete
    else qryFiliais.Cancel;
    Perpetrar([qryFiliais]);
    Result := True;
  end else
    Result:= False
end;

function TdtmCadastrosInternos.GravarFiliais(NewCodigo:Integer): Boolean;
begin
  qryfiliaisinscricaoestadual.Required := qryFiliaiscontribicms.AsBoolean;
  
  if qryFiliais.CheckRequiredFields then begin
    if qryFiliais.State in [dsInsert] then
       qryFiliaiscodigo.value := NewCodigo;

    if qryFiliais.State in [dsEdit, dsInsert] then begin
      qryFiliais.Post;
      if qrySeriesFiliais.State in [dsEdit, dsInsert] then
        qrySeriesFiliais.Post;

      qrySeriesFiliais.DisableControls;
      try
        qrySeriesFiliais.First;
        while not qrySeriesFiliais.eof do begin
          if qrySeriesFiliaisfilial.IsNull then begin
            qrySeriesFiliais.Edit;
            qrySeriesFiliaisfilial.AsInteger := qryFiliaiscodigo.AsInteger;
            qrySeriesFiliais.Post;
          end;
          qrySeriesFiliais.Next;
        end;
      finally
        qrySeriesFiliais.EnableControls;
      end;

      if not qryIESubstTributario.IsEmpty then
      begin
         qryIESubstTributario.First;
         while not qryIESubstTributario.Eof do
         begin
           qryIESubstTributario.Edit;
           qryIESubstTributariocliente.AsInteger := qryFiliaiscodigo.AsInteger;
           qryIESubstTributariotipocliente.AsString := 'L';
           qryIESubstTributario.Post;
           qryIESubstTributario.Next;
         end;
      end;

      if not qryEstoquesFiliais.IsEmpty then
      begin
         qryEstoquesFiliais.First;
         while not qryEstoquesFiliais.Eof do
         begin
           qryEstoquesFiliais.Edit;
           qryEstoquesFiliaisfilialbase.AsInteger := qryFiliaiscodigo.AsInteger;
           qryEstoquesFiliais.Post;
           qryEstoquesFiliais.Next;
         end;
      end;

      if not qryRespAdmCadastro.IsEmpty then
      begin
        qryRespAdmCadastro.First;
        while not qryRespAdmCadastro.Eof do
        begin
          qryRespAdmCadastro.Edit;
          qryRespAdmCadastrofilial.AsInteger := qryFiliaiscodigo.AsInteger;
          qryRespAdmCadastro.Post;
          qryRespAdmCadastro.Next;
        end;
      end;

      if not FOptantepeloSimples then
        qryFiliaisaliquotacreditoicms.AsCurrency:= 0;

      qryFatoresPrecosFilial.DisableControls;
      try
        qryFatoresPrecosFilial.First;
        while not qryFatoresPrecosFilial.eof do begin
          if qryFatoresPrecosFilialfilial.IsNull then begin
            qryFatoresPrecosFilial.Edit;
            qryFatoresPrecosFilialfilial.AsInteger := qryFiliaiscodigo.AsInteger;
            qryFatoresPrecosFilial.Post;
          end;
          qryFatoresPrecosFilial.Next;
        end;
      finally
        qryFatoresPrecosFilial.EnableControls;
      end;

      qryAliquotasSimplesNacional.DisableControls;
      try
        qryAliquotasSimplesNacional.First;
        qryAliquotasSimplesNacional.AfterPost := nil;
        while not qryAliquotasSimplesNacional.eof do
        begin
          if qryAliquotasSimplesNacionalfilial.IsNull then
          begin
            qryAliquotasSimplesNacional.Edit;
            qryAliquotasSimplesNacionalfilial.AsInteger := qryFiliaiscodigo.AsInteger;

            qryAliquotasSimplesNacional.Post;
          end;
          qryAliquotasSimplesNacional.Next;
        end;
      finally
        qryAliquotasSimplesNacional.EnableControls;
        qryAliquotasSimplesNacional.AfterPost := qryAliquotasSimplesNacionalAfterPost;
      end;


      Perpetrar([qryFiliais, qrySeriesFiliais, qryFatoresPrecosFilial,
                 qryIESubstTributario, qryEstoquesFiliais, qryRespAdmCadastro,
                 qryAliquotasSimplesNacional]);


      if qryFiliaiscodigo.AsInteger = FilialBase then
        VerificarFilialBase;
        
      VerificarDadosFilial;  
    end;
    Result:=True;
  end
  else
    Result:= False;
end;

function TdtmCadastrosInternos.GravarGrupoUsuario: Boolean;
begin
  if qryGruposUsuarios.CheckRequiredFields then begin
    if qryGruposUsuarios.State = dsInsert then begin
      spcGruposUsuariosProximo.Open;
      qryGruposUsuarioscodigo.AsInteger := spcGruposUsuariosProximocodigo.AsInteger;
      spcGruposUsuariosProximo.Close;
    end;
    qryGruposUsuarios.Post;
    Perpetrar([qryGruposUsuarios]);
    Result := True;
  end else
    Result := False
