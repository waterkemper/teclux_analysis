procedure TdtmCadastrosInternos.IncluirMetasUsuarios(Editar: Boolean);
begin
  if not Editar or qryMetasUsuarios.IsEmpty then begin
    qryMetasUsuarios.Append;
    qryMetasUsuariosusuario.AsInteger:= qryUsuarioscodigo.AsInteger;
    qryMetasUsuariostipo.AsString    := '%';
    qryMetasUsuarioscomissao.AsFloat := 0;
  end;
end;

procedure TdtmCadastrosInternos.IncluirComissoesUsuarios(Editar: Boolean);
begin
  if not Editar or TabelaComissoesVendas.IsEmpty then begin
    TabelaComissoesVendas.Append;
    TabelaComissoesVendas.fieldbyname('usuario').AsInteger:= qryUsuarioscodigo.AsInteger;
  end;
end;

function TdtmCadastrosInternos.ExcluirComissoesUsuarios: Boolean;
begin
  Result:= False;

  case TipoComissao of
    ComissoesUsuarios :
    begin
      if not qryComissoesUsuarios.isempty or not qryComissoesCobranca.isempty then
        if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['a COMISSÃO DO USUÁRIO'])) = smbOk then
        begin
          if not qryComissoesUsuarios.IsEmpty then
          begin
            qryComissoesUsuarios.First;
            while not qryComissoesUsuarios.eof do
               qryComissoesUsuarios.Delete;
          end
          else
            qryComissoesUsuarios.Cancel;

          if not qryComissoesCobranca.IsEmpty then
          begin
            qryComissoesCobranca.First;
            while not qryComissoesCobranca.eof do
               qryComissoesCobranca.Delete
          end
          else
            qryComissoesCobranca.Cancel;

          Result:= True;
        end
    end;
    ComissoesUsuariosIndicados :
    begin
      if not qryComissoesUsuariosIndicados.isempty then
        if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['a COMISSÃO DO USUÁRIO'])) = smbOk then
        begin
          if not qryComissoesUsuariosIndicados.IsEmpty then
          begin
            qryComissoesUsuariosIndicados.First;
            while not qryComissoesUsuariosIndicados.eof do
               qryComissoesUsuariosIndicados.Delete;
          end
          else
            qryComissoesUsuariosIndicados.Cancel;

          Result:= True;
        end
    end;
  end;

end;

function TdtmCadastrosInternos.ExcluirGrupoUsuario: Boolean;
begin
  Result:= False;
  if MensagemConfirmacao(Format(ctCONFIRMEEXCLUIR, [ctOGRUPOUSUARIOS])) = smbok then begin
   if not qryGruposUsuarios.IsEmpty then
    qryGruposUsuarios.Delete
   else
    qryGruposUsuarios.cancel;
   Result := Perpetrar([qryGruposUsuarios]);
  end;
end;

