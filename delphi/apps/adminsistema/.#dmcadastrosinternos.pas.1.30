function TdtmCadastrosInternos.IncluirUsuariosFiliais(Editar: Boolean): Boolean;

  procedure Filiais(Editando: Boolean);
  var
    Campos,
    Filial: String;
    Pos  : TBookmark;
  begin
    Campos := '';
    Filial:= qryUsuariosFiliaisfilial.AsString;
    Pos:= qryUsuariosFiliais.GetBookmark;
    try
      qryUsuariosFiliais.DisableControls;
      qryUsuariosFiliais.First;
      while not qryUsuariosFiliais.Eof do
      begin
        if (qryUsuariosFiliaisfilial.AsString <> '') then
        begin
          if not Editando then
            Campos := Campos + '' + QuotedStr(qryUsuariosFiliaisfilial.AsString) + ','
          else if (qryUsuariosFiliaisfilial.AsString <> Filial) then
            Campos := Campos + '' + QuotedStr(qryUsuariosFiliaisfilial.AsString) + ',';
        end;
        qryUsuariosFiliais.Next;
      end;
    finally
      qryUsuariosFiliais.EnableControls;
      qryUsuariosFiliais.GotoBookmark(Pos);
      qryUsuariosFiliais.FreeBookmark(Pos);
      Delete(Campos,Length(Campos),1);
    end;
    if Campos <> '' then
    begin
      qryProcuraFilial.Sql[03] := Format('and not (codigo in (%s))', [Campos]);
      qryConsultaFiliais.Sql[04]:= Format('Where not (codigo in (%s))', [Campos]);
    end
    else
    begin
      qryProcuraFilial.Sql[03] := '';
      qryConsultaFiliais.Sql[04]:= '';
    end;
  end;

begin
  Result := True;
  Filiais(Editar);
  if not Editar or qryUsuariosFiliais.IsEmpty then
  begin
    qryUsuariosFiliais.Append;
    qryUsuariosFiliaisusuario.AsInteger:= qryUsuarioscodigo.AsInteger;
  end
  else begin
    qryUsuariosFiliais.Edit;
    qryUsuariosFiliais.Cancel;
  end;
end;

