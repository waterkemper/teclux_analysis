begin
  Result:= False;
  if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o SETOR DO USUÁRIO'])) = smbOk then begin
    if not qrySetoresUsuarios.IsEmpty then
         qrySetoresUsuarios.Delete
    else qrySetoresUsuarios.Cancel;
    Result:= True;
