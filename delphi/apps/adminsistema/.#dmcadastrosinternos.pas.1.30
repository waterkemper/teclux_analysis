function TdtmCadastrosInternos.ExcluirUsuario(Login: String): Boolean;
begin
  if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o USUÁRIO'])) = smbOk then begin
    if not qryUsuarios.IsEmpty then
       qryUsuarios.Delete
    else qryUsuarios.Cancel;
    Perpetrar([qryMetasUsuarios,qryComissoesUsuarios,qryUsuarios]);
    if trim(login)<>'' then
    begin
     qryManutencaoLogin.Sql.Text := 'drop user '+Login;
     qryManutencaoLogin.Open;
    end;
    Result:= True;
  end
  else
    Result:= False;
end;

function TdtmCadastrosInternos.GravarUsuario(Login, Senha: String): Boolean;
var
  a:Integer;
begin
  Result := True;
  if qryUsuarios.CheckRequiredFields then begin
    if qryUsuarios.State in [dsInsert] then begin
      ReFazConsulta(qryIDLogin,[0],[Login]);
      if not qryIDLogin.IsEmpty then
      begin
        if (qryIDLogincodigousuario.AsInteger=qryIDLoginusesysid.AsInteger) then
        begin
          MensagemAviso(Format(ctLOGINUTILIZADO, [qryIDLoginusename.AsString,qryIDLogincodigousuario.AsInteger]));
          Result := False
        end
        else
        begin
          Result := MensagemConfirmacao(Format(ctLOGINUSUARIOEXISTE, [Login])) = smbOK;
          if Result then
            qryUsuarioscodigo.AsInteger:= qryIDLoginusesysid.AsInteger
        end
      end
      else
      begin
        ReFazConsulta(qryIDLogin,[0],[UsuarioLogin.LoginUsuario]);
        if qryIDLoginusesuper.AsBoolean then
        begin
          qryManutencaoLogin.Sql.Text := 'create user ' + Login + ' with password ''' + Senha + '''';
          qryUseSys.Open;
          ReFazConsulta(qryConsultaCodigoUsuario, [0], [qryUseSysmaxusesysid.AsInteger+1]);
          qryUseSys.Close;
          if qryUsuarioscodigo.IsNull then
          begin
            qryMaxUsuarios.Open;
            qryUsuarioscodigo.AsInteger := qryMaxUsuarioscodigo.AsInteger+1;
            qryMaxUsuarios.Close;
          end;
          qryManutencaoLogin.Open;
          if not qryConsultaCodigoUsuario.IsEmpty then begin

            qryManutencaoLogin.Sql.Text := qryManutencaoLogin.Sql.Text + ' sysid ' +
                                          IntToStr(qryUsuarioscodigo.AsInteger);
          end;
          if qryUsuariosadministrador.AsBoolean then
            qryManutencaoLogin.Sql.Text := qryManutencaoLogin.Sql.Text + ' createuser';
          ReFazConsulta(qryIDLogin,[0],[Login]);
//          qryUsuarioscodigo.AsInteger:= qryMaxUsuarioscodigo.AsInteger+1;
//          qryMaxUsuarios.Close;
        end
        else
        begin
          MensagemAviso(ctSEMPERMISSAOCRIARUSUARIO);
          Result := False;
        end;
      end
    end
    else
    begin
      if(qryUsuariosusename.OldValue<>qryUsuariosusename.AsString) then
      begin
        ReFazConsulta(qryIDLogin,[0],[Login]);
        if((not qryIDLogin.IsEmpty) and (qryIDLogincodigousuario.AsInteger<>qryUsuarioscodigo.AsInteger))then
        begin
            MensagemAviso('O login digitado já está sendo utilizado!');
            Result:=false;
        end;
      end
      else
      begin
        qryManutencaoLogin.Sql.Text := '';
        if senha <> '' then
          qryManutencaoLogin.Sql.Text := ' with password ''' + Senha + '''';
        if qryUsuariosadministrador.AsBoolean <> qryUsuariosadministrador.OldValue then
          if qryUsuariosadministrador.AsBoolean then
            qryManutencaoLogin.Sql.Text := qryManutencaoLogin.Sql.Text + ' createuser'
          else
            qryManutencaoLogin.Sql.Text := qryManutencaoLogin.Sql.Text + ' nocreateuser';
        if qryManutencaoLogin.Sql.Text <> '' then begin
          qryManutencaoLogin.Sql.Text := 'alter user ' + Login + qryManutencaoLogin.Sql.Text;
          qryManutencaoLogin.Open;
        end
      end;
    end;

    if result then
      result := SalvarUsuariosOperacoesProducao(true);


    if result then
    begin
      if qryUsuarioscobrancaanterior.AsBoolean and qryUsuarioscobranca.AsBoolean then
        qryUsuarioscobranca.AsBoolean := not ExlcuirComisssoesCobranca;
    end;

    if Result then begin
      qryMetasUsuarios.First;
      for a:= 1 to qryMetasUsuarios.RecordCount do begin
        qryMetasUsuarios.Edit;
        qryMetasUsuariosusuario.AsInteger:= qryUsuarioscodigo.AsInteger;
        qryMetasUsuarios.Next;
      end;

      FNRComissoes:= 0;
      qryComissoesUsuarios.First;
      for a:= 1 to qryComissoesUsuarios.RecordCount do begin
        FNRComissoes:= FNRComissoes + 1;
        if (qryComissoesUsuariosnumero.AsInteger = 0) then begin
          qryComissoesUsuarios.Edit;
          qryComissoesUsuariosusuario.AsInteger:= qryUsuarioscodigo.AsInteger;
          qryComissoesUsuariosnumero.AsInteger:= FNRComissoes;
        end;
        qryComissoesUsuarios.Next;
      end;

      FNRComissoes:= 0;
      qryComissoesUsuariosIndicados.First;
      for a:= 1 to qryComissoesUsuariosIndicados.RecordCount do begin
        FNRComissoes:= FNRComissoes + 1;
        if (qryComissoesUsuariosIndicadosnumero.AsInteger = 0) then begin
          qryComissoesUsuariosIndicados.Edit;
          qryComissoesUsuariosIndicadosusuario.AsInteger:= qryUsuarioscodigo.AsInteger;
          qryComissoesUsuariosIndicadosnumero.AsInteger:= FNRComissoes;
        end;
        qryComissoesUsuariosIndicados.Next;
      end;

      qryComissoesUsuariosGrupos.First;
      for a:= 1 to qryComissoesUsuariosGrupos.RecordCount do begin
        qryComissoesUsuariosgrupos.Edit;
        qryComissoesUsuariosGruposusuario.AsInteger:= qryUsuarioscodigo.AsInteger;
        qryComissoesUsuariosgrupos.Next;
      end;

      qryComissoesUsuariosClasses.First;
      for a:= 1 to qryComissoesUsuariosClasses.RecordCount do begin
        qryComissoesUsuariosClasses.Edit;
        qryComissoesUsuariosClassesusuario.AsInteger:= qryUsuarioscodigo.AsInteger;
        qryComissoesUsuariosClasses.Next;
      end;

      qryComissoesCobranca.First;
      for a:= 1 to qryComissoesCobranca.RecordCount do begin
        qryComissoesCobranca.Edit;
        qryComissoesCobrancausuario.AsInteger:= qryUsuarioscodigo.AsInteger;
        qryComissoesCobranca.Next;
      end;

      qryUsuariosFiliais.First;
      for a:= 1 to qryUsuariosFiliais.RecordCount do begin
        qryUsuariosFiliais.Edit;
        qryUsuariosFiliaisusuario.AsInteger:= qryUsuarioscodigo.AsInteger;
        qryUsuariosFiliais.Next;
      end;

      qryUsuariosOperacoesProducao.First;
      for a:= 1 to qryUsuariosOperacoesProducao.RecordCount do begin
        qryUsuariosOperacoesProducao.Edit;
        qryUsuariosOperacoesProducaousuario.AsInteger:= qryUsuarioscodigo.AsInteger;
        qryUsuariosOperacoesProducao.Next;
      end;


      if qryUsuarios.state in [dsedit, dsinsert] then
        qryUsuarios.Post;
        
      Perpetrar([qryUsuarios,qryMetasUsuarios,qryComissoesUsuarios,qryComissoesUsuariosIndicados,
                 qrycomissoesusuariosgrupos, qrycomissoesusuariosclasses,
                 qryComissoesCobranca,qrySetoresUsuarios,qryUsuariosFiliais,
                 qryUsuariosOperacoesProducao]);

      ReFazConsulta(qryMetasUsuarios,[0],[qryUsuarioscodigo.AsInteger]);
    end;
  end;
end;

