  object qryCartasDetalheEtiquetas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select min(numero) as numero,'
      '         sexo,'
      '         eavalista,'
      '         codigocliente,'
      '         tipocliente,'
      '         cliente,'
      '         codigoavalista, '
      '         avalista,'
      '         rua,'
      '         bairro,'
      '         cep,'
      '         cidade,'
      '         estado'
      'from'
      '('
      'select  cartas.numero,'
      '        cartas.tipocarta, '
      '        cartas.tipocliente,'
      '        cartas.codigocliente,'
      '        cartas.cliente,'
      '        cartas.rua,'
      '        cartas.estado,'
      '        (Select c.nome From cidades c'
      
        '                                      Where  (c.estado = cartas.' +
        'estado)  and'
      
        '                                                   (c.codigo = c' +
        'artas.codigocidade)) as Cidade,'
      '         (Select b.nome From bairros b'
      
        '                                      Where  (b.estado = cartas.' +
        'estado)  and'
      
        '                                                 (b.cidade = car' +
        'tas.codigocidade)  and'
      
        '                                                 (b.codigo = car' +
        'tas.codigobairro)) as Bairro,'
      '        cartas.cep,'
      '        cartas.sexo,  '
      '        cartas.contrato,'
      '        cartas.data_de_envio,'
      '        cartas.data_da_compra,'
      '        cartas.primeiro_vencto,'
      '        cartas.dias_de_atraso,'
      '        cartas.valor_em_aberto,'
      '        cartas.valor_em_atraso,'
      '        cartas.codigoavalista,'
      '        cartas.avalista,'
      '        cartas.eavalista, '
      '        case when cartas.eavalista then'
      
        '          cast(cartas.codigocliente as varchar)||cartas.tipoclie' +
        'nte||cast('#39'True'#39' as varchar) else'
      
        '          cast(cartas.codigocliente as varchar)||cartas.tipoclie' +
        'nte||cast('#39'False'#39' as varchar) end as AgrupamentoCartas'
      'from '
      ' ( select contratos.*,'
      '           cartas.numero,  '
      '           cartas.data as data_de_envio,'
      '           cartas.eavalista,'
      '           cartas.tipocarta,'
      
        '           (select coalesce(vf.razao,vf.nome) from vfornecedores' +
        ' vf where vf.codigo=codigocliente and vf.tipo=tipocliente) as cl' +
        'iente,'
      '           case when cartas.eavalista then'
      
        '            (select vf.rua from vfornecedores vf where vf.codigo' +
        '=codigoavalista and vf.tipo='#39'C'#39') else'
      
        '            (select vf.rua from vfornecedores vf where vf.codigo' +
        '=codigocliente and vf.tipo=tipocliente)'
      '          end as rua,'
      '          case when cartas.eavalista then'
      
        '            (select vf.estado from vfornecedores vf where vf.cod' +
        'igo=codigoavalista and vf.tipo='#39'C'#39') else'
      
        '            (select vf.estado from vfornecedores vf where vf.cod' +
        'igo=codigocliente and vf.tipo=tipocliente)'
      '          end as estado,'
      '          case when cartas.eavalista then'
      
        '            (select vf.cep from vfornecedores vf where vf.codigo' +
        '=codigoavalista and vf.tipo='#39'C'#39') else'
      
        '            (select vf.cep from vfornecedores vf where vf.codigo' +
        '=codigocliente and vf.tipo=tipocliente)'
      '          end as cep,'
      '          case when cartas.eavalista then'
      
        '           (select vf.cidade from vfornecedores vf where vf.codi' +
        'go=codigoavalista and vf.tipo='#39'C'#39') else'
      
        '           (select vf.cidade from vfornecedores vf where vf.codi' +
        'go=codigocliente and vf.tipo=tipocliente)'
      '          end as codigocidade,'
      '          case when cartas.eavalista then'
      
        '           (select vf.bairro from vfornecedores vf where vf.codi' +
        'go=codigoavalista and vf.tipo='#39'C'#39') else'
      
        '           (select vf.bairro from vfornecedores vf where vf.codi' +
        'go=codigocliente and vf.tipo=tipocliente)'
      '          end as codigobairro'
      '  from cartas,'
      '  (select contratos.numero as contrato,'
      '         contratos.cliente as codigocliente,'
      
        '         (select cl.sexo from clientes cl where cl.codigo=contra' +
        'tos.cliente and '#39'C'#39'=contratos.tipocliente) as sexo,'
      '         contratos.tipocliente as tipocliente,'
      '         contratos.faturamento as data_da_compra,'
      '         contratos.avalista as codigoavalista, '
      '         clientes.nome as avalista,'
      '         primeiro_vencto,'
      '         dias_de_atraso,'
      '         valor_em_aberto,'
      '         valor_em_atraso'
      
        '   from (contratos left join clientes on contratos.avalista=clie' +
        'ntes.codigo), '
      '                                 (SELECT contrato,'
      
        '                                       MIN(datavencto) as primei' +
        'ro_vencto,'
      
        '                                       CURRENT_DATE-MIN(p.datave' +
        'ncto) as dias_de_atraso,'
      
        '                                       SUM(p.valorvencto) as val' +
        'or_em_aberto,'
      
        '                                      SUM(CASE WHEN p.datavencto' +
        ' < CURRENT_DATE THEN p.valorvencto ELSE 0 END) as valor_em_atras' +
        'o'
      '                                    FROM parcelas p '
      '                                   WHERE p.datapagto IS NULL'
      '                                   GROUP BY p.contrato'
      '                                  ) as parcelas '
      
        '                                    where parcelas.contrato = co' +
        'ntratos.numero'
      '   ) as contratos '
      '     where contratos.contrato=cartas.contrato'
      '  ) as cartas'
      '/*     where cartas.numero=:numero   */'
      ') as cartasetiquetas'
      
        'group by cep, rua, bairro, cidade, estado, sexo, eavalista, codi' +
        'gocliente, tipocliente, cliente, codigoavalista, avalista')
    RequestLive = False
    Left = 72
    Top = 408
