      '  from'
      '   ('
      '    select  cast(c.numero||'#39'.'#39'||cc.numero as varchar) as carta,'
      '             c.tipocarta,'
      '             cc.cliente,'
      '             cc.tipocliente,'
      '             cc.avalista,'
      '             cc.enviada,'
      '             cc.eavalista             '
      '    from cartas c, cartasclientes cc'
      '           Where c.numero = cc.carta and cc.eavalista'
      '        /* and c.numero in (listanumerocartaavalista) */ '
      '   ) as cartas, parcelas p, contratos ct'
      '     where cartas.carta=p.cartaavalista and'
      '              ct.numero=p.contrato    '
      '  )'
