  ReFazConsulta(qryRecebimentosTiposRecebimentos, [0], [qryTiposRecebimentoscodigo.AsVariant]);
  qryTiposRecebimentosnumerorecebimentos.AsInteger := 1;
  qryTiposRecebimentosintervalorecebimentos.AsInteger := 0;
  qryTiposRecebimentosdiasuteis.AsInteger := 0;
end;

procedure TdtmCadastroTabelasCrediario.dsrRecebimentosTiposRecebimentosDataChange(
  Sender: TObject; Field: TField);
begin
  inherited;
  if Assigned(field) then
  begin
    qryTiposRecebimentos.Edit;
    if qryRecebimentosTiposRecebimentosmes.AsString = '' then
      qryRecebimentosTiposRecebimentosmes.AsString := 'A';
    if Field = qryRecebimentosTiposRecebimentosdatainicial then
    begin
      if Field.AsInteger > qryRecebimentosTiposRecebimentosdatafinal.AsInteger then
        qryRecebimentosTiposRecebimentosdatafinal.AsInteger := Field.AsInteger + 1;
    end
    else
    if Field = qryRecebimentosTiposRecebimentosdatafinal then
    begin
      if (Field.AsInteger > qryRecebimentosTiposRecebimentosdia.AsInteger) and
         (qryRecebimentosTiposRecebimentosmes.AsString = 'A') then
        qryRecebimentosTiposRecebimentosdia.AsInteger := Field.AsInteger + 1;
      if Field.AsInteger < qryRecebimentosTiposRecebimentosdatainicial.AsInteger then
        Field.AsInteger := qryRecebimentosTiposRecebimentosdatainicial.AsInteger + 1;
      if Field.AsInteger > 31 then
        Field.AsInteger := 31;
    end
    else
    if Field = qryRecebimentosTiposRecebimentosdia then
    begin
      if (Field.AsInteger < qryRecebimentosTiposRecebimentosdatafinal.AsInteger) and
         (qryRecebimentosTiposRecebimentosmes.AsString = 'A') then
        qryRecebimentosTiposRecebimentosmes.AsString := 'P';
      if Field.AsInteger > 31 then
        Field.AsInteger := 31;
    end;
  end;
end;

