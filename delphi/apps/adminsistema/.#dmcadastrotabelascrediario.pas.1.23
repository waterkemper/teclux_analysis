var
  dtmCadastroTabelasCrediario: TdtmCadastroTabelasCrediario;
  vPressionadoBotaoGravar : boolean;

implementation

uses dmtecsoft;

{$R *.dfm}

constructor TdtmCadastroTabelasCrediario.Create(AOwner: TComponent);
begin
  inherited;
  qryAgentes.Tag                 := ctCrediarioTabelaAgentes;
  qryCargos.Tag                  := ctCrediarioTabelaCargos;
  qryConceitos.Tag               := ctCrediarioTabelaConceitos;
  qryMotivos.Tag                 := ctCrediarioTabelaMotivos;
  qryTiposPlanos.Tag             := ctCrediarioTabelaTiposPlanos;
  qryTiposCartas.Tag             := ctCrediarioTabelaTiposCartas;
  qryNaturezas.Tag               := ctCrediarioTabelaNaturezas;
  qryOperacao.tag                := ctCrediarioTabelaNaturezas;
  qryTiposRecebimentos.Tag       := ctCrediarioTabelaTiposRecebimentos;
  qryConsultaAgentes.Tag         := ctCrediarioTabelaConsultaAgentes;
  qryConsultaAgentesTiposCartas.Tag := ctCrediarioTabelaConsultaAgentesTiposCartas;
  qryConsultaCargos.Tag          := ctCrediarioTabelaConsultaCargos;
  qryConsultaConceitos.Tag       := ctCrediarioTabelaConsultaConceitos;
  qryConsultaConceitosTiposCartas.Tag := ctCrediarioTabelaConsultaConceitosTiposCartas;
  qryConsultaMotivos.Tag         := ctCrediarioTabelaConsultaMotivos;
  qryConsultaTiposCartas.Tag     := ctCrediarioTabelaConsultaTiposCartas;
  qryConsultaTiposCartasPrecedente.Tag := ctCrediarioTabelaConsultaTiposCartasPrecedente;
  qryConsultaTiposPlanos.Tag     := ctCrediarioTabelaConsultaTiposPlanos;
  qryConsultaNaturezas.Tag       := ctCrediarioTabelaConsultaNaturezas;
  qryConsultaCodigosFiscais.Tag  := ctTabelaConsultaCodigoFiscal;
  qryConsultaTiposMovimentos.Tag := ctConsultaTiposMovimentos;
  qryConsultaHistorico.Tag       := ctConsultaHistoricos;
  qryConsultaTiposRecebimentos.Tag := ctConsultaTiposRecebimentos;
  qryConsultaContaContabil.Tag := ctConsultaContaContabil;
  qryProdutosporCargo.Tag      := ctCrediarioTabelasProdutosCargos;
  qryConsultaContas.Tag        := ctConsultaContas;
  qryProcuraDebitar.Params[1].AsInteger := 0;
  qryProcuraCreditar.Params[1].AsInteger := 0;
end;

procedure TdtmCadastroTabelasCrediario.AbrirTabelasCadastro(Tabela: TtecTabelasCrediario);
begin
  case Tabela of
    tbcAGENTE          : Abre(ctCrediarioTabelaAgentes);
    tbcCARGO           : Abre(ctCrediarioTabelaCargos);
    tbcCONCEITO        : Abre(ctCrediarioTabelaConceitos);
    tbcTIPOPLANO       : Abre(ctCrediarioTabelaTiposPlanos);
    tbcMOTIVO          : Abre(ctCrediarioTabelaMotivos);
    tbcTIPOCARTA       : Abre(ctCrediarioTabelaTiposCartas);
    tbcNATUREZA        : Abre(ctCrediarioTabelaNaturezas);
    tbcTIPORECEBIMENTO : Abre(ctCrediarioTabelaTiposRecebimentos);
    tbcPRODUTOSCARGOS  : qryProdutosporCargo.Open;
    tbcCONTAS          : qryContasTiposRecebimentos.Open;
    tbcQUALIDADE_VENDAS : qryQualidade_Vendas.oPEN;
  end;
end;

procedure TdtmCadastroTabelasCrediario.AbrirTabelasConsulta(Tabela: TtecTabelasCrediario);
begin
  case Tabela of
    tbcAGENTE : Abre(ctCrediarioTabelaConsultaAgentes);
    tbcAGENTETIPOCARTA : Abre(ctCrediarioTabelaConsultaAgentesTiposCartas);
    tbcCARGO    : Abre(ctCrediarioTabelaConsultaCargos);
    tbcCONCEITO : Abre(ctCrediarioTabelaConsultaConceitos);
    tbcCONCEITOTIPOCARTA : Abre(ctCrediarioTabelaConsultaConceitosTiposCartas);
    tbcTIPOPLANO: Abre(ctCrediarioTabelaConsultaTiposPlanos);
    tbcMOTIVO   : Abre(ctCrediarioTabelaConsultaMotivos);
    tbcTIPOCARTA: Abre(ctCrediarioTabelaConsultaTiposCartas);
    tbcTIPOATENDIMENTO : qryConsultaTiposAtendimentos.Open;
    tbcAGENTETIPORECEBIMENTO : qryConsultaAgentes.Open;
    tbcTIPOCARTAPRECEDENTE: begin
                             qryConsultaTiposCartas.MacroByName('SQL').AsString := '';
                             qryConsultaTiposCartasPrecedente.Params[0].AsInteger := qryTiposCartascodigo.AsInteger;
                             Abre(ctCrediarioTabelaConsultaTiposCartasPrecedente);
                            end;
    tbcNATUREZA : Abre(ctCrediarioTabelaConsultaNaturezas);
    tbcCFOP     : Abre(ctTabelaConsultaCodigoFiscal);
    tbcTIPOMOVTO: Abre(ctConsultaTiposMovimentos);
    tbcCONTADEBITO : begin
                       if qryNaturezascreditar.AsInteger<>0 then
                         qryConsultaContaContabil.MacroByName('consulta').AsString :=
                           'and codigo <> '+qryNaturezascreditar.AsString;
                       Abre(ctConsultaContaContabil);
                     end;
    tbcCONTACREDITO : begin
                       if qryNaturezasdebitar.AsInteger<>0 then
                         qryConsultaContaContabil.MacroByName('consulta').AsString :=
                           'and codigo <> '+qryNaturezasdebitar.AsString;
                       Abre(ctConsultaContaContabil);
                      end;
    tbcCONTACONTABIL : begin
                         qryConsultaContaContabil.MacroByName('consulta').AsString :='';
                         Abre(ctConsultaContaContabil);
                      end;
    tbcHISTORICO   : abre(ctConsultaHistoricos);
    tbcTIPORECEBIMENTO : abre(ctConsultaTiposRecebimentos);
    tbcCONTAS : abre(ctConsultaContas);
  end;
end;

procedure TdtmCadastroTabelasCrediario.FecharTabelasConsulta(Tabela: TtecTabelasCrediario);
begin
  case Tabela of
    tbcAGENTE : Fecha(ctCrediarioTabelaConsultaAgentes);
    tbcAGENTETIPOCARTA : Fecha(ctCrediarioTabelaConsultaAgentesTiposCartas);
    tbcCARGO    : Fecha(ctCrediarioTabelaConsultaCargos);
    tbcCONCEITO : Fecha(ctCrediarioTabelaConsultaConceitos);
    tbcCONCEITOTIPOCARTA : Fecha(ctCrediarioTabelaConsultaConceitosTiposCartas);
    tbcTIPOPLANO: Fecha(ctCrediarioTabelaConsultaTiposPlanos);
    tbcMOTIVO   : Fecha(ctCrediarioTabelaConsultaMotivos);
    tbcTIPOCARTA: Fecha(ctCrediarioTabelaConsultaTiposCartas);
    tbcAGENTETIPORECEBIMENTO: qryConsultaAgentes.Close;
    tbcTIPOATENDIMENTO: qryConsultaTiposAtendimentos.Close;
    tbcTIPOCARTAPRECEDENTE: Fecha(ctCrediarioTabelaConsultaTiposCartasPrecedente);
    tbcNATUREZA : Fecha(ctCrediarioTabelaConsultaNaturezas);
    tbcCFOP     : Fecha(ctTabelaConsultaCodigoFiscal);
    tbcTIPOMOVTO: Fecha(ctConsultaTiposMovimentos);
    tbcCONTADEBITO,
    tbcCONTACREDITO,
    tbcCONTACONTABIL: Fecha(ctCONSULTACONTACONTABIL);
    tbcHISTORICO   : Fecha(ctConsultaHistoricos);
    tbcTIPORECEBIMENTO : Fecha(ctConsultaTiposRecebimentos);
    tbcPRODUTOSCARGOS  : qryProdutosporCargo.Close;
    tbcCONTAS : Fecha(ctConsultaContas);
  end;
end;

function TdtmCadastroTabelasCrediario.ExcluirConceito: Boolean;
begin
  if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o CONCEITO'])) = smbOk then begin
    if not qryConceitos.IsEmpty then
         qryConceitos.Delete
    else qryConceitos.Cancel;
    Perpetrar([qryConceitos]);
    Result:= True;
  end
  else
    Result:= False;
end;

