function TdtmCadastroTabelasCrediario.ExcluirTIpoRecebimento: Boolean;
begin
  if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o TIPO DE RECEBIMENTO'])) = smbOk then
  begin
    if not qryTiposRecebimentos.IsEmpty then
      qryTiposRecebimentos.Delete
    else
      qryTiposRecebimentos.Cancel;
    Perpetrar([qryTiposRecebimentos]);
    Result:= True;
  end
  else
    Result:= False;
end;

function TdtmCadastroTabelasCrediario.GravarTipoRecebimento: Boolean;
var
  n:Integer;
begin
//  qryTiposRecebimentosdiasuteis.Required := qryTiposRecebimentostiporecebimento.AsString = 'B';
  if qryTiposRecebimentos.CheckRequiredFields then
  begin
    if qryTiposRecebimentos.State = dsInsert then
    begin
      spcTiposRecebimentosProximo.Open;
      qryTiposRecebimentoscodigo.asInteger:= spcTiposRecebimentosProximocodigo.AsInteger;
      spcTiposRecebimentosProximo.Close;
    end;

    if not qryTiposRecebimentosdiasuteis.IsNull and
       not qryRecebimentosTiposRecebimentos.IsEmpty then
      if MensagemConfirmacao('O campo "DIAS ÚTEIS" anula os valores definidos no grid "RECEBIMENTOS".' + sLineBreak +
                             'Deseja manter os valores definidos?') <> smbOK then
        LimparTabela(qryRecebimentosTiposRecebimentos);

    if// (qryTiposRecebimentostiporecebimento.AsString <> 'B') and
       not qryRecebimentosTiposRecebimentos.IsEmpty and
       qryRecebimentosTiposRecebimentos.CheckRequiredFields then
    begin
      qryRecebimentosTiposRecebimentos.AfterPost := nil;
      GuardarRegistroAtual(qryRecebimentosTiposRecebimentos,true);
      qryRecebimentosTiposRecebimentos.First;
      n := 1;
      while not qryRecebimentosTiposRecebimentos.Eof do
      begin
        qryRecebimentosTiposRecebimentos.Edit;
        qryRecebimentosTiposRecebimentostiporecebimento.AsInteger := qryTiposRecebimentoscodigo.AsInteger;
        qryRecebimentosTiposRecebimentosnumero.AsInteger := n;
        Inc(n);
        qryRecebimentosTiposRecebimentos.Post;
        qryRecebimentosTiposRecebimentos.Next;
      end;
      VoltarRegistroAtual(qryRecebimentosTiposRecebimentos);
      qryRecebimentosTiposRecebimentos.AfterPost := qryRecebimentosTiposRecebimentosAfterPost;
    end;

    if not qryContasTiposRecebimentos.IsEmpty then
    begin
      GuardarRegistroAtual(qryContasTiposRecebimentos,true);
      qryContasTiposRecebimentos.First;
      while not qryContasTiposRecebimentos.Eof do
      begin
        qryContasTiposRecebimentos.Edit;
        qryContasTiposRecebimentostiporecebimento.AsInteger := qryTiposRecebimentoscodigo.AsInteger;
        qryContasTiposRecebimentos.Post;
        qryContasTiposRecebimentos.Next;
      end;
      VoltarRegistroAtual(qryContasTiposRecebimentos);
    end;

    qryTiposRecebimentos.Post;
//    if qryTiposRecebimentostiporecebimento.AsString <> 'B' then
      Result := Perpetrar([qryTiposRecebimentos, qryRecebimentosTiposRecebimentos,
                           qryContasTiposRecebimentos])
//    else
//      Result := Perpetrar([qryTiposRecebimentos]);
  end
  else
    Result:= False;
end;

