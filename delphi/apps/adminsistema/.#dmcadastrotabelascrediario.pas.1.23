function TdtmCadastroTabelasCrediario.GravarAgenteTipoCarta: Boolean;
begin
  qryAgentesTiposCartasdescricao.Value := qryProcuraAgentesTiposCartasdescricao.Value;
  qryAgentesTiposCartas.Post;
  if not (qryTiposCartas.State in [dsEdit]) then
    qryTiposCartas.Edit;
  Result:= True;
end;

function TdtmCadastroTabelasCrediario.GravarConceitoTipoCarta: Boolean;
begin
  qryConceitosTiposCartasdescricao.Value := qryProcuraConceitosTiposCartasdescricao.Value;
  qryConceitosTiposCartas.Post;
  if not (qryTiposCartas.State in [dsEdit]) then
    qryTiposCartas.Edit;
  Result:= True;
end;

function TdtmCadastroTabelasCrediario.IncluirAgenteTipoCarta(
  Editar: Boolean): Boolean;
begin
  qryProcuraAgentesTiposCartas.Sql[4]  := 'AND' + MontaFiltroAgentes(Editar);
  qryConsultaAgentesTiposCartas.Sql[3] := 'WHERE' + MontaFiltroAgentes(Editar);
  if qryAgentesTiposCartas.State in [dsInsert, dsEdit] then
    qryAgentesTiposCartas.Cancel;
  if Editar and not qryAgentesTiposCartas.IsEmpty then
    qryAgentesTiposCartas.Edit
  else
    qryAgentesTiposCartas.Append;
  Result := True;
end;

function TdtmCadastroTabelasCrediario.IncluirConceitoTipoCarta(
  Editar: Boolean): Boolean;
begin
  qryProcuraConceitosTiposCartas.Sql[4] := 'AND' + MontaFiltroConceitos(Editar);
  qryConsultaConceitosTiposCartas.Sql[3] := 'WHERE' + MontaFiltroConceitos(Editar);
  if qryConceitosTiposCartas.State in [dsInsert, dsEdit] then
    qryConceitosTiposCartas.Cancel;
  if Editar and not qryConceitosTiposCartas.IsEmpty then
    qryConceitosTiposCartas.Edit
  else
    qryConceitosTiposCartas.Append;
  Result := True;
end;

