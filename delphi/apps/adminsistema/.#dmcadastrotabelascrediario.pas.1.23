    Except
      MensagemErro('Produto já cadastrado');
    end;
    Result:= True;
  end
  else
    Result:= False;
  //qryProdutosporCargo.GotoBookmark(Pos);
  //qryProdutosporCargo.FreeBookmark(Pos);
  //qryProdutosporCargo.EnableControls;
end;

function TdtmCadastroTabelasCrediario.ExcluirProdutoCargo: Boolean;
begin
  Result:= False;
  if not qryProdutosporCargo.IsEmpty then begin
    if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o PRODUTO'])) = smbOk then begin
      qryProdutosporCargo.Delete;
      Perpetrar([qryProdutosporCargo]);
      Result := True;
    end;
  end;
end;



procedure TdtmCadastroTabelasCrediario.dsrprodutosporCargoDataChange(
  Sender: TObject; Field: TField);
begin
  inherited;
  dsrprodutosporCargo.OnDataChange:= nil;
  if not formularioInsercao then
  begin
    if Field = qryProdutosporCargomarkup then
    begin
      qryProdutosporCargo.DisableControls;
      if not (qryProdutosporCargo.State in [dsedit,dsinsert]) then
        qryProdutosporCargo.Edit;
      if qryProdutosporCargomarkup.AsFloat > 0 then
        qryProdutosporCargo.Post;
    end;
  end;
  dsrprodutosporCargo.OnDataChange:= dsrprodutosporCargoDataChange;
end;

procedure TdtmCadastroTabelasCrediario.OrdenarProdutosCargos;
const SQLOrdenacao =  'order by %s';
begin
  qryProdutosporCargo.DisableControls;
  qryProdutosporCargo.Close;

  case OrdenarCodigo of
  0: begin
    qryProdutosporCargo.MacroByName('Ordenacao').AsString:= Format(SQLOrdenacao,['pc.produtodigitado']);
     end;
  1: begin
    qryProdutosporCargo.MacroByName('Ordenacao').AsString:= Format(SQLOrdenacao,['descricao']);
     end;
  end;

  qryProdutosporCargo.Open;
  qryProdutosporCargo.EnableControls;
end;

procedure TdtmCadastroTabelasCrediario.EditarProdutosCargos;
var Pos : TBookMark;
begin
  Pos:= qryProdutosporCargo.GetBookmark;
  try
    qryprodutosporCargo.DisableControls;
    qryprodutosporCargo.Edit;
  finally
    qryprodutosporCargo.EnableControls;
    qryprodutosporCargo.GotoBookmark(Pos);
    qryprodutosporCargo.FreeBookmark(Pos);
    formularioInsercao:= False;
  end;
end;

procedure TdtmCadastroTabelasCrediario.qryProdutosporCargoBeforePost(
  DataSet: TDataSet);
begin
  inherited;
  if not formularioInsercao then
    FMarcador:= qryProdutosporCargoproduto.AsLargeInt;
end;

procedure TdtmCadastroTabelasCrediario.qryProdutosporCargoAfterPost(
  DataSet: TDataSet);
begin
  inherited;
  if not formularioInsercao then
  begin
    Perpetrar([qryProdutosporCargo]);
    qryProdutosporCargo.RecNo:= FSelecionado;
    qryProdutosporCargo.Locate('Produto',FMarcador,[]);
    qryProdutosporCargo.EnableControls;
  end;
end;

