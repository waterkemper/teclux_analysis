function TdtmCadastroTabelasCrediario.GravarConceito: Boolean;
begin
  if qryConceitos.CheckRequiredFields then begin
    if qryConceitos.State = dsInsert then
      qryConceitos.Post;
      Perpetrar([qryConceitos]);
      Result:= True;
    end
  else
    Result:= False;
end;

function TdtmCadastroTabelasCrediario.GravarCargo: Boolean;
begin
  if qryCargos.CheckRequiredFields then begin
    if qryCargos.State = dsInsert then
    begin
      spcCargosProximo.Open;
      qryCargoscodigo.asInteger:= spcCargosProximocodigo.AsInteger;
      spcCargosProximo.Close;
    end;
    qryCargos.Post;
    Perpetrar([qryCargos]);
    Result:= True;
  end
  else
    Result:= False;
end;

function TdtmCadastroTabelasCrediario.GravarAgente: Boolean;
begin
  if qryAgentes.CheckRequiredFields then begin
    qryAgentes.Post;
    Perpetrar([qryAgentes]);
    Result:= True;
  end
  else
    Result:= False;  
end;

function TdtmCadastroTabelasCrediario.GravarTipoPlano: Boolean;
begin
  if qryTiposPlanos.CheckRequiredFields then begin
    if qryTiposPlanos.State = dsInsert then
    begin
      spcTiposPlanosProximo.Open;
      qryTiposPlanoscodigo.AsInteger:= spcTiposPlanosProximocodigo.AsInteger;
      spcTiposPlanosProximo.Close;
    end;
    qryTiposPlanos.Post;
    Perpetrar([qryTiposPlanos]);
    Result:= True;
  end
  else
    Result:= False;
end;

function TdtmCadastroTabelasCrediario.GravarMotivo: Boolean;
begin
  if qryMotivos.CheckRequiredFields then begin
    if qryMotivos.State = dsInsert then
    begin
      spcMotivosProximo.Open;
      qryMotivoscodigo.asInteger:= spcMotivosProximocodigo.AsInteger;
      spcMotivosProximo.Close;
    end;
    qryMotivos.Post;
    Perpetrar([qryMotivos]);
    Result:= True;
  end
  else
    Result:= False;
end;

function TdtmCadastroTabelasCrediario.GravarTipoCarta: Boolean;
var
  cnt: Integer;
begin
  if qryTiposCartas.CheckRequiredFields then begin
    if qryTiposCartas.State = dsInsert then
    begin
      spcTiposCartasProximo.Open;
      qryTiposCartascodigo.asInteger:= spcTiposCartasProximocodigo.AsInteger;
      spcTiposCartasProximo.Close;
    end;
    qryTiposCartas.Post;
    qryAgentesTiposCartas.DisableControls;
    qryAgentesTiposCartas.First;
    for cnt:= 1 to qryAgentesTiposCartas.RecordCount do
    begin
     if qryAgentesTiposCartastipocarta.Value = 0 then
     begin
      qryAgentesTiposCartas.Edit;
      qryAgentesTiposCartastipocarta.AsInteger := qryTiposCartascodigo.AsInteger;
      qryAgentesTiposCartas.Post;
     end;
     qryAgentesTiposCartas.Next;
    end;
    qryAgentesTiposCartas.EnableControls;
    qryConceitosTiposCartas.DisableControls;
    qryConceitosTiposCartas.First;
    for cnt:= 1 to qryConceitosTiposCartas.RecordCount do
    begin
     if qryConceitosTiposCartastipocarta.Value = 0 then
     begin
      qryConceitosTiposCartas.Edit;
      qryConceitosTiposCartastipocarta.AsInteger := qryTiposCartascodigo.AsInteger;
      qryConceitosTiposCartas.Post;
     end;
     qryConceitosTiposCartas.Next;
    end;
    qryConceitosTiposCartas.EnableControls;
    Perpetrar([qryTiposCartas, qryAgentesTiposCartas, qryConceitosTiposCartas]);
    Result:= True;
  end
  else
    Result:= False;
end;

function TdtmCadastroTabelasCrediario.GravarNatureza: Boolean;
begin
  Result:= False;
  if qryNaturezas.CheckRequiredFields then
  begin
    if qryNaturezasTipo.AsString = 'E' then  //entrada
    begin
      result := (strtoint(copy(qryNaturezascodigofiscal.AsString,1,1)) in [1,2,3]);
      if not result then
        MensagemErro('O código fiscal não é uma operação de entrada');
    end
    else
    if qryNaturezasTipo.AsString = 'S' then  //saida
    begin
      result := (strtoint(copy(qryNaturezascodigofiscal.AsString,1,1)) in [5,6,7]);
      if not result then
        MensagemErro('O código fiscal não é uma operação de saída');
    end
    else
    if qryNaturezasTipo.AsString = 'R' then  //Serviços
      result := true;

    if result then
    begin
      if qryNaturezas.State = dsInsert then
      begin
        spcNaturezasProximo.Open;
        qryNaturezascodigo.AsInteger:= spcNaturezasProximocodigo.AsInteger;
        spcNaturezasProximo.Close;
      end;
      if ParSistema.GerarContabilidade then
      begin
        qryLancamentosNaturezas.AfterPost := nil;

        qryLancamentosNaturezas.First;
        while not qryLancamentosNaturezas.Eof do
        begin
          if ((qryLancamentosNaturezasoperacao.AsString = 'N') and
              (qryLancamentosNaturezascontacontabil.AsInteger=0) and
              (qryLancamentosNaturezashistorico.AsInteger=0) and
              (qryLancamentosNaturezasclassificacao.AsString='')) or

             (qryNaturezaslanctoscustomedio.AsBoolean and
              ((qryLancamentosNaturezasdescricao.AsString <> 'Custo da mercadoria') and
               (qryLancamentosNaturezasdescricao.AsString <> 'Total da nota') 
{               (qryLancamentosNaturezasdescricao.AsString = 'Despesas de ICMS') or
               (qryLancamentosNaturezasdescricao.AsString = 'Despesas de IPI') or
               (qryLancamentosNaturezasdescricao.AsString = 'Despesas de ISS') or
               (qryLancamentosNaturezasdescricao.AsString = 'Frete') or
               (qryLancamentosNaturezasdescricao.AsString = 'ICMS a recolher') or
               (qryLancamentosNaturezasdescricao.AsString = 'ICMS substituição tributária') or
               (qryLancamentosNaturezasdescricao.AsString = 'IPI a recolher') or
               (qryLancamentosNaturezasdescricao.AsString = 'ISS a recolher') or
               (qryLancamentosNaturezasdescricao.AsString = 'Receita de produtos') or
               (qryLancamentosNaturezasdescricao.AsString = 'Receita de serviços') or
               (qryLancamentosNaturezasdescricao.AsString = 'Seguro')}) )  then

            qryLancamentosNaturezas.Delete
          else
            qryLancamentosNaturezas.Next;
        end;

        qryLancamentosNaturezas.First;
        while not qryLancamentosNaturezas.Eof do
        begin
          qryLancamentosNaturezas.Edit;
          qryLancamentosNaturezasnatureza.AsInteger := qryNaturezascodigo.AsInteger;
          qryLancamentosNaturezas.Post;
          qryLancamentosNaturezas.Next;
        end;
        qryLancamentosNaturezas.AfterPost := qryLancamentosNaturezasAfterPost;
      end;
      qryNaturezas.Post;
      Perpetrar([qryNaturezas,qryLancamentosNaturezas]);
      if ParSistema.GerarContabilidade then
        AtualizarListaLancamentosNaturezas;
      Result:= True;
    end;
  end;
end;

function TdtmCadastroTabelasCrediario.IncluirConceito: Boolean;
begin
  qryConceitos.Insert;
  qryConceitosrestricoes.AsBoolean:= False;
  Result:= True;
end;

function TdtmCadastroTabelasCrediario.IncluirCargo: Boolean;
begin
  qryCargos.Insert;
