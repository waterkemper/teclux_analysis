function TdtmCadastroTabelasCrediario.GravarProdutoCargo: Boolean;
var Pos: TBookmark;
begin
 // Pos:= qryProdutosporCargo.GetBookmark;
 // qryProdutosporCargo.DisableControls;
  if qryProdutosporCargo.CheckRequiredFields then begin
    qryProdutosporCargo.Post;
    try
