procedure TdtmCadastroTabelasCrediario.qryNaturezasBeforePost(
  DataSet: TDataSet);
begin
  inherited;
  if not ((qryNaturezasTipo.AsString = 'E')  and
          (ExisteCRTSimples or
           {para o regime normal libera-se somnete os cst´s que são tributados}
           (ExisteCRTNormal and
            ((qryNaturezasicmscst.asstring = ctTRIBUTADA               ) or    {00}
             (qryNaturezasICMSCST.asstring = ctREDUCAOBASE             ) or    {20}
             (qryNaturezasICMSCST.asstring = ctDIFERIMENTO             ) or    {51}
             (qryNaturezasICMSCST.asstring = ctCOBRADOSUSTITUICAO      ) or    {60}
             (qryNaturezasICMSCST.asstring = ctOUTROS                  ))      {90}
           ) )) then
    qryNaturezasnaogerarcreditoicms.AsBoolean := false;

  if not (qryNaturezasTipo.AsString = 'E') then
    qryNaturezasNaoGerarCreditoIPI.asboolean := false;


  if not ((qryNaturezasTipo.AsString = 'S')  and

                                      (ExisteCRTSimples or
                                       {para o regime normal libera-se somnete os cst´s que são tributados}
                                       (ExisteCRTNormal and
                                        ((qryNaturezasicmscst.asstring = ctTRIBUTADA               ) or    {00}
                                         (qryNaturezasICMSCST.asstring = ctREDUCAOBASE             ) or    {20}
                                         (qryNaturezasICMSCST.asstring = ctDIFERIMENTO             ) or    {51}
                                         (qryNaturezasICMSCST.asstring = ctCOBRADOSUSTITUICAO      ) or    {60}
                                         (qryNaturezasICMSCST.asstring = ctOUTROS                  ))      {90}
                                       ) )) then
    qryNaturezasNaoGerarDebitoICMS.asboolean := false;

  if not (qryNaturezasTipo.AsString = 'S') then
    qryNaturezasNaoGerarDebitoIPI.asboolean := false;

end;

procedure TdtmCadastroTabelasCrediario.qryNaturezasAfterScroll(
  DataSet: TDataSet);
begin
  inherited;
  qryNaturezas.ReadOnly := qryNaturezasinterno.AsBoolean and not UsuarioLogin.Administrador;
end;

procedure TdtmCadastroTabelasCrediario.qryQualidade_VendasAfterInsert(
  DataSet: TDataSet);
begin
  inherited;
  qryQualidade_Vendas_Proximo.close;
  qryQualidade_Vendas_Proximo.open;

  qryQualidade_Vendascodigo.asinteger := qryQualidade_Vendas_Proximocodigo.asinteger;
  qryQualidade_Vendassolicitar_senha_analista_credito.asboolean := false;
end;

function TdtmCadastroTabelasCrediario.IncluirQualidade_Venda: boolean;
begin
  qryQualidade_Vendas.Append;
  Result:= True;
end;

function TdtmCadastroTabelasCrediario.ExcluirQualidade_Venda: Boolean;
begin
  if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o registro QUALIDADE VENDA'])) = smbOk then
  begin
    if not qryQualidade_Vendas.IsEmpty then
      qryQualidade_Vendas.Delete
    else
      qryQualidade_Vendas.Cancel;
    Perpetrar([qryQualidade_Vendas]);
    Result:= True;
  end
  else
    Result:= False;
end;

function TdtmCadastroTabelasCrediario.GravarQualidade_Venda: Boolean;
begin
  if qryQualidade_Vendas.CheckRequiredFields then
  begin
    if (qryQualidade_Vendas.state in [dsedit, dsinsert]) then
      qryQualidade_Vendas.Post;

    Perpetrar([qryQualidade_Vendas]);
    Result:= True;
  end
  else
    Result:= False;
end;

function TdtmCadastroTabelasCrediario.GetTabelaQualidade_Vendas: TZDataSet;
begin
  Result := qryQualidade_Vendas;

end;

procedure TdtmCadastroTabelasCrediario.qryQualidade_VendasAfterPost(
  DataSet: TDataSet);
begin
  inherited;
  if not vPressionadoBotaoGravar then
    GravarQualidade_Venda;
end;

end.
