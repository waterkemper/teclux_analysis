procedure TdtmCadastroTabelasCrediario.dsrNaturezasDataChange(Sender: TObject; Field: TField);
var Tipo: String[1];
begin
  inherited;
  if Field = qryNaturezasTipo then begin
     Tipo:= qryNaturezasTipo.AsString;
     Case Tipo[1] of
        'E': begin {--------------------------------------------- NF de entrada}
                if (qryNaturezasCodigoFiscal.AsInteger < 1000) or
                   (qryNaturezasCodigoFiscal.AsInteger > 3999) then begin
                   qryNaturezas.Edit;
                   qryNaturezasCodigoFiscal.Clear;
                end;
                qryConsultaCodigosFiscais.MacroByName('TipodeNotaFiscal').AsString := ' and Codigo > 1000 AND Codigo < 4000 ';
                qryProcuraCodigosFiscais.MacroByName('TipodeNotaFiscal').AsString := ' and Codigo > 1000 AND Codigo < 4000 ';
                qryNaturezaslanctoscustomedio.AsBoolean := false;
             end;

        'S': begin {----------------------------------------------- NF de saída}
                if (qryNaturezasCodigoFiscal.AsInteger < 5000) or
                   (qryNaturezasCodigoFiscal.AsInteger > 7999) then begin
                   qryNaturezas.Edit;
                   qryNaturezasCodigoFiscal.Clear;
                end;
                qryConsultaCodigosFiscais.MacroByName('TipodeNotaFiscal').AsString := ' and Codigo > 5000 AND Codigo < 8000 ';
                qryProcuraCodigosFiscais.MacroByName('TipodeNotaFiscal').AsString := ' and Codigo > 5000 AND Codigo < 8000 ';
             end;
        'R': begin {--------------------------------------------- NF de serviço}
                if qryNaturezasCodigoFiscal.AsInteger < 8000 then begin
                   qryNaturezas.Edit;
                   qryNaturezasCodigoFiscal.Clear;
                end;
                qryConsultaCodigosFiscais.MacroByName('TipodeNotaFiscal').AsString := ' and Codigo >= 8000 ';
                qryProcuraCodigosFiscais.MacroByName('TipodeNotaFiscal').AsString := ' and Codigo >= 8000 ';
                qryNaturezaslanctoscustomedio.AsBoolean := false;
             end;
     end;
  end
  else
  if field = qryNaturezasCodigoFiscal then
  begin
     if not qryNaturezasCodigoFiscal.IsNull then begin
        qryNaturezasdebitar.   AsVariant := qryProcuraCodigosFiscaisdebitoconta. AsVariant;
        qryNaturezascreditar.  AsVariant := qryProcuraCodigosFiscaiscreditoconta.AsVariant;
        qryNaturezashistorico. AsVariant := qryProcuraCodigosFiscaishistorico.   AsVariant;
       qryNaturezasdestacaripi.AsBoolean := qryProcuraCodigosFiscaisdestacaripi. AsBoolean;
     end;
  end
  else if Field = qryNaturezasdebitar then
    qryProcuraCreditar.Params[1].AsInteger := qryNaturezasdebitar.AsInteger
  else if field = qryNaturezascreditar then
    qryProcuraDebitar.Params[1].AsInteger := qryNaturezascreditar.AsInteger
  else if field = qryNaturezasicmscst then
  begin
   if (qryNaturezasicmscst.asstring = '51') and qrynaturezaspDiferimento.isnull then
     qrynaturezaspDiferimento.asCurrency := 100;

  end;

end;

function TdtmCadastroTabelasCrediario.ExcluirAgenteTipoCarta: Boolean;
begin
  if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o AGENTE'])) = smbOk then
  begin
    if not qryAgentesTiposCartas.IsEmpty then
      qryAgentesTiposCartas.Delete
    else
      qryAgentesTiposCartas.Cancel;
    qryProcuraAgentesTiposCartas.Sql[4]  := 'AND'   + MontaFiltroAgentes(False);
    qryConsultaAgentesTiposCartas.Sql[3] := 'WHERE' + MontaFiltroAgentes(False);
    qryTiposCartas.Edit;
    Result:= True;
  end
  else
    Result:= False;
end;

function TdtmCadastroTabelasCrediario.ExcluirConceitoTipoCarta: Boolean;
begin
  if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o CONCEITO'])) = smbOk then
  begin
    if not qryConceitosTiposCartas.IsEmpty then
      qryConceitosTiposCartas.Delete
    else
      qryConceitosTiposCartas.Cancel;
    qryProcuraConceitosTiposCartas.Sql[4]  := 'AND' + MontaFiltroConceitos(False);
    qryConsultaConceitosTiposCartas.Sql[3] := 'WHERE' + MontaFiltroConceitos(False);
    qryTiposCartas.Edit;
    Result:= True;
  end
  else
    Result:= False;
end;

function TdtmCadastroTabelasCrediario.MontaFiltroAgentes(
  Editando: Boolean): String;
var
  Campos: String;
  Pos   : TBookmark;
  CodAnterior: Integer;
begin
  if Editando then
    CodAnterior:= qryAgentesTiposCartasagente.AsInteger
  else
    CodAnterior:= 0;
  Result := ' codigo NOT IN (%s)';
  Campos := '';
  Pos := qryAgentesTiposCartas.GetBookmark;
  qryAgentesTiposCartas.DisableControls;
  qryAgentesTiposCartas.First;
  if qryAgentesTiposCartas.IsEmpty then
    Campos := '0'
  else
  begin
    while not qryAgentesTiposCartas.Eof do
    begin
      if qryAgentesTiposCartasagente.AsInteger <> CodAnterior then
        Campos := Campos + '''' + qryAgentesTiposCartasagente.AsString + ''','
      else
        Campos := '0,';
      qryAgentesTiposCartas.Next;
    end;
    Campos := Copy(Campos, 0, Length(Campos) - 1);
  end;
  Result := Format(Result, [Campos]);
  qryAgentesTiposCartas.GotoBookmark(Pos);
  qryAgentesTiposCartas.FreeBookmark(Pos);
  qryAgentesTiposCartas.EnableControls;
end;

function TdtmCadastroTabelasCrediario.MontaFiltroConceitos(
  Editando: Boolean): String;
var
  Campos: String;
  Pos   : TBookmark;
  CodAnterior: Integer;
begin
  if Editando then
    CodAnterior:= qryConceitosTiposCartasConceito.AsInteger
  else
    CodAnterior:= 0;
  Result := ' codigo NOT IN (%s)';
  Campos := '';
  Pos := qryConceitosTiposCartas.GetBookmark;
  qryConceitosTiposCartas.DisableControls;
  qryConceitosTiposCartas.First;
  if qryConceitosTiposCartas.IsEmpty then
    Campos := '0'
  else
  begin
    while not qryConceitosTiposCartas.Eof do
    begin
      if qryConceitosTiposCartasConceito.AsInteger <> CodAnterior then
        Campos := Campos + '''' +  qryConceitosTiposCartasconceito.AsString + ''','
      else
        Campos := '0,';
      qryConceitosTiposCartas.Next;
    end;
    Campos := Copy(Campos, 0, Length(Campos) - 1);
  end;
  Result := Format(Result,[Campos]);
  qryConceitosTiposCartas.GotoBookmark(Pos);
  qryConceitosTiposCartas.FreeBookmark(Pos);
  qryConceitosTiposCartas.EnableControls;
end;

