begin
  if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o CARGO'])) = smbOk then begin
    if not qryCargos.IsEmpty then
       qryCargos.Delete
    else qryCargos.Cancel;
    Perpetrar([qryCargos]);
    Result:= True;
  end
  else
    Result:= False;
end;

