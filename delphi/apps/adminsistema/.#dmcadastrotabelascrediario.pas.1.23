procedure TdtmCadastroTabelasCrediario.qryNaturezasAfterOpen(
  DataSet: TDataSet);
begin
  inherited;
  if ParSistema.GerarContabilidade then
  begin
    ReFazConsulta(qryLancamentosNaturezas,[0],[qryNaturezascodigo.AsVariant]);
    if qryNaturezas.RecordCount<>0 then
      AtualizarListaLancamentosNaturezas;
  end;
end;

procedure TdtmCadastroTabelasCrediario.AtualizarListaLancamentosNaturezas;
var
  vLancamentosNaturezas: TtecLancamentosNaturezas;
begin
  qryLancamentosNaturezas.AfterPost := nil;
  qryLancamentosNaturezas.AfterInsert := nil;
  for vLancamentosNaturezas := lnAcrescimoFinanceiro to lnTotaldaNota do
   if not qryLancamentosNaturezas.Locate('Descricao', vstrLancamentosNaturezas[vLancamentosNaturezas],[]) then
   begin
     qryLancamentosNaturezas.First;
     while not qryLancamentosNaturezas.Eof do
     begin
       if qryLancamentosNaturezasdescricao.AsString > vstrLancamentosNaturezas[vLancamentosNaturezas] then
       begin
         qryLancamentosNaturezas.insert;
         break;
       end
       else
         qryLancamentosNaturezas.Next;
     end;

     if qryLancamentosNaturezas.State <> dsinsert then
       qryLancamentosNaturezas.Append;
     qryLancamentosNaturezasdescricao.AsString := vstrLancamentosNaturezas[vLancamentosNaturezas];
     qryLancamentosNaturezasoperacao.AsString := 'N';
     qryLancamentosNaturezas.Post;
   end;
  qryLancamentosNaturezas.AfterInsert := qryLancamentosNaturezasAfterInsert;
  qryLancamentosNaturezas.AfterPost := qryLancamentosNaturezasAfterPost;

end;

procedure TdtmCadastroTabelasCrediario.dsrLancamentosNaturezasDataChange(
  Sender: TObject; Field: TField);
begin
  inherited;
  if field = qryLancamentosNaturezascontacontabil then
  begin
    if field.asstring<>'' then
    begin
      dsrLancamentosNaturezas.OnDataChange := nil;
      ReFazConsulta(qryProcuraContaContabil,[0],
              [qryLancamentosNaturezasContaContabil.AsVariant]);
      if qryProcuraContaContabil.IsEmpty then
      begin
        if field.AsInteger<>0 then
          MensagemAviso(format(ctCODIGOINEXISTENTE,[qryLancamentosNaturezasContaContabil.AsString]));
        qryLancamentosNaturezascontacontabil.FocusControl;
        qryLancamentosNaturezascontacontabil.Clear;
        qryLancamentosNaturezasclassificacao.clear;
      end
      else
      begin
        qryLancamentosNaturezasclassificacao.AsString := qryProcuraContaContabilclassificacao.AsString;
        qryLancamentosNaturezascontacontabil.FocusControl;
      end;
      dsrLancamentosNaturezas.OnDataChange := dsrLancamentosNaturezasDataChange;
    end;
  end
  else
  if field = qryLancamentosNaturezashistorico then
  begin
    if field.asstring<>'' then
    begin
      dsrLancamentosNaturezas.OnDataChange := nil;
      ReFazConsulta(qryProcuraHistorico,[0],
              [qryLancamentosNaturezashistorico.AsVariant]);
      if qryProcuraHistorico.IsEmpty then
      begin
        if field.AsInteger<>0 then
          MensagemAviso(format(ctCODIGOINEXISTENTE,[qryLancamentosNaturezashistorico.AsString]));
        field.FocusControl;
        field.Clear;
      end
      else
        field.FocusControl;
        
      dsrLancamentosNaturezas.OnDataChange := dsrLancamentosNaturezasDataChange;
    end;
  end;
end;

