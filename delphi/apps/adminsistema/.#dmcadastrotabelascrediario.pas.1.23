procedure TdtmCadastroTabelasCrediario.SelecionarMultiplas(Tabela: TtecTabelasCrediario);
begin
  case Tabela of
    tbcAGENTE   : ReFazConsulta(qryAgentes,    [0],[qryConsultaAgentescodigo.asInteger]);
    tbcAGENTETIPOCARTA :
    begin
     qryAgentesTiposCartas.Edit;
     qryAgentesTiposCartasagente.AsInteger  := qryConsultaAgentesTiposCartascodigo.AsInteger;
     qryAgentesTiposCartasdescricao.AsString:= qryConsultaAgentesTiposCartasdescricao.AsString;
    end;
    tbcCARGO    :
      ReFazConsulta(qryCargos,[0],[qryConsultaCargoscodigo.asInteger]);
    tbcPRODUTOSCARGOS : ReFazConsulta(qryProdutosporCargo,[0],[qryCargoscodigo.AsVariant]);
    tbcCONCEITO : ReFazConsulta(qryConceitos,  [0],[qryConsultaConceitoscodigo.asInteger]);
    tbcCONCEITOTIPOCARTA :
    begin
     qryConceitosTiposCartas.Edit;
     qryConceitosTiposCartasconceito.AsInteger:= qryConsultaConceitosTiposCartascodigo.AsInteger;
     qryConceitosTiposCartasdescricao.AsString:= qryConsultaConceitosTiposCartasdescricao.AsString;
    end;
    tbcTIPOPLANO: ReFazConsulta(qryTiposPlanos,[0],[qryConsultaTiposPlanoscodigo.AsInteger]);
    tbcMOTIVO   : ReFazConsulta(qryMotivos,    [0],[qryConsultaMotivoscodigo.AsInteger]);
    tbcTIPOCARTA: ReFazConsulta(qryTiposCartas,[0],[qryConsultaTiposCartascodigo.AsInteger]);
    tbcTIPOATENDIMENTO:
    begin
      qryTiposCartas.edit;
      qryTiposCartastipoatendimento.AsInteger := qryConsultaTiposAtendimentoscodigo.AsInteger;
    end;
    tbcAGENTETIPORECEBIMENTO:
    begin
       qryTiposRecebimentos.Edit;
       qryTiposRecebimentosagente.AsInteger := qryConsultaAgentescodigo.AsInteger;
    end;


    tbcTIPOCARTAPRECEDENTE: begin
                             qryTiposCartas.Edit;
                             qryTiposCartasprecedente.AsInteger := qryConsultaTiposCartasPrecedentecodigo.AsInteger;
                            end;
    tbcNATUREZA : ReFazConsulta(qryNaturezas,  [0],[qryConsultaNaturezascodigo.AsInteger]);
    tbcCFOP     : begin
                    qryNaturezas.Edit;
                    qryNaturezascodigofiscal.AsInteger:= qryConsultaCodigosFiscaiscodigo.AsInteger;
                  end;
    tbcTIPOMOVTO: begin
                    qryNaturezas.Edit;
                    qryNaturezasTipomovimento.AsString:= qryConsultaTiposMovimentoscodigo.AsString;
                  end;
    tbcCONTADEBITO : begin
                        if qryConsultaContaContabiltipo.AsString<>'S' then
                        begin
                          if not (qryNaturezas.state in [dsinsert, dsedit]) then
                            qryNaturezas.Edit;
                          qryNaturezasdebitar.AsInteger := qryConsultaContaContabilcodigo.AsInteger
                        end
                        else
                        begin
                          if not qryNaturezasdebitar.IsNull then
                          begin
                            if not (qryNaturezas.state in [dsinsert, dsedit]) then
                              qryNaturezas.Edit;
                            qryNaturezasdebitar.Clear;
                          end;
                        end
                      end;
    tbcCONTACREDITO : begin
                        if qryConsultaContaContabiltipo.AsString<>'S' then
                        begin
                          if not (qryNaturezas.state in [dsinsert, dsedit]) then
                            qryNaturezas.Edit;
                          qryNaturezascreditar.AsInteger := qryConsultaContaContabilcodigo.AsInteger
                        end
                        else
                        begin
                          if not qryNaturezascreditar.IsNull then
                          begin
                            if not (qryNaturezas.state in [dsinsert, dsedit]) then
                              qryNaturezas.Edit;
                            qryNaturezascreditar.Clear;
                          end;
                        end
                      end;
    tbcCONTACONTABIL : begin
                        if qryConsultaContaContabiltipo.AsString<>'S' then
                        begin
                          if not (qryLancamentosNaturezas.state in [dsedit]) then
                            qryLancamentosNaturezas.Edit;
                          qryLancamentosNaturezascontacontabil.AsInteger := qryConsultaContaContabilcodigo.AsInteger;
                          qryLancamentosNaturezasclassificacao.AsString := qryConsultaContaContabilclassificacao.AsString;
                        end
                        else
                        begin
                          if not (qryLancamentosNaturezas.state in [dsedit]) then
                            qryLancamentosNaturezas.Edit;
                          qryLancamentosNaturezascontacontabil.Clear;
                        end
                       end;

    tbcHISTORICO   : begin
{
                       if not (qryNaturezas.state in [dsinsert, dsedit]) then
                          qryNaturezas.Edit;
                       qryNaturezashistorico.AsInteger := qryConsultaHistoricocodigo.AsInteger
}
                       if not (qryLancamentosNaturezas.state in [dsedit]) then
                          qryLancamentosNaturezas.Edit;
                       qryLancamentosNaturezashistorico.AsInteger := qryConsultaHistoricocodigo.AsInteger
                      end;

    tbcTIPORECEBIMENTO : ReFazConsulta(qryTiposRecebimentos,[0],[qryConsultaTiposRecebimentoscodigo.AsInteger]);
    tbcCONTAS : ReFazConsulta(qryProcuraContas,[0],[qryConsultaContasConta.AsInteger]);
  end;
end;

