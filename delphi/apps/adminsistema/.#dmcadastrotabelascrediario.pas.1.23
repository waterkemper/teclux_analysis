procedure TdtmCadastroTabelasCrediario.setTiposCartasexportar(
  const Value: String);
var
 i: integer;
 arquivo: String;
begin
  arquivo:='';
  for i:=1 to Length(trim(Value)) do
  begin
   if copy(value,i,1)='\' then
     arquivo:=arquivo+copy(value,i,1)+'\'
   else
     arquivo:=arquivo+copy(value,i,1);
  end;
  if not (qryTiposCartas.State in [dsedit, dsinsert]) then
   qrytiposCartas.Edit;
  qryTiposCartasexportar.AsString := arquivo;
end;

