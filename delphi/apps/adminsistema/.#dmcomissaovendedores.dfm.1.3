    Sql.Strings = (
      '('
      'select vendedor,'
      '       nome,'
      '       contrato,'
      
        '       case when :AgruparFilial then filialvenda else cast(null ' +
        'as integer) end as filialvenda,'
      
        '       case when :AgruparFilial then nomefilialvenda else cast(n' +
        'ull as varchar) end as nomefilialvenda,'
      
        '       case when :AgruparGrupoFilial then grupofilialvenda else ' +
        'cast(null as integer) end as grupofilialvenda,'
      
        '       case when :AgruparGrupoFilial then nomegrupofilialvenda e' +
        'lse cast(null as varchar) end as nomegrupofilialvenda,'
      '       faturamento,'
      '       evento,'
      ''
      '       case when produtomonstruario then'
      
        '       sum(valor) * cast(Parametros_Valor('#39'Percentual da comiss'#227 +
        'o para produtos do monstru'#225'rio'#39',Filialvenda) as numeric) / 100'
      '       else sum(Valor) end as valor,'
      ''
      '       case when produtomonstruario then'
      
        '       sum(base) * cast(Parametros_Valor('#39'Percentual da comiss'#227'o' +
        ' para produtos do monstru'#225'rio'#39',Filialvenda) as numeric) / 100'
      '       else sum(base) end as base,'
      ''
      '       tipobase,'
      '       tipocomissao,'
      '       nivelcomissao,'
      ''
      '       case when produtomonstruario then'
      
        '       percentual_ou_valor * cast(Parametros_Valor('#39'Percentual d' +
        'a comiss'#227'o para produtos do monstru'#225'rio'#39',Filialvenda) as numeric' +
        ') / 100'
      '       else percentual_ou_valor end as percentual_ou_valor,'
      ''
      '       case when produtomonstruario then'
      
        '       sum(valorcomissao) * cast(Parametros_Valor('#39'Percentual da' +
        ' comiss'#227'o para produtos do monstru'#225'rio'#39',Filialvenda) as numeric)' +
        ' / 100'
      '       else sum(valorcomissao) end as valorcomissao,'
      ''
      '       produtomonstruario'
      'from'
      '('
      '  SELECT comissoes.vendedor,'
      '         usuarios.nome,'
      #9' contrato,'
      #9' produto,'
      #9' filialvenda,'
      #9' f.nome as nomefilialvenda,'
      #9' fgf.grupo as grupofilialvenda,'
      #9' gf.descricao as nomegrupofilialvenda,'
      #9' faturamento,'
      #9' evento,'
      #9' valor,'
      #9' base,'
      #9' tipobase,'
      #9' comissoes.tipocomissao,'
      #9' nivelcomissao,'
      #9' percentual_ou_valor,'
      
        #9' calculacomissao(evento,base,comissoes.tipocomissao,percentual_' +
        'ou_valor,quantidade) as valorcomissao,'
      '    produtomonstruario'
      'FROM'
      '('
      '%INICIO_NIVEL_DE_COMISSAO_DA_TABELA_COMISSOESUSUARIOS'
      '('
      'select vendas_e_estornos.*,'
      '       percentual.nivelcomissao,'
      '       case'
      '          when vendas_e_estornos.evento = '#39'VENDA A VISTA'#39' or'
      '               vendas_e_estornos.evento = '#39'ESTORNO A VISTA'#39' or'
      
        '               vendas_e_estornos.evento = '#39'ABATIMENTO CREDITO TR' +
        'OCA - VENDA A VISTA'#39' then coalesce(comissoesusuarios.percvista,0' +
        ')'
      '          when vendas_e_estornos.evento = '#39'VENDA A PRAZO'#39' or'
      '               vendas_e_estornos.evento = '#39'ESTORNO A PRAZO'#39' or'
      
        '       '#9'       vendas_e_estornos.evento = '#39'ABATIMENTO CREDITO TR' +
        'OCA - VENDA A PRAZO'#39' then coalesce(comissoesusuarios.percprazo,0' +
        ')'
      '          when vendas_e_estornos.evento = '#39'VENDA ENTRADA'#39' or'
      '               vendas_e_estornos.evento = '#39'ESTORNO ENTRADA'#39' or'
      
        '               vendas_e_estornos.evento = '#39'ABATIMENTO CREDITO TR' +
        'OCA - VENDA ENTRADA'#39' then coalesce(comissoesusuarios.percentrada' +
        ',0)'
      '        end as percentual_ou_valor,'
      
        #9'cast(null as integer) as quantidade, false as produtomonstruari' +
        'o, '#39'%'#39' as tipocomissao'
      'from comissoesusuarios,'
      '('
      'select vendedor,'
      '       faixa_comissao(vendedor, sum(base)) as nivelcomissao'
      'from'
      '  ('
      '  %INICIO_VENDAS_CALCULO_NIVEL_DA_TABELA'
      '    ('
      '    select vendedor,'
      '    '#9'case'
      
        '            when evento = '#39'VENDA A VISTA'#39' then valorprazo - (val' +
        'orprazo - valor)'
      '            when evento = '#39'VENDA A PRAZO'#39' then'
      '              case'
      
        '                when tipobase = '#39'P'#39' then valorprazo - (valorpraz' +
        'o - valor)'
      
        '                WHEN tipobase = '#39'V'#39' then valorvista - (valorpraz' +
        'o - valor)'
      '              end'
      '            when evento = '#39'VENDA ENTRADA'#39' then valor'
      '        end as base'
      '    from'
      '      ('
      '        ('
      '        SELECT vendedor,'
      
        '               (select tipocomissao from usuarios where codigo =' +
        ' vendedor) as tipobase,'
      '               contrato,'
      '               faturamento,'
      '               valorvista,'
      '               valorprazo,'
      '               CASE WHEN avista = '#39't'#39' THEN '#39'VENDA A VISTA'#39
      
        '                    WHEN ( avista = '#39'f'#39' AND datavencto>(faturame' +
        'nto+coalesce(toleranciaentrada,0)) ) THEN '#39'VENDA A PRAZO'#39
      '               ELSE '#39'VENDA ENTRADA'#39' END AS evento,'
      '               SUM(valorvencto) AS valor'
      '        FROM'
      '          ('
      '          SELECT vendas.vendedor,'
      '                 vendas.contrato,'
      '                 vendas.faturamento,'
      
        '                 round(((vendas.valorvista * vendas.percvendedor' +
        ')/100),2) as valorvista,'
      
        '                 round(((vendas.valorprazo * vendas.percvendedor' +
        ')/100),2) as valorprazo,'
      
        '                 round(((parcelas.valorvencto * vendas.percvende' +
        'dor)/100),2) as valorvencto,'
      '                 parcelas.datavencto,'
      '                 contratos_avista(vendas.contrato) AS avista,'
      
        '                 (select toleranciaentrada from planos where pla' +
        'nos.codigo = vendas.plano) as toleranciaentrada'
      '          FROM parcelas, ('
      
        '                          SELECT coalesce(pc.vendedor, faturados' +
        '.vendedor) as vendedor,'
      
        '                                 ((sum(pc.quantidade * precovend' +
        'a)*100)/(faturados.valorvista+coalesce(faturados.desconto,0))) a' +
        's percvendedor,'
      '                                  faturados.contrato,'
      '          '#9#9#9'  faturados.faturamento,'
      '          '#9#9#9'  faturados.valorvista,'
      '          '#9#9#9'  faturados.desconto,'
      '          '#9#9#9'  faturados.valorprazo,'
      '          '#9#9#9'  faturados.plano'
      '                          FROM produtoscontratos pc, ('
      
        '              '#9#9'                            SELECT ct.numero as ' +
        'contrato,'
      '          '#9#9#9'                           ct.faturamento,'
      '          '#9#9#9'                           ct.valorvista,'
      '          '#9#9#9#9#9#9'   ct.desconto,'
      '          '#9#9#9'                           ct.valorprazo,'
      '          '#9#9#9#9#9#9'   ct.plano,'
      
        '                                                           ct.ve' +
        'ndedor'
      '          '#9#9'                            FROM contratos ct'
      
        '          '#9#9'                            WHERE (ct.faturamento BE' +
        'TWEEN :datainicial AND :datafinal) AND'
      
        '          '#9#9#9'                          (ct.origem IS NULL) AND (' +
        'ct.valorvista+coalesce(ct.desconto,0))<>0'
      ''
      '          '#9#9#9#9#9#9'  %FiltroContratos'
      ''
      '          '#9#9#9#9#9'    ORDER BY ct.numero'
      '          '#9#9#9'                   ) AS faturados'
      
        '                          WHERE pc.contrato = faturados.contrato' +
        ' and not pc.brinde'
      ''
      
        '          '#9#9'                                  %FiltroProdutosCon' +
        'tratos'
      ''
      
        '                          GROUP BY pc.vendedor, faturados.vended' +
        'or, faturados.contrato, faturamento, valorvista, faturados.desco' +
        'nto, valorprazo, plano'
      '          '#9#9'ORDER BY faturados.contrato'
      '          '#9'       ) as vendas'
      '          WHERE parcelas.contrato = vendas.contrato AND'
      
        '               (parcelas.tipopagto is null or parcelas.tipopagto' +
        ' not in ('#39'P'#39','#39'X'#39'))'
      '          ORDER BY contrato, parcelas.datavencto'
      '          ) AS base'
      
        '        GROUP BY vendedor, contrato, faturamento, evento, valorv' +
        'ista, toleranciaentrada, valorprazo, avista, tipobase'
      '        )'
      ''
      #9'union all'
      ''
      '        ('
      '        SELECT vendedor,'
      
        '               (select tipocomissao from usuarios where codigo =' +
        ' vendedor) as tipobase,'
      '               cast(dadofiscal as varchar(20)) as contrato,'
      '               data as faturamento,'
      '               valorvista,'
      '               valorprazo,'
      '               CASE WHEN avista = '#39't'#39' THEN '#39'VENDA A VISTA'#39
      
        '                    WHEN ( avista = '#39'f'#39' AND datavencto>(data+coa' +
        'lesce(toleranciaentrada,0)) ) THEN '#39'VENDA A PRAZO'#39
      '               ELSE '#39'VENDA ENTRADA'#39' END AS evento,'
