      '        '#9#9#9#9#9#9#9#9'                   from parcelas p2'
      '        '#9#9#9#9#9#9#9#9#9#9'   where p2.contrato = ct.numero and'
      '        '#9#9#9#9#9#9#9#9#9#9'         p2.tipopagto<>'#39'E'#39') and'
      
        '         '#9#9#9#9#9#9#9#9'       p.datapagto between :datainicial and :da' +
        'tafinal and'
      '        '#9#9#9#9#9#9#9#9'       not exists (select cd.contrato'
      '        '#9#9#9#9#9#9#9#9'                   from contratosdevolvidos cd'
      '        '#9#9#9#9#9#9#9#9#9#9'   where cd.contrato = ct.numero and'
      '        '#9#9#9#9#9#9#9#9#9#9'         cd.tipo = '#39'D'#39')'
      '        '#9#9#9#9#9#9#9#9' )'
      '        '#9#9#9#9#9#9#9#9' ORDER BY contrato'
      '        '#9#9#9#9#9#9#9#9' )'
      '        '#9#9#9#9#9#9#9#9') and (ct.valorvista+coalesce(ct.desconto,0))<>0'
      ''
      ''
      '        '#9#9'                                  %FiltroContratos'
      ''
      '        '#9#9#9#9#9'    ORDER BY ct.numero'
      '        '#9#9#9'                   ) AS faturados'
      
        '                        WHERE pc.contrato = faturados.contrato a' +
        'nd not pc.brinde'
      ''
      '                        '#9#9#9#9'%FiltroProdutosContratos'
      ''
      
        '                        GROUP BY pc.vendedor, faturados.vendedor' +
        ', faturados.contrato, faturamento, valorvista, faturados.descont' +
        'o, valorprazo, plano'
      '        '#9#9'ORDER BY faturados.contrato'
      '        '#9'       ) as vendas'
      
        '        WHERE parcelas.contrato = vendas.contrato AND (tipopagto' +
        ' IN ('#39'E'#39','#39'J'#39','#39'D'#39','#39'C'#39')) AND'
      
        '           ((parcelas.tipopagto in ('#39'E'#39','#39'J'#39') and parcelas.datapa' +
        'gto between :datainicial AND :datafinal) or'
      
        '            (parcelas.tipopagto in ('#39'D'#39','#39'C'#39') and parcelas.devent' +
        'rada between :datainicial AND :datafinal))'
      '        ORDER BY contrato, parcelas.datavencto'
      '        ) AS base'
      
        '        GROUP BY vendedor, contrato, dataestorno, faturamento, e' +
        'vento, valorvista, toleranciaentrada, valorprazo, avista, tipoba' +
        'se'
      '        )'
      ''
      '        union all'
      ''
      '        ('
      '        SELECT vendedor,'
      
        '               (select tipocomissao from usuarios where codigo =' +
        ' vendedor) as tipobase,'
      '               cast(dadofiscal as varchar(20)) as contrato,'
      '               datacancelamento as dataestorno,'
      '               valorvista,'
      '               valorprazo,'
      '               CASE WHEN avista = '#39't'#39' THEN '#39'ESTORNO A VISTA'#39
      
        '                    WHEN ( avista = '#39'f'#39' AND datavencto>(data+coa' +
        'lesce(toleranciaentrada,0)) ) THEN '#39'ESTORNO A PRAZO'#39
      '               ELSE '#39'ESTORNO ENTRADA'#39' END AS evento,'
      '               SUM(valorvencto) AS valor'
      '        FROM'
      '          ('
      '          SELECT vendas.vendedor,'
      '                 vendas.dadofiscal,'
      '                 vendas.datacancelamento,'
      '                 vendas.data,'
      
        '                 round(((vendas.valorvista * vendas.percvendedor' +
        ')/100),2) as valorvista,'
      
        '                 round(((vendas.valortotal * vendas.percvendedor' +
        ')/100),2) as valorprazo,'
      
        '                 round(((vdf.valorvencto * vendas.percvendedor)/' +
        '100),2) as valorvencto,'
      '                 vdf.datavencto,'
      '                 true AS avista,'
      
        '                 (select toleranciaentrada from planos where pla' +
        'nos.codigo = vendas.plano) as toleranciaentrada'
      '          FROM venctosdadosfiscais vdf ,'
      
        '                         (SELECT coalesce(pdf.vendedor, faturado' +
        's.vendedor) as vendedor,'
      
        '                                 ((sum(pdf.quantidade * pdf.prec' +
        'ovenda)*100)/(faturados.valorvista+coalesce(faturados.desconto,0' +
        '))) as percvendedor,'
      '                                 faturados.dadofiscal,'
      '                                 faturados.data,'
      '                                 faturados.datacancelamento,'
      '                                 faturados.valorvista,'
      '                                 faturados.desconto,'
      '                                 faturados.valortotal,'
      '                                 faturados.plano'
      ''
      
        '                          FROM produtosdadosfiscais pdf, ( SELEC' +
        'T df.numero as dadofiscal,'
      
        '                                                                ' +
        '        df.data,'
      
        '                '#9#9#9'                                df.datacancel' +
        'amento,'
      
        '                '#9#9#9'                                df.valorvista' +
        ','
      '                '#9#9#9#9#9#9'        df.desconto,'
      
        '                '#9#9#9'                                df.valortotal' +
        ','
      '                '#9#9#9#9#9#9'        df.plano,'
      
        '                                                                ' +
        '        df.vendedor'
      
        '                  '#9#9'                         FROM dadosfiscais d' +
        'f'
      
        '                '#9#9'                                 WHERE (df.dat' +
        'acancelamento BETWEEN :datainicial AND :datafinal)'
      
        '                                                             AND' +
        ' df.contrato is null'
      
        '                                                             and' +
        ' not coalesce(df.notavinculada,false)'
      '       '#9#9#9#9#9#9'           and ((mod(df.codigofiscal,1000) in ('
      '       '#9#9#9#9#9#9#9#9'%ListaCodigosFiscaisVenda'
      '       '#9#9#9#9#9#9#9#9')) or mod(df.codigofiscal,1000) in (929))'
      '                 '#9#9#9#9#9'         %FiltroContratos'
      '                 '#9#9#9#9#9'         ORDER BY df.numero'
      '                '#9#9#9'                       ) AS faturados'
      
        '                          WHERE pdf.dadofiscal = faturados.dadof' +
        'iscal'
      '                            and not coalesce(pdf.brinde,false)'
      ''
      '                            %FiltroProdutosDadosFiscais'
      ''
      
        '                          GROUP BY pdf.vendedor, faturados.vende' +
        'dor, faturados.dadofiscal, faturados.datacancelamento, faturados' +
        '.data,'
      
        '                                   faturados.valorvista, faturad' +
        'os.desconto, faturados.valortotal, faturados.plano'
      '          '#9#9'ORDER BY faturados.dadofiscal'
      '          '#9'       ) as vendas'
      '          WHERE vdf.dadofiscal = vendas.dadofiscal'
      '          ORDER BY vendas.dadofiscal, vdf.datavencto'
      '          ) AS base'
      
        '        GROUP BY vendedor, dadofiscal, datacancelamento, data, e' +
        'vento, valorvista, toleranciaentrada, valorprazo, avista, tipoba' +
        'se'
      '        )'
      '      ) as base'
      '    )'
      '    %FINAL_DEVOLUCOES_DO_MES_CALCULO_NIVEL_DA_TABELA'
      '  order by vendedor'
      '  ) as vendas'
      'group by vendedor'
      ') as percentual,'
      '('
      '%INICIO_VENDAS_A_SER_APLICADO_O_PERCENTUAL'
      '   ('
      '    select vendedor,'
      '           contrato,'
      '           cast(null as integer) as produto,'
      '           cast(null as varchar(50)) as nomeproduto,'
      '           filialvenda,'
      '           faturamento,'
      '           evento,'
      '           case when evento = '#39'VENDA ENTRADA'#39' then valor'
      '                                              else valorprazo'
      '           end as valor,'
      ''
      
        '           case when evento = '#39'VENDA A VISTA'#39' then valorprazo - ' +
        '(valorprazo - valor)'
      '                when evento = '#39'VENDA A PRAZO'#39' then'
      
        '                case when tipobase = '#39'P'#39' then valorprazo - (valo' +
        'rprazo - valor)'
      
        '                     when tipobase = '#39'V'#39' then valorvista - (valo' +
        'rprazo - valor)'
      '                end'
      '                when evento = '#39'VENDA ENTRADA'#39' then valor'
      '           end as base,'
      ''
      '           tipobase'
      '    from'
      '      ('
      '        ('
      '        SELECT vendedor,'
      
        '               (select tipocomissao from usuarios where codigo =' +
        ' vendedor) as tipobase,'
      '               cast('#39'CT '#39'||contrato as varchar(25)) as contrato,'
      '               filialvenda,'
      '               faturamento,'
      '               valorvista,'
      '               valorprazo,'
      '               CASE WHEN avista = '#39't'#39' THEN '#39'VENDA A VISTA'#39
      
        '                    WHEN ( avista = '#39'f'#39' AND datavencto>(faturame' +
        'nto+coalesce(toleranciaentrada,0)) ) THEN '#39'VENDA A PRAZO'#39
      '               ELSE '#39'VENDA ENTRADA'#39' END AS evento,'
      '               SUM(valorvencto) AS valor'
      '        FROM'
      '        ('
      '        SELECT vendas.vendedor,'
      '               vendas.contrato,'
      '               vendas.filialvenda,'
      '               vendas.faturamento,'
      
        '               round(((vendas.valorvista * vendas.percvendedor)/' +
        '100),2) as valorvista,'
      
        '               round(((vendas.valorprazo * vendas.percvendedor)/' +
        '100),2) as valorprazo,'
      
        '               round(((parcelas.valorvencto * vendas.percvendedo' +
        'r)/100),2) as valorvencto,'
      '               parcelas.datavencto,'
      '               contratos_avista(vendas.contrato) AS avista,'
      
        '               (select toleranciaentrada from planos where plano' +
        's.codigo = vendas.plano) as toleranciaentrada'
      '        FROM parcelas, ('
      
        '                        SELECT coalesce(pc.vendedor, faturados.v' +
        'endedor) as vendedor,'
      
        '                               ((sum(pc.quantidade * precovenda)' +
        '*100)/(faturados.valorvista+coalesce(faturados.desconto,0))) as ' +
        'percvendedor,'
      '                                faturados.contrato,'
      '        '#9#9'        faturados.filialvenda,'
      '        '#9#9#9'faturados.faturamento,'
      '        '#9#9#9'faturados.valorvista,'
      '        '#9#9#9'faturados.desconto,'
      '        '#9#9'        faturados.valorprazo,'
      '        '#9#9'        faturados.plano'
      '                        FROM produtoscontratos pc, ('
      
        '            '#9#9'                            SELECT ct.numero as co' +
        'ntrato,'
      '        '#9#9#9#9#9'           ct.filialvenda,'
      '        '#9#9#9'                           ct.faturamento,'
      '        '#9#9#9'                           ct.valorvista,'
      '        '#9#9#9#9#9#9'   ct.desconto,'
      '        '#9#9#9'                           ct.valorprazo,'
      '        '#9#9#9#9#9#9'   ct.plano,'
      
        '                                                           ct.ve' +
        'ndedor'
      '        '#9#9'                            FROM contratos ct'
      
        '        '#9#9'                            WHERE (ct.faturamento BETW' +
        'EEN :datainicial AND :datafinal) AND'
      
        '        '#9#9#9'                          (ct.origem IS NULL) and (ct' +
        '.valorvista+coalesce(ct.desconto,0))<>0'
      ''
      '        '#9#9'                                  %FiltroContratos'
      ''
      '        '#9#9#9#9#9'    ORDER BY ct.numero'
      '        '#9#9#9'                   ) AS faturados'
      
        '                        WHERE pc.contrato = faturados.contrato a' +
        'nd not pc.brinde'
      ''
      
        '        '#9#9'                                  %FiltroProdutosContr' +
        'atos'
      ''
      
        '                        GROUP BY pc.vendedor, faturados.vendedor' +
        ', faturados.contrato, filialvenda, faturamento, valorvista, fatu' +
        'rados.desconto, valorprazo, plano'
      '        '#9#9'ORDER BY faturados.contrato'
      '        '#9'       ) as vendas'
      '        WHERE parcelas.contrato = vendas.contrato AND'
      
        '             (parcelas.tipopagto is null or parcelas.tipopagto n' +
        'ot in ('#39'P'#39','#39'X'#39'))'
      '        ORDER BY contrato, parcelas.datavencto'
      '        ) AS base'
      
        '        GROUP BY vendedor, contrato, filialvenda, faturamento, e' +
        'vento, valorvista, toleranciaentrada, valorprazo, avista, tipoba' +
        'se'
      '        )'
      '        union all'
      '        ('
      '          SELECT vendedor,'
      
        '                 (select tipocomissao from usuarios where codigo' +
        ' = vendedor) as tipobase,'
      '                 nota as contrato,'
      '                 filialvenda,'
      '                 data as faturamento,'
      '                 valorvista,'
      '                 valorprazo,'
      '                 CASE WHEN avista = '#39't'#39' THEN '#39'VENDA A VISTA'#39
      
        '                      WHEN ( avista = '#39'f'#39' AND datavencto>(data+c' +
        'oalesce(toleranciaentrada,0)) ) THEN '#39'VENDA A PRAZO'#39
      '                 ELSE '#39'VENDA ENTRADA'#39' END AS evento,'
      '                 SUM(valorvencto) AS valor'
      '          FROM'
      '            ('
      '            SELECT vendas.vendedor,'
      '                   vendas.nota,'
      '                   vendas.data,'
      '                   vendas.filialvenda,'
      
        '                   round(((vendas.valorvista * vendas.percvended' +
        'or)/100),2) as valorvista,'
      
        '                   round(((vendas.valortotal * vendas.percvended' +
        'or)/100),2) as valorprazo,'
      
        '                   round(((vdf.valorvencto * vendas.percvendedor' +
        ')/100),2) as valorvencto,'
      '                   vdf.datavencto,'
      '                   true AS avista,'
      
        '                   (select toleranciaentrada from planos where p' +
        'lanos.codigo = vendas.plano) as toleranciaentrada'
      '            FROM venctosdadosfiscais vdf ,'
      '                           ('
      
        '                             SELECT coalesce(pdf.vendedor, fatur' +
        'ados.vendedor) as vendedor,'
      
        '                                   ((sum(pdf.quantidade * pdf.pr' +
        'ecovenda)*100)/(faturados.valorvista+coalesce(faturados.desconto' +
        ',0))) as percvendedor,'
      '                                    faturados.dadofiscal,'
      '                                    faturados.nota,'
      '                                    faturados.data,'
      '                  '#9#9'    faturados.valorvista,'
      '                  '#9#9'    faturados.desconto,'
      '                  '#9#9'    faturados.valortotal,'
      '                  '#9#9'    faturados.plano,'
      '                                    faturados.filialvenda'
      
        '                              FROM produtosdadosfiscais pdf, ( S' +
        'ELECT df.numero as dadofiscal,'
      
        '                                                                ' +
        '    cast(coalesce('#39'NF '#39'||cast(n.serie as varchar)||'#39' '#39'||cast(n.n' +
        'umero as varchar),'
      
        '             '#9#9#9#9#9#9#9#9'          '#39'CP '#39'||cast(c.maquina as varchar)' +
        '||'#39' '#39'||cast(c.intervensao as varchar)||'#39' '#39'||cast(c.numero as var' +
        'char)) as varchar(25)) as nota,'
      
        '                                                                ' +
        '        df.data,'
      
        '                  '#9#9#9'                                df.valorvis' +
        'ta,'
      '                  '#9#9#9#9#9#9'        df.desconto,'
      
        '                  '#9#9#9'                                df.valortot' +
        'al,'
      '                  '#9#9#9#9#9#9'        df.plano,'
      
        '                                                                ' +
        '        df.filialvenda,'
      
        '                                                                ' +
        '        df.vendedor'
      
        '                      '#9#9'                              FROM dados' +
        'fiscais df left join notas n on df.numero = n.dadofiscal'
      
        '                                                                ' +
        '                   left join cupons c on df.numero = c.dadofisca' +
        'l'
      
        '                  '#9#9'                              WHERE (df.data' +
        ' BETWEEN :datainicial AND :datafinal)'
      
        '                                                                ' +
        'and not coalesce(df.notavinculada,false)'
      
        '                                                                ' +
        'AND df.contrato is null'
      '       '#9#9#9#9#9#9'           and ((mod(df.codigofiscal,1000) in ('
      '       '#9#9#9#9#9#9#9#9'%ListaCodigosFiscaisVenda'
      '       '#9#9#9#9#9#9#9#9')) or mod(df.codigofiscal,1000) in (929))'
      '                   '#9#9#9#9#9'         %FiltroContratos'
      '                   '#9#9#9#9#9'      ORDER BY df.numero'
      '                  '#9#9#9'                    ) AS faturados'
      
        '                              WHERE pdf.dadofiscal = faturados.d' +
        'adofiscal'
      
        '                                and not coalesce(pdf.brinde,fals' +
        'e)'
      ''
      '                                 %FiltroProdutosDadosFiscais'
      ''
      
        '                              GROUP BY pdf.vendedor, faturados.v' +
        'endedor, faturados.dadofiscal, faturados.nota,'
      
        '                                       faturados.data, faturados' +
        '.filialvenda,'
      
        '                                       faturados.valorvista, fat' +
        'urados.desconto, faturados.valortotal, faturados.plano'
      '              '#9#9'      ORDER BY faturados.dadofiscal'
      '            '#9'             ) as vendas'
      '            WHERE vdf.dadofiscal = vendas.dadofiscal'
      '            ORDER BY vendas.dadofiscal, vdf.datavencto'
      '            ) AS base'
      
        '          GROUP BY vendedor, nota, filialvenda, data, evento, va' +
        'lorvista, toleranciaentrada, valorprazo, avista, tipobase'
      '        )'
      '      ) as base'
      '   )'
      '%FINAL_VENDAS_A_SER_APLICADO_O_PERCENTUAL'
      '%UNION_ALL_FINAL_VENDAS_A_SER_APLICADO_O_PERCENTUAL'
      
        '%INICIO_ABATIMENTO_CREDITO_TROCA_VENDAS_A_SER_APLICADO_O_PERCENT' +
        'UAL'
      '('
      'select vendedor,'
      '       cast('#39'CT '#39'||contrato as varchar(25)) as contrato,'
      '       cast(null as integer) as produto,'
      '       cast(null as varchar(50)) as nomeproduto,'
      '       filialvenda,'
      '       faturamento,'
      '       evento,'
      '       -valor,'
      '       -valor as base,'
      '       tipobase'
      'from'
      '('
      'SELECT vendedor,'
      
        '       (select tipocomissao from usuarios where codigo = vendedo' +
        'r) as tipobase,'
      '       contrato,'
      '       filialvenda,'
      '       faturamento,'
      
        '       CASE WHEN avista = '#39't'#39' THEN '#39'ABATIMENTO CREDITO TROCA - V' +
        'ENDA A VISTA'#39
      
        '            WHEN ( avista = '#39'f'#39' AND datavencto>(faturamento+coal' +
        'esce(toleranciaentrada,0)) ) THEN '#39'ABATIMENTO CREDITO TROCA - VE' +
        'NDA A PRAZO'#39
      
        '       ELSE '#39'ABATIMENTO CREDITO TROCA - VENDA ENTRADA'#39' END AS ev' +
        'ento,'
      '       SUM(valorvencto) AS valor'
      'FROM'
      '('
      'SELECT vendas.vendedor,'
      '       vendas.contrato,'
      '       vendas.filialvenda,'
      '       vendas.faturamento,'
      
        '       round(((parcelas.valorvencto * vendas.percvendedor)/100),' +
        '2) as valorvencto,'
      '       parcelas.datavencto,'
      '       contratos_avista(vendas.contrato) AS avista,'
      
        '       (select toleranciaentrada from planos where planos.codigo' +
        ' = vendas.plano) as toleranciaentrada'
      'FROM parcelas, ('
      
        '                SELECT coalesce(pc.vendedor, faturados.vendedor)' +
        ' as vendedor,'
      
        '                       ((sum(pc.quantidade * precovenda)*100)/(f' +
        'aturados.valorvista+coalesce(faturados.desconto,0))) as percvend' +
        'edor,'
      '                       faturados.contrato,'
      '                       faturados.filialvenda,'
      '                       faturados.faturamento,'
      '                       faturados.valorvista,'
      '                       faturados.desconto,'
      '                       faturados.plano'
      '                FROM produtoscontratos pc, ('
      '    '#9#9'                            SELECT ct.numero as contrato,'
      #9#9#9#9#9'           ct.filialvenda,'
      #9#9#9'                           ct.faturamento,'
      #9#9#9'                           ct.valorvista,'
      #9#9#9#9#9#9'   ct.desconto,'
      #9#9#9#9#9#9'   ct.plano,'
      '                                                   ct.vendedor'
      #9#9'                            FROM contratos ct'
      
        #9#9'                            WHERE (ct.faturamento BETWEEN :dat' +
        'ainicial AND :datafinal) AND'
      #9#9#9'                          (ct.origem IS NULL) and'
      #9#9#9#9#9#9'  (ct.valorvista+coalesce(ct.desconto,0))<>0 AND'
      #9#9#9#9#9#9'  (coalesce(ct.creditotroca,0)<>0)'
      ''
      #9#9'                                  %FiltroContratos'
      ''
      #9#9#9#9#9'    ORDER BY ct.numero'
      #9#9#9'                   ) AS faturados'
      
        '                WHERE pc.contrato = faturados.contrato and not p' +
        'c.brinde'
      ''
      #9#9'                                  %FiltroProdutosContratos'
      ''
      
        '                GROUP BY pc.vendedor, faturados.vendedor, fatura' +
        'dos.contrato, filialvenda, faturamento, valorvista, faturados.de' +
        'sconto, plano'
      #9#9'ORDER BY faturados.contrato'
      #9'       ) as vendas'
      'WHERE parcelas.contrato = vendas.contrato AND'
      
        '     (parcelas.tipopagto is null or parcelas.tipopagto not in ('#39 +
        'P'#39','#39'X'#39')) AND (parcelas.formapagamento='#39'T'#39')'
      'ORDER BY contrato, parcelas.datavencto'
      ') AS base'
      
        'GROUP BY vendedor, contrato, filialvenda, faturamento, evento, t' +
        'oleranciaentrada, avista, tipobase'
      ') as base'
      ')'
      
        '%FINAL_ABATIMENTO_CREDITO_TROCA_VENDAS_A_SER_APLICADO_O_PERCENTU' +
        'AL'
      
        '%UNION_ALL_FINAL_ABATIMENTO_CREDITO_TROCA_VENDAS_A_SER_APLICADO_' +
        'O_PERCENTUAL'
      
        '%INICIO_ESTORNOS_DO_MES_E_FORA_DO_MES_A_SER_APLICADO_O_PERCENTUA' +
        'L'
      '('
      'select vendedor,'
      '       contrato,'
      '       cast(null as integer) as produto,'
      '       cast(null as varchar(50)) as nomeproduto,'
      '       filialvenda,'
      '       dataestorno,'
      '       evento,'
      '      - case'
      '          when evento = '#39'ESTORNO ENTRADA'#39' then valor'
      '          else valorprazo'
      '        end as valor,'
      '      - case'
      
        '          when evento = '#39'ESTORNO A VISTA'#39' then valorprazo - (val' +
        'orprazo - valor)'
      '          when evento = '#39'ESTORNO A PRAZO'#39' then'
      '            case'
      
        '              when tipobase = '#39'P'#39' then valorprazo - (valorprazo ' +
        '- valor)'
      
        '              WHEN tipobase = '#39'V'#39' then valorvista - (valorprazo ' +
        '- valor)'
      '            end'
      '          when evento = '#39'ESTORNO ENTRADA'#39' then valor'
      '        end as base,'
      #9'tipobase'
      ''
      'from'
      '('
      '  ('
      '  SELECT vendedor,'
      
        '         (select tipocomissao from usuarios where codigo = vende' +
        'dor) as tipobase,'
      '          cast('#39'CT '#39'||contrato as varchar(25)) as contrato,'
      '         filialvenda,'
      '         dataestorno,'
      '         valorvista,'
      '         valorprazo,'
      '         CASE WHEN avista = '#39't'#39' THEN '#39'ESTORNO A VISTA'#39
      
        '              WHEN ( avista = '#39'f'#39' AND datavencto>(faturamento+co' +
        'alesce(toleranciaentrada,0)) ) THEN '#39'ESTORNO A PRAZO'#39
      '         ELSE '#39'ESTORNO ENTRADA'#39' END AS evento,'
      '         SUM(valorvencto) AS valor'
      '  FROM'
      '  ('
      '  SELECT vendas.vendedor,'
      '         vendas.contrato,'
      '         vendas.filialvenda,'
      '         vendas.faturamento,'
      
        '         round(((vendas.valorvista * vendas.percvendedor)/100),2' +
        ') as valorvista,'
      
        '         round(((vendas.valorprazo * vendas.percvendedor)/100),2' +
        ') as valorprazo,'
      
        '         round(((parcelas.valorvencto * vendas.percvendedor)/100' +
        '),2) as valorvencto,'
      '         parcelas.datavencto,'
      
        '         CASE WHEN tipopagto in ('#39'E'#39','#39'J'#39') THEN datapagto ELSE de' +
        'ventrada END AS dataestorno,'
      '         contratos_avista(vendas.contrato) AS avista,'
      
        '         (select toleranciaentrada from planos where planos.codi' +
        'go = vendas.plano) as toleranciaentrada'
      '  FROM parcelas, ('
      
        '                  SELECT coalesce(pc.vendedor, faturados.vendedo' +
        'r) as vendedor,'
      
        '                         ((sum(pc.quantidade * precovenda)*100)/' +
        '(faturados.valorvista+coalesce(faturados.desconto,0))) as percve' +
        'ndedor,'
      '      '#9#9'                                   faturados.contrato,'
      '  '#9#9#9#9#9'           faturados.filialvenda,'
      '  '#9#9#9'                           faturados.faturamento,'
      '  '#9#9#9'                           faturados.valorvista,'
      '  '#9#9#9#9#9#9'   faturados.desconto,'
      '  '#9#9#9'                           faturados.valorprazo,'
      '  '#9#9#9#9#9#9'   faturados.plano'
      '                  FROM produtoscontratos pc, ('
      
        '      '#9#9'                            SELECT ct.numero as contrato' +
        ','
      '  '#9#9#9#9#9'           ct.filialvenda,'
      '  '#9#9#9'                           ct.faturamento,'
      '  '#9#9#9'                           ct.valorvista,'
      '  '#9#9#9#9#9#9'   ct.desconto,'
      '  '#9#9#9'                           ct.valorprazo,'
      '  '#9#9#9#9#9#9'   ct.plano,'
      '                                                   ct.vendedor'
      '  '#9#9'                            FROM contratos ct'
      '  '#9#9'                            WHERE ct.numero in (('
      '  '#9#9#9#9#9'                        (SELECT distinct cv.contrato'
      '  '#9#9#9#9#9'                         FROM contratosdevolvidos cv'
      
        '  '#9#9#9#9#9#9#9#9' WHERE (cv.devolucao BETWEEN :datainicial AND :datafin' +
        'al) and cv.tipo='#39'D'#39
      '  '#9#9#9#9#9#9#9#9' )'
      '  '#9#9#9#9#9#9#9#9' UNION ALL'
      
        '                                                                ' +
        '   (select distinct p.contrato'
      '  '#9#9#9#9#9#9#9#9'  from contratos ct, parcelas p'
      '  '#9#9#9#9#9#9#9#9'  where ct.numero=p.contrato and'
      '  '#9#9#9#9#9#9#9#9'       ct.situacao='#39'C'#39' and'
      '  '#9#9#9#9#9#9#9#9'       not exists (select p2.numero'
      '  '#9#9#9#9#9#9#9#9'                   from parcelas p2'
      '  '#9#9#9#9#9#9#9#9#9#9'   where p2.contrato = ct.numero and'
      '  '#9#9#9#9#9#9#9#9#9#9'         p2.tipopagto<>'#39'E'#39') and'
      
        '   '#9#9#9#9#9#9#9#9'       p.datapagto between :datainicial and :datafina' +
        'l and'
      '  '#9#9#9#9#9#9#9#9'       not exists (select cd.contrato'
      '  '#9#9#9#9#9#9#9#9'                   from contratosdevolvidos cd'
      '  '#9#9#9#9#9#9#9#9#9#9'   where cd.contrato = ct.numero and'
      '  '#9#9#9#9#9#9#9#9#9#9'         cd.tipo = '#39'D'#39')'
      '  '#9#9#9#9#9#9#9#9' )'
      '  '#9#9#9#9#9#9#9#9' ORDER BY contrato'
      '  '#9#9#9#9#9#9#9#9' )'
      '  '#9#9#9#9#9#9#9#9') and (ct.valorvista+coalesce(ct.desconto,0))<>0'
      ''
      '                                                %FiltroContratos'
      ''
      '  '#9#9#9#9#9'    ORDER BY ct.numero'
      '  '#9#9#9'                   ) AS faturados'
      
        '                  WHERE pc.contrato = faturados.contrato and not' +
        ' pc.brinde'
      ''
      
        '                                                %FiltroProdutosC' +
        'ontratos'
      ''
      
        '                  GROUP BY pc.vendedor, faturados.vendedor, fatu' +
        'rados.contrato, filialvenda, faturamento, valorvista, faturados.' +
        'desconto, valorprazo, plano'
      '  '#9#9'ORDER BY faturados.contrato'
      '  '#9'       ) as vendas'
      
        '  WHERE parcelas.contrato = vendas.contrato AND (tipopagto IN ('#39 +
        'E'#39','#39'D'#39','#39'C'#39')) AND'
      
        '     ((parcelas.tipopagto in ('#39'E'#39','#39'J'#39') and parcelas.datapagto be' +
        'tween :datainicial AND :datafinal) or'
      
        '      (parcelas.tipopagto in ('#39'D'#39','#39'C'#39') and parcelas.deventrada b' +
        'etween :datainicial AND :datafinal))'
      ''
      '  ORDER BY contrato, parcelas.datavencto'
      '  ) AS base'
      
        '  GROUP BY vendedor, contrato, filialvenda, faturamento, dataest' +
        'orno, evento, valorvista, toleranciaentrada, valorprazo, avista,' +
        ' tipobase'
      '  )'
      '  union all'
      '  ('
      '    SELECT vendedor,'
      
        '           (select tipocomissao from usuarios where codigo = ven' +
        'dedor) as tipobase,'
      '           nota as contrato,'
      '           filialvenda,'
      '           datacancelamento as dataestorno,'
      '           valorvista,'
      '           valorprazo,'
      '           CASE WHEN avista = '#39't'#39' THEN '#39'ESTORNO A VISTA'#39
      
        '                WHEN ( avista = '#39'f'#39' AND datavencto>(data+coalesc' +
        'e(toleranciaentrada,0)) ) THEN '#39'ESTORNO A PRAZO'#39
      '           ELSE '#39'ESTORNO ENTRADA'#39' END AS evento,'
      '           SUM(valorvencto) AS valor'
      '    FROM'
      '      ('
      '      SELECT vendas.vendedor,'
      '             vendas.nota,'
      '             vendas.filialvenda,'
      '             vendas.datacancelamento,'
      '             vendas.data,'
      
        '             round(((vendas.valorvista * vendas.percvendedor)/10' +
        '0),2) as valorvista,'
      
        '             round(((vendas.valortotal * vendas.percvendedor)/10' +
        '0),2) as valorprazo,'
      
        '             round(((vdf.valorvencto * vendas.percvendedor)/100)' +
        ',2) as valorvencto,'
      '             vdf.datavencto,'
      '             true AS avista,'
      
        '             (select toleranciaentrada from planos where planos.' +
        'codigo = vendas.plano) as toleranciaentrada'
      '      FROM venctosdadosfiscais vdf ,'
      
        '                     (SELECT coalesce(pdf.vendedor, faturados.ve' +
        'ndedor) as vendedor,'
      
        '                             ((sum(pdf.quantidade * pdf.precoven' +
        'da)*100)/(faturados.valorvista+coalesce(faturados.desconto,0))) ' +
        'as percvendedor,'
      '                              faturados.dadofiscal,'
      '                              faturados.nota,'
      '                  '#9'      faturados.datacancelamento,'
      '                              faturados.data,'
      '                  '#9'      faturados.valorvista,'
      '                  '#9'      faturados.desconto,'
      '                  '#9'      faturados.valortotal,'
      '                  '#9'      faturados.plano,'
      #9#9#9'      faturados.filialvenda'
      
        '                      FROM produtosdadosfiscais pdf, ( SELECT df' +
        '.numero as dadofiscal,'
      
        '                                                                ' +
        '    cast(coalesce('#39'NF '#39'||cast(n.serie as varchar)||'#39' '#39'||cast(n.n' +
        'umero as varchar),'
      
        '             '#9#9#9#9#9#9#9#9'          '#39'CP '#39'||cast(c.maquina as varchar)' +
        '||'#39' '#39'||cast(c.intervensao as varchar)||'#39' '#39'||cast(c.numero as var' +
        'char)) as varchar(25)) as nota,'
      
        '                  '#9#9#9'                                df.datacanc' +
        'elamento,'
      
        '                                                                ' +
        '        df.data,'
      
        '                  '#9#9#9'                                df.valorvis' +
        'ta,'
      '                  '#9#9#9#9#9#9'        df.desconto,'
      
        '                  '#9#9#9'                                df.valortot' +
        'al,'
      '                  '#9#9#9#9#9#9'        df.plano,'
      #9#9#9#9#9#9#9#9#9'df.filialvenda,'
      
        '                                                                ' +
        '        df.vendedor'
      
        '                      '#9#9'                              FROM dados' +
        'fiscais df left join notas n on df.numero = n.dadofiscal'
      
        '                                                                ' +
        '                   left join cupons c on df.numero = c.dadofisca' +
        'l'
      
        '            '#9#9'                                 WHERE (df.datacan' +
        'celamento BETWEEN :datainicial AND :datafinal)'
      
        '                                                           and n' +
        'ot coalesce(df.notavinculada,false)'
      
        '                                                           AND d' +
        'f.contrato is null'
      '       '#9#9#9#9#9#9'           and ((mod(df.codigofiscal,1000) in ('
      '       '#9#9#9#9#9#9#9#9'%ListaCodigosFiscaisVenda'
      '       '#9#9#9#9#9#9#9#9')) or mod(df.codigofiscal,1000) in (929))'
      '             '#9#9#9#9#9'         %FiltroContratos'
      '             '#9#9#9#9#9'         ORDER BY df.numero'
      '            '#9#9#9'                       ) AS faturados'
      
        '                      WHERE pdf.dadofiscal = faturados.dadofisca' +
        'l'
      '                        and not coalesce(pdf.brinde,false)'
      ''
      '                        %FiltroProdutosDadosFiscais'
      ''
      
        '                      GROUP BY pdf.vendedor, faturados.vendedor,' +
        ' faturados.filialvenda, faturados.dadofiscal, faturados.nota, fa' +
        'turados.datacancelamento,'
      '                               faturados.data,'
      
        '                               faturados.valorvista, faturados.d' +
        'esconto, faturados.valortotal, faturados.plano'
      '      '#9#9'ORDER BY faturados.dadofiscal'
      '      '#9'       ) as vendas'
      '      WHERE vdf.dadofiscal = vendas.dadofiscal'
      '      ORDER BY vendas.dadofiscal, vdf.datavencto'
      '      ) AS base'
      
        '    GROUP BY vendedor, nota, filialvenda, data, datacancelamento' +
        ', evento, valorvista, toleranciaentrada, valorprazo, avista, tip' +
        'obase'
      '  )'
      ') as base'
      ')'
      '%FINAL_ESTORNOS_DO_MES_E_FORA_DO_MES_A_SER_APLICADO_O_PERCENTUAL'
      'order by vendedor, evento'
      ') as vendas_e_estornos'
      'where percentual.vendedor = vendas_e_estornos.vendedor and'
      '      comissoesusuarios.usuario = vendas_e_estornos.vendedor and'
      '      comissoesusuarios.numero = percentual.nivelcomissao'
      ')'
      '%FINAL_NIVEL_DE_COMISSAO_DA_TABELA_COMISSOESUSUARIOS'
      '%UNION_ALL_FINAL_NIVEL_DE_COMISSAO_DA_TABELA_COMISSOESUSUARIOS'
      '%INICIO_ADICIONAL_PRODUTOS_VENDAS'
      '('
      'SELECT vendedor,'
      #9'contrato,'
      #9'produto,'
      '        p.descricao as nomeproduto,'
      #9'filialvenda,'
      #9'faturamento,'
      #9'CASE WHEN tipobase = '#39'V'#39' THEN'
      #9'  CAST('#39'ADIC. PRODUTO $'#39' AS TEXT)'
      #9'ELSE'
      #9'  CAST('#39'ADIC. PRODUTO %'#39' AS TEXT)'
      #9'END AS evento,'
      #9'valor,'
      #9'valor as base,'
      #9'tipobase,'
      #9'cast(null as integer) as nivelcomissao,'
      #9'percentual_ou_valor,'
      #9'quantidade,'
      '   produtomonstruario,'
      #9'tipocomissao'
      ''
      'FROM'
      '('
      'SELECT vendas.*,'
      #9'CASE WHEN cug.comissao is not null THEN cug.tipocomissao'
      #9'     WHEN cuc.comissao is not null THEN cuc.tipocomissao'
      #9'     WHEN c.comissao   is not null THEN c.tipocomissao'
      #9'     WHEN g.comissao   is not null THEN g.tipocomissao'
      '        WHEN cl.comissao  is not null THEN cl.tipocomissao'
      #9'END AS tipocomissao,'
      ''
      #9'CASE WHEN cug.comissao is not null THEN cug.comissao'
      #9'     WHEN cuc.comissao is not null THEN cuc.comissao'
      #9'     WHEN c.comissao   is not null THEN c.comissao'
      #9'     WHEN g.comissao   is not null THEN g.comissao'
      '        WHEN cl.comissao  is not null THEN cl.comissao'
      #9'END AS percentual_ou_valor,'
      ''
      #9'CASE WHEN (tipobase='#39'P'#39') THEN'
      
        '          round(((quantidade*precovenda)*(valorprazo-frete))/(va' +
        'lorvista-frete+desconto),2)'
      #9'ELSE'
      
        '          round(((quantidade*precovenda)*(valorvista-frete))/(va' +
        'lorvista-frete+desconto),2)'
      #9'END AS valor'
      'FROM'
      '('
      '  ('
      
        '    SELECT coalesce(pc.vendedor, faturados.vendedor) as vendedor' +
        ','
      '           pc.produto,'
      '           pc.precovenda,'
      '           pc.quantidade,'
      '           pc.produtomonstruario,'
      '           u.tipocomissao as tipobase,'
      
        '           cast('#39'CT '#39'||faturados.contrato as varchar(25)) as con' +
        'trato,'
      ''
      
        '           cast(faturados.contrato as varchar) as numerodocument' +
        'o,'
      '           cast('#39'CT'#39' as varchar) as tipo,'
      ''
      '           faturados.filialvenda,'
      '           faturados.faturamento,'
      '           faturados.valorprazo,'
      '           faturados.valorvista,'
      '           faturados.desconto,'
      '           coalesce(faturados.frete,0) as frete'
      '    FROM produtoscontratos pc, usuarios u,'
      '    '#9#9#9'('
      '    '#9#9#9'SELECT ct.numero as contrato,'
      '    '#9#9#9'       ct.filialvenda,'
      '    '#9#9#9'       ct.faturamento,'
      '    '#9#9#9'       ct.valorprazo,'
      '    '#9#9#9'       ct.valorvista,'
      '    '#9#9#9'       ct.desconto,'
      '                   ct.frete,'
      '                               ct.vendedor'
      '    '#9#9#9'FROM contratos ct'
      
        '    '#9#9#9'WHERE  (ct.faturamento BETWEEN :datainicial AND :datafina' +
        'l) AND'
      
        '    '#9#9#9#9'(ct.origem IS NULL) and (ct.valorvista+coalesce(ct.desco' +
        'nto,0))<>0'
      ''
      '                                  %FiltroContratos'
      ''
      '    '#9#9#9'ORDER BY ct.numero'
      '    '#9#9#9') AS faturados'
      '    WHERE pc.contrato = faturados.contrato'
      '      and coalesce(pc.vendedor, faturados.vendedor) = u.codigo'
      '      and not pc.brinde'
      ''
      ''
      '                            %FiltroProdutosContratos'
      ''
      '    ORDER BY pc.produto'
      '  )'
      '  union all'
      '  ('
      
        '    SELECT coalesce(pdf.vendedor, faturados.vendedor) as vendedo' +
        'r,'
      '           pdf.produto,'
      '           pdf.precovenda,'
      '           pdf.quantidade,'
      '           pdf.produtomonstruario,'
      '           u.tipocomissao as tipobase,'
      '           faturados.nota as contrato,'
      ''
      
        '           cast(faturados.dadofiscal as varchar) as numerodocume' +
        'nto,'
      '           cast('#39'DF'#39' as varchar) as tipo,'
      ''
      '           faturados.filialvenda,'
      '           faturados.faturamento,'
      '           faturados.valorprazo,'
      '           faturados.valorvista,'
      '           faturados.desconto,'
      '           COALESCE(faturados.valorfrete, 0) as Frete'
      ''
      '    FROM produtosdadosfiscais pdf, usuarios u,'
      '    '#9#9#9'('
      '    '#9#9#9'SELECT'
      '                               df.numero as dadofiscal,'
      
        '                               cast(coalesce('#39'NF '#39'||cast(n.serie' +
        ' as varchar)||'#39' '#39'||cast(n.numero as varchar),'
      
        '                                             '#39'CP '#39'||cast(c.maqui' +
        'na as varchar)||'#39' '#39'||cast(c.intervensao as varchar)||'#39' '#39'||cast(c' +
        '.numero as varchar)) as varchar(25)) as nota,'
      '    '#9#9#9'       df.filialvenda,'
      '    '#9#9#9'       df.data as faturamento,'
      '    '#9#9#9'       df.valortotal as valorprazo,'
      '    '#9#9#9'       df.valorvista,'
      '    '#9#9#9'       df.desconto,'
      '                   df.valorfrete,'
      '                               df.vendedor'
      ''
      
        '                               FROM dadosfiscais df left join no' +
        'tas n on df.numero = n.dadofiscal'
      
        '                                                          left j' +
        'oin cupons c on df.numero = c.dadofiscal'
      
        '                               WHERE (df.data BETWEEN :datainici' +
        'al AND :datafinal)'
      
        '                                 and not coalesce(df.notavincula' +
        'da,false)'
      '                                 AND df.contrato is null'
      '       '#9#9#9#9#9#9'           and ((mod(df.codigofiscal,1000) in ('
      '       '#9#9#9#9#9#9#9#9'%ListaCodigosFiscaisVenda'
      '       '#9#9#9#9#9#9#9#9')) or mod(df.codigofiscal,1000) in (929))'
      '                               %FiltroContratos'
      '                               ORDER BY df.numero'
      '    '#9#9#9') AS faturados'
      '    WHERE pdf.dadofiscal = faturados.dadofiscal'
      '      and coalesce(pdf.vendedor, faturados.vendedor) = u.codigo'
      '      and not coalesce(pdf.brinde,false)'
      ''
      '     %FiltroProdutosDadosFiscais'
      ''
      '    ORDER BY pdf.produto'
      '  )'
      ') as vendas'
      #9'join (produtos p'
      #9#9'   join (caracteristicas c'
      #9#9'             '
      #9#9#9#9#9' join classes cl'
      '                on c.classe = cl.codigo)'
      '                '
      #9#9'   on p.caracteristica = c.codigo)'
      #9'on p.codigo = vendas.produto'
      ''
      #9'left join comissoesusuariosgrupos cug'
      #9'on cug.usuario = vendas.vendedor and cug.grupo = c.grupo'
      ''
      #9'left join comissoesusuariosclasses cuc'
      #9'on cuc.usuario = vendedor and cuc.classe = cl.codigo'
      ''
      '   left join'
      ''
      ''
      ''
      '    ('
      ' SELECT pc.contrato, pc.grupo, gc.comissao, gc.tipocomissao'
      'FROM (('
      '    SELECT pc.contrato, pc.grupo, pc.total, ('
      '        SELECT gc.numero'
      '        FROM gruposcomissoes gc'
      
        '        WHERE ((gc.grupo = pc.grupo) AND (gc.limite >= pc.total)' +
        ')'
      '        ORDER BY gc.limite'
      '        LIMIT 1'
      '        ) AS numero'
      '    FROM ('
      
        '        SELECT pc.contrato, pc.grupo, sum(((((((pc.quantidade * ' +
        'pc.precovenda)'
      '            + COALESCE(pc.acrescimo, 0)) + COALESCE(pc.frete,'
      '            0)) + COALESCE(pc.seguro, 0)) -'
      '            COALESCE(pc.valordescontoitem, 0)) -'
      '            COALESCE(pc.desconto, 0))) AS total'
      '        FROM ('
      
        '            SELECT pc.quantidade, pc.precovenda, pc.acrescimo, p' +
        'c.frete,'
      
        '                pc.seguro, pc.valordescontoitem, pc.desconto, pc' +
        '.produto,'
      '                pc.contrato, pc.caracteristica, pc.grupo'
      '            FROM ('
      
        '                SELECT pc.quantidade, pc.precovenda, pc.acrescim' +
