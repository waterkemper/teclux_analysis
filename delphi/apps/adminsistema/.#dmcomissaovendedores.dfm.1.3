        '            SELECT pc.quantidade, pc.precovenda, pc.acrescimo, p' +
        'c.frete,'
      
        '                pc.seguro, pc.valordescontoitem, pc.desconto, pc' +
        '.produto,'
      '                pc.contrato, pc.caracteristica, pc.grupo'
      '            FROM ('
      
        '                SELECT pc.quantidade, pc.precovenda, pc.acrescim' +
        'o, pc.frete,'
      
        '                    pc.seguro, pc.valordescontoitem, pc.desconto' +
        ', pc.produto,'
      '                    pc.contrato, pc.caracteristica, c.grupo'
      '                FROM (('
      
        '                    SELECT pc.quantidade, pc.precovenda, pc.acre' +
        'scimo,'
      
        '                        pc.frete, pc.seguro, pc.valordescontoite' +
        'm, pc.desconto,'
      
        '                        pc.produto, pc.contrato, p.caracteristic' +
        'a'
      '                    FROM (('
      ''
      
        '                        SELECT pc.quantidade, pc.precovenda, pc.' +
        'acrescimo,'
      
        '                            pc.frete, pc.seguro, pc.valordescont' +
        'oitem,'
      '                            pc.desconto, pc.produto, pc.contrato'
      
        '                        FROM produtoscontratos pc join contratos' +
        ' ct on pc.contrato = ct.numero'
      '                        where pc.contrato = ct.numero'
      
        '          '#9#9'  and (ct.faturamento BETWEEN :datainicial AND :data' +
        'final)'
      '                          AND (ct.origem IS NULL)'
      
        '                          AND (ct.valorvista+coalesce(ct.descont' +
        'o,0))<>0'
      '                            %FiltroContratos'
      '                            %FiltroProdutosContratos_Grupos'
      '                          and not pc.brinde'
      ''
      
        '                        ) pc JOIN produtos p ON ((pc.produto = p' +
        '.codigo)))'
      '                    WHERE (pc.produto = p.codigo)'
      
        '                    ) pc JOIN caracteristicas c ON ((pc.caracter' +
        'istica = c.codigo)))'
      '                WHERE (pc.caracteristica = c.codigo)'
      '                ) pc'
      '            ) pc'
      '        GROUP BY pc.contrato, pc.grupo'
      '        ) pc'
      
        '    ) pc LEFT JOIN gruposcomissoes gc ON (((pc.grupo = gc.grupo)' +
        ' AND (pc.numero'
      '        = gc.numero))))'
      ''
      ''
      ' ) as g'
      ''
      '   on c.grupo = g.grupo'
      '   and g.contrato = vendas.numerodocumento'
      '   and vendas.tipo = '#39'CT'#39
      ''
      'where c.classe = cl.codigo'
      '  and p.caracteristica = c.codigo'
      '  and p.codigo = vendas.produto'
      
        '  and (coalesce(cug.comissao, cuc.comissao, c.comissao, g.comiss' +
        'ao, cl.comissao) is not null)'
      ''
      
        ') AS adicionalprodutos_estornos join produtos p on adicionalprod' +
        'utos_estornos.produto = p.codigo'
      'where percentual_ou_valor <> 0'
      '  and adicionalprodutos_estornos.produto = p.codigo'
      ')'
      '%FINAL_ADICIONAL_PRODUTOS_ESTORNOS'
      ') as comissoes'
      '     join (filiais f'
      '           left join (filiaisgruposfiliais fgf'
      #9'              join gruposfiliais gf on fgf.grupo=gf.codigo)'
      '  '#9'   on f.codigo=fgf.filial)'
      '     on comissoes.filialvenda=f.codigo'
      '     join usuarios on comissoes.vendedor = usuarios.codigo'
      ') as comissoes'
      
        'group by filialvenda, nomefilialvenda, grupofilialvenda, nomegru' +
        'pofilialvenda, nome, vendedor, faturamento, contrato, evento, ti' +
        'pobase, tipocomissao, nivelcomissao, percentual_ou_valor, produt' +
        'o, nomeproduto'
      
        'order by filialvenda, UPPER(TO_ASCII(nomefilialvenda,'#39'LATIN1'#39')),' +
        ' grupofilialvenda, UPPER(TO_ASCII(nomegrupofilialvenda,'#39'LATIN1'#39')' +
        '), UPPER(TO_ASCII(nome,'#39'LATIN1'#39')), vendedor, faturamento, contra' +
        'to, evento, produto, UPPER(TO_ASCII(nomeproduto,'#39'LATIN1'#39')), tipo' +
        'base, tipocomissao, nivelcomissao, percentual_ou_valor'
      ')'
      '')
