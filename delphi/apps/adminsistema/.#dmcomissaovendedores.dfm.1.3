      '      ) as base'
      '    )'
      '  %FINAL_VENDAS_CALCULO_NIVEL_DA_TABELA'
      '  %UNION_ALL_FINAL_VENDAS_CALCULO_NIVEL_DA_TABELA'
      '  %INICIO_ABATIMENTO_CREDITOTROCA_VENDAS_CALCULO_NIVEL_DA_TABELA'
      '    ('
      '     SELECT vendas.vendedor,'
      
        '            - round(((vendas.creditotroca * vendas.percvendedor)' +
