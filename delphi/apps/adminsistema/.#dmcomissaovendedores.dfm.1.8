        '                WHEN ( avista = '#39'f'#39' AND datavencto>(data+coalesc' +
        'e(toleranciaentrada,0)) ) THEN '#39'ESTORNO A PRAZO'#39
      '           ELSE '#39'ESTORNO ENTRADA'#39' END AS evento,'
      '           SUM(valorvencto) AS valor'
      '    FROM'
      '      ('
      '      SELECT vendas.vendedor,'
      '             vendas.nota,'
