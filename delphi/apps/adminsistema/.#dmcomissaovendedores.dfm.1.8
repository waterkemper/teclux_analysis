      '%INICIO_ABATIMENTO_CREDITO_TROCA_ADICIONAL_PRODUTOS_VENDAS'
      '('
      'SELECT vendedor,'
      #9'cast('#39'CT '#39'||contrato as varchar(25)) as contrato,'
      #9'produto,'
      #9'filialvenda,'
      #9'faturamento,'
      #9'CASE WHEN tipobase = '#39'V'#39' THEN'
      #9'  CAST('#39'ABATIMENTO CREDITO TROCA - ADIC. PRODUTO $'#39' AS TEXT)'
