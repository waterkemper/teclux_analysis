    Sql.Strings = (
      '('
      'select vendedor,'
      '       nome,'
      '       contrato,'
      
        '       case when :AgruparFilial then filialvenda else cast(null ' +
        'as integer) end as filialvenda,'
      
        '       case when :AgruparFilial then nomefilialvenda else cast(n' +
        'ull as varchar) end as nomefilialvenda,'
      
        '       case when :AgruparGrupoFilial then grupofilialvenda else ' +
        'cast(null as integer) end as grupofilialvenda,'
      
        '       case when :AgruparGrupoFilial then nomegrupofilialvenda e' +
        'lse cast(null as varchar) end as nomegrupofilialvenda,'
      '       faturamento,'
      '       evento,'
      ''
      '       case when produtomonstruario then'
      
        '       sum(valor) * cast(Parametros_Valor('#39'Percentual da comiss'#227 +
        'o para produtos do monstru'#225'rio'#39',Filialvenda) as numeric) / 100'
      '       else sum(Valor) end as valor,'
      ''
      '       case when produtomonstruario then'
      
        '       sum(base) * cast(Parametros_Valor('#39'Percentual da comiss'#227'o' +
        ' para produtos do monstru'#225'rio'#39',Filialvenda) as numeric) / 100'
      '       else sum(base) end as base,'
      ''
      '       tipobase,'
      '       tipocomissao,'
      '       nivelcomissao,'
      ''
      '       case when produtomonstruario then'
      
        '       percentual_ou_valor * cast(Parametros_Valor('#39'Percentual d' +
        'a comiss'#227'o para produtos do monstru'#225'rio'#39',Filialvenda) as numeric' +
        ') / 100'
      '       else percentual_ou_valor end as percentual_ou_valor,'
