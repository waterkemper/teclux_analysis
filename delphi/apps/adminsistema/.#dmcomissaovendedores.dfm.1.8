      ''
      ''
      '                            %FiltroProdutosContratos'
      ''
      '    ORDER BY pc.produto'
      '  )'
      '  union all'
      '  ('
      
        '    SELECT coalesce(pdf.vendedor, faturados.vendedor) as vendedo' +
        'r,'
      '           pdf.produto,'
      '           pdf.precovenda,'
      '           pdf.quantidade,'
      '           pdf.produtomonstruario,'
      '           u.tipocomissao as tipobase,'
      '           faturados.nota as contrato,'
      ''
      
        '           cast(faturados.dadofiscal as varchar) as numerodocume' +
        'nto,'
      '           cast('#39'DF'#39' as varchar) as tipo,        '
      '           '
      '           faturados.filialvenda,'
      '           faturados.faturamento,'
      '           faturados.valorprazo,'
      '           faturados.valorvista,'
      '           faturados.desconto,'
