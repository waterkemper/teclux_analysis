        '       case when :AgruparGrupoFilial then grupofilialvenda else ' +
        'cast(null as integer) end as grupofilialvenda,'
      
        '       case when :AgruparGrupoFilial then nomegrupofilialvenda e' +
        'lse cast(null as varchar) end as nomegrupofilialvenda,'
      '       faturamento,'
      '       evento,'
      ''
