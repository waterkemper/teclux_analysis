      '     on comissoes.filialvenda=f.codigo'
      '     join usuarios on comissoes.vendedor = usuarios.codigo'
      ') as comissoes'
      
        'group by filialvenda, nomefilialvenda, grupofilialvenda, nomegru' +
        'pofilialvenda, nome, vendedor, faturamento, contrato, evento, ti' +
        'pobase, tipocomissao, nivelcomissao, percentual_ou_valor, produt' +
