      #9'     WHEN g.comissao is not null THEN g.tipocomissao'
      '             WHEN cl.comissao is not null THEN cl.tipocomissao'
      #9'END AS tipocomissao,'
      #9'CASE WHEN cug.comissao is not null THEN cug.comissao'
      #9'     WHEN cuc.comissao is not null THEN cuc.comissao'
      #9'     WHEN c.comissao is not null THEN c.comissao'
      #9'     WHEN g.comissao is not null THEN g.comissao'
      '             WHEN cl.comissao is not null THEN cl.comissao'
      #9'END AS percentual_ou_valor,'
      #9'CASE WHEN (tipobase='#39'P'#39') THEN'
      '                 valorprazo'
      #9'ELSE'
      '                 valorvista'
      #9'END AS valor'
      'FROM'
      '('
      '  ('
      
        '    SELECT coalesce(pc.vendedor, faturados.vendedor) as vendedor' +
        ','
      '   '#9'   u.tipocomissao as tipobase,'
      
        '           cast('#39'CT '#39'||faturados.contrato as varchar(25)) as con' +
        'trato,'
      '           faturados.filialvenda,'
      '           faturados.produto,'
      '           faturados.filial,'
      '           faturados.valorvista,'
      '           faturados.valorprazo,'
      '           faturados.quantidade,'
      '           faturados.produtomonstruario,'
      '           faturados.devolucao'
      '    FROM produtoscontratos pc, usuarios u,'
      '    '#9#9#9'('
      '    '#9#9#9' (('
      '                                   SELECT cv.contrato,'
      '    '#9#9#9'        ct.filialvenda,'
      '    '#9#9#9'        cv.produto,'
      '    '#9#9#9#9'cv.filial,'
      '    '#9#9#9'        cv.valorvista,'
      '    '#9#9#9#9'cv.valorprazo,'
      '    '#9#9#9#9'cv.quantidade,'
      '               (select pc.produtomonstruario '
      '                from produtoscontratos pc'
      '                where pc.contrato = ct.numero'
      '                  and pc.produto = cv.produto'
      
        '                  and pc.filial = cv.filial limit 1) as produtom' +
        'onstruario,'
      '    '#9#9#9#9'cv.devolucao,'
      '                                ct.vendedor'
      ''
      
        '    '#9#9#9' FROM (contratos ct join contratosdevolvidos cv on ct.num' +
        'ero = cv.contrato)'
      
        '    '#9#9#9' WHERE (cv.devolucao BETWEEN :datainicial AND :datafinal)' +
        ' AND'
      '    '#9#9#9'       cv.tipo='#39'D'#39
      ''
      '    '#9#9#9#9'%FiltroContratos'
      '    '#9#9#9' )'
      '    '#9#9#9' union ALL'
      '    '#9#9#9' ('
      '                select pc.contrato,'
      '    '#9#9#9'         ct.filialvenda,'
      '    '#9#9#9#9' pc.produto,'
      '    '#9#9#9#9' pc.filial,'
      
        '                                 round(((pc.quantidade*pc.precov' +
        'enda)*ct.valorvista)/(ct.valorvista+ct.desconto),2) as valorvist' +
        'a,'
      
        '                                 round(((pc.quantidade*pc.precov' +
        'enda)*ct.valorprazo)/(ct.valorvista+ct.desconto),2) as valorpraz' +
        'o,'
      '    '#9#9#9#9' pc.quantidade,'
      '                pc.produtomonstruario,'
      '    '#9#9#9#9' cancelados.datapagto as devolucao,'
      '                                 ct.vendedor'
      
        '                                    from (select distinct ct.num' +
        'ero, p.datapagto'
      '    '#9#9#9#9'from contratos ct, parcelas p'
      '    '#9#9#9#9'where ct.numero=p.contrato and'
      '    '#9#9#9#9'      ct.situacao='#39'C'#39' and'
      '    '#9#9#9#9'      not exists (select p2.numero'
      '    '#9#9#9#9'                  from parcelas p2'
      '    '#9#9#9#9' '#9'          where p2.contrato = ct.numero and'
      '    '#9#9#9#9#9#9'        p2.tipopagto<>'#39'E'#39') and'
      
        '    '#9#9#9#9'      p.datapagto between :datainicial and :datafinal an' +
        'd'
      '    '#9#9#9#9#9'not exists (select cd.contrato'
      '    '#9#9#9#9#9#9#9'from contratosdevolvidos cd'
      '    '#9#9#9#9#9#9#9'where cd.contrato = ct.numero and'
      '    '#9#9#9#9#9#9#9#9'cd.tipo = '#39'D'#39')'
      '    '#9#9#9#9') as cancelados, contratos ct, produtoscontratos pc'
      '    '#9#9#9'  where cancelados.numero = ct.numero and'
      '    '#9#9#9'        cancelados.numero = pc.contrato'
      ''
      '    '#9#9#9#9'%FiltroContratos'
      '    '#9#9#9' )'
      '    '#9#9#9' order by contrato'
      '    '#9#9#9' )'
      '    '#9#9#9') AS faturados'
      '    WHERE pc.contrato = faturados.contrato and'
      '          pc.produto = faturados.produto and'
      '          pc.filial = faturados.filial'
      '      and coalesce(pc.vendedor, faturados.vendedor) = u.codigo'
      '      and not pc.brinde'
      ''
      '                           %FiltroProdutosContratos'
      ''
      '    ORDER BY pc.produto'
      '   )'
      '   union all'
      '   ('
      
        '    SELECT coalesce(pdf.vendedor, faturados.vendedor) as vendedo' +
        'r,'
      '           u.tipocomissao as tipobase,'
      '           faturados.nota as contrato,'
      '           faturados.filialvenda,'
      '           pdf.produto,'
      '           pdf.filial,'
      '           faturados.valorvista,'
      '           faturados.valorprazo,'
      '           pdf.quantidade,'
      '           pdf.produtomonstruario,'
      '           faturados.data as devolucao'
      ''
      '    FROM produtosdadosfiscais pdf, usuarios u,'
      '    '#9#9#9'('
      '    '#9#9#9'SELECT'
      '                               df.numero as dadofiscal,'
      
        '                               cast(coalesce('#39'NF '#39'||n.serie||'#39' '#39 +
        '||n.numero,'
      
        '                                             '#39'CP '#39'||c.maquina||'#39 +
        ' '#39'||c.intervensao||'#39' '#39'||c.numero) as varchar(25)) as nota,'
      '    '#9#9#9'       df.filialvenda,'
      '    '#9#9#9'       df.data,'
      '    '#9#9#9'       df.valortotal as valorprazo,'
      '    '#9#9#9'       df.valorvista,'
      '                               df.vendedor'
      ''
      
        '                               FROM dadosfiscais df left join no' +
        'tas n on df.numero = n.dadofiscal'
      
        '                                                          left j' +
        'oin cupons c on df.numero = c.dadofiscal'
      
        '                               WHERE (df.datacancelamento BETWEE' +
        'N :datainicial AND :datafinal)'
      '                                       AND df.contrato is null'
      '       '#9#9#9#9#9#9'           and ((mod(df.codigofiscal,1000) in ('
      '       '#9#9#9#9#9#9#9#9'%ListaCodigosFiscaisVenda'
      '       '#9#9#9#9#9#9#9#9')) or mod(df.codigofiscal,1000) in (929))'
      '                               %FiltroContratos'
      '                               ORDER BY df.numero'
      '    '#9#9#9') AS faturados'
      '    WHERE pdf.dadofiscal = faturados.dadofiscal'
      '      and coalesce(pdf.vendedor, faturados.vendedor) = u.codigo'
      '      and not coalesce(pdf.brinde,false)'
      ''
      '     %FiltroProdutosDadosFiscais'
      ''
      '    ORDER BY pdf.produto'
      ''
      '   )'
      ') as vendas'
      #9'join (produtos p'
      #9#9'join  ((caracteristicas c join grupos g on c.grupo = g.codigo)'
      #9#9#9#9#9'join classes cl on c.classe = cl.codigo)'
      #9#9'on p.caracteristica = c.codigo)'
      #9'on p.codigo = vendas.produto'
      ''
      #9'left join comissoesusuariosgrupos cug'
      #9'on cug.usuario = vendas.vendedor and cug.grupo = g.codigo'
      #9'left join comissoesusuariosclasses cuc'
      #9'on cuc.usuario = vendedor and cuc.classe = cl.codigo'
      'where (coalesce(cug.comissao,'
