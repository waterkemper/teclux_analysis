      ') AS vendas where percentual_ou_valor <> 0'
      ')'
      '%FINAL_ADICIONAL_PRODUTOS_VENDAS'
      '%UNION_ALL_FINAL_ADICIONAL_PRODUTOS_VENDAS'
      '%INICIO_ABATIMENTO_CREDITO_TROCA_ADICIONAL_PRODUTOS_VENDAS'
      '('
      'SELECT vendedor,'
      #9'cast('#39'CT '#39'||contrato as varchar(25)) as contrato,'
      #9'produto,'
      #9'filialvenda,'
      #9'faturamento,'
