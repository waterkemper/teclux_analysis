    Sql.Strings = (
      '('
      'select comissoes.vendedor,'
      '       comissoes.indicador,'
      #9'   comissoes.vendedorindicado,'
      #9'   u.nome as nomevendedorindicado,'
      '       comissoes.nome,'#9'   '
      '       comissoes.contrato,'
      
        '       case when :AgruparFilial then comissoes.filialvenda else ' +
        'cast(null as integer) end as filialvenda,'
      
        '       case when :AgruparFilial then comissoes.nomefilialvenda e' +
        'lse cast(null as varchar) end as nomefilialvenda,'
      
        '       case when :AgruparGrupoFilial then comissoes.grupofilialv' +
        'enda else cast(null as integer) end as grupofilialvenda,'
      
        '       case when :AgruparGrupoFilial then comissoes.nomegrupofil' +
        'ialvenda else cast(null as varchar) end as nomegrupofilialvenda,'
      '       comissoes.produto,'
      '       comissoes.nomeproduto,'
      '       comissoes.faturamento,'
      '       comissoes.evento,'
      '       sum(comissoes.Valor) as valor,'
      '       sum(comissoes.base) as base,'
      '       comissoes.tipobase,'
      '       comissoes.tipocomissao,'
      '       comissoes.nivelcomissao,'
      '       comissoes.percentual_ou_valor,'
      '       sum(comissoes.valorcomissao) as valorcomissao'
      'from'
      '('
      '  SELECT comissoes.vendedor,'
      '         comissoes.indicador,'
      '         usuarios.nome,'
      #9'     contrato,'
      
        '         case when :ExibirProduto then produto else cast(null as' +
        ' bigint) end as produto,'
      
        '         case when :ExibirProduto then nomeproduto else cast(nul' +
        'l as varchar(50)) end as nomeproduto,'
      #9#9' filialvenda,'
      #9#9' f.nome as nomefilialvenda,'
      #9#9' fgf.grupo as grupofilialvenda,'
      #9#9' gf.descricao as nomegrupofilialvenda,'
      #9#9' faturamento,'
      #9#9' evento,'
      #9#9' valor,'
      #9#9' base,'
      #9#9' tipobase,'
      #9#9' comissoes.vendedorindicado,'
      #9#9' comissoes.tipocomissao,'
      #9#9' nivelcomissao,'
      #9#9' '
      #9#9' case when produtomonstruario then'
      
        #9#9#9'percentual_ou_valor * cast(Parametros_Valor('#39'Percentual da co' +
        'miss'#227'o para produtos do monstru'#225'rio'#39',Filialvenda) as numeric) / ' +
        '100'
      #9#9' else'
      #9#9#9'percentual_ou_valor'
      #9#9' end as percentual_ou_valor,'
      #9#9' '
      #9#9' calculacomissao(evento, base, comissoes.tipocomissao,'
      #9#9#9#9#9#9#9' case when produtomonstruario then'
      
        #9#9#9#9#9#9#9'   percentual_ou_valor * cast(Parametros_Valor('#39'Percentua' +
        'l da comiss'#227'o para produtos do monstru'#225'rio'#39',Filialvenda) as nume' +
