function TdtmComissaoVendedores.GerarComissaoVendedores: boolean;
begin
  case FResumo of
  0:begin
     if parametroalterado or
        not qryComissoes.Active or
        not qryResumoFolha.Active then
     begin
       ReFazConsulta(qryComissoes,[],[]);
       Refazconsulta(qryResumoFolha,[],[]);
     end;
    end;
  1: begin
       if parametroalterado or not qrycomissoes.Active then
       ReFazConsulta(qryComissoes,[],[]);
     end;
  2: begin
       if parametroalterado or not qryResumoFolha.Active then
       Refazconsulta(qryResumoFolha,[],[]);
     end;
  end;
  result := not qrycomissoes.IsEmpty or
            not qryResumoFolha.IsEmpty;
end;

procedure TdtmComissaoVendedores.SetParametroComissao(const Value: String);
begin
  if Value <> FParametroComissao then
    FParametroComissao := Value;
end;


procedure TdtmComissaoVendedores.SetParametroFimComissao(const Value: String);
begin
  if Value <> FParametroFimComissao then
    FParametroFimComissao := Value;
  if value<>'' then
    FParametrosCabecalho:=FParametrosCabecalho+' e '+Value;
end;

procedure TdtmComissaoVendedores.SetParametroInicioComissao(const Value: String);
begin
  if Value <> FParametroInicioComissao then
    FParametroInicioComissao := Value;
  if value <> '' then
   FParametrosCabecalho:=FParametrosCabecalho+' Comissao entre: '+Value;
end;

procedure TdtmComissaoVendedores.SetParametroVendedor(const Value: String);
begin
  if Value <> FParametroVendedor then
    FParametroVendedor := Value;

  if value<>'' then
    FParametrosCabecalho:=FParametrosCabecalho+' Vendedor: '+Value;

  qryComissoes.parambyname('pListaVendedores').asString := FParametroVendedor;


end;

procedure TdtmComissaoVendedores.ImprimirRelatorio;
begin
  frVariables['AgruparFilial']:= FAgruparFilial;
  frVariables['AgruparGrupoFilial']:= FAgruparGrupoFilial;
  frVariables['TotalizarBase']:= ParSistema.TotalizarBaseComissoes;;
  ImprimirRelatoriofast(null, FParametrosCabecalho, MPadrao, FResumo, [frpComissoes,frpResumoFolha],  false, self);
end;

procedure TdtmComissaoVendedores.SetOrdenacao(const Value: integer);
begin
  FOrdenacao := Value;
  qryResumoFolha.ParamByName('ordenacao').AsInteger:=value;
end;

procedure TdtmComissaoVendedores.frpComissoesBeforePrint(Memo: TStringList;
  View: TfrView);
begin
  inherited;  
  ZebrarLinhaRelatorio(frpComissoes,view);
end;

function TdtmComissaoVendedores.GetParametroAlterado: Boolean;
 procedure CopiarComissoes;
 var
  i:integer;
 begin
   for i:=0 to qryComissoes.MacroCount -1 do
     SQLComissoes.Macros[i].AsString := qryComissoes.Macros[i].AsString;
   for i:=0 to qryComissoes.ParamCount -1 do
     SQLComissoes.Params[i].AsString := qryComissoes.Params[i].AsString;
 end;

 function DiferencasComissoes:boolean;
 var
  i:integer;
 begin
   Result := False;
   for i:=0 to qryComissoes.MacroCount -1 do
     if qryComissoes.macros[i].AsString<>SQLComissoes.macros[i].AsString then
     begin
       result := true;
       break
     end;
   for i:=0 to qryComissoes.ParamCount -1 do
     if qryComissoes.params[i].asstring<>SQLComissoes.params[i].AsString then
     begin
       result := true;
       break
     end;
 end;

begin
  if SQLComissoes.Sql.Count = 0 then
  begin
    SQLComissoes.Sql := qryComissoes.Sql;
    CopiarComissoes;
    Result := true;
  end
  else
  begin
   if diferencascomissoes then
   begin
     CopiarComissoes;
     result := true;
   end
   else result := false;
  end;
end;


procedure TdtmComissaoVendedores.frpComissoesGetValue(
  const ParName: String; var ParValue: Variant);
begin
  inherited;
  if ParName = 'ExibirProdutos' then
