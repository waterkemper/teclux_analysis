    Macros = <>
    Sql.Strings = (
      'select * from'
      '('
      'select  count(*) as nusuarios, '
      '         descricao,'
      '         acesso '
      'from'
      '('
      '('
      'select   descricao,'
      '         acesso,'
      '         usuario'
      
        'from (usuariosacessosmodulos join  acessosmodulos on usuariosace' +
        'ssosmodulos.acesso = acessosmodulos.codigo)'
      'where usuariosacessosmodulos.usuario = :usuario'
      '  and not acessosmodulos.iteclux'
      ')'
      'union'
      '('
      'select descricao,'
      '         acesso,'
      '         u.codigo as usuario'
      
        'from ((gruposusuariosacessosmodulos join acessosmodulos on grupo' +
        'susuariosacessosmodulos.acesso = acessosmodulos.codigo)'
      
        '                                                     join usuari' +
        'os u on gruposusuariosacessosmodulos.grupo = u.grupo)'
      
        'where gruposusuariosacessosmodulos.grupo = (select grupo from us' +
        'uarios where codigo = :usuario) and u.codigo = :usuario'
      '  and not acessosmodulos.iteclux'
      ')'
      ') as acessos'
      'group by descricao, acesso'
      ') as nacessos'
      'where nusuarios = :nusuarios'
      'order by UPPER(TO_ASCII(descricao,'#39'LATIN1'#39'))')
