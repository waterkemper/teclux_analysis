  dataset := dtmNCM.qrySecoes;
  lblPastaTabelaIPI.Caption:= DirSugestao + '\';

end;

destructor TfrmNCM.Destroy;
begin
  dtmNCM:= nil;
  inherited;
  frmNCM:= nil;
end;

function TfrmNCM.ExisteInformacao(Parametro: Integer;
  NomeCampo: String; Value: Variant): Boolean;
begin
  result := dtmNCM.ExisteTabelaTipoPagamento(NomeCampo, Value)
end;

function TfrmNCM.InternoExcluir: Boolean;
begin
  result := false;
  if not ctrlon then
  begin
    result:= inherited InternoExcluir;
    if result then
      dtmNCM.ExcluirTiposPagamentos;
  end;
end;

function TfrmNCM.InternoGravar: Boolean;
begin
  Result:=inherited InternoGravar;
  if result then
    dtmNCM.GravarTiposPagamentos;
end;

function TfrmNCM.InternoIncluir: Boolean;
begin
  Result:= inherited InternoIncluir;
  if Result then
    if not CtrlOn then
      dtmNCM.IncluirTiposPagamentos;
end;

function TfrmNCM.InternoPesquisar(
  Titulo: String): Integer;
begin
  result:=0;
  if not CtrlOn then
  begin
    dtmNCM.Abre(ctConsultaTipoPagamento);
    result:=inherited internopesquisar('Tabela de Tipo de Pagamentos');
    if Result = mrOK then
       dtmNCM.PosicionarTabelaTiposPagamentos;

    dtmNCM.Fecha(ctConsultaTipoPagamento);
  end;

end;

function TfrmNCM.JanelaPesquisa: TfrmConsultaBasica;
begin
  Result:= TfrmConsultaPorCampo.Create(nil);
  TfrmConsultaPorCampo(result).ConsultaInterativa := True;
end;

function TfrmNCM.TabelaDePesquisa: TZDataSet;
begin
 result:=dtmNCM.ConsultaTabelaTiposPagamentos;
end;

