procedure TfrmNCM.ImportarAliquotasLei12741;
var Arquivo:     TextFile;
    ArqNome:     String;
    ArqPesquisa: TSearchRec;
    Linha:       String;


    {--------------------------- LAYOUT DO ARQUIVO -----------------------------}
    {                                                                           }
    {Codigo;Ex;NCMouNBS;AliqNacional;AliqImportado;Versão                       }
    {                                                                           }
    {Código:        Contém a  NCM - Nomenclatura comum do MERCOSUL              }
    {                      ou NBS - Nomenclatura brasileiro de serviços         }
    {                                                                           }
    {Ex:            Exceção fiscal da NCM ou TIPI                               }
    {                                                                           }
    {NCMouNBS:      Se "0", o código é NCM; se "1", é NBS                       }
    {                                                                           }
    {AliqNacional:  Alíquota para os produtos e serviços nacionais              }
    {                                                                           }
    {AliqImportado: Alíquota média para os produtos e serviços importados       }
    {                                                                           }
    {Versão:        Nº da versão disponibilizada                                }
    {---------------------------------------------------------------------------}




    function Campo(N1, N2: integer): string;  {Retorna o campo existente em linha}
    begin                                     {entre os ponto e vírgulas n1 e n2 }
       if N1 = 0
       then Result:= Trim(Copy(Linha,1,PosOcor(';',Linha,N2)-1))
       else if PosOcor(';',Linha,N1) + 1 = PosOcor(';',Linha,N2)
            then Result:= 'NULL'
            else if N2 <= PosOcor(';',Linha,0)
                 then Result:= Trim(Copy(Linha,PosOcor(';',Linha,N1) + 1,
                                               PosOcor(';',Linha,N2) -
                                               PosOcor(';',Linha,N1) - 1))
                 else Result:= Trim(Copy(Linha,PosOcor(';',Linha,N1) + 1,Length(Linha)));
    end; {Campo}


begin
   ArqNome:= 'AliquotasIBPT.csv';
   if FindFirst(lblPastaTabelaIPI.Caption + '\' + ArqNome,faArchive,ArqPesquisa) = 0
   then begin
      AssignFile(Arquivo, ArqNome);
      Reset(Arquivo);     SQL:= '';
      while not eof(Arquivo) do begin
         ReadLn(Arquivo, Linha);

         if Campo(2, 3) = '0' then begin          {Só serão importados para códigos NCM}
            SQL:= SQL + 'UPDATE NCMTabela SET AliqNacional = '        + Campo(3, 4) + ', '
                                           + 'AliqImportado = '       + Campo(4, 5)
                                           + ' WHERE CodigoTIPI = ''' + FStr(FLVal(Campo(0, 1)),$81) + ''' AND ExTIPI = ';

            if Campo(1, 2) = 'NULL' then SQL:= SQL + 'NULL;' + CrLf
                                    else SQL:= SQL + '''' + FStr(FLVal(Campo(1, 2)),$21) + ''';' + CrLf;
         end;
      end;
      CloseFile(Arquivo);

   end
   else MensagemErro('O arquivo "' + ArqNome + '" não foi encontrado');
   FindClose(ArqPesquisa);
end;



procedure TfrmNCM.ImportarDadosCapitulo(Secao, Capitulo: Integer);
var Arquivo:     TextFile;
    ArqNome:     String;
    ArqPesquisa: TSearchRec;

    CodigoTIPI:  String;
    Descricao:   String;
    ExTIPI:      String;
    Aliquota:    String;
    SouA:        Char;
    Primeiro:    Boolean;
    Linha:       string;



    function Campo(N1, N2: integer): string;        {Retorna o campo existente em linha}
    begin                                           {entre os caracteres TAB n1 e n2   }
       if N1 = 0
       then Result:= Trim(Copy(Linha,1,PosOcor(Tab,Linha,N2)-1))
       else if PosOcor(Tab,Linha,N1) + 1 = PosOcor(Tab,Linha,N2)
            then Result:= 'NULL'
            else if N2 <= PosOcor(Tab,Linha,0)
                 then Result:= Trim(Copy(Linha,PosOcor(Tab,Linha,N1) + 1,
                                               PosOcor(Tab,Linha,N2) -
                                               PosOcor(Tab,Linha,N1) - 1))
                 else Result:= Trim(Copy(Linha,PosOcor(Tab,Linha,N1) + 1,Length(Linha)));
    end; {Campo}


begin
   ArqNome:= 'Capitulo-' + FStr(Capitulo,$21) + '.TXT';
   if FindFirst(lblPastaTabelaIPI.Caption + '\' + ArqNome,faArchive,ArqPesquisa) = 0
   then begin
      AssignFile(Arquivo, ArqNome);
      Reset(Arquivo);

      Primeiro:= true;
      while not eof(Arquivo) do begin
         ReadLn(Arquivo, Linha);

         CodigoTIPI:= Campo(0, 1);
         if (Length(CodigoTIPI) = 5) and (Copy(CodigoTIPI,3,1) = '.')
         then Delete(CodigoTIPI,3,1);

         Descricao := Trocar(
                      Trocar(Campo(1, 2),#$A0, ''),        {#$0A lixo da tabela   }
                                         '''', '''''');    {Colocando aspas duplas}
         if Length(CodigoTIPI) = 10 then begin
            if PosOcor(Tab,Linha,0) = 3
            then ExTIPI:= Trocar('''' + Campo(3, 4) + '''','Ex ','')
            else ExTIPI:= 'NULL';

            SouA    := 'A';
            Aliquota:= Trocar(Campo(2, 3),#$A0,'');        {#$0A lixo da tabela}
            if Aliquota = 'NT' then Aliquota:= 'NULL';
         end
         else begin
            ExTIPI  := 'NULL';
            SouA    := 'S';
            Aliquota:= 'NULL';
         end;

         if Primeiro then begin
            Primeiro:= false;
            SQL:= SQL + 'DELETE FROM NCMTabela WHERE SUBSTRING(CodigoTIPI,1,2) = ' + FStr(Capitulo,$21) + ';' + CrLf
                                                                                                              + CrLf
                      + '-- Capítulo ' + FStr(Capitulo,$00) + ' - ' + Descricao    + CrLf;
         end;

         CodigoTIPI:= Trocar(Trocar(CodigoTIPI,'.',''),' ','');
         SQL:= SQL + 'INSERT INTO NCMTabela (Codigo, Secao, CodigoTIPI, ExTIPI, SouA, Descricao, Aliquota) ' +
                            'VALUES (NULL, ' + FStr(Secao,0) + ', ''' + CodigoTIPI + ''', '
                                             + ExTIPI        + ', ''' + SouA       + ''', '''
                                             + Descricao     + ''', ' + Aliquota   +  ');'   + CrLf;
      end;
      CloseFile(Arquivo);
      SQL:= SQL + CrLf + CrLf;
   end
   else MensagemErro('O arquivo "' + ArqNome + '" não foi encontrado');
   FindClose(ArqPesquisa);
end;




procedure TfrmNCM.ImportarDadosSecoes;
var Capitulo: Integer;
    Secao:    Integer;
begin
   if ckbMarcarTodasSecoes.Checked
   then SQL:= 'DELETE FROM NCMTabela;' + CrLf
                                       + CrLf +
              'ALTER SEQUENCE NCMTabela_ProximoCodigo RESTART 1' + CrLf
   else SQL:= '';


   for Secao:= 1 to 21 do with Secoes[Secao] do begin
       if TDBCheckBox('ckbSecao'  + FStr(Secao,$21)).Checked then begin
          SQL:= SQL + '-- SEÇÃO ' + Romano[Secao] + ' - ' + AnsiUpperCase(Descricao) + CrLf
                                                                                     + CrLf
                    + 'INSERT INTO NCMTabela (Codigo, Secao, CodigoTIPI, ExTIPI, SouA, Descricao, Aliquota) ' +
                              'VALUES (NULL, ' + FStr(Secao,0) + ', ''00'', NULL, ''S'', ''' + Descricao + ''', NULL);'
                    + CrLf + CrLf;

          for Capitulo:= CapInicial to CapFinal do
              ImportarDadosCapitulo(Secao, Capitulo);
       end;
  end;
end;


procedure TfrmNCM.ckbMarcarTodasSecoesClick(Sender: TObject);
var Secao: Integer;
begin
  inherited;
  for Secao:= 1 to 21 do
      TDBCheckBox('ckbSecao'  + FStr(Secao,$21)).Checked:= ckbMarcarTodasSecoes.Checked;
end;


begin {Iniciação da unit fmNCM}
   DirSugestao:= ExtractFilePath(Application.ExeName) + 'NCM';
end.
