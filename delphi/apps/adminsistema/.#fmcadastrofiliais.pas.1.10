function TfrmCadastroFiliais.TabelaDePesquisa: TZDataSet;
begin
  case TipoPesquisa of
    tpFILIAIS,
    tpFILIALCONTABILFILIAIS,
    tpFILIALMONTAGEMFILIAIS,
    tpFILIALCONSOLIDADORADIME : Result:= dtmCadastrosInternos.TabelaConsultaFilial;
    tpCOLUNASPRECONORMALFILIAIS,
    tpCOLUNASPRECOPROMOCAOFILIAIS : Result:= dtmCadastrosInternos.TabelaConsultaColuna;
  else
    Result := nil;
  end;
end;

function TfrmCadastroFiliais.TipoDePesquisa: string;
begin
  case TipoPesquisa of
    tpFILIAIS                    : Result:= 'Filial';
    tpFILIALCONTABILFILIAIS      : Result:= 'Filial Contábil';
    tpFILIALMONTAGEMFILIAIS      : Result:= 'Filial Montagem';
    tpFILIALCONSOLIDADORADIME    : Result:= 'Filial Consolidadora';
    tpCOLUNASPRECONORMALFILIAIS  : Result:= 'Coluna Preço Normal';
    tpCOLUNASPRECOPROMOCAOFILIAIS: Result:= 'Coluna Preço Promoção';
  end;
end;

procedure TfrmCadastroFiliais.edtSerieSugestaoMercadoriasExit(Sender: TObject);
begin
  inherited;
  if not dtmCadastrosInternos.ExisteSerieFilial(edtSerieSugestaoMercadorias.Text) then
  begin
    MensagemAviso('A série sugestão das mercadorias não está cadastrada.');
    edtSerieSugestaoMercadorias.SetFocus;
  end;

  if not dtmCadastrosInternos.ExisteSerieFilial(edtSerieSugestaoServicos.Text) then
  begin
    MensagemAviso('A série sugestão dos serviços não está cadastrada.');
    edtSerieSugestaoServicos.SetFocus;
  end;

end;

procedure TfrmCadastroFiliais.actAbilitarUpdate(Sender: TObject);
begin
  inherited;
  sbnExcluirSerieFilial.Enabled := not dtmCadastrosInternos.ExisteSerieFilialUtilizada;

  ckbSpedContribuicoesPisCofinsrb.Enabled := ckbIPI.Checked or ckbiss.Checked;
  if not ckbSpedContribuicoesPisCofinsrb.Enabled and ckbSpedContribuicoesPisCofinsrb.Checked then
    ckbSpedContribuicoesPisCofinsrb.Checked := false;

  ckbSpedContribuicoesPisCofinsrem.Enabled := ckbIPI.Checked or ckbiss.Checked;
  if not ckbSpedContribuicoesPisCofinsrem.Enabled and ckbSpedContribuicoesPisCofinsrem.Checked then
    ckbSpedContribuicoesPisCofinsrem.Checked := false;

end;

procedure TfrmCadastroFiliais.IncluirEditarFatoresPrecosFilial(Incluir: Boolean);
begin
  frmCadastroFatoresPrecos:= TfrmCadastroFatoresPrecos.Create(frmCadastroFatoresPrecos);
  dtmCadastrosInternos.IncluirFatoresPrecosFilial(Incluir);
  frmCadastroFatoresPrecos.ShowModal;
  frmCadastroFatoresPrecos.free;
end;

procedure TfrmCadastroFiliais.sbnIncluirFatorPrecoClick(Sender: TObject);
begin
  inherited;
  CtrlOn:= True;
  dbgFatoresPreco.SetFocus;
  InternoIncluir;
end;

procedure TfrmCadastroFiliais.sbnExcluirFatorPrecoClick(Sender: TObject);
begin
  inherited;
  CtrlOn:= True;
  dbgFatoresPreco.SetFocus;
  InternoExcluir;
end;

procedure TfrmCadastroFiliais.dbgFatoresPrecoDblClick(Sender: TObject);
begin
  inherited;
  IncluirEditarFatoresPrecosFilial(False);
end;

procedure TfrmCadastroFiliais.sbnSalvarClick(Sender: TObject);
begin
  if Trim(edtCNPJ.Text)<>'' then
  begin
    if edtCNPJ.Criticar then
    begin
     inherited;
     end;
  end
  else
    MensagemAviso('O CNPJ deve ser preenchido.');
end;

procedure TfrmCadastroFiliais.FormKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key=VK_F5 then
  begin
    if Trim(edtCNPJ.Text)<>'' then
    begin
      if edtCNPJ.Criticar then
      begin
        inherited;
      end;
    end
    else
    begin
      MensagemAviso('O CNPJ precisa ser preenchido.');
    end;
  end;
end;

procedure TfrmCadastroFiliais.sbnFilialConsolidadoraClick(Sender: TObject);
begin
  inherited;
  InternoPesquisar(flkFilialConsolidadora, ctFILIAIS)
end;


procedure TfrmCadastroFiliais.edfCodigoFound(Found: Boolean);
begin
  inherited;
  if dtmCadastrosInternos.OptantepeloSimples then
   gbxcreditoIcns.Visible := true
  else
    gbxcreditoIcns.Visible := False;
end;

procedure TfrmCadastroFiliais.rgpSimplesChange(Sender: TObject);
begin
  inherited;
  dtmCadastrosInternos.EstadoVAriavel;
  if dtmCadastrosInternos.OptantepeloSimples then
    gbxcreditoIcns.Visible:= True
  else
     gbxcreditoIcns.Visible := FAlse;
end;

procedure TfrmCadastroFiliais.dbgInstRespCadastroKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if CtrlOn then
  begin
    case Key of
      VK_F9 : begin
                 dbgInstRespCadastro.SetFocus;
                 AcionaPesquisaGrade;
               end;
    end;
  end
  else
  begin
    case key of
      VK_Return :
      begin
        case dbgInstRespCadastro.SelectedIndex of
        0 : begin
              if not fraInstRespAdmCadastro.edfCodigo.Exist then
              begin
                dbgInstRespCadastro.DataSource.DataSet.FieldByName('instituicao').Clear;
                dbgInstRespCadastro.DataSource.DataSet.FieldByName('codigo').Clear;
              end;

              dbgInstRespCadastro.SelectedIndex := 0;
              dbgInstRespCadastro.SetFocus;
            end;
        end;

        if dtmCadastrosInternos.qryRespAdmCadastro.State in [dsedit, dsinsert] then
           dtmCadastrosInternos.qryRespAdmCadastro.Post;
      end;
    end;
  end;
end;

procedure TfrmCadastroFiliais.AcionaPesquisaGrade;
begin
  if dbgInstRespCadastro.Focused then
  begin
    fraInstRespAdmCadastro.CtrlOn := True;
    fraInstRespAdmCadastro.InternoPesquisar('Resp. Adm. Cadastro');
    dbgInstRespCadastro.SetFocus;
    dbgInstRespCadastro.SelectedIndex :=  0;
  end;
end;

procedure TfrmCadastroFiliais.fraIESubstTributario1dsrIESubstTributarioDataChange(
  Sender: TObject; Field: TField);
begin
  inherited;
  fraIESubstTributario1.dsrIESubstTributarioDataChange(Sender, Field);

end;

procedure TfrmCadastroFiliais.ckbSpedContribuicoesPisCofinsrbClick(
  Sender: TObject);
begin
  inherited;
  if ckbSpedContribuicoesPisCofinsrb.checked and ckbSpedContribuicoesPisCofinsrem.checked then
    ckbSpedContribuicoesPisCofinsrem.checked := false;

end;

procedure TfrmCadastroFiliais.ckbSpedContribuicoesPisCofinsremClick(
  Sender: TObject);
begin
  inherited;
  if ckbSpedContribuicoesPisCofinsrb.checked and ckbSpedContribuicoesPisCofinsrem.checked then
    ckbSpedContribuicoesPisCofinsrb.checked := false;

end;

end.
