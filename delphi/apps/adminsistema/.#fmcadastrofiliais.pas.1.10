  fmcadastrofatoresprecosfilial;

{$R *.dfm}

constructor TfrmCadastroFiliais.Create(AOwner: TComponent);
begin
  if Not Assigned(dtmCadastrosInternos) then
    dtmCadastrosInternos := TdtmCadastrosInternos.Create(Application);

  inherited Create(AOwner);

  dtmCadastrosInternos.Abre(ctCadastroFiliais);

  DataSet := dtmCadastrosInternos.TabelaFiliais;
  pgcFiliais.ActivePage := tstIdentificacao;
  if Assigned(edtCNPJ.Field) then
    edtCNPJ.Field.EditMask := MascaraPessoaJuridica;
  pgcFiliais.ActivePage:= tstIdentificacao;
  gbxcreditoIcns.Visible:= False;
//  tstContabil.TabVisible := ParSistema.GerarContabilidade;


  fraInstRespAdmCadastro := TfraConsultaCodigoContabil.Create(self);
  fraInstRespAdmCadastro.Name := 'fraInstRespAdmCadastro';
  fraInstRespAdmCadastro.edfCodigo.MaxLength := 2;
  fraInstRespAdmCadastro.edfCodigo.DataSource := dtmCadastrosInternos.dsrRespAdmCadastro;
  fraInstRespAdmCadastro.edfCodigo.DataField := 'instituicao';
  fraInstRespAdmCadastro.edfCodigo.Operacao := opATRIBUICAO;
  fraInstRespAdmCadastro.edfCodigo.LookupSource := fraInstRespAdmCadastro.dsrProcuraInstRespAdmCadastro;
  fraInstRespAdmCadastro.edfCodigo.LookupField := 'codigo';
  fraInstRespAdmCadastro.edfCodigo.LookupQueryParameter := 'codigo';
  fraInstRespAdmCadastro.AbrirTabelaProcura := false;
  fraInstRespAdmCadastro.TipoPesquisa := pesINSTRESPADMCADASTRO;

  fraConsultaClassificacaoIPI.TipoPesquisa := pesCLASSIFICACAOIPI;

  edfCodigo.SetFocus;
  edfcodigo.SelectAll;

end;

procedure TfrmCadastroFiliais.dbgSeriesFiliaisDblClick(Sender: TObject);
begin
  inherited;
  IncluirEditarSerieFilial(False);
end;

destructor TfrmCadastroFiliais.Destroy;
begin
  dtmCadastrosInternos.Fecha(ctCadastroFiliais);
  inherited;
  frmCadastroFiliais := nil;
end;

function TfrmCadastroFiliais.ExisteInformacao(Parametro: Integer; NomeCampo: String; Value: Variant): Boolean;
begin
  case TipoPesquisa of
    tpFILIAIS,
    tpFILIALCONTABILFILIAIS,
    tpFILIALMONTAGEMFILIAIS      : Result:= dtmCadastrosInternos.ExisteFilial(NomeCampo, Value);
    tpCOLUNASPRECONORMALFILIAIS,
    tpCOLUNASPRECOPROMOCAOFILIAIS: Result:= dtmCadastrosInternos.ExisteColunas(NomeCampo,Value);
  else
    Result := False;
  end;
end;

procedure TfrmCadastroFiliais.IncluirEditarSerieFilial(Incluir: Boolean);
begin
  if not assigned(frmCadastroSeriesFilial) then
    frmCadastroSeriesFilial := TfrmCadastroSeriesFilial.Create(frmCadastroSeriesFilial);

  if Incluir then
    dtmCadastrosInternos.IncluirSerieFilial
  else
    dtmCadastrosInternos.qrySeriesFiliais.Edit;
  frmCadastroSeriesFilial.ShowModal;

  frmCadastroSeriesFilial.free;
end;

function TfrmCadastroFiliais.InternoCancelar: Boolean;
begin
  Result := inherited InternoCancelar;
  dtmCadastrosInternos.CancelarSerieFilial;
end;

function TfrmCadastroFiliais.InternoExcluir: Boolean;
begin
  Result:= True;
//  Result := inherited InternoExcluir;
//  if Result then begin
    if not CtrlOn then
         dtmCadastrosInternos.ExcluirFilial
    else begin
      if dbgSeriesFiliais.Focused then dtmCadastrosInternos.ExcluirSerieFilial
      else if dbgFatoresPreco.Focused then dtmCadastrosInternos.ExcluirFatoresPrecosFilial;
    end;
//  end;
end;

function TfrmCadastroFiliais.InternoGravar: Boolean;
begin
  Result:= True;
  edtInscricaoEstadual.Estado:= fraEnderecoEditorFilial.edtEstado.Text;
  if edtInscricaoEstadual.Criticar then
  begin
   Result:= inherited InternoGravar;
   if Result then
    if edfCodigo.Text <> '' then
       dtmCadastrosInternos.GravarFiliais(StrToInt(edfCodigo.Text))
    else dtmCadastrosInternos.GravarFiliais(0);
  end
  else
    edtInscricaoEstadual.SetFocus;
end;

function TfrmCadastroFiliais.InternoIncluir: Boolean;
begin
  Result:= inherited InternoIncluir;
  if Result then begin
    if CtrlOn then begin
      if dbgSeriesFiliais.Focused then IncluirEditarSerieFilial(True)
      else if dbgFatoresPreco.Focused then IncluirEditarFatoresPrecosFilial(True);
    end
    else dtmCadastrosInternos.IncluirFiliais;
  end;
  CtrlOn:= False;
end;

function TfrmCadastroFiliais.InternoPesquisar(Titulo:String): Integer;
begin
  Result:= mrNone;
  TipoPesquisa:= tpFILIAIS;

  if CtrlOn then begin
    if flkFilialMontagem.Focused      then
      TipoPesquisa:= tpFILIALMONTAGEMFILIAIS
    else if flkFilialContabil.Focused then
      TipoPesquisa:= tpFILIALCONTABILFILIAIS
    else if flkPrecoNormal.Focused    then
      TipoPesquisa:= tpCOLUNASPRECONORMALFILIAIS
    else if flkPrecoPromocao.Focused  then
      TipoPesquisa:= tpCOLUNASPRECOPROMOCAOFILIAIS
    else if flkFilialConsolidadora.Focused then
      TipoPesquisa := tpFILIALCONSOLIDADORADIME;

    if TipoPesquisa <> tpFILIAIS then
      if ActiveControl is TtecFindCustom then begin
        dtmCadastrosInternos.AbreTabelasConsulta(TipoPesquisa);
        Result := inherited InternoPesquisar(TipoDePesquisa);
        if Result  = mrok then
          dtmCadastrosInternos.Selecionar(TipoPesquisa);
        dtmCadastrosInternos.FechaTabelasConsulta(TipoPesquisa);
      end;
//    CtrlOn:= False;
  end
  else begin
    TipoPesquisa:= tpFILIAIS;
    dtmCadastrosInternos.AbreTabelasConsulta(TipoPesquisa);
    titulo := TipoDePesquisa;
    Result := inherited InternoPesquisar(titulo);
    if Result  = mrok then
      dtmCadastrosInternos.Selecionar(TipoPesquisa);
    dtmCadastrosInternos.FechaTabelasConsulta(TipoPesquisa);
  end;
end;

function TfrmCadastroFiliais.JanelaPesquisa: TfrmConsultaBasica;
begin
  Result := TfrmConsultaPorCampo.Create(nil);
  TfrmConsultaPorCampo(Result).ConsultaInterativa := True;
  TfrmConsultaPorCampo(Result).UsarParametrosDaTabela := False;
end;

procedure TfrmCadastroFiliais.KeyDown(var Key: Word; Shift: TShiftState);
begin
  case key of
//   VK_ESCAPE: InternoCancelar;
    VK_Return: if (Shift = []) then begin
                 if ActiveControl = edtRazaoQuitacao then begin
                    pgcFiliais.ActivePage := tstParametros;
                    rgpTipoFilial.SetFocus;
                    Key:= MAXWORD;
                 end
                 else if ActiveControl = edtDASPRemetente then begin
                   pgcFiliais.ActivePage := tstColunasPrecos;
                   flkPrecoNormal.SetFocus;
                   Key:= MAXWORD;
                 end else if ActiveControl = flkPrecoPromocao then begin
                   pgcFiliais.ActivePage := tstCotacoesMoedas;
                   dbgFatoresPreco.SetFocus;
                   Key:= MAXWORD;
                 end else if ActiveControl = dbgFatoresPreco then begin
                   pgcFiliais.ActivePage := tstInformacoesFiscais;
                   rgpPorte.SetFocus;
                   Key:= MAXWORD;
                 end else if ActiveControl = edtInicioAtividades then begin
                   pgcFiliais.ActivePage := tstIdentificacao;
                   edtCNPJ.SetFocus;
                   Key:= MAXWORD;
                 end;
               end;
    VK_F2: if (Shift = [ssCtrl]) then
              if dbgSeriesFiliais.Focused then IncluirEditarSerieFilial(False)
              else if dbgFatoresPreco.Focused then IncluirEditarFatoresPrecosFilial(False);
  end;
  inherited;
end;

procedure TfrmCadastroFiliais.sbnExcluirSerieFilialClick(Sender: TObject);
begin
  inherited;
  CtrlOn := True;
  dbgSeriesFiliais.SetFocus;
  InternoExcluir
end;

