function TfrmCadastroFiliais.TabelaDePesquisa: TZDataSet;
begin
  case TipoPesquisa of
    tpFILIAIS,
    tpFILIALCONTABILFILIAIS,
    tpFILIALMONTAGEMFILIAIS,
    tpFILIALCONSOLIDADORADIME : Result:= dtmCadastrosInternos.TabelaConsultaFilial;
    tpCOLUNASPRECONORMALFILIAIS,
    tpCOLUNASPRECOPROMOCAOFILIAIS : Result:= dtmCadastrosInternos.TabelaConsultaColuna;
  else
    Result := nil;
  end;
end;

function TfrmCadastroFiliais.TipoDePesquisa: string;
begin
  case TipoPesquisa of
    tpFILIAIS                    : Result:= 'Filial';
    tpFILIALCONTABILFILIAIS      : Result:= 'Filial Contábil';
    tpFILIALMONTAGEMFILIAIS      : Result:= 'Filial Montagem';
    tpFILIALCONSOLIDADORADIME    : Result:= 'Filial Consolidadora';
    tpCOLUNASPRECONORMALFILIAIS  : Result:= 'Coluna Preço Normal';
    tpCOLUNASPRECOPROMOCAOFILIAIS: Result:= 'Coluna Preço Promoção';
  end;
end;

procedure TfrmCadastroFiliais.edtSerieSugestaoMercadoriasExit(Sender: TObject);
begin
  inherited;
  if not dtmCadastrosInternos.ExisteSerieFilial(edtSerieSugestaoMercadorias.Text) then
  begin
    MensagemAviso('A série sugestão das mercadorias não está cadastrada.');
    edtSerieSugestaoMercadorias.SetFocus;
  end;

  if not dtmCadastrosInternos.ExisteSerieFilial(edtSerieSugestaoServicos.Text) then
  begin
    MensagemAviso('A série sugestão dos serviços não está cadastrada.');
    edtSerieSugestaoServicos.SetFocus;
  end;

end;

procedure TfrmCadastroFiliais.actAbilitarUpdate(Sender: TObject);
begin
  inherited;
  sbnExcluirSerieFilial.Enabled := not dtmCadastrosInternos.ExisteSerieFilialUtilizada;

  ckbSpedContribuicoesPisCofinsrb.Enabled := ckbIPI.Checked or ckbiss.Checked;
  if not ckbSpedContribuicoesPisCofinsrb.Enabled and ckbSpedContribuicoesPisCofinsrb.Checked then
    ckbSpedContribuicoesPisCofinsrb.Checked := false;

  ckbSpedContribuicoesPisCofinsrem.Enabled := ckbIPI.Checked or ckbiss.Checked;
  if not ckbSpedContribuicoesPisCofinsrem.Enabled and ckbSpedContribuicoesPisCofinsrem.Checked then
    ckbSpedContribuicoesPisCofinsrem.Checked := false;

  tstSpedReinf.TabVisible := ckbMaodeObra.Checked;

end;

