procedure TfrmCadastroFiliais.sbnSalvarClick(Sender: TObject);
begin
  if Trim(edtCNPJ.Text)<>'' then
  begin
    if edtCNPJ.Criticar then
    begin
     inherited;
     end;
  end
  else
    MensagemAviso('O CNPJ deve ser preenchido.');
end;

procedure TfrmCadastroFiliais.FormKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if Key=VK_F5 then
  begin
    if Trim(edtCNPJ.Text)<>'' then
    begin
      if edtCNPJ.Criticar then
      begin
        inherited;
      end;
    end
    else
    begin
      MensagemAviso('O CNPJ precisa ser preenchido.');
    end;
  end;
end;

