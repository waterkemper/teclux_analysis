procedure TfrmCadastroFiliais.dbgInstRespCadastroKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if CtrlOn then
  begin
    case Key of
      VK_F9 : begin
                 dbgInstRespCadastro.SetFocus;
                 AcionaPesquisaGrade;
               end;
    end;
  end
  else
  begin
    case key of
      VK_Return :
      begin
        case dbgInstRespCadastro.SelectedIndex of
        0 : begin
              if not fraInstRespAdmCadastro.edfCodigo.Exist then
              begin
                dbgInstRespCadastro.DataSource.DataSet.FieldByName('instituicao').Clear;
                dbgInstRespCadastro.DataSource.DataSet.FieldByName('codigo').Clear;
              end;

              dbgInstRespCadastro.SelectedIndex := 0;
              dbgInstRespCadastro.SetFocus;
            end;
        end;

        if dtmCadastrosInternos.qryRespAdmCadastro.State in [dsedit, dsinsert] then
           dtmCadastrosInternos.qryRespAdmCadastro.Post;
      end;
    end;
  end;
end;

procedure TfrmCadastroFiliais.AcionaPesquisaGrade;
begin
  if dbgInstRespCadastro.Focused then
  begin
    fraInstRespAdmCadastro.CtrlOn := True;
    fraInstRespAdmCadastro.InternoPesquisar('Resp. Adm. Cadastro');
    dbgInstRespCadastro.SetFocus;
    dbgInstRespCadastro.SelectedIndex :=  0;
  end;
end;

