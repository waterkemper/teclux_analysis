procedure TfrmCadastroUsuarios.AcionarPesquisaGrade;
begin
  if dbgOperacoesdeProducao.SelectedIndex in [0..4] then
  begin
    dbgOperacoesdeProducao.SetFocus;
    ConsultaOperacoes.CtrlOn := True;
    ConsultaOperacoes.InternoPesquisar(ctOPERACOES);
    dbgOperacoesdeProducao.SetFocus;
    dbgOperacoesdeProducao.SelectedIndex :=  0;
  end
  else
  if dbgOperacoesdeProducao.SelectedIndex in [5..6] then
  begin
    dbgOperacoesdeProducao.SetFocus;
    ConsultaNiveisConhecimento.CtrlOn := True;
    ConsultaNiveisConhecimento.InternoPesquisar('Níveis de Conhecimento');
    dbgOperacoesdeProducao.SetFocus;
    dbgOperacoesdeProducao.SelectedIndex :=  5;
  end;
end;

procedure TfrmCadastroUsuarios.CondicoesOperacaoProducao;
const
  SQL = 'and (codigo not in (%s) or codigo = %s)';
var
  codigooperacao : String;
begin
   codigooperacao := inttostr(dtmCadastrosInternos.qryUsuariosOperacoesProducaooperacao.Asinteger);
   if (dtmCadastrosInternos.qryUsuariosOperacoesProducao.State = dsInsert) or
      (dtmCadastrosInternos.qryUsuariosOperacoesProducaodescricaonivelconhecimento.AsString='') then
     codigooperacao := '0';

   ConsultaOperacoes.qryProcuraOperacoes.MacroByName('SQLOperacoesJaSelecionadas').AsString :=
     format(SQL,[dtmCadastrosInternos.ListaOperacoesSelecionadas, codigooperacao]);

   ConsultaOperacoes.qryConsultaOperacoes.MacroByName('SQLOperacoesJaSelecionadas').AsString :=
     format(SQL,[dtmCadastrosInternos.ListaOperacoesSelecionadas, codigooperacao]);
end;

procedure TfrmCadastroUsuarios.AtribuirDadosOperacaoProducao;
begin
  with dtmCadastrosInternos do
  begin
    EditarUsuariosOperacaoProducao;
    qryUsuariosOperacoesProducaooperacao.AsString := ConsultaOperacoes.qryProcuraOperacoescodigo.AsString;
    qryUsuariosOperacoesProducaonome.AsString := ConsultaOperacoes.qryProcuraOperacoesnome.AsString;
    qryUsuariosOperacoesProducaoc01.AsString := ConsultaOperacoes.qryProcuraOperacoesc01.AsString;
    qryUsuariosOperacoesProducaoc02.AsString := ConsultaOperacoes.qryProcuraOperacoesc02.AsString;
    qryUsuariosOperacoesProducaoc03.AsString := ConsultaOperacoes.qryProcuraOperacoesc03.AsString;
    qryUsuariosOperacoesProducaodescricaooperacao.AsString := ConsultaOperacoes.qryProcuraOperacoesdescricao.AsString;
//    qryUsuariosOperacoesProducao.Post;
  end;
end;

procedure TfrmCadastroUsuarios.dbgOperacoesdeProducaoKeyDown(
  Sender: TObject; var Key: Word; Shift: TShiftState);
begin
//  if Shift = [ssCtrl] then
  if CtrlOn then
  begin
    case Key of
      VK_F9     : begin
                     ConsultaOperacoes.CtrlOn := true;
                     AcionarPesquisaGrade
                   end;
    end;
  end
  else if Shift = [] then
  case Key of
    VK_Return: if dbgOperacoesdeProducao.SelectedIndex in [0..2] then
                   dbgOperacoesdeProducao.SelectedIndex := dbgOperacoesdeProducao.SelectedIndex + 1
                else
                if dbgOperacoesdeProducao.SelectedIndex = 3 then
                begin
                  if not VerificarOperacoes then
                  begin
                    key := 0;
                  end
                  else
                    dbgOperacoesdeProducao.SelectedField := dtmCadastrosInternos.qryUsuariosOperacoesProducaonivelconhecimento;
                end
                else
                if dbgOperacoesdeProducao.SelectedIndex = 5 then
                begin
                  if ConsultaNiveisConhecimento.edfCodigo.Exist then
                  begin
                     AtribuirDadosNiveisConhecimento;
                     dtmCadastrosInternos.GravarUsuariosOperacaoProducao;
                  end
                  else
                  begin
                    dbgOperacoesdeProducao.SetFocus;
                    dbgOperacoesdeProducao.SelectedField := dtmCadastrosInternos.qryUsuariosOperacoesProducaonivelconhecimento;
                    key := 0;
                  end
               end

  end;


  inherited;

end;

procedure TfrmCadastroUsuarios.AtribuirDadosNiveisConhecimento;
begin
  with dtmCadastrosInternos do
  begin
    EditarUsuariosOperacaoProducao;
    qryUsuariosOperacoesProducaonivelconhecimento.AsInteger := ConsultaNiveisConhecimento.qryProcuraNiveislConhecimentocodigo.AsInteger;
    qryUsuariosOperacoesProducaodescricaonivelconhecimento.AsString := ConsultaNiveisConhecimento.qryProcuraNiveislConhecimentodescricao.AsString;
//    qryUsuariosOperacoesProducao.Post;
  end;

end;

function TfrmCadastroUsuarios.VerificarOperacoes: boolean;
begin
  result := true;
//  ConsultaOperacoes.edfCodigo.DoExit;
  ConsultaOperacoes.qryProcuraOperacoes.ParamByName('codigo').asinteger := 0;
  ConsultaOperacoes.qryProcuraOperacoes.ParamByName('nome').AsString :=
    dtmCadastrosInternos.qryUsuariosOperacoesProducaonome.AsString;

  ConsultaOperacoes.qryProcuraOperacoes.ParamByName('c01').AsString :=
    dtmCadastrosInternos.qryUsuariosOperacoesProducaoc01.AsString;

  ConsultaOperacoes.qryProcuraOperacoes.ParamByName('c02').AsString :=
    dtmCadastrosInternos.qryUsuariosOperacoesProducaoc02.AsString;

  ConsultaOperacoes.qryProcuraOperacoes.ParamByName('c03').AsString :=
    dtmCadastrosInternos.qryUsuariosOperacoesProducaoc03.AsString;

  ConsultaOperacoes.qryProcuraOperacoes.Close;
  ConsultaOperacoes.qryProcuraOperacoes.open;

  if not ConsultaOperacoes.qryProcuraOperacoes.IsEmpty then
    AtribuirDadosOperacaoProducao
  else
  begin
    ShowMessage(Format(ctCODIGOINEXISTENTE, ['['+
    dtmCadastrosInternos.qryUsuariosOperacoesProducaonome.AsString +', '+
    dtmCadastrosInternos.qryUsuariosOperacoesProducaoc01.AsString  +', '+
    dtmCadastrosInternos.qryUsuariosOperacoesProducaoc02.AsString  +', '+
    dtmCadastrosInternos.qryUsuariosOperacoesProducaoc03.AsString  +']']));
    result := false;
    dbgOperacoesdeProducao.SetFocus;
  end;
end;

