procedure TfrmCadastroUsuarios.Habilitar(Valor: Boolean);
var
  a: Integer;
begin
  Valor := Not Valor;
  for a := 0 to gbxPerfil.ControlCount - 1 do
    if gbxPerfil.Controls[a] is  TDBCheckBox then
      TDBCheckBox(gbxPerfil.Controls[a]).ReadOnly := Valor;
  flkGrupoUsuarios.ReadOnly        := Valor;
  dbgComissoesVendas.ReadOnly      := Valor;
  dbgComissoesCobranca.ReadOnly    := Valor;
  dbgMetasUsuarios.ReadOnly        := Valor;
  dbgUsuariosSetores.ReadOnly      := Valor;
  edtCodigoFolha.ReadOnly          := Valor;
  edtInativo.ReadOnly              := Valor;
  rbnPrazo.Enabled                 := Valor;
  rbnVista.Enabled                 := Valor;
  edtOperador.ReadOnly             := Valor;
  flkFiltroSAC.ReadOnly            := Valor;
  edtLigacao.ReadOnly              := Valor;
  sbnIncluirComissoes.Enabled      := Valor;
  sbnExcluirComissoes.Enabled      := Valor;
  sbnIncluirMetas.Enabled          := Valor;
  sbnExcluirMetas.Enabled          := Valor;
  sbnIncluirSetor.Enabled          := Valor;
  sbnExcluirSetor.Enabled          := Valor;
  sbnProcuraGruposUsuarios.Enabled := Valor;
end;

