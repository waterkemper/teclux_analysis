begin
  if UsuarioLogin.Administrador or UsuarioLogin.Suporte then begin
    if not Assigned (frmCadastroComissoesVendasUsuarios) then
      frmCadastroComissoesVendasUsuarios:= TfrmCadastroComissoesVendasUsuarios.Create(frmCadastroComissoesVendasUsuarios);
    frmCadastroComissoesVendasUsuarios.SetDataModulo(dtmCadastrosInternos);
