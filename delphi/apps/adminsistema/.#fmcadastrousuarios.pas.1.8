    dtmCadastrosInternos.IncluirComissoesUsuarios(Editar);
    frmCadastroComissoesVendasUsuarios.ShowModal;
    frmCadastroComissoesVendasUsuarios.Free;
  end
end;

procedure TfrmCadastroUsuarios.AcionaCadastroMetas(Editar: Boolean);
