function TfrmCadastroUsuarios.GravarUsuarioItecLUX: Boolean;
var Controle: TWinControl;
begin
  if (edtSenhaitecLUX.Modified or edtConfirmaSenhaitecLUX.Modified) then
  begin
    Result := ecvValidacaoSenhaIteclux.Verify(gbxIteclux, Controle);
    if Result then
    begin
      if (Trim(edtSenhaitecLUX.Text) <> Trim(edtConfirmaSenhaitecLUX.Text)) then
      begin
        Result := False;
        MensagemAviso(ctSENHASDIFERENTES);
        edtSenhaitecLUX.SetFocus;
      end;
      if Result then
      begin
        dtmCadastrosInternos.GravarUsuarioItecLux(edtUsuarioitecLUX.Text, edtSenhaitecLUX.Text);
        Result := True;
      end;
    end;
  end
  else
    Result := true;
end;

