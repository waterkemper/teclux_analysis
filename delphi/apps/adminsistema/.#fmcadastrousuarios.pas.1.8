    dtmCadastrosInternos.EditarUsuarios;
end;

function TfrmCadastroUsuarios.ExisteInformacao(Parametro: Integer;
  NomeCampo: String; Value: Variant): Boolean;
begin
  case TipoPesquisa of
    tpUSUARIO: Result:= dtmCadastrosInternos.ExisteUsuario(Parametro, NomeCampo, Value);
    tpFILIAL : Result:= dtmCadastrosInternos.ExisteFilial(NomeCampo, Value);
    tpFILTRO : Result:= dtmCadastrosInternos.ExisteFiltroSAC(Parametro, NomeCampo, Value);
    tpGRUPOSUSUARIOS:Result:= dtmCadastrosInternos.ExisteGrupoUsuarios(NomeCampo, Value);
  else
    Result:= False;
  end;
end;

function TfrmCadastroUsuarios.InternoExcluir: Boolean;
begin
  Result:= False;
  if not CtrlOn then begin
    Result:= inherited InternoExcluir;
    if Result then begin
      dtmCadastrosInternos.ExcluirUsuario(Trim(edtLogin.Text));
      LimparControlesSenha;
    end
  end
end;

function TfrmCadastroUsuarios.InternoGravar: Boolean;
var
  Controle: TWinControl;
begin
  Result:= True;
  if (ActiveControl is TtecFindCustom) and (Trim(TtecFindCustom(ActiveControl).Text) <> '') then
    Result:= TtecFindCustom(ActiveControl).Exist;
  if dtmCadastrosInternos.EditandoUsuario or ecvValidacaoUsuario.Verify(gbxUsuario, Controle) then
  begin
    if (edtSenha1.Modified or edtSenha2.Modified) then
      if (Trim(edtSenha1.Text) <> Trim(edtSenha2.Text)) then
      begin
        MensagemAviso(ctSENHASDIFERENTES);
        Result := False
      end else
        Result := ecvValidacaoSenha.Verify(gbxUsuario, Controle);
    if JaTestouEmail or EmailValido(edtEmail.Text) then
    begin
      if FUsuarioJaCadastrado and (edtUsuarioitecLUX.Text <> '') then
        Result := GravarUsuarioItecLUX;
      if Result then
        Result := inherited InternoGravar;
      if Result then
      begin
//        dtmCadastrosInternos.Email:=edtEmail.Text;
       // dtmCadastrosInternos.UsuarioEmail:=edtUsuarioEmail.Text;
        if edtSenhaEmail.Modified then
          dtmCadastrosInternos.SenhaEmail := edtSenhaEmail.Text;
       // dtmCadastrosInternos.HostPop:=edtHostPop.Text;
       // dtmCadastrosInternos.PortaPop:=edtPortaPop.Text;
       // dtmCadastrosInternos.HostSmtp:=edtHostSmtp.Text;
       // dtmCadastrosInternos.PortaSmtp:=edtPortaSmtp.Text;
          Result:= dtmCadastrosInternos.GravarUsuario(Trim(edtLogin.Text), Trim(edtSenha1.Text));
          LimparControlesSenha;
          FUsuarioJaCadastrado := Result;
      end
    end
  end
end;

function TfrmCadastroUsuarios.InternoIncluir: Boolean;
begin
  Result:= False;
  if not CtrlOn then
  begin
    FUsuarioJaCadastrado := False;
    Result := inherited InternoIncluir;
    if Result then
    begin
      LimparControlesSenha;
      dtmCadastrosInternos.IncluirUsuario;
    end;
    edtNome.SetFocus;
  end
end;

function TfrmCadastroUsuarios.InternoPesquisar(Titulo:String): Integer;
begin
  Result:= mrNone;
  if CtrlOn then
  begin
    if UsuarioLogin.Administrador or UsuarioLogin.Suporte then
    begin
      if flkFiltroSAC.Focused then
      begin
        TipoPesquisa:= tpFILTRO;
        Titulo := 'Filtros SAC';
      end else if flkGrupoUsuarios.Focused then
      begin
        TipoPesquisa:= tpGRUPOSUSUARIOS;
        Titulo := 'Grupos de Usuários';
      end;

      if ActiveControl is TtecFindCustom then
      begin
        dtmCadastrosInternos.AbreTabelasUsuarios(TipoPesquisa);
        Result := inherited InternoPesquisar(Titulo);
        if Result  = mrok then
          dtmCadastrosInternos.SelecionarUsuario(TipoPesquisa);
        dtmCadastrosInternos.FechaTabelasUsuarios(TipoPesquisa);
      end
    end
  end else
  begin
    TipoPesquisa:= tpUSUARIO;
    dtmCadastrosInternos.AbreTabelasUsuarios(TipoPesquisa);
    Result := inherited InternoPesquisar('Usuários');
    if Result  = mrok then 
      dtmCadastrosInternos.SelecionarUsuario(TipoPesquisa);
    dtmCadastrosInternos.FechaTabelasUsuarios(TipoPesquisa);
  end;
end;

