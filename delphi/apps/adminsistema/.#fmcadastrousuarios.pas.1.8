procedure TfrmCadastroUsuarios.AcionaCadastroComissoesCobranca;
begin
  if UsuarioLogin.Administrador or UsuarioLogin.Suporte then begin
    if (dtmCadastrosInternos.NrRegistrosCobranca > 0) then begin
      if not Assigned (frmCadastroComissoesCobrancaUsuarios) then
        frmCadastroComissoesCobrancaUsuarios:= TfrmCadastroComissoesCobrancaUsuarios.Create(frmCadastroComissoesCobrancaUsuarios);
      frmCadastroComissoesCobrancaUsuarios.SetDataModulo(dtmCadastrosInternos);
      frmCadastroComissoesCobrancaUsuarios.DataSet:= dtmCadastrosInternos.TabelaComissoesCobranca;
      dtmCadastrosInternos.IncluirComissoesCobranca(True);
      frmCadastroComissoesCobrancaUsuarios.ShowModal;
      frmCadastroComissoesCobrancaUsuarios.Free;
    end else
      MensagemAviso('Nenhum evento definido para a cobrança.')
  end
end;

