                    Hint = 
                      #201' o procedimento padr'#227'o de emiss'#227'o da NF-e com transmiss'#227'o da NF' +
                      '-e para a SEFAZ da UF onde o emissor est'#225' estabelecido para obte' +
                      'r a autoriza'#231#227'o de uso. O DANFE ser'#225' impresso em papel comum ap'#243 +
