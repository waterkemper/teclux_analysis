procedure TfrmConfiguracoesSistema.ApagarECF;
var
  ArquivoCFG: TIniFile;
  NomeArquivoCliente: String;
begin
  NomeArquivoCliente := (*ExtractFilePath(Application.ExeName)+*) NomeArquivoCFG;
  if FileExists(NomeArquivoCliente) then
  begin
    ArquivoCFG := TIniFile.Create(NomeArquivoCliente);
    try
{$IFDEF LINUX}
      ArquivoCFG.CaseSensitive := False;
{$ENDIF}
      ArquivoCFG.EraseSection(ECFSection);
      ArquivoCFG.UpdateFile;
      ECFLocalizada          := False;
      cmbECF.ItemIndex       := -1;
      edtPortaSerial.Text    := '';
      lblMarca1.Caption      := '';
      lblSerieECF1.Caption   := '';
      lblNumeroECF1.Caption  := '';
      Comm                   := '';
//      sbnApagar.Enabled      := False;
    finally
      ArquivoCFG.Free
    end
  end
end;

procedure TfrmConfiguracoesSistema.cmbModeloImpressoraChequeChange(Sender: TObject);
begin
  inherited;
  cmbTipoPorta.Enabled            := cmbModeloImpressoraCheque.ItemIndex > 0;
  edtNumeroPortaImpCheque.Enabled := cmbModeloImpressoraCheque.ItemIndex > 0;
  if Not edtNumeroPortaImpCheque.Enabled then
    edtNumeroPortaImpCheque.Clear
end;

constructor TfrmConfiguracoesSistema.Create(AOwner: TComponent);
var
  a: Integer;
begin
  inherited;
  qryContingencias.Open;
  qryContingencias.Last;

  for a := Low(ECFS) to High(ECFS) do
    cmbECF.Items.Add(ECFS[a]);
  cmbECF.Enabled := UsuarioLogin.LoginUsuario = 'tecsoft';

  cmbImpEtiqueta.Items.Clear;
  cmbImpNotaFiscalMercadorias.Items.Clear;
  cmbImpNotaFiscalServicos.Items.Clear;

  cmbImpContrato.Items.Clear;
  cmbImpCarne.Items.Clear;
  cmbImpBoleto.Items.Clear;
  cmbImpFechamentoCaixa.Clear;

  cmbImpOSP.Items.clear;
  cmbImpSetupProcesso.Items.clear;
  cmbImpControleProcesso.Items.clear;


  cmbImpEtiqueta.Items.Add  (ctImpDefault);
  cmbImpNotaFiscalMercadorias.Items.Add(ctImpDefault);
  cmbImpNotaFiscalServicos.Items.Add(ctImpDefault);
  cmbImpContrato.Items.Add(ctImpDefault);
  cmbImpCarne.Items.Add     (ctImpDefault);
  cmbImpBoleto.Items.Add    (ctImpDefault);
  cmbImpFechamentoCaixa.Items.Add(ctImpDefault);

  cmbImpOSP.Items.Add(ctImpDefault);
  cmbImpSetupProcesso.Items.Add(ctImpDefault);
  cmbImpControleProcesso.Items.Add(ctImpDefault);

  gbxImpressorasIndustria.Visible := ParSistema.ControlesVoltadosparaIndustria;

  for a := 0 to Printer.Printers.Count - 1 do
  begin
    cmbImpEtiqueta.Items.add  (Printer.Printers[a]);
    cmbImpNotaFiscalMercadorias.Items.Add(Printer.Printers[a]);
    cmbImpNotaFiscalServicos.Items.Add(Printer.Printers[a]);
    cmbImpContrato.Items.Add(Printer.Printers[a]);
    cmbImpCarne.Items.Add     (Printer.Printers[a]);
    cmbImpBoleto.Items.Add    (Printer.Printers[a]);
    cmbImpFechamentoCaixa.Items.Add(printer.Printers[a]);
    cmbImpOSP.Items.Add(printer.Printers[a]);
    cmbImpSetupProcesso.Items.Add(printer.Printers[a]);
    cmbImpControleProcesso.Items.Add(printer.Printers[a]);
  end;

  tstNFe.Enabled := ParSistema.EmissorNfe;
{$IFDEF MSWINDOWS}
  gbxTEF.Visible := True;
  pgcTipoTEF.ActivePageIndex := rgpTipoTEF.ItemIndex;
{$ENDIF}

  LerArquivoINI;
  backupAquivo;
  pgcPreferencias.ActivePageIndex:=0;
end;

procedure TfrmConfiguracoesSistema.LerArquivoINI;
var
  ArquivoCFG: TIniFile;
//  SerieNumero,
  ModeloImpCheque,
  TipoPorta,
  NumeroPorta,
  strFrenteCaixa: String;
//  PosECFS,
//  PosSeparador: Integer;
  TipoTEF: Integer;
{
  function PosMarca: Integer;
  var
    a: Integer;
  begin
    Result := -1;
    for a := Low(ECFS) to High(ECFS) do
      if ECFS[a] = lblMarca1.Caption then
      begin
        Result := a;
        break
      end
  end;
}
begin
  if FileExists(NomeArquivoCFG) then
  begin
     ArquivoCFG := TIniFile.Create(NomeArquivoCFG);
    try
{$IFDEF LINUX}
      ArquivoCFG.CaseSensitive := False;
{$ENDIF}
      if ArquivoCFG.SectionExists(ECFSection) then
      begin
        edtPortaSerial.Text := ArquivoCFG.ReadString(ECFSection, 'porta', '');
{        lblMarca1.Caption     := ArquivoCFG.ReadString(ECFSection, 'marca', '');
        PosECFS               := PosMarca;
        if PosECFS >= Low(ECFS) then
          cmbECF.ItemIndex := PosECFS - 1;
        SerieNumero           := ArquivoCFG.ReadString(ECFSection, 'controle', '');
        PosSeparador          := Pos(';', SerieNumero);
        if PosSeparador > 0 then begin
          lblSerieECF1.Caption  := Descriptografar(Copy(SerieNumero, 1, PosSeparador-1));
          Delete(SerieNumero, 1, PosSeparador);
          PosSeparador           := Pos(';', SerieNumero);
          lblNumeroECF1.Caption := Copy(SerieNumero, 1, PosSeparador-1);
          if PosSeparador > 0 then begin
            Comm := Copy(SerieNumero, PosSeparador+1, Length(SerieNumero) - PosSeparador);
            edtPortaSerial.Text   := Comm;
          end
        end;
}
//      sbnApagar.Enabled := (SerieNumero <> '') and (PosSeparador > 0) and (Comm <> '');
      end;

{$IFDEF MSWINDOWS}
      if ArquivoCFG.SectionExists(TEFSection) then  // TEF
      begin
        TipoTEF := ArquivoCFG.ReadInteger(TEFSection,'Tipo',0);
        rgpTipoTEF.ItemIndex := TipoTef;
        pgcTipoTEF.ActivePageIndex := TipoTEF;
        case TipoTEF of
          1 : begin  // DISCADO
                edtNroViasTEF.Text         := ArquivoCFG.ReadString(TEFSection,'Vias'   ,'');
                lblTEFArqRequisicao.Caption:= ArquivoCFG.ReadString(TEFSection,'DirReq' ,'');
                lblTEFArqResposta.Caption  := ArquivoCFG.ReadString(TEFSection,'DirResp','');
                lblTEFArqPrograma.Caption  := ArquivoCFG.ReadString(TEFSection,'Exec'   ,'');
              end;
          2 : begin  // DEDICADO
                edtLojaTEF.Text     := ArquivoCFG.ReadString(TEFSection,'Loja'    ,'');
                edtMensagemTEF.Text := ArquivoCFG.ReadString(TEFSection,'Mensagem','');
                edtIPTEF.Text       := ArquivoCFG.ReadString(TEFSection,'IP'      ,'');
                edtTerminalTEF.Text := ArquivoCFG.ReadString(TEFSection,'Terminal','');
              end;

        end;
      end;
{$ENDIF}

      if ArquivoCFG.SectionExists(IMPCHQSection) then begin
        ModeloImpCheque := ArquivoCFG.ReadString(IMPCHQSection, 'marca', '');
        TipoPorta       := ArquivoCFG.ReadString(IMPCHQSection, 'tipoporta', '0');
        NumeroPorta     := ArquivoCFG.ReadString(IMPCHQSection, 'numeroporta', '');
        if ModeloImpCheque = lstImpressorasCheque[1] then
          cmbModeloImpressoraCheque.ItemIndex := 1
        else if ModeloImpCheque = lstImpressorasCheque[2] then
          cmbModeloImpressoraCheque.ItemIndex := 2
        else
          cmbModeloImpressoraCheque.ItemIndex := 0;
        if TipoPorta = cmbTipoPorta.Items[0] then
          cmbTipoPorta.ItemIndex := 0
        else if TipoPorta = cmbTipoPorta.Items[1] then
          cmbTipoPorta.ItemIndex := 1;
        edtNumeroPortaImpCheque.Text := NumeroPorta;
      end;
      edtMaxColAutenticadora.Text := ArquivoCFG.ReadString(LoginSection, 'MaxColAutenticadora', '48');
      if ArquivoCFG.SectionExists(FrenteCaixaSection) then begin
        strFrenteCaixa := ArquivoCFG.ReadString(FrenteCaixaSection, 'trabalharcomo', '');
      end;

      rbnArgox.    Checked:= ParSistema.TipoImpressoraEtiqueta = ctARGOX;
      rbnJato.     Checked:= ParSistema.TipoImpressoraEtiqueta = ctJATO;
      rbnMatricial.Checked:= ParSistema.TipoImpressoraEtiqueta = ctMATRICIAL;
      rbnRabbit.   Checked:= ParSistema.TipoImpressoraEtiqueta = ctRABBIT;
      rbnZebra.    Checked:= ParSistema.TipoImpressoraEtiqueta = ctZEBRA;
      rbnNenhum.   Checked:= ParSistema.TipoImpressoraEtiqueta = ctNENHUMA;

     if parsistema.NomeImpressoraEtiqueta <> '' then
        cmbImpEtiqueta.ItemIndex := cmbImpEtiqueta.Items.IndexOf(parsistema.NomeImpressoraEtiqueta);

     if parsistema.NomeImpressoraNotaMercadorias <> '' then
        cmbImpNotaFiscalMercadorias.itemIndex := cmbImpNotaFiscalMercadorias.Items.IndexOf(parsistema.NomeImpressoraNotaMercadorias);

     if parsistema.NomeImpressoraNotaServicos <> '' then
        cmbImpNotaFiscalServicos.itemIndex := cmbImpNotaFiscalServicos.Items.IndexOf(parsistema.NomeImpressoraNotaServicos);


     if ParSistema.NomeImpressoraContrato <> '' then
        cmbImpContrato.ItemIndex := cmbImpContrato.Items.IndexOf(ParSistema.NomeImpressoraContrato);

     ckbImprimirCarneECF.Checked := ArquivoCFG.ReadBool(ImpressoraSection, 'imprimircarneecf', False);
     ckbImprimirLineFeedImpressoraMatricial.Checked := ArquivoCFG.ReadBool(ImpressoraSection, 'imprimirlinefeednaimpressoramatricial', False);

     if (not ckbImprimirCarneECF.Checked) and (parsistema.NomeImpressoraCarne <> '') then
        cmbImpCarne.itemIndex := cmbImpCarne.Items.IndexOf(parsistema.NomeImpressoraCarne);

     if parsistema.NomeImpressoraBoleto <> '' then
        cmbImpBoleto.itemIndex := cmbImpBoleto.Items.IndexOf(parsistema.NomeImpressoraBoleto);

     if parsistema.NomeImpressoraFechamentoCaixa <> '' then
        cmbImpFechamentoCaixa.itemIndex := cmbImpFechamentoCaixa.Items.IndexOf(parsistema.NomeImpressoraFechamentoCaixa);

     if parsistema.NomeImpressoraOSP <> '' then
        cmbImpOSP.itemIndex := cmbImpOSP.Items.IndexOf(parsistema.NomeImpressoraOSP);

     if parsistema.NomeImpressoraControleProcesso <> '' then
        cmbImpControleProcesso.itemIndex := cmbImpControleProcesso.Items.IndexOf(parsistema.NomeImpressoraControleProcesso);

     if parsistema.NomeImpressoraSetupProcesso <> '' then
        cmbImpSetupProcesso.itemIndex := cmbImpSetupProcesso.Items.IndexOf(parsistema.NomeImpressoraSetupProcesso);

     if parsistema.NomeImpressoraControleProcesso <> '' then
        cmbImpControleProcesso.itemIndex := cmbImpControleProcesso.Items.IndexOf(parsistema.NomeImpressoraControleProcesso);

     ckbAutenticarECF.Checked := ArquivoCFG.ReadBool(AutenticacaoSection, 'autenticarecf', False);
     rgpAutenticadoras.ItemIndex := ArquivoCFG.ReadInteger(AutenticacaoSection, 'autenticadora', 3)-1;

     if ParSistema.EmissorNfe and ArquivoCFG.SectionExists(NFeSection) then
     begin
       case ArquivoCFG.ReadInteger(NFeSection, 'Ambiente', 1) of
         1 : rbnNFeProducao.Checked         := True;
         2 : rbnNFeHomologacao.Checked      := True;
       end;
       case ArquivoCFG.ReadInteger(NFeSection, 'TipoEmissao', 1) of
         1 : rbnNFeNormal.Checked         := True;
         3 : begin
               rbnNFeContScan.OnClick := nil;
               rbnNFeContScan.Checked       := true;
               rbnNFeContScan.OnClick := rbnNFeContScanClick;
             end;
         4 : rbnNFeContEletronica.Checked := True;
       end;
       lblDirEnvio.Caption    := ArquivoCFG.ReadString(NFeSection,   'DirEnvio'   , '');
       lblDirRetorno.Caption  := ArquivoCFG.ReadString(NFeSection,   'DirRetorno' , '');
       lblDirEnviados.Caption := ArquivoCFG.ReadString(NFeSection,   'DirEnviados', '');
       lblDirErros.Caption    := ArquivoCFG.ReadString(NFeSection,   'DirErros'   , '');
       lblDirCompartilhamento.Caption := ArquivoCFG.ReadString(NFeSection, 'DirComp'   , '');
       lblNFeLogotipo.Caption := ArquivoCFG.ReadString(NFeSection,   'Logotipo'   , '');
       lblExecutavelUniNFe.Caption := ArquivoCFG.ReadString(NFeSection,   'ExecNFe'   , '');
       lblExecutavelUniDANFE.Caption := ArquivoCFG.ReadString(NFeSection, 'ExecDANFE'   , '');
       //ckbVisualizarImpressaoDANFE.Checked := ArquivoCFG.ReadBool(NFeSection, 'Visualizar', False);
       case ArquivoCFG.ReadInteger(NFeSection, 'Visualizar', 0) of
         0 : ckbVisualizarImpressaoDANFE.Checked := False;
         1 : ckbVisualizarImpressaoDANFE.Checked := True;
       end;
       edtNFeNVias.Text := ArquivoCFG.ReadString(NFeSection, 'NumVias', '1');
     end;

     lblDirPCP.          Caption := ArquivoCFG.ReadString(PCPSection,        'DirExp',              '');
     lblSPEDFiscal.      Caption := ArquivoCFG.ReadString(SpedSection,       'DirSpedFiscal',       '');
     lblSPEDContabil.    Caption := ArquivoCFG.ReadString(SpedSection,       'DirSpedContabil',     '');
     lblFCONT.           Caption := ArquivoCFG.ReadString(SpedSection,       'DirSpedFCont',        '');
     lblEFDContribuicoes.Caption := ArquivoCFG.ReadString(SpedSection,       'DirEFDContribuiçoes', '');
     lblDirExportacao.   Caption := ArquivoCFG.ReadString(ExportacaoSection, 'DirExportação',      '');


    finally
      ArquivoCFG.Free
    end
  end
end;

procedure TfrmConfiguracoesSistema.SalvarArquivo;
var
  ArquivoCFG: TIniFile;
//  ecfClass: TtecECFClass;
//  NroCripto: String;
begin
  if FileExists(NomeArquivoCFG) then
  begin
    ArquivoCFG := TIniFile.Create(NomeArquivoCFG);
    try
{$IFDEF LINUX}
      ArquivoCFG.CaseSensitive := False;
