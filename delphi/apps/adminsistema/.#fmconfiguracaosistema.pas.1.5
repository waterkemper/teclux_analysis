procedure TfrmConfiguracoesSistema.SalvarImpressoraCheque;
var
  ArquivoCFG: TIniFile;
  ImpChequeClass: TtecImpressoraChequePadraoClass;
begin
  if FileExists(NomeArquivoCFG) then begin
    ArquivoCFG := TIniFile.Create(NomeArquivoCFG);
    try
      if Assigned(ImpChequePadrao) then begin
        ImpChequePadrao.Free;
        ImpChequePadrao := nil
      end;
      if cmbModeloImpressoraCheque.ItemIndex > 0 then begin
        ImpChequeClass := TtecImpressoraChequePadraoClass(GetClass('TtecImpCheque'+lstImpressorasCheque[cmbModeloImpressoraCheque.ItemIndex]));

        if Assigned(ImpChequeClass) then begin
          ImpChequePadrao := ImpChequeClass.Create;
          if cmbTipoPorta.ItemIndex = 0 then
            ImpChequePadrao.PortaImpressao := pisSERIAL
          else
            ImpChequePadrao.PortaImpressao := pisPARALELA;
          ArquivoCFG.WriteString(IMPCHQSection, 'marca', lstImpressorasCheque[cmbModeloImpressoraCheque.ItemIndex]);
          ArquivoCFG.WriteString(IMPCHQSection, 'tipoporta', cmbTipoPorta.Items[cmbTipoPorta.ItemIndex]);
          if Trim(edtNumeroPortaImpCheque.Text) <> '' then begin
            ArquivoCFG.WriteString(IMPCHQSection, 'numeroporta', Trim(edtNumeroPortaImpCheque.Text));
            ImpChequePadrao.NumeroPorta := StrToInt(edtNumeroPortaImpCheque.Text)
          end else
          begin
            ArquivoCFG.WriteString(IMPCHQSection, 'numeroporta', '1');
            ImpChequePadrao.NumeroPorta := 1
          end;
        end
      end else if ArquivoCFG.SectionExists(IMPCHQSection) then
        ArquivoCFG.EraseSection(IMPCHQSection);
      ArquivoCFG.UpdateFile;
    finally
      ArquivoCFG.Free
    end
  end
end;

procedure TfrmConfiguracoesSistema.SalvarMiscelania;
var
  ArquivoCFG: TIniFile;
begin
  if FileExists(NomeArquivoCFG) then begin
    ArquivoCFG := TIniFile.Create(NomeArquivoCFG);
    try
      ArquivoCFG.UpdateFile;
    finally
      ArquivoCFG.Free
    end
  end
end;

