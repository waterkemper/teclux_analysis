procedure TfrmConfiguracoesSistema.VerificaECF;
var
  ecfClass: TtecECFClass;
//  ecf: TtecECF;
  Serie: String;
begin
{
  ECFLocalizada := False;
//  ecf           := nil;
  if cmbECF.ItemIndex >= 0 then
  begin
    try
      ecfClass := TtecECFClass(GetClass('TtecECF'+ ECFS[cmbECF.ItemIndex+1]));
      if not Assigned(ECFPadrao) then
        ECFPadrao := ecfClass.Create(Self)
      else
        ECFPadrao.Modelo := cmbECF.ItemIndex+1;
      if Trim(edtPortaSerial.Text) <> '' then
        ECFPadrao.Porta := 'COM' + edtPortaSerial.Text;

  //    if ECFPadrao.AcharECF(true,edtPortaSerial.Text = '') then
  //      ECFPadrao.Ativar;

      ECFPadrao.IniciarImpressora('COM'+Trim(edtPortaSerial.Text));
      if ECFPadrao.Erro then
        MensagemErro(ECFPadrao.Mensagem)
      else begin
        Serie  := ECFPadrao.SerieMaquina;
        if ECFPadrao.Erro then
          ECFPadrao.FinalizarImpressora
        else begin
          lblSerieECF1.Caption  := Serie;
          lblMarca1.Caption     := ECFS[cmbECF.ItemIndex+1];
          lblNumeroECF1.Caption := ECFPadrao.NumeroMaquina;
          Comm                  := ECFPadrao.PortaSerial;
          ECFLocalizada         := True
        end
      end;
      if ECFPadrao.Erro then
        FreeAndNil(ECFPadrao);
      if not Assigned(ECFPadrao) then
        MensagemAviso('Nenhuma ECF foi encontrada')
    except
      FreeAndNil(ECFPadrao);
      raise
    end
  end
}
end;

procedure TfrmConfiguracoesSistema.bbnOKClick(Sender: TObject);
 begin
  inherited;
//  qryContingencias.Last;
  if rbnNFeContScan.Checked
   and (qryContingenciasrazao.AsString='') then
  begin
    MensagemErro('Informe a razão da contingência');
    dbgContingencias.SetFocus;
    dbgContingencias.SelectedIndex := 1;
  end
  else
  begin
    try dmbasico.perpetrar([qryContingencias]);
    except end;
    if qryContingencias.RecNo <> qryContingencias.RecordCount then
      qryContingencias.Last;
    if rbnNFeContScan.Checked then
    begin
      ParSistema.DataHoraInicialContingencia := datetimetostr(qrycontingenciasdatahorainicial.asdatetime);
      ParSistema.RazaoContingencia := qryContingenciasrazao.AsString;
    end
    else
    begin
      ParSistema.DataHoraInicialContingencia := '';
      ParSistema.RazaoContingencia := '';
    end;
    SalvarArquivo;
  end;
end;

procedure TfrmConfiguracoesSistema.cancelar;
