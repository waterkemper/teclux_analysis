  if FileExists(NomeArquivoCFG) then
    DeleteFile(pChar(NomeArquivoCFG));
  FBackupAquivo.SaveToFile(NomeArquivoCFG);
  Close;
end;

procedure TfrmConfiguracoesSistema.backupAquivo;
