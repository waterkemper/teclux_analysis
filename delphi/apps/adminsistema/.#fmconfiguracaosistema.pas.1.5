procedure TfrmConfiguracoesSistema.rbnNFeContScanClick(Sender: TObject);
begin
  inherited;

  if rbnNFeContScan.Checked then
  begin
    //gbxContingencias.Enabled := true;
//    dbgContingencias.Enabled := TRUE;
    qryContingencias.AfterInsert := nil;

    if qryContingencias.State<>dsinsert then
    begin
      qryContingencias.Append;
      qryContingenciasdatahorainicial.AsDateTime := now();
      qryContingencias.DisableControls;
    end;

    qryContingenciasdatahorafinal.clear;

    dbgContingencias.SetFocus;
    dbgContingencias.SelectedIndex := 1;
    qryContingencias.AfterInsert := qryContingenciasAfterInsert;



  end;
end;

procedure TfrmConfiguracoesSistema.rbnNFeNormalClick(Sender: TObject);
begin
  inherited;
  if qryContingencias.State = dsinsert then
  begin
    qryContingencias.Cancel;
    qryContingencias.EnableControls;
  end
  else
  begin
    qryContingencias.Last;
    qryContingencias.Edit;
    qryContingenciasdatahorafinal.AsDateTime := now();
    dbgContingencias.SelectedIndex := 1;
    qryContingencias.EnableControls;
  end;

  //gbxContingencias.Enabled := false;
  //dbgContingencias.Enabled := false;


end;

procedure TfrmConfiguracoesSistema.qryContingenciasAfterInsert(
  DataSet: TDataSet);
begin
  inherited;
  qryContingencias.Cancel;
end;

