procedure TfrmExportacaoDados.CriarIntervalodeDatas;
begin
  if not Assigned(fraIntervaloDatasParametros)  then
  begin
    fraIntervaloDatasParametros := TfraIntervaloDatasParametros.Create(scrParametros);
//    fraIntervaloDatasParametros.dbcFormaSelecao.DataSource := dtmExportacaoDados.dsrParametrosSelecao;
//    fraIntervaloDatasParametros.dbcFormaSelecao.DataField := dtmExportacaoDados.qryParametrosSelecaointervalodatasformaselecao.FieldName;
  end;

  fraIntervaloDatasParametros.Top := altura;
  fraIntervaloDatasParametros.Parent := scrParametros;

  fraIntervaloDatasParametros.edtDataFinal.Maximo := fraIntervaloDatasParametros.edtDataFinal.Minimo;

  with dtmExportacaoDados do
  begin
    if not qryParametrosSelecaointervalodatasformaselecao.IsNull then
    begin
      fraIntervaloDatasParametros.dbcFormaSelecao.ItemIndex :=
         qryParametrosSelecaointervalodatasformaselecao.AsInteger ;
      fraIntervaloDatasParametros.edtDataInicial.Text :=
        qryParametrosSelecaointervalodatasdatainicial.asstring;
      fraIntervaloDatasParametros.edtDataFinal.Text :=
        qryParametrosSelecaointervalodatasdatafinal.asstring;
    end
    else
      fraIntervaloDatasParametros.dbcFormaSelecao.ItemIndex := 2;
