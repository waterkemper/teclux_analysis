procedure TfrmExportacaoDados.GuardarParametros;
begin
  with dtmExportacaoDados do
  begin
    if fSalvarParametros then
    begin
//      LimparParametrosSelecao;
      qryExportacaoFiltros.First;
      while not qryExportacaoFiltros.Eof do
      begin
        if (qryExportacaoFiltrosdescricao.AsString = 'INTERVALO DE DATAS') or
           (qryExportacaoFiltrosdescricao.AsString = 'INTERVALO DE DATAS 2') then
        begin
          if assigned(fraIntervaloDatasParametros) then
            SalvarIntervaloDatas(fraIntervaloDatasParametros.dbcFormaSelecao.ItemIndex,
                                 strtodate(fraIntervaloDatasParametros.edtDataInicial.Text),
                                 strtodate(fraIntervaloDatasParametros.edtDataFinal.Text))
        end
        else
        if qryExportacaoFiltrosdescricao.AsString = 'PARÂMETRO DATA' then
        begin
          if assigned(fraDataParametro) then
            SalvarData(fraDataParametro.dbcFormaSelecao.ItemIndex,
                                 strtodate(fraDataParametro.edtDataFinal.Text))
        end
        else
        if qryExportacaoFiltrosdescricao.AsString = 'LISTA DE CÓDIGOS FISCAIS' then
        begin
          if assigned(fraListaCodigosFiscais) then
          SalvarListadeCodigosFiscais(fraListaCodigosFiscais.ListaSelecionada)
        end
        else
        if qryExportacaoFiltrosdescricao.AsString = 'LISTA DE FILIAIS' then
        begin
          if assigned(fraListaFiliais) then
            SalvarListadeFiliais(fraListaFiliais.ListaSelecionada)
        end
        else
        if qryExportacaoFiltrosdescricao.AsString = 'LISTA DE SÉRIES' then
        begin
          if assigned(fraListaSeriesFiliais) then
            SalvarListaSeriesFiliais(fraListaSeriesFiliais.ListaSelecionada)
        end
        else
        if qryExportacaoFiltrosdescricao.AsString = 'LISTA DE NATUREZAS' then
        begin
          if assigned(fraListaNaturezas) then
            SalvarListaNaturezas(fraListaNaturezas.ListaSelecionada);
        end
        else
        if qryExportacaoFiltrosdescricao.AsString = 'LISTA DE CONTAS CONTÁBEIS' then
        begin
          if assigned(fraListaContasContabeis) then
            SalvarListadeContasContabeis(fraListaContasContabeis.StringSelecionada);
        end;
        qryExportacaoFiltros.Next;
      end;
    end;
  end;
end;

procedure TfrmExportacaoDados.ExportacaoTabelasBeforeScroll(
  Sender: TObject);
begin
  GuardarParametros;
end;

procedure TfrmExportacaoDados.sbnGerarClick(Sender: TObject);
var
  vReatualizarConsulta : Boolean;
begin
  inherited;
  try
    dtmExportacaoDados.ShowProcessando;
    vReatualizarConsulta := ckbReatualizarConsulta.Checked;
    ckbReatualizarConsulta.Checked := true;
    pgcCamposFiltrosSelecao.OnChange := nil;
    pgcCamposFiltrosSelecao.ActivePage := tstDados;
    pgcCamposFiltrosSelecao.OnChange := pgcCamposFiltrosSelecaoChange;
    with dtmExportacaoDados do
    begin
      GerandoArquivoTexto := true;
      qryExportacaoTabelas.First;
      while not qryExportacaoTabelas.Eof do
        qryExportacaoTabelas.Next;
      GerandoArquivoTexto := false;
    end;
  finally
    dtmExportacaoDados.ShowProcessando;
    ckbReatualizarConsulta.Checked := vReatualizarConsulta;
  end;
end;

