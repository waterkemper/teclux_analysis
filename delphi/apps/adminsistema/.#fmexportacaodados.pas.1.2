  end
end;

procedure TfrmExportacaoDados.MontarParametros;
var
  i: integer;
  filtro : String;
  ListaString : String;
begin
  filtro := '';
  altura := 0;

  if Assigned(fraIntervaloDatasParametros)  then
     fraIntervaloDatasParametros.Parent := tstParametros;

  if Assigned(fraDataParametro)  then
     fraDataParametro.Parent := tstParametros;

  if Assigned(fraListaCodigosFiscais)       then
     fraListaCodigosFiscais.Parent := tstParametros;

  if Assigned(fraListaFiliais)              then
  begin
     fraListaFiliais.Parent := tstParametros;
     ckbGerarArquivoPorFilial.Parent := tstParametros;
  end;

  if Assigned(fraListaSeriesFiliais)        then
     fraListaSeriesFiliais.Parent := tstParametros;

  if Assigned(fraListaNaturezas)            then
     fraListaNaturezas.Parent := tstParametros;

  if Assigned(fraListaContasContabeis)            then
     fraListaContasContabeis.Parent := tstParametros;

  scrParametros.BringToFront;

  with dtmExportacaoDados do
  begin
    fSalvarParametros := True;
    qryExportacaoFiltros.First;
    while not qryExportacaoFiltros.Eof do
    begin
      filtro := '';
      if (qryExportacaoFiltrosdescricao.AsString = 'INTERVALO DE DATAS') or
         (qryExportacaoFiltrosdescricao.AsString = 'INTERVALO DE DATAS 2') then
      begin
        CriarIntervalodeDatas;
        filtro := Format(qryExportacaoFiltrossql.AsString,[
           quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(fraIntervaloDatasParametros.edtDataInicial.text))),
           quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(fraIntervaloDatasParametros.edtDataFinal.text)))]);

         DataInicial := FormatDateTime('yyyy-mm-dd',strtodate(fraIntervaloDatasParametros.edtDataInicial.text));
         DataFinal := FormatDateTime('yyyy-mm-dd',strtodate(fraIntervaloDatasParametros.edtDataFinal.text));

        if qryExportacaoFiltrossqldescricao.AsString <> filtro then
        begin
          qryExportacaoFiltros.Edit;
          qryExportacaoFiltrossqldescricao.AsString := filtro;
          qryExportacaoFiltros.Post;
        end;
      end
      else
      if qryExportacaoFiltrosdescricao.AsString = 'PARÂMETRO DATA' then
      begin
        CriarParametroData;
        filtro := quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(fraDataParametro.edtDataFinal.text)));
        if qryExportacaoFiltrossqldescricao.AsString <> filtro then
        begin
          qryExportacaoFiltros.Edit;
          qryExportacaoFiltrossqldescricao.AsString := filtro;
          qryExportacaoFiltros.Post;
        end;
      end
      else
      if qryExportacaoFiltrosdescricao.AsString = 'LISTA DE CÓDIGOS FISCAIS' then
      begin
        CriarListadeCodigosFiscais;

        if fraListaCodigosFiscais.ListaSelecionada <> '' then
          filtro := Format(qryExportacaoFiltrossql.AsString,[
                            fraListaCodigosFiscais.ListaSelecionada]);

        if qryExportacaoFiltrossqldescricao.AsString <> filtro then
        begin
          qryExportacaoFiltros.Edit;
          qryExportacaoFiltrossqldescricao.AsString := filtro;
          qryExportacaoFiltros.Post;
        end;
      end
      else
      if qryExportacaoFiltrosdescricao.AsString = 'LISTA DE FILIAIS' then
      begin
        CriarListadeFiliais;
        if fraListaFiliais.ListaSelecionada <> ''  then
        begin
          filtro := format(qryExportacaoFiltrossql.AsString, [
                            fraListaFiliais.ListaSelecionada]);
          ListadeFiliais := fraListaFiliais.ListadeFiliaisSelecionadas;
        end
        else
          ListadeFiliais := fraListaFiliais.ListaGeraldeFiliais;

        if qryExportacaoFiltrossqldescricao.AsString <> filtro then
        begin
          qryExportacaoFiltros.Edit;
          qryExportacaoFiltrossqldescricao.AsString := filtro;
          qryExportacaoFiltros.Post;
        end;
      end
      else
      if qryExportacaoFiltrosdescricao.AsString = 'LISTA DE SÉRIES' then
      begin
        CriarListaSeriesFiliais;
        filtro :=  format(qryExportacaoFiltrossql.AsString, [
                         fraListaSeriesFiliais.ListaSelecionada]);

        if qryExportacaoFiltrossqldescricao.AsString <> filtro then
        begin
          qryExportacaoFiltros.Edit;
          qryExportacaoFiltrossqldescricao.AsString := filtro;
          qryExportacaoFiltros.Post;
        end;

      end
      else
      if qryExportacaoFiltrosdescricao.AsString = 'LISTA DE NATUREZAS' then
      begin
        CriarListaNaturezas;

        filtro := format(qryExportacaoFiltrossql.AsString, [
                     fraListaNaturezas.ListaSelecionada]);

        if qryExportacaoFiltrossqldescricao.AsString <> filtro then
        begin
          qryExportacaoFiltros.Edit;
          qryExportacaoFiltrossqldescricao.AsString := filtro;
          qryExportacaoFiltros.Post;
        end;

      end
      else
      if qryExportacaoFiltrosdescricao.AsString = 'LISTA DE CONTAS CONTÁBEIS' then
      begin
        CriarListaContasContabeis;

        ListaString := fraListaContasContabeis.StringSelecionada;
        if ListaString = '' then
          ListaString := '0';

        filtro := format(qryExportacaoFiltrossql.AsString, [
                     ListaString,
                     ListaString]);

        if qryExportacaoFiltrossqldescricao.AsString <> filtro then
        begin
          qryExportacaoFiltros.Edit;
          qryExportacaoFiltrossqldescricao.AsString := filtro;
          qryExportacaoFiltros.Post;
        end;

      end;
      qryExportacaoFiltros.Next;
    end;
  end;

end;

