procedure TfrmExportacaoDados.dbgCamposSelecionadosDragDrop(Sender,
  Source: TObject; X, Y: Integer);
var
 Coordenadas: TGridCoord;
 campo : String;
begin
  Coordenadas := THackGrid(dbgCamposSelecionados).MouseCoord(X,Y);
  if (Coordenadas.X > 0) AND (Coordenadas.Y > 0) then
  begin
    with THackGrid(dbgCamposSelecionados) do
    begin
      if not MovendodbgCamposSelecionados then
      begin
        dtmExportacaoDados.dsrExportacaoCampos.DataSet.MoveBy(Coordenadas.Y - row);
        campo := Columns.Items[-1 + Coordenadas.X].FieldName;
        if campo = 'campo' then
          dtmExportacaoDados.MoverCampos(true,false);
  //      dtmExportacaoDados.qryExportacaoCampos.Insert;
  //      Columns.Items[-1 + Coordenadas.X].Field.AsString := lNome;
      end
      else
      begin
        dtmExportacaoDados.MoverCampos(false,false);
        dtmExportacaoDados.dsrExportacaoCampos.DataSet.MoveBy(Coordenadas.Y - row);
        dtmExportacaoDados.MoverCampos(true,false);
      end;
    end;
  end;
end;

