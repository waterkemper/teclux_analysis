procedure TfrmExportacaoDados.AbrirExportacao;
begin
  dtmExportacaoDados.
        refazconsulta(dtmExportacaoDados.qryExportacao,[0],
             [ConsultaExportacao.ValorSelecionado]);
  edfCodigo.Text := ConsultaExportacao.ValorSelecionado;
  AtualizarParametros;
end;



constructor TfrmExportacaoDados.Create(AOwner: TComponent);
begin
  inherited;
  dtmExportacaoDados := TdtmExportacaoDados.Create(Self);
  DataSet := dtmExportacaoDados.qryExportacao;
  ConsultaExportacao := TfraConsultaCodigo.Create(self);
  ConsultaExportacao.edfCodigo.DataSource := dtmExportacaoDados.dsrExportacao;
  ConsultaExportacao.edfCodigo.DataField  := 'codigo';
  ConsultaExportacao.edfCodigo.Operacao   := opATRIBUICAO;
  ConsultaExportacao.AbrirTabelaProcura   := false;
  ConsultaExportacao.TipoPesquisa         := pesEXPORTACAODADOS;
  ConsultaExportacao.OnFound              := AbrirExportacao;
  dtmExportacaoDados.ExportacaoTabelasAfterScroll := ExportacaoTabelasAfterScroll;
  dtmExportacaoDados.ExportacaoTabelasBeforeScroll := ExportacaoTabelasBeforeScroll;
//  ObterLista(dtmExportacaoDados.ListaTabelas, clbTabelas);

  
end;

procedure TfrmExportacaoDados.ExportacaoTabelasAfterScroll(Sender: TObject);
begin
  MontarParametros;
  if pgcCamposFiltrosSelecao.ActivePage = tstDados then
    if ckbReatualizarConsulta.Checked then
      dtmExportacaoDados.MontarDados;
end;

function TfrmExportacaoDados.InternoExcluir: Boolean;
begin
  Result:= inherited InternoExcluir;
  if Result then begin
    if not CtrlOn then
      dtmExportacaoDados.ExcluirExportacao;
  end;
end;

function TfrmExportacaoDados.InternoGravar: Boolean;
begin
  Result:= inherited InternoGravar;
  if Result then
  begin
    GuardarParametros;
    MontarParametros;
    dtmExportacaoDados.GravarExportacao;
  end;
end;

function TfrmExportacaoDados.InternoIncluir: Boolean;
begin
  Result:= inherited InternoIncluir;
  if Result then begin
    if not CtrlOn then
    begin
      dtmExportacaoDados.IncluirExportacaoDados;
      edtDescricaoExportacao.SetFocus;
    end;
  end;
end;

procedure TfrmExportacaoDados.KeyDown(var Key: Word; Shift: TShiftState);
begin
  inherited;
  if not CtrlOn then
  begin
    if (key = VK_F9) then
    begin
      if sbnProcurar.Enabled then
      begin
        ConsultaExportacao.InternoPesquisar(ctEXPORTACAO);
        self.SetFocus;
      end
    end
    else
    if (key = VK_F7) then
    begin
      if sbnGerar.Enabled then
        sbnGerarClick(nil);
    end;
  end;
end;

