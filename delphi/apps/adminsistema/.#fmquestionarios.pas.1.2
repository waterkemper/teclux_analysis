  result := dtmDicionarioDados.GravarQuestionarios;
end;

function TfrmQuestionarios.InternoIncluir: Boolean;
begin

  if dtmDicionarioDados.AdicionarQuestionarios then
    DBMTipoQuestionario.setfocus;


end;

procedure TfrmQuestionarios.KeyDown(var Key: Word; Shift: TShiftState);
begin
  inherited;
  if not CtrlOn then
  begin
    if (key =VK_F9) then
      if sbnProcurar.Enabled then
         sbnProcurarClick(nil);
  end;

end;

