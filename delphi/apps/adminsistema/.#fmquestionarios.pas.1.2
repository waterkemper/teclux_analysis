procedure TfrmQuestionarios.DefinirMinDate;
begin
  if dtmDicionarioDados.qryQuestionarios.recordcount <> 0 then
  begin
    AdvDBDateTimePickerDataHoraInicial.MinDate := PrimeiroDiaAno(yearof(dtmDicionarioDados.qryQuestionariosdata_inicio.asDateTime));
    AdvDBDateTimePickerDataHoraInicial.DateTime := dtmDicionarioDados.qryQuestionariosdata_inicio.asDateTime;

    AdvDBDateTimePickerDataHoraFinal.mindate := UltimoDiaAno(yearof(dtmDicionarioDados.qryQuestionariosdata_inicio.asDateTime)+3);
    AdvDBDateTimePickerDataHoraFinal.datetime := dtmDicionarioDados.qryQuestionariosdata_fim.asDateTime;

    AdvDBDateTimePickerDataHoraInativacao.mindate := UltimoDiaAno(yearof(dtmDicionarioDados.DataServidor)+3);
    if not dtmDicionarioDados.qryQuestionariosdata_inativo.isnull then
      AdvDBDateTimePickerDataHoraInativacao.DateTime := dtmDicionarioDados.qryQuestionariosdata_inativo.asDateTime;

    if dtmDicionarioDados.qryQuestionarios.state = dsedit then
      dtmDicionarioDados.qryQuestionarios.post;  

  end;

end;

