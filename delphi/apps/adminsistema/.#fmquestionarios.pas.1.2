constructor TfrmQuestionarios.Create(AOwner: TComponent);
begin
  try
    if not assigned(dtmDicionarioDados) then
    begin
      dtmDicionarioDados := TdtmDicionarioDados.Create(self);
      dtmDicionarioDados.name := 'dtmDicionarioDados';
    end;

//    dtmDicionarioDados.owner := self;
    inherited;
    DataSet:= dtmDicionarioDados.qryQuestionarios;
    dtmDicionarioDados.AfterOpenQuestionarios := AfterOpenQuestionarios;
    dtmDicionarioDados.AfterOpenPerguntas := AfterOpenPerguntas;
    dtmDicionarioDados.AfterOpenRespostas := AfterOpenRespostas;
    dtmDicionarioDados.qryQuestionarios.open;

    ConsultaQuestionarios := TfraConsultaCodigo.Create(self);
    ConsultaQuestionarios.dtmDicionarioDados := dtmDicionarioDados;

    ConsultaQuestionarios.edfCodigo.DataSource := dtmDicionarioDados.dsrQuestionarios;
    ConsultaQuestionarios.edfCodigo.DataField := 'codigo';
    ConsultaQuestionarios.edfCodigo.Operacao := opATRIBUICAO;
    ConsultaQuestionarios.AbrirTabelaProcura := false;
    ConsultaQuestionarios.TipoPesquisa := pesQuestionarios;
    ConsultaQuestionarios.OnFound := DefinirMinDate;
    ConsultaQuestionarios.Name := 'fraConsultaQuestionarios';

//    edfCodigoQuestionario.SetFocus;

{
  AdvDBDateTimePickerDataHoraInicial.date := dtmDicionarioDados.DataServidor;
  AdvDBDateTimePickerDataHoraInicial.time := dtmDicionarioDados.HoraServidor;
  AdvDBDateTimePickerDataHoraInicial.datetime := dtmDicionarioDados.DataHoraServidor;
  }

  AdvDBDateTimePickerDataHoraInicial.MinDate := PrimeiroDiaAno(yearof(dtmDicionarioDados.DataServidor));

   {
  AdvDBDateTimePickerDataHoraFinal.date := dtmDicionarioDados.DataServidor;
  AdvDBDateTimePickerDataHoraFinal.time := dtmDicionarioDados.HoraServidor;
  AdvDBDateTimePickerDataHoraFinal.datetime := dtmDicionarioDados.DataHoraServidor;
  }

  AdvDBDateTimePickerDataHoraFinal.mindate := UltimoDiaAno(yearof(dtmDicionarioDados.DataServidor));

  {
  AdvDBDateTimePickerDataHoraInativacao.date := dtmDicionarioDados.DataServidor;
  AdvDBDateTimePickerDataHoraInativacao.time := dtmDicionarioDados.HoraServidor;
  AdvDBDateTimePickerDataHoraInativacao.datetime := dtmDicionarioDados.DataHoraServidor;
  }

  AdvDBDateTimePickerDataHoraInativacao.mindate := UltimoDiaAno(yearof(dtmDicionarioDados.DataServidor)+3);




  except
       on E: Exception do ShowMessage(E.Message);
  end;
end;

destructor TfrmQuestionarios.Destroy;
begin
  freeandnil(dtmDicionarioDados);
  inherited;
  frmQuestionarios := nil;
end;

