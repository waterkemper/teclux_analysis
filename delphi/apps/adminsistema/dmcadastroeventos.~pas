procedure TdtmCadastroEventos.CalcularTotalPercentual;
begin
  TotalPercentual := 0;
  GuardarRegistroAtual(qryEventosContasContabeis,true);
  qryEventosContasContabeis.first;
  while not qryEventosContasContabeis.eof do
  begin
    TotalPercentual := TotalPercentual + qryEventosContasContabeispercentual.AsCurrency;
    qryEventosContasContabeis.next;
  end;
  VoltarRegistroAtual(qryEventosContasContabeis);
end;

