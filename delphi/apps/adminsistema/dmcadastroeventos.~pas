function TdtmCadastroEventos.AbilitarAnalitica: Boolean;
begin
  qryEventosclassificacao.ReadOnly := false;
  qryEventostipo.ReadOnly := false;
  if (qryEventostipo.AsString = 'A') and
     (qryEventos.State = dsedit) and
     (qryEventosclassificacao.Value <> qryEventosclassificacao.OldValue) and
     (existeLancamento) then
    qryEventostipo.ReadOnly := true;

  PermitirExcluir := true;
  if (qryEventos.State = dsinsert) or
     (qryEventosclassificacao.Value <> qryEventosclassificacao.OldValue) then
  begin
    if NivelMascara > 1 then
    begin
      if NivelMascara = UltimoNivel then
        result := true
      else
      begin
        if (qryEventosVinculado_Sinteticasnsinteticasultima.AsInteger > 0) then
          result := false
        else
          result := true;
      end;
    end
    else
      result := false;

    if not result then
    begin
      if qryEventostipo.ReadOnly then
        result := true
      else
      if qryEventostipo.AsString <> 'S' then
        qryEventostipo.AsString := 'S'
    end;
  end
  else
  begin
    if NivelMascara > 1 then
    begin
      if (NivelMascara = UltimoNivel) then
        result := true
      else
      begin
        if (qryEventosVinculado_Sinteticasnsinteticasultima.AsInteger > 0) then
          result := false
        else
        if ((qryEventosVinculado_Sinteticasnsinteticasultima.AsInteger = 0) and
            (qryEventosVinculado_Sinteticasnanaliticasultima.AsInteger > 0)) and
            (qryEventostipo.asstring = 'S') then
          result := false
        else
          result := true;
      end;
    end
    else
      result := false;

    if qryEventosclassificacao.Value = qryEventosclassificacao.OldValue then
      if qryEventostipo.AsString = 'S' then
        if (qryEventosVinculado_Sinteticasnsinteticasultima.AsInteger > 0)or
           (qryEventosVinculado_Sinteticasnanaliticasultima.AsInteger > 0) then
        begin
          qryEventosclassificacao.ReadOnly := true;
          PermitirExcluir := false;
        end
  end;
end;

function TdtmCadastroEventos.AbilitarSintetica: Boolean;
begin
  if (qryEventos.State = dsinsert) or
     (qryEventosclassificacao.Value <> qryEventosclassificacao.OldValue) then
  begin
    if NivelMascara > 1 then
    begin
      if NivelMascara = UltimoNivel then
        result := false
      else
      begin
       if (qryEventosVinculado_Sinteticasnanaliticasultima.AsInteger > 0) then
         result := false
       else
         result := true;
      end;
    end
    else
      result := true;

    if qryEventostipo.ReadOnly then
      result := false;

    if not result then
      if qryEventostipo.AsString <> 'A' then
        qryEventostipo.AsString := 'A'

  end
  else
  begin
    if NivelMascara > 1 then
    begin
      if NivelMascara = UltimoNivel then
        result := false
      else
      begin
        if (qryEventosVinculado_Sinteticasnsinteticasultima.AsInteger > 0) then
          result := true
        else
        if (qryEventosVinculado_Sinteticasnsinteticasultima.AsInteger = 0) and
           (qryEventosVinculado_Sinteticasnanaliticasultima.AsInteger = 0) then
          result := true
        else
        if (qryEventosVinculado_Sinteticasnsinteticasultima.AsInteger = 0) and
           (qryEventosVinculado_Sinteticasnanaliticasultima.AsInteger = 1) and
           (qryEventostipo.AsString = 'A') and
           (not existeLancamento) then
          result := true
        else
          result := false;
      end;
    end
    else
      result := false;

    if qryEventostipo.ReadOnly then
      result := false;

  end;

end;

