procedure TdtmCadastroEventos.VerificarMascaraClassificacao(
  classificacao: String);
var
 vvinculados: String;

  function ClassificacaoNaoExistente: Boolean;
  begin
    result := true;
    qryEventosVinculado_Sinteticas.First;
    if qryEventos.State = dsinsert then
    begin
      while not qryEventosVinculado_Sinteticas.Eof do
      begin
        if (qryEventosVinculado_Sinteticasclassificacao.AsString = ultimaClassificacao) then
        begin
          result := false;
          break;
        end;
        qryEventosVinculado_Sinteticas.Next;
      end;
    end
    else
    begin
      while not qryEventosVinculado_Sinteticas.Eof do
      begin
        if ((qryEventosVinculado_Sinteticasclassificacao.AsString = penultimaClassificacao) and
            (qryEventostipo.AsString = 'A')) or
           ((qryEventosVinculado_Sinteticasclassificacao.AsString = ultimaClassificacao) and
            (qryEventostipo.AsString = 'S')) then
        begin
          result := false;
          break;
        end;
        qryEventosVinculado_Sinteticas.Next;
      end;
    end
  end;

begin
  if PossuiNumero(classificacao) and
     (pos(' .', classificacao)=0) then
  begin
    vvinculados := SelecionarVinculados(classificacao);
    if ((Vinculados <> vvinculados) and
        (vvinculados <> '0')) or (qryEventosVinculado_Sinteticas.recordcount=0) then
    begin
      Vinculados := vvinculados;
      if vinculados = '0' then
        Vinculados := quotedstr(vinculados);

      if (qryEventosclassificacao.Value <> qryEventosclassificacao.OldValue) then
         qryEventosVinculado_Sinteticas.params[1].Asinteger := qryEventoscodigo.AsInteger
      else
         qryEventosVinculado_Sinteticas.params[1].Asinteger := 0;

      if qryEventos.State = dsinsert then
        qryEventosVinculado_Sinteticas.params[0].AsString := ultimaclassificacao
      else
      if qryEventostipo.AsString = 'A' then
        qryEventosVinculado_Sinteticas.params[0].AsString := penultimaclassificacao
      else
        qryEventosVinculado_Sinteticas.params[0].AsString := ultimaclassificacao;

      qryEventosVinculado_Sinteticas.MacroByName('WhereClassificacao').AsString :=
        format(CondicaoClassificacao_Sintetica, [vinculados]);

      ReFazConsulta(qryEventosVinculado_Sinteticas,[],[]);

      if (not (qryEventosVinculado_Sinteticas.IsEmpty)) and
        (qryeventos.State=dsinsert) then
        NivelMascara := NivelMascara + 1;

      if (( (not (ClassificacaonaoExistente)) or
             qryEventosVinculado_Sinteticas.IsEmpty)
            and Inserindo) or
          ((not (ClassificacaonaoExistente)) and
            not Inserindo) then
      begin
        if Assigned(FEventosVinculado_SinteticasAfterOpen) then
          FEventosVinculado_SinteticasAfterOpen(qryEventosVinculado_Sinteticas);
      end;

      if VerificarClassificacao then
        if not PercorrendoPlanoContas then
          if ClassificacaonaoExistente then
            qryEventosDescricao.FocusControl;
    end;
  end
  else
  begin
    qryEventosVinculado_Sinteticas.MacroByName('WhereClassificacao').AsString := 'and false';
    ReFazConsulta(qryEventosVinculado_Sinteticas,[],[]);
  end;
end;

function TdtmCadastroEventos.SelecionarVinculados(
  Classificacao: String): String;
var
 i,j, nivel, tamanho: integer;
 vretorno, vmascara : String;
 aclassificacao: array of string[20];
begin
  j := 0;
  vretorno := '';
  Nivel := parsistema.mascarabancos[1].indexof(copy(classificacao,1,1));
//  Tamanho := length(ParSistema.mascarabancos[2].Strings[nivel]);
  vmascara := copy(ParSistema.mascarabancos[2].Strings[nivel],
              1,length(ParSistema.mascarabancos[2].Strings[nivel])-4);

    for i:=0 to length(vmascara)+1 do
      if (copy(vmascara, i, 1) = '.') then
         UltimoNivel := UltimoNivel + 1;
{
  if (length(classificacao)<>tamanho) and
     (qryEventostipo.AsString = 'A') then
    classificacao := classificacao+'.';

}
    classificacao := classificacao+'.';


  FOR i:=0 to length(Classificacao)+1 do
  begin
    if (copy(classificacao, i, 1) = ' ') then
      break;

    if (copy(classificacao, i, 1) = '.') then
    begin
      vretorno :=  vretorno + quotedstr(copy(classificacao, 1, i-1))+',';
      ultimaclassificacao := copy(classificacao, 1, i-1);
      j:=j+1;
      SetLength(aclassificacao,j);
      aclassificacao[j-1] := ultimaclassificacao;
    end;
  end;

  NivelMascara := J;

  if Length(classificacao)=1 then
    if PossuiNumero(Classificacao) then
    begin
      vretorno := classificacao+',';
      ultimaclassificacao :=classificacao;
      vinculados := '';
    end;

  if vretorno<>'' then
    vretorno := copy(vretorno,1,length(vretorno)-1)
  else
  begin
    vretorno := '0';
    ultimaclassificacao := vretorno;
  end;

  if j>1 then
    penultimaclassificacao := aclassificacao[j-2]
  else
    penultimaclassificacao := ultimaclassificacao;

  result := vretorno;
end;


function TdtmCadastroEventos.VerificarClassificacao: Boolean;
begin
  result := true;
  if qryEventosVinculado_Sinteticas.Active then
  begin
    qryEventosVinculado_Sinteticas.first;
    while not qryEventosVinculado_Sinteticas.Eof do
    begin
      if qryEventos.State = dsinsert then
      begin
        if qryEventostipo.AsString = 'S' then
          result :=(penultimaclassificacao =
                     qryEventosVinculado_Sinteticasclassificacao.AsString) or
                   (qryEventosVinculado_Sinteticas.RecordCount=0);
      end
      else
      begin
        if qryEventostipo.AsString = 'A' then
          result :=(penultimaclassificacao =
                     qryEventosVinculado_Sinteticasclassificacao.AsString) or
                   (qryEventosVinculado_Sinteticas.RecordCount=0);
      end;
      if result then
        break;
      qryEventosVinculado_Sinteticas.Next;
    end;

    if not result then
      MensagemErro(format(ctCLASSIFICACAONAOCADASTRADA,[penultimaclassificacao]));
  end;
end;

function TdtmCadastroEventos.ValidarContas(ExibirMsg: Boolean): Boolean;
begin
  result := true;
  if (trim(trocar(qryEventosclassificacao.Value,'. ','')) <>
     qryEventosclassificacao.OldValue) then
    if qryEventosVinculado_Sinteticas.Active then
    begin
      qryEventosVinculado_Sinteticas.last;
      if (trim(trocar(qryEventosclassificacao.AsString,'. ','')) =
          qryEventosVinculado_Sinteticasclassificacao.AsString) then
      begin
        result := false;
        if not result then
        begin
          if ExibirMsg then
            MensagemAviso(ctCLASSIFICACAOCADASTRADA);
          qryEventosclassificacao.FocusControl;
        end;
      end;
    end;
end;

