procedure TdtmCadastroEventos.MontarSQLConsultaHistoricosEvento(Editando: Boolean);
var
  pos: TBookmark;
  Historicos: String;
  Cod: Integer;
begin
  Cod := qryHistoricosEventoshistorico.AsInteger;
  pos := qryHistoricosEventos.GetBookmark;
  qryHistoricosEventos.DisableControls;
  try
    qryHistoricosEventos.First;
    while Not qryHistoricosEventos.Eof do begin
      if Editando then begin
        if (Cod <> qryHistoricosEventoshistorico.AsInteger) then
          Historicos := Historicos + qryHistoricosEventosHistorico.AsString + ','
      end else
        Historicos := Historicos + qryHistoricosEventosHistorico.AsString + ',';
      qryHistoricosEventos.Next;
    end;
    if (Historicos <> '') and (Historicos <> ',')then begin       //Retirar a vírgula caso exista na última posiçao da String.
      Historicos := Copy(Historicos, 1, Length(Historicos) - 1);
      qryConsultaHistoricos.Sql[3] := 'Where not (H.Codigo in ('+ Historicos +'))';
      qryHistoricos.Sql[4]   := 'and not (H.Codigo in ('+ Historicos +'))'
    end else begin
      qryConsultaHistoricos.Sql[3] := '';
      qryHistoricos.Sql[4]   := ''
    end
  finally
    qryHistoricosEventos.EnableControls;
    qryHistoricosEventos.GotoBookmark(pos);
    qryHistoricosEventos.FreeBookmark(pos);
  end;
end;

