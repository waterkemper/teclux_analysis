function TdtmCadastroEventos.GravarEvento: Boolean;
Var
  i: Integer;
Begin
  if qryEventos.CheckRequiredFields then
  begin
    if false {qryHistoricosEventos.RecordCount = 0 }then
      MensagemAviso(ctUMHISTORICONOEVENTO)
    else begin
      if qryEventos.State in [dsInsert] then begin
         spcEventosProximo.Open;
         qryEventoscodigo.AsInteger := spcEventosProximocodigo.AsInteger;
         spcEventosProximo.Close;
      end;

      if qryEventos.State in [dsEdit,dsInsert] then
      begin
        qryeventosclassificacao.AsString := trim(Trocar(qryeventosclassificacao.AsString,'. ',''));

        qryHistoricosEventos.First;
        for i:= 1 To qryHistoricosEventos.RecordCount do begin
          qryHistoricosEventos.Edit;
          qryHistoricosEventosevento.asInteger:= qryEventoscodigo.AsInteger;
          qryHistoricosEventos.Post;
          qryHistoricosEventos.Next;
        end;


        if parsistema.GerarContabilidade and
           (qryEventosContasContabeis.RecordCount > 0) then
        begin
          AtribuirChave(qryEventosContasContabeis,[qryEventosContasContabeisevento], [qryEventoscodigo]);

          result := VerificarCamposRequeridos(qryEventosContasContabeis);

          if result then
          begin
            result := SomarValores(qryEventosContasContabeis,[qryEventosContasContabeispercentual],[],[],[])=100;
            if not result then
              MensagemErro('O somatório do percentual das contas contábeis deve ser igual a 100.')
          end;
        end
        else
          result := true;


        if result then
        begin
          qryEventosContasContabeis.First;
          if not qryEventosContasContabeis.IsEmpty then
          begin
            qryEventosConta.AsInteger := qryEventosContasContabeiscontacontabil.AsInteger;
            if qryEventosContasContabeishistoricocontabil.AsInteger<>0 then
              qryEventoshistoricocontabil.AsInteger :=  qryEventosContasContabeishistoricocontabil.AsInteger;
          end;
          qryEventos.Post;
          
          result := Perpetrar([qryEventos, qryHistoricosEventos, qryEventosContasContabeis]);
        end;

      end
    end;
    Result := True;
  end else
    Result := False
end;

