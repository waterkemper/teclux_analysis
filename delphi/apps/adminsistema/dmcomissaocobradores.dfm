  object qryValorCobrado: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '; /* este ponto e virgula eh magico nao remova */'
      'CREATE TEMP TABLE comissaocobrado AS'
      
        'SELECT contrato, parcela, datapagto, valorpagto, usuario, nomeco' +
        'brador,'
      
        '       cliente, tipocliente, nomedevedor, dataocorre, diascobran' +
        'ca, percentual,'
      '       CAST('#39'VALOR COBRADO'#39' AS VARCHAR) AS evento,'
      '       ROUND( (percentual * valorpagto) / 100, 2) AS comissao'
      'FROM'
      '('
      
        '  SELECT *, faixa_comissao_cobranca(usuario, '#39'1'#39', :filial, diasc' +
        'obranca) AS percentual'
      '  FROM'
      '  ('
      
        '    SELECT candidatoscomissao.*, contratos.cliente, contratos.ti' +
        'pocliente, coalesce(vfornecedores.razao,vfornecedores.nome) AS n' +
        'omedevedor,'
      '           atendimentos.data AS dataocorre,'
      
        '           (candidatoscomissao.datapagto - atendimentos.data) AS' +
        ' diascobranca'
      '    FROM contratos, atendimentos, vfornecedores,'
      '     ('
      
        '       SELECT pagtos.*, usuarioscontratos.usuario, usuarios.nome' +
        ' AS nomecobrador'
      '       FROM usuarios,  ('
      '                                  SELECT u1.usuario, u1.contrato'
      '                                  FROM usuarioscontratos u1'
      
        '                                  WHERE not exists ( SELECT u2.u' +
        'suario'
      
        '                                                              FR' +
        'OM usuarioscontratos u2'
      
        '                                                              WH' +
        'ERE u2.data > u1.data'
      '                                                             )'
      '                                 ) AS usuarioscontratos,'
      '                                 ('
      
        '                                   SELECT pa.contrato, pa.numero' +
        ' AS parcela,'
      
        '                                                pa.datapagto, pa' +
        '.valorpagto'
      '                                   FROM parcelas pa'
      
        '                                   WHERE NOT ( contratos_renegoc' +
        'iado(pa.contrato) )'
      
        '                                   AND ( pa.tipopagto IN ('#39'C'#39','#39'D' +
        #39','#39'J'#39','#39'P'#39','#39'X'#39') )'
      
        '                                   AND ( pa.datapagto BETWEEN :i' +
        'nicio AND :fim )'
      '                                  ) AS pagtos'
      '      WHERE ( usuarioscontratos.contrato = pagtos.contrato )'
      '        AND ( usuarioscontratos.usuario = usuarios.codigo )'
      '        AND ( usuarios.cobranca )'
      '     ) AS candidatoscomissao'
      '    WHERE ( contratos.numero = candidatoscomissao.contrato )'
      
        '      AND (( contratos.cliente = atendimentos.cliente ) AND ( co' +
        'ntratos.tipocliente = atendimentos.tipocliente ))'
      '      AND ( atendimentos.usuario = candidatoscomissao.usuario )'
      '      AND ( atendimentos.tipo = '#39'C'#39' )'
      
        '      AND (( vfornecedores.codigo = contratos.cliente ) AND ( vf' +
        'ornecedores.tipo = contratos.tipocliente ))'
      
        '      AND ( ( candidatoscomissao.datapagto - atendimentos.data )' +
        ' > 0 )'
      '      AND ( atendimentos.data BETWEEN :inicio AND :fim )'
      '  ) AS ocorrencias'
      '  ORDER BY diascobranca'
      ') AS temporaria')
    RequestLive = False
    Left = 228
    Top = 110
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'inicio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'fim'
        ParamType = ptUnknown
      end>
  end
  object qryValorRenegociado: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '; /* este ponto e virgula eh magico nao remova */'
      'CREATE TEMP TABLE comissaorenegociado AS'
      
        'SELECT contrato, parcela, datapagto, valorpagto, usuario, nomeco' +
        'brador,'
      
        '       cliente, tipocliente, nomedevedor, dataocorre, diascobran' +
        'ca, percentual,'
      '       CAST('#39'VALOR RENEGOCIADO'#39' AS VARCHAR) AS evento,'
      '       ROUND( (percentual * valorpagto) / 100, 2) AS comissao'
      'FROM'
      '('
      
        '  SELECT *, faixa_comissao_cobranca(usuario, '#39'2'#39', :filial, diasc' +
        'obranca) AS percentual'
      '  FROM'
      '  ('
      
        '    SELECT candidatoscomissao.*, contratos.cliente, contratos.ti' +
        'pocliente, coalesce(vfornecedores.razao,vfornecedores.nome) AS n' +
        'omedevedor,'
      '           atendimentos.data AS dataocorre,'
      
        '           (candidatoscomissao.datapagto - atendimentos.data) AS' +
        ' diascobranca'
      '    FROM contratos, atendimentos, vfornecedores,'
      '     ('
      
        '       SELECT pagtos.*, usuarioscontratos.usuario, usuarios.nome' +
        ' AS nomecobrador'
      '       FROM usuarios,  ( '
      
        '                                  SELECT u1.usuario, u1.contrato' +
        ' '
      '                                  FROM usuarioscontratos u1 '
      
        '                                  WHERE not exists ( SELECT u2.u' +
        'suario '
      
        '                                                              FR' +
        'OM usuarioscontratos u2 '
      
        '                                                              WH' +
        'ERE u2.data > u1.data'
      '                                                             )'
      '                                ) AS usuarioscontratos, '
      '                                ('
      
        '                                  SELECT pa.contrato, pa.numero ' +
        'AS parcela,'
      
        '                                               pa.datapagto, pa.' +
        'valorpagto'
      '                                  FROM parcelas pa'
      
        '                                  WHERE ( contratos_renegociado(' +
        'pa.contrato) )'
      
        '                                  AND ( pa.datapagto BETWEEN :in' +
        'icio AND :fim )'
      '                                 ) AS pagtos'
      '      WHERE ( usuarioscontratos.contrato = pagtos.contrato )'
      '        AND ( usuarioscontratos.usuario = usuarios.codigo )'
      '        AND ( usuarios.cobranca )'
      '     ) AS candidatoscomissao'
      '    WHERE ( contratos.numero = candidatoscomissao.contrato )'
      
        '      AND (( contratos.cliente = atendimentos.cliente ) AND ( co' +
        'ntratos.tipocliente = atendimentos.tipocliente ))'
      '      AND ( atendimentos.usuario = candidatoscomissao.usuario )'
      '      AND ( atendimentos.tipo = '#39'C'#39' )'
      
        '      AND (( vfornecedores.codigo = contratos.cliente ) AND ( vf' +
        'ornecedores.tipo = contratos.tipocliente ))'
      
        '      AND ( ( candidatoscomissao.datapagto - atendimentos.data )' +
        ' > 0 )'
      '      AND ( atendimentos.data BETWEEN :inicio AND :fim )'
      
        '/*  AND ( contratos.data BETWEEN atendimentos.data AND atendimen' +
        'tos.data + 1 )*/      '
      '  ) AS ocorrencias'
      '  ORDER BY diascobranca'
      ') AS temporaria'
      '')
    RequestLive = False
    Left = 228
    Top = 162
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'inicio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'fim'
        ParamType = ptUnknown
      end>
  end
  object qryRecolhidoDD: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '; /* este ponto e virgula eh magico nao remova */'
      'CREATE TEMP TABLE comissaorecolhido_dd AS'
      
        'SELECT contrato, parcela, datapagto, valorpagto, usuario, nomeco' +
        'brador,'
      
        '       cliente, nomedevedor, dataocorre, diascobranca, percentua' +
        'l,'
      '       CAST('#39'PROD. REC. DD'#39' AS VARCHAR) AS evento,'
      '       ROUND( (percentual * valorpagto) / 100, 2) AS comissao'
      'FROM'
      '('
      
        '  SELECT *, faixa_comissao_cobranca(usuario, '#39'3'#39', :filial, diasc' +
        'obranca) AS percentual'
      '  FROM'
      '  ('
      
        '    SELECT candidatoscomissao.*, contratos.cliente, clientes.nom' +
        'e AS nomedevedor,'
      '           atendimentos.data AS dataocorre,'
      
        '           (candidatoscomissao.datapagto - atendimentos.data) AS' +
        ' diascobranca'
      
        '    FROM contratos, atendimentos, clientes, produtoscontratos, p' +
        'rodutosnotaspag,'
      '     ('
      
        '       SELECT pagtos.*, usuarioscontratos.usuario, usuarios.nome' +
        ' AS nomecobrador'
      '       FROM usuarioscontratos, usuarios, ('
      
        '                                          SELECT pa.contrato, pa' +
        '.numero AS parcela,'
      
        '                                                 pa.datapagto, p' +
        'a.valorpagto'
      '                                          FROM parcelas pa'
      
        '                                          WHERE ( pa.tipopagto =' +
        ' '#39'E'#39' )'
      
        '                                          AND ( pa.datapagto BET' +
        'WEEN :inicio AND :fim )'
      
        '                                          AND ( date_part('#39'year'#39 +
        ', pa.datavencto) <= date_part('#39'year'#39', pa.datapagto) )'
      
        '                                          AND ( date_part('#39'month' +
        #39', pa.datavencto) <= date_part('#39'month'#39', pa.datapagto) )'
      '                                         ) AS pagtos'
      '      WHERE ( usuarioscontratos.contrato = pagtos.contrato )'
      '        AND ( usuarioscontratos.usuario = usuarios.codigo )'
      '        AND ( usuarios.cobranca )'
      '     ) AS candidatoscomissao'
      '    WHERE ( contratos.numero = candidatoscomissao.contrato )'
      '      AND ( contratos.cliente = atendimentos.cliente )'
      '      AND ( produtoscontratos.contrato = contratos.numero)'
      
        '      AND ( produtosnotaspag.movimento = produtoscontratos.movim' +
        'ento )'
      '      AND ( notaspag_recolhida(produtosnotaspag.codigonota) )'
      '      AND ( atendimentos.usuario = candidatoscomissao.usuario )'
      '      AND ( atendimentos.tipo = '#39'C'#39' )'
      '      AND ( clientes.codigo = contratos.cliente )'
      
        '      AND ( ( candidatoscomissao.datapagto - atendimentos.data )' +
        ' > 0 )'
      '      AND ( atendimentos.data BETWEEN :inicio AND :fim )'
      '  ) AS ocorrencias'
      '  ORDER BY diascobranca  '
      ') AS temporaria')
    RequestLive = False
    Left = 352
    Top = 9
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'inicio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'fim'
        ParamType = ptUnknown
      end>
  end
