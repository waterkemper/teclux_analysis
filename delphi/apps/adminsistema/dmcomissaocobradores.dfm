  end
  object qryResumoFolha: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '; /* este ponto e virgula eh magico nao remova */'
      
        'SELECT usuario, nomecobrador, evento, ROUND(SUM (comissao),2) AS' +
        ' comissao'
      'FROM'
      '('
      'SELECT *'
      'FROM'
      '   ('
      ''
      '    /* editada em run time */'
      ''
      '   ) AS comissaocobradores'
      ') AS resumo'
      'GROUP BY usuario, evento, nomecobrador'
      'ORDER BY UPPER(TO_ASCII(nomecobrador,'#39'LATIN1'#39')), evento ')
    RequestLive = False
    Left = 228
    Top = 59
    object qryResumoFolhausuario: TIntegerField
      FieldName = 'usuario'
    end
    object qryResumoFolhanomecobrador: TStringField
      DisplayWidth = 40
      FieldName = 'nomecobrador'
    end
    object qryResumoFolhacomissao: TFloatField
      FieldName = 'comissao'
    end
    object qryResumoFolhaevento: TStringField
      DisplayWidth = 50
      FieldName = 'evento'
      Size = 0
    end
  end
