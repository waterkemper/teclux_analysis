  object qryProporcoes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '; /* este ponto e virgula eh magico nao remova */'
      'CREATE TEMP TABLE comissaoproporcoescobrador AS'
      'SELECT *'
      'FROM'
      '('
      ' SELECT'
      
        '        CAST('#39#39' AS VARCHAR) AS contrato, CAST('#39'0'#39' AS INTEGER) AS' +
        ' parcela,'
      '        CAST(NULL AS DATE) AS datapagto,'
      
        '        ROUND( ( SUM( cobrancas.totalcobrado ) * ( metasusuarios' +
        '.uteismes - metasusuarios.uteismeta) ) / metasusuarios.uteismes,' +
        ' 2 ) AS valorpagto,'
      '        cobrancas.usuario, cobrancas.nomecobrador,'
      
        '        CAST('#39'0'#39' AS INTEGER) AS cliente, CAST('#39#39' AS VARCHAR) AS ' +
        'nomedevedor,'
      
        '        CAST(NULL AS DATE) AS dataocorre, CAST('#39'0'#39' AS INTEGER) A' +
        'S diascobranca,'
      '        CAST ('#39'0'#39' AS NUMERIC) AS percentual,'
      '        CAST('#39'PROPOR'#199#195'O FOLGA'#39' AS VARCHAR) AS evento,'
      
        '        ROUND( ( ( ROUND( ( SUM( totalcobrado ) * ( metasusuario' +
        's.uteismes - metasusuarios.uteismeta) ) / metasusuarios.uteismes' +
        ', 2 ) * metasusuarios.comissao) / 100), 2) AS comissao'
      ''
      ' FROM metasusuarios,'
      '   ('
      
        '     SELECT filtro.usuario, filtro.nomecobrador, SUM(filtro.comi' +
        'ssao) AS totalcobrado'
      '     FROM ('
      ''
      '               /* eventos preliminares editados em run time */'
      ''
      '          ) AS filtro'
      '     GROUP BY filtro.usuario, filtro.nomecobrador'
      '    ) AS cobrancas'
      ' WHERE ( metasusuarios.usuario = cobrancas.usuario )'
      ' AND ( metasusuarios.mesano = :mesano )'
      
        ' GROUP BY cobrancas.usuario, cobrancas.nomecobrador, metasusuari' +
        'os.uteismes, metasusuarios.uteismeta,'
      
        '          metasusuarios.tipo, metasusuarios.comissao, cobrancas.' +
        'totalcobrado'
      ') AS temporaria')
    RequestLive = False
    Left = 352
    Top = 212
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'mesano'
        ParamType = ptUnknown
      end>
  end
  object qryMeta: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '; /* este ponto e virgula eh magico nao remova */'
      'CREATE TEMP TABLE comissaometascobrador AS'
      'SELECT *'
      'FROM'
      '('
      '  SELECT'
      
        '        CAST('#39#39' AS VARCHAR) AS contrato, CAST('#39'0'#39' AS INTEGER) AS' +
        ' parcela,'
      
        '        CAST(NULL AS DATE) AS datapagto, CAST('#39'0'#39' AS NUMERIC) AS' +
        ' valorpagto,'
      '        usuario, nomecobrador,'
      
        '        CAST('#39'0'#39' AS INTEGER) AS cliente, CAST('#39#39' AS VARCHAR) AS ' +
        'nomedevedor,'
      
        '        CAST(NULL AS DATE) AS dataocorre, CAST('#39'0'#39' AS INTEGER) A' +
        'S diascobranca,'
      '        CASE'
      
        '          WHEN cobrancas.tipocomissaousuario = '#39'V'#39' THEN  CAST('#39'0' +
        #39' AS NUMERIC)'
      '          ELSE cobrancas.comissao'
      '        END AS percentual,'
      '        CAST('#39'META'#39' AS VARCHAR) AS evento,'
      '        CASE'
      
        '          WHEN cobrancas.tipocomissaousuario = '#39'V'#39' THEN  cobranc' +
        'as.comissao'
      
        '          ELSE ROUND(( ( cobrancas.base * cobrancas.comissao) / ' +
        '100), 2)'
      '        END AS comissao'
      '  FROM'
      '  ('
      '    SELECT calculabase.*,'
      '           CASE'
      
        '             WHEN calculabase.baseinicial / calculabase.comissao' +
        ' * 100 > :tetometa THEN  (calculabase.comissao * :tetometa) / 10' +
        '0'
      '             ELSE calculabase.baseinicial'
      '           END AS base'
      '    FROM'
      '    ('
      
        '      SELECT totalcomissao.*, ROUND( ( SUM( totalcomissao.totalc' +
        'obrado )  * ( 1 + (metasusuarios.uteismes - metasusuarios.uteism' +
        'eta) ) ) / metasusuarios.uteismes, 2 ) AS baseinicial,'
      
        '             metasusuarios.valor AS valormeta, metasusuarios.com' +
        'issao, metasusuarios.tipo AS tipocomissaousuario'
      '      FROM metasusuarios,'
      '      ('
      
        '        SELECT filtro.usuario, filtro.nomecobrador,  SUM(filtro.' +
        'comissao) AS totalcobrado'
      '         FROM ('
      ''
      '               /* eventos preliminares editados em run time */'
      ''
      '              ) AS filtro'
      '         GROUP BY filtro.usuario, filtro.nomecobrador'
      '      ) AS totalcomissao'
      '      WHERE ( metasusuarios.usuario = totalcomissao.usuario )'
      '        AND ( metasusuarios.mesano = :mesano )'
      
        '      GROUP BY totalcomissao.usuario, totalcomissao.nomecobrador' +
        ','
      
        '               totalcomissao.totalcobrado, metasusuarios.uteisme' +
        's, metasusuarios.uteismeta,'
      
        '               metasusuarios.valor, metasusuarios.comissao, meta' +
        'susuarios.tipo'
      '    ) AS calculabase'
      '    WHERE ( calculabase.baseinicial >= calculabase.valormeta )'
      '  ) AS cobrancas'
      '  GROUP BY cobrancas.usuario, cobrancas.nomecobrador,'
      '           cobrancas.totalcobrado, cobrancas.base,'
      '           cobrancas.tipocomissaousuario, cobrancas.comissao'
      ') AS temporaria'
      '')
    RequestLive = False
    Left = 352
    Top = 160
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'tetometa'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'mesano'
        ParamType = ptUnknown
      end>
  end
