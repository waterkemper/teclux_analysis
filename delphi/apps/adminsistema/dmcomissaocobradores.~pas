    dsrProcuraCobradores: TtecDataSource;
    qryProcuraCobradorescodigo: TIntegerField;
    qryProcuraCobradoresnome: TStringField;
    qryConsultaCobradoresnome: TStringField;
    qryConsultaCobradorescodigo: TIntegerField;
    qryResumoFolha: TtecQuery;
    fdsComissao: TfrDBDataSet;
    fdsResumoFolha: TfrDBDataSet;
    frpAnalitico: TfrReport;
    frpResumoFolha: TfrReport;
    frpSintetico: TfrReport;
    qryValorCobrado: TtecQuery;
    qryValorRenegociado: TtecQuery;
    qryRecolhidoDD: TtecQuery;
    qryRecolhido: TtecQuery;
    qryCheque: TtecQuery;
    qryProporcoes: TtecQuery;
    qryMeta: TtecQuery;
    qryComissao: TtecQuery;
    qryComissaocontrato: TStringField;
