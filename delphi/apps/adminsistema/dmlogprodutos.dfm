    Macros = <
      item
        DataType = ftUnknown
        Name = 'WHEREOPERACAO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WHEREPRODUTO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WHEREITEMPRODUTO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WHEREPERIODO'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';SELECT  caracteristica,'
      
        '/*'#9' COALESCE(descricao,(SELECT descricao from caracteristicas wh' +
        'ere codigo=logs.caracteristica)) as descricao,*/'
      
        '  (SELECT descricao from caracteristicas where codigo=logs.carac' +
        'teristica) as descricao,'
      #9'CASE WHEN trigger_mode='#39'UPDATE'#39' THEN '#39'ATUALIZADO'#39
      #9'     WHEN trigger_mode='#39'INSERT'#39' THEN '#39'INSERIDO'#39
      #9'     WHEN trigger_mode='#39'DELETE'#39' THEN '#39'APAGADO'#39
      #9'END as operacao,'
      
        #9'trigger_tuple as t,TO_CHAR(trigger_changed,'#39'dd/mm/yy - HH24:MI'#39 +
        ') as data,trigger_user as usuario,'
      #9'onde'
      'FROM'
      '('
      
        #9'(select codigo as caracteristica,descricao,trigger_mode,trigger' +
        '_tuple, trigger_changed,trigger_user,trigger_id,'#39'Produto'#39' as ond' +
        'e,0 as ordem'
      #9'FROM caracteristicas_log)'
      #9'UNION'
      
        #9'(select caracteristica,cast(null as varchar) as descricao,trigg' +
        'er_mode,trigger_tuple, trigger_changed,trigger_user,trigger_id,'#39 +
        'Item de Produto - '#39' || cast(codigo as varchar)  as onde,1 as ord' +
        'em'
      #9'FROM produtos_log)'
      #9'UNION'
      
        #9'(select caracteristica,cast(null as varchar) as descricao,trigg' +
        'er_mode,trigger_tuple, trigger_changed,trigger_user,trigger_id,'#39 +
        'Preco - '#39' || cast(preco as varchar) || '#39' Col. - '#39' || cast(coluna' +
        ' as varchar) || '#39' Valor: '#39'|| cast(valor as varchar) as onde,2 as' +
        ' ordem'
      #9'FROM colunasprecos_log)'
      #9'UNION'
      
        #9'(select caracteristica,cast(null as varchar) as descricao,trigg' +
        'er_mode,trigger_tuple, trigger_changed,trigger_user,trigger_id,'#39 +
        'Tipos de Precos - '#39' || cast(codigo as varchar) as onde,3 as orde' +
        'm'
      #9'FROM precos_log)'
      ') as logs'
      ''
      'WHERE true'
      '%WHEREOPERACAO'
      '%WHEREPRODUTO'
      '%WHEREITEMPRODUTO'
      '%WHEREPERIODO'
      ''
      'ORDER BY caracteristica,trigger_changed,ordem,trigger_tuple desc')
    RequestLive = False
    Left = 24
    Top = 8
