    Sql.Strings = (
      ';'
      'select distinct * from'
      '('
      '  select distinct sf.evento,e.classificacao, e.tipo,'
      
        '       case when :ImprimirCodigoReduzido and e.tipo='#39'A'#39' then cas' +
        't(e.classificacao||'#39'       '#39'||to_char(e.codigo,'#39'999999'#39')||'#39'   '#39'|' +
        '|e.descricao as varchar)'
      
        '            else  cast(e.classificacao||'#39'       '#39'||e.descricao a' +
        's varchar) end as descricao,'
      
        '       case when :ImprimirCodigoReduzido and e.tipo='#39'A'#39' then cas' +
        't(repeat('#39' '#39', length(btrim(e.classificacao)))||to_char(e.codigo,' +
        #39'999999'#39')||'#39'   '#39'||e.descricao as varchar)'
      
        '            else  cast(repeat('#39' '#39', length(btrim(e.classificacao)' +
        '))||e.descricao as varchar) end as descricaoedentada'
      
        '  from saldosfinanceiros sf join eventos e on sf.evento = e.codi' +
        'go'
      ' where true '
      ' %SomenteSaldosInicial'
      '  %ExercicioInicial'
      '  %Sintetico'
      ''
      '  union all'
      '  select distinct sf.evento,e.classificacao, e.tipo,'
      
        '       case when :ImprimirCodigoReduzido and e.tipo='#39'A'#39' then cas' +
        't(e.classificacao||'#39'       '#39'||to_char(e.codigo,'#39'999999'#39')||'#39'   '#39'|' +
        '|e.descricao as varchar)'
      
        '            else  cast(e.classificacao||'#39'       '#39'||e.descricao a' +
        's varchar) end as descricao,'
      
        '       case when :ImprimirCodigoReduzido and e.tipo='#39'A'#39' then cas' +
        't(repeat('#39' '#39', length(btrim(e.classificacao)))||to_char(e.codigo,' +
        #39'999999'#39')||'#39'   '#39'||e.descricao as varchar)'
      
        '            else  cast(repeat('#39' '#39', length(btrim(e.classificacao)' +
        '))||e.descricao as varchar) end as descricaoedentada'
      
        '  from saldosfinanceiros sf join eventos e on sf.evento = e.codi' +
        'go'
      '  where true'
      '  %SomenteSaldosFinal'
      '  %ExercicioInicial'
      '  %Sintetico'
      ')as temp'
      'order by classificacao'
      ''
      '')
