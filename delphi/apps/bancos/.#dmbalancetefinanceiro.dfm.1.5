      item
        DataType = ftUnknown
        Name = 'SoEventosComMovimento'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Sintetico'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'SELECT DISTINCT sf.Evento,'
      '                e.Classificacao,'
      '                e.Tipo,'
      ''
      '                CASE WHEN :ImprimirCodigoEvento AND e.tipo = '#39'A'#39
      
        '                     THEN CAST(e.Classificacao || '#39'       '#39' || T' +
        'O_CHAR(e.Codigo, '#39'999999'#39') || '#39'   '#39' || e.Descricao AS VARCHAR)'
      
        '                     ELSE CAST(e.Classificacao || '#39'       '#39' || e' +
        '.Descricao AS VARCHAR)'
      '                END AS Descricao,'
      ''
      '                CASE WHEN :ImprimirCodigoEvento AND e.Tipo = '#39'A'#39
      
        '                     THEN CAST(REPEAT('#39' '#39', LENGTH(BTRIM(e.Classi' +
        'ficacao))) || TO_CHAR(e.Codigo, '#39'999999'#39') || '#39'   '#39' || e.Descrica' +
        'o AS VARCHAR)'
      
        '                     ELSE CAST(REPEAT('#39' '#39', LENGTH(BTRIM(e.Classi' +
        'ficacao))) || e.Descricao AS VARCHAR)'
      '                END AS DescricaoEdentada'
      ''
      '   FROM SaldosFinanceiros sf'
      '        JOIN Eventos e ON sf.Evento = e.Codigo'
      ''
      '   WHERE TRUE'
      ''
      '         %SoEventosComMovimento'
      '         %Sintetico'
      ''
      '   ORDER BY Classificacao, Descricao;'
      ''
      '')
