    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT DISTINCT c.Conta,'
      
        '                CAST(StrTrocar(TRIM(TO_CHAR(c.Conta,'#39'999,999,999' +
        #39')),'#39','#39','#39'.'#39') || '#39'-'#39' || c.Digito AS VARCHAR) AS ContaDigito,'
      
        '               (SELECT b.Sigla FROM Bancos   b WHERE b.Codigo = ' +
        'c.Banco) AS Banco,'
      
        '               (SELECT a.Nome  FROM Agencias a WHERE a.Codigo = ' +
        'c.Agencia AND a.Banco = c.Banco) AS Agencia,'
      '                SaldoBanco(c.Conta, CURRENT_DATE, '#39'L'#39') AS Saldo,'
      '                FALSE AS Selecionada'
      ''
      'FROM Contas c'
      ''
      'WHERE NOT :SoContasComSaldo OR'
      '      SaldoBanco(c.Conta, CURRENT_DATE, '#39'L'#39') <> 0'
      ''
      'ORDER BY c.Conta'
      '')
