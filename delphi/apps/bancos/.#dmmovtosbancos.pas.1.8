procedure TdtmMovtosBancos.AbrirTabelas(TipoPesquisa: TtecMovtosBancos);
begin
   Case TipoPesquisa of
      tmbCONTAS:  Abre(ctConsultaContas);
      tmbEVENTOS: Abre(ctConsultaEventos);
      tmbMOVTOS:  RefazConsulta(qryConsultaMovtosBancos, [0, 1, 2],
                               [qryProcuraContasConta.AsVariant,
                                ParSistema.BancoDataInicial,
                                ParSistema.BancoDataFinal]);

  end;

end;

constructor TdtmMovtosBancos.Create(AOwner: TComponent);
begin
   inherited;
   ListaEventosCadastrados := '0';
   ListaContasCadastradas := '0';

   qryProcuraContas.       Tag:= ctTabelas;
   qryMovtosBancos.        Tag:= ctTabelas;
   qryConsultaContas.      Tag:= ctConsultaContas;
   qryConsultaMovtosBancos.Tag:= ctConsultaMovtosBancos;

   DataInclusao := DataServidor;
end;

procedure TdtmMovtosBancos.FecharTabelas(TipoPesquisa: TtecMovtosBancos);
begin
   Case TipoPesquisa of
      tmbCONTAS:  Fecha(ctConsultaContas);
      tmbEVENTOS: Fecha(ctConsultaEventos);
      tmbMOVTOS:  Fecha(ctConsultaMovtosBancos);
   end;
end;

