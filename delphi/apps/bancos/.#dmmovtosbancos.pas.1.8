procedure TdtmMovtosBancos.LimparMovtosBancosEventosEvento;
begin
   if not (qryMovtosBancosEventos.State in [dsedit, dsinsert]) then
     qryMovtosBancosEventos.Edit;
   qryMovtosBancosEventosevento.Clear;
   qryMovtosBancosEventosdescricaoevento.Clear;
   qryMovtosBancosEventostipo.Clear;
end;

procedure TdtmMovtosBancos.EditarMovtosBancosEventos;
begin
  if not (qryMovtosBancosEventos.State in [dsedit, dsinsert]) then
    qryMovtosBancosEventos.Edit;
end;

function TdtmMovtosBancos.RegistrodeMovtosBancosEventosEvento: boolean;
begin
  result := qryMovtosBancosEventosevento.IsNull or
            qryMovtosBancosEventosdescricaoevento.IsNull;
end;

procedure TdtmMovtosBancos.CancelarMovtosBancosEventosEvento;
begin
  try
    GuardarRegistroAtual(qryMovtosBancosEventos,false);
    qryMovtosBancosEventos.Cancel;
    qryMovtosBancosEventos.First;
    while not qryMovtosBancosEventos.Eof do
    begin
      if not qryMovtosBancosEventoseventovalidado.AsBoolean or
         not qryMovtosBancosEventoscontavalidada.AsBoolean then
        qryMovtosBancosEventos.Delete
      else
        qryMovtosBancosEventos.next;
    end;
    VoltarRegistroAtual(qryMovtosBancosEventos);
  except
  end;
end;

function TdtmMovtosBancos.IncluirMovtosBancosEventos: Boolean;
begin
  qryMovtosBancosEventos.Append;
  Result:= True;
end;

procedure TdtmMovtosBancos.ExcluirMovtosBancosEventos;
begin
   if not qryMovtosBancosEventos.IsEmpty then
      if MensagemConfirmacao(Format(ctCONFIRMEEXCLUIR, ['o lançamento no evento'])) = smbok then
         qryMovtosBancosEventos.Delete;
end;

procedure TdtmMovtosBancos.qryMovtosBancosEventosAfterPost(
  DataSet: TDataSet);
begin
  inherited;
  AtualizaListaEventosCadastrados;
  AtualizaListaContasCadastradas;
  EditarMovtosBancos;

  GravarMovtosBancos;
end;

procedure TdtmMovtosBancos.AtualizaListaEventosCadastrados;
begin
  GuardarRegistroAtual(qryMovtosBancosEventos,true);
  ListaEventosCadastrados := '';
  qryMovtosBancosEventos.First;
  while not qryMovtosBancosEventos.Eof do
  begin
    ListaEventosCadastrados := ListaEventosCadastrados + qryMovtosBancosEventosevento.AsString+',';
    qryMovtosBancosEventos.Next;
  end;

  if (ListaEventosCadastrados = '') or
     (ListaEventosCadastrados = ',')  then
    ListaEventosCadastrados := '0'
  else
    Delete(ListaEventosCadastrados,length(ListaEventosCadastrados),1);

  VoltarRegistroAtual(qryMovtosBancosEventos);

end;

procedure TdtmMovtosBancos.qryMovtosBancosEventosAfterDelete(
  DataSet: TDataSet);
begin
  inherited;
  AtualizaListaEventosCadastrados;
  AtualizaListaContasCadastradas;
  EditarMovtosBancos;

  GravarMovtosBancos;
end;

