begin
  if not (qryMovtosBancos.State in [dsedit, dsinsert]) then
    qryMovtosBancos.Edit;
end;

procedure TdtmMovtosBancos.qryMovtosBancosEventosAfterEdit(
  DataSet: TDataSet);
begin
  inherited;
  EditarMovtosBancos;
end;

procedure TdtmMovtosBancos.qryMovtosBancosEventosBeforePost(
  DataSet: TDataSet);
begin
  inherited;
  qryMovtosBancosEventosregistroalterado.AsBoolean := true;
end;

procedure TdtmMovtosBancos.dsrMovtosBancosEventosDataChange(
  Sender: TObject; Field: TField);
begin
  inherited;
  if field = qryMovtosBancosEventostipo then
  begin
    qryMovtosBancosEventoscontatransf.ReadOnly := not (qryMovtosBancosEventostipo.AsString = 'T');
    DefinirCamposObrigatorios;

    if qryMovtosBancosEventostipo.AsString <> 'T' then
    begin
      qryMovtosBancosEventoscontatransf.Clear;
      qryMovtosBancosEventossigla.Clear;
      qryMovtosBancosEventosnomeagencia.Clear;
      qryMovtosBancosEventosdigito.Clear;

      qryMovtosBancosEventoscontavalidada.AsBoolean := true;
    end
    else
      qryMovtosBancosEventoscontavalidada.AsBoolean := false;

  end;
end;

procedure TdtmMovtosBancos.AtualizaListaContasCadastradas;
begin
  GuardarRegistroAtual(qryMovtosBancosEventos,true);
  ListaContasCadastradas := qryMovtosBancosConta.AsString+',';
  qryMovtosBancosEventos.First;
  while not qryMovtosBancosEventos.Eof do
  begin
    if qryMovtosBancosEventoscontatransf.AsString<>'' then
      ListaContasCadastradas := ListaContasCadastradas + qryMovtosBancosEventoscontatransf.AsString+',';
    qryMovtosBancosEventos.Next;
  end;

  Delete(ListaContasCadastradas,length(ListaContasCadastradas),1);

  VoltarRegistroAtual(qryMovtosBancosEventos);

end;

