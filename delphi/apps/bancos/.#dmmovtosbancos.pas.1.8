procedure TdtmMovtosBancos.DefinirCamposObrigatorios;
begin
  qryMovtosBancosEventoscontatransf.Required := qryMovtosBancosEventostipo.AsString = 'T';
  qryMovtosBancosEventossigla.Required       := qryMovtosBancosEventostipo.AsString = 'T';
  qryMovtosBancosEventosnomeagencia.Required := qryMovtosBancosEventostipo.AsString = 'T';
  qryMovtosBancosEventosdigito.Required := qryMovtosBancosEventostipo.AsString = 'T';
end;

