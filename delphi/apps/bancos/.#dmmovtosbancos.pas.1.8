   qryMovtosBancosEventoscontatransf.Clear;
   qryMovtosBancosEventossigla.Clear;
   qryMovtosBancosEventosnomeagencia.Clear;
end;

function TdtmMovtosBancos.RegistrodeMovtosBancosEventosContas: boolean;
begin
  result := qryMovtosBancosEventoscontatransf.IsNull;
end;


