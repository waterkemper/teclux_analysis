      'SELECT e.Descricao,'
      '       e.Classificacao,'
      '       e.Codigo,'
      '       e.TipoMovimentacao,'
      
        '       Case WHEN e.TipoMovimentacao in ('#39'S'#39','#39'T'#39') THEN Cast('#39'-'#39' a' +
        's CHAR)'
      '                         ELSE Cast('#39'+'#39' as CHAR)'
      '       END as TipoEvento'
      ''
      'FROM   eventos e'
      ''
      'WHERE  e.Tipo = '#39'A'#39'  AND'
      '       e.Inativo IS NULL'
      ''
      'ORDER BY UPPER(TO_ASCII(e.Descricao, '#39'LATIN1'#39'))'
      '')
