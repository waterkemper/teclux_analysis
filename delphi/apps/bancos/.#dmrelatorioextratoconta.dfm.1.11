    Sql.Strings = (
      '('
      ' SELECT CAST(:Conta AS INTEGER)   AS Conta,'
      '        CAST(NULL AS DATE)        AS Data,'
      '        CAST(NULL AS INTEGER)     AS Sequencia,'
      '        CAST(NULL AS NUMERIC)     AS ValorCredito,'
      '        CAST(NULL AS NUMERIC)     AS ValorDebito,'
      '        CAST(NULL AS NUMERIC)     AS Valor,'
      '        CAST(NULL AS DATE)        AS Compensacao,'
      '        CAST(NULL AS INTEGER)     AS SeqCompensacao,'
      '        CAST(NULL AS VARCHAR(20)) AS Documento,'
      '        CAST(NULL AS INTEGER)     AS Evento,'
      '        CAST(NULL AS CHAR(1))     AS Tipo,'
      '        CAST(NULL AS CHAR(1))     AS OrigemLancto,'
      
        '        CAST('#39'SALDO ANTERIOR'#39' AS VARCHAR(30)) AS DescricaoEvento' +
        ','
      '        CAST(NULL AS VARCHAR)     AS Observacoes,'
      '        TRUE AS ExibirSaldo,'
      '        TRUE AS UltimoPagamentoLote,'
      '        CAST(NULL AS NUMERIC(15,2)) AS ValorEvento,'
      
        '                                             /* Se for extrato p' +
        'ara um evento espec'#237'fico */'
      
        '        CASE WHEN :Evento = 0                /* o saldo n'#227'o faz ' +
        'sentido e '#233' zerado       */'
      '             THEN (SELECT SaldoBanco(:Conta, :DataSaldo, '#39'C'#39'))'
      '             ELSE 0'
      '        END AS Saldo'
      ')'
      'UNION ALL'
      '('
      ' SELECT mb.*,'
      '       CASE WHEN mb.ExibirSaldo'
      '            THEN CASE WHEN :Evento = 0'
      
        '                      THEN (SELECT SaldoBanco(mb.Conta, mb.Compe' +
        'nsacao, '#39'C'#39'))'
      '                      ELSE (SELECT SUM(mbe.Valor)'
      '                               FROM MovtosBancosEventos mbe'
      '                               WHERE mbe.Conta  = mb.Conta AND'
      '                                     mbe.Data   = mb.Data  AND'
      '                                     mbe.Evento = :Evento)'
      '                 END'
      '            ELSE CAST(NULL AS NUMERIC(15,2))'
      '       END AS Saldo'
      ' FROM'
      '      ('
      '       SELECT mb.Conta,'
      '              mb.Data,'
      '              mb.Sequencia,'
      '              CASE WHEN (mb.Tipo = '#39'E'#39') OR'
      '                       ((mb.Tipo = '#39'T'#39') AND (mb.Valor > 0))'
      '                   THEN CASE WHEN :Evento = 0'
      '                             THEN ABS(mb.Valor)'
      '                             ELSE (SELECT ABS(SUM(mbe.Valor))'
      
        '                                      FROM MovtosBancosEventos m' +
        'be'
      
        '                                      WHERE mbe.Conta     = mb.C' +
        'onta     AND'
      
        '                                            mbe.Data      = mb.D' +
        'ata      AND'
      
        '                                            mbe.Sequencia = mb.S' +
        'equencia AND'
      
        '                                            mbe.Evento    = :Eve' +
        'nto)'
      '                        END'
      '                   ELSE 0.00'
      '              END AS ValorCredito,'
      ''
      '              CASE WHEN (mb.Tipo = '#39'S'#39') OR'
      '                       ((mb.Tipo = '#39'T'#39') AND (mb.Valor < 0))'
      '                   THEN CASE WHEN :Evento = 0'
      '                             THEN ABS(mb.Valor)'
      '                             ELSE (SELECT ABS(SUM(mbe.Valor))'
      
        '                                      FROM MovtosBancosEventos m' +
        'be'
      
        '                                      WHERE mbe.Conta     = mb.C' +
        'onta     AND'
      
        '                                            mbe.Data      = mb.D' +
        'ata      AND'
      
        '                                            mbe.Sequencia = mb.S' +
        'equencia AND'
      
        '                                            mbe.Evento    = :Eve' +
        'nto)'
      '                        END'
      '                   ELSE 0.00'
      '              END AS ValorDebito,'
      ''
      '              mb.Valor,'
      '              mb.Compensacao,'
      '              mb.SeqCompensacao,'
      '              mb.Documento,'
      '              mb.Evento,'
      '              mb.Tipo,'
      '              mb.OrigemLancto,'
      '              mb.DescricaoEvento, mb.observacoes,'
      '              mb.ExibirSaldo,'
      '              mb.UltimoPagamentoLote,'
      '              mb.ValorEvento'
      ''
      '       FROM'
      '            ('
      '             SELECT mb.Conta,'
      '                    mb.Data,'
      '                    mb.Sequencia,'
      '                    CASE WHEN mb.Evento IS NULL'
      '                         THEN ABS(mbe.Valor)'
      '                         ELSE CAST(NULL AS NUMERIC(15,2))'
      '                    END AS ValorEvento,'
      ''
      '                    ABS(mb.Valor) AS Valor, '
      '                    '
      
        '                    CASE WHEN (mbe.Conta, mb.Compensacao, mb.Seq' +
        'Compensacao) ='
      
        '                              (SELECT mb2.Conta, mb2.Compensacao' +
        ', mb2.SeqCompensacao'
      '                                  FROM MovtosBancos mb2'
      
        '                                  WHERE mb2.Conta       = mb.Con' +
        'ta AND'
      
        '                                        mb2.Compensacao = mb.Com' +
        'pensacao'
      
        '                                  ORDER BY mb2.Conta, mb2.Compen' +
        'sacao, mb2.SeqCompensacao'
      '                                           DESC LIMIT 1)'
      '                         THEN TRUE'
      '                         ELSE FALSE'
      '                    END AS ExibirSaldo,'
      ''
      '                    mb.Compensacao,'
      '                    mb.SeqCompensacao,'
      '                    mb.Documento,'
      '                    mbe.Evento,'
      '                    e.Descricao AS DescricaoEvento,'
      '                    mbe.Tipo,'
      '                    mb.OrigemLancto,'
      
        '                    COALESCE(mbe.Observacoes, mb.Observacoes) AS' +
        ' Observacoes,'
      ''
      
        '                    CASE WHEN (mb.Conta, mb.Data, mb.Sequencia, ' +
        'mbe.Evento, mbe.SequenciaEvento) IN'
      
        '                                  (SELECT mbe2.Conta,  mbe2.Data' +
        ', mbe2.Sequencia,'
      
        '                                          mbe2.Evento, mbe2.Sequ' +
        'enciaEvento'
      '                                   FROM MovtosBancosEventos mbe2'
      
        '                                   WHERE mbe2.Conta     = mb.Con' +
        'ta     AND'
      
        '                                         mbe2.Data      = mb.Dat' +
        'a      AND'
      
        '                                         mbe2.Sequencia = mb.Seq' +
        'uencia AND'
      
        '                                        (mbe2.Evento    = :Event' +
        'o OR :Evento = 0)'
      
        '                                   ORDER BY mbe2.Conta, mbe2.Dat' +
        'a, mbe2.Sequencia, mbe2.Evento DESC,'
      
        '                                            mbe2.SequenciaEvento' +
        ' DESC LIMIT 1)'
      '                         THEN TRUE'
      '                         ELSE FALSE'
      '                     END AS UltimoPagamentoLote'
      ''
      '             FROM MovtosBancos mb'
      '                  JOIN MovtosBancosEventos mbe'
      '                       JOIN Eventos e'
      '                       ON mbe.Evento = e.Codigo'
      '                  ON mb.Conta     = mbe.Conta AND'
      '                     mb.Data      = mbe.Data  AND'
      '                     mb.Sequencia = mbe.Sequencia'
      ''
      '        WHERE mb.Conta = :Conta'
      '          AND mb.Compensacao BETWEEN :DataInicial AND :DataFinal'
      ''
      '          %WhereEvento'
      '          %WhereTipo'
      '          %Ordenacao'
      ''
      '      ) AS mb'
      '   ) AS mb'
      ')'
      '')
    RequestLive = True
    Left = 232
    Top = 136
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'Conta'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Evento'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataSaldo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataFinal'
        ParamType = ptUnknown
      end>
  end
