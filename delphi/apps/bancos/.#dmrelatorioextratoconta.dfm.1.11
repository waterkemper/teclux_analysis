        '                                  ORDER BY mbe2.Conta, mbe2.Data' +
        ', mbe2.Sequencia'
      '                                           DESC LIMIT 1)'
      '                         THEN TRUE'
      '                         ELSE FALSE'
      '                    END AS ExibirSaldo,'
      ''
      '                    mb.Compensacao,'
      '                    mb.SeqCompensacao,'
      '                    mb.Documento,'
      '                    mbe.Evento,'
      '                    e.Descricao AS DescricaoEvento,'
      '                    mbe.Tipo,'
      '                    mb.OrigemLancto,'
      
        '                    COALESCE(mbe.Observacoes, mb.Observacoes) AS' +
        ' Observacoes,'
      ''
      
        '                    CASE WHEN (mb.Conta, mb.Data, mb.Sequencia, ' +
        'mbe.Evento, mbe.SequenciaEvento) IN'
      
        '                                  (SELECT mbe2.Conta,  mbe2.Data' +
        ', mbe2.Sequencia,'
      
        '                                          mbe2.Evento, mbe2.Sequ' +
        'enciaEvento'
      '                                   FROM MovtosBancosEventos mbe2'
      
        '                                   WHERE mbe2.Conta     = mb.Con' +
        'ta     AND'
      
        '                                         mbe2.Data      = mb.Dat' +
        'a      AND'
      
        '                                         mbe2.Sequencia = mb.Seq' +
        'uencia AND'
      
        '                                        (mbe2.Evento    = :Event' +
        'o OR :Evento = 0)'
      
        '                                   ORDER BY mbe2.Conta, mbe2.Dat' +
        'a, mbe2.Sequencia, mbe2.Evento DESC,'
      
        '                                            mbe2.SequenciaEvento' +
        ' DESC LIMIT 1)'
      '                         THEN TRUE'
      '                         ELSE FALSE'
      '                     END AS UltimoPagamentoLote'
      ''
      '             FROM MovtosBancos mb'
      '                  JOIN MovtosBancosEventos mbe'
      '                       JOIN Eventos e'
      '                       ON mbe.Evento = e.Codigo'
      '                  ON mb.Conta     = mbe.Conta AND'
      '                     mb.Data      = mbe.Data  AND'
      '                     mb.Sequencia = mbe.Sequencia'
      ''
      '        WHERE mb.Conta = :Conta'
      '          AND mb.Data BETWEEN :DataInicial AND :DataFinal'
      ''
      '          %WHEREEvento'
      '          %WHERETipo'
      '          %Ordenacao'
      ''
      '      ) AS mb'
      '   ) AS mb'
      ')'
      '')
