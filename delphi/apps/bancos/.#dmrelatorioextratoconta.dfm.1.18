        '                                   WHERE mbe2.Conta     = mb.Con' +
        'ta     AND'
      
        '                                         mbe2.Data      = mb.Dat' +
        'a      AND'
      
        '                                         mbe2.Sequencia = mb.Seq' +
        'uencia AND'
      
        '                                        (mbe2.Evento    = :Event' +
        'o OR :Evento = 0)'
      
        '                                   ORDER BY mbe2.Conta, mbe2.Dat' +
        'a, mbe2.Sequencia, mbe2.Evento DESC,'
      
        '                                            mbe2.SequenciaEvento' +
        ' DESC LIMIT 1)'
      '                         THEN TRUE'
      '                         ELSE FALSE'
      '                     END AS UltimoPagamentoLote'
      ''
      '             FROM MovtosBancos mb'
      '                  JOIN MovtosBancosEventos mbe'
      '                       JOIN Eventos e'
      '                       ON mbe.Evento = e.Codigo'
      '                  ON mb.Conta     = mbe.Conta AND'
      '                     mb.Data      = mbe.Data  AND'
      '                     mb.Sequencia = mbe.Sequencia'
      ''
      '        WHERE mb.Conta = :Conta'
      '          AND mb.Compensacao BETWEEN :DataInicial AND :DataFinal'
      ''
      '          %WhereEvento'
      '          %WhereTipo'
      '          %Ordenacao'
      ''
      '      ) AS mb'
      '   ) AS mb'
      ')'
      '')
    RequestLive = True
    Left = 232
    Top = 136
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'Conta'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Evento'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataSaldo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataFinal'
        ParamType = ptUnknown
      end>
  end
