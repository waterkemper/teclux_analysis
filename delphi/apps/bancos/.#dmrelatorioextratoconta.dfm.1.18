      '              END AS ValorCredito,'
      ''
      '              CASE WHEN (mb.Tipo = '#39'S'#39') OR'
      '                       ((mb.Tipo = '#39'T'#39') AND (mb.Valor < 0))'
      '                   THEN CASE WHEN :Evento = 0'
      '                             THEN ABS(mb.Valor)'
      '                             ELSE (SELECT ABS(SUM(mbe.Valor))'
      
        '                                      FROM MovtosBancosEventos m' +
        'be'
      
        '                                      WHERE mbe.Conta     = mb.C' +
        'onta     AND'
      
        '                                            mbe.Data      = mb.D' +
        'ata      AND'
      
        '                                            mbe.Sequencia = mb.S' +
        'equencia AND'
      
        '                                            mbe.Evento    = :Eve' +
        'nto)'
      '                        END'
      '                   ELSE 0.00'
      '              END AS ValorDebito,'
      ''
      '              mb.Valor,'
      '              mb.Compensacao,'
      '              mb.SeqCompensacao,'
      '              mb.Documento,'
      '              mb.Evento,'
      '              mb.Tipo,'
      '              mb.OrigemLancto,'
      '              mb.DescricaoEvento, mb.observacoes,'
      '              mb.ExibirSaldo,'
      '              mb.UltimoPagamentoLote,'
      '              mb.ValorEvento'
      ''
      '       FROM'
      '            ('
      '             SELECT mb.Conta,'
      '                    mb.Data,'
      '                    mb.Sequencia,'
      '                    CASE WHEN mb.Evento IS NULL'
      '                         THEN ABS(mbe.Valor)'
