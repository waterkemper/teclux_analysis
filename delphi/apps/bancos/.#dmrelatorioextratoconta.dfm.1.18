        '                                      FROM MovtosBancosEventos m' +
        'be'
      
        '                                      WHERE mbe.Conta     = mb.C' +
        'onta     AND'
      
        '                                            mbe.Data      = mb.D' +
        'ata      AND'
      
        '                                            mbe.Sequencia = mb.S' +
        'equencia AND'
      
        '                                            mbe.Evento    = :Eve' +
        'nto)'
      '                        END'
