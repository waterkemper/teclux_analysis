  object qryMovtosBancos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryMovtosBancosCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'contas'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Evento'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereTipo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Ordenacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select mb.*'
      '('
      ''
      ''
      '('
      ' SELECT ct.conta, b.sigla, ct.digito, ct.titular,'
      '        CAST(NULL AS DATE)        AS Data,'
      '        CAST(NULL AS INTEGER)     AS Sequencia,'
      '        CAST(NULL AS NUMERIC)     AS ValorCredito,'
      '        CAST(NULL AS NUMERIC)     AS ValorDebito,'
      '        CAST(NULL AS NUMERIC)     AS Valor,'
      '        CAST(NULL AS DATE)        AS Compensacao,'
      '        CAST(NULL AS INTEGER)     AS SeqCompensacao,'
      '        CAST(NULL AS VARCHAR(20)) AS Documento,'
      '        CAST(NULL AS INTEGER)     AS Evento,'
      '        CAST(NULL AS CHAR(1))     AS Tipo,'
      '        CAST(NULL AS CHAR(1))     AS OrigemLancto,'
      
        '        CAST('#39'SALDO ANTERIOR'#39' AS VARCHAR(30)) AS DescricaoEvento' +
        ','
      '        CAST(NULL AS VARCHAR)     AS Observacoes,'
      '        TRUE AS ExibirSaldo,'
      '        TRUE AS UltimoPagamentoLote,'
      '        CAST(NULL AS NUMERIC(15,2)) AS ValorEvento,'
      ''
      
        '                                             /* Se for extrato p' +
        'ara um evento espec'#237'fico */'
      
        '        CASE WHEN :FiltrarEvento                /* o saldo n'#227'o f' +
        'az sentido e '#233' zerado       */'
      '             THEN (SELECT SaldoBanco(ct.Conta, :DataSaldo, '#39'L'#39'))'
      '             ELSE 0'
      '        END AS Saldo'
      ''
      ' from contas ct'
      '      join bancos b'
      '      on ct.banco = b.codigo'
      ' %contas'
      ''
      ')'
      'UNION ALL'
      '('
      ' SELECT mb.*,'
      '        CASE WHEN mb.ExibirSaldo'
      '             THEN CASE WHEN :FiltrarEvento'
      
        '                       THEN (SELECT SaldoBanco(mb.Conta, mb.Data' +
        ', '#39'L'#39'))'
      '                       ELSE (SELECT SUM(mbe.Valor)'
      '                                FROM MovtosBancosEventos mbe'
      
        '                                     join eventos e on mbe.event' +
        'o = e.codigo'
      '                                WHERE mbe.Conta  = mb.Conta AND'
      '                                      mbe.Data   = mb.Data'
      '                                      %Evento'
      '                                       )'
      '                  END'
      '             ELSE CAST(NULL AS NUMERIC(15,2))'
      '        END AS Saldo'
      ' FROM'
      '      ('
      '       SELECT mb.Conta, mb.sigla, mb.digito, mb.titular,'
      '              mb.Data,'
      '              mb.Sequencia,'
      '              CASE WHEN (mb.Tipo = '#39'E'#39') OR'
      '                       ((mb.Tipo = '#39'T'#39') AND (mb.Valor > 0))'
      '                   THEN CASE WHEN :FiltrarEvento'
      '                             THEN ABS(mb.Valor)'
      '                             ELSE (SELECT ABS(SUM(mbe.Valor))'
      
        '                                      FROM MovtosBancosEventos m' +
        'be'
      
        '                                           join eventos e on mbe' +
        '.evento = e.codigo'
      
        '                                      WHERE mbe.Conta     = mb.C' +
        'onta     AND'
      
        '                                            mbe.Data      = mb.D' +
        'ata      AND'
      
        '                                            mbe.Sequencia = mb.S' +
        'equencia'
      '                                            %Evento'
      '                                            )'
      '                        END'
      '                   ELSE 0.00'
      '              END AS ValorCredito,'
      ''
      '              CASE WHEN (mb.Tipo = '#39'S'#39') OR'
      '                       ((mb.Tipo = '#39'T'#39') AND (mb.Valor < 0))'
      '                   THEN CASE WHEN :FiltrarEvento'
      '                             THEN ABS(mb.Valor)'
      '                             ELSE (SELECT ABS(SUM(mbe.Valor))'
      
        '                                      FROM MovtosBancosEventos m' +
        'be'
      
        '                                           join eventos e on mbe' +
        '.evento = e.codigo'
      
        '                                      WHERE mbe.Conta     = mb.C' +
        'onta     AND'
      
        '                                            mbe.Data      = mb.D' +
        'ata      AND'
      
        '                                            mbe.Sequencia = mb.S' +
        'equencia'
      '                                            %Evento'
      '                                            )'
      '                        END'
      '                   ELSE 0.00'
      '              END AS ValorDebito,'
      ''
      '              mb.Valor,'
      '              mb.Compensacao,'
      '              mb.SeqCompensacao,'
      '              mb.Documento,'
      '              mb.Evento,'
      '              mb.Tipo,'
      '              mb.OrigemLancto,'
      '              mb.DescricaoEvento, mb.observacoes,'
      '              mb.ExibirSaldo,'
      '              mb.UltimoPagamentoLote,'
      '              mb.ValorEvento'
      ''
      '       FROM'
      '            ('
      '             SELECT mb.Conta, b.sigla, ct.digito, ct.titular,'
      '                    mb.Data,'
      '                    mb.Sequencia,'
      '                    CASE WHEN mb.Evento IS NULL'
      '                         THEN ABS(mbe.Valor)'
      '                         ELSE CAST(NULL AS NUMERIC(15,2))'
      '                    END AS ValorEvento,'
      ''
      
        '                    CASE WHEN mbe.tipo = '#39'T'#39' then mb.valor else ' +
        'ABS(mb.Valor) end AS Valor,'
      ''
      
        '                    CASE WHEN (mbe.Conta, mbe.Data, mbe.Sequenci' +
        'a) ='
      
        '                              (SELECT mbe2.Conta, mbe2.Data, mbe' +
        '2.Sequencia'
      '                                  FROM MovtosBancosEventos mbe2'
      
        '                                  WHERE mbe2.Conta = mbe.Conta A' +
        'ND'
      '                                        mbe2.Data  = mbe.Data'
      
        '                                  ORDER BY mbe2.Conta, mbe2.Data' +
        ', mbe2.Sequencia'
      '                                           DESC LIMIT 1)'
      '                         THEN TRUE'
      '                         ELSE FALSE'
      '                    END AS ExibirSaldo,'
      ''
      '                    mb.Compensacao,'
      '                    mb.SeqCompensacao,'
      '                    mb.Documento,'
      '                    mbe.Evento,'
      '                    e.Descricao AS DescricaoEvento,'
      '                    mbe.Tipo,'
      '                    mb.OrigemLancto,'
      
        '                    COALESCE(mbe.Observacoes, mb.Observacoes) AS' +
        ' Observacoes,'
      ''
      
        '                    CASE WHEN (mb.Conta, mb.Data, mb.Sequencia, ' +
        'mbe.Evento, mbe.SequenciaEvento) IN'
      
        '                                  (SELECT mbe2.Conta,  mbe2.Data' +
        ', mbe2.Sequencia,'
      
        '                                          mbe2.Evento, mbe2.Sequ' +
        'enciaEvento'
      '                                   FROM MovtosBancosEventos mbe2'
      
        '                                        join eventos e on mbe2.e' +
        'vento = e.codigo'
      ''
      
        '                                   WHERE mbe2.Conta     = mb.Con' +
        'ta     AND'
      
        '                                         mbe2.Data      = mb.Dat' +
        'a      AND'
      
        '                                         mbe2.Sequencia = mb.Seq' +
        'uencia'
      '                                         %Evento'
