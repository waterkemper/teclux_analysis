      '             mb.Sequencia,'
      '             case when mb.evento is null then'
      '               abs(mbe.valor)'
      
        '             else cast(null as numeric(15,2))  end as valorevent' +
        'o,'
      ''
      '             abs(mb.valor) as valor,'
      ''
      
        '             case when (mb.conta, mb.compensacao, mb.seqcompensa' +
        'cao) ='
      
        '                       (select mb2.conta, mb2.compensacao, mb2.s' +
        'eqcompensacao'
      '                        from movtosbancos mb2'
