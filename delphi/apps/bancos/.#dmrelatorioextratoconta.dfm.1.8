    Sql.Strings = (
      '('
      ' SELECT cast(:Conta as integer) as conta,'
      '        cast(null as date) as Data,'
      '        cast(null as integer) as Sequencia,'
      '        cast(null as numeric) as ValorCredito,'
      '        cast(null as numeric) as ValorDebito,'
      '        cast(null as numeric) as Valor,'
      '        cast(null as date) as Compensacao,'
      '        cast(null as integer) as SeqCompensacao,'
      '        cast(null as varchar(20)) as Documento,'
      '        cast(null as integer) as Evento,'
      '        cast(null as char(1)) as Tipo,'
      '        cast(null as char(1)) as OrigemLancto,'
      
        '        cast('#39'SALDO ANTERIOR'#39' as varchar(30)) as descricaoevento' +
        ','
      '        cast(null as varchar) as Observacoes,'
      '        true as ExibirSaldo,'
      '        cast(null as numeric(15,2)) as valorevento,'
      #9#9'     True as UltimoPagamentoLote,'
      '        (SELECT SaldoBanco(:conta, :DataSaldo, '#39'C'#39')) as Saldo'
      #9#9
      #9#9
      ')'
      'union all'
      '('
      '  select mb.*,'
      '         (case when mb.exibirSaldo then'
      '            (SELECT SaldoBanco(mb.Conta, mb.Compensacao, '#39'C'#39'))'
      '          else cast(null as numeric(15,2)) end) as Saldo'
      '  from'
      '    ('
      '    select mb.conta, mb.data, mb.sequencia,'
      ''
      ''
      '           CASE WHEN (mb.Tipo = '#39'E'#39') OR'
      '                    ((mb.Tipo = '#39'T'#39') AND (mb.Valor > 0))'
      '                THEN ABS(mb.Valor)'
      '                ELSE 0.00'
      '           END AS ValorCredito,'
      ''
      '           CASE WHEN (mb.Tipo = '#39'S'#39') OR'
      '                    ((mb.Tipo = '#39'T'#39') AND (mb.Valor < 0))'
      '               THEN ABS(mb.Valor)'
      '               ELSE 0.00'
      '           END AS ValorDebito,'
      ''
      
        '           mb.valor, mb.Compensacao, mb.SeqCompensacao, mb.Docum' +
        'ento, mb.evento, mb.tipo,'
      '           mb.OrigemLancto, mb.descricaoevento, mb.Observacoes,'
      '/*'
      '           Case WHEN (((SELECT MAX(ABS(Valor))'
      '                           FROM MovtosBancos'
      '                           WHERE Conta = mb.Conta AND'
      
        '                                 Compensacao = mb.Compensacao) =' +
        ' ABS(mb.Valor)) AND'
      ''
      '                      ((SELECT MAX(SeqCompensacao)'
      '                           FROM MovtosBancos'
      '                           WHERE Conta = mb.Conta AND'
      
        '                                 Compensacao = mb.Compensacao AN' +
        'D'
      
        '                                 ABS(Valor)  = (SELECT MAX(ABS(V' +
