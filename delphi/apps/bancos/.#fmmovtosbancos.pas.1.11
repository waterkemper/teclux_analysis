procedure TfrmMovtosBancos.edtDocumentoKeyPress(Sender: TObject;
  var Key: Char);
begin
  inherited;
   if (key = #13) then
     dbgMovtosBancosEventos.SelectedIndex := 0
end;

procedure TfrmMovtosBancos.CondicoesContas;
const
  SQL = ' and (c.conta not in (%s) or c.conta = %s) ';
begin
  if (dtmMovtosBancos.qryMovtosBancosEventoscontatransf.AsInteger<>0) and
     not (dtmMovtosBancos.qryMovtosBancosEventos.state = dsinsert) then
  begin
    ConsultaContas.qryProcuraContas.MacroByName('condicoes').AsString :=
      format(SQL,[dtmMovtosBancos.ListaContasCadastradas,
                  inttostr(dtmMovtosBancos.qryMovtosBancosEventoscontatransf.asinteger)]);

    ConsultaContas.qryConsultaContas.MacroByName('condicoes').AsString :=
      format(SQL,[dtmMovtosBancos.ListaContasCadastradas,
                  inttostr(dtmMovtosBancos.qryMovtosBancosEventoscontatransf.asinteger)]);
  end
  else
  begin
    ConsultaContas.qryProcuraContas.MacroByName('condicoes').AsString :=
      format(SQL,[dtmMovtosBancos.ListaContasCadastradas,
                  inttostr(0)]);

    ConsultaContas.qryConsultaContas.MacroByName('condicoes').AsString :=
      format(SQL,[dtmMovtosBancos.ListaContasCadastradas,
                  inttostr(0)]);

  end;

  if ParSistema.GerarContabilidade then
  begin
    ConsultaContas.qryProcuraContas.MacroByName('condicoes').AsString :=
    ' and c.contacontabil is not null' +
    ConsultaContas.qryProcuraContas.MacroByName('condicoes').AsString;

    ConsultaContas.qryConsultaContas.MacroByName('condicoes').AsString :=
    ' and c.contacontabil is not null' +
    ConsultaContas.qryConsultaContas.MacroByName('condicoes').AsString;
  end;

  if not dtmMovtosBancos.qryMovtosBancosEventos.IsEmpty then
  begin
    if (dtmMovtosBancos.qryMovtosBancosTipo.AsString = 'S') or
       (dtmMovtosBancos.qryMovtosBancosTipo.AsString = 'T') then
    begin
      ConsultaContas.qryProcuraContas.MacroByName('condicoes').AsString :=
      ' and true ' +
      ConsultaContas.qryProcuraContas.MacroByName('condicoes').AsString;

      Consultacontas.qryConsultaContas.MacroByName('condicoes').AsString :=
      ' and true '+
      ConsultaContas.qryConsultaContas.MacroByName('condicoes').AsString;
    end
    else
    if dtmMovtosBancos.qryMovtosBancosTipo.AsString = 'E' then
    begin
      ConsultaContas.qryProcuraContas.MacroByName('condicoes').AsString :=
      ' and false ' +
      ConsultaContas.qryProcuraContas.MacroByName('condicoes').AsString;

      Consultacontas.qryConsultaContas.MacroByName('condicoes').AsString :=
      ' and false '+
      ConsultaContas.qryConsultaContas.MacroByName('condicoes').AsString;
    end;
  end;

end;

procedure TfrmMovtosBancos.AtribuirDadosContas;
begin
  with dtmMovtosBancos do
  begin
    if (qryMovtosBancosEventoscontatransf.AsString <> ConsultaContas.qryProcuraContas.fieldbyname('conta').AsString) or
       (qryMovtosBancosEventosdigito.AsString <> ConsultaContas.qryProcuraContas.fieldbyname('digito').AsString) or
       (qryMovtosBancosEventossigla.AsString <> ConsultaContas.qryProcuraContas.fieldbyname('sigla').AsString) or
       (qryMovtosBancosEventosnomeagencia.AsString <> ConsultaContas.qryProcuraContas.fieldbyname('agencia').AsString) then
    begin
      EditarMovtosBancosEventos;
      EditarMovtosBancos;

      qryMovtosBancosEventoscontatransf.AsString := ConsultaContas.qryProcuraContas.fieldbyname('conta').AsString;
      qryMovtosBancosEventossigla.AsString := ConsultaContas.qryProcuraContas.fieldbyname('sigla').AsString;
      qryMovtosBancosEventosnomeagencia.AsString := ConsultaContas.qryProcuraContas.fieldbyname('agencia').AsString;
      qryMovtosBancosEventosdigito.AsString := ConsultaContas.qryProcuraContas.fieldbyname('digito').AsString;

      qryMovtosBancosEventoscontavalidada.AsBoolean := true;
    end;
  end;
end;

procedure TfrmMovtosBancos.fraLerContaCorrenteSaldo1edfContaFound(
  Found: Boolean);
begin
  inherited;
  if found then
  begin

   with dtmMovtosBancos do
   begin
      if ContaEstaDefinida and NumeroContaFoiAlterado then begin
         AcessarUltimoMovtosBancos;

         if qryProcuraContasSaldoLancado.AsCurrency < 0
         then fraLerContaCorrenteSaldo1.dtxSaldo.Font.Color:= clRed
         else fraLerContaCorrenteSaldo1.dtxSaldo.Font.Color:= clBlack;

         qryUltimoLancto.ParamByName('Conta').AsString:= qryProcuraContasConta.AsString;
         UltimaDataLancamento;
{        fraLerContaCorrenteSaldo1.gbxSaldo.Caption:= 'SALDO LANÇADO ATÉ ' + qryUltimoLanctoData.AsString;
}
         edfData.SetFocus;
      end;
   end;

  end;
end;

procedure TfrmMovtosBancos.GravarMovtosBancos(Sender: TObject);
var Frm: TForm;

begin
  Frm:= TfrmConciliacaoBancaria.Referencia;
  if Assigned(Frm) then
  with dtmConciliacaoBancaria do
  begin
      {
      ReFazConsulta(qryProcuraContas, [0],
                   [qryProcuraContasConta.AsVariant]);
      }

     ReFazConsulta(qryProcuraContas, [0],
                  [dtmMovtosBancos.qryProcuraContasConta.AsVariant]);
     TfrmConciliacaoBancaria(Frm).ExibirSaldoLancado(Self);
     TfrmConciliacaoBancaria(Frm).ExibirMovtosConciliacao;
  end;
end;

