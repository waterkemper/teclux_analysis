begin
  inherited;
  AcionarTelaVisualizarLog(self, 'movtosbancos_log', ['conta','data','sequencia'],
    [dtmMovtosBancos.qryMovtosBancosConta.asString,
     quotedstr(dtmMovtosBancos.qryMovtosBancosData.asString),
     dtmMovtosBancos.qryMovtosBancosSequencia.asString], '');

end;

procedure TfrmMovtosBancos.SpeedButton1Click(Sender: TObject);
begin
  inherited;
  AcionarTelaVisualizarLog(self, 'movtosbancoseventos_log',
                ['conta','data','sequencia','evento', 'sequenciaevento'],

    [dtmMovtosBancos.qryMovtosBancosConta.asString,
     quotedstr(dtmMovtosBancos.qryMovtosBancosData.asString),
     dtmMovtosBancos.qryMovtosBancosSequencia.asString,
     dtmMovtosBancos.qryMovtosBancoseventosEvento.asString,
     dtmMovtosBancos.qryMovtosBancoseventosSequenciaEvento.asString], '');

end;

