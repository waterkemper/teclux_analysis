package bancos;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Controle Bancário'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  repositorio,
  rtl,
  dbrtl,
  ZDbware6,
  vcldb,
  vcl,
  visualdbclx,
  visualclx,
  designide,
  vclactnband,
  vclx,
  ZCommon6,
  ZPgSql6,
  tecsoft6,
  TMSD7,
  bdertl,
  vcljpg,
  VclSmp,
  xmlrtl,
  inet,
  IndySystem70,
  IndyCore70,
  IndyProtocols70,
  frx,
  ExportarExcel,
  ACBr_OpenSSL,
  ACBr_Comum,
  ACBr_synapse,
  pngimage_D7,
  dsnap;

contains
  rgbancos in 'rgbancos.pas',
  dmmovtosbancos in 'dmmovtosbancos.pas' {dtmMovtosBancos: TDataModule},
  fmconciliacaobancaria in 'fmconciliacaobancaria.pas' {frmConciliacaoBancaria},
  fmmovtosbancos in 'fmmovtosbancos.pas' {frmMovtosBancos},
  fmrelatorioextratoconta in 'fmrelatorioextratoconta.pas' {frmRelatorioExtratoConta},
  dmrelatorioextratoconta in 'dmrelatorioextratoconta.pas' {dtmRelatorioExtratoConta: TDataModule},
  dmconciliacaobancaria in 'dmconciliacaobancaria.pas' {dtmConciliacaoBancaria: TDataModule},
  dmbalancetefinanceiro in 'dmbalancetefinanceiro.pas' {dtmbalancetefinanceiro: TDataModule},
  fmbalancetefinanceiro in 'fmbalancetefinanceiro.pas' {frmbalancetefinanceiro},
  dmImportacaoconciliacao in 'dmImportacaoconciliacao.pas' {dtmImportacaoConciliacao: TDataModule},
  fmImportacaoConciliacao in 'fmImportacaoconciliacao.pas' {frmImportacaoConciliacao};

end.
