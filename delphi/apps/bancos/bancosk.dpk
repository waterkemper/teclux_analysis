package bancosk;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Controle de movimentacao de contas do tecLUX'}
{$SONAME 'bancos'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  baseclx,
  visualclx,
  repositoriok;

contains
  dmconciliacaobancaria in 'dmconciliacaobancaria.pas' {dtmConciliacaoBancaria: TDataModule},
  dmmovtosbancos in 'dmmovtosbancos.pas' {dtmMovtosBancos: TDataModule},
  fmconciliacaobancaria in 'fmconciliacaobancaria.pas' {frmConciliacaoBancaria},
  fmmovtosbancos in 'fmmovtosbancos.pas' {frmMovtosBancos},
  rgbancos in 'rgbancos.pas',
  dmrelatorioextratoconta in 'dmrelatorioextratoconta.pas' {dtmRelatorioExtratoConta: TDataModule},
  fmrelatorioextratoconta in 'fmrelatorioextratoconta.pas' {frmRelatorioExtratoConta};

end.
