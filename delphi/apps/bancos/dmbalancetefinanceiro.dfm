  object qryEventos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterScroll = qryEventosAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'SoEventosComMovimento'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Sintetico'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'SELECT DISTINCT sf.Evento,'
      '                e.Classificacao,'
      '                e.Tipo,'
      ''
      '                CASE WHEN :ImprimirCodigoEvento AND e.tipo = '#39'A'#39
      
        '                     THEN CAST(e.Classificacao || '#39'       '#39' || T' +
        'O_CHAR(e.Codigo, '#39'999999'#39') || '#39'   '#39' || e.Descricao AS VARCHAR)'
      
        '                     ELSE CAST(e.Classificacao || '#39'       '#39' || e' +
        '.Descricao AS VARCHAR)'
      '                END AS Descricao,'
      ''
      '                CASE WHEN :ImprimirCodigoEvento AND e.Tipo = '#39'A'#39
      
        '                     THEN CAST(REPEAT('#39' '#39', LENGTH(BTRIM(e.Classi' +
        'ficacao))) || TO_CHAR(e.Codigo, '#39'999999'#39') || '#39'   '#39' || e.Descrica' +
        'o AS VARCHAR)'
      
        '                     ELSE CAST(REPEAT('#39' '#39', LENGTH(BTRIM(e.Classi' +
        'ficacao))) || e.Descricao AS VARCHAR)'
      '                END AS DescricaoEdentada'
      ''
      '   FROM SaldosFinanceiros sf'
      '        JOIN Eventos e ON sf.Evento = e.Codigo'
      ''
      '   WHERE TRUE'
      ''
      '         %SoEventosComMovimento'
      '         %Sintetico'
      ''
      '   ORDER BY Classificacao, Descricao;'
      ''
      '')
    RequestLive = False
    Left = 56
    Top = 304
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'ImprimirCodigoEvento'
        ParamType = ptUnknown
      end>
    object qryEventosEvento: TIntegerField
      FieldName = 'Evento'
    end
    object qryEventosClassificacao: TStringField
      FieldName = 'Classificacao'
      Size = 4
    end
    object qryEventosTipo: TStringField
      FieldName = 'Tipo'
      Size = 1
    end
    object qryEventosDescricao: TStringField
      DisplayWidth = 100
      FieldName = 'Descricao'
      Size = 100
    end
    object qryEventosDescricaoEdentada: TStringField
      FieldName = 'DescricaoEdentada'
      Size = 43
    end
  end
