    DataSet = qryEventos
    OpenDataSource = False
    Left = 432
    Top = 8
  end
  object qryEventosTotal: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'evento = evento'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrEventos
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Sintetico'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'SELECT * FROM'
      '('
      ' SELECT sf.Exercicio,'
      '        sf.Evento,'
      '        e.Classificacao, e.Tipo,'
      ''
      '        CASE WHEN :ImprimirCodigoEvento AND e.tipo = '#39'A'#39
      
        '             THEN CAST(e.Classificacao || '#39'       '#39' || TO_CHAR(e' +
        '.Codigo, '#39'999999'#39') || '#39'   '#39' || e.Descricao AS VARCHAR)'
      
        '             ELSE CAST(e.Classificacao || '#39'       '#39' || e.Descric' +
        'ao AS VARCHAR)'
      '        END AS Descricao,'
      ''
      '        CASE WHEN :ImprimirCodigoEvento AND e.Tipo = '#39'A'#39
      
        '             THEN CAST(REPEAT('#39' '#39', LENGTH(BTRIM(e.Classificacao)' +
        ')) || TO_CHAR(e.Codigo, '#39'999999'#39') || '#39'   '#39' || e.Descricao AS VAR' +
        'CHAR)'
      
        '             ELSE CAST(REPEAT('#39' '#39', LENGTH(BTRIM(e.Classificacao)' +
        ')) || e.Descricao AS VARCHAR)'
      '        END AS DescricaoEdentada,'
      ''
      '        CAST('#39'JUL/2014'#39' AS VARCHAR(8)) AS Mes,'
      '        COALESCE(sf.TotalMes[7], 0) AS SaldoMesNormal,'
      '        ABS(COALESCE(sf.TotalMes[7], 0)) AS SaldoMes'
      ''
      '    FROM SaldosFinanceiros sf'
      '          JOIN Eventos e ON sf.Evento = e.Codigo'
      ''
      '    WHERE sf.Exercicio = 2014'
      '          %Sintetico'
      ') AS s'
      ''
      'ORDER BY Classificacao, Descricao;'
      '')
    RequestLive = True
    Left = 216
    Top = 136
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'ImprimirCodigoEvento'
        ParamType = ptUnknown
      end>
    object qryEventosTotalExercicio: TIntegerField
      FieldName = 'Exercicio'
      DisplayFormat = '0'
    end
    object qryEventosTotalEvento: TIntegerField
      FieldName = 'Evento'
      DisplayFormat = '0'
    end
    object qryEventosTotalClassificacao: TStringField
      FieldName = 'Classificacao'
      Size = 4
    end
    object qryEventosTotalTipo: TStringField
      FieldName = 'Tipo'
      Size = 1
    end
    object qryEventosTotalDescricao: TStringField
      DisplayWidth = 100
      FieldName = 'Descricao'
      Size = 100
    end
    object qryEventosTotalDescricaoEdentada: TStringField
      DisplayWidth = 100
      FieldName = 'DescricaoEdentada'
      Size = 100
    end
    object qryEventosTotalMes: TStringField
      FieldName = 'Mes'
      Size = 7
    end
    object qryEventosTotalSaldoMes: TFloatField
      FieldName = 'SaldoMes'
      DisplayFormat = '0.00'
    end
    object qryEventosTotalSaldoMesNormal: TFloatField
      FieldName = 'SaldoMesNormal'
      DisplayFormat = '0.00'
    end
  end
