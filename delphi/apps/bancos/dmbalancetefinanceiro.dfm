  object qryContasBancarias: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT DISTINCT c.Conta,'
      
        '                CAST(StrTrocar(TRIM(TO_CHAR(c.Conta,'#39'999,999,999' +
        #39')),'#39','#39','#39'.'#39') || '#39'-'#39' || c.Digito AS VARCHAR) AS ContaDigito,'
      
        '               (SELECT b.Sigla FROM Bancos   b WHERE b.Codigo = ' +
        'c.Banco) AS Banco,'
      
        '               (SELECT a.Nome  FROM Agencias a WHERE a.Codigo = ' +
        'c.Agencia AND a.Banco = c.Banco) AS Agencia,'
      '                SaldoBanco(c.Conta, CURRENT_DATE, '#39'L'#39') AS Saldo,'
      '                FALSE AS Selecionada'
      ''
      'FROM Contas c'
      ''
      'WHERE NOT :SoContasComSaldo OR'
      '      SaldoBanco(c.Conta, CURRENT_DATE, '#39'L'#39') <> 0'
      ''
      'ORDER BY c.Conta'
      '')
    RequestLive = True
    Left = 48
    Top = 120
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'SoContasComSaldo'
        ParamType = ptUnknown
      end>
    object qryContasBancariasConta: TIntegerField
      FieldName = 'Conta'
      Required = True
    end
    object qryContasBancariasContaDigito: TStringField
      FieldName = 'ContaDigito'
      Size = 8
    end
    object qryContasBancariasBanco: TStringField
      DisplayWidth = 25
      FieldName = 'Banco'
      Size = 25
    end
    object qryContasBancariasAgencia: TStringField
      DisplayWidth = 50
      FieldName = 'Agencia'
      Size = 50
    end
    object qryContasBancariasSelecionada: TBooleanField
      FieldName = 'Selecionada'
    end
    object qryContasBancariasSaldo: TFloatField
      FieldName = 'Saldo'
      DisplayFormat = '###,###,##0.00'
      EditFormat = '###,###,##0.00'
    end
  end
