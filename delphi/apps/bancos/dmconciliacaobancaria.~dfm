      '       m.SeqCompensacao'
      ''
      'FROM   movtosbancos m LEFT JOIN eventos e ON m.evento = e.Codigo'
      ''
      'WHERE  m.Conta        = :Conta       AND'
      '       m.Compensacao >= :DataInicial AND'
      '       m.Compensacao <= :DataFinal'
