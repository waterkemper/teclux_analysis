      '       m.Observacoes,'
      '       e.Descricao AS EveDescricao,'
      '       m.Valor,'
      '       m.Tipo,'
      ''
      '       CASE WHEN OrigemLancto = '#39'B'#39' THEN CAST('#39' '#39' AS VARCHAR)'
      '            WHEN OrigemLancto = '#39'P'#39' THEN CAST('#39'P'#39' AS VARCHAR)'
