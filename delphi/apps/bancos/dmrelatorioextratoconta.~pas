begin

end;

function TdtmRelatorioExtratoConta.GetParametroCabecalho: String;
var
  DizeresExtrato: String;
begin
   FParametroCabecalho := '';
   case ParametroOrdenacao of
      0: begin
            frVariables['Ordenacao']:= 'Lancamento';
            DizeresExtrato := ' LANÇAMENTOS DE ';
         end;
      1: begin
            frVariables['Ordenacao']:= 'Compensacao';
            DizeresExtrato := ' COMPENSAÇÕES DE ';
         end;
   end;


   FParametroCabecalho := qryMovtosBancosSigla.  AsString + ' - C/C ' +

                          qryMovtosBancosConta.  AsString +  '-'  +
                          qryMovtosBancosDigito. AsString + ' - ' +
                          qryMovtosBancosTitular.AsString + CrLf  +
                          DizeresExtrato + ParametroDataInicial + ' A ' + ParametroDataFinal + CrLf;


  Result := FParametroCabecalho;
end;

procedure TdtmRelatorioExtratoConta.frpExtratoContaGetValue(
  const ParName: String; var ParValue: Variant);
begin
  inherited;
  if ParName = 'SubTitulo' then
    ParValue := ParametroCabecalho;
end;

end.
