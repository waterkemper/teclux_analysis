procedure TdtmRelatorioExtratoConta.ImprimirExtratoConta;
const  {WhereEvento  = 'AND mbe.Evento = %s';}
      WhereDebito  = 'AND mbe.Tipo   = ''E''';
      WhereCredito = 'AND mbe.Tipo   = ''S''';

      OrdenacaoLancamento  = 'ORDER BY mb.conta, coalesce(mb.Data, cast(:datainicial as date)), coalesce(mb.Sequencia, cast(0 as integer)), mb.Evento, mb.SequenciaEvento';
      OrdenacaoCompensacao = 'ORDER BY mb.conta, coalesce(mb.Compensacao, cast(:datainicial as date)), coalesce(mb.SeqCompensacao, cast(0 as integer)), mb.Evento, mb.SequenciaEvento';

{ar    Relatorio: TfrReport;
       frmPreview: TfrmPreviewPadrao; }
{      DizeresExtrato: String;}

begin

{   FParametroCabecalho := '';}
   case ParametroOrdenacao of
      0: begin
            frVariables['Ordenacao']:= 'Lancamento';
            qryMovtosBancos.Sql.Text:= qryMovtosBancos_Data.Sql.Text;
            qrymovtosBancos.MacroByName('Ordenacao').AsString := OrdenacaoLancamento;
{            DizeresExtrato := ' LANÇAMENTOS DE ';}
         end;
      1: begin
            frVariables['Ordenacao']:= 'Compensacao';
            qryMovtosBancos.Sql.Text := qryMovtosBancos_Compensacao.Sql.Text;
            qrymovtosBancos.MacroByName('Ordenacao').AsString := OrdenacaoCompensacao;
{            DizeresExtrato := ' COMPENSAÇÕES DE ';}
         end;
   end;

   qryMovtosBancos.ParamByName('DataInicial').AsString:= ParametroDataInicial;
   qryMovtosBancos.ParamByName('DataFinal').  AsString:= ParametroDataFinal;

   if ParametroConta<>'' then
     qryMovtosBancos.MacroByName('Contas').AsString := ' and (' + ParametroConta + ')'
   else
     qryMovtosBancos.MacroByName('Contas').AsString := '';

   qryMovtosBancos.ParamByName('DataSaldo').  AsString:= DateToStr(StrToDate(ParametroDataInicial) - 1);

   {
   FParametroCabecalho := qryProcuraContasSigla.  AsString + ' - C/C ' +
                          qryProcuraContasConta.  AsString +  '-'  +
                          qryProcuraContasDigito. AsString + ' - ' +
                          qryProcuraContasTitular.AsString + CrLf  +
                          DizeresExtrato + ParametroDataInicial + ' A ' + ParametroDataFinal + CrLf;
   }

   if ParametroEvento<>'' then
   begin
     qryMovtosBancos.ParamByName('FiltrarEvento').AsBoolean := false;
     qryMovtosBancos.MacroByName('Evento').AsString := ' and (' + ParametroEvento +' ) ';
   end
   else
   begin
     qryMovtosBancos.MacroByName('Evento').AsString := '';
     qryMovtosBancos.ParamByName('FiltrarEvento').AsBoolean := True;
   end;


   {
   if ParametroEvento <> ''
   then qrymovtosBancos.MacroByName('WhereEvento').AsString := Format(WhereEvento,[parametroevento])
   else qrymovtosBancos.MacroByName('WhereEvento').AsString := '';
   }

   if ParametroDebito and not ParametroCredito then begin
      qrymovtosBancos.MacroByName('WhereTipo').AsString := WhereDebito;
      FParametroCabecalho:= FParametroCabecalho + ' - DÉBITOS';
   end
   else if not ParametroDebito and ParametroCredito then begin
           qrymovtosBancos.MacroByName('WhereTipo').AsString := WhereCredito;
           FParametroCabecalho := FParametroCabecalho + ' - CRÉDITOS';
        end;

   Refazconsulta(qryMovtosBancos,[],[]);
   frVariables['Titulo']:= 'EXTRATO DE CONTA';
   frVariables['SubTitulo'] := FParametroCabecalho;
   frpExtratoConta.DesignReport;
   frxReport1.DesignReport;


   ImprimirRelatoriofast(null, FParametroCabecalho, MSimples, 0, [frpExtratoConta], false, self);

   {
   frmPreview := TfrmPreviewPadrao.create(self);
   frmPreview.cmbZoom.ItemIndex := 3; //125%
   try
      Relatorio := frmPreview.frCompositeReport;
      with frmPreview do begin
         frCompositeReport.Reports.Clear;
         frCompositeReport.Reports.Add(frpExtratoConta);
      end;
      Relatorio.Preview := frmPreview.frPreviewPadrao;
      Relatorio.ShowReport;
      frmPreview.ShowModal;

   finally
      frmPreview.Free
   end;
   }

end;

procedure TdtmRelatorioExtratoConta.qryMovtosBancosCalcFields(
  DataSet: TDataSet);
begin
   inherited;
   if qryMovtosBancosDocumento.AsString <> '' then begin

      if qryMovtosBancosOrigemLancto.AsString = 'R'
      then qryMovtosBancosDocumentoObservacoes.AsString:= qryMovtosBancosDocumento.AsString
      else qryMovtosBancosDocumentoObservacoes.AsString:= 'Doc ' +
                                                          qryMovtosBancosDocumento.AsString;

      if qryMovtosBancosObservacoes.AsString <> ''
      then qryMovtosBancosDocumentoObservacoes.AsString :=
           qryMovtosBancosDocumentoObservacoes.AsString + ' - ' +
                                            qryMovtosBancosObservacoes.AsString;
   end
   else qryMovtosBancosDocumentoObservacoes.AsString :=
        qryMovtosBancosObservacoes.AsString;

   case ParametroDocumento of
   0: qryMovtosBancosDocumentoObservacoes.AsString :=
                        copy(qryMovtosBancosDocumentoObservacoes.AsString,0,55);
  end;
end;

