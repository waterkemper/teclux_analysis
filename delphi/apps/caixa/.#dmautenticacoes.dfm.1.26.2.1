    Sql.Strings = (
      ';'
      'select cheques.*'
      'from'
      '('
      '('
      'Select pc.cheque,'
      '          pc.numero,'
      '          pc.datavencto,'
      '          pc.valorvencto,'
      '          pc.datapagto,'
      '          pc.valorpagto,'
      '          pc.resgate,'
      
        '          (case when pc.datapagto is not null then true else fal' +
        'se end) as resgatado,'
      '          (pc.valorvencto * 0) as valordebito,'
      '          false as parcial,'
      '          cast('#39'parcelascheques'#39' as varchar) as origem'
      'From parcelascheques pc'
      'Where pc.cheque = :cheque'
      ')'
      'union all'
      '('
      'select c.numero as cheque,'
      '       cast(1 as integer) as numero,'
      '       c.vencto as datavencto,'
      '       c.valor as valorvencto,'
      '       current_date as datapagto,'
      '       c.valor as valorpagto,'
      '       cast('#39'1'#39' as char(1)) as resgate,'
      '       false as resgatado,'
      '       (c.valor * 0) as valordebito,'
      '       false as parcial,'
      '       cast('#39'cheques'#39' as varchar) as origem'
      'from cheques c'
      
        'where not exists (select pc.cheque from parcelascheques pc where' +
        ' pc.cheque = :cheque)'
      ' and c.numero = :cheque'
      ')'
      ') as cheques'
      'Order by numero, datavencto')
