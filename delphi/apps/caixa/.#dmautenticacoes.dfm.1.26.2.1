  object qryAutenticacoes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select a.numero,'
      '       a.valor,'
      '       a.tipo,'
      '       a.contratoparcela,'
      '       a.parcela,'
      '       a.transacao,'
      '       a.cheque,'
      '       CASE WHEN a.tipo = '#39'P'#39'  THEN cast('#39'Prestacao'#39' as varchar)'
      '            WHEN a.tipo = '#39'T'#39'  THEN cast('#39'Cartao'#39' as varchar)'
      '            WHEN a.tipo = '#39'D'#39'  THEN cast('#39'Documento'#39' as varchar)'
      '            WHEN a.tipo = '#39'N'#39'  THEN cast('#39'Devolucao'#39' as varchar)'
      '            WHEN a.tipo = '#39'B'#39'  THEN cast('#39'Deposito'#39' as varchar)'
      ''
      '            WHEN a.tipo = '#39'H'#39'  THEN'
      '              case when exists (select a2.numero'
      '                                from autenticacoes a2'
      '                                where a2.transacao = a.transacao'
      
        '                                  and a2.tipo = '#39'F'#39' limit 1) the' +
        'n'
      '                      cast('#39'Cheque FC'#39' as varchar)'
      '                  else cast('#39'Cheque'#39' as varchar) end'
      '            WHEN a.tipo = '#39'R'#39'  THEN cast('#39'Resgate'#39' as varchar)'
      '            WHEN a.tipo = '#39'J'#39'  THEN cast('#39'Perda'#39' as varchar)'
      '            WHEN a.tipo = '#39'G'#39'  THEN cast('#39'Duplicata'#39' as varchar)'
      
        '            WHEN a.tipo = '#39'F'#39'  THEN cast('#39'Frente de Caixa'#39' as va' +
        'rchar)'
      
        '            WHEN a.tipo = '#39'A'#39'  THEN cast('#39'Saldo de Troca'#39' as var' +
        'char)'
      
        '            WHEN a.tipo = '#39'S'#39'  THEN cast('#39'Transf. Sa'#237'da'#39' as varc' +
        'har)'
      '            ELSE cast('#39'DESCONHECIDO'#39' as varchar)'
      '       END AS nometipo,'
      ''
      '       cast('
      
        '       CASE WHEN (a.tipo='#39'P'#39') or (a.tipo='#39'T'#39') THEN autenticacoes' +
        '_fitaprestacao(a.numero, a.contratoparcela, a.parcela, a.valor)'
      
        '            WHEN a.tipo = '#39'D'#39'        THEN autenticacoes_fitadocu' +
        'mento(a.numero, a.evento, a.historico, a.parametros, a.valor)'
      
        '            WHEN a.tipo = '#39'N'#39'        THEN autenticacoes_fitadevo' +
        'lucao(a.numero, a.contrato, a.motivo, a.valor)'
      
        '            WHEN a.tipo = '#39'B'#39'        THEN autenticacoes_fitadepo' +
        'sito(a.numero, a.banco, a.data, a.valor)'
      
        '            WHEN a.tipo = '#39'C'#39'        THEN autenticacoes_fitacanc' +
        'elamento(a.numero, a.autenticacao, a.motivo, a.valor)'
      
        '            WHEN a.tipo = '#39'H'#39'        THEN autenticacoes_fitacheq' +
        'ue(a.numero, a.cheque, a.valor)'
      
        '            WHEN a.tipo = '#39'R'#39'        THEN autenticacoes_fitaresg' +
        'ate(a.numero, a.valor)'
      
        '            WHEN a.tipo in ('#39'S'#39','#39'E'#39') THEN autenticacoes_fitatran' +
        'sferencia(a.numero, a.caixa, a.tipo, a.valor)'
      
        '            WHEN a.tipo = '#39'J'#39'        THEN autenticacoes_fitaperd' +
        'a(a.numero, a.contrato, a.motivo, a.valor)'
      
        '            WHEN a.tipo = '#39'G'#39'        THEN autenticacoes_fitadupl' +
        'icata(a.numero, a.documentopag, a.venctoduplicata, a.valor)'
      '            WHEN a.tipo = '#39'F'#39'        THEN '#39'Frente de Caixa'#39
      
        '            WHEN a.tipo = '#39'A'#39'        THEN autenticacoes_fitadevo' +
        'lucaosaldo(a.numero, a.valor)'
      '            ELSE '#39'DESCONHECIDO'#39
      '       END as varchar(250)) AS fita'
      ''
      'from autenticacoes a'
      'where (a.caixa = :caixaatual)'
      '  and (a.data = current_date)'
      '  and (a.filial = :filialbase)'
      '  and a.situacao'
      '  and ('
      '       ('
      '        (a.tipo <> '#39'C'#39') and'
      '        (a.tipo <> '#39'E'#39') and'
      '        (a.confirmacao is null)'
      '       ) or'
      '       ('
      '        (a.tipo = '#39'S'#39') and'
      '        (a.confirmacao is null)'
      '       )'
      '      )'
      'order by a.numero desc')
    RequestLive = False
    Left = 264
    Top = 8
    ParamData = <
      item
        DataType = ftString
        Name = 'caixaatual'
        ParamType = ptUnknown
        Value = '102'
      end
      item
        DataType = ftUnknown
        Name = 'filialbase'
        ParamType = ptUnknown
      end>
