    Macros = <>
    Sql.Strings = (
      'select c.numero,'
      '       c.filialvenda,'
      '       c.data,'
      '       vficha_situacaocontrato(c.numero) as situacao,'
      '       c.cliente,'
      '       c.taxajuros,'
      '       c.situacao as situacaocontrato,'
      
        '       cast((COALESCE(c.consideracoes,'#39#39') || COALESCE(d.nome,'#39#39')' +
        ') as varchar) as nomedependente, c.valorprazo, c.valorvista,'
      '       (select u.nome'
      '        from usuarios u'
      '        where u.codigo = (select uc.usuario'
      '                          from usuarioscontratos uc'
      
        '                          where uc.contrato = c.numero order by ' +
        'uc.data desc limit 1)) as nomecobrador '
      'from contratos c'
      'left join dependentes d on (d.codigo=c.dependente)'
      'where (c.cliente = :cliente) and'
      '          (c.tipocliente = :tipo) and'
      '          (c.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39')) and'
      
        '          (0 = coalesce((select Count(*) from contratos c1 where' +
        ' c1.origem = c.numero),0)) and'
      
        '          (0 < coalesce((select count(*) from parcelas p where (' +
        'p.contrato = c.numero) and (p.datapagto is null)),0))'
      'order by to_number(c.numero, '#39'99999999999999999999'#39') desc')
    RequestLive = True
    Left = 152
    Top = 8
    ParamData = <
