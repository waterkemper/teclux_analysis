      ' ('
      '  SELECT ct.cliente,'
      '         ct.tipocliente,'
      '         ct.filialvenda,'
      '         ct.data,'
      '         ct.faturamento,'
      '         ct.taxajuros,'
      '         ct.situacao,'
      '         vficha_situacaocontrato(ct.numero) as situacaocontrato,'
      
        '         CAST(COALESCE(ct.consideracoes,'#39#39')||'#39' '#39'||COALESCE((SELE' +
        'CT d.nome'
      '                                              FROM dependentes d'
      
        '                                              WHERE d.codigo = c' +
        't.dependente),'#39#39') AS varchar) as nomedependente,'
      '         ct.valorprazo,'
      '         ct.valorvista,'
      '         parcelas.*'
      '  FROM contratos ct,'
      '  ('
      '   SELECT p.contrato,'
      '          p.numero,'
      '          p.datavencto,'
      '          p.valorvencto,'
      '          p.datapagto,'
      '          p.valorpagto,'
      '          p.parcelaorigem,'
      '          p.tiporecebimento,'
      
        '          (select tr.diasuteis from tiposrecebimentos tr where t' +
        'r.codigo = p.tiporecebimento) as diasuteis,'
      
        '          coalesce((select tr.tiporecebimento from tiposrecebime' +
        'ntos tr where tr.codigo = p.tiporecebimento),'#39'D'#39') as tipotiporec' +
        'ebimento,'
      
        '          coalesce((select tr.descricao from tiposrecebimentos t' +
        'r where tr.codigo = p.tiporecebimento),'#39'DINHEIRO'#39') as recebiment' +
        'o,'
      
        '          coalesce((select tr.numerorecebimentos from tiposreceb' +
        'imentos tr where tr.codigo = p.tiporecebimento),1) as numerorece' +
        'bimentos,'
      
        '          coalesce((select tr.intervalorecebimentos from tiposre' +
        'cebimentos tr where tr.codigo = p.tiporecebimento),0) as interva' +
        'lorecebimentos,'
      '          false as parcial,'
      '          false as parcialsemjuros ,'
      '          p.formapagamento'
      '    FROM  parcelas p'
      '    WHERE p.datapagto IS NULL'
      '  ) AS parcelas'
      '  WHERE ct.numero=parcelas.contrato'
      '    AND ct.situacao IN ('#39'F'#39','#39'N'#39','#39'P'#39')'
      '    AND contratos_atual(ct.numero)'
      ' ) AS contratosparcelas'
      'WHERE contratosparcelas.cliente = :cliente'
      'AND contratosparcelas.tipocliente  = :tipocliente'
      'ORDER BY datavencto, contrato, parcelaorigem '
      ')')
