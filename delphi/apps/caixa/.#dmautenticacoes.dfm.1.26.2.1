  object qryEmitirCupom: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select c.numero'
      'From contratos c'
      'Where c.numero = cast(:contrato as varchar)'
      'and c.situacao in ('#39'F'#39','#39'P'#39')'
      'and (os IS NULL OR os='#39'false'#39')'
      'and c.emitirnotadepoisde is null'
      'and (((Select coalesce(f.transfautomatica,false)'
      '       From filiais f'
      '       Where (f.codigo = :filialbase)'
      '      )'
      '      and (c.filialvenda = :filialbase)'
      '     )'
      '     or (not (Select coalesce(f.transfautomatica,false)'
      '              From filiais f'
      '              Where (f.codigo = :filialbase)'
      '             )'
      '             and'
      '             ((Select count(pc.numero)'
      '               From produtoscontratos pc'
      '               Where (pc.contrato = c.numero)'
      '               and (pc.filial = :filialbase)'
      '               and (pc.quantidade > coalesce(pc.cancelado,0))'
      '             ) > 0 )'
      '          )'
      '      )'
      'and ('
      '     (Select sum(e.reservado)'
      '      from estoques e'
      '      where (produto,filial) in (select pc.produto,pc.filial'
      '                                 from produtoscontratos pc'
      '                                 where pc.contrato=c.numero'
      
        '                                 AND CASE WHEN (select coalesce(' +
        'transfautomatica,false) FROM filiais WHERE codigo=:filialbase) T' +
        'HEN true ELSE pc.filial=:filialbase END'
      
        '                                 and (pc.quantidade>coalesce(pc.' +
        'cancelado,0))'
      '                                )'
      '     )'
      '     -'
      '     (Select coalesce(sum(pdf.quantidade),0)'
      '      from produtosdadosfiscais pdf,dadosfiscais df'
      '      where (produto,filial) in (select pc.produto,pc.filial'
      '                                 from produtoscontratos pc'
      '                                 where pc.contrato=c.numero'
      
        '                                 and (pc.quantidade>coalesce(pc.' +
        'cancelado,0))'
      '                                )'
      '      and pdf.dadofiscal=df.numero'
      '      and df.contrato=c.numero'
      '      and df.situacao='#39'N'#39
      '      and not coalesce(df.notavinculada,false)'
      '     )'
      '    )>0')
    RequestLive = False
    Left = 544
    Top = 440
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'contrato'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filialbase'
