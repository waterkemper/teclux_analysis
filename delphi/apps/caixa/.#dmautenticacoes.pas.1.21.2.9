begin
  if qryParcelasResgate.RecordCount > 0 then begin
    Result := not qryParcelasResgateresgatado.AsBoolean;
  end
  else Result := False
end;

function Tdtmautenticacoes.quitarParcelaResgate(nroautenticacao: integer): integer;
var
  valorParcial: real;
begin
  if qryParcelasResgateorigem.asstring = 'parcelascheques' then
  begin
    if qryParcelasResgateparcial.AsBoolean then
    begin
      valorParcial := calcularValorParcial(qryParcelasResgatevalorvencto.asFloat,
                                           qryParcelasResgatevalorpagto.asFloat,
                                           qryParcelasResgatevalordebito.asFloat);

      Result := dtmautenticacoesauxiliar.InserirParcelaResgateParcial(FNumeroCheque,
                                                                      nroautenticacao,
                                                                      qryParcelasResgatedatavencto.asString,
                                                                      (qryParcelasResgatevalorvencto.asFloat - valorParcial),
                                                                      qryParcelasResgateresgate.AsString);
      if Result = mrOK then
        Result := dtmautenticacoesauxiliar.atualizarParcelaResgate(FNumeroCheque,
                                                                   FNumeroParcelaCheque,
                                                                   nroautenticacao,
                                                                   FValorPagamentoParcelaCheque,
                                                                   valorParcial
                                                                   );


    end
    else
      Result := dtmautenticacoesauxiliar.AtualizarParcelaResgate(FNumeroCheque,
                                                                 FNumeroParcelaCheque,
                                                                 nroautenticacao,
                                                                 FValorPagamentoParcelaCheque);
  end
  else
  if qryParcelasResgateorigem.asstring = 'cheques' then {não existe parcelascheques para o tipo normal, somente Devolvido}
  begin
    if qryParcelasResgateparcial.AsBoolean then
    begin
      valorParcial := calcularValorParcial(qryParcelasResgatevalorvencto.asFloat,
                                           qryParcelasResgatevalorpagto.asFloat,
                                           qryParcelasResgatevalordebito.asFloat);
      Result := dtmautenticacoesauxiliar.InserirParcelaResgate(FNumeroCheque,
                                                               nroautenticacao,
                                                               qryParcelasResgatedatavencto.asString,
                                                               qryParcelasResgatedatapagto.asString,
                                                               valorParcial,
                                                               FValorPagamentoParcelaCheque,
                                                               qryParcelasResgateresgate.AsString);
      if Result = mrOK then
        Result := dtmautenticacoesauxiliar.InserirParcelaResgateParcial(FNumeroCheque,
                                                                        nroautenticacao,
                                                                        qryParcelasResgatedatavencto.asString,
                                                                        (qryParcelasResgatevalorvencto.asFloat - valorParcial),
                                                                        qryParcelasResgateresgate.AsString);


    end
    else
      Result := dtmautenticacoesauxiliar.InserirParcelaResgate(FNumeroCheque,
                                                               nroautenticacao,
                                                               qryParcelasResgatedatavencto.asString,
                                                               qryParcelasResgatedatapagto.asString,
                                                               qryParcelasResgatevalorvencto.asFloat,
                                                               FValorPagamentoParcelaCheque,
                                                               qryParcelasResgateresgate.AsString);
  end;
end;

