function Tdtmautenticacoes.autenticarPrestacao(Cartao: Boolean; FormaPagamento: Integer; ValorPagoDinheiro: Currency): integer;
var
  VlParcela, Valor, ValorAux: Real;
  Parcelas: TtecParcelaFormaPagto;
  a, NroParcela: Integer;
begin
  if Cartao and (FormaPagamento > 0) and (ParSistema.TipoTEF <> tsSEMTEF) then
  begin
    Result    := mrOK;
    qryParcelasPrestacao.First;
    while not qryParcelasPrestacao.Eof do
    begin
      if qryParcelasPrestacaovalorpagto.AsFloat = 0 then
      begin
        result := mrCancel;
        MensagemErro(format('O contrato %s e parcela %s esta com o valor de pagamento zerado. Entre em contato com o suporte.',
                     [qryParcelasPrestacaocontrato.AsString, qryParcelasPrestacaonumero.AsString]));
        break;
      end
      else
        qryParcelasPrestacao.next;
    end;

    if result = mrOK then
    begin
      VlParcela := 0;
      Valor     := 0;
      a         := 0;
      ValorAux  := ValorPagoDinheiro;
      SetLength(Parcelas, qryParcelasPrestacao.RecordCount);
      qryParcelasPrestacao.First;
      while Not qryParcelasPrestacao.Eof do
      begin
        VlParcela := VlParcela + qryParcelasPrestacaovalorpagto.AsFloat;
        if qryParcelasPrestacaoformapagamento.AsString = 'D' then
        begin
          ValorPagoDinheiro := ValorPagoDinheiro - qryParcelasPrestacaovalorvencto.AsCurrency;
          Parcelas[a].FormaPagto := 'D';
        end
        else
        if qryParcelasPrestacaovalorvencto.AsCurrency <= ValorPagoDinheiro then
        begin
          ValorPagoDinheiro := ValorPagoDinheiro - qryParcelasPrestacaovalorvencto.AsCurrency;
          FormaPagamento    := 4;
          Parcelas[a].FormaPagto := 'D';
        end
        else
        if ValorPagoDinheiro > 0 then
        begin
          Parcelas[a].FormaPagto := qryParcelasPrestacaoformapagamento.AsString;
          qryParcelasPrestacao.Edit;
          qryParcelasPrestacaovalorpagto.AsCurrency := qryParcelasPrestacaovalorvencto.AsCurrency - ValorPagoDinheiro;
          qryParcelasPrestacaoparcial.asBoolean     := True;
          qryParcelasPrestacao.Post;
          Valor             := ValorPagoDinheiro;
          ValorPagoDinheiro := 0;
          FormaPagamento    := 0;
        end
        else
        begin
          FormaPagamento := 0;
          Parcelas[a].FormaPagto := qryParcelasPrestacaoformapagamento.AsString;
        end;

        Parcelas[a].Numero := qryParcelasPrestacaonumero.AsInteger;
        Result := quitarParcela(FormaPagamento = 4, True, NroParcela);
        if result = mrOK then
          qryParcelasPrestacao.Next
        else
          break;

        Inc(a);
      end;

      try
        if qryParcelasPrestacao.Eof then
        begin
          FValorPagamentoParcela := VlParcela;
          if Result = mrOK then
            result := dtmautenticacoesauxiliar.autenticarPrestacao(FNumeroContrato, Parcelas);
          if (Result = mrOK) and (Valor > 0) then
            result := dtmautenticacoesauxiliar.autenticarPrestacao(FNumeroContrato,
                                                                   NroParcela,
                                                                   Valor,
                                                                   False);
          if Result = mrOK then begin
            FPagamentoEmDinheiro := FPagamentoEmDinheiro + ValorAux;
  {$IFDEF MSWINDOWS}
// Gedovar: rever
//            if Assigned(BackupTEFDiscado) then
 //             BackupTEFDiscado.ApagarArquivo;
  {$ENDIF}
          end;
          FCupomEmitido := False;
          refazConsulta(qryParcelasPrestacao,[0],[FNumeroContrato]);
          if Assigned(DtmCadCtr) then begin
            DtmCadCtr.Free;
            DtmCadCtr := nil;
          end
        end else
          Result := mrCancel;
  {$IFDEF MSWINDOWS}
  // Gedovar : rever
//        if Assigned(BackupTEFDiscado) and (Result <> mrOK) then
//          BackupTEFDiscado.ExecutarBackup;

  {$ENDIF}
      except
        FCupomEmitido := False;
  {$IFDEF MSWINDOWS}
//Gedovar : rever
//        if Assigned(BackupTEFDiscado) then
//          BackupTEFDiscado.ExecutarBackup;
  {$ENDIF}
        if Assigned(DtmCadCtr) then begin
          DtmCadCtr.Free;
          DtmCadCtr := nil;
        end;
        raise;
      end

    end;

  end else if EmitirCupom(False, FormaPagamento, ValorPagoDinheiro) then begin
    try
      result := quitarParcela(True, False, NroParcela);
      if result = mrOK then begin
        result := dtmautenticacoesauxiliar.autenticarPrestacao(FNumeroContrato, FNumeroParcelaContrato,
                                                               FValorPagamentoParcela, Cartao);
        if result = mrOK then begin
          if Not Cartao then
            FPagamentoEmDinheiro := FPagamentoEmDinheiro + FValorPagamentoParcela;
{$IFDEF MSWINDOWS}
// Gedovar : rever
//          if Assigned(BackupTEFDiscado) and Cartao then
//            BackupTEFDiscado.ApagarArquivo;
{$ENDIF}
          refazConsulta(qryParcelasPrestacao,[0],[FNumeroContrato]);
          if Not qryParcelasPrestacao.Locate('quitado', 'False', []) then
          begin
            MensagemAviso(ctCONTRATOQUITADO);
            //jr 03/08
            {if not qryContratosPrestacao.Eof then
            begin
              ReFazConsultaContrato;
            end;}
          end;
          PosParcelaAutenticavel := qryParcelasPrestacao.GetBookmark;
        end
      end;
      if (result <> mrOK) and FCupomEmitido then
        ECFPadrao.CancelarCupom;
      FCupomEmitido := False;
      if Assigned(DtmCadCtr) then begin
        DtmCadCtr.Free;
        DtmCadCtr := nil;
      end;
{$IFDEF MSWINDOWS}
// Gedovar : rever
//      if (result <> mrOK) and Assigned(BackupTEFDiscado) then
//        BackupTEFDiscado.ExecutarBackup;
{$ENDIF}
    except
      if FCupomEmitido then
        ECFPadrao.CancelarCupom;
      FCupomEmitido := False;
{$IFDEF MSWINDOWS}
// Gedovar : rever
//      if Assigned(BackupTEFDiscado) then
//        BackupTEFDiscado.ExecutarBackup;
{$ENDIF}
      if Assigned(DtmCadCtr) then begin
        DtmCadCtr.Free;
        DtmCadCtr := nil;
      end;
      raise;
    end
  end else
    result := mrCancel;
end;

function Tdtmautenticacoes.quitarParcela(Dinheiro: Boolean; QuitarNovaParcela: Boolean; var NroParcela: Integer): integer;
var
  valorParcial: real;
begin
  FNumeroContrato        := qryParcelasPrestacaocontrato.asString;
  FNumeroParcelaContrato := qryParcelasPrestacaonumero.asInteger;
  FValorPagamentoParcela := qryParcelasPrestacaovalorpagto.AsFloat;
  FDataVenda             := qrycontratosPrestacaodata.asdatetime;
  FDataVencto            := qryParcelasPrestacaodatavencto.asdatetime;
  FValorVenctoParcela    := qryParcelasPrestacaovalorvencto.AsFloat;
  FPagamentoParcial      := qryParcelasPrestacaoparcial.asBoolean;
  if Dinheiro then
    FFormaPagamento      := 'D'
  else
    FFormaPagamento      := qryParcelasPrestacaoformapagamento.AsString;
  if qryParcelasPrestacaoparcial.asBoolean then
  begin
    if ParcelaSemJuros then
    begin
      valorParcial := calcularValorParcial(qryParcelasPrestacaovalorvencto.asFloat,
                                           qryParcelasPrestacaovalorpagto.asFloat,
                                           qryParcelasPrestacaovalorvencto.asFloat);
    end
    else
    begin
      valorParcial := calcularValorParcial(qryParcelasPrestacaovalorvencto.asFloat,
                                           qryParcelasPrestacaovalorpagto.asFloat,
                                           qryParcelasPrestacaovalordebito.asFloat);
    end;
    if qryParcelasPrestacaovalorvencto.asFloat > valorParcial then
    begin
      result := dtmautenticacoesauxiliar.inserirParcelaContratoParcial(FNumeroContrato,
                                                                       qryParcelasPrestacaodatavencto.asString,
                                                                       (qryParcelasPrestacaovalorvencto.asFloat - valorParcial),
                                                                       qryParcelasPrestacaoParcelaOrigem.asstring,
                                                                       QuitarNovaParcela, qryParcelasPrestacaonumero.AsInteger,
                                                                       NroParcela);
    end
    else
      result := mrOk;

    ParcelaSemJuros := False;
    if result = mrOK then
      result := dtmautenticacoesauxiliar.atualizarParcelaContrato(FNumeroContrato, FNumeroParcelaContrato, valorParcial, FValorPagamentoParcela, FFormaPagamento);
  end else
    result := dtmautenticacoesauxiliar.atualizarParcelaContrato(FNumeroContrato, FNumeroParcelaContrato, FValorPagamentoParcela, FFormaPagamento);
end;

function Tdtmautenticacoes.calcularValorParcial(vlVencto, vlPagto, vlDebito: real): real;
begin
  Result := SimpleRoundTo(((vlVencto * VlPagto)/vlDebito),-2);
end;

