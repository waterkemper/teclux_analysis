function Tdtmautenticacoes.ExisteCliente(campo, codigo: string): boolean;
const
  SQL = '(to_ascii(%s,''latin1'') ilike to_ascii(''%s%s'',''latin1''))';
var
  vNomeCampo : String;
begin
   vNomeCampo := Campo;
  if Campo = 'nomecidade' then
    vNomeCampo:= 'd.nome'
  else if Campo = 'nometipo' then
    vNomeCampo:= 'c.tipo'
  else if Campo = 'nome' then
