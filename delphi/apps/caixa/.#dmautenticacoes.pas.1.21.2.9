procedure Tdtmautenticacoes.VerificaExclusaoCheques;
begin
  if qryAutenticacoestransacao.AsInteger = 0 then
    FExclusaoCheques := (qryAutenticacoestipo.AsString <> 'R') and (qryAutenticacoescheque.AsString <> '')
  else
  begin
    RefazConsulta(qryRecebimentos,[0],[qryAutenticacoestransacao.AsInteger]);
    try
      qryRecebimentos.DisableControls;
      qryRecebimentos.First;
      while not qryRecebimentos.Eof do
      begin
        if qryRecebimentoscheque.AsString <> '' then
        begin
          FExclusaoCheques := true;
          Break;
        end;
        qryRecebimentos.Next;
      end;
    finally
      qryRecebimentos.EnableControls;
    end;
  end;
  if FExclusaoCheques then
    FExclusaoCheques := MensagemConfirmacao(ctCONFIRMAREXCLUSAOCHEQUES) = smbOK;
end;

function Tdtmautenticacoes.ParcelasAbertoTefMesmoContrato: Boolean;
var
  TemCartao: Boolean;

  procedure SelecionarParcelasContratoCartao;
  begin
    qryParcelasAberto.First;
    while not qryParcelasAberto.Eof do
    begin
      if (qryParcelasAbertocontrato.AsString = FContratoParcelasAbertoTef) and
         not qryParcelasAbertoselecionar.AsBoolean then
        MarcarParcelas(False,False);
      qryParcelasAberto.Next;
    end;
  end;

  function ExisteParcelaSelecionadaNaoContratoCartao: Boolean;
  begin
    Result := False;
    qryParcelasAberto.First;
    while not qryParcelasAberto.Eof do
    begin
      Result := qryParcelasAbertoselecionar.AsBoolean and
                (qryParcelasAbertocontrato.AsString <> FContratoParcelasAbertoTef);
      if Result then
        Break;
      qryParcelasAberto.Next;
    end;
  end;

begin
  Result := True;
  TemCartao := False;
  if (ParSistema.TipoTEF <> tsSEMTEF) then
  begin
    try
      GuardarRegistroAtual(qryParcelasAberto,true);
      qryParcelasAberto.First;
      while not qryParcelasAberto.Eof do
      begin
        if qryParcelasAbertoselecionar.AsBoolean then
        begin
          {TemCartao := (qryParcelasAbertotipotiporecebimento.AsString = 'C') or
                       (qryParcelasAbertotipotiporecebimento.AsString = 'B') or
                       (qryParcelasAbertotipotiporecebimento.AsString = 'X');}
          TemCartao:=false;  {Obs Gedoar Atenção: heis a razão de marcar todas as proximas parcelas do mesmo contrato TemCartao:=true} 
          if TemCartao then
          begin
            FContratoParcelasAbertoTef   := qryParcelasAbertocontrato.AsString;
            FNroParcelaParcelasAbertoTef := qryParcelasAbertonumero.AsInteger;
            FValorPagtoParcelasAbertoTef := qryParcelasAbertovalorpagto.AsCurrency;
            Break;
          end;
        end;
        qryParcelasAberto.Next;
      end;

      if TemCartao then
      begin
        Result := not ExisteParcelaSelecionadaNaoContratoCartao;
        if Result then
          if qryParcelasAberto.Locate('contrato;selecionar',VarArrayOf([FContratoParcelasAbertoTef,False]),[]) then
            SelecionarParcelasContratoCartao;
      end;
    finally
      VoltarRegistroAtual(qryParcelasAberto);
    end;
  end;
end;


