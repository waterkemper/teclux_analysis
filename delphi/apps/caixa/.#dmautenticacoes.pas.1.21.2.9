procedure Tdtmautenticacoes.SelecionarAtrasadosData;
var
  RegistroAtual : TBookmark;
begin
  RegistroAtual := qryParcelasAberto.GetBookmark;
  try
    qryParcelasAberto.DisableControls;
    qryParcelasAberto.First;
    while not qryParcelasAberto.Eof do begin
      if qryParcelasAbertodatavencto.AsDateTime <= DataServidor then
        MarcarParcelas(False, False);
      qryParcelasAberto.Next;
    end;
  finally
    qryParcelasAberto.GotoBookmark(RegistroAtual);
    qryParcelasAberto.FreeBookmark(RegistroAtual);
    qryParcelasaberto.EnableControls;
    qryParcelasAberto.ReadOnly := False;
  end;
end;

function Tdtmautenticacoes.ParcelasAbertoAnteriorAutenticada: Boolean;
var
 Contrato: String;
 DataVencto : TDateTime;
 Selecionar : Boolean;
// B1: TBookmark;
begin
  Result := True;
  Contrato := '';
  DataVencto := 0;
  Selecionar := False;
  try
    GuardarRegistroAtual(qryParcelasAberto,True);
    qryParcelasAberto.First;
    while not qryParcelasAberto.Eof do
    begin
      if ((qryParcelasAbertocontrato.AsString = Contrato) and
          (qryParcelasAbertodatavencto.AsDateTime >= DataVencto) and
          ((qryParcelasAbertoselecionar.AsBoolean) and (not Selecionar))) then
      begin
        Result := false;
        break;
      end;
      Contrato := qryParcelasAbertocontrato.AsString;
      DataVencto := qryParcelasAbertodatavencto.AsDateTime;
      Selecionar := qryParcelasAbertoselecionar.AsBoolean;
      qryParcelasAberto.Next;
    end;
  finally
    VoltarRegistroAtual(qryParcelasAberto);
  end;
end;

