constructor Tdtmautenticacoes.Create(AOwner: TComponent);
begin
  inherited;
  PosParcelaAutenticavel := nil;
//  qryConsultaAutenticacoes.ParamByName('caixaatual').asInteger := CodigoUsuario;
  qryConsultaCaixas.ParamByName('caixaatual').asInteger := CodigoUsuario;
  qryCaixas.ParamByName('caixaatual').asInteger := CodigoUsuario;
  dtmautenticacoesauxiliar := Tdtmautenticacoesauxiliar.Create(Self);
  qryClientesCheque.Params[1].AsString := 'C';
  qryDevolucoesSaldo.Params[1].AsString:= 'C';
  qryFornecedores.Params[1].AsString   := 'F';
  if ParSistema.AutenticacaoParcelasModo2 then
    qryParcelasAberto.Params[1].AsString := 'C';
  //Tabelas de Consulta
  qryConsultaContratos.Tag      := ctCaixaConsultaContratos;
  qryConsultaDevolucoes.Tag     := ctCaixaConsultaDevolucoes;
  qryConsultaContratosPerda.Tag := ctCaixaConsultaContratosPerda;
  qryConsultaMotivos.Tag        := ctCaixaConsultaMotivos;
  qryConsultaEventos.Tag        := ctCaixaConsultaEventos;
  qryConsultaCheques.Tag        := ctCaixaConsultaCheques;
  qryConsultaClientes.Tag       := ctCaixaConsultaClientes;
  qryConsultaFornecedores.Tag   := ctCaixaConsultaFornecedores;
  qryConsultaBancos.Tag         := ctCaixaConsultaBancos;
//  qryConsultaAutenticacoes.Tag  := ctCaixaConsultaAutenticacoes;
  qryConsultaCaixas.Tag         := ctCaixaConsultaCaixas;
  qryConsultaAgencias.Tag       := ctCaixaConsultaAgencias;
  qryConsultaTiposAtendimentos.Tag:= ctAtendConsultaTiposAtendimentos;
  qryClientesCheque.Tag         := cttabelas;
  FCupomEmitido                 := False;
end;

function Tdtmautenticacoes.ExisteContrato(campo, codigo: string): boolean;
begin
  refazConsulta(qryConsultaContratos, [0], [codigo]);
  result := ExisteCodigo(qryConsultaContratos, campo, codigo);
end;

procedure Tdtmautenticacoes.FechaTabelasConsulta(tipoConsulta: TtecConsultaAutenticacoes);
