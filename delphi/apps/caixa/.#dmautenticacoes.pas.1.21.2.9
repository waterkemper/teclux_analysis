function Tdtmautenticacoes.AutorizadoParaDevolucao: Boolean;
var
  UsuarioAut: TtecUsuarios;
begin
  Result := True;
  if ParSistema.ExigeSenhaAnalistaCreditoDevolucao then
  begin
     if UsuarioLogin.AnalistaCredito then
       UsuarioAut := ObterAutorizacao(taSENHA, ctPARACANCELAMENTOAUTENTICACAO, ctANALISTACREDITO, '')
     else
       UsuarioAut := ObterAutorizacao(taLOGIN, ctPARACANCELAMENTOAUTENTICACAO, ctANALISTACREDITO, '');

     if not Assigned(UsuarioAut) then
       Result:=false
     else if not UsuarioAut.AnalistaCredito then
       Result:=false;
  end;

  if ParSistema.ExigeSenhaGerenteDevolucao and Result then
  begin
    if UsuarioLogin.GerenteCaixa then
      UsuarioAut := ObterAutorizacao(taSENHA, ctPARACANCELAMENTOAUTENTICACAO, ctGERENTECAIXA, '')
    else
      UsuarioAut := ObterAutorizacao(taLOGIN, ctPARACANCELAMENTOAUTENTICACAO, ctGERENTECAIXA, '');
    if not Assigned(UsuarioAut) then
      Result:=false
    else if not UsuarioAut.GerenteCaixa then
      Result:=false;
  end;
  if not Result then
    MensagemAviso(ctUSUARIOSEMPERMISSAO);
end;

