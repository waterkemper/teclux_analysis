procedure Tdtmautenticacoes.ImprimirReciboParcela(Valor: Real; Observacao: TMemo;
Assinatura: String);
var
  MaxCol, nLinhas, Comp, a, I : Integer;
  Linha: String;
  Relatorio : TStringList;
  Imprimindonaecf : boolean;
  vcontinuar : Boolean;

  procedure Alinhar(Tipo: TAlignment; PosAtual: Integer = 0);
  begin
    case Tipo of
      taCenter: Insert(stringOfChar(' ', (MaxCol - Length(linha)) div 2), Linha, 1);
      taRightJustify: Insert(stringOfChar(' ', MaxCol - Length(linha) - PosAtual), Linha, 1);
    end
  end;

  procedure ImprimirLinha(texto: String;posicao: integer); overload;
  begin
    if a = 1 then
    begin
      if (texto = '') then
        Relatorio.Append(stringOfChar(' ', MaxCol))
      else
        Relatorio.Append(texto);
    end;

    if (texto = '') then
      TextPrinter.writeln
    else
      TextPrinter.WriteTextln(texto, posicao);
  end;


begin
  ImprimindonaECF := assigned(ecfpadrao);
  NomeImpressoraEscolhida := parsistema.NomeImpressoraFechamentoCaixa;
  vcontinuar := assigned(ECFPadrao) or (NomeImpressoraEscolhida<>'');

  if not vcontinuar then
  begin
    frmSelecionarImpressoras := TfrmSelecionarImpressoras.Create(frmSelecionarImpressoras, 'F');
    try
      if frmSelecionarImpressoras.ShowModal = mrok then
      begin
        NomeImpressoraEscolhida := frmSelecionarImpressoras.NomeImpressora;
        vcontinuar := True;
      end
      else
      begin
        vcontinuar := False;
        MensagemAviso(ctSELECIONARIMPRESSORA);
      end;
    finally
      frmSelecionarImpressoras.Free;
    end;
  end;

  if vcontinuar then
  begin
    Relatorio := TStringList.Create;
    try
      if ParSistema.MaxColAutenticadora <> 0 then
        MaxCol := ParSistema.MaxColAutenticadora
      else
        MaxCol := 60;

      with TextPrinter do
      begin
        if ImprimindonaECF then
          ImprimirParaArquivo := True
        else
          ImprimirParaArquivo := False;
        Text.Clear;


        for a := 1 to ParSistema.NumeroCopiasdorecibo do
        begin

          if ParSistema.Autenticadora in [1,2,4] then
          begin
            BeginDoc('', False);
  //          Relatorio.Append(Esc8lpp+Esc12cpp+EscDraft+EscCondensedOn+EscLargeOff);
          end
          else
          begin
            BeginDoc('', True);
            writeText(EPS_ON_CONDENSED,0);
          end;


          Linha := RazaoFilialBase;
          Alinhar(taCenter);
          ImprimirLinha(linha, 0);

          Linha := RuaFilialBase + ' - ' + BairroFilialBase;
          Alinhar(taCenter);
          ImprimirLinha(linha, 0);

          Linha := FormatarCEP(CEPFilialBase) + ' - ' + CidadeFilialBase + ' - ' + EstadoFilialBase;
          Alinhar(taCenter);
          ImprimirLinha(linha, 0);

          Linha := ctCGCMF + ' ' + FormatarCPFouCGC(CNPJFilialBase) ;
          Alinhar(taCenter);
          ImprimirLinha(linha, 0);

          Linha := ctIE + ' ' + InscricaoEstadualFilialBase ;
          Alinhar(taCenter);
          ImprimirLinha(linha, 0);

          ImprimirLinha('', 0);

          Linha := format(ANSIUpperCase(ctRECIBODEPAGAMENTO), [' N. '+inttostr(dtmautenticacoesauxiliar.NumeroAutenticacao)]) ;
          Alinhar(taCenter);
          ImprimirLinha(linha, 0);

          ImprimirLinha('', 0);

          Linha := ANSIUpperCase(ctCLIENTE) + '.: ' +qryClientenome.AsString;
          ImprimirLinha(linha, 0);

          Linha := format('%-23s',[ANSIUpperCase(ctCODIGO) + '..: ' +qryClientecodigo.AsString])+format('%-17s',[ANSIUpperCase(ctBARRA) + '..: ']);
          ImprimirLinha(linha, 0);

          Linha := format('%-23s',[ANSIUpperCase(ctCONTRATO) + ': ' +FNumeroContrato])+
                   format('%-17s',[ANSIUpperCase(ctPARCELA) + ': '+inttostr(FNumeroParcelaContrato)]);
          ImprimirLinha(linha, 0);

          Linha := format('%-23s',[ANSIUpperCase(ctDTVENDA) + ': ' +formatdatetime('dd/mm/yy', FDataVenda)])+
                   format('%-17s',[ANSIUpperCase(ctVENCTO) + '.: '+formatdatetime('dd/mm/yy', FDataVencto)]);

          ImprimirLinha(linha, 0);

          Linha := format('%-23s',[ANSIUpperCase(ctCAIXA) + '...: '+inttostr(CodigoUsuario)])+
                   format('%-17s',[ANSIUpperCase(ctFILIAL) + '.: '+inttostr(filialbase)]);
          ImprimirLinha(linha, 0);

          ImprimirLinha('', 0);

          if FPagamentoParcial then begin  //------------------ PAGAMENTO PARCIAL
            Linha := ANSIUpperCase(ctVALORPARCELA) + '.: ' + format('%14s',[trim(Trocar(Trocar(Format('%11.2m',[FValorVenctoParcela]),'R',''),'$',''))]);
            Alinhar(taRightJustify);
            ImprimirLinha(linha, 0);

      //------------------- Carlos 10/05/2007 ------------------------------------------------------------------------------------------------------------------------------
            Linha := ANSIUpperCase(ctPAGTOPARCIALPARCELA) + ': ' + format('%14s',[trim(Trocar(Trocar(Format('%11.2m',[FValorVenctoParcela
                                                                 - qryParcelasPrestacaoVALORVENCTO.AsCurrency]),'R',''),'$',''))]);
            Alinhar(taRightJustify);
            ImprimirLinha(linha, 0);

            Linha := ANSIUpperCase(ctJUROSDESCONTO) + ': '+format('%14s',[trim(Trocar(Trocar(Format('%11.2m',[(FValorPagamentoParcela-(FValorVenctoParcela-qryParcelasPrestacaoVALORVENCTO.AsCurrency))]),'R',''),'$',''))]);
            Alinhar(taRightJustify);
            ImprimirLinha(linha, 0);
      //--------------------------------------------------------------------------------------------------------------------------------------------------------------------

            Linha := ANSIUpperCase(ctVALORPAGTOPARCIALPARCELA) + ': ' + format('%14s',[trim(Trocar(Trocar(Format('%11.2m',[(FValorPagamentoParcela)]),'R',''),'$',''))]);
            Alinhar(taRightJustify);
            ImprimirLinha(linha, 0);

            { Ismael em 21/07/2006 - Retirado conforme solicitação do REQ #806 }

            if ParSistema.MostrarSaldoPagarRecibo then begin
              Linha := ANSIUpperCase(ctSALDOPAGARPARCELA) + '.: ' + format('%14s',[trim(Trocar(Trocar(Format('%11.2m',[(FValorVenctoParcela-FValorPagamentoParcela) +
                                     {Carlos 10/05/2007}    (FValorPagamentoParcela-(FValorVenctoParcela-qryParcelasPrestacaoVALORVENCTO.AsCurrency))]),'R',''),'$',''))]);
              Alinhar(taRightJustify);
              ImprimirLinha(linha, 0);
            end;
          end
          else
          begin
            Linha := ANSIUpperCase(ctVALORPARCELA) + '.: ' + format('%14s',[trim(Trocar(Trocar(Format('%11.2m',[FValorVenctoParcela]),'R',''),'$',''))]);
            Alinhar(taRightJustify);
            ImprimirLinha(linha, 0);

            Linha := ANSIUpperCase(ctJUROSDESCONTO) + ': ' + format('%14s',[trim(Trocar(Trocar(Format('%11.2m',[(FValorPagamentoParcela-FValorVenctoParcela)]),'R',''),'$',''))]);
            Alinhar(taRightJustify);
            ImprimirLinha(linha, 0);

            Linha := ANSIUpperCase(ctTOTALRECEBIDO) + ': ' + format('%14s',[trim(Trocar(Trocar(Format('%11.2m',[FValorPagamentoParcela]),'R',''),'$',''))]);
            Alinhar(taRightJustify);
            ImprimirLinha(linha, 0);
          end;
          if Observacao <> nil then
          begin
            for I := 0 to observacao.lines.count do
              ImprimirLinha(observacao.Lines[I], 0);
          end;

          ImprimirLinha('', 0);

          Linha := CidadeFilialBase + ', ' + FormatDateTime( 'dd '' de ''mmmm'' de ''yyyy', DataServidor);
          Alinhar(taRightJustify);
          ImprimirLinha(linha, 0);

          ImprimirLinha('', 0);
          ImprimirLinha('', 0);
          ImprimirLinha('', 0);

          if length(assinatura) <> 0 then
          begin
            Linha := stringOfChar('_', MaxCol-15);
            Alinhar(tacenter);
            ImprimirLinha(linha, 0);

            Linha := Assinatura;
            Alinhar(tacenter);
            ImprimirLinha(linha, 0);

            ImprimirLinha('', 0);
            ImprimirLinha('', 0);
            ImprimirLinha('', 0);
            ImprimirLinha('', 0);
          end;
          if ParSistema.Autenticadora in [1,4] then
            TextPrinter.writeText(#$12, 0)
          else
            if ParSistema.Autenticadora = 2 then
              TextPrinter.writeText(#$56, 0)
            else
              TextPrinter.writeText(EPS_OFF_CONDENSED,0);

          ImprimirLinha('', 0);
          ImprimirLinha('', 0);
          ImprimirLinha('', 0);
          EndDoc('TecLUX - Imprimindo recibo de Caixa.');

          if Imprimindonaecf then
            ECFPadrao.RelatorioGerencial(Relatorio);

        end;
      end;
    finally
      Relatorio.free;
      NomeImpressoraEscolhida := '';
    end;
  end;

end;


