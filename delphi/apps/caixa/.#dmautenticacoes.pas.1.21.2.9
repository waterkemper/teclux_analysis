function Tdtmautenticacoes.BuscarParcelaAberta(Contrato: String;
  NumeroParcela: Integer): Boolean;
begin
  ReFazConsulta(qryClienteContrato,[0],[Contrato]);
  if not qryClienteContrato.IsEmpty then
  begin
    if not qryParcelasAberto.IsEmpty and
       (qryParcelasAbertocliente.AsInteger = qryClienteContratocliente.AsInteger) and
       (qryParcelasAbertotipocliente.AsString = qryClienteContratotipocliente.AsString) then
    begin
      if qryParcelasAberto.Locate('contrato;numero',VarArrayOf([contrato,numeroparcela]),[]) then
      begin
        if not qryParcelasAbertoselecionar.AsBoolean then
        begin
          MarcarParcelas(False,False);
          Result := True;
        end
        else
        begin
          MensagemAviso(Format(ctPARCELAJASELECIONADA,[IntToStr(NumeroParcela),Contrato]));
          Result := False;
        end;
      end
      else
      begin
        MensagemAviso(Format(ctNENHUMREGISTROENCONTRADO,['registro']) + #13#10 +
                      ctVERIFICARVALORESINFORMADOS);
        Result := False;
      end;
    end
    else
    begin
      ReFazConsulta(qryParcelasAberto,[0,1],[qryClienteContratocliente.AsInteger,
                                             qryClienteContratotipocliente.AsString]);
      if not qryParcelasAberto.IsEmpty then
      begin
        reFazConsultaClientes(paCLIENTEPARCELAS);
        if qryParcelasAberto.Locate('contrato;numero',VarArrayOf([contrato,numeroparcela]),[]) then
        begin
          if not qryParcelasAbertoselecionar.AsBoolean then
            MarcarParcelas(False,False);
          Result := True;
        end
        else
        begin
          MensagemAviso(ctPARCELAESTAAUTENTICADA);
          Result := False;
          qryParcelasAbertoAfterScroll(qryParcelasAberto);
        end;
      end
      else
      begin
        MensagemAviso(ctCLIENTEPARCELASABERTO);
        Result := False;
      end;
    end;
  end
  else
  begin
    MensagemAviso(format(ctNENHUMREGISTROENCONTRADO,['contrato']) + #13#10 +
                  ctVERIFICARVALORESINFORMADOS);
    Result := False;
  end;
end;

procedure Tdtmautenticacoes.MontarRecebimentosParcelasAberto(ComCartao: Boolean);
type
  TParcelas = Record
     Data    : TDateTime;
     Valor   : Currency;
     TipoRec : Integer;
     Tipo    : String;
     Tef     : Integer;
     NrRecto : Integer;
     Interv  : Integer;
  end;

var
  pos : TBookmark;
  R : array of TParcelas;
  t,i : Integer;
begin
  if ComCartao and (ParSistema.TipoTEF <> tsSEMTEF) then
  begin
    RefazConsulta(qryParcelasTef,[0{,1}],[FContratoParcelasAbertoTef {,
                                        FNroParcelaParcelasAbertoTef}]);
    qryRecebimentosTemp.Close;
    qryRecebimentosTemp.Open;
    qryRecebimentosTemp.Delete;
    
    FMontandoRecebimentos := True;
    try
      qryParcelasTef.DisableControls;
      qryParcelasTef.First;
      while not qryParcelasTef.Eof do
      begin
        if qryParcelasTefdatansu.AsDateTime = DataServidor then
        begin
          qryRecebimentosTemp.Append;
          qryRecebimentosTempdatalancto.AsDateTime     := qryParcelasTefdatansu.AsDateTime;
          qryRecebimentosTempvalorlancto.AsCurrency    := qryParcelasTefvalor.AsCurrency;
          qryRecebimentosTemptiporecebimento.AsInteger := qryParcelasTeftiporecebimento.AsInteger;
          qryRecebimentosTemptef.AsInteger             := qryParcelasTefcodigo.AsInteger;
          qryRecebimentosTemp.Post;
        end;
        qryParcelasTef.Next;
      end;
    finally
      qryParcelasTef.EnableControls;
      qryParcelasTef.Close;
    end;
    FMontandoRecebimentos := False;
  end
  else
  if not qryImprimirAcumulado.IsEmpty then
  begin
    pos := qryImprimirAcumulado.GetBookmark;
    qryImprimirAcumulado.DisableControls;
    t := qryImprimirAcumulado.RecordCount;
    SetLength(R,t);
    try
      qryImprimirAcumulado.First;
      for i:=0 to t-1 do
      begin
        R[i].Data    := qryImprimirAcumuladodatavencto.AsDateTime;
        R[i].Valor   := qryImprimirAcumuladovalorpago.AsCurrency;
        R[i].NrRecto := qryImprimirAcumuladonumerorecebimentos.AsInteger;
        R[i].Interv  := qryImprimirAcumuladointervalorecebimentos.AsInteger;
        if qryImprimirAcumuladotiporecebimento.AsInteger <> 0 then
        begin
          R[i].TipoRec := qryImprimirAcumuladotiporecebimento.AsInteger;
          R[i].Tipo    := qryImprimirAcumuladotipotiporecebimento.AsString;
        end
        else
        begin
          R[i].TipoRec := 1;
          R[i].Tipo    := 'D';
        end;
        qryImprimirAcumulado.Next;
      end;
    finally
      qryImprimirAcumulado.GotoBookmark(pos);
      qryImprimirAcumulado.FreeBookmark(pos);
      qryImprimirAcumulado.EnableControls;
    end;

    //if not qryRecebimentos.Active then
    qryRecebimentosTemp.Close;
    qryRecebimentosTemp.Open;
    qryRecebimentosTemp.Delete;
    
    FMontandoRecebimentos := True;
    for i:=0 to t-1 do
    begin
      if (R[i].Tipo <> 'H') and  // cheque
         {(R[i].Tipo <> 'C') and  // cartão de crédito
          (R[i].Tipo <> 'B') and}  // cartão de débito
         qryRecebimentosTemp.Locate('tiporecebimento',R[i].TipoRec,[]) then
      begin
        qryRecebimentosTemp.Edit;
        qryRecebimentosTempvalorlancto.AsCurrency := qryRecebimentosTempvalorlancto.AsCurrency + R[i].Valor;
        qryRecebimentosTemp.Post;
      end
      else
      begin
        qryRecebimentosTemp.Append;
        qryRecebimentosTempdatalancto.AsDateTime           := R[i].Data;
        qryRecebimentosTempvalorlancto.AsCurrency          := R[i].Valor;
        qryRecebimentosTemptiporecebimento.AsInteger       := R[i].TipoRec;
        qryRecebimentosTempnumerorecebimentos.AsInteger    := R[i].NrRecto;
        qryRecebimentosTempintervalorecebimentos.AsInteger := R[i].Interv;
        qryRecebimentosTemptipotiporecebimento.AsString    := R[i].Tipo;
        qryRecebimentosTemp.Post;
      end;
    end;
    FMontandoRecebimentos := False;
  end;
end;

function Tdtmautenticacoes.GravarRecebimentos(ComTef: boolean): Boolean;

  procedure AtribuirNumeroControleRecebimentos;
  type
    TTipoControle = Record
      TipoRec:Integer;
      Controle:Integer;
  end;
  var
    TC: array of TTipoControle;
    i,j,t : Integer;
  begin
    t := qryRecebimentos.RecordCount-1;

    SetLength(TC,t+1);
    qryRecebimentos.First;
    for i:=0 to t do
    begin
      TC[i].TipoRec := qryRecebimentostiporecebimento.AsInteger;
      TC[i].Controle:= 0;
      qryRecebimentos.Next;
    end;

    for i:=1 to t do
    begin
      for j:=0 to i-1 do
      begin
        if TC[j].TipoRec = TC[i].TipoRec then
          TC[i].Controle := TC[i].Controle + 1;
      end;
    end;

    qryRecebimentos.First;
    for i := 0 to t do
    begin
      if qryRecebimentostipo.AsString = 'H' then
      begin
        qryRecebimentos.Edit;
        qryRecebimentoscontrole.AsInteger := TC[i].Controle;
        qryRecebimentos.Post;
      end;
      qryRecebimentos.Next;
    end;
  end;

  function RecebimentosTipo: String;
  begin
    if TEFPadrao.TipoTransacao_ in [10,11,12,13] then
       result := 'C'                           //credito
    else if TEFPadrao.TipoTransacao_ in [20,21,22,23,24,25] then
       result := 'B';                          //debito
  end;

  procedure ConfirmarRecebimentosTemp(Valor: boolean=true);
  begin
    qryRecebimentosTemp.readonly := false;
    qryRecebimentosTemp.Edit;
    qryRecebimentosTempok.AsBoolean := Valor;
    qryRecebimentosTemp.post;
    qryRecebimentosTemp.readonly := qryRecebimentosTempok.asboolean;
  end;

var
  i : integer;
  maior : integer;
begin

  result := false;
  FGravandoRecebimentos := True;
  try

//    qryRecebimentosTemp.DisableControls;
    qryRecebimentosTemp.First;

    while not qryRecebimentosTemp.Eof do
    begin

      if not qryRecebimentosTempok.AsBoolean then
      begin
        if qryRecebimentosTemptipo.AsString = 'D' then    //dinheiro
        begin
          vValorPagtoDinheiro := vValorPagtoDinheiro + qryRecebimentosTempvalorlancto.AsCurrency;
          qryRecebimentos.Append;

          spcRecebimentosProximo.Open;
          qryRecebimentoscodigo.AsInteger := spcRecebimentosProximocodigo.AsInteger;
          spcRecebimentosProximo.Close;

          qryRecebimentosfilial.AsInteger       := FilialBase;
          qryRecebimentossituacao.AsString      := 'N';
          qryRecebimentostransacao.AsInteger    := FTransacao;
          qryRecebimentosdatalancto.AsDateTime  := DataServidor;
          qryRecebimentosdatavencto.AsDateTime := qryRecebimentosdatalancto.AsDateTime;

          qryRecebimentosvalorlancto.AsCurrency := qryRecebimentosTempvalorlancto.AsCurrency;
          qryRecebimentostipo.AsString          := qryRecebimentosTemptipo.AsString;
          qryRecebimentostiporecebimento.AsInteger := qryRecebimentosTemptiporecebimento.AsInteger;
          qryRecebimentoscontrole.AsInteger     := i - 1;

          qryRecebimentos.Post;
          ConfirmarRecebimentosTemp;
          vValorPagtoConfirmado := vValorPagtoConfirmado + qryRecebimentosTempvalorlancto.AsCurrency;

        end
        else
        if qryRecebimentosTemptipo.AsString = 'H' then    //cheque
        begin
          vValorPagtoCheque := vValorPagtoCheque + qryRecebimentosTempvalorlancto.AsCurrency;

          qryRecebimentos.Append;

          if qryRecebimentosTempdatalancto.AsDateTime > 0 then
            qryRecebimentosdatavencto.AsDateTime  := qryRecebimentosTempdatalancto.AsDateTime;

          qryRecebimentosdatalancto.AsDateTime  := DataServidor;
          qryRecebimentosdatavencto.AsDateTime := qryRecebimentosdatalancto.AsDateTime;

          qryRecebimentosvalorlancto.AsCurrency := qryRecebimentosTempvalorlancto.AsCurrency;

          frmCadastroChequesRecebimentos := TfrmCadastroChequesRecebimentos.Create(frmCadastroChequesRecebimentos);
          try
            frmCadastroChequesRecebimentos.Titular     := qryClientenome.AsString;
            frmCadastroChequesRecebimentos.ValorVencto := qryRecebimentosvalorlancto.AsCurrency;
            frmCadastroChequesRecebimentos.DataVencto  := qryRecebimentosdatavencto.AsDateTime;
            frmCadastroChequesRecebimentos.ShowModal;
            if frmCadastroChequesRecebimentos.ModalResult = mrOk then
              qryRecebimentoscheque.AsString := frmCadastroChequesRecebimentos.NumeroCheque;

            spcRecebimentosProximo.Open;
            qryRecebimentoscodigo.AsInteger := spcRecebimentosProximocodigo.AsInteger;
            spcRecebimentosProximo.Close;

            qryRecebimentosfilial.AsInteger      := FilialBase;
            qryRecebimentossituacao.AsString     := 'N';
            qryRecebimentostransacao.AsInteger   := FTransacao;
            qryRecebimentosdatalancto.AsDateTime := DataServidor;

            qryRecebimentostipo.AsString         := qryRecebimentosTemptipo.AsString;
            qryRecebimentostiporecebimento.AsInteger := qryRecebimentosTemptiporecebimento.AsInteger;
            qryRecebimentos.Post;
            ConfirmarRecebimentosTemp;
            vValorPagtoConfirmado := vValorPagtoConfirmado + qryRecebimentosTempvalorlancto.AsCurrency;

          finally
            frmCadastroChequesRecebimentos.Free;
          end;
        end
        else
        if ((qryRecebimentosTemptipo.AsString = 'C')  or     //credito
            (qryRecebimentosTemptipo.AsString = 'B')) then   //debito
        begin
          if not comtef then
          begin
            vValorPagtoCartao := 0;
            for i := 1 to qryRecebimentosTempnumerorecebimentos.asinteger do
            begin
              qryRecebimentos.Append;
              qryRecebimentosdatavencto.AsDateTime := DataServidor;

              spcRecebimentosProximo.Open;
              qryRecebimentoscodigo.AsInteger := spcRecebimentosProximocodigo.AsInteger;
              spcRecebimentosProximo.Close;

              qryRecebimentosfilial.AsInteger       := FilialBase;
              qryRecebimentossituacao.AsString      := 'N';
              qryRecebimentostransacao.AsInteger    := FTransacao;
              qryRecebimentosdatalancto.AsDateTime  := DataServidor;
              if i = qryRecebimentosTempnumerorecebimentos.asinteger then
                qryRecebimentosvalorlancto.AsCurrency := qryRecebimentosTempvalorlancto.AsCurrency - vValorPagtoCartao
              else
                qryRecebimentosvalorlancto.AsCurrency := RoundTo(qryRecebimentosTempvalorlancto.AsCurrency / qryRecebimentosTempnumerorecebimentos.AsInteger,-2);

              qryRecebimentosdatavencto.AsDateTime  := DataServidor;;
              qryRecebimentostipo.AsString := qryRecebimentosTemptipotiporecebimento.AsString;
              qryRecebimentostiporecebimento.AsInteger := qryTiposRecebimentoscodigo.asInteger;
              qryRecebimentoscontrole.AsInteger     := i - 1;
              qryRecebimentostef.clear;

              qryRecebimentos.Post;
              ConfirmarRecebimentosTemp;
              vValorPagtoConfirmado := vValorPagtoConfirmado + qryRecebimentosvalorlancto.AsCurrency;
              vValorPagtoCartao := vValorPagtoCartao + qryRecebimentosvalorlancto.AsCurrency;
            end;
          end
          else
            vValorPagtoCartao := vValorPagtoCartao + qryRecebimentosTempvalorlancto.AsCurrency;

        end;
      end;

      qryRecebimentosTemp.Next;

    end;

    if comtef then
    begin
      if ecfpadrao.Estado = estLivre then
      begin
        ecfpadrao.AbreNaoFiscal;
        tefpadrao.ValorPagoDinheiro := vValorPagtoDinheiro;
        tefpadrao.ValorPagocheque := vValorPagtoCheque;

        if vValorPagtoDinheiro<>0 then
          ecfpadrao.RegistraItemNaoFiscal(inttostr(ecfpadrao.IndiceRecebimentoNaoFiscal('R$', maior)), vValorPagtoDinheiro );

        if vValorPagtoCheque<>0 then
          ecfpadrao.RegistraItemNaoFiscal(inttostr(ecfpadrao.IndiceRecebimentoNaoFiscal('Cheque', maior)), vValorPagtoCheque );

        if vValorPagtoCartao<>0 then
          ecfpadrao.RegistraItemNaoFiscal(inttostr(ecfpadrao.IndiceRecebimentoNaoFiscal('Cartao',maior)), vValorPagtoCartao );

        vNaoFiscalTEFJaIniciado := true;
      end;

      qryRecebimentosTemp.First;
      while not qryRecebimentosTemp.Eof do
      begin
        if not qryRecebimentosTempok.AsBoolean then
        begin

          if ((qryRecebimentosTemptipo.AsString = 'C')  or     //credito
              (qryRecebimentosTemptipo.AsString = 'B'))  then   //debito
          begin
             TEFPadrao.ValorTransacao := floattostr(qryRecebimentosTempvalorlancto.AsCurrency);
             result := TEFPadrao.ExecutarOperacao(sopCARTAO, 0);
             if result then
             begin

//                refazconsultapornome(qryAgentes, ['descricao'], [tefpadrao.Administradora]);

                if not qryAgentes.locate('descricao', tefpadrao.Administradora, []) then
                begin
                  qryAgentes.append;
                  spcAgentesProximo.open;
                  qryAgentescodigo.asinteger := spcAgentesProximocodigo.asinteger;
                  spcAgentesProximo.close;
                  qryAgentesdescricao.asstring := tefpadrao.Administradora;
                  qryAgentes.post;
//                  Result := Perpetrar([qryAgentes]);
                end;

                if not qryTiposRecebimentos.locate('descricaoagente;numerorecebimentos;tiporecebimento',
                    VarArrayof([tefpadrao.Administradora,
                                TefPadrao.QtdadeParcelas,
                                RecebimentosTipo]), []) then
                begin
                  qryTiposRecebimentos.append;
                  spcTiposRecebimentosProximo.Open;
                  qryTiposRecebimentoscodigo.asInteger:= spcTiposRecebimentosProximocodigo.AsInteger;
                  spcTiposRecebimentosProximo.Close;

                  qryTiposRecebimentosagente.asinteger := qryAgentescodigo.asinteger;
                  qryTiposRecebimentosdescricaoagente.asstring := qryAgentesdescricao.asstring;
                  qryTiposRecebimentosnumerorecebimentos.asinteger := TefPadrao.QtdadeParcelas;
                  qryTiposRecebimentosdiasuteis.AsInteger := 1;  {necessário o valor caso contrário dá erro na trigger da tabela tiposrecebimentos}
                  qryTiposRecebimentosintervalorecebimentos.asinteger := 0;
                  qryTiposRecebimentostiporecebimento.asstring := RecebimentosTipo;
                  qryTiposRecebimentosdescricao.asstring := qryTiposRecebimentosdescricaoagente.asstring + ' ' +qryTiposRecebimentosnumerorecebimentos.asString + 'X';
                  qryTiposRecebimentos.post;


//                  Result := Perpetrar([qryTiposRecebimentos]);
                end;

                qryRecebimentosTemp.readonly := false;
                qryRecebimentosTemp.Edit;
                qryRecebimentosTemptiporecebimento.AsInteger := qryTiposRecebimentoscodigo.asInteger;
                qryRecebimentosTemp.post;
                ConfirmarRecebimentosTemp;

                vValorPagtoCartao := 0;
                for i := 1 to tefpadrao.QtdadeParcelas do
                begin
                  qryRecebimentos.Append;
                  qryRecebimentosdatavencto.AsDateTime := strtodate(tefpadrao.DataTransacao);

                  spcRecebimentosProximo.Open;
                  qryRecebimentoscodigo.AsInteger := spcRecebimentosProximocodigo.AsInteger;
                  spcRecebimentosProximo.Close;

                  qryRecebimentosfilial.AsInteger       := FilialBase;
                  qryRecebimentossituacao.AsString      := 'N';
                  qryRecebimentostransacao.AsInteger    := FTransacao;
                  qryRecebimentosdatalancto.AsDateTime  := strtodate(tefpadrao.DataTransacao);

                  if i = tefpadrao.QtdadeParcelas then
                    qryRecebimentosvalorlancto.AsCurrency := qryRecebimentosTempvalorlancto.AsCurrency - vValorPagtoCartao
                  else
                    qryRecebimentosvalorlancto.AsCurrency := RoundTo(qryRecebimentosTempvalorlancto.AsCurrency / tefpadrao.QtdadeParcelas,-2);

                  qryRecebimentosvalortotal.AsCurrency := qryRecebimentosTempvalorlancto.AsCurrency;

                  qryRecebimentosdatavencto.AsDateTime  := strtodate(tefpadrao.DataTransacao);
                  qryRecebimentostipo.AsString := RecebimentosTipo;
                  qryRecebimentostiporecebimento.AsInteger := qryTiposRecebimentoscodigo.asInteger;
                  qryRecebimentoscontrole.AsInteger     := i - 1;
                  qryRecebimentostef.AsString          := tefpadrao.nsu;
                  qryRecebimentosnomeredensu.asstring   := tefpadrao.nomerede;
                  qryRecebimentoshora.asdatetime := strtodatetime(TefPadrao.HoraTransacao);
                  qryRecebimentos.Post;

//                  Result := Perpetrar([qryRecebimentos]);
                  vJaPossuiPagamentCartaoAprovado := true;

                  vValorPagtoConfirmado := vValorPagtoConfirmado + qryRecebimentosvalorlancto.AsCurrency;
                  vValorPagtoCartao := vValorPagtoCartao + qryRecebimentosvalorlancto.AsCurrency;


                end;
             end
             else
             begin
               if not ({vJaPossuiPagamentCartaoAprovado and} (ecfpadrao.Estado = estNaoFiscal)) then
               begin

                 qryRecebimentosTemp.first;
                 while not qryRecebimentosTemp.eof do
                 begin
                   ConfirmarRecebimentosTemp(false);
                   qryRecebimentostemp.next;
                 end;

                 vValorPagtoDinheiro := 0;
                 vValorPagtoCheque := 0;
                 vValorPagtoCartao := 0;
                 vValorPagtoConfirmado := 0;
                 vJaPossuiPagamentCartaoAprovado := false;
                 vNaoFiscalTEFJaIniciado := false;

                 refazconsulta(qryRecebimentos,[],[]);
               end;

               break;
             end;
          end;
        end;

        if result or qryRecebimentosTempok.AsBoolean then
          qryRecebimentosTemp.Next

      end;

    end
    else
    begin

      if assigned(ecfpadrao) then
      begin
        try
          for i:= 1 to parsistema.NumeroCopiasdoRecibo  do
          begin
            ecfpadrao.AbreNaoFiscal;
            if vValorPagtoDinheiro<>0 then
              ecfpadrao.RegistraItemNaoFiscal(inttostr(ecfpadrao.IndiceRecebimentoNaoFiscal('R$', maior)), vValorPagtoDinheiro );

            if vValorPagtoCheque<>0 then
              ecfpadrao.RegistraItemNaoFiscal(inttostr(ecfpadrao.IndiceRecebimentoNaoFiscal('Cheque', maior)), vValorPagtoCheque );

            if vValorPagtoCartao<>0 then
              ecfpadrao.RegistraItemNaoFiscal(inttostr(ecfpadrao.IndiceRecebimentoNaoFiscal('Cartao',maior)), vValorPagtoCartao );

            ECFPadrao.SubtotalizaNaoFiscal;
            if vValorPagtoDinheiro <> 0 then ecfpadrao.PagamentoNaoFiscal('Dinheiro',vValorPagtoDinheiro, false);
            if vValorPagtoCheque <> 0 then   ecfpadrao.PagamentoNaoFiscal('Cheque',vValorPagtoCheque);
            if vValorPagtoCartao <> 0 then  ecfpadrao.PagamentoNaoFiscal('Cartao',vValorPagtoCartao);
            ECFPadrao.FechaNaoFiscal;

            if ecfpadrao.Erro then
            begin
              result := false;
              MensagemErro(ecfpadrao.Mensagem);
            end
            else
              result := true;
          end;
        except
          result := false;
        end;
      end
      else
        result := true;

    end;

//    AtribuirNumeroControleRecebimentos;
//    qryRecebimentosTemp.EnableControls;
  finally
//    qryRecebimentos.Close;

   if result then
   begin
     with dtmautenticacoesauxiliar do
     begin
       qryAutenticar.ParamByName('numero').Value := ProximoNumeroAutenticacao;
       qryAutenticar.ExecSql;
       if not qryAutenticarObservacoes.ParamByName('observacoes').IsNull then
       begin
         qryAutenticarObservacoes.ParamByName('numero').value := qryAutenticar.ParamByName('numero').Value;
         qryAutenticarObservacoes.ExecSql;
       end;
     end;

     Result := Perpetrar([dtmautenticacoesauxiliar.qryInserirParcelaParcial,
                          dtmautenticacoesauxiliar.qryAtualizarParcela,
                          dtmautenticacoesauxiliar.qryAtualizarParcelaParcial,
                          dtmautenticacoesauxiliar.qryAutenticar,
                          dtmautenticacoesauxiliar.qryAutenticarObservacoes,
                          qryagentes,
                          qryTiposRecebimentos,
                          qryRecebimentos], tstCaixa);
   end;
  end;
  FGravandoRecebimentos := False;
end;

