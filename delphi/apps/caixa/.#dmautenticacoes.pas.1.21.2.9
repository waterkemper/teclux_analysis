function Tdtmautenticacoes.autenticarResgate: integer;
var
  nroautenticacao: integer;
begin
  FNumeroCheque               := qryParcelasResgatecheque.asString;
  FNumeroParcelaCheque        := qryParcelasResgatenumero.asInteger;
  FValorPagamentoParcelaCheque:= qryParcelasResgatevalorpagto.AsFloat;
  result := dtmautenticacoesauxiliar.autenticarResgateCheque(nroautenticacao, FNumeroCheque, FValorPagamentoParcelaCheque);
  if result = mrOK then begin
    result := quitarParcelaResgate(nroautenticacao);
    if result = mrOK then begin
      result := dtmautenticacoesauxiliar.ConfirmarAutenticacaoResgateCheque;
      if result = mrOK then begin
        refazConsulta(qryParcelasResgate,[0],[FNumeroCheque]);
        qryParcelasResgate.Locate('resgatado', 'False', []);
      end
    end
  end;
end;

