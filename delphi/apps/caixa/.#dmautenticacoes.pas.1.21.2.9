function Tdtmautenticacoes.GetPrestacaoValorPagtoCartao: real;
var
  Pos: TBookmark;
  QueryParcelas: Ttecquery;
begin
  Result := 0;
  if(ParSistema.AutenticacaoParcelasModo2) then
  begin
      Pos := qryParcelasAberto.GetBookmark;
      qryParcelasAberto.DisableControls;
      try
        qryParcelasAberto.First;
        while Not qryParcelasAberto.Eof do
        begin
          if  (((qryParcelasAbertoformapagamento.AsString = 'C') or
              (qryParcelasAbertoformapagamento.AsString = 'B') or
              (qryParcelasAbertoformapagamento.AsString = 'X')) and (qryParcelasAbertoselecionar.AsBoolean)) then
          begin
            Result := Result + qryParcelasAbertovalorvencto.AsFloat;
          end;
          qryParcelasAberto.Next
        end;
      finally
        qryParcelasAberto.GotoBookmark(Pos);
        qryParcelasAberto.FreeBookmark(Pos);
        qryParcelasAberto.EnableControls
      end;
  end
  else
  begin
    Pos := qryParcelasPrestacao.GetBookmark;
    qryParcelasPrestacao.DisableControls;
    try
      qryParcelasPrestacao.BeforeScroll := nil;
      qryParcelasPrestacao.AfterScroll := nil;
      qryParcelasPrestacao.First;
      while Not qryParcelasPrestacao.Eof do
      begin
          if (qryParcelasPrestacaoformapagamento.AsString = 'C') or
             (qryParcelasPrestacaoformapagamento.AsString = 'B') or
             (qryParcelasPrestacaoformapagamento.AsString = 'X') then
          begin
            Result := Result + qryParcelasPrestacaovalorvencto.AsFloat;
          end;
          qryParcelasPrestacao.Next
      end;
    finally
      qryParcelasPrestacao.GotoBookmark(Pos);
      qryParcelasPrestacao.FreeBookmark(Pos);
      qryParcelasPrestacao.EnableControls;
      qryParcelasPrestacao.BeforeScroll := qryParcelasPrestacaoBeforeScroll;
      qryParcelasPrestacao.AfterScroll := qryParcelasPrestacaoAfterScroll;
    end
  end;  
end;

