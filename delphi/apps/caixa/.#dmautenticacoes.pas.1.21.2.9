function PagamentoTEF(NroParcela: Integer; ValorCupom, ValorParcela, CredValor, DebValor, CDCValor: Currency;
                      CredQtdadeParcelas, DebQtdadeParcelas, CDCQtdadeParcelas: Integer; Data, Hora, Operador: String;
                      ParcelasOrig: array of TtecParcelasTEF; DadosFornec: String;
                      FormaPagto: String;
                      var CupomEmitido: Boolean;
                      var InformacoesTEF: array of TtecDadosTEF; var QtdadeDadosTEF: Integer;
                      var CancelarCupom: Boolean; var FormaPagamento: Integer;
                      var ValorPagoDinheiro: Currency): Boolean;
var
{$IFDEF MSWINDOWS}
  {tefdiscado, tefCancelar: TtecTEFDiscado;}
  OK: Boolean;
  a, b, c, NumeroCupom: Integer;
  NroParcelas: array of Integer;
  QtdadeCartoes, AntQtdadeCartoes: Integer;
  Valor: Real;
  AntParcelas,
  Parcelas: array of TtecParcelasTEF;
  SomaParcelas,
  AntCredValor,
  AntDebValor,
  AntCDCValor,
  AntValorPagoDinheiro,
  CredValorDinheiro,
  DebValorDinheiro,
  CDCValorDinheiro,
  ValorDinheiro: Currency;
{$ENDIF}
  InformacaoTEF: array of TtecDadosTEF;

  function FinalizaCupomComDinheiro(Valor: Currency; DadosFornec: String): Boolean;
  var
    Sair: Boolean;
  begin
    Result := True;
    Sair   := False;
    if ECFPadrao.CupomAberto then begin
      if (Valor > 0) and (Not ECFPadrao.Erro) then
        repeat
          ECFPadrao.PagamentoCupom('Dinheiro', FloatToStr(Valor));
          if ECFPadrao.Erro then begin
{$IFDEF MSWINDOWS}
             BlockInput(False);
{$ENDIF}
            if biblio.MensagemConfirmacao(ECFPadrao.Mensagem + #13#10 + ctTEFIMPRIMIRNOVAMENTE) <> smbOK then begin
              Sair := True;
              Result := False
            end;
{$IFDEF MSWINDOWS}
            BlockInput(True);
{$ENDIF}
          end
        until Sair or (Not ECFPadrao.Erro);
      if Not ECFPadrao.Erro then
        repeat
          ECFPadrao.FinalizarCupom('Dinheiro', FloatToStr(Valor), DadosFornec);
          if ECFPadrao.Erro then begin
{$IFDEF MSWINDOWS}
            BlockInput(False);
{$ENDIF}
            if biblio.MensagemConfirmacao(ECFPadrao.Mensagem + #13#10 + ctTEFIMPRIMIRNOVAMENTE) <> smbOK then begin
              Sair := True;
              Result := False
            end;
{$IFDEF MSWINDOWS}
//            BlockInput(True);
{$ENDIF}
          end
        until Sair or (Not ECFPadrao.Erro);
    end
  end;

begin
  CancelarCupom := False;
  if ParSistema.TipoTEF = tsDEDICADO then begin
    SetLength(InformacaoTEF, 1);
    frmTEFDedicado := TfrmTEFDedicado.Create(frmTEFDedicado);
    frmTEFDedicado.NumeroCupom := ECFPadrao.Cupom;
    frmTEFDedicado.Valor       := FloatToStrF(ValorParcela, ffCurrency, 15, 2);
    frmTEFDedicado.DataFiscal  := Data;
    frmTEFDedicado.Horario     := Hora;
    frmTEFDedicado.Operador    := Operador;
    Result                     := frmTEFDedicado.ShowModal = mrOK;
    InformacaoTEF[0].NSUTEF    := frmTEFDedicado.NSU;
    frmTEFDedicado.Free;
{$IFDEF LINUX}
  end else
    Result := False;
{$ELSE}
  end else if ParSistema.TipoTEF = tsDISCADO then begin
//    tefdiscado := TtecTEFDiscado.Create(tefdiscado);
//    if tefdiscado.GerenciadorAtivo(False) then begin
      if TEFPadrao.Inicializado(gpTefDial) then begin
      try
//        BackupTEFDiscado := TtecBackupTEFDiscado.Create;
//        BackupTEFDiscado.ExisteArquivo(True);
//        TEFPadrao.CupomFiscal       := ECFPadrao.Cupom;
//        TEFPadrao.CCF               := ECFPadrao.NumCCF;
        FormaPagamento               := 0;
        Valor                        := 0;
        QtdadeCartoes                := 0;
        TEFPadrao.ValorTotalCartoes := CredValor + DebValor + CDCValor;
        ValorDinheiro                := ValorCupom - CredValor - DebValor - CDCValor;
        ValorPagoDinheiro            := ValorDinheiro;
        SetLength(Parcelas, High(ParcelasOrig) + 1);
        for b := 0 to High(ParcelasOrig) do begin
          Parcelas[b].Numero     := ParcelasOrig[b].Numero;
          Parcelas[b].Valor      := ParcelasOrig[b].Valor;
          Parcelas[b].FormaPagto := ParcelasOrig[b].FormaPagto;
        end;

        repeat
          if (CredValor <> 0) or (DebValor <> 0) or (CDCValor <> 0) then begin
            AntQtdadeCartoes     := QtdadeCartoes;
            AntCredValor         := CredValor;
            AntDebValor          := DebValor;
            AntCDCValor          := CDCValor;
            AntValorPagoDinheiro := ValorPagoDinheiro;
            SetLength(AntParcelas, High(Parcelas) + 1);
            for b := 0 to High(AntParcelas) do begin
              AntParcelas[b].Numero     := Parcelas[b].Numero;
              AntParcelas[b].Valor      := Parcelas[b].Valor;
              AntParcelas[b].FormaPagto := Parcelas[b].FormaPagto;
            end;
            frmSelecionarFormaPagamentoTEFDiscado := TfrmSelecionarFormaPagamentoTEFDiscado.Create(Screen.ActiveForm);
            try
              frmSelecionarFormaPagamentoTEFDiscado.UltimoCartao := QtdadeCartoes = High(InformacoesTEF);
              frmSelecionarFormaPagamentoTEFDiscado.Parcelas(Parcelas, ValorPagoDinheiro, QtdadeCartoes);
              if QtdadeCartoes > 0 then
                MinimizarTEFDial;
              Sleep(500);
              OK := frmSelecionarFormaPagamentoTEFDiscado.ShowModal = mrOk;
              if OK then begin
                FormaPagamento := frmSelecionarFormaPagamentoTEFDiscado.FormaPagamento;
                if FormaPagamento = 1 then begin
                  Valor  := frmSelecionarFormaPagamentoTEFDiscado.CreditoValorPagar;
                  SomaParcelas := 0;
                  for b := 0 to High(Parcelas) do
                    if Parcelas[b].FormaPagto = 'C' then begin
                      Parcelas[b].Valor := RoundTo(Parcelas[b].Valor * (1 - (Valor / CredValor)), -2);
                      SomaParcelas := SomaParcelas + Parcelas[b].Valor;
                    end;
                  CredValor := RoundTo(CredValor - Valor, -2);
                  if SomaParcelas <> CredValor then
                    for b := 0 to High(Parcelas) do
                      if Parcelas[b].FormaPagto = 'C' then begin
                        Parcelas[b].Valor := Parcelas[b].Valor + (CredValor - SomaParcelas);
                        break
                      end;
                  SetLength(NroParcelas, frmSelecionarFormaPagamentoTEFDiscado.CreditoQtdadeParcelas);
                  frmSelecionarFormaPagamentoTEFDiscado.CreditoParcelasPagar(NroParcelas);

                  {
                  Gedovar : esta propriedade não é utilizada para nada
                  if High(NroParcelas) = 0 then
                    tefdiscado.TipoTransacaoPermitida := 10
                  else
                    tefdiscado.TipoTransacaoPermitida := 11
                  }

                end else if FormaPagamento = 2 then begin
                  Valor := frmSelecionarFormaPagamentoTEFDiscado.DeditoValorPagar;
                  SomaParcelas := 0;
                  for b := 0 to High(Parcelas) do
                    if Parcelas[b].FormaPagto = 'B' then begin
                      Parcelas[b].Valor := RoundTo(Parcelas[b].Valor * (1 - (Valor / DebValor)), -2);
                      SomaParcelas := SomaParcelas + Parcelas[b].Valor;
                    end;
                  DebValor := RoundTo(DebValor - Valor, -2);
                  if SomaParcelas <> DebValor then
                    for b := 0 to High(Parcelas) do
                      if Parcelas[b].FormaPagto = 'B' then begin
                        Parcelas[b].Valor := Parcelas[b].Valor + (DebValor - SomaParcelas);
                        break
                      end;
                  SetLength(NroParcelas, frmSelecionarFormaPagamentoTEFDiscado.DebitoQtdadeParcelas);
                  frmSelecionarFormaPagamentoTEFDiscado.DebitoParcelasPagar(NroParcelas);
                  SetLength(NroParcelas, frmSelecionarFormaPagamentoTEFDiscado.DebitoQtdadeParcelas);

                   {
                  if High(NroParcelas) = 0 then
                    tefdiscado.TipoTransacaoPermitida := 20
                  else
                    tefdiscado.TipoTransacaoPermitida := 22
                  }

                end else if FormaPagamento = 3 then begin
                  Valor := frmSelecionarFormaPagamentoTEFDiscado.CDCValorPagar;
                  SomaParcelas := 0;
                  for b := 0 to High(Parcelas) do
                    if Parcelas[b].FormaPagto = 'X' then begin
                      Parcelas[b].Valor := RoundTo(Parcelas[b].Valor * (1 - (Valor / CDCValor)), -2);
                      SomaParcelas := SomaParcelas + Parcelas[b].Valor;
                    end;
                  CDCValor := RoundTo(CDCValor - Valor, -2);
                  if SomaParcelas <> CDCValor then
                    for b := 0 to High(Parcelas) do
                      if Parcelas[b].FormaPagto = 'X' then begin
                        Parcelas[b].Valor := Parcelas[b].Valor + (CDCValor - SomaParcelas);
                        break
                      end;
                  SetLength(NroParcelas, frmSelecionarFormaPagamentoTEFDiscado.CDCQtdadeParcelas);
                  frmSelecionarFormaPagamentoTEFDiscado.CDCParcelasPagar(NroParcelas);
                  SetLength(NroParcelas, frmSelecionarFormaPagamentoTEFDiscado.CDCQtdadeParcelas);
//                  if High(NroParcelas) = 0 then
//                    tefdiscado.TipoTransacaoPermitida := 40
//                  else
//                    tefdiscado.TipoTransacaoPermitida := 22
                end else begin
                  Valor := frmSelecionarFormaPagamentoTEFDiscado.ValorPagarDinheiro;
                  while Valor > 0 do begin
                    if Parcelas[0].Valor > Valor then begin
                      Parcelas[0].Valor := Parcelas[0].Valor - Valor;
                      if Parcelas[0].FormaPagto = 'C' then
                        CredValor := RoundTo(CredValor - Valor, -2)
                      else if Parcelas[0].FormaPagto = 'B' then
                        DebValor := RoundTo(DebValor - Valor, -2)
                      else
                        CDCValor := RoundTO(CDCValor - Valor, -2);
                      Valor := 0;
                    end else begin
                      if Parcelas[0].FormaPagto = 'C' then
                        CredValor := RoundTo(CredValor - Parcelas[0].Valor, -2)
                      else if Parcelas[0].FormaPagto = 'B' then
                        DebValor := RoundTo(DebValor - Parcelas[0].Valor, -2)
                      else
                        CDCValor := RoundTo(CDCValor - Parcelas[0].Valor, -2);
                      Valor := Valor - Parcelas[0].Valor;
                      for c := 0 to High(Parcelas) - 1 do begin
                        Parcelas[c].Valor      := Parcelas[c + 1].Valor;
                        Parcelas[c].Numero     := Parcelas[c + 1].Numero;
                        Parcelas[c].FormaPagto := Parcelas[c + 1].FormaPagto;
                      end;
                      SetLength(Parcelas, High(Parcelas));
                    end;
                  end;
                  ValorPagoDinheiro := ValorPagoDinheiro + frmSelecionarFormaPagamentoTEFDiscado.ValorPagarDinheiro;
                  TEFPadrao.ValorTotalCartoes := TEFPadrao.ValorTotalCartoes - frmSelecionarFormaPagamentoTEFDiscado.ValorPagarDinheiro;
                  OK     := True;
                  Result := True
                end;
                TEFPadrao.ValorTransacao               := FloatToStr(Valor);
// Gedovar : não utilizado
//                tefdiscado.CredQtdadeParcelasPermitidas := frmSelecionarFormaPagamentoTEFDiscado.CreditoQtdadeParcelas;
//                tefdiscado.DebQtdadeParcelasPermitidas  := frmSelecionarFormaPagamentoTEFDiscado.DebitoQtdadeParcelas;
              end
            finally
              frmSelecionarFormaPagamentoTEFDiscado.Free;
            end
          end else begin
            OK := True;
            TEFPadrao.ValorTotalCartoes            := ValorParcela;
            TEFPadrao.ValorTransacao               := FloatToStr(RoundTo(ValorParcela,-2));
            Valor                                   := ValorParcela;
//            tefdiscado.CredQtdadeParcelasPermitidas := 0;
//            tefdiscado.DebQtdadeParcelasPermitidas  := 0;
            AntQtdadeCartoes                        := 0;
            AntCredValor                            := 0;
            AntDebValor                             := 0;
            AntCDCValor                             := 0;
            AntValorPagoDinheiro                    := 0;
          end;
          if OK then begin
            Result := True;
            if FormaPagamento <> 4 then begin
              if FormaPagamento = 3 then
                Result := TEFPadrao.ExecutarOperacao(sopCHEQUE, QtdadeCartoes + 1)
              else
                Result := TEFPadrao.ExecutarOperacao(sopCARTAO, QtdadeCartoes + 1);


               {

               Gedovar: Verificar
              if (TEFPadrao.ValorTotalCartoes - TEFPadrao.ValorParcialCartoes) < 0.01 then
                Result := tefdiscado.ImprimirCupom(CupomEmitido, ValorPagoDinheiro, DadosFornec, FormaPagto, QtdadeCartoes + 1);
               }

              if Result then begin
//                with tefdiscado do
//                  BackupTEFDiscado.Incluir(NomeRede, NSU, DataTransacao, HoraTransacao, Valor, QtdadeCartoes + 1);

                SetLength(InformacaoTEF, QtdadeCartoes + 1);
                InformacaoTEF[QtdadeCartoes].DataNSU     := trocar(TEFPadrao.DataTransacao,'/','');
                InformacaoTEF[QtdadeCartoes].HoraNSU     := trocar(TEFPadrao.HoraTransacao,':','');
                InformacaoTEF[QtdadeCartoes].NomeRedeNSU := TEFPadrao.NomeRede;
                InformacaoTEF[QtdadeCartoes].NSUTEF      := TEFPadrao.NSU;
                InformacaoTEF[QtdadeCartoes].Valor       := Valor;
                try
                  NumeroCupom := StrToInt(TEFPadrao.CupomFiscal);
                except
                  NumeroCupom := 0;
                end;
                if (NumeroCupom = 0) or (FormaPagamento = 0) then begin
                  InformacaoTEF[QtdadeCartoes].NroParcela  := 1;
                  SetLength(InformacaoTEF[QtdadeCartoes].Parcelas, 1);
                  InformacaoTEF[QtdadeCartoes].Parcelas[0] := NroParcela;
                end else begin
                  InformacaoTEF[QtdadeCartoes].NroParcela := High(NroParcelas) + 1;
                  if FormaPagamento in [1,2,3] then begin
                    SetLength(InformacaoTEF[QtdadeCartoes].Parcelas, InformacaoTEF[QtdadeCartoes].NroParcela);
                    for b := 0 to InformacaoTEF[QtdadeCartoes].NroParcela - 1 do
                      InformacaoTEF[QtdadeCartoes].Parcelas[b] := NroParcelas[b];
                  end;
                end;
                QtdadeCartoes := QtdadeCartoes + 1;
              end else if (TEFPadrao.StatusTransacao_ <> '0') then begin
                QtdadeCartoes     := AntQtdadeCartoes;
                CredValor         := AntCredValor;
                DebValor          := AntDebValor;
                CDCValor          := AntCDCValor;
                ValorPagoDinheiro := AntValorPagoDinheiro;
                for b := 0 to High(AntParcelas) do begin
                  Parcelas[b].Numero     := AntParcelas[b].Numero;
                  Parcelas[b].Valor      := AntParcelas[b].Valor;
                  Parcelas[b].FormaPagto := AntParcelas[b].FormaPagto;
                end;
                Result := (CredValor <> 0) or (DebValor <> 0) or (CDCValor <> 0);
              end else begin
                Result := False;
                CancelarCupom := True;
              end
            end;
          end else begin
            Result := False;
            CancelarCupom := True;
          end;
          if Not Result then begin
            b := 0;
            if Assigned(frmMsg) then
              frmMsg.Free;
            if b < QtdadeCartoes then begin
              CancelarCupom := True;
              ECFPadrao.CancelarCupom;
              frmMsg := TfrmMensagemTemporizada.Create(Screen.ActiveForm, '');
            end;
            try

              { Gedovar verificar
              while b < QtdadeCartoes do begin
                tefCancelar := TtecTEFDiscado.Create(tefCancelar);
                tefCancelar.ValorTransacao := FloatToStr(InformacaoTEF[b].Valor);
                try
                  if tefCancelar.CancelarTransacao(InformacaoTEF[b].NSUTEF, InformacaoTEF[b].NomeRedeNSU,
                                                   InformacaoTEF[b].HoraNSU, InformacaoTEF[b].DataNSU,
                                                   InformacaoTEF[b].Valor,True)
                  then
                    Inc(b);
                    BackupTEFDiscado.Apagar(b);
                finally
                  tefCancelar.Free
                end
              end;
              BackupTEFDiscado.ApagarArquivo;
              }

            finally
              if Assigned(frmMsg) then
                frmMsg.Close
            end
          end;
        until ((CredValor = 0) and (DebValor = 0) and (CDCValor = 0)) or (Not OK);
        if (FormaPagamento = 4) and Result then
          Result := FinalizaCupomComDinheiro(ValorPagoDinheiro, DadosFornec)
        else if Result then begin
          QtdadeDadosTEF := High(InformacaoTEF) + 1;
          for a := 0 to High(InformacaoTEF) do begin
            for b := 0 to High(InformacaoTEF[a].Parcelas) do
              InformacoesTEF[a].Parcelas[b] := InformacaoTEF[a].Parcelas[b];
            InformacoesTEF[a].DataNSU       := InformacaoTEF[a].DataNSU;
            InformacoesTEF[a].HoraNSU       := InformacaoTEF[a].HoraNSU;
            InformacoesTEF[a].NomeRedeNSU   := InformacaoTEF[a].NomeRedeNSU;
            InformacoesTEF[a].NSUTEF        := InformacaoTEF[a].NSUTEF;
            InformacoesTEF[a].NroParcela    := InformacaoTEF[a].NroParcela;
            InformacoesTEF[a].Valor         := InformacaoTEF[a].Valor;
          end
        end
      finally
//        tefdiscado.Free;
      end
    end else begin
      Result := False;
      MensagemAviso(ctTEFTEGERENCIADORINATIVO);
    end;
  end else
    Result := True;
{$ENDIF}
end;

