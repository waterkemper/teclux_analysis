procedure Tdtmautenticacoes.acumularParcelasAberto;
begin
  if not qryImprimirAcumulado.Active then
  begin
    qryImprimirAcumulado.Open;
    qryImprimirAcumulado.Delete;
  end;
  qryImprimirAcumulado.Append;
  qryImprimirAcumuladoautenticacao.AsInteger    := dtmautenticacoesauxiliar.NumeroAutenticacao;
  qryImprimirAcumuladocontrato.AsString         := FNumeroContrato;
  qryImprimirAcumuladoparcela.AsInteger         := FNumeroParcelaContrato;
  qryImprimirAcumuladodatavenda.AsDateTime      := FDataVenda;
  qryImprimirAcumuladodatavencto.AsDateTime     := FDataVencto;
  qryImprimirAcumuladovalorparcela.AsFloat      := FValorVenctoParcela;
  qryImprimirAcumuladovalorpago.AsFloat         := FValorPagamentoParcela;
  qryImprimirAcumuladotiporecebimento.AsInteger := qryParcelasAbertotiporecebimento.AsInteger;
  qryImprimirAcumuladoparcelaorigem.AsString    := qryParcelasAbertoparcelaorigem.AsString;
  qryImprimirAcumuladotipotiporecebimento.AsString := qryParcelasAbertotipotiporecebimento.AsString;
  qryImprimirAcumuladonumerorecebimentos.AsInteger := qryParcelasAbertonumerorecebimentos.AsInteger;
  qryImprimirAcumuladointervalorecebimentos.AsInteger := qryParcelasAbertointervalorecebimentos.AsInteger;
  qryImprimirAcumulado.Post;
end;

function Tdtmautenticacoes.GetTipoClienteParcelasAberto: String;
begin
  Result := qryParcelasAbertotipocliente.AsString;
end;

procedure Tdtmautenticacoes.ParcelasAbertoValorPagtoAposAlterar(Diferenca: Real);
var
  pos : TBookmark;
begin
  FValorAlteracaoParcelasAberto := Diferenca;
  pos := qryParcelasAberto.GetBookmark;
  qryParcelasAberto.DisableControls;
  if diferenca >= 0 then
  begin
    qryParcelasAberto.Edit;
    qryParcelasAbertovalorpagto.AsFloat := qryParcelasAbertovalorpagto.AsFloat + Diferenca;
    qryParcelasAberto.Post;
  end
  else
  begin
    qryParcelasAberto.Last;
    while Diferenca < 0 do
    begin
      if qryParcelasAbertoselecionar.AsBoolean then
      begin
        if qryParcelasAbertovalorpagto.AsFloat >= (Diferenca * (-1)) then
        begin
          qryParcelasAberto.Edit;
          qryParcelasAbertovalorpagto.AsFloat := qryParcelasAbertovalorpagto.AsFloat + Diferenca;
          qryParcelasAberto.Post;
          Diferenca := 0;
          Break;
        end
        else
        begin
          Diferenca := Diferenca + qryParcelasAbertovalorpagto.AsFloat;
          qryParcelasAberto.Edit;
          qryParcelasAbertovalorpagto.asFloat := 0;
          qryParcelasAberto.Post;
        end;
      end;
      qryParcelasAberto.Prior;
    end;
  end;
  qryParcelasAberto.GotoBookmark(pos);
  qryParcelasAberto.FreeBookmark(pos);
  qryParcelasAberto.EnableControls;
end;

function Tdtmautenticacoes.LocalizarParcelaEmAberto(
  NumeroParcela: Integer): Integer;
begin
  Result := 9;
  if qryParcelasPrestacao.Locate('numero',NumeroParcela,[]) then
  begin
    if qryParcelasPrestacaonumero.AsInteger > NumeroParcela then
      Result := 1
    else if qryParcelasPrestacaonumero.AsInteger < NumeroParcela then
      Result := -1;
