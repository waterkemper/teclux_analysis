procedure Tdtmautenticacoes.RecalcularValorParcela(Data: String; Tipo: TtecPagamentoParcial);
begin
  case Tipo of
    ppPARCELAS,
    ppALTERARPARCELAS: begin
                         qryParcelasPrestacao.Edit;
                         qryParcelasPrestacaovalordebito.AsCurrency := qryParcelasPrestacaovalorvencto.AsCurrency +
                                    tecFinanceira.CalcularJuros(qryParcelasPrestacaovalorvencto.AsCurrency,
                                                                qryParcelasPrestacaodatavencto.AsDateTime, StrToDate(Data));
                         if (qryParcelasPrestacaovalordebito.AsCurrency <> qryParcelasPrestacaovalorvencto.AsCurrency) then
                           qryParcelasPrestacaovalordebito.AsCurrency := Multiplo(qryParcelasPrestacaovalordebito.AsCurrency,
                                                                                  ParSistema.ArredondamentoJurosCaixa );
                         qryParcelasPrestacaovalorpagto.AsCurrency  := qryParcelasPrestacaovalordebito.AsCurrency;
                         qryParcelasPrestacao.Post;
                       end;
    ppPARCELASCHEQUES: begin
                         qryParcelasResgate.Edit;
                         qryParcelasResgatevalordebito.AsCurrency := qryParcelasResgatevalorvencto.AsCurrency +
                                    tecFinanceira.CalcularJuros(qryParcelasResgatevalorvencto.AsCurrency,
                                                                qryParcelasResgatedatavencto.AsDateTime, StrToDate(Data));
                         if (qryParcelasResgatevalordebito.AsCurrency <> qryParcelasResgatevalorvencto.AsCurrency) then
                           qryParcelasResgatevalordebito.AsCurrency := Multiplo(qryParcelasResgatevalordebito.AsCurrency,
                                                                                ParSistema.ArredondamentoJurosCaixa );
                         qryParcelasResgatevalorpagto.AsCurrency  := qryParcelasResgatevalordebito.AsCurrency;
                         qryParcelasResgate.Post;
                       end;
    ppPARCELASABERTO,
    ppALTERARPARCELASABERTO: begin

                               qryParcelasAberto.Edit;
                               qryParcelasAbertovalordebito.AsCurrency := qryParcelasAbertovalorvencto.AsCurrency +
                                        tecFinanceira.CalcularJuros(qryParcelasAbertovalorvencto.AsCurrency,
                                                                    qryParcelasAbertodatavencto.AsDateTime, StrToDate(Data));
                               if (qryParcelasAbertovalordebito.AsCurrency <> qryParcelasAbertovalorvencto.AsCurrency) then
                                 qryParcelasAbertovalordebito.AsCurrency := Multiplo(qryParcelasAbertovalordebito.AsCurrency,
                                                                                        ParSistema.ArredondamentoJurosCaixa);
                                 qryParcelasAbertovalorpagto.AsCurrency  := qryParcelasAbertovalordebito.AsCurrency;
                                 qryParcelasAberto.Post;
                             end;
  end;
end;

