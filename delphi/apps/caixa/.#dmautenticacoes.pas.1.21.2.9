procedure Tdtmautenticacoes.LerParametros;
begin
  with tecFinanceira do begin
    DiasAtraso1       := ParSistema.DiasAtraso1;
    DiasAtraso2       := ParSistema.DiasAtraso2;
    PercentualMultas1 := ParSistema.PercentualAtrasoMultas1;
    PercentualMultas2 := ParSistema.PercentualAtrasoMultas2;
    TaxaJuros1        := ParSistema.PercentualAtrasoJuros1;
    TaxaJuros2        := ParSistema.PercentualAtrasoJuros2;
    Juros             := ParSistema.TaxaJuros;
    JurosSimples      := ParSistema.UtilizarJurosSimples;
    Descontos         := ParSistema.DescontoPagAntecipado;
  end;
end;

function Tdtmautenticacoes.GetConsultarContrato: TtecQuery;
begin
  result := qryConsultaContratos;
end;

function Tdtmautenticacoes.PosicionarRegistro(tipoConsulta: TtecConsultaAutenticacoes;
  Parametro: Integer): Boolean;
begin
  case tipoConsulta of
    paMOTIVOSDEVOLUCAO   : result := existeMotivo(qryMotivosDevolucaocodigo.FieldName,qryMotivosDevolucaocodigo.asString);
    paMOTIVOSCANCELAMENTO: result := existeMotivo(qryMotivosCancelamentocodigo.FieldName, qryMotivosCancelamentocodigo.asString);
    paMOTIVOSPERDA       : result := existeMotivo(qryMotivosPerdacodigo.FieldName,qryMotivosPerdacodigo.asString);
    paEVENTOS            : result := existeEvento(qryEventoscodigo.FieldName,qryEventoscodigo.asString);
    paCLIENTESCHEQUES    : result := existeCliente(qryClientesChequecodigo.FieldName,qryClientesChequecodigo.asString);
    paBANCOS             : result := existeBanco(qryBancoscodigo.FieldName,qryBancoscodigo.asString);
//    paAUTENTICACOES      : result := existeAutenticacao(qryAutenticacoesnumero.FieldName, qryAutenticacoesnumero.asString);
    paCAIXAS             : result := existeCaixa(qryCaixascodigo.FieldName,qryCaixascodigo.asString);
  else
    result := false;
  end;
end;

procedure Tdtmautenticacoes.ReFazConsultaClientes(tipoConsulta:
TtecConsultaAutenticacoes);
begin
  case tipoConsulta of
    paCONTRATOSPRESTACOES: if qryPrestacoestipocliente.AsString = 'C' then
                             refazConsulta(qryCliente,[0],[qryPrestacoescliente.asInteger])
                           else
                             ReFazConsulta(qryDadosFornecedor, [0],[qryPrestacoescliente.asInteger]);
    paCONTRATOSDEVOLUCOES: if qryDevolucoestipocliente.AsString = 'C' then
                             refazConsulta(qryCliente,[0],[qryDevolucoescliente.asInteger])
                           else
                             ReFazConsulta(qryDadosFornecedor, [0],[qryDevolucoescliente.asInteger]);
    paCONTRATOSPERDAS    : if qryPerdastipocliente.AsString = 'C' then
                             refazConsulta(qryCliente,[0],[qryPerdascliente.asInteger])
                           else
                             ReFazConsulta(qryDadosFornecedor, [0],[qryPerdascliente.asInteger]);
    paMOTIVOSDEVOLUCAO   : refazConsulta(qryMotivosDevolucao,[0],[qryConsultaMotivoscodigo.asInteger]);
    paMOTIVOSCANCELAMENTO: refazConsulta(qryMotivosCancelamento,[0],[qryConsultaMotivoscodigo.asInteger]);
    paMOTIVOSPERDA       : refazConsulta(qryMotivosPerda,[0],[qryConsultaMotivoscodigo.asInteger]);
    paEVENTOS            : refazConsulta(qryEventos,[0],[qryConsultaEventoscodigo.asInteger]);
(*    paCHEQUES            : begin
                            if qryResgatestipocliente.AsString = 'C' then
                                 RefazConsulta(qryCliente,[0],
[qryResgatescliente.asInteger])
                            else ReFazConsulta(qryDadosFornecedor,[0],
[qryResgatescliente.asInteger]);
                           end; *)
    paCLIENTESCHEQUES    : if qryClientesChequetipo.AsString = 'C' then
                                RefazConsulta(qryCliente,[0],[qryClientesChequecodigo.AsInteger])
                           else ReFazConsulta(qryDadosFornecedor, [0],[qryClientesChequecodigo.asInteger]);
    paFORNECEDORES       : refazConsulta(qryFornecedores,[0,1],[qryConsultaFornecedorescodigo.asInteger,qryConsultaFornecedorestipo.AsString]);
    paBANCOS             : refazConsulta(qryBancos,[0],[qryConsultaBancoscodigo.asInteger]);
//    paAUTENTICACOES      : refazConsulta(qryAutenticacoes,[0],[qryConsultaAutenticacoesnumero.asInteger]);
    paCAIXAS             : refazConsulta(qryCaixas,[0],[qryConsultaCaixascodigo.asInteger]);
    paCLIENTESDEVOLUCOES : if qryDevolucoesSaldotipocliente.AsString = 'C' then
                             refazConsulta(qryCliente,[0],[qryDevolucoesSaldocliente.asInteger])
                           else
                             ReFazConsulta(qryDadosFornecedor, [0],[qryDevolucoesSaldocliente.asInteger]);
    paCLIENTEPARCELAS    : if qryParcelasAbertotipocliente.AsString = 'C' then
                             ReFazConsulta(qryCliente,[0],[qryParcelasAbertocliente.asInteger])
                           else
                             ReFazConsulta(qryDadosFornecedor,[0],[qryParcelasAbertocliente.asInteger]);
  end;
end;

procedure Tdtmautenticacoes.ReFazConsultaContrato;
begin
  dtmautenticacoes.LerParametros;
  qryContratosPrestacao.DisableControls;
  refazConsulta(qryContratosPrestacao,[0,1], [qryPrestacoescliente.asInteger,qryPrestacoestipocliente.AsString]);
  reFazConsultaClientes(paCONTRATOSPRESTACOES);
  qryContratosPrestacao.EnableControls;
  qryContratosPrestacao.Locate('numero', qryPrestacoesnumero.asString, []);

  qryParcelasPrestacao.DisableControls;
  refazConsulta(qryParcelasPrestacao,[0],[qryContratosPrestacaonumero.asString]);
  qryParcelasPrestacao.Locate('quitado', 'False', []);
  //jr
  if Assigned(PosParcelaAutenticavel) then
      qryParcelasPrestacao.FreeBookmark(PosParcelaAutenticavel);
  PosParcelaAutenticavel := qryParcelasPrestacao.GetBookmark;

  if not qryParcelasPrestacaoquitado.AsBoolean then begin
    qryParcelasPrestacaodataPagto.AsDateTime := DataServidor;
    qryParcelasPrestacaoValorPagto.AsCurrency := qryParcelasPrestacaovalorvencto.AsCurrency +
                                                 tecFinanceira.CalcularJuros(qryParcelasPrestacaovalorvencto.AsCurrency,
                                                                             qryParcelasPrestacaodatavencto.AsDateTime,
                                                                             DataServidor);
  if (qryParcelasPrestacaovalorvencto.AsCurrency <> qryParcelasPrestacaovalorpagto.AsCurrency)  then
    qryParcelasPrestacaoValorPagto.AsFloat   := Multiplo(qryParcelasPrestacaoValorPagto.AsCurrency,
                                                         ParSistema.ArredondamentoJurosCaixa );
  end;
  qryParcelasPrestacao.EnableControls;

  // Ismael em 24/07/2006
  //FPagamentoEmDinheiro := 0;
end;

procedure Tdtmautenticacoes.Selecionar(tipoConsulta: TtecConsultaAutenticacoes);
begin
  case tipoConsulta of
    paCONTRATOSPRESTACOES: ReFazConsulta(qryPrestacoes,[0],[qryConsultaContratosnumero.AsString]);
    paCONTRATOSDEVOLUCOES: ReFazConsulta(qryDevolucoes,[0],[qryConsultaDevolucoesnumero.asString]);
    paCONTRATOSPERDAS    : ReFazConsulta(qryPerdas,[0],    [qryConsultaContratosPerdanumero.AsString]);
    paMOTIVOSDEVOLUCAO   : ReFazConsulta(qryMotivosDevolucao,[0],[qryConsultaMotivoscodigo.asInteger]);
    paMOTIVOSCANCELAMENTO: ReFazConsulta(qryMotivosCancelamento,[0],[qryConsultaMotivoscodigo.asInteger]);
    paMOTIVOSPERDA       : ReFazConsulta(qryMotivosPerda,[0],[qryConsultaMotivoscodigo.asInteger]);
    paEVENTOS            : ReFazConsulta(qryEventos,[0],[qryConsultaEventoscodigo.asInteger]);
//    paCHEQUES            : ReFazConsulta(qryResgates,[0], [qryConsultaChequesnumero.asString]);
    paCLIENTESCHEQUES    : begin
                             RefazConsultaPorNome(qryClientesCheque,['codigo','tipo'],[qryConsultaClientescodigo.AsString,qryConsultaClientestipo.AsString]);
                             qryCheques.Edit;
                             qryChequescliente.AsInteger := qryConsultaClientescodigo.AsInteger;
                             qryChequestipocliente.AsString := qryConsultaClientestipo.AsString;

                           end;
    paFORNECEDORES       : ReFazConsulta(qryFornecedores,[0,1], [qryConsultaFornecedorescodigo.asInteger,qryConsultaFornecedorestipo.AsString]);
    paBANCOS             : ReFazConsulta(qryBancos,[0], [qryConsultaBancoscodigo.asInteger]);
//    paAUTENTICACOES      : ReFazConsulta(qryAutenticacoes,[0],[qryConsultaAutenticacoesnumero.asInteger]);
    paCAIXAS             : ReFazConsulta(qryCaixas,[0],[qryConsultaCaixascodigo.asInteger]);
    paCLIENTESDEVOLUCOES : RefazConsulta(qryDevolucoesSaldo,[0,1],[qryConsultaClientescodigo.asInteger, qryConsultaClientestipo.asString]);
    paCLIENTEPARCELAS    : RefazConsulta(qryParcelasAberto,[0,1],[qryConsultaClientescodigo.asInteger, qryConsultaClientestipo.asString]);
  end;
end;

procedure Tdtmautenticacoes.Selecionar(TipoConsulta: TtecTipoConsultaAtendimento);
begin
  case TipoConsulta of
    tcaTIPOATENDIMENTO: begin
