procedure Tdtmautenticacoes.qryParcelasPrestacaoAfterScroll(DataSet: TDataSet);
begin
  inherited;
  if not (qryParcelasPrestacaoquitado.asBoolean) then
  begin
    qryParcelasPrestacaodataPagto.AsDateTime := DataServidor;
    qryParcelasPrestacaoValorPagto.AsCurrency := qryParcelasPrestacaoValorVencto.AsCurrency+tecFinanceira.CalcularJuros
                                                (qryParcelasPrestacaovalorvencto.AsCurrency, qryParcelasPrestacaodatavencto.AsDateTime,
                                                 DataServidor);
    if (qryParcelasPrestacaovalorvencto.AsCurrency <> qryParcelasPrestacaovalorpagto.AsCurrency)  then
      qryParcelasPrestacaoValorPagto.asFloat   := Multiplo(qryParcelasPrestacaoValorPagto.AsCurrency,
                                                         ParSistema.ArredondamentoJurosCaixa);
    qryParcelasPrestacaovalordebito.asFloat  := qryParcelasPrestacaoValorPagto.asFloat;
    ParcelaSemJuros := False;
  end;
end;

procedure Tdtmautenticacoes.qryParcelasPrestacaoBeforeScroll(DataSet: TDataSet);
begin
  inherited;
  if not (qryParcelasPrestacaoquitado.asBoolean) then begin
    qryParcelasPrestacaodataPagto.asString  := '';
    qryParcelasPrestacaoValorPagto.AsString := '';
    qryParcelasPrestacaovalordebito.asFloat := 0;
    qryParcelasPrestacaoparcial.asBoolean   := false;
  end;
end;

function Tdtmautenticacoes.ProcessarDescontoAntecipado: Boolean;
var
  ValorArredondado: Currency;
begin
  Result:= False;
  if (qryParcelasPrestacaodatavencto.AsDateTime < qryParcelasPrestacaodatapagto.asDateTime) then
    MensagemAviso(ctPARCELAEMATRASO)
  else begin
    LerParametros;
    qryParcelasPrestacaovalorpagto.AsCurrency:= qryParcelasPrestacaovalorvencto.AsCurrency +
                                                tecFinanceira.CalcularDesctos(qryParcelasPrestacaovalorvencto.AsCurrency,
                                                                              qryParcelasPrestacaodatavencto.AsDateTime,
                                                                              DataServidor);
    ValorArredondado:= Multiplo(qryParcelasPrestacaovalorpagto.AsCurrency, ParSistema.ArredondamentoJurosCaixa);

    if ValorArredondado < qryParcelasPrestacaovalorvencto.AsCurrency then
      qryParcelasPrestacaoValorPagto.AsCurrency:= ValorArredondado;
  end;
end;

