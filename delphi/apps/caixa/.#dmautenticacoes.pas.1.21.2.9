function Tdtmautenticacoes.EmitirCupom(ComTEF: Boolean; var FormaPagamento: Integer;
  var ValorPagoDinheiro: Currency): Boolean;

  function NaoPodeEmitirCupom: Boolean;
  begin
    if not ParSistema.AutenticacaoParcelasModo2 then
      RefazConsulta(qryEmitirCupom, [0,1], [NumeroContratoPrestacao,FilialBase])
    else
      RefazConsulta(qryEmitirCupom, [0,1], [FContratoParcelasAbertoTef,FilialBase]);
    if qryEmitirCupom.RecordCount > 0 then
      Result := False
    else
      Result := True;
  end;

begin
  Result := False;
  if (NaoPodeEmitirCupom) then//(qryContratosPrestacaosituacaocontrato.AsString = 'N') or  //AQUI TA O PROBLEMA DO CUPOM EMITIDO VIA CONTRATO
    Result := True and not ComTEF
  else if Assigned(ECFPadrao) then begin
          ECFPadrao.AtualizarTotalizadorGeral(NomeArquivoECFs);
    if Assigned(GravarContrato) then begin
      if not ParSistema.AutenticacaoParcelasModo2 then
        Result := GravarContrato(dtmCadCtr, FCupomEmitido, FormaPagamento,
                                 ValorPagoDinheiro, NumeroContratoPrestacao,
                                 NumeroPrestacaoPaga, PrestacaoValorPagto, ComTEF)
      else
        Result := GravarContrato(dtmCadCtr, FCupomEmitido, FormaPagamento,
                                 ValorPagoDinheiro, FContratoParcelasAbertoTef,
                                 FNroParcelaParcelasAbertoTef, FValorPagtoParcelasAbertoTef, ComTEF);
      if Not (Result or CupomEmitido) then begin
        if Assigned(DtmCadCtr) then begin
          DtmCadCtr.Free;
          DtmCadCtr := nil;
        end
      end
    end else
      MensagemErro('A variável ''dmBasico.GravarContrato'' não esta definida.'+#13#10+'Entre em contato com suporte do tecLUX.')
  end else if COmTEF then
    MensagemAviso('Não há nenhum ECF conectado ao computador')
  else
    Result := True;
  if Assigned(ECFPadrao) then
      ECFPadrao.AtualizarTotalizadorGeral(NomeArquivoECFs);
end;

