function Tdtmautenticacoes.ValorDuplicataPagar: Currency;
var
  Multa,Juros: Real;
  NrDias: Integer;
begin
  Multa:= 0;  Juros:= 0;
  if (DataServidor > qryDuplicatasDocdatavencto.AsDateTime) then begin
    NrDias:= DaysBetween(DataServidor,qryDuplicatasDocdatavencto.AsDateTime);
    if qryDuplicatasDocmulta.AsFloat > 0 then
      if (qryDuplicatasDoctipomulta.AsString = '%') then
           Multa := ((qryDuplicatasDocvalorvencto.AsCurrency * qryDuplicatasDocmulta.AsFloat) / 100)
      else Multa := qryDuplicatasDocmulta.AsFloat;

    if qryDuplicatasDocjuros.AsFloat > 0 then
      if qryDuplicatasDoctipojuros.AsString = '%' then
           Juros := ((qryDuplicatasDocvalorvencto.AsCurrency * (qryDuplicatasDocjuros.AsFloat * NrDias)) / 100)
      else Juros := (qryDuplicatasDocjuros.AsFloat * NrDias);
  end;
  Result:= qryDuplicatasDocvalorvencto.AsCurrency + Multa + Juros - qryDuplicatasDocvalordesconto.AsCurrency;
end;

