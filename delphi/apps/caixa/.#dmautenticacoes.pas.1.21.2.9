    paCONTRATOSPERDAS    : fecha(ctCaixaConsultaContratosPerda);
    paCONTRATOSDEVOLUCOES: fecha(ctCaixaConsultaDevolucoes);
    paMOTIVOSDEVOLUCAO,
    paMOTIVOSCANCELAMENTO,
    paMOTIVOSPERDA       : fecha(ctCaixaConsultaMotivos);
    paEVENTOS            : fecha(ctCaixaConsultaEventos);
    paCHEQUES            : fecha(ctCaixaConsultaCheques);
    paCLIENTESCHEQUES,
    paCLIENTESDEVOLUCOES,
    paCLIENTEPARCELAS    : fecha(ctCaixaConsultaClientes);
    paFORNECEDORES       : fecha(ctCaixaConsultaFornecedores);
    paBANCOS             : fecha(ctCaixaConsultaBancos);
//    paAUTENTICACOES      : fecha(ctCaixaConsultaAutenticacoes);
    paCAIXAS             : fecha(ctCaixaConsultaCaixas);
  end;
end;

procedure Tdtmautenticacoes.FechaTabelasConsulta(TipoConsulta: TtecTipoConsultaAtendimento);
begin
  case TipoConsulta of
    tcaTIPOATENDIMENTO: fecha(ctAtendConsultaTiposAtendimentos);
  end;
