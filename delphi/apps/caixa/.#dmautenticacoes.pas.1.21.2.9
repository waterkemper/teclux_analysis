procedure Tdtmautenticacoes.ImprimirAutenticacao(tipo: String; Valor: Real);
var
  Linha, Totalizador: String;
begin
  if Assigned(ECFPadrao) and ParSistema.AutenticarECF then
  begin
    ECFPadrao.AtualizarTotalizadorGeral(NomeArquivoECFs);
    if ContadorAutenticacao = 0 then
    begin
      if ParSistema.TotalizadorAutenticacao = '' then
        Totalizador := 'Prestacoes'
      else
        Totalizador := ParSistema.TotalizadorAutenticacao;
      ECFPadrao.ImprimirNaoFiscal(Totalizador, 'Dinheiro', Format('%11.2f',[Valor]));
    end;
    if ECFPadrao.Erro then
      MensagemErro(ECFPadrao.Mensagem)
    else
    begin
      frmMsg := TfrmMensagemTemporizada.Create(Screen.ActiveForm, 'Insira o documento no ECF');
      try
        frmMsg.Show;
        frmMsg.SetFocus;
        Application.ProcessMessages;
        ECFPadrao.Autenticar;
      finally
        frmMsg.Free;
      end;
      Inc(FContadorAutenticacao);
    end
  end
  else
  begin
    with TextPrinter do
    begin
      NomeImpressoraEscolhida := ParSistema.NomeImpressoraFechamentoCaixa;
      //BeginDoc('', False);
      if ParSistema.Autenticadora in [1,2,4] then
      begin
        BeginDoc('', False);
        writeText(#$0F,0);
      end
      else
      begin
        BeginDoc('', True);
        writeText(EPS_ON_CONDENSED,0);
      end;
      Linha := RazaoQuitacao + ' ' + inttostr(FilialBase) + ' CX ' +
                trocar(format('%5s', [inttostr(CodigoUsuario)]),' ','0')+ ' ' +
                tipo+ ' A' +
                trocar(format('%6s', [inttostr(dtmautenticacoesauxiliar.NumeroAutenticacao)]),' ','0') + ' ' +
                formatdatetime('dd/mm/yy',DataServidor)+ ' ' +
                format('%14s',[trim(Trocar(Trocar(Format('%11.2m',[Valor]),'R',''),'$',''))]);

      if not (ParSistema.Autenticadora in [1, 4]) then
        WriteText(Linha, 0);

      if ParSistema.Autenticadora = 1 then
      begin
//        writeTextln(#$1B+#$61+#$01 + Linha, 0)
        writeTextln(Linha, 0);
      end

      else if ParSistema.Autenticadora = 2 then
        writeText(#$56, 0)
      else if ParSistema.Autenticadora = 4 then
     {$IFDEF LINUX}
        WriteTextln(#$1B+#$55+Linha, 0)
     {$ELSE}
        WriteText(#$1B+#$55+Linha+#$0D+#$0A, 0)
     {$ENDIF}
      else
        writeText(EPS_OFF_CONDENSED,0);
      EndDoc('TecLUX - Imprimindo Autenticação de Caixa.');
    end;
  end;
end;

