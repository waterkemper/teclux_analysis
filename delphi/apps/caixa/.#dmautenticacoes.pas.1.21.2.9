function Tdtmautenticacoes.VerificaAutenticacoesMesmaTransacao: Boolean;
begin
  Result := qryAutenticacoestransacao.AsInteger = 0;  //Caso a autenticacao nao possua transacao, OK!
  if not Result then
  begin
    ReFazConsulta(qryNrAutenticacoesTransacao,[0,1],[qryAutenticacoestransacao.AsInteger,
                                                     qryAutenticacoestipo.AsString]);
    Result := qryNrAutenticacoesTransacao.RecordCount = 1; //Caso nao exista outras autenticacoes na mesma transacao, OK!
    FCancelamentoTransacao := True;
  end
  else
    FCancelamentoTransacao := False;
  if not Result then
  begin
    Result := MensagemConfirmacao(ctEXISTEAUTENTICACAOMESMATRANSACAO) = smbOK;
    FCancelamentoTransacao := Result;
  end;
end;

procedure Tdtmautenticacoes.AutenticacoesTransacao(var A : TResumoAutenticacoes);
var
  i : Integer;
begin
  qryNrAutenticacoesTransacao.DisableControls;
  SetLength(A, qryNrAutenticacoesTransacao.RecordCount);
  qryNrAutenticacoesTransacao.First;
  for i := 0 to high(a) do
  begin
    A[i].Autenticacao := qryNrAutenticacoesTransacaonumero.AsInteger;
    A[i].Tipo         := qryNrAutenticacoesTransacaotipo.AsString;
    A[i].Valor        := qryNrAutenticacoesTransacaovalor.AsCurrency;
    qryNrAutenticacoesTransacao.Next;
  end;
  qryNrAutenticacoesTransacao.EnableControls;
end;

function Tdtmautenticacoes.autenticarCancelamentoTransacao(Motivo: Integer;
  Valor: Currency; Imprimir: Boolean): Integer;
var
  Transacao : Integer;
begin
  Result := mrNone;

  qryImprimirAcumulado.Close;

  qryNrAutenticacoesTransacao.DisableControls;
  qryNrAutenticacoesTransacao.First;
  Transacao := qryNrAutenticacoesTransacaotransacao.AsInteger;
  while not qryNrAutenticacoesTransacao.Eof do
  begin
    Result := dtmautenticacoesauxiliar.autenticarCancelamento(qryNrAutenticacoesTransacaonumero.AsInteger,
                                                    Motivo, qryNrAutenticacoesTransacaovalor.AsCurrency,
                                                    qryNrAutenticacoesTransacaocontratoparcela.AsString);

    if result = mrOK then
    begin
      if Imprimir then
        ImprimirAutenticacao('C',qryNrAutenticacoesTransacaovalor.AsCurrency);
    end
    else
      Break;
    qryNrAutenticacoesTransacao.Next;
  end;
  qryNrAutenticacoesTransacao.DisableControls;
  if Result = mrOK then
    Result := dtmautenticacoesauxiliar.cancelarRecebimentos(Transacao);
  if (Result = mrOK) and FExclusaoCheques then
  begin
    try
      qryRecebimentos.DisableControls;
      qryRecebimentos.First;
      while not qryRecebimentos.Eof do
      begin
        if qryRecebimentoscheque.AsString <> '' then
          dtmautenticacoesauxiliar.desfazAutenticacaoCheque(qryRecebimentoscheque.AsString);
        qryRecebimentos.Next;
      end;
    finally
      qryRecebimentos.EnableControls;
    end;
  end;

end;

