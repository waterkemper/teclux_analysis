procedure Tdtmautenticacoes.qryParcelasAbertoAfterScroll(DataSet: TDataSet);
begin
  inherited;
  if not qryParcelasAbertoselecionar.AsBoolean then begin
    qryParcelasAbertodatapagto.AsDateTime := DataServidor;
    qryParcelasAbertovalorpagto.AsCurrency := qryParcelasAbertovalorvencto.AsCurrency+tecFinanceira.CalcularJuros
                                                (qryParcelasAbertovalorvencto.AsCurrency, qryParcelasAbertodatavencto.AsDateTime,
                                                 DataServidor);
    if (qryParcelasAbertovalorvencto.AsCurrency <> qryParcelasAbertovalorpagto.AsCurrency)  then
      qryParcelasAbertovalorpagto.AsCurrency   := Multiplo(qryParcelasAbertovalorpagto.AsCurrency,
                                                         ParSistema.ArredondamentoJurosCaixa);
    qryParcelasAbertovalordebito.asFloat  := qryParcelasAbertovalorpagto.asFloat;
    if ParSistema.MostrarValorContrato then
      RefazConsultaPorNome(qryContratos,['Numero'], [qryParcelasAbertocontrato.AsVariant]);
  end;
end;

