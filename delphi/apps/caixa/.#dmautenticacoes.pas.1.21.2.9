function Tdtmautenticacoes.RefazConsultaResgate(Cheque: String): Boolean;
begin
  ReFazConsulta(qryResgates,[0],[Cheque]);
  if not qryResgates.IsEmpty then
  begin
    Result:= True;
    RefazConsulta(qryChequesResgate,[0,1],[qryResgatescliente.AsInteger, qryResgatestipocliente.AsString]);
    qryChequesResgate.Locate('numero', qryResgatesnumero.AsString,[]);
    ReFazConsulta(qryParcelasResgate,[0],[qryChequesResgatenumero.AsString]);
    if not qryParcelasResgate.IsEmpty then
    begin
      qryParcelasResgate.Locate('resgatado', 'False', []);
      if not qryParcelasResgateresgatado.AsBoolean then
      begin
        qryParcelasResgatedataPagto.AsDateTime  := DataServidor;
        qryParcelasResgateValorPagto.AsCurrency := qryParcelasResgateValorVencto.AsCurrency +
                                                   tecFinanceira.CalcularJuros(qryParcelasResgatevalorvencto.AsCurrency,
                                                                               qryParcelasResgatedatavencto.AsDateTime,
                                                                               DataServidor);
        if qryResgatestipocliente.AsString = 'C' then
             ReFazConsulta(qryCliente,[0],[qryResgatescliente.AsInteger])
        else ReFazConsulta(qryDadosFornecedor,[0],[qryResgatescliente.AsInteger]);
      end;
    end;
  end
  else begin
    MensagemAviso(ctAVISORESGATECHEQUE);
    Result:= False;
  end;
end;

