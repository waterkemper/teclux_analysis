function Tdtmautenticacoes.ProcessarDescontoAntecipadoParcelasAberto: Boolean;
var
  ValorArredondado: Currency;
begin
  Result:= False;
  if (qryParcelasAbertodatavencto.AsDateTime < qryParcelasabertodatapagto.asDateTime) then
    MensagemAviso(ctPARCELAEMATRASO)
  else begin
    LerParametros;
    TotalMarcados := TotalMarcados - qryParcelasAbertovalorpagto.AsCurrency;
    qryParcelasAbertovalorpagto.AsCurrency:= qryParcelasAbertovalorvencto.AsCurrency +
                                                tecFinanceira.CalcularDesctos(qryParcelasAbertovalorvencto.AsCurrency,
                                                                              qryParcelasAbertodatavencto.AsDateTime,
                                                                              DataServidor);
    ValorArredondado:= Multiplo(qryParcelasAbertovalorpagto.AsCurrency, ParSistema.ArredondamentoJurosCaixa);

    if ValorArredondado < qryParcelasAbertovalorvencto.AsCurrency then
      qryParcelasAbertovalorpagto.AsCurrency:= ValorArredondado;
    TotalMarcados := TotalMarcados + qryParcelasAbertovalorpagto.AsCurrency;
  end;
end;

