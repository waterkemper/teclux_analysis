function Tdtmautenticacoes.autenticarParcelasAberto(FormaPagamento: Integer;
   ValorPagoDinheiro: Currency; Imprimir, ComCartao: Boolean): Integer;
var
 VlParcela, Valor, ValorAux: Real;
 Parcelas: TtecParcelaFormaPagto;
 a, NroParcela: Integer;

begin

  Result    := mrOK;
  qryParcelasAberto.First;
  while not qryParcelasAberto.Eof do
  begin
    if (qryParcelasAbertovalorpagto.AsFloat = 0) and qryParcelasAbertoselecionar.AsBoolean then
    begin
      result := mrCancel;
      MensagemErro(format('O contrato %s e parcela %s esta com o valor de pagamento zerado. Entre em contato com o suporte.',
                   [qryParcelasAbertocontrato.AsString, qryParcelasAbertonumero.AsString]));
      break;
    end
    else
      qryParcelasAberto.next;
  end;

  if result = mrOK then
  begin
    qryParcelasAberto.First;
    Result := mrNone;
  //GERA O NUMERO DA TRANSACAO
    spcTransacaoProximo.Open;
    FTransacao := spcTransacaoProximotransacao.AsInteger;
    spcTransacaoProximo.Close;
    qryImprimirAcumulado.Close;

    if ComCartao and (FormaPagamento > 0) and (ParSistema.TipoTEF <> tsSEMTEF)  then begin
      Result    := mrOK;
      VlParcela := 0;
      Valor     := 0;
      a         := 0;
      ValorAux  := ValorPagoDinheiro;
      qryParcelasAberto.First;
      while Not qryParcelasAberto.Eof do
      begin
        if qryParcelasAbertoselecionar.AsBoolean then
        begin

          SetLength(Parcelas, a+1);
          VlParcela := VlParcela + qryParcelasAbertovalorpagto.AsFloat;
          if qryParcelasAbertotipotiporecebimento.AsString = 'D' then begin
            ValorPagoDinheiro := ValorPagoDinheiro - qryParcelasAbertovalorvencto.AsCurrency;
            Parcelas[a].FormaPagto := 'D';
          end else if qryParcelasAbertovalorvencto.AsCurrency <= ValorPagoDinheiro then begin
            ValorPagoDinheiro := ValorPagoDinheiro - qryParcelasAbertovalorvencto.AsCurrency;
            FormaPagamento    := 4;
            Parcelas[a].FormaPagto := 'D';
          end else if ValorPagoDinheiro > 0 then begin
            Parcelas[a].FormaPagto := qryParcelasAbertotipotiporecebimento.AsString;
            qryParcelasAberto.Edit;
            qryParcelasAbertovalorpagto.AsCurrency := qryParcelasPrestacaovalorvencto.AsCurrency - ValorPagoDinheiro;
            qryParcelasAbertoparcial.asBoolean     := True;
            qryParcelasAberto.Post;
            Valor             := ValorPagoDinheiro;
            ValorPagoDinheiro := 0;
            FormaPagamento    := 0;
          end else begin
            FormaPagamento := 0;
            Parcelas[a].FormaPagto := qryParcelasAbertotipotiporecebimento.AsString;
          end;
          Parcelas[a].Numero := qryParcelasAbertonumero.AsInteger;
          Result := QuitarParcelaAberta(FormaPagamento = 4, True, NroParcela);
          if Result = mrOK then
            acumularParcelasAberto;
          Inc(a);
        end;
        qryParcelasAberto.Next;
      end;

      try
        if qryParcelasAberto.Eof then begin
          FValorPagamentoParcela := VlParcela;
          if Result = mrOK then
            result := dtmautenticacoesauxiliar.autenticarPrestacao(FNumeroContrato,
                                                                   Parcelas,
                                                                   FTransacao);
          if (Result = mrOK) and (Valor > 0) then
            result := dtmautenticacoesauxiliar.autenticarPrestacao(FNumeroContrato,
                                                                   NroParcela,
                                                                   Valor,
                                                                   False,
                                                                   FTransacao);
          if Result = mrOK then begin
            FPagamentoEmDinheiro := FPagamentoEmDinheiro + ValorAux;
  {$IFDEF MSWINDOWS}
// Gedovar : rever
//            if Assigned(BackupTEFDiscado) then
//              BackupTEFDiscado.ApagarArquivo;
  {$ENDIF}
          end;
          FCupomEmitido := False;
          if Assigned(DtmCadCtr) then begin
            DtmCadCtr.Free;
            DtmCadCtr := nil;
          end
        end else
          Result := mrCancel;
  {$IFDEF MSWINDOWS}
// Gedovar : rever
//        if Assigned(BackupTEFDiscado) and (Result <> mrOK) then
//          BackupTEFDiscado.ExecutarBackup;
  {$ENDIF}
      except
        FCupomEmitido := False;
  {$IFDEF MSWINDOWS}
// Gedovar : rever
//        if Assigned(BackupTEFDiscado) then
//          BackupTEFDiscado.ExecutarBackup;
  {$ENDIF}
        if Assigned(DtmCadCtr) then begin
          DtmCadCtr.Free;
          DtmCadCtr := nil;
        end;
        raise;
      end
    end
    else
    begin
      qryParcelasAberto.First;
      while not qryParcelasAberto.Eof do
      begin
        if qryParcelasAbertoselecionar.AsBoolean then
        begin
          if EmitirCupomParcelasAberto(qryParcelasAbertocontrato.AsString,
                                       qryParcelasAbertonumero.AsInteger,
                                       qryParcelasAbertovalorpagto.AsCurrency,
                                       False, FormaPagamento, ValorPagoDinheiro)  then
          begin
            try
              result := QuitarParcelaAberta(True, False, NroParcela);
              if result = mrOK then begin
                result := dtmautenticacoesauxiliar.autenticarPrestacao(FNumeroContrato, FNumeroParcelaContrato,
                                                                       FValorPagamentoParcela, ComCartao,
                                                                       FTransacao);
                if result = mrOK then
                begin
                  if Not ComCartao then
                    FPagamentoEmDinheiro := FPagamentoEmDinheiro + FValorPagamentoParcela;
                    acumularParcelasAberto;

    {$IFDEF MSWINDOWS}
// Gedovar : rever
//                  if Assigned(BackupTEFDiscado) and ComCartao then
//                    BackupTEFDiscado.ApagarArquivo;
    {$ENDIF}
                  //refazConsulta(qryParcelasPrestacao,[0],[FNumeroContrato]);
    //              PosParcelaAutenticavel := qryParcelasPrestacao.GetBookmark;
                end;
              end;
              if (result <> mrOK) and FCupomEmitido then
                ECFPadrao.CancelarCupom;
              FCupomEmitido := False;
              if Assigned(DtmCadCtr) then
              begin
                DtmCadCtr.Free;
                DtmCadCtr := nil;
              end;
    {$IFDEF MSWINDOWS}
// Gedovar : rever
//              if (result <> mrOK) and Assigned(BackupTEFDiscado) then
//                BackupTEFDiscado.ExecutarBackup;
    {$ENDIF}
              if (result = mrOK) and Imprimir then
              begin
                FContadorAutenticacao := 0;
                ImprimirAutenticacao('P',FValorPagamentoParcela);
              end;
            except
              if FCupomEmitido then
                ECFPadrao.CancelarCupom;
            FCupomEmitido := False;
    {$IFDEF MSWINDOWS}
// Gedovar : rever
//            if Assigned(BackupTEFDiscado) then
//              BackupTEFDiscado.ExecutarBackup;
    {$ENDIF}
            if Assigned(DtmCadCtr) then begin
              DtmCadCtr.Free;
              DtmCadCtr := nil;
            end;
            raise;
            end
          end else
            result := mrCancel
        end;
        qryParcelasAberto.Next;
      end;
    end;
  {  qryParcelasAberto.DisableControls;
    ReFazConsulta(qryParcelasAberto,[0],[CodigoClienteParcelasAberto]);
    qryParcelasAberto.EnableControls;
    if qryParcelasAberto.RecordCount = 0 then
    begin
      MensagemAviso(ctCLIENTEPARCELASABERTO);
    end;
  }
  end;
end;

function Tdtmautenticacoes.EmitirCupomParcelasAberto(Contrato: String;
  Parcela: Integer; ValorPagto: Currency; ComTEF: Boolean;
  var FormaPagamento: Integer; var ValorPagoDinheiro: Currency): Boolean;

  function NaoPodeEmitirCupom: Boolean;
  begin
    if not ParSistema.AutenticacaoParcelasModo2 then
      RefazConsulta(qryEmitirCupom, [0,1], [NumeroContratoPrestacao,FilialBase])
    else
      RefazConsulta(qryEmitirCupom, [0,1], [Contrato,FilialBase]);
    if qryEmitirCupom.RecordCount > 0 then
      Result := False
    else
      Result := True;
  end;

begin
  Result := False;
  if (NaoPodeEmitirCupom) then
    Result := True
  else if Assigned(ECFPadrao) then begin
    if Assigned(GravarContrato) then begin
      ECFPadrao.AtualizarTotalizadorGeral(NomeArquivoECFs);
      Result := GravarContrato(dtmCadCtr, FCupomEmitido, FormaPagamento,
                               ValorPagoDinheiro, Contrato, Parcela, ValorPagto, ComTEF);
      if Not (Result or CupomEmitido) then begin
        if Assigned(DtmCadCtr) then begin
          DtmCadCtr.Free;
          DtmCadCtr := nil;
        end
      end
    end else
      MensagemErro('A variável ''dmBasico.GravarContrato'' não está definida.'+#13#10+'Entre em contato com suporte do tecLUX.')
  end else if COmTEF then
    MensagemAviso('Não há nenhum ECF conectado ao computador')
  else
    Result := True
end;

function Tdtmautenticacoes.QuitarParcelaAberta(Dinheiro, Nova: Boolean; var NroParcela: Integer): Integer;
var
  valorparcial: Real;
begin
  FNumeroContrato        := qryParcelasAbertocontrato.asString;
  FNumeroParcelaContrato := qryParcelasAbertonumero.asInteger;
  FValorPagamentoParcela := qryParcelasAbertovalorpagto.AsFloat;
  FDataVenda             := qryParcelasAbertodata.AsDateTime;
  FDataVencto            := qryParcelasAbertodatavencto.AsDateTime;
  FValorVenctoParcela    := qryParcelasAbertovalorvencto.AsFloat;
//  FPagamentoParcial      := qryParcelasPrestacaoparcial.asBoolean;
  if Dinheiro then
    FFormaPagamento      := 'D'
  else
    FFormaPagamento      := qryParcelasAbertotipotiporecebimento.AsString;
  if qryParcelasAbertoparcial.asBoolean then
  begin
    if qryParcelasAbertoparcialsemjuros.asBoolean then
    begin
      valorParcial := calcularValorParcial(qryParcelasAbertovalorvencto.asFloat,
                                           qryParcelasAbertovalorpagto.asFloat,
                                           qryParcelasAbertovalorvencto.asFloat);
    end
    else
    begin
      valorParcial := calcularValorParcial(qryParcelasAbertovalorvencto.asFloat,
                                           qryParcelasAbertovalorpagto.asFloat,
                                           qryParcelasAbertovalordebito.asFloat);
    end;
    if qryParcelasAbertovalorvencto.asFloat > valorParcial then
    begin
      if valorparcial = 0 then
      begin
        MensagemErro(format('O contrato %s e parcela parcial %s esta com o valor de pagamento zerado. Entre em contato com o suporte.',
                     [qryParcelasAbertocontrato.AsString, qryParcelasAbertonumero.AsString]));
        result := mrCancel;
      end
      else
        result := dtmautenticacoesauxiliar.inserirParcelaContratoParcial(FNumeroContrato,
                                                                         qryParcelasAbertodatavencto.asString,
                                                                         (qryParcelasAbertovalorvencto.asFloat - valorParcial),
                                                                         qryParcelasAbertoParcelaOrigem.asstring,
                                                                         Nova, qryParcelasAbertonumero.AsInteger,
                                                                         NroParcela);
    end
    else
      result := mrOk;

    if result = mrOK then
      result := dtmautenticacoesauxiliar.atualizarParcelaContrato(FNumeroContrato, FNumeroParcelaContrato, valorParcial, FValorPagamentoParcela, FFormaPagamento);
  end else
    result := dtmautenticacoesauxiliar.atualizarParcelaContrato(FNumeroContrato, FNumeroParcelaContrato, FValorPagamentoParcela, FFormaPagamento, FTransacao);
end;

