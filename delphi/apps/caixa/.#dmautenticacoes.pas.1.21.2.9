procedure Tdtmautenticacoes.ImprimirReciboParcelasAcumuladas(Assinatura: String);
var
  MaxCol, nLinhas, Comp, a : Integer;
  Linha: String;
  Relatorio : TStringList;
  Imprimindonaecf : boolean;
  vcontinuar : Boolean;

{$IFNDEF LINUX}
{$ENDIF}

  procedure Alinhar(Tipo: TAlignment; PosAtual: Integer = 0);
  begin
    case Tipo of
      taCenter: Insert(stringOfChar(' ', (MaxCol - Length(linha)) div 2), Linha, 1);
      taRightJustify: Insert(stringOfChar(' ', MaxCol - Length(linha) - PosAtual), Linha, 1);
    end
  end;

  procedure ImprimirLinha(texto: String;posicao: integer); overload;
  begin
    if a = 1 then
    begin
      if (texto = '') then
        Relatorio.Append(stringOfChar(' ', MaxCol))
      else
        Relatorio.Append(texto);
    end;

    if (texto = '') then
      TextPrinter.writeln
    else
      TextPrinter.WriteTextln(texto, posicao);
  end;

begin
  ImprimindonaECF := assigned(ecfpadrao);
  NomeImpressoraEscolhida := parsistema.NomeImpressoraFechamentoCaixa;
  vcontinuar := assigned(ECFPadrao) or (NomeImpressoraEscolhida<>'');

  if not vcontinuar then
  begin
    frmSelecionarImpressoras := TfrmSelecionarImpressoras.Create(frmSelecionarImpressoras, 'F');
    try
      if frmSelecionarImpressoras.ShowModal = mrok then
      begin
        NomeImpressoraEscolhida := frmSelecionarImpressoras.NomeImpressora;
        vcontinuar := True;
      end
      else
      begin
        vcontinuar := False;
        MensagemAviso(ctSELECIONARIMPRESSORA);
      end;
    finally
      frmSelecionarImpressoras.Free;
    end;
  end;

  if vcontinuar then
  begin
    Relatorio := TStringList.Create;
    try
      if ParSistema.MaxColAutenticadora <> 0 then
        MaxCol := ParSistema.MaxColAutenticadora
      else
        MaxCol := 60;

      with TextPrinter do
      begin
        if ImprimindonaECF then
          ImprimirParaArquivo := True
        else
          ImprimirParaArquivo := False;
        Text.Clear;

        for a := 1 to ParSistema.NumeroCopiasdorecibo do
        begin

          if ParSistema.Autenticadora in [1,2,4] then
          begin
            BeginDoc('', False);
  //          Relatorio.Append(Esc8lpp+Esc12cpp+EscDraft+EscCondensedOn+EscLargeOff);
          end
          else
          begin
            BeginDoc('', True);
            writeText(EPS_ON_CONDENSED,0);
          end;


          ImprimirLinha('', 0);

          Linha := RazaoFilialBase;
          Alinhar(taCenter);

          ImprimirLinha(linha, 0);

          Linha := RuaFilialBase + ' - ' + BairroFilialBase;
          Alinhar(taCenter);
          ImprimirLinha(linha, 0);

          Linha := FormatarCEP(CEPFilialBase) + ' - ' + CidadeFilialBase + ' - ' + EstadoFilialBase;
          Alinhar(taCenter);
          ImprimirLinha(linha, 0);

          Linha := ctCGCMF + ' ' + FormatarCPFouCGC(CNPJFilialBase) ;
          Alinhar(taCenter);
          ImprimirLinha(linha, 0);

          Linha := ctIE + ' ' + InscricaoEstadualFilialBase ;
          Alinhar(taCenter);
          ImprimirLinha(linha, 0);


          ImprimirLinha('', 0);

          Linha := uppercase(format(ctRECIBODEPAGAMENTO,['']));
          Alinhar(taCenter);
          ImprimirLinha(linha, 0);

          ImprimirLinha('', 0);

          Linha := ANSIUpperCase(ctCLIENTE) + '.: ' +qryClientecodigo.AsString+' - '+qryClientenome.AsString;
          ImprimirLinha(linha, 0);

          Linha := format('%-23s',[ANSIUpperCase(ctCAIXA) + '...: '+inttostr(CodigoUsuario)])+
                   format('%-17s',[ANSIUpperCase(ctFILIAL) + '.: '+inttostr(filialbase)]);
          ImprimirLinha(linha, 0);

          linha := 'AUTENT. CONTRATO  P  VENCTO  V.PARCELA   VL.PAGO';
                   {1234567 12345678 12 DD/MM/YY 23,123.99 23,123,99}

          ImprimirLinha(linha, 0);

          Linha := stringOfChar('-', MaxCol);
          Alinhar(tacenter);
          ImprimirLinha(linha, 0);

          nLinhas := 0;
          qryImprimirAcumulado.First;
          while nLinhas < qryImprimirAcumulado.RecordCount do begin
            Linha := qryImprimirAcumuladoautenticacao.AsString+' '+format('%-8.8s',[qryImprimirAcumuladocontrato.AsString])+' '+
                     format('%2.2s',[qryImprimirAcumuladoparcela.AsString])+' ' + {formatdatetime('dd/mm/yy',qryImprimirAcumuladodatavenda.AsDateTime)+' '+}
                     formatdatetime('dd/mm/yy',qryImprimirAcumuladodatavencto.AsDateTime)+' '+
                     format('%9s',[trim(Trocar(Trocar(Format('%6.2m',[qryImprimirAcumuladovalorparcela.asFloat]),'R',''),'$',''))])+' '+
                     format('%9s',[trim(Trocar(Trocar(Format('%6.2m',[qryImprimirAcumuladovalorpago.asFloat]),'R',''),'$',''))]);
//            Alinhar(taCenter);
            ImprimirLinha(linha, 0);

            if qryImprimirAcumuladoobservacao.AsString <> '' then begin
              Linha := qryImprimirAcumuladoobservacao.AsString;
              Alinhar(taLeftJustify);
              ImprimirLinha(linha, 0);
            end;
            Inc(nLinhas);
            qryImprimirAcumulado.Next;
          end;

          ImprimirLinha('', 0);

          Linha := ANSIUpperCase(ctTOTALRECEBIDO)+': '+FormatFloat('#0,' + ThousandSeparator + '00', PagamentoEmDinheiro);
          Alinhar(taRightJustify);
          ImprimirLinha(linha, 0);

          ImprimirLinha('', 0);

          Linha := CidadeFilialBase + ', ' + FormatDateTime( 'dd '' de ''mmmm'' de ''yyyy', DataServidor);
          Alinhar(taRightJustify);
          ImprimirLinha(linha, 0);

          ImprimirLinha('', 0);
          ImprimirLinha('', 0);
          ImprimirLinha('', 0);


          if length(Assinatura) <> 0 then
          begin
            Linha := stringOfChar('_', MaxCol-15);
            Alinhar(tacenter);
            ImprimirLinha(linha, 0);

            Linha := Assinatura;
            Alinhar(tacenter);
            ImprimirLinha(linha, 0);

            ImprimirLinha('', 0);
            ImprimirLinha('', 0);
            ImprimirLinha('', 0);
            ImprimirLinha('', 0);

          end;
          if ParSistema.Autenticadora in [1,4] then
            TextPrinter.writeText(#$12, 0)
          else
            if ParSistema.Autenticadora = 2 then
              TextPrinter.writeText(#$56, 0)
            else
              TextPrinter.writeText(EPS_OFF_CONDENSED,0);

          ImprimirLinha('', 0);
          ImprimirLinha('', 0);
          ImprimirLinha('', 0);

          EndDoc('TecLUX - Imprimindo recibo de Caixa.');

          if Assigned(ECFPadrao) then
            ECFPadrao.RelatorioGerencial(Relatorio);
        end;
      end;
    finally
      Relatorio.free;
      NomeImpressoraEscolhida := '';
    end;
  end;

end;

