function Tdtmautenticacoes.autenticarCheque(cheque, titular, cliente, TipoCliente: string; vencto: string;
                                                    valor: real; obs: String): integer;
begin
  result := dtmautenticacoesauxiliar.CadastrarCheque(cheque, titular, cliente, TipoCliente,
                                                     vencto, valor, NroRegistrosCheques > 0, obs);
  if result = mrOK then begin
    result := dtmautenticacoesauxiliar.autenticarCheque(cheque, valor);
    if result = mrOK then
