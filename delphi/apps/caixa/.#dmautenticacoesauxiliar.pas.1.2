procedure Tdtmautenticacoesauxiliar.AcertaPrestacoesCancelamentoParcelaParcial(contrato: String; nroparcela: integer);
begin
  ReFazConsulta(qryParcelaParcialOriginal,[0,1],[contrato,nroparcela]);
  qryAtualizarParcelaCancelamento.ParamByName('valorvencto').Value      := qryParcelaParcialGeradavalorvencto.AsFloat + qryParcelaParcialOriginalvalorvencto.asFloat;
  qryAtualizarParcelaCancelamento.ParamByName('contrato').Value         := contrato;
  qryAtualizarParcelaCancelamento.ParamByName('parcela').Value          := nroparcela;
  qryAtualizarParcelaCancelamento.ExecSql;
  qryApagarParcelaParcial.ParamByName('contrato').Value := contrato;
  qryApagarParcelaParcial.ParamByName('parcela').Value  := qryParcelaParcialGeradanumero.AsInteger;
  qryApagarParcelaParcial.ExecSql;
end;

function Tdtmautenticacoesauxiliar.atualizarAutenticacaoTransferencia(
  numero: integer; confirmacao, entradapendente: boolean): integer;
begin
  qryAtualizarAutenticacaoTransferencia.ParamByName('confirmacao').Value    := confirmacao;
  qryAtualizarAutenticacaoTransferencia.ParamByName('entradapendente').Value:= entradapendente;
  qryAtualizarAutenticacaoTransferencia.ParamByName('numero').Value         := numero;

  qryAtualizarAutenticacaoTransferencia.ExecSql;
  result := mrOK;
end;

function Tdtmautenticacoesauxiliar.atualizarDuplicata(DocumentoPag: integer; DataVencto: TDatetime): integer;
begin
  qryAtualizarDuplicata.ParamByName('valorpago').Value    := null;
  qryAtualizarDuplicata.ParamByName('datapago').Value     := null;
  qryAtualizarDuplicata.ParamByName('filialpagto').Value  := null;
  qryAtualizarDuplicata.ParamByName('DocumentoPag').Value := DocumentoPag;
  qryAtualizarDuplicata.ParamByName('DataVencto').Value   := DataVencto;

  qryAtualizarDuplicata.ExecSQL;
  result := mrOK;
end;

function Tdtmautenticacoesauxiliar.atualizarDuplicata(DocumentoPag: integer; DataVencto: TDatetime; vlPagto: real): integer;
begin
  qryAtualizarDuplicata.ParamByName('valorpago').Value    := vlPagto;
  qryAtualizarDuplicata.ParamByName('datapago').Value     := DataLocal;
  qryAtualizarDuplicata.ParamByName('filialpagto').Value  := FilialBase;
  qryAtualizarDuplicata.ParamByName('DocumentoPag').Value := DocumentoPag;
  qryAtualizarDuplicata.ParamByName('DataVencto').Value   := DataVencto;

  qryAtualizarDuplicata.ExecSql;
  result := mrOK;
end;

function Tdtmautenticacoesauxiliar.atualizarParcelaContrato(contrato: string; nroparcela: integer): integer;
begin
  if not ExisteParcialQuitada(contrato, nroparcela) then begin
    if CancelamentoParcelaParcial(contrato, nroparcela) then
      AcertaPrestacoesCancelamentoParcelaParcial(contrato, nroparcela);
    qryCancelarParcela.ParamByName('valorpagto').Value  := null;
    qryCancelarParcela.ParamByName('datapagto').Value   := null;
    qryCancelarParcela.ParamByName('filial').Value      := null;
    qryCancelarParcela.ParamByName('contrato').Value    := contrato;
    qryCancelarParcela.ParamByName('numero').Value      := nroparcela;
    qryCancelarParcela.ExecSql;
    result := mrOK;
  end
  else result := mrNone;
end;

function Tdtmautenticacoesauxiliar.atualizarParcelaContrato(
  contrato: string; nroparcela: integer; vlpagto: real; FormaPagto: String; transacao: Integer): integer;
begin
  qryAtualizarParcela.ParamByName('valorpagto').Value  := vlpagto;
  qryAtualizarParcela.ParamByName('datapagto').Value   := DataLocal;
  qryAtualizarParcela.ParamByName('filial').Value      := FilialBase;
  qryAtualizarParcela.ParamByName('formapagto').Value  := FormaPagto;
  qryAtualizarParcela.ParamByName('contrato').Value    := contrato;
  qryAtualizarParcela.ParamByName('numero').Value      := nroparcela;
  if transacao <> 0 then
    qryAtualizarParcela.ParamByName('transacao').Value   := transacao;
  qryAtualizarParcela.ExecSql;
  perpetrar([]);
  result := mrOK;
end;

function Tdtmautenticacoesauxiliar.atualizarParcelaContrato(
  contrato: string; nroparcela: integer; vlvencto, vlpagto: real; FormaPagto: String): integer;
begin
  qryAtualizarParcelaParcial.ParamByName('valorvencto').Value := vlvencto;
  qryAtualizarParcelaParcial.ParamByName('valorpagto').Value  := vlpagto;
  qryAtualizarParcelaParcial.ParamByName('datapagto').Value   := DataLocal;
  qryAtualizarParcelaParcial.ParamByName('filial').Value      := FilialBase;
  qryAtualizarParcelaParcial.ParamByName('formapagto').Value  := FormaPagto;
  qryAtualizarParcelaParcial.ParamByName('contrato').Value    := contrato;
  qryAtualizarParcelaParcial.ParamByName('numero').Value      := nroparcela;
  qryAtualizarParcelaParcial.ExecSql;
  result := mrOK;
end;

