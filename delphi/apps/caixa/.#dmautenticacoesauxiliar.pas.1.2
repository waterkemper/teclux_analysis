function Tdtmautenticacoesauxiliar.DesfazerOperacoesAutenticacao(autenticacao: integer): integer;
begin
  result := mrOK;
  ReFazConsulta(qryAutenticacoes,[0],[autenticacao]);
  if (qryAutenticacoestipo.AsString = 'P') or (qryAutenticacoestipo.AsString = 'T') then
    Result := AtualizarParcelaContrato(qryAutenticacoescontratoparcela.AsString, qryAutenticacoesparcela.AsInteger)
  else if qryAutenticacoestipo.AsString = 'N' then
    Result := DesFazAutenticacaoDevolucao(qryAutenticacoescontrato.asString, qryAutenticacoesdata.asDateTime, qryAutenticacoesvalor.asFloat)
  else if qryAutenticacoestipo.AsString = 'J' then
    Result := DesFazAutenticacaoPerda(qryAutenticacoescontrato.asString, qryAutenticacoesvalor.asFloat)
  else if qryAutenticacoestipo.AsString = 'H' then
    Result := DesFazAutenticacaoCheque(qryAutenticacoescheque.asString)
  else if qryAutenticacoestipo.AsString = 'G' then
    Result := AtualizarDuplicata(qryAutenticacoesdocumentopag.asInteger, qryAutenticacoesvenctoduplicata.AsDatetime)
  else if qryAutenticacoestipo.AsString = 'R' then
    Result := AtualizarParcelaResgate(Autenticacao)
  else if qryAutenticacoestipo.AsString = 'A' then
    Result := DesfazAutenticacaoDevolucaoSaldo(qryAutenticacoesnumero.AsInteger, qryAutenticacoesvalor.asFloat);
//   else if (qryAutenticacoestipo.AsString = 'B') or (qryAutenticacoestipo.AsString = 'D') then
//    result := mrOK
//  else
end;

