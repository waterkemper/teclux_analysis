function Tdtmautenticacoesauxiliar.autenticarPrestacao(contrato: string; Parcelas: TtecParcelaFormaPagto; Transacao: Integer = 0): integer;
var
  a, nroautenticacao: integer;
begin
  result := mrOK;
  ReFazConsulta(qryParcelasPrestacao, [0], [contrato]);
  for a := 0 to High(Parcelas) do
    if qryParcelasPrestacao.Locate('numero', Parcelas[a].numero, []) then begin
      LimparParametrosAutenticacao;
      nroautenticacao := ProximoNumeroAutenticacao;
      qryAutenticar.ParamByName('caixa').Value          := CodigoUsuario;
      qryAutenticar.ParamByName('contratoparcela').Value:= contrato;
      qryAutenticar.ParamByName('filial').Value         := FilialBase;
      qryAutenticar.ParamByName('numero').Value         := nroautenticacao;
      qryAutenticar.ParamByName('parcela').Value        := qryParcelasPrestacaonumero.AsInteger;
      qryAutenticar.ParamByName('situacao').Value       := true;
      qryAutenticar.ParamByName('valor').Value          := qryParcelasPrestacaovalorpagto.AsFloat;
      if Parcelas[a].FormaPagto = 'D' then
        qryAutenticar.ParamByName('tipo').Value         := 'P'
      else
        qryAutenticar.ParamByName('tipo').Value         := 'T';
      if Transacao > 0 then
        qryAutenticar.ParamByName('transacao').Value    := Transacao;
      qryAutenticar.ExecSql;
    end;
  perpetrar([]);
  qryParcelasPrestacao.Params[0].Clear;
  qryParcelasPrestacao.Close
end;

