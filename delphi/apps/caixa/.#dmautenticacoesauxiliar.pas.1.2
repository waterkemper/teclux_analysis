function Tdtmautenticacoesauxiliar.autenticarConfirmacaoTransferencia(numero: integer;
  tipotransferencia: TtecAutenticacaoTransferencia): integer;
var nroautenticacao: integer;
begin
  result := mrNone;
  case tipotransferencia of
    atTransferenciaNaoConfirmada: begin
      result := atualizarAutenticacaoTransferencia(numero, false, true);
      if result = mrOK then begin
        perpetrar([]);
        result := mrOK;
      end
    end;//end case naoConfirmada

    atTransferenciaRetornada,
    atTransferenciaConfirmada   : begin
      if tipotransferencia = atTransferenciaRetornada then
        result := atualizarAutenticacaoTransferencia(numero, false, false)
      else
        result := atualizarAutenticacaoTransferencia(numero, true, false);

      if result = mrOK then begin
        ReFazConsulta(qryDadosConfirmacaoTransferencia, [0], [numero]);
        LimparParametrosAutenticacao;
        nroautenticacao := ProximoNumeroAutenticacao;

        qryAutenticar.ParamByName('autenticacao').Value       := numero;         //n£mero da autentica‡Æo da transferˆncia
        qryAutenticar.ParamByName('caixa').Value              := CodigoUsuario;  //c¢digo do caixa que efetuou a autentica‡Æo
        qryAutenticar.ParamByName('filial').Value             := FilialBase;     //n£mero da filial onde foi efetuada a autentica‡Æo
        qryAutenticar.ParamByName('numero').Value             := nroautenticacao;//n£mero sequencial da autentica‡Æo
        qryAutenticar.ParamByName('situacao').Value           := true;           //define a situacao da autentica‡Æo
        qryAutenticar.ParamByName('tipo').Value               := 'E';            //define o tipo de autentica‡Æo, neste caso transferˆncia entrada
        qryAutenticar.ParamByName('transferencia').Value      := qryDadosConfirmacaoTransferenciacaixa.asInteger;//c¢digo do caixa o qual efetuou a transferˆncia
        qryAutenticar.ParamByName('valor').Value              := qryDadosConfirmacaoTransferenciavalor.asFloat;  //valor da transferˆncia autenticado
        if assigned(ECFPadrao) then
          qryAutenticar.ParamByName('ecf').Value                := ECFPadrao.Codigo;//codigo do ecf utilizado
        qryAutenticar.ExecSql;
        perpetrar([]);
        result := mrOK;
        FNumeroAutenticacao := nroautenticacao;
      end;
    end;
  end;
end;

