procedure Tdtmautenticacoesauxiliar.AtualizarProdutosTrocados(
  Referencia: String);
begin
  qryProdutosTrocados.Edit;
  qryProdutosTrocadosreferencia.AsString := Referencia;
  qryProdutosTrocados.Post;
end;

function Tdtmautenticacoesauxiliar.atualizarSaldoTroca(tipo: String;
  codigoCliente: Integer; tipoCliente: String; valor: Real): Integer;
begin
   ReFazConsulta(qryProdutosTrocados,[],[]);
   qryprodutostrocados.Insert;
   spcProdutosTrocadosProximo.Open;
   qryProdutosTrocadosnumero.AsInteger := spcProdutosTrocadosProximonumero.AsInteger;
   spcProdutosTrocadosProximo.close;
   qryProdutosTrocadostipo.AsString := tipo;
   qryProdutosTrocadosdata.AsDateTime := now();
   qryProdutosTrocadoscliente.AsInteger := codigoCliente;
   qryProdutosTrocadostipocliente.AsString := tipoCliente;
   qryProdutosTrocadosusuario.AsInteger := CodigoUsuario;
   qryProdutosTrocadosvalor.AsFloat := valor;
   qryprodutostrocados.post;
   FNumeroAutenticacao := qryProdutosTrocadosnumero.AsInteger;
   Result := mrOK;
end;

function Tdtmautenticacoesauxiliar.atualizarSituacaoCheque(Cheque, Situacao: String): integer;
begin
  qryAtualizarSituacaoCheque.Params[0].AsString := Situacao;
  qryAtualizarSituacaoCheque.Params[1].AsString := Cheque;
  qryAtualizarSituacaoCheque.ExecSql;
  Result := mrOK;
end;

