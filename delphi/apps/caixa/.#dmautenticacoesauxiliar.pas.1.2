   qryAutenticar.ParamByName('situacao').Value       := true;           //define a situacao da autentica‡Æo
   if PagtoCartao then
     qryAutenticar.ParamByName('tipo').Value         := 'T'            //define o tipo de autentica‡Æo, neste caso presta‡Æo
   else
     qryAutenticar.ParamByName('tipo').Value         := 'P';            //define o tipo de autentica‡Æo, neste caso presta‡Æo
   qryAutenticar.ParamByName('valor').Value          := vlpagto;        //valor do cheque autenticado
   if Transacao > 0 then
     qryAutenticar.ParamByName('transacao').Value    := transacao;      //define a transacao da autenticao
   qryAutenticar.ExecSql;
   perpetrar([]);
