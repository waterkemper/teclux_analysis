  qryAtualizarTEF.ExecSql;
end;

function Tdtmautenticacoesauxiliar.autenticarCancelamento(autenticacao: integer; motivo: integer; valor: real; Contrato: String): integer;
var
  nroautenticacao: integer;
{IFDEF MSWINDOWS
  NSUAnt: String;
  lstAutCanc: TList;
ENDIF}

  function CancelamentoAutenticacao(Autenticacao: Integer; valor: real): Integer;
  begin
    result := cancelarAutenticacao(autenticacao);
    if result = mrOK then begin
      LimparParametrosAutenticacao;
      nroautenticacao := ProximoNumeroAutenticacao;
      if qryAutenticacoestipo.AsString = 'A' then
        AtualizarProdutosTrocados(IntToStr(nroAutenticacao));

      if qryAutenticacoestipo.AsString = 'S' then
