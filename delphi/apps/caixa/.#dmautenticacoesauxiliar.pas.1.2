function Tdtmautenticacoesauxiliar.inserirParcelaContratoParcial(contrato, dtvencto: string;
  vlvencto: real; parcelaorigem: String; Quitar: Boolean; parcelaoriginal: integer;
  var NroParcela: Integer): integer;
begin
  result := mrOK;
  qryInserirParcelaParcial.ParamByName('contrato').Value      := contrato;
  qryInserirParcelaParcial.ParamByName('numero').Value        := proximoNumeroParcela(contrato);
  qryInserirParcelaParcial.ParamByName('datavencto').Value    := dtvencto;
  qryInserirParcelaParcial.ParamByName('valorvencto').Value   := vlvencto;
  if Quitar then begin
    qryInserirParcelaParcial.ParamByName('datapagto').Value   := DataServidor;
    qryInserirParcelaParcial.ParamByName('valorpagto').Value  := vlvencto;
  end;
  qryInserirParcelaParcial.ParamByName('parcelaorigem').Value := parcelaorigem;
  qryInserirParcelaParcial.ParamByName('parcelaoriginal').Value:= parcelaoriginal;
  qryInserirParcelaParcial.ExecSql;
  NroParcela := qryInserirParcelaParcial.ParamByName('numero').Value;
end;

