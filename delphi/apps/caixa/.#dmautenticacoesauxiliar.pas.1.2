   qryAutenticar.ExecSql;
   perpetrar([]);
   FNumeroAutenticacao := nroautenticacao;
end;

function Tdtmautenticacoesauxiliar.cadastrarCheque(cheque, titular, cliente, TipoCliente,
  vencto: string; valor: real; Atualizar: Boolean; obs: String): integer;
var i: integer;
begin
   result := mrOK;
   if Atualizar then begin
    if qryAtualizarCheque.Active then
      qryAtualizarCheque.Close;
    for i := 0 to qryAtualizarCheque.ParamCount - 1 do
      qryAtualizarCheque.Params[i].clear;
    qryAtualizarCheque.ParamByName('numero').Value    := cheque;           //n£mero do cheque
    qryAtualizarCheque.ParamByName('data').Value      := DataLocal;        //data do cadastro do cheque
    qryAtualizarCheque.ParamByName('vencto').Value    := vencto;           //data de vencimento do cheque
    qryAtualizarCheque.ParamByName('valor').Value     := valor;            //valor do cheque
    if (cliente <> '') then begin
      qryAtualizarCheque.ParamByName('cliente').Value := strToInt(cliente);//caso exista valor, define o c¢digo do cliente
      qryAtualizarCheque.ParamByName('tipocliente').Value := TipoCliente;
    end;
    qryAtualizarCheque.ParamByName('titular').Value   := titular;          //nome completo do titular do cheque
    qryAtualizarCheque.ParamByName('situacao').Value  := 'N';              //Situação normal do cheque quando cadastrado
    qryAtualizarCheque.ParamByName('filial').Value    := FilialBase;       //filial onde foi cadastrado o cheque
    qryAtualizarCheque.ParamByName('observacao').Value:= obs;
    qryAtualizarCheque.ExecSql;
    qryAtualizarCheque.Close;
   end else begin
    if qryCadastroCheque.Active then
      qryCadastroCheque.Close;
    for i := 0 to qryCadastroCheque.ParamCount - 1 do
      qryCadastroCheque.Params[i].clear;
    qryCadastroCheque.ParamByName('numero').Value    := cheque;           //n£mero do cheque
    qryCadastroCheque.ParamByName('data').Value      := DataLocal;        //data do cadastro do cheque
    qryCadastroCheque.ParamByName('vencto').Value    := vencto;           //data de vencimento do cheque
    qryCadastroCheque.ParamByName('valor').Value     := valor;            //valor do cheque
    if (cliente <> '') then begin
      qryCadastroCheque.ParamByName('cliente').Value := strToInt(cliente);//caso exista valor, define o c¢digo do cliente
      qryCadastroCheque.ParamByName('tipocliente').Value := TipoCliente;
    end;
    qryCadastroCheque.ParamByName('titular').Value   := titular;          //nome completo do titular do cheque
    qryCadastroCheque.ParamByName('situacao').Value  := 'N';              //Situação normal do cheque quando cadastrado
    qryCadastroCheque.ParamByName('filial').Value    := FilialBase;       //filial onde foi cadastrado o cheque
    qryCadastroCheque.ParamByName('observacao').Value:= obs;
    qryCadastroCheque.ExecSql;
    qryCadastroCheque.Close;
   end;
end;

