function Tdtmautenticacoesauxiliar.quitarParcelasDevolucao(contrato: string): integer;
var
  tpPagto       : string;
begin
  result := mrOK;
  refazConsulta(qryParcelasDevolucao,[0],[contrato]);
  qryParcelasDevolucao.first;
  while Not qryParcelasDevolucao.Eof do begin
    if qryParcelasDevolucaotipopagto.asString = 'D' then
      tpPagto := 'C'
    else
      tpPagto := 'X';
    atualizarParcelaDevolucao(qryParcelasDevolucaocontrato.asString,
                              qryParcelasDevolucaonumero.asInteger,
                              dateToStr(DataLocal),
                              FilialBase,
                              tpPagto);
    qryParcelasDevolucao.next;
  end;
end;

