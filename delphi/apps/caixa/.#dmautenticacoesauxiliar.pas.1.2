var nroautenticacao: integer;
begin
  result := mrOK;
   LimparParametrosAutenticacao;
   nroautenticacao := ProximoNumeroAutenticacao;
   qryAutenticar.ParamByName('caixa').Value          := CodigoUsuario;  //c¢digo do caixa que efetuou a autentica‡Æo
   qryAutenticar.ParamByName('contratoparcela').Value:= contrato;       //n£mero do contrato da parcela
