unit dmcontrolerecebimentos;

interface

uses
  SysUtils, Classes, dmbasico, DB, cpdatasource, ZQuery, ZPgSqlQuery,
  cpquery, biblio, clusuario, ctconstantes, ZTransact, variants, dmtecsoft, clparametrossistema;

type
  TdtmControleRecebimentos = class(TdtmBasico)
    qryRecebimentos: TtecQuery;
    dsrRecebimentos: TtecDataSource;
    qryRecebimentoscodigo: TIntegerField;
    qryRecebimentoscodigotiporecebimento: TIntegerField;
    qryRecebimentosvalorlancto: TFloatField;
    qryRecebimentosvalorvencto: TFloatField;
    qryRecebimentosdatalancto: TDateField;
    qryRecebimentosdatavencto: TDateField;
    qryRecebimentospdesagio: TFloatField;
    qryRecebimentostransacao: TIntegerField;
    qryRecebimentoscheque: TStringField;
    qryRecebimentossituacao: TStringField;
    qryRecebimentosconfirmado: TBooleanField;
    qryTiposRecebimentos: TtecQuery;
    qryTiposRecebimentoscodigo: TIntegerField;
    qryTiposRecebimentosdescricao: TStringField;
    qryTiposRecebimentostiporecebimento: TStringField;
    qryRecebimentostiporec: TStringField;
    qryRecebimentosfilial: TIntegerField;
    qryRecebimentoscontrole: TIntegerField;
    qryRecebimentoscheque_vencto: TDateField;
    qryRecebimentoscheque_titular: TStringField;
    qryRecebimentosnomecliente: TStringField;
    qryRecebimentoscheque_banco: TStringField;
    qryRecebimentoscheque_agencia: TStringField;
    qryRecebimentoscheque_cheque: TStringField;
    qryRecebimentoscheque_conta: TStringField;
    qrySituacaoRecebimentos: TtecQuery;
    qrySituacaoRecebimentossituacao: TStringField;
    qrySituacaoRecebimentosdescricao: TStringField;
    qryRecebimentossituac: TStringField;
    qryRecebimentosnomeredetef: TStringField;
    qryTipoRecebimento: TtecQuery;
    qryTipoRecebimentodesagio: TFloatField;
    qryRecebimentoscliente: TIntegerField;
    qryAtualizarRecebimentos: TtecQuery;
    qryRecebimentosdata_confirmacao: TDateField;
    qryRecebimentosvalor_confirmacao: TFloatField;
    qryRecebimentostef: TStringField;
    qryMovtosBancos: TtecQuery;
    qryMovtosBancosconta: TIntegerField;
    qryMovtosBancosdata: TDateField;
    qryMovtosBancossequencia: TIntegerField;
    qryMovtosBancoscompensacao: TDateField;
    qryMovtosBancosseqcompensacao: TIntegerField;
    qryMovtosBancosdataoriginal: TDateField;
    qryMovtosBancosevento: TIntegerField;
    qryMovtosBancostipo: TStringField;
    qryMovtosBancosorigemlancto: TStringField;
    qryMovtosBancosdocumento: TStringField;
    qryMovtosBancosobservacoes: TStringField;
    qryMovtosBancosvalor: TFloatField;
    qryMovtosBancosEventos: TtecQuery;
    qryMovtosBancosEventosconta: TIntegerField;
    qryMovtosBancosEventosdata: TDateField;
    qryMovtosBancosEventossequencia: TIntegerField;
    qryMovtosBancosEventosevento: TIntegerField;
    qryMovtosBancosEventostipo: TStringField;
    qryMovtosBancosEventosvalor: TFloatField;
    qryMovtosBancosEventoscontatransf: TIntegerField;
    qryMovtosBancosEventossequenciaorigem: TIntegerField;
    qryMovtosBancosEventosobservacoes: TStringField;
    qryMovtosBancosEventossequenciaevento: TIntegerField;
    qryMovtosBancosProximaSequencia: TtecQuery;
    qryMovtosBancosProximaSequencianumero: TIntegerField;
    qryMovtosBancosProximaSequenciaEvento: TtecQuery;
    qryMovtosBancosProximaSequenciaEventonumero: TIntegerField;
    qryRecebimentosconta: TIntegerField;
    qryRecebimentossequencia: TIntegerField;
    qryRecebimentosevento: TIntegerField;
    qryRecebimentossequenciaevento: TIntegerField;
    qryRecebimentosconta_old: TIntegerField;
    qryRecebimentosdata_confirmacao_old: TDateField;
    qryRecebimentossequencia_old: TIntegerField;
    qryRecebimentosevento_old: TIntegerField;
    qryRecebimentossequenciaevento_old: TIntegerField;
    dsrMovtosBancos: TtecDataSource;
    dsrMovtosBancosEventos: TtecDataSource;
    qryRecebimentosconta_ctr: TIntegerField;
    qryRecebimentosevento_ctr: TIntegerField;
    qryAutenticacoes: TtecQuery;
    qryAutenticacoescontratoparcela: TStringField;
    qryAutenticacoesparcela: TIntegerField;
    procedure dsrRecebimentosDataChange(Sender: TObject; Field: TField);
    procedure qryRecebimentosBeforeInsert(DataSet: TDataSet);
    procedure qryRecebimentosBeforeDelete(DataSet: TDataSet);
  private
    FOnRecebimentosChange: TNotifyEvent;
    FQtdeMarcados: Integer;
    FTotalMarcados: Real;
    function getQtdeRecebimentos: Integer;
    function getTotalRecebimentos: Real;
    procedure MarcarSelecionados(Marcando, Todos: Boolean; Contando: Boolean = false);
    function GetQtdeMarcados: Integer;
    function GetTotalMarcados: Real;
    { Private declarations }
  public
    function ConsultarRecebimentos(DataInicialEmissao, DataFinalEmissao,
                                   DataInicialVencto, DataFinalVencto,
                                   Filial, TipoRecebimento, TipoCliente, Cliente: String;
                                   Confirmados: Integer;
                                   Dinheiro, Cheque, Debito, Credito: Boolean): Boolean;
    function GravarRecebimentos: Boolean;
    procedure ConfirmarRecebimento(Marcando, Todos: Boolean);
    property QtdeRecebimentos : Integer read getQtdeRecebimentos;
    property TotalRecebimentos: Real read getTotalRecebimentos;
    property QtdeMarcados: Integer read GetQtdeMarcados write FQtdeMarcados;
    property TotalMarcados : Real read GetTotalMarcados write FTotalMarcados;
    property OnRecebimentosChange: TNotifyEvent read FOnRecebimentosChange write FOnRecebimentosChange;
    { Public declarations }
  end;

var
  dtmControleRecebimentos: TdtmControleRecebimentos;

implementation

{$R *.dfm}

{ TdtmControleRecebimentos }

function TdtmControleRecebimentos.ConsultarRecebimentos(DataInicialEmissao,
 DataFinalEmissao, DataInicialVencto, DataFinalVencto, Filial, TipoRecebimento, TipoCliente, Cliente: String;
  Confirmados: Integer;  Dinheiro, Cheque, Debito, Credito: Boolean
  ): Boolean;
var
  vFormadeRecebimento: String;
begin


  QtdeMarcados := 0;
  TotalMarcados := 0;

  if not DataEmBranco(DataInicialEmissao) then
  begin
    if DataEmBranco(DataFinalEmissao) then
     qryRecebimentos.macrobyname('SQLRecebimentosDataLancto').asstring :=
       ' and r.datalacnto >= ' + quotedstr(FormatDateTime('yyyy-mm-dd',StrToDateTime(DataInicialEmissao)))
    else
     qryRecebimentos.macrobyname('SQLRecebimentosDataLancto').asstring :=
       ' and r.datalancto between ' + quotedstr(FormatDateTime('yyyy-mm-dd',StrToDateTime(DataInicialEmissao))) +
       ' and '+quotedstr(FormatDateTime('yyyy-mm-dd',StrToDateTime(DataFinalEmissao)));
  end
  else begin
    if not DataEmBranco(DataFinalEmissao) then
      qryRecebimentos.macrobyname('SQLRecebimentosDataLancto').asstring :=
        ' and r.datalancto <= ' + quotedstr(FormatDateTime('yyyy-mm-dd',StrToDateTime(DataFinalEmissao)))
    else
      qryRecebimentos.MacroByName('SQLRecebimentosDataLancto').AsString:= '';
  end;


  if not DataEmBranco(DataInicialVencto) then begin
    if DataEmBranco(DataFinalVencto) then
     qryRecebimentos.macrobyname('SQLRecebimentosDataVencto').asstring :=
       ' and r.datavencto >= ' + quotedstr(FormatDateTime('yyyy-mm-dd',StrToDateTime(DataInicialVencto)))
    else
     qryRecebimentos.macrobyname('SQLRecebimentosDataVencto').asstring :=
       ' and r.datavencto between ' + quotedstr(FormatDateTime('yyyy-mm-dd',StrToDateTime(DataInicialVencto))) +
       ' and '+quotedstr(FormatDateTime('yyyy-mm-dd',StrToDateTime(DataFinalVencto)));
  end
  else
  begin
    if not DataEmBranco(DataFinalVencto) then
      qryRecebimentos.macrobyname('SQLRecebimentosDataVencto').asstring :=
        ' and r.datavencto <= ' + quotedstr(FormatDateTime('yyyy-mm-dd',StrToDateTime(DataFinalVencto)))
    else
      qryRecebimentos.MacroByName('SQLRecebimentosDataVencto').AsString:= '';
  end;



  if (Filial <> '') then
    qryRecebimentos.MacroByName('Filial_Recebimento').AsString:= 'and r.filial in (' + filial + ')'
  else
    qryRecebimentos.MacroByName('Filial_Recebimento').AsString:= '';

  if (TipoRecebimento <> '') then
    qryRecebimentos.MacroByName('TipoRecebimento_Recebimentos').AsString:= 'and r.tiporecebimento in (' + TipoRecebimento + ')'
  else
    qryRecebimentos.MacroByName('TipoRecebimento_Recebimentos').AsString:= '';

  if (Cliente <> '') then
    qryRecebimentos.MacroByName('Cliente_Contrato').AsString:= 'and ((ct.cliente = ' + Cliente + ')'+
                                                       'and (ct.tipocliente = ' + quotedstr(TipoCliente) + '))'
  else
    qryRecebimentos.MacroByName('Cliente_Contrato').AsString:= '';

  case Confirmados of
    0: qryRecebimentos.MacroByName('CONFIRMADO').AsString := 'and not r.confirmado';
    1: qryRecebimentos.MacroByName('CONFIRMADO').AsString := 'and r.confirmado';
    2: qryRecebimentos.MacroByName('CONFIRMADO').AsString := '';
  end;

  vFormadeRecebimento := '';
  if Dinheiro then
    vFormadeRecebimento := vFormadeRecebimento + 'D';

  if Cheque then
    vFormadeRecebimento := vFormadeRecebimento + 'H';

  if Debito then
    vFormadeRecebimento := vFormadeRecebimento + 'B';

  if Credito then
    vFormadeRecebimento := vFormadeRecebimento + 'C';

  if (vFormadeRecebimento = '') or (vFormadeRecebimento = 'DHBC') then
    qryRecebimentos.MacroByName('FormadeRecebimentos').AsString := ''
  else
    qryRecebimentos.MacroByName('FormadeRecebimentos').AsString := 'and position(tr.tiporecebimento in '+quotedstr(vFormadeRecebimento)+')<>0';

  qryRecebimentos.close;
  qryRecebimentos.Open;


  case Confirmados of
    1, 2: MarcarSelecionados(false,true,true);
  end;



  Result := not qryRecebimentos.IsEmpty;


end;

function TdtmControleRecebimentos.GravarRecebimentos: Boolean;
var
  vListadeRecebimentos : String;
  vListaMovtosBancos : String;
  Usuario: TtecUsuarios;
  vNow: TDateTime;
  vSequencia, vSequenciaEvento : integer;


  function ObterAutorizacaoPagamento: Boolean;
  begin
    result := false;
    if assigned(usuario) then
      Usuario.Free;

    Usuario:= TtecUsuarios.Create(dtmTecSoft.Database);
    //  try
      if UsuarioLogin.AnalistaCredito then
           Usuario:= ObterAutorizacao(taSENHA)
      else Usuario:= ObterAutorizacao(taLOGIN, ctANALISTACREDITO, ctAUTORIZADO);

      if Assigned(Usuario) and Usuario.analistacredito then
        result := true
      else
        MensagemAviso(format(ctUSUARIONAOAUTORIZADO,['autorizar o recebimento da transação.']));

  end;

  function LocalizarMovimentos(conta :Integer;
                               data_confirmacao : TDateTime;
                               sequencia : integer;
                               evento : Integer;
                               sequenciaevento : Integer; LocalizarMovtosBancosEventos: boolean = true): boolean;
  begin
    result := true;
    qryMovtosBancos.first;
    qryMovtosBancosEventos.first;

    if qryMovtosBancos.Locate('conta,data,sequencia',
                                   VarArrayOf([conta, data_confirmacao, sequencia]),[]) then
    begin
      if LocalizarMovtosBancosEventos then
      begin
        qryMovtosBancosEventos.first;
        if not qryMovtosBancosEventos.Locate('conta,data,sequencia,evento,sequenciaevento',
                                         VarArrayOf([conta, data_confirmacao,
                                                     sequencia, evento, sequenciaevento]), []) then
        begin
          result := false;
          MensagemErro(format('Movimento de eventos e banco não encontrado. Conta: %d Data: %s Sequência: %d Evento: %d sequencia Evento: %d',
                             [conta, datetostr(data_confirmacao), sequencia, evento, sequenciaevento]));
        end;
      end;
    end
    else
    begin
      result := false;
      MensagemErro(format('Movimento de banco não encontrado. Conta: %s Data: %s Sequência: %s',
                         [qryRecebimentosconta.AsString,
                          qryRecebimentosdata_confirmacao.AsString,
                          qryRecebimentossequencia.asString]));
    end;
  end;

  function ApagarMovtosBancosEventosAnterior: boolean;
  begin
    result := true;

    if (not qryRecebimentosconta_old.isnull) and
       (not qryRecebimentosdata_confirmacao_old.isnull) and
       (not qryRecebimentossequencia_old.isnull) and
       (not qryRecebimentosevento_old.isnull) and
       (not qryRecebimentossequenciaevento_old.isnull) then
    begin
      result := LocalizarMovimentos(qryRecebimentosconta_old.AsInteger,
                             qryRecebimentosdata_confirmacao_old.AsDateTime,
                             qryRecebimentossequencia_old.asinteger,
                             qryRecebimentosevento_old.AsInteger,
                             qryRecebimentossequenciaevento_old.AsInteger);
      if result then
      begin
        qryMovtosBancos.Edit;
        qryMovtosBancosvalor.AsCurrency := qryMovtosBancosvalor.AsCurrency - qryMovtosBancosEventosvalor.AsCurrency;
        qryMovtosBancos.post;

        qryMovtosBancosEventos.delete;


        if qryMovtosBancosvalor.AsCurrency = 0 then
          qryMovtosBancos.delete
        else
        begin
          qryMovtosBancosEventos.MasterSource := dsrMovtosBancos;
          qryMovtosBancosEventos.first;

          if qryMovtosBancosEventos.recordcount = 1 then
          begin
            qryMovtosBancos.Edit;
            qryMovtosBancosevento.AsInteger := qryMovtosBancosEventosevento.AsInteger;
            qryMovtosBancos.post;
          end
          else
          if (qryMovtosBancosEventos.recordcount > 1) and
             (not qryMovtosBancosevento.isnull) then
          begin
            qryMovtosBancos.Edit;
            qryMovtosBancosevento.clear;
            qryMovtosBancos.post;
            qryMovtosBancos.first;
          end;
          qryMovtosBancosEventos.MasterSource := nil;

        end;

        qryAtualizarRecebimentos.FieldByName('conta').clear;
        qryAtualizarRecebimentos.FieldByName('sequencia').clear;
        qryAtualizarRecebimentos.FieldByName('evento').clear;
        qryAtualizarRecebimentos.FieldByName('sequenciaevento').clear;


      end;
    end;
  end;

  function DescricaoContratoParcela: String;
  var
    vListaContratoseParcelas : String;
  begin
    RefazConsultaPorNome(qryAutenticacoes, ['transacao'],[qryRecebimentostransacao.asinteger]);
    vListaContratoseParcelas := '';
    qryAutenticacoes.First;
    while not qryAutenticacoes.Eof do
    begin
      vListaContratoseParcelas := vListaContratoseParcelas + '['+ qryAutenticacoescontratoparcela.AsString + ', '+ qryAutenticacoesparcela.AsString +'], ';
      qryAutenticacoes.next;
    end;
    if vListaContratoseParcelas <> '' then
    begin
      delete(vListaContratoseParcelas,length(vListaContratoseParcelas)-1, 2);
      result := 'Contratos/Parcelas: ' + vListaContratoseParcelas;
    end;
  end;

begin
  result := false;

  if ObterAutorizacaoPagamento then
  begin
    try
      try

        vNow := now;
        vListadeRecebimentos := '';
        vListaMovtosBancos := '';
        GuardarRegistroAtual(qryrecebimentos,true);

        qryrecebimentos.First;
        while not qryRecebimentos.Eof  do
        begin
    //    if qryRecebimentosconfirmado.AsBoolean then   {Verificar}
          vListadeRecebimentos := vListadeRecebimentos + qryRecebimentoscodigo.AsString+',';

          if IntegracaocomBancos then
          begin

            if not qryRecebimentosconta_ctr.IsNull and
               not qryRecebimentosdata_confirmacao.IsNull then
            begin
              if pos('(' + qryRecebimentosconta_ctr.asstring + ', ' +
                                       quotedstr(FormatDateTime('yyyy-mm-dd',qryRecebimentosdata_confirmacao.AsDateTime)) + '),', vListaMovtosBancos) = 0 then

                vListaMovtosBancos := vListaMovtosBancos +
                                      '(' + qryRecebimentosconta_ctr.asstring + ', ' +
                                           quotedstr(FormatDateTime('yyyy-mm-dd',qryRecebimentosdata_confirmacao.AsDateTime)) + '),';
            end;

            if not qryRecebimentosconta_old.IsNull and
               not qryRecebimentosdata_confirmacao_old.IsNull then
            begin
              if pos('(' + qryRecebimentosconta_old.asstring + ', ' +
                                         quotedstr(FormatDateTime('yyyy-mm-dd',qryRecebimentosdata_confirmacao_old.asdatetime)) + '),', vListaMovtosBancos) = 0 then
                vListaMovtosBancos := vListaMovtosBancos +
                                      '(' + qryRecebimentosconta_old.asstring + ', ' +
                                           quotedstr(FormatDateTime('yyyy-mm-dd',qryRecebimentosdata_confirmacao_old.asdatetime)) + '),';

            end;
          end;

          qryRecebimentos.Next;
        end;

        if vListadeRecebimentos='' then
          vListadeRecebimentos := 'null,';

        delete(vListadeRecebimentos,length(vListadeRecebimentos),1);
        qryAtualizarRecebimentos.MacroByName('ListadeRecebimentos').asstring := 'and r.codigo in ('+vListadeRecebimentos+')';
        qryAtualizarRecebimentos.Close;
        qryAtualizarRecebimentos.Open;


        if vListaMovtosBancos='' then
          vListaMovtosBancos := '(null,null),';

        delete(vListaMovtosBancos,length(vListaMovtosBancos),1);
        qryMovtosBancos.MacroByName('ListaMovtosBancos').asstring := vListaMovtosBancos;
        qryMovtosBancos.Close;
        qryMovtosBancos.Open;

        qryMovtosBancosEventos.MacroByName('ListaMovtosBancos').asstring := vListaMovtosBancos;
        qryMovtosBancosEventos.Close;
        qryMovtosBancosEventos.Open;

        qryAtualizarRecebimentos.First;
        while not qryAtualizarRecebimentos.Eof do
        begin
          if qryrecebimentos.Locate('codigo',qryAtualizarRecebimentos.fieldbyname('codigo').AsInteger,[]) then
          begin
            qryAtualizarRecebimentos.Edit;
            qryatualizarRecebimentos.fieldbyname('tiporecebimento').asinteger := qryRecebimentoscodigotiporecebimento.AsInteger;
            qryAtualizarRecebimentos.FieldByName('desagio').AsCurrency       := qryRecebimentospdesagio.AsCurrency;

            if qryRecebimentosconfirmado.AsBoolean then
            begin
              qryAtualizarRecebimentos.FieldByName('valor_confirmacao').AsCurrency := qryRecebimentosvalor_confirmacao.ascurrency;
              qryAtualizarRecebimentos.fieldbyname('data_confirmacao').asdatetime := qryRecebimentosdata_confirmacao.AsDateTime;
              qryatualizarRecebimentos.fieldbyname('confirmado').AsBoolean := true;

              if IntegracaocomBancos then
              begin
                {se são iguais e não esta nulo: trata-se de uma alteração de algo já lançado}
                if (qryRecebimentosconta.AsInteger = qryRecebimentosconta_old.AsInteger)  and
                   (qryRecebimentosconta.AsInteger = qryRecebimentosconta_ctr.AsInteger) and
                   (qryRecebimentosdata_confirmacao.AsDateTime =  qryRecebimentosdata_confirmacao_old.AsDateTime) and
                   (qryRecebimentossequencia.asinteger = qryRecebimentossequencia_old.AsInteger) and
                   (qryRecebimentosevento.AsInteger = qryRecebimentosevento_old.AsInteger) and
                   (qryRecebimentosevento.AsInteger = qryRecebimentosevento_ctr.AsInteger) and
                   (qryRecebimentossequenciaevento.AsInteger = qryRecebimentossequenciaevento_old.AsInteger) and

                   (not qryRecebimentosconta.isnull) and
                   (not qryRecebimentosdata_confirmacao.isnull) and
                   (not qryRecebimentossequencia.isnull) and
                   (not qryRecebimentosevento.isnull) and
                   (not qryRecebimentossequenciaevento.isnull) then


                begin
                  result :=  LocalizarMovimentos(qryRecebimentosconta.AsInteger,
                                         qryRecebimentosdata_confirmacao.AsDateTime,
                                         qryRecebimentossequencia.asinteger,
                                         qryRecebimentosevento.AsInteger,
                                         qryRecebimentossequenciaevento.AsInteger);
                  if result then
                  begin
                    if qryMovtosBancosEventosvalor.AsCurrency <> qryRecebimentosvalor_confirmacao.AsCurrency then
                    begin
                      qryMovtosBancos.Edit;
                      qryMovtosBancosvalor.AsCurrency := qryMovtosBancosvalor.AsCurrency - qryMovtosBancosEventosvalor.AsCurrency + qryRecebimentosvalor_confirmacao.AsCurrency;
                      qryMovtosBancos.post;

                      qryMovtosBancosEventos.edit;
                      qryMovtosBancosEventosvalor.AsCurrency := qryRecebimentosvalor_confirmacao.AsCurrency;
                      qryMovtosBancosEventos.post;
                    end;
                  end;
                end
                else
                begin
                  {Se os dados anteriores não estão nulos e não entrou na situação anterior deve-se apagar e incluir novamente}
                  {Sempre que é gravado no banco os dados são selecionados novamente, atualizando os valores '_old')}

                  result := ApagarMovtosBancosEventosAnterior;

                  if result then
                  begin
                    qryMovtosBancos.first;

                    if qryMovtosBancos.Locate('conta,data', VarArrayOf([qryRecebimentosconta_ctr.AsInteger,
                                                                        qryRecebimentosdata_confirmacao.AsDateTime]),[]) then
                    begin
                      qryMovtosBancos.Edit;
                      qryMovtosBancosvalor.AsCurrency := qryMovtosBancosvalor.AsCurrency + qryRecebimentosvalor_confirmacao.AsCurrency;
                      qryMovtosBancos.post;

                      qryMovtosBancosEventos.MasterSource := dsrMovtosBancos;
                      qryMovtosBancosEventos.first;

                      qryMovtosBancosEventos.SortDescByField('evento,sequenciaevento');
                      if qryMovtosBancosEventos.Locate('evento', qryRecebimentosevento_ctr.AsInteger, [] ) then
                        vSequenciaEvento :=  qryMovtosBancosEventossequenciaevento.AsInteger + 1
                      else
                        vSequenciaEvento := 1;
                      qryMovtosBancosEventos.MasterSource := nil;

                    end
                    else
                    begin
                      qryMovtosBancosProximaSequencia.Close;
                      qryMovtosBancosProximaSequencia.ParamByName('ContaPagto').AsInteger := qryRecebimentosconta_ctr.AsInteger;
                      qryMovtosBancosProximaSequencia.ParamByName('DataPagto').AsDatetime := qryRecebimentosdata_confirmacao.AsDateTime;
                      qryMovtosBancosProximaSequencia.Open;

                      vSequencia := qryMovtosBancosProximaSequencianumero.AsInteger + 1;

                      qryMovtosBancos.Append;
                      qryMovtosBancosconta.AsInteger := qryRecebimentosconta_ctr.AsInteger;
                      qryMovtosBancosdata.AsDateTime := qryRecebimentosdata_confirmacao.AsDateTime;
                      qryMovtosBancoscompensacao.AsDateTime := qryRecebimentosdata_confirmacao.AsDateTime;
                      qryMovtosBancossequencia.AsInteger := vSequencia;
                      qryMovtosBancosvalor.AsCurrency := qryRecebimentosvalor_confirmacao.AsCurrency;
                      qryMovtosBancosorigemlancto.AsString := 'X';
                      qryMovtosBancostipo.AsString := 'E';
                      qryMovtosBancosevento.AsInteger := qryRecebimentosevento_ctr.AsInteger;

                      qryMovtosBancos.post;

                      vSequenciaEvento := 1;

                    end;

                    qryMovtosBancosEventos.Append;
                    qryMovtosBancosEventosconta.AsInteger := qryMovtosBancosconta.AsInteger;
                    qryMovtosBancosEventosdata.AsDateTime := qryMovtosBancosdata.AsDateTime;
                    qryMovtosBancosEventossequencia.AsInteger := qryMovtosBancossequencia.AsInteger;
                    qryMovtosBancosEventosevento.AsInteger := qryRecebimentosevento_ctr.AsInteger;
                    qryMovtosBancosEventossequenciaevento.AsInteger := vSequenciaEvento;
                    qryMovtosBancosEventosvalor.AsCurrency := qryRecebimentosvalor_confirmacao.AsCurrency;
                    qryMovtosBancosEventosobservacoes.AsString := DescricaoContratoParcela;
                    qryMovtosBancosEventos.post;

                    qryAtualizarRecebimentos.FieldByName('conta').AsInteger :=  qryMovtosBancosconta.AsInteger;
                    qryAtualizarRecebimentos.FieldByName('sequencia').AsInteger := qryMovtosBancossequencia.AsInteger;
                    qryAtualizarRecebimentos.FieldByName('evento').AsInteger := qryRecebimentosevento_ctr.AsInteger;
                    qryAtualizarRecebimentos.FieldByName('sequenciaevento').AsInteger := vSequenciaEvento;


                    qryMovtosBancosEventos.MasterSource := dsrMovtosBancos;
                    qryMovtosBancosEventos.first;

                    if (qryMovtosBancosEventos.RecordCount = 1) and
                       (qryMovtosBancosevento.IsNull) then
                    begin
                      qryMovtosBancos.Edit;
                      qryMovtosBancosevento.AsInteger := qryMovtosBancosEventosevento.AsInteger;
                      qryMovtosBancos.post;
                    end
                    else
                    if (qryMovtosBancosEventos.RecordCount > 1) and
                       (not qryMovtosBancosevento.IsNull) then
                    begin
                      qryMovtosBancos.Edit;
                      qryMovtosBancosevento.clear;
                      qryMovtosBancos.post;
                    end;

                    qryMovtosBancosEventos.MasterSource := nil;

                  end;
                end;
              end;
            end
            else
            begin
              result := true;
              if IntegracaocomBancos then
                result := ApagarMovtosBancosEventosAnterior;

              if result then
              begin
                qryAtualizarRecebimentos.FieldByName('valor_confirmacao').clear;
                qryAtualizarRecebimentos.fieldbyname('data_confirmacao').clear;
                qryatualizarRecebimentos.fieldbyname('confirmado').AsBoolean := false;  {Verificar}
              end;
            end;

            if result then
            begin
              qryAtualizarRecebimentos.fieldbyname('data_operacao').asdatetime := vnow;
              qryAtualizarRecebimentos.fieldbyname('usuario_confirmacao').AsInteger := Usuario.CodigoUsuario;
            end;

            qryAtualizarRecebimentos.post;
          end;
          qryAtualizarRecebimentos.next;
        end;

        if result then
          Result := Perpetrar([qryMovtosBancos, qryMovtosBancosEventos, qryAtualizarRecebimentos]);
     finally
       VoltarRegistroAtual(qryrecebimentos);
     end;
    except
      result := false;
    end;
  end;

end;

procedure TdtmControleRecebimentos.dsrRecebimentosDataChange(
  Sender: TObject; Field: TField);
begin
  inherited;
  if Field = qryRecebimentosvalor_confirmacao then
  begin
    dsrRecebimentos.OnDataChange := nil;
    if qryRecebimentosconfirmado.AsBoolean then
    begin
      if qryRecebimentosvalor_confirmacao.NewValue <> null then
      begin
        if (FTotalMarcados + qryRecebimentosvalor_confirmacao.AsCurrency) > qryRecebimentosvalor_confirmacao.NewValue then
          FTotalMarcados:= ((FTotalMarcados - qryRecebimentosvalor_confirmacao.NewValue) +
                            qryRecebimentosvalor_confirmacao.AsCurrency)
        else
          FTotalMarcados:= 0;

      end;
    end;
    OnRecebimentosChange(Sender);
    dsrRecebimentos.OnDataChange := dsrRecebimentosDataChange;
  end
  else
  if field = qryRecebimentoscodigotiporecebimento then
  begin
    ReFazConsulta(qryTipoRecebimento,[0],[qryRecebimentoscodigotiporecebimento.AsInteger]);
    qryRecebimentospdesagio.AsCurrency := qryTipoRecebimentodesagio.AsCurrency;
  end
  else
  if field = qryRecebimentospdesagio then
  begin
    if qryRecebimentosconfirmado.asboolean then
      qryRecebimentosvalor_confirmacao.AsCurrency := qryRecebimentosvalorlancto.AsCurrency - (qryRecebimentosvalorlancto.AsCurrency * qryRecebimentospdesagio.AsCurrency / 100);
  end
  else
  if field = qryRecebimentosconfirmado then
  begin
    if qryRecebimentosconfirmado.AsBoolean then
    begin
//      dsrRecebimentos.OnDataChange := nil;

      if IntegracaocomBancos then
      begin
        if qryRecebimentosconta_ctr.isnull or qryRecebimentosevento_ctr.isnull then
        begin
          MensagemAviso('O tipo de recebimento não possui a conta e evento associado a esta filial de recebimento.');
          qryRecebimentosconfirmado.AsBoolean := false;
        end
      end;

      {
      qryRecebimentosdata_confirmacao.AsDateTime := qryRecebimentosdatavencto.AsDateTime;
      qryRecebimentosvalor_confirmacao.AsCurrency := qryRecebimentosvalorvencto.AsCurrency ;
      dsrRecebimentosDataChange(nil, qryRecebimentosvalor_confirmacao);
      }
//      dsrRecebimentos.OnDataChange := dsrRecebimentosDataChange;

      (*
    end
    else
    begin
//      FTotalMarcados:= FTotalMarcados - qryRecebimentosvalor_confirmacao.AsCurrency;
      dsrRecebimentos.OnDataChange := nil;
      qryRecebimentosdata_confirmacao.clear;
      qryRecebimentosvalor_confirmacao.clear;
      dsrRecebimentosDataChange(nil, qryRecebimentosvalor_confirmacao);
      dsrRecebimentos.OnDataChange := dsrRecebimentosDataChange;
      *)
    end;
  end
  else
  if field = qryRecebimentosdata_confirmacao then
  begin
    if (qryRecebimentosdata_confirmacao.asdatetime <> 0) and
       (qryRecebimentosdata_confirmacao.asdatetime < qryRecebimentosdatalancto.AsDateTime) then
    begin
      MensagemAviso('A data de confirmação esta inferior à data de lançamento');
      dsrRecebimentos.OnDataChange := nil;
      if qryRecebimentosdata_confirmacao.OldValue <> null then
        qryRecebimentosdata_confirmacao.AsDateTime := qryRecebimentosdata_confirmacao.OldValue
      else
        qryRecebimentosdata_confirmacao.clear;
      dsrRecebimentos.OnDataChange := dsrRecebimentosDataChange;
    end;
  end;
end;

procedure TdtmControleRecebimentos.ConfirmarRecebimento(Marcando, Todos: Boolean);
begin
{  qryRecebimentos.Edit;
  qryRecebimentosconfirmado.AsBoolean := not qryRecebimentosconfirmado.AsBoolean;
}
  MarcarSelecionados(Marcando,Todos);
end;

procedure TdtmControleRecebimentos.qryRecebimentosBeforeInsert(
  DataSet: TDataSet);
begin
  inherited;
  Abort;
end;

procedure TdtmControleRecebimentos.qryRecebimentosBeforeDelete(
  DataSet: TDataSet);
begin
  inherited;
  Abort;
end;

function TdtmControleRecebimentos.getQtdeRecebimentos: Integer;
begin
  Result := qryRecebimentos.RecordCount;
end;

function TdtmControleRecebimentos.getTotalRecebimentos: Real;
var
  pos : TBookmark;
begin
  pos := qryRecebimentos.GetBookmark;
  try
    Result := TotalizarValores[qryRecebimentos,qryRecebimentosvalorvencto, nil];
  finally
    qryRecebimentos.GotoBookmark(pos);
    qryRecebimentos.FreeBookmark(pos);
  end;
end;

procedure TdtmControleRecebimentos.MarcarSelecionados(Marcando,
  Todos: Boolean; Contando: Boolean = false);
var
  Pos     : TBookmark;
  I       : Integer;
  Count   : Integer;

  procedure AtualizarValores;
  begin
    if qryRecebimentosconfirmado.AsBoolean then
    begin
      FQtdeMarcados  := FQtdeMarcados + 1;
      FTotalMarcados := FTotalMarcados + qryRecebimentosvalor_confirmacao.AsCurrency;
    end
    else begin
      FQtdeMarcados  := FQtdeMarcados - 1;
      FTotalMarcados := FTotalMarcados - qryRecebimentosvalor_confirmacao.AsCurrency;
    end;
  end;

begin

  dsrRecebimentos.OnDataChange := nil;

  if not qryrecebimentos.IsEmpty then
  begin
    if not Todos then
    begin
      qryRecebimentos.Edit;
      qryRecebimentosconfirmado.AsBoolean := not qryRecebimentosconfirmado.AsBoolean;

      if qryRecebimentosconfirmado.AsBoolean then
      begin
        dsrRecebimentosDataChange(qryRecebimentos, qryRecebimentosconfirmado);
        if qryRecebimentosconfirmado.AsBoolean then
        begin
          qryRecebimentosdata_confirmacao.AsDateTime := qryRecebimentosdatavencto.AsDateTime;
          qryRecebimentosvalor_confirmacao.AsCurrency := qryRecebimentosvalorvencto.AsCurrency ;
          AtualizarValores;
        end;
      end
      else
      begin
        AtualizarValores;
        qryRecebimentosdata_confirmacao.clear;
        qryRecebimentosvalor_confirmacao.clear;
      end;

      if qryRecebimentos.state in [dsedit, dsinsert] then
        qryRecebimentos.Post;

    end
    else
    begin
      Pos:= qryRecebimentos.GetBookmark;
      try
//        qryRecebimentos.DisableControls;
        qryRecebimentos.First;
        Count := qryRecebimentos.RecordCount;
        for I:= 1 to Count do
        begin
          qryRecebimentos.Edit;
          if Marcando then
          begin
            if not qryRecebimentosconfirmado.AsBoolean then
            begin
              qryRecebimentosconfirmado.AsBoolean := True;
              dsrRecebimentosDataChange(qryRecebimentos, qryRecebimentosconfirmado);
              if qryRecebimentosconfirmado.AsBoolean then
              begin
                qryRecebimentosdata_confirmacao.AsDateTime := qryRecebimentosdatavencto.AsDateTime;
                qryRecebimentosvalor_confirmacao.AsCurrency := qryRecebimentosvalorvencto.AsCurrency ;
                AtualizarValores;
              end
              else
                break;
            end
          end
          else
          begin
            if contando and qryRecebimentosconfirmado.AsBoolean then
              AtualizarValores
            else
            if qryRecebimentosconfirmado.AsBoolean then
            begin
              qryRecebimentosconfirmado.AsBoolean:= False;
              AtualizarValores;
              qryRecebimentosdata_confirmacao.clear;
              qryRecebimentosvalor_confirmacao.clear;
            end;

          end;
          if qryRecebimentos.state in [dsedit, dsinsert] then
            qryRecebimentos.Post;
          qryRecebimentos.Next;
        end;
      finally
        qryRecebimentos.GotoBookmark(Pos);
        qryRecebimentos.FreeBookmark(Pos);
//        qryRecebimentos.EnableControls;
      end;
    end;
  end;

  dsrRecebimentos.OnDataChange := dsrRecebimentosDataChange;
end;

function TdtmControleRecebimentos.GetQtdeMarcados: Integer;
begin
  Result := FQtdeMarcados;
end;

function TdtmControleRecebimentos.GetTotalMarcados: Real;
begin
  Result := FTotalMarcados;
end;



end.
