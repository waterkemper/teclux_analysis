function TdtmControleRecebimentos.ConsultarRecebimentos(DataInicialEmissao,
 DataFinalEmissao, DataInicialVencto, DataFinalVencto, Filial, TipoRecebimento, TipoCliente, Cliente: String;
  Operacoes: Integer;  Dinheiro, Cheque, Debito, Credito: Boolean
  ): Boolean;
var
  vFormadeRecebimento: String;
begin

  QtdeMarcados := 0;
  TotalMarcados := 0;

  qryRecebimentos.ParamByName('operacao').AsInteger := Operacoes;
  
  if not DataEmBranco(DataInicialEmissao) then
  begin
    if DataEmBranco(DataFinalEmissao) then
     qryRecebimentos.macrobyname('SQLRecebimentosDataLancto').asstring :=
       ' and r.datalacnto >= ' + quotedstr(FormatDateTime('yyyy-mm-dd',StrToDateTime(DataInicialEmissao)))
    else
     qryRecebimentos.macrobyname('SQLRecebimentosDataLancto').asstring :=
       ' and r.datalancto between ' + quotedstr(FormatDateTime('yyyy-mm-dd',StrToDateTime(DataInicialEmissao))) +
       ' and '+quotedstr(FormatDateTime('yyyy-mm-dd',StrToDateTime(DataFinalEmissao)));
  end
  else begin
    if not DataEmBranco(DataFinalEmissao) then
      qryRecebimentos.macrobyname('SQLRecebimentosDataLancto').asstring :=
        ' and r.datalancto <= ' + quotedstr(FormatDateTime('yyyy-mm-dd',StrToDateTime(DataFinalEmissao)))
    else
      qryRecebimentos.MacroByName('SQLRecebimentosDataLancto').AsString:= '';
  end;


  if not DataEmBranco(DataInicialVencto) then begin
    if DataEmBranco(DataFinalVencto) then
     qryRecebimentos.macrobyname('SQLRecebimentosDataVencto').asstring :=
       ' and r.datavencto >= ' + quotedstr(FormatDateTime('yyyy-mm-dd',StrToDateTime(DataInicialVencto)))
    else
     qryRecebimentos.macrobyname('SQLRecebimentosDataVencto').asstring :=
       ' and r.datavencto between ' + quotedstr(FormatDateTime('yyyy-mm-dd',StrToDateTime(DataInicialVencto))) +
       ' and '+quotedstr(FormatDateTime('yyyy-mm-dd',StrToDateTime(DataFinalVencto)));
  end
  else
  begin
    if not DataEmBranco(DataFinalVencto) then
      qryRecebimentos.macrobyname('SQLRecebimentosDataVencto').asstring :=
        ' and r.datavencto <= ' + quotedstr(FormatDateTime('yyyy-mm-dd',StrToDateTime(DataFinalVencto)))
    else
      qryRecebimentos.MacroByName('SQLRecebimentosDataVencto').AsString:= '';
  end;



  if (Filial <> '') then
    qryRecebimentos.MacroByName('Filial_Recebimento').AsString:= 'and r.filial in (' + filial + ')'
  else
    qryRecebimentos.MacroByName('Filial_Recebimento').AsString:= '';

  if (TipoRecebimento <> '') then
    qryRecebimentos.MacroByName('TipoRecebimento_Recebimentos').AsString:= 'and r.tiporecebimento in (' + TipoRecebimento + ')'
  else
    qryRecebimentos.MacroByName('TipoRecebimento_Recebimentos').AsString:= '';

  if (Cliente <> '') then
    qryRecebimentos.MacroByName('Cliente_Contrato').AsString:= 'and ((ct.cliente = ' + Cliente + ')'+
                                                       'and (ct.tipocliente = ' + quotedstr(TipoCliente) + '))'
  else
    qryRecebimentos.MacroByName('Cliente_Contrato').AsString:= '';

  case Operacoes of
    0: qryRecebimentos.MacroByName('CondicaoOperacao').AsString := 'and not r.confirmado /* and not exists (select r2.codigo from recebimentos r2 where r2.controlerecebimento = r.controlerecebimento and r2.confirmado limit 1)*/';
    1: qryRecebimentos.MacroByName('CondicaoOperacao').AsString := 'and not r.confirmado';
    2: qryRecebimentos.MacroByName('CondicaoOperacao').AsString := 'and r.confirmado';
  end;

  vFormadeRecebimento := '';
  if Dinheiro then
    vFormadeRecebimento := vFormadeRecebimento + 'D';

  if Cheque then
    vFormadeRecebimento := vFormadeRecebimento + 'H';

  if Debito then
    vFormadeRecebimento := vFormadeRecebimento + 'B';

  if Credito then
    vFormadeRecebimento := vFormadeRecebimento + 'C';

  if (vFormadeRecebimento = '') or (vFormadeRecebimento = 'DHBC') then
    qryRecebimentos.MacroByName('FormadeRecebimentos').AsString := ''
  else
    qryRecebimentos.MacroByName('FormadeRecebimentos').AsString := 'and position(tr.tiporecebimento in '+quotedstr(vFormadeRecebimento)+')<>0';

  qryRecebimentos.close;
  qryRecebimentos.Open;

                  {
  case Operacoes of
    1: MarcarSelecionados(false,true,true);
  end;
                  }
  Result := not qryRecebimentos.IsEmpty;


end;

function TdtmControleRecebimentos.GravarRecebimentos(Operacao: integer): Boolean;
var
  vListadeRecebimentos : String;
  vListaMovtosBancos : String;
  vListaDuplicatas, vListaDocumentosPag : String;
  vNow: TDateTime;
  vSequencia, vSequenciaEvento : integer;

  function LocalizarDocumentosPag(Documentopag, duplicata: integer; DataVencto: TDateTime): Boolean;
  begin
    result := true;
    qryDocumentosPag.first;
    qryduplicatas.First;
    if qryDocumentosPag.locate('numero', Documentopag, []) then
    begin
      qryDuplicatas.First;
      if not qryduplicatas.Locate('documentopag, datavencto, numero', VarArrayof([Documentopag, datavencto, duplicata]),[]) then
      begin
        result := false;
        MensagemErro(format('A duplicata n. %s com data de vencimento em %s do documento a pagar %s não foi encontrada',
        [inttostr(duplicata), FormatDateTime('dd/mm/yyyy', datavencto), inttostr(Documentopag)]));
      end;
    end
    else
    begin
      result := false;
      if documentopag <> 0 then
        MensagemErro(format('Documento a pagar %s não foi encontrada', [inttostr(Documentopag)] ));
    end;
  end;

  function LocalizarMovtosBancos(conta :Integer;
                               data_confirmacao : TDateTime;
                               sequencia : integer;
                               evento : Integer;
                               sequenciaevento : Integer; LocalizarMovtosBancosEventos: boolean = true): boolean;
  begin
    result := true;
    qryMovtosBancos.first;
    qryMovtosBancosEventos.first;

    if qryMovtosBancos.Locate('conta,data,sequencia',
                                   VarArrayOf([conta, data_confirmacao, sequencia]),[]) then
    begin
      if LocalizarMovtosBancosEventos then
      begin
        qryMovtosBancosEventos.first;
        if not qryMovtosBancosEventos.Locate('conta,data,sequencia,evento,sequenciaevento',
                                         VarArrayOf([conta, data_confirmacao,
                                                     sequencia, evento, sequenciaevento]), []) then
        begin
          result := false;
          MensagemErro(format('Movimento de eventos e banco não encontrado. Conta: %d Data: %s Sequência: %d Evento: %d sequencia Evento: %d',
                             [conta, datetostr(data_confirmacao), sequencia, evento, sequenciaevento]));
        end;
      end;
    end
    else
    begin
      result := false;
      MensagemErro(format('Movimento de banco não encontrado. Conta: %s Data: %s Sequência: %s',
                         [qryRecebimentosconta.AsString,
                          qryRecebimentosdata_confirmacao.AsString,
                          qryRecebimentossequencia.asString]));
    end;
  end;

  function ApagarMovtosBancosEventosAnterior: boolean;
  begin
    result := True;
    if (not qryRecebimentosconta.isnull) and
       (not qryRecebimentosdata_confirmacao_old.isnull) and
       (not qryRecebimentossequencia.isnull) and
       (not qryRecebimentosevento.isnull) and
       (not qryRecebimentossequenciaevento.isnull) then
    begin
      result :=   LocalizarMovtosBancos(qryRecebimentosconta.AsInteger,
  			 qryRecebimentosdata_confirmacao_old.AsDateTime,
                         qryRecebimentossequencia.asinteger,
                         qryRecebimentosevento.AsInteger,
                         qryRecebimentossequenciaevento.AsInteger);
      if result then
      begin
        qryMovtosBancos.Edit;
        qryMovtosBancosvalor.AsCurrency := qryMovtosBancosvalor.AsCurrency - qryMovtosBancosEventosvalor.AsCurrency;
        qryMovtosBancos.post;

        qryMovtosBancosEventos.delete;


        if qryMovtosBancosvalor.AsCurrency = 0 then
           qryMovtosBancos.delete
        else
        begin
          qryMovtosBancosEventos.MasterSource := dsrMovtosBancos;
          qryMovtosBancosEventos.first;

          if qryMovtosBancosEventos.recordcount = 1 then
          begin
            qryMovtosBancos.Edit;
            qryMovtosBancosevento.AsInteger := qryMovtosBancosEventosevento.AsInteger;
            qryMovtosBancos.post;
          end
          else
          if (qryMovtosBancosEventos.recordcount > 1) and
                   (not qryMovtosBancosevento.isnull) then
          begin
                  qryMovtosBancos.Edit;
                  qryMovtosBancosevento.clear;
                  qryMovtosBancos.post;
                  qryMovtosBancos.first;
          end;
          qryMovtosBancosEventos.MasterSource := nil;
        end;

        qryAtualizarRecebimentos.FieldByName('conta').clear;
        qryAtualizarRecebimentos.FieldByName('sequencia').clear;
        qryAtualizarRecebimentos.FieldByName('evento').clear;
        qryAtualizarRecebimentos.FieldByName('sequenciaevento').clear;
      end;
    end;
  end;

  function ApagarDocumentosPag: boolean;
  begin
    result := true;
    if not qryRecebimentosdocumentopag.isnull then
    begin
      result := LocalizarDocumentosPag(qryRecebimentosdocumentopag.AsInteger,
   			 qryRecebimentosduplicata.AsInteger,
                         qryRecebimentosdata_confirmacao_old.AsDateTime);
      if result then
      begin
        qryDuplicatas.delete;
        qrydocumentospag.Delete;

        qryatualizarRecebimentos.fieldbyname('documentopag').clear;
        qryatualizarRecebimentos.fieldbyname('duplicata').clear;
        qryatualizarRecebimentos.fieldbyname('fornecedor').clear;
        qryatualizarRecebimentos.fieldbyname('eventodocumentopag').clear;

      end;
    end;
  end;


  function DescricaoContratoParcela: String;
  var
    vListaContratoseParcelas : String;
    vListaCupons : String;
  begin
    result := '';
    RefazConsultaPorNome(qryAutenticacoes, ['transacao'],[qryRecebimentostransacao.asinteger]);
    vListaContratoseParcelas := '';
    vListaCupons := '';
    qryAutenticacoes.First;
    while not qryAutenticacoes.Eof do
    begin
      if (qryAutenticacoescontratoparcela.AsString <> '') and (qryAutenticacoesparcela.AsString <> '') then
        vListaContratoseParcelas := vListaContratoseParcelas + '['+ qryAutenticacoescontratoparcela.AsString + ', '+ qryAutenticacoesparcela.AsString +'], '
      else
      if (qryAutenticacoescoo.AsInteger<>0) and (qryAutenticacoescontratoparcela.AsString <> '') then
        vListaCupons := vListaCupons + '['+ qryAutenticacoesnum_usu.AsString + ' ' + qryAutenticacoescro.AsString + ' ' + qryAutenticacoescoo.AsString + ' CT'+qryAutenticacoescontratoparcela.AsString +'], '
      else
      if (qryAutenticacoescoo.AsInteger<>0) then
        vListaCupons := vListaCupons + '['+ qryAutenticacoesnum_usu.AsString + ' ' + qryAutenticacoescro.AsString + ' ' + qryAutenticacoescoo.AsString + '], ';

      qryAutenticacoes.next;
    end;

    delete(vListaContratoseParcelas,length(vListaContratoseParcelas)-1, 2);
    delete(vListaCupons,length(vListaCupons)-1, 2);

    if vListaContratoseParcelas <> '' then
      result := 'Contratos/Parcelas: ' + vListaContratoseParcelas;

    if (result <> '') and (vListaCupons <> '') then
      result := result + chr(13) + 'Cupom Fiscal: ' + vListaCupons
    else
    if (vListaCupons <> '') then
      result := 'Cupom Fiscal: ' + vListaCupons;
  end;

  function AtualizarDocumentospag: boolean;
    procedure AtribuirdadosDocumentopag;
    begin
      if qryDocumentosPag.state = dsinsert then
      begin
        spcDocumentosPagProximo.Open;
        qryDocumentosPagnumero.AsInteger:= spcDocumentosPagProximocodigo.AsInteger;
        spcDocumentosPagProximo.Close;
      end;

      qryDocumentosPagfornecedor.AsInteger    := qryRecebimentosfornecedor.AsInteger;
      qryDocumentosPagemissao.AsDateTime      := qryRecebimentosdatalancto.AsDateTime;
      qryDocumentosPagcomplemento.AsString    := qryRecebimentostiporec.AsString;
      qryDocumentosPagfilialemissao.AsInteger := qryRecebimentosfilial.AsInteger;
//      qryDocumentosPagpedido
//      qryDocumentosPagprevisao
      qryDocumentosPagreferencia.AsString     := qryRecebimentostiporec.AsString;
      qryDocumentosPagvalor.AsCurrency        := qryRecebimentosVlrDesagio.AsCurrency;
//      qryDocumentosPagirretido
//      qryDocumentosPaginssretido
//      qryDocumentosPagissretido
//      qryDocumentosPagcofinsretido
//      qryDocumentosPagpisretido
//      qryDocumentosPagcsllretido
      qryDocumentosPagtipofornecedor.AsString := 'F';
      qryDocumentosPagevento.AsInteger        := qryRecebimentoseventodocumentopag.AsInteger;
      qryDocumentosPagdatalancto.AsDateTime   := qryRecebimentosdatalancto.AsDateTime;
{      qryDocumentosPagcreditar
      qryDocumentosPaghistorico
      qryDocumentosPagdocumentopagorigem
      qryDocumentosPagdatavenctoorigem
      qryDocumentosPagnumeroorigem
}
      qryDocumentosPagadministrador.AsBoolean := UsuarioLogin.Administrador;
{
      qryDocumentosPagfornecedorparaiss
      qryDocumentosPagfatogerador
      qryDocumentosPagpiscofinscsllretido
}
      qryDocumentosPagadiantamento.AsBoolean := false;
{
      qryDocumentosPagdebitar
      qryDocumentosPagtipopagamento
      qryDocumentosPagcontapagto
      qryDocumentosPagchequepagto
      qryDocumentosPagsequencia
      qryDocumentosPagfilialcontabil
      qryDocumentosPagpiscst
      qryDocumentosPagpisbasecalculo
      qryDocumentosPagpisaliquota
      qryDocumentosPagpisvalor
      qryDocumentosPagcofinscst
      qryDocumentosPagcofinsbasecalculo
      qryDocumentosPagcofinsaliquota
      qryDocumentosPagcofinsvalor
      qryDocumentosPagnat_bc_cred
}
      qryDocumentosPag.post;

      if qryDuplicatas.state = dsinsert then
        qryDuplicatasdocumentopag.AsInteger := qryDocumentosPagnumero.AsInteger;

      qryDuplicatasnumero.AsInteger := 1;
      qryDuplicatasdatavencto.AsDateTime := qryRecebimentosdata_confirmacao.AsDateTime;
      qryDuplicatasvalorvencto.AsCurrency := qryDocumentosPagvalor.AsCurrency;
      qryDuplicatasvalordesconto.AsCurrency := 0;
      qryDuplicatasjuros.AsCurrency := 0;
      qryDuplicatastipojuros.AsString := '%';
      qryDuplicatasmulta.AsCurrency := 0;
      qryDuplicatastipomulta.AsString := '%';
      qryDuplicatasobservacao.AsString := qryRecebimentostiporec.AsString;
      qryDuplicatasdatapagto.AsDateTime := qryRecebimentosdata_confirmacao.AsDateTime;
      qryDuplicatasvalorpagto.AsCurrency := qryDocumentosPagvalor.AsCurrency;
//      qryDuplicataschequepagto
//      qryDuplicatasbancocobranca
 //     qryDuplicatascontacredito
      qryDuplicatasautorizado.asboolean := false;
      qryDuplicatasfilialpagto.AsInteger := qryRecebimentosfilial.AsInteger;
      qryDuplicatasusuario.AsInteger := UsuarioLogin.CodigoUsuario;
//      qryDuplicatastipopagamento
//      qryDuplicatascontapagto
//      qryDuplicatassequencia
//      qryDuplicatasevento
//      qryDuplicatasdataautorizacaopagto
//      qryDuplicatasnrlotecontabil
//      qryDuplicatassequenciaevento
      qryDuplicatas.post;


    end;

  begin
    result := true;
    if (qryRecebimentosdocumentopag.AsInteger = 0) and
       (qryRecebimentosfornecedor.AsInteger <> 0 ) and
       (qryRecebimentoseventodocumentopag.AsInteger <> 0) and
       (qryRecebimentosVlrDesagio.AsCurrency <> 0) and
       (not qryRecebimentosdata_confirmacao.isnull) then
    begin
      qryDocumentospag.append;
      qryDuplicatas.append;
      AtribuirdadosDocumentopag;
      qryatualizarRecebimentos.fieldbyname('documentopag').asinteger := qryDocumentosPagnumero.AsInteger;
      qryatualizarRecebimentos.fieldbyname('duplicata').asinteger := qryDuplicatasnumero.AsInteger;
      qryatualizarRecebimentos.fieldbyname('fornecedor').asinteger := qryRecebimentosfornecedor.AsInteger;
      qryatualizarRecebimentos.fieldbyname('eventodocumentopag').asinteger := qryRecebimentoseventodocumentopag.AsInteger;
    end
    else
    if LocalizarDocumentosPag(qryRecebimentosdocumentopag.AsInteger, qryRecebimentosduplicata.AsInteger, qryRecebimentosdata_confirmacao.AsDateTime) or
       LocalizarDocumentosPag(qryRecebimentosdocumentopag.AsInteger, qryRecebimentosduplicata.AsInteger, qryRecebimentosdata_confirmacao_old.AsDateTime) then
    begin
      if (qryRecebimentosVlrDesagio.AsCurrency = 0) or
         (qryRecebimentosfornecedor.AsInteger = 0) or
         (qryRecebimentoseventodocumentopag.AsInteger = 0) or
         (qryRecebimentosdata_confirmacao.IsNull) then
      begin
        qryDuplicatas.delete;
        qrydocumentospag.Delete;

        qryatualizarRecebimentos.fieldbyname('documentopag').clear;
        qryatualizarRecebimentos.fieldbyname('duplicata').clear;
        qryatualizarRecebimentos.fieldbyname('fornecedor').clear;
        qryatualizarRecebimentos.fieldbyname('eventodocumentopag').clear;

      end
      else
      if (qryDocumentosPagfornecedor.AsInteger <> qryRecebimentosfornecedor.AsInteger) or
         (qryDocumentosPagevento.AsInteger <> qryRecebimentoseventodocumentopag.AsInteger) or
         (qryDocumentosPagvalor.AsCurrency <> qryRecebimentosVlrDesagio.AsCurrency) or
         (qryDuplicatasdatavencto.AsDateTime <> qryRecebimentosdata_confirmacao.AsDateTime) then
      begin
        qryDocumentospag.edit;
        qryDuplicatas.Edit;
        AtribuirdadosDocumentopag;
        qryatualizarRecebimentos.fieldbyname('fornecedor').asinteger := qryRecebimentosfornecedor.AsInteger;
        qryatualizarRecebimentos.fieldbyname('eventodocumentopag').asinteger := qryRecebimentoseventodocumentopag.AsInteger;
      end;
    end
    else
      result := (qryRecebimentosdocumentopag.AsInteger = 0);
  end;

begin
  result := false;

  if ObterAutorizacaoPagamento then
  begin
    try
      try
        result := true;
        vNow := now;
        vListadeRecebimentos := '';
        vListaMovtosBancos := '';
        vListaDuplicatas := '';
        vListaDocumentosPag := '';
        GuardarRegistroAtual(qryrecebimentos,true);

        qryrecebimentos.First;
        while not qryRecebimentos.Eof  do
        begin
          if qryRecebimentosconfirmado.AsBoolean then
          begin
            vListadeRecebimentos := vListadeRecebimentos + qryRecebimentoscodigo.AsString+',';

            if not qryRecebimentosdocumentopag.IsNull then
              if pos(qryRecebimentosdocumentopag.asstring + ',', vListaDocumentosPag) = 0 then
                vListaDocumentosPag := vListaDocumentosPag + qryRecebimentosdocumentopag.asstring + ',';


            if not qryRecebimentosdocumentopag.IsNull and
               not qryRecebimentosduplicata.IsNull and
               not qryRecebimentosdata_confirmacao.IsNull then
            begin
              if pos('(' + qryRecebimentosdocumentopag.asstring + ', ' +
                           quotedstr(FormatDateTime('yyyy-mm-dd',qryRecebimentosdata_confirmacao.AsDateTime)) + ', ' +
                           qryRecebimentosduplicata.asstring + '),', vListaDuplicatas) = 0 then

                vListaDuplicatas := vListaDuplicatas +
                                      '(' + qryRecebimentosdocumentopag.asstring + ', ' +
                                            quotedstr(FormatDateTime('yyyy-mm-dd',qryRecebimentosdata_confirmacao.AsDateTime)) + ', ' +
                                            qryRecebimentosduplicata.asstring  + '),';
            end;


            if not qryRecebimentosdocumentopag.IsNull and
               not qryRecebimentosduplicata.IsNull and
               not qryRecebimentosdata_confirmacao_old.IsNull then
            begin
              if pos('(' + qryRecebimentosdocumentopag.asstring + ', ' +
                           quotedstr(FormatDateTime('yyyy-mm-dd',qryRecebimentosdata_confirmacao_old.AsDateTime))+ ', ' +
                           qryRecebimentosduplicata.asstring + '),', vListaDuplicatas) = 0 then

                vListaDuplicatas := vListaDuplicatas +
                                      '(' + qryRecebimentosdocumentopag.asstring + ', ' +
                                            quotedstr(FormatDateTime('yyyy-mm-dd',qryRecebimentosdata_confirmacao_old.AsDateTime)) + ', ' +
                                            qryRecebimentosduplicata.asstring + '),';
            end;


            if IntegracaocomBancos  and parsistema.RecebimentosIntegradoComBancos  then
            begin

              if not qryRecebimentosconta.IsNull and
                 not qryRecebimentosdata_confirmacao.IsNull then
              begin
                if pos('(' + qryRecebimentosconta.asstring + ', ' +
                                         quotedstr(FormatDateTime('yyyy-mm-dd',qryRecebimentosdata_confirmacao.AsDateTime)) + '),', vListaMovtosBancos) = 0 then

                  vListaMovtosBancos := vListaMovtosBancos +
                                        '(' + qryRecebimentosconta.asstring + ', ' +
                                             quotedstr(FormatDateTime('yyyy-mm-dd',qryRecebimentosdata_confirmacao.AsDateTime)) + '),';
              end;

              if not qryRecebimentosconta.IsNull and
                 not qryRecebimentosdata_confirmacao_old.IsNull then
              begin
                if pos('(' + qryRecebimentosconta.asstring + ', ' +
                                           quotedstr(FormatDateTime('yyyy-mm-dd',qryRecebimentosdata_confirmacao_old.asdatetime)) + '),', vListaMovtosBancos) = 0 then
                  vListaMovtosBancos := vListaMovtosBancos +
                                        '(' + qryRecebimentosconta.asstring + ', ' +
                                             quotedstr(FormatDateTime('yyyy-mm-dd',qryRecebimentosdata_confirmacao_old.asdatetime)) + '),';

              end;
            end;
          end;

          qryRecebimentos.Next;
        end;

        if vListadeRecebimentos='' then
          vListadeRecebimentos := 'null,';

        delete(vListadeRecebimentos,length(vListadeRecebimentos),1);
        qryAtualizarRecebimentos.MacroByName('ListadeRecebimentos').asstring := 'and r.codigo in ('+vListadeRecebimentos+')';
        qryAtualizarRecebimentos.Close;
        qryAtualizarRecebimentos.Open;

        if vListaDocumentosPag='' then
          vListaDocumentosPag := 'null,';

        delete(vListaDocumentosPag,length(vListaDocumentosPag),1);
        qryDocumentosPag.MacroByName('ListaDocumentosPag').asstring := vListaDocumentosPag;

        qryDocumentosPag.Close;
        qryDocumentosPag.Open;

        if vListaDuplicatas='' then
          vListaDuplicatas := '(null,null,null),';

        delete(vListaDuplicatas,length(vListaDuplicatas),1);
        qryDuplicatas.MacroByName('ListaDuplicatas').asstring := vListaDuplicatas;
        qryDuplicatas.Close;
        qryDuplicatas.Open;


        if vListaMovtosBancos='' then
          vListaMovtosBancos := '(null,null),';

        delete(vListaMovtosBancos,length(vListaMovtosBancos),1);
        qryMovtosBancos.MacroByName('ListaMovtosBancos').asstring := vListaMovtosBancos;
        qryMovtosBancos.Close;
        qryMovtosBancos.Open;

        qryMovtosBancosEventos.MacroByName('ListaMovtosBancos').asstring := vListaMovtosBancos;
        qryMovtosBancosEventos.Close;
        qryMovtosBancosEventos.Open;

        qryAtualizarRecebimentos.First;
        while not qryAtualizarRecebimentos.Eof do
        begin
          if qryrecebimentos.Locate('codigo',qryAtualizarRecebimentos.fieldbyname('codigo').AsInteger,[]) {and
             ((qryAtualizarRecebimentos.FieldByName('valor_confirmacao').AsCurrency <> qryRecebimentosvalor_confirmacao.ascurrency) or
              (qryAtualizarRecebimentos.fieldbyname('data_confirmacao').asdatetime <> qryRecebimentosdata_confirmacao.AsDateTime) or
              (qryatualizarRecebimentos.fieldbyname('confirmado').AsBoolean <> qryRecebimentosconfirmado.AsBoolean and (Operacao=1)) or
              (qryatualizarRecebimentos.fieldbyname('confirmado').AsBoolean <> false and (Operacao=2)))} then
          begin
            qryAtualizarRecebimentos.Edit;
            { aqui criar campo para controlar atualização pela trigger }
            //qryatualizarRecebimentos.fieldbyname('tiporecebimento').asinteger := qryRecebimentoscodigotiporecebimento.AsInteger;
            qryAtualizarRecebimentos.FieldByName('desagio').AsCurrency       := qryRecebimentospdesagio.AsCurrency;

            if (Operacao=1) then
            begin
              if not qryRecebimentosvalor_confirmacao.isnull then
                qryAtualizarRecebimentos.FieldByName('valor_confirmacao').AsCurrency := qryRecebimentosvalor_confirmacao.ascurrency
              else
                qryAtualizarRecebimentos.FieldByName('valor_confirmacao').clear;

              if not qryRecebimentosdata_confirmacao.isnull then
                qryAtualizarRecebimentos.fieldbyname('data_confirmacao').asdatetime := qryRecebimentosdata_confirmacao.AsDateTime
              else
                qryAtualizarRecebimentos.fieldbyname('data_confirmacao').clear;

              qryatualizarRecebimentos.fieldbyname('confirmado').AsBoolean := true;

              result := AtualizarDocumentospag;

              if result then
              begin
                if IntegracaocomBancos  and parsistema.RecebimentosIntegradoComBancos  then
                begin
                  {se são iguais e não esta nulo: trata-se de uma alteração de algo já lançado}
                  if (qryRecebimentosdata_confirmacao.AsDateTime =  qryRecebimentosdata_confirmacao_old.AsDateTime) and

                     (not qryRecebimentosconta.isnull) and
                     (not qryRecebimentosdata_confirmacao.isnull) and
                     (not qryRecebimentossequencia.isnull) and
                     (not qryRecebimentosevento.isnull) and
                     (not qryRecebimentossequenciaevento.isnull) then
                  begin
                    if  LocalizarMovtosBancos(qryRecebimentosconta.AsInteger,
                       qryRecebimentosdata_confirmacao.AsDateTime,
                       qryRecebimentossequencia.asinteger,
                       qryRecebimentosevento.AsInteger,
                       qryRecebimentossequenciaevento.AsInteger) then
                    begin
                      if qryMovtosBancosEventosvalor.AsCurrency <> qryRecebimentosvalor_confirmacao.AsCurrency then
                      begin
                        qryMovtosBancos.Edit;
                        qryMovtosBancosvalor.AsCurrency := qryMovtosBancosvalor.AsCurrency - qryMovtosBancosEventosvalor.AsCurrency + qryRecebimentosvalor_confirmacao.AsCurrency;
                        qryMovtosBancos.post;

                        qryMovtosBancosEventos.edit;
                        qryMovtosBancosEventosvalor.AsCurrency := qryRecebimentosvalor_confirmacao.AsCurrency;
                        qryMovtosBancosEventos.post;
                      end;
                    end
                    else
                      result := false;
                  end
                  else
                  begin
                    {Se os dados anteriores não estão nulos e não entrou na situação anterior deve-se apagar e incluir novamente}
                    {Sempre que é gravado no banco os dados são selecionados novamente, atualizando os valores '_old')}

                    result := ApagarMovtosBancosEventosAnterior;

                    if result then
                    begin
                      if not qryRecebimentosconta.isnull and
                         not qryRecebimentosdata_confirmacao.isnull then
                      begin
                        qryMovtosBancos.first;

                        if qryMovtosBancos.Locate('conta,data', VarArrayOf([qryRecebimentosconta.AsInteger,
                                                                            qryRecebimentosdata_confirmacao.AsDateTime]),[]) then
                        begin
                          qryMovtosBancos.Edit;
                          qryMovtosBancosvalor.AsCurrency := qryMovtosBancosvalor.AsCurrency + qryRecebimentosvalor_confirmacao.AsCurrency;
                          qryMovtosBancos.post;

                          qryMovtosBancosEventos.MasterSource := dsrMovtosBancos;
                          qryMovtosBancosEventos.first;

                          qryMovtosBancosEventos.SortDescByField('evento,sequenciaevento');
                          if qryMovtosBancosEventos.Locate('evento', qryRecebimentosevento.AsInteger, [] ) then
                            vSequenciaEvento :=  qryMovtosBancosEventossequenciaevento.AsInteger + 1
                          else
                            vSequenciaEvento := 1;
                          qryMovtosBancosEventos.MasterSource := nil;

                        end
                        else
                        begin

                          qryMovtosBancosProximaSequencia.Close;
                          qryMovtosBancosProximaSequencia.ParamByName('ContaPagto').AsInteger := qryRecebimentosconta.AsInteger;
                          qryMovtosBancosProximaSequencia.ParamByName('DataPagto').AsDatetime := qryRecebimentosdata_confirmacao.AsDateTime;
                          qryMovtosBancosProximaSequencia.Open;

                          vSequencia := qryMovtosBancosProximaSequencianumero.AsInteger + 1;

                          qryMovtosBancos.Append;
                          qryMovtosBancosconta.AsInteger := qryRecebimentosconta.AsInteger;
                          qryMovtosBancosdata.AsDateTime := qryRecebimentosdata_confirmacao.AsDateTime;
                          qryMovtosBancoscompensacao.AsDateTime := qryRecebimentosdata_confirmacao.AsDateTime;
                          qryMovtosBancossequencia.AsInteger := vSequencia;
                          qryMovtosBancosvalor.AsCurrency := qryRecebimentosvalor_confirmacao.AsCurrency;
                          qryMovtosBancosorigemlancto.AsString := 'X';
                          qryMovtosBancostipo.AsString := 'E';
                          qryMovtosBancosevento.AsInteger := qryRecebimentosevento.AsInteger;

                          qryMovtosBancos.post;

                          vSequenciaEvento := 1;

                        end;

                        qryMovtosBancosEventos.Append;
                        qryMovtosBancosEventosconta.AsInteger := qryMovtosBancosconta.AsInteger;
                        qryMovtosBancosEventosdata.AsDateTime := qryMovtosBancosdata.AsDateTime;
                        qryMovtosBancosEventossequencia.AsInteger := qryMovtosBancossequencia.AsInteger;
                        qryMovtosBancosEventosevento.AsInteger := qryRecebimentosevento.AsInteger;
                        qryMovtosBancosEventossequenciaevento.AsInteger := vSequenciaEvento;
                        qryMovtosBancosEventosvalor.AsCurrency := qryRecebimentosvalor_confirmacao.AsCurrency;
                        qryMovtosBancosEventosobservacoes.AsString := DescricaoContratoParcela;
                        qryMovtosBancosEventos.post;

                        qryAtualizarRecebimentos.FieldByName('conta').AsInteger :=  qryMovtosBancosconta.AsInteger;
                        qryAtualizarRecebimentos.FieldByName('sequencia').AsInteger := qryMovtosBancossequencia.AsInteger;
                        qryAtualizarRecebimentos.FieldByName('evento').AsInteger := qryRecebimentosevento.AsInteger;
                        qryAtualizarRecebimentos.FieldByName('sequenciaevento').AsInteger := vSequenciaEvento;

                        qryMovtosBancosEventos.MasterSource := dsrMovtosBancos;
                        qryMovtosBancosEventos.first;

                        if (qryMovtosBancosEventos.RecordCount = 1) and
                           (qryMovtosBancosevento.IsNull) then
                        begin
                          qryMovtosBancos.Edit;
                          qryMovtosBancosevento.AsInteger := qryMovtosBancosEventosevento.AsInteger;
                          qryMovtosBancos.post;
                        end
                        else
                        if (qryMovtosBancosEventos.RecordCount > 1) and
                           (not qryMovtosBancosevento.IsNull) then
                        begin
                          qryMovtosBancos.Edit;
                          qryMovtosBancosevento.clear;
                          qryMovtosBancos.post;
                        end;

                        qryMovtosBancosEventos.MasterSource := nil;
                      end;
                    end;
                  end;
                end;
              end;
	    end
	    else
	    begin
	      if IntegracaocomBancos  and parsistema.RecebimentosIntegradoComBancos then
                result := ApagarMovtosBancosEventosAnterior;


              if result then
                result := ApagarDocumentospag;

              if result then
              begin
                qryAtualizarRecebimentos.FieldByName('valor_confirmacao').clear;
    	        qryAtualizarRecebimentos.fieldbyname('data_confirmacao').clear;
      	        qryatualizarRecebimentos.fieldbyname('confirmado').AsBoolean := false;
              end;
            end;

            if result then
            begin
              qryAtualizarRecebimentos.fieldbyname('data_operacao').asdatetime := vnow;
       	      qryAtualizarRecebimentos.fieldbyname('usuario_confirmacao').AsInteger := Usuario.CodigoUsuario;
              qryAtualizarRecebimentos.post;
            end;
	  end;
	  qryAtualizarRecebimentos.next;
	end;

        if result then
  	  Result := Perpetrar([qryDocumentospag, qryDuplicatas, qryMovtosBancos, qryMovtosBancosEventos, qryAtualizarRecebimentos]);
      finally
        VoltarRegistroAtual(qryrecebimentos);
      end;
    except
     result := false;
    end;
  end;

end;

procedure TdtmControleRecebimentos.dsrRecebimentosDataChange(
  Sender: TObject; Field: TField);
var
  vRetornarData : boolean;  
begin
  inherited;
  if Field = qryRecebimentosvalor_confirmacao then
  begin
    dsrRecebimentos.OnDataChange := nil;
    if qryRecebimentosconfirmado.AsBoolean then
    begin
      if qryRecebimentosvalor_confirmacao.NewValue <> null then
      begin
        if (FTotalMarcados + qryRecebimentosvalor_confirmacao.AsCurrency) > qryRecebimentosvalor_confirmacao.NewValue then
          FTotalMarcados:= ((FTotalMarcados - qryRecebimentosvalor_confirmacao.NewValue) +
                            qryRecebimentosvalor_confirmacao.AsCurrency)
        else
          FTotalMarcados:= 0;

      end;
    end;
    OnRecebimentosChange(Sender);
    dsrRecebimentos.OnDataChange := dsrRecebimentosDataChange;
  end
  else
  if field = qryRecebimentoscodigotiporecebimento then
  begin
    RefazConsultaPorNome(qryTipoRecebimento,['filialrecebimento','codigo'],[qryRecebimentosfilial.asinteger, qryRecebimentoscodigotiporecebimento.AsInteger]);

    if qryRecebimentosconfirmado.asboolean and
       IntegracaocomBancos and parsistema.RecebimentosIntegradoComBancos and
       (qrytiporecebimento.fieldbyname('conta_ctr').isnull or
        qrytiporecebimento.fieldbyname('evento_ctr').isnull) then
    begin
      MensagemAviso('O tipo de recebimento não possui a conta e evento associado a esta filial de recebimento.');
      dsrRecebimentos.OnDataChange := nil;
      Field.asinteger := qryRecebimentoscodigotiporecebimento_auxiliar.asinteger;
      dsrRecebimentos.OnDataChange := dsrRecebimentosDataChange;

//      qryRecebimentosconfirmado.AsBoolean := false;

//      MarcarSelecionados(false,false);
    end
    else
    if MensagemConfirmacao('Os alterações serão gravados.'+chr(13)+'Confirma a alteração do tipo de recebimento?') = smbOk then
    begin
      dsrRecebimentos.OnDataChange := nil;

      qryRecebimentosconta.AsString := qrytiporecebimento.fieldbyname('conta_ctr').asstring;
      qryRecebimentosevento.AsString := qrytiporecebimento.fieldbyname('evento_ctr').asstring;

      dsrRecebimentos.OnDataChange := dsrRecebimentosDataChange;

      if RecalcularRecebimentos then
        OnRecebimentoscodigotiporecebimento(Self)
      else
      begin
        dsrRecebimentos.OnDataChange := nil;
        Field.asinteger := qryRecebimentoscodigotiporecebimento_auxiliar.asinteger;
        RefazConsultaPorNome(qryTipoRecebimento,['filialrecebimento','codigo'],[qryRecebimentosfilial.asinteger, qryRecebimentoscodigotiporecebimento.AsInteger]);
        qryRecebimentosconta.AsString := qrytiporecebimento.fieldbyname('conta_ctr').asstring;
        qryRecebimentosevento.AsString := qrytiporecebimento.fieldbyname('evento_ctr').asstring;
        dsrRecebimentos.OnDataChange := dsrRecebimentosDataChange;
      end;
    end
    else
    begin
      dsrRecebimentos.OnDataChange := nil;
      Field.asinteger := qryRecebimentoscodigotiporecebimento_auxiliar.asinteger;
      dsrRecebimentos.OnDataChange := dsrRecebimentosDataChange;
    end;
  end
  else
  if field = qryRecebimentospdesagio then
  begin
    if qryRecebimentosconfirmado.asboolean then
      qryRecebimentosvalor_confirmacao.AsCurrency := qryRecebimentosvalorlancto.AsCurrency - (qryRecebimentosvalorlancto.AsCurrency * qryRecebimentospdesagio.AsCurrency / 100);
  end
  else
  if field = qryRecebimentosconfirmado then
  begin
    if qryRecebimentosconfirmado.AsBoolean then
    begin
      if IntegracaocomBancos and parsistema.RecebimentosIntegradoComBancos then
      begin
        if qryRecebimentosconta.isnull or qryRecebimentosevento.isnull then
        begin
          MensagemAviso('O tipo de recebimento não possui a conta e evento associado a esta filial de recebimento.');
          qryRecebimentosconfirmado.AsBoolean := false;
        end;
      end;

      if qryRecebimentosconfirmado.AsBoolean then
        IncDecCampoTabela(qryRecebimentos,
                          [qryRecebimentosquantidadeconfirmacoes],
                          ['+'],
                          [qryRecebimentoscontrolerecebimento],
                          [qryRecebimentoscontrolerecebimento.Value],
                          ['=']);

    end
    else
      IncDecCampoTabela(qryRecebimentos,
                        [qryRecebimentosquantidadeconfirmacoes],
                        ['-'],
                        [qryRecebimentoscontrolerecebimento],
                        [qryRecebimentoscontrolerecebimento.Value],
                        ['=']);

  end
  else
  if field = qryRecebimentosdata_confirmacao then
  begin
    if (qryRecebimentosdata_confirmacao.asdatetime <> 0) then
    begin
      if (qryRecebimentosdata_confirmacao.asdatetime < qryRecebimentosdatalancto.AsDateTime) then
      begin
        MensagemAviso('A data de confirmação esta inferior à data de lançamento');
        vRetornarData := true;
      end
      else
      if (qryRecebimentosdata_confirmacao.asdatetime > dataservidor) then
      begin
        MensagemAviso('A data de confirmação esta superior a data atual');
        vRetornarData := true;
      end
      else
        vRetornarData := false;

      if vRetornarData then
      begin
        dsrRecebimentos.OnDataChange := nil;
        if qryRecebimentosdata_confirmacao.OldValue <> null then
          qryRecebimentosdata_confirmacao.AsDateTime := qryRecebimentosdata_confirmacao.OldValue
        else
          qryRecebimentosdata_confirmacao.clear;
        dsrRecebimentos.OnDataChange := dsrRecebimentosDataChange;
      end;
    end;
  end;
end;

