function TdtmControleRecebimentos.RecalcularRecebimentos: boolean;
var
  i : integer;
  vValorJaAtribuido : Currency;
  vRegistroIncluido : boolean;
  vControleRecebimento : Integer;
begin

  result := false;

  if ObterAutorizacaoPagamento then
  begin
    result := true;

    vRegistroIncluido := false;
    vValorJaAtribuido := 0;

    qryAtualizarRecebimentos.MacroByName('ListadeRecebimentos').asstring :=
      'and r.controlerecebimento = '+qryRecebimentoscontrolerecebimento.asString;
    qryAtualizarRecebimentos.close;
    qryAtualizarRecebimentos.open;

    qryAtualizarRecebimentos_Aux.MacroByName('ListadeRecebimentos').asstring :=
      'and r.codigo = '+qryRecebimentoscontrolerecebimento.asString;
    qryAtualizarRecebimentos_Aux.close;
    qryAtualizarRecebimentos_Aux.open;

    LimparTabela(qryAtualizarRecebimentos);

    for i:=1 to qryTipoRecebimento.fieldbyname('numerorecebimentos').asinteger do
    begin
      CopiarRegistros(qryAtualizarRecebimentos_Aux, qryAtualizarRecebimentos);
      qryAtualizarRecebimentos.edit;

      spcRecebimentosProximo.Open;
      qryAtualizarRecebimentos.fieldbyname('codigo').AsInteger := spcRecebimentosProximocodigo.AsInteger;
      spcRecebimentosProximo.Close;

      if i=1 then
        vControleRecebimento := qryAtualizarRecebimentos.fieldbyname('codigo').AsInteger;

      qryAtualizarRecebimentos.fieldbyname('controlerecebimento').AsInteger  := vControleRecebimento;
      qryAtualizarRecebimentos.fieldbyname('controle').AsInteger     := i;

      qryAtualizarRecebimentos.fieldbyname('tiporecebimento').AsInteger := qryTipoRecebimento.fieldbyname('codigo').asinteger;

      {
      if qryTipoRecebimento.fieldbyname('conta_ctr').asinteger <> 0 then
        qryAtualizarRecebimentos.fieldbyname('conta').AsInteger := qryTipoRecebimento.fieldbyname('conta_ctr').asinteger
      else
        qryAtualizarRecebimentos.fieldbyname('conta').clear;

      if qryTipoRecebimento.fieldbyname('evento_ctr').asinteger <> 0 then
        qryAtualizarRecebimentos.fieldbyname('evento').AsInteger := qryTipoRecebimento.fieldbyname('conta_ctr').asinteger
      else
        qryAtualizarRecebimentos.fieldbyname('evento').clear;
      }

      if i = qryTipoRecebimento.fieldbyname('numerorecebimentos').asinteger then
        qryAtualizarRecebimentos.fieldbyname('valorlancto').AsCurrency := qryRecebimentosvalortotal.AsCurrency - vValorJaAtribuido
      else
      begin
        qryAtualizarRecebimentos.fieldbyname('valorlancto').AsCurrency := RoundTo(qryRecebimentosvalortotal.AsCurrency / qryTipoRecebimento.fieldbyname('numerorecebimentos').asinteger,-2);
        vValorJaAtribuido := qryAtualizarRecebimentos.fieldbyname('valorlancto').AsCurrency + vValorJaAtribuido;
      end;

      qryAtualizarRecebimentos.fieldbyname('datavencto').clear;
      qryAtualizarRecebimentos.fieldbyname('desagio').clear;

      qryAtualizarRecebimentos.post;

    end;

    result := perpetrar([qryAtualizarRecebimentos]);
  end;

end;

function TdtmControleRecebimentos.ObterAutorizacaoPagamento: Boolean;
begin
  result := false;
  if assigned(usuario) then
    Usuario.Free;

  Usuario:= TtecUsuarios.Create(dtmTecSoft.Database);
  //  try
    if UsuarioLogin.AnalistaCredito then
         Usuario:= ObterAutorizacao(taSENHA)
    else Usuario:= ObterAutorizacao(taLOGIN, ctANALISTACREDITO, ctAUTORIZADO);

    if Assigned(Usuario) and Usuario.analistacredito then
      result := true
    else
      MensagemAviso(format(ctUSUARIONAOAUTORIZADO,['autorizar o recebimento da transação.']));
end;

procedure TdtmControleRecebimentos.qryRecebimentosCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  if (qryRecebimentosvalor_confirmacao.AsCurrency <> 0) and
     (qryRecebimentosvalorlancto.AsCurrency <> 0) and
     (qryRecebimentosvalorlancto.AsCurrency >= qryRecebimentosvalor_confirmacao.AsCurrency) then
    qryRecebimentosVlrDesagio.AsCurrency := qryRecebimentosvalorlancto.AsCurrency - qryRecebimentosvalor_confirmacao.AsCurrency
  else
  if (qryRecebimentosvalorlancto.AsCurrency <> 0) and
     (qryRecebimentosvalorvencto.AsCurrency <> 0) and
     (qryRecebimentosvalorlancto.AsCurrency >= qryRecebimentosvalorvencto.AsCurrency) then
    qryRecebimentosVlrDesagio.AsCurrency := qryRecebimentosvalorlancto.AsCurrency - qryRecebimentosvalorvencto.AsCurrency
  else
    qryRecebimentosVlrDesagio.AsCurrency := 0;
end;

