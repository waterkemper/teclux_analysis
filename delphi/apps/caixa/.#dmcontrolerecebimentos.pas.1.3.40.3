unit dmcontrolerecebimentos;

interface

uses
  SysUtils, Classes, dmbasico, DB, cpdatasource, ZQuery, ZPgSqlQuery,
  cpquery, biblio, clusuario, ctconstantes, ZTransact, variants, dmtecsoft;

type
  TdtmControleRecebimentos = class(TdtmBasico)
    qryRecebimentos: TtecQuery;
    dsrRecebimentos: TtecDataSource;
    qryRecebimentoscodigo: TIntegerField;
    qryRecebimentoscodigotiporecebimento: TIntegerField;
    qryRecebimentosvalorlancto: TFloatField;
    qryRecebimentosvalorvencto: TFloatField;
    qryRecebimentosdatalancto: TDateField;
    qryRecebimentosdatavencto: TDateField;
    qryRecebimentospdesagio: TFloatField;
    qryRecebimentostransacao: TIntegerField;
    qryRecebimentoscheque: TStringField;
    qryRecebimentossituacao: TStringField;
    qryRecebimentosconfirmado: TBooleanField;
    qryTiposRecebimentos: TtecQuery;
    qryTiposRecebimentoscodigo: TIntegerField;
    qryTiposRecebimentosdescricao: TStringField;
    qryTiposRecebimentostiporecebimento: TStringField;
    qryRecebimentostiporec: TStringField;
    qryRecebimentosfilial: TIntegerField;
    qryRecebimentoscontrole: TIntegerField;
    qryRecebimentoscheque_vencto: TDateField;
    qryRecebimentoscheque_titular: TStringField;
    qryRecebimentosnomecliente: TStringField;
    qryRecebimentoscheque_banco: TStringField;
    qryRecebimentoscheque_agencia: TStringField;
    qryRecebimentoscheque_cheque: TStringField;
    qryRecebimentoscheque_conta: TStringField;
    qrySituacaoRecebimentos: TtecQuery;
    qrySituacaoRecebimentossituacao: TStringField;
    qrySituacaoRecebimentosdescricao: TStringField;
    qryRecebimentossituac: TStringField;
    qryRecebimentostef: TIntegerField;
    qryRecebimentosnomeredetef: TStringField;
    qryTipoRecebimento: TtecQuery;
    qryTipoRecebimentodesagio: TFloatField;
    qryRecebimentoscliente: TIntegerField;
    qryAtualizarRecebimentos: TtecQuery;
    qryRecebimentosdata_confirmacao: TDateField;
    qryRecebimentosvalor_confirmacao: TFloatField;
    procedure dsrRecebimentosDataChange(Sender: TObject; Field: TField);
    procedure qryRecebimentosBeforeInsert(DataSet: TDataSet);
    procedure qryRecebimentosBeforeDelete(DataSet: TDataSet);
  private
    FOnRecebimentosChange: TNotifyEvent;
    FQtdeMarcados: Integer;
    FTotalMarcados: Real;
    function getQtdeRecebimentos: Integer;
    function getTotalRecebimentos: Real;
    procedure MarcarSelecionados(Marcando, Todos: Boolean; Contando: Boolean = false);
    function GetQtdeMarcados: Integer;
    function GetTotalMarcados: Real;
    { Private declarations }
  public
    function ConsultarRecebimentos(DataInicialEmissao, DataFinalEmissao,
                                   DataInicialVencto, DataFinalVencto,
                                   Filial, TipoRecebimento, TipoCliente, Cliente: String;
                                   Confirmados: Integer): Boolean;
