  DataSet: TDataSet);
begin
  inherited;
  Abort;
end;

function TdtmControleRecebimentos.getQtdeRecebimentos: Integer;
begin
  Result := qryRecebimentos.RecordCount;
end;

function TdtmControleRecebimentos.getTotalRecebimentos: Real;
var
  pos : TBookmark;
begin
  pos := qryRecebimentos.GetBookmark;
  try
    Result := TotalizarValores[qryRecebimentos,qryRecebimentosvalorvencto, nil];
  finally
    qryRecebimentos.GotoBookmark(pos);
    qryRecebimentos.FreeBookmark(pos);
  end;
end;

procedure TdtmControleRecebimentos.MarcarSelecionados(Marcando,
  Todos: Boolean; Contando: Boolean = false);
var
  Pos     : TBookmark;
  I       : Integer;
  Count   : Integer;

  procedure AtualizarValores;
  begin
    if qryRecebimentosconfirmado.AsBoolean then
    begin
      FQtdeMarcados  := FQtdeMarcados + 1;
      FTotalMarcados := FTotalMarcados + qryRecebimentosvalor_confirmacao.AsCurrency;
    end
    else begin
      FQtdeMarcados  := FQtdeMarcados - 1;
      FTotalMarcados := FTotalMarcados - qryRecebimentosvalor_confirmacao.AsCurrency;
    end;
  end;

begin

  dsrRecebimentos.OnDataChange := nil;

  if not qryrecebimentos.IsEmpty then
  begin
    if not Todos then
    begin
      qryRecebimentos.Edit;
      qryRecebimentosconfirmado.AsBoolean := not qryRecebimentosconfirmado.AsBoolean;

      if qryRecebimentosconfirmado.AsBoolean then
      begin
        qryRecebimentosdata_confirmacao.AsDateTime := qryRecebimentosdatavencto.AsDateTime;
        qryRecebimentosvalor_confirmacao.AsCurrency := qryRecebimentosvalorvencto.AsCurrency ;
        AtualizarValores;
      end
      else
      begin
        AtualizarValores;
        qryRecebimentosdata_confirmacao.clear;
        qryRecebimentosvalor_confirmacao.clear;
      end;

      if qryRecebimentos.state in [dsedit, dsinsert] then
        qryRecebimentos.Post;

    end
    else
    begin
      Pos:= qryRecebimentos.GetBookmark;
      try
        qryRecebimentos.DisableControls;
        qryRecebimentos.First;
        Count := qryRecebimentos.RecordCount;
        for I:= 1 to Count do
        begin
          qryRecebimentos.Edit;
          if Marcando then
          begin
            if not qryRecebimentosconfirmado.AsBoolean then
            begin
              qryRecebimentosconfirmado.AsBoolean := True;
              qryRecebimentosdata_confirmacao.AsDateTime := qryRecebimentosdatavencto.AsDateTime;
              qryRecebimentosvalor_confirmacao.AsCurrency := qryRecebimentosvalorvencto.AsCurrency ;
              AtualizarValores;
            end
          end
          else
          begin
            if contando then
              AtualizarValores
            else
            if qryRecebimentosconfirmado.AsBoolean then
            begin
              qryRecebimentosconfirmado.AsBoolean:= False;
              AtualizarValores;
              qryRecebimentosdata_confirmacao.clear;
              qryRecebimentosvalor_confirmacao.clear;
            end;

          end;
          if qryRecebimentos.state in [dsedit, dsinsert] then
            qryRecebimentos.Post;
          qryRecebimentos.Next;
        end;
      finally
        qryRecebimentos.GotoBookmark(Pos);
        qryRecebimentos.FreeBookmark(Pos);
        qryRecebimentos.EnableControls;
      end;
    end;
  end;

  dsrRecebimentos.OnDataChange := dsrRecebimentosDataChange;
end;

function TdtmControleRecebimentos.GetQtdeMarcados: Integer;
begin
  Result := FQtdeMarcados;
end;

function TdtmControleRecebimentos.GetTotalMarcados: Real;
begin
  Result := FTotalMarcados;
end;



end.
