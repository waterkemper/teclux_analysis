      '            (a.tipo  = :tipo) and'
      '            (Not Exists (SELECT a1.autenticacao'
      '                         FROM autenticacoes a1'
      '                         WHERE a1.autenticacao=a.numero)) '
      'group by ct.filialvenda, f.nome')
