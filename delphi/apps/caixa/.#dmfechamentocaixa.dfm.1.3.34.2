      'SELECT  ct.filialvenda,'
      '             f.nome as nomefilialvenda,'
      '             sum(p.valorvencto) as valorvenctoparcela,'
      
        '             sum(case when a.valor>p.valorvencto then a.valor-p.' +
        'valorvencto else 0 end) as juros,'
      
        '             sum(case when a.valor<p.valorvencto then a.valor-p.' +
        'valorvencto else 0 end) as descontos'
      ''
      
        'FROM ((autenticacoes a JOIN (contratos ct left join filiais f ON' +
        ' ct.filialvenda = f.codigo)'
      
        '                                                             ON ' +
        'a.contratoparcela=ct.numero)'
      
        '                                   JOIN parcelas p on a.contrato' +
        'parcela=p.contrato and a.parcela=p.numero)'
      'WHERE (a.caixa = :caixa) and'
