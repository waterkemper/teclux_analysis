  object qryTotalizacoesCaixa: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryTotalizacoesCaixaCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select Sum(SaldoAnterior) as SaldoAnterior,'
      '       Sum(Juros) as Juros,'
      '       Sum(Descontos) as Descontos,'
      '       Sum(Devolucoes) as Devolucoes,'
      '       Sum(ChequeAVista) as ChequeAVista,'
      '       Sum(ChequePre) as ChequePre,'
      '       Sum(DocEntrada) as DocEntrada,'
      '       Sum(DocSaida) as DocSaida,'
      '       Sum(Deposito) as Deposito,'
      '       Sum(TransEntrada) as TransEntrada,'
      '       Sum(TransSaida) as TransSaida,'
      '       Sum(Cancelamento) as Cancelamento,'
      '       Sum(Perdas) as Perdas,'
      '       Sum(Prestacoes) as Prestacoes,'
      '       Sum(ResgateCheque) as ResgateCheque,'
      '       Sum(Duplicatas) as DuplicatasFornecedores,'
      '       sum(Cartao) as Cartao,'
      '       sum(FrenteCaixa) as FrenteCaixa,'
      '       Sum(SaldoAtual) as SaldoAtual,'
      '       Sum(DevolucoesSaldo) as DevolucoesSaldo,'
      '       Sum(FCDinheiro) as FCDinheiro,'
      '       Sum(FCCheque) as FCCheque,'
      '       Sum(FCMD) as FCMD,'
      '       Sum(FCMC) as FCMC,'
      '       Sum(FCVD) as FCVD,'
      '       Sum(FCVC) as FCVC,'
      '       Sum(FCAD) as FCAD,'
      '       Sum(FCAC) as FCAC,'
      '       Sum(FCHD) as FCHD,'
      '       Sum(FCHC) as FCHC'
      ''
      'from ('
      '/*saldo */'
      ''
      'select 0 as SaldoAnterior,'
      
        '         0 as Juros, 0 as Descontos, 0 as Devolucoes, 0 as Chequ' +
        'eAVista,'
      
        '         0 as ChequePre, 0 as DocEntrada, 0 as DocSaida, 0 as De' +
        'posito,'
      
        '         0 as TransEntrada, 0 as TransSaida,0 as Cancelamento, 0' +
        ' as Perdas,'
      
        '         0 as Prestacoes, 0 as ResgateCheque, 0 as Duplicatas, 0' +
        ' as Cartao,'
      
        '         0 as FrenteCaixa, 0 as SaldoAtual, 0 as DevolucoesSaldo' +
        ','
      
        '         0 as FCDinheiro,0 as FCCheque, 0 as FCMD, 0 as FCMC, 0 ' +
        'as FCVD, 0 as FCVC,'
      '         0 as FCAC, 0 as FCAD, 0 as FCHC, 0 as FCHD'
      ''
      'FROM autenticacoes a'
      'WHERE a.numero = 0'
      ''
      'union'
      ''
      '/*saldo */'
      'select a.saldo as SaldoAnterior,'
      
        '       0 as Juros, 0 as Descontos, 0 as Devolucoes, 0 as ChequeA' +
        'Vista,'
      
        '       0 as ChequePre, 0 as DocEntrada, 0 as DocSaida, 0 as Depo' +
        'sito,'
      
        '       0 as TransEntrada, 0 as TransSaida,0 as Cancelamento, 0 a' +
        's Perdas,'
      
        '       0 as Prestacoes, 0 as ResgateCheque, 0 as Duplicatas, 0 a' +
        's Cartao,'
      '       0 as FrenteCaixa, 0 as SaldoAtual, 0 as DevolucoesSaldo,'
      
        '       0 as FCDinheiro,0 as FCCheque, 0 as FCMD, 0 as FCMC, 0 as' +
        ' FCVD, 0 as FCVC,'
      '       0 as FCAC, 0 as FCAD, 0 as FCHC, 0 as FCHD'
      'FROM autenticacoes a'
      'WHERE a.numero = (SELECT max(a1.numero)'
      '                                FROM autenticacoes a1'
      '                                where (a1.caixa = :caixa) and'
      
        '                                          (a1.data < :data) and ' +
        '(a1.filial = :filialbase)'
      '                               )'
      'union'
      ''
      '/*Juros */'
      'SELECT 0 as SaldoAnterior,'
      '       COALESCE(SUM(p.valorpagto-p.valorvencto),0) as Juros,'
      
        '       0 as Descontos, 0 as Devolucoes, 0 as ChequeAVista, 0 as ' +
        'ChequePre,'
      
        '       0 as DocEntrada, 0 as DocSaida, 0 as Deposito, 0 as Trans' +
        'Entrada,'
      
        '       0 as TransSaida,0 as Cancelamento, 0 as Perdas, 0 as Pres' +
        'tacoes,'
      
        '       0 as ResgateCheque, 0 as Duplicatas, 0 as Cartao, 0 as Fr' +
        'enteCaixa,'
      '       0 as SaldoAtual, 0 as DevolucoesSaldo,'
      
        '       0 as FCDinheiro,0 as FCCheque, 0 as FCMD, 0 as FCMC, 0 as' +
        ' FCVD, 0 as FCVC,'
      #9'   0 as FCAC, 0 as FCAD, 0 as FCHC, 0 as FCHD'
      'FROM parcelas p, autenticacoes a'
      'WHERE (p.numero=a.parcela)           AND'
      '             (p.contrato=a.contratoparcela) AND'
      '             (p.valorpagto>p.valorvencto)   AND'
      '             (a.tipo = '#39'P'#39') and'
      '             (a.caixa = :caixa) and'
      '             (a.data = :data) and (a.filial=:filialbase) and'
      '             Not Exists (select a1.numero'
      '                              from autenticacoes a1'
      '                              where a.numero = a1.autenticacao)'
      'union'
      ''
      '/*Descontos */'
      'SELECT 0 as SaldoAnterior, 0 as Juros,'
      '       COALESCE(SUM(p.valorvencto-p.valorpagto),0) as Descontos,'
      
        '       0 as Devolucoes, 0 as ChequeAVista, 0 as ChequePre, 0 as ' +
        'DocEntrada,'
      
        '       0 as DocSaida, 0 as Deposito, 0 as TransEntrada, 0 as Tra' +
        'nsSaida,'
      
        '       0 as Cancelamento, 0 as Perdas, 0 as Prestacoes, 0 as Res' +
        'gateCheque,'
      
        '       0 as Duplicatas, 0 as Cartao, 0 as FrenteCaixa, 0 as Sald' +
        'oAtual,'
      '       0 as DevolucoesSaldo,'
      
        '       0 as FCDinheiro,0 as FCCheque, 0 as FCMD, 0 as FCMC, 0 as' +
        ' FCVD, 0 as FCVC,'
      #9'   0 as FCAC, 0 as FCAD, 0 as FCHC, 0 as FCHD'
      'FROM parcelas p, autenticacoes a'
      'WHERE (p.numero=a.parcela)           AND'
      '      (p.contrato=a.contratoparcela) AND'
      '      (p.valorvencto>p.valorpagto)   AND'
      '      (a.tipo = '#39'P'#39') and'
      '      (a.caixa = :caixa) and (a.filial=:filialbase) and'
      '      (a.data = :data)'
      'union'
      '/*Devolucoes */'
      'SELECT 0 as SaldoAnterior, 0 as Juros, 0 as Descontos,'
      '       COALESCE(SUM(a.valor),0) as Devolucoes,'
      
        '       0 as ChequeAVista, 0 as ChequePre, 0 as DocEntrada, 0 as ' +
        'DocSaida,'
      
        '       0 as Deposito, 0 as TransEntrada, 0 as TransSaida,0 as Ca' +
        'ncelamento,'
      
        '       0 as Perdas, 0 as Prestacoes, 0 as ResgateCheque, 0 as Du' +
        'plicatas,'
      
        '       0 as Cartao, 0 as FrenteCaixa, 0 as SaldoAtual, 0 as Devo' +
        'lucoesSaldo,'
      
        '       0 as FCDinheiro,0 as FCCheque, 0 as FCMD, 0 as FCMC, 0 as' +
        ' FCVD, 0 as FCVC,'
      #9'   0 as FCAC, 0 as FCAD, 0 as FCHC, 0 as FCHD'
      'FROM autenticacoes a'
      'WHERE (a.tipo = '#39'N'#39') and'
      '      (a.caixa = :caixa) and'
      '      (a.data = :data) and (a.filial=:filialbase) and'
      '      Not Exists (select a1.numero'
      '                  from autenticacoes a1'
      '                  where a.numero = a1.autenticacao)'
      'union'
      '/*DevolucoesSaldo*/'
      'SELECT 0 as SaldoAnterior, 0 as Juros, 0 as Descontos,'
      
        '       0 as Devolucoes, 0 as ChequeAVista, 0 as ChequePre, 0 as ' +
        'DocEntrada,'
      
        '       0 as DocSaida, 0 as Deposito, 0 as TransEntrada, 0 as Tra' +
        'nsSaida,'
      
        '       0 as Cancelamento, 0 as Perdas, 0 as Prestacoes, 0 as Res' +
        'gateCheque,'
      
        '       0 as Duplicatas, 0 as Cartao, 0 as FrenteCaixa, 0 as Sald' +
        'oAtual,'
      '       COALESCE(SUM(a.valor),0) as DevolucoesSaldo,'
      
        '       0 as FCDinheiro,0 as FCCheque, 0 as FCMD, 0 as FCMC, 0 as' +
        ' FCVD, 0 as FCVC,'
      #9'   0 as FCAC, 0 as FCAD, 0 as FCHC, 0 as FCHD'
      'FROM autenticacoes a'
      'WHERE (a.tipo = '#39'A'#39') and'
      '      (a.caixa = :caixa) and'
      '      (a.data = :data) and (a.filial=:filialbase) and'
      '      Not Exists (select a1.numero'
      '                  from autenticacoes a1'
      '                  where a.numero = a1.autenticacao)'
      '/*Cheque a vista */'
      'union'
      
        'SELECT 0 as SaldoAnterior, 0 as Juros, 0 as Descontos, 0 as Devo' +
        'lucoes,'
      '       COALESCE(SUM(a.valor),0) as ChequeAVista,'
      
        '       0 as ChequePre, 0 as DocEntrada, 0 as DocSaida, 0 as Depo' +
        'sito,'
      
        '       0 as TransEntrada, 0 as TransSaida, 0 as Cancelamento, 0 ' +
        'as Perdas,'
      
        '       0 as Prestacoes, 0 as ResgateCheque, 0 as Duplicatas, 0 a' +
        's Cartao,'
      '       0 as FrenteCaixa, 0 as SaldoAtual, 0 as DevolucoesSaldo,'
      
        '       0 as FCDinheiro,0 as FCCheque, 0 as FCMD, 0 as FCMC, 0 as' +
        ' FCVD, 0 as FCVC,'
      #9'   0 as FCAC, 0 as FCAD, 0 as FCHC, 0 as FCHD'
      'FROM autenticacoes a, cheques c'
      'WHERE (a.cheque = c.numero) AND'
      '      (a.tipo = '#39'H'#39')        AND'
      '      (c.data >= c.vencto) and'
      '      (a.caixa = :caixa) and'
      '      (a.data = :data) and (a.filial=:filialbase) and'
      '      Not Exists (select a1.numero'
      '                  from autenticacoes a1'
      '                  where a.numero = a1.autenticacao)'
      'union'
      '/*Cheque pre-datado */'
      
        'SELECT 0 as SaldoAnterior, 0 as Juros, 0 as Descontos, 0 as Devo' +
        'lucoes,'
      '       0 as ChequeAVista,'
      '       COALESCE(SUM(a.valor),0) as ChequePre,'
      
        '       0 as DocEntrada, 0 as DocSaida, 0 as Deposito, 0 as Trans' +
        'Entrada,'
      
        '       0 as TransSaida,0 as Cancelamento, 0 as Perdas, 0 as Pres' +
        'tacoes,'
      
        '       0 as ResgateCheque, 0 as Duplicatas, 0 as Cartao, 0 as Fr' +
        'enteCaixa,'
      '       0 as SaldoAtual, 0 as DevolucoesSaldo,'
      
        '       0 as FCDinheiro,0 as FCCheque, 0 as FCMD, 0 as FCMC, 0 as' +
        ' FCVD, 0 as FCVC,'
