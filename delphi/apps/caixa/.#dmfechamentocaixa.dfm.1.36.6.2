  object qryAutenticacoes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WHEREBASE'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WHERETIPO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'OUTROSFILTROS'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'SELECT a.numero,'
      '       a.data,'
      '       a.filial,'
      '       a.caixa,'
      '       case when a.tipo='#39'S'#39' then'
      
        '         (select u.nome from usuarios u where a.transferencia=u.' +
        'codigo)'
      '       else'
      '         (select u.nome from usuarios u where a.caixa=u.codigo)'
      '       end as nomecaixa,'
      '       a.autenticacao,'
      '       a.banco,'
      '       b.nome as nomebanco, '
      '       a.cheque,'
      '       c.vencto as venctocheque,'
      '       a.contrato,'
      '       coalesce(ct.tipocliente, c.tipocliente) as tipocliente,'
      '       coalesce(ct.cliente, c.cliente) as cliente,'
      '       a.datadocumento,'
      '       a.evento,'
      '       e.descricao as descricaoevento,'
      '       a.historico,'
      '       a.hora,'
      '       a.motivo,'
      '       m.descricao as descricaomotivo,'
      '       a.nota,'
      '       a.parametros,'
      '       a.contratoparcela,'
      '       a.parcela,'
      '       dp.fornecedor,'
      '       dp.tipofornecedor, '
      '       a.saldo,'
      '       a.situacao,'
      '       a.tipo,'
      '       a.transferencia,'
      '       a.entradapendente,'
      '       a.confirmacao,'
      '       a.valor,'
      
        '       coalesce(a.valorvenctoparcela, p.valorvencto) as valorven' +
        'ctoparcela,'
      '       a.documentopag,'
      '       a.numeroduplicata,'
      '       a.venctoduplicata,'
      '       a.cliente as clientedev,'
      '       a.tipocliente as tipoclientedev,'
      
        '       (select coalesce(vf.razao,vf.nome) as nome from vforneced' +
        'ores vf where vf.codigo = a.cliente and vf.tipo = a.tipocliente)' +
        ' as nomeclientedev'
      
        'FROM (((((((autenticacoes a LEFT JOIN bancos b ON a.banco=b.codi' +
        'go)                                    '
      
        '                                              LEFT JOIN motivos ' +
        'm ON a.motivo=m.codigo)'
      
        '                                              LEFT JOIN contrato' +
        's ct ON coalesce(a.contratoparcela,a.contrato)=ct.numero)'
      
        '                                              LEFT JOIN parcelas' +
        ' p on a.contratoparcela=p.contrato and a.parcela=p.numero)'
      
        '                                              LEFT JOIN (cheques' +
        ' c LEFT JOIN vfornecedores vf on c.cliente=vf.codigo and c.tipoc' +
        'liente=vf.tipo)'
      
        '                                                                ' +
        '                             ON a.cheque=c.numero)'
      
        '                                              LEFT JOIN eventos ' +
        'e ON a.evento=e.codigo)'
      
        '                                              LEFT JOIN document' +
        'ospag dp on a.documentopag=dp.numero)'
      'WHERE (a.caixa = :caixa) and'
      '      (a.data  = :data) and (a.filial = :filialbase)'
      '%WHEREBASE'
      '%WHERETIPO'
      '%OUTROSFILTROS'
      'order by data, hora, coalesce(a.autenticacao,a.numero) '
      ''
      '')
    RequestLive = False
    Left = 250
    Top = 8
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'caixa'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'data'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filialbase'
        ParamType = ptUnknown
      end>
