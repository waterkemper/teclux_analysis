  object qryTotalizacoesCaixa: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryTotalizacoesCaixaCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select Sum(SaldoAnterior) as SaldoAnterior,'
      '       Sum(Juros) as Juros,'
      '       Sum(Descontos) as Descontos,'
      '       Sum(Devolucoes) as Devolucoes,'
      '       Sum(ChequeAVista) as ChequeAVista,'
      '       Sum(ChequePre) as ChequePre,'
      '       Sum(ChequeNaoIdentificado) as ChequeNaoIdentificado,'
      '       Sum(DocEntrada) as DocEntrada,'
      '       Sum(DocSaida) as DocSaida,'
      '       Sum(Deposito) as Deposito,'
      '       Sum(TransEntrada) as TransEntrada,'
      '       Sum(TransSaida) as TransSaida,'
      '       Sum(Cancelamento) as Cancelamento,'
      '       Sum(Perdas) as Perdas,'
      '       Sum(Prestacoes) as Prestacoes,'
      '       Sum(AjustSldDevTroca) as AjustSldDevTroca,'
      '       Sum(ResgateCheque) as ResgateCheque,'
      '       Sum(Duplicatas) as DuplicatasFornecedores,'
      '       sum(Cartao) as Cartao,'
      '       sum(pix) as pix,'
      '       Sum(SaldoAtual) as SaldoAtual,'
      '       Sum(DevolucoesSaldo) as DevolucoesSaldo'
      ''
      'from ('
      '/*saldo */'
      ''
      'select 0 as SaldoAnterior,'
      
        '         0 as Juros, 0 as Descontos, 0 as Devolucoes, 0 as Chequ' +
        'eAVista,'
      
        '         0 as ChequePre, 0 as ChequeNaoIdentificado,  0 as DocEn' +
        'trada, 0 as DocSaida, 0 as Deposito,'
      
        '         0 as TransEntrada, 0 as TransSaida,0 as Cancelamento, 0' +
        ' as Perdas,'
      '         0 as Prestacoes, 0 as AjustSldDevTroca,'
      
        '         0 as ResgateCheque, 0 as Duplicatas, 0 as Cartao, 0 as ' +
        'pix,'
      '         0 as SaldoAtual, 0 as DevolucoesSaldo'
      'FROM autenticacoes a'
      'WHERE a.numero = 0'
      ''
      'union'
      ''
      '/*saldo */'
      'select a.saldo as SaldoAnterior,'
      
        '       0 as Juros, 0 as Descontos, 0 as Devolucoes, 0 as ChequeA' +
        'Vista,'
      
        '       0 as ChequePre, 0 as ChequeNaoIdentificado,  0 as DocEntr' +
        'ada, 0 as DocSaida, 0 as Deposito,'
      
        '       0 as TransEntrada, 0 as TransSaida,0 as Cancelamento, 0 a' +
        's Perdas,'
      '       0 as Prestacoes, 0 as AjustSldDevTroca,'
      
        '       0 as ResgateCheque, 0 as Duplicatas, 0 as Cartao, 0 as pi' +
        'x,'
      '       0 as SaldoAtual, 0 as DevolucoesSaldo'
      'FROM autenticacoes a'
      'WHERE a.numero = (SELECT a1.numero'
      '                  FROM autenticacoes a1'
      '                  where (a1.caixa = :caixa)'
      '                  and (a1.data < :data)'
      '                  and (a1.filial = :filialbase)'
      
        '                  ORDER BY data_hora_tz(a1.data,a1.hora) DESC,a1' +
        '.numero  DESC LIMIT 1'
      '                  )'
      'union'
      ''
      '/*Juros */'
      'SELECT 0 as SaldoAnterior,'
      
        '       COALESCE(SUM(/*p.valorpagto*/a.valor-coalesce(a.valorvenc' +
        'toparcela,p.valorvencto)),0) as Juros,'
      
        '       0 as Descontos, 0 as Devolucoes, 0 as ChequeAVista, 0 as ' +
        'ChequePre, 0 as ChequeNaoIdentificado, '
      
        '       0 as DocEntrada, 0 as DocSaida, 0 as Deposito, 0 as Trans' +
        'Entrada,'
      '       0 as TransSaida,0 as Cancelamento, 0 as Perdas,'
      '       0 as Prestacoes, 0 as AjustSldDevTroca,'
      
        '       0 as ResgateCheque, 0 as Duplicatas, 0 as Cartao, 0 as pi' +
        'x,'
      '       0 as SaldoAtual, 0 as DevolucoesSaldo'
      'FROM parcelas p, autenticacoes a'
      'WHERE (p.numero=a.parcela)           AND'
      '             (p.contrato=a.contratoparcela) AND'
      
        '             (/*p.valorpagto*/a.valor>coalesce(a.valorvenctoparc' +
        'ela,p.valorvencto))   AND'
      '             (a.tipo = '#39'P'#39') and'
      '             (a.caixa = :caixa) and'
      '             (a.data = :data) and (a.filial=:filialbase) and'
      '             Not Exists (select a1.numero'
      '                              from autenticacoes a1'
      '                              where a.numero = a1.autenticacao)'
      'union'
      ''
      '/*Descontos */'
      'SELECT 0 as SaldoAnterior, 0 as Juros,'
      
        '       COALESCE(SUM(coalesce(a.valorvenctoparcela,p.valorvencto)' +
        '- a.valor /*p.valorpagto*/),0) as Descontos,'
      
        '       0 as Devolucoes, 0 as ChequeAVista, 0 as ChequePre, 0 as ' +
        'ChequeNaoIdentificado,  0 as DocEntrada,'
      
        '       0 as DocSaida, 0 as Deposito, 0 as TransEntrada, 0 as Tra' +
        'nsSaida,'
      
        '       0 as Cancelamento, 0 as Perdas, 0 as Prestacoes, 0 as Aju' +
        'stSldDevTroca,'
      '       0 as ResgateCheque,'
      '       0 as Duplicatas, 0 as Cartao, 0 as pix, 0 as SaldoAtual,'
      '       0 as DevolucoesSaldo'
      'FROM parcelas p, autenticacoes a'
      'WHERE (p.numero=a.parcela)           AND'
      '      (p.contrato=a.contratoparcela) AND'
      
        '      (coalesce(a.valorvenctoparcela,p.valorvencto)>/*p.valorpag' +
        'to*/a.valor)   AND'
      '      (a.tipo = '#39'P'#39') and'
      '      (a.caixa = :caixa) and (a.filial=:filialbase) and'
      '      (a.data = :data)  and'
      '             Not Exists (select a1.numero'
      '                              from autenticacoes a1'
      '                              where a.numero = a1.autenticacao)'
      'union'
      '/*Devolucoes */'
      'SELECT 0 as SaldoAnterior, 0 as Juros, 0 as Descontos,'
      '       COALESCE(SUM(a.valor),0) as Devolucoes,'
      
        '       0 as ChequeAVista, 0 as ChequePre, 0 as ChequeNaoIdentifi' +
        'cado,  0 as DocEntrada, 0 as DocSaida,'
      
        '       0 as Deposito, 0 as TransEntrada, 0 as TransSaida,0 as Ca' +
        'ncelamento,'
      '       0 as Perdas, 0 as Prestacoes, 0 as AjustSldDevTroca,'
      '       0 as ResgateCheque, 0 as Duplicatas,'
      
        '       0 as Cartao, 0 as pix, 0 as SaldoAtual, 0 as DevolucoesSa' +
        'ldo'
      'FROM autenticacoes a'
      'WHERE (a.tipo = '#39'N'#39') and'
      '      (a.caixa = :caixa) and'
      '      (a.data = :data) and (a.filial=:filialbase) and'
      '      Not Exists (select a1.numero'
      '                  from autenticacoes a1'
      '                  where a.numero = a1.autenticacao)'
      'union'
      '/*DevolucoesSaldo*/'
      'SELECT 0 as SaldoAnterior, 0 as Juros, 0 as Descontos,'
      
        '       0 as Devolucoes, 0 as ChequeAVista, 0 as ChequePre, 0 as ' +
        'ChequeNaoIdentificado,  0 as DocEntrada,'
      
        '       0 as DocSaida, 0 as Deposito, 0 as TransEntrada, 0 as Tra' +
        'nsSaida,'
      
        '       0 as Cancelamento, 0 as Perdas, 0 as Prestacoes, 0 as Aju' +
        'stSldDevTroca,'
      '       0 as ResgateCheque,'
      '       0 as Duplicatas, 0 as Cartao, 0 as pix, 0 as SaldoAtual,'
      '       COALESCE(SUM(a.valor),0) as DevolucoesSaldo'
      'FROM autenticacoes a'
      'WHERE (a.tipo = '#39'A'#39') and'
      '      (a.caixa = :caixa) and'
      '      (a.data = :data) and (a.filial=:filialbase) and'
      '      Not Exists (select a1.numero'
      '                  from autenticacoes a1'
      '                  where a.numero = a1.autenticacao)'
      '/*Cheque a vista */'
      'union'
      
        'SELECT 0 as SaldoAnterior, 0 as Juros, 0 as Descontos, 0 as Devo' +
        'lucoes,'
      '       COALESCE(SUM(a.valor),0) as ChequeAVista,'
      
        '       0 as ChequePre, 0 as ChequeNaoIdentificado,  0 as DocEntr' +
        'ada, 0 as DocSaida, 0 as Deposito,'
      
        '       0 as TransEntrada, 0 as TransSaida, 0 as Cancelamento, 0 ' +
        'as Perdas,'
      '       0 as Prestacoes, 0 as AjustSldDevTroca,'
      
        '       0 as ResgateCheque, 0 as Duplicatas, 0 as Cartao, 0 as pi' +
        'x,'
      '       0 as SaldoAtual, 0 as DevolucoesSaldo'
      'FROM autenticacoes a, cheques c'
      'WHERE (a.cheque = c.numero) AND'
      '      (a.tipo = '#39'H'#39')        AND'
      '      (c.data >= c.vencto) and'
      '      (a.caixa = :caixa) and'
      '      (a.data = :data) and (a.filial=:filialbase) and'
      '      Not Exists (select a1.numero'
      '                  from autenticacoes a1'
      '                  where a.numero = a1.autenticacao)'
      'union'
      '/*Cheque pre-datado */'
      
        'SELECT 0 as SaldoAnterior, 0 as Juros, 0 as Descontos, 0 as Devo' +
        'lucoes,'
      '       0 as ChequeAVista,'
      
        '       COALESCE(SUM(a.valor),0) as ChequePre, 0 as ChequeNaoIden' +
        'tificado,'
      
        '       0 as DocEntrada, 0 as DocSaida, 0 as Deposito, 0 as Trans' +
        'Entrada,'
      '       0 as TransSaida,0 as Cancelamento, 0 as Perdas,'
      '       0 as Prestacoes, 0 as AjustSldDevTroca,'
      
        '       0 as ResgateCheque, 0 as Duplicatas, 0 as Cartao, 0 as pi' +
        'x,'
      '       0 as SaldoAtual, 0 as DevolucoesSaldo'
      'FROM autenticacoes a, cheques c'
      'WHERE (a.cheque = c.numero) AND'
      '      (a.tipo = '#39'H'#39')        AND'
      '      (c.data < c.vencto) and'
      '      (a.caixa = :caixa) and'
      '      (a.data = :data) and (a.filial=:filialbase) and'
      '      Not Exists (select a1.numero'
      '                  from autenticacoes a1'
      '                  where a.numero = a1.autenticacao)'
      'union'
      '/*Cheque n'#227'o-identificado */'
      
        'SELECT 0 as SaldoAnterior, 0 as Juros, 0 as Descontos, 0 as Devo' +
        'lucoes,'
      
        '       0 as ChequeAVista, 0 as  ChequePre, COALESCE(SUM(a.valor)' +
        ',0) as ChequeNaoIdentificado,'
      
