  object qryTiposRecebimentos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select '
      '       sum(r.valorlancto) as valorlancto,'
      '       tr.tiporecebimento as tipo,        '
      
        '       case when tr.tiporecebimento = '#39'B'#39' then Cast('#39'Cart'#227'o de D' +
        #233'bito'#39' as varchar(50))'
      
        '            when tr.tiporecebimento = '#39'C'#39' then Cast('#39'Cart'#227'o de C' +
        'r'#233'dito'#39' as varchar(50))'
      
        '            when tr.tiporecebimento = '#39'D'#39' then Cast('#39'Dinheiro'#39' a' +
        's varchar(50))'
      
        '            when tr.tiporecebimento = '#39'H'#39' then Cast('#39'Cheque'#39' as ' +
        'varchar(50))'
      
        '            when tr.tiporecebimento = '#39'T'#39' then Cast('#39'Cr'#233'dito de ' +
        'Troca'#39' as varchar(50))'
      
        '            when tr.tiporecebimento = '#39'P'#39' then Cast('#39'Pix'#39' as var' +
        'char(50))'
      ''
      '       end as descricaotipo          '
      ''
      'from recebimentos r'
      '     join tiposrecebimentos tr'
      '     on r.tiporecebimento = tr.codigo'
      ''
      'where r.tiporecebimento = tr.codigo'
      ' and cast(r.datalancto as date)= :data'
      ' and r.filial = :filial'
      ' and r.situacao = '#39'N'#39
      ' and exists (select a.caixa, a.data, a.filial'
      '              from autenticacoes a'
      '              where a.filial = :filial'
      '                and a.caixa = :caixa'
      '                and a.data = :data'
      '                and a.transacao = r.transacao'
      '              limit 1)'
      ''
      'group by tr.tiporecebimento'
      'order by tr.tiporecebimento')
    RequestLive = False
    Left = 416
    Top = 304
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'data'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'caixa'
        ParamType = ptUnknown
      end>
