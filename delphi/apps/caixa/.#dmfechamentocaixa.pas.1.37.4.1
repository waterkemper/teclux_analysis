  procedure ImprimirLinha(texto: String;posicao: integer); overload;
  begin
    if a = 1 then
    begin
      if (texto = '') then
        vRelatorio.Append(stringOfChar(' ', MaxCol))
      else
        vRelatorio.Append(texto);
    end;

    if (texto = '') then
      TextPrinter.writeln
    else
      TextPrinter.WriteTextln(texto, posicao);
  end;

  procedure Alinhar(Tipo: TAlignment; PosAtual: Integer = 0);
  begin
    case Tipo of
      taCenter: Insert(stringOfChar(' ', (MaxCol - Length(linha)) div 2), Linha, 1);
      taRightJustify: Insert(stringOfChar(' ', MaxCol - Length(linha) - PosAtual), Linha, 1);
    end
  end;

  procedure ImprimirLinha(texto, TextoFinal: String; posicao: integer); overload;
  var
    vTexto : String;
    vPosIni, vPosFinal : integer;
    vTextoFinalImpresso : boolean;

  begin
    vTextoFinalImpresso := false;
    vPosIni   := posicao+1;
    vPosFinal := maxcol;
    vTexto := copy(texto,vPosIni, vPosfinal);
    while true do
    begin
      if (length(vTexto)+length(TextoFinal)) <= maxcol then
      begin
       Comp := length(vTexto);
       Linha := TextoFinal;
       Alinhar(taRightJustify, Comp);
       vTexto := vTexto + linha;
       vTextoFinalImpresso := true;
      end;
      ImprimirLinha(vTexto, 0);
      if vTextoFinalImpresso then
        break
      else
      begin
        vPosIni := vPosIni + vPosfinal;
        vPosFinal := vPosFinal+1 + vPosfinal;
        vTexto := copy(texto,vPosIni, vPosfinal);
      end;
    end;
  end;

