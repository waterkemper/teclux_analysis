    NomeImpressoraEscolhida := '';
    Result := True;
    if (impressora = '') then
    begin
      if FVisualizar then
      begin
        limparDataSet;
        preencheDataSet(vRelatorio);
        VisualizarRelatorio;
      end
      else
      if Assigned(ECFPadrao) then
        ECFPadrao.RelatorioGerencial(vRelatorio);
    end;
  finally
    vrelatorio.free;
  end
end;


