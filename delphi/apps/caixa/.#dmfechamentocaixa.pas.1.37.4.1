  procedure ImprimirTransferencias;
  const
    WhereTipo =  'and (((a.tipo = %s) and not a.entradapendente and confirmacao) OR (a.tipo = %s))';
  begin
    qryAutenticacoes.MacroByName('WHERETIPO').AsString := Format(WhereTipo,['''S''','''E''']);
    qryAutenticacoes.open;
    if not qryAutenticacoes.IsEmpty then begin
      vvalor := 0;
      qryAutenticacoes.First;
      Comp := maxcol div 2 - length('TRANSFERENCIAS') div 2;
      Linha := StringOfChar('-', comp) + 'TRANSFERENCIAS' + StringOfChar('-', comp-1);
      ImprimirLinha(Linha,0);

      ImprimirLinha('LANCTO CAIXA ', 'VALOR', 0);
      ImprimirLinha(StringOfChar('-', MaxCol),0);
      while not qryAutenticacoes.Eof do begin
        ImprimirLinhaTransferencia;
        if qryAutenticacoestipo.AsString='S' then
          vvalor := vvalor + (-qryAutenticacoesValor.AsFloat)
        else
          vvalor := vvalor + qryAutenticacoesValor.AsFloat;
        qryAutenticacoes.Next;
      end;
      Linha := 'TOTAL ' + format('%14s',[trim(Trocar(Trocar(Format('%11.2m',[vvalor]),'R',''),'$',''))]);
      Alinhar(taRightJustify);
      ImprimirLinha(Linha, 0);
      
      TextPrinter.writeln;
    end;
    qryAutenticacoes.MacroByName('WHERETIPO').AsString := 'and (a.tipo  = ''S'')';
    qryAutenticacoes.Close;
  end;

  procedure ImprimirTransferenciasPendentes;
  const
    WhereTipo =  'and ((a.tipo  = %s) and a.entradapendente)';
  begin
    qryAutenticacoes.MacroByName('WHERETIPO').AsString := Format(WhereTipo,['''S''']);
    qryAutenticacoes.open;
    if not qryAutenticacoes.IsEmpty then begin
      qryAutenticacoes.First;
      Comp := maxcol div 2 - length('TRANSFERENCIAS PENDENTES') div 2;
      Linha := StringOfChar('-', comp) + 'TRANSFERENCIAS PENDENTES' + StringOfChar('-', comp-1);
      ImprimirLinha('LANCTO CAIXA','VALOR',0);
      ImprimirLinha(StringOfChar('-', MaxCol),0);
      while not qryAutenticacoes.Eof do begin
        ImprimirLinhaTransferencia;
        qryAutenticacoes.Next;
      end;

      TextPrinter.writeln;
    end;
    qryAutenticacoes.MacroByName('WHERETIPO').AsString := 'and (a.tipo  = ''S'')';
    qryAutenticacoes.Close;
  end;


