function TdtmFechamentoCaixa.GetSaldoAtual: Real;
begin
  Result := qryTotalizacoesCaixasaldoanterior.AsFloat
            + qryTotalizacoesCaixaprestacoes.AsFloat
            + qryTotalizacoesCaixadocentrada.AsFloat
            + qryTotalizacoesCaixatransentrada.AsFloat
