  qryRecebimentos.Tag := ctcaixaFechamento;

  qryEventos.Tag := ctcaixaFechamento;
  cdsRelatorio.open;

  FilialFechamento := filialbase;
End;

function TdtmFechamentoCaixa.ExisteCaixa(Campo, Codigo: string): Boolean;
begin
  Result:= ExisteCodigo(qryConsultaCaixas, Campo, Codigo);
end;

function TdtmFechamentoCaixa.Fecharcaixa(DataFechamento: TDateTime; Impressora: String): Boolean;
begin
  Result := ImprimirFechamento(DateToStr(DataFechamento), Impressora);
  if Result then
    Result := UsuarioLogin.FecharCaixa(DataFechamento);

  if result then
    if UsuarioLogin.GerenteCaixa then
      result := SalvarEventos;
end;

