function TdtmFechamentoCaixa.SalvarEventos: Boolean;
var
  UsuarioAut: TtecUsuarios;
begin
  result := false;
  UsuarioAut := ObterAutorizacao(taSENHA, ctPARAALTERACAOEVENTOCAIXA, ctGERENTECAIXA, '');
  if Assigned(UsuarioAut) then
  begin
    Result := UsuarioAut.GerenteCaixa;
    if Not Result then
        MensagemAviso(ctUSUARIOSEMPERMISSAO);
  end;

  if result then
  begin
    qryEventos.BeforePost := nil;
    GuardarRegistroAtual(qryEventos,false);
    qryEventos.First;
    while not qryEventos.Eof do
    begin
      if qryEventosalterado.AsBoolean then
      begin
        qryUpdateAutenticacoesEventos.ParamByName('numero').AsInteger := qryEventosnumero.AsInteger;
        qryUpdateAutenticacoesEventos.ParamByName('evento').AsInteger := qryEventosevento.AsInteger;
        qryUpdateAutenticacoesEventos.ParamByName('parametros').AsString := qryEventosparametros.AsString;
        qryUpdateAutenticacoesEventos.ExecSql;
        qryEventos.Edit;
        qryEventosalterado.AsBoolean := false;
        qryEventos.Post;
      end;
      qryEventos.Next;
    end;
    VoltarRegistroAtual(qryEventos);
    qryEventos.BeforePost := qryEventosBeforePost;
//    if qryUpdateAutenticacoesEventos.UpdatesPending then
      result := Perpetrar([qryUpdateAutenticacoesEventos]);

    if result then
      if assigned(EventosAfterOpen) then
         EventosAfterOpen(qryEventos);
  end;       
end;


end.
