    TextPrinter.writeln;
    TextPrinter.writeln;
    TextPrinter.writeln;
    TextPrinter.writeln;
    TextPrinter.writeln;

    TextPrinter.EndDoc('TecLUX - Imprimindo Fechamento de Caixa.');
    NomeImpressoraEscolhida := '';
    Result := True;
    if FVisualizar then
    begin
      limparDataSet;
      preencheDataSet;
      VisualizarRelatorio;
    end;
  finally
  end
end;


Procedure TdtmFechamentoCaixa.MontarFechamentoCaixa(Caixa, DataFec: String);
Begin
  qryTotalizacoesCaixa.Params[0].AsString := Caixa;
  qryTotalizacoesCaixa.Params[1].AsString := DataFec;
  qryTotalizacoesCaixa.Params[2].Asinteger := filialbase;

  qryEventos.Params[0].AsString := Caixa;
  qryEventos.Params[1].AsString := DataFec;
  qryEventos.Params[2].Asinteger := filialbase;

End;

procedure TdtmFechamentoCaixa.Selecionar;
Begin
  ReFazConsulta(qryCaixas,[0],[qryConsultaCaixascodigo.AsVariant]);
End;

procedure TdtmFechamentoCaixa.SelecionarcaixaAtual;
begin
  ReFazConsulta(qryCaixas, [0], [CodigoUsuario])
end;

function TdtmFechamentoCaixa.TransferenciaNaoConfirmada: Boolean;
begin
  ReFazConsulta(qryTransferenciaNaoConfirmada, [0], [qryCaixascodigo.AsInteger]);
  Result := qryTransferenciaNaoConfirmada.RecordCount > 0;
end;

