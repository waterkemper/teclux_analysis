  procedure ImprimirCancelamento;
  const
    WhereCancelamento =  'and ((a.numero in (SELECT a1.autenticacao '+
                                       'FROM autenticacoes a1 '+
                                       'WHERE a1.autenticacao=a.numero)) '+
                          'OR (a.tipo = %s))';
  begin
     qryAutenticacoes.MacroByName('WhereBase').AsString := '';
     qryAutenticacoes.MacroByName('WhereTipo').AsString := 'and (a.tipo  = ''C'')';
     qryAutenticacoes.MacroByName('OUTROSFILTROS').AsString := format(WhereCancelamento,['''C''']);
     qryAutenticacoes.open;
     if not qryAutenticacoes.IsEmpty then begin
       qryAutenticacoes.First;
       vvalor := 0;
       Comp := maxcol div 2 - length('CANCELAMENTOS') div 2;
       Linha := StringOfChar('-', comp) + 'CANCELAMENTOS' + StringOfChar('-', comp-1);
       TextPrinter.WriteTextln(Linha,0);
       if MaxCol = 54 then
         Linha := 'LANCTO LANCTO CANCELADO   MOTIVO                 VALOR'
       else
         Linha := 'LANCTO LANCTO CANCELADO     MOTIVO                   VALOR';
       TextPrinter.WriteTextln(Linha,0);
       TextPrinter.WriteTextln(StringOfChar('-', MaxCol),0);
       while not qryAutenticacoes.Eof do begin
         if qryAutenticacoestipo.asstring = 'P' then
           ImprimirLinhaRecebimentos
         else if qryAutenticacoestipo.asstring = 'D' then
           ImprimirLinhaDocumentos
         else if qryAutenticacoestipo.asstring = 'N' then
           ImprimirLinhaDevolucoes
         else if qryAutenticacoestipo.AsString = 'A' then
           ImprimirLinhaDevolucoesSaldo
         else if qryAutenticacoestipo.asstring = 'B' then
           ImprimirLinhaDepositos
         else if qryAutenticacoestipo.asstring = 'H' then
           ImprimirLinhaCheques
         else if qryAutenticacoestipo.asstring = 'S' then
           ImprimirLinhaTransferencia
         else if qryAutenticacoestipo.asstring = 'E' then
           ImprimirLinhaTransferencia
         else if qryAutenticacoestipo.asstring = 'J' then
           ImprimirLinhaPerdas
         else if qryAutenticacoestipo.asstring = 'R' then
           ImprimirLinhaCheques
         else if qryAutenticacoestipo.asstring = 'G' then
           ImprimirLinhaDuplicatas
         else if qryAutenticacoestipo.asstring = 'C' then begin
           if MaxCol = 54 then
             Linha := format('%6s', [qryAutenticacoesnumero.AsString]) + ' ' +
                   'CANCEL. ' +
                   format('%-5s', [qryAutenticacoesautenticacao.AsString]) + ' ' +
                   format('%2s', [qryAutenticacoesmotivo.AsString]) + ' ' +
                   format('%-20s', [qryAutenticacoesdescricaomotivo.AsString])
           else
             Linha := format('%6s', [qryAutenticacoesnumero.AsString]) + ' ' +
                     'CANCELAMENTO ' +
                     format('%-5s', [qryAutenticacoesautenticacao.AsString]) + ' ' +
                     format('%2s', [qryAutenticacoesmotivo.AsString]) + ' ' +
                     format('%-20s', [qryAutenticacoesdescricaomotivo.AsString]);
           TextPrinter.WriteText(Linha,0);
           Comp := length(Linha);
           Linha := trim(Trocar(Trocar(Format('%9.2m',[qryAutenticacoesValor.AsFloat]),'R',''),'$',''));
           vvalor := vvalor + qryAutenticacoesValor.AsFloat;
           Alinhar(taRightJustify, comp);
           TextPrinter.WriteTextln(Linha, 0);
         end;
         qryAutenticacoes.Next;
       end;
       TextPrinter.writeln;
     end;
     qryAutenticacoes.Close;
     qryAutenticacoes.MacroByName('WhereBase').AsString := WhereNotCancelado;
     qryAutenticacoes.MacroByName('WhereTipo').AsString := 'and (a.tipo  = ''C'')';
     qryAutenticacoes.MacroByName('OUTROSFILTROS').AsString := '';
  end;

