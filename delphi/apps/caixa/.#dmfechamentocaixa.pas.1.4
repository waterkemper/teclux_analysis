  begin
    qryResumoVendas.Params[3].AsString := 'P';
    qryResumoVendas.open;
    if not qryResumoVendas.IsEmpty then begin
      vvencto := 0;
      vjuros := 0;
      vdescontos := 0;
      qryResumoVendas.First;
      Comp := maxcol div 2 - length('RESUMO POR FILIAL DE VENDA') div 2;
      Linha := StringOfChar('-', comp) + 'RESUMO POR FILIAL DE VENDA' + StringOfChar('-', comp);
      TextPrinter.WriteTextln(Linha,0);
      if MaxCol = 54 then
        Linha := 'FILIAL DE VENDA           PRESTACOES    JUROS  DESCONTOS'
      else
        Linha := 'FILIAL DE VENDA              PRESTACOES     JUROS  DESCONTOS';
      TextPrinter.WriteTextln(Linha,0);
      TextPrinter.WriteTextln(StringOfChar('-', MaxCol),0);
      while not qryResumoVendas.Eof do begin
        ImprimirLinhaResumoVendas;
        vvencto := vvencto + qryResumoVendasValorVenctoParcela.AsFloat;
        vjuros := vjuros + qryResumoVendasjuros.AsFloat;
        vdescontos := vdescontos + qryResumoVendasdescontos.AsFloat;
        qryResumoVendas.Next;
      end;
      Linha :='TOTAL ' +format('%12s',[trim(Trocar(Trocar(Format('%9.2m',[vvencto]),'R',''),'$',''))])+
                        format('%10s',[trim(Trocar(Trocar(Format('%7.2m',[vjuros]),'R',''),'$',''))])+
                        format('%11s',[trim(Trocar(Trocar(Format('%8.2m',[vdescontos]),'R',''),'$',''))]);
      Alinhar(taRightJustify);
      TextPrinter.WriteTextln(Linha, 0);
      TextPrinter.writeln;
    end;
    qryResumoVendas.Close;
  end;

  procedure ImprimirResumoRenegociados;
  var
    R_Prestacoes,
    R_ValorPago,
    O_Prestacoes,
    O_ValorPago : Double;
  begin
    R_Prestacoes := 0;
    R_ValorPago := 0;
    O_Prestacoes := 0;
    O_ValorPago := 0;
    qryRenegociado.Params[3].AsString := 'P';
    qryRenegociado.open;
    if not qryRenegociado.IsEmpty then begin
      qryRenegociado.First;
      Comp := maxcol div 2 - length('RESUMO DAS RENEGOCIACOES') div 2;
      Linha := StringOfChar('-', comp) + 'RESUMO DAS RENEGOCIACOES' + StringOfChar('-', comp);
      TextPrinter.WriteTextln(Linha,0);
      Linha :='          R E N E G O C I A D O           O R I G E M';
      TextPrinter.WriteTextln(Linha,0);
      Linha :='LANCTO   PRESTACOES   VLR.PAGO  PRESTACOES  VALOR PAGO';
      TextPrinter.WriteTextln(Linha,0);
      TextPrinter.WriteTextln(StringOfChar('-', MaxCol),0);
      while not qryRenegociado.Eof do begin
        ImprimirLinhaResumoRenegociados;
        R_Prestacoes := R_Prestacoes + qryRenegociadovalorvencto.AsFloat;
        R_ValorPago := R_ValorPago + qryRenegociadovalor.AsFloat;
        O_Prestacoes := O_Prestacoes + qryOrigemvalorvencto.AsFloat;
        O_ValorPago := O_ValorPago + qryOrigemvalorpagto.AsFloat;
        qryRenegociado.Next;
      end;
      Linha :='TOTAL ' +format('%12s',[trim(Trocar(Trocar(Format('%9.2m',[R_Prestacoes]),'R',''),'$',''))])+
                        format('%12s',[trim(Trocar(Trocar(Format('%10.2m',[R_ValorPago]),'R',''),'$',''))])+
                        format('%12s',[trim(Trocar(Trocar(Format('%11.2m',[O_Prestacoes]),'R',''),'$',''))])+
                        format('%12s',[trim(Trocar(Trocar(Format('%11.2m',[O_ValorPago]),'R',''),'$',''))]);
      Alinhar(taRightJustify);
      TextPrinter.WriteTextln(Linha, 0);
      TextPrinter.writeln;
    end;
    qryRenegociado.Close;
  end;


  procedure ImprimirTransferencias;
  const
    WhereTipo =  'and (((a.tipo = %s) and not a.entradapendente and confirmacao) OR (a.tipo = %s))';
  begin
    qryAutenticacoes.MacroByName('WHERETIPO').AsString := Format(WhereTipo,['''S''','''E''']);
    qryAutenticacoes.open;
    if not qryAutenticacoes.IsEmpty then begin
      vvalor := 0;
      qryAutenticacoes.First;
      Comp := maxcol div 2 - length('TRANSFERENCIAS') div 2;
      Linha := StringOfChar('-', comp) + 'TRANSFERENCIAS' + StringOfChar('-', comp-1);
      TextPrinter.WriteTextln(Linha,0);
      if MaxCol = 54 then
        Linha := 'LANCTO CAIXA                                     VALOR'
      else
        Linha := 'LANCTO CAIXA                                         VALOR';
      TextPrinter.WriteTextln(Linha,0);
      TextPrinter.WriteTextln(StringOfChar('-', MaxCol),0);
      while not qryAutenticacoes.Eof do begin
        ImprimirLinhaTransferencia;
        if qryAutenticacoestipo.AsString='S' then
          vvalor := vvalor + (-qryAutenticacoesValor.AsFloat)
        else
          vvalor := vvalor + qryAutenticacoesValor.AsFloat;
        qryAutenticacoes.Next;
      end;
      Linha := 'TOTAL ' + format('%14s',[trim(Trocar(Trocar(Format('%11.2m',[vvalor]),'R',''),'$',''))]);
      Alinhar(taRightJustify);
      TextPrinter.WriteTextln(Linha, 0);
      TextPrinter.writeln;
    end;
    qryAutenticacoes.MacroByName('WHERETIPO').AsString := 'and (a.tipo  = ''S'')';
    qryAutenticacoes.Close;
  end;

  procedure ImprimirTransferenciasPendentes;
  const
    WhereTipo =  'and ((a.tipo  = %s) and a.entradapendente)';
