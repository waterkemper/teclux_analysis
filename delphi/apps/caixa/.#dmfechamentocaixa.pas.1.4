const
WhereBase = 51;
WhereParametroTipo = WhereBase+1;
WhereOutrosFiltros = WhereBase+2;


{$R *.dfm}

{ tipos de autenticacoes
    P - Prestações
    D - Documento
    N - Devoluções
    A - Devolucoes de saldo de troca
    B - Deposito
    C - Cancelamento
    H - Cheques
    S - Transferência de saida
    E - Transferência de entrada
    J - Perdas
    R - Resgate de cheque
    G - Duplicatas
    T - Cartao de Credito/Debito
    F - Frente de Caixa
}
Constructor TdtmFechamentoCaixa.create(AOwner: TComponent);
Begin
  inherited;
  qryCaixas.Tag:=  ctTabelas;
  qryConsultaCaixas.Tag:= ctCaixaConsultaCaixas;
  qryTotalizacoesCaixa.Tag := ctcaixaFechamento;
  qryEventos.Tag := ctcaixaFechamento;
  cdsRelatorio.open;
End;

function TdtmFechamentoCaixa.ExisteCaixa(Campo, Codigo: string): Boolean;
begin
  Result:= ExisteCodigo(qryConsultaCaixas, Campo, Codigo);
end;

function TdtmFechamentoCaixa.Fecharcaixa(DataFechamento: TDateTime; Impressora: String): Boolean;
begin
  Result := ImprimirFechamento(DateToStr(DataFechamento), Impressora);
  if Result then
    Result := UsuarioLogin.FecharCaixa(DataFechamento);

  if result then
    if UsuarioLogin.GerenteCaixa then
      result := SalvarEventos;
end;

function TdtmFechamentoCaixa.GetAssinatura1: String;
begin
  Result := ParSistema.Assinatura1
end;

function TdtmFechamentoCaixa.GetAssinatura2: String;
begin
  Result := ParSistema.Assinatura2
end;

function TdtmFechamentoCaixa.GetAssinatura3: String;
begin
  Result := ParSistema.Assinatura3
end;

function TdtmFechamentoCaixa.GetNumeroCopias: String;
begin
  Result := IntToStr(ParSistema.NumeroCopias)
end;

function TdtmFechamentoCaixa.GetSaldoAtual: Real;
begin
  Result := qryTotalizacoesCaixasaldoanterior.AsFloat
            + qryTotalizacoesCaixaprestacoes.AsFloat
            + qryTotalizacoesCaixadocentrada.AsFloat
            + qryTotalizacoesCaixatransentrada.AsFloat
            + qryTotalizacoesCaixaresgatecheque.AsFloat
            + qryTotalizacoesCaixafrentecaixa.AsFloat
            - qryTotalizacoesCaixadevolucoes.AsFloat
            - qryTotalizacoesCaixadevolucoessaldo.AsFloat
            - qryTotalizacoesCaixadeposito.AsFloat
            - qryTotalizacoesCaixadocsaida.AsFloat
            - qryTotalizacoesCaixatranssaida.AsFloat;
end;

function TdtmFechamentoCaixa.GetTabelaConsultarCaixa: TtecQuery;
begin
  Result:= qryConsultaCaixas;
end;

function TdtmFechamentoCaixa.ImprimirFechamento(DataFechamento: String; Impressora: String): Boolean;
begin
  Result := ImprimirFechamento(DataFechamento, ParSistema.Cancelamentos,
                                               ParSistema.ChequePrazo,
                                               ParSistema.ChequeVista,
                                               ParSistema.Depositos,
                                               ParSistema.Devolucoes,
                                               ParSistema.DevolucoesSaldo,
                                               ParSistema.Documentos,
                                               ParSistema.Duplicatas,
                                               ParSistema.Perdas,
                                               ParSistema.Recebimentos,
                                               ParSistema.ResgateDeCheques,
                                               ParSistema.Resumo,
                                               ParSistema.Transferencias, True, Impressora)
end;

function  TdtmFechamentoCaixa.ImprimirFechamento(DataFechamento: String;
                                 Cancelamentos, ChequePrazo,
                                 ChequeaVista, Depositos,
                                 Devolucoes, DevolucoesSaldo,
                                 Documentos, Duplicatas,
                                 Perdas, Recebimentos,
                                 ResgateDeCheques, Resumo,
                                 Transferencias,
                                 ImprimirDetalhes: Boolean;
                                 Impressora: String): Boolean;
const
  WhereNotCancelado = 'and (Not Exists (SELECT a1.autenticacao FROM autenticacoes a1 WHERE a1.autenticacao=a.numero))';

var
  Linha: String;
  a, b, Comp, MaxCol: Integer;
  vvalor, vvencto, vjuros, vdescontos: double;

  procedure Alinhar(Tipo: TAlignment; PosAtual: Integer = 0);
  begin
    case Tipo of
      taCenter: Insert(stringOfChar(' ', (MaxCol - Length(linha)) div 2), Linha, 1);
      taRightJustify: Insert(stringOfChar(' ', MaxCol - Length(linha) - PosAtual), Linha, 1);
    end
  end;

  procedure ImprimirLinhaRecebimentos;
  begin
    if MaxCol = 54 then
      Linha :=format('%6s', [qryAutenticacoesnumero.AsString]) + ' ' +
            format('%-11s',[qryAutenticacoestipocliente.AsString+qryAutenticacoescliente.AsString])+ ' ' +
            format('%3s', [qryAutenticacoesparcela.AsString])+' '+
            format('%12s',[trim(Trocar(Trocar(Format('%9.2m',[qryAutenticacoesValorVenctoParcela.AsFloat]),'R',''),'$',''))])+
            format('%10s',[trim(Trocar(Trocar(Format('%7.2m',[(qryAutenticacoesValor.AsFloat-
                                                          qryAutenticacoesValorVenctoParcela.AsFloat)]),'R',''),'$',''))])
    else
      Linha :=format('%6s', [qryAutenticacoesnumero.AsString]) + ' ' +
              format('%-11s',[qryAutenticacoestipocliente.AsString+qryAutenticacoescliente.AsString])+ ' ' +
              format('%3s', [qryAutenticacoescaixa.AsString])+ ' ' +
              format('%3s', [qryAutenticacoesparcela.AsString])+' '+
              format('%12s',[trim(Trocar(Trocar(Format('%9.2m',[qryAutenticacoesValorVenctoParcela.AsFloat]),'R',''),'$',''))])+
              format('%10s',[trim(Trocar(Trocar(Format('%7.2m',[(qryAutenticacoesValor.AsFloat-
                                                            qryAutenticacoesValorVenctoParcela.AsFloat)]),'R',''),'$',''))]);
    TextPrinter.writeText(Linha,0);
    Comp := length(Linha);
    Linha :=trim(Trocar(Trocar(Format('%9.2m',[qryAutenticacoesValor.AsFloat]),'R',''),'$',''));
    Alinhar(taRightJustify,Comp);
    TextPrinter.WriteTextln(Linha, 0);
  end;

  procedure ImprimirLinhaDocumentos;
  begin
    Linha :=format('%6s', [qryAutenticacoesnumero.AsString]) + ' ' +
            format('%3s', [qryAutenticacoesevento.AsString])+ ' ' +
            format('%-32s', [qryAutenticacoesdescricaoevento.AsString]);
    TextPrinter.writeText(Linha,0);
    Comp := length(Linha);
    if MaxCol = 54 then
      Linha :=trim(Trocar(Trocar(Format('%11.2m',[qryAutenticacoesValor.AsFloat]),'R',''),'$',''))
    else
      Linha :=trim(Trocar(Trocar(Format('%14.2m',[qryAutenticacoesValor.AsFloat]),'R',''),'$',''));
    Alinhar(taRightJustify, comp);
    TextPrinter.WriteTextln(Linha, 0);
  end;

  procedure ImprimirLinhaDevolucoes;
  begin
    if MaxCol = 54 then
      Linha :=format('%6s', [qryAutenticacoesnumero.AsString]) + ' ' +
            format('%-11s',[qryAutenticacoestipocliente.AsString+qryAutenticacoescliente.AsString])+ ' ' +
            format('%2s', [qryAutenticacoesmotivo.AsString])+ ' ' +
            format('%-19s',[qryAutenticacoesdescricaomotivo.AsString])
    else
      Linha :=format('%6s', [qryAutenticacoesnumero.AsString]) + ' ' +
              format('%-11s',[qryAutenticacoestipocliente.AsString+qryAutenticacoescliente.AsString])+ ' ' +
              format('%3s', [qryAutenticacoescaixa.AsString])+ ' ' +
              format('%2s', [qryAutenticacoesmotivo.AsString])+ ' ' +
              format('%-19s',[qryAutenticacoesdescricaomotivo.AsString]);
    TextPrinter.writeText(Linha,0);
    Comp := length(Linha);
    Linha :=trim(Trocar(Trocar(Format('%9.2m',[qryAutenticacoesValor.AsFloat]),'R',''),'$',''));
    Alinhar(taRightJustify, comp);
    TextPrinter.WriteTextln(Linha, 0);
  end;

  procedure ImprimirLinhaDevolucoesSaldo;
  begin
    if MaxCol = 54 then
      Linha :=format('%6s', [qryAutenticacoesnumero.AsString]) + ' ' +
              format('%-8s',[qryAutenticacoestipoclientedev.AsString+qryAutenticacoesclientedev.AsString]) +
              Format('%-24s',[qryAutenticacoesnomeclientedev.AsString])
    else
      Linha :=format('%6s', [qryAutenticacoesnumero.AsString]) + ' ' +
              format('%-11s',[qryAutenticacoestipoclientedev.AsString+qryAutenticacoesclientedev.AsString]) +
              Format('%21s',[qryAutenticacoesnomeclientedev.AsString]) + ' ' +
              format('%3s', [qryAutenticacoescaixa.AsString]);
    TextPrinter.writeText(Linha,0);
    Comp := length(Linha);
    Linha :=trim(Trocar(Trocar(Format('%9.2m',[qryAutenticacoesValor.AsFloat]),'R',''),'$',''));
    Alinhar(taRightJustify, comp);
    TextPrinter.WriteTextln(Linha, 0);
  end;

  procedure ImprimirLinhaCheques;
  begin
    Linha :=format('%6s', [qryAutenticacoesnumero.AsString]) + ' ' +
            format('%-11s',[qryAutenticacoestipocliente.AsString+qryAutenticacoescliente.AsString])+ ' ' +
            copy(qryAutenticacoescheque.AsString,12,6)+ ' ' +
            copy(qryAutenticacoescheque.AsString,4,4)+ ' ' +
            copy(qryAutenticacoescheque.AsString,1,3)+ ' ' +
            qryAutenticacoesvenctocheque.AsString;
    TextPrinter.writeText(Linha,0);
    Comp := length(Linha);
    Linha :=trim(Trocar(Trocar(Format('%12.2m',[qryAutenticacoesValor.AsFloat]),'R',''),'$',''));
    Alinhar(taRightJustify, comp);
    TextPrinter.WriteTextln(Linha, 0);
  end;

  procedure ImprimirLinhaDepositos;
  begin
     Linha := format('%6s', [qryAutenticacoesnumero.AsString]) + ' ' +
              qryAutenticacoesnomebanco.AsString;
     TextPrinter.WriteText(Linha,0);
     Comp := length(Linha);
     Linha := trim(Trocar(Trocar(Format('%9.2m',[qryAutenticacoesValor.AsFloat]),'R',''),'$',''));
     Alinhar(taRightJustify, comp);
     TextPrinter.WriteTextln(Linha, 0);
  end;

  procedure ImprimirLinhaPerdas;
  begin
    if MaxCol = 54 then
      Linha := format('%6s', [qryAutenticacoesnumero.AsString]) + ' ' +
               format('%-11s',[qryAutenticacoestipocliente.AsString+qryAutenticacoescliente.AsString])+ ' ' +
               format('%2s', [qryAutenticacoesmotivo.AsString])+ ' ' +
               format('%-19s',[qryAutenticacoesdescricaomotivo.AsString]) + ' '
    else
      Linha := format('%6s', [qryAutenticacoesnumero.AsString]) + ' ' +
               format('%-11s',[qryAutenticacoestipocliente.AsString+qryAutenticacoescliente.AsString])+ ' ' +
               format('%3s', [qryAutenticacoescaixa.AsString])+ ' ' +
               format('%2s', [qryAutenticacoesmotivo.AsString])+ ' ' +
               format('%-19s',[qryAutenticacoesdescricaomotivo.AsString]);
    TextPrinter.WriteText(Linha,0);
    Comp := length(Linha);
    Linha := trim(Trocar(Trocar(Format('%9.2m',[qryAutenticacoesValor.AsFloat]),'R',''),'$',''));
    Alinhar(taRightJustify, comp);
    TextPrinter.WriteTextln(Linha, 0);
  end;

  procedure ImprimirLinhaTransferencia;
  var
    caixa : String;
    valor : double;
  begin
    if qryAutenticacoestipo.asstring = 'S' then begin
      caixa := qryAutenticacoestransferencia.AsString;
      valor := -qryAutenticacoesValor.AsFloat;
    end else begin
      caixa := qryAutenticacoescaixa.AsString;
      valor := qryAutenticacoesValor.AsFloat;
    end;
    Linha :=format('%6s', [qryAutenticacoesnumero.AsString]) + ' ' +
            format('%3s', [caixa])+ ' ' +
            format('%-31s', [qryAutenticacoesnomecaixa.AsString]) + ' ';
    TextPrinter.writeText(Linha,0);
    Comp := length(Linha);
    if MaxCol = 54 then
      Linha :=trim(Trocar(Trocar(Format('%11.2m',[valor]),'R',''),'$',''))
    else
      Linha :=trim(Trocar(Trocar(Format('%14.2m',[valor]),'R',''),'$',''));
    Alinhar(taRightJustify, comp);
    TextPrinter.WriteTextln(Linha, 0);
  end;

  procedure ImprimirLinhaResumoVendas;
  begin
    if MaxCol = 54 then
      Linha :=format('%2s', [qryResumoVendasfilialvenda.AsString]) + ' ' +
            format('%-20s', [qryResumoVendasnomefilialvenda.AsString]) +
            format('%11s',[trim(Trocar(Trocar(Format('%9.2m',[qryResumoVendasValorVenctoParcela.AsFloat]),'R',''),'$',''))])+
            format('%10s',[trim(Trocar(Trocar(Format('%7.2m',[qryResumoVendasJuros.AsFloat]),'R',''),'$',''))]) + ' '
    else
      Linha :=format('%3s', [qryResumoVendasfilialvenda.AsString]) + ' ' +
              format('%-23s', [qryResumoVendasnomefilialvenda.AsString]) +
              format('%12s',[trim(Trocar(Trocar(Format('%9.2m',[qryResumoVendasValorVenctoParcela.AsFloat]),'R',''),'$',''))])+
              format('%10s',[trim(Trocar(Trocar(Format('%7.2m',[qryResumoVendasJuros.AsFloat]),'R',''),'$',''))]) + ' ';

    TextPrinter.writeText(Linha,0);
    Comp := length(Linha);
    Linha :=trim(Trocar(Trocar(Format('%9.2m',[qryResumoVendasDescontos.AsFloat]),'R',''),'$',''));
    Alinhar(taRightJustify,Comp);
    TextPrinter.WriteTextln(Linha, 0);
  end;

  procedure ImprimirLinhaResumoRenegociados;
