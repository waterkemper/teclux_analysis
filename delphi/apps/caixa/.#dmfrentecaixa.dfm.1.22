      FieldName = 'aliquotaicms'
      DisplayFormat = '0.00'
    end
    object qryProdutoincidencia: TStringField
      FieldName = 'incidencia'
      Size = 50
    end
    object qryProdutopercreducaobase: TFloatField
      FieldName = 'percreducaobase'
      DisplayFormat = '0.00'
    end
    object qryProdutoorigem: TIntegerField
      FieldName = 'origem'
      DisplayFormat = '0'
    end
