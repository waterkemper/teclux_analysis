      '       c.dependentes,'
      '       c.onus,'
      '       c.primogenito,'
      '       c.pedidocliente,'
      '       (select c2.numero'
      '        from   contratos c2'
      '        where  (c2.origem = c.numero)) as renegociado'
      'from contratos c'
      'where c.numero =:numero'
      '/*          NAO ALTERAR A ORDEM DOS CAMPOS   */')
