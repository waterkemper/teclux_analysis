  object qryProduto: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select p.codigo,'
      
        '          cast(p.descricao||'#39' '#39'||coalesce(p.valorgrade1,'#39#39')||'#39' '#39 +
        '||coalesce(p.valorgrade2,'#39#39') as varchar) as descricao,'
      '          estoques_preco(p.codigo, :FilialBase) as preco,'
      
        '          (select pdc.codigobarras from produtoscodigobarras pdc' +
        ' where pdc.produto = p.codigo limit 1) as codigobarrasext,'
      
        '          estoques_produtoempromocao(p.codigo, :FilialBase) as p' +
        'romocao,'
      '          p.caracteristica,'
      '          c.unidade,'
      '          (select ei.valor'
      '           from estadosicms ei'
      '           where (ei.estado = :EstadoFilialBase) and'
      '                      (ei.icms = c.icms)'
      '          ) as aliquotaicms,'
      ''
      '          (select i.aliquota'
      '           from ipi i'
      '           where i.codigo = c.ipi) as aliquotaipi,'
      ''
      '          (select t.valor'
      '           from tributosicms t'
      '           where t.codigo = c.incidencia) as incidencia,'
      '           c.csosn,'
      '           c.origem,'
      '          c.percreducaobase,'
      ''
      '          c.brinde,'
      '          c.composto,'
      '          c.producaopropria,'
      ''
      ''
      ''
      '         (select ncm.aliqnacional'
      '          from ncmtabela ncm'
      '          where (ncm.codigotipi, coalesce(ncm.extipi,'#39#39')) in'
      
        '                                         (select ipi.classificac' +
        'aofiscal, coalesce(ipi.extipi,'#39#39')'
      '                                          from ipi'
      
        '                                          where ipi.codigo = c.i' +
        'pi)) as aliqnacional,'
      ''
      '         (select ncm.aliqimportado'
      '          from ncmtabela ncm'
      '          where (ncm.codigotipi, coalesce(ncm.extipi,'#39#39')) in'
      
        '                                                (select ipi.clas' +
        'sificacaofiscal, coalesce(ipi.extipi,'#39#39')'
      '                                                 from ipi'
      
        '                                                 where ipi.codig' +
        'o = c.ipi)) as aliqimportado'
      ''
      ''
      
        'from produtos p join caracteristicas c on p.caracteristica = c.c' +
        'odigo'
      'where   p.codigo in ((select :codigo)'
      '                            union all'
      '                           (select pcb.produto'
      '                            from produtoscodigobarras pcb'
      
        '                            where pcb.codigobarras=coalesce(:cod' +
        'igo,cast(0 as varchar(30)))))'
      '/*(p.codigo = :codigo) or'
      '            (codigobarrasext = :codigo))*/ and'
      '            (p.codigo = (select e.produto'
      '                                from estoques e'
      '                                where (e.produto = p.codigo) and'
      
        '                                           (e.filial = :FilialBa' +
        'se))) and'
      '            estoques_preco(p.codigo, :FilialBase) > 0'
      '')
    RequestLive = False
    Left = 51
    Top = 15
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'FilialBase'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'EstadoFilialBase'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end>
    object qryProdutocodigo: TLargeintField
      FieldName = 'codigo'
      Visible = False
    end
    object qryProdutocaracteristica: TLargeintField
      FieldName = 'caracteristica'
    end
    object qryProdutodescricao: TStringField
      DisplayWidth = 62
      FieldName = 'descricao'
      Size = 62
    end
    object qryProdutopreco: TFloatField
      FieldName = 'preco'
      DisplayFormat = '0.00'
    end
    object qryProdutounidade: TStringField
      FieldName = 'unidade'
      Size = 8
