  object qryMetaVendas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    MacroChar = '$'
    Macros = <>
    Sql.Strings = (
      ';SELECT * from'
      '('
      '/*MESMO DIA ANO PASSADO*/'
      
        '(select CAST(case when anopassado<>0 then cast(hoje/anopassado*1' +
        '00 as numeric(9,2)) else 100 end AS NUMERIC(5,2)) as percentual,' +
        'hoje,anopassado,'#39'dia'#39' as comparativo,cast('#39'Di'#225'rio'#39' as varchar) a' +
        's descricao'
      'from'
      '('
      #9'select'
      #9'('
      #9'select coalesce(sum(valor),0.0)'
      #9'from autenticacoes'
      #9'where filial=:filialbase'
      #9'and tipo='#39'F'#39
      #9'and not cancelada'
      #9'and data=(current_date - INTERVAL '#39'1 year'#39')) as anopassado,'
      #9'(select coalesce(sum(valor),0.0)'
      #9'from autenticacoes'
      #9'where filial=:filialbase'
      #9'and tipo='#39'F'#39
      #9'and not cancelada'
      #9'and data=current_date) as hoje) as sel)'
      ''
      'union'
      ''
      ''
      ''
      '/*COMPARATIVO ESTE MES COM ANO PASSADO*/'
      
        '(select cast (case when anopassado<>0 then cast (estemes/anopass' +
        'ado*100 as numeric(9,2)) else 100 end as NUMERIC(5,2)) as percen' +
        'tual,estemes,anopassado,'#39'mes'#39' as comparativo,cast('#39'Mensal'#39' as va' +
        'rchar) as descricao'
      'from'
      '('
      '   select'
      #9'( select coalesce(sum(valor),0.0)'
      #9'  from autenticacoes'
      #9'  where filial=:filialbase'
      #9'  and tipo='#39'F'#39
      #9'  and not cancelada'
      
        #9'  and data>=cast(date_part('#39'year'#39',current_date) || '#39'-'#39' || date_' +
        'part('#39'month'#39',current_date) || '#39'-01'#39' as date)'
      #9') as estemes,'
      ''
      #9'( select coalesce(sum(valor),0.0)'
      #9'  from autenticacoes'
      #9'  where filial=:filialbase'
      #9'  and tipo='#39'F'#39
      #9'  and not cancelada'
      
        #9'  and data>=(cast(date_part('#39'year'#39',current_date) || '#39'-'#39' || date' +
        '_part('#39'month'#39',current_date) || '#39'-01'#39' as date) - interval '#39'1 year' +
        #39')'
      #9'  AND data<=current_date-interval '#39'1 year'#39
      #9') as anopassado'
      ') as sel)'
      ''
      'union'
      ''
      '/*COMPARATIVO ESTE ANO COM ANO PASSADO*/'
      
        '(select CAST(case when anopassado<>0 then cast (esteano/anopassa' +
        'do*100 as numeric(9,2)) else 100 end AS NUMERIC(5,2)) as percent' +
        'ual,esteano,anopassado,'#39'vano'#39' as comparativo,cast('#39'Anual'#39' as var' +
        'char) as descricao'
      'from'
      '('
      '   select'
      #9'( select coalesce(sum(valor),0.0)'
      #9'  from autenticacoes'
      #9'  where filial=:filialbase'
      #9'  and tipo='#39'F'#39
      #9'  and not cancelada'
      
        #9'  and data>=cast(date_part('#39'year'#39',current_date) || '#39'-01-01'#39' as ' +
        'date)'
      #9') as esteano,'
      ''
      #9'( select coalesce(sum(valor),0.0) '
      #9'  from autenticacoes'
      #9'  where filial=:filialbase'
      #9'  and tipo='#39'F'#39
      #9'  and not cancelada '
      
        #9'  and data>=(cast(date_part('#39'year'#39',current_date) || '#39'-01-01'#39' as' +
        ' date) - interval '#39'1 year'#39') '
      #9'  AND data<=current_date-interval '#39'1 year'#39
      #9') as anopassado'
      ') as sel))as sel order by comparativo;')
    RequestLive = False
    Left = 160
    Top = 248
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'filialbase'
        ParamType = ptUnknown
      end>
    object qryMetaVendaspercentual: TFloatField
      FieldName = 'percentual'
    end
    object qryMetaVendasdescricao: TStringField
      FieldName = 'descricao'
      Size = 6
    end
  end
