    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select autenticacoes.numero,'
      '         autenticacoes.caixa,'
      
        '         (select usuarios.nome from usuarios where usuarios.codi' +
        'go = autenticacoes.caixa) as nomecaixa,'
      '/*         autenticacoes.filial,'
      '         autenticacoes.data,'
      '         autenticacoes.hora,'
      '         autenticacoes.valor,'
      '         autenticacoes.transferencia, */'
      
        '         (select usuarios.nome from usuarios where usuarios.codi' +
        'go = autenticacoes.transferencia) as nometransferencia'
      'from autenticacoes'
      'where situacao and'
      '     (autenticacoes.tipo = '#39'S'#39') and'
      '     (autenticacoes.entradapendente) and'
      '     (autenticacoes.confirmacao is null) and'
      '     (((autenticacoes.caixa = :caixaatual) and'
      '       (autenticacoes.diferencatransferencia is null)) or'
      '      ((autenticacoes.transferencia = :caixaatual)))')
    RequestLive = False
    Left = 474
    Top = 307
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'caixaatual'
        ParamType = ptUnknown
      end>
