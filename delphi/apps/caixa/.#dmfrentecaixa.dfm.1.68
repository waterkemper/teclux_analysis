    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftString
        Name = 'codigo'
        ParamType = ptUnknown
        Value = 'false'
      end>
    Sql.Strings = (
      
        'SELECT COALESCE((SELECT cast(pcb.codigobarras as varchar(30)) FR' +
        'OM produtoscodigobarras pcb WHERE pcb.produto = p.codigo limit 1' +
        '),p.codigovisual) AS codigo,'
      
        '       CAST(p.descricao || coalesce(p.valorgrade1,'#39#39') || coalesc' +
        'e(p.valorgrade2,'#39#39') AS VARCHAR) AS descricao,'
      
        '       (SELECT descricao FROM unidades WHERE codigo = c.unidade)' +
        ' AS unidade,'
      '       CAST(CASE WHEN c.producaopropria THEN '#39'P'#39
      '                                        ELSE '#39'T'#39
      '            END AS CHAR) as producaopropria,'
      '       CAST(CASE WHEN :arredondamento THEN '#39'A'#39
      '                 ELSE '#39'T'#39
      '            END AS CHAR) AS arredondamento,'
      '       CAST(CASE WHEN c.incidencia = 5           THEN '#39'I'#39
      '                 WHEN c.incidencia in (4,6,7,11) THEN '#39'N'#39
      '                 WHEN c.incidencia in (2,9,10)   THEN '#39'F'#39
      '                 WHEN c.incidencia in (1,3,8)    THEN '#39'T'#39
      '            END AS CHAR) AS situacaotributaria,'
      
        '       CAST(COALESCE((SELECT ei.valor FROM estadosicms ei WHERE ' +
        'ei.icms = c.icms AND ei.estado = :estado),0) AS NUMERIC) AS aliq' +
        'uota,'
      '       estoques_preco(p.codigo,:filialbase) AS precounitario,'
      '       p.referencia,'
      '       c.cest,'
      '       ipi.classificacaofiscal'
      ''
      'FROM caracteristicas c'
      '     JOIN produtos p'
      '     ON p.caracteristica = c.codigo'
      ''
      '     join ipi'
      '     on c.ipi = ipi.codigo'
      'WHERE'
      '%codigo'
      '  AND (p.codigo = (SELECT e.produto'
      '                   FROM estoques e'
      '                   WHERE (e.produto = p.codigo)'
      '                     AND (e.filial = :filialbase)))')
    RequestLive = False
    Left = 48
    Top = 68
    ParamData = <
      item
        DataType = ftString
        Name = 'arredondamento'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'estado'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'filialbase'
        ParamType = ptUnknown
      end>
