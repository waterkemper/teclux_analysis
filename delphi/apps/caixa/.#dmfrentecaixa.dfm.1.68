  object qryCliente: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryClienteCalcFields
    OnNewRecord = qryClienteNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select cl.*,'
      ''
      '      ( select b.nome'
      '        from bairros b'
      '        where b.estado = cl.estado and'
      '              b.cidade = cl.cidade and'
      '              b.codigo = cl.bairro'
      '       ) as nomebairro,'
      ''
      '       ( select d.nome'
      '         from cidades d'
      '         where d.estado = cl.estado and'
      '              d.codigo = cl.cidade'
      '        ) as nomecidade,'
      ''
      '      ( select b.nome'
      '        from bairros b'
      '        where b.estado = cl.refestado and'
      '              b.cidade = cl.refcidade and'
      '              b.codigo = cl.refbairro'
      '       ) as refnomebairro,'
      ''
      '       ( select d.nome'
      '         from cidades d'
      '         where d.estado = cl.refestado and'
      '              d.codigo = cl.refcidade'
      '        ) as refnomecidade,'
      ''
      '      (select c.CodigoIBGE'
      '       from cidades c'
      '       where c.estado = cl.estado'
      '         and c.codigo = cl.cidade) as CidadeIBGE'
      ''
      'from clientes cl'
      'where cl.codigo  = :codigo')
    RequestLive = True
    Left = 123
    Top = 117
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end>
