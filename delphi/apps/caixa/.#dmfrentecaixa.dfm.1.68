  object qryProduto: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';select selecao.*,'
      
        '        estoques_produtoempromocao(selecao.codigo, :FilialBase) ' +
        'as promocao,'
      '       (select ei.valor'
      '        from estadosicms ei'
      '        where ei.estado = :EstadoFilialBase'
      '          and ei.icms = selecao.icms'
      '        ) as aliquotaicms,'
      ''
      '       (select i.aliquota'
      '        from ipi i'
      '        where i.codigo = selecao.ipi) as aliquotaipi,'
      ''
      '       (select t.valor'
      '        from tributosicms t'
      '        where t.codigo = selecao.incidenciap) as incidencia,'
      ''
      '       (select ncm.nacionalfederal'
      '        from ncmtabela ncm'
      '        where (ncm.codigotipi, coalesce(ncm.extipi,'#39#39')) in'
      
        '                                         (select ipi.classificac' +
        'aofiscal, coalesce(ipi.extipi,'#39#39')'
      '                                          from ipi'
      
        '                                          where ipi.codigo = sel' +
        'ecao.ipi)) as nacionalfederal,'
      ''
      '       (select ncm.importadosfederal'
      '        from ncmtabela ncm'
      '        where (ncm.codigotipi, coalesce(ncm.extipi,'#39#39')) in'
      
        '                                                (select ipi.clas' +
        'sificacaofiscal, coalesce(ipi.extipi,'#39#39')'
      '                                                 from ipi'
      
        '                                                 where ipi.codig' +
        'o = selecao.ipi)) as importadosfederal,'
      '        (select ncm.cargaestadual'
      '        from ncmtabela ncm'
      '        where (ncm.codigotipi, coalesce(ncm.extipi,'#39#39')) in'
      
        '                                                (select ipi.clas' +
        'sificacaofiscal, coalesce(ipi.extipi,'#39#39')'
      '                                                 from ipi'
      
        '                                                 where ipi.codig' +
        'o = selecao.ipi)) as cargaestadual,'
      '       (select ncm.cargamunicipal'
      '        from ncmtabela ncm'
      '        where (ncm.codigotipi, coalesce(ncm.extipi,'#39#39')) in'
      
        '                                                (select ipi.clas' +
        'sificacaofiscal, coalesce(ipi.extipi,'#39#39')'
      '                                                 from ipi'
      
        '                                                 where ipi.codig' +
        'o = selecao.ipi)) as cargamunicipal,'
      '       (select ncm.chaveibpt'
      '        from ncmtabela ncm'
      '        where (ncm.codigotipi, coalesce(ncm.extipi,'#39#39')) in'
      
        '                                                (select ipi.clas' +
        'sificacaofiscal, coalesce(ipi.extipi,'#39#39')'
      '                                                 from ipi'
      
        '                                                 where ipi.codig' +
        'o = selecao.ipi)) as chaveibpt,'
      '       (select ipi.classificacaofiscal'
      '        from ipi'
      '        where ipi.codigo = selecao.ipi) as ncm'
      ''
      ''
      'from'
      '('
      
        'select p.codigo, p.codigovisual, c.icms, c.ipi, c.incidencia as ' +
        'incidenciap,'
      
        '       cast(p.descricao||'#39' '#39'||coalesce(p.valorgrade1,'#39#39')||'#39' '#39'||c' +
        'oalesce(p.valorgrade2,'#39#39') as varchar) as descricao,'
      '       estoques_preco(p.codigo, :FilialBase) as preco,'
      
        '       /* (select pdc.codigobarras from produtoscodigobarras pdc' +
        ' where pdc.produto = p.codigo limit 1) as codigobarrasext, */'
      '       p.caracteristica,'
      '       c.unidade,'
      ''
      '       c.csosn,'
      '       c.origem,'
      '       c.percreducaobase,'
      ''
      '       c.brinde,'
      '       c.composto,'
      '       c.producaopropria,'
      ''
      '       e.emestoque,'
      '       c.cest'
      ''
      'from ((produtos p'
      '       join caracteristicas c'
      '       on p.caracteristica = c.codigo)'
      '       join estoques e'
      '       on p.codigo = e.produto'
      '       and e.filial = :FilialBase)'
      ''
      'where  p.caracteristica = c.codigo'
      '  and p.codigo = e.produto'
      '  and ( p.codigo = :produto or'
      
        '        upper(to_ascii(p.codigovisual,'#39'latin1'#39')) = upper(to_asci' +
        'i(:produtovisual,'#39'latin1'#39')) or'
      '       '#9'p.codigo in (select pcb.produto'
      '                     from produtoscodigobarras pcb'
      '                     where pcb.codigobarras = :produtovisual)'
      '       )'
      ') as selecao'
      'where coalesce(preco,0)>0'
      '')
    RequestLive = False
    Left = 35
    Top = 7
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'FilialBase'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'EstadoFilialBase'
        ParamType = ptUnknown
      end
      item
        DataType = ftLargeint
        Name = 'produto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'produtovisual'
        ParamType = ptUnknown
      end>
