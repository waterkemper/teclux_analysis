  object qryCheque: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select c.numero,'
      '       c.data,'
      '       c.vencto,'
      '       c.valor,'
      '       c.cliente,'
      '       c.tipocliente,'
      '       c.titular,'
      '       c.filial,'
      '       c.situacao,'
      '      (Select count(*) > 0 From autenticacoes a'
      '                           Where (a.cheque = c.numero) and'
      '                                 (a.tipo = '#39'H'#39') and'
      
        '                                  not exists (Select a1.numero F' +
        'rom autenticacoes a1'
      
        '                                              Where a.numero = a' +
        '1.autenticacao)) as autenticado'
      'from cheques c'
      'where c.numero=:numero')
    RequestLive = True
    Left = 51
    Top = 110
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'numero'
        ParamType = ptUnknown
      end>
