procedure Tdtmfrentecaixa.RefazConsultaMetaVendas;
begin
  RefazConsulta(qryMetaVendas,[0],[FilialBase]);
end;


function Tdtmfrentecaixa.getTotalVendido: Real;
begin
  Result := qryTotalVendidovalortotal.AsFloat;
end;

procedure Tdtmfrentecaixa.dsrClienteDataChange(Sender: TObject;
  Field: TField);
begin
  inherited;
{  FNomeCliente:= qryClientenome.AsString;}
