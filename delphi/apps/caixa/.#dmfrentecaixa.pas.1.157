procedure Tdtmfrentecaixa.CalcularCashBackGerado;
var
  vDescontoseAcrescimos : Double;

begin
{
  vTotalPagtoCreditoTroca := SomarValores(qryRecebimentosTemp,
                    [qryRecebimentosTempValorLancto],
                    [qryRecebimentosTemptipotiporecebimento,
                     qryRecebimentosTempok],
                    ['T','True'],
                    ['=','=']);
                    }

  vDescontoseAcrescimos := TotalRecebimentosCreditoTroca +
                           qryTotalRecebimentodesconto_cashback.asCurrency +
                           qryTotalRecebimentovalordesconto.asCurrency -
                           qryTotalRecebimentovaloracrescimo.asCurrency;

  if roundto(qryProdutosVendidos.ParamByname('DescontoseAcrescimos').asCurrency, -2) <>
     roundto(vDescontoseAcrescimos, -2) then
  begin

    qryProdutosVendidos.first;
    while not qryProdutosVendidos.eof do
    begin
      qryProdutosVendidos.edit;
      qryProdutosVendidossequencia.asInteger := qryProdutosVendidos.recno;
      qryProdutosVendidos.next;
    end;

    qrymovimentosfrentecaixa_proximonumero.close;
    qrymovimentosfrentecaixa_proximonumero.open;

    AtribuirDados(qryProdutosVendidos,

                 [qryProdutosVendidosnumero,
                  qryProdutosVendidoscliente,
                  qryProdutosVendidosTipoCliente,
                  qryProdutosVendidosFilial],

                 [inttostr(qrymovimentosfrentecaixa_proximonumeroseq.asInteger),
                  qryClienteCodigo.asinteger,
                  'C',
                  FilialBase]);

    perpetrar([qryProdutosVendidos]);

    RefazConsultaPorNome(qryProdutosVendidos,
        ['numero','DescontoseAcrescimos'],
        [qrymovimentosfrentecaixa_proximonumeroseq.asInteger,
         vDescontoseAcrescimos]);

    qryTotalRecebimento.AfterPost := nil;

    desconto_cashbackGerado := SomarValores(qryProdutosVendidos,
          [qryProdutosVendidoscalc_valorcashback], [], [], []);
          
    qryTotalRecebimento.AfterPost := qryTotalRecebimentoAfterPost;
    
  end;

end;

procedure Tdtmfrentecaixa.AbrirDadosCashBack;
begin
  if not assigned(dtmVisualizarSaldocashback) then
     dtmVisualizarSaldocashback := TdtmVisualizarSaldocashback.Create(Self);
  dtmVisualizarSaldocashback.AbrirDadosCliente(qryClientecodigo.asinteger, 'C');
end;

function Tdtmfrentecaixa.ValidarDesconto_CashBack(
  Exibirmsg: Boolean): Boolean;
begin

  result := true;
  if Desconto_CashBack > 0 then
  begin
    if Desconto_CashBack > SaldoDesconto_CashbackAtual then
    begin
       MensagemErro(format(ctVALORCASHBACKFORAINTERVALO,[Desconto_CashBack,SaldoDesconto_CashbackAtual]));
       result := false;

    end
    else
    begin
      result := ValidarLimitesDescontos(false);

      {
      Gedovar ...verificar
      if result then
      begin
        if TotalContrato < 0.01 then
        begin
          MensagemErro(format(ctVALORCASHBACKMAIORPRODUTOS,[Desconto_CashBack, (TotalContrato + Desconto_CashBack) ]));
          result := false;
        end
        else
        if TotalContrato = 0 then
        begin
          MensagemAutoClose('CashBack', 'O valor do CashBack deve ficar abaixo do total do contrato', 4);
          Desconto_CashBack := Desconto_CashBack - 0.01;
        end;
      end;

      }
    end;
  end;

end;

function Tdtmfrentecaixa.GetSaldoDesconto_CashbackAtual: Currency;
begin
  result := dtmVisualizarSaldocashback.qrycashback_saldossaldofinal.asCurrency;
end;

function Tdtmfrentecaixa.ValidarLimitesDescontos(
  ComDescontoFinanceiro: Boolean): Boolean;
var
  vTotal : Currency;
  vTotalDesconto : Currency;
  vNovoPercentualDesconto : Currency;

begin

  Result := True;

  {

  Gedovar ...verificar
  if ParSistema.PercentualDescontoFrenteCaixa > 0 then
  begin

    vTotal :=  qryContratostotalprodutos.AsFloat +
               qryContratostotalipi.AsFloat +
               qryContratosvaloricmssubstituicao.AsFloat +
               qryContratosTotalLiquidoServicos.AsFloat +
               qryContratosfrete.AsFloat +
               qryContratosseguro.AsFloat;

    if ComDescontoFinanceiro then
      vTotalDesconto := vTotal -  qryContratosvalorprazo.asCurrency
    else
      vTotalDesconto := qryContratoscupom_valor_desconto.asCurrency +
                        qryContratosdesconto_cashback.asCurrency +
                        qryContratosdescontogeral.AsCurrency;

    vNovoPercentualDesconto := roundtod(PercentualDoValorSobreTotal(vTotal, vTotalDesconto), 2);

    if  vNovoPercentualDesconto > roundtod(ParSistema.PercentualDescontoFrenteCaixa, 2) then
    begin
      MensagemAviso(format('Foi concedido um desconto de %s%s.'+chr(13)+
                             'Ultrapassando o desconto máximo de %s%s ',
               [CurrToStr(vNovoPercentualDesconto), '%', floattostr(parsistema.PercentualDescontoFrenteCaixa), '%']));

      Result := False;
    end;
  end;
  }

end;

function Tdtmfrentecaixa.SugerirDesconto_Cashback(Perguntar,
  Atribuir: Boolean): Boolean;
var
  msg : String;
begin
  result := false;
  begin
    if SaldoDesconto_CashbackAtual <> 0 then
    begin
      if SaldoDesconto_CashbackAtual >0 then
        msg:= 'CashBack';

      if not Perguntar or
         (MensagemConfirmacao(format(ctCLIENTEPOSSUIDEBITOCREDITO,[msg,SaldoDesconto_CashbackAtual])) = smbOK) then
      begin

        desconto_cashback := 0;

        if Atribuir or not Perguntar then
          if (SaldoDesconto_CashbackAtual > 0) then
          begin
            if (ValorAReceber + desconto_cashback {?}) >= SaldoDesconto_CashbackAtual then
              desconto_cashback := SaldoDesconto_CashbackAtual
            else
              desconto_cashback := (ValorAReceber + desconto_cashback {?});

            desconto_cashback := desconto_cashback - ValorUltrapassadodeDesconto;

            if ValorAReceber = 0 then
              Desconto_CashBack := Desconto_CashBack - 0.01;

          end;
        result := true;
      end;
    end;
  end;
end;

function Tdtmfrentecaixa.ValorUltrapassadodeDesconto: Currency;
var
  vTotal : Currency;
  vTotalDesconto : Currency;
  vNovoPercentualDesconto : Currency;
  vValorMaximoDesconto : Currency;

begin
  result := 0.00;

        { Gedovar verificar...

  if ParSistema.PercentualDescontoFrenteCaixa > 0 then
  begin

    vTotal :=  qryContratostotalprodutos.AsFloat +
               qryContratostotalipi.AsFloat +
               qryContratosvaloricmssubstituicao.AsFloat +
               qryContratosTotalLiquidoServicos.AsFloat +
               qryContratosfrete.AsFloat +
               qryContratosseguro.AsFloat;

    vTotalDesconto := qryContratoscupom_valor_desconto.asCurrency +
                      qryContratosdesconto_cashback.asCurrency +
                      qryContratosdescontogeral.AsCurrency;


    vNovoPercentualDesconto := PercentualDoValorSobreTotal(vTotal, vTotalDesconto);

    if  vNovoPercentualDesconto > ParSistema.PercentualDescontoFrenteCaixa then
    begin
      vValorMaximoDesconto := roundtod((vTotal * ParSistema.PercentualDescontoFrenteCaixa/100),2);
      result := vTotalDesconto - vValorMaximoDesconto;

    end;

  end;

  }
end;

function Tdtmfrentecaixa.GetTabelaSaldoCashBack: TZDataset;
begin
  result := dtmVisualizarSaldocashback.qrycashback_saldos
end;

procedure Tdtmfrentecaixa.Setdesconto_cashback(const Value: Currency);
begin
  if roundto(value, -2) <>
     roundto(qryTotalRecebimentodesconto_cashback.asCurrency, -2) then
  begin
    qryTotalRecebimento.edit;
    qryTotalRecebimentodesconto_cashback.asCurrency := Value;
    qryTotalRecebimento.post;
  end;

  if FSituacaoCupom < scTotalizado then
  begin
    ValorAReceber := FTotalPagar - ValorDesconto - desconto_cashback + ValorAcrescimo - ValorTotalDescontoItem;
    FSaldoRestante := ValorAReceber;
  end;
  VerificarSaldoRecebimentosTemp;

  if assigned(AfterAlteracaoValores) then
    AfterAlteracaoValores(nil);



end;

