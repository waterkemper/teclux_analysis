  { TLoopThread }

  {
procedure TConsultarClientesThread.consultarclienteThread;
begin
  dtmFrenteCaixa.ConsultarClientesThread_;
end;

procedure TConsultarClientesThread.Execute;
begin
  if not terminated then
    Synchronize(consultarclienteThread);

end;
}


{ TdtmFrenteCaixa }

procedure Tdtmfrentecaixa.AbreClientes;
begin
  qryCliente.OnCalcFields := nil;
  if Not qryCliente.Active then
    ReFazConsulta(qryCliente, [0], [0]);
  qryCliente.OnCalcFields := qryClienteCalcFields;
end;

procedure Tdtmfrentecaixa.AbreConsultaClientes;
begin
  qryConsultaClientes.Sql[16] := 'where c.codigo = 0';
  qryConsultaClientes.Open
end;

procedure Tdtmfrentecaixa.AbreConsultaProduto(Descricao: String);
begin
  if Descricao <> '' then
    qryConsultaProduto.MacroByName('codigo').AsString := '(p.descricao ilike ''' + Descricao + '%'')'
  else
    qryConsultaProduto.MacroByName('codigo').AsString := '(p.codigo IS NULL )';

  qryConsultaProduto.Open;
  qryConsultaProduto.SortByField('descricao');

end;

procedure Tdtmfrentecaixa.AbreConsultaVendedor;
begin
  qryConsultaVendedores.Open
end;

{ GD alteração FC
procedure TdtmFrenteCaixa.addRegistroEntradaPgtoTMP;
begin
  if not (qryPagamentoTMP.Locate('ID',1,[])) then
  begin
    qryPagamentoTMP.Append;
    qryPagamentoTMPid.AsInteger := 1;
    qryPagamentoTMPtipo.AsString := 'Entrada';
    qryPagamentoTMP.Post;
