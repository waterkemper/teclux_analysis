  Application.ProcessMessages;
end;
}

procedure Tdtmfrentecaixa.BloquearEstoque;
var
  WhereSQL: String;
begin

  qryProdutosVendidos.DisableControls;
  try
    WhereSQL := '';
    qryProdutosVendidos.First;
    while Not qryProdutosVendidos.Eof do begin
      WhereSQL := WhereSQL +
      '((e.produto = ' + qryProdutosVendidosproduto.AsString + ')and' +
      '(e.filial = '   + qryProdutosVendidosfilial.AsString  + '))or';
      qryProdutosVendidos.Next
    end;
    Delete(WhereSQL, Length(WhereSQL) - 1, 2);
  finally
    qryProdutosVendidos.EnableControls
  end;
  qryEstoque.Sql[21] := WhereSQL;
  qryEstoque.Open;
end;

procedure Tdtmfrentecaixa.CancelarClienteCheque;
begin
  qryChequesIncluidos.Cancel
end;

procedure Tdtmfrentecaixa.CancelarItem;
var
  NenhumMarcado: Boolean;

  function Cancelar: Boolean;
  begin
    Result := True;
    if Assigned(ECFPadrao) then
    begin
      ECFPadrao.CancelarItem(qryProdutosVendidosnumeroitem.AsString);
      if ecfpadrao.erro then
      begin
        Result := False;
        MensagemErro(ECFPadrao.Mensagem);
      end
    end;
    if Result and Not qryProdutosVendidoscancelado.AsBoolean then
    begin
      NenhumMarcado  := False;
      FValorTotalDescontoItem := FValorTotalDescontoItem - qryProdutosVendidosdesconto.AsFloat;
      FTotalPagar    := FTotalPagar - Truncar((qryProdutosVendidosvalor.AsCurrency * qryProdutosVendidosquantidade.AsCurrency),2);
      ValorAReceber := FTotalPagar - ValorDesconto - Desconto_CashBack - ValorTotalDescontoItem + ValorAcrescimo;
      FSaldoRestante := ValorAReceber;
      FSubTotal      := FSubTotal-Truncar(((qryProdutosVendidosvalor.AsCurrency * qryProdutosVendidosquantidade.AsCurrency)-qryProdutosVendidosdesconto.AsCurrency),2);
      FValorTotalQuantidade := FValorTotalQuantidade - qryProdutosVendidosquantidade.AsCurrency;
      qryProdutosVendidos.Edit;
      qryProdutosVendidoscancelado.AsBoolean   := True;
      qryProdutosVendidosselecionado.AsBoolean := False;
      qryProdutosVendidos.Post;
    end;
  end;

  procedure PopulaDataSetTemp;
  var
    i : Integer;
  begin
    qryProdutosVendidos.First;
    if qryTecTempProdutosCancelados.Active then
      qryTecTempProdutosCancelados.Close;
    qryTecTempProdutosCancelados.Open;
    while not qryProdutosVendidos.Eof do
    begin
      if not qryProdutosVendidoscancelado.AsBoolean then
      begin
        qryTecTempProdutosCancelados.Append;
        for i := 0 to qryProdutosVendidos.Fields.Count-1 do
        begin
          case qryProdutosVendidos.Fields[i].DataType of
            ftBoolean : qryTecTempProdutosCancelados.Fields[i].AsBoolean := qryProdutosVendidos.fieldbyname(qryTecTempProdutosCancelados.Fields[i].FieldName).AsBoolean;
            ftinteger,
            ftLargeInt,
            ftString  : qryTecTempProdutosCancelados.Fields[i].asString := qryProdutosVendidos.fieldbyname(qryTecTempProdutosCancelados.Fields[i].FieldName).asString;
            ftCurrency: qryTecTempProdutosCancelados.Fields[i].asCurrency := qryProdutosVendidos.fieldbyname(qryTecTempProdutosCancelados.Fields[i].FieldName).asCurrency;
          else
            qryTecTempProdutosCancelados.Fields[i].asvariant := qryProdutosVendidos.fieldbyname(qryTecTempProdutosCancelados.Fields[i].FieldName).asvariant;
          end;

        end;
        qryTecTempProdutosCancelados.FieldByName('Cancelado').AsBoolean := False;
        qryTecTempProdutosCancelados.Post;
      end;
      qryProdutosVendidos.Next;
    end;
  end;
begin
  PopulaDataSetTemp;
  qryTecTempProdutosCancelados.First;
  if not qryTecTempProdutosCancelados.IsEmpty then
  begin
    try
      frmCancelaItemFrenteCaixa := TfrmCancelaItemFrenteCaixa.Create(frmCancelaItemFrenteCaixa);
      frmCancelaItemFrenteCaixa.ShowModal;
    finally
      if frmCancelaItemFrenteCaixa.GravaCancelamrnto then
      begin
        qryTecTempProdutosCancelados.First;
        while not qryTecTempProdutosCancelados.Eof do
        begin
          if qryProdutosVendidos.Locate('numeroitem', qryTecTempProdutosCancelados.FieldByName('numeroitem').AsInteger, []) then
          begin
            if qryTecTempProdutosCancelados.FieldByName('cancelado').AsBoolean then
            begin
              Cancelar;
            end;
          end;
          qryTecTempProdutosCancelados.Next;
        end;
      end;
      frmCancelaItemFrenteCaixa.Free;
    end;
  end
  else
    MensagemAviso('Não há itens que possam ser cancelados.');
end;

function Tdtmfrentecaixa.CancelarVenda: Boolean;
var
  Ind: Integer;

  procedure ExcluirDadoFiscal;
  begin
    if qryDadosFiscais.Active then begin
      Ind := ExcluirCupom;
      if Ind = 0 then begin
        qryDadosFiscais.Edit;
        qryDadosFiscaissituacao.AsString := 'C';
        qryDadosFiscais.Post;
        try
          {verificar o cancelamento da nfe}
          Perpetrar([qryDadosFiscais, qryProdutosdadosFiscais, qryMovimentos, qryEstoque]);
        except
                on E: Exception do ShowMessage(E.Message);
        end;
        Result := True
      end else begin
        MensagemAviso(Format(ctNAOAPAGARNOTAENTRADA, [TotalizadoresEstoque[Ind]]));
        Result := False
      end
    end
  end;

begin
  Result := True;
  if Assigned(ECFPadrao) then
  begin
    ECFPadrao.CancelarCupom;
    if ecfpadrao.erro then
    begin
      MensagemErro(ECFPadrao.Mensagem);
      Result := MensagemConfirmacao('Não foi possível cancelar o cupom fiscal. '+slinebreak{#13#10}+'Deseja cancelar a venda mesmo assim') = smbOK;
    end;
  end;
  
  if Result then
  begin
    if Assigned(ECFPadrao) then
      ExcluirDadoFiscal;

    ReFazConsultaPorNome(qryProdutosVendidos, ['numero'], [0]);

    FTotalPagar    := 0;
    FSaldoRestante := 0;
    ValorAReceber := 0;
    ValorDesconto := 0;
    FValorTotalQuantidade := 0;
    TotalRecebimentos := 0;

    SituacaoCupom := scFechado; //FVendaAberta := False;
  end;

  if Assigned(frmMsg) then
    FreeAndNil(frmMsg);
    {
  if Assigned(tefdiscado) then
    FreeAndNil(tefdiscado);
    }
//  if Assigned(BackupTEFDiscado) then
//    FreeAndNil(BackupTEFDiscado);
  if Assigned(ECFPadrao) then
    ECFPadrao.AtualizarTotalizadorGeral(NomeArquivoECFs);
end;

function Tdtmfrentecaixa.ChequeCadastrado(Numero: String): Boolean;
begin
  ReFazConsulta(qryCheque,[0],[Numero]);
  Result:= qryCheque.RecordCount > 0;
  if not result then
  begin
    qryChequesIncluidos.MasterSource := nil;
    qryChequesIncluidos.first;
    if qryChequesIncluidos.locate('numero',Numero,[]) then
      result := true;
    qryChequesIncluidos.MasterSource := dsrRecebimentosTemp;
  end;
end;

constructor Tdtmfrentecaixa.Create(AOwner: TComponent);
begin
  inherited;

  IniciarTabelaTotalRecebimento;

  qryProduto.Tag                        := 0;
  qryProdutosVendidos.Tag               := 0;
  qryProdutosDigitados.Tag              := 0;

//  VerificarGTVenderItem:=true;

  qryChequesIncluidos.Tag               := 0;
  qryAutenticacao.Tag                   := 0;
  if ParSistema.FrenteCaixaComVendedor then
    qryVendedor.Tag := 0;
  qryProduto.ParamByName('filialbase').AsInteger := FilialBase;

  ReFazConsulta(qryLogotipos,[0],[FilialBase]);
  NomeLogotipo:= qrylogotiposnome.AsString;
  qrylogotipos.Close;
  qryProduto.Params[1].AsString  := EstadoFilialBase;

  if assigned(ECFPadrao) then
    qryConsultaProduto.ParamByName('arredondamento').AsBoolean := ECFPadrao.Arredonda
  else
    qryConsultaProduto.ParamByName('arredondamento').AsBoolean := false;

  qryConsultaProduto.ParamByName('estado').AsString          := EstadoFilialBase;
  qryConsultaProduto.ParamByName('filialbase').AsInteger     := FilialBase;
//  lstProdutos                    := TList.Create;
  qryProdutosVendidosquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryTecTempProdutosCanceladosquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;

  FSituacaoCupom := scFechado;

  {
  if assigned(tefpadrao) then
    tefpadrao.AutoFinalizarCupom := false;
  }

  vContinuarLeituraCodigoBarras := true;

end;

procedure Tdtmfrentecaixa.DesmarcarTodos;
var
  PosAnt: TBookmark;
begin
  PosAnt := qryProdutosVendidos.GetBookmark;
  qryProdutosVendidos.DisableControls;
  try
    qryProdutosVendidos.First;
    while Not qryProdutosVendidos.Eof do begin
      qryProdutosVendidos.Edit;
      qryProdutosVendidosselecionado.AsBoolean := False;
      qryProdutosVendidos.Next
    end;
  finally
    qryProdutosVendidos.GotoBookmark(PosAnt);
    qryProdutosVendidos.FreeBookmark(PosAnt);
    qryProdutosVendidos.EnableControls
  end;
end;

destructor Tdtmfrentecaixa.Destroy;
begin
{$IFDEF MSWINDOWS}
{
  if Assigned(tefdiscado) then
    FreeAndNil(tefdiscado);
    }
//  if Assigned(BackupTEFDiscado) then
//    FreeAndNil(BackupTEFDiscado);
{$ENDIF}
  if Assigned(ECFPadrao) and ECFPadrao.CupomAberto then
    ECFPadrao.CancelarCupom;
