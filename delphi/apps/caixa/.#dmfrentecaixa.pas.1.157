procedure Tdtmfrentecaixa.LogSituacaoErroFrenteCaixa(Situacao: String);
var
  vEditando_ou_Incluindo : String;
  ListarSituacaoErro : TStringList;

begin
  vEditando_ou_Incluindo := 'B'; //Browse
  if (dtmfrentecaixa.qryProdutosDigitados.state = dsinsert) then
    vEditando_ou_Incluindo := 'I';

  if dtmfrentecaixa.qryProdutosDigitados.state = dsedit then
    vEditando_ou_Incluindo := 'E';

  ListarSituacaoErro := tStringlist.create;
  if fileexists(ExtractFilePath(Application.ExeName) + 'log\frentecaixa_log.txt') then
    ListarSituacaoErro.loadfromfile(ExtractFilePath(Application.ExeName) + 'log\frentecaixa_log.txt');
  ListarSituacaoErro.add('situação de erro ' + datetimetostr(dtmfrentecaixa.DataHoraServidor));
  ListarSituacaoErro.add('State : '+ vEditando_ou_Incluindo);
  ListarSituacaoErro.add('Records : '+ inttostr(dtmfrentecaixa.qryProdutosDigitados.RecordCount));

  ListarSituacaoErro.savetofile(ExtractFilePath(Application.ExeName) + 'log\frentecaixa_log.txt');
  ListarSituacaoErro.free;

end;

