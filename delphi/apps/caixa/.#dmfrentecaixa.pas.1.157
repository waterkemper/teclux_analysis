begin
//  if not qryClientenaoexibirfichafinanceira.AsBoolean then
    result := ExibirFichacliente(qryClientecodigo.AsInteger,
                                 'C',
                                 qryClientenome.AsString,
                                 FormOrigem)


{  else
    Result := False;
}
end;


function Tdtmfrentecaixa.SelecionarClienteVenda(RetornoFluxoTelaCliente: boolean = false): boolean;
begin
  result := true;
  if ParSistema.FrenteCaixaComCliente then
  begin
    if  (dtmFrenteCaixa.ClienteVenda = 0) then
    begin
      if not parsistema.ObrigaClienteFrenteCaixa then
      begin
        result := true;
        if not RetornoFluxoTelaCliente then
          if (MensagemConfirmacao('Deseja informar o cliente ?') = smbOK) then
          begin
            ConsultarClientes(true);
            result := ClienteVenda <> 0;  {Vai retornar false de imediato, ao fechar a janela de clientes retorna o fluxo onde foi chamada}
          end;
      end
      else
      begin
        if not RetornoFluxoTelaCliente then
          ConsultarClientes(true);
        result := ClienteVenda <> 0;
      end;
    end;
  end;
end;

procedure Tdtmfrentecaixa.RetornarFluxoIniciarVenda;
begin
  if assigned(RetornarFluxoVendaItem) then
