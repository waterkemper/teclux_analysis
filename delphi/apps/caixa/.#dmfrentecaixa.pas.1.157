procedure Tdtmfrentecaixa.VenderItemT;
begin

  if not assigned(VenderItemThread) then
    VenderItemThread := TVenderItemThread.Create(false);

    with VenderItemThread do
    begin
  //    Priority := tpTimeCritical;
  //    FreeOnTerminate := true;
      OnTerminate := self.OnTerminateVenderItemT;
      execute;
    end;

  //  VenderItemThread.free;
  //  VenderItemThread := nil;


end;

procedure Tdtmfrentecaixa.OnTerminateVenderItemT(Sender: TObject);
begin
  if vContinuarLeituraCodigoBarras and (qryProdutosDigitados.recordcount<>0) then
    VenderItemThread.execute;
end;

procedure Tdtmfrentecaixa.RetornarJanelaMaximizada;
begin
  if assigned(MaximizarJanela) then
    MaximizarJanela(nil);

end;

procedure Tdtmfrentecaixa.VenderItensdoContrato(Contrato: String);
begin

  RefazConsultaPorNome(qrycontratos, ['contrato'], [Contrato]);

  Validarcreditotroca(qryContratos.fieldByName('cliente').asInteger,
                     qryContratos.fieldByName('tipocliente').asString,
                     qryContratos.fieldByName('creditotroca'),

                     {
                     qryContratos.fieldByName('totalprodutos').AsCurrency +
                     qryContratos.fieldByName('totalservicos').AsCurrency +
                     qryContratos.fieldByName('frete').AsCurrency +
                     qryContratos.fieldByName('seguro').AsCurrency,}

                     qryContratos.fieldByName('valorprazo').AsCurrency,

                     dmvisualizarsaldotroca.SeValorMaiorSaldo,

                     False,
                     true,
                     'O Valor do crédito de troca será reatualizado.');

  if qryContratos.state = dsedit then
    qryContratos.post;

  SelecionarVendedor(False, qryContratos.fieldByname('vendedor').AsInteger);

  RefazConsultaPorNome(qryProdutosContratos, ['contrato'], [contrato]);

  qryProdutosContratos.first;
  while not qryProdutosContratos.eof do
  begin
    if ExisteProduto(qryProdutosContratos.fieldbyname('produtovisual').AsString, StrToInt64(qryProdutosContratos.fieldbyname('produto').AsString) ) then
    begin

      if (ClienteVenda <> qryContratos.fieldByname('cliente').AsInteger) then
      begin
        RefazConsultaPorNome(qryCliente,['codigo'],[qryContratos.fieldByname('cliente').AsInteger]);
        clienteVenda := qryclientecodigo.asinteger;
        nomeclienteVenda := qryclientenome.asstring;
      end;

      if GuardarItem(qryProdutosContratos.fieldbyname('quantidade').AsFloat, qryProdutosContratos.fieldbyname('valordescontoitem').AsFloat, false) then
      begin
        qryProdutosDigitados.edit;
        qryProdutosDigitadospreco.AsCurrency := qryProdutosContratos.fieldbyname('precovenda').AsCurrency;
        qryProdutosDigitados.post;

        {
        qryProdutosContratos.Edit;
        qryProdutosContratosvendido.AsFloat := qryProdutosContratos.fieldbyname('quantidade').AsFloat;
        qryProdutosContratos.Post;
        }

        if dtmFrenteCaixa.CondicaoVenderItem then
          if VendaAberta or IniciarVenda then
            dtmFrenteCaixa.VenderItemT;
      end;
    end;

    while true do
    begin
      if vContinuarLeituraCodigoBarras and (qryProdutosDigitados.recordcount=0) then
        break;
    end;

    qryProdutosContratos.next;
  end;
end;

function Tdtmfrentecaixa.CancelarNFCeNaoEnviada: boolean;
begin
  qryDadosFiscais.edit;
  qryDadosFiscaissituacao.asString := 'C';
  qryDadosFiscaisdatacancelamento.AsDateTime := DataLocal;
  qryDadosFiscais.post;
  vDadoFiscalOrigem := qryDadosfiscaisnumero.asinteger;
  //Limpar o campo movimento dos itens da nota
  LimparCampos(qryProdutosDadosFiscais, [qryProdutosDadosFiscaismovimento]);
  LimparCampos(qryVenctosDadosFiscais, [qryVenctosDadosFiscaistransacao]);
  LimparTabela(qryMovimentos, true);
  result := perpetrar([qryDadosFiscais, qryVenctosDadosFiscais, qryProdutosDadosFiscais, qryMovimentos]);
end;

function Tdtmfrentecaixa.GerarDadosContingencia: boolean;
begin
  //Ja deixar a situação da nota que que não teve retorno do sefaz como cancelada

  result :=  CancelarNFCeNaoEnviada;

  if result then
  begin
    qrydadosfiscais.close;
    qryprodutosdadosfiscais.close;
    qryvenctosdadosfiscais.close;
    qrymovimentos.close;
    qrynotas.close;
    AtribuirDados(qryProdutosVendidos, [qryProdutosVendidosestoqueverificado], [False]);

    result := NotasFiscaisCupom;
    if result then
    begin
      qryDadosFiscais.edit;
      qryDadosFiscaisdadofiscalorigem.asinteger :=  vDadoFiscalOrigem;
      qryDadosFiscais.post;
      Result := Perpetrar([qryDadosFiscais, qryMovimentos, qryProdutosDadosFiscais, qryVenctosDadosFiscais, qryNotas,
                           qryCupons, qrySeriesFiliais]);

    end;
  end;
end;

function Tdtmfrentecaixa.GetCondicaoEmissorNFCE: Boolean;
begin
  if qryDadosFiscais.recordcount <> 0 then
    fCondicaoEmissorNFCE := (parsistema.Emissor_de_NFC_e and
                            (qryDadosFiscaismodelodocto.AsString = '65'))

  else
    fCondicaoEmissorNFCE := (parsistema.Emissor_de_NFC_e and
                            (ModeloDoctoFiscalNFCe = '65'));

  Result := fCondicaoEmissorNFCE;


end;

procedure Tdtmfrentecaixa.SalvarRegistro_h2;
begin
  if not qryregistro_h2.Active then
    qryregistro_h2.open;
    
  qryregistro_h2.Append;
  qryregistro_h2filial.AsInteger := FilialBase;
  qryregistro_h2cnpj_credenciadora.AsString := '11111111111111';
  qryregistro_h2numero_fabricacao.AsString := ECFPadrao.SerieMaquina;
  qryregistro_h2coo.AsString := inttostr(strtoint(ECFPadrao.Cupom) - 1);
  qryregistro_h2ccf.AsString := ECFPadrao.NumCCF;
  qryregistro_h2valor_troco.AsCurrency := FSaldoRestante;
  qryregistro_h2data_troco.AsDateTime := DataHoraServidor;
  qryregistro_h2cpf.AsString := somentenumero(qryClientepessoanumero.AsString);
  qryregistro_h2titulo.AsString := '1111111';

  qryregistro_h2hash_registro_h2.AsString  := ACBREad1.MD5FromString(
      qryregistro_h2cnpj_credenciadora.AsString +
      qryregistro_h2numero_fabricacao.AsString +
      qryregistro_h2coo.AsString +
      qryregistro_h2ccf.AsString +
      Trim(Trocar(Trocar(formatarvalor( qryregistro_h2valor_troco.AsCurrency,2),'.',''),',','.')) +
      DateTimeToStr(qryregistro_h2data_troco.AsDateTime) +
      qryregistro_h2cpf.AsString +
      qryregistro_h2titulo.AsString);
  qryregistro_h2.post;
  perpetrar([qryregistro_h2]);




end;

