{ TVenderItemThread }

procedure TVenderItemThread.Execute;
begin
  inherited;
  if not terminated then
    Synchronize(VenderItemThread);
end;


procedure TVenderItemThread.VenderItemThread;
begin
  if vLogMessageFrenteCaixa then
    ShowMessage('5 - TVenderItemThread.VenderItemThread');
  dtmFrenteCaixa.VenderItem;
end;

procedure Tdtmfrentecaixa.qryRecebimentosBeforeClose(DataSet: TDataSet);
begin
  inherited;
;
end;

procedure Tdtmfrentecaixa.qryTotalRecebimentoNewRecord(DataSet: TDataSet);
begin
  inherited;

  if parsistema.TipoPadraoDesconto = 'R$' then
  begin
    qryTotalRecebimentotipodesconto.asString := 'V';
    qryTotalRecebimentotipoacrescimo.asString := 'V';
  end
  else
  if parsistema.TipoPadraoDesconto = '%' then
  begin
    qryTotalRecebimentotipodesconto.asString := 'P';
    qryTotalRecebimentotipoacrescimo.asString := 'P';
  end;


end;

procedure Tdtmfrentecaixa.qryTotalRecebimentoAfterPost(DataSet: TDataSet);
begin
  inherited;
  CalcularCashBackGerado;
end;

end.
