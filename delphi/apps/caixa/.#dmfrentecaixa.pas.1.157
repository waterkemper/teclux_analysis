function Tdtmfrentecaixa.ImprimirNotaFiscal: boolean;
begin
  vSituacaoImpressaoDanfe := Nenhuma;
  result := true;

  if
     (CondicaoEmissorNFCE  and not assigned(ecfpadrao)) or
     notafiscalvinculada then

    if qryDadosFiscais.Active then
    begin
      if ( not(CondicaoEmissorNFE) or (NumeroNotaFiscalVinculada>0)) then
      begin
        dtmImprimeFiscal := TdtmImprimeFiscal.Create(Self);
        try
        //  qryDadosFiscais.First;
        //  while Not qryDadosFiscais.Eof do begin
            //se for nota fiscal manual não é para imprimir
            if not (NumeroNotaFiscalVinculada>0) then
              dtmImprimeFiscal.ImprimirNota(qryDadosFiscaisnumero.AsInteger, qrySeriesFiliaismodelonota.asinteger);
        //    qryDadosFiscais.Next
        //  end;
        finally
          dtmImprimeFiscal.Free;
          dtmImprimeFiscal := nil;
        end;
      end
      else
      begin
        case EmitirNFCe of
          EntraremContingencia:
          begin
            result := GerarDadosContingencia;
            if result then
              result := (EmitirNFCe(false, true) = xmlcontigenciagerado);
          end;
          ArquivosRetornados: result := true;
          Erro : begin
                   result := false;
                   fExcecao := true;
                 end;
        end;

      end;
    end;
end;

function Tdtmfrentecaixa.EmitirNFCe(Validando: Boolean = False; Contingencia: Boolean = false): TtecRetornoEnvioNFCe;
var
  erroestoque, produto, filial, ChaveAcesso,
  LoteNFe, ReciboNFe, ProtocoloNFe, status, xMotivo, DataHoraProcessamento : String;
  vResult : Boolean;
  vProcedimento : TtecProcedimento;
  vListaNFeEmailValidos : String;

begin
  try
    vMensagemExcessao := '';
    vProcedimento := Enviar;
    result := Aguardar;
    vResult := true;
    if not Validando then
      NFe := TTecNotaFiscalEletronica.Create
    else
      NFe := TTecNotaFiscalEletronica.Create(dtmTecSoft.Database);

      {
    NFe.DiretorioEnvio       := NFeDirEnvio;
    NFe.DiretorioEnviado     := NFeDirEnviados;
    NFe.DiretorioRetorno     := NFeDirRetorno;
    NFe.DiretorioCompartilha := NfeDirCompartilha;
    NFe.Executavel           := NFeExecNFe;
    }

    NFe.Validando := Validando;

    if not Validando then
    begin
      if not Contingencia then
      begin
        result := NFe.VerificarStatusServicoNFCe(IntToStr(NFeAmbiente));
        case result  of

          TesteValidacaoOK     :
          begin
            qryDadosFiscais.edit;
            qryDadosFiscaisformaemissao.AsString := '1';  //normal
            NFE.Tipo_de_Emissao_UniNfe := '1';
            qryDadosFiscaisdhcont.clear;
            qryDadosFiscaisxjustcont.clear;
          end;

          EntraremContingencia :
          begin
             qryDadosFiscais.edit;
             qryDadosFiscaisformaemissao.AsString := '9'; //9-Contingência off-line da NFC-e
                                                          //3-Contingência scan NFE
             if not contingencia then  // não estava em contigencia e esta entrando
             begin
               parsistema.RazaoContingenciaNFCe := 'SERVIÇO SEFAZ NÃO ESTA EM OPERAÇÃO';
               NFE.Tipo_de_Emissao_UniNfe := '9';
             end;

             qryDadosFiscaisdhcont.asString := parsistema.DataHoraInicialContingenciaNFCe;
             qryDadosFiscaisxjustcont.asString := parsistema.RazaoContingenciaNFCe;
             vProcedimento := Assinar;
          end;

        end;
      end
      else
      begin
        qryDadosFiscais.edit;
        qryDadosFiscaisformaemissao.AsString := '9'; //9-Contingência off-line da NFC-e
                                                    //3-Contingência scan NFE
        parsistema.RazaoContingenciaNFCe := 'TEMPO MÁXIMO DE ESPERA ESGOTADO';
        NFE.Tipo_de_Emissao_UniNfe := '9';

        qryDadosFiscaisdhcont.asString := parsistema.DataHoraInicialContingenciaNFCe;
        qryDadosFiscaisxjustcont.asString := parsistema.RazaoContingenciaNFCe;

        result := EntraremContingencia;
        vProcedimento := Assinar;
      end;
    end;

    if result <> Erro then
    begin
      vresult := GerarNotaEletronica(qryDadosFiscais, nil, qryProdutosDadosFiscais,
                nil, nil,
                qryVenctosDadosFiscais, nil, nil,
                nil, nil, nil, qryNotasserie.asString, 'S',
                qryCupons, false, nil,
                qryTotaisRecebimentos, vProcedimento {Enviar},
                Validando, nil, qryNotas,
                qrymovimentos, false, false, true );

      result := vTtecRetornoEnvioNFCe;

      (*
      if qryDadosFiscaisnrdocumento.AsInteger  <> qryNotasnumero.AsInteger then
        qryDadosFiscaisnrdocumento.AsInteger  := qryNotasnumero.AsInteger;

      qryDadosFiscaiscodaleatorio.AsInteger    := Aleatorio(qryDadosFiscaisdata.AsDateTime, qryDadosFiscaisnrdocumento.asString);

      ChaveAcesso :=
                 copy(CodigoCidadeIBGEFilialBase,1,2)+                       // 2
                 FormatDateTime('YYMM',qryDadosFiscaisdata.AsDateTime)+      // 4
                 preencheString(CNPJFilialBase,'0',14,false) +
                 preencheString(qryDadosFiscaismodelodocto.AsString,'0',2,false)+ // 2
                 preencheString(qryNotasserie.asString,'0',3,false)+                  // 3
                 preencheString(qryDadosFiscaisnrdocumento.Asstring,'0',9,false) + // 9
                 qryDadosFiscaisformaemissao.AsString + //1
                 preencheString(qryDadosFiscaiscodaleatorio.Asstring,'0',8,false);  // 8

      qryDadosFiscaisdigchaveacesso.AsString   := Modulo11(ChaveAcesso);
      qryDadosFiscaischv_nfe.AsString := ChaveAcesso + qryDadosFiscaisdigchaveacesso.AsString;

      {1 - PRODUÇÃO 2 - HOMOLOGAÇÃO}
      qryDadosFiscaisambiente.AsInteger         := NFeAmbiente;// '2';

      {1 - normal 2 - compelementar}
      if qryDadosFiscaisdadofiscalcomplementar.AsInteger=0 then
         qryDadosFiscaisfinalidadenf.AsInteger  := 1
      else
         qryDadosFiscaisfinalidadenf.AsInteger  := 2;

      qryDadosFiscaisprocemissao.AsString      := '0';
      qryDadosFiscaisversaoteclux.AsString     := VersaoTecLUX;

      qryDadosFiscaisinfcomplementar.AsString:= qryDadosFiscaisinfcomplementar.AsString  + ' ' +  sLineBreak +
                                                qryDadosFiscaisobservacoes.AsString + ' ' + sLineBreak +
                                                qryDadosFiscaisobservacoesicmssubstituido.AsString;

    //  if qryClientenosimples.AsBoolean then
      if (regimetributario = 1) and //simples
           (parsistema.obsnfeClientesnoSimples <> '') then
        qryDadosFiscaisinfcomplementar.AsString := qryDadosFiscaisinfcomplementar.AsString + ' ' +  sLineBreak +
                                                   parsistema.obsnfeClientesnoSimples;

      if not validando then
      begin
        ShowProcessando('Gerando o arquivo da NF-e!');
        Sleep(500);
      end;

      // EMITENTE
      NFe.Emit_Documento := CNPJFilialBase;
      NFe.Emit_Nome      := RazaoFilialBase;

      NFe.Emit_Rua       := RuaSemNumeroFilialBase;
      NFe.Emit_Nro       := NumeroFilialBase;
      NFe.Emit_Compl     := ComplementoFilialBase;
      NFe.Emit_Bairro    := BairroFilialBase;
      NFe.Emit_CodMun    := CodigoCidadeIBGEFilialBase;
      NFe.Emit_Mun       := CidadeFilialBase;
      NFe.Emit_UF        := EstadoFilialBase;
      NFe.Emit_CEP       := CEPFilialBase;
  //    NFe.Emit_CodPais   := 1058;
  //    NFe.Emit_Pais      := 'Brasil';
      NFe.Emit_Fone      := DDDFilialBase+FoneFilialBase;
      NFe.Emit_IE        := InscricaoEstadualFilialBase;
  //    NFe.Emit_IEST      := '';
      NFe.Emit_IM        := InscricaoMunicipalFilialBase;
      NFe.Emit_CNAE      := CNAEFiscalFilialBase;
      NFe.Emit_CRT       := qryDadosFiscaisregimetributario.AsInteger;

      // DESTINATARIO
      NFe.Dest_TipoPessoa := qryDadosFiscaispessoatipo.AsString;
      NFe.Dest_Documento := qryDadosFiscaispessoanumero.AsString;
      NFe.Dest_Nome      := qryDadosFiscaisnome.AsString;

      NFe.Dest_Rua       := qryDadosFiscaisrua.AsString;
      NFe.Dest_Nro       := qryDadosFiscaisendnumero.AsString;
      NFe.Dest_Compl     := qryDadosFiscaisendcomplemento.AsString;
      NFe.Dest_Bairro    := qryDadosFiscaisnomebairro.AsString;
      NFe.Dest_CodMun    := qryDadosFiscaiscidadeibge.AsString;
      NFe.Dest_Mun       := qryDadosFiscaisnomecidade.AsString;
      NFe.Dest_UF        := qryDadosFiscaisestado.AsString;
      NFe.Dest_CEP       := qryDadosFiscaiscep.AsString;
      NFe.Dest_CodPais   := qryDadosFiscaispais.AsInteger;
      NFe.Dest_Pais      := qryDadosFiscaisnomepais.AsString;
      NFe.Dest_Fone      := qryDadosFiscaisfoneddd.AsString+qryDadosFiscaisfonenumero.AsString;

      NFe.Dest_IE        := qryDadosFiscaisdocumento.AsString;
      NFe.Dest_ISUF      := qryDadosFiscaisiesubsttributario.AsString;

      // ENTREGA
      NFe.Entrega_Documento := qryDadosFiscaislocalentrega_cnpj.AsString;
      nfe.Entrega_Nome      := qryDadosFiscaisentnomedestinatario.asString;
      NFe.Entrega_Rua       := qryDadosFiscaislocalentrega_rua.AsString;
      NFe.Entrega_Nro       := qryDadosFiscaislocalentrega_numero.AsString;
      NFe.Entrega_Compl     := qryDadosFiscaislocalentrega_complemento.AsString;
      NFe.Entrega_Bairro    := qryDadosFiscaislocalentrega_nomebairro.AsString;
      NFe.Entrega_CodMun    := qryDadosFiscaislocalentrega_cidadeibge.AsString;
      NFe.Entrega_Mun       := qryDadosFiscaislocalentrega_nomecidade.AsString;
      NFe.Entrega_UF        := qryDadosFiscaislocalentrega_estado.AsString;
      nfe.Entrega_cep       := qryDadosFiscaislocalentrega_cep.asString;



      refazConsultaPorNome(qryTotaisRecebimentos,['transacao'],[ftransacao]); //aqui
      {
      if qrytotaisRecebimentos.locate('tiporecebimento','D',[]) then
      begin
        qryTotaisRecebimentos.edit;
        qryTotaisRecebimentosvalorlancto.asCurrency := qryTotaisRecebimentosvalorlancto.asCurrency + abs(FSaldoRestante);
        qryTotaisRecebimentos.post;;
      end;
      }

//      mensagemaviso('retire o cabo de rede');
      if (qrydadosfiscais.state in [dsedit, dsinsert]) then
        qryDadosFiscais.post;


      vResult := NFe.GerarNFe(qryDadosFiscais,nil,qryProdutosDadosFiscais,nil,nil,
                   qryVenctosDadosFiscais,nil,nil,nil,nil,qryNotasSerie.asstring,
                   'S', nil, false, nil, qryTotaisRecebimentos, vProcedimento );

      if vresult and not Validando then
      begin
        if (qryDadosFiscaisformaemissao.AsString = '1') then   //rever nfce   1-Normal 3-contingencia scan nfe 9-Contingencia off line NFCe
        begin
          ShowProcessando('Capturando o número do Lote, Recibo e protocolo da NFC-e!');
          Result := NFe.EnviarNFCe(ChaveAcesso+qryDadosFiscaisdigchaveacesso.AsString, LoteNFe, ReciboNFe, ProtocoloNFe, status, xMotivo, DataHoraProcessamento);
          case result of

            ArquivosRetornados :
            begin
              qryDadosFiscais.Edit;
              qryDadosFiscaisnumlotenfe.AsString   := LoteNFe;
              qryDadosFiscaisnumrecibonfe.AsString := ReciboNFe;
              qryDadosFiscaisnumprotocolonfe.AsString := ProtocoloNFe;
              qryDadosFiscaisstatusnfe.AsString := status;
              qryDadosFiscaisdhprocnfe.AsDateTime :=  FormatarTimeStamp(DataHoraProcessamento);

              qryDadosFiscais.Post;
              vResult := Perpetrar([qryDadosFiscais]);

              if vResult then
              begin
                ShowProcessando;
//                ShowProcessando('Capturando o número do protocolo da NFC-e!');
//                Result := NFe.ConsultarSituacaoLoteNFCe(ReciboNFe, LoteNFe, ProtocoloNFe, status, DataHoraProcessamento, IntToStr(NFeAmbiente));

                case result of

                  ArquivosRetornados :
                  begin
                    {
                    qryDadosFiscais.Edit;
                    qryDadosFiscaisnumprotocolonfe.AsString := ProtocoloNFe;
                    qryDadosFiscaisstatusnfe.AsString := status;
                    qryDadosFiscaisdhprocnfe.AsDateTime :=  FormatarTimeStamp(DataHoraProcessamento);
                    qryDadosFiscais.Post;
                    }

                    if (qryDadosFiscaisstatusnfe.AsString = '301') or
                       (qryDadosFiscaisstatusnfe.AsString = '302') then
                    begin
                      qryDadosFiscais.Edit;
                      qryDadosFiscaissituacao.AsString := 'D';
                      qryDadosFiscais.Post;
                      LimparTabela(qrymovimentos, true);
                      vresult := Perpetrar([qryMovimentos, qryDadosFiscais]);
                      MensagemAviso('Nota fiscal em uso denegado.');
                    end
                    else
                    begin

                      vResult := Perpetrar([qryDadosFiscais]);

                      if vResult then
                      begin
                        ShowProcessando;
                        ShowProcessando('Gerando o arquivo de compartilhamento da NF-e!');
                        Sleep(500);

                        try
                          vResult := NFe.CompartilharXML(ChaveAcesso+qryDadosFiscaisdigchaveacesso.AsString,
                                                        ReciboNFe, qryDadosFiscaisfilialemissao.AsString,
                                                        qryNotasSerie.asstring, qryDadosFiscaisnrdocumento.AsString,
                                                        qryDadosFiscaisdata.AsDateTime, preencheString(LoteNFe,'0',15,False));

//                           raise Exception.Create('Erro ao gerar o compartilhamento');
                        except

                          on E: Exception do
                          begin
                            MensagemAviso(E.Message + 'Erro ao gerar o compartilhamento');
                            vresult := false;
                          end;

                        end;

                        if vResult then
                        begin

                          ShowProcessando('salvando o conteudo do xml da NFCe no banco de dados');

                          try
                            SalvarConteudoxml('S', qryDadosFiscaisnumero.asString);
                          except
                            on E: Exception do
                            begin
                              MensagemAviso(E.Message + 'Erro ao salvar o conteudo do xml da NFCe no banco de dados.');
                              vresult := false;
                              ShowProcessando;
                            end;
                          end;

                          ShowProcessando('Imprimindo o DANFE!');

                          try

                            NFe.ImprimirDanfe({ChaveAcesso+qryDadosFiscaisdigchaveacesso.AsString,}
                                              qryDadosFiscaisfilialvenda.AsString,
                                              qryNotasSerie.asString,
                                              qryDadosFiscaisnrdocumento.AsString,
                                              qryDadosFiscaislocalentrega_cep.AsString,
                                              qryDadosFiscaisemail.AsString,
                                              IntToStr(NFeNVias), NFeLogotipoDANFE,
                                              ParSistema.NomeImpressoraNotaMercadorias, NFeVisualizarDANFE,
                                              qryDadosFiscaisdata.AsDateTime,
                                              qryProdutosDadosFiscais, NFeExecDANFE, Enviar, 'S', abs(FSaldoRestante));

                          except
                            on E: Exception do
                            begin
                              MensagemAviso(E.Message + 'Erro ao Imprimir a DANFE');
                              vresult := false;
                              ShowProcessando;
                            end;
                          end;

                          ShowProcessando;

                          vListaNFeEmailValidos := '';
                          ListaStringEmailValido(ListadeEmails('DF', qryDadosFiscais.fieldbyname('numero').AsInteger), vListaNFeEmailValidos, true);

                          if (vListaNFeEmailValidos         <> '') and
                             (UsuarioLogin.PortaSmtp        <> '') and
                             (UsuarioLogin.HostSmtp         <> '') and
                             (UsuarioLogin.Email            <> '') and
                             (UsuarioLogin.SenhaEmail       <> '') then
                          begin

                            ShowProcessando('Enviando email para o cliente');

                            try
                              if not NFe.EnviarEmail(UsuarioLogin.Email,

                                                  vListaNFeEmailValidos,

                                                  qryDadosFiscaisnrdocumento.AsString, qryNotasSerie.asString,

                                                   IntToStr(FilialBase), '',
                                                  NomeFilialBase, RazaoFilialBase, CNPJFilialBase, DDDFilialBase, FoneFilialBase,
                                                  DDDFaxFilialBase, FaxFilialBase,

                                                  UsuarioLogin.NomeUsuario, UsuarioLogin.PortaSMTP,
                                                  UsuarioLogin.HostSMTP, UsuarioLogin.UsuarioEmail, UsuarioLogin.SenhaEmail,
                                                  qryDadosFiscaisdata.AsDateTime, qryDadosFiscaisvalortotal.AsCurrency,
                                                  UsuarioLogin.AutenticarSMTP, qryDadosFiscaisdata.AsDateTime) then
                                 MensagemAviso('Ocorreu um erro inesperado no envio do email')
                            except

                              on E: Exception do
                              begin
                                MensagemAviso(E.Message + 'Erro ao enviar o email da NFCe');
                                vresult := false;
                                ShowProcessando;
                              end;
                            end;
                            ShowProcessando;
                          end;
                        end
                        else
                          ShowProcessando;
                      end;

                    end;

                  end;

                  EntraremContingencia:
                  begin
                    parsistema.RazaoContingenciaNFCe := 'TEMPO MÁXIMO DE ESPERA ESGOTADO';
                  end;

                end;
              end;
            end;

            EntraremContingencia:
            begin
              parsistema.RazaoContingenciaNFCe := 'TEMPO MÁXIMO DE ESPERA ESGOTADO';
            end;
          end;
        end
        else
        if (qryDadosFiscaisformaemissao.AsString = '9') then
        begin
          try

            if NFe.RetornoValidacaoAssinatura then
            begin
              vResult := Perpetrar([qryDadosFiscais]);
              result := xmlcontigenciagerado;

              if not NFeVisualizarDANFE then
                MensagemAviso('Impressão da Nota Fiscal será iniciada.');

              try

                NFe.ImprimirDanfe({ChaveAcesso+qryDadosFiscaisdigchaveacesso.AsString,}
                                qryDadosFiscaisfilialemissao.AsString,
                                qryNotasSerie.asString,
                                qryDadosFiscaisnrdocumento.AsString,
                                qryDadosFiscaislocalentrega_cep.AsString,
                                qryDadosFiscaisemail.AsString,
                                IntToStr(NFeNVias), NFeLogotipoDANFE,
                                ParSistema.NomeImpressoraNotaMercadorias, NFeVisualizarDANFE,
                                qryDadosFiscaisdata.AsDateTime,
                                qryProdutosDadosFiscais, NFeExecDANFE, vProcedimento, 'S');

              except
                on E: Exception do
                begin
                  MensagemAviso(E.Message + 'Erro ao Imprimir a DANFE');
                  vresult := false;
                  ShowProcessando;
                end;
              end;

            end
            else
              result := ErroValidacaoXMLContigencia;

          except
            on E: Exception do
            begin
              result := ErroValidacaoXMLContigencia;
              vMensagemExcessao := E.Message;
            end;
          end;
          ShowProcessando;
        end;

      end
      else
      begin
        if Validando and not vResult then
          result := Erro
        else
          result := TesteValidacaoOK;
      end;
      *)
    end;
  finally
    SituacaoEmitirNFe := result;
    vSituacaoImpressaoDanfe := Nfe.SituacaoImpressaoDanfe;
    FreeAndNil(NFe); //NFe.Free;
  end;

end;


procedure Tdtmfrentecaixa.IncluirCliente;
begin
  if qryCliente.State in [dsEdit, dsInsert] then
  begin
    if qryCliente.CheckRequiredFields then begin
      if qryCliente.State = dsInsert then begin
//        qryClientesIncluidos.Append;
        spcClientesProximo.Open;
//        qryClientesIncluidoscodigo.AsInteger := spcClientesProximoCodigo.AsInteger;
        qryClientecodigo.AsInteger := spcClientesProximoCodigo.AsInteger;
        if qryCliente.FieldByName('pessoatipo'    ).IsNull then
          qryCliente.FieldByName('pessoatipo'    ).AsString := 'F';
        if qryCliente.FieldByName('fonetipo'      ).IsNull then
          qryCliente.FieldByName('fonetipo'      ).AsString := 'P';
        if qryCliente.FieldByName('restipo'       ).IsNull then
          qryCliente.FieldByName('restipo'       ).AsString := 'A';
        if qryCliente.FieldByName('empcomprovado').IsNull then
          qryCliente.FieldByName('empcomprovado' ).AsBoolean := False;
        if qryCliente.FieldByName('reftipo'       ).IsNull then
          qryCliente.FieldByName('reftipo'       ).AsString  := 'P';
        if qryCliente.FieldByName('automovel'       ).IsNull then
          qryCliente.FieldByName('automovel'     ).AsBoolean  := False;
        if qryCliente.FieldByName('cartaocredito'       ).IsNull then
          qryCliente.FieldByName('cartaocredito' ).AsBoolean  := False;
        if qryCliente.FieldByName('cartaoloja'       ).IsNull then
          qryCliente.FieldByName('cartaoloja'    ).AsBoolean  := False;
        if qryCliente.FieldByName('cheque'       ).IsNull then
          qryCliente.FieldByName('cheque'        ).AsBoolean  := False;
        if qryCliente.FieldByName('chequeespecial'       ).IsNull then
          qryCliente.FieldByName('chequeespecial').AsBoolean  := False;
        if qryCliente.FieldByName('filialcadastro').IsNull then
          qryCliente.FieldByName('filialcadastro').AsInteger := FilialBase;
        spcClientesProximo.Close;

      end;
      qryCliente.Post;
      try
        Perpetrar([qryCliente]);
      except
         on E: Exception do ShowMessage(E.Message);
      end;
    end
  end;
end;

function Tdtmfrentecaixa.IncluirClienteCheque(Numero, Vencto, Valor, Titular: String): boolean;
begin
  qryChequesIncluidos.MasterSource := nil;
  qryChequesIncluidos.first;

  if not qryChequesIncluidos.locate('numero',Numero,[]) then
  begin
    IncluirCliente;
    if qryClientecodigo.AsInteger <> 0 then
    begin
      qryChequesIncluidos.Append;
      qryChequesIncluidosnumero.AsString      := Numero;
      qryChequesIncluidosdata.AsDateTime      := DataServidor;
      qryChequesIncluidosvencto.AsString      := Vencto;
      qryChequesIncluidosvalor.AsFloat        := StrToFloat(Valor);
      qryChequesIncluidoscliente.AsInteger    := qryClientecodigo.AsInteger;
      qryChequesIncluidostipocliente.AsString := 'C';
      qryChequesIncluidostitular.AsString     := Titular;
      qryChequesIncluidosfilial.AsInteger     := FilialBase;
      qryChequesIncluidossituacao.AsString    := 'N';
      qryChequesIncluidosnumeroregistrorecebimentotemp.AsInteger := qryRecebimentosTemp.RecNo;
      qryChequesIncluidos.Post;
      result := true;
    end
    else
    begin
      result := false;
      MensagemAviso('Cliente não cadastrado');
    end;
  end
  else
  begin
    result := false;
    MensagemAviso(ctNUMEROCHEQUECADASTRADO);
  end;
  qryChequesIncluidos.MasterSource := dsrRecebimentosTemp;
end;

function Tdtmfrentecaixa.IncluirProduto: Boolean;
var
  Tributo: TtecTributo;
  CodigoProduto: Integer;
  ColunaPadrao: Integer;
  vValorImpostoNacional: Currency;
  vValorImpostoEstadual: Currency;
  vDescricao: String;

  vValorDesconto : Currency;
  vTipoDesconto : Char;

begin
  result := false;
  try
    vContinuarLeituraCodigoBarras := false;

    if (qryProdutosDigitadosincidencia.AsString = ctTRIBUTADASUBSTITUICAO) or
       (qryProdutosDigitadosincidencia.AsString = ctCOBRADOSUSTITUICAO) or
       (qryProdutosDigitadosincidencia.AsString = ctISENTASUBSTITUICAO) or
       (qryProdutosDigitadosincidencia.AsString = ctREDUCAOBASESUBSTITUICAO) or
       (qryProdutosDigitadoscsosn.AsString =  '201') or    { 201	Tributada pelo Simples Nacional com permissão de crédito e com cobrança do ICMS por substituição tributária }
       (qryProdutosDigitadoscsosn.AsString =  '202') or    { 202	Tributada pelo Simples Nacional sem permissão de crédito e com cobrança do ICMS por substituição tributária }
       (qryProdutosDigitadoscsosn.AsString =  '203') or    {203	Isenção do ICMS no Simples Nacional para faixa de receita bruta e com cobrança do ICMS por substituição tributária }
       (qryProdutosDigitadoscsosn.AsString =  '500')   {500 ICMS cobrado anteriormente por substituição tributária (substituído) ou por antecipação }
    then
      Tributo := tbSubstitui
    else
    if (qryProdutosDigitadosincidencia.AsString = ctNAOTRIBUTADA) or
       (qryProdutosDigitadoscsosn.AsString =  '400')  {Não tributada pelo Simples Nacional}
    then
      Tributo := tbNTributado
    else if ((qryProdutosDigitadosaliquotaicms.AsFloat = 0) or
             (qryProdutosDigitadosincidencia.AsString=ctISENTA) or
             (qryProdutosDigitadoscsosn.AsString =  '103') or {Isenção do ICMS no Simples Nacional para faixa de receita bruta}
             (qryProdutosDigitadoscsosn.AsString =  '300')    {imune}
             ) then
      Tributo := tbIsento
    else
      Tributo := tbTributado;

    vValorImpostoNacional  := 0;
    vValorImpostoEstadual := 0;

    vDescricao := '';
    if not qryProdutosDigitadoscest.isnull then
      vDescricao := '#' + somentenumero(qryProdutosDigitadoscest.asString);

    if not qryProdutosDigitadosncm.isnull then
      vDescricao := vDescricao + '#' + somentenumero(qryProdutosDigitadosncm.asString);

    if vDescricao <> '' then
      vDescricao := vDescricao + '#' + qryProdutosdigitadosdescricao.AsString
    else
      vDescricao := qryProdutosdigitadosdescricao.AsString;

    vTipoDesconto := '$';
    if qryProdutosDigitadosdescontoehpercentual.asBoolean then
      vTipoDesconto := '%';

    if qryProdutosDigitadosdescontoehpercentual.asBoolean then
      vValorDesconto := Truncar((((qryProdutosDigitadospreco.AsFloat * qryProdutosDigitadosquantidade.ascurrency) * qryProdutosDigitadosDesconto.ascurrency) /100), 2)
    else
      vValorDesconto := qryProdutosDigitadosDesconto.ascurrency;

    if assigned(ECFPadrao)  then
      ECFPadrao.VenderItem(qryProdutosDigitadosprodutodigitado.AsString,
                           vdescricao,
                           Truncar(qryProdutosDigitadospreco.ascurrency, 2),
                           qryProdutosDigitadosquantidade.ascurrency,
                           qryProdutosDigitadosunidade.AsString,
                           qryProdutosDigitadosaliquotaicms.AsString,
                           '$' {vTipoDesconto,},
                           vValorDesconto, { qryProdutosDigitadosDesconto.ascurrency,}
                           IntToStr(FilialBase),
                          Tributo,
                          qryprodutosDigitadosproducaopropria.asboolean);



    if parsistema.Lei12741_2012_Transparencia then
    begin
      if chaveibpt='' then
        chaveibpt:=qryProdutosDigitadoschaveibpt.AsString;


      {
      if qryProdutosDigitadosorigem.asinteger = 0 then
      begin
        vValorImpostoNacional  := roundto(qryProdutosDigitadosnacionalfederal.AsCurrency * (qryProdutosDigitadospreco.AsFloat-qryProdutosDigitadosDesconto.ascurrency) * qryProdutosDigitadosquantidade.AsCurrency / 100, -2);
        vValorImpostoEstadual  := roundto(qryProdutosDigitadoscargaestadual.AsCurrency * (qryProdutosDigitadospreco.AsFloat-qryProdutosDigitadosDesconto.ascurrency) * qryProdutosDigitadosquantidade.AsCurrency / 100, -2);
        valortotalimpostoibt := valortotalimpostoibt + vValorImpostoNacional + vValorImpostoEstadual;
        valortotalimpostofederal := valortotalimpostofederal + vValorImpostoNacional;
        valortotalimpostoestadual := valortotalimpostoestadual + vValorImpostoEstadual;
      end
      else
      if qryProdutosDigitadosorigem.asinteger in [1,2,3,4,5,6,7] then
      begin
        vValorImpostoNacional  := roundto(qryProdutosDigitadosimportadosfederal.AsCurrency * (qryProdutosDigitadospreco.AsFloat-qryProdutosDigitadosDesconto.ascurrency) * qryProdutosDigitadosquantidade.AsCurrency / 100, -2);
        vValorImpostoEstadual  := roundto(qryProdutosDigitadoscargaestadual.AsCurrency * (qryProdutosDigitadospreco.AsFloat-qryProdutosDigitadosDesconto.ascurrency) * qryProdutosDigitadosquantidade.AsCurrency / 100, -2);
        valortotalimpostoibt := valortotalimpostoibt + vValorImpostoNacional;
        valortotalimpostofederal := valortotalimpostofederal + vValorImpostoNacional;
        valortotalimpostoestadual := valortotalimpostoestadual + vValorImpostoEstadual;
      end;
      }

      if qryProdutosDigitadosorigem.asinteger = 0 then
      begin
        vValorImpostoNacional  := roundto(qryProdutosDigitadosnacionalfederal.AsCurrency * ((qryProdutosDigitadospreco.AsFloat * qryProdutosDigitadosquantidade.AsCurrency) - vValorDesconto) / 100, -2);
        vValorImpostoEstadual  := roundto(qryProdutosDigitadoscargaestadual.AsCurrency * ((qryProdutosDigitadospreco.AsFloat * qryProdutosDigitadosquantidade.AsCurrency) - vValorDesconto) / 100, -2);
        valortotalimpostoibt := valortotalimpostoibt + vValorImpostoNacional + vValorImpostoEstadual;
        valortotalimpostofederal := valortotalimpostofederal + vValorImpostoNacional;
        valortotalimpostoestadual := valortotalimpostoestadual + vValorImpostoEstadual;
      end
      else
      if qryProdutosDigitadosorigem.asinteger in [1,2,3,4,5,6,7] then
      begin

        vValorImpostoNacional  := roundto(qryProdutosDigitadosimportadosfederal.AsCurrency * ((qryProdutosDigitadospreco.AsFloat * qryProdutosDigitadosquantidade.AsCurrency) - vValorDesconto) / 100, -2);
        vValorImpostoEstadual  := roundto(qryProdutosDigitadoscargaestadual.AsCurrency * ((qryProdutosDigitadospreco.AsFloat * qryProdutosDigitadosquantidade.AsCurrency) - vValorDesconto) / 100, -2);
        valortotalimpostoibt := valortotalimpostoibt + vValorImpostoNacional;
        valortotalimpostofederal := valortotalimpostofederal + vValorImpostoNacional;
        valortotalimpostoestadual := valortotalimpostoestadual + vValorImpostoEstadual;
      end;

    end;

    if assigned(ECFPadrao)  then
      Result := Not ecfpadrao.erro
    else
      result := true;

    if Result then
    begin
      if assigned(ECFPadrao) then
      begin
        ECFPadrao.AtualizarTotalizadorGeral(NomeArquivoECFs);
        Result := Not ecfpadrao.erro;
      end;

      if Result then
        dtmFrenteCaixa.SituacaoCupom := scProdutos;
    end;

    if assigned(ECFPadrao) then
      if ecfpadrao.erro then
        MensagemErro(ECFPadrao.Mensagem);


    if Result  then
    begin
      qryProdutosVendidos.DisableControls;
      qryProdutosVendidos.Append;
      qryProdutosVendidosproduto.AsString     := qryProdutosDigitadoscodigo.AsString;
      qryProdutosVendidosprodutovisual.AsString := qryProdutosDigitadoscodigovisual.AsString;
      qryProdutosVendidosprodutodigitado.AsString := qryProdutosDigitadosprodutodigitado.AsString;

      qryProdutosVendidosfilial.AsInteger     := FilialBase;
      qryProdutosVendidosusuario.AsInteger    := UsuarioLogin.CodigoUsuario;
      qryProdutosVendidosquantidade.AsCurrency := qryProdutosDigitadosQuantidade.AsCurrency;

      qryProdutosVendidosdesconto.AsCurrency  := vValorDesconto;

      qryProdutosVendidosdata.AsDateTime      := DataServidor;
      qryProdutosVendidosvalor.AsCurrency     := qryProdutosDigitadospreco.AsCurrency;
      qryProdutosVendidosdescricao.AsString   := qryProdutosDigitadosdescricao.AsString;
      qryProdutosVendidostotalitem.AsCurrency := Truncar((qryProdutosDigitadosQuantidade.AsCurrency * qryProdutosDigitadospreco.AsFloat),2)-vValorDesconto;
      qryProdutosVendidospercreducaobase.AsFloat := qryProdutosDigitadospercreducaobase.AsFloat;
      qryProdutosVendidosincidencia.AsString  := qryProdutosDigitadosincidencia.AsString;
      qryProdutosVendidoscsosn.AsString       := qryProdutosDigitadoscsosn.AsString;
      qryProdutosVendidosnumeroitem.AsInteger := qryProdutosVendidos.RecordCount + 1;
      qryProdutosVendidosaliquotaicms.AsFloat := qryProdutosDigitadosaliquotaicms.AsFloat;
      qryProdutosVendidosaliquotaipi.AsFloat  := qryProdutosDigitadosaliquotaipi.AsFloat;
      qryProdutosVendidosbrinde.AsBoolean     := qryProdutosDigitadosbrinde.AsBoolean;
      qryProdutosVendidosunidade.AsString     := qryProdutosDigitadosunidade.AsString;
      qryProdutosVendidosnacionalfederal.AsCurrency := qryProdutosDigitadosnacionalfederal.AsCurrency;
      qryProdutosVendidosimportadosfederal.AsCurrency := qryProdutosDigitadosimportadosfederal.AsCurrency;
      qryProdutosVendidoscargaestadual.AsCurrency := qryProdutosDigitadoscargaestadual.AsCurrency;
      qryProdutosVendidoschaveibpt.AsString:=qryProdutosDigitadoschaveibpt.AsString;
      qryProdutosVendidosvalorimpostonacional.AsCurrency := vValorImpostoNacional;
      qryProdutosVendidosvalorimpostoestadual.AsCurrency := vValorImpostoEstadual;

      if Not qryVendedorcodigo.IsNull then
        qryProdutosVendidosvendedor.AsInteger := qryVendedorcodigo.AsInteger;

      qryProdutosVendidoscomposto.AsBoolean   := qryProdutosDigitadoscomposto.AsBoolean;
      FValorProdutoBase:= 0;
      if qryProdutosVendidoscomposto.AsBoolean = True then //Detecta se o produto tem composição
      begin
        FTemComposto:= True; //Grava numa varíavel a informação sobre a composição
        RefazConsulta(qryprodutosCompostos, [0], [qryProdutosDigitadoscodigo.AsVariant]); // Executa Filtro recolhendo produtos da composição
        qryProdutosCompostos.First; //Posiciona-se no primeiro produto da composição
        while not qryprodutosCompostos.Eof do  //Varre a tabela até o fim
        begin
          if qryProdutosCompostosComponente.AsInteger > 0 then //Condiciona o prosseguimento a existência do campo componente
          begin
            RefazConsulta(QryPrecos, [0], [QryProdutosDigitadoscaracteristica.asInteger]);
            ColunaPadrao:= qryPrecoscodigo.AsInteger;
            RefazConsultaporNome(qryProduto, ['produtovisual'], [qryProdutosCompostosComponentevisual.AsString]); //Filtra os produtos pelo produtos da compisçãopara encontrar o valor original do produto
            CodigoProduto:= QryProdutocaracteristica.asInteger; //Atribui a caracteristica a variavel
            RefazConsulta(qryColunasPrecos, [0,1], [CodigoProduto,ColunaPadrao]);//busca o preco original do produto na tabela de colunas preços
          end;
          FValorProdutoBase:= FValorProdutoBase + (qryColunasPrecosValor.AsFloat*qryProdutosCompostosquantidade.AsInteger);
          qryProdutosCompostos.Next;
        end;
        FDescontoProdutoComposto:= FDescontoProdutoComposto+(FValorProdutoBase - qryProdutosVendidosvalor.AsCurrency);
        FMensagemDesconto:= 'Você obteve um desconto de '+slinebreak+{#13+#10+}'R$ '+ FormatarValor((FDescontoProdutoComposto+ValorDesconto),2) + ' nesta compra.';

         {ReFazConsulta(qryDiferencaComposto, [0,1,2], [FilialBase,
                                                        qryProdutocaracteristica.AsVariant,
                                                        qryProdutocodigo.AsVariant]);
          qryDiferencaCompostodesconto.AsFloat:=  qryDiferencaCompostopreco.AsFloat -
                                                  qryDiferencaCompostoprecoproduto.AsCurrency; }
      end;
      qryProdutosVendidos.Post;

      qryProdutosVendidos.EnableControls;

      ValorTotalDescontoItem  := ValorTotalDescontoItem + qryProdutosVendidosDesconto.ascurrency;
      FSubTotal      := FSubTotal + Truncar((qryProdutosVendidosQuantidade.AsCurrency * qryProdutosVendidosvalor.AsFloat),2) - qryProdutosVendidosDesconto.ascurrency;
      FTotalPagar    := (FTotalPagar + Truncar((qryProdutosVendidosQuantidade.AsCurrency * qryProdutosVendidosvalor.AsFloat),2));
      ValorAReceber := FTotalPagar - ValorDesconto - Desconto_CashBack - ValorTotalDescontoItem + ValorAcrescimo;
      FSaldoRestante := ValorAReceber;
      FValorTotalQuantidade := FValorTotalQuantidade + qryProdutosVendidosquantidade.AsCurrency;
    end;
  finally
    vContinuarLeituraCodigoBarras := true;
  end;
end;

procedure Tdtmfrentecaixa.IncluirProdutosDadosFiscais(Cont: Integer; NotaVinculada: Boolean);
var
  Preco         : Real;
  EhNormal,
  EhSubstituido,
  EhSubstituicao : Boolean;
begin
  qryProdutosDadosFiscais.First;
  if not qryProdutosDadosFiscais.Locate('produto', qryProdutosVendidosproduto.AsString, []) then
  begin
    qryProdutosDadosFiscais.Append;
    qryProdutosDadosFiscaisproduto.AsLargeInt    := qryProdutosVendidosproduto.AsLargeInt;
    qryProdutosDadosFiscaisprodutodigitado.AsString    := qryProdutosVendidosprodutovisual.AsString;

    qryProdutosDadosFiscaisfilial.AsInteger      := qryProdutosVendidosfilial.AsInteger;
    qryProdutosDadosFiscaisincidencia.AsString   := qryProdutosVendidosincidencia.AsString;
    qryProdutosDadosFiscaisquantidade.AsCurrency := qryProdutosVendidosquantidade.AsCurrency;

    qryProdutosDadosFiscaisnumero.AsInteger      := Cont;
    qryProdutosDadosFiscaisprecovenda.AsFloat    := qryProdutosVendidosvalor.AsFloat;

    qryProdutosDadosFiscaistribquantidade.AsCurrency := qryProdutosVendidosquantidade.AsCurrency;
    qryProdutosDadosFiscaistribunitario.Asfloat := qryProdutosVendidosvalor.AsFloat;
    qryProdutosDadosFiscaisnacionalfederal.AsCurrency := qryProdutosVendidosnacionalfederal.AsCurrency;
    qryProdutosDadosFiscaisvalorimpostonacional.AsCurrency := qryProdutosVendidosvalorimpostonacional.AsCurrency;
    qryProdutosDadosFiscaisimportadosfederal.AsCurrency := qryProdutosVendidosimportadosfederal.AsCurrency;
    qryProdutosDadosFiscaiscargaestadual.AsCurrency:=qryProdutosVendidoscargaestadual.AsCurrency;
    qryProdutosDadosFiscaisvalorimpostoestadual.AsCurrency:=qryProdutosVendidosvalorimpostoestadual.AsCurrency;
    qryProdutosDadosFiscaischaveibpt.AsString:=qryProdutosVendidoschaveibpt.AsString;

    AtribuirDadosProdutos(qryProdutosDadosFiscais,qryDadosFiscais,nil,false,FrentedeCaixa);

    {
    qryProdutosDadosFiscaisprecotabela.AsFloat   := qryProdutosVendidosvalor.AsFloat;
    Preco                                        := Truncar(qryProdutosVendidosvalor.AsFloat * qryProdutosVendidosquantidade.AsCurrency,2);
    qryProdutosDadosFiscaisreducaobase.AsFloat   := RoundTo(Preco * qryProdutosVendidospercreducaobase.AsFloat / 100, -2);
    qryProdutosDadosFiscaisaliquotaicms.AsFloat  := qryProdutosVendidosaliquotaicms.AsFloat;
    qryProdutosDadosFiscaisorigem.AsString       := qryProdutosVendidosorigem.AsString;}


    if Not qryProdutosVendidosvendedor.IsNull then
      qryProdutosDadosFiscaisvendedor.AsInteger  := qryProdutosVendidosvendedor.AsInteger;
    qryProdutosDadosFiscaismovimento.AsInteger   := qryMovimentosnumero.AsInteger;
    qryProdutosDadosFiscaisentregar.AsBoolean    := qryProdutosVendidosentregar.AsBoolean;
    qryProdutosDadosFiscaisvalordescontoitem.AsCurrency := qryProdutosVendidosdesconto.AsCurrency;

    if regimetributario = 1  then //simples
    begin
      EhNormal := Assigned(ECFPadrao) or
                  (Not Assigned(ECFPadrao) and
                  ((qryProdutosVendidoscsosn.AsString = ctSNTributadaSNCPC) or   // 101
                   (qryProdutosVendidoscsosn.AsString = ctSNTributadaSNSPC) or   // 102
                   (qryProdutosVendidoscsosn.AsString = ctSNIsencaoSNFRB  ) or   // 103
                   (qryProdutosVendidoscsosn.AsString = ctSNImume         ) or   // 300
                   (qryProdutosVendidoscsosn.AsString = ctSNNTSN          ) or   // 400
                   (qryProdutosVendidoscsosn.AsString = ctSNOutrosS       )));   // 900

      EhSubstituicao := Not Assigned(ECFPadrao) and
                        NotaSubstituicao(qryProdutosVendidoscsosn.AsString);

      EhSubstituido :=  (Not Assigned(ECFPadrao)) and
                        (qryProdutosVendidoscsosn.AsString = ctSNICMSCobAntST);
    end
    else
    begin
      EhNormal := Assigned(ECFPadrao) or
                  (Not Assigned(ECFPadrao) and
                   ((qryProdutosVendidosincidencia.AsString = ctTRIBUTADA)    or   // '00' Normal
                    (qryProdutosVendidosincidencia.AsString = ctREDUCAOBASE)  or   // '20' Normal
                    (qryProdutosVendidosincidencia.AsString = ctISENTA)       or   // '40' Normal
                    (qryProdutosVendidosincidencia.AsString = ctNAOTRIBUTADA) or   // '41' Normal
                    (qryProdutosVendidosincidencia.AsString = ctSUSPENSAO)    or   // '50' Normal
                    (qryProdutosVendidosincidencia.AsString = ctDIFERIMENTO)));    // '51' Normal


      EhSubstituicao := Not Assigned(ECFPadrao) and
                        NotaSubstituicao(qryProdutosVendidosincidencia.AsString);

      EhSubstituido :=  (Not Assigned(ECFPadrao)) and
                        (qryProdutosVendidosincidencia.AsString = ctCOBRADOSUSTITUICAO);
    end;


    TemNormal        := TemNormal      or EhNormal;
    TemSubstituido   := TemSubstituido or EhSubstituido;
    TemSUBSTITUICAO  := TemSUBSTITUICAO or EhSubstituicao;

    if EhNormal then
      SelecionarCodigoFiscalNatureza(2,'VENDAS DE MERCADORIAS')
    else
    if EhSubstituido then
      SelecionarCodigoFiscalNatureza(2,'VENDAS ICMS SUBSTITUTO')
    else
    if EhSubstituicao then
      SelecionarCodigoFiscalNatureza(2,'VENDAS ICMS SUBSTITUIÇÃO');

  end
  else
  begin
    qryProdutosDadosFiscais.Edit;
    qryProdutosDadosFiscaisquantidade.AsCurrency  := qryProdutosVendidosquantidade.AsCurrency+qryProdutosDadosFiscaisquantidade.AsCurrency;
    qryProdutosDadosFiscaistribquantidade.AsCurrency  := qryProdutosVendidosquantidade.AsCurrency+qryProdutosDadosFiscaistribquantidade.AsCurrency;
    qryProdutosDadosFiscaisvalordescontoitem.AsCurrency := qryProdutosDadosFiscaisvalordescontoitem.AsCurrency + qryProdutosVendidosdesconto.AsCurrency;
  end;
  qryProdutosDadosFiscais.Post;
end;

procedure Tdtmfrentecaixa.IncluirVenctosDadosFiscais;
begin
  if qryVenctosDadosFiscais.State = dsInactive then
    qryVenctosDadosFiscais.Open;

    {
  if numContrato <> '' then
  begin
    qryParcelas.First;
    while not qryParcelas.Eof do
    begin
      qryVenctosDadosFiscais.Append;
      qryVenctosDadosFiscaisdadofiscal.AsInteger   := qryDadosFiscaisnumero.AsInteger;
      qryVenctosDadosFiscaisnumero.AsInteger       := qryParcelasnumero.AsInteger;
      qryVenctosDadosFiscaisdatavencto.AsDateTime  := qryParcelasdatavencto.AsDateTime;
      qryVenctosDadosFiscaisvalorvencto.AsCurrency := qryParcelasvalorvencto.AsFloat;
      qryVenctosDadosFiscais.Post;
      qryParcelas.Next;
    end;
  end
  else
  begin
  }

  qryRecebimentos.First;
  while not qryRecebimentos.Eof do
  begin
    qryVenctosDadosFiscais.Append;
    qryVenctosDadosFiscaisdadofiscal.AsInteger      := qryDadosFiscaisnumero.AsInteger;
    qryVenctosDadosFiscaisnumero.AsInteger          := qryRecebimentos.RecNo;
    qryVenctosDadosFiscaisdatavencto.AsDateTime     := qryRecebimentosdatalancto.AsDateTime;
    qryVenctosDadosFiscaisvalorvencto.AsCurrency    := qryRecebimentosvalorlancto.AsCurrency;
    qryVenctosDadosFiscaistiporecebimento.AsInteger := qryRecebimentostiporecebimento.AsInteger;
    qryVenctosDadosFiscaisformapagamento.AsString   := qryRecebimentostipo.asstring;
//    qryVenctosDadosFiscaisnumerorecebimento.AsInteger := qryRecebimentoscodigo.AsInteger;
    qryVenctosDadosFiscaistransacao.AsInteger       := qryRecebimentostransacao.AsInteger;
    qryVenctosDadosFiscais.Post;
    qryRecebimentos.next;
  end;
end;

function Tdtmfrentecaixa.IniciarVenda: Boolean;
var
  Cupom: String;
  Sair: Boolean;


begin

  try
    vContinuarLeituraCodigoBarras := false;

    Result := not TransferenciaNaoConfirmada;

    if result then
    begin

      IniciarTabelaTotalRecebimento;

      if Assigned(ECFPadrao) then
      begin
        if not ECFPadrao.ImpressoraBloqueada then
        begin
          if Not ECFPadrao.CupomAberto then
          begin
            if true {ECFPadrao.AtivarECF(NomeArquivoECFs, PortaECF, CodigoECF,false)} and
               true {ECFPadrao.VerificarGT(NomeArquivoECFs,false)} then
            begin

              ECFPadrao.IniciarCupom(trim(qryClientepessoanumero.AsString),
                                     trim(qryClientenome.AsString),
                                     EnderecoCliente(qryClienterua.AsString,
                                                     qryClientenumero.AsString,
                                                     qryClientecomplemento.AsString,
                                                     qryClientebairro.AsString,
                                                     qryClientenomebairro.AsString,
                                                     qryClientecidade.AsString,
                                                     qryClientenomecidade.AsString,
                                                     qryClientecep.AsString,
                                                     qryClienteestado.AsString));


              if Assigned(frmMsg) then
                FreeAndNil(frmMsg);

              IniciarTabelaRecebimentoTemp;

            end
            else
              Result := False;
          end;
        end
        else
        begin
          Result := False;
          MensagemErro(ctECFBLOQUEADA);
        end;
        if Assigned(ECFPadrao) and ecfpadrao.erro then
        begin
          MensagemErro(ECFPadrao.Mensagem);
          Result := False
        end
      end
      else
      begin
        if CondicaoEmissorNFCE or (fnaturezajuridica = '2135')  then

          IniciarTabelaRecebimentoTemp

        else
          Result := False;
      end;
    end
    else
      MensagemAviso(ctCAIXATRANSFERENCIANAOCONFIRMADA);

    if Result then
    begin
      FSituacaoCupom := scAberto;
      FCupomTotalizado := False;
      FPagandoTEF := False;

      if Assigned(ECFPadrao) and Not ecfpadrao.erro then
      begin
        Sair := False;
        repeat
          try
            Cupom       := ECFPadrao.Cupom;
            NumeroCupom := StrToInt(Cupom);
            Sair        := True;
            Result      := True
          except
            Result := False
          end
        until Sair;
        if ecfpadrao.erro then
          MensagemErro(ECFPadrao.Mensagem);
      end;
    end;

  finally
    vContinuarLeituraCodigoBarras := true;
  end;
end;

// Ismael em 09/05/2006 - BUG #1800.
procedure Tdtmfrentecaixa.LimpaItensVendidos;
begin
  ReFazConsultaPorNome(qryProdutosVendidos, ['numero'], [0]);
  qryProdutosDigitados.Close;
end;

{
procedure TdtmFrenteCaixa.LimpaPagamentoTMP;
begin
  while not (qryPagamentoTMP.Eof ) do
    qryPagamentoTMP.Delete;
end;
}

function Tdtmfrentecaixa.NotasFiscaisCupom: Boolean;
var
  SituacaoProduto : TtecComposicao;
//  TipoNota: TtecTipoNota;
  Pos: TBookmark;
  Cont {, SerieNroInicial}: Integer;
  TotalProd, vTotalVendido : Real;
begin
  Result := False;
  if qryProdutosDadosFiscais.State = dsInactive then
  begin
    qryProdutosDadosFiscais.Params[0].Clear;
    qryProdutosDadosFiscais.Open;
  end;

  if qryMovimentos.State = dsInactive then
    qryMovimentos.Open;

  if qryDadosFiscais.State = dsInactive then
    qryDadosFiscais.open;

  if VerificarSerieFilial then
  begin
//      SerieNroInicial := qrySeriesFiliaisnumeroinicial.AsInteger;
    BloquearEstoque;
    Pos := qryProdutosVendidos.GetBookmark;
    qryProdutosVendidos.DisableControls;
    try
//        for TipoNota := tnNORMAL to tnSUBSTITUIDO do begin
        Cont          := 0;
        TotalProd     := 0;
        {TotalProdInc  := 0; gedovar 29/12/2014}

        TemNORMAL       := False;
        TemSUBSTITUIDO  := False;
        TemSUBSTITUICAO := False;

        RefazConsulta(qryNaturezasPadrao,[],[]);

        for SituacaoProduto := stNAOCOMPOSTO to stCOMPOSTO do
        begin
          qryProdutosVendidos.First;
          while not qryProdutosVendidos.Eof do
          begin
            if FiltrarComposto(qryProdutosVendidoscomposto.AsBoolean, SituacaoProduto)  then
            begin
              if not qryProdutosVendidos.FieldByName('Cancelado').AsBoolean then
              begin
                qryEstoque.Locate('produto;filial', VarArrayOf(
                                  [qryProdutosVendidosproduto.AsString,
                                   qryProdutosVendidosfilial.AsInteger]) ,[]);

                vTotalVendido := SomarValores(qryProdutosVendidos, [qryProdutosVendidosquantidade],
                                [qryProdutosVendidosproduto, qryProdutosVendidoscancelado, qryProdutosVendidosestoqueverificado],
                                [qryProdutosVendidosproduto.AsString, 'False', 'False'], ['=','False','False']);

                AtribuirDados(qryProdutosVendidos, [qryProdutosVendidosestoqueverificado], [True],
                [qryProdutosVendidosproduto, qryProdutosVendidoscancelado, qryProdutosVendidosestoqueverificado],
                                [qryProdutosVendidosproduto.AsString, 'False', 'False'], ['=','False','False']);

                if vTotalVendido > qryEstoqueemestoque.asfloat then
                begin
                  NovoMovimento(qryProdutosVendidosproduto.AsLargeInt, qryProdutosVendidosfilial.AsInteger);
                  qryMovimentosquantidade.AsCurrency := vTotalVendido - qryEstoqueemestoque.asfloat;
                  qryMovimentosvalor.AsCurrency := qryMovimentosquantidade.AsCurrency * qryEstoqueultimocustomedio.AsCurrency;
                  qryMovimentostipomovimento.AsString := 'FC+';
                  if Assigned(ECFPadrao) then
                    qryMovimentosreferencia.AsString :='FCxa ECF ' + ECFPadrao.Cupom + ifThen(numContrato<>'',' CT '+numContrato,'')
                  else
                    qryMovimentosreferencia.AsString :='FCxa NF ' + qrySeriesFiliaisvalor.asString + '-' +
                                                        qrySeriesFiliaisnumeroinicial.AsString + ifThen(numContrato<>'',' CT '+numContrato,'');
                  qryMovimentos.Post;
                end;

                NovoMovimento(qryProdutosVendidosproduto.AsLargeInt, qryProdutosVendidosfilial.AsInteger);
                qryMovimentosquantidade.AsCurrency := qryProdutosVendidosquantidade.AsCurrency;//Qtdade;
                qryMovimentostipomovimento.AsString := 'SEF';
                if Assigned(ECFPadrao) then
                  qryMovimentosreferencia.AsString :='FCxa ECF ' + ECFPadrao.Cupom + ifThen(numContrato<>'',' CT '+numContrato,'')
                else
                  qryMovimentosreferencia.AsString :='FCxa NF ' + qrySeriesFiliaisvalor.asString + '-' +
                                                      qrySeriesFiliaisnumeroinicial.AsString + ifThen(numContrato<>'',' CT '+numContrato,'');
                qryMovimentos.Post;

                IncluirProdutosDadosFiscais(Cont + 1, NotaFiscalVinculada);
                {TotalProdInc := TotalProdInc + Truncar(qryProdutosVendidosquantidade.AsCurrency*qryProdutosDadosFiscaisprecovenda.AsFloat,2); gedovar 29/12/2014}
                Inc(Cont);
                TotalProd := TotalProd + qryProdutosVendidostotalitem.AsFloat;
              end;
            end;
            qryProdutosVendidos.Next
          end;
        end;

        PreencherDadoFiscal(TotalProd {,TotalProdInc});
        CalcularImpostos(qryProdutosDadosFiscais, qryDadosFiscais, contribipi, true, true, nil, nil, false, FrentedeCaixa, true, false, nil, false, false, false);
//          CalcularDadosFiscais;
        IncluirVenctosDadosFiscais;

{          if (Cont > 0) or ((TipoNota = tnNORMAL) and (qryProdutosVendidos.RecordCount = 0)) then begin
          PreencherDadoFiscal(TipoNota, NotaFiscalVinculada, TotalProd, TotalProdInc);
          CalcularDadosFiscais;
          if Cont <> 0 then
            IncluirVenctosDadosFiscais;
        end else if (Cont > 0) and (((TipoNota = tnSUBSTITUICAO) and not Assigned(ECFPadrao)) or (TipoNota = tnSUBSTITUIDO)) then begin
          CalcularDadosFiscais;
          if Cont <> 0 then
            IncluirVenctosDadosFiscais;
        end;
      end;
}
      Result := qryDadosFiscais.RecordCount > 0;
      if Result then begin
        PreencherNotaFiscal;
        Result := PreencherCupom;
      end
    finally
      qryProdutosVendidos.GotoBookmark(Pos);
      qryProdutosVendidos.FreeBookmark(Pos);
      qryProdutosVendidos.EnableControls
    end
  end;
end;

procedure Tdtmfrentecaixa.NovoMovimento(Produto: int64; Filial: Integer);
var
  ValorICMS: Currency;
begin
  qryMovimentos.Append;
  spcMovimentosProximo.Open;
  qryMovimentosnumero.AsInteger := spcMovimentosProximonumero.AsInteger;
  spcMovimentosProximo.Close;
  qryMovimentosproduto.AsLargeInt   := Produto;
  qryMovimentosfilial.AsInteger     := Filial;
  qryMovimentosprecocomicms.AsFloat := qryProdutosVendidosvalor.AsFloat;
  ValorICMS := RoundTo(qryProdutosVendidosvalor.AsFloat * qryProdutosVendidosaliquotaicms.AsFloat / 100, 2);
  qryMovimentosprecosemicms.AsFloat := qryProdutosVendidosvalor.AsFloat - ValorICMS;
  qryMovimentosaliquotaipi.AsFloat  := qryProdutosVendidosaliquotaipi.AsFloat;
  if ParSistema.FrenteCaixaComCliente and (ClienteVenda<>0) then begin
    qryMovimentoscliente.AsInteger    := ClienteVenda;
    qryMovimentostipocliente.AsString := 'C'
  end
end;

function Tdtmfrentecaixa.PermiteCancelarItens(Var NomeProduto: String): Boolean;
var
  PosAnt: TBookmark;
  Existe: Boolean;
begin
  PosAnt := qryProdutosVendidos.GetBookmark;
  qryProdutosVendidos.DisableControls;
  try
    Existe := False;
    qryProdutosVendidos.First;
    while Not qryProdutosVendidos.Eof do begin
      if qryProdutosVendidosselecionado.AsBoolean and Not qryProdutosVendidoscancelado.AsBoolean then begin
        Existe := True;
        break
      end;
      qryProdutosVendidos.Next
    end;
  finally
    qryProdutosVendidos.GotoBookmark(PosAnt);
    qryProdutosVendidos.FreeBookmark(PosAnt);
    qryProdutosVendidos.EnableControls
  end;
  if Existe then
    Result := True
  else begin
    Result := Not qryProdutosVendidoscancelado.AsBoolean;
    if Not Result then
      NomeProduto := qryProdutosVendidosdescricao.AsString
  end
end;

function Tdtmfrentecaixa.PreencherCupom: Boolean;
var
  NumeroMaquina, Intervencao: Integer;
  NumeroSerie: String;
begin
  if Assigned(ECFPadrao) then begin
    try
      NumeroMaquina := StrToInt(ECFPadrao.NumeroMaquina);
    except
      NumeroMaquina := 0;
    end;
    try
      Intervencao := StrToInt(ECFPadrao.Intervencao);
    except
      Intervencao := 0
    end;
    try
      NumeroSerie := ECFPadrao.SerieMaquina;
    except
      NumeroSerie := ''
    end;
    if ecfpadrao.erro then begin
      MensagemErro(ECFPadrao.Mensagem);
      Result := False
    end else begin
      if qryCupons.State = dsInactive then
        qryCupons.Open;
      qryDadosFiscais.First;
      while Not qryDadosFiscais.Eof do begin
        qryCupons.Append;
        qryCuponsfilial.AsInteger      := FilialBase;
        qryCuponsmaquina.AsInteger     := NumeroMaquina;
        qryCuponsintervensao.AsInteger := Intervencao;
        qryCuponsnumero.AsInteger      := NumeroCupom;
        qryCuponsnumeroserie.AsString  := NumeroSerie;
        qryCuponsdadofiscal.AsInteger  := qryDadosFiscaisnumero.AsInteger;
        qryCupons.Post;
        qryDadosFiscais.Next;
      end;
      Result := True
    end
  end else
    Result := True
end;

procedure Tdtmfrentecaixa.PreencherDadoFiscal(TotalProd: Real);
{
var
  ValorVista,
  ValorNota: Real;
  }
begin
  qryDadosFiscais.Append;
  if (NumeroNotaFiscalVinculada>0) THEN
  begin
    qryDadosFiscaismodelodocto.AsString:='02';
    qryDadosFiscaistipodescsubtotal.AsString:='V';
    qryDadosFiscaistipoacrescsubtotal.AsString:='V';
    qryDadosFiscaiscancacrescsubtotal.AsCurrency:=0.00;
    qryDadosFiscaisordemaplicdesc_e_acresc.AsString:='D';
  end
  else
    qryDadosFiscaismodelodocto.asString := qrySeriesFiliaismodelodoctofiscal.asString;
  
  if (qryDadosFiscaismodelodocto.asString = '65') then
    qryDadosFiscaisformatodanfe.AsInteger    := 4
  else
    qryDadosFiscaisformatodanfe.AsInteger    := 1;

  qryDadosFiscaisdata.AsDateTime            := DataServidor;
  qryDadosFiscaissituacao.AsString          := 'N';
  {O Contrato esta preenchido quando tiver uma emissão de cupom por ordem de serviço, neste caso o campo não é preenchido,
   somente quando a venda por frente de caixa gerará um contrato.}
  if qrycontratos.recordcount = 0 then
    qryDadosFiscaiscontratofrentecaixa.AsString := numContrato
  else
    qryDadosFiscaiscontrato.AsString := numContrato;

  if Not qryVendedorcodigo.IsNull then
    qryDadosFiscaisvendedor.AsInteger       := qryVendedorcodigo.AsInteger;
  if ParSistema.FrenteCaixaComCliente and (ClienteVenda<>0) then begin
    qryDadosFiscaiscliente.AsInteger          := clientevenda;
    qryDadosFiscaistipocliente.AsString       := 'C';
    qryDadosFiscaisnome.AsString              := nomeclientevenda;
  end;
  qryDadosFiscaisfilialvenda.AsInteger     := FilialBase;
  qryDadosFiscaisfilialemissao.AsInteger   := FilialBase;

  if qryorcamentos.recordcount = 1 then
  begin

    qryDadosFiscaisobservacoes.AsString := qryOrcamentos.FieldByName('montagemobs').AsString;
//    qrydadosfiscaiscreditotroca.ascurrency := qryOrcamentos.FieldByName('creditotroca').AsCurrency;
    qryDadosFiscaisorcamento.asinteger := qryOrcamentos.FieldByName('codigo').AsInteger;

    if qryOrcamentos.FieldByName('plano').AsInteger <> 0 then
      qryDadosFiscaisplano.AsInteger := qryOrcamentos.FieldByName('plano').AsInteger
    else
      qryDadosFiscaisplano.clear;
  end;


//  if qryContratos.recordcount = 1 then
//    qrydadosfiscaiscreditotroca.ascurrency := qryContratos.FieldByName('creditotroca').AsCurrency;

  if vValorcreditotroca <> 0 then
    qrydadosfiscaiscreditotroca.ascurrency := vValorcreditotroca;



  if FTemComposto then
  begin
    if qryDadosFiscaisobservacoes.AsString <> '' then
      qryDadosFiscaisobservacoes.AsString := FMensagemDesconto + chr(13) + qryDadosFiscaisobservacoes.AsString
    else
      qryDadosFiscaisobservacoes.AsString := FMensagemDesconto;
  end;


  {
  if TotalProd > 0 then
  begin
    ValorNota  := ((TotalProdInc * FTotalPagar) / TotalProd)-FValorDesconto+FValorAcrescimo;
    ValorVista := ((TotalProdInc * FTotalPagar) / TotalProd)-FValorDesconto;
  end
  else
  begin
    ValorNota  := FTotalPagar-FValorDesconto+FValorAcrescimo;
    ValorVista := FTotalPagar-FValorDesconto;
  end;
  gedovar 29/12/2014}

  if (ValorAcrescimo > ValorDesconto) then
    qryDadosFiscaisvalorvista.AsFloat := valorareceber - (valorAcrescimo - ValorDesconto)
  else
    qryDadosFiscaisvalorvista.AsFloat := valorareceber;

  qryDadosFiscaisvalortotal.AsFloat   := ValorAReceber;

  {
  if qryDadosFiscaisvalortotal.AsFloat > qryDadosFiscaisvalorvista.AsFloat then
    qryDadosFiscaisacrescimofinanceiro.AsCurrency := roundto(qryDadosFiscaisvalortotal.AsFloat - qryDadosFiscaisvalorvista.AsFloat, -2)
  else
    qryDadosFiscaisacrescimofinanceiro.AsCurrency := 0;
  }

  qryDadosFiscaisacrescimofinanceiro.AsCurrency :=  valorAcrescimo;

  qryDadosFiscaisvalorprodutos.AsFloat      := TotalProd;
  qryDadosFiscaisvalorfrete.AsFloat         := 0;
  qryDadosFiscaisseguro.AsFloat             := 0;
  {
  if (ValorAcrescimo > ValorDesconto) then
    qryDadosFiscaisdesconto.AsFloat           := 0
  else
  }
    qryDadosFiscaisdesconto.AsFloat           := ValorDesconto + desconto_cashback {- valorAcrescimo};

  qryDadosFiscaisdesconto_cashback.asFloat := desconto_cashback;

  qryDadosFiscaisvalortotalimpostoibt.AsCurrency := valortotalimpostoibt;
  qryDadosFiscaisvalorimpostonacional.AsCurrency:=valortotalimpostofederal;
  qryDadosFiscaisvalorimpostoestadual.AsCurrency:=valortotalimpostoestadual;

  if not NotaFiscalVinculada then
  begin
    {
    if numContrato = '' then}
      qryDadosFiscaisnatureza.AsString := 'VENDA DE MERCADORIA';
    {
    else
      qryDadosFiscaisnatureza.AsString := 'VENDA A PRAZO';}

    if TemNORMAL then
      SelecionarCodigoFiscalNatureza(1,'VENDAS DE MERCADORIAS')
    else
    if TemSUBSTITUIDO then
      SelecionarCodigoFiscalNatureza(1,'VENDAS ICMS SUBSTITUTO')
    else
    if TemSUBSTITUICAO then
      SelecionarCodigoFiscalNatureza(1,'VENDAS ICMS SUBSTITUIÇÃO');
  end
  else
  begin
    qryDadosFiscaisnatureza.AsString := 'EMISSAO CUPOM FISCAL-ECF';
    SelecionarCodigoFiscalNatureza(1,'VENDAS CUPOM FISCAL');
  end;

  qryDadosFiscaisdatasaida.AsDateTime       := DataServidor;
  qryDadosFiscaisestadocfo.AsString         := EstadoFilialBase;

  AtribuirDadosCliente;

  if qryDadosFiscaispessoatipo.IsNull then
    qryDadosFiscaispessoatipo.AsString        := 'F';

  if listadecasamento <> 0 then
    qryDadosFiscaislistacasamento.asinteger := listadecasamento
  else
    qryDadosFiscaislistacasamento.clear;

  spcDadosFiscaisProximo.Open;
  qryDadosFiscaisnumero.AsInteger := spcDadosFiscaisProximonumero.AsInteger;
  vNumeroDadoFiscal := qryDadosFiscaisnumero.AsInteger;
  spcDadosFiscaisProximo.Close;

  (*
  if numContrato <> '' then
  begin
    if not qryTecContrato.FieldByName('agente').IsNull then
      qryDadosFiscais.FieldByName('agente').AsVariant := qryTecContrato.FieldByName('agente').AsVariant;
    if not qryTecContrato.FieldByName('plano').IsNull then
      qryDadosFiscais.FieldByName('plano').AsVariant := qryTecContrato.FieldByName('plano').AsVariant;
    if not qryTecContrato.FieldByName('cliente').IsNull then
      qryDadosFiscais.FieldByName('cliente').AsVariant := qryTecContrato.FieldByName('cliente').AsVariant;
    if not qryTecContrato.FieldByName('tipocliente').IsNull then
      qryDadosFiscais.FieldByName('tipocliente').AsVariant := qryTecContrato.FieldByName('tipocliente').AsVariant;
    if not qryTecContrato.FieldByName('nome').IsNull then
      qryDadosFiscais.FieldByName('nome').AsVariant := qryTecContrato.FieldByName('nome').AsVariant;
    if not qryTecContrato.FieldByName('rua').IsNull then
      qryDadosFiscais.FieldByName('rua').AsVariant := qryTecContrato.FieldByName('rua').AsVariant;

    if not qryTecContrato.FieldByName('endnumero').IsNull then
      qryDadosFiscais.FieldByName('endnumero').AsVariant := qryTecContrato.FieldByName('endcomplemento').AsVariant;
    if not qryTecContrato.FieldByName('endcomplemento').IsNull then
      qryDadosFiscais.FieldByName('endcomplemento').AsVariant := qryTecContrato.FieldByName('endcomplemento').AsVariant;

    if not qryTecContrato.FieldByName('bairro').IsNull then
      qryDadosFiscais.FieldByName('bairro').AsVariant := qryTecContrato.FieldByName('bairro').AsVariant;
    if not qryTecContrato.FieldByName('cidade').IsNull then
      qryDadosFiscais.FieldByName('cidade').AsVariant := qryTecContrato.FieldByName('cidade').AsVariant;
    if not qryTecContrato.FieldByName('estado').IsNull then
      qryDadosFiscais.FieldByName('estado').AsVariant := qryTecContrato.FieldByName('estado').AsVariant;
    if not qryTecContrato.FieldByName('cep').IsNull then
      qryDadosFiscais.FieldByName('cep').AsVariant := qryTecContrato.FieldByName('cep').AsVariant;
    if not qryTecContrato.FieldByName('pessoatipo').IsNull then
      qryDadosFiscais.FieldByName('pessoatipo').AsVariant := qryTecContrato.FieldByName('pessoatipo').AsVariant;
    if not qryTecContrato.FieldByName('pessoanumero').IsNull then
      qryDadosFiscais.FieldByName('pessoanumero').AsVariant := qryTecContrato.FieldByName('pessoanumero').AsVariant;
    if not qryTecContrato.FieldByName('fonenumero').IsNull then
      qryDadosFiscais.FieldByName('fonenumero').AsVariant := qryTecContrato.FieldByName('fonenumero').AsVariant;
    if not qryTecContrato.FieldByName('foneddd').IsNull then
      qryDadosFiscais.FieldByName('foneddd').AsVariant := qryTecContrato.FieldByName('foneddd').AsVariant;
    if not qryTecContrato.FieldByName('iddocumento').IsNull then
      qryDadosFiscais.FieldByName('documento').AsVariant := qryTecContrato.FieldByName('iddocumento').AsVariant;
    {if not qryTecContrato.FieldByName('observacoes').IsNull then
      qryDadosFiscais.FieldByName('observacoes').AsVariant := qryTecContrato.FieldByName('observacoes').AsVariant;}
    qryDadosFiscais.FieldByName('observacoes').AsVariant := FMensagemDesconto;
  end;
  *)
  qryDadosFiscais.Post;

  qryProdutosDadosFiscais.First;
  while Not qryProdutosDadosFiscais.Eof do begin
    if qryProdutosDadosFiscaisdadofiscal.IsNull then
    begin
      qryProdutosDadosFiscais.Edit;
      qryProdutosDadosFiscaisdadofiscal.AsInteger := qryDadosFiscaisnumero.AsInteger;
    end;
    qryProdutosDadosFiscais.Next
  end;

  qryMovimentos.First;
  while not qryMovimentos.Eof do begin
    qryMovimentos.Edit;
    qryMovimentosdadofiscal.AsInteger:=qryDadosFiscaisnumero.AsInteger;
    qryMovimentos.Next;
  end;


end;

procedure Tdtmfrentecaixa.PreencherNotaFiscal;
var
  CodFiscal: Integer;
begin
  if qryNotas.State = dsInactive then
    qryNotas.Open;
  qryDadosFiscais.last;

  {while Not qryDadosFiscais.Eof do begin}

    CodFiscal := qryDadosFiscaiscodigofiscal.AsInteger mod 1000;
    if (CodFiscal = 910) or
       (((CodFiscal = 949) or
         (CodFiscal = 102) or
         (qryDadosFiscaiscodigofiscal.AsInteger = ctVENDASUBSTITUIDODENTROESTADO) or
         (qryDadosFiscaiscodigofiscal.AsInteger = ctVENDASUBSTITUIDOFORAESTADO)) and
        Not Assigned(ECFPadrao)) or
       NotaFiscalVinculada
    then begin
      qryNotas.Append;
      qryNotasfilial.AsInteger     := FilialBase;

      if(NumeroNotaFiscalVinculada>0) then
      begin
        qryNotasserie.AsString:='D';
        qryNotasnumero.AsInteger:=NumeroNotaFiscalVinculada;
      end
      else
      begin
        qryNotasserie.AsString       := qrySeriesFiliaisvalor.asstring;
        qryNotasnumero.AsInteger     := qrySeriesFiliaisnumeroinicial.AsInteger;
      end;

      qryNotasdadofiscal.AsInteger := qryDadosFiscaisnumero.AsInteger;

      qrySeriesFiliais.Edit;
      qrySeriesFiliaisnumeroinicial.AsInteger := qrySeriesFiliaisnumeroinicial.AsInteger + 1;
      qrySeriesFiliais.Post
    end;
  {
    qryDadosFiscais.Next
  end;
  }

  qryDadosFiscais.last;
end;

procedure Tdtmfrentecaixa.qryClienteNewRecord(DataSet: TDataSet);
begin
  inherited;
  qryClientepessoatipo.AsString := 'F';
end;

function Tdtmfrentecaixa.SalvarVenda(ComTef : Boolean): Boolean;
var
{  vExcecao : Currency;  }
  vResult : Boolean;
  nroautenticacao: integer;
  intervencao,
  maquina: String;
  controle,
  dtmFrenteCaixaCopiaCupom: TdtmFrenteCaixa;
  vSaldoTroco, vSaldoCheque : Currency;
  vFechamentoChequeAut, vFechamentoCartaoAut, vFechamentoDinheiroAut : Currency;
  vFechamentoChequeRec, vFechamentoCartaoRec, vFechamentoDinheiroRec : Currency;


  procedure IncluirAutenticacao(tipo: String; Valor: Currency; Chequenumero : String = '');
  begin

    qryAutenticacao.Append;
    qryAutenticacaonumero.AsInteger := ProximoNumeroAutenticacao;

    if numContrato<>'' then
      qryAutenticacaocontratoparcela.asstring := numContrato
    else
      qryAutenticacaocontratoparcela.clear;

//    qryAutenticacaodata.AsDateTime  := DataServidor;
    qryAutenticacaofilial.AsInteger := FilialBase;
    qryAutenticacaocaixa.AsInteger  := UsuarioLogin.CodigoUsuario;
    if Chequenumero <> '' then
      qryAutenticacaocheque.AsString  := Chequenumero
    else
      qryAutenticacaocheque.clear;

    qryAutenticacaotipo.AsString    := tipo;
    qryAutenticacaovalor.AsFloat    := Valor;

    if Assigned(ECFPadrao) then
    begin
      qryAutenticacaoecf.AsString     := ECFPadrao.Codigo;
      qryAutenticacaonum_usu.AsString := maquina;
      qryAutenticacaocro.AsString     := intervencao;
      qryAutenticacaocoo.AsInteger    := numerocupom;
      qryAutenticacaonum_fab.AsString := ECFPadrao.SerieMaquina;
    end;

    qryAutenticacaotransacao.AsInteger := ftransacao;

    if ClienteVenda <> 0 then
    begin
      qryAutenticacaocliente.AsInteger := ClienteVenda;
      qryAutenticacaotipocliente.AsString := 'C';
    end
    else
    begin
      qryAutenticacaocliente.clear;
      qryAutenticacaotipocliente.clear;
    end;

    qryAutenticacao.Post;

  end;

  function ValidarNFE: boolean;
  begin
    result := true;
    if CondicaoEmissorNFE then
    begin
      case EmitirNFCe(true) of

        erro:
        begin
          result := false;
          MensagemAviso('A NFe vinculada a este cupom não será gerada devido a erros na validação dos campos');
          qrynotas.close;
          qryseriesfiliais.Close;
          LimparTabela(qryProdutosDadosFiscais); //eliminará somente os registros relacionados ao dadofiscal da nota LinkFields := 'numero = dadofiscal';
          LimparTabela(qryVenctosDadosFiscais); //eliminará somente os registros relacionados ao dadofiscal da nota LinkFields := 'numero = dadofiscal';
          qryDadosFiscais.Delete;
        end;
      end;
    end;
  end;

begin
  try
    try
      result := true;

      {Retirar o troco do valor pago em dinheiro}
      vSaldoTroco := abs(SaldoRestante);
      if vSaldoTroco <> 0 then
      begin
        if vValorPagtoDinheiro >= 0 then
        begin
          if vValorPagtoDinheiro >= vSaldoTroco then
          begin
            qryRecebimentos.first;
            while not qryRecebimentos.eof do
            begin
              if qryRecebimentostipo.AsString = 'D' then //dinheiro
              begin
                if qryRecebimentosvalorlancto.AsCurrency >= vSaldoTroco then
                begin
                  qryRecebimentos.Edit;
                  qryRecebimentosvalorlancto.AsCurrency := qryRecebimentosvalorlancto.AsCurrency - vSaldoTroco;
                  qryRecebimentos.post;
                  vSaldoTroco := 0;
                end
                else
                begin
                  vSaldoTroco := vSaldoTroco - qryRecebimentosvalorlancto.AsCurrency;
                  qryRecebimentos.delete;
                end;
              end;

              if vSaldoTroco = 0 then
                break;

              qryRecebimentos.Next;
            end;

            if vSaldoTroco <> 0 then
            begin
              result := false;
              MensagemErro('A venda possui troco de '+ floattostr(vSaldoTroco)+ ' mas não possui pagamento em dinheiro.');
            end;

          end
          else
          begin
            result := false;
            MensagemErro('A venda possui troco de '+ floattostr(vSaldoTroco)+ ' mas não possui pagamento em dinheiro suficiente.');
          end;
        end
        else
        begin
          result := false;
          MensagemErro('A venda possui troco de '+ floattostr(vSaldoTroco)+ ' mas não possui pagamento em dinheiro.');
        end;

        if not result then
        begin
          FExcecao := true;
          if Assigned(ECFPadrao) and not ComTef then
            ECFPadrao.CancelarCupom;
        end;
      end;

      if result then
      begin

        spcTransacaoProximo.Open;
        ftransacao := spcTransacaoProximotransacao.AsInteger;
        spcTransacaoProximo.Close;

        AtribuirDados(qryRecebimentos, [qryRecebimentostransacao], [ftransacao], true);

        if Assigned(EcfPadrao) then
        begin
          maquina     := ECFPadrao.NumeroMaquina;
          intervencao := ECFPadrao.Intervencao;
        end;

        if (vValorPagtoDinheiro + vValorcreditotroca + vValorPagtoCheque + vValorPagtoCartao - abs(FSaldoRestante)) <> 0 then
          IncluirAutenticacao('F', (vValorPagtoDinheiro + vValorcreditotroca + vValorPagtoCheque + vValorPagtoCartao - abs(FSaldoRestante)));

        if vValorcreditotroca <> 0 then
           IncluirAutenticacao('A', vValorcreditotroca);


        qryChequesIncluidos.MasterSource := nil;
        vSaldoCheque := 0;
        qryChequesIncluidos.First;
        while not qryChequesIncluidos.eof do
        begin
          IncluirAutenticacao('H',qryChequesIncluidosvalor.AsCurrency, qryChequesIncluidosnumero.AsString);
          vSaldoCheque := vSaldoCheque + qryChequesIncluidosvalor.AsCurrency;
          qryChequesIncluidos.next;
        end;

        qryChequesIncluidos.MasterSource := dsrRecebimentosTemp;

        if vValorPagtoCheque > vSaldoCheque then
          IncluirAutenticacao('H',vValorPagtoCheque - vSaldoCheque);

        if vValorPagtoCartao <> 0 then
          IncluirAutenticacao('T',vValorPagtoCartao);

        {VERIFICAR OS FECHAMENTOS, SEGUNDO ERRO OCORRENDO NA APOLONIA, 2 CHEQUES COM INCONSISTÊNCIA}
        vFechamentoChequeAut := SomarValores(qryAutenticacao, [qryAutenticacaovalor], [qryAutenticacaotipo], ['H'], ['=']);
        vFechamentoCartaoAut := SomarValores(qryAutenticacao, [qryAutenticacaovalor], [qryAutenticacaotipo], ['T'], ['=']);
//        vFechamentoDinheiroAut := SomarValores(qryAutenticacao, [qryAutenticacaovalor], [qryAutenticacaotipo], ['F'], ['=']);

        vFechamentoChequeRec := SomarValores(qryRecebimentos, [qryRecebimentosvalorlancto], [qryRecebimentostipo], ['H'], ['=']);

        vFechamentoCartaoRec := SomarValores(qryRecebimentos, [qryRecebimentosvalorlancto],
                                                              [qryRecebimentostipo],
                                                              ['C'], ['=']);

        vFechamentoCartaoRec := vFechamentoCartaoRec+ SomarValores(qryRecebimentos, [qryRecebimentosvalorlancto],
                                                              [qryRecebimentostipo],
                                                              ['B'], ['=']);

//        vFechamentoDinheiroRec := SomarValores(qryRecebimentos, [qryRecebimentosvalorlancto], [qryRecebimentostipo],['D'], ['=']);

        if (vValorPagtoCheque <> vFechamentoChequeAut) then
        begin
          result := false;
          MensagemErro(format('O Saldo do valor do pagamento em cheques %f difere do total das autenticações %f', [vValorPagtoCheque, vFechamentoChequeAut]));
        end;

        if (vValorPagtoCheque <> vFechamentoChequeRec) then
        begin
          result := false;
          MensagemErro(format('O Saldo do valor do pagamento em cheques %f difere do total dos recebimentos %f', [vValorPagtoCheque, vFechamentoChequeRec]));
        end;

        if (vValorPagtoCartao <> vFechamentoCartaoAut) then
        begin
          result := false;
          MensagemErro(format('O Saldo do valor do pagamento em cartões %f difere do total das autenteticações %f', [vValorPagtoCartao, vFechamentoCartaoAut]));
        end;

        if (vValorPagtoCartao <> vFechamentoCartaoRec) then
        begin
          result := false;
          MensagemErro(format('O Saldo do valor do pagamento em cartões %f difere do total dos recebimentos %f', [vValorPagtoCartao, vFechamentoCartaoRec]));
        end;


      end;
    except
      on E: Exception do
      begin
        result := false;
        HandleExcecao(E);
        if Assigned(ECFPadrao) and not ComTef then
          ECFPadrao.CancelarCupom;
      end;
    end;

    if result then
    begin
      Result := NotasFiscaisCupom;

      if Result then
      begin
        try
          if NotaFiscalVinculada and not qryDadosFiscaiscliente.isnull then
          begin
            try
              dtmFrenteCaixaCopiaCupom := TdtmFrenteCaixa.Create(nil);

              dtmFrenteCaixaCopiaCupom.qryDadosFiscais.open;
              CopiarRegistros(qryDadosFiscais, dtmFrenteCaixaCopiaCupom.qryDadosFiscais);

              dtmFrenteCaixaCopiaCupom.spcDadosFiscaisProximo.Open;
              dtmFrenteCaixaCopiaCupom.qryDadosFiscais.edit;
              dtmFrenteCaixaCopiaCupom.qryDadosFiscaisnumero.AsInteger := dtmFrenteCaixaCopiaCupom.spcDadosFiscaisProximonumero.AsInteger;
              dtmFrenteCaixaCopiaCupom.qryDadosFiscaisnotavinculada.AsBoolean := true;
              dtmFrenteCaixaCopiaCupom.qryDadosFiscais.post;
              dtmFrenteCaixaCopiaCupom.spcDadosFiscaisProximo.Close;

              dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscais.Open;
              CopiarRegistros(qryProdutosDadosFiscais, dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscais);

              AtribuirChave(dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscais,

                            [dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscaisdadofiscal,
                             dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscaiscodigofiscal,
                             dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscaisnatureza],

                            [dtmFrenteCaixaCopiaCupom.qryDadosFiscaisnumero,
                             dtmFrenteCaixaCopiaCupom.qryDadosFiscaiscodigofiscal,
                             dtmFrenteCaixaCopiaCupom.qryDadosFiscaiscodigonatureza]);

              AtribuirDados(dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscais,

                            [dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscaisincidencia,
                             dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscaisaliquotaicms],

                            [ifthen(regimetributario=1,ctSNOutrosS,ctOUTROS), 0.00]);

              LimparCampos(dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscais,
                           [dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscaismovimento]);


              dtmFrenteCaixaCopiaCupom.qryVenctosDadosFiscais.Open;
              CopiarRegistros(qryVenctosDadosFiscais, dtmFrenteCaixaCopiaCupom.qryVenctosDadosFiscais);
              AtribuirChave(dtmFrenteCaixaCopiaCupom.qryVenctosDadosFiscais,
                            [dtmFrenteCaixaCopiaCupom.qryVenctosDadosFiscaisdadofiscal],
                            [dtmFrenteCaixaCopiaCupom.qryDadosFiscaisnumero]);


              qrynotas.edit;
              qryNotasdadofiscalvinculado.AsInteger :=  qryNotasdadofiscal.AsInteger;
              qryNotasdadofiscal.AsInteger :=  dtmFrenteCaixaCopiaCupom.qryDadosFiscaisnumero.asinteger;
              qrynotas.post;

              CalcularImpostos(dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscais,
                               dtmFrenteCaixaCopiaCupom.qryDadosFiscais, ContribIPI, true, true, nil, nil,
                               false, FrentedeCaixa, true, false, nil, false, false, false);


              CopiarRegistros(dtmFrenteCaixaCopiaCupom.qryDadosFiscais, qryDadosFiscais);
              CopiarRegistros(dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscais, qryProdutosDadosFiscais);

              CopiarRegistros(dtmFrenteCaixaCopiaCupom.qryVenctosDadosFiscais, qryVenctosDadosFiscais);

              qryprodutosdadosfiscais.LinkFields := 'numero = dadofiscal';
              qryprodutosdadosfiscais.MasterSource := dsrDadosFiscais;

              qryVenctosDadosFiscais.LinkFields := 'numero = dadofiscal';
              qryVenctosDadosFiscais.MasterSource := dsrDadosFiscais;

              if(not NumeroNotaFiscalVinculada>0) then
                result := ValidarNFE;

            finally
              dtmFrenteCaixaCopiaCupom := nil;
            end;

          end
          else
          begin
            if CondicaoEmissorNFCE and not assigned(ecfpadrao) then
              result := ValidarNFE;
          end;

          FExcecao := False;

          if result then
          begin

            if qryorcamentos.recordcount = 1 then
            begin
              qryorcamentos.edit;
              qryorcamentos.fieldbyname('situacao').asstring := 'T';
              qryorcamentos.post;

              {
              if qryOrcamentos.FieldByName('creditotroca').ascurrency <> 0 then
              begin
                 ReFazConsulta(qryProdutosTrocados,[],[]);
                 qryprodutostrocados.Insert;
                 spcProdutosTrocadosProximo.Open;
                 qryProdutosTrocadosnumero.AsInteger := spcProdutosTrocadosProximonumero.AsInteger;
                 spcProdutosTrocadosProximo.close;
                 qryProdutosTrocadostipo.AsString := 'S';
                 qryProdutosTrocadosdata.AsDateTime := now();
                 qryProdutosTrocadoscliente.AsInteger := qryDadosFiscaiscliente.AsInteger;
                 qryProdutosTrocadostipocliente.AsString := qryDadosFiscaistipocliente.AsString;
  //                 qryProdutosTrocadoscontrato.AsString := numcontrato;
                 qryProdutosTrocadosfilial.Asinteger := FilialBase;
                 qryProdutosTrocadosusuario.AsInteger := CodigoUsuario;
                 qryProdutosTrocadosvalor.AsCurrency := qryDadosFiscaiscreditotroca.AsCurrency;
                 qryprodutostrocados.post;
              end;
              }
            end;

            if qryContratos.recordcount = 1 then
            begin

              qryContratos.edit;
              qryContratos.fieldbyname('situacao').asstring := 'N';
              qryContratos.post;

              {
              if qryContratos.FieldByName('creditotroca').ascurrency <> 0 then
              begin
                 ReFazConsulta(qryProdutosTrocados,[],[]);
                 qryprodutostrocados.Insert;
                 spcProdutosTrocadosProximo.Open;
                 qryProdutosTrocadosnumero.AsInteger := spcProdutosTrocadosProximonumero.AsInteger;
                 spcProdutosTrocadosProximo.close;
                 qryProdutosTrocadostipo.AsString := 'S';
                 qryProdutosTrocadosdata.AsDateTime := now();
                 qryProdutosTrocadoscliente.AsInteger := qryDadosFiscaiscliente.AsInteger;
                 qryProdutosTrocadostipocliente.AsString := qryDadosFiscaistipocliente.AsString;
//                 qryProdutosTrocadoscontrato.AsString := numcontrato;
                 qryProdutosTrocadosfilial.Asinteger := FilialBase;
                 qryProdutosTrocadosusuario.AsInteger := CodigoUsuario;
                 qryProdutosTrocadosvalor.AsCurrency := qryDadosFiscaiscreditotroca.AsCurrency;
                 qryProdutosTrocadoscontrato.AsString := qryContratos.fieldbyname('numero').asstring;

                 qryprodutostrocados.post;
              end;
              }

            end;


            if result then
              if qryorcamentos.recordcount = 1 then
                result := IncluirAtendimento_(qryOrcamentos.fieldbyName('codigo').AsInteger,
                                    qryOrcamentos.FieldByName('cliente').AsInteger,
                                    qryOrcamentos.FieldByName('tipocliente').AsString,
                                    OrcamentoParaContrato);



            if result then

              Result := Perpetrar([qryagentes, qryTiposRecebimentos, qryRecebimentos, qryChequesIncluidos, qryAutenticacao,
                                   qryDadosFiscais, qryMovimentos, qryProdutosDadosFiscais, qryVenctosDadosFiscais, qryNotas,
                                   qryCupons, qrySeriesFiliais, qryOrcamentos, qryProdutosOrcamentos, qryContratos, qryProdutosTrocados]);

            refazConsultaPorNome(qryTotaisRecebimentos,['transacao'],[ftransacao]);

            if Result then
              AtualizarRegistro_a2_MeiosPagto(qryDadosFiscaisdata.asDateTime);
          end;
        except
          on E: Exception do
          begin
            result := false;
            HandleExcecao(E);
            if Assigned(ECFPadrao) and not ComTef then
              ECFPadrao.CancelarCupom;
          end;
        end;

        if Result then
        begin
          result := ImprimirNotaFiscal;
          if result then
          begin
            vResult := result;

            if (qryContratos.recordcount = 0) then
            begin

              try
                qryFuncaoGerarContratoporDadoFiscal.close;
                qryFuncaoGerarContratoporDadoFiscal.ParamByName('dadofiscal').asinteger := vNumeroDadoFiscal;
                qryFuncaoGerarContratoporDadoFiscal.ParamByName('origem').asString := 'Frente de Caixa';
                qryFuncaoGerarContratoporDadoFiscal.open;
                vresult := perpetrar([]);
              except
                on E: Exception do
                begin
                  vResult := false;
                  MensagemAviso(E.Message + ' Erro na função Gerar Contrato por DadoFiscal.');
                end;
              end;

              if vresult then
              begin
                if (qryorcamentos.recordcount = 1) and (numcontrato<>'') then
                begin

                  try
                    qryorcamentos.edit;
                    qryorcamentos.fieldbyname('contrato').asstring := numcontrato;
                    qryorcamentos.post;;
                    vresult := perpetrar([qryorcamentos]);

                  except
                    on E: Exception do
                    begin
                      vresult := false;
                      MensagemAviso(E.Message + ' Erro ao gravar o orçamento.');
                    end;
                  end;

                  if vresult then
                  begin
                    if qryorcamentos.active and (qryOrcamentos.FieldByName('creditotroca').ascurrency <> 0) and
                       not qryprodutostrocados.isempty then
                    begin

                      try
                        qryprodutostrocados.edit;
                        qryProdutosTrocadoscontrato.AsString := numcontrato;
                        qryprodutostrocados.post;
                        perpetrar([qryprodutostrocados]);
                      except
                        on E: Exception do
                        begin
                          vresult := false;
                          MensagemAviso(E.Message + ' Erro ao gravar o orçamento.');
                        end;
                      end;

                    end;
                  end;

                end;
              end;
            end;

            if vresult then
            begin
              if qryorcamentos.active and (qryorcamentos.recordcount = 1) then

                  AcionarTelaEnquete(qryDadosFiscaiscliente.Asinteger,      //cliente
                             qryDadosFiscaistipocliente.asString,                     //tipocliente
                             qryorcamentos.FieldByName('codigo').asinteger,      //orcamento
                             numcontrato)                                       //contrato
              else
                  AcionarTelaEnquete(qryDadosFiscaiscliente.Asinteger,      //cliente
                             qryDadosFiscaistipocliente.asString,                     //tipocliente
                             0,      //orcamento
                             numcontrato);                                       //contrato
            end;


          end
          else
          begin

            if vsituacaoImpressaoDanfe = Nenhuma then
            begin

              fExcecao := true;
              Perpetrar([qryDadosFiscais]);
              SituacaoCupom := scFechado;

              AcertarMovimentacoesAposCancelamentoNFCe(qryDadosFiscaisnumero.asinteger);
              case SituacaoEmitirNFe of
                ErroValidacaoXMLContigencia: MensagemAviso('A NFCe foi cancelada! Erro na validação da assinatura do xml em contigência!'+chr(13)+vMensagemExcessao);
              else
                MensagemAviso('A NFCe foi cancelada! Erro na impressão, Verifique suas configurações!');
              end;
              ShowProcessando;
  //            frxNFCeCancelada.designreport;
              frxNFCeCancelada.PrintOptions.Printer := ParSistema.NomeImpressoraNotaMercadorias;
              frxNFCeCancelada.PrepareReport;
              frxNFCeCancelada.Print;
            end
            else
              result := true;

          end;

        end;
      end;
    end;

  finally

      qryChequesIncluidos.Close;
      refazconsulta(qryRecebimentos, [], []); {se aqui retornar false inclui os recebimentos novamente}

      qryAutenticacao.Close;
      qryMovimentos.Sql[28] := 'm.numero = 0';
      qryProdutosDadosFiscais.Close;

      qryprodutosdadosfiscais.LinkFields := '';
      qryprodutosdadosfiscais.MasterSource := nil;

      qryVenctosDadosFiscais.LinkFields := '';
      qryVenctosDadosFiscais.MasterSource := nil;
//    qryDadosFiscais.close;
      qryVenctosDadosFiscais.Close;
      qryNotas.Close;
      qryCupons.Close;
      qrySeriesFiliais.Close;
      qryChequesIncluidos.Open;
      qryAutenticacao.Open;

{
            Result := Perpetrar([qryagentes, qryTiposRecebimentos, qryRecebimentos, qryChequesIncluidos, qryAutenticacao,
                                 qryDadosFiscais, qryMovimentos, qryProdutosDadosFiscais, qryVenctosDadosFiscais, qryNotas,
                                 qryCupons, qrySeriesFiliais, qryOrcamentos, qryProdutosOrcamentos, qryContratos, qryProdutosTrocados]);
                                 }

  end;
end;

procedure Tdtmfrentecaixa.SelecionarCliente;
begin
  ReFazConsulta(qryCliente, [0], [qryConsultaClientescodigo.AsInteger]);
end;

procedure Tdtmfrentecaixa.SelecionarItem;
begin
  if Not (qryProdutosVendidoscancelado.AsBoolean or dtmFrenteCaixa.CupomTotalizado) then
  begin
    qryProdutosVendidos.Edit;
    qryProdutosVendidosselecionado.AsBoolean := Not qryProdutosVendidosselecionado.AsBoolean;
    qryProdutosVendidos.Post;
  end
end;

procedure Tdtmfrentecaixa.SelecionarVendedor(Limpar: Boolean; codigoVendedor : Integer);
begin
  if Limpar then
  begin
    ReFazConsulta(qryVendedor, [0], [0]);
  end
  else
  begin
    if codigoVendedor > 0 then
    begin
      ReFazConsulta(qryVendedor, [0], [codigoVendedor]);
    end
    else
    begin
      ReFazConsulta(qryVendedor, [0], [qryConsultaVendedorescodigo.AsInteger]);
    end;
  end;

  qryProdutosVendidos.DisableControls;
  try
    qryProdutosVendidos.First;
    while Not qryProdutosVendidos.Eof do begin
      qryProdutosVendidos.Edit;
      if qryVendedorcodigo.IsNull then
        qryProdutosVendidosvendedor.Clear
      else
        qryProdutosVendidosvendedor.AsInteger := qryVendedorcodigo.AsInteger;
      qryProdutosVendidos.Post;
      qryProdutosVendidos.Next
    end
  finally
    qryProdutosVendidos.EnableControls
  end
end;

procedure Tdtmfrentecaixa.setParaEntregar(const Value: Boolean);
begin
  qryProdutosVendidos.Edit;
  qryProdutosVendidosentregar.AsBoolean := Value;
  qryProdutosVendidos.Post
end;

function Tdtmfrentecaixa.ValidarDesconto: Boolean;
begin
  Result := True;
  if ParSistema.PercentualDescontoFrenteCaixa > 0 then
  begin
    if PercentualDoValorSobreTotal(TotalPagar,ValorDesconto) > ParSistema.PercentualDescontoFrenteCaixa then
    begin
      MensagemAviso('O desconto máximo foi excedido.');
      Result := False;
    end;
  end;
end;

function Tdtmfrentecaixa.VerificarSerieFilial: Boolean;
begin
  if SerieSugestaoNFCe <> '' then
  begin
    ReFazConsulta(qrySeriesFiliais, [0, 1], [FilialBase, SerieSugestaoNFCe]);  //NFCe
    if qrySeriesFiliais.RecordCount = 0 then
    begin
      MensagemAviso(format(ctFILIALSEMSERIE, [FilialBase, 'mercadorias']));
      Result := False;
    end
    else
    if qrySeriesFiliaismodelonota.IsNull and
      (qrySeriesFiliaismodelodoctofiscal.asString <> '65') and                  //NFCe
      (qrySeriesFiliaismodelodoctofiscal.asString <> '55') and                  //NFe
      (qrySeriesFiliaismodelodoctofiscal.asString <> '57') then                 //CTe
    begin
      MensagemAviso(ctSERIESUGESTAOSEMMODELO);
      Result := False;
    end else
       Result := True;
  end
  else
  begin
    ReFazConsulta(qrySeriesFiliais, [0, 1], [FilialBase, SerieSugestao]);       //NFe
    if qrySeriesFiliais.RecordCount = 0 then
    begin
      MensagemAviso(format(ctFILIALSEMSERIE, [FilialBase, 'mercadorias']));
      Result := False;
    end
    else
    if qrySeriesFiliaismodelonota.IsNull and
      (qrySeriesFiliaismodelodoctofiscal.asString <> '65') and                  //NFCe
      (qrySeriesFiliaismodelodoctofiscal.asString <> '55') and                  //NFe
      (qrySeriesFiliaismodelodoctofiscal.asString <> '57') then                 //CTe
    begin
      MensagemAviso(ctSERIESUGESTAOSEMMODELO);
      Result := False;
    end else
       Result := True;
  end;
end;


procedure Tdtmfrentecaixa.zeraVariaveis;
begin
  qryDadosFiscais.Close;
  ReFazConsulta(qryProdutosVendidos, [], []);
  ReFazConsulta(qryProdutosDigitados, [], []);
  qryProdutosDigitados.delete;

  ReFazConsulta(qryCliente, [0], [0]);
  ReFazConsulta(qryVendedor, [0], [0]);
  FTotalPagar               :=0;
  FSaldoRestante            :=0;
//  ValorAReceber            :=0;
  FQtdadeFormasPagto        :=0;
//  ValorAcrescimo           := 0;
//  ValorDesconto            := 0;
  FValorTotalDescontoItem   := 0;
//  TotalRecebimentos := 0;
//  FTroco                    := 0;
  FNumeroNotaFiscalVinculada := 0;
  FSubTotal                 := 0;
  FValorAvista              := 0;
  FValorAPrazo              := 0;
  fnumContrato               := '';
  FValorTotalQuantidade     := 0;
  FDescontoProdutoComposto  := 0;
  FTemComposto              := False;
  FMensagemDesconto         := '';
//  VerificarGTVenderItem     := True;

end;

procedure Tdtmfrentecaixa.AdicionarAcrescimo(valor:Currency; TipoAcrescimo:String = 'V');
begin
  if FSituacaoCupom < scTotalizado then
  begin
    if valor = 0 then
    begin
      ValorAcrescimo := 0;
    end
    else
    begin
      if TipoAcrescimo = 'P' then
        ValorAcrescimo := {ValorAcrescimo +} ValorDoPercentualSobreTotal(FSubTotal, valor)
      else
        ValorAcrescimo := {ValorAcrescimo +} valor;
    end;
               {
    if ValorAcrescimo-ValorDesconto = 0 then
    begin
      ValorDesconto := 0;
      ValorAcrescimo := 0;

      vDescontoAntesAlterar := 0;
      vAcrescimoAntesAlterar := 0;

    end;
    }

    ValorAReceber := FTotalPagar-ValorDesconto-Desconto_CashBack+ValorAcrescimo-ValorTotalDescontoItem;
    FSaldoRestante := ValorAReceber;


//    TotalizarCupom;

    if qryTotalRecebimentoTipoAcrescimo.asString <> TipoAcrescimo then
    begin
      qryTotalRecebimento.edit;
      qryTotalRecebimentoTipoAcrescimo.asString := TipoAcrescimo;
      qryTotalRecebimento.Post;
    end

  end;
  VerificarSaldoRecebimentosTemp;
  AfterAlteracaoValores(nil);
end;

procedure Tdtmfrentecaixa.AdicionarDesconto(valor:Currency; TipoDesconto:String = 'V');
begin
  if FSituacaoCupom < scTotalizado then
  begin

    if valor = 0 then
    begin
      ValorDesconto  := 0;
    end
    else
    begin
      if TipoDesconto = 'P' then
      begin
        ValorDesconto := {ValorDesconto +} ValorDoPercentualSobreTotal(FSubTotal, valor);
  //      FMensagemDesconto:= 'Você obteve um desconto de '+#13+#10+'R$ '+ FormatarValor((FDescontoProdutoComposto+ValorDoPercentualSobreTotal(FSubTotal, valor)),2) + ' nesta compra.';
      end
      else
      begin
        ValorDesconto := {ValorDesconto +} valor;
  //      FMensagemDesconto:= 'Você obteve um desconto de '+#13+#10+'R$ '+ FormatarValor((FDescontoProdutoComposto+Valor),2) + ' nesta compra.';
      end;
    end;

    {
    if ValorDesconto-ValorAcrescimo = 0 then
    begin
      ValorDesconto := 0;
      ValorAcrescimo := 0;
      vDescontoAntesAlterar := 0;
      vAcrescimoAntesAlterar := 0;
    end;
    }

    ValorAReceber := FTotalPagar-ValorDesconto-Desconto_CashBack+ValorAcrescimo-ValorTotalDescontoItem;
    FSaldoRestante := ValorAReceber;


//    TotalizarCupom
  end;

  if qryTotalRecebimentoTipoDesconto.asString <> TipoDesconto then
  begin
    qryTotalRecebimento.edit;
    qryTotalRecebimentoTipoDesconto.asString := TipoDesconto;
    qryTotalRecebimento.Post;
  end;

  VerificarSaldoRecebimentosTemp;
  AfterAlteracaoValores(nil);
end;



procedure Tdtmfrentecaixa.OpcoesImprimirContrato;
begin
 frmConfirmarImpressaoNoContrato := TfrmConfirmarImpressaoNoContrato.Create(frmConfirmarImpressaoNoContrato, True, True, True, True, False, 1);
 try
    if frmConfirmarImpressaoNoContrato.ShowModal = mrOK then begin
      if frmConfirmarImpressaoNoContrato.Contrato then
        ImprimirContrato;
     if frmConfirmarImpressaoNoContrato.Carne then
        ImprimirCarne(False)
     else if frmConfirmarImpressaoNoContrato.CarneAbertas then
        ImprimirCarne(True);
     if frmConfirmarImpressaoNoContrato.Boleto then
        ImprimirBoleto(frmConfirmarImpressaoNoContrato.Sequencia);
    end
  finally
    frmConfirmarImpressaoNoContrato.Free;
  end;
end;

procedure Tdtmfrentecaixa.ImprimirContrato;
var
  dtmimprimecontratos: TdtmImprimeContratos;
begin
  dtmimprimecontratos := TdtmImprimeContratos.Create(Self);
  try
    dtmimprimecontratos.ImprimirContratos(NumContrato);
  finally
    dtmimprimecontratos.Free;
  end;
end;

procedure Tdtmfrentecaixa.ImprimirBoleto(NumeroParcelas: vString);
var
  dtmImprimeBoleto: TdtmImprimeBoleto;
begin

  ReFazConsultaPorNome(qryPlanoPagamento, ['codigo'], [qryDadosFiscaisplano.AsInteger]);
  if not qryPlanoPagamentopermitirimpressaodoboleto.asBoolean then
  begin
    MensagemAviso(format('Existe uma restrição no plano que não permite a impressão do boleto.'+chr(13)+
                  'Veja a opção "Permitir Impressão do Boleto" em Cadastro, Tabelas, Plano de Pagamentos, Código %s.',
                  [qryDadosFiscaisplano.AsSTring]));

  end
  else
  begin
    dtmImprimeBoleto := TdtmImprimeBoleto.Create(Self);
    try
      dtmImprimeBoleto.ImprimirBoletoContrato(NumContrato, NumeroParcelas);
    finally
      dtmImprimeBoleto.Free;
    end;
  end;

end;

procedure Tdtmfrentecaixa.ImprimirCarne(SomenteAbertas: Boolean);
var
  dtmImprimeCarne: TdtmImprimeCarne;
begin
  dtmImprimeCarne := TdtmImprimeCarne.Create(Self);
  try
    dtmImprimeCarne.ImprimirCarnesContrato(NumContrato, SomenteAbertas);
  finally
    dtmImprimeCarne.Free
  end;
end;

function Tdtmfrentecaixa.ExistePesquisaProduto(campo,
  codigo: String): Boolean;
const
  SQL = '(p.%s ilike ''%s%s'')';
  SQL_C = '(c.%s ilike ''%s%s'')';
  SQL_IPI = '(ipi.%s ilike ''%s%s'')';

  SQLChaves = ' ((to_ascii(cast(p.codigovisual as varchar),''latin1'') ilike to_ascii(''%s%s'',''latin1'')) '+
              ' or p.codigo in (select pcb.produto from produtoscodigobarras pcb where (to_ascii(pcb.codigobarras,''latin1'') ilike to_ascii(''%s%s'',''latin1''))))';

begin
  if qryConsultaProduto.Active then
   qryConsultaProduto.Close;

  if campo = 'codigo' then
    qryConsultaProduto.MacroByName('codigo').AsString := Format(SQLChaves, [ANSIUpperCase(codigo), '%', ANSIUpperCase(codigo), '%'])
  else
  if campo = 'cest' then
    qryConsultaProduto.MacroByName('codigo').AsString := Format(SQL_C, [Campo, Codigo, '%'])
  else
  if campo = 'classificacaofiscal' then
    qryConsultaProduto.MacroByName('codigo').AsString := Format(SQL_IPI, [Campo, Codigo, '%'])
  else
  if campo = 'unidade' then
    qryConsultaProduto.MacroByName('codigo').AsString := '(u.descricao = '+quotedstr(codigo)+')'
  else
    qryConsultaProduto.MacroByName('codigo').AsString := Format(SQL, [Campo, Codigo, '%']);

  qryConsultaProduto.Open;
  Result := qryConsultaProduto.RecordCount > 0
end;

procedure Tdtmfrentecaixa.marcaItemCancelado;
begin
  qryTecTempProdutosCancelados.Edit;
  if qryTecTempProdutosCancelados.FieldByName('cancelado').AsBoolean then
    qryTecTempProdutosCancelados.FieldByName('cancelado').AsBoolean := False
  else
    qryTecTempProdutosCancelados.FieldByName('cancelado').AsBoolean := True;
  qryTecTempProdutosCancelados.Post;
end;

function Tdtmfrentecaixa.consultaClienteCPF(CPF:String): Boolean;
begin
  qryConsultaClientes.Sql[16] := 'where c.pessoanumero = '+QuotedStr(CPF)+' ';
  qryConsultaClientes.Open;
  if qryConsultaClientes.IsEmpty then
  begin
    MensagemAviso('Cliente não localizado.');
    ReFazConsulta(qryConsultaClientes, [], []);
    Result := False;
  end
  else
  begin
    SelecionarCliente;
    Result := True;
  end;
end;

function Tdtmfrentecaixa.consultaClienteCodigo(codigo: Integer): Boolean;
begin
  qryConsultaClientes.Sql[16] := 'where c.codigo = '+QuotedStr(IntToStr(codigo))+' ';
  qryConsultaClientes.Open;
  if qryConsultaClientes.IsEmpty then
  begin
    MensagemAviso('Cliente não localizado.');
    ReFazConsulta(qryConsultaClientes, [], []);
    Result := False;
  end
  else
  begin
    SelecionarCliente;
    Result := True;
  end;
end;

function Tdtmfrentecaixa.consultaVendedorCodigo(codigo:Integer): Boolean;
begin
  AbreConsultaVendedor;
  if not ExisteVendedor('codigo', codigo) then
  begin
    MensagemAviso('Vendedor não localizado.');
    Result := False;
  end
  else
  begin
    SelecionarVendedor(False, codigo);
    Result := True;
  end;
end;

procedure Tdtmfrentecaixa.consultaVendedorNome(nome: String);
begin
  if Descricao <> '' then
    qryConsultaVendedores.Sql[6] := 'and (nome ilike ''' + Descricao + '%'')'
  else
    qryConsultaVendedores.Sql[6] := 'and (codigo IS NULL )';
  AbreConsultaVendedor;
end;

procedure Tdtmfrentecaixa.zeraFormaPagamento;
var
  iCount : Integer;
begin
//  ValorDesconto     := 0;
//  ValorAcrescimo    := 0;
  IniciarTabelaTotalRecebimento;
  SaldoRestante     := TotalPagar-ValorTotalDescontoItem;
  ValorAReceber := SaldoRestante;
end;

function Tdtmfrentecaixa.getValorJaInformado: Currency;
begin
  Result := SaldoRestante+ValorDesconto-ValorAcrescimo;
end;

function Tdtmfrentecaixa.getValorTotalCompra: Currency;
begin
  Result := TotalPagar-ValorTotalDescontoItem-ValorDesconto-Desconto_CashBack+ValorAcrescimo;
end;

function Tdtmfrentecaixa.getProximoNumeroAutenticacao: integer;
begin
  spcAutenticacaoProximo.Open;
  result := spcAutenticacaoProximonumero.AsInteger;
  spcAutenticacaoProximo.Close;
end;


