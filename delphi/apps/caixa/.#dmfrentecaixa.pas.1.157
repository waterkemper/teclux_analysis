procedure Tdtmfrentecaixa.setdesconto_cashbackGerado(
  const Value: Currency);
begin
  if roundto(value, -2) <>
     roundto(qryTotalRecebimentodesconto_cashbackgerado.asCurrency, -2) then
  begin
    qryTotalRecebimento.edit;
    qryTotalRecebimentodesconto_cashbackgerado.asCurrency := Value;
    qryTotalRecebimento.Post;
  end;
end;

