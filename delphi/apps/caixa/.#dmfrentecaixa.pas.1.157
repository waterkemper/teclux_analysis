function Tdtmfrentecaixa.GetCodigoNatureza: Integer;
begin
  FCodigoNatureza := qryDadosFiscaiscodigonatureza.AsInteger;
  Result := FCodigoNatureza;
end;

procedure Tdtmfrentecaixa.qryDadosFiscaisNewRecord(DataSet: TDataSet);
begin
  inherited;
//  qryDadosFiscaismodelodocto.AsString := ModeloDoctoFiscal;
  qryDadosFiscaisregimetributario.AsInteger := RegimeTributario;
  qryDadosFiscaisdata.AsDateTime         := DataServidor;
  qryDadosFiscaisdatasaida.AsDateTime    := DataServidor;
  qryDadosFiscaissituacao.AsString       := 'N';
  qryDadosFiscaisfilialvenda.AsInteger   := FilialBase;
  qryDadosFiscaisfilialemissao.AsInteger := FilialBase;
  qryDadosFiscaisviatransporte.AsString  := 'R';
  qryDadosFiscaisfrete.AsString          := '1';
  qryDadosFiscaisvendedor.AsInteger      := UsuarioLogin.CodigoUsuario;
  qryDadosFiscaismanual.AsBoolean        := false;
  qryDadosFiscaisversaolayout.AsCurrency   := 3.10;
  qryDadosFiscaiscodaleatorio.AsInteger    := Aleatorio(qryDadosFiscaisdata.AsDateTime, qryDadosFiscaisnrdocumento.asString);
  { 0 – pagamento à vista   1 – pagamento à prazo     2 - outros }
  qryDadosFiscaisformapagto.AsInteger      := 2;
  { 1-Retrato/ 2-Paisagem }
//  qryDadosFiscaisformatodanfe.AsInteger    := 1;
  {1-Normal/ 2-Contingência}
  qryDadosFiscaisformaemissao.AsInteger    := 1 {NFeTipoEmissao};

  qryDadosFiscaisregimetributario.AsInteger := RegimeTributario;
  qrydadosfiscaisnosimples.asboolean := false;
  qrydadosfiscaisOrgaoPublico.asboolean := false;

  qryDadosFiscaisindpres.AsInteger := 1;

   if(NumeroNotaFiscalVinculada>0) then
      qryDadosFiscaismodelodocto.AsString := '02'
  else
    qryDadosFiscaismodelodocto.AsString := ModeloDoctoFiscal;



end;


function Tdtmfrentecaixa.GetNotaFiscalVinculada: Boolean;
begin
  result := Assigned(ECFPadrao) and ((ParSistema.NotaFiscalVinculada = tnfOBRIGATORIA) or (NumeroNotaFiscalVinculada>0));
end;

procedure Tdtmfrentecaixa.AtribuirDadosCliente;
begin
  if qryClientecodigo.IsNull then
  begin
    qryDadosFiscaistipocliente.clear;
    qryDadosFiscaisnome.clear;
    qryDadosFiscaispessoanumero.clear;
    qryDadosFiscaisfonenumero.clear;
    qryDadosFiscaisfoneddd.clear;
    qryDadosFiscaisdocumento.clear;
    qryDadosFiscaisemail.clear;

    qryDadosFiscaisrua.Clear;
    qryDadosFiscaisendnumero.Clear;
    qryDadosFiscaisendcomplemento.Clear;
    qryDadosFiscaisbairro.Clear;
    qryDadosFiscaisnomebairro.Clear;
    qryDadosFiscaiscidade.Clear;
    qryDadosFiscaiscidadeibge.clear;
    qryDadosFiscaisnomecidade.Clear;
    qryDadosFiscaisestado.Clear;
    qryDadosFiscaiscep.Clear;
    qryDadosFiscaispessoatipo.Clear;
    qryDadosFiscaispessoanumero.clear;

    qryDadosFiscaislocalentrega_rua.Clear;
    qryDadosFiscaisentnomedestinatario.clear;
    qryDadosFiscaislocalentrega_numero.Clear;
    qryDadosFiscaislocalentrega_complemento.Clear;
    qryDadosFiscaislocalentrega_bairro.Clear;
    qryDadosFiscaislocalentrega_nomebairro.Clear;
    qryDadosFiscaislocalentrega_cidade.Clear;
    qryDadosFiscaislocalentrega_cidadeibge.clear;
    qryDadosFiscaislocalentrega_nomecidade.Clear;
    qryDadosFiscaislocalentrega_estado.Clear;
    qryDadosFiscaislocalentrega_cep.Clear;
    qryDadosFiscaislocalentrega_cnpj.clear;
    qryDadosFiscaisclientecontribicms.AsBoolean := false;

  end
  else
  begin

    qrydadosfiscaisnosimples.asboolean   := qryClientenosimples.asboolean;
    qrydadosfiscaisOrgaoPublico.asboolean   := qryClienteOrgaoPublico.asboolean;

    qryDadosFiscaistipocliente.AsString  := 'C';
    qryDadosFiscaisnome.AsString         := qryClientenome.AsString;
    qryDadosFiscaispessoatipo.AsString   := qryClientepessoatipo.AsString;
    qryDadosFiscaispessoanumero.AsString := qryClientepessoanumero.AsString;
    qryDadosFiscaisfonenumero.AsVariant  := qryClientefonenumero.AsVariant;
    qryDadosFiscaisfoneddd.AsVariant     := qryClientefoneddd.AsVariant;
    qryDadosFiscaisdocumento.AsString    := qryClienteiddocumento.AsString;
    qryDadosFiscaisemail.AsString        := qryClienteemail.AsString;
    qryDadosFiscaissuframa.AsString      := qryClientesuframa.AsString;

    qryDadosFiscaisobscliente.AsString  := qryClienteobsnotafiscal.AsString;
    qryDadosFiscaisobsclienteipisuspenso.AsString:= qryClienteobsipisuspenso.AsString;

    if qryDadosFiscaisdebitar.isNull then
      if not qryClientedebito.IsNull then
        qryDadosFiscaisdebitar.AsVariant   := qryClientedebito.AsVariant;

    qryDadosFiscaislocalentrega_rua.AsString         := qryClienterefrua.AsString;
    qryDadosFiscaisentnomedestinatario.asString      := qryClientereferencia.asString;
    qryDadosFiscaislocalentrega_numero.AsString      := qryClienterefnumero.AsString;
    qryDadosFiscaislocalentrega_complemento.AsString := qryClienterefcomplemento.AsString;
    qryDadosFiscaislocalentrega_bairro.AsString      := qryClienterefbairro.AsString;
    qryDadosFiscaislocalentrega_nomebairro.AsString  := qryClienterefnomebairro.AsString;
    qryDadosFiscaislocalentrega_cidade.AsString      := qryClienterefcidade.AsString;
    qryDadosFiscaislocalentrega_nomecidade.AsString  := qryClienterefnomecidade.AsString;
    qryDadosFiscaislocalentrega_estado.AsString      := qryClienterefestado.AsString;
    qryDadosFiscaislocalentrega_cep.AsString         := qryClienterefcep.AsString;
    qryDadosFiscaislocalretirada_cnpj.AsString       := qryClientepessoanumero.AsString;
    qryDadosFiscaisvendaconsumidorfinal.AsBoolean    := qryClienteconsumidorfinal.AsBoolean;
    qryDadosFiscaisclientecontribicms.AsBoolean      := qryClientecontribicms.asboolean;

    if qryClienteestado.AsString='.' then {estrangeiro}
    begin
      qryDadosFiscaispais.AsInteger                    := qryClientecidadeibge.AsInteger;
      qryDadosFiscaisnomepais.AsString                 := qryClientenomecidade.AsString;
      qryDadosFiscaisrua.AsString                      := qryClienterua.AsString;
      qryDadosFiscaisendnumero.AsString                := qryClientenumero.AsString;
      qryDadosFiscaisendcomplemento.AsString           := qryClientecomplemento.AsString;
      qryDadosFiscaisbairro.AsString                   := qryClientebairro.AsString;
      //qryDadosFiscaisnomebairro.AsString               := ConsultaOSP.qryClientenomebairro.AsString;
      qryDadosFiscaiscidade.AsString                   := qryClientecidade.AsString;
      qryDadosFiscaisnomecidade.AsString               := qryClientenomebairro.AsString;
      //qryDadosFiscaiscidadeibge.AsString             := ConsultaOSP.qryClientecidadeibge.AsString;
      qryDadosFiscaisestado.AsString                   := qryClienteestado.AsString;
      //qryDadosFiscaiscep.AsInteger                     := ConsultaOSP.qryClientecep.AsInteger;
    end
    else
    begin
      qryDadosFiscaispais.AsInteger                    := 1058;
      qryDadosFiscaisnomepais.AsString                 := 'Brasil';
      qryDadosFiscaisrua.AsString                      := qryClienterua.AsString;
      qryDadosFiscaisendnumero.AsString                := qryClientenumero.AsString;
      qryDadosFiscaisendcomplemento.AsString           := qryClientecomplemento.AsString;
      qryDadosFiscaisbairro.AsString                   := qryClientebairro.AsString;
      qryDadosFiscaisnomebairro.AsString               := qryClientenomebairro.AsString;
      qryDadosFiscaiscidade.AsString                   := qryClientecidade.AsString;
      qryDadosFiscaisnomecidade.AsString               := qryClientenomecidade.AsString;
      qryDadosFiscaiscidadeibge.AsString               := qryClientecidadeibge.AsString;
      qryDadosFiscaisestado.AsString                   := qryClienteestado.AsString;
      qryDadosFiscaiscep.AsString                      := qryClientecep.AsString;
    end;

  end
end;

function Tdtmfrentecaixa.GetCondicaoEmissorNFE: Boolean;
begin
  if qryDadosFiscais.recordcount <> 0 then
    fCondicaoEmissorNFE := (parsistema.EmissorNfe and
                           ((qryDadosFiscaismodelodocto.AsString = '55') or
                            (qryDadosFiscaismodelodocto.AsString = '57'))) or

                           (parsistema.Emissor_de_NFC_e and
                            (qryDadosFiscaismodelodocto.AsString = '65'))

  else
    fCondicaoEmissorNFE := (parsistema.EmissorNfe and
                            ((ModeloDoctoFiscal = '55') or
                             (ModeloDoctoFiscal = '57'))) or

                           (parsistema.Emissor_de_NFC_e and
                            (ModeloDoctoFiscalNFCe = '65'));

  Result := fCondicaoEmissorNFE;
end;



procedure Tdtmfrentecaixa.GravarRecebimento;
begin
{
  if (qryRecebimentosvalorlancto.AsCurrency <> 0) and
     (qryRecebimentostiporecebimento.AsInteger <> 0) and
     ((qryRecebimentosvalorlancto.AsCurrency <> qryRecebimentosvalorlancto.OldValue) or
     (qryRecebimentostiporecebimento.AsInteger <> qryRecebimentostiporecebimento.OldValue)) then
  begin
    qryRecebimentos.Edit;
    qryRecebimentos.Post;
  end;
}
  if (qryRecebimentosTemp.State in [dsedit, dsinsert]) then
    qryRecebimentostemp.post;
      
end;

function Tdtmfrentecaixa.GravarRecebimentos(ComTef: boolean): Boolean;
var
  vok: Boolean;
  vValorCheque, vValorCartao : Currency;
  vControleRecebimento : integer;


  function RecebimentosTipo: String;
  begin
    if TEFPadrao.TipoTransacao_ in [10,11,12,13] then
       result := 'C'                           //credito
    else if TEFPadrao.TipoTransacao_ in [20,21,22,23,24,25] then
       result := 'B';                          //debito
  end;


  procedure IncluirRecebimentoCheque(ChequeCadastrado: Boolean);
  begin
    if ChequeCadastrado then
    begin
      qryRecebimentos.Append;

      spcRecebimentosProximo.Open;
      qryRecebimentoscodigo.AsInteger := spcRecebimentosProximocodigo.AsInteger;
      spcRecebimentosProximo.Close;
      qryRecebimentosdatalancto.AsDateTime  := DataHoraServidor;
      qryRecebimentosdatavencto.AsDateTime  := qryChequesIncluidosvencto.AsDateTime;

      qryRecebimentosfilial.AsInteger       := FilialBase;
      qryRecebimentossituacao.AsString      := 'N';
      qryRecebimentosvalorlancto.AsCurrency := qryChequesIncluidosvalor.AsCurrency;
      qryRecebimentosvalortotal.AsCurrency := qryChequesIncluidosvalor.AsCurrency;
      qryRecebimentoscontrole.AsInteger    := 1;
      qryRecebimentoscontrolerecebimento.AsInteger := qryRecebimentoscodigo.AsInteger;

//      qryRecebimentosdatavencto.AsDateTime  := qryChequesIncluidosdata.AsDateTime;
      qryRecebimentostiporecebimento.AsInteger := qryRecebimentosTemptiporecebimento.AsInteger;
      qryRecebimentostipo.AsString         := qryRecebimentosTemptipo.AsString;
      qryRecebimentoscheque.AsString       := qryChequesIncluidosnumero.AsString;
      qryRecebimentosnumeroregistrorecebimentotemp.AsInteger := qryRecebimentosTemp.recno;
      qryRecebimentos.Post;

    end
    else
    begin
      qryRecebimentos.Append;
      spcRecebimentosProximo.Open;
      qryRecebimentoscodigo.AsInteger := spcRecebimentosProximocodigo.AsInteger;
      spcRecebimentosProximo.Close;
      qryRecebimentosdatalancto.AsDateTime  := DataHoraServidor;
      qryRecebimentosfilial.AsInteger      := FilialBase;
      qryRecebimentossituacao.AsString     := 'N';
      qryRecebimentosvalorlancto.AsCurrency := qryRecebimentosTempvalorlancto.AsCurrency - vTotalValoresCheques;
      qryRecebimentosvalortotal.AsCurrency := qryRecebimentosvalorlancto.AsCurrency;
      qryRecebimentoscontrole.AsInteger    := 1;
      qryRecebimentoscontrolerecebimento.AsInteger := qryRecebimentoscodigo.AsInteger;
      qryRecebimentosdatavencto.AsDateTime := DataServidor;
      qryRecebimentostiporecebimento.AsInteger := qryRecebimentosTemptiporecebimento.AsInteger;
      qryRecebimentostipo.AsString         := qryRecebimentosTemptipo.AsString;
      qryRecebimentoscheque.clear;
      qryRecebimentosnumeroregistrorecebimentotemp.AsInteger := qryRecebimentosTemp.recno;
      qryRecebimentos.Post;
    end;
  end;

  procedure IncluirRecebimentoDinheiro;
  begin
    if qryRecebimentos.locate('tipo;tiporecebimento', VarArrayOf([qryRecebimentosTemptipo.AsString,
                                                                  qryRecebimentosTemptiporecebimento.AsInteger]), []) then
      qryRecebimentos.edit
    else
    begin
      qryRecebimentos.Append;
      spcRecebimentosProximo.Open;
      qryRecebimentoscodigo.AsInteger := spcRecebimentosProximocodigo.AsInteger;
      spcRecebimentosProximo.Close;
    end;

    qryRecebimentosfilial.AsInteger       := FilialBase;
    qryRecebimentossituacao.AsString      := 'N';
    qryRecebimentosdatalancto.AsDateTime  := DataHoraServidor;
//    qryRecebimentosdatavencto.AsDateTime := qryRecebimentosdatalancto.AsDateTime;

    qryRecebimentosvalorlancto.AsCurrency := qryRecebimentosvalorlancto.AsCurrency + qryRecebimentosTempvalorlancto.AsCurrency;
    qryRecebimentosvalortotal.AsCurrency := qryRecebimentosvalorlancto.AsCurrency;

    qryRecebimentostipo.AsString          := qryRecebimentosTemptipo.AsString;
    qryRecebimentostiporecebimento.AsInteger := qryRecebimentosTemptiporecebimento.AsInteger;
    qryRecebimentoscontrole.AsInteger     := 1;
    qryRecebimentoscontrolerecebimento.AsInteger := qryRecebimentoscodigo.AsInteger;

    qryRecebimentos.Post;
  end;

  procedure IncluirRecebimentocreditotroca;
  begin

    if qryRecebimentos.locate('tipo;tiporecebimento', VarArrayOf([qryRecebimentosTemptipo.AsString,
                                                                  qryRecebimentosTemptiporecebimento.AsInteger]), []) then
      qryRecebimentos.edit
    else
    begin
      qryRecebimentos.Append;
      spcRecebimentosProximo.Open;
      qryRecebimentoscodigo.AsInteger := spcRecebimentosProximocodigo.AsInteger;
      spcRecebimentosProximo.Close;
    end;

    qryRecebimentosfilial.AsInteger       := FilialBase;
    qryRecebimentossituacao.AsString      := 'N';
    qryRecebimentosdatalancto.AsDateTime  := DataHoraServidor;
//    qryRecebimentosdatavencto.AsDateTime := qryRecebimentosdatalancto.AsDateTime;

    qryRecebimentosvalorlancto.AsCurrency := qryRecebimentosvalorlancto.AsCurrency + qryRecebimentosTempvalorlancto.AsCurrency;
    qryRecebimentosvalortotal.AsCurrency := qryRecebimentosvalorlancto.AsCurrency;

    qryRecebimentostipo.AsString          := qryRecebimentosTemptipo.AsString;
    qryRecebimentostiporecebimento.AsInteger := qryRecebimentosTemptiporecebimento.AsInteger;
    qryRecebimentoscontrole.AsInteger     := 1;
    qryRecebimentoscontrolerecebimento.AsInteger := qryRecebimentoscodigo.AsInteger;

    qryRecebimentos.Post;
  end;


      {
  procedure ApagarChequesIncluidos;
  begin
    qryChequesIncluidos.First;
    while not qryChequesIncluidos.eof do
    begin
      if qryChequesIncluidosnumeroregistrorecebimentotemp.AsInteger = qryRecebimentosTemp.RecNo then
        qryChequesIncluidos.delete
      else
        qryChequesIncluidos.next;
    end;

    qryRecebimentos.First;
    while not qryRecebimentos.eof do
    begin
      if qryRecebimentosnumeroregistrorecebimentotemp.AsInteger = qryRecebimentosTemp.RecNo then
        qryRecebimentos.delete
      else
        qryRecebimentos.next;
    end;
  end;
  }

  procedure RecalcularValoresVariaveis;
  begin
    qryrecebimentostemp.First;
    while not qryRecebimentostemp.Eof do
    begin
      if not qryRecebimentosTemp.ReadOnly or qryRecebimentosTempehcreditodetroca.asBoolean then
      begin
        if qryRecebimentosTemptipotiporecebimento.AsString = 'D' then
        begin
          if qryRecebimentosTempok.asboolean then
          begin
            vValorPagtoDinheiro := vValorPagtoDinheiro - qryRecebimentosTempvalorlancto.AsCurrency;
            vValorPagtoConfirmado := vValorPagtoConfirmado - qryRecebimentosTempvalorlancto.AsCurrency;
            qryRecebimentosTemp.Edit;
            qryRecebimentosTempok.AsBoolean := false;
            qryRecebimentosTemp.post;
          end;
        end
        else
        if qryRecebimentosTemptipotiporecebimento.AsString = 'T' then
        begin
          if qryRecebimentosTempok.asboolean then
          begin
            vValorcreditotroca := vValorcreditotroca - qryRecebimentosTempvalorlancto.AsCurrency;
            vValorPagtoConfirmado := vValorPagtoConfirmado - qryRecebimentosTempvalorlancto.AsCurrency;
            {
            qryRecebimentosTemp.Edit;
            qryRecebimentosTempok.AsBoolean := false;
            qryRecebimentosTemp.post;
            }
          end;
        end
        else
        if qryRecebimentosTemptipotiporecebimento.AsString = 'H' then
        begin
          if qryRecebimentosTempok.asboolean then
          begin
            vValorPagtoCheque := vValorPagtoCheque - qryRecebimentosTempvalorlancto.AsCurrency;
            vValorPagtoConfirmado := vValorPagtoConfirmado - qryRecebimentosTempvalorlancto.AsCurrency;
            qryRecebimentosTemp.Edit;
            qryRecebimentosTempok.AsBoolean := false;
            qryRecebimentosTemp.post;
          end;
        end
        else
        if (qryRecebimentosTemptipotiporecebimento.AsString = 'C') or
           (qryRecebimentosTemptipotiporecebimento.AsString = 'B') then
        begin
            if comTef then
              vValorPagtoCartao := vValorPagtoCartao - qryRecebimentosTempvalorlancto.AsCurrency;

          if qryRecebimentosTempok.asboolean then
          begin
            if not comTef then
              vValorPagtoCartao := vValorPagtoCartao - qryRecebimentosTempvalorlancto.AsCurrency;

            vValorPagtoConfirmado := vValorPagtoConfirmado - qryRecebimentosTempvalorlancto.AsCurrency;
            qryRecebimentosTemp.Edit;
            qryRecebimentosTempok.AsBoolean := false;
            qryRecebimentosTemp.post;
          end;
        end;
      end;
      qryrecebimentostemp.next;
    end;
  end;

var
  vRetornoCheque, maior, i : integer;
  vRetorno  : TMessageButton;

begin
  result := true;
  FExcecao := false;

  if (TotalRecebimentos < ValorAReceber) then
  begin

    {
    if vTipoDescontoAntesAlterar = '%' then
    begin
      if MensagemSelecionaOpcao('A soma dos recebimentos difere do valor da venda. Atribuir a diferença ao ''(%) percentual'' de desconto? ') = smbYes then
      begin
        vNovoPercentualDesconto :=  roundto( (TotalRecebimentos * 100) / ValorAReceber, -2);

        vNovoValordeDesconto    :=
      end;
    end
    else
    if MensagemSelecionaOpcao('A soma dos recebimentos difere do valor da venda. Atribuir a diferença ao ''(R$) valor'' de desconto? ') = smbYes then
    begin
      vNovoPercentualDesconto :=
      vNovoValordeDesconto    :=
    end;
    }

    MensagemAviso('A soma dos recebimentos difere do valor da venda.');
    result := false;
  end;

  if (TotalRecebimentos < 0) or  (ValorAReceber < 0) then
  begin
    MensagemAviso('A soma dos recebimentos esta negativa.');
    result := false;
  end;

  if result then
  begin
    FGravandoRecebimentos := True;
    try
      try

    //    qryRecebimentosTemp.DisableControls;
        qryRecebimentosTemp.First;

        while not qryRecebimentosTemp.Eof do
        begin
          if not qryRecebimentosTemp.ReadOnly or qryRecebimentosTempehcreditodetroca.asboolean then
          begin
            if qryRecebimentosTemptipo.AsString = 'D' then    //dinheiro
            begin
              vValorPagtoDinheiro := vValorPagtoDinheiro + qryRecebimentosTempvalorlancto.AsCurrency;
              ConfirmarRecebimentosTemp;
              vValorPagtoConfirmado := vValorPagtoConfirmado + qryRecebimentosTempvalorlancto.AsCurrency;
            end
            else
            if qryRecebimentosTemptipo.AsString = 'T' then    //Crédito Troca
            begin
              vValorcreditotroca := vValorcreditotroca + qryRecebimentosTempvalorlancto.AsCurrency;
              ConfirmarRecebimentosTemp;
              vValorPagtoConfirmado := vValorPagtoConfirmado + qryRecebimentosTempvalorlancto.AsCurrency;
            end
            else
            if qryRecebimentosTemptipo.AsString = 'H' then    //cheque
            begin
              try
                vValorCheque := 0;
                vok := (vTotalValoresCheques = qryRecebimentosTempvalorlancto.AsCurrency);
                vRetorno := smbNO;

                if (vTotalValoresCheques < qryRecebimentosTempvalorlancto.AsCurrency) and
                   ((ParSistema.ChequenoFrentedeCaixa = 'Opcional') or
                    (ParSistema.ChequenoFrentedeCaixa = 'Obrigatório')) then
                begin
                  if (ParSistema.ChequenoFrentedeCaixa = 'Opcional') then
                    vRetorno := MensagemSelecionaOpcao('Deseja informar o(s) dado(s) do(s) cheque(s)?')
                  else
                    vRetorno := smbYes;
                end;

                while vTotalValoresCheques < qryRecebimentosTempvalorlancto.AsCurrency do
                begin
                  vValorCheque := qryRecebimentosTempvalorlancto.AsCurrency - vTotalValoresCheques;
                  vRetornoCheque := 0;

                  if vRetorno = smbYes then
                  begin
                    if not assigned(frmCadastroChequeFrenteCaixa) then
                    begin
                      origem := 'Recebimentos';
                      if not assigned(frmCadastroChequeFrenteCaixa) then
                        frmCadastroChequeFrenteCaixa := TfrmCadastroChequeFrenteCaixa.Create(self.Owner);
                    end;


                    frmCadastroChequeFrenteCaixa.fraCMC7.LimparCampos;
                    frmCadastroChequeFrenteCaixa.ValorCheque := FloatToStr(vValorCheque);
                    frmCadastroChequeFrenteCaixa.edtValorCheque.valormaximo := vValorCheque;

                    vRetornoCheque := frmCadastroChequeFrenteCaixa.ShowModal;

                    if (vRetornoCheque = mrOK) then
                    begin
                      vValorCheque := StrToFloat(frmCadastroChequeFrenteCaixa.ValorCheque);
                      IncluirRecebimentoCheque(true);
                    end;
                  end;

                  if ((vRetorno = smbNO) and (ParSistema.ChequenoFrentedeCaixa = 'Sem Cheque')) or
                     ((vRetorno = smbNO) and (ParSistema.ChequenoFrentedeCaixa = 'Opcional')) or
                     ((vRetorno = smbYes) and (vRetornoCheque = mrOK)) then
                    vTotalValoresCheques := vTotalValoresCheques + vValorCheque;

                  if (vTotalValoresCheques < qryRecebimentosTempvalorlancto.AsCurrency) and (vRetorno = smbYes) then
                  begin
                    vRetorno := MensagemSelecionaOpcao('Saldo Restante de Cheques: ' +
                                                        formatfloat('###,##0.00', qryRecebimentosTempvalorlancto.AsCurrency - vTotalValoresCheques) + chr(13) +
                                                       'Deseja continuar a informar o(s) dado(s) do(s) cheque(s)?');
                    if (vretorno = smbNo) then
                    begin
                      if (ParSistema.ChequenoFrentedeCaixa = 'Obrigatório') then
                        vok := false
                      else
                        vok := true;
                      break;
                    end
                    else
                    if (vRetorno = smbCancel) then
                    begin
                      vok := false;
                      break;
                    end;
                  end
                  else
                  if (vRetorno = smbCancel) then
                  begin
                    vok := false;
                    break;
                  end
                  else
                  if vTotalValoresCheques = qryRecebimentosTempvalorlancto.AsCurrency then
                    vok := true

                end;

                if vok then
                begin
                  vValorPagtoCheque := vValorPagtoCheque + qryRecebimentosTempvalorlancto.AsCurrency;
                  ConfirmarRecebimentosTemp;
                  vValorPagtoConfirmado := vValorPagtoConfirmado + qryRecebimentosTempvalorlancto.AsCurrency;
                  result := true;
                end
                else
                begin
                  result := false;
                  if (ParSistema.ChequenoFrentedeCaixa = 'Obrigatório') or
                     (vTotalValoresCheques > qryRecebimentosTempvalorlancto.AsCurrency) then
                    MensagemErro('O total dos valores dos cheques não estão fechando com o total do recebimento em cheque informado');
                end;

              finally
                if assigned(frmCadastroChequeFrenteCaixa) then
//                  frmCadastroChequeFrenteCaixa.Release;
              end;

            end
            else
            if ((qryRecebimentosTemptipo.AsString = 'C')  or     //credito
                (qryRecebimentosTemptipo.AsString = 'B')) then   //debito
            begin
              if not comtef then
              begin
                vValorCartao := 0;
                for i := 1 to qryRecebimentosTempnumerorecebimentos.asinteger do
                begin
                  qryRecebimentos.Append;
//                  qryRecebimentosdatavencto.AsDateTime := DataServidor;

                  spcRecebimentosProximo.Open;
                  qryRecebimentoscodigo.AsInteger := spcRecebimentosProximocodigo.AsInteger;
                  spcRecebimentosProximo.Close;

                  qryRecebimentosfilial.AsInteger       := FilialBase;
                  qryRecebimentossituacao.AsString      := 'N';
                  qryRecebimentosdatalancto.AsDateTime  := DataHoraServidor;
                  if i = 1 then
                    vControleRecebimento := qryRecebimentoscodigo.AsInteger;
                  qryRecebimentoscontrolerecebimento.AsInteger := vControleRecebimento;

                  if i = qryRecebimentosTempnumerorecebimentos.asinteger then
                    qryRecebimentosvalorlancto.AsCurrency := qryRecebimentosTempvalorlancto.AsCurrency - vValorCartao
                  else
                    qryRecebimentosvalorlancto.AsCurrency := RoundTo(qryRecebimentosTempvalorlancto.AsCurrency / qryRecebimentosTempnumerorecebimentos.AsInteger,-2);

                  qryRecebimentostipo.AsString := qryRecebimentosTemptipotiporecebimento.AsString;
                  qryRecebimentostiporecebimento.AsInteger := qryRecebimentosTemptiporecebimento.asInteger;
                  qryRecebimentosvalortotal.AsCurrency := qryRecebimentosTempvalorlancto.AsCurrency;
                  qryRecebimentoscontrole.AsInteger     := i;

                  qryRecebimentostef.clear;

                  qryRecebimentos.Post;
                  ConfirmarRecebimentosTemp;
                  vValorPagtoConfirmado := vValorPagtoConfirmado + qryRecebimentosvalorlancto.AsCurrency;
                  vValorPagtoCartao := vValorPagtoCartao + qryRecebimentosvalorlancto.AsCurrency;
                  vValorCartao :=  vValorCartao + qryRecebimentosvalorlancto.AsCurrency;
                end;
              end
              else
                vValorPagtoCartao := vValorPagtoCartao + qryRecebimentosTempvalorlancto.AsCurrency;
            end;
          end;

          if not result then
             break;

          qryRecebimentosTemp.Next;
        end;

//        (FSaldoRestante + ifthen(CondicaoTrocoMaximoTef,10,0))


        if (TotalRecebimentos > ValorAReceber) and (vValorPagtoDinheiro < (TotalRecebimentos - ValorAReceber)) and result then
        begin
          if vValorPagtoDinheiro = 0 then
            MensagemAviso('Existe troco e nenhuma forma de pagamento em dinheiro foi informada')
          else
            MensagemAviso('O valor pago em dinheiro é inferior ao valor do troco');
          result := false;
          limpartabela(qryRecebimentos);
        end;

        if result then
        begin
          if comtef then
          begin
//            vTEFJaIniciado := true;
            TEFPadrao.ValorPagoDinheiro := vValorPagtoDinheiro;
            TEFPadrao.Valorcreditotroca := vValorcreditotroca;
            TEFPadrao.ValorPagoCheque := vValorPagtoCheque;
            tefpadrao.ValorDesconto := ValorDesconto + desconto_cashback;
            tefpadrao.ValorAcrescimo := ValorAcrescimo;

            TEFPadrao.MensagemCupom := MensagemCupomFiscal;

            try

              qryRecebimentosTemp.AfterScroll := nil;
              qryRecebimentosTemp.First;
              while not qryRecebimentosTemp.Eof do
              begin
                if not qryRecebimentosTempok.AsBoolean then
                begin
                  if ((qryRecebimentosTemptipo.AsString = 'C')  or     //credito
                      (qryRecebimentosTemptipo.AsString = 'B'))  then   //debito
                  begin
                    TEFPadrao.ValorTransacao := floattostr(qryRecebimentosTempvalorlancto.AsCurrency);
                    result := TEFPadrao.ExecutarOperacao(sopCARTAO, 0);
                    if result then
                    begin
                      if not qryAgentes.locate('descricao', tefpadrao.Administradora, []) then
                      begin
                        qryAgentes.append;
                        spcAgentesProximo.open;
                        qryAgentescodigo.asinteger := spcAgentesProximocodigo.asinteger;
                        spcAgentesProximo.close;
                        qryAgentesdescricao.asstring := tefpadrao.Administradora;
                        qryAgentes.post;
                      end;

                      if not qryTiposRecebimentos.locate('descricaoagente;nomerede;numerorecebimentos;tiporecebimento',
                          VarArrayof([tefpadrao.Administradora,
                                      tefpadrao.nomerede,
                                      TefPadrao.QtdadeParcelas,
                                      RecebimentosTipo]), []) then
                      begin
                        qryTiposRecebimentos.append;
                        spcTiposRecebimentosProximo.Open;
                        qryTiposRecebimentoscodigo.asInteger:= spcTiposRecebimentosProximocodigo.AsInteger;
                        spcTiposRecebimentosProximo.Close;

                        qryTiposRecebimentosagente.asinteger := qryAgentescodigo.asinteger;
                        qryTiposRecebimentosdescricaoagente.asstring := qryAgentesdescricao.asstring;
                        qryTiposRecebimentosnumerorecebimentos.asinteger := TefPadrao.QtdadeParcelas;
                        qryTiposRecebimentosdiasuteis.AsInteger := 1;  {necessário o valor caso contrário dá erro na trigger da tabela tiposrecebimentos}
                        qryTiposRecebimentosintervalorecebimentos.asinteger := 0;
                        qryTiposRecebimentostiporecebimento.asstring := RecebimentosTipo;
                        qryTiposRecebimentosnomerede.AsString := tefpadrao.nomerede;

                        qryTiposRecebimentosdescricao.asstring := qryTiposRecebimentosdescricaoagente.asstring + ' - ' +
                                                                  qryTiposRecebimentosnumerorecebimentos.asString + 'X' +
                                                                  qryTiposRecebimentosnomerede.AsString ;

                        qryTiposRecebimentos.post;
                      end;

                      qryRecebimentosTemp.readonly := false;
                      qryRecebimentosTemp.Edit;
                      qryRecebimentosTemptiporecebimento.AsInteger := qryTiposRecebimentoscodigo.asInteger;
                      qryRecebimentostemptef.AsString          := tefpadrao.nsu;
                      qryRecebimentostempnomeredensu.asstring   := tefpadrao.nomerede;
                      qryRecebimentostemphora.asString := TefPadrao.HoraTransacao;
                      qryRecebimentostempdata.AsString := tefpadrao.DataTransacao;
                      qryRecebimentosTempcnpjcredenciadora.asString := tefPadrao.cnpjcredenciadora;
                      qryRecebimentosTempbandeiraoperadora.asString := tefPadrao.bandeiraoperadora;
                      {
                      qryRecebimentosTempnrautorizacaocartao.asString := tefPadrao.nrautorizacaocartao;

                      qryRecebimentosTempcnpjcredenciadora.asString := Credenciadora(tefpadrao.nomerede, tpcnpj);
                      qryRecebimentosTempbandeiraoperadora.asString := Credenciadora(tefpadrao.nomerede, tpbandeira);
                      }
                      qryRecebimentosTempnrautorizacaocartao.asString := tefpadrao.nsu;

                      qryRecebimentosTemp.post;
                      ConfirmarRecebimentosTemp;

                      vValorCartao := 0;
                      for i := 1 to tefpadrao.QtdadeParcelas do
                      begin
                        qryRecebimentos.Append;
//                        qryRecebimentosdatavencto.AsDateTime := strtodate(tefpadrao.DataTransacao);

                        spcRecebimentosProximo.Open;
                        qryRecebimentoscodigo.AsInteger := spcRecebimentosProximocodigo.AsInteger;
                        spcRecebimentosProximo.Close;


                        qryRecebimentosfilial.AsInteger       := FilialBase;
                        qryRecebimentossituacao.AsString      := 'N';
                        qryRecebimentosdatalancto.AsDateTime  := strtodatetime(tefpadrao.DataTransacao + ' ' + tefpadrao.HoraTransacao);

                        if i = 1 then
                          vControleRecebimento := qryRecebimentoscodigo.AsInteger;
                        qryRecebimentoscontrolerecebimento.AsInteger := vControleRecebimento;


                        if i = tefpadrao.QtdadeParcelas then
                          qryRecebimentosvalorlancto.AsCurrency := qryRecebimentosTempvalorlancto.AsCurrency - vValorCartao
                        else
                          qryRecebimentosvalorlancto.AsCurrency := RoundTo(qryRecebimentosTempvalorlancto.AsCurrency / tefpadrao.QtdadeParcelas,-2);

                        qryRecebimentosvalortotal.AsCurrency := qryRecebimentosTempvalorlancto.AsCurrency;

//                        qryRecebimentosdatavencto.AsDateTime  := strtodate(tefpadrao.DataTransacao);
                        qryRecebimentostipo.AsString := RecebimentosTipo;
                        qryRecebimentostiporecebimento.AsInteger := qryTiposRecebimentoscodigo.asInteger;
                        qryRecebimentoscontrole.AsInteger     := i;
                        qryRecebimentostef.AsString          := tefpadrao.nsu;
                        qryRecebimentosnomeredensu.asstring   := tefpadrao.nomerede;
                        qryRecebimentoshora.asdatetime := strtodatetime(TefPadrao.HoraTransacao);

                        qryRecebimentoscnpjcredenciadora.asString := TefPadrao.cnpjcredenciadora;
                        qryRecebimentosbandeiraoperadora.asString := TefPadrao.bandeiraoperadora;
                        qryRecebimentosnrautorizacaocartao.asString := TefPadrao.nrautorizacaocartao;

                        qryRecebimentos.Post;

                        vJaPossuiPagamentCartaoAprovado := true;

                        vValorPagtoConfirmado := vValorPagtoConfirmado + qryRecebimentosvalorlancto.AsCurrency;
  //                        vValorPagtoCartao := vValorPagtoCartao + qryRecebimentosvalorlancto.AsCurrency;
                        vValorCartao := vValorCartao + qryRecebimentosvalorlancto.AsCurrency;

                      end;
                    end
                    else
                    begin

                      if assigned(ecfpadrao) and  not ({vJaPossuiPagamentCartaoAprovado and} (ecfpadrao.Estado = estVenda)) then
                      begin
                        FExcecao := true;
                        tefpadrao.CancelarTransacoesPendentes;
                        result := false;
                        vJaPossuiPagamentCartaoAprovado := false;
                      end;

                      break;
                    end;

                  end;
                end;

                if result or qryRecebimentosTempok.AsBoolean then
                  qryRecebimentosTemp.Next

              end;
            finally
              qryRecebimentosTemp.AfterScroll := qryRecebimentosTempAfterScroll;
            end;

            if result then
            begin
              if (tefpadrao.RespostasPendentes.Count > 0) and
                 (vValorPagtoConfirmado = ValorAReceber) then
               begin
                 tefpadrao.FinalizarCupom(true);
                 tefpadrao.ImprimirTransacoesPendentes;
               end;

              if (tefpadrao.RespostasPendentes.Count <= 0) then
              begin
                FCupomTotalizado := true;
                FSituacaoCupom := scTotalizado;
                valortotalimpostoibt := 0;
                valortotalimpostofederal:=0;
                valortotalimpostoestadual:=0;
              end;

            {
            end
            else
            if not vJaPossuiPagamentCartaoAprovado  or
               (tefpadrao.RespostasPendentes.Count = 0) then
            begin
              if not FExcecao then
              begin
                qryrecebimentostemp.First;
                while not qryrecebimentostemp.eof do
                begin
                  if not qryrecebimentostemp.ReadOnly then
                  begin
                    qryRecebimentosTemp.Edit;
                    qryRecebimentosTempok.AsBoolean := false;
                    qryRecebimentosTemp.post;
                  end;
                  qryrecebimentostemp.next;
                end;
              end;
              }
            end;
          end
          else
            result := FecharCupomSemTEF;

          if (vValorcreditotroca <> 0) and  (ClienteVenda <> 0) then
          begin
//             AbrirDadosCreditoCliente;
//             result := Validar

            result := ValidarCreditoTroca(ClienteVenda, 'C', nil,
                       ValorAReceber,
                       dmvisualizarsaldotroca.SeValorMaiorSaldoFrenteCaixa,
                       False,
                       false,
                       'O Valor do crédito de troca será reatualizado.',
                       vValorcreditotroca);

            if result then
            begin
               ReFazConsulta(qryProdutosTrocados,[],[]);

               qryprodutostrocados.Insert;
               spcProdutosTrocadosProximo.Open;
               qryProdutosTrocadosnumero.AsInteger := spcProdutosTrocadosProximonumero.AsInteger;
               spcProdutosTrocadosProximo.close;
               qryProdutosTrocadostipo.AsString := 'S';
               qryProdutosTrocadosdata.AsDateTime := now();
               qryProdutosTrocadoscliente.AsInteger := ClienteVenda;
               qryProdutosTrocadostipocliente.AsString := 'C';
               qryProdutosTrocadosreferencia.asString := 'PAGAMENTO FRENTE DE CAIXA';
//                 qryProdutosTrocadoscontrato.AsString := numcontrato;
               qryProdutosTrocadosfilial.Asinteger := FilialBase;
               qryProdutosTrocadosusuario.AsInteger := CodigoUsuario;
               qryProdutosTrocadosvalor.AsCurrency := vValorcreditotroca;
               qryprodutostrocados.post;
            end;
          end;

          if result then
          begin
            qryrecebimentostemp.First;
            while not qryrecebimentostemp.eof do
            begin
              if not qryrecebimentostemp.ReadOnly or qryRecebimentosTempehcreditodetroca.asBoolean then
              begin
                if qryRecebimentosTemptipo.AsString = 'D' then
                  IncluirRecebimentoDinheiro
                else
                if qryRecebimentosTemptipo.AsString = 'T' then
                  IncluirRecebimentocreditotroca
                else
                if (qryRecebimentosTemptipo.AsString = 'H') and
                   ((qryRecebimentosTempvalorlancto.AsCurrency - vTotalValoresCheques) > 0) then
                  IncluirRecebimentoCheque(false)
              end;

              qryrecebimentostemp.next;
            end;

            result := FinalizaVenda(ComTef);

          end;

          if comtef and not result then
          begin
            if vJaPossuiPagamentCartaoAprovado and FExcecao then
            begin
              tefpadrao.ComandarECF( opeCancelaCupom );
              MensagemErro('Ocorreu um erro na gravação do cupom fiscal. Cancele as transações de cartões na sequencia.');
              try
                qryRecebimentosTemp.AfterScroll := nil;
                qryrecebimentostemp.first;
                while not qryrecebimentostemp.eof do
                begin
                  if qryRecebimentostemptef.AsString <> '' then
                    tefpadrao.CNC(qryRecebimentostempnomeredensu.asstring,
                                  qryRecebimentostemptef.AsString,
                                  strtodatetime(qryRecebimentostempdata.AsString + ' ' +qryRecebimentostemphora.AsString),
                                  qryRecebimentosTempvalorlancto.AsCurrency);

                    qryrecebimentostemp.Next
                end;
              finally
                qryRecebimentosTemp.AfterScroll := qryRecebimentosTempAfterScroll;
              end;
            end;
          end;
        end;


      except
        on E: Exception do
        begin
          HandleExcecao(E);
          result := false;
        end;
      end;
    finally
      if not result then
        RecalcularValoresVariaveis;
      FGravandoRecebimentos := False;
    end;
  end;
end;

procedure Tdtmfrentecaixa.dsrRecebimentosTempDataChange(Sender: TObject;
  Field: TField);
begin
  inherited;
  if field = qryrecebimentostemptiporecebimento then
  begin
    if qryTiposRecebimentos.Locate('codigo', qryrecebimentostemptiporecebimento.asinteger, []) then
    begin
      {
      if vJaPossuiPagamentCartaoAprovado and
         ((qryTiposRecebimentostiporecebimento.asstring = 'D') or
          (qryTiposRecebimentostiporecebimento.asstring = 'H')) then
      begin
        MensagemAviso('Opções em dinheiro e cheque não podem ser selecionadas após a existência de um pagamento TEF aprovado');
        qryrecebimentostemptiporecebimento.asinteger := qryrecebimentostemptiporecebimentoanterior.asinteger;
      end
      else
      begin
      }

        qryRecebimentosTemptipotiporecebimento.asstring := qryTiposRecebimentostiporecebimento.asstring;
        qryRecebimentosTempdescricaoagente.asstring := qryTiposRecebimentosdescricaoagente.asstring;
        qryRecebimentosTempnumerorecebimentos.AsInteger := qryTiposRecebimentosnumerorecebimentos.asinteger;

        if (qryRecebimentosTemptipotiporecebimento.asstring = 'C') or
           (qryRecebimentosTemptipotiporecebimento.asstring = 'B') then
          ExisteRecebimentoDebCred := true;

          {
        if vTEFJaIniciado  and
           ((qryTiposRecebimentostiporecebimento.asstring = 'D') or
            (qryTiposRecebimentostiporecebimento.asstring = 'H')) then
        begin
            tefpadrao.ComandarECF( opeCancelaCupom );
        end;
          }
      // end;
    end;
    qryRecebimentosTemptiporecebimentoanterior.asinteger := qryrecebimentostemptiporecebimento.asinteger;
  end
  else
  if field = qryRecebimentosTempok then
  begin
    qryRecebimentosTemp.readonly := (qryRecebimentosTemptef.asstring<>'') or qryRecebimentosTempehcreditodetroca.asBoolean;
    qryRecebimentosTemptiporec.readonly := (qryChequesIncluidosnumero.AsString<>'')
  end;

end;

procedure Tdtmfrentecaixa.qryRecebimentosTempAfterPost(DataSet: TDataSet);
begin
  inherited;

  if not qryRecebimentosTemp.isempty
    and (qryRecebimentosTemptipotiporecebimento.isnull or
         (qryRecebimentosTempvalorlancto.AsCurrency = 0)) then
    qryRecebimentosTemp.delete;

  if not FGravandoRecebimentos then
  begin
    TotalRecebimentos := 0;
    TotalRecebimentosCreditoTroca := 0;

    GuardarRegistroAtual(qryRecebimentosTemp,true);
    qryRecebimentosTemp.First;
    ExisteRecebimentoDebCred := false;
    while not qryRecebimentosTemp.Eof do
    begin
      TotalRecebimentos := TotalRecebimentos + qryRecebimentosTempvalorlancto.AsCurrency;
      if (qryRecebimentosTemptipotiporecebimento.asstring = 'C') or
         (qryRecebimentosTemptipotiporecebimento.asstring = 'B') then
        ExisteRecebimentoDebCred := true;

      if qryRecebimentosTemptipotiporecebimento.asstring = 'T' then
        TotalRecebimentosCreditoTroca := TotalRecebimentosCreditoTroca + qryRecebimentosTempvalorlancto.AsCurrency;

      qryRecebimentosTemp.Next;
    end;
    VoltarRegistroAtual(qryRecebimentosTemp);

    FSaldoRestante := FTotalPagar-ValorDesconto-Desconto_CashBack+ValorAcrescimo-ValorTotalDescontoItem - TotalRecebimentos;
    CalcularSaldoCheques;

{    if Assigned(AfterPostRecebimentos) then
      AfterPostRecebimentos(qryRecebimentosTemp);}

    AfterAlteracaoValores(nil);

    CalcularCashBackGerado;
  end;

end;

procedure Tdtmfrentecaixa.qryRecebimentosTempAfterScroll(
  DataSet: TDataSet);
begin
  inherited;
  qryRecebimentosTemp.readonly := (qryRecebimentosTemptef.asstring<>'') or qryRecebimentosTempehcreditodetroca.asBoolean; {or
                                  ((qryRecebimentosTemptipotiporecebimento.AsString='H') and not qryChequesIncluidos.IsEmpty)};
  qryRecebimentosTemptiporec.readonly := (qryChequesIncluidosnumero.AsString<>'');                                
  CalcularSaldoCheques;
end;

procedure Tdtmfrentecaixa.qryRecebimentosTempBeforePost(DataSet: TDataSet);
begin
  inherited;
  if qryRecebimentosTempnumerorecebimentos.AsInteger <> qryRecebimentosTempnumerorecto.AsInteger then
    qryRecebimentosTempnumerorecebimentos.AsInteger := qryRecebimentosTempnumerorecto.AsInteger;
  if qryRecebimentosTempintervalorecebimentos.AsInteger <> qryRecebimentosTempintervalorecto.AsInteger then
    qryRecebimentosTempintervalorecebimentos.AsInteger := qryRecebimentosTempintervalorecto.AsInteger;

end;

procedure Tdtmfrentecaixa.qryRecebimentosTempNewRecord(DataSet: TDataSet);
begin
  inherited;
  qryRecebimentosTemptiporecebimento.AsInteger := VerficarTipoRecebimento('DINHEIRO');
  qryRecebimentosTempsequencia.asinteger := qryRecebimentosTemp.recno;
end;

procedure Tdtmfrentecaixa.LimpaPagamentoTMP;
begin

end;

procedure Tdtmfrentecaixa.MontarRecebimentosParcelasAberto;
begin

  if qryRecebimentosTemp.isempty then
  begin
    if qryOrcamentos.active and (qryorcamentos.fieldbyname('valorvista').ascurrency = ValorTotalCompra) then
    begin
      qryParcelasPlanosOrcamentos.first;

      while not qryParcelasPlanosOrcamentos.Eof do
      begin
        qryRecebimentosTemp.readonly := false;
        qryRecebimentosTemp.Append;
        qryRecebimentosTemptiporecebimento.AsInteger := qryParcelasPlanosOrcamentostiporecebimento.asInteger;
        qryRecebimentosTemptipotiporecebimento.AsString := qryParcelasPlanosOrcamentosformapagamento.asString;
//        qryRecebimentosTemptipo
        qryRecebimentosTempdatalancto.AsDateTime := DataServidor;
        qryRecebimentosTempvalorlancto.AsCurrency := qryParcelasPlanosOrcamentosvalor.asCurrency;
        qryRecebimentosTempehcreditodetroca.asBoolean := (qryRecebimentosTemptipotiporecebimento.AsString = 'T');

        if qryRecebimentosTempehcreditodetroca.asBoolean then
          qryRecebimentosTempok.asboolean := true;

        qryRecebimentosTemp.post;

        if qryRecebimentosTempehcreditodetroca.asBoolean then
          qryRecebimentosTemptiporecebimento.AsInteger := VerficarTipoRecebimento('CRÉDITO DE TROCA');

        qryParcelasPlanosOrcamentos.Next;
      end;

    end
    else
    begin

      if qryOrcamentos.active and (qryOrcamentos.FieldByName('creditotroca').asCurrency <> 0) then
      begin

        qryRecebimentosTemp.Append;
        qryRecebimentosTemptipotiporecebimento.AsString := 'T';
        qryRecebimentosTempdatalancto.AsDateTime := DataServidor;
        qryRecebimentosTempvalorlancto.AsCurrency := qryOrcamentos.FieldByName('creditotroca').asCurrency;
        qryRecebimentosTempehcreditodetroca.asBoolean := True;
        qryRecebimentosTempok.asboolean := true;

        qryRecebimentosTemptiporecebimento.AsInteger := VerficarTipoRecebimento('CRÉDITO DE TROCA');

        qryRecebimentosTemp.Post;
      end;

      qryRecebimentosTemp.readonly := false;
      qryRecebimentosTemp.Append;
      qryRecebimentosTemptipotiporecebimento.AsString := 'D';
      qryRecebimentosTempdatalancto.AsDateTime := DataServidor;
      qryRecebimentosTempvalorlancto.AsCurrency := FSaldoRestante;
      qryRecebimentosTemptiporecebimento.AsInteger := VerficarTipoRecebimento('DINHEIRO');
      qryRecebimentosTemp.Post;

    end;

  end;
end;

procedure Tdtmfrentecaixa.verificarSituacaoImpressaoECF_e_TEF;
begin
  if assigned(tefpadrao) then
    if tefpadrao.RespostasPendentes.Count > 0 then
  //  if vJaPossuiPagamentCartaoAprovado then
       TEFPadrao.CancelarTransacoesPendentes;
end;

function Tdtmfrentecaixa.MensagemCupomFiscal: String;
var
  vPercTrib : Currency;
  vmsgcashback: String;
begin

  if NumeroNotaFiscalVinculada>0 then
  FMensagemDesconto := FMensagemDesconto + IfThen(FMensagemDesconto<>'',sLineBreak) +
                       'NF: ' + inttostr(NumeroNotaFiscalVinculada);

  if not qryVendedorcodigo.IsNull then
    FMensagemDesconto := FMensagemDesconto + IfThen(FMensagemDesconto<>'',sLineBreak) +
                         'Vendedor: ' + qryVendedorcodigo.AsString + ' - ' + qryVendedornome.AsString;

  if valortotalimpostoibt <> 0 then
  begin
    vPercTrib := roundto(valortotalimpostoibt / ValorTotalCompra * 100, -2);

    FMensagemDesconto := FMensagemDesconto + sLineBreak + IfThen(FMensagemDesconto<>'',sLineBreak) +
                         'Trib Aprox R$ '+FormatarValor(valortotalimpostofederal,2) + ' Federal R$ '
                          + FormatarValor(valortotalimpostoestadual,2) + ' Estadual ' + sLineBreak +
                          'Fonte: IBPT/FECOMERCIO '+'        '+chaveibpt;
  end;

  if clientevenda <> 0 then
  begin
    if (qrycontratos.recordcount <> 0) and qrycontratos.fieldbyname('os').asboolean then
    begin
      if qrycontratos.fieldbyname('equipamento').isnull then
        FMensagemDesconto := FMensagemDesconto + sLineBreak +
                             'OS: '+numContrato
      else
        FMensagemDesconto := FMensagemDesconto + sLineBreak +
                             'OS: '+numContrato + ' EQPTO/VEÍCULO: '+qrycontratos.fieldbyname('equipamento').asstring;
    end
    else
      FMensagemDesconto := FMensagemDesconto + sLineBreak +
                           'CONTRATO: '+numContrato;

    if desconto_cashback<>0 then
    begin
      vmsgcashback := ' O valor de R$ ' + FormatarValor(desconto_cashback,2) + sLineBreak +
         ' referente a desconto de CashBack';

      if (FMensagemDesconto <> '') then
        FMensagemDesconto := FMensagemDesconto + sLineBreak + vmsgcashback
      else
        FMensagemDesconto := vmsgcashback;
    end;

  end;

  if (ObsCupomFiscal <> '') then
  begin
    if (FMensagemDesconto <> '') then
      FMensagemDesconto := FMensagemDesconto + sLineBreak + ObsCupomFiscal
    else
      FMensagemDesconto := ObsCupomFiscal;
  end;

  {
  if parsistema.ExibirVendedornoCupom then
  begin
    if (FMensagemDesconto <> '') then
      FMensagemDesconto := FMensagemDesconto + sLineBreak + qryVendedorcodigo.AsString + ' - ' + qryVendedornome.AsString;
    else
      FMensagemDesconto := qryVendedorcodigo.AsString + ' - ' + qryVendedornome.AsString;
  end;
  }

  result := FMensagemDesconto;
end;


procedure Tdtmfrentecaixa.qryRecebimentosTempAfterInsert(
  DataSet: TDataSet);
begin
  inherited;
  if (ValorAReceber - TotalRecebimentos) > 0 then
    qryRecebimentosTempvalorlancto.AsCurrency := ValorAReceber - TotalRecebimentos;
end;

procedure Tdtmfrentecaixa.VerificarSaldoRecebimentosTemp;
begin
  if (qryRecebimentosTemp.RecordCount = 1) and (qryRecebimentosTemptipotiporecebimento.AsString = 'D') then
  begin
    qryRecebimentosTemp.edit;
    qryRecebimentosTempvalorlancto.AsCurrency := FSaldoRestante;;
    qryRecebimentosTemp.Post;
  end
  else
    FSaldoRestante := FTotalPagar-ValorDesconto-Desconto_CashBack+ValorAcrescimo-ValorTotalDescontoItem - TotalRecebimentos;
end;

procedure Tdtmfrentecaixa.HandleExcecao(E: Exception);
begin
  FExcecao:=true;
  ShowMessage(E.Message);
end;


procedure Tdtmfrentecaixa.ConfirmarRecebimentosTemp(Valor: boolean);
begin
  qryRecebimentosTemp.readonly := false;
  qryRecebimentosTemp.Edit;
  qryRecebimentosTempok.AsBoolean := Valor;
  qryRecebimentosTemp.post;
  qryRecebimentosTemp.readonly := qryRecebimentosTempok.asboolean;
end;

function Tdtmfrentecaixa.GetNumContrato: String;
begin
  if (fNumContrato = '') and (clientevenda <> 0) then
  begin
    if qryContratos.recordcount <> 0 then
      fNumContrato := qrycontratos.fieldByname('numero').asString
    else
    begin
      spcContratosProximo.Close;
      spcContratosProximo.Open;
      fNumContrato := spcContratosProximonumero.AsString;
    end
  end;
  result := fNumContrato;
end;

procedure Tdtmfrentecaixa.CalcularSaldoCheques;
begin
  vTotalValoresCheques := SomarValores(qryChequesIncluidos, [qryChequesIncluidosvalor], [], [], []);
  if Assigned(AfterPostRecebimentos) then
    AfterPostRecebimentos(qryRecebimentosTemp);

end;

procedure Tdtmfrentecaixa.qryRecebimentosTempBeforeDelete(
  DataSet: TDataSet);
begin
  inherited;
  LimparTabela(qryChequesIncluidos);
end;

procedure Tdtmfrentecaixa.qryChequesIncluidosAfterPost(DataSet: TDataSet);
begin
  inherited;
  if not fGravandoRecebimentos then
    CalcularSaldoCheques;
end;

procedure Tdtmfrentecaixa.qryChequesIncluidosCalcFields(DataSet: TDataSet);
begin
  inherited;
  qryChequesIncluidosnumerocheque.asstring := copy(qryChequesIncluidosnumero.asstring, 12,6);
end;

function Tdtmfrentecaixa.ConsultarClientes(ClienteChamadoAoIniciarVenda: boolean = false): Boolean;
{
var
  i : Integer;
  iCliente : Integer;
}
begin

  result := true;

  {
  ConsultarClientesThread := TConsultarClientesThread.Create(false);

  with ConsultarClientesThread do
  begin
//    Priority := tpTimeCritical;
//    FreeOnTerminate := true;
    execute;
//    OnTerminate := Self.FOnTerminate;
  end;

  ConsultarClientesThread.free;
  ConsultarClientesThread := nil;
}

  try
    vContinuarLeituraCodigoBarras := false ;

    Origem := 'Frente de Caixa';
             {
    tform(self.Owner).Constraints.MaxHeight := tform(self.Owner).Height;
    tform(self.Owner).Constraints.MinHeight := tform(self.Owner).Height;

    tform(self.Owner).Constraints.MaxWidth := tform(self.Owner).Width;
    tform(self.Owner).Constraints.MinWidth := tform(self.Owner).Width;
              }
    vJanelaMaximizada := tform(self.Owner).WindowState = wsMaximized;

    if not assigned(frmClienteFrenteCaixa) then
    begin
      AbreClientes;
      frmClienteFrenteCaixa := TfrmClienteFrenteCaixa.Create(self.owner);
    end;

    if ehFrenteCaixa or vJanelaMaximizada then
    begin
      tform(self.Owner).WindowState := wsMaximized;
//      frmClienteFrenteCaixa.WindowState := wsMaximized;
      frmClienteFrenteCaixa.formStyle := fsStayOnTop;
      frmClienteFrenteCaixa.edfCodigoCliente.setfocus;

    end;

//    tform(self.Owner).WindowState := wsMaximized;

    if ClienteChamadoAoIniciarVenda then
      FrmClienteFrenteCaixa.OntecClose := RetornarFluxoIniciarVenda
    else
    if vJanelaMaximizada then
      FrmClienteFrenteCaixa.OntecClose := RetornarJanelaMaximizada;

  finally
    vContinuarLeituraCodigoBarras := true;
//  tform(self.Owner).WindowState := wsMaximized;
  end;

(*
    Result := true;
    Origem := 'Frente de Caixa';
  //  dtmFrenteCaixa.ReFazConsulta(dtmFrenteCaixa.qryCliente, [0], [0]);

    if not assigned(frmClienteFrenteCaixa) then
      frmClienteFrenteCaixa := TfrmClienteFrenteCaixa.Create(self.owner);
*)

//    iCliente := dtmFrenteCaixa.CodigoCliente;
  //  frmClienteFrenteCaixa.ActiveControl := frmClienteFrenteCaixa.edfCodigoCliente;
  //  frmClienteFrenteCaixa.edfCodigoCliente.exist;

  //  i:= frmClienteFrenteCaixa.ShowModal;
  //  frmClienteFrenteCaixa.Free;
  //  frmClienteFrenteCaixa.release;

    {
    Result := False;

    if i = mrCancel then
      dtmFrenteCaixa.FechaClientes(True);
    if i = mrAbort then
      dtmFrenteCaixa.consultaClienteCodigo(iCliente);

    if i = mrOK then
    begin
      Result := True;
      dtmFrenteCaixa.clienteVenda := dtmfrenteCaixa.qryclientecodigo.asinteger;
      dtmFrenteCaixa.nomeclienteVenda := dtmfrenteCaixa.qryclientenome.asstring;
    end;

    }
end;

procedure Tdtmfrentecaixa.qryClienteCalcFields(DataSet: TDataSet);
begin
  inherited;
  if qryClientenomeclientevenda.asstring <> NomeClienteVenda then
    qryClientenomeclientevenda.asstring := NomeClienteVenda;
end;

procedure Tdtmfrentecaixa.SetNomeClienteVenda(const Value: String);
begin
  fNomeClienteVenda := Value;
  if qryCliente.Active then
    qryClienteCalcFields(qryCliente);
end;

procedure Tdtmfrentecaixa.VenderItensdoOrcamento(Orcamento: integer);
begin

  RefazConsultaPorNome(qryOrcamentos, ['codigo'], [Orcamento]);

  ValidarCreditoTroca(qryOrcamentos.fieldByName('cliente').asInteger,
                     qryOrcamentos.fieldByName('tipocliente').asString,
                     qryOrcamentos.fieldByName('creditotroca'),

                     qryOrcamentos.fieldByName('totalprodutos').AsCurrency +
                     qryOrcamentos.fieldByName('totalservicos').AsCurrency +
                     qryOrcamentos.fieldByName('frete').AsCurrency +
                     qryOrcamentos.fieldByName('seguro').AsCurrency,

                     dmvisualizarsaldotroca.SeValorMaiorSaldo,

                     False,
                     true,
                     'O Valor do crédito de troca será reatualizado.');

  if qryOrcamentos.state = dsedit then
    qryOrcamentos.post;

  SelecionarVendedor(False, qryOrcamentos.fieldByname('vendedor').AsInteger);
  RefazConsultaPorNome(qryProdutosOrcamentos, ['orcamento'], [Orcamento]);
  RefazConsultaPorNome(qryParcelasPlanosOrcamentos, ['orcamento'], [Orcamento]);

  qryProdutosOrcamentos.first;
  while not qryProdutosOrcamentos.eof do
  begin

    if ExisteProduto(qryProdutosOrcamentosprodutovisual.AsString, StrToInt64(qryProdutosOrcamentosproduto.AsString) ) then
    begin

      if (ClienteVenda <> qryOrcamentos.fieldByname('cliente').AsInteger) and (qryOrcamentos.fieldByname('cliente').AsInteger<>0) then
      begin
        RefazConsultaPorNome(qryCliente,['codigo'],[qryOrcamentos.fieldByname('cliente').AsInteger]);
        clienteVenda := qryclientecodigo.asinteger;
        nomeclienteVenda := qryclientenome.asstring;
      end;

      if GuardarItem(qryProdutosOrcamentosquantidade.AsFloat,
                     qryProdutosOrcamentosvalordescontoitem.AsFloat +
                     qryProdutosOrcamentosdescontogeral.AsFloat, false) then
      begin
        qryProdutosDigitados.edit;
        qryProdutosDigitadospreco.AsCurrency := qryProdutosOrcamentosprecovenda.AsCurrency;
        qryProdutosDigitados.post;

        qryProdutosOrcamentos.Edit;
        qryProdutosOrcamentosvendido.AsFloat := qryProdutosOrcamentosquantidade.AsFloat;
        qryProdutosOrcamentos.Post;

        if dtmFrenteCaixa.CondicaoVenderItem then
          if VendaAberta or IniciarVenda then
            dtmFrenteCaixa.VenderItemT;
      end;
    end;

    while true do
    begin
      if vContinuarLeituraCodigoBarras and (qryProdutosDigitados.recordcount=0) then
        break;
    end;

    qryProdutosOrcamentos.next;
  end;

end;

function Tdtmfrentecaixa.GetChequeAutenticado: Boolean;
begin
  Result := qryChequeautenticado.AsBoolean
end;

function Tdtmfrentecaixa.GetSituacaoChequeNormal: Boolean;
begin
  Result := qryChequesituacao.AsString = 'N';
end;

