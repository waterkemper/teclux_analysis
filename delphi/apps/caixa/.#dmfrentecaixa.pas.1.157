function Tdtmfrentecaixa.EfetuarDesconto:Boolean;
var
  OK: Boolean;
  botao : TMessageButton;
begin
  Result := False;
  frmLerValor := TfrmLerValor.Create(frmLerValor, 'Desconto');
  try
    botao :=  MensagemSelecionaOpcao('Sim para desconto por percentual.'+#13+ 'Não para desconto por valor.');
    if botao = smbNO then
      FDescontoPorValor := True;
    OK := False;
    if not(botao = smbCancel) then
    begin
      frmLerValor.Numero := 0;
      OK := frmLerValor.ShowModal = mrOK;
    end;
    if OK then
    begin
      ValorDesconto := frmLerValor.Numero;
      if TemComposto then
        FDescontoProdutoComposto:= ValorDesconto + FDescontoProdutoComposto;
      if not (FDescontoPorValor) then
        ValorDesconto := ValorDoPercentualSobreTotal(TotalPagar, ValorDesconto);

      if ValidarDesconto then
      begin
        ValorAReceber := FTotalPagar - ValorDesconto - Desconto_CashBack - ValorTotalDescontoItem + ValorAcrescimo;
        FSaldoRestante := ValorAReceber;
        Result := True;
      end
      else
      begin
        ValorDesconto := 0;
      end;
    end;
  finally
    frmLerValor.Free;
  end;
end;


function Tdtmfrentecaixa.EfetuarMultiplosPagamentos: boolean;
begin
  result := not TransferenciaNaoConfirmada(true);
  if result then
  begin
    if (TotalPagar > 0) and (SaldoRestante > 0) then
    begin
//      if not assigned(frmparcelasrecebimentosfrentecaixa) then
      try
        IniciarTabelaRecebimentoTemp;
        FSaldoRestante := FTotalPagar-ValorDesconto-Desconto_CashBack+ValorAcrescimo-ValorTotalDescontoItem - TotalRecebimentos;
        qryrecebimentostemp.afterscroll := qryrecebimentostempafterscroll;


        refazconsulta(qryAgentes, [], []);



        refazconsultaPorNome(qryTiposRecebimentos, ['PossuiOrcamentocomCreditodeTroca'], [True]);
        
           (*
        if qryorcamentos.active and (qryorcamentos.FieldByName('creditotroca').AsCurrency <> 0) then
          refazconsultaPorNome(qryTiposRecebimentos, ['PossuiOrcamentocomCreditodeTroca'], [True])
        else
          refazconsultaPorNome(qryTiposRecebimentos, ['PossuiOrcamentocomCreditodeTroca'], [False]);
          *)


        refazconsulta(qryRecebimentos, [], []);
        refazconsulta(qryChequesIncluidos, [], []);
        qryRecebimentosTemp.readonly := false;

        {
        qryRecebimentosTemp.AfterScroll := nil;
        qryRecebimentosTemp.first;
        while not qryRecebimentosTemp.eof do
        begin
          ConfirmarRecebimentosTemp(false);
          qryRecebimentostemp.next;
        end;
        qryRecebimentosTemp.AfterScroll := qryRecebimentosTempAfterScroll;
        }

        vValorPagtoDinheiro := 0;
        vValorcreditotroca := 0;
        vValorPagtoCheque := 0;
        vValorPagtoCartao := 0;
        vValorPagtoConfirmado := 0;
        vJaPossuiPagamentCartaoAprovado := false;
        CupomTotalizado := false;
        fexcecao := false;

        frmparcelasrecebimentosfrentecaixa := Tfrmparcelasrecebimentosfrentecaixa.Create(frmParcelasRecebimentosFrenteCaixa);
//        frmparcelasrecebimentosfrentecaixa.edtDesconto.text := floattostr(ValorDesconto);
//        frmparcelasrecebimentosfrentecaixa.edtAcrescimo.text := floattostr(ValorAcrescimo);

        if frmParcelasRecebimentosfrentecaixa.ShowModal = mrOK then
          result := true
        else
          result := false;
      finally
        frmParcelasRecebimentosFrenteCaixa.free;
        qryrecebimentostemp.afterscroll := nil;
      end;

    end;
  end;

end;


function Tdtmfrentecaixa.ExcluirCupom: Integer;
const
  WhereSQL = '((m.produto = %d) and (m.filial = %d) and (m.numero >= (select max(m1.numero) ' +
             'from movimentos m1 where (m1.numero < %s) and (m1.produto =  %d) and (m1.filial = %d)))) or ';
type
  tMov = record
    numero:              INTEGER;
    produto:             INT64;
    filial:              Integer;
    data:                TDatetime;
    tipomovimento:       String[3];
    operacao:            String[20];
    emestoque:           Currency;
    reservado:           Currency;
    transito:            Currency;
    demonstracao:        Currency;
    conserto:            Currency;
    futuro:              Currency;
    danificada:          Currency;
    estoquefisico:       Currency;
    quantidade:          Currency;
    financeiro:          Real;
    valor:               Real;
    precocomicms:        Real;
    precosemicms:        Real;
    aliquotaIPI:         Real;
    referencia:          String;
    trfproduto:          INT64;
    trffilial:           Integer;
    trfmovimento:        INTEGER;
  end;

  tMovimento = array of record
    Produto: int64;
    Menor,
    Maior: Integer
  end;

var
  SQL: String;
  a, b: Integer;
  Mov: tMov;
  Movimento: tMovimento;

  procedure AtribuirEstoque;
  var
    Prod: String;
  begin
    Prod := IntToStr(Mov.produto);
    qryEstoque.Locate('produto;filial', VarArrayOf([Prod, Mov.filial]), []);
    qryEstoque.Edit;
    qryEstoquefinanceiro.AsFloat      := Mov.financeiro;
    qryEstoqueemestoque.AsCurrency     := Mov.emestoque;
    qryEstoquereservado.AsCurrency     := Mov.reservado;
    qryEstoquetransito.AsCurrency      := Mov.transito;
    qryEstoquedemonstracao.AsCurrency  := Mov.demonstracao;
    qryEstoqueconserto.AsCurrency      := Mov.conserto;
    qryEstoquefuturo.AsCurrency        := Mov.futuro;
    qryEstoquedanificada.AsCurrency    := Mov.danificada;
    qryEstoqueestoquefisico.AsCurrency := Mov.estoquefisico;
    qryEstoque.Post;
  end;

  procedure AtribuirMov;
  begin
    Mov.numero            := qryMovimentosnumero.AsInteger;
    Mov.produto     	  := qryMovimentosproduto.AsLargeInt;
    Mov.filial            := qryMovimentosfilial.AsInteger;
    Mov.tipomovimento     := qryMovimentostipomovimento.AsString;
    Mov.operacao          := qryMovimentosoperacao.AsString;
    Mov.emestoque         := qryMovimentosemestoque.AsCurrency;
    Mov.reservado         := qryMovimentosreservado.AsCurrency;
    Mov.transito          := qryMovimentostransito.AsCurrency;
    Mov.demonstracao      := qryMovimentosdemonstracao.AsCurrency;
    Mov.conserto          := qryMovimentosconserto.AsCurrency;
    Mov.futuro            := qryMovimentosfuturo.AsCurrency;
    Mov.danificada        := qryMovimentosdanificada.AsCurrency;
    Mov.estoquefisico     := qryMovimentosestoquefisico.AsCurrency;
    Mov.quantidade        := qryMovimentosquantidade.AsCurrency;
    Mov.financeiro        := qryMovimentosfinanceiro.AsFloat;
    Mov.valor             := qryMovimentosvalor.AsFloat;
    Mov.precocomicms      := qryMovimentosprecocomicms.AsFloat;
    Mov.precosemicms      := qryMovimentosprecosemicms.AsFloat;
    Mov.aliquotaipi       := qryMovimentosaliquotaipi.AsFloat;
    Mov.referencia        := qryMovimentosreferencia.AsString;
    Mov.trfproduto        := qryMovimentostrfproduto.AsLargeInt;
    Mov.trffilial         := qryMovimentostrffilial.AsInteger;
    Mov.trfmovimento      := qryMovimentostrfmovimento.AsInteger;
  end;

  function RealizarOperacao(Tipo: Integer; Oper: char): Integer;
  var
    Qtdade,
    TotalAnterior,
    TotalEstoque: Currency;
  begin
    Result := 0;
    Qtdade := Abs(qryMovimentosquantidade.AsCurrency);
    qryMovimentos.Edit;
    case Tipo of
      1: case Oper of
           '+': qryMovimentosemestoque.AsCurrency := Mov.emestoque + Qtdade;
           '-': if Mov.emestoque >= Qtdade then
                  qryMovimentosemestoque.AsCurrency := Mov.emestoque - Qtdade
                else
                  Result := 1;
           '=': qryMovimentosemestoque.AsCurrency := Qtdade;
           '*': qryMovimentosemestoque.AsCurrency := Mov.emestoque;
         end;
      2: case Oper of
           '+': qryMovimentosreservado.AsCurrency := Mov.reservado + Qtdade;
           '-': if Mov.reservado >= Qtdade then
                  qryMovimentosreservado.AsCurrency := Mov.reservado - Qtdade
                else
                  Result := 2;
           '=': qryMovimentosreservado.AsCurrency := Qtdade;
           '*': qryMovimentosreservado.AsCurrency := Mov.reservado;
         end;
      3: case Oper of
           '+': qryMovimentostransito.AsCurrency := Mov.transito + Qtdade;
           '-': if Mov.transito >= Qtdade then
                  qryMovimentostransito.AsCurrency := Mov.transito - Qtdade
                else
                  Result := 3;
           '=': qryMovimentostransito.AsCurrency := Qtdade;
           '*': qryMovimentostransito.AsCurrency := Mov.transito;
         end;
      4: case Oper of
           '+': qryMovimentosdemonstracao.AsCurrency := Mov.demonstracao + Qtdade;
           '-': if Mov.demonstracao >= Qtdade then
                  qryMovimentosdemonstracao.AsCurrency := Mov.demonstracao - Qtdade
                else
                  Result := 4;
           '=': qryMovimentosdemonstracao.AsCurrency := Qtdade;
           '*': qryMovimentosdemonstracao.AsCurrency := Mov.demonstracao;
         end;
      5: case Oper of
           '+': qryMovimentosconserto.AsCurrency := Mov.conserto + Qtdade;
           '-': if Mov.conserto >= Qtdade then
                  qryMovimentosconserto.AsCurrency := Mov.conserto - Qtdade
                else
                  Result := 5;
           '=': qryMovimentosconserto.AsCurrency := Qtdade;
           '*': qryMovimentosconserto.AsCurrency := Mov.conserto;
         end;
      6: case Oper of
           '+': qryMovimentosfuturo.AsCurrency := Mov.futuro + Qtdade;
           '-': if Mov.futuro >= Qtdade then
                  qryMovimentosfuturo.AsCurrency := Mov.futuro - Qtdade
                else
                  Result := 6;
           '=': qryMovimentosfuturo.AsCurrency := Qtdade;
           '*': qryMovimentosfuturo.AsCurrency := Mov.futuro;
         end;
      7: case Oper of
           '+': qryMovimentosdanificada.AsCurrency := Mov.danificada + Qtdade;
           '-': if Mov.danificada >= Qtdade then
                  qryMovimentosdanificada.AsCurrency := Mov.danificada - Qtdade
                else
                  Result := 7;
           '=': qryMovimentosdanificada.AsCurrency := Qtdade;
           '*': qryMovimentosdanificada.AsCurrency := Mov.danificada;
         end;
      8: case Oper of
           '+': qryMovimentosestoquefisico.AsCurrency := Mov.estoquefisico + Qtdade;
           '-': if Mov.estoquefisico >= Qtdade then
                  qryMovimentosestoquefisico.AsCurrency := Mov.estoquefisico - Qtdade
                else
                  Result := 8;
           '=': qryMovimentosestoquefisico.AsCurrency := Qtdade;
           '*': qryMovimentosestoquefisico.AsCurrency := Mov.estoquefisico;
         end;
      10: if Oper = '=' then begin
            qryEstoque.Edit;
            qryEstoqueultimaentrada.AsDateTime := qryMovimentosdata.AsDateTime;
            qryEstoque.Post
          end;
      11: if Oper = '=' then begin
            qryEstoque.Edit;
            qryEstoquedatacompra.AsDateTime := qryMovimentosdata.AsDateTime;
            qryEstoqueqtdecompra.AsCurrency  := qryMovimentosquantidade.AsCurrency;
            qryEstoqueprecosemicms.AsFloat  := qryMovimentosprecosemicms.AsFloat;
            qryEstoqueprecocomicms.AsFloat  := qryMovimentosprecocomicms.AsFloat;
            qryEstoquealiquotaipi.AsFloat   := qryMovimentosaliquotaipi.AsFloat;
            qryEstoque.Post
          end;
      12: begin
            case Oper of
              '+': qryMovimentosfinanceiro.AsFloat := Mov.financeiro + Abs(qryMovimentosvalor.AsFloat);
              '-': if Mov.financeiro >= Abs(qryMovimentosvalor.AsFloat) then
                     qryMovimentosfinanceiro.AsFloat := Mov.financeiro - Abs(qryMovimentosvalor.AsFloat)
                   else
                     Result := 8;
              '=': qryMovimentosfinanceiro.AsFloat := Abs(qryMovimentosvalor.AsFloat);
              'C': begin
                     TotalAnterior  := Mov.emestoque + Mov.reservado + Mov.transito +
                                       Mov.demonstracao + Mov.conserto + Mov.danificada;
                     TotalEstoque  := qryMovimentosemestoque.AsCurrency + qryMovimentosreservado.AsCurrency +
                                      qryMovimentostransito.AsCurrency  + qryMovimentosdemonstracao.AsCurrency +
                                      qryMovimentosconserto.AsCurrency  + qryMovimentosdanificada.AsCurrency;
                     if TotalAnterior <> 0 then
                       qryMovimentosfinanceiro.AsFloat := Mov.financeiro / TotalAnterior * TotalEstoque
                     else
                       Mov.Financeiro := 0;
                     qryMovimentosvalor.AsFloat := Abs(qryMovimentosfinanceiro.AsFloat - Mov.financeiro);
                   end;
              '*': begin
                     qryMovimentosvalor.AsFloat := 0;
                     qryMovimentosfinanceiro.AsFloat := Mov.financeiro
                   end
            end;
            if qryMovimentosfinanceiro.AsFloat < Mov.financeiro then begin
              qryMovimentosvalor.AsFloat        := -qryMovimentosvalor.AsFloat;
              qryMovimentosquantidade.AsCurrency := -Qtdade;
            end
          end
    end;
    qryMovimentos.Post;
  end;

begin
  BloquearEstoque;
  SQL := '';
  Movimento := nil;
  a := 0;
  ReFazConsulta(qryProdutosDadosFiscais, [0], [qryDadosFiscaisnumero.AsInteger]);
  SetLength(Movimento, qryProdutosDadosFiscais.RecordCount);
  while Not qryProdutosDadosFiscais.Eof do begin
    Movimento[a].Produto := qryProdutosDadosFiscaisproduto.AsLargeInt;
    Movimento[a].Menor   := qryProdutosDadosFiscaismovimento.AsInteger;
    SQL := SQL + Format(WhereSQL, [qryProdutosDadosFiscaisproduto.AsLargeInt, FilialBase, qryProdutosDadosFiscaismovimento.AsString, qryProdutosDadosFiscaisproduto.AsLargeInt, FilialBase]);
    Inc(a);
    qryProdutosDadosFiscais.Edit;
    qryProdutosDadosFiscaismovimento.Clear;
    qryProdutosDadosFiscais.Next;
  end;
  if SQL <> '' then begin
    Delete(SQL, Length(SQL) - 3, 4);
    qryMovimentos.Sql[28] := SQL;
    qryMovimentos.Open;
  end;
  a      := 0;
  Result := 0;
  while Not qryMovimentos.Eof do begin
    if qryMovimentosproduto.AsLargeInt = Movimento[a].Produto then
      if qryMovimentosnumero.AsInteger < Movimento[a].Menor then begin
        AtribuirMov;
        qryMovimentos.Next
      end else if qryMovimentosnumero.AsInteger = Movimento[a].Menor then begin
        qryMovimentos.Delete;
        if (qryMovimentosnumero.AsInteger < Movimento[a].Menor) or
           (qryMovimentosproduto.AsLargeInt <> Movimento[a].Produto)
        then begin
          qryMovimentos.Next;
          if qryMovimentos.Eof then
            AtribuirEstoque;
        end
      end else begin
        for b := 1 to 20 do begin
          Result := RealizarOperacao(b, qryMovimentosoperacao.AsString[b]);
          if Result > 0 then
            break;
        end;
        if Result = 0 then
          AtribuirMov
        else
          break;
        qryMovimentos.Next;
        if qryMovimentos.Eof or (qryMovimentosproduto.AsLargeInt <> Movimento[a].Produto) then
          AtribuirEstoque;
      end
    else begin
      AtribuirEstoque;
      Inc(a)
    end
  end
end;

function Tdtmfrentecaixa.ExisteCliente(Campo, Codigo: String): Boolean;
begin
  if Campo = 'nomecidade' then
    Campo:= 'c.nome'
  else
    Campo:= 'c.' + Campo;
  qryConsultaClientes.sql[16] := 'where ' + Campo + ' iLIKE ''' + Codigo + '%'' ';
  qryConsultaClientes.Open;
  Result:= not qryConsultaClientes.IsEmpty;
end;

function Tdtmfrentecaixa.ExisteCPFCNPJ: Boolean;
begin
  if (ParSistema.CPF_CNPJObrigatorio or (qryClientepessoanumero.AsString <> '')) then
    if qryCliente.State in [dsEdit, dsInsert] then begin
      qryCPFCNPJExiste.Sql[03]:= 'Where (pessoanumero = ''' + qryClientepessoanumero.AsString + ''')';
      if qryCliente.State in [dsInsert] then
        qryCPFCNPJExiste.Sql[04]:= ''
      else if qryCliente.State in [dsEdit] then
        qryCPFCNPJExiste.Sql[04]:= 'and (codigo <> ' + qryClientecodigo.AsString + ')';
      qryCPFCNPJExiste.Open;
      Result:= not qryCPFCNPJExiste.IsEmpty;
      if Result then begin
        if MensagemConfirmacao(format(ctCLIENTEJACADASTRADO,['cliente',qryCPFCNPJExisteNome.AsString])) = smbOk then
          ReFazConsulta(qryCliente,[0],[qryCPFCNPJExisteCodigo.AsInteger])
        else
          qryClientepessoanumero.Clear;
      end
    end else
      Result := False
  else
    Result := False
end;

function Tdtmfrentecaixa.ExisteProduto(Produtovisual: String; Produto: int64 = 0): Boolean;
begin
  ReFazConsultaporNome(qryProduto, ['produtovisual', 'Produto'], [ProdutoVisual, Produto]);
  Result := (qryProduto.recordcount = 1);

  if qryProduto.recordcount > 1 then
    MensagemErro(format('A pesquisa do produto visual/Cód. Barra %s retornou %s registros', [ Produtovisual, inttostr(qryProduto.recordcount)]));
end;

