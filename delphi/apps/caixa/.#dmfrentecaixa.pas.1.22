     qryTecContrato.FieldByName('connascto'         ).AsDateTime := qryCliente.FieldByName('connascto'             ).AsDateTime;
   if not qryCliente.FieldByName('conrendafaixa'         ).IsNull then
     qryTecContrato.FieldByName('conrendafaixa'     ).AsInteger  := qryCliente.FieldByName('conrendafaixa'         ).AsInteger;
   if not qryCliente.FieldByName('conrendavalor'         ).IsNull then
     qryTecContrato.FieldByName('conrendavalor'     ).AsCurrency := qryCliente.FieldByName('conrendavalor'         ).AsCurrency;

   if not qryCliente.FieldByName('conrua'                ).IsNull then
     qryTecContrato.FieldByName('conrua'            ).AsString   := qryCliente.FieldByName('conrua'                ).AsString;

   if not qryCliente.FieldByName('connumero'                ).IsNull then
     qryTecContrato.FieldByName('connumero'            ).AsString   := qryCliente.FieldByName('connumero'                ).AsString;
   if not qryCliente.FieldByName('concomplemento'                ).IsNull then
