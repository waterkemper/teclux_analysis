   if not qryCliente.FieldByName('empcomplemento'                ).IsNull then
     qryTecContrato.FieldByName('empcomplemento'            ).AsString   := qryCliente.FieldByName('empcomplemento'                ).AsString;

   if not qryCliente.FieldByName('empestado'             ).IsNull then
     qryTecContrato.FieldByName('empestado'         ).AsString   := qryCliente.FieldByName('empestado'             ).AsString;
