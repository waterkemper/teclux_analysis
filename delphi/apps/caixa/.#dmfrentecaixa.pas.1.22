function TdtmFrenteCaixa.FinalizaVenda: Boolean;
var
  a: Integer;
  CupomEmitido: Boolean;
  vPercTrib : Currency;
begin
  Result := False;
  CupomEmitido := False;
  try
    if TotalizarCupom then
    begin
      if FQtdadeCartoes > 0 then
      begin
    {$IFDEF MSWINDOWS}
        if Assigned(ECFPadrao) then
          Result := tefdiscado.ImprimirCupom(CupomEmitido, FValorPagoDinheiro + FValorPagoCheque+
                                                           FValorPagoMasterCreditoPos + FValorPagoMasterCreditoPos+
                                                           FValorPagoVisaDebitoPos + FValorPagoVisaCreditoPos+
                                                           FValorPagoAmexDebitoPos + FValorPagoAmexCreditoPos+
                                                           FValorPagoHipercardDebitoPos + FValorPagoHipercardCreditoPos
                                                           ,'', '', FQtdadeCartoes);
        if Not Result then begin
          FSaldoRestante   := FSaldoRestante + ValorPagoCartao;
          FValorPagoCartao := 0;
          if FQtdadeCartoes > 1 then
            BackupTEFDiscado.ExecutarBackup;
          FQtdadeCartoes := 0;
        end;
        BackupTEFDiscado.ApagarArquivo
    {$ENDIF}
      end else begin
        if Assigned(ECFPadrao) then
        begin
          for a := 0 to High(FFormasPagto) do
          begin
            ECFPadrao.PagamentoCupom(FFormasPagto[a].FormaPagto, Trocar(FormatFloat('0.,00',RoundTo(FFormasPagto[a].Valor,-2)),'.',''));
            if ECFPadrao.Erro then
            begin
              MensagemErro(ECFPadrao.Mensagem);
              break
            end
          end;
          if Not ECFPadrao.Erro then
          begin
            ECFPadrao.AbrirGaveta;
  //          Mensagem := '';
{            Mensagem := IfThen(qryClientenome.AsString<>'','Cliente: '+ qryClientenome.AsString+ slinebreak +
                        IfThen(qryClientepessoanumero.AsString<>'','CPF:     '+ FormatarCPFouCGC(qryClientepessoanumero.AsString) + slinebreak,''),''); //#13+#10;
}

            if not qryVendedorcodigo.IsNull then
              FMensagemDesconto := FMensagemDesconto + IfThen(FMensagemDesconto<>'',sLineBreak) +
                                   'Vendedor: ' + qryVendedorcodigo.AsString + ' - ' + qryVendedornome.AsString;

            if valortotalimpostoibt <> 0 then
            begin
              vPercTrib := roundto(valortotalimpostoibt / ValorTotalCompra * 100, -2);
              FMensagemDesconto := FMensagemDesconto + IfThen(FMensagemDesconto<>'',sLineBreak) +
                                   ' Val aprox dos Tributos R$ '+FormatarValor(valortotalimpostoibt,2) +
                                      ' ('+FormatarValor(vPercTrib,2)+'%) Fonte: IBPT';
            end;

            ECFPadrao.FinalizarCupom('',//FFormasPagto[FQtdadeFormasPagto-1].FormaPagto,
                                     '',//FloatToStr(TotalPagar),
                                     FMensagemDesconto);

            valortotalimpostoibt := 0;

  {          ECFPadrao.FinalizarCupom(FormaPagamento,
                                     qryDadosFiscais.FieldByName('valortotal').AsString,
                                     DadosFornecedorCliente);
  }
          end;
          Result := Not ECFPadrao.Erro
        end else
          Result := True;
      end;
      if Result then
      begin
        Result := SalvarVenda;
        if Result then
        begin
          FCupomTotalizado   := False;
          FSituacaoCupom := scFechado; //FVendaAberta       := False;

          if numContrato <> '' then
          begin
            if UsuarioLogin.CaixaAberto then
            begin
              OpcoesImprimirContrato;
              if MensagemSelecionaOpcao('Deseja visualizar as parcelas geradas?' {$IFDEF MSWINDOWS}, MB_DEFBUTTON1{$ENDIF})= smbYes then
              begin
                if Assigned(frmAutenticacoesCaixa) then
                  frmAutenticacoesCaixa.SetFocus
                else
                  frmAutenticacoesCaixa := TfrmAutenticacoesCaixa.Create(frmAutenticacoesCaixa);

                frmAutenticacoesCaixa.edfCodigoClienteContratoPrestacoes.Text := numContrato;
                frmAutenticacoesCaixa.edfCodigoClienteContratoPrestacoesFound(True);
                frmAutenticacoesCaixa.edfCodigoClienteContratoPrestacoes.SetFocus;
                frmAutenticacoesCaixa.ShowModal;
                frmAutenticacoesCaixa.free;

              end;
            end;
          end;
        end;
      end
    end
    {$IFDEF MSWINDOWS}
    else if FQtdadeCartoes > 0 then
      if tefdiscado.NaoConfirmaVendaOuImpressao then
      begin
        MensagemAviso(tefdiscado.Mensagem);
        tefdiscado.ApagarArquivoResposta;
        FQtdadeCartoes := 0;
      end;
  finally
    if Assigned(frmMsg) then
      FreeAndNil(frmMsg);
    if Assigned(tefdiscado) then
      FreeAndNil(tefdiscado);
    if Assigned(BackupTEFDiscado) then
      FreeAndNil(BackupTEFDiscado);
    {$ENDIF};
    if Assigned(ECFPadrao) then
      ECFPadrao.AtualizarTotalizadorGeral(NomeArquivoECFs);
  end;
end;

