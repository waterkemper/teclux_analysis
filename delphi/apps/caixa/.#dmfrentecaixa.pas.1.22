procedure TdtmFrenteCaixa.Selecionar(
  TipoProcura: TtecProcuraClientesCrediario);
begin
  case TipoProcura of
    tpCLIENTES : ReFazConsulta(qryCliente,[0],[qryConsultaClientescodigo.AsInteger]);
  end;
end;

procedure TdtmFrenteCaixa.SelecionarCodigoFiscalNatureza(Tabela: Integer;
  Descricao: String);
var
  Q : TTecQuery;
begin
  if Tabela = 1 then
    Q := qryDadosFiscais
  else
    Q := qryProdutosDadosFiscais;

  if qryNaturezasPadrao.Locate('descricao',descricao,[]) then
  begin
    if Tabela = 1 then
      Q.FieldByName('codigonatureza').AsInteger := qryNaturezasPadraonatureza.AsInteger
    else
      Q.FieldByName('natureza').AsInteger := qryNaturezasPadraonatureza.AsInteger;
    Q.FieldByName('codigofiscal').AsInteger := qryNaturezasPadraocodigofiscal.AsInteger;

    if (Q.FieldByName('codigofiscal').AsInteger <> 8000) and
       not (qryDadosFiscaisestado.AsString = EstadoFilialBase) and
       not (qryDadosFiscaisestado.isnull) then
    begin
      if HeUnidadeFederacao(qryDadosFiscaisestado.AsString) then
      begin
        if Q.FieldByName('codigofiscal').AsInteger = ctVENDASUBSTITUIDODENTROESTADO then
          Q.FieldByName('codigofiscal').AsInteger := Q.FieldByName('codigofiscal').AsInteger+999
        else
          Q.FieldByName('codigofiscal').AsInteger := Q.FieldByName('codigofiscal').AsInteger+1000;
      end
      else
        Q.FieldByName('codigofiscal').AsInteger := Q.FieldByName('codigofiscal').AsInteger+2000;
    end;
  end;
end;

function TdtmFrenteCaixa.TotalizarCupom: Boolean;
{var
  Sair: Boolean;
  Tentativas : Integer;
  valorDesc : Currency;}
begin
  if Not FCupomTotalizado then
  begin
{
    if Assigned(ECFPadrao) then
    begin
      Sair := False;
      Tentativas := 3;
      repeat
       valorDesc := (ValorDesconto*-1)+ValorAcrescimo;

        ECFPadrao.TotalizaCupom('$', FloatToStr(valorDesc));
        FCupomTotalizado := Not ECFPadrao.Erro;
        if Tentativas = 0 then
        begin
       if ECFPadrao.Erro and (MensagemConfirmacao(ECFPadrao.Mensagem + slinebreak + ctTEFIMPRIMIRNOVAMENTE) <> smbOK) then
        begin
          Sair := True;
          Tentativas := 0;
        end;
          Tentativas := Tentativas-1;
       end;
        CupomEmitido := Not ECFPadrao.Erro;
      until Sair or (Not ECFPadrao.Erro);
    end else
      FCupomTotalizado := True;
}
    result := not Assigned(ECFPadrao);
    if not Result then
    begin
      ECFPadrao.TotalizaCupom('$', FloatToStr((ValorDesconto*-1)+ValorAcrescimo));
      Result :=  not ECFPadrao.Erro
    end;
    if result then
    begin
      FSituacaoCupom   := scTotalizado;
      FCupomTotalizado := True;
    end;
  end;
  Result := FCupomTotalizado;
end;

