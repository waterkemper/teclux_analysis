{ TdtmFrenteCaixa }

procedure TdtmFrenteCaixa.AbreClientes;
begin
  if Not qryCliente.Active then
    ReFazConsulta(qryCliente, [0], [0]);
end;

procedure TdtmFrenteCaixa.AbreConsultaClientes;
begin
  qryConsultaClientes.Sql[16] := 'where c.codigo = 0';
  qryConsultaClientes.Open
end;

procedure TdtmFrenteCaixa.AbreConsultaProduto(Descricao: String);
begin
  if Descricao <> '' then
    qryConsultaProduto.MacroByName('codigo').AsString := '(p.descricao ilike ''' + Descricao + '%'')'
  else
    qryConsultaProduto.MacroByName('codigo').AsString := '(p.codigo IS NULL )';
  qryConsultaProduto.Open;
  qryConsultaProduto.SortByField('descricao');
end;

procedure TdtmFrenteCaixa.AbreConsultaVendedor;
begin
  qryConsultaVendedores.Open
end;

procedure TdtmFrenteCaixa.addRegistroEntradaPgtoTMP;
begin
  if not (qryPagamentoTMP.Locate('ID',1,[])) then
  begin
    qryPagamentoTMP.Append;
    qryPagamentoTMPid.AsInteger := 1;
    qryPagamentoTMPtipo.AsString := 'Entrada';
    qryPagamentoTMP.Post;
  end;
  qryPagamentoTMP.SortByField('ID');
  Application.ProcessMessages;
end;

procedure TdtmFrenteCaixa.BloquearEstoque;
var
  WhereSQL: String;
begin
  qryProdutosVendidos.DisableControls;
  try
    WhereSQL := '';
    qryProdutosVendidos.First;
    while Not qryProdutosVendidos.Eof do begin
      WhereSQL := WhereSQL +
      '((e.produto = ' + qryProdutosVendidosproduto.AsString + ')and' +
      '(e.filial = '   + qryProdutosVendidosfilial.AsString  + '))or';
      qryProdutosVendidos.Next
    end;
    Delete(WhereSQL, Length(WhereSQL) - 1, 2);
  finally
    qryProdutosVendidos.EnableControls
  end;
  qryEstoque.Sql[19] := WhereSQL;
  qryEstoque.Open;
end;

procedure TdtmFrenteCaixa.CancelarClienteCheque;
begin
  qryChequesIncluidos.Cancel
end;

procedure TdtmFrenteCaixa.CancelarItem;
var
  NenhumMarcado: Boolean;

  function Cancelar: Boolean;
  begin
    Result := True;
    if Assigned(ECFPadrao) then
    begin
      ECFPadrao.CancelarItem(qryProdutosVendidosnumeroitem.AsString);
      if ECFPadrao.Erro then
      begin
        Result := False;
        MensagemErro(ECFPadrao.Mensagem);
      end
    end;
    if Result and Not qryProdutosVendidoscancelado.AsBoolean then
    begin
      NenhumMarcado  := False;
      FValorTotalDescontoItem := FValorTotalDescontoItem - qryProdutosVendidosdesconto.AsFloat;
      FTotalPagar    := FTotalPagar - Truncar((qryProdutosVendidosvalor.AsCurrency * qryProdutosVendidosquantidade.AsCurrency),2);
      FValorAReceber := FTotalPagar - FValorDesconto - ValorTotalDescontoItem + ValorAcrescimo;
      FSaldoRestante := FValorAReceber;
      FSubTotal      := FSubTotal-Truncar(((qryProdutosVendidosvalor.AsCurrency * qryProdutosVendidosquantidade.AsCurrency)-qryProdutosVendidosdesconto.AsCurrency),2);
      FValorTotalQuantidade := FValorTotalQuantidade - qryProdutosVendidosquantidade.AsCurrency;
      qryProdutosVendidos.Edit;
      qryProdutosVendidoscancelado.AsBoolean   := True;
      qryProdutosVendidosselecionado.AsBoolean := False;
      qryProdutosVendidos.Post;
    end;
  end;

  procedure PopulaDataSetTemp;
  var
    i : Integer;
  begin
    qryProdutosVendidos.First;
    if qryTecTempProdutosCancelados.Active then
      qryTecTempProdutosCancelados.Close;
    qryTecTempProdutosCancelados.Open;
    while not qryProdutosVendidos.Eof do
    begin
      if not qryProdutosVendidos.FieldByName('Cancelado').AsBoolean then
      begin
        qryTecTempProdutosCancelados.Append;
        for i := 0 to qryProdutosVendidos.Fields.Count-1 do
        begin
          case qryProdutosVendidos.Fields[i].DataType of
            ftBoolean : qryTecTempProdutosCancelados.Fields[i].AsBoolean := qryProdutosVendidos.fieldbyname(qryTecTempProdutosCancelados.Fields[i].FieldName).AsBoolean;
            ftinteger,
            ftLargeInt,
            ftString  : qryTecTempProdutosCancelados.Fields[i].asString := qryProdutosVendidos.fieldbyname(qryTecTempProdutosCancelados.Fields[i].FieldName).asString;
            ftCurrency: qryTecTempProdutosCancelados.Fields[i].asCurrency := qryProdutosVendidos.fieldbyname(qryTecTempProdutosCancelados.Fields[i].FieldName).asCurrency;
          else
            qryTecTempProdutosCancelados.Fields[i].asvariant := qryProdutosVendidos.fieldbyname(qryTecTempProdutosCancelados.Fields[i].FieldName).asvariant;
          end;

        end;
        qryTecTempProdutosCancelados.FieldByName('Cancelado').AsBoolean := False;
        qryTecTempProdutosCancelados.Post;
      end;
      qryProdutosVendidos.Next;
    end;
  end;
begin
  PopulaDataSetTemp;
  qryTecTempProdutosCancelados.First;
  if not qryTecTempProdutosCancelados.IsEmpty then
  begin
    try
      frmCancelaItemFrenteCaixa := TfrmCancelaItemFrenteCaixa.Create(frmCancelaItemFrenteCaixa);
      frmCancelaItemFrenteCaixa.ShowModal;
    finally
      if frmCancelaItemFrenteCaixa.GravaCancelamrnto then
      begin
        qryTecTempProdutosCancelados.First;
        while not qryTecTempProdutosCancelados.Eof do
        begin
          if qryProdutosVendidos.Locate('numeroitem', qryTecTempProdutosCancelados.FieldByName('numeroitem').AsInteger, []) then
          begin
            if qryTecTempProdutosCancelados.FieldByName('cancelado').AsBoolean then
            begin
              Cancelar;
            end;
          end;
          qryTecTempProdutosCancelados.Next;
        end;
      end;
      frmCancelaItemFrenteCaixa.Free;
    end;
  end
  else
    MensagemAviso('Não há itens que possam ser cancelados.');
end;

function TdtmFrenteCaixa.CancelarVenda: Boolean;
var
  Ind: Integer;

  procedure ExcluirDadoFiscal;
  begin
    if qryDadosFiscais.Active then begin
      Ind := ExcluirCupom;
      if Ind = 0 then begin
        qryDadosFiscais.Edit;
        qryDadosFiscaissituacao.AsString := 'C';
        qryDadosFiscais.Post;
        try
          {verificar o cancelamento da nfe}
          Perpetrar([qryDadosFiscais, qryProdutosdadosFiscais, qryMovimentos, qryEstoque]);
        except
                on E: Exception do ShowMessage(E.Message);
        end;
        Result := True
      end else begin
        MensagemAviso(Format(ctNAOAPAGARNOTAENTRADA, [TotalizadoresEstoque[Ind]]));
        Result := False
      end
    end
  end;

begin
  Result := True;
  if Assigned(ECFPadrao) then
  begin
    if FQtdadeCartoes > 0 then
      BackupTEFDiscado.ExecutarBackup;
    ECFPadrao.CancelarCupom;
    if ECFPadrao.Erro then
    begin
      MensagemErro(ECFPadrao.Mensagem);
      Result := MensagemConfirmacao('Não foi possível cancelar o cupom fiscal. '+slinebreak{#13#10}+'Deseja cancelar a venda mesmo assim') = smbOK;
    end;
  end;
  
  if Result then
  begin
    ExcluirDadoFiscal;
    ReFazConsulta(qryProdutosVendidos, [], []);
    FTotalPagar    := 0;
    FSaldoRestante := 0;
    FValorAReceber := 0;
    FValorDesconto := 0;
    FValorTotalQuantidade := 0;
    FSituacaoCupom := scFechado; //FVendaAberta := False;
  end;
  if Assigned(frmMsg) then
    FreeAndNil(frmMsg);
  if Assigned(tefdiscado) then
    FreeAndNil(tefdiscado);
  if Assigned(BackupTEFDiscado) then
    FreeAndNil(BackupTEFDiscado);
  if Assigned(ECFPadrao) then
    ECFPadrao.AtualizarTotalizadorGeral(NomeArquivoECFs);
end;

function TdtmFrenteCaixa.ChequeCadastrado(Numero: String): Boolean;
begin
  ReFazConsulta(qryCheque,[0],[Numero]);
  Result:= qryCheque.RecordCount > 0;
end;

constructor TdtmFrenteCaixa.Create(AOwner: TComponent);
begin
  inherited;
  qryProduto.Tag                        := 0;
  qryProdutosVendidos.Tag               := 0;
  qryChequesIncluidos.Tag               := 0;
  qryAutenticacao.Tag                   := 0;
  qryFrentedeCaixaAutenticacoes.Tag     := 0;
  if ParSistema.FrenteCaixaComVendedor then
    qryVendedor.Tag := 0;
  qryProduto.ParamByName('filialbase').AsInteger := FilialBase;

  ReFazConsulta(qryLogotipos,[0],[FilialBase]);
  NomeLogotipo:= qrylogotiposnome.AsString;
  qrylogotipos.Close;
  qryProduto.Params[1].AsString  := EstadoFilialBase;
  qryConsultaProduto.ParamByName('arredondamento').AsBoolean := ECFPadrao.Arredonda;
  qryConsultaProduto.ParamByName('estado').AsString          := EstadoFilialBase;
  qryConsultaProduto.ParamByName('filialbase').AsInteger     := FilialBase;
//  lstProdutos                    := TList.Create;
  qryProdutosVendidosquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryTecTempProdutosCanceladosquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;

  FSituacaoCupom := scFechado;

end;

procedure TdtmFrenteCaixa.DesmarcarTodos;
var
  PosAnt: TBookmark;
begin
  PosAnt := qryProdutosVendidos.GetBookmark;
  qryProdutosVendidos.DisableControls;
  try
    qryProdutosVendidos.First;
    while Not qryProdutosVendidos.Eof do begin
      qryProdutosVendidos.Edit;
      qryProdutosVendidosselecionado.AsBoolean := False;
      qryProdutosVendidos.Next
    end;
  finally
    qryProdutosVendidos.GotoBookmark(PosAnt);
    qryProdutosVendidos.FreeBookmark(PosAnt);
    qryProdutosVendidos.EnableControls
  end;
end;

destructor TdtmFrenteCaixa.Destroy;
begin
{$IFDEF MSWINDOWS}
  if Assigned(tefdiscado) then
    FreeAndNil(tefdiscado);
  if Assigned(BackupTEFDiscado) then
    FreeAndNil(BackupTEFDiscado);
{$ENDIF}
  if Assigned(ECFPadrao) and ECFPadrao.CupomAberto then
    ECFPadrao.CancelarCupom;
  inherited;
end;

function TdtmFrenteCaixa.EfetuarDesconto:Boolean;
var
  OK: Boolean;
  botao : TMessageButton;
begin
  Result := False;
  frmLerValor := TfrmLerValor.Create(frmLerValor, 'Desconto');
  try
    botao :=  MensagemSelecionaOpcao('Sim para desconto por percentual.'+#13+ 'Não para desconto por valor.');
    if botao = smbNO then
      FDescontoPorValor := True;
    OK := False;
    if not(botao = smbCancel) then
    begin
      frmLerValor.Numero := 0;
      OK := frmLerValor.ShowModal = mrOK;
    end;
    if OK then
    begin
      FValorDesconto := frmLerValor.Numero;
      if TemComposto then
        FDescontoProdutoComposto:= FValorDesconto + FDescontoProdutoComposto;
      if not (FDescontoPorValor) then
        FValorDesconto := ValorDoPercentualSobreTotal(TotalPagar, FValorDesconto);
      if ValidarDesconto then
      begin
        FValorAReceber := FTotalPagar - FValorDesconto - ValorTotalDescontoItem + ValorAcrescimo;
        FSaldoRestante := FValorAReceber;
        Result := True;
      end
      else
      begin
        FValorDesconto := 0;
      end;
    end;
  finally
    frmLerValor.Free;
  end;
end;

function TdtmFrenteCaixa.EfetuarPagamento(FormaPagto: String; ValorPagto: Currency): Boolean;
var
  ValorPagamento: Currency;
  ValorCheque : Currency;
  FechaVenda: Boolean;
  OK: Boolean;
  ValorTransacao: Currency;
  i : Integer;
  exibirTelaCheque : Boolean;
begin
  FechaVenda := False;
  Result := False;
  ValorPagamento := 0;
  OK := False;
  if ValidarDesconto then
  begin
    if FormaPagto = '1' then
    begin
//      ValorPagamento := FValorPagoDinheiro;
      FValorPagoDinheiro := FValorPagoDinheiro + ValorPagto;
      FSaldoRestante     := FSaldoRestante - ValorPagto;
{      FSubTotal          := FSaldoRestante;
      if FSaldoRestante < 0 then
      begin
        FTroco    := Abs(FSaldoRestante);
        FSubTotal := 0
      end;
}
      if qryPagamentoTMP.Locate('ID', 2, []) then
      begin
        qryPagamentoTMP.Edit
      end
      else
      begin
        qryPagamentoTMP.Append;
        qryPagamentoTMPid.AsInteger := 2;
      end;
      qryPagamentoTMPformapgto.AsString   := 'Dinheiro';
      qryPagamentoTMPvalor.AsCurrency := FValorPagoDinheiro;
      qryPagamentoTMP.Post;
      addRegistroEntradaPgtoTMP;
      Result := IncluirFormaPagto('Dinheiro', ValorPagto) >= 0;
    end
    else
    if FormaPagto = '2' then
    begin
      ok := True;
      if not (ParSistema.NaoInformaDadosChequeFCaixa) or (ParSistema.MensagemInformarDadosChequeFCaixa) then
      begin
        if (ParSistema.NaoInformaDadosChequeFCaixa) and (ParSistema.MensagemInformarDadosChequeFCaixa) then
        begin
          if MensagemConfirmacao('Deseja informar os dados do cheque.') = smbOK then
            exibirTelaCheque := True
          else
          begin
            ValorCheque := ValorPagto;
            exibirTelaCheque := False;
          end;
        end
        else
        begin
          if (ParSistema.NaoInformaDadosChequeFCaixa) then
            exibirTelaCheque := False
          else
            exibirTelaCheque := True;
        end;
        if exibirTelaCheque then
        begin
          frmCadastroChequeFrenteCaixa := TfrmCadastroChequeFrenteCaixa.Create(frmCadastroChequeFrenteCaixa);
          try
            frmCadastroChequeFrenteCaixa.ValorCheque := FloatToStr(ValorPagto);
            i := frmCadastroChequeFrenteCaixa.ShowModal;
            if not (i in [mrCancel, mrAbort]) then
            begin
              ok := True;
              ValorCheque := StrToFloat(frmCadastroChequeFrenteCaixa.ValorCheque);
            end
            else
              ok := False;
         finally
            frmCadastroChequeFrenteCaixa.Free;
          end;
        end;
      end
      else
        ValorCheque := ValorPagto;

      if ok then
      begin
        FValorPagoCheque := FValorPagoCheque + ValorCheque;
        FSaldoRestante   := FSaldoRestante - ValorCheque;
{        FSubTotal        := FSaldoRestante;
        if FSaldoRestante < 0 then
        begin
          FTroco    := Abs(FSaldoRestante);
          FSubTotal := 0
        end;
}
        if qryPagamentoTMP.Locate('ID', 3, []) then
        begin
          qryPagamentoTMP.Edit
        end
        else
        begin
          qryPagamentoTMP.Append;
          qryPagamentoTMPid.AsInteger := 3;
        end;
        qryPagamentoTMPformapgto.AsString := 'Cheque';
        qryPagamentoTMPvalor.AsCurrency   := FValorPagoCheque;
        qryPagamentoTMP.Post;
        addRegistroEntradaPgtoTMP;

        Result := IncluirFormaPagto('CHEQUE', ValorCheque) >= 0;
      end;
    end
    else // TEF
    if FormaPagto = '3' then
    begin
  {$IFDEF MSWINDOWS}
      if (ParSistema.TipoTEF = tsDISCADO) then
      begin
        if ValorPagto <= FSaldoRestante then
        begin
          if not Assigned(tefdiscado) then
          begin
            tefdiscado             := TtecTEFDiscado.Create;
            tefdiscado.FrenteCaixa := True;
            tefdiscado.CupomFiscal := ECFPadrao.Cupom;
            tefdiscado.CCF         := ECFPadrao.NumCCF;
            tefdiscado.ValorTotalCartoes := FSaldoRestante; //ValorPagoCartao;
          end;
          if tefdiscado.GerenciadorAtivo(False) then
          begin
            if not Assigned(BackupTEFDiscado) then
            begin
              BackupTEFDiscado := TtecBackupTEFDiscado.Create;
              BackupTEFDiscado.ExisteArquivo(True);
            end;
            tefdiscado.ValorTransacao := FloatToStr(ValorPagto);
            Result := tefdiscado.ExecutarOperacao(sopCARTAO, FQtdadeCartoes + 1);
            if Result then
            begin
              Inc(FQtdadeCartoes);
  {
              ValorPagamento := SaldoRestante - ValorTransacao;
              if ValorPagamento < 0 then
                ValorPagamento := 0;
              if tefdiscado.ValorTransacao > 0 then
  }
              BackupTEFDiscado.Incluir(tefdiscado.NomeRede,
                                       tefdiscado.NSU,
                                       tefdiscado.DataTransacao,
                                       tefdiscado.HoraTransacao,
                                       ValorPagto,
                                       FQtdadeCartoes);
              if FSaldoRestante > ValorPagto then
                if Assigned(frmMsg) then
                begin
                  Sleep(5000);
                  FreeAndNil(frmMsg)
                end;
            end else if tefdiscado.StatusTransacao <> '0' then
              OK := False
            else
            begin
              if Assigned(frmMsg) then
              begin
                Sleep(5000);
                FreeAndNil(frmMsg)
              end;
              if FQtdadeCartoes > 0 then
              begin
                BackupTEFDiscado.ExecutarBackup;
                BackupTEFDiscado.ApagarArquivo;
              end
            end
          end
          else
            BackupTEFDiscado.ApagarArquivo;
          if Result then
          begin
            FValorPagoCartao := FValorPagoCartao + ValorPagto;
            FSaldoRestante   := FSaldoRestante - ValorPagto;
            if qryPagamentoTMP.Locate('ID', 3, []) then
            begin
              qryPagamentoTMP.Edit
            end
            else
            begin
              qryPagamentoTMP.Append;
              qryPagamentoTMPid.AsInteger := 3;
            end;
            qryPagamentoTMPformapgto.AsString := 'CARTAO';
            qryPagamentoTMPvalor.AsCurrency   := FValorPagoCartao;
            if tefdiscado.TipoTransacao in [10,11,12,13] then
              qryPagamentoTMPtipotransacao.AsString := 'C'
            else if tefdiscado.TipoTransacao in [20,21,22,23,24,25] then
              qryPagamentoTMPtipotransacao.AsString := 'D';
            qryPagamentoTMPadministradora.AsString := tefdiscado.Administradora;
            qryPagamentoTMP.Post;
            IncluirFormaPagto('CARTAO', ValorPagto);
          end
          else
          begin
            if FQtdadeCartoes > 1 then
              BackupTEFDiscado.ExecutarBackup;
            Result := False
          end;
        end
        else
        begin
          Result := False;
          MensagemAviso('O valor informado excede o saldo restante!')
        end;
      end;
  {$ELSE}
      Result := False;
  {$ENDIF}
      FPagandoTEF := Result;
    end
    else
    if FormaPagto = '4' then
    begin
      zeraFormaPagamento;
      SaldoRestante := ValorAReceber;
    end
    else
    if FormaPagto = '5' then
    begin
      FValorPagoMasterDebitoPos := FValorPagoMasterDebitoPos + ValorPagto;
      FSaldoRestante     := FSaldoRestante - ValorPagto;
      if qryPagamentoTMP.Locate('ID', 4, []) then
      begin
        qryPagamentoTMP.Edit
      end
      else
      begin
        qryPagamentoTMP.Append;
        qryPagamentoTMPid.AsInteger := 4;
      end;
      qryPagamentoTMPformapgto.AsString := 'Cartão Master Débito';
      qryPagamentoTMPvalor.AsCurrency   := FValorPagoMasterDebitoPos;
      qryPagamentoTMP.Post;
      addRegistroEntradaPgtoTMP;
      Result := IncluirFormaPagto('CARTAO', ValorPagto) >= 0;
    end
    else
    if FormaPagto = '6' then
    begin
      FValorPagoMasterCreditoPos := FValorPagoMasterCreditoPos + ValorPagto;
      FSaldoRestante     := FSaldoRestante - ValorPagto;
      if qryPagamentoTMP.Locate('ID', 5, []) then
      begin
        qryPagamentoTMP.Edit
      end
      else
      begin
        qryPagamentoTMP.Append;
        qryPagamentoTMPid.AsInteger := 5;
      end;
      qryPagamentoTMPformapgto.AsString := 'Cartão Master Crédito';
      qryPagamentoTMPvalor.AsCurrency   := ValorPagoMasterCreditoPos;
      qryPagamentoTMP.Post;
      addRegistroEntradaPgtoTMP;
      Result := IncluirFormaPagto('CARTAO', ValorPagto) >= 0;
    end
    else
    if FormaPagto = '7' then
    begin
      FValorPagoVisaDebitoPos := FValorPagoVisaDebitoPos + ValorPagto;
      FSaldoRestante     := FSaldoRestante - ValorPagto;
      if qryPagamentoTMP.Locate('ID', 6, []) then
      begin
        qryPagamentoTMP.Edit
      end
      else
      begin
        qryPagamentoTMP.Append;
        qryPagamentoTMPid.AsInteger := 6;
      end;
      qryPagamentoTMPformapgto.AsString := 'Cartão Visa Débito';
      qryPagamentoTMPvalor.AsCurrency   := ValorPagoVisaDebitoPos;
      qryPagamentoTMP.Post;
      addRegistroEntradaPgtoTMP;
      Result := IncluirFormaPagto('CARTAO', ValorPagto) >= 0;
    end
    else
    if FormaPagto = '8' then
    begin
      FValorPagoVisaCreditoPos := FValorPagoVisaCreditoPos + ValorPagto;
      FSaldoRestante     := FSaldoRestante - ValorPagto;
      if qryPagamentoTMP.Locate('ID', 7, []) then
      begin
        qryPagamentoTMP.Edit
      end
      else
      begin
        qryPagamentoTMP.Append;
        qryPagamentoTMPid.AsInteger := 7;
      end;
      qryPagamentoTMPformapgto.AsString := 'Cartão Visa Crédito';
      qryPagamentoTMPvalor.AsCurrency   := ValorPagoVisaCreditoPos;
      qryPagamentoTMP.Post;
      addRegistroEntradaPgtoTMP;
      Result := IncluirFormaPagto('CARTAO', ValorPagto) >= 0;
    end
    else
    if FormaPagto = '9' then
    begin
      FValorPagoAmexDebitoPos := FValorPagoAmexDebitoPos + ValorPagto;
      FSaldoRestante     := FSaldoRestante - ValorPagto;
      if qryPagamentoTMP.Locate('ID', 8, []) then
      begin
        qryPagamentoTMP.Edit
      end
      else
      begin
      qryPagamentoTMP.Append;
      qryPagamentoTMPid.AsInteger := 8;
      end;
      qryPagamentoTMPformapgto.AsString := 'Cartão Amex Débito';
      qryPagamentoTMPvalor.AsCurrency   := ValorPagoAmexDebitoPos;
      qryPagamentoTMP.Post;
      addRegistroEntradaPgtoTMP;
      Result := IncluirFormaPagto('CARTAO', ValorPagto) >= 0;
    end
    else
    if FormaPagto = '10' then
    begin
      FValorPagoAmexCreditoPos := FValorPagoAmexCreditoPos + ValorPagto;
      FSaldoRestante     := FSaldoRestante - ValorPagto;
      if qryPagamentoTMP.Locate('ID', 9, []) then
      begin
        qryPagamentoTMP.Edit
      end
      else
      begin
      qryPagamentoTMP.Append;
      qryPagamentoTMPid.AsInteger := 9;
      end;
      qryPagamentoTMPformapgto.AsString := 'Cartão Amex Crédito';
      qryPagamentoTMPvalor.AsCurrency   := ValorPagoAmexCreditoPos;
      qryPagamentoTMP.Post;
      addRegistroEntradaPgtoTMP;
      Result := IncluirFormaPagto('CARTAO', ValorPagto) >= 0;
    end
    else
    if FormaPagto = '11' then
    begin
      FValorPagoHipercardDebitoPos := FValorPagoHipercardDebitoPos + ValorPagto;
      FSaldoRestante     := FSaldoRestante - ValorPagto;
      if qryPagamentoTMP.Locate('ID', 10, []) then
      begin
        qryPagamentoTMP.Edit
      end
      else
      begin
      qryPagamentoTMP.Append;
      qryPagamentoTMPid.AsInteger := 10;
      end;
      qryPagamentoTMPformapgto.AsString := 'Cartão Hipercard Débito';
      qryPagamentoTMPvalor.AsCurrency   := ValorPagoHipercardDebitoPos;
      qryPagamentoTMP.Post;
      addRegistroEntradaPgtoTMP;
      Result := IncluirFormaPagto('CARTAO', ValorPagto) >= 0;
    end
    else
    if FormaPagto = '12' then
    begin
      FValorPagoHipercardCreditoPos := FValorPagoHipercardCreditoPos + ValorPagto;
      FSaldoRestante     := FSaldoRestante - ValorPagto;
      if qryPagamentoTMP.Locate('ID', 11, []) then
      begin
        qryPagamentoTMP.Edit
      end
      else
      begin
      qryPagamentoTMP.Append;
      qryPagamentoTMPid.AsInteger := 11;
      end;
      qryPagamentoTMPformapgto.AsString := 'Cartão Hipercard Crédito';
      qryPagamentoTMPvalor.AsCurrency   := ValorPagoHipercardCreditoPos;
      qryPagamentoTMP.Post;
      addRegistroEntradaPgtoTMP;
      Result := IncluirFormaPagto('CARTAO', ValorPagto) >= 0;
    end;


  end;
  if FSaldoRestante <= 0 then
  begin
    Result := FinalizaVenda;
  end;

{  if Result then
  begin
    if FormaPagto = '1' then
    begin
      FValorPagoDinheiro := FValorPagoDinheiro + ValorPagamento;
    end
    else
    if FormaPagto = '2' then
    begin
      FValorPagoCheque   := FValorPagoCheque + ValorPagamento;
    end
    else
    if FormaPagto = '3' then
    begin
      FValorPagoCartao   := FValorPagoCartao + ValorPagamento;
    end
    else
    if FormaPagto = '5' then
    begin
      FValorPagoMasterDebitoPos  := FValorPagoMasterDebitoPos + ValorPagamento;
    end
    else
    if FormaPagto = '6' then
    begin
      FValorPagoMasterCreditoPos  := FValorPagoMasterCreditoPos + ValorPagamento;
    end
    else
    if FormaPagto = '7' then
    begin
      FValorPagoVisaDebitoPos  := FValorPagoVisaDebitoPos + ValorPagamento;
    end
    else
    if FormaPagto = '8' then
    begin
      FValorPagoVisaCreditoPos  := FValorPagoVisaCreditoPos + ValorPagamento;
    end;

    if SaldoRestante >= ValorPagamento then
    begin
      FTroco         := 0;
      FSaldoRestante := FSaldoRestante - ValorPagamento
    end
    else
    begin
      FTroco         := SaldoRestante*-1;
      FSaldoRestante := 0
    end;
  end;
}
end;

function TdtmFrenteCaixa.EstornoPagamento: Boolean;
begin
  FSaldoRestante     := FSaldoRestante + FValorPagoDinheiro + FValorPagoCheque;
  FValorPagoDinheiro := 0;
  FValorPagoCheque   := 0;
  FValorPagoMasterDebitoPos:=0;
  FValorPagoMasterCreditoPos:=0;
  FValorPagoVisaDebitoPos:=0;
  FValorPagoVisaCreditoPos:=0;
  FValorPagoAmexDebitoPos:=0;
  FValorPagoAmexCreditoPos:=0;
  FValorPagoHipercardDebitoPos :=0;
  FValorPagoHipercardCreditoPos :=0;
  while not qryChequesIncluidos.IsEmpty do
    qryChequesIncluidos.Delete;
  Result := True
end;

function TdtmFrenteCaixa.ExcluirCupom: Integer;
const
  WhereSQL = '((m.produto = %d) and (m.filial = %d) and (m.numero >= (select max(m1.numero) ' +
             'from movimentos m1 where (m1.numero < %s) and (m1.produto =  %d) and (m1.filial = %d)))) or ';
type
  tMov = record
    numero:              INTEGER;
    produto:             INT64;
    filial:              Integer;
    data:                TDatetime;
    tipomovimento:       String[3];
    operacao:            String[20];
    emestoque:           Currency;
    reservado:           Currency;
    transito:            Currency;
    demonstracao:        Currency;
    conserto:            Currency;
    futuro:              Currency;
    danificada:          Currency;
    estoquefisico:       Currency;
    quantidade:          Currency;
    financeiro:          Real;
    valor:               Real;
    precocomicms:        Real;
    precosemicms:        Real;
    aliquotaIPI:         Real;
    referencia:          String;
    trfproduto:          INT64;
    trffilial:           Integer;
    trfmovimento:        INTEGER;
  end;

  tMovimento = array of record
    Produto: int64;
    Menor,
    Maior: Integer
  end;

var
  SQL: String;
  a, b: Integer;
  Mov: tMov;
  Movimento: tMovimento;

  procedure AtribuirEstoque;
  var
    Prod: String;
  begin
    Prod := IntToStr(Mov.produto);
    qryEstoque.Locate('produto;filial', VarArrayOf([Prod, Mov.filial]), []);
    qryEstoque.Edit;
    qryEstoquefinanceiro.AsFloat      := Mov.financeiro;
    qryEstoqueemestoque.AsCurrency     := Mov.emestoque;
    qryEstoquereservado.AsCurrency     := Mov.reservado;
    qryEstoquetransito.AsCurrency      := Mov.transito;
    qryEstoquedemonstracao.AsCurrency  := Mov.demonstracao;
    qryEstoqueconserto.AsCurrency      := Mov.conserto;
    qryEstoquefuturo.AsCurrency        := Mov.futuro;
    qryEstoquedanificada.AsCurrency    := Mov.danificada;
    qryEstoqueestoquefisico.AsCurrency := Mov.estoquefisico;
    qryEstoque.Post;
  end;

  procedure AtribuirMov;
  begin
    Mov.numero            := qryMovimentosnumero.AsInteger;
    Mov.produto     	  := qryMovimentosproduto.AsLargeInt;
    Mov.filial            := qryMovimentosfilial.AsInteger;
    Mov.tipomovimento     := qryMovimentostipomovimento.AsString;
    Mov.operacao          := qryMovimentosoperacao.AsString;
    Mov.emestoque         := qryMovimentosemestoque.AsCurrency;
    Mov.reservado         := qryMovimentosreservado.AsCurrency;
    Mov.transito          := qryMovimentostransito.AsCurrency;
    Mov.demonstracao      := qryMovimentosdemonstracao.AsCurrency;
    Mov.conserto          := qryMovimentosconserto.AsCurrency;
    Mov.futuro            := qryMovimentosfuturo.AsCurrency;
    Mov.danificada        := qryMovimentosdanificada.AsCurrency;
    Mov.estoquefisico     := qryMovimentosestoquefisico.AsCurrency;
    Mov.quantidade        := qryMovimentosquantidade.AsCurrency;
    Mov.financeiro        := qryMovimentosfinanceiro.AsFloat;
    Mov.valor             := qryMovimentosvalor.AsFloat;
    Mov.precocomicms      := qryMovimentosprecocomicms.AsFloat;
    Mov.precosemicms      := qryMovimentosprecosemicms.AsFloat;
    Mov.aliquotaipi       := qryMovimentosaliquotaipi.AsFloat;
    Mov.referencia        := qryMovimentosreferencia.AsString;
    Mov.trfproduto        := qryMovimentostrfproduto.AsLargeInt;
    Mov.trffilial         := qryMovimentostrffilial.AsInteger;
    Mov.trfmovimento      := qryMovimentostrfmovimento.AsInteger;
  end;

  function RealizarOperacao(Tipo: Integer; Oper: char): Integer;
  var
    Qtdade,
    TotalAnterior,
    TotalEstoque: Currency;
  begin
    Result := 0;
    Qtdade := Abs(qryMovimentosquantidade.AsCurrency);
    qryMovimentos.Edit;
    case Tipo of
      1: case Oper of
           '+': qryMovimentosemestoque.AsCurrency := Mov.emestoque + Qtdade;
           '-': if Mov.emestoque >= Qtdade then
                  qryMovimentosemestoque.AsCurrency := Mov.emestoque - Qtdade
                else
                  Result := 1;
           '=': qryMovimentosemestoque.AsCurrency := Qtdade;
           '*': qryMovimentosemestoque.AsCurrency := Mov.emestoque;
         end;
      2: case Oper of
           '+': qryMovimentosreservado.AsCurrency := Mov.reservado + Qtdade;
           '-': if Mov.reservado >= Qtdade then
                  qryMovimentosreservado.AsCurrency := Mov.reservado - Qtdade
                else
                  Result := 2;
           '=': qryMovimentosreservado.AsCurrency := Qtdade;
           '*': qryMovimentosreservado.AsCurrency := Mov.reservado;
         end;
      3: case Oper of
           '+': qryMovimentostransito.AsCurrency := Mov.transito + Qtdade;
           '-': if Mov.transito >= Qtdade then
                  qryMovimentostransito.AsCurrency := Mov.transito - Qtdade
                else
                  Result := 3;
           '=': qryMovimentostransito.AsCurrency := Qtdade;
           '*': qryMovimentostransito.AsCurrency := Mov.transito;
         end;
      4: case Oper of
           '+': qryMovimentosdemonstracao.AsCurrency := Mov.demonstracao + Qtdade;
           '-': if Mov.demonstracao >= Qtdade then
                  qryMovimentosdemonstracao.AsCurrency := Mov.demonstracao - Qtdade
                else
                  Result := 4;
           '=': qryMovimentosdemonstracao.AsCurrency := Qtdade;
           '*': qryMovimentosdemonstracao.AsCurrency := Mov.demonstracao;
         end;
      5: case Oper of
           '+': qryMovimentosconserto.AsCurrency := Mov.conserto + Qtdade;
           '-': if Mov.conserto >= Qtdade then
                  qryMovimentosconserto.AsCurrency := Mov.conserto - Qtdade
                else
                  Result := 5;
           '=': qryMovimentosconserto.AsCurrency := Qtdade;
           '*': qryMovimentosconserto.AsCurrency := Mov.conserto;
         end;
      6: case Oper of
           '+': qryMovimentosfuturo.AsCurrency := Mov.futuro + Qtdade;
           '-': if Mov.futuro >= Qtdade then
                  qryMovimentosfuturo.AsCurrency := Mov.futuro - Qtdade
                else
                  Result := 6;
           '=': qryMovimentosfuturo.AsCurrency := Qtdade;
           '*': qryMovimentosfuturo.AsCurrency := Mov.futuro;
         end;
      7: case Oper of
           '+': qryMovimentosdanificada.AsCurrency := Mov.danificada + Qtdade;
           '-': if Mov.danificada >= Qtdade then
                  qryMovimentosdanificada.AsCurrency := Mov.danificada - Qtdade
                else
                  Result := 7;
           '=': qryMovimentosdanificada.AsCurrency := Qtdade;
           '*': qryMovimentosdanificada.AsCurrency := Mov.danificada;
         end;
      8: case Oper of
           '+': qryMovimentosestoquefisico.AsCurrency := Mov.estoquefisico + Qtdade;
           '-': if Mov.estoquefisico >= Qtdade then
                  qryMovimentosestoquefisico.AsCurrency := Mov.estoquefisico - Qtdade
                else
                  Result := 8;
           '=': qryMovimentosestoquefisico.AsCurrency := Qtdade;
           '*': qryMovimentosestoquefisico.AsCurrency := Mov.estoquefisico;
         end;
      10: if Oper = '=' then begin
            qryEstoque.Edit;
            qryEstoqueultimaentrada.AsDateTime := qryMovimentosdata.AsDateTime;
            qryEstoque.Post
          end;
      11: if Oper = '=' then begin
            qryEstoque.Edit;
            qryEstoquedatacompra.AsDateTime := qryMovimentosdata.AsDateTime;
            qryEstoqueqtdecompra.AsCurrency  := qryMovimentosquantidade.AsCurrency;
            qryEstoqueprecosemicms.AsFloat  := qryMovimentosprecosemicms.AsFloat;
            qryEstoqueprecocomicms.AsFloat  := qryMovimentosprecocomicms.AsFloat;
            qryEstoquealiquotaipi.AsFloat   := qryMovimentosaliquotaipi.AsFloat;
            qryEstoque.Post
          end;
      12: begin
            case Oper of
              '+': qryMovimentosfinanceiro.AsFloat := Mov.financeiro + Abs(qryMovimentosvalor.AsFloat);
              '-': if Mov.financeiro >= Abs(qryMovimentosvalor.AsFloat) then
                     qryMovimentosfinanceiro.AsFloat := Mov.financeiro - Abs(qryMovimentosvalor.AsFloat)
                   else
                     Result := 8;
              '=': qryMovimentosfinanceiro.AsFloat := Abs(qryMovimentosvalor.AsFloat);
              'C': begin
                     TotalAnterior  := Mov.emestoque + Mov.reservado + Mov.transito +
                                       Mov.demonstracao + Mov.conserto + Mov.danificada;
                     TotalEstoque  := qryMovimentosemestoque.AsCurrency + qryMovimentosreservado.AsCurrency +
                                      qryMovimentostransito.AsCurrency  + qryMovimentosdemonstracao.AsCurrency +
                                      qryMovimentosconserto.AsCurrency  + qryMovimentosdanificada.AsCurrency;
                     if TotalAnterior <> 0 then
                       qryMovimentosfinanceiro.AsFloat := Mov.financeiro / TotalAnterior * TotalEstoque
                     else
                       Mov.Financeiro := 0;
                     qryMovimentosvalor.AsFloat := Abs(qryMovimentosfinanceiro.AsFloat - Mov.financeiro);
                   end;
              '*': begin
                     qryMovimentosvalor.AsFloat := 0;
                     qryMovimentosfinanceiro.AsFloat := Mov.financeiro
                   end
            end;
            if qryMovimentosfinanceiro.AsFloat < Mov.financeiro then begin
              qryMovimentosvalor.AsFloat        := -qryMovimentosvalor.AsFloat;
              qryMovimentosquantidade.AsCurrency := -Qtdade;
            end
          end
    end;
    qryMovimentos.Post;
  end;

begin
  BloquearEstoque;
  SQL := '';
  Movimento := nil;
  a := 0;
  ReFazConsulta(qryProdutosDadosFiscais, [0], [qryDadosFiscaisnumero.AsInteger]);
  SetLength(Movimento, qryProdutosDadosFiscais.RecordCount);
  while Not qryProdutosDadosFiscais.Eof do begin
    Movimento[a].Produto := qryProdutosDadosFiscaisproduto.AsLargeInt;
    Movimento[a].Menor   := qryProdutosDadosFiscaismovimento.AsInteger;
    SQL := SQL + Format(WhereSQL, [qryProdutosDadosFiscaisproduto.AsLargeInt, FilialBase, qryProdutosDadosFiscaismovimento.AsString, qryProdutosDadosFiscaisproduto.AsLargeInt, FilialBase]);
    Inc(a);
    qryProdutosDadosFiscais.Edit;
    qryProdutosDadosFiscaismovimento.Clear;
    qryProdutosDadosFiscais.Next;
  end;
  if SQL <> '' then begin
    Delete(SQL, Length(SQL) - 3, 4);
    qryMovimentos.Sql[28] := SQL;
    qryMovimentos.Open;
  end;
  a      := 0;
  Result := 0;
  while Not qryMovimentos.Eof do begin
    if qryMovimentosproduto.AsLargeInt = Movimento[a].Produto then
      if qryMovimentosnumero.AsInteger < Movimento[a].Menor then begin
        AtribuirMov;
        qryMovimentos.Next
      end else if qryMovimentosnumero.AsInteger = Movimento[a].Menor then begin
        qryMovimentos.Delete;
        if (qryMovimentosnumero.AsInteger < Movimento[a].Menor) or
           (qryMovimentosproduto.AsLargeInt <> Movimento[a].Produto)
        then begin
          qryMovimentos.Next;
          if qryMovimentos.Eof then
            AtribuirEstoque;
        end
      end else begin
        for b := 1 to 20 do begin
          Result := RealizarOperacao(b, qryMovimentosoperacao.AsString[b]);
          if Result > 0 then
            break;
        end;
        if Result = 0 then
          AtribuirMov
        else
          break;
        qryMovimentos.Next;
        if qryMovimentos.Eof or (qryMovimentosproduto.AsLargeInt <> Movimento[a].Produto) then
          AtribuirEstoque;
      end
    else begin
      AtribuirEstoque;
      Inc(a)
    end
  end
end;

function TdtmFrenteCaixa.ExisteCliente(Campo, Codigo: String): Boolean;
begin
  if Campo = 'nomecidade' then
    Campo:= 'c.nome'
  else
    Campo:= 'c.' + Campo;
  qryConsultaClientes.sql[16] := 'where ' + Campo + ' iLIKE ''' + Codigo + '%'' ';
  qryConsultaClientes.Open;
  Result:= not qryConsultaClientes.IsEmpty;
end;

function TdtmFrenteCaixa.ExisteCPFCNPJ: Boolean;
begin
  if (ParSistema.CPF_CNPJObrigatorio or (qryClientepessoanumero.AsString <> '')) then
    if qryCliente.State in [dsEdit, dsInsert] then begin
      qryCPFCNPJExiste.Sql[03]:= 'Where (pessoanumero = ''' + qryClientepessoanumero.AsString + ''')';
      if qryCliente.State in [dsInsert] then
        qryCPFCNPJExiste.Sql[04]:= ''
      else if qryCliente.State in [dsEdit] then
        qryCPFCNPJExiste.Sql[04]:= 'and (codigo <> ' + qryClientecodigo.AsString + ')';
      qryCPFCNPJExiste.Open;
      Result:= not qryCPFCNPJExiste.IsEmpty;
      if Result then begin
        if MensagemConfirmacao(format(ctCLIENTEJACADASTRADO,['cliente',qryCPFCNPJExisteNome.AsString])) = smbOk then
          ReFazConsulta(qryCliente,[0],[qryCPFCNPJExisteCodigo.AsInteger])
        else
          qryClientepessoanumero.Clear;
      end
    end else
      Result := False
  else
    Result := False
end;

function TdtmFrenteCaixa.ExisteProduto(Codigo: String): Boolean;
begin
  ReFazConsulta(qryProduto, [2], [codigo]);
  Result := not qryProduto.IsEmpty;
end;

