     qryTecContrato.FieldByName('conbairro'         ).AsInteger  := qryCliente.FieldByName('conbairro'             ).AsInteger;
   if not qryCliente.FieldByName('concargo'              ).IsNull then
     qryTecContrato.FieldByName('concargo'          ).AsInteger  := qryCliente.FieldByName('concargo'              ).AsInteger;
   if not qryCliente.FieldByName('referencia'            ).IsNull then
     qryTecContrato.FieldByName('referencia'        ).AsString   := qryCliente.FieldByName('referencia'            ).AsString;
   if not qryCliente.FieldByName('reftipo'               ).IsNull then
     qryTecContrato.FieldByName('reftipo'           ).AsString   := qryCliente.FieldByName('reftipo'               ).AsString;

   if not qryCliente.FieldByName('refrua'                ).IsNull then
     qryTecContrato.FieldByName('refrua'            ).AsString   := qryCliente.FieldByName('refrua'                ).AsString;

   if not qryCliente.FieldByName('refnumero'                ).IsNull then
     qryTecContrato.FieldByName('refnumero'            ).AsString   := qryCliente.FieldByName('refnumero'                ).AsString;
   if not qryCliente.FieldByName('refcomplemento'                ).IsNull then
     qryTecContrato.FieldByName('refcomplemento'            ).AsString   := qryCliente.FieldByName('refcomplemento'                ).AsString;

   if not qryCliente.FieldByName('refestado'             ).IsNull then
     qryTecContrato.FieldByName('refestado'         ).AsString   := qryCliente.FieldByName('refestado'             ).AsString;
   if not qryCliente.FieldByName('refcidade'             ).IsNull then
     qryTecContrato.FieldByName('refcidade'         ).AsInteger  := qryCliente.FieldByName('refcidade'             ).AsInteger;
   if not qryCliente.FieldByName('refbairro'             ).IsNull then
     qryTecContrato.FieldByName('refbairro'         ).AsInteger  := qryCliente.FieldByName('refbairro'             ).AsInteger;
   if not qryCliente.FieldByName('refcep'                ).IsNull then
     qryTecContrato.FieldByName('refcep'            ).AsInteger  := qryCliente.FieldByName('refcep'                ).AsInteger;
   if not qryCliente.FieldByName('reffoneddd'            ).IsNull then
     qryTecContrato.FieldByName('reffoneddd'        ).AsInteger  := qryCliente.FieldByName('reffoneddd'            ).AsInteger;
   if not qryCliente.FieldByName('reffonenumero'         ).IsNull then
     qryTecContrato.FieldByName('reffonenumero'     ).AsInteger  := qryCliente.FieldByName('reffonenumero'         ).AsInteger;
   if not qryCliente.FieldByName('observacoes'           ).IsNull then
     qryTecContrato.FieldByName('observacoes'       ).AsString   := qryCliente.FieldByName('observacoes'           ).AsString + FMensagemDesconto;
   if not qryCliente.FieldByName('email'                 ).IsNull then
     qryTecContrato.FieldByName('email'             ).AsString   := qryCliente.FieldByName('email'                 ).AsString;
   if not qryCliente.FieldByName('automovel'             ).IsNull then
     qryTecContrato.FieldByName('automovel'         ).AsBoolean  := qryCliente.FieldByName('automovel'             ).AsBoolean;
   if not qryCliente.FieldByName('cartaocredito'         ).IsNull then
     qryTecContrato.FieldByName('cartaocredito'     ).AsBoolean  := qryCliente.FieldByName('cartaocredito'         ).AsBoolean;
   if not qryCliente.FieldByName('cartaoloja'            ).IsNull then
     qryTecContrato.FieldByName('cartaoloja'        ).AsBoolean  := qryCliente.FieldByName('cartaoloja'            ).AsBoolean;
   if not qryCliente.FieldByName('cheque'                ).IsNull then
     qryTecContrato.FieldByName('cheque'            ).AsBoolean  := qryCliente.FieldByName('cheque'                ).AsBoolean;
   if not qryCliente.FieldByName('chequeespecial'        ).IsNull then
     qryTecContrato.FieldByName('chequeespecial'    ).AsBoolean  := qryCliente.FieldByName('chequeespecial'        ).AsBoolean;
   if not qryCliente.FieldByName('dependentes'           ).IsNull then
     qryTecContrato.FieldByName('dependentes'       ).AsInteger  := qryCliente.FieldByName('dependentes'           ).AsInteger;
   qryTecContrato.Post;

  if qryProdutosContratos.Active then
    qryProdutosContratos.Close;
  qryProdutosContratos.Open;

  qryProdutosVendidos.First;
  while not (qryProdutosVendidos.Eof) do
  begin
    if not qryProdutosVendidos.FieldByName('cancelado').AsBoolean then
    begin
      if not qryProdutosContratos.Locate('produto', qryProdutosVendidosproduto.AsInteger, []) then
      begin
        qryProdutosContratos.Append;
        qryProdutosContratos.FieldByName('quantidade').AsCurrency  := qryProdutosVendidosquantidade.AsCurrency;
        qryProdutosContratos.FieldByName('contrato'           ).AsString   := numContrato;
        qryProdutosContratos.FieldByName('produto'            ).AsString  := qryProdutosVendidosproduto.AsString;
        qryProdutosContratos.FieldByName('filial'             ).AsInteger  := GetFilialBase;
        qryProdutosContratos.FieldByName('numero'             ).AsString   := qryProdutosVendidosnumeroitem.AsString;
        qryProdutosContratos.FieldByName('precovenda'         ).AsCurrency := qryProdutosVendidosvalor.AsCurrency;
        qryProdutosContratos.FieldByName('precotabela'        ).AsCurrency := qryProdutosVendidosvalor.AsCurrency;
        qryProdutosContratos.FieldByName('descricaoprecovenda').AsString   := '';
        qryProdutosContratos.FieldByName('montagem'           ).AsString   := 'N';
        qryProdutosContratos.FieldByName('entrega'            ).AsString   := 'N';
        qryProdutosContratos.FieldByName('produtolista'       ).AsBoolean  := False;
        qryProdutosContratos.FieldByName('promocao'           ).AsBoolean  := False;
        qryProdutosContratos.FieldByName('vendedor'           ).AsInteger  := qryVendedorcodigo.AsInteger;
        qryProdutosContratos.FieldByName('brinde'             ).AsBoolean  :=qryProdutosVendidosbrinde.AsBoolean;
      end
      else
      begin
        qryProdutosContratos.Edit;
        qryProdutosContratos.FieldByName('quantidade').AsCurrency  := qryProdutosVendidosquantidade.AsCurrency+qryProdutosContratos.FieldByName('quantidade').AsCurrency;
      end;
      qryProdutosContratos.Post;
    end;
    qryProdutosVendidos.Next;
  end;

  if qryParcelas.Active then
    qryParcelas.Close;
  qryParcelas.Open;

  DefinirParcelas(FParcelas, FTotalPagar, FValorAcrescimo, FValorDesconto, FPlano, numContrato);

  qryTecContrato.edit;
  qryTecContrato.FieldByName('valorprazo' ).AsCurrency := FValorAPrazo;
  qryTecContrato.FieldByName('agente'     ).AsInteger  := qryPlanosagente.AsInteger;
  qryTecContrato.FieldByName('plano'      ).AsInteger  := FPlano;
  qryTecContrato.FieldByName('taxajuros'  ).AsCurrency := qryPlanostaxamensaljuros.AsFloat;
  qryTecContrato.Post;

  FValorAReceber := 0;
  for iCountP := 0 to Length(FParcelas)-1 do
  begin
    iCountI := FParcelas[iCountP].Parcelas;
    for iCountI := 0 to iCountI-1 do
    begin
      if FParcelas[iCountP].Vencimento <> now then
      begin
        IncluirFormaPagto('A PRAZO', FParcelas[iCountP].Valor);
      end;
      FValorAReceber := FValorAReceber + FParcelas[iCountP].Valor;
    end;
  end;
  if Perpetrar([qryTecContrato, qryProdutosContratos, qryParcelas]) then
  begin
    if (FValorAReceber > FTotalPagar) then
      FValorAcrescimo := (FValorAReceber) - (FTotalPagar - FValorDesconto)
    else
      FValorAcrescimo := 0;
    FinalizaVenda;
  end;
end;

procedure TdtmFrenteCaixa.zeraVariaveis;
begin
  qryDadosFiscais.Close;
  ReFazConsulta(qryProdutosVendidos, [], []);
  ReFazConsulta(qryCliente, [0], [0]);
  ReFazConsulta(qryVendedor, [0], [0]);
  FTotalPagar               :=0;
  FSaldoRestante            :=0;
  FValorAReceber            :=0;
  FValorPagoCartao          :=0;
  FValorPagoDinheiro        :=0;
  FValorPagoCheque          :=0;
  FValorPagoMasterDebitoPos :=0;
  FValorPagoMasterCreditoPos:=0;
  FValorPagoVisaDebitoPos   :=0;
  FValorPagoVisaCreditoPos  :=0;
  FValorPagoAmexDebitoPos   :=0;
  FValorPagoAmexCreditoPos  :=0;
  FValorPagoHipercardDebitoPos :=0;
  FValorPagoHipercardCreditoPos :=0;
  FQtdadeFormasPagto        :=0;
  FQtdadeCartoes            := 0;
  FValorAcrescimo           := 0;
  FValorDesconto            := 0;
  FValorDescontoItem        := 0;
  FValorTotalDescontoItem   := 0;
//  FTroco                    := 0;
  FSubTotal                 := 0;
  FValorAvista              := 0;
  FValorAPrazo              := 0;
  FFormasPagto              := nil;
  numContrato               := '';
  FValorTotalQuantidade     := 0;
  FDescontoProdutoComposto  := 0;
  FTemComposto              := False;
  FMensagemDesconto         := '';
end;

procedure TdtmFrenteCaixa.AdicionarAcrescimo(valor:Currency; TipoAcrescimo:String = 'V');
begin
  if FSituacaoCupom < scTotalizado then
  begin
    if valor = 0 then
    begin
      ValorAcrescimo := 0;
      FValorAReceber := FTotalPagar-ValorDesconto-ValorTotalDescontoItem;
      FSaldoRestante := FValorAReceber;
    end
    else
    begin
      if TipoAcrescimo = 'P' then
        ValorAcrescimo := ValorAcrescimo + ValorDoPercentualSobreTotal(FSubTotal, valor)
      else
        ValorAcrescimo := ValorAcrescimo + valor;

      FValorAReceber := FTotalPagar+ ValorAcrescimo-ValorDesconto-ValorTotalDescontoItem;
      FSaldoRestante := FValorAReceber;
    end;
    if ValorAcrescimo-ValorDesconto = 0 then
    begin
      ValorDesconto := 0;
      ValorAcrescimo := 0;
    end;
    TotalizarCupom;
  end;
end;

procedure TdtmFrenteCaixa.AdicionarDesconto(valor:Currency; TipoDesconto:String = 'V');
begin
  if FSituacaoCupom < scTotalizado then
  begin
    if valor = 0 then
    begin
      ValorDesconto  := 0;
      FValorAReceber := FTotalPagar+ValorAcrescimo-ValorTotalDescontoItem;
      FSaldoRestante := FValorAReceber;
    end
    else
    begin
      if TipoDesconto = 'P' then
      begin
        ValorDesconto := ValorDesconto + ValorDoPercentualSobreTotal(FSubTotal, valor);
  //      FMensagemDesconto:= 'Você obteve um desconto de '+#13+#10+'R$ '+ FormatarValor((FDescontoProdutoComposto+ValorDoPercentualSobreTotal(FSubTotal, valor)),2) + ' nesta compra.';
      end
      else
      begin
        ValorDesconto := ValorDesconto + valor;
  //      FMensagemDesconto:= 'Você obteve um desconto de '+#13+#10+'R$ '+ FormatarValor((FDescontoProdutoComposto+Valor),2) + ' nesta compra.';
      end;
      FValorAReceber := FTotalPagar-ValorDesconto+ValorAcrescimo-ValorTotalDescontoItem;
      FSaldoRestante := FValorAReceber;
    end;

    if ValorDesconto-ValorAcrescimo = 0 then
    begin
      ValorDesconto := 0;
      ValorAcrescimo := 0;
    end;
    TotalizarCupom
  end;
end;

procedure TdtmFrenteCaixa.DefinirParcelas(Parcelas: TResumosParcelas;
  var ValorPrazo, TaxaJuros, Desconto: Currency; var Plano: Integer;Contrato:String);
const
  Numero        = 1;
  Vencimento    = 2;
  Valor         = 3;
var
  A,B : Integer;
  ParcelasAuxiliar: array [1..3] of TStringList;
  Data: TDateTime;
  numParcela : Integer;
begin
  if Plano > 0 then
  begin
    ReFazConsulta(qryPlanos,[0],[Plano]);
    TaxaJuros := qryPlanostaxamensaljuros.AsFloat;
    ParcelasAuxiliar[Vencimento] := TStringList.Create;
    ParcelasAuxiliar[Valor]      := TStringList.Create;
    for A := 0 to Length(Parcelas) - 1 do
    begin
      B := 0;
      Data := Parcelas[A].Vencimento;
      while B < Parcelas[A].Parcelas do
      begin
        ParcelasAuxiliar[Vencimento].Append(DateTimeToStr(Data));
        ParcelasAuxiliar[Valor].Append(FloatToStr(Parcelas[A].Valor));
        if qryPlanosmestrintadias.AsBoolean then
          Data:= SomarDia(Data,qryPlanosintervaloparcelas.AsInteger,'S')
        else Data:= SomarDia(Data,qryPlanosintervaloparcelas.AsInteger,'N');
        Inc(B);
      end;
    end;

    numParcela := 0;
    for A := 0 to ParcelasAuxiliar[Vencimento].Count - 1 do
    begin
      numParcela := numParcela + 1;
      qryParcelas.Append;
      FValorAPrazo := StrToFloat(ParcelasAuxiliar[Valor].Strings[a]) + FValorAPrazo;
      qryParcelas.FieldByName('contrato'           ).AsString   := Contrato;
      qryParcelas.FieldByName('numero'             ).AsInteger  := numParcela;
      qryParcelas.FieldByName('datavencto'         ).AsString   := ParcelasAuxiliar[Vencimento].Strings[a];
      qryParcelas.FieldByName('valorvencto'        ).AsString   := ParcelasAuxiliar[Valor].Strings[a];
      qryParcelas.FieldByName('formapagamento'     ).AsString   := 'D';
      qryParcelas.FieldByName('parcelaorigem'      ).AsString   := IntToStr(numParcela)+'/'+IntToStr(ParcelasAuxiliar[Vencimento].Count);
      qryParcelas.FieldByName('parcelaadicional'   ).AsBoolean  := False;
      qryParcelas.FieldByName('pagamentoextracaixa').AsBoolean  := False;
      qryParcelas.Post;
    end;
  end;
end;

procedure TdtmFrenteCaixa.ResumoParcelas(var Parcelas: TResumosParcelas);
var
  Pos: TBookmark;
  a: Integer;
begin
  if not qryParcelas.IsEmpty then begin
    SetLength(Parcelas, qryParcelas.RecordCount);
    qryParcelas.DisableControls;
    Pos := qryParcelas.GetBookmark;
    try
      a := 0;
      qryParcelas.First;
      while Not qryParcelas.Eof do begin
        Parcelas[a].Parcelas   := 1;
        Parcelas[a].Vencimento := qryParcelasdatavencto.AsDateTime;
        Parcelas[a].Valor      := qryParcelasvalorvencto.AsCurrency;
        qryParcelas.Next;
        Inc(a)
      end
    finally
      qryParcelas.GotoBookmark(Pos);
      qryParcelas.FreeBookmark(Pos);
      qryParcelas.EnableControls;
    end;
  end;
end;

procedure TdtmFrenteCaixa.OpcoesImprimirContrato;
begin
 frmConfirmarImpressaoNoContrato := TfrmConfirmarImpressaoNoContrato.Create(frmConfirmarImpressaoNoContrato, True, True, True, True, False, 1);
 try
    if frmConfirmarImpressaoNoContrato.ShowModal = mrOK then begin
      if frmConfirmarImpressaoNoContrato.Contrato then
        ImprimirContrato;
     if frmConfirmarImpressaoNoContrato.Carne then
        ImprimirCarne(False)
     else if frmConfirmarImpressaoNoContrato.CarneAbertas then
        ImprimirCarne(True);
     if frmConfirmarImpressaoNoContrato.Boleto then
        ImprimirBoleto(frmConfirmarImpressaoNoContrato.Sequencia);
    end
  finally
    frmConfirmarImpressaoNoContrato.Free;
  end;
end;

procedure TdtmFrenteCaixa.ImprimirContrato;
var
  dtmimprimecontratos: TdtmImprimeContratos;
begin
  dtmimprimecontratos := TdtmImprimeContratos.Create(Self);
  try
    dtmimprimecontratos.ImprimirContratos(NumContrato);
  finally
    dtmimprimecontratos.Free;
  end;
end;

procedure TdtmFrenteCaixa.ImprimirBoleto(NumeroParcelas: vString);
var
  dtmImprimeBoleto: TdtmImprimeBoleto;
begin
  dtmImprimeBoleto := TdtmImprimeBoleto.Create(Self);
  try
    dtmImprimeBoleto.ImprimirBoletoContrato(NumContrato, NumeroParcelas);
  finally
    dtmImprimeBoleto.Free;
  end;
end;

procedure TdtmFrenteCaixa.ImprimirCarne(SomenteAbertas: Boolean);
var
  dtmImprimeCarne: TdtmImprimeCarne;
begin
  dtmImprimeCarne := TdtmImprimeCarne.Create(Self);
  try
    dtmImprimeCarne.ImprimirCarnesContrato(NumContrato, SomenteAbertas);
  finally
    dtmImprimeCarne.Free
  end;
end;

function TdtmFrenteCaixa.ExistePesquisaProduto(campo,
  codigo: String): Boolean;
const
  SQL = '(p.%s ilike ''%s%s'')';
begin
  if qryConsultaProduto.Active then
   qryConsultaProduto.Close;

  qryConsultaProduto.MacroByName('codigo').AsString := Format(SQL, [Campo, Codigo, '%']);
  qryConsultaProduto.Open;
  Result := qryConsultaProduto.RecordCount > 0
end;

procedure TdtmFrenteCaixa.marcaItemCancelado;
begin
  qryTecTempProdutosCancelados.Edit;
  if qryTecTempProdutosCancelados.FieldByName('cancelado').AsBoolean then
    qryTecTempProdutosCancelados.FieldByName('cancelado').AsBoolean := False
  else
    qryTecTempProdutosCancelados.FieldByName('cancelado').AsBoolean := True;
  qryTecTempProdutosCancelados.Post;
end;

function TdtmFrenteCaixa.consultaClienteCPF(CPF:String): Boolean;
begin
  qryConsultaClientes.Sql[16] := 'where c.pessoanumero = '+QuotedStr(CPF)+' ';
  qryConsultaClientes.Open;
  if qryConsultaClientes.IsEmpty then
  begin
    MensagemAviso('Cliente não localizado.');
    ReFazConsulta(qryConsultaClientes, [], []);
    Result := False;
  end
  else
  begin
    SelecionarCliente;
    Result := True;
  end;
end;

function TdtmFrenteCaixa.consultaClienteCodigo(codigo: Integer): Boolean;
begin
  qryConsultaClientes.Sql[16] := 'where c.codigo = '+QuotedStr(IntToStr(codigo))+' ';
  qryConsultaClientes.Open;
  if qryConsultaClientes.IsEmpty then
  begin
    MensagemAviso('Cliente não localizado.');
    ReFazConsulta(qryConsultaClientes, [], []);
    Result := False;
  end
  else
  begin
    SelecionarCliente;
    Result := True;
  end;
end;

function TdtmFrenteCaixa.consultaVendedorCodigo(codigo:Integer): Boolean;
begin
  AbreConsultaVendedor;
  if not ExisteVendedor('codigo', codigo) then
  begin
    MensagemAviso('Vendedor não localizado.');
    Result := False;
  end
  else
  begin
    SelecionarVendedor(False, codigo);
    Result := True;
  end;
end;

procedure TdtmFrenteCaixa.consultaVendedorNome(nome: String);
begin
  if Descricao <> '' then
    qryConsultaVendedores.Sql[6] := 'and (nome ilike ''' + Descricao + '%'')'
  else
    qryConsultaVendedores.Sql[6] := 'and (codigo IS NULL )';
  AbreConsultaVendedor;
end;

procedure TdtmFrenteCaixa.zeraFormaPagamento;
var
  iCount : Integer;
begin
  ValorPagoCartao   := 0;
  ValorPagoDinheiro := 0;
  ValorPagoCheque   := 0;
  ValorPagoMasterDebitoPos  :=0;
  ValorPagoMasterCreditoPos :=0;
  ValorPagoVisaDebitoPos    :=0;
  ValorPagoVisaCreditoPos   :=0;
  ValorPagoAmexDebitoPos    :=0;
  ValorPagoAmexCreditoPos   :=0;
  ValorPagoHipercardDebitoPos:=0;
  ValorPagoHipercardCreditoPos:=0;
  ValorDesconto     := 0;
  ValorAcrescimo    := 0;
  SaldoRestante     := TotalPagar-ValorTotalDescontoItem;

  for iCount := 0 to Length(FFormasPagto)-1 do
  begin
    FFormasPagto[iCount].FormaPagto := '';
    FFormasPagto[iCount].Valor      := 0;
  end;
  qryPagamentoTMP.First;
  while not qryPagamentoTMP.Eof do
    qryPagamentoTMP.Delete;
end;

function TdtmFrenteCaixa.getValorJaInformado: Currency;
begin
  Result := SaldoRestante+ValorDesconto-ValorAcrescimo;
end;

function TdtmFrenteCaixa.getValorTotalCompra: Currency;
begin
  Result := TotalPagar-ValorTotalDescontoItem-ValorDesconto+ValorAcrescimo;
end;

function TdtmFrenteCaixa.getProximoNumeroAutenticacao: integer;
begin
  spcAutenticacaoProximo.Open;
  result := spcAutenticacaoProximonumero.AsInteger;
  spcAutenticacaoProximo.Close;
end;

procedure TdtmFrenteCaixa.SalvarFrentedeCaixaAutenticacoes(
  autenticacao: integer);

  procedure NovoValorFrentedeCaixaAutenticacoes(autenticacao:integer;tipo:string;valor:currency);
  begin
    qryFrentedeCaixaAutenticacoes.Append;
    qryFrentedeCaixaAutenticacoesautenticacao.AsInteger:=autenticacao;
    qryFrentedeCaixaAutenticacoesvalor.AsCurrency:=valor;
    qryFrentedeCaixaAutenticacoestipo.AsString:=tipo;
    qryFrentedeCaixaAutenticacoes.Post;
  end;

begin
  if FValorPagoDinheiro-Abs(FSaldoRestante) > 0 then
    NovoValorFrentedeCaixaAutenticacoes(autenticacao,'DN',FValorPagoDinheiro-abs(FSaldoRestante));

  if FValorPagoCheque > 0 then
  begin
    NovoValorFrentedeCaixaAutenticacoes(autenticacao,'CH',FValorPagoCheque);
    if Abs(FSaldoRestante) >= FValorPagoDinheiro then
      NovoValorFrentedeCaixaAutenticacoes(autenticacao,'DN',FSaldoRestante-FValorPagoDinheiro)
  end;

  if FValorPagoMasterDebitoPos>0 then
    NovoValorFrentedeCaixaAutenticacoes(autenticacao,'MD',FValorPagoMasterDebitoPos);

  if FValorPagoMasterCreditoPos>0 then
    NovoValorFrentedeCaixaAutenticacoes(autenticacao,'MC',FValorPagoMasterCreditoPos);

  if FValorPagoVisaDebitoPos>0 then
    NovoValorFrentedeCaixaAutenticacoes(autenticacao,'VD',FValorPagoVisaDebitoPos);

  if FValorPagoVisaCreditoPos>0 then
    NovoValorFrentedeCaixaAutenticacoes(autenticacao,'VC',FValorPagoVisaCreditoPos);

  if FValorPagoAmexDebitoPos>0 then
    NovoValorFrentedeCaixaAutenticacoes(autenticacao,'AD',FValorPagoAmexDebitoPos);

  if FValorPagoAmexCreditoPos>0 then
    NovoValorFrentedeCaixaAutenticacoes(autenticacao,'AC',FValorPagoAmexCreditoPos);

  if FValorPagoHipercardDebitoPos>0 then
    NovoValorFrentedeCaixaAutenticacoes(autenticacao,'HD',FValorPagoHipercardDebitoPos);

  if FValorPagoHipercardCreditoPos>0 then
    NovoValorFrentedeCaixaAutenticacoes(autenticacao,'HC',FValorPagoHipercardCreditoPos);

end;

