begin
  result := Assigned(ECFPadrao) and (ParSistema.NotaFiscalVinculada = tnfOBRIGATORIA);
end;

procedure TdtmFrenteCaixa.AtribuirDadosCliente;
begin
  if qryClientecodigo.IsNull then
  begin
    qryDadosFiscaistipocliente.clear;
    qryDadosFiscaisnome.clear;
    qryDadosFiscaispessoanumero.clear;
    qryDadosFiscaisfonenumero.clear;
    qryDadosFiscaisfoneddd.clear;
    qryDadosFiscaisdocumento.clear;
    qryDadosFiscaisemail.clear;

    qryDadosFiscaisrua.Clear;
    qryDadosFiscaisendnumero.Clear;
    qryDadosFiscaisendcomplemento.Clear;
    qryDadosFiscaisbairro.Clear;
    qryDadosFiscaisnomebairro.Clear;
    qryDadosFiscaiscidade.Clear;
    qryDadosFiscaiscidadeibge.clear;
    qryDadosFiscaisnomecidade.Clear;
    qryDadosFiscaisestado.Clear;
    qryDadosFiscaiscep.Clear;
    qryDadosFiscaispessoatipo.Clear;
    qryDadosFiscaispessoanumero.clear;

    qryDadosFiscaislocalentrega_rua.Clear;
    qryDadosFiscaislocalentrega_numero.Clear;
    qryDadosFiscaislocalentrega_complemento.Clear;
    qryDadosFiscaislocalentrega_bairro.Clear;
    qryDadosFiscaislocalentrega_nomebairro.Clear;
    qryDadosFiscaislocalentrega_cidade.Clear;
    qryDadosFiscaislocalentrega_cidadeibge.clear;
    qryDadosFiscaislocalentrega_nomecidade.Clear;
    qryDadosFiscaislocalentrega_estado.Clear;
    qryDadosFiscaislocalentrega_cep.Clear;
    qryDadosFiscaislocalentrega_cnpj.clear;

  end
  else
  begin

    qrydadosfiscaisnosimples.asboolean   := qryClientenosimples.asboolean;
    qryDadosFiscaistipocliente.AsString  := 'C';
    qryDadosFiscaisnome.AsString         := qryClientenome.AsString;
    qryDadosFiscaispessoatipo.AsString   := qryClientepessoatipo.AsString;
    qryDadosFiscaispessoanumero.AsString := qryClientepessoanumero.AsString;
    qryDadosFiscaisfonenumero.AsVariant  := qryClientefonenumero.AsVariant;
    qryDadosFiscaisfoneddd.AsVariant     := qryClientefoneddd.AsVariant;
    qryDadosFiscaisdocumento.AsString    := qryClienteiddocumento.AsString;
    qryDadosFiscaisemail.AsString        := qryClienteemail.AsString;
    qryDadosFiscaissuframa.AsString      := qryClientesuframa.AsString;

    qryDadosFiscaisobscliente.AsString  := qryClienteobsnotafiscal.AsString;
    qryDadosFiscaisobsclienteipisuspenso.AsString:= qryClienteobsipisuspenso.AsString;

    if qryDadosFiscaisdebitar.isNull then
      if not qryClientedebito.IsNull then
        qryDadosFiscaisdebitar.AsVariant   := qryClientedebito.AsVariant;

    qryDadosFiscaislocalentrega_rua.AsString         := qryClienterefrua.AsString;
    qryDadosFiscaislocalentrega_numero.AsString      := qryClienterefnumero.AsString;
    qryDadosFiscaislocalentrega_complemento.AsString := qryClienterefcomplemento.AsString;
    qryDadosFiscaislocalentrega_bairro.AsString      := qryClienterefbairro.AsString;
    qryDadosFiscaislocalentrega_nomebairro.AsString  := qryClienterefnomebairro.AsString;
    qryDadosFiscaislocalentrega_cidade.AsString      := qryClienterefcidade.AsString;
    qryDadosFiscaislocalentrega_nomecidade.AsString  := qryClienterefnomecidade.AsString;
    qryDadosFiscaislocalentrega_estado.AsString      := qryClienterefestado.AsString;
    qryDadosFiscaislocalentrega_cep.AsString         := qryClienterefcep.AsString;
    qryDadosFiscaislocalretirada_cnpj.AsString       := qryClientepessoanumero.AsString;


    if qryClienteestado.AsString='.' then {estrangeiro}
    begin
      qryDadosFiscaispais.AsInteger                    := qryClientecidadeibge.AsInteger;
      qryDadosFiscaisnomepais.AsString                 := qryClientenomecidade.AsString;
      qryDadosFiscaisrua.AsString                      := qryClienterua.AsString;
      qryDadosFiscaisendnumero.AsString                := qryClientenumero.AsString;
      qryDadosFiscaisendcomplemento.AsString           := qryClientecomplemento.AsString;
      qryDadosFiscaisbairro.AsString                   := qryClientebairro.AsString;
      //qryDadosFiscaisnomebairro.AsString               := ConsultaOSP.qryClientenomebairro.AsString;
      qryDadosFiscaiscidade.AsString                   := qryClientecidade.AsString;
      qryDadosFiscaisnomecidade.AsString               := qryClientenomebairro.AsString;
      //qryDadosFiscaiscidadeibge.AsString             := ConsultaOSP.qryClientecidadeibge.AsString;
      qryDadosFiscaisestado.AsString                   := qryClienteestado.AsString;
      //qryDadosFiscaiscep.AsInteger                     := ConsultaOSP.qryClientecep.AsInteger;
    end
    else
    begin
      qryDadosFiscaispais.AsInteger                    := 1058;
      qryDadosFiscaisnomepais.AsString                 := 'Brasil';
      qryDadosFiscaisrua.AsString                      := qryClienterua.AsString;
      qryDadosFiscaisendnumero.AsString                := qryClientenumero.AsString;
      qryDadosFiscaisendcomplemento.AsString           := qryClientecomplemento.AsString;
      qryDadosFiscaisbairro.AsString                   := qryClientebairro.AsString;
      qryDadosFiscaisnomebairro.AsString               := qryClientenomebairro.AsString;
      qryDadosFiscaiscidade.AsString                   := qryClientecidade.AsString;
      qryDadosFiscaisnomecidade.AsString               := qryClientenomecidade.AsString;
      qryDadosFiscaiscidadeibge.AsString               := qryClientecidadeibge.AsString;
      qryDadosFiscaisestado.AsString                   := qryClienteestado.AsString;
      qryDadosFiscaiscep.AsString                      := qryClientecep.AsString;
    end;

  end
end;

function TdtmFrenteCaixa.GetCondicaoEmissorNFE: Boolean;
begin
  if qryDadosFiscais.recordcount <> 0 then
    fCondicaoEmissorNFE := parsistema.EmissorNfe and
                           ((qryDadosFiscaismodelodocto.AsString = '55') or
                            (qryDadosFiscaismodelodocto.AsString = '57'))
  else
    fCondicaoEmissorNFE := parsistema.EmissorNfe and
                           ((ModeloDoctoFiscal = '55') or
                            (ModeloDoctoFiscal = '57'));

  Result := fCondicaoEmissorNFE;
end;

end.
