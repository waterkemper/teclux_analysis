function TdtmFrenteCaixa.IniciarVenda: Boolean;
var
  Cupom: String;
  Sair: Boolean;
begin
  result := true;

  if ParSistema.FrenteCaixaComCliente then
  begin
    if  (dtmFrenteCaixa.ClienteVenda = 0) then
    begin
      if not parsistema.ObrigaClienteFrenteCaixa then
      begin
        if (MensagemConfirmacao('Deseja informar o cliente ?') = smbOK) then
          ConsultarClientes;
      end
      else
        result := ConsultarClientes;
    end;
  end;

  if result then
  begin

    Result := not TransferenciaNaoConfirmada;
    if result then
    begin
      if Assigned(ECFPadrao) then
      begin
        if not ECFPadrao.ImpressoraBloqueada then
        begin
          if Not ECFPadrao.CupomAberto then
          begin
            if ECFPadrao.AtivarECF(NomeArquivoECFs, PortaECF, CodigoECF) and
               ECFPadrao.VerificarGT(NomeArquivoECFs) then
            begin

              if Assigned(frmMsg) then
                FreeAndNil(frmMsg);
                {
              if Assigned(tefdiscado) then
                FreeAndNil(tefdiscado);
                }
                {
              if Assigned(BackupTEFDiscado) then
                FreeAndNil(BackupTEFDiscado);
                }

              vJaPossuiPagamentCartaoAprovado := false;
  //            vTEFJaIniciado := false;

              qryRecebimentosTemp.ReadOnly := False;
              qryRecebimentosTemp.Close;
              qryRecebimentosTemp.Open;
              qryRecebimentosTemp.AfterDelete := nil;
              qryRecebimentosTemp.Delete;
              qryRecebimentosTemp.AfterDelete := qryRecebimentosTempAfterPost;




              ECFPadrao.IniciarCupom(trim(qryClientepessoanumero.AsString),
                                     trim(qryClientenome.AsString),
                                     qryClienterua.AsString + ' ' + qryClientenumero.AsString + ' ' + qryClientecomplemento.AsString +
                                     ' Bairro: ' + qryClientenomebairro.AsString +
                                     ' Cep: ' + qryClientecep.AsString + ' - ' + qryClientenomecidade.AsString + ' - ' +
                                      qryClienteestado.AsString);



            end
            else
              Result := False;
          end;
        end
        else
        begin
          Result := False;
          MensagemErro(ctECFBLOQUEADA);
        end;
        if Assigned(ECFPadrao) and ECFPadrao.Erro then
        begin
          MensagemErro(ECFPadrao.Mensagem);
          Result := False
        end
      end
      else
        Result := False; { if Not VendaAberta then
        FSituacaoCupom := scAberto; //FVendaAberta := True;}
    end
    else
      MensagemAviso(ctCAIXATRANSFERENCIANAOCONFIRMADA);
    if Result then
    begin
      FSituacaoCupom := scAberto;
      FCupomTotalizado := False;
      FPagandoTEF := False;

      if Assigned(ECFPadrao) and Not ECFPadrao.Erro then
      begin
        Sair := False;
        repeat
          try
            Cupom       := ECFPadrao.Cupom;
            NumeroCupom := StrToInt(Cupom);
            Sair        := True;
            Result      := True
          except
            Result := False
          end
        until Sair;
        if ECFPadrao.Erro then
          MensagemErro(ECFPadrao.Mensagem);
      end
    end
  end;  
end;

