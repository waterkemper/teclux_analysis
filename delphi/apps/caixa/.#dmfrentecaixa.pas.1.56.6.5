function TdtmFrenteCaixa.NotasFiscaisCupom: Boolean;
var
  SituacaoProduto : TtecComposicao;
//  TipoNota: TtecTipoNota;
  Pos: TBookmark;
  Cont, SerieNroInicial: Integer;
  TotalProd, vTotalVendido : Real;
begin
  Result              := False;
  if qryProdutosDadosFiscais.State = dsInactive then begin
    qryProdutosDadosFiscais.Params[0].Clear;
    qryProdutosDadosFiscais.Open;
  end;
  if qryMovimentos.State = dsInactive then
    qryMovimentos.Open;
  if qryDadosFiscais.State = dsInactive then
    qryDadosFiscais.open;

    if VerificarSerieFilial then
    begin
      SerieNroInicial := qrySeriesFiliaisnumeroinicial.AsInteger;
      BloquearEstoque;
      Pos := qryProdutosVendidos.GetBookmark;
      qryProdutosVendidos.DisableControls;
      try
//        for TipoNota := tnNORMAL to tnSUBSTITUIDO do begin
          Cont          := 0;
          TotalProd     := 0;
          {TotalProdInc  := 0; gedovar 29/12/2014}

          TemNORMAL       := False;
          TemSUBSTITUIDO  := False;
          TemSUBSTITUICAO := False;

          RefazConsulta(qryNaturezasPadrao,[],[]);

          for SituacaoProduto := stNAOCOMPOSTO to stCOMPOSTO do
          begin
            qryProdutosVendidos.First;
            while not qryProdutosVendidos.Eof do
            begin
              if FiltrarComposto(qryProdutosVendidoscomposto.AsBoolean, SituacaoProduto)  then
              begin
                if not qryProdutosVendidos.FieldByName('Cancelado').AsBoolean then
                begin
                  qryEstoque.Locate('produto;filial', VarArrayOf(
                                    [qryProdutosVendidosproduto.AsString,
                                     qryProdutosVendidosfilial.AsInteger]) ,[]);

                  vTotalVendido := SomarValores(qryProdutosVendidos, [qryProdutosVendidosquantidade],
                                  [qryProdutosVendidosproduto, qryProdutosVendidoscancelado, qryProdutosVendidosestoqueverificado],
                                  [qryProdutosVendidosproduto.AsString, 'False', 'False'], ['=','False','False']);

                  AtribuirDados(qryProdutosVendidos, [qryProdutosVendidosestoqueverificado], [True],
                  [qryProdutosVendidosproduto, qryProdutosVendidoscancelado, qryProdutosVendidosestoqueverificado],
                                  [qryProdutosVendidosproduto.AsString, 'False', 'False'], ['=','False','False']);

                  if vTotalVendido > qryEstoqueemestoque.asfloat then
                  begin
                    NovoMovimento(qryProdutosVendidosproduto.AsLargeInt, qryProdutosVendidosfilial.AsInteger);
                    qryMovimentosquantidade.AsCurrency := vTotalVendido - qryEstoqueemestoque.asfloat;
                    qryMovimentosvalor.AsCurrency := qryMovimentosquantidade.AsCurrency * qryEstoqueultimocustomedio.AsCurrency;
                    qryMovimentostipomovimento.AsString := 'FC+';
                    if Assigned(ECFPadrao) then
                      qryMovimentosreferencia.AsString :='FCxa ECF ' + ECFPadrao.Cupom + ifThen(numContrato<>'',' CT '+numContrato,'')
                    else
                      qryMovimentosreferencia.AsString :='FCxa NF ' + SerieSugestao + '-' +
                                                          IntToStr(SerieNroInicial)+ifThen(numContrato<>'',' CT '+numContrato,'');
                    qryMovimentos.Post;
                  end;

                  NovoMovimento(qryProdutosVendidosproduto.AsLargeInt, qryProdutosVendidosfilial.AsInteger);
                  qryMovimentosquantidade.AsCurrency := qryProdutosVendidosquantidade.AsCurrency;//Qtdade;
                  qryMovimentostipomovimento.AsString := 'SEF';
                  if Assigned(ECFPadrao) then
                    qryMovimentosreferencia.AsString :='FCxa ECF ' + ECFPadrao.Cupom + ifThen(numContrato<>'',' CT '+numContrato,'')
                  else
                    qryMovimentosreferencia.AsString :='FCxa NF ' + SerieSugestao + '-' +
                                                        IntToStr(SerieNroInicial)+ifThen(numContrato<>'',' CT '+numContrato,'');
                  qryMovimentos.Post;

                  IncluirProdutosDadosFiscais(Cont + 1, NotaFiscalVinculada);
                  {TotalProdInc := TotalProdInc + Truncar(qryProdutosVendidosquantidade.AsCurrency*qryProdutosDadosFiscaisprecovenda.AsFloat,2); gedovar 29/12/2014}
                  Inc(Cont);
                  TotalProd := TotalProd + qryProdutosVendidostotalitem.AsFloat;
                end;
              end;
              qryProdutosVendidos.Next
            end;
          end;

          PreencherDadoFiscal(TotalProd {,TotalProdInc});
          CalcularImpostos(qryProdutosDadosFiscais, qryDadosFiscais, contribipi, true, true, nil, nil, false, FrentedeCaixa, false);
//          CalcularDadosFiscais;
          IncluirVenctosDadosFiscais;

{          if (Cont > 0) or ((TipoNota = tnNORMAL) and (qryProdutosVendidos.RecordCount = 0)) then begin
            PreencherDadoFiscal(TipoNota, NotaFiscalVinculada, TotalProd, TotalProdInc);
            CalcularDadosFiscais;
            if Cont <> 0 then
              IncluirVenctosDadosFiscais;
          end else if (Cont > 0) and (((TipoNota = tnSUBSTITUICAO) and not Assigned(ECFPadrao)) or (TipoNota = tnSUBSTITUIDO)) then begin
            CalcularDadosFiscais;
            if Cont <> 0 then
              IncluirVenctosDadosFiscais;
          end;
        end;
}
        Result := qryDadosFiscais.RecordCount > 0;
        if Result then begin
          PreencherNotaFiscal;
          Result := PreencherCupom;
        end
      finally
        qryProdutosVendidos.GotoBookmark(Pos);
        qryProdutosVendidos.FreeBookmark(Pos);
        qryProdutosVendidos.EnableControls
      end
    end

end;

procedure TdtmFrenteCaixa.NovoMovimento(Produto: int64; Filial: Integer);
var
  ValorICMS: Currency;
begin
  qryMovimentos.Append;
  spcMovimentosProximo.Open;
  qryMovimentosnumero.AsInteger := spcMovimentosProximonumero.AsInteger;
  spcMovimentosProximo.Close;
  qryMovimentosproduto.AsLargeInt   := Produto;
  qryMovimentosfilial.AsInteger     := Filial;
  qryMovimentosprecocomicms.AsFloat := qryProdutosVendidosvalor.AsFloat;
  ValorICMS := RoundTo(qryProdutosVendidosvalor.AsFloat * qryProdutosVendidosaliquotaicms.AsFloat / 100, 2);
  qryMovimentosprecosemicms.AsFloat := qryProdutosVendidosvalor.AsFloat - ValorICMS;
  qryMovimentosaliquotaipi.AsFloat  := qryProdutosVendidosaliquotaipi.AsFloat;
  if ParSistema.FrenteCaixaComCliente and (ClienteVenda<>0) then begin
    qryMovimentoscliente.AsInteger    := ClienteVenda;
    qryMovimentostipocliente.AsString := 'C'
  end
end;

function TdtmFrenteCaixa.PermiteCancelarItens(Var NomeProduto: String): Boolean;
var
  PosAnt: TBookmark;
  Existe: Boolean;
begin
  PosAnt := qryProdutosVendidos.GetBookmark;
  qryProdutosVendidos.DisableControls;
  try
    Existe := False;
    qryProdutosVendidos.First;
    while Not qryProdutosVendidos.Eof do begin
      if qryProdutosVendidosselecionado.AsBoolean and Not qryProdutosVendidoscancelado.AsBoolean then begin
        Existe := True;
        break
      end;
      qryProdutosVendidos.Next
    end;
  finally
    qryProdutosVendidos.GotoBookmark(PosAnt);
    qryProdutosVendidos.FreeBookmark(PosAnt);
    qryProdutosVendidos.EnableControls
  end;
  if Existe then
    Result := True
  else begin
    Result := Not qryProdutosVendidoscancelado.AsBoolean;
    if Not Result then
      NomeProduto := qryProdutosVendidosdescricao.AsString
  end
end;

function TdtmFrenteCaixa.PreencherCupom: Boolean;
var
  NumeroMaquina, Intervencao: Integer;
  NumeroSerie: String;
begin
  if Assigned(ECFPadrao) then begin
    try
      NumeroMaquina := StrToInt(ECFPadrao.NumeroMaquina);
    except
      NumeroMaquina := 0;
    end;
    try
      Intervencao := StrToInt(ECFPadrao.Intervencao);
    except
      Intervencao := 0
    end;
    try
      NumeroSerie := ECFPadrao.SerieMaquina;
    except
      NumeroSerie := ''
    end;
    if ECFPadrao.Erro then begin
      MensagemErro(ECFPadrao.Mensagem);
      Result := False
    end else begin
      if qryCupons.State = dsInactive then
        qryCupons.Open;
      qryDadosFiscais.First;
      while Not qryDadosFiscais.Eof do begin
        qryCupons.Append;
        qryCuponsfilial.AsInteger      := FilialBase;
        qryCuponsmaquina.AsInteger     := NumeroMaquina;
        qryCuponsintervensao.AsInteger := Intervencao;
        qryCuponsnumero.AsInteger      := NumeroCupom;
        qryCuponsnumeroserie.AsString  := NumeroSerie;
        qryCuponsdadofiscal.AsInteger  := qryDadosFiscaisnumero.AsInteger;
        qryCupons.Post;
        qryDadosFiscais.Next;
      end;
      Result := True
    end
  end else
    Result := True
end;

