function TdtmFrenteCaixa.ConsultarClientes: Boolean;
var
  i : Integer;
  iCliente : Integer;
begin
//  frmClienteFrenteCaixa:= nil;
  Origem := 'Frente de Caixa';
//  dtmFrenteCaixa.ReFazConsulta(dtmFrenteCaixa.qryCliente, [0], [0]);
  if not assigned(frmClienteFrenteCaixa) then
    frmClienteFrenteCaixa := TfrmClienteFrenteCaixa.Create(self.owner);
  iCliente := dtmFrenteCaixa.CodigoCliente;
//  frmClienteFrenteCaixa.ActiveControl := frmClienteFrenteCaixa.edfCodigoCliente;
//  frmClienteFrenteCaixa.edfCodigoCliente.exist;

  i:= frmClienteFrenteCaixa.ShowModal;
//  frmClienteFrenteCaixa.Free;
//  frmClienteFrenteCaixa.release;

  Result := False;

  if i = mrCancel then
    dtmFrenteCaixa.FechaClientes(True);
  if i = mrAbort then
    dtmFrenteCaixa.consultaClienteCodigo(iCliente);
  if i = mrOK then
  begin
    Result := True;
    dtmFrenteCaixa.clienteVenda := dtmfrenteCaixa.qryclientecodigo.asinteger;
    dtmFrenteCaixa.nomeclienteVenda := dtmfrenteCaixa.qryclientenome.asstring;
