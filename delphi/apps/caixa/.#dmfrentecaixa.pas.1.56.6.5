function TdtmFrenteCaixa.FecharCupomSemTEF: Boolean;
begin
  Result := true;
  try
    if Assigned(ECFPadrao) then
    begin
      if TotalizarCupom then
      begin
        if vValorPagtoDinheiro<>0 then
          ecfpadrao.PagamentoCupom('DINHEIRO',floattostr(vValorPagtoDinheiro));

        if vValorPagtoCheque<>0 then
          ecfpadrao.PagamentoCupom('CHEQUE',floattostr(vValorPagtoCheque));

        if vValorPagtoCartao<>0 then
          ecfpadrao.PagamentoCupom('CARTAO',floattostr(vValorPagtoCartao));


        if Not ECFPadrao.Erro then
        begin
          ECFPadrao.AbrirGaveta;
          ECFPadrao.FinalizarCupom('', '', MensagemCupomFiscal);
          valortotalimpostoibt := 0;
          valortotalimpostofederal := 0;
          valortotalimpostoestadual := 0;
        end;

        Result := Not ECFPadrao.Erro
      end
      else
        result := false;

      if result then
      begin
        FSituacaoCupom := scFechado;
        ECFPadrao.AtualizarTotalizadorGeral(NomeArquivoECFs);
      end;
    end;
  except
    on E: Exception do
    begin
      HandleExcecao(E);
      if Assigned(ECFPadrao) then
        ECFPadrao.CancelarCupom;
      result := false;
    end;
  end;


end;


