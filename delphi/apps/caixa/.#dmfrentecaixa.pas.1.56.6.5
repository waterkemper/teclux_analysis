function TdtmFrenteCaixa.SalvarVenda(ComTef : Boolean): Boolean;
var
  nroautenticacao: integer;
  intervencao,
  maquina: String;
  controle,
  transacao: Integer;
  dtmFrenteCaixaCopiaCupom: TdtmFrenteCaixa;
  vSaldoTroco, vSaldoCheque : Currency;
  vFechamentoChequeAut, vFechamentoCartaoAut, vFechamentoDinheiroAut : Currency;
  vFechamentoChequeRec, vFechamentoCartaoRec, vFechamentoDinheiroRec : Currency;


  procedure IncluirAutenticacao(tipo: String; Valor: Currency; Chequenumero : String = '');
  begin

    qryAutenticacao.Append;
    qryAutenticacaonumero.AsInteger := ProximoNumeroAutenticacao;

    if numContrato<>'' then
      qryAutenticacaocontratoparcela.asstring := numContrato
    else
      qryAutenticacaocontratoparcela.clear;

    qryAutenticacaodata.AsDateTime  := DataServidor;
    qryAutenticacaofilial.AsInteger := FilialBase;
    qryAutenticacaocaixa.AsInteger  := UsuarioLogin.CodigoUsuario;
    if Chequenumero <> '' then
      qryAutenticacaocheque.AsString  := Chequenumero
    else
      qryAutenticacaocheque.clear;

    qryAutenticacaotipo.AsString    := tipo;
    qryAutenticacaovalor.AsFloat    := Valor;

    if Assigned(ECFPadrao) then
    begin
      qryAutenticacaoecf.AsString     := ECFPadrao.Codigo;
      qryAutenticacaonum_usu.AsString := maquina;
      qryAutenticacaocro.AsString     := intervencao;
      qryAutenticacaocoo.AsInteger    := numerocupom;
      qryAutenticacaonum_fab.AsString := ECFPadrao.SerieMaquina;
    end;

    qryAutenticacaotransacao.AsInteger := transacao;

    if ClienteVenda <> 0 then
    begin
      qryAutenticacaocliente.AsInteger := ClienteVenda;
      qryAutenticacaotipocliente.AsString := 'C';
    end
    else
    begin
      qryAutenticacaocliente.clear;
      qryAutenticacaotipocliente.clear;
    end;

    qryAutenticacao.Post;

  end;

begin
  try
    try
      result := true;

      {Retirar o troco do valor pago em dinheiro}
      vSaldoTroco := abs(SaldoRestante);
      if vSaldoTroco <> 0 then
      begin
        if vValorPagtoDinheiro >= 0 then
        begin
          if vValorPagtoDinheiro >= vSaldoTroco then
          begin
            qryRecebimentos.first;
            while not qryRecebimentos.eof do
            begin
              if qryRecebimentostipo.AsString = 'D' then //dinheiro
              begin
                if qryRecebimentosvalorlancto.AsCurrency >= vSaldoTroco then
                begin
                  qryRecebimentos.Edit;
                  qryRecebimentosvalorlancto.AsCurrency := qryRecebimentosvalorlancto.AsCurrency - vSaldoTroco;
                  qryRecebimentos.post;
                  vSaldoTroco := 0;
                end
                else
                begin
                  vSaldoTroco := vSaldoTroco - qryRecebimentosvalorlancto.AsCurrency;
                  qryRecebimentos.delete;
                end;
              end;

              if vSaldoTroco = 0 then
                break;

              qryRecebimentos.Next;
            end;

            if vSaldoTroco <> 0 then
            begin
              result := false;
              MensagemErro('A venda possui troco de '+ floattostr(vSaldoTroco)+ ' mas não possui pagamento em dinheiro.');
            end;

          end
          else
          begin
            result := false;
            MensagemErro('A venda possui troco de '+ floattostr(vSaldoTroco)+ ' mas não possui pagamento em dinheiro suficiente.');
          end;
        end
        else
        begin
          result := false;
          MensagemErro('A venda possui troco de '+ floattostr(vSaldoTroco)+ ' mas não possui pagamento em dinheiro.');
        end;

        if not result then
        begin
          FExcecao := true;
          if Assigned(ECFPadrao) and not ComTef then
            ECFPadrao.CancelarCupom;
        end;
      end;

      if result then
      begin

        spcTransacaoProximo.Open;
        transacao := spcTransacaoProximotransacao.AsInteger;
        spcTransacaoProximo.Close;

        AtribuirDados(qryRecebimentos, [qryRecebimentostransacao], [transacao], true);


        if Assigned(EcfPadrao) then
        begin
          maquina     := ECFPadrao.NumeroMaquina;
          intervencao := ECFPadrao.Intervencao;
        end;

        if (vValorPagtoDinheiro + vValorPagtoCheque + vValorPagtoCartao - abs(FSaldoRestante)) <> 0 then
          IncluirAutenticacao('F', (vValorPagtoDinheiro + vValorPagtoCheque + vValorPagtoCartao - abs(FSaldoRestante)));

        qryChequesIncluidos.MasterSource := nil;
        vSaldoCheque := 0;
        qryChequesIncluidos.First;
        while not qryChequesIncluidos.eof do
        begin
          IncluirAutenticacao('H',qryChequesIncluidosvalor.AsCurrency, qryChequesIncluidosnumero.AsString);
          vSaldoCheque := vSaldoCheque + qryChequesIncluidosvalor.AsCurrency;
          qryChequesIncluidos.next;
        end;

        qryChequesIncluidos.MasterSource := dsrRecebimentosTemp;

        if vValorPagtoCheque > vSaldoCheque then
          IncluirAutenticacao('H',vValorPagtoCheque - vSaldoCheque);

        if vValorPagtoCartao <> 0 then
          IncluirAutenticacao('T',vValorPagtoCartao);

        {VERIFICAR OS FECHAMENTOS, SEGUNDO ERRO OCORRENDO NA APOLONIA, 2 CHEQUES COM INCONSISTÊNCIA}
        vFechamentoChequeAut := SomarValores(qryAutenticacao, [qryAutenticacaovalor], [qryAutenticacaotipo], ['H'], ['=']);
        vFechamentoCartaoAut := SomarValores(qryAutenticacao, [qryAutenticacaovalor], [qryAutenticacaotipo], ['T'], ['=']);
//        vFechamentoDinheiroAut := SomarValores(qryAutenticacao, [qryAutenticacaovalor], [qryAutenticacaotipo], ['F'], ['=']);

        vFechamentoChequeRec := SomarValores(qryRecebimentos, [qryRecebimentosvalorlancto], [qryRecebimentostipo], ['H'], ['=']);

        vFechamentoCartaoRec := SomarValores(qryRecebimentos, [qryRecebimentosvalorlancto],
                                                              [qryRecebimentostipo],
                                                              ['C'], ['=']);

        vFechamentoCartaoRec := vFechamentoCartaoRec+ SomarValores(qryRecebimentos, [qryRecebimentosvalorlancto],
                                                              [qryRecebimentostipo],
                                                              ['B'], ['=']);

//        vFechamentoDinheiroRec := SomarValores(qryRecebimentos, [qryRecebimentosvalorlancto], [qryRecebimentostipo],['D'], ['=']);

        if (vValorPagtoCheque <> vFechamentoChequeAut) then
        begin
          result := false;
          MensagemErro(format('O Saldo do valor do pagamento em cheques %f difere do total das autenticações %f', [vValorPagtoCheque, vFechamentoChequeAut]));
        end;

        if (vValorPagtoCheque <> vFechamentoChequeRec) then
        begin
          result := false;
          MensagemErro(format('O Saldo do valor do pagamento em cheques %f difere do total dos recebimentos %f', [vValorPagtoCheque, vFechamentoChequeRec]));
        end;

        if (vValorPagtoCartao <> vFechamentoCartaoAut) then
        begin
          result := false;
          MensagemErro(format('O Saldo do valor do pagamento em cartões %f difere do total das autenteticações %f', [vValorPagtoCartao, vFechamentoCartaoAut]));
        end;

        if (vValorPagtoCartao <> vFechamentoCartaoRec) then
        begin
          result := false;
          MensagemErro(format('O Saldo do valor do pagamento em cartões %f difere do total dos recebimentos %f', [vValorPagtoCartao, vFechamentoCartaoRec]));
        end;


      end;
    except
      on E: Exception do
      begin
        result := false;
        HandleExcecao(E);
        if Assigned(ECFPadrao) and not ComTef then
          ECFPadrao.CancelarCupom;
      end;
    end;

    if result then
    begin
      Result := NotasFiscaisCupom;

      if Result then
      begin
        try
          if NotaFiscalVinculada then
          begin
            if not Assigned(dtmFrenteCaixaCopiaCupom) then
              dtmFrenteCaixaCopiaCupom := TdtmFrenteCaixa.Create(nil);

            dtmFrenteCaixaCopiaCupom.qryDadosFiscais.open;
            CopiarRegistros(qryDadosFiscais, dtmFrenteCaixaCopiaCupom.qryDadosFiscais);

            dtmFrenteCaixaCopiaCupom.spcDadosFiscaisProximo.Open;
            dtmFrenteCaixaCopiaCupom.qryDadosFiscais.edit;
            dtmFrenteCaixaCopiaCupom.qryDadosFiscaisnumero.AsInteger := dtmFrenteCaixaCopiaCupom.spcDadosFiscaisProximonumero.AsInteger;
            dtmFrenteCaixaCopiaCupom.qryDadosFiscaisnotavinculada.AsBoolean := true;
            dtmFrenteCaixaCopiaCupom.qryDadosFiscais.post;
            dtmFrenteCaixaCopiaCupom.spcDadosFiscaisProximo.Close;

            dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscais.Open;
            CopiarRegistros(qryProdutosDadosFiscais, dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscais);

            AtribuirChave(dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscais,

                          [dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscaisdadofiscal,
                           dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscaiscodigofiscal,
                           dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscaisnatureza],

                          [dtmFrenteCaixaCopiaCupom.qryDadosFiscaisnumero,
                           dtmFrenteCaixaCopiaCupom.qryDadosFiscaiscodigofiscal,
                           dtmFrenteCaixaCopiaCupom.qryDadosFiscaiscodigonatureza]);

            AtribuirDados(dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscais,

                          [dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscaisincidencia,
                           dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscaisaliquotaicms],

                          [ifthen(regimetributario=1,ctSNOutrosS,ctOUTROS), 0.00]);

            LimparCampos(dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscais,
                         [dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscaismovimento]);


            dtmFrenteCaixaCopiaCupom.qryVenctosDadosFiscais.Open;
            CopiarRegistros(qryVenctosDadosFiscais, dtmFrenteCaixaCopiaCupom.qryVenctosDadosFiscais);
            AtribuirChave(dtmFrenteCaixaCopiaCupom.qryVenctosDadosFiscais,
                          [dtmFrenteCaixaCopiaCupom.qryVenctosDadosFiscaisdadofiscal],
                          [dtmFrenteCaixaCopiaCupom.qryDadosFiscaisnumero]);


            qrynotas.edit;
            qryNotasdadofiscalvinculado.AsInteger :=  qryNotasdadofiscal.AsInteger;
            qryNotasdadofiscal.AsInteger :=  dtmFrenteCaixaCopiaCupom.qryDadosFiscaisnumero.asinteger;
            qrynotas.post;

            CalcularImpostos(dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscais,
                             dtmFrenteCaixaCopiaCupom.qryDadosFiscais, ContribIPI, true, true, nil, nil,
                             false, FrentedeCaixa, false, true, nil, true);

            CopiarRegistros(dtmFrenteCaixaCopiaCupom.qryDadosFiscais, qryDadosFiscais);
            CopiarRegistros(dtmFrenteCaixaCopiaCupom.qryProdutosDadosFiscais, qryProdutosDadosFiscais);

            CopiarRegistros(dtmFrenteCaixaCopiaCupom.qryVenctosDadosFiscais, qryVenctosDadosFiscais);

            qryprodutosdadosfiscais.LinkFields := 'numero = dadofiscal';
            qryprodutosdadosfiscais.MasterSource := dsrDadosFiscais;

            qryVenctosDadosFiscais.LinkFields := 'numero = dadofiscal';
            qryVenctosDadosFiscais.MasterSource := dsrDadosFiscais;

            dtmFrenteCaixaCopiaCupom.Free;
            dtmFrenteCaixaCopiaCupom := nil;


            if CondicaoEmissorNFE then
            begin
              ValidouNFE := EmitirNFe(true);
              if not ValidouNFE then
              begin
                MensagemAviso('A NFe vinculada a este cupom não será gerada devido a erros na validação dos campos');
                qrynotas.close;
                qryseriesfiliais.Close;
                LimparTabela(qryProdutosDadosFiscais); //eliminará somente os registros relacionados ao dadofiscal da nota LinkFields := 'numero = dadofiscal';
                LimparTabela(qryVenctosDadosFiscais); //eliminará somente os registros relacionados ao dadofiscal da nota LinkFields := 'numero = dadofiscal';
                qryDadosFiscais.Delete;
              end;
            end;

          end;

          FExcecao:=False;

          if result then
          begin

            if qryorcamentos.recordcount = 1 then
            begin
              qryorcamentos.edit;
              qryorcamentos.fieldbyname('situacao').asstring := 'T';
              qryorcamentos.post;;
            end;

            Result := Perpetrar([qryagentes, qryTiposRecebimentos, qryRecebimentos, qryChequesIncluidos, qryAutenticacao,
                                 qryDadosFiscais, qryMovimentos, qryProdutosDadosFiscais, qryVenctosDadosFiscais, qryNotas,
                                 qryCupons, qrySeriesFiliais, qryOrcamentos, qryProdutosOrcamentos]);

            if result then
            begin
              qryFuncaoGerarContratoporDadoFiscal.close;
              qryFuncaoGerarContratoporDadoFiscal.ParamByName('dadofiscal').asinteger := vNumeroDadoFiscal;
              qryFuncaoGerarContratoporDadoFiscal.open;
              result := perpetrar([]);

              if result then
              begin
                if (qryorcamentos.recordcount = 1) and (numcontrato<>'') then
                begin
                  qryorcamentos.edit;
                  qryorcamentos.fieldbyname('contrato').asstring := numcontrato;
                  qryorcamentos.post;;
                end;
                perpetrar([qryorcamentos]);
              end;

            end;

          end;


        except
          on E: Exception do
          begin
            result := false;
            HandleExcecao(E);
            if Assigned(ECFPadrao) and not ComTef then
              ECFPadrao.CancelarCupom;
          end;
        end;

        if Result then
          ImprimirNotaFiscal;

      end
    end;

  finally

      qryChequesIncluidos.Close;
      qryAutenticacao.Close;
      qryMovimentos.Sql[28] := 'm.numero = 0';
      qryProdutosDadosFiscais.Close;

      qryprodutosdadosfiscais.LinkFields := '';
      qryprodutosdadosfiscais.MasterSource := nil;

      qryVenctosDadosFiscais.LinkFields := '';
      qryVenctosDadosFiscais.MasterSource := nil;

      qryVenctosDadosFiscais.Close;
      qryNotas.Close;
      qryCupons.Close;
      qrySeriesFiliais.Close;
      qryChequesIncluidos.Open;
      qryAutenticacao.Open;
  end;
end;

