function TdtmFrenteCaixa.GuardarItem(quantidade, desconto: Currency): boolean;
  function VerificarSaldoemEstoque: boolean;
  var
    vTotalVendido: Currency;
  begin

    vTotalVendido := 0;
    result := true;
    vTotalVendido := SomarValores(qryProdutosVendidos, [qryProdutosVendidosquantidade],
                    [qryProdutosVendidosproduto], [qryProdutocodigo.AsString], ['=']);

    if (vTotalVendido + Quantidade) > qryProdutoemestoque.asfloat then
      if not parsistema.PermitirVendaSemEstoque then
        result := false
  end;

begin

  result := true;
  try
    result := VerificarSaldoemEstoque;

    if not result then
      MensagemAviso(Format(ctSEMESTOQUESEMVENDA, [qryProduto.parambyname('produtovisual').AsString, inttostr(FilialBase)]))
    else
    begin
      CopiarRegistros(qryProduto, qryProdutosDigitados);
      qryProdutosDigitados.Edit;
      qryProdutosDigitadosquantidade.AsCurrency := Quantidade;
      qryProdutosDigitadosdesconto.AsCurrency := Desconto;
      qryProdutosDigitadosprodutodigitado.asstring := qryproduto.parambyname('produtovisual').asstring;
      qryProdutosDigitados.post;
    end
  except
    result := false;
  end;
end;

function TdtmFrenteCaixa.CondicaoVenderItem: boolean;
begin
  result :=  not (qryProdutosDigitados.State in [dsedit,dsinsert]);
  if result then
  begin
    qryProdutosDigitados.First;
    result := not qryProdutosDigitados.isempty;
  end;
end;

procedure TdtmFrenteCaixa.SetSituacaoCupom(const Value: TtecSituacaoCupom);
begin
  FSituacaoCupom := Value;
  AfterAlteracaoSituacaoCupom(nil);
end;

end.
