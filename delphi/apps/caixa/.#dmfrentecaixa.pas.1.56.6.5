begin
  inherited;
  qryRecebimentosTemp.readonly := (qryRecebimentosTemptef.asstring<>''); {or
                                  ((qryRecebimentosTemptipotiporecebimento.AsString='H') and not qryChequesIncluidos.IsEmpty)};
  qryRecebimentosTemptiporec.readonly := (qryChequesIncluidosnumero.AsString<>'');                                
