function TdtmFrenteCaixa.ExistePesquisaProduto(campo,
  codigo: String): Boolean;
const
  SQL = '(p.%s ilike ''%s%s'')';

  SQLChaves = ' ((to_ascii(cast(p.codigovisual as varchar),''latin1'') ilike to_ascii(''%s%s'',''latin1'')) '+
              ' or p.codigo in (select pcb.produto from produtoscodigobarras pcb where (to_ascii(pcb.codigobarras,''latin1'') ilike to_ascii(''%s%s'',''latin1''))))';

begin
  if qryConsultaProduto.Active then
   qryConsultaProduto.Close;

  if campo = 'codigo' then
    qryConsultaProduto.MacroByName('codigo').AsString := Format(SQLChaves, [ANSIUpperCase(codigo), '%', ANSIUpperCase(codigo), '%'])
  else
    qryConsultaProduto.MacroByName('codigo').AsString := Format(SQL, [Campo, Codigo, '%']);
    
  qryConsultaProduto.Open;
  Result := qryConsultaProduto.RecordCount > 0
end;

