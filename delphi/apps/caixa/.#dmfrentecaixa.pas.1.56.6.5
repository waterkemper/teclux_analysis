function TdtmFrenteCaixa.MensagemCupomFiscal: String;
var
  vPercTrib : Currency;
begin
  if not qryVendedorcodigo.IsNull then
    FMensagemDesconto := FMensagemDesconto + IfThen(FMensagemDesconto<>'',sLineBreak) +
                         'Vendedor: ' + qryVendedorcodigo.AsString + ' - ' + qryVendedornome.AsString;

  if valortotalimpostoibt <> 0 then
  begin
    vPercTrib := roundto(valortotalimpostoibt / ValorTotalCompra * 100, -2);

    FMensagemDesconto := FMensagemDesconto + sLineBreak + IfThen(FMensagemDesconto<>'',sLineBreak) +
                         'Trib Aprox R$ '+FormatarValor(valortotalimpostofederal,2) + ' Federal R$ '
                          + FormatarValor(valortotalimpostoestadual,2) + ' Estadual ' + sLineBreak +
                          'Fonte: IBPT/FECOMERCIO '+'        '+chaveibpt;
  end;
  if clientevenda <> 0 then
    FMensagemDesconto := FMensagemDesconto + sLineBreak +
                         'CONTRATO: '+numContrato;

  result := FMensagemDesconto;
end;


