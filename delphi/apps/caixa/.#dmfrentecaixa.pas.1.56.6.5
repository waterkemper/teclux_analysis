function TdtmFrenteCaixa.EfetuarDesconto:Boolean;
var
  OK: Boolean;
  botao : TMessageButton;
begin
  Result := False;
  frmLerValor := TfrmLerValor.Create(frmLerValor, 'Desconto');
  try
    botao :=  MensagemSelecionaOpcao('Sim para desconto por percentual.'+#13+ 'Não para desconto por valor.');
    if botao = smbNO then
      FDescontoPorValor := True;
    OK := False;
    if not(botao = smbCancel) then
    begin
      frmLerValor.Numero := 0;
      OK := frmLerValor.ShowModal = mrOK;
    end;
    if OK then
    begin
      FValorDesconto := frmLerValor.Numero;
      if TemComposto then
        FDescontoProdutoComposto:= FValorDesconto + FDescontoProdutoComposto;
      if not (FDescontoPorValor) then
        FValorDesconto := ValorDoPercentualSobreTotal(TotalPagar, FValorDesconto);
      if ValidarDesconto then
      begin
        FValorAReceber := FTotalPagar - FValorDesconto - ValorTotalDescontoItem + ValorAcrescimo;
        FSaldoRestante := FValorAReceber;
        Result := True;
      end
      else
      begin
        FValorDesconto := 0;
      end;
    end;
  finally
    frmLerValor.Free;
  end;
end;


