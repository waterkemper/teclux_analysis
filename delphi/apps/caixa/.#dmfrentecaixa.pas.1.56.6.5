procedure TdtmFrenteCaixa.BloquearEstoque;
var
  WhereSQL: String;
begin
  qryProdutosVendidos.DisableControls;
  try
    WhereSQL := '';
    qryProdutosVendidos.First;
    while Not qryProdutosVendidos.Eof do begin
      WhereSQL := WhereSQL +
      '((e.produto = ' + qryProdutosVendidosproduto.AsString + ')and' +
      '(e.filial = '   + qryProdutosVendidosfilial.AsString  + '))or';
      qryProdutosVendidos.Next
    end;
    Delete(WhereSQL, Length(WhereSQL) - 1, 2);
  finally
    qryProdutosVendidos.EnableControls
  end;
  qryEstoque.Sql[21] := WhereSQL;
  qryEstoque.Open;
end;

