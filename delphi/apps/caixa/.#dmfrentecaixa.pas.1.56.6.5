function TdtmFrenteCaixa.GravarRecebimentos(ComTef: boolean): Boolean;
var
  vok: Boolean;
  vValorCheque, vValorCartao : Currency;
  vControleRecebimento : integer;


  function RecebimentosTipo: String;
  begin
    if TEFPadrao.TipoTransacao_ in [10,11,12,13] then
       result := 'C'                           //credito
    else if TEFPadrao.TipoTransacao_ in [20,21,22,23,24,25] then
       result := 'B';                          //debito
  end;


  procedure IncluirRecebimentoCheque(ChequeCadastrado: Boolean);
  begin
    if ChequeCadastrado then
    begin
      qryRecebimentos.Append;

      spcRecebimentosProximo.Open;
      qryRecebimentoscodigo.AsInteger := spcRecebimentosProximocodigo.AsInteger;
      spcRecebimentosProximo.Close;
      qryRecebimentosdatalancto.AsDateTime  := DataServidor;
      qryRecebimentosdatavencto.AsDateTime  := qryChequesIncluidosvencto.AsDateTime;

      qryRecebimentosfilial.AsInteger       := FilialBase;
      qryRecebimentossituacao.AsString      := 'N';
      qryRecebimentosvalorlancto.AsCurrency := qryChequesIncluidosvalor.AsCurrency;
      qryRecebimentosvalortotal.AsCurrency := qryChequesIncluidosvalor.AsCurrency;
      qryRecebimentoscontrole.AsInteger    := 1;
      qryRecebimentoscontrolerecebimento.AsInteger := qryRecebimentoscodigo.AsInteger;

//      qryRecebimentosdatavencto.AsDateTime  := qryChequesIncluidosdata.AsDateTime;
      qryRecebimentostiporecebimento.AsInteger := qryRecebimentosTemptiporecebimento.AsInteger;
      qryRecebimentostipo.AsString         := qryRecebimentosTemptipo.AsString;
      qryRecebimentoscheque.AsString       := qryChequesIncluidosnumero.AsString;
      qryRecebimentosnumeroregistrorecebimentotemp.AsInteger := qryRecebimentosTemp.recno;
      qryRecebimentos.Post;

    end
    else
    begin
      qryRecebimentos.Append;
      spcRecebimentosProximo.Open;
      qryRecebimentoscodigo.AsInteger := spcRecebimentosProximocodigo.AsInteger;
      spcRecebimentosProximo.Close;
      qryRecebimentosdatalancto.AsDateTime  := DataServidor;
      qryRecebimentosfilial.AsInteger      := FilialBase;
      qryRecebimentossituacao.AsString     := 'N';
      qryRecebimentosvalorlancto.AsCurrency := qryRecebimentosTempvalorlancto.AsCurrency - vTotalValoresCheques;
      qryRecebimentosvalortotal.AsCurrency := qryRecebimentosvalorlancto.AsCurrency;
      qryRecebimentoscontrole.AsInteger    := 1;
      qryRecebimentoscontrolerecebimento.AsInteger := qryRecebimentoscodigo.AsInteger;
      qryRecebimentosdatavencto.AsDateTime := DataServidor;
      qryRecebimentostiporecebimento.AsInteger := qryRecebimentosTemptiporecebimento.AsInteger;
      qryRecebimentostipo.AsString         := qryRecebimentosTemptipo.AsString;
      qryRecebimentoscheque.clear;
      qryRecebimentosnumeroregistrorecebimentotemp.AsInteger := qryRecebimentosTemp.recno;
      qryRecebimentos.Post;
    end;
  end;

  procedure IncluirRecebimentoDinheiro;
  begin
    if qryRecebimentos.locate('tipo;tiporecebimento', VarArrayOf([qryRecebimentosTemptipo.AsString,
                                                                  qryRecebimentosTemptiporecebimento.AsInteger]), []) then
      qryRecebimentos.edit
    else
    begin
      qryRecebimentos.Append;
      spcRecebimentosProximo.Open;
      qryRecebimentoscodigo.AsInteger := spcRecebimentosProximocodigo.AsInteger;
      spcRecebimentosProximo.Close;
    end;

    qryRecebimentosfilial.AsInteger       := FilialBase;
    qryRecebimentossituacao.AsString      := 'N';
    qryRecebimentosdatalancto.AsDateTime  := DataServidor;
//    qryRecebimentosdatavencto.AsDateTime := qryRecebimentosdatalancto.AsDateTime;

    qryRecebimentosvalorlancto.AsCurrency := qryRecebimentosvalorlancto.AsCurrency + qryRecebimentosTempvalorlancto.AsCurrency;
    qryRecebimentosvalortotal.AsCurrency := qryRecebimentosvalorlancto.AsCurrency;

    qryRecebimentostipo.AsString          := qryRecebimentosTemptipo.AsString;
    qryRecebimentostiporecebimento.AsInteger := qryRecebimentosTemptiporecebimento.AsInteger;
    qryRecebimentoscontrole.AsInteger     := 1;
    qryRecebimentoscontrolerecebimento.AsInteger := qryRecebimentoscodigo.AsInteger;

    qryRecebimentos.Post;
  end;

  procedure ApagarChequesIncluidos;
  begin
    qryChequesIncluidos.First;
    while not qryChequesIncluidos.eof do
    begin
      if qryChequesIncluidosnumeroregistrorecebimentotemp.AsInteger = qryRecebimentosTemp.RecNo then
        qryChequesIncluidos.delete
      else
        qryChequesIncluidos.next;
    end;

    qryRecebimentos.First;
    while not qryRecebimentos.eof do
    begin
      if qryRecebimentosnumeroregistrorecebimentotemp.AsInteger = qryRecebimentosTemp.RecNo then
        qryRecebimentos.delete
      else
        qryRecebimentos.next;
    end;
  end;

  procedure RecalcularValoresVariaveis;
  begin
    qryrecebimentostemp.First;
    while not qryRecebimentostemp.Eof do
    begin
      if not qryRecebimentosTemp.ReadOnly then
      begin
        if qryRecebimentosTemptipotiporecebimento.AsString = 'D' then
        begin
          if qryRecebimentosTempok.asboolean then
          begin
            vValorPagtoDinheiro := vValorPagtoDinheiro - qryRecebimentosTempvalorlancto.AsCurrency;
            vValorPagtoConfirmado := vValorPagtoConfirmado - qryRecebimentosTempvalorlancto.AsCurrency;
            qryRecebimentosTemp.Edit;
            qryRecebimentosTempok.AsBoolean := false;
            qryRecebimentosTemp.post;
          end;
        end
        else
        if qryRecebimentosTemptipotiporecebimento.AsString = 'H' then
        begin
          if qryRecebimentosTempok.asboolean then
          begin
            vValorPagtoCheque := vValorPagtoCheque - qryRecebimentosTempvalorlancto.AsCurrency;
            vValorPagtoConfirmado := vValorPagtoConfirmado - qryRecebimentosTempvalorlancto.AsCurrency;
            qryRecebimentosTemp.Edit;
            qryRecebimentosTempok.AsBoolean := false;
            qryRecebimentosTemp.post;
          end;
        end
        else
        if (qryRecebimentosTemptipotiporecebimento.AsString = 'C') or
           (qryRecebimentosTemptipotiporecebimento.AsString = 'B') then
        begin
            if comTef then
              vValorPagtoCartao := vValorPagtoCartao - qryRecebimentosTempvalorlancto.AsCurrency;

          if qryRecebimentosTempok.asboolean then
          begin
            if not comTef then
              vValorPagtoCartao := vValorPagtoCartao - qryRecebimentosTempvalorlancto.AsCurrency;

            vValorPagtoConfirmado := vValorPagtoConfirmado - qryRecebimentosTempvalorlancto.AsCurrency;
            qryRecebimentosTemp.Edit;
            qryRecebimentosTempok.AsBoolean := false;
            qryRecebimentosTemp.post;
          end;
        end;
      end;
      qryrecebimentostemp.next;
    end;
  end;

var
  vRetornoCheque, maior, i : integer;
  vRetorno  : TMessageButton;
begin
  result := true;
  FExcecao := false;

  if (TotalRecebimentos < ValorAReceber) then
  begin
    MensagemAviso('A soma dos recebimentos difere do valor da venda.');
    result := false;
  end;


  if result then
  begin
    FGravandoRecebimentos := True;
    try
      try

    //    qryRecebimentosTemp.DisableControls;
        qryRecebimentosTemp.First;

        while not qryRecebimentosTemp.Eof do
        begin
          if not qryRecebimentosTemp.ReadOnly then
          begin
            if qryRecebimentosTemptipo.AsString = 'D' then    //dinheiro
            begin
              vValorPagtoDinheiro := vValorPagtoDinheiro + qryRecebimentosTempvalorlancto.AsCurrency;
              ConfirmarRecebimentosTemp;
              vValorPagtoConfirmado := vValorPagtoConfirmado + qryRecebimentosTempvalorlancto.AsCurrency;

            end
            else
            if qryRecebimentosTemptipo.AsString = 'H' then    //cheque
            begin
              try
                vValorCheque := 0;
                vok := (vTotalValoresCheques = qryRecebimentosTempvalorlancto.AsCurrency);
                vRetorno := smbNO;

                if (vTotalValoresCheques < qryRecebimentosTempvalorlancto.AsCurrency) and
                   ((ParSistema.ChequenoFrentedeCaixa = 'Opcional') or
                    (ParSistema.ChequenoFrentedeCaixa = 'Obrigatório')) then
                begin
                  if (ParSistema.ChequenoFrentedeCaixa = 'Opcional') then
                    vRetorno := MensagemSelecionaOpcao('Deseja informar o(s) dado(s) do(s) cheque(s)?')
                  else
                    vRetorno := smbYes;
                end;

                while vTotalValoresCheques < qryRecebimentosTempvalorlancto.AsCurrency do
                begin
                  vValorCheque := qryRecebimentosTempvalorlancto.AsCurrency - vTotalValoresCheques;
                  vRetornoCheque := 0;

                  if vRetorno = smbYes then
                  begin
                    if not assigned(frmCadastroChequeFrenteCaixa) then
                    begin
                      origem := 'Recebimentos';
                      if not assigned(frmCadastroChequeFrenteCaixa) then
                        frmCadastroChequeFrenteCaixa := TfrmCadastroChequeFrenteCaixa.Create(self.Owner);
                    end;


                    frmCadastroChequeFrenteCaixa.fraCMC7.LimparCampos;
                    frmCadastroChequeFrenteCaixa.ValorCheque := FloatToStr(vValorCheque);
                    frmCadastroChequeFrenteCaixa.edtValorCheque.valormaximo := vValorCheque;

                    vRetornoCheque := frmCadastroChequeFrenteCaixa.ShowModal;

                    if (vRetornoCheque = mrOK) then
                    begin
                      vValorCheque := StrToFloat(frmCadastroChequeFrenteCaixa.ValorCheque);
                      IncluirRecebimentoCheque(true);
                    end;
                  end;

                  if ((vRetorno = smbNO) and (ParSistema.ChequenoFrentedeCaixa = 'Sem Cheque')) or
                     ((vRetorno = smbNO) and (ParSistema.ChequenoFrentedeCaixa = 'Opcional')) or
                     ((vRetorno = smbYes) and (vRetornoCheque = mrOK)) then
                    vTotalValoresCheques := vTotalValoresCheques + vValorCheque;

                  if (vTotalValoresCheques < qryRecebimentosTempvalorlancto.AsCurrency) and (vRetorno = smbYes) then
                  begin
                    vRetorno := MensagemSelecionaOpcao('Saldo Restante de Cheques: ' +
                                                        formatfloat('###,##0.00', qryRecebimentosTempvalorlancto.AsCurrency - vTotalValoresCheques) + chr(13) +
                                                       'Deseja continuar a informar o(s) dado(s) do(s) cheque(s)?');
                    if (vretorno = smbNo) then
                    begin
                      if (ParSistema.ChequenoFrentedeCaixa = 'Obrigatório') then
                        vok := false
                      else
                        vok := true;
                      break;
                    end
                    else
                    if (vRetorno = smbCancel) then
                    begin
                      vok := false;
                      break;
                    end;
                  end
                  else
                  if (vRetorno = smbCancel) then
                  begin
                    vok := false;
                    break;
                  end
                  else
                  if vTotalValoresCheques = qryRecebimentosTempvalorlancto.AsCurrency then
                    vok := true

                end;

                if vok then
                begin
                  vValorPagtoCheque := vValorPagtoCheque + qryRecebimentosTempvalorlancto.AsCurrency;
                  ConfirmarRecebimentosTemp;
                  vValorPagtoConfirmado := vValorPagtoConfirmado + qryRecebimentosTempvalorlancto.AsCurrency;
                  result := true;
                end
                else
                begin
                  result := false;
                  if (ParSistema.ChequenoFrentedeCaixa = 'Obrigatório') or
                     (vTotalValoresCheques > qryRecebimentosTempvalorlancto.AsCurrency) then
                    MensagemErro('O total dos valores dos cheques não estão fechando com o total do recebimento em cheque informado');
                end;

              finally
                if assigned(frmCadastroChequeFrenteCaixa) then
//                  frmCadastroChequeFrenteCaixa.Release;
              end;

            end
            else
            if ((qryRecebimentosTemptipo.AsString = 'C')  or     //credito
                (qryRecebimentosTemptipo.AsString = 'B')) then   //debito
            begin
              if not comtef then
              begin
                vValorCartao := 0;
                for i := 1 to qryRecebimentosTempnumerorecebimentos.asinteger do
                begin
                  qryRecebimentos.Append;
//                  qryRecebimentosdatavencto.AsDateTime := DataServidor;

                  spcRecebimentosProximo.Open;
                  qryRecebimentoscodigo.AsInteger := spcRecebimentosProximocodigo.AsInteger;
                  spcRecebimentosProximo.Close;

                  qryRecebimentosfilial.AsInteger       := FilialBase;
                  qryRecebimentossituacao.AsString      := 'N';
                  qryRecebimentosdatalancto.AsDateTime  := DataServidor;
                  if i = 1 then
                    vControleRecebimento := qryRecebimentoscodigo.AsInteger;
                  qryRecebimentoscontrolerecebimento.AsInteger := vControleRecebimento;

                  if i = qryRecebimentosTempnumerorecebimentos.asinteger then
                    qryRecebimentosvalorlancto.AsCurrency := qryRecebimentosTempvalorlancto.AsCurrency - vValorCartao
                  else
                    qryRecebimentosvalorlancto.AsCurrency := RoundTo(qryRecebimentosTempvalorlancto.AsCurrency / qryRecebimentosTempnumerorecebimentos.AsInteger,-2);

//                  qryRecebimentosdatavencto.AsDateTime  := DataServidor;;
                  qryRecebimentostipo.AsString := qryRecebimentosTemptipotiporecebimento.AsString;
                  qryRecebimentostiporecebimento.AsInteger := qryRecebimentosTemptiporecebimento.asInteger;
                  qryRecebimentosvalortotal.AsCurrency := qryRecebimentosTempvalorlancto.AsCurrency;
                  qryRecebimentoscontrole.AsInteger     := i;

                  qryRecebimentostef.clear;

                  qryRecebimentos.Post;
                  ConfirmarRecebimentosTemp;
                  vValorPagtoConfirmado := vValorPagtoConfirmado + qryRecebimentosvalorlancto.AsCurrency;
                  vValorPagtoCartao := vValorPagtoCartao + qryRecebimentosvalorlancto.AsCurrency;
                  vValorCartao :=  vValorCartao + qryRecebimentosvalorlancto.AsCurrency;
                end;
              end
              else
                vValorPagtoCartao := vValorPagtoCartao + qryRecebimentosTempvalorlancto.AsCurrency;
            end;
          end;

          if not result then
             break;

          qryRecebimentosTemp.Next;
        end;

        if (TotalRecebimentos > ValorAReceber)
          and (vValorPagtoDinheiro < (TotalRecebimentos - ValorAReceber))
          and result then
        begin
          if vValorPagtoDinheiro = 0 then
            MensagemAviso('Existe troco e nenhuma forma de pagamento em dinheiro foi informada')
          else
            MensagemAviso('O valor pago em dinheiro é inferior ao valor do troco');

          result := false;
        end;

        if result then
        begin
          if comtef then
          begin
//            vTEFJaIniciado := true;
            TEFPadrao.ValorPagoDinheiro := vValorPagtoDinheiro;
            TEFPadrao.ValorPagoCheque := vValorPagtoCheque;
            tefpadrao.ValorDesconto := ValorDesconto;
            tefpadrao.ValorAcrescimo := ValorAcrescimo;

            TEFPadrao.MensagemCupom := MensagemCupomFiscal;

            try

              qryRecebimentosTemp.AfterScroll := nil;
              qryRecebimentosTemp.First;
              while not qryRecebimentosTemp.Eof do
              begin
                if not qryRecebimentosTempok.AsBoolean then
                begin
                  if ((qryRecebimentosTemptipo.AsString = 'C')  or     //credito
                      (qryRecebimentosTemptipo.AsString = 'B'))  then   //debito
                  begin

                    TEFPadrao.ValorTransacao := floattostr(qryRecebimentosTempvalorlancto.AsCurrency);
                    result := TEFPadrao.ExecutarOperacao(sopCARTAO, 0);
                    if result then
                    begin
                      if not qryAgentes.locate('descricao', tefpadrao.Administradora, []) then
                      begin
                        qryAgentes.append;
                        spcAgentesProximo.open;
                        qryAgentescodigo.asinteger := spcAgentesProximocodigo.asinteger;
                        spcAgentesProximo.close;
                        qryAgentesdescricao.asstring := tefpadrao.Administradora;
                        qryAgentes.post;
                      end;

                      if not qryTiposRecebimentos.locate('descricaoagente;numerorecebimentos;tiporecebimento',
                          VarArrayof([tefpadrao.Administradora,
                                      TefPadrao.QtdadeParcelas,
                                      RecebimentosTipo]), []) then
                      begin
                        qryTiposRecebimentos.append;
                        spcTiposRecebimentosProximo.Open;
                        qryTiposRecebimentoscodigo.asInteger:= spcTiposRecebimentosProximocodigo.AsInteger;
                        spcTiposRecebimentosProximo.Close;

                        qryTiposRecebimentosagente.asinteger := qryAgentescodigo.asinteger;
                        qryTiposRecebimentosdescricaoagente.asstring := qryAgentesdescricao.asstring;
                        qryTiposRecebimentosnumerorecebimentos.asinteger := TefPadrao.QtdadeParcelas;
                        qryTiposRecebimentosdiasuteis.AsInteger := 1;  {necessário o valor caso contrário dá erro na trigger da tabela tiposrecebimentos}
                        qryTiposRecebimentosintervalorecebimentos.asinteger := 0;
                        qryTiposRecebimentostiporecebimento.asstring := RecebimentosTipo;
                        qryTiposRecebimentosdescricao.asstring := qryTiposRecebimentosdescricaoagente.asstring + ' ' +qryTiposRecebimentosnumerorecebimentos.asString + 'X';
                        qryTiposRecebimentos.post;
                      end;

                      qryRecebimentosTemp.readonly := false;
                      qryRecebimentosTemp.Edit;
                      qryRecebimentosTemptiporecebimento.AsInteger := qryTiposRecebimentoscodigo.asInteger;
                      qryRecebimentostemptef.AsString          := tefpadrao.nsu;
                      qryRecebimentostempnomeredensu.asstring   := tefpadrao.nomerede;
                      qryRecebimentostemphora.asString := TefPadrao.HoraTransacao;
                      qryRecebimentostempdata.AsString := tefpadrao.DataTransacao;
                      qryRecebimentosTemp.post;
                      ConfirmarRecebimentosTemp;

                      vValorCartao := 0;
                      for i := 1 to tefpadrao.QtdadeParcelas do
                      begin
                        qryRecebimentos.Append;
//                        qryRecebimentosdatavencto.AsDateTime := strtodate(tefpadrao.DataTransacao);

                        spcRecebimentosProximo.Open;
                        qryRecebimentoscodigo.AsInteger := spcRecebimentosProximocodigo.AsInteger;
                        spcRecebimentosProximo.Close;


                        qryRecebimentosfilial.AsInteger       := FilialBase;
                        qryRecebimentossituacao.AsString      := 'N';
                        qryRecebimentosdatalancto.AsDateTime  := strtodate(tefpadrao.DataTransacao);

                        if i = 1 then
                          vControleRecebimento := qryRecebimentoscodigo.AsInteger;
                        qryRecebimentoscontrolerecebimento.AsInteger := vControleRecebimento;


                        if i = tefpadrao.QtdadeParcelas then
                          qryRecebimentosvalorlancto.AsCurrency := qryRecebimentosTempvalorlancto.AsCurrency - vValorCartao
                        else
                          qryRecebimentosvalorlancto.AsCurrency := RoundTo(qryRecebimentosTempvalorlancto.AsCurrency / tefpadrao.QtdadeParcelas,-2);

                        qryRecebimentosvalortotal.AsCurrency := qryRecebimentosTempvalorlancto.AsCurrency;

//                        qryRecebimentosdatavencto.AsDateTime  := strtodate(tefpadrao.DataTransacao);
                        qryRecebimentostipo.AsString := RecebimentosTipo;
                        qryRecebimentostiporecebimento.AsInteger := qryTiposRecebimentoscodigo.asInteger;
                        qryRecebimentoscontrole.AsInteger     := i;
                        qryRecebimentostef.AsString          := tefpadrao.nsu;
                        qryRecebimentosnomeredensu.asstring   := tefpadrao.nomerede;
                        qryRecebimentoshora.asdatetime := strtodatetime(TefPadrao.HoraTransacao);
                        qryRecebimentos.Post;

                        vJaPossuiPagamentCartaoAprovado := true;

                        vValorPagtoConfirmado := vValorPagtoConfirmado + qryRecebimentosvalorlancto.AsCurrency;
  //                        vValorPagtoCartao := vValorPagtoCartao + qryRecebimentosvalorlancto.AsCurrency;
                        vValorCartao := vValorCartao + qryRecebimentosvalorlancto.AsCurrency;

                      end;
                    end
                    else
                    begin
                      if not ({vJaPossuiPagamentCartaoAprovado and} (ecfpadrao.Estado = estVenda)) then
                      begin
                        FExcecao := true;
                        tefpadrao.CancelarTransacoesPendentes;
                        result := false;
                        vJaPossuiPagamentCartaoAprovado := false;
                      end;

                      break;
                    end;

                  end;
                end;

                if result or qryRecebimentosTempok.AsBoolean then
                  qryRecebimentosTemp.Next

              end;
            finally
              qryRecebimentosTemp.AfterScroll := qryRecebimentosTempAfterScroll;
            end;

            if result then
            begin
              if (tefpadrao.RespostasPendentes.Count > 0) and
                 (vValorPagtoConfirmado = ValorAReceber) then
               begin
                 tefpadrao.FinalizarCupom(true);
                 tefpadrao.ImprimirTransacoesPendentes;
               end;

              if (tefpadrao.RespostasPendentes.Count <= 0) then
              begin
                FCupomTotalizado := true;
                FSituacaoCupom := scTotalizado;
                valortotalimpostoibt := 0;
                valortotalimpostofederal:=0;
                valortotalimpostoestadual:=0;
              end;

            {
            end
            else
            if not vJaPossuiPagamentCartaoAprovado  or
               (tefpadrao.RespostasPendentes.Count = 0) then
            begin
              if not FExcecao then
              begin
                qryrecebimentostemp.First;
                while not qryrecebimentostemp.eof do
                begin
                  if not qryrecebimentostemp.ReadOnly then
                  begin
                    qryRecebimentosTemp.Edit;
                    qryRecebimentosTempok.AsBoolean := false;
                    qryRecebimentosTemp.post;
                  end;
                  qryrecebimentostemp.next;
                end;
              end;
              }
            end;
          end
          else
            result := FecharCupomSemTEF;

          if result then
          begin
            qryrecebimentostemp.First;
            while not qryrecebimentostemp.eof do
            begin
              if not qryrecebimentostemp.ReadOnly then
              begin
                if qryRecebimentosTemptipo.AsString = 'D' then
                  IncluirRecebimentoDinheiro
                else
                if (qryRecebimentosTemptipo.AsString = 'H') and
                   ((qryRecebimentosTempvalorlancto.AsCurrency - vTotalValoresCheques) > 0) then
                  IncluirRecebimentoCheque(false)
              end;

              qryrecebimentostemp.next;
            end;

            result :=  FinalizaVenda(ComTef);

          end;

          if comtef and not result then
          begin
            if vJaPossuiPagamentCartaoAprovado and FExcecao then
            begin
              tefpadrao.ComandarECF( opeCancelaCupom );
              MensagemErro('Ocorreu um erro na gravação do cupom fiscal. Cancele as transações de cartões na sequencia.');
              try
                qryRecebimentosTemp.AfterScroll := nil;
                qryrecebimentostemp.first;
                while not qryrecebimentostemp.eof do
                begin
                  if qryRecebimentostemptef.AsString <> '' then
                    tefpadrao.CNC(qryRecebimentostempnomeredensu.asstring,
                                  qryRecebimentostemptef.AsString,
                                  strtodatetime(qryRecebimentostempdata.AsString + ' ' +qryRecebimentostemphora.AsString),
                                  qryRecebimentosTempvalorlancto.AsCurrency);

                    qryrecebimentostemp.Next
                end;
              finally
                qryRecebimentosTemp.AfterScroll := qryRecebimentosTempAfterScroll;
              end;
            end;
          end;
        end;


      except
        on E: Exception do
        begin
          HandleExcecao(E);
          result := false;
        end;
      end;
    finally
      if not result then
        RecalcularValoresVariaveis;
      FGravandoRecebimentos := False;
    end;
  end;
end;

procedure TdtmFrenteCaixa.dsrRecebimentosTempDataChange(Sender: TObject;
  Field: TField);
begin
  inherited;
  if field = qryrecebimentostemptiporecebimento then
  begin
    if qryTiposRecebimentos.Locate('codigo', qryrecebimentostemptiporecebimento.asinteger, []) then
    begin
      {
      if vJaPossuiPagamentCartaoAprovado and
         ((qryTiposRecebimentostiporecebimento.asstring = 'D') or
          (qryTiposRecebimentostiporecebimento.asstring = 'H')) then
      begin
        MensagemAviso('Opções em dinheiro e cheque não podem ser selecionadas após a existência de um pagamento TEF aprovado');
        qryrecebimentostemptiporecebimento.asinteger := qryrecebimentostemptiporecebimentoanterior.asinteger;
      end
      else
      begin
      }

        qryRecebimentosTemptipotiporecebimento.asstring := qryTiposRecebimentostiporecebimento.asstring;
        qryRecebimentosTempdescricaoagente.asstring := qryTiposRecebimentosdescricaoagente.asstring;
        qryRecebimentosTempnumerorecebimentos.AsInteger := qryTiposRecebimentosnumerorecebimentos.asinteger;

        if (qryRecebimentosTemptipotiporecebimento.asstring = 'C') or
           (qryRecebimentosTemptipotiporecebimento.asstring = 'B') then
          ExisteRecebimentoDebCred := true;

          {
        if vTEFJaIniciado  and
           ((qryTiposRecebimentostiporecebimento.asstring = 'D') or
            (qryTiposRecebimentostiporecebimento.asstring = 'H')) then
        begin
            tefpadrao.ComandarECF( opeCancelaCupom );
        end;
          }
      // end;
    end;
    qryRecebimentosTemptiporecebimentoanterior.asinteger := qryrecebimentostemptiporecebimento.asinteger;
  end
  else
  if field = qryRecebimentosTempok then
  begin
    qryRecebimentosTemp.readonly := (qryRecebimentosTemptef.asstring<>'');
    qryRecebimentosTemptiporec.readonly := (qryChequesIncluidosnumero.AsString<>'')
  end;

end;

procedure TdtmFrenteCaixa.qryRecebimentosTempAfterPost(DataSet: TDataSet);
begin
  inherited;

  if not qryRecebimentosTemp.isempty
    and (qryRecebimentosTemptipotiporecebimento.isnull or
         (qryRecebimentosTempvalorlancto.AsCurrency = 0)) then
    qryRecebimentosTemp.delete;

  if not FGravandoRecebimentos then
  begin
    FTotalRecebimentos := 0;
    GuardarRegistroAtual(qryRecebimentosTemp,true);
    qryRecebimentosTemp.First;
    ExisteRecebimentoDebCred := false;
    while not qryRecebimentosTemp.Eof do
    begin
      FTotalRecebimentos := FTotalRecebimentos + qryRecebimentosTempvalorlancto.AsCurrency;
      if (qryRecebimentosTemptipotiporecebimento.asstring = 'C') or
         (qryRecebimentosTemptipotiporecebimento.asstring = 'B') then
        ExisteRecebimentoDebCred := true;
      qryRecebimentosTemp.Next;
    end;
    VoltarRegistroAtual(qryRecebimentosTemp);

    FSaldoRestante := FTotalPagar-ValorDesconto+ValorAcrescimo-ValorTotalDescontoItem - FTotalRecebimentos;
    CalcularSaldoCheques;

{    if Assigned(AfterPostRecebimentos) then
      AfterPostRecebimentos(qryRecebimentosTemp);}

    AfterAlteracaoValores(nil);


  end;

end;

