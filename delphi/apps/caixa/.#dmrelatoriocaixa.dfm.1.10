  object qryConsultaCaixas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';select * from'
      '('
      'select distinct a.caixa as codigo,'
      '                      (select u.nome'
      '                       from usuarios u'
      '                       where u.codigo = a.caixa) as nome,'
      '                      (select u.inativo'
      '                       from usuarios u'
      '                       where u.codigo = a.caixa) as inativo'
      ''
      'from autenticacoes a'
      ') as autenticacoes'
      'order by UPPER(TO_ASCII(nome,'#39'LATIN1'#39'));')
    RequestLive = False
    Left = 112
    Top = 192
  end
