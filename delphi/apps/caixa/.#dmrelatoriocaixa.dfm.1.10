  object qryCaixas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      
        'select u.codigo, u.nome, u.turno, (select t.descricao from turno' +
        's t where t.codigo = u.turno) as descricaoturno'
      'from'
      '('
      'select distinct a.caixa as codigo'
      'from autenticacoes a'
      ') as autenticacoes'
      '     join usuarios u'
      '     on autenticacoes.codigo = u.codigo'
      ''
      'where u.codigo = :codigo'
      ''
      'order by UPPER(TO_ASCII(u.nome,'#39'LATIN1'#39'));')
    RequestLive = False
    Left = 40
    Top = 192
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end>
  end
  object qryFrenteCaixa: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryFrenteCaixaCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select *'
      '/*'
      #9'case when tipo = '#39'DN'#39' then '#39'DINHEIRO'#39
      '                when tipo = '#39'CH'#39' then '#39'CHEQUE'#39
      '                when tipo = '#39'MD'#39' then '#39'MASTERCARD D'#201'BITO'#39
      '                when tipo = '#39'MC'#39' then '#39'MASTERCARD CR'#201'DITO'#39
      '                when tipo = '#39'VD'#39' then '#39'VISA D'#201'BITO'#39
      '                when tipo = '#39'VC'#39' then '#39'VISA CR'#201'DITO'#39
      '                when tipo = '#39'TF'#39' then '#39'TEF'#39
      '        end as descricaotipo'
      '*/'
      'from frentedecaixaautenticacoes'
      'where autenticacao = :autenticacao'
      'order by codigo')
    RequestLive = True
    Left = 144
    Top = 128
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'autenticacao'
        ParamType = ptUnknown
      end>
    object qryFrenteCaixacodigo: TIntegerField
      FieldName = 'codigo'
    end
    object qryFrenteCaixaautenticacao: TIntegerField
      FieldName = 'autenticacao'
    end
    object qryFrenteCaixavalor: TFloatField
      FieldName = 'valor'
    end
    object qryFrenteCaixatipo: TStringField
      FieldName = 'tipo'
      Size = 2
    end
    object qryFrenteCaixadescricaotipo: TStringField
      FieldKind = fkCalculated
      FieldName = 'descricaotipo'
      Calculated = True
    end
  end
