        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WHEREAUTENTICACOES'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';SELECT * FROM ('
      'SELECT DISTINCT a.numero,'
      '       a.data,'
      '       a.filial,'
      
        '       (select f.nome from filiais f where f.codigo = a.filial) ' +
        'as nomefilial,'
      '       a.caixa,'
      
        '       (select u.nome from usuarios u where a.caixa=u.codigo) as' +
        ' nomecaixa,'
      '       a.autenticacao,'
      '       a.banco,'
      '       b.nome as nomebanco,'
      '       a.cheque,'
      '       c.vencto as venctocheque,'
      '       a.contrato,'
      '       coalesce(ct.tipocliente, c.tipocliente) as tipocliente,'
      '       coalesce(ct.cliente, c.cliente) as cliente,'
      '       a.datadocumento,'
      '       a.evento,'
      '       e.descricao as descricaoevento,'
      '       a.historico,'
      '       cast(a.hora as varchar),'
      '       a.motivo,'
      '       m.descricao as descricaomotivo,'
      '       a.nota,'
      '       a.parametros,'
      '       a.contratoparcela,'
      '       a.parcela,'
      '       dp.fornecedor,'
      '       dp.tipofornecedor,'
      '       a.saldo,'
      '       a.situacao,'
      '       case when a.tipo = '#39'P'#39' then '#39'PRESTACOES'#39
      '               when a.tipo = '#39'D'#39' then '#39'DOCUMENTOS'#39
      '               when a.tipo = '#39'N'#39' then '#39'DEVOLUCOES DE VENDA'#39
      '               when a.tipo = '#39'A'#39' then '#39'DEVOLUCOES DE SALDO'#39
      '               when a.tipo = '#39'B'#39' then '#39'DEPOSITOS'#39
      '               when a.tipo = '#39'C'#39' then '#39'CANCELAMENTOS'#39
      '               when a.tipo = '#39'H'#39' then '#39'CHEQUES'#39
      '               when a.tipo = '#39'S'#39' then '#39'TRANSFERENCIAS DE SAIDA'#39
      
        '               when a.tipo = '#39'E'#39' then '#39'TRANSFERENCIAS DE ENTRADA' +
        #39
      '               when a.tipo = '#39'J'#39' then '#39'PERDAS'#39
      '               when a.tipo = '#39'R'#39' then '#39'RESGATES DE CHEQUES'#39
      '               when a.tipo = '#39'G'#39' then '#39'DUPLICATAS'#39
      '               when a.tipo = '#39'T'#39' then'
      
        '                    case when tr.descricao ilike '#39'%PIX%'#39'  then '#39 +
        'PIX'#39
      '                         else '#39'CARTOES'#39
      '                    end'
      '                   /*case when coalesce((select true'
      '                              from recebimentos r'
      '                                   join tiposrecebimentos tr'
      
        '                                   on r.tiporecebimento = tr.cod' +
        'igo'
      '                              where a.transacao = r.transacao'
      
        '                                AND position('#39'PIX'#39' IN tr.descric' +
        'ao)<>0 ),false) then '#39'PIX'#39
      '                   else '#39'CARTOES'#39
      '                   end*/'
      '               when a.tipo = '#39'F'#39' then '#39'FRENTE DE CAIXA'#39
      '       end as descricaotipo,'
      '       a.transferencia,'
      '       a.entradapendente,'
      '       a.confirmacao,'
      
        '       case when a.tipo='#39'T'#39' then r.valorvencto ELSE a.valor end ' +
        'AS valor,'
      '       p.valorvencto as valorvenctoparcela,'
      '       a.documentopag,'
      '       a.numeroduplicata,'
      '       a.venctoduplicata,'
      '       a.cliente as clientedev,'
      '       a.tipocliente as tipoclientedev,'
      
        '       (select coalesce(vf.razao,vf.nome) as nome from vforneced' +
        'ores vf where vf.codigo = a.cliente and vf.tipo = a.tipocliente)' +
        ' as nomeclientedev,'
      
        '         cast(case when a.tipo = '#39'P'#39' then CAST (ct.tipocliente a' +
        's varchar)||cast (ct.cliente as varchar)||'#39' '#39'||cast (parcela as ' +
        'varchar)||'#39' '#39'||cast(p.valorvencto as varchar)||'#39' '#39'||cast((a.valo' +
        'r - p.valorvencto)as varchar)'
      
        '         when a.tipo = '#39'N'#39' then coalesce(cast (ct.tipocliente as' +
        ' varchar), cast(c.tipocliente as varchar))||coalesce(cast(ct.cli' +
        'ente as varchar),cast(c.cliente as varchar))||'#39' '#39'||cast (a.motiv' +
        'o as varchar)||'#39' '#39'||m.descricao'
      
        '         when a.tipo = '#39'A'#39' then cast (a.tipocliente as varchar)|' +
        '|cast (a.cliente as varchar)||'#39' '#39'||(select coalesce(vf.razao,vf.' +
        'nome) as nome from vfornecedores vf where vf.codigo = a.cliente ' +
        'and vf.tipo = a.tipocliente)'
      '         when a.tipo = '#39'B'#39' then b.nome'
      
        '         when a.tipo = '#39'C'#39' then cast (a.autenticacao as varchar)' +
        '||'#39' '#39'||cast (a.motivo as varchar)||'#39' '#39'||m.descricao'
      
        '         when a.tipo = '#39'H'#39' then cast(c.tipocliente as varchar)||' +
        'cast (c.cliente as varchar)||'#39' '#39'||substr(a.cheque,12,6)||'#39' '#39'||su' +
        'bstr(a.cheque,4,4)||'#39' '#39'||substr(a.cheque,1,3)||'#39' '#39'||cast (c.venc' +
        'to as varchar)'
      
        '         when a.tipo = '#39'S'#39' then cast(a.transferencia as varchar)' +
        '||'#39' '#39'||(select u.nome from usuarios u where u.codigo = a.transfe' +
        'rencia)'
      
        '         when a.tipo = '#39'E'#39' then cast (a.caixa as varchar)||'#39' '#39'||' +
        '(select u.nome from usuarios u where a.caixa=u.codigo)'
      
        '         when a.tipo = '#39'J'#39' then coalesce(ct.tipocliente, c.tipoc' +
        'liente)||'#39' '#39'||coalesce(cast(ct.cliente as varchar), cast(c.clien' +
        'te as varchar))||'#39' '#39'||cast(a.motivo as varchar)||'#39' '#39'||m.descrica' +
        'o'
      
        '         when a.tipo = '#39'R'#39' then cast(c.tipocliente as varchar)||' +
        'cast(c.cliente as varchar)||'#39' '#39'||substr(a.cheque,12,6)||'#39' '#39'||sub' +
        'str(a.cheque,4,4)||'#39' '#39'||substr(a.cheque,1,3)||'#39' '#39'||cast (c.venct' +
        'o as varchar)'
      
        '         when a.tipo = '#39'G'#39' then cast (dp.tipofornecedor as varch' +
        'ar)||'#39' '#39'||cast(dp.fornecedor as varchar)||'#39' '#39'||cast(a.documentop' +
        'ag as varchar)||'#39' '#39'||cast(a.numeroduplicata as  varchar)||'#39' '#39'||c' +
        'ast (a.venctoduplicata as varchar)'
      '       end as varchar) as referencia,'
      '       case when a.tipo in ('#39'P'#39','#39'E'#39','#39'R'#39','#39'F'#39') or'
      
        '                       (a.tipo = '#39'D'#39' and a.saldo > (select a1.sa' +
        'ldo'
      
        '                                                              fr' +
        'om autenticacoes a1'
      
        '                                                              wh' +
        'ere a1.numero<a.numero'
      
        '                                                              an' +
        'd a1.caixa=a.caixa'
      
        '                                                              an' +
        'd a1.filial=a.filial'
      
        '                                                              or' +
        'der by a1.data desc, a1.hora desc limit 1)) then cast('#39'Entradas'#39 +
        ' as varchar)'
      '               when a.tipo in ('#39'N'#39','#39'A'#39','#39'B'#39','#39'H'#39','#39'S'#39','#39'G'#39') or'
      
        '                       (a.tipo =  '#39'D'#39' and a.saldo < (select a1.s' +
        'aldo'
      
        '                                                               f' +
        'rom autenticacoes a1'
      
        '                                                               w' +
        'here a1.numero<a.numero'
      
        '                                                               a' +
        'nd a1.caixa=a.caixa'
      
        '                                                               a' +
        'nd a1.filial=a.filial'
      
        '                                                               o' +
        'rder by a1.data desc, a1.hora desc limit 1)) then cast('#39'Saidas'#39' ' +
        'as varchar)'
      '               else cast('#39'X'#39' as varchar)'
      '       end as entradasaida,'
      '       a.tipo,'
      '       case when a.tipo = '#39'P'#39' then '#39'PREST.'#39
      '               when a.tipo = '#39'D'#39' then '#39'DOC.'#39
      '               when a.tipo = '#39'N'#39' then '#39'DEV. V.'#39
      '               when a.tipo = '#39'A'#39' then '#39'DEV. S.'#39
      '               when a.tipo = '#39'B'#39' then '#39'DEPTO'#39
      '               when a.tipo = '#39'C'#39' then '#39'CANC.'#39
      '               when a.tipo = '#39'H'#39' then '#39'CHQ.'#39
      '               when a.tipo = '#39'S'#39' then '#39'TRANS.'#39
      '               when a.tipo = '#39'E'#39' then '#39'TRANS.'#39
      '               when a.tipo = '#39'J'#39' then '#39'PERDAS'#39
      '               when a.tipo = '#39'R'#39' then '#39'RES. CHQ.'#39
      '               when a.tipo = '#39'G'#39' then '#39'DUPL.'#39
      '               when a.tipo = '#39'T'#39' then '
      ''
      
        '                   case when tr.descricao ilike '#39'%PIX%'#39' then '#39'PI' +
        'X'#39
      '                   else '#39'CART.'#39
      '                   end'
      ''
      '               when a.tipo = '#39'F'#39' then '#39'FR. CX.'#39
      '       end as tiporeduzido,'
      '       (SELECT  a1.saldo'
      '        FROM autenticacoes a1'
      '        WHERE a1.numero = (SELECT a2.numero'
      '                            FROM autenticacoes a2'
      '                            WHERE a2.filial = a.filial'
      '                            AND a2.caixa = a.caixa'
      '                            AND a2.data < :datainicial'
      '                            AND a2.situacao'
      
        '                            ORDER BY data_hora_tz(a2.data,a2.hor' +
        'a) desc limit 1)) as saldoinicial,'
      '       (select a1.saldo'
      '        from autenticacoes a1'
      '        where a1.numero = (select a2.numero'
      '                                         from autenticacoes a2'
      
        '                                         where a2.filial = a.fil' +
        'ial'
      
        '                                             and a2.caixa = a.ca' +
        'ixa'
      
        '                                             and a2.data <= :dat' +
        'afinal'
      '                                             and a2.situacao'
      
        '                                             ORDER BY data_hora_' +
        'tz(a2.data,a2.hora) DESC LIMIT 1)) as saldofinal'
      
        'FROM ((((((((autenticacoes a LEFT JOIN bancos b ON a.banco=b.cod' +
        'igo)'
      #9#9'LEFT JOIN motivos m ON a.motivo=m.codigo)'
      
        #9#9'LEFT JOIN contratos ct ON coalesce(a.contratoparcela,a.contrat' +
        'o)=ct.numero)'
      
        #9#9'LEFT JOIN parcelas p on a.contratoparcela=p.contrato and a.par' +
        'cela=p.numero)'
      
        #9#9'LEFT JOIN (cheques c LEFT JOIN vfornecedores vf on c.cliente=v' +
        'f.codigo and tipocliente=vf.tipo) ON a.cheque=c.numero)'
      
        '                LEFT JOIN (recebimentos r join tiposrecebimentos' +
        ' tr on (r.tiporecebimento=tr.codigo and tr.tiporecebimento<>'D')) on a.transacao=r.transacao)'
      #9#9'LEFT JOIN eventos e ON a.evento=e.codigo)'
      #9#9'LEFT JOIN documentospag dp on a.documentopag=dp.numero)'
      'WHERE a.data between  :datainicial and :datafinal'
      '  and a.situacao'
      '%WHEREFILIAIS'
      '%WHERECAIXAS'
      '%WHEREEVENTOS'
      '%WHEREAUTENTICACOES'
      ') AS Relatorio'
      'ORDER BY UPPER(TO_ASCII(nomefilial,'#39'LATIN1'#39')), Filial,'
      
        '         UPPER(TO_ASCII(nomecaixa,'#39'LATIN1'#39')),  Caixa, EntradaSai' +
        'da,tiporeduzido desc, Data, hora,'
      '         UPPER(TO_ASCII(descricaotipo,'#39'LATIN1'#39')), Numero')
    RequestLive = False
    Left = 144
    Top = 16
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
