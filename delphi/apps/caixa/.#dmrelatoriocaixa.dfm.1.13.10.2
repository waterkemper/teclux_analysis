  object qryImprimirRelatorio: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterScroll = qryImprimirRelatorioAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WHEREFILIAIS'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WHERECAIXAS'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
