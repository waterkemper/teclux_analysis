    Macros = <>
    Sql.Strings = (
      ';'
      
        'select u.codigo, u.nome, u.turno, (select t.descricao from turno' +
        's t where t.codigo = u.turno) as descricaoturno'
      'from'
      '('
      'select distinct a.caixa as codigo'
      'from autenticacoes a'
      ') as autenticacoes'
      '     join usuarios u'
      '     on autenticacoes.codigo = u.codigo'
      ''
      'where u.codigo = :codigo'
      ''
      'order by UPPER(TO_ASCII(u.nome,'#39'LATIN1'#39'));')
