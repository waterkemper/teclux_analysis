function TfrmAutenticacoesCaixa.dadosCompletosParaAutenticarDevolucao: boolean;
var
  Str: String;
begin
  result := false;
  if ActiveControl = edfCodigoContratoDevolucoes then begin
    if not edfCodigoContratoDevolucoes.Exist then begin
      edfCodigoContratoDevolucoes.SetFocus;
      if edfCodigoContratoDevolucoes.Text <> '' then
        Exit;
    end;
  end else if ActiveControl = edfCodigoMotivoDevolucoes then begin
    if not edfCodigoMotivoDevolucoes.Exist then begin
      Str := edfCodigoMotivoDevolucoes.Text;
      edfCodigoMotivoDevolucoes.Text := '';
      edfCodigoMotivoDevolucoes.SetFocus;
      if Str <> '' then
        Exit;
    end
  end;
  if (edfCodigoMotivoDevolucoes.Text = '') then begin
    MensagemAviso(Format(ctCAMPODEVESERPREENCHIDO, ['Motivo']));
    edfCodigoMotivoDevolucoes.SetFocus;
  end else
    result := true;
end;

function TfrmAutenticacoesCaixa.dadosCompletosParaAutenticarCancelamento: boolean;
var
  Str: String;
begin
  result := false;
  if dtmautenticacoes.NumeroAutenticacaoParaCancelar <= 0 then
    Exit
  else if ActiveControl = edfCodigoMotivoCancelamento then
    if not edfCodigoMotivoCancelamento.Exist then begin
      Str := edfCodigoMotivoCancelamento.Text;
      edfCodigoMotivoCancelamento.Text := '';
      edfCodigoMotivoCancelamento.SetFocus;
      if Str <> '' then
        Exit
  end;
  if (edfCodigoMotivoCancelamento.Text = '') then begin
    MensagemAviso(Format(ctCAMPODEVESERPREENCHIDO, ['Motivo']));
    edfCodigoMotivoCancelamento.SetFocus;
  end else
    result := true;
end;

function TfrmAutenticacoesCaixa.dadosCompletosParaAutenticarPerda: boolean;
var
  Str: String;
begin
  result := false;
  if ActiveControl = edfCodigoContratoPerdas then begin
    if not edfCodigoContratoPerdas.Exist then begin
      edfCodigoContratoPerdas.SetFocus;
      if edfCodigoContratoPerdas.Text <> '' then
        Exit;
    end;
  end else begin
    if ActiveControl = edfCodigoMotivoPerda then begin
      if not edfCodigoMotivoPerda.Exist then begin
        Str := edfCodigoMotivoPerda.Text;
        edfCodigoMotivoPerda.Text := '';
        edfCodigoMotivoPerda.SetFocus;
        if Str <> '' then
          Exit;
      end;
    end;
  end;
  if (edfCodigoMotivoPerda.Text = '') then begin
    MensagemAviso(Format(ctCAMPODEVESERPREENCHIDO, ['Motivo']));
    edfCodigoMotivoPerda.SetFocus;
  end else if edfCodigoContratoPerdas.Text = '' then begin
    MensagemAviso(ctCONTRATONAOINFORMADO);
    edfCodigoContratoPerdas.SetFocus;
  end else
    result := true;
end;

