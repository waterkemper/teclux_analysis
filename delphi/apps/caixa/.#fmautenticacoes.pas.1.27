{$R *.dfm}

constructor TfrmAutenticacoesCaixa.Create(AOwner: TComponent);
begin
//try
  inherited  Create(AOwner);
  {
  if not ParSistema.AutenticacaoParcelasModo2 then
  begin
    tstParcelasAberto.TabVisible := False;
    totalAutenticado := 0;
    PrestacaoEmAndamento := false;
    lblTotalAutenticadoValor.Caption := FloatToStrF(TotalAutenticado, ffFixed, 18,2);
    sbnImprimirCheque.Enabled := Assigned(ImpChequePadrao);
    if not ParSistema.ClienteComDependentes then
    begin
      dbgContratosPrestacoes.Columns[4].Visible := False;
      dbgContratosPrestacoes.Columns[2].Width:=75;
    end;
    edtNumeroParcela.ReadOnly := not ParSistema.InformarParcelaQuitar;

    tstPrestacoes.PageIndex     := 0;
    tstParcelasAberto.PageIndex := 11;
    pgcAutenticacoes.ActivePageIndex := 0;

  end
  else
  }
  begin
    tstParcelasAberto.Caption   := tstPrestacoes.Caption;
    tstPrestacoes.PageIndex     := 11;
    tstParcelasAberto.PageIndex := 0;
    pgcAutenticacoes.ActivePageIndex := 0;
    tstPrestacoes.TabVisible    := False;

    if ParSistema.MostrarValorContrato then
       gbxTotalContrato.Visible:= True;
    pgcAutenticacoesChange(nil);
  end;

  fraConsultaContas.TipoPesquisa       := pesCONTAS;
  fraConsultaEventoDeposito.TipoPesquisa := pesEvento;
  fraConsultaEventoDeposito.edfcodigo.text := parsistema.EVENTOPARADEPOSITOSAUTENTICACOES;
  fraConsultaEventoDeposito.edfcodigo.exist;

  dbgParcelasAberto.ordenacao := 'datavencto,contrato,parcelaorigem';
//except
//  on e:exception do ShowMessage(e.message);
//end;
  DBAdvGrid1.Bands.SecondaryColor := TColorRef(strtoint(parsistema.CorZebradoRelatorio));



end;

procedure TfrmAutenticacoesCaixa.CriarDataModulo;
begin
  inherited;
  dtmautenticacoes := Tdtmautenticacoes.Create(Self);
  dtmautenticacoes.OnScrollHistoricosEvento := AfterScrollHistoricosEvento;
  dtmautenticacoes.AbrirTabelaPrestacoes;
end;

destructor TfrmAutenticacoesCaixa.Destroy;
begin
  if Assigned(OntecClose) then
    OntecClose;
  DBAdvGrid1.free;
  AdvGridFindDialog1.free;  
  inherited;
  frmAutenticacoesCaixa := nil;
end;

procedure TfrmAutenticacoesCaixa.edfCodigoClienteContratoPrestacoesFound(Found: Boolean);
begin
  if Found then begin
    TotalAutenticado := 0;
    dtmautenticacoes.PagamentoEmDinheiro := 0;
    lblTotalAutenticadoValor.Caption := FormatarValor(0,2);
    dtmautenticacoes.RefazConsultaContrato;
    PrestacaoEmAndamento := False;
    if not ParSistema.InformarParcelaQuitar then
      edtNumeroParcela.Text := IntToStr(dtmautenticacoes.NumeroPrestacaoPaga);
  end else
    dtmautenticacoes.RefazConsultaContrato;
  pgcAutenticacoesChange(nil);
end;

procedure TfrmAutenticacoesCaixa.edfCodigoClienteContratoPrestacoesKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if (Key = VK_ESCAPE) and (Shift = []) and (edfCodigoClienteContratoPrestacoes.Text = '') then begin
    dtmautenticacoes.refazConsultaContrato;
    lblTotalAutenticadoValor.Caption := FormatarValor(0,2);
    edtNumeroParcela.Text := '';
  end;
end;

procedure TfrmAutenticacoesCaixa.edfCodigoClienteContratoPrestacoesMessage(var Msg: String);
begin
  inherited;
  Msg := Format(ctCONTRATONAOFATURADONOTA, [edfCodigoClienteContratoPrestacoes.Text]);
end;

function TfrmAutenticacoesCaixa.ExisteInformacao(Parametro: Integer; NomeCampo: string; Value: Variant): Boolean;
begin
  case tipoConsulta of
    paCONTRATOSPRESTACOES: if Parametro = 0 then
                             Result := dtmautenticacoes.ExisteCliente(NomeCampo,Value)
                           else
                             result := dtmautenticacoes.ExisteContrato(NomeCampo, Value);
    paCONTRATOSPERDAS    : if Parametro = 0 then
                             Result := dtmautenticacoes.ExisteCliente(NomeCampo,Value)
                           else
                             result := dtmautenticacoes.ExisteContratoPerda(NomeCampo, Value);
    paCONTRATOSDEVOLUCOES: if Parametro = 0 then
                             Result := dtmautenticacoes.ExisteCliente(NomeCampo,Value)
                           else
                             result := dtmautenticacoes.ExisteDevolucao(NomeCampo, Value);
    paMOTIVOSDEVOLUCAO,
    paMOTIVOSCANCELAMENTO,
    paMOTIVOSPERDA       : result := dtmautenticacoes.ExisteMotivo(NomeCampo, Value);
    paEVENTOS            : result := dtmautenticacoes.ExisteEvento(NomeCampo, Value);
//    paCHEQUES            : result := dtmautenticacoes.ExisteCheque(NomeCampo, Value);
    paCLIENTESCHEQUES,
    paCLIENTESDEVOLUCOES,
    paCLIENTEPARCELAS    : result := dtmautenticacoes.ExisteCliente(NomeCampo, Value);
    paFORNECEDORES       : result := dtmautenticacoes.ExisteFornecedor(NomeCampo, Value);
    paBANCOS             : result := dtmautenticacoes.ExisteBanco(NomeCampo, Value);
//    paAUTENTICACOES      : result := dtmautenticacoes.ExisteAutenticacao(NomeCampo, Value);
    paCAIXAS             : result := dtmautenticacoes.ExisteCaixa(NomeCampo, Value);
  else
    result := false
  end //end case
end;

function TfrmAutenticacoesCaixa.GetTitulo: string;
begin
  case tipoConsulta of
//    paCONTRATOSCHEQUES,
    paCONTRATOSPRESTACOES,
    paCONTRATOSDEVOLUCOES,
    paCONTRATOSPERDAS    : result := 'Contratos';
    paMOTIVOSDEVOLUCAO,
    paMOTIVOSCANCELAMENTO,
    paMOTIVOSPERDA       : result := 'Motivos';
    paEVENTOS            : result := 'Eventos';
//    paCHEQUES            : result := 'Cheques';
    paCLIENTESCHEQUES,
    paCLIENTESDEVOLUCOES,
    paCLIENTEPARCELAS    : result := 'Clientes';
    paFORNECEDORES       : result := 'Fornecedores';
    paBANCOS             : result := 'Bancos';
//    paAUTENTICACOES      : result := 'AutenticaÎ„es';
    paCAIXAS             : result := 'Caixas';
  else
    result := ''
  end //end case
end;

function TfrmAutenticacoesCaixa.InternoPesquisar(Titulo: String): Integer;
begin
  Result := mrNone;
  with dtmautenticacoes do begin
    if PermitirConsulta then begin
  //    if not ((tipoConsulta = paCLIENTESCHEQUES) or (tipoConsulta = paCHEQUES)) then
      AbreTabelasConsulta(TipoConsulta);
      Result := Inherited InternoPesquisar(GetTitulo);
      if Result = mrOK then begin
        Selecionar(TipoConsulta);
//        case TipoConsulta of
//          paCLIENTESCHEQUES :
//        end
      end;
      FechaTabelasConsulta(TipoConsulta)
    end;
  end;
end;

function TfrmAutenticacoesCaixa.JanelaPesquisa: TfrmConsultaBasica;
begin
  case tipoConsulta of
{    paAUTENTICACOES      : begin
                             Result := TfrmConsultaFitaDeCaixa.Create(Self);
                             TfrmConsultaFitaDeCaixa(Result).UsarParametrosDaTabela := False
                           end;}
    paCONTRATOSPRESTACOES,
    paCONTRATOSPERDAS,
    paCONTRATOSDEVOLUCOES: begin
                             Result := TfrmConsultaPorCampo.Create(nil);
                             TfrmConsultaPorCampo(Result).ConsultaInterativa     := False;
                             TfrmConsultaPorCampo(Result).UsarParametrosDaTabela := True;
                           end;
//    paCHEQUES,
    paFORNECEDORES,
    paCLIENTESCHEQUES,
    paCLIENTESDEVOLUCOES,
    paCLIENTEPARCELAS    : begin
                             Result := TfrmConsultaPorCampo.Create(nil);
                             TfrmConsultaPorCampo(Result).ConsultaInterativa     := False;
                             TfrmConsultaPorCampo(Result).UsarParametrosDaTabela := False;
                           end;
    paBANCOS,
    paMOTIVOSCANCELAMENTO,
    paCAIXAS,
    paEVENTOS            : begin
                             Result := TfrmConsultaPorCampo.Create(nil);
                             TfrmConsultaPorCampo(Result).ConsultaInterativa     := True;
                             TfrmConsultaPorCampo(Result).UsarParametrosDaTabela := False
                           end;
{    paBANCOS             : begin
                             Result := TfrmConsultaPorCampo.Create(nil);
                             TfrmConsultaPorCampo(Result).ConsultaInterativa     := True;
                             TfrmConsultaPorCampo(Result).UsarParametrosDaTabela := False
                           end;}
    else begin
      Result := TfrmConsultaPorCampo.Create(nil);
      TfrmConsultaPorCampo(Result).ConsultaInterativa     := True;
      TfrmConsultaPorCampo(Result).UsarParametrosDaTabela := True
    end
  end; //end case
  Jan := TfrmConsultaPorCampo(Result)
end;

function TfrmAutenticacoesCaixa.PermitirConsulta: boolean;
begin
  result := true;

  if CtrlOn then begin
    if ActiveControl = edfCodigoMotivoDevolucoes then
      tipoConsulta := paMOTIVOSDEVOLUCAO
    else if ActiveControl = edfCodigoMotivoCancelamento then
      tipoConsulta := paMOTIVOSCANCELAMENTO
    else if ActiveControl = edfCodigoMotivoPerda then
      tipoConsulta := paMOTIVOSPERDA
    else if ActiveControl = flkCodigoClienteCheques then
      tipoConsulta := paCLIENTESCHEQUES
    else if ActiveControl = edfCodigoClienteDevolucoesSaldo then
      tipoConsulta := paCLIENTESDEVOLUCOES
    else
      case pgcAutenticacoes.ActivePageIndex of
        0: {if not ParSistema.AutenticacaoParcelasModo2 then
             tipoConsulta := paCONTRATOSPRESTACOES
           else} tipoConsulta := paCLIENTEPARCELAS;
        2: tipoConsulta := paCONTRATOSDEVOLUCOES;
        3: tipoConsulta := paEVENTOS;
//        4: tipoConsulta := paAUTENTICACOES;
//        5: tipoConsulta := paCHEQUES;
        6: tipoConsulta := paCAIXAS;
        8: tipoConsulta := paCONTRATOSPERDAS;
        9: tipoConsulta := paFORNECEDORES;
       10: tipoConsulta := paBANCOS;
      else
        result := false
      end
  end else
    result := false
end;

procedure TfrmAutenticacoesCaixa.PosicionarTabelaNoParametro(Ind: Integer; var Continuar: Boolean);
begin
  inherited;
  continuar := dtmautenticacoes.PosicionarRegistro(tipoConsulta, Ind)
end;

procedure TfrmAutenticacoesCaixa.ProximoControle(Ind: Integer);
begin
  inherited;
  case tipoConsulta of
    paCONTRATOSPRESTACOES: if Ind = 0 then begin
                             Jan.ConsultaInterativa := True;
                             dtmautenticacoes.abreTabelasConsultaContrato;
                            end else
                              Jan.ConsultaInterativa := False;
    paCONTRATOSDEVOLUCOES: if Ind = 0 then begin
                             Jan.ConsultaInterativa := True;
                             dtmautenticacoes.abreTabelasConsultaDevoluccao;
                            end else
                              Jan.ConsultaInterativa := False;
    paCONTRATOSPERDAS:     if Ind = 0 then begin
                             Jan.ConsultaInterativa := True;
                             dtmautenticacoes.abreTabelasConsultaPerdas;
                            end else
                              Jan.ConsultaInterativa := False;
  end
end;

function TfrmAutenticacoesCaixa.TabelaDePesquisa: TZDataSet;
begin
  case tipoConsulta of
    paCONTRATOSPRESTACOES: result := dtmautenticacoes.ConsultarContrato;
    paCONTRATOSPERDAS    : result := dtmautenticacoes.ConsultarContratoPerda;
    paCONTRATOSDEVOLUCOES: result := dtmautenticacoes.ConsultarDevolucao;
    paMOTIVOSDEVOLUCAO,
    paMOTIVOSCANCELAMENTO,
    paMOTIVOSPERDA       : result := dtmautenticacoes.ConsultarMotivo;
    paEVENTOS            : result := dtmautenticacoes.ConsultarEvento;
//    paCHEQUES            : result := dtmautenticacoes.ConsultarCheque;
    paCLIENTESCHEQUES,
    paCLIENTESDEVOLUCOES,
    paCLIENTEPARCELAS    : result := dtmautenticacoes.ConsultarCliente;
    paFORNECEDORES       : result := dtmautenticacoes.ConsultarFornecedor;
    paBANCOS             : result := dtmautenticacoes.ConsultarBanco;
//    paAUTENTICACOES      : result := dtmautenticacoes.ConsultarAutenticacao;
    paCAIXAS             : result := dtmautenticacoes.ConsultarCaixa;
  else
    result := nil
  end //end case
end;

function TfrmAutenticacoesCaixa.TabelaDoParametro(Parametro: Integer): TZDataSet;
begin
  with dtmautenticacoes do begin
    case tipoConsulta of
      paCONTRATOSPRESTACOES: result := ConsultarCliente;
      paCONTRATOSPERDAS    : result := ConsultarCliente;
      paCONTRATOSDEVOLUCOES: Result := ConsultarCliente;
      paMOTIVOSDEVOLUCAO,
      paMOTIVOSCANCELAMENTO,
      paMOTIVOSPERDA       : result := ConsultarMotivo;
      paEVENTOS            : result := ConsultarEvento;
//      paCHEQUES            : result := ConsultarCheque;
      paCLIENTESCHEQUES,
      paCLIENTESDEVOLUCOES,
      paCLIENTEPARCELAS    : result := ConsultarCliente;
      paFORNECEDORES       : result := ConsultarFornecedor;
      paBANCOS             : result := ConsultarBanco;
//      paAUTENTICACOES      : result := ConsultarAutenticacao;
      paCAIXAS             : result := ConsultarCaixa;
    else
      result := nil
    end //end case
  end
end;

procedure TfrmAutenticacoesCaixa.edfCodigoEventosFound(Found: Boolean);
begin
  inherited;
  if found then begin
    with dtmautenticacoes do begin
      ReFazConsulta(dtmautenticacoes.TabelaHistoricosEvento,[0],[CodigoEvento]);
      edtDataDocumento.Text := DateToStr(DataServidor);
      if NroRegistrosHistoricosEvento > 0 then
        MontaParametros;
    end;
  end;
end;

procedure TfrmAutenticacoesCaixa.edfCodigoEventosKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if Key = VK_ESCAPE then begin
    if edfCodigoEventos.Text = '' then begin
      dtmautenticacoes.refazConsulta(dtmautenticacoes.TabelaHistoricosEvento,[0],[0]);
      edtDataDocumento.Text := '';
      edtValorDocumento.Text := '';
      MontaParametros;
    end
  end
end;

procedure TfrmAutenticacoesCaixa.pgcAutenticacoesChange(Sender: TObject);
begin
  inherited;
  case pgcAutenticacoes.ActivePageIndex of
    0: begin
         begin
           dtmautenticacoes.AbrirTabelaParcelasAberto;
           if dtmautenticacoes.CodigoClienteParcelasAberto <> dtmautenticacoes.CodigoCliente then
             dtmautenticacoes.reFazConsultaClientes(paCLIENTEPARCELAS);
           if dtmautenticacoes.TipoCliente[paCLIENTEPARCELAS] = tcCLIENTE then
             pgcDados.ActivePage := tstDadosCliente
           else if dtmautenticacoes.TipoCliente[paCLIENTEPARCELAS] = tcFORNECEDOR then
             pgcDados.ActivePage := tstDadosFornecedor;
           edfCodigoClienteParcelasAberto.Enabled:= True;
           if dtmautenticacoes.CodigoClienteParcelasAberto > 0 then
             pgcDados.Visible := true;
           if not (dtmautenticacoes.CodigoClienteParcelasAberto > 0) then
           begin
             edtTotalMarcados.Text := FloatToStrF(dtmautenticacoes.TotalMarcados,ffFixed,18,2);
             edtTotalValor.Text := FloatToStrF(dtmautenticacoes.TotalMarcados,ffFixed,18,2);
             edtQtdeMarcados.Text := '0';
             edtQtdeTotal.Text := '0';
           end;
         end;
         sbnRecibo.Enabled:= true;
       end;

    1: begin
         fraCMC7Cheque.LimparCampos;
         DesabilitarCamposCheque;
         fraCMC7Cheque.edtCMC7.SetFocus;
         gbxCheques.Enabled:= False;
         pgcDados.Visible:= False;
         pgcAutenticacoes.Height := 575;
         dtmautenticacoes.AbrirTabelaCheque;
       end;

    2: begin
         dtmautenticacoes.AbrirTabelasDevolucoes;
         pgcDados.Visible := (dtmautenticacoes.CodigoClienteDevolucoes > 0) or (dtmautenticacoes.CodigoClienteDevolucoesSaldo > 0);
         if dtmautenticacoes.CodigoClienteDevolucoes <> dtmautenticacoes.CodigoCliente then
           dtmautenticacoes.reFazConsultaClientes(paCONTRATOSDEVOLUCOES)
         else if dtmautenticacoes.CodigoClienteDevolucoesSaldo <> dtmautenticacoes.CodigoCliente then
           dtmautenticacoes.reFazConsultaClientes(paCLIENTESDEVOLUCOES);
         if (dtmautenticacoes.TipoCliente[paCONTRATOSDEVOLUCOES] = tcCLIENTE) or
            (dtmautenticacoes.TipoCliente[paCLIENTESDEVOLUCOES] = tcCLIENTE) then
           pgcDados.ActivePage := tstDadosCliente
         else
           pgcDados.ActivePage := tstDadosFornecedor;
         edfCodigoContratoDevolucoes.Enabled:= True;
         if (edfCodigoContratoDevolucoes.Text = '') and
            edfCodigoContratoDevolucoes.CanFocus then
           edfCodigoContratoDevolucoes.SetFocus
       end;

    3: begin
         pgcDados.Visible    := True;
         dtmautenticacoes.AbrirTabelaEvento;
         pgcDados.ActivePage := tstParametrosDocumento;
         edfCodigoEventos.Enabled:= True;
         if edfCodigoEventos.CanFocus then
           edfCodigoEventos.SetFocus
       end;

    4: begin
         pgcDados.Visible    := False;
         pgcAutenticacoes.Height := 535;
         dtmautenticacoes.AbrirTabelasCancelamento;
         if edfCodigoMotivoCancelamento.CanFocus then
           edfCodigoMotivoCancelamento.SetFocus
       end;

    5: begin
         pgcDados.Visible:= False;
         pgcAutenticacoes.Height := 535;
         fraCMC7Resgate.LimparCampos;
         fraCMC7Resgate.edtCMC7.SetFocus;
       end;

    6: begin
         pgcDados.Visible    := False;
         dtmautenticacoes.AbrirTabelaTransferencia;
         if edfCodigoCaixa.CanFocus then
           edfCodigoCaixa.SetFocus;
         dtmautenticacoes.ReFazConsultaCaixa
       end;

    7: begin
         pgcDados.Visible    := False;
         dtmautenticacoes.ReFazConsultaTransferenciaPendente;
         dbgTransferenciasPendentes.SetFocus
       end;
    8: begin
         dtmautenticacoes.AbrirTabelasPerda;
         pgcDados.Visible := dtmautenticacoes.CodigoClientePerdas > 0;
         if dtmautenticacoes.CodigoClientePerdas <> dtmautenticacoes.CodigoCliente then
           dtmautenticacoes.reFazConsultaClientes(paCONTRATOSPERDAS);
         if dtmautenticacoes.TipoCliente[paCONTRATOSPERDAS] = tcCLIENTE then
           pgcDados.ActivePage := tstDadosCliente
         else
           pgcDados.ActivePage := tstDadosFornecedor;
       end;
    9: begin
         dtmautenticacoes.AbrirTabelaFornecedores;
         pgcDados.Visible := True;
         pgcDados.ActivePage := tstDuplicatasFornecedor;
         if edfCodigoFornecedor.CanFocus then
           edfCodigoFornecedor.SetFocus
       end;
   10: begin
         pgcDados.Visible    := False;
//         dtmautenticacoes.AbrirTabelaDeposito;
         dtmautenticacoes.ReFazConsultaCaixa;
         if fraConsultaContas.edfCodigo.CanFocus then
           fraConsultaContas.edfCodigo.SetFocus
       end;
  end;//end case
end;

procedure TfrmAutenticacoesCaixa.edfCodigoContratoDevolucoesFound(Found: Boolean);
begin
  inherited;
  if found then begin
    dtmautenticacoes.ReFazConsulta(dtmautenticacoes.TabelaMotivosDevolucao, [0], [0]);
    dtmautenticacoes.reFazConsultaClientes(paCONTRATOSDEVOLUCOES);
    dtmautenticacoes.refazConsultaDevolucoes(paCONTRATOSDEVOLUCOES);
    gbxDevolucaoSaldo.Enabled := False;
  end;
  pgcAutenticacoesChange(nil);
end;

procedure TfrmAutenticacoesCaixa.edfCodigoContratoDevolucoesKeyDown(
  Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;
  if (Key = VK_ESCAPE) and (Shift = []) and (edfCodigoContratoDevolucoes.Text = '') then begin
    dtmautenticacoes.ReFazConsultaMotivoDevolucao;
    edfCodigoContratoDevolucoes.SetFocus;
    edfCodigoMotivoDevolucoes.Enabled := False;
    gbxDevolucaoSaldo.Enabled := true;
  end
end;

procedure TfrmAutenticacoesCaixa.dbgParcelasPrestacoesDrawColumnCell(
  Sender: TObject; const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  with dtmautenticacoes do
  begin
    if gdSelected in State then
    begin
      if dbgParcelasPrestacoes.DataSource.DataSet.FieldByName('quitado').AsBoolean then
      begin
        sbnQuitarSemJuros.Enabled := False;
        if dbgParcelasPrestacoes.DataSource.DataSet.FieldByName('datapagto').AsDateTime = DataServidor then
        begin
          dbgParcelasPrestacoes.Canvas.Brush.Color := $00ABC7FF;
        end
        else
        begin
          dbgParcelasPrestacoes.Canvas.Brush.Color := $00ACACAC;
        end;
      end
      else
      begin
        // Ismael
        if dbgParcelasPrestacoes.DataSource.DataSet.FieldByName('valorpagto' ).AsCurrency >
           dbgParcelasPrestacoes.DataSource.DataSet.FieldByName('valorvencto').AsCurrency
        then
          sbnQuitarSemJuros.Enabled := True
        else
          sbnQuitarSemJuros.Enabled := False;
        dbgParcelasPrestacoes.Canvas.Brush.Color := $00D5FFD5;
        if(dbgParcelasPrestacoes.DataSource.DataSet.FieldByName('datavencto').AsDateTime<DataServidor) then
          dbgParcelasPrestacoes.Canvas.Font.Color:=clRed
        else
          dbgParcelasPrestacoes.Canvas.Font.Color  := clBlack;
      end;
    end
    else
    begin
      if dbgParcelasPrestacoes.DataSource.DataSet.FieldByName('quitado').AsBoolean then
      begin
        sbnQuitarSemJuros.Enabled := False;
        if dbgParcelasPrestacoes.DataSource.DataSet.FieldByName('datapagto').AsDateTime = DataServidor then
        begin
          dbgParcelasPrestacoes.Canvas.Brush.Color := $00ABC7FF;
        end
        else
          dbgParcelasPrestacoes.Canvas.Brush.Color := $00E9E9E9;
      end
      else
      begin
        if(dbgParcelasPrestacoes.DataSource.DataSet.FieldByName('datavencto').AsDateTime<DataServidor) then
        begin
                {dbgParcelasPrestacoes.Canvas.Brush.Color:=$005555FF;
                dbgParcelasPrestacoes.Canvas.Font.Color:=clYellow; }
                dbgParcelasPrestacoes.Canvas.Brush.Color:=clWhite;
                dbgParcelasPrestacoes.Canvas.Font.Color:= clRed;//$005555FF;
        end
        else
        begin
                dbgParcelasPrestacoes.Canvas.Brush.Color := clWhite;
                dbgParcelasPrestacoes.Canvas.Font.Color  := clBlack;
        end;
      end;
    end;
    dbgParcelasPrestacoes.DefaultDrawColumnCell(Rect, DataCol, Column, State);
  end;
end;

procedure TfrmAutenticacoesCaixa.KeyDown(var Key: Word; Shift: TShiftState);
var Pagina: Integer;
begin
  if (Shift = [ssCtrl]) and not (Shift = [ssShift]) then
  begin
    case key of
      VK_F1 :;
//      VK_F2
//      VK_F3
//      VK_F4
//      VK_F5
//      VK_F6
//      VK_F7
//      VK_F8
//      VK_F9
//      VK_F10
//      VK_F11
//      VK_F12
    end;
  end;

  if not (Shift = [ssCtrl]) and (Shift = [ssShift]) then
  begin
    case key of
      VK_F1 : ;
//      VK_F2
//      VK_F3
//      VK_F4
//      VK_F5
//      VK_F6
//      VK_F7
//      VK_F8
//      VK_F9
//      VK_F10
//      VK_F11
//      VK_F12
    end;
  end;

  if not (Shift = [ssCtrl]) and not (Shift = [ssShift]) then
  begin
     case key of
//       VK_F1
       VK_F2 : if (((pgcAutenticacoes.ActivePage = tstPrestacoes) and sbnParcelaParcial.Enabled) or
                    ((pgcAutenticacoes.ActivePage = tstParcelasAberto) and sbnParcelasAbertoParcial.Enabled)) then
                begin
                  ProcessarPrestacaoParcial;
                end;
       VK_F3 : if (((pgcAutenticacoes.ActivePage = tstPrestacoes) and sbnQuitarSemJuros.Enabled) or
                    ((pgcAutenticacoes.ActivePage = tstParcelasAberto) and sbnQuitarParcelasAbertoSemJuros.Enabled)) then
                begin
                  ProcessarSemJuros;
                end;
       VK_F4 : if (((pgcAutenticacoes.ActivePage = tstPrestacoes) and sbnParcelaDesconto.Enabled) or
                    ((pgcAutenticacoes.ActivePage = tstParcelasAberto) and sbnDescontoParcelasAberto.Enabled)) then
                begin
                  CalcularPrestacaoAntecipada;
                end;
       VK_F5 : if (((pgcAutenticacoes.ActivePage = tstPrestacoes) and sbnParcelaAlterar.Enabled) or
                    ((pgcAutenticacoes.ActivePage = tstParcelasAberto) and sbnAlterarParcelasAberto.Enabled)) then
                begin
                  processarAlteracaoPrestacao;
                end;
       VK_F6 : sbnTrocoClick(sbnTroco);
       VK_F7 : if ((pgcAutenticacoes.ActivePage = tstPrestacoes) or
                    (pgcAutenticacoes.ActivePage = tstParcelasAberto)) then
                begin
                  dtmautenticacoes.imprimirParcelasEmAberto;
                end;
       VK_F8 : acionaFichaFinanceira;
       VK_F9 : begin
                  Pagina := pgcAutenticacoes.ActivePageIndex;
                  ImprimirCheque;
                  pgcAutenticacoes.SetFocus;
                  pgcAutenticacoes.ActivePageIndex := Pagina;
                end;
       VK_F10 : begin key:=0; CadastraAtendimento; end; 
       VK_F11 : sbnReciboClick(sbnRecibo);
       VK_F12 : processarAutenticacoes;
     VK_ESCAPE: begin
                   if (pgcAutenticacoes.ActivePage = tstCheques) then
                   begin
                     DesabilitarCamposCheque;
                     fraCMC7Cheque.LimparCampos;
                     gbxCheques.Enabled:= False;
                   end
                   else
                   begin
                     if pgcAutenticacoes.ActivePage = tstResgateCheque then
                     begin
                       fraCMC7Resgate.LimparCampos;
                       fraCMC7Resgate.edtCMC7.SetFocus;
                       dtmautenticacoes.FecharTabelasResgate;
                     end
                     else
                     begin
                       if pgcAutenticacoes.ActivePage = tstCancelamento then
                       begin
                         dtmautenticacoes.ReFazConsultaCancelamento;
                       end
                       else
                       begin
                         if (pgcAutenticacoes.ActivePage = tstPrestacoes) or
                            (pgcAutenticacoes.ActivePage = tstParcelasAberto) then
                         begin
                           PrestacaoEmAndamento := False;
                           pgcDados.Visible     := False;
                         end
                         else
                         begin
                           if pgcAutenticacoes.ActivePage = tstDuplicatas then
                           begin
                             dtmautenticacoes.ReFazConsultaDocumentosPag(True);
                           end
                           else
                           begin
                             pgcDados.Visible := False;
                           end;
                         end;
                       end;
                     end;
                   end;
                 end;
    end;
  end;
  inherited;
end;

procedure TfrmAutenticacoesCaixa.dbgParcelasPrestacoesKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  case key of
    VK_DOWN  : if dtmautenticacoes.FinalParcelasPrestacao then
                  key := MAXWORD;
    VK_UP    : if dtmautenticacoes.InicioParcelasPrestacao then
                  key := MAXWORD;
    VK_Delete: if (shift = [ssCtrl]) then
                  key := MAXWORD;
  end; //end case
end;

procedure TfrmAutenticacoesCaixa.sbnConsultaMotivoDevolucoesClick(Sender: TObject);
begin
  CtrlOn := True;
  edfCodigoMotivoDevolucoes.SetFocus;
  InternoPesquisar('');
end;

function TfrmAutenticacoesCaixa.verificarNumeroCheque(numero: string): boolean;
begin
  result := false;
  if not dtmautenticacoes.chequeValido(numero) then
    MensagemErro(ctERRORCHEQUENUMERO)
  else if dtmautenticacoes.ExisteCheque('numero', numero) then
    MensagemAviso(ctNUMEROCHEQUECADASTRADO)
  else
    result := true;
end;

procedure TfrmAutenticacoesCaixa.CalcularPrestacaoAntecipada;
var
  Pos: TBookmark;
begin
  if pgcAutenticacoes.ActivePage = tstPrestacoes then
  begin
    if (dtmautenticacoes.ParcelaAutenticavel) then
    begin
      pos := dtmautenticacoes.qryParcelasPrestacao.GetBookmark;
      if dtmautenticacoes.parcelaAnteriorAutenticada(Pos) then
      begin
        dtmautenticacoes.ProcessarDescontoAntecipado
      end
      else
        MensagemAviso(ctPARCELAESTAANTERIORNAOAUTENTICADA);
    end
    else
      MensagemAviso(ctPARCELAESTAAUTENTICADA);
  end
  else
  begin
    if dtmautenticacoes.SelecionarParaAutenticacao then
    begin
      dtmautenticacoes.ProcessarDescontoAntecipadoParcelasAberto;
      dtmautenticacoes.EditPostParcelasAberto;
      AtualizarContadores(true);
    end
    else
      MensagemAviso(ctALTERARVALORPARCELASABERTO);
  end;
end;

procedure TfrmAutenticacoesCaixa.processarPrestacaoParcial;
var
  Pos: TBookmark;
begin
  if pgcAutenticacoes.ActivePage = tstPrestacoes then
  begin
    if (dtmautenticacoes.parcelaAutenticavel) then
    begin
      pos := dtmautenticacoes.qryParcelasPrestacao.GetBookmark;
      if dtmautenticacoes.parcelaAnteriorAutenticada(Pos) then
      begin
        frmvalorparcial := Tfrmvalorparcial.Create(frmvalorparcial);
        frmValorParcial.Caption:= 'Valor Parcial';
        frmvalorparcial.setDataModuloAutenticacoes(dtmautenticacoes);
        frmvalorparcial.setTipoPagamentoParcial(ppPARCELAS);
        frmvalorparcial.ShowModal;
        frmvalorparcial.Free;
        SetFocus;
      end
      else
        MensagemAviso(ctPARCELAESTAANTERIORNAOAUTENTICADA);
    end else
      MensagemAviso(ctPARCELAESTAAUTENTICADA);
  end else
  begin
    if dtmautenticacoes.SelecionarParaAutenticacao then
    begin
      frmValorParcial := TfrmValorParcial.Create(frmValorParcial);
      dtmautenticacoes.TotalMarcados := dtmautenticacoes.TotalMarcados - dtmautenticacoes.ParcelasAbertoValorPagto;
      frmValorParcial.Caption := 'Valor Parcial';
      frmvalorparcial.setDataModuloAutenticacoes(dtmautenticacoes);
      frmvalorparcial.setTipoPagamentoParcial(ppPARCELASABERTO);
      frmvalorparcial.ShowModal;
      dtmautenticacoes.TotalMarcados := dtmautenticacoes.TotalMarcados + dtmautenticacoes.ParcelasAbertoValorPagto;
      if frmValorParcial.ModalResult = mrok then
      begin
        dtmautenticacoes.EditPostParcelasAberto;
        AtualizarContadores(true);
      end;
      frmvalorparcial.Free;
      SetFocus;
    end else
      MensagemAviso(ctALTERARVALORPARCELASABERTO);
  end;
end;

procedure TfrmAutenticacoesCaixa.processarAlteracaoPrestacao;
var
  Pos: TBookmark;
begin
  if pgcAutenticacoes.ActivePage = tstPrestacoes then
  begin
    if (dtmautenticacoes.ParcelaAutenticavel)then
    begin
      pos := dtmautenticacoes.qryParcelasPrestacao.GetBookmark;
      if dtmautenticacoes.parcelaAnteriorAutenticada(Pos) then
      begin
        frmvalorparcial := Tfrmvalorparcial.Create(frmvalorparcial);
        frmValorParcial.TotalAutenticado := StrToFloat(lblTotalAutenticadoValor.Caption);
        frmValorParcial.EmAlteracao := True;
        frmValorParcial.Caption:= 'Alterar valor';
        frmvalorparcial.setDataModuloAutenticacoes(dtmautenticacoes);
        frmvalorparcial.setTipoPagamentoParcial(ppALTERARPARCELAS);
        frmvalorparcial.ShowModal;
        frmvalorparcial.Free;
        Refresh;
        SetFocus;
      end
      else
        MensagemAviso(ctPARCELAESTAANTERIORNAOAUTENTICADA);
    end
    else
      MensagemAviso(ctPARCELAESTAAUTENTICADA);
  end else
  begin
    if dtmautenticacoes.SelecionarParaAutenticacao then
    begin
      frmValorParcial := TfrmValorParcial.Create(frmvalorparcial);
//      dtmautenticacoes.TotalMarcados := dtmautenticacoes.TotalMarcados - dtmautenticacoes.ParcelasAbertoValorPagto;
      frmValorParcial.TotalAutenticado := StrToFloat(edtTotalMarcados.ValorSemFormatacao);
      frmValorParcial.EmAlteracao := True;
      frmValorParcial.Caption := 'Alterar valor';
      frmValorParcial.setDataModuloAutenticacoes(dtmautenticacoes);
      frmvalorparcial.setTipoPagamentoParcial(ppALTERARPARCELASABERTO);
      frmvalorparcial.ShowModal;
      dtmautenticacoes.TotalMarcados := dtmautenticacoes.TotalMarcados + dtmautenticacoes.ValorAlteracaoParcelasAberto;
      if frmValorParcial.ModalResult = mrok then
      begin
        dtmautenticacoes.EditPostParcelasAberto;
        AtualizarContadores(true);
      end;
      frmvalorparcial.Free;
      Refresh;
      dbgParcelasAberto.SetFocus;
    end else
      MensagemAviso(ctALTERARVALORPARCELASABERTO);
  end
end;

procedure TfrmAutenticacoesCaixa.sbnParcelaAlterarClick(Sender: TObject);
begin
  inherited;
  ProcessarAlteracaoPrestacao;
end;

procedure TfrmAutenticacoesCaixa.sbnParcelaParcialClick(Sender: TObject);
begin
  processarPrestacaoParcial;
end;

procedure TfrmAutenticacoesCaixa.processarAutenticacoes;
begin
  if (not(pgcAutenticacoes.ActivePageIndex in [4,7]) and (dtmautenticacoes.TransferenciaNaoConfirmada)) then
    MensagemAviso(ctCAIXATRANSFERENCIANAOCONFIRMADA)
  else// if dtmautenticacoes.ECFDisponivel then
    case pgcAutenticacoes.ActivePageIndex of
      0: Parcelas;
      1: AutenticacaoCheques;
      2: Devolucoes;
      3: AutenticacaoDocumentos;
      4: AutenticacaoCancelamentos;
      5: AutenticacaoResgateCheques;
      6: AutenticacaoTransferencias;
      7: AutenticacaoConfirmacaoTransferencias;
      8: AutenticacaoPerdas;
      9: AutenticacaoDuplicatas;
     10: AutenticacaoDepositos;
    end
end;

procedure TfrmAutenticacoesCaixa.AutenticacaoCancelamentos;
begin
  if dtmautenticacoes.TransferenciaJaConfirmada then
  begin
    MensagemAviso(ctTRANSFERENCIAJACONFIRMADA);
    dtmautenticacoes.RefazConsultaAutenticacoes;
    edfCodigoMotivoCancelamento.SetFocus;
  end
  else
    if dtmautenticacoes.VerificaAutenticacoesOrigemFrentedeCaixa and
       dtmautenticacoes.VerificaAutenticacoesMesmaTransacao then
    begin
      dtmautenticacoes.VerificaExclusaoCheques;
      if dtmautenticacoes.AutoriazadoParaCancelamento then
        if dadosCompletosParaAutenticarCancelamento then
          if abrirJanelaImpressao(ctCaixaCancelamento) = mrOK then begin
            {
            if not ParSistema.AutenticacaoParcelasModo2 then
              lblTotalAutenticadoValor.Caption := FloatToStrF(strToFloat(lblTotalAutenticadoValor.Caption)-dtmautenticacoes.ValorAutenticacao, ffFixed, 18, 2)
            else}
            begin
              dtmautenticacoes.RefazConsultaParcelasAberto(True);
              dtmautenticacoes.SelecionarAtrasadosData;
              AtualizarContadores(False);
            end;
            dtmautenticacoes.RefazConsultaAutenticacoes;
            edfCodigoMotivoCancelamento.SetFocus;
          end;
    end;
end;

procedure TfrmAutenticacoesCaixa.AutenticacaoCheques;
begin
    if fraCMC7Cheque.ChequeValido then begin
//    if dtmautenticacoes.ChequeValido(edtNumeroCheque.Text) then begin
      if DadosCompletosParaAutenticarCheque then
        if AbrirJanelaImpressao(ctCaixaCheques) = mrOK then begin
          flkCodigoClienteCheques.Clear;
          dtxNomeClienteCheques.DataSource.DataSet.FieldByName('nome').Clear;
          fraCMC7Cheque.LimparCampos;
//          edtNumeroCheque.Clear;
          DesabilitarCamposCheque;
          PrestacaoEmAndamento:= False;
        end
//    end else begin
//      MensagemErro(ctERRORCHEQUENUMERO);
//      edtNumeroCheque.SetFocus;
    end
    else MensagemErro(ctERRORCHEQUENUMERO);
end;

procedure TfrmAutenticacoesCaixa.AutenticacaoConfirmacaoTransferencias;
begin
  if dtmautenticacoes.NroRegistrosTransferenciaPendente > 0 then begin
    if dtmautenticacoes.TransferenciaCancelada then
    begin
      MensagemAviso(ctTRANSFERENCIACANCELADA);
      dbgTransferenciasPendentes.SetFocus;
    end
    else if dtmautenticacoes.RetornoTransferencia then begin
      if abrirJanelaImpressao(ctCaixaConfirmRetornoTransferencia) = mrOK then
        dtmautenticacoes.reFazConsultaTransferenciaPendente
    end else if MensagemConfirmacao(ctCONFIRMARECEBERTRANSF) = smbOk then begin
      if ParSistema.PermitirTransferenciaValorDiferente then
      begin
        if ConfirmarValorTransferencia > 0 then
          if abrirJanelaImpressao(ctCaixaConfirmacaoTransferencia) = mrOK then
            dtmautenticacoes.reFazConsultaTransferenciaPendente
      end
      else
        if abrirJanelaImpressao(ctCaixaConfirmacaoTransferencia) = mrOK then
          dtmautenticacoes.reFazConsultaTransferenciaPendente
   end //else if dtmautenticacoes.autenticarConfirmacaoTransferencia(dtmautenticacoes.NumeroTransferenciaPendente, atTransferenciaNaoConfirmada) = mrOK then
 //     dtmautenticacoes.reFazConsultaTransferenciaPendente
  end else
    MensagemErro(ctERRORSEMTRANSFERENCIAPENDENTE)
end;

procedure TfrmAutenticacoesCaixa.AutenticacaoDepositos;
begin
  if edtValorDeposito.Enabled then
  begin
    if dadosCompletosParaAutenticarDeposito then
    begin
      if (Not ParSistema.SaldoCaixaNegativo) and (strToFloat(edtValorDeposito.ValorSemFormatacao) >= dtmautenticacoes.ValorSaldoAtualCaixa) then
      begin
        MensagemErro(ctERRORVALORDEPOSITO);
        edtValorDeposito.SetFocus;
        edtValorDeposito.SelectAll
      end else
      begin
        abrirJanelaImpressao(ctCaixaDepositos);
        edtValorDeposito.Clear;

        fraConsultaContas.edfCodigo.SetFocus;
        fraConsultaContas.edfCodigo.SetControl(false);
        dtmautenticacoes.ReFazConsultaCaixa
      end
    end else
      MensagemErro(ctERRORDADOSINCOMPLETOSAUTENTICACAO);
  end else
    MensagemAviso(ctBANCONAOINFORMADO)
end;

procedure TfrmAutenticacoesCaixa.AutenticacaoDevolucoes;
begin
  if Trim(edfCodigoContratoDevolucoes.Text) <> '' then
  begin
    if dtmautenticacoes.AutorizadoParaDevolucao then
    begin
      if dadosCompletosParaAutenticarDevolucao then
      begin
        if dtmautenticacoes.devolucaoAutenticavel then
        begin
          if abrirJanelaImpressao(ctCaixaDevolucao) = mrOK then
          begin
            dtmautenticacoes.ReFazConsulta(dtmautenticacoes.TabelaDevolucoes, [0], [0]);
            dtmautenticacoes.ReFazConsulta(dtmautenticacoes.TabelaMotivosDevolucao, [0], [0]);
            edfCodigoContratoDevolucoes.SetFocus;
            edfCodigoContratoDevolucoes.SetControl(false);
          end;
        end
        else
          MensagemErro(ctERRORDEVOLUCAONAOAUTENTICAVEL);
      end
    end
  end
  else
    MensagemAviso(ctCONTRATONAOINFORMADO)
end;

procedure TfrmAutenticacoesCaixa.AutenticacaoDocumentos;
var
 I: integer;
begin
  if dbgMenuHistorico.Enabled then begin
    if dadosCompletosParaAutenticarDocumento then begin
      if abrirJanelaImpressao(ctCaixaDocumentos) = mrOK then begin
        dtmautenticacoes.ReFazConsulta(dtmautenticacoes.TabelaEvento, [0], [0]);
        dtmautenticacoes.ReFazConsulta(dtmautenticacoes.TabelaHistoricosEvento, [0], [0]);
        edtDataDocumento.Clear;
        edtValorDocumento.Clear;
        edfCodigoEventos.SetFocus;
        edfCodigoEventos.SetControl(false);
        for i := 0 to gbxDocumentosParametros.ComponentCount - 1 do
        begin
          TCustomEdit(gbxDocumentosParametros.Components[i]).Visible := false;
          TLabel(gbxDocumentosParametros.Components[i]).visible := false;
        end;
//        MontaParametros;
      end;
    end
  end else
    MensagemAviso(ctEVENTONAOINFORMADO)
end;

procedure TfrmAutenticacoesCaixa.AutenticacaoDuplicatas;
begin
  if dtmautenticacoes.DuplicataAutenticavel then begin
    if AbrirJanelaImpressao(ctCaixaDuplicatas)= mrOK then begin
      if (dtmautenticacoes.NroRegistrosDuplicatasDoc > 0) then
        dbgDuplicatasAberto.SetFocus
      else begin
        edfCodigoFornecedor.SetFocus;
        edfCodigoFornecedor.SetControl(false)
      end
    end
  end else
    MensagemErro(ctERRORDUPLICATANAOAUTORIZADA)
end;

procedure TfrmAutenticacoesCaixa.AutenticacaoParcelas;
var
Pos: TBookmark;
begin


  if TestarNumeroParcela then
  begin
  //jr
    Pos := dtmautenticacoes.qryParcelasPrestacao.GetBookmark;
    if (edfCodigoClienteContratoPrestacoes.Text <> '') and dbgParcelasPrestacoes.Enabled then
    begin
    //if dtmautenticacoes.qryContratosPrestacao.Locate('numero',dbgContratosPrestacoes.DataSource.DataSet.FieldByName('numero').AsString,[]) then
    //begin
      edfCodigoClienteContratoPrestacoes.Text:=dbgContratosPrestacoes.DataSource.DataSet.FieldByName('numero').AsString;
      if not dtmautenticacoes.qryParcelasPrestacaoquitado.AsBoolean then
        if edfCodigoClienteContratoPrestacoes.Exist then
          if dtmautenticacoes.parcelaAnteriorAutenticada(Pos) then
            if dtmautenticacoes.parcelaAutenticavel then
            begin
              if AbrirJanelaImpressao(ctCaixaParcelas) = mrOK then
              begin
                lblTotalAutenticadoValor.Caption := FloatToStrF(strToFloat(lblTotalAutenticadoValor.Caption)+dtmautenticacoes.ValorParcela, ffFixed, 18, 2);
                if ParSistema.InformarParcelaQuitar then
                begin
                  edtNumeroParcela.Text := '';
                  edtNumeroParcela.SetFocus;
                end
                else
                  edtNumeroParcela.Text := IntToStr(dtmautenticacoes.NumeroParcela);
                PrestacaoEmAndamento := True;
              end;
            end
            else
              MensagemAviso(ctPARCELAESTAAUTENTICADA)
          else
            MensagemAviso(ctPARCELAESTAANTERIORNAOAUTENTICADA)
        else
        edfCodigoClienteContratoPrestacoesFound(True)
      else
        MensagemAviso(ctPARCELAESTAAUTENTICADA);
    end
    else
       MensagemAviso(ctCONTRATONAOINFORMADO);
  end;
end;

procedure TfrmAutenticacoesCaixa.AutenticacaoPerdas;
begin
  if dbgContratosPerdas.Enabled then begin
    if dadosCompletosParaAutenticarPerda then begin
      if abrirJanelaImpressao(ctCaixaPerda) = mrOK then begin
        if (dtmautenticacoes.NroRegistrosContratosPerda > 0) then
          dbgContratosPerdas.SetFocus
        else begin
          edfCodigoContratoPerdas.SetFocus;
          dtmautenticacoes.ReFazConsulta(dtmautenticacoes.TabelaPerda, [0],[''])
        end
      end
    end
  end
end;

procedure TfrmAutenticacoesCaixa.AutenticacaoResgateCheques;
begin
  if dtmautenticacoes.ResgateAutenticavel then begin

    frmvalorparcial := Tfrmvalorparcial.Create(frmvalorparcial);
    frmvalorparcial.Caption:= 'Valor resgate';
    frmvalorparcial.ResgateParc:= False;
    frmvalorparcial.setDataModuloAutenticacoes(dtmautenticacoes);
    frmvalorparcial.setTipoPagamentoParcial(ppPARCELASCHEQUES);
    if frmvalorparcial.ShowModal = mrOK then begin
      frmvalorparcial.Free;
      SetFocus;

      if AbrirJanelaImpressao(ctCaixaResgateCheques) = mrOK then begin
        if dtmautenticacoes.NroRegistrosResgateCheques > 0 then
             dbgParcelasCheque.SetFocus
        else fraCMC7Cheque.edtCMC7.SetFocus;
      end
    end
  end else
    MensagemErro(ctRESGATEESTAAUTENTICADO)
end;

procedure TfrmAutenticacoesCaixa.AutenticacaoTransferencias;
var
valorcampo:real;
temp:string;
begin
  if edtValorTransferencia.Enabled then
  begin
   temp:=Trocar(edtValorTransferencia.Text,'.','');
   valorcampo:=StrToFloat(temp);
    if dadosCompletosParaAutenticarTransferencia then
    begin
      if (valorcampo > dtmautenticacoes.ValorSaldoAtualCaixa) then
      begin
        MensagemErro(ctERRORVALORTRANSFERENCIA);
        edtValorTransferencia.SetFocus;
        edtValorTransferencia.SelectAll
      end
      else if abrirJanelaImpressao(ctCaixaTransferencia) = mrOK then
      begin
          dtmautenticacoes.ReFazConsultaCaixa;
          edtValorTransferencia.Clear;
          edfCodigoCaixa.SetFocus;
          edfCodigoCaixa.SetControl(false)
      end
    end
  end
  else
    MensagemAviso(ctUSUARIONAOINFORMADO)
end;

function TfrmAutenticacoesCaixa.abrirJanelaImpressao(tipoAutenticacao: integer): integer;
var
  ValorPrestacao: Real;
  ValorPrestacaoAnterior:Real;
begin
  dtmautenticacoes.ObservacoesAutenticacoes := '';
  frmimpressaoautenticacao:= Tfrmimpressaoautenticacao.Create(frmimpressaoautenticacao);

  frmimpressaoautenticacao.setDataModulo(dtmautenticacoes);

  case tipoAutenticacao of
    ctCaixaParcelas                : begin
                                       ValorPrestacaoAnterior:=dtmautenticacoes.PrestacaoValorPagto;
                                       ValorPrestacao := dtmautenticacoes.PrestacaoValorPagtoCartao;
                                       dtmautenticacoes.PrestacaoValorPagto:=ValorPrestacaoAnterior;
                                       if ValorPrestacao > 0 then
                                         frmimpressaoautenticacao.parametrosParcela(dtmautenticacoes.NumeroContratoPrestacao, True, tipoAutenticacao, ValorPrestacao, True)
                                       else
                                         frmimpressaoautenticacao.parametrosParcela(dtmautenticacoes.NumeroContratoPrestacao, True, tipoAutenticacao, dtmautenticacoes.PrestacaoValorPagto, False);
                                     end;
    ctCaixaDevolucao               : frmimpressaoautenticacao.parametrosDevolucao(tipoAutenticacao, edfCodigoContratoDevolucoes.text, strToInt(edfCodigoMotivoDevolucoes.text), dtmautenticacoes.ValorSugeridoDevolucao);
    ctCaixaDocumentos              : frmimpressaoautenticacao.parametrosDocumento(tipoAutenticacao, strToInt(edfCodigoEventos.text), dtmautenticacoes.CodigoHistoricoHistoricoEvento, ckbSaidas.Checked, retornarStringParametros, edtDataDocumento.Text, strToFloat(edtValorDocumento.ValorSemFormatacao));
    ctCaixaCheques                 : frmimpressaoautenticacao.parametrosCheque(tipoAutenticacao,
                                                              fraCMC7Cheque.NumeroCheque {edtNumeroCheque.Text},
                                                              edtTitularCheque.Text,
                                                              flkCodigoClienteCheques.Text,
                                                              dtmautenticacoes.NomeTipoCliente[paCLIENTESCHEQUES],
                                                              edtVencimentoCheque.Text,
                                                              strToFloat(edtValorCheque.ValorSemFormatacao),
                                                              mmoObservacaoCheque1.Text);
    ctCaixaCancelamento            : begin
                                       if dtmautenticacoes.CancelamentoTransacao then
                                         frmimpressaoautenticacao.parametrosCancelamentoTransacao(tipoAutenticacao,strToInt(edfCodigoMotivoCancelamento.Text))
                                       else
                                         frmimpressaoautenticacao.parametrosCancelamento(tipoAutenticacao, dtmautenticacoes.NumeroAutenticacaoParaCancelar, strToInt(edfCodigoMotivoCancelamento.Text), dtmautenticacoes.ValorAutenticacao);
                                     end;
    ctCaixaResgateCheques          : frmimpressaoautenticacao.parametrosResgateCheque(tipoAutenticacao, dtmautenticacoes.ChequeParcelasResgate, dtmautenticacoes.NumeroParcelasResgate, dtmautenticacoes.ResgateValorPagto);
    ctCaixaTransferencia           : frmimpressaoautenticacao.parametrosTransferencia(tipoAutenticacao, strToInt(edfCodigoCaixa.Text), StrToFloaT(Trocar(edtValorTransferencia.Text,'.','')));
    ctCaixaConfirmRetornoTransferencia,
    ctCaixaConfirmacaoTransferencia: frmimpressaoautenticacao.parametrosConfirmacaoTransferencia(tipoAutenticacao, dtmautenticacoes.NumeroTransferenciaPendente, dtmautenticacoes.ValorTransferenciaPendente);
    ctCaixaPerda                   : frmimpressaoautenticacao.parametrosPerda(tipoAutenticacao, dtmautenticacoes.NumeroContratoPerda, strToInt(edfCodigoMotivoPerda.Text), dtmautenticacoes.ValorPerdaContrato);
    ctCaixaDuplicatas              : frmimpressaoautenticacao.parametrosDuplicata(tipoAutenticacao, dtmautenticacoes.ValorDuplicata);

    ctCaixaDepositos               : frmimpressaoautenticacao.parametrosDeposito(tipoAutenticacao, fraConsultaContas.qryProcuraContasnrbanco.asInteger,
                                                                                  fraConsultaContas.qryProcuraContasbanco.asString,
                                                                                 fraConsultaContas.qryProcuraContasconta.asInteger,
                                                                                 fraConsultaEventoDeposito.qryProcuraEventoscodigo.asinteger,
                                                                                 strToFloat(edtValorDeposito.ValorSemFormatacao));

    ctCaixaDevolucaoSaldo          : frmimpressaoautenticacao.parametrosDevolucaoSaldo(tipoAutenticacao, edtValorSaldoCreditoTrocaaDevolver.ValorSemFormatacao);
    ctCaixaParcelasAberto          : frmimpressaoautenticacao.parametrosParcelasAberto(tipoAutenticacao, dtmautenticacoes.TotalMarcados,dtmautenticacoes.PrestacaoValorPagtoCartao>0);
  end;
  frmimpressaoautenticacao.ShowModal;
  result := frmimpressaoautenticacao.Retorno;
  frmimpressaoautenticacao.Free;
  SetFocus;
end;

