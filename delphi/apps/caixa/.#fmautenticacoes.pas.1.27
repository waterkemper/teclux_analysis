procedure TfrmAutenticacoesCaixa.sbnConsultaClienteDevolucoesClick(
  Sender: TObject);
begin
  inherited;
  CtrlOn := True;
  edfCodigoClienteDevolucoesSaldo.SetFocus;
  InternoPesquisar('');
end;

procedure TfrmAutenticacoesCaixa.edfCodigoClienteDevolucoesSaldoFound(
  Found: Boolean);
begin
  inherited;
  if Found then
  begin
    dtmautenticacoes.RefazConsultaDevolucoes(paCLIENTESDEVOLUCOES);
    edtValorSaldoCreditoTrocaaDevolver.valormaximo := dtmautenticacoes.qryDevolucoesSaldosaldo.ascurrency;
    edtValorSaldoCreditoTrocaaDevolver.Value := dtmautenticacoes.qryDevolucoesSaldosaldo.ascurrency;

    gbxDevolucoes.Enabled := False;
  end;

  
end;

procedure TfrmAutenticacoesCaixa.edfCodigoClienteDevolucoesSaldoKeyDown(
  Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;
  if (Key = VK_ESCAPE) and (Shift = []) and (edfCodigoClienteDevolucoesSaldo.Text = '') then begin
    gbxDevolucoes.Enabled := true;
  end;
end;

procedure TfrmAutenticacoesCaixa.AutenticacaoDevolucoesSaldo;
begin
  if Trim(edfCodigoClienteDevolucoesSaldo.Text) <> '' then
  begin
    if dtmautenticacoes.AutorizadoParaDevolucao then
    begin
      if dadosCompletosParaAutenticarDevolucaoSaldo then
      begin
        if dtmautenticacoes.DevolucaoSaldoAutenticavel then
        begin
          if abrirJanelaImpressao(ctCaixaDevolucaoSaldo) = mrOK  then
          begin
            dtmautenticacoes.ReFazConsulta(dtmautenticacoes.TabelaDevolucoesSaldo, [0], [0]);
            edfCodigoClienteDevolucoesSaldo.SetFocus;
            edfCodigoClienteDevolucoesSaldo.SetControl(false);
          end;
        end
        else
          MensagemErro(ctERRORDEVOLUCAONAOAUTENTICAVEL);
      end
    end
  end
  else
    MensagemAviso(ctCLIENTENAOINFORMADO)
end;

function TfrmAutenticacoesCaixa.DadosCompletosParaAutenticarDevolucaoSaldo: Boolean;
begin
  result := false;
  if edfCodigoClienteDevolucoesSaldo.Exist then
  begin
    edfCodigoClienteDevolucoesSaldo.SetFocus;
    if dtmautenticacoes.ValorSaldoDevolucao > 0 then
    begin
      edtValorSaldoCreditoTrocaaDevolver.valormaximo := dtmautenticacoes.qryDevolucoesSaldosaldo.ascurrency;
      if edtValorSaldoCreditoTrocaaDevolver.Criticar(true) then
        result := true
    end
    else
      Exit
  end;
end;

procedure TfrmAutenticacoesCaixa.sbnConsultaClientesParcelasClick(
  Sender: TObject);
begin
  CtrlOn := True;
  edfCodigoClienteParcelasAberto.SetFocus;
  InternoPesquisar('');
end;

procedure TfrmAutenticacoesCaixa.dbgParcelasAbertoKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if (Shift = [ssCtrl]) and (Key = VK_SPACE) then begin
    dtmautenticacoes.MarcarParcelas(ckbMarcarTodas.Checked, False);
    AtualizarContadores(True);
  end;
end;

procedure TfrmAutenticacoesCaixa.ckbMarcarTodasClick(Sender: TObject);
begin
  inherited;
  dtmautenticacoes.MarcarParcelas(ckbMarcarTodas.Checked, True);
  AtualizarContadores(True);
  if not ckbMarcarTodas.Checked then
    dtmautenticacoes.LimparDataValorPagto;
end;

procedure TfrmAutenticacoesCaixa.edfCodigoClienteParcelasAbertoFound(
  Found: Boolean);
begin
  if not FBuscandoParcelaAberto then
  begin
    if Found then
    begin
      if dtmautenticacoes.CodigoClienteParcelasAberto <> dtmautenticacoes.CodigoCliente then
      begin
        dtmautenticacoes.PagamentoEmDinheiro := 0;
        edtTotalValor.Text := FormatarValor(0,2);
      end;
      dtmautenticacoes.LimpaRegistrosParcelasAberto;
      dtmautenticacoes.RefazConsultaParcelasAberto;
      dtmautenticacoes.SelecionarAtrasadosData;
      AtualizarContadores(False);
      edtContratoParcelasAberto.Clear;
      edtNumeroParcelasAberto.Clear;
      pgcDados.Visible := (dtmautenticacoes.CodigoClienteParcelasAberto > 0);
      if dtmautenticacoes.TipoCliente[paCLIENTEPARCELAS] = tcCLIENTE then
        pgcDados.ActivePage := tstDadosCliente
      else
        pgcDados.ActivePage := tstDadosFornecedor;
      dbgParcelasAberto.SetFocus;
    end else
      dtmautenticacoes.RefazConsultaParcelasAberto;
  end;
end;

procedure TfrmAutenticacoesCaixa.edfCodigoClienteParcelasAbertoKeyDown(
  Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;
  if {(Key = VK_ESCAPE) and (Shift = [])
     and} (edfCodigoClienteParcelasAberto.Text = '') then
  begin
    dtmautenticacoes.refazConsultaParcelasAberto;
    dtmautenticacoes.LimpaRegistrosParcelasAberto;
    AtualizarContadores(False);
    edtContratoParcelasAberto.Clear;
    edtNumeroParcelasAberto.Clear;
  end;
end;

procedure TfrmAutenticacoesCaixa.edfCodigoClienteParcelasAbertoMessage(
  var Msg: String);
begin
  inherited;
  Msg := ctCLIENTEPARCELASABERTO;
end;

procedure TfrmAutenticacoesCaixa.dbgParcelasAbertoDrawColumnCell(
  Sender: TObject; const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin

  with dtmautenticacoes do
  begin
{    if gdSelected in State then
      TDBGrid(Sender).Canvas.Brush.Color := $00D5FFD5
    else
      TDBGrid(Sender).Canvas.Brush.Color := clWhite; }

    if SelecionarParaAutenticacao then
    begin
      TDBGrid(Sender).Canvas.Brush.Color := $00FFAA00;
      TDBGrid(Sender).Canvas.Font.Color := clBlack;
      if gdSelected in State then
        sbnDescontoParcelasAberto.Enabled := False;
    end
    else
    begin
     if gdSelected in State then
        TDBGrid(Sender).Canvas.Brush.Color := $00D5FFD5
    end;

    if TDBGrid(Sender).DataSource.DataSet.FieldByName('quitado').asboolean then
    begin
      sbnQuitarParcelasAbertoSemJuros.Enabled := False;
      if TDBGrid(Sender).DataSource.DataSet.FieldByName('datapagto').AsDateTime = DataServidor then
        TDBGrid(Sender).Canvas.Brush.Color := $00ABC7FF
      else
        TDBGrid(Sender).Canvas.Brush.Color := $00ACACAC;
    end
    else
    begin
      if TDBGrid(Sender).DataSource.DataSet.FieldByName('valorpagto' ).AsCurrency >
         TDBGrid(Sender).DataSource.DataSet.FieldByName('valorvencto').AsCurrency
      then
        sbnQuitarParcelasAbertoSemJuros.Enabled := True
      else
        sbnQuitarParcelasAbertoSemJuros.Enabled := False;

        {
      if gdSelected in State then
        TDBGrid(Sender).Canvas.Brush.Color := $00D5FFD5
      else
        TDBGrid(Sender).Canvas.Brush.Color := clWhite;}

      if(TDBGrid(Sender).DataSource.DataSet.FieldByName('datavencto').AsDateTime<DataServidor) then
        TDBGrid(Sender).Canvas.Font.Color:=clRed
      else
        TDBGrid(Sender).Canvas.Font.Color  := clBlack;
    end;

    TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
  end;


end;

procedure TfrmAutenticacoesCaixa.dbgParcelasAbertoDblClick(
  Sender: TObject);
begin
  inherited;
  dtmautenticacoes.MarcarParcelas(ckbMarcarTodas.Checked, False);
  AtualizarContadores(True);
end;

procedure TfrmAutenticacoesCaixa.AutenticacaoParcelasAberto;
begin
  if (edfCodigoClienteParcelasAberto.Text <> '') and dbgParcelasAberto.Enabled then
  begin
    if (StrToFloat(edtTotalMarcados.ValorSemFormatacao) > 0) then
    begin
      if dtmautenticacoes.ParcelasAbertoAnteriorAutenticada(dbgParcelasAberto.ordenacao) then
      begin
        if dtmautenticacoes.ParcelasAbertoTefMesmoContrato then
        begin
          dtmautenticacoes.refazerConsultaAutenticacoesModo2;
          AtualizarContadores(True);
          if AbrirJanelaImpressao(ctCaixaParcelasAberto) = mrOK then
          begin
            //edtTotalValor.Text := FloatToStrF(StrToFloat(edtTotalValor.ValorSemFormatacao)+dtmautenticacoes.TotalMarcados, ffFixed, 18, 2);
            dtmautenticacoes.RefazConsultaParcelasAberto(true);
            dtmautenticacoes.PagamentoEmDinheiro := 0;
            AtualizarContadores(False);
  //          dtmautenticacoes.LimpaRegistrosParcelasAberto;
            PrestacaoEmAndamento := True;
            edtContratoParcelasAberto.Clear;
            edtNumeroParcelasAberto.Clear;
          end;
        end
        else
          MensagemAviso('A operação TEF não é permitida para parcelas de diferentes contratos.');
      end
      else
        MensagemAviso(ctPARCELAESTAANTERIORNAOAUTENTICADA);
    end
    else
      MensagemAviso(ctNAOFOISELECIONADOPARCELAS);
  end
  else
     MensagemAviso(ctCLIENTENAOINFORMADO)
end;

procedure TfrmAutenticacoesCaixa.AtualizarContadores(SoMarcados: Boolean);
begin
  with dtmautenticacoes do begin
    if SoMarcados then begin
      edtQtdeMarcados.Text  := IntToStr(QtdeMarcados);
      edtTotalMarcados.Text := Format('%8.2m', [TotalMarcados]);
    end
    else begin
      edtQtdeTotal.Text     := IntToStr(QtdeParcelasAberto);
      edtQtdeMarcados.Text  := IntToStr(QtdeMarcados);
      edtTotalValor.Text    := Format('%8.2m', [PagamentoEmDinheiro]);
      edtTotalMarcados.Text := Format('%8.2m', [TotalMarcados]);
    end;
  end;
end;

procedure TfrmAutenticacoesCaixa.Parcelas;
begin
  if ParSistema.AutenticacaoParcelasModo2 then
    AutenticacaoParcelasAberto
    {
  else AutenticacaoParcelas};
end;

procedure TfrmAutenticacoesCaixa.Devolucoes;
begin
  if gbxDevolucoes.Enabled then
    AutenticacaoDevolucoes
  else AutenticacaoDevolucoesSaldo;
end;

procedure TfrmAutenticacoesCaixa.edtNumeroParcelaEnter(Sender: TObject);
begin
  inherited;
  case dtmautenticacoes.LocalizarParcelaEmAberto(StrToInt(edtNumeroParcela.Text)) of
   -1: MensagemAviso('Parcela já autenticada');
    1: MensagemAviso('Parcela');
   end;
end;

function TfrmAutenticacoesCaixa.TestarNumeroParcela: Boolean;
begin
  Result := True;
  if ParSistema.InformarParcelaQuitar then
  begin
    if (edtNumeroParcela.Text = '') then
    begin
      MensagemAviso('Informe o número da parcela');
      edtNumeroParcela.SetFocus;
      Result := False;
    end
    else
    begin
      case dtmautenticacoes.LocalizarParcelaEmAberto(StrToInt(edtNumeroParcela.Text)) of
         1: begin
              MensagemAviso(ctPARCELAESTAANTERIORNAOAUTENTICADA);
              edtNumeroParcela.SetFocus;
              Result := False;
            end;
        -1: begin
              MensagemAviso(ctPARCELAESTAAUTENTICADA);
              edtNumeroParcela.SetFocus;
              Result := False;
            end;
         0: begin
              MensagemAviso('Parcela não encontrada. Verifique o número informado.');
              edtNumeroParcela.SetFocus;
              Result := False;
            end;
      end;
    end;
  end;
end;

function TfrmAutenticacoesCaixa.ConfirmarValorTransferencia: Currency;
begin
  frmValorTransferencia := TfrmValorTransferencia.Create(frmValorTransferencia);
  try
    frmValorTransferencia.setDataModulo(dtmautenticacoes);
    frmValorTransferencia.ValorTransferencia := dtmautenticacoes.ValorTransferenciaPendente;
    frmValorTransferencia.ShowModal;
  finally
    if dtmautenticacoes.ValorConfirmadoTransferencia > dtmautenticacoes.ValorTransferenciaPendente then
    begin
      Result := 0;
      MensagemAviso('O valor da confirmação não pode ser maior que o valor da autenticação');
    end
    else
      Result := dtmautenticacoes.ValorConfirmadoTransferencia;
    frmValorTransferencia.Free;
  end;
end;


procedure TfrmAutenticacoesCaixa.edtNumeroParcelasAbertoKeyDown(
  Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;
  if key = vk_return then
  begin
    FBuscandoParcelaAberto := True;
    if (trim(edtContratoParcelasAberto.Text) <> '') and
       (trim(edtNumeroParcelasAberto.Text) <> '') and
       dtmautenticacoes.BuscarParcelaAberta(trim(edtContratoParcelasAberto.Text),
                                            StrToInt(trim(edtNumeroParcelasAberto.Text))) then
      edtContratoParcelasAberto.SetFocus;
    AtualizarContadores(false);
    FBuscandoParcelaAberto := False;
  end;

end;

procedure TfrmAutenticacoesCaixa.PesquisarClick(
  Sender: TObject);
begin
  inherited;
  AdvGridFindDialog1.Execute;
end;

procedure TfrmAutenticacoesCaixa.Pesquizar1Click(Sender: TObject);
begin
  inherited;
  AdvGridFindDialog1.Execute;

end;

end.
