procedure Tfrmautenticacoes.acionaCadastroAtendimento(cliente: integer);
begin
  if cliente = 0 then begin
    if dbgParcelasPrestacoes.Enabled then
      cliente := dtmautenticacoes.CodigoClientePrestacao;
  end;
  if not Assigned(frmCadastroAtendimento) then
    frmCadastroAtendimento:= TfrmCadastroAtendimento.Create(Self);
  frmCadastroAtendimento.CodigoClienteAtual := cliente;
  frmCadastroAtendimento.Tipo               := 'R';
  frmCadastroAtendimento.Show;
end;
 }
procedure TfrmautenticacoesCaixa.AcionaFichaFinanceira;
var
  Cliente    : Integer;
  TipoCliente: String;
begin
  if pgcAutenticacoes.ActivePage =  tstPrestacoes then begin
    Cliente     := dtmautenticacoes.CodigoClientePrestacao;
    TipoCliente := dtmautenticacoes.TipoClientePrestacao;
  end
  else if pgcAutenticacoes.ActivePage =  tstDevolucoes then begin
    Cliente     := dtmautenticacoes.CodigoClienteDevolucoes;
    TipoCliente := dtmautenticacoes.TipoClienteDevolucoes;
  end
  else if pgcAutenticacoes.ActivePage = tstCheques then begin
    Cliente     := dtmautenticacoes.CodigoClienteClientesCheque;
    TipoCliente := dtmautenticacoes.TipoClienteCheque;
  end
  else if pgcAutenticacoes.ActivePage =  tstResgateCheque then begin
    Cliente     := dtmautenticacoes.CodigoClienteResgate;
    TipoCliente := dtmautenticacoes.TipoClienteResgate;
  end
  else if pgcAutenticacoes.ActivePage = tstPerdas then begin
    Cliente     := dtmautenticacoes.CodigoClientePerdas;
    TipOCliente := dtmautenticacoes.TipoClientePerdas;
  end
  else if pgcAutenticacoes.ActivePage = tstParcelasAberto then begin
    Cliente     := dtmautenticacoes.CodigoClienteParcelasAberto;
    TipoCliente := dtmautenticacoes.TipoClienteParcelasAberto;
  end
  else
    Cliente := 0;
  if Cliente > 0 then
    TfrmPrincipalBasico(Application.MainForm).MostrarFormRegistrado([Cliente,TipoCliente], 'TfrmFichaFinanceira', True);
end;
