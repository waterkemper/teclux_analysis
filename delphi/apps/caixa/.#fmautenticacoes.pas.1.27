procedure TfrmAutenticacoesCaixa.MontaParametros;
var i: integer;
begin
  if gbxDocumentosParametros.ComponentCount > 0 then
    gbxDocumentosParametros.DestroyComponents;


  if dtmautenticacoes.NroRegistrosHistoricosEvento > 0 then begin
    if assigned(docHistorico) then
      docHistorico.Free;
    docHistorico := TParametrosHistorico.Create(dtmautenticacoes.DescricacaoHistoricosEvento);

    for i := 0 to docHistorico.NroParametros - 1 do begin
      docLabel           := TLabel.Create(gbxDocumentosParametros);
      docLabel.Left      := 50;
      docLabel.Width     := 130;
      docLabel.Top       := (i * 27) + 40;

      if docHistorico.ParametroTipo(i+1) = '*N' then
        docEdit := TEditNumero.Create(gbxDocumentosParametros)
      else if docHistorico.ParametroTipo(i+1) = '*DMA' then
        docEdit := TEditData.Create(gbxDocumentosParametros)
      else if docHistorico.ParametroTipo(i+1) = '*MA' then
        docEdit := TEditMesAno.Create(gbxDocumentosParametros)
      else begin
        docEdit      := TEdit.Create(gbxDocumentosParametros);
        TEdit(docEdit).CharCase  := ecUpperCase;
        docEdit.Width:= 220;
      end;
      docEdit.Left      := docLabel.Left + docLabel.Width + 5;
      docEdit.Top       := docLabel.Top - 2;

      gbxDocumentosParametros.InsertControl(docLabel);
      docLabel.Caption := docHistorico.ParametroDescricao(i+1);
      gbxDocumentosParametros.InsertControl(docEdit);
      docEdit.parent := gbxDocumentosParametros;
      docEdit.TabOrder := i;
    end;
  end;
end;

procedure TfrmAutenticacoesCaixa.AfterScrollHistoricosEvento(Sender: TObject);
begin
  MontaParametros;
end;

function TfrmAutenticacoesCaixa.retornarStringParametros: string;
var i: integer;
begin
  result := '';
  if gbxDocumentosParametros.ComponentCount > 0 then begin
    for i := 0 to gbxDocumentosParametros.ComponentCount - 1 do begin
      if not (gbxDocumentosParametros.Components[i].ClassType = TLabel) then
        result := result + TCustomEdit(gbxDocumentosParametros.Components[i]).text+';';
    end;
  end;
end;

function TfrmAutenticacoesCaixa.dadosCompletosParaAutenticarDocumento: boolean;
var i: integer;
begin
   Result:= false;
   if ActiveControl = edfCodigoEventos
   then if not edfCodigoEventos.Exist then begin
           edfCodigoEventos.SetFocus;
           Exit;
        end;

   if edtDataDocumento.Text = '' then begin
      MensagemAviso(Format(ctCAMPODEVESERPREENCHIDO, ['Data']));
      edtDataDocumento.SetFocus;
   end
   else begin
      if edtValorDocumento.Text = '' then begin
         MensagemAviso(Format(ctCAMPODEVESERPREENCHIDO, ['Valor']));
         edtValorDocumento.SetFocus;
      end
      else begin
         if dtmautenticacoes.NroRegistrosHistoricosEvento = 0
         then Result:= True
         else begin
            if docHistorico.NroParametros = 0
            then result := true
            else begin
               for i := 0 to gbxDocumentosParametros.ComponentCount - 1 do begin
                   if not (gbxDocumentosParametros.Components[i].ClassType = TLabel) then begin
                      if (TCustomEdit(gbxDocumentosParametros.Components[i]).text = '') then begin
                         MensagemAviso(Format(ctCAMPODEVESERPREENCHIDO, [TLabel(gbxDocumentosParametros.Components[i-1]).Caption]));
                         TCustomEdit(gbxDocumentosParametros.Components[i]).SetFocus;
                         Result:= false;
                         Break;
                      end
                      else Result:= true;
                   end;
               end;
            end;
         end;
      end;
   end;
end;

