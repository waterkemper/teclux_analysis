procedure TfrmAutenticacoesCaixa.dbgParcelasChequeKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  case key of
    VK_DOWN  : if dtmautenticacoes.FinalParcelasResgate then
                  key := MAXWORD;
    VK_UP    : if dtmautenticacoes.InicioParcelasResgate then
                  key := MAXWORD;
    VK_Delete: if (shift = [ssCtrl]) then
                  key := MAXWORD;
  end
end;
