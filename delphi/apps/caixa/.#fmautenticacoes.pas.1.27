function TfrmAutenticacoesCaixa.dadosCompletosParaAutenticarDeposito: boolean;
begin
  result := false;

  if (ParSistema.InicioIntegracaoBancos > StrToDateTime('01/01/1980')) and
     (parsistema.EVENTOPARADEPOSITOSAUTENTICACOES='') then
  begin
    MensagemErro('O sistema possui integração com bancos e o campo evento esta nulo'+chr(13)+
                 'Verifique em Configurações/Parametros do Sistema/Caixa');
  end
  else
  begin

    if ActiveControl = fraConsultaContas.edfCodigo then begin
      if not fraConsultaContas.edfCodigo.Exist then begin
        fraConsultaContas.edfCodigo.SetFocus;
        Exit;
      end;
    end;

    if (fraConsultaContas.edfCodigo.Text = '') then begin
      MensagemAviso(Format(ctCAMPODEVESERPREENCHIDO, ['Conta banco']));
      fraConsultaContas.edfCodigo.SetFocus;
    end else if (edtValorDeposito.Text = '') then begin
      MensagemAviso(Format(ctCAMPODEVESERPREENCHIDO, ['Valor']));
      edtValorDeposito.SetFocus;
    end else
      result := true;
  end;
end;

