      dbgParcelasCheque.Canvas.Brush.Color := $00E9E9E9
    else
      dbgParcelasCheque.Canvas.Brush.Color := $00D5FFD5;
  end else begin
    if dbgParcelasCheque.DataSource.DataSet.FieldByName('resgatado').AsBoolean then
