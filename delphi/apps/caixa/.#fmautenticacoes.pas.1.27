procedure TfrmAutenticacoesCaixa.FormLoaded(Sender: TObject);
begin
  inherited;
  {
  if not ParSistema.AutenticacaoParcelasModo2 then
  begin
    pgcAutenticacoes.ActivePage := tstPrestacoes;
    edfCodigoClienteContratoPrestacoes.SetFocus;
  end
  else
  }
  begin
    pgcAutenticacoes.ActivePage := tstParcelasAberto;
    edfCodigoClienteParcelasAberto.SetFocus;
  end;
end;

procedure TfrmAutenticacoesCaixa.sbnReciboClick(Sender: TObject);
var
botao: TMessageButton;
begin
  inherited;
  if (pgcAutenticacoes.ActivePageIndex = 0) and (edfCodigoClienteContratoPrestacoes.Text <> '') then
    if dtmautenticacoes.qryParcelasPrestacaoquitado.AsBoolean then begin
      if (dbgParcelasPrestacoes.DataSource.DataSet.FieldByName('datapagto').AsDateTime = dtmautenticacoes.DataServidor) then begin
        if ParSistema.ImprimirReciboAcumulado then begin
          botao := MensagemSelecionaOpcao(ctIMPRIMIRRECIBOACUMULADO);
          if botao = smbYES then begin
            if dtmautenticacoes.qryImprimirAcumulado.Active then
              dtmautenticacoes.ImprimirReciboParcelasAcumuladas(dtmautenticacoes.RazaoFilialBase)
            else MensagemAviso(ctSEMREGISTROSACUMULADOS);
          end else if botao = smbNO then begin
            dtmautenticacoes.AtribuirParametrosImprimirReciboParcela(dtmautenticacoes.qryParcelasPrestacaocontrato.AsString, dtmautenticacoes.qryParcelasPrestacaonumero.AsInteger);
            dtmautenticacoes.ImprimirReciboParcela(dtmautenticacoes.PrestacaoValorPagto,nil,dtmautenticacoes.RazaoFilialBase);
          end else
            Exit;
        end else begin
          dtmautenticacoes.AtribuirParametrosImprimirReciboParcela(dtmautenticacoes.qryParcelasPrestacaocontrato.AsString, dtmautenticacoes.qryParcelasPrestacaonumero.AsInteger);
          dtmautenticacoes.ImprimirReciboParcela(dtmautenticacoes.PrestacaoValorPagto,nil,dtmautenticacoes.RazaoFilialBase);
        end;
      end else
        MensagemAviso(ctIMPRESSAOPARCELASHOJE);
    end else
      MensagemAviso(ctPARCELANAOESTAAUTENTICADA)
  else if (pgcAutenticacoes.ActivePage = tstParcelasAberto) and (edfCodigoClienteParcelasAberto.Text <> '') then
    if dtmautenticacoes.qryImprimirAcumulado.Active then
      dtmautenticacoes.ImprimirReciboParcelasAcumuladas(dtmautenticacoes.RazaoFilialBase)
    else MensagemAviso(ctSEMREGISTROSACUMULADOS);
end;

