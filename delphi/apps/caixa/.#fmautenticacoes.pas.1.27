function TfrmAutenticacoesCaixa.ChequeOk: Boolean;
begin
  inherited;
  Result:= True;
  with dtmautenticacoes do begin
    if ChequeCadastrado(fraCMC7Cheque.NumeroCheque) then begin
      if ChequeAutenticado then
        MensagemAviso(ctCHEQUEAUTENTICADO)
      else if not SituacaoChequeNormal then
        MensagemAviso(ctCHEQUENAONORMAL)
      else
        MensagemAviso(ctNUMEROCHEQUECADASTRADO);

      fraCMC7Cheque.LimparCampos;
      flkCodigoClienteCheques.Clear;
      dtxNomeClienteCheques.DataSource.DataSet.FieldByName('nome').Clear;
      Result:= False;
    end
    else begin
      if not gbxCheques.Enabled then
        gbxCheques.Enabled:= True;
//      AbrirTabelaCheque;
      flkCodigoClienteCheques.SetFocus;
      if not prestacaoEmAndamento then begin
        edtVencimentoCheque.Text := DateToStr(DataServidor);
//        edtValorCheque.Text      := '';
//        edtTitularCheque.Text    := '';
      end
      else begin
        PreencherCamposCheque;
        ReFazConsultaClientes(paCLIENTESCHEQUES);
      end;
    end;
  end;
end;

procedure TfrmAutenticacoesCaixa.fraCMC7ChequeedtCMC7Exit(Sender: TObject);
begin
  inherited;
  fraCMC7Cheque.edtCMC7Exit(Sender);
  if fraCMC7Cheque.ChequeValido then
    if not ChequeOK then begin
      fraCMC7Cheque.LimparCampos;
      gbxCheques.Enabled:= False;
    end
end;

procedure TfrmAutenticacoesCaixa.fraCMC7ChequeedtManual3Exit(Sender: TObject);
begin
  inherited;
  fraCMC7Cheque.edtManual3Exit(Sender);
  if fraCMC7Cheque.ChequeValido then
    if not ChequeOK then begin
      fraCMC7Cheque.LimparCampos;
      gbxCheques.Enabled:= False;
    end
end;

procedure TfrmAutenticacoesCaixa.flkCodigoClienteChequesExit(Sender: TObject);
begin
  inherited;
  if flkCodigoClienteCheques.Text <> '' then begin
    dtmautenticacoes.ReFazConsultaClientes(paCLIENTESCHEQUES);
    if dtmautenticacoes.TipoCliente[paCLIENTESCHEQUES] = tcCLIENTE then
         edtTitularCheque.Text := dtmautenticacoes.NomeCliente
    else edtTitularCheque.Text := dtmautenticacoes.NomeFornecedor;
    edtValorCheque.SetFocus;
  end;
end;

procedure TfrmAutenticacoesCaixa.fraCMC7ResgateedtCMC7Exit(Sender: TObject);
begin
  inherited;
  with dtmautenticacoes do begin
    fraCMC7Resgate.edtCMC7Exit(Sender);
    if fraCMC7Resgate.ChequeValido then begin
      if ReFazConsultaResgate(fraCMC7Resgate.NumeroCheque) then
           dbgParcelasCheque.SetFocus
      else fraCMC7Resgate.edtCMC7.SetFocus;
    end;
  end;
end;

procedure TfrmAutenticacoesCaixa.fraCMC7ResgateedtManual3Exit(Sender: TObject);
begin
  inherited;
  with dtmautenticacoes do begin
    fraCMC7Resgate.edtManual3Exit(Sender);
    if fraCMC7Resgate.ChequeValido then begin
      if ReFazConsultaResgate(fraCMC7Resgate.NumeroCheque) then
           dbgParcelasCheque.SetFocus
      else fraCMC7Resgate.edtManual1.SetFocus;
    end;
  end
end;

procedure TfrmAutenticacoesCaixa.actHabilitarUpdate(Sender: TObject);
begin
  inherited;
  with dtmautenticacoes do begin
    if (pgcAutenticacoes.ActivePage = tstPrestacoes) or
       (pgcAutenticacoes.ActivePage = tstParcelasAberto) then begin
      sbnParcelaParcial.Enabled  := NrParcelasPrestacao > 0;
      sbnParcelaDesconto.Enabled:=(NrParcelasPrestacao > 0) and
                                  ((TaxaJuroContrato > 0) or
                                   (ValorPrazo > ValorVista));
      sbnDescontoParcelasAberto.Enabled:=sbnParcelaDesconto.Enabled;
      sbnParcelaAlterar.Visible  := (NrParcelasPrestacao > 0) and PermitirAlterarVencto;
      sbnParcelaAlterar.Enabled:=sbnParcelaAlterar.Visible;
    end
    else if pgcAutenticacoes.ActivePage = tstResgateCheque then
      sbnResgateParcial.Enabled  := NroRegistrosResgateCheques > 0
    else if pgcAutenticacoes.ActivePage = tstParcelasAberto then begin
      sbnParcelasAbertoParcial.Enabled := QtdeParcelasAberto > 0;
      sbnDescontoParcelasAberto.Enabled:= (QtdeParcelasAberto > 0) and
                                          ((TaxaJurosContratoParcelasAberto > 0) or
                                          (ValorPrazoParcelasAberto > ValorVistaParcelasAberto));
      sbnAlterarParcelasAberto.Visible := (QtdeParcelasAberto > 0) and PermitirAlterarVencto;
      sbnAlterarParcelasAberto.Enabled := sbnAlterarParcelasAberto.Visible;
    end;
  end;
end;

procedure TfrmAutenticacoesCaixa.sbnTrocoClick(Sender: TObject);
begin
  inherited;
  if dtmautenticacoes.PagamentoEmDinheiro > 0 then begin
    frmTrocoCaixa := TfrmTrocoCaixa.Create(frmTrocoCaixa);
    try
      frmTrocoCaixa.PagoEmDinheiro := dtmautenticacoes.PagamentoEmDinheiro;
      frmTrocoCaixa.ShowModal
    finally
      frmTrocoCaixa.Free
    end
  end
end;

procedure TfrmAutenticacoesCaixa.sbnImprimirChequeClick(Sender: TObject);
begin
  inherited;
  ImprimirCheque;
end;

procedure TfrmAutenticacoesCaixa.ImprimirCheque;
begin
  if Trim(fraCMC7Cheque.edtBanco.Text) = '' then begin
    frmLerDataNumero := TfrmLerDataNumero.Create(frmLerDataNumero, 'Cheque', 'Valor');
    frmLerDataNumero.edtNumero.Decimais := True;
    if frmLerDataNumero.ShowModal = mrOK then
      dtmautenticacoes.ImprimirCheque('001', frmLerDataNumero.Numero, frmLerDataNumero.Data);
    frmLerDataNumero.Free;
  end else if Trim(edtValorCheque.Text) =  '' then
    MensagemAviso(format(ctVALORNAOPREENCHIDO,[ctCHEQUE]))
  else if Trim(edtVencimentoCheque.Text) = '' then
    MensagemAviso(ctDATACHEQUENAOPREENCHIDO)
  else
    dtmautenticacoes.ImprimirCheque(fraCMC7Cheque.edtBanco.ValorSemFormatacao, edtValorCheque.ValorSemFormatacao, edtVencimentoCheque.Text);
end;

procedure TfrmAutenticacoesCaixa.sbnQuitarSemJurosClick(Sender: TObject);
begin
  inherited;
  ProcessarSemJuros;
end;

procedure TfrmAutenticacoesCaixa.ProcessarSemJuros;
var
  Pos: TBookmark;
begin
  if pgcAutenticacoes.ActivePage = tstPrestacoes then
  begin
    if (dtmautenticacoes.ParcelaAutenticavel) then
    begin
      pos := dtmautenticacoes.qryParcelasPrestacao.GetBookmark;
      if dtmautenticacoes.parcelaAnteriorAutenticada(Pos) then
      begin
        if dtmautenticacoes.ProcessarSemJuros then
        begin
          frmvalorparcial := Tfrmvalorparcial.Create(frmvalorparcial);
          frmValorParcial.Caption:= 'Valor Parcial';
          frmvalorparcial.setDataModuloAutenticacoes(dtmautenticacoes);
          frmvalorparcial.setTipoPagamentoParcial(ppPARCELASSEMJUROS);
          if frmvalorparcial.ShowModal = mrOK then
            dtmautenticacoes.ParcelaSemJuros := True
          else
            dtmautenticacoes.ParcelaSemJuros := False;
          frmvalorparcial.Free;
          SetFocus;
        end;
      end
      else
        MensagemAviso(ctPARCELAESTAANTERIORNAOAUTENTICADA);
    end
    else
      MensagemAviso(ctPARCELAESTAAUTENTICADA);
  end
  else
  begin
    if dtmautenticacoes.SelecionarParaAutenticacao then
    begin
      if dtmautenticacoes.ProcessarSemJuros then
      begin
        frmvalorparcial := Tfrmvalorparcial.Create(frmvalorparcial);
        dtmautenticacoes.TotalMarcados := dtmautenticacoes.TotalMarcados - dtmautenticacoes.ParcelasAbertoValorPagto;
        frmValorParcial.TotalAutenticado := StrToFloat(edtTotalValor.ValorSemFormatacao);
        frmValorParcial.EmAlteracao := True;
        frmValorParcial.Caption:= 'Valor Parcial';
        frmvalorparcial.setDataModuloAutenticacoes(dtmautenticacoes);
        frmvalorparcial.setTipoPagamentoParcial(ppPARCELASABERTOSEMJUROS);
        frmvalorparcial.ShowModal;
        dtmautenticacoes.TotalMarcados := dtmautenticacoes.TotalMarcados + dtmautenticacoes.ParcelasAbertoValorPagto;
        if frmValorParcial.ModalResult = mrok then
        begin
          dtmautenticacoes.EditPostParcelasAberto;
          AtualizarContadores(true);
        end;
        frmvalorparcial.Free;
        Refresh;
        SetFocus;
      end;
    end else
      MensagemAviso(ctALTERARVALORPARCELASABERTO);
  end;
end;

procedure TfrmAutenticacoesCaixa.dbgContratosPrestacoesDrawColumnCell(
  Sender: TObject; const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
