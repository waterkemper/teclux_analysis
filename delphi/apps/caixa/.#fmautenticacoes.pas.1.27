  inherited;
  if dtmAutenticacoes.qryCliente.Active then begin
    frmCadastroAtendimentosCaixa := TfrmCadastroAtendimentosCaixa.Create(frmCadastroAtendimentosCaixa);
    try
      frmCadastroAtendimentosCaixa.ShowModal
    finally
