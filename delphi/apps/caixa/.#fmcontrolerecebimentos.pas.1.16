unit fmcontrolerecebimentos;

interface

uses
  SysUtils, Types, Classes, Graphics, Controls, Forms, Dialogs, Windows,
  StdCtrls, fmajudabt, Grids, DBGrids, cpdbgrid, cpdata, ExtCtrls,
  Mask, cpdbfindcontrols, DBCtrls, cpdbtext, ComCtrls, cppagecontrol,
  Buttons, frconsulta, frconsultacodigo, biblio, ctconstantes,
  dmcontrolerecebimentos, cpnumero, frlistatiposderecebimentos,
  frlistafiliais, ToolWin;

type
  TfrmControleRecebimentos = class(TfrmAjudaBt)
    pgcControleRecebimentos: TtecPageControl;
    tstParametros: TTabSheet;
    tstSelecionados: TTabSheet;
    dbgDetalhado: TtecDBGrid;
    sbnConfirma: TSpeedButton;
    sbnGerar: TSpeedButton;
    pnlButtom: TPanel;
    gbxTransacao: TGroupBox;
    dtxTransacao: TtecDBText;
    rgbOperacaoes: TRadioGroup;
    gbxLidos: TGroupBox;
    gbxNrLidos: TGroupBox;
    edtQtdeRecebimentos: TEditNumero;
    gbxValorLido: TGroupBox;
    edtTotalVencimentos: TEditNumero;
    gbxMarcadas: TGroupBox;
    gbxTotalQtdeMarcados: TGroupBox;
    edtQtdeMarcados: TEditNumero;
    gbxTotalValoresMarcados: TGroupBox;
    edtTotalMarcados: TEditNumero;
    ckbConfirmarTodos: TCheckBox;
    pnlCheques: TPanel;
    gbxCheques: TGroupBox;
    gbxClienteCheque: TGroupBox;
    gbxTitulaCheque: TGroupBox;
    gbxDataVenctoCheque: TGroupBox;
    dtxClienteCheque: TtecDBText;
    dtxTitularCheque: TtecDBText;
    dtxDataVenctoCheque: TtecDBText;
    gbxCheque: TGroupBox;
    dtxCheque: TtecDBText;
    gbxConta: TGroupBox;
    dtxConta: TtecDBText;
    gbxAgencia: TGroupBox;
    dtxAgencia: TtecDBText;
    gbxBanco: TGroupBox;
    dtxBanco: TtecDBText;
    gbxTEF: TGroupBox;
    dtxNomeRedeTEF: TtecDBText;
    dtxcodigoCliente: TtecDBText;
    fraListaFiliais1: TfraListaFiliais;
    fraListaTiposdeRecebimentos1: TfraListaTiposdeRecebimentos;
    gbxEmissao: TGroupBox;
    edtDataInicialEmissao: TEditData;
    edtDataFinalEmissao: TEditData;
    lblA: TLabel;
    gbxVencimentos: TGroupBox;
    edtDataInicialVencto: TEditData;
    edtDataFinalVencto: TEditData;
    Label1: TLabel;
    gbxClientes: TGroupBox;
    fraConsultaClientes: TfraConsultaCodigo;
    sttOperacoes: TStaticText;
    gbxTipoRecebimentos: TGroupBox;
    ckbDinheiro: TCheckBox;
    ckbCheque: TCheckBox;
    ckbDebito: TCheckBox;
    ckbCredito: TCheckBox;
    GroupBox1: TGroupBox;
    edtTotalValorLancto: TEditNumero;
    lblPossuiQuitacoes: TLabel;
    lblPossuiQuitacoesCor: TShape;
    gbxDataQuitacao: TGroupBox;
    edtDataConfirmacao: TEditData;
    gbxRecebimentos: TGroupBox;
    Label2: TLabel;
    edtDataInicialRecebimento: TEditData;
    edtDataFinalRecebimento: TEditData;
    stxDataDa: TStaticText;
    stxConfirmacao: TStaticText;
    stxRecebimentos: TStaticText;
    stxOperacao: TStaticText;
    procedure sbnGerarClick(Sender: TObject);
    procedure sbnConfirmaClick(Sender: TObject);
    procedure dbgDetalhadoKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure dbgDetalhadoDblClick(Sender: TObject);
    procedure pgcControleRecebimentosChange(Sender: TObject);
    procedure dbgDetalhadoDrawColumnCell(Sender: TObject;
      const Rect: TRect; DataCol: Integer; Column: TColumn;
      State: TGridDrawState);
    procedure ckbConfirmarTodosClick(Sender: TObject);
    procedure edtTotalMarcadosChange(Sender: TObject);
    procedure rgbOperacaoesClick(Sender: TObject);
  private
    procedure ConsultarRecebimentos;
    procedure GravarRecebimentos;
    procedure MarcarSelecionado(Marcando, Todos: Boolean);
    procedure AtualizarContadores(SoMarcados: Boolean);
    { Private declarations }
  protected
    procedure KeyDown(var Key: Word; Shift: TShiftState); override;
    procedure RecebimentosChange(Sender: TObject);
    procedure Recebimentoscodigotiporecebimento(Sender: TObject);
  public
    constructor Create(AOwner: TComponent); override;
    destructor  Destroy; override;
    { Public declarations }
  end;

var
  frmControleRecebimentos: TfrmControleRecebimentos;

implementation

{$R *.dfm}

procedure TfrmControleRecebimentos.ConsultarRecebimentos;
begin
  if dtmControleRecebimentos.ConsultarRecebimentos(
    edtDataInicialEmissao.text, edtDataFinalEmissao.text,
    edtDataInicialVencto.Text, edtDataFinalVencto.Text,
    edtDataInicialRecebimento.Text, edtDataFinalRecebimento.Text,
    fraListaFiliais1.ListaSelecionada,
    fraListaTiposdeRecebimentos1.ListaSelecionada,
    fraConsultaClientes.qryProcuraClientetipo.AsString,
    fraConsultaClientes.edfCodigo.Text,
    ckbDinheiro.checked, ckbCheque.checked, ckbDebito.checked, ckbCredito.checked) then
  begin
    pgcControleRecebimentos.ActivePage := tstSelecionados;
    pgcControleRecebimentosChange(self);
    AtualizarContadores(False);
    dbgDetalhado.SetFocus;
  end
  else
  begin
    MensagemAviso(format(ctNENHUMREGISTROENCONTRADO,['registro']));
    pgcControleRecebimentos.ActivePage := tstParametros;
    edtDataInicialEmissao.SetFocus;
  end;
end;

constructor TfrmControleRecebimentos.Create(AOwner: TComponent);
begin
  inherited;
  dtmControleRecebimentos:= TdtmControleRecebimentos.Create(Self);
  with dtmControleRecebimentos do
  begin
    OnRecebimentosChange  := RecebimentosChange;
    OnRecebimentoscodigotiporecebimento := Recebimentoscodigotiporecebimento;
  end;
  pgcControleRecebimentos.ActivePage := tstParametros;

  edtDataInicialEmissao.Text := DateToStr(DataLocal);
  edtDataFinalEmissao.Text   := DateToStr(DataLocal);

  fraConsultaClientes.TipoPesquisa    := pesCLIENTES;
  fraConsultaClientes.TipoCliente := 'C';


  fraListaFiliais1.gbxFiliais.Caption:= ' &FILIAIS ';
  fraListaFiliais1.gbxFiliais.Font.Height:= -11;
  fraListaFiliais1.gbxFiliais.Font.Style := [fsBold];

  fraListaTiposdeRecebimentos1.gbx.Caption:= ' &TIPOS DE RECEBIMENTOS ';
  fraListaTiposdeRecebimentos1.Font.Height:= -11;
  fraListaTiposdeRecebimentos1.Font.Style := [fsBold];
  fraListaTiposdeRecebimentos1.clbTiposdeRecebimentos.Font.Height:= -12;
  fraListaTiposdeRecebimentos1.clbTiposdeRecebimentos.Font.Style := [];
//  fraListaTiposdeRecebimentos1.refresh;

  edtDataConfirmacao.text := DateToStr(DataLocal);
  stxDataDa.     Height:= 12;
  stxConfirmacao.Height:= 12;

end;

procedure TfrmControleRecebimentos.sbnGerarClick(Sender: TObject);
begin
  inherited;
  rgbOperacaoesClick(nil);
  ConsultarRecebimentos;
  if rgbOperacaoes.itemindex = 0 then
    gbxTotalValoresMarcados.caption := ' VENCIMENTOS'
  else
    gbxTotalValoresMarcados.caption := ' RECEBIMENTOS';

end;

procedure TfrmControleRecebimentos.sbnConfirmaClick(Sender: TObject);
begin
  inherited;
  GravarRecebimentos;
end;

procedure TfrmControleRecebimentos.GravarRecebimentos;
begin
  if dtmControleRecebimentos.GravarRecebimentos then
    sbnGerarClick(nil);

  if dbgDetalhado.CanFocus then
    dbgDetalhado.SetFocus;
end;

destructor TfrmControleRecebimentos.Destroy;
begin
  frmControleRecebimentos := nil;
  inherited;
end;

procedure TfrmControleRecebimentos.dbgDetalhadoKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if (Key = VK_SPACE) and (Shift = [ssCtrl]) then
    if not dbgDetalhado.ColumnByName('confirmado').ReadOnly then
      MarcarSelecionado(ckbConfirmarTodos.Checked, False);
end;

procedure TfrmControleRecebimentos.MarcarSelecionado(Marcando,Todos: Boolean);
begin
  dtmControleRecebimentos.ConfirmarRecebimento(Marcando, Todos, StrToDateTime(edtDataConfirmacao.text));
  AtualizarContadores(True);
end;

procedure TfrmControleRecebimentos.dbgDetalhadoDblClick(Sender: TObject);
begin
  inherited;
  if not dbgDetalhado.ColumnByName('confirmado').ReadOnly then
    MarcarSelecionado(ckbConfirmarTodos.Checked, False);
end;

procedure TfrmControleRecebimentos.pgcControleRecebimentosChange(
  Sender: TObject);
begin
  inherited;
  if pgcControleRecebimentos.ActivePage = tstParametros then
  begin
    sbnGerar.Enabled := True;
    sbnConfirma.Enabled := False;
    stxOperacao.Visible := false;
  end
  else
  begin
    sbnGerar.Enabled := False;
    sbnConfirma.Enabled := True;
    stxOperacao.Visible := true;
  end;
end;

procedure TfrmControleRecebimentos.KeyDown(var Key: Word;
  Shift: TShiftState);
begin
  inherited;
  case Key of
       VK_F5 : if sbnConfirma.Enabled and not CtrlOn then
                  GravarRecebimentos;
       VK_F6 : if sbnGerar.Enabled and not CtrlOn then
                  ConsultarRecebimentos;
   VK_ESCAPE : if pgcControleRecebimentos.ActivePage = tstSelecionados then
               begin
                 pgcControleRecebimentos.ActivePage:= tstParametros;
                 pgcControleRecebimentosChange(self);
               end;
  end;
end;

procedure TfrmControleRecebimentos.dbgDetalhadoDrawColumnCell(
  Sender: TObject; const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  inherited;
  if dbgDetalhado.DataSource.DataSet.FieldByName('confirmado').AsBoolean then begin
    TDBGrid(Sender).Canvas.Brush.Color := clInfoBk;
    TDBGrid(Sender).Canvas.Font.Color := clBlack;
  end
  else
  if (rgbOperacaoes.ItemIndex = 0) and
     (dtmControleRecebimentos.qryRecebimentosquantidadeconfirmacoes.AsInteger > 0) then
   TDBGrid(Sender).Canvas.Font.Color := clRed;

  TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
end;

procedure TfrmControleRecebimentos.AtualizarContadores(
  SoMarcados: Boolean);
begin
  with dtmControleRecebimentos do begin
    if not SoMarcados then begin
      edtQtdeRecebimentos.Text  := IntToStr(QtdeRecebimentos);
      edtTotalVencimentos.Text := Format('%8.2m', [TotalVencimentos]);
      edtTotalValorLancto.Text := Format('%8.2m', [TotalValorLancto]);
    end;
    edtQtdeMarcados.Text  := IntToStr(QtdeMarcados);
    edtTotalMarcados.Text := Format('%8.2m', [TotalMarcados]);
  end;
end;

procedure TfrmControleRecebimentos.RecebimentosChange(Sender: TObject);
begin
  AtualizarContadores(False);
end;

procedure TfrmControleRecebimentos.ckbConfirmarTodosClick(Sender: TObject);
begin
  inherited;
  MarcarSelecionado(ckbConfirmarTodos.Checked,True);
end;

procedure TfrmControleRecebimentos.edtTotalMarcadosChange(Sender: TObject);
begin
  inherited;
  sbnConfirma.Enabled := ((edtTotalMarcados.ValorSemFormatacao <> 0) or (rgbOperacaoes.ItemIndex in [1,2]))
end;

procedure TfrmControleRecebimentos.rgbOperacaoesClick(Sender: TObject);
begin
  inherited;
  dbgDetalhado.ColumnByName('data_confirmacao').ReadOnly := rgbOperacaoes.ItemIndex <> 1;
  dbgDetalhado.ColumnByName('valor_confirmacao').ReadOnly := rgbOperacaoes.ItemIndex <> 1;
  dbgDetalhado.ColumnByName('tiporec').ReadOnly := rgbOperacaoes.ItemIndex <> 0;
  dbgDetalhado.ColumnByName('pdesagio').ReadOnly := rgbOperacaoes.ItemIndex <> 1;
  dbgDetalhado.ColumnByName('VlrDesagio').ReadOnly := rgbOperacaoes.ItemIndex <> 1;
//  dbgDetalhado.ColumnByName('confirmado').ReadOnly := rgbOperacaoes.ItemIndex = 0;

//  ckbConfirmarTodos.checked := rgbOperacaoes.ItemIndex = 1;
//  ckbConfirmarTodos.visible := rgbOperacaoes.ItemIndex <> 0;
  lblPossuiQuitacoesCor.visible := rgbOperacaoes.ItemIndex = 0;
  lblPossuiQuitacoes.visible := rgbOperacaoes.ItemIndex = 0;

  if Sender <> nil then
  begin
    case rgbOperacaoes.ItemIndex of
    0: begin
         if edtDataInicialEmissao.Text = '' then edtDataInicialEmissao.Text:= DateToStr(DataLocal);
         if edtDataFinalEmissao.  Text = '' then edtDataFinalEmissao.  Text:= DateToStr(DataLocal);
         edtDataInicialEmissao.SetFocus;

         edtDataInicialVencto.Clear;
         edtDataFinalVencto.  Clear;

         edtDataInicialRecebimento.Clear;
         edtDataFinalRecebimento.  Clear;
       end;

    1: begin
         edtDataInicialEmissao.Clear;
         edtDataFinalEmissao.  Clear;

         if edtDataInicialVencto.Text = '' then edtDataInicialVencto.Text:= DateToStr(DataLocal-1);
         if edtDataFinalVencto.  Text = '' then edtDataFinalVencto.  Text:= DateToStr(DataLocal-1);
         edtDataInicialVencto.SetFocus;

         edtDataInicialRecebimento.Clear;
         edtDataFinalRecebimento.  Clear;

       end;

    2: begin
         edtDataInicialEmissao.Clear;
         edtDataFinalEmissao.  Clear;

         edtDataInicialVencto.Clear;
         edtDataFinalVencto.  Clear;

         if edtDataInicialRecebimento.Text = '' then edtDataInicialRecebimento.Text:= DateToStr(DataLocal);
         if edtDataFinalRecebimento.  Text = '' then edtDataFinalRecebimento.  Text:= DateToStr(DataLocal);
         edtDataInicialRecebimento.SetFocus;
       end;
    end;
  end;

  case rgbOperacaoes.ItemIndex of
     0: begin stxOperacao.Caption:= UpperCase(rgbOperacaoes.Items[0]);
//              ckbConfirmarTodos.Visible:= False;
//              stxRecebimentos.  Visible:= False;
        end;
     1: begin stxOperacao.Caption:= UpperCase(rgbOperacaoes.Items[1]);
              ckbConfirmarTodos.Visible:= True;
              stxRecebimentos.  Visible:= True;
              stxRecebimentos.Caption:= 'os recebimentos';
        end;
     2: begin stxOperacao.Caption:= UpperCase(rgbOperacaoes.Items[2]);
              ckbConfirmarTodos.Visible:= True;
              stxRecebimentos.  Visible:= True;
              stxRecebimentos.Caption:= 'os estornos';
        end;
  end;

  dtmControleRecebimentos.Operacao := rgbOperacaoes.ItemIndex;


end;

procedure TfrmControleRecebimentos.Recebimentoscodigotiporecebimento(
  Sender: TObject);
begin

//  dtmControleRecebimentos.GravarRecebimentos(rgbOperacaoes.ItemIndex, false);
  ConsultarRecebimentos;

end;

end.
