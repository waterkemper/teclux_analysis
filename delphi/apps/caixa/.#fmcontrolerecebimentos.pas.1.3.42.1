unit fmcontrolerecebimentos;

interface

uses
  SysUtils, Types, Classes, Graphics, Controls, Forms, Dialogs, Windows,
  StdCtrls, fmajudabt, Grids, DBGrids, cpdbgrid, cpdata, ExtCtrls,
  Mask, cpdbfindcontrols, DBCtrls, cpdbtext, ComCtrls, cppagecontrol,
  Buttons, frconsulta, frconsultacodigo, biblio, ctconstantes,
  dmcontrolerecebimentos, cpnumero, frlistatiposderecebimentos,
  frlistafiliais, ToolWin;

type
  TfrmControleRecebimentos = class(TfrmAjudaBt)
    pgcControleRecebimentos: TtecPageControl;
    tstParametros: TTabSheet;
    gbxParametros: TGroupBox;
    tstSelecionados: TTabSheet;
    dbgDetalhado: TtecDBGrid;
    sbnConfirma: TSpeedButton;
    sbnGerar: TSpeedButton;
    pnlButtom: TPanel;
    gbxTransacao: TGroupBox;
    dtxTransacao: TtecDBText;
    rgbConfirmado: TRadioGroup;
    gbxLidos: TGroupBox;
    gbxNrLidos: TGroupBox;
    edtQtdeRecebimentos: TEditNumero;
    gbxValorLido: TGroupBox;
    edtTotalRecebimentos: TEditNumero;
    gbxMarcadas: TGroupBox;
    GroupBox2: TGroupBox;
    edtQtdeMarcados: TEditNumero;
    GroupBox3: TGroupBox;
    edtTotalMarcados: TEditNumero;
    ckbConfirmarTodos: TCheckBox;
    pnlCheques: TPanel;
    gbxCheques: TGroupBox;
    gbxClienteCheque: TGroupBox;
    gbxTitulaCheque: TGroupBox;
    gbxDataVenctoCheque: TGroupBox;
    dtxClienteCheque: TtecDBText;
    dtxTitularCheque: TtecDBText;
    dtxDataVenctoCheque: TtecDBText;
    gbxCheque: TGroupBox;
    dtxCheque: TtecDBText;
    gbxConta: TGroupBox;
    dtxConta: TtecDBText;
    gbxAgencia: TGroupBox;
    dtxAgencia: TtecDBText;
    gbxBanco: TGroupBox;
    dtxBanco: TtecDBText;
    gbxTEF: TGroupBox;
    dtxNomeRedeTEF: TtecDBText;
    dtxcodigoCliente: TtecDBText;
    lblConfirmados: TLabel;
    fraListaFiliais1: TfraListaFiliais;
    fraListaTiposdeRecebimentos1: TfraListaTiposdeRecebimentos;
    gbxEmissao: TGroupBox;
    edtDataInicialEmissao: TEditData;
    edtDataFinalEmissao: TEditData;
    lblA: TLabel;
    gbxVencimentos: TGroupBox;
    edtDataInicialVencto: TEditData;
    edtDataFinalVencto: TEditData;
    Label1: TLabel;
    gbxClientes: TGroupBox;
    fraConsultaClientes: TfraConsultaCodigo;
    procedure sbnGerarClick(Sender: TObject);
    procedure sbnConfirmaClick(Sender: TObject);
    procedure dbgDetalhadoKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure dbgDetalhadoDblClick(Sender: TObject);
    procedure pgcControleRecebimentosChange(Sender: TObject);
    procedure dbgDetalhadoDrawColumnCell(Sender: TObject;
      const Rect: TRect; DataCol: Integer; Column: TColumn;
      State: TGridDrawState);
    procedure ckbConfirmarTodosClick(Sender: TObject);
    procedure edtTotalMarcadosChange(Sender: TObject);
  private
    procedure ConsultarRecebimentos;
    procedure GravarRecebimentos;
    procedure MarcarSelecionado(Marcando, Todos: Boolean);
    procedure AtualizarContadores(SoMarcados: Boolean);
    { Private declarations }
  protected
    procedure KeyDown(var Key: Word; Shift: TShiftState); override;
    procedure RecebimentosChange(Sender: TObject);
  public
    constructor Create(AOwner: TComponent); override;
    destructor  Destroy; override;
    { Public declarations }
  end;

var
  frmControleRecebimentos: TfrmControleRecebimentos;

implementation

{$R *.dfm}

procedure TfrmControleRecebimentos.ConsultarRecebimentos;
begin
  if dtmControleRecebimentos.ConsultarRecebimentos(edtDataInicialEmissao.text,
    edtDataFinalEmissao.text, edtDataInicialVencto.Text, edtDataFinalVencto.Text,
    fraListaFiliais1.ListaSelecionada,
    fraListaTiposdeRecebimentos1.ListaSelecionada,
    fraConsultaClientes.qryProcuraClientetipo.AsString,
    fraConsultaClientes.edfCodigo.Text,
    rgbConfirmado.ItemIndex) then
  begin
    pgcControleRecebimentos.ActivePage := tstSelecionados;
    pgcControleRecebimentosChange(self);
    AtualizarContadores(False);
    dbgDetalhado.SetFocus;
  end
  else
  begin
    MensagemAviso(format(ctNENHUMREGISTROENCONTRADO,['registro']));
    edtDataInicialEmissao.SetFocus;
  end;
end;

constructor TfrmControleRecebimentos.Create(AOwner: TComponent);
begin
  inherited;
  dtmControleRecebimentos:= TdtmControleRecebimentos.Create(Self);
  with dtmControleRecebimentos do
  begin
    OnRecebimentosChange  := RecebimentosChange;
  end;
  pgcControleRecebimentos.ActivePage := tstParametros;

  edtDataInicialVencto.Text := DateToStr(DataLocal);
  edtDataFinalVencto.Text   := DateToStr(DataLocal);
  fraConsultaClientes.TipoPesquisa    := pesCLIENTES;
  fraConsultaClientes.TipoCliente := 'C';


  fraListaTiposdeRecebimentos1.refresh;

end;

procedure TfrmControleRecebimentos.sbnGerarClick(Sender: TObject);
begin
  inherited;
  ConsultarRecebimentos;
end;

procedure TfrmControleRecebimentos.sbnConfirmaClick(Sender: TObject);
begin
  inherited;
  GravarRecebimentos;
end;

procedure TfrmControleRecebimentos.GravarRecebimentos;
begin
  if dtmControleRecebimentos.GravarRecebimentos then
    sbnGerarClick(nil)
  else
    MensagemAviso(ctERRO);

  if dbgDetalhado.CanFocus then
    dbgDetalhado.SetFocus;
end;

destructor TfrmControleRecebimentos.Destroy;
begin
  frmControleRecebimentos := nil;
  inherited;
end;

procedure TfrmControleRecebimentos.dbgDetalhadoKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if (Key = VK_SPACE) and (Shift = [ssCtrl]) then
    MarcarSelecionado(ckbConfirmarTodos.Checked, False);
end;

procedure TfrmControleRecebimentos.MarcarSelecionado(Marcando,Todos: Boolean);
begin
  dtmControleRecebimentos.ConfirmarRecebimento(Marcando, Todos);
  AtualizarContadores(True);
end;

procedure TfrmControleRecebimentos.dbgDetalhadoDblClick(Sender: TObject);
begin
  inherited;
  MarcarSelecionado(ckbConfirmarTodos.Checked, False);
end;

procedure TfrmControleRecebimentos.pgcControleRecebimentosChange(
  Sender: TObject);
begin
  inherited;
  if pgcControleRecebimentos.ActivePage = tstParametros then
    sbnGerar.Enabled := True
  else
    sbnGerar.Enabled := False;
end;

procedure TfrmControleRecebimentos.KeyDown(var Key: Word;
  Shift: TShiftState);
begin
  inherited;
  case Key of
       VK_F5 : if sbnConfirma.Enabled and not CtrlOn then
                  GravarRecebimentos;
       VK_F6 : if sbnGerar.Enabled and not CtrlOn then
                  ConsultarRecebimentos;
   VK_ESCAPE : if pgcControleRecebimentos.ActivePage = tstSelecionados then
                  pgcControleRecebimentos.ActivePage:= tstParametros
  end;
end;

procedure TfrmControleRecebimentos.dbgDetalhadoDrawColumnCell(
  Sender: TObject; const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  inherited;
  if dbgDetalhado.DataSource.DataSet.FieldByName('confirmado').AsBoolean then begin
    TDBGrid(Sender).Canvas.Brush.Color := clInfoBk;
    TDBGrid(Sender).Canvas.Font.Color := clBlack;
  end;
  TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
end;

procedure TfrmControleRecebimentos.AtualizarContadores(
  SoMarcados: Boolean);
begin
  with dtmControleRecebimentos do begin
    if not SoMarcados then begin
      edtQtdeRecebimentos.Text  := IntToStr(QtdeRecebimentos);
      edtTotalRecebimentos.Text := Format('%8.2m', [TotalRecebimentos]);
    end;
    edtQtdeMarcados.Text  := IntToStr(QtdeMarcados);
    edtTotalMarcados.Text := Format('%8.2m', [TotalMarcados]);
  end;
end;

procedure TfrmControleRecebimentos.RecebimentosChange(Sender: TObject);
begin
  AtualizarContadores(False);
end;

procedure TfrmControleRecebimentos.ckbConfirmarTodosClick(Sender: TObject);
begin
  inherited;
  MarcarSelecionado(ckbConfirmarTodos.Checked,True);
end;

procedure TfrmControleRecebimentos.edtTotalMarcadosChange(Sender: TObject);
begin
  inherited;
  sbnConfirma.Enabled := (edtTotalMarcados.ValorSemFormatacao <> 0)
end;

end.
