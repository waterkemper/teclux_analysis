function TfrmFrenteCaixa.CapturaValor(Titulo:String;ValorInicial:Double): Double;
begin
  Result := 0;
  frmLerValor := TfrmLerValor.Create(frmLerValor,Titulo);
  try
    frmLerValor.Numero := 0;
    if frmLerValor.ShowModal = mrOK then
      Result := frmLerValor.Numero;
  finally
    frmLerValor.Free;
  end;
end;

procedure TfrmFrenteCaixa.EfetuarPagamento(ValorPagto: String);
var
  OK: Boolean;
  Valor: Currency;
begin
  if FEmPagamento > 0 then
  begin
    Valor := abs(StrToCurr(SomenteNumeroF(limpaFloat(ValorPagto))));
    if FEmPagamento = 1 then
      OK := dtmFrenteCaixa.EfetuarPagamento('1', Valor)
    else
    if FEmPagamento = 2 then
      OK := dtmFrenteCaixa.EfetuarPagamento('2', Valor)
    else
    if FEmPagamento = 3 then
    begin
      ok := dtmFrenteCaixa.EfetuarPagamento('3', Valor);
    end
    else
    if FEmPagamento = 4 then
    begin
      ok := False;
      CalcularFinanciamento;
    end
    else
    if FEmPagamento = 5 then
      ok := dtmFrenteCaixa.EfetuarPagamento('5', Valor)
    else
    if FEmPagamento = 6 then //MASTER CREDITO POS
      ok := dtmFrenteCaixa.EfetuarPagamento('6', Valor)
    else
    if FEmPagamento = 7 then //VISA DEBITO POS
      ok := dtmFrenteCaixa.EfetuarPagamento('7', Valor)
    else
    if FEmPagamento = 8 then //VISA CREDITO POS
      ok := dtmFrenteCaixa.EfetuarPagamento('8', Valor)
    else
    if FEmPagamento = 9 then //AMEX DEBITO POS
      OK := dtmFrenteCaixa.EfetuarPagamento('9', Valor)
    else
    if FEmPagamento = 10 then //AMEX CREDITO POS
      OK := dtmFrenteCaixa.EfetuarPagamento('10', Valor)
    else
    if FEmPagamento = 11 then //HIPERCARD DEBITO POS
      OK := dtmFrenteCaixa.EfetuarPagamento('11', Valor)
    else
    if FEmPagamento = 12 then //HIPERCARD CREDITO POS
      OK := dtmFrenteCaixa.EfetuarPagamento('12', Valor);
  end;
  //else if (edtFinalizacao.Text <> '') then
  //  MensagemAviso('Valor tem que ser menor ou igual ao total da compra'); //

  //end;

{        if colocarSaldo then begin
    EdtFinalizacao.Text := CurrToStrF(dtmFrenteCaixa.SaldoRestante, ffCurrency, 2);
    EdtFinalizacao.SelectAll;
  end;
}
  if OK then
  begin
    FEmPagamento := -1;
    EdtFinalizacao.Text := '';
    dtmFrenteCaixa.SituacaoCupom := scTotalizado;
    if dtmFrenteCaixa.SaldoRestante > 0 then
      addMensagemGrande('FINALIZANDO A VENDA', False);
  end;

  if FEmFechamento then
   ForcaSetFocusEdtFinalizacao;

  if OK and (dtmFrenteCaixa.SaldoRestante <= 0) then
    setFinalVenda; // Ismael em 09/05/2006 - BUG #1800.

  displayValores;
end;

function TfrmFrenteCaixa.IniciarVenda: Boolean;
begin
  if ParSistema.FrenteCaixaComCliente and
     (MensagemConfirmacao('Deseja informar o cliente ?') = smbOK) then
    ConsultarClientes;
  Result := dtmFrenteCaixa.IniciarVenda
end;

end.
(*
procedure TfrmFrenteCaixa.SelecionarProduto;
var
  Qtdade: Real;

  TotalItem: Currency;
  Ok, Texto: Boolean;
  CodProd  : Real;
begin
  lblDescricao.Font.Color := clBlack;
  Texto := False;
  edtProduto.Text := Trim(edtProduto.Text);
  if Length(edtProduto.Text) < 12 then
  begin
    try
      Qtdade := StrToFloat(edtProduto.Text)
    except
      Qtdade := 0;
      Texto  := True;
    end;
  end;
  if Texto and (edtProduto.Text <> '') then

    Ok := ConsultarProdutos
  else
    OK := True;
  if Length(edtProduto.Text) = 12 then
  begin
    try
      CodProd := StrToCurr(edtProduto.Text);
      edtProduto.Text := '0'+edtProduto.Text;
    except
    end;
  end;
  if edtProduto.Text = '' then begin
    lblDescricao.Caption := '';
    lblPreco.Caption     := '';
    lblTotalProd.Caption := '';
  end else if OK then begin
    if Not dtmFrenteCaixa.VendaAberta then begin
      Ok := dtmFrenteCaixa.IniciarVenda;
      if OK then begin
        lblEmDinheiro.Caption       := '';
        lblValorCheques.Caption     := '';
        lblValorCartao.Caption      := '';
        lblValorTroco.Caption       := '';
        lblTotCompra.Caption        := '';
        lblValorRecebido.Caption    := '';
      end
    end else
      Ok := True;
    if OK then begin
      if dtmFrenteCaixa.ExisteProduto(edtProduto.Text) then begin
        lblDescricao.Caption := dtmFrenteCaixa.Descricao;
        lblPreco.Caption     := dtmFrenteCaixa.PrecoStr;
        if edtQtdade.Text = '' then
          edtQtdade.Text := '1';
        edtQtdade.SelectAll;
        Qtdade               := StrToFloat(edtQtdade.Text);
        TotalItem            := Qtdade * dtmFrenteCaixa.Preco;
        lblTotalProd.Caption := FloatToStrF(TotalItem, ffCurrency, 11, 2);
        IncluirProduto
      end else if (ParSistema.QtdadeMaxFrenteCaixa = 0) or ((0 < Qtdade) and (Qtdade <= ParSistema.QtdadeMaxFrenteCaixa)) then begin
        edtQtdade.Text       := edtProduto.Text;
        lblDescricao.Caption := '';
        edtProduto.Clear;
        edtProduto.SetFocus
      end else begin
        lblDescricao.Caption := 'O Produto '''+edtProduto.Text+''' não foi encontrato';
        lblPreco.Caption     := '';
        lblTotalProd.Caption := '';
        edtProduto.Clear;
        edtProduto.SetFocus;
      end;
    end;
  end;
end;*)
