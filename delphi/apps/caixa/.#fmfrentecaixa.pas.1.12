{
procedure TfrmFrenteCaixa.TotalizarVenda(Caracter:char;Tipo:String);
var
  OK: Boolean;
  Valor: Currency;
  Titulo: String;
begin
  if Caracter = 'D' then
    if Tipo = 'V' then
      Titulo := 'Desconto'
    else
      Titulo := Titulo + ' Percentual'
  else
    if Tipo = 'V' then
      Titulo := 'Acréscimo'
    else
      Titulo := Titulo + ' Percentual';

  frmLerValor := TfrmLerValor.Create(Self,Titulo);
  try
    OK := False;
    frmLerValor.Numero := 0;
    OK := frmLerValor.ShowModal = mrOK;
    if OK then
    begin
      Valor := frmLerValor.Numero;
      if (Tipo='P') then
        Valor := ValorDoPercentualSobreTotal(dtmFrenteCaixa.TotalPagar,Valor);
      EdtFinalizacao.Text:=FloatToStr(Valor);
      EdtFinalizacaoKeyPress(edtfinalizacao,Caracter);
    end;
  finally
    frmLerValor.Free;
    EdtFinalizacao.SetFocus;
  end;
end;
}
