procedure TfrmFrenteCaixa.edtProdutoKeyPress(Sender: TObject;
  var Key: Char);
begin
  inherited;
  if not (naoExecutarKeyPess) then
  begin
    // Ismael em 23/05/2006 - Quando é pressionado o * ele adiciona o valor que está antes dele como a quantidade de itens.
    if Key = #13 then  // ENTER
    begin
      Key := #0;
      SelecionarProduto;
    end;

    if Key = '*' then
    begin
      Key := #0;
      AdicionaQuantidade(edtProduto.Text);
    end;

    if key = #27 then  // ESC
    begin
      Key := #0;
      CancelarVenda;
    end;

    if (Key = 'd') or (Key = 'D') then
    begin
      try
        StrToCurr(edtProduto.Text);
        Key := #0;
        AdicionaDescontoItem(edtProduto.Text);
      except
      end;
    end;
  end
  else
    naoExecutarKeyPess := False;
end;

procedure TfrmFrenteCaixa.AdicionaQuantidade(Valor:String);
var
  text : String;
  valorQTDE : Currency;
begin
  text := Valor;
  // Está opção é para quando é precionado o * sem algum valor ou zero. Estão ele colocará 1.
  if (text = '') or (text = '0') then
    text := '1';

  if text <> '' then
  begin
    // Agora converte o valor para curreny para verificar se é uma quantidade válida.
    // e este try/except para se não for um número.
    try
      valorQTDE := StrToCurr(text);
    except
      valorQTDE := 1;
    end;
    text := CurrToStr(Abs(valorQTDE));
    edtQtdade.Text := text;
    edtProduto.Text := '';
    ForcaSetFocusEdtProduto;
  end;
end;

procedure TfrmFrenteCaixa.edtFinalizacaoKeyPress(Sender: TObject;
  var Key: Char);
var
  PodeEfetuaPagamento : Boolean;
  TipoPesquisa: String;
begin
  inherited;
  if not naoExecutarKeyPess then
  begin
    if key = #27 then  // ESC
    begin
      if dtmFrenteCaixa.SituacaoCupom = scTotalizado then
        CancelarVenda
      else
      begin
        Key := #0;
        if (dtmFrenteCaixa.SituacaoCupom < scTotalizado) and (FEmPagamento = -1) then // EFETUOU NENHUM PAGAMENTO AINDA
          retornaLancamento
        else
        if FEmPagamento > 0 then  // CANCELAR A FORMA DE PAGAMENTO ESCOLHIDA
        begin
          FEmPagamento := -1;
          dtmFrenteCaixa.SituacaoCupom := scTotalizado;
          EdtFinalizacao.Text := '';
          addMensagemGrande('FINALIZANDO A VENDA', False);
          ForcaSetFocusEdtFinalizacao;
        end
        else
          CancelarVenda;
      end;
    end
    else
    if key = #13 then   // ENTER
    begin
      Key := #0;
      PodeEfetuaPagamento := True;
      TipoPesquisa := ANSIUpperCase(copy(EdtFinalizacao.Text,0,3));
      { Inicia pesquisa pelo nome do cliente }
      if ANSIUpperCase(copy(EdtFinalizacao.Text,0,3)) = 'CPF' then
      begin
        PodeEfetuaPagamento := False;
        dtmFrenteCaixa.consultaClienteCPF(copy(EdtFinalizacao.Text,4, Length(EdtFinalizacao.Text)-3));
        EdtFinalizacao.Text := '';
      end
      else
      begin
        TipoPesquisa := ANSIUpperCase(copy(EdtFinalizacao.Text,0,2));
        { Inicia pesquisa pelo código do vendedor }
        if TipoPesquisa = 'CV' then
        begin
          PodeEfetuaPagamento := False;
          dtmFrenteCaixa.consultaVendedorCodigo(StrToInt(copy(EdtFinalizacao.Text,3, Length(EdtFinalizacao.Text)-2)));
          EdtFinalizacao.Text := '';
        end
        else
        { Inicia pesquisa pelo código do cliente }
        if TipoPesquisa = 'CC' then
        begin
          PodeEfetuaPagamento := False;
          dtmFrenteCaixa.consultaClienteCodigo(StrToInt(copy(EdtFinalizacao.Text,3, Length(EdtFinalizacao.Text)-2) ) );
          EdtFinalizacao.Text := '';
        end
        else
        { Inicia pesquisa pelo código do cliente }
        if TipoPesquisa = 'VN' then
        begin
          PodeEfetuaPagamento := False;
          dtmFrenteCaixa.consultaVendedorNome(copy(EdtFinalizacao.Text,3, Length(EdtFinalizacao.Text)-2));
          InternoPesquisar('');
          EdtFinalizacao.Text := '';
        end
        else
        { Inicia pesquisa pelo nome do cliente }
        if TipoPesquisa = 'CN' then
        begin
          PodeEfetuaPagamento := False;
          EdtFinalizacao.Text := '';
        end;
      end;
      if PodeEfetuaPagamento then
      begin
        if dtmFrenteCaixa.SituacaoCupom = scPagamento then
          EfetuarPagamento(EdtFinalizacao.Text)
        else
//        if dtmFrenteCaixa.SituacaoCupom = scTotalizado then
          SelecionarFormaPagto(EdtFinalizacao.Text);
      end;
    end
    else
    { Adiciona desconto sobre o valor total da venda }
    if (key = 'd') or (key = 'D') then
    begin
      if dtmFrenteCaixa.SituacaoCupom < scTotalizado then
      begin
        try
          StrToCurr(EdtFinalizacao.Text);
          AdicionaDescontoTotal;
          Key := #0;
          EdtFinalizacao.Text := '';
        except
          if copy(EdtFinalizacao.Text, length(EdtFinalizacao.Text),1) = 'P' then
          begin
            try
              StrToInt(copy(EdtFinalizacao.Text, 0, length(EdtFinalizacao.Text)-1));
              AdicionaDescontoTotal;
              Key := #0;
              EdtFinalizacao.Text := '';
            except
            end;
          end;
        end;
      end
      else
        MensagemAviso('Cupom já totalizado!')
    end
    else
    { Adiciona Acrescimo sobre o valor total da venda }
    if (key = 'a') or (key = 'A') then
    begin
      if dtmFrenteCaixa.SituacaoCupom < scTotalizado then
      begin
        try
          StrToCurr(EdtFinalizacao.Text);
          AdicionaAcrescimoTotal;
          Key := #0;
          EdtFinalizacao.Text := '';
        except
          if copy(EdtFinalizacao.Text, length(EdtFinalizacao.Text),1) = 'P' then
          begin
            try
              StrToInt(copy(EdtFinalizacao.Text, 0, length(EdtFinalizacao.Text)-1));
              AdicionaAcrescimoTotal;
              Key := #0;
              EdtFinalizacao.Text := '';
            except
            end;
          end;
        end;
      end
      else
         MensagemAviso('Cupom já totalizado!')
    end;
  end
  else
    naoExecutarKeyPess := True;
end;

