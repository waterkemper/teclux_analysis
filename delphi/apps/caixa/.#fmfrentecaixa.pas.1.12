  Panel6.Color       := stringtoColor(ParSistema.CorFundoFrenteCaixa);
  gbxVenda.color     := stringtoColor(ParSistema.CorFundoFrenteCaixa);
  Panel7.Color       := stringtoColor(ParSistema.CorFundoFrenteCaixa);
  Panel10.Color      := stringtoColor(ParSistema.CorFundoFrenteCaixa);

  //campos
  lblDescontoComposto.Color:= stringtoColor(ParSistema.CorCamposFrenteCaixa);
  dtxCliente.Color         := stringtoColor(ParSistema.CorCamposFrenteCaixa);
  dtxVendedor.Color        := stringtoColor(ParSistema.CorCamposFrenteCaixa);
  edtDescontoItem.Color    := stringtoColor(ParSistema.CorCamposFrenteCaixa);
  lblTotCompra.Color       := stringtoColor(ParSistema.CorCamposFrenteCaixa);
  lblValorAcrescimo.Color  := stringtoColor(ParSistema.CorCamposFrenteCaixa);
