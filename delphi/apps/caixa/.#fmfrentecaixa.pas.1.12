procedure TfrmFrenteCaixa.CalcularFinanciamento;
var
  TotalCalcular: Currency;
  Parcelas     : TResumosParcelas;
//  x : vString;
begin
  inherited;
//  x := nil;
  Parcelas := nil;
  frmCalculoFinanciamento := TfrmCalculoFinanciamento(TfrmCalculoFinanciamento.Referencia);
  if Assigned(frmCalculoFinanciamento) then
    frmCalculoFinanciamento.SetFocus
  else begin
    TotalCalcular:= dtmFrenteCaixa.TotalPagar;
    frmCalculoFinanciamento := TfrmCalculoFinanciamento.Create(Owner, True);
    frmCalculoFinanciamento.OntecClose          := OnTecCloseCalculoFinanciamento;
    frmCalculoFinanciamento.OntecCloseCancelado := OnTecCloseCanceladoCalculoFinanciamento;
    FEmParcelamento := True;
    frmCalculoFinanciamento.DefinirValoresCalculo(True,
                                                  TotalCalcular,
                                                  0,
                                                  0,
                                                  dtmFrenteCaixa.ValorDesconto,
                                                  0,
                                                  0,
						  0,
                                                  DateToStr(now),
                                                  dtmFrenteCaixa.EstadoFilialBase,
                                                  Parcelas,
                                                  nil, //Grupos
                                                  nil, //Classes
                                                  True,
                                                  0);
    Parcelas := nil;
    Enabled := False;
    tmrAguardando.Enabled := True;
    frmCalculoFinanciamento.BringToFront;
    frmCalculoFinanciamento.SetFocus;
  end;
end;
procedure TfrmFrenteCaixa.OnTecCloseCalculoFinanciamento;
begin
  Enabled := True;
  LerValoresCalculoFinanciamento;
  SetFinalVenda;
end;

procedure TfrmFrenteCaixa.LerValoresCalculoFinanciamento;
var
  Parcelas, ParcContr: TResumosParcelas;
  ValorPrazo,
  TaxaJuros,
  Desconto: Real;
  Plano: Integer;
//  iCount : Integer;
//  iCountNumParcelas : Integer;
begin
  inherited;
  ParcContr := nil;
  frmCalculoFinanciamento := TfrmCalculoFinanciamento(TfrmCalculoFinanciamento.Referencia);
  if Assigned(frmCalculoFinanciamento) and
     frmCalculoFinanciamento.ResumosParcelas(Parcelas, ValorPrazo, TaxaJuros, Desconto, Plano)
  then
  begin
    if Not ParcelasIdenticas(Parcelas, ParcContr) then
    begin
      dtmFrenteCaixa.Plano := Plano;
      dtmFrenteCaixa.Parcelas := Parcelas;
      dtmFrenteCaixa.ValorDesconto:=Desconto;
      dtmFrenteCaixa.GravarVenda;
    end;
    Parcelas  := nil;
    ParcContr := nil;
  end;
end;

function TfrmFrenteCaixa.validaVendedor: Boolean;
  function selecionaVendedor:Boolean;
  begin
    Result := ConsultarVendedor;
  end;

  function sugerirUsuarioComoVendedor:Boolean;
  begin
    if ParSistema.SugerirUsuariOComoVendedorFCx then
    begin
      if dtmFrenteCaixa.qryVendedorcodigo.isNull then
      begin
        if UsuarioLogin.Vendedor then
        begin
          //if MensagemSelecionaOpcao('Não existe um vendedor selecionado. Usar o usuário atual?') = smbYes then
          //begin
            dtmFrenteCaixa.SelecionarVendedor(False, UsuarioLogin.CodigoUsuario);
            Result :=  True;
          //end
          //else
          //begin
           // Result := selecionaVendedor;
          //end;
        end
        else
        begin
          if MensagemConfirmacao('O usuário logado não é um vendedor. Deseja selecionar um vendedor?') = smbOK then
          begin
            Result := selecionaVendedor;
          end
          else
          begin
            if ParSistema.ObrigaVendedorFrenteCaixa then
            begin
              if MensagemConfirmacao('Para realizar uma venda no crediário é necessário informar os dados do vendedor.'+#13+'Deseja informar agora?') = smbOK then
                Result := selecionaVendedor
              else
                Result := False;
            end
            else
            begin
              Result := True;
              FObrigaVendedorNessaVenda := ParSistema.ObrigaVendedorFrenteCaixa;
            end;
          end;
        end;
      end
      else
        Result := True;
    end
    else
      Result := False;
  end;

begin
//  Result := False;
  if ParSistema.FrenteCaixaComVendedor then
  begin
    if ParSistema.ObrigaVendedorFrenteCaixa and ParSistema.SugerirUsuarioComoVendedorFCx then
    begin
      Result := sugerirUsuarioComoVendedor;
    end
    else
    begin
      if ParSistema.ObrigaVendedorFrenteCaixa then
      begin
        if dtmFrenteCaixa.qryVendedorcodigo.isNull then
          Result := selecionaVendedor
        else
          Result := True;
      end
      else
      begin
        if ParSistema.SugerirUsuariOComoVendedorFCx then
        begin
          Result := sugerirUsuarioComoVendedor;
        end
        else
        begin
          if dtmFrenteCaixa.qryVendedorcodigo.isNull  then
            Result := selecionaVendedor
          else
            Result := True;
        end;
      end;
    end;
  end
  else
  begin
    if (EdtFinalizacao.Text = '1') or (EdtFinalizacao.Text = '2') or (EdtFinalizacao.Text = '3') then
      Result := True
    else
      Result := False;
  end;
end;

procedure TfrmFrenteCaixa.AdicionaDescontoItem(Valor: String);
var
  text : String;
  valorDesc : Currency;
begin
  text := Valor;
  // Está opção é para quando é precionado o * sem algum valor. Estão ele colocará 1.
  if text = '' then
    text := '0';

  if text <> '' then
  begin
    // Agora converte o valor para curreny para verificar se é uma quantidade válida.
    // e este try/except para se não for um número.
    try
      valorDesc := StrToCurr(text);
    except
      valorDesc := 1;
    end;
    text := CurrToStr(Abs(valorDesc));
    edtDescontoItem.Text := text;
    edtProduto.Text := '';
    ForcaSetFocusEdtProduto;
  end;
end;

procedure TfrmFrenteCaixa.AdicionaAcrescimoTotal;
var
  valor : Currency;
  percentual : Boolean;
begin
  percentual := False;
  if dtmFrenteCaixa.getValorJaInformado = dtmFrenteCaixa.TotalPagar-dtmFrenteCaixa.ValorTotalDescontoItem then
  begin
    try
      EdtFinalizacao.Text := Trim(EdtFinalizacao.Text);
      valor := StrToCurr(EdtFinalizacao.Text);
      EdtFinalizacao.Text := '';
    except
      if copy(EdtFinalizacao.Text, length(EdtFinalizacao.Text),1) = 'P' then
      begin
        try
          EdtFinalizacao.Text := Trim(copy(EdtFinalizacao.Text, 0, length(EdtFinalizacao.Text)-1));
          valor := StrToCurr(EdtFinalizacao.Text);
          EdtFinalizacao.Text := '';
          percentual := True;
        except
          valor := 0;
        end;
      end
      else
        valor := 0;
    end;
    Valor := Abs(Valor);
    if percentual then
      dtmFrenteCaixa.AdicionarAcrescimo(valor, 'P')
    else
      dtmFrenteCaixa.AdicionarAcrescimo(valor);

    displayValores;
  end
  else
    MensagemAviso('Não é permitido desconto/acréscimo após informada alguma forma de pagamento.');
end;

procedure TfrmFrenteCaixa.AdicionaDescontoTotal;
var
  valor : Currency;
  percentual : Boolean;
begin
  percentual := False;
  if dtmFrenteCaixa.getValorJaInformado = dtmFrenteCaixa.TotalPagar-dtmFrenteCaixa.ValorTotalDescontoItem then
  begin
    try
      EdtFinalizacao.Text := Trim(EdtFinalizacao.Text);
      valor := StrToCurr(EdtFinalizacao.Text);
      EdtFinalizacao.Text := '';
    except
      if copy(EdtFinalizacao.Text, length(EdtFinalizacao.Text),1) = 'P' then
      begin
        try
          EdtFinalizacao.Text := Trim(copy(EdtFinalizacao.Text, 0, length(EdtFinalizacao.Text)-1));
          valor := StrToCurr(EdtFinalizacao.Text);
          EdtFinalizacao.Text := '';
          percentual := True;
        except
          valor := 0;
        end;
      end
      else
        valor := 0;
    end;
    valor := Abs(valor);
    if percentual then
      dtmFrenteCaixa.AdicionarDesconto(valor, 'P')
    else
      dtmFrenteCaixa.AdicionarDesconto(valor);
    displayValores;
  end
  else
    MensagemAviso('Não é permitido desconto/acréscimo após informada alguma forma de pagamento.');
end;

procedure TfrmFrenteCaixa.displayValores;
begin
  lblValorDesconto.Visible := True;
  lblValorDesconto.Caption := FloatToStrF(dtmFrenteCaixa.ValorDesconto , ffCurrency, 11, 2);
  if dtmFrenteCaixa.TemComposto then
  begin
    lblValorDesconto.Visible    := False;
    lblDescontoComposto.Visible := True;
    lblDescontoComposto.Caption := FloatToStrF((dtmFrenteCaixa.DescontoProdutoComposto+dtmFrenteCaixa.ValorDesconto) , ffCurrency, 11, 2);
  end;
  lblValorAcrescimo.Caption := FloatToStrF(dtmFrenteCaixa.ValorAcrescimo, ffCurrency, 11, 2);
  if dtmFrenteCaixa.SaldoRestante > 0 then
    lblSaldoRestante.Caption := 'Saldo'
  else
    lblSaldoRestante.Caption := 'Troco';
  lblValorTroco.Caption      := FloatToStrF(abs(dtmFrenteCaixa.SaldoRestante), ffCurrency, 11, 2);
  lblValorSubTotal.Caption   := FloatToStrF(dtmFrenteCaixa.SubTotal      , ffCurrency, 11, 2);
  lblTotCompra.Caption       := FloatToStrF(dtmFrenteCaixa.ValorTotalCompra, ffCurrency, 11, 2);
  edtTotalQtdade.Caption     := CurrToStr(dtmFrenteCaixa.ValorTotalQuantidade);

  sbnDescontoReais.Visible        := dtmFrenteCaixa.SituacaoCupom < scTotalizado;
  sbnDescontoPorcentagem.Visible  := sbnDescontoReais.Visible;
  sbnAcrescimoReais.Visible       := sbnDescontoReais.Visible;
  sbnAcrescimoPorcentagem.Visible := sbnDescontoReais.Visible;

  sbnDinheiro.Visible := not dtmFrenteCaixa.PagandoTEF;
  sbnCheque.Visible   := sbnDinheiro.Visible;
  sbnCrediario.Visible:= false;
end;

