procedure TfrmFrenteCaixa.SelecionarProduto;
var
  Qtdade: Real;
//  ValorDesc : Currency;
//  TotalItem: Currency;
  Ok, Texto: Boolean;
begin
  Qtdade := 1*0;
{
  // Ismael em 09/05/2006 - BUG #1800.
  if not dtmFrenteCaixa.VendaAberta then
    setInicioVenda;
}
  Texto := False;
  edtProduto.Text := Trim(edtProduto.Text);
  try
    Qtdade := StrToInt64(edtProduto.Text)
  except
    Qtdade := 0;
    Texto  := True;
  end;

  if Texto then
    Ok := ConsultarProdutos
  else
    OK := True;

  if OK then
  begin
    if Not dtmFrenteCaixa.VendaAberta then
      Ok := IniciarVenda
    else
      Ok := True;
  end;
{
  if Length(edtProduto.Text) = 12 then
  begin
    try
      Qtdade := StrToFloat(edtProduto.Text);
      edtProduto.Text := '0'+edtProduto.Text;
    except
    end;
  end;
}
  if edtProduto.Text <> '' then
  begin
    if OK then
    begin
      if dtmFrenteCaixa.ExisteProduto(edtProduto.Text) then
      begin
        if dtmFrenteCaixa.produtoPromocao then
          addMensagemGrande(dtmFrenteCaixa.Descricao, True)
        else
          addMensagemGrande(dtmFrenteCaixa.Descricao, False);

        if edtQtdade.Text = '' then
          edtQtdade.Text := '1';
        edtQtdade.SelectAll;
        Qtdade               := edtQtdade.ValorSemFormatacao;
//          try
        edtDescontoItem.Text := Trim(edtDescontoItem.Text);
//            ValorDesc            := StrToCurr(edtDescontoItem.Text);
//          except
//            ValorDesc := 0;
//          end;
//          TotalItem := (Qtdade * dtmFrenteCaixa.Preco)-ValorDesc;
        IncluirProduto;
      end
      else
      begin
        addMensagemGrande('O Produto '''+edtProduto.Text+''' não foi encontrado', True);
        edtProduto.Clear;
        edtProduto.SetFocus
      end;
    end
    else
      edtProduto.Clear;
  end;
  // Ismael em 09/05/2006 - Verificar melhor descrição em ForcaSetFocusEdtProduto
  ForcaSetFocusEdtProduto;
end;

