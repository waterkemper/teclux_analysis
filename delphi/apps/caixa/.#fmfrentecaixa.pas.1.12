  naoExecutarKeyPess : Boolean;
//  Troco: Currency;
//  frmLerValor: TfrmLerValor;

procedure TfrmFrenteCaixa.AtualizarData;
var
  Str: String;
begin
  DateTimeToString(Str, 'dd/mmm/yy hh:nn', Now);
  UsuarioLogin.Vendedor
end;

procedure TfrmFrenteCaixa.CancelarItem;
begin
  if not FEmFechamento then
  begin
    dtmFrenteCaixa.CancelarItem;
    displayValores;
    ForcaSetFocusEdtProduto;
  end;
end;

procedure TfrmFrenteCaixa.CancelarVenda;
begin
  if dtmFrenteCaixa.VendaAberta then
  begin
//    if dtmFrenteCaixa.VendaAberta then
//    begin
      if MensagemConfirmacao(ctCONFIRMECANCELAMENTOVENDA) = smbOK then
      begin
        if dtmFrenteCaixa.CancelarVenda then
        begin
          zeraVariaveis;
        end;
      end;
//    end;
  end
  else
  begin
    MensagemAviso('Não existe uma venda iniciada.');
  end;
end;

function TfrmFrenteCaixa.ConsultarClientes: Boolean;
var
  i : Integer;
  iCliente : Integer;
begin
//  frmClienteFrenteCaixa:= nil;
  frmClienteFrenteCaixa := TfrmClienteFrenteCaixa.Create(frmClienteFrenteCaixa);
  iCliente := dtmFrenteCaixa.CodigoCliente;
  i:= frmClienteFrenteCaixa.ShowModal;
  frmClienteFrenteCaixa.Free;
  Result := False;

  if i = mrCancel then
    dtmFrenteCaixa.FechaClientes(True);
  if i = mrAbort then
    dtmFrenteCaixa.consultaClienteCodigo(iCliente);
  if i = mrOK then
    Result := True;
  SetFocus;
end;

function TfrmFrenteCaixa.ConsultarProdutos: Boolean;
begin
  Result := False;
  if InternoPesquisar(ctPRODUTO) = mrOK then
    Result := True;
end;

function TfrmFrenteCaixa.ConsultarVendedor: Boolean;
begin
  Result := InternoPesquisar(ctVENDEDORES) = mrOk;
end;

constructor TfrmFrenteCaixa.Create(Aowner: TComponent);
begin
  inherited;
  sbnMeta.Visible:=ParSistema.ExibirMetasdeVenda;
  sbnComandosECF.Visible := dtmFrenteCaixa.ECFInstalado;
  edtProduto.Alignment := taRightJustify;
  edtQtdade.Alignment := taRightJustify;
  edtDescontoItem.Alignment := taRightJustify;
  edtFinalizacao.Alignment := taRightJustify;
end;

procedure TfrmFrenteCaixa.dbgProdutosVendidosDrawColumnCell(Sender: TObject; const Rect: TRect;
  DataCol: Integer; Column: TColumn; State: TGridDrawState);
begin
  inherited;
  if dtmFrenteCaixa.Cancelado then begin
    TDBGrid(Sender).Canvas.Brush.Color := $000055FF;
    TDBGrid(Sender).Canvas.Font.Color := clBlack;
  end else if dtmFrenteCaixa.Selecionado then begin
    TDBGrid(Sender).Canvas.Brush.Color := $00FFAA00;
    TDBGrid(Sender).Canvas.Font.Color := clBlack;
  end else if dtmFrenteCaixa.ParaEntregar then begin
    TDBGrid(Sender).Canvas.Brush.Color := $00FDDBC7;
    TDBGrid(Sender).Canvas.Font.Color := lblParaEntregar.Font.Color;
  end;
  edtTotalQtdade.Height := 32;
  AplicarCores;
  TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
end;

procedure TfrmFrenteCaixa.dbgProdutosVendidosExit(Sender: TObject);
begin
  inherited;
  dtmFrenteCaixa.DesmarcarTodos
end;

procedure TfrmFrenteCaixa.dbgProdutosVendidosKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;
  if (Key = VK_SPACE) and (Shift = []) then
    dtmFrenteCaixa.SelecionarItem;
end;

destructor TfrmFrenteCaixa.Destroy;
begin
  dtmFrenteCaixa:=nil;
  inherited;
end;

procedure TfrmFrenteCaixa.SelecionarFormaPagto(TipoPagamento:String);
var
  ok : Boolean;
  pode : Boolean;
begin

  if dtmFrenteCaixa.PagandoTEF and (TipoPagamento <> '3') then
  begin
    MensagemAviso('Forma de pagamento desabilitada temporariamente!');
    edtFinalizacao.Text := '';
    exit;
  end;
  ok := False;
  FExibirMensagemVendaConcluida := True;
  if (dtmFrenteCaixa.TotalPagar > 0) and (dtmFrenteCaixa.SaldoRestante > 0) then
  begin
    if not dtmFrenteCaixa.TransferenciaNaoConfirmada then
    begin
      pode := NOT ParSistema.ObrigaVendedorFrenteCaixa;
      if NOT pode then
        pode := validaVendedor;
      TipoPagamento := SomenteNumero(TipoPagamento);
      if (TipoPagamento = '4') and not (ParSistema.FrenteCaixaComVendedor) and ParSistema.UsaCarneCFX then
      begin
        pode := True;
        if dtmFrenteCaixa.qryVendedorcodigo.IsNull then
          pode := ConsultarVendedor;
      end;


      if pode then
      begin
        ok := False;
        if (TipoPagamento = '1') and ParSistema.UsaDinheiroCFX then
        begin
          addMensagemGrande('PAGAMENTO EM DINHEIRO', False);
          FEmPagamento := 1;
          ok := True;
        end
        else
        if (TipoPagamento = '2') and ParSistema.UsaChequeCFX then
        begin
          addMensagemGrande('PAGAMENTO EM CHEQUE', False);
          FEmPagamento := 2;
          ok := True;
        end
        else
        if (TipoPagamento = '3') and ParSistema.UsaTEFCFX then
        begin
          if (ParSistema.TipoTEF = tsDEDICADO) or (ParSistema.TipoTEF = tsDISCADO) then
          begin
            addMensagemGrande('PAGAMENTO EM CARTÃO', False);
            FEmPagamento := 3;
            ok := True;
          end
          else
          begin
            MensagemAviso('Opção de pagamento desabilitada.');
            ok := False;
          end;
        end
        else
        if (TipoPagamento = '4') and not (dtmFrenteCaixa.qryVendedorcodigo.isNull) and ParSistema.UsaCarneCFX then
        begin
          if not dtmFrenteCaixa.qryVendedorcodigo.isNull then
          begin
            if not dtmFrenteCaixa.qryClientecodigo.IsNull then
            begin
              ok := True;
            end
            else
            begin
              if ConsultarClientes then
                SelecionarFormaPagto(TipoPagamento)
              else
                ok := False;
            end;
          end
          else
          begin
            if validaVendedor then
              SelecionarFormaPagto(TipoPagamento)
            else
              ok := False;
          end;
          if ok then
          begin
            FExibirMensagemVendaConcluida := False;
            zeraVariaveisFechamento;
            EdtFinalizacao.Text := CurrToStrF(dtmFrenteCaixa.SaldoRestante, ffCurrency, 2);
            addMensagemGrande('PAGAMENTO EM CARNÊ', False);
            FEmPagamento := 4;
            ok := False;
          end;
        end
        else
        if (TipoPagamento = '5') and ParSistema.UsaMASTERDEBITOPOS then
        begin
          addMensagemGrande('PAGAMENTO EM CARTÃO - MASTER DÉBITO', False);
          FEmPagamento := 5;
          ok := True;
        end
        else
        if (TipoPagamento = '6') and ParSistema.UsaMASTERCREDITOPOS then
        begin
          addMensagemGrande('PAGAMENTO EM CARTÃO - MASTER CRÉDITO', False);
          FEmPagamento := 6;
          ok := True;
        end
        else
        if (TipoPagamento = '7') and ParSistema.UsaVISADEBITOPOS then
        begin
          addMensagemGrande('PAGAMENTO EM CARTÃO - VISA DÉBITO', False);
          FEmPagamento := 7;
          ok := True;
        end
        else
        if (TipoPagamento = '8') and ParSistema.UsaVISACREDITOPOS then
        begin
          addMensagemGrande('PAGAMENTO EM CARTÃO - VISA CRÉDITO', False);
          FEmPagamento := 8;
          ok := True;
        end
        else
        if (TipoPagamento = '9') and ParSistema.UsaAMEXDEBITOPOS then
        begin
          addMensagemGrande('PAGAMENTO EM CARTÃO - AMEX DÉBITO', False);
          FEmPagamento := 9;
          ok := True;
        end
        else
        if (TipoPagamento = '10') and ParSistema.UsaAMEXCREDITOPOS then
        begin
          addMensagemGrande('PAGAMENTO EM CARTÃO - AMEX CRÉDITO', False);
          FEmPagamento := 10;
          ok := True;
        end
        else
        if (TipoPagamento = '11') and ParSistema.UsaHIPERCARDDEBITOPOS then
        begin
          addMensagemGrande('PAGAMENTO EM CARTÃO - HIPERCARD DÉBITO', False);
          FEmPagamento := 11;
          ok := True;
        end
        else
        if (TipoPagamento = '12') and ParSistema.UsaHIPERCARDCREDITOPOS then
        begin
          addMensagemGrande('PAGAMENTO EM CARTÃO - HIPERCARD CRÉDITO', False);
          FEmPagamento := 12;
          ok := True;
        end;

        if ok then
        begin
//          if dtmFrenteCaixa.SituacaoCupom < scTotalizado then
//            dtmFrenteCaixa.TotalizarCupom;
          dtmFrenteCaixa.SituacaoCupom := scPagamento;
          EdtFinalizacao.Text := FormatarValor(dtmFrenteCaixa.SaldoRestante,2);
          edtFinalizacao.SelectAll;
        end;
      end;
    end
    else
      MensagemAviso(ctCAIXATRANSFERENCIANAOCONFIRMADA);
  end;
   if TipoPagamento <> '' then
   begin
   sbnDescontoReais.Visible        := False;
   sbnDescontoPorcentagem.Visible  := False;
   sbnAcrescimoReais.Visible       := False;
   sbnAcrescimoPorcentagem.Visible := False;
   end;
end;

procedure TfrmFrenteCaixa.EstornoPagamentos;
begin
  if MensagemConfirmacao('Confirme os estornos dos pagamentos.') = smbOK then
  begin
    if dtmFrenteCaixa.EstornoPagamento then
    begin
    end;
  end;
  ForcaSetFocusEdtProduto;
end;

function TfrmFrenteCaixa.ExisteVendedor(Parametro: Integer; NomeCampo: String; Value: Variant): Boolean;
begin
  Result := dtmFrenteCaixa.ExisteVendedor(NomeCampo, Value)
end;

procedure TfrmFrenteCaixa.FormCloseQuery(Sender: TObject; var CanClose: Boolean);
//var Htaskbar: THandle;
begin
  inherited;
  CanClose := (Not dtmFrenteCaixa.VendaAberta) or (MensagemConfirmacao(ctINFORMACOESSERAOPERDIDAS) = smbOk);
  if CanClose then begin
//     htaskbar := FindWindow('Shell_TrayWnd',Nil);  // Torna visivel a barra de ferramentas do windows
//     ShowWindow(Htaskbar, Sw_Normal);
    if FrenteCaixa then
      Application.Terminate;
  end;
end;

procedure TfrmFrenteCaixa.FormShow(Sender: TObject);
//var Htaskbar: THandle;
begin
//  htaskbar := FindWindow('Shell_TrayWnd',Nil);  //Esconde a barra de ferramentas do windows
//  ShowWindow(Htaskbar, Sw_Hide);

  inherited;
{$IFDEF LINUX}
  //Contornar bugs na CLX
  WindowState := wsNormal;
  WindowState := wsMaximized;
{$ENDIF}
  if FileExists(ParSistema.DiretorioImagens+'logoautomacao.bmp') then
  begin
    ImgLogoLancamento.Picture.LoadFromFile(ParSistema.DiretorioImagens+'logoautomacao.bmp');
    ImgLogoFechamento.Picture.LoadFromFile(ParSistema.DiretorioImagens+'logoautomacao.bmp');
  end;
  setInicioSistema;
end;

procedure TfrmFrenteCaixa.IncluirProduto;
var
  Qtdade: currency;
  ValorDescItem : Currency;
begin
  try
    edtDescontoItem.Text := Trim(edtDescontoItem.Text);
    ValorDescItem := StrToCurr(edtDescontoItem.Text);
  except
    ValorDescItem := 0;
  end;

  try
//    edtQtdade.Text := Trim(edtQtdade.Text);
    Qtdade := edtQtdade.ValorSemFormatacao;
  except
    Qtdade := 0;
  end;
  if (Qtdade > 0) and (Trim(edtProduto.Text) <> '') then
  begin
    dtmFrenteCaixa.Quantidade := Qtdade;
    dtmFrenteCaixa.ValorDescontoItem := ValorDescItem;
    if dtmFrenteCaixa.IncluirProduto then
    begin
      displayValores;
      edtProduto.Clear;
      edtQtdade.Text         := '1';
      edtDescontoItem.Text   := '';
    end;
  end;
end;

procedure TfrmFrenteCaixa.KeyDown(var Key: Word; Shift: TShiftState);
var
  UsusAut: TtecUsuarios;
begin
  if Shift = [] then
  begin
    case Key of
      VK_F2: FinalizaSistema;
      VK_F3: sbnFinalizarVendaClick(nil); {if (FVendaInciada) then iniciaFechamentoVenda}
      VK_F4: autenticacao;
      VK_F5: fechamentoCaixa;
      VK_F6: ConsultarVendedor;
      VK_F7: ConsultarClientes;
      VK_F8: CancelarItem;
      VK_F9: if not (FEmFechamento) then
                SelecionarProduto;
      VK_F10: sbnMeta.Click;
      VK_F11: if dtmFrenteCaixa.ECFInstalado then
                 sbnComandosECF.Click;
    end
  end
  else
  begin
    if Shift = [ssCtrl] then
    begin

      if (Key = VK_M) then
      begin
        naoExecutarKeyPess := true;
        UsusAut := dtmFrenteCaixa.ObterAutorizacao(taLOGIN, ctMENUPRINCIPAL, ctADMINISTRADOR);
        if Assigned(UsusAut) and ((UsusAut.NomeUsuario = UsuarioLogin.NomeUsuario) or UsusAut.Administrador) then
        begin
          TfrmAjuda(FormExists('TfrmTecsoft')).OperacaoPadrao([]);
          Key := 0;
          naoExecutarKeyPess := True;
        end
        else
        begin
          naoExecutarKeyPess := True;
          MensagemAviso(ctUSUARIOSEMPERMISSAO)
        end;
      end
      else
      begin
        if (Key = VK_F) then
        begin
          iniciaFechamentoVenda;
        end
        else
        begin
          if (Key = VK_O) then
          begin
            EstornoPagamentos;
          end
          else
          begin
            if (Key = VK_E) and lblParaEntregar.Visible then
            begin
              if dtmFrenteCaixa.CodigoCliente = 0 then
              begin
                MensagemAviso('Será necessário um cliente para marcar para entregar.');
              end;
            end;
          end;
        end;
      end;
    end;
  end;
end;

