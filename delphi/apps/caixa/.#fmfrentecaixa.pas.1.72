procedure TfrmFrenteCaixa.edtProdutoKeyPress(Sender: TObject;
  var Key: Char);
begin
  inherited;
//  if not naoExecutarKeyPess then
  begin
    if Key = #13 then
    begin
      vLimpar := false;
      if dtmFrenteCaixa.vContinuarLeituraCodigoBarras then
      begin
        if SelecionarProduto then
        begin
          if dtmFrenteCaixa.CondicaoVenderItem then
          begin

            if vLogMessageFrenteCaixa then
              ShowMessage('1 - entrando em CondicaoVenderItem');

            vLimpar := true;
            if not dtmfrentecaixa.qryProdutosVendidos.IsEmpty then
            begin

              if vLogMessageFrenteCaixa then
                ShowMessage('2 - not dtmfrentecaixa.qryProdutosVendidos.IsEmpty');

              edtProduto.Clear;
              edtQtdade.Text         := '1';
              edtDescontoItem.Text   := '';
              vLimpar := false;
            end;
  //          BloquearTeclado(false);

            if vLogMessageFrenteCaixa then
                ShowMessage('3 - VenderItem');
                
            VenderItem;
                                     {
            dtmFrenteCaixa.VenderItem;

            if vlimpar then
            begin
              edtProduto.Clear;
              edtQtdade.Text         := '1';
              edtDescontoItem.Text   := '';
            end;

            displayValores;

            ForcaSetFocusEdtProduto;}



          end
          else
          begin
            edtProduto.Clear;
            edtQtdade.Text         := '1';
            edtDescontoItem.Text   := '';
            dtmfrentecaixa.LogSituacaoErroFrenteCaixa('edtProdutoKeyPress CondicaoVenderItem: [(not qryProdutosDigitados in [Edit,Insert]) and  (qryProdutosDigitados.recordcount <> 0) ]');
            ForcaSetFocusEdtProduto;
          end;
        end;
      end
      else
      begin
        edtProduto.clear;
        edtQtdade.Text         := '1';
        Key := #0;
      end;
    end;

    if Key = '*' then
    begin
      Key := #0;
      AdicionaQuantidade(edtProduto.Text);
    end;

    if key = #27 then  // ESC
    begin
      Key := #0;
      CancelarVenda;
    end;

    if (Key = 'd') or (Key = 'D') then
    begin
      try
        StrToCurr(trocar(trocar(edtProduto.Text,'p',''),'P',''));
        Key := #0;
        AdicionaDescontoItem(edtProduto.Text, ((vPrevious_key = 'p') or
                                               (vPrevious_key = 'P')) );
      except
      end;
    end
    else
    if (Key = 'p') or (Key = 'P') then
      vPrevious_key := key
    else
      vPrevious_key := #0;


  end;

end;

procedure TfrmFrenteCaixa.AdicionaQuantidade(Valor:String);
var
  text : String;
  valorQTDE : Currency;
begin
  text := Valor;
  // Está opção é para quando é precionado o * sem algum valor ou zero. Estão ele colocará 1.
  if (text = '') or (text = '0') then
    text := '1';

  if text <> '' then
  begin
    // Agora converte o valor para curreny para verificar se é uma quantidade válida.
    // e este try/except para se não for um número.
    try
      valorQTDE := StrToCurr(text);
    except
      valorQTDE := 1;
    end;
    text := CurrToStr(Abs(valorQTDE));
    edtQtdade.Text := text;
    edtProduto.Text := '';
    ForcaSetFocusEdtProduto;
  end;
end;

