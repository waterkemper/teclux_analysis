function TfrmFrenteCaixa.InternoPesquisar(Titulo: String): Integer;
begin
  TipoPesquisa := Titulo;
  if TipoPesquisa = ctPRODUTO then
    dtmFrenteCaixa.AbreConsultaProduto(edtProduto.Text);

  if TipoPesquisa = ctVENDEDORES then
    dtmFrenteCaixa.AbreConsultaVendedor;

  Result := inherited InternoPesquisar(TipoPesquisa);
  if Result = mrOK then
  begin
    if TipoPesquisa = ctPRODUTO then
    begin
      edtProduto.Text := dtmFrenteCaixa.CodigoProdutoConsulta;
      Application.ProcessMessages;
    end;
    if TipoPesquisa = ctVENDEDORES then
    begin
      dtmFrenteCaixa.SelecionarVendedor(Not Result = mrOk, 0);
    end;
  end
  else
    edtProduto.Text := '';

  if TipoPesquisa = ctPRODUTO then
  begin
    dtmFrenteCaixa.FechaConsultaProduto;
    JanelaProduto.PesquisaIniciada := true;
  end;

  if TipoPesquisa = ctVENDEDORES then
    dtmFrenteCaixa.FechaConsultaVendedores;

  if FEmFechamento then
    ForcaSetFocusEdtFinalizacao
  else
    ForcaSetFocusEdtProduto;
end;

function TfrmFrenteCaixa.JanelaPesquisa: TfrmConsultaBasica;
var
  Jan : TfrmConsultaPorCampo;
begin
  if TipoPesquisa = ctPRODUTO then
  begin
    if not assigned(JanelaProduto) then
      JanelaProduto := TfrmConsultaPorCampo.Create(nil);

    JanelaProduto.UsarParametrosDaTabela := False;
    JanelaProduto.ConsultaInterativa := False;

    JanelaProduto.UsarParametrodaPesquisa := true;
    JanelaProduto.ParametrodaPesquisa := edtProduto.Text;

    JanelaProduto.ManterParametros := true;
    JanelaProduto.ExibirUltimoParametro := true;
//    JanelaProduto.ReabrirFormulario := true;

    Result := JanelaProduto;

  end
  else
  begin
    Jan := TfrmConsultaPorCampo.Create(nil);
    Jan.UsarParametrosDaTabela := False;
    Jan.ConsultaInterativa := True;
    Result := Jan;
  end;


end;

function TfrmFrenteCaixa.TabelaDePesquisa: TZDataSet;
begin
  Result := inherited TabelaDePesquisa;
  if TipoPesquisa = ctPRODUTO then
    Result := dtmFrenteCaixa.TabelaConsultarProduto;
  if TipoPesquisa = ctVENDEDORES then
    Result := dtmFrenteCaixa.TabelaConsultarVendedor;
end;

