procedure TfrmFrenteCaixa.AtribuirDadosOrcamento(Found: Boolean);
begin
  if fraConsultaOrcamento.edfCodigo.ForeignFound = stFound then
  begin
    fraConsultaOrcamento.onfound := nil;
    fraConsultaOrcamento.edfCodigo.SetFocus;
    dtmFrenteCaixa.VenderItensdoOrcamento(fraConsultaOrcamento.qryProcuraOrcamentos.fieldbyname('codigo').asinteger);
    ForcaSetFocusEdtProduto;
    displayValores;
    fraConsultaOrcamento.onfound := AtribuirDadosOrcamento;

  end;
end;

