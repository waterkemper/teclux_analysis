procedure TfrmFrenteCaixa.sbnComandosECFClick(Sender: TObject);

  procedure ExibirComandosECF;
  begin
    frmComandosECF:= TfrmComandosECF.Create(frmComandosECF);
    if ecfpadrao.CupomAberto then
      frmComandosECF.CancelarCupomnaOrigem := self.CancelarCupomnaOrigem
    else
      frmComandosECF.CancelarCupomnaOrigem := nil;

    frmComandosECF.ShowModal;
    frmComandosECF.Free;
    SetFocus;
  end;

var
  UsuarioAut: TtecUsuarios;
  Autorizado: Boolean;
begin
  inherited;
  if (ParSistema.ExigirGerenteCaixaComandosECF) then
  begin
    try
      UsuarioAut:= dtmFrenteCaixa.ObterAutorizacao(taLOGIN, ctAUTORIZACAOCOMANDOSECF, ctGERENTECAIXA);
      try
        if Assigned(UsuarioAut) then
          Autorizado := UsuarioAut.GerenteCaixa
        else
          Autorizado := False;
        finally
          if Assigned(UsuarioAut) then
            UsuarioAut.Free;
        end;
    except
      Autorizado := False;
    end;
  end
  else
    Autorizado := True;
  if Autorizado then
  begin
    ExibirComandosECF
  end
  else
    MensagemAviso(format(ctUSUARIONAOAUTORIZADO,['executar comandos do ECF.']));
end;

