procedure TfrmFrenteCaixa.AtribuirDadosListaCasamento(Found: Boolean);
begin
  dtmFrenteCaixa.listadeCasamento := fraConsultaListaCasamento.qryProcuraListadeCasamentocodigo.AsInteger;
