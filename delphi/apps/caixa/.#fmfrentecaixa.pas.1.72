procedure TfrmFrenteCaixa.sbnFinalizarVendaClick(Sender: TObject);
begin
  inherited;
  if not dtmFrenteCaixa.qryProdutosVendidos.IsEmpty then
    if not dtmFrenteCaixa.TransferenciaNaoConfirmada then
    begin
      if dtmFrenteCaixa.SituacaoCupom = scProdutos then
        if validaVendedor then
          iniciaFechamentoVenda;
    end
    else
      MensagemAviso(ctCAIXATRANSFERENCIANAOCONFIRMADA)
  else
    MensagemAviso(ctNENHUMPRODUTOADICIONADO);
end;

