procedure TfrmFrenteCaixa.setInicioSistema;
begin

{$IFNDEF LINUX}
//  BorderStyle := fbsNone;
  WindowState := wsNormal;
{$ENDIF}
  Constraints.MaxHeight:= 0;
  Constraints.MaxWidth := 0;
  Constraints.MinHeight:= 0;
  Constraints.MinWidth := 0;
  dtmFrenteCaixa       := TdtmFrenteCaixa.Create(Self);
{  if not dtmFrenteCaixa.qryLogotipos.IsEmpty then
  if not FileExists(ParSistema.DiretorioImagens+dtmFrenteCaixa.NomeLogotipo) then
    MensagemAviso('Logotipo '+dtmFrenteCaixa.NomeLogotipo+' não existe.')
  else begin
} if FileExists(ParSistema.DiretorioImagens+dtmFrenteCaixa.NomeLogotipo) then
  begin
    ImgLogoLancamento.Picture.LoadFromFile(ParSistema.DiretorioImagens+dtmFrenteCaixa.NomeLogotipo);
//    ImgLogoFechamento.Picture.LoadFromFile(ParSistema.DiretorioImagens+dtmFrenteCaixa.NomeLogotipo);
  end;
  zeraVariaveis;
end;

procedure TfrmFrenteCaixa.zeraVariaveis;
begin
  addMensagemGrande('CAIXA LIVRE', False);
//  FVendaInciada         := False;
  FEmFechamento         := False;
//  pnlLancamento.Visible := False;
  pnlFechamento.Visible := False;
  TrocaTela(false);
  lblMensagemGrande.Font.Color := clRed;
  lblTotCompra.Caption   := '';
  edtTotalQtdade.Caption := '';
  edtDescontoItem.Text   := '';
//  edtFinalizacao.Text    := '';
  edtProduto.Text        := '';

  dtmFrenteCaixa.zeraVariaveis;
  
  zeraVariaveisLancamento;
  zeraVariaveisFechamento;
  lblMensagemPequena.Transparent := True;
  lblMensagemPequena.Caption     := '';
  dtmFrenteCaixa.LimpaItensVendidos;
  dtmFrenteCaixa.LimpaPagamentoTMP;

 { dtmFrenteCaixa.zeraVariaveis; }

  ForcaSetFocusEdtProduto;
  naoExecutarKeyPess          := False;
  FObrigaVendedorNessaVenda   := True;
  lblDescontoComposto.Visible := False;
  edtNumeroNotaVinculada.Text:='';
  with dtmFrenteCaixa do
  begin
    SaldoRestante := 0;
//    ValorDesconto := 0;
//    Desconto_CashBack := 0;
    Desconto_CashBackAnt := 0;
//    ValorAcrescimo := 0;
    qryCliente.close;
    clienteVenda := 0;
    nomeclienteVenda := '';
    qryOrcamentos.close;

    if qryProdutosOrcamentos.active then
      qryProdutosOrcamentos.close;

    fraConsultaOrcamento.edfCodigo.Clear;
    fraConsultaOrcamento.dtxDescricao.Clear;

    qryContratos.close;
    qryProdutosContratos.close;
    fraConsultaOrdemServico.edfCodigo.Clear;
    fraConsultaOrdemServico.dtxDescricao.Clear;
    dtxEquipamento.clear;

  end;

end;

procedure TfrmFrenteCaixa.iniciaFechamentoVenda;
begin
//  dtmFrenteCaixa.CalcularCashBackGerado;
  zeraVariaveisFechamento;
  FEmFechamento := True;
  TrocaTela(true);
//  EdtFinalizacao.SetFocus;
  addMensagemGrande('FINALIZANDO A VENDA', False);
  displayValores;

  FExibirMensagemVendaConcluida := True;
  dtmFrenteCaixa.ObsCupomFiscal := edtObservacao.text;

  if dtmFrenteCaixa.EfetuarMultiplosPagamentos then
  begin
    self.setfocus;
    setFinalVenda // Ismael em 09/05/2006 - BUG #1800.
  end
  else
  if assigned(ecfpadrao) and (ecfpadrao.Estado = estLivre) then
  begin
    zeraVariaveis;
    zeraVariaveisFechamento;
    TrocaTela(false);
    addMensagemGrande('VENDA CANCELADA', False);
    MensagemAviso('VENDA CANCELADA');
    dtmFrenteCaixa.SituacaoCupom := scFechado;
  end
  else
  begin
    if not assigned(ecfpadrao) and (dtmFrenteCaixa.SituacaoCupom = scFechado) then
    begin
      zeraVariaveis;
      zeraVariaveisFechamento;
      TrocaTela(false);
      addMensagemGrande('VENDA CANCELADA', False);
      MensagemAviso('VENDA CANCELADA');
      dtmFrenteCaixa.SituacaoCupom := scFechado;
    end
    else
    begin
      zeraVariaveisFechamento;
      TrocaTela(false);
    end;
  end;
  displayValores;

end;

procedure TfrmFrenteCaixa.retornaLancamento;
begin
  zeraVariaveisFechamento;
  TrocaTela(false);
  ForcaSetFocusEdtProduto;
end;

procedure TfrmFrenteCaixa.zeraVariaveisFechamento;
begin
  dtmFrenteCaixa.zeraFormaPagamento;  {AQUI}
  if FEmFechamento then
    addMensagemGrande('AGUARDANDO PRÓXIMO PRODUTO', False);
  FEmFechamento := False;
  FEmPagamento := -1;
end;

procedure TfrmFrenteCaixa.zeraVariaveisLancamento;
begin
  edtQtdade.Text := '1';
end;

procedure TfrmFrenteCaixa.retornaFechamentoVenda;
begin

end;

procedure TfrmFrenteCaixa.TrocaTela(fechamento: boolean);
begin
  if fechamento then
  begin
    pnlFechamento.Visible := true;
    pnlfechamento.BringToFront;
    pnlFechamento.Repaint;
    gbxvenda.Visible := false;
    gbxvenda.SendToBack;
  end
  else
  begin
    pnlFechamento.Visible := false;
    pnlfechamento.SendToBack;
    gbxvenda.Visible := true;
    gbxvenda.BringToFront;
    gbxvenda.Repaint;
  end;
end;

procedure TfrmFrenteCaixa.FinalizaSistema;
begin
  Close;
  {
  if FrenteCaixa then
    Application.Terminate;
    }
end;

