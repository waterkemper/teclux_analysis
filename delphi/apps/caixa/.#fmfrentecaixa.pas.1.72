function TfrmFrenteCaixa.CapturaValor(Titulo:String;ValorInicial:Double): Double;
begin
  Result := 0;
  frmLerValor := TfrmLerValor.Create(frmLerValor,Titulo);
  try
    frmLerValor.Numero := 0;
    if frmLerValor.ShowModal = mrOK then
      Result := frmLerValor.Numero;
  finally
    frmLerValor.Free;
  end;
end;

