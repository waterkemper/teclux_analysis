function TfrmFrenteCaixa.ExisteInformacao(Parametro: Integer;
  NomeCampo: String; Value: Variant): Boolean;
begin
  Result := False;
  if TipoPesquisa = ctPRODUTO then
  begin
    Result := dtmFrenteCaixa.ExistePesquisaProduto(NomeCampo, Value);
  end;

  if TipoPesquisa = ctVENDEDORES then
  begin
    Result := dtmFrenteCaixa.ExisteVendedor(NomeCampo, Value);
  end;

end;

