  if lblMensagemGrande.Caption <> Text then
  begin
    lblMensagemGrande.Caption := Text;
    if internitente then
      tmrMensagemGrande.Enabled := true
    else
    begin
      tmrMensagemGrande.Enabled := false;
      lblMensagemGrande.Font.Color := clRed;
    end;

//    Application.ProcessMessages;
  end;  
end;

