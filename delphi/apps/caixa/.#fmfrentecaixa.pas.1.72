procedure TfrmFrenteCaixa.AtualizarData;
var
  Str: String;
begin
  DateTimeToString(Str, 'dd/mmm/yy hh:nn', Now);
  UsuarioLogin.Vendedor
end;

procedure TfrmFrenteCaixa.CancelarItem;
begin
  if not FEmFechamento then
  begin
    dtmFrenteCaixa.CancelarItem;
    displayValores;
    ForcaSetFocusEdtProduto;
  end;
end;

procedure TfrmFrenteCaixa.CancelarVenda;
begin
  if dtmFrenteCaixa.VendaAberta then
  begin
//    if dtmFrenteCaixa.VendaAberta then
//    begin
      if MensagemConfirmacao(ctCONFIRMECANCELAMENTOVENDA) = smbOK then
      begin
        if dtmFrenteCaixa.CancelarVenda then
        begin
          zeraVariaveis;
        end;
      end;
//    end;
  end
  else
  begin
    MensagemAviso('Não existe uma venda iniciada.');
  end;
end;


function TfrmFrenteCaixa.ConsultarProdutos: Boolean;
begin
  Result := False;
  if InternoPesquisar(ctPRODUTO) = mrOK then
    Result := True;
end;

function TfrmFrenteCaixa.ConsultarVendedor: Boolean;
begin
  Result := InternoPesquisar(ctVENDEDORES) = mrOk;
end;

constructor TfrmFrenteCaixa.Create(Aowner: TComponent);
begin
  inherited;
  sbnMeta.Visible:=ParSistema.ExibirMetasdeVenda;
  sbnComandosECF.Visible := dtmFrenteCaixa.ECFInstalado;
  edtProduto.Alignment := taRightJustify;
  edtQtdade.Alignment := taRightJustify;
  edtDescontoItem.Alignment := taRightJustify;
//  edtFinalizacao.Alignment := taRightJustify;
  dtmFrenteCaixa.AfterAlteracaoValores := AfterAlteracaoValores;
  dtmFrenteCaixa.AfterAlteracaoSituacaoCupom := AfterAlteracaoSituacaoCupom;

  fraConsultaListaCasamento.TipoPesquisa := pesLISTACASAMENTO;
  fraConsultaListaCasamento.OnFound := AtribuirDadosListaCasamento;

  fraConsultaTabeladePrecos.CondicoesdaConsulta := CondicoesdaConsultaTabeladePrecos;
  fraConsultaTabeladePrecos.OnFound := AtribuirDadosTabeladePrecos;
  fraConsultaTabeladePrecos.TipoPesquisa := pesCOLUNAS;

  fraConsultaTabeladePrecos.edfCodigo.text := fPrecoNormal;
  if fraConsultaTabeladePrecos.edfCodigo.exist then
    AtribuirDadosTabeladePrecos(true);

  fraConsultaOrcamento.TipoPesquisa := pesORCAMENTO;
  fraConsultaOrcamento.CondicoesdaConsulta := CondicoesdaConsultaOrcamentos;
  fraConsultaOrcamento.OnFound := AtribuirDadosOrcamento;
  fraConsultaOrcamento.AbrirTabelaProcura := false;

  fraConsultaOrdemServico.ConsultarTodos := true;
  fraConsultaOrdemServico.TipoPesquisa := PesOrdemServico;
  fraConsultaOrdemServico.CondicoesdaConsulta := CondicoesdaConsultaOrdemServico;
  fraConsultaOrdemServico.OnFound := AtribuirDadosOrdemServico;
  fraConsultaOrdemServico.AbrirTabelaProcura := false;

  dtmfrenteCaixa.RetornarFluxoVendaItem := RetornarFluxoVendaItem;
  dtmfrenteCaixa.MaximizarJanela := MaximizarJanela;

  ThreadsRunning := 2;

  if assigned(tefpadrao) then
    tefpadrao.OnExibirMsgOperador := ExibirMsgOperador


end;

procedure TfrmFrenteCaixa.dbgProdutosVendidosDrawColumnCell(Sender: TObject; const Rect: TRect;
  DataCol: Integer; Column: TColumn; State: TGridDrawState);
begin
  inherited;
  if dtmFrenteCaixa.Cancelado then begin
    TDBGrid(Sender).Canvas.Brush.Color := $000055FF;
    TDBGrid(Sender).Canvas.Font.Color := clBlack;
  end else if dtmFrenteCaixa.Selecionado then begin
    TDBGrid(Sender).Canvas.Brush.Color := $00FFAA00;
    TDBGrid(Sender).Canvas.Font.Color := clBlack;
  end else if dtmFrenteCaixa.ParaEntregar then begin
    TDBGrid(Sender).Canvas.Brush.Color := $00FDDBC7;
    TDBGrid(Sender).Canvas.Font.Color := lblParaEntregar.Font.Color;
  end;
  edtTotalQtdade.Height := 32;
  AplicarCores;
  TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
end;

procedure TfrmFrenteCaixa.dbgProdutosVendidosExit(Sender: TObject);
begin
  inherited;
  dtmFrenteCaixa.DesmarcarTodos
end;

procedure TfrmFrenteCaixa.dbgProdutosVendidosKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;
  if (Key = VK_SPACE) and (Shift = []) then
    dtmFrenteCaixa.SelecionarItem;
end;

destructor TfrmFrenteCaixa.Destroy;
begin
//  frmParcelasRecebimentosFrenteCaixa := nil;
//  dtmFrenteCaixa := nil;
//  FrmClienteFrenteCaixa := nil;
  if assigned(frmCadastroChequeFrenteCaixa)  then
    frmCadastroChequeFrenteCaixa.free;

  if assigned(FrmClienteFrenteCaixa)  then
    FrmClienteFrenteCaixa.free;

  dtmFrenteCaixa.free;
  inherited;
end;



function TfrmFrenteCaixa.ExisteVendedor(Parametro: Integer; NomeCampo: String; Value: Variant): Boolean;
begin
  Result := dtmFrenteCaixa.ExisteVendedor(NomeCampo, Value)
end;

procedure TfrmFrenteCaixa.FormCloseQuery(Sender: TObject; var CanClose: Boolean);
//var Htaskbar: THandle;
begin
  inherited;
  CanClose := (Not dtmFrenteCaixa.VendaAberta) or (MensagemConfirmacao(ctINFORMACOESSERAOPERDIDAS) = smbOk);
  if CanClose then begin
//     htaskbar := FindWindow('Shell_TrayWnd',Nil);  // Torna visivel a barra de ferramentas do windows
//     ShowWindow(Htaskbar, Sw_Normal);
    if ehFrenteCaixa then
      Application.Terminate;
  end;
end;

procedure TfrmFrenteCaixa.FormShow(Sender: TObject);
//var Htaskbar: THandle;
begin
//  htaskbar := FindWindow('Shell_TrayWnd',Nil);  //Esconde a barra de ferramentas do windows
//  ShowWindow(Htaskbar, Sw_Hide);

  inherited;

  //WindowState := wsMaximized;
  if FileExists(ParSistema.DiretorioImagens+'logoautomacao.bmp') then
  begin
    ImgLogoLancamento.Picture.LoadFromFile(ParSistema.DiretorioImagens+'logoautomacao.bmp');
//    ImgLogoFechamento.Picture.LoadFromFile(ParSistema.DiretorioImagens+'logoautomacao.bmp');
  end;

  lblListaCasamento.visible := ParSistema.UtilizarListaCasamento;
  fraConsultaListaCasamento.visible := ParSistema.UtilizarListaCasamento;
  lblTabeladePrecos.visible := parsistema.Permitir_selecionar_tabela_de_preco;
  fraConsultaTabeladePrecos.Visible := parsistema.Permitir_selecionar_tabela_de_preco;

  setInicioSistema;
end;


procedure TfrmFrenteCaixa.KeyDown(var Key: Word; Shift: TShiftState);
var
  UsusAut: TtecUsuarios;
begin
  if Shift = [] then
  begin
    case Key of
      VK_F2: FinalizaSistema;
      VK_F3: sbnFinalizarVendaClick(nil); {if (FVendaInciada) then iniciaFechamentoVenda}
      VK_F4: autenticacao;
      VK_F5: fechamentoCaixa;
      VK_F6: ConsultarVendedor;
      VK_F7: if sbnCliente.Enabled then
             begin
                 dtmFrenteCaixa.ConsultarClientes;
//                 self.setfocus;
             end;
      VK_F8: CancelarItem;
      VK_F9: if not (FEmFechamento) then
             begin
               if ConsultarProdutos then
                 keybd_event(VK_RETURN,0,0,0);
             end;
      VK_F10: begin key:=0;  sbnMeta.Click; end; 
      VK_F11: if dtmFrenteCaixa.ECFInstalado then
                 sbnComandosECF.Click;
    end
  end
  else
  begin
    if Shift = [ssCtrl] then
    begin

      if (Key = VK_M) then
      begin
        naoExecutarKeyPess := true;
        UsusAut := dtmFrenteCaixa.ObterAutorizacao(taLOGIN, ctMENUPRINCIPAL, ctADMINISTRADOR);
        if Assigned(UsusAut) and ((UsusAut.NomeUsuario = UsuarioLogin.NomeUsuario) or UsusAut.Administrador) then
        begin
          TfrmAjuda(FormExists('TfrmTecsoft')).OperacaoPadrao([]);
          Key := 0;
          naoExecutarKeyPess := True;
        end
        else
        begin
          naoExecutarKeyPess := True;
          MensagemAviso(ctUSUARIOSEMPERMISSAO)
        end;
      end
      else
      begin
        if (Key = VK_F) then
        begin
          sbnFinalizarVendaClick(self);
{          iniciaFechamentoVenda;}
        end
        else
        begin
          if (Key = VK_E) and lblParaEntregar.Visible then
          begin
            if dtmFrenteCaixa.CodigoCliente = 0 then
            begin
              MensagemAviso('Será necessário um cliente para marcar para entregar.');
            end;
          end;
        end;
      end;
    end;
  end;
end;

procedure TfrmFrenteCaixa.sbnVendedorClick(Sender: TObject);
begin
  inherited;
  ConsultarVendedor;
end;




function TfrmFrenteCaixa.SelecionarProduto: boolean;
var
  Qtdade: Currency;
  {Ok,} Texto: Boolean;
  ValorDescItem : Currency;

begin
  {OK := true;}

  result := false;
  Qtdade := 1*0;
  Texto := False;
  edtProduto.Text := Trim(edtProduto.Text);
  try
    Qtdade := StrToInt64(edtProduto.Text)
  except
    Qtdade := 0;
    Texto  := True;
  end;

  {
  if Texto then
    Ok := ConsultarProdutos
  else
    OK := True;
  }


  while true do
  begin


    if edtProduto.Text <> '' then
    begin
      result := dtmFrenteCaixa.ExisteProduto(edtProduto.Text);

      if result then
      begin
        if dtmFrenteCaixa.produtoPromocao then
          addMensagemGrande(dtmFrenteCaixa.Descricao, True)
        else
          addMensagemGrande(dtmFrenteCaixa.Descricao, False);

        if edtQtdade.Text = '' then
          edtQtdade.Text := '1';

        edtDescontoItem.Text := Trim(edtDescontoItem.Text);

        try
          edtDescontoItem.Text := Trim(edtDescontoItem.Text);
          ValorDescItem := StrToCurr(trocar(edtDescontoItem.Text,'%',''));
        except
          ValorDescItem := 0;
        end;

        try
          Qtdade := edtQtdade.ValorSemFormatacao;
        except
          Qtdade := 0;
        end;

        if (Qtdade > 0) and (Trim(edtProduto.Text) <> '') then
          result := dtmFrenteCaixa.GuardarItem(Qtdade, ValorDescItem, (pos('%',edtDescontoItem.Text)<>0) );

        break;

      end
      else
      begin
        if not texto then
        begin
          addMensagemGrande('O Produto '''+edtProduto.Text+''' não foi encontrado', True);
          edtProduto.Clear;
        end
        else
        begin
          result := ConsultarProdutos;

          if not result then
            break;

        end;
      end;
    end
    else
    begin
      result := ConsultarProdutos;

      if not result then
        break;
    end;
  end;
  ForcaSetFocusEdtProduto;


end;

procedure TfrmFrenteCaixa.ForcaSetFocusEdtProduto;
begin
  // Ismael em 09/05/2006 - Este evendo foi criado porque quando que era chamada uma
  //                        outra tela no retorno perdia o foco do campo edtProduto.
//  edtQtdade.SetFocus;
  edtProduto.SetFocus;
end;

procedure TfrmFrenteCaixa.CalculoDoTroco;
begin
  inherited;
  if dtmFrenteCaixa.SubTotal > 0 then
  begin
    frmTrocoCaixa := TfrmTrocoCaixa.Create(frmTrocoCaixa);
    try
      frmTrocoCaixa.PagoEmDinheiro := dtmFrenteCaixa.ValorTotalCompra;
      frmTrocoCaixa.ShowModal
    finally
      //FTroco:= frmTrocoCaixa.Troco;
      frmTrocoCaixa.Free
    end
  end
end;


// Ismael em 09/05/2006 - BUG #1800.
procedure TfrmFrenteCaixa.setFinalVenda;
//var
//  frmTelaTroco: TfrmTelatroco;
begin
  displayValores;
  if (FExibirMensagemVendaConcluida and not dtmFrenteCaixa.Excecao) then
  begin
    //if ParSistema.ExibirTelaCalculoTroco then
   //   CalculoDoTroco;
    if dtmFrenteCaixa.SaldoRestante < 0 { Troco > 0} then
    begin
      frmTelaTroco:= Tfrmtelatroco.Create(frmTelaTroco);
      try
        frmTelaTroco.Troco:= abs(dtmFrenteCaixa.SaldoRestante); //dtmFrenteCaixa.Troco;
        frmTelaTroco.ShowModal;
      finally
        frmTelaTroco.Free;
      end;
    end;
    addMensagemGrande('VENDA CONCLUÍDA', False);
    self.setfocus;
    MensagemAviso('VENDA CONCLUÍDA');
    dtmFrenteCaixa.SituacaoCupom := scFechado;
  end
  else
    MensagemAviso('Problemas na conclusão da venda, tente novamente!');
  zeraVariaveis;

  fraConsultaListaCasamento.edfCodigo.Clear;
  fraConsultaListaCasamento.dtxDescricao.Clear;

  dtmFrenteCaixa.ListadeCasamento := 0;

end;

