{
procedure TfrmFrenteCaixa.TotalizarVenda(Caracter:char;Tipo:String);
var
  OK: Boolean;
  Valor: Currency;
  Titulo: String;
begin
  if Caracter = 'D' then
    if Tipo = 'V' then
      Titulo := 'Desconto'
    else
      Titulo := Titulo + ' Percentual'
  else
    if Tipo = 'V' then
      Titulo := 'Acréscimo'
    else
      Titulo := Titulo + ' Percentual';

  frmLerValor := TfrmLerValor.Create(Self,Titulo);
  try
    OK := False;
    frmLerValor.Numero := 0;
    OK := frmLerValor.ShowModal = mrOK;
    if OK then
    begin
      Valor := frmLerValor.Numero;
      if (Tipo='P') then
        Valor := ValorDoPercentualSobreTotal(dtmFrenteCaixa.TotalPagar,Valor);
      EdtFinalizacao.Text:=FloatToStr(Valor);
      EdtFinalizacaoKeyPress(edtfinalizacao,Caracter);
    end;
  finally
    frmLerValor.Free;
    EdtFinalizacao.SetFocus;
  end;
end;
}
{
procedure TfrmFrenteCaixa.EfetuarPagamento(TipoPagamento: String;Titulo:String);
var
 Enter: char;
 frmLerValor: TfrmLerValor;
 OK: Boolean;
 Valor, Valor1: Currency;
begin
  if not dtmFrenteCaixa.TransferenciaNaoConfirmada then
  begin
    frmLerValor := TfrmLerValor.Create(Self,Titulo);
    OK := False;
    try
      frmLerValor.Numero := dtmFrenteCaixa.SaldoRestante;
      OK := (frmLerValor.ShowModal = mrOK);
      if OK then
      begin
        dtmFrenteCaixa.SituacaoCupom := scPagamento;
//         Valor1 := 0;
//         Valor1 := frmLerValor.Numero;
         //if (Valor1 <= dtmFrenteCaixa.SaldoRestante) then
         //begin                                            //---- Carlos 06/03/2007 ----------
             Valor := frmLerValor.Numero;
             Enter:=#13;
             EdtFinalizacao.Text:=Tipopagamento;
             EdtFinalizacaoKeyPress(EdtFinalizacao,Enter);
             EdtFinalizacao.Text:=FloatToStr(Valor);
        // end
        // else
         //MensagemAviso('Valor tem que ser menor ou igual ao total da compra'); //-- Carlos 07/03/2007
      end;
  // if ParSistema.ExibirTelaCalculoTroco then
  //   CalculoDoTroco;

    finally
      frmLerValor.Free;
      if OK then
      begin
        Enter:=#13;
        EdtFinalizacaoKeyPress(EdtFinalizacao,Enter);
      end;
    end;
  end
  else
    MensagemAviso(ctCAIXATRANSFERENCIANAOCONFIRMADA);
end;
}
