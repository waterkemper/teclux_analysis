procedure TfrmFrenteCaixa.sbnConsultartemClick(Sender: TObject);
begin
  inherited;
  if not (FEmFechamento) then
    if ConsultarProdutos then
      keybd_event(VK_RETURN,0,0,0);
end;

function TfrmFrenteCaixa.VenderItem(RetornoFluxoTelaCliente: boolean = false): boolean;
begin
  with dtmFrenteCaixa do
  begin
    if OrigemdaVenda = NaoDefinida_ then
      OrigemdaVenda := FrenteCaixa_;
  end;    

  result := true;

  if parsistema.Permitir_selecionar_tabela_de_preco and
     (fraConsultaTabeladePrecos.edfCodigo.text = '') then
  begin
    result := false;
    MensagemErro('Informe o código da tabela de preço!');
    fraConsultaTabeladePrecos.edfCodigo.setfocus;
    fraConsultaTabeladePrecos.edfCodigo.selectall;
    exit;
  end;

  if dtmFrenteCaixa.VendaAberta or dtmfrentecaixa.selecionarclientevenda(RetornoFluxoTelaCliente) then
    if dtmFrenteCaixa.VendaAberta or dtmfrentecaixa.IniciarVenda then
    begin

      if vLogMessageFrenteCaixa then
        ShowMessage('4 - cliente selecionado e VendaAberta... indo p/ thread VenderItemT');

      dtmFrenteCaixa.VenderItemT;
      if vlimpar then
      begin
        edtProduto.Clear;        edtQtdade.Text         := '1';
        edtDescontoItem.Text   := '';
      end;
      displayValores;
      ForcaSetFocusEdtProduto;
    end;
end;

procedure TfrmFrenteCaixa.RetornarFluxoVendaItem(Sender: TObject);
begin
  ForcaSetFocusEdtProduto;
  VenderItem(true);
  ForcaSetFocusEdtProduto;
  if dtmFrenteCaixa.vJanelaMaximizada then
    MaximizarFrenteCaixa;
  ForcaSetFocusEdtProduto;
end;

procedure TfrmFrenteCaixa.MaximizarJanela(Sender: TObject);
begin
  ForcaSetFocusEdtProduto;
  MaximizarFrenteCaixa;
  ForcaSetFocusEdtProduto;
end;

procedure TfrmFrenteCaixa.CondicoesdaConsultaOrdemServico;
var
  vEquipamento: String;

begin
  vEquipamento := quotedstr(fraConsultaOrdemServico.qryprocuraordemservico.parambyname('numero').asstring);

  if fraConsultaOrdemServico.vEncontradoMultiplosRegistros then
    fraConsultaOrdemServico.qryConsultaClientes.MacroByName('CondicaodaConsulta').AsString := ' and v.tipo = ''C'' and exists (select ct.numero ' +
                                                                                              ' from contratos ct left join produtos p on ct.produto = p.codigo ' +
                                                                                              ' where ct.cliente = v.codigo ' +
                                                                                              ' and ct.tipocliente = ''C'' ' +
                                                                                              ' and coalesce(ct.os,false) ' +
                                                                                              ' and (ct.equipamento = '+ vEquipamento +
                                                                                              ' or p.codigovisual = '+ vEquipamento +
                                                                                              ' or ct.numero = '+ vEquipamento + ' )' +
                                                                                              ' and ct.situacao = ''R'' limit 1) '
  else
    fraConsultaOrdemServico.qryConsultaClientes.MacroByName('CondicaodaConsulta').AsString := ' and v.tipo = ''C'' and exists (select ct.numero ' +
                                                                                              ' from contratos ct ' +
                                                                                              ' where ct.cliente = v.codigo ' +
                                                                                              ' and ct.tipocliente = ''C'' ' +
                                                                                              ' and coalesce(ct.os,false) ' +
                                                                                              ' and ct.situacao = ''R'' limit 1) ';

  if fraConsultaOrdemServico.qryConsultaClientes.recordcount > 1 then
  begin
    if fraConsultaOrdemServico.vEncontradoMultiplosRegistros then
    begin
      fraConsultaOrdemServico.qryConsultaEquipamentosClientes.MacroByName('CondicaodaConsultaCT').AsString := ' exists (select ct.numero ' +
                                                                                                ' from contratos ct ' +
                                                                                                ' where ct.equipamento = ec.equipamento ' +
                                                                                                ' and ct.cliente = '+fraConsultaOrdemServico.qryConsultaClientescodigo.asstring +
                                                                                                ' and ct.tipocliente = ''C'' ' +
                                                                                                ' and coalesce(ct.os,false) ' +
                                                                                                ' and (ct.equipamento = '+ vEquipamento +
                                                                                                ' or ct.numero = '+ vEquipamento + ' )' +
                                                                                                ' and ct.situacao = ''R'' limit 1) ';

      fraConsultaOrdemServico.qryConsultaEquipamentosClientes.MacroByName('CondicaodaConsultaCT').AsString :=
                                                                                                ' ct.cliente = '+fraConsultaOrdemServico.qryConsultaClientescodigo.asstring +
                                                                                                ' and ct.tipocliente = '+quotedstr(fraConsultaOrdemServico.qryConsultaClientestipoorig.asstring) +
                                                                                                ' and (p.codigovisual = '+vequipamento + 'or ct.numero = '+vequipamento+')';

    end
    else
    begin
      fraConsultaOrdemServico.qryConsultaEquipamentosClientes.MacroByName('CondicaodaConsulta').AsString := ' exists (select ct.numero ' +
                                                                                                ' from contratos ct ' +
                                                                                                ' where ct.equipamento = ec.equipamento ' +
                                                                                                ' and ct.cliente = '+fraConsultaOrdemServico.qryConsultaClientescodigo.asstring +
                                                                                                ' and ct.tipocliente = ''C'' ' +
                                                                                                ' and coalesce(ct.os,false) ' +
                                                                                                ' and ct.situacao = ''R'' limit 1) ';

      fraConsultaOrdemServico.qryConsultaEquipamentosClientes.MacroByName('CondicaodaConsultaCT').AsString :=
                                                                                                ' ct.cliente = '+fraConsultaOrdemServico.qryConsultaClientescodigo.asstring +
                                                                                                ' and ct.tipocliente = '+quotedstr(fraConsultaOrdemServico.qryConsultaClientestipoorig.asstring);

    end;
  end
  else
  begin
    if fraConsultaOrdemServico.vEncontradoMultiplosRegistros then
    begin
      fraConsultaOrdemServico.qryConsultaEquipamentosClientes.MacroByName('CondicaodaConsulta').AsString := ' exists (select ct.numero ' +
                                                                                                ' from contratos ct ' +
                                                                                                ' where ct.equipamento = ec.equipamento ' +
                                                                                                ' and ct.tipocliente = ''C'' ' +
                                                                                                ' and coalesce(ct.os,false) ' +
                                                                                                ' and (ct.equipamento = '+vequipamento +' or ct.numero = '+vequipamento+')'+
                                                                                                ' and ct.situacao = ''R'' limit 1) ';
      fraConsultaOrdemServico.qryConsultaEquipamentosClientes.MacroByName('CondicaodaConsultaCT').AsString := ' (p.codigovisual = '+vequipamento + 'or ct.numero = '+vequipamento+')';
    end
    else
    begin
      fraConsultaOrdemServico.qryConsultaEquipamentosClientes.MacroByName('CondicaodaConsulta').AsString := ' exists (select ct.numero ' +
                                                                                                ' from contratos ct ' +
                                                                                                ' where ct.equipamento = ec.equipamento ' +
                                                                                                ' and ct.tipocliente = ''C'' ' +
                                                                                                ' and coalesce(ct.os,false) ' +
                                                                                                ' and ct.situacao = ''R'' limit 1) ';

      fraConsultaOrdemServico.qryConsultaEquipamentosClientes.MacroByName('CondicaodaConsultaCT').AsString := ' p.codigovisual is not null';

    end;
  end;
  fraConsultaOrdemServico.qryProcuraOrdemservico.MacroByName('CondicaodaConsulta').AsString := 'and c.situacao = ''R'' and c.tipocliente = ''C''';
  fraConsultaOrdemServico.qryConsultaOrdemServico.MacroByName('CondicaodaConsulta').AsString := 'and c.situacao = ''R'' and c.tipocliente = ''C''';

end;

procedure TfrmFrenteCaixa.AtribuirDadosOrdemServico(Found: Boolean);
begin
  if dtmFrenteCaixa.SituacaoCupom = scFechado then
    if fraConsultaOrdemServico.edfCodigo.ForeignFound = stFound then
      if fraConsultaOrdemServico.qryProcuraOrdemServico.recordcount = 1 then
      begin
  //      fraConsultaOrdemServico.onfound := nil;
        fraConsultaOrdemServico.edfCodigo.SetFocus;
        dtmFrenteCaixa.VenderItensdoContrato(fraConsultaOrdemServico.qryProcuraOrdemServico.fieldbyname('numero').asString);
        ForcaSetFocusEdtProduto;
        displayValores;
  //      fraConsultaOrdemServico.onfound := AtribuirDadosOrdemServico;
      end;
end;

procedure TfrmFrenteCaixa.fraConsultaOrdemServicoedfCodigoFound(
  Found: Boolean);
begin
  inherited;
//  fraConsultaOrdemServico.onfound := nil;
  if fraConsultaOrdemServico.qryprocuraordemservico.recordcount >= 1 then
  begin
    if fraConsultaOrdemServico.qryprocuraordemservico.recordcount > 1 then
    begin
      fraConsultaOrdemServico.vEncontradoMultiplosRegistros := true;
      if fraConsultaOrdemServico.InternoPesquisar('Ordem de Serviço') <>  mrOK then
      begin
        fraConsultaOrdemServico.edfcodigo.clear;
        fraConsultaOrdemServico.dtxDescricao.Clear;
        dtxEquipamento.clear;
      end;
    end;
  end;

  fraConsultaOrdemServico.qryconsultaclientes.close;
  fraConsultaOrdemServico.qryConsultaEquipamentosClientes.close;
  fraConsultaOrdemServico.vEncontradoMultiplosRegistros := false;
//  fraConsultaOrdemServico.onfound := AtribuirDadosOrdemServico;

end;

procedure TfrmFrenteCaixa.CancelarCupomnaOrigem;
begin
  sbnCancelarVendaClick(nil);
end;

procedure TfrmFrenteCaixa.edtNumeroNotaVinculadaChange(Sender: TObject);
begin
  inherited;
  if(trim(edtNumeroNotaVinculada.Text)<>'') then
     dtmFrenteCaixa.NumeroNotaFiscalVinculada:=strtoint(trim(edtNumeroNotaVinculada.Text))
  else
     dtmFrenteCaixa.NumeroNotaFiscalVinculada:=0;
end;

procedure TfrmFrenteCaixa.ExibirMsgOperador(msg: STring);
begin
  addMensagemGrande(msg, true);
end;

procedure TfrmFrenteCaixa.fraConsultaOrcamentosbnProcuraClick(
  Sender: TObject);
begin
  inherited;
  fraConsultaOrcamento.sbnProcuraClick(Sender);

end;

procedure TfrmFrenteCaixa.AtribuirDadosTabeladePrecos(Found: Boolean);
begin
   dtmFrenteCaixa.CodigoTabelaPreco := fraConsultaTabeladePrecos.qryProcuraColunascodigo.AsInteger;
end;

procedure TfrmFrenteCaixa.CondicoesdaConsultaTabeladePrecos;
begin
  if parsistema.Permitir_selecionar_tabela_de_preco then
  begin
    fraConsultaTabeladePrecos.qryProcuraColunas.MacroByName('CondicaoColunas').AsString :=
      ' and ( coalesce(col.disponivelfrentecaixa,false) or col.codigo = ' + FPrecoNormal + ' )';

    fraConsultaTabeladePrecos.qryConsultaColunas.MacroByName('CondicaoColunas').AsString :=
    fraConsultaTabeladePrecos.qryProcuraColunas.MacroByName('CondicaoColunas').AsString;
  end
  else
  begin
    fraConsultaTabeladePrecos.qryProcuraColunas.MacroByName('CondicaoColunas').AsString :=
      ' and false';
    fraConsultaTabeladePrecos.qryConsultaColunas.MacroByName('CondicaoColunas').AsString :=
    fraConsultaTabeladePrecos.qryProcuraColunas.MacroByName('CondicaoColunas').AsString;
  end;

end;

procedure TfrmFrenteCaixa.fraConsultaTabeladePrecosedfCodigoEnter(
  Sender: TObject);
begin
  inherited;
  if fraConsultaTabeladePrecos.visible then
    fraConsultaTabeladePrecos.edfCodigo.readonly := dtmfrentecaixa.qryProdutosVendidos.recordcount <> 0;
  fraConsultaTabeladePrecos.edfCodigoEnter(Sender);
end;

procedure TfrmFrenteCaixa.sbnOrcamentoClick(Sender: TObject);
begin
  inherited;
  if fraConsultaOrcamento.qryProcuraOrcamentos.RecordCount = 1 then
    TfrmPrincipalBasico(Application.MainForm).MostrarFormRegistrado(['AskToOpen',fraConsultaOrcamento.qryProcuraOrcamentos.FieldByName('codigo').asinteger], 'TfrmOrcamentos', True)
end;

end.
