function TfrmFrenteCaixa.validaVendedor: Boolean;
  function selecionaVendedor:Boolean;
  begin
    Result := ConsultarVendedor;
  end;

  function sugerirUsuarioComoVendedor:Boolean;
  begin
    if ParSistema.SugerirUsuariOComoVendedorFCx then
    begin
      if dtmFrenteCaixa.qryVendedorcodigo.isNull then
      begin
        if UsuarioLogin.Vendedor then
        begin
          //if MensagemSelecionaOpcao('Não existe um vendedor selecionado. Usar o usuário atual?') = smbYes then
          //begin
            dtmFrenteCaixa.SelecionarVendedor(False, UsuarioLogin.CodigoUsuario);
            Result :=  True;
          //end
          //else
          //begin
           // Result := selecionaVendedor;
          //end;
        end
        else
        begin
          if MensagemConfirmacao('O usuário logado não é um vendedor. Deseja selecionar um vendedor?') = smbOK then
          begin
            Result := selecionaVendedor;
          end
          else
          begin
            if ParSistema.ObrigaVendedorFrenteCaixa then
            begin
              if MensagemConfirmacao('Para realizar uma venda no crediário é necessário informar os dados do vendedor.'+#13+'Deseja informar agora?') = smbOK then
                Result := selecionaVendedor
              else
                Result := False;
            end
            else
            begin
              Result := True;
              FObrigaVendedorNessaVenda := ParSistema.ObrigaVendedorFrenteCaixa;
            end;
          end;
        end;
      end
      else
        Result := True;
    end
    else
      Result := False;
  end;

begin
  Result := true;
  if ParSistema.FrenteCaixaComVendedor then
  begin
    if ParSistema.ObrigaVendedorFrenteCaixa and ParSistema.SugerirUsuarioComoVendedorFCx then
    begin
      Result := sugerirUsuarioComoVendedor;
    end
    else
    begin
      if ParSistema.ObrigaVendedorFrenteCaixa then
      begin
        if dtmFrenteCaixa.qryVendedorcodigo.isNull then
          Result := selecionaVendedor
        else
          Result := True;
      end
      else
      begin
        if ParSistema.SugerirUsuariOComoVendedorFCx then
        begin
          Result := sugerirUsuarioComoVendedor;
        end
        else
        begin
          if dtmFrenteCaixa.qryVendedorcodigo.isNull  then
            Result := selecionaVendedor
          else
            Result := True;
        end;
      end;
    end;
  end;
  {
  else
  begin
    if (EdtFinalizacao.Text = '1') or (EdtFinalizacao.Text = '2') or (EdtFinalizacao.Text = '3') then
      Result := True
    else
      Result := False;
  end;
  }
end;

procedure TfrmFrenteCaixa.AdicionaDescontoItem(Valor: String; DescontoeHPercentual: Boolean);
var
  text : String;
  valorDesc : Currency;
begin
  text := Valor;
  // Está opção é para quando é precionado o * sem algum valor. Estão ele colocará 1.
  if text = '' then
    text := '0';

  if text <> '' then
  begin
    // Agora converte o valor para curreny para verificar se é uma quantidade válida.
    // e este try/except para se não for um número.
    try
      valorDesc := StrToCurr(trocar(trocar(Text,'p',''),'P',''));
    except
      valorDesc := 1;
    end;
    text := CurrToStr(Abs(valorDesc));
    edtDescontoItem.Text := text;
    if DescontoeHPercentual then
      edtDescontoItem.Text := edtDescontoItem.Text + '%';

    edtProduto.Text := '';
    ForcaSetFocusEdtProduto;
  end;
end;

(*
procedure TfrmFrenteCaixa.AdicionaAcrescimoTotal;
var
  valor : Currency;
  percentual : Boolean;
begin
  percentual := False;
  if dtmFrenteCaixa.getValorJaInformado = dtmFrenteCaixa.TotalPagar-dtmFrenteCaixa.ValorTotalDescontoItem then
  begin
    try
      EdtFinalizacao.Text := Trim(EdtFinalizacao.Text);
      valor := StrToCurr(EdtFinalizacao.Text);
      EdtFinalizacao.Text := '';
    except
      if copy(EdtFinalizacao.Text, length(EdtFinalizacao.Text),1) = 'P' then
      begin
        try
          EdtFinalizacao.Text := Trim(copy(EdtFinalizacao.Text, 0, length(EdtFinalizacao.Text)-1));
          valor := StrToCurr(EdtFinalizacao.Text);
          EdtFinalizacao.Text := '';
          percentual := True;
        except
          valor := 0;
        end;
      end
      else
        valor := 0;
    end;
    Valor := Abs(Valor);
    if percentual then
      dtmFrenteCaixa.AdicionarAcrescimo(valor, 'P')
    else
      dtmFrenteCaixa.AdicionarAcrescimo(valor);

    displayValores;
  end
  else
    MensagemAviso('Não é permitido desconto/acréscimo após informada alguma forma de pagamento.');
end;

procedure TfrmFrenteCaixa.AdicionaDescontoTotal;
var
  valor : Currency;
  percentual : Boolean;
begin
  percentual := False;
  if dtmFrenteCaixa.getValorJaInformado = dtmFrenteCaixa.TotalPagar-dtmFrenteCaixa.ValorTotalDescontoItem then
  begin
    try
      EdtFinalizacao.Text := Trim(EdtFinalizacao.Text);
      valor := StrToCurr(EdtFinalizacao.Text);
      EdtFinalizacao.Text := '';
    except
      if copy(EdtFinalizacao.Text, length(EdtFinalizacao.Text),1) = 'P' then
      begin
        try
          EdtFinalizacao.Text := Trim(copy(EdtFinalizacao.Text, 0, length(EdtFinalizacao.Text)-1));
          valor := StrToCurr(EdtFinalizacao.Text);
          EdtFinalizacao.Text := '';
          percentual := True;
        except
          valor := 0;
        end;
      end
      else
        valor := 0;
    end;
    valor := Abs(valor);
    if percentual then
      dtmFrenteCaixa.AdicionarDesconto(valor, 'P')
    else
      dtmFrenteCaixa.AdicionarDesconto(valor);
    displayValores;
  end
  else
    MensagemAviso('Não é permitido desconto/acréscimo após informada alguma forma de pagamento.');
end;
*)

procedure TfrmFrenteCaixa.displayValores;
begin
  lblValorDesconto.Visible := True;
  lblValorDesconto.Caption := FloatToStrF(dtmFrenteCaixa.Desconto , ffCurrency, 11, 2);
  lbldesconto_cashback.Caption := FloatToStrF(dtmFrenteCaixa.desconto_cashback , ffCurrency, 11, 2);
  if dtmFrenteCaixa.TemComposto then
  begin
    lblValorDesconto.Visible    := False;
    lblDescontoComposto.Visible := True;
    lblDescontoComposto.Caption := FloatToStrF((dtmFrenteCaixa.DescontoProdutoComposto+dtmFrenteCaixa.Desconto) , ffCurrency, 11, 2);
  end;
  lblValorAcrescimo.Caption := FloatToStrF(dtmFrenteCaixa.Acrescimo, ffCurrency, 11, 2);
  if dtmFrenteCaixa.SaldoRestante > 0 then
    lblSaldoRestante.Caption := 'Saldo'
  else
    lblSaldoRestante.Caption := 'Troco';
  lblValorTroco.Caption      := FloatToStrF(abs(dtmFrenteCaixa.SaldoRestante), ffCurrency, 11, 2);
  lblValorSubTotal.Caption   := FloatToStrF(dtmFrenteCaixa.SubTotal      , ffCurrency, 11, 2);
  lblTotCompra.Caption       := FloatToStrF(dtmFrenteCaixa.ValorTotalCompra, ffCurrency, 11, 2);
  edtTotalQtdade.Caption     := CurrToStr(dtmFrenteCaixa.ValorTotalQuantidade);

end;

