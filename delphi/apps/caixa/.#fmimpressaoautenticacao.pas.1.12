procedure Tfrmimpressaoautenticacao.parametrosDevolucao(
  tipoAutenticacao: integer; contrato: string; motivo: integer; valor: real);
var
  Notas: String;
begin

  FTipoAutenticacao:= tipoAutenticacao;
  FContrato        := contrato;
  FMotivo          := motivo;
  FValor           := valor;
  Notas            := dtmautenticacoes.NotasFiscaisDevolucoes;

  mmoObservacaoRecibo.Clear;
  mmoObservacaoRecibo.append(ctREFERENTEADEVOLUCAO + ':');
  mmoObservacaoRecibo.append(ctMotivo   + ': ' +inttostr(Fmotivo) + ' - ' +
                             dtmautenticacoes.DescricaoMotivosDevolucao);
  mmoObservacaoRecibo.Append(ctCLIENTE  + ': ' + inttostr(dtmautenticacoes.CodigoClienteDevolucoes) +
                             ' - ' +                      dtmautenticacoes.NomeClienteDevolucoes);
  mmoObservacaoRecibo.append(ctContrato + ': ' +Fcontrato);
  if Notas <> '' then
    mmoObservacaoRecibo.Append('NF(s)'  + ': ' +Notas);
  edtRecebidode.Text := dtmautenticacoes.RazaoFilialBase;
  if dtmautenticacoes.TipoCliente[paCONTRATOSDEVOLUCOES] = tcCLIENTE then
    edtAssinatura.Text := dtmautenticacoes.NomeCliente
  else
    edtAssinatura.Text := dtmautenticacoes.NomeFornecedor;
  edtAssinatura.Text := dtmautenticacoes.NomeClienteDevolucoes;
  dtxValorAutenticacao.Caption := floatToStrF(valor, ffFixed, 18, 2);
end;

procedure Tfrmimpressaoautenticacao.parametrosDocumento(tipoAutenticacao,
  evento, historico: integer; tipoES: boolean; parametros, data: string; valor: real);
begin
  FTipoAutenticacao:= tipoAutenticacao;
  FEvento          := evento;
  FHistorico       := historico;
  FTipoES          := tipoES;
  FParametros      := parametros;
  FData            := data;
  FValor           := valor;

  mmoObservacaoRecibo.Clear;
  mmoObservacaoRecibo.Append(ctREFERENTEDOCUMENTO + ': '+dtmautenticacoes.TipoDocumentoEventos);
  mmoObservacaoRecibo.Append(ANSIUpperCase(trim(ctEvento)) + ': ' +inttostr(FEvento)+ ' - ' + dtmautenticacoes.DescricaoEventos);
  mmoObservacaoRecibo.Append(ANSIUpperCase(trim(ctHistorico))  + ': ' + inttostr(Fhistorico) + ' - ' + dtmautenticacoes.DescricacaoHistoricosEvento + ' ' + parametros);

  if FtipoES then
  begin
   edtRecebidode.Text := dtmautenticacoes.RazaoFilialBase;
   edtAssinatura.Text := dtmautenticacoes.NomeUsuario;
  end
  else
  begin
   edtRecebidode.Text := dtmautenticacoes.NomeUsuario;
   edtAssinatura.Text := dtmautenticacoes.RazaoFilialBase;
  end;
  dtxValorAutenticacao.Caption := floatToStrF(valor, ffFixed, 18, 2);
end;

