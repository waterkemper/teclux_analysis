procedure Tfrmimpressaoautenticacao.parametrosDevolucaoSaldo(
  tipoAutenticacao: integer; valor: real);
begin
  FTipoAutenticacao:= tipoAutenticacao;
  FValor           := valor;

  mmoObservacaoRecibo.Clear;
  mmoObservacaoRecibo.append(ctREFERENTEADEVOLUCAO + ':');
  mmoObservacaoRecibo.append(ctSALDODETROCA);
  edtRecebidode.Text := dtmautenticacoes.RazaoFilialBase;
  if dtmautenticacoes.TipoCliente[paCLIENTESDEVOLUCOES] = tcCLIENTE then
    edtAssinatura.Text := dtmautenticacoes.NomeClienteDevolucoesSaldo
  else
    edtAssinatura.Text := dtmautenticacoes.NomeFornecedor;
  dtxValorAutenticacao.Caption := floatToStrF(valor, ffFixed, 18, 2);
end;

function Tfrmimpressaoautenticacao.autenticacaoDevolucaoSaldo(
  ImprimirAutenticacao: Boolean): Boolean;
begin
  result := False;
  if not FAutenticado then begin
    FRetorno := dtmautenticacoes.autenticarDevolucaoSaldo(FValor);
    if FRetorno = mrOK then begin
      sbnGravarAutenticacao.Enabled := False;
      FAutenticado := true;
    end;
  end;
  if FRetorno <> mrOK then
    MensagemErro(format(ctERRORPROCEDIMENTOAUTENTICACAO, [FRetorno]))
  else begin
    if ImprimirAutenticacao then
      dtmautenticacoes.ImprimirAutenticacao('A', FValor);
    result := True;
  end;
end;

procedure Tfrmimpressaoautenticacao.reciboDevolucaoSaldo;
begin
  if autenticacaoDevolucaoSaldo(false ) then
    dtmautenticacoes.ImprimirReciboGeral(FValor, mmoObservacaoRecibo, edtAssinatura.Text, edtRecebidode.Text);
end;

procedure Tfrmimpressaoautenticacao.parametrosParcelasAberto(
  TipoAutenticacao: Integer; Valor: Real;ComCartao:Boolean);
begin
  edtValorRecebido.Enabled := True;
  ActiveControl := edtValorRecebido;
  //edtValorRecebido.SetFocus;
  sbnTEF.Enabled := ((ParSistema.TipoTEF <> tsSEMTEF) and (ComCartao));
{$IFDEF MSWINDOWS}
 { if ComCartao then begin
    sbnAutenticar.Enabled := False;
    sbnRecibo.Enabled     := False;
  end;}
{$ENDIF}
 // FContrato         := Contrato;
  FTipoAutenticacao := TipoAutenticacao;
  FValor            := Valor;
  if dtmautenticacoes.TipoCliente[paCLIENTEPARCELAS] = tcCLIENTE then
       edtRecebidode.Text := dtmautenticacoes.NomeCliente
  else edtRecebidode.Text := dtmautenticacoes.NomeFornecedor;
  mmoObservacaoRecibo.Clear;
  mmoObservacaoRecibo.append(ctREFERENTEPAGAMENTOPARCELAS + ':');
  dtmautenticacoes.qryParcelasAberto.First;
  while not dtmautenticacoes.qryParcelasAberto.Eof do
  begin
    if dtmautenticacoes.qryParcelasAbertoselecionar.AsBoolean then
      mmoObservacaoRecibo.append(ctPARCELA + ': ' + dtmautenticacoes.qryParcelasAbertoparcelaorigem.asString +
                                 ' ' + ctContrato + ': ' + dtmautenticacoes.qryparcelasAbertocontrato.asString);
    dtmautenticacoes.qryParcelasAberto.Next;
  end;
  edtAssinatura.Text := dtmautenticacoes.RazaoFilialBase;
  dtxValorAutenticacao.Caption := floatToStrF(valor, ffFixed, 18, 2);
  dtmautenticacoes.ContadorAutenticacao := 0;
end;

function Tfrmimpressaoautenticacao.autenticacaoParcelasAberto(ImprimirAutenticacao,
  ComCartao: Boolean; FormaPagamento: Integer; ValorPagoDinheiro: Currency): Boolean;
var i : integer;  
begin
  Result := False;
  if not FAutenticado then
  begin
    FRetorno := dtmautenticacoes.autenticarParcelasAberto(FormaPagamento, ValorPagoDinheiro, ImprimirAutenticacao, ComCartao);
    if FRetorno = mrOK then
    begin
      FAutenticado := True;
      lblValorTotalEmDinheiro.Caption := FormatFloat('#0,' + ThousandSeparator + '00', dtmautenticacoes.PagamentoEmDinheiro);
      sbnGravarAutenticacao.Enabled := False;
      sbnAutenticar.Enabled := False;
    end
    else
      FAutenticado := True;
  end;
  if FRetorno <> mrOK then
  begin
    if FRetorno = 2 then {cancelado}
     MensagemAviso('A operação foi cancelada')
    else
     MensagemErro(format(ctERRORPROCEDIMENTOAUTENTICACAO, [FRetorno]))
  end
  else begin
{    if ImprimirAutenticacao then begin
      dtmautenticacoes.ImprimirAutenticacao('P', FValor);
}
    if not ComCartao then
    begin
      frmparcelasrecebimentos:= Tfrmparcelasrecebimentos.Create(frmparcelasrecebimentos);

      frmParcelasRecebimentos.setDataModulo(dtmautenticacoes);

      frmParcelasRecebimentos.ShowModal;
      result := frmParcelasRecebimentos.ModalResult = mrOk;
    end;
    if not Result or ComCartao then
    begin
      dtmautenticacoes.MontarRecebimentosParcelasAberto(ComCartao);
      result := dtmautenticacoes.GravarRecebimentos;
    end;
    if not ComCartao then
    begin
      frmParcelasRecebimentos.Free;
      SetFocus;
    end;
    if Assigned(ECFPadrao) then
    begin
      for i:= 1 to parsistema.NumeroCopiasdoRecibo do
        dtmautenticacoes.ImprimirCNF('Suprimento', IfThen(ComCartao, 'Cartao', 'Dinheiro'), mmoObservacaoRecibo.Text+' '+mmoObservacaoReciboDigitada.Text, FValor);
    end;

    if Assigned(ActiveControl) and ActiveControl.CanFocus then
      ActiveControl.SetFocus;
{    end;
    result := True; }
  end;
end;

procedure Tfrmimpressaoautenticacao.reciboParcelasAberto;
begin
  if FAutenticado or  autenticacaoParcelasAberto(False,False,0,0) then
    dtmautenticacoes.ImprimirReciboParcelasAcumuladas(dtmautenticacoes.RazaoFilialBase);
end;

procedure Tfrmimpressaoautenticacao.parametrosCancelamentoTransacao(TipoAutenticacao,
                                                                    Motivo: Integer);
var
  A : TResumoAutenticacoes;
  i : Integer;
  valor : Currency;
begin
  FTipoAutenticacao:= tipoAutenticacao;
  FMotivo          := motivo;
{  FValor           := valor;
  FAutenticacao    := autenticacao;
}

  dtmautenticacoes.AutenticacoesTransacao(A);
  valor := 0;

  mmoObservacaoRecibo.Clear;
  for i := 0 to high(A) do
  begin
    mmoObservacaoRecibo.Append(ctCANCELAMENTOAUTENTICACAO  + ': '+ inttostr(A[i].Autenticacao));
    valor := valor + A[i].Valor;
  end;
  mmoObservacaoRecibo.Append(ANSIUpperCase(trim(ctMOTIVO)) + ': ' + inttostr(FMotivo) + ' - ' + dtmautenticacoes.DescricaoMotivosCancelamento);
  edtRecebidode.Clear;
  edtAssinatura.Text := dtmautenticacoes.NomeUsuario;
  FValor := Valor;
  dtxValorAutenticacao.Caption := FloatToStrF(valor, ffFixed, 18, 2);
end;

function Tfrmimpressaoautenticacao.autenticacaoCancelamentoTransacao(
  ImprimirAutenticacao: Boolean): Boolean;
begin
  result := False;
  if not FAutenticado then begin
    FRetorno := dtmautenticacoes.autenticarCancelamentoTransacao(FMotivo, FValor, ImprimirAutenticacao);
    if FRetorno = mrOK then begin
      sbnGravarAutenticacao.Enabled := False;
      FAutenticado := true;
      if (FTipoAutenticacao = ctCaixaCancelamento) and not ParSistema.AutenticacaoParcelasModo2 then begin
        dtmautenticacoes.PagamentoEmDinheiro := dtmautenticacoes.PagamentoEmDinheiro - FValor;
        if ParSistema.ImprimirReciboAcumulado then
          dtmautenticacoes.RemoveAutenticacaoTabelaTemporaria(FAutenticacao);
      end;
    end;
  end;

  if FRetorno <> mrOK then
    MensagemErro(format(ctERRORPROCEDIMENTOAUTENTICACAO, [FRetorno]))
  else begin
    if ImprimirAutenticacao then
      dtmautenticacoes.ImprimirAutenticacao('C', FValor);
    result := True;
  end;
  BringToFront;
  SetFocus;
//
end;

procedure Tfrmimpressaoautenticacao.FormShow(Sender: TObject);
begin
  inherited;
  ActiveControl.SetFocus;
end;

procedure Tfrmimpressaoautenticacao.BloquearBotoes(bloquear: boolean);
begin
  if bloquear then
  begin
    sbnTEFEnabled := sbnTEF.Enabled;
    sbnAutenticarChequeEnabled := sbnAutenticar.Enabled;
    sbnGravarAutenticacaoEnabled := sbnGravarAutenticacao.enabled;
    sbnReciboEnabled := sbnRecibo.enabled;
    sbnAutenticarEnabled := sbnAutenticar.enabled;

    sbnTEF.enabled := false;
    sbnAutenticarCheque.Enabled := false;
    sbnGravarAutenticacao.Enabled := false;
    sbnRecibo.Enabled := false;
    sbnAutenticar.Enabled := false;

    sbnBloqueados := true;
  end
  else
  begin
    sbnTEF.enabled := sbnTEFEnabled;
    sbnAutenticarCheque.Enabled := sbnAutenticarEnabled;
    sbnGravarAutenticacao.Enabled := sbnGravarAutenticacaoenabled;
    sbnRecibo.Enabled := sbnReciboenabled;
    sbnAutenticar.Enabled := sbnAutenticarenabled;

    sbnBloqueados := false;
  end;
end;

end.
