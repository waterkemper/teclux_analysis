unit fmparcelasrecebimentos;

interface

uses
  SysUtils, Types, Classes, Graphics, Controls, Forms, Dialogs, Windows,
  StdCtrls, fmajudabt, ComCtrls, Buttons, ExtCtrls, Grids, DBGrids,
  cpdbgrid, biblio, ctconstantes,
  dmautenticacoes, ToolWin, ActnList, clparametrossistema, clecf, cltefdiscado,
  ACBrTEFDClass;

type
  TfrmParcelasRecebimentos = class(TfrmAjudaBt)
    pnlFundoJanela: TPanel;
    gbxRecebimentos: TGroupBox;
    gbxParcelas: TGroupBox;
    pnlBottom: TPanel;
    gbxValorAutenticado: TGroupBox;
    lblValorAutenticado: TLabel;
    dbgParcelasAutenticadas: TtecDBGrid;
    dbgRecebimentos: TtecDBGrid;
    gbxValorTotalRecebimentos: TGroupBox;
    lblValorTotalRecebimentos: TLabel;
    sbnGravar: TSpeedButton;
    Bevel1: TBevel;
    Bevel2: TBevel;
    sbnTEF: TSpeedButton;
    actHabilitar: TActionList;
    aclHabilitar: TAction;
    procedure sbnGravarClick(Sender: TObject);
    procedure dbgRecebimentosColExit(Sender: TObject);
    procedure dbgRecebimentosKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure FormShow(Sender: TObject);
    procedure aclHabilitarUpdate(Sender: TObject);
    procedure sbnTEFClick(Sender: TObject);
    procedure FormCloseQuery(Sender: TObject; var CanClose: Boolean);
  private
    { Private declarations }
  protected
    procedure KeyDown(var Key: Word; Shift: TShiftState); override;
    procedure AfterPostRecebimentos(Sender: TObject);
  public
    procedure setDataModulo(dataModulo: Tdtmautenticacoes);
    constructor Create(AOwner: TComponent); override;
    destructor Destroy; override;
    { Public declarations }
  end;

var
  frmParcelasRecebimentos: TfrmParcelasRecebimentos;

implementation

//uses SysInit;

{$R *.dfm}

{ TfrmParcelasRecebimentos }

constructor TfrmParcelasRecebimentos.Create(AOwner: TComponent);
begin
  inherited;
  with dtmautenticacoes do
  begin
    refazconsulta(qryAgentes, [], []);
    refazconsulta(qryTiposRecebimentos, [], []);
    refazconsulta(qryRecebimentos, [], []);
    qryRecebimentosTemp.readonly := false;

    vValorPagtoDinheiro := 0;
    vValorPagtoCheque := 0;
    vValorPagtoCartao := 0;
    vValorPagtoConfirmado := 0;
    vJaPossuiPagamentCartaoAprovado := false;
    vNaoFiscalTEFJaIniciado := false;

    sbnTEF.visible := (ParSistema.TipoTEF = tsDISCADO)
                      and assigned(tefpadrao)
                      and TEFPadrao.Inicializado(gpTefDial); 



  end;
end;

destructor TfrmParcelasRecebimentos.Destroy;
begin
  inherited;
  frmParcelasRecebimentos := nil;
end;

procedure TfrmParcelasRecebimentos.setDataModulo(
  dataModulo: Tdtmautenticacoes);
begin
  dtmautenticacoes := DataModulo;
end;

procedure TfrmParcelasRecebimentos.sbnGravarClick(Sender: TObject);
begin
  inherited;
  sbnTEF.Enabled := false;
  sbnGravar.Enabled := false;

  dtmautenticacoes.GravarRecebimento;
  if lblValorAutenticado.Caption = lblValorTotalRecebimentos.Caption then
  begin
    if dtmautenticacoes.GravarRecebimentos(false) then
    begin
      ModalResult := mrOk;
//      Close;
    end
    else
    begin
//      MensagemAviso(ctERRO);
      dbgRecebimentos.SetFocus;
    end;
  end
  else
  begin
    MensagemAviso(ctRECEBIMENTOSDIFEREAUTENTICADO);
    dbgRecebimentos.SetFocus;
  end;

  sbnTEF.Enabled := true;
  sbnGravar.Enabled := true;

end;

procedure TfrmParcelasRecebimentos.KeyDown(var Key: Word;
  Shift: TShiftState);
begin
  inherited;
  if (Key = VK_F5) and sbnGravar.Enabled then
    sbnGravarClick(nil)
  else
  if (Key = VK_F9) and sbnTEF.Enabled then
    sbnTEFClick(nil);

end;

procedure TfrmParcelasRecebimentos.AfterPostRecebimentos(Sender: TObject);
begin
  lblValorTotalRecebimentos.Caption := CurrToStrF(dtmautenticacoes.TotalRecebimentos,ffCurrency,2);
end;

procedure TfrmParcelasRecebimentos.dbgRecebimentosColExit(Sender: TObject);
begin
  inherited;
  dtmautenticacoes.GravarRecebimento;
end;

procedure TfrmParcelasRecebimentos.dbgRecebimentosKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if TeclaEnterOuReturn(Key) then
    dtmautenticacoes.GravarRecebimento; 
end;

procedure TfrmParcelasRecebimentos.FormShow(Sender: TObject);
begin
  inherited;
  dtmautenticacoes.AfterPostRecebimentos := AfterPostRecebimentos;
  dtmautenticacoes.MontarRecebimentosParcelasAberto(False);
  lblValorAutenticado.Caption := CurrToStrF(dtmautenticacoes.TotalMarcados,ffCurrency,2);
end;

procedure TfrmParcelasRecebimentos.aclHabilitarUpdate(Sender: TObject);
begin
  inherited;
  sbntef.Enabled := dtmautenticacoes.ExisteRecebimentoDebCred;
  sbnGravar.Enabled := not dtmautenticacoes.vNaoFiscalTEFJaIniciado;
end;

procedure TfrmParcelasRecebimentos.sbnTEFClick(Sender: TObject);
begin
  inherited;
//  dtmautenticacoes.GravarRecebimento;
  sbnTEF.Enabled := false;
  sbnGravar.Enabled := false;
  if lblValorAutenticado.Caption = lblValorTotalRecebimentos.Caption then
  begin
    if dtmautenticacoes.GravarRecebimentos(true) then
    begin
      ModalResult := mrOk;
//      Close;
    end
    else
    begin
//      MensagemAviso(ctERRO);
      dbgRecebimentos.SetFocus;
    end;
  end
  else
  begin
    MensagemAviso(ctRECEBIMENTOSDIFEREAUTENTICADO);
    dbgRecebimentos.SetFocus;
  end;
  sbnTEF.Enabled := true;
  sbnGravar.Enabled := true;
end;

procedure TfrmParcelasRecebimentos.FormCloseQuery(Sender: TObject;
  var CanClose: Boolean);
begin
  inherited;
  CanClose := Truncar(dtmautenticacoes.vValorPagtoConfirmado, 2) = truncar(dtmautenticacoes.TotalMarcados, 2);
  if not CanClose then
  begin
    if MensagemSelecionaOpcao('Os valores dos recebimentos não estão fechando com o total autenticado. Deseja cancelar a operação?') = smbYes then
    begin
      dtmautenticacoes.verificarSituacaoImpressaoECF_e_TEF;
      Canclose := true;
    end;
  end;
end;

end.
