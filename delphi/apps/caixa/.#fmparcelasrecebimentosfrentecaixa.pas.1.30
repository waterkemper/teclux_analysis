unit fmparcelasrecebimentosfrentecaixa;

interface

uses
  SysUtils, Types, Classes, Graphics, Controls, Forms, Dialogs, Windows,
  StdCtrls, fmajudabt, ComCtrls, Buttons, ExtCtrls, Grids, DBGrids,
  cpdbgrid, biblio, ctconstantes,
  ToolWin, ActnList, clparametrossistema, clecf, cltefdiscado,
  ACBrTEFDClass, dmfrentecaixa, dmbasico, db, cpnumero, StrUtils,
  fmVisualizarSaldocashback, DBCtrls, Mask, cpdbtext, clusuario, dmtecsoft,
  frconsulta, frconsultacodigo;

type
  TfrmParcelasRecebimentosFrenteCaixa = class(TfrmAjudaBt)
    pnlFundoJanela: TPanel;
    gbxRecebimentos: TGroupBox;
    pnlBottom: TPanel;
    gbxValorAutenticado: TGroupBox;
    dbgRecebimentos: TtecDBGrid;
    gbxValorTotalRecebimentos: TGroupBox;
    sbnGravar: TSpeedButton;
    Bevel1: TBevel;
    sbnTEF: TSpeedButton;
    actHabilitar: TActionList;
    aclHabilitar: TAction;
    rgbTipoDesconto: TDBRadioGroup;
    rgbTipoAcrescimo: TDBRadioGroup;
    gbxCheques: TGroupBox;
    Bevel2: TBevel;
    dbgCheques: TtecDBGrid;
    lblSaldoCheque: TLabel;
    edtSaldoCheques: TEditNumero;
    PanelCashBack: TPanel;
    sbnVisualizardesconto_cashback: TStaticText;
    edtdesconto_cashback: TDBEditNumero;
    sbnVisualizardesconto_cashback_Gerado: TStaticText;
    edtdesconto_cashbackGerado: TDBEditNumero;
    StaticText1: TStaticText;
    edtDesconto: TDBEditNumero;
    StaticText2: TStaticText;
    edtAcrescimo: TDBEditNumero;
    edtvalorareceber: TDBEditNumero;
    edttotalrecebimentos: TDBEditNumero;
    gbxTroco: TGroupBox;
    edtTotalTroco: TDBEditNumero;
    pnlCupomDesconto: TPanel;
    edtValorCupomDesconto: TDBEditNumero;
    lblCupomDesconto: TStaticText;
    fraConsultaCupom_Desconto: TfraConsultaCodigo;
    function ValidarFechamentoValoresDigitados: Boolean ;
    procedure sbnGravarClick(Sender: TObject);
    procedure dbgRecebimentosColExit(Sender: TObject);
    procedure dbgRecebimentosKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure FormShow(Sender: TObject);
    procedure aclHabilitarUpdate(Sender: TObject);
    procedure sbnTEFClick(Sender: TObject);
    procedure FormCloseQuery(Sender: TObject; var CanClose: Boolean);
    procedure edtDescontoExit(Sender: TObject);
    procedure edtAcrescimoExit(Sender: TObject);
    procedure edtDescontoEnter(Sender: TObject);
    procedure edtAcrescimoEnter(Sender: TObject);
    procedure rgbTipoDescontoEnter(Sender: TObject);
    procedure rgbTipoAcrescimoEnter(Sender: TObject);
    procedure sbnVisualizardesconto_cashbackClick(Sender: TObject);
    procedure edtdesconto_cashbackExit(Sender: TObject);
    procedure edtdesconto_cashbackEnter(Sender: TObject);
    procedure fraConsultaCupom_DescontoedfCodigoEnter(Sender: TObject);
    procedure fraConsultaCupom_DescontoedfCodigoExit(Sender: TObject);
  private
    { Private declarations }

  protected
    vPermitirFecharJanela : Boolean;
    procedure KeyDown(var Key: Word; Shift: TShiftState); override;
    procedure AfterPostRecebimentos(Sender: TObject);
    function VerificarDesconto_CashBack(zerar,Atribuir: Boolean): Boolean; overload;
    function VerificarDesconto_CashBack: Boolean; overload;
  public
//    procedure setDataModulo(dataModulo: Tdtmfrentecaixa);
    constructor Create(AOwner: TComponent); override;
    destructor Destroy; override;
    { Public declarations }
  end;

var
  frmParcelasRecebimentosFrenteCaixa: TfrmParcelasRecebimentosFrenteCaixa;

implementation

uses Math;

//uses SysInit;

{$R *.dfm}

{ TfrmParcelasRecebimentosFrenteCaixa }

constructor TfrmParcelasRecebimentosFrenteCaixa.Create(AOwner: TComponent);
begin
  inherited;
  sbnTEF.visible := (ParSistema.TipoTEF = tsDISCADO)
                    and assigned(tefpadrao)
                    and TEFPadrao.Inicializado({gpTefDial}gpPayGo);

  if sbntef.visible then
    tefpadrao.totalpago := 0;

    {
  if parsistema.TipoPadraoDesconto = 'R$' then
  begin
    rgbTipoDesconto.ItemIndex := 1;
    rgbTipoAcrescimo.ItemIndex := 1;
  end
  else
  if parsistema.TipoPadraoDesconto = '%' then
  begin
    rgbTipoAcrescimo.ItemIndex := 0;
    rgbTipoDesconto.ItemIndex := 0;
  end;
  }

  dtmFrenteCaixa.vTipoDescontoAntesAlterar := rgbTipoDesconto.Items[rgbTipoDesconto.ItemIndex];
  dtmFrenteCaixa.vTipoAcrescimoAntesAlterar := rgbTipoAcrescimo.Items[rgbTipoAcrescimo.ItemIndex];

  fraConsultaCupom_Desconto.TipoPesquisa := pesCupons_Desconto;

end;

destructor TfrmParcelasRecebimentosFrenteCaixa.Destroy;
begin
  inherited;
  frmParcelasRecebimentosFrenteCaixa := nil;
end;

{
procedure TfrmParcelasRecebimentosFrenteCaixa.setDataModulo(
  dataModulo: Tdtmfrentecaixa);
begin
  dtmfrentecaixa := DataModulo;
end;
}

procedure TfrmParcelasRecebimentosFrenteCaixa.sbnGravarClick(Sender: TObject);
begin
  inherited;

  if dtmfrentecaixa.NaoExistemAlteracoesemprodutosorcamentos then
  begin

    edtDescontoExit(nil);
    edtAcrescimoExit(nil);

    sbnTEF.Enabled := false;
    sbnGravar.Enabled := false;
    dtmfrentecaixa.GravarRecebimento;
    if ValidarFechamentoValoresDigitados then
    begin
      if dtmfrentecaixa.GravarRecebimentos(false) then
      begin
        ModalResult := mrOk;
        dtmfrentecaixa.ImprimirSaldoFrentedeCaixa;
      end
      else
      begin
        if dtmFrenteCaixa.Excecao then
        begin
          vPermitirFecharJanela := true;
          modalresult := mrcancel;
        end
        else
          dbgRecebimentos.SetFocus;
      end;
      sbnTEF.Enabled := true;
      sbnGravar.Enabled := true;
    end;
  end
  else
    ModalResult := mrCancel;
end;

procedure TfrmParcelasRecebimentosFrenteCaixa.sbnTEFClick(Sender: TObject);
begin
  inherited;
  if dtmfrentecaixa.NaoExistemAlteracoesemprodutosorcamentos then
  begin

    edtDescontoExit(nil);
    edtAcrescimoExit(nil);
    sbnTEF.Enabled := false;
    sbnGravar.Enabled := false;
    dtmfrentecaixa.GravarRecebimento;
    if ValidarFechamentoValoresDigitados then
    begin
      if dtmfrentecaixa.GravarRecebimentos(true) then
        ModalResult := mrOk
      else
      begin
        if dtmFrenteCaixa.Excecao then
        begin
          vPermitirFecharJanela := true;
          modalresult := mrcancel;
        end
        else
          dbgRecebimentos.SetFocus;
      end;
      sbnTEF.Enabled := true;
      sbnGravar.Enabled := true;
    end;
  end
  else
    ModalResult := mrCancel;


end;


procedure TfrmParcelasRecebimentosFrenteCaixa.KeyDown(var Key: Word;
  Shift: TShiftState);
begin
  if (activecontrol = dbgRecebimentos)
     and (key = vk_escape)
     and (dtmFrenteCaixa.qryRecebimentosTemp.State in [dsedit, dsinsert]) then
    dtmFrenteCaixa.qryRecebimentosTemp.cancel
  else
  {
  if (activecontrol = dbgRecebimentos)
     and (dbgRecebimentos.SelectedField = dtmFrenteCaixa.qryRecebimentosTemptiporec) then
    AbrirLookupTiposRecebimentos 
  else                                       }
  begin
    inherited;
    if (Key = VK_F5) and sbnGravar.Enabled then
      sbnGravarClick(nil)
    else
    if (Key = VK_F9) and sbnTEF.Enabled then
      sbnTEFClick(nil);
  end;

end;

procedure TfrmParcelasRecebimentosFrenteCaixa.AfterPostRecebimentos(Sender: TObject);
begin
//  lblValorTotalRecebimentos.Caption :=  CurrToStrF(dtmfrentecaixa.TotalRecebimentos,ffCurrency,2);
  if dtmFrenteCaixa.qryRecebimentosTemptipotiporecebimento.AsString='H' then
    edtSaldoCheques.Value := dtmFrenteCaixa.qryRecebimentosTempvalorlancto.AsCurrency -
                             dtmFrenteCaixa.vTotalValoresCheques
  else
    edtSaldoCheques.Value:= 0;
end;

procedure TfrmParcelasRecebimentosFrenteCaixa.dbgRecebimentosColExit(Sender: TObject);
begin
  inherited;
//  dtmfrentecaixa.GravarRecebimento;
end;

procedure TfrmParcelasRecebimentosFrenteCaixa.dbgRecebimentosKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if TeclaEnterOuReturn(Key) then
  begin
//    dtmfrentecaixa.GravarRecebimento;
    if dbgRecebimentos.SelectedField = dtmFrenteCaixa.qryRecebimentosTempvalorlancto then
      dbgRecebimentos.SelectedField := dtmFrenteCaixa.qryRecebimentosTemptiporec
    else
    if dbgRecebimentos.SelectedField = dtmFrenteCaixa.qryRecebimentosTemptiporec then
      AbrirLookup;
  end;
end;

procedure TfrmParcelasRecebimentosFrenteCaixa.FormShow(Sender: TObject);
begin
  inherited;
  dtmfrentecaixa.AfterPostRecebimentos := AfterPostRecebimentos;

  if dtmfrentecaixa.OrigemdaVenda = FrenteCaixa_ then
    VerificarDesconto_CashBack(false,true);

  dtmfrentecaixa.MontarRecebimentosParcelasAberto;
//  lblValorAutenticado.Caption := CurrToStrF(dtmfrentecaixa.ValorAReceber,ffCurrency,2);
//  lblValorTotalRecebimentos.Caption :=  CurrToStrF(dtmfrentecaixa.TotalRecebimentos,ffCurrency,2);

  dtmFrenteCaixa.AdicionarDesconto(edtDesconto.ValorSemFormatacao,ifthen(rgbTipoDesconto.ItemIndex=0,'P','V'));
  dtmFrenteCaixa.AfterAlteracaoValores(nil);
  edtDesconto.SetFocus;


  fraConsultaCupom_Desconto.edfcodigo.text := dtmfrentecaixa.codigo_cupom;
  fraConsultaCupom_Desconto.edfcodigo.exist;

  




end;

procedure TfrmParcelasRecebimentosFrenteCaixa.aclHabilitarUpdate(Sender: TObject);
begin
  inherited;
  sbntef.Enabled := dtmfrentecaixa.ExisteRecebimentoDebCred_e_PIX;
  sbnGravar.Enabled := not dtmfrentecaixa.vJaPossuiPagamentCartao_ou_PIXAprovado;

  edtDesconto.Enabled      := not dtmfrentecaixa.vJaPossuiPagamentCartao_ou_PIXAprovado;
  rgbTipoDesconto.Enabled  := not dtmfrentecaixa.vJaPossuiPagamentCartao_ou_PIXAprovado;

  edtAcrescimo.Enabled     := not dtmfrentecaixa.vJaPossuiPagamentCartao_ou_PIXAprovado;
  rgbTipoAcrescimo.Enabled := not dtmfrentecaixa.vJaPossuiPagamentCartao_ou_PIXAprovado;

end;


procedure TfrmParcelasRecebimentosFrenteCaixa.FormCloseQuery(Sender: TObject;
  var CanClose: Boolean);
begin
  inherited;

  if not vPermitirFecharJanela then
  begin
    CanClose := Truncar(dtmfrentecaixa.vValorPagtoConfirmado, 2) >= truncar(dtmfrentecaixa.ValorAReceber, 2);
    if not CanClose then
    begin
      if MensagemSelecionaOpcao('Os valores dos recebimentos não estão fechando com o total autenticado. Deseja cancelar a operação?') = smbYes then
      begin
        dtmfrentecaixa.verificarSituacaoImpressaoECF_e_TEF;
        dtmfrentecaixa.IniciarTabelaRecebimentoTemp;
        Canclose := true;
      end;
    end;
  end
  else
    CanClose := true;

  if CanClose then
    if assigned(TefPadrao) then
      tefpadrao.totalpago := 0;

  vPermitirFecharJanela := False;

end;

procedure TfrmParcelasRecebimentosFrenteCaixa.edtDescontoExit(
  Sender: TObject);
begin
  inherited;
  if (dtmFrenteCaixa.vDescontoAntesAlterar <> edtDesconto.ValorSemFormatacao) or
     (dtmFrenteCaixa.vTipoDescontoAntesAlterar <> rgbTipoDesconto.Items[rgbTipoDesconto.ItemIndex]) then
  begin
    dtmFrenteCaixa.AdicionarDesconto(edtDesconto.ValorSemFormatacao,ifthen(rgbTipoDesconto.ItemIndex=0,'P','V'));

    dtmFrenteCaixa.vDescontoAntesAlterar := edtDesconto.ValorSemFormatacao;
    dtmFrenteCaixa.vTipoDescontoAntesAlterar := rgbTipoDesconto.Items[rgbTipoDesconto.ItemIndex];

//    lblValorAutenticado.Caption := CurrToStrF(dtmfrentecaixa.ValorAReceber,ffCurrency,2);
  end;
end;

procedure TfrmParcelasRecebimentosFrenteCaixa.edtAcrescimoExit(
  Sender: TObject);
begin
  inherited;
  if (dtmFrenteCaixa.vAcrescimoAntesAlterar <> edtAcrescimo.ValorSemFormatacao) or
     (dtmFrenteCaixa.vTipoAcrescimoAntesAlterar <> rgbTipoAcrescimo.Items[rgbTipoAcrescimo.ItemIndex]) then
  begin
    dtmFrenteCaixa.AdicionarAcrescimo(edtAcrescimo.ValorSemFormatacao,ifthen(rgbTipoAcrescimo.ItemIndex=0,'P','V'));
    dtmFrenteCaixa.vAcrescimoAntesAlterar := edtAcrescimo.ValorSemFormatacao;
    dtmFrenteCaixa.vTipoAcrescimoAntesAlterar := rgbTipoAcrescimo.Items[rgbTipoAcrescimo.ItemIndex];
//    lblValorAutenticado.Caption := CurrToStrF(dtmfrentecaixa.ValorAReceber,ffCurrency,2);
  end;
end;


procedure TfrmParcelasRecebimentosFrenteCaixa.edtDescontoEnter(
  Sender: TObject);
begin
  inherited;
  dtmFrenteCaixa.vDescontoAntesAlterar := edtDesconto.ValorSemFormatacao;
end;

procedure TfrmParcelasRecebimentosFrenteCaixa.edtAcrescimoEnter(
  Sender: TObject);
begin
  inherited;
  dtmFrenteCaixa.vAcrescimoAntesAlterar := edtAcrescimo.ValorSemFormatacao;
