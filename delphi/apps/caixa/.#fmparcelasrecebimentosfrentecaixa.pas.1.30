function TfrmParcelasRecebimentosFrenteCaixa.ValidarFechamentoValoresDigitados: Boolean;
var
  vNovoValorDesconto, vNovoPercentualDesconto : Currency;
  OpcaoSelecionada : TMessageButton;
  Usuario: TtecUsuarios;

begin
//  with dtmfrentecaixa do
  begin
    result := true;
    OpcaoSelecionada := smbIgnore;

    if (dtmfrentecaixa.TotalRecebimentos < dtmfrentecaixa.ValorAReceber
                                           {(dtmfrentecaixa.ValorTotalProdutos +
                                            dtmfrentecaixa.ValorTotalAcrescimoFinanceiro -
                                            dtmfrentecaixa.ValorTotalDescontoItens -
                                            dtmfrentecaixa.ValorTotalDescontoItemCupomDesconto -
                                            dtmfrentecaixa.ValorTotaldesconto_cashback)}) then
    begin

      result := False;
      vNovoPercentualDesconto := 100 - PercentualDoValorSobreTotal(
                                                    (dtmfrentecaixa.ValorAReceber - dtmfrentecaixa.ValorTotalDescontoGeral)

                                                  {(dtmfrentecaixa.ValorTotalProdutos +
                                                    dtmfrentecaixa.ValorTotalAcrescimoFinanceiro -
                                                    dtmfrentecaixa.ValorTotalDescontoItens -
                                                    dtmfrentecaixa.ValorTotalDescontoItemCupomDesconto -
                                                    dtmfrentecaixa.ValorTotalDesconto_CashBack)},

                                                    dtmfrentecaixa.TotalRecebimentos);

      vNovoValorDesconto := ( (dtmfrentecaixa.ValorAReceber - dtmfrentecaixa.ValorTotalDescontoGeral)
                             {(dtmfrentecaixa.ValorTotalProdutos +
                              dtmfrentecaixa.ValorTotalAcrescimoFinanceiro -
                              dtmfrentecaixa.ValorTotalDescontoItens -
                              dtmfrentecaixa.ValorTotalDescontoItemCupomDesconto -
                              dtmfrentecaixa.ValorTotalDesconto_CashBack)} - dtmfrentecaixa.TotalRecebimentos);

      if (dtmfrentecaixa.vTipoDescontoAntesAlterar = '%') and (vNovoPercentualDesconto <> dtmfrentecaixa.vDescontoAntesAlterar) then
      begin

        OpcaoSelecionada := MensagemSelecionaOpcao(format('A soma dos recebimentos R$ %s difere do valor da venda de R$ %s. '+CHR(13)+
                                  'Atribuir a diferença ao percentual de desconto? ',
                                       [formatfloat('###,##0.00', dtmfrentecaixa.TotalRecebimentos),
                                        formatfloat('###,##0.00', dtmfrentecaixa.ValorAReceber
                                                                 {(dtmfrentecaixa.ValorTotalProdutos -
                                                                   dtmfrentecaixa.ValorTotalDescontoGeral +
                                                                   dtmfrentecaixa.ValorTotalAcrescimoFinanceiro -
                                                                   dtmfrentecaixa.ValorTotalDescontoItens -
                                                                   dtmfrentecaixa.ValorTotalDescontoItemCupomDesconto -
                                                                   dtmfrentecaixa.ValorTotalDesconto_CashBack)})]));

        result :=  (OpcaoSelecionada in [smbYes, smbNo]);

      end
      else
      if (dtmfrentecaixa.vTipoDescontoAntesAlterar = 'R$') and (vNovoValorDesconto <> dtmfrentecaixa.vDescontoAntesAlterar) then
      begin
        OpcaoSelecionada := MensagemSelecionaOpcao(format('A soma dos recebimentos R$ %s difere do valor da venda de R$ %s. '+chr(13)+
                                       'Atribuir a diferença ao valor de desconto? ',
                                       [formatfloat('###,##0.00', dtmfrentecaixa.TotalRecebimentos),
                                        formatfloat('###,##0.00', dtmfrentecaixa.ValorAReceber
                                                                 {(dtmfrentecaixa.ValorTotalProdutos -
                                                                   dtmfrentecaixa.ValorTotalDescontoGeral +
                                                                   dtmfrentecaixa.ValorTotalAcrescimoFinanceiro -
                                                                   dtmfrentecaixa.ValorTotalDescontoItens -
                                                                   dtmfrentecaixa.ValorTotalDescontoItemCupomDesconto -
                                                                   dtmfrentecaixa.ValorTotalDesconto_CashBack)})]));
        result :=  (OpcaoSelecionada in [smbYes, smbNo]);
      end
      else
        result := true;

      if vNovoPercentualDesconto >= 100 then
      begin
        result := False;
        MensagemErro(
                      format('Foi concedido um desconto de %s%s.'+chr(13)+
                                     'Ultrapassando o percentual máximo. ',
                       [CurrToStr(vNovoPercentualDesconto), '%']));
        dtmfrentecaixa.ValorTotalDescontoGeral := dtmfrentecaixa.vDescontoAntesAlterar;
      end;

      if result or (OpcaoSelecionada = smbYes) then
      begin
        if parsistema.PercentualDescontoFrenteCaixa <> 0 then
          if (vNovoPercentualDesconto > parsistema.PercentualDescontoFrenteCaixa) and
             (vNovoPercentualDesconto > dtmfrentecaixa.qryTotalRecebimentopercentualdescontogeralautorizado.AsCurrency) then
          begin
            result := False;
            {
            MensagemAviso(format('Foi concedido um desconto de %s%s.'+chr(13)+
                                 'Ultrapassando o desconto máximo de %s%s ',
               [CurrToStr(vNovoPercentualDesconto), '%', floattostr(parsistema.PercentualDescontoFrenteCaixa), '%']));
            }
            if MensagemConfirmacao(
                          format('Foi concedido um desconto de %s%s.'+chr(13)+
                                         'Ultrapassando o desconto máximo de %s%s. ',
                           [CurrToStr(vNovoPercentualDesconto), '%', floattostr(parsistema.PercentualDescontoFrenteCaixa), '%'])+chr(13)+
              ctAUTORIZARDESCONTOEXTRA+'?') = smbOk then
            begin
              Usuario:= TtecUsuarios.Create(dtmTecSoft.Database);
              try
                if UsuarioLogin.DescontoExtra then
                     Usuario:= dtmfrentecaixa.ObterAutorizacao(taSENHA)
                else Usuario:= dtmfrentecaixa.ObterAutorizacao(taLOGIN, ctAUTORIZACAODESCONTO, ctAUTORIZADO);

                if Assigned(Usuario) and Usuario.DescontoExtra then
                  result := True
                else MensagemAviso(format(ctUSUARIONAOAUTORIZADO,['autorizar o desconto extra.']));
              finally
                Usuario.Free;
              end;

              if result then
                dtmfrentecaixa.qryTotalRecebimentopercentualdescontogeralautorizado.AsCurrency := vNovoPercentualDesconto;

            end;

          end;

        if result then
        begin

          if (dtmfrentecaixa.vTipoDescontoAntesAlterar = '%') then
          begin
            dtmfrentecaixa.ValorTotalDescontoGeral := vNovoPercentualDesconto;
            dtmfrentecaixa.vDescontoAntesAlterar := vNovoPercentualDesconto
          end
          else
          begin
            dtmfrentecaixa.ValorTotalDescontoGeral := vNovoValorDesconto;
            dtmfrentecaixa.vDescontoAntesAlterar := vNovoValorDesconto;
          end;

          dtmfrentecaixa.AdicionarDesconto(dtmfrentecaixa.vDescontoAntesAlterar,ifthen(rgbTipoDesconto.ItemIndex=0,'P','V'));
//          lblValorAutenticado.Caption := CurrToStrF(ValorAReceber,ffCurrency,2);
        end;
      end;

    end;
  end;
end;

function TfrmParcelasRecebimentosFrenteCaixa.VerificarDesconto_CashBack(
  zerar, Atribuir: Boolean): Boolean;
begin
  result := true;
  dtmfrentecaixa.AbrirDadosCashBack;
  if dtmfrentecaixa.ValidarDesconto_CashBack then
  begin
    if ((dtmfrentecaixa.SaldoDesconto_CashbackAtual<>0) and
        (dtmfrentecaixa.ValorTotalDesconto_CashBack=0)) or

       ((dtmfrentecaixa.SaldoDesconto_CashbackAtual>0) and
        (dtmfrentecaixa.ValorTotalDesconto_CashBack < dtmfrentecaixa.SaldoDesconto_CashbackAtual) and
        (dtmfrentecaixa.ValorTotalDesconto_CashBack < ({dtmCadastroContratos.ValorVista} dtmfrentecaixa.ValorAReceber + dtmfrentecaixa.ValorTotalDesconto_CashBack)) and
        (dtmfrentecaixa.ValorAReceber {dtmCadastroContratos.TotalContrato} > 0.01)) then
    begin
      if dtmfrentecaixa.SugerirDesconto_Cashback(true,atribuir) then
      begin
//        edtdesconto_cashback.text := floattostr(dtmfrentecaixa.ValorTotalDesconto_CashBack);
        result := atribuir;
      end
    end;
  end
  else
  begin
   if zerar then
     dtmfrentecaixa.ValorTotalDesconto_CashBack := 0;
//     edtdesconto_cashback.text := FormatarValor(0,2);
   result := false;
  end;

//  edtdesconto_cashbackGerado.text := floattostr(dtmfrentecaixa.ValorTotalDesconto_CashBackGerado);

end;

procedure TfrmParcelasRecebimentosFrenteCaixa.sbnVisualizardesconto_cashbackClick(
  Sender: TObject);
begin
  inherited;

  dtmfrentecaixa.AbrirDadosCashBack;
  frmVisualizarSaldocashback := TfrmVisualizarSaldocashback.Create(frmVisualizarSaldocashback,
                             dtmfrentecaixa.TabelaSaldoCashBack, nil);
  frmVisualizarSaldocashback.ShowModal;
  if frmVisualizarSaldocashback.ModalResult = mrOK then
  begin
    begin
      if dtmfrentecaixa.ValorTotalDesconto_CashBack <>
         dtmfrentecaixa.Saldodesconto_cashbackAtual then
      begin
        dtmfrentecaixa.SugerirDesconto_Cashback(false,true);
//        edtdesconto_cashback.text := floattostr(dtmfrentecaixa.ValorTotalDesconto_CashBack);
//        dtmCadastroContratos.CalcularValorAVista;
//        dtmCadastroContratos.PrecisaReCalcularParcelas := true;
      end;
    end;
  end;
  frmVisualizarSaldocashback.Free;
  Application.BringToFront;

end;

procedure TfrmParcelasRecebimentosFrenteCaixa.edtdesconto_cashbackExit(
  Sender: TObject);
begin
  inherited;
  VerificarDesconto_CashBack;
end;

function TfrmParcelasRecebimentosFrenteCaixa.VerificarDesconto_CashBack: Boolean;
begin
  with dtmfrentecaixa do
  begin
    if (edtdesconto_cashback.ValorSemFormatacao > ValorTotaldesconto_cashbackAnt) or
       (edtdesconto_cashback.ValorSemFormatacao > ValorAReceber) then   {Gedovar ...verificar}
    begin
//      desconto_cashback := edtdesconto_cashback.ValorSemFormatacao;
      if not ValidarDesconto_CashBack(true) then
      begin
        ValorTotalDesconto_cashback := ValorTotaldesconto_cashbackAnt;
        edtdesconto_cashback.SetFocus;
        edtdesconto_cashback.SelectAll;
      end;
    end;
    dtmfrentecaixa.ValorTotalDesconto_CashBackAnt := dtmfrentecaixa.ValorTotalDesconto_CashBack;
    CalcularCashBackGerado;
  end;


//  edtdesconto_cashback.text := floattostr(dtmfrentecaixa.ValorTotalDesconto_CashBack);
//  lblValorAutenticado.Caption := CurrToStrF(dtmfrentecaixa.ValorAReceber,ffCurrency,2);
end;

procedure TfrmParcelasRecebimentosFrenteCaixa.edtdesconto_cashbackEnter(
  Sender: TObject);
begin
  inherited;
  dtmfrentecaixa.ValorTotalDesconto_CashBackAnt := dtmfrentecaixa.ValorTotalDesconto_CashBack;
end;

procedure TfrmParcelasRecebimentosFrenteCaixa.fraConsultaCupom_DescontoedfCodigoEnter(
  Sender: TObject);
begin
  inherited;
  fraConsultaCupom_Desconto.edfCodigoEnter(Sender);
  dtmfrentecaixa.codigo_cupomAnt := dtmfrentecaixa.qryTotalRecebimentocodigo_cupom.asString;

end;

procedure TfrmParcelasRecebimentosFrenteCaixa.fraConsultaCupom_DescontoedfCodigoExit(
  Sender: TObject);
begin
  inherited;
  fraConsultaCupom_Desconto.edfCodigoExit(Sender);

  if (dtmfrentecaixa.codigo_cupomAnt <> dtmfrentecaixa.qryTotalRecebimentocodigo_cupom.asString) then
  begin
    dtmfrentecaixa.CalcularDesconto_cupons_desconto;
    dtmfrentecaixa.CalcularCashBackGerado;
  end;

end;

end.
