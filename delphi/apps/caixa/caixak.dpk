package caixak;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$SONAME 'caixa'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  baseclx,
  visualclx,
  repositoriok;

contains
  clhistorico in 'clhistorico.pas',
  dmautenticacoes in 'dmautenticacoes.pas' {dtmautenticacoes: TDataModule},
  dmautenticacoesauxiliar in 'dmautenticacoesauxiliar.pas' {dtmautenticacoesauxiliar: TDataModule},
  dmfechamentocaixa in 'dmfechamentocaixa.pas' {dtmfechamentocaixa: TDataModule},
  fmautenticacoes in 'fmautenticacoes.pas' {frmAutenticacoesCaixa},
  fmconsultafitadecaixa in 'fmconsultafitadecaixa.pas' {frmConsultaFitaDeCaixa},
  fmfechamentocaixa in 'fmfechamentocaixa.pas' {frmfechamentocaixa},
  fmimpressaoautenticacao in 'fmimpressaoautenticacao.pas' {frmimpressaoautenticacao},
  fmfrentecaixa in 'fmfrentecaixa.pas' {frmFrenteCaixa},
  rgcaixa in 'rgcaixa.pas',
  fmvalorparcial in 'fmvalorparcial.pas' {frmValorParcial},
  fmparcelaquitacaoextra in 'fmparcelaquitacaoextra.pas' {frmParcelaQuitacaoExtra},
  fminformacoestef in 'fminformacoestef.pas' {frmInformacoesTEF},
  dmfrentecaixa in 'dmfrentecaixa.pas' {dtmFrenteCaixa: TDataModule},
  fmtefdedicado in 'fmtefdedicado.pas' {frmTEFDedicado},
  fmadmintefdedicado in 'fmadmintefdedicado.pas' {frmAdministracaoTEFDedicado},
  fmtrococaixa in 'fmtrococaixa.pas' {frmTrocoCaixa},
  dmquitacaoextracaixa in 'dmquitacaoextracaixa.pas' {dtmQuitacaoExtraCaixa: TDataModule},
  fmquitacaoextracaixa in 'fmquitacaoextracaixa.pas' {frmQuitacaoExtraCaixa},
  fmclientefrentecaixa in 'fmclientefrentecaixa.pas' {frmClienteFrenteCaixa},
  fmcadastrochequefrentecaixa in 'fmcadastrochequefrentecaixa.pas' {frmCadastroChequeFrenteCaixa},
  fmCancelaItemFrenteCaixa in 'fmCancelaItemFrenteCaixa.pas' {frmCancelaItemFrenteCaixa},
  fmrelatoriocaixa in 'fmrelatoriocaixa.pas' {frmrelatoriocaixa},
  dmrelatoriocaixa in 'dmrelatoriocaixa.pas' {dtmrelatoriocaixa: TDataModule},
  fmcadastroatendimentocaixa in 'fmcadastroatendimentocaixa.pas' {frmCadastroAtendimentosCaixa};

end.
