        DataType = ftBoolean
        Name = 'vaicartasefoianterior'
        ParamType = ptUnknown
        Value = 'false'
      end
      item
        DataType = ftUnknown
        Name = 'InscreverPessoaJuridicaSPC'
        ParamType = ptUnknown
      end>
  end
