        '                               where codigo = parcelas_cartas_ti' +
        'po.tipocartadaparcela),0)))'
      '          ) as parcelas_cartas_tipo_distinta'
      '        ) as  parcelas_cartas_tipo_definida_e_Filtrada'
      '           WHERE agente NOT IN (SELECT agente'
      
        '                                               FROM agentestipos' +
