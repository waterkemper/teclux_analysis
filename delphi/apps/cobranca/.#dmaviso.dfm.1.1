      end
      item
        DataType = ftUnknown
        Name = 'filiais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'TipoCarta'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'insert into cartasclientes (carta, eavalista, data, bloqueada)'
      '('
      
        'SELECT  NumeroCarta(tipocartadefinida,cliente, tipocliente, aval' +
        'ista) as carta,'
      '             false as eAvalista,'
      '             :datahora as data,'
      
        '             ObterTiposBloqueios(NOT enderecocompleto, cartadevo' +
        'lvida, SemAviso) as bloqueada'
      ' FROM'
      ' ('
      '  SELECT parcelas_cartas_com_endereco.*,'
      '              CASE WHEN (SELECT enderecoincompleto'
      '                         FROM tiposcartas'
      
        '                         WHERE codigo=tipocartadefinida) THEN Tr' +
        'ue'
      
        '              ELSE clientes_enderecocompleto(rua) END AS enderec' +
        'ocompleto,'
      ''
      '              CASE WHEN (SELECT cartadevolvida'
      '                         FROM tiposcartas'
      
        '                         WHERE codigo=tipocartadefinida) THEN fa' +
        'lse'
      
        '              ELSE  clientes_cartadevolvida(cliente, tipocliente' +
        ', false) END AS cartadevolvida,'
      ''
      '              (SELECT semaviso'
      '               FROM atendimentos'
      '               WHERE semaviso >= current_date AND'
      '                           tipo = '#39'C'#39' AND'
      '                           NOT concluido AND'
      
        '                           ((atendimentos.cliente = parcelas_car' +
        'tas_com_endereco.cliente AND'
      
        #9#9#9'     atendimentos.tipocliente = parcelas_cartas_com_endereco.' +
        'tipocliente) or'
      
        '                            (atendimentos.cliente = coalesce(par' +
        'celas_cartas_com_endereco.avalista,0) AND'
      #9#9#9'     atendimentos.tipocliente = '#39'C'#39'))'
      '              ORDER BY data DESC LIMIT 1) as SemAviso'
      '  FROM'
      '  ('
      '   SELECT parcelas_cartas_verificacao.*,'
      '          (select vf.rua'
      #9'   from vfornecedores vf'
      #9'   where vf.codigo=cliente and'
      #9'         vf.tipo=tipocliente) as rua'
      '    FROM'
      '   ('
      '    select parcelas_cartas_tipo_definida_distinta.*,'
      ''
      #9'   (select atraso'
      #9'    from tiposcartas'
      
        #9'    where codigo = parcelas_cartas_tipo_definida_distinta.tipoc' +
        'artadefinida) as atraso_cartadefinida,'
      ''
      #9'   (select atraso'
      #9'    from tiposcartas'
      
        #9'    where codigo = parcelas_cartas_tipo_definida_distinta.tipoc' +
        'artadaparcela) as atraso_cartadaparcela'
      '     from'
      '    ('
      
        '     select distinct tipocartadefinida, cliente, tipocliente, av' +
        'alista, tipocartadaparcela, confirmacao'
      '     from'
      '     ('
      #9'  SELECT parcelas_cartas_tipo_distinta.*,'
      '                 CASE WHEN :vaicartasefoianterior  THEN'
      '                   (select codigo'
      '                    from tiposcartas'
      
        '                    where coalesce(precedente,0) = coalesce(tipo' +
        'cartadaparcela,0) and'
      '                          tipo in ('#39'A'#39','#39'S'#39')'
      '                    )'
      '                 ELSE'
      '                    tipocarta'
      #9'         END AS tipocartaDefinida'
      ''
      '           FROM'
      '          ('
      
        '           select distinct tipocarta, tipocartadaparcela, client' +
        'e, tipocliente, avalista, agente, conceito, confirmacao'
      #9'   from'
      '           ('
      '            SELECT  parcelas_cartas.*,'
      '                          (SELECT codigo'
      '                           FROM    tiposcartas'
      
        '                           WHERE   datavencto <= CURRENT_DATE - ' +
        'coalesce(tiposcartas.atraso,0) AND'
      
        '                                                       tiposcart' +
        'as.inativo IS NULL AND'
      
        '                                                       tiposcart' +
        'as.tipo in ('#39'A'#39','#39'S'#39')'
      '                              %TipoCartaSelecionado'
      
        '                           ORDER BY tiposcartas.atraso DESC, tip' +
        'oscartas.codigo LIMIT 1'
      '                           ) as tipocarta,'
      ''
      
        '                           case when parcelas_cartas.cartaclient' +
        'e is null then'
      #9' '#9'                 cast(null as integer)'
      '                           else'
      '                               (select cartas.tipocarta'
      
        '                                from (cartas join cartasclientes' +
        ' on cartas.numero = cartasclientes.carta)'
      
        '                                where cartasclientes.carta  = pa' +
        'rcelas_cartas.cartacliente and'
      
        '                                      cartasclientes.numero = pa' +
        'rcelas_cartas.cartanumerocliente'
      '                                )'
      '                           end as tipocartadaparcela,'
      ''
      
        '                          case when parcelas_cartas.cartacliente' +
        ' is not null then'
      
        ' '#9'                     (select coalesce(cast(cc.confirmacao as d' +
        'ate), CURRENT_DATE)'
      
        '                              from cartas c join cartasclientes ' +
        'cc on c.numero = cc.carta'
      
        #9'                      where cc.carta = parcelas_cartas.cartacli' +
        'ente and'
      #9#9#9'            cc.numero = parcelas_cartas.cartanumerocliente'
      #9'                     )'
      #9'                  else'
      #9'                     (select cast('#39'01/01/1900'#39' as date))'
      #9'                  end as confirmacao'
      ''
      '            FROM'
      #9'    ('
      '             SELECT parcelas.contrato,'
      '                    parcelas.numero as parcela,'
      '                    contratos.cliente,'
      '                    contratos.tipocliente,'
      '                    contratos.avalista,'
      '                    contratos.agente,'
      '                    contratos.conceito,'
      #9#9'    parcelas.datavencto,'
      #9#9'    parcelas.cartacliente,'
      #9#9'    parcelas.cartanumerocliente'
      '             from parcelas,'
      #9'     ('
      #9#9'SELECT numero,'
      #9#9#9'contratos.cliente,'
      #9#9#9'contratos.tipocliente,'
      #9#9#9'contratos.avalista,'
      #9#9#9'contratos.agente,'
      #9#9#9'contratos.conceito'
      #9#9'FROM   contratos'
      #9#9'WHERE not contratos.quitado'
      #9#9#9'AND contratos.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39')'
      
        #9#9#9'AND (contratos.numero not in (select ct.origem from contratos' +
        ' ct  where ct.origem=contratos.numero))'
      
        #9#9#9'AND (case when :InscreverPessoaJuridicaSPC then true else (co' +
        'ntratos.pessoatipo='#39'F'#39') end)'
      #9#9#9'%filiais'
      #9'     ) as contratos'
      #9'     where contratos.numero = parcelas.contrato'
      
        '                AND parcelas.datavencto <= CURRENT_DATE - (SELEC' +
        'T MIN(COALESCE(atraso,0))'
      
        '                                                           FROM ' +
        'tiposcartas'
      
        '                                                           WHERE' +
        ' tiposcartas.tipo in ('#39'A'#39','#39'S'#39') AND inativo IS NULL'
      
        '                                                           %Tipo' +
        'CartaSelecionado'
      '                                                           )'
      '                AND parcelas.datapagto IS NULL'
      #9#9' AND parcelas.spccliente is null'
      '            ) as parcelas_cartas'
      ''
      '           ) as parcelas_cartas_tipo'
      '             where ((select atraso'
      '                     from tiposcartas'
      
        '                     where codigo = parcelas_cartas_tipo.tipocar' +
        'ta) > (coalesce((select atraso'
      
        '                                                                ' +
        '                 from tiposcartas'
      
        '                                                                ' +
        '                 where codigo = parcelas_cartas_tipo.tipocartada' +
        'parcela),0)))'
      '          ) as parcelas_cartas_tipo_distinta'
      '        ) as  parcelas_cartas_tipo_definida_e_Filtrada'
      '           WHERE agente NOT IN (SELECT agente'
      
        '                                               FROM agentestipos' +
        'cartas'
      
        '                                               WHERE tipocarta=t' +
        'ipocartadefinida) AND'
      '                       conceito NOT IN (SELECT conceito'
      
        '                                                 FROM conceitost' +
        'iposcartas'
      
        '                                                 WHERE tipocarta' +
        '=tipocartadefinida)'
      '        %TipoCarta'
      '      ) as parcelas_cartas_tipo_definida_distinta'
      '     ) as parcelas_cartas_verificacao'
      
        '       Where (CURRENT_DATE - confirmacao) > (atraso_cartadefinid' +
        'a - coalesce(atraso_cartadaparcela,0))'
      '   ) as parcelas_cartas_com_endereco'
      ' ) as parcelas_cartas_com_bloqueios'
      ')')
    RequestLive = True
    Left = 454
    Top = 352
    ParamData = <
      item
        DataType = ftString
        Name = 'datahora'
        ParamType = ptUnknown
        Value = #39'30/06/2005 10:20:01'#39
      end
