    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '('
      '   select  cc.enviada,'
      '             cc.eavalista,'
      '             true as obsoleta,'
      '             pc.causa,                         '
      '             pc.contratoparcela,             '
      '             p.parcelaorigem as parcela,'
      '             p.datavencto,'
      '             p.valorvencto'
      ''
      
        '   from   (cartasclientes cc  join (parcelascartas pc join parce' +
        'las p on pc.contratoparcela = p.contrato and'
      
        '                                                                ' +
        '                                  pc.parcela = p.numero)'
      
        '                                                                ' +
        '          on cc.carta = pc.carta and '
      
        '                                                                ' +
        '               cc.numero = pc.cartanumero)'
      '   where  not cc.eavalista and'
      '            cc.carta = :carta and'
      '            cc.numero = :numero  '
      ')')
    RequestLive = False
