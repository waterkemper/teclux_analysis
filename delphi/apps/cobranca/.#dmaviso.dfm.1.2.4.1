  object qryCartasDetalheEtiquetas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryCartasDetalheEtiquetasCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'SQL'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '( select * from ('
      'select   distinct'
      '         carta, numero,'
      '         sexo,'
      '         eavalista,'
      '         cliente,'
      '         tipocliente,'
      '         nomecliente,'
      '         avalista, '
      '         nomeavalista,'
      '    '#9#9' numero_rua,'
      #9#9'     complemento,'
      '         rua,'
      '         bairro,'
      '         cep,'
      '         cidade,'
      '         estado'
      'from'
      '('
      'select CartasEnderecos.*,'
      
        '          (select cl.nome from clientes cl where cl.codigo=avali' +
        'sta) as nomeavalista,'
      
        '          (select cl.sexo  from clientes cl where cl.codigo=clie' +
        'nte and '#39'C'#39'=tipocliente) as sexo,         '
      '          (Select c.nome From cidades c'
      '           Where  (c.estado = CartasEnderecos.estado)  and'
      
        '                      (c.codigo = CartasEnderecos.codigocidade))' +
        ' as Cidade,'
      '          (Select b.nome From bairros b'
      '           Where  (b.estado = CartasEnderecos.estado)  and'
      
        '                      (b.cidade = CartasEnderecos.codigocidade) ' +
        ' and'
      
        '                      (b.codigo = CartasEnderecos.codigobairro))' +
        ' as Bairro'
      'from'
      ' ( '
      '  select ParcelasCartas.*, '
      
        '           case when eavalista then (select vf.numero from vforn' +
        'ecedores vf where vf.codigo=avalista and vf.tipo='#39'C'#39')'
      
        '           else                               (select vf.numero ' +
        'from vfornecedores vf where vf.codigo=cliente and vf.tipo=tipocl' +
        'iente) end as numero_rua,'
      ''
      
        '           case when eavalista then (select vf.complemento from ' +
        'vfornecedores vf where vf.codigo=avalista and vf.tipo='#39'C'#39')'
      
        '           else                               (select vf.complem' +
        'ento from vfornecedores vf where vf.codigo=cliente and vf.tipo=t' +
        'ipocliente) end as complemento,'
      '  '
      
        '           case when eavalista then  (select vf.rua from vfornec' +
        'edores vf where vf.codigo=avalista and vf.tipo='#39'C'#39') '
      
        '           else                               (select vf.rua fro' +
        'm vfornecedores vf where vf.codigo=cliente and vf.tipo=tipoclien' +
        'te) end as rua,'
      
        '           case when eavalista then (select vf.estado from vforn' +
        'ecedores vf where vf.codigo=avalista and vf.tipo='#39'C'#39') '
      
        '           else                               (select vf.estado ' +
        'from vfornecedores vf where vf.codigo=cliente and vf.tipo=tipocl' +
        'iente) end as estado,'
      
        '           case when eavalista then (select vf.cep from vfornece' +
        'dores vf where vf.codigo=avalista and vf.tipo='#39'C'#39') '
      
        '           else                               (select vf.cep fro' +
        'm vfornecedores vf where vf.codigo=cliente and vf.tipo=tipoclien' +
        'te) end as cep,'
      
        '           case when eavalista then (select vf.cidade from vforn' +
        'ecedores vf where vf.codigo=avalista and vf.tipo='#39'C'#39') '
      
        '           else                               (select vf.cidade ' +
        'from vfornecedores vf where vf.codigo=cliente and vf.tipo=tipocl' +
        'iente)  end as codigocidade,'
      
        '           case when eavalista then (select vf.bairro from vforn' +
        'ecedores vf where vf.codigo=avalista and vf.tipo='#39'C'#39') '
      
        '           else                               (select vf.bairro ' +
        'from vfornecedores vf where vf.codigo=cliente and vf.tipo=tipocl' +
        'iente) end as codigobairro'
      ' from'
      ' ('
      '  ('
      '  select cartas.*,'
      '           ct.faturamento,'
      '           ct.nome as nomecliente, '
      '           p.contrato as contratoparcela,             '
      '           p.parcelaorigem as parcela,'
      '           p.datavencto,'
      '           p.valorvencto'
      '  from'
      '   ('
      '    select  c.numero as carta, cc.numero,'
      '             c.tipocarta,'
      '             c.cliente,'
      '             c.tipocliente,'
      '             c.avalista,'
      '             cc.enviada,'
      '             cc.eavalista             '
      '    from cartas c, cartasclientes cc'
      '           where c.numero = cc.carta and not cc.eavalista'
      '           %SQL'
      '   ) as cartas, parcelas p, contratos ct'
      
        '     where cartas.carta=p.cartacliente and cartas.numero = p.car' +
        'tanumerocliente and'
      '              ct.numero=p.contrato'
      '  )'
      '  union all'
      '  ('
      '  select cartas.*,'
      '           ct.faturamento,'
      '           ct.nome as nomecliente,'
      '           p.contrato as contratoparcela,'
      '           p.parcelaorigem as parcela,'
      '           p.datavencto,'
      '           p.valorvencto'
      '  from'
      '   ('
      '    select  c.numero as carta, cc.numero,'
      '             c.tipocarta,'
      '             c.cliente,'
      '             c.tipocliente,'
      '             c.avalista,'
      '             cc.enviada,'
      '             cc.eavalista'
      '    from cartas c, cartasclientes cc'
      '           Where c.numero = cc.carta and cc.eavalista'
      '           %SQL'
      '   ) as cartas, parcelas p, contratos ct'
      
        '     where cartas.carta=p.cartaavalista and cartas.numero = p.ca' +
        'rtanumeroavalista and'
      '              ct.numero=p.contrato'
      '  )'
      ' ) as ParcelasCartas'
      ') as CartasEnderecos'
      ') as cartasetiquetas'
      
        '  order by carta, numero, sexo, eavalista, cliente, tipocliente,' +
        ' nomecliente,'
      '    avalista, nomeavalista, rua, bairro, cep, cidade, estado'
      ') as cartasetiquetas'
      
        '  order by cep, UPPER(TO_ASCII(rua,'#39'LATIN1'#39')), UPPER(TO_ASCII(ba' +
        'irro,'#39'LATIN1'#39')),  UPPER(TO_ASCII(cidade,'#39'LATIN1'#39')), estado, UPPE' +
        'R(TO_ASCII(nomecliente,'#39'LATIN1'#39')), carta, numero'
      ')')
    RequestLive = False
    Left = 64
    Top = 456
