  object qryGerarCartas_Avalistas_Anterior: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'insert into cartasclientes (carta, eavalista, data, bloqueada)'
      '('
      
        'SELECT  NumeroCarta(tipocartadefinida,cliente, tipocliente, aval' +
        'ista) as carta,'
      '             true as eAvalista,'
      '             :datahora as data,'
      
        '             ObterTiposBloqueios(NOT enderecocompleto, cartadevo' +
        'lvida, SemAviso) as bloqueada'
      ' FROM'
      ' ('
      '  SELECT parcelas_cartas_com_endereco.*,'
      '              CASE WHEN (SELECT enderecoincompleto'
      '                                   FROM tiposcartas'
      
        '                                   WHERE codigo=tipocartadefinid' +
        'a) THEN true'
      
        '              ELSE clientes_enderecocompleto(rua) END AS enderec' +
        'ocompleto,'
      ''
      '              CASE WHEN (SELECT cartadevolvida'
      '                                  FROM tiposcartas'
      
        '                                 WHERE codigo=tipocartadefinida)' +
        ' THEN false'
      
        '              ELSE  clientes_cartadevolvida(avalista, '#39'C'#39', true)' +
        '  END AS cartadevolvida,'
      ''
      '              (SELECT semaviso'
      '               FROM atendimentos'
      '               WHERE semaviso >= current_date AND'
      '                           tipo = '#39'C'#39' AND'
      '                           NOT concluido AND'
      
        '                           ((atendimentos.cliente = parcelas_car' +
        'tas_com_endereco.cliente AND atendimentos.tipocliente = parcelas' +
        '_cartas_com_endereco.tipocliente) OR'
      
        '                            (atendimentos.cliente = parcelas_car' +
        'tas_com_endereco.avalista AND atendimentos.tipocliente = '#39'C'#39'))'
      '              ORDER BY data DESC LIMIT 1) as SemAviso'
      '  FROM'
      '  ('
      '   SELECT parcelas_cartas_verificacao.*,'
      
        '                (select vf.rua from vfornecedores vf where vf.co' +
        'digo=avalista and vf.tipo='#39'C'#39') as rua'
      '    FROM'
      '   ('
      '    select parcelas_cartas_tipo_definida_distinta.*,'
      ''
      
        '           case when (coalesce(parcelas_cartas_tipo_definida_dis' +
        'tinta.tipocartadaparcela,0)<>0) then'
      
        #9'      (select coalesce(cast(cc.confirmacao as date), CURRENT_DA' +
        'TE)'
      
        '               from (cartas c join (cartasclientes cc join (parc' +
        'elas p join contratos on p.contrato = contratos.numero)'
      
        #9'                                                               ' +
        'on cc.carta = p.cartaavalista and'
      
        #9'                                                               ' +
        ' cc.numero = p.cartanumeroavalista)'
      
        #9'                                            on c.numero = cc.ca' +
        'rta)'
      
        #9'       where c.cliente = parcelas_cartas_tipo_definida_distinta' +
        '.cliente and'
      
        #9'             c.tipocliente = parcelas_cartas_tipo_definida_dist' +
        'inta.tipocliente and'
      
        #9#9'     c.avalista = parcelas_cartas_tipo_definida_distinta.avali' +
        'sta'
      #9#9'     /* Where Filial Venda */'
      '               limit 1'
      #9'      )'
      #9'   else'
      #9'     (select cast('#39'01/01/1900'#39' as date))'
      #9'   end as confirmacao,'
      ''
      #9'   (select atraso'
      #9'    from tiposcartas'
      
        #9'    where codigo = parcelas_cartas_tipo_definida_distinta.tipoc' +
        'artadefinida) as atraso_cartadefinida,'
      ''
      #9'   (select atraso'
      #9'    from tiposcartas'
      
        #9'    where codigo = parcelas_cartas_tipo_definida_distinta.tipoc' +
        'artadaparcela) as atraso_cartadaparcela'
      '     from'
      '    ('
      
        '     select distinct tipocartadefinida, cliente, tipocliente, av' +
        'alista, tipocartadaparcela'
      '     from'
      '     ('
      #9'  SELECT parcelas_cartas_tipo_distinta.*,'
      '                       CASE WHEN :vaicartasefoianterior  then'
      '                          (select codigo'
      '                           from tiposcartas'
      
        '                           where coalesce(precedente,0) = coales' +
        'ce(tipocartadaparcela,0) and'
      '                                 tipo in ('#39'A'#39','#39'S'#39'))'
      #9#9'     else'
      #9#9'     tipocarta'
      #9'           END AS tipocartaDefinida'
      '           FROM'
      '          ('
      
        '           select distinct tipocarta, tipocartadaparcela, client' +
        'e, tipocliente, avalista, agente, conceito'
      #9'   from'
      '           ('
      '            SELECT  parcelas_cartas.*,'
      '                          (SELECT codigo'
      '                           FROM    tiposcartas'
      
        '                           WHERE   datavencto <= CURRENT_DATE - ' +
        'coalesce(tiposcartas.atraso,0) AND'
      
        '                                                       tiposcart' +
        'as.inativo IS NULL AND'
      
        '                                                       tiposcart' +
        'as.tipo in ('#39'A'#39','#39'S'#39')'
      
        '                           ORDER BY tiposcartas.atraso DESC, tip' +
        'oscartas.codigo LIMIT 1'
      '                           ) as tipocarta'
      '            FROM'
      #9'    ('
      '             SELECT parcelas.contrato,'
      '                          parcelas.numero as parcela,'
      '                          contratos.cliente,'
      '                          contratos.tipocliente,'
      '                          contratos.avalista,'
      '                          contratos.agente,'
      '                          contratos.conceito,'
      
        '                          (select min(p.datavencto)  from contra' +
        'tos ct, parcelas p  where ct.numero = p.contrato and p.datapagto' +
        ' is null '
      
        '                                                                ' +
        '           and ct.cliente = contratos.cliente and ct.tipocliente' +
        ' = contratos.tipocliente and '
      
        '                                                                ' +
        '           ct.filialvenda = contratos.filialvenda and  '
      
        '                                                                ' +
        '           coalesce(ct.avalista,0) = coalesce(contratos.avalista' +
        ',0) and'
      
        '                                                                ' +
        '           (ct.numero not in (select ct2.origem from contratos c' +
        't2  where ct2.origem=ct.numero)) and  '
      
        '                                                                ' +
        '           ct.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39')) as datavencto,'
      
        '                    case when parcelas.cartaavalista is null the' +
        'n'
      '                      (select cartas.tipocarta'
      
        '                       from (cartas join (cartasclientes join (p' +
        'arcelas join contratos ct on parcelas.contrato = ct.numero)'
      
        '                                                                ' +
        '  on cartasclientes.carta = parcelas.cartaavalista and cartascli' +
        'entes.numero = parcelas.cartanumeroavalista)'
      
        '                                                        on carta' +
        's.numero = cartasclientes.carta)'
      
        '                       where  ct.filialvenda = contratos.filialv' +
        'enda and'
      
        '                                cartas.cliente = contratos.clien' +
        'te and cartas.tipocliente = contratos.tipocliente and'
      
        '                             cartas.avalista = contratos.avalist' +
        'a'
      '                       order by cartasclientes.data desc limit 1'
      '                       )'
      '                    else'
      '                      (select cartas.tipocarta'
      
        '                       from (cartas join cartasclientes on carta' +
        's.numero = cartasclientes.carta)'
      
        '                       where cartasclientes.carta = parcelas.car' +
        'taavalista and'
      
        '                             cartasclientes.numero = parcelas.ca' +
        'rtanumeroavalista'
      '                       )'
      '                    end as tipocartadaparcela'
      ''
      
        '              FROM   ((contratos JOIN parcelas ON contratos.nume' +
        'ro = parcelas.contrato)'
      
        '                           left join (cartas join spc on cartas.' +
        'numero = spc.carta)'
      
        '                                       on contratos.cliente = ca' +
        'rtas.cliente and'
      
        '                                          contratos.tipocliente ' +
        '= cartas.tipocliente and'
      
        '                                          contratos.avalista = c' +
        'artas.avalista)'
      
        '              WHERE parcelas.datapagto IS NULL and contratos.ava' +
        'lista is not null'
      
        '                AND parcelas.datavencto <= CURRENT_DATE - (SELEC' +
        'T MIN(COALESCE(atraso,0))'
      
        '                                                           FROM ' +
        'tiposcartas'
      
        '                                                           WHERE' +
        ' tiposcartas.tipo in ('#39'A'#39','#39'S'#39')'
      
        '                                                              AN' +
        'D inativo IS NULL)'
      
        '                 AND (contratos.numero not in (select ct.origem ' +
        'from contratos ct  where ct.origem=contratos.numero))'
      '                 AND  contratos.pessoatipo='#39'F'#39
      '                 AND contratos.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39')'
      
        '                 AND ((spc.dataexclusao is null and spc.dataincl' +
        'usao is null) or'
      
        '                      (spc.dataexclusao is not null and spc.data' +
        'inclusao is not null))'
      '                /* where filiais/grupoFiliais */'
      '            ) as parcelas_cartas'
      '           ) as parcelas_cartas_tipo'
      '             where ((select atraso'
      '                     from tiposcartas'
      
        '                     where codigo = parcelas_cartas_tipo.tipocar' +
        'ta) >'
      '                    (coalesce((select atraso'
      '                               from tiposcartas'
      
        '                               where codigo = parcelas_cartas_ti' +
        'po.tipocartadaparcela),0)))'
      '          ) as parcelas_cartas_tipo_distinta'
      '        ) as  parcelas_cartas_tipo_definida_e_Filtrada'
      '           WHERE agente NOT IN (SELECT agente'
      
        '                                               FROM agentestipos' +
        'cartas'
      
        '                                               WHERE tipocarta=t' +
        'ipocartadefinida) AND'
      '                       conceito NOT IN (SELECT conceito'
      
        '                                                 FROM conceitost' +
        'iposcartas'
      
        '                                                 WHERE tipocarta' +
        '=tipocartadefinida)'
      '         /* Where tipo de Carta */'
      '      ) as parcelas_cartas_tipo_definida_distinta'
      '     ) as parcelas_cartas_verificacao'
      
        '       Where (CURRENT_DATE - confirmacao) > (atraso_cartadefinid' +
        'a - coalesce(atraso_cartadaparcela,0))'
      '   ) as    parcelas_cartas_com_endereco'
      ' ) as      parcelas_cartas_com_bloqueios'
      ')')
