  object qryAtualizarParcelas_Avalistas_Anterior: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      
        'UPDATE parcelas SET cartaavalista = parcelas_cartas_atuais.carta' +
        ', cartanumeroavalista = parcelas_cartas_atuais.numero'
      '  FROM'
      '    ('
      '       select  cartasclientes.carta,'
      '               cartasclientes.numero,'
      '               cartascontratos.contrato,'
      '               cartascontratos.parcela'
      '       from cartasclientes,'
      '       ('
      '        select parcelas_cartas_tipodefinida_e_Filtrada.*,'
      '              cartas.numero'
      '       from cartas,'
      '       ('
      '         select parcelas_cartas_tipodefinida.*'
      '         from'
      '         ('
      #9'  SELECT parcelas_cartas_tipo.*,'
      '                       CASE WHEN :vaicartasefoianterior then'
      '                          (select codigo'
      '                           from tiposcartas'
      
        '                           where coalesce(precedente,0) = coales' +
        'ce(tipocartadaparcela,0) and'
      '                                 tipo in ('#39'A'#39','#39'S'#39'))'
      #9'  '#9'      else'
      #9#9'     tipocarta'
      #9'           END AS tipocartaDefinida'
      '           FROM'
      '           ('
      '            SELECT  parcelas_cartas.*,'
      '                          (SELECT codigo'
      '                           FROM    tiposcartas'
      
        '                           WHERE   datavencto <= CURRENT_DATE - ' +
        'coalesce(tiposcartas.atraso,0) AND'
      
        '                                                       tiposcart' +
        'as.inativo IS NULL AND'
      
        '                                                       tiposcart' +
        'as.tipo in ('#39'A'#39','#39'S'#39')'
      
        '                           ORDER BY tiposcartas.atraso, tiposcar' +
        'tas.codigo DESC LIMIT 1'
      '                           ) as tipocarta'
      '            FROM'
      '            ('
      '             SELECT parcelas.contrato,'
      '                          parcelas.numero as parcela,'
      '                          contratos.cliente,'
      '                          contratos.tipocliente,'
      '                          contratos.avalista,'
      '                          contratos.agente,'
      '                          contratos.conceito,'
      
        '                          (select min(p.datavencto)  from contra' +
        'tos ct, parcelas p  where ct.numero = p.contrato and p.datapagto' +
        ' is null '
      
        '                                                                ' +
        '           and ct.cliente = contratos.cliente and ct.tipocliente' +
        ' = contratos.tipocliente and '
      
        '                                                                ' +
        '           ct.filialvenda = contratos.filialvenda and  '
      
        '                                                                ' +
        '           coalesce(ct.avalista,0) = coalesce(contratos.avalista' +
        ',0) and'
      
        '                                                                ' +
        '           (ct.numero not in (select ct2.origem from contratos c' +
        't2  where ct2.origem=ct.numero)) and  '
      
        '                                                                ' +
        '           ct.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39')) as datavencto,'
      
        '                    case when parcelas.cartaavalista is null the' +
        'n'
      '                      (select cartas.tipocarta'
      
        '                       from (cartas join (cartasclientes join (p' +
        'arcelas join contratos ct on parcelas.contrato = ct.numero)'
      
        '                                                on cartascliente' +
        's.carta = parcelas.cartaavalista and cartasclientes.numero = par' +
        'celas.cartanumeroavalista)'
      
        '                                                        on carta' +
        's.numero = cartasclientes.carta)'
      
        '                       where ct.filialvenda = contratos.filialve' +
        'nda and '
      
        '                                cartas.cliente = contratos.clien' +
        'te and cartas.tipocliente = contratos.tipocliente and'
      
        '                             cartas.avalista = contratos.avalist' +
        'a'
      '                       order by cartasclientes.data desc limit 1'
      '                       )'
      '                    else'
      '                      (select cartas.tipocarta'
      
        '                       from (cartas join cartasclientes on carta' +
        's.numero = cartasclientes.carta)'
      
        '                       where cartasclientes.carta = parcelas.car' +
        'taavalista and'
      
        '                             cartasclientes.numero = parcelas.ca' +
        'rtanumeroavalista'
      '                       )'
      '                    end as tipocartadaparcela'
      ''
      
        '              FROM   ((contratos JOIN parcelas ON contratos.nume' +
        'ro = parcelas.contrato)'
      
        '                           left join (cartas join spc on cartas.' +
        'numero = spc.carta)'
      
        '                                       on contratos.cliente = ca' +
        'rtas.cliente and'
      
        '                                          contratos.tipocliente ' +
        '= cartas.tipocliente and'
      
        '                                          contratos.avalista = c' +
        'artas.avalista)'
      
        '              WHERE parcelas.datapagto IS NULL and contratos.ava' +
        'lista is not null'
      
        '                AND parcelas.datavencto <= CURRENT_DATE - (SELEC' +
        'T MIN(COALESCE(atraso,0))'
      
        '                                                           FROM ' +
        'tiposcartas'
      
        '                                                           WHERE' +
        ' tiposcartas.tipo in ('#39'A'#39','#39'S'#39')'
      
        '                                                              AN' +
        'D inativo IS NULL)'
      
        '                 AND (contratos.numero not in (select ct.origem ' +
        'from contratos ct  where ct.origem=contratos.numero))'
      '                 AND  contratos.pessoatipo='#39'F'#39
      '                 AND contratos.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39')'
      
        '                 AND ((spc.dataexclusao is null and spc.dataincl' +
        'usao is null) or'
      
        '                      (spc.dataexclusao is not null and spc.data' +
        'inclusao is not null))'
      '                 /* where filiais/grupoFiliais */'
      '            ) as parcelas_cartas'
      '           ) as parcelas_cartas_tipo'
      '             where ((select atraso'
      '                     from tiposcartas'
      
        '                     where codigo = parcelas_cartas_tipo.tipocar' +
        'ta) >'
      '                    (coalesce((select atraso'
      '                               from tiposcartas'
      
        '                               where codigo = parcelas_cartas_ti' +
        'po.tipocartadaparcela),0)))'
      '          ) as parcelas_cartas_tipodefinida'
      '           WHERE agente NOT IN (SELECT agente'
      
        '                                               FROM agentestipos' +
        'cartas'
      
        '                                               WHERE tipocarta=t' +
        'ipocartadefinida) AND'
      '                       conceito NOT IN (SELECT conceito'
      
        '                                                FROM conceitosti' +
        'poscartas'
      
        '                                                WHERE tipocarta=' +
        'tipocartadefinida)'
      '                   /* Where tipo de Carta */'
      '        ) as parcelas_cartas_tipodefinida_e_Filtrada'
      
        '        where cartas.cliente=parcelas_cartas_tipodefinida_e_Filt' +
        'rada.cliente and'
      
        '              cartas.tipocliente=parcelas_cartas_tipodefinida_e_' +
        'Filtrada.tipocliente and'
      
        '                 cartas.tipocarta=parcelas_cartas_tipodefinida_e' +
        '_Filtrada.TipoCartaDefinida and'
      
        '                 cartas.avalista = parcelas_cartas_tipodefinida_' +
        'e_Filtrada.avalista'
      '        order by cartas.numero'
      '       )  as  cartascontratos'
      '       where cartascontratos.numero = cartasclientes.carta and'
      '             cartasclientes.data = :datahora  and'
      '             cartasclientes.eavalista'
      '       order by contrato, parcela'
      '       ) as parcelas_cartas_atuais'
      '  WHERE  parcelas.contrato = parcelas_cartas_atuais.contrato AND'
      '         parcelas.numero = parcelas_cartas_atuais.parcela')
    RequestLive = True
    Left = 806
    Top = 552
    ParamData = <
      item
        DataType = ftBoolean
        Name = 'vaicartasefoianterior'
        ParamType = ptUnknown
        Value = 'false'
      end
      item
        DataType = ftString
        Name = 'datahora'
        ParamType = ptUnknown
        Value = #39'30/06/2005 10:20:01'#39
      end>
  end
