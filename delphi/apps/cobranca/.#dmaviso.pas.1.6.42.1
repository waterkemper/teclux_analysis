function TdtmAviso.GravarAlteracoesCarta(ConfirmarTodas:Boolean): Boolean;
Var
 DataConfirmacao : String;
 RegistroAtual : TBookmark;
begin
  {$ifndef LINUX}
   qryCartas.Post;
  {$else}
   RegistroAtual := qryCartas.GetBookmark;
   qryCartas.Post;
   qrycartas.GotoBookmark(RegistroAtual);
   qryCartas.FreeBookmark(RegistroAtual);
  {$endif}

  DataConfirmacao := qryCartasconfirmacao.AsString;
  RegistroAtual := qryCartas.GetBookmark;

  if qryCartasvoltou.AsString<>'' then
   qryUpdateCartasAlteradas.sql[1] := 'voltou = '+quotedstr(qryCartasvoltou.AsString)+','
  else
   qryUpdateCartasAlteradas.sql[1] := 'voltou = null,';

  if qryCartasconfirmacao.AsString<>'' then
   qryUpdateCartasAlteradas.sql[2] := 'confirmacao = '+quotedstr(qryCartasconfirmacao.AsString)
  else
   qryUpdateCartasAlteradas.sql[2] := 'confirmacao = null';

  qryUpdateCartasAlteradas.ParamByName('carta').AsString := qryCartascarta.AsString;
  qryUpdateCartasAlteradas.ParamByName('numero').AsString := qryCartasnumero.AsString;
  qryUpdateCartasAlteradas.ExecSql;
  if ConfirmarTodas then
  begin
   qryCartas.AfterScroll := nil;
   qryCartas.OnCalcFields := nil;
   if DataConfirmacao<>'' then
   begin
    qryUpdateCartasAlteradas.sql[1] := '';
    qryUpdateCartasAlteradas.sql[2] := 'confirmacao = '+quotedstr(DataConfirmacao);

    qryCartas.DisableControls;
    qryCartas.First;
    while not qryCartas.Eof do
    begin
     if (qryCartasconfirmacao.AsString = '') and
        (qryCartasenviada.AsString <> '') then
     begin
      if strtodate(DataConfirmacao)>=strtodate(copy(qrycartasenviada.AsString,1,10)) then
      begin
        qryCartas.Edit;
        qryCartasconfirmacao.AsString := DataConfirmacao;
        qryCartas.Post;
        qryUpdateCartasAlteradas.ParamByName('carta').AsString := qryCartascarta.AsString;
        qryUpdateCartasAlteradas.ParamByName('numero').AsString := qryCartasnumero.AsString;
        qryUpdateCartasAlteradas.ExecSql;
      end;
     end;
     qryCartas.Next;
    end;
    qrycartas.GotoBookmark(RegistroAtual);
    qryCartas.FreeBookmark(RegistroAtual);
    qryCartas.EnableControls;
   end;
   qryCartas.AfterScroll := qryCartasAfterScroll;
   qryCartas.OnCalcFields := qryCartasCalcFields;
  end;

  Perpetrar([qryUpdateCartasAlteradas]);
  Result := True;
end;

