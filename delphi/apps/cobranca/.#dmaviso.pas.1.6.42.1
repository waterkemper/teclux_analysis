procedure TdtmAviso.qryCartasCalcFields(DataSet: TDataSet);
begin
  inherited;
  qryCartasCartaNumero.AsString := qryCartascarta.AsString+'.'+qryCartasnumero.AsString;
  qryCartassituacao.AsString := '';

  if (pos('1',qryCartasbloqueada.AsString)<>0) then
    qryCartasSituacao.AsString := ctENDERECOINCOMPLETO;

  if (pos('2',qryCartasbloqueada.AsString)<>0) then
  begin
   if (qryCartasSituacao.AsString<>'') then
     qryCartasSituacao.AsString := qryCartasSituacao.AsString+', '+ctCARTADEVOLVIDA
   else qryCartasSituacao.AsString := ctCARTADEVOLVIDA;
  end;

  if (pos('3',qryCartasbloqueada.AsString)<>0) then
  begin
   ReFazConsulta(qryCartasOcorrencia,[0,1,2,3], [DataHoraLocal,
                                                 qryCartascliente.AsVariant,
                                                 qryCartastipocliente.AsVariant,
                                                 qryCartasavalista.AsVariant]);
   if not qryCartasOcorrencia.IsEmpty then
   begin
     if (qryCartassituacao.AsString<>'') then
      qryCartasSituacao.AsString := qryCartasSituacao.AsString+', '+format(ctSEMAVISOATE, [FormatDateTime('dd/mm/yy', qryCartasOcorrenciasemaviso.AsDateTime)])
     else
      qryCartasSituacao.AsString := format(ctSEMAVISOATE, [FormatDateTime('dd/mm/yy', qryCartasOcorrenciasemaviso.AsDateTime)]);
   end;
  end;

  if (qryCartassituacao.AsString<>'') then
    qryCartasNbloqueada.AsString := ANSIuppercase(ctBLOQUEADA)
  else qryCartasNbloqueada.AsString :='';

  if qryCartaseavalista.AsBoolean then
    qryCartasTipoEndereco.AsString := ctENDERECOSCARTASAVALISTA
  else qryCartasTipoEndereco.AsString := ctENDERECOSCARTASCLIENTE;
end;

