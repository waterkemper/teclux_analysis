procedure TdtmAviso.ImprimirCartas;
var
 Relatorio : TfrReport;
 frmPreview: TfrmPreviewPadrao;
 ListadeCartas, ListadeAvisos : String;
begin
 frVariables['titulo']   := 'AVISO de COBRANÇA';
 DataHoraGravacao := datetimetostr(DataHoraLocal);
 ListadeAvisos := ListaNumeroAviso;
 if ListadeAvisos<>'' then
 begin
  qryAvisosCartas.sql[9]:='and codigo in ('+ListadeAvisos+')';
  ReFazConsulta(qryAvisosCartas,[],[]);
  if VerificarExistenciadeArquivos then
  begin
    if not FCartaNaoImpressa then
      GravaCartaEnviada;
    frVariables['Rua']   := RuaFilialBase;
    frVariables['Bairro']:= BairroFilialBase + ' - CEP: ' + CEPFilialBase;
    frVariables['Cidade']:= CidadeFilialBase + ' - ' + EstadoFilialBase;
    frVariables['Fone']  := FoneFilialBase;
    frVariables['Empresa']  := RazaoFilialBase;
    frVariables['Emissor']  := 'Gerente de Cobranca';
    frmPreview := TfrmPreviewPadrao.create(self);
    try
     Relatorio := frmPreview.frCompositeReport;
     with frmPreview do
     begin
      frCompositeReport.Reports.Clear;
      qryAvisosCartas.First;
      while not qryAvisosCartas.Eof do
      begin
       ListadeCartas:= ListaNumerocarta(qryAvisosCartascodigo.AsString);
       qryUpdateCartasImpressas.ParamByName('enviada').AsString := FDataHoraGravacao;
       qryUpdateCartasImpressas.Sql[1] := 'Where (carta,numero) in ('+ListadeCartas+')';
       qryUpdateCartasImpressas.ExecSql;
       perpetrar([qryUpdateCartasImpressas]);
       qrycartasDetalhe.macrobyname('SQL').asstring := ' and c.tipocarta = '+quotedstr(qryAvisosCartascodigo.AsString)+
                                   ' and (c.numero,cc.numero) in ('+ListadeCartas+')';

//       qrycartasDetalhe.Sql[70] := qrycartasDetalhe.Sql[45];

       frpAvisoCobranca.LoadFromFile(qryAvisosCartasarquivo.AsString);
       frCompositeReport.Reports.Clear;

       frCompositeReport.Reports.Add(frpAvisoCobranca);
       Relatorio.Preview := frmPreview.frPreviewPadrao;

       Relatorio.ShowReport;
       frmPreview.ShowModal;
       qryavisoscartas.Next;
      end;
     end;
    finally
     frmPreview.Free;
     if FCartaNaoImpressa then
     begin
       ReFazConsulta(qrycartas,[],[]);
       qryCartasAfterScroll(qrycartas);
       FQtdeMarcados := 0;

       AvisosCartasSelecionadas[TipoAviso].Clear;
       AvisosCartasSelecionadas[Carta].Clear;
       AvisosCartasSelecionadas[Numero].Clear;       
       AvisosCartasSelecionadas[CartaNumero].Clear;
       AvisosCartasSelecionadas[Imprimir].Clear;

     end;
    end;
  end;
 end
 else
  MensagemAviso(ctCARTAOBSOLETANAOIMPRESSA);
end;

function TdtmAviso.VerificarExistenciadeArquivos: Boolean;
var
 AvisoMarcado : Boolean;
begin
 AvisoMarcado := False;
 Result := True;
 qryAvisosCartas.First;
 while not qryavisosCartas.Eof do
 begin
  AvisoMarcado := True;
  case OpcaoAvisosCartas of
   0 : begin
        Result := qryAvisosCartasarquivo.AsString<>'';
        if not Result then
        begin
         MensagemErro(format(ctARQUIVONAOENCONTRADO,[ctMODELOCARTA+' '+ctTIPOSDECARTA+': '+qryAvisosCartasTipo.asstring+' '+ctCODIGO+': '+qryAvisoscodigo.asstring]));
         break;
        end
        else
        begin
         Result := FileExists(ExtractFilePath(Application.ExeName) + qryAvisosCartasarquivo.AsString);
         if not Result then
         begin
          MensagemErro(format(ctARQUIVONAOENCONTRADO, [qryavisosCartasarquivo.asString]));
          break;
         end;
        end;
       end;
   1 : begin
        Result := qryAvisosCartasetiqueta.AsString<>'';
        if not Result then
        begin
         MensagemErro(format(ctARQUIVONAOENCONTRADO,[ctMODELOETIQUETA+' '+ctTIPOSDECARTA+': '+qryAvisosCartasTipo.asstring+' '+ctCODIGO+': '+qryAvisoscodigo.asstring]));
         break;
        end
        else
        begin
         Result := FileExists(ExtractFilePath(Application.ExeName) + qryAvisosCartasetiqueta.AsString);
         if not Result then
         begin
          MensagemErro(format(ctARQUIVONAOENCONTRADO, [qryavisosCartasetiqueta.asString]));
          break;
         end;
        end;
       end;
   2 : begin
        Result := (qryAvisosCartascampos.AsString<>'') and
                  (qryAvisosCartascampos.AsString<>'0000000000000000000000');
        if not Result then
        begin
         MensagemErro(ctERRORMALADIRETAGERACAO);
         break;
        end
        else
        begin
         Result := qryAvisosCartasexportar.AsString<>'';
         if not Result then
         begin
          MensagemErro(format(ctARQUIVONAOENCONTRADO,[ctEXPORTACAO+' '+ctTIPOSDECARTA+': '+qryAvisosCartasTipo.asstring+' '+ctCODIGO+': '+qryAvisoscodigo.asstring]));
          break;
         end
         else
         begin
          Result :=  DirectoryExists(ExtractFilePath(qryAvisosCartasexportar.AsString));
          if not Result then
          begin
           MensagemErro(format(ctDIRETORIONAOENCONTRADO, [ExtractFilePath(qryavisosCartasexportar.asstring)]));
           break;
          end;
         end;
        end;
       end;
  end;
  qryavisosCartas.Next;
 end;
 if Result then
  Result := AvisoMarcado;
 if not AvisoMarcado then
  MensagemAviso(ctCARTAOBSOLETANAOIMPRESSA);
end;

procedure TdtmAviso.MontarFiltroFiliais(Usar: TCheckListBox);
var
  STRFiliais: String;
  TodasFiliais: Boolean;
  cnt: Integer;
begin
  TodasFiliais := True;
  STRFiliais := '';
  for cnt := 0 to FListaFiliais.Count - 1 do
    if Usar.Checked[cnt] then
      STRFiliais := STRFiliais + '''' + IntToStr(Integer(FListaFiliais.Objects[cnt])) + ''','
    else
      TodasFiliais := False;

  STRFiliais := Copy(STRFiliais, 0, Length(STrFiliais) - 1);
  Filiais := STRFiliais;
  if Trim(STRFiliais) <> '' then
    if TodasFiliais then
      Filiais := '';
end;

procedure TdtmAviso.MontarFiltroGrupoFiliais(Usar: TCheckListBox);
var
  STRGruposFiliais: String;
