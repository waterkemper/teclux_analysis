procedure TdtmAviso.qryCartasmarcarChange(Sender: TField);
var
 index : integer;
begin
  inherited;
  if not qrycartas.IsEmpty then
  begin
   if qryCartasmarcar.AsBoolean then
   begin
     AvisosCartasSelecionadas[TipoAviso].Add(qryCartastipocarta.AsString);
     AvisosCartasSelecionadas[Carta].add(qryCartascarta.AsString);
     AvisosCartasSelecionadas[Numero].add(qryCartasnumero.AsString);
     AvisosCartasSelecionadas[CartaNumero].add(qryCartascarta.AsString+qryCartasnumero.AsString);
     if  (not qryCartasobsoleta.AsBoolean) and
         (
          (qryCartasbloqueada.AsString='') or
          (
           (qryCartasbloqueada.AsString='3') and
            qryCartasOcorrencia.IsEmpty
          )
         ) and (qryCartasconfirmacao.IsNull) and (qryCartasvoltou.IsNull) then
       AvisosCartasSelecionadas[Imprimir].add('S')
     else
       AvisosCartasSelecionadas[Imprimir].add('N');
   end
   else
   begin
    index := AvisosCartasSelecionadas[CartaNumero].IndexOf(qryCartascarta.asstring+qryCartasnumero.asstring);
    AvisosCartasSelecionadas[Carta].Delete(index);
    AvisosCartasSelecionadas[Numero].Delete(index);
    AvisosCartasSelecionadas[CartaNumero].Delete(index);
    AvisosCartasSelecionadas[TipoAviso].Delete(index);
    AvisosCartasSelecionadas[Imprimir].Delete(index);
   end;
  end;
end;

function TdtmAviso.ListaNumeroAviso: String;
var
  I : Integer;
  Aviso, ListaAviso : String;
begin
  ListaAviso := '';
  Aviso := '';
  for I:=0 to AvisosCartasSelecionadas[TipoAviso].Count-1 do begin
    if AvisosCartasSelecionadas[Imprimir].Strings[I]='S' then begin
      if Aviso <> AvisosCartasSelecionadas[TipoAviso].Strings[I] then begin
        Aviso := AvisosCartasSelecionadas[TipoAviso].Strings[I];
        ListaAviso := ListaAviso+AvisosCartasSelecionadas[TipoAviso].Strings[I]+',';
      end;
    end;
  end;
  if ListaAviso<>'' then
    ListaAviso := Copy(ListaAviso, 0, Length(ListaAviso) - 1);
  result := ListaAviso;
end;

procedure TdtmAviso.OrdernarListaNumeroCarta;
var
  A, B : integer;
begin
  for A := 1 to AvisosCartasSelecionadas[TipoAviso].Count - 1 do begin
    B := A;
    While strtoint(AvisosCartasSelecionadas[TipoAviso].Strings[B])<
          strtoint(AvisosCartasSelecionadas[TipoAviso].Strings[B-1]) do
    begin
      AvisosCartasSelecionadas[TipoAviso].Move(B,B-1);
      AvisosCartasSelecionadas[Carta].Move(B,B-1);
      AvisosCartasSelecionadas[Numero].Move(B,B-1);      
      AvisosCartasSelecionadas[CartaNumero].Move(B,B-1);
      AvisosCartasSelecionadas[Imprimir].Move(B,B-1);
      if B=1 then
        break
      else
        B := B-1;
    end;
  end;
end;

