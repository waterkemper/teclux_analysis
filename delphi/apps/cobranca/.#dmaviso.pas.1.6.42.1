function TdtmAviso.GerarCartas: Boolean;
var
  i: integer;
begin
 qryGerarCartas_Clientes.ParamByName('vaicartasefoianterior').AsBoolean := ParSistema.VaiCartasefoiAnterior;
 qryGerarCartas_Clientes.ParamByName('inscreverpessoajuridicaspc').AsBoolean := ParSistema.InscreverPessoaJuridicaSPC;

 qryGerarCartas_Avalistas.ParamByName('vaicartasefoianterior').AsBoolean := ParSistema.VaiCartasefoiAnterior;
 qryGerarCartas_Avalistas.ParamByName('inscreverpessoajuridicaspc').AsBoolean := ParSistema.InscreverPessoaJuridicaSPC;

 //rever as parcelas com cartas bloqueadas para ver se outras
 //parcelas não entrem na situação da já selecionada na geração anterior
 //na situaçao de não existir mais bloqueios (novos vencimentos incorporados)
 qryIniciarGravacao.Open;
 ReFazConsulta(qryAtualizarParcelasCartasBloqueadas_Clientes, [0,1],[FAvisos, FFiliais]);
 qryFinalizarGravacao.Open;

 qryIniciarGravacao.Open;
 ReFazConsulta(qryAtualizarParcelasCartasBloqueadas_Avalistas, [0,1],[FAvisos, FFiliais]);
 qryFinalizarGravacao.Open;

 // Reatualizar a data e a nova situação dos bloqueios dos alterados
 qryIniciarGravacao.Open;
 ReFazConsulta(qryAtualizarCartasBloqueadas_Clientes, [0,1,2],[FAvisos, FFiliais, FDataHoraGravacao]);
 qryFinalizarGravacao.Open;

 qryIniciarGravacao.Open;
 ReFazConsulta(qryAtualizarCartasBloqueadas_Avalistas, [0,1,2],[FAvisos, FFiliais, FDataHoraGravacao]);
 qryFinalizarGravacao.Open;

 // gerar as cartas
 // incluir as cartas de clientes de acordo com os vencimentos
 try
  qryIniciarGravacao.Open;
  qryGerarCartas_Clientes.ExecSql;
 // Atualizar os vinculos entre parcelas e cartas de clientes geradas.
  ReFazConsulta(qryAtualizarParcelas_Clientes, [0,1,2],[FAvisos, FFiliais, FDataHoraGravacao]);

  qryFinalizarGravacao.Open;
 except
  qryDesfazerGravacao.Open;
  qryDesfazerGravacao.close;
  MensagemAviso(format(ctERROPROCESSAMENTO,['gerando cartas de clientes']));
 end;

 qryIniciarGravacao.close;
 qryFinalizarGravacao.close;

 // incluir as cartas de avalistas de acordo com os vencimentos

{ AQUI E AGORA}
 try
  qryIniciarGravacao.Open;
  qryGerarCartas_Avalistas.ExecSql;
 // Atualizar os vinculos entre parcelas e cartas de avalistas geradas.
  ReFazConsulta(qryAtualizarParcelas_Avalistas, [0,1,2],[FAvisos, FFiliais, FDataHoraGravacao]);

  qryFinalizarGravacao.Open;
 except
  qryDesfazerGravacao.Open;
  qryDesfazerGravacao.close;
  MensagemAviso(format(ctERROPROCESSAMENTO,['gerando cartas de avalistas']));
 end;

{ AQUI E AGORA}

 // Transferir parcelas para parcelascartas de possível falha na trigger
 qryIniciarGravacao.Open;
 ReFazConsulta(qryAtualizarSituacao, [],[]);
 qryFinalizarGravacao.Open;

 qryIniciarGravacao.close;
 qryFinalizarGravacao.close;
 result := (qryGerarCartas_Clientes.RowsAffected<>0) or
           (qryGerarCartas_Avalistas.RowsAffected<>0) or
           (qryAtualizarParcelasCartasBloqueadas_Clientesquantidade.asinteger<>0) or
           (qryAtualizarParcelasCartasBloqueadas_Avalistasquantidade.asinteger<>0) or
           (qryAtualizarCartasBloqueadas_Clientesquantidade.AsInteger<>0) or
           (qryAtualizarCartasBloqueadas_Avalistasquantidade.AsInteger<>0) or
           (qryAtualizarParcelas_Clientesquantidade.AsInteger<>0) or
           (qryAtualizarParcelas_Avalistasquantidade.AsInteger<>0)

end;

