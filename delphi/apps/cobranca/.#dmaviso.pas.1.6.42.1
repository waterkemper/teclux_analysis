procedure TdtmAviso.ImprimirEtiquetas;
var
 aviso, Relatorio : TfrReport;
 frmPreview: TfrmPreviewPadrao;
 ListadeAvisos : String;
begin
 ListadeAvisos := ListaNumeroAviso;
 if ListadeAvisos<>'' then
 begin
   qryAvisosCartas.sql[9]:='and codigo in ('+ListadeAvisos+')';
   ReFazConsulta(qryAvisosCartas,[],[]);
   if VerificarExistenciadeArquivos then
   begin
    aviso := TFrReport.Create(self);
    frmPreview := TfrmPreviewPadrao.create(self);
    try
     Relatorio := frmPreview.frCompositeReport;
     with frmPreview do
     begin
      qryAvisosCartas.First;
      while not qryAvisosCartas.Eof do
      begin
       qryCartasDetalheEtiquetas.macrobyname('SQL').asstring := ' and c.tipocarta = '+quotedstr(qryAvisosCartascodigo.AsString)+
                                            ' and (c.numero,cc.numero) in ('+ListaNumerocarta(qryAvisosCartascodigo.AsString)+')';
//       qryCartasDetalheEtiquetas.Sql[86] := qryCartasDetalheEtiquetas.Sql[61];
//       qryCartasDetalheEtiquetas.Close;
//       qryCartasDetalheEtiquetas.open;
       aviso.LoadFromFile(qryAvisosCartasetiqueta.AsString);
//       aviso.DesignReport;
       frCompositeReport.Reports.Clear;
       frCompositeReport.Reports.Add(aviso);
       Relatorio.Preview := frmPreview.frPreviewPadrao;
       Relatorio.ShowReport;
       frmPreview.ShowModal;
       qryavisoscartas.Next;
      end;
     end;
    finally
     frmPreview.Free;
     aviso.Free;
    end;
   end;
 end
 else
  MensagemAviso(ctCARTAOBSOLETANAOIMPRESSA);
end;


procedure TdtmAviso.ExportarArquivo;
var
 arquivos: String;
 ListadeCartas, ListadeAvisos : String;
begin
 DataHoraGravacao := datetimetostr(DataHoraLocal);
 ListadeAvisos := ListaNumeroAviso;
 if ListadeAvisos<>'' then
 begin
   qryAvisosCartas.sql[9]:='and codigo in ('+ListadeAvisos+')';
   ReFazConsulta(qryAvisosCartas,[],[]);
   if VerificarExistenciadeArquivos then
   begin
    if not FCartaNaoImpressa then
      GravaCartaEnviada;
    qryAvisosCartas.First;
    while not qryAvisosCartas.Eof do
    begin
     ListadeCartas := ListaNumerocarta(qryAvisosCartascodigo.AsString);
     qryUpdateCartasImpressas.ParamByName('enviada').AsString := FDataHoraGravacao;
     qryUpdateCartasImpressas.Sql[1] := 'Where (carta,numero) in ('+ListadeCartas+')';
     qryUpdateCartasImpressas.ExecSql;
     perpetrar([qryUpdateCartasImpressas]);
     qrycartasDetalhe.macrobyname('SQL').asstring := ' and c.tipocarta = '+quotedstr(qryAvisosCartascodigo.AsString)+
                                 ' and (c.numero,cc.numero) in ('+ListadeCartas+')';

//     qrycartasDetalhe.Sql[70] := qrycartasDetalhe.Sql[45];
     ReFazConsulta(qryCartasDetalhe,[],[]);
     Mala := TStringList.Create;
     ComporCabecalho;
     qrycartasdetalhe.First;
     while not qrycartasdetalhe.Eof do
     begin
      ComporAviso;
      qrycartasdetalhe.next;
     end;
     Mala.SaveToFile(qryAvisosCartasexportar.AsString);
     arquivos := arquivos+qryAvisosCartasexportar.AsString+#10#13;
     Mala.Free;
     qryavisoscartas.Next;
    end;
    if FCartaNaoImpressa then
    begin
     ReFazConsulta(qrycartas,[],[]);
     qryCartasAfterScroll(qrycartas);
     QtdeMarcados := 0;
    end;
    MensagemAviso(format(ctARQUIVOSEXPORTADOSSUCESSO,[arquivos]));
   end;
 end
 else
  MensagemAviso(ctCARTAOBSOLETANAOIMPRESSA);
end;

procedure TdtmAviso.ComporCabecalho;
const
  Cota = '"';
var
  Cabecalho, Campos: String;
  cnt: Integer;
begin
 Campos:= qryAvisosCartascampos.AsString;
 for cnt:= 1 to Length(Campos) do
 if Campos[cnt] = '1' then
  Cabecalho:= Cabecalho + AnsiQuotedStr(CamposAviso[cnt], Cota) + ';';
 if Cabecalho[Length(Cabecalho)] = ';' then
  Delete(Cabecalho, Length(Cabecalho), 1);
 Mala.Add(Cabecalho);
end;

procedure TdtmAviso.ComporAviso;
const
  Cota = '"';
var
  Registro, Campos: String;
  cnt: Integer;
  LinhaE: T_Extenso;
begin
 Campos:= qryAvisosCartascampos.AsString;
 Registro:= '';
 for cnt:= 1 to Length(Campos) do
 begin
  if Campos[cnt] = '1' then
  case cnt of
   01: Registro:= Registro + AnsiQuotedStr(qryCartasDetalhecliente.asstring, Cota) + ';';
   02: Registro:= Registro + AnsiQuotedStr(qryCartasDetalhetipocliente.asstring, Cota) + ';';
   03: Registro:= Registro + AnsiQuotedStr(qryCartasDetalhenomecliente.asstring, Cota) + ';';
   04: Registro:= Registro + AnsiQuotedStr(qryCartasDetalhesexo.AsString, Cota) + ';';
   05: Registro:= Registro + AnsiQuotedStr(qryCartasDetalheavalista.AsString, Cota) + ';';
   06: Registro:= Registro + AnsiQuotedStr(qryCartasDetalhenomeavalista.AsString, Cota) + ';';
   07: Registro:= Registro + AnsiQuotedStr(qryCartasDetalheeavalista.AsString, Cota) + ';';
   08: Registro:= Registro + AnsiQuotedStr(qryCartasDetalhecartanumero.AsString, Cota) + ';';
   09: Registro:= Registro + AnsiQuotedStr(qryCartasDetalhetipocarta.AsString, Cota) + ';';
   10: Registro:= Registro + AnsiQuotedStr(qryCartasDetalheenviada.AsString, Cota) + ';';
   11: Registro:= Registro + AnsiQuotedStr(qryCartasDetalheMes_atual.AsString, Cota) + ';';
   12: Registro:= Registro + AnsiQuotedStr(qryCartasDetalherua.asstring, Cota) + ';';
   13: Registro:= Registro + AnsiQuotedStr(qryCartasDetalhenumero_rua.asstring, Cota) + ';';
   14: Registro:= Registro + AnsiQuotedStr(qryCartasDetalhecomplemento.asstring, Cota) + ';';
   15: Registro:= Registro + AnsiQuotedStr(qryCartasDetalheestado.AsString, Cota) + ';';
   16: Registro:= Registro + AnsiQuotedStr(qryCartasDetalhecidade.AsString, Cota) + ';';
   17: Registro:= Registro + AnsiQuotedStr(qryCartasDetalhebairro.AsString, Cota) + ';';
   18: Registro:= Registro + AnsiQuotedStr(qryCartasDetalhecep.AsString, Cota) + ';';
   19: Registro:= Registro + AnsiQuotedStr(qryCartasDetalhecontratoparcela.AsString, Cota) + ';';
   20: Registro:= Registro + AnsiQuotedStr(qryCartasDetalheparcela.AsString, Cota) + ';';
   21: Registro:= Registro + AnsiQuotedStr(qryCartasDetalhefaturamento.AsString, Cota) + ';';
   22: Registro:= Registro + AnsiQuotedStr(qryCartasDetalhedatavencto.AsString, Cota) + ';';
   23: Registro:= Registro + AnsiQuotedStr(qryCartasDetalhevalorvencto.AsString, Cota) + ';';
   24: begin
        LinhaE.ExtTamLinha[1]:= 200;
        Extenso(qryCartasDetalhevalorvencto.AsFloat,$92,'','','','',' ', LinhaE);
        Registro:= Registro + AnsiQuotedStr(trim(LinhaE.ExtLinha[1]), Cota) + ';';
       end;
  end;
 end;
 if Registro[Length(Registro)] = ';' then
   Delete(Registro, Length(Registro), 1);
 Mala.Add(Registro);
end;

procedure TdtmAviso.MontarFiltroAviso;
