procedure TdtmAviso.Etiquetas_Modelo_B;
const
  MaxCampo = 5;

type
  T_Etiquetas = Array of Record
    Tratamento : String;
    Nr         : String;
    Nome       : String;
    Endereco   : String;
    Bairro     : String;
    Cep        : String;
    Cidade     : String;
    UF         : String;
  end;

var
  Cont, NC, Colunas : Integer;
  ETiquetas: T_Etiquetas;

  procedure Imprimir;
  Var
    ETQ, NrC: Integer;

  begin
    with TextPrinter do begin
      NrC:= 1;
      while (NrC <= MaxCampo) do begin
        case NrC of
          1: begin
               for ETQ:= 1 to Colunas do begin
                 if ETiquetas[ETQ-1].Tratamento <> '' then
                   FTexto:= FTexto + '<sp>(3L)</sp><cd><e>' + ETiquetas[ETQ-1].Tratamento + '(40L)</e>'+
                   '<e>' + ETiquetas[ETQ-1].Nr + '(22R)</e></cd><sp>(2L)</sp>';
               end;
               FTexto:= FTexto + '<sbl>';
               Inc(NrC);
             end;
          2: begin
               for ETQ:= 1 to Colunas do begin
                 if ETiquetas[ETQ-1].Nome <> '' then
                   FTexto:= FTexto + '<sp>(3L)</sp><b><cd><e>' + ETiquetas[ETQ-1].Nome + '(62L)</e></cd></b><sp>(02L)</sp>';
               end;
               FTexto:= FTexto + '<sbl>';
               Inc(NrC);
             end;
          3: begin
               for ETQ:= 1 to Colunas do begin
                 if ETiquetas[ETQ-1].Endereco <> '' then
                   FTexto:= FTexto + '<sp>(3L)</sp><cd><e>' + ETiquetas[ETQ-1].Endereco + '(62L)</e></cd><sp>(02L)</sp>';
               end;
               FTexto:= FTexto + '<sbl>';
               Inc(NrC);
             end;
          4: begin
               for ETQ:= 1 to Colunas do begin
                 if ETiquetas[ETQ-1].Bairro <> '' then
                   FTexto:= FTexto + '<sp>(3L)</sp><cd><e>' + ETiquetas[ETQ-1].Bairro + '(62L)</e></cd><sp>(02L)</sp>';
               end;
               FTexto:= FTexto + '<sbl>';
               Inc(NrC);
             end;
          5: begin
               for ETQ:= 1 to Colunas do begin
                 if ETiquetas[ETQ-1].Cep <> '' then
                   FTexto:= FTexto + '<sp>(3L)</sp><cd><e>' + ETiquetas[ETQ-1].Cep + '(11L)</e>'
                                   + '<e>' + ETiquetas[ETQ-1].Cidade + '(49L)</e>'
                                   + '<e>' + ETiquetas[ETQ-1].UF + '(02L)</e></cd><sp>(02L)</sp>';

               end;
               FTexto:= FTexto + '<sbl><sbl><sbl><sbl>';
               Inc(NrC);
             end;

        end;
      end;
      FillChar(Etiquetas,SizeOf(Etiquetas),0);
      SetLength(Etiquetas,Colunas);
      NC:= 1;
    end;
  end;

begin
  Colunas := qryProcuraModelosEtiquetascoluna.AsInteger;
  Cont:= 1; NC:= 1;
  SetLength(Etiquetas,Colunas);
  qryCartasDetalheEtiquetas.First;
  while not qryCartasDetalheEtiquetas.Eof do
  begin
    while (Cont <= NCopiasEtiquetaTexto) do
    begin
      if (NC > Colunas) then
        Imprimir
      else
      begin
        if qryCartasDetalheEtiquetassexo.AsString = 'M' then
          ETiquetas[NC-1].Tratamento  := 'A/C Sr.'
        else
        if qryCartasDetalheEtiquetassexo.AsString = 'F' then
          ETiquetas[NC-1].Tratamento  := 'A/C Sra.'
        else
          ETiquetas[NC-1].Tratamento  := 'A/C A Empresa'+
                         qryCartasDetalheEtiquetascarta.asstring+'.'+
                         qryCartasDetalheEtiquetasnumero.asstring;

        ETiquetas[NC-1].Nr := 'Carta N.: '+qryCartasDetalheEtiquetascarta.asstring+'.'+
                                           qryCartasDetalheEtiquetasnumero.asstring;
        if (qryCartasDetalheEtiquetaseavalista.AsBoolean) then
         ETiquetas[NC-1].Nome := RetiraCaracteresEspeciais(qryCartasDetalheEtiquetasnomeavalista.AsString)
        else
         ETiquetas[NC-1].Nome := RetiraCaracteresEspeciais(qryCartasDetalheEtiquetasnomecliente.AsString);
        ETiquetas[NC-1].Endereco := RetiraCaracteresEspeciais(qryCartasDetalheEtiquetasrua.AsString +
                                                              ifthen(qryCartasDetalheEtiquetasnumero_rua.AsString<>'', ', ' +
                                                                     qryCartasDetalheEtiquetasnumero_rua.AsString,'') +

                                                              ifthen(qryCartasDetalheEtiquetascomplemento.AsString<>'', ' ' +
                                                              qryCartasDetalheEtiquetascomplemento.AsString,'') );

        ETiquetas[NC-1].Bairro := qryCartasDetalheEtiquetasbairro.AsString;
        ETiquetas[NC-1].Cep := FormatarCEP(qryCartasDetalheEtiquetascep.AsString);
        ETiquetas[NC-1].Cidade := qryCartasDetalheEtiquetascidade.AsString;
        ETiquetas[NC-1].UF := qryCartasDetalheEtiquetasestado.AsString;
        Inc(NC);
        Inc(Cont);
      end;
    end;
    Cont:= 1;
    qryCartasDetalheEtiquetas.Next;
  end;
  Imprimir;
end;

