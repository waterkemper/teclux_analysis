    if not Todos then begin
      qryavisos.Edit;
      qryavisosMarcar.AsBoolean:= not qryavisosMarcar.AsBoolean;
      qryavisos.Post;
    end
    else begin
      Pos:= qryavisos.GetBookmark;
      try
        qryavisos.DisableControls;
        qryavisos.First;
        for I:= 1 to qryavisos.RecordCount do begin
          qryavisos.Edit;
          if Marcando then begin
            if not qryavisosMarcar.AsBoolean then begin
              qryavisosMarcar.AsBoolean := True;
            end
          end
          else begin
            if qryavisosMarcar.AsBoolean then begin
              qryavisosMarcar.AsBoolean:= False;
            end;
          end;
          qryavisos.Post;
          qryavisos.Next;
        end;
        finally
          qryavisos.GotoBookmark(Pos);
          qryavisos.FreeBookmark(Pos);
          qryavisos.EnableControls;
        end;
    end;
  end;
end;

