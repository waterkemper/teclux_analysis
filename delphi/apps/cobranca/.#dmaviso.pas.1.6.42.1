function TdtmAviso.ExcluirCartasMarcadas: Boolean;
var
 RegistroAtual: String;
 I : integer;
begin
 RegistroAtual := qryCartasnumero.AsString;
 if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['as CARTAS marcadas, obsoletas e não devolvidas'])) = smbok then
 begin
  qrycartas.DisableControls;
  qryCartas.AfterScroll := nil;
  for I:=0 to AvisosCartasSelecionadas[carta].Count-1 do
  begin
  if qrycartas.Locate('carta;numero', vararrayof([
     AvisosCartasSelecionadas[Carta].Strings[I],
     AvisosCartasSelecionadas[Numero].Strings[I]]),[]) then
   begin
    if qryCartasobsoleta.AsBoolean and (qryCartasbloqueada.AsString='') and
       (qryCartasvoltou.AsString = '') then
    begin
      qryCartas.Delete;
      QtdeMarcados := QtdeMarcados -1;
    end;
   end;
  end;
  qrycartas.enableControls;
  qrycartas.Locate('numero',RegistroAtual,[loPartialKey]);
  qryCartas.AfterScroll := qryCartasAfterScroll;
  qryCartasAfterScroll(qrycartas);
  Result:= True;
 end
 else
  Result:= False;
end;

