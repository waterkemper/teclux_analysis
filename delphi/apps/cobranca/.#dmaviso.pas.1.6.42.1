constructor TdtmAviso.Create(AOwner: TComponent);
begin
  inherited;
  qryAvisos.Tag:= ctTabelas;
  qryFiliais.tag:= ctTabelas;
  qryProcuraClientes.Tag   := ctTabelas;
  qryGrupoFiliais.tag:= ctTabelas;
  qryProcuraTiposCartas.tag:= ctTabelas;
  qryProcuraModelosEtiquetas.Tag:= ctTabelas;
  qryConsultaTiposCartas.Tag := ctPesquisaTiposCartas;
  qryConsultaClientes.Tag := ctPesquisaClientes;
  qryConsultaModelosEtiquetas.Tag:= ctPesquisaModeloEtiqueta;
  qryProcuraClientes.Params[1].AsString := 'C';
  AvisosCartasSelecionadas[TipoAviso] := TStringList.Create;
  AvisosCartasSelecionadas[Carta] := TStringList.Create;
  AvisosCartasSelecionadas[Numero] := TStringList.Create;
  AvisosCartasSelecionadas[CartaNumero] := TStringList.Create;
  AvisosCartasSelecionadas[Imprimir] := TStringList.Create;
end;

function TdtmAviso.GetListaFiliais: TStrings;
begin
  FListaFiliais:= TStringList.Create;
  qryFiliais.First;
  while not qryFiliais.Eof do
  begin
    FListaFiliais.AddObject(qryFiliaisnome.AsString, Pointer(qryFiliaiscodigo.AsInteger));
    qryFiliais.Next;
  end;
  Result := FListaFiliais;
end;

function TdtmAviso.GetListaGruposFiliais: TStrings;
begin
  FListaGruposFiliais:= TStringList.Create;
  qryGrupoFiliais.First;
  while not qryGrupoFiliais.Eof do
  begin
    FListaGruposFiliais.AddObject(qryGrupoFiliaisdescricao.AsString, Pointer(qryGrupoFiliaiscodigo.AsInteger));
    qryGrupoFiliais.Next;
  end;
  Result := FListaGruposFiliais;
end;


