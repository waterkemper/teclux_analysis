procedure TdtmAviso.qryCartasAfterScroll(DataSet: TDataSet);
begin
  inherited;
   if not qryCartas.IsEmpty then
   begin
    qryParcelasCartas.Sql.Clear;
    if qryCartaseavalista.AsBoolean then
    begin
     qryParcelasCartas.Sql.Text := qryCartas_ParcelasCartas_Avalistas.Sql.Text;
     qryParcelasCartas.Sql.Append('union all');
     qryParcelasCartas.Sql.Text := qryParcelasCartas.Sql.Text + qryCartas_Parcelas_Avalistas.Sql.Text
    end
    else
    begin
     qryParcelasCartas.Sql.Text := qryCartas_ParcelasCartas_Clientes.Sql.Text;
     qryParcelasCartas.Sql.Append('union all');
     qryParcelasCartas.Sql.Text := qryParcelasCartas.Sql.Text + qryCartas_Parcelas_Clientes.Sql.Text;
    end;
    qryParcelasCartas.Sql.Append('order by contratoparcela, parcela');
    ReFazConsulta(qryparcelascartas,[0,1], [qryCartascarta.asvariant, qrycartasnumero.asvariant]);
   end
   else
    if (qryparcelascartas.Sql.Count > 0) then
      qryParcelasCartas.Close;
end;

procedure TdtmAviso.GravaCartaEnviada;
var
 RegistroAtual : TBookMark;
 I : integer;

begin
 RegistroAtual := qryCartas.GetBookmark;
 qrycartas.DisableControls;
 qryCartas.AfterScroll := nil;
 for I:=0 to AvisosCartasSelecionadas[carta].Count-1 do
 begin
  if AvisosCartasSelecionadas[Imprimir].Strings[I]='S' then
    if qrycartas.Locate('carta;numero', vararrayof([
    AvisosCartasSelecionadas[Carta].Strings[I],
    AvisosCartasSelecionadas[Numero].Strings[I]]),[]) then
    begin
     if not qryCartasobsoleta.AsBoolean and
      (qryCartasSituacao.AsString='') then
      case OpcaoAvisosCartas of
      0,2 : begin
             if FCartaNaoImpressa then
               QtdeMarcados  := QtdeMarcados -1;
             qryCartas.Edit;
             qryCartasenviada.AsString := FDataHoraGravacao;
             qryCartas.Post;
            end;
      end;
    end;
 end;
 qrycartas.enableControls;
 qryCartas.GotoBookmark(RegistroAtual);
 qryCartas.FreeBookmark(RegistroAtual);
 qryCartas.AfterScroll := qryCartasAfterScroll;
 qryCartasAfterScroll(qrycartas);

end;

function TdtmAviso.ListaNumeroCarta(CodigoAviso: String): String;
var
Aviso : Integer;
ListaCarta : String;
begin
 ListaCarta := '';
 OrdernarListaNumeroCarta;
 Aviso := AvisosCartasSelecionadas[TipoAviso].IndexOf(CodigoAviso);
 While (Aviso <= (AvisosCartasSelecionadas[TipoAviso].Count-1)) and
       (AvisosCartasSelecionadas[TipoAviso].Strings[Aviso]=CodigoAviso) do
 begin
  if (AvisosCartasSelecionadas[Imprimir].Strings[Aviso]='S') then
   ListaCarta := ListaCarta+'('+AvisosCartasSelecionadas[Carta].Strings[Aviso]+','+
                                AvisosCartasSelecionadas[Numero].Strings[Aviso]+'),';
  Aviso := Aviso + 1;
 end;
