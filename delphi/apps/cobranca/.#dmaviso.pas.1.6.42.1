  ListaCarta := Copy(ListaCarta, 0, Length(ListaCarta) - 1);
 result := ListaCarta;
end;

function TdtmAviso.GerarConsultaCartas(Codigocliente, TipoCarta,
 DataInicial, DataFinal: String;
 CartasValidas,
 CartasNaoEnviadas,
 CartasBloqueadas,
 CartasEnviadasNaoConfirmadas: Boolean): Boolean;
var
 STRSQL : String;
Const
 WhereCartas = 'and %s ';
 WhereCartasFililavenda =
 ' and (exists (select p.cartacliente '+
              'from parcelas p join contratos on p.contrato = contratos.numero '+
              'where p.cartacliente = cc.carta and '+
                    ' p.cartanumerocliente = cc.numero and '+
                    ' contratos.filialvenda in (%s)) '+
       ' or exists (select p.cartaavalista '+
              'from parcelas p join contratos on p.contrato = contratos.numero  '+
              'where p.cartaavalista = cc.carta and '+
                    ' p.cartanumeroavalista = cc.numero and '+
                    ' contratos.filialvenda in (%s)) '+
       ' or exists (select pc.carta '+
              'from (parcelascartas pc join (parcelas p join contratos on p.contrato = contratos.numero) '+
                                                      ' on pc.contratoparcela = p.contrato and '+
                                                      ' pc.parcela = p.numero) '+
              'where pc.carta = cc.carta and '+
                    ' pc.cartanumero = cc.numero and '+
                    ' contratos.filialvenda in (%s)) ) ';

 WhereCartasValidas =
 ' (exists (select p.cartacliente '+
              'from parcelas p '+
              'where p.cartacliente = cc.carta and '+
                    ' p.cartanumerocliente = cc.numero) '+
       ' or exists (select p.cartaavalista '+
              'from parcelas p '+
              'where p.cartaavalista = cc.carta and '+
                    ' p.cartanumeroavalista = cc.numero) ) ';

 WhereCartasNaoEnviadas =
 ' cc.enviada is null ';

 WhereCartasEnviadasnaoConfirmadas =
 ' cc.enviada is not null and cc.confirmacao is null ';

 WhereCartasBloqueadas =
 ' (coalesce(cc.bloqueada,'''')<>'''' and '+
 '  (position(''1'' in cc.bloqueada)<>0) or '+
 '  (position(''2'' in cc.bloqueada)<>0) or '+
 '  ((position(''3'' in cc.bloqueada)<>0) and '+
 '    exists (SELECT semaviso '+
 '            FROM atendimentos '+
 '            WHERE semaviso >= current_date AND '+
 '                  tipo = ''C'' AND '+
 '                  NOT concluido AND '+
 '                 ((atendimentos.cliente = cr.cliente AND '+
 '                   atendimentos.tipocliente = cr.tipocliente) OR '+
 '                  (Atendimentos.cliente = coalesce(cr.avalista,0) AND '+
 '                   atendimentos.tipocliente = ''C'')) '+
 '               ORDER BY data DESC LIMIT 1 )'+
 '  ) '+
 ' ) '  ;

 WhereCartasNaoBloqueadas =
 ' (coalesce(cc.bloqueada,'''')='''' or '+
 '  ((cc.bloqueada=''3'') and '+
 '    not exists (SELECT semaviso '+
 '                FROM atendimentos '+
 '                WHERE semaviso >= current_date AND '+
 '                      tipo = ''C'' AND '+
 '                      NOT concluido AND '+
 '                ((atendimentos.cliente = cr.cliente AND atendimentos.tipocliente = cr.tipocliente) OR '+
 '                 (Atendimentos.cliente = coalesce(cr.avalista,0) AND atendimentos.tipocliente = ''C'')) '+
 '                ORDER BY data DESC LIMIT 1 )'+
 '  ) '+
 ' ) ';
begin
  STRSQL := '';

  if (DataInicial <> '') and (DataFinal <> '') then
   STRSQL := 'cast(cc.data as date) between ('+quotedstr(DataInicial)+') and ('
                                     +quotedstr(DataFinal)+')'
  else if (DataInicial <> '') and (DataFinal = '') then
          STRSQL := 'cast(cc.data as date) = '+quotedstr(DataInicial)
  else if (DataInicial = '') and (DataFinal <> '') then
          STRSQL := 'cast(cc.data as date) = '+quotedstr(DataFinal);

  if TipoCarta <> '' then
   if STRSQL = '' then
     STRSQL := 'cr.TipoCarta = '+TipoCarta
   else STRSQL := STRSQL+' and cr.TipoCarta = '+TipoCarta;

  if CodigoCliente <> '' then
   if STRSQL = '' then
     STRSQL := ' and cr.cliente = :cliente and cr.tipocliente = :tipocliente'
   else STRSQL := STRSQL+' and cr.cliente = :cliente and cr.tipocliente = :tipocliente';

  if CartasValidas then
    if STRSQL = '' then
      STRSQL := WhereCartasValidas
    else STRSQL := STRSQL+' and '+WhereCartasValidas;

  if CartasNaoEnviadas then
   if CartasBloqueadas then
   begin
    if STRSQL = '' then
      STRSQL := WhereCartasNaoEnviadas
    else STRSQL := STRSQL+' and '+WhereCartasNaoEnviadas;
   end
   else
   begin
    if STRSQL = '' then
      STRSQL := WhereCartasNaoEnviadas+' and '+WhereCartasNaoBloqueadas
    else STRSQL := STRSQL+' and '+WhereCartasNaoEnviadas+' and '+WhereCartasNaoBloqueadas;
   end;

  if CartasEnviadasNaoConfirmadas then
   if CartasBloqueadas then
   begin
    if STRSQL = '' then
      STRSQL := WhereCartasEnviadasnaoConfirmadas
    else STRSQL := STRSQL+' and '+WhereCartasEnviadasnaoConfirmadas;
   end
   else
   begin
    if STRSQL = '' then
      STRSQL := WhereCartasEnviadasnaoConfirmadas+' and '+WhereCartasNaoBloqueadas
    else STRSQL := STRSQL+' and '+WhereCartasEnviadasnaoConfirmadas+' and '+WhereCartasNaoBloqueadas;
   end;

  if CartasBloqueadas and
     not CartasNaoEnviadas and not CartaEnviadaNaoConfirmada then
    if STRSQL = '' then
      STRSQL := WhereCartasBloqueadas
    else STRSQL := STRSQL+' and '+WhereCartasBloqueadas;

  if (FFiliais<>'') then
  begin
   if STRSQL = '' then
      STRSQL := format(WhereCartasFililavenda,[FFiliais,FFiliais,FFiliais])
   else STRSQL := STRSQL+format(WhereCartasFililavenda,[FFiliais,FFiliais,FFiliais]);
  end;

  qryCartas.Sql[83] := format(WhereCartas, [STRSQL]);

  if (CodigoCliente<>'') then
  begin
    qryCartas.ParamByName('cliente').AsString := CodigoCliente;
    qryCartas.ParamByName('tipocliente').AsString := qryProcuraClientestipo.AsString;
  end;

  FQtdeMarcados := 0;

  qryCartas.AfterScroll := nil;

  ReFazConsulta(qryCartas,[],[]);
  qryCartas.AfterScroll := qryCartasAfterScroll;
  qryCartasAfterScroll(qrycartas);

  result := not qryCartas.isempty;
  AvisosCartasSelecionadas[TipoAviso].Clear;
  AvisosCartasSelecionadas[Carta].Clear;
  AvisosCartasSelecionadas[Numero].Clear;
  AvisosCartasSelecionadas[CartaNumero].Clear;
  AvisosCartasSelecionadas[Imprimir].Clear;
end;

