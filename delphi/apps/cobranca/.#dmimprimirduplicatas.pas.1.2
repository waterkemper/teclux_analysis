      idCLIENTES: RefazConsulta(qryClientes, [0], [qryConsultaClientesCodigo.AsInteger]);
      idCONTAS:   RefazConsulta(qryContas,   [0], [qryConsultaContasConta.   AsInteger]);
   end;
end;

