procedure TdtmImprimirDuplicatas.MarcarRegistrosSelecionados(Marcando, Todos: Boolean);
begin
  MarcarRegistros(qryParcelas,
                  qryParcelasSelecionar,
                  qryParcelasValorVencto,
                  Marcando,
                  Todos);
end;


function TdtmImprimirDuplicatas.GetQtdeLidas: Integer;
begin
   Result:= qryParcelas.RecordCount;
end;

function TdtmImprimirDuplicatas.GetTotalLidas: Real;
begin
   Result:= TotalizarValores[qryParcelas, qryParcelasValorVencto];
end;

procedure TdtmImprimirDuplicatas.MarcarSelecionados(Marcando, Todos: Boolean);
var Pos: TBookmark;
    I  : Integer;

    procedure AtualizarValores;
    begin
       if qryParcelasSelecionar.AsBoolean then begin
          FQtdeMarcados  := FQtdeMarcados  + 1;
          FTotalMarcados := FTotalMarcados + qryParcelasValorVencto.AsCurrency;
       end
       else begin
          FQtdeMarcados  := FQtdeMarcados  - 1;
          FTotalMarcados := FTotalMarcados - qryParcelasValorVencto.AsCurrency;
       end;
    end;

begin
   with qryParcelas do
      if not IsEmpty
      then if not Todos then begin
              Edit;
              qryParcelasSelecionar.AsBoolean:= not qryParcelasSelecionar.AsBoolean;
              Post;
              AtualizarValores;
           end
           else begin
              Pos:= GetBookmark;
              try
                 DisableControls;
                 First;
                 for I:= 1 to RecordCount do begin
                     Edit;
                     if Marcando then begin
                        if not qryParcelasSelecionar.AsBoolean then begin
                           qryParcelasSelecionar.AsBoolean := True;
                           AtualizarValores;
                        end
                     end
                     else begin
                        if qryParcelasSelecionar.AsBoolean then begin
                           qryParcelasSelecionar.AsBoolean:= False;
                           AtualizarValores;
                        end;
                     end;
                     Post;
                     Next;
                 end;
              finally
                 GotoBookmark(Pos);
                 FreeBookmark(Pos);
                 EnableControls;
              end;
           end;
end;


procedure TdtmImprimirDuplicatas.AtualizarParcelas;
var
  Flag : Boolean;
begin
  Flag := False;
  qryparcelas.DisableControls;
  qryParcelas.First;
  while not qryParcelas.Eof do begin
    if qryParcelasSelecionar.AsBoolean then begin
      Flag := True;
      qryAtualizarParcelas.ParamByName('contaboleto').AsInteger := qryContasConta.AsInteger;
      qryAtualizarParcelas.ParamByName('contrato').AsString     := qryParcelasContrato.AsString;
      qryAtualizarParcelas.ParamByName('numero').AsInteger      := qryParcelasNumero.AsInteger;
      qryAtualizarParcelas.ExecSql;
    end;
    qryParcelas.Next;
  end;
  qryParcelas.EnableControls;

  if not Flag then begin
    MensagemAviso('Não foi selecionada nenhuma parcela.');
    Exit;
  end
  else
  begin
   Perpetrar([]);
   MensagemAviso('Parcelas gravadas com sucesso.');
  end;
  qryParcelas.Close;
end;



procedure TdtmImprimirDuplicatas.qryParcelasFilterRecord(DataSet: TDataSet;
  var Accept: Boolean);
begin
  inherited;
  accept := qryParcelasSelecionar.AsBoolean;
end;

procedure TdtmImprimirDuplicatas.ImprimirDuplicatas;
var
  dtmImprimeCarne: TdtmImprimeCarne;
  Numerocontrato: String;
  NumeroParcelas: vString;
  a: integer;
begin
  dtmImprimeCarne := TdtmImprimeCarne.Create(Self);
  qryParcelas.First;
  Numerocontrato := '';
  a := 0;

  NomeImpressoraEscolhida:=  parsistema.NomeImpressoraCarne;
  if dtmImprimeCarne.AbrirModeloCarne then
  begin
    dtmImprimeCarne.InicializarDocumento;
    GuardarRegistroAtual(qryparcelas,true);
    while not qryparcelas.Eof do
    begin
      if qryParcelasSelecionar.AsBoolean then
      begin
         Numerocontrato := qryParcelasContrato.AsString;
         While Numerocontrato = qryParcelasContrato.AsString do
         begin
           if qryParcelasSelecionar.AsBoolean then
           begin
             SetLength(NumeroParcelas,length(NumeroParcelas)+1);
             NumeroParcelas[a]:= inttostr(qryParcelasNumero.AsInteger);
             inc(a);
           end;
           qryparcelas.Next;
           if qryparcelas.Eof then
             break;
         end;

         if dtmImprimeCarne.ImprimirCarnesContrato(NumeroContrato, NumeroParcelas, false) then
         begin
           Numerocontrato := '';
           NumeroParcelas := nil;
           a := 0;
         end
         else
           break;

           if qryparcelas.Eof then
             break;

      end
      else
        qryParcelas.Next;
    end;
  end;

  if assigned(dtmImprimeCarne) then
  begin
    dtmImprimeCarne.FinalizarDocumento;
    dtmImprimeCarne.Free;
    VoltarRegistroAtual(qryparcelas);
  end;

end;


end.
