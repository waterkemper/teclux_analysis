end;


procedure TdtmImprimirDuplicatas.SetFiliais(const Value: string);
begin
  if (Value <> '') then
    qryParcelas.MacroByName('Filial').AsString  := 'and (ct.filialvenda = ' + Value + ')'
  else
    qryParcelas.MacroByName('Filial').AsString  := '';
end;

procedure TdtmImprimirDuplicatas.SetClientes(const Value: string);
begin
  if (Value <> '') then
    qryParcelas.MacroByName('Cliente').AsString := 'and (ct.cliente = ' + Value + ')'
  else
    qryParcelas.MacroByName('Cliente').AsString  := '';
end;

procedure TdtmImprimirDuplicatas.SetDataVenctoInicial(const Value: string);
begin
  FDataVenctoInicial := Value;
  qryParcelas.ParamByName('venctoinicial').AsString := FDataVenctoInicial;

  if (FDataVenctoInicial <> '') and (FDataVenctoFinal <> '')  then
     qryParcelas.MacroByName('DataVencto').AsString := 'and p.datavencto between :venctoinicial and :venctofinal'
  else
     qryParcelas.MacroByName('DataVencto').AsString := '';
end;

procedure TdtmImprimirDuplicatas.SetDataVenctoFinal(const Value: string);
begin
  FDataVenctoFinal := Value;
  qryParcelas.ParamByName('venctofinal').AsString := FDataVenctoFinal;

  if (FDataVenctoInicial <> '') and (FDataVenctoFinal <> '')  then
     qryParcelas.MacroByName('DataVencto').AsString := 'and p.datavencto between :venctoinicial and :venctofinal'
  else
     qryParcelas.MacroByName('DataVencto').AsString := '';

end;

procedure TdtmImprimirDuplicatas.SetDataVendaInicial(const Value: String);
begin
  FDataVendaInicial := Value;
  if (FDataVendaInicial <> '') and (FDataVendaFinal <> '')  then
     qryParcelas.MacroByName('DataVenda').AsString := format('and ct.faturamento between (%s) and (%s)',
                                                       [quotedstr(FDataVendaInicial),
                                                        quotedstr(FDataVendaFinal)])
  else
     qryParcelas.MacroByName('DataVenda').AsString := '';
end;

procedure TdtmImprimirDuplicatas.SetDataVendaFinal(const Value: String);
begin
  FDataVendaFinal := Value;
  if (FDataVendaInicial <> '') and (FDataVendaInicial <> '') then
    qryParcelas.MacroByName('DataVenda').AsString := format('and ct.faturamento between (%s) and (%s)',
                                                       [quotedstr(FDataVendaInicial),
                                                        quotedstr(FDataVendaFinal)])
  else
    qryParcelas.MacroByName('DataVenda').AsString := '';
end;

procedure TdtmImprimirDuplicatas.SetNotaInicial(const Value: String);
const
 SQL = 'and ct.numero in (select df.contrato '+
                         ' from dadosfiscais df '+
                         ' where df.situacao = ''N'' and '+
                              ' df.numero in (select n.dadofiscal as notafiscal '+
                                            ' from notas n '+
                                            ' where n.numero between (:NotaInicial) and (:NotaFinal)) '+
                         ' order by df.contrato)';
begin
  FNotaInicial := Value;
  if (FNotaInicial <> '') and (FNotaFinal <> '') then begin
     qryParcelas.MacroByName('NotaFiscal').AsString := SQL;
     qryParcelas.ParamByName('notainicial').AsString := FNotaInicial;
     qryParcelas.ParamByName('notafinal').AsString   := FNotaFinal;
  end else
      qryParcelas.MacroByName('NotaFiscal').AsString := '';
end;

procedure TdtmImprimirDuplicatas.SetNotaFinal(const Value: String);
const
   SQL = 'and ct.numero in (select df.contrato from dadosfiscais df ' +
              'where df.situacao = ''N'' and '  +
                  'df.numero in (select n.dadofiscal ' +
                       'from notas n ' +
                         ' where n.numero between (:notaInicial) and (:notaFinal)) '+
                                  'order by df.contrato) ';
begin
   FNotaFinal := Value;
   if (FNotaInicial <> '') and (FNotaFinal <> '') then begin
      qryParcelas.MacroByName('NotaFiscal').AsString := SQL;
      qryParcelas.ParamByName('notainicial').AsString := FNotaInicial;
      qryParcelas.ParamByName('notafinal').AsString   := FNotaFinal;
   end else
      qryParcelas.MacroByName('NotaFiscal').AsString := '';
end;



Function TdtmImprimirDuplicatas.AbrirParcelas: Boolean;
begin
  qryParcelas.DisableControls;
  ReFazConsulta(qryparcelas,[],[]);
  Result := not qryParcelas.IsEmpty;
  qryParcelas.EnableControls;
end;

