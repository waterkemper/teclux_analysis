implementation

uses dmtecsoft,Math;

{$R *.dfm}


procedure Tdtmlerretornos.AbreTabelaConsulta(TipoPesquisa: TtecGerarRemessas);
begin
  case TipoPesquisa of
    grsFILIAIS: Abre(ctConsultaFiliais);
    grsCONTAS:  Abre(ctConsultaContas);
  end;
end;

constructor Tdtmlerretornos.Create(AOwner: TComponent);
begin
  inherited;
  qryFiliais.Tag:= ctTabelas;
  qryContas. Tag:= ctTabelas;

  qryConsultaFiliais.Tag:= ctConsultaFiliais;
  qryConsultaContas. Tag:= ctConsultaContas;
end;

Function Tdtmlerretornos.ExisteFiliais(NomeCampo, Codigo: string): Boolean;
begin
  Result:= ExisteCodigo(qryConsultaFiliais,NomeCampo,Codigo);
end;

Function Tdtmlerretornos.ExisteConta(NomeCampo, Codigo: string): Boolean;
begin
  Result:= ExisteCodigo(qryConsultaContas,NomeCampo,Codigo);
end;

procedure Tdtmlerretornos.FechaTabelaConsulta(TipoPesquisa: TtecGerarRemessas);
begin
  case TipoPesquisa of
    grsFILIAIS: Fecha(ctConsultaFiliais);
    grsCONTAS:  Fecha(ctConsultaContas);
  end;
end;

Function Tdtmlerretornos.GetConsultarFiliais: TTecQuery;
begin
  Result:= qryConsultaFiliais;
end;

Function Tdtmlerretornos.GetConsultarContas: TTecQuery;
begin
  Result:= qryConsultaContas;
end;

procedure Tdtmlerretornos.Selecionar(TipoPesquisa: TtecGerarRemessas);
begin
   case TipoPesquisa of
      grsFILIAIS: RefazConsulta(qryFiliais, [0], [qryConsultaFiliaisCodigo.AsInteger]);
      grsCONTAS:  RefazConsulta(qryContas,  [0], [qryConsultaContasConta.  AsInteger]);
   end;
end;

procedure Tdtmlerretornos.SetFiliais(const Value: string);
begin
  FFiliais := Value;
{colocado em comentario - JR 18/03 - FILIAL DE PAGAMENTO SERA A INFORMADA NO FILTRO)}
{  if (Value <> '') then
    qryParcelas.MacroByName('filial').AsString := 'and (ct.filialvenda = ' + Value + ')'
  else
    qryParcelas.MacroByName('filial').AsString := ''}
end;

procedure Tdtmlerretornos.SetContas(const Value: string);
begin
  FContas:= Value;
end;

Function Tdtmlerretornos.AbrirParcelas: Boolean;
begin
  ReFazConsulta(qryparcelas,[],[]);
  Result := not qryParcelas.IsEmpty;
end;

//========================= LER RETORNO BRADESCO ===========================================================
{function Tdtmlerretornos.AtualizarParcelasBradesco(NomeArquivo: String): boolean;

var DetalhesBradesco: T_DetalheBradesco;
    Contrato: String;
    Parcela: integer;
    ACBrBoleto1: TACBrBoleto;
    titulo: TACBrTitulo;

begin
  result := false;
  Erro := False;

  qryParcelas.Close;
  if not FileExists(NomeArquivo) then
     raise exception.create(ctARQUIVOINEXISTENTE +', deve ter sido renomeado para '+ NomeArquivo + '.OLD : ' + NomeArquivo);



 ACBrBoleto1 := TACBrBoleto.Create(Self);
 ACbrBoleto1.Banco.Numero:=237;
 ACbrBoleto1.Banco.TipoCobranca:=cobBradesco;
 ACBrBoleto1.LayoutRemessa:=c400;
 ACBrBoleto1.DirArqRetorno := ExtractFileDir(NomeArquivo);
 ACBrBoleto1.NomeArqRetorno := ExtractFileName(NomeArquivo);
 if(qryContascnpj_agencia_referencia.AsString<>'') then
   ACBrBoleto1.Cedente.CNPJCPF := qryContascnpj_agencia_referencia.AsString
 else
   ACBrBoleto1.Cedente.CNPJCPF := qryFiliaiscnpj.AsString;
 ACBrBoleto1.Cedente.Agencia  := qryContasAgencia.AsString;
 ACBrBoleto1.Cedente.Conta    := qryContasConta.AsString;
 ACBrBoleto1.LerRetorno;


  {
  Contrato := '';  Parcela := 0;
  while not Eof(Arquivo) do begin
    with DetalhesBradesco do begin
       BlockRead(Arquivo,DetalhesBradesco,1);
       if D_TipoRegistro = '1' then begin
          Contrato:= Trim(D_ControleDoParticipante);
          delete(contrato, length(contrato)-3, 3);
          Parcela := strtoint(Trim(D_NrDuplicata));

          if (Contrato <> '') and (Parcela <> 0) then
          begin
            if ParSistema.ClienteUsaContrato then
              ContratosParcelas := ContratosParcelas +
              '(p.contrato = ' +QuotedStr(Contrato)+  ' and p.numero = ' +inttostr(Parcela)+ ') or '
            else
              ContratosParcelas := ContratosParcelas +
              '(n.numero = ' +Contrato+  ' and p.numero = ' +inttostr(Parcela)+ ') or ';
          end
       end;
    end;
  end;
  Close(Arquivo);
  if ContratosParcelas = '' then begin
     MensagemAviso(ctNAOFOISELECIONADOPARCELAS);
     Exit;
  end;

  Delete(ContratosParcelas, Length(ContratosParcelas)-3, 4);

  if ContratosParcelas <> ''  then begin
     ContratosParcelas := 'and (' + ContratosParcelas + ')';
     qryParcelas.MacroByName('contratosparcelas').AsString := ContratosParcelas;
  end;

  if qryParcelas.Active then
     qryParcelas.Close;
  qryParcelas.Open;

  if qryParcelas.IsEmpty then begin
     MensagemAviso(ctNAOFOISELECIONADOPARCELAS);
     exit;
  end;

  if Erro then
     Exit
  else
    result := true;

  LerHeaderRetornoBradesco(NomeArquivo);
  LerDetalheRetornoBradesco(NomeArquivo);
  LerTraillerRetornoBradesco(NomeArquivo);


end;
}

function Tdtmlerretornos.AtualizarParcelasBradesco(NomeArquivo: String): boolean;

var DetalhesBradesco: T_DetalheBradesco;
    Contrato: String;
    Parcela: integer;

begin
  result := false;
  Erro := False;

  qryParcelas.Close;
  if not FileExists(NomeArquivo) then
     raise exception.create(ctARQUIVOINEXISTENTE +', deve ter sido renomeado para '+ NomeArquivo + '.OLD : ' + NomeArquivo);

  Try
    AssignFile(Arquivo, NomeArquivo);
    Reset(Arquivo,SizeOf(DetalhesBradesco));
    ContratosParcelas := '';
  except
    Close(Arquivo);
    Erro := True;
    raise exception.create(ctERROABERTURAARQUIVOTEXTO +  NomeArquivo);
  end;

  Contrato := '';  Parcela := 0;
  while not Eof(Arquivo) do begin
    with DetalhesBradesco do begin
       BlockRead(Arquivo,DetalhesBradesco,1);
       if D_TipoRegistro = '1' then begin
          Contrato:= Trim(D_ControleDoParticipante);
          delete(contrato, length(contrato)-3, 3);
          Parcela := strtoint(Trim(D_NrDuplicata));

          if (Contrato <> '') and (Parcela <> 0) then
          begin
            if ParSistema.ClienteUsaContrato then
              ContratosParcelas := ContratosParcelas +
              '(p.contrato = ' +QuotedStr(Contrato)+  ' and p.numero = ' +inttostr(Parcela)+ ') or '
            else
              ContratosParcelas := ContratosParcelas +
              '(n.numero = ' +Contrato+  ' and p.numero = ' +inttostr(Parcela)+ ') or ';
          end
       end;
    end;
  end;
  Close(Arquivo);
  if ContratosParcelas = '' then begin
     MensagemAviso(ctNAOFOISELECIONADOPARCELAS);
     Exit;
  end;

  Delete(ContratosParcelas, Length(ContratosParcelas)-3, 4);

  if ContratosParcelas <> ''  then begin
     ContratosParcelas := 'and (' + ContratosParcelas + ')';
     qryParcelas.MacroByName('contratosparcelas').AsString := ContratosParcelas;
  end;

  if qryParcelas.Active then
     qryParcelas.Close;
  qryParcelas.Open;

  if qryParcelas.IsEmpty then begin
     MensagemAviso(ctNAOFOISELECIONADOPARCELAS);
     exit;
  end;

  if Erro then
     Exit
  else
    result := true;

  LerHeaderRetornoBradesco(NomeArquivo);
  LerDetalheRetornoBradesco(NomeArquivo);
  LerTraillerRetornoBradesco(NomeArquivo);
end;

procedure Tdtmlerretornos.LerHeaderRetornoBradesco(NomeArquivo: String);
var  HeaderBradesco : T_HeaderBradesco;
Begin
   if Erro then
      Exit;

   With HeaderBradesco do Begin
     AssignFile(Arquivo, NomeArquivo);
     Reset(Arquivo,SizeOf(HeaderBradesco));
     BlockRead(Arquivo,HeaderBradesco,1);
     NrLidos:= 1;   NrRegOK:= 0;

     if StrToInt(H_NumeroBradesco) <> qryContasbancoreferencia.AsInteger then begin
        Close(Arquivo);
        Erro := True;
        raise exception.Create(ctHEADERNAOCONFERE + H_NumeroBradesco);
     end;
     if H_TipoRegistro <> '0' then begin
        Close(Arquivo);
        Erro := True;
        raise exception.Create(ctARQNAOTEMHEADER);
     end;
     if (H_IdentArquivo <> '2') or (ANSIUpperCase(H_LiteralRemessa) <> 'RETORNO') then begin
        Erro := True;
        Close(Arquivo);
        raise exception.Create(ctARQNAOERETORNO);
     end;
     if (H_CodigoServico <> '01') or (Trim(ANSIUpperCase(H_LiteralServico)) <> 'COBRANCA') then begin
        Close(arquivo);
        Erro := True;
        raise exception.Create(ctARQNAOEDECOBRANCA);
     end;
     if H_NumeroBradesco <> '237' then begin
        Close(Arquivo);
        Erro := True;
        raise exception.Create(ctBANCODOARQTEXTO + H_NumeroBradesco);
     end;
   End;
End;

procedure Tdtmlerretornos.LerDetalheRetornoBradesco(NomeArquivo: String);

var   DetalhesBradesco: T_DetalheBradesco;
      ControleParticipante, condicao: String;
      NrDuplicata: Integer;
      ValorPago: String[14];    DataOcorr, Obs: String;
Begin
   if Erro then
      Exit;

   while not Eof(Arquivo) do begin
      with DetalhesBradesco do begin
         BlockRead(Arquivo,DetalhesBradesco,1);
         Inc(NrLidos);
         If D_TipoRegistro = '9' then begin   {Leu o trailer}
            Perpetrar([qryParcelas]);
            Exit;
         end;

         Obs := '';
         case StrToInt(D_IdentOcorrencia) of
           02: Obs := 'A ENTRADA FOI CONFIRMADA';
           03: Obs := 'A ENTRADA FOI REJEITADA';
           06: Obs := 'A LIQUIDAÇÃO FOI NORMAL';
           09: Obs := 'BAIXA AUTOMÁTICA';
           10: Obs := 'BAIXA CFE INSTRUÇÕES AGÊNCIA';
           11: Obs := 'TÍTULOS EM SER (Título Pendente)';
           12: Obs := 'O ABATIMENTO FOI CONCEDIDO';
           13: Obs := 'O ABATIMENTO FOI CANCELADO';
           14: Obs := 'A DATA DE VENCTO FOI PRORROGADA';
           15: Obs := 'PAGAMENTO FOI FEITO EM CARTÓRIO (Em Dinheiro';
           17: Obs := 'LIQUIDAÇÃO APÓS BAIXA';
           18: Obs := 'ACERTO DE DEPOSITÁRIA';
           19: Obs := 'CONFIRMAÇÃO RECEB. INST. PROTESTO';
           20: Obs := 'CONFIRMAÇÃO RECEB. INST. SUST.PROTESTO';
           21: Obs := 'ACERTO CONT. PARTICIPANTE';
           23: Obs := 'ENTRADA DE TÍTULO EM CARTÓRIO';
           24: Obs := 'ENTRADA REJEITADA - CEP INVÁLIDO';
           27: Obs := 'BAIXA REJEITADA';
           30: Obs := 'ALTERAÇÃO DE DADOS REJEITADOS';
           32: Obs := 'INSTRUÇÃO REJEITADA';
           33: Obs := 'CONFIRMAÇÃO ALTERAÇÃO DADOS';
           34: Obs := 'RETIRADO CARTÓRIO E PENDENTE';
           35: Obs := 'CANCELAMENTO DE DÉBITO AUTOMÁTICO';
           else
               Obs := 'IDENT. DE OCORRÊNCIA DESCONHECIDA: ' + D_IdentOcorrencia;
         end;

         if D_ValorPago <> '0000000000000' then begin
            ControleParticipante := Trim(D_ControleDoParticipante);
            delete(ControleParticipante, length(ControleParticipante)-3, 3);
            NrDuplicata          := strtoint(Trim(D_NrDuplicata));
            if ParSistema.ClienteUsaContrato then
              condicao := 'contrato;numero'
            else
              condicao := 'nrdocumento;numero';

            if qryParcelas.Locate(condicao, VarArrayOf([ControleParticipante, NrDuplicata]), []) then begin
               if qryParcelasValorPagto.AsCurrency <> 0 then begin
                  qryParcelas.Edit;
                  qryParcelasMOTIVO.AsString := 'Parcela já estava paga, não foi atualizado';
                  qryParcelas.Post;
               end
               else begin

                  ValorPago := D_ValorPago;
                  Insert(',',ValorPago,12);
                  DataOcorr := Copy(D_DataOcorrenciaBradesco,1,2) + '/' + Copy(D_DataOcorrenciaBradesco,3,2) + '/' + Copy(D_DataOcorrenciaBradesco,5,2);

                  QuitarParcelas(StrToFloat(ValorPago),StrToDate(DataOcorr),obs);
               end
            end else
               MensagemAviso('Documento/Parcela não cadastrada ou já quitada: Documento: ' + ControleParticipante + ' Parcela: ' + inttostr(NrDuplicata))
         end else begin
            qryParcelas.Edit;
            qryParcelasMOTIVO.AsString := Obs;
            qryParcelas.Post;
         end;
      end;
   end;
End;


procedure Tdtmlerretornos.LerTraillerRetornoBradesco(NomeArquivo: String);
Var Posicao: LongInt;
    TraillerBradesco: T_TraillerBradesco;
Begin
   if Erro then
      Exit;

   Posicao:= FilePos(Arquivo) - 1;
   Seek(Arquivo,Posicao);
   BlockRead(Arquivo,TraillerBradesco,1);

   If TraillerBradesco.T_TipoRegistro <> '9' then begin
      Close(Arquivo);
      raise exception.create(ctFALTOUTRAILLER);
   end;

   Close(Arquivo);
end; {LerTrailerRetornoBradesco}


//========================= LER RETORNO BANCO DO BRASIL =========================================

function Tdtmlerretornos.AtualizarParcelasBBrasil(NomeArquivo: String): boolean;
var Contrato, v: String;
    Parcela: integer;
    I: integer;

begin
  result := false;
  Erro := False;

  qryParcelas.Close;
  if not FileExists(NomeArquivo) then
     raise exception.create(ctARQUIVOINEXISTENTE +', deve ter sido renomeado para '+ NomeArquivo + '.OLD : ' + NomeArquivo);


  Try


    AssignFile(Arquivo, NomeArquivo);
    Reset(Arquivo,SizeOf(DetalheSegmento_T_BBrasil));
    ContratosParcelas := '';
  except
    Close(Arquivo);
    Erro := True;
    raise exception.create(ctERROABERTURAARQUIVOTEXTO +': ' +  NomeArquivo);
  end;

  I:= 1;
  Contrato := '';  Parcela := 0;

  while not Eof(Arquivo) do
  begin
    with DetalheSegmento_T_BBrasil do
    begin
      BlockRead(Arquivo,DetalheSegmento_T_BBrasil,I);
      if DT_Cod_Segmento = 'T' then
      begin
        {  Visto que foi definido uma estrutura para o DT_IDENT_TIT_NO_BANCO basta fazer a referencia abaixo

           Parcela :=  strtoint(copy(contrato, length(qryContasconvenio.asstring)+8+1, 2));
           Contrato := RetiraZeroaEsquerda(copy(contrato, length(qryContasconvenio.asstring)+1, 8));}

          Contrato := RetiraZeroaEsquerda(Trim(DT_IDENT_TIT_NO_BANCO.Contrato));
          Parcela  := strtoint(DT_IDENT_TIT_NO_BANCO.parcela);


          if (Contrato <> '') and (Parcela <> 0) then
          begin
            if ParSistema.ClienteUsaContrato then
              ContratosParcelas := ContratosParcelas +
              '(p.contrato = ' +QuotedStr(Contrato)+  ' and p.numero = ' +inttostr(Parcela)+ ') or '
            else
              ContratosParcelas := ContratosParcelas +
              '(n.numero = ' +Contrato+  ' and p.numero = ' +inttostr(Parcela)+ ') or ';
          end;
       end;
    end;
  end;
  Close(Arquivo);

  if ContratosParcelas = '' then begin
     MensagemAviso(ctNAOFOISELECIONADOPARCELAS);
     Exit;
  end;

  Delete(ContratosParcelas, Length(ContratosParcelas)-3, 4);

  if ContratosParcelas <> ''  then begin
     ContratosParcelas := 'and (' + ContratosParcelas + ')';
     qryParcelas.MacroByName('contratosparcelas').asstring  := ContratosParcelas;
  end;

  if qryParcelas.Active then
     qryParcelas.Close;
  qryParcelas.Open;

  if qryParcelas.IsEmpty then
  begin
     MensagemAviso(ctNAOFOISELECIONADOPARCELAS);
     result := false;
     exit;
  end;

  if Erro then
     Exit
  else
    result:= true;

  LerHeaderBBrasil(NomeArquivo);
  if LerHeaderLoteBBrasil(NomeArquivo) then
    if LerDetalheSegmento_TU_BBrasil(NomeArquivo) then
      if LerTraillerLoteBBrasil(NomeArquivo) then
         LerTraillerBBrasil(NomeArquivo) 
end;

procedure Tdtmlerretornos.LerHeaderBBrasil(NomeArquivo: String);
Begin
   if Erro then
      Exit;

   With HeaderBBrasil do Begin
     AssignFile(Arquivo, NomeArquivo);
     Reset(Arquivo,SizeOf(HeaderBBrasil));
     BlockRead(Arquivo,HeaderBBrasil,1);
     NrLidos:= 1;   NrRegOK:= 0;

     if StrToInt(H_CODIGO_BANCO_COMPENSACAO) <> qryContasBancoreferencia.AsInteger then begin
        Close(Arquivo);
        Erro := True;
        raise exception.Create(ctHEADERNAOCONFERE + H_CODIGO_BANCO_COMPENSACAO);
     end;
     if H_LOTE_DE_SERVICO <> '0000' then begin
        Close(Arquivo);
        Erro := True;
        raise exception.Create(ctARQNAOTEMHEADER);
     end;
     if (H_REGISTRO_HEADER_ARQUIVO <> '0') or (H_CODIGO_REMESSA_RETORNO <> '2') then begin
        Erro := True;
        Close(Arquivo);
        raise exception.Create(ctARQNAOERETORNO);
     end;
     if (H_NR_VERSAO_LAYOUT_ARQUIVO <> '030') then begin
        Close(arquivo);
        Erro := True;
        raise exception.Create(ctVERSAONAOE030);
     end;
     if H_CODIGO_BANCO_COMPENSACAO <> '001' then begin
        Close(Arquivo);
        Erro := True;
        raise exception.Create(ctBANCODOARQTEXTO + H_CODIGO_BANCO_COMPENSACAO);
     end;
   End;
End;

function Tdtmlerretornos.LerHeaderLoteBBrasil(NomeArquivo: String): boolean;
Begin
   result := false;
   if Erro then
      Exit;

   With HeaderLoteBBrasil do Begin
     BlockRead(Arquivo,HeaderLoteBBrasil,1);
     NrLidos:= 1;   NrRegOK:= 0;

     if StrToInt(HL_CODIGO_BANCO_COMPENSACAO) <> qryContasbancoreferencia.AsInteger then begin
        Close(Arquivo);
        Erro := True;
        raise exception.Create(ctHEADERNAOCONFERE + HL_CODIGO_BANCO_COMPENSACAO);
     end;
     if HL_LOTE_DE_SERVICO <> '0001' then begin
        Close(Arquivo);
        Erro := True;
        raise exception.Create(ctARQNAOTEMHEADERLOTE);
     end;
     if (HL_REGISTRO_HEADERDE_LOTE <> '1') then begin
        Erro := True;
        Close(Arquivo);
        raise exception.Create(ctARQNAOERETORNO);
     end;
     if HL_NR_VERSAO_LAYOUT_LOTE <> '020' then begin
        Close(arquivo);
        Erro := True;
        raise exception.Create(ctVERSAONAOE020);
     end;
     if HL_CODIGO_BANCO_COMPENSACAO <> '001' then begin
        Close(Arquivo);
        Erro := True;
        raise exception.Create(ctBANCODOARQTEXTO + HL_CODIGO_BANCO_COMPENSACAO);
     end;
   End;
   result := not erro;

End;

function Tdtmlerretornos.LerDetalheSegmento_TU_BBrasil(NomeArquivo: String): boolean;
Const SQL = 'and (%s) ';
var   Contrato, condicao: String;
      NrDuplicata: integer;
      ValorPago: String[16]; DataOcorr: String;
      Obs: String;
      vtstContrato : tstContrato;

Begin
   result := true;

   if Erro then
      Exit;

   for vtstContrato := OUTROS to ORCADO do
   begin
     while not Eof(Arquivo) do
     begin
        with DetalheSegmento_T_BBrasil, DetalheSegmento_U_BBrasil do begin
           BlockRead(Arquivo,DetalheSegmento_T_BBrasil,1);
           Inc(NrLidos);

           If (DT_REGISTRO_DETALHE = '5') or (DT_REGISTRO_DETALHE = '9') then   {Leu o trailer Lote ou trailler header}
             break;

           Obs:= '';
           case StrToInt(DT_CODIGO_MOVIMENTO) of
             02: Obs := 'A ENTRADA FOI CONFIRMADA';
             03: Obs := 'A ENTRADA FOI REJEITADA';
             04: Obs := 'TRANFERÊNCIA DE CARTEIRA/ENTRADA';
             05: Obs := 'TRANFERÊNCIA DE CARTEIRA/BAIXA';
             06: Obs := 'LIQUIDAÇÃO';
             07: Obs := 'CONFIRMAÇÃO DO RECEB. DA INSTRUÇÃO DE DESCONTO';
             09: Obs := 'BAIXA';
             11: Obs := 'TITULOS EM CARTEIRA / EM SER';
             12: Obs := 'CONFIRMAÇÃO RECEB. INSTRUÇÃO DE ABATIMENTO';
             13: Obs := 'O ABATIMENTO FOI CANCELADO';
             14: Obs := 'A DATA DE VENCTO FOI PRORROGADA';
             15: Obs := 'FRANCO DE PAGAMENTO';
             17: Obs := 'LIQUIDAÇÃO APÓS BAIXA OU TITULO NÃO REGISTRADO';
             19: Obs := 'CONFIRMAÇÃO RECEB. INST. PROTESTO';
             20: Obs := 'CONFIRMAÇÃO RECEB. INST. SUST. PROTESTO';
             23: Obs := 'ENTRADA DE TÍTULO EM CARTÓRIO';
             24: Obs := 'RETIRADA DE CARTÓRIO E MANUTENÇÃO EM CARTEIRA';
             25: Obs := 'PROTESTADO E BAIXADO/BAIXA P/ TER SIDO PROTESTADO';
             26: Obs := 'INSTRUÇÃO REJEITADA';
             27: Obs := 'CONFIRMAÇÃO DO PEDIDO DE ALTERAÇÃO DE OUTROS DADOS';
             28: Obs := 'DÉBITO DE TARIFAS/CUSTAS';
             29: Obs := 'OCORRENCIAS DO SACADO';
             30: Obs := 'ALTERAÇÃO DE DADOS REJEITADOS';
             else
                 Obs := 'IDENT. DE OCORRÊNCIA DESCONHECIDA: ' + DT_CODIGO_MOVIMENTO;
           end;

           BlockRead(Arquivo,DetalheSegmento_U_BBrasil,1);
           Inc(NrLidos);


           if DU_VALOR_PAGO_PELO_SACADO <> '000000000000000' then
           begin

              Contrato := RetiraZeroaEsquerda(Trim(DT_IDENT_TIT_NO_BANCO.Contrato));
              NrDuplicata  := strtoint(DT_IDENT_TIT_NO_BANCO.parcela);

              {
              Contrato    := Trim(DT_Nr_Contrato);
              delete(contrato, length(contrato)-3,3);
              NrDuplicata := strtoint(Trim(DT_Nr_Duplicata));
              }

              if ParSistema.ClienteUsaContrato then
                condicao := 'contrato;numero'
              else
                condicao := 'nrdocumento;numero';

              if qryParcelas.Locate(condicao, VarArrayOf([Contrato, NrDuplicata]), []) then
              begin
                if (qryParcelasValorPagto.AsCurrency <> 0) and not qryParcelasjaverificada.AsBoolean then
                begin
                  qryParcelas.Edit;
                  qryParcelasMOTIVO.AsString := 'Parcela já estava paga, não foi atualizado';
                  qryParcelas.Post;
                end
                else
                begin
                  ValorPago := DU_VALOR_PAGO_PELO_SACADO;
                  Insert(',',ValorPago,14);
                  DataOcorr := Copy(DU_DATA_OCORRENCIA,1,2) + '/' + Copy(DU_DATA_OCORRENCIA,3,2) + '/' +
                               Copy(DU_DATA_OCORRENCIA,5,4);
                  if (qryParcelassituacaocontrato.AsString <> 'O') and (vtstContrato = OUTROS) then
                    QuitarParcelas(StrToFloat(ValorPago), StrToDate(DataOcorr), Obs);

                  if (qryParcelassituacaocontrato.AsString = 'O') and (vtstContrato = ORCADO) then
                    if GravarContratoViaSite(DtmCadCtr, qryParcelascontrato.asstring, tOGCVendasViaSite, StrToDate(DataOcorr), StrToFloat(ValorPago), Contrato, NrDuplicata, qryContastiporecebimento.asinteger, strtoint(Filiais), qrycontasconta.asinteger) then
                      QuitarParcelas(StrToFloat(ValorPago), StrToDate(DataOcorr), Obs, true);
                end
              end
              else
                MensagemAviso('Documento/Parcela não cadastrada ou já quitada: Documento: ' + Contrato +' Parcela: ' + inttostr(NrDuplicata));
           end
           else
           begin
                 qryParcelas.Edit;
                 qryParcelasMOTIVO.AsString := Obs;
                 qryParcelas.Post;
           end;
        end;
     end;

     if vtstContrato = ORCADO then
       EnviarEmailQuitacaoViaSite;
   end;
End;

function Tdtmlerretornos.LerTraillerLoteBBrasil(NomeArquivo: String): boolean;
Var Posicao: LongInt;
Begin
   if Erro then
      Exit;

   Posicao:= FilePos(Arquivo) - 1;
   Seek(Arquivo,Posicao);
   BlockRead(Arquivo,TraillerLoteBBrasil,1);

   with TraillerLoteBBrasil do begin
     If (TL_REGISTRO_TRAILLER_LOTE <> '5') then begin
        Close(Arquivo);
        Erro := True;
        raise exception.create(ctFALTOUTRAILLERLOTE);
     end;
   end;

   result := not erro;   
end;

procedure Tdtmlerretornos.LerTraillerBBrasil(NomeArquivo: String);
Begin
   if Erro then
      Exit;

   BlockRead(Arquivo,TraillerBBrasil,1);

    with TraillerBBrasil do begin
      If (T_REGISTRO_TRAILLER_LOTE <> '9') or (T_LOTE_DE_SERVICO <> '9999')  then begin
         Close(Arquivo);
         raise exception.create(ctFALTOUTRAILLER);
      end;
    end;
   Close(Arquivo);
   MensagemAviso(ctFIMDEATUALIZACAO);
end;
//================================== END B. BRASIL  ===============================================

//================================= LER RETORNO ITAU =========================================

function TdtmLerRetornos.AtualizarParcelasItau(NomeArquivo: String): boolean;
var Contrato: String;
    Parcela: integer;
begin
  result := False;
  Erro := False;

  qryParcelas.Close;
  if not FileExists(NomeArquivo) then
     raise exception.create(ctARQUIVOINEXISTENTE +', deve ter sido renomeado para '+ NomeArquivo + '.OLD : ' + NomeArquivo);


  Try

    AssignFile(Arquivo, NomeArquivo);
    Reset(Arquivo,SizeOf(Detalhes_T_Itau));
    ContratosParcelas := '';
  except
    Close(Arquivo);
    Erro := True;
    raise exception.create(ctERROABERTURAARQUIVOTEXTO +': ' +  NomeArquivo);
  end;

  Contrato := '';  Parcela := 0;
  while not Eof(Arquivo) do begin
    with Detalhes_T_Itau do begin
       BlockRead(Arquivo,Detalhes_T_Itau,1);
       if DT_COD_SEGMENTO = 'T' then begin
          Contrato:= Trim(DT_IDENT_TIT_NA_EMPRESA);
          Contrato := somentenumero(Contrato);
          Parcela := strtoint(Trim(copy(DT_IDENT_TIT_NO_BANCO,7,2)));


          if (Contrato <> '') and (Parcela <> 0) then
          begin
            if ParSistema.ClienteUsaContrato then
              ContratosParcelas := ContratosParcelas +
              '(p.contrato = ' +QuotedStr(Contrato)+  ' and p.numero = ' +inttostr(Parcela)+ ') or '
            else
              ContratosParcelas := ContratosParcelas +
              '(n.numero = ' +Contrato+  ' and p.numero = ' +inttostr(Parcela)+ ') or ';
          end;
       end;
    end;
  end;
  Close(Arquivo);

  if ContratosParcelas = '' then begin
     MensagemAviso(ctNAOFOISELECIONADOPARCELAS);
     Exit;
  end;

  Delete(ContratosParcelas, Length(ContratosParcelas)-3, 4);

  if ContratosParcelas <> ''  then begin
     ContratosParcelas := 'and (' + ContratosParcelas + ')';
     qryParcelas.MacroByName('contratosparcelas').asstring  := ContratosParcelas;
  end;

  if qryParcelas.Active then
     qryParcelas.Close;
  qryParcelas.Open;

  if qryParcelas.IsEmpty then begin
     MensagemAviso(ctNAOFOISELECIONADOPARCELAS);
     exit;
  end;

  if Erro then
     Exit
  else
    result := true;

  LerHeaderItau(NomeArquivo);
  LerHeaderLoteItau(NomeArquivo);
  LerDetalheSegmento_TU_Itau(NomeArquivo);
  LerTraillerLoteItau(NomeArquivo);
  LerTraillerItau(NomeArquivo);

  if not erro then
    erro := Perpetrar([qryparcelas]);

end;

procedure TdtmLerRetornos.LerDetalheSegmento_TU_Itau(NomeArquivo: String);
Const SQL = 'and (%s) ';
var   Contrato, condicao: String;
      NrDuplicata: integer;
      ValorPago, ValorDespesas: String[16]; DataOcorr: String;
      Obs: String;
begin
   if Erro then
      Exit;

   while not Eof(Arquivo) do begin
      with Detalhes_T_Itau, Detalhes_U_Itau do begin
         BlockRead(Arquivo,Detalhes_T_Itau,1);
         Inc(NrLidos);

         If (DT_REGISTRO_DETALHE <> '3') then
            Exit;

         Obs:= '';
         if DT_VALOR_DESPESAS <> '000000000000000' then
         begin
           ValorDespesas := DT_VALOR_DESPESAS;
           Insert(',',ValorDespesas,14);
           while ValorDespesas[0] = '0' do
             Delete(ValorDespesas,0,1);
         end;
         case StrToInt(DT_CODIGO_OCORRENCIA) of
           02 : Obs := 'ENTRADA CONFIRMADA';
           03 : Obs := 'ENTRADA REJEITADA';
           04 : Obs := 'ALTERAÇÃO DE DADOS – NOVA ENTRADA';
           05 : Obs := 'ALTERAÇÃO DE DADOS – BAIXA';
           06 : Obs := 'LIQUIDAÇÃO NORMAL';
           08 : Obs := 'LIQUIDAÇÃO EM CARTÓRIO';
           09 : Obs := 'BAIXA SIMPLES';
           10 : Obs := 'BAIXA POR TER SIDO LIQUIDADO';
           11 : Obs := 'EM SER (SÓ NO RETORNO MENSAL)';
           12 : Obs := 'ABATIMENTO CONCEDIDO';
           13 : Obs := 'ABATIMENTO CANCELADO';
           14 : Obs := 'VENCIMENTO ALTERADO';
           15 : Obs := 'BAIXAS REJEITADAS';
           16 : Obs := 'INSTRUÇÕES REJEITADAS';
           17 : Obs := 'ALTERAÇÃO DE DADOS REJEITADA';
           18 : Obs := 'COBRANÇA CONTRATUAL – INSTRUÇÕES/ALTERAÇÕES REJEITADAS/PENDENTES';
           19 : Obs := 'CONFIRMAÇÃO RECEBIMENTO DE INSTRUÇÃO DE PROTESTO';
           20 : Obs := 'CONFIRMAÇÃO RECEBIMENTO DE INSTRUÇÃO DE SUSTAÇÃO DE PROTESTO /TARIFA';
           21 : Obs := 'CONFIRMAÇÃO RECEBIMENTO DE INSTRUÇÃO DE NÃO PROTESTAR';
           23 : Obs := 'PROTESTO ENVIADO A CARTÓRIO/TARIFA';
           24 : Obs := 'INSTRUÇÃO DE PROTESTO SUSTADA';
           25 : Obs := 'ALEGAÇÕES DO SACADO';
           26 : Obs := 'TARIFA DE AVISO DE COBRANÇA - R$ ' + ValorDespesas;
           27 : Obs := 'TARIFA DE EXTRATO POSIÇÃO (B40X) - R$ ' + ValorDespesas;
           28 : Obs := 'TARIFA DE RELAÇÃO DAS LIQUIDAÇÕES - R$ ' + ValorDespesas;
           29 : Obs := 'TARIFA DE MANUTENÇÃO DE TÍTULOS VENCIDOS - R$ ' + ValorDespesas;
           30 : Obs := 'DÉBITO MENSAL DE TARIFAS (PARA ENTRADAS E BAIXAS) - R$ ' + ValorDespesas;
           32 : Obs := 'BAIXA POR TER SIDO PROTESTADO';
           33 : Obs := 'CUSTAS DE PROTESTO - R$ ' + ValorDespesas;
           34 : Obs := 'CUSTAS DE SUSTAÇÃO - R$ ' + ValorDespesas;
           35 : Obs := 'CUSTAS DE CARTÓRIO DISTRIBUIDOR - R$ ' + ValorDespesas;
           36 : Obs := 'CUSTAS DE EDITAL - R$ ' + ValorDespesas;
           37 : Obs := 'TARIFA DE EMISSÃO DE BOLETO/TARIFA DE ENVIO DE DUPLICATA - R$ ' + ValorDespesas;
           38 : Obs := 'TARIFA DE INSTRUÇÃO - R$ ' + ValorDespesas;
           39 : Obs := 'TARIFA DE OCORRÊNCIAS - R$ ' + ValorDespesas;
           40 : Obs := 'TARIFA MENSAL DE EMISSÃO DE BOLETO/TARIFA MENSAL DE ENVIO DE DUPLICATA - R$ ' + ValorDespesas;
           41 : Obs := 'DÉBITO MENSAL DE TARIFAS – EXTRATO DE POSIÇÃO (B4EP/B4OX) - R$ ' + ValorDespesas;
           42 : Obs := 'DÉBITO MENSAL DE TARIFAS – OUTRAS INSTRUÇÕES - R$ ' + ValorDespesas;
           43 : Obs := 'DÉBITO MENSAL DE TARIFAS – MANUTENÇÃO DE TÍTULOS VENCIDOS - R$ ' + ValorDespesas;
           44 : Obs := 'DÉBITO MENSAL DE TARIFAS – OUTRAS OCORRÊNCIAS - R$ ' + ValorDespesas;
           45 : Obs := 'DÉBITO MENSAL DE TARIFAS – PROTESTO - R$ ' + ValorDespesas;
           46 : Obs := 'DÉBITO MENSAL DE TARIFAS – SUSTAÇÃO DE PROTESTO - R$ ' + ValorDespesas;
           47 : Obs := 'BAIXA COM TRANSFERÊNCIA PARA DESCONTO - R$ ' + ValorDespesas;
           48 : Obs := 'CUSTAS DE SUSTAÇÃO JUDICIAL - R$ ' + ValorDespesas;
           51 : Obs := 'TARIFA MENSAL REFERENTE A ENTRADAS BANCOS CORRESPONDENTES NA CARTEIRA - R$ ' + ValorDespesas;
           52 : Obs := 'TARIFA MENSAL BAIXAS NA CARTEIRA - R$ ' + ValorDespesas;
           53 : Obs := 'TARIFA MENSAL BAIXAS EM BANCOS CORRESPONDENTES NA CARTEIRA - R$ ' + ValorDespesas;
           54 : Obs := 'TARIFA MENSAL  DE LIQUIDAÇÕES NA CARTEIRA - R$ ' + ValorDespesas;
           55 : Obs := 'TARIFA MENSAL DE LIQUIDAÇÕES EM BANCOS CORRESPONDENTES NA CARTEIRA - R$ ' + ValorDespesas;
           56 : Obs := 'CUSTAS DE IRREGULARIDADE - R$ ' + ValorDespesas;
           else
               Obs := 'IDENT. DE OCORRÊNCIA DESCONHECIDA: ' + DT_CODIGO_OCORRENCIA;
         end;

         BlockRead(Arquivo,Detalhes_U_Itau,1);
         Inc(NrLidos);

         {
         if (DU_REGISTRO_DETALHE = '3') then
         begin
            Perpetrar([qryParcelas]);
            Exit;
         end;
         }


         Contrato    := somentenumero(Trim(DT_IDENT_TIT_NA_EMPRESA));
         NrDuplicata := strtoint(Trim(copy(DT_IDENT_TIT_NO_BANCO,7,2)));

         if ParSistema.ClienteUsaContrato then
           condicao := 'contrato;numero'
         else
           condicao := 'nrdocumento;numero';

         if qryParcelas.Locate(condicao, VarArrayOf([Contrato, NrDuplicata]), []) then begin

           if DU_VALOR_LANCADO_CONTA <> '000000000000000' then begin

              if qryParcelasValorPagto.AsCurrency <> 0 then begin
                 qryParcelas.Edit;
                 qryParcelasMOTIVO.AsString := 'Parcela já estava paga, não foi atualizado';
                 qryParcelas.Post;
              end
              else begin
                 ValorPago := DU_VALOR_LANCADO_CONTA;
                 Insert(',',ValorPago,14);
                 DataOcorr := Copy(DU_DATA_OCORRENCIA,1,2) + '/' + Copy(DU_DATA_OCORRENCIA,3,2) + '/' + Copy(DU_DATA_OCORRENCIA,5,4);

                 QuitarParcelas(StrToFloat(ValorPago),StrToDate(DataOcorr),obs);
              end;
           end
           else begin
                 qryParcelas.Edit;
                 qryParcelasMOTIVO.AsString := Obs;
                 qryParcelas.Post;
           end;

         end else
            MensagemAviso('Documento/Parcela não cadastrada ou já quitada: Documento: ' + Contrato +' Parcela: ' + inttostr(NrDuplicata));
      end;
   end;
end;

procedure TdtmLerRetornos.LerHeaderItau(NomeArquivo: String);
begin
   if Erro then
      Exit;

   With HeaderItau do Begin
     AssignFile(Arquivo, NomeArquivo);
     Reset(Arquivo,SizeOf(HeaderItau));
     BlockRead(Arquivo,HeaderItau,1);
     NrLidos:= 1;   NrRegOK:= 0;

     if StrToInt(H_CODIGO_BANCO_COMPENSACAO) <> qryContasbancoreferencia.AsInteger then begin
        Close(Arquivo);
        Erro := True;
        raise exception.Create(ctHEADERNAOCONFERE + H_CODIGO_BANCO_COMPENSACAO);
     end;
     if H_LOTE_DE_SERVICO <> '0000' then begin
        Close(Arquivo);
        Erro := True;
        raise exception.Create(ctARQNAOTEMHEADER);
     end;
     if (H_REGISTRO_HEADER_ARQUIVO <> '0') or (H_CODIGO_REMESSA_RETORNO <> '2') then begin
        Erro := True;
        Close(Arquivo);
        raise exception.Create(ctARQNAOERETORNO);
     end;
     if (H_NR_VERSAO_LAYOUT_ARQUIVO <> '040') then begin
        Close(arquivo);
        Erro := True;
        raise exception.Create(ctVERSAONAOE040);
     end;
     if H_CODIGO_BANCO_COMPENSACAO <> '341' then begin
        Close(Arquivo);
        Erro := True;
        raise exception.Create(ctBANCODOARQTEXTO + H_CODIGO_BANCO_COMPENSACAO);
     end;
   end;
end;

procedure TdtmLerRetornos.LerHeaderLoteItau(NomeArquivo: String);
begin
   if Erro then
      Exit;

   With HeaderLoteItau do Begin
     BlockRead(Arquivo,HeaderLoteItau,1);
     NrLidos:= 1;   NrRegOK:= 0;

     if StrToInt(HL_CODIGO_BANCO_COMPENSACAO) <> qryContasbancoreferencia.AsInteger then begin
        Close(Arquivo);
        Erro := True;
        raise exception.Create(ctHEADERNAOCONFERE + HL_CODIGO_BANCO_COMPENSACAO);
     end;
     if HL_LOTE_DE_SERVICO <> '0001' then begin
        Close(Arquivo);
        Erro := True;
        raise exception.Create(ctARQNAOTEMHEADERLOTE);
     end;
     if (HL_REGISTRO_HEADERDE_LOTE <> '1') then begin
        Erro := True;
        Close(Arquivo);
        raise exception.Create(ctARQNAOERETORNO);
     end;
     if HL_NR_VERSAO_LAYOUT_LOTE <> '030' then begin
        Close(arquivo);
        Erro := True;
        raise exception.Create(ctVERSAONAOE030);
     end;
     if HL_CODIGO_BANCO_COMPENSACAO <> '341' then begin
        Close(Arquivo);
        Erro := True;
        raise exception.Create(ctBANCODOARQTEXTO + HL_CODIGO_BANCO_COMPENSACAO);
     end;
   End;
end;

procedure TdtmLerRetornos.LerTraillerItau(NomeArquivo: String);
begin
   if Erro then
      Exit;

   BlockRead(Arquivo,TraillerItau,1);

    with TraillerItau do begin
      If (T_REGISTRO_TRAILLER <> '9') or (T_LOTE_DE_SERVICO <> '9999')  then begin
         Close(Arquivo);
         raise exception.create(ctFALTOUTRAILLER);
      end;
    end;
   Close(Arquivo);
   MensagemAviso(ctFIMDEATUALIZACAO);
end;

procedure TdtmLerRetornos.LerTraillerLoteItau(NomeArquivo: String);
var Posicao: LongInt;
begin
   if Erro then
      Exit;

   Posicao:= FilePos(Arquivo) - 1;
   Seek(Arquivo,Posicao);
   BlockRead(Arquivo,TraillerLoteItau,1);

   with TraillerLoteItau do begin
     if (TL_REGISTRO_TRAILLER_LOTE <> '5') then
     begin
       Close(Arquivo);
       Erro := True;
       raise exception.create(ctFALTOUTRAILLERLOTE);
     end;
   end;
end;

//================================== END ITAU  ===============================================

function TdtmLerRetornos.AtualizarParcelasBradescoACBR(
  NomeArquivo: String): boolean;
var
  vDir: String;
  i: integer;
  vNossoNumero: String;
  vtstContrato : tstContrato;


begin
  result := false;
  Erro := False;

  with ACBrBoleto1 do
  begin
    NomeArqRetorno := ExtractFileName(NomeArquivo);
    vdir := ExtractFilePath(NomeArquivo);
    delete(vdir,length(vdir),1);
    DirArqRetorno := vdir;
    with Banco do
    begin
      case qryContasBanco.AsInteger of
        001 : TipoCobranca := cobBancoDoBrasil;     {001}
        021 : TipoCobranca := cobBanestes;          {021}
        033,353,088 : TipoCobranca := cobSantander; {033,353,008}
        041 : TipoCobranca := cobBanrisul;          {041}
        104 : TipoCobranca := cobCaixaEconomica;    {104}
//              104 : TipoCobranca := cobCaixaSicob ;       {104}
        237 : TipoCobranca := cobBradesco;          {237}
        341 : TipoCobranca := cobItau;              {341}
        389 : TipoCobranca := cobBancoMercantil;    {389}
        748 : TipoCobranca := cobSicred;            {748}
        756 : TipoCobranca := cobBancoob;           {756}
        399 : TipoCobranca := cobHSBC;              {399}
      end;
    end;

    with Cedente do
    begin

    {
      Nome              :=
      CodigoCedente     :=
      CodigoTransmissao :=
      }
      Agencia           := qryContasAgencia.AsString;

//      AgenciaDigito     := qryContasAgencia.AsString;
      Conta             := qryContasConta.AsString;
      ContaDigito       := qryContasDigito.AsString;
      {
      Modalidade        :=
      Convenio          :=
      ResponEmissao     :=
      CaracTitulo       :=
    }
      CNPJCPF           := somentenumero(qryContascnpj_agencia_referencia.asstring);
    {
      TipoInscricao     :=
      Logradouro        :=
      NumeroRes         :=
      Complemento       :=
      Bairro            :=
      Cidade            :=
      UF                :=
      CEP               :=
    }
    end;
    LerRetorno;

    ContratosParcelas := '';

    for i:=0 to ListadeBoletos.Count-1 do
    begin
      case qryContasBanco.AsInteger of
      353 :  vNossoNumero := copy(ListadeBoletos.Objects[i].NossoNumero, length(ListadeBoletos.Objects[i].NossoNumero)-6,6)
      else
        vNossoNumero := copy(ListadeBoletos.Objects[i].NossoNumero, length(ListadeBoletos.Objects[i].NossoNumero)-5,6);
      end;

      if (vNossoNumero <> '') then
        ContratosParcelas := ContratosParcelas + '(p.nossonumero = ' + RetiraZeroaEsquerda(vNossoNumero) + ') or ';
    end;
  end;

  if ContratosParcelas = '' then
  begin
   MensagemAviso(ctNAOFOISELECIONADOPARCELAS);
   Exit;
  end;

  Delete(ContratosParcelas, Length(ContratosParcelas)-3, 4);

  if ContratosParcelas <> ''  then begin
     ContratosParcelas := 'and (' + ContratosParcelas + ')';
     qryParcelas.MacroByName('contratosparcelas').asstring  := ContratosParcelas;
  end;

  if qryParcelas.Active then
     qryParcelas.Close;
  qryParcelas.Open;


  if qryParcelas.IsEmpty then
  begin
    //MensagemAviso(ctNAOFOISELECIONADOPARCELAS);
    //exit;
    Erro := true;
    result := false;
  end;

  vTotalRegistroViaSite := 0;
  vTotalValorRecebidoViaSite := 0;


 //comentario jr 20/05 - estava passando 2x pelo arquivo e deixando as parcelas todas como ja quitadas, nao entendi o pq deste for.

 //Necessário devido ao fato de que a quitação qdo via site se dá pelo contrato, executando o perpetrar lá mesmo, inclusive qdo o pagamento for parcial,
 //neste caso poderia perpetrar duas vezes incluindo duas parcelas, por isso a quitação é feita em duas partes.

  for vtstContrato := OUTROS TO ORCADO  do
  begin
    for i:=0 to  ACBrBoleto1.ListadeBoletos.Count-1 do
    begin
      case qryContasBanco.AsInteger of
      353 :  vNossoNumero := copy(acbrboleto1.ListadeBoletos.Objects[i].NossoNumero, length(acbrboleto1.ListadeBoletos.Objects[i].NossoNumero)-6,6)
      else
        vNossoNumero := copy(acbrboleto1.ListadeBoletos.Objects[i].NossoNumero, length(acbrboleto1.ListadeBoletos.Objects[i].NossoNumero)-5,6);
      end;

      if not qryparcelas.Locate('nossonumero',strtoint(vNossoNumero),[]) then
      begin
        if MensagemConfirmacao(format('O registro com o campo ''NOSSO NÚMERO:'' %s não foi encontrado',[vNossoNumero])) <> smbOk then
        begin
          Erro := true;
          result := false;
          break;
        end;
      end
      else
      begin
        if (qryParcelasValorPagto.AsCurrency <> 0) and not qryParcelasjaverificada.AsBoolean then
        begin
          qryParcelas.Edit;
          qryParcelasMOTIVO.AsString := 'Parcela já estava paga, não foi atualizado';
          qryParcelas.Post;
        end
        else
        begin
          if (qryParcelassituacaocontrato.AsString <> 'O') and (vtstContrato = OUTROS) then
          begin
            if ACBrBoleto1.ListadeBoletos.Objects[i].DescricaoMotivoRejeicaoComando.Count > 0 then
              QuitarParcelas(acbrboleto1.ListadeBoletos.Objects[i].ValorRecebido,
                             acbrboleto1.ListadeBoletos.Objects[i].DataOcorrencia,
                             ACBrBoleto1.ListadeBoletos.Objects[i].DescricaoMotivoRejeicaoComando[0])
            else
              QuitarParcelas(acbrboleto1.ListadeBoletos.Objects[i].ValorRecebido,
                             acbrboleto1.ListadeBoletos.Objects[i].DataOcorrencia,
                             '');


          end
          else
          if (qryParcelassituacaocontrato.AsString = 'O') and (vtstContrato = ORCADO) then
          begin
            if GravarContratoViaSite(DtmCadCtr, qryParcelascontrato.asstring, tOGCVendasViaSite,
                                     acbrboleto1.ListadeBoletos.Objects[i].DataOcorrencia, acbrboleto1.ListadeBoletos.Objects[i].ValorRecebido, qryParcelascontrato.asstring, qryParcelasnumero.asinteger, qryContastiporecebimento.asinteger, strtoint(Filiais), qryContasConta.AsInteger) then
            begin
              if ACBrBoleto1.ListadeBoletos.Objects[i].DescricaoMotivoRejeicaoComando.count > 0 then
                QuitarParcelas(acbrboleto1.ListadeBoletos.Objects[i].ValorRecebido,
                               acbrboleto1.ListadeBoletos.Objects[i].DataOcorrencia,
                               ACBrBoleto1.ListadeBoletos.Objects[i].DescricaoMotivoRejeicaoComando[0], True)
              else
                QuitarParcelas(acbrboleto1.ListadeBoletos.Objects[i].ValorRecebido,
                               acbrboleto1.ListadeBoletos.Objects[i].DataOcorrencia,
                               '', True);
            end
          end;
        end;
      end;
    end;
  end;

  if Erro then
     Exit
  else
  begin
    EnviarEmailQuitacaoViaSite;

    if Assigned(dtmCadCtr) then
      dtmCadCtr.free;

    result:= true;
  end;

end;

function TdtmLerRetornos.proximoNumeroParcela(contrato: string): integer;
begin
  spcParcelasProximo.ParamByName('contrato').asString := contrato;
  spcParcelasProximo.Open;
  result := spcParcelasProximonumero.asInteger;
  spcParcelasProximo.Close;
end;

procedure TdtmLerRetornos.QuitarParcelas(ValorPagamento: Currency;
  Datapagamento: tDatetime; Comentario: String; ViaSite: boolean);
var
  vSaldoParcela : Currency;
  vNossoNumero: integer;
begin
  spcTransacaoProximo.Open;

  vSaldoParcela := 0;
  vNossoNumero := qryParcelasnossonumero.AsInteger;

  if qryParcelasvalorvencto.Asfloat > ValorPagamento then
    vSaldoParcela := qryParcelasvalorvencto.Asfloat - ValorPagamento;

  qryParcelas.Edit;
  qryParcelasDataPagto.AsDateTime  := Datapagamento;
  if vSaldoParcela <> 0 then
  begin
    qryParcelasvalorvencto.Value     := ValorPagamento;
    //estava fora deste begin, ficando todas as parcelas em vermelho.
    qryParcelasdesmembrada.AsBoolean := true;
  end;

  qryParcelasValorPagto.AsCurrency := ValorPagamento;
  qryParcelasfilialpagto.AsInteger := strtoint(Filiais);
  qryParcelaspagamentoextracaixa.AsBoolean := true;
  // D->Dinheiro  C->Cartão  Crédito  B->Cartão Débito  H-> Cheque N->Banco
  qryParcelasFormaPagamento.AsString:= 'X';
  qryParcelasMOTIVO.AsString       :=  Comentario;
  qryParcelastransacao.asinteger := spcTransacaoProximotransacao.AsInteger;
  qryParcelasjaverificada.AsBoolean := True;
  qryParcelasevento.AsString := parsistema.EventoQuitacaoArqRetornoBoletos;
  qryParcelascontaboleto.AsString := qryContasConta.AsString;

  qryParcelas.Post;

  if vSaldoParcela <> 0 then
  begin
    qryInserirParcelaParcial.ParamByName('contrato').Value        := qryParcelascontrato.Value;
    qryInserirParcelaParcial.ParamByName('numero').Value          := proximoNumeroParcela(qryParcelascontrato.Value);
    qryInserirParcelaParcial.ParamByName('datavencto').Value      := qryParcelasdatavencto.Value;
    qryInserirParcelaParcial.ParamByName('valorvencto').Value     := vSaldoParcela;
    qryInserirParcelaParcial.ParamByName('parcelaorigem').Value   := qryParcelasparcelaorigem.Value;
    qryInserirParcelaParcial.ParamByName('parcelaoriginal').Value := qryParcelasnumero.Value;
    qryInserirParcelaParcial.ParamByName('tiporecebimento').Value     := qryParcelastiporecebimento.Value;
    qryInserirParcelaParcial.ParamByName('formapagamento').Value     := qryParcelasformapagamento.Value;
    qryInserirParcelaParcial.ParamByName('cliente').Value     := qryParcelascliente.Value;
    qryInserirParcelaParcial.ParamByName('nome').Value     := qryParcelasnome.Value;

    qryParcelas.next;
    if qryparcelas.eof then
      qryparcelas.append
    else
      qryparcelas.Insert;

    qryParcelascontrato.Value            := qryInserirParcelaParcial.ParamByName('contrato').Value;
    qryParcelasnumero.Value              := proximoNumeroParcela(qryParcelascontrato.Value);
    qryParcelasdatavencto.Value          := qryInserirParcelaParcial.ParamByName('datavencto').Value;
    qryParcelasvalorvencto.Value         := qryInserirParcelaParcial.ParamByName('valorvencto').Value;
    qryParcelasparcelaorigem.Value       := qryInserirParcelaParcial.ParamByName('parcelaorigem').Value;
    qryParcelasparcelaoriginal.Value     := qryInserirParcelaParcial.ParamByName('parcelaoriginal').Value;
    qryParcelastiporecebimento.Value     := qryInserirParcelaParcial.ParamByName('tiporecebimento').Value;
    qryParcelasformapagamento.Value      := qryInserirParcelaParcial.ParamByName('formapagamento').Value;
    qryParcelaspagamentoextracaixa.AsBoolean:=false;
    qryParcelastiporecebimento.AsInteger:=qryContastiporecebimento.AsInteger;
    qryParcelasjaverificada.AsBoolean := True;
    qryParcelasdesmembrada.AsBoolean     := true;
    qryParcelasMOTIVO.AsString           := 'SALDO DE PARCELA' ;
    qryParcelascliente.Value := qryInserirParcelaParcial.ParamByName('cliente').Value;
    qryParcelasnome.Value := qryInserirParcelaParcial.ParamByName('nome').Value;

    qryParcelas.Post;

  end;

  if not qryRecebimentos.Active then
    qryRecebimentos.Open;

  qryRecebimentos.Append;

  spcRecebimentosProximo.Open;
  qryRecebimentoscodigo.AsInteger := spcRecebimentosProximocodigo.AsInteger;
  spcRecebimentosProximo.Close;

  qryRecebimentosfilial.AsInteger       := StrToInt(Filiais);
  qryRecebimentossituacao.AsString      := 'N';
  qryRecebimentosdatalancto.AsDateTime  := DataServidor;
  qryRecebimentosvalorlancto.AsCurrency := ValorPagamento;
  qryRecebimentosdatavencto.AsDateTime  := Datapagamento;
  qryRecebimentostiporecebimento.AsInteger := qryContastiporecebimento.asinteger;
  qryRecebimentoscontrole.AsInteger     := 0;
  qryRecebimentostransacao.AsInteger    := spcTransacaoProximotransacao.AsInteger;
  qryRecebimentos.Post;

  spcTransacaoProximo.Close;

  if not ViaSite then
    perpetrar([qryparcelas, qryRecebimentos]);

  qryparcelas.Locate('nossonumero', vNossoNumero,[]);

  if ViaSite then
  begin
    if not Assigned(vPagamentosViaSite) then
    begin
      vPagamentosViaSite := TStringList.create;
      vPagamentosViaSite.Append('<html> <head> <title>Relação de Cobrança Via Site </title> </head> <body> ');
      vPagamentosViaSite.Append('<h1>Relação de Contratos de Venda do Site Quitados  </h1>');
      vPagamentosViaSite.Append('<table style="border:1px solid #ddd;"> <tr> <th align="center" width="130" bgcolor="#eee"> CONTRATO </th> <th align="center" width="130" bgcolor="#eee">PARCELA </th> '+
                                 '<th align="center" width="130" bgcolor="#eee"> DATA </th> <th align="right" width="140" bgcolor="#eee"> VALOR </th> </tr>');
    end;
    vTotalRegistroViaSite := vTotalRegistroViaSite + 1;
    vTotalValorRecebidoViaSite := vTotalValorRecebidoViaSite + qryParcelasValorPagto.AsCurrency;

    vPagamentosViaSite.append('<tr><td align="center"> ' + qryParcelascontrato.asstring + '</td><td align="center"> '+qryParcelasnumero.AsString+
                          '</td><td align="center"> '+ qryParcelasdatapagto.AsString+ '</td><td align="right"> '+ formatfloat('###,###,##0.00',qryParcelasvalorpagto.Ascurrency)+'</td></tr>');
  end;
end;

procedure TdtmLerRetornos.EnviarEmailQuitacaoViaSite;
begin

  if assigned(vPagamentosViaSite) then
  begin
    if vPagamentosViaSite.Count <> 3 then
    Begin
      vPagamentosViaSite.Append('<tr bgcolor="#eee"><td>Total de Registros:'+ inttostr(vTotalRegistroViaSite) +'</td><td /><td align="center" colspan="2"> Total Recebido: R$ ' + floattostr(vTotalValorRecebidoViaSite)+'</td></tr></table>');
      vPagamentosViaSite.Append('<p><small> E-mail gerado automaticamente pelo TecLUX. </small><a href="http://www.tecsoft.com.br" target="_blank"><img href="http://rot.tecsoft.com.br/images/logo_tecsoft.png" width="179" height="53" /></a></p></body></html>');
      EnviarEmail('COBRANÇA VIA SITE', qryFiliaisnome.AsString, qryParcelasdatapagto.AsDateTime, vPagamentosViaSite);
      vPagamentosViaSite.SaveToFile('c:\cobranca.html');
    end;
    vPagamentosViaSite.Free;
  end;

end;

end.
