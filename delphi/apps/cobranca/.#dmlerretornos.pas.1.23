        HL_USO_FEBRABAN             :Array[017..017] of Char;  {01- Brancos}
        HL_TIPO_INSCRICAO_EMPRESA   :Array[018..018] of Char;  {01-Obs 6 - 1=Cpf 2=Cgc}
