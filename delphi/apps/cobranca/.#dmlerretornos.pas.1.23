        HL_NR_CONTA_CORRENTE        :Array[060..071] of Char;  {12 - Obs 6/8}
        HL_DIGITO_CONTA             :Array[072..072] of Char;  {01- obs 6/8}
        HL_DIGITO_VERIF_AG_CONTA    :Array[073..073] of Char;  {01- Obs 6/8}
        HL_NOME_EMPRESA             :Array[074..103] of Char;  {30}
        HL_MENSAGEM1                :Array[104..143] of Char;  {40 - Obs 19}
        HL_MENSAGEM2                :Array[144..183] of Char;  {40 - Obs 19}
        HL_NR_REMESSA_RETORNO       :Array[184..191] of Char;  {08 - Obs 19}
        HL_DATA_GRAVACAO_REM_RET    :Array[192..199] of Char;  {08 - DDMMAAAA}
        HL_DATA_CREDITO             :Array[200..207] of Char;  {08 - DDMMAAA}
        HL_USO_FEBRABAN1            :Array[208..240] of Char;  {08- Brancos}
        HL_CrLf                     :Array[241..241] of Char;
      End;

