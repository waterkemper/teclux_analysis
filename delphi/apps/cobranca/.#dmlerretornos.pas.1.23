Type  T_HeaderBBrasil = Record

        H_CODIGO_BANCO_COMPENSACAO :Array[001..003] of Char;  {003 colocar 001}
        H_LOTE_DE_SERVICO          :Array[004..007] of Char;  {0001     }
        H_REGISTRO_HEADER_ARQUIVO  :Array[008..008] of Char;  {2        }
        H_USO_FEBRABAN             :Array[009..017] of Char;  {Brancos  }
        H_TIPO_INSCRICAO_EMPRESA   :Array[018..018] of Char;  { 2-Cgc    }
        H_NR_INSCRICAO_EMPRESA     :Array[019..032] of Char;  {14- Cgc   }
        H_CODIGO_CONVENIO_BANCO    :Array[033..052] of Char;  {20-obs:6/7}
        H_AGENCIA_MANTENEDORA_CONTA:Array[053..057] of Char;  {05-Obs 6/8}
        H_DIGITO_VERIF_AGENCIA     :Array[058..058] of Char;  {01-Obs 6/8}
        H_NUMERO_CONTA_CORRENTE    :Array[059..070] of Char;  {12-Obs 6/8}
        H_DIGITO_VERIF_CONTA       :Array[071..071] of Char;  {01-Obs 6/8}
        H_DIGITOVERIF_AG_CONTA     :Array[072..072] of Char;  {01-Obs 6/8}
        H_NOME_EMPRESA             :Array[073..102] of Char;  {30        }
        H_NOME_BANCO               :Array[103..132] of Char;  {30        }
        H_USO_FEBRABAN1            :Array[133..142] of Char;  {10-Brancos}
        H_CODIGO_REMESSA_RETORNO   :Array[143..143] of Char;  {01-1-REM / 2-RET}
        H_DATA_GERACAO_ARQUIVO     :Array[144..151] of Char;  {08-DDMMAAA}
        H_HORA_GERACAO_ARQUIVO     :Array[152..157] of Char;  {06-HHMMSS}
        H_NR_SEQUENCIAL_ARQUIVO    :Array[158..163] of Char;  {06-Obs 17 Incrementar a cada Header}
        H_NR_VERSAO_LAYOUT_ARQUIVO :Array[164..166] of Char;  {03 Obs 9 - 030}
        H_DENSIDADE_GRAVACAO       :Array[167..171] of Char;  {05}
        H_USO_ESERVADO_BANCO       :Array[172..191] of Char;  {20- Brancos}
        H_USO_RESERVADO_EMPRESA    :Array[192..211] of Char;  {20        }
        H_USO_FEBRABAN2            :Array[212..222] of Char;  {11- Brancos  }
        H_IDENT_COBRANCA_EMPAPEL   :Array[223..225] of Char;  {03-CSP}
        H_USO_DAS_VANS             :Array[226..228] of Char;  {03    }
        H_TIPO_DE_SERVICO          :Array[229..230] of Char;  {02-Obs 52 - 02 Cobrança Sem Papel}
        H_CODIGOS_DAS_OCORRENCIAS  :Array[231..240] of Char;  {10-Obs 53}
        H_CrLf                     :Array[241..241] of Char;
      End;

Type  T_HeaderLoteBBrasil = Record
        HL_CODIGO_BANCO_COMPENSACAO :Array[001..003] of Char;  {03}
        HL_LOTE_DE_SERVICO          :Array[004..007] of Char;  {04 oBS 1 }
        HL_REGISTRO_HEADERDE_LOTE   :Array[008..008] of Char;  {1 - Obs 2 colocar 1}
