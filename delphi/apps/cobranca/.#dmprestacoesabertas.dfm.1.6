        '         case when vf.tipo='#39'C'#39' then c.reffoneramal else cast(nul' +
        'l as varchar) end as reffoneramal,'
      
        '         Translate(Translate(SubStr(vf.rua,1,50),Chr(10),'#39' '#39'),Ch' +
        'r(13),'#39' '#39') as Residencia_Rua_1,'
      
        '         Translate(Translate(SubStr(vf.rua,51,50),Chr(10),'#39' '#39'),C' +
        'hr(13),'#39' '#39') as Residencia_Rua_2,'
