    Macros = <>
    Sql.Strings = (
      'Select u.nome,'
      '           u.codigo'
      
        'From   (usuarios u left join gruposusuarios gu on u.grupo=gu.cod' +
        'igo)'
      
        'Where (((u.inativo is null and (u.credito or gu.analistacredito)' +
        ') or (u.inativo>=:datacontrato and (u.credito or gu.analistacred' +
        'ito))) or u.codigo = :codigoinativo)'
      'Order By UPPER(TO_ASCII(u.nome,''LATIN1''))')
    RequestLive = False
    Left = 412
    Top = 445
    ParamData = <
      item
        DataType = ftDateTime
        Name = 'datacontrato'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'codigoinativo'
        ParamType = ptUnknown
      end>
