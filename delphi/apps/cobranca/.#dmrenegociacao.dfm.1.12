    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterScroll = qryContratosPorClienteAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select numero,'
      '       valorprazo,'
      '       tiporenegociacao,'
      '       primogenito,'
      '       situacao,'
      '       data'
      'From   contratos'
      'Where (cliente =:cliente)'
      '  and (tipocliente =:tipo)'
      '  and (situacao in (''F'',''N'',''P''))'
      '  and contratos_emaberto(numero)'
      '  and not contratos_renegociado(numero)'
      
        '  and not exists (select uc.contrato from usuarioscontratos uc w' +
        'here uc.contrato = contratos.numero limit 1)'
      ''
      'Order By  data desc, numero desc')
    RequestLive = False
    Left = 412
    Top = 10
    ParamData = <
      item
        DataType = ftInteger
        Name = 'cliente'
        ParamType = ptUnknown
        Value = 0
      end
      item
        DataType = ftString
        Name = 'tipo'
        ParamType = ptUnknown
      end>
