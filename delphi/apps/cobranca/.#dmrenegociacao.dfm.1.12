  object qryConsultaClientes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select  coalesce(v.razao,v.nome) as nome ,'
      '            v.codigo,'
      '            v.tipo,'
      '            v.estado,'
      '            cast(case when v.tipo = ''C'' then ''C - Cliente'''
      
        '                            when v.tipo = ''F'' then ''F - Forneced' +
        'or'''
      
        '                            else                            ''L -' +
        ' Filial'''
      '                    end as varchar) as descricaotipo,'
      '            formatar_cpf_cnpj(v.pessoanumero) as pessoanumero,'
      '            c.nome as nomecidade'
      'From    vfornecedores v, cidades c'
      'Where  '
      '/*  Preenchido em RunTime   */'
      '/*  Preenchido em RunTime   */'
      '/*  Preenchido em RunTime   */'
      '     and (v.estado = c.estado)'
      '     and (v.cidade = c.codigo) '
      'Order By UPPER(TO_ASCII(coalesce(v.razao,v.nome),''LATIN1''))')
    RequestLive = False
    Left = 412
    Top = 277
