    Macros = <>
    Sql.Strings = (
      'select  c.numero, '
      '       c.cliente,'
      '       c.tipocliente,'
      '       c.filialvenda,'
      '       c.agente,'
      '       c.avalista,'
      '       c.vendedor,'
      '       c.analista,'
      '       c.valorvista,'
      '       c.valorprazo,'
      '       c.origem,'
      '       c.data,'
      '       c.faturamento,'
      '       c.renegociacao,'
      '       c.desconto,'
      '       c.tiporenegociacao,'
      '       c.taxajuros,'
      '       c.plano,'
      '       c.consideracoes,'
      '       c.entrua,'
      '       c.entestado,'
      '       c.entcidade,'
      '       c.entbairro,'
      '       c.entcep,'
      '       c.entfoneddd,'
      '       c.entfonenumero,'
      '       c.entfoneramal,'
      '       c.montagemobs,'
      '       c.montagemfilial,'
      '       c.situacao,'
      '       cast(case when c.situacao  = ''F'' then ''FATURADO'''
      
        '                        when c.situacao = ''N'' then ''NOTA FISCAL''' +
        ' else ''NOTA PARCIAL'''
      '               end as varchar) as descricaosituacao,'
      
        '       (select c1.numero   from contratos c1 where c1.origem = c' +
        '.numero)      as novocontrato,'
      
        '       (select f.nome      from filiais  F   where f.codigo  = c' +
        '.filialvenda) as nomefilialvenda,'
      '       c.primogenito,'
      '       c.pedidocliente,'
      '       c.nome,'
      '       c.nascto,'
      '       c.apelido,'
      '       c.sexo,'
      '       c.civil,'
      '       c.civildata,'
      '       c.iddocumento,'
      '       c.idorgao,'
