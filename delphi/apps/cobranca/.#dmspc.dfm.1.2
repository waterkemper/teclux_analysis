    Sql.Strings = (
      '('
      ' select contrato, data, sum(valor) as valor'
      ' from'
      ' (  '
      '  ('
      '   select p.contrato,'
      '          ct.data,'
      '          sum(p.valorvencto) as valor'
      '   from parcelas p join contratos ct on ct.numero = p.contrato'
      '  where p.spccliente = :spccliente'
      '  group by p.contrato, ct.data'
      '  order by p.contrato, ct.data'
      '  ) '
      '   union all'
      '  ('
      '  select p.contrato,'
      '            ct.data,'
      '            sum(p.valorvencto) as valor'
      '  from parcelas p join contratos ct on ct.numero = p.contrato'
      '                        join'
      '         ('
      '          select pc.contratoparcela,'
      '                    pc.parcela'
      '           from parcelascartas pc'
      '           where pc.spc = :spccliente'
      '           order by pc.contratoparcela, pc.parcela '
      
        '         ) as parcelascartas on p.contrato = parcelascartas.cont' +
        'ratoparcela and'
      
        '                                          p.numero = parcelascar' +
        'tas.parcela'
      '   group by p.contrato, ct.data'
      '   order by p.contrato, ct.data '
      '  )'
      ' ) as spc'
      ' group by contrato, data'
      ' order by contrato, data'
      ')')
