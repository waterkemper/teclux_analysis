      '('
      '   select  pc.contratoparcela,  '
      '             pc.parcela,           '
      '             p.parcelaorigem,'
      '             p.datavencto,'
      '             p.valorvencto,'
      '             p.datapagto,'
      '             true as obsoleta,'
      '             pc.causa'
      
        '   from  (parcelascartas pc join parcelas p on pc.contratoparcel' +
        'a = p.contrato and'
      
        '                                                                ' +
        'pc.parcela = p.numero)'
      '   where pc.carta=:carta and'
      '            pc.cartanumero = :cartanumero  '
      ')'
      'union all'
      '('
      '   select  '
      '             p.contrato as contratoparcela,             '
      '             p.numero as parcela,'
      '             p.parcelaorigem,'
      '             p.datavencto,'
      '             p.valorvencto,'
      '             p.datapagto,'
      '             (p.datapagto is not null) as obsoleta,'
      '             cast(null as integer) as causa'
      '   from  parcelas p'
      '   where '
      
        '             p.cartacliente = :carta and p.cartanumerocliente = ' +
        ':cartanumero             '
      ')'
      'order by contratoparcela, parcela')
