    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select Nome,'
      '       Codigo,'
      
        '       cast(case when vf.pessoatipo = '#39'F'#39' then substr(vf.pessoan' +
        'umero, 1,3)||'#39'.'#39'||'
      
        '                                                                ' +
        '  substr(vf.pessoanumero, 4,3)||'#39'.'#39'||'
      
        '                                                                ' +
        '  substr(vf.pessoanumero, 7,3)||'#39'-'#39'||'
      
        '                                                                ' +
        '  substr(vf.pessoanumero, 10,2)'
      
        '                   when vf.pessoatipo = '#39'J'#39' then substr(vf.pesso' +
        'anumero, 1,2)||'#39'.'#39'||'
      
        '                                                             sub' +
        'str(vf.pessoanumero, 3,3)||'#39'.'#39'||'
      
        '                                                             sub' +
        'str(vf.pessoanumero, 6,3)||'#39'/'#39'||'
      
        '                                                             sub' +
        'str(vf.pessoanumero, 9,4)||'#39'-'#39'||'
      
        '                                                             sub' +
        'str(vf.pessoanumero, 13,2)'
      '         end as varchar) as pessoanumero,'
      '       tipo,'
      '       cast(case when tipo = '#39'F'#39' then '#39'Fornecedor'#39
      '                       when tipo = '#39'C'#39' then '#39'Cliente'#39
      '               end as varchar) as tipoorig,'
      '       (select nome'
      '        from cidades d'
      '        where (d.estado = vf.estado) and'
      '              (d.codigo = vf.cidade)'
      '       ) as nomecidade,'
      '      vf.estado'
      'From   vfornecedores vf'
      ''
      '/* editado em run time */'
      'Order By UPPER(TO_ASCII(nome,'#39'LATIN1'#39'))')
    RequestLive = False
    Left = 894
    Top = 24
