  object qryVoltaSPCClientedaParcelaCarta: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'update parcelas set cartacliente = parcelascartas.carta,'
      
        '                    cartanumerocliente = parcelascartas.cartanum' +
        'ero,'
      '                    spccliente = parcelascartas.spc'
      'from'
      '  ('
      '    select pc.carta,'
      '           pc.cartanumero,'
      #9'   pc.spc,'
      #9'   pc.contratoparcela,'
      #9'   pc.parcela'
      
        '    from ((parcelascartas pc join cartasclientes cc on pc.carta ' +
        '= cc.carta and'
      
        '                                                      pc.cartanu' +
        'mero = cc.numero)'
      
        '                                      join parcelas p on pc.cont' +
        'ratoparcela = p.contrato and'
      
        '                                                                ' +
        'pc.parcela = p.numero)'
      '    where not cc.eavalista and'
      '          pc.causa = 4 and'
      '          pc.spc in  (9999)  '
      '    FOR UPDATE OF p'
      '  ) as parcelascartas'
      '  where contrato = parcelascartas.contratoparcela and'
      '        numero = parcelascartas.parcela and'
      '        datapagto is null')
    RequestLive = True
    Left = 488
    Top = 400
  end
