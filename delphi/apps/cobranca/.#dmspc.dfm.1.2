      '('
      
        'select distinct spc.novaremessa, spc.spc, spc.operacao, spc.reme' +
        'ssa from'
      '('
      'select distinct spc.*, p.contrato from'
      '('
      ' select distinct  cast(:remessa as integer) as novaremessa,'
      '                       spc.numero as spc,'
      '                       cast ('#39'I'#39' as varchar) as operacao,'
      '                       (select max(sr.remessa)'
      '                        from spcremessa sr'
      
        '                        where sr.spc = spc.numero and operacao='#39 +
        'I'#39') as remessa'
      ''
      'from spc'
      'where (spc.aguardando'
      '       or (coalesce(spc.bloqueada,'#39#39')<>'#39#39')'
      '       or (spc.dataexclusao is null and not spc.registradospc))'
      '               and (select srd.dataspc'
