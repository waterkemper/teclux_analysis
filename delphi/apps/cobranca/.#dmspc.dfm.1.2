  object qryGerarSPCRetirada: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'insert into spcremessa (spc, operacao, remessa, rejeitada)'
      ' ('
      '   select spc.numero,'
      '          cast('#39'E'#39' as varchar),'
      '          :remessa as remessa,'
      '          false as rejeitada'
      '   from'
      '   ( '
      '    select distinct spc.numero'
      
        '    from (spc join (cartas c join (cartasclientes cc join (parce' +
        'lascartas pc join (parcelas p join contratos on p.contrato = con' +
        'tratos.numero) '
      
        '                                                                ' +
        '                                                          on pc.' +
        'contratoparcela = p.contrato and pc.parcela = p.numero)'
      
        '                                                                ' +
        '                                    on cc.carta = pc.carta and c' +
        'c.numero = pc.cartanumero)'
      
        '                                                                ' +
        '    on c.numero = cc.carta)                                     ' +
        '                              '
      '                                   on spc.carta = c.numero)'
      '    where spc.dataexclusao is null'
      '    /* Where Filial Venda */'
      '   /* Retirada Forcada */'
      '    order by spc.numero'
      '   ) as spc'
      '   where not exists (select spccliente'
      '                            from parcelas'
      
        '                            where (parcelas.spccliente = spc.num' +
        'ero)'
      '                           ) and'
      '             not exists (select spcavalista'
      '                            from parcelas'
      ' '#9'                where (parcelas.spcavalista = spc.numero)'
      '                           ) and'
      '         not exists (select pc.spc'
      
        '                        from (parcelascartas pc join parcelas p ' +
        'on pc.contratoparcela = p.contrato and'
      
        '                                                                ' +
        '                 pc.parcela = p.numero) '
      '                        where (pc.spc = spc.numero) and'
      '                                 (p.datapagto = CURRENT_DATE)'
      '                        )'
      ' )')
    RequestLive = True
    Left = 323
    Top = 253
    ParamData = <
      item
        DataType = ftString
        Name = 'remessa'
        ParamType = ptUnknown
        Value = '7022'
      end>
  end
  object qryGerarSPCRetiradaDados_Clientes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      
        'insert into spcremessadados ( spc, operacao, remessa, carta, car' +
        'tanumero, dataempresa, nome, nascto, naturalcidade, naturalestad' +
        'o, civil,'
      
        '                                          sexo, pessoatipo, pess' +
        'oanumero, documento, idestado, rua, numero, complemento, bairro,' +
        ' cep, estado,'
      
        '                                          cidade, conjuge, conna' +
        'scto, mae, pai, cargo, empresa, foneddd, fonenumero )'
      '  ('
      '   select'
      '            spc.numero,'
      '            cast('#39'E'#39' as varchar) as operacao,'
      '            :remessa as remessa,'
      '            cc.carta,'
      '            cc.numero,'
      '            cast(:datahoragravacao as timestamp) as dataempresa,'
      '            coalesce(vf.razao,vf.nome) as nome ,'
      
        '            case when c.tipocliente='#39'C'#39' then (select cl.nascto f' +
        'rom clientes cl where cl.codigo=c.cliente) else cast(null as dat' +
        'e) end as nascto,'
      
        '            case when c.tipocliente='#39'C'#39' then (select cl.naturalc' +
        'idade from clientes cl where cl.codigo=c.cliente) else cast(null' +
        ' as integer) end as naturalcidade,'
      
        '            case when c.tipocliente='#39'C'#39' then (select cl.naturale' +
        'stado from clientes cl where cl.codigo=c.cliente) else cast(null' +
        ' as varchar) end as naturalestado,'
      '            vf.civil,'
      
        '            coalesce(case when c.tipocliente='#39'C'#39' then (select cl' +
        '.sexo from clientes cl where cl.codigo=c.cliente and cl.sexo<>'#39'E' +
        #39') else cast('#39'I'#39' as varchar) end, cast('#39'I'#39' as varchar)) as sexo,'
      '            vf.pessoatipo,'
      '            cast(vf.pessoanumero as varchar) as pessoanumero,'
      '            cast(vf.inscricaoestadual as varchar),'
      
        '            case when c.tipocliente='#39'C'#39' then (select cl.idestado' +
        ' from clientes cl where cl.codigo=c.cliente) else cast(null as v' +
        'archar) end as idestado,'
      '            vf.rua, vf.numero, vf.complemento,'
      '            vf.bairro,'
      '            vf.cep,'
      '            vf.estado,'
      '            vf.cidade,'
      
        '            case when c.tipocliente='#39'C'#39' then (select cl.nome fro' +
        'm clientes cl where cl.codigo=(select cl2.conjuge from clientes ' +
        'cl2 where cl2.codigo=c.cliente)) else cast(null as varchar) end ' +
        'as conjuge,'
      
        '            case when c.tipocliente='#39'C'#39' then (select cl.nascto f' +
        'rom clientes cl where cl.codigo=(select cl2.conjuge from cliente' +
        's cl2 where cl2.codigo=c.cliente)) else cast(null as date) end a' +
        's connascto,'
      
        '            case when c.tipocliente='#39'C'#39' then (select cl.mae from' +
        ' clientes cl where cl.codigo=c.cliente) else cast(null as varcha' +
        'r) end as mae,'
      
        '            case when c.tipocliente='#39'C'#39' then (select cl.pai from' +
        ' clientes cl where cl.codigo=c.cliente) else cast(null as varcha' +
        'r) end as pai,'
      
        '            case when c.tipocliente='#39'C'#39' then (select cargos.desc' +
        'ricao '
      
        '                                                            from' +
        ' cargos '
      
        '                                                            wher' +
        'e cargos.codigo = (select cl.empcargo'
      
        '                                                                ' +
        '                              from clientes cl'
      
        '                                                                ' +
        '                              where cl.codigo = c.cliente)) else' +
        ' cast(null as varchar) end as cargo,'
      
        '            case when c.tipocliente='#39'C'#39' then (select cl.empresa ' +
        'from clientes cl where cl.codigo=c.cliente) else cast(null as va' +
        'rchar) end as empresa,'
      '            vf.foneddd,'
      '            vf.fonenumero'
      
        '   from (spcremessa sr join (spc join  ((cartas c join cartascli' +
        'entes cc on c.numero = cc.carta)'
      
        '                                                                ' +
        '  join vfornecedores vf on c.cliente = vf.codigo and c.tipoclien' +
        'te = vf.tipo)'
      
        '                                                                ' +
        '  on spc.carta = c.numero)'
      
        '                                             on sr.spc = spc.num' +
        'ero)'
      '   where sr.remessa = :remessa and'
      '            sr.operacao = '#39'E'#39' and'
      '            not sr.rejeitada and'
      '            not cc.eavalista and'
      '            (select srd2.operacao'
      '              from spcremessadados srd2'
      '              where srd2.spc = spc.numero and'
      '                        srd2.carta = cc.carta and'
      #9'          srd2.cartanumero = cc.numero'
      '              order by dataempresa desc limit 1) = '#39'I'#39
      ''
      '            /* and sr.spc in (ListaNumeroSPC) */'
      '  )')
    RequestLive = True
    Left = 323
    Top = 301
