 linha := linha + format('%-8.8s', [qryRemessaspc_operador.asstring]);
 linha := linha + FormatDateTime('ddmmyyyy', date());
 linha := linha + FormatDateTime('ddmmyyyy', date());
 linha := linha + format('%680s', ['']);
 linha := linha + '0000000';
 linha := linha + format('%50s',['']);

{$IFDEF LINUX}
