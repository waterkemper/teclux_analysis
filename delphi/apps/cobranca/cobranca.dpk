package cobranca;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  repositorio,
  vclx,
  VKDBF7;

contains
  rgcobranca in 'rgcobranca.pas',
  dmdevolucaonumerario in 'dmdevolucaonumerario.pas' {dtmDevolucaoNumerario: TDataModule},
  dmfichacobranca in 'dmfichacobranca.pas' {dtmFichaCobranca: TDataModule},
  dmprestacoesabertas in 'dmprestacoesabertas.pas' {dtmPrestacoesAbertas: TDataModule},
  dmregistrospc in 'dmregistrospc.pas' {dtmRegistroSPC: TDataModule},
  dmrenegociacao in 'dmrenegociacao.pas' {dtmRenegociacao: TDataModule},
  fmaviso in 'fmaviso.pas' {frmAviso},
  fmdevolucaonumerario in 'fmdevolucaonumerario.pas' {frmDevolucaoNumerario},
  fmfichacobranca in 'fmfichacobranca.pas' {frmFichaCobranca},
  fmprestacoesabertas in 'fmprestacoesabertas.pas' {frmPrestacoesAbertas},
  fmregistrospc in 'fmregistrospc.pas' {frmRegistroSPC},
  fmrenegociacao in 'fmrenegociacao.pas' {frmRenegociacao},
  fmsituacaocarta in 'fmsituacaocarta.pas' {frmSituacaoCarta},
  dmaviso in 'dmaviso.pas' {dtmAviso: TDataModule},
  fmcadastroparcelasrenegociacao in 'fmcadastroparcelasrenegociacao.pas' {frmCadastroParcelasRenegociacao},
  fmlerdadosopcaoavisos in 'fmlerdadosopcaoavisos.pas' {frmLerDadosOpcaoAvisos},
  fmspc in 'fmspc.pas' {frmSPC},
  dmspc in 'dmspc.pas' {dtmspc: TDataModule},
  dmdefinircobrador in 'dmdefinircobrador.pas' {dtmDefinirCobrador: TDataModule},
  dmrelatoriorecebimentosporcobrador in 'dmrelatoriorecebimentosporcobrador.pas' {dtmRelatorioRecebimentosPorCobrador: TDataModule},
  fmrelatoriorecebimentosporcobrador in 'fmrelatoriorecebimentosporcobrador.pas' {frmRelatorioRecebimentosPorCobrador},
  fmdefinircobrador in 'fmdefinircobrador.pas' {frmDefinirCobrador},
  fmcadastrocobranca in 'fmcadastrocobranca.pas' {frmCadastroCobranca},
  dmgerarremessas in 'dmgerarremessas.pas' {dtmGerarRemessas: TDataModule},
  fmgerarremessas in 'fmgerarremessas.pas' {frmgerarremessas},
  dmlerretornos in 'dmlerretornos.pas' {dtmLerRetornos: TDataModule},
  fmlerretornos in 'fmlerretornos.pas' {frmlerretornos},
  fmgerarremessassoacred in 'fmgerarremessassoacred.pas' {frmGerarRemessasSoacred},
  dmgerarremessassoacred in 'dmgerarremessassoacred.pas' {dtmGerarRemessasSoacred: TDataModule},
  fmimprimirduplicatas in 'fmimprimirduplicatas.pas' {frmimprimirduplicatas},
  dmimprimirduplicatas in 'dmimprimirduplicatas.pas' {dtmImprimirDuplicatas: TDataModule};

end.
