    fcGRUPOSFILIAIS       : RefazConsulta(qryGrupoFiliais,     [0],[qryConsultaGrupoFiliaiscodigo.AsInteger]);
    fcREGIOES             : RefazConsulta(qryRegiao,           [0],[qryConsultaRegiaocodigo.AsString]);
    fcCOBRADORES          : RefazConsulta(qryCobrador,         [0],[qryConsultaCobradorcodigo.AsInteger]);
