  end;
end;

procedure TdtmFichaCobranca.SelecionarContratoParaImpressao(Todos: Boolean);
var
  Pos: TBookmark;
  I  : Integer;

  procedure IncrementaValores;
  begin
    if qryContratosFichaCobrancaselecionar.AsBoolean then begin
      FNumeroRegistroMarcado:= FNumeroRegistroMarcado + 1;
      FTotalValoresMarcados := FTotalValoresMarcados + qryContratosFichaCobrancatotalaberto.AsCurrency;
    end
    else begin
      FNumeroRegistroMarcado:= FNumeroRegistroMarcado - 1;
      FTotalValoresMarcados := FTotalValoresMarcados - qryContratosFichaCobrancatotalaberto.AsCurrency;
    end;
  end;

begin
  if (qryContratosFichaCobranca.RecordCount > 0) then begin
    if not Todos then begin
      qryContratosFichaCobranca.Edit;
      qryContratosFichaCobrancaselecionar.AsBoolean:= not qryContratosFichaCobrancaselecionar.AsBoolean;
      qryContratosFichaCobranca.Post;
      IncrementaValores;
    end
    else begin
      with qryContratosFichaCobranca do begin
        Pos:= GetBookmark;
        try
          DisableControls;
          First;
          for I:= 1 to RecordCount do begin
            Edit;
            qryContratosFichaCobrancaselecionar.AsBoolean:= not qryContratosFichaCobrancaselecionar.AsBoolean;
            Post;
            IncrementaValores;
            Next;
          end;
        finally
          GotoBookmark(Pos);
          FreeBookmark(Pos);
          EnableControls;
        end;
      end;
    end;
  end;
end;

