procedure TdtmFichaCobranca.ImprimirFichasCobranca;
var
  Pos          : TBookmark;
  ListaContrato: String;
begin
  ListaContrato:= '';
  qryContratosFichaCobranca.DisableControls;
  Pos:= qryContratosFichaCobranca.GetBookmark;
  qryContratosFichaCobranca.First;
  try
    while not qryContratosFichaCobranca.Eof do begin
      if qryContratosFichaCobrancaselecionar.AsBoolean then
        ListaContrato:= ListaContrato + QuotedStr(qryContratosFichaCobrancanumero.AsString) + ',';
      qryContratosFichaCobranca.Next;
    end;
  finally
    qryContratosFichaCobranca.GotoBookmark(Pos);
    qryContratosFichaCobranca.FreeBookmark(Pos);
    qryContratosFichaCobranca.EnableControls;
  end;
  Delete(ListaContrato,Length(ListaContrato),1);

  FichaCobranca := TdtmImprimeFichaCobranca.Create(Self);
  try
    FichaCobranca.ImprimirFichaFinanceira(ListaContrato,
    qryContratosFichaCobranca.macrobyname('Ordenacao').AsString,
    MontaDataVencimento('and'));
  finally
    FichaCobranca.Free;
    FichaCobranca := nil;
  end;

  if qryUsuariosContratos.State = dsInactive then
    qryUsuariosContratos.Active:= True;

  qryCobrancaExiste.Sql[03]:= '(contrato in (' + ListaContrato + '))';
  qryCobrancaExiste.Open;

  qryContratosFichaCobranca.DisableControls;
  Pos:= qryContratosFichaCobranca.GetBookmark;
  qryContratosFichaCobranca.First;
  try
    while not qryContratosFichaCobranca.Eof do begin
      if qryContratosFichaCobrancaselecionar.AsBoolean then begin
         if not qryCobrancaExiste.Locate('contrato', qryContratosFichaCobrancanumero.AsString,[]) then begin
           qryUsuariosContratos.Insert;
           qryUsuariosContratoscontrato.AsString := qryContratosFichaCobrancanumero.AsString;
           qryUsuariosContratosusuario.AsInteger := qryCobradorContratocodigo.AsInteger;
           qryUsuariosContratosdata.AsDateTime   := DataServidor;
           qryUsuariosContratos.Post;
         end;
      end;
      qryContratosFichaCobranca.Next;
    end;
  finally
    qryContratosFichaCobranca.GotoBookmark(Pos);
    qryContratosFichaCobranca.FreeBookmark(Pos);
    qryContratosFichaCobranca.EnableControls;

    Perpetrar([qryUsuariosContratos]);
    qryUsuariosContratos.Close;
  end;
end;

