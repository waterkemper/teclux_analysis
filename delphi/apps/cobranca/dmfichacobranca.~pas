procedure TdtmFichaCobranca.SetFilial(const Value: string);
begin
  if (Value <> '') then
       qryContratosFichaCobranca.MacroByName('Filial').AsString := 'and (ct.filialvenda = ' + Value + ')'
  else qryContratosFichaCobranca.MacroByName('Filial').AsString := '';
end;

procedure TdtmFichaCobranca.SetGrupoFilial(const Value: string);
begin
  if (Value <> '') then
    qryContratosFichaCobranca.MacroByName('GrupoFilial').AsString := 'and (ct.filialvenda in (Select filial From filiaisgruposfiliais Where grupo = ' + Value + '))'
  else qryContratosFichaCobranca.MacroByName('GrupoFilial').AsString := '';
end;

procedure TdtmFichaCobranca.SetRegiao(const Value: string);
begin
  if (Value <> '') then
       qryContratosFichaCobranca.MacroByName('Regiao').AsString := 'and ((vf.bairro in (Select codigo ' +
                                                                    'From  bairros '  +
                                                                    'Where regiao = ''' + Value + ''')) or '+
                                                                    '(vf.cidade in (Select codigo ' +
                                                                    'From  cidades '  +
                                                                    'Where regiao = ''' + Value + ''')))';
  else qryContratosFichaCobranca.MacroByName('Regiao').AsString := '';
end;

procedure TdtmFichaCobranca.SetCobrador(const Value: string);
begin
  if (Value <> '') then
       qryContratosFichaCobranca.MacroByName('Cobrador').AsString:='and exists (Select uc.contrato '       +
                                                                    'From usuarioscontratos uc '             +
                                                                    'Where (uc.contrato = ct.numero)    and ' +
                                                                    '      (uc.usuario= ' + Value + ') and ' +
                                                                    '      (uc.retorno is null))'
  else qryContratosFichaCobranca.MacroByName('Cobrador').AsString := '';
end;

procedure TdtmFichaCobranca.MontaDataVenda(Data: String);
const
SQL = 'and (ct.faturamento >= ''%s'')';
begin
  if not DataEmBranco(Data) then
    qryContratosFichaCobranca.MacroByName('Faturamento').AsString  :=  format(SQL,[Data])
  else qryContratosFichaCobranca.MacroByName('Faturamento').AsString  := '';
end;

function TdtmFichaCobranca.MontaDataVencimento(Whereorand: String): String;
Var
  Data_1, Data_2: String;
begin

  Data_1 := Whereorand+' ((p.datavencto = ''%s'') and p.datapagto is null)';

  Data_2 := Whereorand+' ((p.datavencto between (''%s'') and (''%s'')) and p.datapagto is null)';

  if not DataEmBranco(FDataVenctoInicial) then begin

    if DataEmBranco(FDataVenctoFinal) then

         Result:= Format(Data_1, [FDataVenctoInicial])

    else Result:= format(Data_2, [FDataVenctoInicial,FDataVenctoFinal]);

  end

  else begin

    if not DataEmBranco(FDataVenctoFinal) then

         Result:= Format(Data_1, [FDataVenctoFinal])

    else Result:= '';

  end;

end;


procedure TdtmFichaCobranca.SetAtraso(const Value: Boolean);
const
  Atraso = 'and (clientes_primeiroatraso(ct.cliente, ct.tipocliente) >= p.atraso)';
begin
  if Value then
     qryContratosFichaCobranca.MacroByName('PrimeiroAtraso').AsString := Atraso
  else
     qryContratosFichaCobranca.MacroByName('PrimeiroAtraso').AsString := '';
end;

procedure TdtmFichaCobranca.SetOcorrenciasCobranca(const Value: Boolean);
begin
  if Value then
    qryContratosFichaCobranca.MacroByName('Atendimentos').AsString:='and not (atendimentos_cobrancasemaviso(cliente,tipocliente))'
  else qryContratosFichaCobranca.MacroByName('Atendimentos').AsString:= '';
end;

procedure TdtmFichaCobranca.SetPrimeiraCompra(const Value: Boolean);
begin
  if Value then
       qryContratosFichaCobranca.MacroByName('PrimeiraCompra').asstring:=
                                     'and ((Select count(t1.numero) '+
                                     '      From contratos t1 '+
                                     '      Where (t1.cliente = ct.cliente) and '         +
                                     '            (t1.tipocliente = ct.tipocliente) and ' +
                                     '            (ct.situacao in (''F'',''N'',''P''))    and ' +
                                     '            (ct.origem is null)) = 1)'
  else qryContratosFichaCobranca.MacroByName('PrimeiraCompra').asstring := '';
end;

procedure TdtmFichaCobranca.SetOrdenacao(const Value: Integer);
begin
  with qryContratosFichaCobranca do
  case Value of
    0: MacroByName('Ordenacao').AsString:= 'ORDER BY UPPER(TO_ASCII(CidadeResidencia,''LATIN1'')), ' +
                                                    'UPPER(TO_ASCII(BairroResidencia,''LATIN1''))';
    1: MacroByName('Ordenacao').AsString:= 'ORDER BY TotalAberto';
    2: MacroByName('Ordenacao').AsString:= 'ORDER BY UPPER(TO_ASCII(Nome,''LATIN1''))';
    3: MacroByName('Ordenacao').AsString:= 'ORDER BY Cliente, TipoCliente';
  end;
end;

