function TdtmFichaCobranca.GetTotalRegistro: Integer;
begin
  Result := qryContratosFichaCobranca.RecordCount;
end;

function TdtmFichaCobranca.GetTotalValores: Real;
var
  Pos   : TBookmark;
  I     : Integer;
  Total : Real;
begin
  Total:= 0;
  with qryContratosFichaCobranca do begin
    Pos:= GetBookmark;
    try
      DisableControls;
      First;
      for I:= 1 to RecordCount do begin
        Total:= Total + qryContratosFichaCobrancatotalaberto.Value;
        Next;
      end;
    finally
      GotoBookmark(Pos);
      FreeBookmark(Pos);
      EnableControls;
    end;
  end;
  Result := Total;
end;

procedure TdtmFichaCobranca.SetContratosSemCobrador(const Value: Boolean);
begin
  if value then
       qryContratosFichaCobranca.MacroByName('ContratoSemCobrador').AsString :=
                                    'and ((Select count(uc.contrato) '   +
                                          'From   usuarioscontratos uc ' +
                                          'Where  (uc.contrato = ct.numero) ' +
                                          'and    (uc.retorno is null)) = 0)'
  else qryContratosFichaCobranca.MacroByName('ContratoSemCobrador').AsString :='';
end;

