        DataType = ftUnknown
        Name = 'WhereConceitos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereVendedor'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereCartaDevolvida'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereOcorrenciaCobranca'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WherePrimeiraCompra'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereSemPagamento'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereRegiao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereEndereco'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'OrderBy'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '/* qryParcelasClientes */ ( select'
      '        /* distinct  */'
      '         contratosparcelas.cliente,'
      '         contratosparcelas.tipocliente,'
      
        '         (select coalesce(razao,nome) as nome from vfornecedores' +
        ' where codigo=contratosparcelas.cliente and tipo=contratosparcel' +
        'as.tipocliente) as nome,'
      
        '         (select pessoatipo from vfornecedores where codigo=cont' +
        'ratosparcelas.cliente and tipo=contratosparcelas.tipocliente) as' +
        ' tipopessoa,'
      
        '         (select pessoanumero from vfornecedores where codigo=co' +
        'ntratosparcelas.cliente and tipo=contratosparcelas.tipocliente) ' +
        'as cpfcgc,'
      
        '         (select inscricaoestadual from vfornecedores where codi' +
        'go=contratosparcelas.cliente and tipo=contratosparcelas.tipoclie' +
        'nte) as rgie,'
      '         contratosparcelas.filialvenda,'
      '         contratosparcelas.vendedor,'
      '         contratosparcelas.nomevendedor,'
      '         f.nome as nomefilialvenda,'
      '         gf.codigo as grupofilialvenda,'
      '         gf.descricao  as nomegrupofilialvenda,'
      '         vf.foneddd,'
      '         vf.fonenumero,'
      '         vf.foneramal,'
      
        '         case when tipocliente='#39'C'#39' then c.fonetipo else cast(nul' +
        'l as varchar) end as TipoFone,'
      
        '         case when tipocliente='#39'C'#39' then c.confoneddd else cast(n' +
        'ull as integer) end as confoneddd,'
      
        '         case when tipocliente='#39'C'#39' then c.confonenumero else cas' +
        't(null as integer) end as confonenumero,'
      
        '         case when tipocliente='#39'C'#39' then c.confoneramal else cast' +
        '(null as varchar) end as confoneramal,'
      '         vf.Empresa,'
      '         vf.fonedddempresa as empfoneddd,'
      '         vf.fonenumeroempresa as empfonenumero,'
      '         vf.foneramalempresa as empfoneramal,'
      
        '         case when vf.tipo='#39'C'#39' then c.reffoneddd else cast(null ' +
        'as integer) end as reffoneddd,'
      
        '         case when vf.tipo='#39'C'#39' then c.reffonenumero else cast(nu' +
        'll as integer) end as reffonenumero,'
      
        '         case when vf.tipo='#39'C'#39' then c.reffoneramal else cast(nul' +
        'l as varchar) end as reffoneramal,'
      
        '         Translate(Translate(SubStr(vf.rua,1,50),Chr(10),'#39' '#39'),Ch' +
        'r(13),'#39' '#39') as Residencia_Rua_1,'
      
        '         Translate(Translate(SubStr(vf.rua,51,50),Chr(10),'#39' '#39'),C' +
        'hr(13),'#39' '#39') as Residencia_Rua_2,'
      '         vf.estado,'
      '         vf.cep,'
      
        '         (select cd.nome from cidades cd WHERE cd.estado = vf.es' +
        'tado  and cd.codigo = vf.cidade) as nomecidade,'
      
        '         (select ba.nome from bairros ba WHERE ba.estado=vf.esta' +
        'do  and'
      
        '                                              ba.cidade = vf.cid' +
        'ade  and'
      
        '                                              ba.codigo=vf.bairr' +
        'o)  as nomebairrocliente'
      'from'
      '  ('
      '    select'
      '         ct.cliente,'
      '         ct.tipocliente,'
      '         ct.nome,'
      '         ct.filialvenda,'
      '         ct.vendedor,'
      '         u.nome as nomevendedor,'
      '         parcelas.*'
      '    from'
      
        '    (contratos ct left join usuarios u on ct.vendedor = u.codigo' +
        '),'
      '   ('
      '    Select    distinct(p.contrato)'
      '     From     parcelas p'
      '     where    p.datapagto is null'
      '       %WherePeriodoVencto'
      ''
      '   ) as parcelas'
      '    Where ct.numero=parcelas.contrato and'
      
        '           ct.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39') and contratos_atual(ct.n' +
        'umero)'
      '           %WherePeriodoVenda'
      '           %WhereCliente'
      '           %WhereFiliais'
      '           %WhereAgentes'
      '           %WhereConceitos'
      '           %WhereVendedor'
      '           %WhereCartaDevolvida'
      '           %WhereOcorrenciaCobranca'
      '           %WherePrimeiraCompra'
      '           %WhereSemPagamento'
      
        '   ) as contratosparcelas  JOIN  vfornecedores vf  on vf.codigo=' +
        'cliente and vf.tipo=tipocliente'
      
        '                                    JOIN (filiais f left join (f' +
        'iliaisgruposfiliais fgf join gruposfiliais gf on fgf.grupo=gf.co' +
        'digo)'
      
        '                                                                ' +
        '                                   on f.codigo=fgf.filial)'
      
        '                                                                ' +
        'on f.codigo=filialvenda'
      
        #9'                        LEFT JOIN clientes c on c.codigo=client' +
        'e'
      '  where true'
      '  %WhereRegiao'
      '  %WhereEndereco'
      '  %OrderBy'
      ')')
    RequestLive = False
    Left = 428
    Top = 108
