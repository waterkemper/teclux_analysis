  object qryParcelasExportar: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryParcelasCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WherePeriodoVencto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'GroupBy'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WherePeriodoVenda'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereCliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereAgentes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereConceitos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereVendedor'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereCartaDevolvida'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereOcorrenciaCobranca'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WherePrimeiraCompra'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereSemPagamento'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereRegiao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereEndereco'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ' ('
      '  select contratosparcelas.*,'
      
        '         coalesce(vf.razao, contratosparcelas.nomeclientecontrat' +
        'o) as nomecliente,'
      '         f.nome as nomefilialvenda,'
      ''
      '         vf.pessoatipo as tipopessoa,'
      '         vf.pessoanumero as cpfcgc,'
      '         vf.inscricaoestadual as rgie,'
      ''
      '         vf.foneddd,'
      '         vf.fonenumero,'
      '         vf.foneramal,'
      '         vf.Empresa,'
      '         vf.fonedddempresa as empfoneddd,'
      '         vf.fonenumeroempresa as empfonenumero,'
      '         vf.foneramalempresa as empfoneramal,'
      
        '         Translate(Translate(SubStr(vf.rua,1,50),Chr(10),'#39' '#39'),Ch' +
        'r(13),'#39' '#39') as Residencia_Rua_1,'
      
        '         Translate(Translate(SubStr(vf.rua,51,50),Chr(10),'#39' '#39'),C' +
        'hr(13),'#39' '#39') as Residencia_Rua_2,'
      '         vf.numero as numeroresidencia,'
      '         vf.complemento as complementeoresidencia,'
      '         vf.estado,'
      '         vf.cep,'
      
        '         (select cd.nome from cidades cd WHERE cd.estado = vf.es' +
        'tado  and cd.codigo = vf.cidade) as nomecidade,'
      
        '         (select ba.nome from bairros ba WHERE ba.estado=vf.esta' +
        'do  and'
      
        '                                              ba.cidade = vf.cid' +
        'ade  and'
      
        '                                              ba.codigo=vf.bairr' +
        'o)  as nomebairrocliente,'
      ''
      ''
      
        '         notas_notasdocontrato(contratosparcelas.contrato) as no' +
        'tas'
      '  from'
      '  ('
      '    select'
      '         ct.cliente,'
      '         ct.tipocliente,'
      '         ct.filialvenda,'
      '         ct.vendedor,'
      '         ct.nome as nomeclientecontrato,'
      '         u.nome as nomevendedor,'
      
        '         Extract (Day From (parcelas.datavencto - Now() )) as At' +
        'raso,'
      '         parcelas.*'
      '    from'
      
        '    (contratos ct left join usuarios u on ct.vendedor = u.codigo' +
        '),'
      '   ('
      '    Select    p.contrato,'
      '                 p.numero as numeroparcela,'
      
        '                 p.datavencto,  /* defini'#231#227'o do m'#237'nimo ou todos ' +
        '*/'
      '                 p.valorvencto'
      '     From     parcelas p'
      '     where    p.datapagto is null'
      '       %WherePeriodoVencto'
      '     %GroupBy'
      '   ) as parcelas'
      '    Where ct.numero=parcelas.contrato and'
      
        '           ct.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39') and contratos_atual(ct.n' +
        'umero)'
      
        '           %WherePeriodoVenda /*and  ct.faturamento between (:Ve' +
        'ndainicial) and (:VendaFinal)*/'
      '           %WhereCliente'
      '           %WhereFiliais'
      '           %WhereAgentes'
      '           %WhereConceitos'
      '           %WhereVendedor'
      '           %WhereCartaDevolvida'
      '           %WhereOcorrenciaCobranca'
      '           %WherePrimeiraCompra'
      '           %WhereSemPagamento'
      
        '   ) as contratosparcelas  /*LEFT*/ JOIN vfornecedores vf  on vf' +
        '.codigo=cliente and vf.tipo=tipocliente'
      '     join filiais f on contratosparcelas.filialvenda = f.codigo'
      '  %WhereRegiao'
      '  %WhereEndereco'
      'order by contrato, datavencto, numeroparcela'
      ')')
    RequestLive = False
    Left = 257
    Top = 326
    ParamData = <
      item
        DataType = ftString
        Name = 'Vendainicial'
        ParamType = ptUnknown
        Value = '2015-01-01'
      end
      item
        DataType = ftString
        Name = 'VendaFinal'
        ParamType = ptUnknown
        Value = '2015-01-01'
      end>
