    Sql.Strings = (
      '/* qryParcelasPrestacoesAbertasResumo */ ('
      '   select'
      '   f.nome as nomefilialvenda,'
      '   gf.codigo as grupofilialvenda,'
      '   gf.descricao  as nomegrupofilialvenda,'
      '   contratosparcelas.*'
      '  from'
      '  ('
      '    select'
      '         ct.cliente,'
      '         ct.tipocliente,'
      '         ct.filialvenda,'
      '         ct.vendedor,'
      '         u.nome as nomevendedor,'
      '         parcelas.*'
      '    from'
      
        '    (contratos ct left join usuarios u on ct.vendedor = u.codigo' +
        '),'
      '   ('
      '    Select    p.contrato,'
      
        '                 p.datavencto,  /* defini'#231#227'o do m'#237'nimo ou todos ' +
        '*/'
      '                 p.valorvencto'
      '     From     parcelas p'
      '     where    p.datapagto is null'
      '       %WherePeriodoVencto'
      '     %GroupBy'
      '   ) as parcelas'
      '    Where ct.numero=parcelas.contrato and'
      
        '           ct.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39') and contratos_atual(ct.n' +
        'umero) '
      
        '           %WherePeriodoVenda /*and  ct.faturamento between (:Ve' +
        'ndainicial) and (:VendaFinal)*/'
      '           %WhereCliente'
      '           %WhereFiliais'
      '           %WhereAgentes'
      '           %WhereConceitos'
      '           %WhereVendedor'
      '           %WhereCartaDevolvida'
      '           %WhereOcorrenciaCobranca'
      '           %WherePrimeiraCompra'
      '           %WhereSemPagamento'
      
        '   ) as contratosparcelas  LEFT JOIN  vfornecedores vf  on vf.co' +
        'digo=cliente and vf.tipo=tipocliente'
      
        '                                    LEFT JOIN (filiais f left jo' +
        'in (filiaisgruposfiliais fgf left join gruposfiliais gf on fgf.g' +
        'rupo=gf.codigo)'
      
        '                                                                ' +
        '                                   on f.codigo=fgf.filial)'
      
        '                                                                ' +
        'on f.codigo=filialvenda'
      '  %WhereRegiao'
      '  %WhereEndereco'
      '  %OrderBy'
      ')')
    RequestLive = False
    Left = 433
    Top = 262
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'Vendainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'VendaFinal'
        ParamType = ptUnknown
      end>
