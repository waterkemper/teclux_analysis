        DataType = ftUnknown
        Name = 'WhereRegiao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereEndereco'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '('
      '  select contratosparcelas.*'
      '  from'
      '  ('
      '    select  ct.cliente,'
      '              ct.tipocliente,'
      '              ct.filialvenda,'
      '              ct.vendedor,'
      '              u.nome as nomevendedor,'
      '              parcelas.*'
      '    from'
      
        '    (contratos ct left join usuarios u on ct.vendedor = u.codigo' +
        '),'
      '   ('
      '    Select    p.contrato'
      '     From     parcelas p'
      '     where    p.datapagto is null'
      '       %WherePeriodoVencto'
      ''
      '                 group by p.contrato'
      '   ) as parcelas'
      '    Where ct.numero=parcelas.contrato and'
      
        '           ct.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39') and contratos_atual(ct.n' +
        'umero)'
      '           %WherePeriodoVenda'
      '           %WhereCliente'
      '           %WhereFiliais'
      '           %WhereAgentes'
      '           %WhereConceitos'
      '           %WhereVendedor'
      '           %WhereCartaDevolvida'
      '           %WhereOcorrenciaCobranca'
      '           %WherePrimeiraCompra'
      '           %WhereSemPagamento'
      
        '   ) as contratosparcelas  /*LEFT*/ JOIN vfornecedores vf  on vf' +
        '.codigo=cliente and vf.tipo=tipocliente'
      '  where true '
      '  %WhereRegiao'
      '  %WhereEndereco'
      'order by filialvenda, cliente, tipocliente, contrato'
      ')')
    RequestLive = False
    Left = 433
    Top = 158
