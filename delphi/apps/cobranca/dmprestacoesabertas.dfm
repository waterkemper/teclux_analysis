  object qryParcelas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'cliente=cliente;tipocliente=tipocliente;contrato=contrato'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrContratos
    Constraints = <>
    OnCalcFields = qryParcelasCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WherePeriodoVencto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'GroupBy'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WherePeriodoVenda'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereCliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereAgentes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereConceitos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereVendedor'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereCartaDevolvida'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereOcorrenciaCobranca'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WherePrimeiraCompra'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereSemPagamento'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereRegiao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereEndereco'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '/* qryParcelas */ ('
      
        '  select contratosparcelas.*, notas_notasdocontrato(contratospar' +
        'celas.contrato) as notas'
      '  from'
      '  ('
      '    select'
      '         ct.cliente,'
      '         ct.tipocliente,'
      '         ct.filialvenda,'
      '         ct.vendedor,'
      '         u.nome as nomevendedor,'
      
        '         Extract (Day From (parcelas.datavencto - Now() )) as At' +
        'raso,'
      '         parcelas.*'
      '    from'
      
        '    (contratos ct left join usuarios u on ct.vendedor = u.codigo' +
        '),'
      '   ('
      '    Select    p.contrato,'
      '                 p.numero,'
      
        '                 p.datavencto,  /* defini'#231#227'o do m'#237'nimo ou todos ' +
        '*/'
      '                 p.valorvencto'
      '     From     parcelas p'
      '     where    p.datapagto is null'
      '       %WherePeriodoVencto'
      '     %GroupBy'
      '   ) as parcelas'
      '    Where ct.numero=parcelas.contrato and'
      
        '           ct.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39') and contratos_atual(ct.n' +
        'umero)'
      
        '           %WherePeriodoVenda /*and  ct.faturamento between (:Ve' +
        'ndainicial) and (:VendaFinal)*/'
      '           %WhereCliente'
      '           %WhereFiliais'
      '           %WhereAgentes'
      '           %WhereConceitos'
      '           %WhereVendedor'
      '           %WhereCartaDevolvida'
      '           %WhereOcorrenciaCobranca'
      '           %WherePrimeiraCompra'
      '           %WhereSemPagamento'
      
        '   ) as contratosparcelas  /*LEFT*/ JOIN vfornecedores vf  on vf' +
        '.codigo=cliente and vf.tipo=tipocliente'
      '  %WhereRegiao'
      '  %WhereEndereco'
      'order by contrato, datavencto, numero'
      ')')
    RequestLive = False
    Left = 433
    Top = 214
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'Vendainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'VendaFinal'
        ParamType = ptUnknown
      end>
    object qryParcelascliente: TIntegerField
      FieldName = 'cliente'
      DisplayFormat = '0'
    end
    object qryParcelastipocliente: TStringField
      FieldName = 'tipocliente'
      Size = 1
    end
