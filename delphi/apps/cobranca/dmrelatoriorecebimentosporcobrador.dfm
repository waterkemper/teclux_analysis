  object qryRecebimentos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select p.contrato,'
      '           p.parcelaorigem,'
      '           p.valorpagto,'
      '           p.datapagto,'
      '           c.data,'
      '           c.cliente,'
      '           cl.nome as nomecliente,'
      '           uc.data as datacobranca,'
      '           uc.usuario,'
      '           u.nome as nomecobrador'
      
        'From   parcelas p, contratos c, clientes cl, usuarioscontratos u' +
        'c, usuarios u'
      'Where '
      '  /*                Data Pagamento   */ '
      '  /*                Filial                       */'
      
        '           and (p.datapagto between uc.data and  coalesce(uc.ret' +
        'orno, (select uc2.data-1'
      
        '                                                                ' +
        '                                            from usuarioscontrat' +
        'os uc2'
      
        '                                                                ' +
        '                                            where uc2.contrato =' +
        ' c.numero and'
      
        '                                                                ' +
        '                                                       uc2.data ' +
        '> uc.data'
      
        '                                                                ' +
        '                                            order by uc2.data li' +
        'mit 1),current_date))'
      '           and (p.contrato = c.numero)'
      '  /*                 Agente                   */'
      '           and (c.cliente = cl.codigo)'
      '           and (uc.contrato = c.numero)'
      '           and (uc.usuario = u.codigo)'
      '           and (uc.retorno is null)'
      '  /*                 Cobrador               */'
      '  /*           Ordenacao           */ ')
    RequestLive = True
    Left = 72
    Top = 217
    object qryRecebimentoscontrato: TStringField
      FieldName = 'contrato'
    end
    object qryRecebimentosparcelaorigem: TStringField
      FieldName = 'parcelaorigem'
      Size = 7
    end
    object qryRecebimentosvalorpagto: TFloatField
      FieldName = 'valorpagto'
      DisplayFormat = '0.00'
    end
    object qryRecebimentosdatapagto: TDateField
      Alignment = taCenter
      FieldName = 'datapagto'
      EditMask = '99/99/9999;1; '
    end
    object qryRecebimentosdata: TDateField
      Alignment = taCenter
      FieldName = 'data'
      EditMask = '99/99/9999;1; '
    end
    object qryRecebimentoscliente: TIntegerField
      FieldName = 'cliente'
      DisplayFormat = '0'
    end
    object qryRecebimentosnomecliente: TStringField
      FieldName = 'nomecliente'
      Size = 40
    end
    object qryRecebimentosdatacobranca: TDateField
      Alignment = taCenter
      FieldName = 'datacobranca'
      EditMask = '99/99/9999;1; '
    end
