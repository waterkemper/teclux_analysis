      end;
//      AcertarNumeroParcelas;  BUG #2783  Pq alterar o numero da parcela se a ordenacao se da pela datavencto ou parcelaorigem?
      RecalcularParcelaOrigem
    end;
  finally
    qryParcelas.EnableControls;
  end;
end;

