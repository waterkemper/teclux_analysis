      '            vf.bairro,'
      '            vf.cep,'
      '            vf.estado,'
      '            vf.cidade,'
      
        '            case when c.tipocliente='#39'C'#39' then (select cl.nome fro' +
        'm clientes cl where cl.codigo=(select cl2.conjuge from clientes ' +
        'cl2 where cl2.codigo=c.cliente)) else cast(null as varchar) end ' +
        'as conjuge,'
      
        '            case when c.tipocliente='#39'C'#39' then (select cl.nascto f' +
