      end>
    Sql.Strings = (
      'insert into spc (carta, bloqueada)'
      '('
      ' select carta,'
      
        '          ObterTiposBloqueios(false, false, SemAviso) as bloquea' +
        'da'
      ' from'
      ' ('
      '  select ContratosParcelas.*,'
      '  (SELECT semspc'
      '   FROM atendimentos'
      '   WHERE semspc >= current_date AND'
      '               tipo = '#39'C'#39' AND'
      '               NOT concluido AND'
      
        '               ((atendimentos.cliente = ContratosParcelas.client' +
        'e AND atendimentos.tipocliente = ContratosParcelas.tipocliente) ' +
        'OR'
      
        '                (atendimentos.cliente = coalesce(ContratosParcel' +
        'as.avalista,0) AND atendimentos.tipocliente = '#39'C'#39'))'
      '   ORDER BY data DESC LIMIT 1) as SemAviso'
      '   from'
      '  ('
      '   select parcelas_spc.*'
      '   from ('
      '              ('
      
        #9' select distinct c.cliente, c.tipocliente, c.tipocarta, cc.cart' +
        'a, cc.numero, c.avalista'
      
        #9' from ((parcelas p join contratos on p.contrato = contratos.num' +
        'ero) join (cartasclientes cc'
      
        '                           join (cartas c join tiposcartas tc on' +
        ' c.tipocarta = tc.codigo)'
      #9#9#9#9'              on cc.carta = c.numero)'
      
        '                   on p.cartacliente = cc.carta and p.cartanumer' +
        'ocliente = cc.numero)'
      #9' where p.spccliente is null'
      #9'   and cc.enviada is not null'
      #9'   and coalesce(cc.bloqueada,'#39#39')='#39#39
      #9'   and tc.tipo = '#39'S'#39' '
      '           %InscreveSPCClienteCartaDevolvida'
      #9'   %FiltroConfirmacao'
      '      '#9'   %ConfirmaRecebimentoAvisoSPC'
      '           %WhereFilialVenda'
      #9' )'
      #9' union'
      #9' ('
      
        #9' select distinct c.cliente, c.tipocliente, c.tipocarta, cc.cart' +
        'a, cc.numero, c.avalista'
      
        #9' from ((parcelas p join contratos on p.contrato = contratos.num' +
        'ero) join (cartasclientes cc'
      
        '                           join (cartas c join tiposcartas tc on' +
        ' c.tipocarta = tc.codigo)'
      #9#9#9#9'              on cc.carta = c.numero)'
      
        '                   on p.cartaavalista = cc.carta and p.cartanume' +
        'roavalista = cc.numero)'
      #9' where p.spcavalista is null'
      #9'   and cc.enviada is not null'
      #9'   and coalesce(cc.bloqueada,'#39#39')='#39#39
      #9'   and tc.tipo = '#39'S'#39
      #9'   %InscreveSPCClienteCartaDevolvida'
      #9'   %FiltroConfirmacao'
      #9'   %ConfirmaRecebimentoAvisoSPC'
      '           %WhereFilialVenda'
      #9' )'
      #9') as parcelas_spc'
      
        '   where CURRENT_DATE > coalesce((select spc.dataexclusao + cast' +
        '(:ndiasNovaInscricao as integer)'
      
        '                                  from (spc join cartas on spc.c' +
        'arta = cartas.numero)'
      
        '                                  where cartas.cliente = parcela' +
        's_spc.cliente and'
      
        '                                        cartas.tipocliente = par' +
        'celas_spc.tipocliente and'
      
        '                                        cartas.tipocarta = parce' +
        'las_spc.tipocarta and'
      
        '                                        coalesce(cartas.avalista' +
        ',0) = coalesce(parcelas_spc.avalista,0) and'
      
        '                                        spc.dataexclusao is not ' +
        'null'
      
        #9#9#9'          order by spc.dataexclusao desc limit 1), cast('#39'01/0' +
        '1/1901'#39' as date))'
      '  ) as ContratosParcelas'
      ' ) as ContratosParcelasAtendimentos'
      ')')
    RequestLive = True
