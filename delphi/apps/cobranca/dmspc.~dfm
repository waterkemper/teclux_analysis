    Sql.Strings = (
      'select rc.*,'
      '         ra.*'
      'from'
      ' ('
      '  select srdc.spc,'
      '         srdc.operacao,'
      '         srdc.remessa,'
      '         srdc.pessoanumero as CPF_cliente,'
      '         srdc.documento as RG_cliente,'
      '         srdc.idestado as UFRG_cliente,'
      '         srdc.nome as nome_cliente,'
      '         srdc.nascto as nascto_cliente, '
      '         srdc.cargo as cargo_cliente, '
      '         srdc.empresa as empresa_cliente,'
      '         (select c.nome'
      #9'  from cidades c'
      #9'  where c.estado = srdc.naturalestado and'
      
        #9'        c.codigo = srdc.naturalcidade) as naturalcidade_cliente' +
        ','
      '         srdc.naturalestado as naturalestado_cliente,'
      '         srdc.sexo as sexo_cliente,'
      #9' srdc.pai as pai_cliente,'
      #9' srdc.mae as mae_cliente,'
      #9' srdc.civil as estadocivil_cliente,'
      #9' srdc.conjuge as conjuge_cliente,'
      #9' srdc.connascto as connascto_cliente,'
      '   srdc.rua as rua_cliente,'
      '   srdc.numero as numerorua_cliente,'
      '   srdc.complemento as complementoendereco_cliente,'
      #9' (select b.nome'
      #9'  from bairros b'
      #9'  where b.estado = srdc.estado and'
      #9'        b.cidade = srdc.cidade and'
      #9#9'b.codigo = srdc.bairro) as bairro_cliente,'
      '         srdc.cep as cep_cliente,'
      '         (select c.nome'
      #9'  from cidades c'
      #9'  where c.estado = srdc.estado and'
      #9'        c.codigo = srdc.cidade) as cidade_cliente,'
      '         srdc.estado as estado_cliente,'
      ''
      '         srdc.datacompra,'
      '         srdc.valordebito,'
      '         srdc.datavencto,'
      ''
      '         (select f.razao '
      '          from filiais f'
      '          where codigo = (select filialremetente '
      '                                  from remessaspc '
      
        '                                  where numero = srdc.remessa)) ' +
        'as associada,'
      ''
      '         (select f.spc_destinatario'
      '          from filiais f'
      '          where codigo = (select filialremetente'
      '                                  from remessaspc'
      
        '                                  where numero = srdc.remessa)) ' +
        'as spc_destinatario,'
      ''
      '        srdc.foneddd as foneddd_cliente,'
      '        srdc.fonenumero as fonenumero_cliente'
      ''
      '  from (spcremessadados srdc Join cartasclientes cc on'
      '            srdc.carta = cc.carta and'
      #9'    srdc.cartanumero = cc.numero)'
      '  where not cc.eavalista and srdc.pessoatipo = '#39'J'#39
      '        %ListaSPCSelecionados_srdc'
      '        and srdc.remessa = :remessa'
      ' ) as rc left join'
      '  ('
      '  select distinct p.spccliente as spc_a,'
      '         srdv.operacao as operacao_a,'
      '         srdv.remessa as remessa_a,'
      '         srdv.pessoanumero as CPF_avalista,'
      '         srdv.documento as RG_avalista,'
      '         srdv.idestado as UFRG_avalista,'
      '         srdv.nome as nome_avalista,'
      
        '         srdv.nascto as nascto_avalista, srdv.cargo as cargo_ava' +
        'lista, srdv.empresa as empresa_avalista,'
      '         (select c.nome'
      #9'  from cidades c'
      #9'  where c.estado = srdv.naturalestado and'
      
        #9'        c.codigo = srdv.naturalcidade) as naturalcidade_avalist' +
        'a,'
      '         srdv.naturalestado as naturalestado_avalista,'
      '         srdv.sexo as sexo_avalista,'
      #9' srdv.pai as pai_avalista,'
      #9' srdv.mae as mae_avalista,'
      #9' srdv.civil as estadocivil_avalista,'
      #9' srdv.conjuge as conjuge_avalista,'
      #9' srdv.connascto as connascto_avalista,'
      '   srdv.rua as rua_avalista,'
      '   srdv.numero as numerorua_avalista,'
      '   srdv.complemento as complementoendereco_avalista,'
      ''
      #9' (select b.nome'
      #9'  from bairros b'
      #9'  where b.estado = srdv.estado and'
      #9'        b.cidade = srdv.cidade and'
      #9#9'b.codigo = srdv.bairro) as bairro_avalista,'
      '         srdv.cep as cep_avalista,'
      '         (select c.nome'
      #9'  from cidades c'
      #9'  where c.estado = srdv.estado and'
      #9'        c.codigo = srdv.cidade) as cidade_avalista,'
      '         srdv.estado as estado_avalista,'
      ''
      '        srdv.foneddd as foneddd_avalista,'
      '        srdv.fonenumero as fonenumero_avalista'
      ''
      
        '  from (spcremessadados srdv Join cartasclientes cc on  srdv.car' +
        'ta = cc.carta and'
      
        #9'                                                srdv.cartanumer' +
        'o = cc.numero)'
      '                  join'
      '                     ('
      '                      ('
      #9#9'       select distinct p.spccliente, srdv.spc'
      
        #9#9'       from ((spcremessadados srdv join cartasclientes cc on s' +
        'rdv.carta = cc.carta and'
      
        #9#9'                                                          srdv' +
        '.cartanumero = cc.numero)'
      
        #9#9'                                join parcelas p on p.spcavalis' +
        'ta = srdv.spc)'
      #9#9'       where cc.eavalista'
      #9#9'         and srdv.remessa = :remessa'
      #9#9'         and p.spccliente is not null'
      '                         %ListaSPCSelecionados'
      #9#9'      )'
      '                      union all'
      #9#9'      ('
      
        '                       select distinct pc.spc as spccliente, ava' +
        'lista_spc.spc'
      #9#9'       from'
      #9#9'       ('
      #9#9'        select pc.contratoparcela, pc.parcela, srdv.spc'
      
        ' '#9#9'        from ((spcremessadados srdv join cartasclientes cc on' +
        ' srdv.carta = cc.carta and'
      
        ' '#9#9'                                                          srd' +
        'v.cartanumero = cc.numero)'
      
        '                                                 join parcelasca' +
        'rtas pc on pc.spc = srdv.spc and'
      #9#9#9#9#9#9'                           pc.carta = srdv.carta and'
      #9#9#9#9#9#9#9#9#9'   pc.cartanumero = srdv.cartanumero)'
      '                        where cc.eavalista'
      #9#9#9'  and srdv.remessa = :remessa'
      '                         %ListaSPCSelecionados'
      
        #9#9'       ) as avalista_spc join (parcelascartas pc join cartascl' +
        'ientes cc2 on pc.carta = cc2.carta and'
      
        '                                                                ' +
        '                           pc.cartanumero = cc2.numero)'
      
        #9#9'                                                 on pc.contrat' +
        'oparcela=avalista_spc.contratoparcela and'
      
        '                                                                ' +
        '  pc.parcela = avalista_spc.parcela'
      '                       where not cc2.eavalista'
      #9#9'      )'
      #9#9'     ) as p on srdv.spc = p.spc'
      ''
      '  where cc.eavalista'
      '        %ListaSPCSelecionados'
      '        and srdv.remessa = :remessa'
      ''
      '  ) as ra on rc.spc = ra.spc_a and'
      #9'     rc.operacao = ra.operacao_a and'
      '             rc.remessa = ra.remessa_a'
      'order by UPPER(TO_ASCII(rc.nome_cliente,'#39'LATIN1'#39'))')
