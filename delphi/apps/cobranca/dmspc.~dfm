    Sql.Strings = (
      ';select spc.* from'
      '('
      'select'
      ' spc.numero,'
      
        ' spc.carta, spc.datainclusao, spc.dataexclusao, spc.registradosp' +
        'c,'
      ' c.avalista,'
      ' c.cliente,'
      ' c.tipocliente,'
      
        ' (select coalesce(vf.razao,vf.nome) as nome  from vfornecedores ' +
        'vf where c.cliente=vf.codigo and c.tipocliente=vf.tipo) as nomec' +
        'liente,'
      
        ' (select tc.tipoatendimento from tiposcartas tc where tc.codigo ' +
        '= c.tipocarta) as tipoatendimento, '
      
        ' (select coalesce(vf.razao,vf.nome) as nome  from vfornecedores ' +
        'vf where c.avalista=vf.codigo and vf.tipo='#39'C'#39') as nomeavalista,'
      ''
      ' spc.bloqueada,'
      ' (case when exists (select spccliente '
      
        '                    from parcelas where parcelas.spccliente = sp' +
        'c.numero) then false else'
      '  (case when exists (select spcavalista'
      
        '                     from parcelas where parcelas.spcavalista = ' +
        'spc.numero) then false else'
      '   (case when :VerificarPagto and exists (select pc.spc '
      
        '                                                            from' +
        ' (parcelascartas pc join parcelas p '
      
        '                                                                ' +
        ' on  pc.contratoparcela = p.contrato and '
      
        '                                                                ' +
        '     pc.parcela = p.numero)'
      
        '                                                            wher' +
        'e pc.spc = spc.numero and '
      
        '                                                                ' +
        '  p.datapagto = CURRENT_DATE)'
      '     then false else true end) end) end) as obsoleta,'
      ' false as marcar,'
      ' cast(0 as numeric) as valor,'
      ' false as Verificado'
      'from (spc join cartas c on spc.carta = c.numero)'
      ' /* Wheres */'
      ') as spc'
      'Where spc.obsoleta'
      
        'order by UPPER(TO_ASCII(nomecliente,'#39'LATIN1'#39')), cliente, tipocli' +
        'ente, avalista')
