        '                                                             sub' +
        'str(vf.pessoanumero, 6,3)||'#39'/'#39'||'
      
        '                                                             sub' +
        'str(vf.pessoanumero, 9,4)||'#39'-'#39'||'
      
        '                                                             sub' +
        'str(vf.pessoanumero, 13,2)'
      '         end as varchar) as pessoanumero,'
      '       tipo,'
      '       cast(case when tipo = '#39'F'#39' then '#39'Fornecedor'#39
      '                       when tipo = '#39'C'#39' then '#39'Cliente'#39
      '               end as varchar) as tipoorig,'
      '       (select nome'
