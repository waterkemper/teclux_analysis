    Sql.Strings = (
      'select  '
      ' sr.operacao,'
      ' sr.remessa,  '
      ' sr.rejeitada,'
      ' case when exists (select srd.dataspc '
      '                           from spcremessadados srd'
      '                           where srd.spc = sr.spc and'
      
        '                                     srd.operacao = sr.operacao ' +
        'and'
      
        '                                     srd.remessa = sr.remessa an' +
        'd'
      
        '                                     srd.dataspc is not null) th' +
        'en '
      '   (select dataenvio '
      '    from remessaspc '
      '    where remessaspc.numero = sr.remessa) '
      ' else'
      '   cast(null as date) end as dataenvio,'
      '  case when (((select count(*)'
      '                    from parcelas p'
      '                    where p.spcavalista = sr.spc and'
      '                             p.spccliente <> sr.spc) +'
      '                    (select count(*)'
      
        '                     from parcelascartas pc join cartasclientes ' +
        'cc on pc.carta = cc.carta and pc.cartanumero = cc.numero'
      
        '                     where pc.spc = sr.spc and cc.eavalista))<>0' +
        ') then cast('#39'A'#39' as char(1)) else cast('#39'C'#39' as char(1)) end as tip' +
        'o'
      'from spcremessa sr'
      'where sr.spc=:spc'
      'order by sr.remessa desc, sr.operacao desc')
