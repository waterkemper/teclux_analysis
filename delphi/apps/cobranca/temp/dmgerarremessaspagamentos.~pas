  Close(Arq);

  Perpetrar([qryAtualizarParcelas,qryContas]);
  qryParcelas.EnableControls;

//  qryParcelas.Close;
  MensagemAviso(format(ctARQUIVOGERADOSUCESSO,[NomeArquivo]));
