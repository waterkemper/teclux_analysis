procedure TdtmGerarRemessasPagamentos.GravarHeaderHSBC(var Arq);
Var Arquivo: File Absolute Arq;
    Ano, Mes, Dia: Word;
    DatAStr, NomeFil, AgenciaStr: String;
    NrRemessa, AgenciaInt: Integer;
    HeaderHSBC: T_HeaderHSBC;
    ContaStr: String;
Begin
  with HeaderHSBC do begin
    DecodeDate(Now, Ano, Mes, Dia);
    DataStr := Format('%.2d',[Dia]) + Format('%.2d',[Mes]) + Copy(Format('%.2d',[Ano]),3,2);
    NomeFil := qryParcelasNomeFilial.AsString;
    NrRemessa := qryContasSequencial.AsInteger;

    AgenciaStr := IntToStr(qryContasAgencia.AsInteger);
    AgenciaStr := preencheString(AgenciaStr,'0',4,false);
    AgenciaInt := StrToInt(AgenciaStr);

    ContaStr   := IntToStr(qryContasConta.AsInteger);
    ContaStr   := preencheString(ContaStr,'0',6,false);

    FillChar(HeaderHSBC,SizeOf(HeaderHSBC),'0');
    MoveStr('0',             H_TipoRegistro,     SizeOf(H_TipoRegistro));
    MoveStr('1',             H_TipoArquivo,      SizeOf(H_TipoArquivo));
    MoveStr('REMESSA',       H_LiteralArquivo,   SizeOf(H_LiteralArquivo));
    MoveStr('01',            H_CodigoServico,    SizeOf(H_CodigoServico));
    MoveStr('COBRANCA',      H_LiteralServico,   SizeOf(H_LiteralServico));
    MoveStr('0',             H_Zero,             SizeOf(H_Zero));
    MoveStr(AgenciaStr,      H_AgenciaCliente,   SizeOf(H_AgenciaCliente));
    MoveStr('55',            H_SubConta,         SizeOf(H_SubConta));
    MoveStr(AgenciaStr+ContaStr+qryContasDigito.AsString,
                             H_ContaCorrente,    SizeOf(H_ContaCorrente));
    MoveStr('  ',            H_Banco1,           SizeOf(H_Banco1));
    MoveStr(RazaoFilialBase, H_NomeCliente,      SizeOf(H_NomeCliente));
    MoveStr('399',           H_CodigoBanco,      SizeOf(H_CodigoBanco));
    MoveStr('HSBC',          H_NomeBanco,        SizeOf(H_NomeBanco));
    MoveStr(DataStr,
                             H_DataGravacao,     SizeOf(H_DataGravacao));
    MoveStr('01600',         H_DensidadeGravacao,SizeOf(H_DensidadeGravacao));
    MoveStr('BPT',           H_LiteralDensidade, SizeOf(H_LiteralDensidade));
    MoveStr('  ',            H_Banco2,           SizeOf(H_Banco2));
    MoveStr('LANCV08',       H_SiglaLayout,      SizeOf(H_SiglaLayout));
    MoveStr('',              H_Banco3,           SizeOf(H_Banco3));
    MoveStr('',              H_Banco4,           SizeOf(H_Banco4));
    MoveStr('000001',        H_Sequencial,       SizeOf(H_Sequencial));
    MoveCrLf(CrLf,                H_CrLf,             SizeOf(H_CrLf));
    BlockWrite(Arquivo,HeaderHSBC,1);

  end;
End;

procedure TdtmGerarRemessasPagamentos.GravarDetalhesHSBC(var Arq);
Var Arquivo:  File Absolute Arq;
    DetalhesHSBC: T_DetalheHSBC;
    NumInsc:  Integer;           CepInt:        Integer;
    CepStr: String[8];           Empr :    String;            AnoStr: String;
    DataVenctoStr: String;       Ano, Mes, Dia: Word;
    Participante: String;        AgenciaStr: String;          AgenciaInt: Integer;
    CodInsc: String;             ContaStr:   String;
Begin
  with DetalhesHSBC  do begin
     if qryFiliaisINSCRICAOESTADUAL.AsString <> '' then NumInsc := 1
                                                   else NumInsc := 98;

     AgenciaStr := IntToStr(qryContasAgencia.AsInteger);
     AgenciaStr := preencheString(AgenciaStr,'0',4,false);
     AgenciaInt := StrToInt(AgenciaStr);

     ContaStr   := IntToStr(qryContasConta.AsInteger);
     ContaStr   := preencheString(ContaStr,'0',6,false);

     Empr:='0000070'+Format('%.5d',[AgenciaInt])+
                                    Format('%.7d',[qryContasConta.AsInteger]) +
                                    qryContasDigito.AsString;

     DecodeDate(qryParcelasDATAVENCTO.AsDateTime,Ano, Mes, Dia);
     AnoStr := IntToStr(Ano);
     AnoStr := Copy(AnoStr,3,2);
     Ano    := StrToInt(AnoStr);
     DataVenctoStr := Format('%.2d',[Dia]) + Format('%.2d',[Mes]) + Format('%.2d',[Ano]);

     FillChar(DetalhesHSBC,SizeOf(DetalhesHSBC),'0');

     MoveStr('1',                     D_TipoRegistro,     SizeOf(D_TipoRegistro));
     MoveNro(NumInsc,                 D_CodigoInscricao,  SizeOf(D_CodigoInscricao));
     MoveStr(qryFiliaisCnpj.AsString, D_CPF_CNPJ,         SizeOf(D_CPF_CNPJ));
     MoveStr('0',                     D_Zero,             SizeOf(D_Zero));
     MoveStr(AgenciaStr,              D_AgenciaCedente,   SizeOf(D_AgenciaCedente));
     MoveStr('55',                    D_SubConta,         SizeOf(D_SubConta));
     MoveStr(AgenciaStr+ContaStr+qryContasDigito.AsString,
                                      D_ContaCorrente,    SizeOf(D_ContaCorrente));
     MoveStr('  ',          D_Brancos1,         SizeOf(D_Brancos1));
     MoveStr('',            D_Participante,     SizeOf(D_Participante));
     MoveStr('00000000000', D_NossoNumero,      SizeOf(D_NossoNumero));
     MoveStr('000000',      D_DataLimiteDescto2,SizeOf(D_DataLimiteDescto2));
     MoveStr('00000000000', D_ValorDesconto2,   SizeOf(D_ValorDesconto2));
     MoveStr('000000',      D_DataLimiteDescto3,SizeOf(D_DataLimiteDescto3));
     MoveStr('00000000000', D_ValorDesconto3,   SizeOf(D_ValorDesconto3));
     MoveStr('1',           D_TipoCarteira,     SizeOf(D_TipoCarteira));
     MoveStr('01',          D_CodigoOcorrencia, SizeOf(D_CodigoOcorrencia));

     MoveStr(NrDocumentoEmpresa,  D_SeuNumero,       SizeOf(D_SeuNumero));

     MoveStr(DataVenctoStr,
                              D_DataVencto,     SizeOf(D_DataVencto));
     MoveVal(qryParcelasVALORVENCTO.Value, D_ValorTitulo,    SizeOf(D_ValorTitulo));
     MoveStr('399',           D_BancoCobrador,  SizeOf(D_BancoCobrador));
     MoveStr('00000',         D_AgenciaDepositaria,SizeOf(D_AgenciaDepositaria));
     MoveStr('09',            D_Especie,        SizeOf(D_Especie));
     MoveStr('N',             D_Aceite,         SizeOf(D_Aceite));
     MoveStr(FormatDateTime('DDMMYY',qryParcelasFaturamento.AsDateTime),
                              D_DataEmissao,    SizeOf(D_DataEmissao));
     MoveStr('00',            D_Instrucao01,    SizeOf(D_Instrucao01));
     MoveStr('00',            D_Instrucao02,    SizeOf(D_Instrucao02));
     MoveStr('0000000000000' ,D_JurosMoraDia,   SizeOf(D_JurosMoraDia));
     MoveStr('000000',        D_DataLimiteDescto,SizeOf(D_DataLimiteDescto));
     MoveStr('0000000000000', D_ValorDescto,    SizeOf(D_ValorDescto));
     MoveStr('0000000000000', D_ValorIOF,       SizeOf(D_ValorIOF));
     MoveStr('0000000000000', D_ValorAbatimento,SizeOf(D_ValorAbatimento));

     if qryParcelasPessoaTipo.AsString = 'J' then
        CodInsc :=  '02'               {cnpj}
     Else
        If qryParcelasPessoaTipo.AsString = 'F' then
           CodInsc := '01'             {cpf}
        Else CodInsc := '99';          {outros}

     MoveStr(CodInsc,       D_TipoInscrSacado,SizeOf(D_TipoInscrSacado));
     MoveStr(qryParcelasCNPJouCPF.AsString,          D_CPF_CNPJ_Sacado,  SizeOf(D_CPF_CNPJ_Sacado));

     MoveStr(qryParcelasNome.AsString,        D_NomeSacado,             SizeOf(D_NomeSacado));
     MoveStr(qryParcelasRua.AsString,         D_EnderecoSacado,         SizeOf(D_EnderecoSacado));
     MoveStr('',               D_InstrucaoNaoRecbto, SizeOf(D_InstrucaoNaoRecbto));
     MoveStr(qryParcelasNomeBairro.AsString,           D_BairroSacado,   SizeOf(D_BairroSacado));

     if qryParcelasCEP.AsInteger = 0 then begin
        MoveNro(0, D_CepSacado,       SizeOf(D_CepSacado));
        MoveNro(0, D_SufixoCepSacado, SizeOf(D_SufixoCepSacado));
     end
     else begin
        CepStr := FStr(qryParcelasCEP.AsInteger,$81);
        CepStr := Copy(CepStr,1,5);
        CepInt := StrToInt(CepStr);
        CepStr := Format('%.5d',[CepInt]);
        MoveStr(CepStr,                          D_CepSacado,              SizeOf(D_CepSacado));
        CepStr := FStr(qryParcelasCEP.AsInteger,$81);
        CepStr := Copy(CepStr,6,3);
        if CepStr <> '' then begin
           CepInt := StrToInt(CepStr);
           CepStr := Format('%.3d',[CepInt]);
           MoveStr(CepStr,                    D_SufixoCepSacado,             SizeOf(D_SufixoCepSacado));
        end else
           MoveNro(0,                         D_SufixoCepSacado,             SizeOf(D_SufixoCepSacado));
     end;

     MoveStr(qryParcelasNomeCidade.AsString,  D_CidadePagtoSacado, SizeOf(D_CidadePagtoSacado));

     MoveStr(qryParcelasEstado.AsString,           D_EstadoSacado,       SizeOf(D_EstadoSacado));
     MoveStr('',               D_AvalistaOUSacador,  SizeOf(D_AvalistaOUSacador));
     MoveStr('E',              D_TipoBloqueto,       SizeOf(D_TipoBloqueto));
     MoveStr('',               D_PrazoProtesto,      SizeOf(D_PrazoProtesto));
     MoveStr('9',              D_TipoMoeda,          SizeOf(D_TipoMoeda));

     if Seq = 0 then
        Seq := 1;

     Inc(Seq);
     MoveNro(Seq,                          D_Sequencial,             SizeOf(D_Sequencial));
     MoveCrLf(CrLf,                        D_CrLf,                      SizeOf(D_CrLf));

     BlockWrite(Arquivo,DetalhesHSBC,1);
   end;
End; {GravarDetalhesBradesco}

