    MoveNro(AgenciaInt,             HL_AGENCIA_MANTENEDORA_CONTA,       SizeOf(HL_AGENCIA_MANTENEDORA_CONTA));
    MoveStr(DigAgeStr,              HL_DIGITO_AGENCIA,                  SizeOf(HL_DIGITO_AGENCIA));
