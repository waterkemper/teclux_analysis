procedure TdtmGerarRemessasPagamentos.MarcarSelecionados(Marcando, Todos: Boolean);
var Pos: TBookmark;
    I  : Integer;

    procedure AtualizarValores;
    begin
       if qryParcelasSelecionar.AsBoolean then begin
          FQtdeMarcados  := FQtdeMarcados  + 1;
          FTotalMarcados := FTotalMarcados + qryParcelasValorVencto.AsCurrency;
       end
       else begin
          FQtdeMarcados  := FQtdeMarcados  - 1;
          FTotalMarcados := FTotalMarcados - qryParcelasValorVencto.AsCurrency;
       end;
    end;

begin
   with qryParcelas do
      if not IsEmpty
      then if not Todos then begin
              Edit;
              qryParcelasSelecionar.AsBoolean:= not qryParcelasSelecionar.AsBoolean;
              Post;
              AtualizarValores;
           end
           else begin
              Pos:= GetBookmark;
              try
                 DisableControls;
                 First;
                 for I:= 1 to RecordCount do begin
                     Edit;
                     if Marcando then begin
                        if not qryParcelasSelecionar.AsBoolean then begin
                           qryParcelasSelecionar.AsBoolean := True;
                           AtualizarValores;
                        end
                     end
                     else begin
                        if qryParcelasSelecionar.AsBoolean then begin
                           qryParcelasSelecionar.AsBoolean:= False;
                           AtualizarValores;
                        end;
                     end;
                     Post;
                     Next;
                 end;
              finally
                 GotoBookmark(Pos);
                 FreeBookmark(Pos);
                 EnableControls;
              end;
           end;
end;


procedure TdtmGerarRemessasPagamentos.AtualizarParcelas;
var
  Flag : Boolean;
begin
  Flag := False;
  qryParcelas.DisableControls;
  qryParcelas.First;
  while not qryParcelas.Eof do begin
    if qryParcelasSelecionar.AsBoolean then begin
      Flag := True;

      qryParcelas.Edit;
      qryParcelasContaBoleto.AsString := qryContasConta.AsString;
      qryParcelas.Post;
{
      qryAtualizarParcelas.ParamByName('contaboleto').AsInteger := qryContasConta.AsInteger;
      qryAtualizarParcelas.ParamByName('Contrato').AsString     := qryParcelasContrato.AsString;
      qryAtualizarParcelas.ParamByName('Numero').AsInteger      := qryParcelasNumero.AsInteger;
      qryAtualizarParcelas.ExecSql;
}
    end;
    qryParcelas.Next;
  end;
  qryParcelas.EnableControls;

  if not Flag then begin
    MensagemAviso('Não foi selecionada nenhuma Parcela.');
    Exit;
  end
  else
  begin
   Perpetrar([qryParcelas]);
   MensagemAviso('Parcelas gravadas com sucesso.');
  end;
//  qryParcelas.Close;
end;

procedure TdtmGerarRemessasPagamentos.GerarArquivoHSBC(NomeArquivo: String);
var NomeArq: String; FlagMarcado: Boolean;
//  I: Integer;
begin
(***********************************************************
 for I := 1 to Length(NomeArquivo) do begin
    {$IFDEF LINUX}
      if NomeArquivo[I] = '\' then begin
         Delete(NomeArquivo, I, 1);
         Insert('/',NomeArquivo,I);
