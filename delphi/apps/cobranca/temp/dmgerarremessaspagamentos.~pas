Procedure TdtmGerarRemessasPagamentos.GravarDetalhesSegmento_Q_BBrasil(Var Arq);
Var Arquivo:  File Absolute Arq;
    NumInsc, CepInt: Integer;
    InscStr, CepStr: String;
begin
  with DetalheSegmento_Q_BBrasil  do begin
     FillChar(DetalheSegmento_Q_BBrasil,SizeOf(DetalheSegmento_Q_BBrasil),'0');
     MoveNro(1,                            DQ_CODIGO_BANCO_COMPENSACAO,    SizeOf(DQ_CODIGO_BANCO_COMPENSACAO));
     MoveNro(1,                            DQ_LOTE_DE_SERVICO,             SizeOf(DQ_LOTE_DE_SERVICO));
     MoveNro(3,                            DQ_REGISTRO_DETALHE,            SizeOf(DQ_REGISTRO_DETALHE));
     Inc(Seq);
     MoveNro(Seq,                          DQ_NR_SEQUENCIAL_LOTE,          SizeOf(DQ_NR_SEQUENCIAL_LOTE));
     MoveStr('Q',                          DQ_COD_SEGMENTOR,               SizeOf(DQ_COD_SEGMENTOR));
     MoveStr('',                           DQ_USO_FEBRABAN,                SizeOf(DQ_USO_FEBRABAN));
     MoveNro(1,                            DQ_CODIGO_MOVIMENTO,            SizeOf(DQ_CODIGO_MOVIMENTO));

     if qryParcelasPessoaTipo.AsString = 'F' then
        NumInsc := 1
     else
        if qryParcelasPessoaTipo.AsString = 'J' then
           NumInsc := 2
        else
           NumInsc := 9;

     MoveNro(NumInsc,                      DQ_TIPO_INSCRICAO,    SizeOf(DQ_TIPO_INSCRICAO));

     if qryParcelasCNPJouCPF.AsString = '' then
        InscStr := '000000000000000'
     else
        InscStr := '0' + qryParcelasCNPJouCPF.AsString;

     MoveStr(InscStr,                       DQ_NR_INSCRICAO,   SizeOf(DQ_NR_INSCRICAO));
     MoveStr(qryParcelasNome.AsString,      DQ_Nome,           SizeOf(DQ_Nome));
     MoveStr(qryParcelasRua.AsString,       DQ_ENDERECO,       SizeOf(DQ_ENDERECO));
     MoveStr(qryParcelasNomeBairro.AsString,DQ_Bairro,         SizeOf(DQ_Bairro));

     if qryParcelasCEP.AsInteger = 0 then begin
        MoveNro(0, DQ_CEP,        SizeOf(DQ_CEP));
        MoveNro(0, DQ_SUFIXO_CEP, SizeOf(DQ_SUFIXO_CEP));
     end
     else begin
        CepStr := FStr(qryParcelasCEP.AsInteger,$81);
        CepStr := Copy(CepStr,1,5);
        CepInt := StrToInt(CepStr);
        CepStr := Format('%.5d',[CepInt]);
        MoveStr(CepStr,                    DQ_CEP,      SizeOf(DQ_CEP));
        CepStr := FStr(qryParcelasCEP.AsInteger,$81);
        CepStr := Copy(CepStr,6,3);
        if CepStr <> '' then begin
           CepInt := StrToInt(CepStr);
           CepStr := Format('%.3d',[CepInt]);
           MoveStr(CepStr,                  DQ_SUFIXO_CEP,  SizeOf(DQ_SUFIXO_CEP));
        end else
           MoveNro(0,                       DQ_SUFIXO_CEP,   SizeOf(DQ_SUFIXO_CEP));
     end;

     MoveStr(qryParcelasNomeCidade. AsString, DQ_CIDADE,                SizeOf(DQ_CIDADE));
     MoveStr(qryParcelasEstado.     AsString, DQ_ESTADO,                SizeOf(DQ_ESTADO));
     MoveNro(0,                               DQ_TIPO_INSCRICAO1,       SizeOf(DQ_TIPO_INSCRICAO1));
     MoveNro(0,                               DQ_NR_INSCRICAO1,         SizeOf(DQ_NR_INSCRICAO1));
     MoveStr('',                              DQ_Nome_SACADOR_AVALISTA, SizeOf(DQ_Nome_SACADOR_AVALISTA));
     MoveNro(0,                               DQ_COD_BCO_COMPENSACAO,   SizeOf(DQ_COD_BCO_COMPENSACAO));
     MoveStr(qryParcelasNossoNumero.AsString, DQ_NOSSO_Numero,          SizeOf(DQ_NOSSO_Numero));
     MoveStr('',                              DQ_USO_FEBRABAN1,         SizeOf(DQ_USO_FEBRABAN1));
     MoveCrLf(CrLf,                           DQ_CrLf,                  SizeOf(DQ_CrLf));
     BlockWrite(Arquivo,DetalheSegmento_Q_BBrasil,1);
   end;
End; {GravarDetalhesSegmento_Q_BBrasil}

