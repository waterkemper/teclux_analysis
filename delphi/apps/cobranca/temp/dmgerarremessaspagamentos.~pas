procedure TdtmGerarRemessasPagamentos.GerarArquivoBBrasil(NomeArquivo: String);
var //I: Integetr;
    NomeArq: String;  FlagMarcado: Boolean;
begin
  try
    AssignFile(Arq,NomeArquivo);
    Rewrite(Arq,SizeOf(T_HeaderBBrasil));
    GravarHeaderBBrasil(Arq);
    GravarHeaderLoteBBrasil(Arq);
    NomeArq := Copy(NomeArquivo, Length(NomeArquivo) - 11 ,8);
    qryParcelas.DisableControls;

    Seq := 0;    FlagMarcado := False;
    qryParcelas.DisableControls;
    qryParcelas.First;
    while not qryParcelas.Eof do begin
      if qryParcelasSelecionar.AsBoolean then begin
         GravarDetalhesSegmento_P_BBrasil(Arq);
         GravarDetalhesSegmento_Q_BBrasil(Arq);
         FlagMarcado := True;

         qryParcelas.Edit;
         qryParcelasRemessa.AsString := NomeArq;
         qryParcelasContaBoleto.AsString := qryContasConta.AsString;
         qryParcelas.Post;

         qryAtualizarParcelas.ParamByName('Remessa').    Value:= NomeArq;
         qryAtualizarParcelas.ParamByName('ContaBoleto').Value:= qryContasConta.AsString;
         qryAtualizarParcelas.ParamByName('Contrato').   Value:= qryParcelasContrato.AsString;
         qryAtualizarParcelas.ParamByName('Numero').     Value:= qryParcelasNumero.AsString;
         qryAtualizarParcelas.ExecSql;

      end;
      qryParcelas.Next;
    end;
    qryParcelas.EnableControls;

    if FlagMarcado = False then begin
       MensagemAviso('Não foi marcada nenhuma Parcela');
       Exit;
    end;

    GravarTraillerLoteBBrasil(Arq);
    GravarTraillerBBrasil(Arq);

   qryContas.Edit;
   qryContasSequencial.AsInteger := qryContasSequencial.AsInteger + 1;
   qryContas.Post;
   except
    on E:EFCreateError do
      MensagemErro(E.Message);
  end;
  Close(Arq);
  Perpetrar([qryAtualizarParcelas, qryContas]);
  qryParcelas.EnableControls;
//  qryParcelas.Close;
  MensagemAviso(format(ctARQUIVOGERADOSUCESSO,[NomeArquivo]));
end;

Procedure TdtmGerarRemessasPagamentos.GravarHeaderBBrasil(Var Arq);
Var Arquivo: File Absolute Arq;
    Ano, Mes, Dia, Hora, Min, Seg, MSeg: Word;
    DataStr, NomeFil, HoraStr: String;
    NrSeq, AgenciaInt: Integer;
    AgenciaStr, DigAgeStr, Cnpj: String;
    ContaStr, DigContaStr: String;
Begin
  with HeaderBBrasil do begin
    NomeFil := qryParcelasNomeFilial.AsString;
    NrSeq := qryContasSequencial.AsInteger + 1;
    DecodeDate(Now, Ano, Mes, Dia);
    DataStr := Format('%.2d',[Dia]) + Format('%.2d',[Mes]) + Format('%2.d',[Ano]);
    DecodeTime(Time, Hora, Min, Seg,Mseg);
    HoraStr:=  Format('%2.2d',[Hora]) + Format('%2.2d',[Min]) + Format('%2.2d',[Seg]);
    Cnpj := qryFiliaisCnpj.AsString;
    AgenciaStr := Format('%.5d', [qryContasAgencia.AsInteger]);
    DigAgeStr  := Copy(AgenciaStr,5,1);
    AgenciaStr := Copy(AgenciaStr,1,4);
    AgenciaInt := StrToInt(AgenciaStr);
    ContaStr   := Format('%.12d', [qryContasConta.AsInteger]);
    DigContaStr:= qryContasDigito.AsString;

    FillChar(HeaderBBrasil,SizeOf(HeaderBBrasil),'0');
    MoveNro(1,                      H_CODIGO_BANCO_COMPENSACAO,         SizeOf(H_CODIGO_BANCO_COMPENSACAO));
    MoveNro(0,                      H_LOTE_DE_SERVICO,                  SizeOf(H_LOTE_DE_SERVICO));
    MoveNro(0,                      H_REGISTRO_HEADER_ARQUIVO,          SizeOf(H_REGISTRO_HEADER_ARQUIVO));
    MoveStr('',                     H_USO_FEBRABAN,                     SizeOf(H_USO_FEBRABAN));
    MoveNro(2,                      H_TIPO_INSCRICAO_EMPRESA,           SizeOf(H_TIPO_INSCRICAO_EMPRESA));
    MoveStr(Cnpj,                   H_NR_INSCRICAO_EMPRESA, SizeOf( H_NR_INSCRICAO_EMPRESA ));
    MoveStr('',                     H_CODIGO_CONVENIO_BANCO ,           SizeOf(H_CODIGO_CONVENIO_BANCO));
    MoveNro(AgenciaInt,             H_AGENCIA_MANTENEDORA_CONTA,        SizeOf(H_AGENCIA_MANTENEDORA_CONTA));
    MoveStr(DigAgeStr,              H_DIGITO_VERIF_AGENCIA,             SizeOf(H_DIGITO_VERIF_AGENCIA));
    MoveStr(ContaStr,               H_Numero_CONTA_CORRENTE,            SizeOf(H_Numero_CONTA_CORRENTE));
    MoveStr(DigContaStr,            H_DIGITO_VERIF_CONTA,               SizeOf(H_DIGITO_VERIF_CONTA));
    MoveStr('',                     H_DIGITOVERIF_AG_CONTA,             SizeOf(H_DIGITOVERIF_AG_CONTA));
    MoveStr(qryFiliaisNome.AsString,H_Nome_EMPRESA,                     SizeOf(H_Nome_EMPRESA));
    MoveStr('BANCO DO BRASIL S/A',  H_Nome_BANCO,                       SizeOf(H_Nome_BANCO));
    MoveStr('',                     H_USO_FEBRABAN1,                     SizeOf(H_USO_FEBRABAN1));
    MoveNro(1,                      H_CODIGO_REMESSA_RETORNO,           SizeOf(H_CODIGO_REMESSA_RETORNO));
    MoveNro(StrToInt(DataStr),      H_DATA_GERACAO_ARQUIVO,             SizeOf(H_DATA_GERACAO_ARQUIVO));
    MoveNro(StrToInt(HoraStr),      H_HORA_GERACAO_ARQUIVO ,            SizeOf(H_HORA_GERACAO_ARQUIVO ));
    MoveNro(NrSeq,                  H_NR_SEQUENCIAL_ARQUIVO,            SizeOf(H_NR_SEQUENCIAL_ARQUIVO));
    MoveStr('030',                  H_NR_VERSAO_LAYOUT_ARQUIVO,         SizeOf(H_NR_VERSAO_LAYOUT_ARQUIVO));
    MoveNro(0,                      H_DENSIDADE_GRAVACAO,               SizeOf(H_DENSIDADE_GRAVACAO));
    MoveStr('',                     H_USO_ESERVADO_BANCO,               SizeOf(H_USO_ESERVADO_BANCO));
    MoveStr('',                     H_USO_RESERVADO_EMPRESA,            SizeOf(H_USO_RESERVADO_EMPRESA));
    MoveStr('',                     H_USO_FEBRABAN2,                    SizeOf(H_USO_FEBRABAN2));
    MoveStr('CSP',                  H_IDENT_COBRANCA_EMPAPEL,           SizeOf(H_IDENT_COBRANCA_EMPAPEL));
    MoveNro(0,                      H_USO_DAS_VANS,                     SizeOf(H_USO_DAS_VANS));
    MoveNro(2,                      H_TIPO_DE_SERVICO ,                 SizeOf(H_TIPO_DE_SERVICO ));
    MoveStr('',                     H_CODIGOS_DAS_OCORRENCIAS,          SizeOf(H_CODIGOS_DAS_OCORRENCIAS));
    MoveCrLf(CrLf,                  H_CrLf,                             SizeOf(H_CrLf));
    BlockWrite(Arquivo,HeaderBBrasil,1);
  end;
End; {GravarHeaderBBrasil}


