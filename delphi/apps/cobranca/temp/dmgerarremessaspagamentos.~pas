    MoveStr('',                     HL_USO_FEBRABAN,                    SizeOf(HL_USO_FEBRABAN));
    MoveNro(2,                      HL_TIPO_INSCRICAO_EMPRESA,          SizeOf(HL_TIPO_INSCRICAO_EMPRESA));
    MoveStr(Cnpj,                   HL_NR_INSCRICAO_EMPRESA,            SizeOf(HL_NR_INSCRICAO_EMPRESA));
