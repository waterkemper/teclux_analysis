procedure TdtmGerarRemessasPagamentos.SetNotaInicial(const Value: String);
const
 SQL = 'and ct.Numero in (select df.Contrato '+
                         ' from dadosfiscais df '+
                         ' where df.situacao = ''N'' and '+
                              ' df.Numero in (select n.dadofiscal as notafiscal '+
