procedure TdtmGerarRemessasPagamentos.SetSituacao(const Value: String);
var
  SQLSituacao: String;
const
  CondicaoSimplesFaturamento =
 ' case when ct.situacao = ''F'' then                                  ' +
 '    coalesce((select true                                            ' +
 '              from dadosfiscais df                                   ' +
 '              where df.contrato = coalesce(ct.primogenito,ct.numero) ' +
 '                and df.situacao = ''N''                              ' +
 '                and mod(df.codigofiscal,1000) = 922 limit 1), false) ' +
 ' else true end ';

begin
  fSituacao := Value;


  SQLSituacao := ' and ct.situacao in (' + Value;

  if Copy(SQLSituacao,length(SQLSituacao),1) = ',' then
    SQLSituacao := Copy(SQLSituacao,1,length(SQLSituacao)-1) + ') ';

  if IncluirSimplesFaturamento and not IncluirFaturados then
    SQLSituacao := SQLSituacao + ' and ' + CondicaoSimplesFaturamento
  else
  if not IncluirSimplesFaturamento and IncluirFaturados then
    SQLSituacao := SQLSituacao + ' and not ' + CondicaoSimplesFaturamento;

  qryParcelas.MacroByName('SituacaoContrato').asString := SQLSituacao;
end;

