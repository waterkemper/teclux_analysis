                DataProcessamento:= DataServidor;

                Vencimento     := qryParcelasDataVencto.     AsDateTime;
                DataDocumento  := qryParcelasFaturamento.    AsDateTime;
                NumeroDocumento:= qryParcelasNumeroDocumento.AsString;
                SeuNumero      := qryParcelasNumeroDocumento.AsString;
                ValorDocumento := qryParcelasValorVencto.    AsFloat;
                DataDesconto   := qryParcelasDataDesconto.       AsDateTime;
                ValorDesconto  := qryParcelasValorDesconto.      AsCurrency;
                DataMoraJuros  := qryParcelasDataMoraJuros.      AsDateTime;

                if(qryContasBanco.AsInteger=341) then
                  DataMulta:=DataMoraJuros;
{
                if ACBrBoleto.Banco.TipoCobranca = cobSantander then
                begin }
                  if qryContascodigomora.asString = '2' then //taxa mensal
                  begin
                    CodigoMora := '2';
                    ValorMoraJuros := qryParcelasPercentualMoraJuros.Ascurrency;

                    CodigoMoraJuros := cjTaxaMensal;
//                    (cjValorDia, cjTaxaMensal, cjIsento, cjValorMensal, cjTaxaDiaria)

                  end
                  else
                  begin
                    if qryContascodigomora.asString <> '' then
                      CodigoMora := qryContascodigomora.asString
                    else
                      CodigoMora := '1'; //diária

                    ValorMoraJuros := qryParcelasValorMoraJuros.AsCurrency;

                    if qryContascodigomora.asString = '1' then
                      CodigoMoraJuros := cjValorDia
                    else
                    if qryContascodigomora.asString = '3' then
                      CodigoMoraJuros := cjIsento
                    else
                    if qryContascodigomora.asString = '4' then
                      CodigoMoraJuros := cjValorMensal
                    else
                    if qryContascodigomora.asString = '5' then
                      CodigoMoraJuros := cjTaxaDiaria;

                  end;
{
                end
                else
                  ValorMoraJuros := qryParcelasValorMoraJuros.AsCurrency;

}

                PercentualMulta:= qryParcelasPercentualMoraMulta.AsCurrency;
                DataBaixa      := qryParcelasDataVencto.asdatetime + qryContasndiasbaixaautomatica.asinteger;
                If (qryContasndiasbaixaautomatica.AsInteger>0) then
                begin;
                  Instrucao2:='1';
                end;

                StrGeral:= qryParcelasNossoNumero.AsString;
                if Titulo.ACBrBoleto.Banco.TipoCobranca = cobBancoDoBrasil then
                  NossoNumero:= Copy(qryParcelasNossoNumero.AsString,2,10)  {Ignora-se o 1º zero}
                else
                if ((Titulo.ACBrBoleto.Banco.TipoCobranca=cobItau) or
                    (Titulo.ACBrBoleto.Banco.TipoCobranca=cobBanrisul))then
                  NossoNumero:= Copy(qryParcelasNossoNumero.AsString,4,10)  {Ignora-se os 3 primeiros zeros, itau tam maximo=8}
                else
                if (Titulo.ACBrBoleto.Banco.TipoCobranca=cobSicred) then
                begin
                  {
                  if length(inttostr(qryParcelasNossoNumero.asinteger))>5 then
                     raise Exception.Create( ACBrStr('Nosso número ultrapassando a 5 caracteres ' +
                                                     'para este banco!') )
                  else
                  }
                    NossoNumero:= Copy(qryParcelasNossoNumero.AsString,7,5);  {Ignora-se os 3 primeiros zeros, tam maximo=5}
                end
                else
                  NossoNumero:= qryParcelasNossoNumero.     AsString;

                StrGeral:= Titulo.NossoNumero;


                if qryContasIncluirInstrucoesArquivoBanco.AsBoolean
                then Mensagem.Text:= Trocar(
                                     Trocar(qryContasInstrucoesBoleto.AsString, '<fjurosdiasreais>', 'R$ ' + FormatFloat('###,##0.00',ValorMoraJuros)),
                                                                                '<fmultareais>',     'R$ ' + FormatFloat('###,##0.00',(PercentualMulta/100.0) * ValorDocumento));

                with Sacado do
                begin
                  if qryParcelasPessoaTipo.AsString = 'F'
                  then Pessoa := pFisica
                  else Pessoa := pJuridica;
                  CNPJCPF    := qryParcelasCNPJouCPF.     AsString;
                  NomeSacado := RetiraAcento(qryParcelasNome.          AsString);
                  Logradouro := RetiraAcento(qryParcelasRua.           AsString);
                  Numero     := RetiraAcento(qryParcelasEndNumero.     AsString);
                  Complemento:= RetiraAcento(qryParcelasEndComplemento.AsString);
                  Bairro     := RetiraAcento(qryParcelasNomeBairro.    AsString);
                  Cidade     := RetiraAcento(qryParcelasNomeCidade.AsString);
                  UF         := qryParcelasEstado.        AsString;
                  CEP        := FStr(qryParcelasCEP.AsInteger,$81);
                end;

                if qryContasbancoreferencia.AsString = '087' then
                  Mensagem.Text := preencheString(qryParcelasNomeBairro.AsString, ' ', 20, true) +
                                   preencheString(qryParcelasNomeCidade.AsString, ' ', 38, true) +
                                   qryParcelasEstado.AsString
                else
                begin
                  if qryContasIncluirInstrucoesArquivoBanco.AsBoolean then
                  begin
                    Mensagem.Text := Trocar(
                                     Trocar(qryContasInstrucoesBoleto.AsString, '<fjurosdiasreais>', 'R$ ' + FormatFloat('###,##0.00',ValorMoraJuros)),
                                                                              '<fmultareais>',     'R$ ' + FormatFloat('###,##0.00',(PercentualMulta/100.0) * ValorDocumento));
                    ACBrBoleto.ImprimirMensagemPadrao:= false;
                    ACBrBoleto.AdicionarMensagensPadroes(Titulo, Mensagem);
                  end
                  else
                  begin
                    ACBrBoleto.ImprimirMensagemPadrao:= true;
                    ACBrBoleto.AdicionarMensagensPadroes(Titulo, Mensagem);
                  end;
                end;

                qryParcelas.Edit;
                qryParcelasRemessa.    AsString := NomeArq;
                qryParcelasContaBoleto.AsString := qryContasConta.AsString;
                qryParcelasdigverificadornossonumero.asString := ACBrBoleto.Banco.CalcularDigitoVerificador(titulo);
                qryParcelas.Post;
             end;
//           break; {teste fazer somente uma}
          end;
          qryParcelas.Next;
       end;

       ACBrBoleto1.LayoutRemessa := c240ou400;

       if qryContasBanco.AsInteger <> 748 then {Sicredit}
         ACBrBoleto1.NomeArqRemessa:= NomeArq + '.REM';

       ACBrBoleto1.DirArqRemessa := ExtractFilePath(NomeArquivo);
       ACBrBoleto1.DirArqRemessa := copy(ACBrBoleto1.DirArqRemessa, 1, length(ACBrBoleto1.DirArqRemessa)-1);

       ACBrBoleto1.GerarRemessa(qryContasSequencial.AsInteger);
       Gerou := True;
   finally
       VoltarRegistroAtual(qryParcelas);
       ACBrBoleto1.ListadeBoletos.Clear;
//       FreeAndNil(ACBrBoleto1);
   end;

   if Gerou then begin
      qryContas.Edit;
      qryContasSequencial.AsInteger:= qryContasSequencial.AsInteger + 1;
      qryContasdataultimaremessa.asdatetime := dataservidor;
      qryContas.Post;
      Perpetrar([qryParcelas,qryContas]);

      if not ModoIntermitente then
        MensagemAviso(format(ctARQUIVOGERADOSUCESSO,[NomeArquivo]));

   end
   else begin
      Rollback([qryParcelas,qryContas]);
      MensagemAviso(format(ctARQUIVOERRO,['de geração']));
   end;
end; {GerarArquivoACBrCNAB}



