procedure TdtmGerarRemessasPagamentos.qryParcelasCalcFields(DataSet: TDataSet);
begin
  inherited;
  if qryParcelaspercentualdesconto.Ascurrency<>0 then
  begin
    qryParcelasValorDesconto.AsCurrency := ((qryParcelasValorVencto.AsCurrency *
                                             qryParcelaspercentualdesconto.Ascurrency)/100)/30;
    qryParcelasDataDesconto.AsDateTime := qryParcelasdatavencto.AsDateTime - 1;
  end
  else
  begin
    qryParcelasValorDesconto.AsCurrency := 0.00;
    qryParcelasDataDesconto.Clear;
  end;

  if qryParcelasPercentualMoraJuros.AsCurrency<>0 then
  begin
    if qryParcelasdiasatraso1.AsString<>'' then
      qryParcelasDataMoraJuros.AsDateTime := qryParcelasdatavencto.AsDateTime + strtoint(qryParcelasdiasatraso1.AsString)
    else
      qryParcelasDataMoraJuros.AsDateTime := qryParcelasdatavencto.AsDateTime + 1;
    qryParcelasValorMoraJuros.AsCurrency := ((qryParcelasValorVencto.AsCurrency *
                                             qryParcelasPercentualMoraJuros.Ascurrency)/100)/30
  end
  else
  begin
    qryParcelasDataMoraJuros.Clear;
    qryParcelasValorMoraJuros.AsCurrency := 0.00;
  end;

  if (qryParcelasQtdeNotasFiscais.AsInteger = 1) or not ParSistema.ClienteUsaContrato
  then qryParcelasNumeroDocumento.AsString:= 'NF ' + qryParcelasNotaFiscal.AsString + '/'
                                                   + qryParcelasNumero.    AsString

  else qryParcelasNumeroDocumento.AsString:= 'CT ' + qryParcelasContrato.  AsString + '/'
                                                   + qryParcelasNumero.    AsString;

end;

procedure TdtmGerarRemessasPagamentos.ImprimirBoleto;
var dtmImprimeBoleto: TdtmImprimeBoleto;
begin
  dtmImprimeBoleto:= TdtmImprimeBoleto.Create(Self);
  try
      dtmImprimeBoleto.ImprimirBoletoContrato(ObterListaContratosParcelas, qryContasConta.AsInteger);
  finally
      dtmImprimeBoleto.Free;
  end
end;



function TdtmGerarRemessasPagamentos.ObterListaContratosParcelas: string;
var Lista:    string;
    Contrato: string;
    Parcelas: string;
    v_Parcelaspermitirimpressaodoboleto : Boolean;
begin
   Lista   := '';
   Contrato:= '';
   Parcelas:= '';

   GuardarRegistroAtual(qryParcelas,true);
   qryParcelas.First;
   while not qryParcelas.Eof do
   begin
      if qryParcelasSelecionar.AsBoolean then
      begin
         Contrato:= qryParcelasContrato.AsString;
         Parcelas:= Parcelas + qryParcelasNumero.AsString + ',';
         v_Parcelaspermitirimpressaodoboleto := qryParcelaspermitirimpressaodoboleto.asBoolean;
      end;
      qryParcelas.Next;

      if (Contrato <> '') and (Parcelas <> '')
      then if (qryParcelasContrato.AsString <> Contrato) or (qryParcelas.eof) then
           begin
              Delete(Parcelas, Length(Parcelas ), 1);

              if not v_Parcelaspermitirimpressaodoboleto then
              begin
                MensagemAviso(format('Existe uma restrição no plano do contrato %s que não permite a impressão do boleto.'+chr(13)+
                              'Veja a opção "Permitir Impressão do Boleto" em Cadastro, Tabelas, Plano de Pagamentos, Código %s.',
                              [qryParcelasContrato.asString, qryParcelasPlano.asSTring]));

              end
              else
              begin

                if Lista <> ''
                then Lista:= Lista + ' or ';

                Lista   := Lista + ' (p.Contrato = ''' + Contrato
                                 + ''' AND p.Numero IN (' + Parcelas + ' ))' + #13;
              end;

              Contrato:= '';
              Parcelas:= '';
           end;
   end;

   if Lista = ''
   then Lista:= '(p.Contrato = 0 AND p.Numero = 0)'
   else Lista:= '(' + Lista + ')';

   VoltarRegistroAtual(qryParcelas);
   Result:= Lista;
end;

