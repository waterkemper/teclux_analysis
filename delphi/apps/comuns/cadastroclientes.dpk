package cadastroclientes;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  visualclx,
  dbrtl,
  visualdbclx,
  repositorio;

contains
  rgcadastroclientes in 'rgcadastroclientes.pas',
  dmcadastroclientes in '..\vendas\dmcadastroclientes.pas' {dtmCadastroClientes: TDataModule},
  fmcadastroclientes in '..\vendas\fmcadastroclientes.pas' {frmCadastroClientes},
  fmcadastrodependentesclientes in '..\vendas\fmcadastrodependentesclientes.pas' {frmCadastroDependentesClientes};

end.
