package cadastroclientesk;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$SONAME 'cadastroclientes'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  baseclx,
  visualclx,
  repositoriok;

contains
  dmcadastroclientes in '../vendas/dmcadastroclientes.pas' {dtmCadastroClientes: TDataModule},
  rgcadastroclientes in 'rgcadastroclientes.pas',
  fmcadastroclientes in '../vendas/fmcadastroclientes.pas' {frmCadastroClientes},
  fmcadastrodependentesclientes in '../vendas/fmcadastrodependentesclientes.pas' {frmCadastroDependentesClientes};

end.
