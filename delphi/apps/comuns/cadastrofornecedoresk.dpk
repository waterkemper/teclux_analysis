package cadastrofornecedoresk;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$SONAME 'cadastrofornecedores'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  baseclx,
  visualclx,
  repositoriok;

contains
  rgcadastrofornecedores in 'rgcadastrofornecedores.pas',
  dmcadastrofornecedores in '../estoque/dmcadastrofornecedores.pas' {dtmCadastroFornecedores: TDataModule},
  fmcadastrofornecedores in '../estoque/fmcadastrofornecedores.pas' {frmCadastroFornecedores},
  fmcadastrofornecedoresgrupos in '../estoque/fmcadastrofornecedoresgrupos.pas' {frmCadastroFornecedoresGrupos};

end.
