package configuracoesecfk;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS OFF}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS OFF}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Configuracoes de ECF'}
{$SONAME 'configuracoesecf'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  baseclx,
  visualclx,
  repositoriok;

contains
  fmconfiguracaoecf in '../caixa/fmconfiguracaoecf.pas' {frmConfiguracoesECF},
  rgconfiguracoesecf in 'rgconfiguracoesecf.pas';

end.
