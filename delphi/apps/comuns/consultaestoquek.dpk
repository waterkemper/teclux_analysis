package consultaestoquek;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$SONAME 'consultaestoque'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  baseclx,
  visualclx,
  repositoriok;

contains
  rgconsultaestoque in 'rgconsultaestoque.pas',
  dmconsultaestoque in '../estoque/dmconsultaestoque.pas' {dtmConsultaEstoque: TDataModule},
  fmconsultaestoque in '../estoque/fmconsultaestoque.pas' {frmConsultaEstoque};

end.
