package consultanotasfiscaissaida;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  visualclx,
  dbrtl,
  visualdbclx,
  repositorio;

contains
  rgconsultanotasfiscaissaida in 'rgconsultanotasfiscaissaida.pas',
  dmconsultanotasfiscais in '..\vendas\dmconsultanotasfiscais.pas' {dtmConsultaNotasFiscais: TDataModule},
  fmconsultanotasecupons in '..\vendas\fmconsultanotasecupons.pas' {frmConsultaNotaseCupons};

end.
