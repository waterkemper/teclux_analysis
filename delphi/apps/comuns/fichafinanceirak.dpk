package fichafinanceirak;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$SONAME 'fichafinanceira'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  baseclx,
  visualclx,
  repositoriok;

contains
  rgfichafinanceira in 'rgfichafinanceira.pas',
  dmcadastrocontratos in '../vendas/dmcadastrocontratos.pas' {dtmCadastroContratos: TDataModule},
  fmprodutosaentregar in '../vendas/fmprodutosaentregar.pas' {frmProdutosaEntregar},
  dmoperacoescontratos in '../vendas/dmoperacoescontratos.pas' {dtmOperacoesContratos: TDataModule},
  fmcomplementarnotafiscalsaida in '../vendas/fmcomplementarnotafiscalsaida.pas' {frmComplementarNotaFiscalSaida},
  dmvendasavista in '../vendas/dmvendasavista.pas' {dtmVendasAVista: TDataModule};

end.
