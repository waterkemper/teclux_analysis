      item
        DataType = ftUnknown
        Name = 'MesesDebitos_sc2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'MesesCreditos_sc2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'wherefilial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'listadecontas'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereConta'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'sintetico'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'subconta'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Ordenacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'select saldos.*,'
      
        '          (select(coalesce(saldos.saldoanterior,0) + coalesce(sa' +
        'ldos.debitos,0) - coalesce(saldos.creditos,0)) )as saldoatual'
      'from ('
      '      select'
      '             pc.codigo,'
      
        '             case when :ImprimirCodigoReduzido and pc.tipo='#39'A'#39' t' +
        'hen cast(pc.classificacao||'#39'       '#39'||to_char(pc.codigo,'#39'999999'#39 +
        ')||'#39'   '#39'||pc.descricao as varchar)'
      
        '             else  cast(pc.classificacao||'#39'       '#39'||pc.descrica' +
        'o as varchar) end as descricao,'
      ''
      
        '             case when :ImprimirCodigoReduzido and pc.tipo='#39'A'#39' t' +
        'hen cast(repeat('#39' '#39', length(btrim(pc.classificacao)))||to_char(p' +
        'c.codigo,'#39'999999'#39')||'#39'   '#39'||pc.descricao as varchar)'
      
        '             else  cast(repeat('#39' '#39', length(btrim(pc.classificaca' +
        'o)))||pc.descricao as varchar) end as descricaoedentada,'
      '             descricao as descricaoconta,'
      '             pc.classificacao,'
      '             pc.tipo,'
      '             (select coalesce(max(l.data), '#39'1900-01-01'#39')'
      '              from lancamentos l'
      '              where (l.exercicio = sc.exercicio)'
      
        '                and ((l.debitar = pc.codigo) or (l.creditar = pc' +
        '.codigo))'
      '             ) as ultimolancto,'
      
        '             (select saldocontabil(pc.codigo, sc.filial, :ultimo' +
        'mes, CAST(:Exercicio AS INTEGER))) as saldoanterior,'
      '             coalesce(%MesesDebitos_sc,0) as debitos,'
      '             coalesce(%MesesCreditos_sc,0) as creditos,'
      '             sc.filial,'
      '             f.razao,'
      '             formatar_cpf_cnpj(f.cnpj) as cnpj,'
      '             f.inscricaoestadual,'
      '             case when :ContaComSaldo and pc.tipo='#39'S'#39' then'
      '               ((select count(*)'
      
        '                from planocontas pc2 join saldoscontabeis sc2 on' +
        ' pc2.codigo = sc2.conta'
      '                where sc2.exercicio = :exercicio'
      '                        %wherefilial2'
      '                        %listadecontas2'
      '                        %WhereConta2'
      '                        and sc2.filial = sc.filial'
      '                        and pc2.inativo is null'
      '                        and pc2.tipo = '#39'A'#39
      
        '                        and position(CAST(pc.classificacao AS VA' +
        'RCHAR) in CAST(pc2.classificacao AS VARCHAR))=1'
      
        '                        and ((saldocontabil(pc2.codigo, sc2.fili' +
        'al, :ultimomes, CAST(:Exercicio AS INTEGER)) +'
      '                              coalesce(%MesesDebitos_sc2,0) -'
      
        '                              coalesce(%MesesCreditos_sc2,0))<>0' +
        ')'
      '                limit 1)<>0)'
      '            else false end as SinteticaComSaldonasAnaliticas'
      ''
      
        '      from planocontas pc join(saldoscontabeis sc join filiais f' +
        ' on sc.filial = f.codigo) on pc.codigo = sc.conta'
      '      where sc.exercicio = :exercicio'
      '        %wherefilial'
      '        %listadecontas'
      '         %WhereConta'
      
        '        and ((pc.inativo is null) or (pc.Inativo > CAST(:UltimoM' +
        'es AS DATE) + 1))'
      '         %sintetico'
      '     ) as saldos'
      '%subconta'
      '%Ordenacao'
      '')
    RequestLive = False
    Left = 72
    Top = 8
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'ImprimirCodigoReduzido'
        ParamType = ptUnknown
      end
