    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Filiais'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      
        'select *, (coalesce(somadebitar,0) - coalesce(somacreditar,0)) a' +
        's saldo'
      'from'
      '('
      
        'select data, sum(valordebito) as somadebitar, sum(valorcredito) ' +
        'as somacreditar'
      'from'
      '('
      'select * from'
      '   ('
      '    ('
      '     select ld.data,'
      #9'    ld.valor as valordebito,'
      #9'    cast(null as numeric) as valorcredito,'
      #9'    cast('#39'A'#39' as varchar) as ordenacao'
      '     from lancamentos ld'
      
        '     where ld.data between :datainicial and :datafinal and ld.de' +
        'bitar is not null'
      '     %Filiais'
      '     order by ld.data'
      '    )'
      '    union all'
      '    ('
      '     select lc.data,'
      #9'    cast(null as numeric) as valordebito,'
      #9'    lc.valor as valorcredito,'
      #9'    cast('#39'B'#39' as varchar) as ordenacao'
      '     from lancamentos lc'
      
        '     where lc.data between :datainicial and :datafinal and lc.cr' +
        'editar is not null'
      '       %Filiais'
      '     order by lc.data'
      '    )'
      '   ) as saldos'
      'where saldos.data between :datainicial and :datafinal'
      '%Filiais'
      'Order by data, UPPER(TO_ASCII(Ordenacao,'#39'LATIN1'#39'))'
      ') as lanctos'
      'Group By data'
      'Order By data'
      ') as somas')
    RequestLive = False
    Left = 56
    Top = 176
    ParamData = <
