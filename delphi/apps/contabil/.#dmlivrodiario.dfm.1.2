      ';'
      'select * from'
      '   ('
      '    ('
      '     select ld.data,'
      #9'    ld.nrlancto,'
      #9'    ld.filial,'
      #9'    ld.historico,'
      
        #9'    coalesce((select h.descricao from historicos h where h.codi' +
        'go = ld.historico),'#39#39')||'#39' '#39'||coalesce(ld.complemento,'#39#39') as desc' +
        'ricaohistoricocomplemento,'
      #9'    pl.codigo,'
      #9'    pl.descricao,'
      #9'    ld.valor as valordebito,'
      #9'    cast(null as numeric) as valorcredito,'
      #9'    cast('#39'A'#39' as varchar) as ordenacao,'
      #9'    f.razao,'
      #9'    formatar_cpf_cnpj(f.cnpj) as cnpj,'
      #9'    f.inscricaoestadual'
      
        '     from planocontas pl join (lancamentos ld join filiais f on ' +
        'ld.filial = f.codigo)'
      '     '#9#9#9#9'on pl.codigo = ld.debitar'
