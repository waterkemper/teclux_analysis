      '       formatar_cpf_cnpj(f.cnpj) as cnpj,'
      '       f.inscricaoestadual'
      ''
      'from planocontas pl'
      '     join lancamentos lc'
      '          join filiais f'
      '          on lc.filial = f.codigo'
      ''
      '          join lancamentos ld'
