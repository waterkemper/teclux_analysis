  object qryPlanoContas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryPlanoContasAfterOpen
    AfterClose = qryPlanoContasAfterClose
    BeforeInsert = qryPlanoContasBeforeInsert
    AfterCancel = qryPlanoContasAfterCancel
    AfterScroll = qryPlanoContasAfterScroll
    OnNewRecord = qryPlanoContasNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Ordenacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'SELECT p.Codigo,'
      '       p.Classificacao,'
      '       p.Tipo,'
      
        '       (select pr.tipo from planoreferencial pr where pr.codigo ' +
        '= p.referencia) as TipoReferencial,'
      '       p.Descricao,'
      '       p.referencia,'
      
        '       (select pr.classificacao from planoreferencial pr where p' +
        'r.codigo = p.referencia) as ClassificacaoReferencial,'
      '       p.Inativo,'
      '       p.Natureza,'
      '       p.DataIncAlt,'
      '       p.DemoSPED'
      ''
      'FROM   planocontas p'
      ''
      'WHERE  p.Codigo IS NOT NULL'
      ''
      '   AND  ((:Campo = 0)    AND'
      '         (:Operacao = 0) AND (Codigo  = :Codigo))'
      ''
      
        '   OR ((:Campo = 1) AND /*--------------------------------------' +
        '-------------------------  Codigo */'
      '               /* PRIMEIRO */'
      '              ((:Operacao = 1 AND Codigo = (SELECT MIN(Codigo)'
      
        '                                               FROM PlanoContas)' +
        ')'
      '               /* ANTERIOR */'
      '            OR (:Operacao = 2 AND Codigo = (SELECT MAX(Codigo)'
      '                                               FROM PlanoContas'
      
        '                                               WHERE Codigo < :C' +
        'odigo))'
      '               /* PR'#211'XIMO */'
      '            OR (:Operacao = 3 AND Codigo = (SELECT MIN(Codigo)'
      '                                               FROM PlanoContas'
      
        '                                               WHERE Codigo > :C' +
        'odigo))'
      '               /* '#218'LTIMO */'
      '            OR (:Operacao = 4 AND Codigo = (SELECT MAX(Codigo)'
      
        '                                               FROM PlanoContas)' +
        ')))'
      '                                               '
      
        '   OR ((:Campo = 2) AND /*--------------------------------------' +
        '------------------- Classificacao */'
      '              /* PRIMEIRO */'
      '              ((:Operacao = 1 AND Codigo = (SELECT Codigo '
      '                                              FROM PlanoContas'
      
        '                                              WHERE Classificaca' +
        'o = (SELECT MIN(Classificacao)'
      
        '                                                                ' +
        '        FROM PlanoContas)'
      
        '                                              ORDER BY Classific' +
        'acao,'
      
        '                                                       UPPER(TO_' +
        'ASCII(Descricao,'#39'LATIN1'#39')),'
      
        '                                                       Codigo LI' +
        'MIT 1))'
      ''
      '               /* ANTERIOR */'
      '            OR (:Operacao = 2 AND Codigo = (SELECT Codigo'
      '                                               FROM PlanoContas'
      
        '                                               WHERE   Classific' +
        'acao < :Classificacao '
      
        '                                                  OR  (Classific' +
        'acao = :Classificacao AND'
      
        '                                                       Descricao' +
        '     < :Descricao)'
      
        '                                                  OR  (Classific' +
        'acao = :Classificacao AND'
      
        '                                                       Descricao' +
        '     = :Descricao     AND'
      
        '                                                       Codigo   ' +
        '     < :Codigo)'
      
        '                                               ORDER BY Classifi' +
        'cacao DESC,'
      
        '                                                        UPPER(TO' +
        '_ASCII(Descricao,'#39'LATIN1'#39')) DESC,'
      
        '                                                        Codigo D' +
        'ESC LIMIT 1))'
      '               /* PR'#211'XIMO */'
      '            OR (:Operacao = 3 AND Codigo = (SELECT Codigo'
      '                                               FROM PlanoContas'
      
        '                                               WHERE   Classific' +
        'acao > :Classificacao '
      
        '                                                  OR  (Classific' +
        'acao = :Classificacao AND'
      
        '                                                       Descricao' +
        '     > :Descricao)'
      
        '                                                  OR  (Classific' +
        'acao = :Classificacao AND'
      
        '                                                       Descricao' +
        '     = :Descricao     AND'
      
        '                                                       Codigo   ' +
        '     > :Codigo)'
      
        '                                               ORDER BY Classifi' +
        'cacao,'
      
        '                                                        UPPER(TO' +
        '_ASCII(Descricao,'#39'LATIN1'#39')),'
      
        '                                                        Codigo L' +
        'IMIT 1))'
      '               /* '#218'LTIMO */'
      '            OR (:Operacao = 4 AND Codigo = (SELECT Codigo '
      '                                               FROM PlanoContas'
      
        '                                               WHERE Classificac' +
        'ao = (SELECT MAX(Classificacao)'
      
        '                                                                ' +
        '         FROM PlanoContas)'
      
        '                                              ORDER BY Classific' +
        'acao DESC,'
      
        '                                                       UPPER(TO_' +
        'ASCII(Descricao,'#39'LATIN1'#39')) DESC,'
      
        '                                                       Codigo DE' +
        'SC LIMIT 1))))'
      ''
      ''
      
        '   OR ((:Campo = 3) AND /*--------------------------------------' +
        '----------------------- Descricao */'
      '               /* PRIMEIRO */'
      '             ((:Operacao = 1 AND Codigo = (SELECT Codigo '
      '                                             FROM PlanoContas'
      
        '                                             WHERE Descricao = (' +
        'SELECT MIN(UPPER(TO_ASCII(Descricao, '#39'LATIN1'#39')))'
      
        '                                                                ' +
        '   FROM PlanoContas)'
      
        '                                             ORDER BY Descricao,' +
        ' Codigo LIMIT 1))'
      ''
      '               /* ANTERIOR */'
      '           OR (:Operacao = 2 AND Codigo = (SELECT Codigo'
      '                                              FROM PlanoContas'
      
        '                                              WHERE  UPPER(TO_AS' +
        'CII( Descricao, '#39'LATIN1'#39')) <'
      
        '                                                     UPPER(TO_AS' +
        'CII(:Descricao, '#39'LATIN1'#39')) '
      
        '                                                 OR (UPPER(TO_AS' +
        'CII( Descricao, '#39'LATIN1'#39')) ='
      
        '                                                     UPPER(TO_AS' +
        'CII(:Descricao, '#39'LATIN1'#39')) AND'
      
        '                                                                ' +
        '                   Codigo < :Codigo)'
      
        '                                               ORDER BY UPPER(TO' +
        '_ASCII(Descricao,'#39'LATIN1'#39')) DESC,'
      
        '                                                        Codigo D' +
        'ESC LIMIT 1))'
      '               /* PR'#211'XIMO */'
      '           OR (:Operacao = 3 AND Codigo = (SELECT Codigo'
      '                                               FROM PlanoContas'
      
        '                                               WHERE  UPPER(TO_A' +
        'SCII( Descricao, '#39'LATIN1'#39')) >'
      
        '                                                      UPPER(TO_A' +
        'SCII(:Descricao, '#39'LATIN1'#39')) '
      
        '                                                  OR (UPPER(TO_A' +
        'SCII( Descricao, '#39'LATIN1'#39')) ='
      
        '                                                      UPPER(TO_A' +
        'SCII(:Descricao, '#39'LATIN1'#39')) AND'
      
        '                                                                ' +
        '                   Codigo > :Codigo)'
      
        '                                               ORDER BY UPPER(TO' +
        '_ASCII(Descricao,'#39'LATIN1'#39')),'
      
        '                                                        Codigo L' +
        'IMIT 1))'
      '               /* '#218'LTIMO */'
      '           OR (:Operacao = 4 AND Codigo = (SELECT Codigo '
      '                                               FROM PlanoContas'
      
        '                                               WHERE Descricao =' +
        ' (SELECT MAX(UPPER(TO_ASCII(Descricao, '#39'LATIN1'#39')))'
      
        '                                                                ' +
        '     FROM PlanoContas)'
      
        '                                              ORDER BY UPPER(TO_' +
        'ASCII(Descricao,'#39'LATIN1'#39')) DESC,'
      
        '                                                       Codigo DE' +
        'SC LIMIT 1))))'
      ''
      
        '   OR ((:Campo = 4) AND /*--------------------------------------' +
        '------------------------- Inativo */'
      '               /* PRIMEIRO */'
      '              ((:Operacao = 1 AND Codigo = (SELECT Codigo'
      '                                              FROM PlanoContas'
      
        '                                              WHERE Inativo IS N' +
        'OT NULL AND'
      
        '                                                    CASE WHEN :I' +
        'nativo <> '#39'01/01/1900'#39
      
        '                                                         THEN ((' +
        'Inativo < :Inativo) OR'
      
        '                                                               (' +
        'Inativo = :Inativo AND Classificacao <= :Classificacao'
      
        '                                                                ' +
        '                   AND Descricao     <= :Descricao'
      
        '                                                                ' +
        '                   AND Codigo        <  :Codigo))'
      
        '                                                         ELSE TR' +
        'UE'
      '                                                    END'
      
        '                                              ORDER BY Inativo, ' +
        'Classificacao, UPPER(TO_ASCII(Descricao,'#39'LATIN1'#39')), Codigo LIMIT' +
        ' 1))'
      '              /* ANTERIOR */'
      '           OR (:Operacao = 2 AND Codigo = (SELECT Codigo'
      '                                              FROM PlanoContas'
      
        '                                              WHERE Inativo IS N' +
        'OT NULL AND'
      
        '                                                    CASE WHEN :I' +
        'nativo <> '#39'01/01/1900'#39
      
        '                                                         THEN In' +
        'ativo < :Inativo OR CASE WHEN Inativo        = :Inativo       AN' +
        'D'
      
        '                                                                ' +
        '                              Classificacao <= :Classificacao AN' +
        'D'
      
        '                                                                ' +
        '                              Descricao     <= :Descricao'
      
        '                                                                ' +
        '                         THEN Inativo        = :Inativo       AN' +
        'D'
      
        '                                                                ' +
        '                              Classificacao <= :Classificacao AN' +
        'D'
      
        '                                                                ' +
        '                              Descricao     <= :Descricao     AN' +
        'D'
      
        '                                                                ' +
        '                              Codigo        <  :Codigo'
      
        '                                                                ' +
        '                                 '
      
        '                                                                ' +
        '                         ELSE Inativo        = :Inativo       AN' +
        'D'
      
        '                                                                ' +
        '                              Classificacao <= :Classificacao AN' +
        'D'
      
        '                                                                ' +
        '                              Descricao     <= :Descricao '
      
        '                                                                ' +
        '                    END'
      
        '                                                         ELSE TR' +
        'UE'
      '                                                    END'
      
        '                                              ORDER BY Inativo D' +
        'ESC, Classificacao DESC,'
      
        '                                                       UPPER(TO_' +
        'ASCII(Descricao,'#39'LATIN1'#39')) DESC, Codigo DESC LIMIT 1))'
      '              /* PR'#211'XIMO */'
      '           OR (:Operacao = 3 AND Codigo = (SELECT Codigo'
      '                                              FROM PlanoContas'
      
        '                                              WHERE Inativo IS N' +
        'OT NULL AND'
      
        '                                                    CASE WHEN :I' +
        'nativo <> '#39'01/01/1900'#39
      
        '                                                         THEN In' +
        'ativo > :Inativo OR CASE WHEN Inativo        = :Inativo       AN' +
        'D'
      
        #9#9#9#9#9#9'                                  Classificacao >= :Classi' +
        'ficacao AND'
      
        '                                                                ' +
        '                              Descricao     >= :Descricao'
      
        ' '#9#9#9#9#9#9' '#9'                   THEN Inativo        = :Inativo      ' +
        ' AND'
      
        #9#9#9#9#9#9#9'                        Classificacao >= :Classificacao A' +
        'ND'
      
        '                                                                ' +
        '                              Descricao     >= :Descricao     AN' +
        'D'
      #9#9#9#9#9#9#9'                        Codigo        >  :Codigo'
      
        '                                                                ' +
        '                                '
      
        #9#9#9#9#9#9#9'                   ELSE Inativo        = :Inativo       A' +
        'ND'
      
        #9#9#9#9#9#9#9'                        Classificacao >= :Classificacao A' +
        'ND'
      #9#9#9#9#9#9#9'                        Descricao     >= :Descricao'
      
        '                                                                ' +
        '                    END'
      
        '                                                         ELSE TR' +
        'UE'
      '                                                    END'
      
        '                                              ORDER BY Inativo, ' +
        'Classificacao, UPPER(TO_ASCII(Descricao,'#39'LATIN1'#39')), Codigo LIMIT' +
        ' 1))'
      '              /* '#218'LTIMO */'
      '           OR (:Operacao = 4 AND Codigo = (SELECT Codigo'
      '                                              FROM PlanoContas'
      
        '                                              WHERE  Inativo > :' +
        'Inativo OR'
      
        '                                                    (Inativo = :' +
        'Inativo AND Classificacao = :Classificacao AND'
      
        '                                                                ' +
        '            Descricao    >= :Descricao     AND'
      
        '                                                                ' +
        '            Codigo        > :Codigo)'
      
        '                                              ORDER BY Inativo D' +
        'ESC, Classificacao DESC,'
      
        '                                                       UPPER(TO_' +
        'ASCII(Descricao,'#39'LATIN1'#39')) DESC, Codigo DESC LIMIT 1))))'
      '%Ordenacao')
    RequestLive = True
    Left = 32
    Top = 8
    ParamData = <
      item
        DataType = ftInteger
        Name = 'Campo'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'Operacao'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'Codigo'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'classificacao'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'descricao'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'inativo'
        ParamType = ptUnknown
      end>
