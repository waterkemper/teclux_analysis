    Sql.Strings = (
      
        'SELECT   cast(repeat('#39' '#39', length(btrim(pl.classificacao)))||pl.D' +
        'escricao as varchar) as DescricaoEdentada,'
      '         pl.classificacao,'
      '         pl.Codigo,'
      '         pl.tipo,'
      '         sc.filial,    '
      '         f.razao,'
      '         formatar_cpf_cnpj(f.cnpj) as cnpj,'
      '         f.inscricaoestadual,'
      '         pl.inativo,'
      '         pr.classificacao as classificacaoreferencial,'
      '         pr.descricao as descricaoreferencial'
      
        'from (planocontas pl left join (saldoscontabeis sc join filiais ' +
        'f on sc.filial = f.codigo)'
      
        '                                                                ' +
        '                   on pl.codigo = sc.conta)'
      
        '                     left join planoreferencial pr on pl.referen' +
        'cia = pr.codigo'
      
        'WHERE ((sc.exercicio = EXTRACT(year from cast(:datainicial as da' +
        'te))) or not cast(:SoComSaldo as boolean))'
      '     %Condicaotipo'
      '     %CondicaoConta'
      '     %Movtos'
      '     %Filiais'
      '     %DataInatividade'
      '%Ordenacao')
