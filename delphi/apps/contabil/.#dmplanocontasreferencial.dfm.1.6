    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereClassificacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      
        'SELECT   cast(repeat('#39' '#39', length(btrim(p.classificacao)))||p.Des' +
        'cricao as varchar) as Descricao,'
      '         p.classificacao,'
      '         p.Codigo,'
      '         p.tipo,'
      ''
      '         (select count(*)'
      '          from planoreferencial'
      '          where strpos(classificacao,:ultimaclassificacao)=1'
      '             and tipo='#39'S'#39
      '             and classificacao<>:ultimaclassificacao'
      
        '             and codigo <> :codigoselecionado) as nsinteticasult' +
        'ima,'
      ''
      '         (select count(*)'
      '          from planoreferencial'
      '          where strpos(classificacao,:ultimaclassificacao)=1'
      '             and tipo='#39'A'#39
      
        '             and codigo <> :codigoselecionado) as nanaliticasult' +
        'ima'
      ''
      'FROM     planoreferencial  p'
      ''
      'WHERE p.tipo = '#39'S'#39
      '     AND p.codigo IS NOT NULL'
      '     and p.tipoplano = :tipoplano'
      '%WhereClassificacao'
      ''
      'ORDER BY p.classificacao')
