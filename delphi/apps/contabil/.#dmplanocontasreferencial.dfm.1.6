  object qryPlanoContas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryPlanoContasBeforeOpen
    AfterOpen = qryPlanoContasAfterOpen
    AfterClose = qryPlanoContasAfterClose
    BeforeInsert = qryPlanoContasBeforeInsert
    AfterCancel = qryPlanoContasAfterCancel
    AfterScroll = qryPlanoContasAfterScroll
    OnNewRecord = qryPlanoContasNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Ordenacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'SELECT p.TipoPlano,'
      '       p.Codigo,'
      '       p.Classificacao,'
      '       p.Tipo,'
      '       p.Descricao,'
      '       p.Orientacoes,'
      '       p.ValidoDesde,'
      '       p.ValidoAte'
      ''
      'FROM   planoreferencial  p'
      ''
      'WHERE  p.TipoPlano = :TipoPlano'
      '  AND  p.Codigo IS NOT NULL'
      ''
      '  AND  ((:Campo    = 0) AND'
      '        (:Operacao = 0) AND (Codigo = :Codigo))'
      ''
      ''
      
        '   OR ((:Campo = 1) AND /*--------------------------------------' +
        '-------------------------  Codigo */'
      '               /* PRIMEIRO */'
      '              ((:Operacao = 1 AND Codigo = (SELECT MIN(Codigo)'
      
        '                                               FROM PlanoReferen' +
        'cial'
      
        '                                               WHERE TipoPlano =' +
        ' :TipoPlano))'
      ''
      '               /* ANTERIOR */'
      '            OR (:Operacao = 2 AND Codigo = (SELECT MAX(Codigo)'
      
        '                                               FROM PlanoReferen' +
        'cial'
      
        '                                               WHERE TipoPlano =' +
        ' :TipoPlano AND'
      
        '                                                     Codigo    <' +
        ' :Codigo))'
      '               /* PR'#211'XIMO */'
      '            OR (:Operacao = 3 AND Codigo = (SELECT MIN(Codigo)'
      
        '                                               FROM PlanoReferen' +
        'cial'
      
        '                                               WHERE TipoPlano =' +
        ' :TipoPlano AND'
      
        '                                                     Codigo    >' +
        ' :Codigo))'
      '               /* '#218'LTIMO */'
      '            OR (:Operacao = 4 AND Codigo = (SELECT MAX(Codigo)'
      
        '                                               FROM PlanoReferen' +
        'cial'
      
        '                                               WHERE TipoPlano =' +
        ' :TipoPlano))))'
      ''
      ''
      
        '   OR ((:Campo = 2) AND /*--------------------------------------' +
        '------------------- Classificacao */'
      '              /* PRIMEIRO */'
      '              ((:Operacao = 1 AND Codigo = (SELECT Codigo'
      
        '                                              FROM PlanoReferenc' +
        'ial'
      
        '                                              WHERE TipoPlano   ' +
        '  = :TipoPlano AND'
      
        '                                                    Classificaca' +
        'o = (SELECT MIN(Classificacao)'
      
        '                                                                ' +
        '        FROM PlanoReferencial'
      
        '                                                                ' +
        '        WHERE TipoPlano = :TipoPlano)'
      
        '                                              ORDER BY Classific' +
        'acao,'
      
        '                                                       UPPER(TO_' +
        'ASCII(Descricao,'#39'LATIN1'#39')),'
      
        '                                                       Codigo LI' +
        'MIT 1))'
      ''
      '               /* ANTERIOR */'
      '            OR (:Operacao = 2 AND Codigo = (SELECT Codigo'
      
        '                                               FROM PlanoReferen' +
        'cial'
      
        '                                               WHERE   TipoPlano' +
        '     = :TipoPlano     AND'
      
        '                                                      (Classific' +
        'acao < :Classificacao'
      
        '                                                  OR  (Classific' +
        'acao = :Classificacao AND'
      
        '                                                       Descricao' +
        '     < :Descricao)'
      
        '                                                  OR  (Classific' +
        'acao = :Classificacao AND'
      
        '                                                       Descricao' +
        '     = :Descricao     AND'
      
        '                                                       Codigo   ' +
        '     < :Codigo))'
      
        '                                               ORDER BY Classifi' +
        'cacao DESC,'
      
        '                                                        UPPER(TO' +
        '_ASCII(Descricao,'#39'LATIN1'#39')) DESC,'
      
        '                                                        Codigo D' +
        'ESC LIMIT 1))'
      '               /* PR'#211'XIMO */'
      '            OR (:Operacao = 3 AND Codigo = (SELECT Codigo'
      
        '                                               FROM PlanoReferen' +
        'cial'
      
        '                                               WHERE   TipoPlano' +
        '     = :TipoPlano     AND'
      
        '                                                      (Classific' +
        'acao > :Classificacao'
      
        '                                                  OR  (Classific' +
        'acao = :Classificacao AND'
      
        '                                                       Descricao' +
        '     > :Descricao)'
      
        '                                                  OR  (Classific' +
        'acao = :Classificacao AND'
      
        '                                                       Descricao' +
        '     = :Descricao     AND'
      
        '                                                       Codigo   ' +
        '     > :Codigo))'
      
        '                                               ORDER BY Classifi' +
        'cacao,'
      
        '                                                        UPPER(TO' +
        '_ASCII(Descricao,'#39'LATIN1'#39')),'
      
        '                                                        Codigo L' +
        'IMIT 1))'
      '               /* '#218'LTIMO */'
      '            OR (:Operacao = 4 AND Codigo = (SELECT Codigo'
      
        '                                               FROM PlanoReferen' +
        'cial'
      
        '                                               WHERE TipoPlano  ' +
        '   = :TipoPlano AND'
      
        '                                                     Classificac' +
        'ao = (SELECT MAX(Classificacao)'
      
        '                                                                ' +
        '         FROM PlanoReferencial'
      
        '                                                                ' +
        '         WHERE TipoPlano = :TipoPlano)'
      
        '                                              ORDER BY Classific' +
        'acao DESC,'
      
        '                                                       UPPER(TO_' +
        'ASCII(Descricao,'#39'LATIN1'#39')) DESC,'
      
        '                                                       Codigo DE' +
        'SC LIMIT 1))))'
      ''
      ''
      
        '   OR ((:Campo = 3) AND /*--------------------------------------' +
        '----------------------- Descricao */'
      '               /* PRIMEIRO */'
      '             ((:Operacao = 1 AND Codigo = (SELECT Codigo'
      
        '                                             FROM PlanoReferenci' +
        'al'
      
        '                                             WHERE TipoPlano = :' +
        'TipoPlano AND'
      
        '                                                   Descricao = (' +
        'SELECT MIN(UPPER(TO_ASCII(Descricao, '#39'LATIN1'#39')))'
      
        '                                                                ' +
        '   FROM PlanoReferencial'
      
        '                                                                ' +
        '   WHERE TipoPlano = :TipoPlano)'
      
        '                                             ORDER BY Descricao,' +
        ' Codigo LIMIT 1))'
      ''
      '               /* ANTERIOR */'
      '           OR (:Operacao = 2 AND Codigo = (SELECT Codigo'
      
        '                                              FROM PlanoReferenc' +
        'ial'
      
        '                                              WHERE  TipoPlano =' +
        ' :TipoPlano AND'
      
        '                                                    (UPPER(TO_AS' +
        'CII( Descricao, '#39'LATIN1'#39')) <'
      
        '                                                     UPPER(TO_AS' +
        'CII(:Descricao, '#39'LATIN1'#39'))'
      
        '                                                 OR (UPPER(TO_AS' +
        'CII( Descricao, '#39'LATIN1'#39')) ='
      
        '                                                     UPPER(TO_AS' +
        'CII(:Descricao, '#39'LATIN1'#39')) AND'
      
        '                                                                ' +
        '                  Codigo < :Codigo))'
      
        '                                               ORDER BY UPPER(TO' +
        '_ASCII(Descricao,'#39'LATIN1'#39')) DESC,'
      
        '                                                        Codigo D' +
        'ESC LIMIT 1))'
      '               /* PR'#211'XIMO */'
      '           OR (:Operacao = 3 AND Codigo = (SELECT Codigo'
      
        '                                               FROM PlanoReferen' +
        'cial'
      
        '                                               WHERE  TipoPlano ' +
        '= :TipoPlano AND'
      
        '                                                     (UPPER(TO_A' +
        'SCII( Descricao, '#39'LATIN1'#39')) >'
      
        '                                                      UPPER(TO_A' +
        'SCII(:Descricao, '#39'LATIN1'#39'))'
      
        '                                                  OR (UPPER(TO_A' +
        'SCII( Descricao, '#39'LATIN1'#39')) ='
      
        '                                                      UPPER(TO_A' +
        'SCII(:Descricao, '#39'LATIN1'#39')) AND'
      
        '                                                                ' +
        '                  Codigo > :Codigo))'
      
        '                                               ORDER BY UPPER(TO' +
        '_ASCII(Descricao,'#39'LATIN1'#39')),'
      
        '                                                        Codigo L' +
        'IMIT 1))'
      '               /* '#218'LTIMO */'
      '           OR (:Operacao = 4 AND Codigo = (SELECT Codigo'
      
        '                                               FROM PlanoReferen' +
        'cial'
      
        '                                               WHERE TipoPlano =' +
        ' :TipoPlano AND'
      
        '                                                     Descricao =' +
        ' (SELECT MAX(UPPER(TO_ASCII(Descricao, '#39'LATIN1'#39')))'
      
        '                                                                ' +
        '     FROM PlanoReferencial'
      
        '                                                                ' +
        '     WHERE TipoPlano = :TipoPlano)'
      
        '                                              ORDER BY UPPER(TO_' +
        'ASCII(Descricao,'#39'LATIN1'#39')) DESC,'
      
        '                                                       Codigo DE' +
        'SC LIMIT 1))))'
      ''
      '%Ordenacao')
    RequestLive = True
    Left = 72
    Top = 24
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'TipoPlano'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'Campo'
        ParamType = ptUnknown
      end
