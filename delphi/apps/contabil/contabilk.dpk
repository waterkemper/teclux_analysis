package contabilk;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Contabilidade'}
{$SONAME 'contabil'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  repositoriok;

contains
  rgcontabil in 'rgcontabil.pas',
  dmplanocontas in 'dmplanocontas.pas' {dtmPlanoContas: TDataModule},
  fmplanocontas in 'fmplanocontas.pas' {frmPlanoContas},
  dmlivrorazao in 'dmlivrorazao.pas' {dtmLivroRazao: TDataModule},
  fmlivrorazao in 'fmlivrorazao.pas' {frmLivroRazao},
  dmemissaobalancetes in 'dmemissaobalancetes.pas' {dtmEmissaoBalancetes: TDataModule},
  fmemissaobalancetes in 'fmemissaobalancetes.pas' {frmEmissaoBalancetes},
  dmlivrodiario in 'dmlivrodiario.pas' {dtmLivroDiario: TDataModule},
  fmlivrodiario in 'fmlivrodiario.pas' {frmLivroDiario},
  dmlancamentocontas in 'dmlancamentocontas.pas' {dtmLancamentoContas: TDataModule},
  fmtranferenciasaldoscontabeis in 'fmtranferenciasaldoscontabeis.pas' {frmTransferirSaldosContabeis},
  fmencerramentoexercicio in 'fmencerramentoexercicio.pas' {frmEncerramentoExercicio},
  fmlancamentocontas in 'fmlancamentocontas.pas' {frmLancamentosContas},
  dmimpressaolotes in 'dmimpressaolotes.pas' {dtmImpressaoLotes: TDataModule},
  fmimpressaolotes in 'fmimpressaolotes.pas' {frmImpressaoLotes},
  dmbalancetefinanceiro in 'dmbalancetefinanceiro.pas' {dtmbalancetefinanceiro: TDataModule},
  fmbalancetefinanceiro in 'fmbalancetefinanceiro.pas' {frmbalancetefinanceiro};

end.
