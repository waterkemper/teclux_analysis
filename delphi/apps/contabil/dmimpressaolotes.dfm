  object qryImpressaoLotes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = '100'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datalancto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'dataalteracao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Origem'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Lotes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'conta'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'SELECT *,'
      '       CAST(CASE WHEN (Origem = '#39'D'#39') or'
      '                      (Origem = '#39'A'#39')'
      '                                    THEN '#39'DOC. ENTRADA '#39' ||'
      
        '                                        (SELECT  d.TipoFornecedo' +
        'r || '#39': '#39' ||'
      
        '                                                 CAST(d.Forneced' +
        'or AS VARCHAR) || '#39' '#39' ||'
      
        '                                                 COALESCE(vf.Raz' +
        'ao, vf.Nome) || '#39' N'#186' '#39' || CAST(NrOrigem AS VARCHAR)'
      
        '                                            FROM DocumentosPag d' +
        ', vFornecedores vf'
      
        '                                            WHERE d.Fornecedor  ' +
        '   = vf.Codigo AND'
      
        '                                                  d.TipoForneced' +
        'or = vf.Tipo   AND'
      
        '                                                  d.Numero      ' +
        '   = NrOrigem)'
      ''
      
        '                 WHEN Origem = '#39'X'#39' THEN '#39'ENCERRAMENTO N'#186' '#39' || CA' +
        'ST(NrOrigem AS VARCHAR)'
      
        '                 WHEN Origem = '#39'I'#39' THEN '#39'IMPORTA'#199#195'O N'#186' '#39' || CAST' +
        '(NrOrigem AS VARCHAR)'
      '                 WHEN Origem = '#39'M'#39' THEN '#39'LAN'#199'AMENTO MANUAL'#39
      
        '                 WHEN Origem = '#39'L'#39' THEN '#39'LOTE N'#186' '#39' || CAST(NrOri' +
        'gem AS VARCHAR)'
      '                 WHEN Origem = '#39'E'#39' THEN '#39'NF ENTRADA '#39' ||'
      
        '                                        (SELECT np.TipoFornecedo' +
        'r || '#39': '#39' ||'
      
        '                                                CAST(np.Forneced' +
        'or AS VARCHAR) || '#39' '#39' || COALESCE(vf.Razao, vf.Nome) ||'
      
        '                                                '#39' S: '#39' || np.Ser' +
        'ie ||'
      
        '                                                '#39' N'#186' '#39' || CAST(n' +
        'p.Numero AS VARCHAR)'
      
        '                                            FROM NotasPag np, vF' +
        'ornecedores vf'
      
        '                                            WHERE np.Fornecedor ' +
        '    = vf.Codigo AND'
      
        '                                                  np.TipoFornece' +
        'dor = vf.Tipo   AND'
      
        '                                                  np.Codigo     ' +
        '    = NrOrigem)'
      ''
      '                 WHEN Origem = '#39'P'#39' THEN  '#39'DUPLICATA  '#39' ||'
      
        '                                         (SELECT d.TipoFornecedo' +
        'r || '#39': '#39' ||'
      
        '                                                 CAST(d.Forneced' +
        'or AS VARCHAR) || '#39' '#39' || COALESCE(vf.Razao, vf.Nome) ||'
      
        '                                                 '#39' N'#186' '#39' || CAST(' +
        'NrOrigem AS VARCHAR) || '#39'/'#39' ||'
      
        '                                                 CAST(NrOrigem %' +
        ' 100 AS VARCHAR)'
      
        '                                             FROM DocumentosPag ' +
        'd, vFornecedores vf'
      
        '                                             WHERE d.Fornecedor ' +
        '    = vf.Codigo AND'
      
        '                                                   d.TipoFornece' +
        'dor = vf.Tipo   AND'
      
        '                                                   d.Numero     ' +
        '    = NrOrigem / 100)'
      
        '                 WHEN Origem = '#39'R'#39' THEN '#39'RECEBIMENTO Contrato: '#39 +
        ' ||CAST(NrOrigem / 100 AS VARCHAR) ||'
      
        '                                        '#39' N'#186' '#39' || CAST(NrOrigem ' +
        '% 100 AS VARCHAR)'
      ''
      '                 WHEN Origem = '#39'S'#39' THEN '#39'NF SA'#205'DA'#39
      ''
      '                 WHEN Origem = '#39'B'#39' THEN '#39'MOVTOS BANC'#193'RIOS'#39
      ''
      '            END AS VARCHAR'
      '           ) AS DescricaoNrOrigem,'
      ''
      ''
      '       CAST(CASE WHEN (Origem = '#39'D'#39') or'
      '                      (Origem = '#39'A'#39')'
      
        '                                   THEN '#39'A'#39' || CAST(NrOrigem AS ' +
        'VARCHAR)'
      
        '/*                                 (SELECT LPAD(CAST(d.Fornecedo' +
        'r AS VARCHAR),9,'#39'0'#39') ||'
      
        '                                           d.DataLancto || LPAD(' +
        'CAST(NrOrigem AS VARCHAR),9,'#39'0'#39')'
      
        '                                       FROM DocumentosPag d, vFo' +
        'rnecedores vf'
      
        '                                       WHERE d.Fornecedor     = ' +
        'vf.Codigo AND'
      
        '                                             d.TipoFornecedor = ' +
        'vf.Tipo   AND'
      
        '                                             d.Numero         = ' +
        'NrOrigem)'
      '*/'
      '                 WHEN Origem = '#39'X'#39' THEN '#39'B'#39' ||'
      
        '                                        LPAD(CAST(NrOrigem AS VA' +
        'RCHAR),9,'#39'0'#39') ||'
      
        '                                        CAST(Data AS VARCHAR) ||' +
        ' LPAD(CAST(NrLancto AS VARCHAR),9,'#39'0'#39')'
      ''
      
        '                 WHEN Origem = '#39'M'#39' THEN '#39'C'#39' || CAST(Data AS VARC' +
        'HAR)||'
      
        '                                        LPAD(CAST(NrLancto AS VA' +
        'RCHAR),9,'#39'0'#39')'
      ''
      
        '                 WHEN Origem in ('#39'I'#39', '#39'L'#39') THEN '#39'D'#39' || LPAD(CAST' +
        '(NrOrigem AS VARCHAR),9,'#39'0'#39') ||'
      
        '                                                CASE WHEN :Orden' +
        'acaoPorData'
      
        '                                                     THEN CAST(D' +
        'ata AS VARCHAR) || LPAD(CAST(NrLancto AS VARCHAR),9,'#39'0'#39')'
      
        '                                                     ELSE LPAD(C' +
        'AST(NrLancto AS VARCHAR),9,'#39'0'#39') || CAST(Data AS VARCHAR)'
      '                                                END'
      ''
      
        '                 WHEN Origem = '#39'E'#39' THEN '#39'E'#39' || CAST(NrOrigem AS ' +
        'VARCHAR)'
      
        '/*                                 (SELECT LPAD(CAST(np.Forneced' +
        'or AS VARCHAR),9,'#39'0'#39') ||'
      
        '                                           np.Serie || LPAD(CAST' +
        '(np.Numero AS VARCHAR),9,'#39'0'#39')'
      
        '                                       FROM NotasPag np, vFornec' +
        'edores vf'
      
        '                                       WHERE np.Fornecedor     =' +
        ' vf.Codigo AND'
      
        '                                             np.TipoFornecedor =' +
        ' vf.Tipo   AND'
      
        '                                             np.Codigo = NrOrige' +
        'm)'
      '*/'
      
        '                 WHEN Origem = '#39'S'#39' THEN '#39'F'#39' || CAST(NrOrigem AS ' +
        'VARCHAR)'
      ''
      '                 WHEN Origem = '#39'P'#39' THEN '#39'G'#39' ||'
      
        '                                   (SELECT LPAD(CAST(d.Fornecedo' +
        'r AS VARCHAR),9,'#39'0'#39') ||'
      
        '                                            CAST(d.DataLancto AS' +
        ' VARCHAR) ||'
      
        '                                           LPAD(CAST(NrOrigem / ' +
        '100 AS VARCHAR),9,'#39'0'#39') ||'
      
        '                                           CAST(NrOrigem % 100 A' +
        'S VARCHAR)'
      
        '                                       FROM DocumentosPag d, vFo' +
        'rnecedores vf'
      
        '                                       WHERE d.Fornecedor     = ' +
        'vf.Codigo AND'
      
        '                                             d.TipoFornecedor = ' +
        'vf.Tipo   AND'
      
        '                                             d.Numero         = ' +
        'NrOrigem /100)'
      ''
      
        '                 WHEN Origem = '#39'R'#39' THEN '#39'H'#39' || CAST(NrOrigem AS ' +
        'VARCHAR)'
      ''
      
        '                 WHEN Origem = '#39'B'#39' THEN '#39'I'#39' || CAST(Data AS VARC' +
        'HAR) ||'
      
        '                                        LPAD(CAST(NrLancto AS VA' +
        'RCHAR),9,'#39'0'#39')'
      ''
      '            END || Ordenacao AS VARCHAR'
      '            ) AS OrdenacaoDescricaoNrOrigem'
      'FROM'
      '   ('
      '    ('
      '     SELECT l.Data,'
      #9'    l.NrLancto,'
      #9'    l.Filial,'
      #9'    l.Historico,'
      #9'    COALESCE((SELECT h.Descricao'
      '                         FROM Historicos h'
      '                         WHERE h.Codigo = l.Historico),'#39#39') ||'
      
        '                    '#39' '#39' || COALESCE(l.Complemento,'#39#39') AS Descric' +
        'aoHistoricoComplemento,'
      #9'    pl.Codigo,'
      #9'    pl.Descricao,'
      #9'    l.Valor AS ValorDebito,'
      #9'    CAST(NULL AS NUMERIC) AS ValorCredito,'
      #9'    CAST('#39'A'#39' AS VARCHAR) AS Ordenacao,'
      '            l.Origem,'
      '            l.NrOrigem'
      ''
      
        '     FROM PlanoContas pl JOIN Lancamentos l ON pl.Codigo = l.Deb' +
        'itar'
      ''
      '     WHERE l.Filial = :Filial'
      '           %DataLancto'
      '           %DataAlteracao'
      '           %Origem'
      '           %Lotes'
      '           %Conta'
      '     ORDER BY l.NrOrigem, l.Data, l.NrLancto,'
      '              UPPER(TO_ASCII(pl.Descricao,'#39'LATIN1'#39')), pl.Codigo'
      '    )'
      '    UNION ALL'
      '    ('
      '     SELECT l.Data,'
      #9'    l.NrLancto,'
      #9'    l.Filial,'
      #9'    l.Historico,'
      #9'    COALESCE((SELECT h.Descricao'
      '                         FROM Historicos h'
      '                         WHERE h.Codigo = l.Historico),'#39#39') ||'
      
        '                    '#39' '#39' || COALESCE (l.Complemento,'#39#39') AS Descri' +
        'caoHistoricoComplemento,'
      #9'    pl.Codigo,'
      #9'    pl.Descricao,'
      #9'    CAST(NULL AS NUMERIC) AS ValorDebito,'
      #9'    l.Valor AS ValorCredito,'
      #9'    CAST('#39'B'#39' AS VARCHAR) AS Ordenacao,'
      '            l.Origem,'
      '            l.NrOrigem'
      ''
      
        '     FROM PlanoContas pl JOIN Lancamentos l ON pl.Codigo = l.cre' +
        'ditar'
      ''
      '     WHERE l.Filial = :Filial'
      '           %DataLancto'
      '           %DataAlteracao'
      '           %Origem'
      '           %Lotes'
      '           %Conta'
      '     ORDER BY l.NrOrigem, l.Data, l.NrLancto,'
      '              UPPER(TO_ASCII(pl.Descricao,'#39'LATIN1'#39')), pl.Codigo'
      '    )'
      '   ) AS Saldos'
      ''
      'ORDER BY OrdenacaoDescricaoNrOrigem')
    RequestLive = False
    Left = 64
    Top = 8
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'ordenacaopordata'
        ParamType = ptUnknown
