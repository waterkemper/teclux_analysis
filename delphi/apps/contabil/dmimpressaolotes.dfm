  object qryImpressaoTotaisLotes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = '100'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datalancto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'dataalteracao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Origem'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Lotes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'conta'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'select DescricaoNrOrigem,'
      '          sum(ValorDebito) as ValorDebito,'
      '          sum(ValorCredito) as ValorCredito,'
      '          codigo,'
      '          descricao,'
      '          classificacao'
      'from'
      '('
      '  select *,'
      '       CAST(CASE WHEN (Origem = '#39'D'#39') or'
      '                      (Origem = '#39'A'#39')'
      
        '                                          THEN '#39'DOC. ENTRADA '#39' |' +
        '|'
      
        '                                                                ' +
        '  (select d.tipofornecedor ||'#39': '#39'||'
      
        '                                                                ' +
        '            d.fornecedor ||'#39' '#39'||'
      
        '                                                                ' +
        '            coalesce(vf.razao,vf.nome) as nome  ||'#39' N'#186' '#39'||'
      
        '                                                                ' +
        '            nrOrigem'
      
        '                                                                ' +
        '   from documentospag d, vfornecedores vf'
      
        '                                                                ' +
        '   where d.fornecedor = vf.codigo and'
      
        '                                                                ' +
        '             d.tipofornecedor = vf.tipo and'
      
        '                                                                ' +
        '             d.numero = nrOrigem)'
      
        '                          WHEN Origem = '#39'X'#39' THEN '#39'ENCERRAMENTO N' +
        #186' '#39' || NrOrigem'
      
        '                          WHEN Origem = '#39'I'#39' THEN '#39'IMPORTA'#199#195'O N'#186' ' +
        #39' || NrOrigem'
      
        '                          WHEN Origem = '#39'M'#39' THEN '#39'LAN'#199'AMENTO MAN' +
        'UAL'#39
      
        '                          WHEN Origem = '#39'L'#39' THEN '#39'LOTE N'#186' '#39' || N' +
        'rOrigem'
      
        '                          WHEN Origem = '#39'E'#39' THEN '#39'NF ENTRADA '#39' |' +
        '|'
      
        '                                                        (select ' +
        'np.tipofornecedor||'#39': '#39'||'
      
        '                                                                ' +
        '   np.fornecedor ||'#39' '#39'||'
      
        '                                                                ' +
        '   coalesce(vf.razao,vf.nome) as nome  ||'#39' S: '#39'||'
      
        '                                                                ' +
        '   np.serie ||'#39' N'#186' '#39'||'
      
        '                                                                ' +
        '   np.numero'
      
        '                                                         from no' +
        'taspag np, vfornecedores vf'
      
        '                                                         where n' +
        'p.fornecedor = vf.codigo and'
      
        '                                                                ' +
        '   np.tipofornecedor = vf.tipo and'
      
        '                                                                ' +
        '   np.codigo = nrOrigem)'
      '                         WHEN Origem = '#39'P'#39' THEN  '#39'DUPLICATA  '#39'||'
      
        '                                                                ' +
        '  (select d.tipofornecedor ||'#39': '#39'||'
      
        '                                                                ' +
        '            d.fornecedor ||'#39' '#39'||'
      
        '                                                                ' +
        '            coalesce(vf.razao,vf.nome) as nome  ||'#39' N'#186' '#39'||nrOrig' +
        'em||'#39'/'#39'||nrOrigem%100'
      
        '                                                                ' +
        '   from documentospag d, vfornecedores vf'
      
        '                                                                ' +
        '   where d.fornecedor = vf.codigo and'
      
        '                                                                ' +
        '             d.tipofornecedor = vf.tipo and'
      
        '                                                                ' +
        '             d.numero = nrOrigem/100)'
      
        '                         WHEN Origem = '#39'R'#39' THEN  '#39'RECEBIMENTO Co' +
        'ntrato: '#39'||nrOrigem/100||'#39' N'#186' '#39'||nrOrigem%100'
      '                         WHEN Origem = '#39'S'#39' THEN '#39'NF SA'#205'DA'#39
      '            END AS VARCHAR'
      '            ) AS DescricaoNrOrigem'
      '  from'
      '   ('
      '    ('
      '     select     pl.codigo,'
      #9'    pl.descricao,'
      '                  pl.classificacao,'
      #9'    l.valor as valordebito,'
      #9'    cast(null as numeric) as valorcredito,'
      '                  l.origem,'
      '                  l.nrOrigem'
      
        '     from planocontas pl join lancamentos l on pl.codigo = l.deb' +
        'itar'
      '     where l.filial = :filial'
      '     %datalancto'
      '     %dataalteracao'
      '     %Origem'
      '     %Lotes'
      '     %conta'
      
        '     order by l.nrOrigem, l.data, l.nrlancto, UPPER(TO_ASCII(pl.' +
        'Descricao,'#39'LATIN1'#39')), pl.codigo'
      '    )'
      '    union all'
      '    ('
      '     select     pl.codigo,'
      #9'    pl.descricao,'
      '                  pl.classificacao,'
      #9'    cast(null as numeric) as valordebito,'
      #9'    l.valor as valorcredito,'
      '                  l.origem,'
      '                  l.nrOrigem'
      
        '     from planocontas pl join lancamentos l on pl.codigo = l.cre' +
        'ditar'
      '     where l.filial = :filial'
      '       %datalancto'
      '       %dataalteracao'
      '       %Origem'
      '        %Lotes'
      '        %conta'
      
        '     order by l.nrOrigem, l.data, l.nrlancto, UPPER(TO_ASCII(pl.' +
        'Descricao,'#39'LATIN1'#39')), pl.codigo'
      '    )'
      '   ) as saldos'
      
        'Order by DescricaoNrOrigem, codigo, UPPER(TO_ASCII(Descricao,'#39'LA' +
        'TIN1'#39'))'
      ')  as saldos'
      'group by DescricaoNrOrigem, codigo, descricao, classificacao'
      
        'order by DescricaoNrOrigem, UPPER(TO_ASCII(Descricao,'#39'LATIN1'#39')),' +
        ' classificacao')
    RequestLive = False
    Left = 184
    Top = 136
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
    object qryImpressaoTotaisLotesdescricaonrorigem: TStringField
      FieldName = 'descricaonrorigem'
      Size = 150
    end
    object qryImpressaoTotaisLotesvalordebito: TFloatField
      FieldName = 'valordebito'
    end
    object qryImpressaoTotaisLotesvalorcredito: TFloatField
      FieldName = 'valorcredito'
    end
    object qryImpressaoTotaisLotescodigo: TIntegerField
      FieldName = 'codigo'
    end
    object qryImpressaoTotaisLotesdescricao: TStringField
      FieldName = 'descricao'
      Size = 50
    end
    object qryImpressaoTotaisLotesclassificacao: TStringField
      FieldName = 'classificacao'
      Size = 50
    end
  end
