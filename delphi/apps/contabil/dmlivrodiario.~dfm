    Sql.Strings = (
      ';'
      
        'select *, (coalesce(somadebito,0) - coalesce(somacredito,0)) as ' +
        'saldo'
      'from'
      '('
      'select filial,'
      '       razao,'
      '       cnpj,'
      '       inscricaoestadual,'
      '       data,'
      '       sum(valordebito) as somadebito,'
      '       sum(valorcredito) as somacredito'
      'from'
      '('
      'select * from'
      '   ('
      '    ('
      '     select f.razao,'
      '            formatar_cpf_cnpj(f.cnpj) as cnpj,'
      #9'    f.inscricaoestadual,'
      #9'    ld.filial,'
      '            ld.data,'
      #9'    ld.valor as valordebito,'
      #9'    cast(null as numeric) as valorcredito,'
      #9'    cast('#39'A'#39' as varchar) as ordenacao'
      '     from lancamentos ld join filiais f on ld.filial = f.codigo'
      
        '     where ld.data between :datainicial and :datafinal and ld.de' +
        'bitar is not null'
      '     %Filiais'
      '     order by ld.filial,ld.data'
      '    )'
      '    union all'
      '    ('
      '     select f.razao,'
      '            formatar_cpf_cnpj(f.cnpj) as cnpj,'
      #9'    f.inscricaoestadual,'
      #9'    lc.filial,'
      #9'    lc.data,'
      #9'    cast(null as numeric) as valordebito,'
      #9'    lc.valor as valorcredito,'
      #9'    cast('#39'B'#39' as varchar) as ordenacao'
      
        '     from lancamentos lc join filiais f on lc.filial = f.codigo ' +
        'and lc.creditar is not null'
      '     where lc.data between :datainicial and :datafinal'
      '       %Filiais'
      '     order by lc.filial,lc.data'
      '    )'
      '   ) as saldos'
      'where saldos.data between :datainicial and :datafinal'
      '%Filiais'
      'Order by data, UPPER(TO_ASCII(Ordenacao,'#39'LATIN1'#39'))'
