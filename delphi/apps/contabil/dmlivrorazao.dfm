  object qryLivroRazaoFilialSaldo: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterScroll = qryLivroRazaoAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'conta'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Filiais_sc'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Filiais_ld'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Filiais_lc'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Movtos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Ordenacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'select saldos.*'
      'from'
      '('
      'select data,'
      '       sum(valordebito) as valordebito,'
      '       sum(valorcredito) as valorcredito,'
      '       codigo,'
      '       descricao,'
      '       classificacao,'
      '       filial,'
      '       razao,'
      '       cnpj,'
      '       inscricaoestadual'
      'from'
      '('
      ''
      '('
      ' select cast('#39'01/01/1900'#39' as date) as data,'
      '           case when saldocontabil.valor < 0 then'
      
        '           cast(null as numeric) else saldocontabil.valor end as' +
        ' valordebito,'
      '           case when saldocontabil.valor > 0 then'
      
        '           cast(null as numeric) else abs(saldocontabil.valor) e' +
        'nd as valorcredito,'
      '           saldocontabil.codigo,'
      '           saldocontabil.descricao,'
      '           saldocontabil.classificacao,'
      '           saldocontabil.filial,'
      '           saldocontabil.razao,'
      '           saldocontabil.cnpj,'
      '           saldocontabil.inscricaoestadual'
      '        from (select pl.codigo,'
      '                          pl.classificacao,'
      
        '                          saldocontabil(coalesce(pl.codigo,0),f.' +
        'codigo,:datasaldo, :Exercicio) as valor,'
      #9'            pl.descricao,'
      #9'            sc.filial,'
      '      '#9'            f.razao,'
      '                          formatar_cpf_cnpj(f.cnpj) as cnpj,'
      '                          f.inscricaoestadual'
      
        '                 from (planocontas pl join (saldoscontabeis sc j' +
        'oin filiais f on sc.filial = f.codigo)'
      
        '                                                                ' +
        '                   on pl.codigo = sc.conta)'
      '                 where pl.tipo='#39'A'#39
      
        '                    and sc.exercicio = EXTRACT(Year FROM cast(:d' +
        'atainicial as date))'
      '                 %Conta'
      '                 %Filiais_sc'
      
        '                 order by sc.filial, pl.classificacao, UPPER(TO_' +
        'ASCII(pl.descricao,'#39'LATIN1'#39')), pl.codigo'
      '             ) as saldocontabil'
      ')'
      'union all'
      '('
      'select ld.data,'
      '       ld.valor as valordebito,'
      '       cast(null as numeric) as valorcredito,'
      '       pl.codigo,'
      '       pl.descricao,'
      '       pl.classificacao,'
      '       ld.filial,'
      '       f.razao,'
      '       formatar_cpf_cnpj(f.cnpj) as cnpj,'
      '       f.inscricaoestadual'
      
        'from (planocontas pl join (lancamentos ld join filiais f on ld.f' +
        'ilial = f.codigo)'
      '                 on pl.codigo = ld.debitar)'
      'where ld.data between :datainicial and :datafinal'
      '   %conta'
      '   %Filiais_ld'
      
        'order by ld.filial, pl.classificacao, UPPER(TO_ASCII(pl.descrica' +
        'o,'#39'LATIN1'#39')), pl.codigo, ld.data, ld.nrlancto'
      ')'
      'union all'
      '('
      'select lc.data,'
      '       cast(null as numeric) as valordebito,'
      '       lc.valor as valorcredito,'
      '       pl.codigo,'
      '       pl.descricao,'
      '       pl.classificacao,'
      '       lc.filial,'
      '       f.razao,'
      '       formatar_cpf_cnpj(f.cnpj) as cnpj,'
      '       f.inscricaoestadual'
      
        'from (planocontas pl join (lancamentos lc join filiais f on lc.f' +
        'ilial = f.codigo)'
      '                              on pl.codigo = lc.creditar)'
      'where lc.data between :datainicial and :datafinal'
      '     %conta'
      '     %Filiais_lc'
      
        'order by lc.filial, pl.classificacao, UPPER(TO_ASCII(pl.descrica' +
        'o,'#39'LATIN1'#39')), pl.codigo, lc.data, lc.nrlancto'
      ')'
      ') as lancamentos'
      
        'group by filial, razao, cnpj, inscricaoestadual, classificacao, ' +
        'descricao, codigo, data'
      ') as saldos'
      '%Movtos'
      '%Ordenacao')
    RequestLive = True
    Left = 496
    Top = 184
    ParamData = <
      item
        DataType = ftString
        Name = 'datasaldo'
        ParamType = ptUnknown
        Value = '01/01/1900'
      end
      item
        DataType = ftString
        Name = 'datainicial'
        ParamType = ptUnknown
        Value = '01/01/1900'
      end
      item
        DataType = ftString
        Name = 'datafinal'
        ParamType = ptUnknown
        Value = '01/01/1900'
      end
      item
        DataType = ftInteger
        Name = 'Exercicio'
        ParamType = ptUnknown
      end>
    object qryLivroRazaoFilialSaldodata: TDateField
      FieldName = 'data'
    end
    object qryLivroRazaoFilialSaldovalordebito: TFloatField
      FieldName = 'valordebito'
    end
    object qryLivroRazaoFilialSaldovalorcredito: TFloatField
      FieldName = 'valorcredito'
    end
    object qryLivroRazaoFilialSaldocodigo: TIntegerField
      FieldName = 'codigo'
    end
    object qryLivroRazaoFilialSaldodescricao: TStringField
      FieldName = 'descricao'
      Size = 50
    end
    object qryLivroRazaoFilialSaldoclassificacao: TStringField
      FieldName = 'classificacao'
      Size = 50
    end
    object qryLivroRazaoFilialSaldofilial: TIntegerField
      FieldName = 'filial'
    end
    object qryLivroRazaoFilialSaldorazao: TStringField
      FieldName = 'razao'
      Size = 50
    end
    object qryLivroRazaoFilialSaldocnpj: TStringField
      FieldName = 'cnpj'
      Size = 50
    end
    object qryLivroRazaoFilialSaldoinscricaoestadual: TStringField
      FieldName = 'inscricaoestadual'
      Size = 50
    end
