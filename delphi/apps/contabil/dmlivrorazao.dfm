        DataType = ftUnknown
        Name = 'Filiais_lc'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Movtos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Ordenacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'select saldos.*'
      'from'
      '('
      'select data,'
      '          sum(valordebito) as valordebito,'
      '          sum(valorcredito) as valorcredito,'
      '          codigo,'
      '          descricao,'
      '          classificacao'
      'from'
      '('
      ''
      '('
      ' select cast('#39'01/01/1900'#39' as date) as data,'
      '        case when saldocontabil.valor < 0 then'
      
        #9'  cast(null as numeric) else saldocontabil.valor end as valorde' +
        'bito,'
      '        case when saldocontabil.valor > 0 then'
      
        #9'  cast(null as numeric) else abs(saldocontabil.valor) end as va' +
        'lorcredito,'
      '        saldocontabil.codigo,'
      '        saldocontabil.descricao,'
      '        saldocontabil.classificacao'
      'from '
      '      ( '
      
        '        select codigo,classificacao,descricao,sum(valor) as valo' +
        'r'
      '        from'
      '               (select pl.codigo,'
      '                          pl.classificacao,'
      
        '                          saldocontabil(coalesce(pl.codigo,0), s' +
        'c.filial, :datasaldo, :Exercicio) as valor,'
      #9'            pl.descricao'
      
        '               from planocontas pl  join saldoscontabeis sc on p' +
        'l.codigo = sc.conta'
      '               where pl.tipo='#39'A'#39
      
        '                    and sc.exercicio = EXTRACT(year from cast(:d' +
        'atainicial as date))'
      '               %Conta'
      '               %Filiais_sc  '
      
        '               order by pl.classificacao, UPPER(TO_ASCII(pl.desc' +
        'ricao,'#39'LATIN1'#39')), pl.codigo'
      '               ) as saldocontabil'
      '        group by codigo,classificacao,descricao'
      '      ) as saldocontabil'
      ')'
      'union all'
      '('
      'select ld.data,'
      '       ld.valor as valordebito,'
      '       cast(null as numeric) as valorcredito,'
      '       pl.codigo,'
      '       pl.descricao,'
      '       pl.classificacao'
      
        'from planocontas pl join lancamentos ld on pl.codigo = ld.debita' +
        'r'
      'where ld.data between :datainicial and :datafinal'
      '   %conta'
      '   %Filiais_ld'
      
        'order by pl.classificacao, UPPER(TO_ASCII(pl.descricao,'#39'LATIN1'#39')' +
        '), pl.codigo, ld.data'
      ')'
      'union all'
      '('
      'select lc.data,'
      '       cast(null as numeric) as valordebito,'
      '       lc.valor as valorcredito,'
      '       pl.codigo,'
      '       pl.descricao,'
      '       pl.classificacao'
      
        'from planocontas pl join lancamentos lc on pl.codigo = lc.credit' +
        'ar'
      'where lc.data between :datainicial and :datafinal'
      '     %conta'
      '    %Filiais_lc'
      
        'order by pl.classificacao, UPPER(TO_ASCII(pl.descricao,'#39'LATIN1'#39')' +
        '), pl.codigo, lc.data'
      ')'
      ') as lancamentos'
      'group by classificacao, descricao, codigo, data'
      ') as saldos'
      '%Movtos'
      '%Ordenacao')
    RequestLive = True
    Left = 192
    Top = 184
    ParamData = <
      item
        DataType = ftString
        Name = 'datasaldo'
        ParamType = ptUnknown
        Value = '01/01/1900'
