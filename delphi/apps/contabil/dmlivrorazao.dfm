    Sql.Strings = (
      ';'
      ' select saldos.*, '
      '           cast(null as numeric) as TotalDebito, '
      '           cast(null as numeric) as TotalCredito'
      ' from'
      '('
      '('
      ' select cast(null as integer) as nrlancto,'
      '        cast('#39'30/12/1899'#39' as date) as data,'
      '        cast(null as char(1)) as origem,'
      '        cast(null as integer) as contrapartida,'
      '        cast(null as varchar) as descricaocontrapartida,'
      '        0.00 as valorevento,'
      '        case when saldocontabil.valor < 0 then'
      
        '        cast(null as numeric) else saldocontabil.valor end as va' +
        'lordebito,'
      '        case when saldocontabil.valor > 0 then'
      
        '        cast(null as numeric) else abs(saldocontabil.valor) end ' +
        'as valorcredito,'
      '        cast(null as integer) as historico,'
      
        '        cast('#39'SALDO ANTERIOR'#39' as varchar) as descricaohistoricoc' +
        'omplemento,'
      '        saldocontabil.codigo,'
      '        saldocontabil.descricao,'
      '        saldocontabil.classificacao,'
      '        saldocontabil.filial,'
      '        saldocontabil.razao,'
      '        saldocontabil.cnpj,'
      '        saldocontabil.inscricaoestadual,'
      '        cast(0 as integer) as nlinhas'
      '        from (select pl.codigo,'
      '                          pl.classificacao,'
      
        '                          saldocontabil(coalesce(pl.codigo,0),f.' +
        'codigo,:datasaldo, :Exercicio) as valor,'
      #9'            pl.descricao,'
      #9'            sc.filial,'
      '      '#9'            f.razao,'
      '                          formatar_cpf_cnpj(f.cnpj) as cnpj,'
      '                          f.inscricaoestadual'
      
        '                 from (planocontas pl join (saldoscontabeis sc j' +
        'oin filiais f on sc.filial = f.codigo)'
      
        '                                                                ' +
        '                   on pl.codigo = sc.conta)'
      '                 where pl.tipo='#39'A'#39
      
        '                    and sc.exercicio = EXTRACT(Year FROM cast(:d' +
        'atainicial as date))'
      '                 %Conta'
      '                 %Filiais_sc'
      
        '                 order by sc.filial, pl.classificacao, UPPER(TO_' +
        'ASCII(pl.descricao,'#39'LATIN1'#39')), pl.codigo'
      '                ) as saldocontabil'
      ')'
      'union all'
      '('
      ' select lancamentos.*,'
      '        (select count(*)'
      '         from lancamentos l'
      '         where ((l.debitar = lancamentos.codigo) or'
      '                (l.creditar = lancamentos.codigo)) and'
      '                l.data = lancamentos.data'
      '                %Filiais_l'
      '               ) as nlinhas'
      'from'
      '('
      '('
      'select ld.nrlancto,'
      '       ld.data,'
      '       ld.origem,'
      '       ld.creditar as contrapartida,'
      
        '       (select pl2.descricao from planocontas pl2 where pl2.codi' +
        'go = ld.creditar) as descricaocontrapartida,'
      '       0.00 as valorevento,'
      '       ld.valor as valordebito,'
      '       cast(null as numeric) as valorcredito,'
      '       ld.historico,'
      
        '       coalesce((select h.descricao from historicos h where h.co' +
        'digo = ld.historico),'#39#39')||'#39' '#39'||coalesce(ld.complemento,'#39#39') as de' +
        'scricaohistoricocomplemento,'
      '       pl.codigo,'
      '       pl.descricao,'
      '       pl.classificacao,'
      '       ld.filial,'
      '       f.razao,'
      '       formatar_cpf_cnpj(f.cnpj) as cnpj,'
      '       f.inscricaoestadual'
      
        'from (planocontas pl join (lancamentos ld join filiais f on ld.f' +
        'ilial = f.codigo)'
      '                 on pl.codigo = ld.debitar)'
      'where ld.data between :datainicial and :datafinal'
      
        '  and ((ld.origem<>'#39'B'#39') or (ld.origem='#39'B'#39' and ld.creditar is not' +
        ' null))'
      '   %Conta'
      '   %Filiais_ld'
      
        'order by ld.filial, pl.classificacao, UPPER(TO_ASCII(pl.descrica' +
        'o,'#39'LATIN1'#39')), pl.codigo, ld.data, ld.nrlancto'
      ')'
      ''
      'union all'
      ''
      '('
      'select ld.nrlancto,'
      '       ld.data,'
      '       ld.origem,'
      '       lc.creditar as contrapartida,'
      
        '       (select pl2.descricao from planocontas pl2 where pl2.codi' +
        'go = lc.creditar) as descricaocontrapartida,'
      '       lc.valor as valorevento,'
      '       case when (ld.valor < lc.valor) or'
      '                 (lc.nrlancto = (select max(lc2.nrlancto)'
      '                                 from lancamentos lc2'
      
        '                                 where substr(lc2.nrorigem,1,12)' +
        '=substr(ld.nrorigem,1,12)'
      
        '                                   and lc2.nrlancto<>ld.nrlancto' +
        ')) then'
      '              ld.valor'
      '       else  0.00 end as valordebito,'
      '       0.00 as valorcredito,'
      '       ld.historico,'
      
        '       coalesce((select h.descricao from historicos h where h.co' +
        'digo = lc.historico),'#39#39')||'#39' '#39'||coalesce(lc.complemento,'#39#39') as de' +
        'scricaohistoricocomplemento,'
      '       pl.codigo,'
      '       pl.descricao,'
      '       pl.classificacao,'
      '       ld.filial,'
      '       f.razao,'
      '       formatar_cpf_cnpj(f.cnpj) as cnpj,'
      '       f.inscricaoestadual'
      ''
      'from planocontas pl'
      '     join lancamentos ld'
      '          join filiais f'
      '          on ld.filial = f.codigo'
      ''
      '          join lancamentos lc'
      '          on substr(ld.nrorigem,1,12)=substr(lc.nrorigem,1,12)'
      '     on pl.codigo = ld.debitar'
      ''
      'where ld.data between :datainicial and :datafinal'
      '  and (ld.origem='#39'B'#39' and ld.creditar is null)'
      '  and lc.creditar is not null'
      ''
      '  %conta'
      '  %Filiais_ld'
      ''
      
        'order by ld.filial, pl.classificacao, UPPER(TO_ASCII(pl.descrica' +
        'o,'#39'LATIN1'#39')), pl.codigo, ld.data, ld.nrlancto'
      ''
      ')'
      ''
      'union all'
      ''
      '('
      'select lc.nrlancto,'
      '       lc.data,'
      '       lc.origem,'
      '       lc.debitar as contrapartida,'
      
        '       (select pl2.descricao from planocontas pl2 where pl2.codi' +
        'go = lc.debitar) as descricaocontrapartida,'
      '       0.00 as valorevento,'
      '       cast(null as numeric) as valordebito,'
      '       lc.valor as valorcredito,'
      '       lc.historico,'
      
        '       coalesce((select h.descricao from historicos h where h.co' +
        'digo = lc.historico),'#39#39')||'#39' '#39'||coalesce(lc.complemento,'#39#39') as de' +
        'scricaohistoricocomplemento,'
      '       pl.codigo,'
      '       pl.descricao,'
      '       pl.classificacao,'
      '       lc.filial,'
      '       f.razao,'
      '       formatar_cpf_cnpj(f.cnpj) as cnpj,'
      '       f.inscricaoestadual'
      
        'from (planocontas pl join (lancamentos lc join filiais f on lc.f' +
        'ilial = f.codigo)'
      '                              on pl.codigo = lc.creditar)'
      'where lc.data between :datainicial and :datafinal'
      
        '  and ((lc.origem<>'#39'B'#39') or (lc.origem='#39'B'#39' and lc.debitar is not ' +
        'null))'
      ''
      '     %Conta'
      '     %Filiais_lc'
      
        'order by lc.filial, pl.classificacao, UPPER(TO_ASCII(pl.descrica' +
        'o,'#39'LATIN1'#39')), pl.codigo, lc.data, lc.nrlancto'
      ')'
      ''
      'union all'
      ''
      '('
      ''
      'select lc.nrlancto,'
      '       lc.data,'
      '       lc.origem,'
      '       ld.debitar as contrapartida,'
      
        '       (select pl2.descricao from planocontas pl2 where pl2.codi' +
        'go = ld.debitar) as descricaocontrapartida,'
      '       ld.valor as valorevento,'
      '       cast(null as numeric(15,2)) as valordebito,'
      '       case when (lc.valor < ld.valor) or'
      '                 (ld.nrlancto = (select max(ld2.nrlancto)'
      '                                from lancamentos ld2'
      
        '                                where substr(ld2.nrorigem,1,12)=' +
        'substr(lc.nrorigem,1,12)'
      
        '                                  and ld2.nrlancto<>lc.nrlancto)' +
        ') then'
      '             lc.valor'
      '       else  0.00 end as valorcredito,'
      '       lc.historico,'
      
        '       coalesce((select h.descricao from historicos h where h.co' +
        'digo = ld.historico),'#39#39')||'#39' '#39'||coalesce(ld.complemento,'#39#39') as de' +
        'scricaohistoricocomplemento,'
      '       pl.codigo,'
      '       pl.descricao,'
      '       pl.classificacao,'
      '       lc.filial,'
      '       f.razao,'
      '       formatar_cpf_cnpj(f.cnpj) as cnpj,'
      '       f.inscricaoestadual'
      ''
      'from planocontas pl'
      '     join lancamentos lc'
      '          join filiais f'
      '          on lc.filial = f.codigo'
      ''
      '          join lancamentos ld'
      '          on substr(lc.nrorigem,1,12)=substr(ld.nrorigem,1,12)'
      ''
      '     on pl.codigo = lc.creditar'
      ''
      'where lc.data between :datainicial and :datafinal'
      '  and (lc.origem='#39'B'#39' and lc.debitar is null)'
      '  and ld.debitar is not null'
      ''
      '    %conta'
      '    %Filiais_lc'
      ''
      
        'order by lc.filial, pl.classificacao, UPPER(TO_ASCII(pl.descrica' +
        'o,'#39'LATIN1'#39')), pl.codigo, lc.data, lc.nrlancto'
      ''
      ')'
      ''
      ''
      ') as lancamentos'
      ')'
      ') as saldos'
      ''
      '%Movtos'
      ''
      '%Ordenacao')
    RequestLive = True
    Left = 336
