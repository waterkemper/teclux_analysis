  object qryRecebimentos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryRecebimentosCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'TipoRelatorio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SQLContratoDataEmissao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SQLContratoDataVencto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SQLContratoDataRecebimento'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'GrupoFilial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Cliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Banco'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'TipoRecebimento'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Ordenacao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SQLContratoDataDevolucao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      ''
      'select r.*,'
      '       case when r.PercPIS<>0 then'
      
        '         r.valorpagto*r.PercPIS/100 else 0.00 end as ValorPercPI' +
        'S,'
      '       case when r.PercCOFINS<>0 then'
      
        '         r.valorpagto*r.PercCOFINS/100 else 0.00 end as ValorPer' +
        'cCOFINS'
      'from'
      '('
      'select r.*,'
      
        '       cast(TotalProdutosPIS*100/TotalProdutos as numeric(6,2)) ' +
        'as PercPIS,'
      
        '       cast(TotalProdutosCOFINS*100/TotalProdutos as numeric(6,2' +
        ')) as PercCOFINS'
      'from'
      '('
      'Select c.numero as contrato,'
      '       p.numero as numerparcela,'
      '       p.parcelaorigem as parcela,'
      '       c.cliente,'
      
        '       (Select coalesce(v.razao,v.nome) as nome from vfornecedor' +
        'es v where v.codigo = c.cliente and v.tipo = c.tipocliente) as N' +
        'omeCliente,'
      '       c.filialvenda,'
      '       f.nome as nomefilialemissao,'
      '       fgf.grupo as grupofilialemissao,'
      '       notas_notasdocontrato(c.numero) as numeronota,'
      '       gf.descricao as nomegrupofilialemissao,'
      
        '       (Select tr.descricao from tiposrecebimentos tr where tr.c' +
        'odigo = p.tiporecebimento) as Tiporecebimento,'
      
        '       (select b.nome from contas c join bancos b on c.banco = b' +
        '.codigo where conta = p.contaboleto) as NOmeBanco,'
      
        '       (select b.sigla from contas c join bancos b on c.banco = ' +
        'b.codigo where conta = p.contaboleto) as SiglaBanco,'
      '       p.datavencto,'
      '       p.valorvencto,'
      '       p.datapagto,'
      '       p.valorpagto,'
      '       p.observacaoboleto,'
      
        '       case When :AgruparData then True else False end as Difere' +
        'nciar,'
      ''
      
        #9#9#9' coalesce((select sum((pc.quantidade*pc.precovenda)-coalesce(' +
        'pc.valordescontoitem,0))'
      #9#9#9'  from produtoscontratos pc, produtos pr, caracteristicas cr'
      #9#9#9'  where pc.produto = pr.codigo'
      #9#9#9'    and pr.caracteristica = cr.codigo'
      #9#9#9'    and pc.contrato = c.numero'
      
        #9#9#9#9'and cr.piscst NOT in ('#39'07'#39','#39'08'#39','#39'09'#39')),0) as TotalProdutosPI' +
        'S,'
      ''
      
        #9#9#9' coalesce((select sum((pc.quantidade*pc.precovenda)-coalesce(' +
        'pc.valordescontoitem,0))'
      #9#9#9'  from produtoscontratos pc, produtos pr, caracteristicas cr'
      #9#9#9'  where pc.produto = pr.codigo'
      #9#9#9'    and pr.caracteristica = cr.codigo'
      #9#9#9'    and pc.contrato = c.numero'
      
        #9#9#9#9'and cr.cofinscst NOT in ('#39'07'#39','#39'08'#39','#39'09'#39')),0) as TotalProduto' +
        'sCOFINS,'
      ''
      
        '      (select sum((pc.quantidade * pc.precovenda)-coalesce(pc.va' +
        'lordescontoitem,0))'
      '       from produtoscontratos pc'
      '       where pc.contrato = c.numero) as TotalProdutos'
      ''
      'from contratos c join parcelas p on c.numero = p.contrato'
      
        '                 join filiais f left join filiaisgruposfiliais f' +
        'gf join gruposfiliais gf on fgf.grupo=gf.codigo on f.codigo = fg' +
        'f.filial'
      
        '                                        on c.filialvenda = f.cod' +
        'igo'
      'Where c.numero = p.contrato and c.Situacao IN ('#39'F'#39','#39'N'#39','#39'P'#39')'
      '  AND NOT contratos_renegociado(c.numero)'
      
        '  and case when c.os then c.tipoequipamento in (1,2) else true e' +
        'nd'
      ''
      '%TipoRelatorio'
      ''
      '%SQLContratoDataEmissao'
      '%SQLContratoDataVencto'
      '%SQLContratoDataRecebimento'
      ''
      '%Filial'
      '%GrupoFilial'
      '%Cliente'
      '%Banco'
      '%TipoRecebimento'
      '%Ordenacao'
      ''
      ') as r'
      ') as r'
      ''
      ''
      'union all'
      ''
      ''
      'select r.*,'
      ''
      '       case when r.PercPIS<>0 then'
      
        '         r.valorpagto*r.PercPIS/100 else 0.00 end as ValorPercPI' +
        'S,'
      ''
      '       case when r.PercCOFINS<>0 then'
      
        '         r.valorpagto*r.PercCOFINS/100 else 0.00 end as ValorPer' +
        'cCOFINS'
      'from'
      '('
      'select r.*,'
      
        '       cast(TotalProdutosPIS*100/TotalProdutos as numeric(6,2)) ' +
        'as PercPIS,'
      
        '       cast(TotalProdutosCOFINS*100/TotalProdutos as numeric(6,2' +
        ')) as PercCOFINS'
      'from'
      '('
      'Select c.numero as contrato,'
      '       p.numero as numerparcela,'
      '       p.parcelaorigem as parcela,'
      '       c.cliente,'
      
        '       (Select coalesce(v.razao,v.nome) as nome from vfornecedor' +
        'es v where v.codigo = c.cliente and v.tipo = c.tipocliente) as N' +
        'omeCliente,'
      '       c.filialvenda,'
      '       f.nome as nomefilialemissao,'
      '       fgf.grupo as grupofilialemissao,'
      '       notas_notasdocontrato(c.numero) as numeronota,'
      '       gf.descricao as nomegrupofilialemissao,'
      
        '       (Select tr.descricao from tiposrecebimentos tr where tr.c' +
        'odigo = p.tiporecebimento) as Tiporecebimento,'
      
        '       (select b.nome from contas c join bancos b on c.banco = b' +
        '.codigo where conta = p.contaboleto) as NOmeBanco,'
      
        '       (select b.sigla from contas c join bancos b on c.banco = ' +
        'b.codigo where conta = p.contaboleto) as SiglaBanco,'
      '       p.datavencto,'
      '       - p.valorvencto as valorvencto,'
      '       p.datapagto,'
      '       - p.valorpagto as valorpagto,'
      '       p.observacaoboleto,'
      
        '       case When :AgruparData then True else False end as Difere' +
        'nciar,'
      ''
      
        ' '#9#9#9' - coalesce((select sum((pc.quantidade*pc.precovenda)-coales' +
        'ce(pc.valordescontoitem,0))'
      
        '                   from produtoscontratos pc, produtos pr, carac' +
        'teristicas cr'
      '                   where pc.produto = pr.codigo'
      '                     and pr.caracteristica = cr.codigo'
      '                     and pc.contrato = c.numero'
      
        '                     and cr.piscst NOT in ('#39'07'#39','#39'08'#39','#39'09'#39')),0) a' +
        's TotalProdutosPIS,'
      ''
      
        #9#9#9' - coalesce((select sum((pc.quantidade*pc.precovenda)-coalesc' +
        'e(pc.valordescontoitem,0))'
      
        #9#9#9'             from produtoscontratos pc, produtos pr, caracter' +
        'isticas cr'
      '                   where pc.produto = pr.codigo'
      '                     and pr.caracteristica = cr.codigo'
      '                     and pc.contrato = c.numero'
      
        '                     and cr.cofinscst NOT in ('#39'07'#39','#39'08'#39','#39'09'#39')),0' +
        ') as TotalProdutosCOFINS,'
      ''
      
        '       - (select sum((pc.quantidade * pc.precovenda)-coalesce(pc' +
        '.valordescontoitem,0))'
      '          from produtoscontratos pc'
      '          where pc.contrato = c.numero) as TotalProdutos'
      ''
      'from contratos c join parcelas p on c.numero = p.contrato'
      
        '                 join filiais f left join filiaisgruposfiliais f' +
        'gf join gruposfiliais gf on fgf.grupo=gf.codigo on f.codigo = fg' +
        'f.filial'
      
        '                                        on c.filialvenda = f.cod' +
        'igo'
      'Where c.numero = p.contrato and p.deventrada is not null'
      '  AND NOT contratos_renegociado(c.numero)'
      
        '  and case when c.os then c.tipoequipamento in (1,2) else true e' +
        'nd'
      '  and :VisualizarValoresPISeCOFINS'
      ''
      '%TipoRelatorio'
      '%SQLContratoDataEmissao'
      ''
      '%SQLContratoDataEmissao'
      '%SQLContratoDataVencto'
      '%SQLContratoDataDevolucao'
      ''
      '%Filial'
      '%GrupoFilial'
      '%Cliente'
      '%Banco'
      '%TipoRecebimento'
      '%Ordenacao'
      ''
      ') as r'
      ') as r'
      '')
    RequestLive = False
    Left = 56
    Top = 16
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'AgruparData'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'VisualizarValoresPISeCOFINS'
        ParamType = ptUnknown
      end>
