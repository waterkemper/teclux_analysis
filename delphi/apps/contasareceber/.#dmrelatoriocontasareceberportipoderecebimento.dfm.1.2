    Sql.Strings = (
      ';'
      'select *'
      'from'
      '('
      'Select ct.numero as contrato,'
      '       p.numero as numeroparcela,'
      '       p.parcelaorigem,'
      '       ct.cliente,'
      '       ct.tipocliente,'
      '       coalesce(vf.razao,vf.nome) as nomecliente,'
      '       ct.filialvenda as filial,'
      '       f.nome as nomefilialemissao,'
      '       p.tiporecebimento as codigotiporecebimento,'
      
        '       (Select tr.descricao from tiposrecebimentos tr where tr.c' +
        'odigo = p.tiporecebimento) as descricaoTiporecebimento,'
      '       p.datavencto,'
      '       p.valorvencto,'
      '       p.valorvencto as valorlancto,'
      '       cast(null as varchar(06)) as numerocheque,'
      '       ct.vendedor,'
      '       (select u.nome'
      '        from usuarios u'
      '        where u.codigo = ct.vendedor) as nomevendedor,'
      
        '       calcularjuros(p.valorvencto,p.datavencto,current_date) as' +
        ' juros,'
      '       cast(null as numeric(5,2)) as pDesagio,'
      '       cast(null as numeric(15,2)) as ValorDesagio,'
      '       false as confirmado'
      ''
      ''
      'from contratos ct'
      '     join parcelas p'
      '     on ct.numero = p.contrato'
      '     join filiais f'
      '     on ct.filialvenda = f.codigo'
      '     join vfornecedores vf'
      '     on vf.codigo = ct.cliente'
      '       and vf.tipo = ct.tipocliente'
      ''
      'Where ct.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39')'
      '  %SQLContratoDataVencto'
      '  %SQLContratoDataEmissao'
      ''
      '  and p.datapagto is null'
      '  and (p.tiporecebimento is null or'
      '       p.tiporecebimento in (select tr.codigo'
      '                            from tiposrecebimentos tr'
      '                            where tr.tiporecebimento='#39'D'#39
      '                            and numerorecebimentos=1'
      '                            and diasuteis=0))'
      ''
      ''
      '  %Filial_Contrato'
      '  %TipoRecebimento_Parcelas'
      '  %Cliente_Contrato'
      '  %Vendedor_Contrato'
      '  %Confirmados_Nao_Recebimentos'
      ''
      ''
      'union all'
      ''
      'Select ct.numero as contrato,'
      '       cast(null as integer) as numeroparcela,'
      '       cast(null as varchar(7)) as parcelaorigem,'
      '       ct.cliente,'
      '       ct.tipocliente,'
      '       coalesce(vf.razao,vf.nome) as nomecliente,'
      '       ct.filialvenda as filial,'
      '       f.nome as nomefilialemissao,'
      '       r.codigotiporecebimento,'
      '       r.descricaoTiporecebimento,'
      '       r.datavencto,'
      '       r.valorvencto,'
      '       r.valorlancto,'
      
        '       cast(substr(r.cheque,12,06) as varchar(6)) as numerochequ' +
        'e,'
      '       ct.vendedor,'
      '       (select u.nome'
      '        from usuarios u'
      '        where u.codigo = ct.vendedor) as nomevendedor,'
      '        0.00 as juros,'
      '       r.pDesagio,'
      '       r.ValorDesagio,'
      '       r.confirmado'
      ''
      'from'
      '('
      ''
      'select distinct datavencto,'
      ''
      '                case when total_recebimentos_transacao <> 0 then'
      
        '                valorvencto*(total_parcelas_transacao/total_rece' +
        'bimentos_transacao)'
      '                else 0.00 end  as valorvencto,'
      ''
      '                case when total_recebimentos_transacao <> 0 then'
      
        '                  valorlancto*(total_parcelas_transacao/total_re' +
        'cebimentos_transacao)'
      '                else 0.00 end  as valorlancto,'
      ''
      
        '                codigotiporecebimento,contrato,faturamento,descr' +
        'icaotiporecebimento,tiporecebimento,cheque,pDesagio,ValorDesagio' +
        ',confirmado,'
      '                r.transacao'
      'from ('
      ''
      ' Select r.datavencto,'
      '         r.valorvencto,'
      '         r.valorlancto,'
      '         r.tiporecebimento as codigotiporecebimento,'
      '         p.contrato,'
      '         ct.faturamento,'
      '         tr.descricao as descricaotiporecebimento,'
      '         tr.tiporecebimento,'
      '         r.cheque,'
      '         r.desagio as pDesagio,'
      '         r.valorlancto-r.valorvencto as ValorDesagio,'
      
        '         (select sum(valorpagto) from parcelas where transacao=r' +
        '.transacao and contrato=p.contrato) as total_parcelas_transacao,'
      
        '         (select sum(valorlancto) from recebimentos where transa' +
        'cao=r.transacao AND situacao='#39'N'#39') as total_recebimentos_transaca' +
        'o,'
      '         r.confirmado,r.transacao'
      ''
      
        '  from recebimentos r join tiposrecebimentos tr on r.tiporecebim' +
        'ento = tr.codigo,parcelas p,contratos ct'
      '  where true'
      '  and p.contrato=ct.numero'
      '  and p.transacao=r.transacao'
      '   %SQLRecebimentosDataVencto'
      '   %SQLContratoDataEmissao'
      '    and r.situacao = '#39'N'#39
      '    %TipoRecebimento_Recebimentos'
      '    %Confirmados'
      ''
      ')as r  )'
      'as r'
      '     join ((contratos ct'
      '            join filiais f'
      '            on ct.filialvenda = f.codigo)'
      '            join vfornecedores vf'
      '            on vf.codigo = ct.cliente'
      '            and vf.tipo = ct.tipocliente)'
      '     on r.contrato = ct.numero'
      'where true'
      '%Filial_Contrato'
      '%Cliente_Contrato'
      '%Vendedor_Contrato'
      ''
      ''
      ''
      ''
      ''
      'union all'
      ''
      '  Select cast(null as varchar(30)) as contrato,'
      '         cast(null as integer) as numeroparcela,'
      '         cast(null as varchar(7)) as parcelaorigem,'
      '         ch.cliente,'
      '         ch.tipocliente,'
      '         coalesce(vf.razao,vf.nome) as nomecliente,'
      '         ch.filial,'
      '         f.nome as nomefilialemissao,'
      '         cast(999 as integer) as codigotiporecebimento,'
      
        '         cast('#39'CHEQUES AVULSOS'#39' as varchar(100)) as descricaoTip' +
        'orecebimento,'
      '         ch.vencto as datavencto,'
      '         ch.valor as valorvencto,'
      '         ch.valor as valorlancto,'
      
        '         cast(substr(ch.numero,12,06) as varchar(6)) as numeroch' +
        'eque,'
      '         cast(null as integer) as vendedor,'
      '         cast('#39'CHEQUES AVULSOS'#39' as varchar(40)) as nomevendedor,'
      '         0.00 as juros,'
      '        cast(null as numeric(5,2)) as pDesagio,'
      '        cast(null as numeric(15,2)) as ValorDesagio,'
      '        false as confirmado'
      ''
      ''
      '  from cheques ch'
      '       join vfornecedores vf'
      '       on ch.cliente = vf.codigo'
      '       and ch.tipocliente = vf.tipo'
      '       join filiais f'
      '       on ch.filial = f.codigo'
      ''
      '  where :SelecionouChequesAvulsos'
      '    %SQLChequesDataVencto'
      '    %SQLChequesDataEmissao'
      ''
      
        '    and not exists  (select cheque from recebimentos where chequ' +
        'e=ch.numero)'
      ''
      '    %Filial_ChequesAvulsos'
      '    %Cliente_ChequesAvulsos'
      '    %Vendedor_ChequesAvulsos'
      '    %Confirmados_Nao_Recebimentos'
      ''
      ') as selecao'
      '%Ordenacao')
    RequestLive = False
    Left = 56
