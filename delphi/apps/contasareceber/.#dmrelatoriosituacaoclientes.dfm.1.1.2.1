        ParamType = ptUnknown
        Value = #39'C'#39
      end
      item
        DataType = ftString
        Name = 'listaFiliais'
        ParamType = ptUnknown
        Value = '1,2,3,4,5,6,7'
      end
      item
        DataType = ftString
        Name = 'ListaGrupoFiliais'
        ParamType = ptUnknown
        Value = '1,2,3,4,5,6,7'
      end
      item
        DataType = ftBoolean
