    Sql.Strings = (
      ';'
      'select df.*,'
      '        p.valornota,'
      '        p.saldodevedor,'
      '        p.datavencto,'
      '        p.valorvencto,'
      '        p.datapagto,'
      '        p.valorpagto,'
      '        p.juros,'
      '        p.desconto,'
      '        p.ndias,'
      '        p.parcelaorigem,'
      '        P.nregistro'
      'from'
      '('
      'select formatar_cpf_cnpj(vf.pessoanumero) as cgc_cnpj,'
      ''
      '       vf.nome as nomecliente,'
      
        '       c.maquina, c.intervensao, c.numero as numerocupom, coales' +
        'ce(n.filial, c.filial) as filial, n.serie, n.numero as numeronot' +
        'a,'
      
        '       df.numero as dadofiscal, df.contrato, df.data, df.datasai' +
        'da, df.cliente, df.tipocliente,'
      ''
      '       fgf.grupo as grupofilial,'
      '       gf.descricao as nomegrupofilial,'
      '       df.filialemissao,'
      '       f.nome as nomefilial'
      ''
      ''
      
        'from (dadosfiscais df join (filiais f left join (filiaisgruposfi' +
        'liais fgf  join gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                                  on f.codigo=fgf.filial)'
      
        '                                                         on df.f' +
        'ilialemissao=f.codigo)'
      '     left join notas n'
      '     on df.numero = n.dadofiscal'
      '        and n.dadofiscalvinculado is null'
      ''
      '     left join cupons c'
      '     on df.numero = c.dadofiscal'
      ''
      '     join vfornecedores vf'
      '     on df.cliente = vf.codigo'
      '        and df.tipocliente = vf.tipo'
      ''
      'where df.situacao = '#39'N'#39
      '  and df.data between :datainicial and :datafinalsituacao'
      '  %cliente'
      
        '/*  and case when :cliente = 0 then true else df.cliente = :clie' +
        'nte and df.tipocliente = :tipocliente end*/'
      '  and ehnotafiscalsaidavenda(df.codigofiscal)'
      
        '  and case when :listaFiliais = '#39#39' then true else df.filialemiss' +
        'ao in (select * from lista_int(cast('#39'{'#39'||:listaFiliais||'#39'}'#39' as i' +
        'nteger[]))) end'
      
        '  and case when :ListaGrupoFiliais = '#39#39' then true else df.filial' +
        'emissao in (select fgf.filial from filiaisgruposfiliais fgf wher' +
        'e fgf.grupo in (select * from lista_int(cast('#39'{'#39'||:listagrupoFil' +
        'iais||'#39'}'#39' as integer[])))) end'
      '  %ListaSeries'
      
        '  /*and case when :ListaSeries = '#39#39' then true else n.serie in (s' +
        'elect * from lista_alfa(cast('#39'{'#39'||:listaSeries||'#39'}'#39' as varchar[]' +
        '))) end*/'
      ''
      ') as df'
      ''
      
        '   join (select * from ParcelasRateada(cast(:datainicial as date' +
        '), cast(:datafinalsituacao as date), :ListarDuplicataemAberto)) ' +
        'as p'
      '     on p.dadofiscal = df.dadofiscal'
      ''
      '%ordenacao'
      ''
      '')
    RequestLive = False
    Left = 80
    Top = 56
    ParamData = <
