package contasareceberk;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$SONAME 'contasareceber'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  baseclx,
  visualclx,
  repositoriok;

contains
  dmrelatoriocontasareceber in 'dmrelatoriocontasareceber.pas' {dtmrelatoriocontasareceber: TDataModule},
  fmrelatoriocontasareceber in 'fmrelatoriocontasareceber.pas' {frmrelatoriocontasareceber},
  rgcontasareceber in 'rgcontasareceber.pas';

end.
