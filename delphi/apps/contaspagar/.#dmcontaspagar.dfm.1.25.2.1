    Sql.Strings = (
      'Select  f.codigo,'
      '        coalesce(f.razao,f.nome) as nome,'
      '        f.tipo,'
      '        f.debito,'
      
        '        (select descricao from planocontas pl where pl.codigo=f.' +
        'debito) as descricaodebitoplanocontas,'
      
        '        (select classificacao from planocontas pl where pl.codig' +
        'o=f.debito) as classificacaodebitoplanocontas,'
      '        f.credito,'
      
        '        (select descricao from planocontas pl where pl.codigo=f.' +
        'credito) as descricaocreditoplanocontas,'
      
        '        (select classificacao from planocontas pl where pl.codig' +
        'o=f.credito) as classificacaocreditoplanocontas,'
      
        '        (select adiantamento from fornecedores where f.codigo = ' +
        'fornecedores.codigo and f.tipo='#39'F'#39') as adiantamento,'
      '        f.historicocontabil,'
      
        '        case when :tipo = '#39'C'#39' then (select c.historicocontabilpa' +
        'gtoduplicata from clientes c where c.codigo = :codigo)'
      
        '        else (select f.historicocontabilpagtoduplicata from forn' +
        'ecedores f where f.codigo = :codigo) end as historicocontabilpag' +
        'toduplicata'
      ''
      'From    vfornecedores f'
      'Where (f.tipo =:tipo) and'
      '            (f.codigo =:codigo)')
    RequestLive = True
    Left = 559
    Top = 5
    ParamData = <
      item
        DataType = ftString
