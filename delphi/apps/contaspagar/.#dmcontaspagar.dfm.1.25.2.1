  object qryDuplicatas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryDuplicatasAfterOpen
    BeforePost = qryDuplicatasBeforePost
    AfterPost = qryDuplicatasAfterPost
    AfterDelete = qryDuplicatasAfterDelete
    AfterScroll = qryDuplicatasAfterScroll
    OnCalcFields = qryDuplicatasCalcFields
    OnNewRecord = qryDuplicatasNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'SelecionarPorChave'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'SELECT d.DocumentoPag,'
      '       d.DataVencto,'
      '       d.Numero,'
      '       cast(null as integer) as NumeroAux,'
      '       d.DataVencto as DataVenctoOriginal,'
      
        '       CAST(TRIM(BOTH '#39' '#39' FROM TO_CHAR(d.Numero, '#39'999'#39'))  || '#39'.'#39 +
        ' ||'
      
        '            TRIM(BOTH '#39' '#39' FROM TO_CHAR((SELECT COUNT(*) FROM  Du' +
        'plicatas d1'
      
        '                                                        WHERE d1' +
        '.DocumentoPag = :Documento), '#39'999'#39')) AS VARCHAR)'
      '                          as Ordem,'
      '       d.ValorVencto,'
      '       d.ValorDesconto,'
      '       d.Juros,'
      '       d.TipoJuros,'
      '       d.Multa,'
      '       d.TipoMulta,'
      '       d.DataPagto,'
      '       d.ValorPagto,'
      '       cast(null as numeric(11,2)) as ValorPagtoOldValue,'
      '       d.ContaPagto,'
      '       d.ChequePagto,'
      '       d.FilialPagto,'
      '       d.BancoCobranca,'
      '       d.Usuario,'
      '       d.TipoPagamento,'
      '       cast(null as integer) as TipoPagamentoOldValue,'
      '       d.ContaCredito,'
      '       d.Observacao,'
      '       d.Autorizado,'
      '       d.dataautorizacaopagto,'
      '       d.Evento,'
      '       t.Descricao,'
      '       d.nrlotecontabil,'
      '       d.datapagto as DataPagtoAux,'
      '       d.ContaPagto as ContaPagtoAux,'
      '       d.ChequePagto as ChequePagtoAux,'
      '       case when d.datapagto is not null'
      '/*             and (coalesce(d.valorpagto,0)<>0 or'
      
        '                  coalesce(d.valordesconto,0)<>0)*/  then true e' +
        'lse false end as DuplicataPaga,'
      '       CASE WHEN d.DataPagto IS NOT NULL'
      
        '            THEN CASE WHEN COALESCE(d.ValorPagto,0) > COALESCE(d' +
        '.ValorVencto, 0)'
      
        '                      THEN COALESCE(d.ValorPagto,0) - COALESCE(d' +
        '.ValorVencto, 0)'
      '                      ELSE NULL'
      '                 END'
      '            ELSE NULL'
      '       END AS JurosPagos,'
      ''
      '       CASE WHEN d.DataPagto IS NOT NULL'
      
        '            THEN CASE WHEN COALESCE(d.ValorVencto,0) > COALESCE(' +
        'd.ValorPagto, 0)'
      
