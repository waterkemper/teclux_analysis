    Sql.Strings = (
      
        'select distinct descricao, quinzenal, parametro_inicial, dia, pa' +
        'rametro_final, ocasiao, fornecedor, tipofornecedor from'
      '('
      ' select'
      
        '        coalesce(viref.descricao,         vireg.descricao) as de' +
        'scricao,'
      
        '        coalesce(viref.quinzenal,         vireg.quinzenal) as qu' +
        'inzenal,'
      
        '        coalesce(viref.parametro_inicial, vireg.parametro_inicia' +
        'l) as parametro_inicial,'
      '        coalesce(viref.dia,               vireg.dia) as dia,'
      
        '        coalesce(viref.parametro_final,   vireg.parametro_final)' +
        ' as parametro_final,'
      
        '        coalesce(viref.ocasiao,           vireg.ocasiao) as ocas' +
        'iao,'
      
        '        coalesce(viref.fornecedor,        vireg.fornecedor) as f' +
        'ornecedor,'
      
        '        coalesce(viref.tipofornecedor,    vireg.tipofornecedor) ' +
        'as tipofornecedor'
      ' from venctosimpostosretidosentradas vireg left join'
      '      venctosimpostosretidosentradas viref on'
      '      viref.descricao = vireg.descricao'
      ' where (viref.filial = :filial or viref.filial is null)'
      '   and vireg.filial is null'
      ') as venctosimpostosretidosentradas'
      'where fornecedor is not null or'
      '      ((descricao = '#39'ISS retido'#39') and'
      '       coalesce((select f.fornecedorparaiss'
      '        from fornecedores f'
      '        where f.fornecedorparaiss limit 1),false))'
      
        'order by descricao, quinzenal, parametro_inicial, dia, parametro' +
        '_final, ocasiao, fornecedor, tipofornecedor')
