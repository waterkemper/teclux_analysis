      end>
    Sql.Strings = (
      'SELECT d.documentopag,'
      '       d.Numero,'
      '       dp.complemento,'
      ''
      '       d.DataVencto,'
      '       d.ValorVencto,'
      '       d.valordesconto,'
      '       d.valoracrescimo,'
      '       d.datapagfor,'
      '       '
      '       d.ContaPagto,'
      '       d.Remessa,'
      '       false AS Selecionar,'
      ''
      '       dp.fornecedor,'
      '       dp.tipofornecedor,'
      ''
      '       vf.Nome,'
      ''
      '       f.codigo as filial,'
      ''
      '       dp.emissao,'
      ''
      '       vf.PessoaTipo,'
      '       vf.PessoaNumero AS CNPJouCPF,'
      ''
      '       vf.estado,'
      '       b.Nome AS NomeBairro,'
      ''
      '       cd.Nome AS NomeCidade,'
      '       vf.inscricaomunicipal AS Documento,'
      ''
      '       vf.Rua,'
      '       vf.Numero as endnumero,'
      '       vf.complemento as endcomplemento,'
      ''
      '       vf.CEP,'
      '       f.razao AS NomeFilial,'
      '       f.cnpj AS CNPJFilial,'
      '       formatar_cpf_cnpj(vf.PessoaNumero) AS cnpjformatado,'
      '       d.cbpagamento,'
      ''
      '       cast(:conta as integer) as conta'
      ''
      ''
      'FROM   duplicatas d'
      '       join documentospag dp'
      '            join filiais f'
      '            on dp.filialemissao = f.codigo'
      ''
      '            join vfornecedores vf'
      '                 join bairros b'
      '                 on vf.bairro = b.codigo'
      '                 and vf.cidade = b.cidade'
      '                 and vf.estado = b.estado'
      ''
      '                 join cidades cd'
      '                 on  vf.cidade = cd.codigo'
      '                 and vf.estado = cd.estado'
      ''
      ''
      '            on dp.fornecedor = vf.codigo'
      '            and dp.tipofornecedor = vf.tipo'
      ''
      ''
      '       on d.documentopag = dp.numero'
      ''
      ''
      'WHERE  d.DataPagto IS NULL'
      ''
      '%DataVencto'
      '%DataEmissao'
      '%Filial'
      '%Cliente'
      '%Gerados'
      ''
      
        'ORDER BY UPPER(TO_ASCII(vf.nome,'#39'LATIN1'#39')), d.documentopag, d.Da' +
        'taVencto'
      ''
      ''
      ''
      '/* Parametros -> VENCTO INICIAL -> :VenctoInicial'
      '                 VENCTO FINAL -> :VenctoFinal'
      ''
      '                 */')
