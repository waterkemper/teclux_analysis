        Name = 'ordenacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';SELECT * FROM'
      '('
      'SELECT t.DocumentoPag,'
      '       t.DataVencto,'
      ''
      '       CASE WHEN t.DataVencto < CURRENT_DATE THEN '
      '                 ABS(t.DataVencto - CURRENT_DATE)'
      '            ELSE 0'
      '       END AS Atraso,'
      ''
      '       t.ValorVencto,'
      '       t.ValorDesconto,'
      '       t.TipoJuros,'
      '       t.Juros,'
      '       t.TipoMulta,'
      '       t.Multa,'
      '       t.Numero,  '
      '       t.ContaPagto,'
      ''
      '       FALSE as Quitar,'
      ''
      '       CASE WHEN t.DataVencto < CURRENT_DATE THEN '
      '                 CASE WHEN t.TipoMulta = '#39'%'#39' THEN '
      '                           CASE WHEN t.TipoJuros = '#39'%'#39' THEN '
      
        '                                     t.ValorVencto + (t.ValorVen' +
        'cto * COALESCE(t.Multa,0)) / 100 +'
      
        '                                                     (t.ValorVen' +
        'cto * (ABS(t.DataVencto - CURRENT_DATE) *'
      
        '                                                                ' +
        '                       COALESCE(t.juros,0) / 100))'
      '                                WHEN t.TipoJuros = '#39'V'#39' THEN'
      
        '                                     t.ValorVencto + (t.ValorVen' +
        'cto * COALESCE(t.Multa,0)) / 100 +'
      
        '                                                          (ABS(t' +
        '.DataVencto - CURRENT_DATE) * COALESCE(t.juros,0))'
      '                           END'
      ''
      '                      WHEN t.tipoMulta = '#39'V'#39' THEN'
      '                           CASE WHEN t.TipoJuros = '#39'%'#39' THEN'
      
        '                                     t.ValorVencto + COALESCE(t.' +
        'Multa,0) +'
      
        '                                    (t.ValorVencto * (ABS(t.Data' +
        'Vencto - CURRENT_DATE) * COALESCE(t.juros,0) / 100))'
      ''
      '                                WHEN t.TipoJuros = '#39'V'#39' THEN'
      
        '                                     t.ValorVencto + COALESCE(t.' +
        'Multa,0) +'
      
        '                                                     (ABS(t.Data' +
        'Vencto - CURRENT_DATE) * COALESCE(t.juros,0))'
      '                           END'
      '                 END'
      ''
      '            ELSE t.ValorVencto - coalesce(t.valordesconto,0)'
      '       END AS Previsao,'
      ''
      ''
      '       CASE WHEN t.DataVencto < CURRENT_DATE THEN'
      '                 CASE WHEN t.TipoMulta = '#39'%'#39' THEN'
      '                           CASE WHEN t.TipoJuros = '#39'%'#39' THEN'
      
        '                                     t.ValorVencto + (t.ValorVen' +
        'cto * COALESCE(t.Multa,0)) / 100 +'
      
        '                                                     (t.ValorVen' +
        'cto * (ABS(t.DataVencto - CURRENT_DATE) *'
      
        '                                                                ' +
        '                       COALESCE(t.juros,0) / 100))'
      '                                WHEN t.TipoJuros = '#39'V'#39' THEN'
      
        '                                     t.ValorVencto + (t.ValorVen' +
        'cto * COALESCE(t.Multa,0)) / 100 +'
      
        '                                                          (ABS(t' +
        '.DataVencto - CURRENT_DATE) * COALESCE(t.juros,0))'
      '                           END'
      ''
      '                      WHEN t.tipoMulta = '#39'V'#39' THEN'
      '                           CASE WHEN t.TipoJuros = '#39'%'#39' THEN'
      
        '                                     t.ValorVencto + COALESCE(t.' +
        'Multa,0) +'
      
        '                                    (t.ValorVencto * (ABS(t.Data' +
        'Vencto - CURRENT_DATE) * COALESCE(t.juros,0) / 100))'
      ''
      '                                WHEN t.TipoJuros = '#39'V'#39' THEN'
      
        '                                     t.ValorVencto + COALESCE(t.' +
        'Multa,0) +'
      
        '                                                     (ABS(t.Data' +
        'Vencto - CURRENT_DATE) * COALESCE(t.juros,0))'
      '                           END'
      '                 END'
      ''
      '            ELSE t.ValorVencto - coalesce(t.valordesconto,0)'
      '       END AS PrevisaoAnterior,'
      ''
      '       d.Fornecedor,'
      '       d.TipoFornecedor,'
      ''
      
        '       (SELECT coalesce(v.razao,v.nome) as nome    FROM   vForne' +
        'cedores v'
      '                        WHERE (d.Fornecedor = v.Codigo) AND'
      
        '                              (d.TipoFornecedor = CAST(v.Tipo as' +
        ' CHAR))) AS Nome,'
      ''
      '       COALESCE(CAST(TO_CHAR((SELECT n.Numero FROM  NotasPag n'
      
        '                                              WHERE n.DocumentoP' +
        'ag = t.DocumentoPag), '#39'999,999'#39') AS VARCHAR),'
      '                SUBSTRING(d.Complemento FROM 4 FOR 6)) AS Nota,'
      ''
      '       COALESCE(CAST((SELECT n.Serie FROM  NotasPag n'
      
        '                                     WHERE n.DocumentoPag = t.Do' +
        'cumentoPag) AS VARCHAR),'
      '                SUBSTRING(d.Complemento FROM 1 FOR 3)) AS Serie,'
      ''
      '       t.observacao'
      ''
      'FROM   Duplicatas t, DocumentosPag d'
      ''
      'WHERE (t.DocumentoPag = d.Numero)'
      '%Vencimento'
      '    AND (d.Previsao = FALSE)'
      '    AND (t.DataPagto IS NULL)'
      '    AND (t.Autorizado = TRUE)'
      ''
      '%Filial'
      '%GrupoFilial'
      '%Fornecedor'
      '%Documento'
      '%Banco'
      '%Tipo'
      '%Administrador'
      ')'
      'AS dp'
      '%Ordenacao')
    RequestLive = True
    Left = 57
    Top = 337
