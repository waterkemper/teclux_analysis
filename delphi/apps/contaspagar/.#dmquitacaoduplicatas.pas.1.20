function TdtmQuitacaoDuplicatas.GetTipoPessoa: String;
begin
  if qryFornecedorestipo.AsString = '' then
       Result:= 'F'
  else Result:= qryFornecedorestipo.AsString;
end;

procedure TdtmQuitacaoDuplicatas.MarcarSelecionados(Marcando, Todos: Boolean);
  procedure GravaraQuitar;
  begin
    qryagrupadas.edit;
    if qryAgrupadasQuitar.AsBoolean then
    begin
      qryAgrupadasaquitar.AsCurrency := qryAgrupadasPrevisao.AsCurrency;
      qryAgrupadasqtdeduplicatas.AsString := TodasDuplicatas;
    end
    else
    begin
      qryAgrupadasaquitar.AsCurrency := 0;
      qryAgrupadasqtdeduplicatas.AsString := NenhumaDuplicata;
    end;
    qryAgrupadas.Post;
  end;

begin
  case OperacaoTabela of
    Duplicatas:
    begin
      QtdeMarcados := QtdeMarcadosDuplicatas;
      TotalMarcados := TotalMarcadosDuplicatas;
      MarcarRegistros(qryduplicatas,qryduplicatasquitar,qryduplicatasprevisao,marcando,Todos);
      QtdeMarcadosDuplicatas := QtdeMarcados;
      TotalMarcadosDuplicatas := TotalMarcados;
    end;
    Agrupadas :
    begin
      QtdeMarcados := QtdeMarcadosAgrupados;
      TotalMarcados := TotalMarcadosAgrupados;

      if not todos
         and qryAgrupadasQuitar.AsBoolean then
        MarcarRegistros(qryAgrupadas,qryagrupadasquitar,qryagrupadasaquitar,marcando,Todos)
      else
        MarcarRegistros(qryAgrupadas,qryagrupadasquitar,qryagrupadasprevisao,marcando,Todos);

      QtdeMarcadosAgrupados := QtdeMarcados;
      TotalMarcadosAgrupados := TotalMarcados;

      if todos then
      begin
        GuardarRegistroAtual(qryagrupadas,true);
        qryagrupadas.First;
        while not qryagrupadas.Eof do
        begin
          GravaraQuitar;
          qryagrupadas.Next;
        end;
        VoltarRegistroAtual(qryAgrupadas);
      end
      else
        GravaraQuitar;
    end;
  end;
end;

procedure TdtmQuitacaoDuplicatas.MontaDataVencimento;
const
  Data_1: String = 'and (t.datavencto = ';
  Data_2: String = 'and (t.datavencto between (';
begin
   if not DataEmBranco(FVenctoInicial) then begin
      if DataEmBranco(FVenctoFinal) then begin
         qryDuplicatas.MacroByName('Vencimento').AsString:= Data_1 + '''' + FVenctoInicial + ''')';
         qryAgrupadas. MacroByName('Vencimento').AsString:= Data_1 + '''' + FVenctoInicial + ''')';
      end
      else begin
         qryDuplicatas.MacroByName('Vencimento').AsString:= Data_2 + '''' + FVenctoInicial + ''') and (''' + FVenctoFinal + '''))';
         qryAgrupadas. MacroByName('Vencimento').AsString:= Data_2 + '''' + FVenctoInicial + ''') and (''' + FVenctoFinal + '''))';
      end;
   end
   else begin
      if not DataEmBranco(FVenctoFinal) then begin
         qryDuplicatas.MacroByName('Vencimento').AsString:= Data_1 + '''' + FVenctoFinal + ''')';
         qryAgrupadas. MacroByName('Vencimento').AsString:= Data_1 + '''' + FVenctoFinal + ''')';
      end
      else begin
         qryDuplicatas.MacroByName('Vencimento').AsString:= '';
         qryAgrupadas. MacroByName('Vencimento').AsString:= '';
    end;
  end;
end;

