procedure TdtmQuitacaoDuplicatas.SetOrdenacao(const Value: Integer);
begin
   FOrdenacao := Value;
   case FOrdenacao of
      0:   begin
              qryDuplicatas.MacroByName('Ordenacao').AsString:= 'ORDER BY dp.DataVencto, UPPER(TO_ASCII(dp.nome,''LATIN1'')), dp.TipoFornecedor, dp.DocumentoPag, dp.ValorVencto';
              qryAgrupadas. MacroByName('Ordenacao').AsString:= 'ORDER BY dp.DataVencto, UPPER(TO_ASCII(dp.nome,''LATIN1'')), dp.ValorVencto';
           end;
      1:   begin
              qryDuplicatas.MacroByName('Ordenacao').AsString:= 'ORDER BY UPPER(TO_ASCII(dp.nome,''LATIN1'')), dp.Fornecedor, dp.TipoFornecedor, dp.DataVencto, dp.DocumentoPag, dp.ValorVencto';
              qryAgrupadas. MacroByName('Ordenacao').AsString:= 'ORDER BY UPPER(TO_ASCII(dp.nome,''LATIN1'')), dp.Fornecedor, dp.ValorVencto';
           end;
      else begin
              qryDuplicatas.MacroByName('Ordenacao').AsString:= 'ORDER BY dp.ValorVencto, dp.DataVencto, UPPER(TO_ASCII(dp.nome,''LATIN1'')), dp.TipoFornecedor, dp.DocumentoPag';
              qryAgrupadas. MacroByName('Ordenacao').AsString:= 'ORDER BY dp.ValorVencto, UPPER(TO_ASCII(dp.nome,''LATIN1'')), dp.DataVencto';
      end;
{     0:   begin
              qryDuplicatas.MacroByName('Ordenacao').AsString:= 'ORDER BY t.DataVencto, UPPER(TO_ASCII(nome,''LATIN1'')), d.TipoFornecedor, t.DocumentoPag, ValorVencto';
              qryAgrupadas. MacroByName('Ordenacao').AsString:= 'ORDER BY DataVencto, UPPER(TO_ASCII(nome,''LATIN1'')), ValorVencto';
           end;
      1:   begin
              qryDuplicatas.MacroByName('Ordenacao').AsString:= 'ORDER BY UPPER(TO_ASCII(nome,''LATIN1'')), d.Fornecedor, d.TipoFornecedor, t.DataVencto, t.DocumentoPag, ValorVencto';
              qryAgrupadas. MacroByName('Ordenacao').AsString:= 'ORDER BY UPPER(TO_ASCII(nome,''LATIN1'')), Fornecedor, ValorVencto';
           end;
      else begin
              qryDuplicatas.MacroByName('Ordenacao').AsString:= 'ORDER BY ValorVencto, DataVencto, UPPER(TO_ASCII(nome,''LATIN1'')), d.TipoFornecedor, t.DocumentoPag';
              qryAgrupadas. MacroByName('Ordenacao').AsString:= 'ORDER BY ValorVencto, UPPER(TO_ASCII(nome,''LATIN1'')), DataVencto';
      end;
}
   end;
end;

