procedure TdtmQuitacaoDuplicatas.gravarPrevisao_Detalhadas;
var
 vqtdemarcadas, vqtde: integer;
 vtotalmarcadas, vtotalprevisao: real;
 vqtdeduplicatas: string;
begin
  vqtdemarcadas := 0;
  vqtde         := 0;
  vtotalmarcadas:= 0;
  vtotalprevisao:= 0;

  qryduplicatas.First;
  while not qryduplicatas.Eof do
  begin
    if qryDuplicatasquitar.AsBoolean then
    begin
      vqtdemarcadas := vqtdemarcadas + 1;
      vtotalmarcadas := vtotalmarcadas + qryDuplicatasprevisao.AsCurrency;
    end;
    vqtde := vqtde + 1;
    vtotalprevisao := vtotalprevisao + qryDuplicatasprevisao.AsCurrency;

    qryduplicatas.Next;
  end;
  qryAgrupadasPrevisao.OnChange := nil;
  vqtdeduplicatas := inttostr(vqtdemarcadas)+'/'+inttostr(vqtde);

  dsrAgrupadas.onDataChange := nil;

  if (vqtdeduplicatas <> qryAgrupadasqtdeduplicatas.AsString)
     or (vtotalprevisao<>qryAgrupadasPrevisao.AsCurrency)
     or (vtotalmarcadas<>qryAgrupadasaquitar.AsCurrency)
     or (PrevisaoAlterada <> qryAgrupadasPrevisaoAlterada.asBoolean) then
  begin
    if qryAgrupadasQuitar.AsBoolean and (vqtdemarcadas=0) then
    begin
      qryAgrupadas.Edit;
      fQtdeMarcadosAgrupados := fQtdeMarcadosAgrupados -1;
      fTotalMarcadosAgrupados := fTotalMarcadosAgrupados -
                                qryAgrupadasaquitar.AsCurrency;
      qryAgrupadasQuitar.AsBoolean := false;
      qryAgrupadasaquitar.AsCurrency := 0;
      qryAgrupadasqtdeduplicatas.AsString := vqtdeduplicatas;
      fTotalAgrupadas := fTotalAgrupadas -
                        qryAgrupadasprevisaoanterior.AsCurrency +
                        vtotalprevisao;
      qryAgrupadasPrevisao.AsCurrency := vtotalprevisao;
      qryAgrupadasprevisaoanterior.AsCurrency := vtotalprevisao;
      qryAgrupadasPrevisaoAlterada.asBoolean := PrevisaoAlterada;
      qryagrupadas.Post;
    end
    else
    if not qryagrupadasquitar.AsBoolean and (vqtdemarcadas=0) then
    begin
      if vtotalprevisao<>qryAgrupadasPrevisao.AsCurrency then
      begin
        qryagrupadas.Edit;
        fTotalAgrupadas := fTotalAgrupadas -
                          qryAgrupadasprevisaoanterior.AsCurrency +
                          vtotalprevisao;
        qryAgrupadasPrevisao.AsCurrency := vtotalprevisao;
        qryAgrupadasprevisaoanterior.AsCurrency := vtotalprevisao;
        qryAgrupadasPrevisaoAlterada.asBoolean := PrevisaoAlterada;
        qryagrupadas.Post;
      end;
    end
    else
    if not qryAgrupadasQuitar.AsBoolean and (vqtdemarcadas<>0) then
    begin
      qryAgrupadas.Edit;
      fQtdeMarcadosAgrupados := fQtdeMarcadosAgrupados +1;
      fTotalMarcadosAgrupados := fTotalMarcadosAgrupados+
                                vtotalmarcadas;
      qryAgrupadasQuitar.AsBoolean := true;
      qryAgrupadasaquitar.AsCurrency := vtotalmarcadas;
      qryAgrupadasqtdeduplicatas.AsString := vqtdeduplicatas;
      fTotalAgrupadas := fTotalAgrupadas -
                        qryAgrupadasprevisaoanterior.AsCurrency +
                        vtotalprevisao;
      qryAgrupadasPrevisao.AsCurrency := vtotalprevisao;
      qryAgrupadasprevisaoanterior.AsCurrency := vtotalprevisao;
      qryAgrupadasPrevisaoAlterada.asBoolean := PrevisaoAlterada;
      qryagrupadas.Post;
    end
    else
    if qryAgrupadasQuitar.AsBoolean and (vqtdemarcadas<>0) then
    begin
      qryAgrupadas.Edit;
//      fQtdeMarcadosAgrupados := fQtdeMarcadosAgrupados +1
      fTotalMarcadosAgrupados := fTotalMarcadosAgrupados -
                                qryAgrupadasaquitar.AsCurrency+
                                vtotalmarcadas;
//      qryAgrupadasQuitar.AsBoolean := true;
      qryAgrupadasaquitar.AsCurrency := vtotalmarcadas;
      qryAgrupadasqtdeduplicatas.AsString := vqtdeduplicatas;
      fTotalAgrupadas := fTotalAgrupadas -
                        qryAgrupadasprevisaoanterior.AsCurrency +
                        vtotalprevisao;
      qryAgrupadasPrevisao.AsCurrency := vtotalprevisao;
      qryAgrupadasprevisaoanterior.AsCurrency := vtotalprevisao;
      qryAgrupadasPrevisaoAlterada.asBoolean := PrevisaoAlterada;
      qryagrupadas.Post;
    end;
  end;
  qryAgrupadasPrevisao.OnChange := qryAgrupadasPrevisaoChange;
  dsrAgrupadas.onDataChange := dsrAgrupadasDataChange;

end;

procedure TdtmQuitacaoDuplicatas.qryDuplicatasFilterRecord(
  DataSet: TDataSet; var Accept: Boolean);
begin
  inherited;
  if Agrupado = 1 then
    Accept := (qryDuplicatasfornecedor.AsInteger = qryAgrupadasfornecedor.AsInteger) and
              (qryDuplicatastipofornecedor.AsString = qryAgrupadastipofornecedor.AsString)
  else if Agrupado = 0 then
    Accept := (qryDuplicatasdocumentopag.AsString = qryAgrupadasdocumento.AsString);
end;

procedure TdtmQuitacaoDuplicatas.MarcarDuplicatasAgrupadas;
begin
  if QuitarTodasDuplicatas then
  begin
    qryduplicatas.First;
    while not qryduplicatas.Eof do
    begin
      qryduplicatas.Edit;
      qryDuplicatasquitar.AsBoolean := True;
      qryduplicatas.Post;
      qryduplicatas.Next;
    end;
  end;
end;

procedure TdtmQuitacaoDuplicatas.qryDuplicatasAfterPost(DataSet: TDataSet);
begin
  inherited;
  if qryDuplicatasobservacao.AsString <>
     qryDuplicatasobservacao.OldValue then
  begin
    qryDuplicatasObservacoes.ParamByName('observacao').AsString :=
      qryDuplicatasobservacao.AsString;
    qryDuplicatasObservacoes.ParamByName('documentopag').AsInteger :=
      qryDuplicatasdocumentopag.AsInteger;
    qryDuplicatasObservacoes.ParamByName('datavencto').AsDateTime :=
      qryDuplicatasdatavencto.AsDateTime;
    qryDuplicatasObservacoes.ParamByName('numero').AsInteger :=
      qryDuplicatasnumero.AsInteger;
    qryDuplicatasObservacoes.ExecSql;
  end;
end;

procedure TdtmQuitacaoDuplicatas.qryDuplicatasBeforeOpen(
  DataSet: TDataSet);
begin
  inherited;
  if not (UsuarioLogin.Administrador or UsuarioLogin.Suporte) then
    qryDuplicatas.MacroByName('Administrador').AsString:= 'and not d.administrador';

  qryDuplicatas.parambyname('DataCalculoDataPagamento').asDateTime := DataCalculoDataPagamento;  
end;

procedure TdtmQuitacaoDuplicatas.dsrDuplicatasDataChange(Sender: TObject;
  Field: TField);
begin
  inherited;
  if Field = qryDuplicatasprevisao then
  begin
    if Field.value = 0 then
    begin
      MensagemAviso('Para quitação com 100% de desconto utilize o cadastro de contas a pagar.');
      Field.value := qryDuplicatasvalorvencto.AsCurrency;
    end;
    qryDuplicatasprevisaoalterada.asBoolean := true;
    ControlarPrevisoesAlteradas('+');
  end;
end;

function TdtmQuitacaoDuplicatas.ValorPagar: Currency;
var
 Multa,Juros: Real;
 NrDias: Integer;
begin
 Multa:= 0;  Juros:= 0;
 if (DataCalculoDataPagamento > qryDuplicatasdatavenctodiautil.AsDateTime) then
 begin
   NrDias:= DaysBetween(DataCalculoDataPagamento,qryDuplicatasdatavenctodiautil.AsDateTime);
   if qryDuplicatasmulta.AsFloat > 0 then
     if (qryDuplicatastipomulta.AsString = '%') then
          Multa := ((qryDuplicatasvalorvencto.AsCurrency * qryDuplicatasmulta.AsFloat) / 100)
     else Multa := qryDuplicatasmulta.AsFloat;

   if qryDuplicatasjuros.AsFloat > 0 then
     if qryDuplicatastipojuros.AsString = '%' then
          Juros := ((qryDuplicatasvalorvencto.AsCurrency * (qryDuplicatasjuros.AsFloat * NrDias)) / 100)
     else Juros := (qryDuplicatasjuros.AsFloat * NrDias);
 end;

 if DataCalculoDataPagamento <= qryDuplicatasdatavenctodiautil.AsDateTime then
   Result:= qryDuplicatasvalorvencto.AsCurrency + Multa + Juros - qryDuplicatasvalordesconto.AsCurrency
 else
   Result:= qryDuplicatasvalorvencto.AsCurrency + Multa + Juros;

end;

procedure TdtmQuitacaoDuplicatas.SetDataCalculoDataPagamento(
  const Value: TDateTime);
begin

  if qryDuplicatas.active then
    if (FDataCalculoDataPagamento <> Value) then
    begin
      fDataCalculoDataPagamento := Value;
      ForcarRecalculo := true;
      CalcularValoresPrevisao;
    end;

  fDataCalculoDataPagamento := Value;
end;

function TdtmQuitacaoDuplicatas.GetDataCalculoDataPagamento: TDateTime;
begin
  result := fDataCalculoDataPagamento;
end;

procedure TdtmQuitacaoDuplicatas.CalcularValoresPrevisao;
begin

  if ForcarRecalculo then
  begin

    dsrDuplicatas.onDataChange := nil;
    GuardarRegistroAtual(qryDuplicatas, true);
    if previsaoalterada then
    begin
      if (MensagemSimNaoOpcaoCancelar('Existem valores a pagar alterados manualmente, refazer o cálculo destes?', '', false) = mrYes) then
      begin
        fprevisaoalterada := false;
        while not qryDuplicatas_PrevisoesAlteradas.eof do
          qryDuplicatas_PrevisoesAlteradas.delete;
      end;
    end;

    qryDuplicatas.first;
    while not qryduplicatas.eof do
    begin
      if not qryDuplicatasprevisaoalterada.asBoolean or not fprevisaoalterada then
      begin
        qryDuplicatas.edit;
        qryDuplicatasprevisao.AsCurrency := ValorPagar;
        qryDuplicatas.edit;
        qryDuplicatasprevisaoalterada.asBoolean := false;
        if qryduplicatas.state = dsedit then
          qryDuplicatas.post;
      end;
      qryduplicatas.next;
    end;
    VoltarregistroAtual(qryDuplicatas);
    dsrDuplicatas.onDataChange := dsrDuplicatasDataChange;
    ForcarRecalculo := false;
  end;

  case OperacaoTabela of
    Agrupadas : begin
                  GuardarRegistroAtual(qryAgrupadas, true);
                  case Agrupado of
                    0: SelecionarDuplicatasPorDocumento;
                    1: SelecionarDuplicatasPorFornecedor;
                  end;

                  qryAgrupadas.first;
                  while not qryAgrupadas.eof do
                  begin
                    gravarPrevisao_Detalhadas;
                    qryAgrupadas.next;
                  end;
                  
                  VoltarregistroAtual(qryAgrupadas);
                end;
  end

end;

procedure TdtmQuitacaoDuplicatas.dsrAgrupadasDataChange(Sender: TObject;
  Field: TField);
begin
  inherited;
  if Field = qryAgrupadasPrevisao then
  begin
    if Field.value = 0 then
    begin
      MensagemAviso('Para quitação com 100% de desconto utilize o cadastro de contas a pagar.');
      Field.value := qryAgrupadasValorVencto.AsCurrency;
    end;
    qryAgrupadasprevisaoalterada.asBoolean := true;
    ControlarPrevisoesAlteradas('+');
  end;
end;

procedure TdtmQuitacaoDuplicatas.ControlarPrevisoesAlteradas(
  Entra_ou_Sai: String);
begin
  case OperacaoTabela of
    Duplicatas : begin
                   if Entra_ou_Sai = '+' then
                   begin
                      if not qryDuplicatas_PrevisoesAlteradas.locate('documentopag;numero;datavencto',
                          VarArrayof([qryDuplicatasdocumentopag.asInteger,
                                      qryDuplicatasnumero.asinteger,
                                      qryDuplicatasdatavencto.asDateTime]),[]) then
                      begin
                        qryDuplicatas_PrevisoesAlteradas.append;
                        qryDuplicatas_PrevisoesAlteradasdocumentopag.asinteger := qryDuplicatasdocumentopag.asInteger;
                        qryDuplicatas_PrevisoesAlteradasnumero.asinteger := qryDuplicatasnumero.asinteger;
                        qryDuplicatas_PrevisoesAlteradasdatavencto.asDateTime := qryDuplicatasdatavencto.asDateTime;
                        qryDuplicatas_PrevisoesAlteradasfornecedor.asinteger := qryDuplicatasFornecedor.asinteger;
                        qryDuplicatas_PrevisoesAlteradastipofornecedor.asString := qryDuplicatastipoFornecedor.asString;

                        qryDuplicatas_PrevisoesAlteradas.post;
                      end;
                   end;
                end;

    Agrupadas : begin
                   case Agrupado of
                   0: SelecionarDuplicatasPorDocumento;
                   1: SelecionarDuplicatasPorFornecedor;
                   end;
                   OperacaoTabela := Duplicatas;
                   ControlarPrevisoesAlteradas('+');
                   OperacaoTabela := Agrupadas;
                end;
  end;
end;

function TdtmQuitacaoDuplicatas.getprevisaoalterada: boolean;
begin
  fprevisaoalterada :=  qryDuplicatas_PrevisoesAlteradas.recordcount <> 0;
  Result := fprevisaoalterada;
end;

procedure TdtmQuitacaoDuplicatas.qryDuplicatas_PrevisoesAlteradasFilterRecord(
  DataSet: TDataSet; var Accept: Boolean);
begin
  inherited;
  if Agrupado = 1 then
    Accept := (qryDuplicatas_PrevisoesAlteradasfornecedor.AsInteger = qryAgrupadasfornecedor.AsInteger) and
              (qryDuplicatas_PrevisoesAlteradastipofornecedor.AsString = qryAgrupadastipofornecedor.AsString)
  else if Agrupado = 0 then
    Accept := (qryDuplicatas_PrevisoesAlteradasdocumentopag.AsString = qryAgrupadasdocumento.AsString);

end;

procedure TdtmQuitacaoDuplicatas.qryAgrupadasBeforeOpen(DataSet: TDataSet);
begin
  inherited;
  qryAgrupadas.parambyname('DataCalculoDataPagamento').asDateTime := DataCalculoDataPagamento;
end;

procedure TdtmQuitacaoDuplicatas.SetSoDDA(const Value: Boolean);
begin
  fSoDDA := Value;

  if ComDDA then
  begin
    qryDuplicatas.MacroByName('DDA').AsString := '';
    qryAgrupadas. MacroByName('DDA').AsString := '';
  end
  else
  if SemDDA then
  begin
    qryDuplicatas.MacroByName('DDA').AsString := 'and not coalesce(t.dda,false)';
    qryAgrupadas. MacroByName('DDA').AsString := 'and not coalesce(t.dda,false)';
  end
  else
  if SoDDA then
  begin
    qryDuplicatas.MacroByName('DDA').AsString := 'and coalesce(t.dda,false)';
    qryAgrupadas. MacroByName('DDA').AsString := 'and coalesce(t.dda,false)';
  end;

end;

function TdtmQuitacaoDuplicatas.getdtmContasPagar: TdtmContasPagar;
begin
  if not assigned(fdtmContasPagar) then
    fdtmContasPagar := TdtmContasPagar.Create(self);

  Result := fdtmContasPagar;
end;

end.

