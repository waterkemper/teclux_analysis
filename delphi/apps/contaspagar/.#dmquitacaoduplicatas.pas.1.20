   Result := ExisteCodigo(qryConsultarContas, Campo, Codigo);
end;



function TdtmQuitacaoDuplicatas.GetConsultaContas: TtecQuery;
begin
  Result:= qryConsultarContas;
end;

function TdtmQuitacaoDuplicatas.ExisteFilPagto(Campo, Codigo: string): Boolean;
begin
  Result := ExisteCodigo(qryConsultaFilPagto, Campo, Codigo);

end;

function TdtmQuitacaoDuplicatas.GetConsultaFilPagto: TtecQuery;
begin
  Result:= qryConsultaFilPagto;
end;


procedure TdtmQuitacaoDuplicatas.qryContasAfterOpen(DataSet: TDataSet);
begin
  inherited;
  if ParSistema.GerarContabilidade then
    refazconsulta(qryProcuraCreditarPagamento, [0], [qryContascontacontabil.AsVariant]);
end;

function TdtmQuitacaoDuplicatas.ExisteContaContabil(campo,
  codigo: String): Boolean;
begin
  if campo = 'descricaoedentada' then
    Result:= ExisteCodigo(qryConsultaContaContabil, 'descricao', codigo)
  else
    Result:= ExisteCodigo(qryConsultaContaContabil, campo, codigo);
end;

function TdtmQuitacaoDuplicatas.TotalizarDuplicatas: Real;
var
  Total: Real;
  Pos  : TBookmark;
begin
  Total:= 0;
  if qryDuplicatas.Active and not qryDuplicatas.IsEmpty then
  begin
    Pos:= qryDuplicatas.GetBookmark;
    try
      qryDuplicatas.DisableControls;
      qryDuplicatas.First;
      while not qryDuplicatas.Eof do begin
        Total:= Total + qryDuplicatasprevisao.AsCurrency;
        qryDuplicatas.Next;
      end;
    finally
      qryDuplicatas.GotoBookmark(Pos);
      qryDuplicatas.FreeBookmark(Pos);
      qryDuplicatas.EnableControls;
    end;
  end;
  result := Total;
end;

procedure TdtmQuitacaoDuplicatas.qryAgrupadasAfterScroll(
  DataSet: TDataSet);
begin
  inherited;
  qryAgrupadasPrevisao.ReadOnly := not SomenteUmaDuplicata;
end;

procedure TdtmQuitacaoDuplicatas.qryAgrupadasPrevisaoChange(
  Sender: TField);
begin
  inherited;
  if qryAgrupadas.State = dsedit then
  begin
    if qryAgrupadasQuitar.AsBoolean then
    begin
      FTotalMarcadosAgrupados:= ((FTotalMarcadosAgrupados - qryAgrupadasPrevisaoAnterior.AsCurrency) +
                                          qryAgrupadasprevisao.AsCurrency);
      qryAgrupadasaquitar.AsCurrency := qryAgrupadasPrevisao.AsCurrency;
    end;
    FTotalAgrupadas:= ((FTotalAgrupadas - qryAgrupadasPrevisaoAnterior.AsCurrency) +
                                        qryAgrupadasprevisao.AsCurrency);
    qryAgrupadasprevisaoanterior.AsCurrency := qryAgrupadasprevisao.AsCurrency;
    qryAgrupadas.post;
    if SomenteUmaDuplicata then
      if qryDuplicatas.Locate('documentopag',qryAgrupadasDocumento.AsInteger,[]) then
      begin
        qryduplicatas.Edit;
        qryDuplicatasprevisao.AsCurrency := qryAgrupadasPrevisao.AsCurrency;
//        qryduplicatas.Post;
      end;
    if Assigned(FOnDuplicatasEdit) then
      FOnDuplicatasEdit(qryDuplicatas);
  end;

end;

procedure TdtmQuitacaoDuplicatas.SelecionarDuplicatasPorDocumento;
begin
  qryduplicatas.Filter := 'documentopag = '+qryAgrupadasdocumento.AsString;
  qryduplicatas.Filtered := True;

  qryDuplicatas_PrevisoesAlteradas.Filter := 'documentopag = '+qryAgrupadasdocumento.AsString;
  qryDuplicatas_PrevisoesAlteradas.Filtered := true;
end;

procedure TdtmQuitacaoDuplicatas.gravarPrevisao_Agrupadas;
begin
//  PrevisaoAlterada := false;
  qryDuplicatasprevisao.OnChange := nil;
  qryduplicatas.DisableControls;
  if SomenteUmaDuplicata then
  begin
    TotalDuplicatas := qryAgrupadasPrevisao.AsCurrency;
    QtdeDuplicatas := 1;
    TotalMarcadosDuplicatas := 0;
    QtdeMarcadosDuplicatas := 0;
    if qryAgrupadasQuitar.AsBoolean then
    begin
      TotalMarcadosDuplicatas := qryAgrupadasPrevisao.AsCurrency;
      QtdeMarcadosDuplicatas := 1;
    end;

    dsrDuplicatas.onDataChange := nil;
    qryDuplicatas.Edit;
    qryDuplicatasquitar.AsBoolean := qryAgrupadasQuitar.AsBoolean;
    qryDuplicatasprevisaoanterior.AsCurrency := qryAgrupadasPrevisao.AsCurrency;
    qryDuplicatasprevisao.AsCurrency := qryAgrupadasPrevisao.AsCurrency;
    qryDuplicatasPrevisaoAlterada.asBoolean := qryAGrupadasPrevisaoAlterada.asBoolean;
    qryDuplicatas.post;
    dsrDuplicatas.onDataChange := dsrDuplicatasDataChange;

    {
    if qryDuplicatasPrevisaoAlterada.asBoolean then
      PrevisaoAlterada := true;
     }

  end
  else
  if QuitarTodasDuplicatas then //todas
  begin
    TotalDuplicatas := 0;
    QtdeDuplicatas := 0;
    qryduplicatas.First;
    while not qryduplicatas.Eof do
    begin
      qryduplicatas.Edit;
      if not qryDuplicatasquitar.AsBoolean then
        qryDuplicatasquitar.AsBoolean := true;
      qryDuplicatasprevisaoanterior.AsCurrency := qryDuplicatasprevisao.AsCurrency;
      qryduplicatas.Post;
      totalduplicatas := totalduplicatas + qryDuplicatasprevisao.AsCurrency;
      QtdeDuplicatas := QtdeDuplicatas + 1;

      {
      if qryDuplicatasPrevisaoAlterada.asBoolean then
        PrevisaoAlterada := true;
      }
      qryduplicatas.Next;
    end;
    TotalMarcadosDuplicatas := totalduplicatas;
    QtdeMarcadosDuplicatas := QtdeDuplicatas;
  end
  else
  if not qryAgrupadasQuitar.AsBoolean then //nenhuma
  begin
    TotalDuplicatas := 0;
    QtdeDuplicatas := 0;
    qryduplicatas.First;
    while not qryduplicatas.Eof do
    begin
      qryduplicatas.Edit;
      if qryDuplicatasquitar.AsBoolean then
        qryDuplicatasquitar.AsBoolean := false;
      qryDuplicatasprevisaoanterior.AsCurrency := qryDuplicatasprevisao.AsCurrency;
      qryduplicatas.Post;
      totalduplicatas := totalduplicatas + qryDuplicatasprevisao.AsCurrency;
      QtdeDuplicatas := QtdeDuplicatas + 1;

      {
      if qryDuplicatasPrevisaoAlterada.asBoolean then
        PrevisaoAlterada := true;
      }
      qryduplicatas.Next;
    end;
    TotalMarcadosDuplicatas := 0;
    QtdeMarcadosDuplicatas := 0;
  end
  else  //parcial
  begin
    TotalDuplicatas := 0;
    QtdeDuplicatas := 0;
    TotalMarcadosDuplicatas := 0;
    QtdeMarcadosDuplicatas := 0;
    qryduplicatas.First;
    while not qryduplicatas.Eof do
    begin
      if qryDuplicatasquitar.AsBoolean then
      begin
        TotalMarcadosDuplicatas := TotalMarcadosDuplicatas + qryDuplicatasprevisao.AsCurrency;
        QtdeMarcadosDuplicatas := QtdeMarcadosDuplicatas +1;
      end;
      totalduplicatas := totalduplicatas + qryDuplicatasprevisao.AsCurrency;
      QtdeDuplicatas := QtdeDuplicatas + 1;
      qryduplicatas.Edit;
      qryDuplicatasprevisaoanterior.AsCurrency := qryDuplicatasprevisao.AsCurrency;
      qryduplicatas.Post;

      {
      if qryDuplicatasPrevisaoAlterada.asBoolean then
        PrevisaoAlterada := true;
      }
      qryduplicatas.Next;
    end;
  end;
  qryduplicatas.EnableControls;
  qryDuplicatasprevisao.OnChange := qryDuplicatasprevisaoChange;
end;

function TdtmQuitacaoDuplicatas.getSomenteUmaDuplicata: boolean;
begin
  FSomenteUmaDuplicata := (pos('/1',qryAgrupadasqtdeduplicatas.AsString)<>0)
                           and (length(qryAgrupadasqtdeduplicatas.AsString)=3);
  result := FSomenteUmaDuplicata;
end;

function TdtmQuitacaoDuplicatas.GetNenhumaDuplicata: String;
begin
  FNenhumaDuplicata := '0/'+
                       copy(qryAgrupadasqtdeduplicatas.AsString,
                          pos('/',qryAgrupadasqtdeduplicatas.AsString)+1,
                          100);
  Result := FNenhumaDuplicata;
end;

function TdtmQuitacaoDuplicatas.GetTodasDuplicatas: String;
begin
  FTodasDuplicatas := copy(qryAgrupadasqtdeduplicatas.AsString,
                          pos('/',qryAgrupadasqtdeduplicatas.AsString)+1,
                          100)+
                     '/'+
                     copy(qryAgrupadasqtdeduplicatas.AsString,
                          pos('/',qryAgrupadasqtdeduplicatas.AsString)+1,
                          100);
  Result := FTodasDuplicatas;
end;

