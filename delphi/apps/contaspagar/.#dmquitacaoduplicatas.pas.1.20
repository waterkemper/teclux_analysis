procedure TdtmQuitacaoDuplicatas.ImprimirCheque(Total: Real48;
                                                NominalCheque: String);
var
  Valor,
  Extenso1,
  Extenso2,
  DiaCheque,
  MesCheque,
  AnoCheque,
  CidadeCheque: String;
  Dia, Mes, Ano: Word;
  Linha: T_Extenso;

begin
  FillChar(Linha,SizeOf(Linha),0);
  Linha.ExtTamLinha[1]:= 56;
  Linha.ExtTamLinha[2]:= 56;
  Extenso(Total,$92,'','','','','*', Linha);
  Extenso1:= Linha.ExtLinha[1];
  Extenso2:= Linha.ExtLinha[2];
  Valor := Trocar(Trocar(Format('%9.2m',[Total]),'R',''),'$','');
  DecodeDate(StrToDate(FDataQuitacao),Ano,Mes,Dia);
  CidadeCheque:= FCidade + ',';
  DiaCheque:= Format('%2.2d',[Dia]);
  MesCheque:= ANSIUpperCase(MesExtenso(Mes));
  AnoCheque:= Copy(IntToStr(Ano),Length(IntToStr(Ano))-1,2);

  with TextPrinter do begin
    BeginDoc(qryModeloChequeconfigurar.AsString);
    if qryModeloChequecopiacheque.AsString = 'N' then begin
      BandString := qryModeloChequecabecalho.AsString;
      WriteBand([Valor,Extenso1,Extenso2,NominalCheque,CidadeCheque,DiaCheque,MesCheque,AnoCheque]);
    end
    else begin
      BandString := qryModeloChequecabecalho.AsString;
      WriteBand(['Banco: '   + Format('%3.3d',[FBanco]),
//                 'Agencia: ' + Format('%4.4d',[FAgencia]),
                 'Cheque: '  + Format('%6.6d',[StrToInt(FNrCheque)]), Valor]);
      BandString := qryModeloChequeproduto.AsString;
      WriteBand([Extenso1,Extenso2,NominalCheque,CidadeCheque,DiaCheque,MesCheque,AnoCheque])
    end;
    FormFeed;
    EndDoc('TecLUX - Imprimindo Cheque.');
  end;
end;

function TdtmQuitacaoDuplicatas.EfetuarQuitacao: boolean;
begin
   result := false;

   if not assigned(Usuario) then
     Usuario := TtecUsuarios.Create(dtmTecSoft.Database);

   try
      if UsuarioLogin.Pagamento
      then Usuario:= ObterAutorizacao(taSENHA)
      else Usuario:= ObterAutorizacao(taLOGIN, ctAUTORIZACAOPAGAMENTO, ctAUTORIZADO);

      if Assigned(Usuario) and Usuario.Pagamento then
      begin
         result := true;
         if FOpcoes = 0 then
         begin
            QuitarDuplicatas;
            SelecionarDuplicatas;
         end

         else begin
            ReFazConsulta(qryModeloCheque, [0], [qryContasModeloCheque.AsInteger]);

            if not qryModeloCheque.IsEmpty then begin
               frmSelecionarImpressoras := TfrmSelecionarImpressoras.Create(frmSelecionarImpressoras, ' ');
               try
                  if frmSelecionarImpressoras.ShowModal = mrok
                  then NomeImpressoraEscolhida := frmSelecionarImpressoras.NomeImpressora
                  else MensagemAviso(ctSELECIONARIMPRESSORA)
               finally
                  frmSelecionarImpressoras.Free;
               end;

               Nominal := '';
               if (Opcoes = 0) or
                 ((opcoes = 1) and (Agrupado = 2)) then QuitarDuplicatas
               else QuitarAgrupadas;

               SelecionarDuplicatas;
            end
            else MensagemAviso(ctMODELOIMPRESSAOCHEQUE);
         end;
      end
      else MensagemAviso(format(ctUSUARIONAOAUTORIZADO,['autorizar o pagamento de duplicatas.']));

   finally
//      Usuario.Free;
   end;
end;

procedure TdtmQuitacaoDuplicatas.QuitarAgrupadas;
begin
  Nominal := qryAgrupadasNome.AsString;
  qryAgrupadas.First;
  while not qryAgrupadas.Eof do
  begin
    if qryAgrupadasquitar.AsBoolean then
    begin
      case FAgrupado of
        0: SelecionarDuplicatasPorDocumento;
        1: SelecionarDuplicatasPorFornecedor;
      end;
      MarcarDuplicatasAgrupadas;
      if not ChequeUnico then
      begin
        Nominal := qryAgrupadasNome.AsString;
        QuitarDuplicatas;
      end;
    end;
    qryAgrupadas.Next;
  end;
  qryDuplicatas.Filtered := false;
  qryDuplicatas_PrevisoesAlteradas.filtered := false;

  if ChequeUnico then
  begin
    TotalCheque := 0;
    QuitarDuplicatas;
  end;
end;

procedure TdtmQuitacaoDuplicatas.QuitarDuplicatas;
var Fornecedor,DocumentoPag: Integer;
//    Nominal:    String;
    Tipo:       String;
//  Total:      Currency;
    vAgruparPagamentosnoLote : Boolean;
begin
   vAgruparPagamentosnoLote := false;
   if NrCheque<>'' then
     vAgruparPagamentosnoLote := qryConta_e_Cheque.Active or (MensagemSimNaoOpcaoCancelar(format('Deseja agrupar os pagamentos no cheque ''%s''',[NrCheque]),'',False) = mrYes);

   if not ChequeUnico then
     TotalCheque := 0;

   Fornecedor   := 0;
   DocumentoPag := 0;
   FBanco       := 0;
   FCheque      := 0;
// FAgencia  := 0;

{
   if not assigned(dtmContasPagar) then
     dtmContasPagar := TdtmContasPagar.Create(self);
     }

   if not qryDuplicatas.IsEmpty then
   begin
     try
       //qryDuplicatas.DisableControls;
       qryDuplicatas.First;

       while not qryDuplicatas.Eof do
       begin
         if qryDuplicatasquitar.AsBoolean then
         begin
           if DocumentoPagAberto = qryDuplicatasdocumentopag.AsInteger then
             ReabrirDocumentoPag := true;

           if FOpcoes = 1 then
           begin
             if (FAgrupado    = 0) and
                (DocumentoPag > 0) and
                (DocumentoPag <> qryDuplicatasdocumentopag.AsInteger) then
             begin
               ImprimirCheque(TotalCheque,Nominal);
               TotalCheque:= 0;
             end
             else
             if (FAgrupado  = 1) and
                (Fornecedor > 0) and
                ((Fornecedor <> qryDuplicatasfornecedor.AsInteger) or
                 (Tipo <> qryDuplicatastipofornecedor.AsString)) then
             begin
               ImprimirCheque(TotalCheque,Nominal);
               TotalCheque:= 0;
             end;
           end;

           if dtmContasPagar.QuitarDuplicatas(
                          qryDuplicatasdocumentopag         .AsInteger,
                          qryDuplicatasnumero               .AsInteger,
                          qryFilPagtoCodigo                 .AsInteger,
                          qryTipoPagtocodigo                .AsInteger,
                          qryContasConta                    .AsInteger,
                          qryProcuraCreditarPagamentocodigo .AsInteger,
                          FNrCheque,
                          qryDuplicatasobservacao.asString,
                          qryDuplicatasdatavencto           .AsDateTime,
                          StrToDate(FDataQuitacao),
                          qryDuplicatasprevisao             .AsCurrency,
                          vAgruparPagamentosnoLote,
                          qryConta_e_Chequesequencia.asstring,
                          qryConta_e_Chequenrlotecontabil.asstring
                          ) then
           begin
             if not qryContasConta.IsNull then
             begin
               if FNrCheque <> '' then
               begin
                 if FAgrupado = 2 then
                   if not ChequeUnico then
                     NrCheque := IntToStr(StrToInt(FNrCheque) + 1);
               end;
             end;

             if FOpcoes = 1 then
             begin

               if not ChequeUnico then
               begin
                 Fornecedor   := qryDuplicatasfornecedor.    AsInteger;
                 Tipo         := qryDuplicatastipofornecedor.AsString;
                 DocumentoPag := qryDuplicatasdocumentopag.AsInteger;
               end;

               case TipoNominal of
                0: Nominal:= '';
                1: case OperacaoTabela of
                     Duplicatas: if not chequeunico or
                                    (Nominal = '') then
                                    Nominal:= qryDuplicatasnome.AsString;
                     Agrupadas : if not ChequeUnico then
                                    Nominal:= qryAgrupadasNome. AsString;
                   end;
                2: Nominal:= NomeFilialBase;
               end;

               FBanco  := qryContasBanco.AsInteger;
//               FCheque := qryQuitarDuplicataschequepagto.AsInteger;


               if (FAgrupado <> 2) or
                  ChequeUnico then
                 TotalCheque:= TotalCheque + qryDuplicatasprevisao.AsCurrency
               else
               begin
                 TotalCheque := qryDuplicatasprevisao.AsCurrency;
                 ImprimirCheque(TotalCheque,Nominal);
               end;

             end;
           end;
         end;
         qryDuplicatas.Next;
       end;

       if ((FOpcoes = 1) and
           (FAgrupado in [0, 1])) or ChequeUnico then
       begin
         ImprimirCheque(TotalCheque, Nominal);
         NrCheque:= IntToStr(StrToInt(FNrCheque) + 1);
       end;

     finally
       dtmcontaspagar.qryMovtosBancosProximaSequencia.Close;
       dtmcontaspagar.qryProximoNrLoteLanctoDuplicata.Close;
       //qryDuplicatas.EnableControls;
     end;
   end;
   freeandnil(fdtmContasPagar);
//   dtmcontaspagar.Free;
//   dtmContasPagar := nil;
end;


procedure TdtmQuitacaoDuplicatas.Selecionar(TipoPesquisa: TtecQuitacaoDuplicatas);
begin
  case TipoPesquisa of
//    dupFILIAIS:      ReFazConsulta(qryFilial,       [0],    [qryConsultaFiliaisCodigo.     AsInteger]);
    dupFILIAISPAGTO: ReFazConsulta(qryFilPagto,     [0],    [qryConsultaFilPagtoCodigo.    AsInteger]);
//    dupGRUPOFILIAIS: ReFazConsulta(qryGrupoFiliais, [0],    [qryConsultaGrupoFiliaisCodigo.AsInteger]);
    dupFORNECEDORES: ReFazConsulta(qryFornecedores, [0, 1], [qryConsultaFornecedoresTipo.  AsString,
                                                             qryConsultaFornecedoresCodigo.AsInteger]);
    dupBANCO:        ReFazConsulta(qryBancos,       [0],    [qryConsultarBancosCodigo.     AsInteger]);
    dupTIPOPAGTO:    ReFazConsulta(qryTipoPagto,    [0],    [qryConsultaTipoPagtocodigo.   AsInteger]);

    dupCONTA:        begin
//                        if FOpcoes = 1
//                        then qryContas.MacroByName('SoComCheque').AsString:= 'AND b.ModeloCheque IS NOT NULL'
//                        else qryContas.MacroByName('SoComCheque').AsString:= '';
                        ReFazConsulta(qryContas, [0], [qryConsultarContasConta.AsInteger]);
                     end;
    dupCONTACREDITOPAGAMENTO :
                     refazconsulta(qryProcuraCreditarPagamento, [0], [qryConsultaContaContabilcodigo.AsVariant]);
  end;
end;



procedure TdtmQuitacaoDuplicatas.SetBanco(const Value: String);
begin
   if Value <> '' then begin
      qryDuplicatas.MacroByName('Banco').AsString:= 'and (t.bancocobranca = ' + Value + ')';
      qryAgrupadas. MacroByName('Banco').AsString:= 'and (t.bancocobranca = ' + Value + ')';
   end
   else begin
      qryDuplicatas.MacroByName('Banco').AsString:= '';
      qryAgrupadas. MacroByName('Banco').AsString:= '';
   end;
end;

procedure TdtmQuitacaoDuplicatas.SetFilial(const Value: String);
begin
   if Value <> '' then begin
      qryDuplicatas.MacroByName('Filial').AsString:= 'and (d.filialemissao IN (' + Value + '))';
      qryAgrupadas. MacroByName('Filial').AsString:= 'and (d.filialemissao IN (' + Value + '))';
   end
   else begin
      qryDuplicatas.MacroByName('Filial').AsString:= '';
      qryAgrupadas. MacroByName('Filial').AsString:= '';
   end;
end;

procedure TdtmQuitacaoDuplicatas.SetFornecedor(const Value: String);
begin
   if Value <> '' then begin
      qryDuplicatas.MacroByName('Fornecedor').AsString:= 'and (d.fornecedor = ' + Value + ') and ' +
                                                         '(d.tipofornecedor = ' + '''' +
                                                         qryFornecedorestipo.AsString + '''' + ')';

      qryAgrupadas. MacroByName('Fornecedor').AsString:= 'and (d.fornecedor = ' + Value + ') and ' +
                                                         '(d.tipofornecedor = ' + '''' +
                                                         qryFornecedorestipo.AsString + '''' + ')';
   end
   else begin
      qryDuplicatas.MacroByName('Fornecedor').AsString:= '';
      qryAgrupadas. MacroByName('Fornecedor').AsString:= ''
   end;
end;

procedure TdtmQuitacaoDuplicatas.SetGrupo(const Value: String);
begin
   if Value <> '' then begin
      qryDuplicatas.MacroByName('GrupoFilial').AsString:= 'and (d.filialemissao in (Select filial From filiaisgruposfiliais Where grupo = ' + Value + '))';
      qryAgrupadas. MacroByName('GrupoFilial').AsString:= 'and (d.filialemissao in (Select filial From filiaisgruposfiliais Where grupo = ' + Value + '))';
   end
   else begin
      qryDuplicatas.MacroByName('GrupoFilial').AsString:= '';
      qryAgrupadas. MacroByName('GrupoFilial').AsString:= '';
   end;
end;

procedure TdtmQuitacaoDuplicatas.SetTipo(const Value: String);
begin
   case Value[1] of
      'C': begin
              qryDuplicatas.MacroByName('Tipo').AsString:= 'and (t.bancocobranca is null)';
              qryAgrupadas. MacroByName('Tipo').AsString:= 'and (t.bancocobranca is null)';
           end;
      'B': begin
              qryDuplicatas.MacroByName('Tipo').AsString:= 'and (t.bancocobranca is not null)';
              qryAgrupadas. MacroByName('Tipo').AsString:= 'and (t.bancocobranca is not null)';
           end;
      'T': begin
              qryDuplicatas.MacroByName('Tipo').AsString:= '';
              qryAgrupadas. MacroByName('Tipo').AsString:= '';
           end;
   end;
end;

procedure TdtmQuitacaoDuplicatas.SetVenctoFinal(const Value: String);
begin
  if not DataEmBranco(Value) then
       FVenctoFinal := Value
  else FVenctoFinal := '';
  MontaDataVencimento;
end;

procedure TdtmQuitacaoDuplicatas.SetVenctoInicial(const Value: String);
begin
  if not DataEmBranco(Value) then
       FVenctoInicial := Value
  else FVenctoInicial := '';
  MontaDataVencimento;
end;

