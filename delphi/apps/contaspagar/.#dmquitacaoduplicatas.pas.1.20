{$R *.dfm}

{ TdtmQuitacaoDuplicatas }

procedure TdtmQuitacaoDuplicatas.AbreTabelaPesquisa(TipoPesquisa: TtecQuitacaoDuplicatas);
begin
   case TipoPesquisa of
      dupFILIAIS:      Abre(ctConsultaFiliais);
      dupFILIAISPAGTO: Abre(ctConsultaFilialPagamento);
      dupGRUPOFILIAIS: Abre(ctConsultaGruposFiliais);
      dupFORNECEDORES: begin
                          qryConsultaFornecedores.MacroByName('ClausulaWhere').AsString:= 'WHERE v.Codigo = 0';
                          Abre(ctConsultaFornecedores);
                       end;
      dupBANCO:        Abre(ctPagamentoConsultaBancos);
      dupTIPOPAGTO:    Abre(ctConsultaTiposPagamentos);
      dupCONTA:        begin
                          if FOpcoes = 1
                          then qryConsultarContas.MacroByName('SoComModeloCheque').AsString:= 'WHERE b.ModeloCheque IS NOT NULL'
                          else qryConsultarContas.MacroByName('SoComModeloCheque').AsString:= '';

                          Abre(ctConsultaContas);
                       end;
      dupCONTACREDITOPAGAMENTO : begin
                                   qryConsultaContaContabil.MacroByName('consulta').AsString := '';
                                   Abre(ctConsultaContaContabil);
                                 end;
   end;
end;

constructor TdtmQuitacaoDuplicatas.Create(AOwner: TComponent);
begin
  inherited;

//  qryFilial.         Tag:= ctTabelas;
  qryFilPagto.       Tag:= ctTabelas;
//  qryGrupoFiliais.   Tag:= ctTabelas;
  qryFornecedores.   Tag:= ctTabelas;
  qryConsultarBancos.Tag:= ctTabelas;
  qryTipoPagto.      Tag:= ctTabelas;
  qryBancos.         Tag:= ctTabelas;
  qryContas.         Tag:= ctTabelas;

//  qryConsultaFiliais.     Tag:= ctConsultaFiliais;
  qryConsultaFilPagto.    Tag:= ctConsultaFilialPagamento;
//  qryConsultaGrupoFiliais.Tag:= ctConsultaGruposFiliais;
  qryConsultaFornecedores.Tag:= ctConsultaFornecedores;
  qryConsultaTipoPagto.   Tag:= ctConsultaTiposPagamentos;
  qryConsultarContas.     Tag:= ctConsultaContas;
  qryConsultaContaContabil.Tag := ctConsultaContaContabil;

end;


function TdtmQuitacaoDuplicatas.ExisteBanco(Campo, Codigo: String): Boolean;
begin
  Result := ExisteCodigo(qryConsultarBancos, Campo, Codigo);
end;

{
function TdtmQuitacaoDuplicatas.ExisteFiliais(Campo, Codigo: string): Boolean;
begin
  Result := ExisteCodigo(qryConsultaFiliais, Campo, Codigo);
end;
}

function TdtmQuitacaoDuplicatas.ExisteFornecedores(Campo, Codigo: String): Boolean;
begin
        if Campo = 'NomeCidade'  then Campo:= 'c.Nome'
   else if Campo = 'TipoCliente' then Campo:= 'v.Tipo'
                                 else Campo:= 'v.' + Campo;
   qryConsultaFornecedores.MacroByName('ClausulaWhere').AsString:= 
                    Format('Where (to_ascii(%s,''latin1'') ilike to_ascii(''%s%s'',''latin1''))', [Campo, Codigo, '%']);
   RefazConsulta(qryConsultaFornecedores, [], []);
   Result:= qryConsultaFornecedores.RecordCount > 0
end;

{
function TdtmQuitacaoDuplicatas.ExisteGrupoFiliais(Campo, Codigo: String): Boolean;
begin
  Result := ExisteCodigo(qryConsultaGrupoFiliais, Campo, Codigo);
end;
}

function TdtmQuitacaoDuplicatas.ExisteTipoPagamento(Campo, Codigo: String): Boolean;
begin
  Result := ExisteCodigo(qryConsultaTipoPagto, Campo, Codigo);
end;

procedure TdtmQuitacaoDuplicatas.FechaTabelaPesquisa(TipoPesquisa: TtecQuitacaoDuplicatas);
begin
   case TipoPesquisa of
      dupFILIAIS:      Fecha(ctConsultaFiliais);
      dupFILIAISPAGTO: Fecha(ctConsultaFilialPagamento);
      dupGRUPOFILIAIS: Fecha(ctConsultaGruposFiliais);
      dupFORNECEDORES: Fecha(ctConsultaFornecedores);
      dupBANCO:        Fecha(ctPagamentoConsultaBancos);
      dupCONTA:        Fecha(ctConsultaContas);
      dupTIPOPAGTO:   Fecha(ctConsultaTiposPagamentos);
      dupCONTACREDITOPAGAMENTO : Fecha(ctConsultaContaContabil);
   end;
end;

function TdtmQuitacaoDuplicatas.SelecionarDuplicatas: Boolean;
begin
  qryDuplicatas_PrevisoesAlteradas.close;
  qryDuplicatas_PrevisoesAlteradas.open;
  qryDuplicatas_PrevisoesAlteradas.delete;

  case OperacaoTabela of
    Duplicatas : begin
                   qryduplicatas.Filtered := false;
                   qryDuplicatas_PrevisoesAlteradas.filtered := false;
                   ReFazConsulta(qryduplicatas,[],[]);
                   TotalDuplicatas := TotalizarDuplicatas;
                   QtdeDuplicatas := qryduplicatas.RecordCount;
                 end;
    Agrupadas  : begin
                   ReFazConsulta(qryduplicatas,[],[]);
                   ReFazConsulta(qryAgrupadas,[],[]);
                   TotalAgrupadas := TotalizarAgrupadas;
                   QtdeAgrupadas := qryAgrupadas.RecordCount;
                 end;
  end;

  Result := not qryDuplicatas.IsEmpty or not qryAgrupadas.IsEmpty;
end;

procedure TdtmQuitacaoDuplicatas.SelecionarDuplicatasPorFornecedor;
begin
  qryduplicatas.Filter := 'fornecedor = '+qryAgrupadasfornecedor.AsString+
                          ' and tipofornecedor = '+quotedstr(qryAgrupadastipofornecedor.AsString);
  qryduplicatas.Filtered := True;

  qryDuplicatas_PrevisoesAlteradas.Filter := 'fornecedor = '+qryAgrupadasfornecedor.AsString+
                          ' and tipofornecedor = '+quotedstr(qryAgrupadastipofornecedor.AsString);
  qryDuplicatas_PrevisoesAlteradas.Filtered := True;

end;

