procedure TdtmQuitacaoDuplicatas.qryDuplicatasprevisaoChange(Sender: TField);
begin
  inherited;
  qryDuplicatasprevisao.OnChange := nil;
  if qryDuplicatas.State = dsedit then
  begin
    if qryDuplicatasquitar.AsBoolean then
    begin
      FTotalMarcadosDuplicatas:= ((FTotalMarcadosDuplicatas - qryDuplicatasPrevisaoAnterior.AsCurrency) +
                                          qryDuplicatasprevisao.AsCurrency);
    end;
    FTotalDuplicatas:= ((FTotalDuplicatas - qryDuplicatasPrevisaoAnterior.AsCurrency) +
                                        qryDuplicatasprevisao.AsCurrency);
    qryDuplicatasprevisaoanterior.AsCurrency := qryDuplicatasprevisao.AsCurrency;
    qryDuplicatas.post;
    if Assigned(FOnDuplicatasEdit) then
      FOnDuplicatasEdit(qryDuplicatas);
  end;
  qryDuplicatasprevisao.OnChange := qryDuplicatasprevisaoChange;
end;

procedure TdtmQuitacaoDuplicatas.SetOpcoes(const Value: Integer);
begin
  if FOpcoes <> Value then
    FOpcoes:= Value;
    
  if (opcoes = 0) or
     ((opcoes = 1) and (Agrupado = 2)) then
     OperacaoTabela := Duplicatas
  else
     OperacaoTabela := Agrupadas;
end;

procedure TdtmQuitacaoDuplicatas.SetAgrupado(const Value: Integer);
begin
  if FAgrupado <> Value then
    FAgrupado:= Value;
  case agrupado of
  0: qryAgrupadas.Sql.Text := qryAgrupadas_Documento.Sql.Text;
  1: qryAgrupadas.Sql.Text := qryAgrupadas_Fornecedor.Sql.Text;
  end;
end;

procedure TdtmQuitacaoDuplicatas.SetCidade(const Value: String);
begin
  if FCidade <> Value then
    FCidade:= Value;
end;

procedure TdtmQuitacaoDuplicatas.SetDataQuitacao(const Value: String);
begin
  if FDataQuitacao <> Value then
    FDataQuitacao:= Value;
end;

procedure TdtmQuitacaoDuplicatas.SetNrCheque(const Value: String);
begin
  if FNrCheque <> Value then
    FNrCheque:= Value;
end;

