  qryConsultaFiliais.           Tag:= ctConsultaFiliais;
  qryConsultaGrupoFiliais.      Tag:= ctConsultaGruposFiliais;
  qryConsultaBancos.            Tag:= ctPagamentoConsultaBancos;
  qryConsultaEventos.           Tag:= ctConsultaEventos;
