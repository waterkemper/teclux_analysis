    Sql.Strings = (
      '('
      'select * from'
      '('
      '('
      'select np.codigo,'
      '         cast('#39'NP'#39' as char(2)) as tipo,'
      '          np.documentopag, '
      '          d.numero,'
      '          d.datavencto,'
      '          d.valorvencto,'
      
        '          (case when (d.datapagto > :DataSituacao or d.datapagto' +
        ' is null) then cast(null as date) else d.datapagto end) as datap' +
        'agto,'
      
        '          (case when (d.datapagto > :DataSituacao or d.datapagto' +
        ' is null) then 0.00                   else d.valorpagto end) as ' +
        'valorpagto,'
      
        '          (case when (d.datapagto > :DataSituacao or d.datapagto' +
        ' is null) then 0.00                else d.valorvencto-coalesce(d' +
        '.valorpagto,0) end) as valorjurosdesconto,'
      
        '          (case when (d.datapagto > :DataSituacao or d.datapagto' +
        ' is null) then d.datavencto - :DataSituacao else d.datavencto - ' +
        'd.datapagto end) as ndias'
      
        'from notaspag np left join duplicatas d on np.documentopag = d.d' +
        'ocumentopag'
      'where np.data between :datainicial and :dataSituacao'
      ''
      '%WhereFornecedores_np'
      '%WhereFiliais_np'
      '%WhereGruposFiliais_np'
      '%Previsao_np'
      '%SomenteDuplicataemAberto'
      '%SituacaoNotas_np'
      '%TipoFornecimento_np'
      ''
      ')'
      'union all'
      '('
      'select dp.numero as codigo,'
      '          cast('#39'DP'#39' as char(2)) as tipo,'
      '          dp.numero as documentopag, '
      '          d.numero,'
      '          d.datavencto,'
      '          d.valorvencto,'
      
        '          (case when (d.datapagto > :DataSituacao or d.datapagto' +
        ' is null) then cast(null as date) else d.datapagto end) as datap' +
        'agto,'
      
        '          (case when (d.datapagto > :DataSituacao or d.datapagto' +
        ' is null) then 0.00                   else d.valorpagto end) as ' +
        'valorpagto,'
      
        '          (case when (d.datapagto > :DataSituacao or d.datapagto' +
        ' is null) then 0.00                else d.valorvencto-coalesce(d' +
        '.valorpagto,0) end) as valorjurosdesconto,'
      
        '          (case when (d.datapagto > :DataSituacao or d.datapagto' +
        ' is null) then d.datavencto - :DataSituacao else d.datavencto - ' +
        'd.datapagto end) as ndias'
      
        'from documentospag dp left join duplicatas d on dp.numero = d.do' +
        'cumentopag'
      'where dp.emissao between :datainicial and :dataSituacao '
      '  and not exists (select np.codigo'
      '                         from notaspag np'
      '                         where np.documentopag = dp.numero)'
      ''
      '%WhereFornecedores_dp'
      '%WhereFiliais_dp'
      '%WhereGruposFiliais_dp'
      '%Previsao_dp'
      '%SomenteDuplicataemAberto'
      '%SituacaoNotas_dp '
      '%TipoFornecimento_dp'
      '%SomenteComNota'
      ')'
      ') as duplicatas'
      'order by documentopag, datavencto, numero'
      ')')
    RequestLive = False
