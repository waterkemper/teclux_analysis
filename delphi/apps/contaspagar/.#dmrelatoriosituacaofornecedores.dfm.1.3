    Sql.Strings = (
      '('
      'select * from'
      '('
      '('
      'select np.codigo, '
      '         cast('#39'NP'#39' as char(2)) as tipo,'
      '       np.fornecedor, '
      '       np.tipofornecedor, '
      '       (select coalesce(vf.razao,vf.nome) as nome '
      '       from vfornecedores vf'
      '       where vf.codigo = np.fornecedor'
      '         and vf.tipo = np.tipofornecedor) as nome,'
      ''
      '      (select formatar_cpf_cnpj(vf.pessoanumero)'
      '       from vfornecedores vf'
      '       where vf.codigo = np.fornecedor'
      '         and vf.tipo = np.tipofornecedor) as cgc_cnpj,'
      ''
      '       fgf.grupo as grupofilial,'
      '       gf.descricao as nomegrupofilial,'
      '       np.filial as filial,'
      '       f.nome as nomefilial,'
      '       np.serie,'
      '       coalesce(np.numero,np.documentopag) as numero,'
      '       np.codigofiscal,'
      '       np.data,'
      '       np.emissao,'
      '       np.valornota,'
      
        '       (coalesce(dp.irretido,0)+coalesce(dp.inssretido,0)+coales' +
        'ce(dp.issretido,0)+coalesce(dp.cofinsretido,0)+coalesce(dp.pisre' +
        'tido,0)+coalesce(dp.csllretido,0)) as impostosretidos,'
      '       (select exists (select d.numero '
      '                            from duplicatas d'
      
        '                            where d.documentopag = np.documentop' +
        'ag)) as ExisteDuplicata,'
      '       (select sum(d.valorvencto)'
      '        from duplicatas d'
      #9'where d.documentopag = np.documentopag'
      
        #9'  and (d.datapagto is null or d.datapagto > :DataSituacao)) as ' +
        'saldodevedor,'
      ''
      '       (select sum(d.valorvencto)'
      '        from duplicatas d'
      #9'where d.documentopag = np.documentopag) as totalvalorvencto,'
      ''
      '       (select sum(d.valorvencto)'
      '        from duplicatas d'
      #9'where d.documentopag = np.documentopag'
      #9'  and d.datapagto <= :DataSituacao'
      #9'  and d.datapagto is not null) as totalvalorpagto,'
      ''
      '       (select sum((d.valorvencto-d.valorpagto))'
      '        from duplicatas d'
      #9'where d.documentopag = np.documentopag'
      #9'  and d.datapagto <= :DataSituacao'
      #9'  and d.datapagto is not null) as totalvalorjurosdesconto'
      ''
      
        'from ((notaspag np join (filiais f left join (filiaisgruposfilia' +
        'is fgf  join gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                                  on f.codigo=fgf.filial)'
      
        '                                                         on np.f' +
        'ilial=f.codigo)'
      
        '                           left join documentospag dp on np.docu' +
        'mentopag = dp.numero)'
      ''
      'where np.data between :DataInicial and :DataSituacao'
      ''
      '%WhereFornecedores_np'
      '%WhereFiliais_np'
      '%WhereGruposFiliais_np'
      '%Previsao_np'
      '%SituacaoNotas_np'
      '%WhereNaturezas_np'
      '%TipoFornecimento_np'
      ''
      ')'
      'union all'
      '('
      'select dp.numero as codigo,'
      '         cast('#39'DP'#39' as char(2)) as tipo,'
      '       dp.fornecedor,'
      '       dp.tipofornecedor,'
      '       (select coalesce(vf.razao,vf.nome) as nome '
      '       from vfornecedores vf'
      '       where vf.codigo = dp.fornecedor'
      '         and vf.tipo = dp.tipofornecedor) as nome,'
      ''
      '      (select formatar_cpf_cnpj(vf.cnpj)'
      '       from vfornecedores vf'
      '       where vf.codigo = dp.fornecedor'
      '         and vf.tipo = dp.tipofornecedor) as cgc_cnpj,'
      ''
      '       fgf.grupo as grupofilial,'
      '       gf.descricao as nomegrupofilial,'
      '       dp.filialemissao as filial,'
      '       f.nome as nomefilial,'
      '       cast(null as char(3)) as serie,'
      '       dp.numero,'
      '       cast(null as integer) as codigofiscal,'
      '       dp.datalancto as data,'
      '       dp.emissao,'
      '       dp.valor as valornota,'
      
        '       (coalesce(dp.irretido,0)+coalesce(dp.inssretido,0)+coales' +
        'ce(dp.issretido,0)+coalesce(dp.cofinsretido,0)+coalesce(dp.pisre' +
        'tido,0)+coalesce(dp.csllretido,0)) as impostosretidos,'
      '       (select exists (select d.numero'
      '                            from duplicatas d'
      
        '                            where d.documentopag = dp.numero)) a' +
        's ExisteDuplicata,'
      '       (select sum(d.valorvencto)'
      '        from duplicatas d'
      #9'where d.documentopag = dp.numero'
      
        #9'  and (d.datapagto is null or d.datapagto > :DataSituacao)) as ' +
        'saldodevedor,'
      ''
      '       (select sum(d.valorvencto)'
      '        from duplicatas d'
      #9'where d.documentopag = dp.numero) as totalvalorvencto,'
      ''
      '       (select sum(d.valorvencto)'
      '        from duplicatas d'
      #9'where d.documentopag = dp.numero'
      #9'  and d.datapagto <= :DataSituacao'
      #9'  and d.datapagto is not null) as totalvalorpagto,'
      ''
      '       (select sum((d.valorvencto-d.valorpagto))'
      '        from duplicatas d'
      #9'where d.documentopag = dp.numero'
      #9'  and d.datapagto <= :DataSituacao'
      #9'  and d.datapagto is not null) as totalvalorjurosdesconto'
      ''
      
        'from (DocumentosPag dp join (filiais f left join (filiaisgruposf' +
        'iliais fgf  join gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                                  on f.codigo=fgf.filial)'
      
        '                                                         on dp.f' +
        'ilialemissao=f.codigo)'
      ''
      'where dp.datalancto between :DataInicial and :DataSituacao'
      '  and not exists (select np.codigo'
      '                  from notaspag np'
      #9#9'  where np.documentopag = dp.numero)'
      ''
      '%WhereFornecedores_dp'
      '%WhereFiliais_dp'
      '%WhereGruposFiliais_dp'
      '%Previsao_dp'
      '%SituacaoNotas_dp'
      '%TipoFornecimento_dp'
      '%SomenteComNota'
      ')'
      ') as notaspag'
      '%SomenteDuplicataemAberto'
      '%Ordenacao'
      ')')
