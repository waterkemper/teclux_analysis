procedure Tfrmcadastroduplicatascontaspagar.FormShow(Sender: TObject);
begin
  inherited;
  if (Operacao in [topPAGAMENTO, topCANCELAR]) then
  begin
    sbnIncluir.enabled:= False;
    sbnExcluir.enabled := dtmContasPagar.PermiteCancelarDuplicata;
    sbnExcluir.Caption:= 'Cancelar F6';
    Caption:= 'Quitação de Duplicatas';

    DuplicatastipopagamentoChange(nil);
    dtmContasPagar.IncluirDuplicatas(Operacao);

    ActiveControl := edtDataPagto;
    ActiveControl.SetFocus;
    edtDataPagto.SelectAll;

  end
  else
  begin
    sbnIncluir.enabled:= not dtmContasPagar.ExisteQuitacaoImpostosRetidosDuplicatas;
    sbnExcluir.enabled := dtmContasPagar.PermiteExcluirDuplicata;
    sbnExcluir.Caption:= 'Excluir F6';
    Caption:= 'Cadastro de Duplicatas';
    self.ActiveControl := edtDataVencto;
    dtmContasPagar.IncluirDuplicatas(Operacao);
    edtDataVencto.SetFocus;
    edtDataVencto.SelectAll;
  end;


end;

