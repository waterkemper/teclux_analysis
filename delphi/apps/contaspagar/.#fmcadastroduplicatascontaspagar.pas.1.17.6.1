procedure Tfrmcadastroduplicatascontaspagar.actHabilitarControlesUpdate(Sender: TObject);
begin
  inherited;
  edtDataVencto.    ReadOnly := (Operacao in [topPAGAMENTO, topCANCELAR]);
  edtValorVencto.   ReadOnly := (Operacao in [topPAGAMENTO, topCANCELAR]);
  edtDescontos.     ReadOnly := (Operacao in [topPAGAMENTO, topCANCELAR]);
  flkBancoDuplicata.ReadOnly := (Operacao in [topPAGAMENTO, topCANCELAR]);

  fraComissao1.rgpTipoComissao.ReadOnly := (Operacao in [topPAGAMENTO, topCANCELAR]);
  fraComissao1.dtxComissao.    ReadOnly := (Operacao in [topPAGAMENTO, topCANCELAR]);
  fraComissao2.rgpTipoComissao.ReadOnly := (Operacao in [topPAGAMENTO, topCANCELAR]);
  fraComissao2.dtxComissao.    ReadOnly := (Operacao in [topPAGAMENTO, topCANCELAR]);

  if Operacao <> topPAGAMENTO then begin
     sbnProcurarFilialPagto.Enabled := False;
     sbnProcurarTipoPagto.  Enabled := False;
     sbnProcurarConta.      Enabled := False;
  end
  else
  begin
     sbnProcurarFilialPagto.Enabled:= True;
     sbnProcurarTipoPagto.  Enabled:= True;
     sbnProcurarConta.      Enabled:= True;
  end;

  edtDataPagto.   ReadOnly:= not (Operacao = topPAGAMENTO);
  edtValorPagto.  ReadOnly:= not (Operacao = topPAGAMENTO);
  flkFilialPagto. ReadOnly:= not (Operacao = topPAGAMENTO);

  flkConta.       ReadOnly:= not (Operacao = topPAGAMENTO);
  edtCheque.      ReadOnly:= not (Operacao = topPAGAMENTO);
  flkTipoPagto.   ReadOnly := not (Operacao = topPAGAMENTO);

  sbnDescontoTotal.enabled := (Operacao = topPAGAMENTO);
  if Operacao = topPAGAMENTO then
    sbnExcluir.enabled := false;

  ckbRefazerPagamento.Visible := UsuarioLogin.LoginUsuario = 'tecsoft';
end;

destructor Tfrmcadastroduplicatascontaspagar.Destroy;
begin
  inherited;
  frmcadastroduplicatascontaspagar:= nil;
end;

function Tfrmcadastroduplicatascontaspagar.ExisteInformacao(Parametro: Integer; NomeCampo: string; Value: Variant): Boolean;
begin
  with dtmContasPagar do begin
    case TipoPesquisa of
      dupFILIAISPAGTO: Result:= ExisteFiliais(NomeCampo, Value);
//----------------------------------------------------------------- Carlos 27/10/2006
       dupBANCOVENCTO: Result:= ExisteBancosVencto(NomeCampo, Value);
//----------------------------------------------------------------- Carlos 27/10/2006
      dupCONTA:     Result:= ExisteConta(NomeCampo, Value);
      dupTIPOPAGTO: Result:= ExisteTiposPagamento(NomeCampo, Value);
      else             Result:= False
    end;
  end
end;

function Tfrmcadastroduplicatascontaspagar.InternoExcluir: Boolean;
var
 vedtDataPagto  : String;
 vedtValorPagto : Currency;

 vflkFilialPagto,
 vflkTipoPagto,
 vflkConta,
 vedtCheque     : integer;

begin

  Result := inherited InternoExcluir;

  if Result then
  begin
    if not CtrlOn then begin
    begin
      if (Operacao in [topPAGAMENTO, topCANCELAR]) then
      begin
        vedtDataPagto  := dtmContasPagar.qryDuplicatasdatapagto.AsString;
        vedtValorPagto := dtmContasPagar.qryDuplicatasvalorpagto.AsCurrency;

        vflkFilialPagto:= dtmContasPagar.qryDuplicatasfilialpagto.AsInteger;
        vflkTipoPagto  := dtmContasPagar.qryDuplicatastipopagamento.AsInteger;
        vflkConta      := dtmContasPagar.qryDuplicatascontapagto.AsInteger;
        vedtCheque     := dtmContasPagar.qryDuplicataschequepagto.AsInteger;

        if dtmContasPagar.CancelarQuitacao then
        begin
          if ckbRefazerPagamento.Checked then
          begin

            operacao := topPAGAMENTO;
            dtmContasPagar.qryDuplicatas.Edit;
            dtmContasPagar.qryDuplicatasdatapagto.AsString := vedtDataPagto;
            dtmContasPagar.qryDuplicatasvalorpagto.AsCurrency := vedtValorPagto;

            dtmContasPagar.qryDuplicatasfilialpagto.AsInteger := vflkFilialPagto;
            dtmContasPagar.qryDuplicatastipopagamento.AsInteger := vflkTipoPagto;
            dtmContasPagar.qryDuplicatascontapagto.AsInteger := vflkConta;

            if vedtCheque <> 0 then
              dtmContasPagar.qryDuplicataschequepagto.AsInteger := vedtCheque;

            dtmContasPagar.qryDuplicatas.Post;
            InternoGravar;
          end;

          if not dtmContasPagar.fViaLote or not dtmContasPagar.fRefazerPagamento then
            close;


        end;
      end
      else
      begin
        if dtmContasPagar.ExcluirDuplicatas then
          Close;
      end;
    end;
  end;
end;

function Tfrmcadastroduplicatascontaspagar.InternoGravar: Boolean;
var
  Msg: String;
  DataValida: Boolean;
begin
{
  if CampoSelecionado =  'edtCheque' then
    dtmContasPagar.dsrDuplicatasDataChange(self, dtmContasPagar.qryDuplicataschequepagto);
 }


  Result := inherited InternoGravar;
  if Result then
  begin

    dtmContasPagar.AfterScrollDuplicatas := nil;

    DataValida:= edtDataPagto.Criticar(False) and edtDataVencto.Criticar(False);

    if DataValida then
    begin
      if (Operacao <> topPAGAMENTO) then
      begin
        Result:= (dtmContasPagar.qryDuplicatasDataVencto.AsDateTime <> 0) and
                 (dtmcontaspagar.qryDuplicatasValorVencto.AsCurrency <> 0);
        if self.Visible then
        begin
          edtDataVencto.SetFocus;
          edtDataVencto.SelectAll;
        end
      end;

      if (Operacao = topPAGAMENTO) then Msg:= 'Data pagamento e Valor pagamento'
      else                              Msg:= 'Data vencimento e Valor vencimento';

      if not Result then
         MensagemAviso(format('O campo %s' + #10#13 + 'devem ser preenchidos com valores válidos.',[msg]))
      else
      begin
        if Operacao  = topPAGAMENTO then
        begin
          //result := dtmContasPagar.VerificarChequeCadastrado;
          if result then
          begin
            if (dtmContasPagar.qryDuplicatastipopagamento.AsInteger=0) and
               (dtmContasPagar.qryDuplicatasvalorpagto.AsCurrency<>0) then
            begin
              MensagemErro('Não foi informado o tipo de pagamento');
              flkTipoPagto.SetFocus;
              flkTipoPagto.SelectAll;
              result := false;
            end;

            if ParSistema.GerarContabilidade and result then
            begin
              if not dtmContasPagar.qryDocumentosPagcreditar.IsNull or
                 (dtmLancamentoContabilidade.qryDocumentosPagLancamentos.RecordCount<>0) then
              begin
                if dtmContasPagar.qryDuplicatastipopagamento.AsInteger<>3 then
                begin
                  if dtmContasPagar.qryDuplicatasvalorpagto.AsCurrency <> 0 then
                  begin
                    if dtmContasPagar.qryDuplicatascontapagto.IsNull then
                    begin
                      MensagemErro(ctCONTABRANCO);
                      result := false;
                    end
                    else
                    if dtmContasPagar.qryDuplicatascontacredito.IsNull then
                    begin
                      MensagemErro(format(ctBANCOSEMCONTACONTABIL,
                         [dtmContasPagar.qryDuplicatascontapagto.AsString]));
                      result := false;
                    end;
                  end;
                end
                else
                begin
                  if dtmContasPagar.qryDuplicatascontacredito.IsNull or
                     dtmContasPagar.qryProcurarFornecedoresadiantamento.IsNull then
                  begin
                    MensagemErro(format(ctFORNECEDORSEMADIANTAMENTO,
                       [dtmContasPagar.qryProcurarFornecedoresnome.AsString]));
                    result := false;
                  end;
                end;

              end
              else
              begin
                MensagemAviso('Não foi definida a contrapartida do lançamento.');
                result := false;
              end;

              (*
              if result then
              begin


                if ckbRefazerPagamento.Checked then
                begin

                  dtmContasPagar.qryDuplicatasAfterScroll(nil);

                  fraLancamentoContabilidade.qryLancamentos.ReadOnly := false;
                  //dtmContasPagar.LimparTabela(fraLancamentoContabilidade.qryLancamentos);
                end;

                fraLancamentoContabilidade.GerarLancamentosContabeis;
                result := fraLancamentoContabilidade.VerificarLancamentosContabeis;
              end;
              *)

            end;

            if (dtmContasPagar.qryDuplicatastipopagamento.AsInteger=3) and result then
            begin
              if dtmContasPagar.SaldoAdiantamento <
                 dtmContasPagar.qryDuplicatasvalorpagto.AsCurrency then
              begin
                if dtmContasPagar.SaldoAdiantamento = 0 then
                  MensagemErro('Não existe saldo de adiantamento para o pagamento.')
                else
                  MensagemErro(format('O Saldo do adiantamento é de %f.'+ #10#13 +
                                      'Insuficiente para o pagamento.',[dtmContasPagar.SaldoAdiantamento]));
                result := false;
              end;
            end;

          end;
        end;
      end;

      if result then
      begin
        result := dtmContasPagar.GravarDuplicatas(Operacao);


        if not result then
        begin
          if pgcLancamentos.ActivePage = tstContabilidade then
             ActiveControl:= fraLancamentoContabilidade.dbgContabilidade
        end
        else
        begin
          if operacao = topPAGAMENTO then
          begin
            if ParSistema.GerarContabilidade then
            begin
              if ckbRefazerPagamento.Checked then
              begin
                dtmContasPagar.AfterScrollDuplicatas := AfterScrollDuplicatas;
                dtmContasPagar.qryDuplicatasAfterScroll(nil);
                dtmContasPagar.AfterScrollDuplicatas := nil;


                fraLancamentoContabilidade.qryLancamentos.ReadOnly := false;
                //dtmContasPagar.LimparTabela(fraLancamentoContabilidade.qryLancamentos);
              end;

              fraLancamentoContabilidade.GerarLancamentosContabeis;
              result := fraLancamentoContabilidade.VerificarLancamentosContabeis;
            end;

            pgcLancamentos.ActivePage:= tstPagamentosDuplicatas;
            if tstContabilidade.TabVisible then
              fraLancamentoContabilidade.atualizarDescricaoHistorico;


            if result then
//              if operacao = topPAGAMENTO then
                result := dtmContasPagar.GravarContasPagar(Operacao);
          end;
        end;

      end;
    end;

    if (Operacao = topPAGAMENTO) then
    begin
      if self.Visible then
      begin
        edtDataPagto.SetFocus;
        edtDataPagto.SelectAll;

        if result then
          Operacao := topCANCELAR;
      end
    end
    else
    begin
      if self.Visible then
      begin
        edtDataVencto.SetFocus;
        edtDataVencto.SelectAll;
      end;
    end;

    dtmContasPagar.AfterScrollDuplicatas := AfterScrollDuplicatas;

  end;

end;

function Tfrmcadastroduplicatascontaspagar.InternoIncluir: Boolean;
begin
  Result:= inherited InternoIncluir;
  if not CtrlOn and sbnIncluir.enabled then begin
    if Result then begin
      dtmContasPagar.IncluirDuplicatas(topINSERIR);
      edtDataVencto.SetFocus;
      edtDataVencto.SelectAll;
    end;
  end;
end;

function Tfrmcadastroduplicatascontaspagar.InternoPesquisar(Titulo: string): Integer;
begin
  TipoPesquisa := dupNENHUM;

  Result := mrNone;
  if ActiveControl is TtecFindCustom then begin
    if CtrlOn then begin
      if (ActiveControl = flkFilialPagto) and not flkFilialPagto.ReadOnly then begin
        TipoPesquisa := dupFILIAISPAGTO;
        Titulo       := 'Filiais';
      end
      else if (ActiveControl = flkTipoPagto) and not flkTipoPagto.ReadOnly then begin
        TipoPesquisa := dupTIPOPAGTO;
        Titulo       := 'Tipos pagamentos';
      end
      else if (ActiveControl = flkConta) and not flkConta.ReadOnly then begin
        TipoPesquisa := dupCONTA;
        Titulo       := 'Bancos';
      end
      else if (ActiveControl = flkBancoDuplicata) and not flkBancoDuplicata.ReadOnly then begin
        TipoPesquisa := dupBANCOVENCTO;
        Titulo       := 'Bancos';
      end;

      if TipoPesquisa <> dupNENHUM then
      begin
        with dtmContasPagar do begin
          AbrirTabelasConsulta(TipoPesquisa);
          Result:= inherited InternoPesquisar(Titulo);
          if Result = mrOK then
            Selecionar(TipoPesquisa);
          FecharTabelasConsulta(TipoPesquisa);
        end;
      end;  
    end;
  end;
end;

