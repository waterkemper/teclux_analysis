procedure Tfrmcadastroduplicatascontaspagar.DuplicatastipopagamentoChange(
  Sender: TObject);
begin
  {Quando for adiantamento não permite digitar a conta}
  if not dtmContasPagar.qryDuplicatastipopagamento.isnull then
  begin
    gbxConta.Enabled := dtmContasPagar.qryDuplicatastipopagamento.AsInteger<>3;
    gbxCheque.Enabled := gbxConta.Enabled;

    if dtmContasPagar.qryDuplicatastipopagamento.AsInteger=3 then
    begin
      if dtmContasPagar.qryDuplicatascontacredito.AsInteger<>0 then
        mmoObservacaoDuplicata.SetFocus
      else
      begin
        if self.visible then
        begin
          flkTipoPagto.SetFocus;
          flkTipoPagto.SelectAll;
        end;
      end
    end
    else
    begin
      if self.Visible then
      begin
        flkConta.SetFocus;
        flkConta.SelectAll;
      end;  
    end;
  end;      
end;

