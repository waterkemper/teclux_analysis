procedure Tfrmcadastroduplicatascontaspagar.DuplicatasPagtoError(
  Sender: TObject);
begin
  if CampoSelecionado = 'edtDataPagto' then
  begin
    edtdatapagto.SetFocus;
    edtdatapagto.SelectAll;
  end
  else
  if CampoSelecionado = 'flkConta' then
  begin
    flkConta.Text := dtmContasPagar.qryDuplicatascontapagtoaux.AsString;
    flkConta.SetFocus;
    flkconta.SelectAll;
  end
  else
  if CampoSelecionado = 'edtCheque' then
  begin
    edtCheque.Text := dtmContasPagar.qryDuplicataschequepagto.AsString;
    edtCheque.SetFocus;
    edtCheque.SelectAll;
  end;

end;


