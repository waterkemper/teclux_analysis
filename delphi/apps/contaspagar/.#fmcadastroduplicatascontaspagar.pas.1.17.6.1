{
function Tfrmcadastroduplicatascontaspagar.ValidaData(
         ExibirMsg: Boolean; TipodeData: String; Data: TDBEditData): Boolean;
var
  Contabil, Emissao: Integer;
begin
  Result := True;
  with dtmContasPagar do begin
    Contabil:= DaysBetween(DataServidor,DataContabil);
    Emissao := DaysBetween(DataServidor,StrToDatetime(DataEmissao));
    if Data.Criticar(False) then begin
     if Contabil < Emissao then begin
       if StrToDate(Data.Text) > DataContabil then begin
         if ExibirMsg then
           MensagemAviso(Format(ctERRONOTAFISCALDATAMENORDATACONTABIL,[TipodeData]));
         Result := False;
       end;
     end
     else
      if not DataEmBranco(Data.Text) and (StrToDate(Data.Text) < StrToDate(DataEmissao)) then begin
        if ExibirMsg then
          MensagemAviso(format(ctDATAMENOREMISSAO,[TipodeData]));
        Result := False;
      end;
    end;
  end;
end;
}

