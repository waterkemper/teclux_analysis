begin
//  edtNrParcelas.Clear;
//  edtVencimento.Clear;
//  edtIntervalo.Clear;
//  edtValorJuros.Clear;
//  edtValorMulta.Clear;
  dtmContasPagar.EdicaoCampos(False);
  flkEvento.Exist;
end;

