procedure TfrmContasPagar.sbnImprimirClick(Sender: TObject);
begin
  inherited;
  dtmContasPagar.ImprimirAutorizacoes;
end;

procedure TfrmContasPagar.fraLancamentoContabilidadesbnGerarLancamentoClick(
  Sender: TObject);
begin
  inherited;
  fraLancamentoContabilidade.sbnGerarLancamentoClick(Sender);

end;

procedure TfrmContasPagar.fraLancamentoContabilidadesbnGerarLancamentosContabeisRegimedeCaixaClick(
  Sender: TObject);
begin
  inherited;
  fraLancamentoContabilidade.sbnGerarLancamentosContabeisRegimedeCaixaClick(
  Sender);

end;

procedure TfrmContasPagar.BloquearImpostosRetidos;
begin
  gbxImpostosRetidos.enabled := false;
end;

procedure TfrmContasPagar.DesBloquearImpostosRetidos;
begin
  gbxImpostosRetidos.enabled := true;
end;


procedure TfrmContasPagar.sbnGerarTotalPISClick(Sender: TObject);
begin
  inherited;
  dtmContasPagar.dsrDocumentosPagDataChange(self, dtmContasPagar.qryDocumentosPagpisbasecalculo);
end;

procedure TfrmContasPagar.sbnGerarTotalCOFINSClick(Sender: TObject);
begin
  inherited;
  dtmContasPagar.dsrDocumentosPagDataChange(self, dtmContasPagar.qryDocumentosPagcofinsbasecalculo);
end;

procedure TfrmContasPagar.stxdeCaixaClick(Sender: TObject);
begin
  inherited;
  dtmContasPagar.EditarDocumento;
  dtmContasPagar.qryDocumentosPagregimedecaixa.AsBoolean := not dtmContasPagar.qryDocumentosPagregimedecaixa.AsBoolean;
//  TDBCheckBox(ckbRegimeCaixa).Checked := not ckbRegimeCaixa.Checked;
end;

end.
