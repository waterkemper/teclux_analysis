    end;
end;

procedure TfrmContasPagar.edtPISExit(Sender: TObject);
begin
  inherited;
  ControlarEdicaoPISCOFINSCSLL;
end;

procedure TfrmContasPagar.ControlarEdicaoPISCOFINSCSLL;
begin
  if ParSistema.GeracaoAutomaticadoImpostoRetido then
  begin
    if lblPis.Enabled      then edtPIS.Enabled             := true;
    if lblCofins.Enabled   then edtCofins.Enabled          := true;
    if lblCSLL.Enabled     then edtCSLL.Enabled            := true;
    if lblPIS_CSLL.Enabled then edtPIS_COFINS_CSLL.Enabled := true;

    with dtmContasPagar do
    begin
      if ((qryDocumentosPagpisretido.AsCurrency<>0) or
          (qryDocumentosPagcofinsretido.AsCurrency<>0) or
          (qryDocumentosPagcsllretido.AsCurrency<>0)) then
        edtPIS_COFINS_CSLL.Enabled := FALSE
      else
      begin
        if (qryDocumentosPagpiscofinscsllretido.AsCurrency<>0) then
        begin
          edtPIS.Enabled    := false;
          edtCofins.Enabled := false;
          edtCSLL.Enabled   := false;
        end;
      end;
    end;
  end;
end;

