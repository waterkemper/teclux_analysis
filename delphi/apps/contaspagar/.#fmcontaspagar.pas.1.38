begin
  inherited;
  RemoveDataModule(dtmContasPagar);
end;

function TfrmContasPagar.GetfrmCadastroDuplicatasContasPagar: tfrmCadastroDuplicatasContasPagar;
begin
  if not assigned(ffrmCadastroDuplicatasContasPagar) then
    ffrmCadastroDuplicatasContasPagar  := TfrmCadastroDuplicatasContasPagar.Create(self);

  Result := ffrmCadastroDuplicatasContasPagar;
end;

procedure TfrmContasPagar.CondicoesdaConsultaEvento;
begin
  fraConsultaEvento.qryConsultaEventos.MacroByName('condicoes').asString :=
    ' and e.tipo = ''A'' and e.TipoMovimentacao = ''S'' and e.Inativo IS NULL ';

  fraConsultaEvento.qryProcuraEventos.MacroByName('condicoes').asString :=
    ' and ((e.tipo = ''A'' and e.TipoMovimentacao = ''S'' and e.Inativo IS NULL) or e.codigo = :codigo) ';


end;

procedure TfrmContasPagar.sbnLogClientesClick(Sender: TObject);
begin
  inherited;
  AcionarTelaVisualizarLog(self, 'documentospag_log', ['numero'], [dtmcontaspagar.qrydocumentospagnumero.asString], '');
end;

procedure TfrmContasPagar.SpeedButton1Click(Sender: TObject);
begin
  inherited;
  AcionarTelaVisualizarLog(self, 'duplicatas_log', ['documentopag','numero','datavencto'],
                [dtmcontaspagar.qrydocumentospagnumero.asString,
                 dtmcontaspagar.qryduplicatasnumero.asString,
                 quotedstr(dtmcontaspagar.qryduplicatasdatavencto.asString)], '');
end;

