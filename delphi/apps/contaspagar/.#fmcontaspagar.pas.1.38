function TfrmContasPagar.ExisteInformacao(Parametro: Integer; NomeCampo: String; Value: Variant): Boolean;
begin
  with dtmContasPagar do begin
    case TipoPesquisa of
     dupDOCUMENTOSPAG: Result:= ExisteDocumentosPag(NomeCampo, Value);
           dupFILIAIS: Result:= ExisteFiliais(NomeCampo, Value);
      dupFORNECEDORES: Result:= ExisteFornecedores(NomeCampo, Value);
            dupEVENTO: Result:= ExisteEventos(NomeCampo, Value);
      else             Result:= False
    end;
  end
end;

function TfrmContasPagar.InternoExcluir: Boolean;
begin
  Result:= inherited InternoExcluir;
  if Result then begin
    if not CtrlOn then
    begin
      dtmContasPagar.ExcluirContasPagar;
    end;
  end;
end;

function TfrmContasPagar.InternoGravar: Boolean;
begin
  Result:= inherited InternoGravar;
  if result then
     result := fraLancamentoContabilidade.VerificarLancamentosContabeis;

  if Result then
  begin
    if not dtmContasPagar.fRefazerPagamento then
      dtmContasPagar.RefazerPagamento;

    dtmContasPagar.GravarContasPagar(topEDITAR);

    if (parsistema.GerarContabilidade or
       (ParSistema.InicioIntegracaoBancos > StrToDateTime('01/01/1980'))) and
       (fViaLote_ or dtmContasPagar.fRefazerPagamento) then
    begin

//      if not Assigned(frmCadastroDuplicatasContasPagar) then
//      begin
//        frmCadastroDuplicatasContasPagar := TfrmCadastroDuplicatasContasPagar.Create(self);
        frmCadastroDuplicatasContasPagar.SetDataModulo(dtmContasPagar);
//      end;

      dtmContasPagar.ExibirMensagemDesconto := false;

      if dtmContasPagar.fRefazerPagamento then
      begin
        frmCadastroDuplicatasContasPagar.ckbRefazerPagamento.Checked := true;
        dtmContasPagar.qryDuplicatas.First;
        while not dtmContasPagar.qryDuplicatas.Eof do
        begin
          if not dtmContasPagar.qryDuplicatasdatapagto.IsNull then
          begin
            CtrlOn := false;
            frmCadastroDuplicatasContasPagar.SetDataModulo(dtmContasPagar);
            frmCadastroDuplicatasContasPagar.DataSet := dtmContasPagar.TabelaDuplicatas;
//            frmCadastroDuplicatasContasPagar.Operacao:= topCANCELAR;
            dtmContasPagar.Operacao := topCANCELAR;
            frmcadastroduplicatascontaspagar.flkFilialPagto.Exist;
            frmcadastroduplicatascontaspagar.flkConta.Exist;
            frmcadastroduplicatascontaspagar.flkTipoPagto.Exist;
            frmcadastroduplicatascontaspagar.AfterScrollDuplicatas(self);
            frmCadastroDuplicatasContasPagar.InternoExcluir;
            dtmContasPagar.AfterScrollDuplicatas := nil;
          end;
          dtmContasPagar.qryDuplicatas.next;
        end;
        frmCadastroDuplicatasContasPagar.ckbRefazerPagamento.Checked := false;
        dtmContasPagar.RefazerPagamento := false;

      end
      else
      begin
        dtmContasPagar.qryDuplicatas.First;
        while not dtmContasPagar.qryDuplicatas.Eof do
        begin
          if not dtmContasPagar.qryDuplicatasdatapagto.IsNull then
          begin
            frmCadastroDuplicatasContasPagar.SetDataModulo(dtmContasPagar);
            frmCadastroDuplicatasContasPagar.DataSet := dtmContasPagar.TabelaDuplicatas;
//            frmCadastroDuplicatasContasPagar.Operacao:= topPAGAMENTO;
            dtmContasPagar.Operacao:= topPAGAMENTO;

            frmcadastroduplicatascontaspagar.flkFilialPagto.Exist;
            frmcadastroduplicatascontaspagar.flkConta.Exist;
            frmcadastroduplicatascontaspagar.flkTipoPagto.Exist;
            frmcadastroduplicatascontaspagar.AfterScrollDuplicatas(self);
            frmCadastroDuplicatasContasPagar.InternoGravar;
            dtmContasPagar.AfterScrollDuplicatas := nil;
          end;
          dtmContasPagar.qryDuplicatas.next;
        end;
      end;

      freeandnil(ffrmCadastroDuplicatasContasPagar);
//      frmCadastroDuplicatasContasPagar.Free;
      dtmContasPagar.ExibirMensagemDesconto := true;


    end;

  end;

  if not result then
  begin
    if pgcDocumentos.ActivePage = tstContabilidade then
       ActiveControl:= fraLancamentoContabilidade.dbgContabilidade
  end
  else
  begin
   //colocado aqui temporiariamente para resolver o bug de que quando cadastra novo documento e ja quita a duplicata
   //a duplicata nao fica paga mas os movtosbancos ficam gravados.
//    dtmContasPagar.ReFazConsulta(dtmContasPagar.qryDocumentosPag,[0],[dtmContasPagar.qryDocumentosPagnumero.AsInteger]);
    pgcDocumentos.ActivePage:= tstValores;
    if tstContabilidade.TabVisible then
      fraLancamentoContabilidade.atualizarDescricaoHistorico;
  end;
end;

function TfrmContasPagar.InternoIncluir: Boolean;
begin
  Result:= inherited InternoIncluir;
  if Result then
    if not CtrlOn then
    begin
      edfNumero.SetFocus;
      dtmContasPagar.IncluirContasPagar;
      dtmContasPagar.AdiantamentoFornecedor := false;
      edfNumeroFound(true);
      flkFornecedor.SetFocus;
      pgcValores.ActivePage := tstValores;
    end;
end;

function TfrmContasPagar.InternoPesquisar(Titulo: String): Integer;
begin
  Result:= mrNone;
  with dtmContasPagar do
  begin
    if CtrlOn then
    begin
      if ActiveControl is TtecFindCustom then
      begin
        if (ActiveControl = flkFilial) and PermiteAlterarDocumento and not ExisteNota then begin
          TipoPesquisa:= dupFILIAIS;
          Titulo      := 'Filiais';
        end
        else if (ActiveControl = flkFornecedor) and PermiteAlterarDocumento and not ExisteNota then begin
          TipoPesquisa:= dupFORNECEDORES;
          Titulo      := 'Fornecedores';
        end
        else if (ActiveControl = fraConsultaEvento.edfcodigo)  and PermiteAlterarEvento then
          fraConsultaEvento.InternoPesquisar('Eventos')
        else if (ActiveControl = flkTipoPagto) and not flkTipoPagto.ReadOnly then begin
          TipoPesquisa := dupTIPOPAGTODOCUMENTOSPAG;
          Titulo       := 'Tipos pagamentos';
        end
        else if (ActiveControl = flkConta) and not flkConta.ReadOnly then begin
          TipoPesquisa := dupCONTADOCUMENTOSPAG;
          Titulo       := 'Bancos';
        end
        else
          TipoPesquisa:= dupNENHUM;
      end;
    end
    else begin
      TipoPesquisa:= dupDOCUMENTOSPAG;
      Titulo      := 'Documentos Contas Pagar';
    end;

    if (TipoPesquisa <> dupNENHUM) then
    begin
      AbrirTabelasConsulta(TipoPesquisa);
      Result:= inherited InternoPesquisar(Titulo);
      if Result = mrOk then
        Selecionar(TipoPesquisa);

      FecharTabelasConsulta(TipoPesquisa);
      TipoPesquisa := dupNENHUM;

      if (TipoPesquisa = dupDOCUMENTOSPAG) and (Result = mrOk) then
        edfNumeroFound(true);

    end;
  end;
  CtrlOn:= false;
end;

function TfrmContasPagar.JanelaPesquisa: TfrmConsultaBasica;
begin
  Result:= TfrmConsultaPorCampo.Create(nil);
  if TipoPesquisa in [dupDOCUMENTOSPAG, dupFORNECEDORES] then
       TfrmConsultaPorCampo(Result).ConsultaInterativa := False
  else begin
    TfrmConsultaPorCampo(Result).ConsultaInterativa := True;
    TfrmConsultaPorCampo(Result).UsarParametrosDaTabela:= False;
  end;
end;

procedure TfrmContasPagar.KeyDown(var Key: Word; Shift: TShiftState);
begin
  inherited;
  case Key of
    VK_P     : if (Shift = [ssCtrl]) and sbnAlterarDuplicatas.Enabled then sbnAlterarDuplicatas.Click;
    VK_Escape: LimparCampos;
    VK_G     : begin
                  if (Shift = [ssCtrl]) then
                  begin
                      if pgcDocumentos.ActivePage = tstDuplicatas then
                      begin
                        if pgcControle.ActivePage = tstContaPagar then
                          if sbnGerarDuplicatas.Enabled then
                            sbnGerarDuplicatas.Click;
                      end
                      else
                      if pgcDocumentos.ActivePage = tstContabilidade then
                         if fraLancamentoContabilidade.sbnGerarLancamento.Enabled then
                           fraLancamentoContabilidade.sbnGerarLancamento.Click;
                  end;
                end;

    VK_R     : begin
                  if (Shift = [ssCtrl]) then
                  begin
                    if pgcDocumentos.ActivePage = tstContabilidade then
                       if fraLancamentoContabilidade.sbnGerarLancamentosContabeisRegimedeCaixa.Enabled then
                         fraLancamentoContabilidade.sbnGerarLancamentosContabeisRegimedeCaixa.Click;
                  end;
                end;
                
    VK_F7    : begin
                  if sbnAdiantamento.Enabled then
                    sbnAdiantamentoClick(nil);
                end;
  end;
end;

