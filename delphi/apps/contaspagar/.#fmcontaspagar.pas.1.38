procedure TfrmContasPagar.VenctosImpostosRetidosEntradasAfterOpen(Sender: TObject);
var
  vLancamentosFiliais: TtecLancamentosContasEntradas;
begin
  BloquearValores(true);
  with dtmContasPagar do
  if not AdiantamentoFornecedor then
  begin
    for vLancamentosFiliais := lceCOFINSretida to lcePIS_COFINS_CSLL do
    begin
      if qryVenctosImpostosRetidosEntradas.Locate('Descricao', FilialContasEntradas[vLancamentosFiliais],[]) then
      begin
        case vLancamentosFiliais of
          lceCOFINSretida : begin
                              pgcValores.Enabled := true;
                              gbxImpostosRetidos.Enabled := true;
                              lblCofins.Enabled := true;
                              edtCofins.Enabled := lblCofins.Enabled;
                            end;
          lceCSLLretida   : begin
                              pgcValores.Enabled := true;
                              gbxImpostosRetidos.Enabled := true;
                              lblCSLL  .Enabled := true;
                              edtCSLL  .Enabled := lblcsll.Enabled;
                            end;
          lceINSSRetido   : begin
                              pgcValores.Enabled := true;
                              gbxImpostosRetidos.Enabled := true;
                              lblINSS  .Enabled := true;
                              edtINSS  .Enabled := lblINSS.Enabled;
                            end;
          lceIRRetido     : begin
                              pgcValores.Enabled := true;
                              gbxImpostosRetidos.Enabled := true;
                              lblIR    .Enabled := true;
                              edtIR    .Enabled := lblir.Enabled;
                            end;
          lceISSRetido    : begin
                              pgcValores.Enabled := true;
                              gbxImpostosRetidos.Enabled := true;
                              lblISS   .Enabled := true;
                              edtISS   .Enabled := lbliss.Enabled;
                              if (dtmContasPagar.qryVenctosImpostosRetidosEntradasfornecedor.AsInteger = 0) and
                                 edtISS.Enabled and not dtmContasPagar.qryDocumentosPagissretido.ReadOnly then
                                sbnPesquisarFornecedorParaISS.Visible := true
                              else
                                sbnPesquisarFornecedorParaISS.Visible := false;
                            end;
          lcePISRetido    : begin
                              pgcValores.Enabled := true;
                              gbxImpostosRetidos.Enabled := true;
                              lblPis   .Enabled := true;
                              edtPIS   .Enabled := lblpis.enabled;
                            end;

          lcePIS_COFINS_CSLL : begin
                                pgcValores.Enabled := true;
                                gbxImpostosRetidos.Enabled := true;
                                lblPIS_CSLL   .Enabled := true;
                                lbl_COFINS.Enabled := true;
                                edtPIS_COFINS_CSLL   .Enabled := lblPIS_CSLL.enabled;
                              end;
        end;
      end;
    end;
  end;
end;

procedure TfrmContasPagar.BloquearValores(Bloquear: Boolean);
begin
  pgcValores.Enabled := not Bloquear;

  gbxImpostosRetidos.Enabled := not Bloquear;

  lblCofins.Enabled := not bloquear;
  edtCofins.Enabled := lblCofins.Enabled;

  lblCSLL  .Enabled := not bloquear;
  edtCSLL  .Enabled := lblcsll.Enabled;

  lblINSS  .Enabled := not bloquear;
  edtINSS  .Enabled := lblINSS.Enabled;

  lblIR    .Enabled := not bloquear;
  edtIR    .Enabled := lblir.Enabled;

  lblISS   .Enabled := not bloquear;
  edtISS   .Enabled := lbliss.Enabled;

  lblPis   .Enabled := not bloquear;
  edtPIS   .Enabled := lblpis.enabled;

  lblPIS_CSLL .Enabled := not bloquear;
  lbl_COFINS  .Enabled := not bloquear;
  edtPIS_COFINS_CSLL   .Enabled := lblPIS_CSLL.enabled;

end;

procedure TfrmContasPagar.AfterOpenDocumentosPag(Sender: TObject);
begin
  if tstContabilidade.tabvisible then
  begin
    with fraLancamentoContabilidade do
    begin
      OrigemFormulario         := dtmContasPagar.GetOrigemFormulario;
      if dtmContasPagar.ExisteNota then
        AbrirLancamentos('E', dtmContasPagar.qryExisteNotacodigo.AsInteger, false)
      else
      begin
      {
        if dtmContasPagar.qryDocumentosPagadiantamento.AsBoolean then
          AbrirLancamentos('A', CodigoDocumento, true)
        else}
          AbrirLancamentos('D', CodigoDocumento, {dtmContasPagar.IncluindoDocumentoPag} true);
      end
    end;
  end;

  Definir_dbgReinf_2010_infoTpServ_FloatingFooter;

  if dtmContasPagar.qryDocumentosPagadiantamento.asBoolean then
    pgcControle.activepage := tstAdiantamento
  else
    pgcControle.activepage := tstContaPagar;

end;

