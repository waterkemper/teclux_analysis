  if (Shift = [ssCtrl]) then
    case key of
      TeclaEditarRegistro : if dtmContasPagar.qryDuplicatas.IsEmpty then
                              AcionarCadastroDuplicatas(topINSERIR)
                            else
                              AcionarCadastroDuplicatas(topEDITAR);

      TeclaInserirRegistro: if sbnIncluirDuplicatas.Enabled then
                               AcionarCadastroDuplicatas(topINSERIR);
    end;
end;

