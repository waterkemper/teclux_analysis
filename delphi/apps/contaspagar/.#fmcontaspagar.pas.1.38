procedure TfrmContasPagar.flkFornecedorEnter(Sender: TObject);
begin
  inherited;
  CodClienteAnt := dtmContasPagar.qryDocumentosPagfornecedor.AsInteger;
  TipoClienteAnt := dtmContasPagar.qryDocumentosPagtipofornecedor.AsString;
end;

procedure TfrmContasPagar.flkFornecedorExit(Sender: TObject);
begin
  inherited;

  if ((CodClienteAnt <> dtmContasPagar.qryDocumentosPagfornecedor.AsInteger) or
      (TipoClienteAnt <> dtmContasPagar.qryDocumentosPagtipofornecedor.AsString)) or

      ((CodClienteAnt=0) and (TipoclienteAnt='') and
       (dtmContasPagar.qryDocumentosPagfornecedor.AsInteger<>0) and
       (dtmContasPagar.qryDocumentosPagtipofornecedor.AsString<>'')) then
  begin
    dtmContasPagar.ExibirFicha(ClassName);
    flkFornecedor.setfocus;
    flkFornecedor.SelectAll;
  end;

end;

procedure TfrmContasPagar.OperacaoPadrao(Value: array of Variant);
begin
  inherited;

  if Length(Value) > 0 then
      dtmContasPagar.AbrirDocumentoPag(value[0]);

end;

