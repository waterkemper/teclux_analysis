begin
  inherited;
  dtmContasPagar.GravarObservacaoDuplicatas;
end;

procedure TfrmContasPagar.ExibirMensagemPadronizadaDataEmissao;
begin
  if dtmContasPagar.IncluindoDocumentoPag then
    if strtodate(edtDataEmissao.Text) < DataLocal - edtDataEmissao.Minimo then
      MensagemAviso(format(ctDATACONTABILMAIOROUIGUALDATALANCTO, ['de emissão',
                       edtDataEmissao.Text, 'retroativa',
                       datetostr(DataLocal - edtDataEmissao.Minimo)]))
  else
    if strtodate(edtDataEmissao.Text) < DataLocal - DaysBetween(dtmContasPagar.DataServidor,
                                           (dtmContasPagar.qryDocumentosPagemissao.AsDateTime -
                                             ParSistema.DiasNotaRetroativa)) then
      MensagemAviso(format(ctDATACONTABILMAIOROUIGUALDATALANCTO, ['de emissão',
                       edtDataEmissao.Text, 'retroativa',
                       DataLocal - DaysBetween(dtmContasPagar.DataServidor,
                                             (dtmContasPagar.qryDocumentosPagemissao.AsDateTime -
                                             ParSistema.DiasNotaRetroativa) )]));
end;

procedure TfrmContasPagar.ExibirMensagemPadronizadaDataLancto;
begin
  if strtodate(edtDataLancamento.Text) <= ParSistema.DataContabil then
    MensagemAviso(format(ctDATACONTABILMAIORDATALANCTO, ['de lançamento',
                     edtDataLancamento.Text, 'contábil', ParSistema.DataContabilstring]))
  else
  if strtodate(edtDataLancamento.Text) < strtodate(edtDataEmissao.Text) then
    MensagemAviso(format(ctDATACONTABILMAIOROUIGUALDATALANCTO, ['de lançamento',
                     edtDataLancamento.Text, 'emissão', edtDataEmissao.Text]));

end;

procedure TfrmContasPagar.edtDataEmissaoExit(Sender: TObject);
var
 NDias : Integer;
begin
  inherited;
  edtDataLancamento.Minimo := dtmContasPagar.NDiasLimiteData(edtDataEmissao.Text);
end;

procedure TfrmContasPagar.PesquisarFornecedorParaISS;
begin
  ConsultaFornecedor.CtrlOn := true;
  ConsultaFornecedor.InternoPesquisar(ctFORNECEDORES);
  ConsultaFornecedor.CtrlOn := false;
  edtISS.SetFocus;
  edtiss.SelectAll;
end;

procedure TfrmContasPagar.CondicoesConsultaFornecedorISS;
begin
  ConsultaFornecedor.qryConsultaClientes.MacroByName('CondicaodaConsulta').AsString :=
   'and (select f.fornecedorparaiss from fornecedores f where f.codigo = v.codigo and v.tipo=''F'')';
end;

procedure TfrmContasPagar.edtISSEnter(Sender: TObject);
begin
  inherited;
  ValorISSQN := edtISS.Text;
end;

procedure TfrmContasPagar.edtISSExit(Sender: TObject);
begin
  inherited;
  if sbnPesquisarFornecedorParaISS.Visible then
    if dtmContasPagar.qryDocumentosPag.State in [dsEdit, dsInsert] then
      if ((ValorISSQN <> edtISS.Text) or
          (dtmContasPagar.qryDocumentosPagfornecedorparaiss.IsNull)) and
         (dtmContasPagar.qryDocumentosPagissretido.AsCurrency<>0) then
        PesquisarFornecedorParaISS;
end;

procedure TfrmContasPagar.sbnPesquisarFornecedorParaISSClick(
  Sender: TObject);
begin
  inherited;
  edtISS.SetFocus;
  PesquisarFornecedorParaISS;
end;

procedure TfrmContasPagar.AtribuirCodigoFornecedorParaISS;
begin
  dtmContasPagar.FornecedorParaISS := ConsultaFornecedor.qryProcuraClientecodigo.AsInteger;
end;

procedure TfrmContasPagar.edtISSKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  inherited;
  if sbnPesquisarFornecedorParaISS.Visible then
    if CtrlOn then
      if key = VK_F9 then
        if sbnPesquisarFornecedorParaISS.Visible then
          PesquisarFornecedorParaISS;
end;

procedure TfrmContasPagar.pgcDocumentosChange(Sender: TObject);
begin
  inherited;
  if pgcDocumentos.ActivePage = tstContabilidade then
    with fraLancamentoContabilidade do
    begin
      OrigemFormulario         := dtmContasPagar.GetOrigemFormulario;
      if not ExisteLancamentosContabeis {or (OrigemFormulario='A')} then
        GerarLancamentosContabeis;
    end;
end;

procedure TfrmContasPagar.edtPISExit(Sender: TObject);
begin
  inherited;
  ControlarEdicaoPISCOFINSCSLL;
end;

procedure TfrmContasPagar.ControlarEdicaoPISCOFINSCSLL;
begin
  if ParSistema.GeracaoAutomaticadoImpostoRetido then
  begin
    if lblPis.Enabled      then edtPIS.Enabled             := true;
    if lblCofins.Enabled   then edtCofins.Enabled          := true;
    if lblCSLL.Enabled     then edtCSLL.Enabled            := true;
    if lblPIS_CSLL.Enabled then edtPIS_COFINS_CSLL.Enabled := true;

    with dtmContasPagar do
    begin
      if ((qryDocumentosPagpisretido.AsCurrency<>0) or
          (qryDocumentosPagcofinsretido.AsCurrency<>0) or
          (qryDocumentosPagcsllretido.AsCurrency<>0)) then
        edtPIS_COFINS_CSLL.Enabled := FALSE
      else
      begin
        if (qryDocumentosPagpiscofinscsllretido.AsCurrency<>0) then
        begin
          edtPIS.Enabled    := false;
          edtCofins.Enabled := false;
          edtCSLL.Enabled   := false;
        end;
      end;
    end;
  end;
end;

procedure TfrmContasPagar.edtCofinsExit(Sender: TObject);
begin
  inherited;
  ControlarEdicaoPISCOFINSCSLL;
end;

procedure TfrmContasPagar.edtCSLLExit(Sender: TObject);
begin
  inherited;
  ControlarEdicaoPISCOFINSCSLL;
end;

procedure TfrmContasPagar.edtPIS_COFINS_CSLLExit(Sender: TObject);
begin
  inherited;
  ControlarEdicaoPISCOFINSCSLL;
end;

procedure TfrmContasPagar.sbnAdiantamentoClick(Sender: TObject);
begin
  inherited;
  if not CtrlOn then
  begin
    dtmContasPagar.IncluirAdiantamento;
    edfNumeroFound(true);
    flkFornecedor.SetFocus;
    BloquearValores(true);
    pgcControle.ActivePage := tstAdiantamento;
    tstDuplicatas.Caption := ' &1 -  Adiantamento';
  end;
end;

