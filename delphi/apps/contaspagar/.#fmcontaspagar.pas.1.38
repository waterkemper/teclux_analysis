  frmContasPagar: TfrmContasPagar;
  TipoPesquisa: TtecQuitacaoDuplicatas;
  ControleAtivo: TWinControl;


implementation

uses fmnavcontroles, dmbasico;

{$R *.dfm}

{ TfrmContasPagar }

constructor TfrmContasPagar.Create(AOwner: TComponent);
begin

  self.dtmContasPagar := TdtmContasPagar.Create(self);
  dtmContasPagar := self.dtmContasPagar;
  inherited create(AOwner);
  
  DataSet:= dtmContasPagar.TabelaDocumentosPag;
  tstContabilidade.TabVisible := ParSistema.GerarContabilidade;
  TipoPesquisa := dupNENHUM;
  pgcDocumentos.ActivePageIndex := 0;
  dtmContasPagar.VenctosImpostosRetidosEntradasAfterOpen :=
     VenctosImpostosRetidosEntradasAfterOpen;
  VenctosImpostosRetidosEntradasAfterOpen(dtmContasPagar.qryVenctosImpostosRetidosEntradas);

  ConsultaFornecedor := TfraConsultaCodigo.Create(self);
  ConsultaFornecedor.Name := 'ConsultaFornecedor';
  ConsultaFornecedor.TipoCliente := 'F';
  ConsultaFornecedor.Tipovfornecedor := 'F';
  ConsultaFornecedor.AbrirTabelaProcura := false;
  ConsultaFornecedor.ConsultarTodos := true;
  ConsultaFornecedor.TipoPesquisa := pesFORNECEDORES;
  ConsultaFornecedor.CondicoesdaConsulta := CondicoesConsultaFornecedorISS;
  ConsultaFornecedor.OnFound := AtribuirCodigoFornecedorParaISS;

  BloquearValores(ParSistema.GeracaoAutomaticadoImpostoRetido);

  edtDataEmissao.Minimo := DaysBetween(DataLocal,ParSistema.DataContabil)-1;
  edtDataLancamento.Minimo := DaysBetween(DataLocal,ParSistema.DataContabil)-1;

  edtDataEmissao.MensagemPadronizada := ExibirMensagemPadronizadaDataEmissao;
  edtDataLancamento.MensagemPadronizada := ExibirMensagemPadronizadaDataLancto;
  ckbAdministrador.Visible:= (UsuarioLogin.Administrador or UsuarioLogin.Suporte);

  dtmContasPagar.AfterOpenDocumentosPag := AfterOpenDocumentosPag;


  with fraLancamentoContabilidade do
  begin
    VaLorICMS                := dtmContasPagar.RetornaZero;
    ValorIPI                 := dtmContasPagar.RetornaZero;
    ValordaNota              := dtmContasPagar.GetValordaNota;
    ValordosProdutos         := dtmContasPagar.RetornaZero;
    ValorAcrescimo           := dtmContasPagar.RetornaZero;
    ValorFrete               := dtmContasPagar.RetornaZero;
    ValorSeguro              := dtmContasPagar.RetornaZero;
    ValorDespesasAcessorias  := dtmContasPagar.RetornaZero;
    ValorCustodaMercadoria   := dtmContasPagar.RetornaZero;
    ValorICMSSubstituicao    := dtmContasPagar.RetornaZero;
    ValorcofinsRetido        := dtmContasPagar.GetCofinsRetido;
    ValorcsllRetido          := dtmContasPagar.GetCSLLRetido;
    ValorinssRetido          := dtmContasPagar.GetINSSRetido;
    ValorirRetido            := dtmContasPagar.GetIRRetido;
    ValorissRetido           := dtmContasPagar.GetISSRetido;
    ValorpisRetido           := dtmContasPagar.GetPISRetido;
    ValorPISCOFINSCSLLRetido := dtmContasPagar.GetPISCOFINSCSLLRetido;
    ValorDescontos           := dtmContasPagar.RetornaZero;
    ValorReceitasDespesasFinanceiras := dtmContasPagar.RetornaZero;
    DataDocumento            := dtmContasPagar.GetDataDocumento;
    CodigoNatureza           := dtmContasPagar.RetornaInteiro;
    DebitoFornecedor         := dtmContasPagar.getDebitoFornecedor;
    FornecedorParaISS        := dtmContasPagar.getFornecedorParaISS;
    CreditoFornecedor        := dtmContasPagar.getCreditoFornecedor;
    SomenteLeituraContabilidade := dtmContasPagar.getSomenteLeituraContabilidade;
    GerarDuplicatas          := dtmContasPagar.GetGerarDocumentoPag;
    DescricaoHistorico       := dtmContasPagar.getdescricaohistorico;
    FilialDocumento          := dtmContasPagar.GetFilialDocumento;
    CodigoDocumento          := dtmContasPagar.GetCodigoDocumento;
    NumeroNotaFiscal         := dtmContasPagar.RetornaInteiro;
    ContaDebitarouCreditar   := dtmContasPagar.GetContaCreditar;
    HistoricoDebitarouCreditar := dtmContasPagar.GetHistoricoDebitar;
    ContaDebitar             := dtmContasPagar.GetContaDebitar;
    HistoricoPadrao          := dtmContasPagar.GetHistoricoPadrao;
    Origem                   := dtmContasPagar.GetOrigem;
    OrigemFormulario         := dtmContasPagar.GetOrigemFormulario;
    AtribuirContaDocumento   := dtmContasPagar.AtribuirContaCreditoDocumentoPag;
    EditarDocumento          := dtmContasPagar.EditarDocumento;
    NomeOrigemFormulario     := self.name;
    DocumentoPossuiOrigem    := dtmContasPagar.GetDocumentoPossuiOrigem;
    evento                   := dtmContasPagar.getEvento;
    BloquearImpostosRetidos  := self.BloquearImpostosRetidos;
    DesBloquearImpostosRetidos  := self.DesBloquearImpostosRetidos;

  end;

  sbnPesquisarFornecedorParaISS.Visible := false;


  fraConsultaTributacaopis.TipoPesquisa := pesTRIBUTOSPIS;
  fraConsultaTributacaoCOFINS.TipoPesquisa := pesTRIBUTOSCOFINS;
  fraConsultaNaturezaBase.TipoPesquisa := pesNATBCCRED;
  fraConsultaCNOPrestador.TipoPesquisa := pesMaoObraFornecedor;
  fraConsultaCNODeclarante.TipoPesquisa := pesMaoObraFilial;


  fraConsultaCNOPrestador.CondicoesdaConsulta := CondicoesdaConsultaMaoObraFornecedor;
  fraConsultaCNODeclarante.CondicoesdaConsulta := CondicoesdaConsultaMaoObraFiliais;

  fraConsultaEvento.TipoPesquisa := pesEVENTO;
  fraConsultaEvento.CondicoesdaConsulta := CondicoesdaConsultaEvento;


  ActiveControl := edfNumero;


//  Definir_dbgReinf_2010_infoTpServ_FloatingFooter;
//  DBEditCPFCNPJCnpjPrestador.Tipo := 'F';
//  DBEditCPFCNPJcnpJDeclarante.Tipo := 'F';


end;


function TfrmContasPagar.AcionarCadastroDuplicatas(Operacao: TtecTipoOperacaoDuplicatas): Boolean;
var
  Usuario: TtecUsuarios;
begin

  Result:= (dtmContasPagar.DuplicataAutorizada or (Operacao <> topPAGAMENTO));
  if not Result and (Operacao = topPAGAMENTO) then begin
    Usuario:= TtecUsuarios.Create(dtmTecSoft. Database);
    try
      if UsuarioLogin.Pagamento then
           Usuario:= dtmContasPagar.ObterAutorizacao(taSENHA)
      else
         Usuario:= dtmContasPagar.ObterAutorizacao(taLOGIN, ctAUTORIZACAOPAGAMENTO, ctAUTORIZADO);

      if Assigned(Usuario) and Usuario.Pagamento then
        Result:= True
      else
        MensagemAviso(format(ctUSUARIONAOAUTORIZADO,['autorizar o pagamento de duplicatas.']));
    finally
      Usuario.Free;
    end;
  end;

  if Result then
  begin
    dtmContasPagar.qryDuplicatasAfterScroll(nil);

//    if not Assigned (frmCadastroDuplicatasContasPagar) then
//      frmCadastroDuplicatasContasPagar:= TfrmCadastroDuplicatasContasPagar.Create(self);

    if edtDataEmissao.DataValida then
      frmcadastroduplicatascontaspagar.edtDataVencto.Minimo :=
          DaysBetween(Date, strtodate(edtDataEmissao.text));

    if ParSistema.DataContabil > dtmContasPagar.qryDocumentosPagemissao.AsDateTime then
      frmcadastroduplicatascontaspagar.edtDataPagto.Minimo := DaysBetween(DataLocal,ParSistema.DataContabil)-1
    else
      frmcadastroduplicatascontaspagar.edtDataPagto.Minimo := DaysBetween(Date, dtmContasPagar.qryDocumentosPagemissao.AsDateTime);

    frmCadastroDuplicatasContasPagar.SetDataModulo(dtmContasPagar);

    frmCadastroDuplicatasContasPagar.DataSet := dtmContasPagar.TabelaDuplicatas;
//    frmCadastroDuplicatasContasPagar.Operacao:= Operacao;
    dtmContasPagar.Operacao := Operacao;

    frmcadastroduplicatascontaspagar.flkFilialPagto.Exist;
    frmcadastroduplicatascontaspagar.flkConta.Exist;
//    frmcadastroduplicatascontaspagar.fraConsultaCreditar.edfCodigo.Exist;
    frmcadastroduplicatascontaspagar.flkTipoPagto.Exist;

    if parsistema.GerarContabilidade then
      frmcadastroduplicatascontaspagar.AfterScrollDuplicatas(self);

    frmCadastroDuplicatasContasPagar.ShowModal;

    dtmContasPagar.AfterScrollDuplicatas := nil;

    freeandnil(ffrmCadastroDuplicatasContasPagar);

    dbgDuplicatas.SetFocus;

  end;

end;

procedure TfrmContasPagar.actHabilitarUpdate(Sender: TObject);
begin
   with dtmContasPagar do
   begin
     sbnImprimir.Enabled := ExisteDuplicatasemAberto and not (qryDocumentosPag.State in [dsinsert, dsedit]);
     sbnImprimirRecibo.Enabled := ExisteQuitacao and not (qryDocumentosPag.State in [dsinsert, dsedit]);

     sbnExcluir. Enabled := (UsuarioLogin.AlterarDadosContabeis or
                                       UsuarioLogin.Pagamento) and
                                      (dtmContasPagar.qryDocumentosPagdocumentopagorigem.AsInteger=0);
     sbnGerarDuplicatas.Enabled := PermiteGerarDuplicata;
     sbnExcluirDuplicatas.Enabled  := PermiteExcluirDuplicata;
     sbnIncluirDuplicatas.Enabled  := (UsuarioLogin.AlterarDadosContabeis or UsuarioLogin.Pagamento);
     sbnAlterarDuplicatas.Enabled  := PermiteAlterarPagamento;
{
     fraLancamentoContabilidade.sbnGerarLancamento.Enabled    := PermiteAlterarContabilidade;
     fraLancamentoContabilidade.sbnExcluirLancamento.enabled  := PermiteAlterarContabilidade;
     fraLancamentoContabilidade.sbnIncluirLancamento.Enabled  := PermiteAlterarContabilidade;
}
     if gbxFornecedor.Enabled then
        case TipoPessoa[1] of
          'F': gbxFornecedor.Caption:= 'FORNECEDOR';
          'C': gbxFornecedor.Caption:= 'FORNECEDOR (CLIENTE)';
          'L': gbxFornecedor.Caption:= 'FORNECEDOR (FILIAL)';
        end;
{      if ExisteNota then
        gbxSerieNumero.Caption := 'SÉRIE e Nº DA NOTA'
      else gbxSerieNumero.Caption := 'DOCTO DE ORIGEM';
}
      if (qryDocumentosPagdocumentopagorigem.AsInteger <> 0) then
        pgcValores.ActivePage := tstOrigem
      else
        if pgcvalores.ActivePage <> tstValores then
          pgcValores.ActivePage := tstValores;

     ckbPrevisao.Visible := not AdiantamentoFornecedor;
     tstImpostosPISCOFINS.TabVisible := not ExisteNota;

     tstReinf.TabVisible := {qryProcurarFornecedoresmaodeobra.asboolean;} FALSE;

   end;


end;


