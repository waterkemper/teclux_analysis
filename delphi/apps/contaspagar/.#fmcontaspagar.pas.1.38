  inherited;

  rbnIndObra_0.Enabled := true;
  rbnIndObra_0.Checked := true;
  rbnIndObra_1.Enabled := false;
  rbnIndObra_2.Enabled := false;

end;

procedure TfrmContasPagar.rbnCNOtpInscEstabClick(Sender: TObject);
begin
  inherited;

  
  if not (rbnIndObra_1.checked or
          rbnIndObra_2.checked) then
    rbnIndObra_1.checked := true;

  rbnIndObra_0.Enabled := false;
  rbnIndObra_1.Enabled := true;
  rbnIndObra_2.Enabled := true;


end;

procedure TfrmContasPagar.rbnIndObra_0Click(Sender: TObject);
begin
  inherited;
  tstIndObra_0.TabVisible := true;
  tstIndObra_1.TabVisible := false;
  tstIndObra_2.TabVisible := false;

  pgcIndObra.ActivePage := tstIndObra_0;

  if not rbnCNPJtpInscEstab.Checked then
    rbnCNPJtpInscEstab.Checked := true

end;

procedure TfrmContasPagar.rbnIndObra_1Click(Sender: TObject);
begin
  inherited;
  tstIndObra_0.TabVisible := false;
  tstIndObra_1.TabVisible := true;
  tstIndObra_2.TabVisible := false;

  pgcIndObra.ActivePage := tstIndObra_1;

  if not rbnCNOtpInscEstab.Checked then
    rbnCNOtpInscEstab.Checked := true;

  if fraConsultaCNOPrestador.dsrProcuraMaoObraFornecedor.DataSet.RecordCount = 0 then
    if fraConsultaCNOPrestador.edfCodigo.text <> '' then
    begin
      fraConsultaCNOPrestador.edfCodigo.Clear;
      dtmContasPagar.qryReinf_2010nrinscestab_1.clear;
    end;

end;

procedure TfrmContasPagar.rbnIndObra_2Click(Sender: TObject);
begin
  inherited;
  tstIndObra_0.TabVisible := false;
  tstIndObra_1.TabVisible := false;
  tstIndObra_2.TabVisible := true;

  pgcIndObra.ActivePage := tstIndObra_2;

  if not rbnCNOtpInscEstab.Checked then
    rbnCNOtpInscEstab.Checked := true;

  if fraConsultaCNODeclarante.dsrProcuraMaoObraFilial.DataSet.RecordCount = 0 then
    if fraConsultaCNODeclarante.edfCodigo.text <> '' then
    begin
      fraConsultaCNODeclarante.edfCodigo.Clear;
      dtmContasPagar.qryReinf_2010nrinscestab_2.clear;
    end;


end;

