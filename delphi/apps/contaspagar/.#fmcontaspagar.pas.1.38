function TfrmContasPagar.TabelaDePesquisa: TZDataSet;
begin
  with dtmContasPagar do begin
    case TipoPesquisa of
         dupDOCUMENTOSPAG: Result:= ConsultarDocumentosPag;
               dupFILIAIS: Result:= ConsultarFiliais;
          dupFORNECEDORES: Result:= ConsultarFornecedores;
                dupEVENTO: Result:= ConsultarEventos;
             dupCONTADOCUMENTOSPAG: Result:= ConsultarContaPagto;
         dupTIPOPAGTODOCUMENTOSPAG: Result:= ConsultarTiposPagamento;
    else
      Result:= nil;
    end;
  end
end;

procedure TfrmContasPagar.edfNumeroFound(Found: Boolean);
begin
  inherited;
  if found then
  begin
    edtDataLancamento.Minimo := dtmContasPagar.NDiasLimiteLancto;
    fraconsultaevento.edfcodigo.Exist;
    if dtmContasPagar.IncluindoDocumentoPag then
      edtDataEmissao.Minimo    := ParSistema.DiasNotaRetroativa
    else
    begin
      edtDataEmissao.Minimo := DaysBetween(dtmContasPagar.DataServidor,
         (dtmContasPagar.qryDocumentosPagemissao.AsDateTime -
          ParSistema.DiasNotaRetroativa));
    end;

    if dtmContasPagar.qryDocumentosPagdocumentopagorigem.AsInteger <> 0 then
      pgcValores.ActivePageindex := 1
    else pgcValores.ActivePageindex := 0;

    if ParSistema.GerarContabilidade then
      tstContabilidade.TabVisible := not dtmContasPagar.qryDocumentosPagprevisao.AsBoolean {and
                                         (dtmContasPagar.qryDocumentosPagdocumentopagorigem.AsInteger = 0)};

//    edfNumero.SetControls.Items[13].Destroy;
{    CollItem := TtecControlsCollection(edfNumero.NoSetControls.clear);
    CollItem.Control := pgcValores;}
//    VenctosImpostosRetidosEntradasAfterOpen(self);
    if not dtmContasPagar.AdiantamentoFornecedor then
    begin
      ControlarEdicaoPISCOFINSCSLL;
      pgcControle.ActivePage := tstContaPagar;
      tstDuplicatas.Caption := ' &1 - Duplicatas';
    end
    else
    begin
      BloquearValores(true);
      pgcControle.ActivePage := tstAdiantamento;
      tstDuplicatas.Caption := ' &1 - Adiantamento';      
    end;


  end;
end;


