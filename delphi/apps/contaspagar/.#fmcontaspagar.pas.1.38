  var Key: Word; Shift: TShiftState);
begin
  inherited;
  case key of
    VK_Return:
   begin
    if tstContabilidade.TabVisible then
       pgcDocumentos.ActivePage := tstContabilidade;
    dbgDuplicatas.SetFocus;
    Key:= 0;
   end;
  end;
end;

procedure TfrmContasPagar.sbnGerarDuplicatasClick(Sender: TObject);
begin
  inherited;
  frmCalcularDuplicatas:= Tfrmcalcularduplicatas.Create(frmCalcularDuplicatas);

  frmCalcularDuplicatas.edtVencimento.Minimo := DaysBetween(Date,
              dtmContasPagar.qryDocumentosPagemissao.AsDateTime);
  frmCalcularDuplicatas.DataEmissao := strtodate(edtDataemissao.text);
  frmCalcularDuplicatas.edtVencimento.MensagemPadronizada := frmCalcularDuplicatas.ExibirMensagemPadronizada;
  frmCalcularDuplicatas.ShowModal;
  if frmCalcularDuplicatas.ModalResult = mrOK then
    dtmContasPagar.GerarParcelas(frmCalcularDuplicatas.NrParcelas,
                               frmCalcularDuplicatas.Vencimento,
                               frmCalcularDuplicatas.Intervalo,
                               frmCalcularDuplicatas.TipoJuros,
                               frmCalcularDuplicatas.TipoMulta,
                               frmCalcularDuplicatas.Juros,
                               frmCalcularDuplicatas.Multa);
   frmCalcularDuplicatas.free;
   dbgDuplicatas.SetFocus;
end;


