  fraConsultaCNOPrestador.qryConsultaMaoObraFornecedor.ParamByName('fornecedor').asinteger := dtmContasPagar.qryDocumentosPagfornecedor.AsInteger;
  fraConsultaCNOPrestador.qryConsultaMaoObraFornecedor.ParamByName('tipofornecedor').asString := dtmContasPagar.qryDocumentosPagtipofornecedor.AsString;

end;

