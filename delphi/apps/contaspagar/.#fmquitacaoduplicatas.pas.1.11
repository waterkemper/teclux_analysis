procedure TfrmQuitacaoDuplicatas.edtDataQuitacaoExit(Sender: TObject);
begin
  inherited;
  with dtmQuitacaoDuplicatas do
  if edtDataQuitacao.DataValida then
    DataCalculoDataPagamento := strtodatetime(edtDataQuitacao.text)
  else
    DataCalculoDataPagamento := dataServidor;
end;

