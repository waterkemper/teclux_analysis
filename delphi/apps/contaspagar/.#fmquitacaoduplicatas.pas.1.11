function TfrmQuitacaoDuplicatas.TabelaDePesquisa: TZdataSet;
begin
  with dtmQuitacaoDuplicatas do
    case TipoPesquisa of
        dupFILIAIS:      Result:= ConsultaFiliais;
        dupFILIAISPAGTO: Result:= ConsultaFilPagto;
        dupGRUPOFILIAIS: Result:= ConsultaGrupoFiliais;
        dupFORNECEDORES: Result:= ConsultaFornecedores;
        dupBANCO:        Result:= ConsultaBancos;
        dupCONTA:        Result:= ConsultaContas;
        dupTIPOPAGTO:    Result:= ConsultaTiposPagamentos;
dupCONTACREDITOPAGAMENTO : result := qryConsultaContaContabil;
    else                 Result:= nil;
    end;
end;

function TfrmQuitacaoDuplicatas.TabelaDoParametro(Parametro: Integer): TZDataSet;
begin
  case Parametro of
    0 :  Result:= dtmQuitacaoDuplicatas.ConsultaBancos;
    else Result:= nil;
  end;
end;

function TfrmQuitacaoDuplicatas.ValidarCamposQuitacao: Boolean;
begin
  Result:= False;
  try

    edtDataQuitacao.MensagemPadronizadaRetorno := nil;

    if ecvQuitacao.Verify(tstSelecionados,ControleAtivo) then
    begin
      Result:= OperadorTernario((Trim(edfFilialPagto.Text) <> ''),edfFilialPagto.Exist, True) and
               OperadorTernario((Trim(edfTipoPagto.  Text) <> ''),edfTipoPagto.  Exist, True) and
               OperadorTernario((Trim(edfConta.      Text) <> ''),edfConta.  Exist, True);

      if Result then
      begin
        with dtmQuitacaoDuplicatas do
        begin
          case rgbOperacao.ItemIndex of
          1: if edfConta.Text = '' then
             begin
               MensagemAviso('A conta é obrigatória para a impressão de cheques.');
               Result:= False;
               edfConta.SetFocus;
             end
             else
             if not edfConta.Exist then
             begin
               MensagemAviso('A conta não existe.');
               Result:= False;
               edfConta.SetFocus;
             end
             else
             if qryContasModeloCheque.AsInteger = 0 then
             begin
               MensagemAviso(ctMODELOIMPRESSAOCHEQUE);
               Result:= False;
               edfConta.SetFocus;
             end
             else
             if edtCheque.Text = '' then
             begin
               MensagemAviso('O nº do cheque não foi informado.');
               Result:= False;
               edtCheque.SetFocus;
             end;
          end;

          qryConta_e_Cheque.Close;

          if result then
          begin
            if (edfConta.Text <> '') and (edtCheque.Text <> '') then
            begin
              RefazConsultaPorNome(qryConta_e_Cheque,['contapagto','chequepagto'],
                             [edfConta.text,edtCheque.text]);
              if not qryConta_e_Cheque.IsEmpty then
              begin
                if qryConta_e_Chequedatapagto.Asdatetime = strtodate(edtDataQuitacao.Text) then
                  result := MensagemSelecionaOpcao(ctCHEQUEJAUTILIZADOSNESTEDIA) = smbYes
                else
                begin
                  result := false;
                  MensagemErro(format(ctCHEQUEJAUTILIZADOS,[qryconta_e_chequeDataPagto.asstring]));
                end;
              end;
            end;
          end;

          if result then
          begin
            if IntegracaocomBancos or ParSistema.GerarContabilidade then
            begin
              if edfConta.Text='' then
              begin
                MensagemErro(ctCONTABRANCO);
                result := false;
                edfConta.setfocus;
              end
              else
              if ParSistema.GerarContabilidade and (dtmQuitacaoDuplicatas.qryProcuraCreditarPagamentocodigo.AsInteger = 0) then
              begin
                 MensagemErro(format(ctBANCOSEMCONTACONTABIL,
                     [edfConta.Text]));
                 result := false;
              end;
            end;

          end;
        end;
      end;
    end;
  finally
    edtDataQuitacao.MensagemPadronizadaRetorno := ExibirMensagemPadronizadaREtornoDataPagto;
  end;
end;

function TfrmQuitacaoDuplicatas.ValidarCamposSelecao: Boolean;
begin
   Result:= edtVenctoInicial.DataValida and edtVenctoFinal.DataValida;
   if Result then
      Result:= ((edtVenctoInicial.Text <> '') or (edtVenctoFinal.Text <> '')) and
               (ckbCarteira.Checked or ckbBanco.Checked);
   if Result then
      Result := OperadorTernario((Trim(edfFilial.     Text) <> ''), edfFilial.     Exist, True) and
                OperadorTernario((Trim(edfGrupoFilial.Text) <> ''), edfGrupoFilial.Exist, True) and
                OperadorTernario((Trim(edfFornecedor. Text) <> ''), edfFornecedor. Exist, True) and
                OperadorTernario((Trim(edfBanco.      Text) <> ''), edfBanco.      Exist, True);
end;

procedure TfrmQuitacaoDuplicatas.ZerarCampos;
begin
  edtCheque.        Clear;
  with dtmQuitacaoDuplicatas do
  begin
    QtdeMarcadosDuplicatas  := 0;
    TotalMarcadosDuplicatas := 0;
    QtdeMarcadosAgrupados  := 0;
    TotalMarcadosAgrupados := 0;
  end;

end;

