  ControleAtivo: TWinControl;

implementation

{$R *.dfm}

{ TfrmQuitacaoDuplicatas }

procedure TfrmQuitacaoDuplicatas.actHabilitarUpdate(Sender: TObject);

   function ComImpressaoCheque: Boolean;
   begin
      Result:= rgbOperacao.ItemIndex = 1;
   end;

begin
   inherited;
   with dtmQuitacaoDuplicatas do
   begin

      gbxBanco.Enabled:= ckbBanco.Checked;

      if ComImpressaoCheque then gbxConta.Caption:= 'Nº DA CONTA'
                            else gbxConta.Caption:= 'CONTA CAIXA';
      gbxCheque.          Enabled:= True; {ComImpressaoCheque;}
      rgbNominal.         Enabled:= ComImpressaoCheque;
      rgbAgrupar.         Enabled:= ComImpressaoCheque;
      gbxCidadeCheques.   Enabled:= ComImpressaoCheque;
      sbnMostrarDuplicatas.Visible:= ComImpressaoCheque and
                                     (rgbAgrupar.ItemIndex in [0,1]);
//                                    (QtdeMarcados > 0);

      if not ComImpressaoCheque then
         edtCidade.Clear;

      case TipoPessoa[1] of
        'F': gbxFornecedor.Caption:= 'FORNECEDOR';
        'C': gbxFornecedor.Caption:= 'CLIENTE FORNECEDOR';
        'L': gbxFornecedor.Caption:= 'FILIAL FORNECEDOR';
      end;
      sbnGerar.Enabled:= pgcQuitacaoDuplicatas.ActivePage = tstParametros;
      case OperacaoTabelaAnterior of
        Duplicatas: sbnConfirma.Enabled := (pgcDetalhadoAgrupado.ActivePage = tstDetalhado) and
                                           (QtdeMarcadosDuplicatas > 0);
        Agrupadas: sbnConfirma.Enabled := (pgcDetalhadoAgrupado.ActivePage = tstAgrupado) and
                                          (QtdeMarcadosAgrupados > 0);
      end;
      ckbSelecionarTodos.Enabled:= (QtdeDuplicatas > 0) or (QtdeAgrupadas > 0);
      if ckbSelecionarTodos.Enabled then
      begin
        ckbSelecionarTodos.OnClick := nil;
        ckbSelecionarTodos.Checked := ((pgcDetalhadoAgrupado.ActivePage = tstDetalhado) and
                                       (QtdeMarcadosDuplicatas = QtdeDuplicatas)) or
                                      ((pgcDetalhadoAgrupado.ActivePage = tstAgrupado) and
                                       (QtdeMarcadosAgrupados = QtdeAgrupadas));
        ckbselecionartodos.OnClick := ckbSelecionarTodosClick;
      end;
      if not ckbBanco.Checked then begin
         edfBanco.Clear;
         dtxBancoSigla.DataSource.DataSet.FieldByName('Sigla').Clear;
      end;

      lblContrapartidaAlterada.visible := PrevisaoAlterada;
      shContaCreditoPagamento.visible := PrevisaoAlterada;
   end;
end;

procedure TfrmQuitacaoDuplicatas.AtualizarContadores;
begin
  with dtmQuitacaoDuplicatas do
  begin
   case pgcDetalhadoAgrupado.ActivePageIndex of
   0 : begin
         edtQtdeDuplicatas.Text:= IntToStr(QtdeDuplicatas);
         edtTotalPrevisao. Text:= Format('%8.2m', [TotalDuplicatas]);
         edtQtdeMarcados.Text:= IntToStr(QtdeMarcadosDuplicatas);
         edtTotalQuitar. Text:= Format('%8.2m', [TotalMarcadosDuplicatas]);
       end;
   1:  begin
         edtQtdeDuplicatas.Text:= IntToStr(QtdeAgrupadas);
         edtTotalPrevisao. Text:= Format('%8.2m', [Totalagrupadas]);
         edtQtdeMarcados.Text:= IntToStr(QtdeMarcadosAgrupados);
         edtTotalQuitar. Text:= Format('%8.2m', [TotalMarcadosAgrupados]);
       end;
   end;
  end;
end;

procedure TfrmQuitacaoDuplicatas.ckbSelecionarTodosClick(Sender: TObject);
begin
  inherited;
  dtmQuitacaoDuplicatas.MarcarSelecionados(ckbSelecionarTodos.Checked,True);
  AtualizarContadores;
end;

constructor TfrmQuitacaoDuplicatas.Create(AOwner: TComponent);
begin
   dtmQuitacaoDuplicatas:= TdtmquitacaoDuplicatas.Create(Self);
   inherited;
   with dtmQuitacaoDuplicatas do begin
      Abre(ctTabelas);
      edtVenctoInicial.Text:= DateToStr(DataServidor);
      edtVenctoFinal.  Text:= DateToStr(DataServidor);
      edtDataQuitacao. Text:= DateToStr(DataServidor);
      OnDuplicatasEdit     := DuplicatasEdit;
      RefazConsulta(qryFilPagto,[0],[FilialBase]);
      DataCalculoDataPagamento := DataServidor;
   end;
   gbxContaCredito.Visible := ParSistema.GerarContabilidade;

   edtDataQuitacao.MensagemPadronizadaRetorno := ExibirMensagemPadronizadaREtornoDataPagto;
end;

procedure TfrmQuitacaoDuplicatas.dbgDetalhadoDblClick(Sender: TObject);
begin
  inherited;
  dtmQuitacaoDuplicatas.MarcarSelecionados(ckbSelecionarTodos.Checked, False);
  AtualizarContadores;
end;

procedure TfrmQuitacaoDuplicatas.dbgDetalhadoDrawColumnCell(
  Sender: TObject; const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  inherited;

  if dbgDetalhado.DataSource.DataSet.FieldByName('quitar').AsBoolean then
  begin
    TDBGrid(Sender).Canvas.Brush.Color := clInfoBk;
    TDBGrid(Sender).Canvas.Font.Color  := clBlack;
  end;

  if dbgDetalhado.DataSource.DataSet.FieldByName('observacao').Asstring='' then
    TDBGrid(Sender).Canvas.Font.Style := []
  else
    TDBGrid(Sender).Canvas.Font.Style := [fsBold];

  if column.FieldName = 'previsao' then
  begin
    if dtmQuitacaoDuplicatas.qryDuplicatasprevisaoalterada.asBoolean then
    begin
      TDBGrid(Sender).Canvas.Font.Color  := clRed;
    end;
  end;

  TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
end;

procedure TfrmQuitacaoDuplicatas.dbgDetalhadoKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;
  if Key = VK_Space then
    if Shift = [ssCtrl] then
    begin
      dtmQuitacaoDuplicatas.MarcarSelecionados(ckbSelecionarTodos.Checked, False);
      AtualizarContadores;
    end;
end;

destructor TfrmQuitacaoDuplicatas.Destroy;
begin
  dtmQuitacaoDuplicatas.free;
  dtmQuitacaoDuplicatas:=nil;
  inherited;
  frmQuitacaoDuplicatas:= nil;
end;

procedure TfrmQuitacaoDuplicatas.DuplicatasEdit(Sender: TObject);
begin
  AtualizarContadores;
end;

procedure TfrmQuitacaoDuplicatas.edtDataQuitacaoEnter(Sender: TObject);
begin
  inherited;
  with dtmQuitacaoDuplicatas do
    edtDataQuitacao.Minimo:= DaysBetween(DataServidor,DataContabil+1);

end;

function TfrmQuitacaoDuplicatas.ExisteInformacao(Parametro: Integer; NomeCampo: string; Value: Variant): Boolean;
begin
  with dtmQuitacaoDuplicatas do
    case TipoPesquisa of
           dupFILIAIS,
      dupFILIAISPAGTO: Result:= ExisteFiliais(NomeCampo, Value);
      dupGRUPOFILIAIS: Result:= ExisteGrupoFiliais(NomeCampo, Value);
      dupFORNECEDORES: Result:= ExisteFornecedores(NomeCampo, Value);
             dupBANCO: Result:= ExisteBanco(NomeCampo, Value);
             dupCONTA: Result:= ExisteConta(NomeCampo, Value);
         dupTIPOPAGTO: Result:= ExisteTipoPagamento(NomeCampo, Value);
      dupCONTACREDITOPAGAMENTO : result := ExistecontaContabil(NomeCampo, Value);
      else             Result:= False
    end;
end;

function TfrmQuitacaoDuplicatas.InternoPesquisar(Titulo: string): Integer;
begin
  Result := mrNone;
  if ActiveControl is TtecFindCustom then begin
    if CtrlOn then begin
      if ActiveControl = edfFilial then begin
        TipoPesquisa := dupFILIAIS;
        Titulo       := 'Filiais';
      end
      else if ActiveControl = edfGrupoFilial then begin
        TipoPesquisa := dupGRUPOFILIAIS;
        Titulo       := 'Grupo Filiais';
      end
      else if ActiveControl = edfFornecedor then begin
        TipoPesquisa := dupFORNECEDORES;
        Titulo       := 'Fornecedores';
      end
      else if ActiveControl = edfBanco then begin
        TipoPesquisa := dupBANCO;
        Titulo       := 'Bancos';
      end
      else if ActiveControl = edfFilialPagto then begin
        TipoPesquisa := dupFILIAISPAGTO;
        Titulo       := 'Filiais';
      end
      else if ActiveControl = edfTipoPagto then begin
        TipoPesquisa := dupTIPOPAGTO;
        Titulo       := 'Tipos pagamentos';
      end
      else if ActiveControl = edfConta then begin
        TipoPesquisa := dupConta;
        Titulo       := 'Contas';
      end;
//      else if ActiveControl = edfCreditarPagamento then
//        TipoPesquisa := dupCONTACREDITOPAGAMENTO;

      with dtmQuitacaoDuplicatas do begin
        AbreTabelaPesquisa(TipoPesquisa);
        Result:= inherited InternoPesquisar(Titulo);
        if Result = mrOK then
          Selecionar(TipoPesquisa);
        FechaTabelaPesquisa(TipoPesquisa);
      end;
    end;
  end;
end;

function TfrmQuitacaoDuplicatas.JanelaPesquisa: TfrmConsultaBasica;
begin
  Result:= TfrmConsultaPorCampo.Create(nil);
  if TipoPesquisa = dupFORNECEDORES then
    TfrmConsultaPorCampo(Result).ConsultaInterativa := False
  else begin
    TfrmConsultaPorCampo(Result).ConsultaInterativa := True;
  end;
end;

procedure TfrmQuitacaoDuplicatas.KeyDown(var Key: Word; Shift: TShiftState);
begin
  inherited;
  case Key of
    VK_F5 : if sbnConfirma.Enabled and not CtrlOn then sbnConfirma.Click;
    VK_F6 : if sbnGerar.Enabled and not CtrlOn then sbnGerar.Click;
    VK_F11: if sbnMostrarDuplicatas.Enabled and sbnMostrarDuplicatas.Visible then sbnMostrarDuplicatas.Click;
    VK_Escape: if pgcQuitacaoDuplicatas.ActivePage = tstSelecionados then
                  pgcQuitacaoDuplicatas.ActivePage:= tstParametros;
    VK_Space: if (Shift = [ssCtrl]) then
               begin
                {$ifndef LINUX}
                 case dtmQuitacaoDuplicatas.OperacaoTabela of
                   Duplicatas : begin
                                 if dbgDetalhado.Focused then
                                   if dbgDetalhado.SelectedIndex = 1 then
                                     dbgDetalhado.SelectedIndex := 0;
                                end;
                   Agrupadas :  begin
                                 if dbgAgrupado.Focused then
                                   if dbgAgrupado.SelectedIndex = 1 then
                                     dbgAgrupado.SelectedIndex := 0
                                end;
                 end;
                {$endif}
               end;
  end;
end;

procedure TfrmQuitacaoDuplicatas.pgcFilialGrupoFilialChange(Sender: TObject);
begin
  inherited;
  if pgcFilialGrupoFilial.ActivePage = tstFilial then begin
    edfGrupoFilial.Clear;
    edfFilial.setFocus;
  end
  else begin
    edfFilial.Clear;
    edfGrupoFilial.setFocus;
  end;
end;

procedure TfrmQuitacaoDuplicatas.pgcQuitacaoDuplicatasChange(Sender: TObject);
begin
  inherited;
  if pgcQuitacaoDuplicatas.ActivePage = tstParametros then
    edtVenctoInicial.SetFocus;
end;

procedure TfrmQuitacaoDuplicatas.PosicionarTabelaNoParametro(Ind: Integer; var continuar: Boolean);
begin
{  inherited;
  case TipoPesquisa of
    dupAGENCIAPAGTO: begin
                       case Ind of
                         0:   Continuar := dtmQuitacaoDuplicatas.PosicionarBanco;
                         else Continuar := False;
                       end;
                     end;
  end;}
end;

procedure TfrmQuitacaoDuplicatas.sbnConfirmaClick(Sender: TObject);
var
  Frm: TForm;
begin
  inherited;

  if ValidarCamposQuitacao then
  begin
    Frm := TfrmContasPagar.Referencia;
    if Assigned(Frm) then
      dtmQuitacaoDuplicatas.DocumentoPagAberto := TfrmContasPagar(Frm).NumeroDocumentoPag;

    dtmQuitacaoDuplicatas.ReabrirDocumentoPag := false;
    if dtmQuitacaoDuplicatas.EfetuarQuitacao then
    begin
      if dtmQuitacaoDuplicatas.ReabrirDocumentoPag then
        TfrmContasPagar(Frm).ReabrirDocumentoPag;

      ZerarCampos;
      AtualizarContadores;
      edtCheque.SetFocus;
    end;  
  end;
end;

procedure TfrmQuitacaoDuplicatas.sbnGerarClick(Sender: TObject);
begin
  inherited;
  if ValidarCamposSelecao then
  begin
    with dtmQuitacaoDuplicatas do
    begin
      Agrupado      := rgbAgrupar.  ItemIndex;
      Opcoes        := rgbOperacao. ItemIndex;
      Ordenacao     := rgbOrdenacao.ItemIndex;
      TipoNominal   := rgbNominal.  ItemIndex;
      TotalCheque   := 0;

      VenctoInicial := edtVenctoInicial.Text;
      VenctoFinal   := edtVenctoFinal.  Text;
      Filial        := edfFilial.       Text;
      Grupo         := edfGrupoFilial.  Text;
      Fornecedor    := edfFornecedor.   Text;
      Banco         := edfBanco.        Text;

           if ckbCarteira.Checked and
              ckbBanco.   Checked then Tipo:= 'T'
      else if ckbCarteira.Checked then Tipo:= 'C'
      else if ckbBanco.   Checked then Tipo:= 'B';

      if SelecionarDuplicatas then
      begin
         OperacaoTabelaAnterior := OperacaoTabela;
         edtCheque.Clear;
         pgcQuitacaoDuplicatas.ActivePage:= tstSelecionados;

         case OperacaoTabela of
           Duplicatas :
           begin
             pgcDetalhadoAgrupado.ActivePage:= tstDetalhado;
             dbgDetalhado.Columns[1].ReadOnly:= not (rgbNominal.ItemIndex = 1);
             dbgAgrupado.Columns[1].ReadOnly := true;
             dbgDetalhado.SetFocus;
           end;
           Agrupadas :
           begin
             pgcDetalhadoAgrupado.ActivePage:= tstAgrupado;
             dbgDetalhado.Columns[1].ReadOnly:= true;
             dbgAgrupado.Columns[1].ReadOnly := not (rgbNominal.ItemIndex = 1);
             dbgAgrupado.SetFocus;
           end;
         end;
      end
      else
      begin
         MensagemAviso('              Nenhum registro foi selecionado!' + #10#13 + #10#13 +
                       '(As duplicatas foram autorizadas para pagamento?)');
         edtVenctoInicial.SetFocus;
      end;

      ckbChequeUnico.Checked := false;
      ckbChequeUnico.Visible := rgbOperacao.ItemIndex = 1;
      ckbSelecionarTodos.Checked:= False;
      ZerarCampos;
      AtualizarContadores;

      PrevisaoAlterada := false;

    end;
  end;
end;

procedure TfrmQuitacaoDuplicatas.sbnMostrarDuplicatasClick(Sender: TObject);
begin
  inherited;
  if pgcDetalhadoAgrupado.ActivePage = tstDetalhado then
  begin
    dtmQuitacaoDuplicatas.gravarPrevisao_Detalhadas;
    dtmQuitacaoDuplicatas.qryduplicatas.Filtered := false;
    dtmQuitacaoDuplicatas.qryDuplicatas_PrevisoesAlteradas.Filtered := false;

    dtmQuitacaoDuplicatas.OperacaoTabela := Agrupadas;
    pgcDetalhadoAgrupado.ActivePage:= tstAgrupado;
    sbnMostrarDuplicatas.Caption:= 'F11 - Exibir duplicatas  [Detalhadas]';
    dbgAgrupado.SetFocus;
  end
  else
  begin
    if rbnFornecedor.Checked then
      dtmQuitacaoDuplicatas.SelecionarDuplicatasPorFornecedor
    else dtmQuitacaoDuplicatas.SelecionarDuplicatasPorDocumento;
    dtmQuitacaoDuplicatas.GravarPrevisao_Agrupadas;
    dtmQuitacaoDuplicatas.OperacaoTabela := Duplicatas;
    pgcDetalhadoAgrupado.ActivePage:= tstDetalhado;
    sbnMostrarDuplicatas.Caption:= 'F11 - Exibir duplicatas  [Agrupadas]';
    dbgDetalhado.SetFocus;
  end;
  AtualizarContadores;
end;


procedure TfrmQuitacaoDuplicatas.sbnProcurarBancoClick(Sender: TObject);
begin
  inherited;
  CtrlOn:= True;
  edfBanco.SetFocus;
  InternoPesquisar('');
end;

