  fmcontaspagar in 'fmcontaspagar.pas' {frmContasPagar},
  dmcontaspagar in 'dmcontaspagar.pas' {dtmContasPagar: TDataModule},
  fmcadastroduplicatascontaspagar in 'fmcadastroduplicatascontaspagar.pas' {frmCadastroDuplicatas},
  fmquitacaoduplicatas in 'fmquitacaoduplicatas.pas' {frmQuitacaoDuplicatas},
