  dmautorizacaopagamento in 'dmautorizacaopagamento.pas' {dtmAutorizacaoPagamento: TDataModule},
  fmautorizacaopagamento in 'fmautorizacaopagamento.pas' {frmAutorizacaoPagamento},
  dmrelatoriosituacaofornecedores in 'dmrelatoriosituacaofornecedores.pas' {dtmRelatoriosituacaofornecedores: TDataModule},
  fmrelatoriosituacaofornecedores in 'fmrelatoriosituacaofornecedores.pas' {frmRelatoriosituacaofornecedores},
  dmGerarRemessasPagamentos in 'dmgerarremessaspagamentos.pas' {dtmGerarRemessasPagamentos: TDataModule},
