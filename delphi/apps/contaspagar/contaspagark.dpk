package contaspagark;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$SONAME 'contaspagar'}
{$RUNONLY}
{$IMPLICITBUILD ON}
requires
  visualclx,
  repositoriok;

contains
  dmcontaspagar in 'dmcontaspagar.pas' {dtmContasPagar: TDataModule},
  dmfichafinanceirafornecedor in 'dmfichafinanceirafornecedor.pas' {dtmFichaFinanceiraFornecedor: TDataModule},
  fmcadastroduplicatascontaspagar in 'fmcadastroduplicatascontaspagar.pas' {frmCadastroDuplicatasContasPagar},
  fmcontaspagar in 'fmcontaspagar.pas' {frmContasPagar},
  fmfichafinanceirafornecedor in 'fmfichafinanceirafornecedor.pas' {frmFichaFinanceiraFornecedor},
  rgcontaspagar in 'rgcontaspagar.pas',
  dmquitacaoduplicatas in 'dmquitacaoduplicatas.pas' {dtmQuitacaoDuplicatas: TDataModule},
  fmquitacaoduplicatas in 'fmquitacaoduplicatas.pas' {frmQuitacaoDuplicatas},
  dmcadastrotipospagamentos in 'dmcadastrotipospagamentos.pas' {dtmCadastroTiposPagamentos: TDataModule},
  fmcadastrotipospagamentos in 'fmcadastrotipospagamentos.pas' {frmCadastroTiposPagamentos},
  fmrelatoriochequesemitidos in 'fmrelatoriochequesemitidos.pas' {frmRelatorioChequesEmitidos},
  dmrelatoriochequesemitidos in 'dmrelatoriochequesemitidos.pas' {dtmRelatorioChequesEmitidos: TDataModule},
  dmcancelamentoquitacao in 'dmcancelamentoquitacao.pas' {dtmCancelamentoQuitacao: TDataModule},
  fmcancelamentoquitacao in 'fmcancelamentoquitacao.pas' {frmCancelamentoQuitacao},
  fmautorizacaopagamento in 'fmautorizacaopagamento.pas' {frmAutorizacaoPagamento},
  dmautorizacaopagamento in 'dmautorizacaopagamento.pas' {dtmAutorizacaoPagamento: TDataModule},
  dmrelatorioduplicatas in 'dmrelatorioduplicatas.pas' {dtmRelatorioDuplicatas: TDataModule},
  fmrelatorioduplicatas in 'fmrelatorioduplicatas.pas' {frmRelatorioDuplicatas},
  dmrelatoriosituacaofornecedores in 'dmrelatoriosituacaofornecedores.pas' {dtmRelatoriosituacaofornecedores: TDataModule},
  fmrelatoriosituacaofornecedores in 'fmrelatoriosituacaofornecedores.pas' {frmRelatoriosituacaofornecedores};



end.
