begin
  inherited;
  qryFichaFornecedorValorLiquido.AsCurrency:= qryFichaFornecedorvalor.       AsCurrency -
                                              qryFichaFornecedorIRRetido.    AsCurrency -
                                              qryFichaFornecedorINSSRetido.  AsCurrency -
                                              qryFichaFornecedorISSRetido.   AsCurrency -
                                              qryFichaFornecedorPISRetido.   AsCurrency -
                                              qryFichaFornecedorCOFINSRetido.AsCurrency -
                                              qryFichaFornecedorCSLLRetido.  AsCurrency;

end;

