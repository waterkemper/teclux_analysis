function TdtmFichaFinanceiraFornecedor.GetTipoPessoa: String;
begin
  if qryFornecedortipo.AsString = '' then
       Result:= 'F'
  else Result:= qryFornecedortipo.AsString;
end;

procedure TdtmFichaFinanceiraFornecedor.LimparTabelas;
begin
  qryDuplicatas.Close;
  qryProdutosNotas.Close;
  qryFichaFornecedor.Close;
end;

procedure TdtmFichaFinanceiraFornecedor.MontarDataEmissao;
begin
  if not DataEmBranco(FDataInicial) then begin
    if DataEmBranco(FDataFinal) then
       qryFichaFornecedor.MacroByName('dataemissao').AsString := 'and (d.emissao = ' + '''' + FDataInicial + ''')'
    else
       qryFichaFornecedor.MacroByName('dataemissao').AsString := 'and (d.emissao between (' + '''' + FDataInicial + ''') and (''' + FDataFinal + '''))';
  end
  else begin
    if not DataEmBranco(FDataFinal) then
       qryFichaFornecedor.MacroByName('dataemissao').AsString := 'and (d.emissao = ' + '''' + FDataFinal + ''')'
    else
       qryFichaFornecedor.MacroByName('dataemissao').AsString := '';
  end;
end;

procedure TdtmFichaFinanceiraFornecedor.qryFichaFornecedorAfterScroll(DataSet: TDataSet);
begin
  inherited;
  ReFazConsulta(qryDuplicatas,[0],[qryFichaFornecedornumero.AsInteger]);
  ReFazConsulta(qryProdutosNotas,[0],[qryFichaFornecedorcodigo.AsInteger]);
end;

procedure TdtmFichaFinanceiraFornecedor.qryFornecedorBeforeOpen(DataSet: TDataSet);
begin
  inherited;
  if qryFornecedor.Params[0].AsString = '' then
    qryFornecedor.Params[0].AsString:= 'F';
end;

function TdtmFichaFinanceiraFornecedor.ReFazConsultaFichaFornecedor: Boolean;
begin
  RefazConsulta(qryFichaFornecedor,[],[]);
  Result:= qryFichaFornecedor.IsEmpty;
  if Result then begin
    qryDuplicatas.Close;
    qryProdutosNotas.Close;
  end;
end;

procedure TdtmFichaFinanceiraFornecedor.Selecionar(TipoPesquisa: TtecFichaFornecedor);
begin
  case TipoPesquisa of
            tfcFILIAIS: ReFazConsulta(qryFilial,[0],[qryConsultaFiliaiscodigo.AsInteger]);
       tfcGRUPOFILIAIS: ReFazConsulta(qryGrupoFiliais,[0],[qryConsultaGruposFiliaiscodigo.AsInteger]);
       tfcFORNECEDORES: ReFazConsulta(qryFornecedor,[0,1],[qryConsultaFornecedorestipo.AsString,
                                                           qryConsultaFornecedorescodigo.AsInteger]);
  tfcGRUPOFORNECEDORES: ReFazConsulta(qryGruposFornecedores,[0],[qryConsultaGruposFornecedorescodigo.AsInteger]);
       tfcCODIGOFISCAL: ReFazConsulta(qryCFOP,[0],[qryConsultaCFOPcodigo.AsInteger]);
  end;
end;

procedure TdtmFichaFinanceiraFornecedor.SetCFOP(const Value: String);
begin
  if (Value <> '') then
     qryFichaFornecedor.MacroByName('cfop').AsString := 'and (np.codigofiscal = ' + Value + ')'
  else
     qryFichaFornecedor.MacroByName('cfop').AsString := '';
end;

procedure TdtmFichaFinanceiraFornecedor.SetDataFinal(const Value: String);
begin
  if not DataEmBranco(Value) then
       FDataFinal:= Value
  else FDataFinal:= '';
  MontarDataEmissao;
end;

procedure TdtmFichaFinanceiraFornecedor.SetDataInicial(const Value: String);
begin
  if not DataEmBranco(Value) then
       FDataInicial:= Value
  else FDataInicial:= '';
  MontarDataEmissao;
end;

procedure TdtmFichaFinanceiraFornecedor.SetFilial(const Value: String);
begin
  if (Value <> '') then
     qryFichaFornecedor.MacroByName('filial').AsString := 'and (d.filialemissao = ' + Value + ')'
  else
     qryFichaFornecedor.MacroByName('filial').AsString := '';
end;

procedure TdtmFichaFinanceiraFornecedor.SetFornecedor(const Value: String);
begin
  if (Value <> '') then
     qryFichaFornecedor.MacroByName('fornecedor').AsString := 'and (d.fornecedor = ' + Value + ') ' +
                                                     'and (d.tipofornecedor = ' + '''' + qryFornecedortipo.AsString + '''' + ')'
  else
     qryFichaFornecedor.MacroByName('fornecedor').AsString := '';
end;

procedure TdtmFichaFinanceiraFornecedor.SetGrupoFilial(const Value: String);
begin
  if (Value <> '') then
     qryFichaFornecedor.MacroByName('grupofilial').AsString := 'and (d.filialemissao in (Select filial From filiaisgruposfiliais Where grupo = ' + Value + '))'
  else
     qryFichaFornecedor.MacroByName('grupofilial').AsString := '';
end;

procedure TdtmFichaFinanceiraFornecedor.SetGrupoFornecedor(const Value: String);
begin
  if (Value <> '') then
     qryFichaFornecedor.MacroByName('grupofornecedor').AsString := 'and (v.grupofornecedor = ' + Value + ')'
