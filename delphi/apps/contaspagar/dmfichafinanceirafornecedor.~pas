procedure TdtmFichaFinanceiraFornecedor.AbreTabelaPesquisa(TipoPesquisa: TtecFichaFornecedor);
begin
  case TipoPesquisa of
           tfcFILIAIS: Abre(ctConsultaFiliais);
      tfcGRUPOFILIAIS: Abre(ctConsultaGruposFiliais);
      tfcFORNECEDORES: begin
                         qryConsultaFornecedores.Sql[08]:= 'Where (v.codigo = 0)';
                         Abre(ctConsultaFornecedores);
                       end;
 tfcGRUPOFORNECEDORES: Abre(ctConsultaGruposFornecedores);
    tfcCODIGOFISCAL  : Abre(ctConsultaCodigosFiscais);
  end;
end;

constructor TdtmFichaFinanceiraFornecedor.Create(AOwner: TComponent);
begin
  inherited;
  qryFilial.Tag                     := ctTabelas;
  qryGrupoFiliais.Tag               := ctTabelas;
  qryFornecedor.Tag                 := ctTabelas;
  qryGruposFornecedores.Tag         := ctTabelas;
  qryCFOP.Tag                       := ctTabelas;
  qryConsultaFiliais.Tag            := ctConsultaFiliais;
  qryConsultaGruposFiliais.Tag      := ctConsultaGruposFiliais;
  qryConsultaCFOP.Tag               := ctConsultaCodigosFiscais;
  qryConsultaFornecedores.Tag       := ctConsultaFornecedores;
  qryConsultaGruposFornecedores.Tag := ctConsultaGruposFornecedores;
  qryProdutosNotasquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;

end;

function TdtmFichaFinanceiraFornecedor.ExisteCodigosFiscais(Campo, Codigo: String): Boolean;
begin
  Result:= ExisteCodigo(qryConsultaCFOP, Campo, Codigo);
end;

function TdtmFichaFinanceiraFornecedor.ExisteFiliais(Campo, Codigo: string): Boolean;
begin
  Result := ExisteCodigo(qryConsultaFiliais, Campo, Codigo);
end;

function TdtmFichaFinanceiraFornecedor.ExisteFornecedores(Campo, Codigo: string): Boolean;
const
  SQL = 'Where (to_ascii(%s,''latin1'') ilike to_ascii(''%s%s'',''latin1''))';
begin
  if Campo = 'nomecidade' then
    Campo:= 'c.nome'
  else if Campo = 'tipocliente' then
    Campo:= 'v.tipo'
  else
    Campo:= 'v.' + Campo;
  qryConsultaFornecedores.Sql[08] := Format(SQL, [Campo, Codigo, '%']);
  qryConsultaFornecedores.Open;
  Result := qryConsultaFornecedores.RecordCount > 0
end;

function TdtmFichaFinanceiraFornecedor.ExisteGrupoFiliais(Campo, Codigo: String): Boolean;
begin
  Result := ExisteCodigo(qryConsultaGruposFiliais, Campo, Codigo);
end;

function TdtmFichaFinanceiraFornecedor.ExisteGrupoFornecedores(Campo, Codigo: String): Boolean;
begin
  Result := ExisteCodigo(qryConsultaGruposFornecedores, Campo, Codigo);
end;

procedure TdtmFichaFinanceiraFornecedor.FechaTabelaPesquisa(TipoPesquisa: TtecFichaFornecedor);
begin
  case TipoPesquisa of
            tfcFILIAIS: Fecha(ctConsultaFiliais);
       tfcGRUPOFILIAIS: Fecha(ctConsultaGruposFiliais);
       tfcFORNECEDORES: Fecha(ctConsultaFornecedores);
  tfcGRUPOFORNECEDORES: Fecha(ctConsultaGruposFornecedores);
       tfcCODIGOFISCAL: Fecha(ctConsultaCodigosFiscais);
  end;
end;

