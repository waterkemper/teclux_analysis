                           'CodigoMD5',
                           Criptografar(edtCodigoMD5.Text));

    ArquivoCFG.WriteString('Empresa_Desenvolvedora',
                           'LaudoPAFECF',
                           Criptografar(edtLaudoPAF.Text));

    ArquivoCFG.WriteString('Empresa_Desenvolvedora',
                           'DataLaudoPAFECF',
                           Criptografar(edtDataLaudoPAF.Text));

    ArquivoCFG.WriteString('Empresa_Desenvolvedora',
