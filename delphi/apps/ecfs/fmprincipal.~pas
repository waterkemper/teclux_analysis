procedure TfrmPrincipal.gravarECF;
begin
  if trim(edtHost.Text) <> '' then
    if trim(edtBanco.Text) <> '' then
      if trim(edtUsuario.Text) <> '' then
        if trim(edtFilial.Text) <> '' then
          if trim(edtCNIEE.Text) <> '' then
            if cbxTipoECF.ItemIndex >= 0 then // trim(edtTipo.Text) <> '' then
              if cbxMF.ItemIndex >= 0 then // (trim(edtMF.Text) <> '') and ((edtMF.Text='S') or (edtMF.Text='N')) then
                if trim(edtMarca.Text) <> '' then
                  if Trim(edtDescricaoModelo.Text) <> '' then
                  begin
                    Conectar;

                    qryECFs.MacroByName('WHERE').AsString := 'WHERE codigo = NULL';
                    qryECFs.Open;
                    qryECFs.Append;

                    qryECFsProximo.Open;
                    qryECFscodigo.AsInteger := qryECFsProximocodigo.AsInteger;
                    qryECFsProximo.Close;

                    qryECFsfilial.AsString      := FFilial;
                    qryECFsmaquina.AsString     := FNumeroECF;
                    qryECFsintervencao.AsString := FIntervencao;
                    qryECFsserie.AsString       := FSerie;
                    qryECFscniee.AsString       := FCNIEE;
                    qryECFsmodelo.AsInteger     := cbxModelo.ItemIndex;
                    qryECFsmodelodescricao.AsString := FDescricao;
                    qryECFsmarca.AsString       := FMarca;
                    qryECFstipo.AsString        := FTipo;
                    qryECFsmfadicional.AsString := FMF;
                    if FDataSB = 0 then
                      qryECFsdata_sb.AsDateTime   := Now
                    else
                      qryECFsdata_sb.AsDateTime   := FDataSB;
                    qryECFsversao_sb.AsString   := FVersaoSB;
                    qryECFscnpj.AsString        := FCNPJ;
                    qryECFsie.AsString          := FIE;

                    qryECFsgrandetotal.AsString := FGT;
                    qryECFsvendabruta.AsString  := FVendaBruta;
                    qryECFsminas_legal.AsBoolean := ckbMinasLegal.Checked;
                    qryECFscupom_mania.AsBoolean := ckbCupomMania.Checked;
                    qryECFsparaiba_legal.AsBoolean := ckbParaibaLegal.Checked;
                    qryECFsnota_legal_df.AsBoolean := ckbNotaLegalDF.Checked;


                    qryECFs.Post;
                    qryECFs.Close;

                    Desconectar;

                    btnGravarECF.Enabled := False;
                    StatusBar1.Panels[1].Text := 'ECF gravado com sucesso!';
                  end
                  else
                  begin
                    ShowMessage('Informe a DESCRIÇÃO');
                    edtDescricaoModelo.SetFocus;
                  end
                else
                begin
                  ShowMessage('Informe a MARCA');
                  edtMarca.SetFocus;
                end
              else
              begin
                ShowMessage('Informe ''S'' ou ''N'' para a MF adicional');
                cbxMF.SetFocus;
              end
            else
            begin
              ShowMessage('Informe o TIPO');
              cbxTipoECF.SetFocus;
            end
          else
          begin
            ShowMessage('Informe o CNIEE');
            edtCNIEE.SetFocus;
          end
        else
        begin
          ShowMessage('Informe o código da filial');
          edtFilial.SetFocus;
        end
      else
      begin
        ShowMessage('Informe o usuário');
        edtUsuario.SetFocus;
      end
    else
    begin
      ShowMessage('Informe o banco');
      edtBanco.SetFocus;
    end
  else
  begin
    ShowMessage('Informe o endereço do servidor');
    edtHost.SetFocus;
  end
end;

procedure TfrmPrincipal.btnGerarArquivoECFsClick(Sender: TObject);
begin
