procedure TfrmPrincipal.btnAtivarDesativarClick(Sender: TObject);
begin
  if btnAtivarDesativar.Caption = 'Ativar' then
  begin
    try
      ACBrECF1.Porta := cbxPorta.Text;
      ACBrECF1.Device.Baud := strtoint(vVelocidadePorta);

      if cbxModelo.ItemIndex = 0 then
        if not ACBrECF1.AcharECF(true,False) then
        begin
          MessageDlg('Nenhum ECF encontrado.',mtInformation,[mbOk], 0);
          exit;
        end;

      ACBrECF1.Ativar;

      btnAtivarDesativar.Caption := 'Desativar';
      btnGravarECF.Enabled := True;

//      GravarINI;
    finally
      cbxModelo.ItemIndex := Integer(ACBrECF1.Modelo);
      cbxPorta.Text       := ACBrECF1.Porta;
    end;
  end
  else
  begin
    ACBrECF1.Desativar;
    btnAtivarDesativar.Caption := 'Ativar';
    btnGravarECF.Enabled := False;
  end;
  atualizarLabels(True);
end;

