function TfrmPrincipal.Criptografar(Valor: String): String;
var
  I : Byte;
  Str: String;
  Nro: int64;
  StartKey: int64;
begin
  StartKey := 5;
  Result   := '';
  for I := 1 to Length(Valor) do begin
    Result := Result + CHAR(Byte(Valor[I]) xor (StartKey shr 8));
    StartKey := (Byte(Result[I]) + StartKey) * MultKey + AddKey;
  end;
  Str := '';
  for i := 1 to Length(Result) do begin
    Nro := Ord(Result[i]);
    Str := Str + Format('%2.2X', [Nro]);
  end;
  Result := Str;
end;

function TfrmPrincipal.Descriptografar(Valor: String): String;
var
  I : Byte;
  Str: String;
  StartKey: int64;

  function HexToDec(Valor: String): Integer;
  var
    a, Qtde: Integer;
    val: Integer;
  begin
    Result := 0;
    Qtde   := Length(Valor);
    for a := 1 to Qtde do begin
      case Valor[a] of
        '0'..'9': Val := StrToInt(Valor[a]);
        'A','a':  Val := 10;
        'B','b':  Val := 11;
        'C','c':  Val := 12;
        'D','d':  Val := 13;
        'E','e':  Val := 14;
        'F','f':  Val := 15;
      else
        Val := 0;
      end;
      Result := Result + Floor(Power(16, Qtde - a)) * Val;
    end
  end;

begin
  Str := '';
  I := 1;
  while I < Length(Valor) do begin
    Str := Str + Chr(HexToDec(Valor[I] + Valor[I + 1]));
    Inc(I, 2);
  end;
  Valor := Str;
  StartKey := 5;
  Result   := '';
  for I := 1 to Length(Valor) do begin
    Result := Result + CHAR(Byte(Valor[I]) xor (StartKey shr 8));
    StartKey := (Byte(Valor[I]) + StartKey) * MultKey + AddKey;
  end;
end;

