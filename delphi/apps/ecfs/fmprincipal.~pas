procedure TfrmPrincipal.gravarINI;
var
  ArqINI : String ;
  INI    : TIniFile ;
begin
  ArqINI := ChangeFileExt( Application.ExeName,'.ini' ) ;

  INI := TIniFile.Create(ArqINI);
  try
    edtHost.Text    := INI.ReadString('login','host','');
    edtBanco.Text   := INI.ReadString('login','banco','');
    edtFilial.Text  := INI.ReadString('login','filialbase','');
    
{    edtUsuario.Text := 'tecsoft';
    edtSenha.Text   := 'filosofia';
    edtCNIEE.Text   := '381202';
}  finally
     INI.Free ;
  end ;
end;

procedure TfrmPrincipal.lerINI;
var
  ArqINI : String ;
  INI : TIniFile ;

begin
  ArqINI := ExtractFilePath(Application.ExeName) + 'tecsoft.ini';
  INI := TIniFile.Create(ArqINI);
  try
    edtHost.Text    := INI.ReadString('login','host','localhost');
    edtBanco.Text   := INI.ReadString('login','banco','tecsoft');
    edtFilial.Text  := INI.ReadString('login','filialbase','1');
    vVelocidadePorta := INI.ReadString('ecf','VelocidadePorta','9600');
    vPorta := INI.ReadString('login','porta','5432');


  finally
    INI.Free ;
  end ;
end;

