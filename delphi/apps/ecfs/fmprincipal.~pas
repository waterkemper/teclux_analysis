  try
    ArquivoCFG.WriteString('Empresa_Desenvolvedora',
                           'NomeEmpresaDesenvolvedora',
                           Criptografar(edtNomeEmpresa.Text));

    ArquivoCFG.WriteString('Empresa_Desenvolvedora',
                           'CNPJDesenvolvedora',
                           Criptografar(edtCNPJ.Text));

    ArquivoCFG.WriteString('Empresa_Desenvolvedora',
                           'IEDesenvolvedora',
                           Criptografar(edtIE.Text));

    ArquivoCFG.WriteString('Empresa_Desenvolvedora',
                           'IMDesenvolvedora',
