procedure TfrmPrincipal.btnSalvarEmpresaDesenvolvedoraClick(
  Sender: TObject);
begin
  if (edtNomeEmpresa.Text        <> '') and
     (edtCNPJ.Text               <> '') and
     (edtNomeComercialPAFECF.Text<> '') and
     (edtVersaoPAFECF.Text       <> '') and
     (edtCodigoMD5.Text          <> '') and
     (edtLaudoPAF.Text           <> '') and
     (edtEndereco1.Text          <> '') and
     (edtEndereco2.Text          <> '') and
     (edtTelefone.Text           <> '') and
     (edtContato.Text            <> '') and
     (edtNumeroCredenciadora.text <> '') AND
     (edtDataLaudoPAF.DataValida AND not dataembranco(edtDataLaudoPAF.text)) then
  begin
    if FileExists(edtCaminhoArquivo.text) then
      SalvarArquivo
    else
      ShowMessage(Format('O arquivo %s não foi encontrado', [edtCaminhoArquivo.text]));
  end
  else
  begin
    ShowMessage('O dados estão incompletos');
    edtNomeEmpresa.SetFocus;
  end;
end;

