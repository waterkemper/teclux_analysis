end;

procedure TfrmPrincipal.gerarArquivoECFs;
var
  ArqECFs: TIniFile;
  Arq: String;
begin
  Conectar;

  qryECFs.MacroByName('WHERE').AsString := 'WHERE filial = ' + edtFilial.Text;
  qryECFs.Open;

  if not qryECFs.IsEmpty then
  begin
    Arq := ExtractFilePath(Application.ExeName) + 'ECFs.ini';
    if FileExists(Arq) then
      DeleteFile(pchar(Arq));
    ArqECFs := TIniFile.Create(Arq);
    try
      while not qryECFs.Eof do
      begin
        ArqECFs.WriteString(qryECFscodigo.AsString, 'modelo'    , qryECFsmodelo.AsString);
        ArqECFs.WriteString(qryECFscodigo.AsString, 'serie'     , Criptografar(qryECFsserie.AsString));
        ArqECFs.WriteString(qryECFscodigo.AsString, 'maquina'   , Criptografar(qryECFsmaquina.AsString));
        ArqECFs.WriteString(qryECFscodigo.AsString, 'cro'       , Criptografar(qryECFsintervencao.AsString));
        ArqECFs.WriteString(qryECFscodigo.AsString, 'gt'        , Criptografar(qryECFsgrandetotal.AsString));
        ArqECFs.WriteString(qryECFscodigo.AsString, 'vendabruta', Criptografar(qryECFsvendabruta.AsString));
        ArqECFs.WriteString(qryECFscodigo.AsString, 'marca'     , Criptografar(qryECFsmarca.AsString));
        ArqECFs.WriteString(qryECFscodigo.AsString, 'tipo'      , Criptografar(qryECFstipo.AsString));
        ArqECFs.WriteString(qryECFscodigo.AsString, 'MF'        , Criptografar(qryECFsmfadicional.AsString));
        ArqECFs.WriteString(qryECFscodigo.AsString, 'cniee'     , Criptografar(qryECFscniee.AsString));
        ArqECFs.WriteString(qryECFscodigo.AsString, 'SubModelo' , Criptografar(qryECFsmodelodescricao.AsString));
        ArqECFs.WriteString(qryECFscodigo.AsString, 'MinasLegal' ,Criptografar(qryECFsminas_legal.AsString));
        ArqECFs.WriteString(qryECFscodigo.AsString, 'CupomMania' ,Criptografar(qryECFscupom_mania.AsString));
        ArqECFs.WriteString(qryECFscodigo.AsString, 'ParaibaLegal' ,Criptografar(qryECFsparaiba_legal.AsString));
        ArqECFs.WriteString(qryECFscodigo.AsString, 'NotaLegalDF' ,Criptografar(qryECFsnota_legal_df.AsString));

        qryECFs.Next;
      end;
      ArqECFs.UpdateFile;
      StatusBar1.Panels[1].Text := 'Arquivo gerado com sucesso!';
    finally
      ArqECFs.Free;
    end;
  end
  else
    ShowMessage('Nenhum ECF cadastrado');
  qryECFs.Close;

  Desconectar;
end;

