    AfterScroll = qryRomaneiosNotasSaidasAfterScroll
    OnCalcFields = qryRomaneiosNotasSaidasCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select r.*,'
      ''
      
        '       coalesce(vodfc.usuario, co.usuario) as usuarioconferrenci' +
        'a,'
      '          '
      '       (select u.nome'
      '        from usuarios u'
      
        '        where u.codigo = coalesce(vodfc.usuario, co.usuario)) as' +
        ' NomeUsuarioConferencia,'
      '        '
      '       vodfc.datahora_alteracao as DataHoraUsuarioConferencia,'
      '       vodfc.conferido,'
      '       '
      
        '       coalesce(vodfc.filialregistro, co.filial) as filialregist' +
        'ro,'
      
        '       (select f.nome from filiais f where f.codigo = coalesce(v' +
        'odfc.filialregistro, co.filial)) as nomefilialregistro,'
      ''
      
        '       cast(cast(r.nrvolume_ as varchar)||'#39'/'#39'||cast(r.volumes as' +
        ' varchar) as varchar(10)) as volumes_,'
      ''
      
        '       cast(r.chv_nfe||lpad(cast(r.nrvolume_ as VARCHAR), 3, '#39'0'#39 +
        ')||'
      
        '                  lpad(cast(r.volumes as VARCHAR), 3, '#39'0'#39') as va' +
        'rchar(51)) as chv_nfe_volume,'
      ''
      '       false as marcar'
      ''
      ''
      'from'
      '('
      'select rn.romaneio,'
      '       r.emissao, '
      '       r.tipo,'
      '       r.fornecedor,'
      '       f.nome as nomefornecedor,'
      '       r.situacao_romaneio,'
      '      '
      '       vodf.codigo as numerovolume,'
      '       coalesce(nullif(vodf.volumes,0),1) as volumes,'
      
        '       generate_series(1, coalesce(nullif(vodf.volumes,0),1) ) a' +
        's nrvolume_,'
      ''
      '       rn.dadofiscal,'
      '       n.filial as filialnota,'
      '       n.serie,'
      '       n.numero as numeronf,'
      '       df.chv_nfe'
      ''
      ''
      'from romaneios r'
      '     join romaneiosnotas rn'
      '          join dadosfiscais df'
      '               left join volumesdadosfiscais vodf'
      '               on df.numero = vodf.dadofiscal'
      ''
      '               join notas n'
      '               on df.numero = n.dadofiscal'
      ''
      '          on rn.dadofiscal = df.numero'
      '     on r.numero = rn.romaneio'
      ''
      '     join fornecedores f'
      '     on r.fornecedor = f.codigo'
      ''
      'where df.chv_nfe = :chv_nfe'
      ''
      ') as r left join'
      '         conferencia co'
      '             left join volumesdadosfiscaisconferencia vodfc'
      '              on co.tipo = vodfc.tipo'
      '              and co.codigo = vodfc.codigo'
      ''
      '        on cast(r.romaneio as varchar(20)) = co.codigo'
      '         and co.tipo = '#39'ROS'#39
      '         and vodfc.dadofiscal = r.dadofiscal'
      '         and vodfc.numerovolume = r.numerovolume'
      '         and vodfc.nrvolume = r.nrvolume_'
      ''
      ' where lpad(cast(r.nrvolume_ as VARCHAR),3,'#39'0'#39') = :nrvolume'
      '   and lpad(cast(r.volumes as VARCHAR), 3, '#39'0'#39') = :volume'
      ''
      '')
    RequestLive = True
    Active = True
    Left = 88
    Top = 40
    ParamData = <
      item
        DataType = ftString
        Name = 'chv_nfe'
        ParamType = ptUnknown
        Value = #39#39
      end
      item
        DataType = ftString
        Name = 'nrvolume'
        ParamType = ptUnknown
        Value = #39#39
      end
      item
        DataType = ftString
        Name = 'volume'
        ParamType = ptUnknown
        Value = #39#39
      end>
