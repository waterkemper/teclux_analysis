implementation

{$R *.dfm}

constructor TdtmConfirmarRomaneiosSaida.create(AOwner: TComponent);
begin
  inherited;
  RefazConsultaPorNome(qryRomaneiosNotasSaidas,['chv_nfe','nrvolume','volume'],
     ['0','0','0']);

end;

procedure TdtmConfirmarRomaneiosSaida.PesquisarNFeVolume(
  chv_nfevolume: String; RefazerSituacaoRomaneio: Boolean);
var
  vMarcar: Boolean;
begin
  vMarcar := true;

  if not qryRomaneiosNotasSaidas.locate('chv_nfe_volume', chv_nfevolume, []) or RefazerSituacaoRomaneio then
  begin
    RefazConsultaPorNome(qryProcuraRomaneiosNotasSaidas,['chv_nfe','nrvolume','volume'],
        [copy(chv_nfevolume,1,44),
         copy(chv_nfevolume,45,3),
         copy(chv_nfevolume,48,3)]);


    if (qryProcuraRomaneiosNotasSaidas.recordcount = 1) and  (qryProcuraRomaneiosNotasSaidassituacao.asString = 'N')  then
    begin

      if not RefazerSituacaoRomaneio then
      begin
        qryRomaneiosNotasSaidasconferido.OnChange := nil;
        CopiarRegistros(qryProcuraRomaneiosNotasSaidas, qryRomaneiosNotasSaidas);
        qryRomaneiosNotasSaidasconferido.OnChange := qryRomaneiosNotasSaidasconferidoChange;
      end;

      vMarcar := not qryProcuraRomaneiosNotasSaidasconferido.asBoolean or
                (qryProcuraRomaneiosNotasSaidassituacao_romaneio.asString = 'PASSAGEM');
    end
    else
    begin

      vMarcar := false;
      if qryProcuraRomaneiosNotasSaidassituacao.asString = 'N' then
        MensagemAviso('Nfe cancelada!')
      else
        MensagemAviso('Nfe/Volume não encontrado.'+chr(13)+
        'Verifique se a NF esta presente no romaneio, ou se o mesmo já esta em trânsito.');

    end;
  end
  else
   vMarcar := not qryProcuraRomaneiosNotasSaidasconferido.asBoolean;

  if vmarcar and not RefazerSituacaoRomaneio then
  begin
    qryRomaneiosNotasSaidas.edit;
//    qryRomaneiosNotasSaidasmarcar.asBoolean := true;
    qryRomaneiosNotasSaidasconferido.asBoolean := true;

    if (qryRomaneiosNotasSaidas.state in [dsedit, dsinsert]) then
      qryRomaneiosNotasSaidas.post;

  end;

  if RefazerSituacaoRomaneio then
  begin
    qryRomaneiosNotasSaidasconferido.OnChange := nil;
    CopiarRegistros(qryProcuraRomaneiosNotasSaidas, qryRomaneiosNotasSaidas, false, true, true, true, true, true);
    qryRomaneiosNotasSaidasconferido.OnChange := qryRomaneiosNotasSaidasconferidoChange;

    AtribuirDados(qryRomaneiosNotasSaidas,
                  [qryRomaneiosNotasSaidassituacao_romaneio],
                  [qryRomaneiosNotasSaidassituacao_romaneio.asString],
                  [qryRomaneiosNotasSaidasromaneio],
                  [qryRomaneiosNotasSaidasromaneio.asstring],
                  ['='],
                  true);
  end;

end;

procedure TdtmConfirmarRomaneiosSaida.qryRomaneiosNotasSaidasCalcFields(
  DataSet: TDataSet);
begin
  inherited;

  qryRomaneiosNotasSaidasconferidosomenteleitura.asBoolean :=

    not
    ((qryRomaneiosNotasSaidassituacao_romaneio.asString = 'ABERTA') or
     (qryRomaneiosNotasSaidassituacao_romaneio.asString = 'CONFIRMADA PARCIAL') or
     (qryRomaneiosNotasSaidassituacao_romaneio.asString = 'CONFIRMADA'));



{  qryRomaneiosNotasSaidasvolumes_.asString :=

   qryRomaneiosNotasSaidasnrvolume_.asString + '\' +
   qryRomaneiosNotasSaidasvolumes.asString;}

end;

procedure TdtmConfirmarRomaneiosSaida.qryRomaneiosNotasSaidasconferidoChange(
  Sender: TField);
var
  vListaS: tStringList;
begin
  inherited;
  try
    if qryRomaneiosNotasSaidasconferido.readonly then
      qryRomaneiosNotasSaidas.cancel
    else
    begin

      vListaS := tStringList.create;
      vListaS.append(qryRomaneiosNotasSaidasromaneio.asString);

      if qryRomaneiosNotasSaidassituacao_romaneio.asString = 'PASSAGEM' then
        ConferirVolumesDadosFiscais(qryRomaneiosNotasSaidas, qryRomaneiosNotasSaidasromaneio.fieldname,
             qryRomaneiosNotasSaidasdadofiscal.FieldName, 'RPS',
             vListaS,
             qryRomaneiosNotasSaidastipo.asString, true)
      else
        ConferirVolumesDadosFiscais(qryRomaneiosNotasSaidas, qryRomaneiosNotasSaidasromaneio.fieldname,
             qryRomaneiosNotasSaidasdadofiscal.FieldName, 'ROS',
             vListaS,
             qryRomaneiosNotasSaidastipo.asString, true);

      PesquisarNFeVolume(qryRomaneiosNotasSaidaschv_nfe_volume.asString, true);

      qryRomaneiosNotasSaidas.edit;
    end;  


  finally
    vListaS.free;
  end;

end;

procedure TdtmConfirmarRomaneiosSaida.qryRomaneiosNotasSaidasAfterScroll(
  DataSet: TDataSet);
begin
  inherited;
  qryRomaneiosNotasSaidasconferido.readonly :=

    not
    ((qryRomaneiosNotasSaidassituacao_romaneio.asString = 'ABERTA') or
     (qryRomaneiosNotasSaidassituacao_romaneio.asString = 'CONFIRMADA PARCIAL') or
     (qryRomaneiosNotasSaidassituacao_romaneio.asString = 'CONFIRMADA') or
     (qryRomaneiosNotasSaidassituacao_romaneio.asString = 'PASSAGEM') );

end;

function TdtmConfirmarRomaneiosSaida.LiberarEntrega(
  usuario: integer): boolean;
begin
  RefazConsultaPorNome(qryRomaneios, ['numero'],
     [qryRomaneiosNotasSaidasromaneio.asinteger]);

  qryRomaneios.edit;
  qryRomaneiosusuariotransito.asinteger := usuario;
  qryRomaneiosdatahoratransito.asdatetime := DataHoraServidor;
  qryRomaneios.post;
  result := perpetrar([qryRomaneios]);

  if result then
  begin
    qryAtualizarSituacaoRomaneio.parambyname('romaneio').asinteger := qryRomaneiosNotasSaidasromaneio.asinteger;
    qryAtualizarSituacaoRomaneio.execsql;
    PesquisarNFeVolume(qryRomaneiosNotasSaidaschv_nfe_volume.asString, true);

    TfrmPrincipalBasico(Application.MainForm).MostrarFormRegistrado(['Reabrir', qryRomaneiosnumero.asInteger], 'TfrmCadastroRomaneio', True)

  end;

end;

function TdtmConfirmarRomaneiosSaida.ReterEntrega(
  usuario: integer): boolean;
var
  vReadonly : Boolean;
begin


  RefazConsultaPorNome(qryRomaneios, ['numero'],
     [qryRomaneiosNotasSaidasromaneio.asinteger]);

  qryRomaneios.edit;
  qryRomaneiosusuariotransito.clear;
  qryRomaneiosdatahoratransito.clear;
  qryRomaneios.post;
  result := perpetrar([qryRomaneios]);

  if result then
  begin
    qryAtualizarSituacaoRomaneio.parambyname('romaneio').asinteger := qryRomaneiosNotasSaidasromaneio.asinteger;
    qryAtualizarSituacaoRomaneio.execsql;
    PesquisarNFeVolume(qryRomaneiosNotasSaidaschv_nfe_volume.asString, true);

    TfrmPrincipalBasico(Application.MainForm).MostrarFormRegistrado(['Reabrir', qryRomaneiosnumero.asInteger], 'TfrmCadastroRomaneio', True)

  end;


end;

end.
