  object qryConsultaDadosFiscaisNotas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '(SELECT notasromaneios.*,'
      '       df.data,'
      '       f.nome as nomefilialemissao,'
      '       COALESCE(b.frete, re.frete) as codigofrete      '
      'FROM'
      ' (  '
      ' SELECT notas.*, '
      '            cp.maquina,'
      '            cp.intervensao,'
      '            cp.numero as cupom, '
      '           rn.romaneio, r.tipo'
      ' from'
      '  ('
      '   SELECT n.dadofiscal,'
      '               n.filial AS filialemissao,'
      '               n.serie,'
      '               n.numero as nota'
      '   FROM  notas n '
      ''
      '            /*  Condicao filial */'
      '            /*  Condicao Serie */'
      ''
      
        '  ) AS notas LEFT JOIN (romaneiosnotas rn JOIN romaneios r on rn' +
        '.romaneio = r.numero) on notas.dadofiscal=rn.dadofiscal'
      
        '              LEFT JOIN cupons cp on notas.dadofiscal=cp.dadofis' +
        'cal'
      
        ' ) AS notasromaneios join (dadosfiscais df  JOIN (bairros b  LEF' +
        'T JOIN regioes re ON  b.regiao = re.codigo)'
      
        '                                                                ' +
        '   ON df.estado = b.estado and'
      
        '                                                                ' +
        '      df.cidade = b.cidade and'
      
        '                                                                ' +
        '      df.bairro = b.codigo)'
      
        '                                           on notasromaneios.dad' +
        'ofiscal = df.numero   '
      
        '                     join filiais f on notasromaneios.filialemis' +
        'sao = f.codigo'
      ''
      ' where  case when not :SomenteNFComItensdeEntrega then true else'
      ''
      '          exists (select pdf.produto'
      '               from ProdutosDadosFiscais pdf'
      
        '               where pdf.dadofiscal=notasromaneios.dadofiscal an' +
        'd pdf.entregar)'
      ''
      '        end'
      ''
      '               and'
      
        '       ((notasromaneios.romaneio is null or (notasromaneios.roma' +
        'neio is not null and'
      
        '                                                            nota' +
        'sromaneios.tipo='#39'T'#39' and'
      
        '                                                            not ' +
        'exists (select rn2.dadofiscal from (romaneiosnotas rn2 join roma' +
        'neios r2 on rn2.romaneio = r2.numero)'
      
        '                                                                ' +
        '            where rn2.dadofiscal = notasromaneios.dadofiscal and' +
        ' r2.tipo = '#39'N'#39') ))  or'
      '        (notasromaneios.dadofiscal=:dadofiscal)'
      ''
      
        '        /* editado em runtime  or (n.dadofiscal in (select rn.da' +
        'dofiscal from romaneionotas rn where rn.numero=:romaneio and (rn' +
        '.dadofiscal<>) ...))   */'
      ''
      '       )'
      ''
      '       /* editado em runtime dadofiscal ja cadastrado */'
      ''
      ' order by nota, filialemissao,serie'
      ')')
    RequestLive = False
    Left = 431
    Top = 435
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'SomenteNFComItensdeEntrega'
        ParamType = ptUnknown
      end
