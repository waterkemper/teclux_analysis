  object qryNotasRomaneio: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftString
        Name = 'VerdadeiroouFalso'
        ParamType = ptUnknown
        Value = 'and false and'
      end
      item
        DataType = ftUnknown
        Name = 'PeriodoDataEntrega'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListaFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListaCondicionalClientes'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'SELECT notasromaneios.*,'
      
        '       cast(cast(tf.codigo as varchar(15))||cast('#39' - '#39' as varcha' +
        'r(3))||cast(tf.descricao as varchar(30)) as varchar(48)) as codi' +
        'godescricaofrete,'
      '       tf.valorfornecedor,'
      '       cast(null as varchar(100)) as observacao,'
      '       cast(null as date) as entrega,'
      '       cast(null as numeric(11,2)) as valor,'
      '       false as selecionarregistro,'
      '       ROW_NUMBER () OVER (ORDER BY notasromaneios.dadofiscal)'
      ''
      'FROM'
      ' ('
      ''
      '   select df.*,'
      '          cp.maquina,'
      '          cp.intervensao,'
      '          cp.numero as cupom'
      '   from'
      '  ('
      ''
      '    select df.*,'
      '           n.filial AS filialemissao,'
      '           n.serie,'
      '           n.numero as nota'
      '    from'
      ''
      '   ('
      '     select df.numero as dadofiscal,'
      '            df.data,'
      '            df.cliente,'
      '            df.tipocliente,'
      '            df.chv_nfe,'
      '            df.data_hora_recebimento,'
      '            coalesce(vf.razao,vf.nome) as nomecliente,'
      '            f.nome as nomefilialemissao,'
      '            COALESCE(b.frete, re.frete) as codigofrete,'
      '            df.rua,'
      '            b.nome as nomebairro'
      ''
      '     from dadosfiscais df'
      ''
      '           join vfornecedores vf'
      '           on df.cliente = vf.codigo'
      '           and df.tipocliente = vf.tipo'
      ''
      '            join filiais f'
      '            on df.filialemissao = f.codigo'
      ''
      '             JOIN (bairros b'
      '                   LEFT JOIN regioes re'
      '                   ON  b.regiao = re.codigo)'
      ''
      '             ON df.estado = b.estado and'
      '                df.cidade = b.cidade and'
      '                df.bairro = b.codigo'
      ''
      '     where true'
      ''
      '        %VerdadeiroouFalso'
      ''
      '        df.data between :datainicial and :datafinal'
      ''
      '        %PeriodoDataEntrega'
      '        %ListaFiliais'
      '        %ListaCondicionalClientes'
      ''
      '        and'
      '        case when not :SomenteNFComItensdeEntrega then true else'
      ''
      '                   exists (select pdf.produto'
      '                   from ProdutosDadosFiscais pdf'
      
        '                   where pdf.dadofiscal=df.numero and pdf.entreg' +
        'ar)'
      ''
      '        end'
      ''
      ''
      '        and not exists'
      ''
      '            (select rn.romaneio'
      '             from romaneiosnotas rn'
      '                  JOIN romaneios r'
      '                  on rn.romaneio=r.numero'
      '             where rn.dadofiscal=df.numero limit 1)'
      ''
      '   ) as df left join notas n on df.dadofiscal = n.dadofiscal'
      '  ) as df LEFT JOIN cupons cp on df.dadofiscal = cp.dadofiscal'
      ''
      ''
      ' ) AS notasromaneios'
      '   left join tabeladefretes tf'
      '   on  tf.codigo = notasromaneios.codigofrete'
      ''
      ''
      '/*'
      ''
      'dataInicialEntrega :dataInicialEntrega'
      ''
      'dataFinalEntrega :dataFinalEntrega'
      ''
      '*/'
      '')
    RequestLive = True
    Left = 616
    Top = 384
    ParamData = <
      item
        DataType = ftString
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SomenteNFComItensdeEntrega'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'dataInicialEntrega'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'dataFinalEntrega'
        ParamType = ptUnknown
      end>
