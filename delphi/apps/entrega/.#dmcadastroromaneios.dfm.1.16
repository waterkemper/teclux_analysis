  object qryValorEntrada: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryValorEntradaCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select '
      
        ' (select sum(rn.valor) from romaneiosnotas rn where rn.romaneio=' +
        ':romaneio and not rn.cancelado and rn.entrega is not null) as va' +
        'lorentregue,'
      
        ' (select sum(rn.valor) from romaneiosnotas rn where rn.romaneio=' +
        ':romaneio and not rn.cancelado and rn.entrega is null) as  valor' +
        'aentregar'
      'from romaneiosnotas rn'
      'where rn.romaneio=:romaneio')
    RequestLive = False
    Left = 48
    Top = 276
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'romaneio'
        ParamType = ptUnknown
      end>
