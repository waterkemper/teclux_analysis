  object qryConsultaDadosFiscaisCupons: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '(SELECT cuponsromaneios.*,'
      '       df.data,'
      '       f.nome as nomefilialemissao,'
      '       COALESCE(b.frete, re.frete) as codigofrete      '
      'FROM'
      ' (  '
      ' SELECT cupons.*, '
      '             n.serie,'
      '             n.numero as nota,'
      '             rn.romaneio, r.tipo'
      ' from'
      '  ('
      '   SELECT cp.dadofiscal,'
      '               cp.filial AS filialemissao,'
      '               cp.maquina,'
      '               cp.intervensao,'
      '               cp.numero as cupom'
      '   FROM  cupons cp '
      '            /*  Condicao filial */'
      '            /*  Condicao maquina */'
      '            /* Condicao intervensao */'
      
        '  ) AS cupons LEFT JOIN (romaneiosnotas rn JOIN romaneios r on r' +
        'n.romaneio = r.numero) on cupons.dadofiscal=rn.dadofiscal'
      
        '              LEFT JOIN notas n on cupons.dadofiscal=n.dadofisca' +
        'l'
      
        ' ) AS cuponsromaneios join (dadosfiscais df  JOIN (bairros b  LE' +
        'FT JOIN regioes re ON  b.regiao = re.codigo)'
      
        '                                                                ' +
        '   ON df.estado = b.estado and'
      
        '                                                                ' +
        '      df.cidade = b.cidade and'
      
        '                                                                ' +
        '      df.bairro = b.codigo)'
      
        '                                           on cuponsromaneios.da' +
        'dofiscal = df.numero   '
      
        '                     join filiais f on cuponsromaneios.filialemi' +
        'ssao = f.codigo'
      ' where case when not :SomenteNFComItensdeEntrega then true else'
      '        exists (select pdf.produto'
      '               from ProdutosDadosFiscais pdf'
      
        '               where pdf.dadofiscal=cuponsromaneios.dadofiscal a' +
        'nd pdf.entregar)'
      '       end'
      ''
      ''
      '       and'
      
        '       ((cuponsromaneios.romaneio is null or (cuponsromaneios.ro' +
        'maneio is not null and '
      
        '                                                            cupo' +
        'nsromaneios.tipo='#39'T'#39' and '
      
        '                                                            not ' +
        'exists (select rn2.dadofiscal from (romaneiosnotas rn2 join roma' +
        'neios r2 on rn2.romaneio = r2.numero)'
      
        '                                                                ' +
        '            where rn2.dadofiscal = cuponsromaneios.dadofiscal an' +
        'd r2.tipo = '#39'N'#39') ))  or'
      '        (cuponsromaneios.dadofiscal=:dadofiscal)'
      ''
      
        '        /* editado em runtime  or (cuponsromaneios.dadofiscal in' +
        ' (select rn.dadofiscal from romaneionotas rn where rn.numero=:ro' +
        'maneio and (rn.dadofiscal<>) ...))   */'
      ''
      '       )'
      ''
      '       /* editado em runtime dadofiscal ja cadastrado */'
      ''
      ' order by cupom'
      ')')
    RequestLive = False
    Left = 431
    Top = 499
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'SomenteNFComItensdeEntrega'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'dadofiscal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'romaneio'
        ParamType = ptUnknown
      end>
