  object qryProcuraDadosFiscaisCupons: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '(SELECT cuponsromaneios.*,'
      '       df.data, df.data_hora_recebimento,'
      '       f.nome as nomefilialemissao,'
      '       COALESCE(b.frete, re.frete) as codigofrete,'
      '       coalesce(vf.razao,vf.nome) as nomecliente,'
      '       vf.codigo as cliente,'
      '       vf.tipo as tipocliente,'
      '       df.valorfrete,'
      ''
      '       cast((select sum(coalesce(vdf.volumes,1))'
      '        from volumesdadosfiscais vdf'
      
        '        where vdf.dadofiscal = df.numero) as numeric) as volumes' +
        ','
      '       '
      ''
      
        '       case when vf.tipo<>'#39'C'#39' then cast(cast(vf.codigo as varcha' +
        'r(19))||vf.tipo as varchar(20))'
      '         else cast(vf.codigo as varchar(20)) end as clienteT'
      ''
      'FROM'
      ' (  '
      ' SELECT cupons.*, '
      '             n.serie,'
      '             n.numero as nota,'
      ''
      '             (select rn.romaneio '
      '              from romaneiosnotas rn'
      '                   JOIN romaneios r'
      '                   on rn.romaneio = r.numero'
      '              where rn.dadofiscal = cupons.dadofiscal'
      '                /*and r.tipo = '#39'N'#39'*/'
      
        '                and rn.justificativa_entrega is null) as romanei' +
        'o,'
      ''
      '              false as ehnotafiscalsaidatransferencia'
      ' from'
      '  ('
      '   SELECT cp.dadofiscal,'
      '               cp.filial AS filialemissao,'
      '               cp.maquina,'
      '               cp.intervensao,'
      '               cp.numero as cupom'
      '   FROM  cupons cp '
      '   WHERE  cp.filial=:filial and'
      '                cp.maquina=:maquina and'
      '                cp.intervensao=:intervensao and '
      '                cp.numero=:numero'
      
        '  ) AS cupons LEFT JOIN notas n on cupons.dadofiscal=n.dadofisca' +
        'l'
      
        ' ) AS cuponsromaneios join ((dadosfiscais df  JOIN (bairros b  L' +
        'EFT JOIN regioes re ON  b.regiao = re.codigo)'
      
        '                                                                ' +
        '   ON df.estado = b.estado and'
      
        '                                                                ' +
        '      df.cidade = b.cidade and'
      
        '                                                                ' +
        '      df.bairro = b.codigo)'
      
        '                                                               J' +
        'OIN vfornecedores vf on vf.codigo = df.cliente and'
      
        '                                                                ' +
        '                             vf.tipo = df.tipocliente)'
      
        '                                           on cuponsromaneios.da' +
        'dofiscal = df.numero'
      
        '                     join filiais f on cuponsromaneios.filialemi' +
        'ssao = f.codigo'
      ''
      ' where case when not :SomenteNFComItensdeEntrega then true else'
      ''
      '               exists (select pdf.produto'
      '               from ProdutosDadosFiscais pdf'
      
        '               where pdf.dadofiscal=cuponsromaneios.dadofiscal a' +
        'nd pdf.entregar)'
      ''
      '       end'
      ')')
    RequestLive = False
    Left = 55
    Top = 498
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'maquina'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'intervensao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'numero'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SomenteNFComItensdeEntrega'
        ParamType = ptUnknown
      end>
