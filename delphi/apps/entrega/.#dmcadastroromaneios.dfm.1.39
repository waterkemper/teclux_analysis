  object qryProdutosDadosFiscais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterScroll = qryProdutosDadosFiscaisAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select pdf.*,'
      
        '         cast(p.descricao||'#39' '#39'||coalesce(p.valorgrade1,'#39#39')||'#39' '#39'|' +
        '|coalesce(p.valorgrade2,'#39#39') as varchar) as produto,'
      '         m.descricao as marca, p.referencia'
      'from'
      '('
      'select pdf.dadofiscal, '
      '         pdf.numero as numeroitemnota,'
      '         pdf.produto as codigoproduto,'
      '         pdf.quantidade'
      'from produtosdadosfiscais pdf '
      'where pdf.dadofiscal = :dadofiscal'
      '         and pdf.entregar'
      
        ') as pdf  JOIN (produtos p left join (caracteristicas ca left jo' +
        'in marcas m on ca.marca=m.codigo)'
      
        '                                                                ' +
        '                                         on p.caracteristica=ca.' +
        'codigo)'
      
        '                                                                ' +
        ' on pdf.codigoproduto = p.codigo'
      'order by dadofiscal, numeroitemnota')
    RequestLive = False
    Left = 624
    Top = 259
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'dadofiscal'
        ParamType = ptUnknown
      end>
    object qryProdutosDadosFiscaisnumeroitemnota: TIntegerField
      FieldName = 'numeroitemnota'
      DisplayFormat = '0'
    end
    object qryProdutosDadosFiscaiscodigoproduto: TLargeintField
      FieldName = 'codigoproduto'
    end
    object qryProdutosDadosFiscaisquantidade: TFloatField
      FieldName = 'quantidade'
      DisplayFormat = '0'
    end
    object qryProdutosDadosFiscaisproduto: TStringField
      DisplayWidth = 62
      FieldName = 'produto'
      Size = 162
    end
    object qryProdutosDadosFiscaismarca: TStringField
      FieldName = 'marca'
      Size = 15
    end
    object qryProdutosDadosFiscaisdadofiscal: TIntegerField
      FieldName = 'dadofiscal'
      DisplayFormat = '0'
    end
    object qryProdutosDadosFiscaisreferencia: TStringField
      FieldName = 'referencia'
      Size = 15
    end
  end
