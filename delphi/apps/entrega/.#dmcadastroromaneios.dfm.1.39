  object qryProcuraDadosFiscaisNotas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '('
      'SELECT notasromaneios.*,'
      '       df.data,'
      '       df.rua,'
      '       b.nome as nomebairro,'
      '       f.nome as nomefilialemissao,'
      '       COALESCE(b.frete, re.frete) as codigofrete,'
      '       (select tf.valorfornecedor'
      '        from tabeladefretes tf'
      
        '        where tf.codigo = COALESCE(b.frete, re.frete)) as valorf' +
        'ornecedor,'
      '       coalesce(vf.razao,vf.nome) as nomecliente,'
      '       df.cliente,'
      '       df.tipocliente,'
      '       df.data_hora_recebimento,'
      '       df.valorfrete,'
      ''
      '       cast((select sum(coalesce(vdf.volumes,1))'
      '        from volumesdadosfiscais vdf'
      
        '        where vdf.dadofiscal = df.numero) as numeric) as volumes' +
        ','
      ''
      ''
      
        '       case when df.tipocliente<>'#39'C'#39' then cast(cast(df.cliente a' +
        's varchar(19))||df.tipocliente as varchar(20))'
      '         else cast(df.cliente as varchar(20)) end as clienteT'
      ''
      'FROM'
      ' (  '
      ' SELECT notas.*, '
      '            cp.maquina,'
      '            cp.intervensao,'
      '            cp.numero as cupom,'
      ''
      '            (select max(rn.romaneio)'
      '             from romaneiosnotas rn'
      '                  JOIN romaneios r'
      '                  on rn.romaneio=r.numero'
      '             where rn.dadofiscal=notas.dadofiscal'
      
        '               and rn.justificativa_entrega is null ) as romanei' +
        'o  /* Os usu'#225'rios j'#225' cadastraram duplicados...por isso o max */'
      ' from'
      '  ('
      '   SELECT n.dadofiscal,'
      '               n.filial AS filialemissao,'
      '               n.serie,'
      '               n.numero as nota,'
      '               df.chv_nfe,'
      '               ehnotafiscalsaidatransferencia(df.codigofiscal)'
      ''
      '   FROM  notas n'
      '         join dadosfiscais df'
      '         on n.dadofiscal = df.numero'
      ''
      '   WHERE  case when coalesce(:filial,'#39'0'#39') <> '#39'0'#39' and'
      '                    coalesce(:serie,'#39#39') <> '#39#39' and'
      '                    coalesce(:numero,'#39'0'#39') <> '#39'0'#39' then'
      ''
      '                 n.filial = :filial and'
      '                 n.serie  = :serie and'
      '                 n.numero = :numero'
      ''
      '               when :chv_nfe is not null then'
      '                df.chv_nfe = :chv_nfe'
      '               else false'
      '          end'
      ''
      
        '  ) AS notas LEFT JOIN cupons cp on notas.dadofiscal=cp.dadofisc' +
        'al'
      ''
      
        ' ) AS notasromaneios join ((dadosfiscais df  JOIN (bairros b  LE' +
        'FT JOIN regioes re ON  b.regiao = re.codigo)'
      
        '                                                                ' +
        '   ON df.estado = b.estado and'
      
        '                                                                ' +
        '      df.cidade = b.cidade and'
      
        '                                                                ' +
        '      df.bairro = b.codigo)'
      
        '                                                             JOI' +
        'N vfornecedores vf on vf.codigo=df.cliente and'
      
        '                                                                ' +
        '                                   vf.tipo = df.tipocliente)'
      
        '                                           on notasromaneios.dad' +
        'ofiscal = df.numero   '
      
        '                     join filiais f on notasromaneios.filialemis' +
        'sao = f.codigo'
      ' where case when not :SomenteNFComItensdeEntrega then true else'
      ''
      '               exists (select pdf.produto'
      '               from ProdutosDadosFiscais pdf'
      
        '               where pdf.dadofiscal=notasromaneios.dadofiscal an' +
        'd pdf.entregar)'
      ''
      '       end'
      ')')
    RequestLive = False
    Left = 63
    Top = 434
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'serie'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'numero'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'chv_nfe'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SomenteNFComItensdeEntrega'
        ParamType = ptUnknown
      end>
