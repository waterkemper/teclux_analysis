    Sql.Strings = (
      'Select   romaneios.numero,'
      
        '         cast(to_char(emissao, '#39'dd/mm/yyyy'#39') as varchar) as emis' +
        'sao,'
      '         fornecedores.razao,'
      '         romaneios.tipo,'
      '         romaneios.situacao_romaneio'
      'From romaneios, fornecedores'
      'where romaneios.fornecedor=fornecedores.codigo'
      'Order By  numero')
