  object qryAtualizarAgendamentoProdutosContratos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'SQLRNDF'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'update produtosdadosfiscais set dataentrega = rndf.dataentrega,'
      '                                horaentrega = rndf.horaentrega'
      'from'
      ''
      '('
      '  select pdf.dadofiscal,'
      '         pdf.numero,'
      '         pdf.produto,'
      '         rndf.dataentrega,'
      '         rndf.horaentrega'
      ''
      '  from dadosfiscais df'
      '       join produtosdadosfiscais pdf'
      '       on df.numero = pdf.dadofiscal'
      ''
      '       join'
      '       ('
      ''
      '        %SQLRNDF'
      ''
      '       ) as rndf'
      '       on df.numero = rndf.dadofiscal'
      ''
      '  where coalesce(pdf.entregar,false)'
      ''
      '    and  ((pdf.quantidade -'
      '           coalesce((select sum(ctd.quantidade)'
      '                     from contratosdevolvidos ctd'
      '                     where ctd.contrato = df.contrato'
      '                       and ctd.produto = pdf.produto'
      '                       and ctd.situacao = '#39'N'#39'),0) ) > 0)'
      ''
      ''
      ''
      ') as rndf'
      ''
      'where produtosdadosfiscais.dadofiscal = rndf.dadofiscal'
      '  and produtosdadosfiscais.numero = rndf.numero'
      '  and produtosdadosfiscais.produto = rndf.produto'
      ''
      ''
      ''
      ''
      '')
    RequestLive = True
    Left = 784
    Top = 280
  end
  object qryMovimentosRomaneioDadoFiscal: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select  '
      '        n.filial, n.serie, n.numero,'
      '        df.chv_nfe,'
      '        '
      '        vdfc.volume, vdfc.conferido, '
      ''
      '       case when vdfc.tipo = '#39'ROS'#39' then '#39'SA'#205'DA'#39
      '             when vdfc.tipo = '#39'ROP'#39' then '#39'PASSAGEM'#39' '
      '             when vdfc.tipo = '#39'ROE'#39' then '#39'ENTRADA'#39'  '
      '        end as descricaotipo,          '
      ''
      '        vdfc.usuario, u.nome as nomeusuario,'
      '        vdfc.filialregistro, f.nome as nomefilial,'
      '        vdfc.datahora_alteracao '
      '        '
      '        '
      'from volumesdadosfiscaisconferencia vdfc'
      '     join dadosfiscais df'
      '          join notas n'
      '          on df.numero = n.dadofiscal'
      '     on vdfc.dadofiscal = df.numero '
      '     '
      '     join conferencia c         '
      '     on vdfc.tipo = c.tipo'
      '     and vdfc.codigo = c.codigo'
      '     '
      '     '
      '     left join usuarios u'
      '     on vdfc.usuario = u.codigo'
      '          '
      '     left join filiais f'
      '     on vdfc.filialregistro = f.codigo'
      '       '
      'where vdfc.tipo in ('#39'ROS'#39','#39'ROP'#39', '#39'ROE'#39')'
      'AND vdfc.codigo = :romaneio'
      'and vdfc.dadofiscal = :dadofiscal'
      'order by vdfc.datahora_alteracao')
    RequestLive = False
    Left = 800
    Top = 376
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'romaneio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'dadofiscal'
        ParamType = ptUnknown
      end>
  end
  object dsrMovimentosRomaneioDadoFiscal: TtecDataSource
    DataSet = qryMovimentosRomaneioDadoFiscal
    Left = 816
    Top = 392
  end
