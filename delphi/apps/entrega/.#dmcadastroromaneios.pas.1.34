procedure TdtmCadastroRomaneios.FiltrarNotasCuponsRomaneios;
const
  SQLDFStr = ' and (%s)';
  SQLRStr1 =  'or (df.numero in '+
              '(select rn.dadofiscal '+
              'from romaneiosnotas rn '+
              'where rn.romaneio=:romaneio and (%s)))';
  SQLRStr2 =  'or (df.numero in '+
              '(select rn.dadofiscal '+
              'from romaneiosnotas rn '+
              'where rn.romaneio=:romaneio))';
var
  SQLDFN, SQLDFC, SQLR: String;
  a: Integer;
begin
  inherited;
  for a := 0 to High(aNotaCupomRomaneio) do
  begin
   SQLDFN:= SQLDFN + '(notasromaneios.dadofiscal <> ' + aNotaCupomRomaneio[a].Dadofiscal +') and ';
   SQLDFC:= SQLDFC + '(cuponsromaneios.dadofiscal <> ' + aNotaCupomRomaneio[a].Dadofiscal +') and ';
   SQLR := SQLR + '(rn.dadofiscal <> ' + aNotaCupomRomaneio[a].Dadofiscal +') and ';
  end;
  // não seleciona dadofiscal ja cadastrado
  if SQLDFN = '' then
  begin
    qryConsultaDadosFiscaisNotas.Sql[50]     := '';
    qryConsultaDadosFiscaisCupons.Sql[47]     := '';
  end
  else
  begin
    Delete(SQLDFN, Length(SQLDFN)-4, 5);
    Delete(SQLDFC, Length(SQLDFC)-4, 5);
    qryConsultaDadosFiscaisNotas.Sql[50]     := Format(SQLDFStr, [SQLDFN]);
    qryConsultaDadosFiscaisCupons.Sql[47]     := Format(SQLDFStr, [SQLDFC]);
  end;

  // se não for inclusão
  if (NumeroRomaneio<>0) then
  begin
   if SQLR = '' then   // se não tiver dadosfiscais cadastrados
   begin
    qryConsultaDadosFiscaisNotas.Sql[46] := SQLRStr2;
    qryConsultaDadosFiscaisCupons.Sql[43] := SQLRStr2;
   end
   else
   begin
    Delete(SQLR, Length(SQLR)-4, 5);
    qryConsultaDadosFiscaisNotas.Sql[46] := Format(SQLRStr1, [SQLR]);
    qryConsultaDadosFiscaisCupons.Sql[43] := Format(SQLRStr1, [SQLR]);
   end;
   qryConsultaDadosFiscaisNotas.ParamByName('romaneio').AsInteger := NumeroRomaneio;
   qryConsultaDadosFiscaisCupons.ParamByName('romaneio').AsInteger := NumeroRomaneio;
  end;
end;

procedure TdtmCadastroRomaneios.LerNotasCuponsIncluidos(Incluindo: Boolean);
var
  Pos: TBookmark;
  a, DadoFiscal: Integer;
begin
  inherited;
  qryItensRomaneio.DisableControls;
  Pos := qryItensRomaneio.GetBookmark;
  try
    a := 0;
    aNotaCupomRomaneio := nil;
    DadoFiscal   := qryItensRomaneiodadofiscal.AsInteger;
    qryConsultaDadosFiscaisNotas.ParamByName('dadofiscal').AsInteger:=DadoFiscal;
    qryConsultaDadosFiscaisCupons.ParamByName('dadofiscal').AsInteger:=DadoFiscal;
    qryItensRomaneio.First;
    while Not qryItensRomaneio.Eof do
    begin
      if Incluindo or (qryItensRomaneiodadofiscal.AsInteger<>DadoFiscal) then
      begin
       SetLength(anotaCupomRomaneio, a + 1);
       aNotaCupomRomaneio[a].DadoFiscal   := qryItensRomaneiodadofiscal.AsString;
       aNotaCupomRomaneio[a].FilialEmissao:= qryItensRomaneiofilialemissao.AsString;
       aNotaCupomRomaneio[a].Nota         := qryItensRomaneionumero_nf.AsString;
       aNotaCupomRomaneio[a].chv_nfe      := qryItensRomaneiochv_nfe.AsString;
       aNotaCupomRomaneio[a].Serie        := qryItensRomaneioserie.AsString;
       aNotaCupomRomaneio[a].Maquina      := qryItensRomaneiomaquina.AsString;
       aNotaCupomRomaneio[a].Intervensao  := qryItensRomaneiointervensao.AsString;
       aNotaCupomRomaneio[a].Cupom        := qryItensRomaneionumero_cupom.AsString;
       aNotaCupomRomaneio[a].Cancelado    := qryItensRomaneiocancelado.AsBoolean;
       Inc(a);
      end;
      qryItensRomaneio.Next;
    end;
  finally
    qryItensRomaneio.GotoBookmark(Pos);
    qryItensRomaneio.FreeBookmark(Pos);
    qryItensRomaneio.EnableControls;
  end;
  FiltrarNotasCuponsRomaneios
end;

function TdtmCadastroRomaneios.NotaExistenteRomaneioAtual(Filial, Serie, Numero, chv_nfe: String): Boolean;
var
  a: Integer;
begin
 Result := False;
 for a := 0 to High(aNotaCupomRomaneio) do
  if ((Filial=aNotaCupomRomaneio[a].FilialEmissao) and
      (Serie=aNotaCupomRomaneio[a].Serie) and
      (Numero=aNotaCupomRomaneio[a].Nota)) or
     (chv_nfe=aNotaCupomRomaneio[a].chv_nfe) then
    Result := True;
end;

function TdtmCadastroRomaneios.ValidaNotaRomaneio(Filial, Serie, Numero, chv_nfe,
  Romaneio: String): Boolean;
begin
   result := VerificarTipoRomaneio(qryProcuraDadosFiscaisNotasehnotafiscalsaidatransferencia.asBoolean);

   if result then
   begin
     if (qryRomaneiostipo.asString = 'T') and
        (qryItensRomaneioFilialEmissao_oldvalue<>0) and
        (qryItensRomaneioFilialEmissao_oldvalue <> qryProcuraDadosFiscaisNotasfilialemissao.AsInteger) then
     begin
       MensagemAviso('A NF não pode ser de uma filial diferente pois é um romaneio de Transferência.');
       result := False;
     end
     else
     if (qryRomaneiostipo.asString = 'T') and
        (qryItensRomaneioCliente_oldvalue<>'') and
        (qryItensRomaneioCliente_oldvalue <> qryProcuraDadosFiscaisNotasclientet.AsString) then
     begin
       MensagemAviso('A NF não pode ser para destinos diferentes pois é um romaneio de Transferência.');
       result := False;
     end
     else
     if (Romaneio<>'') and (strtoint(Romaneio)<>NumeroRomaneio) then
     begin
       MensagemAviso(format(ctNOTAEXISTENTE, ['no Romaneio '+Romaneio]));
       result := False ;
     end
     else
     begin
       if NotaExistenteRomaneioAtual(Filial, Serie, Numero, chv_nfe) then
       begin
         if (qryItensRomaneio.state in [dsinsert, dsedit]) then
           qryItensRomaneio.cancel;

         if (Filial <> '0') and
            (Serie  <> '') and
            (Numero <> '0') then
           qryItensRomaneio.Locate('filialemissao;serie;numero_nf', VarArrayOf([Filial, Serie, Numero]), [])
         else
         if (chv_nfe<>'') then
           qryItensRomaneio.Locate('chv_nfe', chv_nfe, []);

         MensagemAviso(format(ctNOTAEXISTENTE, ['no Romaneio atual']));
         result := False ;
       end;
     end;
   end;

end;

function TdtmCadastroRomaneios.ValidaCupomRomaneio(Filial, Maquina,
  Intervensao, Numero, Romaneio: String): Boolean;
begin

  result := VerificarTipoRomaneio(qryProcuraDadosFiscaisCuponsehnotafiscalsaidatransferencia.asBoolean);

  if result then
  begin

    if (qryRomaneiostipo.asString = 'T') and
       (qryItensRomaneioFilialEmissao_oldvalue<>0) and
       (qryItensRomaneioFilialEmissao_oldvalue <> qryProcuraDadosFiscaisCuponsfilialemissao.AsInteger) then
    begin
      MensagemAviso('A NF não pode ser de uma filial diferente pois é um romaneio de Transferência.');
      result := False;
    end
    else
    if (qryRomaneiostipo.asString = 'T') and
       (qryItensRomaneioCliente_oldvalue<>'') and
       (qryItensRomaneioCliente_oldvalue <> qryProcuraDadosFiscaisCuponsClienteT.AsString) then
    begin
      MensagemAviso('A NF não pode ser de uma filial diferente pois é um romaneio de Transferência.');
      result := False;
    end
    else
    if (Romaneio<>'') and (strtoint(Romaneio)<>NumeroRomaneio) then
    begin
      MensagemAviso(format(ctCUPOMEXISTENTE, ['no Romaneio '+Romaneio]));
      result := False ;
    end
    else
    begin
      if CupomExistenteRomaneioAtual(Filial, Maquina, Intervensao, Numero) then
      begin
        MensagemAviso(format(ctCUPOMEXISTENTE, ['no Romaneio atual']));
        result := False ;
      end;
    end;
  end;
end;

function TdtmCadastroRomaneios.CupomExistenteRomaneioAtual(Filial, Maquina,
  Intervensao, Numero: String): Boolean;
var
  a: Integer;
begin
 Result := False;
 for a := 0 to High(aNotaCupomRomaneio) do
  if (Filial=aNotaCupomRomaneio[a].FilialEmissao) and
     (Maquina=aNotaCupomRomaneio[a].Maquina) and
     (Intervensao=aNotaCupomRomaneio[a].Intervensao) and
     (Numero=aNotaCupomRomaneio[a].Cupom) then
    Result := True;
end;

function TdtmCadastroRomaneios.CupomFiscalAlterado(FilialEmissao, ECF,
  Intervensao, NumeroCupom: String): Boolean;
begin
Result := False;
if (FilialEmissao<>FilialEmissaoCupom_Atual) or
             (ECF<>Maquina_Atual) or
     (Intervensao<>Intervensao_Atual) or
     (NumeroCupom<>Cupom_Atual) then
     Result := True;
end;

function TdtmCadastroRomaneios.NotaFiscalAlterada(FilialEmissao, Serie,
  NumeroNota, chv_nfe: String): boolean;
begin
  Result := False;
  if (FilialEmissao <> FilialEmissaoNota_Atual) or
             (Serie <> Serie_Atual) or
        (NumeroNota <> Nota_Atual) or
           (chv_nfe <> chv_nfe_Atual) then
   Result := True;

end;

