procedure TdtmCadastroRomaneios.SetParametroSerie(const Value: String);
begin
  FParametroSerie := Value;
  if value<>'' then
  begin
   if (FParametrofilialEmissaoNota<>'') then
    qryConsultaDadosFiscaisNotas.Sql[20]:=' and n.serie = '+quotedstr(value)
   else
    qryConsultaDadosFiscaisNotas.Sql[20]:=' where n.serie = '+quotedstr(value);
  end
  else
   qryConsultaDadosFiscaisNotas.Sql[20]:='';
end;

function TdtmCadastroRomaneios.AtualizaItensRomaneiosNotas(FilialEmissao,
  Serie, NumeroNota, chv_nfe: String): boolean;
begin
  Result :=false;
  if ((FilialEmissao<>'') and (Serie<>'') and (NumeroNota<>'')) or (somentenumero(chv_nfe)<>'') then
  begin
    RefazConsulta(qryProcuraDadosFiscaisNotas,[0,1,2,3,4],
        [FilialEmissao,Serie,NumeroNota,somentenumero(chv_nfe), SomenteNFComItensdeEntrega]);

    if qryProcuraDadosFiscaisNotas.recordcount = 0 then
    begin
      biblio.PlaySound(nil);
      MensagemAviso('A nota fiscal não foi encontrada.')
    end

  end
  else
    RefazConsulta(qryProcuraDadosFiscaisNotas,[],[]);

  if not qryProcuraDadosFiscaisNotas.IsEmpty then
  begin
    if ValidaNotaRomaneio(FilialEmissao,
                          Serie,
                          NumeroNota,
                          chv_nfe,
                          qryProcuraDadosFiscaisNotasromaneio.AsString) then
    begin
      ItensRomaneiodadofiscal           := qryProcuraDadosFiscaisNotasdadofiscal.asstring;
      if not (qryItensRomaneio.State in [dsedit]) then
        if (qryProcuraDadosFiscaisNotascodigofrete.Value<>0) then
          ItensRomaneioTipodeFrete        := qryProcuraDadosFiscaisNotascodigofrete.Value;
      ItensRomaneioFiliais              := qryProcuraDadosFiscaisNotasfilialemissao.asstring;
      ItensRomaneioserie                := qryProcuraDadosFiscaisNotasserie.Value;
      ItensRomaneioNota                 := qryProcuraDadosFiscaisNotasnota.asstring;
      ItensRomaneiochv_nfe              := qryProcuraDadosFiscaisNotaschv_nfe.AsString;
      ItensRomaneioCupom                := qryProcuraDadosFiscaisNotascupom.AsString;
      ItensRomaneiomaquina              := qryProcuraDadosFiscaisNotasmaquina.AsString;
      ItensRomaneiointervensao          := qryProcuraDadosFiscaisNotasintervensao.AsString;
      qryItensRomaneiodataemissao.Value := qryProcuraDadosFiscaisNotasdata.Value;
      qryItensRomaneionomefilial.Value  := qryProcuraDadosFiscaisNotasnomefilialemissao.Value;
      qryItensRomaneiovalor.value       := qryProcuraDadosFiscaisNotasvalorfrete.value;


      if qryProcuraDadosFiscaisNotastipocliente.AsString<>'C' then
        qryItensRomaneiocliente.asstring := qryProcuraDadosFiscaisNotascliente.AsString+
                                            qryProcuraDadosFiscaisNotastipocliente.AsString
      else
        qryItensRomaneiocliente.asstring := qryProcuraDadosFiscaisNotascliente.AsString;

      qryItensRomaneionomecliente.asstring := qryProcuraDadosFiscaisNotasnomecliente.AsString;
//      qryItensRomaneiodata_hora_recebimento.asVariant := qryProcuraDadosFiscaisNotasdata_hora_recebimento.asVariant;


      Entrega_Anterior                  := qryItensRomaneioentrega.AsString;
      FilialEmissaoNota_Atual           := ItensRomaneioFiliais;
      Serie_Atual                       := ItensRomaneioSerie;
      Nota_Atual                        := ItensRomaneioNota;
      chv_nfe_Atual                     := ItensRomaneiochv_nfe; {*+}
      FilialEmissaoCupom_Atual          := ItensRomaneioFiliais;
      Maquina_Atual                     := ItensRomaneioMaquina;
      Intervensao_Atual                 := ItensRomaneioIntervensao;
      Cupom_Atual                       := ItensRomaneioCupom;
      qryItensRomaneiovolumes.AsInteger := qryProcuraDadosFiscaisNotasvolumes.asinteger;

      Result := True;
    end;
  end
  else
    MensagemAviso(ctNOTANAOENCONTRADA);
end;

