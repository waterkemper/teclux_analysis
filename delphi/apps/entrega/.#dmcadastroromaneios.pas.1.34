procedure TdtmCadastroRomaneios.qryItensRomaneioBeforeInsert(
  DataSet: TDataSet);
begin
  inherited;

//  qryItensRomaneioentrega_oldvalue :=  qryItensRomaneioentrega.asDateTime;
  qryItensRomaneiocodigofrete_oldvalue := qryItensRomaneiocodigofrete.asinteger;
  qryItensRomaneiovalorfornecedor_oldvalue := qryItensRomaneiovalorfornecedor.asCurrency;
  qryItensRomaneiovalor_oldvalue := qryItensRomaneiovalor.AsCurrency;
  qryItensRomaneioobservacao_oldvalue := qryItensRomaneioobservacao.AsString;

  qryItensRomaneioFilialEmissao_oldvalue := qryItensRomaneiofilialemissao.asInteger;
  qryItensRomaneioCliente_oldvalue := qryItensRomaneiocliente.asString;


end;

procedure TdtmCadastroRomaneios.LocalizarNfe(chv_nfe: String);
var
  vFilial, vSerie, vNumeroNFE : String;

  procedure MarcarNotasRomaneios;
  begin
    if not qryNotasRomaneioselecionarregistro.AsBoolean then
    begin
      qryNotasRomaneio.edit;
      qryNotasRomaneioselecionarregistro.AsBoolean := true;
      qryNotasRomaneio.post;
    end;
  end;

begin
//  LerNotasCuponsIncluidos(true);
  if not qryNotasRomaneio.Locate('chv_nfe', chv_nfe, []) then
  begin

    RefazConsulta(qryProcuraDadosFiscaisNotas,[0,1,2,3],['0','','0',chv_nfe]);

    if not qryProcuraDadosFiscaisNotas.IsEmpty then
    begin

      if not qryNotasRomaneio.Active then
      begin
        qryNotasRomaneio.MacroByName('VerdadeiroouFalso').asString := ' and false and ';
        qryNotasRomaneio.open;
      end;

      if ValidaNotaRomaneioConsulta(qryProcuraDadosFiscaisNotasdadofiscal.AsString,
                            qryProcuraDadosFiscaisNotasromaneio.AsString) then
      begin
        if qryNotasRomaneio.Locate('chv_nfe', chv_nfe, []) then
          MarcarNotasRomaneios
        else
        begin

          vFilial    := ValorCampodaTabela('filiais', ['cnpj'], [(copy(chv_nfe,7,14))], ['codigo'])[0];
          vSerie     := copy(chv_nfe,23,3);
          vNumeroNFE := copy(chv_nfe,26,9);

          if (MensagemConfirmacao(
                format('A NFe da Filial ''%s'' Série %s Número %s não esta contida nesta lista selecionada. Deseja adicioná-la?',
                       [vFilial,vSerie,vNumeroNFE])) =  smbOK) then
          begin
            qryNotasRomaneio.Append;
            qryNotasRomaneioselecionarregistro.AsBoolean := true;
            qryNotasRomaneiodadofiscal.AsInteger        := qryProcuraDadosFiscaisNotasdadofiscal.AsInteger;
            qryNotasRomaneiodata.AsDateTime             := qryProcuraDadosFiscaisNotasdata.AsDateTime;
            qryNotasRomaneiocliente.AsInteger           := qryProcuraDadosFiscaisNotascliente.AsInteger;
            qryNotasRomaneiotipocliente.asString        := qryProcuraDadosFiscaisNotastipocliente.asString;
            qryNotasRomaneionomecliente.AsString        := qryProcuraDadosFiscaisNotasnomecliente.AsString;
            qryNotasRomaneionomefilialemissao.AsString := qryProcuraDadosFiscaisNotasnomefilialemissao.asString;

            if qryProcuraDadosFiscaisNotascodigofrete.AsInteger <> 0 then
              qryNotasRomaneiocodigofrete.AsInteger       := qryProcuraDadosFiscaisNotascodigofrete.AsInteger;

            qryNotasRomaneiofilialemissao.AsInteger     := qryProcuraDadosFiscaisNotasfilialemissao.AsInteger;
            qryNotasRomaneioserie.AsString              := qryProcuraDadosFiscaisNotasserie.asString;
            qryNotasRomaneionota.AsInteger              := qryProcuraDadosFiscaisNotasnota.AsInteger;

            qryNotasRomaneiorua.AsString :=  qryProcuraDadosFiscaisNotasrua.AsString;
            qryNotasRomaneionomebairro.AsString := qryProcuraDadosFiscaisNotasnomebairro.AsString;


  //          qryNotasRomaneiomaquina          := TIntegerField;
  //          qryNotasRomaneiointervensao      := TIntegerField;
  //          qryNotasRomaneiocupom            := TIntegerField;

            qryNotasRomaneiovalorfornecedor.AsCurrency  := qryProcuraDadosFiscaisNotasvalorfornecedor.AsCurrency;

            qryNotasRomaneiochv_nfe.AsString            := qryProcuraDadosFiscaisNotaschv_nfe.AsString;
  //          qryNotasRomaneioobservacao.AsString         := ;
  //          qryNotasRomaneioentrega.AsDateTime          := ;
  //          qryNotasRomaneiovalor.AsCurrency            := ;

            qryNotasRomaneio.post;

          end;
        end;

      end;
    end
    else
      MensagemAviso(ctNOTANAOENCONTRADA);
  end
  else
    MarcarNotasRomaneios;
end;

function TdtmCadastroRomaneios.ValidaNotaRomaneioConsulta(DadoFiscal,
  Romaneio: String): Boolean;
begin
   result := True ;

   if (qryRomaneiostipo.asString = 'T') and
      (qryItensRomaneioFilialEmissao_oldvalue<>0) and
      (qryItensRomaneioFilialEmissao_oldvalue <> qryItensRomaneioFilialEmissao.AsInteger) then
   begin
     MensagemAviso('A NF não pode ser de uma filial diferente pois é um romaneio de Transferência.');
     result := False;
   end
   else
   if (qryRomaneiostipo.asString = 'T') and
      (qryItensRomaneioCliente_oldvalue<>'') and
      (qryItensRomaneioCliente_oldvalue <> qryItensRomaneioCliente.AsString) then
   begin
     MensagemAviso('A NF não pode ser para um destino diferente pois é um romaneio de Transferência.');
     result := False;
   end
   else
   if (Romaneio<>'') and (strtoint(Romaneio)<>NumeroRomaneio) then
   begin
     MensagemAviso(format(ctNOTAEXISTENTE, ['no Romaneio '+Romaneio]));
     result := False ;
   end
   else
   begin
     if qryItensRomaneio.Locate('dadofiscal', DadoFiscal, []) then
     begin
       MensagemAviso(format(ctNOTAEXISTENTE, ['no Romaneio atual']));
       result := False ;
     end;

   end;

end;

procedure TdtmCadastroRomaneios.qryRomaneiosNewRecord(DataSet: TDataSet);
begin
  inherited;
  qryRomaneiossituacao_romaneio.asString := 'ABERTA';
  qryRomaneiostipo.asString := 'N';
//  qryRomaneiosdescricaosituacao.asString := 'ABERTA';
//  qryRomaneiosdescrsitromentrada.asString := 'NÃO CONFIRMADA';
end;

procedure TdtmCadastroRomaneios.dsrNotasRomaneioDataChange(Sender: TObject;
  Field: TField);
begin
  inherited;
  if field = qryNotasRomaneioselecionarregistro then
  begin
    if (qryRomaneiostipo.asString = 'T') then
    begin

      if ((qryItensRomaneioFilialEmissao_oldvalue <> 0) and
          (qryNotasRomaneiofilialemissao.asinteger <>
           qryItensRomaneioFilialEmissao_oldvalue)) or

         ((qryNotasRomaneiofilialemissao_oldvalue <> 0) and
          (qryNotasRomaneiofilialemissao.asinteger <>
           qryNotasRomaneiofilialemissao_oldvalue)) then

      begin
        if field.asBoolean then
        begin
          MensagemAviso('A NF não pode ser de uma filial diferente pois é um romaneio de Transferência.');
          dsrNotasRomaneio.onDataChange := nil;
          field.asboolean := false;
          dsrNotasRomaneio.onDataChange := dsrNotasRomaneioDataChange;
        end
        else
        begin
          dec(qtNotasRomaneiofilialemissao_oldvalue);
          if qtNotasRomaneiofilialemissao_oldvalue = 0 then
            qryNotasRomaneiofilialemissao_oldvalue := 0;
        end;
      end
      else
      begin
        qryNotasRomaneiofilialemissao_oldvalue := qryNotasRomaneiofilialemissao.asinteger;
        inc(qtNotasRomaneiofilialemissao_oldvalue);
      end;

      if ((qryItensRomaneioCliente_oldvalue <> '') and
          (qryNotasRomaneioClienteT.asString <>
           qryItensRomaneioCliente_oldvalue)) or

         ((qryNotasRomaneioCliente_oldvalue <> '') and
          (qryNotasRomaneioClienteT.asString <>
           qryNotasRomaneioCliente_oldvalue)) then

      begin
        if field.asBoolean then
        begin
          MensagemAviso('A NF não pode ser para um destino diferente pois é um romaneio de Transferência.');
          dsrNotasRomaneio.onDataChange := nil;
          field.asboolean := false;
          dsrNotasRomaneio.onDataChange := dsrNotasRomaneioDataChange;
        end
        else
        begin
          dec(qtNotasRomaneioCliente_oldvalue);
          if qtNotasRomaneioCliente_oldvalue = 0 then
            qryNotasRomaneioCliente_oldvalue := '';
        end;
      end
      else
      begin
        qryNotasRomaneioCliente_oldvalue := qryNotasRomaneioClienteT.asString;
        inc(qtNotasRomaneioCliente_oldvalue);
      end;
    end;
  end;
end;

procedure TdtmCadastroRomaneios.qryItensRomaneioAfterOpen(
  DataSet: TDataSet);
begin
  inherited;
  qryItensRomaneioFilialEmissao_oldvalue := qryItensRomaneiofilialemissao.asInteger;

  cdsItensRomaneio.close;
  cdsItensRomaneio.open;
end;

procedure TdtmCadastroRomaneios.qryItensRomaneioBeforePost(
  DataSet: TDataSet);
begin
  inherited;
  if qryItensRomaneio.state = dsinsert then
  begin
    qryRomaneios.edit;
//    qryRomaneiosdescricaosituacao.asString := 'ABERTA';
  end;
end;

procedure TdtmCadastroRomaneios.RefazConsultaRomaneio(Numero: Integer);
begin
  RefazConsultaPorNome(qryRomaneios, ['numero'], [Numero]);
end;

Function TdtmCadastroRomaneios.VerificarTipoRomaneio(
  ehnotafiscalsaidatransferencia: Boolean): Boolean;
begin
  result := True;

  if ehnotafiscalsaidatransferencia then
  begin
    if qryRomaneiostipo.asString = 'N' then
      if qryItensRomaneio.recordcount = 0 then
      begin
        qryRomaneios.edit;
        qryRomaneiostipo.asString := 'T';
      end
      else
      begin
        result := False;
        MensagemAviso('O romaneio já esta definido como tipo Normal e a nota selecionada é do tipo Transferência.' + chr(13) +
                      'Selecione a nota de acordo com o tipo.');
      end;
  end
  else
  begin
    if qryRomaneiostipo.asString = 'T' then
      if qryItensRomaneio.recordcount = 0 then
      begin
        qryRomaneios.edit;
        qryRomaneiostipo.asString := 'N';
      end
      else
      begin
        result := False;
        MensagemAviso('O romaneio já esta definido como tipo Transferência e a nota selecionada é do tipo Normal.' + chr(13) +
                      'Selecione a nota de acordo com o tipo.');
      end;
  end;
end;

procedure TdtmCadastroRomaneios.AtualizarSituacaoRomaneio;
begin
  qryAtualizarSituacaoRomaneio.parambyname('romaneio').asinteger := qryRomaneiosnumero.asinteger;
  qryAtualizarSituacaoRomaneio.execsql;
end;

function TdtmCadastroRomaneios.LiberarEntrega(usuario: integer): Boolean;
var
  vReadonly : Boolean;
begin
  vReadonly := qryRomaneios.readonly;
  if vReadonly then
    qryRomaneios.readonly := false;


  qryRomaneios.edit;
  qryRomaneiosusuariotransito.asinteger := usuario;
  qryRomaneiosdatahoratransito.asdatetime := DataHoraServidor;
  qryRomaneios.post;
  result := perpetrar([qryRomaneios]);
  if result then
    AtualizarSituacaoRomaneio;

  if vReadonly then
    qryRomaneios.readonly := true;

end;

procedure TdtmCadastroRomaneios.dsrItensRomaneioDataChange(Sender: TObject;
  Field: TField);
begin
  inherited;
  if (field = qryItensRomaneiodata_hora_recebimento) then
  begin
    if field.value < dtmCadastroRomaneios.qryRomaneiosdatahoratransito.asDatetime then
      field.value := dtmCadastroRomaneios.qryRomaneiosdatahoratransito.asDatetime;
      
    if qryItensRomaneio.state = dsedit then
      qryItensRomaneioentrega.asDateTime := DataHoraServidor;
  end;

end;

procedure TdtmCadastroRomaneios.ReabrirRomaneio;
begin
  RefazConsultaRomaneio(qryRomaneiosnumero.asinteger);
end;

function TdtmCadastroRomaneios.GetClienteDadofiscal: integer;
begin
  if not qryItensRomaneiocliente.isnull then
    fClienteDadoFiscal := strtoint(somentenumero(qryItensRomaneiocliente.asString));
  Result := fClienteDadoFiscal;
end;

function TdtmCadastroRomaneios.GetTipoClienteDadofiscal: string;
begin

  if not qryItensRomaneiocliente.isnull then
  begin
    if PossuiSomenteNumero(qryItensRomaneiocliente.asString) then
      fTipoClienteDadoFiscal := 'C'
    else
      fTipoClienteDadoFiscal := copy(qryItensRomaneiocliente.asString,
                                     length(qryItensRomaneiocliente.asString), 1);
  end;
  Result := fTipoClienteDadoFiscal;
end;

function TdtmCadastroRomaneios.PermiteExcluirItens: Boolean;
begin
  result := (qryItensRomaneiosituacao_romaneio_saida.asString = 'ABERTA');
end;

function TdtmCadastroRomaneios.PermiteExcluirDocumento: boolean;
begin
  result := (qryRomaneiossituacao_romaneio.asString = 'ABERTA');
end;

function TdtmCadastroRomaneios.PermiteAlterarItens: Boolean;
begin
  result := NOT (qryRomaneiossituacao_romaneio.asString = 'FECHADA');

end;

function TdtmCadastroRomaneios.ReterEntrega(usuario: integer): boolean;
var
  vReadonly : Boolean;
begin
  vReadonly := qryRomaneios.readonly;
  if vReadonly then
    qryRomaneios.readonly := false;


  qryRomaneios.edit;
  qryRomaneiosusuariotransito.clear;
  qryRomaneiosdatahoratransito.clear;
  qryRomaneios.post;
  result := perpetrar([qryRomaneios]);
  if result then
    AtualizarSituacaoRomaneio;

  if vReadonly then
    qryRomaneios.readonly := true;

end;

end.


