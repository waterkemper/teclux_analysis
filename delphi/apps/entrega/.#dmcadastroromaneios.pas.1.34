    qryItensRomaneio.Edit;
  qryItensRomaneiocodigofrete.AsInteger := Value

end;

procedure TdtmCadastroRomaneios.SetRomaneiofornecedor(
  const Value: integer);
begin
  if Not (qryRomaneios.State in [dsInsert, dsEdit]) then
    qryRomaneios.Edit;
  qryRomaneiosfornecedor.AsInteger := Value

end;

procedure TdtmCadastroRomaneios.qryRomaneiosAfterScroll(DataSet: TDataSet);
begin
  RefazConsulta(qryItensRomaneio, [0], [qryRomaneiosnumero.AsVariant]);
  
  ReFazConsulta(qryValorEntrada,[0], [qryRomaneiosnumero.AsVariant]);
  ReFazConsultaPorNome(qryDuplicatasRomaneios,['documentopag'], [qryRomaneiosdocumentopag.asVariant]);
  EdicaoCampos(not PermiteAlterarDocumento);

end;

function TdtmCadastroRomaneios.GetNumeroRomaneio: Integer;
begin
  Result:= qryRomaneiosnumero.AsInteger;
end;

procedure TdtmCadastroRomaneios.AtualizarCampos;
begin
  ReFazConsulta(qryValorEntrada,[0], [NumeroRomaneio]);
end;

function TdtmCadastroRomaneios.CancelarRomaneios: boolean;
begin
  result := CancelarAtualizacoes([qryitensRomaneio,qryRomaneios])
end;

procedure TdtmCadastroRomaneios.ImprimirRelatorio;
const
  SQLItensNotas = 'where pdf.dadofiscal in (%s)';
var
  Relatorio: TfrReport;
  frmPreview: TfrmPreviewPadrao;
  RegistroAtual: TBookMark;

begin
  qryItensRomaneio.DisableControls;
  RegistroAtual := qryItensRomaneio.GetBookmark;
  frVariables['Rua']   := RuaFilialBase;
  frVariables['Bairro']:= BairroFilialBase + ' - CEP: ' + CEPFilialBase;
  frVariables['Cidade']:= CidadeFilialBase + ' - ' + EstadoFilialBase;
  frVariables['Fone']  := FoneFilialBase;
  frmPreview := TfrmPreviewPadrao.create(self);
  try
   Relatorio := frmPreview.frCompositeReport;
   frmPreview.frCompositeReport.Reports.Clear;
   with frmPreview do
   begin
     case TipodeRelatorio of
      0: begin
          frVariables['Titulo']:= 'ROMANEIO DE TRANSPORTE';
//          frpImprimirRomaneios.DesignReport;
          frCompositeReport.Reports.Add(frpImprimirRomaneios)

         end;
      1: begin
          LerNotasCuponsIncluidos(True);
          qryProdutosDadosFiscais.Sql[10]:=format(SQLItensNotas, [DadosFiscaisdoRomaneio]);
          ReFazConsulta(qryProdutosDadosFiscais,[],[]);
          frVariables['Titulo']:= 'ITENS DE NOTAS DO ROMANEIO';
//          frpImprimirItensRomaneios.DesignReport;
          frCompositeReport.Reports.Add(frpImprimirItensRomaneios)
         end;
     end;
   end;
   Relatorio.Preview := frmPreview.frPreviewPadrao;
   Relatorio.DoublePass:=True;
   Relatorio.ShowReport;
   frmPreview.ShowModal;
  finally
   frmPreview.Free
  end;
  qryItensRomaneio.GotoBookmark(RegistroAtual);
  qryItensRomaneio.FreeBookmark(RegistroAtual);
  qryItensRomaneio.enableControls;
end;

procedure TdtmCadastroRomaneios.CancelarPagamentoRomaneios;
begin
 EdicaoCampos(false);
 if not (qryRomaneios.State in [dsinsert, dsedit]) then
   qryRomaneios.Edit;
 qryRomaneiosdatapagto.AsString:='';
 qryRomaneiosvalorpagto.Value  :=0;
end;

{
procedure TdtmCadastroRomaneios.EntregarRomaneios(dataentrega: string);
begin

with qryItensRomaneio do
 begin
  DisableControls;
  try
   First;
   while not Eof do
   begin
     if (qryItensRomaneioentrega.AsString='') and
       not (qryItensRomaneiocancelado.Value) then
     begin

       if not (qryRomaneios.State in [dsedit, dsinsert]) then
         qryRomaneios.Edit;

       Edit;
       qryItensRomaneioentrega.AsString:=dataentrega;
       Post;
       
     end;
     Next;
   end;

  finally
     EnableControls
  end;
 end;
end;
}

function TdtmCadastroRomaneios.PermiteAlterarDocumento: Boolean;
begin
  result := (qryRomaneiossituacao_romaneio.asString = 'ABERTA') or
            (qryRomaneiossituacao_romaneio.asString = 'CONFIRMADA PARCIAL') or
            (qryRomaneiossituacao_romaneio.asString = 'CONFIRMADA') or
            (qryRomaneiossituacao_romaneio.asString = 'PASSAGEM');

  {
  result := (qryRomaneiosdatapagto.AsString='');
  if result then
    result := (qryRomaneiosdescrsitromentrada.asString = 'NÃO CONFIRMADA');
    }
end;

procedure TdtmCadastroRomaneios.EdicaoCampos(Bloquear: Boolean);
var
  i: integer;
begin
 SetReadOnlyFields(qryRomaneios, false);
// SetReadOnlyFields(qryItensRomaneio, false);

 qryRomaneios.ReadOnly       := bloquear;
// qryitensRomaneio.ReadOnly   := bloquear;
 qryRomaneiostipo.readonly := (qryitensRomaneio.recordcount<>0);
 qryItensRomaneioAfterScroll(qryItensRomaneio);

 {
 if qryitensRomaneio.ReadOnly and (qryRomaneiostipo.asString = 'N') and
    ((qryRomaneiossituacao_romaneio.asString = 'EM TRÂNSITO') or
     (qryRomaneiossituacao_romaneio.asString = 'ENTREGUE PARCIAL')) then
 begin

   qryRomaneios.ReadOnly       := false;
   SetReadOnlyFields(qryRomaneios, True);

   qryitensRomaneio.ReadOnly   := false;
   SetReadOnlyFields(qryitensRomaneio, True);
   qryitensRomaneio.fieldbyname('data_hora_recebimento').readonly := false;
 end;
 }

end;

procedure TdtmCadastroRomaneios.qryRomaneiosAfterOpen(DataSet: TDataSet);
begin
  inherited;
