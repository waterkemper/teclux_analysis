function TdtmCadastroRomaneios.GravarRomaneios: boolean;
var
  vNumeroDocumentoPag : integer;
  vHouveAlteracaodata_hora_recebimento: Boolean;
  vHouveAlteracaojustificativa_entrega: Boolean;
  vHouveAlteracaoMotivoEntrega: Boolean;

  UsuarioAut: TtecUsuarios;
  vAuxDataHora : TDateTime;
  vIncluindo : Boolean;

  vSQLRNDF : String;

begin
  result := qryRomaneios.CheckRequiredFields;
  if result  then
  begin
   if qryitensRomaneio.IsEmpty then
   begin
    result:=false;
    MensagemAviso(format(ctITEMNAOCADASTRADO, ['Romaneio']));
    exit;
   end;

   if result then
   begin
     try
//       EditandoJustificativa := true;

//       qryRomaneios.AfterOpen := nil;
//       qryRomaneios.AfterScroll := nil;

       if qryRomaneios.State = dsinsert then
       begin
        spcRomaneioProximoCodigo.Open;
        qryRomaneiosnumero.Value:=spcRomaneioProximoCodigonumero.Value;
        spcRomaneioProximoCodigo.Close;
        vIncluindo := true;
       end;

       try

         qryItensRomaneio.DisableControls;
         qryItensRomaneio.First;
         vHouveAlteracaodata_hora_recebimento := false;
         vHouveAlteracaojustificativa_entrega := false;
         vHouveAlteracaoMotivoEntrega         := false;

         vSQLRNDF := '';


         while not qryItensRomaneio.Eof do
         begin
           if qryItensRomaneioromaneio.Value <> qryRomaneiosnumero.Value then
           begin
             qryItensRomaneio.Edit;
             qryItensRomaneioromaneio.Value:=qryRomaneiosnumero.Value;
             qryItensRomaneio.Post;
           end;

           vHouveAlteracaodata_hora_recebimento := vHouveAlteracaodata_hora_recebimento or
             (qryItensRomaneiodata_hora_recebimento.value <>
              qryItensRomaneioaux_data_hora_recebimento.value);

           vHouveAlteracaojustificativa_entrega  := vHouveAlteracaojustificativa_entrega or
             (qryItensRomaneiojustificativa_entrega.value <>
              qryItensRomaneioauxjustificativa_entrega.value);

           vHouveAlteracaoMotivoEntrega := vHouveAlteracaoMotivoEntrega or
             (qryItensRomaneiomotivoentrega.value <>
              qryItensRomaneioauxmotivoentrega.value);

           if (qryItensRomaneiodataentrega.value <> qryItensRomaneioauxdataentrega.value) or
              (qryItensRomaneiohoraentrega.value <> qryItensRomaneioauxhoraentrega.value) then
           begin
             if vSQLRNDF<> '' then
               vSQLRNDF := vSQLRNDF + chr(13) + ' union all '+ chr(13);

             vSQLRNDF := vSQLRNDF + ' select '+qryItensRomaneiodadofiscal.asString+' as dadofiscal, cast('+
                                               quotedstr(FormatDateTime('yyyy-MM-dd', qryItensRomaneiodataentrega.asDateTime))+ ' as date) as dataentrega, cast('+
                                               quotedstr(FormatDateTime('HH:mm:ss', qryItensRomaneiohoraentrega.asDateTime))+ 'as time) as horaentrega ';
           end;

           qryItensRomaneio.Next;
         end;

       finally
         qryItensRomaneio.EnableControls;
       end;

//       qryAtualizarDadosFiscais.sql.clear;

       if vSQLRNDF <> '' then
       begin
         qryAtualizarAgendamentoProdutosContratos.MacroByName('SQLRNDF').asString := vSQLRNDF;
         qryAtualizarAgendamentoProdutosContratos.ExecSql;

       end;

       if vHouveAlteracaodata_hora_recebimento or
          vHouveAlteracaojustificativa_entrega or
          vHouveAlteracaoMotivoEntrega then
       begin
         UsuarioAut := dtmCadastroRomaneios.ObterAutorizacao(taLOGIN, 'CONFIRMAÇÃO DA HORA DA ENTREGA', ctAUTORIZADO);
         try
           if Assigned(UsuarioAut) then
           begin
             result := true;
             vAuxDataHora := DataHoraServidor;
             qryItensRomaneio.First;
             while not qryItensRomaneio.Eof do
             begin

               if (qryItensRomaneiodata_hora_recebimento.value <>  qryItensRomaneioaux_data_hora_recebimento.value) or
                  (qryItensRomaneiojustificativa_entrega.value <>  qryItensRomaneioauxjustificativa_entrega.value) or
                  (qryItensRomaneiomotivoentrega.value <> qryItensRomaneioauxmotivoentrega.value) then
               begin

                 qryItensRomaneio.edit;
                 qryItensRomaneiousuario_data_hora_recebimento.asinteger := UsuarioAut.CodigoUsuario;
                 qryItensRomaneioentrega.asDateTime := vAuxDataHora;
                 qryItensRomaneionome_usuario_data_hora_recebimento.asString := UsuarioAut.NomeUsuario;
                 qryItensRomaneio.post;

                 {
                 if qryItensRomaneiodata_hora_recebimento.isnull then

                   qryAtualizarDadosFiscais.sql.append(format(' update dadosfiscais set data_hora_recebimento = Null '+
                                                              ' where numero = %s ;',
                                                              [qryItensRomaneiodadofiscal.asString]))

                 else
                   qryAtualizarDadosFiscais.sql.append(format(' update dadosfiscais set data_hora_recebimento = %s '+
                                                              ' where numero = %s ;',
                                                              [quotedstr(
                                                               FormatDateTime('yyyy-MM-dd',qryItensRomaneiodata_hora_recebimento.asDateTime)+
                                                               'T'+
                                                               FormatDateTime('hh:mm:ss',qryItensRomaneiodata_hora_recebimento.asDateTime)
                                                               ),
                                                               qryItensRomaneiodadofiscal.asString]));
                 }

               end;

               {
               if (qryItensRomaneiojustificativa_entrega.value <>  qryItensRomaneioauxjustificativa_entrega.value) then
               begin

                 qryItensRomaneio.edit;
                 qryItensRomaneiousuario_data_hora_recebimento.asinteger := UsuarioAut.CodigoUsuario;
                 qryItensRomaneioentrega.asDateTime := vAuxDataHora;
                 qryItensRomaneionome_usuario_data_hora_recebimento.asString := UsuarioAut.NomeUsuario;
                 qryItensRomaneio.post;

               end;
               }

               qryItensRomaneio.Next;
             end;
           end
           else
           begin
             MensagemAviso(Format(ctUSUARIOSEMCADASTRO, ['']));
             result := false;
           end;
         finally
          if Assigned(UsuarioAut) then
            UsuarioAut.Free;
         end;
       end;

       if result then
       begin
       {
         if qryAtualizarDadosFiscais.Sql.Text<>'' then
           qryAtualizarDadosFiscais.execsql;
           }

         qryRomaneios.Post;
         Result:= Perpetrar([qryRomaneios, qryItensRomaneio, qryAtualizarAgendamentoProdutosContratos {, qryAtualizarDadosFiscais}], AguardareTerminarDentroDm );
         AtualizarCampos();


         vNumeroDocumentoPag := qryRomaneiosdocumentopag.asinteger;
         if result then
         begin
           AtualizarSituacaoRomaneio;

           if parsistema.IncluirDocumentoaPagarnoRomaneio then
             if qryValorEntradavalorvencimento.ascurrency = 0 then
             begin
               qryRomaneios.edit;
               qryRomaneiosdocumentopag.clear;
               qryRomaneios.post;
             end;

           result := perpetrar([qryRomaneios,qryItensRomaneio, qryAtualizarAgendamentoProdutosContratos {, qryAtualizarDadosFiscais}]);
         end;


         if result then
         begin
           if parsistema.IncluirDocumentoaPagarnoRomaneio then
             case IncluirDocumentosPag(self, Romaneios, vNumeroDocumentoPag,
                  [qryRomaneios, qryValorEntrada, qryItensRomaneio]) of

               ErroGravacao   : MensagemAviso('Ocorreu um erro de gravação ao cadastrar o ''Contas a Pagar''.');
               DuplicataPaga : MensagemAviso('O documento a pagar vinculado a este romaneio esta quitado e não será atualizado.');
               ok : begin
                      Result:= Perpetrar([qryRomaneios]);
                      if result then
                        ReFazConsultaPorNome(qryDuplicatasRomaneios,['documentopag'], [qryRomaneiosdocumentopag.asVariant]);
                    end;
             end;
         end;
       end;

     finally

//       qryRomaneios.AfterOpen := qryRomaneiosAfterOpen;
//       qryRomaneios.AfterScroll := qryRomaneiosAfterScroll;
//       EditandoJustificativa := false;

     end;

   end;
  end
  else
    result:=false;

  if result then
    if not vIncluindo then
      ReabrirRomaneio;

end;

function TdtmCadastroRomaneios.IncluirRomaneios: boolean;
begin
  EdicaoCampos(false);
//  qryRomaneios.Close;
  qryRomaneios.ParamByName('numero').AsInteger:=0;
 // qryRomaneios.Open;
  qryRomaneios.Insert;
  qryRomaneiostipo.Value:='N';
  qryRomaneiosemissao.Value:=date();
  result := true;
end;

procedure TdtmCadastroRomaneios.PosicionarRomaneios(numero: integer);
begin
  RefazConsulta(qryRomaneios, [0], [numero]);
end;

