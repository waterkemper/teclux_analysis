begin
  Result:= qryItensRomaneio
end;

function TdtmCadastroRomaneios.IncluirItensRomaneio: Boolean;
begin
  if (qryItensRomaneio.State in [dsEdit,dsInsert]) then
    qryItensRomaneio.Cancel;
  LerNotasCuponsIncluidos(True);
  qryItensRomaneio.insert;
  Result:=True;
end;

procedure TdtmCadastroRomaneios.MarcarSelecionadosItens;
begin
  if PermiteAlterarDocumento then
  begin
   qryItensRomaneio.Edit;
   if qryItensRomaneiocancelado.Value then
    qryItensRomaneiocancelado.Value:=false
   else
    qryItensRomaneiocancelado.Value:=true;
   qryItensRomaneio.Post;
  end;
end;

function TdtmCadastroRomaneios.ExcluirItensRomaneio: boolean;
begin
  Result:= False;
  if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['a NOTA/CUPOM'])) = smbOk then begin
    if not qryItensRomaneio.IsEmpty then begin
      qryItensRomaneio.delete;
      Result:= True;
    end;
  end
end;

function TdtmCadastroRomaneios.GravarItensRomaneio: boolean;
begin
  Result:=false;
  if qryItensRomaneioentrega.AsString<>'' then
    qryItensRomaneiovalor.Required:=true
  else
    qryItensRomaneiovalor.Required:=false;

  if qryItensRomaneio.CheckRequiredFields then
  begin
   if (qryItensRomaneioentrega.AsString='') and (FEntrega_Anterior<>'') then
    if MensagemConfirmacao(format(ctCONFIRMECANCELAR,['esta entrega']))=smbCancel then
     begin
      result:=false;
      exit;
     end
    else
     Entrega_Anterior:='';

   qryItensRomaneio.Post;
   AtualizarCampos;
   Result:=True;
  end;
end;

procedure TdtmCadastroRomaneios.SetParametroFilialEmissaoNota(
  const Value: String);
begin
  FParametrofilialEmissaoNota := Value;
  if value<>'' then
  begin
    qryProcuraSeriesFiliais.Sql[4]:='and sf.filial='+value;
    qryConsultaSeriesFiliais.Sql[4]:='Where sf.filial='+value;
    qryConsultaDadosFiscaisNotas.Sql[19]:='where n.filial = '+value;
  end
  else
  begin
    qryProcuraSeriesFiliais.Sql[4]:='';
    qryConsultaSeriesFiliais.Sql[4]:='';
    qryConsultaDadosFiscaisNotas.Sql[19]:='';
  end;
end;

procedure TdtmCadastroRomaneios.AbreTabelaPesquisa(
  TipoPesquisa: TipoProcuraRomaneios);
begin
  case TipoPesquisa of
   tpRomaneios                :abre(ctConsultaRomaneios);
   tpRomaneiosFornecedores    :abre(ctConsultaRomaneiosFornecedor);
   tpItensRomaneioTipodeFrete :abre(ctConsultaRomaneiosFretes);
   tpItensRomaneioFiliais     :abre(ctConsultaRomaneiosFiliais);
   tpItensRomaneioSerie       :abre(ctConsultaRomaneiosSeries);
   tpItensRomaneioNotas       :abre(ctConsultaRomaneiosNotas);
   tpItensRomaneioCupons      :abre(ctConsultaRomaneiosCupons);
  end;
end;

procedure TdtmCadastroRomaneios.FechaTabelaPesquisa(
  TipoPesquisa: TipoProcuraRomaneios);
begin
  case TipoPesquisa of
   tpRomaneios                :Fecha(ctConsultaRomaneios);
   tpRomaneiosFornecedores    :Fecha(ctConsultaRomaneiosFornecedor);
   tpItensRomaneioTipodeFrete :Fecha(ctConsultaRomaneiosFretes);
   tpItensRomaneioFiliais     :Fecha(ctConsultaRomaneiosFiliais);
   tpItensRomaneioSerie       :Fecha(ctConsultaRomaneiosSeries);
   tpItensRomaneioNotas       :Fecha(ctConsultaRomaneiosNotas);
   tpItensRomaneioCupons      :Fecha(ctConsultaRomaneiosCupons);
  end;
end;

