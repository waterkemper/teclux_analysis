  DataSet: TDataSet);
begin
  inherited;
  qryItensRomaneiocancelado.Value:=false;
end;

procedure TdtmCadastroRomaneios.qryItensRomaneioAfterPost(
  DataSet: TDataSet);
begin
  inherited;

  if qryRomaneios.ReadOnly then
  begin
   qryRomaneios.ReadOnly       := false;
   SetReadOnlyFields(qryRomaneios, True);
  end;

  qryRomaneiostipo.readonly := (qryitensRomaneio.recordcount<>0);

  if not (qryRomaneios.State in [dsinsert, dsedit]) then
     qryRomaneios.Edit;

  cdsItensRomaneio.close;
  cdsItensRomaneio.open;

end;

procedure TdtmCadastroRomaneios.qryItensRomaneioAfterScroll(
  DataSet: TDataSet);
var
  vCondicaoWritedata_hora_recebimento : Boolean;
  vCondicaoWritejustificativa_entrega : Boolean;
begin
  inherited;
  if FImprimindoRelatorio then
  begin
   if not FImprimirCancelados then
     if qryItensRomaneiocancelado.AsBoolean then
       qryItensRomaneio.Next;
  end
  else
  begin
    Entrega_Anterior               :=qryItensRomaneioentrega.AsString;
    FilialEmissaoNota_Atual        :=ItensRomaneioFiliais;
    Serie_Atual                    :=ItensRomaneioSerie;
    Nota_Atual                     :=ItensRomaneioNota;
    chv_nfe_Atual                  :=ItensRomaneiochv_nfe;
    FilialEmissaoCupom_Atual       :=ItensRomaneioFiliais;
    Maquina_Atual                  :=ItensRomaneioMaquina;
    Intervensao_Atual              :=ItensRomaneioIntervensao;
    Cupom_Atual                    :=ItensRomaneioCupom;
  end;

  vCondicaoWritedata_hora_recebimento :=
{      (qryRomaneios.ReadOnly or (not qryRomaneios.ReadOnly and qryRomaneiosnumero.ReadOnly)) and}
      (qryRomaneiostipo.asString = 'N') and
      ((qryItensRomaneiosituacao_romaneio_saida.asString = 'EM TRÂNSITO') or
       (qryItensRomaneiosituacao_romaneio_saida.asString = 'ENTREGUE PARCIAL') or
       (qryItensRomaneiosituacao_romaneio_saida.asString = 'ENTREGUE')) and
       qryItensRomaneiojustificativa_entrega.isnull;

       (*
       not
       (
       { Condição quando vem já definida pelo documento fiscal - pela assinatura no celular }
         (
          not qryItensRomaneioaux_data_hora_recebimento.isnull and
              qryItensRomaneioaux_usuario_data_hora_recebimento.isnull
         ) or
         not qryItensRomaneiojustificativa_entrega.isnull { foi preenchida a justificativa por não conseguir entregar... dúvidas}
       );
       *)

   vCondicaoWritejustificativa_entrega :=
{      (qryRomaneios.ReadOnly or (not qryRomaneios.ReadOnly and qryRomaneiosnumero.ReadOnly)) and}
      (qryRomaneiostipo.asString = 'N') and
      ((qryItensRomaneiosituacao_romaneio_saida.asString = 'EM TRÂNSITO') or
       (qryItensRomaneiosituacao_romaneio_saida.asString = 'ENTREGUE PARCIAL') or
       (qryItensRomaneiosituacao_romaneio_saida.asString = 'ENTREGUE') or
       (qryItensRomaneiosituacao_romaneio_saida.asString = 'ENTREGA NÃO EFETUADA')); (* and

       not
       (
       { Condição quando vem já definida pelo documento fiscal - pela assinatura no celular }
          not qryItensRomaneioaux_data_hora_recebimento.isnull and
              qryItensRomaneioaux_usuario_data_hora_recebimento.isnull
       );
       *)
                         {
   if vCondicaoWritedata_hora_recebimento or vCondicaoWritejustificativa_entrega then
   begin
     qryitensRomaneio.ReadOnly   := false;
     SetReadOnlyFields(qryitensRomaneio, True);
   end;
   }

   qryitensRomaneiodata_hora_recebimento.readonly := not vCondicaoWritedata_hora_recebimento;
   qryItensRomaneiojustificativa_entrega.readonly := not vCondicaoWritejustificativa_entrega;

   if EditandoJustificativa then
   begin
     qryitensRomaneiodata_hora_recebimento.readonly := false;
     qryItensRomaneiojustificativa_entrega.readonly := false;
   end;

   qryItensRomaneionomefilial.readonly := not (qryItensRomaneiosituacao_romaneio_saida.asSTring = 'ABERTA');
   qryItensRomaneiofilialemissao.readonly := not (qryItensRomaneiosituacao_romaneio_saida.asSTring = 'ABERTA');
   qryItensRomaneioserie.readonly := not (qryItensRomaneiosituacao_romaneio_saida.asSTring = 'ABERTA');
   qryItensRomaneionumero_nf.readonly := not (qryItensRomaneiosituacao_romaneio_saida.asSTring = 'ABERTA');
   qryItensRomaneiomaquina.readonly := not (qryItensRomaneiosituacao_romaneio_saida.asSTring = 'ABERTA');
   qryItensRomaneiointervensao.readonly := not (qryItensRomaneiosituacao_romaneio_saida.asSTring = 'ABERTA');
   qryItensRomaneionumero_cupom.readonly := not (qryItensRomaneiosituacao_romaneio_saida.asSTring = 'ABERTA');
   qryItensRomaneiodadofiscal.readonly := not (qryItensRomaneiosituacao_romaneio_saida.asSTring = 'ABERTA');
   qryItensRomaneiochv_nfe.readonly := not (qryItensRomaneiosituacao_romaneio_saida.asSTring = 'ABERTA');

   qryItensRomaneiocancelado.readonly := qryRomaneiossituacao_romaneio.asString = 'FECHADA';
   qryItensRomaneiocodigofrete.readonly := qryRomaneiossituacao_romaneio.asString = 'FECHADA';
   qryItensRomaneiovalorfornecedor.readonly := qryRomaneiossituacao_romaneio.asString = 'FECHADA';
   qryItensRomaneiovalor.readonly := qryRomaneiossituacao_romaneio.asString = 'FECHADA';
   qryItensRomaneioobservacao.readonly := qryRomaneiossituacao_romaneio.asString = 'FECHADA';
   qryItensRomaneiojustificativa_entrega.readonly := qryRomaneiossituacao_romaneio.asString = 'FECHADA';
   qryItensRomaneiomotivoentrega.readonly := qryRomaneiossituacao_romaneio.asString = 'FECHADA';

   qryItensRomaneiodataentrega.readonly := not ((qryItensRomaneiosituacao_romaneio_saida.asSTring = 'ENTREGA NÃO EFETUADA') or
                                                (qryItensRomaneiosituacao_romaneio_saida.asSTring = 'EM TRÂNSITO'));
   qryItensRomaneiohoraentrega.readonly := qryItensRomaneiodataentrega.readonly;


end;

