function TdtmCadastroRomaneios.DadosFiscaisdoRomaneio: String;
var
 DadosFiscais : String;
 a: Integer;
begin
  for a := 0 to High(aNotaCupomRomaneio) do
  begin
   if FImprimirCancelados then
    DadosFiscais := DadosFiscais + aNotaCupomRomaneio[a].Dadofiscal+' ,'
   else
     if not aNotaCupomRomaneio[a].Cancelado then
       DadosFiscais := DadosFiscais + aNotaCupomRomaneio[a].Dadofiscal+' ,';
  end;
  if (DadosFiscais<>'') then
   Delete(DadosFiscais, Length(Dadosfiscais)-1, 2);
  result := Dadosfiscais;
end;

