function TdtmCadastroRomaneios.AtualizaItensRomaneiosCupons(
  FilialEmissao, ECF, Intervensao, NumeroCupom: String): Boolean;
begin
 Result :=false;
 if (FilialEmissao<>'') and (ECF<>'') and
    (Intervensao<>'')   and (NumeroCupom<>'') then
  RefazConsulta(qryProcuraDadosFiscaisCupons,[0,1,2,3],[FilialEmissao,ECF,Intervensao,NumeroCupom, SomenteNFComItensdeEntrega])
 else
  RefazConsulta(qryProcuraDadosFiscaisCupons,[],[]);

 if not qryProcuraDadosFiscaisCupons.IsEmpty then
 begin
  if ValidaCupomRomaneio(FilialEmissao,
                         ECF,
                         Intervensao,
                         NumeroCupom,
                         qryProcuraDadosFiscaisCuponsromaneio.AsString) then
  begin
   ItensRomaneiodadofiscal   := qryProcuraDadosFiscaisCuponsdadofiscal.asstring;
   if not (qryItensRomaneio.State in [dsedit]) then
    if (qryProcuraDadosFiscaisCuponscodigofrete.Value<>0) then
     ItensRomaneioTipodeFrete       := qryProcuraDadosFiscaisCuponscodigofrete.asinteger;
   ItensRomaneioFiliais             := qryProcuraDadosFiscaisCuponsfilialemissao.asstring;
   ItensRomaneioserie               := qryProcuraDadosFiscaisCuponsserie.Value;
   ItensRomaneioNota                := qryProcuraDadosFiscaisCuponsnota.AsString;
   ItensRomaneioMaquina             := qryProcuraDadosFiscaisCuponsmaquina.asstring;
   ItensRomaneiointervensao         := qryProcuraDadosFiscaisCuponsintervensao.asstring;
   ItensRomaneioCupom               := qryProcuraDadosFiscaisCuponscupom.asstring;
   qryItensRomaneionomefilial.Value := qryProcuraDadosFiscaisCuponsnomefilialemissao.Value;
   qryItensRomaneiodataemissao.Value:= qryProcuraDadosFiscaisCuponsdata.Value;
   qryItensRomaneiovalor.value      := qryProcuraDadosFiscaisCuponsvalorfrete.value;

   if qryProcuraDadosFiscaisCuponstipocliente.AsString<>'C' then
     qryItensRomaneiocliente.asstring := qryProcuraDadosFiscaisCuponscliente.AsString+
                                        qryProcuraDadosFiscaisCuponstipocliente.AsString
   else
     qryItensRomaneiocliente.asstring := qryProcuraDadosFiscaisCuponscliente.AsString;

   qryItensRomaneionomecliente.asstring := qryProcuraDadosFiscaisCuponsnomecliente.AsString;
//   qryItensRomaneiodata_hora_recebimento.asVariant := qryProcuraDadosFiscaisCuponsdata_hora_recebimento.asVariant;
   Entrega_Anterior               := qryItensRomaneioentrega.AsString;
   FilialEmissaoNota_Atual        := ItensRomaneioFiliais;
   Serie_Atual                    := ItensRomaneioSerie;
   Nota_Atual                     := ItensRomaneioNota;
   chv_nfe_Atual                  := ItensRomaneiochv_nfe;
   FilialEmissaoCupom_Atual       := ItensRomaneioFiliais;
   Maquina_Atual                  := ItensRomaneioMaquina;
   Intervensao_Atual              := ItensRomaneioIntervensao;
   Cupom_Atual                    := ItensRomaneioCupom;

   qryItensRomaneiovolumes.AsInteger := qryProcuraDadosFiscaisCuponsvolumes.asinteger;

   Result := True;
  end;
 end
 else
  MensagemAviso(ctCUPOMNAOENCONTRADO);
end;

