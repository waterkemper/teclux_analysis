    function AtualizaItensRomaneiosNotas(FilialEmissao,Serie,NumeroNota,chv_nfe:String):boolean;
    function AtualizaItensRomaneiosCupons(FilialEmissao,ECF,Intervensao,NumeroCupom:String):Boolean;

    function NotaFiscalAlterada(FilialEmissao,Serie,NumeroNota,chv_nfe:String):boolean;
    function CupomFiscalAlterado(FilialEmissao,ECF,Intervensao,NumeroCupom:String):Boolean;

    procedure AbreTabelaPesquisa(TipoPesquisa: TipoProcuraRomaneios);
    procedure FechaTabelaPesquisa(TipoPesquisa: TipoProcuraRomaneios);

    procedure LerNotasCuponsIncluidos(Incluindo: Boolean);
    function NotaExistenteRomaneioAtual(Filial, Serie, Numero, chv_nfe: String): Boolean;
    function CupomExistenteRomaneioAtual(Filial, Maquina, Intervensao, Numero: String): Boolean;

    function VerificarTipoRomaneio(ehnotafiscalsaidatransferencia: Boolean): boolean;

    function ValidaNotaRomaneio(Filial, Serie, Numero, chv_nfe, Romaneio: String): Boolean;

    function ValidaNotaRomaneioConsulta(DadoFiscal, Romaneio: String): Boolean;

    function ValidaCupomRomaneio(Filial, Maquina, Intervensao, Numero, Romaneio: String): Boolean;

    property FilialEmissaoNota_Atual: String read FFilialEmissaoNota_Atual write SetFilialEmissaoNota_Atual;
    property Serie_Atual: String read FSerie_Atual write SetSerie_Atual;
    property Nota_Atual: String read FNota_Atual write SetNota_Atual;
    property chv_nfe_Atual: String read Fchv_nfe_Atual write Fchv_nfe_Atual;

    property FilialEmissaoCupom_Atual: String read FFilialEmissaoCupom_Atual write SetFilialEmissaoCupom_Atual;
    property Maquina_Atual: String read FMaquina_Atual write SetMaquina_Atual;
    property Intervensao_Atual: String read FIntervensao_Atual write SetIntervensao_Atual;
    property Cupom_Atual: String read FCupom_Atual write SetCupom_Atual;
    property ImprimirCancelados: Boolean read FImprimirCancelados write FImprimirCancelados;
    property TipodeRelatorio: Integer read FTipodeRelatorio write FTipodeRelatorio;
    function DadosFiscaisdoRomaneio: String;

    function AbrirConsultaNotasRomaneio(
         DataInicial, DataFinal,
         DataInicialEntrega, DataFinalEntrega,
         ListaFiliais, ListaCondicionalClientes: String;
         SomenteNFComItensdeEntrega_: Boolean
         ): boolean;

    procedure IncluirMultiplosItensdeRomaneio;
    procedure LocalizarNfe(chv_nfe: String);

    procedure RefazConsultaRomaneio(Numero: Integer);
    procedure AtualizarSituacaoRomaneio;
    function LiberarEntrega(usuario: integer): boolean;
    function ReterEntrega(usuario: integer): boolean;
    procedure ReabrirRomaneio;
    property clientedadofiscal: integer read GetClienteDadofiscal write fClienteDadoFiscal;
    property tipoclientedadofiscal: string read GetTipoClienteDadofiscal write fTipoClienteDadoFiscal;


  end;


var
  dtmCadastroRomaneios: TdtmCadastroRomaneios;


implementation
uses
  fmCadastroRomaneioS;  

{$R *.dfm}

var
  aNotaCupomRomaneio: array of record
    Dadofiscal,
    FilialEmissao,
    Nota,
    Serie,
    chv_nfe,
    Maquina,
    Intervensao,
    Cupom: String;
    Cancelado: Boolean
  end;

{ TdtmCadastroRomaneios }
constructor TdtmCadastroRomaneios.Create(AOwner: TComponent);
begin
  inherited;
  qryRomaneios.Tag                  := ctTabelas;
  qryItensRomaneio.Tag              := ctTabelas;
  qryProcuraFiliais.Tag             := ctTabelas;
  qryTabeladeFretes.Tag             := ctTabelas;

  qryConsultaRomaneios.Tag          := ctConsultaRomaneios;
  qryConsultafornecedores.Tag       := ctConsultaRomaneiosFornecedor;
  qryConsultaFiliais.Tag            := ctConsultaRomaneiosFiliais;
  qryConsultaTabeladeFretes.Tag     := ctConsultaRomaneiosFretes;
  qryConsultaSeriesFiliais.Tag      := ctConsultaRomaneiosSeries;
  qryConsultaDadosFiscaisNotas.Tag  := ctConsultaRomaneiosNotas;
  qryConsultaDadosFiscaisCupons.Tag := ctConsultaRomaneiosCupons;

  SomenteNFComItensdeEntrega := false;
  
end;

function TdtmCadastroRomaneios.ExcluirRomaneios: boolean;
var
  vNumeroDocumentoPag : integer;
begin
  Result:= False;
  if not qryRomaneios.IsEmpty then
  begin
    qryItensRomaneio.First;
    while not qryItensRomaneio.Eof do
    begin
     if qryItensRomaneioentrega.AsString<>'' then
      begin
       MensagemAviso(format(ctROMANEIONAOPODESEREXCLUIDO, ['notas/cupons']));
       result:=false;
       exit;
      end
     else
      qryItensRomaneio.Next;
    end;


    qryDuplicatasRomaneios.first;
    while not qryDuplicatasRomaneios.eof do
    begin
      if not qryDuplicatasRomaneiosdatapagto.isnull then
      begin
        MensagemAviso('O romaneio não pode ser excluído, pois existem pagamentos vinculados');
        result:=false;
        exit;
      end;
      qryDuplicatasRomaneios.next;
    end;

    if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o ROMANEIO e os registros associados'])) = smbOk then
    begin

      try
//        qryItensRomaneio.AfterDelete := nil;
//        qryItensRomaneio.AfterScroll := nil;

        vNumeroDocumentoPag := qryRomaneiosdocumentopag.asinteger;
        case IncluirDocumentosPag(self, Romaneios, vNumeroDocumentoPag,
                [qryRomaneios, qryValorEntrada, qryItensRomaneio], true) of

           ErroGravacao   : MensagemAviso('Ocorreu um erro de gravação ao cadastrar o ''Contas a Pagar''.');
           DuplicataPaga : MensagemAviso('O documento a pagar vinculado a este romaneio esta quitado e não será atualizado.');
           ok : begin

                  qryRomaneios.AfterScroll := nil;

                  qryItensRomaneio.First;
                  while not qryItensRomaneio.Eof do
                    qryItensRomaneio.Delete;

                  qryRomaneios.Delete;

                  result := Perpetrar([qryitensRomaneio,qryRomaneios]);

                end;
        end;


      finally
        qryRomaneios.AfterScroll := qryRomaneiosAfterScroll;
        qryRomaneiosAfterScroll(qryRomaneios);
//        qryItensRomaneio.AfterDelete := qryItensRomaneioAfterDelete;
//        qryItensRomaneio.AfterScroll := qryItensRomaneioAfterScroll;
      end;

    end;
  end;
end;

