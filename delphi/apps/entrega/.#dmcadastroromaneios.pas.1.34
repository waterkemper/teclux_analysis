function TdtmCadastroRomaneios.AbrirConsultaNotasRomaneio(
  DataInicial, DataFinal,
         DataInicialEntrega, DataFinalEntrega,
         ListaFiliais, ListaCondicionalClientes: String;
         SomenteNFComItensdeEntrega_: Boolean
         ): boolean;

Const

 ctSQLDataEntrega =

 ' and exists (select pdf.dadofiscal                                      ' +
 '             from produtosdadosfiscais pdf                              ' +
 '                  left join produtoscontratos pc                        ' +
 '                    on pc.contrato = df.contrato                        ' +
 '                   and pc.produto = pdf.produto                         ' +
 '                                                                        ' +
 '             where pdf.dadofiscal = df.numero                           ' +
 '               and coalesce(pc.dataentrega, df.data)                   ';

 ctDatasEntregas = 'between :dataInicialEntrega and :dataFinalEntrega limit 1) ';
 ctDataInicialEntrega = ' >= :dataInicialEntrega limit 1) ';
 ctDataFinalEntrega = ' <= :dataFinalEntrega limit 1) ';

begin
  qryNotasRomaneio.MacroByName('VerdadeiroouFalso').asString := ' and true and ';

  qryNotasRomaneio.ParamByName('datainicial').asString := DataInicial;
  qryNotasRomaneio.ParamByName('datafinal').asString := DataFinal;

  qryNotasRomaneio.ParamByName('datainicialentrega').asString := DataInicialEntrega;
  qryNotasRomaneio.ParamByName('datafinalentrega').asString := DataFinalEntrega;

  qryNotasRomaneio.ParamByName('SomenteNFComItensdeEntrega').asBoolean := SomenteNFComItensdeEntrega_;
  qryNotasRomaneio.ParamByName('tiporomaneio').asString := qryRomaneiostipo.asString;

  if (DataInicialEntrega <> '') and (DataFinalEntrega <> '') then
    qryNotasRomaneio.MacroByName('PeriodoDataEntrega').asString := ctSQLDataEntrega + ctDatasEntregas
  else
  if (DataInicialEntrega <> '') and (DataFinalEntrega = '') then
    qryNotasRomaneio.MacroByName('PeriodoDataEntrega').asString := ctSQLDataEntrega + ctDataInicialEntrega
  else
  if (DataInicialEntrega = '') and (DataFinalEntrega <> '') then
    qryNotasRomaneio.MacroByName('PeriodoDataEntrega').asString := ctSQLDataEntrega + ctDataFinalEntrega
  else
  if (DataInicialEntrega = '') and (DataFinalEntrega = '') then
    qryNotasRomaneio.MacroByName('PeriodoDataEntrega').asString := '';

  if ListaFiliais <> '' then
    qryNotasRomaneio.MacroByName('ListaFiliais').asString :=
      format('and df.filialemissao in (%s)', [ListaFiliais]);

  if ListaCondicionalClientes <> '' then
    qryNotasRomaneio.MacroByName('ListaCondicionalClientes').asString :=
      ' and (' + ListaCondicionalClientes + ')';

  qryNotasRomaneio.close;
  qryNotasRomaneio.open;
  result := not qryNotasRomaneio.isempty;

  if not result then
    MensagemAviso(format(ctNENHUMREGISTROENCONTRADO,['registro']));

  RegistrosSelecionados := 0;
  qryNotasRomaneiofilialemissao_oldvalue := 0;
  qtNotasRomaneiofilialemissao_oldvalue := 0;

  qryNotasRomaneioCliente_oldvalue := '';
  qtNotasRomaneioCliente_oldvalue := 0;




end;

procedure TdtmCadastroRomaneios.qryNotasRomaneioselecionarregistroChange(
  Sender: TField);
begin
  inherited;
  if tbooleanfield(sender).AsBoolean then
    inc(RegistrosSelecionados)
  else
    dec(RegistrosSelecionados);

  if RegistrosSelecionados < 0 then
    RegistrosSelecionados := 0;  

end;

procedure TdtmCadastroRomaneios.qryNotasRomaneiocodigofreteChange(
  Sender: TField);
begin
  inherited;
  if qryNotasRomaneiocodigofrete.value <> 0 then
    qryNotasRomaneiocodigodescricaofrete.asString := qryTabeladeFretescodigodescricaofrete.asString
  else
    qryNotasRomaneiocodigodescricaofrete.clear;
end;

procedure TdtmCadastroRomaneios.IncluirMultiplosItensdeRomaneio;
begin
  try

    qryItensRomaneio.disablecontrols;

    qryNotasRomaneio.first;
    while not qryNotasRomaneio.eof do
    begin
      if qryNotasRomaneioselecionarregistro.AsBoolean then
      begin
        if qryItensRomaneio.locate('dadofiscal', qryNotasRomaneiodadofiscal.asVariant, []) then
          qryItensRomaneio.edit
        else
          qryItensRomaneio.append;

        qryItensRomaneionomefilial.asVariant      := qryNotasRomaneionomefilialemissao.asVariant ;
        qryItensRomaneioserie.asVariant           := qryNotasRomaneioserie.asVariant;
        qryItensRomaneionumero_nf.asVariant       := qryNotasRomaneionota.asVariant;
        qryItensRomaneiomaquina.asVariant         := qryNotasRomaneiomaquina.asVariant;
        qryItensRomaneiointervensao.asVariant     := qryNotasRomaneiointervensao.asVariant;
        qryItensRomaneionumero_cupom.asVariant    := qryNotasRomaneiocupom.asVariant;
        qryItensRomaneiodataemissao.asVariant     := qryNotasRomaneiodata.asVariant;
//        qryItensRomaneioentrega.asVariant         := qryNotasRomaneioentrega.asVariant;
        qryItensRomaneiovalor.asVariant           := qryNotasRomaneiovalor.asVariant;
        qryItensRomaneiocancelado.asVariant       := false;
        qryItensRomaneioobservacao.asVariant      := qryNotasRomaneioobservacao.asVariant;
        qryItensRomaneioromaneio.asVariant        := qryRomaneiosnumero.asVariant;;
        qryItensRomaneiocodigofrete.asVariant     := qryNotasRomaneiocodigofrete.asVariant;
        qryItensRomaneiofilialemissao.asVariant   := qryNotasRomaneiofilialemissao.asVariant;
        qryItensRomaneiodescricaofrete.asVariant  := qryNotasRomaneiocodigodescricaofrete.asVariant;
        qryItensRomaneiovalorfornecedor.asVariant := qryNotasRomaneiovalorfornecedor.asVariant;

        qryItensRomaneiovolumes.asVariant := qryNotasRomaneiovolumes.asVariant;

        if qryNotasRomaneiotipocliente.AsString<>'C' then
          qryItensRomaneiocliente.asstring := qryNotasRomaneiocliente.asString+
                                              qryNotasRomaneiotipocliente.AsString
        else
          qryItensRomaneiocliente.asstring := qryNotasRomaneiocliente.asString;

        qryItensRomaneionomecliente.asVariant     := qryNotasRomaneionomecliente.asVariant;
        qryItensRomaneiochv_nfe.AsVariant         := qryNotasRomaneiochv_nfe.AsVariant;

//        qryItensRomaneiodata_hora_recebimento.asVariant := qryNotasRomaneiodata_hora_recebimento.AsVariant;

  //      qryItensRomaneioobservacao_2.asVariant    := ;
        qryItensRomaneiodadofiscal.asVariant      := qryNotasRomaneiodadofiscal.asVariant ;
        qryItensRomaneio.post;
      end;

      qryNotasRomaneio.Next;
    end;

  finally
    qryItensRomaneio.enablecontrols;
  end;  

end;

