unit fmConsultaRomaneios;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, fmajudabt, ComCtrls, Buttons, ToolWin, ExtCtrls, cppagecontrol,
  frlistafiliais, frintervalodatas, frconsulta, frconsultacodigo, frselecaoaleatoria, frselecaoaleatoriaclientes, StdCtrls,
  dmconsultaromaneios, CheckLst, Grids, AdvObj, BaseGrid, AdvGrid,
  DBAdvGrid, biblio, ctconstantes, DBCtrls, cpdbmemo, DBGrids, cpdbgrid,
  clparametrossistema, fmPrincipalBasico, AsgFindDialog, tmsAdvGridExcel,
  Menus, AdvMenus;

type
  TfrmConsultaRomaneios = class(TfrmAjudaBt)
    pgcConsultaRomaneios: TtecPageControl;
    tstParametrosSelecao: TTabSheet;
    tstDados: TTabSheet;
    fraListaFiliaisEmissao: TfraListaFiliais;
    fraListaFiliaisDestino: TfraListaFiliais;
    gbxListadeClientes: TGroupBox;
    fraSelecaoAleatoriaClientes1: TfraSelecaoAleatoriaClientes;
    GroupBox1: TGroupBox;
    fraSelecaoAleatoriaFornecedores1: TfraSelecaoAleatoriaClientes;
    gbxSituacao: TGroupBox;
    ckbTipo: TCheckListBox;
    fraIntervaloDatas: TfraIntervaloDatas;
    sbnGerar: TSpeedButton;
    sbnRomaneio: TSpeedButton;
    Timer1: TTimer;
    gbxStatus: TGroupBox;
    ckbSituacao: TCheckListBox;
    dbgRomaneios: TDBAdvGrid;
    gbxItensRomaneios: TGroupBox;
    dbgItensRomaneio: TtecDBGrid;
    gbxNotaFiscal: TGroupBox;
    gbxCupomFiscal: TGroupBox;
    gbxObservacao: TGroupBox;
    mmoObservacoes: TtecDBMemo;
    AdvPopupMenu1: TAdvPopupMenu;
    Pesquizar1: TMenuItem;
    ExportarExcel1: TMenuItem;
    AdvGridExcelIO1: TAdvGridExcelIO;
    AdvGridFindDialog1: TAdvGridFindDialog;
    procedure FormKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure Timer1Timer(Sender: TObject);
    procedure sbnGerarClick(Sender: TObject);
    procedure dbgRomaneiosGetCellColor(Sender: TObject; ARow,
      ACol: Integer; AState: TGridDrawState; ABrush: TBrush; AFont: TFont);
    procedure sbnRomaneioClick(Sender: TObject);
    procedure Pesquizar1Click(Sender: TObject);
    procedure ExportarExcel1Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
    constructor Create(AOwner: TComponent); override;
    destructor  Destroy; override;

  end;

var
  frmConsultaRomaneios: TfrmConsultaRomaneios;

implementation

{$R *.dfm}

{ TfrmConsultaRomaneios }

constructor TfrmConsultaRomaneios.Create(AOwner: TComponent);
begin
  dtmConsultaRomaneios := TdtmConsultaRomaneios.Create(Self);
  inherited;
  fraSelecaoAleatoriaFornecedores1.fraSelecaoAleatoriaCliente.ConsultaSelecaoAleatoria.TipoCliente := 'F';

//  dbgRomaneios.Bands.SecondaryColor := TColorRef(strtoint(parsistema.CorZebradoRelatorio));

end;

destructor TfrmConsultaRomaneios.Destroy;
begin

  inherited;
end;

procedure TfrmConsultaRomaneios.FormKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  inherited;
  case Key of
    VK_F6 : if sbnGerar.enabled then sbnGerar.Click;
    VK_F8 : if sbnRomaneio.enabled then sbnRomaneio.Click;
  end;
end;

procedure TfrmConsultaRomaneios.Timer1Timer(Sender: TObject);
begin
  inherited;
  sbnGerar.enabled := pgcConsultaRomaneios.activepage = tstParametrosSelecao;
  sbnRomaneio.enabled := (pgcConsultaRomaneios.activepage = tstDados) and
      (dtmconsultaromaneios.qryRomaneios.recordcount <> 0);
end;

procedure TfrmConsultaRomaneios.sbnGerarClick(Sender: TObject);
begin
  inherited;
  dtmConsultaRomaneios.open_Romaneios(
    fraIntervaloDatas.edtDataInicial.text,
    fraIntervaloDatas.edtDataFinal.text,
    ckbTipo,
    ckbSituacao,

   fraListaFiliaisEmissao.ListaSelecionada,
   fraListaFiliaisDestino.ListaSelecionada,
   fraSelecaoAleatoriaClientes1.ListaCondicional,
   fraSelecaoAleatoriaFornecedores1.ListaCondicional);

   if dtmConsultaRomaneios.qryromaneios.recordcount <>0 then
     pgcConsultaRomaneios.ActivePage := tstDados
   else
     Mensagemaviso(format(ctNENHUMREGISTROENCONTRADO, ['REGISTRO']));




end;

procedure TfrmConsultaRomaneios.dbgRomaneiosGetCellColor(Sender: TObject;
  ARow, ACol: Integer; AState: TGridDrawState; ABrush: TBrush;
  AFont: TFont);
begin
  inherited;
  if ARow > 0 then
    with TDBAdvGrid(sender) do
    begin
      if (ARow MOD 2)=0 then
        if not (gdSelected in AState) then
        begin
        {
           if (ABrush.Color = clwindow) or
              (TColorRef(Brush.Color) = TColorRef(strtoint(parsistema.CorZebradoRelatorio))) then
              }
                 ABrush.Color := TColorRef(strtoint(parsistema.CorZebradoRelatorio));
        end;
    end;
end;

procedure TfrmConsultaRomaneios.sbnRomaneioClick(Sender: TObject);
begin
  inherited;
  if dtmConsultaRomaneios.qryRomaneios.recordcount <> 0 then
     TfrmPrincipalBasico(Application.MainForm).MostrarFormRegistrado(['Abrir', dtmConsultaRomaneios.qryRomaneiosnumero.asInteger], 'TfrmCadastroRomaneio', True)

end;

procedure TfrmConsultaRomaneios.Pesquizar1Click(Sender: TObject);
begin
  inherited;
  AdvGridFindDialog1.Execute;
end;

procedure TfrmConsultaRomaneios.ExportarExcel1Click(Sender: TObject);
begin
  inherited;

  dtmConsultaRomaneios.qryRomaneios.GuardarRegistroAtual(true, false);
  dtmConsultaRomaneios.qryRomaneios.AfterScroll := nil;
  AdvGridExcelIO1.XLSExport(ExtractFilePath(Application.ExeName) + 'Saidas\Consulta_de_Romaneios'+formatdatetime('yyyy-MM-dd hh mm ss', dtmConsultaRomaneios.DataHoraServidor)+
  '.xls', 'Romaneios');
  dtmConsultaRomaneios.qryRomaneios.AfterScroll :=   dtmConsultaRomaneios.qryRomaneiosAfterScroll;
  dtmConsultaRomaneios.qryRomaneios.VoltarRegistro;
end;

end.
