    procedure DBAdvGridItensRomaneioKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure DBAdvGridItensRomaneioGetEditorType(Sender: TObject; ACol,
      ARow: Integer; var AEditor: TEditorType);
    procedure BitBtn1Click(Sender: TObject);
    procedure sbnJustifcarEntregaClick(Sender: TObject);
  private
    { Private declarations }
  protected
    function  GetTitulo: String;
    function  InternoIncluir: Boolean; override;
