unit fmcadastroromaneios;

interface
uses
  SysUtils, Types, Classes, Graphics, Controls, Forms, Dialogs,
  StdCtrls, ComCtrls, Buttons, ExtCtrls, Windows, 
  cpdbradiogroup, Mask,  DBCtrls, Grids, DBGrids,
 // Terceiros
  ZQuery,
  // Repositorio

  fmconsultabasica, fmconsultaporcampo, fmcadastropadrao,
  // Biblio
  ctconstantes, biblio,  clusuario, 
  // Componentes
  cpnumero, cpdbfindcontrols, cpdbgrid, cpdbdata, cpdbtext, DB,
  ZPgSqlQuery, cpquery, cpdbmemo, cppagecontrol, cptexto, ActnList, ToolWin,
  IdBaseComponent, IdCoder, IdCoder3to4, IdCoderMIME, fmVisualizarImageURL,
  fmConferenciaDocumentos, AdvEdit, AdvMEdBtn, PlannerMaskDatePicker,
  PlannerDBMaskDatePicker, PlannerDatePicker, PlannerDBDatePicker,
  AdvEdBtn, DBPlannerDatePicker, DBDateTimePicker, DBDateTimePicker2,
  DBEditDateTimePicker, AdvObj, BaseGrid, AdvGrid, DBAdvGrid,
  AdvDateTimePicker, frmctrllink, AdvDBDateTimePicker;

type
  TfrmCadastroRomaneio = class(TfrmCadastroPadrao)
    pnlFundojanela: TPanel;
    gbxValores: TGroupBox;
    edtDataAbertura: TDBEditData;
    flkFornecedor: TtecDBFindLookup;
    sbnProcurarFornecedor: TSpeedButton;
    dtxRazaoFornecedores: TtecDBText;
    edtValorVencimento: TDBEditNumero;
    sbnImprimir: TSpeedButton;
    aclAbilitar: TActionList;
    actAbilitar: TAction;
    rgbTipoRomaneio: TtecDBRadioGroup;
    rbnTipoNormal: TtecRadioButton;
    rbnTipoTransferencia: TtecRadioButton;
    edfNumero: TtecDbEditFind;
    sbnIncluirItensRomaneio: TSpeedButton;
    sbnExcluirItensRomaneio: TSpeedButton;
    gbxObservacao: TGroupBox;
    mmoObservacoes: TtecDBMemo;
    edtvaloraentregar: TDBEditNumero;
    edtValorEntregue: TDBEditNumero;
    gbxNrRomaneio: TGroupBox;
    gbxDataAbertura: TGroupBox;
    gbxFornecedor: TGroupBox;
    gbxEntregue: TGroupBox;
    gbxEntragar: TGroupBox;
    gbxTotalPagar: TGroupBox;
    gbxNotaFiscal: TGroupBox;
    gbxCupomFiscal: TGroupBox;
    sbnIncluirMultiplosItensRomaneio: TSpeedButton;
    dbgDuplicatasOrcamentos: TtecDBGrid;
    lblDuplicatas: TStaticText;
    sbnVisualizarAssinatura: TSpeedButton;
    sbnConferir: TSpeedButton;
    GroupBox6: TGroupBox;
    Label9: TLabel;
    dtxConferidopor: TtecDBText;
    dtxDatHoraConferidopor: TtecDBText;
    gbxSituacao: TGroupBox;
    dtxSituacao: TtecDBText;
    sbnLiberarEntrega: TSpeedButton;
    GroupBox1: TGroupBox;
    Label1: TLabel;
    dtxnomeusuarioliberacao: TtecDBText;
    dtxdatahoratransito: TtecDBText;
    DBAdvGridItensRomaneio: TDBAdvGrid;
    pnlBotoesItensRomaneio: TPanel;
    pnltopItensRomaneio: TPanel;
    pnlTopRomaneios: TPanel;
    AdvDBDateTimePicker1: TAdvDBDateTimePicker;
    FormControlEditLink1: TFormControlEditLink;
    sbnJustifcarEntrega: TSpeedButton;
    procedure sbnProcurarFornecedorClick(Sender: TObject);
    procedure dbgItensRomaneioKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure dbgItensRomaneioDblClick(Sender: TObject);
    procedure sbnIncluirItensRomaneioClick(Sender: TObject);
    procedure sbnExcluirItensRomaneioClick(Sender: TObject);
    procedure sbnExcluirRomaneiosCuponsClick(Sender: TObject);
    procedure sbnImprimirClick(Sender: TObject);
    procedure actAbilitarUpdate(Sender: TObject);
    procedure sbnCancelarPagamentoClick(Sender: TObject);
//    procedure sbnEntregarClick(Sender: TObject);
    procedure sbnIncluirMultiplosItensRomaneioClick(Sender: TObject);
    procedure sbnVisualizarAssinaturaClick(Sender: TObject);
    procedure sbnConferirClick(Sender: TObject);
    procedure sbnLiberarEntregaClick(Sender: TObject);
