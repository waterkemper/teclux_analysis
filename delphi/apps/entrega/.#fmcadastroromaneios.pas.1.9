unit fmcadastroromaneios;

interface
uses
  SysUtils, Types, Classes, Graphics, Controls, Forms, Dialogs,
  StdCtrls, ComCtrls, Buttons, ExtCtrls, Windows, 
  cpdbradiogroup, Mask,  DBCtrls, Grids, DBGrids,
 // Terceiros
  ZQuery,
  // Repositorio

  fmconsultabasica, fmconsultaporcampo, fmcadastropadrao,
  // Biblio
  ctconstantes, biblio,  clusuario, 
  // Componentes
  cpnumero, cpdbfindcontrols, cpdbgrid, cpdbdata, cpdbtext, DB,
  ZPgSqlQuery, cpquery, cpdbmemo, cppagecontrol, cptexto, ActnList, ToolWin,
  IdBaseComponent, IdCoder, IdCoder3to4, IdCoderMIME, fmVisualizarImageURL,
  fmConferenciaDocumentos;

type
  TfrmCadastroRomaneio = class(TfrmCadastroPadrao)
    pnlFundojanela: TPanel;
    gbxValores: TGroupBox;
    edtDataAbertura: TDBEditData;
    flkFornecedor: TtecDBFindLookup;
    sbnProcurarFornecedor: TSpeedButton;
    dtxRazaoFornecedores: TtecDBText;
    edtValorVencimento: TDBEditNumero;
    sbnImprimir: TSpeedButton;
    aclAbilitar: TActionList;
    actAbilitar: TAction;
    sbnEntregar: TSpeedButton;
    rgbTipoRomaneio: TtecDBRadioGroup;
    rbnTipoNormal: TtecRadioButton;
    rbnTipoTransferencia: TtecRadioButton;
    edfNumero: TtecDbEditFind;
    dbgItensRomaneio: TtecDBGrid;
    sbnIncluirItensRomaneio: TSpeedButton;
    sbnExcluirItensRomaneio: TSpeedButton;
    gbxObservacao: TGroupBox;
    mmoObservacoes: TtecDBMemo;
    edtvaloraentregar: TDBEditNumero;
    edtValorEntregue: TDBEditNumero;
    gbxNrRomaneio: TGroupBox;
    gbxDataAbertura: TGroupBox;
    gbxFornecedor: TGroupBox;
    gbxEntregue: TGroupBox;
    gbxEntragar: TGroupBox;
    gbxTotalPagar: TGroupBox;
    gbxNotaFiscal: TGroupBox;
    gbxCupomFiscal: TGroupBox;
    sbnIncluirMultiplosItensRomaneio: TSpeedButton;
    dbgDuplicatasOrcamentos: TtecDBGrid;
    lblDuplicatas: TStaticText;
    sbnVisualizarAssinatura: TSpeedButton;
    sbnConferir: TSpeedButton;
    GroupBox6: TGroupBox;
    Label9: TLabel;
    dtxConferidopor: TtecDBText;
    dtxDatHoraConferidopor: TtecDBText;
    gbxSituacao: TGroupBox;
    dtxSituacao: TtecDBText;
    procedure sbnProcurarFornecedorClick(Sender: TObject);
    procedure dbgItensRomaneioKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure dbgItensRomaneioDblClick(Sender: TObject);
    procedure sbnIncluirItensRomaneioClick(Sender: TObject);
    procedure sbnExcluirItensRomaneioClick(Sender: TObject);
    procedure sbnExcluirRomaneiosCuponsClick(Sender: TObject);
    procedure sbnImprimirClick(Sender: TObject);
    procedure actAbilitarUpdate(Sender: TObject);
    procedure sbnCancelarPagamentoClick(Sender: TObject);
    procedure sbnEntregarClick(Sender: TObject);
    procedure sbnIncluirMultiplosItensRomaneioClick(Sender: TObject);
    procedure sbnVisualizarAssinaturaClick(Sender: TObject);
    procedure sbnConferirClick(Sender: TObject);
  private
    { Private declarations }
  protected
    function  GetTitulo: String;
    function  InternoIncluir: Boolean; override;
    function  InternoExcluir: Boolean; override;
    function  InternoGravar: Boolean; override;
    function  InternoCancelar: Boolean; override;
    function  ExisteInformacao(Parametro: Integer; NomeCampo: String; Value: Variant): Boolean; override;
    function  InternoPesquisar(Titulo:String): Integer; override;
    function  JanelaPesquisa: TfrmConsultaBasica; override;
    function  PermitirProcura: Boolean;
    procedure Selecionar(value: tipoProcuraRomaneios);
    function  TabelaDePesquisa: TZDataSet; override;
    function  AcionaCadastroItensRomaneio(Editar: Boolean):boolean;
    function  AcionaMultiplosCadastroItensRomaneio:boolean;

    procedure KeyDown(var Key: Word; Shift: TShiftState); override;

  public
    { Public declarations }
    tipoProcura: TipoProcuraRomaneios;
    constructor Create(AOwner: TComponent); override;
    destructor Destroy; override;
  end;
var
  frmCadastroRomaneio: TfrmCadastroRomaneio;

implementation
uses dmcadastroromaneios, fmlerdata, fmLerTipoRelatorio,
  fmcadastroitensromaneio, fmSelecaoMultiplasNotasRomaneio;

{$R *.dfm}

{ TfrmCadastroRomaneio }

constructor TfrmCadastroRomaneio.Create(AOwner: TComponent);
begin
  inherited;
  dtmCadastroRomaneios:= TdtmCadastroRomaneios.Create(Self);
  DataSet:= dtmCadastroRomaneios.TabelaRomaneios;
  SELF.ActiveControl := edfNumero;  
end;

destructor TfrmCadastroRomaneio.Destroy;
begin
  dtmCadastroRomaneios:=nil;
  inherited;
  frmCadastroRomaneio := nil;
end;

function TfrmCadastroRomaneio.ExisteInformacao(Parametro: Integer;
  NomeCampo: String; Value: Variant): Boolean;
begin
  case tipoProcura of
    tpRomaneios             : Result := dtmCadastroRomaneios.ExisteRomaneios(NomeCampo,Value);
    tpRomaneiosFornecedores : result := dtmCadastroRomaneios.Existefornecedor(NomeCampo, Value);
  else
    result := false;
  end;

end;

function TfrmCadastroRomaneio.InternoGravar: Boolean;
begin
  Result:= inherited InternoGravar;
  if Result then
    if dtmCadastroRomaneios.GravarRomaneios then
      edfNumero.Exist;
end;

function TfrmCadastroRomaneio.InternoIncluir: Boolean;
begin
  Result:= inherited InternoIncluir;
  if not CtrlOn then
    if Result then
      dtmCadastroRomaneios.IncluirRomaneios;
end;

function TfrmCadastroRomaneio.InternoExcluir: Boolean;
begin
 result := false;
 if not ctrlon then
 begin
   result:= inherited InternoExcluir;
   if result then
     dtmCadastroRomaneios.ExcluirRomaneios
 end;
end;

function TfrmCadastroRomaneio.InternoPesquisar(Titulo: String): Integer;
begin
  if PermitirProcura then begin
    dtmCadastroRomaneios.AbreTabelaPesquisa(tipoprocura);
    result:=inherited internopesquisar(GetTitulo);
    if Result = mrOK then
      Selecionar(tipoProcura);
    dtmCadastroRomaneios.FechaTabelaPesquisa(tipoprocura);
  end else
    Result := mrNone

end;

function TfrmCadastroRomaneio.JanelaPesquisa: TfrmConsultaBasica;
begin
  Result:= TfrmConsultaPorCampo.Create(nil);
  TfrmConsultaPorCampo(result).ConsultaInterativa := True;
end;

function TfrmCadastroRomaneio.TabelaDePesquisa: TZDataSet;
begin
  Result := inherited TabelaDePesquisa;
  Case tipoprocura of
  tpRomaneios                : result := dtmCadastroRomaneios.ConsultaRomaneios;
  tpRomaneiosfornecedores : result := dtmCadastroRomaneios.Consultafornecedor;
  end;

end;

procedure TfrmCadastroRomaneio.sbnProcurarFornecedorClick(
  Sender: TObject);
begin
  inherited;
  CtrlOn := True;
  flkfornecedor.setfocus;
  tipoProcura := tpRomaneiosfornecedores;
  internoPesquisar(GetTitulo);
end;

function TfrmCadastroRomaneio.GetTitulo: String;
begin
  case tipoProcura of
    tpRomaneios                 : result := 'Romaneios';
    tpRomaneiosfornecedores  : result := 'fornecedor';
  else
    result := '';
  end;
end;

procedure TfrmCadastroRomaneio.Selecionar(value: tipoProcuraRomaneios);
begin
  case value of
    tpRomaneios             : dtmCadastroRomaneios.PosicionarRomaneios(dtmCadastroRomaneios.qryConsultaRomaneiosnumero.Value);
    tpRomaneiosfornecedores : dtmCadastroRomaneios.Romaneiofornecedor := dtmCadastroRomaneios.qryConsultafornecedorescodigo.Asinteger;
  end;
end;

function TfrmCadastroRomaneio.PermitirProcura: Boolean;
begin
  Result := False;;
  if CtrlOn then
  begin
    if flkfornecedor.Focused then begin
      Result := True;
      tipoProcura := tpRomaneiosfornecedores
    end
  end
  else
  begin
    Result := True;
    tipoProcura := tpRomaneios
  end
end;

procedure TfrmCadastroRomaneio.dbgItensRomaneioDblClick(Sender: TObject);
begin
  inherited;
  AcionaCadastroItensRomaneio(true);
end;

procedure TfrmCadastroRomaneio.sbnIncluirItensRomaneioClick(
  Sender: TObject);
begin
  inherited;
  AcionaCadastroItensRomaneio(false);
end;

procedure TfrmCadastroRomaneio.sbnExcluirItensRomaneioClick(
  Sender: TObject);
begin
  inherited;
  dtmCadastroRomaneios.ExcluirItensRomaneio
end;


procedure TfrmCadastroRomaneio.sbnExcluirRomaneiosCuponsClick(Sender: TObject);
begin
  inherited;
  dtmCadastroRomaneios.ExcluirItensRomaneio;
end;


procedure TfrmCadastroRomaneio.dbgItensRomaneioKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if (Shift = [ssCtrl]) then
    case key of
      TeclaEditarRegistro : AcionaCadastroItensRomaneio(true);
      TeclaInserirRegistro: AcionaCadastroItensromaneio(False);
      VK_SPACE: dtmCadastroRomaneios.MarcarSelecionadosItens;
    end;
end;


function TfrmCadastroRomaneio.InternoCancelar: Boolean;
begin
  Result:= inherited InternoCancelar;
  if Result then
    dtmCadastroRomaneios.CancelarRomaneios;
end;

procedure TfrmCadastroRomaneio.sbnImprimirClick(
  Sender: TObject);
begin
  inherited;
  frmLerTipoRelatorio := TfrmLerTipoRelatorio.Create(frmLerTipoRelatorio);
  if frmLerTipoRelatorio.ShowModal = mrok then
   begin
    dtmCadastroRomaneios.ImprimirCancelados:=frmLerTipoRelatorio.ckbInclurCancelados.Checked;
    dtmCadastroRomaneios.TipodeRelatorio := frmLerTipoRelatorio.rgpTipodeRelatorio.ItemIndex;
    dtmCadastroRomaneios.ImprimirRelatorio;
   end;
  frmLerTipoRelatorio.free; 
end;

procedure TfrmCadastroRomaneio.actAbilitarUpdate(Sender: TObject);
var
TabelaRomaneioVazia, TabelaItensRomaneiovazia, PermiteAlterar : boolean;
begin
  inherited;
  with dtmCadastroRomaneios do
  begin
   TabelaRomaneioVazia := TabelaRomaneios.IsEmpty;
   TabelaItensRomaneiovazia := TabelaItensRomaneio.isEmpty;
   PermiteAlterar := PermiteAlterarDocumento;
   sbnImprimir.Enabled                := NumeroRomaneio<>0;
   sbnProcurarfornecedor.Enabled      := PermiteAlterar and not TabelaRomaneioVazia;
   sbnEntregar.Enabled                   := PermiteAlterar and not TabelaRomaneioVazia
                                                           and not TabelaItensRomaneioVazia;
//   sbnCancelarPagamento.Enabled          := not PermiteAlterar and not TabelaRomaneioVazia;
   sbnExcluir.Enabled                    := PermiteAlterar and not TabelaRomaneioVazia;
   sbnIncluirItensRomaneio.Enabled      := PermiteAlterar and not TabelaRomaneioVazia;
   sbnExcluirItensRomaneio.enabled      := PermiteAlterar and not TabelaRomaneioVazia;
//   sbnIncluirRomaneiosCupons.Enabled     := PermiteAlterar and not TabelaRomaneioVazia;
//   sbnExcluirRomaneiosCupons.enabled     := PermiteAlterar and not TabelaRomaneioVazia;
   sbnIncluirMultiplosItensRomaneio.Enabled     := PermiteAlterar and not TabelaRomaneioVazia;

   sbnVisualizarAssinatura.enabled := not qryItensRomaneiodata_hora_recebimento.isnull;

   sbnConferir.enabled := PermiteAlterar and not TabelaRomaneioVazia and not sbnSalvar.enabled;
  end;
end;

procedure TfrmCadastroRomaneio.sbnCancelarPagamentoClick(Sender: TObject);
var
  UsuarioAut: TtecUsuarios;
  CancelarPagamentoRomaneio: Boolean;
begin
  inherited;
  if UsuarioLogin.GerenteEstoque then
    CancelarPagamentoRomaneio := True
  else begin
    try
      UsuarioAut := dtmCadastroRomaneios.ObterAutorizacao(taLOGIN,ctGERENTEESTOQUE,ctAUTORIZADO);
      try
        if Assigned(UsuarioAut) then
          CancelarPagamentoRomaneio := UsuarioAut.GerenteEstoque
        else begin
          CancelarPagamentoRomaneio := False;
          MensagemAviso(Format(ctUSUARIOSEMCADASTRO, ['']))
        end
      finally
        if Assigned(UsuarioAut) then
          UsuarioAut.Free;
      end
    except
      CancelarPagamentoRomaneio := False
    end
  end;
  if CancelarPagamentoRomaneio then begin
    if MensagemConfirmacao(ctCANCELARPAGAMENTOROMANEIO)= smbOK then
      dtmCadastroRomaneios.CancelarPagamentoRomaneios;
  end else begin
    MensagemAviso(Format(ctUSUARIONAOAUTORIZADO, [ctCANCELARPAGAMENTOROMANEIO]));
    if Assigned(ActiveControl) then
      ActiveControl.SetFocus
    else
      edfNumero.SetFocus
  end
end;

procedure TfrmCadastroRomaneio.sbnEntregarClick(Sender: TObject);
begin
    frmLerData := TfrmLerData.Create(frmLerData, ctTITULOENTREGAITENSROMANEIO);
    if frmLerData.ShowModal = mrok then
      dtmCadastroRomaneios.EntregarRomaneios(frmLerData.Data);
    frmLerData.free;
end;


procedure TfrmCadastroRomaneio.KeyDown(var Key: Word; Shift: TShiftState);
begin
  inherited;
  case Key of
    VK_F7     : if sbnImprimir.Enabled then sbnImprimir.Click;
    VK_F11    : if sbnEntregar.Enabled then sbnEntregar.Click;
  end;
end;

function TfrmCadastroRomaneio.AcionaCadastroItensRomaneio(
  Editar: Boolean): boolean;
begin
  result := false;
  with dtmCadastroRomaneios do
  begin
   if PermiteAlterarDocumento then
   begin
    if not Assigned (frmCadastroItensRomaneio) then
     frmCadastroItensRomaneio:=TfrmCadastroItensRomaneio.create(frmCadastroItensRomaneio);

    with frmCadastroItensRomaneio do
    begin

     flkFilialEmissaoNota.Exist;
     flkFilialEmissaoCupom.Exist;
     flkSerie.Exist;
     flkRomaneioNCTipodeFrete.Exist;
     edfNotaFiscal.Exist;
     edfCupomFiscal.Exist;

     if (qryItensRomaneionumero_cupom.Value<>0) or
        (qryItensRomaneio.IsEmpty) then
     begin
      pgcNotasCupons.ActivePage := tstCuponsFiscais;
      //flkFilialEmissaoCupom.SetFocus;
     end
     else
     begin
      pgcNotasCupons.ActivePage := tstNotasFiscais;
      //flkFilialEmissaoNota.SetFocus;
     end;
     if not Editar or qryItensRomaneio.IsEmpty then
      result := dtmCadastroRomaneios.IncluirItensRomaneio
     else
      LerNotasCuponsIncluidos(False);


     ShowModal;
     free;
    end;
    dbgItensRomaneio.SetFocus;
   end;
  end;
end;

function TfrmCadastroRomaneio.AcionaMultiplosCadastroItensRomaneio: boolean;
begin

  result := false;
  with dtmCadastroRomaneios do
  begin
   if PermiteAlterarDocumento then
   begin
    if not Assigned (frmSelecaoMultiplasNotasRomaneio) then
     frmSelecaoMultiplasNotasRomaneio := TfrmSelecaoMultiplasNotasRomaneio.create(frmSelecaoMultiplasNotasRomaneio);

    with frmSelecaoMultiplasNotasRomaneio do
    begin
     dtmCadastroRomaneios.qryNotasRomaneio.Close;
     frmSelecaoMultiplasNotasRomaneio.pgcConsultaNotaseCupons.ActivePageindex := 0;
     ShowModal;
     free;
    end;

    dbgItensRomaneio.SetFocus;
   end;
  end;

end;

procedure TfrmCadastroRomaneio.sbnIncluirMultiplosItensRomaneioClick(
  Sender: TObject);
begin
  inherited;
  AcionaMultiplosCadastroItensRomaneio;
end;

procedure TfrmCadastroRomaneio.sbnVisualizarAssinaturaClick(Sender: TObject);

var
  MemoryStream: TMemoryStream;
begin
  inherited;

  with dtmCadastroRomaneios do
  begin
    qryAssinaturaItensRomaneio.close;
    qryAssinaturaItensRomaneio.parambyname('dadofiscal').asinteger :=
      qryItensRomaneioDadoFiscal.AsInteger;
    qryAssinaturaItensRomaneio.open;

    if not qryAssinaturaItensRomaneioassinatura_recebimento.isnull then
    begin
      MemoryStream := TMemoryStream.Create;
      qryAssinaturaItensRomaneioassinatura_recebimento.SaveToStream(MemoryStream);
      AcionarTelaVisualizarImageBase64(self, MemoryStream);
    end;

  end;
end;

procedure TfrmCadastroRomaneio.sbnConferirClick(Sender: TObject);
begin
  inherited;
  with dtmCadastroRomaneios do
    ConferirVolumesDadosFiscais(qryItensRomaneio, qryItensRomaneioromaneio.fieldname,
     qryItensRomaneiodadofiscal.FieldName, 'ROS', qryItensRomaneioromaneio.AsString);

  edfNumero.exist;
  
end;

end.
