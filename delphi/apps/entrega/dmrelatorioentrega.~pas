unit dmrelatorioentrega;

interface

uses
  SysUtils, Classes, dmbasico, ZTransact, DB, ZQuery, ZPgSqlQuery, cpquery, dmtecsoft,
  fr_dset, fr_dbset, fr_class, biblio, ctconstantes, fmpreviewpadrao, Variants,
  frx2xto30, frxClass;

type
  Tdtmrelatorioentrega = class(TdtmBasico)
    qryRelatorioEntrega: TtecQuery;
    qryRelatorioEntregacliente: TIntegerField;
    qryRelatorioEntregatipocliente: TStringField;
    qryRelatorioEntreganomecliente: TStringField;
    qryRelatorioEntregaentrua: TStringField;
    qryRelatorioEntregaentnumero: TIntegerField;
    qryRelatorioEntregaentcomplemento: TStringField;
    qryRelatorioEntreganomebairroentrega: TStringField;
    qryRelatorioEntregaentcep: TIntegerField;
    qryRelatorioEntreganomecidadeentrega: TStringField;
    qryRelatorioEntregaproduto: TLargeintField;
    qryRelatorioEntregadescricaoproduto: TStringField;
    qryRelatorioEntregaquantidade: TFloatField;
    qryRelatorioEntregaquantidadeentregue: TFloatField;
    qryRelatorioEntreganomeregiao: TStringField;
    frpRelatorioEntrega: TfrReport;
    fdsRelatorioEntrega: TfrDBDataSet;
    qryRelatorioEntregacodigoregiao: TStringField;
    qryRelatorioEntregaentbairro: TIntegerField;
    qryRelatorioEntregaentestado: TStringField;
    qryRelatorioEntregaentcidade: TIntegerField;
    qryRelatorioEntregaaentregar: TFloatField;
    qryRelatorioEntregacontrato: TStringField;
    qryRelatorioEntregaemitirnotadepoisde: TDateField;
    qryRelatorioEntregafaturamento: TDateField;
    qryRelatorioEntregafilialvenda: TIntegerField;
    qryRelatorioEntregamontagemobs: TStringField;
    qryRelatorioEntregadataentrega: TDateField;
    qryRelatorioEntreganomediasemana: TStringField;
    frxReport1: TfrxReport;
    procedure frpRelatorioEntregaBeforePrint(Memo: TStringList;
      View: TfrView);
  private
    FParametroCabecalho: String;
    { Private declarations }
  public
    { Public declarations }
    procedure ImprimirRelatorio(DataInicialVenda, DataFinalVenda,
                                DataInicialEntrega, DataFinalEntrega,
                                ListaClientes,
                                ListaFornecedoresTransporte,
                                ListaRegioes: String; Tipo: integer);
    property ParametroCabecalho: String  read  FParametroCabecalho write FParametroCabecalho;
  end;

var
  dtmrelatorioentrega: Tdtmrelatorioentrega;

implementation

{$R *.dfm}

procedure Tdtmrelatorioentrega.ImprimirRelatorio(DataInicialVenda, DataFinalVenda,
  DataInicialEntrega, DataFinalEntrega,
  ListaClientes,
  ListaFornecedoresTransporte,
  ListaRegioes: String; Tipo: integer);
begin
  ParametroCabecalho := '';

  if (DataInicialEntrega<>'') and (DataFinalEntrega<>'') then
  begin
    qryRelatorioEntrega.MacroByName('IntervaloDataEntrega').AsString :=  format('and pc.dataentrega between ''%s'' and ''%s''',
                        [FormatDateTime('yyyy-mm-dd',strtodatetime(DataInicialEntrega)),
                         FormatDateTime('yyyy-mm-dd',strtodatetime(DataFinalEntrega))]);
    ParametroCabecalho:=ParametroCabecalho+'ENTREGAS ENTRE: '+DataInicialEntrega+' E '+DataFinalEntrega;
  end
  else
  if (DataInicialEntrega<>'') and (DataFinalEntrega='') then
  begin
    qryRelatorioEntrega.MacroByName('IntervaloDataEntrega').AsString :=  format('and pc.dataentrega >= ''%s''',
                        [FormatDateTime('yyyy-mm-dd',strtodatetime(DataInicialEntrega))]);
    ParametroCabecalho:=ParametroCabecalho+'ENTREGA SUPERIOR A '+DataInicialEntrega;
  end
  else
  if (DataInicialEntrega='') and (DataFinalEntrega<>'') then
  begin
    qryRelatorioEntrega.MacroByName('IntervaloDataEntrega').AsString :=  format('and pc.dataentrega <= ''%s''',
                        [FormatDateTime('yyyy-mm-dd',strtodatetime(DataFinalEntrega))]);
    ParametroCabecalho:=ParametroCabecalho+'ENTREGAS ATÉ '+DataFinalEntrega;
  end
  else
  if (DataInicialEntrega='') and (DataFinalEntrega='') then
    qryRelatorioEntrega.MacroByName('IntervaloDataEntrega').AsString :='';


  if (DataInicialVenda<>'') and (DataFinalVenda<>'') then
  begin
    qryRelatorioEntrega.MacroByName('IntervaloDataVenda').AsString :=  format('and ct.data between ''%s'' and ''%s''',
                        [FormatDateTime('yyyy-mm-dd',strtodatetime(DataInicialVenda)),
                         FormatDateTime('yyyy-mm-dd',strtodatetime(DataFinalVenda))]);
    ParametroCabecalho:=ParametroCabecalho+'VENDA ENTRE: '+DataInicialVenda+' E '+DataFinalVenda;
  end
  else
  if (DataInicialVenda<>'') and (DataFinalVenda='') then
  begin
    qryRelatorioEntrega.MacroByName('IntervaloDataVenda').AsString :=  format('and ct.data >= ''%s''',
                        [FormatDateTime('yyyy-mm-dd',strtodatetime(DataInicialVenda))]);
    ParametroCabecalho:=ParametroCabecalho+'VENDA SUPERIOR A '+DataInicialVenda;
  end
  else
  if (DataInicialVenda='') and (DataFinalVenda<>'') then
  begin
    qryRelatorioEntrega.MacroByName('IntervaloDataVenda').AsString :=  format('and ct.data <= ''%s''',
                        [FormatDateTime('yyyy-mm-dd',strtodatetime(DataFinalVenda))]);
    ParametroCabecalho:=ParametroCabecalho+'VENDAS ATÉ '+DataFinalVenda;
  end
  else
  if (DataInicialVenda='') and (DataFinalVenda='') then
    qryRelatorioEntrega.MacroByName('IntervaloDataVenda').AsString :='';


  if ListaClientes <> '' then
  begin
    qryRelatorioEntrega.MacroByName('ListaClientes').AsString := 'and ('+ListaClientes+')';
    ParametroCabecalho:=ParametroCabecalho+' LISTA DE CLIENTES: '+ListaClientes;
  end
  else
    qryRelatorioEntrega.MacroByName('ListaClientes').AsString := '';

  if ListaFornecedoresTransporte <> '' then
  begin
    qryRelatorioEntrega.MacroByName('ListaFornecedoresTransporte').AsString := 'and ('+
       StringReplace(ListaFornecedoresTransporte, 'vf.', 'vft.',[rfReplaceAll]) +')';
    ParametroCabecalho:=ParametroCabecalho+' LISTA DE FORNECEDORES: '+ListaFornecedoresTransporte;
  end
  else
    qryRelatorioEntrega.MacroByName('ListaFornecedoresTransporte').AsString := '';

  if ListaRegioes <> '' then
  begin
    qryRelatorioEntrega.MacroByName('ListaRegioes').AsString := 'and ((b.regiao in ('+ListaRegioes+')) or (d.regiao in ('+ListaRegioes+')))';
    ParametroCabecalho:=ParametroCabecalho+' LISTA DE REGIÕES: '+ListaRegioes;
  end
  else
    qryRelatorioEntrega.MacroByName('ListaRegioes').AsString := '';

  qryRelatorioEntrega.MacroByName('CondicaoEntregue').AsString := '';
  qryRelatorioEntrega.MacroByName('CondicaoemAberto').AsString := '';

  frVariables['Outras']             := ParametroCabecalho;

  case tipo of
  // em Aberto
  0: begin
       qryRelatorioEntrega.MacroByName('CondicaoemAberto').AsString := 'and (quantidade - quantidadeentregue) > 0';
       frVariables['Titulo']:= 'RELAÇÃO DE PRODUTOS A ENTREGAR';
     end;
  // Entregues
  1: begin
       qryRelatorioEntrega.MacroByName('CondicaoemAberto').AsString := 'and quantidadeentregue > 0';
       frVariables['Titulo']:= 'RELAÇÃO DE PRODUTOS ENTREGUES';
     end
  end;

  qryRelatorioEntrega.Close;
  qryRelatorioEntrega.Open;

  frpRelatorioEntrega.DesignReport;
  frxReport1.DesignReport;


  if qryRelatorioEntrega.IsEmpty then
    MensagemAviso(Format(ctNENHUMREGISTROENCONTRADO,['Registro']))
  else
  begin
    AtribuirParametrosBaseRelatorio;
//    frpRelatorioEntrega.DesignReport;

    ImprimirRelatoriofast(null, null, MSimples, 0, [frpRelatorioEntrega], false, self);

  end;

end;

procedure Tdtmrelatorioentrega.frpRelatorioEntregaBeforePrint(
  Memo: TStringList; View: TfrView);
begin
  inherited;
  ZebrarLinhaRelatorio(frpRelatorioEntrega,View);
end;

end.
