  object qryRomaneios: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryRomaneiosCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'SQLEmissao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SQLFornecedor'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SQLTipo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SQLSituacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';SELECT * FROM'
      '('
      'select r.numero,'
      '       r.tipo,'
      '       r.fornecedor,'
      '       r.emissao,'
      ''
      '       (select max(d.datapagto)'
      '        from duplicatas d'
      '        where d.documentopag = r.documentopag) as datapagto,'
      ''
      '       (select sum(d.valorpagto)'
      '        from duplicatas d'
      '        where d.documentopag = r.documentopag) as valorpagto,'
      ''
      '       (select f.razao'
      '        from fornecedores f'
      '        where r.fornecedor=f.codigo) as nomefornecedor,'
      ''
      '       (select sum(rn.valor)'
      '        from romaneiosnotas rn'
      '        where r.numero = rn.romaneio) as totalromaneio,'
      ''
      '       (select sum(rn.valor)'
      '        from romaneiosnotas rn'
      '        where rn.romaneio = r.numero'
      '          and not rn.cancelado'
      '          and rn.entrega is not null) as valorentregue,'
      ''
      '       (select sum(rn.valor)'
      '        from romaneiosnotas rn'
      '        where rn.romaneio = r.numero'
      '          and not rn.cancelado'
      '          and rn.entrega is null) as  valoraentregar'
      ''
      'from romaneios r'
      ''
      '%SQLEmissao'
      '%SQLFornecedor'
      '%SQLTipo'
      '%SQLSituacao'
      ''
      ') AS Rom'
      
        'order by UPPER(TO_ASCII(Rom.nomefornecedor,'#39'LATIN1'#39')), Rom.numer' +
        'o')
    RequestLive = True
    Left = 352
    Top = 16
