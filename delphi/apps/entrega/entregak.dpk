package entregak;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$SONAME 'entrega'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  visualclx,
  repositoriok;

contains
  dmcadastroromaneios in 'dmcadastroromaneios.pas' {dtmCadastroRomaneios: TDataModule},
  dmcadastrotabelafretes in 'dmcadastrotabelafretes.pas' {dtmCadastroTabelaFretes: TDataModule},
  fmcadastroromaneios in 'fmcadastroromaneios.pas' {frmCadastroRomaneio},
  fmcadastrotabelafretes in 'fmcadastrotabelafretes.pas' {frmCadastroTabelaFretes},
  rgentrega in 'rgentrega.pas',
  dmquitacaoromaneios in 'dmquitacaoromaneios.pas' {dtmQuitacaoRomaneios: TDataModule},
  fmquitacaoromaneios in 'fmquitacaoromaneios.pas' {frmQuitacaoRomaneios},
  dmrelatorioromaneios in 'dmrelatorioromaneios.pas' {dtmrelatorioromaneios: TDataModule},
  fmrelatorioromaneios in 'fmrelatorioromaneios.pas' {frmRelatorioRomaneios},
  fmLerTipoRelatorio in 'fmLerTipoRelatorio.pas' {frmLerTipoRelatorio},
  fmcadastroitensromaneio in 'fmcadastroitensromaneio.pas' {frmCadastroItensRomaneio},
  fmrelatoriofretes in 'fmrelatoriofretes.pas' {frmRelatorioFretes};

end.
