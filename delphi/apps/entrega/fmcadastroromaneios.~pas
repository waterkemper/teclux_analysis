procedure TfrmCadastroRomaneio.sbnVisualizarAssinaturaClick(Sender: TObject);

var
  MemoryStream: TMemoryStream;
begin
  inherited;

  with dtmCadastroRomaneios do
  begin
    qryAssinaturaItensRomaneio.close;
    qryAssinaturaItensRomaneio.parambyname('dadofiscal').asinteger :=
      qryItensRomaneioDadoFiscal.AsInteger;
    qryAssinaturaItensRomaneio.open;

    if not qryAssinaturaItensRomaneioassinatura_recebimento.isnull then
    begin
      MemoryStream := TMemoryStream.Create;
      qryAssinaturaItensRomaneioassinatura_recebimento.SaveToStream(MemoryStream);
      AcionarTelaVisualizarImageBase64(self, MemoryStream);
    end;

  end;
end;

procedure TfrmCadastroRomaneio.sbnConferirClick(Sender: TObject);
begin
  inherited;
  with dtmCadastroRomaneios do
  begin
    ReabrirRomaneio;
    if PermiteAlterarDocumento then
    begin
      if dtmCadastroRomaneios.qryRomaneiossituacao_romaneio.asString = 'PASSAGEM' then

        ConferirVolumesDadosFiscais(qryItensRomaneio, qryItensRomaneioromaneio.fieldname,
         qryItensRomaneiodadofiscal.FieldName, 'RPS', {Romaneio de passagem Saida}
         RetornarListaTString(qryItensRomaneio, qryItensRomaneioromaneio, qryItensRomaneiodadofiscalnaocancelado, true), qryRomaneiostipo.asString)

      else

        ConferirVolumesDadosFiscais(qryItensRomaneio, qryItensRomaneioromaneio.fieldname,
         qryItensRomaneiodadofiscal.FieldName, 'ROS', {Romaneio de saida}
         RetornarListaTString(qryItensRomaneio, qryItensRomaneioromaneio, qryItensRomaneiodadofiscalnaocancelado, true), qryRomaneiostipo.asString);

      self.setfocus;
      DBAdvGridItensRomaneio.setfocus;
      dtmCadastroRomaneios.ReabrirRomaneio;

    end;
  end;

end;

procedure TfrmCadastroRomaneio.OperacaoPadrao(Value: array of Variant);
begin
  inherited;
  if Length(Value) > 0 then
  begin
    if Value[0] = 'Abrir' then
      dtmCadastroRomaneios.RefazConsultaRomaneio(Value[1])
    else
    if Value[0] = 'Reabrir' then
    begin
      if (dtmCadastroRomaneios.qryRomaneiosnumero.asinteger = Value[1]) or (dtmCadastroRomaneios.qryRomaneiosnumero.asinteger = 0) then
        dtmCadastroRomaneios.RefazConsultaRomaneio(Value[1])
    end;
  end
end;

