procedure TfrmCadastroRomaneio.actAbilitarUpdate(Sender: TObject);
var
TabelaRomaneioVazia, TabelaItensRomaneiovazia: boolean;
begin
  inherited;
  with dtmCadastroRomaneios do
  begin
   TabelaRomaneioVazia := TabelaRomaneios.IsEmpty;
   TabelaItensRomaneiovazia := TabelaItensRomaneio.isEmpty;


   sbnImprimir.Enabled                      := NumeroRomaneio<>0;
   sbnProcurarfornecedor.Enabled            := PermiteAlterarDocumento and not TabelaRomaneioVazia;
   sbnExcluir.Enabled                       := PermiteExcluirDocumento and not TabelaRomaneioVazia;

   sbnIncluirItensRomaneio.Enabled          := PermiteAlterarDocumento and not TabelaRomaneioVazia and not TabelaRomaneiovazia;
   sbnExcluirItensRomaneio.enabled          := PermiteAlterarDocumento and PermiteExcluirItens and not TabelaItensRomaneiovazia;
   sbnIncluirMultiplosItensRomaneio.Enabled := PermiteAlterarDocumento and not TabelaRomaneioVazia and not TabelaRomaneiovazia;

   sbnVisualizarAssinatura.enabled := not qryItensRomaneiodata_hora_recebimento.isnull and
                                     (qryItensRomaneiodata_hora_recebimento.value = qryItensRomaneioaux_data_hora_recebimento.value)
                           and qryItensRomaneiousuario_data_hora_recebimento.isnull; {Qdo informado pelo romaneio é preenchido o usuaário (paliativo)}

   sbnConferir.enabled := PermiteAlterarDocumento and not TabelaRomaneioVazia and not sbnSalvar.enabled;

   sbnLiberarEntrega.enabled := (dtmCadastroRomaneios.qryRomaneiostipo.asString = 'N') and
                                (dtmCadastroRomaneios.qryRomaneiossituacao_romaneio.asString = 'CONFIRMADA') and
                                (dtmCadastroRomaneios.qryRomaneios.state = dsBrowse);

   sbnLiberarEntrega.visible := sbnLiberarEntrega.enabled;
   if sbnLiberarEntrega.visible then
     sbnLiberarEntrega.left := sbnProcurar.left + sbnProcurar.width;

   sbnReterEntrega.enabled := (dtmCadastroRomaneios.qryRomaneiostipo.asString = 'N') and
                                (dtmCadastroRomaneios.qryRomaneiossituacao_romaneio.asString = 'EM TRÂNSITO') and
                                (dtmCadastroRomaneios.qryRomaneios.state = dsBrowse);

   sbnReterEntrega.visible := sbnReterEntrega.enabled;
   if sbnReterEntrega.visible then
     sbnReterEntrega.left := sbnProcurar.left + sbnProcurar.width;


   {
   rgbTipoRomaneio.readonly := not (PermiteAlterarDocumento and TabelaItensRomaneiovazia);
   rbnTipoNormal.readonly := rgbTipoRomaneio.readonly;
   rbnTipoTransferencia.readonly := rgbTipoRomaneio.readonly;
   }

   sbnJustifcarEntrega.enabled := (dtmCadastroRomaneios.qryRomaneiostipo.asString = 'N')
                                  and

                                  ((dtmCadastroRomaneios.qryItensRomaneiosituacao_romaneio_saida.asString = 'EM TRÂNSITO') or
                                   (dtmCadastroRomaneios.qryItensRomaneiosituacao_romaneio_saida.asString = 'ENTREGUE PARCIAL') or
                                   (dtmCadastroRomaneios.qryItensRomaneiosituacao_romaneio_saida.asString = 'ENTREGUE') or
                                   (dtmcadastroromaneios.qryItensRomaneiosituacao_romaneio_saida.asString = 'ENTREGA NÃO EFETUADA'));

                                   (*
                                  and
                                  {dtmCadastroRomaneios.qryItensRomaneiodata_hora_recebimento.IsNull and}
                                  (dtmCadastroRomaneios.qryRomaneios.state = dsBrowse);
                                  *)


         {
   if dtmCadastroRomaneios.qryRomaneiostipo.readonly then
   begin
     if (dtmCadastroRomaneios.qryRomaneiostipo.asString = 'N') then
       rbnTipoNormal.enabled := true
     else
     if  rbnTipoNormal.enabled then
       rbnTipoNormal.enabled := false;


     if (dtmCadastroRomaneios.qryRomaneiostipo.asString = 'T') then
       rbnTipoTransferencia.enabled := true
     else
     if rbnTipoTransferencia.enabled then
       rbnTipoTransferencia.enabled := false;

   end;
   }

  end;

end;

procedure TfrmCadastroRomaneio.sbnCancelarPagamentoClick(Sender: TObject);
var
  UsuarioAut: TtecUsuarios;
  CancelarPagamentoRomaneio: Boolean;
begin
  inherited;
  if UsuarioLogin.GerenteEstoque then
    CancelarPagamentoRomaneio := True
  else begin
    try
      UsuarioAut := dtmCadastroRomaneios.ObterAutorizacao(taLOGIN,ctGERENTEESTOQUE,ctAUTORIZADO);
      try
        if Assigned(UsuarioAut) then
          CancelarPagamentoRomaneio := UsuarioAut.GerenteEstoque
        else begin
          CancelarPagamentoRomaneio := False;
          MensagemAviso(Format(ctUSUARIOSEMCADASTRO, ['']))
        end
      finally
        if Assigned(UsuarioAut) then
          UsuarioAut.Free;
      end
    except
      CancelarPagamentoRomaneio := False
    end
  end;
  if CancelarPagamentoRomaneio then begin
    if MensagemConfirmacao(ctCANCELARPAGAMENTOROMANEIO)= smbOK then
      dtmCadastroRomaneios.CancelarPagamentoRomaneios;
  end else begin
    MensagemAviso(Format(ctUSUARIONAOAUTORIZADO, [ctCANCELARPAGAMENTOROMANEIO]));
    if Assigned(ActiveControl) then
      ActiveControl.SetFocus
    else
      edfNumero.SetFocus
  end
end;

