procedure TfrmCadastroRomaneio.rbnEmitenteClick(Sender: TObject);
begin
  inherited;
  try
   {Somente para atender a alguma necessidade de troca de frete}

    rbnEmitente.OnClick := nil;
    rbnDestinatario.OnClick := nil;

    with dtmCadastroRomaneios do
    begin
      if qryRomaneios.ReadOnly then
      begin
        qryRomaneios.ReadOnly       := false;
        SetReadOnlyFields(qryRomaneios, True);
        qryRomaneiostipo.readonly := False;
        qryRomaneios.edit;

        {Inversão abaixo}
        if rbnEmitente.checked and (qryRomaneiosfrete.asinteger = 1) then
          qryRomaneiosfrete.asinteger := strtoint(rbnDestinatario.value)
        else
          qryRomaneiosfrete.asinteger := strtoint(rbnEmitente.value);
      end;
    end;
  finally
    rbnEmitente.OnClick := rbnEmitenteClick;
    rbnDestinatario.OnClick := rbnEmitenteClick;
  end;

end;

