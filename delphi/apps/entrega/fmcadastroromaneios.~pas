  inherited;

  if TDBAdvGrid(Sender).Columns[Acol].Field.FieldName = 'data_hora_recebimento' then
  begin
    FormControlEditLink1.Control := AdvDBDateTimePicker1;
    if dtmCadastroRomaneios.qryItensRomaneiodata_hora_recebimento.isnull then
      AdvDBDateTimePicker1.datetime := dtmCadastroRomaneios.DataHoraServidor;

