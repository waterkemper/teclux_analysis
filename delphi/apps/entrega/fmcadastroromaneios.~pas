    AdvDBDateTimePicker2.MinDate := dtmCadastroRomaneios.qryRomaneiosdatahoratransito.asDateTime-1;
    AdvDBDateTimePicker2.MaxDate := dtmCadastroRomaneios.qryRomaneiosdatahoratransito.asDateTime + 30;

  end
  else
  if TDBAdvGrid(Sender).Columns[Acol].Field.FieldName = 'horaentrega' then
  begin
    FormControlEditLink1.Control := AdvDBDateTimePicker3;
    if dtmCadastroRomaneios.qryItensRomaneiohoraentrega.isnull then
      AdvDBDateTimePicker3.datetime := dtmCadastroRomaneios.DataHoraServidor
  end;


