//    AdvDBDateTimePicker1.
//    TDateTimePicker(AdvDBDateTimePicker1).MinDate := AdvDBDateTimePicker1.MinDate;
//    TCommonCalendar(AdvDBDateTimePicker1).Refresh;

    AdvDBDateTimePicker1.MaxDate := dtmCadastroRomaneios.qryRomaneiosdatahoratransito.asDatetime + 60;
    AdvDBDateTimePicker1.MinDate := dtmCadastroRomaneios.qryRomaneiosdatahoratransito.asDatetime - 60;


  end
  else
  if TDBAdvGrid(Sender).Columns[Acol].Field.FieldName = 'dataentrega' then
  begin
