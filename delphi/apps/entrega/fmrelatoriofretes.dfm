  object qryrlfrete: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryrlfreteAfterOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereFornecedor'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Wherecliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereListaFornecedores'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereOrdenacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select r.fornecedor,'
      '       f.nome as nomefornecedor,'
      '       rn.valor,'
      '       df.data,'
      '       df.cliente,'
      '       vf.nome as nomecliente,'
      '       df.valortotal,'
      '       df.totalvaloricmssubstituicao,'
      '       n.filial as filialnotafiscal,'
      '       n.numero as notafiscal,'
      '       n.serie,'
      '       cf.filial as filialcupomfiscal,'
      '       cf.maquina,'
      '       cf.intervensao,'
      '       cf.numero as cupomfiscal,'
      '       f.grupofornecedor,'
      '       gf.nome as nomegrupofornecedor,'
      '       0  as nlinhas'
      'from ((romaneios r'
      
        '       join (fornecedores f left join gruposfornecedores gf on f' +
        '.grupofornecedor = gf.codigo)'
      '            on r.fornecedor = f.codigo)'
      '       join (romaneiosnotas rn'
      '             join (((dadosfiscais df'
      '                     join vfornecedores vf'
      '                     on df.cliente = vf.codigo'
      '                        and df.tipocliente = vf.tipo)'
      
        '                   LEFT JOIN notas n on df.numero = n.dadofiscal' +
        ')'
      
        '                   LEFT JOIN cupons cf on df.numero = cf.dadofis' +
        'cal)'
      '             on rn.dadofiscal = df.numero)'
      '       on r.numero = rn.romaneio)'
      'where r.Emissao between :DataInicial and :DataFinal'
      ' %WhereFornecedor'
      ' %WhereCliente'
      ' %WhereListaFornecedores'
      ''
      '%WhereOrdenacao')
    RequestLive = True
    Left = 336
    Top = 8
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
