    while true do
    begin
      if NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%ListadeFornecedores',false)<>-1 then
        qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%ListadeFornecedores')] :=
        ' and (c.codigo in (select fp.caracteristica               '+
        '                   from fornecedoresprodutos fp           '+
        '                        join vfornecedores vf             '+
        '                        on fp.fornecedor = vf.codigo      '+
        '                        and vf.tipo = ''''F''''               '+
        '                   where ' + trocar(ListadeFornecedores,'''','''''') + '))'
      else
        break;
    end;
  end
  else
  begin
    while true do
    begin
      if NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%ListadeFornecedores',false)<>-1 then
        qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%ListadeFornecedores')] := ''
      else
        break;
    end;

  end;


  SQLFiltrosNotas := '';

  if not DataEmBranco(DataNotaInicial) and (DataEmBranco(DataNotaFinal)) then
    SQLFiltrosNotas:= SQLFiltrosNotas + 'and np.data >= '+''''''+FormatDateTime('yyyy-MM-dd',strtoDate(DataNotaInicial))+''''''
  else if DataEmBranco(DataNotaInicial) and not (DataEmBranco(DataNotaFinal)) then
    SQLFiltrosNotas:= SQLFiltrosNotas + 'and np.data <= '+''''''+FormatDateTime('yyyy-MM-dd',strtoDate(DataNotaFinal))+''''''
  else if not (DataEmBranco(DataNotaInicial)) and not (DataEmBranco(DataNotaFinal)) then
    SQLFiltrosNotas:= SQLFiltrosNotas + 'and np.data between '+''''''+FormatDateTime('yyyy-MM-dd',strtoDate(DataNotaInicial))+''''''+' and '+
                                                               ''''''+FormatDateTime('yyyy-MM-dd',strtoDate(DataNotaFinal))+'''''';

  if (ListaCondicionalNotasEntrada <> '') or (SQLFiltrosNotas<>'') then
  begin
    if ListaCondicionalNotasEntrada<>'' then
        SQLFiltrosNotas := SQLFiltrosNotas + 'and ' + trocar(ListaCondicionalNotasEntrada,'''','''''');

    while true do
    begin
      if NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%ListaCondicionalNotasEntrada',false)<>-1 then
      begin

        qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%ListaCondicionalNotasEntrada')] :=
        ' and (p.codigo in (select pnp.produto                     '+
        '                   from notaspag np                       '+
        '                        join produtosnotaspag pnp         '+
        '                        on np.codigo = pnp.codigonota     '+
        '                   where true ' + SQLFiltrosNotas + '))'
      end
      else
        break;
    end;
  end
  else
  begin
    while true do
    begin
      if NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%ListaCondicionalNotasEntrada',false)<>-1 then
        qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%ListaCondicionalNotasEntrada')] := ''
      else
        break;
    end;
  end;



  CondicoesProdutos := '';

  if ProdutoEmLinha and not produtoForadeLinha then
     CondicoesProdutos := CondicoesProdutos + ' and  not p.foralinhal and not c.foralinhal'
  else
  if produtoForadeLinha and not produtoemlinha then
     CondicoesProdutos := CondicoesProdutos + ' and  (p.foralinhal or c.foralinhal)';

  if ProdutoAtivo and not produtoInativo then
     CondicoesProdutos := CondicoesProdutos + ' and  (not (p.inativo is not null))'
  else
  if produtoInativo and not produtoAtivo then
     CondicoesProdutos := CondicoesProdutos + ' and  (p.inativo is not null)';

  if ProdutoComMontagem and not ProdutoSemMontagem then
     CondicoesProdutos := CondicoesProdutos + ' and (c.montagem)'
  else
  if ProdutoSemMontagem and not ProdutoComMontagem then
     CondicoesProdutos := CondicoesProdutos + ' and not (c.montagem)';

  if ProdutoBrinde and not ProdutoNaoBrinde then
     CondicoesProdutos := CondicoesProdutos + ' and (c.brinde)'
  else
  if ProdutoNaoBrinde and not ProdutoBrinde then
     CondicoesProdutos := CondicoesProdutos + ' and not (c.brinde)';

  if DisponivelnoSite and not NaoDisponivelnoSite then
     CondicoesProdutos := CondicoesProdutos + ' and (p.aparecernosite)'
  else
  if NaoDisponivelnoSite and not DisponivelnoSite then
     CondicoesProdutos := CondicoesProdutos + ' and not (p.aparecernosite)';


  if CondicoesProdutos <> '' then
  begin

    while true do
    begin
      if NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%CondicoesProdutos',false)<>-1 then
        qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%CondicoesProdutos')] :=  CondicoesProdutos
      else
        break;
    end;
  end
  else
  begin
    while true do
    begin
      if NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%CondicoesProdutos',false)<>-1 then
        qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%CondicoesProdutos')] := ''
      else
        break;
    end;

  end;

  if SomenteComEstoque then
  begin
    while true do
    begin
      if NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%SomenteComEstoque',false)<>-1 then
        qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%SomenteComEstoque')] :=
          ' and (select sum(emestoque+reservado+conserto+demonstracao+reservaprevia+futuro) from estoques where estoques.produto=p.codigo)>0 '
      else
        break;
    end;
  end
  else
  begin
    while true do
    begin
      if NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%SomenteComEstoque',false)<>-1 then
        qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%SomenteComEstoque')] :=
          ' and (select sum(emestoque+reservado+conserto+demonstracao+reservaprevia+futuro) from estoques where estoques.produto=p.codigo)>0 '

      else
        break;
    end;
  end;

  case compostos of
   0: begin
        while true do
        begin
          if NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%Compostos',false)<>-1 then
            qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%Compostos')] := ''
          else
            break;
        end;
      end;

   1: begin
        while true do
        begin
          if NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%Compostos',false)<>-1 then
            qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%Compostos')] :=
              ' and not (coalesce(c.composto,false))'
          else
            break;
        end;
      end;


   2: begin
       while true do
        begin
          if NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%Compostos',false)<>-1 then
            qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%Compostos')] :=
              ' and (coalesce(c.composto,false))'
          else
            break;
        end;
      end;

  end;

  if (FilialMovimentacao<>'') or
     (TipoMovimentacao<>'') or
     (DataMovtoInicial<>'') or
     (DataMovtoFinal<>'') then
  begin
       while true do
       begin
          if NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%Movimentacao',false)<>-1 then
            qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%Movimentacao')] :=
              MontaCondicaoMovimentacao
          else
            break;
       end;
  end
  else
  begin
       while true do
       begin
         if NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%Movimentacao',false)<>-1 then
           qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%Movimentacao')] := ''
         else
            break;
       end;
  end;

  {
  if ColunadePreco
  }


  case Ordenacao of
     0: qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%ordenacao')] := 'order by  produtovisual, produto, caracteristica, precoproduto, descricao_produto, preco, descricao_preco, cargo, descricao_cargo,  valoranterior, valoratual, data, valor ';
     1: qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%ordenacao')] := 'ORDER BY UPPER(TO_ASCII(descricao_produto,''''LATIN1'''')), produtovisual, produto, caracteristica, precoproduto, preco, descricao_preco, cargo, descricao_cargo,  valoranterior, valoratual, data, valor ';
  end;

  

  qryAlteracoesPrecosCargos.close;
  qryAlteracoesPrecosCargos.open;

  vListaProduto := RetornarLista(qryAlteracoesPrecosCargos, qryAlteracoesPrecosCargos.fieldbyname('produto'),nil, true);

  vListaCaracteristicaPreco := RetornarLista(qryAlteracoesPrecosCargos,
                   [qryAlteracoesPrecosCargos.fieldbyname('caracteristica'),
                    qryAlteracoesPrecosCargos.fieldbyname('preco')], nil, true);

  if vListaProduto <> '' then
  begin

    qryAlteracoesPrecosCargosVisaoParalela.macrobyname('ListadeProdutos').asString :=  ' and p.codigo in (' + vListaProduto + ')';

    qryAlteracoesPrecosCargosVisaoParalela.close;
    qryAlteracoesPrecosCargosVisaoParalela.open;

    qryConsultaEstoques.macrobyname('Filial').asString := 'and f.codigo = '+inttostr(filialbase);
    qryConsultaEstoques.macrobyname('Produto').asString := 'and p.codigo in ('+vListaProduto+')';

    qryPrecos.macrobyname('ListaCaracteristicas_e_Preco').asString :=

    ' and (cp.caracteristica, cp.preco) in ('+vListaCaracteristicaPreco+')';

    qryConsultaEstoques.close;
    qryConsultaEstoques.open;

    RefazConsultaPorNome(qryPrecos,['filial','colunanormal','colunapromocao'],
                                     [filialbase,
                                      preconormal,
                                      precopromocao], false);
  end;
end;

constructor TdtmAlteracoesPrecos.Create(AOwner: TComponent);
begin
  inherited;
end;


function TdtmAlteracoesPrecos.GetcodigoNotaProduto: int64;
begin
  result := 2147483647;
end;

function TdtmAlteracoesPrecos.GetProduto: String;
begin
  result := qryAlteracoesPrecosCargos.FieldByName('produto').asString;
end;

procedure TdtmAlteracoesPrecos.PosicionarTabela_AlteracoesPrecosCargos(
  vIdentificador: String);
begin
  qryAlteracoesPrecosCargos.locate('identificador', vIdentificador, [])

{  if qryAlteracoesPrecosCargos.locate('identificador', vIdentificador, []) then
    if qryAlteracoesPrecosCargosVisaoParalela.locate('identificador', vIdentificador, []) then
      qryAlteracoesPrecosCargosVisaoParalela.locate('identificador', vIdentificador, []);}


end;

procedure TdtmAlteracoesPrecos.qryAlteracoesPrecosCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  qryAlteracoesPrecosprodutovisualdescricao.asString := qryAlteracoesPrecosprodutovisual.asString + ' ' +
          qryAlteracoesPrecosdescricao_produto.asString;
end;


procedure TdtmAlteracoesPrecos.qryAlteracoesPrecosCargosAfterOpen(
  DataSet: TDataSet);
var
i:integer;
begin
  inherited;

  {
  qryAlteracoesPrecosCargos.fieldbyname('identificador').visible := false;
  qryAlteracoesPrecosCargos.fieldbyname('identificador').Displaywidth := 0;

  qryAlteracoesPrecosCargos.fieldbyname('produto').visible := false;
  qryAlteracoesPrecosCargos.fieldbyname('produto').Displaywidth := 0;

  qryAlteracoesPrecosCargos.fieldbyname('preco').visible := false;
  qryAlteracoesPrecosCargos.fieldbyname('preco').Displaywidth := 0;

  TFloatField(qryAlteracoesPrecosCargos.fieldbyname('valor')).displayformat := '###,##0.00';
  TFloatField(qryAlteracoesPrecosCargos.fieldbyname('markup')).displayformat := '###,##0.00';

  for i:=10 to qryAlteracoesPrecosCargos.fieldcount-1 do
    TFloatField(qryAlteracoesPrecosCargos.fields[i]).displayformat := '###,##0.00';

  }

  qryAlteracoesPrecosCargos.fieldbyname('cargo').visible := false;
  qryAlteracoesPrecosCargos.fieldbyname('precoproduto').visible := false;
  qryAlteracoesPrecosCargos.fieldbyname('preco').visible := false;
  qryAlteracoesPrecosCargos.fieldbyname('produto').visible := false;
  qryAlteracoesPrecosCargos.fieldbyname('caracteristica').visible := false;
  qryAlteracoesPrecosCargos.fieldbyname('identificador').visible := false;
  qryAlteracoesPrecosCargos.fieldbyname('VariacaoPrecoAtualeAnterior').visible := false;

end;

procedure TdtmAlteracoesPrecos.qryAlteracoesPrecosCargosAfterScroll(
  DataSet: TDataSet);
  {
var
 vCodigo : String;
   }
{
  var
   vArrayProdutos : TVariantArray;
   }

begin
  inherited;

  {
  with dtmConsultaEstoque do
  begin

     if qryConsultaEstoques.macrobyname('produto').asString <> 'and ( p.codigo = ' + qryAlteracoesPrecosCargos.fieldbyname('produto').asString + ' and e.filial = '+ inttostr(filialbase) +')' then
     begin
       qryConsultaEstoques.macrobyname('produto').asString := 'and ( p.codigo = ' + qryAlteracoesPrecosCargos.fieldbyname('produto').asString + ' and e.filial = '+ inttostr(filialbase) +')';
       qryConsultaEstoques.close;
       qryConsultaEstoques.open;


      RefazConsultaPorNome(qryPrecos,['caracteristica','preco','filial','colunanormal','colunapromocao'],
                                     [qryAlteracoesPrecosCargos.fieldByName('caracteristica').asString,
                                      qryAlteracoesPrecosCargos.fieldByName('precoproduto').asString,
                                      filialbase,
                                      preconormal,
                                      precopromocao], true);

     end;

  end;
  }

end;

end.
