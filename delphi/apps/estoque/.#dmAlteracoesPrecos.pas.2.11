      qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, ':DataFinal')] := ''''''+FormatDateTime('yyyy-MM-dd',strtoDate(DataFinal))+''''''
    else
