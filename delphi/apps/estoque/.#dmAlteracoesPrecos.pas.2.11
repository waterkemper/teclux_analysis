        qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%ParametroListasPadrao')] :=

        ' and (p.codigo in (select plp.produto '+
                                          ' from produtoslistaspadrao plp '+
                                          '      join listaspadrao lp '+
                                          '      on plp.listapadrao = lp.codigo '+
                                          ' where ' + trocar(ParametroListasPadrao,'''','''''') + '))'



      else
