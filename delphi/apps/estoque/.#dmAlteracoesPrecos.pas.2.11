  function  MontaCondicaoMovimentacao: String;
  var SQLMovimentacao, SQLFiltroMovimento: String;
  begin
    SQLMovimentacao:= 'and (p.codigo in (Select m.produto from movimentos m where true ';

    SQLFiltroMovimento:= '';

    if FilialMovimentacao<>'' then
      SQLFiltroMovimento:= SQLFiltroMovimento + ' and m.filial = '+ FilialMovimentacao ;

    if TipoMovimentacao<>'' then
      SQLFiltroMovimento:= SQLFiltroMovimento + 'and m.tipomovimento = ''''' + TipoMovimentacao + '''''';

    if not DataEmBranco(DataMovtoInicial) and (DataEmBranco(DataMovtoFinal)) then
      SQLFiltroMovimento:= SQLFiltroMovimento + 'and m.data >= '+''''''+FormatDateTime('yyyy-MM-dd',strtoDate(DataMovtoInicial))+''''''
    else if DataEmBranco(DataMovtoInicial) and not (DataEmBranco(DataMovtoFinal)) then
      SQLFiltroMovimento:= SQLFiltroMovimento + 'and m.data <= '+''''''+FormatDateTime('yyyy-MM-dd',strtoDate(DataMovtoFinal))+''''''
    else if not (DataEmBranco(DataMovtoInicial)) and not (DataEmBranco(DataMovtoFinal)) then
      SQLFiltroMovimento:= SQLFiltroMovimento + 'and m.data between '+''''''+FormatDateTime('yyyy-MM-dd',strtoDate(DataMovtoInicial))+''''''+' and '+
                                                                 ''''''+FormatDateTime('yyyy-MM-dd',strtoDate(DataMovtoFinal))+'''''';

    if SQLFiltroMovimento <> '' then
    begin
      SQLMovimentacao:= SQLMovimentacao + SQLFiltroMovimento + '))';
      Result:= SQLMovimentacao;
    end
    else
      Result:= '';
  end;

begin

  qryAlteracoesPrecosCargos.sql.text := qryAlteracoesPrecosCargos_Auxiliar.sql.text;
  qryAlteracoesPrecosCargosVisaoParalela.sql.text := qryAlteracoesPrecosCargosVisaoParalela_Auxiliar.sql.text;

  if MargemLucro = '' then
  begin
    qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, ':MargemAtual_1')] := '''''''''';
    qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, ':MargemAtual_2')] := '0';
  end
  else
  begin
    qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, ':MargemAtual_1')] := '''''0''''';
    qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, ':MargemAtual_2')] :=  MargemLucro;
  end;

  if VariacaoPrecoAtualeAnterior = '' then
  begin
    qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, ':VariacaoPrecoAtualeAnterior_1')] := '''''''''';
    qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, ':VariacaoPrecoAtualeAnterior_2')] := '0';
