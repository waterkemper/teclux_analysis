    if NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, ':DataInicial',false)<>-1 then
      qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, ':DataInicial')] := ''''''+FormatDateTime('yyyy-MM-dd',strtoDate(DataInicial))+''''''
