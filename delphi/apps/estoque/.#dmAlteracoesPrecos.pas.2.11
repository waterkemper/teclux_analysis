  end;
  qryAlteracoesPrecosCargosVisaoParalela.parambyname('DataFinal').asDateTime := strtoDate(DataFinal);



  while true do
  begin
    if NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, ':DataAnterior',false)<>-1 then
      qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, ':DataAnterior')] := ''''''+FormatDateTime('yyyy-MM-dd',strtoDate(DataInicial)-1)+''''''
    else
      break;
  end;

//  qryAlteracoesPrecosCargosVisaoParalela.parambyname('DataAnterior').asDateTime := strtoDate(DataFinal)-1;

  if ListadeItemProdutos<>'' then
  begin

    while true do
    begin
      if NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%ListadeItemProdutos',false)<>-1 then
        qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, '%ListadeItemProdutos')] := ' and (' + trocar(ListadeItemProdutos,'''','''''') + ')'
      else
