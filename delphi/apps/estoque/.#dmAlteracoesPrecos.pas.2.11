    qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, ':VariacaoPrecoAtualeAnterior_1')] := '''''0''''';
    qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, ':VariacaoPrecoAtualeAnterior_2')] :=  VariacaoPrecoAtualeAnterior;
  end;

  qryAlteracoesPrecosCargos.Sql[NumerodalinhanoTexto(qryAlteracoesPrecosCargos.sql, ':ComparisonOperator')] :=  ComparisonOperator;


  while true do
