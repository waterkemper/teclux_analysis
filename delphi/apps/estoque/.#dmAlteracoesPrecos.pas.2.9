          qryAlteracoesPrecosdescricao_produto.asString;
end;


procedure TdtmAlteracoesPrecos.qryAlteracoesPrecosCargosAfterOpen(
  DataSet: TDataSet);
var
i:integer;
begin
  inherited;

  {
  qryAlteracoesPrecosCargos.fieldbyname('identificador').visible := false;
  qryAlteracoesPrecosCargos.fieldbyname('identificador').Displaywidth := 0;

  qryAlteracoesPrecosCargos.fieldbyname('produto').visible := false;
  qryAlteracoesPrecosCargos.fieldbyname('produto').Displaywidth := 0;

  qryAlteracoesPrecosCargos.fieldbyname('preco').visible := false;
  qryAlteracoesPrecosCargos.fieldbyname('preco').Displaywidth := 0;

  TFloatField(qryAlteracoesPrecosCargos.fieldbyname('valor')).displayformat := '###,##0.00';
  TFloatField(qryAlteracoesPrecosCargos.fieldbyname('markup')).displayformat := '###,##0.00';

  for i:=10 to qryAlteracoesPrecosCargos.fieldcount-1 do
    TFloatField(qryAlteracoesPrecosCargos.fields[i]).displayformat := '###,##0.00';

  }

  qryAlteracoesPrecosCargos.fieldbyname('cargo').visible := false;
  qryAlteracoesPrecosCargos.fieldbyname('precoproduto').visible := false;
  qryAlteracoesPrecosCargos.fieldbyname('preco').visible := false;
  qryAlteracoesPrecosCargos.fieldbyname('produto').visible := false;
  qryAlteracoesPrecosCargos.fieldbyname('caracteristica').visible := false;
  qryAlteracoesPrecosCargos.fieldbyname('identificador').visible := false;

end;

procedure TdtmAlteracoesPrecos.qryAlteracoesPrecosCargosAfterScroll(
  DataSet: TDataSet);
  {
var
 vCodigo : String;
   }
{
  var
   vArrayProdutos : TVariantArray;
   }

begin
  inherited;
  {
  vCodigo := qryAlteracoesPrecosCargos.fieldbyname('identificador').asString;

  if qryAlteracoesPrecosCargosVisaoParalela.active then
    qryAlteracoesPrecosCargosVisaoParalela.locate('identificador', vcodigo, []);
    }

  with dtmConsultaEstoque do
  begin
             {
    vArrayProdutos :=
    ValorCampodaTabela('produtos',
                   ['codigo'],
                   [qryAlteracoesPrecosCargos.fieldByName('produto').asVariant],
                   ['preco','caracteristica']);
                   }


     if qryConsultaEstoques.macrobyname('produto').asString <> 'and ( p.codigo = ' + qryAlteracoesPrecosCargos.fieldbyname('produto').asString + ' and e.filial = '+ inttostr(filialbase) +')' then
     begin
       qryConsultaEstoques.macrobyname('produto').asString := 'and ( p.codigo = ' + qryAlteracoesPrecosCargos.fieldbyname('produto').asString + ' and e.filial = '+ inttostr(filialbase) +')';
       qryConsultaEstoques.close;
       qryConsultaEstoques.open;


      RefazConsultaPorNome(qryPrecos,['caracteristica','preco','filial','colunanormal','colunapromocao'],
                                     [qryAlteracoesPrecosCargos.fieldByName('caracteristica').asString,
                                      qryAlteracoesPrecosCargos.fieldByName('precoproduto').asString,
                                      filialbase,
                                      preconormal,
                                      precopromocao], true);
       
     end;

  end;

end;

