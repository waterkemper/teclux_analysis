    Sql.Strings = (
      'Select p.codigo,'
      '       p.codigovisual,'
      '       p.descricao,'
      '       fp.nomefoto,'
      '       fp.nomethumb,'
      '       p.valorgrade1,'
      '       gr_lin.descricao as linha,'
      '       p.valorgrade2,'
      '       gr_col.descricao as coluna,'
      ''
      
        '       (select e.localizacao from estoques e where e.filial = :f' +
        'ilial and e.produto = p.codigo) as localizacao,'
      
        '       (select e.sublocalizacao from estoques e where e.filial =' +
        ' :filial and e.produto = p.codigo) as sublocalizacao'
      '       '
      ''
      'From   produtos p'
      '       join caracteristicas c'
      '            left join grades gr_lin on c.grade1 = gr_lin.codigo'
      '            left join grades gr_col on c.grade2 = gr_col.codigo'
      '       on p.caracteristica = c.codigo'
      ''
      '       left join fotosprodutos fp'
      '       on fp.produto = p.codigo'
      ''
      'where (p.codigo = :codigo or p.codigovisual = :codigovisual)')
