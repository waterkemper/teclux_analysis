    Macros = <>
    Sql.Strings = (
      ';'
      'select *,'
      '       false as selecionar from'
      '('
      '  ('
      '  select distinct e.localizacao,'
      '         true as ImpLoc,'
      '         e.sublocalizacao,'
      '         true as ImpSubLoc,'
      
        '         cast(coalesce(e.localizacao,'#39#39')||'#39'*'#39'||coalesce(e.subloc' +
        'alizacao,'#39#39') as varchar(85)) as locsubloc'
      ''
      '  from estoques e'
      '  where btrim(coalesce(e.localizacao,'#39#39'))<>'#39#39
      '    and btrim(coalesce(e.sublocalizacao,'#39#39'))<>'#39#39
      '  group by e.localizacao, e.sublocalizacao'
      '  order by e.localizacao, e.sublocalizacao'
      '  )'
      '  union all'
      '  ('
      
        '  select distinct e.localizacao, true as ImpLoc, e.sublocalizaca' +
        'o, true as ImpSubLoc, cast(coalesce(e.localizacao,'#39#39')||'#39'*'#39'||coal' +
        'esce(e.sublocalizacao,'#39#39') as varchar(85)) as locsubloc'
      '  from estoques e'
      '  where btrim(coalesce(e.localizacao,'#39#39'))<>'#39#39
      '    and btrim(coalesce(e.sublocalizacao,'#39#39'))='#39#39
      '  group by e.localizacao, e.sublocalizacao'
      '  order by e.localizacao, e.sublocalizacao'
      '  )'
      '  union all'
      '  ('
      
        '  select distinct e.localizacao, true as ImpLoc, e.sublocalizaca' +
        'o, true as ImpSubLoc, cast(coalesce(e.localizacao,'#39#39')||'#39'*'#39'||coal' +
        'esce(e.sublocalizacao,'#39#39') as varchar(85)) as locsubloc'
      '  from estoques e'
      '  where btrim(coalesce(e.localizacao,'#39#39'))='#39#39
      '    and btrim(coalesce(e.sublocalizacao,'#39#39'))<>'#39#39
      '  group by e.localizacao, e.sublocalizacao'
      '  order by e.localizacao, e.sublocalizacao'
      '  )'
      ') as e'
      ''
      'order by e.localizacao, e.sublocalizacao')
