      ''
      '       c.codigo as codigo_caracteristica,'
      '       c.descricao as descricao_caracteristica,'
      '       true as nulo_descricao_caracteristica,'
      ''
      '       c.codigovisual as codigovisual_caracteristica,'
      ''
      '       c.complemento as complemento_caracteristica,'
      '       true as nulo_complemento_caracteristica,'
      ''
      '       c.tipoproduto as tipoproduto_caracteristica,'
      '       tp.descricao as descricaotipoproduto_caracteristica,'
      '       true as nulo_tipoproduto_caracteristica,'
      ''
      '       c.peso as peso_caracteristica,'
      '       true as nulo_peso_caracteristica,'
      ''
      '       c.volumes as volumes_caracteristica,'
      '       true as nulo_volumes_caracteristica,'
      ''
      '       c.foralinha as foralinha_caracteristica,'
      '       true as nulo_foralinha_caracteristica,'
      ''
      '       c.inativo as inativo_caracteristica,'
      '       true as nulo_inativo_caracteristica,'
      ''
      '       c.gtin as gtin_caracteristica,'
      '       true as nulo_gtin_caracteristica,'
      ''
      '       c.descricaonanf as descricaonanf_caracteristica,'
      '       true as nulo_descricaonanf_caracteristica,'
      ''
      '       /* PAR'#194'METROS */'
      
        '       c.montagem as montagem_caracteristica, /* Requer montagem' +
        ' */'
      
        '       c.emiteetiqueta as emiteetiqueta_caracteristica, /* Emiti' +
        'r Etiqueta */'
      '       c.brinde as brinde_caracteristica, /* Produto '#233' brinde */'
      
        '       c.emitecomplemento as emitecomplemento_caracteristica,/* ' +
        'Imprimir complemento */'
      
        '       c.exigenumeroserie as exigenumeroserie_caracteristica, /*' +
        ' Exige n'#250'mero de s'#233'rie */'
      
        '       c.gerenciarloteevalidade as gerenciarloteevalidade_caract' +
        'eristica, /*Gerenciar lote e validade */'
      ''
      '       /* DISPONIBILIDADE */'
      
        '       c.disponivel_sistema as disponivel_sistema_caracteristica' +
        ', /* Sistema  */'
      
        '       c.disponivel_site as disponivel_site_caracteristica,    /' +
        '* Site  */'
      
        '       c.disponivel_marketplace as disponivel_marketplace_caract' +
        'eristica, /* Marketplace */'
      ''
      '       /* PRODUTO COMPOSTO */'
      '       c.composto as composto_caracteristica, /* Conjunto */'
      
        '       c.discriminarpreco as discriminarpreco_caracteristica, /*' +
        ' Discriminar pre'#231'o */'
      
        '       c.conferircomposto as conferircomposto_caracteristica, /*' +
        ' Conferir Componentes */'
      '       c.composto2 as composto2_caracteristica, /* Composto */'
      
        '       c.desmembrarcomponente as  desmembrarcomponente_caracteri' +
        'stica,/* Desmembrar componentes */'
      ''
      '       /* DISCRIMINA'#199#195'O */'
      
        '       C.discriminarcomposto AS discriminarcomposto_caracteristi' +
        'ca, /* Sem composi'#231#227'o = N | Com composi'#231#227'o = C | S'#243' composi'#231#227'o =' +
        ' S */'
      '       true as nulo_discriminarcomposto_caracteristica,'
      ''
      
        '       c.vendanegativa as vendanegativa_caracteristica, /* VENDA' +
        ' SEM ESTOQUE Sim = S | N'#227'o = N */'
      '       true as nulo_vendanegativa_caracteristica,'
      ''
      
        '       c.vendanegativanosite as vendanegativanosite_caracteristi' +
        'ca, /* VENDA SEM ESTOQUE NO SITE Sim = S | N'#227'o = N */'
      '       true as nulo_vendanegativanosite_caracteristica,'
      ''
      '       c.markup as markup_caracteristica, /* MARK-UP */'
      '       true as nulo_markup_caracteristica,'
      ''
      
        '       c.custoadicionalproduto as custoadicionalproduto_caracter' +
        'istica, /* CUSTO ADICIONAL */'
      '       true as nulo_custoadicionalproduto_caracteristica,'
      ''
      '       c.multiplo as multiplo_caracteristica, /* M'#218'LTIPLO */'
      '       true as nulo_multiplo_caracteristica,'
      ''
      '       c.bonus as bonus_caracteristica, /* B'#212'NUS */'
      '       true as nulo_bonus_caracteristica,'
      ''
      '       /* COMISS'#195'O VENDEDORES */'
      '       c.tipocomissao as tipocomissao_caracteristica,'
      '       true as nulo_tipocomissao_caracteristica,'
      ''
      '       c.comissao as comissao_caracteristica,'
      '       true as nulo_comissao_caracteristica,'
      ''
      '       /* COMISS'#195'O INDICADORES */'
      
        '       c.tipocomissaoindicador as tipocomissaoindicador_caracter' +
        'istica,'
      '       true as nulo_tipocomissaoindicador_caracteristica,'
      ''
      '       c.comissaoindicador as comissaoindicador_caracteristica,'
      '       true as nulo_comissaoindicador_caracteristica,'
      ''
      '       c.grupo as grupo_caracteristica,'
      '       true as nulo_grupo_caracteristica,'
      '       g.descricao as descricaogrupo_caracteristica,'
      ''
      '       c.classe as classe_caracteristica,'
      '       true as nulo_classe_caracteristica,'
      '       cl.descricao as descricaoclasse_caracteristica,'
      ''
      '       c.marca as marca_caracteristica,'
      '       true as nulo_marca_caracteristica,'
      '       m.descricao as descricaomarca_caracteristica,'
      ''
      '       c.unidade as unidade_caracteristica,'
      '       true as nulo_unidade_caracteristica,'
      '       u.descricao as descricaounidade_caracteristica,'
      ''
      '       c.fatorpreco as fatorpreco_caracteristica,'
      '       true as nulo_fatorpreco_caracteristica,'
      '       fp.descricao as descricaofatorpreco_caracteristica,'
      ''
      '       c.setorproducao as setorproducao_caracteristica,'
      '       true as nulo_setorproducao_caracteristica,'
      '       sp.descricao as descricacaosetorproducao_caracteristica,'
      ''
      
        '       /* ICMS - C'#211'D. SITUA'#199#195'O TRIBUT'#193'RIA (atualizar o campo inc' +
        'idencia) */'
      '       c.incidencia as incidencia_caracteristica,'
      '       ti.valor as cst_caracteristica,'
      '       true as nulo_cst_caracteristica,'
      '       ti.descricao as descricaocst_caracteristica,'
      ''
      '       /* CSOSN - COD. SIT. OP. SIMPLES NACIONAL */'
      '       c.csosn as csosn_caracteristica,'
      '       true as nulo_csosn_caracteristica,'
      '       csosn.descricao as descricaocsosn_caracteristica,'
      ''
      '       /* REDU'#199#195'O BASE */'
      '       c.percreducaobase as percreducaobase_caracteristica,'
      ''
      '       c.icmsmodalidade as icmsmodalidade_caracteristica,'
      '       true as nulo_icmsmodalidade_caracteristica,'
      
        '       modalidadeBC_ICMS.descricao as descricaoicmsmodalidade_ca' +
        'racteristica,'
      ''
      '       /* BASE ICMS */'
      '       c.baseicms as baseicms_caracteristica,'
      ''
      '       /* ICMS - AL'#205'QUOTA */'
      '       c.icms as icms_caracteristica,'
      '       true as nulo_icms_caracteristica,'
      '       icms.descricao as descricaoicms_caracteristica,'
      ''
      
        '       (select ei.valor from estadosicms ei where icms = icms.co' +
        'digo and ei.estado = :estado) as aliquotaicms_estadosicms, /* % ' +
        'ICMS */'
      ''
      
        '       /* ICMS - MODALIDADE BASE DE C'#193'LCULO NA SUBSTITUI'#199#195'O TRIB' +
        'UT'#193'RIA */'
      '       c.icmsmodsubst as icmsmodsubst_caracteristica,'
      '       true as nulo_icmsmodsubst_caracteristica,'
      
        '       modalidadeBC_ICMS_ST.descricao as descricaoicmsmodsubst_c' +
        'aracteristica,'
      ''
      '       c.predbcst as predbcst_caracteristica, /* RED. BASE ST */'
      '       true as nulo_predbcst_caracteristica,'
      ''
      '       /* ORIGEM */'
      '       c.origem as origem_caracteristica,'
      '       true as nulo_origem_caracteristica,'
      '       om.descricao as descricaoorigem_caracteristica,'
      ''
      '       /* N'#176' ANVISA */'
      '       c.anvisa as anvisa_caracteristica,'
      '       true as nulo_anvisa_caracteristica,'
      ''
      ''
      '       /* OBSERVA'#199#195'O LEGAL */'
      '       c.obslegal as obslegal_caracteristica,'
      '       true as nulo_obslegal_caracteristica,'
      '       ol.descricao as descricaoobslegal_caracteristica,'
      ''
      '       /* IPI - NCM - NOMENCLATURA COMUM DO MERCOSUL  */'
      '       c.ipi as ipi_caracteristica,'
      '       true as nulo_ipi_caracteristica,'
      '       ipi.descricao as descricaoipi_caracteristica,'
      
        '       ipi.classificacaofiscal as classificacaofiscalipi_caracte' +
        'ristica,'
      '       ipi.aliquota as aliquotaipi_caracteristica,'
      ''
      '       /* IPI - C'#211'D. SITUA'#199#195'O TRIBUT'#193'RIA */'
      '       c.ipicst as ipicst_caracteristica,'
      '       true as nulo_ipicst_caracteristica,'
      '       tipi.descricao as descricaoipicst_caracteristica,'
      ''
      '       /* COFINS - C'#211'D. SITUA'#199#195'O TRIBUT'#193'RIA */'
      '       c.cofinscst as cofinscst_caracteristica,'
      '       true as nulo_cofinscst_caracteristica,'
      '       tpc.descricao as descricaocofins_caracteristica,'
      '       c.aliquotacofins as aliquotacofins_caracteristica,'
      '       true as nulo_aliquotacofins_caracteristica,'
      ''
      ''
      '       /* PIS - C'#211'D. SITUA'#199#195'O TRIBUT'#193'RIA */'
      '       c.piscst as piscst_caracteristica,'
      '       true as nulo_piscst_caracteristica,'
      '       tpp.descricao as descricaopis_caracteristica,'
      '       c.aliquotapis as aliquotapis_caracteristica,'
      '       true as nulo_aliquotapis_caracteristica,'
      ''
      '       /* EFD - T53 */'
      '       c.codigo_efd_t53 as codigo_efd_t53_caracteristica,'
      '       true as nulo_codigo_efd_t53_caracteristica,'
      '       efd_t53.descricao as descricaoefd_t53_caracteristica,'
      ''
      
        '       c.producaopropria as producaopropria_caracteristica, /* P' +
        'roduto de produ'#231#227'o pr'#243'pria */'
      
        '       c.substituicaoipi as substituicaoipi_caracteristica,  /* ' +
        'Substitui'#231#227'o IPI */'
      '       false as marcar'
      ''
      'from (produtos p'
      '       join (((((((((((((((((((caracteristicas c'
      '                     left join grupos g on c.grupo = g.codigo)'
      
        '                     left join classes cl on c.classe = cl.codig' +
        'o)'
      '                     left join marcas m on c.marca = m.codigo)'
      
        '                     left join tiposproduto tp on c.tipoproduto ' +
        '= tp.codigo)'
      
        '                     left join tributosicms ti on c.incidencia =' +
        ' ti.codigo)'
      
        '                     left join unidades u on c.unidade = u.codig' +
        'o)'
      
        '                     left join fatorespreco fp on c.fatorpreco =' +
        ' fp.codigo)'
      
        '                     left join setoresproducao sp on c.setorprod' +
        'ucao = sp.codigo)'
      '                     left join csosn on c.csosn = csosn.codigo)'
      
        '                     left join modalidadeBC_ICMS on c.icmsmodali' +
        'dade = modalidadeBC_ICMS.codigo)'
      '                     left join icms on c.icms = icms.codigo)'
      
        '                     left join modalidadeBC_ICMS_ST on c.icmsmod' +
        'subst = modalidadeBC_ICMS.codigo)'
      
        '                     left join origemmercadorias om on c.origem ' +
        '= om.codigo)'
      
        '                     left join obslegais ol on c.obslegal = ol.c' +
        'odigo)'
      '                     left join ipi on c.ipi = ipi.codigo)'
      
        '                     left join tributosipi tipi on c.ipicst = ti' +
        'pi.codigo)'
      
        '                     left join tributospis_cofins tpc on tpc.cod' +
        'igo = c.cofinscst)'
      
        '                     left join tributospis_cofins tpp on tpp.cod' +
        'igo = c.piscst)'
      
        '                     left join efd_t53 on c.codigo_efd_t53 = efd' +
        '_t53.codigo)'
      ''
      '      on p.caracteristica = c.codigo)'
      ''
      'where FALSE'
      ''
      'Order by c.codigovisual, p.codigovisual'
      ''
      ''
      ''
      ''
      '')
