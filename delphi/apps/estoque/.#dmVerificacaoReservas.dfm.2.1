        Name = 'CondicaoMarca'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select e.produto,'
      '       p.descricao,'
      '       p.resultadocurvaabc,'
      '       e.filial,'
      '       e.emestoque,'
      '       e.reservaprevia,'
      ''
      '       (Select sum(qtdepedida)'
      '        from pedidosfiliais'
      '        where pedidosfiliais.produto=e.produto'
      '          and pedidosfiliais.requisitada=e.filial'
      '          and pedidosfiliais.situacao='#39'A'#39') as pedidos_em_aberto'
      ''
      'from estoques e, (produtos p'
      '                  join (((caracteristicas c'
      '                          join grupos g'
      '                          on c.grupo = g.codigo)'
      '                          join classes cl'
      '                          on c.classe = cl.codigo)'
      '                          join marcas m'
      '                          on c.marca = m.codigo)'
      '                  on p.caracteristica = c.codigo), filiais f'
      ''
      'where e.reservaprevia > 0'
      '  and p.codigo=e.produto'
      '  and e.filial = f.codigo'
      '  and e.reservaprevia <> coalesce((Select sum(qtdepedida)'
      '                                   from pedidosfiliais'
      
        '                                   where pedidosfiliais.produto=' +
        'e.produto'
      
        '                                     and pedidosfiliais.requisit' +
        'ada=e.filial'
      
        '                                     and pedidosfiliais.situacao' +
        '='#39'A'#39'),0)'
      ''
      '  and not coalesce(c.composto,false)'
      ''
      ''
      '  %CondicaoFilial'
      '  %CondicaoProduto'
      '  %CondicaoCaracteristica'
      '  %CondicaoGrupo'
      '  %CondicaoClasse'
      '  %CondicaoMarca'
      ''
      'order by e.filial,p.resultadocurvaabc,e.produto')
