    AfterPost = qryContatosFornecedoresAfterPost
    AfterDelete = qryContatosFornecedoresAfterDelete
    OnNewRecord = qryContatosFornecedoresNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select cf.codigo,'
      '           cf.contato,'
      '           cf.fonenumero,'
      '           cf.foneddd,'
      '           cf.foneramal,'
      '           cf.email,'
      '           cf.codigovfornecedores,'
      '           cf.tipovfornecedores,'
      '           cf.cargo,'
      '           cf.observacoes,'
      '           c.descricao as descricaocargo,'
      '           cf.receberemailmarketing,'
      '           cf.enviar_nfe,'
      '           cf.enviar_boleto'
      ''
      
        'from contatosvfornecedores cf left join cargos c  on cf.cargo = ' +
        'c.codigo'
      'where (cf.codigovfornecedores = :fornecedor)'
      '  and (cf.tipovfornecedores = '#39'F'#39')'
      'order by cf.contato')
    RequestLive = True
    Left = 88
    Top = 366
    ParamData = <
      item
        DataType = ftString
        Name = 'fornecedor'
        ParamType = ptUnknown
        Value = '0'
