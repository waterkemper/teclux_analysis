    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'UPDATE duplicatas SET dda = :ValorDDA'
      'FROM'
      '('
      ''
      #9'SELECT d.numero'
      #9'FROM documentospag d'
      #9'WHERE d.fornecedor = :fornecedor'
      #9'and d.tipofornecedor = :TipoFornecedor'
      ''
      ') as sel'
      'WHERE duplicatas.datapagto is null'
      'and duplicatas.documentopag=sel.numero'
      'and coalesce(duplicatas.dda,false) <> :ValorDDA')
    RequestLive = True
    Left = 144
    Top = 136
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'ValorDDA'
        ParamType = ptUnknown
      end
