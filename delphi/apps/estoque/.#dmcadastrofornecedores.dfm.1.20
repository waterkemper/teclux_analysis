  object qryFornecedores: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforePost = qryFornecedoresBeforePost
    AfterScroll = qryFornecedoresAfterScroll
    OnDeleteError = PostError
    OnEditError = PostError
    OnPostError = PostError
    OnNewRecord = qryFornecedoresNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select fornecedores.*, '
      '         cidades.nome AS nomecidade,'
      '         bairros.nome AS nomebairro,'
      
        '         fornecedores.tipofornecimento[0]='#39'P'#39' as tipofornec_prod' +
        'uto_l,'
      
        '         fornecedores.tipofornecimento[1]='#39'T'#39' as tipofornec_tran' +
        'porte_l,'
      
        '         fornecedores.tipofornecimento[2]='#39'M'#39' as tipofornec_mont' +
        'agem_l,'
      
        '         coalesce(fornecedores.tipofornecimento[3]='#39'O'#39',false) as' +
        ' tipofornec_maoobra_l,'
      '       fornecedores.dda as dda_anterior,'
      '       false as confirmacaodda  '
      ''
      
        'from fornecedores left join cidades on ((cidades.estado = fornec' +
        'edores.estado) and '
      
        '                                                        (cidades' +
        '.codigo = fornecedores.cidade))'
      
        '                           left join bairros on ((bairros.estado' +
        ' = fornecedores.estado) and '
      
        '                                                       (bairros.' +
        'cidade = fornecedores.cidade) and '
      
        '                                                       (bairros.' +
        'codigo = fornecedores.bairro))'
      'where fornecedores.codigo = :codigo')
    RequestLive = True
    Left = 90
    Top = 18
    ParamData = <
      item
        DataType = ftInteger
        Name = 'Codigo'
        ParamType = ptUnknown
      end>
