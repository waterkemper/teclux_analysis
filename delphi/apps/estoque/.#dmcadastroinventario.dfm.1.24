  object qryMovimentosNegativoPosteriores: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkFields = 'produto=produto'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrInventarioProduto
    Constraints = <>
    AfterOpen = qryMovimentosNegativoPosterioresAfterOpen
    AfterClose = qryMovimentosNegativoPosterioresAfterClose
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '/*'
      
        'Esta consulta tem como objetivo exibir o estoque negativo acima ' +
        'da'
      'data de processamento'
      '*/'
      ''
      'select m.produto,'
      '       m.data,'
      '       m.emestoque,'
      '       m.reservado,'
      '       m.reservaprevia'
      'from movimentos m'
      'where m.filial = :filial '
      '  and m.data >= :processamento'
      
        '  and (coalesce(m.emestoque,0)<0 or coalesce(m.reservado,0)<0 or' +
        ' coalesce(m.reservaprevia,0)<0 )'
      ''
      'order by m.data desc, m.lancto'
      ''
      '')
    RequestLive = False
    Left = 232
    Top = 280
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'processamento'
        ParamType = ptUnknown
      end>
    object qryMovimentosNegativoPosterioresproduto: TLargeintField
      FieldName = 'produto'
    end
    object qryMovimentosNegativoPosterioresdata: TDateField
      FieldName = 'data'
    end
    object qryMovimentosNegativoPosterioresemestoque: TFloatField
      FieldName = 'emestoque'
    end
    object qryMovimentosNegativoPosterioresreservado: TFloatField
      FieldName = 'reservado'
    end
    object qryMovimentosNegativoPosterioresreservaprevia: TFloatField
      FieldName = 'reservaprevia'
      Required = True
    end
  end
