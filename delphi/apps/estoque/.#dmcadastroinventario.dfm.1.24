        DataType = ftUnknown
        Name = 'SQLFiltroFornecedor'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SQLFiltroDescricaoProduto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SQLEmLinha_ForadeLinha'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SQLAtivo_Inativo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SQLCondicaoQuantidade'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select setval('#39'chave'#39',:sequencia);'
      
        'insert into inventarioProdutos (inventario, sequencia, produto, ' +
        'produtodigitado, quantidade, selecionadosistema)'
      '('
      ' SELECT    cast(:inventario as integer) as inventario,'
      '            cast(nextval('#39'chave'#39') as integer)-1 as sequencia,'
      '            codigoitem, codigovisual,'
      '            0.00,'
      '            true'
      ' FROM'
      ' ('
      '  SELECT ep.codigoitem, ep.codigovisual, ep.codigofilial'
      ''
      '  FROM'
      '  ('
      
        '     select e.produto as codigoitem, p.codigovisual, e.filial as' +
        ' codigofilial'
      '     FROM'
      '     ( SELECT e.produto, e.filial'
      '         FROM estoques e'
      '         WHERE e.filial = :filial'
      
        '         %produtosdoinventario /*not in (lista produtos do inven' +
        'tario)*/'
      '         %SQLFiltroLocalizacao'
      '      ) AS e'
      ''
      '            join (produtos p'
      '                  join (((caracteristicas c'
      '                          join classes cl'
      '                          on c.classe=cl.codigo)'
      '                          join grupos g'
      '                          on g.codigo=c.grupo)'
      '                          join marcas m'
      '                          on c.marca = m.codigo)'
      '                  on p.caracteristica=c.codigo)'
      ''
      '            on e.produto = p.codigo'
      ''
      '      where true'
      ''
      '      %SQLFiltroItemProdutos'
      '      %SQLFiltroProdutos'
      '      %SQLFiltroGrupos'
      '      %SQLFiltroClasses'
      '      %SQLFiltroMarcas'
      '      %SQLFiltroGruposFornecedores'
      '      %SQLFiltroFornecedor'
      '      %SQLFiltroDescricaoProduto'
      '      %SQLEmLinha_ForadeLinha'
      '      %SQLAtivo_Inativo'
      ''
      ''
      '   ) AS ep, movimentos m1'
      '      Where m1.numero = (select m2.numero'
      '                         from movimentos m2'
      '                         where m2.produto = ep.codigoitem'
      '                           and m2.filial = ep.codigofilial'
      '                           and m2.data <= cast(:data as date)'
      
        '                         order by m2.data desc, m2.lancto desc l' +
        'imit 1)'
      ''
      
        '        %SQLCondicaoQuantidade /* and (m1.emestoque+m1.reservado' +
        '+m1.transito)<>0 */'
      ''
      ' ) as ep'
      ')')
    RequestLive = False
    Left = 317
    Top = 73
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'sequencia'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'inventario'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'data'
        ParamType = ptUnknown
        Value = #39'14/12/2005'#39
      end>
  end
