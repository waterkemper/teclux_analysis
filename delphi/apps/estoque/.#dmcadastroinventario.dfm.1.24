    Sql.Strings = (
      'select setval('#39'chave'#39', :sequencia);'
      
        'insert into inventarioProdutos (inventario, sequencia, produto, ' +
        'produtodigitado, quantidade, selecionadosistema)'
      '('
      '  SELECT    cast(:inventario as integer) as inventario,'
      '            cast(nextval('#39'chave'#39') as integer)-1 as sequencia,'
      '            codigoitem,'
      '            codigovisual,'
      '            0.00,'
      '            true'
      '  FROM'
      '  ('
      '   SELECT e.produto AS codigoitem,'
      '          p.codigovisual'
      ''
      '   FROM estoques e'
      ''
      '            join (produtos p'
      '                  join (((caracteristicas c'
      '                          join classes cl'
      '                          on c.classe=cl.codigo)'
      '                          join grupos g'
      '                          on g.codigo=c.grupo)'
      '                          join marcas m'
      '                          on c.marca = m.codigo)'
      '                  on p.caracteristica=c.codigo)'
      ''
      '            on e.produto = p.codigo'
      ''
      ''
      '   Where e.filial = :filial'
      
        '      %produtosdoinventario /*not in (lista produtos do inventar' +
        'io)*/'
      ''
      '      %SQLFiltroItemProdutos'
      '      %SQLFiltroProdutos'
      '      %SQLFiltroGrupos'
      '      %SQLFiltroClasses'
      '      %SQLFiltroMarcas'
      '      %SQLFiltroGruposFornecedores'
      '      %SQLFiltroFornecedor'
      '      %SQLFiltroLocalizacao'
      '      %SQLFiltroDescricaoProduto'
      '      %SQLEmLinha_ForadeLinha'
