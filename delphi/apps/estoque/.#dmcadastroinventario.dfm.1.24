  object qryInventarioProduto: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryInventarioProdutoAfterOpen
    BeforePost = qryInventarioProdutoBeforePost
    AfterPost = qryInventarioProdutoAfterPost
    AfterDelete = qryInventarioProdutoAfterDelete
    AfterScroll = qryInventarioProdutoAfterScroll
    OnCalcFields = qryInventarioProdutoCalcFields
    OnFilterRecord = qryInventarioProdutoFilterRecord
    OnNewRecord = qryInventarioProdutoNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select'
      '       p.codigovisual as produtovisual,'
      '       cast(null as varchar(30)) as codigobarras,'
      '       p.descricao,'
      '       p.valorgrade1,'
      '       p.valorgrade2,'
      
        '       (select gr.descricao from grades gr where gr.codigo = c.g' +
        'rade1) as linha,'
      
        '       (select gr.descricao from grades gr where gr.codigo = c.g' +
        'rade2) as coluna,'
      ''
      '       case when :MovimentoProcessado then'
      '         ip.emestoque'
      '       else'
      '         coalesce((select m.emestoque'
      '                 from movimentos m'
      '                 where m.produto = p.codigo'
      '                   and m.filial = :filial'
      '                   and m.data <= :data'
      '                 order by data desc, lancto desc limit 1),0)'
      '       end as emestoque,'
      ''
      '       case when :MovimentoProcessado then'
      '         ip.reservado'
      '       else'
      '         coalesce((select m.reservado'
      '                   from movimentos m'
      '                   where m.produto = p.codigo'
      '                     and m.filial = :filial'
      '                     and m.data <= :data'
      '                   order by data desc, lancto desc limit 1),0)'
      '       end as reservado,'
      ''
      '       case when :MovimentoProcessado then'
      '         ip.reservaprevia'
      '       else'
      '         coalesce((select m.reservaprevia'
      '                   from movimentos m'
      '                   where m.produto = p.codigo'
      '                     and m.filial = :filial'
      '                     and m.data <= :data'
      '                   order by data desc, lancto desc limit 1),0)'
      '       end as reservaprevia,'
      ''
      '       case when :MovimentoProcessado then'
      '         ip.transito'
      '       else'
      '         coalesce((select m.transito'
      '                   from movimentos m'
      '                   where m.produto = p.codigo'
      '                     and m.filial = :filial'
      '                     and m.data <= :data'
      '                   order by data desc,  lancto desc limit 1),0)'
      '       end as transito,'
      ''
      '       case when :MovimentoProcessado then'
      
        '         ip.emestoque + ip.reservado + ip.transito + ip.reservap' +
        'revia'
      
        '       else cast(null as numeric(9,3)) end as SaldoAposProcessam' +
        'ento,'
      ''
      '       case when :MovimentoProcessado then'
      '         ip.movimentado'
      '       else'
      '         coalesce((select'
      ''
      '                coalesce((select sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 1 for 1)= '#39'+'#39')'
      '                  and m.produto = ip.produto'
      '                  and m.filial = :filial'
      
        '                  and m.data > :data and m.data <= :processament' +
        'o),0) +'
      ''
      '                coalesce((select - sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 1 for 1)= '#39'-'#39')'
      '                  and m.produto = ip.produto'
      '                  and m.filial = :filial'
      
        '                  and m.data > :data and m.data <= :processament' +
        'o),0) +'
      ''
      '                coalesce((select sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 2 for 1)= '#39'+'#39')'
      '                  and m.produto = ip.produto'
      '                  and m.filial = :filial'
      
        '                  and m.data > :data and m.data <= :processament' +
        'o),0) +'
      ''
      '                coalesce((select - sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 2 for 1)= '#39'-'#39')'
      '                  and m.produto = ip.produto'
      '                  and m.filial = :filial'
      
        '                  and m.data > :data and m.data <= :processament' +
        'o),0) +'
      ''
      '                /*coalesce((select sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 3 for 1)= '#39'+'#39')'
      '                  and m.produto = ip.produto'
      '                  and m.filial = :filial'
      
        '                  and m.data > :data and m.data <= :processament' +
        'o),0) + */'
      ''
      '                coalesce((select - sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 3 for 1)= '#39'-'#39')'
      '                  and m.produto = ip.produto'
      '                  and m.filial = :filial'
      
        '                  and m.data > :data and m.data <= :processament' +
        'o),0) +'
      ''
      '                coalesce((select + sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 9 for 1)= '#39'+'#39')'
      '                  and m.produto = ip.produto'
      '                  and m.filial = :filial'
      
        '                  and m.data > :data and m.data <= :processament' +
        'o),0) +'
      ''
      '                coalesce((select - sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 9 for 1)= '#39'-'#39')'
      '                  and m.produto = ip.produto'
      '                  and m.filial = :filial'
      
        '                  and m.data > :data and m.data <= :processament' +
        'o),0) ),0)'
      '       end as movimentado,'
      ''
      ''
      '       case when :MovimentoProcessado then'
      '         ip.demonstracao'
      '       else'
      '         coalesce((select m.demonstracao'
      '                    from movimentos m'
      '                    where m.produto = p.codigo'
      '                      and m.filial = :filial'
      '                      and m.data <= :data'
      '                    order by data desc, lancto desc limit 1),0)'
      '       end as demonstracao,'
      ''
      '       case when :MovimentoProcessado then'
      '         ip.conserto'
      '       else'
      '         coalesce((select m.conserto'
      '                    from movimentos m'
      '                    where m.produto = p.codigo'
      '                      and m.filial = :filial'
      '                      and m.data <= :data'
      '                    order by data desc, lancto desc limit 1),0)'
      '       end as conserto,'
      ''
      '       case when :MovimentoProcessado then'
      '         ip.danificada'
      '       else'
      '         coalesce((select m.danificada'
      '                    from movimentos m'
      '                    where m.produto = p.codigo'
      '                      and m.filial = :filial'
      '                      and m.data <= :data'
      '                    order by data desc, lancto desc limit 1),0)'
      '       end as danificada,'
      ''
      ''
      '       case when :MovimentoProcessado then'
      '         ip.customedio'
      '       else'
      
        '         coalesce((select case when (m.emestoque+m.reservado+m.r' +
        'eservaprevia+m.transito+m.demonstracao+m.conserto+m.danificada) ' +
        '= 0 then 0'
      
        '                        else round(m.financeiro / (m.emestoque+m' +
        '.reservado+m.reservaprevia+m.transito+m.demonstracao+m.conserto+' +
        'm.danificada), 2) end'
      '                  from movimentos m'
      '                  where m.produto = p.codigo'
      '                    and m.filial = :filial'
      '                    and m.data <= :data'
      '                  order by data desc, lancto desc limit 1),0)'
      '       end as customedio,'
      ''
      ''
      '       case when :MovimentoProcessado then'
      '         ip.financeiro'
      '       else'
      '         coalesce((select m.financeiro'
      '                    from movimentos m'
      '                    where m.produto = p.codigo'
      '                      and m.filial = :filial'
      '                      and m.data <= :data'
      '                    order by data desc, lancto desc limit 1),0)'
      '        end as financeiro,'
      ''
      ''
      '       (case when :MovimentoProcessado then'
      '         ip.financeiroprocessamento'
      '       else'
      '         case when ip.quantidade<>0 then'
      ''
      '           coalesce('
      
        '                      (select (case when (m.emestoque+m.reservad' +
        'o+m.reservaprevia+m.transito+m.demonstracao+m.conserto+m.danific' +
        'ada) <> 0 then'
      
        '                               round(m.financeiro / (m.emestoque' +
        '+m.reservado+m.reservaprevia+m.transito+m.demonstracao+m.consert' +
        'o+m.danificada), 2) * ip.quantidade'
      '                              else null '
      #9#9#9#9#9#9#9'  end)'
      '                       from movimentos m'
      '                       where m.produto = p.codigo'
      '                         and m.filial = :filial'
      '                         and m.data <= :processamento'
      '                       order by data desc, lancto desc limit 1),'
      ''
      '                      coalesce('
      
        '                      (case when QuantidadeTotalDoEstoque(ip.pro' +
        'duto, cast(:filial as smallint)) = 0 then'
      
        '                                                (select e.valoru' +
        'ltimacompra'
      '                                                 from estoques e'
      
        '                                                 where e.produto' +
        ' = ip.produto'
      
        '                                                   and e.filial ' +
        '= :filial)'
      '                       else'
      ''
      
        '                                                (select e.financ' +
        'eiro'
      '                                                 from estoques e'
      
        '                                                 where e.produto' +
        ' = ip.produto'
      
        '                                                   and e.filial ' +
        '= :filial) /'
      
        '                                                QuantidadeTotalD' +
        'oEstoque(ip.produto, cast(:filial as smallint))'
      '                      end) * ip.quantidade, 0)'
      ''
      ''
      '                     )'
      '         else'
      ''
      '           coalesce((select m.financeiro'
      '                      from movimentos m'
      '                      where m.produto = p.codigo'
      '                        and m.filial = :filial'
      '                        and m.data <= :processamento'
      
        '                      order by data desc, lancto desc limit 1),0' +
        ')'
      ''
      '         end'
      '       end) as financeiroprocessamento,'
      ''
      ''
      '      false as PossuiSaldoNegativoPosteriormente,'
      ''
      ''
      '      case when :MovimentoProcessado then'
      '        ip.valorcusto'
      '      else'
      
        '      (case when QuantidadeTotalDoEstoque(ip.produto, cast(:fili' +
        'al as smallint)) = 0 then'
      
        '           coalesce( (select case when e.valorultimacompra>0 the' +
        'n e.valorultimacompra'
      '                              else'
      
        '                               (select (case when (m.emestoque+m' +
        '.reservado+m.reservaprevia+m.transito+m.demonstracao+m.conserto+' +
        'm.danificada) <> 0 then'
      
        '                                                   round(m.finan' +
        'ceiro / (m.emestoque+m.reservado+m.reservaprevia+m.transito+m.de' +
        'monstracao+m.conserto+m.danificada), 2)'
      '                                        else 0'
      '                                        end)'
      '                                 from movimentos m'
      '                                 where m.produto = p.codigo'
      '                                 and m.filial = :filial'
      '                                 and m.data <= :processamento'
      '                                 and m.financeiro>0'
      
        '                                 order by data desc, lancto desc' +
        ' limit 1)'
      '                               end'
      ''
      '                      from estoques e'
      '                       where e.produto = ip.produto'
      '                       and e.filial = :filial),0)'
      '         else'
      '            (select e.financeiro'
      '             from estoques e'
      '              where e.produto = ip.produto'
      '              and e.filial = :filial) /'
      
        '              QuantidadeTotalDoEstoque(ip.produto, cast(:filial ' +
        'as smallint))'
      '        end)'
      '      end as valorcusto,'
      ''
      '      ip.quantidade -'
      '      (('
      ''
      '         case when :MovimentoProcessado then'
      '           coalesce(ip.emestoque,0)'
      '         else'
      '           coalesce((select m.emestoque'
      '                   from movimentos m'
      '                   where m.produto = p.codigo'
      '                     and m.filial = :filial'
      '                     and m.data <= :data'
      '                   order by data desc, lancto desc limit 1),0)'
      '         end'
      ''
      ''
      '       +'
      ''
      '         case when :MovimentoProcessado then'
      '           coalesce(ip.reservado,0)'
      '         else'
      '           coalesce((select m.reservado'
      '                     from movimentos m'
      '                     where m.produto = p.codigo'
      '                       and m.filial = :filial'
      '                       and m.data <= :data'
      '                     order by data desc, lancto desc limit 1),0)'
      '         end'
      ''
      '       +'
      ''
      '         case when :MovimentoProcessado then'
      '           coalesce(ip.reservaprevia,0)'
      '         else'
      '           coalesce((select m.reservaprevia'
      '                     from movimentos m'
      '                     where m.produto = p.codigo'
      '                       and m.filial = :filial'
      '                       and m.data <= :data'
      '                     order by data desc, lancto desc limit 1),0)'
      '         end'
      ''
      '        ) +'
      ''
      '         case when :MovimentoProcessado then'
      '           coalesce(ip.movimentado,0)'
      '         else'
      '           coalesce((select'
      ''
      '                  coalesce((select sum(abs(m.quantidade))'
      '                  from movimentos m'
      
        '                  where (substring(m.operacao from 1 for 1)= '#39'+'#39 +
        ')'
      '                    and m.produto = ip.produto'
      '                    and m.filial = :filial'
      
        '                    and m.data > :data and m.data <= :processame' +
        'nto),0) +'
      ''
      '                  coalesce((select - sum(abs(m.quantidade))'
      '                  from movimentos m'
      
        '                  where (substring(m.operacao from 1 for 1)= '#39'-'#39 +
        ')'
      '                    and m.produto = ip.produto'
      '                    and m.filial = :filial'
      
        '                    and m.data > :data and m.data <= :processame' +
        'nto),0) +'
      ''
      '                  coalesce((select sum(abs(m.quantidade))'
      '                  from movimentos m'
      
        '                  where (substring(m.operacao from 2 for 1)= '#39'+'#39 +
        ')'
      '                    and m.produto = ip.produto'
      '                    and m.filial = :filial'
      
        '                    and m.data > :data and m.data <= :processame' +
        'nto),0) +'
      ''
      '                  coalesce((select - sum(abs(m.quantidade))'
      '                  from movimentos m'
      
        '                  where (substring(m.operacao from 2 for 1)= '#39'-'#39 +
        ')'
      '                    and m.produto = ip.produto'
      '                    and m.filial = :filial'
      
        '                    and m.data > :data and m.data <= :processame' +
        'nto),0) +'
      ''
      '                  coalesce((select - sum(abs(m.quantidade))'
      '                  from movimentos m'
      
        '                  where (substring(m.operacao from 3 for 1)= '#39'-'#39 +
        ')'
      '                    and m.produto = ip.produto'
      '                    and m.filial = :filial'
      
        '                    and m.data > :data and m.data <= :processame' +
        'nto),0) +'
      ''
      '                  coalesce((select + sum(abs(m.quantidade))'
      '                  from movimentos m'
      
        '                  where (substring(m.operacao from 9 for 1)= '#39'+'#39 +
        ')'
      '                    and m.produto = ip.produto'
      '                    and m.filial = :filial'
      
        '                    and m.data > :data and m.data <= :processame' +
        'nto),0) +'
      ''
      '                  coalesce((select - sum(abs(m.quantidade))'
      '                  from movimentos m'
      
        '                  where (substring(m.operacao from 9 for 1)= '#39'-'#39 +
        ')'
      '                    and m.produto = ip.produto'
      '                    and m.filial = :filial'
      
        '                    and m.data > :data and m.data <= :processame' +
        'nto),0) ),0)'
      '         end'
      ''
      ''
      '        ) as diferenca,'
      ''
      '      ip.*'
      ''
      'from inventarioprodutos ip,'
      
        '     (produtos p join caracteristicas c on p.caracteristica = c.' +
        'codigo)'
      'where ip.produto = p.codigo'
      '  and ip.inventario = :inventario'
      'order by ip.sequencia')
    RequestLive = True
    Left = 56
    Top = 88
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'MovimentoProcessado'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftDateTime
        Name = 'data'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'processamento'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'inventario'
        ParamType = ptUnknown
      end>
