    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'update inventarioprodutos set emestoque     = selecao.emestoque,'
      '                              reservado     = selecao.reservado,'
      
        '                              reservaprevia = selecao.reservapre' +
        'via,'
      '                              transito      = selecao.transito,'
      
        '                              movimentado   = selecao.movimentad' +
        'o,'
      
        '                              demonstracao  = selecao.demonstrac' +
        'ao,'
      '                              conserto      = selecao.conserto,'
      
        '                              danificada    = selecao.danificada' +
        ','
      
        '                              customedio    = selecao.customedio' +
        ','
      '                              financeiro    = selecao.financeiro'
      'from'
      ''
      '('
      '   select  ip.inventario, ip.produto,'
      ''
      ''
      '         coalesce((select m.emestoque'
      '                 from movimentos m'
      '                 where m.produto = ip.produto'
      '                   and m.filial = i.filial'
      '                   and m.data <= i.data'
      
        '                 order by data desc, lancto desc limit 1),0) as ' +
        'emestoque,'
      ''
      '         coalesce((select m.reservado'
      '                   from movimentos m'
      '                   where m.produto = ip.produto'
      '                     and m.filial = i.filial'
      '                     and m.data <= i.data'
      
        '                   order by data desc, lancto desc limit 1),0) a' +
        's reservado,'
      ''
      '         coalesce((select m.reservaprevia'
      '                   from movimentos m'
      '                   where m.produto = ip.produto'
      '                     and m.filial = i.filial'
      '                     and m.data <= i.data'
      
        '                   order by data desc, lancto desc limit 1),0) a' +
        's reservaprevia,'
      ''
      '         coalesce((select m.transito'
      '                   from movimentos m'
      '                   where m.produto = ip.produto'
      '                     and m.filial = i.filial'
      '                     and m.data <= i.data'
      
        '                   order by data desc,  lancto desc limit 1),0) ' +
        'as transito,'
      ''
      '         coalesce((select'
      ''
      '                coalesce((select sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 1 for 1)= '#39'+'#39')'
      '                  and m.produto = ip.produto'
      '                  and m.filial = i.filial'
      
        '                  and m.data > i.data and m.data <= i.processame' +
        'nto),0) +'
      ''
      '                coalesce((select - sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 1 for 1)= '#39'-'#39')'
      '                  and m.produto = ip.produto'
      '                  and m.filial = i.filial'
      
        '                  and m.data > i.data and m.data <= i.processame' +
        'nto),0) +'
      ''
      '                coalesce((select sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 2 for 1)= '#39'+'#39')'
      '                  and m.produto = ip.produto'
      '                  and m.filial = i.filial'
      
        '                  and m.data > i.data and m.data <= i.processame' +
        'nto),0) +'
      ''
      '                coalesce((select - sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 2 for 1)= '#39'-'#39')'
      '                  and m.produto = ip.produto'
      '                  and m.filial = i.filial'
      
        '                  and m.data > i.data and m.data <= i.processame' +
        'nto),0) +'
      ''
      '                /*coalesce((select sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 3 for 1)= '#39'+'#39')'
      '                  and m.produto = ip.produto'
      '                  and m.filial = i.filial'
      
        '                  and m.data > i.data and m.data <= i.processame' +
        'nto),0) + */'
      ''
      '                coalesce((select - sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 3 for 1)= '#39'-'#39')'
      '                  and m.produto = ip.produto'
      '                  and m.filial = i.filial'
      
        '                  and m.data > i.data and m.data <= i.processame' +
        'nto),0) +'
      ''
      '                coalesce((select + sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 9 for 1)= '#39'+'#39')'
      '                  and m.produto = ip.produto'
      '                  and m.filial = i.filial'
      
        '                  and m.data > i.data and m.data <= i.processame' +
        'nto),0) +'
      ''
      '                coalesce((select - sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 9 for 1)= '#39'-'#39')'
      '                  and m.produto = ip.produto'
      '                  and m.filial = i.filial'
      
        '                  and m.data > i.data and m.data <= i.processame' +
        'nto),0) ),0) as movimentado,'
      ''
      '         coalesce((select m.demonstracao'
      '                    from movimentos m'
      '                    where m.produto = ip.produto'
      '                      and m.filial = i.filial'
      '                      and m.data <= i.data'
      
        '                    order by data desc, lancto desc limit 1),0) ' +
        'as demonstracao,'
      ''
      '         coalesce((select m.conserto'
      '                    from movimentos m'
      '                    where m.produto = ip.produto'
      '                      and m.filial = i.filial'
      '                      and m.data <= i.data'
      
        '                    order by data desc, lancto desc limit 1),0) ' +
        'as conserto,'
      ''
      '         coalesce((select m.danificada'
      '                    from movimentos m'
      '                    where m.produto = ip.produto'
      '                      and m.filial = i.filial'
      '                      and m.data <= i.data'
      
        '                    order by data desc, lancto desc limit 1),0) ' +
        'as danificada,'
      ''
      ''
      
        '         coalesce((select case when (m.emestoque+m.reservado+m.r' +
        'eservaprevia+m.transito+m.demonstracao+m.conserto+m.danificada) ' +
        '= 0 then 0'
      
        '                        else round(m.financeiro / (m.emestoque+m' +
        '.reservado+m.reservaprevia+m.transito+m.demonstracao+m.conserto+' +
        'm.danificada), 2) end'
      '                  from movimentos m'
      '                  where m.produto = ip.produto'
      '                    and m.filial = i.filial'
      '                    and m.data <= i.data'
      
        '                  order by data desc, lancto desc limit 1),0) as' +
        ' customedio,'
      ''
      '         coalesce((select m.financeiro'
      '                    from movimentos m'
      '                    where m.produto = ip.produto'
      '                      and m.filial = i.filial'
      '                      and m.data <= i.data'
      
        '                    order by data desc, lancto desc limit 1),0) ' +
        'as financeiro'
      ''
      ''
      
        '   from inventarioprodutos ip join inventario i on ip.inventario' +
        ' = i.numero'
      '   where ip.inventario = :inventario'
      ') as selecao'
      'where inventarioprodutos.inventario = selecao.inventario'
      '  and inventarioprodutos.produto = selecao.produto'
      '')
