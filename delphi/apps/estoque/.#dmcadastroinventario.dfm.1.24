  object qryProdutoEstoque: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select m.emestoque,'
      '       m.reservado,'
      '       m.transito,'
      '       m.demonstracao,'
      '       m.conserto,'
      '       m.danificada,'
      '       m.reservaprevia,'
      ''
      ''
      '       coalesce((select'
      ''
      '                coalesce((select sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 1 for 1)= '#39'+'#39')'
      '                  and m.produto = :produto'
      '                  and m.filial = :filial'
      '                   and case when :MovimentoProcessado then'
      
        '                       (m.tipomovimento not in ('#39'IE+'#39','#39'IE-'#39','#39'IT-' +
        #39','#39'IR-'#39','#39'IP-'#39'))'
      '                       else true end'
      
        '                  and m.data > :data and m.data <= :processament' +
        'o),0) +'
      ''
      '                coalesce((select - sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 1 for 1)= '#39'-'#39')'
      '                  and m.produto = :produto'
      '                  and m.filial = :filial'
      '                   and case when :MovimentoProcessado then'
      
        '                       (m.tipomovimento not in ('#39'IE+'#39','#39'IE-'#39','#39'IT-' +
        #39','#39'IR-'#39','#39'IP-'#39'))'
      '                       else true end'
      
        '                  and m.data > :data and m.data <= :processament' +
        'o),0) +'
      ''
      '                coalesce((select sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 2 for 1)= '#39'+'#39')'
      '                  and m.produto = :produto'
      '                  and m.filial = :filial'
      '                   and case when :MovimentoProcessado then'
      
        '                       (m.tipomovimento not in ('#39'IE+'#39','#39'IE-'#39','#39'IT-' +
        #39','#39'IR-'#39','#39'IP-'#39'))'
      '                       else true end'
      
        '                  and m.data > :data and m.data <= :processament' +
        'o),0) +'
      ''
      '                coalesce((select - sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 2 for 1)= '#39'-'#39')'
      '                  and m.produto = :produto'
      '                  and m.filial = :filial'
      '                   and case when :MovimentoProcessado then'
      
        '                       (m.tipomovimento not in ('#39'IE+'#39','#39'IE-'#39','#39'IT-' +
        #39','#39'IR-'#39','#39'IP-'#39'))'
      '                       else true end'
      
        '                  and m.data > :data and m.data <= :processament' +
        'o),0) +'
      ''
      '                coalesce((select sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 3 for 1)= '#39'+'#39')'
      '                  and m.produto = :produto'
      '                  and m.filial = :filial'
      '                   and case when :MovimentoProcessado then'
      
        '                       (m.tipomovimento not in ('#39'IE+'#39','#39'IE-'#39','#39'IT-' +
        #39','#39'IR-'#39','#39'IP-'#39'))'
      '                       else true end'
      
        '                  and m.data > :data and m.data <= :processament' +
        'o),0) +'
      ''
      '                coalesce((select - sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 3 for 1)= '#39'-'#39')'
      '                  and m.produto = :produto'
      '                  and m.filial = :filial'
      '                   and case when :MovimentoProcessado then'
      
        '                       (m.tipomovimento not in ('#39'IE+'#39','#39'IE-'#39','#39'IT-' +
        #39','#39'IR-'#39','#39'IP-'#39'))'
      '                       else true end'
      
        '                  and m.data > :data and m.data <= :processament' +
        'o),0) +'
      '                  '
      '                coalesce((select sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 9 for 1)= '#39'+'#39')'
      '                  and m.produto = :produto'
      '                  and m.filial = :filial'
      '                   and case when :MovimentoProcessado then'
      
        '                       (m.tipomovimento not in ('#39'IE+'#39','#39'IE-'#39','#39'IT-' +
        #39','#39'IR-'#39','#39'IP-'#39'))'
      '                       else true end'
      
        '                  and m.data > :data and m.data <= :processament' +
        'o),0) +'
      ''
      '                coalesce((select - sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 9 for 1)= '#39'-'#39')'
      '                  and m.produto = :produto'
      '                  and m.filial = :filial'
      '                   and case when :MovimentoProcessado then'
      
        '                       (m.tipomovimento not in ('#39'IE+'#39','#39'IE-'#39','#39'IT-' +
        #39','#39'IR-'#39','#39'IP-'#39'))'
      '                       else true end'
      
        '                  and m.data > :data and m.data <= :processament' +
        'o),0) '
      '                                    '
      '                  ),0) as movimentado'
      ''
      'from movimentos m'
      'where m.produto = :produto'
      '  and m.filial = :filial'
      '  and m.data <= cast(:data as date)'
      '  and case when :MovimentoProcessado then'
      '     (m.tipomovimento not in ('#39'IE+'#39','#39'IE-'#39','#39'IT-'#39','#39'IR-'#39','#39'IP-'#39'))'
      '      else true end'
      'order by data desc, lancto desc limit 1')
    RequestLive = True
    Left = 120
    Top = 296
