  object qryAtualizaInventarioAposProcessamento: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      
        'update inventarioprodutos set emestoqueprocessamento     = selec' +
        'ao.emestoqueprocessamento,'
      
        '                              reservadoprocessamento     = selec' +
        'ao.reservadoprocessamento,'
      
        '                              reservapreviaprocessamento = selec' +
        'ao.reservapreviaprocessamento,'
      
        '                              transitoprocessamento      = selec' +
        'ao.transitoprocessamento,'
      
        '                              demonstracaoprocessamento  = selec' +
        'ao.demonstracaoprocessamento,'
      
        '                              consertoprocessamento      = selec' +
        'ao.consertoprocessamento,'
      
        '                              danificadaprocessamento    = selec' +
        'ao.danificadaprocessamento,'
      
        '                              customedioprocessamento    = selec' +
        'ao.customedioprocessamento,'
      
        '                              financeiroprocessamento    = selec' +
        'ao.financeiroprocessamento'
      'from'
      ''
      '('
      '   select  ip.inventario, ip.produto,'
      ''
      '           coalesce((select m.emestoque'
      '                      from movimentos m'
      '                      where m.produto = ip.produto'
      '                        and m.filial = i.filial'
      '                        and m.data <= i.processamento'
      
        '                      order by data desc, lancto desc limit 1),0' +
        ') as emestoqueprocessamento,'
      ''
      '           coalesce((select m.reservado'
      '                    from movimentos m'
      '                    where m.produto = ip.produto'
      '                      and m.filial = i.filial'
      '                      and m.data <= i.processamento'
      
        '                    order by data desc, lancto desc limit 1),0) ' +
        'as reservadoprocessamento,'
      ''
      '           coalesce((select m.reservaprevia'
      '                    from movimentos m'
      '                    where m.produto = ip.produto'
      '                      and m.filial = i.filial'
      '                      and m.data <= i.processamento'
      
        '                    order by data desc, lancto desc limit 1),0) ' +
        'as reservapreviaprocessamento,'
      ''
      '           coalesce((select m.transito'
      '                    from movimentos m'
      '                    where m.produto = ip.produto'
      '                      and m.filial = i.filial'
      '                      and m.data <= i.processamento'
      
        '                    order by data desc, lancto desc limit 1),0) ' +
        'as transitoprocessamento,'
      ''
      ''
      '           coalesce((select m.demonstracao'
      '                    from movimentos m'
      '                    where m.produto = ip.produto'
      '                      and m.filial = i.filial'
      '                      and m.data <= i.processamento'
      
        '                    order by data desc, lancto desc limit 1),0) ' +
        'as demonstracaoprocessamento,'
      ''
      '           coalesce((select m.conserto'
      '                    from movimentos m'
      '                    where m.produto = ip.produto'
      '                      and m.filial = i.filial'
      '                      and m.data <= i.processamento'
      
        '                    order by data desc, lancto desc limit 1),0) ' +
        'as consertoprocessamento,'
      ''
      '           coalesce((select m.danificada'
      '                    from movimentos m'
      '                    where m.produto = ip.produto'
      '                      and m.filial = i.filial'
      '                      and m.data <= i.processamento'
      
        '                    order by data desc, lancto desc limit 1),0) ' +
        'danificadaprocessamento,'
      ''
      
        '           coalesce((select case when (m.emestoque+m.reservado+m' +
        '.reservaprevia+m.transito+m.demonstracao+m.conserto+m.danificada' +
        ') = 0 then 0'
      
        '                        else round(m.financeiro / (m.emestoque+m' +
        '.reservado+m.reservaprevia+m.transito+m.demonstracao+m.conserto+' +
        'm.danificada), 2) end'
      '                  from movimentos m'
      '                  where m.produto = ip.produto'
      '                    and m.filial = i.filial'
      '                    and m.data <= i.processamento'
      
        '                  order by data desc, lancto desc limit 1),0) as' +
        ' customedioprocessamento,'
      ''
      '           coalesce((select m.financeiro'
      '                  from movimentos m'
      '                  where m.produto = ip.produto'
      '                    and m.filial = i.filial'
      '                    and m.data <= i.processamento'
      
        '                  order by data desc, lancto desc limit 1),0) as' +
        ' financeiroprocessamento'
      
        '   from inventarioprodutos ip join inventario i on ip.inventario' +
        ' = i.numero'
      '   where ip.inventario = :inventario'
      ') as selecao'
      'where inventarioprodutos.inventario = selecao.inventario'
      '  and inventarioprodutos.produto = selecao.produto'
      '')
    RequestLive = True
    Left = 80
    Top = 192
    ParamData = <
      item
        DataType = ftInteger
        Name = 'inventario'
        ParamType = ptUnknown
      end>
  end
  object qryTemp: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryInventarioProdutoAfterOpen
    BeforePost = qryInventarioProdutoBeforePost
    AfterPost = qryInventarioProdutoAfterPost
    AfterDelete = qryInventarioProdutoAfterDelete
    AfterScroll = qryInventarioProdutoAfterScroll
    OnCalcFields = qryInventarioProdutoCalcFields
    OnFilterRecord = qryInventarioProdutoFilterRecord
    OnNewRecord = qryInventarioProdutoNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select'
      '       p.codigovisual as produtovisual,'
      '       cast(null as varchar(30)) as codigobarras,'
      '       p.descricao,'
      '       p.valorgrade1,'
      '       p.valorgrade2,'
      
        '       (select gr.descricao from grades gr where gr.codigo = c.g' +
        'rade1) as linha,'
      
        '       (select gr.descricao from grades gr where gr.codigo = c.g' +
        'rade2) as coluna,'
      ''
      '       case when :MovimentoProcessado then'
      '         ip.emestoque'
      '       else'
      '         coalesce((select m.emestoque'
      '                 from movimentos m'
      '                 where m.produto = p.codigo'
      '                   and m.filial = :filial'
      '                   and m.data <= :data'
      '                 order by data desc, lancto desc limit 1),0)'
      '       end as emestoque,'
      #9'   '
      #9'   '
      
        '      case when ip.emestoqueprocessamento is null and :Movimento' +
        'Processado then'#9'   '#9'   '
      '         coalesce((select m.emestoque'
      '                    from movimentos m'
      '                    where m.produto = p.codigo'
      '                      and m.filial = :filial'
      '                      and m.data <= :processamento'
      
        '                    order by data desc, lancto desc limit 1),0)'#9 +
        '  '
      #9'  else'
      #9'  end as emestoqueprocessamento,'
      #9'   '
      ''
      '       case when :MovimentoProcessado then'
      '         ip.reservado'
      '       else'
      '         coalesce((select m.reservado'
      '                   from movimentos m'
      '                   where m.produto = p.codigo'
      '                     and m.filial = :filial'
      '                     and m.data <= :data'
      '                   order by data desc, lancto desc limit 1),0)'
      '       end as reservado,'
      #9'   '
      
        '      case when ip.reservadoprocessamento is null and :Movimento' +
        'Processado then'#9'   '#9'   '
      '         coalesce((select m.reservado'
      '                    from movimentos m'
      '                    where m.produto = p.codigo'
      '                      and m.filial = :filial'
      '                      and m.data <= :processamento'
      
        '                    order by data desc, lancto desc limit 1),0)'#9 +
        '  '
      #9'  else'
      #9'  end as reservadoprocessamento,'
      #9'   '
      ''
      '       case when :MovimentoProcessado then'
      '         ip.reservaprevia'
      '       else'
      '         coalesce((select m.reservaprevia'
      '                   from movimentos m'
      '                   where m.produto = p.codigo'
      '                     and m.filial = :filial'
      '                     and m.data <= :data'
      '                   order by data desc, lancto desc limit 1),0)'
      '       end as reservaprevia,'
      #9'   '
      
        '      case when ip.reservapreviaprocessamento is null and :Movim' +
        'entoProcessado then'#9'   '#9'   '
      '         coalesce((select m.reservaprevia'
      '                    from movimentos m'
      '                    where m.produto = p.codigo'
      '                      and m.filial = :filial'
      '                      and m.data <= :processamento'
      
        '                    order by data desc, lancto desc limit 1),0)'#9 +
        '  '
      #9'  else'
      #9'  end as reservapreviaprocessamento,'
      #9'   '
      ''
      '       case when :MovimentoProcessado then'
      '         ip.transito'
      '       else'
      '         coalesce((select m.transito'
      '                   from movimentos m'
      '                   where m.produto = p.codigo'
      '                     and m.filial = :filial'
      '                     and m.data <= :data'
      '                   order by data desc,  lancto desc limit 1),0)'
      '       end as transito,'
      #9'   '
      
        '      case when ip.transitoprocessamento is null and :MovimentoP' +
        'rocessado then'#9'   '#9'   '
      '         coalesce((select m.transito'
      '                    from movimentos m'
      '                    where m.produto = p.codigo'
      '                      and m.filial = :filial'
      '                      and m.data <= :processamento'
      
        '                    order by data desc, lancto desc limit 1),0)'#9 +
        '  '
      #9'  else'
      #9'  end as transitoprocessamento,'
      #9'   '
      ''
      '       case when :MovimentoProcessado then'
      
        '         ip.emestoque + ip.reservado + ip.transito + ip.reservap' +
        'revia'
      
        '       else cast(null as numeric(9,3)) end as SaldoAposProcessam' +
        'ento,'
      ''
      '       case when :MovimentoProcessado then'
      '         ip.movimentado'
      '       else'
      '         coalesce((select'
      ''
      '                coalesce((select sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 1 for 1)= '#39'+'#39')'
      '                  and m.produto = ip.produto'
      '                  and m.filial = :filial'
      
        '                  and m.data > :data and m.data <= :processament' +
        'o),0) +'
      ''
      '                coalesce((select - sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 1 for 1)= '#39'-'#39')'
      '                  and m.produto = ip.produto'
      '                  and m.filial = :filial'
      
        '                  and m.data > :data and m.data <= :processament' +
        'o),0) +'
      ''
      '                coalesce((select sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 2 for 1)= '#39'+'#39')'
      '                  and m.produto = ip.produto'
      '                  and m.filial = :filial'
      
        '                  and m.data > :data and m.data <= :processament' +
        'o),0) +'
      ''
      '                coalesce((select - sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 2 for 1)= '#39'-'#39')'
      '                  and m.produto = ip.produto'
      '                  and m.filial = :filial'
      
        '                  and m.data > :data and m.data <= :processament' +
        'o),0) +'
      ''
      '                /*coalesce((select sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 3 for 1)= '#39'+'#39')'
      '                  and m.produto = ip.produto'
      '                  and m.filial = :filial'
      
        '                  and m.data > :data and m.data <= :processament' +
        'o),0) + */'
      ''
      '                coalesce((select - sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 3 for 1)= '#39'-'#39')'
      '                  and m.produto = ip.produto'
      '                  and m.filial = :filial'
      
        '                  and m.data > :data and m.data <= :processament' +
        'o),0) +'
      ''
      '                coalesce((select + sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 9 for 1)= '#39'+'#39')'
      '                  and m.produto = ip.produto'
      '                  and m.filial = :filial'
      
        '                  and m.data > :data and m.data <= :processament' +
        'o),0) +'
      ''
      '                coalesce((select - sum(abs(m.quantidade))'
      '                from movimentos m'
      '                where (substring(m.operacao from 9 for 1)= '#39'-'#39')'
      '                  and m.produto = ip.produto'
      '                  and m.filial = :filial'
      
