    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterScroll = qryProdutosTabloideAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select pt.tabloide,'
      '          pt.produto,'
      '          p.codigovisual as produtovisual,'
      '          pt.descricaoproduto,'
      '          (select sum(emestoque)'
      '           from estoques e, filiais f'
      '           where e.produto = pt.produto'
      '                      and f.codigo=e.filial'
      '                      and f.tipofilial = '#39'D'#39') as quant_deposito,'
      '          (select sum(emestoque)'
      '           from estoques e, filiais f'
      '           where e.produto = pt.produto'
      '                      and f.codigo=e.filial'
      '                      and f.tipofilial = '#39'L'#39') as quant_loja,'
      
        '          (select pedidos_estoquepedido(pt.produto)) as quant_pe' +
        'dido,'
      '          pt.plano,'
      '          pt.prestacao,'
      '          pt.precopauta,'
      '          pt.precosugestao,'
      '          pt.precovenda,'
      '          pt.total,'
      '          pt.posicao,'
      '          pt.foto,'
      '          p.referencia,'
      
        '          (select gr.descricao from grades gr where gr.codigo = ' +
        'c.grade1) as linha,'
      
        '          (select gr.descricao from grades gr where gr.codigo = ' +
        'c.grade2) as coluna,'
      '          p.valorgrade1,'
      '          p.valorgrade2,'
      '          c.observacao,'
      '          false as imprimir,'
      '          pl.descricao as descricaoplano,'
      '          pl.taxamensaljuros as taxajurosmensal,'
      
        '          ((power((pl.taxamensaljuros/100)+1,12))-1)*100 as taxa' +
        'jurosanual'
      
        'from produtostabloides pt, produtos p, caracteristicas c, planos' +
        ' pl'
      'where  pt.produto = p.codigo'
      'and p.caracteristica = c.codigo'
      'and pt.plano = pl.codigo '
      'and pt.tabloide =:tabloide')
