  object qryProdutosNotaFiscal: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkFields = 'caracteristica=caracteristica'
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryProdutosNotaFiscalBeforeOpen
    AfterOpen = qryProdutosNotaFiscalAfterOpen
    BeforeInsert = qryProdutosNotaFiscalBeforeInsert
    AfterInsert = qryProdutosNotaFiscalAfterInsert
    BeforeEdit = qryProdutosNotaFiscalBeforeEdit
    BeforePost = qryProdutosNotaFiscalBeforePost
    AfterPost = qryProdutosNotaFiscalAfterPost
    AfterCancel = qryProdutosNotaFiscalAfterCancel
    BeforeDelete = qryProdutosNotaFiscalBeforeDelete
    AfterDelete = qryProdutosNotaFiscalAfterDelete
    AfterScroll = qryProdutosNotaFiscalAfterScroll
    OnCalcFields = qryProdutosNotaFiscalCalcFields
    OnDeleteError = PostError
    OnEditError = PostError
    OnPostError = PostError
    OnNewRecord = qryProdutosNotaFiscalNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT p.codigovisual as produtovisual,'
      '       c.icms,'
      '       c.ipi,'
      '       0.00 as aliquotaipioriginal,'
      '       c.grade1,'
      '       c.grade2,'
      
        '       (select gr.descricao from grades gr where gr.codigo = c.g' +
        'rade1) as linha,'
      
        '       (select gr.descricao from grades gr where gr.codigo = c.g' +
        'rade2) as coluna,'
      '       p.valorgrade1,'
      '       p.valorgrade2,'
      '       p.caracteristica,'
      '       p.referencia,'
      '       c.codigovisual as caracteristicavisual,'
      '       c.descricao as descricaocaracteristica,'
      '       p.preco,'
      
        '       (select pr.descricao from precos pr where pr.caracteristi' +
        'ca = p.caracteristica and pr.codigo = p.preco ) as descricaoprec' +
        'oproduto,'
      '/*       pr.descricao as descricaoprecoproduto, */'
      '       (pn.precounitario * pn.quantidade) as produtototal,'
      '       g.calcularpreco,'
      
        '      (select m1.valor from estadosicms m1 where m1.icms = c.icm' +
        's and m1.estado =:EstadoFilialBaseCalculoPreco) as aliquotaicmsc' +
        'alculopreco,'
      '       false as PermitirAtualizar,'
      
        '       case when np.situacao = '#39'N'#39' then false else cast(null as ' +
        'Boolean) end as permitiratualizardigitado,'
      '       p.codigorecolha,'
      
        '       (select cp.valor from colunasprecos cp where cp.caracteri' +
        'stica = p.caracteristica and cp.preco = p.preco and cp.coluna = ' +
        ':PrecoNormal) as ValorAtual,'
      '       c.composto,'
      '       0.00 as precovenda,'
      '       0.00 as CustoTotal,'
      '       0.00 as CustoTotalFatorizado,'
      '       0.00 as CustoParaVenda,'
      '       0.00 as PrecoAtual,'
      '       0.00 as PrecoAtribuido,'
      '       0.00 as PrecoDigitado,'
      '       false as PrecoDigitadoAlterado,'
      '       c.grupo,'
      '       c.classe,'
      
        '       case when g.naoreplicar then true else cl.naoreplicar end' +
        ' as naoreplicar,'
      '       (select n.tipomovimento'
      '        from naturezas n'
      '        where n.codigo = pn.natureza'
      '       ) as tipomovimento,'
      ''
      '       (select n.gerarpagamento'
      '        from naturezas n'
      '        where n.codigo = pn.natureza'
      '       ) as gerarpagamento,'
      ''
      '       (select tm.operacao'
      '        from tiposmovimentos tm, naturezas n'
      '        where tm.codigo = n.tipomovimento'
      '          and n.codigo = pn.natureza'
      '       ) as operacao,'
      '       '#39#39' as localizacao,'
      '       true as produtook,'
      
        '       (select n.filial from notas n where n.dadofiscal = pn.dad' +
        'ofiscal) as filialnotafiscalsaida,'
      
        '       (select n.serie from notas n where n.dadofiscal = pn.dado' +
        'fiscal) as serienotafiscalsaida,'
      
        '       (select n.numero from notas n where n.dadofiscal = pn.dad' +
        'ofiscal) as numeronotafiscalsaida,'
      
        '       (select u.descricao from unidades u where u.codigo = pn.u' +
        'nidade) as descricaounidade,'
      ''
      '       case when np.situacao = '#39'P'#39' then'
      
        '         (select ti.valor from tributosicms ti where ti.codigo =' +
        ' c.incidencia)'
      '       else'
      '         pn.cst_produto'
      '       end as cst_produto_1,'
      ''
      '       case when np.situacao = '#39'P'#39' then'
      '         c.csosn'
      '       else'
      '         pn.csosn_produto'
      '       end as csosn_produto_1,'
      ''
      '       case when np.situacao = '#39'P'#39' then'
      '         c.markup'
      '       else'
      '         coalesce(pn.markup_produto,c.markup)'
      '       end as markup_produto_1,'
      ''
      '       case when np.situacao = '#39'P'#39' then'
      '         g.markup'
      '       else'
      '         coalesce(pn.markup_grupo,g.markup)'
      '       end as markup_grupo_1,'
      ''
      '       case when np.situacao = '#39'P'#39' then'
      
        '         (select vf.markup from vfornecedores vf where vf.codigo' +
        ' = np.fornecedor and vf.tipo = np.tipofornecedor)'
      '       else'
      
        '         coalesce(pn.markup_fornecedor,(select vf.markup from vf' +
        'ornecedores vf where vf.codigo = np.fornecedor and vf.tipo = np.' +
        'tipofornecedor))'
      '       end as markup_fornecedor,'
      ''
      ''
      
        '       (select (pp.preco * (100 - coalesce(pp.desconto,0)) / 100' +
        ')  from produtospedidos pp where pp.pedido = pn.pedido and pp.pr' +
        'oduto = pn.produto and pp.numero = pn.numeroprodutotabela) as Pr' +
        'ecoUnitarioPedido,'
      '       c.percreducaobase as percentualreducaobase_produto,'
      ''
      '      pn.codigonota                  ,'
      '      pn.numero                      ,'
      ''
      '      case when np.situacao = '#39'N'#39' then'
      '        pn.numero'
      '      else'
      '        cast(null as integer)'
      '      end as numerooriginal,'
      ''
      '      pn.filial                      ,'
      '      pn.filial as filialincluidaoriginal,'
      '      pn.produto                     ,'
      '      pn.produto as produtoincluidooriginal, '
      '      pn.aliquotaicms                , '
      '      pn.baseicms                    , '
      '      pn.valoricms                   , '
      '      pn.aliquotaipi                 , '
      '      pn.valoripi                    , '
      '      pn.desconto                    , '
      '      pn.valorreducaobase            , '
      '      pn.percentualreducaobase       , '
      '      pn.precounitario               , '
      '      pn.quantidade                  , '
      '      pn.incidencia                  , '
      '      pn.pedido                      , '
      '      pn.movimento                   , '
      '      pn.acrescimo                   , '
      '      pn.frete                       , '
