    Constraints = <>
    AfterOpen = qryAdicoesImportacaoAfterOpen
    BeforePost = qryAdicoesImportacaoBeforePost
    AfterPost = qryAdicoesImportacaoAfterPost
    AfterCancel = qryAdicoesImportacaoAfterCancel
    AfterDelete = qryAdicoesImportacaoAfterDelete
    OnCalcFields = qryAdicoesImportacaoCalcFields
    OnNewRecord = qryAdicoesImportacaoNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT *, '#39#39' as nomefabricante /*, false as totais*/'
      'FROM adicoes'
      'WHERE dadoimportacao = :importacao'
      'order by numero')
    RequestLive = True
