      '      pn.icmssobredespesasacessorias , '
      '      pn.vbcstretdesp                , '
      '      pn.vicmsstretdesp              , '
      '      pn.icmsbasecalculo_dev         , '
      '      pn.icmsvalor_dev               , '
      '      pn.produtodigitado             , '
      '      pn.percreducaomva              ,'
      '      /*'
      '      coalesce(pn.markup_produto,c.markup) as markup_produto,'
      '      coalesce(pn.markup_grupo,g.markup) as markup_grupo,'
      
        '      coalesce(pn.markup_fornecedor,(select vf.markup from vforn' +
        'ecedores vf where vf.codigo = np.fornecedor and vf.tipo = np.tip' +
        'ofornecedor)) as markup_fornecedor,'
      '      */'
      '      pn.markup_produto,'
      '      pn.markup_grupo,'
      '      pn.markup_fornecedor,'
      '      pn.csosn_produto,'
      '      pn.cst_produto,'
      ''
      '      pn.pfcp,'
      '      pn.vfcp,'
      '      pn.vbcfcpst,'
      '      pn.pfcpst,'
      '      pn.vfcpst,'
      '      pn.vbcfcp,'
      '      pn.vBCFCPSTRet,'
      '      pn.pFCPSTRet,'
      '      pn.vFCPSTRet,'
      '      pn.vBCFCPUFDest,'
      '      pn.pst,'
      ''
      '      false as msgfatorsubstituicao_custo'
      ''
      ''
      ''
      
        'from produtosnotaspag pn, notaspag np, produtos p, caracteristic' +
        'as c, grupos g, classes cl /*, precos pr */'
      'where (pn.codigonota = np.codigo)'
      '  and (p.codigo = pn.produto)'
      '  and (p.caracteristica = c.codigo)'
      '  and (c.grupo = g.codigo)'
      '  and (c.classe = cl.codigo)'
      '  and (pn.codigonota = :Codigo)'
      '/*  and (p.caracteristica = pr.caracteristica)'
      '  and (p.preco = pr.codigo) */'
      'order by pn.numero')
