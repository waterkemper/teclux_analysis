  object qryIncluirCaracteristicasNotaFiscal: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'insert into caracteristicasnotaspag (codigonota, caracteristica)'
      ''
      '('
      ' select distinct pnp.codigonota, p.caracteristica'
      ' from produtosnotaspag pnp'
      '      join produtos p on pnp.produto = p.codigo'
      ' where pnp.codigonota = :codigonota'
      '   and p.caracteristica not in (select cnp.caracteristica'
      '                                from caracteristicasnotaspag cnp'
      
        '                                where cnp.codigonota = :codigono' +
        'ta)'
      
        ' order by pnp.codigonota, p.caracteristica                      ' +
        '          '
      ')'
      ''
      '')
    RequestLive = False
    Left = 328
    Top = 661
    ParamData = <
      item
        DataType = ftString
        Name = 'codigonota'
        ParamType = ptUnknown
        Value = '0'
      end>
  end
  object qrycaracteristicaselementosnotaspag_l: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeInsert = qrycaracteristicaselementosnotaspag_lBeforeInsert
    AfterPost = qrycaracteristicaselementosnotaspag_lAfterPost
    AfterDelete = qrycaracteristicaselementosnotaspag_lAfterDelete
    AfterScroll = qrycaracteristicaselementosnotaspag_lAfterScroll
    OnNewRecord = qrycaracteristicaselementosnotaspag_lNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select cenp_l.*,'
      ''
      '       coalesce((select true'
      '                 from produtosnotaspag pnp'
      '                      join produtos p'
      '                      on pnp.produto = p.codigo'
      '                 where pnp.codigonota = :codigonota'
      '                   and p.caracteristica = :caracteristica'
      
        '                   and p.valorgrade1 = cenp_l.valor limit 1),fal' +
        'se) as contidonanfe,'
      ''
      '       coalesce((select true'
      '                 from produtos p'
      '                 where p.caracteristica = :caracteristica'
      
        '                   and p.valorgrade1 = cenp_l.valor limit 1),fal' +
        'se) as PresenteemProdutos,'
      ''
      '       coalesce((select true'
      '                 from produtos p'
      '                 where p.caracteristica = :caracteristica'
      
        '                   and p.valorgrade1 = cenp_l.valor limit 1),fal' +
        'se) as emuso,'
      '                   '
      '       eg.abreviatura'
      ''
      'from caracteristicaselementosnotaspag cenp_l'
      '     join elementosgrades eg'
      '     on cenp_l.grade = eg.grade'
      '     and cenp_l.valor = eg.valor'
      '     '
      'where cenp_l.codigonota = :codigonota'
      '  and cenp_l.caracteristica = :caracteristica'
      '  and cenp_l.grade = :grade1'
      ''
      'order by cenp_l.valor')
    RequestLive = True
    Left = 360
    Top = 709
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codigonota'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'caracteristica'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'grade1'
        ParamType = ptUnknown
      end>
