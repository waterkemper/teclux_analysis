    Filtered = True
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select eg.*,'
      ''
      '       coalesce((select true'
      '                 from produtos p'
      '                 where p.caracteristica = :caracteristica'
      
        '                   and p.valorgrade1 = eg.valor limit 1),false) ' +
        'as PresenteemProdutos,'
      ''
      '       coalesce((select true'
      '                 from produtos p'
      '                 where p.caracteristica = :caracteristica'
      
        '                   and p.valorgrade1 = eg.valor limit 1),false) ' +
        'as emuso,'
      ''
      '       false as marcar'
      ''
      '       /*'
      '       coalesce((select true'
      '        from caracteristicaselementosnotaspag cenp_l'
      '        where cenp_l.codigonota = :codigonota'
      '          and cenp_l.caracteristica = :caracteristica'
      '          and cenp_l.grade = eg.grade'
      '          and cenp_l.valor = eg.valor),false) as marcar'
      '          */'
      ''
      ''
      'from elementosgrades eg'
      'where eg.grade = :grade1'
      ' and eg.usual'
      ' and eg.valor is not null'
      
        ' and (eg.grade,eg.valor) not in (select cenp_l.grade, cenp_l.val' +
        'or'
      
        '                                  from caracteristicaselementosn' +
        'otaspag cenp_l'
      
        '                                  where cenp_l.codigonota = :cod' +
        'igonota'
      
        '                                    and cenp_l.caracteristica = ' +
        ':caracteristica'
      '                                    and cenp_l.grade = :grade1)'
      ''
      'order by eg.valor')
    RequestLive = True
    Left = 464
    Top = 685
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'caracteristica'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codigonota'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'grade1'
        ParamType = ptUnknown
      end>
