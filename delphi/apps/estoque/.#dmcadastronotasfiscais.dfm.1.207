  object qryProdutosDadosFiscais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT pf.dadofiscal,'
      '              pf.quantidade, '
      '              pf.aliquotaicms, '
      '              pf.produto, '
      '              pf.filial,'
      '              pf.precovenda, '
      '              pf.precovenda * pf.quantidade as precototal,'
      
        '              cast(p.descricao||'#39' '#39'||coalesce(p.valorgrade1,'#39#39')|' +
        '|'#39' '#39'||coalesce(p.valorgrade2,'#39#39') as varchar) AS produtodescricao' +
        ','
      '              p.referencia,'
      '              c.unidade,  '
      '              e.localizacao,'
      
        '              (select o.descricao from obslegais o where c.obsle' +
        'gal = o.codigo) as obslegal,'
      '              c.origem, '
      
        '              (select t.valor from tributosicms t where c.incide' +
        'ncia = t.codigo) as incidencia,'
      '              m.descricao AS marcadescricao'
      'FROM'
      
        '         produtosdadosfiscais pf JOIN produtos p ON ( pf.produto' +
        ' = p.codigo )'
      
        '         JOIN estoques e ON ((pf.produto = e.produto) and (pf.fi' +
        'lial = e.filial))'
      
        '         JOIN caracteristicas c ON ( p.caracteristica = c.codigo' +
        ' )'
      '         JOIN  marcas m ON  (c.marca = m.codigo)'
      'WHERE'
      '          pf.dadofiscal = :dadofiscal '
      'ORDER BY pf.numero')
    RequestLive = False
    Left = 568
    Top = 157
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'dadofiscal'
        ParamType = ptUnknown
      end>
    object qryProdutosDadosFiscaisquantidade: TFloatField
      FieldName = 'quantidade'
      DisplayFormat = '0'
    end
    object qryProdutosDadosFiscaisaliquotaicms: TFloatField
      FieldName = 'aliquotaicms'
      DisplayFormat = '0.00'
    end
    object qryProdutosDadosFiscaisproduto: TLargeintField
      FieldName = 'produto'
