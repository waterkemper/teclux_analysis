      item
        DataType = ftUnknown
        Name = 'CodigoFiscal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CondicaoCodigoFiscalProduto'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select case when '#39'F'#39' = :local then naturezas.codigofiscal + 1000'
      '            when '#39'E'#39' = :local then naturezas.codigofiscal + 2000'
      '            else  naturezas.codigofiscal'
      '       end as codigofiscal,'
      '       cf.descricao as descricaocodigofiscal,'
      '       naturezas.descricao as descricaonatureza,'
      '       naturezas.codigo,'
      '       naturezas.naogerarcreditoicms,'
      '       naturezas.naogerarcreditoipi,'
      '       naturezas.naocalcularipisobrefrete,'
      '       naturezas.icmssobreipi,'
      '       naturezas.icmssobredespesasacessorias,'
      '       naturezas.gerarpagamento,'
      '       naturezas.tipomovimento,'
      '       tm.descricao as descricaotipomovimento'
      ''
      'from naturezas'
      '     join codigosfiscais cf'
      '     on naturezas.codigofiscal = cf.codigo'
      
        '     left join tiposmovimentos tm on naturezas.tipomovimento = t' +
        'm.codigo'
      ''
      'where (naturezas.inativo is null)'
      '   and (naturezas.tipo = '#39'E'#39')'
      '%CodigoFiscal'
      '%CondicaoCodigoFiscalProduto'
      
        'and case when :finalidade = 4 then cf.devolucaoretorno else not ' +
        'cf.devolucaoretorno end'
      'order by UPPER(TO_ASCII(cf.descricao,'#39'LATIN1'#39'))')
    RequestLive = False
    Left = 936
    Top = 53
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'local'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'finalidade'
        ParamType = ptUnknown
      end>
