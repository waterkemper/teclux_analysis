  object qryProcuraNaturezas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryProcuraNaturezasBeforeOpen
    BeforeClose = qryProcuraNaturezasBeforeClose
    AfterScroll = qryProcuraNaturezasAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereInativo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CodigoNaturezaPadrao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      ' select distinct selecionado.* from'
      '('
      '('
      'select case when '#39'F'#39' = :local then codigofiscal + 1000'
      '            when '#39'E'#39' = :local then codigofiscal + 2000'
      '            else  codigofiscal'
      '       end as codigofiscal,'
      '       naturezas.descricao, naturezas.codigo,'
      '       tipomovimento, entrada,'
      
        '       (select m.operacao from tiposmovimentos m where tipomovim' +
        'ento = m.codigo) as operacao,'
      
        '       (select cf.descricao from codigosfiscais cf where cf.codi' +
        'go = codigofiscal) as descricaocfop,'
      '       gerarpagamento,'
      '       debitar,'
      '       pld.descricao as descricaodebitar,'
      '       pld.classificacao as classificacaodebitar,'
      '       creditar,'
      '       plc.descricao as descricaocreditar,'
      '       plc.classificacao as classificacaocreditar,'
      '       naturezas.historico,'
      '       icmscst,'
      '       csosn,'
      '       ipicst,'
      '       piscst,'
      '       cofinscst,'
      '       CReDBigualValorNota,'
      '       GravarSemLanctos,'
      '       naturezas.destacaripi,'
      '       diferenciada,'
      '       naogerarcreditoicms,'
      '       naogerarcreditoipi,'
      '       naocalcularipisobrefrete,'
      '       icmssobreipi,'
      '       icmssobredespesasacessorias,'
      '       requernfsaida,'
      '       naoutilizarobsautomaticas'
      ''
      
        'from naturezas join codigosfiscais cf on naturezas.codigofiscal ' +
        '= cf.codigo'
      
        '               left join planocontas pld on naturezas.debitar = ' +
        'pld.codigo'
      
        '                       left join planocontas plc on naturezas.cr' +
        'editar = plc.codigo'
      'where  (naturezas.tipo = '#39'E'#39')'
      ''
      '   and ((mod(codigofiscal,1000)) = (select mod(cf.codigo,1000)'
      
        '                                                  from codigosfi' +
        'scais cf'
      
        '                                                  where cf.codig' +
        'o = :codigofiscal))'
      ''
      ''
      '/*'
      
        '   and   (((codigofiscal      = :codigofiscal) and ('#39'L'#39' = :local' +
        ')) or'
      
        '          ((codigofiscal+1000 = :codigofiscal) and ('#39'F'#39' = :local' +
        ')) or'
      
        '          ((codigofiscal+2000 = :codigofiscal) and ('#39'E'#39' = :local' +
        ')))'
      '*/'
      ''
      ''
      '%WhereInativo'
      '%CodigoNaturezaPadrao'
      
        'and case when :finalidade = 4 then cf.devolucaoretorno else not ' +
        'cf.devolucaoretorno end'
      ''
      ')'
      'union all'
      '('
      'select :codigofiscal  as codigofiscal,'
      '       naturezas.descricao,naturezas.codigo,'
      '       tipomovimento, entrada,'
      
        '       (select m.operacao from tiposmovimentos m where tipomovim' +
        'ento = m.codigo) as operacao,'
      
        '       (select cf.descricao from codigosfiscais cf where cf.codi' +
        'go = codigofiscal) as descricaocfop,'
      '       gerarpagamento,'
      '       debitar,'
      '       pld.descricao as descricaodebitar,'
      '       pld.classificacao as classificacaodebitar,'
      '       creditar,'
      '       plc.descricao as descricaocreditar,'
      '       plc.classificacao as classificacaocreditar,'
      '       naturezas.historico,'
      '       icmscst,'
      '       csosn,'
      '       ipicst,'
      '       piscst,'
      '       cofinscst,'
      '       CReDBigualValorNota,'
      '       GravarSemLanctos,'
      '       naturezas.destacaripi,'
      '       diferenciada,'
      '       naogerarcreditoicms,'
      '       naogerarcreditoipi,'
      '       naocalcularipisobrefrete,'
      '       icmssobreipi,'
      '       icmssobredespesasacessorias,'
      '       requernfsaida,'
      '       naoutilizarobsautomaticas'
      ''
      
        'from naturezas join codigosfiscais cf on naturezas.codigofiscal ' +
        '= cf.codigo'
      
        '                left join planocontas pld on naturezas.debitar =' +
        ' pld.codigo'
      
        '                       left join planocontas plc on naturezas.cr' +
        'editar = plc.codigo'
      'where (naturezas.tipo = '#39'E'#39')'
      '  and  (:codigofiscal = 1353 or :codigofiscal = 2353)'
      '   and ((codigofiscal          = :codigofiscal) or'
      '        (codigofiscal+1000 = :codigofiscal))'
      ''
      '%WhereInativo'
      '%CodigoNaturezaPadrao'
      
        'and case when :finalidade = 4 then cf.devolucaoretorno else not ' +
        'cf.devolucaoretorno end'
      ''
      ')'
      ') as selecionado')
    RequestLive = False
    Left = 864
    Top = 29
    ParamData = <
      item
        DataType = ftString
        Name = 'local'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'codigofiscal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'finalidade'
        ParamType = ptUnknown
      end>
    object qryProcuraNaturezasdescricao: TStringField
      DisplayWidth = 80
      FieldName = 'descricao'
      Size = 80
    end
    object qryProcuraNaturezascodigofiscal: TIntegerField
      FieldName = 'codigofiscal'
      DisplayFormat = '0'
    end
    object qryProcuraNaturezastipomovimento: TStringField
      FieldName = 'tipomovimento'
      Size = 3
    end
    object qryProcuraNaturezasgerarpagamento: TBooleanField
      FieldName = 'gerarpagamento'
    end
    object qryProcuraNaturezasoperacao: TStringField
