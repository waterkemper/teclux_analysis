  object qryProcuraFornecedores: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryProcuraFornecedoresAfterOpen
    AfterScroll = qryProcuraFornecedoresAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select f.codigo,'
      '          f.nome, f.razao,'
      '          f.estado,'
      '          f.pessoanumero,'
      '          f.pessoatipo,'
      '          f.inscricaoestadual,'
      '          f.tipo,'
      '          f.markup,'
      '          f.rua,'
      '          f.bairro,'
      '          f.cidade,'
      '          f.cep,'
      '          f.fonenumero,'
      '          f.foneddd,'
      ''
      '          f.numero,'
      '          f.complemento,'
      ''
      '          (select b.nome'
      '           from bairros b'
      '           where b.estado = f.estado'
      '             and b.cidade = f.cidade'
      '             and b.codigo = f.bairro) as NomeBairro,'
      ''
      '          (select c.nome'
      '           from cidades c'
      '           where c.estado = f.estado'
      '             and c.codigo = f.cidade) as NomeCidade,'
      ''
      ''
      '          (select c.CodigoIBGE'
      '           from cidades c'
      '           where c.estado = f.estado'
      '             and c.codigo = f.cidade) as CidadeIBGE,'
      ''
      '          (select d.tipofornecimento[1]='#39'T'#39
      '           from fornecedores d'
      '           where d.codigo = f.codigo'
      '          ) as tipofornecimento_T,'
      '          (select d1.grupofornecedor'
      '           from fornecedores d1'
      '           where d1.codigo = f.codigo'
      '          ) as grupofornecedor,'
      '          f.debito,'
      
        '          (select descricao from planocontas pl where pl.codigo=' +
        'f.debito) as descricaodebitoplanocontas,'
      
        '          (select classificacao from planocontas pl where pl.cod' +
        'igo=f.debito) as classificacaodebitoplanocontas,'
      '          f.credito,'
      
        '          (select descricao from planocontas pl where pl.codigo=' +
        'f.credito) as descricaocreditoplanocontas,'
      
        '          (select classificacao from planocontas pl where pl.cod' +
        'igo=f.credito) as classificacaocreditoplanocontas,'
      
        '          coalesce((select fo.NaoSubstituto from fornecedores fo' +
        ' where fo.codigo = f.codigo and f.tipo='#39'F'#39'),true) as NaoSubstitu' +
        'to,'
      ''
      '          coalesce((select fr.distribuidor'
      '                    from fornecedores fr'
      '                    where fr.codigo = f.codigo'
      '                      and f.tipo='#39'F'#39
      '                   ),false) as distribuidor,'
      '         f.nosimples,'
      ''
      '         case when :tipo = '#39'F'#39' then'
      '                   (select fr.crt'
      '                    from fornecedores fr'
      '                    where fr.codigo = f.codigo'
      '                      and '#39'F'#39' = :tipo'
      '                   )'
      '              when :tipo = '#39'L'#39' then'
      '                   (select fl.regimetributario'
      '                    from filiais fl'
      '                    where fl.codigo = f.codigo'
      '                      and '#39'L'#39' = :tipo'
      '                   )'
      '              when :tipo = '#39'C'#39' then'
      
        '                case when f.nosimples then cast(1 as smallint) e' +
        'lse cast(3 as smallint) end'
      '         end as crt,'
      ''
      '         (case when f.tipo='#39'C'#39' then'
      '                    (select cl.contribicms'
      '                     from clientes cl'
      '                     where cl.codigo = f.codigo)'
      '               when f.tipo='#39'F'#39' then'
      '                    (select fo.contribicms'
      '                     from fornecedores fo'
      '                     where fo.codigo = f.codigo)'
      '               when f.tipo='#39'L'#39' then'
      '                    (select fi.contribicms'
      '                     from filiais fi'
      '                     where fi.codigo = f.codigo)'
      '          end) as contribicms,'
      '          f.email,'
      '          f.suframa,'
      
        '          coalesce((select fo.dda from fornecedores fo where fo.' +
        'codigo = f.codigo and f.tipo='#39'F'#39'),false) as dda'
      ''
      ''
      ''
      'from vfornecedores f'
      'where (f.codigo = :codigo) and'
      '      (f.tipo = :tipo)'
      'order by UPPER(TO_ASCII(coalesce(f.razao,f.nome),'#39'LATIN1'#39'))')
    RequestLive = False
    Left = 752
    Top = 205
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'tipo'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'codigo'
        ParamType = ptUnknown
      end>
