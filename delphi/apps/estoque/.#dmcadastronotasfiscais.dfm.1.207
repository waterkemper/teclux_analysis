    OnDeleteError = PostError
    OnEditError = PostError
    OnPostError = PostError
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select pp.pedido,'
      '           pp.numero,'
      '           pp.dias,'
      '           pp.percentual,'
      '           somatorio.parcial,'
      '           round (pedidos_total(pp.pedido), 2) as total,'
      '           (Select pe."database" + int4(pp.dias)'
      '            From  pedidos pe'
      '            Where pe.numero = pp.pedido) as data,'
      '           case  when pp.numero = (Select min(numero)'
      
        '                                                    From previso' +
        'espedidos p'
      
        '                                                    Where p.pedi' +
        'do = pp.pedido) then round ((pedidos_total(pp.pedido) * pp.perce' +
        'ntual) / 100, 2)'
      
        '                                                                ' +
        '                                       +  round (pedidos_total(p' +
        'p.pedido), 2) - somatorio.parcial'
      
        '                    else round ((pedidos_total(pp.pedido) * pp.p' +
        'ercentual) / 100, 2)'
      '           end as valor'
      'From previsoespedidos pp,'
      
        '         (Select sum(round ((pedidos_total(p.pedido) * p.percent' +
        'ual) / 100 ,2 ) ) as parcial'
      '          From previsoespedidos p'
      '          Where pedido = :numero) somatorio'
      'Where pp.pedido = :numero'
      'Order by pp.numero')
    RequestLive = True
    Left = 368
    Top = 333
    ParamData = <
      item
        DataType = ftInteger
        Name = 'numero'
        ParamType = ptUnknown
        Value = 0
