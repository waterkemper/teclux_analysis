  object qryConsultaPedidosProdutoNFE: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'SQLProdutosPedidos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SQLProdutosNotasPag'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select p.numero as pedido,'
      '       ppp.numero as numero,'
      '       p.emissao,'
      '       p.entrega,'
      '       p.referencia,'
      '       f.codigo,'
      '       f.nome,'
      
        '       ppp.preco * (100 - coalesce(ppp.desconto,0)) / 100 as pre' +
        'counitariopedido'
      'from pedidos p, produtospedidos ppp, fornecedores f'
      'where p.fornecedor = f.codigo'
      '  and p.numero = ppp.pedido'
      '  and p.cancelado is null '
      '  and p.concluido is null'
      '  and p.filialentrega = :filialentrega'
      '  and (p.fornecedor = :fornecedor or f.grupofornecedor =:grupo)'
      '  and (ppp.pedido, ppp.numero, ppp.produto)  in ('
      '                    (select pp.pedido, pp.numero, pp.produto'
      
        '                     from (select pp1.pedido, pp1.numero, pp1.pr' +
        'oduto'
      '                           from produtospedidos pp1'
      '                           where pp1.pedido = p.numero'
      '                           %SQLProdutosPedidos'
      
        '                           group by pp1.pedido, pp1.numero, pp1.' +
        'produto'
      
        '                           having sum(pp1.quantidade) > (select ' +
        'coalesce(sum(pnp.quantidade),0)'
      
        '                                                         from pr' +
        'odutosnotaspag pnp join notaspag np on pnp.codigonota = np.codig' +
        'o'
      
        '                                                         where p' +
        'np.pedido = pp1.pedido'
      
        '                                                           and p' +
        'np.produto = pp1.produto'
      
        '                                                           and p' +
        'np.numeroprodutotabela = pp1.numero'
      
        '                                                           and n' +
        'p.situacao <> '#39'C'#39')'
      '                    ) as pp'
      '                   )'
      '                   /*'
      '                    union all'
      '                   ('
      
        '                    select distinct pnp.pedido, pnp.numeroprodut' +
        'otabela, pnp.produto'
      '                    from produtosnotaspag pnp'
      '                    where pnp.codigonota = :codigonota'
      '                      and pnp.pedido is not null'
      #9#9#9#9#9'            and not :PesquisaNFE'
      '                      %SQLProdutosNotasPag'
      '                   )'
      '                   */'
      '                  )'
      ''
      'order by p.numero, ppp.numero')
    RequestLive = False
    Left = 504
    Top = 253
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'filialentrega'
        ParamType = ptUnknown
      end
