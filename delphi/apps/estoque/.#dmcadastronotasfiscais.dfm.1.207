  object qryIncluirprodutoscodigobarras: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'insert into produtoscodigobarras (produto, codigobarras)'
      ''
      '('
      '    select DISTINCT pnpnfei.produto, pnpnfe.ceantrib'
      ''
      '    FROM produtosnotaspagnfeitems pnpnfei'
      '         join produtosnotaspagnfe pnpnfe'
      '         on pnpnfei.codigonota = pnpnfe.codigonota'
      '         and pnpnfei.numerosequencianfe = pnpnfe.numero'
      ''
      '         join produtosnotaspag pnp'
      '         on pnpnfei.codigonota = pnp.codigonota'
      
        '            and pnpnfei.numerosequencianfe = pnp.numerosequencia' +
        'nfe'
      '            and pnpnfei.numero = pnp.numerosequencianfeitens'
      '            '
      '    where pnpnfei.codigonota = :codigonota '
      '      and pnpnfe.ceantrib in  '
      ''
      '    (        '
      '    '
      '      select pnpnfe.ceantrib'
      '      from'
      '      ('
      '      '
      '        select DISTINCT pnpnfei.produto, pnpnfe.ceantrib'
      ''
      '        FROM produtosnotaspagnfeitems  pnpnfei'
      '             join produtosnotaspagnfe pnpnfe'
      '             on pnpnfei.codigonota = pnpnfe.codigonota'
      '             and pnpnfei.numerosequencianfe = pnpnfe.numero'
      ''
      '             join produtosnotaspag pnp'
      '             on pnpnfei.codigonota = pnp.codigonota'
      
        '             and pnpnfei.numerosequencianfe = pnp.numerosequenci' +
        'anfe'
      '             and pnpnfei.numero = pnp.numerosequencianfeitens'
      ''
      '        where pnpnfei.codigonota = :codigonota'
      '          and pnpnfei.produto is not null'
      '          and btrim(coalesce(pnpnfe.ceantrib,'#39#39'))<>'#39#39
      '          and btrim(coalesce(pnpnfe.ceantrib,'#39#39'))<>'#39'SEM GTIN'#39
      ''
      '          and not exists (select pcb.produto'
      '                         from produtoscodigobarras pcb'
      
        '                         where pcb.codigobarras = pnpnfe.ceantri' +
        'b)'
      ''
      '        order by pnpnfei.produto, pnpnfe.ceantrib'
      ''
      '      ) as pnpnfe'
      '      group by pnpnfe.ceantrib having count(*)=1'
      '      '
      '    )'
      '    '
      '    order by pnpnfei.produto, pnpnfe.ceantrib'
      ')')
    RequestLive = True
    Left = 592
    Top = 448
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codigonota'
        ParamType = ptUnknown
      end>
  end
