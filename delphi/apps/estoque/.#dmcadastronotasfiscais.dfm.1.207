  object qryProdutosImportados: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryProdutosImportadosBeforeOpen
    AfterPost = qryProdutosImportadosAfterPost
    OnCalcFields = qryProdutosImportadosCalcFields
    OnNewRecord = qryProdutosImportadosNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT pi.dadoimportacao,'
      '       pi.numeroadicao,'
      '       pi.produto,'
      '       pi.produtodigitado,'
      '       pi.aliquotaipi,'
      '       pi.valor,'
      '       pi.quantidade,'
      '       p.codigovisual as produtovisual,'
      '       p.descricao,'
      ''
      '       case when pi.produto = (select produto'
      '                               from produtosimportados pi2'
      
        '                               where pi2.numeroadicao = pi.numer' +
        'oadicao'
      
        '                                 and pi2.dadoimportacao = pi.dad' +
        'oimportacao'
      
        '                               order by produto desc limit 1) th' +
        'en'
      ''
      '         round((select sum(pi2.valor*di.taxacambio)'
      '          from produtosimportados pi2'
      '               join dadosimportacoes di'
      '               on pi2.dadoimportacao = di.numero'
      '          where pi2.numeroadicao = pi.numeroadicao'
      '             and pi2.dadoimportacao = pi.dadoimportacao),2)'
      '      else'
      '        cast(null as numeric(15,2))'
      '      end as TotalAdicao,'
      ''
      '      case when pi.produto = (select produto'
      '                               from produtosimportados pi2'
      
        '                               where pi2.numeroadicao = pi.numer' +
        'oadicao'
      
        '                                 and pi2.dadoimportacao = pi.dad' +
        'oimportacao'
      
        '                               order by produto desc limit 1) th' +
        'en'
      ''
      '         round((select sum(pi2.valor*di.taxacambio)'
      '          from produtosimportados pi2'
      '               join dadosimportacoes di'
      '               on pi2.dadoimportacao = di.numero'
      '          where pi2.numeroadicao = pi.numeroadicao'
      '             and pi2.dadoimportacao = pi.dadoimportacao),2) ='
      ''
      '          (select a.mercadoria'
      '           from adicoes a'
      '           where a.dadoimportacao = pi.dadoimportacao'
      '             and a.numero = pi.numeroadicao)'
      '      else'
      '        true'
      '      end as AdicaoFechada,'
      ''
      ''
      '      (select count(*)'
      '       from  (select distinct pi2.aliquotaipi'
      '             from produtosimportados pi2'
      '             where pi2.numeroadicao = pi.numeroadicao'
      '               and pi2.dadoimportacao = pi.dadoimportacao'
      '             ) as aliquotas)>1 as AliquotaIPIDuplicadas'
      ''
      ''
      ''
      'from produtosimportados pi'
      '     join produtos p'
      '     on pi.produto = p.codigo'
      'where pi.dadoimportacao = :dadoimportacao'
      'order by  pi.numeroadicao, pi.produto'
      '')
    RequestLive = True
    Left = 32
    Top = 405
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'dadoimportacao'
        ParamType = ptUnknown
      end>
