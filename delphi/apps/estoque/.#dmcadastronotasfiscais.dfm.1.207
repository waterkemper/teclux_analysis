  object qryProcuraPedidosNFE: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryProcuraPedidosNFEBeforeOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select pp.pedido,'
      '       pp.numero, '
      '       p.filialentrega,'
      '       p.cancelado,'
      '       p.concluido,'
      '       p.fornecedor,'
      '       f.grupofornecedor,'
      
        '       pp.preco * (100 - coalesce(pp.desconto,0)) / 100 as preco' +
        'unitariopedido,'
      
        '      (coalesce(pp.quantidade,0) -  coalesce((SELECT sum(pnp.qua' +
        'ntidade)'
      
        '                                              FROM produtosnotas' +
        'pag pnp join notaspag np on pnp.codigonota = np.codigo'
      
        '                                              WHERE pnp.pedido =' +
        ' :pedido'
      
        '                                       '#9#9#9#9' AND pnp.produto = :p' +
        'roduto'
      
        '                                               AND np.situacao <' +
        '> '#39'C'#39
      
        '                                               and pnp.codigonot' +
        'a <> :codigonota),0)) as QuantidadePendentePedido'
      'from pedidos p'
      '     join fornecedores f'
      '      on p.fornecedor = f.codigo'
      ''
      '     join produtospedidos pp'
      '     on p.numero  = pp.pedido'
      ''
      'where p.numero = :pedido'
      '  and pp.produto = :produto'
      ''
      'order by p.numero  ')
    RequestLive = False
    Left = 448
    Top = 229
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'pedido'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'produto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codigonota'
        ParamType = ptUnknown
      end>
