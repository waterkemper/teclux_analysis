  object qryConsultaConhecimentoFrete: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select np.fornecedor,'
      '           f.nome as nomefornecedor,'
      
        '          cast(substring(f.pessoanumero from 1 for length(f.pess' +
        'oanumero)) as varchar) as cnpj,'
      '          np.serie,'
      '          np.numero,'
      '          np.valornota,'
      
        '          (select sum(cn.valor) from calculosnotaspag cn where (' +
        'np.codigo = cn.codigonota)) as valoricms'
      'From  notaspag np, fornecedores f'
      'where (mod(np.codigofiscal,1000) in (351,352,353,354,355,356))'
      '  and ('
      '       (0 < (Select count(d.numero)'
      '             From duplicatas d'
      '             Where d.datapagto is null'
      '              and d.valorpagto is null'
      '              and d.documentopag = np.documentopag))'
      '         or (not exists (select dp.numero'
      '                         from documentospag dp'
      '                         where dp.numero = np.documentopag))'
      '       )'
      '  and (f.codigo = np.fornecedor)'
      '  and (f.tipofornecimento[1] = '#39'T'#39')')
    RequestLive = False
    Left = 480
    Top = 165
    object qryConsultaConhecimentoFretefornecedor: TIntegerField
      DisplayLabel = 'C'#243'digo'
      FieldName = 'fornecedor'
      Visible = False
      DisplayFormat = '0'
    end
