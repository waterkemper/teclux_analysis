      DisplayLabel = 'CNPJ'
      FieldName = 'cnpj'
      EditMask = '00.000.000/0000.00;0; '
    end
    object qryConsultaConhecimentoFreteserie: TStringField
      DisplayLabel = 'S'#233'rie'
      FieldName = 'serie'
      Required = True
      Size = 3
    end
    object qryConsultaConhecimentoFretenumero: TIntegerField
      DisplayLabel = 'N'#250'mero'
      FieldName = 'numero'
      Required = True
      DisplayFormat = '0'
    end
    object qryConsultaConhecimentoFretevalornota: TFloatField
      DisplayLabel = 'Valor'
      FieldName = 'valornota'
      Required = True
      DisplayFormat = '0.00'
    end
