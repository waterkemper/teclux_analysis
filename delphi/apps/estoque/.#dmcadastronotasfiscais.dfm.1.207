        'from (dadosfiscais df join (notas n join filiais f on n.filial=f' +
        '.codigo) on df.numero = n.dadofiscal)'
      'where df.cliente = :cliente and'
      '          df.tipocliente = :tipocliente '
      'order by f.nome, n.filial'
      ') as temp'
      'order by upper(to_ascii(nome,'#39'latin1'#39'))')
