  object qryConsultaFornecedores: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select f.codigo,'
      '       coalesce(f.razao,f.nome) as nome,'
      '       f.pessoanumero,'
      '       cast(case when f.pessoatipo = '#39'F'#39' '
      
        '                      then substr(f.cnpj, 1, 3) || '#39'.'#39' || substr' +
        '(f.cnpj, 4, 3) || '#39'.'#39' || substr(f.cnpj, 7, 3)'
      '                      when f.pessoatipo = '#39'J'#39
      
        '                      then  substr(f.cnpj, 1, 2) || '#39'.'#39' || subst' +
        'r(f.cnpj, 3, 3) || '#39'.'#39' || substr(f.cnpj, 6, 3) || '#39'/'#39' || substr(' +
        'f.cnpj, 9, 4)   '
      '              end as varchar) as cnpj,'
      '       f.estado,'
      '       f.tipo as tipoorignal,'
      '       c.nome as nomecidade,'
      '       cast((case when f.tipo = '#39'C'#39' then '#39'C - Cliente'#39
      '                       when f.tipo = '#39'F'#39' then '#39'F - Fornecedor'#39
      '                       when f.tipo = '#39'L'#39' then '#39'L - Filial'#39
      '                end) as varchar) as tipo'
      'From vfornecedores f, cidades c'
      'where false /*    Preenchido em runtime */'
      '     and (f.estado = c.estado)'
      '     and (f.cidade = c.codigo)'
      'Order By UPPER(TO_ASCII(f.nome,'#39'LATIN1'#39'))')
    RequestLive = False
    Left = 784
    Top = 237
