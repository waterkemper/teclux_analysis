  object qryEstoque: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftString
        Name = 'ListadeProdutoseFiliais'
        ParamType = ptUnknown
        Value = 'false'
      end>
    Sql.Strings = (
      'select e.produto,'
      '         e.filial,'
      '         e.datacompra,'
      '         e.qtdecompra,'
      '         e.precosemicms,'
      '         e.precocomicms,  '
      '         e.financeiro,  '
      '         e.aliquotaipi,  '
      '         e.ultimaentrada,'
      '         e.emestoque,'
      '         e.reservado,'
      '         e.transito,'
      '         e.demonstracao,'
      '         e.conserto,'
      '         e.futuro,'
      '         e.danificada,'
      '         e.estoquefisico,'
      #9#9' '
      ''
      '/*        (case when inclusao then*/'
      ''
      
        '/* Primeiro -> Tenta pegar com a existencia do efc e codigonota,' +
        ' na inclus'#227'o n'#227'o existe, pegar'#225' pelo '#250'ltimo movto */'
      ''
      '        coalesce('
      ''
      ''
      #9#9#9#9'(select m.futuro'
      #9#9#9#9'from movimentos m'
      #9#9#9#9'where m.produto = e.produto'
      #9#9#9#9'  and m.filial = e.filial'
      #9#9#9#9'  and m.codigonota = :codigonota'
      #9#9#9#9'and m.tipomovimento = '#39'EFC'#39
      #9#9#9#9'order by numero limit 1),'
      ''
      '/* Segundo - > Pelo '#250'ltimo movimento */'
      ''
      ''
      ' '#9#9'      (select m.futuro'
      '              FROM movimentos m,'
      '                ('
      
        '                  select m2.produto,m2.filial,max(data) as data,' +
        'max(lancto) as lancto'
      '                  from movimentos m2'
      '                  where m2.produto=e.produto'
      '                  AND m2.filial=e.filial'
      
        '                  and data < (cast(:datalancamentonota as date)+' +
        '1)'
      ''
      '                  /*'
      '                  and case when inclusao then true'
      '                      else m2.codigonota = :codigonota'
      
        '                           and m2.numerocontrole = numerocontrol' +
        'e'
      '                      end'
      '                  */'
      ''
      '                  group by produto,filial,data'
      '                  order by data desc'
      '                  limit 1'
      '                ) as m1'
      '              WHERE m.produto=m1.produto'
      '              AND m.filial=m1.filial'
      '              AND m.data=m1.data'
      '              and m.lancto=m1.lancto))'
      ''
      '/*'
      #9#9' else'
      ''
      #9#9#9#9'(select m.futuro'
      #9#9#9#9'from movimentos m'
      #9#9#9#9'where m.produto = e.produto'
      #9#9#9#9'  and m.filial = e.filial'
      #9#9#9#9'  and m.codigonota = :codigonota'
      #9#9#9#9'and m.tipomovimento = '#39'EFC'#39
      #9#9#9#9'order by numero limit 1)'
      ''
      ''
      #9#9' end)'
      '*/'
      ''
      '     as futuro_na_data_inclusao'
      ''
      ''
      ''
      'from estoques e'
      'where'
      ''
      '%ListadeProdutoseFiliais'
      ''
      'for update')
    RequestLive = True
    Left = 368
    Top = 69
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codigonota'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datalancamentonota'
        ParamType = ptUnknown
      end>
    object qryEstoqueproduto: TLargeintField
      FieldName = 'produto'
    end
