      '      pn.valorpisdigitado            , '
      '      pn.valorcofinsdigitado         , '
      '      pn.origem                      , '
      '      pn.numerosequencianfe          , '
      '      pn.numerosequencianfeitens     , '
      '      pn.fatorsubstituicao_custo     , '
      '      pn.aliquotaicmsst_custo        ,'
      '      pn.percentualreducaobase_custo , '
      '      pn.valorreducaobase_custo      , '
      '      pn.predbcst_custo              , '
      '      pn.valorreducaobasest_custo    , '
      '      pn.cst_nf                      , '
