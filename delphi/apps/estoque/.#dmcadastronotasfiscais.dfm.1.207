  object qryContasEntradasFiliais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      '  select contasentradasfiliais.*,'
      '         pl.classificacao,'
      '         pl.descricao as descricaocontacontabil,'
      '         '#39'C'#39' as operacao'
      '  from'
      '  ('
      '  select ceff.filial,'
      ''
      
        '         (case when (coalesce(ceff.descricao,cefg.descricao)='#39'IS' +
        'S retido'#39') then'
      
        '            coalesce(coalesce(ceff.contacontabil, cefg.contacont' +
        'abil),'
      '                     (select f.credito'
      '                      from fornecedores f'
      '                      where f.codigo = :fornecedorparaiss))'
      '          else'
      '            coalesce(ceff.contacontabil, cefg.contacontabil)'
      '          end) as contacontabil,'
      ''
      '         coalesce(ceff.descricao,cefg.descricao) as descricao'
      ''
      '  from contasentradasfiliais cefg'
      '      left join contasentradasfiliais ceff'
      '      on cefg.descricao = ceff.descricao'
      '     and ceff.filial = :filial'
      '  where cefg.filial is null'
      
        '  ) as contasentradasfiliais left join planocontas pl on contase' +
        'ntradasfiliais.contacontabil = pl.codigo'
      '  where contasentradasfiliais.contacontabil is not null or'
      '       (contasentradasfiliais.descricao = '#39'ISS retido'#39')'
      
        'order by UPPER(TO_ASCII(contasentradasfiliais.descricao,'#39'LATIN1'#39 +
        ')), contasentradasfiliais.filial')
    RequestLive = False
    Left = 464
    Top = 21
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'fornecedorparaiss'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
