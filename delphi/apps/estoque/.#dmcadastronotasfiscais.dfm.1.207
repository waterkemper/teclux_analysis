  object qryPedidosdaNota: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select pnp.pedido,'
      
        '       sum((pnp.quantidade * pnp.precounitario) + pnp.valoripi) ' +
        'as TotalPedidoNaNota'
      'from notaspag np'
      '     join produtosnotaspag pnp'
      '     on np.codigo = pnp.codigonota'
      ''
      'where np.codigo = pnp.codigonota'
      '  and np.codigo = :codigonota'
      '  and np.situacao = '#39'N'#39
      '  and pnp.pedido is not null'
      'group by pnp.pedido'
      '')
    RequestLive = False
    Left = 216
    Top = 13
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codigonota'
        ParamType = ptUnknown
      end>
