  object qryProcuraNaturezasProdutoNFE: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryProcuraNaturezasProdutoNFEBeforeOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereInativo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CodigoNaturezaPadrao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      ' select distinct selecionado.* from'
      '('
      '('
      'select case when '#39'F'#39' = :local then codigofiscal + 1000'
      '            when '#39'E'#39' = :local then codigofiscal + 2000'
      '            else  codigofiscal'
      '       end as codigofiscal,'
      '       naturezas.descricao,naturezas.codigo,'
      '       tipomovimento, entrada,'
      
        '       (select m.operacao from tiposmovimentos m where naturezas' +
        '.tipomovimento = m.codigo) as operacao,'
      
        '       (select cf.descricao from codigosfiscais cf where cf.codi' +
        'go = codigofiscal) as descricaocfop,'
      '       gerarpagamento,'
      '       debitar,'
      '       pld.descricao as descricaodebitar,'
      '       pld.classificacao as classificacaodebitar,'
      '       creditar,'
      '       plc.descricao as descricaocreditar,'
      '       plc.classificacao as classificacaocreditar,'
      '       historico,'
      '       icmscst,'
      '       csosn,'
      '       ipicst,'
      '       piscst,'
      '       cofinscst,'
      '       diferenciada,'
      '       naogerarcreditoicms,'
      '       naogerarcreditoipi,'
      '       naocalcularipisobrefrete ,'
      '       icmssobreipi,'
      '       icmssobredespesasacessorias'
      ''
      
        'from naturezas left join planocontas pld on naturezas.debitar = ' +
        'pld.codigo'
      
        '                       left join planocontas plc on naturezas.cr' +
        'editar = plc.codigo'
      'where  (naturezas.tipo = '#39'E'#39')'
      
        '   and   (((codigofiscal           = :codigofiscal) and ('#39'L'#39' = :' +
        'local)) or'
      
        '       ((codigofiscal+1000 = :codigofiscal) and ('#39'F'#39' = :local)) ' +
        'or'
      '       ((codigofiscal+2000 = :codigofiscal) and ('#39'E'#39' = :local)))'
      ''
      '%WhereInativo'
      '%CodigoNaturezaPadrao'
      ''
      ')'
      'union all'
      '('
      'select :codigofiscal  as codigofiscal,'
      '       naturezas.descricao,naturezas.codigo,'
      '       tipomovimento, entrada,'
      
        '       (select m.operacao from tiposmovimentos m where tipomovim' +
        'ento = m.codigo) as operacao,'
      
        '       (select cf.descricao from codigosfiscais cf where cf.codi' +
        'go = codigofiscal) as descricaocfop,'
      '       gerarpagamento,'
      '       debitar,'
      '       pld.descricao as descricaodebitar,'
      '       pld.classificacao as classificacaodebitar,'
      '       creditar,'
      '       plc.descricao as descricaocreditar,'
      '       plc.classificacao as classificacaocreditar,'
      '       historico,'
      '       icmscst,'
      '       csosn,'
      '       ipicst,'
      '       piscst,'
      '       cofinscst,'
      '       diferenciada,'
      '       naogerarcreditoicms,'
      '       naogerarcreditoipi,'
      '       naocalcularipisobrefrete,'
      '       icmssobreipi,'
      '       icmssobredespesasacessorias'
      ''
      
        'from naturezas left join planocontas pld on naturezas.debitar = ' +
        'pld.codigo'
      
        '                       left join planocontas plc on naturezas.cr' +
        'editar = plc.codigo'
      'where (naturezas.tipo = '#39'E'#39')'
      '  and  (:codigofiscal = 1353 or :codigofiscal = 2353)'
      '  and ((codigofiscal          = :codigofiscal) or'
      '       (codigofiscal+1000 = :codigofiscal))'
      ''
      '%WhereInativo'
      '%CodigoNaturezaPadrao'
      ''
      ')'
      ') as selecionado'
      'where selecionado.operacao is not null')
    RequestLive = False
    Left = 1200
    Top = 381
    ParamData = <
      item
        DataType = ftString
        Name = 'local'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'codigofiscal'
        ParamType = ptUnknown
      end>
