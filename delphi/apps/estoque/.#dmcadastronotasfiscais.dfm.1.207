      FieldName = 'descricao'
      Size = 25
    end
    object qryVenctosImpostosRetidosEntradasquinzenal: TBooleanField
      FieldName = 'quinzenal'
    end
    object qryVenctosImpostosRetidosEntradasparametro_inicial: TStringField
      FieldName = 'parametro_inicial'
      Size = 25
    end
    object qryVenctosImpostosRetidosEntradasdia: TIntegerField
