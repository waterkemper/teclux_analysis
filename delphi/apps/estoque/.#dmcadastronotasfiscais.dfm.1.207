  object qryConhecimentoFrete: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryConhecimentoFreteAfterOpen
    OnCalcFields = qryConhecimentoFreteCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select np.fornecedor,'
      '       (select f.nome'
      '        from fornecedores f'
      '        where f.codigo = np.fornecedor'
      '       ) as nomefornecedor,'
      
        '       (select cast(substring(f.pessoanumero from 1 for length(f' +
        '.pessoanumero)-2) as varchar)'
      '        from fornecedores f'
      '        where f.codigo = np.fornecedor'
      '       ) as cnpj,'
      '       np.serie,'
      '       np.numero,'
      '       np.valornota,'
      '       (select sum(cn.valor)'
      '        from calculosnotaspag cn'
      '        where (np.codigo = cn.codigonota)'
      '       ) as valoricms,'
      ''
      '       (select aliquota'
      '        from calculosnotaspag cn'
      '        where np.codigo = cn.codigonota limit 1'
      '       ) as aliquota,'
      ''
      '       (select sum(np2.valorconhecimentofrete)'
      '        from notaspag np2'
      '        where np2.fornecedorconhecimentofrete = :fornecedor'
      '          and np2.serieconhecimentofrete = :serie'
      '          and np2.numeroconhecimentofrete = :numero'
      
        '          and np2.codigo <> :codigo) as valorconhecimentofreteus' +
        'adonanota,'
      '       (select sum(np2.icmsconhecimentofrete)'
      '        from notaspag np2'
      '        where np2.fornecedorconhecimentofrete = :fornecedor'
      '          and np2.serieconhecimentofrete = :serie'
      '          and np2.numeroconhecimentofrete = :numero'
      
        '          and np2.codigo <> :codigo) as icmsconhecimentofreteusa' +
        'donanota'
      'from notaspag np, fornecedores f'
      'where (np.fornecedor = :fornecedor)'
      '  and (np.serie = :serie)'
      '  and (np.numero = :numero)'
      '  and (mod(np.codigofiscal,1000) in (351,352,353,354,355,356))'
      '  and (f.codigo = np.fornecedor)'
      '  and (f.tipofornecimento[1] = '#39'T'#39')')
    RequestLive = False
    Left = 32
    Top = 149
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'fornecedor'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'serie'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'numero'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end>
    object qryConhecimentoFretefornecedor: TIntegerField
      FieldName = 'fornecedor'
      DisplayFormat = '0'
    end
    object qryConhecimentoFretenomefornecedor: TStringField
      FieldName = 'nomefornecedor'
      Size = 50
    end
