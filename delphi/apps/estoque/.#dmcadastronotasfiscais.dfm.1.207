  object qryProdutosNotasPagNFE: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeDelete = qryProdutosNotasPagNFEBeforeDelete
    AfterScroll = qryProdutosNotasPagNFEAfterScroll
    OnFilterRecord = qryProdutosNotasPagNFEFilterRecord
    OnNewRecord = qryProdutosNotasPagNFENewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select pnpnfe.*,'
      ''
      '       pnpnfe.qtdeestoque -'
      '       coalesce((select sum(pnpnfeitems.quantidade)'
      '        from produtosnotaspagnfeitems pnpnfeitems'
      '        where pnpnfeitems.codigonota = pnpnfe.codigonota'
      '          and pnpnfeitems.numerosequencianfe = pnpnfe.numero'
      
        '          and pnpnfeitems.produto is not null),0) as SaldoQuanti' +
        'dade,'
      ''
      
        '       /* O USO DOS CAMPOS ABAIXO SE D'#193' PARA O LAN'#199'AMENTO E LINH' +
        'AS E COLUNAS */'
      ''
      '       cast(null as numeric(11,3)) as  QuantidadeselecionadaLC,'
      
        '       cast(null as numeric(11,3)) as  QuantidadeselecionadaLC_C' +
        'opia,'
      '       cast(null as numeric(11,3)) as  SaldoQuantidadeLC,'
      ''
      
        '      (Select cf.descricao from codigosfiscais cf where cf.codig' +
        'o = pnpnfe.CFOP) as DescricaoCFOP'
      ''
      'from produtosnotaspagnfe pnpnfe'
      'where pnpnfe.codigonota = :codigonota'
      'order by pnpnfe.numero')
    RequestLive = True
    Left = 1080
    Top = 501
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codigonota'
        ParamType = ptUnknown
      end>
