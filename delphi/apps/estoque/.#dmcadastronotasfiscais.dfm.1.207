  object qryProdutosFornecedores: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'CondicaoPorChavePrimaria'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CondicaoPorprodutonofornecedor'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CondicaoPorNumerodeNota'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select pf.*, p.codigovisual as produtovisual, '
      
        '             case when pf.serienota is not null and pf.numeronot' +
        'a is not null then'
      '               false'
      '             else'
      #9'              (select EXISTS'
      '                  (select pnp.produto'
      '                   from produtosnotaspag pnp'
      
        '                        join produtosnotaspagnfeitems pnpnfeitem' +
        's'
      '                             join produtosnotaspagnfe pnpnfe'
      
        '                             on pnpnfeitems.codigonota = pnpnfe.' +
        'codigonota'
      
        '                             and pnpnfeitems.numerosequencianfe ' +
        '= pnpnfe.numero'
      
        '                        on pnp.codigonota = pnpnfeitems.codigono' +
        'ta'
      
        '                        and pnp.numerosequencianfe = pnpnfeitems' +
        '.numerosequencianfe'
      
        '                        and pnp.numerosequencianfeitens = pnpnfe' +
        'items.numero'
      '                        join notaspag np'
      '                        on pnp.codigonota = np.codigo'
      '                   where np.fornecedor = pf.fornecedor'
      '                     and np.tipofornecedor = pf.tipofornecedor'
      '                     and pnp.produto = pf.produto'
      
        '                     and pnpnfe.produtonofornecedor = pf.produto' +
        'nofornecedor'
      
        '                     and pnpnfe.descricaofornecedor = pf.descric' +
        'aonofornecedor'
      ''
      
        #9#9#9#9#9' and not (np.serie = :SerieNota and np.Numero = :NumeroNota' +
        ')'
      #9#9#9#9#9' limit 1) as temp)'
      '           end'
      '           as ExisteOutrasVinculacoes,'
      ''
      '           (select count(*)'
      '            from produtosnotaspag pnp'
      '                 join produtosnotaspagnfeitems pnpnfeitems'
      '                             join produtosnotaspagnfe pnpnfe'
      
        '                             on pnpnfeitems.codigonota = pnpnfe.' +
        'codigonota'
      
        '                             and pnpnfeitems.numerosequencianfe ' +
        '= pnpnfe.numero'
      
        '                        on pnp.codigonota = pnpnfeitems.codigono' +
        'ta'
      
        '                        and pnp.numerosequencianfe = pnpnfeitems' +
        '.numerosequencianfe'
      
        '                        and pnp.numerosequencianfeitens = pnpnfe' +
        'items.numero'
      '                        join notaspag np'
      '                        on pnp.codigonota = np.codigo'
      '                   where np.fornecedor = pf.fornecedor'
      '                     and np.tipofornecedor = pf.tipofornecedor'
      '                     and pnp.produto = pf.produto'
      
        '                     and pnpnfe.produtonofornecedor = pf.produto' +
        'nofornecedor'
      
        '                     and pnpnfe.descricaofornecedor = pf.descric' +
        'aonofornecedor'
      #9#9'     and (np.serie = :SerieNota and np.Numero = :NumeroNota)'
      #9'   ) as NumerodeVinculacoesNaNota,'
      ''
      '           (select count(*)'
      '            from produtosnotaspag pnp'
      '                 join produtosnotaspagnfeitems pnpnfeitems'
      '                             join produtosnotaspagnfe pnpnfe'
      
        '                             on pnpnfeitems.codigonota = pnpnfe.' +
        'codigonota'
      
        '                             and pnpnfeitems.numerosequencianfe ' +
        '= pnpnfe.numero'
      
        '                        on pnp.codigonota = pnpnfeitems.codigono' +
        'ta'
      
        '                        and pnp.numerosequencianfe = pnpnfeitems' +
        '.numerosequencianfe'
      
        '                        and pnp.numerosequencianfeitens = pnpnfe' +
        'items.numero'
      '                        join notaspag np'
      '                        on pnp.codigonota = np.codigo'
      '                   where np.fornecedor = pf.fornecedor'
      '                     and np.tipofornecedor = pf.tipofornecedor'
      '                     and pnp.produto = pf.produto'
      
        '                     and pnpnfe.produtonofornecedor = pf.produto' +
        'nofornecedor'
      
        '                     and pnpnfe.descricaofornecedor = pf.descric' +
        'aonofornecedor'
      ''
      #9'   ) as NumerodeOcorrencias,'
      ''
      '           false as flag'
      ''
      'from produtosfornecedores pf'
      '     join produtos p'
      '          join caracteristicas c'
      '          on p.caracteristica = c.codigo'
      '     on pf.produto = p.codigo'
      'where true'
      '%CondicaoPorChavePrimaria'
      ''
      '/*'
      '  and pf.produtonofornecedor = _produtonofornecedor'
      '  and pf.descricaonofornecedor = _descricaonofornecedor'
      '  and pf.infadprod = _infadprod'
      '  and pf.produto = _produto'
      '  and pf.fornecedor = _fornecedor'
      '  and pf.tipofornecedor = _tipofornecedor'
      '*/'
      ''
      ''
      '%CondicaoPorProdutonoFornecedor'
      ''
      '/*'
      '  and pf.produtonofornecedor = _produtonofornecedor'
      '  and pf.descricaonofornecedor = _descricaonofornecedor'
      '  and pf.infadprod = _infadprod'
      '  and pf.fornecedor = _fornecedor'
      
        '  and pf.tipofornecedor = _tipofornecedor  and pf.data is not nu' +
        'll'
      
        '  and ((pf.serienota is null or pf.serienota = :SerieNota) and (' +
        'pf.numeronota is null or pf.NumeroNota = :NumeroNota))'
      '*/'
      ''
      ''
      ''
      '%CondicaoPorNumerodeNota'
      ''
      '/*'
      '  and pf.fornecedor = _fornecedor'
      '  and pf.tipofornecedor = _tipofornecedor'
      
        '  and (pf.produtonofornecedor, pf.descricaonofornecedor, pf.prod' +
        'uto) in ()'
      ''
      '*/'
      ''
      ''
      'order by pf.data desc')
    RequestLive = True
    Left = 1192
    Top = 445
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'SerieNota'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NumeroNota'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'produtonofornecedor'
        ParamType = ptUnknown
      end
