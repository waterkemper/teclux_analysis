  object qryProdutosNotasPagNFEItems: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkFields = 'numero = numerosequencianfe'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrProdutosNotasPagNFE
    Constraints = <>
    AfterInsert = qryProdutosNotasPagNFEItemsAfterInsert
    BeforeEdit = qryProdutosNotasPagNFEItemsBeforeEdit
    AfterEdit = qryProdutosNotasPagNFEItemsAfterEdit
    AfterPost = qryProdutosNotasPagNFEItemsAfterPost
    AfterCancel = qryProdutosNotasPagNFEItemsAfterCancel
    BeforeDelete = qryProdutosNotasPagNFEItemsBeforeDelete
    AfterDelete = qryProdutosNotasPagNFEItemsAfterDelete
    AfterScroll = qryProdutosNotasPagNFEItemsAfterScroll
    OnCalcFields = qryProdutosNotasPagNFEItemsCalcFields
    OnNewRecord = qryProdutosNotasPagNFEItemsNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select pnpnfeitems.*,'
      '       p.codigovisual as produtovisual,'
      '       p.descricao as descricaoproduto,'
      
        '       (select ipi.classificacaofiscal from ipi where ipi.codigo' +
        ' = c.ipi) as ncmempresa,'
      '       n.descricao as descricaonatureza,'
      '       cf.descricao as descricaocodigofiscal,'
      '       n.tipomovimento,'
      ''
      '       p.valorgrade1 as valorgrade1,'
      '       p.valorgrade2 as valorgrade2,'
      '       p.caracteristica as caracteristica,'
      '       c.codigovisual as caracteristicavisual,'
      ''
      ''
      
        '       (select m.operacao from tiposmovimentos m where m.codigo ' +
        '= n.tipomovimento) as operacao,'
      ''
      
        '       (select (pp.preco * (100 - coalesce(pp.desconto,0)) / 100' +
        ')'
      '        from produtospedidos pp'
      
        '        where pp.pedido = pnpnfeitems.pedido and pp.produto = pn' +
        'pnfeitems.produto and pp.numero = pnpnfeitems.numeroprodutonoped' +
        'ido) as PrecoUnitarioPedido,'
      ''
      '       (select true'
      '        from produtospedidos pp'
      
        '        where pp.pedido = pnpnfeitems.pedido and pp.produto = pn' +
        'pnfeitems.produto and pp.numero = pnpnfeitems.numeroprodutonoped' +
        'ido) as pedidoOK'
      ''
      'from produtosnotaspagnfeitems pnpnfeitems'
      '     left join (produtos p'
      '           join caracteristicas c'
      '           on p.caracteristica = c.codigo)'
      '     on pnpnfeitems.produto = p.codigo'
      ''
      '     left join naturezas n'
      '     on pnpnfeitems.natureza = n.codigo'
      ''
      '     left join codigosfiscais cf'
      '     on pnpnfeitems.codigofiscal = cf.codigo'
      ''
      'where pnpnfeitems.codigonota = :codigonota'
      'order by pnpnfeitems.numerosequencianfe, pnpnfeitems.numero')
    RequestLive = True
    Left = 1064
    Top = 565
    ParamData = <
      item
        DataType = ftString
        Name = 'codigonota'
        ParamType = ptUnknown
        Value = '0'
      end>
