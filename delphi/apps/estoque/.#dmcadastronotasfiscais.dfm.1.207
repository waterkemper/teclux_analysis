      '('
      ''
      'select distinct '
      '       :codigonota as codigonota,'
      '       CAST(:caracteristica AS bigint) as caracteristica,'
      '       eg.grade,'
      '       eg.valor'
      '       '
      'from produtosnotaspag pnp'
      '     join produtos p on pnp.produto = p.codigo'
      '     join elementosgrades eg'
      '     on eg.grade = :grade'
      
        '     and ((p.valorgrade1 = eg.valor and :eHlinha) or (p.valorgra' +
        'de2 = eg.valor and not :eHLinha))'
      ''
      'where eg.grade = :grade'
      '  and pnp.codigonota = :codigonota'
      '  and p.caracteristica = :caracteristica'
      '  and eg.usual'
      '  and eg.valor is not null'
      
        '  and (eg.grade,eg.valor) not in (select cenp_l.grade, cenp_l.va' +
        'lor'
      
        '                                  from caracteristicaselementosn' +
        'otaspag cenp_l'
      
        '                                  where cenp_l.codigonota = :cod' +
        'igonota'
      
        '                                    and cenp_l.caracteristica = ' +
        ':caracteristica'
      
        '                                    and cenp_l.grade = :grade)  ' +
        '                     '
      'order by eg.valor             '
      ')'
      '')
    RequestLive = False
    Left = 176
    Top = 720
    ParamData = <
      item
        DataType = ftString
        Name = 'codigonota'
        ParamType = ptUnknown
        Value = '0'
