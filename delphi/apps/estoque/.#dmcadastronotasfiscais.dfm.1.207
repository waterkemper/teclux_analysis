      DisplayLabel = 'Cidade'
      FieldName = 'nomecidade'
      Size = 30
    end
    object qryConsultaFornecedoresestado: TStringField
      DisplayLabel = 'UF'
      FieldName = 'estado'
      Required = True
      Size = 2
    end
    object qryConsultaFornecedorescodigo: TIntegerField
