  object qryPedidosCopia: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryPedidosCopiaAfterOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select p.numero,'
      '       p.emissao,'
      '       p.fornecedor,'
      
        '       (Select f.nome from fornecedores f where f.codigo=p.forne' +
        'cedor)as nomefornecedor,'
      '       formatar_cpf_cnpj((select f.pessoanumero'
      '                           from fornecedores f'
      
        '                           where f.codigo = p.fornecedor)) as pe' +
        'ssoanumero,'
      '       p.concluido,'
      '       p.cancelado,'
      '       p.situacao,'
      '       p.estado,'
      '       cast(case    when p.situacao = ''A'' then ''ABERTO'''
      '                    when p.situacao = ''C'' then ''CANCELADO'''
      '                    when p.situacao = ''L'' then ''CONCLUIDO'''
      '                    when p.situacao = ''P'' then ''PARCIAL'''
      
        '                    else                       ''PARCIAL LIQUIDAD' +
        'O'''
      '       end as varchar) as descricaosituacao'
      'From   pedidos p'
      'Where p.numero =:numero')
    RequestLive = True
    Left = 136
    Top = 56
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'numero'
        ParamType = ptUnknown
      end>
