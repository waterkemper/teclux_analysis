  object qryProdutosFornecedores: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select pf.produtonofornecedor'
      'from produtosfornecedores pf'
      'where pf.produto = :produto'
      '  and pf.fornecedor = :fornecedor'
      '  and pf.tipofornecedor = :tipofornecedor'
      '  and pf.numeronota is null'
      '  and pf.serienota is null'
      'order by pf.data desc, pf.produto desc limit 1')
    RequestLive = False
    Left = 144
    Top = 320
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'produto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'fornecedor'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'tipofornecedor'
        ParamType = ptUnknown
      end>
