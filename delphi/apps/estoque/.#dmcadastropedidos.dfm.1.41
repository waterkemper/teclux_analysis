  object qryCopiaProdutosPedidos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnDeleteError = PostError
    OnEditError = PostError
    OnPostError = PostError
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select pp.pedido, '
      '           p.caracteristica,'
      '           pp.produto, '
      '           pp.numero,'
      '           pp.quantidade,'
      '           pp.preco, '
      '           pp.desconto, '
      '           pp.valoripi,'
      '           pp.valoricms,'
      '           (select i.valor'
      '            from estadosicms i'
      '            where (i.estado = :estado) and'
      '                  (i.icms = (select c.icms'
      '                             from caracteristicas c'
      '                             where c.codigo = p.caracteristica'
      '           )      )         ) as aliquotaicmscalculopreco,   '
      '           p.descricao,'
      
        '           (select gr.descricao from grades gr, caracteristicas ' +
        'c where gr.codigo = c.grade1 and c.codigo = p.caracteristica) as' +
        ' linha,'
      
        '           (select gr.descricao from grades gr, caracteristicas ' +
        'c where gr.codigo = c.grade2 and c.codigo = p.caracteristica) as' +
        ' coluna,'
      '           p.valorgrade1,'
      '           p.valorgrade2,'
      
        '           (select c.grade1 from caracteristicas c where c.codig' +
        'o = p.caracteristica) as grade1,'
      
        '           (select c.grade2 from caracteristicas c where c.codig' +
        'o = p.caracteristica) as grade2,'
      '           (select c.aliquotapis '
      '            from caracteristicas c '
      '            where p.caracteristica = c.codigo) as aliquotapis,'
      '           (select c.aliquotacofins '
      '            from caracteristicas c '
      
        '            where p.caracteristica = c.codigo) as aliquotacofins' +
        ','
      '           (select c.markup '
      '            from caracteristicas c '
      '            where p.caracteristica = c.codigo) as markupproduto,'
      
        '           (select c.descricao from caracteristicas c where c.co' +
        'digo = p.caracteristica) as descricaocaracteristica,'
      '           (select g.markup '
      '            from grupos g '
      '            where g.codigo = (select c.grupo '
      
        '                                          from caracteristicas c' +
        ' '
      
        '                                          where c.codigo = p.car' +
        'acteristica)) as markupgrupo,'
      '           p.preco as codigopreco,'
      
        '           produtospedidos_recebido(pp.pedido, pp.produto) as to' +
        'talrecebido,'
      '           cast(0 as numeric(11,2)) as valorproduto,'
      '           cast(0 as numeric(11,2)) as precosugerido,'
      '           (select g.calcularpreco'
      '            from grupos g'
      '            where g.codigo = (select c.grupo'
      '                                          from caracteristicas c'
      
        '                                          where c.codigo = p.car' +
        'acteristica)) as calcularpreco'
      'From   produtospedidos pp, produtos p'
      'Where pp.pedido = :numero and'
      '            pp.produto = p.codigo'
      
        'order by pp.numero, UPPER(TO_ASCII(p.descricao,''LATIN1'')), p.val' +
        'orgrade1, p.valorgrade2')
    RequestLive = True
    Left = 153
    Top = 257
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'estado'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'numero'
        ParamType = ptUnknown
      end>
