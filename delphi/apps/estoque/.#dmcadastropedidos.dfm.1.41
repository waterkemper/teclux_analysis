    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT DISTINCT(n.Codigo),'
      '                n.Fornecedor,'
      '                n.TipoFornecedor,'
      ''
      '               (SELECT vf.nome FROM vfornecedores vf'
      '                   WHERE vf.tipo = n.TipoFornecedor AND'
      '                         vf.codigo = n.Fornecedor'
      '                   LIMIT 1'
      '               ) AS NomeFornecedor,'
      ''
      '                n.Serie,'
      '                n.Numero,'
      '                n.Data,'
      '                CAST(CASE WHEN n.Situacao = ''N'' THEN ''NOTA'''
      '                          WHEN n.Situacao = ''P'' THEN ''PARCIAL'''
      '                          WHEN n.situacao = ''C'' THEN ''CANCELADA'''
      '                     END AS VARCHAR) AS DescricaoSituacao'
      ''
      'FROM notaspag n, produtosnotaspag pn'
      ''
      'WHERE n.Codigo  = pn.CodigoNota AND'
      '      pn.pedido = :pedido')
    RequestLive = False
    Left = 611
    Top = 357
    ParamData = <
      item
        DataType = ftString
        Name = 'pedido'
        ParamType = ptUnknown
        Value = '0'
      end>
