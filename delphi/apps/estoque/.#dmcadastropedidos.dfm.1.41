  object qryLinhaColunaGrade: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select distinct eg1.valor as linha, eg2.valor as coluna'
      'from '
      
        '       (elementosgrades eg1 join grades g1 on eg1.grade = g1.cod' +
        'igo), '
      
        '       (elementosgrades eg2 join grades g2 on eg2.grade = g2.cod' +
        'igo) '
      'where '
      '        g1.codigo=:LinhaGrade '
      '        and g2.codigo=:ColunaGrade '
      
        '/*          and eg1.valor||eg2.valor not in (LISTALINHACOLUNA) *' +
        '/'
      '/*  tipo de linha */'
      'order by eg1.valor')
