      'Select f.nome, '
      '           f.codigo, '
      '           f.estado,'
      '           formatar_cpf_cnpj(f.pessoanumero) as pessoanumero,'
      '           c.nome as nomecidade'
      'From fornecedores f, cidades c'
      'Where (f.tipofornecimento[1] = ''T'') and'
      '            (c.estado = f.estado)       and'
      '            (c.codigo = f.cidade)'
      'Order By UPPER(TO_ASCII(f.nome,''LATIN1''))')
