    Sql.Strings = (
      'SELECT DISTINCT(n.Codigo),'
      '                n.Fornecedor,'
      '                n.TipoFornecedor,'
      ''
      '               (SELECT vf.nome FROM vfornecedores vf'
      '                   WHERE vf.tipo = n.TipoFornecedor AND'
      '                         vf.codigo = n.Fornecedor'
      '                   LIMIT 1'
      '               ) AS NomeFornecedor,'
      ''
      '                n.Serie,'
      '                n.Numero,'
      '                n.Data,'
      '                CAST(CASE WHEN n.Situacao = '#39'N'#39' THEN '#39'NOTA'#39
      '                          WHEN n.Situacao = '#39'P'#39' THEN '#39'PARCIAL'#39
      '                          WHEN n.situacao = '#39'C'#39' THEN '#39'CANCELADA'#39
      '                     END AS VARCHAR) AS DescricaoSituacao'
      ''
      'FROM notaspag n, produtosnotaspag pn'
      ''
      'WHERE n.Codigo  = pn.CodigoNota AND'
      '      pn.pedido = :pedido')
