  object qryProdutosPedidos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryProdutosPedidosAfterOpen
    BeforeInsert = qryProdutosPedidosBeforeInsert
    BeforeEdit = qryProdutosPedidosBeforeEdit
    AfterPost = qryProdutosPedidosAfterPost
    BeforeDelete = qryProdutosPedidosBeforeDelete
    AfterScroll = qryProdutosPedidosAfterScroll
    OnCalcFields = qryProdutosPedidosCalcFields
    OnDeleteError = PostError
    OnEditError = PostError
    OnPostError = PostError
    OnNewRecord = qryProdutosPedidosNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select     pp.pedido, '
      '           p.caracteristica,'
      '           pp.produto,'
      '           p.codigovisual as produtovisual,  '
      '           pp.numero,'
      '           pp.quantidade,'
      '           pp.preco,'
      '           pp.desconto, '
      '           pp.valoripi,'
      '           pp.valoricms,'
      '           (select i.valor'
      '            from estadosicms i'
      '            where (i.estado = cast(:estado as varchar)) and'
      '                  (i.icms = (select c.icms'
      '                             from caracteristicas c'
      '                             where c.codigo = p.caracteristica'
      '           )      )         ) as aliquotaicmscalculopreco,'
      ''
      '           cast(case when (select c.complemento'
      '                           from caracteristicas c'
      
        '                           where c.codigo = p.caracteristica) is' +
        ' not null then'
      
        '                p.descricao || coalesce('#39' '#39'||p.valorgrade1,'#39#39') |' +
        '| coalesce('#39' '#39'||p.valorgrade2||'#39' '#39','#39#39') || (select c.complemento'
      '                              from caracteristicas c'
      '                              where c.codigo = p.caracteristica)'
      
        '                else p.descricao || coalesce('#39' '#39'||p.valorgrade1,' +
        #39#39') || coalesce('#39' '#39'||p.valorgrade2,'#39#39') end as varchar(434)) as d' +
        'escricaoproduto,'
      ''
      '           p.descricao,'
      '           c.emitecomplemento,'
      '           case when c.emitecomplemento then'
      '             c.complemento'
      '           else cast(null as varchar(360)) end as complemento,'
      ''
      
        '           (select gr.descricao from grades gr, caracteristicas ' +
        'c where gr.codigo = c.grade1 and c.codigo = p.caracteristica) as' +
        ' linha,'
      
        '           (select gr.descricao from grades gr, caracteristicas ' +
        'c where gr.codigo = c.grade2 and c.codigo = p.caracteristica) as' +
        ' coluna,'
      '           p.valorgrade1,'
      '           p.valorgrade2,'
      
        '           (select c.grade1 from caracteristicas c where c.codig' +
        'o = p.caracteristica) as grade1,'
      
        '           (select c.grade2 from caracteristicas c where c.codig' +
        'o = p.caracteristica) as grade2,'
      '           (select c.aliquotapis'
      '            from caracteristicas c '
      '            where p.caracteristica = c.codigo) as aliquotapis,'
      '           (select c.aliquotacofins '
      '            from caracteristicas c '
      
        '            where p.caracteristica = c.codigo) as aliquotacofins' +
        ','
      '           (select c.markup '
      '            from caracteristicas c '
      '            where p.caracteristica = c.codigo) as markupproduto,'
      
        '           (select c.descricao from caracteristicas c where c.co' +
        'digo = p.caracteristica) as descricaocaracteristica,'
      '           (select g.markup '
      '            from grupos g '
      '            where g.codigo = (select c.grupo '
      
        '                                          from caracteristicas c' +
        ' '
      
        '                                          where c.codigo = p.car' +
        'acteristica)) as markupgrupo,'
      '           p.preco as codigopreco,'
      '           pr.descricao as descricaoprecoproduto,'
      
        '           produtospedidos_recebido(pp.pedido, pp.produto) as to' +
        'talrecebido,'
      '           cast(0 as numeric(11,2)) as valorproduto,'
      '           cast(0 as numeric(11,2)) as precosugerido,'
      '           (select g.calcularpreco'
      '            from grupos g'
      '            where g.codigo = (select c.grupo'
      '                              from caracteristicas c'
      
        '                              where c.codigo = p.caracteristica)' +
        ') as calcularpreco,'
      
        '           (select c.unidade from caracteristicas c where c.codi' +
        'go = p.caracteristica) as unidade,'
      '           p.referencia,'
      '           pp.ImportadoDaico'
      ''
      
        'From   produtospedidos pp, produtos p, caracteristicas c, precos' +
        ' pr'
      ''
      'Where pp.pedido = :numero and'
      '      pp.produto = p.codigo and'
      '      c.codigo = p.caracteristica and'
      '      pr.caracteristica  = p.caracteristica and'
      '      p.preco  = pr.codigo'
      ''
      
        'order by pp.numero, UPPER(TO_ASCII(p.descricao,'#39'LATIN1'#39')), p.val' +
        'orgrade1, p.valorgrade2')
    RequestLive = True
    Left = 72
    Top = 240
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'estado'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'numero'
        ParamType = ptUnknown
      end>
