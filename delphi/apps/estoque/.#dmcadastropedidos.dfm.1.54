      item
        DataType = ftUnknown
        Name = 'SQLInativos'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select p.codigo,'
      '       p.codigovisual,'
      '       p.descricao,'
      '       p.caracteristica,'
      '       p.referencia,'
      '       p.valorgrade1,'
      '       p.valorgrade2,'
      ''
      '       coalesce(i.aliquota,0) as ipi,'
      ''
      
        '       selecionar_aliquotaicms(:UFOrigem, :UFDestino, :TipoPesso' +
        'a, p.codigo) as icms,'
      ''
      '       p.preco,'
      '       pr.descricao as descricaopreco'
      ''
      'From ((produtos p'
      '       join (caracteristicas c'
      '             left join ipi i'
      '             on c.ipi = i.codigo)'
      '       on p.caracteristica = c.codigo)'
      ''
      '      join precos pr'
      '      on  pr.codigo = p.preco and'
      '          pr.caracteristica = p.caracteristica)'
      ''
      'where true'
      ''
      '%SQLProdutos'
      '%SQLfornecedorgrupo'
      '%SQLItensjacadastrados'
      '%SQLInativos'
      ''
      
        'Order By UPPER(TO_ASCII(p.descricao,'#39'LATIN1'#39')), p.valorgrade1, p' +
        '.valorgrade2')
    RequestLive = False
    Left = 419
    Top = 298
