  object qryPrevisoesPedidos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterDelete = qryPrevisoesPedidosAfterDelete
    OnDeleteError = PostError
    OnEditError = PostError
    OnPostError = PostError
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select '
      '       pp.pedido,'
      '       pp.numero,'
      '       pp.dias,'
      '       pp.percentual,'
      ''
      '       somatorio.parcial * pp.percentual / 100 as parcial,'
      ''
      '       pedidos_total(pp.pedido) as total,'
      ''
      '       (Select pe."database" + int4(pp.dias)'
      '        From  pedidos pe'
      '        Where pe.numero = pp.pedido) as data,'
      ''
      ''
      '       case  when pp.numero = (Select min(numero)'
      '                               From previsoespedidos p'
      '                               Where p.pedido = pp.pedido) then'
      
        '                     (pedidos_total(pp.pedido) * pp.percentual) ' +
        '/ 100'
      '            +  pedidos_total(pp.pedido) - somatorio.parcial'
      
        '                else (pedidos_total(pp.pedido) * pp.percentual) ' +
        '/ 100'
      '       end as valor'
      ''
      'From previsoespedidos pp ,'
      '         (Select pedidos_total(:numero) as parcial'
      '          ) somatorio'
      ''
      'Where pp.pedido = :numero'
      'Order by pp.numero')
    RequestLive = True
    Left = 66
    Top = 124
    ParamData = <
      item
        DataType = ftInteger
        Name = 'numero'
        ParamType = ptUnknown
      end>
    object qryPrevisoesPedidospedido: TIntegerField
      FieldName = 'pedido'
      DisplayFormat = '0'
    end
    object qryPrevisoesPedidosnumero: TIntegerField
      FieldName = 'numero'
      DisplayFormat = '0'
    end
    object qryPrevisoesPedidosdias: TIntegerField
      FieldName = 'dias'
      Required = True
      DisplayFormat = '0'
    end
    object qryPrevisoesPedidospercentual: TFloatField
      FieldName = 'percentual'
      Required = True
      DisplayFormat = '0.00'
    end
    object qryPrevisoesPedidosdata: TDateField
      Alignment = taCenter
      FieldName = 'data'
      EditMask = '99/99/9999;1; '
    end
    object qryPrevisoesPedidostotal: TFloatField
      FieldName = 'total'
      DisplayFormat = '###,###,##0.00'
    end
    object qryPrevisoesPedidosparcial: TFloatField
      FieldName = 'parcial'
      DisplayFormat = '###,###,##0.00'
    end
    object qryPrevisoesPedidosvalor: TFloatField
      FieldName = 'valor'
      DisplayFormat = '###,###,##0.00'
    end
