  object qryConsultaPedidos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select  f.nome,'
      '           p.numero,'
      '           p.emissao,'
      '           cast(case when situacao = '#39'A'#39' then '#39'A - ABERTO'#39
      '                     when situacao = '#39'C'#39' then '#39'C - CANCELADO'#39
      '                     when situacao = '#39'L'#39' then '#39'L - CONCLUIDO'#39
      '                     when situacao = '#39'P'#39' then '#39'P - PARCIAL'#39
      
        '                     else                     '#39'Q - PARCIAL LIQUI' +
        'DADO'#39
      '                end as varchar) as situacao,'
      '           pedidos_total(p.numero) as valorpedido'
      'from    pedidos p, fornecedores f'
      'where (p.fornecedor = f.codigo)'
      '/*                              */'
      'order by UPPER(TO_ASCII(f.nome,'#39'LATIN1'#39'))')
    RequestLive = False
    Left = 419
    Top = 179
    object qryConsultaPedidosnome: TStringField
      DisplayLabel = 'Nome'
      FieldName = 'nome'
      Size = 40
    end
    object qryConsultaPedidosemissao: TDateField
      Alignment = taCenter
      DisplayLabel = 'Emiss'#227'o'
      FieldName = 'emissao'
      EditMask = '99/99/9999;1; '
    end
    object qryConsultaPedidossituacao: TStringField
      DisplayLabel = 'Situa'#231#227'o'
      FieldName = 'situacao'
      Size = 21
    end
    object qryConsultaPedidosvalorpedido: TFloatField
      DisplayLabel = 'Valor pedido'
      FieldName = 'valorpedido'
      DisplayFormat = '0.00'
    end
    object qryConsultaPedidosnumero: TIntegerField
      DisplayLabel = 'N'#250'mero'
      FieldName = 'numero'
      DisplayFormat = '0'
    end
  end
  object qryConsultaFornecedorTransportes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
