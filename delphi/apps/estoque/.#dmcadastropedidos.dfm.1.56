  object qryProcuraProdutos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterClose = qryProcuraProdutosAfterClose
    OnCalcFields = qryProcuraProdutosCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'SelecaoPorReferencia'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SQLfornecedorgrupo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SQLItensjacadastrados'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SQLInativos'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select p.codigo, p.codigovisual,'
      '           p.descricao, '
      '           p.caracteristica,'
      '           (select c.codigovisual'
      '            from caracteristicas c'
      
        '            where p.caracteristica = c.codigo) as caracteristica' +
        'visual,'
      '           c.descricao as descricaocaracteristica,'
      
        '           (select gr.descricao from grades gr where gr.codigo =' +
        ' c.grade1) as linha,'
      
        '           (select gr.descricao from grades gr where gr.codigo =' +
        ' c.grade2) as coluna,'
      '           p.valorgrade1,'
      '           p.valorgrade2,'
      '           p.preco,'
      '           pr.descricao as descricaopreco,'
      
        '           (select e.precocomicms from estoques e where (p.codig' +
        'o = e.produto) and (e.filial = :filialbase)'
      '           ) as precosugestao,'
      '           coalesce(i.aliquota,0) as ipi,'
      ''
      
        '           selecionar_aliquotaicms(:UFOrigem, :UFDestino, :TipoP' +
        'essoa, p.codigo) as icms,'
      ''
      '           (Select coalesce(e.valor,0) From  estadosicms e'
      
        '                                                      Where (e.i' +
        'cms = c.icms) and'
      
        '                                                                ' +
        '  (e.estado =:UFDestino)) as aliquotaicmscalculopreco,'
      '           (select c.aliquotapis '
      '            from caracteristicas c '
      '            where p.caracteristica = c.codigo) as aliquotapis,'
      '           (select c.aliquotacofins '
      '            from caracteristicas c '
      
        '            where p.caracteristica = c.codigo) as aliquotacofins' +
        ','
      '           (select c.markup '
      '            from caracteristicas c'
      '            where p.caracteristica = c.codigo) as markupproduto,'
      '           (select g.markup'
      '            from grupos g'
      '            where g.codigo = (select c.grupo'
      '                                          from caracteristicas c'
      
        '                                          where c.codigo = p.car' +
        'acteristica)) as markupgrupo,'
      '           (select g.calcularpreco'
      '            from grupos g'
      '            where g.codigo = (select c.grupo'
      '                                          from caracteristicas c'
      
        '                                          where c.codigo = p.car' +
        'acteristica)) as calcularpreco'
      ''
      'From ((produtos p'
      '       join (caracteristicas c'
      '             left join ipi i'
      '             on c.ipi = i.codigo)'
      '       on p.caracteristica = c.codigo)'
      ''
      '      join precos pr'
      '      on  pr.codigo = p.preco and'
      '          pr.caracteristica = p.caracteristica)'
      ''
      ''
      'Where ((p.codigo =:codigo) or'
      
        '       (upper(to_ascii(p.codigovisual,'#39'latin1'#39')) = upper(to_asci' +
        'i(:codigovisual,'#39'latin1'#39')))'
      ''
      '       %SelecaoPorReferencia'
      ''
      '      )'
      ''
      '     %SQLfornecedorgrupo'
      '     %SQLItensjacadastrados'
      '     %SQLInativos')
    RequestLive = False
    Left = 523
    Top = 326
    ParamData = <
      item
        DataType = ftInteger
        Name = 'filialbase'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'UFOrigem'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'UFDestino'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'TipoPessoa'
        ParamType = ptUnknown
      end
      item
        DataType = ftLargeint
        Name = 'codigo'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'codigovisual'
        ParamType = ptUnknown
      end>
    object qryProcuraProdutosdescricao: TStringField
      DisplayWidth = 100
      FieldName = 'descricao'
      Size = 100
    end
