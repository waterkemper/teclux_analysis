      '      pp.pfcpst,'
      '      pp.vfcpst,'
      '      pp.vbcfcp,'
      '      pp.vBCFCPSTRet,'
      '      pp.pFCPSTRet,'
      '      pp.vFCPSTRet,'
      '      pp.vBCFCPUFDest,'
      '      pp.pst,'
      ''
      '      false as msgfatorsubstituicao_custo,'
      ''
      ''
      '      cast(0 as numeric(11,2)) as precosugerido,'
      ''
      '     (select c.markup'
      '      from caracteristicas c'
      '      where p.caracteristica = c.codigo) as markupproduto,'
      ''
      '     (select g.markup'
      '      from grupos g'
      '      where g.codigo = (select c.grupo'
      '                                    from caracteristicas c'
      
        '                                    where c.codigo = p.caracteri' +
        'stica)) as markupgrupo,'
      ''
      '     p.preco as codigopreco,'
      ''
      '     pp.ImportadoDaico,'
      ''
      
        '     (pp.numero = (select max(pp2.numero) from produtospedidos p' +
        'p2 where pp2.pedido = pp.pedido)) as isLastNumber,'
      '     c.emitecomplemento,'
      '     '
      '     false as selecionar,'
      ''
      
        '     produtospedidos_recebido(pp.pedido, pp.produto) as TotalRec' +
        'ebido_'
      ''
      
        'from produtospedidos pp, pedidos pe, produtos p, caracteristicas' +
        ' c, grupos g, classes cl'
      'where (pp.pedido = pe.numero)'
      '  and (p.codigo = pp.produto)'
      '  and (p.caracteristica = c.codigo)'
      '  and (c.grupo = g.codigo)'
      '  and (c.classe = cl.codigo)'
      '  and (pp.pedido = :numero)'
      ''
      
        'order by pp.numero, UPPER(TO_ASCII(p.descricao,'#39'LATIN1'#39')), p.val' +
        'orgrade1, p.valorgrade2'
      '')
