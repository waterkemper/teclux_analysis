      Alignment = taCenter
      DisplayLabel = 'Emiss'#227'o'
      FieldName = 'emissao'
      EditMask = '99/99/9999;1; '
    end
    object qryConsultaPedidossituacao: TStringField
      DisplayLabel = 'Situa'#231#227'o'
      FieldName = 'situacao'
      Size = 21
    end
    object qryConsultaPedidosvalorpedido: TFloatField
      DisplayLabel = 'Valor pedido'
      FieldName = 'valorpedido'
      DisplayFormat = '0.00'
    end
    object qryConsultaPedidosnumero: TIntegerField
      DisplayLabel = 'N'#250'mero'
      FieldName = 'numero'
      DisplayFormat = '0'
    end
  end
  object qryConsultaFornecedorTransportes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
