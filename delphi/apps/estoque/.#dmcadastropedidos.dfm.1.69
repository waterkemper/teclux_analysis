  object qryPrevisoesPedidos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterDelete = qryPrevisoesPedidosAfterDelete
    OnDeleteError = PostError
    OnEditError = PostError
    OnPostError = PostError
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select '
      '       pp.pedido,'
      '       pp.numero,'
      '       pp.dias,'
      '       pp.percentual,'
      ''
      '/*       somatorio.parcial * pp.percentual / 100 as parcial,*/'
      ''
      '       p.valornotacalculada as total,'
      ''
      '       p."database" + int4(pp.dias) as data,'
      ''
      '       /*(Select pe."database" + int4(pp.dias)'
      '        From  pedidos pe'
      '        Where pe.numero = pp.pedido) as data,*/'
      ''
      '       case when pp.numero = (Select min(pp2.numero)'
      '                               From previsoespedidos pp2'
      
        '                               Where pp2.pedido = pp.pedido) the' +
        'n'
      ''
      '                     p.valornotacalculada -'
      
        '                     round(coalesce((select sum((p.valornotacalc' +
        'ulada * pp2.percentual) / 100)'
      '                      from previsoespedidos pp2'
      '                      where pp2.pedido = pp.pedido'
      '                        and pp2.numero > pp.numero),0), 2)'
      ''
      
        '                else round((p.valornotacalculada * pp.percentual' +
        ') / 100, 2)'
      '       end as valor'
      ''
      ''
      '/*     (p.valornotacalculada * pp.percentual) / 100 as valor */'
      ''
      ''
      'From previsoespedidos pp join pedidos p on p.numero = pp.pedido'
      '/*         (Select pedidos_total(:numero) as parcial'
      '          ) somatorio'
      '          */'
      ''
      'Where pp.pedido = :numero'
      'Order by pp.numero')
    RequestLive = True
    Left = 66
    Top = 124
    ParamData = <
      item
        DataType = ftInteger
        Name = 'numero'
        ParamType = ptUnknown
      end>
    object qryPrevisoesPedidospedido: TIntegerField
      FieldName = 'pedido'
      DisplayFormat = '0'
    end
