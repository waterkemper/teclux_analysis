  object qryProdutosPedidos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeInsert = qryProdutosPedidosBeforeInsert
    BeforeEdit = qryProdutosPedidosBeforeEdit
    AfterPost = qryProdutosPedidosAfterPost
    BeforeDelete = qryProdutosPedidosBeforeDelete
    AfterScroll = qryProdutosPedidosAfterScroll
    OnCalcFields = qryProdutosPedidosCalcFields
    OnDeleteError = PostError
    OnEditError = PostError
    OnPostError = PostError
    OnNewRecord = qryProdutosPedidosNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT p.codigovisual as produtovisual,'
      '       c.icms,'
      '       c.ipi,'
      '       0.00 as aliquotaipioriginal,'
      '       c.grade1,'
      '       c.grade2,'
      
        '       (select gr.descricao from grades gr where gr.codigo = c.g' +
        'rade1) as linha,'
      
        '       (select gr.descricao from grades gr where gr.codigo = c.g' +
        'rade2) as coluna,'
      '       p.valorgrade1,'
      '       p.valorgrade2,'
      '       p.caracteristica,'
      '       p.referencia,'
      '       c.codigovisual as caracteristicavisual,'
      '       c.descricao as descricaocaracteristica,'
      
        '       (select pr.descricao from precos pr where pr.caracteristi' +
        'ca = p.caracteristica and pr.codigo = p.preco ) as descricaoprec' +
        'oproduto,'
      '       (pp.preco * pp.quantidade) as produtototal,'
      '       g.calcularpreco,'
      
        '      (select m1.valor from estadosicms m1 where m1.icms = c.icm' +
        's and m1.estado =:EstadoFilialBaseCalculoPreco) as aliquotaicmsc' +
        'alculopreco,'
      '       false as PermitirAtualizar,'
      
        '       case when pe.situacao = '#39'N'#39' then false else cast(null as ' +
        'Boolean) end as permitiratualizardigitado,'
      '       p.codigorecolha,'
      ''
      '       c.composto,'
      '       0.00 as precovenda,'
      '       0.00 as CustoTotal,'
      '       0.00 as CustoTotalFatorizado,'
      '       0.00 as CustoParaVenda,'
      '       0.00 as PrecoAtual,'
      '       0.00 as PrecoAtribuido,'
      '       0.00 as PrecoDigitado,'
      '       false as PrecoDigitadoAlterado,'
      '       c.grupo,'
      '       c.classe,'
      
        '       case when g.naoreplicar then true else cl.naoreplicar end' +
        ' as naoreplicar,'
      ''
      '       (select n.tipomovimento'
      '        from naturezas n'
      '        where n.codigo = pp.natureza'
      '       ) as tipomovimento,'
      ''
      '       (select n.gerarpagamento'
      '        from naturezas n'
      '        where n.codigo = pp.natureza'
      '       ) as gerarpagamento,'
      ''
      '       (select tm.operacao'
      '        from tiposmovimentos tm, naturezas n'
      '        where tm.codigo = n.tipomovimento'
      '          and n.codigo = pp.natureza'
      '       ) as operacao,'
      '       '#39#39' as localizacao,'
      '       true as produtook,'
      ''
      
        '       (select u.descricao from unidades u where u.codigo = pp.u' +
        'nidade) as descricaounidade,'
      ''
      '       case when pe.situacao = '#39'P'#39' then'
      
        '         (select ti.valor from tributosicms ti where ti.codigo =' +
        ' c.incidencia)'
      '       else'
      '         pp.cst_produto'
      '       end as cst_produto_1,'
      ''
      '       case when pe.situacao = '#39'P'#39' then'
      '         c.csosn'
      '       else'
      '         pp.csosn_produto'
      '       end as csosn_produto_1,'
      ''
      '       case when pe.situacao = '#39'P'#39' then'
      '         c.markup'
      '       else'
      '         coalesce(pp.markup_produto,c.markup)'
      '       end as markup_produto_1,'
      ''
      '       case when pe.situacao = '#39'P'#39' then'
      '         g.markup'
      '       else'
      '         coalesce(pp.markup_grupo,g.markup)'
      '       end as markup_grupo_1,'
      ''
      '       case when pe.situacao = '#39'P'#39' then'
      
        '         (select vf.markup from vfornecedores vf where vf.codigo' +
        ' = pe.fornecedor and vf.tipo = '#39'F'#39')'
      '       else'
      
        '         coalesce(pp.markup_fornecedor,(select vf.markup from vf' +
        'ornecedores vf where vf.codigo = pe.fornecedor and vf.tipo = '#39'F'#39 +
        '))'
      '       end as markup_fornecedor,'
      ''
      ''
      '       c.percreducaobase as percentualreducaobase_produto,'
      ''
      '      pp.pedido                  ,'
      '      pp.numero                      ,'
      ''
      '      case when pe.situacao = '#39'N'#39' then'
      '        pp.numero'
      '      else'
      '        cast(null as integer)'
      '      end as numerooriginal,'
      ''
      '      pp.produto                     ,'
      '      pp.produto as produtoincluidooriginal,'
      '      pp.aliquotaicms                ,'
      '      pp.baseicms                    , '
      '      pp.valoricms                   ,'
      '      pp.aliquotaipi                 , '
      '      pp.valoripi                    , '
      '      pp.desconto                    , '
      '      pp.valorreducaobase            , '
      '      pp.percentualreducaobase       , '
      '      pp.preco               , '
      '      pp.quantidade                  , '
      '      pp.incidencia                  , '
      '      pp.pedido                      , '
      '      pp.acrescimo                   ,'
      '      pp.frete                       ,'
      '      pp.seguro                      ,'
      '      pp.valordescontoitem           ,'
      '      pp.natureza                    ,'
      '      pp.codigofiscal                ,'
      '      pp.descricaoproduto            ,'
      '      pp.genero                      ,'
      '      pp.classificacaofiscal         ,'
      '      pp.unidade                     ,'
      '      pp.extipi                      ,'
      '      pp.icmsbasecalculo             ,'
      '      pp.icmsmodalidade              ,'
      '      pp.icmsmodsubst                ,'
      '      pp.tribcodigoean               ,'
      '      pp.tribunidade                 ,'
      '      pp.tribquantidade              ,'
      '      pp.tribunitario                ,'
      '      pp.enquadramento               ,'
      '      pp.ipicst                      ,'
      '      pp.ipibasecalculo              , '
      '      pp.iibasecalculo               , '
      '      pp.iidespaduaneira             , '
      '      pp.iivalor                     , '
      '      pp.iiiof                       , '
      '      pp.piscst                      , '
      '      pp.pisbasecalculo              , '
      '      pp.pisaliquota                 ,'
      '      pp.pisvalor                    , '
      '      pp.cofinscst                   ,'
      '      pp.cofinsbasecalculo           , '
      '      pp.cofinsaliquota              , '
      '      pp.cofinsvalor                 , '
      '      pp.icmsvalor                   , '
      '      pp.despesasacessorias          ,'
      '      pp.aliquotaicmsst              ,'
      '      pp.icmsbasecalculost           ,'
      '      pp.icmsvalorst                 ,'
      '      pp.embalagem                   ,'
      '      pp.thc                         ,'
      '      pp.naotribipi                  ,'
      '      pp.naotribicms                 ,'
      '      pp.csosn                       ,'
      '      pp.pcredsn                     ,'
      '      pp.vcredicmssn                 ,'
      '      pp.fatorsubstituicao           ,'
      '      pp.predbcst                    ,'
      '      pp.reducaobasest               ,'
      '      pp.vbcstret                    ,'
      '      pp.vicmsstret                  ,'
      '      pp.icmsisentas                 ,'
      '      pp.icmsoutras                  ,'
      '      pp.ipioutras                   ,'
      '      pp.ipiisentas                  ,'
      '      pp.icmsbasecalculostcusto      ,'
      '      pp.icmsvalorstcusto            ,'
      '      pp.valoripidigitado            ,'
      '      pp.valoricmsdigitado           ,'
      '      pp.naogerarcreditoicms         ,'
      '      pp.naogerarcreditoipi          ,'
      '      pp.naocalcularipisobrefrete    ,'
      '      pp.icmsbasecalculo_custo       ,'
      '      pp.aliquotaicms_custo          ,'
      '      pp.icmsvalor_custo             ,'
      '      pp.icmsoutrasdigitado          ,'
      '      pp.icmssobreipi                ,'
      '      pp.valorpisdigitado            ,'
      '      pp.valorcofinsdigitado         ,'
      '      pp.origem                      ,'
      '      pp.fatorsubstituicao_custo     ,'
      '      pp.aliquotaicmsst_custo        ,'
      '      pp.percentualreducaobase_custo ,'
      '      pp.valorreducaobase_custo      ,'
      '      pp.predbcst_custo              ,'
      '      pp.valorreducaobasest_custo    ,'
      '      pp.cst_nf                      ,'
      '      pp.csosn_nf                    ,'
      '      pp.ipicst_nf                   ,'
      '      pp.pmvast                      ,'
      '      pp.valoricmsstdigitado         ,'
      '      pp.descontodigitado            ,'
      '      pp.fretedigitado               ,'
      '      pp.unidadenf                   ,'
      '      pp.fatorconversao              ,'
      '      pp.qtdeestoque                 ,'
      '      pp.icmssobredespesasacessorias ,'
      '      pp.vbcstretdesp                ,'
      '      pp.vicmsstretdesp              ,'
      '      pp.produtodigitado             ,'
      '      pp.percreducaomva              ,'
      ''
      '      pp.markup_produto,'
      '      pp.markup_grupo,'
      '      pp.csosn_produto,'
      '      pp.cst_produto,'
      ''
      '      pp.pfcp,'
      '      pp.vfcp,'
      '      pp.vbcfcpst,'
      '      pp.pfcpst,'
      '      pp.vfcpst,'
      '      pp.vbcfcp,'
      '      pp.vBCFCPSTRet,'
      '      pp.pFCPSTRet,'
      '      pp.vFCPSTRet,'
      '      pp.vBCFCPUFDest,'
      '      pp.pst,'
      ''
      '      pp.atualizarprecovenda,'
      ''
      '      false as msgfatorsubstituicao_custo,'
      ''
      ''
      '      cast(0 as numeric(11,2)) as precosugerido,'
      ''
      '     (select c.markup'
      '      from caracteristicas c'
      '      where p.caracteristica = c.codigo) as markupproduto,'
      ''
      '     (select g.markup'
      '      from grupos g'
      '      where g.codigo = (select c.grupo'
      '                                    from caracteristicas c'
      
        '                                    where c.codigo = p.caracteri' +
        'stica)) as markupgrupo,'
      ''
      '     p.preco as codigopreco,'
      ''
      '     pp.ImportadoDaico,'
      ''
      
        '     (pp.numero = (select max(pp2.numero) from produtospedidos p' +
        'p2 where pp2.pedido = pp.pedido)) as isLastNumber,'
      '     c.emitecomplemento,'
      '     c.complemento,'
      ''
      
        '     produtospedidos_recebido(pp.pedido, pp.produto) as TotalRec' +
        'ebido'
      ''
      
        'from produtospedidos pp, pedidos pe, produtos p, caracteristicas' +
        ' c, grupos g, classes cl'
      'where (pp.pedido = pe.numero)'
      '  and (p.codigo = pp.produto)'
      '  and (p.caracteristica = c.codigo)'
      '  and (c.grupo = g.codigo)'
      '  and (c.classe = cl.codigo)'
      '  and (pp.pedido = :pedido)'
      ''
      'order by pp.numero')
    RequestLive = True
