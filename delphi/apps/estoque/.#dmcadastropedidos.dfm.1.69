    Sql.Strings = (
      'select  produtos.codigo,'
      '          produtos.caracteristica,'
      '          produtos.descricao,'
      '          produtos.preco,'
      '          produtos.referencia,'
      '          CodigoBarras(produtos.Codigo) as codigobarras,'
      '          produtos.foralinha,'
      '          produtos.inativo,'
      '          produtos.codigorecolha,'
      '          produtos.valorgrade1,'
      '          produtos.valorgrade2'
      'from produtos'
      'where produtos.caracteristica = :caracteristica'
      
        'order by produtos.valorgrade1,produtos.valorgrade2,produtos.codi' +
        'go')
    RequestLive = False
