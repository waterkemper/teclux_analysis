  object qryPedidos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryPedidosAfterOpen
    BeforeInsert = qryPedidosBeforeInsert
    BeforeEdit = qryPedidosBeforeEdit
    AfterScroll = qryPedidosAfterScroll
    OnDeleteError = PostError
    OnEditError = PostError
    OnPostError = PostError
    OnNewRecord = qryPedidosNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftString
        Name = 'CondicaoListaNumeroPedidos'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select p.numero,'
      '           p.emissao,'
      '           p.fornecedor,'
      '           p.filialfatura,'
      '           p.filialentrega,'
      '           p.filialcobranca,'
      
        '           (SELECT f.nome FROM filiais f WHERE f.codigo = p.fili' +
        'alfatura) AS nomefilialfatura,'
      
        '           (SELECT f.nome FROM filiais f WHERE f.codigo = p.fili' +
        'alentrega) AS nomefilialentrega,'
      
        '           (SELECT f.nome FROM filiais f WHERE f.codigo = p.fili' +
        'alcobranca) AS nomefilialcobranca,'
      '           p.referencia,'
      '           p.database,'
      '           p.fornecedortransporte,'
      '           p.motivo,'
      '           p.fretenota,'
      '           p.fretectr,'
      '           p.desconto1,'
      '           p.desconto2,'
      '           p.desconto3,'
      '           p.desconto4,'
      '           p.acrescimo1,'
      '           p.acrescimo2,'
      '           p.acrescimo3,'
      '           p.acrescimo4,'
      '           p.estado,'
      '           p.entrega,'
      '           p.observacoes,'
      '           p.concluido,'
      '           p.cancelado,'
      '           p.situacao,'
      '           cast(case    when p.situacao = '#39'A'#39' then '#39'ABERTO'#39
      '                        when p.situacao = '#39'C'#39' then '#39'CANCELADO'#39
      '                        when p.situacao = '#39'L'#39' then '#39'CONCLU'#205'DO'#39
      '                        when p.situacao = '#39'P'#39' then '#39'PARCIAL'#39
      
        '                        else                       '#39'PARCIAL LIQU' +
        'IDADO'#39
      '           end as varchar(20)) as descricaosituacao,'
      '           cast(case    when p.situacao = '#39'A'#39' then '#39'ABERTA'#39
      '                        when p.situacao = '#39'C'#39' then '#39'CANCELADA'#39
      '                        when p.situacao = '#39'L'#39' then '#39'CONCLU'#205'DA'#39
      '                        when p.situacao = '#39'P'#39' then '#39'PARCIAL'#39
      
        '                        else                       '#39'PARCIAL LIQU' +
        'IDADA'#39
      '           end as varchar(20)) as descricaosituacao_,'
      '           m.descricao as descricaomotivo,'
      '           p.valorprodutos,'
      '           p.contato,'
      '           p.observacoes_estoque,'
      ''
      ''
      
        '          (select sum(round(pp.quantidade * pp.preco,2) - coales' +
        'ce(pp.valordescontoitem,0))'
      '           from produtospedidos pp'
      
        '           where pp.pedido = p.numero) - coalesce(p.desconto,0) ' +
        '+ coalesce(p.acrescimo,0) as totalproduto,'
      ''
      ''
      '           p.baseicmscalculada,'
      '           p.baseicmssubstituicaocalculada,'
      '           p.vbcstretdesp,'
      '           p.valoricmscalculada,'
      '           p.valoricmssubstituicaocalculada,'
      '           p.vicmsstretdesp,'
      '           p.valoripicalculada,'
      '           p.valornotacalculada,'
      ''
      '           p.desconto,'
      '           p.descontoitem,'
      '           p.acrescimo,'
      '           p.seguro,'
      '           p.despesasacessorias,'
      '           p.baseicmssubstituicao,'
      '           p.valoricmssubstituicao,'
      '           p.totalvalorpis,'
      '           p.totalvalorcofins,'
      '           p.crt,'
      '           p.regimetributario,'
      '           P.freteinterno'
      '           '
      'From   pedidos p left join motivos m on (m.codigo = p.motivo)'
      'Where  p.numero = :numero'
      '       %CondicaoListaNumeroPedidos'
      '')
    RequestLive = True
    Left = 66
    Top = 26
    ParamData = <
      item
        DataType = ftInteger
        Name = 'numero'
        ParamType = ptUnknown
      end>
