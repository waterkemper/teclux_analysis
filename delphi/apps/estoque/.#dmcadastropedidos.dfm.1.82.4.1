  object qryProdutosPedidosCopia: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterInsert = qryProdutosPedidosCopiaAfterInsert
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT p.codigovisual as produtovisual,'
      '       c.icms,'
      '       c.ipi,'
      '       0.00 as aliquotaipioriginal,'
      '       c.grade1,'
      '       c.grade2,'
      
        '       (select gr.descricao from grades gr where gr.codigo = c.g' +
        'rade1) as linha,'
      
        '       (select gr.descricao from grades gr where gr.codigo = c.g' +
        'rade2) as coluna,'
      '       p.valorgrade1,'
      '       p.valorgrade2,'
      '       p.caracteristica,'
      '       p.referencia,'
      '       c.codigovisual as caracteristicavisual,'
      '       c.descricao as descricaocaracteristica,'
      
        '       (select pr.descricao from precos pr where pr.caracteristi' +
        'ca = p.caracteristica and pr.codigo = p.preco ) as descricaoprec' +
        'oproduto,'
      '       (pp.preco * pp.quantidade) as produtototal,'
      '       g.calcularpreco,'
      
        '      (select m1.valor from estadosicms m1 where m1.icms = c.icm' +
        's and m1.estado =:EstadoFilialBaseCalculoPreco) as aliquotaicmsc' +
        'alculopreco,'
      '       false as PermitirAtualizar,'
      
        '       case when pe.situacao = '#39'N'#39' then false else cast(null as ' +
        'Boolean) end as permitiratualizardigitado,'
      '       p.codigorecolha,'
      ''
      '       c.composto,'
      '       0.00 as precovenda,'
      '       0.00 as CustoTotal,'
      '       0.00 as CustoTotalFatorizado,'
      '       0.00 as CustoParaVenda,'
