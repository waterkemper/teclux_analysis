    Sql.Strings = (
      'Select f.codigo, '
      '           f.nome, '
      '           f.estado,'
      '           f.foneddd,'
      '           f.fonenumero,'
      '           f.faxddd,'
      '           f.faxnumero,'
      '           f.inscricaoestadual,'
      '           f.contato,'
      '           f.rua,'
      '           f.numero,'
      '           f.complemento,'
      
        '           cast(substr(cast(f.cep as varchar),1,2) || '#39'.'#39' || sub' +
        'str(cast(f.cep as varchar),3,3) || '#39'-'#39' || substr(cast(f.cep as v' +
        'archar),6,3) as varchar) as cep,'
      
        '           cast(substr(f.pessoanumero,1,2) || '#39'.'#39' || substr(f.pe' +
        'ssoanumero,3,3) || '#39'.'#39' || substr(f.pessoanumero,6,3) || '#39'/'#39' ||'
      
        '                   substr(f.pessoanumero,9,4) || '#39'-'#39' || substr(f' +
        '.pessoanumero,13,2) as varchar) as pessoanumero,'
      '           f.bairro,'
      '           f.cidade,'
      '           coalesce(grupofornecedor,0) as grupo,'
      '           c.nome as nomecidade,'
      '           b.nome as nomebairro,'
      '           f.markup,'
      
        '           formatar_fone_fax(f.foneddd, f.fonenumero,'#39#39') as fone' +
        '_,'
      '           f.crt'
      
        'From   fornecedores f left join cidades c on ((c.estado = f.esta' +
        'do) and '
      
        '                                                                ' +
        '      (c.codigo = f.cidade))'
      
        '                                   left join bairros b on ((b.es' +
        'tado = f.estado) and '
      
        '                                                                ' +
        '     (b.cidade = f.cidade) and '
      
        '                                                                ' +
        '     (b.codigo = f.bairro))'
      'Where f.codigo =:codigo')
    RequestLive = False
    Left = 235
    Top = 18
