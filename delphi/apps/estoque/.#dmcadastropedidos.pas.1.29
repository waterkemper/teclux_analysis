     case tipoGrade of
      tpLINHA :result := qryProdutosPedidos.Locate('valorgrade1;valorgrade2', VarArrayOf([qrygrade.fields[0].asstring,Coluna]),[]);
      tpCOLUNA:result := qryProdutosPedidos.Locate('valorgrade1;valorgrade2', VarArrayOf([Coluna,qrygrade.fields[0].asstring]),[]);
     end;
    end
    else
    if (Coluna <> '') then
     result := qryProdutosPedidos.Locate('valorgrade2', Coluna,[])
    else
    if (qrygrade.fields[0].asstring <> '') then
     result := qryProdutosPedidos.Locate('valorgrade1', qrygrade.fields[0].asstring,[]);
  end;
  qrygrade.Close;
  qryCopiaProdutosPedidos.Close;
end;

function TdtmCadastroPedidos.IncluirProdutoPedidocopia(Coluna: string): boolean;
var
 codigoproduto : String;
 index : integer;
begin
 result := true;
 if PosicionarLinhaColunanoProdutoPedidoCopia(coluna) then
 begin
  codigoproduto := qryCopiaProdutosPedidosproduto.asvariant;
  ReFazConsulta(qryProcuraProdutos,[3],[codigoproduto]);
 end
 else
 begin
  case tipoGrade of
   tpLINHA : Index := LInhasColunas[ValorLinhaColuna].indexof(qrygrade.Fields[0].AsString+Coluna);
   tpCOLUNA: Index := LInhasColunas[ValorLinhaColuna].indexof(Coluna+qrygrade.Fields[0].AsString);
  end;
  if Index<>-1 then
  begin
   codigoproduto := LinhasColunas[codigo].Strings[Index];
   FCancelarInclusaoProduto := False;
   qryCopiaProdutosPedidos.Append;
   ReFazConsulta(qryProcuraProdutos,[3],[codigoproduto]);
   qryCopiaProdutosPedidospedido.Asinteger         := qryPedidosnumero.Asinteger;
   qryCopiaProdutosPedidosproduto.Asinteger        := qryprocuraProdutoscodigo.Asinteger;
   qryCopiaProdutosPedidoscaracteristica.Asinteger := qryprocuraProdutoscaracteristica.Asinteger;
   qryCopiaProdutosPedidospreco.AsCurrency         := qrygrade.FieldByName('preco').AsCurrency;
   qryCopiaProdutosPedidosquantidade.AsCurrency     := qryGrade.Fields[colunas.IndexOf(coluna)+1].AsCurrency;
   qryCopiaProdutosPedidosdesconto.AsCurrency      := qrygrade.FieldByName('desconto').AsCurrency;
   qryCopiaProdutosPedidosvaloricms.AsCurrency     := qrygrade.FieldByName('valoricms').AsCurrency;
   qryCopiaProdutosPedidosvaloripi.AsCurrency      := qrygrade.FieldByName('valoripi').AsCurrency;
   qryCopiaProdutosPedidosdescricao.AsString       := qryProcuraProdutosdescricao.AsString;
   qryCopiaProdutosPedidosdescricaocaracteristica.AsString := qryProcuraProdutosdescricaocaracteristica.AsString;
   qryCopiaProdutosPedidosvalorgrade1.AsString     := qryProcuraProdutosvalorgrade1.AsString;
   qryCopiaProdutosPedidosvalorgrade2.AsString     := qryProcuraProdutosvalorgrade2.AsString;
   qryCopiaProdutosPedidoslinha.AsString           := qryProcuraProdutoslinha.AsString;
   qryCopiaProdutosPedidoscoluna.AsString          := qryProcuraProdutoscoluna.AsString;
   FCancelarInclusaoProduto := True;
  end
  else
   result := false;
 end;
end;

procedure TdtmCadastroPedidos.CopiarProdutosPedidos;
var
 i:integer;
 RegistroAtual: TBookMark;
 caracteristica : String;
begin
  RegistroAtual := qryProdutosPedidos.GetBookmark;
  qryProdutosPedidos.DisableControls;
  ReFazConsulta(qryCopiaProdutosPedidos,[0,1],[Null,Null]);
  caracteristica := qryProdutosPedidoscaracteristica.AsString;
  qryProdutosPedidos.First;
  try
    while not qryProdutosPedidos.Eof do
    begin
     if qryProdutosPedidoscaracteristica.AsString = caracteristica then
     begin
       qryCopiaProdutosPedidos.Append;
       for i:=0 to qryProdutosPedidos.FieldCount -2 do
         qryCopiaProdutosPedidos.Fields[i].AsString := qryprodutospedidos.Fields[i].AsString;
       qryCopiaProdutosPedidos.DisableControls;
       qryCopiaProdutosPedidos.post;
       qryCopiaProdutosPedidos.EnableControls;
     end;
     qryProdutosPedidos.Next;
    end;
  finally
    qryProdutosPedidos.GotoBookmark(RegistroAtual);
    qryProdutosPedidos.FreeBookmark(RegistroAtual);
    qryProdutosPedidos.enableControls;
    qryCopiaProdutosPedidos.Locate('produto',qryprodutospedidosproduto.AsString,[]);
  end;
end;

procedure TdtmCadastroPedidos.GravarCopiaProdutosPedidos;
var
 RegistroAtual: TBookMark;
begin
  if (qrygrade.State in [dsedit, dsinsert]) then
   qrygrade.Post;
  RegistroAtual := qryProdutosPedidos.GetBookmark;
  qryProdutosPedidos.DisableControls;
  FCancelarInclusaoProduto := False;
  qryCopiaProdutosPedidos.First;
  try
    while not qryCopiaProdutosPedidos.Eof do
    begin
     if qryProdutosPedidos.Locate('produto',qryCopiaProdutosPedidosproduto.AsString,[]) then
     begin
      if qryCopiaProdutosPedidosquantidade.AsCurrency<>0 then
      begin
       if (qryCopiaProdutosPedidosquantidade.AsCurrency<>qryProdutosPedidosquantidade.AsCurrency) or
          (qryCopiaProdutosPedidospreco.AsCurrency<>qryProdutosPedidospreco.AsCurrency) or
          (qryCopiaProdutosPedidosdesconto.AsCurrency<>qryProdutosPedidosdesconto.AsCurrency) or
          (qryCopiaProdutosPedidosvaloripi.AsCurrency<>qryProdutosPedidosvaloripi.AsCurrency) or
          (qryCopiaProdutosPedidosvaloricms.AsCurrency<>qryProdutosPedidosvaloricms.AsCurrency) then
       begin
        ReFazConsulta(qryProcuraProdutos,[3],[qryCopiaProdutosPedidosproduto.AsVariant]);
        qryProdutosPedidos.Edit;
        qryProdutosPedidosquantidade.AsCurrency := qryCopiaProdutosPedidosquantidade.AsCurrency;
        qryProdutosPedidospreco.AsCurrency     := qryCopiaProdutosPedidospreco.AsCurrency;
        qryProdutosPedidosdesconto.AsCurrency  := qryCopiaProdutosPedidosdesconto.AsCurrency;
        if qryProcuraFornecedorescrt.asinteger = 3 then
          qryProdutosPedidosvaloripi.AsCurrency  := qryCopiaProdutosPedidosvaloripi.AsCurrency
        else
          qryProdutosPedidosvaloripi.AsCurrency  := 0;
        qryProdutosPedidosvaloricms.AsCurrency := qryCopiaProdutosPedidosvaloricms.AsCurrency;
        GravarProdutoPedido;
       end
      end
      else
       qryProdutosPedidos.Delete;
     end
     else
     begin
       if qryCopiaProdutosPedidosquantidade.AsCurrency<>0 then
       begin
          ReFazConsulta(qryProcuraProdutos,[3],[qryCopiaProdutosPedidosproduto.AsVariant]);
          qryProdutosPedidos.append;
          qryProdutosPedidosproduto.AsString     := qryCopiaProdutosPedidosproduto.AsString;
          qryProdutosPedidoscaracteristica.AsString := qryCopiaProdutosPedidoscaracteristica.AsString;
          qryProdutosPedidosquantidade.AsCurrency := qryCopiaProdutosPedidosquantidade.AsCurrency;
          qryProdutosPedidospreco.AsCurrency     := qryCopiaProdutosPedidospreco.AsCurrency;
          qryProdutosPedidosdesconto.AsCurrency  := qryCopiaProdutosPedidosdesconto.AsCurrency;
          if qryProcuraFornecedorescrt.asinteger = 3 then
            qryProdutosPedidosvaloripi.AsCurrency  := qryCopiaProdutosPedidosvaloripi.AsCurrency
          else
            qryProdutosPedidosvaloripi.AsCurrency  := 0;

          qryProdutosPedidosvaloricms.AsCurrency := qryCopiaProdutosPedidosvaloricms.AsCurrency;
          GravarProdutoPedido;
       end;
     end;
     qryCopiaProdutosPedidos.Next;
    end;
  finally
    try
     qryProdutosPedidos.GotoBookmark(RegistroAtual);
     qryProdutosPedidos.FreeBookmark(RegistroAtual);
    except
    end;
    qryProdutosPedidos.enableControls;
  end;
//  qrygrade.Close;
end;

function TdtmCadastroPedidos.GetTabelaCopiaProdutoPedido: TtecQuery;
begin
  Result := qryCopiaProdutosPedidos
end;

function TdtmCadastroPedidos.GetValorProdutoCopia: Currency;
var
  IPI,
  Liquido: Currency;
begin
  Liquido := Truncar(qryCopiaProdutosPedidospreco.AsCurrency * ((100 - qryCopiaProdutosPedidosdesconto.AsCurrency) / 100), 2);
  IPI     := Truncar((Liquido * (1 + (qryCopiaProdutosPedidosvaloripi.AsCurrency / 100)) - Liquido) *
                      qryCopiaProdutosPedidosquantidade.AsCurrency, 2);
  Result  := Truncar((Liquido * (1 + (qryCopiaProdutosPedidosvaloripi.AsCurrency / 100))) *
                                      qryCopiaProdutosPedidosquantidade.AsCurrency, 2);
end;

procedure TdtmCadastroPedidos.CalcularTotalGrade;
var
   vdesconto, vipi, vpreco, vquantidade : Currency;
   vdescontoant, vipiant, vicmsant, vprecoant : Currency;
   vprecodiferente, vdescontodiferente, vipidiferente, vicmsdiferente, achou, ok : boolean;
   RegistroAtual: TBookMark;
begin
  vquantidade := 0;
  vdesconto := 0;
  vipi := 0;
  vpreco := 0;
  vprecodiferente := false;
  vdescontodiferente := false;
  vipidiferente := false;
  vicmsdiferente := false;
  achou := false;
  vprecoant    := 0;
  vdescontoant := 0;
  vipiant      := 0;
  vicmsant     := 0;
  ok := false;

  RegistroAtual := qryCopiaProdutosPedidos.GetBookmark;
  qryCopiaProdutosPedidos.DisableControls;
  qryCopiaProdutosPedidos.First;
  while not qryCopiaProdutosPedidos.Eof do
  begin
   case tipograde of
    tpLINHA  : ok := (qryCopiaProdutosPedidosvalorgrade1.AsString = qrygrade.Fields[0].AsString) and
                     (qryCopiaProdutosPedidosquantidade.AsCurrency<>0);
    tpCOLUNA : ok := (qryCopiaProdutosPedidosvalorgrade2.AsString = qrygrade.Fields[0].AsString) and
                     (qryCopiaProdutosPedidosquantidade.AsCurrency<>0);
   end;
   if ok then
   begin
    if not vprecodiferente then
      vprecodiferente    := (qryCopiaProdutosPedidospreco.AsCurrency <> vprecoant) and ((vprecoant<>0) or achou);
    if not vdescontodiferente then
      vdescontodiferente := (qryCopiaProdutosPedidosdesconto.AsCurrency <> vdescontoant)  and ((vdescontoant<>0) or achou);
    if not vipidiferente then
      vipidiferente := (qryCopiaProdutosPedidosvaloripi.AsCurrency <> vipiant) and  ((vipiant<>0) or achou);
    if not vicmsdiferente then
      vicmsdiferente := (qryCopiaProdutosPedidosvaloricms.AsCurrency <> vicmsant) and ((vicmsant<>0) or achou);

    vdesconto := vdesconto +
                 (qryCopiaProdutosPedidospreco.AsCurrency -
                  Truncar(qryCopiaProdutosPedidospreco.AsCurrency * ((100 - qryCopiaProdutosPedidosdesconto.AsCurrency) / 100), 2))*
                  qryCopiaProdutosPedidosquantidade.AsCurrency;

    vipi      := vipi + qryCopiaProdutosPedidospreco.AsCurrency -
                        Truncar((qryCopiaProdutosPedidosQuantidade.AsCurrency *
                                 qryCopiaProdutosPedidosPreco.     AsCurrency *
                                     (100 - qryCopiaProdutosPedidosValoripi.AsCurrency)) / 100, 2);

    vpreco    := vpreco +  Truncar(qryCopiaProdutosPedidospreco.AsCurrency *
                                   qryCopiaProdutosPedidosquantidade.AsCurrency, 2);
    vquantidade := vquantidade + qryCopiaProdutosPedidosquantidade.AsCurrency;

    if qryCopiaProdutosPedidospreco.AsCurrency<>0 then
     vprecoant    := qryCopiaProdutosPedidospreco.AsCurrency;
    if qryCopiaProdutosPedidosdesconto.AsCurrency<>0 then
     vdescontoant := qryCopiaProdutosPedidosdesconto.AsCurrency;
    if qryCopiaProdutosPedidosvaloripi.AsCurrency<>0 then
     vipiant      := qryCopiaProdutosPedidosvaloripi.AsCurrency;
    if qryCopiaProdutosPedidosvaloricms.AsCurrency<>0 then
     vicmsant     := qryCopiaProdutosPedidosvaloricms.AsCurrency;
    achou := true;
   end;
   qryCopiaProdutosPedidos.Next;
  end;
  dsrGrade.OnDataChange := nil;
  if not (qrygrade.State in [dsedit, dsinsert]) then
    qrygrade.Edit;
  qrygrade.FieldByName('total').AsCurrency := vpreco + vipi - vdesconto;
  qrygrade.FieldByName('quantidade').AsCurrency := vquantidade;
  qrygrade.FieldByName('precodiferente').AsBoolean := vprecodiferente;
  qrygrade.FieldByName('descontodiferente').AsBoolean := vdescontodiferente;
  qrygrade.FieldByName('ipidiferente').AsBoolean := vipidiferente;
  qrygrade.FieldByName('icmsdiferente').AsBoolean := vicmsdiferente;
  qrygrade.FieldByName('preco').ReadOnly     := vprecodiferente;;
  qrygrade.FieldByName('desconto').ReadOnly  := vdescontodiferente;
  qrygrade.FieldByName('valoricms').ReadOnly := vicmsdiferente;
  qrygrade.FieldByName('valoripi').ReadOnly := vipidiferente;

  dsrGrade.OnDataChange := dsrGradeDataChange;
  qryCopiaProdutosPedidos.GotoBookmark(RegistroAtual);
  qryCopiaProdutosPedidos.FreeBookmark(RegistroAtual);
  qryCopiaProdutosPedidos.EnableControls;
end;

procedure TdtmCadastroPedidos.qryPedidosAfterOpen(DataSet: TDataSet);
begin
  inherited;
  qryProcuraProdutos.Parambyname('filialbase').AsInteger := qryPedidosfilialentrega.AsInteger;
end;

function TdtmCadastroPedidos.PosicionarLinhaColunanoProdutoPedidoCopia(
  Coluna: String): boolean;
begin
  result := false;
  if qryCopiaProdutosPedidos.Active then
  begin
    if (Coluna <> '') and (qrygrade.fields[0].asstring <> '') then
    begin
      case tipoGrade of
       tpLINHA : result := qryCopiaProdutosPedidos.Locate('valorgrade1;valorgrade2', VarArrayOf([qrygrade.fields[0].asstring,Coluna]),[]);
       tpCOLUNA : result := qryCopiaProdutosPedidos.Locate('valorgrade1;valorgrade2', VarArrayOf([Coluna,qrygrade.fields[0].asstring]),[]);
      end;
    end
    else
    if (Coluna <> '') then
     result := qryCopiaProdutosPedidos.Locate('valorgrade2', Coluna,[])
    else
    if (qrygrade.fields[0].asstring <> '') then
     result := qryCopiaProdutosPedidos.Locate('valorgrade1', qrygrade.fields[0].asstring,[]);
  end;
end;

procedure TdtmCadastroPedidos.qryGradeBeforeInsert(DataSet: TDataSet);
begin
  inherited;
  if not PodeInserirnaGrade then
   Abort;
