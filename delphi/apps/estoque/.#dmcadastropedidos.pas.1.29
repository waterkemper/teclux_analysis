 }
procedure TdtmCadastroPedidos.RefazConsultaProdutosSimilares;
begin
  if qryProdutosPedidosproduto.AsString <> FProdutoAnterior then
  begin
    FProdutoAnterior := qryProdutosPedidosproduto.AsString;
    if FProdutoAnterior <> '' then
      ReFazConsulta(qryProdutosSimilares,[0,1],[FProdutoAnterior, FilialBase]);
  end;
end;

procedure TdtmCadastroPedidos.qryProdutosSimilaresAfterScroll(
  DataSet: TDataSet);
begin
  inherited;
  if Assigned(OnScrollLinhaColunaGradeSimilares) then
    OnScrollLinhaColunaGradeSimilares(qryProdutosSimilares);
end;

function TdtmCadastroPedidos.GetColunadaGradeSimilares: String;
begin
  Result := PrimeiraLetraEmMaiuscula(qryProdutosSimilarescoluna.AsString);
end;

function TdtmCadastroPedidos.GetLinhadaGradeSimilares: String;
begin
  Result := PrimeiraLetraEmMaiuscula(qryProdutosSimilareslinha.AsString);
end;

function TdtmCadastroPedidos.RefazConsultaContatos: Integer;
begin
  ReFazConsulta(qrycontatosFornecedores,[0],[qryPedidosfornecedor.Asinteger]);
end;

procedure TdtmCadastroPedidos.IncluirProdutosPedidoCopia;
begin
  if not qryPedidosCopia.IsEmpty then
  begin
    try
      qryProdutosPedidosCopia.First;
      dsrProdutosPedidos.OnDataChange:= nil;
      while not qryProdutosPedidosCopia.EOF do
      begin
        if qryProdutosPedidosCopiaSelecionar.asBoolean then
        begin
          FCancelarInclusaoProduto:= False;
          if qryProdutosPedidos.Locate('produtovisual',qryProdutosPedidosCopiaprodutovisual.AsString,[]) then
          begin
            qryProdutosPedidos.Edit;
            QryProdutosPedidosQuantidade.asCurrency:= QryProdutosPedidosQuantidade.asCurrency;
            QryProdutosPedidos.Post;
            qryPedidos.Edit;
          end
          else
          begin
            qryProdutosPedidos.Append;
            qryProdutosPedidosproduto.AsLargeInt	:=	qryProdutosPedidosCopiaproduto.aslargeint;
            qryProdutosPedidosprodutovisual.asString	:=	qryProdutosPedidosCopiaprodutovisual.asString;
            qryProdutosPedidosquantidade.AsCurrency	:=	qryProdutosPedidosCopiaquantidade.AsCurrency;
            qryProdutosPedidospreco.AsCurrency	        :=	qryProdutosPedidosCopiaprecosugerido.AsCurrency;
            qryProdutosPedidosdesconto.AsCurrency	        :=	qryProdutosPedidosCopiadesconto.AsCurrency;
            qryProdutosPedidosdescricao.asString	:=	qryProdutosPedidosCopiadescricao.asString;
            qryProdutosPedidostotalrecebido.AsInteger   :=      0;
            qryProdutosPedidostotal.AsCurrency          :=      qryProdutosPedidosCopiatotal.AsCurrency;
            ReFazConsulta(qryProcuraProdutos,[3],[qryProdutosPedidosCopiaproduto.AsString]);

            if qryProcuraFornecedorescrt.asinteger = 3 then
              qryProdutosPedidosvaloripi.AsCurrency	:=	qryProcuraProdutosipi.AsCurrency
            else
              qryProdutosPedidosvaloripi.AsCurrency := 0;

            qryProdutosPedidosvaloricms.AsCurrency	        :=	qryProcuraProdutosicms.AsCurrency;
            qryProdutosPedidosaliquotapis.AsCurrency	:=	qryProcuraProdutosaliquotapis.AsCurrency;
            qryProdutosPedidosaliquotacofins.AsCurrency	:=	qryProcuraProdutosaliquotacofins.AsCurrency;
            qryProdutosPedidosmarkupproduto.AsCurrency	:=	qryProcuraProdutosmarkupproduto.AsCurrency;
            qryProdutosPedidosmarkupgrupo.AsCurrency	:=	qryProcuraProdutosmarkupgrupo.AsCurrency;
            qryProdutosPedidoscaracteristica.asLargeint	:=	qryProcuraProdutoscaracteristica.asLargeint;
            qryProdutosPedidoscodigopreco.asInteger	:=	qryProcuraProdutospreco.asInteger;
            qryProdutosPedidosdescricaoprecoproduto.AsString := qryProcuraProdutosdescricaopreco.AsString;

            qryProdutosPedidoscalcularpreco.asBoolean	:=	qryProcuraProdutoscalcularpreco.asBoolean;
            qryProdutosPedidosaliquotaicmscalculopreco.AsCurrency	:=	qryProcuraProdutosaliquotaicmscalculopreco.AsCurrency;
            qryProdutosPedidoslinha.asString	        :=	qryProcuraProdutoslinha.asString;
            qryProdutosPedidoscoluna.asString	        :=	qryProcuraProdutoscoluna.asString;
            qryProdutosPedidosvalorgrade1.asString	:=	qryProcuraProdutosvalorgrade1.asString;
            qryProdutosPedidosvalorgrade2.asString	:=	qryProcuraProdutosvalorgrade2.asString;
            qryProdutosPedidosgrade1.asInteger	        :=	qryProdutosPedidosCopiagrade1.asInteger;
            qryProdutosPedidosgrade2.asInteger	        :=	qryProdutosPedidosCopiagrade2.asInteger;
            qryProdutosPedidosdescricaocaracteristica.asString	:= qryProcuraProdutosdescricaocaracteristica.asString;
            qryProdutosPedidos.Post;
          end;
        end;
        qryProdutosPedidosCopia.Next;
      end;
    finally
      qryPedidosCopia.Close;
      qryProdutosPedidosCopia.Close;
    end;
  end;
  dsrPrevisoesPedidos.OnDataChange:= dsrPrevisoesPedidosDataChange;
end;

procedure TdtmCadastroPedidos.SelecionarProdutosPedidoCopiar(Marcar,
  Todos: Boolean);
begin
  if Todos then
  begin
    try
      GuardarRegistroAtual(qryProdutosPedidosCopia,True);
      qryProdutosPedidosCopia.First;
      while not qryProdutosPedidosCopia.Eof do
      begin
        qryProdutosPedidosCopia.Edit;
        qryProdutosPedidosCopiaSelecionar.Asboolean:= Marcar;
        //qryProdutosPedidosCopiaprecosugerido.AsCurrency:=
        //     qryProdutosPedidosCopiapreco.AsCurrency;
        qryProdutosPedidosCopia.Post;
        qryProdutosPedidosCopia.Next;
      end;
    finally
      VoltarRegistroAtual(QryProdutosPedidosCopia);
    end;
  end
  else
  begin
    qryProdutosPedidosCopia.Edit;
    qryProdutosPedidosCopiaSelecionar.asBoolean:= not qryProdutosPedidosCopiaSelecionar.asBoolean;
    qryProdutosPedidosCopia.Post;
  end;
end;

procedure TdtmCadastroPedidos.AlterarPrecoProdutosPedidoCopiar(PrecoAtual: Boolean);
begin
  try
    GuardarRegistroAtual(qryProdutosPedidosCopia, True);
    qryProdutosPedidosCopia.First;
    while not qryProdutosPedidosCopia.eof do
    begin
      qryProdutosPedidosCopia.Edit;
      if PrecoAtual then
        qryProdutosPedidosCopiaprecosugerido.AsCurrency := qryProdutosPedidosCopiapreco.AsCurrency
      else
        qryProdutosPedidosCopiaprecosugerido.AsCurrency := 0;
      qryProdutosPedidosCopia.Post;
      qryProdutosPedidosCopia.Next;
    end;
  finally
    VoltarRegistroAtual(qryProdutosPedidosCopia);
  end;
end;

function TdtmCadastroPedidos.HaProdutoContratoCopiarSelecionado: Boolean;
begin
  Result := False;
  if qryPedidosCopia.Active then
  begin
    try
      GuardarRegistroAtual(qryProdutosPedidosCopia, True);
      qryProdutosPedidosCopia.First;
      while not qryProdutosPedidosCopia.EOF do
      begin
        if qryProdutosPedidosCopiaSelecionar.asBoolean then
        begin
          Result:= true;
          Break;
        end;
        qryProdutosPedidosCopia.Next;
      end;
      if not Result then
        Result := MensagemConfirmacao(ctNENHUMPRODUTOSELECIONADO) = smbOK;
    finally
      VoltarRegistroAtual(qryProdutosPedidosCopia);
    end;
  end;
end;

procedure TdtmCadastroPedidos.qryProdutosPedidosCopiaAfterInsert(
  DataSet: TDataSet);
begin
  inherited;
  qryProdutosPedidosCopia.Cancel;
end;

procedure TdtmCadastroPedidos.AbrirPedido;
begin
  ReFazConsulta(qryPedidosCopia,[0], [FValorPedidoSelecionado]);
  ReFazConsulta(qryProdutosPedidosCopia,[0,1],[EstadoFilialBase, FValorPedidoSelecionado]);
  qryProdutosPedidosCopia.First;
  while not qryProdutosPedidosCopia.eof do
  begin
    qryProdutosPedidosCopiaprecosugerido.Ascurrency:= qryProdutosPedidosCopiapreco.asCurrency;
    qryProdutosPedidosCopia.next;
  end;
end;

procedure TdtmCadastroPedidos.qryPedidosCopiaAfterOpen(DataSet: TDataSet);
begin
  inherited;
  RefazConsulta(qryProdutosPedidosCopia,[1],[qryPedidosCopianumero.AsVariant]);
end;

