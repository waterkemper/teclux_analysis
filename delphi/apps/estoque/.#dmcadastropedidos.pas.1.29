function TdtmCadastroPedidos.GravarPedido: Boolean;
var
  Produtos: String;
  Cont: Integer;
  RegistroAtual : TBookMark;
begin
  Result:= False;
  if qryPedidos.CheckRequiredFields then begin
    if qryProdutosPedidos.IsEmpty then
      MensagemAviso(ctERRORPEDIDOVAZIO)
    else
    if qryPrevisoesPedidos.IsEmpty then
      MensagemAviso(ctERRORPREVISAOVAZIO)
    else
    if (SomaPercentualPrevisao <> 100) then
      MensagemAviso(ctERRORPERCENTUALPREVISAOPEDIDOINCOMPLETO)
    else
    if (FTotalPrevisao <> qryPedidostotalpedido.AsFloat) then
      MensagemAviso(ctERRORTOTALPREVISAOPEDIDO)
    else begin
//      if qryPedidos.ReadOnly then
//        qryPedidos.ReadOnly:= False;

      if qryPedidos.State = dsInsert then begin
        spcPedidosProximo.Open;
        qryPedidosnumero.AsInteger := spcPedidosProximo.FieldByName('numero').AsInteger;
        spcPedidosProximo.Close;
      end;
      FPermitirCalcularPreco := False;
      try
        Cont := 1;
        RegistroAtual := qryProdutosPedidos.GetBookmark;
        if ParSistema.GerarPrecoAutomatico then begin
          qryProdutosPedidos.First;
          while not qryProdutosPedidos.EOF do begin
            Produtos:= Produtos + qryProdutosPedidoscaracteristica.AsString + ',';
            qryProdutosPedidos.Next;
          end;
          if Copy(Produtos,1,1) = ',' then
            Delete(Produtos,1,1);
          Delete(Produtos, Length(Produtos),1);
          qryColunasPrecos.Sql[06]:= 'Where (coluna = ' + PrecoNormal + ') and ' +
                                     '      (caracteristica in (' + Produtos + '))';
        end;
        qryColunasPrecos.Open;
        qryProdutosPedidos.DisableControls;
        qryProdutosPedidos.First;
        while not qryProdutosPedidos.EOF do begin
          qryProdutosPedidos.Edit;
          //qryProdutosPedidosnumero.AsInteger := Cont;
          qryProdutosPedidospedido.AsInteger := qryPedidosnumero.AsInteger;
          qryProdutosPedidos.DisableControls;
          qryProdutosPedidos.Post;
          qryProdutosPedidos.enableControls;
          if ParSistema.GerarPrecoAutomatico and
             qryProdutosPedidoscalcularpreco.AsBoolean and
             (qryProdutosPedidosprecosugerido.AsCurrency > 0) and
             (ParSistema.LocalCalculoPreco in [lcpPEDIDO, lcpAMBOS])
          then begin
            if qryColunasPrecos.Locate('caracteristica, preco, coluna',
                                       VarArrayOf([qryProdutosPedidoscaracteristica.AsString,
                                                   qryProdutosPedidoscodigopreco.AsInteger,
                                                   PrecoNormal]),[])
            then begin
              qryColunasPrecos.Edit;
              qryColunasPrecosvalor.AsCurrency := qryProdutosPedidosprecosugerido.AsCurrency;
            end else begin
              qryColunasPrecos.Append;
              qryColunasPrecoscaracteristica.AsLargeInt := qryProdutosPedidoscaracteristica.AsLargeInt;
              qryColunasPrecospreco.AsInteger           := qryProdutosPedidoscodigopreco.AsInteger;
              qryColunasPrecoscoluna.AsInteger          := StrToInt(PrecoNormal);
              qryColunasPrecosvalor.AsCurrency          := qryProdutosPedidosprecosugerido.AsCurrency
            end;
            qryColunasPrecos.Post;
          end;
          qryProdutosPedidos.Next;
          Inc(Cont);
        end;
        qryProdutosPedidos.GotoBookmark(RegistroAtual);
        qryProdutosPedidos.FreeBookmark(RegistroAtual);
        qryProdutosPedidos.enableControls;
      finally
        FPermitirCalcularPreco := True;
      end;

      GuardarRegistroAtual(qryPrevisoesPedidos, true);
      qryPrevisoesPedidos.First;
      while not qryPrevisoesPedidos.EOF do
      begin
        if qryPrevisoesPedidosnumero.AsInteger = 0 then
        begin
          qryPrevisoesPedidos.Edit;
          qryPrevisoesPedidospedido.AsInteger := qryPedidosnumero.AsInteger;
          qryPrevisoesPedidos.Post;
        end;
        qryPrevisoesPedidos.Next;
      end;
      VoltarRegistroAtual(qryPrevisoesPedidos);

      if qryPedidos.State = dsInsert then
        GerarDocumentosPag
      else if qryPedidos.State = dsEdit then
        AlterarDocumentosPag;

      qryPedidos.Post;
      FPermitirCalcularPreco := False;
      Perpetrar([qryPedidos, qryPrevisoesPedidos, qryProdutosPedidos, qryFornecedorProduto,
                 qryDocumentosPag, qryDuplicatas, qryColunasPrecos]);
//      qryPedidos.ReadOnly:= not PodeExcluirAlterarPedido;
      FPermitirCalcularPreco := True;
      Result := True;
    end;
  end;
end;

function TdtmCadastroPedidos.GravarPrevisaoPedido: Boolean;
var
  vReadonlyAnterior : Boolean;
begin
  Result:= False;
  if qryPrevisoesPedidos.CheckRequiredFields then begin
    if qryPrevisoesPedidos.State in [dsEdit,dsInsert] then begin
      if (SomaPercentualPrevisao > 100) then begin
        MensagemAviso(ctERRORPERCENTUALPREVISAOPEDIDOCOMPLETO);
        qryPrevisoesPedidos.Cancel;
      end
      else begin
        qryPrevisoesPedidos.Post;

        if not (qryPedidos.State in [dsEdit, dsInsert]) then
        begin
//          vReadonlyAnterior := qryPedidos.readonly;
          qryPedidos.readonly := false;
          qryPedidos.Edit;
//          qryPedidos.readonly := vReadonlyAnterior;
        end;
        Result := True;
      end;
    end;
  end
end;


function TdtmCadastroPedidos.GravarProdutoPedido: Boolean;
begin
  Result:= False;
  if dsrProdutosPedidos.DataSet = qryProdutosPedidos then
  begin
    if qryProdutosPedidos.CheckRequiredFields and VerificarProdutosFornecedor then
    begin
      qryProdutosPedidosdescricao.AsString     := qryProcuraProdutosdescricao.AsString;
      qryProdutosPedidosdescricaocaracteristica.AsString := qryProcuraProdutosdescricaocaracteristica.AsString;
      qryProdutosPedidosvalorgrade1.AsString     := qryProcuraProdutosvalorgrade1.AsString;
      qryProdutosPedidosvalorgrade2.AsString     := qryProcuraProdutosvalorgrade2.AsString;
      qryProdutosPedidoslinha.AsString     := qryProcuraProdutoslinha.AsString;
      qryProdutosPedidoscoluna.AsString     := qryProcuraProdutoscoluna.AsString;

      if qryProdutosPedidos.State = dsInsert then begin
        FValorUnitarioAnterior:= 0;
        FValorLiquidoAnterior := 0;
        FValorIPIAnterior     := 0;
      end;

      qryProdutosPedidosvalorproduto.AsCurrency:= GetValorProduto;
      qryPedidosvalorproduto.AsCurrency := qryPedidosvalorproduto.AsCurrency + FValorLiquidoProduto - FValorLiquidoAnterior;
      qryPedidosvaloripi.AsCurrency     := qryPedidosvaloripi.AsCurrency     + FValorIPIProduto - FValorIPIAnterior;

      qryPedidostotalproduto.AsCurrency := qryPedidostotalproduto.AsCurrency +
                                           qryProdutosPedidosvalorproduto.AsCurrency - FValorUnitarioAnterior{ - FValorIPIAnterior};

      qryPedidostotalpedido.AsCurrency  := qryPedidostotalpedido.AsCurrency  +
                                           qryPedidostotalproduto.AsCurrency -  FValorUnitarioAnterior - FValorIPIAnterior;
      qryprodutospedidos.DisableControls;
      qryProdutosPedidos.Post;
      qryprodutospedidos.EnableControls;
      if not (qryPedidos.State in [dsEdit, dsInsert]) then
        qryPedidos.Edit;
      CalcularAcrescimoDesconto;
      ReCalcularPrevisoes;
      Result := True;
    end;
  end
  else
  begin
    qryCopiaProdutosPedidos.DisableControls;
    qryCopiaProdutosPedidos.Post;
    qryCopiaProdutosPedidos.EnableControls;
    dsrGrade.OnDataChange := nil;
    qrygrade.Edit;
    case tipograde of
     tpLINHA : qryGrade.Fields[colunas.IndexOf(qryCopiaProdutosPedidosvalorgrade2.AsString)+1].AsCurrency := qryCopiaProdutosPedidosquantidade.AsCurrency;
     tpCOLUNA: qryGrade.Fields[colunas.IndexOf(qryCopiaProdutosPedidosvalorgrade1.AsString)+1].AsCurrency := qryCopiaProdutosPedidosquantidade.AsCurrency;
    end;
    qryGrade.FieldByName('preco').Ascurrency := qryCopiaProdutosPedidospreco.AsCurrency;
    qryGrade.FieldByName('desconto').Ascurrency := qryCopiaProdutosPedidosdesconto.AsCurrency;
    qryGrade.FieldByName('valoricms').Ascurrency := qryCopiaProdutosPedidosvaloricms.AsCurrency;
    qryGrade.FieldByName('valoripi').Ascurrency := qryCopiaProdutosPedidosvaloripi.AsCurrency;
    CalcularTotalGrade;
    qrygrade.Post;
    dsrGrade.OnDataChange := dsrGradeDataChange;
    qrygrade.Edit;
    result := true;
  end;
end;

function TdtmCadastroPedidos.IncluirPedido: Boolean;
begin
//  if qryPedidos.ReadOnly then
//     qryPedidos.ReadOnly:= False;

  qryPedidos.Insert;
  qryPedidosemissao.AsDateTime  := DataServidor;
  qryPedidosdatabase.AsDateTime := DataServidor;
  qryPedidossituacao.AsString   := 'A';
  Result:= True;
end;

function TdtmCadastroPedidos.IncluirPrevisaoPedido(Editar: Boolean): Boolean;
var
  Perc: Currency;

  function PercentualPedido: Currency;
  begin
    Perc:= 0;
    qryPrevisoesPedidos.DisableControls;
    qryPrevisoesPedidos.First;
    try
      while not qryPrevisoesPedidos.eof do begin
        Perc:= Perc + qryPrevisoesPedidospercentual.AsCurrency;
        qryPrevisoesPedidos.Next;
      end;
    finally
      qryPrevisoesPedidos.EnableControls;
      Result:= (100 - Perc);
    end;
  end;

begin
  Result:= True;
  if not Editar then
    if (SomaPercentualPrevisao > 100) then
      MensagemAviso('A soma ultrapassou 100%')
    else begin
      Perc:= PercentualPedido;
      qryPrevisoesPedidos.Append;
      qryPrevisoesPedidospercentual.AsCurrency:= Perc;
    end;
end;


function TdtmCadastroPedidos.IncluirProdutoPedido(Editar: Boolean): Boolean;
{var
  Numero : integer;}
begin
  Result:= True;
  FCancelarInclusaoProduto := False;
  try
    if Editar and not qryProdutosPedidos.IsEmpty then begin
      DefinirConsultaProdutos(True);
      qryProdutosPedidos.DisableControls;
      qryProdutosPedidos.Edit;
      qryProdutosPedidos.Cancel;
      qryProdutosPedidos.EnableControls;
    end
    else begin
      DefinirConsultaProdutos(False);
      qryProdutosPedidos.Params[1].Clear;
     // Numero := qryProdutosPedidosnumero.AsInteger;
//      Numero := qryProdutosPedidos.RecordCount;
     // qryProdutosPedidos.Insert;
      qryProdutosPedidos.append;
//      qryProdutosPedidosnumero.AsInteger := Numero + 1;
      qryProdutosPedidosquantidade.AsCurrency := 0;
    end;
  finally
    FCancelarInclusaoProduto := True;
  end
end;

function TdtmCadastroPedidos.MontarOrcamento: TStringList;
var
  IPI,
  Soma: Currency;
  Classificacao: String;
  Html: TStringList;

function ProcuraeSubstitui(Campo, Enter, br: String):String;
var PosAtu: integer;
begin
  PosAtu := Pos(Enter,Campo);
  while PosAtu <> 0 do begin
    Delete(Campo,PosAtu,Length(Enter));
    Insert(br,Campo,PosAtu);
    PosAtu := Pos(Enter,Campo);
  end;
  Result:= Campo;
end;

begin
  Soma:= 0;
  IPI:= 0;
  Classificacao:= '';
  Html:= TStringList.Create;
  with Html do
  begin
              Append('<HTML>');
              Append('<HEAD>');
              Append('<TITLE> Pedido ' + PrimeiraLetraEmMaiuscula(NomeFilialBase) + '</TITLE>');
              Append('<META NAME="Author" CONTENT="tecSOFT-tecLUX">');
	      Append('<style type="text/css">');
	      Append('<!--');
              Append('.linha {  border-color: #000000; border-top-width: 1px; border-right-width: 1px; border-left-width: 1px; border-bottom-width: 1px}');
              Append('.linha1 {  border-color: #000000; border-top-width: 1px; border-right-width: 1px; border-left-width: 0px; border-bottom-width: 1px}');
	      Append('.linhameio1 {  border-color: #000000; border-top-width: 0px; border-right-width: 1px; border-left-width: 1px; border-bottom-width: 1px}');
	      Append('.linhameio {  border-color: #000000; border-top-width: 0px; border-right-width: 1px; border-left-width: 0px; border-bottom-width: 1px}');
