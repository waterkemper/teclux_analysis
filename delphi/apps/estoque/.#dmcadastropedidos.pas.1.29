  ReCalcularTotais;
  qryProdutosPedidos.Close;
  ReFazConsulta(qryProdutosPedidos,[1],[0]);
end;
{*$IFDEF MSQt}
procedure TdtmCadastroPedidos.GravarExcel;
var
  Excel, oWB, oSheet: Variant;
  Linha, Previsoes, Coluna, p,
  QtdeProdutos, Planilhas, produtos, NovaLinha: integer;
  TotalProdutos: Currency;

begin
  QtdeProdutos:= 44;
  produtos:= 1;
  Excel:= CreateOleObject('Excel.Application');
  Excel.Visible:= False;

  oWB := Excel.Workbooks.Add;
  oSheet := oWB.ActiveSheet;

//  Excel.WorkBooks.Open(ExtractFilePath(Application.ExeName)+'Pedidos.xls');

  Excel.WorkBooks[1].Sheets[1].Cells[1,29]:= Now;
  Excel.WorkBooks[1].Sheets[1].Name:= 'Ordem de Compra';
  Excel.WorkBooks[1].Sheets[1].Cells[2,29]:= 1;
  Excel.WorkBooks[1].Sheets[1].Cells[3,1] := 'Nº: '+qryPedidosnumero.AsString+' - '+qryPedidosdescricaosituacao_.AsString;
  Excel.WorkBooks[1].Sheets[1].Cells[4,11]:= RazaoFilialBase;
  Excel.WorkBooks[1].Sheets[1].Cells[5,11]:= RuaFilialBase+' - '+BairroFilialBase;
  Excel.WorkBooks[1].Sheets[1].Cells[6,11]:= 'CEP: '+CEPFilialBase+ ' - '+CidadeFilialBase+' - '+EstadoFilialBase;
  Excel.WorkBooks[1].Sheets[1].Cells[9,1]  := 'Nome: '+ qryProcuraFornecedoresnome.AsString;
  Excel.WorkBooks[1].Sheets[1].Cells[9,16] := qryProcuraFornecedorespessoanumero.AsString;
  Excel.WorkBooks[1].Sheets[1].Cells[10,1] := 'Rua: '+ qryProcuraFornecedoresrua.AsString+' - '+qryProcuraFornecedoresnomebairro.AsString;
  Excel.WorkBooks[1].Sheets[1].Cells[10,16]:= qryProcuraFornecedoresinscricaoestadual.AsString;
  Excel.WorkBooks[1].Sheets[1].Cells[10,25]:= qryPedidosfilialfatura.AsString+' - '+qryPedidosnomefilialfatura.AsString;
  Excel.WorkBooks[1].Sheets[1].Cells[11,25]:= qryPedidosfilialentrega.AsString+' - '+qryPedidosnomefilialentrega.AsString;
  Excel.WorkBooks[1].Sheets[1].Cells[12,25]:= qryPedidosfilialcobranca.AsString+' - '+qryPedidosnomefilialcobranca.AsString;
  Excel.WorkBooks[1].Sheets[1].Cells[11,1] := 'Cidade: '+ qryProcuraFornecedoresnomecidade.AsString+' - '+qryProcuraFornecedoresestado.AsString;
  Excel.WorkBooks[1].Sheets[1].Cells[12,1] := 'Fone: '+ qryProcuraFornecedoresfone_.AsString;
  Excel.WorkBooks[1].Sheets[1].Cells[13,5] := qryPedidoscontato.AsString;

  linha:= 15;
  vVisualizarProdutosFornecedores := true;
  qryProdutosPedidos.DisableControls;
  qryProdutosPedidos.First;
  while not qryProdutosPedidos.Eof do
  begin
     Excel.WorkBooks[1].Sheets[1].Cells[Linha,1]   := qryProdutosPedidosnumero.AsString;
     Excel.WorkBooks[1].Sheets[1].Cells[Linha,2]   := qryProdutosPedidosproduto.AsString;
     Excel.WorkBooks[1].Sheets[1].Cells[Linha,4]   := qryProdutosFornecedoresprodutonofornecedor.AsString;

     Excel.WorkBooks[1].Sheets[1].Cells[Linha,6]   := qryProdutosPedidosdescricaocaracteristica.AsString;
     Excel.WorkBooks[1].Sheets[1].Cells[Linha,17]  := qryProdutosPedidosreferencia.AsString;
     Excel.WorkBooks[1].Sheets[1].Cells[Linha,23]  := qryProdutosPedidosunidade.AsString;
     Excel.WorkBooks[1].Sheets[1].Cells[Linha,24]  := qryProdutosPedidosquantidade.AsString;
     Excel.WorkBooks[1].Sheets[1].Cells[Linha,25]  := qryProdutosPedidospreco.AsCurrency;
     Excel.WorkBooks[1].Sheets[1].Cells[Linha,26]  := qryProdutosPedidosdesconto.AsString;
     Excel.WorkBooks[1].Sheets[1].Cells[Linha,27]  := qryProdutosPedidosvaloricms.AsString;
     Excel.WorkBooks[1].Sheets[1].Cells[Linha,28]  := qryProdutosPedidosvaloripi.AsString;
     Excel.WorkBooks[1].Sheets[1].Cells[Linha,29]  := formatFloat('###,###,##0.00',qryProdutosPedidosvalorproduto.AsCurrency);
     inc(Linha);
     inc(produtos);
     qryProdutosPedidos.Next;
     if produtos >= QtdeProdutos then
     begin
       Excel.WorkBooks[1].Sheets[1].Rows.Rows[linha].Insert;
       Excel.WorkBooks[1].Sheets[1].Range['B'+inttostr(Linha),'E'+inttostr(Linha)].MergeCells:= true;
       Excel.WorkBooks[1].Sheets[1].Range['f'+inttostr(Linha),'P'+inttostr(Linha)].MergeCells:= true;
       Excel.WorkBooks[1].Sheets[1].Range['Q'+inttostr(Linha),'V'+inttostr(Linha)].MergeCells:= true;
     end;
  end;
  qryProdutosPedidos.EnableControls;
  vVisualizarProdutosFornecedores := false;

  if qryProdutosPedidos.RecordCount > QtdeProdutos then
    NovaLinha:= Linha + 3
  else
    NovaLinha:= 60;
  Excel.WorkBooks[1].Sheets[1].Cells[NovaLinha,29]:= formatFloat('###,###,##0.00',qryPedidosvalorproduto.AsCurrency);
  Excel.WorkBooks[1].Sheets[1].Cells[NovaLinha+1,29]:= formatFloat('###,###,##0.00',qryPedidosvaloripi.AsCurrency);
  Excel.WorkBooks[1].Sheets[1].Cells[NovaLinha+2,29]:= formatFloat('###,###,##0.00',qryPedidostotaldescto.AsCurrency);
  Excel.WorkBooks[1].Sheets[1].Cells[NovaLinha+3,29]:= formatFloat('###,###,##0.00',qryPedidostotalacresc.AsCurrency);
  Excel.WorkBooks[1].Sheets[1].Cells[NovaLinha+4,29]:= formatFloat('###,###,##0.00',qryPedidosfretenota.AsCurrency);
  Excel.WorkBooks[1].Sheets[1].Cells[NovaLinha+5,29]:= formatFloat('###,###,##0.00',qryPedidostotalpedido.AsCurrency);
  Excel.WorkBooks[1].Sheets[1].Cells[NovaLinha+7,9] := qryProcuraFornecedorTransportesrazao.AsString;
  Previsoes:= NovaLinha;
  Coluna:= 1;
  if qryPrevisoesPedidos.RecordCount > 0 then
  begin
    qryPrevisoesPedidos.First;
    while not qryPrevisoesPedidos.Eof do
    begin
      if qryPrevisoesPedidos.RecNo mod 2 = 0 then
        Coluna := 9
      else
        Coluna := 1;
    Excel.WorkBooks[1].Sheets[1].Cells[Previsoes,Coluna]:= qryPrevisoesPedidosdias.AsString;
    Excel.WorkBooks[1].Sheets[1].Cells[Previsoes,(Coluna+2)]:= qryPrevisoesPedidosdata.AsString;
    Excel.WorkBooks[1].Sheets[1].Cells[Previsoes,(Coluna+5)]:= formatFloat('###,###,##0.00',qryPrevisoesPedidosvalor.AsFloat);
    if Coluna = 9 then
      Inc(Previsoes);
    qryPrevisoesPedidos.Next;
    end;
  end;

  Excel.WorkBooks[1].Sheets[1].Cells[NovaLinha+8,1] := ParSistema.ObservacaoRodapePedidos;
  Excel.WorkBooks[1].Sheets[1].Cells[NovaLInha,17]:= qryPedidosobservacoes.AsString;
  if FileExists(ParSistema.DiretorioImagens+'logoExcel.bmp') then
    Excel.WorkBooks[1].Sheets[1].Shapes.AddPicture(ParSistema.DiretorioImagens+'logoExcel.bmp',0, 1, 25, 40, 150, 40);

  Excel.WorkBooks[1].SaveAs(LocalGravacao);
  Excel.WorkBooks.Open(LocalGravacao);
  Excel.Visible:= True;
end;
{*$ENDIF}

function TdtmCadastroPedidos.GravarProdutoPedidoCompra: Boolean;
begin
  Result:= False;
  if dsrProdutosPedidos.DataSet = qryProdutosPedidos then
  begin
    if qryProdutosPedidos.CheckRequiredFields then
    begin
      qryProdutosPedidosdescricao.AsString     := qryProcuraProdutosdescricao.AsString;
      qryProdutosPedidosdescricaocaracteristica.AsString := qryProcuraProdutosdescricaocaracteristica.AsString;
      qryProdutosPedidosvalorgrade1.AsString     := qryProcuraProdutosvalorgrade1.AsString;
      qryProdutosPedidosvalorgrade2.AsString     := qryProcuraProdutosvalorgrade2.AsString;
      qryProdutosPedidoslinha.AsString     := qryProcuraProdutoslinha.AsString;
      qryProdutosPedidoscoluna.AsString     := qryProcuraProdutoscoluna.AsString;

      if qryProdutosPedidos.State = dsInsert then begin
        FValorUnitarioAnterior:= 0;
        FValorLiquidoAnterior := 0;
        FValorIPIAnterior     := 0;
      end;

      qryProdutosPedidosvalorproduto.AsCurrency:= GetValorProduto;
      qryPedidosvalorproduto.AsCurrency := qryPedidosvalorproduto.AsCurrency + FValorLiquidoProduto - FValorLiquidoAnterior;
      qryPedidosvaloripi.AsCurrency     := qryPedidosvaloripi.AsCurrency     + FValorIPIProduto - FValorIPIAnterior;

      qryPedidostotalproduto.AsCurrency := qryPedidostotalproduto.AsCurrency +
                                           qryProdutosPedidosvalorproduto.AsCurrency - FValorUnitarioAnterior{ - FValorIPIAnterior};

      qryPedidostotalpedido.AsCurrency  := qryPedidostotalpedido.AsCurrency  +
                                           qryPedidostotalproduto.AsCurrency -  FValorUnitarioAnterior - FValorIPIAnterior;
      qryprodutospedidos.DisableControls;
      qryProdutosPedidos.Post;
      qryprodutospedidos.EnableControls;
      if not (qryPedidos.State in [dsEdit, dsInsert]) then
        qryPedidos.Edit;
      CalcularAcrescimoDesconto;
      ReCalcularPrevisoes;
      Result := True;
    end;
  end
  else
  begin
    qryCopiaProdutosPedidos.DisableControls;
    qryCopiaProdutosPedidos.Post;
    qryCopiaProdutosPedidos.EnableControls;
    dsrGrade.OnDataChange := nil;
    qrygrade.Edit;
    case tipograde of
     tpLINHA : qryGrade.Fields[colunas.IndexOf(qryCopiaProdutosPedidosvalorgrade2.AsString)+1].AsCurrency := qryCopiaProdutosPedidosquantidade.AsCurrency;
     tpCOLUNA: qryGrade.Fields[colunas.IndexOf(qryCopiaProdutosPedidosvalorgrade1.AsString)+1].AsCurrency := qryCopiaProdutosPedidosquantidade.AsCurrency;
    end;
    qryGrade.FieldByName('preco').Ascurrency := qryCopiaProdutosPedidospreco.AsCurrency;
    qryGrade.FieldByName('desconto').Ascurrency := qryCopiaProdutosPedidosdesconto.AsCurrency;
    qryGrade.FieldByName('valoricms').Ascurrency := qryCopiaProdutosPedidosvaloricms.AsCurrency;
    qryGrade.FieldByName('valoripi').Ascurrency := qryCopiaProdutosPedidosvaloripi.AsCurrency;
    CalcularTotalGrade;
    qrygrade.Post;
    dsrGrade.OnDataChange := dsrGradeDataChange;
    qrygrade.Edit;
    result := true;
  end;
end;

procedure TdtmCadastroPedidos.qryProdutosPedidosAfterPost(
  DataSet: TDataSet);
begin
  inherited;
  if qryPedidos.Active then
    qryPedidos.Edit;
end;

procedure TdtmCadastroPedidos.qryProdutosPedidosNewRecord(
  DataSet: TDataSet);
begin
  inherited;
  qryProdutosPedidosnumero.AsInteger := qryProdutosPedidos.RecordCount + 1;
end;

procedure TdtmCadastroPedidos.RefazerNumeroProdutos;
begin
  qryProdutosPedidos.AfterPost := nil;
  qryProdutosPedidos.AfterScroll := nil;
  qryProdutosPedidos.BeforeEdit := nil;

  GuardarRegistroAtual(qryProdutosPedidos,true);
  qryProdutosPedidos.First;
  while not qryProdutosPedidos.Eof do
  begin
    qryProdutosPedidos.Edit;
    qryProdutosPedidosnumero.AsInteger := qryProdutosPedidos.RecNo;
    qryProdutosPedidos.Post;
    qryProdutosPedidos.Next;
  end;
  VoltarRegistroAtual(qryProdutosPedidos);

  qryProdutosPedidos.AfterPost   := qryProdutosPedidosAfterPost;
  qryProdutosPedidos.AfterScroll := qryProdutosPedidosAfterScroll;
  qryProdutosPedidos.BeforeEdit  := qryProdutosPedidosBeforeEdit;

end;

procedure TdtmCadastroPedidos.ImportarArquivoDaico;
var
  i        : integer;
  vProduto : String;

  function ExisteProdutosImportadosDaico: boolean;
  begin
    result := false;
    qryProdutosPedidos.First;
    while not qryProdutosPedidos.Eof do
    begin
      if qryProdutosPedidosimportadodaico.AsBoolean then
      begin
        result := true;
        break;
      end
      else
        qryProdutosPedidos.Next;
    end;
  end;

  procedure EliminarProdutosImportadosDaico;
  begin
    qryProdutosPedidos.First;
    while not qryProdutosPedidos.Eof do
    begin
      if qryProdutosPedidosimportadodaico.AsBoolean then
        qryProdutosPedidos.Delete
      else
        qryProdutosPedidos.Next;
    end;
  end;

begin
  vProduto := qryProdutosPedidosproduto.asstring;

  if ExisteProdutosImportadosDaico then
    if MensagemConfirmacao('Este pedido já possui produtos importados da Daico, deseja eliminá-los ?') = smbOk then
       EliminarProdutosImportadosDaico;



  for i := 0 to length(ArquivoTXT_Daico)-1 do
  begin
    qryProcuraProdutos.MacroByName('SelecaoporReferencia').asstring :=
       ' or p.codigo in (select p2.codigo  from produtos p2 where p2.referencia = '+quotedstr(trim(ArquivoTXT_Daico[I].Referencia))+')';

    RefazConsultaPorNome(qryProcuraProdutos,['codigo','codigovisual'],
                                           [0,'']);

    if qryprocuraprodutos.RecordCount = 0 then
      MensagemAviso(format('O produto com a REFERÊNCIA: ''%s'' e DESCRIÇÃO: ''%s'' importado da DAICO não foi encontrado.'+chr(13)+
                          'Verifique no cadastro de produtos a existência do mesmo.',
                          [trim(ArquivoTXT_Daico[I].Referencia), trim(ArquivoTXT_Daico[I].Descricao)]))
    else
    if qryprocuraprodutos.RecordCount > 1 then
      MensagemAviso(format('O produto com a REFERÊNCIA: ''%s'' e DESCRIÇÃO: ''%s'' importado da DAICO esta duplicado.'+chr(13)+
                          'Verifique no cadastro de produtos a duplicidade existente.',
                          [trim(ArquivoTXT_Daico[I].Referencia), trim(ArquivoTXT_Daico[I].Descricao)]))

    else
    if qryprocuraprodutos.RecordCount = 1 then
    begin
      if not qryProdutosPedidos.IsEmpty and
        qryProdutosPedidos.Locate('produto', qryProcuraProdutoscodigo.asstring, []) then
      begin
        qryProdutosPedidos.Edit;
        qryProdutosPedidosquantidade.AsCurrency := qryProdutosPedidosquantidade.AsCurrency + ArquivoTXT_Daico[I].Quantidade;
        qryProdutosPedidos.Post;
        qryPedidos.Edit;
      end
      else
      begin
        qryProdutosPedidos.BeforeInsert := nil;
        qryProdutosPedidos.Append;
        qryProdutosPedidosproduto.AsString        := qryProcuraProdutoscodigo.AsString;
        qryProdutosPedidosprodutovisual.AsString    := qryProcuraProdutoscodigovisual.AsString;
        qryProdutosPedidoscaracteristica.AsLargeInt := qryProcuraProdutoscaracteristica.AsLargeInt;
        qryProdutosPedidoscodigopreco.AsInteger     := qryProcuraProdutospreco.AsInteger;
        qryProdutosPedidosdescricaoprecoproduto.AsString := qryProcuraProdutosdescricaopreco.AsString;
        
        if qryProcuraFornecedorescrt.asinteger = 3 then
          qryProdutosPedidosvaloripi.AsCurrency := qryProcuraProdutosipi.AsCurrency
        else
          qryProdutosPedidosvaloripi.AsCurrency := 0;

        qryProdutosPedidosvaloricms.AsCurrency         := qryProcuraProdutosicms.AsCurrency;
        qryProdutosPedidosaliquotaicmscalculopreco.AsCurrency := qryProcuraProdutosaliquotaicmscalculopreco.AsCurrency;
        qryProdutosPedidosaliquotapis.AsCurrency       := qryProcuraProdutosaliquotapis.AsCurrency;
        qryProdutosPedidosaliquotacofins.AsCurrency    := qryProcuraProdutosaliquotacofins.AsCurrency;
        qryProdutosPedidosmarkupproduto.AsCurrency     := qryProcuraProdutosmarkupproduto.AsCurrency;
        qryProdutosPedidosmarkupgrupo.AsCurrency       := qryProcuraProdutosmarkupgrupo.AsCurrency;
        qryProdutosPedidoscalcularpreco.AsBoolean   := qryProcuraProdutoscalcularpreco.AsBoolean;
//        qryProdutosPedidospreco.AsCurrency             := qryProcuraProdutosprecosugestao.AsCurrency;

        qryProdutosPedidospreco.AsCurrency   := ArquivoTXT_Daico[I].PrecoCT;
        qryProdutosPedidosquantidade.AsCurrency   := ArquivoTXT_Daico[I].Quantidade;
        qryProdutosPedidosimportadodaico.AsBoolean:= True;
        qryProdutosPedidos.BeforeInsert := qryProdutosPedidosBeforeInsert;

      end;
      if not GravarProdutoPedido then
        qryProdutosPedidos.Cancel;
         
      qryPedidos.Edit;
    end;
  end;
  qryProdutosPedidos.Locate('produto',vproduto, [])

end;

function TdtmCadastroPedidos.ExibirFicha(FormOrigem: String): boolean;
begin
    result := ExibirFichacliente(qryProcuraFornecedorescodigo.AsInteger,
                                 'F',
                                 qryProcuraFornecedoresnome.AsString,
                                 FormOrigem)
end;

function TdtmCadastroPedidos.GravarProdutoPedidoGrid: Boolean;
begin
  Result:= False;
  if dsrProdutosPedidos.DataSet = qryProdutosPedidos then
  begin
    if qryProdutosPedidos.CheckRequiredFields then
    begin
      qryProdutosPedidosvalorproduto.AsCurrency:= GetValorProduto;
      qryPedidosvalorproduto.AsCurrency := qryPedidosvalorproduto.AsCurrency + FValorLiquidoProduto - FValorLiquidoAnterior;
      qryPedidosvaloripi.AsCurrency     := qryPedidosvaloripi.AsCurrency     + FValorIPIProduto - FValorIPIAnterior;

      qryPedidostotalproduto.AsCurrency := qryPedidostotalproduto.AsCurrency +
                                           qryProdutosPedidosvalorproduto.AsCurrency - FValorUnitarioAnterior{ - FValorIPIAnterior};

      qryPedidostotalpedido.AsCurrency  := qryPedidostotalpedido.AsCurrency  +
                                           qryPedidostotalproduto.AsCurrency -  FValorUnitarioAnterior - FValorIPIAnterior;
      qryprodutospedidos.DisableControls;
      qryProdutosPedidos.Post;
      qryprodutospedidos.EnableControls;
      if not (qryPedidos.State in [dsEdit, dsInsert]) then
        qryPedidos.Edit;
      CalcularAcrescimoDesconto;
      ReCalcularPrevisoes;
      Result := True;
    end;
  end;
end;

end.

