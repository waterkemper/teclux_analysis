procedure TdtmCadastroPedidos.PosicionarLinhanaGrade;
begin
 qrygrade.First;
 while not qrygrade.Eof do
 begin
  case tipoGrade of
   tpLINHA : begin
             if qrygrade.Fields[0].AsString = qryCopiaProdutosPedidosvalorgrade1.AsString then
              break;
             end;
   tpCOLUNA : begin
              if qrygrade.Fields[0].AsString = qryCopiaProdutosPedidosvalorgrade2.AsString then
               break;
              end;
  end;
  qrygrade.Next;
 end;
end;

