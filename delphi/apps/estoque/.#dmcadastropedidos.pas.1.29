function TdtmCadastroPedidos.PodeExcluirAlterarPedido: Boolean;
begin
  ReFazConsulta(qryPedidoEntregue,[0],[qryPedidosnumero.AsInteger]);
  Result := (qryPedidoEntregueQtde.AsCurrency = 0) and
            (qryPedidossituacao.AsString <> 'C');
end;

procedure TdtmCadastroPedidos.qryPedidosAfterScroll(DataSet: TDataSet);
begin
//  qryPedidos.ReadOnly := not PodeExcluirAlterarPedido;
  fqryPedidosReadOnly := not PodeExcluirAlterarPedido;
  SetFieldsReadOnly(qryPedidos, fqryPedidosReadOnly);


  if qrypedidosentrega.readonly and
    ((qryPedidossituacao.asString = 'A') or
     (qryPedidossituacao.asString = 'P')) then
    qrypedidosentrega.readonly := false;

  if qryPedidossituacao.asString = 'P' then
    qryPedidosobservacoes_estoque.ReadOnly := false;

  if qryPedidosfilialfatura.readonly and
     (qryPedidossituacao.asString = 'P') then
    qryPedidosfilialfatura.readonly := false;

  if qryPedidosfilialentrega.readonly and
     (qryPedidossituacao.asString = 'P') then
    qryPedidosfilialentrega.readonly := false;

  if qryPedidosfilialcobranca.readonly and
     (qryPedidossituacao.asString = 'P') then
    qryPedidosfilialcobranca.readonly := false;

  if Assigned(PedidosAfterScroll) then
    PedidosAfterScroll(qryPedidos);
  RefazConsulta(qryPrevisoesPedidos,[0],[qryPedidosnumero.Value]);
  RefazConsulta(qryProdutosPedidos, [1],[qryPedidosnumero.Value]);
//  if ((qryPedidossituacao.AsString = 'L') or (qryPedidossituacao.AsString = 'P')) then
    ReFazConsulta(qryNotasPag,[0],[qryPedidosnumero.AsInteger]);
  CalcularAcrescimoDesconto;
  RefazConsultaContatos;
end;

procedure TdtmCadastroPedidos.qryPedidosBeforeEdit(DataSet: TDataSet);
begin
  inherited;
  FFornecedorAnterior:= qryPedidosfornecedor.AsInteger;
end;

procedure TdtmCadastroPedidos.qryPedidosBeforeInsert(DataSet: TDataSet);
begin
  inherited;
  FFornecedorAnterior:= 0;
end;

procedure TdtmCadastroPedidos.qryPrevisoesPedidosAfterDelete(DataSet: TDataSet);
var
  vReadOnlyAnterior : boolean;
begin
  inherited;
  if not (qryPedidos.State in [dsEdit, dsInsert]) then
  begin
//    vReadOnlyAnterior := qryPedidos.readOnly;
//    qryPedidos.readOnly := False;
    qryPedidos.Edit;
//    qryPedidos.readOnly := vReadOnlyAnterior;

  end;
end;

procedure TdtmCadastroPedidos.qryProcuraFiliaisAfterOpen(DataSet: TDataSet);
begin
  inherited;
  if qryPedidos.State in [dsEdit, dsInsert] then begin
    if qryPedidosfilialentrega.AsInteger = 0 then
      qryPedidosfilialentrega.AsInteger:= qryProcuraFiliaiscodigo.AsInteger;
    if qryPedidosfilialcobranca.AsInteger = 0 then
      qryPedidosfilialcobranca.AsInteger:= qryProcuraFiliaiscodigo.AsInteger;
  end;
end;

procedure TdtmCadastroPedidos.qryProcuraFornecedoresAfterOpen(DataSet: TDataSet);
begin
  inherited;
  if qryPedidos.State in [dsEdit, dsInsert] then
    qryPedidosestado.AsString := qryProcuraFornecedoresestado.AsString;
  FCodigoFornecedor:= qryProcuraFornecedorescodigo.AsInteger;
//  qryContatosFornecedores.ParamByName('fornecedor').AsInteger := FCodigoFornecedor;
//  ReFazConsulta(qrycontatosFornecedores,[0],[qryPedidosfornecedor.AsVariant]);
  qryProcuraProdutos.Parambyname('UFOrigem').AsString  := qryProcuraFornecedoresestado.AsString;
  qryConsultaProdutos.Parambyname('UFOrigem').AsString := qryProcuraFornecedoresestado.AsString;
end;

procedure TdtmCadastroPedidos.ReCalcularPrevisoes;
var
  Diferenca,
  Total: Real;
begin
   if not qryPrevisoesPedidos.IsEmpty then begin
      Total:= 0;
      qryPrevisoesPedidos.First;
      while not qryPrevisoesPedidos.Eof do begin
         qryPrevisoesPedidos.Edit;
         qryPrevisoesPedidosValor.AsFloat:= Truncar((qryPedidostotalpedido.AsFloat *
                                                        qryPrevisoesPedidosPercentual.AsFloat) / 100,
                                                     ParSistema.PrecoUnitarioCasasDecimais);
         qryPrevisoesPedidos.Post;
         Total:= Total + qryPrevisoesPedidosvalor.AsFloat;
         qryPrevisoesPedidos.Next;
      end;
      Diferenca:= qryPedidostotalpedido.AsFloat - Total;
      qryPrevisoesPedidos.First;
      qryPrevisoesPedidos.Edit;
      qryPrevisoesPedidosvalor.AsFloat:= qryPrevisoesPedidosvalor.AsFloat + Diferenca;
      qryPrevisoesPedidos.Post;
   end;
end;


procedure TdtmCadastroPedidos.Selecionar(TipoPesquisa: TtecPedidosCompra);
begin
  case TipoPesquisa of
                pcoPEDIDO: ReFazConsulta(qryPedidos, [0], [qryConsultaPedidosnumero.AsInteger]);
  pcoFORNECEDORTRANSPORTE: begin
                             qryPedidos.Edit;
                             qryPedidosfornecedortransporte.AsInteger:= qryConsultaFornecedorTransportescodigo.AsInteger;
                           end;
            pcoFORNECEDOR: begin
                             qryPedidos.Edit;
                             qryPedidosfornecedor.Value:= qryConsultaFornecedorescodigo.Value;
                             qryPedidosestado.AsString := qryConsultaFornecedoresestado.AsString;
                           end;
          pcoFILIALFATURA: begin
                             qryPedidos.Edit;
                             qryPedidosfilialfatura.AsInteger:= qryConsultaFiliaiscodigo.AsInteger;
                             if qryPedidosfilialentrega.AsInteger = 0 then
                               qryPedidosfilialentrega.AsInteger:= qryPedidosfilialfatura.AsInteger;
                             if qryPedidosfilialcobranca.AsInteger = 0 then
                               qryPedidosfilialcobranca.AsInteger:= qryPedidosfilialfatura.AsInteger;
                           end;
         pcoFILIALENTREGA: begin
                             qryPedidos.Edit;
                             qryPedidosfilialentrega.AsInteger:= qryConsultaFiliaiscodigo.AsInteger;
                           end;
        pcoFILIALCOBRANCA: begin
                             qryPedidos.Edit;
                             qryPedidosfilialcobranca.AsInteger:= qryConsultaFiliaiscodigo.AsInteger;
                           end;
               pcoPRODUTO: begin
                             ReFazConsulta(qryProcuraProdutos,[3],[qryConsultaProdutoscodigo.AsLargeInt]);
                             qryProdutosPedidosproduto.AsLargeInt:= qryConsultaProdutoscodigo.AsLargeInt;
                             qryProdutosPedidosprodutovisual.AsString := qryConsultaProdutoscodigovisual.AsString;
                             if qryProcuraFornecedorescrt.asinteger = 3 then
                               qryProdutosPedidosvaloripi.AsCurrency := qryConsultaProdutosipi.AsCurrency
                             else
                               qryProdutosPedidosvaloripi.AsCurrency := 0;

                             qryProdutosPedidosvaloricms.AsCurrency:= qryConsultaProdutosicms.AsCurrency;
                           end;
  end;
end;

procedure TdtmCadastroPedidos.SelecionarProdutos(TodosProdutos: Boolean);
const PorGrupoFornecedor =  'and (c.codigo in (Select fp.caracteristica ' +
                                              'From  fornecedoresprodutos fp, fornecedores f ' +
                                              'Where (fp.fornecedor = f.codigo) and ' +
                                              '      (f.grupofornecedor = ';
      PorFornecedor = 'and (c.codigo in (Select fp.caracteristica ' +
                                              'From  fornecedoresprodutos fp ' +
                                              'Where (fp.fornecedor = ';
begin
  if not TodosProdutos then begin
    if qryProcuraFornecedoresgrupo.AsInteger > 0 then begin
      qryProcuraProdutos.MacroByName('SQLfornecedorgrupo').AsString  := PorGrupoFornecedor + qryProcuraFornecedoresgrupo.AsString + ')))';
      qryConsultaProdutos.MacroByName('SQLfornecedorgrupo').AsString := PorGrupoFornecedor + qryProcuraFornecedoresgrupo.AsString + ')))';
    end
    else begin
      qryProcuraProdutos.MacroByName('SQLfornecedorgrupo').AsString := PorFornecedor + qryProcuraFornecedorescodigo.AsString + ')))';
      qryConsultaProdutos.MacroByName('SQLfornecedorgrupo').AsString := PorFornecedor + qryProcuraFornecedorescodigo.AsString + ')))';
    end
  end
  else begin
    qryProcuraProdutos.MacroByName('SQLfornecedorgrupo').AsString := '';
    qryConsultaProdutos.MacroByName('SQLfornecedorgrupo').AsString := '';
  end;
end;

function TdtmCadastroPedidos.SomaPercentualPrevisao: Currency;
var
  Pos: TBookmark;
  Diferenca: Real;
begin
  Result := 0;
  FTotalPrevisao:= 0;
  Pos:= qryPrevisoesPedidos.GetBookmark;
  try
    qryPrevisoesPedidos.DisableControls;
    qryPrevisoesPedidos.First;
    while not qryPrevisoesPedidos.EOF do begin
      Result := Result + qryPrevisoesPedidospercentual.AsCurrency;
      FTotalPrevisao := FTotalPrevisao + qryPrevisoesPedidosvalor.AsFloat;
      qryPrevisoesPedidos.Next;
    end;
  finally
    if Result = 100 then begin
      Diferenca:=  qryPedidostotalpedido.AsFloat - FTotalPrevisao;
      if Diferenca <> 0 then begin
        qryPrevisoesPedidos.First;
        qryPrevisoesPedidos.Edit;
        qryPrevisoesPedidosvalor.AsFloat:= qryPrevisoesPedidosvalor.AsFloat + Diferenca;
        qryPrevisoesPedidos.Post;
        FTotalPrevisao:= FTotalPrevisao + Diferenca;
      end;
    end;
    qryPrevisoesPedidos.GotoBookmark(Pos);
    qryPrevisoesPedidos.FreeBookmark(Pos);
    qryPrevisoesPedidos.EnableControls;

    if not (qryPrevisoesPedidos.State in [dsEdit, dsInsert]) then
      qryPrevisoesPedidos.Edit;
  end;
end;

procedure  TdtmCadastroPedidos.ReCalcularTotais;
var
  ValorProdutoBruto,
  ValorProdutoIPI,
  TotalPedido,
  TotalProduto: Currency;
begin
  qryProdutosPedidos.AfterPost := nil;
  TotalProduto      := 0;
  TotalPedido       := 0;
  ValorProdutoBruto := 0;
  ValorProdutoIPI   := 0;
  try
    qryProdutosPedidos.DisableControls;
    qryProdutosPedidos.First;
    while not qryProdutosPedidos.Eof do begin
      qryProdutosPedidos.Edit;
      qryProdutosPedidosvalorproduto.AsCurrency:= GetValorProduto;
      qryProdutosPedidos.DisableControls;
      qryProdutosPedidos.Post;
      qryProdutosPedidos.enableControls;
      ValorProdutoBruto:= ValorProdutoBruto + FValorLiquidoProduto;
      ValorProdutoIPI  := ValorProdutoIPI   + FValorIPIProduto;
      TotalProduto     := TotalProduto      + qryProdutosPedidosvalorproduto.AsCurrency;
      TotalPedido      := TotalPedido       + qryProdutosPedidosvalorproduto.AsCurrency;
      qryProdutosPedidos.Next;
    end;
    qryPedidosvalorproduto.AsCurrency:= ValorProdutoBruto;
    qryPedidosvaloripi.AsCurrency    := ValorProdutoIPI;
    qryPedidostotalproduto.AsCurrency:= TotalProduto;
    qryPedidostotalpedido.AsCurrency := TotalPedido;
  finally
    qryProdutosPedidos.EnableControls;
  end;
  qryprodutospedidos.AfterPost := qryProdutosPedidosAfterPost;
end;

function TdtmCadastroPedidos.VerificarProdutosFornecedor: Boolean;
var
  Msg: String;
begin
  Result := True;
//  if qryFornecedorProduto.State = dsInactive then
  ReFazConsulta(qryFornecedorProduto,[0],[qryPedidosfornecedor.AsInteger]);
  if not qryFornecedorProduto.Locate('caracteristica', qryProcuraProdutoscaracteristica.AsString, []) then begin
    Msg := Format(ctINCLUIRPRODNOFORNECEDOR, [qryProcuraProdutoscaracteristicavisual.AsString, qryProcuraFornecedoresNome.AsString]);
    Result := MensagemConfirmacao(Msg) = smbOK;
    if Result then begin
      qryFornecedorProduto.Append;
      qryFornecedorProdutocaracteristica.AsLargeInt := qryProcuraProdutoscaracteristica.AsLargeInt;
      qryFornecedorProdutofornecedor.AsInteger     := qryPedidosFornecedor.AsInteger;
      qryFornecedorProduto.Post
    end
  end;
end;


procedure TdtmCadastroPedidos.dsrProdutosPedidosDataChange(Sender: TObject; Field: TField);
begin
  inherited;
  FAlteradoproduto:= False;
  if dsrProdutosPedidos.DataSet = qryProdutosPedidos then
  begin
    dsrProdutosPedidos.OnDataChange:= nil;
    if Field = qryProdutosPedidosproduto then begin
      if Field.Value <> Field.OldValue then begin
        qryProdutosPedidosprodutovisual.AsString    := qryProcuraProdutoscodigovisual.AsString;
        qryProdutosPedidoscaracteristica.AsLargeInt := qryProcuraProdutoscaracteristica.AsLargeInt;
        qryProdutosPedidoscodigopreco.AsInteger     := qryProcuraProdutospreco.AsInteger;
        qryProdutosPedidosdescricaoprecoproduto.AsString := qryProcuraProdutosdescricaopreco.AsString;
        if qryProcuraFornecedorescrt.asinteger = 3 then
          qryProdutosPedidosvaloripi.AsCurrency := qryProcuraProdutosipi.AsCurrency
        else
          qryProdutosPedidosvaloripi.AsCurrency := 0;

        qryProdutosPedidosvaloricms.AsCurrency         := qryProcuraProdutosicms.AsCurrency;
        qryProdutosPedidosaliquotaicmscalculopreco.AsCurrency := qryProcuraProdutosaliquotaicmscalculopreco.AsCurrency;
        qryProdutosPedidosaliquotapis.AsCurrency       := qryProcuraProdutosaliquotapis.AsCurrency;
        qryProdutosPedidosaliquotacofins.AsCurrency    := qryProcuraProdutosaliquotacofins.AsCurrency;
        qryProdutosPedidosmarkupproduto.AsCurrency     := qryProcuraProdutosmarkupproduto.AsCurrency;
        qryProdutosPedidosmarkupgrupo.AsCurrency       := qryProcuraProdutosmarkupgrupo.AsCurrency;
        qryProdutosPedidoscalcularpreco.AsBoolean   := qryProcuraProdutoscalcularpreco.AsBoolean;
        qryProdutosPedidospreco.AsCurrency             := qryProcuraProdutosprecosugestao.AsCurrency;
      end;
    end;

    if qryProdutosPedidosprecosugerido = Field then
      if qryPedidos.RecordCount > 0 then
        qryPedidos.Edit;
    dsrProdutosPedidos.OnDataChange:= dsrProdutosPedidosDataChange;

    if qryProdutosPedidosprodutovisual = Field then
    begin
      if qryProdutosPedidosprodutovisual.IsNull then
        qryProdutosPedidosproduto.clear
      else
        qryProdutosPedidosproduto.AsLargeInt := qryProcuraProdutoscodigo.asLargeint;
    end;
    if not qryProdutosPedidos.IsEmpty then
      FAlteradoproduto:= True;
  end;
end;



function TdtmCadastroPedidos.GetValorProduto: Currency;
var PrecoLiquido,
    PrecoTotal,
    ValorIPI:  Currency;
begin
   PrecoLiquido:= Truncar((qryProdutosPedidosPreco.AsCurrency * (100 - qryProdutosPedidosDesconto.AsCurrency)) / 100,
                  ParSistema.PrecoUnitarioCasasDecimais);
   PrecoTotal  := Truncar(qryProdutosPedidosQuantidade.AsCurrency * PrecoLiquido,
                  ParSistema.PrecoUnitarioCasasDecimais);
   ValorIPI    := Truncar((PrecoTotal * qryProdutosPedidosValorIpi.AsCurrency) / 100, 2);
   Result      := PrecoTotal + ValorIPI;

   FValorUnitarioProduto := PrecoLiquido;
   FValorLiquidoProduto  := PrecoTotal;
   FValorIPIProduto      := ValorIPI;
end;

procedure TdtmCadastroPedidos.qryProdutosPedidosAfterOpen(DataSet: TDataSet);
begin
  inherited;
  ReCalcularTotais;
end;

procedure TdtmCadastroPedidos.qryProdutosPedidosAfterScroll(DataSet: TDataSet);
begin
  inherited;
  if Assigned(FProdutosPedidosAfterScroll) then
    FProdutosPedidosAfterScroll(DataSet);

  if vVisualizarProdutosFornecedores then
    RefazConsultaporNome(qryProdutosFornecedores,['produto','fornecedor','tipofornecedor'],
                         [inttostr(qryProdutosPedidosproduto.asLargeint), qryPedidosfornecedor.asInteger, 'F']);
end;

procedure TdtmCadastroPedidos.qryProdutosPedidosBeforeDelete(DataSet: TDataSet);
begin
  inherited;
  if not (qryPedidos.State in [dsEdit, dsInsert]) then
    qryPedidos.Edit;
  GetValorProduto;
  qryPedidosvalorproduto.AsCurrency := qryPedidosvalorproduto.AsCurrency  - FValorLiquidoProduto;
  qryPedidosvaloripi.AsCurrency     := qryPedidosvaloripi.AsCurrency      - FValorIPIProduto;
  qryPedidostotalproduto.AsCurrency := (qryPedidostotalproduto.AsCurrency - FValorLiquidoProduto - FValorIPIProduto);
  qryPedidostotalpedido.AsCurrency  := (qryPedidostotalpedido.AsCurrency  - FValorLiquidoProduto - FValorIPIProduto);
  CalcularAcrescimoDesconto;
  ReCalcularPrevisoes;
end;

procedure TdtmCadastroPedidos.qryPedidosAfterCancel(DataSet: TDataSet);
begin
  inherited;
  ReCalcularTotais;
  ReFazConsulta(qryProdutosPedidos,[0],[0]);
  qryProdutosPedidos.Cancel;
end;

procedure TdtmCadastroPedidos.qryProdutosPedidosBeforeEdit(DataSet: TDataSet);
begin
  inherited;
  FValorUnitarioAnterior:= GetValorProduto;
  FValorLiquidoAnterior := FValorLiquidoProduto;
  FValorIPIAnterior     := FValorIPIProduto;
end;

procedure TdtmCadastroPedidos.qryProdutosPedidosBeforeInsert(DataSet: TDataSet);
begin
  inherited;
  if FCancelarInclusaoProduto then
    Abort;
end;

