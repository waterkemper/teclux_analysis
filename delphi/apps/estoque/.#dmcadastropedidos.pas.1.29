{$R *.dfm}

procedure TdtmCadastroPedidos.AbreTabelaPesquisa(TipoPesquisa: TtecPedidosCompra);
begin
  case TipoPesquisa of
    pcoPEDIDO: begin
                 qryConsultaPedidos.Sql[12]:= ' and (p.numero = 0)';
                 Abre(ctProcuraPedidos);
               end;
    pcoFORNECEDORTRANSPORTE: Abre(ctProcuraFornecedorTransporte);
    pcoFORNECEDOR: Abre(ctProcuraFornecedores);
    pcoFILIALFATURA,
    pcoFILIALENTREGA,
    pcoFILIALCOBRANCA: Abre(ctProcuraFiliais);
    pcoPRODUTO: if FTodosProdutos  then begin
                  qryConsultaProdutos.MacroByName('SQLProdutos').AsString:= 'and (p.codigo = 0)';
                  qryConsultaProdutos.close;
                  qryConsultaProdutos.Open;
                end
                else begin
                  qryConsultaProdutos.MacroByName('SQLProdutos').AsString:= '';
                  qryConsultaProdutos.close;
                  qryConsultaProdutos.Open;
                end;
  end;
end;

procedure TdtmCadastroPedidos.AlterarDocumentosPag;
begin
  ReFazConsulta(qryDocumentosPag,[0],[qryPedidosnumero.AsInteger]);
  if not qryDocumentosPag.IsEmpty then begin
    qryDocumentosPag.Edit;
    qryDocumentosPagfornecedor.AsInteger   := qryPedidosfornecedor.AsInteger;
    qryDocumentosPagtipofornecedor.AsString:= 'F';
    qryDocumentosPagemissao.AsDateTime     := qryPedidosemissao.AsDateTime;
    qryDocumentosPagdatalancto.AsDateTime  := qryPedidosemissao.AsDateTime;    
    qryDocumentosPagfilialemissao.AsInteger:= qryPedidosfilialfatura.AsInteger;
    qryDocumentosPagprevisao.AsBoolean     := True;
    qryDocumentosPagvalor.AsCurrency          := qryPedidostotalpedido.AsCurrency;
    qryDocumentosPagpedido.AsInteger       := qryPedidosnumero.AsInteger;
    qryDocumentosPag.Post;

    ReFazConsulta(qryDuplicatas,[0],[qryDocumentosPagnumero.AsInteger]);
    if not qryDuplicatas.IsEmpty then
      while not qryDuplicatas.Eof do
        qryDuplicatas.Delete;

    qryPrevisoesPedidos.First;
    while not qryPrevisoesPedidos.Eof do begin
      qryDuplicatas.Insert;
      qryDuplicatasdocumentopag.AsInteger:= qryDocumentosPagnumero.AsInteger;
      qryDuplicatasnumero.AsInteger:= qryPrevisoesPedidos.recno;
      qryDuplicatasdatavencto.AsDateTime := qryPrevisoesPedidosdata.AsDateTime;
      qryDuplicatasvalorvencto.AsFloat   := qryPrevisoesPedidosvalor.AsFloat;
      qryDuplicatas.Post;
      qryPrevisoesPedidos.Next;
    end;
  end;
end;

procedure TdtmCadastroPedidos.CalcularAcrescimoDesconto;
var FreteNota,
    FreteCTR: Currency;
begin
   qryPedidosTotalDescto.AsCurrency:= 0;
   if qryPedidosDesconto1.AsCurrency > 0 then begin
      qryPedidosValorDescto1.AsCurrency:= Truncar((qryPedidostotalproduto.AsCurrency *
                                                   qryPedidosDesconto1.   AsCurrency) / 100, 2);
      qryPedidosTotalDescto. AsCurrency:= qryPedidosTotalDescto. AsCurrency +
                                          qryPedidosValorDescto1.AsCurrency;
   end
   else qryPedidosValorDescto1.AsCurrency := 0;

   if qryPedidosDesconto2.AsCurrency > 0 then begin
      qryPedidosValorDescto2.AsCurrency:= Truncar(((qryPedidostotalproduto.AsCurrency -
                                                    qryPedidosTotalDescto. AsCurrency) *
                                                    qryPedidosDesconto2.   AsCurrency) / 100, 2);
      qryPedidosTotalDescto. AsCurrency:= qryPedidosTotalDescto. AsCurrency +
                                          qryPedidosValorDescto2.AsCurrency;
   end
   else qryPedidosValorDescto2.AsCurrency := 0;

   if qryPedidosDesconto3.AsCurrency > 0 then begin
      qryPedidosValorDescto3.AsCurrency:= Truncar(((qryPedidostotalproduto.AsCurrency -
                                                    qryPedidosTotalDescto. AsCurrency) *
                                                    qryPedidosDesconto3.   AsCurrency) / 100, 2);
      qryPedidosTotalDescto. AsCurrency:= qryPedidosTotalDescto. AsCurrency +
                                          qryPedidosValorDescto3.AsCurrency;
   end
   else qryPedidosValorDescto3.AsCurrency := 0;

   if qryPedidosDesconto4.AsCurrency > 0 then begin
      qryPedidosValorDescto4.AsCurrency:= Truncar(((qryPedidostotalproduto.AsCurrency -
                                                    qryPedidosTotalDescto. AsCurrency) *
                                                    qryPedidosDesconto4.   AsCurrency) / 100, 2);
      qryPedidosTotalDescto. AsCurrency:= qryPedidosTotalDescto. AsCurrency +
                                          qryPedidosValorDescto4.AsCurrency;
   end
   else qryPedidosValorDescto4.AsCurrency := 0;


   qryPedidosTotalAcresc.AsCurrency:= 0;
   if qryPedidosAcrescimo1.AsCurrency > 0 then begin
      qryPedidosValorAcresc1.AsCurrency:= Truncar(((qryPedidostotalproduto.AsCurrency -
                                                    qryPedidosTotalDescto. AsCurrency) *
                                                    qryPedidosAcrescimo1.   AsCurrency) / 100, 2);
      qryPedidosTotalAcresc. AsCurrency:= qryPedidosTotalAcresc. AsCurrency +
                                          qryPedidosValorAcresc1.AsCurrency;
   end
   else qryPedidosValorAcresc1.AsCurrency := 0;

   if qryPedidosAcrescimo2.AsCurrency > 0 then begin
      qryPedidosValorAcresc2.AsCurrency:= Truncar(((qryPedidostotalproduto.AsCurrency -
                                                    qryPedidosTotalDescto. AsCurrency +
                                                    qryPedidosTotalAcresc. AsCurrency) *
                                                    qryPedidosAcrescimo2.   AsCurrency) / 100, 2);
      qryPedidosTotalAcresc. AsCurrency:= qryPedidosTotalAcresc. AsCurrency +
                                          qryPedidosValorAcresc2.AsCurrency;
   end
   else qryPedidosValorAcresc2.AsCurrency := 0;

   if qryPedidosAcrescimo3.AsCurrency > 0 then begin
      qryPedidosValorAcresc3.AsCurrency:= Truncar(((qryPedidostotalproduto.AsCurrency -
                                                    qryPedidosTotalDescto. AsCurrency +
                                                    qryPedidosTotalAcresc. AsCurrency) *
                                                    qryPedidosAcrescimo3.   AsCurrency) / 100, 2);
      qryPedidosTotalAcresc. AsCurrency:= qryPedidosTotalAcresc. AsCurrency +
                                          qryPedidosValorAcresc3.AsCurrency;
   end
   else qryPedidosValorAcresc3.AsCurrency := 0;

   if qryPedidosAcrescimo4.AsCurrency > 0 then begin
      qryPedidosValorAcresc4.AsCurrency:= Truncar(((qryPedidostotalproduto.AsCurrency -
                                                    qryPedidosTotalDescto. AsCurrency +
                                                    qryPedidosTotalAcresc. AsCurrency) *
                                                    qryPedidosAcrescimo4.   AsCurrency) / 100, 2);
      qryPedidosTotalAcresc. AsCurrency:= qryPedidosTotalAcresc. AsCurrency +
                                          qryPedidosValorAcresc4.AsCurrency;
   end
   else qryPedidosValorAcresc4.AsCurrency := 0;

   qryPedidostotalpedido.AsCurrency:=  qryPedidostotalproduto.AsCurrency +
                                       qryPedidosTotalAcresc. AsCurrency -
                                       qryPedidosTotalDescto. AsCurrency;

   FreteNota:= Truncar((qryPedidostotalpedido.AsCurrency * qryPedidosFreteNota.AsCurrency) / 100, 2);
   FreteCTR := Truncar((qryPedidostotalpedido.AsCurrency * qryPedidosFreteCTR. AsCurrency) / 100, 2);
   qryPedidostotalpedido.AsCurrency:= qryPedidostotalpedido.AsCurrency + FreteNota + FreteCTR;
end;


procedure TdtmCadastroPedidos.CalcularPrevisoes;
var
  Pos: TBookmark;
begin
   dsrPrevisoesPedidos.OnDataChange := nil;
   Pos:= qryPrevisoesPedidos.GetBookmark;
   qryPrevisoesPedidos.DisableControls;
   try
      qryPrevisoesPedidos.First;
      while not qryPrevisoesPedidos.Eof do begin
         qryPrevisoesPedidos.Edit;
         qryPrevisoesPedidosData.AsDateTime:= SomarDia(qryPedidosDataBase.AsDateTime,
                                                       qryPrevisoesPedidosDias.AsInteger,'N');
         qryPrevisoesPedidosValor.AsFloat:= Truncar((qryPedidostotalpedido.AsFloat *
                                                        qryPrevisoesPedidosPercentual.AsFloat) / 100,
                                                     ParSistema.PrecoUnitarioCasasDecimais);
         qryPrevisoesPedidos.Post;
         qryPrevisoesPedidos.Next;
      end;
   finally
     qryPrevisoesPedidos.GotoBookmark(Pos);
     qryPrevisoesPedidos.FreeBookmark(Pos);
     qryPrevisoesPedidos.EnableControls;
   end;
   dsrPrevisoesPedidos.OnDataChange:= dsrPrevisoesPedidosDataChange;
end;


constructor TdtmCadastroPedidos.Create(AOwner: TComponent);
begin
  inherited;
  tipoGrade := tpLINHA;
  qryPedidos.Tag                        := ctTabelas;
  qryProdutosPedidos.Tag                := ctTabelas;
  qryPrevisoesPedidos.Tag               := ctTabelas;
  qryDocumentosPag.Tag                  := ctTabelas;
  qryDuplicatas.Tag                     := ctTabelas;
  qryContatosFornecedores.Tag           := ctTabelas;
  qryConsultaPedidos.Tag                := ctProcuraPedidos;
  qryConsultaFornecedores.Tag           := ctProcuraFornecedores;
  qryConsultaFornecedorTransportes.Tag  := ctProcuraFornecedorTransporte;
  qryConsultaFiliais.Tag                := ctProcuraFiliais;
  qryConsultaProdutos.Tag               := ctProcuraProdutos;
  qryConsultaEstados.Tag                := ctProcuraEstados;
  FValorUnitarioProduto                 := 0;
  FValorLiquidoProduto                  := 0;
  FValorIPIProduto                      := 0;
  FValorUnitarioAnterior                := 0;
  FValorUnitarioAnterior                := 0;
  FValorIPIAnterior                     := 0;
  FCancelarInclusaoProduto              := True;
  FPermitirCalcularPreco                := True;
  FPermitirAlterarFornecedor            := False;
  qryProdutosPedidos.Params[0].AsString := EstadoFilialBase;
  qryProcuraProdutos.Parambyname('UFDestino').AsString := EstadoFilialBase;

  qryProdutosPedidosquantidade.DisplayFormat    := ParSistema.MascaraQuantidadeGrade;
  qryProdutosPedidostotalrecebido.DisplayFormat := ParSistema.MascaraQuantidadeGrade;

  qryProdutosSimilaresemestoque.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosSimilaresreservado.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosSimilarespedido.DisplayFormat    := ParSistema.MascaraQuantidadeGrade;

  LinhasColunas[codigo] := TStringList.Create;
  LinhasColunas[ValorLinhaColuna] := TStringList.Create;
  LinhasColunas[ValorLinha] := TStringList.Create;
  LinhasColunas[ValorColuna] := TStringList.Create;

  FProdutoAnterior := '';

end;


procedure TdtmCadastroPedidos.DefinirConsultaProdutos(Editando: Boolean);
var
  Campos   : String;
  Produto  : Int64;
  Pos      : TBookmark;
begin
  Campos := '';
  Produto:= qryProdutosPedidosproduto.AsLargeInt;
  Pos:= qryProdutosPedidos.GetBookmark;
  try
    qryProdutosPedidos.DisableControls;
    qryProdutosPedidos.First;
    while not qryProdutosPedidos.Eof do begin
      if not Editando then
        Campos := Campos + '' + qryProdutosPedidosproduto.AsString + ','
      else if (qryProdutosPedidosproduto.AsLargeInt <> Produto) then
        Campos := Campos + '' + qryProdutosPedidosproduto.AsString + ',';
      qryProdutosPedidos.Next;
    end;
  finally
    qryProdutosPedidos.EnableControls;
    qryProdutosPedidos.GotoBookmark(Pos);
    qryProdutosPedidos.FreeBookmark(Pos);
    Delete(Campos,Length(Campos),1);
    if Campos = '' then Campos:= '0';
  end;
  SelecionarProdutos(False);

  qryProcuraProdutos.MacroByName('SQLItensjacadastrados').AsString := Format('and (p.codigo not in (%s))',[Campos]);
  qryConsultaProdutos.MacroByName('SQLItensjacadastrados').AsString:= Format('and (p.codigo not in (%s))',[Campos]);

  qryProcuraProdutos.Parambyname('UFOrigem').AsString := qryProcuraFornecedoresestado.AsString;
  qryProcuraProdutos.Parambyname('UFDestino').AsString := EstadoFilialBase;
  qryProcuraProdutos.Parambyname('TipoPessoa').AsString := 'J';

  qryConsultaProdutos.Parambyname('UFOrigem').AsString := qryProcuraFornecedoresestado.AsString;
  qryConsultaProdutos.Parambyname('UFDestino').AsString := EstadoFilialBase;
  qryConsultaProdutos.Parambyname('TipoPessoa').AsString := 'J';


  if Editando and (Produto <> 0) then begin
    qryConsultaProdutos.MacroByName('SQLInativos').AsString := 'and ((p.codigo = ' + IntToStr(Produto) + ') or (p.inativo is null) or (p.inativo > ' + QuotedStr(DateTimeToStr(DataServidor))+'))';
    qryProcuraProdutos.MacroByName('SQLInativos').AsString := 'and ((p.codigo = ' + IntToStr(Produto) + ') or (p.inativo is null) or (p.inativo > ' + QuotedStr(DateTimeToStr(DataServidor))+'))';
  end
  else begin
    qryConsultaProdutos.MacroByName('SQLInativos').AsString:= 'and ((p.inativo is null) or (p.inativo > ' + QuotedStr(DateTimeToStr(DataServidor)) + '))';
    qryProcuraProdutos.MacroByName('SQLInativos').AsString := 'and ((p.inativo is null) or (p.inativo > ' + QuotedStr(DateTimeToStr(DataServidor)) + '))';
  end;
end;

procedure TdtmCadastroPedidos.dsrPedidosDataChange(Sender: TObject; Field: TField);
begin
  inherited;
  if Field = qryPedidosfornecedor then
    RefazConsultaContatos;

  if not qryProdutosPedidos.IsEmpty then
    if Field = qryPedidosfornecedor then begin
      if ((qryPedidosfornecedor.AsInteger <> FFornecedorAnterior) and (FPermitirAlterarFornecedor = False)) then
        if MensagemConfirmacao(format(ctTROCAFORNECEDORPEDIDO,['fornecedor'])) = smbOk then
          ExcluirProdutoPedido(True)
        else begin
          qryPedidosfornecedor.AsInteger:= FFornecedorAnterior;
          qryPedidos.Cancel;
          qryPedidos.Edit;
        end;
    end;
    if (Field = qryPedidosdesconto1)  or (Field = qryPedidosdesconto2)   or
       (Field = qryPedidosdesconto3)  or (Field = qryPedidosdesconto4)   or
       (Field = qryPedidosacrescimo1) or (Field = qryPedidosacrescimo2)  or
       (Field = qryPedidosacrescimo3) or (Field = qryPedidosacrescimo4)  or
       (Field = qryPedidosfretectr)   or (Field = qryPedidosfretenota)   then begin
       CalcularAcrescimoDesconto;
       ReCalcularPrevisoes;
    end;
    if (Field = qryPedidosfornecedortransporte) then begin
      if qryPedidosfornecedortransporte.AsInteger = 0 then begin
        qryPedidosfretenota.Clear;
        qryPedidosfretectr.Clear;
        CalcularAcrescimoDesconto;
      end;
    end;
    if (Field = qryPedidosdatabase) then
      CalcularPrevisoes;
    if Field = qryPedidosfilialentrega then
      qryProcuraProdutos.Parambyname('filialbase').AsInteger := qryPedidosfilialentrega.AsInteger;
{
    if (Field = qryPedidostotaldescto) or
       (Field = qryPedidostotalacresc) then
      ReCalcularPrevisoes;
}
end;

procedure TdtmCadastroPedidos.dsrPrevisoesPedidosDataChange(Sender: TObject; Field: TField);
begin
   inherited;
   dsrPrevisoesPedidos.OnDataChange := nil;
   if (Field = qryPrevisoesPedidosdias) or
      (Field = qryPrevisoesPedidospercentual) then begin
      qryPrevisoesPedidosdata.AsDateTime := SomarDia(qryPedidosdatabase.AsDateTime,
                                                     qryPrevisoesPedidosdias.AsInteger,'N');
      qryPrevisoesPedidosValor.AsFloat:= Truncar((qryPedidostotalpedido.AsFloat *
                                                     qryPrevisoesPedidosPercentual.AsFloat) / 100,
                                                  ParSistema.PrecoUnitarioCasasDecimais);
   end;
   dsrPrevisoesPedidos.OnDataChange  := dsrPrevisoesPedidosDataChange;
end;


procedure TdtmCadastroPedidos.ExcluirDocumentosPag;
begin
  ReFazConsulta(qryDocumentosPag,[0],[qryPedidosnumero.AsInteger]);
  if not qryDocumentosPag.IsEmpty then begin
    ReFazConsulta(qryDuplicatas,[0],[qryDocumentosPagnumero.AsInteger]);
    if not qryDuplicatas.IsEmpty then begin

      while not qryDuplicatas.Eof do
        qryDuplicatas.Delete;

      qryDocumentosPag.Delete;
    end;
  end;
end;

function TdtmCadastroPedidos.ExcluirPedido: Boolean;
begin
  Result := False;
  if PodeExcluirAlterarPedido then begin
    if MensagemConfirmacao(Format(ctCONFIRMEEXCLUIR, ['o PEDIDO'])) = smbOk then begin
      if not qryPedidos.IsEmpty then begin
        ExcluirDocumentosPag;

        qryPedidos.Delete;
        Perpetrar([qryDuplicatas, qryDocumentosPag,
                   qryProdutosPedidos, qryPrevisoesPedidos, qryPedidos]);
        Result := True;
      end;
    end
  end
  else
    MensagemAviso(ctPEDIDONAOPODEXCLUIR);
end;

function TdtmCadastroPedidos.ExcluirPrevisaoPedido: Boolean;
begin
  Result := False;
  if not qryPrevisoesPedidos.IsEmpty then
  begin
    if MensagemConfirmacao(Format(ctCONFIRMEEXCLUIR, ['a PREVISÃO'])) = smbOk then
    begin
      qryPrevisoesPedidos.Delete;
      Result := True;
    end;
  end;
end;

function TdtmCadastroPedidos.ExcluirProdutoPedido(HouveTrocaFornecedor: Boolean): Boolean;
begin
  Result := False;
  if dsrProdutosPedidos.DataSet = qryProdutosPedidos then
  begin
    if not qryProdutosPedidos.IsEmpty then begin
      if not HouveTrocaFornecedor then begin
        if MensagemConfirmacao(Format(ctCONFIRMEEXCLUIR, ['o PRODUTO'])) = smbOk then begin
          qryProdutosPedidos.Delete;
          Result := True;
        end;
      end
      else begin
        try
          qryProdutosPedidos.DisableControls;
          qryProdutosPedidos.First;
          while not qryProdutosPedidos.IsEmpty do
            qryProdutosPedidos.Delete;
        finally
          qryProdutosPedidos.EnableControls;
        end;
      end;
    end
  end
  else
  begin
    dsrGrade.OnDataChange := nil;
    qrygrade.Edit;
    case tipoGrade of
     tpLINHA : qryGrade.Fields[colunas.IndexOf(qryCopiaProdutosPedidosvalorgrade2.AsString)+1].asinteger := 0;
     tpCOLUNA : qryGrade.Fields[colunas.IndexOf(qryCopiaProdutosPedidosvalorgrade1.AsString)+1].asinteger := 0;
    end;
    qrygrade.Post;
    qryCopiaProdutosPedidos.Edit;
    qryCopiaProdutosPedidosquantidade.AsCurrency := 0;
    qryCopiaProdutosPedidos.DisableControls;
    qryCopiaProdutosPedidos.post;
    qryCopiaProdutosPedidos.EnableControls;
    CalcularTotalGrade;
    dsrGrade.OnDataChange := dsrGradeDataChange;
    qrygrade.Edit;
    result := true;
  end;
end;

function TdtmCadastroPedidos.ExisteEstado(campo, codigo: String): Boolean;
begin
  Result := ExisteCodigo(qryConsultaEstados, campo, codigo);
end;

function TdtmCadastroPedidos.ExisteFilial(campo, codigo: String): Boolean;
begin
  Result := ExisteCodigo(qryConsultaFiliais, campo, codigo);
end;

function TdtmCadastroPedidos.ExisteFornecedor(campo, codigo: String): Boolean;
begin
  Result := ExisteCodigo(qryConsultaFornecedores, campo, codigo);
end;

function TdtmCadastroPedidos.ExistePedido(campo, codigo: String): Boolean;
const
  SQL = 'and (to_ascii(%s,''latin1'') ilike to_ascii(''%s%s'',''latin1''))';
begin
  if (Campo <> 'valorpedido') then begin
    if (campo = 'emissao') then
         qryConsultaPedidos.sql[12] := 'and (cast(to_char(emissao,''dd/mm/yyyy'') as varchar) ilike to_ascii(''' + codigo + '%'',''latin1''))'
    else qryConsultaPedidos.sql[12] := Format(SQL, [Campo, Codigo, '%']);
  end;
  Abre(ctProcuraPedidos);
  Result:= not qryConsultaPedidos.IsEmpty;
end;

function TdtmCadastroPedidos.ExisteProduto(campo, codigo: String): Boolean;
const
  SQLProduto1 = 'and (to_ascii(p.%s,''latin1'') ilike to_ascii(''%s%s'',''latin1''))';
  SQLProduto2 = 'and (p.%s = %s)';
  SQLPreco = 'and (to_ascii(pr.%s,''latin1'') ilike to_ascii(''%s%s'',''latin1''))';
  SQLProdutoipi = 'and (i.%s = %s)';
  SQLProdutoicms = 'and (c.icms in (select e.icms from estadosicms e where e.estado = :estado and e.valor = %s))';

begin
  if FTodosProdutos then
  begin
    if campo = 'descricaopreco' then
      qryConsultaProdutos.MacroByName('SQLProdutos').AsString:= Format(SQLPreco, ['descricao', Codigo, '%'])
    else
    if campo = 'preco' then
      qryConsultaProdutos.MacroByName('SQLProdutos').AsString:= Format(SQLProduto2, [Campo, Codigo])
    else
    if campo = 'ipi' then
      qryConsultaProdutos.MacroByName('SQLProdutos').AsString:= Format(SQLProdutoipi, ['aliquota', Codigo])
    else
    if campo = 'icms' then
      qryConsultaProdutos.MacroByName('SQLProdutos').AsString:= Format(SQLProdutoicms, [Codigo])
    else
      qryConsultaProdutos.MacroByName('SQLProdutos').AsString:= Format(SQLProduto1, [Campo, Codigo, '%']);

    qryConsultaProdutos.close;
    qryConsultaProdutos.Open;
    Result := (qryConsultaProdutos.RecordCount > 0);
  end
  else
    Result := ExisteCodigo(qryConsultaProdutos, campo, codigo);

end;

function TdtmCadastroPedidos.ExisteFornecedorTransporte(campo, codigo: String): Boolean;
begin
    Result := ExisteCodigo(qryConsultaFornecedorTransportes, campo, codigo);
end;

procedure TdtmCadastroPedidos.FechaTabelaPesquisa(TipoPesquisa: TtecPedidosCompra);
begin
  case TipoPesquisa of
           pcoPEDIDO: Fecha(ctProcuraPedidos);
    pcoFORNECEDORTRANSPORTE: Fecha(ctProcuraFornecedorTransporte);
       pcoFORNECEDOR: Fecha(ctProcuraFornecedores);
    pcoFILIALFATURA,
   pcoFILIALENTREGA,
   pcoFILIALCOBRANCA: Fecha(ctProcuraFiliais);
          pcoPRODUTO: Fecha(ctProcuraProdutos);
  end;
end;

procedure TdtmCadastroPedidos.GerarDocumentosPag;
begin
  qryDocumentosPag.Insert;
  spcDocumentosPagProximo.Open;
  qryDocumentosPagnumero.AsInteger:= spcDocumentosPagProximocodigo.AsInteger;
  spcDocumentosPagProximo.Close;
  qryDocumentosPagfornecedor.AsInteger   := qryPedidosfornecedor.AsInteger;
  qryDocumentosPagtipofornecedor.AsString:= 'F';
  qryDocumentosPagemissao.AsDateTime     := qryPedidosemissao.AsDateTime;
  qryDocumentosPagdatalancto.AsDateTime  := qryPedidosemissao.AsDateTime;
  qryDocumentosPagfilialemissao.AsInteger:= qryPedidosfilialfatura.AsInteger;
  qryDocumentosPagprevisao.AsBoolean     := True;
  qryDocumentosPagvalor.AsCurrency          := qryPedidostotalpedido.AsCurrency;
  qryDocumentosPagpedido.AsInteger       := qryPedidosnumero.AsInteger;
  qryDocumentosPag.Post;

  qryPrevisoesPedidos.First;
  while not qryPrevisoesPedidos.Eof do begin
    qryDuplicatas.Insert;
    qryDuplicatasdocumentopag.AsInteger:= qryDocumentosPagnumero.AsInteger;
    qryDuplicatasdatavencto.AsDateTime := qryPrevisoesPedidosdata.AsDateTime;
    qryDuplicatasnumero.AsInteger:= qryPrevisoesPedidos.recno;
    qryDuplicatasvalorvencto.AsFloat   := qryPrevisoesPedidosvalor.AsFloat;
    qryDuplicatas.Post;
    qryPrevisoesPedidos.Next;
  end;
end;

