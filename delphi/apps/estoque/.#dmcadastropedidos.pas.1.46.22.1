function TdtmCadastroPedidos.PosicionarLinhaColunanoProduto(
  Coluna: String): boolean;
begin
  result := false;
  if qryProdutos.Active then
  begin
    if (Coluna <> '') and (qrygrade.fields[0].asstring <> '') then
    begin
      case tipoGrade of
       tpLINHA : result := qryProdutos.Locate('valorgrade1;valorgrade2', VarArrayOf([qrygrade.fields[0].asstring,Coluna]),[]);
       tpCOLUNA : result := qryProdutos.Locate('valorgrade1;valorgrade2', VarArrayOf([Coluna,qrygrade.fields[0].asstring]),[]);
      end;
    end
    else
    if (Coluna <> '') then
       result := qryprodutos.Locate('valorgrade2', Coluna,[])
    else
    if (qrygrade.fields[0].asstring <> '') then
       result := qryprodutos.Locate('valorgrade1', qrygrade.fields[0].asstring,[]);
  end;
end;

procedure TdtmCadastroPedidos.qryGradeAfterScroll(DataSet: TDataSet);
var
 I, index : integer;
begin
  inherited;
  for I:=1 to dataset.FieldCount-11 do
  begin
   case tipograde of
    tpLINHA : Index := LInhasColunas[ValorLinhaColuna].indexof(qrygrade.Fields[0].AsString+Colunas.Strings[I-1]);
    tpCOLUNA : Index := LInhasColunas[ValorLinhaColuna].indexof(Colunas.Strings[I-1]+qrygrade.Fields[0].AsString);
   end;
   qrygrade.Fields[I].ReadOnly := Index=-1;
  end;
  dataset.FieldByName('preco').ReadOnly    := dataset.FieldByName('precodiferente').AsBoolean;
  dataset.FieldByName('desconto').ReadOnly := dataset.FieldByName('descontodiferente').AsBoolean;
  dataset.FieldByName('valoricms').ReadOnly     := dataset.FieldByName('icmsdiferente').AsBoolean;
  dataset.FieldByName('valoripi').ReadOnly      := dataset.FieldByName('ipidiferente').AsBoolean;
end;

