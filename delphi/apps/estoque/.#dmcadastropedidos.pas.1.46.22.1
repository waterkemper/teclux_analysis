procedure TdtmCadastroPedidos.GerarTabelaGrade;
const
SQLColunaGrade = 'cast(null as integer) as %s';
Var
 SQLGrade, Linhas : TStringList;
 I,J,Index, Produto : Integer;
 Preco, desconto, icms, ipi, quantidade : Currency;
 PrecoDiferente, ICMSdiferente, IPIdiferente, Descontodiferente, achou : Boolean;
 RegistroAtual: TBookMark;
begin
 SQLGrade := TStringList.Create;
 Colunas :=  TStringList.Create;
 Linhas := TStringList.Create;
 Colunas.Duplicates := dupIgnore;
 Linhas.Duplicates := dupIgnore;
 Colunas.Sorted := True;
 Linhas.Sorted := True;

 qryProcuraProdutos.MacroByName('SQLListas').AsString := '';
 qryProcuraProdutos.MacroByName('SQLfornecedorgrupo').AsString := '';
 qryProcuraProdutos.MacroByName('SQLInativos').AsString := '';

 if not qrygrade.Active then
  ReFazConsulta(qryProdutos,[0],[qryProdutosPedidoscaracteristica.AsVariant]);
 SQLGrade.Append('Select cast(null as varchar) as LinhaColuna,');

 case tipoGrade of
  tpLINHA : begin
             Colunas.AddStrings(LinhasColunas[ValorColuna]);
             Linhas.AddStrings(LinhasColunas[ValorLinha]);
            end;
  tpCOLUNA :begin
             Colunas.AddStrings(LinhasColunas[ValorLinha]);
             Linhas.AddStrings(LinhasColunas[ValorColuna]);
            end;
  end;

  if (Colunas.Count >0) then
  begin
    for I:=0 to colunas.Count -1 do
     SQLGrade.append(format(SQLColunaGrade,['_'+inttostr(I)+',']));
  end
  else
    SQLGrade.append(format(SQLColunaGrade,['_'+inttostr(0)+',']));

 SQLGrade.append('cast(null as numeric(9,3)) as quantidade,');
 SQLGrade.append('cast(null as numeric) as preco,');
 SQLGrade.append('false as precodiferente,');
 SQLGrade.append('cast(null as numeric) as desconto,');
 SQLGrade.append('false as descontodiferente,');
 SQLGrade.append('cast(null as numeric) as valoricms,');
 SQLGrade.append('false as icmsdiferente,');
 SQLGrade.append('cast(null as numeric) as valoripi,');
 SQLGrade.append('false as ipidiferente,');
 SQLGrade.append('cast(null as numeric) as total');
 if not qryCopiaProdutosPedidos.Active then
   CopiarProdutosPedidos;
 RegistroAtual := qryCopiaProdutosPedidos.GetBookmark;
 qryGrade.Free;
 qryGrade:= TtecQuery.Create(Nil);
 qryGrade.Database := dtmTecSoft.Database;
 qryGrade.SQL := SQLGrade;
 qryGrade.CachedUpdates := true;
 qrygrade.RequestLive := true;
 dsrGrade.OnDataChange := nil;
 qrygrade.AfterScroll := nil;
 PodeInserirnaGrade := True;
 qryGrade.Open;
 qryGrade.Delete;
 qrygrade.FieldByName('quantidade').ReadOnly := true;
 qrygrade.FieldByName('quantidade').DisplayLabel :='QtD. TOTAL';
 qrygrade.FieldByName('preco').DisplayLabel :='PREÇO UNIT.';
 qrygrade.FieldByName('precodiferente').Visible := false;
 qrygrade.FieldByName('desconto').DisplayLabel :='DESC.(%)';
 qrygrade.FieldByName('descontodiferente').Visible := false;
 qrygrade.FieldByName('valoricms').DisplayLabel :='ICMS (%)';
 qrygrade.FieldByName('icmsdiferente').Visible := false;
 qrygrade.FieldByName('valoripi').DisplayLabel :='IPI (%)';
 qrygrade.FieldByName('ipidiferente').visible := false;

 qrygrade.FieldByName('total').ReadOnly := true;
 qrygrade.FieldByName('total').DisplayLabel :='PREÇO TOTAL';

 for I:=0 to Linhas.Count -1 do
 begin
  qryGrade.Append;
  qrygrade.Fields[0].AsString := Linhas.Strings[I];
  if I=0 then
  begin
    qrygrade.Fields[0].DisplayLabel := LinhadaGrade+'/'+ColunadaGrade;
    qrygrade.Fields[0].DisplayWidth := length(LinhadaGrade+'/'+ColunadaGrade);
    qrygrade.Fields[0].Alignment := taCenter;
  end;
  quantidade := 0;
  preco := 0;
  desconto := 0;
  icms := 0;
  ipi := 0;

  PrecoDiferente := false;
  Descontodiferente := false;
  ICMSdiferente := false;
  IPIdiferente := false;
  achou := false;

  for J:=0 to Colunas.count-1 do
  begin
   case tipoGrade of
     tpLINHA : Index := LInhasColunas[ValorLinhaColuna].indexof(Linhas.Strings[I]+Colunas.Strings[J]);
     tpCOLUNA : Index := LInhasColunas[ValorLinhaColuna].indexof(Colunas.Strings[J]+Linhas.Strings[I]);
   end;
   if Index<>-1 then
   begin
    produto := strtoint(LinhasColunas[codigo].Strings[Index]);
    if qryCopiaProdutosPedidos.Locate('produto',produto,[]) then
    begin
     qrygrade.Fields[J+1].Ascurrency := qryCopiaProdutosPedidosquantidade.AsCurrency;
     quantidade := quantidade + qryCopiaProdutosPedidosquantidade.AsCurrency;

     if (preco<>qryCopiaProdutosPedidospreco.AsCurrency) and ((preco<>0) or achou) then
       PrecoDiferente := true;
     if qryCopiaProdutosPedidospreco.AsCurrency<>0 then
       Preco := qryCopiaProdutosPedidospreco.AsCurrency;

     if (desconto<>qryCopiaProdutosPedidosdesconto.AsCurrency) and ((desconto<>0) or achou)  then
       Descontodiferente := true;
     if qryCopiaProdutosPedidosdesconto.AsCurrency<>0 then
       desconto := qryCopiaProdutosPedidosdesconto.AsCurrency;

     if (icms<>qryCopiaProdutosPedidosvaloricms.AsCurrency) and ((icms<>0) or achou) then
       ICMSdiferente := true;
     if qryCopiaProdutosPedidosvaloricms.AsCurrency<>0 then
       icms := qryCopiaProdutosPedidosvaloricms.AsCurrency;

     if (ipi<>qryCopiaProdutosPedidosvaloripi.AsCurrency) and ((ipi<>0) or achou) then
       IPIdiferente := true;
     if qryCopiaProdutosPedidosvaloripi.AsCurrency<>0 then
       ipi := qrycopiaProdutosPedidosvaloripi.AsCurrency;
     achou := true;
    end;
   end;
   if I=0 then
   begin
     qrygrade.Fields[J+1].DisplayLabel :=  ' '+Colunas.Strings[J]+' ';
     if length(Colunas.Strings[J])=0 then
       qrygrade.Fields[J+1].DisplayWidth := 12
     else
       qrygrade.Fields[J+1].DisplayWidth := length(Colunas.Strings[J])+2;
     qrygrade.Fields[J+1].Alignment := taRightJustify;
   end;
  end;
  qrygrade.FieldByName('quantidade').AsCurrency := quantidade;
  qrygrade.FieldByName('preco').AsCurrency := preco;
  qrygrade.FieldByName('precodiferente').Asboolean := precodiferente;
  qrygrade.FieldByName('desconto').AsCurrency := desconto;
  qrygrade.FieldByName('descontodiferente').Asboolean := Descontodiferente;
  qrygrade.FieldByName('valoricms').AsCurrency := icms;
  qrygrade.FieldByName('icmsdiferente').AsBoolean := ICMSdiferente;
  qrygrade.FieldByName('valoripi').AsCurrency := ipi;
  qrygrade.FieldByName('ipidiferente').AsBoolean := IPIdiferente;
  CalcularTotalGrade;
  qryGrade.Post;
 end;
 dsrGrade.DataSet := qryGrade;
 PodeInserirnaGrade := False;
 qryCopiaProdutosPedidos.GotoBookmark(RegistroAtual);
 qryCopiaProdutosPedidos.FreeBookmark(RegistroAtual);
 PosicionarLinhanaGrade;
 dsrGrade.OnDataChange := dsrGradeDataChange;
 qryGrade.AfterScroll := qryGradeAfterScroll;
 qrygrade.BeforeInsert := qryGradeBeforeInsert;
 qryGradeAfterScroll(qrygrade);
 SQLGrade.Free;
end;

procedure TdtmCadastroPedidos.qryProdutosAfterOpen(DataSet: TDataSet);
begin
  inherited;
  if UtilizandoGrade then
  begin
    LinhasColunas[Codigo].Clear;
    LInhasColunas[ValorLinhaColuna].Clear;
    LinhasColunas[ValorLinha].Clear;
    LinhasColunas[ValorColuna].Clear;
    qryprodutos.First;
    While not qryprodutos.Eof do
    begin
      LinhasColunas[codigo].Add(qryProdutoscodigo.AsString);
      LinhasColunas[ValorLinhaColuna].Add(qryProdutosvalorgrade1.AsString+qryProdutosvalorgrade2.AsString);
      LinhasColunas[ValorLinha].Add(qryProdutosvalorgrade1.AsString);
      LinhasColunas[ValorColuna].Add(qryProdutosvalorgrade2.AsString);
      qryprodutos.Next;
    end;
    if qryGrade.Active then
     qryGrade.Close;
  end;
end;

function TdtmCadastroPedidos.UtilizandoGrade: Boolean;
begin
 result := ParSistema.UsarGradesProdutos and
           ((qryProdutosPedidosvalorgrade1.AsString<>'') or
            (qryProdutosPedidosvalorgrade2.AsString<>''))
end;

