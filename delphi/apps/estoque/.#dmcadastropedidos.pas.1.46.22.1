{
function TdtmCadastroPedidos.GetValorProduto: Currency;
var PrecoLiquido,
    PrecoTotal,
    ValorIPI:  Currency;
begin
   PrecoLiquido:= Truncar((qryProdutosPedidosPreco.AsCurrency * (100 - qryProdutosPedidosDesconto.AsCurrency)) / 100,
                  ParSistema.PrecoUnitarioCasasDecimais);
   PrecoTotal  := Truncar(qryProdutosPedidosQuantidade.AsCurrency * PrecoLiquido,
                  ParSistema.PrecoUnitarioCasasDecimais);
   ValorIPI    := Truncar((PrecoTotal * qryProdutosPedidosaliquotaIpi.AsCurrency) / 100, 2);
   Result      := PrecoTotal + ValorIPI;

   FValorUnitarioProduto := PrecoLiquido;
   FValorLiquidoProduto  := PrecoTotal;
   FValorIPIProduto      := ValorIPI;
end;
}

