procedure TdtmCadastroPedidos.AtualizarCodigoFiscalProdutos;
begin
  try
    CalculodeImpostosBloqueado := True;
    DesabilitarControles(true);

    qryProdutosPedidos.first;
    while not qryProdutosPedidos.eof do
    begin
      { Descrição naturezapadrao em branco: já tem o código da natureza
        natureza nil só vai trocar o codigo fiscal em relação a UF
      }

      qryProdutosPedidos.edit;
      SelecionarDadosNaturezaPadrao('', nil,  qryProdutosPedidos, qryPedidos, CadastroPedidos);
      qryProdutosPedidos.next;
    end;

  finally
    CalculodeImpostosBloqueado := False;
    DesabilitarControles(false);
  end;
end;

procedure TdtmCadastroPedidos.AtribuirDadosCalculosImpostos_;
begin
  try
    CalculodeImpostosBloqueado := True;
    DesabilitarControles(true);

    qryProdutosPedidos.first;
    while not qryProdutosPedidos.eof do
    begin
      qryProdutosPedidos.edit;
      AtribuirDadosCalculosImpostos(qryPedidos, qryProdutosPedidos, nil, qryProdutosPedidos,
                             CadastroPedidos, true);
      SelecionarDadosNaturezaPadrao('', nil,  qryProdutosPedidos, qryPedidos, CadastroPedidos);                       

      qryProdutosPedidos.next;
    end;

  finally
    CalculodeImpostosBloqueado := False;
    DesabilitarControles(false);
  end;
end;

