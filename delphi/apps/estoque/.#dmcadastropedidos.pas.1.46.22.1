procedure TdtmCadastroPedidos.ExcluirDocumentosPag;
begin
  ReFazConsulta(qryDocumentosPag,[0],[qryPedidosnumero.AsInteger]);
  if not qryDocumentosPag.IsEmpty then begin
    ReFazConsulta(qryDuplicatas,[0],[qryDocumentosPagnumero.AsInteger]);
    if not qryDuplicatas.IsEmpty then begin

      while not qryDuplicatas.Eof do
        qryDuplicatas.Delete;

      qryDocumentosPag.Delete;
    end;
  end;
end;

function TdtmCadastroPedidos.ExcluirPedido: Boolean;
var
  vRetorno : TModalResult;

  function ExcluirPedido: Boolean;
  begin
      if not qryPedidos.IsEmpty then
      begin
        ExcluirDocumentosPag;
        qryPedidos.Delete;
        result := Perpetrar([qryDuplicatas, qryDocumentosPag,
                   qryProdutosPedidos, qryPrevisoesPedidos, qryPedidos]);
      end;
  end;

  function CancelarPedido: Boolean;
  begin
    if not qryPedidos.IsEmpty then
    begin
      ExcluirDocumentosPag;

      qryPedidos.Edit;
      if qryPedidossituacao.AsString = 'P' then
      begin
        qryPedidossituacao.AsString := 'Q';
        qryPedidosdescricaosituacao.asString := 'PARCIAL LIQUIDADO';
        qryPedidosdescricaosituacao_.asString := 'PARCIAL LIQUIDADA';
      end
      else
      begin
        qryPedidossituacao.AsString   := 'C';
        qryPedidosdescricaosituacao.asString := 'CANCELADO';
        qryPedidosdescricaosituacao_.asString := 'CANCELADA';
      end;
      qryPedidoscancelado.AsDateTime:= DataServidor;
//          qryPedidosmotivo.AsInteger    := qryMotivoscodigo.AsInteger;
      qryPedidos.Post;

      result := Perpetrar([qryDuplicatas, qryDocumentosPag,
                 qryProdutosPedidos, qryPrevisoesPedidos, qryPedidos]);
    end;
  end;

begin
  Result := false;
  if (qryPedidossituacao.asString = 'L') then
     MensagemAviso(ctPEDIDONAOPODEXCLUIR)
  else
  if (qryPedidossituacao.asString = 'C') then
    MensagemAviso('O pedido não pode ser excluído. O mesmo já foi cancelado.')
  else
  if (qryPedidossituacao.asString = 'Q') then
    MensagemAviso('O pedido não pode ser excluído. O mesmo já foi cancelado ficando Parcial Liquidado.')
  else
  if (qryPedidossituacao.asString = 'P') then
  begin
    if MensagemConfirmacao('O pedido está Parcial. Confirma o cancelamento do pedido?') = smbOk then
      result := CancelarPedido
  end
  else
  begin
    vRetorno := MensagemSimNaoOpcaoCancelar('Confirma a Exclusão ou o Cancelamento deste pedido?', '', true, 'Exclusão', 'Cancelamento');
    if vRetorno = mrYES then
      result := ExcluirPedido
    else
    if vRetorno = mrNO then
      result := CancelarPedido;
  end;

end;

function TdtmCadastroPedidos.ExcluirPrevisaoPedido: Boolean;
begin
  Result := False;
  if not qryPrevisoesPedidos.IsEmpty then
  begin
    if MensagemConfirmacao(Format(ctCONFIRMEEXCLUIR, ['a PREVISÃO'])) = smbOk then
    begin
      qryPrevisoesPedidos.Delete;
      Result := True;
    end;
  end;
end;

function TdtmCadastroPedidos.ExcluirProdutoPedido(HouveTrocaFornecedor: Boolean): Boolean;
begin
  Result := False;
  if dsrProdutosPedidos.DataSet = qryProdutosPedidos then
  begin
    if not qryProdutosPedidos.IsEmpty then
    begin
      if not HouveTrocaFornecedor then
      begin
        if MensagemConfirmacao(Format(ctCONFIRMEEXCLUIR, ['o PRODUTO'])) = smbOk then begin
          qryProdutosPedidos.Delete;
          Result := True;
        end;
      end
      else
      begin
        try
          qryProdutosPedidos.DisableControls;
          qryProdutosPedidos.First;
          while not qryProdutosPedidos.IsEmpty do
            qryProdutosPedidos.Delete;
        finally
          qryProdutosPedidos.EnableControls;
        end;
      end;
      CalcularImpostos(false,true);
      CalcularPrevisoes;
    end;
  end
  else
  begin
    dsrGrade.OnDataChange := nil;
    qrygrade.Edit;
    case tipoGrade of
     tpLINHA : qryGrade.Fields[colunas.IndexOf(qryCopiaProdutosPedidosvalorgrade2.AsString)+1].asinteger := 0;
     tpCOLUNA : qryGrade.Fields[colunas.IndexOf(qryCopiaProdutosPedidosvalorgrade1.AsString)+1].asinteger := 0;
    end;
    qrygrade.Post;
    qryCopiaProdutosPedidos.Edit;
    qryCopiaProdutosPedidosquantidade.AsCurrency := 0;
    qryCopiaProdutosPedidos.DisableControls;
    qryCopiaProdutosPedidos.post;
    qryCopiaProdutosPedidos.EnableControls;
    CalcularTotalGrade;
    dsrGrade.OnDataChange := dsrGradeDataChange;
    qrygrade.Edit;
    result := true;
  end;
end;

