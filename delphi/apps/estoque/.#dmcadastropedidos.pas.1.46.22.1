      qryFornecedorProdutofornecedor.AsInteger     := qryPedidosFornecedor.AsInteger;
      qryFornecedorProduto.Post
    end
  end;
end;


procedure TdtmCadastroPedidos.dsrProdutosPedidosDataChange(Sender: TObject; Field: TField);
var
  Qtdade: Currency;
begin
  inherited;

  if (field = qryProdutosPedidos.FieldByName('fatorconversao')) then
  begin
    if field.AsCurrency = 0 then
    begin
      MensagemErro('O Fator de conversão deve ser maior do que zero');
      field.AsFloat := vFatorConversaoPNPAntesEditar;
    end
    else
      qryProdutosPedidos.FieldByName('qtdeestoque').asFloat := qryProdutosPedidos.FieldByName('quantidade').AsFloat * qryProdutosPedidos.FieldByName('fatorconversao').AsFloat;
  end;

  if field = qryProdutosPedidosqtdeestoque then
  begin
    if (field.AsCurrency = 0) then
    begin
      MensagemErro('A quantidade em estoque deve ser maior do que zero');
      field.AsCurrency := vQtdeEstoquePNPAntesEditar;
    end;
  end;

  {

  if (field = qryProdutosPedidosprodutovisual) and (qryProcuraProdutoNotaFiscalproduto.AsLargeInt<>0) then
    qryProdutosPedidosproduto.AsLargeInt   := qryProcuraProdutoNotaFiscalproduto.AsLargeInt;
  }

  if (field = qryProdutosPedidosprecodigitado) then
  begin
    dsrProdutosPedidos.OnDataChange := nil;
    qryProdutosPedidosprecodigitadoalterado.AsBoolean :=
      qryProdutosPedidosprecodigitado.AsCurrency <>
      qryProdutosPedidosprecoatribuido.AsCurrency;

    AtribuirPreco(qryProdutosPedidoscaracteristica.AsString,
                  qryProdutosPedidospreco.AsInteger,
                  qryProdutosPedidoscustoparavenda.AsCurrency,
                  qryProdutosPedidosprecodigitado.AsCurrency,
                  false,
                  qryProdutosPedidosprecodigitado);

    CalcularImpostos(true,true);

    dsrProdutosPedidos.OnDataChange := dsrProdutosPedidosDataChange;
  end;

  if (field = qryProdutosPedidos.FieldByName('quantidade')) then
  begin
    dsrProdutosPedidos.OnDataChange := nil;

    if qryProdutosPedidos.FieldByName('TotalRecebido').AsFloat >
      qryProdutosPedidos.FieldByName('quantidade').AsFloat then
    begin
      MensagemAviso(format('A quantidade do pedido não pode ser inferior à recebida!'+chr(13)+'Quantidade: %s ' + chr(13) +'Recebida: %s ' + chr(13) +
       'O sistema retornará o valor anterior.', [qryProdutosPedidos.FieldByName('quantidade').AsString, qryProdutosPedidos.FieldByName('TotalRecebido').AsString ]));
      qryProdutosPedidos.FieldByName('quantidade').AsFloat := fQuantidadeAntesdeAlterar;
       
    end
    else
    begin
      qryProdutosPedidos.FieldByName('qtdeestoque').AsFloat := qryProdutosPedidos.FieldByName('quantidade').AsFloat * qryProdutosPedidos.FieldByName('fatorconversao').AsFloat;
      CalcularImpostos(true,true);
    end;

    dsrProdutosPedidos.OnDataChange := dsrProdutosPedidosDataChange;
  end;

  if (field = qryProdutosPedidos.FieldByName('preco')) then
  begin
    dsrProdutosPedidos.OnDataChange := nil;
    CalcularImpostos(true,true);
    dsrProdutosPedidos.OnDataChange := dsrProdutosPedidosDataChange;
  end;


  if (field = qryProdutosPedidos.FieldByName('percentualreducaobase')) then
    if (qryProdutosPedidos.FieldByName('percentualreducaobase').Value <> Null) then
    begin
      qryProdutosPedidos.FieldByName('valoricmsdigitado').AsBoolean := true;
