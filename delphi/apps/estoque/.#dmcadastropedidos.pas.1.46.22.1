  case TipoPesquisa of
                pcoPEDIDO: begin

                             qryPedidos.close;
                             qryPedidos.ParamByName('numero').asInteger := qryConsultaPedidosnumero.AsInteger;
                             qryPedidos.MacroByName('CondicaoListaNumeroPedidos').AsString := '';
