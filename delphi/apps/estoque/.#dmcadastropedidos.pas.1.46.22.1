procedure TdtmCadastroPedidos.qryProdutosPedidosCalcFields(
  DataSet: TDataSet);
begin
  inherited;

  qryProdutosPedidosdescricaoLC.AsString := TRIM(qryProdutosPedidosdescricaoproduto.AsString + ' ' +
                                            qryProdutosPedidosvalorgrade1.AsString + ' ' +
                                            qryProdutosPedidosvalorgrade2.AsString);

  if (qryPedidosdescricaosituacao.asstring='') or (qryProdutosPedidosquantidade.AsCurrency=0) then
    qryProdutosPedidosSituacao.AsString:='A'
  else
  if ((qryProdutosPedidosTotalRecebido.AsCurrency >=
       qryProdutosPedidosquantidade.AsCurrency) and
       (qryPedidosSituacao.AsString<>'C')) then

     qryProdutosPedidosSituacao.AsString := 'L'
  else
  if (qryProdutosPedidosTotalRecebido.AsCurrency = 0) and  ((qryPedidosDescricaoSituacao.AsString ='PARCIAL') or (qryPedidosDescricaoSituacao.AsString='ABERTO')) then
     qryProdutosPedidosSituacao.AsString := 'A'
  else
  if (qryProdutosPedidosTotalRecebido.AsCurrency = 0) and  ((qryPedidosDescricaoSituacao.AsString ='PARCIAL LIQUIDADO') OR (qryPedidosDescricaoSituacao.AsString ='CANCELADO')) then
     qryProdutosPedidosSituacao.AsString := 'C'
  else
  if (qryProdutosPedidosquantidade.AsCurrency > qryProdutosPedidosTotalRecebido.AsCurrency) and (qryProdutosPedidosTotalRecebido.AsCurrency>0) then
  begin
     if (qryPedidossituacao.asstring='Q') then
       qryProdutosPedidossituacao.AsString:='Q'
     else
       qryProdutosPedidosSituacao.AsString := 'P'
  end;


  if qryProdutosPedidoscodigofiscal.AsInteger - (qryProdutosPedidoscodigofiscal.AsInteger mod 1000) = 3000 then
    qryProdutosPedidosTotalQuantidadeXprecounitario.AsFloat := RoundTo(
                  (qryProdutosPedidospreco.asFloat *
                    qryProdutosPedidosquantidade.AsFloat), -2)
  else
    qryProdutosPedidosTotalQuantidadeXprecounitario.AsFloat := RoundTo(
                  (qryProdutosPedidospreco.AsCurrency *
                    qryProdutosPedidosquantidade.AsFloat), -2);

  qryProdutosPedidosTotalLiquido.asfloat := qryProdutosPedidosTotalQuantidadeXprecounitario.AsFloat -
                                               qryProdutosPedidosdesconto.AsFloat -
                                               qryProdutosPedidosvalordescontoitem.AsFloat;

  qryProdutosPedidosTotalProdutoMaisIPI.AsCurrency :=
    qryProdutosPedidosTotalLiquido.asfloat +
    qryProdutosPedidosFrete.asFloat +
    qryProdutosPedidosvaloripi.AsCurrency;


  if qryProdutosPedidosprecoatual.asFloat <> 0 then
    qryProdutosPedidospercAtual_x_Venda.asFloat := (qryProdutosPedidosprecovenda.asFloat * 100 / qryProdutosPedidosprecoatual.asFloat) - 100
  else
    qryProdutosPedidospercAtual_x_Venda.asFloat := 0;

  if qryProdutosPedidosprecovenda.asFloat <> 0 then
    qryProdutosPedidospercVenda_x_Digitado.asFloat := (qryProdutosPedidosprecodigitado.asFloat * 100 / qryProdutosPedidosprecovenda.asFloat) - 100
  else
    qryProdutosPedidospercVenda_x_Digitado.asFloat := 0;

{ if qryProdutosPedidosprecounitariopedido.asFloat <> 0 then}
{   qryProdutosPedidospercUnitario_x_Pedido.asFloat := ((qryProdutosPedidosprecounitario.asFloat/qryProdutosPedidosfatorconversao.asfloat) * 100 / qryProdutosPedidosprecounitariopedido.asFloat) -100}
{ else
    qryProdutosPedidospercUnitario_x_Pedido.asFloat := 0;}


  qryProdutosPedidosdescontogeral.asCurrency := qryProdutosPedidosdesconto.AsFloat +
                                               qryProdutosPedidosvalordescontoitem.AsFloat;
    

end;

procedure TdtmCadastroPedidos.ImprimirRelatorio;
var
  Relatorio: TfrReport;
  frmPreview: TfrmPreviewPadrao;
begin
  vVisualizarProdutosFornecedores := true;
  frVariables['TITULO'] := 'ORDEM DE COMPRA';
  frVariables['OBSERVACAO_RODAPE'] := ParSistema.ObservacaoRodapePedidos;

  if (qryProdutosPedidos.RecordCount >= 58) and (qryprodutospedidos.RecordCount <= 68) then
    frVariables['QuantidadeProdutos'] := 1
  else
    frVariables['QuantidadeProdutos'] := 0;

//  frpRelatorioPedidos.DesignReport;
  frmPreview := TfrmPreviewPadrao.create(self);
  frmPreview.cmbZoom.ItemIndex := 3;
  try
   Relatorio := frmPreview.frCompositeReport;
   with frmPreview do
   begin
     frmPreview.frCompositeReport.Reports.Clear;
     frmPreview.frCompositeReport.Reports.Add(frpRelatorioPedidos);
   end;
   Relatorio.Preview := frmPreview.frPreviewPadrao;
   Relatorio.ShowReport;
   frmPreview.ShowModal;
  finally
   frmPreview.Free;
   vVisualizarProdutosFornecedores := false;
  end;
end;

