procedure TdtmCadastroPedidos.setProcurarPorFornecedor(
  const Value: Boolean);

const

  PorGrupoFornecedor =  'and (c.codigo in (Select fp.caracteristica ' +
                                          'From  fornecedoresprodutos fp, fornecedores f ' +
                                          'Where (fp.fornecedor = f.codigo) and ' +
                                          '      (f.grupofornecedor = %s )))';

  PorGrupoFornecedor_P =  'and ((c.codigo in (Select fp.caracteristica ' +
                                          'From  fornecedoresprodutos fp, fornecedores f ' +
                                          'Where (fp.fornecedor = f.codigo) and ' +
                                          '      (f.grupofornecedor = %s ))) or p.codigo = :produto)';


  PorFornecedor = 'and (c.codigo in (Select fp.caracteristica ' +
                                          'From  fornecedoresprodutos fp ' +
                                          'Where (fp.fornecedor = %s )))';

  PorFornecedor_P = 'and ((c.codigo in (Select fp.caracteristica ' +
                                          'From  fornecedoresprodutos fp ' +
                                          'Where (fp.fornecedor = %s ))) or p.codigo = :produto)';

begin

  fProcurarPorFornecedor := Value;

  if fProcurarPorFornecedor then
  begin
    if qryProcuraFornecedoresgrupo.AsInteger > 0 then
    begin
      qryProcuraProdutos.MacroByName('SQLfornecedorgrupo').AsString  := format(PorGrupoFornecedor_p, [inttostr(qryProcuraFornecedoresgrupo.AsInteger)]);
      qryConsultaProdutos.MacroByName('SQLfornecedorgrupo').AsString := format(PorGrupoFornecedor, [inttostr(qryProcuraFornecedoresgrupo.AsInteger)]);
    end
    else
    begin
      qryProcuraProdutos.MacroByName('SQLfornecedorgrupo').AsString := format(PorFornecedor_p, [inttostr(qryProcuraFornecedorescodigo.AsInteger)]);
      qryConsultaProdutos.MacroByName('SQLfornecedorgrupo').AsString := format(PorFornecedor, [inttostr(qryProcuraFornecedorescodigo.AsInteger)]);
    end
  end
  else
  begin
    qryProcuraProdutos.MacroByName('SQLfornecedorgrupo').AsString := '';
    qryConsultaProdutos.MacroByName('SQLfornecedorgrupo').AsString := '';
  end;

end;


