{
procedure TdtmCadastroPedidos.CalcularPrecoSugestao;
var Markup,
    PIS,
    Cofins,
    ValorICMS,
    ValorRatear,
    Preco,
    PrecoIPI,
    PrecoVenda,
    ValorCusto: Currency;


    procedure ArredondarPrecoProduto;
    Var Mult: Currency;
    begin
       Mult:= 0;
       ReFazConsulta(qryMultiplosProduto,[0],[qryProdutosPedidoscaracteristica.AsLargeint]);
       if not qryMultiplosProduto.IsEmpty then begin
          if qryMultiplosProdutomultiplo.AsCurrency > 0
          then Mult:= Multiplo(PrecoVenda, qryMultiplosProdutomultiplo.AsCurrency)
          else if (qryMultiplosProdutomultiplo_grupo.AsCurrency > 0)
               then Mult:= Multiplo(PrecoVenda, qryMultiplosProdutomultiplo_grupo.AsCurrency)
               else if (qryMultiplosProdutomultiplo_classe.AsCurrency > 0)
                    then Mult:= Multiplo(PrecoVenda, qryMultiplosProdutomultiplo_classe.AsCurrency)
       end;

       if (Mult = 0) and (ParSistema.MultiploPreco > 0)
       then Mult:= Multiplo(PrecoVenda, ParSistema.MultiploPreco);

       if Mult > 0 then PrecoVenda := Mult;
    end;


begin
   if ParSistema.GerarPrecoAutomatico          and
     (qryProdutosPedidos.RecordCount > 0)      and
      FPermitirCalcularPreco                    and
      qryProdutosPedidosCalcularPreco.AsBoolean and
     (ParSistema.LocalCalculoPreco in [lcpPEDIDO, lcpAMBOS]) then begin

      if qryProdutosPedidosmarkupproduto.AsCurrency <> 0
      then Markup := qryProdutosPedidosmarkupproduto.AsCurrency
      else if qryProdutosPedidosmarkupgrupo.AsCurrency <> 0
           then Markup := qryProdutosPedidosmarkupgrupo.AsCurrency
           else if qryProcuraFornecedoresmarkup.AsCurrency <> 0
                then Markup := qryProcuraFornecedoresmarkup.AsCurrency
                else Markup := 0;

      if Markup > 0 then
      begin
         ValorRatear:= qryPedidosValorNotaCalculada.AsCurrency -
                       qryPedidostotalproduto.AsCurrency;

         Preco      := qryProdutosPedidospreco.AsCurrency -
                       qryProdutosPedidosdesconto.AsCurrency;
         Preco      := Preco +
                       ((Preco * ValorRatear) / qryPedidostotalproduto.AsCurrency);

         PrecoIPI   := Preco + (Preco * qryProdutosPedidosaliquotaipi.AsCurrency) / 100;

         if ParSistema.RetirarPISCONFINSCalPreco then
         begin
            PIS   := (PrecoIPI * qryProdutosPedidospisaliquota.AsCurrency) / 100;
            Cofins:= (PrecoIPI * qryProdutosPedidoscofinsaliquota.AsCurrency) / 100;
         end
         else
         begin
            PIS    := 0;
            Cofins := 0;
         end;

         if (qryPedidosregimetributario.asinteger <> 1) then //NAO E SIMPLES
           ValorICMS := (Preco * qryProdutosPedidosaliquotaicms.AsCurrency) /100
         else
           ValorICMS := 0;

         if qryPedidostotalproduto.AsCurrency > 0 then
           ValorCusto := PrecoIPI - ValorICMS - PIS - Cofins
         else
           ValorCusto := PrecoIPI;

         if ParSistema.SugestaoPeloPrecoVenda then
         begin
          if (qryPedidosregimetributario.asinteger <> 1) then //NAO E SIMPLES
          begin
            if ParSistema.RetirarPISCONFINSCalPreco then
               PrecoVenda := ValorCusto / (1 -
                            (Markup +
                             qryProdutosPedidosaliquotaicmscalculopreco.AsCurrency +
                             qryProdutosPedidospisaliquota.AsCurrency +
                             qryProdutosPedidoscofinsaliquota.AsCurrency) / 100)
            else
               PrecoVenda := ValorCusto / (1 -
                            (Markup +
                             qryProdutosPedidosaliquotaicmscalculopreco.AsCurrency) / 100);
          end
          else
            if ParSistema.RetirarPISCONFINSCalPreco then
               PrecoVenda := ValorCusto / (1 - Markup / 100);
         end
         else
         begin
           PrecoVenda := ValorCusto * (1 + Markup / 100);
           if (qryPedidosregimetributario.asinteger <> 1) then //NAO E SIMPLES
           begin
             if ParSistema.RetirarPISCONFINSCalPreco then
               PrecoVenda := (PrecoVenda / (1 - ((qryProdutosPedidosaliquotaicmscalculopreco.AsCurrency +
                                                          qryProdutosPedidospisaliquota.AsCurrency +
                                                          qryProdutosPedidoscofinsaliquota.AsCurrency) / 100)))
             else
               PrecoVenda := PrecoVenda / (1 - (qryProdutosPedidosaliquotaicmscalculopreco.AsCurrency / 100))
           end
           else
           if ParSistema.RetirarPISCONFINSCalPreco then
             PrecoVenda := PrecoVenda / (1 - ((qryProdutosPedidospisaliquota.AsCurrency +
                                                       qryProdutosPedidoscofinsaliquota.AsCurrency) / 100));
         end;

         ArredondarPrecoProduto;
         if qryProdutosPedidos.State in [dsEdit, dsInsert]
         then qryProdutosPedidosprecosugerido.AsCurrency := PrecoVenda;
      end;
   end;
end;


procedure TdtmCadastroPedidos.CalcularPrecoSugestaoProdutos;
var
  PosAnt: TBookmark;
begin
  if ParSistema.GerarPrecoAutomatico and FPermitirCalcularPreco then begin
    PosAnt := qryProdutosPedidos.GetBookmark;
    qryProdutosPedidos.DisableControls;
    try
      qryProdutosPedidos.First;
      while Not qryProdutosPedidos.Eof do begin
        qryProdutosPedidos.Edit;
        CalcularPrecoSugestao;
        qryProdutosPedidos.Next
      end;
      qryPedidos.Edit;
    finally
      qryProdutosPedidos.GotoBookmark(PosAnt);
      qryProdutosPedidos.FreeBookmark(PosAnt);
      qryProdutosPedidos.EnableControls;
    end
  end
end;
}

