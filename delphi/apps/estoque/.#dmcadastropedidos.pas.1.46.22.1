procedure TdtmCadastroPedidos.dsrGradeDataChange(Sender: TObject;
  Field: TField);
var
 quantidade: currency;
 I : integer;

  procedure GravarQuantidade;
  var
   Index : integer;
  begin
     case tipoGrade of
      tpLINHA : index := LinhasColunas[valorlinhacoluna].IndexOf(qrygrade.Fields[0].asstring+colunas.Strings[field.index-1]);
      tpCOLUNA: index := LinhasColunas[valorlinhacoluna].IndexOf(colunas.Strings[field.index-1]+qrygrade.Fields[0].asstring);
     end;
     if index<>-1 then
     begin
       if qryCopiaProdutosPedidos.Locate('produto', LinhasColunas[codigo].Strings[index],[]) then
       begin
           qryCopiaProdutosPedidos.Edit;
           qryCopiaProdutosPedidosquantidade.AsCurrency := field.AsCurrency;
           qryCopiaProdutosPedidos.DisableControls;
           qryCopiaProdutosPedidos.post;
           qryCopiaProdutosPedidos.EnableControls;
       end
       else
       begin
        if field.Asinteger<>0 then
        begin
          qryCopiaProdutosPedidos.append;
          ReFazConsulta(qryProcuraProdutos,[3],[LinhasColunas[codigo].Strings[index]]);
          qryCopiaProdutosPedidosproduto.AsString        := qryProcuraProdutosproduto.AsString;
          qryCopiaProdutosPedidoscaracteristica.AsString := qryProcuraProdutoscaracteristica.AsString;
          qryCopiaProdutosPedidosdescricao.AsString      := qryProcuraProdutosdescricao.AsString;
          qryCopiaProdutosPedidosdescricaocaracteristica.AsString      := qryProcuraProdutosdescricaocaracteristica.AsString;
          qryCopiaProdutosPedidosvalorgrade1.AsString    := qryProcuraProdutosvalorgrade1.AsString;
          qryCopiaProdutosPedidosvalorgrade2.AsString    := qryProcuraProdutosvalorgrade2.AsString;
          qryCopiaProdutosPedidoslinha.AsString          := qryProcuraProdutoslinha.AsString;
          qryCopiaProdutosPedidoscoluna.AsString         := qryProcuraProdutoscoluna.AsString;
          qryCopiaProdutosPedidosquantidade.AsCurrency    := field.AsInteger;
          qryCopiaProdutosPedidospreco.AsCurrency        := qrygrade.fieldbyname('preco').AsCurrency;
          qryCopiaProdutosPedidosdesconto.AsCurrency     := qrygrade.fieldbyname('desconto').AsCurrency;
          qryCopiaProdutosPedidosvaloricms.AsCurrency    := qrygrade.fieldbyname('valoricms').AsCurrency;
          qryCopiaProdutosPedidosvaloripi.AsCurrency     := qrygrade.fieldbyname('valoripi').AsCurrency;
          qryCopiaProdutosPedidosvalorproduto.AsCurrency := GetValorProdutoCopia;
          qryCopiaProdutosPedidos.DisableControls;
          qryCopiaProdutosPedidos.post;
          qryCopiaProdutosPedidos.EnableControls;
        end;
       end;
     end;
  end;

  procedure GravarCopiaProdutosPedidos(campo:String);
  var
   ok: Boolean;
  begin
    qryCopiaProdutosPedidos.First;
    while not qryCopiaProdutosPedidos.Eof do
    begin
      case tipograde of
       tpLINHA : ok := qrycopiaProdutosPedidos.Locate('valorgrade1', qrygrade.fields[0].asstring,[]);
       tpCOLUNA : ok := qrycopiaProdutosPedidos.Locate('valorgrade2', qrygrade.fields[0].asstring,[]);
      end;
      if ok then
      begin
        qryCopiaProdutosPedidos.Edit;
        qryCopiaProdutosPedidos.FieldByName(campo).AsString := qrygrade.FieldByName(campo).AsString;
        qryCopiaProdutosPedidos.DisableControls;
        qryCopiaProdutosPedidos.Post;
        qryCopiaProdutosPedidos.EnableControls;
      end;
      qryCopiaProdutosPedidos.Next;
    end;
  end;

begin
  inherited;
  dsrGrade.OnDataChange := nil;
  quantidade := 0;
  if (field <> qrygrade.FieldByName('preco')) and
     (field <> qrygrade.FieldByName('quantidade')) and
     (field <> qrygrade.FieldByName('desconto')) and
     (field <> qrygrade.FieldByName('valoricms')) and
     (field <> qrygrade.FieldByName('valoripi')) and
     (field <> qrygrade.FieldByName('total')) and
     (field <> nil) then
  begin
   GravarQuantidade;
   for I:=1 to qrygrade.FieldCount-11 do
     quantidade := quantidade + qrygrade.Fields[I].AsCurrency;
   qrygrade.FieldByName('quantidade').AsCurrency := quantidade;
   CalcularTotalGrade;
  end
  else
  if (field = qrygrade.FieldByName('preco')) and
     (field <> nil) then
  begin
   GravarCopiaProdutosPedidos('preco');
//   for I:=1 to qrygrade.FieldCount-11 do
//     quantidade := quantidade + qrygrade.Fields[I].AsInteger;
   CalcularTotalGrade;
  end
  else
  if (field = qrygrade.FieldByName('desconto')) and
     (field <> nil) then
  begin
    GravarCopiaProdutosPedidos('desconto');
    CalcularTotalGrade;
  end
  else
  if (field = qrygrade.FieldByName('valoricms')) and
     (field <> nil) then
  begin
    GravarCopiaProdutosPedidos('valoricms');
    CalcularTotalGrade;
  end
  else
  if (field = qrygrade.FieldByName('valoripi')) and
     (field <> nil) then
  begin
    GravarCopiaProdutosPedidos('valoripi');
    CalcularTotalGrade;
  end;
  dsrGrade.OnDataChange  := dsrGradeDataChange;
end;

