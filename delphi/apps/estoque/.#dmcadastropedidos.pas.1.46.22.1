procedure TdtmCadastroPedidos.AtualizarSituacaoPedido;
var
  vSituacoes : String;
begin
  vSituacoes := '';
  try

    qryprodutospedidos.GuardarRegistroAtual(true);

    qryprodutospedidos.first;
    while not qryprodutospedidos.eof do
    begin
      if pos(qryProdutosPedidossituacao.asString, vSituacoes)=0 then
        vSituacoes := vSituacoes + qryProdutosPedidossituacao.asString;
      qryprodutospedidos.next;
    end;

  finally
    qryprodutospedidos.VoltarRegistro;


    if ((pos('A', vSituacoes)<>0) and
        (pos('L', vSituacoes)<>0)) or
       (pos('P', vSituacoes)<>0) then
    begin
      qryPedidossituacao.AsString := 'P';
      qryPedidosdescricaosituacao.AsString := 'PARCIAL';
    end
    else
    if ((pos('A', vSituacoes)<>0) and
        (pos('L', vSituacoes)=0)) then
    begin
      qryPedidossituacao.AsString := 'A';
      qryPedidosdescricaosituacao.AsString := 'ABERTO';
    end
    else
    if ((pos('A', vSituacoes)=0) and
        (pos('L', vSituacoes)<>0)) then
    begin
      qryPedidossituacao.AsString := 'A';
      qryPedidosdescricaosituacao.AsString := 'CONCLUÍDO';
    end;

  end;

end;

