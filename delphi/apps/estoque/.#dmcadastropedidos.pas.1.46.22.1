function TdtmCadastroPedidos.CalcularImpostos(msgDifAliquotaICMS,
  ForcarRecalculo: boolean; AlteracaoEspecifica: tpAlteracaoEspecifica;
  VerificarAcertoCentavos: boolean): boolean;
begin
  if not CalculodeImpostosBloqueado then
    if {RecalcularImpostos or} ForcarRecalculo then
    begin
  //    qryProdutosPedidos.mastersource := nil;
      try
        qrypedidos.edit;
        qryProdutosPedidos.readonly := false;

        qryProdutosPedidos.GuardarRegistroAtual(true);
        cdsProdutosPedidos.close;
        cdsProdutosPedidos.open;
        qryProdutosPedidos.VoltarRegistro;

        dsrPedidos.onDataChange := nil;
        DesabilitarControles(true);


//        cdsProdutosPedidos.AggFields.FieldByName('TotalProdutos').AsFloat;

//        cdsProdutosPedidos.Aggregates.Find('TotalProdutos').Value;

        result := CalcularImpostos_(qryProdutosPedidos, qryPedidos, true, false, false,
        nil, nil, false, CadastroPedidos, false, true, nil, false, msgDifAliquotaICMS, false, AlteracaoEspecifica,
        VerificarAcertoCentavos, nil, cdsProdutosPedidos );

      finally
        AtualizarSituacaoPedido;
        dsrPedidos.onDataChange := dsrPedidosDataChange;
        DesabilitarControles(false);
      end;

      if result then
        ExecutadoCalculorImpostos := true
      else
        ExecutadoCalculorImpostos := false;
    end;

end;

procedure TdtmCadastroPedidos.DesabilitarControles(Desabilitar: Boolean);
begin
  if Desabilitar then
  begin
    qryProdutosPedidos.DisableControls;
    dsrProdutosPedidos.Enabled := false;
    qryProdutosPedidos.AfterScroll := nil;
    dsrProdutosPedidos.onDataChange := nil;
  end
  else
  begin
    qryProdutosPedidos.EnableControls;
    dsrProdutosPedidos.Enabled := true;    
    qryProdutosPedidos.AfterScroll := qryProdutosPedidosAfterScroll;
    dsrProdutosPedidos.onDataChange := dsrProdutosPedidosDataChange;
  end;

end;

procedure TdtmCadastroPedidos.AtribuirPreco(caracteristica: String;
  preco: integer; ValorCusto, precovenda: Currency;
  VerificarMaiorPreco: Boolean; CampoValorPreco: TField);
var
  RegistroAtual: TBookMark;
begin
    { Varrer a tabela de produtos da nota para atribuir o maior preço
      para as mesmas caracterisiticas e preços}

  if qryProdutosPedidos.Active and (caracteristica <> '') then
  begin


    try
      RegistroAtual := qryProdutosPedidos.GetBookmark;
      qryProdutosPedidos.DisableControls;
      DesabilitarControles(true);
      qryProdutosPedidos.First;

      while not qryProdutosPedidos.Eof do
      begin
        if (qryProdutosPedidoscaracteristica.AsString = caracteristica) and
           ((qryProdutosPedidoscustoparavenda.AsCurrency = ValorCusto) or
            ((qryProdutosPedidospreco.AsInteger = preco) and (preco<>0)))
            then
        begin
          if VerificarMaiorPreco then
          begin
            {esta situacao ocorre somente qdo calculado}
            if precovenda > CampoValorPreco.AsCurrency then
            begin

              qryProdutosPedidos.Edit;
              CampoValorPreco.AsCurrency := precovenda;


              if (qryPedidossituacao.AsString = 'P') or (qryPedidos.state = dsinsert) then
                if qryProdutosPedidoscalcularpreco.AsBoolean and
                   (not (ParSistema.NaoAtualizarPrecoMenorQueAtual and
                         (qryProdutosPedidosprecoatribuido.AsCurrency <
                          qryProdutosPedidosprecoatual.AsCurrency))) then
                begin
                  if qryProdutosPedidos.FieldByName('permitiratualizardigitado').IsNull then
                    qryProdutosPedidos.FieldByName('permitiratualizardigitado').AsBoolean := true
                  else
                  begin
                    if qryProdutosPedidos.FieldByName('permitiratualizar').AsBoolean =
                       qryProdutosPedidos.FieldByName('permitiratualizardigitado').AsBoolean then
                      qryProdutosPedidos.FieldByName('permitiratualizardigitado').AsBoolean := true;
                  end;

                  qryProdutosPedidos.FieldByName('permitiratualizar').AsBoolean := true;

                end
                else
                begin
                  if qryProdutosPedidos.FieldByName('permitiratualizardigitado').IsNull then
                    qryProdutosPedidos.FieldByName('permitiratualizardigitado').AsBoolean := false
                  else
                  begin
                    if qryProdutosPedidos.FieldByName('permitiratualizar').AsBoolean =
                       qryProdutosPedidos.FieldByName('permitiratualizardigitado').AsBoolean then
                      qryProdutosPedidos.FieldByName('permitiratualizardigitado').AsBoolean := false;
                  end;
                  qryProdutosPedidos.FieldByName('permitiratualizar').AsBoolean := false;
                end;

              if not qryProdutosPedidosprecodigitadoAlterado.asboolean then
                qryProdutosPedidosprecodigitado.AsCurrency := qryProdutosPedidosprecoatribuido.AsCurrency;
            end;

          end
          else
          begin
            {esta situacao ocorre somente qdo alterado}
            qryProdutosPedidos.Edit;
            CampoValorPreco.AsCurrency := precovenda;
            qryProdutosPedidosprecodigitadoalterado.AsBoolean := true;
          end
        end;
        qryProdutosPedidos.Next;
      end;
    finally

      qryProdutosPedidos.enableControls;
      qryProdutosPedidos.GotoBookmark(RegistroAtual);
      qryProdutosPedidos.FreeBookmark(RegistroAtual);
      DesabilitarControles(false);

    end;
  end;
end;

