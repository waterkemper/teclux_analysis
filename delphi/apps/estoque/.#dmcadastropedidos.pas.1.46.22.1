implementation
uses fmCadastroPedidos;


{$R *.dfm}


procedure ImprimirPedidos(vListaNumeroPedidos: String);
var
  Relatorio: TfrReport;
  frmPreview: TfrmPreviewPadrao;
  dtmCadastroPedidos: TdtmCadastroPedidos;
begin
  try

    dtmCadastroPedidos := TdtmCadastroPedidos.create(nil);
    with dtmCadastroPedidos do
    begin
      qryPedidos.close;
      qryPedidos.ParamByName('numero').asInteger := 0;
      qryPedidos.MacroByName('CondicaoListaNumeroPedidos').AsString := 'or p.numero in (' + vListaNumeroPedidos + ')';
      qryPedidos.open;

      vVisualizarProdutosFornecedores := true;
      frVariables['TITULO'] := 'ORDEM DE COMPRA';
      frVariables['OBSERVACAO_RODAPE'] := ParSistema.ObservacaoRodapePedidos;

      frmPreview := TfrmPreviewPadrao.create(nil);
      frmPreview.cmbZoom.ItemIndex := 3;
      try
        Relatorio := frmPreview.frCompositeReport;
        with frmPreview do
        begin
          frmPreview.frCompositeReport.Reports.Clear;
          frmPreview.frCompositeReport.Reports.Add(frpRelatorioPedidos);
        end;
        Relatorio.Preview := frmPreview.frPreviewPadrao;
        Relatorio.ShowReport;
        frmPreview.ShowModal;

//        frpRelatorioPedidos.DesignReport;

      finally
        frmPreview.Free;
        vVisualizarProdutosFornecedores := false;
      end;

    end;

  finally
    FreeAndNil(dtmCadastroPedidos);
  end;
end;


