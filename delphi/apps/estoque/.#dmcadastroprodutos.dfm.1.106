  object qryConsultaCaracteristicasProdutosClientes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryConsultaCaracteristicasProdutosAfterOpen
    OnFilterRecord = qryConsultaCaracteristicasProdutosClientesFilterRecord
    Filtered = True
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'SQLProdutos'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select c.descricao as descricaocaracteristica,'
      '       c.codigo as codigocaracteristica,'
      '       c.codigovisual as codigocaracteristicavisual,'
      '       p.codigo as codigoproduto,'
      '       p.codigovisual as codigoprodutovisual,'
      '       p.referencia as referencia,'
      '       p.descricao as descricaoproduto,'
      '       c.ipi,'
      '       i.classificacaofiscal,'
      '       c.peso,'
      '       cp.pn,'
      '       cp.cliente as CodigodoCliente,'
      '       cp.tipocliente,'
      '       vf.nome as NomedoCliente,'
      '       p.inativo'
      ''
      'From ((caracteristicas c'
      '       join (produtos p'
      '            left join (clientesprodutos cp'
      '                      join vfornecedores vf'
      '                      on cp.cliente = vf.codigo'
      '                      and cp.tipocliente = vf.tipo)'
      '            on p.codigo = cp.produto)'
      '       on p.caracteristica = c.codigo)'
      ''
      '      left join ipi i'
      '      on i.codigo=c.ipi)  '
      ''
      '%SQLProdutos'
      ''
      
        'Order by UPPER(TO_ASCII(p.descricao,'#39'LATIN1'#39')), p.codigo, UPPER(' +
        'TO_ASCII(p.referencia,'#39'LATIN1'#39')), c.codigo, UPPER(TO_ASCII(c.des' +
        'cricao,'#39'LATIN1'#39'))'
      ''
      '/*'
      ':ValordoParametro'
      '*/')
    RequestLive = False
    Left = 512
    Top = 512
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'ValordoParametro'
        ParamType = ptUnknown
      end>
    object qryConsultaCaracteristicasProdutosClientesnomedocliente: TStringField
      DisplayLabel = 'Nome do Cliente'
      DisplayWidth = 30
      FieldName = 'nomedocliente'
      Size = 50
    end
