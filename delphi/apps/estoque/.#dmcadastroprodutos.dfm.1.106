    Sql.Strings = (
      'Select '
      ' p.codigo, p.codigovisual,'
      ' p.descricao,'
      
        ' p.caracteristica,  (select c.codigovisual from caracteristicas ' +
        'c where c.codigo = p.caracteristica) as caracteristicavisual,'
      
        ' (select c.descricao from caracteristicas c where c.codigo = p.c' +
        'aracteristica) as descricaocaracteristica,'
      ' p.preco,'
      ' p.referencia,'
      ' p.valorgrade1,'
      ' p.valorgrade2,'
      ' p.inativo,'
      ' p.foralinha,'
      ' p.codigorecolha'
      'from produtos p'
      'where  '
      '%Produto')
