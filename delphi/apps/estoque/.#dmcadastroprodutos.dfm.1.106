  object qryEstoquesFiliais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Bloquear'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select e.produto,'
      '       e.filial,'
      '       f.nome as nomefilial,'
      '       e.localizacao,'
      '       nullif(e.emestoque,0) as emestoque,'
      '       nullif(e.reservado,0) as reservado,'
      '       nullif(e.transito,0) as transito,'
      '       nullif(e.demonstracao,0) as demonstracao,'
      '       nullif(e.conserto,0) as conserto,'
      '       nullif(e.futuro,0) as futuro,'
      '       nullif(e.danificada,0) as danificada,'
      '       nullif(e.estoquefisico,0) as estoquefisico,'
      '       nullif(e.reservaprevia,0) as reservaprevia,'
      '       nullif(e.emestoque,0) as saldopendente,'
      '       e.financeiro'
      ''
      'from estoques e'
      '     join filiais f'
      '     on e.filial = f.codigo'
      ''
      'where e.produto = :produto'
      '  and (coalesce(e.emestoque,0)<>0 or'
      '       coalesce(e.reservado,0)<>0 or'
      '       coalesce(e.transito,0)<>0 or'
      '       coalesce(e.demonstracao,0)<>0 or'
      '       coalesce(e.conserto,0)<>0 or'
      '       coalesce(e.futuro,0)<>0 or'
      '       coalesce(e.danificada,0)<>0 or'
      '       coalesce(e.estoquefisico,0)<>0 or'
      '       coalesce(e.reservaprevia,0)<>0)'
      ''
      'order by e.filial'
      ''
      '%Bloquear'
      '')
    RequestLive = True
    Left = 752
    Top = 576
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'produto'
        ParamType = ptUnknown
      end>
