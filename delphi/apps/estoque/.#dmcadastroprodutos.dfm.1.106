    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryCaracteristicasAfterOpen
    AfterClose = qryCaracteristicasAfterClose
    AfterInsert = qryCaracteristicasAfterInsert
    AfterEdit = qryCaracteristicasAfterEdit
    BeforePost = qryCaracteristicasBeforePost
    AfterScroll = qryCaracteristicasAfterScroll
    OnDeleteError = PostError
    OnEditError = PostError
    OnPostError = PostError
    OnNewRecord = qryCaracteristicasNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'CondicaoEspecificaJanelaPesquisa'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select *,'
      
        '       (select ti.valor from tributosicms ti where ti.codigo = c' +
        'aracteristicas.incidencia) as cst,'
      
        '       (select exists (select p.codigo from produtos p where p.c' +
        'aracteristica = caracteristicas.codigo and p.nlote is not null l' +
        'imit 1)) as ExisteLote'
      'From caracteristicas'
      'Where'
      ''
      
        '      ((upper(to_ascii(caracteristicas.codigovisual,'#39'latin1'#39')) =' +
        ' upper(to_ascii(:codigovisual,'#39'latin1'#39'))) or'
      ''
      '      (caracteristicas.codigo in (select p.caracteristica'
      
        '                                  from produtos p join produtosc' +
        'odigobarras pcb on p.codigo = pcb.produto'
      
        '                                  where pcb.codigobarras = :codi' +
        'govisual )) or'
      ''
      '      (caracteristicas.codigo in (select p.caracteristica'
      '                                  from produtos p'
      
        '                                  where p.codigovisual = :codigo' +
        'visual)))'
      
        '%CondicaoEspecificaJanelaPesquisa                               ' +
        '   '
      ''
      ''
      ''
      '')
    RequestLive = True
    Left = 40
    Top = 8
    ParamData = <
      item
        DataType = ftString
        Name = 'codigovisual'
        ParamType = ptUnknown
      end>
