    Sql.Strings = (
      'Select c.descricao as descricaocaracteristica,'
      '       c.codigo as codigocaracteristica,'
      '       c.codigovisual as codigocaracteristicavisual,'
      '       p.codigo as codigoproduto,'
      '       p.codigovisual as codigoprodutovisual,'
      '       p.referencia as referencia,'
      '       p.descricao as descricaoproduto,'
      '       c.ipi,'
      '       i.classificacaofiscal,'
      '       c.peso,'
      '       p.inativo'
      ''
      'From  caracteristicas c'
      '      join produtos p'
      '      on p.caracteristica = c.codigo'
      ''
      '      left join ipi i'
      '      on i.codigo=c.ipi'
      ''
      '%SQLProdutos'
      ''
      
        'Order by UPPER(TO_ASCII(p.descricao,'#39'LATIN1'#39')), p.codigo, UPPER(' +
        'TO_ASCII(p.referencia,'#39'LATIN1'#39')), c.codigo, UPPER(TO_ASCII(c.des' +
        'cricao,'#39'LATIN1'#39'))'
      ''
      '/*'
      ':ValordoParametro'
      '*/')
    RequestLive = False
