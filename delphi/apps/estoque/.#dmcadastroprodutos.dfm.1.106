  object qryProdutos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryProdutosAfterOpen
    AfterInsert = qryProdutosAfterInsert
    BeforeEdit = qryProdutosBeforeEdit
    AfterEdit = qryProdutosAfterInsert
    BeforeDelete = qryProdutosBeforeDelete
    AfterDelete = qryProdutosAfterDelete
    AfterScroll = qryProdutosAfterScroll
    OnCalcFields = qryProdutosCalcFields
    OnDeleteError = PostError
    OnEditError = PostError
    OnPostError = PostError
    OnNewRecord = qryProdutosNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select p.*,'
      ''
      '       (select pre.promocao'
      '        from precos pre'
      '        where pre.caracteristica = p.caracteristica'
      '          and pre.codigo = p.preco) as promocao,'
      ''
      '       (select pro.descricao'
      '        from precos pre'
      '             left join promocoes pro'
      '             on pre.promocao = pro.codigo'
      '        where pre.caracteristica = p.caracteristica'
      '          and pre.codigo = p.preco) as descricaopromocao,'
      ''
      '       pro.validade as validadepromocao,'
      ''
      
        '       coalesce((select sum(pc.quantidade * pc.preco) from produ' +
        'toscompostos pc where pc.composto = p.codigo),0)+'
      
        '       coalesce((select sum(ps.quantidade * ps.preco) from produ' +
        'tos_servicos ps where ps.produto = p.codigo),0) as TotalComponen' +
        'tes'
      ''
      'from produtos p'
      '     left join promocoes pro'
      '     on p.promocao = pro.codigo'
      ''
      'where p.caracteristica = :caracteristica'
      'order by p.valorgrade1, p.valorgrade2, p.codigovisual, p.codigo')
    RequestLive = True
    Left = 136
    Top = 8
    ParamData = <
      item
        DataType = ftString
        Name = 'caracteristica'
        ParamType = ptInput
      end>
