    Macros = <>
    Sql.Strings = (
      'select s.similar,'
      '       c.codigovisual as similarvisual,'
      '       s.caracteristica,'
      '       c.descricao'
      'from similares s join caracteristicas c on s.similar = c.codigo'
      'where s.caracteristica =:caracteristica'
      'order by s.similar')
    RequestLive = True
    Left = 136
    Top = 72
