  object qryConsultaCaracteristicas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryConsultaCaracteristicasAfterOpen
    OnFilterRecord = qryConsultaCaracteristicasFilterRecord
    Filtered = True
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'SQLProdutos'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select c.descricao as descricaocaracteristica,'
      '       c.codigo as codigocaracteristica,'
      '       c.codigovisual as codigocaracteristicavisual,'
      '       c.ipi,'
      '       i.classificacaofiscal,'
      '       c.peso,'
      '       c.inativo'
      ''
      'From  caracteristicas c'
      ''
      '      left join ipi i'
      '      on i.codigo=c.ipi'
      ''
      '%SQLProdutos'
      ''
      'Order by UPPER(TO_ASCII(c.descricao,'#39'LATIN1'#39')), c.codigo'
      ''
      ''
      '/*'
      ':ValordoParametro'
      '*/')
    RequestLive = True
    Left = 440
    Top = 481
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'ValordoParametro'
        ParamType = ptUnknown
      end>
