        '        where c.codigovisual = pcfi.componente) as resistividade' +
        ','
      '       (select c.tolerancia'
      '        from caracteristicas c'
      '        where c.codigovisual = pcfi.componente) as tolerancia'
      '       */ '
      ''
      'FROM produtoscompostosfios pcfi'
      'WHERE pcfi.composto = :composto'
      'order by pcfi.ordem'
      '')
    RequestLive = True
