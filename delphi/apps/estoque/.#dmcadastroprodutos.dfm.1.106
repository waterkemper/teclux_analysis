  object qryClientesProdutos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeDelete = qryClientesProdutosBeforeDelete
    AfterDelete = qryClientesProdutosAfterDelete
    AfterScroll = qryClientesProdutosAfterScroll
    OnNewRecord = qryClientesProdutosNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select cp.*,'
      '       cp.cliente as clienteaux,'
      '       cp.tipocliente as tipoclienteaux,'
      ''
      '       (select coalesce(razao,nome)'
      '        from vfornecedores'
      '        where codigo = cp.cliente'
      '          and tipo = cp.tipocliente) as nome,'
      ''
      '       cast((select p.codigovisual'
      '        from produtos p'
      
        '        where p.codigo = cp.produto) as varchar(30)) as produtov' +
        'isual,'
      ''
      '       cast((select p.codigovisual'
      '        from produtos p'
      
        '        where p.codigo = cp.embalagem_pri) as varchar(30)) as em' +
        'balagemvisual_pri,'
      ''
      '       cast((select p.codigovisual'
      '        from produtos p'
      
        '        where p.codigo = cp.embalagem_sec) as varchar(30)) as em' +
        'balagemvisual_sec,'
      ''
      '       cast((select p.codigovisual'
      '        from produtos p'
      
        '        where p.codigo = cp.embalagem_sec2) as varchar(30)) as e' +
        'mbalagemvisual_sec2,'
      ''
      '       cast((select p.codigovisual'
      '        from produtos p'
      
        '        where p.codigo = cp.embalagem_sec3) as varchar(30)) as e' +
        'mbalagemvisual_sec3,'
      ''
      '       cast((select p.codigovisual'
      '        from produtos p'
      
        '        where p.codigo = cp.embalagem_ter) as varchar(30)) as em' +
        'balagemvisual_ter,'
      ''
      '       cast((select p.codigovisual'
      '        from produtos p'
      
        '        where p.codigo = cp.tabuleiro_pri) as varchar(30)) as ta' +
        'buleirovisual_pri,'
      ''
      '       cast((select p.codigovisual'
      '        from produtos p'
      
        '        where p.codigo = cp.tabuleiro_sec) as varchar(30)) as ta' +
        'buleirovisual_sec,'
      ''
      '       cast((select p.codigovisual'
      '        from produtos p'
      
        '        where p.codigo = cp.tabuleiro_sec2) as varchar(30)) as t' +
        'abuleirovisual_sec2,'
      ''
      '       cast((select p.codigovisual'
      '        from produtos p'
      
        '        where p.codigo = cp.tabuleiro_sec3) as varchar(30)) as t' +
        'abuleirovisual_sec3,'
      ''
      '       cast((select p.codigovisual'
      '        from produtos p'
      
        '        where p.codigo = cp.tabuleiro_ter) as varchar(30)) as ta' +
        'buleirovisual_ter'
      ''
      'from clientesprodutos cp'
      'where produto = :produto')
    RequestLive = True
    Left = 40
    Top = 136
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'produto'
        ParamType = ptUnknown
      end>
