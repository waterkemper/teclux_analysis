    Sql.Strings = (
      'SELECT pcfi.composto,'
      '       pcfi.componente,'
      '       pcfi.ordem,'
      '       pcfi.sequencia,'
      '       pcfi.nrvoltas,'
      '       pcfi.gramasporpeca,'
      '       pcfi.bitola,'
      '       pcfi.liga,'
      '       pcfi.resistividade,'
      '       pcfi.tolerancia'
      ''
      '       /*'
      '       (select c.bitola'
      '        from caracteristicas c'
      '        where c.codigovisual = pcfi.componente) as bitola,'
      '       (select c.liga'
      '        from caracteristicas c'
      '        where c.codigovisual = pcfi.componente) as liga,'
      '       (select c.resistividade'
