      end>
    Sql.Strings = (
      'SELECT p.descricao,'
      '       p.codigo,'
      '       p.codigovisual,'
      '       p.referencia'
      'FROM produtos p'
      '     join caracteristicas c'
      '     on p.caracteristica = c.codigo'
      ''
      'WHERE p.caracteristica = c.codigo'
      '  and p.codigo NOT IN (SELECT componente'
      '                       FROM produtoscompostos'
      '                       WHERE composto = :composto)'
      ''
      '%CondicaoProduto'
      '                                      '
      'ORDER BY UPPER(TO_ASCII(p.descricao,'#39'LATIN1'#39'))')
    RequestLive = False
    Left = 896
    Top = 8
