    AfterInsert = qryProdutosLotesAfterInsert
    AfterPost = qryProdutosLotesAfterPost
    AfterDelete = qryProdutosLotesAfterDelete
    AfterScroll = qryProdutosLotesAfterScroll
    OnNewRecord = qryProdutosLotesNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select p.codigo,'
      '       p.codigovisual,'
      '       p.caracteristica,'
      '       p.descricao,'
      '       p.descricaoplanilhacusto,'
      '       p.preco,'
      '       p.referencia,'
      '       p.foralinha,'
      '       p.inativo,'
      '       p.codigorecolha,'
      '       p.valorgrade1,'
      '       p.valorgrade2,'
      '       p.data,'
      '       p.datacadastro,'
      '       p.nlote,'
      '       p.dval,'
      '       e.filial,'
      '       e.emestoque,'
      '/*       e.emestoque as quantidade*/'
      '       cast(null as numeric(13,2)) as quantidade'
      ''
      'from produtos p'
      '     join estoques e'
      '     on p.codigo = e.produto'
      ''
      'where p.codigo = :produto'
      '  and (coalesce(e.emestoque,0)<>0 or'
      '       coalesce(e.reservado,0)<>0 or'
