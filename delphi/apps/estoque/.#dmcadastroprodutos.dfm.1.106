    Sql.Strings = (
      'select pf.*,'
      
        '      (select vf.nome from vfornecedores vf where vf.codigo = pf' +
        '.fornecedor and vf.tipo = pf.tipofornecedor) as nomefornecedor,'
      
        '      (select p.codigovisual from produtos p where p.codigo = pf' +
        '.produto) as produtovisual'
      'from produtosfornecedores pf'
      'where pf.produto = :produto'
