  end
  else
  if field = qryClientesProdutosembalagemvisual_sec3 then
  begin
     if field.isnull then
       qryClientesProdutosembalagem_sec3.clear;
  end
  else
  if field = qryClientesProdutosembalagemvisual_ter then
  begin
     if field.isnull then
       qryClientesProdutosembalagem_ter.clear;
  end
  else
  if field = qryClientesProdutostabuleirovisual_pri then
  begin
     if field.isnull then
       qryClientesProdutostabuleiro_pri.clear;
  end
  else
  if field = qryClientesProdutostabuleirovisual_sec then
  begin
     if field.isnull then
       qryClientesProdutostabuleiro_sec.clear;
  end
  else
  if field = qryClientesProdutostabuleirovisual_sec2 then
  begin
     if field.isnull then
       qryClientesProdutostabuleiro_sec2.clear;
  end
  else
  if field = qryClientesProdutostabuleirovisual_sec3 then
  begin
     if field.isnull then
       qryClientesProdutostabuleiro_sec3.clear;
  end
  else
  if field = qryClientesProdutostabuleirovisual_ter then
  begin
     if field.isnull then
       qryClientesProdutostabuleiro_ter.clear;
  end;
end;

