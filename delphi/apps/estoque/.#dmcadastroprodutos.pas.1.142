      if not ((qryCaracteristicascst.asstring = '40') or
              (qryCaracteristicascst.asstring = '41') or
              (qryCaracteristicascst.asstring = '50') or
              (qryCaracteristicascst.asstring = '51')) then
      begin
        result := false;
