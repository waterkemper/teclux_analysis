procedure TdtmCadastroProdutos.qryConsultaCaracteristicasFilterRecord(
  DataSet: TDataSet; var Accept: Boolean);
begin
  inherited;
  if OpcaoInativoConsultaCaracteristicas = 'ATIVOS' then
    Accept := qryConsultaCaracteristicasinativo.IsNull or (qryConsultaCaracteristicasinativo.AsDateTime > DataServidor)
  else
  if OpcaoInativoConsultaCaracteristicas = 'INATIVOS' then
    Accept := not qryConsultaCaracteristicasinativo.IsNull and (qryConsultaCaracteristicasinativo.AsDateTime <= DataServidor)
  else
    Accept := true; 

end;

