procedure TdtmCadastroProdutos.ZMonitor1MonitorEvent(Sql, Result: String);
var
 Listar : TStringList;
begin
  inherited;
  Listar := tStringlist.create;
  if fileexists('c:\produtos.sql') then
    Listar.loadfromfile('c:\produtos.sql');
  Listar.add('');
  Listar.add(sql);
  Listar.add(result);
  listar.savetofile('c:\produtos.sql');
  listar.free;
end;

function TdtmCadastroProdutos.TotalComponentes: Real;
var
  Total : Real;
begin
  Total := 0;

  if not qryProdutoComposto.Active then
    ReFazConsulta(qryProdutoComposto,[0],[qryProdutoscodigo.AsLargeInt]);
  GuardarRegistroAtual(qryProdutoComposto,true);
  qryProdutoComposto.First;
  while not qryProdutoComposto.Eof do
  begin
    Total := Total + qryProdutoCompostototal.AsFloat;
    qryProdutoComposto.Next;
  end;
  VoltarRegistroAtual(qryProdutoComposto);


  if not qryProdutos_Servicos.Active then
    ReFazConsulta(qryProdutos_Servicos,[0],[qryProdutoscodigo.AsLargeInt]);
  GuardarRegistroAtual(qryProdutos_Servicos,true);
  qryProdutos_Servicos.First;
  while not qryProdutos_Servicos.Eof do
  begin
    Total := Total + qryProdutos_Servicostotal.AsFloat;
    qryProdutos_Servicos.Next;
  end;
  VoltarRegistroAtual(qryProdutos_Servicos);

  Result := Total;
  qryprodutostotalcomponentes.ascurrency := Total;
end;

procedure TdtmCadastroProdutos.AtualizarPrecoComposto;
begin
  qryAtualizarPrecoComposto.ParamByName('valor').Value  := TotalComponentes;
  qryAtualizarPrecoComposto.ParamByName('caracteristica').Value:= qryCaracteristicascodigo.AsLargeInt;
  qryAtualizarPrecoComposto.ParamByName('preco').Value  := qryProdutospreco.AsInteger;
//  qryAtualizarPrecoComposto.ParamByName('coluna').Value := PrecoNormal;

  qryAtualizarPrecoComposto.ExecSql;

  qryColunasPrecos.Refresh;
end;

