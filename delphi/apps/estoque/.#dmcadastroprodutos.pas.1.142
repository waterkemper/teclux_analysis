procedure TdtmCadastroProdutos.qryCaracteristicasNewRecord(DataSet: TDataSet);
begin
  inherited;
  qryCaracteristicasdata.AsDateTime := now();
  qryCaracteristicasorigem.AsInteger         := 0;

  qryCaracteristicasincidencia.AsInteger     := parsistema.ValorPadraoIncidencia; //1

  qryCaracteristicasmontagem.Value           := False;
  qryCaracteristicasbrinde.Value             := False;
  qryCaracteristicasemiteetiqueta.Value      := False;
  qryCaracteristicasemitecomplemento.Value   := False;
  qryCaracteristicastipocomissao.AsString    := '%';
  qryCaracteristicastipocomissaoindicador.AsString    := '%';

//  qryCaracteristicascomissao.AsFloat         := 0;
  qryCaracteristicasvendanegativa.AsString   := 'N';
  qryCaracteristicasvendanegativanosite.AsString   := 'N';

  qryCaracteristicasaliquotapis.AsFloat      := ParSistema.AliquotaPIS;
  qryCaracteristicasaliquotacofins.AsFloat   := ParSistema.AliquotaCofins;
  qryCaracteristicasicmsmodsubst.AsInteger   := parsistema.VAlorPadraoICMSModSubst; //4

  qryCaracteristicascomposto.AsBoolean := False;
  qryCaracteristicascomposto2.AsBoolean := False;
  qryCaracteristicasdiscriminarpreco.asboolean := False;
  qryCaracteristicasdesmembrarcomponente.AsBoolean := true;
  qryCaracteristicasdiscriminarcomposto.AsString := 'N';
  

  qryCaracteristicasicmsmodalidade.AsInteger := 3;
  if ParSistema.GerarContabilidade then
    AtribuirContasContabeisPadrao;


  qryCaracteristicasdatacadastro.asDatetime := dataServidor;

  qryCaracteristicasexigenumeroserie.asboolean := false;

  qryCaracteristicasagrupamentograde.asstring := 'L';
  qryCaracteristicasgerenciarloteevalidade.asBoolean := false;

  qryCaracteristicasconferircomposto.asBoolean := false;

  qryCaracteristicasdisponivel_sistema.asBoolean := True;
  qryCaracteristicasdisponivel_site.asBoolean := True;
  qryCaracteristicasdisponivel_marketplace.asBoolean := True;

end;

