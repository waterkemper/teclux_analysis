begin
  result := qryProcuraElementoColunaGradevalor.AsString;
end;

function TdtmCadastroProdutos.GetTabelaElementosColunaGrade: TtecQuery;
begin
 result := qryProcuraElementoColunaGrade;
end;

procedure TdtmCadastroProdutos.AlteraTabelaElementos;
var
 Index : integer;
begin
 Index := LinhasColunas[codigo].IndexOf(qryProdutoscodigo.asstring);
 if (index<>-1) then
 begin
  LinhasColunas[ValorLinhaColuna].Strings[Index] :=ProdutoLinhaGrade+ProdutoColunaGrade;
  LinhasColunas[ValorLinha].Strings[Index] :=ProdutoLinhaGrade;
  LinhasColunas[ValorColuna].Strings[Index] :=ProdutoColunaGrade;
 end;
 AbreTabelaElementos;
end;

procedure TdtmCadastroProdutos.IncluiTabelaElementos;
begin
  if UtilizandoGrade then
  begin
   LinhasColunas[codigo].Add(qryProdutoscodigo.AsString);
   LinhasColunas[ValorLinhaColuna].Add(qryProdutosvalorgrade1.AsString+
                                       qryProdutosvalorgrade2.AsString);
   LinhasColunas[ValorLinha].Add(qryProdutosvalorgrade1.AsString);
   LinhasColunas[ValorColuna].Add(qryProdutosvalorgrade2.AsString);
   if not AtualizandoItens then
     AbreTabelaElementos;
  end;
end;

procedure TdtmCadastroProdutos.ExcluiTabelaElementos;
Var
 Index : Integer;
begin
 Index := LinhasColunas[codigo].IndexOf(qryProdutoscodigo.asstring);
 LinhasColunas[codigo].Delete(Index);
 LinhasColunas[ValorLinhaColuna].Delete(Index);
 LinhasColunas[ValorLinha].Delete(Index);
 LinhasColunas[Valorcoluna].Delete(Index);
end;

function TdtmCadastroProdutos.GetProdutoLinhaGrade: String;
begin
 result := qryProdutosvalorgrade1.AsString;
end;

function TdtmCadastroProdutos.GetProdutoColunaGrade: String;
begin
 result := qryProdutosvalorgrade2.AsString;
end;

procedure TdtmCadastroProdutos.qryProdutosAfterInsert(DataSet: TDataSet);
begin
  inherited;
  if UtilizandoGrade and not AtualizandoItens then
    if not AbreTabelaElementos then
    begin
      qryprodutos.Cancel;
      AbreTabelaElementos;
    end;
end;

procedure TdtmCadastroProdutos.qryProdutosBeforeDelete(DataSet: TDataSet);
begin
  inherited;
  if UtilizandoGrade then
    ExcluiTabelaElementos;
end;

function TdtmCadastroProdutos.UtilizandoGrade: Boolean;
begin
 result := ParSistema.UsarGradesProdutos and
           ((qryCaracteristicasgrade1.AsString<>'') or
            (qryCaracteristicasgrade2.AsString<>''))
end;

procedure TdtmCadastroProdutos.GerarLinhasColunas;
begin
  if (qryCaracteristicasgrade1.AsString<>'') and
     (qryCaracteristicasgrade2.AsString<>'') then
  begin
    qryLinhaColunaGrade.First;
    while not qryLinhaColunaGrade.Eof do
    begin
      IncluirProduto(false);
      qryProdutosvalorgrade1.AsString := qryLinhaColunaGrade.Fields[0].AsString;
      qryProdutosvalorgrade2.AsString := qryLinhaColunaGrade.Fields[1].AsString;
      qryProdutospreco.AsString  := FcodigoPrecoGerar;
      qryProdutosdescricao.AsString := FDescricaoCaracteristicaGerar;
      GravarProduto;
      qryLinhaColunaGrade.Next
    end;
  end
  else
  if (qryCaracteristicasgrade1.AsString<>'') then
  begin
    qryLinhaColunaGrade.First;
    while not qryLinhaColunaGrade.Eof do
    begin
      IncluirProduto(false);
      qryProdutosvalorgrade1.AsString := qryLinhaColunaGrade.Fields[0].AsString;
      qryProdutospreco.AsString  := FcodigoPrecoGerar;
      qryProdutosdescricao.AsString := FDescricaoCaracteristicaGerar;
      GravarProduto;
      qryLinhaColunaGrade.Next
    end;
  end
  else
  if (qryCaracteristicasgrade2.AsString<>'') then
  begin
    qryLinhaColunaGrade.First;
    while not qryProcuraElementoColunaGrade.Eof do
    begin
      IncluirProduto(false);
      qryProdutosvalorgrade2.AsString := qryLinhaColunaGrade.Fields[0].AsString;
      qryProdutospreco.AsString  := FcodigoPrecoGerar;
      qryProdutosdescricao.AsString := FDescricaoCaracteristicaGerar;
      GravarProduto;
      qryLinhaColunaGrade.Next
    end;
  end;
end;

function TdtmCadastroProdutos.GetDescricaoCaracteristica: String;
begin
  result := qryCaracteristicasdescricao.asstring;
end;

procedure TdtmCadastroProdutos.AtribuirParametrosPrecos;
begin
  ReFazConsulta(qryProcuraPrecos,[],[]);
  qryProcuraPrecos.Params[0].AsString := IntToStr(qryCaracteristicascodigo.AsLargeInt);
  qryConsultaPrecos.Params[0].AsString:= IntToStr(qryCaracteristicascodigo.AsLargeInt);
end;

procedure TdtmCadastroProdutos.ReFazProcuraPrecos;
begin
 ReFazConsulta(qryProcuraPrecos,[0,1],[qryCaracteristicascodigo.AsVariant,
                                      qryConsultaPrecoscodigo.AsVariant]);
end;

