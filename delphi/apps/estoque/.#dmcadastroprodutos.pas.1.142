function TdtmCadastroProdutos.IncluirSimilarItemProdutos(
  Editar: Boolean): Boolean;

  (*
  procedure Produtos_Similares(Editando: Boolean);
  var
    Campos  : String;
    Similar : Int64;
    Pos     : TBookmark;
  begin
    Campos := qryProdutoscodigo.AsString + ',';
    Similar:= qryProdutos_Similaressimilar.AsLargeInt;

    Pos:= qryProdutos_Similares.GetBookmark;
    try
      qryProdutos_Similares.DisableControls;
      qryProdutos_Similares.First;
      while not qryProdutos_Similares.Eof do
      begin
        if (qryProdutos_Similaressimilar.AsLargeInt > 0) then
        begin
          if not Editando then
            Campos := Campos + '' + qryProdutos_Similaressimilar.AsString + ','
          else if (qryProdutos_Similaressimilar.AsLargeInt <> Similar) then
            Campos := Campos + '' + qryProdutos_Similaressimilar.AsString + ',';
        end;
        qryProdutos_Similares.Next;
      end;
    finally
      qryProdutos_Similares.EnableControls;
      qryProdutos_Similares.GotoBookmark(Pos);
      qryProdutos_Similares.FreeBookmark(Pos);
      Delete(Campos,Length(Campos),1);
    end;

//    vCondicaoProcuraSimilares  := Format('and not (codigo in (%s))', [Campos]);
//    vCondicaoConsultaSimilares := Format('and not (c.codigo in (%s))', [Campos]);

  end;

  *)

begin

  if qryProdutos_Similares.State in [dsEdit, dsInsert] then
    qryProdutos_Similares.Cancel;

  if Editar and not qryProdutos_Similares.IsEmpty then
  begin
//    Produtos_Similares(True);
    qryProdutos_Similares.DisableControls;
    qryProdutos_Similares.Edit;
    qryProdutos_Similares.Cancel;
    qryProdutos_Similares.EnableControls;
  end
  else
  begin
//    Produtos_Similares(False);
//    qryProdutos_Similares.Params[0].Clear;
    qryProdutos_Similares.Append;
  end;

  Result := True
end;

function TdtmCadastroProdutos.ExcluirSimilarItemProdutos: Boolean;
begin
  Result:= False;
  if not qryProdutos_Similares.isEmpty then begin
    if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o ITEM DE PRODUTO SIMILAR'])) = smbOk then
    begin
      qryProdutos_Similares.Delete;
      Result := True;
    end
  end

end;

procedure TdtmCadastroProdutos.qryProdutos_SimilaresAfterDelete(
  DataSet: TDataSet);
begin
  inherited;
  Perpetrar([qryProdutos_Similares]);
end;

