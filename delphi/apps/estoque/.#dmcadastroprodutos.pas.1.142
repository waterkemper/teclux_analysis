function TdtmCadastroProdutos.CadastroItemAutomatico: Boolean;
begin
  qryProdutos.Append;
  qryProdutoscaracteristica.AsLargeInt:= qryCaracteristicascodigo.AsLargeInt;
  qryProdutosdescricao.AsString       := qryCaracteristicasdescricao.AsString;
  qryProdutospreco.AsInteger          := qryPrecoscodigo.AsInteger;
  if ParSistema.GerarCodigoProdutoAutomatico then
  begin
    RefazConsulta(spcProdutoProximo,[0],[qryCaracteristicascodigo.AsLargeInt]);
    qryProdutoscodigo.AsLargeInt      := spcProdutoProximocodigo.AsLargeInt;
    qryProdutoscodigovisual.AsString := qryProdutoscodigo.AsString;
    spcProdutoProximo.Close;
  end
  else
  begin
    qryProdutoscodigo.AsLargeInt      := qryProdutoscaracteristica.AsLargeInt;
    qryProdutoscodigovisual.AsString := qryCaracteristicascodigovisual.AsString;

//    if parsistema.PermitirProdutoAlfanumerico then
//    begin
      RefazConsulta(spcProdutoProximo,[0],[qryCaracteristicascodigo.AsLargeInt]);
      qryProdutoscodigo.AsLargeInt      := spcProdutoProximocodigo.AsLargeInt;
      spcProdutoProximo.Close;
//    end;
  end;
  Result := GravarProduto;
end;

