function TdtmCadastroProdutos.CodigoBarrasPodeInserir(
  Codigo: String): Boolean;
begin
  RefazConsulta(qryExisteCodigoBarras,[0],[Codigo]);
  Result := qryExisteCodigoBarras.IsEmpty;
  if not Result then
    MensagemAviso(Format(ctCODIGOBARRASJACADASTRADO,
                         [qryExisteCodigoBarrascodigovisual.AsString + ' - ' +
                          qryExisteCodigoBarrasdescricao.AsString]))
  else
  begin
    RefazConsultapornome(qryExisteProduto,['codigobarras','codigoproduto','codigoprodutovisual'],
                       [Codigo, qryProdutoscodigo.AsLargeInt, qryProdutoscodigovisual.AsString]);

    Result := qryExisteProduto.IsEmpty;
    if not Result then
    begin
      if codigo = qryExisteProdutoproduto.asstring then
        MensagemAviso(Format('O Código de barras está igual ao código interno do item de produto %s',
                             [qryExisteProdutoproduto.AsString + ' - ' +
                              qryExisteProdutodescricao.AsString]))
      else
      if codigo = qryExisteProdutocodigovisual.asstring then
        MensagemAviso(Format('O Código de barras esta igual ao código visual do item de produto %s',
                             [qryExisteProdutocodigovisual.AsString + ' - ' +
                              qryExisteProdutodescricao.AsString]));

    end
    else
    begin
      RefazConsultapornome(qryExisteCaracteristica,['codigobarras','codigocaracteristica','codigocaracteristicavisual'],
                         [Codigo, qryCaracteristicascodigo.AsLargeInt, qryCaracteristicascodigovisual.AsString]);

      Result := qryExisteCaracteristica.IsEmpty;
      if not Result then
      begin
        if codigo = qryExisteCaracteristicacaracteristica.asstring then
          MensagemAviso(Format('O Código de barras está igual ao código interno do produto %s',
                               [qryExisteCaracteristicacaracteristica.AsString + ' - ' +
                                qryExisteCaracteristicadescricao.AsString]))
        else
        if codigo = qryExisteCaracteristicacodigovisual.asstring then
          MensagemAviso(Format('O Código de barras esta igual ao código visual do produto %s',
                               [qryExisteCaracteristicacodigovisual.AsString + ' - ' +
                                qryExisteCaracteristicadescricao.AsString]));
      end;
    end;
  end;
end;


procedure TdtmCadastroProdutos.dsrClientesProdutosDataChange(
  Sender: TObject; Field: TField);
begin
  inherited;
  if Field = qryClientesProdutosprecocliente then
