procedure TdtmCadastroProdutos.RefazConsultaProdutosCargos;
begin
  if (qryCaracteristicascodigo.AsLargeInt > 0) then
    RefazConsultaPorNome(qryProdutosCargo,['filialbase','produto'],[filialbase, qryProdutoscodigo.AsLargeInt]);
end;

procedure TdtmCadastroProdutos.IncluirCargosnosProdutos;
begin
  ReFazConsulta(qrycargos,[],[]);
  qryCargos.First;
  while not qryCargos.Eof do
  begin
    if not qryProdutosCargo.Locate('cargo', qryCargoscodigo.AsInteger,[]) then
    begin
      qryProdutosCargo.Append;
      qryProdutosCargocargo.AsInteger := qryCargoscodigo.AsInteger;
      qryProdutosCargodescricaocargo.AsString := qryCargosdescricao.AsString;
      qryProdutosCargomarkup.AsCurrency := qryCargosmarkuppadrao.AsCurrency;
      qryProdutosCargoinativo.AsDateTime := qryCargosinativo.AsDateTime;
      qryProdutosCargo.post;
    end;
    qryCargos.next;
  end;
  Perpetrar([qryProdutosCargo]);
end;

