begin
  inherited;
  qryFornecedoresProdutosprecocomipi.AsCurrency:= qryFornecedoresProdutospreco.AsCurrency +
                                                  ((qryFornecedoresProdutospreco.AsCurrency *
                                                    qryFornecedoresProdutosipi.AsFloat) / 100);
end;

