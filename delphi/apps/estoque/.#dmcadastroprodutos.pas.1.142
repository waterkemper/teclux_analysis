function TdtmCadastroProdutos.AbreTabelaElementos:Boolean;
Const
 SQLLinha = '(elementosgrades eg1 join grades g1 on eg1.grade = g1.codigo)';
 SQLColuna = '(elementosgrades eg2 join grades g2 on eg2.grade = g2.codigo)';

 SQLLinhaGrade = 'g1.codigo = :LinhaGrade';
 SQLColunaGrade ='g2.codigo = :ColunaGrade';

 SQLLinhaColunaCadastrados = 'and eg1.valor||eg2.valor not in (%s)';
 SQLLinhaCadastrados = 'and eg1.valor not in (%s)';
 SQLColunaCadastrados = 'and eg2.valor not in (%s)';

 SQLTipoLinha = 'and eg1.valor = %s';
 SQLTipoColuna = 'and eg2.valor = %s';

 SQLAtualizarItens = 'select distinct eg1.valor, eg2.valor as valor2';
 SQLNaoAtualizarItens = 'select distinct eg1.valor';

Var
 ListaCadastrados, SQLCadastrados : String;
begin
  Result := False;
  if (qryCaracteristicasgrade1.AsString<>'') and
     (qryCaracteristicasgrade2.AsString<>'') then
  begin
   if AtualizandoItens then
    qryProcuraElementoLinhaGrade.Sql[0] := SQLAtualizarItens
   else
     qryProcuraElementoLinhaGrade.Sql[0] := SQLNaoAtualizarItens;
     qryProcuraElementoLinhaGrade.sql[2] := SQLLinha+',';
     qryProcuraElementoLinhaGrade.sql[3] := SQLColuna;
     qryProcuraElementoLinhaGrade.sql[5] := SQLLinhaGrade;
     qryProcuraElementoLinhaGrade.sql[6] := ' and '+SQLColunaGrade;

     qryProcuraElementoColunaGrade.sql[2] := SQLLinha+',';
     qryProcuraElementoColunaGrade.sql[3] := SQLColuna;
     qryProcuraElementoColunaGrade.sql[5] := SQLLinhaGrade;
     qryProcuraElementoColunaGrade.sql[6] := ' and '+SQLColunaGrade;

     SQLCadastrados := SQLLinhaColunaCadastrados;
  end
  else
  if (qryCaracteristicasgrade1.AsString<>'') then
  begin
   qryProcuraElementoLinhaGrade.sql[2] := SQLLinha;
   qryProcuraElementoLinhaGrade.sql[3] := '';
   qryProcuraElementoLinhaGrade.sql[5] := SQLLinhaGrade;
   qryProcuraElementoLinhaGrade.sql[6] := '';
   SQLCadastrados := SQLLinhaCadastrados;
  end
  else
  if (qryCaracteristicasgrade2.AsString<>'') then
  begin
   qryProcuraElementoColunaGrade.sql[2] := '';
   qryProcuraElementoColunaGrade.sql[3] := SQLColuna;
   qryProcuraElementoColunaGrade.sql[5] := '';
   qryProcuraElementoColunaGrade.sql[6] := SQLColunaGrade;
   SQLCadastrados := SQLColunaCadastrados;
  end;

  ListaCadastrados := ListaValoresLinhacoluna;

  if ListaCadastrados<>'' then
  begin
    qryProcuraElementoLinhaGrade.Sql[7] := format(SQLCadastrados, [ListaCadastrados]);
    qryProcuraElementoColunaGrade.Sql[7] := format(SQLCadastrados, [ListaCadastrados]);
  end
  else
  begin
    qryProcuraElementoLinhaGrade.Sql[7] := '';
    qryProcuraElementoColunaGrade.Sql[7] := '';
  end;

  qryProcuraElementoLinhaGrade.Sql[8] := '';
  qryProcuraElementoColunaGrade.Sql[8] := '';

  if not AtualizandoItens then
  begin
    if ProdutoLinhaGrade<>'' then
     qryProcuraElementoColunaGrade.Sql[8] := format(SQLTipoLinha, [quotedstr(ProdutoLinhaGrade)])
    else
     if ProdutoColunaGrade<>'' then
      qryProcuraElementoLinhaGrade.Sql[8] := format(SQLTipoColuna, [quotedstr(produtoColunaGrade)]);
  end;

  qryProcuraElementoLinhaGrade.close;
  qryProcuraElementoColunaGrade.close;
  qryLinhaColunaGrade.close;

  if AtualizandoItens then
  begin
    qryLinhaColunaGrade.Free;
    qryLinhaColunaGrade:= TtecQuery.Create(Nil);
    qryLinhaColunaGrade.Database := qryProcuraElementoColunaGrade.Database;

    if (qryCaracteristicasgrade1.AsString<>'') and
        (qryCaracteristicasgrade2.AsString<>'') then
    begin
     qryLinhaColunaGrade.Sql := qryProcuraElementoLinhaGrade.Sql;
     qryLinhaColunaGrade.ParamByName('LinhaGrade').AsInteger := qryProcuraLinhaGradecodigo.AsInteger;
     qryLinhaColunaGrade.ParamByName('ColunaGrade').AsInteger := qryProcuraColunaGradecodigo.AsInteger;
     qryLinhaColunaGrade.open;
    end
    else
    if (qryCaracteristicasgrade1.AsString<>'') then
    begin
      qryLinhaColunaGrade.Sql := qryProcuraElementoLinhaGrade.Sql;
      qryLinhaColunaGrade.ParamByName('LinhaGrade').AsInteger := qryProcuraLinhaGradecodigo.AsInteger;
      qryLinhaColunaGrade.open;
    end
    else
     if (qryCaracteristicasgrade2.AsString<>'') then
     begin
      qryLinhaColunaGrade.Sql := qryProcuraElementoColunaGrade.Sql;
      qryLinhaColunaGrade.ParamByName('ColunaGrade').AsInteger := qryProcuraColunaGradecodigo.AsInteger;
      qryLinhaColunaGrade.open;
     end;
    result := not qryLinhaColunaGrade.IsEmpty;
  end
  else
  begin

    if (qryCaracteristicasgrade1.AsString<>'') and
        (qryCaracteristicasgrade2.AsString<>'') then
    begin
     qryProcuraElementoLinhaGrade.ParamByName('LinhaGrade').AsInteger := qryProcuraLinhaGradecodigo.AsInteger;
     qryProcuraElementoLinhaGrade.ParamByName('ColunaGrade').AsInteger := qryProcuraColunaGradecodigo.AsInteger;
     qryProcuraElementoColunaGrade.ParamByName('LinhaGrade').AsInteger := qryProcuraLinhaGradecodigo.AsInteger;
     qryProcuraElementoColunaGrade.ParamByName('ColunaGrade').AsInteger := qryProcuraColunaGradecodigo.AsInteger;
     qryProcuraElementoLinhaGrade.Open;
     qryProcuraElementoColunaGrade.Open;
    end
    else
    if qryCaracteristicasgrade1.AsString<>'' then
    begin
     qryProcuraElementoLinhaGrade.ParamByName('LinhaGrade').AsInteger := qryProcuraLinhaGradecodigo.AsInteger;
     qryProcuraElementoLinhaGrade.Open;
    end
    else
    if qryCaracteristicasgrade2.AsString<>'' then
    begin
     qryProcuraElementoColunaGrade.ParamByName('ColunaGrade').AsInteger := qryProcuraColunaGradecodigo.AsInteger;
     qryProcuraElementoColunaGrade.Open;
    end;
    if qryProcuraElementoLinhaGrade.Active and
       qryProcuraElementoColunaGrade.Active then
       result := not qryProcuraElementoLinhaGrade.IsEmpty and
                 not qryProcuraElementoColunaGrade.IsEmpty
    else
     if qryProcuraElementoLinhaGrade.Active then
       result := not qryProcuraElementoLinhaGrade.IsEmpty
     else
     if qryProcuraElementoColunaGrade.Active then
       result := not qryProcuraElementoColunaGrade.IsEmpty;
  end;

end;

procedure TdtmCadastroProdutos.qryProdutosAfterOpen(DataSet: TDataSet);
begin
  inherited;
  if UtilizandoGrade and
     ((qryCaracteristicascodigo.AsString<>
       fcodigoCaracteristicaAntesAbrir) or not qrygrade.active) then
  begin
    LinhasColunas[Codigo].Clear;
    LInhasColunas[ValorLinhaColuna].Clear;
    LinhasColunas[ValorLinha].Clear;
    LinhasColunas[ValorColuna].Clear;
    qryprodutos.First;
    While not qryprodutos.Eof do
    begin
      LinhasColunas[codigo].Add(qryProdutoscodigo.AsString);
      LinhasColunas[ValorLinhaColuna].Add(qryProdutosvalorgrade1.AsString+qryProdutosvalorgrade2.AsString);
      LinhasColunas[ValorLinha].Add(qryProdutosvalorgrade1.AsString);
      LinhasColunas[ValorColuna].Add(qryProdutosvalorgrade2.AsString);
      qryprodutos.Next;
    end;
    if qryGrade.Active then
     qryGrade.Close;
  end;
  fcodigoCaracteristicaAntesAbrir := qryCaracteristicascodigo.AsString;
end;

function TdtmCadastroProdutos.ListaValoresLinhacoluna: String;
var
ListaLinhaColuna : String;
I: integer;
begin
 ListaLinhaColuna := '';
 for I := 0 to LinhasColunas[codigo].Count-1 do
 begin
// if (LinhasColunas[codigo].Strings[I]<>qryProdutoscodigo.AsString) or
 if (LinhasColunas[ValorLinhacoluna].Strings[I]<>(qryProdutosvalorgrade1.AsString+
                                                  qryProdutosvalorgrade2.AsString)) or
    AtualizandoItens then
   if (qryCaracteristicasgrade1.AsString<>'') and
      (qryCaracteristicasgrade2.AsString<>'') then
     ListaLinhaColuna := ListaLinhaColuna+quotedstr(LinhasColunas[ValorLinhaColuna].Strings[I])+','
   else if (qryCaracteristicasgrade1.AsString<>'') then
     ListaLinhaColuna := ListaLinhaColuna+quotedstr(LinhasColunas[ValorLinha].Strings[I])+','
   else if (qryCaracteristicasgrade2.AsString<>'') then
     ListaLinhaColuna := ListaLinhaColuna+quotedstr(LinhasColunas[ValorColuna].Strings[I])+',';
 end;
 if (ListaLinhaColuna<>'') then
   ListaLinhaColuna := Copy(ListaLinhaColuna, 0, Length(ListaLinhaColuna) - 1);
 result := ListaLinhaColuna;
end;

