function TdtmCadastroProdutos.IncluirFornecedoresProdutos(Editar: Boolean): Boolean;

  procedure Fornecedores(Editando: Boolean);
  var
    Campos : String;
    Fornec : Integer;
    Pos    : TBookmark;
  begin
    Campos := '';
    Fornec:= qryFornecedoresProdutosfornecedor.AsInteger;
    qryFornecedoresProdutos.DisableControls;
    Pos:= qryFornecedoresProdutos.GetBookmark;
    try
    if not qryfornecedoresProdutos.Active then
      qryfornecedoresProdutos.Open;
      qryFornecedoresProdutos.First;
      while not qryFornecedoresProdutos.Eof do begin
        if (qryFornecedoresProdutosfornecedor.AsInteger > 0) then begin
          if not Editando then
            Campos := Campos + '' + qryFornecedoresProdutosfornecedor.AsString + ','
          else if (qryFornecedoresProdutosfornecedor.AsInteger <> Fornec) then
            Campos := Campos + '' + qryFornecedoresProdutosfornecedor.AsString + ',';
        end;
        qryFornecedoresProdutos.Next;
      end;
    finally
      qryFornecedoresProdutos.GotoBookmark(Pos);
      qryFornecedoresProdutos.FreeBookmark(Pos);
      qryFornecedoresProdutos.EnableControls;
      Delete(Campos,Length(Campos),1);
      if Campos = '' then Campos:= '0';
    end;
    qryProcuraFornecedores.Sql[04] := Format('and not (codigo in (%s))', [Campos]);
    qryConsultaFornecedores.Sql[06]:= Format('Where not (f.codigo in (%s))', [Campos]);
  end;

begin
  if qryFornecedoresProdutos.State in [dsEdit, dsInsert] then
    qryFornecedoresProdutos.Cancel;
  if Editar and not qryFornecedoresProdutos.IsEmpty then begin
    Fornecedores(True);
    qryFornecedoresProdutos.DisableControls;
    qryFornecedoresProdutos.Edit;
    qryFornecedoresProdutos.Cancel;
    qryFornecedoresProdutos.EnableControls;
  end
  else begin
    Fornecedores(False);
    qryFornecedoresProdutos.Params[1].Clear;
    qryFornecedoresProdutos.Append;
    qryFornecedoresProdutosdata.AsDateTime:= DataServidor;
  end;
  Result:= True;
end;

function TdtmCadastroProdutos.ExcluirFornecedoresProduto: Boolean;
begin
  Result:= False;
  if not qryFornecedoresProdutos.IsEmpty then begin
    if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o FORNECEDOR'])) = smbOk then begin
      qryFornecedoresProdutos.Delete;
      Result := True;
    end;
  end
end;

function TdtmCadastroProdutos.GravarFornecedoresProduto: Boolean;
var
  i: integer;
begin
  Result:= False;
  if qryFornecedoresProdutos.CheckRequiredFields then begin
    qryFornecedoresProdutoscaracteristica.AsLargeInt:= qryCaracteristicascodigo.AsLargeInt;
    qryFornecedoresProdutos.Post;

    RefazConsultaPorNome(qryFornecedoresProdutosAux, ['fornecedor','caracteristica'],
      [qryFornecedoresProdutosfornecedor.asinteger,
       qryFornecedoresProdutoscaracteristica.asLargeint]);

    qryFornecedoresProdutosAux.edit;

    for i:=0 to qryFornecedoresProdutos.fieldcount-1 do
    begin
      if qryFornecedoresProdutosAux.findfield(qryFornecedoresProdutos.fields[i].fieldname)<>nil then
      begin
        case qryFornecedoresProdutos.fields[i].DataType of
          ftString : qryFornecedoresProdutosAux.fieldbyname(qryFornecedoresProdutos.fields[i].fieldname).asString := qryFornecedoresProdutos.fields[i].asString;
          ftinteger : qryFornecedoresProdutosAux.fieldbyname(qryFornecedoresProdutos.fields[i].fieldname).asInteger := qryFornecedoresProdutos.fields[i].asInteger;
          ftlargeint : qryFornecedoresProdutosAux.fieldbyname(qryFornecedoresProdutos.fields[i].fieldname).asString := qryFornecedoresProdutos.fields[i].asString;
          ftBoolean : qryFornecedoresProdutosAux.fieldbyname(qryFornecedoresProdutos.fields[i].fieldname).asBoolean := qryFornecedoresProdutos.fields[i].asBoolean;
          ftFloat : qryFornecedoresProdutosAux.fieldbyname(qryFornecedoresProdutos.fields[i].fieldname).asFloat := qryFornecedoresProdutos.fields[i].asFloat;
          ftCurrency : qryFornecedoresProdutosAux.fieldbyname(qryFornecedoresProdutos.fields[i].fieldname).asCurrency := qryFornecedoresProdutos.fields[i].asCurrency;
        else
          qryFornecedoresProdutosAux.fieldbyname(qryFornecedoresProdutos.fields[i].fieldname).asVariant := qryFornecedoresProdutos.fields[i].asVariant;
        end;


      end
    end;

    qryFornecedoresProdutosAux.post;


    Perpetrar([qryFornecedoresProdutosAux, qryCaracteristicas]);
//    qryCaracteristicas.Edit;
    Result := True;
  end
end;

