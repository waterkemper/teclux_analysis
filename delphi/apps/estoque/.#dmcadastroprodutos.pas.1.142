function TdtmCadastroProdutos.CopiarCaracteristica(CodigoNovo:String): Boolean;
var
  vCopiarPreco: boolean;
begin
  result := false;
  if qryCaracteristicascodigo.aslargeint <> 0 then
  begin
    vCopiarPreco := MensagemSimNaoOpcaoCancelar('Deseja copiar o preço do produto?', '', false) = mrYes;

    qryFuncaoincluircaracteristicas.parambyname('codigo').asstring := qryCaracteristicascodigo.asstring;
    qryFuncaoincluircaracteristicas.parambyname('codigo_novo').asstring := CodigoNovo;
    qryFuncaoincluircaracteristicas.parambyname('CopiarPreco').asBoolean := vCopiarPreco;
    
    qryFuncaoincluircaracteristicas.close;
    qryFuncaoincluircaracteristicas.open;
    //qryFuncaoincluircaracteristicas.ExecSql;
    perpetrar([]);
    qryCaracteristicas.MacroByName('CondicaoEspecificaJanelaPesquisa').asString := '';
    RefazConsultaPorNome(qryCaracteristicas, ['codigovisual'], [qryFuncaoincluircaracteristicascodigo.asstring]);
    vIncluidoapartirdoRegistroAtual := true;
  end;

end;

procedure TdtmCadastroProdutos.RefletirDescricaoCaracteristicas;
begin
  if (vDescricaoCaracteristica <> qryCaracteristicasdescricao.AsString) AND
     not qryprodutos.isempty then
  begin
    if MensagemConfirmacao('Houve alteração na descrição da característica, deseja refleti-la nos itens de produtos?')= smbOK then
    begin

      qryprodutos.First;
      while not qryprodutos.Eof do
      begin
        if pos(vDescricaoCaracteristica, qryProdutosdescricao.AsString)<>0 then
        begin
          qryprodutos.Edit;
          qryProdutosdescricao.AsString := trocar(qryProdutosdescricao.AsString, vDescricaoCaracteristica, qryCaracteristicasdescricao.AsString);
          qryprodutos.post;
        end;
        qryprodutos.next;
      end;

    end;
  end;
end;

