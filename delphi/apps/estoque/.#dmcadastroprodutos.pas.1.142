function TdtmCadastroProdutos.IncluirEstoque(Editar: Boolean): Boolean;

  procedure Filiais(Editando: Boolean);
  var
    Campos : String;
    Coluna : Integer;
    Pos    : TBookmark;
  begin
    Campos := '';
    Coluna := qryEstoquesfilial.AsInteger;
    qryEstoques.DisableControls;
    Pos:= qryEstoques.GetBookmark;
    try
      qryEstoques.First;
      while not qryEstoques.Eof do begin
        if (qryEstoquesfilial.AsInteger > 0) then begin
          if not Editando then
            Campos := Campos + '' + qryEstoquesfilial.AsString + ','
          else if (qryEstoquesfilial.AsInteger <> Coluna) then
            Campos := Campos + '' + qryEstoquesfilial.AsString + ',';
        end;
        qryEstoques.Next;
      end;
    finally
      qryEstoques.GotoBookmark(Pos);
      qryEstoques.FreeBookmark(Pos);
      qryEstoques.EnableControls;
      Delete(Campos,Length(Campos),1);
      if Campos = '' then Campos:= '0';
    end;
    qryProcuraFiliais.Sql[04] := Format('and not (f.codigo in (%s))', [Campos]);
    qryConsultaFiliais.Sql[03]:= Format('Where not (f.codigo in (%s))', [Campos]);
  end;

begin
  if qryEstoques.State in [dsEdit, dsInsert] then
    qryEstoques.Cancel;
  if Editar and not qryEstoques.IsEmpty then begin
    Filiais(True);
    qryEstoques.DisableControls;
    qryEstoques.Edit;
    qryEstoques.Cancel;
    qryEstoques.EnableControls;
  end
  else begin
    Filiais(False);
    qryEstoques.Params[0].AsString:= IntToStr(qryProdutoscodigo.AsLargeInt);
    qryEstoques.Append;
    qryEstoquesproduto.AsLargeInt := qryProdutoscodigo.AsLargeInt;
  end;
  Result:= True;
end;

function TdtmCadastroProdutos.ExcluirEstoque: Boolean;
begin
  Result:= False;
  if not qryEstoques.isEmpty then begin
    if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o PRODUTO DA FILIAL '+ qryEstoquesFilial.AsString])) = smbOk then begin
      qryEstoques.Delete;
      Result := True;
    end
  end
end;

function TdtmCadastroProdutos.GravarEstoque: Boolean;
begin
  Result := False;
  if qryEstoques.CheckRequiredFields then begin
    qryEstoquesdescricaofilial.AsString:= qryProcuraFiliaisnome.AsString;
    qryEstoques.Post;
    Perpetrar([qryEstoques]);
    Result := True;
  end;
end;

