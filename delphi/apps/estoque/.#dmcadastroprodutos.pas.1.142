procedure TdtmCadastroProdutos.ExcluirProdutoCompostoFitas;
begin
  if not qryProdutoCompostoFitas.IsEmpty then
  begin
    if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['a fita '+  qryProdutoCompostoFitascomponente.AsString])) = smbOk then
    begin
      qryProdutoCompostoFitas.AfterDelete := nil;
      qryProdutoCompostoFitas.Delete;
      qryProdutoCompostoFitas.AfterDelete := qryProdutoCompostoFitasAfterDelete;
      
      RecalcularOrdemProdutoCompostoFitas;
      Perpetrar([qryProdutoCompostoFitas]);
    end;
  end;

end;

function TdtmCadastroProdutos.GravarProdutoCompostoFios: Boolean;
begin
  Result := False;
  if not (qryProdutoCompostoFios.State in [dsedit, dsinsert]) then
    qryProdutoCompostoFios.edit;


  if qryProdutoCompostoFios.CheckRequiredFields then
  begin
    if (qryProdutoCompostoFiosordem.asinteger = 0) then
      qryProdutoCompostoFiosordem.AsInteger := OrdemProdutoCompostoFios;

    if (qryProdutoCompostoFiossequencia.asinteger = 0) then
    begin
      spcProximoProdutoCompostoFios.Close;
      spcProximoProdutoCompostoFios.Open;
      qryProdutoCompostoFiossequencia.AsInteger := spcProximoProdutoCompostoFiossequencia.AsInteger;
    end;

    if (qryProdutoCompostoFios.State in [dsedit, dsinsert]) then
    begin
      qryProdutoCompostoFios.AfterPost := nil;
      qryProdutoCompostoFios.Post;
      qryProdutoCompostoFios.AfterPost := qryProdutoCompostoFiosAfterPost;
    end;

    Result:= Perpetrar([qryProdutoCompostoFios]);

    qryCaracteristicas.Edit;
  end
  else
    qryProdutoCompostoFios.RevertRecord;

end;

function TdtmCadastroProdutos.GravarProdutoCompostoFitas: Boolean;
begin

  Result := False;
  if not (qryProdutoCompostoFitas.State in [dsedit, dsinsert]) then
    qryProdutoCompostoFitas.edit;

  if qryProdutoCompostoFitas.CheckRequiredFields then
  begin
    if qryProdutoCompostoFitasordem.AsInteger = 0 then
      qryProdutoCompostoFitasordem.AsInteger := OrdemProdutoCompostoFitas;

    if (qryProdutoCompostoFitassequencia.asinteger = 0) then
    begin
      spcProximoProdutoCompostoFitas.Close;
      spcProximoProdutoCompostoFitas.Open;
      qryProdutoCompostoFitassequencia.AsInteger := spcProximoProdutoCompostoFitassequencia.AsInteger;
    end;

    if (qryProdutoCompostoFitas.State in [dsedit, dsinsert]) then
    begin
      qryProdutoCompostoFitas.AfterPost := nil;
      qryProdutoCompostoFitas.Post;
      qryProdutoCompostoFitas.AfterPost := qryProdutoCompostoFitasAfterPost;
    end;

    Result:= Perpetrar([qryProdutoCompostoFitas]);

    qryCaracteristicas.Edit;
  end
  else
    qryProdutoCompostoFitas.RevertRecord;
end;

