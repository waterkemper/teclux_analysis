  inherited;
  AtualizarProdutosEstados;
end;

procedure TdtmCadastroProdutos.RefazConsultaProdutosEstados;
begin
  if(qryProdutoscodigo.AsString<>'') then
  begin
    RefazConsultaPorNome(qryEstadosProdutos,['produto'], [qryprodutoscodigo.asString]);
    RefazConsultaPorNome(qryProdutosEstados,['produto'], [qryprodutoscodigo.asString]);
  end;
end;


procedure TdtmCadastroProdutos.AtualizarProdutosEstados;
begin

  GuardarRegistroAtual(qryestadosprodutos, true);
  qryestadosprodutos.first;
  while not qryestadosprodutos.eof do
  begin
    if qryprodutosestados.locate('estado', qryEstadosProdutosestado.asString,[]) then
    begin
      if (qryProdutosEstadosindsuperfluo.asboolean <> qryEstadosProdutosindsuperfluo.asboolean) or
         (qryProdutosEstadospercfcp.asCurrency <> qryEstadosProdutospercfcp.asCurrency) then
      begin
        if qryEstadosProdutosindsuperfluo.asboolean then
        begin
          qryProdutosEstados.edit;
          qryProdutosEstadosindsuperfluo.asboolean := true;
          qryProdutosEstadospercfcp.asCurrency := qryEstadosProdutospercfcp.asCurrency;
          qryProdutosEstados.post;
        end
        else
          qryProdutosEstados.delete;
      end;
    end
    else
    begin
      if qryEstadosProdutosindsuperfluo.asboolean then
      begin
        qryProdutosEstados.append;
        qryProdutosEstadosproduto.asString := qryprodutoscodigo.asstring;
        qryProdutosEstadosestado.asString := qryEstadosProdutosestado.asstring;
        qryProdutosEstadosindsuperfluo.asboolean := true;
        qryProdutosEstadospercfcp.asCurrency := qryEstadosProdutospercfcp.asCurrency;
        qryProdutosEstados.post;
      end;
    end;
    qryestadosprodutos.next;
  end;
  perpetrar([qryProdutosEstados]);
  VoltarRegistroAtual(qryestadosprodutos);
end;

procedure TdtmCadastroProdutos.ExcluirProdutos_Servicos;
begin
  if not qryProdutos_Servicos.IsEmpty then
  begin
    if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o serviço '+  qryProdutos_Servicosdescricao.AsString])) = smbOk then
    begin
      qryProdutos_Servicos.AfterDelete := nil;
      qryProdutos_Servicos.Delete;
      qryProdutos_Servicos.AfterDelete := qryProdutos_ServicosAfterDelete;
      Perpetrar([qryProdutos_Servicos]);
    end
  end
end;

