function TdtmCadastroProdutos.IncluirClienteProduto(
  Editar: Boolean): Boolean;

  procedure Clientes(Editando: Boolean);
  var
    Clientes,
    TipoCliente : String;
    Cliente  : Integer;
    Pos    : TBookmark;
  begin
    Clientes := '';
    Cliente := qryClientesProdutoscliente.AsInteger;
    TipoCliente := qryClientesProdutostipocliente.AsString;
    qryClientesProdutos.DisableControls;
    Pos:= qryClientesProdutos.GetBookmark;
    try
      qryClientesProdutos.First;
      while not qryClientesProdutos.Eof do begin
        if (qryClientesProdutoscliente.AsInteger > 0) then begin
          if not Editando or
             (Editando and
              (qryClientesProdutoscliente.AsInteger <> Cliente) and
              (qryClientesProdutostipocliente.AsString <> TipoCliente)) then
            Clientes := Clientes + ' ((v.codigo = ' + qryClientesProdutoscliente.AsString + ') and ' +
                                     '(v.tipo = ''' + qryClientesProdutostipocliente.AsString + ''')) or';
        end;
        qryClientesProdutos.Next;
      end;
    finally
      qryClientesProdutos.GotoBookmark(Pos);
      qryClientesProdutos.FreeBookmark(Pos);
      qryClientesProdutos.EnableControls;
      Delete(Clientes,Length(Clientes)-2,3);
    end;
    if Clientes <> '' then
    begin
      qryProcuraCliente.MacroByName('CLIENTES').AsString   := Format('and not (%s)', [Clientes]);
      qryConsultaClientes.MacroByName('CLIENTES').AsString := Format('and not (%s)', [Clientes]);
    end
    else
    begin
      qryProcuraCliente.MacroByName('CLIENTES').AsString   := '';
      qryConsultaClientes.MacroByName('CLIENTES').AsString := '';
    end;
  end;

begin
  if qryClientesProdutos.State in [dsEdit, dsInsert] then
    qryClientesProdutos.Cancel;
  if Editar and not qryClientesProdutos.IsEmpty then begin
    Clientes(True);
    qryClientesProdutos.DisableControls;
    qryClientesProdutos.Edit;
    qryClientesProdutos.Cancel;
    qryClientesProdutos.EnableControls;
  end
  else begin
    Clientes(False);
    qryClientesProdutos.Params[0].AsString:= IntToStr(qryProdutoscodigo.AsLargeInt);
    qryClientesProdutos.Append;
    qryClientesProdutosproduto.AsLargeInt := qryProdutoscodigo.AsLargeInt;
  end;
  Result:= True;
end;

function TdtmCadastroProdutos.ExisteClienteProduto(Campo,
  codigo: String): Boolean;
const
  SQL = 'and (upper(to_ascii(%s,''latin1'')) ilike upper(to_ascii(''%s%s'',''latin1'')))';
begin
  if Campo = 'nomecidade' then
    Campo:= 'c.nome'
  else
    Campo:= 'v.' + Campo;
  qryConsultaClientes.MacroByName('CONSULTA').AsString:= Format(SQL, [Campo, Codigo, '%']);
  qryConsultaClientes.Close;
  qryConsultaClientes.Open;
  Result := qryConsultaClientes.RecordCount > 0
end;

function TdtmCadastroProdutos.ExcluirClienteProduto: Boolean;
begin
  Result:= False;
  if not qryClientesProdutos.isEmpty then begin
    if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['a relação PRODUTO/CLIENTE ' +
                                                      qryClientesProdutosproduto_cliente.AsString])) = smbOk then
    begin
      qryClientesProdutos.Delete;
      Result := Perpetrar([qryClientesProdutos]);
    end
  end
end;

function TdtmCadastroProdutos.GravarClienteProduto: Boolean;

  procedure AtribuirClienteDemaisProdutos(Cliente: Integer;
    PN, Tipo, Item, ProdutoCliente, Finalidade, Origem: String);
  begin
    qryClientesProdutos.Post;
    qryProdutos.AfterScroll := nil;
    GuardarRegistroAtual(qryProdutos,true);
    qryProdutos.First;
    while not qryProdutos.Eof do
    begin
      if ((qryProdutoscodigo.AsString <> Item) and not(qryClientesProdutos.Locate('cliente,tipocliente,produto',VarArrayOf([Cliente, Tipo,qryProdutoscodigo.AsString]),[]))) then
      begin
        qryClientesProdutos.Append;
        qryClientesProdutoscliente.AsInteger := Cliente;
        qryClientesProdutostipocliente.AsString := Tipo;
        qryClientesProdutosproduto.AsString := qryProdutoscodigo.AsString;
        qryClientesProdutosproduto_cliente.AsString := ProdutoCliente;
        qryClientesProdutos.Post;
      end;
      qryProdutos.Next;
    end;
    VoltarRegistroAtual(qryProdutos);
    qryProdutos.AfterScroll := qryProdutosAfterScroll;
    Perpetrar([qryClientesProdutos]);
    RefazConsultaClientesProdutos;
    qryClientesProdutos.Locate('cliente,tipocliente,produto',VarArrayOf([Cliente, Tipo,qryProdutoscodigo.AsString]),[]);    
  end;

  procedure AlterarDemaisProdutos(ClienteAnt, Cliente: Integer;
    PN, TipoAnt, Tipo, ProdutoCliente, Finalidade, Origem: String;
    ValorPrecoCliente: Currency; AlteracaoPrecoCliente: TDateTime);
  begin
    qryClientesProdutos.Post;
    Perpetrar([qryClientesProdutos]);
    GuardarRegistroAtual(qryProdutos,true);
    qryProdutos.First;
    while not qryProdutos.Eof do
    begin
      if qryClientesProdutos.Locate('cliente,tipocliente,produto',VarArrayOf([ClienteAnt, TipoAnt,qryProdutoscodigo.AsString]),[]) then
      begin
        qryClientesProdutos.Edit;
        qryClientesProdutoscliente.AsInteger := Cliente;
        qryClientesProdutostipocliente.AsString := Tipo;
        qryClientesProdutosproduto.AsString := qryProdutoscodigo.AsString;
        qryClientesProdutosproduto_cliente.AsString := ProdutoCliente;
        qryClientesProdutosfinalidade.AsString := Finalidade;
        qryClientesProdutospn.AsString := PN;
        qryClientesProdutosorigem.AsString := Origem;
        qryClientesProdutosprecocliente.AsFloat := ValorPrecoCliente;
        qryClientesProdutosalteracaoprecocliente.AsDateTime := AlteracaoPrecoCliente;
        qryClientesProdutos.Post;
        Perpetrar([qryClientesProdutos]);
      end
      else
      begin
        qryClientesProdutos.Append;
        qryClientesProdutoscliente.AsInteger := Cliente;
        qryClientesProdutostipocliente.AsString := Tipo;
        qryClientesProdutosproduto.AsString := qryProdutoscodigo.AsString;
        qryClientesProdutosproduto_cliente.AsString := ProdutoCliente;
        qryClientesProdutosfinalidade.AsString := Finalidade;
        qryClientesProdutospn.AsString := PN;
        qryClientesProdutosorigem.AsString := Origem;
        qryClientesProdutos.Post;
        Perpetrar([qryClientesProdutos]);
      end;
      qryProdutos.Next;
    end;
    VoltarRegistroAtual(qryProdutos);
    qryClientesProdutos.Locate('cliente,tipocliente,produto',VarArrayOf([Cliente, Tipo,qryProdutoscodigo.AsString]),[]);    
  end;

begin
  Result := False;
  if qryClientesProdutos.CheckRequiredFields then
  begin
    qryClientesProdutosnome.AsString    := qryProcuraClientenome.AsString;
    qryClientesProdutosproduto.AsString := qryProdutoscodigo.AsString;
    if qryClientesProdutostipocliente.AsString <> qryProcuraClientetipo.AsString then
      qryClientesProdutostipocliente.AsString := qryProcuraClientetipo.AsString;

    if qryClientesProdutos.State = dsInsert then
      AtribuirClienteDemaisProdutos(qryClientesProdutoscliente.AsInteger,
                                    qryClientesProdutospn.AsString,
                                    qryClientesProdutostipocliente.AsString,
                                    qryClientesProdutosproduto.AsString,
                                    qryClientesProdutosproduto_cliente.AsString,
                                    qryClientesProdutosfinalidade.AsString,
                                    qryClientesProdutosorigem.AsString)
    else
     if qryClientesProdutos.State = dsEdit then
     begin
       if (qryProdutos.RecordCount > 1) and
          (MensagemConfirmacao(ctMESMAALTERACAODEMAISITENS) = smbOK) then
         AlterarDemaisProdutos(qryClientesProdutosclienteaux.AsInteger,
                               qryClientesProdutoscliente.AsInteger,
                               qryClientesProdutospn.AsString,
                               qryClientesProdutostipoclienteaux.AsString,
                               qryClientesProdutostipocliente.AsString,
                               qryClientesProdutosproduto_cliente.AsString,
                               qryClientesProdutosfinalidade.AsString,
                               qryClientesProdutosorigem.AsString,
                               qryClientesProdutosprecocliente.AsCurrency,
                               qryClientesProdutosalteracaoprecocliente.AsDateTime)
       else
       begin
         qryClientesProdutos.Post;
         Perpetrar([qryClientesProdutos]);
       end;
     end;
    Result := True;
  end;
end;

function TdtmCadastroProdutos.GetConsultarClientes: TtecQuery;
begin
  Result := qryConsultaClientes;
end;

procedure TdtmCadastroProdutos.RefazConsultaClientesProdutos;
begin
  if (qryCaracteristicascodigo.AsLargeInt > 0) then
    ReFazConsulta(qryClientesProdutos,[0],[qryProdutoscodigo.AsLargeInt]);
end;

procedure TdtmCadastroProdutos.qryClientesProdutosAfterDelete(
  DataSet: TDataSet);
begin
  inherited;
  if (qryProdutos.RecordCount > 1) and
     (MensagemConfirmacao(ctMESMAALTERACAODEMAISITENS) = smbOK) then
  begin
    qryClientesProdutos.BeforeDelete := nil;
    qryClientesProdutos.AfterDelete  := nil;
    GuardarRegistroAtual(qryProdutos,True);
    qryProdutos.First;
    while not qryProdutos.Eof do
    begin
      if qryClientesProdutos.Locate('cliente,tipocliente',VarArrayOf([FClienteProdutoDeletado,
                                                                      FTipoClienteProdutoDeletado]),[]) then
      begin
        qryClientesProdutos.Delete;
        Perpetrar([qryClientesProdutos]);
      end;
      qryProdutos.Next;
    end;
    VoltarRegistroAtual(qryProdutos);
    qryClientesProdutos.BeforeDelete := qryClientesProdutosBeforeDelete;
    qryClientesProdutos.AfterDelete  := qryClientesProdutosAfterDelete;
  end;
end;

procedure TdtmCadastroProdutos.qryClientesProdutosBeforeDelete(
  DataSet: TDataSet);
begin
  inherited;
  FClienteProdutoDeletado     := qryClientesProdutoscliente.AsInteger;
  FTipoClienteProdutoDeletado := qryClientesProdutostipocliente.AsString;
end;

