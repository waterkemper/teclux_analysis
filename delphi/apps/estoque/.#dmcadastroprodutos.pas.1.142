Nome       : ReFazConsultaProdutoComposto
Objetivo   : Consultar no banco os produtos que fazer parte da composição do produtos selecionado
Retorno    : Não tem.
Parametros : Não tem.
Criado em  : 27/07/2006
Responsável: Ismael Leandro Faustino Jason Jackson
--------------------------------------------------------------------------------
Histórico de alteração:
   - [Responsável] em [Data da alteração]
        [descrição da alteração]
-------------------------------------------------------------------------------}
procedure TdtmCadastroProdutos.ReFazConsultaProdutoComposto;
begin
  if (qryCaracteristicascodigo.AsInteger > 0) then
    ReFazConsulta(qryProdutoComposto,[0], [qryProdutoscodigo.AsLargeint]);
end;

{-----------------------------------------------------------------------------
Nome       : ExcluirProdutoComposto
Objetivo   : Excluir um componente do produro composro.
Retorno    : Retorna um booleano com true para sucesso e do contrario false.
Parametros : Não tem.
Criado em  : 28/07/2006
Responsável: Ismael Leandro Faustino
--------------------------------------------------------------------------------
Histórico de alteração:
   - [Responsável] em [Data da alteração]
        [descrição da alteração]
-------------------------------------------------------------------------------}
procedure TdtmCadastroProdutos.ExcluirProdutoComposto;
begin
//  Result:= False;
  if not qryProdutoComposto.IsEmpty then
  begin
    if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o componente '+  qryProdutoCompostodescricao.AsString])) = smbOk then
    begin
      qryprodutocomposto.AfterDelete := nil;
      qryProdutoComposto.Delete;
      qryprodutocomposto.AfterDelete := qryProdutoCompostoAfterDelete;
      RecalcularOrdemProdutoComposto;
      Perpetrar([qryProdutoComposto]);
    end
  end
end;

{-----------------------------------------------------------------------------
Nome       : GravarProdutoComposto
Objetivo   : Gravar um componente no banco de dados.
Retorno    : REtorna um booleano com true para sucesso e do contrario false.
Parametros : Não tem.
Criado em  : 27/07/2006
Responsável: Ismael Leandro Faustino
--------------------------------------------------------------------------------
Histórico de alteração:
   - [Responsável] em [Data da alteração]
        [descrição da alteração]
-------------------------------------------------------------------------------}
function TdtmCadastroProdutos.GravarProdutoComposto: Boolean;
begin
  Result := False;
  if qryProdutoComposto.CheckRequiredFields then
  begin
    qryProdutoCompostototal.AsFloat := qryProdutoCompostoquantidade.AsCurrency * qryProdutoCompostopreco.AsFloat;
    if qryProdutoComposto.State = dsinsert then
      qryProdutoCompostoordem.AsInteger := OrdemProdutoComposto;

    if (qryprodutocomposto.State in [dsedit, dsinsert]) then
      qryProdutoComposto.Post;

    Result:= Perpetrar([qryProdutoComposto]);
  end;
end;

{-----------------------------------------------------------------------------
Nome       : IncluirProdutoComposto
Objetivo   : Inicia o processo de inclusão de um novo registro no banco.
Retorno    : Retorna um booleano com true para sucesso e do contrario false.
Parametros : - Editar : Boolean
                  Este parâmetro serve de indicação para a função se o registro está sendo incluido ou editado.
                  Mas não está sendo usado no momento.
Criado em  : 27/07/2006
Responsável: Ismael Leandro Faustino.
--------------------------------------------------------------------------------
Histórico de alteração:
   - [Responsável] em [Data da alteração]
        [descrição da alteração]
-------------------------------------------------------------------------------}
function TdtmCadastroProdutos.IncluirProdutoComposto(
  Editar: Boolean): Boolean;
begin
  if not qryProdutoComposto.Active then
    qryProdutoComposto.Open;

  if (Editar and qryProdutoComposto.IsEmpty) or not Editar then
    qryProdutoComposto.Append
  else
  begin
    qryProdutoComposto.edit;
    qryProdutoComposto.cancel;
  end;

  Result:= True;
end;

