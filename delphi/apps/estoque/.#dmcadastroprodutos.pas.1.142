procedure TdtmCadastroProdutos.RecalcularOrdemProdutoComposto;
begin

  GuardarRegistroAtual(qryProdutoComposto, true);
  qryProdutoComposto.First;
  while not qryProdutoComposto.Eof do
  begin
    qryprodutocomposto.Edit;
    qryProdutoCompostoordem.AsInteger := qryprodutocomposto.RecNo;
    qryprodutocomposto.Next;
  end;
  qryProdutoCompostoAfterOpen(nil);
  VoltarRegistroAtual(qryProdutoComposto);

end;


