    function ProdutoExistente: boolean;
    function ExisteContaContabil(campo, codigo: String): Boolean;
    function ExisteHistorico(campo, codigo: string): boolean;
    function CadastroItemAutomatico: Boolean;
    property ColunaColunasPreco: String write SetColunaColunasPreco;
    property ICMSObrigatorio: Boolean read GetICMSObrigatorio;
    property ICMS: Integer read GetICMS;
    function TotalComponentes: Real;
    property Composto: Boolean read GetComposto;
    property Incidencia: Integer read GetIncidencia;
    property NumeroItens: integer read GetNumeroItensProduto;
    property OrdemProdutoComposto: integer read GetOrdemProdutoComposto write FOrdemProdutoComposto;
    property OrdemProdutoCompostoFios: integer read GetOrdemProdutoCompostoFios write FOrdemProdutoCompostoFios;
    property OrdemProdutoCompostoFitas: integer read GetOrdemProdutoCompostoFitas write FOrdemProdutoCompostoFitas;
    property OpcaoInativoConsultaCaracteristicas: String read fOpcaoInativoConsultaCaracteristicas write FOpcaoInativoConsultaCaracteristicas;
    procedure IncluirCargosnosProdutos;
    procedure IncluirProdutosCargos;
    procedure ExcluirProdutosCargos;
    procedure GravarProdutosFornecedoresUnidades;
    procedure RefletirDescricaoCaracteristicas;

    procedure RefazConsultaProdutosEstados;
    procedure ExcluirProdutosAgendamentos;
    procedure InverterLinha_x_Coluna;
    property SaldoControleLote: Currency read GetSaldoControleLote write fSaldoControleLote;
    function DadosLotesProdutosOK: boolean;
    function VerificarElementosdaGrade: boolean;
    function PermiteAlterarComposto: boolean;

    procedure CopiarDescricaoParaNomeSite;
    function GetProduto: String;




  end;

var
  dtmCadastroProdutos: TdtmCadastroProdutos;
  fFormaPesquisaProduto : FormaPesquisaProduto;


implementation

uses
  //Biblio
  clparametrossistema,
  //Repositorio
  dmtecsoft, fmDefinirLoteeValidade, Grids;

{$R *.dfm}

constructor TdtmCadastroProdutos.Create(AOwner: TComponent);
begin
  inherited;
  qryDrahtBand.tag := cttabelas;
  qryCaracteristicas.Tag := ctTabelas;
//  qryProdutos.Tag := ctTabelasCaracteristicas;
//  qryEstoques.Tag := ctTabelasCaracteristicas;
//  qrySimilares.Tag := ctTabelasCaracteristicas;
//  qryPrecos.Tag := ctTabelasCaracteristicas;
//  qryColunasPrecos.Tag := ctTabelasCaracteristicas;
//  qryColunas.Tag := ctTabelasCaracteristicas;
//  qryFornecedoresProdutos.Tag := ctTabelasCaracteristicas;
//  qryCodigoBarrasProduto.Tag:= ctTabelasCaracteristicas;
  qryConsultaCaracteristicas.Tag := ctProcuraCaracteristicas;
  qryConsultaCaracteristicasProdutos.Tag := ctProcuraCaracteristicas;
  qryConsultaSimilares.Tag := ctProcuraCaracteristicasSimilar;
  qryConsultaGrupos.Tag := ctProcuraGrupos;
  qryConsultaClasses.Tag := ctProcuraClasse;
  qryConsultaObsLegais.Tag := ctProcuraObsLegais;
  qryConsultaUnidades.Tag := ctProcuraUnidades;
  qryConsultaIPI.Tag := ctProcuraIPI;
  qryConsultaICMS.Tag := ctProcuraICMS;
  qryConsultaMarcas.Tag := ctProcuraMarcas;
  qryConsultaColunas.Tag := ctProcuraColunas;
  qryConsultaPrecos.Tag := ctProcuraPrecos;
  qryConsultaFornecedores.Tag := ctFornecedoresProdutos;
  qryConsultaOrigens.Tag := ctProcuraOrigem;
  qryConsultaIncidencia.Tag := ctProcuraIncidencia;
  qryConsultaFatoresPreco.Tag := ctConsultaFatoresPreco;
  qryConsultaFiliais.Tag:= ctProcuraFiliais;
  qryConsultaGrades.Tag := ctConsultaGrades;
  qryConsultaClientes.Tag := ctConsultaClientes;
  qryProcuraOrigens.TAG := cttabelas;

  qryConsultaContaContabil.Tag := ctConsultaContaContabil;
  qryProcuraDebitaraVista.Params[1].AsInteger   := 0;
  qryProcuraCreditaraVista.Params[1].AsInteger  := 0;
  qryProcuraDebitaraPrazo.Params[1].AsInteger   := 0;
  qryProcuraCreditaraPrazo.Params[1].AsInteger  := 0;
  qryProcuraDebitarAbatimentos.Params[1].AsInteger := 0;
  qryProcuraCreditarAbatimentos.Params[1].AsInteger := 0;
  qryProcuraDebitarDevolucoes.Params[1].AsInteger := 0;
  qryProcuraCreditarDevolucoes.Params[1].AsInteger := 0;
  qryProcuraCliente.Params[1].AsString := 'C';
  qryConsultaHistorico.Tag := ctConsultaHistoricos;

  qryProcuraICMS.Params[0].AsString := EstadoFilialBase;

//  qryProdutoCompostoquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
//  qryProdutoCompostoFiosquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
//  qryProdutoCompostoFitasquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;

  if ParSistema.GerarCodigoProdutoAutomatico then
       qryCaracteristicascodigo.AutoGenerateValue:= arAutoInc
  else qryCaracteristicascodigo.AutoGenerateValue:= arNone;

  LinhasColunas[codigo] := TStringList.Create;
  LinhasColunas[ValorLinhaColuna] := TStringList.Create;
  LinhasColunas[ValorLinha] := TStringList.Create;
  LinhasColunas[ValorColuna] := TStringList.Create;
  AtualizandoItens := false;

  qryClientesProdutosproduto_cliente.Required := ParSistema.ControlesVoltadosparaIndustria;

  OpcaoInativoConsultaCaracteristicas := 'ATIVOS';

  AcertarCasasDecimais(qryProdutoCompostopreco);

end;

function TdtmCadastroProdutos.GetTabelaCaracteristica: TtecQuery;
begin
  Result := qryCaracteristicas;
end;

function TdtmCadastroProdutos.IncluirCaracteristica: Boolean;
begin
  RefazConsultaIncluirCaracteristica;
  if qryCaracteristicas.State = dsInactive then
    qryCaracteristicas.Open;
  qryCaracteristicas.Insert;
  Result:= True;
end;

function TdtmCadastroProdutos.GravarCaracteristica: Boolean;
var
  AliqPIS,
  AliqCOFINS: Real;
begin
  try


  Result:= False;
  qryCaracteristicasicmsmodalidade.Required := (qryProcuraIncidenciasvalor.AsString = ctTRIBUTADA)               OR
                                               (qryProcuraIncidenciasvalor.AsString = ctTRIBUTADASUBSTITUICAO)   OR
                                               (qryProcuraIncidenciasvalor.AsString = ctREDUCAOBASE)             OR
                                               (qryProcuraIncidenciasvalor.AsString = ctREDUCAOBASESUBSTITUICAO) OR
                                               (qryProcuraIncidenciasvalor.AsString = ctOUTROS) OR

                                               (qryCaracteristicascsosn.AsString = '900');



  qryCaracteristicasicmsmodsubst.Required   := (qryProcuraIncidenciasvalor.AsString = ctTRIBUTADASUBSTITUICAO)   OR
                                               (qryProcuraIncidenciasvalor.AsString = ctISENTASUBSTITUICAO)      OR
                                               (qryProcuraIncidenciasvalor.AsString = ctREDUCAOBASESUBSTITUICAO) OR
                                               (qryProcuraIncidenciasvalor.AsString = ctOUTROS) OR

                                               (qryCaracteristicascsosn.AsString = '201') or
                                               (qryCaracteristicascsosn.AsString = '202') or
                                               (qryCaracteristicascsosn.AsString = '203') or
                                               (qryCaracteristicascsosn.AsString = '900');



//  qryCaracteristicasipi.Required := parsistema.EmissorNfe or Sped_pis_cofins or sped_fiscal;

  qryCaracteristicaspiscst.Required := ParSistema.EmissorNfe or Sped_pis_cofins;
  qryCaracteristicascofinscst.Required := ParSistema.EmissorNfe or Sped_pis_cofins;

  if qryCaracteristicas.CheckRequiredFields then
  begin
    AliqPIS    := ParSistema.AliquotaPIS;
    AliqCOFINS := ParSistema.AliquotaCofins;
    if (AliqPIS <> 0) and ((qryCaracteristicasaliquotapis.AsFloat = 0) or (qryCaracteristicasaliquotapis.AsFloat <> AliqPIS)) then
      Result := MensagemConfirmacao(Format(ctALIQUOTAPISALERTA, [qryCaracteristicasaliquotapis.AsFloat, AliqPIS])) = smbOK
    else
      Result := True;
    if Result then
      if (AliqCOFINS <> 0) and ((qryCaracteristicasaliquotacofins.AsFloat = 0) or (qryCaracteristicasaliquotacofins.AsFloat <> AliqCOFINS)) then
        Result := MensagemConfirmacao(Format(ctALIQUOTACOFINSALERTA, [qryCaracteristicasaliquotacofins.AsFloat, AliqCOFINS])) = smbOK
      else
        Result := True;
    if Result then
    begin
      if (qryCaracteristicas.State = dsInsert)  then
      begin
      (*
        if ParSistema.GerarCodigoProdutoAutomatico {or
           ParSistema.PermitirProdutoAlfanumerico} then
        begin
       *)
          spcCaracteristicasProximo.Open;
          qryCaracteristicascodigo.AsLargeInt := spcCaracteristicasProximocodigo.AsLargeInt;
          spcCaracteristicasProximo.Close;
       // end;

        if qryCaracteristicascodigovisual.AsString='' then
          qryCaracteristicascodigovisual.AsString := qryCaracteristicascodigo.AsString;

        // Inserir um Preco default.

        if qryPrecos.State = dsInactive then
          qryPrecos.Open;

        qryPrecos.Insert;
        qryPrecoscaracteristica.AsLargeInt:= qryCaracteristicascodigo.AsLargeInt;
        qryPrecoscodigo.AsInteger         := 01;
        qryPrecosdescricao.AsString       := 'NORMAL';
        qryPrecos.Post;
      end;

      qryModelosCaracteristicas.First;
      while not qryModelosCaracteristicas.Eof do
      begin
        if qryModelosCaracteristicascaracteristica.IsNull then
        begin
          qryModelosCaracteristicas.Edit;
          qryModelosCaracteristicascaracteristica.AsLargeInt := qryCaracteristicascodigo.AsLargeInt;
          qryModelosCaracteristicas.post;
        end;
        qryModelosCaracteristicas.Next;
      end;

      if (qryCaracteristicas.State = dsEdit)  or
         ((qryCaracteristicas.State = dsInsert) or vIncluidoapartirdoRegistroAtual) then
      begin
        qryCaracteristicas.edit;
        qryCaracteristicasdata.AsDateTime := DataLocal;
        qryCaracteristicas.Post;

(*
        {Esta dupla tentativa de perpetrar duas vezes se dá pelo fato de que a trigger retorna erro (loop caracteristicas X produtos)
         Na primeira retorna erro, na segunda não.}

        if ((qryCaracteristicasinativo.OldValue = null) and
            (qryCaracteristicasinativo.Value <>  null)) or

           ((qryCaracteristicasforalinha.OldValue = null) and
            (qryCaracteristicasforalinha.Value <>  null)) then
        begin
          try
            Result:= Perpetrar([qryCaracteristicas, qrymodeloscaracteristicas, qryPrecos,
                                qryProdutoComposto, qryProdutoCompostoFios, qryProdutoCompostoFitas]);
          except
            Result:= Perpetrar([qryCaracteristicas, qrymodeloscaracteristicas, qryPrecos,
                                qryProdutoComposto, qryProdutoCompostoFios, qryProdutoCompostoFitas]);
          end;
        end
        else
*)
         if qryCaracteristicascomposto.AsBoolean and not qryProdutoComposto.IsEmpty then
            AtualizarPrecoComposto;

          Result:= Perpetrar([qryCaracteristicas, qryProdutos, qrymodeloscaracteristicas, qryPrecos,
                              qryProdutoComposto, qryProdutos_Servicos, qryProdutoCompostoFios, qryProdutoCompostoFitas, qryProdutosCargo, qryProdutosFornecedoresUnidades,
                              qryProdutosAgendamentos]);

        ReFazConsultaProdutos;
        vIncluidoapartirdoRegistroAtual := false;
      end;
    end;


  end;

  except
     on E: Exception do
     begin
       ShowMessage(E.Message);
       ReFazConsultaProdutos;
     end


  end;

end;

function TdtmCadastroProdutos.ExcluirCaracteristica: Boolean;
begin
  Result := False;
  if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o PRODUTO e todos os seus ITENS'])) = smbOk then begin
    if not qryCaracteristicas.isEmpty then begin
      qryCaracteristicas.Delete;
      Perpetrar([qryCaracteristicas]);
      Result := True;
    end;
  end;
end;

procedure TdtmCadastroProdutos.Selecionar(TipoProcura: TipoProcuraProdutosEstoque);
begin
  case TipoProcura of
               tpGRUPOS : begin
                            qryCaracteristicas.Edit;
                            ReFazConsulta(qryProcuraGrupos,[0],[CodigoGrupo]);
                            qryCaracteristicasgrupo.AsString := CodigoGrupo;
                          end;
               tpCLASSE : begin
                            qryCaracteristicas.Edit;
                            qryCaracteristicasclasse.AsString := qryConsultaClassesCodigo.AsString;
                          end;
            tpOBSLEGAIS : begin
                             qryCaracteristicas.Edit;
                             ReFazConsulta(qryProcuraObsLegais,[0],[CodigoObsLegal]);
                             qryCaracteristicasobslegal.AsInteger := CodigoObsLegal;
                            end;
             tpUNIDADES : begin
                            qryCaracteristicas.Edit;
                            ReFazConsulta(qryProcuraUnidades,[0],[CodigoUnidade]);
                            qryCaracteristicasunidade.AsString := CodigoUnidade;
                           end;
                  tpIPI : begin
                            qryCaracteristicas.Edit;
                            ReFazConsulta(qryProcuraIPI,[0],[CodigoIPI]);
                            qryCaracteristicasipi.AsInteger := CodigoIPI;
                          end;
                 tpICMS : begin
                            qryCaracteristicas.Edit;
                            ReFazConsulta(qryProcuraICMS,[1],[CodigoICMS]);
                            qryCaracteristicasicms.AsInteger := CodigoICMS;
                           end;
        tpDescricaonaNF : begin
                            qryCaracteristicas.Edit;
                            qryCaracteristicasdescricaonanf.AsString := qryDescricaoProdutoNFdescricaonanf.AsString;
                          end;
               tpMARCAS : begin
                            qryCaracteristicas.Edit;
                            ReFazConsulta(qryProcuraMarcas,[0],[CodigoMarca]);
                            qryCaracteristicasmarca.AsInteger := CodigoMarca;
                          end;
  tpCOLUNASCOLUNASPRECOS : begin
                            qryColunasPrecos.Edit;
                            qryColunasPrecoscoluna.AsInteger          := qryConsultaColunascodigo.AsInteger;
                            qryColunasPrecoscolunasdescricao.AsString := qryConsultaColunasdescricao.AsString;
                          end;
  tpPRECOSCOLUNASPRECOS : begin
                            qryColunasPrecospreco.AsInteger := qryConsultaPrecoscodigo.AsInteger;
                          end;
            tpSIMILARES : begin
                            qrySimilares.Edit;
                            qrySimilaressimilar.AsLargeInt := qryConsultaSimilarescodigo.AsLargeInt;
                            qrySimilaressimilarvisual.AsString := qryConsultaSimilarescodigovisual.AsString;
                            qrySimilaresdescricao.AsString := qryConsultaSimilaresdescricao.AsString;
                          end;
         tpFORNECEDORES : begin
                            qryFornecedoresProdutos.Edit;
                            qryFornecedoresProdutosfornecedor.AsInteger:= qryConsultaFornecedorescodigo.AsInteger;
                            qryFornecedoresProdutosrazao.AsString:= qryConsultaFornecedoresnome.AsString;
                          end;
              tpFATORES : begin
                            qryCaracteristicas.Edit;
                            qryCaracteristicasfatorpreco.AsString:= qryConsultaFatoresPrecocodigo.AsString;
                          end;
              tpORIGENS : begin
                              qryCaracteristicas.Edit;
                              ReFazConsulta(qryProcuraOrigens,[0],[qryConsultaOrigenscodigo.Value]);
                              qryCaracteristicasorigem.AsString := qryConsultaOrigenscodigo.AsString;
                          end;
          tpINCIDENCIAS : begin
                              qryCaracteristicas.Edit;
                              ReFazConsulta(qryProcuraIncidencias,[0],[qryConsultaIncidenciavalor.Value]);
                              qryCaracteristicascst.AsString := qryConsultaIncidenciavalor.AsString;
                              qryCaracteristicasincidencia.AsString := qryConsultaIncidenciacodigo.AsString;
                          end;
             tpESTOQUES : begin
                            qryEstoques.Edit;
                            qryEstoquesfilial.AsInteger:= qryConsultaFiliaiscodigo.AsInteger;
                          end;
           tpLINHAGRADE : begin
                            qryCaracteristicas.Edit;
                            ReFazConsulta(qryProcuraLinhaGrade,[0],[CodigoGrade]);
                            qryCaracteristicasgrade1.AsInteger := CodigoGrade;
                          end;
           tpCOLUNAGRADE: begin
                            qryCaracteristicas.Edit;
                            ReFazConsulta(qryProcuraColunaGrade,[0],[CodigoGrade]);
                            qryCaracteristicasgrade2.AsInteger := CodigoGrade;
                          end;
       tpPRECOSPRODUTOS : begin
                            if not (qryprodutos.State in [dsinsert, dsedit]) then
                              qryProdutos.Edit;
                            qryProdutospreco.AsInteger := qryConsultaPrecoscodigo.AsInteger;
                          end;
  tpCONSULTAPRECOSPRODUTOS : begin
                              ReFazConsulta(qryProcuraPrecos,[0,1],
                                [qryCaracteristicascodigo.AsVariant,
                                 qryConsultaPrecoscodigo.AsVariant]);
                          end;

               tpPRODUTOS : begin
                               ReFazConsultaporNome(qryProcuraProdutosCompostos,['codigo','codigovisual','composto','componente'],
                                     [qryConsultaProdutosCompostoscodigo.AsVariant, qryConsultaProdutosCompostoscodigovisual.AsVariant,
                                      qryProdutosCodigo.AsVariant, qryProdutoCompostocomponente.AsVariant]);

                               qryProdutoComposto.Edit;
                               qryProdutoCompostocomponentevisual.AsString := qryConsultaProdutosCompostoscodigovisual.AsVariant;;
                               qryProdutoCompostocomponente.AsString := qryConsultaProdutosCompostoscodigo.AsVariant;
                            end;

               tpPRODUTOSFIOS : begin
                               RefazConsultaPorNome(qryProcuraProdutosCompostosFios,['codigo','codigovisual','composto','componente'],
                                  [qryConsultaProdutosCompostosFioscodigo.AsVariant, null, qryProdutosCodigo.AsVariant, null]);

                               qryProdutoCompostoFios.Edit;
                               qryProdutoCompostoFioscomponente.AsString := qryProcuraProdutosCompostosFioscodigovisual.AsString;
                            end;

               tpPRODUTOSFITAS : begin
                               RefazConsultaPorNome(qryProcuraProdutosCompostosFitas,['codigo','codigovisual','composto','componente'],
                                  [qryConsultaProdutosCompostosFitascodigo.AsVariant, null, qryProdutosCodigo.AsVariant, null]);

                               qryProdutoCompostoFitas.Edit;
                               qryProdutoCompostoFitascomponente.AsString := qryProcuraProdutosCompostosFitascodigovisual.AsString;
                            end;


     tpDebitarVendaaVista : begin
                              if qryConsultaContaContabiltipo.AsString<>'S' then
                              begin
                                if not (qryCaracteristicas.state in [dsinsert, dsedit]) then
                                  qryCaracteristicas.Edit;
                                qryCaracteristicasdebitarvendaavista.AsInteger := qryConsultaContaContabilcodigo.AsInteger
                              end
                              else
                              begin
                                if not qryCaracteristicasdebitarvendaavista.IsNull then
                                begin
                                  if not (qryCaracteristicas.state in [dsinsert, dsedit]) then
                                    qryCaracteristicas.Edit;
                                  qryCaracteristicasdebitarvendaavista.Clear;
                                end;
                              end
                            end;

    tpCreditarVendaaVista : begin
                              if qryConsultaContaContabiltipo.AsString<>'S' then
                              begin
                                if not (qryCaracteristicas.state in [dsinsert, dsedit]) then
                                  qryCaracteristicas.Edit;
                                qryCaracteristicascreditarvendaavista.AsInteger := qryConsultaContaContabilcodigo.AsInteger
                              end
                              else
                              begin
                                if not qryCaracteristicascreditarvendaavista.IsNull then
                                begin
                                  if not (qryCaracteristicas.state in [dsinsert, dsedit]) then
                                    qryCaracteristicas.Edit;
                                  qryCaracteristicascreditarvendaavista.Clear;
                                end;
                              end
                            end;
   tpHistoricoVendaaVista : begin
                              if not (qryCaracteristicas.state in [dsinsert, dsedit]) then
                                 qryCaracteristicas.Edit;
                              qryCaracteristicashistoricovendaavista.AsInteger := qryConsultaHistoricocodigo.AsInteger
                            end;

     tpDebitarVendaaPrazo : begin
                              if qryConsultaContaContabiltipo.AsString<>'S' then
                              begin
                                if not (qryCaracteristicas.state in [dsinsert, dsedit]) then
                                  qryCaracteristicas.Edit;
                                qryCaracteristicasdebitarvendaaprazo.AsInteger := qryConsultaContaContabilcodigo.AsInteger
                              end
                              else
                              begin
                                if not qryCaracteristicasdebitarvendaaprazo.IsNull then
                                begin
                                  if not (qryCaracteristicas.state in [dsinsert, dsedit]) then
                                    qryCaracteristicas.Edit;
                                  qryCaracteristicasdebitarvendaaprazo.Clear;
                                end;
                              end
                            end;

    tpCreditarVendaaPrazo : begin
                              if qryConsultaContaContabiltipo.AsString<>'S' then
                              begin
                                if not (qryCaracteristicas.state in [dsinsert, dsedit]) then
                                  qryCaracteristicas.Edit;
                                qryCaracteristicascreditarvendaaprazo.AsInteger := qryConsultaContaContabilcodigo.AsInteger
                              end
                              else
                              begin
                                if not qryCaracteristicascreditarvendaaprazo.IsNull then
                                begin
                                  if not (qryCaracteristicas.state in [dsinsert, dsedit]) then
                                    qryCaracteristicas.Edit;
                                  qryCaracteristicascreditarvendaaprazo.Clear;
                                end;
                              end
                            end;
   tpHistoricoVendaaPrazo : begin
                              if not (qryCaracteristicas.state in [dsinsert, dsedit]) then
                                 qryCaracteristicas.Edit;
                              qryCaracteristicashistoricovendaaprazo.AsInteger := qryConsultaHistoricocodigo.AsInteger
                            end;


     tpDebitarAbatimentos : begin
                              if qryConsultaContaContabiltipo.AsString<>'S' then
                              begin
                                if not (qryCaracteristicas.state in [dsinsert, dsedit]) then
                                  qryCaracteristicas.Edit;
                                qryCaracteristicasdebitarabatimentos.AsInteger := qryConsultaContaContabilcodigo.AsInteger
                              end
                              else
                              begin
                                if not qryCaracteristicasdebitarabatimentos.IsNull then
                                begin
                                  if not (qryCaracteristicas.state in [dsinsert, dsedit]) then
                                    qryCaracteristicas.Edit;
                                  qryCaracteristicasdebitarabatimentos.Clear;
                                end;
                              end
                            end;

    tpCreditarAbatimentos : begin
                              if qryConsultaContaContabiltipo.AsString<>'S' then
                              begin
                                if not (qryCaracteristicas.state in [dsinsert, dsedit]) then
                                  qryCaracteristicas.Edit;
                                qryCaracteristicascreditarabatimentos.AsInteger := qryConsultaContaContabilcodigo.AsInteger
                              end
                              else
                              begin
                                if not qryCaracteristicascreditarabatimentos.IsNull then
                                begin
                                  if not (qryCaracteristicas.state in [dsinsert, dsedit]) then
                                    qryCaracteristicas.Edit;
                                  qryCaracteristicascreditarabatimentos.Clear;
                                end;
                              end
                            end;
   tpHistoricoAbatimentos : begin
                              if not (qryCaracteristicas.state in [dsinsert, dsedit]) then
                                 qryCaracteristicas.Edit;
                              qryCaracteristicashistoricoabatimentos.AsInteger := qryConsultaHistoricocodigo.AsInteger
                            end;
     tpDebitarDevolucoes : begin
                              if qryConsultaContaContabiltipo.AsString<>'S' then
                              begin
                                if not (qryCaracteristicas.state in [dsinsert, dsedit]) then
                                  qryCaracteristicas.Edit;
                                qryCaracteristicasdebitarDevolucoes.AsInteger := qryConsultaContaContabilcodigo.AsInteger
                              end
                              else
                              begin
                                if not qryCaracteristicasdebitarDevolucoes.IsNull then
                                begin
                                  if not (qryCaracteristicas.state in [dsinsert, dsedit]) then
                                    qryCaracteristicas.Edit;
                                  qryCaracteristicasdebitarDevolucoes.Clear;
                                end;
                              end
                            end;

    tpCreditarDevolucoes : begin
                              if qryConsultaContaContabiltipo.AsString<>'S' then
                              begin
                                if not (qryCaracteristicas.state in [dsinsert, dsedit]) then
                                  qryCaracteristicas.Edit;
                                qryCaracteristicascreditarDevolucoes.AsInteger := qryConsultaContaContabilcodigo.AsInteger
                              end
                              else
                              begin
                                if not qryCaracteristicascreditarDevolucoes.IsNull then
                                begin
                                  if not (qryCaracteristicas.state in [dsinsert, dsedit]) then
                                    qryCaracteristicas.Edit;
                                  qryCaracteristicascreditarDevolucoes.Clear;
                                end;
                              end
                            end;
   tpHistoricoDevolucoes : begin
                              if not (qryCaracteristicas.state in [dsinsert, dsedit]) then
                                 qryCaracteristicas.Edit;
                              qryCaracteristicashistoricoDevolucoes.AsInteger := qryConsultaHistoricocodigo.AsInteger
                            end;
               tpCLIENTE : begin
                            qryClientesProdutos.Edit;
                            qryClientesProdutoscliente.AsInteger    := qryConsultaClientescodigo.AsInteger;
                            qryClientesProdutostipocliente.AsString := qryConsultaClientestipoorig.AsString;
                            RefazConsulta(qryProcuraCliente, [0,1], [qryConsultaClientescodigo.AsInteger,
                                                                     qryConsultaClientestipoorig.AsString]);
                          end;
  end;
end;

function TdtmCadastroProdutos.GetCodigoProcuraCaracteristica: Int64;
begin
  Result := qryConsultaCaracteristicascodigocaracteristica.AsLargeInt;
end;

procedure TdtmCadastroProdutos.SetCodigoCaracteristica(const Value: Int64);
begin
  if qryCaracteristicas.State in [dsInsert, dsEdit] then
    qryCaracteristicascodigo.AsLargeInt := Value;
end;

function TdtmCadastroProdutos.PosicionarRegistro(TipoProcura: TipoProcuraProdutosEstoque; Parametro: Integer): Boolean;
begin
  case TipoProcura of
         tpCaracteristicas : Result := ExisteCaracteristica(qryCaracteristicascodigo.FieldName, qryCaracteristicascodigo.AsString);
    tpColunasColunasPrecos : Result := ExisteColuna(qryColunascodigo.FieldName, qryColunasPrecoscoluna.AsString);
     tpPrecosColunasPrecos : Result := ExistePreco(qryPrecoscodigo.FieldName, qryColunasPrecospreco.AsString);
          tpPrecosProdutos : Result := ExistePreco(qryPrecoscodigo.FieldName, qryProdutospreco.AsString);
  else
    Result := False;
  end;
end;

procedure TdtmCadastroProdutos.RefazConsultaCaracteristica;
begin
//  if (FExibirCaracteristicas in [mcaCARACTERISTICAS, mcaPRECOS]) then
    ReFazConsultaPrecos;
//    ReFazConsulta(qryColunasPrecos,[0,1],[qryCaracteristicascodigo.AsLargeInt, qryPrecoscodigo.AsInteger]);
  if ((mcaPRODUTOS in ExibirProduto) or (qryProdutos.State = dsInactive)) then
    ReFazConsultaProdutos;
  if FExibirCaracteristicas = mcaFORNECEDORES then
    ReFazConsultaFornecedoresProdutos;
  if FExibirCaracteristicas = mcaSIMILARES then
    ReFazConsultaSimilares;
  if mcaESTOQUES in ExibirProduto then
    ReFazConsultaEstoques;
  if mcaCODIGOSBARRAS in ExibirProduto  then
    ReFazConsultaCodigoBarras;

  RefazConsultaPorNome(qryModelosCaracteristicas,['caracteristica'],
              [qryCaracteristicascodigo.aslargeint]);

//  RefazConsulta(qryProcuraICMS,[0],[qryCaracteristicasicms.AsInteger]);
//  RefazConsulta(qryProcuraIPI,[0],[qryCaracteristicasipi.AsInteger]);
//  RefazConsulta(qryProcuraObsLegais,[0],[qryCaracteristicasobslegal.AsInteger]);
//  ReFazConsulta(qryProcuraMarcas,[0],[qryCaracteristicasmarca.AsInteger]);
//  ReFazConsulta(qryProcuraGrupos,[0],[qryCaracteristicasgrupo.AsString]);
//  ReFazConsulta(qryProcuraUnidades,[0],[qryCaracteristicasunidade.AsString]);
end;

function TdtmCadastroProdutos.ExcluirSimilar: Boolean;
begin
  Result:= False;
  if not qrySimilares.isEmpty then begin
    if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o SIMILAR'])) = smbOk then begin
      qrySimilares.Delete;
      Result := True;
    end
  end
end;

function TdtmCadastroProdutos.GetTabelaSimilar: TtecQuery;
begin
  Result := qrySimilares;
end;

function TdtmCadastroProdutos.GravarSimilar: Boolean;
begin
  Result:= False;
  if qrySimilares.CheckRequiredFields then
  begin
    qrySimilares.Post;
    Perpetrar([qrySimilares]);
    ReFazConsultaSimilares;
    Result := True;
  end;
end;

function TdtmCadastroProdutos.IncluirSimilar(Editar:Boolean): Boolean;

  procedure Similares(Editando: Boolean);
  var
    Campos  : String;
    Similar : Int64;
    Pos     : TBookmark;
  begin
    Campos := qryCaracteristicascodigo.AsString + ',';
    Similar:= qrySimilaressimilar.AsLargeInt;
    Pos:= qrySimilares.GetBookmark;
    try
      qrySimilares.DisableControls;
      qrySimilares.First;
      while not qrySimilares.Eof do begin
        if (qrySimilaressimilar.AsLargeInt > 0) then begin
          if not Editando then
            Campos := Campos + '' + qrySimilaressimilar.AsString + ','
          else if (qrySimilaressimilar.AsLargeInt <> Similar) then
            Campos := Campos + '' + qrySimilaressimilar.AsString + ',';
        end;
        qrySimilares.Next;
      end;
    finally
      qrySimilares.EnableControls;
      qrySimilares.GotoBookmark(Pos);
      qrySimilares.FreeBookmark(Pos);
      Delete(Campos,Length(Campos),1);
    end;
    qryProcuraSimilares.Sql[04] := Format('and not (codigo in (%s))', [Campos]);
    qryConsultaSimilares.Sql[04]:= Format('and not (c.codigo in (%s))', [Campos]);
  end;

begin
  if qrySimilares.State in [dsEdit, dsInsert] then
    qrySimilares.Cancel;
  if Editar and not qrySimilares.IsEmpty then begin
    Similares(True);
    qrySimilares.DisableControls;
    qrySimilares.Edit;
    qrySimilares.Cancel;
    qrySimilares.EnableControls;
  end
  else begin
    Similares(False);
    qrySimilares.Params[0].Clear;
    qrySimilares.Append;
  end;
  Result := True
end;

function TdtmCadastroProdutos.ExcluirProduto: Boolean;
begin
  Result:= False;
  if not qryProdutos.isEmpty then begin
    if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o ITEM DO PRODUTO'])) = smbOk then begin
     AtualizarGrade(tpEXCLUSAO);
     qryProdutos.Delete;
     Result := True;
    end
  end
end;

function TdtmCadastroProdutos.GravarProduto: Boolean;
var
  vIncluindoProduto: Boolean;
  vPreco: integer;
begin
  vIncluindoProduto := False;
  Result:= False;
  if qryProdutos.CheckRequiredFields then begin
    if qryProdutos.State = dsInsert then
    begin
      vIncluindoProduto := True;
      vPreco := qryprodutospreco.asinteger;

//      if ParSistema.GerarCodigoProdutoAutomatico {or
//         ParSistema.PermitirProdutoAlfanumerico}  then
//      begin
        RefazConsulta(spcProdutoProximo,[0],[qryCaracteristicascodigo.AsLargeInt]);
        qryProdutoscodigo.AsLargeInt:= spcProdutoProximocodigo.AsLargeInt;

        if qryProdutoscodigovisual.AsString = '' then
          qryProdutoscodigovisual.AsString := qryProdutoscodigo.AsString;
//      end
//      else
//        qryProdutoscodigovisual.AsString := qryProdutoscodigo.AsString;

      if ParSistema.IncluirEstoqueAutomatico then
      begin

        if qryEstoques.State = dsInactive then
          ReFazConsulta(qryEstoques,[0],[0]);

        qryConsultaFiliais.Sql[03]:= '';
        qryConsultaFiliais.Open;
        if not qryConsultaFiliais.IsEmpty then
        begin
          qryConsultaFiliais.First;
          while not qryConsultaFiliais.Eof do
          begin
//            if (qryConsultaFiliaistipofilial.AsString <> 'V') then
            begin // V = Virtual
              qryEstoques.Append;
              qryEstoquesproduto.AsLargeInt       := qryProdutoscodigo.AsLargeInt;
              qryEstoquesfilial.AsInteger         := qryConsultaFiliaiscodigo.AsInteger;
              qryEstoquesdescricaofilial.AsString := qryConsultaFiliaisnome.AsString;
              qryEstoques.Post;
            end;
            qryConsultaFiliais.Next;
          end;
        end;
        qryConsultaFiliais.Close;
      end;
      IncluiTabelaElementos;
    end;
    qryProdutosdata.AsDateTime := DataLocal;
    qryProdutospromocao.AsVariant := qryProcuraPrecospromocao.AsVariant;
    qryProdutosdescricaopromocao.AsVariant := qryProcuraPrecosdescricaopromocao.AsVariant;
    qryProdutosvalidadepromocao.AsDateTime := qryProcuraPrecosvalidade.AsDateTime;

    qryProdutos.Post;
    AtualizarGrade(tpALTERACAO);

    qryCaracteristicas.Edit;
    qryCaracteristicasdata.AsDateTime := now();
    qryCaracteristicas.post;

    Perpetrar([qryCaracteristicas, qryprodutos, qryEstoques]);

    if vIncluindoProduto then
    begin
      RefazConsultaPorNome(qryIncluirProdutosCargos,
         ['caracteristica','produto','preco'],

         [qryCaracteristicascodigo.AsString,
          spcProdutoProximocodigo.AsString,
          vPreco]);
          
      spcProdutoProximo.Close;


      if mcaPRODUTOSCARGOS in ExibirProduto then
        RefazConsultaProdutosCargos;


                                                     
   end;

    Result := True;
  end
end;

function TdtmCadastroProdutos.IncluirProduto(Editar: Boolean): Boolean;
begin
  Result:= True;
  if qryCaracteristicas.State in [dsEdit, dsInsert] then
    Result:= GravarCaracteristica;
  if qryProdutos.State in [dsEdit, dsInsert] then
    qryProdutos.Cancel;
  if Result then begin
    qryProcuraPrecos.Params[0].AsString := IntToStr(qryCaracteristicascodigo.AsLargeInt);
    qryConsultaPrecos.Params[0].AsString:= IntToStr(qryCaracteristicascodigo.AsLargeInt);
    if Editar and not qryProdutos.IsEmpty then begin
      qryProdutos.DisableControls;
      qryProdutos.Edit;
      qryProdutos.Cancel;
      qryProdutos.EnableControls;
    end
    else begin
      qryProdutos.Append;
      Result:= qryProdutos.State in [dsInsert];
      if result then
      begin
        qryProdutoscaracteristica.AsLargeInt:= qryCaracteristicascodigo.AsLargeInt;
        qryProdutosdescricao.AsString       := qryCaracteristicasdescricao.AsString;
        if ParSistema.GerarCodigoProdutoAutomatico then
        begin
          RefazConsulta(spcProdutoProximo,[0],[qryCaracteristicascodigo.AsLargeInt]);
          qryProdutoscodigo.AsLargeInt:= spcProdutoProximocodigo.AsLargeInt;
          qryProdutoscodigovisual.AsString := qryProdutoscodigo.AsString;
          spcProdutoProximo.Close;
        end
        else
        begin
          qryProdutoscodigo.AsLargeInt      := qryCaracteristicascodigo.AsLargeInt;
          qryProdutoscodigovisual.AsString := qryCaracteristicascodigovisual.AsString;

          if ({(ParSistema.PermitirProdutoAlfanumerico) and} (qryProdutoscodigo.AsString='')) then
          begin
            RefazConsulta(spcProdutoProximo,[0],[qryCaracteristicascodigo.AsLargeInt]);
            qryProdutoscodigo.AsLargeInt:= spcProdutoProximocodigo.AsLargeInt;
            spcProdutoProximo.Close;
          end;
        end;

        if not qryFornecedoresProdutos.IsEmpty then begin
          qryFornecedoresProdutos.First;
          qryProdutosreferencia.AsString:= qryFornecedoresProdutosreferencia.AsString;
        end;
      end;
    end;
  end;
end;

function TdtmCadastroProdutos.ExcluirPreco: Boolean;
begin
  Result:= False;
  if not qryPrecos.isEmpty then begin
    if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o PREÇO'])) = smbOk then begin
      qryPrecos.Delete;
      Result := True;
    end
  end
end;

function TdtmCadastroProdutos.GravarPreco: Boolean;
begin
  Result:= False;
  if qryPrecos.CheckRequiredFields then begin
    if qryPrecos.State = dsInsert then begin
      RefazConsulta(spcPrecoProximo,[0],[qryCaracteristicascodigo.AsLargeInt]);
      qryPrecoscodigo.AsInteger := spcPrecoProximo.FieldByName('codigo').AsInteger;
      spcPrecoProximo.Close;
    end;

    qryPrecoscaracteristica.AsLargeInt:= qryCaracteristicascodigo.AsLargeInt;
    qryPrecos.Post;
    {Retirado a qryProdutos abaixo pois ocorria erro ao vincular ao atual outro existente}
    Perpetrar([qryPrecos{, qryprodutos}]);
//    qryCaracteristicas.Edit;
    Result := True;
  end;
end;

function TdtmCadastroProdutos.IncluirPreco(Editar:Boolean): Boolean;
begin
  if qryPrecos.State in [dsEdit, dsInsert] then
    qryPrecos.Cancel;
  if (Editar and qryPrecos.IsEmpty) or not Editar then
    qryPrecos.Append;
  Result := True
end;

function TdtmCadastroProdutos.ExcluirColunaPreco: Boolean;
begin
  Result:= False;
  if not qryColunasPrecos.IsEmpty then begin
    if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['a COLUNA DE PREÇOS'])) = smbOk then begin
      qryColunasPrecos.Delete;
      Result := True;
    end
  end
end;

function TdtmCadastroProdutos.GravarColunaPreco: Boolean;
begin
  Result:= False;
  if qryColunasPrecos.CheckRequiredFields then begin
    qryColunasPrecoscaracteristica.AsLargeInt:= qryCaracteristicascodigo.AsLargeInt;
    if (qryColunasPrecos.State in [dsInsert]) then
      qryColunasPrecosalteracao.AsDateTime := DataServidor
    else if (qryColunasPrecos.State in [dsEdit]) then begin
      if qryColunasPrecosvalor.AsCurrency <> qryColunasPrecosvalor.OldValue then
        qryColunasPrecosalteracao.AsDateTime:= DataServidor;
    end;
    qryColunasPrecos.Post;
    Perpetrar([qryColunasPrecos]);
    Result := True;
  end;
end;

function TdtmCadastroProdutos.IncluirColunaPreco(Editar:Boolean): Boolean;

  procedure Colunas(Editando: Boolean);
  var
    Campos : String;
    Coluna : Integer;
    Pos    : TBookmark;
  begin
    Campos := '';
    Coluna := qryColunasPrecoscoluna.AsInteger;
    Pos:= qryColunasPrecos.GetBookmark;
    try
      qryColunasPrecos.DisableControls;
      qryColunasPrecos.First;
      while not qryColunasPrecos.Eof do begin
        if (qryColunasPrecoscoluna.AsInteger <> 0) then begin
          if not Editando then
            Campos := Campos + '' + qryColunasPrecoscoluna.AsString + ','
          else if (qryColunasPrecoscoluna.AsInteger <> Coluna) then
            Campos := Campos + '' + qryColunasPrecoscoluna.AsString + ',';
        end;
        qryColunasPrecos.Next;
      end;
    finally
      qryColunasPrecos.EnableControls;
      qryColunasPrecos.GotoBookmark(Pos);
      qryColunasPrecos.FreeBookmark(Pos);
      Delete(Campos,Length(Campos),1);
      if Campos = '' then Campos:= '0';
    end;
    qryProcuraColunas.Sql[04] := Format('and not (codigo in (%s))', [Campos]);
    qryConsultaColunas.Sql[03]:= Format('Where not (codigo in (%s))', [Campos]);
  end;

begin
  if qryColunasPrecos.State in [dsEdit,dsInsert] then
    qryColunasPrecos.Cancel;
  if Editar and not qryColunasPrecos.IsEmpty then begin
     Colunas(True);
     qryColunasPrecos.DisableControls;
     qryColunasPrecos.Edit;
     qryColunasPrecos.Cancel;
     qryColunasPrecos.EnableControls;
  end
  else begin
    Colunas(False);
    qryColunasPrecos.Params[0].Clear;
    qryColunasPrecos.Params[1].Clear;
    qryColunasPrecos.Append;
    qryColunasPrecospreco.AsInteger := qryPrecosCodigo.AsInteger;
    qryColunasPrecosdata.AsDateTime := DataServidor;
  end;
  Result:= True;
end;

