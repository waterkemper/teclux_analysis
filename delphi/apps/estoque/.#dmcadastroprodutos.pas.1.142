procedure TdtmCadastroProdutos.AbreTabelasConsulta(TipoProcura: TipoProcuraProdutosEstoque);
begin
  case TipoProcura of
       tpCARACTERISTICAS : begin
                             dtmCadastroProdutos.qryCaracteristicas.MacroByName('CondicaoEspecificaJanelaPesquisa').asString := '';
                             if vCondicaoDiversasChavesEncontradas then
                               ExisteCaracteristica('codigocaracteristicavisual', qryCaracteristicas.parambyname('codigovisual').asstring)
                             else
                             begin
                               if not qryConsultaCaracteristicas.Active and
                                  not qryConsultaCaracteristicasProdutos.Active and
                                  not qryConsultaCaracteristicasProdutosClientes.Active then
                               begin
                                 qryConsultaCaracteristicas.macrobyname('SQLProdutos').asstring:= 'Where false';
                                 qryConsultaCaracteristicasProdutos.macrobyname('SQLProdutos').asstring:= 'Where false';
                                 qryConsultaCaracteristicasProdutosClientes.macrobyname('SQLProdutos').asstring:= 'Where false';

                                 qryConsultaCaracteristicas.close;
                                 qryConsultaCaracteristicas.Open;


                                 qryConsultaCaracteristicasProdutos.close;
                                 qryConsultaCaracteristicasProdutos.Open;

                                 qryConsultaCaracteristicasProdutosClientes.close;
                                 qryConsultaCaracteristicasProdutosClientes.Open;
                               end
                             end;
                           end;
             tpSIMILARES : begin
                             qryConsultaSimilares.Sql[03]:= 'Where false';
                             qryConsultaSimilares.Open;
                           end;
                tpGRUPOS : Abre(ctProcuraGrupos);
                tpCLASSE : Abre(ctProcuraClasse);
             tpOBSLEGAIS : Abre(ctProcuraObsLegais);
              tpUNIDADES : Abre(ctProcuraUnidades);
                   tpIPI : Abre(ctProcuraIPI);
                  tpICMS : Abre(ctProcuraICMS);
         tpDescricaonaNF : qryDescricaoProdutoNF.Open;
                tpMARCAS : Abre(ctProcuraMarcas);
  tpCOLUNASCOLUNASPRECOS : Abre(ctProcuraColunas);
          tpFORNECEDORES : Abre(ctFornecedoresProdutos);
               tpFATORES : Abre(ctConsultaFatoresPreco);
    tpPRECOS,
    tpPRECOSCOLUNASPRECOS,
    tpPRECOSPRODUTOS,
    tpCONSULTAPRECOSPRODUTOS : Abre(ctProcuraPrecos);
               tpORIGENS : Abre(ctProcuraOrigem);
           tpINCIDENCIAS : Abre(ctProcuraIncidencia);
              tpESTOQUES : Abre(ctProcuraFiliais);
          tpLINHAGRADE   : begin
                            qryConsultaGrades.Params[0].AsInteger := qryProcuraColunaGradecodigo.AsInteger;
                            Abre(ctConsultaGrades);
                           end;
          tpCOLUNAGRADE  : begin
                            qryConsultaGrades.Params[0].AsInteger := qryProcuraLinhaGradecodigo.AsInteger;
                            Abre(ctConsultaGrades);
                           end;
    tpDebitarVendaaVista : begin
                            if qryCaracteristicascreditarvendaavista.AsInteger<>0 then
                               qryConsultaContaContabil.MacroByName('consulta').AsString :=
                                  'and codigo <> '+qryCaracteristicascreditarvendaavista.AsString;
                            Abre(ctConsultaContaContabil);
                           end;
   tpCreditarVendaaVista : begin
                            if qryCaracteristicasdebitarvendaavista.AsInteger<>0 then
                               qryConsultaContaContabil.MacroByName('consulta').AsString :=
                                  'and codigo <> '+qryCaracteristicasdebitarvendaavista.AsString;
                            Abre(ctConsultaContaContabil);
                           end;
    tpDebitarVendaaPrazo : begin
                            if qryCaracteristicascreditarvendaaprazo.AsInteger<>0 then
                               qryConsultaContaContabil.MacroByName('consulta').AsString :=
                                  'and codigo <> '+qryCaracteristicascreditarvendaaprazo.AsString;
                            Abre(ctConsultaContaContabil);
                           end;
   tpCreditarVendaaPrazo : begin
                            if qryCaracteristicasdebitarvendaaprazo.AsInteger<>0 then
                               qryConsultaContaContabil.MacroByName('consulta').AsString :=
                                  'and codigo <> '+qryCaracteristicasdebitarvendaaprazo.AsString;
                            Abre(ctConsultaContaContabil);
                           end;
    tpDebitarAbatimentos : begin
                            if qryCaracteristicascreditarabatimentos.AsInteger<>0 then
                               qryConsultaContaContabil.MacroByName('consulta').AsString :=
                                  'and codigo <> '+qryCaracteristicascreditarabatimentos.AsString;
                            Abre(ctConsultaContaContabil);
                           end;
   tpCreditarAbatimentos : begin
                            if qryCaracteristicasdebitarabatimentos.AsInteger<>0 then
                               qryConsultaContaContabil.MacroByName('consulta').AsString :=
                                  'and codigo <> '+qryCaracteristicasdebitarabatimentos.AsString;
                            Abre(ctConsultaContaContabil);
                           end;
    tpDebitarDevolucoes : begin
                            if qryCaracteristicascreditardevolucoes.AsInteger<>0 then
                               qryConsultaContaContabil.MacroByName('consulta').AsString :=
                                  'and codigo <> '+qryCaracteristicascreditardevolucoes.AsString;
                            Abre(ctConsultaContaContabil);
                           end;
   tpCreditarDevolucoes : begin
                            if qryCaracteristicasdebitarabatimentos.AsInteger<>0 then
                               qryConsultaContaContabil.MacroByName('consulta').AsString :=
                                  'and codigo <> '+qryCaracteristicasdebitardevolucoes.AsString;
                            Abre(ctConsultaContaContabil);
                           end;
  tpHistoricoVendaaVista,
  tpHistoricoVendaaPrazo,
  tpHistoricoAbatimentos,
  tpHistoricoDevolucoes   : abre(ctConsultaHistoricos);
              tpCLIENTE : begin
                            qryConsultaClientes.MacroByName('CONSULTA').AsString := 'and false';
                            Abre(ctConsultaClientes);
  end;                    end;
end;

procedure TdtmCadastroProdutos.FechaTabelasConsulta(TipoProcura: TipoProcuraProdutosEstoque);
begin
  case TipoProcura of
       //tpCARACTERISTICAS : Fecha(ctProcuraCaracteristicas);
             tpSIMILARES : Fecha(ctProcuraCaracteristicasSimilar);
                tpGRUPOS : Fecha(ctProcuraGrupos);
                tpCLASSE : Fecha(ctProcuraClasse);
             tpOBSLEGAIS : Fecha(ctProcuraObsLegais);
              tpUNIDADES : Fecha(ctProcuraUnidades);
                   tpIPI : Fecha(ctProcuraIPI);
                  tpICMS : Fecha(ctProcuraICMS);
         tpDescricaonaNF : qryDescricaoProdutoNF.Close;
                tpMARCAS : Fecha(ctProcuraMarcas);
  tpCOLUNASCOLUNASPRECOS : Fecha(ctProcuraColunas);
          tpFORNECEDORES : Fecha(ctFornecedoresProdutos);
               tpFATORES : Fecha(ctConsultaFatoresPreco);
    tpPRECOS,
    tpPRECOSPRODUTOS,
   tpPRECOSCOLUNASPRECOS,
   tpCONSULTAPRECOSPRODUTOS : Fecha(ctProcuraPrecos);
    tpORIGENS            : Fecha(ctProcuraOrigem);
    tpINCIDENCIAS        : Fecha(ctProcuraIncidencia);
              tpESTOQUES : Fecha(ctProcuraFiliais);
    tpLINHAGRADE,
    tpCOLUNAGRADE        : Fecha(ctConsultaGrades);
    tpDebitarVendaaVista,
    tpCreditarVendaaVista,
    tpDebitarAbatimentos,
    tpCreditarDevolucoes  : fecha(ctConsultaContaContabil);
    tpHistoricoVendaaVista,
    tpHistoricoVendaaPrazo,
    tpHistoricoAbatimentos,
    tpHistoricoDevolucoes : fecha(ctConsultaHistoricos);
                tpCLIENTE : fecha(ctConsultaClientes);
  end;
end;

