procedure TdtmCadastroProdutos.qryProdutosLotesAfterPost(
  DataSet: TDataSet);
begin
  inherited;
  vOldValue := qryProdutosLotesquantidade.asCurrency;
  CalcularSaldoLote;
end;

procedure TdtmCadastroProdutos.CalcularSaldoLote;
begin
  qryEstoquesFiliais.edit;
  qryEstoquesFiliaissaldopendente.asCurrency := qryEstoquesFiliaisemestoque.asCurrency -
                                                somarValores(qryProdutosLotes, [qryProdutosLotesquantidade],
                                                [],[],[]);
  qryEstoquesFiliais.post;                                              

end;

procedure TdtmCadastroProdutos.qryProdutosLotesNewRecord(
  DataSet: TDataSet);
begin
  inherited;
  qryProdutosLotesfilial.asInteger := qryEstoquesFiliaisfilial.asInteger;
  qryProdutosLotesquantidade.ascurrency := qryEstoquesFiliaissaldopendente.asCurrency;
end;

procedure TdtmCadastroProdutos.qryProdutosLotesAfterDelete(
  DataSet: TDataSet);
begin
  inherited;
  CalcularSaldoLote;
end;

procedure TdtmCadastroProdutos.qryProdutosLotesAfterInsert(
  DataSet: TDataSet);
begin
  inherited;
  if qryEstoquesFiliaissaldopendente.ascurrency <= 0 then
    qryProdutosLotes.cancel;
end;

function TdtmCadastroProdutos.GetSaldoControleLote: Currency;
begin
  fSaldoControleLote := somarValores(qryEstoquesFiliais, [qryEstoquesFiliaissaldopendente], [], [], []);
  Result := fSaldoControleLote;
end;

function TdtmCadastroProdutos.DadosLotesProdutosOK: boolean;
begin

  {Reatuliza a consulta para garantir que durante a definição o saldo continua o mesmo)}

  RefazConsultaPorNome(qryEstoquesFiliais, ['produto'], [qryProdutoscodigo.asString]);
  qryEstoquesFiliais.first;
  while not qryEstoquesFiliais.eof do
  begin
    CalcularSaldoLote;
    qryEstoquesFiliais.next;
  end;

  result := true;
  qryEstoquesFiliais.first;
  while not qryEstoquesFiliais.eof do
  begin

    if qryEstoquesFiliaissaldopendente.ascurrency <> 0 then
    begin
      result := false;
      MensagemAviso('A coluna "SALDO" deve estar zerada');
      break;
    end;

    qryProdutosLotes.first;
    while not qryProdutosLotes.eof do
    begin
      if trim(qryProdutosLotesnlote.asstring)='' then
      begin
        result := false;
        MensagemAviso('A coluna "Nº LOTE" deve estar preenchida');
        qryProdutosLotesnlote.focuscontrol;
        break;
      end;

      if qryProdutosLotesdval.isnull then
      begin
        result := false;
        MensagemAviso('A coluna "VALIDADE" deve estar preenchida');
        qryProdutosLotesdval.focuscontrol;
        break;
      end;

      if qryProdutosLotesquantidade.asCurrency = 0 then
      begin
        result := false;
        MensagemAviso('A coluna "QUANTIDADE" deve conter um valor');
        qryProdutosLotesquantidade.focuscontrol;
        break;
      end;

      qryProdutosLotes.next;

    end;

    if not result then
      break;


    qryProdutosLotes.last;
    while not qryProdutosLotes.bof do
    begin

      if LoteJaCadastrado then
      begin
        result := false;
        mensagemAviso('O número do lote não pode estar duplicado');
        qryProdutosLotesnlote.focuscontrol;
        break;
      end;


      qryProdutosLotes.prior;

    end;

    if not result then
      break;
    



    if somarValores(qryProdutosLotes, [qryProdutosLotesquantidade], [], [], []) <> qryEstoquesFiliaisemEstoque.asCurrency then
    begin
      result := false;
      MensagemAviso('A soma da coluna "QUANTIDADE" difere da coluna "EM ESTOQUE"');
      break;
    end;

    qryEstoquesFiliais.next
  end;
end;

procedure TdtmCadastroProdutos.dsrProdutosLotesDataChange(Sender: TObject;
  Field: TField);
begin
  inherited;
  if field = qryProdutosLotesquantidade then
  begin
    if field.value > (qryEstoquesFiliaissaldopendente.asCurrency + vOldValue) then
    begin
      mensagemAviso('A quantidade não pode ultrapassar o saldo');
      field.clear;
    end;
  end
  else
  if field = qryProdutosLotesnlote then
  begin
    {
    if LoteJaCadastrado then
    begin
      mensagemAviso('O número do lote não pode estar duplicado');
      field.clear;
    end;
    }
  end;
end;

function TdtmCadastroProdutos.LoteJaCadastrado: boolean;
var
  vRecno : integer;
  vNLote : String;
begin
  result := false;
  vRecno := qryProdutosLotes.recno;
  vNLote := qryProdutosLotesnlote.asString;

  try
//    if vNLote <> '' then
    begin

      guardarRegistroAtual(qryProdutosLotes, true);
      qryProdutosLotes.first;
      while not qryProdutosLotes.eof do
      begin

        if qryProdutosLotes.recno <> vRecno then
          if  (vNLote = qryProdutosLotesnlote.asString) then
          begin
            result := true;
            break;
          end;

        qryProdutosLotes.next;
      end;
    end;  

  finally
    VoltarRegistroAtual(qryProdutosLotes);
  end;
end;

procedure TdtmCadastroProdutos.qryProdutosLotesAfterScroll(
  DataSet: TDataSet);
begin
  inherited;
  vOldValue := qryProdutosLotesquantidade.asCurrency;
end;

function TdtmCadastroProdutos.ProcessarInclusaodeLotes: boolean;
var
  vCodigoPreco : integer;
  vValorGrade1, vValorGrade2 : Variant;
  vTotalFinanceiro : Currency;
begin
  result := true;
  vCodigoPreco := qryprodutospreco.asinteger;

  vValorGrade1 := qryProdutosvalorgrade1.asVariant;
  vValorGrade2 := qryProdutosvalorgrade2.asVariant;

  //Bloqueando o estoque

  try

    qryMovimentos.open;

    ProcessandoInclusaodeLotes := true;
    qryProdutos.edit;
    qryProdutosinativo.asDateTime := DataServidor;
    qryProdutos.post;

    perpetrar([qryprodutos], AguardareTerminarDentroDm);

    qryEstoquesFiliais.macrobyname('Bloquear').asString := 'for update';
    RefazConsultaPorNome(qryEstoquesFiliais, ['produto'], [qryProdutoscodigo.asString]);
    qryEstoquesFiliais.macrobyname('Bloquear').asString := '';

    qryEstoquesFiliais.first;
    while not qryEstoquesFiliais.eof do
    begin
      vTotalFinanceiro := 0;

      qryProdutosLotes.first;
      while not qryProdutosLotes.eof do
      begin
        qryProdutos.append;
        qryProdutoscaracteristica.AsLargeInt:= qryCaracteristicascodigo.AsLargeInt;
        qryProdutosdescricao.AsString       := qryCaracteristicasdescricao.AsString { + ' Lt ' + qryProdutosLotesnlote.asString};
        qryProdutospreco.AsInteger          := vCodigoPreco;

        qryProdutosvalorgrade1.asVariant := vValorGrade1;
        qryProdutosvalorgrade2.asVariant := vValorGrade2;

        RefazConsulta(spcProdutoProximo,[0],[qryCaracteristicascodigo.AsLargeInt]);
        qryProdutoscodigo.AsLargeInt:= spcProdutoProximocodigo.AsLargeInt;
        qryProdutoscodigovisual.AsString := qryProdutoscodigo.AsString;
        qryProdutosnlote.asString := qryProdutosLotesnlote.asString;
        qryProdutosdval.asDateTime := qryProdutosLotesdval.asDateTime;

        spcProdutoProximo.Close;
        qryProdutos.post;

        perpetrar([qryprodutos], AguardareTerminarDentroDm);
        qryprodutos.last;

        spcMovimentosProximo.Open;
        qryMovimentos.Append;
        qryMovimentosnumero.AsInteger        := spcMovimentosProximovalor.AsInteger;
        qryMovimentosproduto.asString := qryEstoquesFiliaisproduto.asString;
        qryMovimentosdata.asDateTime := DataServidor;
        qrymovimentosfilial.asinteger :=  qryEstoquesFiliaisfilial.asinteger;
        qryMovimentosQuantidade.asFloat := qryProdutosLotesquantidade.asFloat;
        {DECREMENTA QTDE PARA CRIAÇÃO DE LOTE}
        qryMovimentostipomovimento.asString := 'DQL';
        qryMovimentosreferencia.asstring := 'TRANSFERIDO PARA O LOTE '+qryProdutosLotesnlote.asString;

        if qryProdutosLotes.recno = qryProdutosLotes.recordcount then
          qryMovimentosvalor.asCurrency := qryEstoquesFiliaisfinanceiro.asCurrency  - vTotalFinanceiro
        else
          qryMovimentosvalor.asCurrency := roundto(qryEstoquesFiliaisfinanceiro.asCurrency / qryMovimentosQuantidade.asFloat, -2);

        qryMovimentos.post;
        perpetrar([qryMovimentos], AguardareTerminarDentroDm);
        spcMovimentosProximo.Close;

        spcMovimentosProximo.Open;
        qryMovimentos.Append;
        qryMovimentosnumero.AsInteger        := spcMovimentosProximovalor.AsInteger;
        qryMovimentosproduto.asString := qryProdutoscodigo.asString;
        qryMovimentosdata.asDateTime := DataServidor;
        qrymovimentosfilial.asinteger :=  qryEstoquesFiliaisfilial.asinteger;
        qryMovimentosQuantidade.asFloat := qryProdutosLotesquantidade.asFloat;
        {INCREMENTA QTDE PARA CRIAÇÃO DE LOTE}
        qryMovimentostipomovimento.asString := 'IQL';
        if qryProdutosLotes.recno = qryProdutosLotes.recordcount then
          qryMovimentosvalor.asCurrency := qryEstoquesFiliaisfinanceiro.asCurrency  - vTotalFinanceiro
        else
          qryMovimentosvalor.asCurrency := roundto(qryEstoquesFiliaisfinanceiro.asCurrency / qryMovimentosQuantidade.asFloat, -2);

        qryMovimentosreferencia.asstring := 'CRIAÇÃO DO LOTE '+qryProdutosLotesnlote.asString;

        vTotalFinanceiro := vTotalFinanceiro + qryMovimentosvalor.asCurrency;

        qryMovimentos.post;
        perpetrar([qryMovimentos], AguardareTerminarDentroDm);
        spcMovimentosProximo.Close;

        qryProdutosLotes.next;
      end;
      qryEstoquesFiliais.next;
    end;

    try
      result := perpetrar([qryCaracteristicas, qryProdutos, qryMovimentos]);
    except

     on E: Exception do
     begin
       ShowMessage(E.Message);
       ReFazConsultaProdutos;
     end

    end;

  finally

    ProcessandoInclusaodeLotes := false;
    qryEstoquesFiliais.close;
    qryMovimentos.close;

  end;

end;

