procedure TdtmCadastroProdutos.ReFazConsultaSimilares;
begin
  if (qryCaracteristicascodigo.AsLargeInt > 0) then
    ReFazConsulta(qrySimilares,[0],[qryCaracteristicascodigo.AsLargeInt]);

   RefazConsultaPorNome(qryProdutos_Similares, ['produto'], [qryProdutoscodigo.asLargeint]);

end;

procedure TdtmCadastroProdutos.qryCaracteristicasAfterOpen(DataSet: TDataSet);
begin
  inherited;
  if (qryCaracteristicascodigo.AsLargeInt > 0) then begin
    if not (qryCaracteristicas.State = dsInsert) then
      RefazConsultaCaracteristica;
  end;
end;

function TdtmCadastroProdutos.GetInserindoProduto: boolean;
begin
  Result:= qryProdutos.State = dsInsert;
end;

procedure TdtmCadastroProdutos.qryProdutosAfterScroll(DataSet: TDataSet);
var
 vValor : Boolean;

begin
  inherited;

  if mcaESTOQUES in ExibirProduto then
    ReFazConsultaEstoques;

  if mcaCODIGOSBARRAS in ExibirProduto then
    ReFazConsultaCodigoBarras;

  if FExibirCaracteristicas = mcaFORNECEDORES then
    ReFazConsultaFornecedoresProdutos;

  if mcaCLIENTES in ExibirProduto then
    RefazConsultaClientesProdutos;

  if mcaPRODUTOSCARGOS in ExibirProduto then
    RefazConsultaProdutosCargos;

  if FExibirProdutoComposto then
  begin
    ReFazConsultaProdutoComposto;
    ReFazConsultaProduto_Servicos;
    ReFazConsultaProdutoCompostoFios;
    ReFazConsultaProdutoCompostoFitas;
  end;

  qryProdutosdescricao.ReadOnly := False;
  if parsistema.ControlesVoltadosparaIndustria then
  begin
    vValor := (dtmCadastroProdutos.qryProdutos.State <> dsinsert) and not UsuarioLogin.GerenteTecnico;
    qryProdutosdescricao.ReadOnly := vValor;
  end;

  if mcaPRODUTOSFORNECEDORES in ExibirProduto then
    ReFazConsultaProdutosFornecedores;

  if mcaPRODUTOSFORNECEDORESUNIDADES in ExibirProduto then
    RefazConsultaProdutosFornecedoresUnidades;

  if mcaPRODUTOSESTADOS in ExibirProduto then
    RefazConsultaProdutosEstados;

  if qryProdutoscodigo.asString<>'' then
    RefazConsultaPorNome(qryProdutosAgendamentos, ['produto'], [qryProdutoscodigo.asString])
  else
    RefazConsultaPorNome(qryProdutosAgendamentos, ['produto'], ['0']);

  if ExibirCaracteristicas = mcaSIMILARES then
    RefazConsultaPorNome(qryProdutos_Similares, ['produto'], [qryProdutoscodigo.asString]);

end;

procedure TdtmCadastroProdutos.dsrFornecedoresProdutosDataChange(Sender: TObject; Field: TField);
begin
  inherited;
  if ((Field = qryFornecedoresProdutospreco) or
      (Field = qryFornecedoresProdutosipi))  then begin
//     if (qryFornecedoresProdutos.State in [dsEdit, dsInsert]) then
       qryFornecedoresProdutosprecocomipi.AsCurrency:= qryFornecedoresProdutospreco.AsCurrency +
                                                       ((qryFornecedoresProdutospreco.AsCurrency *
                                                         qryFornecedoresProdutosipi.AsFloat) / 100);
       qryFornecedoresProdutosdata.AsDateTime:= DataServidor;
  end;
end;

