  Sender: TObject; Field: TField);
begin
  inherited;

  if field = qryProdutos_Similaresproduto then
  begin
    ;
  end;

end;

procedure TdtmCadastroProdutos.qrySimilaresNewRecord(DataSet: TDataSet);
begin
  inherited;
  qrySimilarescaracteristica.AsLargeInt := qryCaracteristicascodigo.AsLargeInt;
end;

procedure TdtmCadastroProdutos.CopiarDescricaoParaNomeSite;
var
  vModalResult : TModalResult;

  procedure AtribuirDadosNomeSite(Todos: Boolean);
  begin

    try
      qryProdutos.GuardarRegistroAtual(true);

      if todos then
        qryProdutos.first;

      while not qryProdutos.Eof do
      begin
        qryProdutos.edit;
        qryProdutosnome_site.AsString := qryProdutosdescricao.AsString;
        qryprodutos.Post;

        if todos then
          qryProdutos.next
        else
          break;
      end;

    finally
      qryProdutos.VoltarRegistro;
    end;

  end;

begin

  vModalResult := MensagemSimNaoOpcaoCancelar('Copiar o campo "DESCRIÇÃO" para o campo "NOME NO SITE"', '', true, 'Todos Registros', 'Somente o Atual');

  case vModalResult of
   mrYes    : AtribuirDadosNomeSite(true);
   mrNO     : AtribuirDadosNomeSite(false);
   mrCancel :;
  end;

end;

procedure TdtmCadastroProdutos.dsrSimilaresDataChange(Sender: TObject;
  Field: TField);
begin
  inherited;
  if (field = qrySimilaressimilarvisual) then
  begin
    dsrSimilares.OnDataChange := nil;
    qrySimilaresdescricao.asString := qryProcuraSimilaresdescricao.asString;
    qrySimilaressimilar.AsString :=  qryProcuraSimilarescodigo.asString;
    dsrSimilares.OnDataChange := dsrSimilaresDataChange;
  end
  else
  if (field = qrySimilaressimilar) then
  begin
    dsrSimilares.OnDataChange := nil;
    qrySimilaresdescricao.asString := qryProcuraSimilaresdescricao.asString;
    qrySimilaressimilarvisual.asString := qryProcuraSimilarescodigovisual.asString;
    dsrSimilares.OnDataChange := dsrSimilaresDataChange;
  end;
end;

procedure TdtmCadastroProdutos.qryFornecedoresProdutosBeforeDelete(
  DataSet: TDataSet);
begin
  inherited;
  RefazConsultaPorNome(qryFornecedoresProdutosAux, ['fornecedor','caracteristica'],
      [qryFornecedoresProdutosfornecedor.asinteger,
       qryFornecedoresProdutoscaracteristica.asLargeint]);
  if qryFornecedoresProdutosAux.recordcount = 1 then
    qryFornecedoresProdutosAux.delete ;

  perpetrar([qryFornecedoresProdutosAux]);
end;

function TdtmCadastroProdutos.GetProduto: String;
begin
  result := qryProdutoscodigo.asString;
end;

procedure TdtmCadastroProdutos.qryProdutoCompostoBeforePost(
  DataSet: TDataSet);
begin
  inherited;
  qryProdutoCompostomodoalteracao.asString := 'P' {alteração pelo produto, o mesmo valor servira de flag para que indicar a alteração diretamente no cadastro
          para evitar o rateio na trigger colunasprecos_depoisatualizarvalor
          após a trigger o valor será setado para null para que as demais alterações sigam o fluxo normal }
end;

end.
