  DataSet: TDataSet);
begin
  inherited;
  qryProcuraColunaGrade.Params[1].AsInteger := qryProcuraLinhaGradecodigo.AsInteger;
  if Assigned(OnScrollLinhaGrade) then
    OnScrollLinhaGrade(qryProcuraLinhaGrade);

end;

