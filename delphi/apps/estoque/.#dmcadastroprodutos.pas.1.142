procedure TdtmCadastroProdutos.InverterLinha_x_Coluna;
var
 vLinha, vColuna: Variant;
 vGrade1, vGrade2: Variant;
begin
  dsrCaracteristicas.onDataChange := nil;
  vGrade1 := qryCaracteristicasgrade1.asVariant;
  vGrade2 := qryCaracteristicasgrade2.asVariant;

  qryCaracteristicas.edit;
  qryCaracteristicasgrade1.asVariant := vGrade2;
  qryCaracteristicasgrade2.asVariant := vGrade1;

  AtualizandoItens := true;

  qryProdutos.first;
  while not qryProdutos.eof do
  begin
    vGrade1 := qryProdutosvalorgrade1.asVariant;
    vGrade2 := qryProdutosvalorgrade2.asVariant;

    qryProdutos.edit;
    qryProdutosvalorgrade1.asVariant := vGrade2;
    qryProdutosvalorgrade2.asVariant := vGrade1;
    qryProdutos.post;

    qryProdutos.next;

  end;
  
  AtualizandoItens := false;
  dsrCaracteristicas.onDataChange := dsrCaracteristicasDataChange;

//  GravarCaracteristica;
end;

