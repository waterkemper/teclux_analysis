procedure TdtmCadastroProdutos.dsrCaracteristicasDataChange(Sender: TObject; Field: TField);
var
  vNomeCampo : String;
begin
  inherited;
  if field <> nil then
    vNomeCampo := Field.fieldname;

  if Field = qryCaracteristicascst then
    VerificarCorrelacoes_cst_x_csosn
  else
  if field = qryCaracteristicascsosn then
    VerificarCorrelacoes_csosn_x_cst
  else
  if Field = qryCaracteristicasdebitarvendaavista then
    qryProcuraCreditaraVista.Params[1].AsInteger := qryCaracteristicasdebitarvendaavista.AsInteger
  else if field = qryCaracteristicascreditarvendaavista then
    qryProcuraDebitaraVista.Params[1].AsInteger := qryCaracteristicascreditarvendaavista.AsInteger
  else if Field = qryCaracteristicasdebitarvendaaprazo then
    qryProcuraCreditaraPrazo.Params[1].AsInteger := qryCaracteristicasdebitarvendaaprazo.AsInteger
  else if field = qryCaracteristicascreditarvendaaprazo then
    qryProcuraDebitaraPrazo.Params[1].AsInteger := qryCaracteristicascreditarvendaaprazo.AsInteger
  else if Field = qryCaracteristicasdebitarabatimentos then
    qryProcuraCreditarAbatimentos.Params[1].AsInteger := qryCaracteristicasdebitarabatimentos.AsInteger
  else if field = qryCaracteristicascreditarabatimentos then
    qryProcuraDebitarAbatimentos.Params[1].AsInteger := qryCaracteristicascreditarabatimentos.AsInteger
  else if Field = qryCaracteristicasdebitardevolucoes then
    qryProcuraCreditarDevolucoes.Params[1].AsInteger := qryCaracteristicasdebitardevolucoes.AsInteger
  else if field = qryCaracteristicascreditardevolucoes then
    qryProcuraDebitarDevolucoes.Params[1].AsInteger := qryCaracteristicascreditardevolucoes.AsInteger
  else
  if field = qryCaracteristicasbitola then
  begin
    if PossuiSomenteNumero(qryCaracteristicasbitola.asstring) and
       (length(trim(qryCaracteristicasbitola.asstring))<>4) then
      qryCaracteristicasbitola.AsString := preencheString(qryCaracteristicasbitola.AsString, '0', 4, false);
  end
  else
  if field = qryCaracteristicasliga then
  begin
    if PossuiSomenteNumero(qryCaracteristicasliga.asstring) and
       (length(trim(qryCaracteristicasliga.asstring))<>3)  then
      qryCaracteristicasliga.AsString := preencheString(qryCaracteristicasliga.AsString, '0', 3, false);
  end
  else
  if field = qryCaracteristicaslargura then
  begin
    if PossuiSomenteNumero(qryCaracteristicaslargura.asstring) and
       (length(trim(qryCaracteristicaslargura.asstring))<>3) then
      qryCaracteristicaslargura.AsString := preencheString(qryCaracteristicaslargura.AsString, '0', 3, false);
  end
  else
  if field = qryCaracteristicasdescricao then
  begin
    if copy(uppercase(qryCaracteristicasdescricao.AsString),1,3)='FIO' then
    begin
      if qryCaracteristicasbitola.IsNull or (qryCaracteristicasbitola.asstring='') then
        qryCaracteristicasbitola.AsString := copy(qryCaracteristicascodigovisual.AsString,1,4);

      if qryCaracteristicasliga.IsNull or (qryCaracteristicasliga.asstring='') then
        qryCaracteristicasliga.AsString := copy(qryCaracteristicascodigovisual.AsString,6,3);
    end;
  end
  else
  if field = qryCaracteristicasgrade1 then
  begin
    if field.isnull or
       (field.oldvalue <> field.value) then
    begin
      AtualizandoItens := true;
      AtribuirDados(qryprodutos, [qryProdutosValorGrade1], [null]);
      AtualizandoItens := false;
    end;
  end
  else
  if field = qryCaracteristicasgrade2 then
  begin
    if field.isnull or
       (field.oldvalue <> field.value) then
    begin
      AtualizandoItens := true;
      AtribuirDados(qryprodutos, [qryProdutosValorGrade2], [null]);
      AtualizandoItens := false;

    end;
  end
  else
  if field = qryCaracteristicasgerenciarloteevalidade then
  begin
    if qryCaracteristicasgerenciarloteevalidade.asboolean then
    begin
      if qryProdutos.recordcount = 1 then
      begin
        RefazConsultaPorNome(qryEstoquesFiliais, ['produto'], [qryProdutoscodigo.asString]);
        RefazConsultaPorNome(qryTotaisEstoquesFiliais, ['produto'], [qryProdutoscodigo.asString]);

        if qryTotaisEstoquesFiliaisoutrostotais.ascurrency <> 0 then
        begin
          frmMensagemGridNfe := TfrmMensagemGridNfe.Create(frmMensagemGridNfe);
          frmMensagemGridNfe.lblTitulo.caption := 'O controle de lote e validade só pode conter totais na coluna ''em Estoque''';
          frmMensagemGridNfe.lblTitulo.font.size := -11;
          qryEstoquesFiliaissaldopendente.visible := false;
          frmMensagemGridNfe.dsrListaErros.DataSet := qryEstoquesFiliais;
          frmMensagemGridNfe.TipoOrigem := EstoqueLoteProduto;
          frmMensagemGridNfe.dbgMensagem.Options := frmMensagemGridNfe.dbgMensagem.Options + [goVertLine];
          frmMensagemGridNfe.ShowModal;
          qryCaracteristicasgerenciarloteevalidade.asboolean := false;
          qryEstoquesFiliaissaldopendente.visible := true;
        end
        else
        begin
          RefazConsultaPorNome(qryProdutosLotes, ['produto'], [qryProdutoscodigo.asString]);
          frmDefinirLoteeValidade := TfrmDefinirLoteeValidade.create(frmDefinirLoteeValidade);
          if frmDefinirLoteeValidade.showmodal = mrok then
            ProcessarInclusaodeLotes
          else
            qryCaracteristicasgerenciarloteevalidade.asboolean := false;
        end;
      end
      else
      begin
        if qryProdutos.recordcount <> 0 then
        begin
          if not qryCaracteristicasexistelote.asboolean then
          begin
            mensagemAviso('O controle de lote e validade é restrito a mais de um produto');
            qryCaracteristicasgerenciarloteevalidade.asboolean := false;
          end;
        end;
      end;
    end;
    qryProdutosnlote.Visible := qryCaracteristicasgerenciarloteevalidade.asboolean;
    qryProdutosdval.Visible := qryCaracteristicasgerenciarloteevalidade.asboolean;
    qryProdutosnlote.required := qryCaracteristicasgerenciarloteevalidade.asboolean;
    qryProdutosdval.required := qryCaracteristicasgerenciarloteevalidade.asboolean;

    qryProdutosvalorgrade1.visible := (LinhadaGrade<>'');
    qryProdutosvalorgrade2.visible := (ColunadaGrade<>'');


    qryProdutos.OcultarColunasGrid;
  end
  else
  if field = qryCaracteristicascomposto then
  begin
    dsrCaracteristicas.OnDataChange := nil;


    if not field.AsBoolean then
    begin
      if not PermiteAlterarComposto and not qryCaracteristicascomposto2.AsBoolean then
      begin
        field.AsBoolean := true;
        mensagemAviso('Já existem movimentações neste composto.'+chr(13)+'A definição de composto/conjunto não pode ser alterada.');
      end;
    end
    else
      qryCaracteristicascomposto2.AsBoolean := not field.AsBoolean;

    dsrCaracteristicas.OnDataChange := dsrCaracteristicasDataChange;
  end
  else
  if field = qryCaracteristicascomposto2 then
  begin
    dsrCaracteristicas.OnDataChange := nil;

    if not field.AsBoolean then
    begin
      if not PermiteAlterarComposto and not qryCaracteristicascomposto.AsBoolean then
      begin
        field.AsBoolean := true;
        mensagemAviso('Já existem movimentações neste composto.'+chr(13)+'A definição de composto/conjunto não pode ser alterada.');
      end;
    end
    else
      qryCaracteristicascomposto.AsBoolean := not field.AsBoolean;

    dsrCaracteristicas.OnDataChange := dsrCaracteristicasDataChange;
  end;
end;

function TdtmCadastroProdutos.getProdutoForaLinha: Boolean;
begin
  Result:= ((qryCaracteristicasforalinha.AsDateTime > 0) and
            (qryCaracteristicasforalinha.AsDateTime <= DataServidor)) or
           ((qryProdutosforalinha.AsDateTime > 0) and
            (qryProdutosforalinha.AsDateTime <= DataServidor));

end;

function TdtmCadastroProdutos.getProdutoInativo: boolean;
begin
  Result:= ((qryCaracteristicasinativo.AsDateTime > 0) and
            (qryCaracteristicasinativo.AsDateTime <= DataServidor)) or
           ((qryProdutosinativo.AsDateTime > 0) and
           (qryProdutosinativo.AsDateTime <= DataServidor));

end;

function TdtmCadastroProdutos.ItemProdutoPodeInserir(Codigo, Descricao: String): Boolean;
var
  Sql,
  CodigoProduto,
  DescricaoProduto,
  CodigoCaracteristica : String;
begin
  Result:= True;
  CodigoProduto   := '0';
  DescricaoProduto:= '';
  if (FCodigoProdutoAntesEditar <> Codigo) or (qryProdutos.State = dsInsert) then
    CodigoProduto := Codigo;
  if (FDescricaoProdutoAntesEditar <> Descricao) or (qryProdutos.State = dsInsert) then
    DescricaoProduto := Descricao;

  if (qryProdutos.State in [dsInsert, dsEdit]) then begin
    Sql:= '';
    if trim(CodigoProduto) <> '0' then
    begin

      {if ParSistema.PermitirProdutoAlfanumerico then}
        Sql:='(upper(to_ascii(p.codigovisual,''latin1'')) = '+quotedstr(ANSIUpperCase(CodigoProduto))+ ') or'
{
      else
        Sql:= '(p.codigo = ' + CodigoProduto + ') or';}
    end;

    if (trim(DescricaoProduto) <> '') and Not ParSistema.PermitiProdutoMesmaDescricao then
      if (qryCaracteristicasgrade1.asinteger = 0) and (qryCaracteristicasgrade2.asinteger = 0) then
        Sql:= Sql + '(p.descricao = ' + QuotedStr(DescricaoProduto) + ') or';

    if Sql = '' then
      qryExisteItemProduto.MacroByName('Produto').AsString:= 'False'
    else begin
      Delete(Sql,Length(Sql)-1,2);
      qryExisteItemProduto.MacroByName('Produto').AsString:= Sql;
    end;
    qryExisteItemProduto.Close;
    qryExisteItemProduto.Open;

    Result:= qryExisteItemProduto.isempty;

    if not Result then
    begin

    {  if ParSistema.PermitirProdutoAlfanumerico then}
        CodigoCaracteristica := qryExisteItemProdutocaracteristicavisual.AsString;
        {
      else
        CodigoCaracteristica := qryExisteItemProdutocaracteristica.AsString;
        }

      if (qryExisteItemProdutocodigo.AsString = CodigoProduto) or
         (qryExisteItemProdutocodigovisual.AsString = CodigoProduto) then
        MensagemConfirmacao(Format(ctITEMPRODUTOJACADASTRADO,[CodigoCaracteristica+' - '+
                                                              qryExisteItemProdutodescricaocaracteristica.asstring,
                                                              'o mesmo código']))
      else
        if Not ParSistema.PermitiProdutoMesmaDescricao and (qryExisteItemProdutodescricao.AsString = DescricaoProduto) then
          MensagemAviso(Format(ctITEMPRODUTOJACADASTRADO,[CodigoCaracteristica+' - '+
                                                           qryExisteItemProdutodescricaocaracteristica.asstring,
                                                           'a mesma descrição']))
    end;
    {
    else
    begin
      RefazConsultapornome(qryExisteCaracteristica,['codigobarras','codigocaracteristica','codigocaracteristicavisual'],
                         [Codigo, qryCaracteristicascodigo.AsLargeInt, qryCaracteristicascodigovisual.AsString]);

      Result := qryExisteCaracteristica.IsEmpty;
      if not Result then
      begin
        if codigo = qryExisteCaracteristicacaracteristica.asstring then
          MensagemAviso(Format('O Código do produto está igual ao código interno da caracteristica %s',
                               [qryExisteCaracteristicacaracteristica.AsString + ' - ' +
                                qryExisteCaracteristicadescricao.AsString]))
        else
        if codigo = qryExisteCaracteristicacodigovisual.asstring then
          MensagemAviso(Format('O Código do produto esta igual ao código visual da caracteristica %s',
                               [qryExisteCaracteristicacodigovisual.AsString + ' - ' +
                                qryExisteCaracteristicadescricao.AsString]));
      end;

    end;
    }
    
  end;
end;

