  DataSet: TDataSet);
begin
  inherited;
  qryProcuraLinhaGrade.Params[1].AsInteger := qryProcuraColunaGradecodigo.AsInteger;
  if Assigned(OnScrollColunaGrade) then
    OnScrollColunaGrade(qryProcuraColunaGrade);

end;

procedure TdtmCadastroProdutos.GerarTabelaGrade;
const
 SQLColunaGrade = 'cast(null as varchar(120)) as %s';
Var
 SQLGrade, Linhas : TStringList;
 I,J,Index, Produto : Integer;
 RegistroAtual : TBookMark;
begin
 RegistroAtual := qryProdutos.GetBookmark;
 SQLGrade := TStringList.Create;
 Colunas :=  TStringList.Create;
 Linhas := TStringList.Create;
 Colunas.Duplicates := dupIgnore;
 Linhas.Duplicates := dupIgnore;
 Colunas.Sorted := True;
 Linhas.Sorted := True;
 Colunas.AddStrings(LinhasColunas[ValorColuna]);
 Linhas.AddStrings(LinhasColunas[ValorLinha]);

 AtualizandoItens := true;
 if AbreTabelaElementos then
 begin
  if (qryCaracteristicasgrade1.AsString<>'') and
     (qryCaracteristicasgrade2.AsString<>'') then
  begin
   qryLinhaColunaGrade.First;
   while not qryLinhaColunaGrade.Eof do
   begin
    if (Linhas.IndexOf(qryLinhaColunaGrade.Fields[0].AsString)=-1) then
      Linhas.Add(qryLinhaColunaGrade.Fields[0].AsString);
    if (Colunas.IndexOf(qryLinhaColunaGrade.Fields[1].AsString)=-1) then
      Colunas.Add(qryLinhaColunaGrade.Fields[1].AsString);
    qryLinhaColunaGrade.Next;
   end;
  end
  else
  if (qryCaracteristicasgrade1.AsString<>'') then
  begin
   qryLinhaColunaGrade.First;
   while not qryLinhaColunaGrade.Eof do
   begin
    if (Linhas.IndexOf(qryLinhaColunaGrade.Fields[0].AsString)=-1) then
      Linhas.Add(qryLinhaColunaGrade.Fields[0].AsString);
    qryLinhaColunaGrade.Next;
   end;
  end
  else
  if (qryCaracteristicasgrade2.AsString<>'') then
  begin
   qryLinhaColunaGrade.First;
   while not qryLinhaColunaGrade.Eof do
   begin
    if (Colunas.IndexOf(qryLinhaColunaGrade.Fields[0].AsString)=-1) then
      Colunas.Add(qryLinhaColunaGrade.Fields[0].AsString);
    qryLinhaColunaGrade.Next;
   end;
  end;
 end;

 AtualizandoItens := False;

 SQLGrade.Append('Select cast(null as varchar) as LinhaColuna,');
 if (colunas.Count >0) then
 begin
   for I:=0 to Colunas.Count -1 do
   begin
    if I<>Colunas.Count -1 then
     SQLGrade.append(format(SQLColunaGrade,['_'+inttostr(I)+',']))
    else
     SQLGrade.append(format(SQLColunaGrade,['_'+inttostr(I)]));
   end;
 end
 else
  SQLGrade.append(format(SQLColunaGrade,['_'+inttostr(0)]));

 qryGrade.Free;
 qryGrade:= TtecQuery.Create(Nil);
 qryGrade.Database := qryProcuraElementoColunaGrade.Database;
 qryGrade.SQL := SQLGrade;
 qryGrade.CachedUpdates := true;
 qrygrade.RequestLive := true;
 qryGrade.Open;
 qryGrade.Delete;
 for I:=0 to Linhas.Count -1 do
 begin
  qryGrade.Append;
  qrygrade.Fields[0].AsString := Linhas.Strings[I];
  if I=0 then
  begin

    qrygrade.Fields[0].DisplayLabel := LinhadaGrade+'/'+ColunadaGrade;
    qrygrade.Fields[0].DisplayWidth := 12;
    qrygrade.Fields[0].Alignment := taCenter;
  end;

  for J:=0 to Colunas.count-1 do
  begin
   Index := LInhasColunas[ValorLinhaColuna].indexof(Linhas.Strings[I]+Colunas.Strings[J]);
   if Index<>-1 then
   begin
    produto := strtoint(LinhasColunas[codigo].Strings[Index]);
    if qryProdutos.Locate('codigo',produto,[]) then
     qrygrade.Fields[J+1].AsString := 'Cód.: '+inttostr(produto)+chr(13)+chr(10)+
                                      //'Bar.: '+qryProdutoscodigobarras.AsString+chr(13)+chr(10)+
                                      'T.P.: '+qryProdutospreco.AsString+chr(13)+chr(10)+
                                      'Ref.: '+qryProdutosreferencia.AsString;
   end;
   if I=0 then
   begin
     qrygrade.Fields[J+1].DisplayLabel :=  Colunas.Strings[J];
     qrygrade.Fields[J+1].DisplayWidth := 16;
     qrygrade.Fields[J+1].Alignment := taCenter;
   end;
  end;
  qryGrade.Post;
 end;
 qryprodutos.GotoBookmark(RegistroAtual);
 qryProdutos.FreeBookmark(RegistroAtual);
 dsrGrade.DataSet := qryGrade;
 qrygrade.First;
 while not qrygrade.Eof do
 begin
  if qrygrade.Fields[0].AsString = qryProdutosvalorgrade1.AsString then
   break;
  qrygrade.Next;
 end;
 SQLGrade.Free;
end;

procedure TdtmCadastroProdutos.OrdenarLInhasColunas;
var
  A, B : integer;
begin
  for A := 1 to LinhasColunas[Codigo].Count - 1 do
  begin
    B := A;
    While LinhasColunas[ValorColuna].Strings[B]<
          LinhasColunas[ValorColuna].Strings[B-1] do
    begin
      LinhasColunas[Codigo].Move(B,B-1);
      LinhasColunas[ValorLinha].Move(B,B-1);
      LinhasColunas[ValorColuna].Move(B,B-1);
      if B=1 then
        break
      else
        B := B-1;
    end;
  end;
end;

function TdtmCadastroProdutos.PodeAlterarLinhaGrade: Boolean;
var
NaoTemLinhaCadastrada:Boolean;
begin
  NaoTemLinhaCadastrada:=true;
  GuardarRegistroAtual(qryProdutos,true);
  qryProdutos.First;
  while not qryProdutos.Eof do
  begin
      NaoTemLinhaCadastrada:=((qryProdutosvalorgrade1.AsString='') and (qryProdutosvalorgrade2.AsString=''));
      if(not NaoTemLinhaCadastrada) then
        break;
      qryProdutos.Next;
  end;
  VoltarRegistroAtual(qryProdutos);
  result := (linhasColunas[codigo].Count=-1) or NaoTemLinhaCadastrada;
end;

function TdtmCadastroProdutos.PosicionarLinhaColunanoProduto(Coluna: String): boolean;
begin
  result := false;
  if qryprodutos.Active then
  begin
    if (Coluna <> '') and (qrygrade.fields[0].asstring <> '') then
     result := qryprodutos.Locate('valorgrade1;valorgrade2', VarArrayOf([qrygrade.fields[0].asstring,Coluna]),[])
    else
    if (Coluna <> '') then
     result := qryprodutos.Locate('valorgrade2', Coluna,[])
    else
    if (qrygrade.fields[0].asstring <> '') then
     result := qryprodutos.Locate('valorgrade1', qrygrade.fields[0].asstring,[]);
  end;
end;

procedure TdtmCadastroProdutos.AtualizarGrade(tipooperacao :TtecTipoOperacao);
begin
   qrygrade.DisableControls;
   if qrygrade.Active then
   begin
    if (qrygrade.Fields[0].AsString<>qryProdutosvalorgrade1.AsString) then
    begin
     qrygrade.First;
     while not qrygrade.Eof do begin
      if (qrygrade.Fields[0].AsString=qryProdutosvalorgrade1.AsString) then
       break;
      qrygrade.Next
     end;
    end;

    case tipooperacao of
     tpALTERACAO :
     begin
      if (qryprodutosvalorgrade2.AsString<>
          qryProdutosvalorgrade2.OldValue) then
      begin
        qryGrade.Edit;
        qrygrade.Fields[Colunas.IndexOf(qryProdutosvalorgrade2.oldvalue)+1].Asvariant := null;
        qrygrade.Post;
      end;
      qryGrade.Edit;
      qrygrade.Fields[Colunas.IndexOf(qryProdutosvalorgrade2.AsString)+1].AsString :=
        'Cód.: '+qryProdutoscodigo.AsString+chr(13)+chr(10)+
//        'Bar.: '+qryProdutoscodigobarras.AsString+chr(13)+chr(10)+
        'T.P.: '+qryProdutospreco.AsString+chr(13)+chr(10)+
        'Ref.: '+qryProdutosreferencia.AsString;
      qrygrade.Post;
     end;
     tpEXCLUSAO :
     begin
      qryGrade.Edit;
      qrygrade.Fields[Colunas.IndexOf(qryProdutosvalorgrade2.AsString)+1].AsString := '';
      qrygrade.Post;
     end;
    end;
   end;
   qrygrade.EnableControls;
end;

procedure TdtmCadastroProdutos.AtribuiLinhaColunanoProduto(Coluna: String);
begin
 qryProdutosvalorgrade1.AsString := qrygrade.Fields[0].asstring;
 qryprodutosvalorgrade2.AsString := Coluna;
end;

procedure TdtmCadastroProdutos.dsrProdutosDataChange(Sender: TObject;
  Field: TField);
begin
  inherited;
  if (Field = qryProdutosvalorgrade1) or
     (Field = qryprodutosvalorgrade2) then
     AlteraTabelaElementos
  else
  if ((Field = qryProdutoscodigo) or (Field = qryProdutoscodigovisual)) then
  begin
     if ((qryprodutoscodigo.AsString<>'') and (qryprodutoscodigovisual.AsString<>'')) then
     begin

     //  if ParSistema.PermitirProdutoAlfanumerico then
         qryExisteItemProduto.MacroByName('Produto').AsString := '(upper(to_ascii(p.codigovisual,''latin1'')) = '+quotedstr(ANSIUpperCase(qryprodutoscodigovisual.AsString))+ ')';
  //     else
  //       qryExisteItemProduto.MacroByName('Produto').AsString := 'p.codigo = ' + qryprodutoscodigo.AsString;
       qryExisteItemProduto.Close;
       qryExisteItemProduto.Open;
       if (qryExisteItemProdutocodigo.asstring<>'') and
          (qryExisteItemProdutocaracteristica.asstring<>qryCaracteristicascodigo.AsString) then

         if MensagemConfirmacao(Format(ctITEMPRODUTOJACADASTRADO+#10#13+
         ctVINCULARCARACTERISTICAATUAL,[qryExisteItemProdutocodigovisual.AsString+' - '+
                                        qryExisteItemProdutodescricaocaracteristica.asstring,
                                        'o mesmo código'])) = smbOK then
         begin
          ReFazConsultaFornecedoresProdutos;
          ReFazConsulta(qryExisteFornecedoresProdutos,[0],[qryExisteItemProdutocaracteristica.AsVariant]);
          qryExisteFornecedoresProdutos.First;
          while not qryExisteFornecedoresProdutos.Eof do
          begin
           if not qryFornecedoresProdutos.Locate('fornecedor',qryExisteFornecedoresProdutosfornecedor.AsString,[]) then
           begin
            qryFornecedoresProdutos.Append;
            qryFornecedoresProdutoscaracteristica.AsString := qryCaracteristicascodigo.AsString;
            qryFornecedoresProdutosfornecedor.AsString     := qryExisteFornecedoresProdutosfornecedor.AsString;
            qryFornecedoresProdutosreferencia.AsString     := qryExisteFornecedoresProdutosreferencia.AsString;
            qryFornecedoresProdutospreco.AsCurrency        := qryExisteFornecedoresProdutospreco.AsCurrency;
            qryFornecedoresProdutosipi.AsCurrency          := qryExisteFornecedoresProdutosipi.Ascurrency;
            qryFornecedoresProdutosdata.AsDateTime         := qryExisteFornecedoresProdutosdata.AsDateTime;
            qryFornecedoresProdutosobservacao.AsString     := qryExisteFornecedoresProdutosobservacao.AsString;
            qryFornecedoresProdutos.post;
           end;
           qryExisteFornecedoresProdutos.Next;
          end;

          qryPrecos.first;
          while not qryPrecos.eof do
          begin
            RefazConsultaporNome(qryColunasPrecosIdenticas,
                                 ['caracteristica_produto_a_transferir',
                                  'preco_caracteristica_produto_a_transferir',
                                  'caracteristica_produto_a_receber',
                                  'preco_caracteristica_produto_a_receber'
                                 ],
                                 [qryExisteItemProdutocaracteristica.AsVariant,
                                  qryExisteItemProdutopreco.asVariant,
                                  qryCaracteristicascodigo.AsVariant,
                                  qryPrecoscodigo.asVariant
                                 ]);

            if (qryColunasPrecosIdenticas.recordcount <> 0) and
               (qryColunasPrecosIdenticas.recordcount = qryColunasPrecosIdenticasnelementos.asinteger) then
              break
            else
             qryColunasPrecosIdenticas.close;

            qryPrecos.next;
          end;

          if qryColunasPrecosIdenticas.active then
          begin
            qryExisteItemProduto.Edit;
            qryExisteItemProdutopreco.asinteger := qryPrecoscodigo.asinteger;
            qryexisteItemProduto.Post;
          end
          else
          begin

            RefazConsultaporNome(qryColunasPrecos_a_Transferir,
                                 ['caracteristica_produto_a_transferir',
                                  'preco_caracteristica_produto_a_transferir'
                                 ],
                                 [qryExisteItemProdutocaracteristica.AsVariant,
                                  qryExisteItemProdutopreco.asVariant]);

            if qryColunasPrecos_a_Transferir.recordcount <> 0 then
            begin

              IncluirPreco(false);
              qryPrecosdescricao.asString := qryColunasPrecos_a_Transferirdescricao.asString + ' '+ inttostr(qryPrecos.recordcount + 1);
              GravarPreco;
              qryPrecos.last;

              qryColunasPrecos_a_Transferir.first;
              while not qryColunasPrecos_a_Transferir.eof do
              begin
                IncluirColunaPreco(false);
                qryColunasPrecosvalor.ascurrency := qryColunasPrecos_a_Transferirvalor.ascurrency;
                qryColunasPrecoscoluna.AsInteger := qryColunasPrecos_a_Transferircoluna.asinteger;
                qryColunasPrecoscolunasdescricao.asString := qryColunasPrecos_a_Transferircolunadescricao.asString;
                qryColunasPrecosvalidade.AsDateTime := qryColunasPrecos_a_Transferirvalidade.AsDateTime;
                GravarColunaPreco;
                qryColunasPrecos_a_Transferir.next;
              end;

              qryExisteItemProduto.Edit;
              qryExisteItemProdutopreco.asinteger := qryPrecoscodigo.asinteger;
              qryexisteItemProduto.Post;

            end;

          end;

          qryExisteItemProduto.Edit;
          qryExisteItemProdutocaracteristica.AsString := qryCaracteristicascodigo.AsString;
          qryexisteItemProduto.Post;

          Perpetrar([qryexisteitemProduto, qryfornecedoresprodutos]);

          ReFazConsultaProdutos;
          if qryprodutos.Locate('codigo', qryExisteItemProdutocodigo.AsString,[]) then
          begin
            qryprodutos.Edit;
          end;

         end;
     end;
  end;
end;

procedure TdtmCadastroProdutos.qryProdutosCalcFields(DataSet: TDataSet);
begin
  inherited;
  qryProdutosdescricaolc.AsString :=
   qryProdutosdescricao.AsString+' '+
   qryProdutosvalorgrade1.AsString+' '+
   qryProdutosvalorgrade2.AsString;
end;


function TdtmCadastroProdutos.ProdutoExistente: boolean;
begin
  result := qryProdutos.RecordCount >0;
end;

function TdtmCadastroProdutos.GetConsultarCaracteristicaProduto: TtecQuery;
begin
  Result := qryConsultaCaracteristicasProdutos;
end;

function TdtmCadastroProdutos.ExisteCaracteristica(campo,
  codigo: String): Boolean;
const


  SQLProdutoDescricao = 'Where c.codigo in (select c2.codigo from caracteristicas c2 where upper(to_ascii(c2.descricao,''latin1'')) ilike upper(to_ascii(:ValordoParametro,''latin1'')) || ''%'')';
{
  SQLProdutoCodigo   = 'Where (upper(to_ascii(c.codigovisual,''latin1''))            ilike upper(to_ascii(:ValordoParametro,''latin1''))  || ''%'') or '+


                            ' (c.codigo in (select p.caracteristica '+
                                ' from produtos p join produtoscodigobarras pcb on p.codigo = pcb.produto '+
                                ' where upper(to_ascii(pcb.codigobarras,''latin1'')) = upper(to_ascii(:ValordoParametro,''latin1''))   )) or '+


                            ' (c.codigo in (select p.caracteristica '+
                                ' from produtos p '+
                                ' where upper(to_ascii(p.codigovisual,''latin1'')) = upper(to_ascii(:ValordoParametro,''latin1''))   ))';
}

  SQLProdutoCodigo   = 'Where (upper(to_ascii(c.codigovisual,''latin1''))            ilike upper(to_ascii(:ValordoParametro,''latin1''))  || ''%'') or '+
                             ' c.codigovisual = :ValordoParametro or '+


                            ' (c.codigo in (select p.caracteristica '+
                                ' from produtos p join produtoscodigobarras pcb on p.codigo = pcb.produto '+
                                ' where pcb.codigobarras = :ValordoParametro   )) or '+


                            ' (c.codigo in (select p.caracteristica '+
                                ' from produtos p '+
                                ' where p.codigovisual = :ValordoParametro   ))';

  SQLProdutocodigoNoCliente   = 'Where (upper(to_ascii(c.codigovisual,''latin1''))            ilike upper(to_ascii(:ValordoParametro,''latin1''))  || ''%'') or '+


                            ' (c.codigo in (select p.caracteristica '+
                                ' from produtos p join produtoscodigobarras pcb on p.codigo = pcb.produto '+
                                ' where upper(to_ascii(pcb.codigobarras,''latin1'')) = upper(to_ascii(:ValordoParametro,''latin1''))  )) or '+

                            ' (c.codigo in (select p.caracteristica '+
                                ' from produtos p '+
                                ' where upper(to_ascii(p.codigovisual,''latin1'')) = upper(to_ascii(:ValordoParametro,''latin1''))  )) or '+
                             '(c.codigo in (select p.caracteristica '+
                                         'from produtos p '+
                                         'where p.codigo in (select cp.produto '+
                                                            'from clientesprodutos cp '+
                                                            'where (upper(to_ascii(cp.produto_cliente,''latin1'')) '+
                                                              ' ilike upper(to_ascii(:ValordoParametro,''latin1'')) || ''%''   ) ) ) )';



  SQLItemProdutoDescricao        = 'Where (upper(to_ascii(p.descricao,''latin1'')) ilike  upper(to_ascii(:ValordoParametro,''latin1'')) || ''%'')';
  SQLItemProdutoCodigo           = 'Where (upper(to_ascii(p.codigovisual,''latin1'')) ilike upper(to_ascii(:ValordoParametro,''latin1'')) || ''%'')';
  SQLItemProdutoCodigoNoCliente  =
 'Where (upper(to_ascii(p.codigovisual,''latin1'')) ilike upper(to_ascii(:ValordoParametro,''latin1'')) || ''%'') or '+
       '(p.codigo in (select cp.produto '+
                     'from clientesprodutos cp '+
                     'where (upper(to_ascii(cp.produto_cliente,''latin1'')) '+
                     'ilike upper(to_ascii(:ValordoParametro,''latin1'')) || ''%'') ) )';


  SQLItemProdutoReferencia       = 'Where (upper(to_ascii(p.referencia,''latin1'')) ilike upper(to_ascii(:ValordoParametro,''latin1''))  || ''%'')';

  SQLProdutoDescricao_Item = 'Where c.codigo in (select distinct p2.caracteristica from produtos p2 where upper(to_ascii(p2.descricao,''latin1'')) ilike upper(to_ascii(:ValordoParametro,''latin1'')) || ''%'')';
  SQLProdutoCodigo_Item = 'Where c.codigo in (select distinct p2.caracteristica from produtos p2 where upper(to_ascii(p2.codigo,''latin1'')) ilike upper(to_ascii(:ValordoParametro,''latin1'')) || ''%'')';
  SQLProdutoCodigo_ItemNoCliente =
  'Where c.codigo in (select distinct p2.caracteristica from produtos p2 where upper(to_ascii(p2.codigo,''latin1'')) ilike upper(to_ascii(:ValordoParametro,''latin1'')) || ''%'') or '+
        '(c.codigo in (select p.caracteristica '+
                     'from produtos p '+
                     'where p.codigo in (select cp.produto '+
                                        'from clientesprodutos cp '+
                                        'where (upper(to_ascii(cp.produto_cliente,''latin1'')) '+
                                          'ilike upper(to_ascii(:ValordoParametro,''latin1'')) || ''%'') ) ) )';

  SQLProdutoReferencia_Item = 'Where c.codigo in (select distinct p2.caracteristica from produtos p2 where upper(to_ascii(p2.referencia,''latin1'')) ilike upper(to_ascii(:ValordoParametro,''latin1'')) || ''%'')';
  SQLIPI = 'Where c.ipi = :ValordoParametro';
  SQLClassificacaoFiscal = 'Where i.classificacaofiscal = :ValordoParametro';
  SQLPeso = 'Where c.peso = :ValordoParametro';

  SQLProdutoClientePartNumber = 'where cp.pn = :ValordoParametro';
  SQLProdutoClienteCliente = 'where cp.cliente = :ValordoParametro';
  SQLProdutoClienteNomedoCliente = 'where upper(to_ascii(vf.nome,''latin1'')) ilike upper(to_ascii(:ValordoParametro,''latin1'')) || ''%''';

  SQLProdutoPartNumber = 'Where p.codigo in (select distinct cp.produto from clientesprodutos cp where cp.pn = :ValordoParametro)';
  SQLProdutoCliente = 'Where p.codigo in (select distinct cp.produto from clientesprodutos cp where cp.cliente = :ValordoParametro)';
  SQLProdutoNomedoCliente = 'Where p.codigo in (select distinct cp.produto from clientesprodutos cp where cp.cliente in (select vf.codigo from vfornecedores vf where upper(to_ascii(vf.nome,''latin1'')) ilike upper(to_ascii(:ValordoParametro,''latin1'')) || ''%'' ))';

  SQLCaracteristicaPartNumber    = 'Where c.codigo in (select distinct p.caracteristica from produtos p, clientesprodutos cp where p.codigo = cp.produto and cp.pn = :ValordoParametro)';
  SQLCaracteristicaCliente       = 'Where c.codigo in (select distinct p.caracteristica from produtos p, clientesprodutos cp where p.codigo = cp.produto and cp.cliente = :ValordoParametro)';
  SQLCaracteristicaNomedoCliente = 'Where c.codigo in (select distinct p.caracteristica from produtos p, '+'clientesprodutos cp where p.codigo = cp.produto and cp.cliente in (select vf.codigo from vfornecedores vf where upper(to_ascii(vf.nome,''latin1'')) ilike upper(to_ascii(:ValordoParametro,''latin1'')) || ''%'' ))';


begin
  if campo = 'descricaocaracteristica' then
  begin
    qryConsultaCaracteristicasProdutosClientes.macrobyname('SQLProdutos').asstring := SQLProdutoDescricao;
    qryConsultaCaracteristicasProdutos.macrobyname('SQLProdutos').asstring:= SQLProdutoDescricao;
    qryConsultaCaracteristicas.macrobyname('SQLProdutos').asstring:= SQLProdutoDescricao;
  end
  else
  if campo = 'codigocaracteristicavisual' then
  begin
    if ParSistema.PesquisarProdutonoCliente then
    begin
      qryConsultaCaracteristicasProdutosClientes.macrobyname('SQLProdutos').asstring:= SQLProdutocodigoNoCliente;
      qryConsultaCaracteristicasProdutos.macrobyname('SQLProdutos').asstring:= SQLProdutocodigoNoCliente;
      qryConsultaCaracteristicas.macrobyname('SQLProdutos').asstring:= SQLProdutocodigoNoCliente;
    end
    else
    begin
      qryConsultaCaracteristicasProdutosClientes.macrobyname('SQLProdutos').asstring:= SQLProdutoCodigo;
      qryConsultaCaracteristicasProdutos.macrobyname('SQLProdutos').asstring:= SQLProdutoCodigo;
      qryConsultaCaracteristicas.macrobyname('SQLProdutos').asstring:= SQLProdutoCodigo;
    end;
  end
  else
  if campo = 'descricaoproduto' then
  begin
    qryConsultaCaracteristicasProdutosClientes.macrobyname('SQLProdutos').asstring:= SQLItemProdutoDescricao;
    qryConsultaCaracteristicasProdutos.macrobyname('SQLProdutos').asstring:= SQLItemProdutoDescricao;
    qryConsultaCaracteristicas.macrobyname('SQLProdutos').asstring:= SQLProdutoDescricao_Item;
  end
  else
  if campo = 'codigoprodutovisual' then
  begin
    if ParSistema.PesquisarProdutonoCliente then
    begin
      qryConsultaCaracteristicasProdutosClientes.macrobyname('SQLProdutos').asstring:= SQLItemProdutoCodigoNoCliente;
      qryConsultaCaracteristicasProdutos.macrobyname('SQLProdutos').asstring:= SQLItemProdutoCodigoNoCliente;
      qryConsultaCaracteristicas.macrobyname('SQLProdutos').asstring:= SQLProdutoCodigo_ItemNoCliente;
    end
    else
    begin
      qryConsultaCaracteristicasProdutosClientes.macrobyname('SQLProdutos').asstring:= SQLItemProdutoCodigo;
      qryConsultaCaracteristicasProdutos.macrobyname('SQLProdutos').asstring:= SQLItemProdutoCodigo;
      qryConsultaCaracteristicas.macrobyname('SQLProdutos').asstring:= SQLProdutoCodigo_Item;
    end;
  end
  else
  if campo = 'referencia' then
  begin
    qryConsultaCaracteristicasProdutosClientes.macrobyname('SQLProdutos').asstring:=SQLItemProdutoReferencia;
    qryConsultaCaracteristicasProdutos.macrobyname('SQLProdutos').asstring:=SQLItemProdutoReferencia;
    qryConsultaCaracteristicas.macrobyname('SQLProdutos').asstring:=SQLProdutoReferencia_Item;
  end
  else
  if campo = 'ipi' then
  begin
    qryConsultaCaracteristicasProdutosClientes.macrobyname('SQLProdutos').asstring:= SQLIPI;
    qryConsultaCaracteristicasProdutos.macrobyname('SQLProdutos').asstring:= SQLIPI;
    qryConsultaCaracteristicas.macrobyname('SQLProdutos').asstring := SQLIPI;
  end
  else
  if campo = 'classificacaofiscal' then
  begin
    qryConsultaCaracteristicasProdutosClientes.macrobyname('SQLProdutos').asstring:= SQLClassificacaoFiscal;
    qryConsultaCaracteristicasProdutos.macrobyname('SQLProdutos').asstring:= SQLClassificacaoFiscal;
    qryConsultaCaracteristicas.macrobyname('SQLProdutos').asstring := SQLClassificacaoFiscal;
  end
  else
  if campo = 'peso' then
  begin
    qryConsultaCaracteristicasProdutosClientes.macrobyname('SQLProdutos').asstring:= SQLPeso;
    qryConsultaCaracteristicasProdutos.macrobyname('SQLProdutos').asstring:= SQLPeso;
    qryConsultaCaracteristicas.macrobyname('SQLProdutos').asstring := SQLPeso;
  end
  else
  if campo = 'pn' then
  begin
    qryConsultaCaracteristicasProdutosClientes.macrobyname('SQLProdutos').asstring:= SQLProdutoClientePartNumber;
    qryConsultaCaracteristicasProdutos.macrobyname('SQLProdutos').asstring:= SQLProdutoPartNumber;
    qryConsultaCaracteristicas.macrobyname('SQLProdutos').asstring := SQLCaracteristicaPartNumber;
  end
  else
  if campo = 'nomedocliente' then
  begin
    qryConsultaCaracteristicasProdutosClientes.macrobyname('SQLProdutos').asstring:= SQLProdutoClienteNomedoCliente;
    qryConsultaCaracteristicasProdutos.macrobyname('SQLProdutos').asstring:= SQLProdutoNomedoCliente;
    qryConsultaCaracteristicas.macrobyname('SQLProdutos').asstring := SQLCaracteristicaNomedoCliente;
  end
  else
  if campo = 'codigodocliente' then
  begin
    qryConsultaCaracteristicasProdutosClientes.macrobyname('SQLProdutos').asstring:= SQLProdutoClienteCliente;
    qryConsultaCaracteristicasProdutos.macrobyname('SQLProdutos').asstring:= SQLProdutoCliente;
    qryConsultaCaracteristicas.macrobyname('SQLProdutos').asstring := SQLCaracteristicaCliente;
  end;

  qryConsultaCaracteristicas.Params[0].AsString := codigo;
  qryConsultaCaracteristicasProdutos.Params[0].AsString := codigo;
  qryConsultaCaracteristicasProdutosClientes.Params[0].AsString := codigo;

  case fFormaPesquisaProduto of
    fpCaracteristicas : begin
                          qryConsultaCaracteristicas.close;
                          qryConsultaCaracteristicas.Open;
                          Result := qryConsultaCaracteristicas.RecordCount > 0
                        end;
    fpItemProdutos    : begin
                          qryConsultaCaracteristicasProdutos.close;
                          qryConsultaCaracteristicasProdutos.Open;
                          Result := qryConsultaCaracteristicasProdutos.RecordCount > 0
                        end;
    fpItemProdutosCliente : begin
                              qryConsultaCaracteristicasProdutosClientes.close;
                              qryConsultaCaracteristicasProdutosClientes.Open;
                              Result := qryConsultaCaracteristicasProdutosClientes.RecordCount > 0
                            end;
  end;


end;

procedure TdtmCadastroProdutos.SelecionarCaracteristica;
begin
  case fFormaPesquisaProduto of
   fpCaracteristicas : begin
                         qryCaracteristicas.MacroByName('CondicaoEspecificaJanelaPesquisa').asString := ' and caracteristicas.codigo = '+qryConsultaCaracteristicascodigocaracteristica.AsString;
                         ReFazConsulta(qryCaracteristicas, [0], [qryConsultaCaracteristicascodigocaracteristicavisual.AsString]);
                       end;


   fpItemProdutos    : begin
                         qryCaracteristicas.MacroByName('CondicaoEspecificaJanelaPesquisa').asString := ' and caracteristicas.codigo = '+qryConsultaCaracteristicasProdutoscodigocaracteristica.AsString;
                         ReFazConsulta(qryCaracteristicas, [0], [qryConsultaCaracteristicasProdutoscodigocaracteristicavisual.AsVariant]);
                       end;


   fpItemProdutosCliente : begin
                             qryCaracteristicas.MacroByName('CondicaoEspecificaJanelaPesquisa').asString := ' and caracteristicas.codigo = '+qryConsultaCaracteristicasProdutosClientescodigocaracteristica.AsString;
                             ReFazConsulta(qryCaracteristicas, [0], [qryConsultaCaracteristicasProdutosClientescodigocaracteristicavisual.AsString])
                           end;
  end;
//  qryCaracteristicas.MacroByName('CondicaoEspecificaJanelaPesquisa').asString := '';

end;

