procedure TdtmCadastroProdutos.ExcluirProdutoCompostoFios;
begin
  if not qryProdutoCompostoFios.IsEmpty then
  begin
    if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o código '+  qryProdutoCompostoFioscomponente.AsString])) = smbOk then
    begin
      qryProdutoCompostoFios.AfterDelete := nil;
      qryProdutoCompostoFios.Delete;
      qryProdutoCompostoFios.AfterDelete := qryProdutoCompostoFiosAfterDelete;
      RecalcularOrdemProdutoCompostoFios;
      Perpetrar([qryProdutoCompostoFios]);
    end;
  end;
end;

procedure TdtmCadastroProdutos.RecalcularOrdemProdutoCompostoFios;
begin
  GuardarRegistroAtual(qryProdutoCompostoFios, true);
  qryProdutoCompostoFios.First;
  while not qryProdutoCompostoFios.Eof do
  begin
    if qryProdutoCompostoFiosordem.AsInteger <> qryProdutoCompostoFios.RecNo then
    begin
      qryProdutoCompostoFios.Edit;
      qryProdutoCompostoFiosordem.AsInteger := qryProdutoCompostoFios.RecNo;
    end;
    qryProdutoCompostoFios.Next;
  end;
  qryProdutoCompostoFiosAfterOpen(nil);
  VoltarRegistroAtual(qryProdutoCompostoFios);
end;

