  qryProdutosnlote.required := qryCaracteristicasgerenciarloteevalidade.asboolean;
  qryProdutosdval.required := qryCaracteristicasgerenciarloteevalidade.asboolean;

  qryProdutosvalorgrade1.visible := (LinhadaGrade<>'');
  qryProdutosvalorgrade2.visible := (ColunadaGrade<>'');

