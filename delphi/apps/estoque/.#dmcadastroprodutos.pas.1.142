function TdtmCadastroProdutos.VerificarCorrelacoes_csosn_x_cst: boolean;
begin
  result := true;

  if ExisteCRTNormal
     and ExisteCRTSimples
     and not qryCaracteristicascst.IsNull
     and not qryCaracteristicascsosn.IsNull then
  begin
    if     ((qryCaracteristicascst.asstring = '00') or
            (qryCaracteristicascst.asstring = '20')) and

       not ((qryCaracteristicascsosn.asstring = '101') or
            (qryCaracteristicascsosn.asstring = '102')) then
    begin
      result := false;
      MensagemAviso('Se o CST for ''00'' ou ''20'' o CSOSN deverá ser ''101'' ou ''102''');
    end
    else
    if     ((qryCaracteristicascst.asstring = '10') or
            (qryCaracteristicascst.asstring = '60') or
            (qryCaracteristicascst.asstring = '70')) and

       not ((qryCaracteristicascsosn.asstring = '500') or
            (qryCaracteristicascsosn.asstring = '201') or
            (qryCaracteristicascsosn.asstring = '202')) then
    begin
      result := false;
      MensagemAviso('Se o CST for ''10'', ''60'' ou ''70'' o CSOSN deverá ser ''500'', ''201'' ou ''202''');
    end
    else
    if     (qryCaracteristicascst.asstring = '30') and
       not (qryCaracteristicascsosn.asstring = '203') then
    begin
      result := false;
      MensagemAviso('Se o CST for ''30'' o CSOSN deverá ser ''203''');
    end
    else
    if ((qryCaracteristicascst.asstring = '40') or
        (qryCaracteristicascst.asstring = '41')) then
    begin
      if not ((qryCaracteristicascsosn.asstring = '103') or
              (qryCaracteristicascsosn.asstring = '300') or
              (qryCaracteristicascsosn.asstring = '400')) then
      begin
        result := false;
        MensagemAviso('Se o CST for ''40'' ou ''41'' o CSOSN deverá ser ''103'', ''300'' ou ''400''');
      end;
    end
    else
    if     ((qryCaracteristicascst.asstring = '50') or
            (qryCaracteristicascst.asstring = '51')) and

       not (qryCaracteristicascsosn.asstring = '400') then
    begin
      result := false;
      MensagemAviso('Se o CST for ''50'' ou ''51'' o CSOSN deverá ser ''400''');
    end
    else
    if     (qryCaracteristicascst.asstring = '90') and
       not (qryCaracteristicascsosn.asstring = '900') then
    begin
      result := false;
      MensagemAviso('Se o CST for ''90'' o CSOSN deverá ser ''900''');
    end;

  end;

  if not result then
    qryCaracteristicascsosn.FocusControl;

end;

function TdtmCadastroProdutos.VerificarCorrelacoes_cst_x_csosn: boolean;
begin

  result := true;

  if ExisteCRTNormal
     and ExisteCRTSimples
     and not qryCaracteristicascst.IsNull
     and not qryCaracteristicascsosn.IsNull then
  begin
    if not ((qryCaracteristicascst.asstring = '00') or
            (qryCaracteristicascst.asstring = '20')) and

           ((qryCaracteristicascsosn.asstring = '101') or
            (qryCaracteristicascsosn.asstring = '102')) then
    begin
      result := false;
      MensagemAviso('Se o CSOSN for ''101'' ou ''102'' o CST deverá ser ''00'' ou ''20''');
    end
    else
    if not ((qryCaracteristicascst.asstring = '10') or
            (qryCaracteristicascst.asstring = '60') or
            (qryCaracteristicascst.asstring = '70')) and

           ((qryCaracteristicascsosn.asstring = '500') or
            (qryCaracteristicascsosn.asstring = '201') or
            (qryCaracteristicascsosn.asstring = '202')) then
    begin
