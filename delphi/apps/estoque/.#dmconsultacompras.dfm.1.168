  object qryComprasGruposFiliais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'produto=produto'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrComprasTotal
    Constraints = <>
    AutoCalcFields = False
    BeforeScroll = qryComprasGruposFiliaisBeforeScroll
    AfterScroll = qryComprasGruposFiliaisAfterScroll
    OnCalcFields = qryComprasGruposFiliaisCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'quantidadeemestoque'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListadeProdutos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'resultadocurvaabc'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'produtos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Filiais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'estoques'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '/* qryComprasGruposFiliais */'
      ';'
      'select *,'
      
        '       case when sugestao1 <= 0 then 0 else (cast(ROUND( ( cast(' +
        '(total_vendido) as float) / periodo) * :diasproporcional ) as fl' +
        'oat) - total_estoque - total_pedido + futuro) end as sugestao,'
      ''
      '       cast('
      '       case when coalesce(total_vendido,0)<>0 then'
      
        '         ((total_estoque + case when /*:NaoConsiderarPedidosComp' +
        'raparaDiasEstoque*/ true then 0 else total_pedido end)/'
      '          (Total_vendido / Periodo))'
      '       else'
      '         cast(999999.99 as numeric(11,2))'
      '       end as numeric(12,2)) as diasestoque,'
      ''
      '       cast('
      '       case when coalesce(total_vendido,0)<>0 then'
      
        '         ((total_estoque + case when /* :NaoConsiderarPedidosCom' +
        'praparaDiasEstoque */ false then 0 else total_pedido end)/'
      '          (Total_vendido / Periodo))'
      '       else'
      '         cast(999999.99 as numeric(11,2))'
      '       end as numeric(12,2)) as diasestoquecompedidosdecompra,'
      ''
      ''
      '       cast(0 as integer) as filial'
      ''
      ''
      ''
      'from'
      '('
      
        'SELECT *, (cast(ROUND( ( cast(total_vendido as float)/ periodo) ' +
        '* :diasestoque) as float) - total_estoque - total_pedido + futur' +
        'o) AS sugestao1,'
      ''
      '       cast(100 as numeric(6,2)) as PercEstoque'
      'FROM'
      '  ('
      '       SELECT'
      '              fgf.grupo,'
      '              g.mnemonico,'
      '              s.produto,'
      '              s.periodo,'
      '              SUM ( s.estoque ) AS total_estoque,'
      '              SUM ( s.transito ) AS total_transito,'
      ''
      
        '              SUM ( s.pedido + s.pedidos_filiais) AS total_pedid' +
        'o,'
      '              SUM ( s.pedido) AS total_pedidos_fornecedores,'
      '              SUM ( s.pedidos_filiais) AS total_pedidos_filiais,'
      '              SUM ( s.vendido ) AS total_vendido,'
      '              CAST(SUM (s.reservado) as float) as reservado,'
      
        '              CAST(SUM (s.reservaprevia) as float) as reservapre' +
        'via,'
      
        '              CAST(SUM(s.minimo) as float) as minimo, CAST(case ' +
        'when SUM(s.minimo - s.saldo)<0 then 0 else SUM(s.minimo-s.saldo)' +
        ' end as float) as sugestaominimo,'
      
        '              CAST(SUM (s.maximo) as float) as maximo, CAST(case' +
        ' when SUM(s.maximo - s.saldo)<0 then 0 ELSE sum(s.maximo-s.saldo' +
        ') end as float) as sugestaomaximo, cast(sum(s.futuro) as float) ' +
        'as futuro'
      '       FROM'
      '       ('
      '              select e.*,'
      
        '                   coalesce(pedidos_estoquepedido,0) + produtosp' +
        'edidos_recebido_semnotaparcial AS pedido,'
      
        '                   e.estoque + pedidos_estoquepedido - e.futuro ' +
        'as saldo,'
      
        '                   case when e.datacadastro between :inicio and ' +
        ':fim then'
      
        '                                                      case when ' +
        ':fim = e.datacadastro then 1'
      
        '                                                      else :fim ' +
        '- e.datacadastro end'
      '                   else :periodo end as periodo'
      ''
      '              from'
      '              ('
      '              select e.*,'
      '                    case when :NaoConsiderarPedidosCompra then 0'
      
        '                    else produtospedidos_recebido_semnotaparcial' +
        '(e.produto,e.filial) end as produtospedidos_recebido_semnotaparc' +
        'ial'
      ''
      '              FROM'
      '              ('#9
      '              select e.*,'
      
        '                     case when :NaoConsiderarPedidosCompra then ' +
        '0'
      
        '                     else pedidos_estoquepedido(e.produto,e.fili' +
        'al) end as pedidos_estoquepedido'
      ''
      '              from'
      '              ('
      '              select e.*,'
      
        '                      case when :conceitos='#39#39' then movimentos_ve' +
        'ndido(:inicio,:fim, e.produto, e.filial)'
      
        '                      else movimentos_vendido_porconceito(:inici' +
        'o,:fim, e.produto, e.filial,:conceitos) end'
      '                      as vendido'
      ''
      '              from'
      ''
      '              ('#9
      ''
      '              select e.*,'
      ''
      '                       /*'
      '                       case when not :PedidosEntreFiliais then 0'
      '                       else'
      '                       coalesce((select sum(pf.qtdepedida)'
      '                       from pedidosfiliais pf'
      '                       where pf.produto = e.produto'
      '                       and pf.requisitante = e.filial'
      '                       and pf.situacao = '#39'A'#39'),0) + e.transito'
      '                       end as pedidos_filiais'
      '                       */'
      ''
      '                       case when not :PedidosEntreFiliais then 0'
      '                       else'
      ''
      
        '                         coalesce((select sum(case when pf.situa' +
        'cao = '#39'A'#39' then pf.qtdepedida'
      
        '                                          when pf.situacao = '#39'F'#39 +
        ' then 0 end)'
      '                          from pedidosfiliais pf'
      '                          where pf.produto = e.produto'
      '                           and pf.requisitante = e.filial'
      
        '                           and pf.situacao in ('#39'A'#39','#39'F'#39')),0) /*+ ' +
        'e.transito*/'
      ''
      '                       end  as pedidos_filiais'
      ''
      ''
      ''
      '              from'
      '              ('
      '              select produtos. *,'
      '                   e.filial,'
      '                       e.datacompra,'
      '                       %quantidadeemestoque  as estoque,'
      '                       e.futuro,'
      '                       e.transito,'
      '                       e.reservado,'
      '                       e.reservaprevia,'
      '                       coalesce(e.minimo,0) as minimo,'
      '                       coalesce(e.maximo,0) as maximo'
      #9' '
      #9' '
      '              from estoques e join'
      '              ('
      
        '                                       select p.codigo as produt' +
        'o,'
      '                                              p.datacadastro'
      ''
      '                                       from produtos p'
      
        '                                       where p.codigo in (%Lista' +
        'deProdutos)'
      ''
      '                                       /*'
      
        '                                       from ((((((caracteristica' +
        's c'
      '                                                  join marcas m'
      
        '                                                  on c.marca = m' +
        '.codigo)'
      ''
      '                                                 join grupos g'
      
        '                                                 on c.grupo = g.' +
        'codigo)'
      ''
      '                                                join classes cl'
      
        '                                                on c.classe = cl' +
        '.codigo)'
      ''
      '                                               join (produtos p'
      
        '                                                    left join pr' +
        'omocoes pro'
      
        '                                                    on p.promoca' +
        'o = pro.codigo)'
      
        '                                               on p.caracteristi' +
        'ca = c.codigo)'
      ''
      
        '                                              left join grades g' +
        'r1'
      
        '                                              on gr1.codigo = c.' +
        'grade1)'
      
        '                                             left join grades gr' +
        '2'
      
        '                                             on gr2.codigo = c.g' +
        'rade2)'
      ''
      
        '                                       where p.caracteristica = ' +
        'c.codigo'
      '                                         and c.marca = m.codigo'
      '                                         and c.grupo = g.codigo'
      
        '                                         and c.classe = cl.codig' +
        'o'
      '                                         %resultadocurvaabc'
      ''
      '                                                  */'
      ''
      ''
      '                           %produtos'
      ''
      ''
      '                                      order by p.codigo'
      ''
      '              ) as produtos on e.produto = produtos.produto'
      '              where true'
      ''
      '                          %Filiais'
      '                          %estoques'
      ''
      '              ) as e'
      '              ) as e'
      '              ) as e'
      '              ) as e'
      '              ) as e'
      ''
      '       ) AS s'
      ''
      '       JOIN (filiaisgruposfiliais fgf'
      '             join gruposfiliais g'
      '             on fgf.grupo = g.codigo)'
      '             on s.filial = fgf.filial'
      ''
      '      GROUP BY s.produto, fgf.grupo, g.mnemonico, s.periodo'
      '   ) AS selecionados'
      ''
      
        '/*where  (total_estoque<>0) or (total_pedido<>0) or (total_vendi' +
        'do<>0)*/'
      ''
      'ORDER BY produto,grupo'
      ') as selecionados')
    RequestLive = True
    Left = 60
    Top = 238
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'diasproporcional'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NaoConsiderarPedidosCompraparaDiasEstoque'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'diasestoque'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'inicio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'fim'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'periodo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NaoConsiderarPedidosCompra'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'conceitos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'PedidosEntreFiliais'
        ParamType = ptUnknown
      end>
