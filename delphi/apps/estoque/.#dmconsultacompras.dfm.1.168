        DataType = ftUnknown
        Name = 'ListadeProdutos'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select selecao.*'
      'from'
      '('
      'SELECT pp.pedido,'
      '       pp.produto,'
      '       pp.quantidade,'
      '       p.entrega,'
      '       p.filialentrega,'
      
        '       pedidos_estoquepedido(pp.produto,p.filialentrega,pp.pedid' +
        'o) as quantidadependente,'
      '       p.emissao'
      ''
      'FROM produtospedidos pp'
      '     join pedidos p'
      '     ON pp.pedido = p.numero and p.situacao in ('#39'A'#39', '#39'P'#39')'
      ''
      'where pp.produto in (%ListadeProdutos)'
      ''
      ') as selecao'
      'where selecao.quantidadependente >0'
      'order by entrega, emissao, produto')
    RequestLive = False
    Left = 718
    Top = 384
