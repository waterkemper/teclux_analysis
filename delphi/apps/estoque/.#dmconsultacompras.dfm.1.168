  object qryVVendasDiaria: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'produtos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'resultadocurvaabc'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FILTRO_CONCEITO'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      ''
      '/* qryVVendasDiaria */'
      ''
      'select selecao1.produto, '
      '       selecao1.data,'
      '       selecao1.totalvendas,'
      '       selecao2.qtcontrato,'
      '       '
      '       selecao1.totalinternet,'
      '       selecao2.qtinternet,'
      '       '
      '       selecao1.totalloja,'
      '       selecao2.qtloja'
      '       '
      '       '
      'from'
      '('
      '        SELECT produto,'
      '              SUM(totalvendas) as totalvendas,'
      '              SUM(totalinternet) as totalinternet,'
      '              SUM(totalloja) as totalloja,              '
      '              data'
      '        FROM'
      '        ('
      '        '
      '            ('
      '            '
      '               SELECT m.produto,'
      '                      SUM(abs(m.quantidade)) as totalvendas,'
      
        '                      sum(case when p_s.contrato is not null the' +
        'n abs(m.quantidade) else 0 END) as totalinternet,'
      
        '                      sum(case when p_s.contrato is not null the' +
        'n 0 else abs(m.quantidade) END) as totalloja,'
      '                      m.data'
      ''
      
        '               FROM movimentos m left join pedidos_site p_s on m' +
        '.contrato = p_s.contrato'
      '                    join'
      '                    ('
      '                          Select p.codigo'
      '              from ((((caracteristicas c'
      '                          join marcas m'
      '                          on c.marca = m.codigo)'
      ''
      '                         join grupos g'
      '                         on c.grupo = g.codigo)'
      ''
      '                        join classes cl'
      '                        on c.classe = cl.codigo)'
      ''
      '                       join (produtos p'
      '                            left join promocoes pro'
      '                            on p.promocao = pro.codigo)'
      '                       on p.caracteristica = c.codigo)'
      ''
      '             where p.caracteristica = c.codigo'
      '               and c.marca = m.codigo'
      '               and c.grupo = g.codigo'
      '               and c.classe = cl.codigo'
      ''
      '                         %produtos'
      '                         %resultadocurvaabc'
      ''
      '                         and p.codigo = :codigoproduto'
      '                     )'
      
        '                     as p on m.produto = p.codigo,dadosfiscais f' +
        'c'
      ''
      
        '               WHERE m.data between (:datainicial) and (cast(:da' +
        'tafinal as date))'
      '               AND fc.numero=m.dadofiscal'
      
        '               AND CASE when :conceitos='#39#39' THEN true ELSE %FILTR' +
        'O_CONCEITO END'
      '               and substr(m.operacao,13,1)='#39'+'#39
      '               GROUP BY m.produto, m.data'
      '               order by m.produto, m.data desc'
      '               '
      '             )'
      '             '
      '             UNION ALL'
      '             '
      '             ('
      '               SELECT m.produto,'
      '                      SUM(-abs(m.quantidade)) as totalvendas,'
      
        '                      sum(case when p_s.contrato is not null the' +
        'n -abs(m.quantidade) else 0 END) as totalinternet,'
      
        '                      sum(case when p_s.contrato is not null the' +
        'n 0 else -abs(m.quantidade) END) as totalloja,                  ' +
        '                          '
      '                      m.data'
      ''
      
        '               FROM movimentos m left join pedidos_site p_s on m' +
        '.contrato = p_s.contrato'
      '                    join'
      '                    ('
      '                          Select p.codigo'
      '              from ((((caracteristicas c'
      '                          join marcas m'
      '                          on c.marca = m.codigo)'
      ''
      '                         join grupos g'
      '                         on c.grupo = g.codigo)'
      ''
      '                        join classes cl'
      '                        on c.classe = cl.codigo)'
      ''
      '                       join (produtos p'
      '                            left join promocoes pro'
      '                            on p.promocao = pro.codigo)'
      '                       on p.caracteristica = c.codigo)'
      ''
      ''
      '               where p.caracteristica = c.codigo'
      '                 and c.marca = m.codigo'
      '                 and c.grupo = g.codigo'
      '                 and c.classe = cl.codigo'
      ''
      '                         %produtos'
      '                         %resultadocurvaabc'
      ''
      '                         and p.codigo = :codigoproduto '
      '                     )'
      
        '                     as p on m.produto = p.codigo,notaspag np,vf' +
        'ornecedores fc'
      ''
      
        '               WHERE m.data between (:datainicial) and (cast(:da' +
        'tafinal as date))'
      '               AND np.codigo=m.codigonota'
      '         AND np.fornecedor=fc.codigo'
      '         AND np.tipofornecedor=fc.tipo'
      
        '               AND CASE when :conceitos='#39#39' THEN true ELSE  %FILT' +
        'RO_CONCEITO  END'
      '               and substr(m.operacao,13,1) ='#39'-'#39
      '               GROUP BY m.produto, m.data'
      '               order by m.produto, m.data desc'
      '             )   '
      '        ) as sel'
      '         GROUP BY sel.produto, sel.data'
      '         order by sel.produto, sel.data desc'
      '  ) as selecao1'
      '    left join'
      '    ('
      '          select saldo.produto, saldo.data,  '
      '                 cast(sum(QtContrato) as integer) as QtContrato,'
      '                 cast(sum(QtInternet) as integer) as QtInternet,'
      '                 cast(sum(QtLoja) as integer) as QtLoja'
      '                 '
      '                 '
      '          from'
      '          ('
      '              select saldo.produto, saldo.contrato, saldo.data, '
      
        '                      case when sum(saldo.quantidade) > 0 then 1' +
        ' else 0 end as QtContrato,'
      
        '                      case when sum(saldo.quantidade) > 0 and p_' +
        's.contrato is not null then  1 else 0 end as QtInternet,'
      
        '                      case when sum(saldo.quantidade) > 0 and p_' +
        's.contrato is not null then  0 else 1 end as QtLoja'
      '                      '
      '              from'
      '              ('
      '                  ('
      
        '                      select m2.produto, m2.contrato, m2.data, s' +
        'um(abs(m2.quantidade)) as quantidade'
      ''
      '                      from (movimentos m2'
      '                            join ((produtos p'
      '                                   left join promocoes pro'
      '                                   on p.promocao = pro.codigo)'
      ''
      '                                  join (((caracteristicas c'
      '                                         join marcas m'
      '                                         on c.marca = m.codigo)'
      ''
      '                                        join grupos g'
      '                                        on c.grupo = g.codigo)'
      ''
      '                                       join classes cl'
      '                                       on c.classe = cl.codigo)'
      ''
      ''
      '                                 on p.caracteristica=c.codigo)'
      
        '                            on m2.produto = p.codigo), contratos' +
        ' fc'
      ''
      '                       where m2.produto = p.codigo'
      '                         and p.caracteristica = c.codigo'
      '                         and c.marca = m.codigo'
      '                         and c.grupo = g.codigo'
      '                         and c.classe = cl.codigo'
      ''
      '                      %produtos'
      '                      %resultadocurvaabc'
      ''
      '                      and p.codigo = :codigoproduto'
      ''
      '                      and fc.numero=m2.contrato'
      
        '                      and CASE WHEN :conceitos='#39#39' THEN true ELSE' +
        '  %FILTRO_CONCEITO  END'
      
        '                      and m2.data between (:datainicial) and (ca' +
        'st(:datafinal as date))'
      '                      and (substr(m2.operacao,13,1) = '#39'+'#39')'
      '                      and m2.contrato is not null'
      '                      group by m2.produto, m2.contrato, m2.data'
      '                    )'
      ''
      '                    union all'
      '                    ('
      
        '                        select cd.produto, cd.contrato, cd.devol' +
        'ucao as data, -sum(cd.quantidade) as quantidade'
      '                        from (contratosdevolvidos cd'
      '                            join ((produtos p'
      '                                   left join promocoes pro'
      '                                   on p.promocao = pro.codigo)'
      ''
      '                                  join (((caracteristicas c'
      '                                         join marcas m'
      '                                         on c.marca = m.codigo)'
      ''
      '                                        join grupos g'
      '                                        on c.grupo = g.codigo)'
      ''
      '                                       join classes cl'
      '                                       on c.classe = cl.codigo)'
      ''
      ''
      '                                 on p.caracteristica=c.codigo)'
      
        '                            on cd.produto = p.codigo), contratos' +
        ' fc'
      ''
      '                       where cd.produto = p.codigo'
      '                         and p.caracteristica = c.codigo'
      '                         and c.marca = m.codigo'
      '                         and c.grupo = g.codigo'
      '                         and c.classe = cl.codigo'
      '                         and cd.situacao='#39'N'#39
      ''
      ''
      '                        %produtos'
      '                        %resultadocurvaabc'
      ''
      '                        and p.codigo = :codigoproduto'
      ''
      '                        and fc.numero=cd.contrato'
      
        '                        and CASE WHEN :conceitos='#39#39' THEN true EL' +
        'SE %FILTRO_CONCEITO END'
      
        '                        and cd.devolucao between (:datainicial) ' +
        'and (cast(:datafinal as date))'
      
        '                        group by cd.produto,cd.contrato, cd.devo' +
        'lucao'
      '                    )'
      
        '              ) as saldo left join pedidos_site p_s on saldo.con' +
        'trato = p_s.contrato '
      '              '
      
        '              group by saldo.produto, saldo.contrato, p_s.contra' +
        'to, saldo.data'
      '              '
      '          ) as saldo group by saldo.produto, saldo.data'
      '          '
      '    ) as selecao2'
      
        '    on selecao1.produto = selecao2.produto and selecao1.data = s' +
        'elecao2.data'
      '  order by produto, data desc')
