  object qryVVendas_porFilial_Similares: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkFields = 'produto=produto;filial=filial'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrComprasFiliaisGrupoSimilares
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'FILTRO_CONCEITO'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ''
      '/* qryVVendas_porFilial_Similares */'
      ''
      ';'
      ''
      'select filial, produto, mes,'
      '       sum(totalvendas) as totalvendas,'
      '       cast(sum(qtcontrato) as integer) as qtcontrato,'
      ''
      '       sum(totalinternet) as totalinternet,'
      '       cast(sum(qtinternet) as integer) as qtinternet,'
      ''
      '       sum(totalloja) as totalloja,'
      '       cast(sum(qtloja) as integer) as qtloja'
      'from'
      '('
      ''
      ''
      '            select selecao1.produto, selecao1.filial,'
      
        '                   cast(to_char(selecao1.data,'#39'YYYY/mm'#39') as char' +
        '(7)) AS mes,'
      ''
      '                   selecao1.totalvendas,'
      
        '                   case when selecao1.totalvendas > 0 then cast(' +
        '1 as integer) else cast(0 as integer) end as qtcontrato,'
      ''
      '                   selecao1.totalinternet,'
      
        '                   case when selecao1.totalinternet > 0 then cas' +
        't(1 as integer) else cast(0 as integer) end as qtinternet,'
      ''
      '                   selecao1.totalloja,'
      
        '                   case when selecao1.totalloja > 0 then cast(1 ' +
        'as integer) else cast(0 as integer) end as qtloja'
      ''
      ''
      '            from'
      '            ('
      ''
      ''
      '                 SELECT'
      '                           produto'
      '                         , filial'
      '                         , SUM(totalvendas)   as totalvendas'
      '                         , SUM(totalinternet) as totalinternet'
      '                         , SUM(totalloja)     as totalloja'
      
        '                         , data, contrato, quantidade, precovend' +
        'a, precotabela'
      '                 FROM'
      '                           (   '
      '   '
      '                               ('
      ''
      '                               /* SA'#205'DAS */'
      ''
      '                                     SELECT'
      '                                               m.produto'
      '                                             , m.filial'
      
        '                                             , abs(m.quantidade)' +
        ' as totalvendas,'
      ''
      
        '                                                                ' +
        '   case'
      
        '                                                                ' +
        '             when p_s.contrato is not null'
      
        '                                                                ' +
        '                       then abs(m.quantidade)'
      
        '                                                                ' +
        '                       else 0'
      
        '                                                                ' +
        '   END'
      '                                               as totalinternet,'
      ''
      ''
      ''
      
        '                                                                ' +
        '   case'
      
        '                                                                ' +
        '             when p_s.contrato is not null'
      
        '                                                                ' +
        '                       then 0'
      
        '                                                                ' +
        '                       else abs(m.quantidade)'
      
        '                                                                ' +
        '   END'
      ''
      '                                               as totalloja'
      
        '                                             , m.data, m.contrat' +
        'o, pdf.quantidade, pdf.precovenda, pdf.precotabela'
      '                                     FROM'
      '                                               ((movimentos m'
      ''
      
        '                                                left join pedido' +
        's_site p_s'
      
        '                                                on m.contrato = ' +
        'p_s.contrato)'
      ''
      '                                                join produtos p'
      
        '                                                on m.produto = p' +
        '.codigo), (dadosfiscais fc'
      
        '                                                                ' +
        '    join produtosdadosfiscais pdf'
      
        '                                                                ' +
        '    on fc.numero = pdf.dadofiscal)'
      ''
      '                                     WHERE p.codigo = :similar '
      
        '                                       and m.data between :datai' +
        'nicial and :datafinal'
      ''
      
        '                                               and coalesce(m.co' +
        'mposto,m.produto) = pdf.produto'
      
        '                                               and m.filial = pd' +
        'f.filial'
      
        '                                               AND fc.numero=m.d' +
        'adofiscal'
      
        '                                               AND CASE when :co' +
        'nceitos='#39#39' THEN true ELSE %FILTRO_CONCEITO END'
      
        '                                               and substr(m.oper' +
        'acao,13,1)='#39'+'#39
      '                                               '
      '                                     order by'
      '                                               m.produto'
      '                                             , m.data desc'
      ''
      '                               )'
      ''
      '                               union all'
      ''
      '                               ('
      ''
      ''
      '/* ENTRADAS */'
      ''
      '                                     SELECT'
      
        '                                               m.produto, m.fili' +
        'al,'
      
        '                                              -abs(m.quantidade)' +
        ' as totalvendas'
      '                                             ,'
      
        '                                                                ' +
        '   case'
      
        '                                                                ' +
        '             when p_s.contrato is not null'
      
        '                                                                ' +
        '                       then -abs(m.quantidade)'
      
        '                                                                ' +
        '                       else 0'
      
        '                                                                ' +
        '   END'
      '                                               as totalinternet'
      '                                             , '
      
        '                                                                ' +
        '   case'
      
        '                                                                ' +
        '             when p_s.contrato is not null'
      
        '                                                                ' +
        '                       then 0'
      
        '                                                                ' +
        '                       else -abs(m.quantidade)'
      
        '                                                                ' +
        '   END'
      '                                               as totalloja'
      
        '                                             , m.data, m.contrat' +
        'o, -pnp.quantidade, pdf.precovenda, pdf.precotabela'
      '                                             '
      '                                     FROM'
      '                                               ((movimentos m'
      
        '                                                left join pedido' +
        's_site p_s'
      
        '                                                on m.contrato = ' +
        'p_s.contrato)'
      '                                               '
      '                                                join produtos p'
      
        '                                                on m.produto = p' +
        '.codigo), (notaspag np'
      
        '                                                                ' +
        '    join produtosnotaspag pnp'
      
        '                                                                ' +
        '         left join produtosdadosfiscais pdf'
      
        '                                                                ' +
        '         on pnp.dadofiscal = pdf.dadofiscal'
      
        '                                                                ' +
        '         and pnp.produto = pdf.produto'
      
        '                                                                ' +
        '         and pnp.numeroprodutotabela = pdf.numero'
      
        '                                                                ' +
        '    on np.codigo = pnp.codigonota)'
      
        '                                                                ' +
        '    '
      
        '                                                                ' +
        ' , vfornecedores fc'
      '                                    WHERE p.codigo = :similar'
      
        '                                      and m.data between :datain' +
        'icial and :datafinal'
      
        '                                               AND np.codigo    ' +
        '    =m.codigonota'
      
        '                                               AND np.fornecedor' +
        '    =fc.codigo'
      
        '                                               AND np.tipofornec' +
        'edor=fc.tipo'
      
        '                                               and coalesce(m.co' +
        'mposto,m.produto) = pnp.produto'
      
        '                                               and m.filial = pn' +
        'p.filial'
      
        '                                               AND CASE when :co' +
        'nceitos='#39#39' THEN true ELSE  %FILTRO_CONCEITO  END'
      
        '                                               and substr(m.oper' +
        'acao,13,1) ='#39'-'#39
      '                                     order by'
      '                                               m.produto'
      '                                             , m.data desc'
      ''
      ''
      ''
      ''
      '                             )'
      ''
      '                           ) as sel'
      '                           GROUP BY'
      
        '                           sel.filial, sel.produto, sel.data, se' +
        'l.contrato, sel.quantidade, sel.precovenda, sel.precotabela'
      ''
      '                          order by'
      '                           sel.filial,'
      '                           sel.produto,'
      '                           sel.data desc'
      ''
      '             )  as selecao1'
      ''
      ''
      ') as selecao1'
      'group by filial, produto, mes'
      'order by filial, produto, mes desc')
    RequestLive = False
    Left = 393
    Top = 520
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'similar'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'conceitos'
        ParamType = ptUnknown
      end>
