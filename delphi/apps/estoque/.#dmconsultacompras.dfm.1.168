        'mposto,m.produto) = pnp.produto'
      
        '                                               and m.filial = pn' +
        'p.filial'
      
        '                                               AND CASE when :co' +
        'nceitos='#39#39' THEN true ELSE  %FILTRO_CONCEITO  END'
      
        '                                               and substr(m.oper' +
        'acao,13,1) ='#39'-'#39
      '                                     order by'
      '                                               m.produto'
      '                                             , m.data desc'
      ''
      ''
      ''
      ''
      '                             )'
