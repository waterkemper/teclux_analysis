  object qryDetalhesCompra_Similares: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryDetalhesCompra_SimilaresCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'CondicaoListaFiliais'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'SELECT'
      '   e.produto,'
      '/*   max(e.datacompra) as datacompra,*/'
      '   e.datacompra,'
      '   e.precoCOMicms,'
      '   e.precoSEMicms,'
      '   e.qtdecompra,'
      '   e.aliquotaipi,'
      '   e.valorultimacompra,'
      '   e.filial,'
      ''
      '   p.datacadastro,'
      ''
      ''
      '   cast('
      '    coalesce('
      '    ('
      '    select sum(e1.financeiro) /'
      '           sum(e1.emestoque +'
      '               e1.reservado +'
      '               e1.reservaprevia +'
      '               e1.transito +'
      '               e1.demonstracao +'
      '               e1.conserto +'
      '               e1.danificada)'
      ''
      '    from estoques e1'
      '    where e1.produto = e.produto'
      
        '      and (e1.emestoque+e1.reservado+e1.reservaprevia+e1.transit' +
        'o+e1.demonstracao+e1.conserto+e1.danificada) <> 0'
      '      and e1.financeiro<>0'
      '      %CondicaoListaFiliais'
      '   ),0.00) as numeric(11,2)) as customedio,'
      ''
      ''
      
        '   cast(case when ((e.emestoque+e.reservado+e.reservaprevia+e.tr' +
        'ansito+e.demonstracao+e.conserto+e.danificada) = 0) or'
      '                   (coalesce(e.financeiro,0)=0) or'
      '                   (coalesce(cpn.valor,0)=0) then 0'
      
        '                    else ROUND( (cpn.valor / ROUND( e.financeiro' +
        ' / (e.emestoque+e.reservado+e.reservaprevia+e.transito+e.demonst' +
        'racao+e.conserto+e.danificada),2 ) - 1) * 100,2)'
      '            end as numeric(15,2)) AS markup'
      ''
      ''
      'FROM estoques e'
      
        '    join (produtos p left join promocoes pro on p.promocao = pro' +
        '.codigo)'
      '         join caracteristicas c'
      '              join marcas m'
      '              on c.marca = m.codigo'
      ''
      '              join grupos g'
      '              on c.grupo = g.codigo'
      ''
      '              join classes cl'
      '              on c.classe = cl.codigo'
      ''
      '         on p.caracteristica = c.codigo'
      ''
      '    on e.produto = p.codigo'
      ''
      '    join filiais f'
      '    on e.filial = f.codigo'
      ''
      '    join colunasprecos cpn   /* pre'#231'o promo'#231#227'o */'
      '      on cpn.caracteristica = p.caracteristica'
      '     AND cpn.preco = p.preco'
      '     AND cpn.coluna = f.preconormal'
      '                '
      '               '
      '     '
      '     '
      ''
      ''
      'where e.produto = p.codigo'
      ' and p.caracteristica = c.codigo'
      ' and c.marca = m.codigo'
      ' and e.filial = f.codigo'
      ' and cpn.caracteristica = p.caracteristica'
      ' AND cpn.preco = p.preco'
      ' AND cpn.coluna = f.preconormal'
      ' AND e.datacompra IS NOT NULL'
      
        '/* AND (e.datacompra)=(select max(e1.datacompra) from estoques e' +
        '1 where e1.produto=e.produto)*/'
      ''
      '  AND (e.produto, e.filial) IN'
      '    (SELECT e1.produto,'
      '            e1.filial'
      '     FROM estoques e1'
      '     WHERE e1.qtdecompra IS NOT NULL'
      '       AND e1.produto = e.produto'
      
        '     ORDER BY e1.datacompra DESC, (e1.emestoque+e1.reservado+e1.' +
        'transito+e1.reservaprevia+e1.conserto+e1.danificada+e1.demonstra' +
        'cao) DESC'
      '     LIMIT 1)'
      ''
      '  and p.codigo = :similar'
      ' '
      ''
      '/*'
      'group by e.produto,'
      '   e.precoCOMicms,'
      '   e.precoSEMicms,'
      '   e.qtdecompra,'
      '   e.aliquotaipi,'
      '   e.valorultimacompra,'
      '   e.filial,'
      '   cpn.valor,'
      '   e.emestoque,'
      '   e.reservado,'
      '   e.transito,'
      '   e.demonstracao,'
      '   e.conserto,'
      '   e.danificada,'
      '   e.financeiro,'
      '   p.datacadastro'
      '*/')
    RequestLive = False
    Left = 265
    Top = 381
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'similar'
        ParamType = ptUnknown
      end>
    object qryDetalhesCompra_Similaresproduto: TLargeintField
      FieldName = 'produto'
    end
    object qryDetalhesCompra_Similaresdatacompra: TDateField
      FieldName = 'datacompra'
    end
    object qryDetalhesCompra_Similaresprecocomicms: TFloatField
      FieldName = 'precocomicms'
    end
    object qryDetalhesCompra_Similaresprecosemicms: TFloatField
      FieldName = 'precosemicms'
    end
    object qryDetalhesCompra_Similaresqtdecompra: TFloatField
      FieldName = 'qtdecompra'
    end
    object qryDetalhesCompra_Similaresaliquotaipi: TFloatField
      FieldName = 'aliquotaipi'
    end
    object qryDetalhesCompra_Similaresvalorultimacompra: TFloatField
      FieldName = 'valorultimacompra'
    end
    object qryDetalhesCompra_Similaresfilial: TIntegerField
      FieldName = 'filial'
    end
    object qryDetalhesCompra_Similarescustomedio: TFloatField
      FieldName = 'customedio'
    end
    object qryDetalhesCompra_Similaresmarkup: TFloatField
      FieldKind = fkCalculated
      FieldName = 'markup'
      Calculated = True
    end
    object qryDetalhesCompra_Similaresdatacadastro: TDateField
      FieldName = 'datacadastro'
    end
  end
  object qryVVendas_Similares: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'FILTRO_CONCEITO'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '/* qryVVendas_Similares */'
      ''
      ';'
      'select produto, mes,'
      '       sum(totalvendas) as totalvendas,'
      '       cast(sum(qtcontrato) as integer) as qtcontrato,'
      ''
      '       sum(totalinternet) as totalinternet,'
      '       cast(sum(qtinternet) as integer) as qtinternet,'
      ''
      '       sum(totalloja) as totalloja,'
      '       cast(sum(qtloja) as integer) as qtloja'
      'from'
      '('
      ''
      ''
      '            select selecao1.produto,'
      
        '                   cast(to_char(selecao1.data,'#39'YYYY/mm'#39') as char' +
        '(7)) AS mes,'
      ''
      '                   selecao1.totalvendas,'
      
        '                   case when selecao1.totalvendas > 0 then cast(' +
        '1 as integer) else cast(0 as integer) end as qtcontrato,'
      ''
      '                   selecao1.totalinternet,'
      
        '                   case when selecao1.totalinternet > 0 then cas' +
        't(1 as integer) else cast(0 as integer) end as qtinternet,'
      ''
      '                   selecao1.totalloja,'
      
        '                   case when selecao1.totalloja > 0 then cast(1 ' +
        'as integer) else cast(0 as integer) end as qtloja'
      ''
      ''
      '            from'
      '            ('
      ''
      ''
      '                 SELECT'
      '                           produto'
      
        '                         , SUM(totalvendas)   as totalvendas    ' +
        '                     '
      '                         , SUM(totalinternet) as totalinternet'
      '                         , SUM(totalloja)     as totalloja'
      
        '                         , data, contrato, quantidade, precovend' +
        'a, precotabela'
      '                 FROM'
      '                           (   '
      '   '
      '                               ('
      ''
      '                               /* SA'#205'DAS */'
      '              '
      '                                     SELECT'
      '                                               m.produto'
      
        '                                             , abs(m.quantidade)' +
        ' as totalvendas,'
      ''
      
        '                                                                ' +
        '   case'
      
        '                                                                ' +
        '             when p_s.contrato is not null'
      
        '                                                                ' +
        '                       then abs(m.quantidade)'
      
        '                                                                ' +
        '                       else 0'
      
        '                                                                ' +
        '   END'
      '                                               as totalinternet,'
      ''
      ''
      ''
      
        '                                                                ' +
        '   case'
      
        '                                                                ' +
        '             when p_s.contrato is not null'
      
        '                                                                ' +
        '                       then 0'
      
        '                                                                ' +
        '                       else abs(m.quantidade)'
      
        '                                                                ' +
        '   END'
      ''
      '                                               as totalloja'
      
        '                                             , m.data, m.contrat' +
        'o, pdf.quantidade, pdf.precovenda, pdf.precotabela'
      '                                     FROM'
      '                                               ((movimentos m'
      '                                                 left join'
      
        '                                                         pedidos' +
        '_site p_s'
      
        '                                                         on m.co' +
        'ntrato = p_s.contrato)'
      ''
      '                                                 join produtos p'
      
        '                                                 on m.produto = ' +
        'p.codigo), '
      '                                                 '
      
        '                                                 (dadosfiscais f' +
        'c'
      
        '                                                  join produtosd' +
        'adosfiscais pdf'
      
        '                                                  on fc.numero =' +
        ' pdf.dadofiscal)'
      ''
      '                                     WHERE p.codigo = :similar'
      
        '                                       and m.data between :datai' +
        'nicial and :datafinal'
      ''
      
        '                                       and coalesce(m.composto,m' +
        '.produto) = pdf.produto'
      '                                               '
      
        '                                               and m.filial = pd' +
        'f.filial'
      
        '                                               AND fc.numero=m.d' +
        'adofiscal'
      
        '                                               AND CASE when :co' +
        'nceitos='#39#39' THEN true ELSE %FILTRO_CONCEITO END'
      
        '                                               and substr(m.oper' +
        'acao,13,1)='#39'+'#39
      '                                               '
      '                                     order by'
      '                                               m.produto'
      '                                             , m.data desc'
      ''
      '                               )'
      ''
      '                               union all'
      ''
      '                               ('
      ''
      ''
      '/* ENTRADAS */'
      ''
      '                                     SELECT'
      '                                               m.produto'
      
        '                                             , -abs(m.quantidade' +
        ') as totalvendas'
      '                                             ,'
      
        '                                                                ' +
        '   case'
      
        '                                                                ' +
        '             when p_s.contrato is not null'
      
        '                                                                ' +
        '                       then -abs(m.quantidade)'
      
        '                                                                ' +
        '                       else 0'
      
        '                                                                ' +
        '   END'
      '                                               as totalinternet'
      '                                             , '
      
        '                                                                ' +
        '   case'
      
        '                                                                ' +
        '             when p_s.contrato is not null'
      
        '                                                                ' +
        '                       then 0'
      
        '                                                                ' +
        '                       else -abs(m.quantidade)'
      
        '                                                                ' +
        '   END'
      '                                               as totalloja'
      
        '                                             , m.data, m.contrat' +
        'o, -pnp.quantidade, pdf.precovenda, pdf.precotabela'
      '                                     FROM'
      '                                               ((movimentos m'
      '                                                left join'
      
        '                                                         pedidos' +
        '_site p_s'
      
        '                                                         on m.co' +
        'ntrato = p_s.contrato)'
      '                                                         '
      '                                                join produtos p'
      
        '                                                on m.produto = p' +
        '.codigo), (notaspag np'
      
        '                                                                ' +
        '    join produtosnotaspag pnp'
      
        '                                                                ' +
        '         left join produtosdadosfiscais pdf'
      
        '                                                                ' +
        '         on pnp.dadofiscal = pdf.dadofiscal'
      
        '                                                                ' +
        '         and pnp.produto = pdf.produto'
      
        '                                                                ' +
        '         and pnp.numeroprodutotabela = pdf.numero'
      
        '                                                                ' +
        '    on np.codigo = pnp.codigonota)'
      
        '                                                                ' +
        '    '
      
        '                                                                ' +
        ' , vfornecedores fc'
      
        '                                                                ' +
        ' '
      '                                    WHERE p.codigo = :similar'
      
        '                                      and m.data between :datain' +
        'icial and :datafinal'
      
        '                                               AND np.codigo    ' +
        '    =m.codigonota'
      
        '                                               AND np.fornecedor' +
        '    =fc.codigo'
      
        '                                               AND np.tipofornec' +
        'edor=fc.tipo'
      
        '                                               and coalesce(m.co' +
        'mposto,m.produto) = pnp.produto'
      
        '                                               and m.filial = pn' +
        'p.filial'
      
        '                                               AND CASE when :co' +
        'nceitos='#39#39' THEN true ELSE  %FILTRO_CONCEITO  END'
      
        '                                               and substr(m.oper' +
        'acao,13,1) ='#39'-'#39
      '                                     order by'
      '                                               m.produto'
      '                                             , m.data desc'
      ''
      ''
      ''
      ''
      '                             )'
      ''
      '                           ) as sel'
      '                           GROUP BY'
      
        '                           sel.produto, sel.data, sel.contrato, ' +
        'sel.quantidade, sel.precovenda, sel.precotabela'
      ''
      '                          order by'
      '                           sel.produto'
      '                         , sel.data desc'
      ''
      '             )  as selecao1'
      ''
      ''
      ') as selecao1'
      'group by produto, mes'
      'order by produto, mes desc')
    RequestLive = False
    Left = 273
    Top = 512
    ParamData = <
