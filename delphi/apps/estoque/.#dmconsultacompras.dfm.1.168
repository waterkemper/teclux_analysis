  object qryProdutosPendentes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT pc.contrato, '
      '       ct.situacao,'
      '       ct.filialvenda,'
      '       ct.data,'
      ''
      '       pc.filial,'
      '       pc.quantidade as quantidadecontrato,'
      ''
      '       (pc.quantidade-coalesce(pc.cancelado,0)) -'
      ''
      '       coalesce((select sum(pdf.qtdeestoque)'
      
        '                 from produtosdadosfiscais pdf join dadosfiscais' +
        ' df on pdf.dadofiscal = df.numero'
      '                 where pdf.dadofiscal = df.numero'
      '                   and df.contrato = pc.contrato'
      '                   and pdf.produto = pc.produto'
      '                   and pdf.filial = pc.filial'
      '                   and not coalesce(df.notavinculada,false)'
      
        '                   and df.situacao='#39'N'#39'),0) as quantidadependente' +
        ','
      ''
      '       e.emestoque,'
      '       e.futuro,'
      '       e.reservado'
      ''
      'from contratos ct'
      '     join produtoscontratos pc'
      '          join estoques e'
      '          on pc.produto = e.produto'
      '          and pc.filial = e.filial'
      '     on ct.numero = pc.contrato'
      ''
      'where ct.situacao in ('#39'R'#39','#39'F'#39','#39'P'#39')'
      
        '  and (pc.quantidade-coalesce(pc.cancelado,0)) > coalesce((selec' +
        't sum(pdf.qtdeestoque)'
      
        '                                              from produtosdados' +
        'fiscais pdf join dadosfiscais df on pdf.dadofiscal = df.numero'
      
        '                                              where pdf.dadofisc' +
        'al = df.numero'
      
        '                                                and df.contrato ' +
        '= pc.contrato'
      
        '                                                and pdf.produto ' +
        '= pc.produto'
      
        '                                                and pdf.filial =' +
        ' pc.filial'
      
        '                                                and not coalesce' +
        '(df.notavinculada,false)'
      
        '                                                and df.situacao=' +
        #39'N'#39'),0)'
      '  and pc.produto = :produto')
    RequestLive = False
    Left = 1032
    Top = 352
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'produto'
        ParamType = ptUnknown
      end>
