      end
      item
        DataType = ftUnknown
        Name = 'resultadocurvaabc'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'produtos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Filiais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'estoques'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '/* qryComprasFiliaisGrupo */'
      ';'
      'select *,'
      '       case when sugestao1 <= 0 then 0'
      
        '       else (cast(ROUND( ( cast((total_vendido) as float) / peri' +
        'odo) * :diasproporcional ) as float) - total_estoque - total_ped' +
        'ido + selecionados.futuro)'
      '       end as sugestao,'
      ''
      '       cast('
      '       case when coalesce(total_vendido,0)<>0 then'
      
        '         ((emEstoque + case when /*:NaoConsiderarPedidosComprapa' +
        'raDiasEstoque*/ true then 0 else total_pedido end)/'
      '          (Total_vendido / Periodo))'
      '       else'
      '         cast(999999.99 as numeric(11,2))'
      '       end as numeric(12,2)) as diasestoque,'
      ''
      '       cast('
      '       case when coalesce(total_vendido,0)<>0 then'
      
        '         ((total_estoque + case when /*:NaoConsiderarPedidosComp' +
        'raparaDiasEstoque*/ false then 0 else total_pedido end)/'
      '          (Total_vendido / Periodo))'
      '       else'
      '         cast(999999.99 as numeric(11,2))'
      '       end as numeric(12,2)) as diasestoquecompedidosdecompra,'
      ''
      ''
      '       selecionados.datapedido'
      ''
      'from'
      ''
      '('
      
        'SELECT *, (cast(ROUND( ( cast(total_vendido as float)/ periodo) ' +
        '* :diasestoque ) as float) - total_estoque - total_pedido + futu' +
        'ro)  AS sugestao1,'
      
        '       case when :EstoqueTotal <> 0 then cast(total_estoque * 10' +
        '0 / :EstoqueTotal as numeric(6,2)) else 0 end as percEstoque,'
      '       (select max(m.data)'
      '        from movimentos m'
      '        where m.produto = selecionados.produto'
      '          and m.filial = selecionados.filial'
      '          and m.tipomovimento = '#39'STC'#39') as datapedido'
      ''
      'FROM'
      '  ('
      '        SELECT'
      '              s.filial,'
      '              s.produto,'
      '              s.periodo,'
      '              fgf.grupo,'
      '              filiais.mnemonico,'
      '              filiais.tipofilial,'
      '              SUM ( s.estoque ) AS total_estoque,'
      '              sum ( s.emestoque ) AS emestoque,'
      '              SUM ( s.transito ) AS total_transito,'
      
        '              SUM ( s.pedido + s.pedidos_filiais) AS total_pedid' +
        'o,'
      '              SUM ( s.pedido ) AS total_pedidos_fornecedores,'
      '              SUM ( s.pedidos_filiais) AS total_pedidos_filiais,'
      '              SUM ( s.vendido ) AS total_vendido,'
      '              s.reservado,'
      '              s.reservaprevia,'
      '              s.ultimavenda,'
      
        '              s.minimo, case when (s.minimo - s.saldo)<0 then 0 ' +
        'else (s.minimo-s.saldo) end as sugestaominimo,'
      
        '              s.maximo,case when (s.maximo - s.saldo)<0 then 0 e' +
        'lse (s.maximo-s.saldo) end as sugestaomaximo, s.futuro'
      '       FROM'
      '       ('
      ''
      '              select e.*,'
      
        '                   coalesce(pedidos_estoquepedido,0) + produtosp' +
        'edidos_recebido_semnotaparcial AS pedido,'
      
        '                   e.estoque + pedidos_estoquepedido - e.futuro ' +
        'as saldo,'
      
        '                   case when e.datacadastro between :inicio and ' +
        ':fim then'
      
        '                                                      case when ' +
        ':fim = e.datacadastro then 1'
      
        '                                                      else :fim ' +
        '- e.datacadastro end'
      '                   else :periodo end as periodo'
      ''
      '              from'
      '              ('
      '              select e.*,'
      '                    case when :NaoConsiderarPedidosCompra then 0'
      
        '                    else produtospedidos_recebido_semnotaparcial' +
        '(e.produto,e.filial) end as produtospedidos_recebido_semnotaparc' +
        'ial'
      ''
      '              FROM'
      '              ('#9
      '              select e.*,'
      
        '                     case when :NaoConsiderarPedidosCompra then ' +
        '0'
      
        '                     else pedidos_estoquepedido(e.produto,e.fili' +
        'al) end as pedidos_estoquepedido'
      ''
      '              from'
      '              ('
      '              select e.*,'
      
        '                     case when :conceitos='#39#39' then movimentos_ven' +
        'dido(:inicio,:fim, e.produto, e.filial)'
      
        '                      else movimentos_vendido_porconceito(:inici' +
        'o,:fim, e.produto, e.filial,:conceitos) end'
      '                      as vendido'
      ''
      '              from'
      ''
      '              ('#9
      ''
      '              select e.*,'
      ''
      '                       /*'
      '                       case when not :PedidosEntreFiliais then 0'
      '                       else'
      '                       coalesce((select sum(pf.qtdepedida)'
      '                       from pedidosfiliais pf'
      '                       where pf.produto = e.produto'
      '                       and pf.requisitante = e.filial'
      '                       and pf.situacao = '#39'A'#39'),0) + e.transito'
      '                       end as pedidos_filiais'
      '                       */'
      ''
      '                   case when not :PedidosEntreFiliais then 0'
      '                   else'
      ''
      
        '                     coalesce((select sum(case when pf.situacao ' +
        '= '#39'A'#39' then pf.qtdepedida'
      
        '                                      when pf.situacao = '#39'F'#39' the' +
        'n 0 end)'
      '                      from pedidosfiliais pf'
      '                      where pf.produto = e.produto'
      '                       and pf.requisitante = e.filial'
      
        '                       and pf.situacao in ('#39'A'#39','#39'F'#39')),0) /*+ e.tr' +
        'ansito*/'
      ''
      '                   end  as pedidos_filiais'
      ''
      ''
      ''
      '              from'
      '              ('
      '              select produtos. *,'
      '                   e.filial,'
      '                       e.datacompra,'
      '                       %quantidadeemestoque  as estoque,'
      '                       e.emestoque,'
      '                       e.futuro,'
      '                       e.transito,'
      '                       e.reservado,'
      '                       e.reservaprevia,'
      '                       e.ultimavenda,'
      '                       coalesce(e.minimo,0) as minimo,'
      '                       coalesce(e.maximo,0) as maximo'
      #9' '
      #9' '
      '              from estoques e join'
      '              ('
      
        '                                       select p.codigo as produt' +
        'o,'
      '                                              p.datacadastro'
      '                                       from produtos p'
      
        '                                       where p.codigo in (%Lista' +
        'deProdutos)'
      ''
      '                                       /*'
      
        '                                       from ((((caracteristicas ' +
        'c'
      '                                                  join marcas m'
      
        '                                                  on c.marca = m' +
        '.codigo)'
      ''
      '                                                 join grupos g'
      
        '                                                 on c.grupo = g.' +
        'codigo)'
      ''
      '                                                join classes cl'
      
        '                                                on c.classe = cl' +
        '.codigo)'
      ''
      '                                               join (produtos p'
      
        '                                                    left join pr' +
        'omocoes pro'
      
        '                                                    on p.promoca' +
        'o = pro.codigo)'
      
        '                                               on p.caracteristi' +
        'ca = c.codigo)'
      ''
      ''
      
        '                                       where p.caracteristica = ' +
        'c.codigo'
      '                                         and c.marca = m.codigo'
      '                                         and c.grupo = g.codigo'
      
        '                                         and c.classe = cl.codig' +
        'o'
      ''
      ''
      ''
      '                           %resultadocurvaabc'
      '                                        */'
      ''
      '                           %produtos'
      '                                        '
      '                                      order by p.codigo'
      ''
      '              ) as produtos on e.produto = produtos.produto'
      '              where true'
      ''
      '                          %Filiais'
      '                          %estoques'
      ''
      '              ) as e'
      '              ) as e'
      '              ) as e'
      '              ) as e'
      '              ) as e'
      '              order by filial, produto'
      ''
      ''
      '       ) AS s'
      '           JOIN filiais'
      '           join (filiaisgruposfiliais fgf'
      '                 join gruposfiliais g'
      '                   on fgf.grupo = g.codigo)'
      '           on filiais.codigo = fgf.filial'
      '           on s.filial=filiais.codigo'
      
        '      GROUP BY s.produto,fgf.grupo, s.filial, filiais.mnemonico,' +
        ' filiais.tipofilial, s.reservado, s.reservaprevia, s.futuro, s.m' +
        'inimo, s.maximo, s.saldo, s.periodo, s.ultimavenda'
      '   ) AS selecionados'
      ''
      
        '/*where  (total_estoque<>0) or (total_pedido<>0) or (total_vendi' +
        'do<>0)*/'
      ''
      'ORDER BY mnemonico'
      ''
      ') as selecionados')
