  object qryVVendasDiaria_Detalhada: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'FILTRO_CONCEITO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Visualizacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select cast(to_char(selecao1.data,'#39'YYYY/mm'#39') as char(7)) AS mes,'
      '       selecao1.data,'
      '       selecao1.produto,'
      ''
      '       selecao1.totalvendas,'
      
        '       case when selecao1.totalvendas > 0 then 1 else 0 end as q' +
        'tcontrato,'
      ''
      '       selecao1.totalinternet,'
      
        '       case when selecao1.totalinternet > 0 then 1 else 0 end as' +
        ' qtinternet,'
      ''
      '       selecao1.totalloja,'
      
        '       case when selecao1.totalloja > 0 then 1 else 0 end as qtl' +
        'oja,'
      ''
      '       selecao1.contrato,'
      '       selecao1.quantidade,'
      ''
      '       selecao1.precovenda,'
      '       selecao1.precotabela,'
      ''
      '       selecao1.vendedor,'
      '       u.nome as nomevendedor'
      ''
      ''
      ''
      'from'
      '('
      ''
      ''
      '     SELECT'
      '               produto'
      
        '             , SUM(totalvendas)   as totalvendas                ' +
        '         '
      '             , SUM(totalinternet) as totalinternet'
      '             , SUM(totalloja)     as totalloja'
      
        '             , data, contrato, vendedor, sum(quantidade) as quan' +
        'tidade, precovenda, precotabela'
      '     FROM'
      '               (   '
      '   '
      '                   ('
      ''
      '                   /* SA'#205'DAS */'
      '              '
      '                         SELECT'
      '                                   p.codigovisual as produto'
      
        '                                 , abs(m.quantidade) as totalven' +
        'das,'
      ''
      '                                                       case'
      
        '                                                                ' +
        ' when p_s.contrato is not null'
      
        '                                                                ' +
        '           then abs(m.quantidade)'
      
        '                                                                ' +
        '           else 0'
      '                                                       END'
      '                                   as totalinternet,'
      ''
      ''
      ''
      '                                                       case'
      
        '                                                                ' +
        ' when p_s.contrato is not null'
      
        '                                                                ' +
        '           then 0'
      
        '                                                                ' +
        '           else abs(m.quantidade)'
      '                                                       END'
      ''
      '                                   as totalloja'
      
        '                                 , m.data, m.contrato, pdf.quant' +
        'idade, pdf.precovenda, pdf.precotabela, pdf.vendedor'
      '                         FROM'
      '                                   ((movimentos m'
      '                                   left join'
      '                                             pedidos_site p_s'
      '                                             on'
      
        '                                                       m.contrat' +
        'o = p_s.contrato)'
      ''
      '                                   join produtos p'
      '                                   on  m.produto = p.codigo)'
      ''
      ''
      
        '                                                     , (dadosfis' +
        'cais fc'
      
        '                                                        join pro' +
        'dutosdadosfiscais pdf'
      
        '                                                        on fc.nu' +
        'mero = pdf.dadofiscal)'
      ''
      '                         WHERE p.codigo = :codigoproduto'
      
        '                         and m.data between :datainicial and :da' +
        'tafinal'
      ''
      
        '                                   and coalesce(m.composto,m.pro' +
        'duto) = pdf.produto'
      '                                   and m.filial = pdf.filial'
      '                                   AND fc.numero=m.dadofiscal'
      
        '                                   AND CASE when :conceitos='#39#39' T' +
        'HEN true ELSE %FILTRO_CONCEITO END'
      
        '                                   and substr(m.operacao,13,1)='#39 +
        '+'#39
      ''
      '                                   %Visualizacao'
      '                         order by'
      '                                   m.produto'
      '                                 , m.data desc'
      ''
      '                   )'
      ''
      '                   union all'
      ''
      '                   ('
      ''
      ''
      '/* ENTRADAS */'
      ''
      '                         SELECT'
      '                                   p.codigovisual as produto'
      
        '                                 , -abs(m.quantidade) as totalve' +
        'ndas'
      '                                 ,'
      '                                                       case'
      
        '                                                                ' +
        ' when p_s.contrato is not null'
      
        '                                                                ' +
        '           then -abs(m.quantidade)'
      
        '                                                                ' +
        '           else 0'
      '                                                       END'
      '                                   as totalinternet'
      '                                 , '
      '                                                       case'
      
        '                                                                ' +
        ' when p_s.contrato is not null'
      
        '                                                                ' +
        '           then 0'
      
        '                                                                ' +
        '           else -abs(m.quantidade)'
      '                                                       END'
      '                                   as totalloja'
      
        '                                 , m.data, m.contrato, -pnp.quan' +
        'tidade,'
      
        '                                   coalesce(pdf.precovenda, pnp.' +
        'precounitario) as precovenda,'
      
        '                                   coalesce(pnp.precounitario,pd' +
        'f.precotabela) as precotabela, coalesce(pdf.vendedor, pnp.vended' +
        'or) as vendedor'
      '                         FROM'
      '                                   ((movimentos m'
      '                                   left join'
      '                                             pedidos_site p_s'
      '                                             on'
      
        '                                                       m.contrat' +
        'o = p_s.contrato)'
      ''
      '                                   join produtos p'
      '                                   on m.produto = p.codigo)'
      ''
      
        '                                                     , (notaspag' +
        ' np'
      
        '                                                        join pro' +
        'dutosnotaspag pnp'
      
        '                                                             lef' +
        't join produtosdadosfiscais pdf'
      
        '                                                             on ' +
        'pnp.dadofiscal = pdf.dadofiscal'
      
        '                                                             and' +
        ' pnp.produto = pdf.produto'
      
        '                                                             and' +
        ' pnp.numeroprodutotabela = pdf.numero'
      ''
      
        '                                                        on np.co' +
        'digo = pnp.codigonota)'
      
        '                                                                ' +
        '    '
      
        '                                                     , vforneced' +
        'ores fc'
      '                        WHERE p.codigo = :codigoproduto'
      
        '                          and m.data between :datainicial and :d' +
        'atafinal'
      
        '                                   AND np.codigo        =m.codig' +
        'onota'
      
        '                                   AND np.fornecedor    =fc.codi' +
        'go'
      '                                   AND np.tipofornecedor=fc.tipo'
      
        '                                   and coalesce(m.composto,m.pro' +
        'duto) = pnp.produto'
      '                                   and m.filial = pnp.filial'
      
        '                                   AND CASE when :conceitos='#39#39' T' +
        'HEN true ELSE  %FILTRO_CONCEITO  END'
      
        '                                   and substr(m.operacao,13,1) =' +
        #39'-'#39
      ''
      '                                   %Visualizacao'
      '                                   '
      '                         order by'
      '                                   m.produto'
      '                                 , m.data desc'
      ''
      ''
      ''
      ''
      '                 )'
      ''
      '               ) as sel'
      '               GROUP BY'
      
        '               sel.produto, sel.data, sel.contrato, sel.vendedor' +
        ', sel.precovenda, sel.precotabela'
      ''
      '              order by'
      '               sel.produto'
      '             , sel.data desc'
      ''
      ' )  as selecao1 join usuarios u on selecao1.vendedor = u.codigo')
    RequestLive = False
    Left = 512
    Top = 640
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codigoproduto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'conceitos'
        ParamType = ptUnknown
      end>
    object qryVVendasDiaria_Detalhadames: TStringField
      DisplayLabel = 'M'#234's'
      FieldName = 'mes'
      Size = 7
