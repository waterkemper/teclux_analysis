    object qryComprasTotaltotalvenda: TFloatField
      FieldKind = fkCalculated
      FieldName = 'totalvenda'
      DisplayFormat = '0.00'
      Calculated = True
    end
    object qryComprasTotaltotalcusto: TFloatField
      FieldKind = fkCalculated
      FieldName = 'totalcusto'
      DisplayFormat = '0.00'
      Calculated = True
