  object qryProdutosSimilares: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryProdutosSimilaresAfterOpen
    BeforeScroll = qryProdutosSimilaresBeforeScroll
    AfterScroll = qryProdutosSimilaresAfterScroll
    OnCalcFields = qryProdutosSimilaresCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'quantidadeemestoque'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiliaisEstoque'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Filiais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'estoques'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'sugestao8'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'sugestao2'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'ORDERBY'
        ParamType = ptUnknown
        Value = 'order by 1'
      end>
    Sql.Strings = (
      ';'
      '    select selecionados6.*,'
      '             np.fornecedor,'
      '             np.tipofornecedor,'
      '             coalesce(vf.nome, vf.razao) as nomefornecedor,'
      '             False as Selecionado,'
      ''
      '             cast('
      '             case when coalesce(total_vendido,0)<>0 then'
      
        '               ((emEstoque + case when /* :NaoConsiderarPedidosC' +
        'ompraparaDiasEstoque */ true then 0 else total_pedido end)/'
      '                (Total_vendido / periodo ))'
      '             else'
      '               cast(999999.99 as numeric(11,2))'
      '             end as numeric(12,2)) as diasestoque,'
      ''
      '             cast('
      '             case when coalesce(total_vendido,0)<>0 then'
      
        '               ((total_estoque + case when /* :NaoConsiderarPedi' +
        'dosCompraparaDiasEstoque */ false then 0 else total_pedido end)/'
      '                (Total_vendido / periodo ))'
      '             else'
      '               cast(999999.99 as numeric(11,2))'
      
        '             end as numeric(12,2)) as diasestoquecompedidosdecom' +
        'pra,'
      ''
      ''
      
        '             (select estoques_produtoempromocao(selecionados6.pr' +
        'oduto, :filialbase)) as produtoempromocao,'
      ''
      '            produto = :produto as Principal'
      ''
      ''
      '     from'
      '     ('
      ''
      '      select selecionados5.*'
      ''
      '      from'
      '      ('
      '      SELECT *,'
      
        '              /*SE TEM SUGESTAO DE COMPRA, DE ACORDO COM DIASEST' +
        'OQUE, ENTAO RECALCULA A SUGESTAO DE ACORDO COM DIAS PROPORCIONAL' +
        '*/'
      
        '             case when sugestao1 <= 0 then 0 else (cast(ROUND( (' +
        ' cast((total_vendido) as float) / periodo) * :diasproporcional )' +
        ' as float) - total_estoque - total_pedido + futuro) end as suges' +
        'tao'
      '      from'
      '      ('
      
        '      SELECT *, (cast(ROUND( ( cast((total_vendido) as float) / ' +
        'periodo) * :diasestoque ) as float) - total_estoque - total_pedi' +
        'do+futuro) AS sugestao1'
      '      FROM'
      '        ('
      '         SELECT selecionados2.*,'
      '                      colunasprecos.valor AS precovenda,'
      
        '                      cast(case when selecionados2.customedio  =' +
        ' 0 then 0'
      
        '                                       else ROUND( (colunaspreco' +
        's.valor / selecionados2.customedio - 1) * 100,2)'
      '                              end as numeric(15,2)) AS markup,'
      #9#9#9#9#9#9#9
      
        #9#9'case when selecionados2.datacadastro between :inicio and :fim ' +
        'then'
      #9#9#9#9#9#9#9'case when :fim = selecionados2.datacadastro then 1'
      #9#9#9#9#9#9#9'else :fim - selecionados2.datacadastro end'
      '                else :periodo end as periodo'
      ''
      '         FROM'
      '         ('
      '           select selecionados1.*,'
      
        '                  estoques.precoCOMicms, estoques.precoSEMicms, ' +
        'estoques.aliquotaIPI,'
      '                  estoques.qtdecompra,'
      '                  estoques.datacompra,'
      ''
      
        '                     cast(case when (Estoques.EmEstoque + Estoqu' +
        'es.Reservado    +'
      '                 Estoques.Transito  + Estoques.Demonstracao +'
      
        '                 Estoques.Conserto  + Estoques.Danificada   + Es' +
        'toques.ReservaPrevia) = 0 then 0'
      '                     else ROUND( estoques.financeiro /'
      
        '                     (Estoques.EmEstoque + Estoques.Reservado   ' +
        ' +'
      '                 Estoques.Transito  + Estoques.Demonstracao +'
      
        '                 Estoques.Conserto  + Estoques.Danificada   + Es' +
        'toques.ReservaPrevia),2)'
      '                     end as numeric(11,2)) AS customedio'
      ''
      '          FROM'
      '          ('
      '             select estoquesprodutos.linha,'
      '              estoquesprodutos.coluna,'
      '              estoquesprodutos.codigogrupo,'
      '                    estoquesprodutos.grupo,'
      ''
      '              estoquesprodutos.codigoclasse,'
      '                    estoquesprodutos.classe,'
      ''
      '              estoquesprodutos.promocao,'
      '              estoquesprodutos.descricaopromocao,'
      ''
      '              estoquesprodutos.codigomarca,'
      '                    estoquesprodutos.marca,'
      '              estoquesprodutos.produto,'
      '              estoquesprodutos.produtosml,'
      '              '
      '              estoquesprodutos.produtovisual,'
      '                    estoquesprodutos.nomeproduto,'
      '              estoquesprodutos.valorgrade1,'
      '              estoquesprodutos.valorgrade2,'
      '              estoquesprodutos.incidencia,'
      '              estoquesprodutos.csosn,'
      ''
      '              estoquesprodutos.composto,'
      '              '
      '              estoquesprodutos.caracteristica,'
      '              estoquesprodutos.caracteristicavisual,'
      ''
      '                    estoquesprodutos.referencia,'
      '              estoquesprodutos.resultadocurvaabc,'
      
        '              estoquesprodutos.lembrarpedido, estoquesprodutos.o' +
        'bslembrarpedido,'
      ''
      #9#9#9'  estoquesprodutos.datacadastro,'
      '                          estoquesprodutos.inativo,'
      '              '
      '                    estoquesprodutos.preco,'
      '                   coalesce((select e.filial'
      '                    from estoques e'
      
        '                    where e.produto = estoquesprodutos.produto a' +
        'nd'
      
        '                              e.datacompra = max(estoquesproduto' +
        's.datacompra)'
      '                    limit 1), :filialbase) as filial,'
      
        '                    SUM ( estoquesprodutos.estoque ) AS total_es' +
        'toque,'
      
        '                    SUM ( estoquesprodutos.emEstoque ) AS emEsto' +
        'que,'
      ''
      ''
      
        '                    SUM ( estoquesprodutos.transito ) AS total_t' +
        'ransito,'
      ''
      
        '                    SUM ( estoquesprodutos.pedido  + estoquespro' +
        'dutos.pedidos_filiais) AS total_pedido,'
      
        '                    SUM ( estoquesprodutos.pedido) AS total_pedi' +
        'dos_fornecedores,'
      
        '                    SUM ( estoquesprodutos.pedidos_filiais) as t' +
        'otal_pedidos_filiais,'
      
        '                    SUM ( estoquesprodutos.vendido ) AS total_ve' +
        'ndido,'
      
        '                    CAST (SUM (estoquesprodutos.reservado) as fl' +
        'oat) as reservado,'
      
        '                    CAST (SUM (estoquesprodutos.reservaprevia) a' +
        's float) as reservaprevia,'
      
        '                    CAST (SUM (estoquesprodutos.futuro) as float' +
        ') as futuro,'
      '                    cast(SUM(minimo) as float) as minimo,'
      
        '                    cast(case when SUM(minimo - saldo)<0 then 0 ' +
        'else SUM(minimo-saldo) end as float) as sugestaominimo,'
      '                    cast (SUM (maximo) as float) as maximo,'
      
        '                    cast(case when SUM(maximo - saldo)<0 then 0 ' +
        'else SUM(maximo-saldo) end as float) as sugestaomaximo'
      '            from'
      '           ('
      ''
      ''
      '              select e.*,'
      '                   case when :NaoConsiderarPedidosCompra then 0'
      
        '                   else coalesce(pedidos_estoquepedido,0) + prod' +
        'utospedidos_recebido_semnotaparcial end AS pedido,'
      
        '                       e.estoque + pedidos_estoquepedido - e.fut' +
        'uro as saldo'
      '              from'
      '              ('
      '              select e.*,'
      '                    case when :NaoConsiderarPedidosCompra then 0'
      
        '                    else produtospedidos_recebido_semnotaparcial' +
        '(e.produto,e.filial) end as produtospedidos_recebido_semnotaparc' +
        'ial'
      ''
      '              FROM'
      '              ('
      '              select e.*,'
      
        '                     case when :NaoConsiderarPedidosCompra then ' +
        '0'
      
        '                     else pedidos_estoquepedido(e.produto,e.fili' +
        'al) end as pedidos_estoquepedido'
      ''
      '              from'
      '              ('
      '              select e.*,'
      
        '                      movimentos_vendido(:inicio,:fim, e.produto' +
        ', e.filial) as vendido'
      ''
      '              from'
      ''
      '              ('
      ''
      '              select e.*,'
      ''
      '                       /*'
      '                       case when not :PedidosEntreFiliais then 0'
      '                       else'
      '                       coalesce((select sum(pf.qtdepedida)'
      '                       from pedidosfiliais pf'
      '                       where pf.produto = e.produto'
      '                       and pf.requisitante = e.filial'
      '                       and pf.situacao = '#39'A'#39'),0) + e.transito'
      '                       end as pedidos_filiais'
      '                       */'
      '                       '
      '                   case when not :PedidosEntreFiliais then 0'
      '                   else'
      ''
      
        '                     coalesce((select sum(case when pf.situacao ' +
        '= '#39'A'#39' then pf.qtdepedida'
      
        '                                      when pf.situacao = '#39'F'#39' the' +
        'n 0 end)'
      '                      from pedidosfiliais pf'
      '                      where pf.produto = e.produto'
      '                       and pf.requisitante = e.filial'
      
        '                       and pf.situacao in ('#39'A'#39','#39'F'#39')),0) + e.tran' +
        'sito'
      ''
      '                   end  as pedidos_filiais'
      ''
      ''
      ''
      '              from'
      '              ('
      '              select produtos. *,'
      '                   e.filial,'
      '                       e.datacompra,'
      '                       %quantidadeemestoque  as estoque,'
      '                       e.emestoque,'
      '                       e.futuro,'
      '                       e.transito,'
      '                       e.reservado,'
      '                       e.reservaprevia,'
      '                       coalesce(e.minimo,0) as minimo,'
      '                       coalesce(e.maximo,0) as maximo'
      ''
      ''
      '              from estoques e join'
      '              ('
      
        '                                       select gr1.descricao as l' +
        'inha,'
      
        '                                               gr2.descricao as ' +
        'coluna,'
      
        '                                               c.grupo as codigo' +
        'grupo,'
      
        '                                               g.descricao as gr' +
        'upo,'
      ''
      
        '                                               c.classe as codig' +
        'oclasse,'
      
        '                                               cl.descricao as c' +
        'lasse,'
      '                                               p.promocao,'
      
        '                                               pro.descricao as ' +
        'descricaopromocao,'
      ''
      
        '                                               c.marca as codigo' +
        'marca,'
      
        '                                               m.descricao as ma' +
        'rca,'
      
        '                                               p.codigo as produ' +
        'to,'
      
        '                                               p.codigovisual as' +
        ' produtovisual,'
      
        '                                               p.descricao as no' +
        'meproduto,'
      '                                               p.valorgrade1,'
      '                                               p.valorgrade2,'
      '                                               c.composto,'
      '                                               p.caracteristica,'
      
        '                                               c.codigovisual as' +
        ' caracteristicavisual,'
      '                                               p.referencia,'
      '                                               p.preco,'
      
        '                                               p.resultadocurvaa' +
        'bc,'
      
        '                                               p.lembrarpedido, ' +
        'p.obslembrarpedido,'
      '                                               p.datacadastro,'
      
        '                                               p.inativo,       ' +
        '                                       '
      
        '                                              (select ti.valor f' +
        'rom tributosicms ti where ti.codigo = c.incidencia) as incidenci' +
        'a,'
      '                                               c.csosn,'
      
        '                                               similares.produto' +
        'sml'
      ''
      ''
      
        '                                       from ((((((caracteristica' +
        's c join classes cl on c.classe = cl.codigo)'
      
        '                                                                ' +
        '   join marcas m on c.marca = m.codigo)'
      
        '                                                                ' +
        '  join grupos g on c.grupo = g.codigo)'
      ''
      
        '                                               join (produtos p ' +
        'left join promocoes pro on p.promocao = pro.codigo)'
      
        '                                               on p.caracteristi' +
        'ca = c.codigo)'
      
        '                                               left join grades ' +
        'gr1 on gr1.codigo = c.grade1)'
      
        '                                               left join grades ' +
        'gr2 on gr2.codigo = c.grade2),'
      '                                             '
      '                                             '
      '                                             '
      '                                             '
      '                                             ('
      '                                             '
      
        '                                                         SELECT ' +
        'distinct codigo, produto as produtosml'
      ''
      '                                                         from'
      '                                                         ('
      ''
      '                                                           ('
      ''
      
        '                                                             sel' +
        'ect distinct ps.codigo, psel_similar.psel_codigo as produto'
      ''
      ''
      
        '                                                             fro' +
        'm (produtos ps'
      
        '                                                                ' +
        '   join caracteristicas cs'
      
        '                                                                ' +
        '   on ps.caracteristica = cs.codigo),'
      ''
      '                                                             ('
      ''
      
        '                                                               s' +
        'elect distinct'
      
        '                                                                ' +
        '     psel.codigo as psel_codigo,'
      
        '                                                                ' +
        '     psel.caracteristica as psel_caracteristica,'
      
        '                                                                ' +
        '     psel.agrupamentosimilares as psel_agrupamentosimilares,'
      
        '                                                                ' +
        '     psel.grade1 as psel_grade1,'
      
        '                                                                ' +
        '     psel.grade2 as psel_grade2,'
      
        '                                                                ' +
        '     psel.valorgrade1 as psel_valorgrade1,'
      
        '                                                                ' +
        '     psel.valorgrade2 as psel_valorgrade2,'
      
        '                                                                ' +
        '     s."similar"'
      
        '                                                                ' +
        '   '
      
        '                                                               f' +
        'rom similares s right outer join'
      '                                                                '
      
        '                                                                ' +
        '     ('
      
        '                                                                ' +
        '     select p.codigo, '
      
        '                                                                ' +
        '            p.caracteristica, '
      
        '                                                                ' +
        '            c.agrupamentosimilares,'
      
        '                                                                ' +
        '            c.grade1,'
      
        '                                                                ' +
        '            c.grade2,'
      
        '                                                                ' +
        '            p.valorgrade1,'
      
        '                                                                ' +
        '            p.valorgrade2'
      
        '                                                                ' +
        '            '
      
        '                                                                ' +
        '     from produtos p '
      
        '                                                                ' +
        '          join caracteristicas c'
      
        '                                                                ' +
        '           on p.caracteristica = c.codigo'
      
        '                                                                ' +
        '     where p.codigo = :produto'
      
        '                                                                ' +
        '     ) as psel'
      
        '                                                                ' +
        '     '
      
        '                                                               O' +
        'N s.caracteristica = psel.caracteristica        '
      
        '                                                             ) a' +
        's psel_similar'
      '                                                              '
      
        '                                                            wher' +
        'e (ps.caracteristica = psel_similar.similar or '
      
        '                                                                ' +
        '   ps.caracteristica  = psel_similar.psel_caracteristica)'
      
        '                                                                ' +
        '  '
      
        '                                                /*              ' +
        'and ps.codigo <> psel_similar.psel_codigo*/'
      '                                                              '
      
        '                                                              an' +
        'd ((ps.inativo IS NULL) OR '
      
        '                                                                ' +
        '   (ps.inativo>CURRENT_DATE))'
      
        '                                                                ' +
        '   '
      
        '                                                              an' +
        'd case when coalesce(psel_agrupamentosimilares, '#39#39') = '#39'L'#39
      
        '                                                                ' +
        '           AND psel_grade1 IS NOT NULL'
      
        '                                                                ' +
        '           AND psel_valorgrade1 IS NOT NULL  then '
      
        '                                                                ' +
        '           '
      
        '                                                                ' +
        '              ps.valorgrade1 = psel_valorgrade1'
      
        '                                                                ' +
        '              and cs.grade1 = psel_grade1'
      
        '                                                                ' +
        '           '
      
        '                                                                ' +
        '           '
      
        '                                                                ' +
        '       when coalesce(psel_agrupamentosimilares, '#39#39') = '#39'C'#39
      
        '                                                                ' +
        '           AND psel_grade2 IS NOT NULL'
      
        '                                                                ' +
        '           AND psel_valorgrade2 IS NOT NULL  then  '
      
        '                                                                ' +
        '           '
      
        '                                                                ' +
        '             ps.valorgrade2 = psel_valorgrade2'
      
        '                                                                ' +
        '             and cs.grade2 = psel_grade2'
      
        '                                                                ' +
        '           '
      
        '                                                                ' +
        '  else true end     '
      '                                                              '
      '                                                             )'
      ''
      
        '                                                              un' +
        'ion all'
      '                                                              '
      '                                                             ('
      
        '                                                               S' +
        'ELECT ps."similar" as codigo, ps.produto'
      
        '                                                               F' +
        'ROM produtos_similares ps'
      
        '                                                               W' +
        'HERE ps.produto = :produto'
      ''
      '                                                              )'
      '                                                              '
      
        '                                                            ) as' +
        ' ps'
      '                                                order by codigo'
      '                                             '
      '                                             '
      '                                             ) as similares'
      ''
      
        '                                       where p.caracteristica = ' +
        'c.codigo'
      '                                         and c.marca = m.codigo'
      '                                         and c.grupo = g.codigo'
      
        '                                         and c.classe = cl.codig' +
        'o'
      ''
      
        '                                          and p.codigo = similar' +
        'es.codigo'
      ''
      '                                         %FiliaisEstoque     '
      ''
      '                                      order by p.codigo'
      ''
      '              ) as produtos on e.produto = produtos.produto'
      '              where true'
      ''
      '                          %Filiais'
      '                          %estoques'
      ''
      '              ) as e'
      '              ) as e'
      '              ) as e'
      '              ) as e'
      '              ) as e'
      ''
      ''
      ''
      ''
      '           ) as estoquesprodutos'
      ''
      
        '            GROUP BY nomeproduto, produtovisual, produto, produt' +
        'osml, valorgrade1, valorgrade2, composto, linha, coluna, referen' +
        'cia, caracteristica, caracteristicavisual, preco, codigogrupo, g' +
        'rupo, codigoclasse, classe, promocao, descricaopromocao, codigom' +
        'arca, marca, resultadocurvaabc, lembrarpedido, obslembrarpedido,' +
        ' datacadastro, inativo, incidencia, csosn'
      
        '          ) AS selecionados1 left join estoques on selecionados1' +
        '.produto = estoques.produto and'
      
        '                                                   selecionados1' +
        '.filial = estoques.filial'
      ''
      '        ) as selecionados2, filiais, colunasprecos'
      '          where selecionados2.filial = filiais.codigo and'
      
        '                    colunasprecos.caracteristica = selecionados2' +
        '.caracteristica and'
      
        '                    colunasprecos.preco =   selecionados2.preco ' +
        'and'
      '                    colunasprecos.coluna = filiais.preconormal'
      '       ) AS selecionados3'
      '      ) as selecionados4'
      '      ) as selecionados5'
      '     '
      '   %sugestao8'
      '   '
      '   ) as selecionados6'
      '   '
      '  left join notaspag np'
      '   on( np.codigo = (select max(pn.codigonota)'
      '                   from produtosnotaspag pn,notaspag np1'
      '                   where pn.produto = selecionados6.produto'
      '                   and np1.codigo=pn.codigonota'
      '                   and np1.tipofornecedor<>'#39'L'#39
      
        '                   and ehnotafiscalentradacompra(pn.codigofiscal' +
        '))'
      '      )'
      
        '   left join vfornecedores vf on (np.fornecedor = vf.codigo and ' +
        'np.tipofornecedor = vf.tipo)'
      ''
      ''
      '   /* %sugestao2 */'
      ''
      '   %ORDERBY'
      '')
    RequestLive = False
    Left = 192
    Top = 139
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'NaoConsiderarPedidosCompraparaDiasEstoque'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filialbase'
        ParamType = ptUnknown
      end
      item
