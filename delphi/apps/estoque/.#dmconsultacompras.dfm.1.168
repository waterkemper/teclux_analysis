  object qryComprasTotal_ComTabelaReducao_TodasFiliais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AutoCalcFields = False
    AfterInsert = qryComprasTotalAfterInsert
    AfterScroll = qryComprasTotalAfterScroll
    OnCalcFields = qryComprasTotalCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'quantidadeemestoque'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'produtos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiliaisEstoque'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'resultadocurvaabc'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Filiais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'estoques'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'sugestao2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'sugestao8'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ORDERBY'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '/* qryComprasTotal_ComTabelaReducao_TodasFiliais */'
      ';'
      'select selecionados8.*,'
      '       np.fornecedor,'
      '       np.tipofornecedor,'
      '       coalesce(vf.nome, vf.razao) as nomefornecedor,'
      
        #9'   (select estoques_produtoempromocao(selecionados8.produto, :f' +
        'ilialbase)) as produtoempromocao,'
      '       False as Selecionado,'
      ''
      '       ('
      '      select count(*) from'
      '         ( '
      '      '
      '           ('
      '             '
      '             select ps.codigo as ps_codigo'
      '                    '
      '                    '
      '             from (produtos ps '
      '                   join caracteristicas cs '
      '                   on ps.caracteristica = cs.codigo),'
      '             '
      '             ('
      '             '
      '               select distinct'
      '                     psel.codigo as psel_codigo,'
      '                     psel.caracteristica as psel_caracteristica,'
      
        '                     psel.agrupamentosimilares as psel_agrupamen' +
        'tosimilares,'
      '                     psel.grade1 as psel_grade1,'
      '                     psel.grade2 as psel_grade2,'
      '                     psel.valorgrade1 as psel_valorgrade1,'
      '                     psel.valorgrade2 as psel_valorgrade2,'
      '                     psel.composto as psel_composto,'
      '                     s."similar"'
      ''
      '               from similares s right outer join'
      '                '
      '                     ('
      '                     select p.codigo, '
      '                            p.caracteristica, '
      '                            c.agrupamentosimilares,'
      '                            c.grade1,'
      '                            c.grade2,'
      '                            p.valorgrade1,'
      '                            p.valorgrade2,'
      '                            c.composto'
      '                            '
      '                     from produtos p '
      '                          join caracteristicas c'
      '                           on p.caracteristica = c.codigo'
      '                     where p.codigo = selecionados8.produto'
      '                     ) as psel'
      '                     '
      '               on s.caracteristica = psel.caracteristica        '
      '             ) as psel_similar'
      '              '
      '            where (ps.caracteristica = psel_similar.similar or '
      
        '                   ps.caracteristica  = psel_similar.psel_caract' +
        'eristica)'
      '                  '
      '              and ps.codigo <> psel_similar.psel_codigo'
      '              '
      '              and ((ps.inativo IS NULL) OR '
      '                   (ps.inativo>CURRENT_DATE))'
      '                   '
      
        '              and case when coalesce(psel_agrupamentosimilares, ' +
        #39#39') = '#39'L'#39
      '                           AND psel_grade1 IS NOT NULL'
      
        '                           AND psel_valorgrade1 IS NOT NULL  the' +
        'n '
      '                           '
      '                              ps.valorgrade1 = psel_valorgrade1'
      '                              and cs.grade1 = psel_grade1'
      '                           '
      '                           '
      
        '                       when coalesce(psel_agrupamentosimilares, ' +
        #39#39') = '#39'C'#39
      '                           AND psel_grade2 IS NOT NULL'
      
        '                           AND psel_valorgrade2 IS NOT NULL  the' +
        'n  '
      '                           '
      '                             ps.valorgrade2 = psel_valorgrade2'
      '                             and cs.grade2 = psel_grade2'
      '                           '
      '                  else true end  '
      '                             '
      '             limit 1'
      '             '
      '             )'
      ''
      '              union all'
      '              '
      '             ('
      '               SELECT ps."similar" as ps_codigo'
      '               FROM produtos_similares ps'
      '               WHERE ps.produto = selecionados8.produto limit 1'
      '             '
      '              )'
      '              '
      '            ) as ps'
      '            '
      '           ) <> 0  AS ExisteSimilar'
      ''
      'from'
      '('
      '  select'
      
        '        (cast(ROUND( ( cast((total_vendido) as float) / periodo)' +
        ' * sugestaopara ) as float) - total_estoque - total_pedido+futur' +
        'o) as sugestao,'
      '       selecionados7.*'
      ''
      '  from'
      '  ('
      ''
      '    select selecionados6.*,'
      '    /*'
      
        '           case when selecionados6.diasestoque > :diasproporcion' +
        'al then'
      '               :diasproporcional'
      '             else'
      '             */'
      '         coalesce((select rcc.sugestaopara'
      '                       from reducaoconsultacompras rcc'
      
        '                       where rcc.estoquepara <= selecionados6.di' +
        'asestoque'
      
        '                       order by rcc.estoquepara desc limit 1),:d' +
        'iasproporcional)'
      '             /*end */ as sugestaopara'
      '    from'
      '    ('
      ''
      '      select selecionados5.*,'
      ''
      '             cast('
      '             case when coalesce(total_vendido,0)<>0 then'
      '               (emEstoque / (Total_vendido / periodo ))'
      '             else'
      '               cast(999999.99 as numeric(11,2))'
      '             end as numeric(12,2)) as diasestoque,'
      ''
      '             cast('
      '             case when coalesce(total_vendido,0)<>0 then'
      
        '               ((total_estoque + case when /*:NaoConsiderarPedid' +
        'osCompraparaDiasEstoque*/ false then 0 else  total_pedido end)/'
      '                (Total_vendido / periodo ))'
      '             else'
      '               cast(999999.99 as numeric(11,2))'
      
        '             end as numeric(12,2)) as diasestoquecompedidosdecom' +
        'pra'
      ''
      ''
      '      from'
      '      ('
      '      SELECT *,'
      
        '              /*SE TEM SUGESTAO DE COMPRA, DE ACORDO COM DIASEST' +
        'OQUE, ENTAO RECALCULA A SUGESTAO DE ACORDO COM DIAS PROPORCIONAL' +
        '*/'
      
        '             case when sugestao1 <= 0 then 0 else (cast(ROUND( (' +
        ' cast((total_vendido) as float) / periodo) * :diasproporcional )' +
        ' as float) - total_estoque - total_pedido+futuro) end as sugesta' +
        'o2'
      '      from'
      '      ('
      
        '      SELECT *, (cast(ROUND( ( cast((total_vendido) as float) / ' +
        'periodo) * :diasestoque ) as float) - total_estoque - total_pedi' +
        'do+futuro) AS sugestao1'
      '      FROM'
      '        ('
      '         SELECT selecionados2.*,'
      '                      colunasprecos.valor AS precovenda,'
      
        '                      cast(case when selecionados2.customedio  =' +
        ' 0 then 0'
      
        '                                       else ROUND( (colunaspreco' +
        's.valor / selecionados2.customedio - 1) * 100,2)'
      '                              end as numeric(15,2)) AS markup,'
      #9#9#9#9#9#9#9'  '
      
        ' '#9#9'        case when selecionados2.datacadastro between :inicio ' +
        'and :fim then'
      #9#9#9#9#9#9#9'case when :fim = selecionados2.datacadastro then 1'
      #9#9#9#9#9#9#9'else :fim - selecionados2.datacadastro end'
      '                else :periodo end as periodo'
      #9#9#9#9#9#9#9'  '
      '         FROM'
      '         ('
      '           select selecionados1.*,'
      
        '                  estoques.precoCOMicms, estoques.precoSEMicms, ' +
        'estoques.aliquotaIPI,'
      '                  estoques.qtdecompra,'
      '                  estoques.datacompra,'
      
        '                  cast(case when (quantidadetotaldoestoque(estoq' +
        'ues.produto,estoques.filial)) = 0 then 0'
      '                       else ROUND( estoques.financeiro /'
      
        '                                  (quantidadetotaldoestoque(esto' +
        'ques.produto,estoques.filial)),2)'
      '                       end as numeric(11,2)) AS customedio'
      '          FROM'
      '          ('
      '             select estoquesprodutos.linha,'
      '              estoquesprodutos.coluna,'
      '              estoquesprodutos.codigogrupo,'
      '                    estoquesprodutos.grupo,'
      '              estoquesprodutos.codigomarca,'
      '                    estoquesprodutos.marca,'
      ''
      '              estoquesprodutos.codigoclasse,'
      '                    estoquesprodutos.classe,'
      '                    '
      '              estoquesprodutos.promocao,'
      '                    estoquesprodutos.descricaopromocao,'
      ''
      '              estoquesprodutos.produto,'
      '              estoquesprodutos.produtovisual,'
      '                    estoquesprodutos.nomeproduto,'
      '              estoquesprodutos.valorgrade1,'
      '              estoquesprodutos.valorgrade2,'
      '              estoquesprodutos.csosn,'
      '              estoquesprodutos.incidencia,'
      '              '
      '              estoquesprodutos.composto,'
      ''
      '                    estoquesprodutos.caracteristica,'
      '                    estoquesprodutos.caracteristicavisual,'
      ''
      '                    estoquesprodutos.referencia,'
      '              estoquesprodutos.resultadocurvaabc,'
      
        '              estoquesprodutos.lembrarpedido, estoquesprodutos.o' +
        'bslembrarpedido,'
      ''
      #9#9#9'  estoquesprodutos.datacadastro,'
      '                    estoquesprodutos.preco,'
      '                   coalesce((select e.filial'
      '                    from estoques e'
      
        '                    where e.produto = estoquesprodutos.produto a' +
        'nd'
      
        '                              e.datacompra = max(estoquesproduto' +
        's.datacompra)'
      '                    limit 1), :filialbase) as filial,'
      
        '                    SUM ( estoquesprodutos.estoque ) AS total_es' +
        'toque,'
      
        '                    SUM ( estoquesprodutos.emEstoque ) AS emEsto' +
        'que,'
      ''
      
        '                    SUM ( estoquesprodutos.transito ) AS total_t' +
        'ransito,'
      
        '                    SUM ( estoquesprodutos.pedido  + estoquespro' +
        'dutos.pedidos_filiais) AS total_pedido,'
      
        '                    SUM ( estoquesprodutos.pedido) as total_pedi' +
        'dos_fornecedores,'
      
        '                    SUM ( estoquesprodutos.pedidos_filiais) as t' +
        'otal_pedidos_filiais,'
      
        '                    SUM ( estoquesprodutos.vendido ) AS total_ve' +
        'ndido,'
      
        '                    CAST (SUM (estoquesprodutos.reservado) as fl' +
        'oat) as reservado,'
      
        '                    CAST (SUM (estoquesprodutos.reservaprevia) a' +
        's float) as reservaprevia,'
      
        '                    CAST (SUM (estoquesprodutos.futuro) as float' +
        ') as futuro,'
      '                    cast(SUM(minimo) as float) as minimo,'
      
        '                    cast(case when SUM(minimo - saldo)<0 then 0 ' +
        'else SUM(minimo-saldo) end as float) as sugestaominimo,'
      '                    cast (SUM (maximo) as float) as maximo,'
      
        '                    cast(case when SUM(maximo - saldo)<0 then 0 ' +
        'else SUM(maximo-saldo) end as float) as sugestaomaximo'
      '            from'
      '           ('
      ''
      '            select produtos.*,'
      '                   e.datacompra,'
      '                   %quantidadeemestoque  as estoque,'
      '                   e.emestoque,'
      '                   case when not :PedidosEntreFiliais then 0'
      '                   else'
      
        '                     coalesce((select sum(case when pf.situacao ' +
        '= '#39'A'#39' then pf.qtdepedida'
      
        '                                      when pf.situacao = '#39'F'#39' the' +
        'n 0 end)'
      '                      from pedidosfiliais pf'
      '                      where pf.produto = e.produto'
      '                       and pf.requisitante = e.filial'
      
        '                       and pf.situacao in ('#39'A'#39','#39'F'#39')),0) /*+ e.tr' +
        'ansito*/'
      '                   end as pedidos_filiais,'
      
        '                   /*considera como ainda em pedido os produtos ' +
        'que estao em nota parcial e vinculados a pedido*/'
      
        '                   case when :NaoConsiderarPedidosCompra then 0 ' +
        'else  coalesce(pedidos_estoquepedido ( e.produto, e.filial ),0) ' +
        '+ produtospedidos_recebido_semnotaparcial(e.produto,e.filial) en' +
        'd  AS pedido,'
      ''
      
        '                   case when coalesce(:conceitos,'#39#39')='#39#39' then mov' +
        'imentos_vendido(:inicio,:fim, e.produto, e.filial)'
      
        '                      else movimentos_vendido_porconceito(:inici' +
        'o,:fim, e.produto, e.filial,:conceitos) end'
      '                      as vendido,'
      '                   e.reservado,'
      '                   e.reservaprevia,'
      '                   e.futuro,'
      '                   e.transito,'
      '        coalesce(e.minimo,0) as minimo,'
      '          coalesce(e.maximo,0) as maximo,'
      '        %quantidadeemestoque'
      
        '        +case when :NaoConsiderarPedidosCompra then 0 else pedid' +
        'os_estoquepedido(e.produto,e.filial) end -e.futuro as saldo'
      '            from'
      '            ('
      '             select gr1.descricao as linha,'
      '                    gr2.descricao as coluna,'
      '                    c.grupo as codigogrupo,'
      '                    g.descricao as grupo,'
      '                    c.marca as codigomarca,'
      '                    m.descricao as marca,'
      '                    c.classe as codigoclasse,'
      '                    cl.descricao as classe,'
      '                    p.promocao,'
      '                    pro.descricao as descricaopromocao,'
      '                    p.codigo as produto,'
      '                    p.codigovisual as produtovisual,'
      '                    p.descricao as nomeproduto,'
      '                    p.valorgrade1,'
      '                    p.valorgrade2,'
      '                    c.composto,'
      '                    p.caracteristica,'
      '                    c.codigovisual as caracteristicavisual,'
      ''
      
        '                   (select ti.valor from tributosicms ti where t' +
        'i.codigo = c.incidencia) as incidencia,'
      '                    c.csosn,'
      ''
      '                    p.referencia,'
      '                    p.preco,'
      '                    p.resultadocurvaabc,'
      '                    p.lembrarpedido, p.obslembrarpedido,'
      #9#9#9#9#9'p.datacadastro'
      ''
      '         from ((((((caracteristicas c'
      '                    join marcas m'
      '                    on c.marca = m.codigo)'
      ''
      '                   join grupos g'
      '                   on c.grupo = g.codigo)'
      ''
      '                  join classes cl'
      '                  on c.classe = cl.codigo)'
      ''
      '                 join (produtos p'
      '                      left join promocoes pro'
      '                      on p.promocao = pro.codigo)'
      '                 on p.caracteristica = c.codigo)'
      ''
      '                left join grades gr1'
      '                on gr1.codigo = c.grade1)'
      '               left join grades gr2'
      '               on gr2.codigo = c.grade2)'
      ''
      '         where p.caracteristica = c.codigo'
      '           and c.marca = m.codigo'
      '           and c.grupo = g.codigo'
      '           and c.classe = cl.codigo'
      ''
      '             %produtos'
      '             %FiliaisEstoque'
      '             %resultadocurvaabc'
      ''
      '            ) as produtos'
      '                          /*left*/ join'
      
        '                         estoques e on e.produto = produtos.prod' +
        'uto'
      ''
      '            where e.produto = produtos.produto'
      ''
      '            %Filiais'
      '            %estoques'
      ''
      
        '             ORDER BY UPPER(TO_ASCII(nomeproduto,'#39'latin1'#39')), pro' +
        'dutovisual, valorgrade1, valorgrade2, composto, linha, coluna, U' +
        'PPER(TO_ASCII(referencia,'#39'latin1'#39')), caracteristica, caracterist' +
        'icavisual, preco, codigogrupo, grupo, codigomarca, marca, codigo' +
        'classe, classe, filial'
      '           ) as estoquesprodutos'
      
        '            GROUP BY nomeproduto, produtovisual, produto, valorg' +
        'rade1, valorgrade2, csosn, incidencia, composto, linha, coluna, ' +
        'referencia, caracteristica, caracteristicavisual, preco, codigog' +
        'rupo, grupo, codigomarca, marca, codigoclasse, classe, promocao,' +
        ' descricaopromocao, resultadocurvaabc, lembrarpedido, obslembrar' +
        'pedido, datacadastro'
      
        '          ) AS selecionados1 left join estoques on selecionados1' +
        '.produto = estoques.produto and'
      
        '                                                   selecionados1' +
        '.filial = estoques.filial'
      '        ) as selecionados2, filiais, colunasprecos'
      '          where selecionados2.filial = filiais.codigo and'
      
        '                    colunasprecos.caracteristica = selecionados2' +
        '.caracteristica and'
      
        '                    colunasprecos.preco =   selecionados2.preco ' +
        'and'
      '                    colunasprecos.coluna = filiais.preconormal'
      '       ) AS selecionados3'
      '      ) as selecionados4'
      '      ) as selecionados5'
      ''
      '      %sugestao2'
      ''
      ''
      '    ) as selecionados6'
      '  ) as selecionados7'
      ') as selecionados8'
      ''
      '  left join notaspag np'
      '   on( np.codigo = (select max(pn.codigonota)'
      '                   from produtosnotaspag pn,notaspag np1'
      '                   where pn.produto = selecionados8.produto'
      '                   and np1.codigo=pn.codigonota'
      '                   and np1.tipofornecedor<>'#39'L'#39
      
        '                   and ehnotafiscalentradacompra(pn.codigofiscal' +
        '))'
      '      )'
      
        '   left join vfornecedores vf on (np.fornecedor = vf.codigo and ' +
        'np.tipofornecedor = vf.tipo)'
      ''
      '   %sugestao8'
      ''
      '   %ORDERBY')
    RequestLive = True
    Left = 787
    Top = 70
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'filialbase'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'diasproporcional'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NaoConsiderarPedidosCompraparaDiasEstoque'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'diasestoque'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'inicio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'fim'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'periodo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'PedidosEntreFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NaoConsiderarPedidosCompra'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'conceitos'
        ParamType = ptUnknown
      end>
  end
  object qryComprasTotal_SemTabelaReducao: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AutoCalcFields = False
    AfterInsert = qryComprasTotalAfterInsert
    AfterScroll = qryComprasTotalAfterScroll
    OnCalcFields = qryComprasTotalCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'quantidadeemestoque'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'produtos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiliaisEstoque'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'resultadocurvaabc'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Filiais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'estoques'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'sugestao8'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'sugestao2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ORDERBY'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '/* qryComprasTotal_SemTabelaReducao */'
      ';'
      '    select selecionados6.*,'
      '             np.fornecedor,'
      '             np.tipofornecedor,'
      '             coalesce(vf.nome, vf.razao) as nomefornecedor,'
      '             False as Selecionado,'
      ''
      '             cast('
      '             case when coalesce(total_vendido,0)<>0 then'
      '               (emestoque / (Total_vendido / periodo ))'
      '             else'
      '               cast(999999.99 as numeric(11,2))'
      '             end as numeric(12,2)) as diasestoque,'
      ''
      '             cast('
      '             case when coalesce(total_vendido,0)<>0 then'
      
        '               ((total_estoque + case when /*:NaoConsiderarPedid' +
        'osCompraparaDiasEstoque*/ false then 0 else  total_pedido end)/'
      '                (Total_vendido / periodo ))'
      '             else'
      '               cast(999999.99 as numeric(11,2))'
      
        '             end as numeric(12,2)) as diasestoquecompedidosdecom' +
        'pra,'
      ''
      ''
      '       ('
      '      select count(*) from'
      '         ( '
      '      '
      '           ('
      '             '
      '             select ps.codigo as ps_codigo'
      '                    '
      '                    '
      '             from (produtos ps '
      '                   join caracteristicas cs '
      '                   on ps.caracteristica = cs.codigo),'
      '             '
      '             ('
      '             '
      '               select distinct'
      '                     psel.codigo as psel_codigo,'
      '                     psel.caracteristica as psel_caracteristica,'
      
        '                     psel.agrupamentosimilares as psel_agrupamen' +
        'tosimilares,'
      '                     psel.grade1 as psel_grade1,'
      '                     psel.grade2 as psel_grade2,'
      '                     psel.valorgrade1 as psel_valorgrade1,'
      '                     psel.valorgrade2 as psel_valorgrade2,'
      '                     psel.composto as psel_composto,'
      '                     s."similar"'
      '                   '
      '               from similares s right outer join'
      '                '
      '                     ('
      '                     select p.codigo, '
      '                            p.caracteristica, '
      '                            c.agrupamentosimilares,'
      '                            c.grade1,'
      '                            c.grade2,'
      '                            p.valorgrade1,'
      '                            p.valorgrade2,'
      '                            c.composto'
      ''
      '                     from produtos p'
      '                          join caracteristicas c'
      '                           on p.caracteristica = c.codigo'
      '                     where p.codigo = selecionados6.produto'
      '                     ) as psel'
      '                     '
      '               on s.caracteristica = psel.caracteristica        '
      '             ) as psel_similar'
      ''
      '            where (ps.caracteristica = psel_similar.similar or '
      
        '                   ps.caracteristica  = psel_similar.psel_caract' +
        'eristica)'
      '                  '
      '              and ps.codigo <> psel_similar.psel_codigo'
      '              '
      '              and ((ps.inativo IS NULL) OR '
      '                   (ps.inativo>CURRENT_DATE))'
      '                   '
      
        '              and case when coalesce(psel_agrupamentosimilares, ' +
        #39#39') = '#39'L'#39
      '                           AND psel_grade1 IS NOT NULL'
      
        '                           AND psel_valorgrade1 IS NOT NULL  the' +
        'n '
      '                           '
      '                              ps.valorgrade1 = psel_valorgrade1'
      '                              and cs.grade1 = psel_grade1'
      '                           '
      '                           '
      
        '                       when coalesce(psel_agrupamentosimilares, ' +
        #39#39') = '#39'C'#39
      '                           AND psel_grade2 IS NOT NULL'
      
        '                           AND psel_valorgrade2 IS NOT NULL  the' +
        'n  '
      '                           '
      '                             ps.valorgrade2 = psel_valorgrade2'
      '                             and cs.grade2 = psel_grade2'
      '                           '
      '                  else true end  '
      '                             '
      '             limit 1'
      '             '
      '             )'
      ''
      '              union all'
      '              '
      '             ('
      '               SELECT ps."similar" as ps_codigo'
      '               FROM produtos_similares ps'
      '               WHERE ps.produto = selecionados6.produto limit 1'
      '             '
      '              )'
      '              '
      '            ) as ps'
      '            '
      '           ) <> 0  AS ExisteSimilar,'
      ''
      
        #9#9#9'(select estoques_produtoempromocao(selecionados6.produto, :fi' +
        'lialbase)) as produtoempromocao'
      ''
      '     from'
      '     ('
      ''
      '      select selecionados5.*'
      ''
      '      from'
      '      ('
      '      SELECT *,'
      
        '              /*SE TEM SUGESTAO DE COMPRA, DE ACORDO COM DIASEST' +
        'OQUE, ENTAO RECALCULA A SUGESTAO DE ACORDO COM DIAS PROPORCIONAL' +
        '*/'
      
        '             case when sugestao1 <= 0 then 0 else (cast(ROUND( (' +
        ' cast((total_vendido) as float) / periodo) * :diasproporcional )' +
        ' as float) - total_estoque - total_pedido + futuro) end as suges' +
        'tao'
      '      from'
      '      ('
      
        '      SELECT *, (cast(ROUND( ( cast((total_vendido) as float) / ' +
        'periodo) * :diasestoque ) as float) - total_estoque - total_pedi' +
        'do+futuro) AS sugestao1'
      '      FROM'
      '        ('
      '         SELECT selecionados2.*,'
      '                      colunasprecos.valor AS precovenda,'
      
        '                      cast(case when selecionados2.customedio  =' +
        ' 0 then 0'
      
        '                                       else ROUND( (colunaspreco' +
        's.valor / selecionados2.customedio - 1) * 100,2)'
      '                              end as numeric(15,2)) AS markup,'
      #9#9#9#9#9#9#9
      
        #9#9'case when selecionados2.datacadastro between :inicio and :fim ' +
        'then'
      #9#9#9#9#9#9#9'case when :fim = selecionados2.datacadastro then 1'
      #9#9#9#9#9#9#9'else :fim - selecionados2.datacadastro end'
      '                else :periodo end as periodo'
      ''
      '         FROM'
      '         ('
      '           select selecionados1.*,'
      
        '                  estoques.precoCOMicms, estoques.precoSEMicms, ' +
        'estoques.aliquotaIPI,'
      '                  estoques.qtdecompra,'
      '                  estoques.datacompra,'
      ''
      
        '                     cast(case when (Estoques.EmEstoque + Estoqu' +
        'es.Reservado    +'
      '                 Estoques.Transito  + Estoques.Demonstracao +'
      
        '                 Estoques.Conserto  + Estoques.Danificada   + Es' +
        'toques.ReservaPrevia) = 0 then 0'
      '                     else ROUND( estoques.financeiro /'
      
        '                     (Estoques.EmEstoque + Estoques.Reservado   ' +
        ' +'
      '                 Estoques.Transito  + Estoques.Demonstracao +'
      
        '                 Estoques.Conserto  + Estoques.Danificada   + Es' +
        'toques.ReservaPrevia),2)'
      '                     end as numeric(11,2)) AS customedio'
      ''
      '          FROM'
      '          ('
      '             select estoquesprodutos.linha,'
      '              estoquesprodutos.coluna,'
      '              estoquesprodutos.codigogrupo,'
      '                    estoquesprodutos.grupo,'
      ''
      '              estoquesprodutos.codigomarca,'
      '                    estoquesprodutos.marca,'
      ''
      '              estoquesprodutos.codigoclasse,'
      '                    estoquesprodutos.classe,'
      '                    '
      '              estoquesprodutos.promocao,'
      '                    estoquesprodutos.descricaopromocao,'
      '                    '
      '              estoquesprodutos.produto,'
      '              estoquesprodutos.produtovisual,'
      '                    estoquesprodutos.nomeproduto,'
      '              estoquesprodutos.valorgrade1,'
      '              estoquesprodutos.valorgrade2,'
      '              estoquesprodutos.csosn,'
      '              estoquesprodutos.incidencia,'
      '              '
      '              estoquesprodutos.composto,'
      ''
      '                    estoquesprodutos.caracteristica,'
      '                    estoquesprodutos.caracteristicavisual,'
      ''
      '                    estoquesprodutos.referencia,'
      '              estoquesprodutos.resultadocurvaabc,'
      
        '              estoquesprodutos.lembrarpedido, estoquesprodutos.o' +
        'bslembrarpedido,'
      ''
      #9#9#9'  estoquesprodutos.datacadastro,'
      '              '
      '              '
      '                    estoquesprodutos.preco,'
      '                   coalesce((select e.filial'
      '                    from estoques e'
      
        '                    where e.produto = estoquesprodutos.produto a' +
        'nd'
      
        '                              e.datacompra = max(estoquesproduto' +
        's.datacompra)'
      '                    limit 1), :filialbase) as filial,'
      ''
      
        '                    SUM ( estoquesprodutos.estoque ) AS total_es' +
        'toque,'
      ''
      
        '                    SUM ( estoquesprodutos.emestoque ) AS emesto' +
        'que,'
      ''
      
        '                    SUM ( estoquesprodutos.transito ) AS total_t' +
        'ransito,'
      ''
      
        '                    SUM ( estoquesprodutos.pedido  + estoquespro' +
        'dutos.pedidos_filiais) AS total_pedido,'
      ''
      
        '                    SUM ( estoquesprodutos.pedido) AS total_pedi' +
        'dos_fornecedores,'
      ''
      
        '                    SUM ( estoquesprodutos.pedidos_filiais) as t' +
        'otal_pedidos_filiais,'
      '                    '
      
        '                    SUM ( estoquesprodutos.vendido ) AS total_ve' +
        'ndido,'
      '                    '
      
        '                    CAST (SUM (estoquesprodutos.reservado) as fl' +
        'oat) as reservado,'
      
        '                    CAST (SUM (estoquesprodutos.reservaprevia) a' +
        's float) as reservaprevia,'
      ''
      '                    '
      
        '                    CAST (SUM (estoquesprodutos.futuro) as float' +
        ') as futuro,'
      '                    '
      '                    cast(SUM(minimo) as float) as minimo,'
      '                    '
      
        '                    cast(case when SUM(minimo - saldo)<0 then 0 ' +
        'else SUM(minimo-saldo) end as float) as sugestaominimo,'
      '                    '
      '                    cast (SUM (maximo) as float) as maximo,'
      '                    '
      
        '                    cast(case when SUM(maximo - saldo)<0 then 0 ' +
        'else SUM(maximo-saldo) end as float) as sugestaomaximo'
      '            from'
      '           ('
      ''
      ''
      '              select e.*,'
      
        '                   case when :NaoConsiderarPedidosCompra then 0 ' +
        'else  coalesce(pedidos_estoquepedido,0) + produtospedidos_recebi' +
        'do_semnotaparcial end AS pedido,'
      
        '                       e.estoque + pedidos_estoquepedido - e.fut' +
        'uro as saldo'
      '              from'
      '              ('
      '              select e.*,'
      
        '                    case when :NaoConsiderarPedidosCompra then 0' +
        ' else produtospedidos_recebido_semnotaparcial(e.produto,e.filial' +
        ') end as produtospedidos_recebido_semnotaparcial'
      ''
      '              FROM'
      '              ('#9
      '              select e.*,'
      
        '                     case when :NaoConsiderarPedidosCompra then ' +
        '0 else pedidos_estoquepedido(e.produto,e.filial) end as pedidos_' +
        'estoquepedido'
      ''
      '              from'
      '              ('
      '              select e.*,'
      
        '                      case when coalesce(:conceitos,'#39#39')='#39#39' then ' +
        'movimentos_vendido(:inicio,:fim, e.produto, e.filial)'
      
        '                      else movimentos_vendido_porconceito(:inici' +
        'o,:fim, e.produto, e.filial,:conceitos) end'
      '                      as vendido'
      ''
      '              from'
      ''
      '              ('#9
      ''
      '              select e.*,'
      '                       case when not :PedidosEntreFiliais then 0'
      '                       else'#9
      '                       coalesce((select sum(pf.qtdepedida)'
      '                       from pedidosfiliais pf'
      '                       where pf.produto = e.produto'
      '                       and pf.requisitante = e.filial'
      
        '                       and pf.situacao = '#39'A'#39'),0) /*+ e.transito*' +
        '/'
      '                       end as pedidos_filiais'
      ''
      ''
      '              from'
      '              ('
      '              select produtos. *,'
      '                   e.filial,'
      '                       e.datacompra,'
      '                       %quantidadeemestoque  as estoque,'
      '                       e.emestoque as emestoque,'
      '                       e.futuro,'
      '                       e.transito,'
      '                       e.reservado,'
      '                       e.reservaprevia,'
      '                       coalesce(e.minimo,0) as minimo,'
      '                       coalesce(e.maximo,0) as maximo'
      #9' '
      #9' '
      '              from estoques e join'
      '              ('
      
        '                                       select gr1.descricao as l' +
        'inha,'
      
        '                                               gr2.descricao as ' +
        'coluna,'
      
        '                                               c.grupo as codigo' +
        'grupo,'
      
        '                                               g.descricao as gr' +
        'upo,'
      ''
      
        '                                               c.marca as codigo' +
        'marca,'
      
        '                                               m.descricao as ma' +
        'rca,'
      ''
      
        '                                               c.classe as codig' +
        'oclasse,'
      
        '                                               cl.descricao as c' +
        'lasse,'
      '                                               '
      '                                               p.promocao,'
      
        '                                               pro.descricao as ' +
        'descricaopromocao,                    '
      '                                              '
      
        '                                               p.codigo as produ' +
        'to,'
      
        '                                               p.codigovisual as' +
        ' produtovisual,'
      
        '                                               p.descricao as no' +
        'meproduto,'
      '                                               p.valorgrade1,'
      '                                               p.valorgrade2,'
      '                                               c.composto,'
      '                                               p.caracteristica,'
      
        '                                               c.codigovisual as' +
        ' caracteristicavisual,'
      ''
      
        '/*                                               case when p.ref' +
        'erencia is null then cast('#39#39' as varchar(15)) else cast(p.referen' +
        'cia as varchar(15)) end as referencia,*/'
      '                                               p.referencia,'
      '                                               p.preco,'
      
        '                                               p.resultadocurvaa' +
        'bc,'
      
        '                                               p.lembrarpedido, ' +
        'p.obslembrarpedido,'
      '                                               p.datacadastro,'
      
        '                                              (select ti.valor f' +
        'rom tributosicms ti where ti.codigo = c.incidencia) as incidenci' +
        'a,'
      '                                               c.csosn'
      ''
      ''
      ''
      
        '                                       from ((((((caracteristica' +
        's c'
      '                                                  join marcas m'
      
        '                                                  on c.marca = m' +
        '.codigo)'
      ''
      '                                                 join grupos g'
      
        '                                                 on c.grupo = g.' +
        'codigo)'
      ''
      '                                                join classes cl'
      
        '                                                on c.classe = cl' +
        '.codigo)'
      ''
      '                                               join (produtos p'
      
        '                                                    left join pr' +
        'omocoes pro'
      
        '                                                    on p.promoca' +
        'o = pro.codigo)'
      
        '                                               on p.caracteristi' +
        'ca = c.codigo)'
      ''
      
        '                                              left join grades g' +
        'r1'
      
        '                                              on gr1.codigo = c.' +
        'grade1)'
      
        '                                             left join grades gr' +
        '2'
      
        '                                             on gr2.codigo = c.g' +
        'rade2)'
      ''
      
        '                                       where p.caracteristica = ' +
        'c.codigo'
      '                                         and c.marca = m.codigo'
      '                                         and c.grupo = g.codigo'
      
        '                                         and c.classe = cl.codig' +
        'o'
      ''
      #9#9#9#9' '
      '                           %produtos'
      '                           %FiliaisEstoque'
      '                           %resultadocurvaabc'
      ''
      '                                      order by p.codigo'
      ''
      '              ) as produtos on e.produto = produtos.produto'
      '              where true'
      ''
      '                          %Filiais'
      '                          %estoques'
      ''
      '              ) as e'
      '              ) as e'
      '              ) as e'
      '              ) as e'
      '              ) as e'
      ''
      ''
      ''
      ''
      '           ) as estoquesprodutos'
      ''
      
        '            GROUP BY nomeproduto, produtovisual, produto, valorg' +
        'rade1, valorgrade2, composto, linha, coluna, referencia, caracte' +
        'ristica, caracteristicavisual, preco, codigogrupo, grupo, codigo' +
        'marca, marca, codigoclasse, classe, promocao, descricaopromocao,' +
        ' resultadocurvaabc, lembrarpedido, obslembrarpedido, datacadastr' +
        'o, csosn, incidencia'
      
        '          ) AS selecionados1 left join estoques on selecionados1' +
        '.produto = estoques.produto and'
      
        '                                                   selecionados1' +
        '.filial = estoques.filial'
      '        ) as selecionados2, filiais, colunasprecos'
      '          where selecionados2.filial = filiais.codigo and'
      
        '                    colunasprecos.caracteristica = selecionados2' +
        '.caracteristica and'
      
        '                    colunasprecos.preco =   selecionados2.preco ' +
        'and'
      '                    colunasprecos.coluna = filiais.preconormal'
      '       ) AS selecionados3'
      '      ) as selecionados4'
      '      ) as selecionados5'
      '     '
      '   %sugestao8'
      '   '
      '   ) as selecionados6'
      '   '
      '  left join notaspag np'
      '   on( np.codigo = (select max(pn.codigonota)'
      '                   from produtosnotaspag pn,notaspag np1'
      '                   where pn.produto = selecionados6.produto'
      '                   and np1.codigo=pn.codigonota'
      '                   and np1.tipofornecedor<>'#39'L'#39
      
        '                   and ehnotafiscalentradacompra(pn.codigofiscal' +
        '))'
      '      )'
      
        '   left join vfornecedores vf on (np.fornecedor = vf.codigo and ' +
        'np.tipofornecedor = vf.tipo)'
      ''
      '   /* %sugestao2 */'
      ''
      '   %ORDERBY')
    RequestLive = True
    Left = 779
    Top = 166
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'NaoConsiderarPedidosCompraparaDiasEstoque'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filialbase'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'diasproporcional'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'diasestoque'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'inicio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'fim'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'periodo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NaoConsiderarPedidosCompra'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'conceitos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'PedidosEntreFiliais'
        ParamType = ptUnknown
      end>
  end
  object qryComprasTotal_ComTabelaReducao_FiliaisEspecificas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AutoCalcFields = False
    AfterInsert = qryComprasTotalAfterInsert
    AfterScroll = qryComprasTotalAfterScroll
    OnCalcFields = qryComprasTotalCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'quantidadeemestoque'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'produtos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiliaisEstoque'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'resultadocurvaabc'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Filiais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'estoques'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'sugestao2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'sugestao8'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ORDERBY'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '/* qryComprasTotal_ComTabelaReducao_FiliaisEspecificas */ '
      ';'
      'select selecionados9.*,'
      '       np.fornecedor,'
      '       np.tipofornecedor,'
      '       coalesce(vf.nome, vf.razao) as nomefornecedor,'#9'   '
      
        #9'     (select estoques_produtoempromocao(selecionados9.produto, ' +
        ':filialbase)) as produtoempromocao,'#9'   '
      '       False as Selecionado'
      'from'
      '('
      ''
      'select selecionados8.*,'
      ''
      '       ('
      '      select count(*) from'
      '         ( '
      '      '
      '           ('
      '             '
      '             select ps.codigo as ps_codigo'
      '                    '
      '                    '
      '             from (produtos ps '
      '                   join caracteristicas cs '
      '                   on ps.caracteristica = cs.codigo),'
      '             '
      '             ('
      '             '
      '               select distinct'
      '                     psel.codigo as psel_codigo,'
      '                     psel.caracteristica as psel_caracteristica,'
      
        '                     psel.agrupamentosimilares as psel_agrupamen' +
        'tosimilares,'
      '                     psel.grade1 as psel_grade1,'
      '                     psel.grade2 as psel_grade2,'
      '                     psel.valorgrade1 as psel_valorgrade1,'
      '                     psel.valorgrade2 as psel_valorgrade2,'
      '                     psel.composto as psel_composto,'
      '                     s."similar"'
      '                   '
      '               from similares s right outer join'
      '                '
      '                     ('
      '                     select p.codigo, '
      '                            p.caracteristica, '
      '                            c.agrupamentosimilares,'
      '                            c.grade1,'
      '                            c.grade2,'
      '                            p.valorgrade1,'
      '                            p.valorgrade2,'
      '                            c.composto'
      ''
      '                     from produtos p'
      '                          join caracteristicas c'
      '                           on p.caracteristica = c.codigo'
      '                     where p.codigo = selecionados8.produto'
      '                     ) as psel'
      '                     '
      '               on s.caracteristica = psel.caracteristica        '
      '             ) as psel_similar'
      '              '
      '            where (ps.caracteristica = psel_similar.similar or '
      
        '                   ps.caracteristica  = psel_similar.psel_caract' +
        'eristica)'
      '                  '
      '              and ps.codigo <> psel_similar.psel_codigo'
      '              '
      '              and ((ps.inativo IS NULL) OR '
      '                   (ps.inativo>CURRENT_DATE))'
      '                   '
      
        '              and case when coalesce(psel_agrupamentosimilares, ' +
        #39#39') = '#39'L'#39
      '                           AND psel_grade1 IS NOT NULL'
      
        '                           AND psel_valorgrade1 IS NOT NULL  the' +
        'n '
      '                           '
      '                              ps.valorgrade1 = psel_valorgrade1'
      '                              and cs.grade1 = psel_grade1'
      '                           '
      '                           '
      
        '                       when coalesce(psel_agrupamentosimilares, ' +
        #39#39') = '#39'C'#39
      '                           AND psel_grade2 IS NOT NULL'
      
        '                           AND psel_valorgrade2 IS NOT NULL  the' +
        'n  '
      '                           '
      '                             ps.valorgrade2 = psel_valorgrade2'
      '                             and cs.grade2 = psel_grade2'
      '                           '
      '                  else true end  '
      '                             '
      '             limit 1'
      '             '
      '             )'
      ''
      '              union all'
      '              '
      '             ('
      '               SELECT ps."similar" as ps_codigo'
      '               FROM produtos_similares ps'
      '               WHERE ps.produto = selecionados8.produto limit 1'
      '             '
      '              )'
      '              '
      '            ) as ps'
      '            '
      '           ) <> 0  AS ExisteSimilar'
      ''
      'from'
      '('
      '  select'
      
        '        (cast(ROUND( ( cast((total_vendido) as float) / periodo)' +
        ' * sugestaopara ) as float) - total_estoque - total_pedido + fut' +
        'uro) as sugestao,'
      '       selecionados7.*'
      ''
      '  from'
      '  ('
      ''
      '    select selecionados6.*,'
      '           /*'
      
        '           case when selecionados6.diasestoque_geral > :diasprop' +
        'orcional then'
      '               :diasproporcional'
      '             else'
      '             */'
      '         coalesce((select rcc.sugestaopara'
      '                       from reducaoconsultacompras rcc'
      
        '                       where rcc.estoquepara <= selecionados6.di' +
        'asestoque_geral'
      
        '                       order by rcc.estoquepara desc limit 1),:d' +
        'iasproporcional)'
      '             /* end */ as sugestaopara'
      '    from'
      '    ('
      ''
      '      select selecionados5.*,'
      ''
      ''
      '             cast('
      '             case when coalesce(total_vendido,0)<>0 then'
      '               (emestoque / (Total_vendido / periodo ))'
      '             else'
      '               cast(999999.99 as numeric(11,2))'
      '             end as numeric(12,2)) as diasestoque,'
      ''
      '             cast('
      '             case when coalesce(total_vendido,0)<>0 then'
      
        '               ((total_estoque + case when /*:NaoConsiderarPedid' +
        'osCompraparaDiasEstoque*/ false then 0 else  total_pedido end)/'
      '                (Total_vendido / periodo ))'
      '             else'
      '               cast(999999.99 as numeric(11,2))'
      
        '             end as numeric(12,2)) as diasestoquecompedidosdecom' +
        'pra,'
      ''
      ''
      '             cast('
      '             case when coalesce(total_vendido_geral,0)<>0 then'
      '               ((total_estoque_geral + total_pedido_geral)/'
      '                (Total_vendido_geral / Periodo))'
      '             else'
      '               cast(null as numeric(11,2))'
      '             end as numeric(12,2)) as diasestoque_geral'
      #9#9#9' '
      
        #9#9#9'/* pedido_geral + total_pedidos_filiais_geral as total_pedido' +
        '_geral */'
      #9#9#9
      '      from'
      '      ('
      '      SELECT *,'
      
        '              /*SE TEM SUGESTAO DE COMPRA, DE ACORDO COM DIASEST' +
        'OQUE, ENTAO RECALCULA A SUGESTAO DE ACORDO COM DIAS PROPORCIONAL' +
        '*/'
      
        '             case when sugestao1 <= 0 then 0 else (cast(ROUND( (' +
        ' cast((total_vendido) as float) / periodo) * :diasproporcional )' +
        ' as float) - total_estoque - total_pedido + futuro) end as suges' +
        'tao2'
      '      from'
      '      ('
      
        '      SELECT *, (cast(ROUND( ( cast((total_vendido) as float) / ' +
        'periodo) * :diasestoque ) as float) - total_estoque - total_pedi' +
        'do+futuro) AS sugestao1'
      '      FROM'
      '        ('
      '         SELECT selecionados2.*,'
      '                      colunasprecos.valor AS precovenda,'
      
        '                      cast(case when selecionados2.customedio  =' +
        ' 0 then 0'
      
        '                                       else ROUND( (colunaspreco' +
        's.valor / selecionados2.customedio - 1) * 100,2)'
      '                              end as numeric(15,2)) AS markup,'
      ''
      
        #9#9'case when selecionados2.datacadastro between :inicio and :fim ' +
        'then'
      #9#9#9#9#9#9#9'case when :fim = selecionados2.datacadastro then 1'
      #9#9#9#9#9#9#9'else :fim - selecionados2.datacadastro end'
      '                else :periodo end as periodo'
      ''
      '         FROM'
      '         ('
      '           select selecionados1.*,'
      
        '                  estoques.precoCOMicms, estoques.precoSEMicms, ' +
        'estoques.aliquotaIPI,'
      '                  estoques.qtdecompra,'
      '                  estoques.datacompra,'
      
        '                  cast(case when (quantidadetotaldoestoque(estoq' +
        'ues.produto,estoques.filial)) = 0 then 0'
      '                       else ROUND( estoques.financeiro /'
      
        '                                  (quantidadetotaldoestoque(esto' +
        'ques.produto,estoques.filial)),2)'
      '                       end as numeric(11,2)) AS customedio'
      '          FROM'#9#9'   '
      '          ('
      #9#9'   select selecionados1.*,'
      
        #9#9'          sum(case when coalesce(:conceitos,'#39#39')='#39#39' then movime' +
        'ntos_vendido(:inicio,:fim, e.produto, e.filial)'
      
        '                      else movimentos_vendido_porconceito(:inici' +
        'o,:fim, e.produto, e.filial,:conceitos) end'
      '                      ) as total_vendido_geral,'
      #9#9#9#9'      sum(%quantidadeemestoque)  as total_estoque_geral,'
      ''
      
        '              sum(case when :NaoConsiderarPedidosCompra then 0 e' +
        'lse coalesce(pedidos_estoquepedido ( e.produto, e.filial ),0) + ' +
        'produtospedidos_recebido_semnotaparcial(e.produto,e.filial) end)' +
        '  +'
      #9'            sum(case when not :PedidosEntreFiliais then 0'
      
        '                      else coalesce((select sum(case when pf.sit' +
        'uacao = '#39'A'#39' then pf.qtdepedida'
      
        '                                      when pf.situacao = '#39'F'#39' the' +
        'n  0 /*pf.qtderecebida*/ end)'
      '                      from pedidosfiliais pf'
      '                      where pf.produto = e.produto'
      '                       and pf.requisitante = e.filial'
      
        '                       and pf.situacao in ('#39'A'#39','#39'F'#39')),0) /*+ e.tr' +
        'ansito*/'
      '                   end) as total_pedido_geral'
      ''
      '            from'#9#9#9#9'  '
      #9#9'   ('
      '             select estoquesprodutos.linha,'
      '                    estoquesprodutos.coluna,'
      '                    estoquesprodutos.codigogrupo,'
      '                    estoquesprodutos.grupo,'
      '                    estoquesprodutos.codigomarca,'
      '                    estoquesprodutos.marca,'
      ''
      '                    estoquesprodutos.codigoclasse,'
      '                    estoquesprodutos.classe,'
      '                    '
      '              estoquesprodutos.promocao,'
      '                    estoquesprodutos.descricaopromocao,'
      '                  '
      ' '#9#9'    estoquesprodutos.produto,'
      #9#9'    estoquesprodutos.produtovisual,'
      '                    estoquesprodutos.nomeproduto,'
      #9#9'    estoquesprodutos.valorgrade1,'
      #9#9'    estoquesprodutos.valorgrade2,'
      ''
      '              estoquesprodutos.csosn,'
      '              estoquesprodutos.incidencia,'
      ''
      '        estoquesprodutos.composto,'
      ''
      '        estoquesprodutos.caracteristica,'
      '        estoquesprodutos.caracteristicavisual,'
      '                    estoquesprodutos.referencia,'
      #9#9'    estoquesprodutos.resultadocurvaabc,'
      
        '                    estoquesprodutos.lembrarpedido, estoquesprod' +
        'utos.obslembrarpedido,'
      ''
      '                    estoquesprodutos.datacadastro,'
      '                    estoquesprodutos.preco,'
      '                    coalesce((select e.filial'
      '                    from estoques e'
      
        '                    where e.produto = estoquesprodutos.produto a' +
        'nd'
      
        '                              e.datacompra = max(estoquesproduto' +
        's.datacompra)'
      '                    limit 1), :filialbase) as filial,'
      
        '                    SUM ( estoquesprodutos.estoque ) AS total_es' +
        'toque,'
      
        '                    SUM ( estoquesprodutos.emestoque ) AS emEsto' +
        'que,'
      ''
      
        '                    SUM ( estoquesprodutos.transito ) AS total_t' +
        'ransito,'
      
        '                    SUM ( estoquesprodutos.pedido  + estoquespro' +
        'dutos.pedidos_filiais) AS total_pedido,'
      
        '                    SUM ( estoquesprodutos.pedido) AS total_pedi' +
        'dos_fornecedores,'
      
        '                    SUM ( estoquesprodutos.pedidos_filiais) as t' +
        'otal_pedidos_filiais,'
      
        '                    SUM ( estoquesprodutos.vendido ) AS total_ve' +
        'ndido,'
      
        '                    CAST (SUM (estoquesprodutos.reservado) as fl' +
        'oat) as reservado,'
      
        '                    CAST (SUM (estoquesprodutos.reservaprevia) a' +
        's float) as reservaprevia,'
      
        '                    CAST (SUM (estoquesprodutos.futuro) as float' +
        ') as futuro,'
      '                    cast(SUM(minimo) as float) as minimo,'
      
        '                    cast(case when SUM(minimo - saldo)<0 then 0 ' +
        'else SUM(minimo-saldo) end as float) as sugestaominimo,'
      '                    cast (SUM (maximo) as float) as maximo,'
      
        '                    cast(case when SUM(maximo - saldo)<0 then 0 ' +
        'else SUM(maximo-saldo) end as float) as sugestaomaximo'
      '            from'
      '           ('
      ''
      '            select produtos.*,'
      '                   e.datacompra,'
      '                   %quantidadeemestoque  as estoque,'
      '                   e.emestoque,'
      #9#9#9#9'   '
      '                   case when not :PedidosEntreFiliais then 0'
      '                   else'
      
        '                     coalesce((select sum(case when pf.situacao ' +
        '= '#39'A'#39' then pf.qtdepedida'
      
        '                                      when pf.situacao = '#39'F'#39' the' +
        'n pf.qtderecebida end)'
      '                      from pedidosfiliais pf'
      '                      where pf.produto = e.produto'
      '                       and pf.requisitante = e.filial'
      '                       and pf.situacao in ('#39'A'#39','#39'F'#39')),0)'
      '                   end as pedidos_filiais,'
      #9#9#9#9'   '
      
        '                   /*considera como ainda em pedido os produtos ' +
        'que estao em nota parcial e vinculados a pedido*/'
      
        '                   case when :NaoConsiderarPedidosCompra then 0 ' +
        'else  coalesce(pedidos_estoquepedido ( e.produto, e.filial ),0) ' +
        '+ produtospedidos_recebido_semnotaparcial(e.produto,e.filial) en' +
        'd AS pedido,'
      ''
      
        '                   case when coalesce(:conceitos,'#39#39')='#39#39' then mov' +
        'imentos_vendido(:inicio,:fim, e.produto, e.filial)'
      
        '                      else movimentos_vendido_porconceito(:inici' +
        'o,:fim, e.produto, e.filial,:conceitos) end'
      '                      as vendido,'
      '                   e.reservado,'
      '                   e.reservaprevia,'
      '                   e.futuro,'
      '                   e.transito,'
      '        coalesce(e.minimo,0) as minimo,'
      '          coalesce(e.maximo,0) as maximo,'
      '        %quantidadeemestoque'
      
        '        +case when :NaoConsiderarPedidosCompra then 0 else  pedi' +
        'dos_estoquepedido(e.produto,e.filial) end -e.futuro as saldo'
      '            from'
      '            ('
      '             select gr1.descricao as linha,'
      '                    gr2.descricao as coluna,'
      '                    c.grupo as codigogrupo,'
      '                    g.descricao as grupo, '
      '                    c.marca as codigomarca,'
      '                    m.descricao as marca,'
      ''
      '                    c.classe as codigoclasse,'
      '                    cl.descricao as classe,'
      '                    '
      '                    p.promocao,'
      
        '                    pro.descricao as descricaopromocao,         ' +
        '           '
      ''
      '                    p.codigo as produto,'
      '                    p.codigovisual as produtovisual,'
      '                    p.descricao as nomeproduto,'
      '                    p.valorgrade1,'
      '                    p.valorgrade2,'
      '                    c.composto,'
      '                    p.caracteristica,'
      '                    c.codigovisual as caracteristicavisual,'
      '                    p.referencia,'
      '                    p.preco,'
      '                    p.resultadocurvaabc,'
      '                    p.lembrarpedido, p.obslembrarpedido,'
      '                    p.datacadastro,'
      ''
      
        '                   (select ti.valor from tributosicms ti where t' +
        'i.codigo = c.incidencia) as incidencia,'
      '                    c.csosn'
      ''
      ''
      ''
      '           from ((((((caracteristicas c'
      '                      join marcas m'
      '                      on c.marca = m.codigo)'
      ''
      '                     join grupos g'
      '                     on c.grupo = g.codigo)'
      ''
      '                    join classes cl'
      '                    on c.classe = cl.codigo)'
      ''
      '                   join (produtos p'
      '                        left join promocoes pro'
      '                        on p.promocao = pro.codigo)'
      '                   on p.caracteristica = c.codigo)'
      ''
      '                  left join grades gr1'
      '                  on gr1.codigo = c.grade1)'
      '                 left join grades gr2'
      '                 on gr2.codigo = c.grade2)'
      ''
      '           where p.caracteristica = c.codigo'
      '             and c.marca = m.codigo'
      '             and c.grupo = g.codigo'
      '             and c.classe = cl.codigo'
      ''
      ''
      '             %produtos'
      '             %FiliaisEstoque'
      '             %resultadocurvaabc'
      ''
      '            ) as produtos'
      '                          /*left*/ join'
      
        '                         estoques e on e.produto = produtos.prod' +
        'uto'
      ''
      '            where e.produto = produtos.produto'
      ''
      '            %Filiais'
      '            %estoques'
      ''
      
        '             ORDER BY UPPER(TO_ASCII(nomeproduto,'#39'latin1'#39')), pro' +
        'dutovisual, valorgrade1, valorgrade2, composto, linha, coluna, U' +
        'PPER(TO_ASCII(referencia,'#39'latin1'#39')), caracteristica, caracterist' +
        'icavisual, preco, codigogrupo, grupo, codigomarca, marca, codigo' +
        'classe, classe, filial'
      '           ) as estoquesprodutos'
      
        '            GROUP BY nomeproduto, produtovisual, produto, valorg' +
        'rade1, valorgrade2, composto, linha, coluna, referencia, caracte' +
        'ristica, caracteristicavisual, preco, codigogrupo, grupo, codigo' +
        'marca, marca, codigoclasse, classe, promocao, descricaopromocao,' +
        ' resultadocurvaabc, lembrarpedido, obslembrarpedido, datacadastr' +
        'o, csosn, incidencia'
      ''
      
        #9#9'   ) as selecionados1 join estoques e on selecionados1.produto' +
        ' = e.produto'
      #9#9'   where e.produto = selecionados1.produto'
      #9#9'   '
      #9#9'   %estoques'
      #9#9'   '
      #9#9'   group by selecionados1.linha,'
      '                    selecionados1.coluna,'
      '                    selecionados1.codigogrupo,'
      '                    selecionados1.grupo,'
      ''
      '                    selecionados1.codigomarca,'
      '                    selecionados1.marca,'
      ''
      '                    selecionados1.codigoclasse,'
      '                    selecionados1.classe,'
      '                    '
      '                    selecionados1.promocao,'
      
        '                    selecionados1.descricaopromocao,            ' +
        '        '
      ''
      #9#9#9#9#9'selecionados1.produto,'
      #9#9#9#9#9'selecionados1.produtovisual,'
      '                    selecionados1.nomeproduto,'
      #9#9#9#9#9'selecionados1.valorgrade1,'
      #9#9#9#9#9'selecionados1.valorgrade2,'
      '          selecionados1.composto,'
      ''
      '                    selecionados1.caracteristica,'
      '                    selecionados1.caracteristicavisual,'
      ''
      '                    selecionados1.referencia,'
      #9#9#9#9#9'selecionados1.resultadocurvaabc,'
      
        '                                        selecionados1.lembrarped' +
        'ido, selecionados1.obslembrarpedido,'
      ''
      '                    selecionados1.datacadastro, '#9#9#9#9#9
      '                    selecionados1.preco,'
      #9#9#9#9#9'selecionados1.filial,'
      #9#9#9#9#9'selecionados1.total_estoque,'
      '                                        selecionados1.emEstoque,'
      ''
      #9#9#9#9#9'selecionados1.total_pedido,'
      
        '                                        selecionados1.total_pedi' +
        'dos_fornecedores,'
      #9#9#9#9#9'selecionados1.total_pedidos_filiais,'
      #9#9#9#9#9'selecionados1.total_vendido,'
      
        '                                        selecionados1.total_tran' +
        'sito,'
      #9#9#9#9#9'selecionados1.reservado,'
      
        '                                        selecionados1.reservapre' +
        'via,'
      #9#9#9#9#9'selecionados1.futuro,'
      #9#9#9#9#9'selecionados1.minimo,'
      #9#9#9#9#9'selecionados1.sugestaominimo,'
      #9#9#9#9#9'selecionados1.maximo,'
      #9#9#9#9#9'selecionados1.sugestaomaximo,'
      ''
      '                    selecionados1.csosn,'
      '                    selecionados1.incidencia'
      #9#9'   '#9
      
        '          ) AS selecionados1 join estoques on selecionados1.prod' +
        'uto = estoques.produto and'
      
        '                                                   selecionados1' +
        '.filial = estoques.filial'
      '        ) as selecionados2, filiais, colunasprecos'
      '          where selecionados2.filial = filiais.codigo and'
      
        '                    colunasprecos.caracteristica = selecionados2' +
        '.caracteristica and'
      
        '                    colunasprecos.preco =   selecionados2.preco ' +
        'and'
      '                    colunasprecos.coluna = filiais.preconormal'
      '       ) AS selecionados3'
      #9'   '
      #9'   '
      #9'   '
      #9'   '
      '      ) as selecionados4'
      '      ) as selecionados5'
      ''
      '      %sugestao2'
      ''
      ''
      '    ) as selecionados6'
      '  ) as selecionados7'
      ') as selecionados8'
      ''
      '   %sugestao8'
      ''
      ') as selecionados9'
      ''
      '  left join notaspag np'
      'on( np.codigo = (select max(pn.codigonota)'
      '                   from produtosnotaspag pn,notaspag np1'
      '                   where pn.produto = selecionados9.produto'
      '                   and np1.codigo=pn.codigonota'
      '                   and np1.tipofornecedor<>'#39'L'#39
      
        '                   and ehnotafiscalentradacompra(pn.codigofiscal' +
        '))'
      
        '      )   left join vfornecedores vf on (np.fornecedor = vf.codi' +
        'go and np.tipofornecedor = vf.tipo)'
      #9'  '
      ''
      '   %ORDERBY')
    RequestLive = True
    Left = 787
    Top = 118
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'filialbase'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'diasproporcional'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NaoConsiderarPedidosCompraparaDiasEstoque'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'diasestoque'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'inicio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'fim'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'periodo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'conceitos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NaoConsiderarPedidosCompra'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'PedidosEntreFiliais'
        ParamType = ptUnknown
      end>
  end
  object qryTotalProdutosSimilares: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkFields = 'produto=produtosml'
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftString
        Name = 'quantidadeemestoque'
        ParamType = ptUnknown
        Value = 'e.emestoque'
      end
      item
        DataType = ftUnknown
        Name = 'ListadeProdutos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiliaisEstoque'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Filiais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'estoques'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ''
      ';'
      '   select cast('#39'TOTAL'#39' as varchar(5)) as total,'
      '          produtosml,'
      '          sum(quantidadesimilares) as quantidadesimilares,'
      '          sum(total_estoque) as total_estoque,'
      '          sum(emEstoque) as emEstoque,'
      ''
      '          sum(total_transito) as total_transito,'
      #9'      sum(reservado) as reservado,'
      '              sum(reservaprevia) as reservaprevia,'
      ''
      '          sum(futuro) as futuro,'#9
      #9'      sum(total_pedido) as total_pedido,'
      
        '              sum(total_pedidos_fornecedores) as total_pedidos_f' +
        'ornecedores,'
      
        '              sum(total_pedidos_filiais) as total_pedidos_filiai' +
        's,'
      ''
      ''
      #9#9'  sum(total_vendido) as total_vendido,'
      #9'      sum(sugestao) as sugestao,'
      ''
      ' '#9#9'  sum(minimo) as minimo,'
      #9#9'  sum(sugestaominimo) as sugestaominimo,'
      #9#9'  sum(maximo) as maximo,'
      #9#9'  sum(sugestaomaximo) as sugestaomaximo,'
      ''
      '       cast('
      
        '       case when sum(total_vendido_temp)<>0 and :periodo <> 0 th' +
        'en'
      ''
      '         (sum(emEstoque)/'
      '          (sum(Total_vendido_temp) / :Periodo))'
      ''
      '       else'
      '         cast(999999.99 as numeric(11,2))'
      '       end as numeric(12,2)) as diasestoque,'
      ''
      '       cast('
      
        '       case when sum(total_vendido_temp)<>0 and :periodo <> 0 th' +
        'en'
      ''
      
        '         ((sum(total_estoque) + sum(case when /*:NaoConsiderarPe' +
        'didosCompraparaDiasEstoque*/ false then 0 else total_pedido end)' +
        ')/'
      '          (sum(Total_vendido_temp) / :Periodo))'
      ''
      '       else'
      '         cast(999999.99 as numeric(11,2))'
      '       end as numeric(12,2)) as diasestoquecompedidosdecompra'
      ''
      ''
      '     from'
      '    ('
      '     select produtosml,'
      '            sum(quantidadesimilares) as quantidadesimilares,'
      '            sum(total_estoque) as total_estoque,'
      '            sum(emestoque) as emestoque,'
      ''
      '            sum(total_transito) as total_transito,'
      '            sum(reservado) as reservado,'
      '            sum(reservaprevia) as reservaprevia,'
      '            sum(futuro) as futuro,'
      '            sum(total_pedido) as total_pedido,'
      
        '            sum(total_pedidos_fornecedores) as total_pedidos_for' +
        'necedores,'
      '            sum(total_pedidos_filiais) as total_pedidos_filiais,'
      '            sum(total_vendido) as total_vendido,'
      '            sum(sugestao) as sugestao,'
      ''
      '       cast('
      '       case when sum(total_vendido)<>0 and periodo <> 0 then'
      '          sum(Total_vendido*:periodo/periodo)'
      '       else'
      '         cast(null as numeric(11,2))'
      '       end as numeric) as total_vendido_temp,'
      ''
      #9#9#9'/* sum(diasestoque) as diasestoque, */'
      ''
      #9#9#9'sum(minimo) as minimo,'
      #9#9#9'sum(sugestaominimo) as sugestaominimo,'
      #9#9#9'sum(maximo) as maximo,'
      #9#9#9'sum(sugestaomaximo) as sugestaomaximo'
      '     from'
      '     ('
      #9'  SELECT *,'
      
        '              /*SE TEM SUGESTAO DE COMPRA, DE ACORDO COM DIASEST' +
        'OQUE, ENTAO RECALCULA A SUGESTAO DE ACORDO COM DIAS PROPORCIONAL' +
        '*/'
      
        '             case when sugestao1 <= 0 then 0 else (cast(ROUND( (' +
        ' cast((total_vendido) as float) / periodo) * :diasproporcional )' +
        ' as float) - total_estoque - total_pedido+futuro) end as sugesta' +
        'o /*,'
      ''
      '             cast('
      '             case when coalesce(total_vendido,0)<>0 then'
      '               ((total_estoque + total_pedidos_filiais)/'
      '                (Total_vendido / Periodo))'
      '             else'
      '               cast(999999.99 as numeric(11,2))'
      '             end as numeric(12,2)) as diasestoque'
      ''
      '             */'
      ''
      '      from'
      '      ('
      
        '      SELECT *, (cast(ROUND( ( cast((total_vendido) as float) / ' +
        'periodo) * :diasestoque ) as float) - total_estoque - total_pedi' +
        'do+futuro) AS sugestao1'
      '      FROM'
      '        ('
      
        '            select estoquesprodutos.produto, estoquesprodutos.pr' +
        'odutosml,'
      '                   estoquesprodutos.periodo,'
      '                   count(*) as quantidadesimilares,'
      ''
      
        '                    SUM ( estoquesprodutos.estoque ) AS total_es' +
        'toque,'
      
        '                    SUM ( estoquesprodutos.emestoque ) AS emesto' +
        'que,'
      ''
      
        '                    sum ( estoquesprodutos.transito ) as total_t' +
        'ransito,'
      '                    '
      
        '                    SUM ( estoquesprodutos.pedido  + estoquespro' +
        'dutos.pedidos_filiais) AS total_pedido,'
      
        '                    SUM ( estoquesprodutos.pedido ) AS total_ped' +
        'idos_fornecedores,'
      
        '                    SUM ( estoquesprodutos.pedidos_filiais) as t' +
        'otal_pedidos_filiais,'
      
        '                    sum ( estoquesprodutos.vendido ) AS total_ve' +
        'ndido,'
      
        '                    CAST (SUM (estoquesprodutos.reservado) as fl' +
        'oat) as reservado,'
      
        '                    CAST (SUM (estoquesprodutos.reservaprevia) a' +
        's float) as reservaprevia,'
      ''
      
        '                    CAST (SUM (estoquesprodutos.futuro) as float' +
        ') as futuro,'
      '                    cast(SUM(minimo) as float) as minimo,'
      
        '                    cast(case when SUM(minimo - saldo)<0 then 0 ' +
        'else SUM(minimo-saldo) end as float) as sugestaominimo,'
      '                    cast (SUM (maximo) as float) as maximo,'
      
        '                    cast(case when SUM(maximo - saldo)<0 then 0 ' +
        'else SUM(maximo-saldo) end as float) as sugestaomaximo'
      '            from'
      '           ('
      ''
      '            select produtos.*,'
      '                   %quantidadeemestoque  as estoque,'
      '                   e.emestoque,'
      ''
      '                   /*'
      '                   case when not :PedidosEntreFiliais then 0'
      '                   else'
      
        '                     coalesce((select sum(case when pf.situacao ' +
        '= '#39'A'#39' then pf.qtdepedida'
      
        '                                      when pf.situacao = '#39'F'#39' the' +
        'n pf.qtderecebida end)'
      '                      from pedidosfiliais pf'
      '                      where pf.produto = e.produto'
      '                       and pf.requisitante = e.filial'
      '                       and pf.situacao in ('#39'A'#39','#39'F'#39')),0)'
      '                   end as pedidos_filiais,'
      '                   */'
      ''
      '                   case when not :PedidosEntreFiliais then 0'
      '                   else'
      ''
      
        '                     coalesce((select sum(case when pf.situacao ' +
        '= '#39'A'#39' then pf.qtdepedida'
      
        '                                      when pf.situacao = '#39'F'#39' the' +
        'n 0 end)'
      '                      from pedidosfiliais pf'
      '                      where pf.produto = e.produto'
      '                       and pf.requisitante = e.filial'
      
        '                       and pf.situacao in ('#39'A'#39','#39'F'#39')),0) /*+ e.tr' +
        'ansito*/'
      ''
      '                   end  as pedidos_filiais,'
      ''
      #9#9#9#9'   '
      
        '                   /*considera como ainda em pedido os produtos ' +
        'que estao em nota parcial e vinculados a pedido*/'
      '                   case when :NaoConsiderarPedidosCompra then 0'
      
        '                   else coalesce(pedidos_estoquepedido ( e.produ' +
        'to, e.filial ),0) + produtospedidos_recebido_semnotaparcial(e.pr' +
        'oduto,e.filial) end AS pedido,'
      ''
      
        '                   movimentos_vendido(:inicio, :fim, e.produto, ' +
        'e.filial) as vendido,'
      '                   e.reservado,'
      '                   e.reservaprevia,'
      '                   e.futuro,'
      '                   e.transito,'
      '                   coalesce(e.minimo,0) as minimo,'
      '                   coalesce(e.maximo,0) as maximo,'
      '                   %quantidadeemestoque'
      
        '                   + case when :NaoConsiderarPedidosCompra then ' +
        '0 else pedidos_estoquepedido(e.produto,e.filial) end -e.futuro a' +
        's saldo'
      '            from'
      '            ('
      '             select p.codigo as produto, similares.produtosml,'
      #9#9#9' '
      
        '  '#9'                case when p.datacadastro between :inicio and ' +
        ':fim then'
      #9#9#9#9#9#9#9'case when :fim = p.datacadastro then 1'
      #9#9#9#9#9#9#9'else :fim - p.datacadastro end'
      '                    else :periodo end as periodo'
      ''
      
        '             from ((caracteristicas c join marcas m on c.marca =' +
        ' m.codigo)'
      
        '                                        join produtos p on p.car' +
        'acteristica = c.codigo),'
      '                                        '
      '                                        '
      
        '                                             (                  ' +
        '                           '
      
        '                                                         SELECT ' +
        'distinct codigo, produto as produtosml'
      ''
      '                                                         from'
      '                                                         ('
      ''
      '                                                           ('
      ''
      
        '                                                             sel' +
        'ect distinct ps.codigo, psel_similar.psel_codigo as produto'
      ''
      ''
      
        '                                                             fro' +
        'm (produtos ps'
      
        '                                                                ' +
        '   join caracteristicas cs'
      
        '                                                                ' +
        '   on ps.caracteristica = cs.codigo),'
      ''
      '                                                             ('
      ''
      
        '                                                               s' +
        'elect distinct'
      
        '                                                                ' +
        '     psel.codigo as psel_codigo,'
      
        '                                                                ' +
        '     psel.caracteristica as psel_caracteristica,'
      
        '                                                                ' +
        '     psel.agrupamentosimilares as psel_agrupamentosimilares,'
      
        '                                                                ' +
        '     psel.grade1 as psel_grade1,'
      
        '                                                                ' +
        '     psel.grade2 as psel_grade2,'
      
        '                                                                ' +
        '     psel.valorgrade1 as psel_valorgrade1,'
      
        '                                                                ' +
        '     psel.valorgrade2 as psel_valorgrade2,'
      
        '                                                                ' +
        '     s."similar"'
      
        '                                                                ' +
        '   '
      
        '                                                               f' +
        'rom similares s right outer join'
      '                                                                '
      
        '                                                                ' +
        '     ('
      
        '                                                                ' +
        '     select p.codigo, '
      
        '                                                                ' +
        '            p.caracteristica, '
      
        '                                                                ' +
        '            c.agrupamentosimilares,'
      
        '                                                                ' +
        '            c.grade1,'
      
        '                                                                ' +
        '            c.grade2,'
      
        '                                                                ' +
        '            p.valorgrade1,'
      
        '                                                                ' +
        '            p.valorgrade2'
      
        '                                                                ' +
        '            '
      
        '                                                                ' +
        '     from produtos p '
      
        '                                                                ' +
        '          join caracteristicas c'
      
        '                                                                ' +
        '           on p.caracteristica = c.codigo'
      
        '                                                                ' +
        '     where p.codigo in (%ListadeProdutos)'
      
        '                                                                ' +
        '     ) as psel'
      
        '                                                                ' +
        '     '
      
        '                                                               O' +
        'N s.caracteristica = psel.caracteristica        '
      
        '                                                             ) a' +
        's psel_similar'
      '                                                              '
      
        '                                                            wher' +
        'e (ps.caracteristica = psel_similar.similar or '
      
        '                                                                ' +
        '   ps.caracteristica  = psel_similar.psel_caracteristica)'
      
        '                                                                ' +
        '  '
      
        '                                                /*              ' +
        'and ps.codigo <> psel_similar.psel_codigo*/'
      '                                                              '
      
        '                                                              an' +
        'd ((ps.inativo IS NULL) OR '
      
        '                                                                ' +
        '   (ps.inativo>CURRENT_DATE))'
      
        '                                                                ' +
        '   '
      
        '                                                              an' +
        'd case when coalesce(psel_agrupamentosimilares, '#39#39') = '#39'L'#39
      
        '                                                                ' +
        '           AND psel_grade1 IS NOT NULL'
      
        '                                                                ' +
        '           AND psel_valorgrade1 IS NOT NULL  then '
      
        '                                                                ' +
        '           '
      
        '                                                                ' +
        '              ps.valorgrade1 = psel_valorgrade1'
      
        '                                                                ' +
        '              and cs.grade1 = psel_grade1'
      
        '                                                                ' +
        '           '
      
        '                                                                ' +
        '           '
      
        '                                                                ' +
        '       when coalesce(psel_agrupamentosimilares, '#39#39') = '#39'C'#39
      
        '                                                                ' +
        '           AND psel_grade2 IS NOT NULL'
      
        '                                                                ' +
        '           AND psel_valorgrade2 IS NOT NULL  then  '
      
        '                                                                ' +
        '           '
      
        '                                                                ' +
        '             ps.valorgrade2 = psel_valorgrade2'
      
        '                                                                ' +
        '             and cs.grade2 = psel_grade2'
      
        '                                                                ' +
        '           '
      
        '                                                                ' +
        '  else true end     '
      '                                                              '
      '                                                             )'
      ''
      
        '                                                              un' +
        'ion all'
      '                                                              '
      '                                                             ('
      
        '                                                               S' +
        'ELECT ps."similar" as codigo, ps.produto'
      
        '                                                               F' +
        'ROM produtos_similares ps'
      
        '                                                               W' +
        'HERE ps.produto in (%ListadeProdutos)'
      '                                                             '
      '                                                              )'
      '                                                              '
      
        '                                                            ) as' +
        ' ps'
      '                                                order by codigo'
      '                                             '
      '                                             '
      '                                             ) as similares'
      '                                        '
      '                                        '
      '                                        '
      '             where p.caracteristica = c.codigo'
      '               and c.marca = m.codigo'
      '               and p.codigo = similares.codigo'
      '               '
      
        '                                                                ' +
        ' '
      ''
      '                %FiliaisEstoque'
      ''
      '            ) as produtos'
      '                          /*left*/ join'
      
        '                         estoques e on e.produto = produtos.prod' +
        'uto'
      ''
      '            where e.produto = produtos.produto'
      ''
      '            %Filiais'
      '            %estoques'
      ''
      ''
      '           ) as estoquesprodutos'
      '            GROUP BY produto, produtosml, periodo'
      '       ) AS selecionados3'
      '      ) as selecionados4'
      #9' ) AS selecionados5'
      #9' group by produtosml, periodo '
      #9') as selecionados6'
      '    group by produtosml'
      ''
      ''
      ''
      '  /*'
      ''
      '    :produto'
      ''
      '  */')
    RequestLive = True
