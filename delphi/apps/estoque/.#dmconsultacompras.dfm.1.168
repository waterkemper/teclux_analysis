  object qryPedidosFiliais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeScroll = qryPedidosFiliaisBeforeScroll
    AfterScroll = qryPedidosFiliaisAfterScroll
    OnCalcFields = qryPedidosFiliaisCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'quantidadeemestoque'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ArrayProduto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ArrayQuantidade'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'produtos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'resultadocurvaabc'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'Filiais'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'estoques'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '/* qryPedidosFiliais */'
      ';'
      'select *'
      'from'
      '('
      'select *,'
      '       case when sugestao1 <= 0 then 0'
      
        '       else (cast(ROUND( ( cast((total_vendido) as float) / peri' +
        'odo) * :diasproporcional ) as float) - total_estoque - total_ped' +
        'ido + selecionados.futuro)'
      '       end as sugestao,'
      ''
      '       cast('
      '       case when coalesce(total_vendido,0)<>0 then'
      
        '         ((emEstoque + case when /*:NaoConsiderarPedidosComprapa' +
        'raDiasEstoque*/ true then 0 else total_pedido end)/'
      '          (Total_vendido / Periodo))'
      '       else'
      '         cast(999999.99 as numeric(11,2))'
      '       end as numeric(12,2)) as diasestoque,'
      ''
      '       cast('
      '       case when coalesce(total_vendido,0)<>0 then'
      
        '         ((total_estoque + case when /*:NaoConsiderarPedidosComp' +
        'raparaDiasEstoque*/ false then 0 else total_pedido end)/'
      '          (Total_vendido / Periodo))'
      '       else'
      '         cast(999999.99 as numeric(11,2))'
      '       end as numeric(12,2)) as diasestoquecompedidosdecompra,'
      '       cast(:requisitante as integer) AS Requisitante,'
      
        '       (case when filial=cast(:requisitante as INTEGER) then tru' +
        'e else false end) as eHRequisitante,'
      ''
      '       emestoque as emestoqueanterior,'
      '       cast(null as numeric(11,3)) as qtdepedida,'
      '       cast(null as varchar(150)) as observacao,'
      ''
      '       (select sum(%quantidadeemestoque)'
      '        from estoques e join filiais f on e.filial = f.codigo'
      '        where e.produto = selecionados.produto'
      '          and e.filial <> :requisitante'
      '          and f.tipofilial <> '#39'V'#39
      '        ) as totalfiliaisemestoque,'
      ''
      '       cast(999999.99 as numeric(11,2)) as diasEstoqueCalculado,'
      '       cast(999999.99 as numeric(11,2)) as diasEstCalcPedCompra'
      ''
      ''
      'from'
      ''
      '('
      
        'SELECT *, (cast(ROUND( ( cast(total_vendido as float)/ periodo) ' +
        '* :diasestoque ) as float) - total_estoque - total_pedido + futu' +
        'ro)  AS sugestao1,'
      
        '       case when :EstoqueTotal <> 0 then cast(total_estoque * 10' +
        '0 / :EstoqueTotal as numeric(6,2)) else 0 end as percEstoque,'
      '       (select max(m.data)'
      '        from movimentos m'
      '        where m.produto = selecionados.produto'
      '          and m.filial = selecionados.filial'
      '          and m.tipomovimento = '#39'STC'#39') as datapedido'
      ''
      'FROM'
      '  ('
      '        SELECT'
      '              s.filial,'
      '              s.produto,'
      '              s.produtovisual,'
      '              s.descricaoproduto,'
      '              s.periodo,'
      '              fgf.grupo,'
      '              filiais.mnemonico,'
      '              filiais.tipofilial,'
      '              SUM ( s.estoque ) AS total_estoque,'
      '              sum ( s.emestoque ) AS emestoque,'
      '              SUM ( s.transito ) AS total_transito,'
      
        '              SUM ( s.pedido + s.pedidos_filiais) AS total_pedid' +
        'o,'
      '              SUM ( s.pedido ) AS total_pedidos_fornecedores,'
      '              SUM ( s.pedidos_filiais) AS total_pedidos_filiais,'
      '              SUM ( s.vendido ) AS total_vendido,'
      '              s.reservado,'
      '              s.reservaprevia,'
      '              s.ultimavenda,'
      
        '              s.minimo, case when (s.minimo - s.saldo)<0 then 0 ' +
        'else (s.minimo-s.saldo) end as sugestaominimo,'
      
        '              s.maximo,case when (s.maximo - s.saldo)<0 then 0 e' +
        'lse (s.maximo-s.saldo) end as sugestaomaximo, s.futuro,'
      '              s.quantidade'
      '       FROM'
      '       ('
      ''
      '              select e.*,'
      
        '                   coalesce(pedidos_estoquepedido,0) + produtosp' +
        'edidos_recebido_semnotaparcial AS pedido,'
      
        '                   e.estoque + pedidos_estoquepedido - e.futuro ' +
        'as saldo,'
      
        '                   case when e.datacadastro between :inicio and ' +
        ':fim then'
      
        '                                                      case when ' +
        ':fim = e.datacadastro then 1'
      
        '                                                      else :fim ' +
        '- e.datacadastro end'
      '                   else :periodo end as periodo'
      ''
      '              from'
      '              ('
      '              select e.*,'
      '                    case when :NaoConsiderarPedidosCompra then 0'
      
        '                    else produtospedidos_recebido_semnotaparcial' +
        '(e.produto,e.filial) end as produtospedidos_recebido_semnotaparc' +
        'ial'
      ''
      '              FROM'
      '              ('#9
      '              select e.*,'
      
        '                     case when :NaoConsiderarPedidosCompra then ' +
        '0'
      
        '                     else pedidos_estoquepedido(e.produto,e.fili' +
        'al) end as pedidos_estoquepedido'
      ''
      '              from'
      '              ('
      '              select e.*,'
      ''
      ''
      
        '                     case when :conceitos='#39#39' then movimentos_ven' +
        'dido(:inicio,:fim, e.produto, e.filial)'
      
        '                      else movimentos_vendido_porconceito(:inici' +
        'o,:fim, e.produto, e.filial,:conceitos) end'
      '                      as vendido'
      ''
      '              from'
      ''
      '              ('#9
      ''
      '              select e.*,'
      ''
      '                       /*'
      '                       case when not :PedidosEntreFiliais then 0'
      '                       else'
      '                       coalesce((select sum(pf.qtdepedida)'
      '                       from pedidosfiliais pf'
      '                       where pf.produto = e.produto'
      '                       and pf.requisitante = e.filial'
      '                       and pf.situacao = '#39'A'#39'),0) + e.transito'
      '                       end as pedidos_filiais'
      '                       */'
      ''
      '                   case when not :PedidosEntreFiliais then 0'
      '                   else'
      ''
      
        '                     coalesce((select sum(case when pf.situacao ' +
        '= '#39'A'#39' then pf.qtdepedida'
      
        '                                      when pf.situacao = '#39'F'#39' the' +
        'n 0 end)'
      '                      from pedidosfiliais pf'
      '                      where pf.produto = e.produto'
      '                       and pf.requisitante = e.filial'
      
        '                       and pf.situacao in ('#39'A'#39','#39'F'#39')),0) /*+ e.tr' +
        'ansito*/'
      ''
      '                   end  as pedidos_filiais'
      ''
      ''
      ''
      '              from'
      '              ('
      '              select produtos.*,'
      '                   e.filial,'
      '                       e.datacompra,'
      ''
      '                       %quantidadeemestoque  as estoque,'
      ''
      '                       e.emestoque,'
      '                       e.futuro,'
      '                       e.transito,'
      '                       e.reservado,'
      '                       e.reservaprevia,'
      '                       e.ultimavenda,'
      '                       coalesce(e.minimo,0) as minimo,'
      '                       coalesce(e.maximo,0) as maximo'
      ''
      ''
      '              from estoques e join'
      '              ('
      
        '                                       select p.codigo as produt' +
        'o,'
      
        '                                              p.codigovisual as ' +
        'produtovisual,'
      
        '                                              p.descricao as des' +
        'cricaoproduto,'
      '                                              p.datacadastro,'
      
        '                                              cast(sel.aqtde as ' +
        'numeric(11,3)) as quantidade'
      ''
      
        '                                       from ((((caracteristicas ' +
        'c'
      '                                                  join marcas m'
      
        '                                                  on c.marca = m' +
        '.codigo)'
      ''
      '                                                 join grupos g'
      
        '                                                 on c.grupo = g.' +
        'codigo)'
      ''
      '                                                join classes cl'
      
        '                                                on c.classe = cl' +
        '.codigo)'
      ''
      
        '                                                JOIN ((produtos ' +
        'p'
      
        '                                                      LEFT JOIN ' +
        'promocoes pro ON p.promocao = pro.codigo)'
      ''
      '                                                      JOIN'
      ''
      
        '                                                  (SELECT unnest' +
        '(ARRAY[%ArrayProduto]) AS aprod,'
      
        '                                                          unnest' +
        '(ARRAY[%ArrayQuantidade]) AS aqtde) AS sel'
      
        '                                                    ON p.codigo ' +
        '= sel.aprod)'
      ''
      ''
      
        '                                               on p.caracteristi' +
        'ca = c.codigo)'
      ''
      ''
      
        '                                       where p.caracteristica = ' +
        'c.codigo'
      '                                         and c.marca = m.codigo'
      '                                         and c.grupo = g.codigo'
      
        '                                         and c.classe = cl.codig' +
        'o'
      ''
      #9#9#9#9' '
      '                           %produtos'
      '                           %resultadocurvaabc'
      #9#9#9#9' '#9#9#9#9' '
      '                                      order by p.codigo'#9
      #9#9#9#9' '
      '              ) as produtos on e.produto = produtos.produto'#9#9#9#9
      '              where true'
      
        '                and ( (%quantidadeemestoque)>0 or e.filial = :re' +
        'quisitante)'
      ''
      '                          %Filiais'
      '                          %estoques'
      ''
      '              ) as e'
      '              ) as e'
      '              ) as e'
      '              ) as e'
      '              ) as e'
      '              order by filial, produto'
      ''
      ''
      '       ) AS s'
      '           JOIN filiais'
      '           join (filiaisgruposfiliais fgf'
      '                 join gruposfiliais g'
      '                   on fgf.grupo = g.codigo)'
      '           on filiais.codigo = fgf.filial'
      '           on s.filial=filiais.codigo'
      ''
      '           where filiais.tipofilial<>'#39'V'#39
      ''
      
        '      GROUP BY s.produto, s.produtovisual, s.descricaoproduto, s' +
        '.quantidade, fgf.grupo, s.filial, filiais.mnemonico, filiais.tip' +
        'ofilial, s.reservado, s.reservaprevia, s.futuro, s.minimo, s.max' +
        'imo, s.saldo, s.periodo, s.ultimavenda'
      '   ) AS selecionados'
      ''
      
        '/*where  (total_estoque<>0) or (total_pedido<>0) or (total_vendi' +
        'do<>0)*/'
      ''
      'ORDER BY mnemonico) as selecionados'
      ') as selecionados'
      
        'order by produto, grupo, eHRequisitante, diasestoque desc, emest' +
        'oque desc,'
      
        '         coalesce(cast(datapedido as date), cast('#39'1899-01-01'#39' as' +
        ' date)),'
      '         coalesce(ultimavenda, cast('#39'1899-01-01'#39' as date)),'
      '         filial')
    RequestLive = True
    Left = 526
    Top = 138
    ParamData = <
      item
        DataType = ftString
        Name = 'diasproporcional'
        ParamType = ptUnknown
        Value = '10'
      end
      item
        DataType = ftString
        Name = 'NaoConsiderarPedidosCompraparaDiasEstoque'
        ParamType = ptUnknown
        Value = 'false'
      end
      item
        DataType = ftString
        Name = 'requisitante'
        ParamType = ptUnknown
        Value = '12'
      end
      item
        DataType = ftString
        Name = 'diasestoque'
        ParamType = ptUnknown
        Value = '10'
      end
      item
        DataType = ftString
        Name = 'EstoqueTotal'
        ParamType = ptUnknown
        Value = 'e.emestoque'
      end
      item
        DataType = ftString
        Name = 'inicio'
        ParamType = ptUnknown
        Value = #39'2020-09-14'#39
      end
      item
        DataType = ftString
        Name = 'fim'
        ParamType = ptUnknown
        Value = #39'2020-09-14'#39
      end
      item
        DataType = ftString
        Name = 'periodo'
        ParamType = ptUnknown
        Value = '10'
      end
      item
        DataType = ftString
        Name = 'NaoConsiderarPedidosCompra'
        ParamType = ptUnknown
        Value = 'false'
      end
      item
        DataType = ftString
        Name = 'conceitos'
        ParamType = ptUnknown
        Value = #39'0'#39
      end
      item
        DataType = ftString
        Name = 'PedidosEntreFiliais'
        ParamType = ptUnknown
        Value = 'false'
      end>
