        Name = 'resultadocurvaabc'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      '  select selecao1.produto,'
      '         selecao1.grupo,'
      '         selecao1.mes,'
      '         selecao1.totalvendas,'
      '         selecao2.qtcontrato,'
      '         selecao1.totalinternet,'
      '         selecao2.qtinternet,'
      '         selecao1.totalloja,'
      '         selecao2.qtloja'
      '  from'
      '  ('
      ''
      '  select selecao1.produto, selecao1.grupo, selecao1.mes,'
      '          sum(selecao1.totalvendas) as totalvendas,'
      '          sum(selecao1.totalinternet) as totalinternet,'
      '          sum(selecao1.totalloja) as totalloja'
      ''
      '  from'
      '  ('
      '   SELECT m.produto, fgf.grupo,'
      
        '          SUM(CASE WHEN (substr(m.operacao,13,1) = '#39'+'#39') THEN  ab' +
        's(m.quantidade) ELSE -abs(m.quantidade) END) as totalvendas,'
      '          sum(case when (substr(m.operacao,13,1) = '#39'+'#39') THEN'
      
        '                   (case when p_s.contrato is not null then abs(' +
        'm.quantidade) else 0 END)'
      '              else'
      
        '                   (case when p_s.contrato is not null then -abs' +
        '(m.quantidade) else 0 END)'
      '              end) as totalinternet,'
      ''
      '          sum(case when (substr(m.operacao,13,1) = '#39'+'#39') THEN'
      
        '                   (case when p_s.contrato is null then abs(m.qu' +
        'antidade) else 0 END)'
      '              else'
      
        '                   (case when p_s.contrato is null then -abs(m.q' +
        'uantidade) else 0 END)'
      '              end) as totalloja,'
      ''
      ''
      '          cast(to_char(m.data,'#39'YYYY/mm'#39') as char(7)) AS mes'
      ''
      ''
      
        '   FROM movimentos m left join pedidos_site p_s on m.contrato = ' +
        'p_s.contrato'
      '        join'
      '        ('
      ''
      '          Select p.codigo'
      '          from produtos p join caracteristicas c'
      '                          on p.caracteristica=c.codigo'
      ''
      '               '
      '            where p.codigo = :similar'
      ''
      ''
      '         %produtos'
      ''
      '         %resultadocurvaabc'
      ''
      '         )'
      '         as p on m.produto = p.codigo'
      ''
      '        join filiaisgruposfiliais fgf'
      '        on m.filial = fgf.filial'
      ''
      ''
      
        '   WHERE m.data between (:datainicial) and (cast(:datafinal as d' +
        'ate) + 1)'
      
        '     and (substr(m.operacao,13,1) = '#39'+'#39' or substr(m.operacao,13,' +
        '1) = '#39'-'#39')'
      ''
      
        '   GROUP BY fgf.grupo, m.produto, to_char(m.data,'#39'YYYY/mm'#39'), p_s' +
        '.contrato'
      '   order by fgf.grupo, m.produto, to_char(m.data,'#39'YYYY/mm'#39') desc'
      ''
      '  ) as selecao1'
      '   GROUP BY grupo, produto, mes'
      '   order by grupo, produto, mes desc'
      ''
      '  ) as selecao1'
      '    left join'
      '    ('
      ''
      ''
      '          select saldo.grupo, saldo.produto, saldo.mes,'
      '                 cast(sum(QtContrato) as integer) as QtContrato,'
      '                 cast(sum(QtInternet) as integer) as QtInternet,'
      '                 cast(sum(QtLoja) as integer) as QtLoja'
      ''
      '          from'
      '          ('
      
        '          select saldo.grupo, saldo.produto, saldo.contrato, sal' +
        'do.mes,'
      
        '                 case when sum(saldo.quantidade) > 0 then 1 else' +
        ' 0 end as QtContrato,'
      
        '                 case when sum(saldo.quantidade) > 0 and p_s.con' +
        'trato is not null then 1 else 0 end as QtInternet,'
      
        '                 case when sum(saldo.quantidade) > 0 and p_s.con' +
        'trato is null then 1 else 0 end as QtLoja'
      ''
      '          from'
      '          ('
      ''
      '          ('
      
        '           select fgf.grupo, m2.produto, m2.contrato, to_char(m2' +
        '.data,'#39'YYYY/mm'#39') as mes, sum(abs(m2.quantidade)) as quantidade'
      
        '           from movimentos m2 join produtos p on m2.produto = p.' +
        'codigo join caracteristicas c on p.caracteristica=c.codigo'
      '                join filiaisgruposfiliais fgf'
      '                  on m2.filial = fgf.filial'
      ''
      ''
      ''
      '            where p.codigo = :similar'
      ''
      '            %produtos'
      '            %resultadocurvaabc'
      ''
      
        '           and m2.data between (:datainicial) and (cast(:datafin' +
        'al as date) + 1)'
      '           and (substr(m2.operacao,13,1) = '#39'+'#39')'
      '           and m2.contrato is not null'
      
        '           group by fgf.grupo, m2.produto, m2.contrato, to_char(' +
        'm2.data,'#39'YYYY/mm'#39')'
      '          )'
      ''
      '          union all'
      ''
      ''
      '          ('
      
        '          select fgf.grupo, cd.produto, cd.contrato, to_char(cd.' +
        'devolucao,'#39'YYYY/mm'#39') as mes, -sum(cd.quantidade) as quantidade'
      
        '          from contratosdevolvidos cd join produtos p on cd.prod' +
        'uto = p.codigo join caracteristicas c on p.caracteristica=c.codi' +
        'go'
      '                          join filiaisgruposfiliais fgf'
      '                  on cd.filial = fgf.filial'
      ''
      ''
      '            where cd.situacao='#39'N'#39
      '              and p.codigo = :similar'
      ''
      ''
      '            %produtos'
      '            %resultadocurvaabc'
      ''
      
        '          and cd.devolucao between (:datainicial) and (cast(:dat' +
        'afinal as date) + 1)'
      
        '          group by fgf.grupo, cd.produto,cd.contrato, to_char(cd' +
        '.devolucao,'#39'YYYY/mm'#39')'
      '          )'
      
        '          ) as saldo left join pedidos_site p_s on saldo.contrat' +
