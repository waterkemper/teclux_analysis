      end
      item
        DataType = ftUnknown
        Name = 'fim'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'periodo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NaoConsiderarPedidosCompra'
        ParamType = ptUnknown
