  object qryTabelaTempDetalhe: TtecQuery
    Tag = -1
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'quantidadeemestoque'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'produtos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'resultadocurvaabc'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Filiais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'estoques'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'create temp table DetalheProdutoConsultaCompras as'
      '('
      '              select e.*,'
      '                       case when not :PedidosEntreFiliais then 0'
      '                       else'#9
      '                       coalesce((select sum(pf.qtdepedida)'
      '                       from pedidosfiliais pf'
      '                       where pf.produto = e.produto'
      '                       and pf.requisitante = e.filial'
      '                       and pf.situacao = '#39'A'#39'),0) + e.transito'
      '                       end as pedidos_filiais'
      ''
      ''
      '              from'
      '              ('
      '              select produtos. *,'
      '                   e.filial,'
      '                       e.datacompra,'
      '                       %quantidadeemestoque  as estoque,'
      '                       e.futuro,'
      '                       e.transito,'
      '                       e.reservado,'
      '                       coalesce(e.minimo,0) as minimo,'
      '                       coalesce(e.maximo,0) as maximo'
      #9' '
      #9' '
      '              from estoques e join'
      '              ('
      ''
      '                select'
      '                      gr1.descricao as linha,'
      '                      gr2.descricao as coluna,'
      '                      c.marca as codigomarca,'
      '                      m.descricao as marca,'
      '                      p.codigo as produto,'
      '                      p.codigovisual as produtovisual,'
      '                      p.descricao as nomeproduto,'
      '                      p.valorgrade1,'
      '                      p.valorgrade2,'
      '                      p.caracteristica,'
      '                      p.referencia,'
      '                      p.preco,'
      '                      p.resultadocurvaabc,'
      '                      p.lembrarpedido,'
      '                      p.datacadastro'
      ''
      
        '                from ((((caracteristicas c join marcas m on c.ma' +
        'rca = m.codigo)'
      
        '                                          join produtos p on p.c' +
        'aracteristica = c.codigo)'
      
        '                                          left join grades gr1 o' +
        'n gr1.codigo = c.grade1)'
      
        '                                          left join grades gr2 o' +
        'n gr2.codigo = c.grade2)'
      ''
      '                where p.caracteristica = c.codigo'
      '                and c.marca = m.codigo'
      ''
      '                             %produtos'
      '                             %resultadocurvaabc'
      ''
      '                order by p.codigo'
      ''
      '              ) as produtos on e.produto = produtos.produto'
      '              where true'
      ''
      '                          %Filiais'
      '                          %estoques'
      ''
      '              ) as e'
      '              ) as e'
      '              ) as e'
      '              ) as e'
      '              ) as e'
      ')')
    RequestLive = False
    Left = 952
    Top = 272
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'PedidosEntreFiliais'
        ParamType = ptUnknown
      end>
  end
