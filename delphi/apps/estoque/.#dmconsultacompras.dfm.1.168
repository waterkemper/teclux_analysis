      FieldName = 'total_estoque'
    end
    object qryComprasGruposFiliais_Similarestotal_transito: TFloatField
      FieldName = 'total_transito'
    end
    object qryComprasGruposFiliais_Similarestotal_pedidos_filiais: TFloatField
      FieldName = 'total_pedidos_filiais'
      DisplayFormat = '#######'
    end
    object qryComprasGruposFiliais_Similarestotal_pedidos_fornecedores: TFloatField
      FieldName = 'total_pedidos_fornecedores'
