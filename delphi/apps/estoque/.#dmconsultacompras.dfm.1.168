    object qryVVendasDiaria_Detalhadatotalvendas: TFloatField
      DisplayLabel = 'Qtdade Vendida'
      FieldName = 'totalvendas'
      DisplayFormat = '0.00'
    end
    object qryVVendasDiaria_Detalhadaqtcontrato: TIntegerField
      DisplayLabel = 'Qtade Vendas'
