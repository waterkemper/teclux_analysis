  object qryDetalhesPrecos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'produto=produto'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrComprasTotal
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'ListadeProdutos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'estoques'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'produtos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'resultadocurvaabc'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '/* qryDetalhesPrecos */'
      ''
      'SELECT'
      '   e.produto, e.filial,'
      ''
      
        '  (CASE WHEN (COALESCE(fpf.fator,0) > 0) then ROUND((cpn.valor *' +
        ' fpf.fator),2)'
      
        '                                         ELSE cpn.valor END) as ' +
        'valornormal,'
      ''
      '   COALESCE(cpn.alteracao,cpn.data) as alteracaopreconormal,'
      ''
      ''
      
        '  (CASE WHEN (COALESCE(fpf.fator,0) > 0) then ROUND((cpp.valor *' +
        ' fpf.fator),2)'
      
        '                                         ELSE cpp.valor END) as ' +
        'valorpromocao,'
      ''
      
        '   case when cpn.validade >= cpp.validade then cpn.validade else' +
        ' cpp.validade end as validade,'
      ''
      '   p.datacadastro,'
      ''
      
        '  (SELECT pr.descricao FROM precos pr WHERE pr.caracteristica = ' +
        'p.caracteristica AND pr.codigo = p.preco) AS descricaopreco,'
      '  e.ultimavenda'
      '/*  fgf.grupo */'
      ''
      ''
      'FROM estoques e join (produtos p'
      '                     join caracteristicas c'
      '                      on p.caracteristica = c.codigo)'
      ''
      '     on e.produto = p.codigo'
      ''
      '/*'
      
        '    join (produtos p left join promocoes pro on p.promocao = pro' +
        '.codigo)'
      '         join caracteristicas c'
      '              join marcas m'
      '              on c.marca = m.codigo'
      ''
      '              join grupos g'
      '              on c.grupo = g.codigo'
      ''
      '              join classes cl'
      '              on c.classe = cl.codigo'
      ''
      '         on p.caracteristica = c.codigo'
      ''
      '    on e.produto = p.codigo'
      ''
      '    */'
      ''
      '    join filiais f'
      ''
      '       /*'
      '         JOIN (filiaisgruposfiliais fgf'
      '                join gruposfiliais gf'
      '                 on fgf.grupo = gf.codigo)'
      '         on f.codigo = fgf.filial'
      '         */'
      ''
      '    on e.filial = f.codigo'
      ''
      '    left join fatoresprecosfiliais fpf'
      '    on fpf.fatorpreco = c.fatorpreco'
      ''
      '    join colunasprecos cpn           /* pre'#231'o normal */'
      '      on cpn.caracteristica = p.caracteristica'
      '     AND cpn.preco = p.preco'
      '     AND cpn.coluna = f.preconormal'
      ''
      '    left join colunasprecos cpp   /* pre'#231'o promo'#231#227'o */'
      '      on cpp.caracteristica = p.caracteristica'
      '     AND cpp.preco = p.preco'
      '     AND cpp.coluna = f.precopromocao'
      '     and cpp.validade >= current_date'
      ''
      ''
      'where e.produto in (%ListadeProdutos)'
      ' and e.produto = p.codigo'
      ' and p.caracteristica = c.codigo'
      '/* and c.marca = m.codigo */'
      ' and e.filial = f.codigo'
      ' and cpn.caracteristica = p.caracteristica'
      ' AND cpn.preco = p.preco'
      ' AND cpn.coluna = f.preconormal'
      ''
      '%estoques'
      ''
      '/*'
      ''
      '%produtos'
      '%resultadocurvaabc'
      ''
      '*/'
      ''
      
        'order by coalesce(e.ultimavenda, cast('#39'1980-01-01'#39' as date)) des' +
        'c'
      ''
      '')
    RequestLive = False
    Left = 137
    Top = 397
    object qryDetalhesPrecosproduto: TLargeintField
      FieldName = 'produto'
    end
    object qryDetalhesPrecosfilial: TIntegerField
      FieldName = 'filial'
    end
