  object qryVVendas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkFields = 'produto=produto'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrComprasTotal
    Constraints = <>
    OnCalcFields = qryVVendasCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'ListadeProdutos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FILTRO_CONCEITO'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      ''
      '/* qryVVendas */'
      ''
      'select produto, mes,'
      '       sum(totalvendas) as totalvendas,'
      '       cast(sum(qtcontrato) as integer) as qtcontrato,'
      ''
      '       sum(totalinternet) as totalinternet,'
      '       cast(sum(qtinternet) as integer) as qtinternet,'
      ''
      '       sum(totalloja) as totalloja,'
      '       cast(sum(qtloja) as integer) as qtloja'
      'from'
      '('
      ''
      ''
      '            select selecao1.produto,'
      
        '                   cast(to_char(selecao1.data,'#39'YYYY/mm'#39') as char' +
        '(7)) AS mes,'
      ''
      '                   selecao1.totalvendas,'
      
        '                   case when selecao1.totalvendas > 0 then cast(' +
        '1 as integer) else cast(0 as integer) end as qtcontrato,'
      ''
      '                   selecao1.totalinternet,'
      
        '                   case when selecao1.totalinternet > 0 then cas' +
        't(1 as integer) else cast(0 as integer) end as qtinternet,'
      ''
      '                   selecao1.totalloja,'
      
        '                   case when selecao1.totalloja > 0 then cast(1 ' +
        'as integer) else cast(0 as integer) end as qtloja'
      ''
      ''
      '            from'
      '            ('
      ''
      ''
      '                 SELECT'
      '                           produto'
      
        '                         , SUM(totalvendas)   as totalvendas    ' +
        '                     '
      '                         , SUM(totalinternet) as totalinternet'
      '                         , SUM(totalloja)     as totalloja'
      
        '                         , data, contrato, quantidade, precovend' +
        'a, precotabela'
      '                 FROM'
      '                           (   '
      '   '
      '                               ('
      ''
      '                               /* SA'#205'DAS */'
      '              '
      '                                     SELECT'
      '                                               m.produto'
      
        '                                             , abs(m.quantidade)' +
        ' as totalvendas,'
      ''
      
        '                                                                ' +
        '   case'
      
        '                                                                ' +
        '             when p_s.contrato is not null'
      
        '                                                                ' +
        '                       then abs(m.quantidade)'
      
        '                                                                ' +
        '                       else 0'
      
        '                                                                ' +
        '   END'
      '                                               as totalinternet,'
      ''
      ''
      ''
      
        '                                                                ' +
        '   case'
      
        '                                                                ' +
        '             when p_s.contrato is not null'
      
        '                                                                ' +
        '                       then 0'
      
        '                                                                ' +
        '                       else abs(m.quantidade)'
      
        '                                                                ' +
        '   END'
      ''
      '                                               as totalloja'
      
        '                                             , m.data, m.contrat' +
        'o, pdf.quantidade, pdf.precovenda, pdf.precotabela'
      '                                     FROM'
      '                                               movimentos m'
      '                                               left join'
      
        '                                                         pedidos' +
        '_site p_s'
      '                                                         on'
      
        '                                                                ' +
        '   m.contrato = p_s.contrato'
      ''
      '                                               join'
      '                                                         ('
      ''
      ''
      
        '                                                                ' +
        '   Select p.codigo'
      
        '                                                                ' +
        '   from produtos p'
      
        '                                                                ' +
        '   where p.codigo in (%ListadeProdutos)'
      
        '                                                                ' +
        '   order by p.codigo'
      ''
      '                                                         )'
      '                                                         as p'
      '                                                         on'
      
        '                                                                ' +
        '   m.produto = p.codigo'
      ''
      
        '                                                                ' +
        ' , (dadosfiscais fc'
      
        '                                                                ' +
        '    join produtosdadosfiscais pdf'
      
        '                                                                ' +
        '    on fc.numero = pdf.dadofiscal)'
      ''
      
        '                                     WHERE m.data between :datai' +
        'nicial and :datafinal'
      ''
      
        '                                               and coalesce(m.co' +
        'mposto,m.produto) = pdf.produto'
      
        '                                               and m.filial = pd' +
        'f.filial'
      
        '                                               AND fc.numero=m.d' +
        'adofiscal'
      
        '                                               AND CASE when :co' +
        'nceitos='#39#39' THEN true ELSE %FILTRO_CONCEITO END'
      
        '                                               and substr(m.oper' +
        'acao,13,1)='#39'+'#39
      '                                     order by'
      '                                               m.produto'
      '                                             , m.data desc'
      ''
      '                               )'
      ''
      '                               union all'
      ''
      '                               ('
      ''
      ''
      '/* ENTRADAS */'
      ''
      '                                     SELECT'
      '                                               m.produto'
      
        '                                             , -abs(m.quantidade' +
        ') as totalvendas'
      '                                             ,'
      
        '                                                                ' +
        '   case'
      
        '                                                                ' +
        '             when p_s.contrato is not null'
      
        '                                                                ' +
        '                       then -abs(m.quantidade)'
      
        '                                                                ' +
        '                       else 0'
      
        '                                                                ' +
        '   END'
      '                                               as totalinternet'
      '                                             , '
      
        '                                                                ' +
        '   case'
      
        '                                                                ' +
        '             when p_s.contrato is not null'
      
        '                                                                ' +
        '                       then 0'
      
        '                                                                ' +
        '                       else -abs(m.quantidade)'
      
        '                                                                ' +
        '   END'
      '                                               as totalloja'
      
        '                                             , m.data, m.contrat' +
        'o, -pnp.quantidade, pdf.precovenda, pdf.precotabela'
      '                                     FROM'
      '                                               movimentos m'
      '                                               left join'
      
        '                                                         pedidos' +
        '_site p_s'
      '                                                         on'
      
        '                                                                ' +
        '   m.contrato = p_s.contrato'
      '                                               join'
      '                                                         ('
      ''
      
        '                                                                ' +
        '   Select p.codigo'
      
        '                                                                ' +
        '   from produtos p'
      
        '                                                                ' +
        '   where p.codigo in (%ListadeProdutos)'
      
        '                                                                ' +
        '   order by p.codigo'
      ''
      '                                                         )'
      '                                                         as p'
      '                                                         on'
      
        '                                                                ' +
        '   m.produto = p.codigo'
      
        '                                                                ' +
        ' , (notaspag np'
      
        '                                                                ' +
        '    join produtosnotaspag pnp'
      
        '                                                                ' +
        '         left join produtosdadosfiscais pdf'
      
        '                                                                ' +
        '         on pnp.dadofiscal = pdf.dadofiscal'
      
        '                                                                ' +
        '         and pnp.produto = pdf.produto'
      
        '                                                                ' +
        '         and pnp.numeroprodutotabela = pdf.numero'
      
        '                                                                ' +
        '    on np.codigo = pnp.codigonota)'
      
        '                                                                ' +
        '    '
      
        '                                                                ' +
        ' , vfornecedores fc'
      
        '                                    WHERE m.data between :datain' +
        'icial and :datafinal'
      
        '                                               AND np.codigo    ' +
        '    =m.codigonota'
      
        '                                               AND np.fornecedor' +
        '    =fc.codigo'
      
        '                                               AND np.tipofornec' +
        'edor=fc.tipo'
      
        '                                               and coalesce(m.co' +
        'mposto,m.produto) = pnp.produto'
      
        '                                               and m.filial = pn' +
        'p.filial'
      
        '                                               AND CASE when :co' +
        'nceitos='#39#39' THEN true ELSE  %FILTRO_CONCEITO  END'
      
        '                                               and substr(m.oper' +
        'acao,13,1) ='#39'-'#39
      '                                     order by'
      '                                               m.produto'
      '                                             , m.data desc'
      ''
      ''
      ''
      ''
      '                             )'
      ''
      '                           ) as sel'
      '                           GROUP BY'
      
        '                           sel.produto, sel.data, sel.contrato, ' +
        'sel.quantidade, sel.precovenda, sel.precotabela'
      ''
      '                          order by'
      '                           sel.produto'
      '                         , sel.data desc'
      ''
      '             )  as selecao1'
      ''
      ''
      ') as selecao1'
      'group by produto, mes'
      'order by produto, mes desc')
    RequestLive = False
    Left = 33
    Top = 464
    ParamData = <
      item
        DataType = ftString
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'conceitos'
        ParamType = ptUnknown
      end>
    object qryVVendasproduto: TLargeintField
      FieldName = 'produto'
      Required = True
    end
    object qryVVendasmes: TStringField
      FieldName = 'mes'
      Size = 7
    end
    object qryVVendastotalvendas: TFloatField
      FieldName = 'totalvendas'
    end
    object qryVVendasQtContrato: TIntegerField
      FieldName = 'QtContrato'
    end
    object qryVVendasMediaVendasContratos: TFloatField
      FieldKind = fkCalculated
      FieldName = 'MediaVendasContratos'
      Calculated = True
    end
    object qryVVendastotalinternet: TFloatField
      FieldName = 'totalinternet'
    end
    object qryVVendasqtinternet: TIntegerField
      FieldName = 'qtinternet'
    end
    object qryVVendastotalloja: TFloatField
      FieldName = 'totalloja'
    end
    object qryVVendasqtloja: TIntegerField
      FieldName = 'qtloja'
    end
  end
