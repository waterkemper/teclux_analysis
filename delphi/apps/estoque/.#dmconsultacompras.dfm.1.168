  object qryVVendas_Similares_Anterior: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'produtos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'resultadocurvaabc'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      '  select selecao1.produto, '
      '       selecao1.mes,'
      '       selecao1.totalvendas,'
      '       selecao2.qtcontrato,'
      '       '
      '       selecao1.totalinternet,'
      '       selecao2.qtinternet,'
      '       '
      '       selecao1.totalloja,'
      '       selecao2.qtloja'
      '       '
      '       '
      '  from'
      '  ('
      '        SELECT produto,'
      '              SUM(totalvendas) as totalvendas,'
      '              SUM(totalinternet) as totalinternet,'
      '              SUM(totalloja) as totalloja,              '
      '              mes'
      '        FROM'
      '        '
      '  '
      '          ('
      '           SELECT m.produto,'
      
        '                  SUM(CASE WHEN (substr(m.operacao,13,1) = '#39'+'#39') ' +
        'THEN  abs(m.quantidade) ELSE -abs(m.quantidade) END) as totalven' +
        'das,'
      ''
      
        '                  sum(case when (substr(m.operacao,13,1) = '#39'+'#39') ' +
        'THEN           '
      
        '                           (case when p_s.contrato is not null t' +
        'hen abs(m.quantidade) else 0 END) '
      '                      else'
      
        '                           (case when p_s.contrato is not null t' +
        'hen -abs(m.quantidade) else 0 END)'
      '                      end) as totalinternet,'
      '                      '
      
        '                  sum(case when (substr(m.operacao,13,1) = '#39'+'#39') ' +
        'THEN           '
      
        '                           (case when p_s.contrato is null then ' +
        'abs(m.quantidade) else 0 END) '
      '                      else'
      
        '                           (case when p_s.contrato is null then ' +
        '-abs(m.quantidade) else 0 END)'
      '                      end) as totalloja,'
      ''
      
        '                  cast(to_char(m.data,'#39'YYYY/mm'#39') as char(7)) AS ' +
        'mes'
      ''
      ''
      
        '           FROM movimentos m left join pedidos_site p_s on m.con' +
        'trato = p_s.contrato'
      '           where m.produto in  '
      '                ('
      ''
      '                  Select distinct p.codigo'
      '                  from produtos p join caracteristicas c'
      '                                  on p.caracteristica=c.codigo'
      ''
      
        '                                                 where  p.caract' +
        'eristica=c.codigo'
      
        '                                                   and p.codigo ' +
        'in (:similar)'
      ''
      ''
      '                 %produtos'
      ''
      '                 %resultadocurvaabc'
      '                 '
      '                 order by p.codigo'
      ''
      '                 )'
      '                 '
      ''
      
        '           and m.data between (:datainicial) and (cast(:datafina' +
        'l as date) + 1)'
      
        '             and (substr(m.operacao,13,1) = '#39'+'#39' or substr(m.oper' +
        'acao,13,1) = '#39'-'#39')'
      ''
      
        '           GROUP BY m.produto, to_char(m.data,'#39'YYYY/mm'#39'), p_s.co' +
        'ntrato'
      '           order by m.produto, to_char(m.data,'#39'YYYY/mm'#39') desc'
      '          ) as selecao1'
      '         GROUP BY produto, mes'
      '         order by produto, mes desc'
      '          '
      '          '
      '   ) as selecao1  '
      '  '
      '  '
      '    left join'
      ''
      '    ('
      ''
      '          select saldo.produto, saldo.mes,'
      '                 cast(sum(QtContrato) as integer) as QtContrato,'
      '                 cast(sum(QtInternet) as integer) as QtInternet,'
      '                 cast(sum(QtLoja) as integer) as QtLoja'
      ''
      '          from'
      '          ('
      '          select saldo.produto, saldo.contrato, saldo.mes,'
      ''
      
        '                 case when sum(saldo.quantidade) > 0 then 1 else' +
        ' 0 end as QtContrato,'
      
        '                 case when sum(saldo.quantidade) > 0 and p_s.con' +
        'trato is not null then  1 else 0 end as QtInternet,'
      
        '                 case when sum(saldo.quantidade) > 0 and p_s.con' +
        'trato is not null then  0 else 1 end as QtLoja'
      ''
      ''
      '          from'
      '          ('
      ''
      '          ('
      
        '           select m2.produto, m2.contrato, to_char(m2.data,'#39'YYYY' +
        '/mm'#39') as mes, sum(abs(m2.quantidade)) as quantidade'
      '           from movimentos m2 '
      '                join produtos p '
      '                on m2.produto = p.codigo '
      '                '
      '                join caracteristicas c '
      '                on p.caracteristica=c.codigo'
      ''
      ''
      '            where p.codigo = :similar'
      ''
      '            %produtos'
      '            %resultadocurvaabc'
      ''
      
        '           and m2.data between (:datainicial) and (cast(:datafin' +
        'al as date) + 1)'
      '           and (substr(m2.operacao,13,1) = '#39'+'#39')'
      '           and m2.contrato is not null'
      
        '           group by m2.produto, m2.contrato, to_char(m2.data,'#39'YY' +
        'YY/mm'#39')'
      '          )'
      ''
      '          union all'
      ''
      ''
      '          ('
      
        '          select cd.produto, cd.contrato, to_char(cd.devolucao,'#39 +
        'YYYY/mm'#39') as mes, -sum(cd.quantidade) as quantidade'
      
        '          from contratosdevolvidos cd join produtos p on cd.prod' +
        'uto = p.codigo join caracteristicas c on p.caracteristica=c.codi' +
        'go'
      ''
      ''
      '            where cd.situacao='#39'N'#39
      '              and p.codigo = :similar'
      ''
      ''
      '            %produtos'
      '            %resultadocurvaabc'
      ''
      
        '          and cd.devolucao between (:datainicial) and (cast(:dat' +
        'afinal as date) + 1)'
      
        '          group by cd.produto,cd.contrato, to_char(cd.devolucao,' +
        #39'YYYY/mm'#39')'
      '          )'
      
        '          ) as saldo left join pedidos_site p_s on saldo.contrat' +
        'o = p_s.contrato'
      ''
      
        '            group by saldo.produto, saldo.contrato, p_s.contrato' +
        ', saldo.mes'
      ''
      '          ) as saldo'
      ''
      '          group by saldo.produto, saldo.mes'
      ''
      ''
      ''
      '    ) as selecao2'
      ''
      
        #9'on selecao1.produto = selecao2.produto and selecao1.mes = selec' +
        'ao2.mes'
      '  order by produto, mes desc')
