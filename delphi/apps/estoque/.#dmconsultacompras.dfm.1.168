      FieldName = 'sugestao'
    end
    object qryComprasGruposFiliaissugestaominimo: TFloatField
      FieldName = 'sugestaominimo'
      DisplayFormat = '0'
    end
    object qryComprasGruposFiliaismaximo: TFloatField
      FieldName = 'maximo'
      DisplayFormat = '0'
    end
    object qryComprasGruposFiliaissugestaomaximo: TFloatField
      FieldName = 'sugestaomaximo'
      DisplayFormat = '0'
    end
    object qryComprasGruposFiliaisfuturo: TFloatField
