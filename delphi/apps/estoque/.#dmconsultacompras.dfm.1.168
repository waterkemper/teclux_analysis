  object qryComprasGruposFiliais_Similares: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AutoCalcFields = False
    AfterScroll = qryComprasGruposFiliais_SimilaresAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'quantidadeemestoque'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Filiais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'estoques'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'select *,'
      
        '       case when sugestao1 <= 0 then 0 else (cast(ROUND( ( cast(' +
        '(total_vendido) as float) / periodo) * :diasproporcional ) as fl' +
        'oat) - total_estoque - total_pedido + futuro) end as sugestao,'
      ''
      '       cast('
      '       case when coalesce(total_vendido,0)<>0 then'
      
        '         ((emEstoque + case when /*:NaoConsiderarPedidosComprapa' +
        'raDiasEstoque*/ true then 0 else total_pedido end)/'
      '          (Total_vendido / Periodo))'
      '       else'
      '         cast(999999.99 as numeric(11,2))'
      '       end as numeric(12,2)) as diasestoque,'
      ''
      '       cast('
      '       case when coalesce(total_vendido,0)<>0 then'
      
        '         ((total_estoque + case when /*:NaoConsiderarPedidosComp' +
        'raparaDiasEstoque*/ false then 0 else total_pedido end)/'
      '          (Total_vendido / Periodo))'
      '       else'
      '         cast(999999.99 as numeric(11,2))'
      '       end as numeric(12,2)) as diasestoquecompedidosdecompra'
      ''
      ''
      ''
      'from'
      '('
      
        'SELECT *, (cast(ROUND( ( cast(total_vendido as float)/ periodo) ' +
        '* :diasestoque) as float) - total_estoque - total_pedido + futur' +
        'o) AS sugestao1,'
      ''
      '       cast(100 as numeric(6,2)) as PercEstoque'
      'FROM'
      '  ('
      '       SELECT'
      '              fgf.grupo,'
      '              g.mnemonico,'
      '              s.produto,'
      '              s.periodo,'
      '              SUM ( s.estoque ) AS total_estoque,'
      '              SUM ( s.emestoque ) AS emEstoque,'
      ''
      '              SUM ( s.transito ) AS total_transito,'
      '              '
      
        '              SUM ( s.pedido + s.pedidos_filiais) AS total_pedid' +
        'o,'
      '              SUM ( s.pedido ) AS total_pedidos_fornecedores,'
      '              SUM ( s.pedidos_filiais) AS total_pedidos_filiais,'
      '              SUM ( s.vendido ) AS total_vendido,'
      '              CAST(SUM (s.reservado) as float) as reservado,'
      
        '              CAST(SUM (s.reservaprevia) as float) as reservapre' +
        'via,'
      ''
      
        '              CAST(SUM(s.minimo) as float) as minimo, CAST(case ' +
        'when SUM(s.minimo - s.saldo)<0 then 0 else SUM(s.minimo-s.saldo)' +
        ' end as float) as sugestaominimo,'
      
        '              CAST(SUM (s.maximo) as float) as maximo, CAST(case' +
        ' when SUM(s.maximo - s.saldo)<0 then 0 ELSE sum(s.maximo-s.saldo' +
        ') end as float) as sugestaomaximo, cast(sum(s.futuro) as float) ' +
        'as futuro'
      '       FROM'
      '       ('
      '              select e.*,'
      
        '                   coalesce(pedidos_estoquepedido,0) + produtosp' +
        'edidos_recebido_semnotaparcial AS pedido,'
      
        '                   e.estoque + pedidos_estoquepedido - e.futuro ' +
        'as saldo,'
      
        '                   case when e.datacadastro between :inicio and ' +
        ':fim then'
      
        '                                                      case when ' +
        ':fim = e.datacadastro then 1'
      
        '                                                      else :fim ' +
        '- e.datacadastro end'
      '                   else :periodo end as periodo'
      ''
      '              from'
      '              ('
      '              select e.*,'
      '                  case when :NaoConsiderarPedidosCompra then 0'
      
        '                  else produtospedidos_recebido_semnotaparcial(e' +
        '.produto,e.filial) end as produtospedidos_recebido_semnotaparcia' +
        'l'
      ''
      '              FROM'
      '              ('#9
      '              select e.*,'
      '                    case when :NaoConsiderarPedidosCompra then 0'
      
        '                     else pedidos_estoquepedido(e.produto,e.fili' +
        'al) end as pedidos_estoquepedido'
      ''
      '              from'
      '              ('
      '              select e.*,'
      
        '                      movimentos_vendido(:inicio, :fim, e.produt' +
        'o, e.filial) as vendido'
      ''
      '              from'
      ''
      '              ('#9
      ''
      '              select e.*,'
      '                       /*'
      '                       case when not :PedidosEntreFiliais then 0'
      '                       else'
      '                       coalesce((select sum(pf.qtdepedida)'
      '                       from pedidosfiliais pf'
      '                       where pf.produto = e.produto'
      '                       and pf.requisitante = e.filial'
      '                       and pf.situacao = '#39'A'#39'),0) + e.transito'
      '                       end as pedidos_filiais'
      '                       */'
      ''
      '                     case when not :PedidosEntreFiliais then 0'
      '                     else'
      ''
      
        '                       coalesce((select sum(case when pf.situaca' +
        'o = '#39'A'#39' then pf.qtdepedida'
      
        '                                        when pf.situacao = '#39'F'#39' t' +
        'hen 0 end)'
      '                        from pedidosfiliais pf'
      '                        where pf.produto = e.produto'
      '                         and pf.requisitante = e.filial'
      
        '                         and pf.situacao in ('#39'A'#39','#39'F'#39')),0) /*+ e.' +
        'transito*/'
      ''
      '                     end  as pedidos_filiais'
      ''
      ''
      ''
      '              from'
      '              ('
      '              select produtos. *,'
      '                   e.filial,'
      '                       e.datacompra,'
      '                       %quantidadeemestoque  as estoque,'
      '                       e.emestoque,'
      '                       e.futuro,'
      '                       e.transito,'
      '                       e.reservado,'
      '                       e.reservaprevia,'
      '                       coalesce(e.minimo,0) as minimo,'
      '                       coalesce(e.maximo,0) as maximo'
      #9' '
      #9' '
      '              from estoques e join'
      '              ('
      
        '                                       select p.codigo as produt' +
        'o, '
      '                                              p.datacadastro'
      ''
      
        '                                       from ((caracteristicas c ' +
        'join marcas m on c.marca = m.codigo)'
      
        '                                               join produtos p o' +
        'n p.caracteristica = c.codigo)'
      ''
      ''
      ''
      
        '                                       where p.caracteristica = ' +
        'c.codigo'
      '                                         and c.marca = m.codigo'
      '                                         and p.codigo = :similar'
      ''
      ''
      '                                      order by p.codigo'
      ''
      '              ) as produtos on e.produto = produtos.produto'
      '              where true'
      ''
      '                          %Filiais'
      '                          %estoques'
      ''
      '              ) as e'
      '              ) as e'
      '              ) as e'
      '              ) as e'
      '              ) as e'
      ''
      '       ) AS s'
      ''
      '       JOIN (filiaisgruposfiliais fgf'
      '             join gruposfiliais g'
      '             on fgf.grupo = g.codigo)'
      '             on s.filial = fgf.filial'
      ''
      '      GROUP BY s.produto, fgf.grupo, g.mnemonico, s.periodo'
      '   ) AS selecionados'
      ''
      
        '/*where  (total_estoque<>0) or (total_pedido<>0) or (total_vendi' +
        'do<>0)*/'
      ''
      'ORDER BY produto,grupo'
      ') as selecionados')
    RequestLive = False
    Left = 268
    Top = 262
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'diasproporcional'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NaoConsiderarPedidosCompraparaDiasEstoque'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'diasestoque'
        ParamType = ptUnknown
        Value = '30'
      end
      item
        DataType = ftString
        Name = 'inicio'
        ParamType = ptUnknown
        Value = '08/08/2005'
      end
      item
        DataType = ftString
        Name = 'fim'
        ParamType = ptUnknown
        Value = '09/08/2005'
      end
      item
        DataType = ftUnknown
        Name = 'periodo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NaoConsiderarPedidosCompra'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'PedidosEntreFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'similar'
        ParamType = ptUnknown
      end>
    object qryComprasGruposFiliais_Similaresgrupo: TIntegerField
      FieldName = 'grupo'
    end
    object qryComprasGruposFiliais_Similaresproduto: TLargeintField
      FieldName = 'produto'
