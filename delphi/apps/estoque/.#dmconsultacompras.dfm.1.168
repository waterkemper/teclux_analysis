        '                                             , m.data, m.contrat' +
        'o, -pnp.quantidade, pdf.precovenda, pdf.precotabela'
      '                                     FROM'
      '                                               (((movimentos m'
      
        '                                                 join filiaisgru' +
        'posfiliais fgf'
      
