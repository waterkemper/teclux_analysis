        '                                                                ' +
        '                       then 0'
      
        '                                                                ' +
        '                       else abs(m.quantidade)'
      
        '                                                                ' +
        '   END'
      ''
      '                                               as totalloja'
      
        '                                             , m.data, m.contrat' +
        'o, pdf.quantidade, pdf.precovenda, pdf.precotabela'
      '                                     FROM'
      '                                               (((movimentos m'
      
        '                                                  join filiaisgr' +
        'uposfiliais fgf'
      
        '                                                  on m.filial = ' +
        'fgf.filial)'
      ''
      
        '                                                 left join pedid' +
        'os_site p_s'
      
        '                                                 on m.contrato =' +
        ' p_s.contrato)'
      ''
      '                                               join produtos p'
      
        '                                               on m.produto = p.' +
        'codigo), (dadosfiscais fc'
      
        '                                                                ' +
        '    join produtosdadosfiscais pdf'
      
        '                                                                ' +
        '    on fc.numero = pdf.dadofiscal)'
      ''
      '                                     WHERE p.codigo = :similar '
      
        '                                       and m.data between :datai' +
        'nicial and :datafinal'
      ''
      
        '                                               and coalesce(m.co' +
        'mposto,m.produto) = pdf.produto'
      
        '                                               and m.filial = pd' +
        'f.filial'
      
        '                                               AND fc.numero=m.d' +
        'adofiscal'
      
        '                                               AND CASE when :co' +
        'nceitos='#39#39' THEN true ELSE %FILTRO_CONCEITO END'
      
        '                                               and substr(m.oper' +
        'acao,13,1)='#39'+'#39
      '                                     order by'
      '                                               m.produto'
      '                                             , m.data desc'
      ''
      '                               )'
      ''
      '                               union all'
      ''
      '                               ('
      ''
      ''
      '/* ENTRADAS */'
      ''
      '                                     SELECT'
      
        '                                               m.produto, fgf.gr' +
        'upo,'
      
        '                                              -abs(m.quantidade)' +
        ' as totalvendas'
