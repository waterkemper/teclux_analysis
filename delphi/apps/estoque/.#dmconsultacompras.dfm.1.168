  object qryVVendas_porFilial_Anterior: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkFields = 'produto=produto;filial=filial'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrComprasFiliaisGrupo
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'ListadeProdutos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'produtos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'resultadocurvaabc'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      ''
      '/* qryVVendas_porFilial */'
      ''
      '  select selecao1.produto,'
      '         selecao1.filial,'
      '         selecao1.mes,'
      '         selecao1.totalvendas,         '
      '         selecao2.qtcontrato,'
      '         selecao1.totalinternet,'
      '         selecao2.qtinternet,'
      '         selecao1.totalloja,'
      '         selecao2.qtloja'
      '         '
      '  from'
      '  ('
      ''
      '  select selecao1.produto, selecao1.filial, selecao1.mes,'
      '          sum(selecao1.totalvendas) as totalvendas,'
      '          sum(selecao1.totalinternet) as totalinternet,'
      '          sum(selecao1.totalloja) as totalloja'
      ''
      '  from'
      '  ('
      '  '
      
        '  select produto, case when f.tipofilial='#39'V'#39' then f.filial_estoq' +
        'ue else selecao1.filial end as filial,'
      '         mes,totalvendas, totalinternet, totalloja'
      '  from       '
      '   '
      '  ('
      '  '
      '   '
      '  '
      '   SELECT m.produto, m.filial,'
      
        '          SUM(CASE WHEN (substr(m.operacao,13,1) = '#39'+'#39') THEN  ab' +
        's(m.quantidade) ELSE -abs(m.quantidade) END) as totalvendas,'
      '          '
      
        '          sum(case when (substr(m.operacao,13,1) = '#39'+'#39') THEN    ' +
        '       '
      
        '                   (case when p_s.contrato is not null then abs(' +
        'm.quantidade) else 0 END) '
      '              else'
      
        '                   (case when p_s.contrato is not null then -abs' +
        '(m.quantidade) else 0 END)'
      '              end) as totalinternet,'
      '              '
      
        '          sum(case when (substr(m.operacao,13,1) = '#39'+'#39') THEN    ' +
        '       '
      
        '                   (case when p_s.contrato is null then abs(m.qu' +
        'antidade) else 0 END) '
      '              else'
      
        '                   (case when p_s.contrato is null then -abs(m.q' +
        'uantidade) else 0 END)'
      '              end) as totalloja,'
      '          '
      '          cast(to_char(m.data,'#39'YYYY/mm'#39') as char(7)) AS mes'
      ''
      ''
      
        '   FROM movimentos m left join pedidos_site p_s on m.contrato = ' +
        'p_s.contrato'
      '        join'
      '        ('
      ''
      '          Select p.codigo'
      '          from produtos p'
      '          where p.codigo in (%ListadeProdutos)'
      ''
      '          /*'
      '          from ((((caracteristicas c'
      '                      join marcas m'
      '                      on c.marca = m.codigo)'
      ''
      '                     join grupos g'
      '                     on c.grupo = g.codigo)'
      ''
      '                    join classes cl'
      '                    on c.classe = cl.codigo)'
      ''
      '                   join (produtos p'
      '                        left join promocoes pro'
      '                        on p.promocao = pro.codigo)'
      '                   on p.caracteristica = c.codigo)'
      ''
      '         where p.caracteristica = c.codigo'
      '           and c.marca = m.codigo'
      '           and c.grupo = g.codigo'
      '           and c.classe = cl.codigo'
      ''
      '         %produtos'
      '         %resultadocurvaabc'
      ''
      '         */'
      ''
      '         )'
      '         as p on m.produto = p.codigo'
      ''
      
        '   WHERE m.data between (:datainicial) and (cast(:datafinal as d' +
        'ate) + 1)'
      
        '     and (substr(m.operacao,13,1) = '#39'+'#39' or substr(m.operacao,13,' +
        '1) = '#39'-'#39')'
      ''
      
        '   GROUP BY m.filial, m.produto, to_char(m.data,'#39'YYYY/mm'#39'), p_s.' +
        'contrato'
      '   order by m.filial, m.produto, to_char(m.data,'#39'YYYY/mm'#39') desc'
      '   '
      '  ) as selecao1 '
      '       join filiais f'
      '       on selecao1.filial = f.codigo'
      '  '
      '  ) as selecao1'
      '   GROUP BY filial, produto, mes'
      '   order by filial, produto, mes desc'
      '   '
      ''
      ''
      '   '
      '  ) as selecao1'
      '  '
      '    left join'
      '    '
      '    ('
      #9#9'  '
      ''
      '          select saldo.filial, saldo.produto, saldo.mes,  '
      '                 cast(sum(QtContrato) as integer) as QtContrato,'
      '                 cast(sum(QtInternet) as integer) as QtInternet,'
      '                 cast(sum(QtLoja) as integer) as QtLoja'
      '                 '
      '                 '
      '          from'
      '          ('
      
        '          select saldo.filial, saldo.produto, saldo.contrato, sa' +
        'ldo.mes, '
      
        '                 case when sum(saldo.quantidade) > 0 then 1 else' +
        ' 0 end as QtContrato,'
      
        '                 case when sum(saldo.quantidade) > 0 and p_s.con' +
        'trato is not null then 1 else 0 end as QtInternet,'
      
        '                 case when sum(saldo.quantidade) > 0 and p_s.con' +
        'trato is null then 1 else 0 end as QtLoja'
      '                 '
      '          from'
      '          ('
      
        '          select case when f.tipofilial='#39'V'#39' then f.filial_estoqu' +
        'e else saldo.filial end as filial,'
      '                 produto,contrato,mes,quantidade '
      '          '
      '          from '
      '          (          '
      ''
      '          ('
      '          '
      
        '           select m2.filial, m2.produto, m2.contrato, to_char(m2' +
        '.data,'#39'YYYY/mm'#39') as mes, sum(abs(m2.quantidade)) as quantidade'
      ''
      '            from movimentos m2'
      '            /*'
      '                  join ((produtos p'
      '                         left join promocoes pro'
      '                         on p.promocao = pro.codigo)'
      ''
      '                        join (((caracteristicas c'
      '                               join marcas m'
      '                               on c.marca = m.codigo)'
      ''
      '                              join grupos g'
      '                              on c.grupo = g.codigo)'
      ''
      '                             join classes cl'
      '                             on c.classe = cl.codigo)'
      ''
      ''
      '                       on p.caracteristica=c.codigo)'
      '                  on m2.produto = p.codigo)'
      ''
      '             where m2.produto = p.codigo'
      '               and p.caracteristica = c.codigo'
      '               and c.marca = m.codigo'
      '               and c.grupo = g.codigo'
      '               and c.classe = cl.codigo'
      ''
      '            %produtos'
      '            %resultadocurvaabc'
      '            */'
      ''
      '            where m2.produto in (%ListadeProdutos)'
      ''
      
        '           and m2.data between (:datainicial) and (cast(:datafin' +
        'al as date) + 1)'
      '           and (substr(m2.operacao,13,1) = '#39'+'#39')'
      '           and m2.contrato is not null'
      
        '           group by m2.filial, m2.produto, m2.contrato, to_char(' +
        'm2.data,'#39'YYYY/mm'#39')'
      ''
      '          )'
      ''
      '          union all'
      ''
      ''
      '          ('
      
        '          select cd.filial, cd.produto, cd.contrato, to_char(cd.' +
        'devolucao,'#39'YYYY/mm'#39') as mes, -sum(cd.quantidade) as quantidade'
      '          from contratosdevolvidos cd'
      '          /*'
      '              join ((produtos p'
      '                     left join promocoes pro'
      '                     on p.promocao = pro.codigo)'
      ''
      '                    join (((caracteristicas c'
      '                           join marcas m'
      '                           on c.marca = m.codigo)'
      ''
      '                          join grupos g'
      '                          on c.grupo = g.codigo)'
      ''
      '                         join classes cl'
      '                         on c.classe = cl.codigo)'
      ''
      ''
      '                   on p.caracteristica=c.codigo)'
      '              on cd.produto = p.codigo)'
      ''
      '         where cd.produto = p.codigo'
      '           and p.caracteristica = c.codigo'
      '           and c.marca = m.codigo'
      '           and c.grupo = g.codigo'
      '           and c.classe = cl.codigo'
      '           */'
      '         where cd.situacao='#39'N'#39
      '           and cd.produto in (%ListadeProdutos)'
      ''
      '           /*'
      '            %produtos'
      '            %resultadocurvaabc'
      ''
      '            */'
      ''
      
        '          and cd.devolucao between (:datainicial) and (cast(:dat' +
        'afinal as date) + 1)'
      
        '          group by cd.filial, cd.produto,cd.contrato, to_char(cd' +
        '.devolucao,'#39'YYYY/mm'#39')'
      '          )'
      '          ) as saldo join filiais f on saldo.filial = f.codigo'
      ''
      
        '          ) as saldo left join pedidos_site p_s on saldo.contrat' +
        'o = p_s.contrato'
      
        '            group by saldo.filial, saldo.produto, saldo.contrato' +
        ', p_s.contrato, saldo.mes'
      ''
      '          ) as saldo'
      '          group by saldo.filial, saldo.produto, saldo.mes'
      ''
      ''
      ''
      '    ) as selecao2'
      
        #9'on selecao1.filial = selecao2.filial and selecao1.produto = sel' +
        'ecao2.produto and selecao1.mes = selecao2.mes'
      '  order by filial, produto, mes desc')
