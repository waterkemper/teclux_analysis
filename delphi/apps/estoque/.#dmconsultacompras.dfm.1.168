  object qryVVendasDiaria_Detalhada_Totais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryVVendasDiaria_Detalhada_TotaisAfterOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftString
        Name = 'FILTRO_CONCEITO'
        ParamType = ptUnknown
        Value = #39#39
      end
      item
        DataType = ftUnknown
        Name = 'Visualizacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ' select'
      '        cast(null as char(7)) as mes,'
      '       cast(null as date) as data,'
      '       cast(null as bigint) as produto,'
      ''
      '       sum(selecao1.totalvendas) as totalvendas,'
      
        '       cast(sum(case when selecao1.totalvendas > 0 then 1 else 0' +
        ' end) as integer) as qtcontrato,'
      ''
      '       sum(selecao1.totalinternet) as totalinternet,'
      
        '       cast(sum(case when selecao1.totalinternet > 0 then 1 else' +
        ' 0 end) as integer) as qtinternet,'
      ''
      '       sum(selecao1.totalloja) as totalloja,'
      
        '       cast(sum(case when selecao1.totalloja > 0 then 1 else 0 e' +
        'nd) as integer) as qtloja,'
      ''
      '       cast(null as char(20)) as contrato,'
      '       sum(quantidade) as quantidade,'
      ''
      '       cast(null as numeric) as precovenda,'
      '       cast(null as numeric) as precotabela'
      ''
      ''
      ''
      ''
      'from'
      '('
      ''
      ''
      '     SELECT'
      '               produto'
      
        '             , SUM(totalvendas)   as totalvendas                ' +
        '         '
      '             , SUM(totalinternet) as totalinternet'
      '             , SUM(totalloja)     as totalloja'
      
        '             , data, contrato, sum(quantidade) as quantidade, pr' +
        'ecovenda, precotabela'
      '     FROM'
      '               (   '
      '   '
      '                   ('
      ''
      '                   /* SA'#205'DAS */'
      '              '
      '                         SELECT'
      '                                   m.produto'
      
        '                                 , abs(m.quantidade) as totalven' +
        'das,'
      ''
      '                                                       case'
      
        '                                                                ' +
        ' when p_s.contrato is not null'
      
        '                                                                ' +
        '           then abs(m.quantidade)'
      
        '                                                                ' +
        '           else 0'
      '                                                       END'
      '                                   as totalinternet,'
      ''
      ''
      ''
      '                                                       case'
      
        '                                                                ' +
        ' when p_s.contrato is not null'
      
        '                                                                ' +
        '           then 0'
      
        '                                                                ' +
        '           else abs(m.quantidade)'
      '                                                       END'
      ''
      '                                   as totalloja'
      
        '                                 , m.data, m.contrato, pdf.quant' +
        'idade, pdf.precovenda, pdf.precotabela'
      '                         FROM'
      '                                   ((movimentos m'
      '                                   left join'
      '                                             pedidos_site p_s'
      '                                             on'
      
        '                                                       m.contrat' +
        'o = p_s.contrato)'
      ''
      ''
      '                                   join produtos p'
      '                                   on m.produto = p.codigo)'
      ''
      ''
      
        '                                                     , (dadosfis' +
        'cais fc'
      
        '                                                        join pro' +
        'dutosdadosfiscais pdf'
      
        '                                                        on fc.nu' +
        'mero = pdf.dadofiscal)'
      ''
      '                         WHERE p.codigo = :codigoproduto'
      
        '                           and m.data between :datainicial and :' +
        'datafinal'
      ''
      
        '                                   and coalesce(m.composto,m.pro' +
        'duto) = pdf.produto'
      '                                   and m.filial = pdf.filial'
      '                                   AND fc.numero=m.dadofiscal'
      
        '                                   AND CASE when :conceitos='#39#39' T' +
        'HEN true ELSE %FILTRO_CONCEITO END'
      
        '                                   and substr(m.operacao,13,1)='#39 +
        '+'#39
      ''
      '                                   %Visualizacao'
      ''
      '                         order by'
      '                                   m.produto'
      '                                 , m.data desc'
      ''
      '                   )'
      ''
      '                   union all'
      ''
      '                   ('
      ''
      ''
      '/* ENTRADAS */'
      ''
      '                         SELECT'
      '                                   m.produto'
      
        '                                 , -abs(m.quantidade) as totalve' +
        'ndas'
      '                                 ,'
      '                                                       case'
      
        '                                                                ' +
        ' when p_s.contrato is not null'
      
        '                                                                ' +
        '           then -abs(m.quantidade)'
      
        '                                                                ' +
        '           else 0'
      '                                                       END'
      '                                   as totalinternet'
      '                                 , '
      '                                                       case'
      
        '                                                                ' +
        ' when p_s.contrato is not null'
      
        '                                                                ' +
        '           then 0'
      
        '                                                                ' +
        '           else -abs(m.quantidade)'
      '                                                       END'
      '                                   as totalloja'
      
        '                                 , m.data, m.contrato, -pnp.quan' +
        'tidade, pdf.precovenda, pdf.precotabela'
      '                         FROM'
      '                                   ((movimentos m'
      '                                     left join'
      '                                             pedidos_site p_s'
      '                                             on'
      
        '                                                       m.contrat' +
        'o = p_s.contrato)'
      '                                   join produtos p'
      '                                   on m.produto = p.codigo)'
      ''
      
        '                                                     , (notaspag' +
        ' np'
      
        '                                                        join pro' +
        'dutosnotaspag pnp'
      
        '                                                             lef' +
        't join produtosdadosfiscais pdf'
      
        '                                                             on ' +
        'pnp.dadofiscal = pdf.dadofiscal'
      
        '                                                             and' +
        ' pnp.produto = pdf.produto'
      
        '                                                             and' +
        ' pnp.numeroprodutotabela = pdf.numero'
      
        '                                                        on np.co' +
        'digo = pnp.codigonota)'
      
        '                                                                ' +
        '    '
      
        '                                                     , vforneced' +
        'ores fc'
      '                        WHERE p.codigo = :codigoproduto'
      
        '                          and m.data between :datainicial and :d' +
        'atafinal'
      
        '                                   AND np.codigo        =m.codig' +
        'onota'
      
        '                                   AND np.fornecedor    =fc.codi' +
        'go'
      '                                   AND np.tipofornecedor=fc.tipo'
      
        '                                   and coalesce(m.composto,m.pro' +
        'duto) = pnp.produto'
      '                                   and m.filial = pnp.filial'
      
        '                                   AND CASE when :conceitos='#39#39' T' +
        'HEN true ELSE  %FILTRO_CONCEITO  END'
      
        '                                   and substr(m.operacao,13,1) =' +
        #39'-'#39
      ''
      '                                   %Visualizacao'
      '                         order by'
      '                                   m.produto'
      '                                 , m.data desc'
      ''
      ''
      ''
      ''
      '                 )'
      ''
      '               ) as sel'
      '               GROUP BY'
      
        '               sel.produto, sel.data, sel.contrato, sel.precoven' +
        'da, sel.precotabela'
      ''
      '              order by'
      '               sel.produto'
      '             , sel.data desc'
      ''
      ' )  as selecao1'
      ''
      '')
    RequestLive = False
    Left = 672
    Top = 592
    ParamData = <
      item
        DataType = ftLargeint
        Name = 'codigoproduto'
        ParamType = ptUnknown
        Value = '0'
      end
      item
        DataType = ftString
        Name = 'datainicial'
        ParamType = ptUnknown
        Value = '2020-01-01'
      end
      item
        DataType = ftString
        Name = 'datafinal'
        ParamType = ptUnknown
        Value = '2020-01-01'
      end
      item
        DataType = ftString
        Name = 'conceitos'
        ParamType = ptUnknown
        Value = #39#39
      end>
  end
  object dsrVVendasDiaria_Detalhada_Totais: TtecDataSource
    DataSet = qryVVendasDiaria_Detalhada_Totais
    Left = 696
    Top = 616
  end
  object qryVVendas_porGrupo_Anterior: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkFields = 'produto=produto;grupo=grupo'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrComprasGruposFiliais
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'ListadeProdutos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'produtos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'resultadocurvaabc'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      ''
      '/* qryVVendas_porGrupo */'
      ''
      '  select selecao1.produto,'
      '         selecao1.grupo,'
      '         selecao1.mes,'
      '         selecao1.totalvendas,'
      '         selecao2.qtcontrato,'
      '         selecao1.totalinternet,'
      '         selecao2.qtinternet,'
      '         selecao1.totalloja,'
      '         selecao2.qtloja'
      ''
      '  from'
      '  ('
      ''
      '  select selecao1.produto, selecao1.grupo, selecao1.mes,'
      '          sum(selecao1.totalvendas) as totalvendas,'
      '          sum(selecao1.totalinternet) as totalinternet,'
      '          sum(selecao1.totalloja) as totalloja'
      ''
      '  from'
      '  ('
      ''
      '   SELECT m.produto, fgf.grupo,'
      
        '          SUM(CASE WHEN (substr(m.operacao,13,1) = '#39'+'#39') THEN  ab' +
        's(m.quantidade) ELSE -abs(m.quantidade) END) as totalvendas,'
      ''
      '          sum(case when (substr(m.operacao,13,1) = '#39'+'#39') THEN'
      
        '                   (case when p_s.contrato is not null then abs(' +
        'm.quantidade) else 0 END)'
      '              else'
      
        '                   (case when p_s.contrato is not null then -abs' +
        '(m.quantidade) else 0 END)'
      '              end) as totalinternet,'
      ''
      '          sum(case when (substr(m.operacao,13,1) = '#39'+'#39') THEN'
      
        '                   (case when p_s.contrato is null then abs(m.qu' +
        'antidade) else 0 END)'
      '              else'
      
        '                   (case when p_s.contrato is null then -abs(m.q' +
        'uantidade) else 0 END)'
      '              end) as totalloja,'
      ''
      '          cast(to_char(m.data,'#39'YYYY/mm'#39') as char(7)) AS mes'
      ''
      ''
      
        '   FROM movimentos m left join pedidos_site p_s on m.contrato = ' +
        'p_s.contrato'
      '        join'
      '        ('
      ''
      '          Select p.codigo'
      '          from produtos p'
      '          where p.codigo in (%ListadeProdutos)'
      '          order by p.codigo'
      ''
      '          /*'
      ''
      '          from ((((caracteristicas c'
      '                      join marcas m'
      '                      on c.marca = m.codigo)'
      ''
      '                     join grupos g'
      '                     on c.grupo = g.codigo)'
      ''
      '                    join classes cl'
      '                    on c.classe = cl.codigo)'
      ''
      '                   join (produtos p'
      '                        left join promocoes pro'
      '                        on p.promocao = pro.codigo)'
      '                   on p.caracteristica = c.codigo)'
      ''
      '         where p.caracteristica = c.codigo'
      '           and c.marca = m.codigo'
      '           and c.grupo = g.codigo'
      '           and c.classe = cl.codigo'
      ''
      '         %produtos'
      ''
      '         %resultadocurvaabc'
      ''
      '         */'
      ''
      '         )'
      '         as p on m.produto = p.codigo'
      ''
      '        join filiaisgruposfiliais fgf'
      '        on m.filial = fgf.filial'
      ''
      ''
      
        '   WHERE m.data between (:datainicial) and (cast(:datafinal as d' +
        'ate) + 1)'
      
        '     and (substr(m.operacao,13,1) = '#39'+'#39' or substr(m.operacao,13,' +
        '1) = '#39'-'#39')'
      ''
      
        '   GROUP BY fgf.grupo, m.produto, to_char(m.data,'#39'YYYY/mm'#39'), p_s' +
        '.contrato'
      '   order by fgf.grupo, m.produto, to_char(m.data,'#39'YYYY/mm'#39') desc'
      ''
      '  ) as selecao1'
      '   GROUP BY grupo, produto, mes'
      '   order by grupo, produto, mes desc'
      ''
      '  ) as selecao1'
      ''
      '    left join'
      '    ('
      ''
      ''
      '          select saldo.grupo, saldo.produto, saldo.mes,'
      '                 cast(sum(QtContrato) as integer) as QtContrato,'
      '                 cast(sum(QtInternet) as integer) as QtInternet,'
      '                 cast(sum(QtLoja) as integer) as QtLoja'
      ''
      '          from'
      '          ('
      
        '          select saldo.grupo, saldo.produto, saldo.contrato, sal' +
        'do.mes,'
      ''
      
        '                 case when sum(saldo.quantidade) > 0 then 1 else' +
        ' 0 end as QtContrato,'
      
        '                 case when sum(saldo.quantidade) > 0 and p_s.con' +
        'trato is not null then 1 else 0 end as QtInternet,'
      
        '                 case when sum(saldo.quantidade) > 0 and p_s.con' +
        'trato is null then 1 else 0 end as QtLoja'
      ''
      ''
      '          from'
      '          ('
      ''
      '          ('
      
        '           select fgf.grupo, m2.produto, m2.contrato, to_char(m2' +
        '.data,'#39'YYYY/mm'#39') as mes, sum(abs(m2.quantidade)) as quantidade'
      ''
      '            from (movimentos m2'
      '            /*'
      '                  join ((produtos p'
      '                         left join promocoes pro'
      '                         on p.promocao = pro.codigo)'
      ''
      '                        join (((caracteristicas c'
      '                               join marcas m'
      '                               on c.marca = m.codigo)'
      ''
      '                              join grupos g'
      '                              on c.grupo = g.codigo)'
      ''
      '                             join classes cl'
      '                             on c.classe = cl.codigo)'
      ''
      ''
      '                       on p.caracteristica=c.codigo)'
      '                  on m2.produto = p.codigo)'
      '                  */'
      ''
      '                 join filiaisgruposfiliais fgf'
      '                 on m2.filial = fgf.filial)'
      ''
      '                 /*'
      '             where m2.produto = p.codigo'
      '               and p.caracteristica = c.codigo'
      '               and c.marca = m.codigo'
      '               and c.grupo = g.codigo'
      '               and c.classe = cl.codigo'
      ''
      ''
      '            %produtos'
      '            %resultadocurvaabc'
      '            */'
      ''
      '            where m2.produto in (%ListadeProdutos)'
      ''
      
        '           and m2.data between (:datainicial) and (cast(:datafin' +
        'al as date) + 1)'
      '           and (substr(m2.operacao,13,1) = '#39'+'#39')'
      '           and m2.contrato is not null'
      
        '           group by fgf.grupo, m2.produto, m2.contrato, to_char(' +
        'm2.data,'#39'YYYY/mm'#39')'
      '          )'
      ''
      '          union all'
      ''
      ''
      '          ('
      
        '          select fgf.grupo, cd.produto, cd.contrato, to_char(cd.' +
        'devolucao,'#39'YYYY/mm'#39') as mes, -sum(cd.quantidade) as quantidade'
      ''
      '          from (contratosdevolvidos cd'
      ''
      '          /*'
      '                  join ((produtos p'
      '                         left join promocoes pro'
      '                         on p.promocao = pro.codigo)'
      ''
      '                        join (((caracteristicas c'
      '                               join marcas m'
      '                               on c.marca = m.codigo)'
      ''
      '                              join grupos g'
      '                              on c.grupo = g.codigo)'
      ''
      '                             join classes cl'
      '                             on c.classe = cl.codigo)'
      ''
      ''
      '                       on p.caracteristica=c.codigo)'
      '                  on cd.produto = p.codigo)'
      ''
      '                  */'
      ''
      '                 join filiaisgruposfiliais fgf'
      '                  on cd.filial = fgf.filial)'
      ''
      '                  /*'
      '         where cd.produto = p.codigo'
      '           and p.caracteristica = c.codigo'
      '           and c.marca = m.codigo'
      '           and c.grupo = g.codigo'
      '           and c.classe = cl.codigo'
      '           */'
      '         where cd.produto in (%ListadeProdutos)'
      '           and cd.situacao='#39'N'#39
      ''
      '           /*'
      '            %produtos'
      '            %resultadocurvaabc'
      ''
      '            */'
      ''
      
        '          and cd.devolucao between (:datainicial) and (cast(:dat' +
        'afinal as date) + 1)'
      
        '          group by fgf.grupo, cd.produto,cd.contrato, to_char(cd' +
        '.devolucao,'#39'YYYY/mm'#39')'
      '          )'
      
        '          ) as saldo left join pedidos_site p_s on saldo.contrat' +
        'o = p_s.contrato'
      ''
      
        '            group by saldo.grupo, saldo.produto, saldo.contrato,' +
        ' p_s.contrato, saldo.mes'
      ''
      
        '          ) as saldo group by saldo.grupo, saldo.produto, saldo.' +
        'mes'
      ''
      ''
      ''
      '    ) as selecao2'
      
        #9'on selecao1.grupo = selecao2.grupo and selecao1.produto = selec' +
        'ao2.produto and selecao1.mes = selecao2.mes'
      '  order by grupo, produto, mes desc')
