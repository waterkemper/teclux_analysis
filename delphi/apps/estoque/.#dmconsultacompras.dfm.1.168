  end
  object qryDetalhesCompra: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'produto=produto'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrComprasTotal
    Constraints = <>
    OnCalcFields = qryDetalhesCompraCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'CondicaoListaFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListadeProdutos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'estoques'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'produtos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'resultadocurvaabc'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '/* qryDetalhesCompra */'
      ''
      'SELECT'
      '   e.produto,'
      '   e.datacompra,'
      '   e.precoCOMicms,'
      '   e.precoSEMicms,'
      '   e.qtdecompra,'
      '   e.aliquotaipi,'
      '   e.valorultimacompra,'
      '   e.filial,'
      '   p.datacadastro,'
      ''
      '   cast('
      '    coalesce('
      '    ('
      '    select sum(e1.financeiro) /'
      '           sum(e1.emestoque +'
      '               e1.reservado +'
      '               e1.reservaprevia +'
      '               e1.transito +'
      '               e1.demonstracao +'
      '               e1.conserto +'
      '               e1.danificada)'
      ''
      '    from estoques e1'
      '    where e1.produto = e.produto'
      
        '      and (e1.emestoque+e1.reservado+e1.reservaprevia+e1.transit' +
        'o+e1.demonstracao+e1.conserto+e1.danificada) <> 0'
      '      and e1.financeiro<>0'
      '      %CondicaoListaFiliais'
      '   ),0.00) as numeric(11,2)) as customedio,'
      ''
      ''
      
        '   cast(case when ((e.emestoque+e.reservado+e.reservaprevia+e.tr' +
        'ansito+e.demonstracao+e.conserto+e.danificada) = 0) or'
      '                   (coalesce(e.financeiro,0)=0) or'
      '                   (coalesce(cpn.valor,0)=0) then 0'
      
        '                    else ROUND( (cpn.valor / ( e.financeiro / (e' +
        '.emestoque+e.reservado+e.reservaprevia+e.transito+e.demonstracao' +
        '+e.conserto+e.danificada)) - 1) * 100,2)'
      '            end as numeric(15,2)) AS markup,'
      ''
      ''
      
        '  (SELECT pr.descricao FROM precos pr WHERE pr.caracteristica = ' +
        'p.caracteristica AND pr.codigo = p.preco) AS descricaopreco'
      ''
      ''
      'FROM estoques e join produtos p on e.produto = p.codigo'
      ''
      '          /*'
      
        '    join (produtos p left join promocoes pro on p.promocao = pro' +
        '.codigo)'
      '         join caracteristicas c'
      '              join marcas m'
      '              on c.marca = m.codigo'
      ''
      '              join grupos g'
      '              on c.grupo = g.codigo'
      ''
      '              join classes cl'
      '              on c.classe = cl.codigo'
      ''
      '         on p.caracteristica = c.codigo'
      ''
      '    on e.produto = p.codigo'
      '    */'
      ''
      '    join filiais f'
      '    on e.filial = f.codigo'
      ''
      '    join colunasprecos cpn           /* pre'#231'o normal */'
      '      on cpn.caracteristica = p.caracteristica'
      '     AND cpn.preco = p.preco'
      '     AND cpn.coluna = f.preconormal'
      ''
      'where e.produto in (%ListadeProdutos)'
      '/*    e.produto = p.codigo'
      ' and p.caracteristica = c.codigo'
      ' and c.marca = m.codigo */'
      ' and e.filial = f.codigo'
      ''
      ' and cpn.caracteristica = p.caracteristica'
      ' AND cpn.preco = p.preco'
      ' AND cpn.coluna = f.preconormal'
      ' AND e.datacompra IS NOT NULL'
      
        '/* AND (e.datacompra)=(select max(e1.datacompra) from estoques e' +
        '1 where e1.produto=e.produto)*/'
      ' and (e.produto,e.filial) in (select e1.produto, e1.filial'
      '                              from estoques e1'
      '                              where e1.qtdecompra is not null'
      '                                and e1.produto = e.produto'
      '                              order by e1.datacompra desc,'
      
        '                              (e1.emestoque+e1.reservado+e1.tran' +
        'sito+e1.reservaprevia+e1.conserto+e1.danificada+e1.demonstracao)' +
        ' DESC'
      '                              limit 1)'
      ' AND e.precocomicms is not null'
      ''
      '%estoques'
      ''
      '/*'
      '%produtos'
      '%resultadocurvaabc'
      ''
      '*/'
      ''
      'order by e.produto, e.datacompra desc')
    RequestLive = False
    Left = 33
    Top = 381
