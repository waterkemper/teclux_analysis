procedure TdtmConsultaCompras.qryComprasFiliaisGrupoCalcFields(
  DataSet: TDataSet);
begin
  inherited;
       {
  if qryComprasFiliaisGrupototal_vendido.AsCurrency<>0 then
    qryComprasFiliaisGrupodiasestoque.AsCurrency := ((qryComprasFiliaisGrupototal_estoque.AsCurrency + qryComprasFiliaisGrupototal_pedidos_filiais.AsCurrency)/
