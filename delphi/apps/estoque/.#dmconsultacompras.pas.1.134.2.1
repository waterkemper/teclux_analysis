procedure TdtmConsultaCompras.PreencherRequisicaoFilialSolicitada(
  FilialSolicitada: Integer);
var
 vPosition : double;
 vTotalqtPedida : Double;
begin
  try
    qryPedidosFiliais.GuardarRegistroAtual(true);
    qryComprasTotal.mastersource := nil;

    vTotalqtPedida := 0;
    vTotalAtendido := 0;

    qryPedidosFiliais.first;
    while not qryPedidosFiliais.eof do
    begin

      vPosition :=  (qryPedidosFiliais.RecNo * 100) / qryPedidosFiliais.recordcount;
      TAdvSmoothProgressBar(self.owner.FindComponent('AdvSmoothProgressBar1')).Position := vPosition;
      Application.ProcessMessages;

      if (FilialSolicitada = qryPedidosFiliaisfilial.Asinteger) and
         (qryPedidosFiliaisfilial.Asinteger <> qryPedidosFiliaisrequisitante.Asinteger) and
         (qryPedidosFiliaisqtdepedida.AsCurrency <> qryPedidosFiliaisquantidade.AsCurrency)
          then
      begin
        if qryPedidosFiliaisquantidade.AsCurrency > qryPedidosFiliaisemestoque.AsCurrency then
        begin

          qryPedidosFiliais.readonly := false;
          
          qryPedidosFiliais.edit;
          qryPedidosFiliaisqtdepedida.AsCurrency := qryPedidosFiliaisquantidade.AsCurrency;
          qryPedidosFiliais.enablecontrols;

          TDBAdvGrid(self.owner.findcomponent('dbgPedidosFiliais_')).row := qryPedidosFiliais.recno;
          application.processmessages;

          MensagemErro(format('O produto %s possui uma quantidade que excede à existente na filial requisitada %s!',
            [QuotedStr(qryPedidosFiliaisprodutovisual.asString), quotedstr(qryPedidosFiliaisfilial.asString)]));

          qryPedidosFiliais.disablecontrols;
          qryPedidosFiliais.readonly := false;
          qryPedidosFiliais.edit;
          qryPedidosFiliaisqtdepedida.clear;

        end
        else
        begin
          qryPedidosFiliais.readonly := false;
          qryPedidosFiliais.edit;
          qryPedidosFiliaisqtdepedida.AsCurrency := qryPedidosFiliaisquantidade.AsCurrency;
          if qryPedidosFiliais.state = dsedit then
            qryPedidosFiliais.post;
        end;
      end;

      if (qryPedidosFiliaisrequisitante.Asinteger <> qryPedidosFiliaisfilial.Asinteger) then
        vTotalqtPedida := vTotalqtPedida + qryPedidosFiliaisqtdepedida.AsCurrency;

      if (qryPedidosFiliaisrequisitante.Asinteger = qryPedidosFiliaisfilial.Asinteger) then
      begin
        qryPedidosFiliais.readonly := false;
        qryPedidosFiliais.edit;
        qryPedidosFiliaisqtdepedida.AsCurrency := vTotalqtPedida;
        if qryPedidosFiliais.state = dsedit then
          qryPedidosFiliais.post;

        vTotalAtendido := vTotalAtendido + vTotalqtPedida;
        vTotalqtPedida := 0;
      end;

      qryPedidosFiliais.next;
    end;

  finally
    qryComprasTotal.mastersource := dsrPedidosFiliais;
    qryPedidosFiliais.VoltarRegistro;
  end;

end;

procedure TdtmConsultaCompras.RetirarRequisicaoFilialSolicitada(
  FilialSolicitada: Integer);
var
 vTotalqtPedida : Double;
 vPosition : Double;

begin
  try
    qryPedidosFiliais.GuardarRegistroAtual(true);
    qryComprasTotal.mastersource := nil;

    qryPedidosFiliais.first;

    vTotalqtPedida := 0;
    vTotalAtendido := 0;

    while not qryPedidosFiliais.eof do
    begin

      vPosition :=  (qryPedidosFiliais.RecNo * 100) / qryPedidosFiliais.recordcount;
      TAdvSmoothProgressBar(self.owner.FindComponent('AdvSmoothProgressBar1')).Position := vPosition;
      Application.ProcessMessages;

      if ((FilialSolicitada = qryPedidosFiliaisfilial.Asinteger) or  (FilialSolicitada = 0)) and
         (qryPedidosFiliaisfilial.Asinteger <> qryPedidosFiliaisrequisitante.Asinteger) then
      begin
      
        qryPedidosFiliais.readonly := false;
        qryPedidosFiliais.edit;
        qryPedidosFiliaisqtdepedida.clear;

        if qryPedidosFiliais.state = dsedit then
          qryPedidosFiliais.post;

      end;

      if (qryPedidosFiliaisrequisitante.Asinteger <> qryPedidosFiliaisfilial.Asinteger) then
        vTotalqtPedida := vTotalqtPedida + qryPedidosFiliaisqtdepedida.AsCurrency;

      if (qryPedidosFiliaisrequisitante.Asinteger = qryPedidosFiliaisfilial.Asinteger) then
      begin
        qryPedidosFiliais.readonly := false;
        qryPedidosFiliais.edit;
        qryPedidosFiliaisqtdepedida.AsCurrency := vTotalqtPedida;
        if qryPedidosFiliais.state = dsedit then
          qryPedidosFiliais.post;

        vTotalAtendido := vTotalAtendido + vTotalqtPedida;
        vTotalqtPedida := 0;
      end;

      qryPedidosFiliais.next;

    end;
  finally
    qryComprasTotal.mastersource := dsrPedidosFiliais;
    qryPedidosFiliais.VoltarRegistro;

  end;
end;

