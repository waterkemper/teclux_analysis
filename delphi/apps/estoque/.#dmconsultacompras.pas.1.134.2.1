function TdtmConsultaCompras.VerificarEstoqueFilialRequisitada(
           FilialRequisitada, mnemonico : String;
          { UsarFilialGeral,}
           ChecarEstoqueFilialSolicitada: boolean): boolean;
var
  vQuantidadeEstoque: Currency;
  vRegistroAtual : Tbookmark;
  vExisteDiferencaSaldoEstoque : Boolean;
  vLista : String;
begin
  vTotalAtendido := 0;

  if (qryPedidosFiliais.state in [dsinsert, dsedit]) then
    qryPedidosFiliais.post;

  result := qryPedidosFiliais.recordcount <> 0;
  if result then
  begin
    vExisteDiferencaSaldoEstoque  := false;
    qryEstoques.Close;
             {
    if usarfilialgeral then
      qryEstoques.MacroByName('Condicao').AsString := ' and f.codigo = ' + FilialRequisitada + ' and e.produto in ('+
        RetornarLista(qryPedidosFiliais, qryPedidosFiliaisproduto) + ')'
    else
    }
     vLista := RetornarLista(qryPedidosFiliais, [qryPedidosFiliaisproduto, qryPedidosFiliaisfilial], nil) + ')';

      qryEstoques.MacroByName('Condicao').AsString := ' and (e.produto, e.filial) in ('+
        RetornarLista(qryPedidosFiliais, [qryPedidosFiliaisproduto, qryPedidosFiliaisfilial], nil) + ')';

    qryEstoques.Open;

//    ExisteAlgumEstoquenaFilialRequisitada := false;
    vRegistroAtual := qryComprasTotal.GetBookmark;
    GuardarRegistroAtual(qryPedidosFiliais,True);
  //  qryComprasTotal.DisableControls;
  //  qryComprasGruposFiliais.DisableControls;
  //  qryComprasFiliaisGrupo.DisableControls;

    try
      qryPedidosFiliais.First;
      while not qryPedidosFiliais.Eof do
      begin

      {
        qryPedidosFiliais.Edit;
        qryPedidosFiliaisemestoque.clear;
        qryPedidosFiliais.post;
        }

        if {(usarfilialgeral and
            qryEstoques.Locate('produto', qryPedidosFiliaisproduto.AsString, [])) or}

           ({not usarfilialgeral and  }
            qryEstoques.Locate('produto;filial', VarArrayOf([qryPedidosFiliaisproduto.AsString, qryPedidosFiliaisfilial.asinteger]), [])) then

        begin

          if qryPedidosFiliaisemestoque.AsCurrency <> qryEstoquesemestoque.AsCurrency then
          begin
            qryPedidosFiliais.readonly := false;

            qryPedidosFiliais.Edit;
            qryPedidosFiliaisemestoque.AsCurrency := qryEstoquesemestoque.AsCurrency;

  //          if not ChecarEstoqueFilialSolicitada then
  //            qryPedidosFiliaisqtdeestoqueanterior.AsCurrency := qryEstoquesemestoque.AsCurrency;

  {
            if usarfilialgeral then
            begin
              qryPedidosFiliaisfilial.AsString := FilialRequisitada;
              qryPedidosFiliaismnemonico.asString := mnemonico;
            end;
            }

            qryPedidosFiliais.post;
          end;

          if qryPedidosFiliaisrequisitante.asinteger <> qryPedidosFiliaisfilial.asinteger then
            vTotalAtendido := vTotalAtendido + qryPedidosFiliaisqtdepedida.asCurrency;

          if ChecarEstoqueFilialSolicitada and
             (qryPedidosFiliaisemestoque.AsCurrency <> qryPedidosFiliaisemestoqueanterior.AsCurrency) then
               vExisteDiferencaSaldoEstoque  := true;

//          ExisteAlgumEstoquenaFilialRequisitada := true;
        end
        else
          MensagemAviso(format('O produto %s não esta presente na filial requisitada %s.',
            [qryPedidosFiliaisprodutovisual.AsString,
              qryPedidosFiliaisfilial.asString]));

        qryPedidosFiliais.Next;
      end;

      if vExisteDiferencaSaldoEstoque then
      begin
         if assigned(drawGridPedidosFiliais) then
            drawGridPedidosFiliais(nil);

         result := MensagemConfirmacao('Existem diferenças no saldo do estoque de alguns produtos.') = smbOk;
      end;

    finally

      VoltarRegistroAtual(qryPedidosFiliais);
      qryComprasTotal.GotoBookmark(vRegistroAtual);
      qryComprasTotal.FreeBookmark(vRegistroAtual);
  //    qryComprasTotal.EnableControls;
  //    qryComprasGruposFiliais.EnableControls;
  //    qryComprasFiliaisGrupo.EnableControls;
    end;
  end;

end;


function TdtmConsultaCompras.IncluirPedidosFiliais: boolean;
var
 DadosFilial : TVariantArray;
 FilialEstoque : String;
 vRetornoMensagem : TMessageButton;
 vRegistrosGravados : boolean;
 vProdutos_e_Filiais_Pedidos : String;
 vProdutos_Pedidos : String;
 vposition : Double;

begin
  try
    if qryPedidosFiliais.State = dsEdit then
      qryPedidosFiliais.post;

    GuardarRegistroAtual(qryPedidosFiliais, true);
    qryComprasTotal.mastersource := nil;

    vRegistrosGravados := false;
    result := true;

    {Se o pedido já existir e estiver em aberto: acrescentar qtde ao pedido}

    vProdutos_e_Filiais_Pedidos := RetornarLista(qryPedidosFiliais, [qryPedidosFiliaisproduto, qryPedidosFiliaisfilial], qryPedidosFiliaisIrParaLista);
    vProdutos_Pedidos := '';

    if qryMovimentos.Active then
    begin
      qryMovimentos.close;
      qryMovimentos.open;
    end;


    qryAtualizarPedidosFiliais.Close;
    qryAtualizarPedidosFiliais.MacroByName('ListadeProdutosFilialRequisitada').AsString := vProdutos_e_Filiais_Pedidos;
    qryAtualizarPedidosFiliais.parambyname('Requisitante').AsString := FilialRequisitante;
    qryAtualizarPedidosFiliais.open;


    qryPedidosFiliais.First;

    while not qryPedidosFiliais.Eof do
    begin

      vPosition :=  (qryPedidosFiliais.RecNo * 100) / qryPedidosFiliais.recordcount;
      TAdvSmoothProgressBar(self.owner.FindComponent('AdvSmoothProgressBar1')).Position := vPosition;
      Application.ProcessMessages;


      IF (qryPedidosFiliaisqtdepedida.AsCurrency > 0) and
         (qryPedidosFiliaisrequisitante.asinteger <> qryPedidosFiliaisfilial.asinteger) THEN
      BEGIN
        result := true;

        if not parsistema.Permitir_Requisicoes_de_Produtos_Duplicadas and

           qryAtualizarPedidosFiliais.Locate('produto;requisitada',
           VarArrayOf([qryPedidosFiliaisproduto.asstring,
                       qryPedidosFiliaisfilial.asstring]), []) then
        begin

          vRetornoMensagem := smbYES;

          if qryAtualizarPedidosFiliaisqtdepedida.AsCurrency = qryPedidosFiliaisqtdepedida.AsCurrency then
            vRetornoMensagem := MensagemSelecionaOpcao(
                                  format('A quantidade requisitada para a filial ''%s'' e produto ''%s'' ficará com quantidade dobrada.',
                                         [qryPedidosFiliaisfilial.asstring,
                                          qryPedidosFiliaisprodutovisual.asstring]));


          case vRetornoMensagem of
          smbYES: begin
                    result := true;
                    qryAtualizarPedidosFiliais.Edit;
                    qryAtualizarPedidosFiliaisqtdepedida.AsCurrency := qryAtualizarPedidosFiliaisqtdepedida.AsCurrency + qryPedidosFiliaisqtdepedida.AsCurrency {qryPedidosFiliaisqtdeAtendida.AsCurrency};
                    qryAtualizarPedidosFiliaisdata.AsDateTime := DataServidor;
                    qryAtualizarPedidosFiliaishora.AsDateTime := HoraServidor;

                    if qryPedidosFiliaisobservacao.asString<>'' then
                    begin
                      if qryAtualizarPedidosFiliaisobservacao.asString <> '' then
                        qryAtualizarPedidosFiliaisobservacao.asString := qryAtualizarPedidosFiliaisobservacao.asString + ' ';

                      qryAtualizarPedidosFiliaisobservacao.asString := qryAtualizarPedidosFiliaisobservacao.asString +
                                                                       qryPedidosFiliaisobservacao.asString;
                    end;
                    qryAtualizarPedidosFiliais.post;
                    vRegistrosGravados := true;
                    vProdutos_Pedidos := vProdutos_Pedidos + qryPedidosFiliaisproduto.AsString+', ';
                  end;

          smbNo: result := false;
          smbCancel : begin
                        result := false;
                        vProdutos_Pedidos := '';
                        exit;
                      end;
          end;
        end
        else
        begin
          result := true;
          qryAtualizarPedidosFiliais.Append;
          spcPedidosTransferenciaProximoCodigo.Open;
          qryAtualizarPedidosFiliaiscodigo.AsInteger:= spcPedidosTransferenciaProximoCodigonumero.AsInteger;
          spcPedidosTransferenciaProximoCodigo.Close;
          qryAtualizarPedidosFiliaisproduto.asstring := qryPedidosFiliaisproduto.AsString;
          qryAtualizarPedidosFiliaisdata.asdatetime := DataServidor;
          qryAtualizarPedidosFiliaishora.AsDateTime := HoraServidor;
          qryAtualizarPedidosFiliaisrequisitante.AsString := FilialRequisitante;
          qryAtualizarPedidosFiliaisrequisitada.asstring := qryPedidosFiliaisfilial.asstring;
          qryAtualizarPedidosFiliaisqtdepedida.AsCurrency := qryPedidosFiliaisqtdepedida.AsCurrency {qryPedidosFiliaisqtdeAtendida.AsCurrency};
          qryAtualizarPedidosFiliaissituacao.asstring := 'A';
          qryAtualizarPedidosFiliaisobservacao.asVAriant := qryPedidosFiliaisobservacao.asVariant;

          qryAtualizarPedidosFiliais.post;
          vProdutos_Pedidos := vProdutos_Pedidos + qryPedidosFiliaisproduto.AsString+', ';
          vRegistrosGravados := true;

        end;

        if result then
        begin
          if (ParSistema.RequisicaoSubtraiEstoque) then
          begin
            if not qryMovimentos.Active then
              qryMovimentos.Open;

            qryEstoqueBloqueio.Sql[05] := '((e.produto = ' + qryAtualizarPedidosFiliaisproduto.AsString + ')and' +
                                    '(e.filial = '   + qryAtualizarPedidosFiliaisrequisitada.asstring  + '))';
            qryEstoqueBloqueio.Open;

            qryMovimentos.Append;

            (*
            spcMovimentosProximo.Open;
            qryMovimentosnumero.AsInteger := spcMovimentosProximonumero.AsInteger;
            spcMovimentosProximo.Close;
            *)

            qryMovimentosproduto.AsLargeInt   := qryAtualizarPedidosFiliaisproduto.AsLargeInt;

            DadosFilial := ValorCampodaTabela('filiais', ['codigo'], [qryAtualizarPedidosFiliaisrequisitada.asstring], ['tipofilial', 'filial_estoque']);


            if DadosFilial[1]<>null then
              FilialEstoque := DadosFilial[1];

            if (DadosFilial[0]='V') and (DadosFilial[1]=Null) then
              FilialEstoque := qryAtualizarPedidosFiliaisrequisitada.asstring
            else
            if (DadosFilial[0]<>'V') then
              FilialEstoque := qryAtualizarPedidosFiliaisrequisitada.asstring;

            //qryMovimentosfilial.AsVariant    := qryAtualizarPedidosFiliaisrequisitada.AsVariant;
            qryMovimentosfilial.AsVariant    := StrToInt(FilialEstoque);
            qryMovimentosreferencia.AsString :='REQUISIÇÃO ' + qryAtualizarPedidosFiliaiscodigo.AsString;
            qryMovimentosquantidade.Ascurrency := qryPedidosFiliaisqtdepedida.AsCurrency {qryPedidosFiliaisqtdeAtendida.AsCurrency};
            qryMovimentostipomovimento.AsString:='TEP';
            qryMovimentos.Post;

          end;

        end;


      END;

      qryPedidosFiliais.next;
    end;

  finally

    VoltarRegistroAtual(qryPedidosFiliais);
    qryComprasTotal.mastersource := dsrPedidosFiliais;

    if vRegistrosGravados  then
    begin
      try

      result := Perpetrar([qryAtualizarPedidosFiliais,qryMovimentos]);

      finally
        if result then
        begin
          requisicoesgeradas := true;
          MensagemAviso('Requisições geradas com sucesso.');
        end;

        qryEstoqueBloqueio.close;
        delete(vProdutos_Pedidos, length(vProdutos_Pedidos)-1, 2);
        Reatualizar(vProdutos_Pedidos);
      end;  


    end
    else
    begin
      requisicoesgeradas := false;
      MensagemAviso('Nenhuma Requisição foi gerada.');
      result := false;
    end;

  end;

end;

