  try
    if not assigned(dtmRequisicaoExposicao) then
      dtmRequisicaoExposicao:= TdtmRequisicaoExposicao.create(self);

    dtmRequisicaoExposicao.qryPedidosFiliais.BeforeOpen := nil;
    dtmRequisicaoExposicao.qrypedidosfiliais.parambyname('requisitante').asinteger := qryListaPedidosFiliais_Requisitanterequisitante.asinteger;
    dtmRequisicaoExposicao.qrypedidosfiliais.parambyname('codigo').asinteger := qryListaPedidosFiliais_Requisitantecodigo.asinteger;
    dtmRequisicaoExposicao.qrypedidosfiliais.close;
    dtmRequisicaoExposicao.qrypedidosfiliais.open;

    if dtmRequisicaoExposicao.ExcluirPedidosTransferencia then
    begin
      abrirListaPedidosFiliais;
      Reatualizar(qrycomprastotalproduto.asString);

    end;

  finally
//    dtmRequisicaoExposicao.free;
  end;
end;

