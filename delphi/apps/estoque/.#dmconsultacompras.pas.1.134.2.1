       (qryProdutosSimilarestotal_estoque.AsFloat +
        qryProdutosSimilarestotal_pedido.AsFloat +
        qryProdutosSimilaressugestao.AsFloat) /
        (qryProdutosSimilarestotal_vendido.AsFloat / qryProdutosSimilaresperiodo.AsInteger);

  end
  else
  begin
    qryProdutosSimilaresdiasEstoqueCalculado.asFloat := 999999.99;
    qryProdutosSimilaresdiasEstCalcPedCompra.asFloat := 999999.99
  end;


end;

procedure TdtmConsultaCompras.CalcularTotalAtendido(CalcularProduto: Boolean = false);
var
  vTotalProdutoAtendido : Double;
  v_recno : integer;
begin
  try
    qrycomprastotal.mastersource := nil;
    qryPedidosFiliais.afterscroll := nil;

    qryPedidosFiliais.disablecontrols;

    v_recno := qryPedidosFiliais.recno;
    vTotalAtendido := SomarValores(qryPedidosFiliais, [qryPedidosFiliaisqtdepedida], [qryPedidosFiliaisfilial], [filialrequisitante], ['<>']);
    qryPedidosFiliais.enablecontrols;

    qryPedidosFiliais.recno := v_recno;

    if CalcularProduto then
    begin
      dsrPedidosFiliais.onDataChange := nil;

      qryPedidosFiliais.GuardarRegistroAtual(true);

      vTotalProdutoAtendido := SomarValores(qryPedidosFiliais,
                                            [qryPedidosFiliaisqtdepedida],
                                            [qryPedidosFiliaisfilial, qryPedidosFiliaisproduto],
                                            [filialrequisitante, qryPedidosFiliaisproduto.asString], ['<>','=']);

      qryPedidosFiliais.readonly := false;
      AtribuirDados(qryPedidosFiliais,
                     [qryPedidosFiliaisqtdepedida],
                     [vTotalProdutoAtendido],
                     [qryPedidosFiliaisfilial, qryPedidosFiliaisproduto],
                     [filialrequisitante, qryPedidosFiliaisproduto.asString], ['=','=']);

      dsrPedidosFiliais.onDataChange := dsrPedidosFiliaisDataChange;
      qryPedidosFiliais.VoltarRegistro;
    end;
  finally

    qryPedidosFiliais.afterscroll := qryPedidosFiliaisafterscroll;
    qryComprasTotal.mastersource := dsrPedidosFiliais;
  end;

end;

procedure TdtmConsultaCompras.MontarFiltroFiliaissemEstoque(
  Usar: TCheckListBox);
var
  STRFiliais: String;
  cnt: Integer;
begin
  TodasFiliaissemEstoque := True;
  STRFiliais := '';

  for cnt := 0 to FListaFiliais.Count - 1 do
    if Usar.Checked[cnt] then
      STRFiliais := STRFiliais + '''' + IntToStr(Integer(FListaFiliais.Objects[cnt])) + ''','
    else
      TodasFiliaissemEstoque := False;

  STRFiliais := Copy(STRFiliais, 0, Length(STrFiliais) - 1);
  FilialsemEstoque := STRFiliais;
  if Trim(STRFiliais) <> '' then
    if not TodasFiliaissemEstoque then
      FParametroCabecalho := FParametroCabecalho+' Filiais sem Estoque: '+STRFiliais
    else FilialsemEstoque := '';

  if (Trim(STRFiliais) = '') then
    TodasFiliaissemEstoque := true;
end;

