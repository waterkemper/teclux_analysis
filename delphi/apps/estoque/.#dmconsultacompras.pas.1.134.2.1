procedure TdtmConsultaCompras.dsrComprasTotalDataChange(Sender: TObject;
  Field: TField);
begin
  inherited;
  if Field = qryComprasTotallembrarpedido   then
  begin
      qryAtualizarProduto.parambyname('lembrarpedido').asBoolean := Field.asBoolean;
      qryAtualizarProduto.parambyname('datalembrarpedido').asDateTime := datahoraservidor;
      qryAtualizarProduto.parambyname('usuariolembrarpedido').asInteger := usuariologin.CodigoUsuario;
      qryAtualizarProduto.parambyname('codigo').asString := qryComprasTotalproduto.asString;
      qryAtualizarProduto.execSQL;
      perpetrar([qryAtualizarProduto]);

  end
  else
  if Field = qryComprasTotalobslembrarpedido   then
  begin
      qryAtualizarObsProduto.parambyname('obslembrarpedido').asString := qryComprasTotalobslembrarpedido.asString;
      qryAtualizarObsProduto.parambyname('codigo').asString := qryComprasTotalproduto.asString;
      qryAtualizarObsProduto.execSQL;
      perpetrar([qryAtualizarObsProduto]);
  end
  else

  if (Field = qryComprasTotalminimo) or (Field = qryComprasTotalmaximo) then
  begin

      if qryComprasTotalmaximo.isnull then
        qryAtualizarEstoque.ParamByName('maximo').Clear
      else
        qryAtualizarEstoque.ParamByName('maximo').asCurrency := qryComprasTotalmaximo.asCurrency;

      if qryComprasTotalminimo.isnull then
        qryAtualizarEstoque.ParamByName('minimo').Clear
      else
        qryAtualizarEstoque.ParamByName('minimo').asCurrency := qryComprasTotalminimo.asCurrency;

      qryAtualizarEstoque.ParamByName('produto').asString := qryComprasTotalproduto.AsString;
      qryAtualizarEstoque.ParamByName('filial').AsString := somentenumero(Filial);

      qryAtualizarEstoque.ExecSql;
      perpetrar([qryAtualizarEstoque]);


  end
  else
  if field = qryComprasTotalsugestao then
  begin
    try
//      qryComprasTotal.onCalcFields := nil;
//      dsrComprasTotal.onDataChange := nil;

      if (qryComprasTotalsugestao.AsCurrency > 0) and
         not (qryComprasTotalselecionado.asBoolean) then
         SelecionarProdutos(true, False)
      else
      if (qryComprasTotalsugestao.AsCurrency <= 0) and
         (qryComprasTotalselecionado.asBoolean) then
        SelecionarProdutos(false, False)
    finally
//      qryComprasTotal.onCalcFields := qryComprasTotalCalcFields;
//      dsrComprasTotal.onDataChange := dsrComprasTotalDataChange;
      AdicionarRetirarProdutoMarcado;
    end;
  end
  else
  if field = qryComprasTotalselecionado then
     AdicionarRetirarProdutoMarcado
     
end;

