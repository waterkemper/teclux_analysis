procedure TdtmConsultaCompras.dsrProdutosSimilaresDataChange(
  Sender: TObject; Field: TField);
begin
  inherited;
  if (Field = qryProdutosSimilaresminimo) or (Field = qryProdutosSimilaresmaximo) then
  begin

      if qryProdutosSimilaresmaximo.isnull then
        qryAtualizarEstoque.ParamByName('maximo').Clear
      else
        qryAtualizarEstoque.ParamByName('maximo').asCurrency := qryProdutosSimilaresmaximo.asCurrency;

      if qryProdutosSimilaresminimo.isnull then
        qryAtualizarEstoque.ParamByName('minimo').Clear
      else
        qryAtualizarEstoque.ParamByName('minimo').asCurrency := qryProdutosSimilaresminimo.asCurrency;

      qryAtualizarEstoque.ParamByName('produto').asString := qryProdutosSimilaresproduto.AsString;
      qryAtualizarEstoque.ParamByName('filial').AsString := somentenumero(Filial);

      qryAtualizarEstoque.ExecSql;
      perpetrar([qryAtualizarEstoque]);

      if qryProdutosSimilaresPrincipal.asBoolean then
      begin
        dsrComprasTotal.onDataChange := nil;
        qryComprasTotal.edit;
        qryComprasTotalmaximo.value := qryProdutosSimilaresmaximo.value;
        qryComprasTotalminimo.value := qryProdutosSimilaresminimo.value;
        qryComprasTotal.post;
        dsrComprasTotal.onDataChange := dsrComprasTotalDataChange; 
      end;


  end;
end;

