procedure TdtmConsultaCompras.AbrirVendasDiarias;
var
 vVisualizacao : String;
begin

  if PesquisaVisualizada <> Produtos then
  begin
    case Visualizacao of
      0: vVisualizacao := '';
      1: vVisualizacao := format(' and m.filial in (select fgf.filial from filiaisgruposfiliais fgf where fgf.grupo = %s) ', [qryComprasGruposFiliais_Similaresgrupo.asString]);
      2: vVisualizacao := format(' and m.filial = %s ', [qryComprasFiliaisGrupo_Similaresfilial.asString]);
    end;
  end
  else
  begin
    case Visualizacao of
      0: vVisualizacao := '';
      1: vVisualizacao := format(' and m.filial in (select fgf.filial from filiaisgruposfiliais fgf where fgf.grupo = %s) ', [qryComprasGruposFiliaisgrupo.asString]);
      2: vVisualizacao := format(' and m.filial = %s ', [qryComprasFiliaisGrupofilial.asString]);
    end;
  end;

  qryVVendasDiaria_Detalhada.params := qryVVendasDiaria.params;
  qryVVendasDiaria_Detalhada.macros := qryVVendasDiaria.macros;
  qryVVendasDiaria_Detalhada.macrobyName('Visualizacao').asString := vVisualizacao;

  qryVVendasDiaria_Detalhada_Totais.params := qryVVendasDiaria.params;
  qryVVendasDiaria_Detalhada_Totais.macros := qryVVendasDiaria.macros;
  qryVVendasDiaria_Detalhada_Totais.macrobyName('Visualizacao').asString := vVisualizacao;

  if PesquisaVisualizada = Produtos then
  begin
    qryVVendasDiaria_Detalhada.paramByName('codigoproduto').asString := qryComprasTotalproduto.asString;
    qryVVendasDiaria_Detalhada_Totais.paramByName('codigoproduto').asString := qryComprasTotalproduto.asString;
  end
  else
  if PesquisaVisualizada = Similares then
  begin
    qryVVendasDiaria_Detalhada.paramByName('codigoproduto').asString := qryProdutosSimilaresproduto.asString;
    qryVVendasDiaria_Detalhada_Totais.paramByName('codigoproduto').asString := qryProdutosSimilaresproduto.asString;
  end
  else
  if PesquisaVisualizada = Grades then
  begin
    qryVVendasDiaria_Detalhada.paramByName('codigoproduto').asString := qryProdutosGradesproduto.asString;
    qryVVendasDiaria_Detalhada_Totais.paramByName('codigoproduto').asString := qryProdutosGradesproduto.asString;
  end;

  qryVVendasDiaria_Detalhada.close;
  qryVVendasDiaria_Detalhada.open;

  qryVVendasDiaria_Detalhada_Totais.close;
  qryVVendasDiaria_Detalhada_Totais.open;

end;

procedure TdtmConsultaCompras.Reatualizar(vListaProdutos: String);
var
 vrecno: integer;

begin
  try

    DesligarEventos;

    if qryComprasTotal.mastersource <> nil then
    begin
      qrycomprastotal.GuardarRegistroAtual(false);
      qryComprasTotal.mastersource := nil;
      qryComprasTotal.VoltarRegistro;
    end;

    qrycomprastotal.GuardarRegistroAtual(true);
    qryComprasGruposFiliais.GuardarRegistroAtual(true);
    qryComprasFiliaisGrupo.GuardarRegistroAtual(true);

    {
    qryComprasGruposFiliais.mastersource := nil;
    qryComprasFiliaisGrupo.mastersource := nil;
    }

    self.dsrComprasTotal.onDataChange := nil;

    dtmconsultacompras_.qryComprasTotal.sql.text := self.qryComprasTotal.sql.text;
    dtmconsultacompras_.qryComprasTotal.macros := self.qryComprasTotal.macros;
    dtmconsultacompras_.qryComprasTotal.params := self.qryComprasTotal.params;

    dtmconsultacompras_.qryComprasTotal.Macrobyname('FiliaisEstoque').asstring := '';
    dtmconsultacompras_.qryComprasTotal.MacroByName('estoques').AsString := '';


    dtmconsultacompras_.qryTotalProdutosSimilares.sql.text := self.qryTotalProdutosSimilares.sql.text;
    dtmconsultacompras_.qryTotalProdutosSimilares.macros := self.qryTotalProdutosSimilares.macros;
    dtmconsultacompras_.qryTotalProdutosSimilares.params := self.qryTotalProdutosSimilares.params;

    dtmconsultacompras_.qryComprasGruposFiliais.sql.text := self.qryComprasGruposFiliais.sql.text;
    dtmconsultacompras_.qryComprasGruposFiliais.macros := self.qryComprasGruposFiliais.macros;
    dtmconsultacompras_.qryComprasGruposFiliais.params := self.qryComprasGruposFiliais.params;

    dtmconsultacompras_.qryComprasFiliaisGrupo.sql.text := self.qryComprasFiliaisGrupo.sql.text;
    dtmconsultacompras_.qryComprasFiliaisGrupo.macros := self.qryComprasFiliaisGrupo.macros;
    dtmconsultacompras_.qryComprasFiliaisGrupo.params := self.qryComprasFiliaisGrupo.params;

    dtmconsultacompras_.qryComprasTotal.MacroByName('produtos').AsString :=
      dtmconsultacompras_.qryComprasTotal.MacroByName('produtos').AsString +
       ' and p.codigo in (' + vListaProdutos + ')';

    dtmconsultacompras_.qryComprasTotal.MacroByName('sugestao2').AsString :='Where (sugestao2 >= 0 or (sugestaominimo>0 or sugestaomaximo>0))';
    dtmconsultacompras_.qryComprasTotal.MacroByName('sugestao8').AsString :='Where (sugestao >= 0 or (sugestaominimo>0 or sugestaomaximo>0))';

    dtmconsultacompras_.qryTotalProdutosSimilares.MacroByName('ListadeProdutos').AsString := vListaProdutos;

    dtmconsultacompras_.qryComprasGruposFiliais.MacroByName('produtos').AsString :=
       dtmconsultacompras_.qryComprasGruposFiliais.MacroByName('produtos').AsString +
       ' and p.codigo in (' + vListaProdutos + ')';

    dtmconsultacompras_.qryComprasFiliaisGrupo.MacroByName('produtos').AsString :=
       dtmconsultacompras_.qryComprasFiliaisGrupo.MacroByName('produtos').AsString +
       ' and p.codigo in (' + vListaProdutos + ')';

    dtmconsultacompras_.qryComprasTotal.close;
    dtmconsultacompras_.qryTotalProdutosSimilares.close;

    dtmconsultacompras_.qryComprasGruposFiliais.close;
    dtmconsultacompras_.qryComprasFiliaisGrupo.close;

    dtmconsultacompras_.qryTotalProdutosSimilares.open;
    
    dtmconsultacompras_.desligareventos;
    dtmconsultacompras_.qryComprasTotal.open;

//    dtmconsultacompras_.qryComprasGruposFiliais.mastersource := nil;
//    dtmconsultacompras_.qryComprasGruposFiliais.AfterScroll := nil;
    dtmconsultacompras_.qryComprasGruposFiliais.open;
//    dtmconsultacompras_.qryComprasGruposFiliais.mastersource := dtmconsultacompras_.dsrComprasTotal;

//    dtmconsultacompras_.qryComprasFiliaisGrupo.mastersource := nil;
    dtmconsultacompras_.qryComprasFiliaisGrupo.open;
////    dtmconsultacompras_.qryComprasFiliaisGrupo.mastersource := dtmconsultacompras_.dsrComprasGruposFiliais;

    dtmconsultacompras_.qryComprasTotal.first;

    while not dtmconsultacompras_.qryComprasTotal.eof do
    begin
      if self.qryComprasTotal.locate('produto', dtmconsultacompras_.qryComprasTotalproduto.asstring, []) then
      begin

        CopiaRegistrosporNome(dtmconsultacompras_.qryComprasTotal, self.qryComprasTotal, false, false, false, true, true, true);

        if self.qryprodutosselecionados.locate('produto', dtmconsultacompras_.qryComprasTotalproduto.asstring, []) then
          self.qryprodutosselecionados.delete;

         {
        if ListadeProdutosMarcados.IndexOf(self.qryComprasTotalproduto.asString)<>-1 then
          ListadeProdutosMarcados.Delete(ListadeProdutosMarcados.IndexOf(self.qryComprasTotalproduto.asString));
          }


        if self.qryTotalProdutosSimilares.locate('produtosml', dtmconsultacompras_.qryComprasTotalproduto.asstring, []) then
          CopiaRegistrosporNome(dtmconsultacompras_.qryTotalProdutosSimilares, self.qryTotalProdutosSimilares, false, false, false, true, true, true);

        dtmconsultacompras_.qryComprasGruposFiliais.first;
        while not dtmconsultacompras_.qryComprasGruposFiliais.eof do
        begin

          if self.qryComprasGruposFiliais.locate('produto;grupo',
               VarArrayOf([
               dtmconsultacompras_.qryComprasGruposFiliaisproduto.asString,
               dtmconsultacompras_.qryComprasGruposFiliaisgrupo.asString]),[]) then
          begin
            vrecno := dtmconsultacompras_.qryComprasGruposFiliais.recno;
            CopiaRegistrosporNome(dtmconsultacompras_.qryComprasGruposFiliais, self.qryComprasGruposFiliais, false, false, false, true, true, true);
            dtmconsultacompras_.qryComprasGruposFiliais.recno := vrecno;

            dtmconsultacompras_.qryComprasFiliaisGrupo.first;
            while not dtmconsultacompras_.qryComprasFiliaisGrupo.eof do
            begin
              if self.qryComprasFiliaisGrupo.locate('produto;grupo;filial',
                   VarArrayOf([
                   dtmconsultacompras_.qryComprasFiliaisGrupoproduto.asString,
                   dtmconsultacompras_.qryComprasFiliaisGrupogrupo.asString,
                   dtmconsultacompras_.qryComprasFiliaisGrupofilial.asString]),[]) then
              begin
                vrecno := dtmconsultacompras_.qryComprasFiliaisGrupo.recno;
                CopiaRegistrosporNome(dtmconsultacompras_.qryComprasFiliaisGrupo, self.qryComprasFiliaisGrupo, false, false, false, true, true, true);
                dtmconsultacompras_.qryComprasFiliaisGrupo.recno := vrecno;
              end;


              dtmconsultacompras_.qryComprasFiliaisGrupo.next;
            end;
          end;
          dtmconsultacompras_.qryComprasGruposFiliais.next;
        end;
      end;
      dtmconsultacompras_.qryComprasTotal.next
    end;


  finally
    qrycomprastotal.VoltarRegistro;
    qryComprasGruposFiliais.VoltarRegistro;
    qryComprasFiliaisGrupo.VoltarRegistro;

//    qryComprasGruposFiliais.mastersource := dsrComprasTotal;
//    qryComprasFiliaisGrupo.mastersource := dsrComprasGruposFiliais;


    self.dsrComprasTotal.onDataChange := self.dsrComprasTotalDataChange;

//    dtmconsultacompras_.free;
//    dtmconsultacompras_ := nil;

    ligarEventos;
  end;

end;

