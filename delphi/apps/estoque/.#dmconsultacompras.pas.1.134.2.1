procedure TdtmConsultaCompras.RefazConsultaProdutosSimilares(SomenteTotais: Boolean);
begin

    if FParametroOrdenacao = 1 then
      qryProdutosSimilares.MacroByName('ORDERBY').AsString := 'ORDER BY UPPER(TO_ASCII(nomeproduto,''LATIN1'')), valorgrade1, valorgrade2, produtovisual'
    else
      qryProdutosSimilares.MacroByName('ORDERBY').AsString := 'ORDER BY produtovisual, UPPER(TO_ASCII(nomeproduto,''LATIN1'')), valorgrade1, valorgrade2';

    qryProdutosSimilares.MacroByName('Filiais').AsString := qryComprasTotal.MacroByName('Filiais').AsString;

    if not somentetotais then
      ReFazConsultaporNome(qryProdutosSimilares,['produto','PedidosEntreFiliais',
                           'NaoConsiderarPedidosCompra',
                           'inicio','fim', 'periodo', 'diasproporcional',
                           'diasestoque', 'filialbase'],
                         [qryComprasTotalproduto.AsString,
                          PedidosEntreFiliais,
                          NaoConsiderarPedidosCompra,
                          FParametroDataInicial,
                          FParametroDataFinal,
                          GetPeriodo,
                          FParametroDiasEstoqueProporcional,
                          FParametroDiasEstoque,
                          filialbase
                          ]);

    qryTotalProdutosSimilares.MacroByName('ListadeProdutos').AsString := vListadeProdutos;
    qryTotalProdutosSimilares.MacroByName('Filiais').AsString := qryComprasTotal.MacroByName('Filiais').AsString;

    if somentetotais and (vListadeProdutos<>'') then
      ReFazConsultaporNome(qryTotalProdutosSimilares,['PedidosEntreFiliais',
                                                    'NaoConsiderarPedidosCompra',
                                                    'inicio','fim', 'periodo',
                                                    'diasproporcional',
                                                    'diasestoque'],
                       [PedidosEntreFiliais,
                        NaoConsiderarPedidosCompra,
                        FParametroDataInicial,
                        FParametroDataFinal,
                        GetPeriodo,
                        FParametroDiasEstoqueProporcional,
                        FParametroDiasEstoque
                        ]);



  if qryComprasFiliaisGrupo_Similares.active then
    qryComprasFiliaisGrupo_Similares.locate('filial', qryComprasFiliaisGrupofilial.AsInteger, []);

end;

