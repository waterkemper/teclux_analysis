procedure TdtmConsultaCompras.dsrPedidosFiliaisDataChange(Sender: TObject;
  Field: TField);
begin
  inherited;
  if not qryPedidosFiliais.readonly then
  begin
    if field = qryPedidosFiliaisqtdepedida then
    begin
      if field.ascurrency > qryPedidosFiliaisemestoque.ascurrency then
      begin

        MensagemErro(format('O produto %s possui uma quantidade que excede à existente na filial requisitada %s!',
          [QuotedStr(qryPedidosFiliaisprodutovisual.asString),
           quotedstr(qryPedidosFiliaisfilial.asString)]));

//        dsrPedidosFiliais_.onDataChange := nil;
        field.clear;

        if assigned(AfterPostPedidosFiliais) then
          AfterPostPedidosFiliais(Sender);

//        field.focuscontrol;
//        dsrPedidosFiliais_.onDataChange := dsrPedidosFiliais_DataChange;
      end
      else
      begin

        CalcularTotalAtendido(true);
        if assigned(AfterPostPedidosFiliais) then
          AfterPostPedidosFiliais(Sender);

      end;
    end
    else
    if field = qryPedidosFiliaisobservacao then
    begin
      try
        dsrPedidosFiliais.ondatachange := nil;
        qryPedidosFiliais.GuardarRegistroAtual(true);

        AtribuirDados(qryPedidosFiliais,
                      [qryPedidosFiliaisobservacao],
                      [qryPedidosFiliaisobservacao.AsVariant],
                      [qryPedidosFiliaisproduto, qryPedidosFiliaisfilial, qryPedidosFiliaisobservacao ],
                      [qryPedidosFiliaisproduto.asvariant, filialrequisitante, Null],
                      ['=','<>','=']);
      finally
        dsrPedidosFiliais.ondatachange := dsrPedidosFiliaisdatachange;
        qryPedidosFiliais.VoltarRegistro;
      end;


    end;

  end;

end;

procedure TdtmConsultaCompras.qryPedidosFiliaisCalcFields(
  DataSet: TDataSet);
begin
  inherited;

  if qryPedidosFiliaisfilial.asinteger = qryPedidosFiliaisrequisitante.asinteger then
    qryPedidosFiliaisdescricaoprodutoaux.asString := 'TOTAL FILIAL REQUISITANTE:'
  else
    qryPedidosFiliaisdescricaoprodutoaux.asString := qryPedidosFiliaisdescricaoproduto.asString;

  qryPedidosFiliaisIrParaLista.asBoolean :=
          (qryPedidosFiliaisrequisitante.asinteger <>
           qryPedidosFiliaisfilial.asinteger) and
          (qryPedidosFiliaisqtdepedida.ascurrency <> 0);


  if qryPedidosFiliaistotalfiliaisemestoque.AsCurrency >= qryPedidosFiliaisquantidade.AsCurrency then
    qryPedidosFiliaisqtdeAtendida.AsCurrency := qryPedidosFiliaisquantidade.AsCurrency
  else
    qryPedidosFiliaisqtdeAtendida.AsCurrency := qryPedidosFiliaistotalfiliaisemestoque.AsCurrency;


  if (qryPedidosFiliaistotal_vendido.asFloat <> 0) and
     (qryPedidosFiliaisperiodo.AsInteger <> 0) then
  begin
    if qryPedidosFiliaisrequisitante.asinteger = qryPedidosFiliaisfilial.asinteger then
    begin
      qryPedidosFiliaisdiasestoquecalculado.asFloat :=
           (qryPedidosFiliaistotal_estoque.AsFloat +
  {          qryPedidosFiliaistotal_pedido.AsFloat +  ver com JR }
{            qryPedidosFiliaissugestao.AsFloat +}
            qryPedidosFiliaisqtdepedida.asFloat
            ) /
            (qryPedidosFiliaistotal_vendido.AsFloat / qryPedidosFiliaisperiodo.AsInteger);

        qryPedidosFiliaisdiasEstCalcPedCompra.asFloat :=
           (qryPedidosFiliaistotal_estoque.AsFloat +
            qryPedidosFiliaistotal_pedido.AsFloat +
{            qryPedidosFiliaissugestao.AsFloat +}
            qryPedidosFiliaisqtdepedida.asFloat
            ) /
            (qryPedidosFiliaistotal_vendido.AsFloat / qryPedidosFiliaisperiodo.AsInteger);

    end
    else
    begin
      qryPedidosFiliaisdiasestoquecalculado.asFloat :=
           (qryPedidosFiliaistotal_estoque.AsFloat {
  {          qryPedidosFiliaistotal_pedido.AsFloat +  ver com JR }
  {          qryPedidosFiliaissugestao.AsFloat } -
            qryPedidosFiliaisqtdepedida.asFloat
            ) /
            (qryPedidosFiliaistotal_vendido.AsFloat / qryPedidosFiliaisperiodo.AsInteger);

      qryPedidosFiliaisdiasEstCalcPedCompra.asFloat :=
           (qryPedidosFiliaistotal_estoque.AsFloat +
            qryPedidosFiliaistotal_pedido.AsFloat {+
            qryPedidosFiliaissugestao.AsFloat } -
            qryPedidosFiliaisqtdepedida.asFloat
            ) /
            (qryPedidosFiliaistotal_vendido.AsFloat / qryPedidosFiliaisperiodo.AsInteger);
    end;
  end
  else
  begin
    qryPedidosFiliaisdiasestoquecalculado.asFloat := 999999.99;
    qryPedidosFiliaisdiasEstCalcPedCompra.asFloat := 999999.99;
  end;

end;

