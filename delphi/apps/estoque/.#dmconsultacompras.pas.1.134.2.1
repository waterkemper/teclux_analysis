                                              DaysBetween(strtoDateTime(ParametroDataInicial), StrToDateTime(ParametroDataFinal))))
  else
    qryComprasFiliaisGrupodiasestoque.clear;
       }

  if qryComprasGruposFiliaistotal_estoque.AsFloat <> 0 then
    qryComprasFiliaisGrupopercestoque.AsFloat := qryComprasFiliaisGrupototal_estoque.AsFloat * 100  / qryComprasGruposFiliaistotal_estoque.AsFloat
  else
    qryComprasFiliaisGrupopercestoque.AsFloat := 0;

  if qryComprasFiliaisGrupototal_vendido.asFloat <> 0 then
  begin
      qryComprasFiliaisGrupodiasEstoqueCalculado.asFloat :=
         (qryComprasFiliaisGrupototal_estoque.AsFloat +
{         (qryComprasFiliaisGrupoemEstoque.AsFloat +}

  {        qryComprasFiliaisGrupototal_pedido.AsFloat +  ver com JR }
          qryComprasFiliaisGruposugestao.AsFloat) /
          (qryComprasFiliaisGrupototal_vendido.AsFloat / qryComprasFiliaisGrupoperiodo.AsInteger);

      qryComprasFiliaisGrupodiasEstCalcPedCompra.asFloat :=
         (qryComprasFiliaisGrupototal_estoque.AsFloat +
          qryComprasFiliaisGrupototal_pedido.AsFloat +
          qryComprasFiliaisGruposugestao.AsFloat) /
          (qryComprasFiliaisGrupototal_vendido.AsFloat / qryComprasFiliaisGrupoperiodo.AsInteger);
  end
  else
  begin
    qryComprasFiliaisGrupodiasEstoqueCalculado.asFloat := 999999.99;
    qryComprasFiliaisGrupodiasEstCalcPedCompra.asFloat := 999999.99;
  end;


end;

function TdtmConsultaCompras.GerarDadosRequisicoes(SomenteRegistroAtual: Boolean): Boolean;
var
  vPosition : Double;
  vtotalfiliaisemestoque : Currency;
  vRecnoFilialRequisitante : integer;
  ListadeProdutosCompostos : String;
begin

  try

    DesligarEventos;

    TtecDBGrid(self.owner.FindComponent('dbgProdutos')).SalvarPosicaoGrid;
    TtecDBGrid(self.owner.FindComponent('dbgProdutosGrupos')).SalvarPosicaoGrid;
    TtecDBGrid(self.owner.FindComponent('dbgProdutosFiliais')).SalvarPosicaoGrid;

    result := true;

    requisicoesgeradas := false;
    if SomenteRegistroAtual then
    begin
      if not parsistema.Transferir_Produtos_Compostos then
      begin
        if qryComprasTotalcomposto.asBoolean then
          ListadeProdutosCompostos := qryComprasTotalProduto.asstring+ ', '
        else
        begin
          ListadeProdutosRequisitados := qryComprasTotalProduto.asstring;
          if qryComprasTotalsugestao.asstring = '' then
            ListadeQuantidadesRequisitadas := '0'
          else
            ListadeQuantidadesRequisitadas := qryComprasTotalsugestao.asstring;
        end;
      end
      else
      begin
        ListadeProdutosRequisitados := qryComprasTotalProduto.asstring;
        if qryComprasTotalsugestao.asstring = '' then
          ListadeQuantidadesRequisitadas := '0'
        else
          ListadeQuantidadesRequisitadas := qryComprasTotalsugestao.asstring;
      end;
    end
    else
    begin
      if not parsistema.Transferir_Produtos_Compostos then
      begin

        ListadeProdutosCompostos := '';
        ListadeProdutosRequisitados := '';
        ListadeQuantidadesRequisitadas := '';

        qryprodutosselecionados.first;
        while not qryprodutosselecionados.eof do
        begin
          if qryProdutosSelecionadoscomposto.asBoolean then

            ListadeProdutosCompostos := ListadeProdutosCompostos +
              qryProdutosSelecionadosproduto.asString + ', '

          else
          begin
            ListadeProdutosRequisitados := ListadeProdutosRequisitados +
              qryProdutosSelecionadosproduto.asString + ', ';

            ListadeQuantidadesRequisitadas := ListadeQuantidadesRequisitadas +
              qryProdutosSelecionadosquantidade.asString + ', ';
          end;

          qryprodutosselecionados.next;
        end;

      end
      else
      begin
        ListadeProdutosRequisitados := RetornarLista(qryprodutosselecionados, qryProdutosSelecionadosproduto, nil, false);
        ListadeQuantidadesRequisitadas := RetornarLista(qryprodutosselecionados, qryProdutosSelecionadosquantidade, nil, false);
      end;
    end;

    if not parsistema.Transferir_Produtos_Compostos then
    begin
      if ListadeProdutosCompostos<>'' then
      begin
        delete(ListadeProdutosCompostos,length(ListadeProdutosCompostos)-1, 2);
        qryListaProdutos.MacroByName('ListaProdutos').asString := ListadeProdutosCompostos;
        qryListaProdutos.close;
        qryListaProdutos.open;

        frmMensagemGrid := TfrmMensagemGrid.Create(frmMensagemGrid);
        frmMensagemGrid.Caption := 'Mensagem de aviso';
        frmMensagemGrid.lblTitulo.Caption := 'PRODUTOS COMPOSTOS REQUISITADOS';
        frmMensagemGrid.lblTExto.Caption := 'Produtos compostos não podem ser selecionados para trasnferência, '+chr(13)+'Verifique o parâmetro ''Transferir Produtos Compostos'' ';
        frmMensagemGrid.dbgMensagem.DataSource := dsrListaProdutos;
        frmMensagemGrid.ShowModal;
        frmMensagemGrid.Free;

      end;
    end;

    result := ListadeProdutosRequisitados <> '';

    if result then
    begin

      qryPedidosFiliais.params := qryComprasFiliaisGrupo.params;
      qryPedidosFiliais.macros := qryComprasFiliaisGrupo.macros;
      qryPedidosFiliais.macrobyname('produtos').asString :=
        qryPedidosFiliais.macrobyname('produtos').asString + ' and p.codigo in (' +
          ListadeProdutosRequisitados + ')';

      qryPedidosFiliais.parambyname('requisitante').asString := FilialRequisitante;
      qryPedidosFiliais.macrobyname('ArrayProduto').asString := ListadeProdutosRequisitados;
      qryPedidosFiliais.macrobyname('ArrayQuantidade').asString := ListadeQuantidadesRequisitadas;

      qryPedidosFiliais.close;
      qryPedidosFiliais.open;

      qryComprasTotal.linkFields := 'produto=produto';
      qryComprasTotal.mastersource := dsrPedidosFiliais;
    end;

  finally
    LigarEventos;
  end;

end;

