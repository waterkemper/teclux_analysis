procedure TdtmConsultaCompras.SelecionarProdutos(Marcar, Todos: Boolean);
begin
  if qryComprasTotal.Active then
  begin
    if Todos then
    begin
      try
        DesligarEventos;
        GuardarRegistroAtual(qryComprasTotal,true);
        qryComprasTotal.First;
        while not qryComprasTotal.Eof do
        begin
          qryComprasTotal.Edit;
          qryComprasTotalselecionado.Asboolean:= Marcar;
          qryComprasTotal.Post;

          AdicionarRetirarProdutoMarcado;

          qryComprasTotal.Next;
        end;
      finally
        VoltarRegistroAtual(qryComprasTotal);
        LigarEventos;
      end;
    end
    else
    begin
//      GuardarRegistroAtual(qryComprasTotal,True);

      try

//        qryComprasTotal.oncalcFields := nil;

        qryComprasTotal.Edit;
        qryComprasTotalselecionado.asBoolean:= not qryComprasTotalselecionado.asBoolean;
        qryComprasTotal.Post;

        AdicionarRetirarProdutoMarcado;

      finally
//        qryComprasTotal.oncalcFields := qryComprasTotalCalcFields;
      end;
//      VoltarRegistroAtual(qryComprasTotal);
    end;
  end;
end;

function TdtmConsultaCompras.VerificarSelecionados: Boolean;
var i:Integer;
begin
  i:=0;
  try
    GuardarRegistroAtual(qryComprasTotal,True);
    qryComprasTotal.First;
    while not qryComprasTotal.Eof do
    begin
      if qryComprasTotalselecionado.Asboolean then
      begin
         inc(i);
         break;
      end;
      qryComprasTotal.Next;
    end;
  finally
    VoltarRegistroAtual(qryComprasTotal);
  end;
  Result:= i =0;
end;

