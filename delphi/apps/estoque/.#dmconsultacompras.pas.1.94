  qryComprasGruposFiliais_Similarestotal_pedidos_filiais.displayformat     := '#######'; //ParSistema.MascaraQuantidadeGrade;//'#######';
  qryComprasGruposFiliais_Similarestotal_pedidos_fornecedores.displayformat     := '#######'; //ParSistema.MascaraQuantidadeGrade;//'#######';

  qryComprasGruposFiliais_Similarestotal_vendido.displayformat    := '#######'; //ParSistema.MascaraQuantidadeGrade;//'#######';
