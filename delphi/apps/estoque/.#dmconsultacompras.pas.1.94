procedure TdtmConsultaCompras.RefazConsultaProdutosSimilares;
var
  vListaProdutosSimilares: String;
begin
  RefazConsultaPorNome(qryListaProdutosSimilares, ['produto'], [qryComprasTotalproduto.AsString]);
  vListaProdutosSimilares := RetornarLista(qryListaProdutosSimilares, [qryListaProdutosSimilarescodigo]);
  if vListaProdutosSimilares<>'' then
    vListaProdutosSimilares := vListaProdutosSimilares + ',('+ qryComprasTotalproduto.AsString+')';


  qryProdutosSimilares.MacroByName('ListaProdutosSimilares').AsString := vListaProdutosSimilares;

  if FParametroOrdenacao = 1 then
    qryProdutosSimilares.MacroByName('ORDERBY').AsString := 'ORDER BY UPPER(TO_ASCII(nomeproduto,''LATIN1'')), valorgrade1, valorgrade2, produtovisual'
  else
    qryProdutosSimilares.MacroByName('ORDERBY').AsString := 'ORDER BY produtovisual, UPPER(TO_ASCII(nomeproduto,''LATIN1'')), valorgrade1, valorgrade2';

  qryProdutosSimilares.MacroByName('Filiais').AsString := qryComprasTotal.MacroByName('Filiais').AsString;

  ReFazConsultaporNome(qryProdutosSimilares,['produto','PedidosEntreFiliais',
                       'NaoConsiderarPedidosCompra',
                       'NaoConsiderarPedidosCompraparaDiasEstoque',
                       'inicio','fim', 'periodo', 'diasproporcional',
                       'diasestoque', 'filialbase'],
                     [qryComprasTotalproduto.AsString,
                      PedidosEntreFiliais,
                      NaoConsiderarPedidosCompra,
                      NaoConsiderarPedidosCompraparaDiasEstoque,
                      FParametroDataInicial,
                      FParametroDataFinal,
                      GetPeriodo,
                      FParametroDiasEstoqueProporcional,
                      FParametroDiasEstoque,
                      filialbase
                      ]);

  qryTotalProdutosSimilares.MacroByName('ListaProdutosSimilares').AsString := vListaProdutosSimilares;
  qryTotalProdutosSimilares.MacroByName('Filiais').AsString := qryComprasTotal.MacroByName('Filiais').AsString;

  ReFazConsultaporNome(qryTotalProdutosSimilares,['produto','PedidosEntreFiliais',
                                                  'NaoConsiderarPedidosCompra',
                                                  'NaoConsiderarPedidosCompraparaDiasEstoque',
                                                  'inicio','fim', 'periodo',
                                                  'diasproporcional',
                                                  'diasestoque'],
                     [qryComprasTotalproduto.AsString,
                      PedidosEntreFiliais,
                      NaoConsiderarPedidosCompra,
                      NaoConsiderarPedidosCompraparaDiasEstoque,
                      FParametroDataInicial,
                      FParametroDataFinal,
                      GetPeriodo,
                      FParametroDiasEstoqueProporcional,
                      FParametroDiasEstoque
                      ]);

  qryComprasGruposFiliais_similares.MacroByName('ListaProdutosSimilares').AsString := vListaProdutosSimilares;
  RefazConsultapornome(qryComprasGruposFiliais_similares,['periodo','diasproporcional',
                                                  'diasestoque',
                                                  'PedidosEntreFiliais',
                                                  'NaoConsiderarPedidosCompra',
                                                  'NaoConsiderarPedidosCompraparaDiasEstoque',
                                                  'Inicio','Fim'],
                                          [GetPeriodo,
                                           FParametroDiasEstoqueProporcional,
                                           FParametroDiasEstoque,
                                           PedidosEntreFiliais,
                                           NaoConsiderarPedidosCompra,
                                           NaoConsiderarPedidosCompraparaDiasEstoque,
                                           FParametroDataInicial,
                                           FParametroDataFinal]);

  qryComprasFiliaisGrupo_similares.MacroByName('ListaProdutosSimilares').AsString := vListaProdutosSimilares;
  RefazConsultapornome(qryComprasFiliaisGrupo_similares,['periodo',
                        'diasproporcional','diasestoque',
                        'estoquetotal','PedidosEntreFiliais',
                        'NaoConsiderarPedidosCompra',
                        'NaoConsiderarPedidosCompraparaDiasEstoque',
                        'Inicio','Fim'],
                                          [GetPeriodo,
                                           FParametroDiasEstoqueProporcional,
                                           FParametroDiasEstoque,
                                                      {qryComprasGruposFiliaistotal_estoque.AsCurrency} 0,
                                                      PedidosEntreFiliais,
                                                      NaoConsiderarPedidosCompra,
                                       NaoConsiderarPedidosCompraparaDiasEstoque,
                                                      FParametroDataInicial,
                                                      FParametroDataFinal
                                                      ]);


 qryVVendas_Similares.MacroByName('ListaProdutosSimilares').AsString := vListaProdutosSimilares;
 RefazConsulta(qryVVendas_Similares,[0,1],[FParametroDataInicial, FParametroDataFinal]);

 qryVVendas_porFilial_Similares.MacroByName('ListaProdutosSimilares').AsString := vListaProdutosSimilares;
 RefazConsulta(qryVVendas_porFilial_Similares,[0,1],[FParametroDataInicial, FParametroDataFinal]);

 qryVVendas_porGrupo_Similares.MacroByName('ListaProdutosSimilares').AsString := vListaProdutosSimilares;
 RefazConsulta(qryVVendas_porGrupo_Similares,[0,1],[FParametroDataInicial, FParametroDataFinal]);

 qryDetalhesCompra_Similares.MacroByName('ListaProdutosSimilares').AsString := vListaProdutosSimilares;
 RefazConsulta(qryDetalhesCompra_Similares,[],[]);

 qryDetalhesPrecos_Similiares.MacroByName('ListaProdutosSimilares').AsString := vListaProdutosSimilares;
 RefazConsulta(qryDetalhesPrecos_Similiares,[],[]);

 qryComprasFiliaisGrupo_Similares.locate('filial', qryComprasFiliaisGrupofilial.AsInteger, []);

end;

