procedure TdtmConsultaCompras.qryPedidosFiliais_BeforePost(
  DataSet: TDataSet);
begin
  inherited;
  {
  if not qryPedidosFiliais_.readonly then
    if qryPedidosFiliais_qtdepedida.ascurrency > qryPedidosFiliais_emestoque.ascurrency then
      if qryPedidosFiliais_requisitante.asinteger <> qryPedidosFiliais_requisitada.asinteger then
      qryPedidosFiliais_qtdepedida.clear;
      }

end;

procedure TdtmConsultaCompras.abrirListaPedidosFiliais;
begin
  RefazConsultaPornome(qryListaPedidosFiliais_Requisitante,
                       ['filialRequisitante','produto'],
                       [qryComprasFiliaisGrupofilial.asinteger,
                        qryComprasFiliaisGrupoproduto.asString]);

  RefazConsultaPornome(qryListaPedidosFiliais_Requisitado,
                       ['filialrequisitada','produto'],
                       [qryComprasFiliaisGrupofilial.asinteger,
                        qryComprasFiliaisGrupoproduto.asString]);

  RefazConsultaPornome(qryListaPedidosFiliais_Totais,
                       ['filialRequisitante','produto'],
                       [qryComprasFiliaisGrupofilial.asinteger,
                        qryComprasFiliaisGrupoproduto.asString]);



end;

procedure TdtmConsultaCompras.AbrirVendasDiarias;
begin
  qryVVendasDiaria.paramByName('codigoproduto').asString := qryComprasTotalproduto.asString;
  qryVVendasDiaria.close;
  qryVVendasDiaria.open;
end;

end.
