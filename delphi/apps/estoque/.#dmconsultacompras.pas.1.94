procedure TdtmConsultaCompras.qryProdutosSimilaresCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  if qryProdutosSimilaresprodutoempromocao.asBoolean then
    qryProdutosSimilarespromo.asString := 'S'
  else
    qryProdutosSimilarespromo.clear;

  if qryProdutosSimilarestotal_vendido.asFloat <> 0 then
  begin
    qryProdutosSimilaresdiasEstoqueCalculado.asFloat :=
       (qryProdutosSimilarestotal_estoque.AsFloat +
        qryProdutosSimilarestotal_pedido.AsFloat +
        qryProdutosSimilaressugestao.AsFloat) /
        (qryProdutosSimilarestotal_vendido.AsFloat / qryProdutosSimilaresperiodo.AsInteger)


  end
  else
    qryProdutosSimilaresdiasEstoqueCalculado.asFloat := 999999.99


end;

procedure TdtmConsultaCompras.CalcularTotalAtendido(CalcularProduto: Boolean = false);
var
  vTotalProdutoAtendido : Double;
  v_recno : integer;
begin

//  qryPedidosFiliais_.GuardarRegistroAtual(true);
  v_recno := qryPedidosFiliais_.recno;
  vTotalAtendido := SomarValores(qryPedidosFiliais_, [qryPedidosFiliais_qtdepedida], [qryPedidosFiliais_requisitada], [filialrequisitante], ['<>']);
//  qryPedidosFiliais_.VoltarRegistro;
  qryPedidosFiliais_.recno := v_recno;

  if CalcularProduto then
  begin
    dsrPedidosFiliais_.onDataChange := nil;
    qryPedidosFiliais_.afterscroll := nil;

    qryPedidosFiliais_.GuardarRegistroAtual(true);

    vTotalProdutoAtendido := SomarValores(qryPedidosFiliais_,
                                          [qryPedidosFiliais_qtdepedida],
                                          [qryPedidosFiliais_requisitada, qryPedidosFiliais_produto],
                                          [filialrequisitante, qryPedidosFiliais_produto.asString], ['<>','=']);

    qryPedidosFiliais_.readonly := false;
    AtribuirDados(qryPedidosFiliais_,
                   [qryPedidosFiliais_qtdepedida],
                   [vTotalProdutoAtendido],
                   [qryPedidosFiliais_requisitada, qryPedidosFiliais_produto],
                   [filialrequisitante, qryPedidosFiliais_produto.asString], ['=','=']);

    dsrPedidosFiliais_.onDataChange := dsrPedidosFiliais_DataChange;
    qryPedidosFiliais_.afterscroll := qryPedidosFiliais_afterscroll;
    qryPedidosFiliais_.VoltarRegistro;
  end;

end;

procedure TdtmConsultaCompras.MontarFiltroFiliaissemEstoque(
  Usar: TCheckListBox);
var
  STRFiliais: String;
  cnt: Integer;
begin
  TodasFiliaissemEstoque := True;
  STRFiliais := '';

  for cnt := 0 to FListaFiliais.Count - 1 do
    if Usar.Checked[cnt] then
      STRFiliais := STRFiliais + '''' + IntToStr(Integer(FListaFiliais.Objects[cnt])) + ''','
    else
      TodasFiliaissemEstoque := False;

  STRFiliais := Copy(STRFiliais, 0, Length(STrFiliais) - 1);
  FilialsemEstoque := STRFiliais;
  if Trim(STRFiliais) <> '' then
    if not TodasFiliaissemEstoque then
      FParametroCabecalho := FParametroCabecalho+' Filiais sem Estoque: '+STRFiliais
    else FilialsemEstoque := '';

  if (Trim(STRFiliais) = '') then
    TodasFiliaissemEstoque := true;
end;

