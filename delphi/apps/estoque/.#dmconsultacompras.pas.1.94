  qryProdutosSimilaresminimo.DisplayFormat                   := '#######'; //ParSistema.MascaraQuantidadeGrade;//'#######';
  qryProdutosSimilaressugestaominimo.DisplayFormat           := '#######'; //ParSistema.MascaraQuantidadeGrade;//'#######';
  qryProdutosSimilaresmaximo.DisplayFormat                   := '#######'; //ParSistema.MascaraQuantidadeGrade;//'#######';
