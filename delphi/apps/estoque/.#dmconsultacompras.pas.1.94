function TdtmConsultaCompras.GetPeriodo: String;
begin
  if daysbetween(strtodate(FParametroDataFinal),
                 strtodate(FParametroDataInicial)) > 0 then
    fPeriodo := inttostr(daysbetween(strtodate(FParametroDataFinal),
                                   strtodate(FParametroDataInicial)))
  else
    fPeriodo := inttostr(1);

  result := fPeriodo;
end;


function TdtmConsultaCompras.GetCodigoGrupoFilialCompras: Integer;
begin
  Result := qryComprasGruposFiliaisgrupo.AsInteger;
end;

function TdtmConsultaCompras.GetCodigoProdutoCompras: String;
begin
  Result := qryComprasTotalproduto.Asstring;
end;

function TdtmConsultaCompras.GetConsultaVazia: Boolean;
begin
  Result := qryComprasTotal.IsEmpty;
  if Result then
    MensagemAviso(ctCONSULTAVAZIA);
end;


procedure TdtmConsultaCompras.AbreConsultaCompras;
var
 vListadeProdutos: String;

const
 FiltroFornecedor = ' (p.caracteristica in (select fp.caracteristica from fornecedoresprodutos fp where fp.fornecedor = %s))';
 FiltroGruposFornecedores = ' (p.caracteristica in (select fp.caracteristica from fornecedoresprodutos fp where fp.fornecedor in (select f.codigo from fornecedores f join gruposfornecedores gf on f.grupofornecedor = gf.codigo where %s)))';

 FiltroFilial      = ' ( e.filial IN (%s)) ';
 FiltroFilialUltimaVenda = '  and df.filialvenda IN (%s) ';

 FiltroFilialEstoque      = ' (select sum(e.emestoque) from estoques e where e.filial in (%s) and e.produto = p.codigo )>0';
 FiltroFilialsemEstoque      = ' (select sum(e.emestoque) from estoques e where e.filial in (%s) and e.produto = p.codigo )=0';


 FiltroGrupoFilial = ' ( e.filial IN (SELECT filial ' +
                                    'FROM filiaisgruposfiliais fgf '+
                                    'WHERE fgf.grupo IN (%s))) ';

 datacadastroproduto_IF = ' p.datacadastro between %s and %s ';
 datacadastroproduto_I = ' p.datacadastro >= %s ';
 datacadastroproduto_F = ' p.datacadastro <= %s ';

 DataEntradaNF_IF = ' p.codigo in (select distinct pnp.produto '+
	 			      ' from produtosnotaspag pnp,notaspag np '+
	 			      '	where np.codigo=pnp.codigonota and np.situacao = ''N'''+
	 				 ' and pnp.codigofiscal in (%s) '+
					 ' and np.data between %s and %s) ';

 DataEntradaNF_I = ' p.codigo in (select distinct pnp.produto '+
	 			      ' from produtosnotaspag pnp,notaspag np '+
	 			      '	where np.codigo=pnp.codigonota and np.situacao = ''N'''+
	 				 ' and pnp.codigofiscal in (%s) '+
					 ' and np.data >= %s ) ';

 DataEntradaNF_F = ' p.codigo in (select distinct pnp.produto '+
	 			      ' from produtosnotaspag pnp,notaspag np and np.situacao = ''N'''+
	 			      '	where np.codigo=pnp.codigonota '+
	 				 ' and pnp.codigofiscal in (%s) '+
					 ' and np.data <= %s ) ';

 DataUltimaVenda_IF = ' p.codigo in '+
                      ' (select m.produto '+
                      ' from movimentos m '+
                      ' where m.cmpmovimento in ( '+
                      ' select distinct m.numero '+
                      ' from produtosdadosfiscais pdf '+
                      '      join produtos p '+
                      '      join caracteristicas ccomp '+
                      '           on p.caracteristica = ccomp.codigo '+
                      '      on pdf.produto = p.codigo '+
                      ' join dadosfiscais df '+
                      '   on pdf.dadofiscal = df.numero '+
                      '      and df.situacao = ''N'' '+
                      ' join movimentos m '+
                      ' on pdf.dadofiscal = m.dadofiscal '+
                      ' and pdf.produto = m.produto '+
                      ' where coalesce(ccomp.composto,FALSE) '+
                      '   and coalesce(ccomp.discriminarcomposto,'''') = ''N'' '+
                      '   and pdf.codigofiscal in (%s) '+
                      '   and df.data between %s and %s %s ) '+
                      '  UNION '+
                      ' select distinct pdf.produto '+
                      ' from produtosdadosfiscais pdf '+
                      ' join dadosfiscais df '+
                      '   on pdf.dadofiscal = df.numero '+
                      ' and df.situacao = ''N'' '+
                      ' join movimentos m '+
                      ' on pdf.dadofiscal = m.dadofiscal '+
                      ' and pdf.produto = m.produto '+
                      ' Where pdf.codigofiscal in (%s) '+
                      '   and df.data between %s and %s %s ) '+

                      ' and p.codigo not in '+
                      ' (select m.produto '+
                      ' from movimentos m '+
                      ' where m.cmpmovimento in ( '+
                      ' select distinct m.numero '+
                      ' from produtosdadosfiscais pdf '+
                      '      join produtos p '+
                      '      join caracteristicas ccomp '+
                      '           on p.caracteristica = ccomp.codigo '+
                      '      on pdf.produto = p.codigo '+
                      ' join dadosfiscais df '+
                      '   on pdf.dadofiscal = df.numero '+
                      '      and df.situacao = ''N'' '+
                      ' join movimentos m '+
                      ' on pdf.dadofiscal = m.dadofiscal '+
                      ' and pdf.produto = m.produto '+
                      ' where coalesce(ccomp.composto,FALSE) '+
                      '   and coalesce(ccomp.discriminarcomposto,'''') = ''N'' '+
                      '   and pdf.codigofiscal in (%s) '+
                      '   and df.data > %s %s ) '+

                      '  UNION '+

                      ' select distinct pdf.produto '+
                      ' from produtosdadosfiscais pdf '+
                      ' join dadosfiscais df '+
                      '   on pdf.dadofiscal = df.numero '+
                      ' and df.situacao = ''N'' '+
                      ' join movimentos m '+
                      ' on pdf.dadofiscal = m.dadofiscal '+
                      ' and pdf.produto = m.produto '+
                      ' Where pdf.codigofiscal in (%s) '+
                      '   and df.data > %s %s ) ';


 DataUltimaVenda_I = ' p.codigo in '+
                      ' (select m.produto '+
                      ' from movimentos m '+
                      ' where m.cmpmovimento in ( '+
                      ' select distinct m.numero '+
                      ' from produtosdadosfiscais pdf '+
                      '      join produtos p '+
                      '      join caracteristicas ccomp '+
                      '           on p.caracteristica = ccomp.codigo '+
                      '      on pdf.produto = p.codigo '+
                      ' join dadosfiscais df '+
                      '   on pdf.dadofiscal = df.numero '+
                      '      and df.situacao = ''N'' '+
                      ' join movimentos m '+
                      ' on pdf.dadofiscal = m.dadofiscal '+
                      ' and pdf.produto = m.produto '+
                      ' where coalesce(ccomp.composto,FALSE) '+
                      '   and coalesce(ccomp.discriminarcomposto,'''') = ''N'' '+
                      '   and pdf.codigofiscal in (%s) '+
                      '   and df.data df.data >= %s %s ) '+
                      '  UNION '+
                      ' select distinct pdf.produto '+
                      ' from produtosdadosfiscais pdf '+
                      ' join dadosfiscais df '+
                      '   on pdf.dadofiscal = df.numero '+
                      ' and df.situacao = ''N'' '+
                      ' join movimentos m '+
                      ' on pdf.dadofiscal = m.dadofiscal '+
                      ' and pdf.produto = m.produto '+
                      ' where pdf.codigofiscal in (%s) '+
                      '   and df.data df.data >= %s %s ) ';

 DataUltimaVenda_F = ' p.codigo in '+
                      ' (select m.produto '+
                      ' from movimentos m '+
                      ' where m.cmpmovimento in ( '+
                      ' select distinct m.numero '+
                      ' from produtosdadosfiscais pdf '+
                      '      join produtos p '+
                      '      join caracteristicas ccomp '+
                      '           on p.caracteristica = ccomp.codigo '+
                      '      on pdf.produto = p.codigo '+
                      ' join dadosfiscais df '+
                      '   on pdf.dadofiscal = df.numero '+
                      '      and df.situacao = ''N'' '+
                      ' join movimentos m '+
                      ' on pdf.dadofiscal = m.dadofiscal '+
                      ' and pdf.produto = m.produto '+
                      ' where coalesce(ccomp.composto,FALSE) '+
                      '   and coalesce(ccomp.discriminarcomposto,'''') = ''N'' '+
                      '   and pdf.codigofiscal in (%s) '+
                      '   and df.data <= %s %s ) '+
                      '  UNION '+
                      ' select distinct pdf.produto '+
                      ' from produtosdadosfiscais pdf '+
                      ' join dadosfiscais df '+
                      '   on pdf.dadofiscal = df.numero '+
                      ' and df.situacao = ''N'' '+
                      ' join movimentos m '+
                      ' on pdf.dadofiscal = m.dadofiscal '+
                      ' and pdf.produto = m.produto '+
                      '   where pdf.codigofiscal in (%s) '+
                      '   and df.data <= %s %s ) '+

                      ' and p.codigo not in '+
                      ' (select m.produto '+
                      ' from movimentos m '+
                      ' where m.cmpmovimento in ( '+
                      ' select distinct m.numero '+
                      ' from produtosdadosfiscais pdf '+
                      '      join produtos p '+
                      '      join caracteristicas ccomp '+
                      '           on p.caracteristica = ccomp.codigo '+
                      '      on pdf.produto = p.codigo '+
                      ' join dadosfiscais df '+
                      '   on pdf.dadofiscal = df.numero '+
                      '      and df.situacao = ''N'' '+
                      ' join movimentos m '+
                      ' on pdf.dadofiscal = m.dadofiscal '+
                      ' and pdf.produto = m.produto '+
                      ' where coalesce(ccomp.composto,FALSE) '+
                      '   and coalesce(ccomp.discriminarcomposto,'''') = ''N'' '+
                      '   and pdf.codigofiscal in (%s) '+
                      '   and df.data > %s %s ) '+

                      '  UNION '+

                      ' select distinct pdf.produto '+
                      ' from produtosdadosfiscais pdf '+
                      ' join dadosfiscais df '+
                      '   on pdf.dadofiscal = df.numero '+
                      ' and df.situacao = ''N'' '+
                      ' join movimentos m '+
                      ' on pdf.dadofiscal = m.dadofiscal '+
                      ' and pdf.produto = m.produto '+
                      ' where pdf.codigofiscal in (%s) '+
                      '   and df.data > %s %s ) ';
var
 SQLFilial, SQLFilialUltimaVenda, SQLFilialEstoque, SQLFilialsemEstoque, SQLEstoque, SQLProdutos, SQLProdutosVendas, SQLSituacaoProdutos, SQLCurvaABC, SQLdatacadastroproduto, SQLDataEntradaNF,
 SQLDataUltimaVenda  : String;
begin
  //qryComprasTotal.Sql[49]:=FParametroEstoque;

  if qryReducaoTabelaCompras.IsEmpty then
    qryComprasTotal.sql.text := qryComprasTotal_SemTabelaReducao.sql.text
  else
  if TodasFiliais and TodosGrupos then
    qryComprasTotal.sql.text := qryComprasTotal_ComTabelaReducao_TodasFiliais.sql.text
  else
    qryComprasTotal.sql.text := qryComprasTotal_ComTabelaReducao_FiliaisEspecificas.sql.text;

  if (ParametroDataInicialCadastroProduto <> '') and
     (ParametroDataFinalCadastroProduto <> '') then
    SQLdatacadastroproduto := format(datacadastroproduto_IF,
                                     [quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(ParametroDataInicialCadastroProduto))),
                                      quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(ParametroDataFinalCadastroProduto)))])
  else
  if (ParametroDataInicialCadastroProduto <> '') and
     (ParametroDataFinalCadastroProduto = '') then
    SQLdatacadastroproduto := format(datacadastroproduto_I,
                                     [quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(ParametroDataInicialCadastroProduto)))])
  else
  if (ParametroDataInicialCadastroProduto = '') and
     (ParametroDataFinalCadastroProduto <> '') then
    SQLdatacadastroproduto := format(datacadastroproduto_F,
                         [quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(ParametroDataFinalCadastroProduto)))])
  else
    SQLdatacadastroproduto := '';


  if (ParametroDataInicialEntradaNF <> '') and
     (ParametroDataFinalEntradaNF <> '') then
    SQLDataEntradaNF := format(DataEntradaNF_IF,
                                     [ctListaCodigosFiscaisCompra,
                                      quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(ParametroDataInicialEntradaNF))),
                                      quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(ParametroDataFinalEntradaNF)))])
  else
  if (ParametroDataInicialEntradaNF <> '') and
     (ParametroDataFinalEntradaNF = '') then
    SQLDataEntradaNF := format(DataEntradaNF_I,
                                     [ctListaCodigosFiscaisCompra,
                                      quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(ParametroDataInicialEntradaNF)))])
  else
  if (ParametroDataInicialEntradaNF = '') and
     (ParametroDataFinalEntradaNF <> '') then
    SQLDataEntradaNF := format(DataEntradaNF_F,
                         [ctListaCodigosFiscaisCompra,
                          quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(ParametroDataFinalEntradaNF)))])
  else
    SQLDataEntradaNF := '';

  SQLFilialUltimaVenda := '';
  if (FFilial<>'') then
    SQLFilialUltimaVenda := format(FiltroFilialUltimaVenda,[FFilial]);

  if (ParametroDataInicialUltimaVenda <> '') and
     (ParametroDataFinalUltimaVenda <> '') then
    SQLDataUltimaVenda := format(DataUltimaVenda_IF,
                                     [ctListaCodigosFiscaisVenda,
                                      quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(ParametroDataInicialUltimaVenda))),
                                      quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(ParametroDataFinalUltimaVenda))),
                                      SQLFilialUltimaVenda,

                                      ctListaCodigosFiscaisVenda,
                                      quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(ParametroDataInicialUltimaVenda))),
                                      quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(ParametroDataFinalUltimaVenda))),
                                      SQLFilialUltimaVenda,

                                      ctListaCodigosFiscaisVenda,
                                      quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(ParametroDataFinalUltimaVenda))),
                                      SQLFilialUltimaVenda,

                                      ctListaCodigosFiscaisVenda,
                                      quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(ParametroDataFinalUltimaVenda))),
                                      SQLFilialUltimaVenda])
  else
  if (ParametroDataInicialUltimaVenda <> '') and
     (ParametroDataFinalUltimaVenda = '') then
    SQLDataUltimaVenda := format(DataUltimaVenda_I,
                                     [ctListaCodigosFiscaisVenda,
                                      quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(ParametroDataInicialUltimaVenda))),
                                      SQLFilialUltimaVenda,

                                      ctListaCodigosFiscaisVenda,
                                      quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(ParametroDataInicialUltimaVenda))),
                                      SQLFilialUltimaVenda
                                      ])
  else
  if (ParametroDataInicialUltimaVenda = '') and
     (ParametroDataFinalUltimaVenda <> '') then
    SQLDataUltimaVenda :=  format(DataUltimaVenda_F,
                         [ctListaCodigosFiscaisVenda,
                          quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(ParametroDataFinalUltimaVenda))),
                          SQLFilialUltimaVenda,

                          ctListaCodigosFiscaisVenda,
                          quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(ParametroDataFinalUltimaVenda))),
                          SQLFilialUltimaVenda,

                          ctListaCodigosFiscaisVenda,
                          quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(ParametroDataFinalUltimaVenda))),
                          SQLFilialUltimaVenda,

                          ctListaCodigosFiscaisVenda,
                          quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(ParametroDataFinalUltimaVenda))),
                          SQLFilialUltimaVenda])
  else
    SQLDataUltimaVenda := '';

  qryComprasTotal.MacroByName('quantidadeemestoque').AsString := FParametroEstoque;
  qryComprasGruposFiliais.MacroByName('quantidadeemestoque').AsString := FParametroEstoque;
  qryComprasFiliaisGrupo.MacroByName('quantidadeemestoque').AsString := FParametroEstoque;

  qryComprasGruposFiliais_Similares.MacroByName('quantidadeemestoque').AsString := FParametroEstoque;
  qryComprasFiliaisGrupo_Similares.MacroByName('quantidadeemestoque').AsString := FParametroEstoque;
  qryProdutosSimilares.MacroByName('quantidadeemestoque').AsString := FParametroEstoque;
  qryTotalProdutosSimilares.MacroByName('quantidadeemestoque').AsString := FParametroEstoque;



  SQLFilial := '';
  SQLEstoque := '';
  SQLProdutos := '';
  SQLSituacaoProdutos := '';

  if (FFilial<>'') then
    SQLFilial := ' and '+ format(FiltroFilial,[FFilial]);

  if (FFilialEstoque<>'') then
    SQLFilialEstoque := ' and '+ format(FiltroFilialEstoque,[FFilialEstoque]);

  if (FFilialsemEstoque<>'') then
    SQLFilialsemEstoque := ' and '+ format(FiltroFilialsemEstoque,[FFilialsemEstoque]);

  if (FGrupoFilial<>'') then
    SQLFilial := SQLFilial + ' and ' + format(FiltroGrupoFilial,[FGrupoFilial]);

  if length(SQLFilial)<>0 then
    qryComprasTotal.Macrobyname('Filiais').asstring := SQLFilial
  else
    qryComprasTotal.Macrobyname('Filiais').asstring := '';

  if length(SQLFilialEstoque)<>0 then
    qryComprasTotal.Macrobyname('FiliaisEstoque').asstring := SQLFilialEstoque
  else
    qryComprasTotal.Macrobyname('FiliaisEstoque').asstring := '';

  if length(SQLFilialsemEstoque)<>0 then
    qryComprasTotal.Macrobyname('FiliaisEstoque').asstring :=
      qryComprasTotal.Macrobyname('FiliaisEstoque').asstring +
      SQLFilialsemEstoque;

  if ListaCondicaoItemProduto<>'' then
  begin
    SQLSituacaoProdutos := SQLSituacaoProdutos + ' and (' + ListaCondicaoItemProduto + ')';
    FParametroCabecalho := FParametroCabecalho + ' Item de Produto: '+ListaCondicaoItemProduto;
  end;


  if ListaCondicaoProduto<>'' then
  begin
    SQLSituacaoProdutos := SQLSituacaoProdutos + ' and (' + ListaCondicaoProduto + ')';
    FParametroCabecalho := FParametroCabecalho + ' Produto: '+ListaCondicaoProduto;
  end;

  if ListaCondicaoGrupoProduto<>'' then
  begin
    SQLSituacaoProdutos := SQLSituacaoProdutos + ' and (' + ListaCondicaoGrupoProduto + ')';
    FParametroCabecalho := FParametroCabecalho + ' Grupo de Produto: '+ListaCondicaoGrupoProduto;
  end;

  if ListaCondicaoClasseProduto<>'' then
  begin
    SQLSituacaoProdutos := SQLSituacaoProdutos + ' and (' + ListaCondicaoClasseProduto + ')';
    FParametroCabecalho := FParametroCabecalho + ' Classe de Produto: '+ListaCondicaoClasseProduto;
  end;

  if ListaCondicaoMarcaProduto<>'' then
  begin
    SQLSituacaoProdutos := SQLSituacaoProdutos + ' and (' + ListaCondicaoMarcaProduto + ')';
    FParametroCabecalho := FParametroCabecalho + ' Classe de Produto: '+ListaCondicaoMarcaProduto;
  end;

  if ListaCondicaoPromocoesProduto<>'' then
  begin
    SQLSituacaoProdutos := SQLSituacaoProdutos + ' and (' + ListaCondicaoPromocoesProduto + ')';
    FParametroCabecalho := FParametroCabecalho + ' Promoções do Produto: '+ListaCondicaoPromocoesProduto;
  end;

  if (FParametroFornecedor<>'') then
     SQLSituacaoProdutos := SQLSituacaoProdutos +  ' and ' + format(FiltroFornecedor, [FParametroFornecedor]);

  if ListaGruposFornecedores<>'' then
     SQLSituacaoProdutos := SQLSituacaoProdutos +  ' and ' + format(FiltroGruposFornecedores, [ListaGruposFornecedores]);

  if FProdutoEmLinha and not FprodutoForadeLinha then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and (p.foralinha is null) and (c.foralinha is null)'
  else
  if FprodutoForadeLinha and not Fprodutoemlinha then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and  (p.foralinha is not null or c.foralinha is not null)';

  if FProdutoAtivo and not FprodutoInativo then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and  (p.inativo is null) and (c.inativo is null)'
  else
  if FprodutoInativo and not FprodutoAtivo then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and  (p.inativo is not null or c.inativo is not null)';

  if FProdutoComMontagem and not FProdutoSemMontagem then
    SQLSituacaoProdutos := SQLSituacaoProdutos + ' and (c.montagem)'
  else
  if FProdutoSemMontagem and not FProdutoComMontagem then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and not (c.montagem)';

  if FProdutoBrinde and not FProdutoNaoBrinde then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and (c.brinde)'
  else
  if FProdutoNaoBrinde and not FProdutoBrinde then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and not (c.brinde)';

  if FProdutoComposto and not FProdutoNaoComposto then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and coalesce(c.composto,false)'
  else
  if FProdutoNaoComposto and not FProdutoComposto then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and not coalesce(c.composto,false)';

  if (length(SQLSituacaoProdutos)<>0) then
//   SQLProdutos := ' and ' + SQLSituacaoProdutos;
   SQLProdutos := SQLSituacaoProdutos;

  if (length(SQLdatacadastroproduto)<>0) then
   SQLProdutos := SQLProdutos + ' and ' + SQLdatacadastroproduto;

  if (length(SQLDataEntradaNF)<>0) then
   SQLProdutos := SQLProdutos + ' and ' + SQLDataEntradaNF;

  if (length(SQLDataUltimaVenda)<>0) then
   SQLProdutos := SQLProdutos + ' and ' + SQLDataUltimaVenda;

  if (length(SQLProdutos)<>0) then
  begin

    qryComprasTotal.MacroByName('produtos').AsString := SQLProdutos;
    qryComprasGruposFiliais.MacroByName('produtos').AsString := SQLProdutos;
    qryComprasFiliaisGrupo.MacroByName('produtos').AsString := SQLProdutos;

  end
  else
  begin
    qryComprasTotal.MacroByName('produtos').AsString := '';
    qryComprasGruposFiliais.MacroByName('produtos').AsString := '';
    qryComprasFiliaisGrupo.MacroByName('produtos').AsString := '';
  end;

  SQLCurvaABC := '';
  if CurvaABC_A then
     SQLCurvaABC := SQLCurvaABC + ' p.resultadocurvaabc = ''A''';

  if CurvaABC_B then
    if (length(SQLCurvaABC)<>0) then
      SQLCurvaABC := SQLCurvaABC + ' or  p.resultadocurvaabc = ''B'''
    else
      SQLCurvaABC := ' p.resultadocurvaabc = ''B''';

  if CurvaABC_C then
    if (length(SQLCurvaABC)<>0) then
      SQLCurvaABC := SQLCurvaABC + ' or p.resultadocurvaabc = ''C'''
    else
      SQLCurvaABC := ' p.resultadocurvaabc = ''C''';

  if CurvaABC_NaoDefinido then
    if (length(SQLCurvaABC)<>0) then
      SQLCurvaABC := SQLCurvaABC + ' or  coalesce(p.resultadocurvaabc,'''') = '''''
    else
      SQLCurvaABC := ' coalesce(p.resultadocurvaabc,'''') = ''''';

  if (length(SQLCurvaABC)<>0) then
  begin
    SQLCurvaABC := SQLCurvaABC + ')';
    Insert(' and (', SQLCurvaABC, 0)
  end;

  if (length(SQLCurvaABC)<>0) then
  begin

    qryComprasTotal.MacroByName('resultadocurvaabc').AsString := SQLCurvaABC;
    qryComprasGruposFiliais.MacroByName('resultadocurvaabc').AsString := SQLCurvaABC;
    qryComprasFiliaisGrupo.MacroByName('resultadocurvaabc').AsString := SQLCurvaABC;

  end
  else
  begin

    qryComprasTotal.MacroByName('resultadocurvaabc').AsString := '';
    qryComprasGruposFiliais.MacroByName('resultadocurvaabc').AsString := '';
    qryComprasFiliaisGrupo.MacroByName('resultadocurvaabc').AsString := '';

  end;


  if (length(SQLEstoque)<>0) then
  begin
    Insert('and ', SQLEstoque, 0);
    if (StrToInt(ParametroPercentual)>0) then
        SQLEstoque := SQLEstoque + 'and (((e.emestoque+e.reservado+e.transito+e.demonstracao+e.conserto+e.danificada+e.reservaprevia)' +
                      '+pedidos_estoquepedido(e.produto,e.filial))-coalesce(e.futuro,0))<=' +
                      '(case when coalesce(e.minimo,0)=0 then 0 else (e.minimo+((e.minimo*' +
                      ParametroPercentual + ')/100)) end)';

    qryComprasTotal.MacroByName('estoques').AsString := SQLEstoque;
    qryComprasGruposFiliais.MacroByName('estoques').AsString := SQLEstoque;
    qryComprasFiliaisGrupo.MacroByName('estoques').AsString := SQLEstoque;

  end
  else
  begin
    qryComprasTotal.MacroByName('estoques').AsString := '';
    qryComprasGruposFiliais.MacroByName('estoques').AsString := '';
    qryComprasFiliaisGrupo.MacroByName('estoques').AsString := '';
  end;


  if FParametroSugestaoNula then
  begin
    qryComprasTotal.MacroByName('sugestao2').AsString :='Where (sugestao2 >= 0 or (sugestaominimo>0 or sugestaomaximo>0))';
    qryComprasTotal.MacroByName('sugestao8').AsString :='Where (sugestao >= 0 or (sugestaominimo>0 or sugestaomaximo>0))';
  end
  else
  begin
    if ProdutosLembradosparaPedido then
    begin
      qryComprasTotal.MacroByName('sugestao2').AsString :='Where (lembrarpedido or (sugestao2 > 0 or (sugestaominimo>0 or sugestaomaximo>0)))';
      qryComprasTotal.MacroByName('sugestao8').AsString :='where (lembrarpedido or (sugestao > 0 or (sugestaominimo>0 or sugestaomaximo>0)))';
    end
    else
    begin
      qryComprasTotal.MacroByName('sugestao2').AsString :='Where (sugestao2 > 0 or (sugestaominimo>0 or sugestaomaximo>0))';
      qryComprasTotal.MacroByName('sugestao8').AsString :='Where (sugestao > 0 or (sugestaominimo>0 or sugestaomaximo>0))';
    end
  end;

  if FParametroOrdenacao = 1 then
    qryComprasTotal.MacroByName('ORDERBY').AsString := 'ORDER BY UPPER(TO_ASCII(nomeproduto,''LATIN1'')), produto, valorgrade1, valorgrade2, codigomarca, UPPER(TO_ASCII(marca,''LATIN1''))'
  else
    qryComprasTotal.MacroByName('ORDERBY').AsString := 'ORDER BY produto, UPPER(TO_ASCII(nomeproduto,''LATIN1'')), valorgrade1, valorgrade2, codigomarca, UPPER(TO_ASCII(marca,''LATIN1''))';


  qryComprasTotal.AfterScroll := nil;

  RefazConsultaPorNome(qryComprasTotal,['periodo','diasproporcional','diasestoque',
                                        'filialbase','PedidosEntreFiliais',
                                        'NaoConsiderarPedidosCompra',
                                        'NaoConsiderarPedidosCompraparadiasEstoque',
                                        'inicio','fim'],
                                       [GetPeriodo,
                                        FParametroDiasEstoqueProporcional,
                                        FParametroDiasEstoque,
                                        FilialBase,
                                        PedidosEntreFiliais,
                                        NaoConsiderarPedidosCompra,
                                        NaoConsiderarPedidosCompraparadiasEstoque,
                                        FParametroDataInicial,
                                        FParametroDataFinal]);

  vListadeProdutos := RetornarLista(qryComprasTotal, qryComprasTotalproduto, nil, true);

  if (vListadeProdutos<>'') then
   SQLProdutos := SQLProdutos + ' and p.codigo in (' + vListadeProdutos +')';

  qryComprasGruposFiliais.MacroByName('produtos').AsString := SQLProdutos;
  qryComprasFiliaisGrupo.MacroByName('produtos').AsString := SQLProdutos;

  qryComprasTotal.AfterScroll := qryComprasTotalAfterScroll;

  RefazConsultapornome(qryComprasGruposFiliais,['periodo','diasproporcional',
                                                'diasestoque','PedidosEntreFiliais',
                                                'NaoConsiderarPedidosCompra',
                                                'NaoConsiderarPedidosCompraparaDiasEstoque',
                                                'Inicio','Fim'],
                                          [GetPeriodo,
                                           FParametroDiasEstoqueProporcional,
                                           FParametroDiasEstoque,
                                           PedidosEntreFiliais,
                                           NaoConsiderarPedidosCompra,
                                           NaoConsiderarPedidosCompraparaDiasEstoque,
                                           FParametroDataInicial,
                                           FParametroDataFinal]);

     
  RefazConsultapornome(qryComprasFiliaisGrupo,['periodo','diasproporcional',
                                               'diasestoque','estoquetotal',
                                               'PedidosEntreFiliais',
                                               'NaoConsiderarPedidosCompra',
                                               'NaoConsiderarPedidosCompraparaDiasEstoque',
                                               'Inicio','Fim'],
                                          [GetPeriodo,
                                           FParametroDiasEstoqueProporcional,
                                           FParametroDiasEstoque,
                                                      {qryComprasGruposFiliaistotal_estoque.AsCurrency} 0,
                                                      PedidosEntreFiliais,
                                                      NaoConsiderarPedidosCompra,
                                                      NaoConsiderarPedidosCompraparaDiasEstoque,
                                                      FParametroDataInicial,
                                                      FParametroDataFinal]);



 SQLProdutosVendas := SQLProdutos;
 {
 delete(SQLProdutosVendas,1,19);
 delete(SQLProdutosVendas, length(SQLProdutosVendas)-1,2);
 }


 qryVVendas.MacroByName('produtos').AsString := SQLProdutosVendas;
 qryVVendas.MacroByName('resultadocurvaabc').AsString := SQLCurvaABC;

 qryVVendasDiaria.MacroByName('produtos').AsString := SQLProdutosVendas;
 qryVVendasDiaria.MacroByName('resultadocurvaabc').AsString := SQLCurvaABC;
 qryVVendasDiaria.parambyname('datainicial').asDateTime := strtodate(FParametroDataInicial);
 qryVVendasDiaria.parambyname('datafinal').asDateTime := strtodate(FParametroDataFinal);

 qryVVendas_porFilial.MacroByName('produtos').AsString := SQLProdutosVendas;
 qryVVendas_porFilial.MacroByName('resultadocurvaabc').AsString := SQLCurvaABC;

 qryVVendas_porGrupo.MacroByName('produtos').AsString := SQLProdutosVendas;
 qryVVendas_porGrupo.MacroByName('resultadocurvaabc').AsString := SQLCurvaABC;


 RefazConsulta(qryVVendas,[0,1],[FParametroDataInicial, FParametroDataFinal]);
 RefazConsulta(qryVVendas_porFilial,[0,1],[FParametroDataInicial, FParametroDataFinal]);
 RefazConsulta(qryVVendas_porGrupo,[0,1],[FParametroDataInicial, FParametroDataFinal]);

 qryDetalhesCompra.MacroByName('produtos').AsString := SQLProdutos;
 qryDetalhesCompra.MacroByName('resultadocurvaabc').AsString := SQLCurvaABC;
 qryDetalhesCompra.MacroByName('estoques').AsString := SQLEstoque;

 if (FFilial<>'') then
   qryDetalhesCompra.MacroByName('CondicaoListaFiliais').AsString :=
   ' and e1.filial in ('+FFilial+')'
 else
   qryDetalhesCompra.MacroByName('CondicaoListaFiliais').AsString :='';

 qryDetalhesPrecos.MacroByName('produtos').AsString := SQLProdutos;
 qryDetalhesPrecos.MacroByName('resultadocurvaabc').AsString := SQLCurvaABC;
 qryDetalhesPrecos.MacroByName('estoques').AsString := SQLEstoque;

 RefazConsulta(qryDetalhesPrecos,[],[]);
 RefazConsulta(qryDetalhesCompra,[],[]);

 RefazConsulta(qryConsultaProdutosPedidos,[],[]);
 
end;


procedure TdtmConsultaCompras.qryComprasTotalAfterScroll(DataSet: TDataSet);
begin
  if FGerandoRelatorio and not qryComprasTotal.eof then
  begin
   FGTotalVenda := FGTotalVenda + qryComprasTotaltotalvenda.AsFloat;
   FGTotalCusto := FGTotalCusto + qryComprasTotaltotalcusto.AsFloat;
  end
  else
  begin
  if Assigned(ComprasTotalAfterScroll) then
    ComprasTotalAfterScroll(DataSet)
  end;

//  Visualizacao := fVisualizacao;
end;

procedure TdtmConsultaCompras.qryVVendasmesGetText(Sender: TField; var Text: String; DisplayText: Boolean);
begin
  if TField(Sender).IsNull then
    Text := ' '
  else
    Text := TField(Sender).AsString;
end;

procedure TdtmConsultaCompras.frpComprasEndDoc;
begin
  FGerandoRelatorio := False;
end;

procedure TdtmConsultaCompras.frpComprasBeginDoc;
begin
  FGerandoRelatorio := True;
  FGTotalVenda := 0;
  FGTotalCusto := 0;
end;

procedure TdtmConsultaCompras.frpComprasBeforePrint(Memo: TStringList;
  View: TfrView);
begin
  inherited;
  ZebrarLinhaRelatorio(frpCompras, view);
end;

procedure TdtmConsultaCompras.ImprimirRelatorio;
var
  Relatorio: TfrReport;
  frmPreview: TfrmPreviewPadrao;
  RegistroAtual : TBookmark;
begin
 RegistroAtual := qryComprasTotal.GetBookmark;
 frVariables['Outras'] := FParametroCabecalho;
 frVariables['Rua']   := RuaFilialBase;
 frVariables['Bairro']:= BairroFilialBase + ' - CEP: ' + CEPFilialBase;
 frVariables['Cidade']:= CidadeFilialBase + ' - ' + EstadoFilialBase;
 frVariables['Fone']  := FoneFilialBase;
 frVariables['EmLinha']:=FprodutoEmLinha;
 frVariables['ForadeLinha']:=FprodutoForadeLinha;
 frVariables['Ativo']:=Fprodutoativo;
 frVariables['Inativo']:=Fprodutoinativo;
 frVariables['ComMontagem']:=FProdutoComMontagem;
 frVariables['SemMontagem']:=FProdutoSemMontagem;
 frVariables['Brinde']:=FProdutoBrinde;
 frVariables['NaoBrinde']:=FProdutoNaoBrinde;

 frVariables['Composto']:=FProdutoComposto;
 frVariables['NaoComposto']:=FProdutoNaoComposto;

 delete(FCabecalhoSaldoEstoque, (length(FCabecalhoSaldoEstoque)-2), 2);
 frVariables['SaldoEstoque']:= FCabecalhoSaldoEstoque;

 qryComprasTotal.DisableControls;
// frpCompras.DesignReport;
 frmPreview := TfrmPreviewPadrao.create(self);
 frmPreview.cmbZoom.ItemIndex := 3; //125%
 frmPreview.sbnLarguraPaginaClick(nil);
 try
   Relatorio := frmPreview.frCompositeReport;
   frmPreview.frCompositeReport.Reports.Clear;
   frmPreview.frCompositeReport.Reports.Add(frpCompras);
   Relatorio.Preview := frmPreview.frPreviewPadrao;
   Relatorio.ShowReport;

   frmPreview.ShowModal;

  finally

   frmPreview.Free

 end;

 qryComprasTotal.EnableControls;
 qryComprasTotal.GotoBookmark(RegistroAtual);
 qryComprasTotal.FreeBookmark(RegistroAtual);
end;

function TdtmConsultaCompras.GetListaFiliais: TStrings;
begin
  FListaFiliais:= TStringList.Create;
  qryFiliais.Open;
  while not qryFiliais.Eof do
  begin
    FListaFiliais.AddObject(format('%3s',[qryFiliaiscodigo.AsString])+'.'+qryFiliaisnome.AsString, Pointer(qryFiliaiscodigo.AsInteger));
    qryFiliais.Next;
  end;
  qryFiliais.Close;
  Result := FListaFiliais;
end;

function TdtmConsultaCompras.GetListaGruposFiliais: TStrings;
begin
  FListaGruposFiliais:= TStringList.Create;
  qryGrupoFiliais.Open;
  while not qryGrupoFiliais.Eof do
  begin
    FListaGruposFiliais.AddObject(format('%2s',[qryGrupoFiliaiscodigo.asstring])+'.'+qryGrupoFiliaisdescricao.AsString, Pointer(qryGrupoFiliaiscodigo.AsInteger));
    qryGrupoFiliais.Next;
  end;
  qryGrupoFiliais.Close;
  Result := FListaGruposFiliais;

end;

procedure TdtmConsultaCompras.MontarFiltroFiliais(Usar: TCheckListBox);
var
  STRFiliais: String;
  cnt: Integer;
begin
  TodasFiliais := True;
  STRFiliais := '';
  FilialRequisitante := inttostr(FilialBase);
//  SomenteUmaFilialSelecionada := false;

  for cnt := 0 to FListaFiliais.Count - 1 do
    if Usar.Checked[cnt] then
    begin
      STRFiliais := STRFiliais + '''' + IntToStr(Integer(FListaFiliais.Objects[cnt])) + ''',';
      {
      if (FilialRequisitante = '') and not SomenteUmaFilialSelecionada then
      begin
        FilialRequisitante := IntToStr(Integer(FListaFiliais.Objects[cnt]));
        SomenteUmaFilialSelecionada := true;
      end
      }
    end
    else
      TodasFiliais := False;

  STRFiliais := Copy(STRFiliais, 0, Length(STrFiliais) - 1);

  SomenteUmaFilialMarcada := false;
  if Trim(STRFiliais) <> '' then
    SomenteUmaFilialMarcada := pos(',',STRFiliais)=0;

  Filial := STRFiliais;
  if Trim(STRFiliais) <> '' then
    if not TodasFiliais then
      FParametroCabecalho:=FParametroCabecalho+' Filiais: '+STRFiliais
    else Filial:='';

  if (Trim(STRFiliais) = '') then
    TodasFiliais := true;


end;

procedure TdtmConsultaCompras.MontarFiltroGrupoFiliais(
  Usar: TCheckListBox);
var
  STRGruposFiliais: String;
  cnt: Integer;
begin
  STRGruposFiliais := '';
  TodosGrupos := True;
  for cnt := 0 to FListaGruposFiliais.Count - 1 do
    if Usar.Checked[cnt] then
      STRGruposFiliais := STRGruposFiliais + '''' + IntToStr(Integer(FListaGruposFiliais.Objects[cnt])) + ''','
    else
      TodosGrupos := False;

  STRGruposFiliais := Copy(STRGruposFiliais, 0, Length(STrGruposFiliais) - 1);
  GrupoFilial:=STRGruposFiliais;
  if Trim(STRGruposFiliais) <> '' then
    if not TodosGrupos then
     FParametroCabecalho:=FParametroCabecalho+' Grupo de Filiais: '+STRGruposFiliais
    else
     GrupoFilial:='';

  if (Trim(STRGruposFiliais) = '') then
    TodosGrupos := true;

end;




procedure TdtmConsultaCompras.qryComprasTotalCalcFields(
  DataSet: TDataSet);
var
  vListaProdutosSimilares: String;

begin
  inherited;

  if qryComprasTotalprodutoempromocao.asBoolean then
    qryComprasTotalpromo.asString := 'S'
  else
    qryComprasTotalpromo.clear;

  if FParametroTotalizacao = 0 then
  begin
    qryComprasTotaltotalvenda.AsFloat := (qryComprasTotalsugestao.AsCurrency *
                                           qryComprasTotalprecovenda.asfloat);

    qryComprasTotaltotalcusto.AsFloat := (qryComprasTotalsugestao.AsCurrency *
                                           qryComprasTotalprecocomicms.asfloat);
  end
  else
  begin
    qryComprasTotaltotalvenda.AsFloat := (qryComprasTotaltotal_vendido.AsCurrency *
                                           qryComprasTotalprecovenda.asfloat);

    qryComprasTotaltotalcusto.AsFloat := (qryComprasTotaltotal_vendido.AsCurrency *
                                           qryComprasTotalprecocomicms.asfloat);
  end;

  qryComprasTotalcodigo_descricao.AsString := (qryComprasTotalprodutovisual.AsString + ' - ' +
                                               qryComprasTotalnomeproduto.AsString);

  { OBSERVAÇÃO:  O cálculo abaixo deve ser executado somente uma vez após a abertura da tabela,
    quando é alterado o campo sugestão esta pssando por todos os registros e recalculando a consulta....
    muito demorado....
    }

  if qryComprasTotalExisteSimilar.asBoolean  then
  begin
    qryTotalProdutosSimilares.MacroByName('Filiais').AsString := qryComprasTotal.MacroByName('Filiais').AsString;
    if (qryTotalProdutosSimilares.paramByName('produto').asString <> qryComprasTotalproduto.AsString) or
       (qryTotalProdutosSimilares.paramByName('PedidosEntreFiliais').asBoolean <> PedidosEntreFiliais) or
       (qryTotalProdutosSimilares.paramByName('NaoConsiderarPedidosCompra').asBoolean <> NaoConsiderarPedidosCompra) or
       (qryTotalProdutosSimilares.paramByName('NaoConsiderarPedidosCompraparaDiasEstoque').asBoolean <> NaoConsiderarPedidosCompraparaDiasEstoque) or
       (qryTotalProdutosSimilares.paramByName('inicio').asString <> FParametroDataInicial) or
       (qryTotalProdutosSimilares.paramByName('fim').asString <> FParametroDataFinal) or
       (qryTotalProdutosSimilares.paramByName('periodo').asString <> GetPeriodo) or
       (qryTotalProdutosSimilares.paramByName('diasproporcional').asString <> FParametroDiasEstoqueProporcional) or
       (qryTotalProdutosSimilares.paramByName('diasestoque').asString <> FParametroDiasEstoque) then
    begin
      RefazConsultaPorNome(qryListaProdutosSimilares, ['produto'], [qryComprasTotalproduto.AsString]);
      vListaProdutosSimilares := RetornarLista(qryListaProdutosSimilares, [qryListaProdutosSimilarescodigo]);
      if vListaProdutosSimilares<>'' then
        vListaProdutosSimilares := vListaProdutosSimilares + ',('+ qryComprasTotalproduto.AsString+')';

      qryTotalProdutosSimilares.MacroByName('ListaProdutosSimilares').AsString := vListaProdutosSimilares;

      ReFazConsultaporNome(qryTotalProdutosSimilares,['produto','PedidosEntreFiliais',
                                                  'NaoConsiderarPedidosCompra',
                                                  'NaoConsiderarPedidosCompraparaDiasEstoque',
                                                  'inicio','fim', 'periodo',
                                                  'diasproporcional', 'diasestoque'],
                         [qryComprasTotalproduto.AsString,
                          PedidosEntreFiliais,
                          NaoConsiderarPedidosCompra,
                          NaoConsiderarPedidosCompraparaDiasEstoque,
                          FParametroDataInicial,
                          FParametroDataFinal,
                          GetPeriodo,
                          FParametroDiasEstoqueProporcional,
                          FParametroDiasEstoque
                          ]);
    end;
    qryComprasTotaldiasEstoqueSimilares.AsFloat := qryTotalProdutosSimilaresDiasEstoque.asFloat;
  end
  else
    qryComprasTotaldiasEstoqueSimilares.clear;


{
  if qryComprasTotaltotal_vendido.AsCurrency<>0 then
    qryComprasTotaldiasestoque.AsCurrency := ((qryComprasTotaltotal_estoque.AsCurrency + qryComprasTotaltotal_pedidos_filiais.AsCurrency)/
                                             (qryComprasTotaltotal_vendido.AsCurrency  /
                                              DaysBetween(strtoDateTime(ParametroDataInicial), StrToDateTime(ParametroDataFinal))))
  else
    qryComprasTotaldiasestoque.AsCurrency := 0;

}

  if qryComprasTotaltotal_vendido.asFloat <> 0 then
  begin
    if NaoConsiderarPedidosCompraparaDiasEstoque then
      qryComprasTotaldiasEstoqueCalculado.asFloat :=
         (qryComprasTotaltotal_estoque.AsFloat +
  {        qryComprasTotaltotal_pedido.AsFloat +  ver com JR }
          qryComprasTotalsugestao.AsFloat) /
          (qryComprasTotaltotal_vendido.AsFloat / qryComprasTotalperiodo.AsInteger)
    else
      qryComprasTotaldiasEstoqueCalculado.asFloat :=
         (qryComprasTotaltotal_estoque.AsFloat +
          qryComprasTotaltotal_pedido.AsFloat +
          qryComprasTotalsugestao.AsFloat) /
          (qryComprasTotaltotal_vendido.AsFloat / qryComprasTotalperiodo.AsInteger);
  end
  else
    qryComprasTotaldiasEstoqueCalculado.asFloat := 999999.99

end;

procedure TdtmConsultaCompras.frpComprasGetValue(const ParName: String;
  var ParValue: Variant);
begin
  inherited;
  if ParName = 'PRODUTO' then
   ParValue := qryComprasTotalprodutovisual.AsString
  else
  if ParName = 'NOMEPRODUTO' then
   ParValue := qryComprasTotalnomeproduto.AsString
  else
  if ParName = 'MARCA' then
   ParValue := qryComprasTotalmarca.AsString
  else
  if ParName = 'REFERENCIA' then
   ParValue := qryComprasTotalreferencia.AsString
  else
  if ParName = 'TOTAL_ESTOQUE' then
   ParValue := qryComprasTotaltotal_estoque.AsCurrency
  else
  if ParName = 'TOTAL_PEDIDO' then
   ParValue := qryComprasTotaltotal_pedido.AsInteger
  else
  if ParName = 'TOTAL_VENDIDO' then
   ParValue := qryComprasTotaltotal_vendido.AsCurrency
  else
  if ParName = 'SUGESTAO' then
   ParValue := qryComprasTotalsugestao.AsCurrency
  else
  if ParName = 'PRECOVENDA' then
   ParValue := FormatarValor(qryComprasTotalprecovenda.AsFloat,2)
  else
  if ParName = 'TOTALVENDA' then
   ParValue := FormatarValor(qryComprasTotaltotalvenda.AsFloat,2)
  else
  if ParName = 'MARKUP' then
   ParValue := FormatarValor(qryComprasTotalmarkup.AsFloat,2)
  else
  if ParName = 'TOTALCUSTO' then
   ParValue := FormatarValor(qryComprasTotaltotalcusto.AsFloat,2)
  else
  if ParName = 'PRECOCOMICMS' then
   ParValue := FormatarValor(qryComprasTotalprecocomicms.AsFloat,2)
  else
  if ParName = 'DATACOMPRA' then
   ParValue := formatdatetime('dd/mm/yy', qryComprasTotaldatacompra.AsDateTime)
  else
  if ParName = 'QtDECOMPRA' then
   ParValue := qryComprasTotalQtdecompra.AsCurrency
  else
  if ParName = 'GTOTALVENDA' then
   ParValue := FormatarValor(FGTotalVenda,2)
  else
  if ParName = 'GTOTALCUSTO' then
   ParValue := FormatarValor(FGTotalCusto,2)
  else
  if ParName = 'ABC' then
   ParValue := qryComprasTotalresultadocurvaabc.asstring;

end;

procedure TdtmConsultaCompras.SetVisualizacao(const Value: Integer);
begin
  FVisualizacao := Value;
  if not AbaSimilares then
  begin

    case FVisualizacao of
      0: begin
           dsrVVendas.DataSet := qryVVendas;

             {
           if qryDetalhesPrecos.active then
           begin
             qryDetalhesPrecos.mastersource := nil;

             qryDetalhesPrecos.linkfields := 'produto=produto';
             qryDetalhesPrecos.mastersource := dsrComprasFiliaisGrupo;
             qryDetalhesPrecos.first;
             while not qryDetalhesPrecos.eof do
             begin
               if (qryDetalhesPrecosultimavenda.ascurrency<>0) then
                 qryDetalhesPrecos.next
               else
                 break;
             end;
           end;
             }
         end;

      1: begin
           dsrVVendas.DataSet := qryVVendas_porGrupo;

           {
           if qryDetalhesPrecos.active then
           begin
             qryDetalhesPrecos.mastersource := nil;
             qryDetalhesPrecos.linkfields := 'produto=produto';
             qryDetalhesPrecos.mastersource := dsrComprasFiliaisGrupo;

             qryDetalhesPrecos.first;
             while not qryDetalhesPrecos.eof do
             begin
               if (qryDetalhesPrecosgrupo.asstring = qryComprasGruposFiliaisgrupo.asString) and
                 (qryDetalhesPrecosultimavenda.ascurrency<>0) then
                 break;

               qryDetalhesPrecos.next;
             end;
           end;
           }

         end;

      2: begin
           dsrVVendas.DataSet := qryVVendas_porFilial;

           {
           if qryDetalhesPrecos.active then
           begin
             qryDetalhesPrecos.mastersource := nil;
             qryDetalhesPrecos.linkfields := 'produto=produto;filial=filial';
             qryDetalhesPrecos.mastersource := dsrComprasFiliaisGrupo;
             dsrComprasFiliaisGrupo.dataset.next;
             dsrComprasFiliaisGrupo.dataset.prior;
           end;
           }
         end;
    end;

  end
  else
  begin

    case FVisualizacao of
      0: begin
           dsrVVendasSimilares.DataSet := qryVVendas_Similares;

            {
           if qryDetalhesPrecos_Similiares.active then
           begin

             qryDetalhesPrecos_Similiares.mastersource := nil;
             qryDetalhesPrecos_Similiares.linkfields := 'produto=produto';
             qryDetalhesPrecos_Similiares.mastersource := dsrComprasFiliaisGrupoSimilares;

             qryDetalhesPrecos_Similiares.first;

             while not qryDetalhesPrecos_Similiares.eof do
             begin
               if (qryDetalhesPrecos_Similiaresultimavenda.ascurrency=0) then
                 qryDetalhesPrecos_Similiares.next
               else
                 break;
             end;
           end;
            }

         end;

      1: begin
           dsrVVendasSimilares.DataSet := qryVVendas_porGrupo_Similares;

           {
           if qryDetalhesPrecos_Similiares.active then
           begin

             qryDetalhesPrecos_Similiares.mastersource := nil;
             qryDetalhesPrecos_Similiares.linkfields := 'produto=produto';
             qryDetalhesPrecos_Similiares.mastersource := dsrComprasFiliaisGrupoSimilares;

             qryDetalhesPrecos_Similiares.first;

             while not qryDetalhesPrecos_Similiares.bof do
             begin
               if (qryDetalhesPrecos_Similiaresgrupo.asstring = qryComprasGruposFiliais_Similaresgrupo.asString) and
                  (qryDetalhesPrecos_Similiaresultimavenda.ascurrency<>0) then
                 break;

               qryDetalhesPrecos_Similiares.next;
             end;
           end;
           }

         end;

      2: begin
           dsrVVendasSimilares.DataSet := qryVVendas_porFilial_Similares;

           {
           if qryDetalhesPrecos_Similiares.active then
           begin
             qryDetalhesPrecos_Similiares.mastersource := nil;
             qryDetalhesPrecos_Similiares.linkfields := 'produto=produto;filial=filial';
             qryDetalhesPrecos_Similiares.mastersource := dsrComprasFiliaisGrupoSimilares;

             dsrComprasFiliaisGrupoSimilares.dataset.last;
             dsrComprasFiliaisGrupoSimilares.dataset.first;
           end;
           }
         end;
    end;
  end;
end;

