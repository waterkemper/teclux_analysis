end;

procedure TdtmConsultaCompras.SelecionarProdutos(Marcar, Todos: Boolean);
begin
 if qryComprasTotal.Active then
 begin
   if Todos then
    begin
      try
        GuardarRegistroAtual(qryComprasTotal,True);
        qryComprasTotal.First;
        while not qryComprasTotal.Eof do
        begin
          qryComprasTotal.Edit;
          qryComprasTotalselecionado.Asboolean:= Marcar;
          qryComprasTotal.Post;
          qryComprasTotal.Next;
        end;
      finally
        VoltarRegistroAtual(qryComprasTotal);
      end;
    end
    else
    begin
//      GuardarRegistroAtual(qryComprasTotal,True);

      try

//        qryComprasTotal.oncalcFields := nil;

        qryComprasTotal.Edit;
        qryComprasTotalselecionado.asBoolean:= not qryComprasTotalselecionado.asBoolean;
        qryComprasTotal.Post;
      finally
//        qryComprasTotal.oncalcFields := qryComprasTotalCalcFields; 
      end;
//      VoltarRegistroAtual(qryComprasTotal);
    end;
  end;  
end;

function TdtmConsultaCompras.VerificarSelecionados: Boolean;
var i:Integer;
begin
  i:=0;
  try
    GuardarRegistroAtual(qryComprasTotal,True);
    qryComprasTotal.First;
    while not qryComprasTotal.Eof do
    begin
      if qryComprasTotalselecionado.Asboolean then
      begin
         inc(i);
         break;
      end;
      qryComprasTotal.Next;
    end;
  finally
    VoltarRegistroAtual(qryComprasTotal);
  end;
  Result:= i =0;
end;

procedure TdtmConsultaCompras.qryComprasGruposFiliaisCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  {
  if qryComprasGruposFiliaistotal_vendido.AsCurrency<>0 then
    qryComprasGruposFiliaisdiasestoque.AsCurrency := ((qryComprasGruposFiliaistotal_estoque.AsCurrency + qryComprasGruposFiliaistotal_pedidos_filiais.AsCurrency)/
                                             (qryComprasGruposFiliaistotal_vendido.AsCurrency  /
                                              DaysBetween(strtoDateTime(ParametroDataInicial), StrToDateTime(ParametroDataFinal))))
  else
    qryComprasGruposFiliaisdiasestoque.clear;
  }
end;

procedure TdtmConsultaCompras.qryComprasFiliaisGrupoCalcFields(
  DataSet: TDataSet);
begin
  inherited;
       {
  if qryComprasFiliaisGrupototal_vendido.AsCurrency<>0 then
    qryComprasFiliaisGrupodiasestoque.AsCurrency := ((qryComprasFiliaisGrupototal_estoque.AsCurrency + qryComprasFiliaisGrupototal_pedidos_filiais.AsCurrency)/
                                             (qryComprasFiliaisGrupototal_vendido.AsCurrency  /
                                              DaysBetween(strtoDateTime(ParametroDataInicial), StrToDateTime(ParametroDataFinal))))
  else
    qryComprasFiliaisGrupodiasestoque.clear;
       }

  if qryComprasGruposFiliaistotal_estoque.AsFloat <> 0 then
    qryComprasFiliaisGrupopercestoque.AsFloat := qryComprasFiliaisGrupototal_estoque.AsFloat * 100  / qryComprasGruposFiliaistotal_estoque.AsFloat
  else
    qryComprasFiliaisGrupopercestoque.AsFloat := 0;

  if qryComprasFiliaisGrupototal_vendido.asFloat <> 0 then
  begin
    if NaoConsiderarPedidosCompraparaDiasEstoque then
      qryComprasFiliaisGrupodiasEstoqueCalculado.asFloat :=
         (qryComprasFiliaisGrupototal_estoque.AsFloat +
  {        qryComprasFiliaisGrupototal_pedido.AsFloat +  ver com JR }
          qryComprasFiliaisGruposugestao.AsFloat) /
          (qryComprasFiliaisGrupototal_vendido.AsFloat / qryComprasFiliaisGrupoperiodo.AsInteger)
    else
      qryComprasFiliaisGrupodiasEstoqueCalculado.asFloat :=
         (qryComprasFiliaisGrupototal_estoque.AsFloat +
          qryComprasFiliaisGrupototal_pedido.AsFloat +
          qryComprasFiliaisGruposugestao.AsFloat) /
          (qryComprasFiliaisGrupototal_vendido.AsFloat / qryComprasFiliaisGrupoperiodo.AsInteger);
  end
  else
    qryComprasFiliaisGrupodiasEstoqueCalculado.asFloat := 999999.99


end;

function TdtmConsultaCompras.GerarDadosRequisicoes: Boolean;
var
  vtotalfiliaisemestoque : Currency;

  procedure AdicionarPedidosFiliais;
  begin
    qryPedidosFiliais_.Append;
    qryPedidosFiliais_produto.AsString := qryComprasFiliaisGrupoProduto.AsString;

{    if qryComprasFiliaisGrupofilial.AsString = FilialRequisitante then
      qryPedidosFiliais_produtovisual.AsString := ' '+qryComprasTotalProdutovisual.AsString
    else}
      qryPedidosFiliais_produtovisual.AsString := qryComprasTotalProdutovisual.AsString;

    if qryComprasFiliaisGrupofilial.AsString = FilialRequisitante then
      qryPedidosFiliais_descricaoproduto.AsString := 'TOTAL FILIAL REQUISITANTE: '+FilialRequisitante+' - '+MnemonicoFilialBase
      { + qryComprasTotalnomeproduto.AsString}
    else
      qryPedidosFiliais_descricaoproduto.AsString := qryComprasTotalnomeproduto.AsString;

    qryPedidosFiliais_requisitante.AsString := FilialRequisitante;

    qryPedidosFiliais_quantidade.AsCurrency := qryComprasTotalsugestao.AsCurrency;

    qryPedidosFiliais_requisitada.Asinteger := qryComprasFiliaisGrupofilial.asinteger;
    qryPedidosFiliais_mnemonico.AsString := qryComprasFiliaisGrupomnemonico.asString;
    qryPedidosFiliais_emestoque.AsCurrency :=  qryComprasFiliaisGrupoEmestoque.asCurrency;
    qryPedidosFiliais_emestoqueanterior.AsCurrency :=  qryComprasFiliaisGrupoemEstoque.asCurrency;

    qryPedidosFiliais_diasestoque.AsCurrency :=  qryComprasFiliaisGrupodiasestoque.asCurrency;
    qryPedidosFiliais_diasestoquecalculado.AsCurrency :=  qryComprasFiliaisGrupodiasEstoqueCalculado.asCurrency;

    qryPedidosFiliais_reservado.AsCurrency :=  qryComprasFiliaisGruporeservado.AsCurrency;
    qryPedidosFiliais_transito.AsCurrency :=  qryComprasFiliaisGrupototal_transito.AsCurrency;
    qryPedidosFiliais_reservaprevia.AsCurrency :=  qryComprasFiliaisGruporeservaprevia.AsCurrency;
    qryPedidosFiliais_futuro.AsCurrency :=  qryComprasFiliaisGrupofuturo.AsCurrency;
    qryPedidosFiliais_total_vendido.AsCurrency :=  qryComprasFiliaisGrupototal_vendido.AsCurrency;
    qryPedidosFiliais_sugestao.AsCurrency :=  qryComprasFiliaisGruposugestao.AsCurrency;

    IF qryComprasFiliaisGrupoperiodo.asinteger = 0 THEN
      qryPedidosFiliais_periodo.asinteger := 1
    else
      qryPedidosFiliais_periodo.asinteger := qryComprasFiliaisGrupoperiodo.asinteger;

    qryPedidosFiliais_total_pedido.asCurrency :=  qryComprasFiliaisGrupototal_pedido.AsCurrency;


    qryPedidosFiliais_.post;

  end;

begin

  result := false;

  requisicoesgeradas := false;
  ListadeProdutosRequisitados := '';

  qryPedidosFiliais_.readonly := false;
  qryPedidosFiliais_.close;
  qryPedidosFiliais_.open;


  try

    dsrPedidosFiliais_.onDataChange := nil;
    qryPedidosFiliais_.AfterScroll := nil;
    qryPedidosFiliais_.beforepost := nil;


    GuardarRegistroAtual(qryComprasTotal, false);
    qryComprasTotal.First;
    while not qryComprasTotal.Eof do
    begin

      if qryComprasTotalselecionado.AsBoolean and
         (qryComprasTotalsugestao.AsCurrency <> 0) then
      begin

        vtotalfiliaisemestoque := 0;
        ListadeProdutosRequisitados := ListadeProdutosRequisitados + qryComprasTotalproduto.AsString +',';

        try
        {
          qryComprasFiliaisGrupo.mastersource := nil;
          qryComprasFiliaisGrupo.linkfields := 'produto=produto';
          qryComprasFiliaisGrupo.mastersource := dsrComprasGruposFiliais;
          }

          qryComprasGruposFiliais.afterscroll := nil;
          qryComprasFiliaisGrupo.afterscroll := nil;
          dsrPedidosFiliais_.onDataChange := nil;

          {
          qryPedidosFiliais.Append;
          qryPedidosFiliaisproduto.AsString := qryComprasTotalProduto.AsString;
          qryPedidosFiliaisprodutovisual.AsString := qryComprasTotalProdutovisual.AsString;

          qryPedidosFiliaisdescricaoproduto.AsString := qryComprasTotalnomeproduto.AsString;
          qryPedidosFiliaisrequisitante.AsString := FilialRequisitante;
          qryPedidosFiliaisquantidade.AsCurrency := qryComprasTotalsugestao.AsCurrency;

          qryPedidosFiliaisrequisitada.AsVariant := null;
          qryPedidosFiliaismnemonico.AsString := fMnemonicoFilialBase;
          qryPedidosFiliaisemestoque.AsCurrency :=  qryComprasTotaltotal_estoque.asCurrency;
          qryPedidosFiliaisemestoqueanterior.AsCurrency :=  qryComprasTotaltotal_estoque.asCurrency;

          qryPedidosFiliaisdiasestoque.AsCurrency :=  qryComprasTotaldiasestoque.asCurrency;
          qryPedidosFiliaisdiasestoquecalculado.AsCurrency :=  qryComprasTotaldiasEstoqueCalculado.asCurrency;

          qryPedidosFiliaisreservado.AsCurrency :=  qryComprasTotalreservado.AsCurrency;
          qryPedidosFiliaistransito.AsCurrency :=  qryComprasTotaltotal_transito.AsCurrency;
          qryPedidosFiliaisreservaprevia.AsCurrency :=  qryComprasTotalreservaprevia.AsCurrency;
          qryPedidosFiliaisfuturo.AsCurrency :=  qryComprasTotalfuturo.AsCurrency;
          qryPedidosFiliaistotal_vendido.AsCurrency :=  qryComprasTotaltotal_vendido.AsCurrency;
          qryPedidosFiliaissugestao.AsCurrency :=  qryComprasTotalsugestao.AsCurrency;

          IF qryComprasTotalperiodo.asinteger = 0 THEN
            qryPedidosFiliaisperiodo.asinteger := 1
          else
            qryPedidosFiliaisperiodo.asinteger := qryComprasTotalperiodo.asinteger;

          qryPedidosFiliaistotal_pedido.asCurrency :=  qryComprasTotaltotal_pedido.AsCurrency;

          qryPedidosFiliais.post;
          }


          qryComprasGruposFiliais.first;
          while not qryComprasGruposFiliais.eof do
          begin

            qryComprasFiliaisGrupo.first;
            while not qryComprasFiliaisGrupo.eof do
            begin

              IF (qryComprasFiliaisGrupoemEstoque.ascurrency <> 0) and
                 (qryComprasFiliaisGrupofilial.asString <> FilialRequisitante) and
                 (qryComprasFiliaisGrupotipofilial.asString <> 'V') and
                 not qryPedidosFiliais_.locate('produto;requisitada',
                     VarArrayOf([qryComprasFiliaisGrupoProduto.asString,
                                 qryComprasFiliaisGrupoFilial.asString]), []) then
              begin

                vtotalfiliaisemestoque := vtotalfiliaisemestoque + qryComprasFiliaisGrupoEmestoque.asCurrency;

                AdicionarPedidosFiliais;

              end;

              qryComprasFiliaisGrupo.next;
            end;

            qryComprasFiliaisGrupo.first;
            while not qryComprasFiliaisGrupo.eof do
            begin
              IF (qryComprasFiliaisGrupofilial.asString = FilialRequisitante) and
                 (qryComprasFiliaisGrupotipofilial.asString <> 'V') and
                 not qryPedidosFiliais_.locate('produto;requisitada',
                     VarArrayOf([qryComprasFiliaisGrupoProduto.asString,
                                 qryComprasFiliaisGrupoFilial.asString]), []) then
              begin
                AdicionarPedidosFiliais;
                break;
              end;

              qryComprasFiliaisGrupo.next;
            end;

            qryComprasGruposFiliais.next;
          end;
        finally
        {
          qryComprasFiliaisGrupo.mastersource := nil;
          qryComprasFiliaisGrupo.linkfields := 'produto=produto;grupo=grupo';
          qryComprasFiliaisGrupo.mastersource := dsrComprasGruposFiliais;
          }

          qryComprasGruposFiliais.afterscroll := qryComprasGruposFiliaisafterscroll;
          qryComprasFiliaisGrupo.afterscroll := qryComprasFiliaisGrupoafterscroll;
          dsrPedidosFiliais_.onDataChange := dsrPedidosFiliais_DataChange;

        end;

      end;

      AtribuirDados(qryPedidosFiliais_,
                    [qryPedidosFiliais_totalfiliaisemestoque],
                    [vtotalfiliaisemestoque],
                    [qryPedidosFiliais_produto],
                    [qryComprasTotalproduto.asVariant],
                    ['=']);

      qryComprasTotal.next;
    end;
  finally
    VoltarRegistroAtual(qryComprasTotal);
    if length(ListadeProdutosRequisitados)<>0 then
      delete(ListadeProdutosRequisitados, length(ListadeProdutosRequisitados), 1);

    result := qryPedidosFiliais_.recordcount <> 0;

    dsrPedidosFiliais_.onDataChange := dsrPedidosFiliais_DataChange;
    qryPedidosFiliais_.AfterScroll := qryPedidosFiliais_AfterScroll;
    qryPedidosFiliais_.beforepost := qryPedidosFiliais_beforepost;
    
  end;


end;

procedure TdtmConsultaCompras.qryComprasTotalAfterInsert(
  DataSet: TDataSet);
begin
  inherited;
  qryComprasTotal.cancel; 

end;

procedure TdtmConsultaCompras.qryComprasFiliaisGrupo_SimilaresCalcFields(
  DataSet: TDataSet);
begin
  inherited;

  if qryComprasGruposFiliais_Similarestotal_estoque.AsFloat <> 0 then
    qryComprasFiliaisGrupo_Similarespercestoque.AsFloat := qryComprasFiliaisGrupo_Similarestotal_estoque.AsFloat * 100  / qryComprasGruposFiliais_Similarestotal_estoque.AsFloat
  else
    qryComprasFiliaisGrupo_Similarespercestoque.AsFloat := 0;

end;

function TdtmConsultaCompras.VerificarEstoqueFilialRequisitada(
           FilialRequisitada, mnemonico : String;
          { UsarFilialGeral,}
           ChecarEstoqueFilialSolicitada: boolean): boolean;
var
  vQuantidadeEstoque: Currency;
  vRegistroAtual : Tbookmark;
  vExisteDiferencaSaldoEstoque : Boolean;
  vLista : String;
begin
  vTotalAtendido := 0;

  if (qryPedidosFiliais_.state in [dsinsert, dsedit]) then
    qryPedidosFiliais_.post;

  result := qryPedidosFiliais_.recordcount <> 0;
  if result then
  begin
    vExisteDiferencaSaldoEstoque  := false;
    qryEstoques.Close;
             {
    if usarfilialgeral then
      qryEstoques.MacroByName('Condicao').AsString := ' and f.codigo = ' + FilialRequisitada + ' and e.produto in ('+
        RetornarLista(qryPedidosFiliais, qryPedidosFiliaisproduto) + ')'
    else
    }
     vLista := RetornarLista(qryPedidosFiliais_, [qryPedidosFiliais_produto, qrypedidosfiliais_requisitada], nil) + ')';

      qryEstoques.MacroByName('Condicao').AsString := ' and (e.produto, e.filial) in ('+
        RetornarLista(qryPedidosFiliais_, [qryPedidosFiliais_produto, qrypedidosfiliais_requisitada], nil) + ')';

    qryEstoques.Open;

//    ExisteAlgumEstoquenaFilialRequisitada := false;
    vRegistroAtual := qryComprasTotal.GetBookmark;
    GuardarRegistroAtual(qryPedidosFiliais_,True);
  //  qryComprasTotal.DisableControls;
  //  qryComprasGruposFiliais.DisableControls;
  //  qryComprasFiliaisGrupo.DisableControls;

    try
      qryPedidosFiliais_.First;
      while not qryPedidosFiliais_.Eof do
      begin

      {
        qryPedidosFiliais_.Edit;
        qryPedidosFiliais_emestoque.clear;
        qryPedidosFiliais_.post;
        }

        if {(usarfilialgeral and
            qryEstoques.Locate('produto', qryPedidosFiliaisproduto.AsString, [])) or}

           ({not usarfilialgeral and  }
            qryEstoques.Locate('produto;filial', VarArrayOf([qryPedidosFiliais_produto.AsString, qrypedidosfiliais_requisitada.asinteger]), [])) then

        begin

          if qryPedidosFiliais_emestoque.AsCurrency <> qryEstoquesemestoque.AsCurrency then
          begin
            qryPedidosFiliais_.readonly := false;
            
            qryPedidosFiliais_.Edit;
            qryPedidosFiliais_emestoque.AsCurrency := qryEstoquesemestoque.AsCurrency;

  //          if not ChecarEstoqueFilialSolicitada then
  //            qryPedidosFiliaisqtdeestoqueanterior.AsCurrency := qryEstoquesemestoque.AsCurrency;

  {
            if usarfilialgeral then
            begin
              qryPedidosFiliaisrequisitada.AsString := FilialRequisitada;
              qryPedidosFiliaismnemonico.asString := mnemonico;
            end;
            }

            qryPedidosFiliais_.post;
          end;

          if qryPedidosFiliais_requisitante.asinteger <> qryPedidosFiliais_requisitada.asinteger then
            vTotalAtendido := vTotalAtendido + qryPedidosFiliais_qtdepedida.asCurrency;

          if ChecarEstoqueFilialSolicitada and
             (qryPedidosFiliais_emestoque.AsCurrency <> qryPedidosFiliais_emestoqueanterior.AsCurrency) then
               vExisteDiferencaSaldoEstoque  := true;

//          ExisteAlgumEstoquenaFilialRequisitada := true;
        end
        else
          MensagemAviso(format('O produto %s não esta presente na filial requisitada %s.',
            [qryPedidosFiliais_produtovisual.AsString,
              qrypedidosfiliais_requisitada.asString]));

        qryPedidosFiliais_.Next;
      end;

      if vExisteDiferencaSaldoEstoque then
      begin
         if assigned(drawGridPedidosFiliais) then
            drawGridPedidosFiliais(nil);

         result := MensagemConfirmacao('Existem diferenças no saldo do estoque de alguns produtos.') = smbOk;
      end;

    finally

      VoltarRegistroAtual(qryPedidosFiliais_);
      qryComprasTotal.GotoBookmark(vRegistroAtual);
      qryComprasTotal.FreeBookmark(vRegistroAtual);
  //    qryComprasTotal.EnableControls;
  //    qryComprasGruposFiliais.EnableControls;
  //    qryComprasFiliaisGrupo.EnableControls;
    end;
  end;

end;


function TdtmConsultaCompras.IncluirPedidosFiliais: boolean;
var
 DadosFilial : TVariantArray;
 FilialEstoque : String;
 vRetornoMensagem : TMessageButton;
 vRegistrosGravados : boolean;
begin
  vRegistrosGravados := false;
  result := true;

  {Se o pedido já existir e estiver em aberto: acrescentar qtde ao pedido}
  qryAtualizarPedidosFiliais.Close;
  qryAtualizarPedidosFiliais.MacroByName('ListadeProdutosFilialRequisitada').AsString :=
  RetornarLista(qryPedidosFiliais_, [qryPedidosFiliais_produto, qrypedidosfiliais_requisitada], qryPedidosFiliais_IrParaLista);

  qryAtualizarPedidosFiliais.parambyname('Requisitante').AsString := FilialRequisitante;

  qryAtualizarPedidosFiliais.open;

  GuardarRegistroAtual(qryPedidosFiliais_, true);
  qryPedidosFiliais_.First;

  while not qryPedidosFiliais_.Eof do
  begin

    IF (qryPedidosFiliais_qtdepedida.AsCurrency > 0) and
       (qryPedidosFiliais_requisitante.asinteger <> qryPedidosFiliais_requisitada.asinteger) THEN
    BEGIN
      result := true;

      if not parsistema.Permitir_Requisicoes_de_Produtos_Duplicadas and

         qryAtualizarPedidosFiliais.Locate('produto;requisitada',
         VarArrayOf([qryPedidosFiliais_produto.asstring,
                     qryPedidosFiliais_requisitada.asstring]), []) then
      begin

        vRetornoMensagem := smbYES;

        if qryAtualizarPedidosFiliaisqtdepedida.AsCurrency = qryPedidosFiliais_qtdepedida.AsCurrency then
          vRetornoMensagem := MensagemSelecionaOpcao(
                                format('A quantidade requisitada para a filial ''%s'' e produto ''%s'' ficará com quantidade dobrada.',
                                       [qryPedidosFiliais_requisitada.asstring,
                                        qryPedidosFiliais_produtovisual.asstring]));


        case vRetornoMensagem of
        smbYES: begin
                  result := true;
                  qryAtualizarPedidosFiliais.Edit;
                  qryAtualizarPedidosFiliaisqtdepedida.AsCurrency := qryAtualizarPedidosFiliaisqtdepedida.AsCurrency + qryPedidosFiliais_qtdepedida.AsCurrency {qryPedidosFiliais_qtdeAtendida.AsCurrency};
                  qryAtualizarPedidosFiliaisdata.AsDateTime := DataServidor;
                  qryAtualizarPedidosFiliaishora.AsDateTime := HoraServidor;

                  if qryPedidosFiliais_observacao.asString<>'' then
                  begin
                    if qryAtualizarPedidosFiliaisobservacao.asString <> '' then
                      qryAtualizarPedidosFiliaisobservacao.asString := qryAtualizarPedidosFiliaisobservacao.asString + ' ';

                    qryAtualizarPedidosFiliaisobservacao.asString := qryAtualizarPedidosFiliaisobservacao.asString +
                                                                     qryPedidosFiliais_observacao.asString;
                  end;
                  qryAtualizarPedidosFiliais.post;
                  vRegistrosGravados := true;
                end;

        smbNo: result := false;
        smbCancel : begin
                      result := false;
                      exit;
                    end;
        end;
      end
      else
      begin
        result := true;
        qryAtualizarPedidosFiliais.Append;
        spcPedidosTransferenciaProximoCodigo.Open;
        qryAtualizarPedidosFiliaiscodigo.AsInteger:= spcPedidosTransferenciaProximoCodigonumero.AsInteger;
        spcPedidosTransferenciaProximoCodigo.Close;
        qryAtualizarPedidosFiliaisproduto.asstring := qryPedidosFiliais_produto.AsString;
        qryAtualizarPedidosFiliaisdata.asdatetime := DataServidor;
        qryAtualizarPedidosFiliaishora.AsDateTime := HoraServidor;
        qryAtualizarPedidosFiliaisrequisitante.AsString := FilialRequisitante;
        qryAtualizarPedidosFiliaisrequisitada.asstring := qryPedidosFiliais_requisitada.asstring;
        qryAtualizarPedidosFiliaisqtdepedida.AsCurrency := qryPedidosFiliais_qtdepedida.AsCurrency {qryPedidosFiliais_qtdeAtendida.AsCurrency};
        qryAtualizarPedidosFiliaissituacao.asstring := 'A';
        qryAtualizarPedidosFiliaisobservacao.asVAriant := qryPedidosFiliais_observacao.asVariant;

        qryAtualizarPedidosFiliais.post;
        vRegistrosGravados := true;

      end;

      if result then
        if (ParSistema.RequisicaoSubtraiEstoque) then
        begin
          if not qryMovimentos.Active then
            qryMovimentos.Open;

          qryEstoqueBloqueio.Sql[05] := '((e.produto = ' + qryAtualizarPedidosFiliaisproduto.AsString + ')and' +
                                  '(e.filial = '   + qryAtualizarPedidosFiliaisrequisitada.asstring  + '))';
          qryEstoqueBloqueio.Open;
          qryMovimentos.Append;

          (*
          spcMovimentosProximo.Open;
          qryMovimentosnumero.AsInteger := spcMovimentosProximonumero.AsInteger;
          spcMovimentosProximo.Close;
          *)

          qryMovimentosproduto.AsLargeInt   := qryAtualizarPedidosFiliaisproduto.AsLargeInt;

          DadosFilial := ValorCampodaTabela('filiais', ['codigo'], [qryAtualizarPedidosFiliaisrequisitada.asstring], ['tipofilial', 'filial_estoque']);


          if DadosFilial[1]<>null then
            FilialEstoque := DadosFilial[1];

          if (DadosFilial[0]='V') and (DadosFilial[1]=Null) then
            FilialEstoque := qryAtualizarPedidosFiliaisrequisitada.asstring
          else
          if (DadosFilial[0]<>'V') then
            FilialEstoque := qryAtualizarPedidosFiliaisrequisitada.asstring;

          //qryMovimentosfilial.AsVariant    := qryAtualizarPedidosFiliaisrequisitada.AsVariant;
          qryMovimentosfilial.AsVariant    := StrToInt(FilialEstoque);
          qryMovimentosreferencia.AsString :='REQUISIÇÃO ' + qryAtualizarPedidosFiliaiscodigo.AsString;
          qryMovimentosquantidade.Ascurrency := qryPedidosFiliais_qtdepedida.AsCurrency {qryPedidosFiliaisqtdeAtendida.AsCurrency};
          qryMovimentostipomovimento.AsString:='TEP';
          qryMovimentos.Post;

        end;

    END;

    qryPedidosFiliais_.next;
  end;

  VoltarRegistroAtual(qryPedidosFiliais_);

  if vRegistrosGravados  then
  begin
    result := Perpetrar([qryAtualizarPedidosFiliais,qryMovimentos]);
    if result then
    begin
      requisicoesgeradas := true;
      MensagemAviso('Requisições geradas com sucesso.');
    end;
  end
  else
  begin
    requisicoesgeradas := false;
    MensagemAviso('Nenhuma Requisição foi gerada.');
    result := false;
  end;


end;

procedure TdtmConsultaCompras.BloquearEstoque;
begin

end;

function TdtmConsultaCompras.LerArquivoCFG(Gravar: Boolean = false; ValorPedidosEntreFiliais: boolean = false): Boolean;
var
  ArquivoCFG: TIniFile;
  PosSeparador: Integer;
  Barra: String;
begin
{$IFDEF LINUX}
  Barra := '/';
{$ELSE }
  Barra := '\';
{$ENDIF}
  if ParamCount >= 1 then
    NomeArquivoCFG := ParamStr(1) + Barra + ctNomeArquivoCFG
  else
    NomeArquivoCFG := ExtractFilePath(Application.ExeName)+ ctNomeArquivoCFG;

  if FileExists(NomeArquivoCFG) then
  begin
    ArquivoCFG := TIniFile.Create(NomeArquivoCFG);
    try
{$IFDEF LINUX}
      ArquivoCFG.CaseSensitive := False;
{$ENDIF}
      try
        if not ArquivoCFG.SectionExists(ConsultaComprasSection) then
        begin
          ArquivoCFG.Writebool(ConsultaComprasSection,'PedidosEntreFiliais',false);
          ArquivoCFG.UpdateFile;
        end;
        
        if Gravar then
        begin
          ArquivoCFG.WriteBool(ConsultaComprasSection, 'PedidosEntreFiliais', ValorPedidosEntreFiliais);
          ArquivoCFG.UpdateFile;
        end
        else
          PedidosEntreFiliais := ArquivoCFG.ReadBool(ConsultaComprasSection, 'PedidosEntreFiliais', false);

      finally
      end;
    finally
      ArquivoCFG.Free
    end;
  end
  else
  begin
    MensagemErro(Format(ctERRORARQUIVOCFGNAOENCONTRADO, [NomeArquivoCFG]));
    Result := False
  end;
end;

