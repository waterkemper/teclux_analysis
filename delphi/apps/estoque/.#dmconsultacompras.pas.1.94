procedure TdtmConsultaCompras.dsrProdutosSimilaresDataChange(
  Sender: TObject; Field: TField);
begin
  inherited;
  if (Field = qryProdutosSimilaresminimo) or (Field = qryProdutosSimilaresmaximo) then
  begin

      if qryProdutosSimilaresmaximo.isnull then
        qryAtualizarEstoque.ParamByName('maximo').Clear
      else
        qryAtualizarEstoque.ParamByName('maximo').asCurrency := qryProdutosSimilaresmaximo.asCurrency;

      if qryProdutosSimilaresminimo.isnull then
        qryAtualizarEstoque.ParamByName('minimo').Clear
      else
        qryAtualizarEstoque.ParamByName('minimo').asCurrency := qryProdutosSimilaresminimo.asCurrency;

      qryAtualizarEstoque.ParamByName('produto').asString := qryProdutosSimilaresproduto.AsString;
      qryAtualizarEstoque.ParamByName('filial').AsString := somentenumero(Filial);

      qryAtualizarEstoque.ExecSql;
      perpetrar([qryAtualizarEstoque]);

      if qryProdutosSimilaresPrincipal.asBoolean then
      begin
        dsrComprasTotal.onDataChange := nil;
        qryComprasTotal.edit;
        qryComprasTotalmaximo.value := qryProdutosSimilaresmaximo.value;
        qryComprasTotalminimo.value := qryProdutosSimilaresminimo.value;
        qryComprasTotal.post;
        dsrComprasTotal.onDataChange := dsrComprasTotalDataChange; 
      end;


  end;
end;

procedure TdtmConsultaCompras.dsrPedidosFiliais_DataChange(Sender: TObject;
  Field: TField);
var
 v_recno : integer;
begin
  inherited;
  if not qryPedidosFiliais_.readonly then
  begin
    if field = qryPedidosFiliais_qtdepedida then
    begin
      if field.ascurrency > qryPedidosFiliais_emestoque.ascurrency then
      begin
        MensagemErro('A quantidade digitada excede à existente na filial');
//        dsrPedidosFiliais_.onDataChange := nil;
        field.clear;

        if assigned(AfterPostPedidosFiliais) then
          AfterPostPedidosFiliais(Sender);

//        field.focuscontrol;
//        dsrPedidosFiliais_.onDataChange := dsrPedidosFiliais_DataChange;
      end
      else
      begin

        CalcularTotalAtendido(true);
        if assigned(AfterPostPedidosFiliais) then
          AfterPostPedidosFiliais(Sender);

      end;
    end
    else
    if field = qryPedidosFiliais_observacao then
    begin
      try
        dsrPedidosFiliais_.ondatachange := nil;
        qryPedidosFiliais_.GuardarRegistroAtual(true);

        AtribuirDados(qrypedidosfiliais_,
                      [qryPedidosFiliais_observacao],
                      [qryPedidosFiliais_observacao.AsVariant],
                      [qryPedidosFiliais_produto, qryPedidosFiliais_requisitada, qryPedidosFiliais_observacao ],
                      [qryPedidosFiliais_produto.asvariant, filialrequisitante, Null],
                      ['=','<>','=']);
      finally
        dsrPedidosFiliais_.ondatachange := dsrPedidosFiliais_datachange;
        qryPedidosFiliais_.VoltarRegistro;
      end;


    end;

  end;


end;


procedure TdtmConsultaCompras.qryPedidosFiliais_CalcFields(
  DataSet: TDataSet);
begin
  inherited;
  qryPedidosFiliais_IrParaLista.asBoolean :=
          (qryPedidosFiliais_requisitante.asinteger <>
           qryPedidosFiliais_requisitada.asinteger) and
          (qryPedidosFiliais_qtdepedida.ascurrency <> 0);


  if qryPedidosFiliais_totalfiliaisemestoque.AsCurrency >= qryPedidosFiliais_quantidade.AsCurrency then
    qryPedidosFiliais_qtdeAtendida.AsCurrency := qryPedidosFiliais_quantidade.AsCurrency
  else
    qryPedidosFiliais_qtdeAtendida.AsCurrency := qryPedidosFiliais_totalfiliaisemestoque.AsCurrency;


  if (qryPedidosFiliais_total_vendido.asFloat <> 0) and
     (qryPedidosFiliais_periodo.AsInteger <> 0) then
  begin
    if qryPedidosFiliais_requisitante.asinteger = qryPedidosFiliais_requisitada.asinteger then
    begin
      if NaoConsiderarPedidosCompraparaDiasEstoque then
        qryPedidosFiliais_diasestoquecalculado.asFloat :=
           (qryPedidosFiliais_emestoque.AsFloat +
  {          qryPedidosFiliais_total_pedido.AsFloat +  ver com JR }
            qryPedidosFiliais_sugestao.AsFloat +
            qryPedidosFiliais_qtdepedida.asFloat
            ) /
            (qryPedidosFiliais_total_vendido.AsFloat / qryPedidosFiliais_periodo.AsInteger)

      else
        qryPedidosFiliais_diasestoquecalculado.asFloat :=
           (qryPedidosFiliais_emestoque.AsFloat +
            qryPedidosFiliais_total_pedido.AsFloat +
            qryPedidosFiliais_sugestao.AsFloat +
            qryPedidosFiliais_qtdepedida.asFloat
            ) /
            (qryPedidosFiliais_total_vendido.AsFloat / qryPedidosFiliais_periodo.AsInteger);
    end
    else
    begin
      if NaoConsiderarPedidosCompraparaDiasEstoque then
        qryPedidosFiliais_diasestoquecalculado.asFloat :=
           (qryPedidosFiliais_emestoque.AsFloat +
  {          qryPedidosFiliais_total_pedido.AsFloat +  ver com JR }
            qryPedidosFiliais_sugestao.AsFloat -
            qryPedidosFiliais_qtdepedida.asFloat
            ) /
            (qryPedidosFiliais_total_vendido.AsFloat / qryPedidosFiliais_periodo.AsInteger)

      else
        qryPedidosFiliais_diasestoquecalculado.asFloat :=
           (qryPedidosFiliais_emestoque.AsFloat +
            qryPedidosFiliais_total_pedido.AsFloat +
            qryPedidosFiliais_sugestao.AsFloat -
            qryPedidosFiliais_qtdepedida.asFloat
            ) /
            (qryPedidosFiliais_total_vendido.AsFloat / qryPedidosFiliais_periodo.AsInteger);
    end;
  end
  else
    qryPedidosFiliais_diasestoquecalculado.asFloat := 999999.99


end;

procedure TdtmConsultaCompras.qryDetalhesCompraCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  if qryDetalhesCompracustomedio.asCurrency <> 0 then
    qryDetalhesCompramarkup.asCurrency :=
      ((qryDetalhesPrecosvalornormal.asCurrency / qryDetalhesCompracustomedio.asCurrency) -1) * 100
end;

procedure TdtmConsultaCompras.qryDetalhesCompra_SimilaresCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  if qryDetalhesCompra_Similarescustomedio.asCurrency <> 0 then
    qryDetalhesCompra_Similaresmarkup.asCurrency :=
      ((qryDetalhesPrecos_Similiaresvalornormal.asCurrency / qryDetalhesCompra_Similarescustomedio.asCurrency) -1) * 100

end;

