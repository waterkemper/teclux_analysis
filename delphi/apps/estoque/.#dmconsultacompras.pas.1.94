function TdtmConsultaCompras.GetListaConceitos: TStrings;
begin
  FListaConceitos:= TStringList.Create;
  qryConceitos.Open;
  while not qryConceitos.Eof do
  begin
    FListaConceitos.AddObject(format('%2s',[qryConceitoscodigo.AsString])+'.'+qryConceitosdescricao.AsString, Pointer(qryConceitoscodigo.AsInteger));
    qryConceitos.Next;
  end;
  qryConceitos.Close;
  Result := FListaConceitos;

end;

procedure Tdtmconsultacompras.MontarFiltroConceitos(
  Usar: TCheckListBox);
var
  STRConceitos: String;
  TodosConceitos : Boolean;
  cnt: Integer;
begin
  TodosConceitos := True;
  STRConceitos := '';
  for cnt := 0 to FListaConceitos.Count - 1 do
    if Usar.Checked[cnt] then
      STRConceitos := STRConceitos + IntToStr(Integer(FListaConceitos.Objects[cnt])) + ','
    else
      TodosConceitos:=false;
  STRConceitos := Copy(STRConceitos, 0, Length(STRConceitos) - 1);
  Conceitos := STRConceitos ;
  if Trim(STRConceitos) = '' then
      Conceitos := ''
  else
      Conceitos :=''+STRConceitos+'';
end;

procedure TdtmConsultaCompras.SetConceitos(const Value: String);
begin


  if (Value <> '') then
  begin
    qryComprasTotal.ParamByName('conceitos').AsString:=value;
    qryComprasGruposFiliais.ParamByName('conceitos').AsString:=Value;
    qryComprasFiliaisGrupo.ParamByName('conceitos').AsString:=Value;
    qryVVendas.ParamByName('conceitos').AsString:=value;
    qryVVendas.MacroByName('FILTRO_CONCEITO').AsString := Format(FiltroConceito,['fc.',Value]);

    qryVVendasDiaria.ParamByName('conceitos').AsString:=value;
    qryVVendasDiaria.MacroByName('FILTRO_CONCEITO').AsString := Format(FiltroConceito,['fc.',Value]);


  end
  ELSE
  BEGIN
    qryComprasGruposFiliais.ParamByName('conceitos').AsString:='';
    qryComprasFiliaisGrupo.ParamByName('conceitos').AsString:='';
    qryVVendas.ParamByName('conceitos').AsString:='';
    qryVVendas.MacroByName('FILTRO_CONCEITO').AsString := '(select true=true) ';

    qryVVendasDiaria.ParamByName('conceitos').AsString:='';
    qryVVendasDiaria.MacroByName('FILTRO_CONCEITO').AsString := '(select true=true) ';

  END;
  {
   FParametroCabecalho:=FParametroCabecalho+' Conceitos: '+Value;


   qryDadosFiscaisProdutosVendas.SQL[
     NumerodalinhanoTexto(qryDadosFiscaisProdutosVendas.SQL,
                          '%WhereConceito')+1] := Format(FiltroConceito,['df.',Value]);

   qryDadosFiscaisProdutosDevolucoes.Sql[
     NumerodalinhanoTexto(qryDadosFiscaisProdutosDevolucoes.Sql,
                          '%WhereConceito')+1] := Format(FiltroConceito,['ct.',Value]);


   qryDadosFiscaisProdutosVendaFrenteCaixa.SQL[
     NumerodalinhanoTexto(qryDadosFiscaisProdutosVendaFrenteCaixa.SQL,
                          '%WhereConceito')+1] := Format(FiltroConceito,['df.',Value]);

   qryDadosFiscaisProdutosDevolucoesFrenteCaixa.Sql[
     NumerodalinhanoTexto(qryDadosFiscaisProdutosDevolucoesFrenteCaixa.Sql,
                          '%WhereConceito')+1] := Format(FiltroConceito,['vf.',Value]);
  end
  else
  begin

   qryDadosFiscaisProdutosVendas.SQL[
     NumerodalinhanoTexto(qryDadosFiscaisProdutosVendas.SQL,
                          '%WhereConceito')+1] := '';

   qryDadosFiscaisProdutosDevolucoes.Sql[
     NumerodalinhanoTexto(qryDadosFiscaisProdutosDevolucoes.Sql,
                          '%WhereConceito')+1] := '';

   qryDadosFiscaisProdutosVendaFrenteCaixa.SQL[
     NumerodalinhanoTexto(qryDadosFiscaisProdutosVendaFrenteCaixa.SQL,
                          '%WhereConceito')+1] := '';

   qryDadosFiscaisProdutosDevolucoesFrenteCaixa.Sql[
     NumerodalinhanoTexto(qryDadosFiscaisProdutosDevolucoesFrenteCaixa.Sql,
                          '%WhereConceito')+1] := '';
  end;
}
end;

