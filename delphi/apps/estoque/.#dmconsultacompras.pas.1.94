  qryTotalProdutosSimilaresminimo.DisplayFormat                   := '#######'; //ParSistema.MascaraQuantidadeGrade;//'#######';
  qryTotalProdutosSimilaressugestaominimo.DisplayFormat           := '#######'; //ParSistema.MascaraQuantidadeGrade;//'#######';
  qryTotalProdutosSimilaresmaximo.DisplayFormat                   := '#######'; //ParSistema.MascaraQuantidadeGrade;//'#######';
  qryTotalProdutosSimilaressugestaomaximo.DisplayFormat           := '#######'; //ParSistema.MascaraQuantidadeGrade;//'#######';



  qryComprasGruposFiliais_Similarestotal_estoque.displayformat    := '#######'; //ParSistema.MascaraQuantidadeGrade;//'#######';
