      item
        DataType = ftUnknown
        Name = 'ListaCondicionalVendedores'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListaCondicionalContratos'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select  distinct'
      '        np.codigo,'
      '        np.codigofiscal,'
      '        np.serie,'
      '        np.filial,'
      '        np.numero,'
      '        np.data,'
      '        np.fornecedor,'
      '        np.tipofornecedor,'
      '        np.estado,'
      '        np.valornota,'
      '        np.situacao,'
      '        false as selecionar'
      ''
      ''
      'From (notaspag np'
      ''
      '     join (produtosnotaspag pnp'
      
        '          join (produtos p left join promocoes pro on p.promocao' +
        ' = pro.codigo)'
      '               join (((caracteristicas c'
      '                    join grupos g'
      '                    on g.codigo = c.grupo)'
      '                    join classes cl'
      '                    on cl.codigo = c.classe)'
      '                    join marcas m'
      '                    on m.codigo = c.marca)'
      '               on p.caracteristica = c.codigo'
      '          on pnp.produto = p.codigo)'
      '     on np.codigo = pnp.codigonota)'
      ''
      '     join vfornecedores vf'
      '     on np.fornecedor = vf.codigo'
      '     and np.tipofornecedor = vf.tipo'
      ''
      '     left join usuarios u'
      '     on np.vendedor = u.codigo'
      ''
      'Where %true_or_false'
      ''
      '  %WhereFornecedor'
      '  %WhereFilial'
      '  %WhereSerie'
      '  %WhereNumero'
      '  %WhereEmissao'
      '  %WhereLancto'
      '  %WhereCfop'
      '  %WhereSituacaoNotaEntrada'
      '  %TipodeNota'
      ''
      '  %ListaItemProdutos'
      '  %ListaProdutos'
      '  %ListaGrupos'
      '  %ListaClasses'
      '  %ListaMarcas'
      '  %ListaCondicionalPromocoes'
      '  %ListaCondicionalNotasEntrada'
      ''
      '  %ListaCondicionalVendedores'
      '  %ListaCondicionalContratos'
      ''
      'order by np.data desc, np.codigo desc')
    RequestLive = True
    Left = 42
    Top = 482
