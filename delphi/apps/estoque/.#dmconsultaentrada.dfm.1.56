      '              sf.serie'
      'FROM     seriesfornecedores sf'
      'WHERE (sf.fornecedor = :fornecedor) and'
      '              (sf.serie = :serie) and'
      '               ('#39'F'#39' = :tipo)'
      'UNION'
      'SELECT sc.cliente,'
      '              sc.serie'
      'FROM    seriesclientes sc'
      'WHERE (sc.cliente =:fornecedor) and'
      '             (sc.serie =:serie) and'
      '             ('#39'C'#39' =:tipo)'
      'union'
      'select sf.filial,'
      '         sf.valor as serie'
      'from seriesfiliais sf'
      'where (sf.filial = :FilialBase) and'
      '           (sf.valor = :serie) and'
      '          ('#39'C'#39' = :tipo) and'
      '          ((select count(*)'
      '             from seriesclientes'
      '             where cliente = :fornecedor) = 0)'
      'UNION'
      'SELECT sf.filial,'
      '             sf.valor as serie'
      'FROM    seriesfiliais sf'
      'WHERE (sf.filial = :fornecedor) and'
      '             (sf.valor = :serie) and'
      '             ('#39'L'#39' = :tipo)'
      'ORDER BY serie')
