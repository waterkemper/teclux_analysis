  object qryProcuraNaturezas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryProcuraNaturezasBeforeOpen
    AfterOpen = qryProcuraNaturezasAfterOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereInativo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereRunTime'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      ' select selecionado.* from'
      '('
      '('
      'select case when '#39'F'#39' = :local then codigofiscal + 1000'
      '                  when '#39'E'#39' = :local then codigofiscal + 2000'
      '                    else                        codigofiscal'
      '         end as codigofiscal,'
      '        descricao,'
      '        codigo,'
      
        '        (select cf.descricao from codigosfiscais cf where cf.cod' +
        'igo = codigofiscal) as descricaocfop,'
      '        gerarpagamento'
      'from naturezas                    '
      'where  (tipo = '#39'E'#39') '
      
        '     and   (((codigofiscal          = :codigofiscal) and ('#39'L'#39' = ' +
        ':local)) or'
      
        '              ((codigofiscal+1000 = :codigofiscal) and ('#39'F'#39' = :l' +
        'ocal)) or'
      
        '              ((codigofiscal+2000 = :codigofiscal) and ('#39'E'#39' = :l' +
        'ocal)))'
      ''
      '%WhereInativo'
      '%WhereRunTime'
      ''
      ')'
      'union all'
      '('
      'select :codigofiscal  as codigofiscal,'
      '          descricao,'
      '         codigo,'
      
        '        (select cf.descricao from codigosfiscais cf where cf.cod' +
        'igo = codigofiscal) as descricaocfop,'
      '        gerarpagamento'
      'from naturezas                      '
      'where (tipo = '#39'E'#39')'
      '   and (:codigofiscal = 1353 or :codigofiscal = 2353) '
      '   and ((codigofiscal = :codigofiscal) or'
      '          (codigofiscal+1000 = :codigofiscal))'
      '%WhereInativo'
      '%WhereRunTime'
      ''
      ')'
      ') as selecionado')
    RequestLive = False
    Left = 52
    Top = 99
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'local'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codigofiscal'
        ParamType = ptUnknown
      end>
