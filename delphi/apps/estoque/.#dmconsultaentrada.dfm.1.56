  object qryNotaFiscal: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterPost = qryNotaFiscalAfterPost
    AfterScroll = qryNotaFiscalAfterScroll
    OnCalcFields = qryNotaFiscalCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT n.Codigo,'
      '       n.Serie,'
      '       n.CodigoFiscal,'
      '       n.CodigoNatureza,'
      '       n.Natureza,'
      '       n.Situacao,'
      '       n.ValorNota,'
      '       n.Numero AS Nota,'
      '       n.TipoFornecedor,'
      '     '
      
        '       CASE WHEN n.TipoFornecedor = '#39'F'#39' THEN (SELECT f.Nome FROM' +
        ' Fornecedores f WHERE n.Fornecedor = f.Codigo)'
      
        '            WHEN n.TipoFornecedor = '#39'L'#39' THEN (SELECT f.Nome FROM' +
        ' Filiais f      WHERE n.Fornecedor = f.Codigo)'
      
        '            WHEN n.TipoFornecedor = '#39'C'#39' THEN (SELECT c.Nome FROM' +
        ' Clientes c     WHERE n.Fornecedor = c.Codigo)'
      '       END AS NomeFornecedor,'
      '       '
      '       n.Fornecedor,'
      '       n.Permitirimprimir,'
      '       n.Filial AS Filial,'
      '       n.Emissao AS DataEmissao,'
      '       n.Data AS Datalancamento,'
      '       n.Estado,'
      '       n.Frete,'
      '       n.FreteInterno,'
      '       n.Seguro,'
      '       n.Acrescimo,'
      '       n.Desconto, n.descontoitem,'
      '       n.DespesasAcessorias,'
      '       n.BaseICMSSubstituicao,'
      '       n.ValorICMSSubstituicao,'
      '       n.DocumentoPag,'
      '       n.Contrato,'
      
        '       (select ct.os from contratos ct where ct.numero = n.contr' +
        'ato) as os,'
      '       n.FornecedorConhecimentoFrete,'
      '       n.SerieConhecimentoFrete,'
      '       n.NumeroConhecimentoFrete,'
      '       EditarCPFouCNPJ(n.cnpj) AS CNPJ,'
      '       n.InscricaoEstadual,'
      '       '
      '      (SELECT np.ValorNota'
      '          FROM NotasPag np'
      
        '          WHERE np.Fornecedor = n.FornecedorConhecimentoFrete AN' +
        'D'
      
        '                np.Serie      = n.SerieConhecimentoFrete      AN' +
        'D'
      '                np.Numero     = n.NumeroConhecimentoFrete'
      '      ) AS FreteExterno,'
      '       '
      '       dp.IRRetido,'
      '       dp.INSSRetido,'
      '       dp.ISSRetido,'
      '       dp.PISRetido,'
      '       dp.COFINSRetido,'
      '       dp.CSLLRetido,'
      '       c.Descricao AS DescricaoCodigoFiscal,'
      '       '
      '      (SELECT f.Nome'
      '          FROM Fornecedores f'
      '          WHERE f.Codigo = n.FornecedorConhecimentoFrete'
      '      ) AS NomeFornecedorConhecimentoFrete,'
      '      '
      '       n.Observacoes,'
      '       n.BaseICMS,'
      '       n.ValorICMS,'
      '            '
      '      (SELECT SUM(pnp.Quantidade * pnp.PrecoUnitario)'
      '          FROM ProdutosNotasPag pnp'
      
        '          WHERE pnp.CodigoNota = n.Codigo) - COALESCE(n.Desconto' +
        ',  0)'
      
        '                                           + COALESCE(n.Acrescim' +
        'o, 0) AS TotalProdutos,'
      ''
      '                                           /*'
      '      (SELECT SUM(pnp.Quantidade * pnp.PrecoUnitario)'
      '          FROM produtosNotaspag pnp'
      '          WHERE pnp.CodigoNota = n.Codigo) AS Valorprodutos,'
      '          */'
      ''
      '       n.valorprodutos,'
      '       n.ValorIPI,'
      '       n.ValorServicos,'
      '       n.NumLoteNFe,'
      '       n.NumReciboNFe,'
      '       n.NumProtocoloNFe,'
      '       n.NumCancelamentoNFe,'
      '       n.NumInutilizacaoNFe,'
      '       n.CodAleatorio,'
      '       n.DigChaveAcesso,'
      '       n.LocalEntrega_CEP,'
      '       n.Chv_NFe,'
      
        '       CAST(n.Chv_NFe || CAST(n.DigChaveAcesso AS VARCHAR) AS CH' +
        'AR(44)) AS Chave_NFe,'
      '       n.Nome,'
      '       n.Rua,'
      '       n.EndNumero,'
      '       n.EndComplemento,'
      '       n.Bairro,'
      '       n.Cidade,'
      '       n.CEP,'
      '       n.FoneNumero,'
      '       n.FoneDDD,'
      '       n.NomeBairro,'
      '       n.NomeCidade,'
      '       n.cidadeIBGE,'
      '       n.Pais,'
      '       n.NomePais,'
      '       n.ModeloDocto,'
      '       n.FormaEmissao,'
      ''
      '      (SELECT cf.CodigoIBGE'
      '          FROM Cidades cf'
      '          WHERE cf.Estado = f.Estado AND'
      '                cf.Codigo = f.Cidade'
      '      ) AS CodigoCidadeIBGEFilial,'
      ''
      '       f.CNPJ AS CNPJFilial,'
      '       n.StatusNFe,'
      ''
      '       n.Evento,'
      '      (SELECT e.Descricao'
      '          FROM Eventos e'
      '          WHERE e.Codigo = n.Evento'
      '      ) AS EventoDescricao,'
      ''
      '      n.vbcstretdesp,'
      '      n.vicmsstretdesp,'
      ''
      
        '      (select vf.email from vfornecedores vf where vf.codigo = n' +
        '.fornecedor and vf.tipo = n.tipofornecedor) as email'
      ''
      'FROM  (((notaspag n'
      
        '            LEFT JOIN documentospag dp ON n.DocumentoPag = dp.Nu' +
        'mero)'
      
        '                 JOIN CodigosFiscais c ON n.CodigoFiscal = c.Cod' +
        'igo)'
      '                 JOIN Filiais f        ON n.Filial = f.Codigo)'
      ''
      'WHERE n.CodigoFiscal = c.Codigo AND'
      '      n.Filial       = f.Codigo AND'
      '      n.Codigo       = :Codigo'
      '      ')
    RequestLive = True
    Left = 44
    Top = 297
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end>
