    Sql.Strings = (
      'select case when '#39'F'#39' = :local then codigofiscal + 1000'
      '            when '#39'E'#39' = :local then codigofiscal + 2000'
      '            else  codigofiscal'
      '       end as codigofiscal,'
      '       descricao,'
      '       codigo'
      'from naturezas'
      'where (inativo is null) '
      '  and  (tipo = '#39'E'#39')'
      
        '  and exists (select codigo from codigosfiscais where codigofisc' +
        'al = codigo)'
      '      %CodigoFiscal'
      'order by UPPER(TO_ASCII(descricao,'#39'LATIN1'#39'))')
