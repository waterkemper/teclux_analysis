  object qryFreteEntradaNotas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select distinct'
      '       np.fornecedor,'
      '       np.tipofornecedor,'
      '       vf.nome as nomefornecedor,'
      '       np.serie,'
      '       np.numero,'
      '       np.data,'
      '       np.situacao,'
      '       cast(case when np.situacao = '#39'C'#39' then '#39'CANCELADA'#39
      '                 when np.situacao = '#39'N'#39' then '#39'NORMAL'#39
      '                 when np.situacao = '#39'D'#39' then '#39'DENEGADA'#39
      '       end as varchar(9)) as descricaosituacao,'
      '       np.valornota'
      ''
      'from notaspag np'
      '     join vfornecedores vf'
      '     on np.fornecedor = vf.codigo'
      '     and np.tipofornecedor = vf.tipo'
      ''
      
        'where np.fornecedorconhecimentofrete = :fornecedorconhecimentofr' +
        'ete'
      '  and np.serieconhecimentofrete = :serieconhecimentofrete'
      '  and np.numeroconhecimentofrete = :numeroconhecimentofrete'
      ''
      'ORDER by np.data, np.numero'
      '')
    RequestLive = False
    Left = 493
    Top = 248
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'fornecedorconhecimentofrete'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'serieconhecimentofrete'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'numeroconhecimentofrete'
        ParamType = ptUnknown
      end>
