  object qryProdutos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = []
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryProdutosAfterOpen
    AfterScroll = qryProdutosAfterScroll
    ExtraOptions = []
    Macros = <>
    Sql.Strings = (
      'Select  pn.numero,'
      '        pn.codigonota,'
      '        pn.produto,'
      '        p.codigovisual as produtovisual,'
      '        pn.quantidade,'
      '        pn.precounitario,'
      '        (pn.quantidade * pn.precounitario) as total,'
      '        pn.desconto,'
      '        pn.valordescontoitem,'
      '        pn.aliquotaicms,'
      '        pn.aliquotaipi,'
      '        pn.pedido,'
      '        p.descricao,'
      '        p.referencia,'
      
        '        (select gr.descricao from grades gr where gr.codigo = c.' +
        'grade1) as linha,'
      
        '        (select gr.descricao from grades gr where gr.codigo = c.' +
        'grade2) as coluna,'
      '        p.valorgrade1,'
      '        p.valorgrade2,'
      '        pn.codigofiscal,'
      '        pn.classificacaofiscal,'
      '        pn.origem,'
      '        pn.incidencia,'
      '        pn.unidade,'
      '        pn.icmsbasecalculo,'
      '        pn.icmsvalor,'
      '        pn.valoripi,'
      '        n.filial,'
      '        n.serie,'
      '        n.numero as numeronota,'
      '        df.data,'
      '        df.chv_nfe,'
      ''
      '        cast(rtrim((select textcat_all(pnps.numeroserie||'#39', '#39')'
      '         from produtosnotaspagseries pnps'
      '         where pnps.codigonota = pn.codigonota'
      '           and pnps.numero = pn.numero'
      '           and pnps.produto = pn.produto'
      
        '         order by pn.numero),'#39', '#39') as varchar(1000)) as ListaNum' +
        'eroSeries'
      ''
      ''
      ''
      'From    notaspag np,'
      '        (produtosnotaspag pn'
      '         left join (dadosfiscais df'
      '                    join notas n'
      '                    on df.numero = n.dadofiscal)'
      '        on pn.dadofiscal = df.numero),'
      '        produtos p, caracteristicas c'
      ''
      'Where  pn.produto = p.codigo and'
      '       p.caracteristica = c.codigo and'
      '       np.codigo = pn.codigonota and'
      '       pn.codigonota =:codigoNota'
      ''
      
        'Order By pn.numero, UPPER(TO_ASCII(p.descricao,'#39'LATIN1'#39')), p.val' +
        'orgrade1, p.valorgrade2')
    RequestLive = False
    Left = 44
    Top = 353
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CodigoNota'
        ParamType = ptUnknown
      end>
