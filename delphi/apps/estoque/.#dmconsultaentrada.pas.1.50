procedure TdtmConsultaEntradas.SetLanctoFinal(const Value: String);
begin
  FLanctoFinal := Value;
  qryEntradas.MacroByName('WhereLancto').AsString := MontarIntervaloData('np.data',FLanctoInicial,FLanctoFinal);
{ if not DataEmBranco(Value) then FLanctoFinal := Value
                            else FLanctoFinal := '';
  MontaIntervaloLancto;}
end;

{procedure TdtmConsultaEntradas.SetLanctoInicial(const Value: String);
begin
  if not DataEmBranco(Value) then FLanctoInicial := Value
                             else FLanctoInicial := '';
  MontaIntervaloLancto;
end;
}
procedure TdtmConsultaEntradas.MontaIntervaloLancto;
const
  Data_1 = 'and (np.data = ';
  Data_2 = 'and (np.data between (';
begin
  if not DataEmBranco(FLanctoInicial) then begin
    if DataEmBranco(FLanctoInicial) then
       qryEntradas.MacroByName('WhereLancto').AsString:= Data_1 + '''' + FLanctoInicial + ''')'
    else
       qryEntradas.MacroByName('WhereLancto').AsString:= Data_2 + '''' + FLanctoInicial + ''') and (''' + FLanctoFinal + '''))';
  end
  else begin
    if not DataEmBranco(FLanctoFinal) then
         qryEntradas.MacroByName('WhereLancto').AsString:= Data_1 + '''' + FLanctoFinal + ''')'
    else qryEntradas.MacroByName('WhereLancto').AsString:= '';
  end;
end;
