procedure TdtmConsultaEntradas.ClientDataSetNotasMarcadasFilterRecord(
  DataSet: TDataSet; var Accept: Boolean);
begin
  inherited;
  accept := ClientDataSetNotasMarcadasselecionar.asBoolean;
end;

procedure TdtmConsultaEntradas.qryEntradasAfterOpen(DataSet: TDataSet);
begin
  inherited;
  try
    FRelatorioAtivo := true;
    qryEntradas.AfterScroll:= nil;
    qryEntradas.disablecontrols;

    ClientDataSetNotasSelecionadas.close;
    ClientDataSetNotasSelecionadas.open;

    ClientDataSetNotasMarcadas.close;
    ClientDataSetNotasMarcadas.Open;
  finally
    qryEntradas.enablecontrols;
    qryEntradas.AfterScroll := qryEntradasAfterScroll;
    FRelatorioAtivo := false;
  end;  

end;

end.

