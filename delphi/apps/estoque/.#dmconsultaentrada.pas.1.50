    property  RelatorioAtivo: Boolean read FRelatorioAtivo write FRelatorioAtivo;

    procedure ImprimirListaProdutosporLocalizacao;

    property PodeImprimirNfe: Boolean read GetPodeImprimirNfe;



 end;


implementation

{const
    WhereBase = 09;
    WhereFornecedor = WhereBase + 1;
    WhereFilial     = WhereBase + 2;
    WhereSerie      = WhereBase + 3;
    WhereNumero     = WhereBase + 4;
    WhereEmissao    = WhereBase + 5;
    WhereCfop       = WhereBase + 6;
}
{$R *.dfm}

procedure TdtmConsultaEntradas.AbreTabelaPesquisa(TipoPesquisa: TtecConsultaNotasEntradas);
begin
  case TipoPesquisa of
    cneFORNECEDORES: Abre(ctPesquisaFornecedor);
    cneFILIAIS     : Abre(ctPesquisaFilial);
    cneSERIES      : Abre(ctPesquisaSerie);
    cneNATUREZA    : Abre(ctPesquisaNatureza);
    cneCFOP        : Abre(ctPesquisaCfop);
  end;
end;

function TdtmConsultaEntradas.AlterarNota: Boolean;
var
  Usuario           : TtecUsuarios;
begin
  Result:= False;
  Usuario:= TtecUsuarios.Create(dtmTecSoft.Database);
  try
    if UsuarioLogin.AlterarDadosContabeis then
         Usuario:= ObterAutorizacao(taSENHA)
    else Usuario:= ObterAutorizacao(taLOGIN, ctALTERARDADOSCONTABEIS, ctAUTORIZADO);

    if Assigned(Usuario) then begin
      if Usuario.AlterarDadosContabeis then begin
        Result:= True;
        qryNotaFiscal.Edit;
      end
      else
        MensagemAviso(ctUSUARIOSEMPERMISSAO);
    end;
  finally
    Usuario.Free;
  end;
  {
  Result:= True;
  qryNotaFiscal.Edit;
  }
end;

constructor TdtmConsultaEntradas.Create(AOwner: TComponent);
begin
  inherited;
  try
  qryProcurarFiliais.Tag                := ctTabelas;
  qryProcurarFornecedores.Tag           := ctTabelas;
  qryProcurarSeries.Tag                 := ctTabelas;
  qryProcuraCfop.Tag                    := ctTabelas;
  qryFornecedores.Tag                   := ctTabelas;
  qrySeries.Tag                         := ctTabelas;
  qryProcuraNaturezas.Tag               := ctTabelas;
  qryConsultaFornecedores.Tag           := ctPesquisaFornecedor;
  qryConsultaFiliais.Tag                := ctPesquisaFilial;
  qryConsultaCfop.Tag                   := ctPesquisaCfop;
  qryConsultaSeries.Tag                 := ctPesquisaSerie;
  qryConsultaNaturezas.Tag              := ctPesquisaNatureza;
  qryProcurarSeries.Params[3].AsInteger := FilialBase;
  qrySeries.Params[3].AsInteger         := FilialBase;
  qryConsultaSeries.Params[2].AsInteger := FilialBase;
  qryProdutosquantidade.DisplayFormat   := ParSistema.MascaraQuantidadeGrade;
  qryConsultaNaturezas.MacroByName('CodigoFiscal').AsString := '';
  except
         on E: Exception do ShowMessage(E.Message);
  end;
end;

function TdtmConsultaEntradas.ExisteCfop(Campo, Codigo: String): Boolean;
begin
  Result := ExisteCodigo(qryConsultaCfop, Campo, Codigo);
end;

function TdtmConsultaEntradas.ExisteFilial(Campo, Codigo: String): Boolean;
begin
  Result := ExisteCodigo(qryConsultaFiliais, Campo, Codigo);
end;

function TdtmConsultaEntradas.ExisteFornecedor(Campo, Codigo: String): Boolean;
const
  //SQL = 'Where (to_ascii(%s,''latin1'') ilike to_ascii(''%s%s'',''latin1''))';
  SQL = ' WHERE (upper(to_ascii(%s,''latin1'')) ilike upper(to_ascii(''%s%s'',''latin1'')))';
begin
  if Campo = 'nomecidade' then
    Campo:= 'c.nome'
  else if Campo = 'tipopessoa' then
    Campo:= 'v.tipo'
  else Campo:= 'v.' + Campo;
  qryConsultaFornecedores.Sql[11] := Format(SQL, [Campo, Codigo, '%']);
  qryConsultaFornecedores.Open;
  Result := qryConsultaFornecedores.RecordCount > 0
end;


function TdtmConsultaEntradas.ExisteNatureza(Campo, Codigo: String): Boolean;
begin
  Result := ExisteCodigo(qryConsultaNaturezas, Campo, Codigo);
end;

function TdtmConsultaEntradas.ExisteSerie(Campo, Codigo: String): Boolean;
begin
  Result := ExisteCodigo(qryConsultaSeries, Campo, Codigo);
end;

procedure TdtmConsultaEntradas.FecharTabelas;
begin
  qryEntradas.Close;
  ReFazConsulta(qryNotaFiscal,[0],[0]);
  ReFazConsulta(qryProdutos,  [0],[0]);
  ReFazConsulta(qryCalculosProdutos,  [0,1,2],[0, false, false]);
  ReFazConsulta(qryDuplicatas,[0],[0]);
end;

procedure TdtmConsultaEntradas.FechaTabelaPesquisa(TipoPesquisa: TtecConsultaNotasEntradas);
begin
  case TipoPesquisa of
    cneFORNECEDORES: Fecha(ctPesquisaFornecedor);
    cneFILIAIS     : Fecha(ctPesquisaFilial);
    cneSERIES      : Fecha(ctPesquisaSerie);
    cneNATUREZA    : begin
                       qryConsultaNaturezas.MacroByName('CodigoFiscal').AsString := '';
                       Fecha(ctPesquisaNatureza);
                     end;
    cneCFOP        : Fecha(ctPesquisaCfop);
  end;
end;

function TdtmConsultaEntradas.GerarRelatorio: Boolean;
begin

  qryEntradas.MacrobyName('true_or_false').asString := 'true';
  qryEntradas.AfterOpen := qryEntradasAfterOpen;  {manter desligado em design-time}
  ReFazConsulta(qryEntradas,[],[]);
  Result:= qryEntradas.IsEmpty;
end;

function TdtmConsultaEntradas.GetConsultarFilial: TtecQuery;
begin
  Result := qryConsultaFiliais;
end;

function TdtmConsultaEntradas.GetConsultarCfop: TtecQuery;
begin
  Result := qryConsultaCfop;
end;


function TdtmConsultaEntradas.GetConsultarFornecedor: TtecQuery;
begin
  Result := qryConsultaFornecedores;
end;

function TdtmConsultaEntradas.GetConsultarNatureza: TtecQuery;
begin
  Result:= qryConsultaNaturezas;
end;

function TdtmConsultaEntradas.GetConsultarSerie: TtecQuery;
begin
  Result := qryConsultaSeries;
end;

function TdtmConsultaEntradas.GetEditandoRegistro: Boolean;
begin
  Result:= qryNotaFiscal.State = dsEdit;
end;

function TdtmConsultaEntradas.GetEhDevolucao: Boolean;
begin
  Result:= False;
  if not qryNotaFiscal.IsEmpty then
    Result:= ((qryNotaFiscalcodigofiscal.AsInteger = cfDEVOLUCAODENTROESTADO) or
              (qryNotaFiscalcodigofiscal.AsInteger = cfDEVOLUCAOFORAESTADO)   or
              (qryNotaFiscalcodigofiscal.AsInteger = cfDEVOLUCAOESTRANGEIRO));
end;

function TdtmConsultaEntradas.getPermiteReImprimir: Boolean;
begin
  Result := qryNotaFiscalpermitirimprimir.AsBoolean
end;

function TdtmConsultaEntradas.GetTabelaNotas: TtecQuery;
begin
  Result:= qryNotaFiscal;
end;

function TdtmConsultaEntradas.GetTemDuplicatas: Boolean;
begin
  Result:= (qryDuplicatas.RecordCount > 0);
end;

function TdtmConsultaEntradas.GetTipoPessoa: String;
begin
  if qryProcurarFornecedorestipo.AsString = '' then
       Result:= 'F'
  else Result:= qryProcurarFornecedorestipo.AsString;
end;

function TdtmConsultaEntradas.GravarAlteracoesNota(ExcluindoDuplicatas: Boolean): Boolean;
var
//  Usuario : TtecUsuarios;
  Impostos: Currency;
begin
{
  Result:= False;
  Usuario:= TtecUsuarios.Create(dtmTecSoft.Database);
  try
    if UsuarioLogin.AlterarDadosContabeis then
         Usuario:= ObterAutorizacao(taSENHA)
    else Usuario:= ObterAutorizacao(taLOGIN, ctALTERARDADOSCONTABEIS, ctAUTORIZADO);

    if Assigned(Usuario) then begin
      if Usuario.AlterarDadosContabeis then begin
      }

        Result:= True; Impostos:= 0;
        if qryNotaFiscal.State = dsEdit then begin

          if result then
          begin
            if (qryNotaFiscaldocumentopag.AsInteger > 0) and
               (qryNotaFiscaldocumentopag.OldValue <> null) then begin
              ReFazConsulta(qryDocumentoPag,[0],[qryNotaFiscaldocumentopag.AsInteger]);

              qryDocumentoPag.Edit;
              qryDocumentoPagcomplemento.AsString := Format('%-3s', [qryNotaFiscalserie.AsString]) + '/' +
                                                     Format('%6.6d',[qryNotaFiscalnota.AsInteger]);

              qryDocumentoPagFORNECEDOR.AsInteger := qryNotaFiscalFORNECEDOR.AsInteger; // Carlos 19/06/2006
              qryDocumentoPagEMISSAO.AsDateTime   := qryNotaFiscalDATAEMISSAO.AsDateTime; // Carlos 19/06/2006

              qryDocumentoPag.Post;
            end;

            qryNotaFiscalcodigofiscal.AsInteger:= qryProcuraNaturezascodigofiscal.AsInteger;
            qryNotaFiscalnatureza.AsString     := qryProcuraNaturezasdescricao.AsString;
            qryNotaFiscalcodigonatureza.AsInteger := qryProcuraNaturezascodigo.AsInteger;
            qryNotaFiscal.Post;

            if (qryNotaFiscalcnpj.Value <> qryNotaFiscalcnpj.OldValue) or
               (qryNotaFiscalinscricaoestadual.Value <> qryNotaFiscalinscricaoestadual.OldValue) or
               (qryNotaFiscalestado.value <> qryNotaFiscalestado.OldValue) then
            begin
             qryAtualizarNotas.Parambyname('cnpj').Value := qryNotaFiscalcnpj.Value;
             qryAtualizarNotas.Parambyname('inscricaoestadual').Value := qryNotaFiscalinscricaoestadual.Value;
             qryAtualizarNotas.Parambyname('estado').Value := qryNotaFiscalestado.Value;
             qryAtualizarNotas.Parambyname('fornecedor').Value := qryNotaFiscalfornecedor.Value;
             qryAtualizarNotas.Parambyname('tipofornecedor').Value := qryNotaFiscaltipofornecedor.Value;
             qryAtualizarNotas.Parambyname('codigo').Value := qryNotaFiscalcodigo.Value;
             qryatualizarnotas.ExecSql;
            end;

            if ExcluindoDuplicatas then
                 Perpetrar([qryNotaFiscal,  qryDuplicatas, qryDocumentoPag, qryAtualizarNotas])
            else
                 Perpetrar([qryDocumentoPag, qryDuplicatas, qryNotaFiscal, qryAtualizarNotas]);
          end;
        end
        {
      end
      else
        MensagemAviso(ctUSUARIOSEMPERMISSAO);
    end;
  finally
    Usuario.Free;
  end;   }
end;

procedure TdtmConsultaEntradas.ImprimirNota;
begin
  if MensagemConfirmacao(format(ctREIMPRIMIRNOTADEVOLUCAO, [qryNotaFiscalContrato.AsString])) = smbOk then begin
    dtmImprimeNotaEntrada:= TdtmImprimeNotaEntrada.Create(Self);
    try
      dtmImprimeNotaEntrada.ImprimirNotasPag(qryNotaFiscalcodigo.AsInteger);
    finally
      dtmImprimeNotaEntrada.Free;
      dtmImprimeNotaEntrada:= nil;
    end;
  end;
end;

procedure TdtmConsultaEntradas.MontaIntervaloEmissao;
const
  Data_1 = 'and (np.emissao = ';
  Data_2 = 'and (np.emissao between (';
begin
  if not DataEmBranco(FDataInicial) then begin
    if DataEmBranco(FDataFinal) then
       qryEntradas.MacroByName('WhereEmissao').AsString:= Data_1 + '''' + FDataInicial + ''')'
    else
       qryEntradas.MacroByName('WhereEmissao').AsString:= Data_2 + '''' + FDataInicial + ''') and (''' + FDataFinal + '''))';
  end
  else begin
    if not DataEmBranco(FDataFinal) then
         qryEntradas.MacroByName('WhereEmissao').AsString:= Data_1 + '''' + FDataFinal + ''')'
    else qryEntradas.MacroByName('WhereEmissao').AsString:= '';
  end;
end;

procedure TdtmConsultaEntradas.qryEntradasAfterScroll(DataSet: TDataSet);
begin
  inherited;
  if not FRelatorioAtivo then
  begin
    if not qryEntradas.IsEmpty then
    begin
      if qryEntradasestado.AsString = EstadoFilialBase then begin
        qryProcuraNaturezas.Params[0].AsString         := 'L';
        qryConsultaNaturezas.Params[0].AsString := 'L';
      end else if HeUnidadeFederacao(qryEntradasestado.AsString) then begin
        qryProcuraNaturezas.Params[0].AsString         := 'F';
        qryConsultaNaturezas.Params[0].AsString := 'F';
      end else begin
        qryProcuraNaturezas.Params[0].AsString         := 'E';
        qryConsultaNaturezas.Params[0].AsString := 'E';
      end;
      qryProcuraNaturezas.MacroByName('WhereInativo').asstring := '';

      qryFornecedores.Params[0].AsString    := qryEntradastipofornecedor.AsString;
  //    qryFornecedores.Params[1].AsInteger   := qryEntradasfornecedor.AsInteger;
      qrySeries.Params[0].AsInteger         := qryEntradasfornecedor.AsInteger;
      qrySeries.Params[2].AsString          := qryEntradastipofornecedor.AsString;
      qryConsultaSeries.Params[0].AsInteger := qryEntradasfornecedor.AsInteger;
      qryConsultaSeries.Params[1].AsString  := qryEntradastipofornecedor.AsString;

      ReFazConsulta(qryNotaFiscal,   [0],[qryEntradascodigo.AsInteger]);
      ReFazConsulta(qryProdutos,[0],[qryEntradascodigo.AsInteger]);
      ReFazConsulta(qryCalculosProdutos,[0,1,2],[qryEntradascodigo.AsInteger,(regimetributario=1), contribipi]);

      RefazConsultaPorNome(qryFreteEntradaNotas,['fornecedorconhecimentofrete','serieconhecimentofrete','numeroconhecimentofrete'],
                           [qryEntradasfornecedor.asinteger,
                            qryEntradasserie.asString,
                            qryEntradasnumero.asinteger]);

      qryDuplicatas.Close;
      if (qryNotaFiscaldocumentopag.AsInteger > 0) then
        ReFazConsulta(qryDuplicatas,[0],[qryNotaFiscaldocumentopag.AsInteger]);
    end;
  end;
end;


procedure TdtmConsultaEntradas.qryProcurarFornecedoresAfterOpen(DataSet: TDataSet);
begin
  inherited;
  if qryProcurarFornecedorestipo.AsString = 'F' then begin
    qryProcurarSeries.Params[0].AsInteger := qryProcurarFornecedorescodigo.AsInteger;
    qryProcurarSeries.Params[2].AsString  := 'F';
    qryConsultaSeries.Params[0].AsInteger := qryProcurarFornecedorescodigo.AsInteger;
    qryConsultaSeries.Params[1].AsString  := 'F';
  end else if qryProcurarFornecedorestipo.AsString = 'C' then begin
    qryProcurarSeries.Params[0].AsInteger := qryProcurarFornecedorescodigo.AsInteger;
    qryProcurarSeries.Params[2].AsString  := 'C';
    qryConsultaSeries.Params[0].AsInteger := qryProcurarFornecedorescodigo.AsInteger;
    qryConsultaSeries.Params[1].AsString  := 'C';
  end else if qryProcurarFornecedorestipo.AsString = 'L' then begin
    qryProcurarSeries.Params[0].AsInteger := qryProcurarFornecedorescodigo.AsInteger;
    qryProcurarSeries.Params[2].AsString  := 'L';
    qryConsultaSeries.Params[0].AsInteger := qryProcurarFornecedorescodigo.AsInteger;
    qryConsultaSeries.Params[1].AsString  := 'L';
  end;
end;

procedure TdtmConsultaEntradas.qryProcurarFornecedoresBeforeOpen(DataSet: TDataSet);
begin
  inherited;
  if qryProcurarFornecedores.Params[0].AsString = '' then
    qryProcurarFornecedores.Params[0].AsString:= 'F';
end;

procedure TdtmConsultaEntradas.Selecionar(TipoPesquisa: TtecConsultaNotasEntradas);
begin
  case TipoPesquisa of
   cneFORNECEDORES : begin
                       if EditandoRegistro then begin
                         qryNotaFiscal.Edit;
                         qryNotaFiscalfornecedor.AsInteger:= qryConsultaFornecedorescodigo.AsInteger;
                       end
                       else begin
                         qryProcurarFornecedores.Params[0].AsString:= qryConsultaFornecedorestipo.AsString;
                         RefazConsulta(qryProcurarFornecedores,[1],[qryConsultaFornecedorescodigo.AsInteger]);
                       end
                     end;
   cneFILIAIS      : RefazConsulta(qryProcurarFiliais,[0],[qryConsultaFiliaiscodigo.AsInteger]);
   cneSERIES       : begin
                       if EditandoRegistro then begin
                         qryNotaFiscal.Edit;
                         qryNotaFiscalserie.AsString:= qryConsultaSeriesserie.AsString;
                       end
                       else ReFazConsulta(qryProcurarSeries,[1],[qryConsultaSeriesserie.AsString]);
                     end;
   cneNATUREZA     : begin
                       qryProcuraNaturezas.BeforeOpen := nil;
                       qryNotaFiscal.Edit;
                       qryProcuraNaturezas.MacroByName('WhereRunTime').AsString := ' and (naturezas.codigo = ' + IntToStr(qryConsultaNaturezascodigo.AsInteger) + ') ';
                       qryNotaFiscalcodigofiscal.AsInteger:= qryConsultaNaturezascodigofiscal.AsInteger;
                       qryProcuraNaturezas.BeforeOpen := qryProcuraNaturezasBeforeOpen;
                     end;
   cneCFOP         : RefazConsulta(qryProcuraCfop,[0],[qryConsultaCfopCODIGO.AsInteger]);
  end;
end;

procedure TdtmConsultaEntradas.SetDataFinal(const Value: String);
begin
  FDataFinal := Value;
  qryEntradas.MacroByName('WhereEmissao').AsString := MontarIntervaloData('np.emissao',FDataInicial,FDataFinal);
{  if not DataEmBranco(Value) then FDataFinal := Value
                             else FDataFinal := '';
  MontaIntervaloEmissao;}
end;

{procedure TdtmConsultaEntradas.SetDataInicial(const Value: String);
begin
  if not DataEmBranco(Value) then FDataInicial := Value
                             else FDataInicial := '';
  MontaIntervaloEmissao;
end;
}
procedure TdtmConsultaEntradas.SetCfop(const Value: String);
begin
  if (Value <> '') then qryEntradas.MacroByName('WhereCfop').AsString:= 'and (np.codigofiscal = ' + Value + ')'
                   else qryEntradas.MacroByName('WhereCfop').AsString:= '';
end;


procedure TdtmConsultaEntradas.SetFilial(const Value: String);
begin
  if (Value <> '') then
       qryEntradas.MacroByName('WhereFilial').AsString:= 'and (np.filial = ' + Value + ')'
  else qryEntradas.MacroByName('WhereFilial').AsString:= '';
end;

procedure TdtmConsultaEntradas.SetFornecedor(const Value: String);
begin
  if Value <> '' then
    qryEntradas.MacroByName('WhereFornecedor').AsString:= 'and (np.fornecedor = ' + Value + ') and ' +
                                       '(np.tipofornecedor = ' + QuotedStr(qryProcurarFornecedorestipo.AsString) + ')'
end;

procedure TdtmConsultaEntradas.SetNumero(const Value: string);
begin
  if (Value <> '') then
       qryEntradas.MacroByName('WhereNumero').AsString:= 'and (np.numero = ' + Value + ')'
  else qryEntradas.MacroByName('WhereNumero').AsString:= '';
end;

procedure TdtmConsultaEntradas.SetSerie(const Value: String);
begin
  if (Value <> '') then
       qryEntradas.MacroByName('WhereSerie').AsString:= 'and (np.serie = ''' + Value + ''')'
  else qryEntradas.MacroByName('WhereSerie').AsString:= '';
end;

procedure TdtmConsultaEntradas.qryFornecedoresAfterOpen(DataSet: TDataSet);
begin
  inherited;
  if qryNotaFiscal.State = dsEdit then
    PreencherParametros;
end;

function TdtmConsultaEntradas.GetQtdeNotas: Integer;
begin
  Result:= qryEntradas.RecordCount;
end;

procedure TdtmConsultaEntradas.PreencherParametros;
begin
  if qryFornecedoresestado.AsString = EstadoFilialBase then begin
    qryProcuraNaturezas.Params[0].AsString         := 'L';
    qryConsultaNaturezas.Params[0].AsString := 'L';
  end else if HeUnidadeFederacao(qryFornecedoresestado.AsString) then begin
    qryProcuraNaturezas.Params[0].AsString         := 'F';
    qryConsultaNaturezas.Params[0].AsString := 'F';
  end else begin
    qryProcuraNaturezas.Params[0].AsString         := 'E';
    qryConsultaNaturezas.Params[0].AsString := 'E';
  end;

  if qryFornecedorestipo.AsString = 'F' then begin
    if (qryNotaFiscal.State = dsEdit) then begin
      qryNotaFiscalcnpj.AsString              := qryFornecedorespessoanumero.AsString;
      qryNotaFiscalinscricaoestadual.AsString := qryFornecedoresinscricaoestadual.AsString;
      qryNotaFiscalestado.AsString            := qryFornecedoresestado.AsString;
    end;
    qrySeries.Params[0].AsInteger := qryFornecedorescodigo.AsInteger;
    qrySeries.Params[2].AsString  := 'F';
    qryConsultaSeries.Params[0].AsInteger   := qryFornecedorescodigo.AsInteger;
    qryConsultaSeries.Params[1].AsString    := 'F';
  end else if qryFornecedorestipo.AsString = 'C' then begin
    if (qryNotaFiscal.State = dsEdit) then begin
      qryNotaFiscalcnpj.AsString              := qryFornecedorespessoanumero.AsString;
      qryNotaFiscalinscricaoestadual.AsString := qryFornecedoresinscricaoestadual.AsString;
      qryNotaFiscalestado.AsString            := qryFornecedoresestado.AsString;
    end;
    qrySeries.Params[0].AsInteger  := qryFornecedorescodigo.AsInteger;
    qrySeries.Params[2].AsString   := 'C';
    qryConsultaSeries.Params[0].AsInteger := qryFornecedorescodigo.AsInteger;
    qryConsultaSeries.Params[1].AsString  := 'C';
  end else if qryFornecedorestipo.AsString = 'L' then begin
    if (qryNotaFiscal.State = dsEdit) then begin
      qryNotaFiscalcnpj.AsString              := qryFornecedorespessoanumero.AsString;
      qryNotaFiscalinscricaoestadual.AsString := qryFornecedoresinscricaoestadual.AsString;
    end;
    qrySeries.Params[0].AsInteger  := qryFornecedorescodigo.AsInteger;
    qrySeries.Params[2].AsString   := 'L';
    qryConsultaSeries.Params[0].AsInteger := qryFornecedorescodigo.AsInteger;
    qryConsultaSeries.Params[1].AsString  := 'L';
  end;
end;


function TdtmConsultaEntradas.GetGerarPagamento: Boolean;
begin
  Result:= qryProcuraNaturezasgerarpagamento.AsBoolean;
end;

function TdtmConsultaEntradas.GetNewCodigoFiscal: Integer;
begin
  Result:= qryNotaFiscalcodigofiscal.AsInteger;
end;

function TdtmConsultaEntradas.GetOldCodigoFiscal: Integer;
begin
  Result := FOldCodigoFiscal;
end;

procedure TdtmConsultaEntradas.GerarDocumento_Duplicatas(Parcelas,
          Intervalo: Integer; Data: TDateTime; TipoJuros,
          TipoMulta: Char; ValorJuros, ValorMulta: Real);
var
  ValorDuplicata, TotalDuplicatas, ValorNota, Dif: Currency;
  A, I, Numero: Integer;
  Pos: TBookmark;
begin
  if Parcelas > 0 then begin
    ValorNota := qryNotaFiscalvalornota.AsFloat - ImpostosRetidos;
    ValorDuplicata := RoundTo(ValorNota / Parcelas, -2);

    while not qryDuplicatas.IsEmpty do
      qryDuplicatas.Delete;

    if qryDuplicatas.Active then
      qryDuplicatas.Close;
    qryDuplicatas.Open;

    TotalDuplicatas := 0;
    qryDuplicatas.DisableControls;
    try
      for I:= 0 to Parcelas-1 do begin
        TotalDuplicatas := TotalDuplicatas + ValorDuplicata;
        qryDuplicatas.Append;
        qryDuplicatasdatavencto.AsDateTime  := SomarDia(Data,(I * Intervalo),'S');
        qryDuplicatasnumero.AsInteger       := I+1;
        qryDuplicatasvalorvencto.AsCurrency := ValorDuplicata;
        qryDuplicatastipojuros.AsString     := TipoJuros;
        qryDuplicatastipomulta.AsString     := TipoMulta;
        qryDuplicatasjuros.AsFloat          := ValorJuros;
        qryDuplicatasmulta.AsFloat          := ValorMulta;

        if ParSistema.AutorizacaoPagtoAutomatica then
           qryDuplicatasautorizado.AsBoolean  := True
        else
           qryDuplicatasautorizado.AsBoolean  := False;

        qryDuplicatas.Post;
      end;
    finally
      qryDuplicatas.EnableControls;
    end;
    qryDuplicatas.First;

    Dif:= ValorNota - TotalDuplicatas;
    qryDuplicatas.First;
    qryDuplicatas.Edit;
    qryDuplicatasvalorvencto.AsCurrency := qryDuplicatasvalorvencto.AsCurrency + Dif;
    qryDuplicatas.Post;

    spcDocumentoPag.Open;
    try
      Numero := spcDocumentoPagvalor.AsInteger;
    finally
      spcDocumentoPag.Close
    end;
    qryNotaFiscaldocumentopag.AsInteger          := Numero;

    if qryDocumentoPag.Active then
      qryDocumentoPag.Close;
    qryDocumentoPag.Open;

    qryDocumentoPag.Append;
    qryDocumentoPagnumero.AsInteger         := Numero;
    qryDocumentoPagfornecedor.AsInteger     := qryNotaFiscalfornecedor.AsInteger;
    qryDocumentoPagtipofornecedor.AsString  := qryNotaFiscaltipofornecedor.AsString;
    qryDocumentoPagprevisao.AsBoolean       := False;
    qryDocumentoPagemissao.AsDateTime       := DataServidor;
    qryDocumentoPagcomplemento.AsString     := Format('%-3s', [qryNotaFiscalserie.AsString]) + '/' +
                                               Format('%6.6d',[qryNotaFiscalnota.AsInteger]);
    qryDocumentoPagfilialemissao.AsInteger  := FilialBase;
    qryDocumentoPagvalor.AsCurrency         := qryNotaFiscalvalornota.AsCurrency;
    if not qryNotaFiscalirretido.IsNull then
      qryDocumentoPagirretido.AsCurrency    := qryNotaFiscalirretido.AsCurrency;
    if not qryNotaFiscalissretido.IsNull then
      qryDocumentoPagissretido.AsCurrency   := qryNotaFiscalissretido.AsCurrency;
    if not qryNotaFiscalinssretido.IsNull then
      qryDocumentoPaginssretido.AsCurrency  := qryNotaFiscalinssretido.AsCurrency;
    if not qryNotaFiscalpisretido.IsNull then
      qryDocumentoPagpisretido.AsCurrency   := qryNotaFiscalpisretido.AsCurrency;
    if not qryNotaFiscalcofinsretido.IsNull then
      qryDocumentoPagcofinsretido.AsCurrency:= qryNotaFiscalcofinsretido.AsCurrency;
    if not qryNotaFiscalcsllretido.IsNull then
      qryDocumentoPagcsllretido.AsCurrency  := qryNotaFiscalcsllretido.AsCurrency;
    qryDocumentoPag.Post;
    Pos := qryDuplicatas.GetBookmark;
    qryDuplicatas.DisableControls;
    try
      A := 1;
      qryDuplicatas.First;
      while not qryDuplicatas.Eof do begin
        qryDuplicatas.Edit;
        qryDuplicatasdocumentopag.AsInteger := Numero;
        qryDuplicatasnumero.AsInteger       := A;
        qryDuplicatas.Next;
        Inc(A);
      end;
    finally
      qryDuplicatas.GotoBookmark(Pos);
      qryDuplicatas.FreeBookmark(Pos);
      qryDuplicatas.EnableControls;
    end;
  end;
end;

function TdtmConsultaEntradas.ImpostosRetidos: Real;
begin
  Result := qryNotaFiscalirretido.AsFloat +
            qryNotaFiscalissretido.AsFloat +
            qryNotaFiscalinssretido.AsFloat +
            qryNotaFiscalpisretido.AsFloat +
            qryNotaFiscalcofinsretido.AsFloat +
            qryNotaFiscalcsllretido.AsFloat
end;

function TdtmConsultaEntradas.GetDuplicatasQuitatas: Boolean;
var
  Pos: TBookmark;
begin
  Result:= False;
  Pos:= qryDuplicatas.GetBookmark;
  qryDuplicatas.DisableControls;
  try
    qryDuplicatas.First;
    while not Result and not qryDuplicatas.Eof do begin
      Result:= (qryDuplicatasvalorpagto.AsCurrency <> 0);
      qryDuplicatas.Next;
    end;
  finally
    qryDuplicatas.GotoBookmark(Pos);
    qryDuplicatas.FreeBookmark(Pos);
    qryDuplicatas.EnableControls;
  end;
end;

procedure TdtmConsultaEntradas.ExcluirDocumento_Duplicatas;
begin
  ReFazConsulta(qryDocumentoPag,[0],[qryNotaFiscaldocumentopag.AsInteger]);
  if not qryDocumentoPag.IsEmpty then begin
    qryDocumentoPag.Delete;

    qryDuplicatas.First;
    while not qryDuplicatas.Eof do
      qryDuplicatas.Delete;

    qryNotaFiscaldocumentopag.Clear;
  end;
end;

