procedure TdtmConsultaEntradas.MarcarSelecionados(Marcando,
  Todos: Boolean);
begin

      try
        qryEntradas.AfterScroll:= nil;
        qryEntradas.disablecontrols;

        FRelatorioAtivo := True;
        MarcarRegistros(qryEntradas,
                        qryEntradasselecionar,
                        qryEntradasvalornota,
                        Marcando,
                        Todos);


        ClientDataSetNotasMarcadas.close;
        ClientDataSetNotasMarcadas.Open;
      finally
        FRelatorioAtivo := False;
        qryEntradas.AfterScroll:= qryEntradasAfterScroll;
        qryEntradas.enablecontrols;
      end;


end;

procedure TdtmConsultaEntradas.Imprimir;
var
  Imp : String;
begin
  if not CondicaoEmissorNFE then
    ImprimirNota
  else
  begin
    Imp := 'selecionar';
    ImprimirNFe(Imp);
  end;
end;

procedure TdtmConsultaEntradas.ImprimirListaProdutosporLocalizacao;
var
  vLista: String;
begin
  if not Assigned(dtmImprimeNotaEntrada) then
    dtmImprimeNotaEntrada := TdtmImprimeNotaEntrada.Create(Self);
  try
    qryEntradas.AfterScroll := nil;

    vLista := RetornarLista(qryEntradas, qryEntradasCodigo, qryEntradasselecionar, false);

    dtmImprimeNotaEntrada.ImprimirListaProdutosporLocalizacao(vLista);

  finally
    dtmImprimeNotaEntrada.Free;
    dtmImprimeNotaEntrada := nil;

    qryEntradas.AfterScroll := qryEntradasAfterScroll;
  end;
end;

function TdtmConsultaEntradas.GetPodeImprimirNfe: Boolean;
begin
    result  := (EhDevolucao or PermiteReImprimir) and
                           (not CondicaoEmissorNFE or

                            (CondicaoEmissorNFE and
                             (qryNotaFiscalnuminutilizacaonfe.AsString = '') and
                             (qryNotaFiscalnumcancelamentonfe.AsString = '') ));

end;

