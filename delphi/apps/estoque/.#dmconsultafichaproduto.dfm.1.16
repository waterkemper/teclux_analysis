  object qryFichaProduto_Contrato: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkFields = 'filial=filial;contrato=contrato'
    LinkOptions = []
    MasterSource = dsrFichaProduto
    Constraints = <>
    BeforeOpen = qryFichaProduto_ContratoBeforeOpen
    OnFilterRecord = qryFichaProduto_ContratoFilterRecord
    Filtered = True
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'ListadeContratos'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select movimentos.numero, lancto,'
      '       movimentos.data,'
      '       processamento,'
      '       tipomovimento,'
      '       movimentos.referencia,'
      '       movimentos.quantidade,'
      '       movimentos.filial,'
      '       movimentos.contrato,'
      '       emestoque,'
      '       reservado,'
      '       transito,'
      '       demonstracao,'
      '       conserto,'
      '       movimentos.futuro,'
      '       danificada,'
      '       estoquefisico,'
      '       reservaprevia,'
      '       cast(substr(movimentos.operacao,1,1) as varchar)  as est,'
      '       cast(substr(movimentos.operacao,2,1) as varchar)  as res,'
      '       cast(substr(movimentos.operacao,3,1) as varchar)  as tra,'
      '       cast(substr(movimentos.operacao,4,1) as varchar)  as dem,'
      '       cast(substr(movimentos.operacao,5,1) as varchar)  as con,'
      '       cast(substr(movimentos.operacao,6,1) as varchar)  as fut,'
      '       cast(substr(movimentos.operacao,7,1) as varchar)  as dan,'
      '       cast(substr(movimentos.operacao,8,1) as varchar)  as fis,'
      
        '       cast(substr(movimentos.operacao,9,1) as varchar)  as prev' +
        ','
      
        '       cast(substr(movimentos.operacao,10,1) as varchar) as uent' +
        ','
      
        '       cast(substr(movimentos.operacao,11,1) as varchar) as ucom' +
        ','
      '       cast(substr(movimentos.operacao,12,1) as varchar) as fin,'
      
        '       cast(substr(movimentos.operacao,13,1) as varchar) as tven' +
        ','
      
        '       cast(substr(movimentos.operacao,14,1) as varchar) as tcom' +
        ','
      '       valor,'
      '       precocomicms,'
      '       precosemicms,'
      '       movimentos.aliquotaipi,'
      '       financeiro,'
      '       usuariologado,'
      
        '       (select u.nome from usuarios  u where u.codigo = usuariol' +
        'ogado) as nomeusuariologado,'
      '       usuarioautorizacao,'
      
        '       (select u.nome from usuarios  u where u.codigo = usuarioa' +
        'utorizacao) as nomeusuarioautorizacao,'
      ''
      
        '       case when (emestoque+reservado+reservaprevia+transito+dem' +
        'onstracao+conserto+danificada) = 0  then 0'
      
        #9#9'else round(financeiro / (emestoque+reservado+reservaprevia+tra' +
        'nsito+demonstracao+conserto+danificada), 2)'
      '       end as customedio,'
      ''
      '       case when codigonota is null'
      '         then (select coalesce(v.razao,v.nome) as nome'
      '               from vfornecedores v'
      
        '               where (v.codigo = movimentos.cliente) and (v.tipo' +
        ' = movimentos.tipocliente)'
      '              )'
      '         else'
      '              (select coalesce(v.razao,v.nome) as nome'
      '               from vfornecedores v'
      
        '               where (v.codigo, v.tipo) in (select n.fornecedor,' +
        'n.tipofornecedor'
      '                                            from notaspag n'
      
        '                                             where n.codigo = co' +
        'digonota))'
      
        '        end as clientefornecedor, naoprocessartriggers, moeda, v' +
        'alormoeda, pedcotacao, pedaberto,'
      '        ct.situacao,'
      '        ct.data as datacontrato, '
      '        ct.datareservado,'
      '        ct.faturamento,'
      '        p.codigovisual as produtonocontrato,'
      '        pc.quantidade as quantidadecontrato,'
      
        '       (select sum(ctd.quantidade) from contratosdevolvidos ctd ' +
        'where ctd.contrato = pc.contrato and ctd.produto = pc.produto an' +
        'd ctd.tipo = '#39'D'#39') as devolvidos,'
      
        '       (select sum(ctd.quantidade) from contratosdevolvidos ctd ' +
        'where ctd.contrato = pc.contrato and ctd.produto = pc.produto an' +
        'd ctd.tipo = '#39'T'#39') as trocados'
      ''
      ''
      'From   movimentos join (produtoscontratos pc'
      '                        join (produtos p'
      '                              join caracteristicas c'
      '                              on p.caracteristica = c.codigo)'
      '                        on pc.produto = p.codigo)'
      ''
      ''
      
        '      on movimentos.produto = (case when coalesce(c.composto,fal' +
        'se) then (select pco.componente'
      
        '                                                                ' +
        '          from produtoscompostos pco'
      
        '                                                                ' +
        '          where pco.composto = pc.produto'
      
        '                                                                ' +
        '            and pco.componente = movimentos.produto) else  pc.pr' +
        'oduto end)'
      '     and movimentos.filial = pc.filial'
      '     and movimentos.contrato = pc.contrato'
      ''
      '     join contratos ct'
      '     on pc.contrato = ct.numero'
      ''
      'Where  (movimentos.produto =:produto)'
      '  and movimento.contrato in (%ListadeContratos)'
      ''
      
        'Order By movimentos.filial, cast(movimentos.data as date), Lanct' +
        'o')
    RequestLive = False
    Left = 198
    Top = 17
    ParamData = <
      item
        DataType = ftString
        Name = 'produto'
        ParamType = ptUnknown
        Value = '0'
      end>
