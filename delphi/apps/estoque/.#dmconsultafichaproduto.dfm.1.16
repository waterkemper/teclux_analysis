  object qryFichaProduto_Saldo: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select numero,'
      
        '       cast(null as timestamp) as data, processamento, movimento' +
        's.data as data1,'
      '       cast(null as varchar) as tipomovimento,'
      '       cast('#39'SALDO ANTERIOR'#39' as varchar(60)) as referencia,'
      '       quantidade,'
      '       cast(null as integer) as filial,'
      '       emestoque,'
      '       reservado,'
      '       transito,'
      '       demonstracao,'
      '       conserto,'
      '       futuro,'
      '       danificada,'
      '       estoquefisico,'
      '       reservaprevia,'
      '       cast(substr(operacao,1,1) as varchar)  as est,'
      '       cast(substr(operacao,2,1) as varchar)  as res,'
      '       cast(substr(operacao,3,1) as varchar)  as tra,'
      '       cast(substr(operacao,4,1) as varchar)  as dem,'
      '       cast(substr(operacao,5,1) as varchar)  as con,'
      '       cast(substr(operacao,6,1) as varchar)  as fut,'
      '       cast(substr(operacao,7,1) as varchar)  as dan,'
      '       cast(substr(operacao,8,1) as varchar)  as fis,'
      '       cast(substr(operacao,9,1) as varchar)  as prev,'
      '       cast(substr(operacao,10,1) as varchar) as uent,'
      '       cast(substr(operacao,11,1) as varchar) as ucom,'
      '       cast(substr(operacao,12,1) as varchar) as fin,'
      '       cast(substr(operacao,13,1) as varchar) as tven,'
      '       cast(substr(operacao,14,1) as varchar) as tcom,'
      '       valor,'
      '       precocomicms,'
      '       precosemicms,'
      '       aliquotaipi,'
      '       financeiro,'
      '       case when codigonota is null'
      '         then (select coalesce(v.razao,v.nome) as nome '
      '               from vfornecedores v'
      
        '               where (v.codigo = cliente) and (v.tipo = tipoclie' +
        'nte)'
      '              )'
      '         else'
      '              (select coalesce(v.razao,v.nome) as nome '
      '               from vfornecedores v'
      
        '               where (v.codigo, v.tipo) in (select n.fornecedor,' +
        'n.tipofornecedor'
      '                                            from notaspag n'
      
        '                                             where n.codigo = co' +
        'digonota))'
      
        '       end as clientefornecedor, naoprocessartriggers, moeda, va' +
        'lormoeda'
      'From   movimentos'
      
        'Where   (produto =:produto) and cast(data as date) < :datainicia' +
        'l'
      '     /* RUNTIME */'
      'order by data1 desc limit 1')
    RequestLive = False
    Left = 88
    Top = 129
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'produto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end>
