    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Linha'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select numero, lancto,'
      '       data,'
      '       processamento,'
      '       tipomovimento,'
      '       referencia,'
      '       quantidade,'
      '       filial,'
      '       contrato,'
      '       contrato,'
      '       emestoque,'
      '       reservado,'
      '       transito,'
      '       demonstracao,'
      '       conserto,'
      '       futuro,'
      '       danificada,'
      '       estoquefisico,'
      '       reservaprevia,'
      '       cast(substr(operacao,1,1) as varchar)  as est,'
      '       cast(substr(operacao,2,1) as varchar)  as res,'
      '       cast(substr(operacao,3,1) as varchar)  as tra,'
      '       cast(substr(operacao,4,1) as varchar)  as dem,'
      '       cast(substr(operacao,5,1) as varchar)  as con,'
      '       cast(substr(operacao,6,1) as varchar)  as fut,'
      '       cast(substr(operacao,7,1) as varchar)  as dan,'
      '       cast(substr(operacao,8,1) as varchar)  as fis,'
      '       cast(substr(operacao,9,1) as varchar)  as prev,'
      '       cast(substr(operacao,10,1) as varchar) as uent,'
      '       cast(substr(operacao,11,1) as varchar) as ucom,'
      '       cast(substr(operacao,12,1) as varchar) as fin,'
      '       cast(substr(operacao,13,1) as varchar) as tven,'
      '       cast(substr(operacao,14,1) as varchar) as tcom,'
      '       valor,'
      '       precocomicms,'
      '       precosemicms,'
      '       aliquotaipi,'
      '       financeiro,'
      '       usuariologado,'
      
        '       (select u.nome from usuarios  u where u.codigo = usuariol' +
        'ogado) as nomeusuariologado,'
      '       usuarioautorizacao,'
      
        '       (select u.nome from usuarios  u where u.codigo = usuarioa' +
        'utorizacao) as nomeusuarioautorizacao,'
      ''
      
        '       case when (emestoque+reservado+reservaprevia+transito+dem' +
        'onstracao+conserto+danificada) = 0  then 0'
      
        #9#9'else round(financeiro / (emestoque+reservado+reservaprevia+tra' +
        'nsito+demonstracao+conserto+danificada), 2)'
      '       end as customedio,'
      ''
      '       case when codigonota is null'
      '         then (select coalesce(v.razao,v.nome) as nome'
      '               from vfornecedores v'
      
        '               where (v.codigo = cliente) and (v.tipo = tipoclie' +
        'nte)'
      '              )'
      '         else'
      '              (select coalesce(v.razao,v.nome) as nome'
      '               from vfornecedores v'
      
        '               where (v.codigo, v.tipo) in (select n.fornecedor,' +
        'n.tipofornecedor'
      '                                            from notaspag n'
      
        '                                             where n.codigo = co' +
        'digonota))'
      
        '        end as clientefornecedor, naoprocessartriggers, moeda, v' +
        'alormoeda, pedcotacao, pedaberto'
      ''
      'From   movimentos'
      'Where   (produto =:produto)'
      '%Linha'
      'Order By filial,cast(data as date), Lancto')
    RequestLive = True
    Left = 86
    Top = 17
    ParamData = <
      item
        DataType = ftString
        Name = 'produto'
        ParamType = ptUnknown
        Value = '0'
      end>
