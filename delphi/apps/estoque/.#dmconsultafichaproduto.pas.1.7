procedure TdtmConsultaFichaProduto.Selecionar(Pesquisa: TtecPesquisa);
begin
  case Pesquisa of
    pesFILIAIS      : RefazConsulta(qryProcuraFiliais,[0],[CodigoFilial]);
  pesTIPOSMOVIMENTOS: RefazConsulta(qryProcuraTiposMovimentos,[0],[CodigoTipoMovimento]);
  end;
end;

procedure TdtmConsultaFichaProduto.ConsultaFichaProduto;
var
  Linha : String;
  i : integer;
begin
  Linha := 'and (data >= to_timestamp(''' + FParametroDataInicial +''', ''dd/mm/yyyy''))';
  Linha := Linha + 'and (data <= to_timestamp(''' + FParametroDataFinal + ' 23:59:59'', ''dd/mm/yyyy hh24:mi:ss''))';
  if Trim(FParametroFilial) <> '' then
    Linha := Linha + ' and ( filial = ' + FParametroFilial + ' )';
  if Trim(FParametroTipoMovimento) <> '' then
    Linha := Linha + ' and (tipomovimento = ''' + FParametroTipoMovimento + ''')';
  qryFichaProduto.MacroByName('Linha').AsString := Linha;
  // Setando o WHERE O CÁLCULO DO SALDO ANTERIOR
  Linha := '';
  if Trim(FParametroFilial) <> '' then
    Linha := ' and ( filial = ' + FParametroFilial + ' )';
  if Trim(FParametroTipoMovimento) <> '' then
    Linha := Linha + ' and (tipomovimento = ''' + FParametroTipoMovimento + ''')';
  qryFichaProduto_Saldo.Sql[48] := Linha;
  RefazConsulta(qryFichaProduto,[0],[FParametroProduto]);
  RefazConsulta(qryFichaProduto_Saldo,[0,1],[FParametroProduto,FParametroDataInicial]);
  IncluirLinhaSaldo;
end;

