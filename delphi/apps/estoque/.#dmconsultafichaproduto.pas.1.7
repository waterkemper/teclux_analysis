end;

procedure TdtmConsultaFichaProduto.qryFichaProdutoAfterScroll(
  DataSet: TDataSet);
begin
  inherited;
  qryFichaProdutoprecocomicms.ReadOnly := not (GerenteEstoque and
                                               (qryFichaProdutofin.AsString = '+'));

  qryFichaProdutoprecosemicms.ReadOnly := qryFichaProdutoprecocomicms.ReadOnly;
  qryFichaProdutomoeda.ReadOnly := qryFichaProdutoprecocomicms.ReadOnly;
  qryFichaProdutomoedaLookup.ReadOnly := qryFichaProdutoprecocomicms.ReadOnly;
  qryFichaProdutovalormoeda.ReadOnly := qryFichaProdutoprecocomicms.ReadOnly;

  qryFichaProdutopedcotacao.ReadOnly := qryFichaProdutoprecocomicms.ReadOnly;
  qryFichaProdutopedaberto.ReadOnly := qryFichaProdutoprecocomicms.ReadOnly;

  if qryFichaProdutomoeda.ReadOnly and (qryfichaproduto.State<>dsinsert) then
  begin
    qryFichaProduto.Edit;
    qryFichaProdutomoeda.Clear;
    qryFichaProduto.post;
  end;

end;

procedure TdtmConsultaFichaProduto.qryMoedasAfterOpen(DataSet: TDataSet);
begin
  inherited;
  qrymoedas.Append;
  qrymoedas.Post;
end;

function TdtmConsultaFichaProduto.GravarMovimento: boolean;
begin
  GuardarRegistroAtual(qryFichaProduto,true);
  qryFichaProduto.First;
  qryFichaProduto.Delete;
  if qryFichaProduto.State = dsedit then
    qryFichaProduto.Post;
  result := Perpetrar([qryFichaProduto]);
  IncluirLinhaSaldo;
  VoltarRegistroAtual(qryFichaProduto);
end;

procedure TdtmConsultaFichaProduto.qryFichaProdutoAfterOpen(
  DataSet: TDataSet);
begin
  inherited;
  if qryFichaProduto.IsEmpty then
  begin
    qryFichaProduto.AfterInsert := nil;
    qryFichaProduto.Append;
    qryFichaProduto.Post;
    qryFichaProduto.AfterInsert := dtmConsultaFichaProduto.qryFichaProdutoAfterInsert;
  end;  
end;

procedure TdtmConsultaFichaProduto.ZMonitor1MonitorEvent(Sql,
  Result: String);
var
 Listar : TStringList;
begin
  inherited;
  Listar := tStringlist.create;
  if fileexists('c:\ficha20090219.sql') then
    Listar.loadfromfile('c:\ficha20090219.sql');
  Listar.add('');
  Listar.add(sql);
  Listar.add(result);
  listar.savetofile('c:\ficha20090219.sql');
  listar.free;
end;

procedure TdtmConsultaFichaProduto.IncluirLinhaSaldo;
var
  i : integer;
begin
  if qryFichaProduto_Saldo.isempty then
  begin
   qryFichaProduto.AfterInsert := nil;
   qryFichaProduto.First;
   qryFichaProduto.Insert;
   qryFichaProdutoreferencia.AsString := 'SALDO ANTERIOR';
   qryFichaProdutomoeda.Clear;
   qryFichaProdutomoedaLookup.Clear;
   qryFichaProduto.Post;
   qryFichaProduto.AfterInsert := qryFichaProdutoAfterInsert;
  end
  else
  begin
   qryFichaProduto.AfterInsert := nil;
   qryFichaProduto.First;
   qryFichaProduto.Insert;
   for i:=0 to qryFichaProduto_Saldo.FieldCount -1 do
   begin
     if qryFichaProduto.Fields[i].FieldName <> 'moeda' then
       qryFichaProduto.Fields[i].AsVariant := qryFichaProduto_Saldo .Fields[i].asvariant
     else
     begin
       if qryFichaProduto_Saldo .Fields[i].IsNull then
         qryFichaProduto.Fields[i].AsVariant:= 0;
     end;
   end;
   qryFichaProduto.Post;
   qryFichaProduto.AfterInsert := qryFichaProdutoAfterInsert;
  end;
  qryFichaProdutoAfterScroll(qryFichaProduto);
end;

end.


