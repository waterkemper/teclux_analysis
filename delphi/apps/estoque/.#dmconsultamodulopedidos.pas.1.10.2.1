procedure TdtmConsultaPedidos.setpromocoes(const Value: String);
begin
  fpromocoes := Value;
end;

procedure TdtmConsultaPedidos.MarcarSelecionados(Marcando, Todos: Boolean);
begin
  MarcarRegistros(qryPedidos,
                  qryPedidosMarcar,
                  qryPedidosTotalProduto,
                  Marcando,
                  Todos);
end;

procedure TdtmConsultaPedidos.ImprimirPedidos;
var
  vListadePedidos: String;
begin
  qryPedidos.AfterScroll := nil;
  vListadePedidos := RetornarLista(qryPedidos, qryPedidosnumero, qryPedidosmarcar, True);
  dmcadastropedidos.ImprimirPedidos(vListadePedidos);
  qryPedidos.AfterScroll := qryPedidosAfterScroll;

end;

end.


