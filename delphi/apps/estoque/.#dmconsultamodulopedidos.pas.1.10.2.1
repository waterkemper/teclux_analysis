var
  dtmConsultaPedidos: TdtmConsultaPedidos;
const
  FiltroGruposFornecedores = ' (p.caracteristica in (select fp.caracteristica from fornecedoresprodutos fp where fp.fornecedor in (select f.codigo from fornecedores f join gruposfornecedores gf on f.grupofornecedor = gf.codigo where %s)))';


implementation

{$R *.dfm}

constructor TdtmConsultaPedidos.Create(AOwner: TComponent);
begin
  inherited;
  qryPedidos.Tag      := ctTabelas;
  qryProcuraProdutos.Tag      := ctTabelas;
  qryProcuraFornecedores.Tag  := ctTabelas;
  qryConsultaProdutos.Tag     := ctPesquisaCaracteristica;
  qryConsultaFornecedores.Tag := ctPesquisaFornecedor;
  qryPedidosquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryPedidosrecebido.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
end;

procedure TdtmConsultaPedidos.Selecionar(TipoPesquisa: TtecConsultaPedidos);
begin
  case TipoPesquisa of
       tpcFORNECEDOR: ReFazConsulta(qryProcuraFornecedores,[0],[qryConsultaFornecedorescodigo.AsInteger]);
   tpcCARACTERISTICA: RefazConsulta(qryProcuraProdutos,[0],[qryConsultaProdutoscodigo.AsLargeInt]);
  end;
end;

function TdtmConsultaPedidos.ExisteCaracteristica(campo, codigo: String): Boolean;
const
  SQL = 'Where (to_ascii(%s,''latin1'') ilike to_ascii(''%s%s'',''latin1''))';
begin
  qryConsultaProdutos.Sql[03]:= Format(SQL, [Campo, Codigo, '%']);
  qryConsultaProdutos.Open;
  Result := (qryConsultaProdutos.RecordCount > 0);
end;

function TdtmConsultaPedidos.ExisteFornecedor(campo, codigo: String): Boolean;
begin
  Result:= ExisteCodigo(qryConsultaFornecedores, campo, codigo);
end;

function TdtmConsultaPedidos.GetConsultarCaracteristica: TtecQuery;
begin
  Result := qryConsultaProdutos;
end;

function TdtmConsultaPedidos.ConsultarPedido: Boolean;
begin
  qryPedidos.Close;
  qryPedidos.ParamByName('ndias').AsInteger := ParSistema.DiasBasePrevisaoEstoque;
  qryPedidos.Open;
  Result:= qryPedidos.IsEmpty;

  QtdeMarcados := 0;
  TotalMarcados:= 0;

end;

function TdtmConsultaPedidos.GetConsultarFornecedor: TtecQuery;
begin
  Result:= qryConsultaFornecedores;
end;

procedure TdtmConsultaPedidos.AbrirTabelas(TipoPesquisa: TtecConsultaPedidos);
begin
  Case TipoPesquisa of
        tpcFORNECEDOR: Abre(ctPesquisaFornecedor);
    tpcCARACTERISTICA: begin
                         qryConsultaProdutos.Sql[03]:= 'Where (codigo = 0)';
                         qryConsultaProdutos.Open;
                       end;
  end;
end;

procedure TdtmConsultaPedidos.FecharTabelas(TipoPesquisa: TtecConsultaPedidos);
begin
  Case TipoPesquisa of
        tpcFORNECEDOR: Fecha(ctPesquisaFornecedor);
    tpcCARACTERISTICA: Fecha(ctPesquisaCaracteristica);
  end;
end;

procedure TdtmConsultaPedidos.SetFornecedor(const Value: String);
begin
  FFornecedor := Value;
  if Value <> '' then
       qryPedidos.MacroByName('Fornecedor').AsString := 'and (' + Value + ')'
  else qryPedidos.MacroByName('Fornecedor').AsString := '';
end;

procedure TdtmConsultaPedidos.SetProdutos(const Value: String);
begin
  if Value <> '' then
       qryPedidos.MacroByName('Produto').AsString := 'and (' + Value + ')'
  else qryPedidos.MacroByName('Produto').AsString := '';
end;

procedure TdtmConsultaPedidos.SetSituacao(const Value: Integer);
begin
  if FSituacao <> Value then
     FSituacao := Value;
  Case FSituacao of
    0: qryPedidos.MacroByName('Situacao').AsString:= 'and (pe.situacao = ' + QuotedStr('A') + ')';
    1: qryPedidos.MacroByName('Situacao').AsString:= 'and (pe.situacao = ' + QuotedStr('P') + ')';
    2: qryPedidos.MacroByName('Situacao').AsString:= 'and (pe.situacao = ' + QuotedStr('Q') + ')';
    3: qryPedidos.MacroByName('Situacao').AsString:= 'and (pe.situacao = ' + QuotedStr('L') + ')';
    4: qryPedidos.MacroByName('Situacao').AsString:= 'and (pe.situacao = ' + QuotedStr('C') + ')';
    5: qryPedidos.MacroByName('Situacao').AsString:= '';
  end;
end;

procedure TdtmConsultaPedidos.MontaIntervaloEmissao;
const
  Data_1 = '(pe.emissao = ';
  Data_2 = '(pe.emissao between (';
begin
  if not DataEmBranco(FDataInicial) then begin
    if DataEmBranco(FDataFinal) then
         qryPedidos.MacroByName('Emissao').AsString:= Data_1 + '''' + FDataInicial + ''')'
    else qryPedidos.MacroByName('Emissao').AsString:= Data_2 + '''' + FDataInicial + ''') and (''' + FDataFinal + '''))';
  end
  else begin
    if not DataEmBranco(FDataFinal) then
         qryPedidos.MacroByName('Emissao').AsString:= Data_1 + '''' + FDataFinal + ''')'
    else qryPedidos.MacroByName('Emissao').AsString:= '';
  end;
end;

procedure TdtmConsultaPedidos.FecharTabelaConsulta;
begin
  qryPedidos.Close;
end;

procedure TdtmConsultaPedidos.SetDataFinal(const Value: String);
begin
  if FDataFinal <> Value then
    FDataFinal:= Value;
  MontaIntervaloEmissao;
end;

procedure TdtmConsultaPedidos.SetDataInicial(const Value: String);
begin
  if FDataInicial <> Value then
    FDataInicial:= Value;
  MontaIntervaloEmissao;
end;

procedure TdtmConsultaPedidos.SetOrdenacao(const Value: Integer);
begin
  if FOrdenacao <> Value then
    FOrdenacao:= Value;
  case FOrdenacao of
    0: qryPedidos.MacroByName('Ordenacao').AsString:= 'Order By pe.numero';
    1: qryPedidos.MacroByName('Ordenacao').AsString:= 'Order By UPPER(TO_ASCII(p.Descricao,''LATIN1'')), pe.emissao';
    2: qryPedidos.MacroByName('Ordenacao').AsString:= 'Order By UPPER(TO_ASCII(vf.razao,''LATIN1'')), pe.emissao';
    3: qryPedidos.MacroByName('Ordenacao').AsString:= 'Order By pe.emissao';
    4: qryPedidos.MacroByName('Ordenacao').AsString:= 'Order By UPPER(TO_ASCII(pe.situacao,''LATIN1''))';
  end;
end;

procedure TdtmConsultaPedidos.qryPedidosAfterScroll(DataSet: TDataSet);
begin
  inherited;
  if ((qryPedidossituacao.AsString = 'L') or (qryPedidossituacao.AsString = 'P')) then
    ReFazConsulta(qryNotasPag,[0],[qryPedidosnumero.AsInteger]);
  if Assigned(FOnScrollLinhaColunaGrade) then
    FOnScrollLinhaColunaGrade(DataSet);

end;

function TdtmConsultaPedidos.GetColunadaGrade: String;
begin
  result := PrimeiraLetraEmMaiuscula(qryPedidoscoluna.AsString)
end;

function TdtmConsultaPedidos.GetLinhadaGrade: String;
begin
  result := PrimeiraLetraEmMaiuscula(qryPedidoslinha.AsString)
end;

procedure TdtmConsultaPedidos.qryConsultaProdutosAfterOpen(
  DataSet: TDataSet);
begin
  inherited;
  qryConsultaProdutosvalorgrade1.Visible := ParSistema.UsarGradesProdutos;
  qryConsultaProdutosvalorgrade2.Visible := ParSistema.UsarGradesProdutos;
end;

procedure TdtmConsultaPedidos.qryPedidosCalcFields(DataSet: TDataSet);
begin
   inherited;
   if ((qryPedidosRecebido.AsCurrency >= qryPedidosQuantidade.AsCurrency) AND (qryPedidosSituacao.AsString<>'C')) then
      qryPedidosSituacaoProduto.AsString := 'L'
   else if (qryPedidosRecebido.AsCurrency = 0) and ((qryPedidosSituacao.AsString='A') or (qryPedidosSituacao.AsString='P')) then
      qryPedidosSituacaoProduto.AsString := 'A'
   else if (qryPedidosRecebido.AsCurrency = 0) and ((qryPedidosSituacao.AsString='L') or (qryPedidosSituacao.AsString='C')) then
      qryPedidosSituacaoProduto.AsString := 'C'
   else if (qryPedidosQuantidade.AsCurrency > qryPedidosRecebido.AsCurrency) and (qryPedidosRecebido.AsCurrency>0) then
   begin
      if qryPedidossituacao.AsString='Q' then
        qryPedidosSituacaoProduto.AsString:='Q'
      else
        qryPedidosSituacaoProduto.AsString := 'P';
   end
   else
       qryPedidosSituacaoProduto.AsString := 'C';

   qryPedidosTotalProduto.asCurrency := (qryPedidosquantidade.asCurrency * qryPedidospreco.asCurrency) - qryPedidosdesconto.asCurrency;
end;

function TdtmConsultaPedidos.GetSituacaoProduto: String;
begin
  Result:=qryPedidossituacaoproduto.AsString;
end;


procedure TdtmConsultaPedidos.ZMonitor2MonitorEvent(Sql, Result: String);
var
 Listar : TStringList;
 begin
  inherited;
   Listar := tStringlist.create;
  if fileexists('c:\consulta.sql') then
    Listar.loadfromfile('c:\consulta.sql');
  Listar.add('');
  Listar.add(sql);
  Listar.add(result);
  listar.savetofile('c:\consulta.sql');
  listar.free;
end;

procedure TdtmConsultaPedidos.qryPedidosAfterOpen(DataSet: TDataSet);
begin
  inherited;
  ClientDataSet1.close;
  ClientDataSet1.open;

end;

procedure TdtmConsultaPedidos.setclassesprodutos(const Value: String);
begin
  fclassesprodutos := Value;

  if Value <> '' then
       qryPedidos.MacroByName('classesprodutos').AsString := 'and (' + Value + ')'
  else qryPedidos.MacroByName('classesprodutos').AsString := '';

end;

procedure TdtmConsultaPedidos.setGruposFornecedores(const Value: String);
begin
  fGruposFornecedores := Value;

  if Value <> '' then
       qryPedidos.MacroByName('GruposFornecedores').AsString := ' and ' + format(FiltroGruposFornecedores, [Value])
  else qryPedidos.MacroByName('GruposFornecedores').AsString := '';
