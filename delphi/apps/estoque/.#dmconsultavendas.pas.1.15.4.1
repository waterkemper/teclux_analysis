procedure TdtmConsultaVendas.ZMonitor1MonitorEvent(Sql, Result: String);
var
 Listar : TStringList;
begin
  inherited;
  Listar := tStringlist.create;
  if fileexists('c:/consultavendas.sql') then
    Listar.loadfromfile('c:/consultavendas.sql');
  Listar.add('');
  Listar.add(sql);
  Listar.add(result);
  listar.savetofile('c:/consultavendas.sql');
  listar.free;
end;

procedure TdtmConsultaVendas.qryVendasClientesCalcFields(
  DataSet: TDataSet);
var
 i: integer;
begin
  inherited;
  qryVendasClientesTotal.AsCurrency := 0.00;
  for i:=0 to qryVendasClientes.FieldCount-1 do
  begin
   if copy(qryVendasClientes.Fields[i].FieldName,1,1) = 'm' then
   begin
     qryVendasClientesTotal.AsCurrency :=
      qryVendasClientesTotal.AsCurrency +
      qryVendasClientes.Fields[i].AsCurrency;
   end
  end;
end;

procedure TdtmConsultaVendas.qryVendasCalcFields(DataSet: TDataSet);
var
 i: integer;
