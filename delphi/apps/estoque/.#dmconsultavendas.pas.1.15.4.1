unit dmconsultavendas;

interface

uses
  SysUtils, Classes, dmbasico, DB, cpdatasource, ZQuery, ZPgSqlQuery,
  cpquery, biblio, dmtecsoft, ZTransact, DateUtils, ctconstantes,
  clparametrossistema, ACBrBase, ACBrDFe, ACBrNFSe;

type
  TdtmConsultaVendas = class(TdtmBasico)
    qryVendas: TtecQuery;
    dsrVendas: TtecDataSource;
    qrynMeses: TtecQuery;
    qryvendas_aux: TtecQuery;
    qrynmeses_aux: TtecQuery;
    qryVendasClientes: TtecQuery;
    qryVendasClientes_aux: TtecQuery;
    dsrVendasCliente: TtecDataSource;
    qryVendasClientesClienteTipoCliente: TStringField;
    qryVendasClientesCliente: TIntegerField;
    qryVendasClientesTipoCliente: TStringField;
    qryVendasClientesNome: TStringField;
    qryVendasClientesTotal: TCurrencyField;
    qryVendasTotal: TCurrencyField;
    qryVendasprodutofilial: TStringField;
    qryVendasproduto: TLargeintField;
    qryVendasfilial: TIntegerField;
    qryVendasdescricao: TStringField;
    qryVendascliente: TIntegerField;
    qryVendastipocliente: TStringField;
    dsrVendasTotais: TtecDataSource;
    qryVendasTotais: TtecQuery;
    qryVendasTotaisclientetipocliente: TStringField;
    IntegerField1: TIntegerField;
    StringField2: TStringField;
    StringField3: TStringField;
    qryVendasTotaisTotal: TCurrencyField;
    qryVendasTotais_aux: TtecQuery;
    qryVendasQuantidades: TtecQuery;
    dsrVendasQuantidades: TtecDataSource;
    qryVendasQuantidades_aux: TtecQuery;
    qryVendasQuantidadesprodutofilial: TStringField;
    qryVendasQuantidadesproduto: TLargeintField;
    qryVendasQuantidadesfilial: TIntegerField;
    qryVendasQuantidadesdescricao: TStringField;
    qryVendasQuantidadescliente: TIntegerField;
    qryVendasQuantidadestipocliente: TStringField;
    qryVendasQuantidadestotal: TFloatField;
    qryVendasgrupo: TStringField;
    qryVendasdescricaogrupo: TStringField;
    qryVendasQuantidadesgrupo: TStringField;
    qryVendasQuantidadesdescricaogrupo: TStringField;
    qryProcuraFornecedores: TtecQuery;
    qryProcuraFornecedorescodigo: TIntegerField;
    qryProcuraFornecedoresnome: TStringField;
    dsrProcuraFornecedores: TtecDataSource;
    qryVendasprodutovisual: TStringField;
    qryVendasQuantidadesprodutovisual: TStringField;
    procedure ZMonitor1MonitorEvent(Sql, Result: String);
    procedure qryVendasClientesCalcFields(DataSet: TDataSet);
    procedure qryVendasCalcFields(DataSet: TDataSet);
    procedure qryVendasClientesAfterScroll(DataSet: TDataSet);
  protected
    fTitulo   : String;
    fSubtitulo: String;
    fOutras   : String;
    fEmLinha, fForadeLinha, fAtivo, fInativo, fComMontagem,
    fSemMontagem, fBrinde, fNaoBrinde: Boolean;
    ftipoCurvaABC: integer;
    procedure CalcularVendasTotais;
    procedure CalcularVendasQuantidades;
  private
    { Private declarations }
  public
    { Public declarations }
    function AbrirConsulta(
      DataInicial, DataFinal: TdateTime;
      EmLinha, ForadeLinha, Ativo, Inativo, ComMontagem,
      SemMontagem, Brinde, NaoBrinde: Boolean;
      ItemProduto, Produto, Grupo, Classe, Marca,
      Filiais, GrupoFiliais, Cliente, TipoCliente, Vendedor: String): Boolean;

  end;
{
var
  dtmConsultaVendas: TdtmConsultaVendas;
}

implementation

{$R *.dfm}

{ TdtmConsultaVendas }

function TdtmConsultaVendas.AbrirConsulta(DataInicial,
  DataFinal: TdateTime; EmLinha, ForadeLinha, Ativo, Inativo, ComMontagem,
  SemMontagem, Brinde, NaoBrinde: Boolean; ItemProduto,Produto, Grupo, Classe, Marca,
  Filiais, GrupoFiliais, Cliente, TipoCliente, Vendedor: String): Boolean;
const
  FiltroDataFaturamento = ' where (ct.faturamento BETWEEN (cast(''%s'' as date)) AND (cast(''%s'' as date)))';
  FiltroDataFaturamentoFrentedeCaixa = ' where (df.data BETWEEN (cast(''%s'' as date)) AND (cast(''%s'' as date)))';
  FiltroDataDevolucao = ' where (cd.devolucao BETWEEN (cast(''%s'' as date)) AND (cast(''%s'' as date)))';
  FiltroDataNotasPag = ' where (np.data BETWEEN (cast(''%s'' as date)) AND (cast(''%s'' as date)))';
  FiltroDataCancelamento = ' and (p.datapagto BETWEEN (cast(''%s'' as date)) AND (cast(''%s'' as date)))';

  FiltroFilial      = ' and ( ct.filialvenda IN (''%s'')) ';
  FiltroFilialNotasPag      = ' and ( np.filial IN (''%s'')) ';

  FiltroFilialFrentedeCaixa      = ' and ( df.filialvenda IN (''%s'')) ';

  FiltroGrupoFilial = ' and ( ct.filialvenda IN (SELECT filial '+
                                         'FROM filiaisgruposfiliais fgf '+
                                         'WHERE fgf.grupo IN (''%s''))) ';

  FiltroGrupoFilialNotasPag = ' and ( np.filial IN (SELECT filial '+
                                         'FROM filiaisgruposfiliais fgf '+
                                         'WHERE fgf.grupo IN (''%s''))) ';

  FiltroGrupoFilialFrentedeCaixa = ' and ( df.filialvenda IN (SELECT filial '+
                                         'FROM filiaisgruposfiliais fgf '+
                                         'WHERE fgf.grupo IN (''%s''))) ';

  FiltroCliente     = ' and ((ct.cliente = ''''%s'''') '+
                      '   and (ct.tipocliente = ''''%s''''))';

  FiltroFornecedor  = ' and ((np.fornecedor = ''''%s'''') '+
                      '   and (np.tipofornecedor = ''''%s''''))';


  FiltroClienteFrentedeCaixa     = ' and ((df.cliente = ''''%s'''') '+
                                   '   and (df.tipocliente = ''''%s''''))';

  FiltroVendedor     = ' and (ct.vendedor = ''''%s'''') ';
  FiltroVendedorFrentedeCaixa     = ' and (df.vendedor = ''''%s'''') ';

  FiltroVendedorNotasPag   = ' and (coalesce(pdf.vendedor, df.vendedor, pnp.vendedor, np.vendedor) = ''''%s'''') ';

var
  FiltroVendas,
  FiltroNotasPag,
  FrentedeCaixaFiltroVendas,

  FiltroServicos, mes, meses,teste : String;
  i,posicaomeses :integer;

begin
  qryvendas.Close;
  qryvendas.sql.Text := qryvendas_aux.Sql.Text;

  qryVendasQuantidades.close;
  qryVendasQuantidades.sql.text := qryVendasQuantidades_aux.sql.text;

  qryVendasTotais.close;
  qryVendasTotais.sql.text := qryVendasTotais_aux.sql.text;

  qryVendasClientes.Close;
  qryVendasClientes.sql.Text := qryVendasClientes_aux.Sql.Text;

  qrynMeses.Close;
  qrynMeses.sql.text := qrynmeses_aux.sql.text;

  fEmLinha      := EmLinha;
  fForadeLinha  := ForadeLinha;
  fAtivo        := Ativo;
  fInativo      := Inativo;
  fComMontagem  := ComMontagem;
  fSemMontagem  := SemMontagem;
  fBrinde       := Brinde;
  fNaoBrinde    := NaoBrinde;

  ftitulo := 'ANÁLISE DE VENDAS ';
  fSubtitulo := ' Entre: '+datetostr(DataInicial)+' e '+datetostr(DataFinal);
  foutras := '';


  qryVendas.Sql[NumerodalinhanoTexto(qryVendas.sql, '%DataFaturamentoVendasProdutos')] :=
    format(FiltroDataFaturamento,[quotedstr(datetostr(DataInicial)),quotedstr(datetostr(DataFinal))]);

  qryVendas.Sql[NumerodalinhanoTexto(qryVendas.sql, '%_2_DataFaturamentoVendasProdutos')] :=
    format(FiltroDataFaturamento,[quotedstr(datetostr(DataInicial)),quotedstr(datetostr(DataFinal))]);

  qryVendas.Sql[NumerodalinhanoTexto(qryVendas.sql, '%_3_DataFaturamentoVendasProdutos')] :=
    format(FiltroDataFaturamento,[quotedstr(datetostr(DataInicial)),quotedstr(datetostr(DataFinal))]);

  qryVendas.Sql[NumerodalinhanoTexto(qryVendas.sql, '%FrentedeCaixaDataFaturamentoVendasProdutos')] :=
    format(FiltroDataFaturamentoFrentedeCaixa,[quotedstr(datetostr(DataInicial)),quotedstr(datetostr(DataFinal))]);

  qryVendas.Sql[NumerodalinhanoTexto(qryVendas.sql, '%DataFaturamentoVendasServicos')] :=
    format(FiltroDataFaturamento,[quotedstr(datetostr(DataInicial)),quotedstr(datetostr(DataFinal))]);

  qryVendas.Sql[NumerodalinhanoTexto(qryVendas.sql, '%DataFaturamentoVendasDevolucoes')] :=
    format(FiltroDataDevolucao,[quotedstr(datetostr(DataInicial)),quotedstr(datetostr(DataFinal))]);

  qryVendas.Sql[NumerodalinhanoTexto(qryVendas.sql, '%DataFaturamentoNotasPag')] :=
    format(FiltroDataNotasPag,[quotedstr(datetostr(DataInicial)),quotedstr(datetostr(DataFinal))]);

  qryVendas.Sql[NumerodalinhanoTexto(qryVendas.sql, '%DataPagamentoCancelamento')] :=
    format(FiltroDataCancelamento,[quotedstr(datetostr(DataInicial)),quotedstr(datetostr(DataFinal))]);

  qryVendas.Sql[NumerodalinhanoTexto(qryVendas.sql, '%DataInicial_1')] :=
     datetostr(DataInicial);

  qryVendas.Sql[NumerodalinhanoTexto(qryVendas.sql, '%DataInicial_2')] :=
     datetostr(DataInicial);

  qryVendas.Sql[NumerodalinhanoTexto(qryVendas.sql, '%DataFinal')] :=
     datetostr(DataFinal);

  qryVendasClientes.Sql[NumerodalinhanoTexto(qryVendasClientes.sql, '%DataFaturamentoVendasProdutos')] :=
    format(FiltroDataFaturamento,[quotedstr(datetostr(DataInicial)),quotedstr(datetostr(DataFinal))]);

  qryVendasClientes.Sql[NumerodalinhanoTexto(qryVendasClientes.sql, '%_2_DataFaturamentoVendasProdutos')] :=
    format(FiltroDataFaturamento,[quotedstr(datetostr(DataInicial)),quotedstr(datetostr(DataFinal))]);

  qryVendasClientes.Sql[NumerodalinhanoTexto(qryVendasClientes.sql, '%_3_DataFaturamentoVendasProdutos')] :=
    format(FiltroDataFaturamento,[quotedstr(datetostr(DataInicial)),quotedstr(datetostr(DataFinal))]);

  qryVendasClientes.Sql[NumerodalinhanoTexto(qryVendasClientes.sql, '%FrentedeCaixaDataFaturamentoVendasProdutos')] :=
    format(FiltroDataFaturamentoFrentedeCaixa,[quotedstr(datetostr(DataInicial)),quotedstr(datetostr(DataFinal))]);

  qryVendasClientes.Sql[NumerodalinhanoTexto(qryVendasClientes.sql, '%DataFaturamentoVendasServicos')] :=
    format(FiltroDataFaturamento,[quotedstr(datetostr(DataInicial)),quotedstr(datetostr(DataFinal))]);

  qryVendasClientes.Sql[NumerodalinhanoTexto(qryVendasClientes.sql, '%DataFaturamentoVendasDevolucoes')] :=
    format(FiltroDataDevolucao,[quotedstr(datetostr(DataInicial)),quotedstr(datetostr(DataFinal))]);

  qryVendasClientes.Sql[NumerodalinhanoTexto(qryVendasClientes.sql, '%DataFaturamentoNotasPag')] :=
    format(FiltroDataNotasPag,[quotedstr(datetostr(DataInicial)),quotedstr(datetostr(DataFinal))]);

  qryVendasClientes.Sql[NumerodalinhanoTexto(qryVendasClientes.sql, '%DataPagamentoCancelamento')] :=
    format(FiltroDataCancelamento,[quotedstr(datetostr(DataInicial)),quotedstr(datetostr(DataFinal))]);

  qryVendasClientes.Sql[NumerodalinhanoTexto(qryVendasClientes.sql, '%DataInicial_1')] :=
     datetostr(DataInicial);

  qryVendasClientes.Sql[NumerodalinhanoTexto(qryVendasClientes.sql, '%DataInicial_2')] :=
     datetostr(DataInicial);

  qryVendasClientes.Sql[NumerodalinhanoTexto(qryVendasClientes.sql, '%DataFinal')] :=
     datetostr(DataFinal);

  qrynMeses.Sql[NumerodalinhanoTexto(qrynMeses.sql, '%DataInicial_1')] :=
     datetostr(DataInicial);

  qrynMeses.Sql[NumerodalinhanoTexto(qrynMeses.sql, '%DataInicial_2')] :=
     datetostr(DataInicial);

  qrynMeses.Sql[NumerodalinhanoTexto(qrynMeses.sql, '%DataFinal')] :=
     datetostr(DataFinal);

  FiltroVendas := '';
  FiltroNotasPag := '';
  FrentedeCaixaFiltroVendas := '';

  FiltroServicos := '';

  if EmLinha and not ForadeLinha then
  begin
    FiltroVendas := FiltroVendas +' and not estoques_produtoforalinha(p.codigo)';
    FiltroNotasPag := FiltroNotasPag +' and not estoques_produtoforalinha(p.codigo)';
    FrentedeCaixaFiltroVendas := FrentedeCaixaFiltroVendas +' and not estoques_produtoforalinha(p.codigo)';
  end
  else
  if ForadeLinha and not emlinha then
  begin
    FiltroVendas := FiltroVendas +' and estoques_produtoforalinha(p.codigo)';
    FiltroNotasPag := FiltroNotasPag+' and estoques_produtoforalinha(p.codigo)';
    FrentedeCaixaFiltroVendas := FrentedeCaixaFiltroVendas +' and estoques_produtoforalinha(p.codigo)';
  end;

  if Ativo and not Inativo then
  begin
    FiltroVendas := FiltroVendas +' and  not estoques_produtoinativo(p.codigo)';
    FiltroNotasPag := FiltroNotasPag +' and  not estoques_produtoinativo(p.codigo)';
    FrentedeCaixaFiltroVendas := FrentedeCaixaFiltroVendas +' and  not estoques_produtoinativo(p.codigo)'
  end
  else
  if Inativo and not Ativo then
  begin
    FiltroVendas := FiltroVendas +' and estoques_produtoinativo(p.codigo)';
    FiltroNotasPag := FiltroNotasPag +' and estoques_produtoinativo(p.codigo)';
    FrentedeCaixaFiltroVendas := FrentedeCaixaFiltroVendas +' and estoques_produtoinativo(p.codigo)';
  end;

  if ComMontagem and not SemMontagem then
  begin
    FiltroVendas := FiltroVendas +' and (c.montagem)';
    FiltroNotasPag := FiltroNotasPag +' and (c.montagem)';
    FrentedeCaixaFiltroVendas := FrentedeCaixaFiltroVendas +' and coalesce(c.montagem,false)';
  end
  else
  if SemMontagem and not ComMontagem then
  begin
    FiltroVendas := FiltroVendas +' and not (c.montagem)';
    FiltroNotasPag := FiltroNotasPag +' and not (c.montagem)';
    FrentedeCaixaFiltroVendas := FrentedeCaixaFiltroVendas +' and not coalesce(c.montagem,false)';
  end;

  if Brinde and not NaoBrinde then
  begin
    FiltroVendas := FiltroVendas +' and (pc.brinde)';
//    FiltroNotasPag := FiltroNotasPag +' and (pc.brinde)';
    FrentedeCaixaFiltroVendas := FrentedeCaixaFiltroVendas +' and coalesce(pdf.brinde,false)';
  end
  else
  if NaoBrinde and not Brinde then
  begin
    FiltroVendas := FiltroVendas +' and not (pc.brinde)';
//    FiltroNotasPag := FiltroNotasPag +' and not (pc.brinde)';
    FrentedeCaixaFiltroVendas := FrentedeCaixaFiltroVendas +' and not coalesce(pdf.brinde,false)';
  end;

  if ItemProduto<>'' then
  begin
    {
    FiltroVendas := FiltroVendas + ' and (p.codigo = ''''' + itemproduto + ''''')';
    FrentedeCaixaFiltroVendas := FrentedeCaixaFiltroVendas + ' and (p.codigo = ''''' + itemproduto + ''''')';
    }

    FiltroVendas := FiltroVendas + 'and (' + trocar(ItemProduto, '''', '''''') + ')';
    FiltroNotasPag := FiltroNotasPag + 'and (' + trocar(ItemProduto, '''', '''''') + ')';
    FrentedeCaixaFiltroVendas := FrentedeCaixaFiltroVendas + 'and (' + trocar(ItemProduto, '''', '''''') + ')';
  end;

  if produto<>'' then
  begin
    {
    FiltroVendas := FiltroVendas + ' and (c.codigo = ''''' + produto + ''''')';
    FrentedeCaixaFiltroVendas := FrentedeCaixaFiltroVendas + ' and (c.codigo = ''''' + produto + ''''')';
    }

    FiltroVendas := FiltroVendas + 'and (' + trocar(Produto, '''', '''''') + ')';
    FiltroNotasPag := FiltroNotasPag + 'and (' + trocar(Produto, '''', '''''') + ')';
    FrentedeCaixaFiltroVendas := FrentedeCaixaFiltroVendas + 'and (' + trocar(Produto, '''', '''''') + ')';

  end;

  if Grupo<>'' then
  begin
  {
    FiltroVendas := FiltroVendas + ' and (c.grupo = ''''' + Grupo + ''''')';
    FrentedeCaixaFiltroVendas := FrentedeCaixaFiltroVendas + ' and (c.grupo = ''''' + Grupo + ''''')';
    }
    FiltroVendas := FiltroVendas + 'and (' + trocar(Grupo, '''', '''''') + ')';
    FiltroNotasPag := FiltroNotasPag + 'and (' + trocar(Grupo, '''', '''''') + ')';
    FrentedeCaixaFiltroVendas := FrentedeCaixaFiltroVendas + 'and (' + trocar(Grupo, '''', '''''') + ')';
  end;

  if Classe<>'' then
  begin
    {
    FiltroVendas := FiltroVendas + ' and (c.classe = ''''' + classe + ''''')';
    FrentedeCaixaFiltroVendas := FrentedeCaixaFiltroVendas + ' and (c.classe = ''''' + classe + ''''')';
    }
    FiltroVendas := FiltroVendas + 'and (' + trocar(Classe, '''', '''''') + ')';
    FiltroNotasPag := FiltroNotasPag + 'and (' + trocar(Classe, '''', '''''') + ')';
    FrentedeCaixaFiltroVendas := FrentedeCaixaFiltroVendas + 'and (' + trocar(Classe, '''', '''''') + ')';
  end;

  if Marca<>'' then
  begin
    {
    FiltroVendas := FiltroVendas + ' and (c.marca = ''''' + Marca + ''''')';
    FrentedeCaixaFiltroVendas := FrentedeCaixaFiltroVendas + ' and (c.marca = ''''' + Marca + ''''')';
    }
    FiltroVendas := FiltroVendas + 'and (' + trocar(Marca, '''', '''''') + ')';
    FiltroNotasPag := FiltroNotasPag + 'and (' + trocar(Marca, '''', '''''') + ')';
    FrentedeCaixaFiltroVendas := FrentedeCaixaFiltroVendas + 'and (' + trocar(Marca, '''', '''''') + ')';
  end;

  if GrupoFiliais<>'' then
  begin
    if ParSistema.RelatorioSomenteFiliaisAutorizadas then
    begin
      FiltroVendas := FiltroVendas +
                      format(FiltroFilial, [Filiais]) + ' and '+
                      format(FiltroGrupoFilial, [GrupoFiliais]);

      FiltroNotasPag := FiltroNotasPag +
                      format(FiltroFilialNotasPag, [Filiais]) + ' and '+
                      format(FiltroGrupoFilialNotasPag, [GrupoFiliais]);


      FrentedeCaixaFiltroVendas := FrentedeCaixaFiltroVendas +
                      format(FiltroFilialFrentedeCaixa, [Filiais]) + ' and '+
                      format(FiltroGrupoFilialFrentedeCaixa, [GrupoFiliais]);

      FiltroServicos := format(FiltroFilial, [Filiais]) + ' and '+
                        format(FiltroGrupoFilial, [GrupoFiliais]);
    end
    else
    begin
      FiltroVendas := FiltroVendas +
                      format(FiltroGrupoFilial, [GrupoFiliais]);

      FiltroNotasPag := FiltroNotasPag +
                      format(FiltroGrupoFilialNotasPag, [GrupoFiliais]);

      FrentedeCaixaFiltroVendas := FrentedeCaixaFiltroVendas +
                      format(FiltroGrupoFilialFrentedeCaixa, [GrupoFiliais]);

      FiltroServicos := format(FiltroGrupoFilial, [GrupoFiliais]);
    end;
    foutras := foutras + ' Grupo de Filiais: '+GrupoFiliais;
  end
  else
  if Filiais<>'' then
  begin
    FiltroVendas := FiltroVendas + format(FiltroFilial, [Filiais]);
    FiltroNotasPag := FiltroNotasPag + format(FiltroFilialNotasPag, [Filiais]);
    FrentedeCaixaFiltroVendas := FrentedeCaixaFiltroVendas + format(FiltroFilialFrentedeCaixa, [Filiais]);

    FiltroServicos := format(FiltroFilial, [Filiais]);
    foutras := foutras + ' Filiais: '+Filiais;
  end;

  if cliente<>'' then
  begin
    FiltroVendas := FiltroVendas + format(FiltroCliente, [cliente, tipocliente]);
    FiltroNotasPag := FiltroNotasPag + format(FiltroFornecedor, [cliente, tipocliente]);
    FrentedeCaixaFiltroVendas := FrentedeCaixaFiltroVendas + format(FiltroClienteFrentedeCaixa, [cliente, tipocliente]);
    FiltroServicos := FiltroServicos + format(FiltroCliente, [cliente, tipocliente]);
  end;

  if vendedor <> '' then
  begin
    FiltroVendas := FiltroVendas + format(FiltroVendedor, [vendedor]);
    FiltroNotasPag := FiltroNotasPag + format(FiltroVendedorNotasPag, [vendedor]);
    FrentedeCaixaFiltroVendas := FrentedeCaixaFiltroVendas + format(FiltroVendedorFrentedeCaixa, [vendedor]);
    FiltroServicos := FiltroServicos + format(FiltroVendedor, [vendedor]);
  end;

//  qryVendas.Sql[NumerodalinhanoTexto(qryVendas.sql, '%FiltroVendas')] := FiltroVendas;
  qryVendas.Sql[NumerodalinhanoTexto(qryVendas.sql, '%_2_FiltroVendas')] := FiltroVendas;
  qryVendas.Sql[NumerodalinhanoTexto(qryVendas.sql, '%_3_FiltroVendas')] := FiltroVendas;

  qryVendas.Sql[NumerodalinhanoTexto(qryVendas.sql, '%FiltroNotasPag')] := FiltroNotasPag;

  qryVendas.Sql[NumerodalinhanoTexto(qryVendas.sql, '%FrentedeCaixaFiltroVendas')] := FrentedeCaixaFiltroVendas;
  qryVendas.Sql[NumerodalinhanoTexto(qryVendas.sql, '%_2_FrentedeCaixaFiltroVendas')] := FrentedeCaixaFiltroVendas;
  qryVendas.Sql[NumerodalinhanoTexto(qryVendas.sql, '%FiltroServicos')] := FiltroServicos;
  qryVendas.Sql[NumerodalinhanoTexto(qryVendas.sql, '%FiltroDevolucoes')] := FiltroVendas;
  qryVendas.Sql[NumerodalinhanoTexto(qryVendas.sql, '%FiltroCancelamentos')] := FiltroVendas;

//  qryVendasClientes.Sql[NumerodalinhanoTexto(qryVendasClientes.sql, '%FiltroVendas')] := FiltroVendas;
  qryVendasClientes.Sql[NumerodalinhanoTexto(qryVendasClientes.sql, '%_2_FiltroVendas')] := FiltroVendas;
  qryVendasClientes.Sql[NumerodalinhanoTexto(qryVendasClientes.sql, '%_3_FiltroVendas')] := FiltroVendas;

  qryVendasClientes.Sql[NumerodalinhanoTexto(qryVendasClientes.sql, '%FiltroNotasPag')] := FiltroNotasPag;

  qryVendasClientes.Sql[NumerodalinhanoTexto(qryVendasClientes.sql, '%FrentedeCaixaFiltroVendas')] := FrentedeCaixaFiltroVendas;
  qryVendasClientes.Sql[NumerodalinhanoTexto(qryVendasClientes.sql, '%_2_FrentedeCaixaFiltroVendas')] := FrentedeCaixaFiltroVendas;
