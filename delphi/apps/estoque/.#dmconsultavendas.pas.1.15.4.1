procedure TdtmConsultaVendas.CalcularVendasTotais;
var
 i : integer;
begin
  if not qryVendasTotais.Active then
    qryVendasTotais.Open;

  qryVendasTotais.Edit;

//  qryVendasClientes.DisableControls;
  qryVendasClientes.First;
  while not qryVendasClientes.Eof do
  begin
    for i:=0 to qryVendasClientes.FieldCount-1 do
    begin
     if copy(qryVendasClientes.Fields[i].FieldName,1,1) = 'm' then
     begin
       qryVendasTotais.Fields[i].AsCurrency :=
         qryVendasTotais.Fields[i].AsCurrency +
         qryVendasClientes.Fields[i].AsCurrency;
     end
     else
     if qryVendasClientes.Fields[i].FieldName = 'Total' then
     begin
       qryVendasTotais.Fields[i].AsCurrency :=
         qryVendasTotais.Fields[i].AsCurrency +
         qryVendasClientes.Fields[i].AsCurrency;
     end
    end;
    qryVendasClientes.Next;
  end;
  qryVendasTotais.Post;
//  qryVendasClientes.EnableControls;
end;

procedure TdtmConsultaVendas.CalcularVendasQuantidades;
var
 i : integer;
begin
  if not qryVendasQuantidades.Active then
    qryVendasQuantidades.Open;

  if qryvendas.Active then
  begin
    qryVendasQuantidades.Delete;
    qryVendasQuantidades.Edit;
//    qryVendas.DisableControls;
    qryVendas.First;
    while not qryVendas.Eof do
    begin
      if (qryVendascliente.AsInteger = qryVendasClientesCliente.AsInteger) and
         (qryVendastipocliente.AsString = qryVendasClientesTipoCliente.AsString) then
      begin
        for i:=0 to qryVendas.FieldCount-1 do
        begin
         if copy(qryVendas.Fields[i].FieldName,1,1) = 'm' then
         begin
           qryVendasQuantidades.Fieldbyname(qryvendas.Fields[i].FieldName).AsCurrency :=
             qryVendasQuantidades.Fieldbyname(qryvendas.Fields[i].FieldName).AsCurrency +
             qryVendas.Fields[i].AsCurrency;
         end
         else
         if qryVendas.Fields[i].FieldName = 'Total' then
         begin
           qryVendasQuantidades.Fieldbyname(qryvendas.Fields[i].FieldName).AsCurrency :=
             qryVendasQuantidades.Fieldbyname(qryvendas.Fields[i].FieldName).AsCurrency +
             qryVendas.Fields[i].AsCurrency;
         end
        end;
      end;
      qryVendas.Next;
    end;
    qryVendasQuantidades.Post;
  end;
//  qryVendas.EnableControls;
end;

