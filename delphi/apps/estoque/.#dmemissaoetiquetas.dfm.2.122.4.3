  object qryEtiquetasMovimento: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      
        'Select t.produto as codigo, p.codigovisual, 0.00 as valorparcela' +
        ', 0 as qtdeparcelas, 0.00 as totalparcelas, 0 as entrada,'
      '           t.filial as filial,'
      '           abs(t.quantidade) as quantidadeproduto,'
      
        '           CAST(UPPER(TO_ASCII(p.descricao, '#39'LATIN_1'#39')) AS VARCH' +
        'AR) as descricaoproduto,'
      
        '           (select gr.descricao from grades gr where gr.codigo =' +
        ' c.grade1) as linha,'
      
        '           (select gr.descricao from grades gr where gr.codigo =' +
        ' c.grade2) as coluna,'
      '           p.valorgrade1,'
      '           p.valorgrade2,'
      '           p.referencia, p.resultadocurvaabc,'
      '           '
      '           CodigoBarras(p.Codigo) AS CodigoBarras,'
      '              '
      '           c.fatorpreco, c.unidade,'
      '           m.descricao as descricaomarca,'
      
        '           e.ultimaentrada, cast('#39#39' as varchar) as produtoclient' +
        'e,'
      
        '           estoques_colunapreco(t.produto, t.filial) as preco, e' +
        'stoques_preco(t.produto,t.filial) as precoreal, estoques_precono' +
        'rmal(t.produto,t.filial) as preconormal, '
      
        '           true as marcar,(select  f.codigo from fornecedores f,' +
        '  fornecedoresprodutos fp   where (fp.caracteristica = c.codigo)' +
        ' and (f.codigo = fp.fornecedor) order by data desc limit 1) as c' +
        'odigofornecedor,'
      
        '           0.00 as total,(select  f.nome from fornecedores f,  f' +
        'ornecedoresprodutos fp  where (fp.caracteristica = c.codigo) and' +
        ' (f.codigo = fp.fornecedor)  order by data desc limit 1) as nome' +
        'fornecedor,e.localizacao, cast(null as integer) as ListaPadrao, ' +
        'c.Peso, g.descricao as descricaogrupo'
      
        'From   movimentos t, produtos p, caracteristicas c, marcas m, gr' +
        'upos g, estoques e'
      'Where (p.codigo = t.produto)'
      '/*   Preenchido em RunTime   Data Movto.    17 */'
      '/*   Preenchido em RunTime  Filial Movto.   18 */'
      '/*   Preenchido em RunTime  Tipo Movto.     19 */'
      '/*   em Linha / Ativos */'
      '  and   (p.caracteristica = c.codigo)'
      '  and   (m.codigo = c.marca) and (c.grupo = g.codigo)'
      '  and   (t.produto = e.produto) and (t.filial = e.filial)'
      '/*  and   (movimentos_emestoque(p.codigo, e.filial) > 0)*/'
      'Order By t.filial, t.produto')
    RequestLive = True
    Left = 217
    Top = 379
  end
