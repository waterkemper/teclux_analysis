  object qryEtiquetasProdutosExposicao: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'CampoListaPadrao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'LFrom'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Linha'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'LWhere'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'LOrdenacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      
        'Select p.codigo, p.codigovisual, c.fatorpreco, 0.00 as valorparc' +
        'ela, 0 as qtdeparcelas, 0.00 as totalparcelas, 0 as entrada,'
      '           c.unidade, cast('#39#39' as varchar) as produtocliente,'
      '           p.referencia, p.resultadocurvaabc,'
      
        '           CAST(UPPER(TO_ASCII(p.descricao, '#39'LATIN_1'#39')) AS VARCH' +
        'AR) as descricaoproduto,'
      
        '           (select gr.descricao from grades gr where gr.codigo =' +
        ' c.grade1) as linha,'
      
        '           (select gr.descricao from grades gr where gr.codigo =' +
        ' c.grade2) as coluna,'
      '           p.valorgrade1,'
      '           p.valorgrade2,'
      '           m.descricao as descricaomarca,'
      '           e.filial as filial,'
      ''
      
        '           case when coalesce(g.umaetiquetaporbalcao,false) then' +
        ' 1.000'
      
        '                when coalesce(:QuantidadeLote, false) then  (sel' +
        'ect sum(pf.qtderecebida)  from pedidosfiliais pf where pf.produt' +
        'o = p.codigo and pf.lotetransferencia = coalesce(:lotetransferen' +
        'cia,0))'
      
        '                when coalesce(:QtdemEstoqueProdutosExposicao,tru' +
        'e) then e.emestoque /*movimentos_emestoque(p.codigo, e.filial)*/'
      
        '                when coalesce(:QtdeZeradaProdutosExposicao,false' +
        ') then 0.000'
      '           end as quantidadeproduto,'
      '           estoques_colunapreco(p.codigo, e.filial) as preco,'
      '           estoques_preco(p.codigo,e.filial) as precoreal,'
      
        '           estoques_preconormal(p.codigo,e.filial) as preconorma' +
        'l,'
      ''
      '           e.ultimaentrada,'
      '           '
      '           CodigoBarras(p.Codigo) AS CodigoBarras,'
      ''
      
        '           true as marcar,(select  f.codigo from fornecedores f,' +
        '  fornecedoresprodutos fp   where (fp.caracteristica = c.codigo)' +
        ' and (f.codigo = fp.fornecedor) order by data desc limit 1) as c' +
        'odigofornecedor,'
      
        '           0.00 as total,(select  f.nome from fornecedores f,  f' +
        'ornecedoresprodutos fp   where (fp.caracteristica = c.codigo) an' +
        'd (f.codigo = fp.fornecedor)  order by data desc limit 1) as nom' +
        'efornecedor,'
      '           e.localizacao'
      ''
      
        '           %CampoListaPadrao, c.Peso, g.descricao as descricaogr' +
        'upo'
      ''
      
        'From   estoques e,filiais f, (produtos p left join promocoes pro' +
        ' on p.promocao = pro.codigo), caracteristicas c, grupos g, marca' +
        's m, classes cl'
      ''
      '%LFrom'
      ''
      'Where'
      ''
      '       (c.codigo = p.caracteristica)'
      '   and (e.produto = p.codigo) and (e.filial=f.codigo)'
      
        '   and (m.codigo = c.marca) and (c.grupo = g.codigo) and (c.marc' +
        'a = m.codigo) and (c.classe = cl.codigo)'
      ''
      '%Linha'
      ''
      '%LWhere'
      ''
      '%LOrdenacao'
      ''
      ''
      ''
      '')
    RequestLive = True
    Left = 209
    Top = 600
    ParamData = <
      item
        DataType = ftString
        Name = 'QuantidadeLote'
        ParamType = ptUnknown
        Value = 'false'
      end
      item
        DataType = ftString
        Name = 'lotetransferencia'
        ParamType = ptUnknown
        Value = '0'
      end
      item
        DataType = ftString
        Name = 'QtdemEstoqueProdutosExposicao'
        ParamType = ptUnknown
        Value = 'true'
      end
      item
        DataType = ftString
        Name = 'QtdeZeradaProdutosExposicao'
        ParamType = ptUnknown
        Value = 'false'
      end>
  end
