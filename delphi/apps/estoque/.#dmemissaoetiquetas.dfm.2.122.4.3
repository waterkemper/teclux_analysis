      '              (b.codigo = d.bairro)'
      '       ) as nomebairro'
      'From notas n, dadosfiscais d'
      'Where (n.dadofiscal = d.numero)'
      '%cliente'
      '%datainicialfinal'
      '%notainicialfinal'
      'Order By d.cliente, copia, n.serie, n.numero desc')
