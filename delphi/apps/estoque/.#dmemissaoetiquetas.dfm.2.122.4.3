      end>
    Sql.Strings = (
      
        'Select p.codigo, p.codigovisual, 0.00 as valorparcela, 0 as qtde' +
        'parcelas, 0.00 as totalparcelas,'
      
        '           CAST(UPPER(TO_ASCII(p.descricao, '#39'LATIN_1'#39')) AS VARCH' +
        'AR) as descricaoproduto,'
      
        '          (select gr.descricao from grades gr where gr.codigo = ' +
        'c.grade1) as linha,'
      
        '          (select gr.descricao from grades gr where gr.codigo = ' +
        'c.grade1) as coluna,'
      '          p.valorgrade1,'
      '          p.valorgrade2,'
      
        '          m.descricao as descricaomarca, p.referencia, p.resulta' +
        'docurvaabc,'
      '          c.fatorpreco,'
      '          c.unidade, cast('#39#39' as varchar) as produtocliente,'
      '          pn.filial  as filial,'
      '          '
      '          CodigoBarras(p.Codigo) AS CodigoBarras,'
      ''
      '          pn.qtdeestoque as quantidadeproduto,'
      
        '          estoques_colunapreco(p.codigo, pn.filial) as preco, es' +
        'toques_preco(p.codigo,pn.filial) as precoreal, estoques_preconor' +
        'mal(p.codigo,pn.filial) as preconormal,'
      
        '          (select e.ultimaentrada from estoques e where e.produt' +
        'o = pn.produto and e.filial = pn.filial) as ultimaentrada,'
      
        '          true as marcar,(select  f.codigo from fornecedores f, ' +
        ' fornecedoresprodutos fp  where (fp.caracteristica = c.codigo) a' +
        'nd (f.codigo = fp.fornecedor) order by data desc limit 1) as cod' +
        'igofornecedor,'
      '          0    as entrada,'
      
        '          0.00 as total, (select  f.nome from fornecedores f,  f' +
        'ornecedoresprodutos fp where (fp.caracteristica = c.codigo) and ' +
        '(f.codigo = fp.fornecedor)  order by data desc limit 1) as nomef' +
        'ornecedor,(select localizacao from estoques e where e.produto=pn' +
        '.produto and e.filial=pn.filial) as localizacao, cast(null as in' +
        'teger) as ListaPadrao, c.Peso, g.descricao as descricaogrupo'
      
        'From notaspag n, produtosnotaspag pn, produtos p, caracteristica' +
        's c, grupos g, marcas m'
      'Where n.fornecedor = :fornecedor and n.situacao='#39'N'#39
      '     and n.serie = :serie'
      '     and n.numero = :nota'
      '     and n.codigo = pn.codigonota'
      '     and p.codigo = pn.produto'
      '     and c.codigo = p.caracteristica and c.grupo = g.codigo'
      '     and m.codigo = c.marca'
      '     %sql'
      '     /*Run Time*/'
      
        '    /*Order BY pn.numero, p.codigo,UPPER(TO_ASCII(p.descricao,'#39'L' +
        'ATIN1'#39')),p.valorgrade1, p.valorgrade1, UPPER(TO_ASCII(m.descrica' +
        'o,'#39'LATIN1'#39')), c.volumes, pn.quantidade, pn.filial */'
      ''
      ''
      '')
