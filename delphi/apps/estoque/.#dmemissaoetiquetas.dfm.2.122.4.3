  object qryEtiquetasPedidos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'CondicaoPedido'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'OrdenacaoPedido'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select p.codigo,'
      '       p.codigovisual,'
      '       0.00 as valorparcela,'
      '       0 as qtdeparcelas,'
      '       0.00 as totalparcelas,'
      
        '         CAST(UPPER(TO_ASCII(p.descricao, '#39'LATIN_1'#39')) AS VARCHAR' +
        ') as descricaoproduto,'
      
        '       (select gr.descricao from grades gr where gr.codigo = c.g' +
        'rade1) as linha,'
      
        '       (select gr.descricao from grades gr where gr.codigo = c.g' +
        'rade1) as coluna,'
      '       p.valorgrade1,'
      '       p.valorgrade2,'
      '       m.descricao as descricaomarca,'
      '       p.referencia, p.resultadocurvaabc,'
      '       c.fatorpreco,'
      '       c.unidade,'
      '       cast('#39#39' as varchar) as produtocliente,'
      '       pd.filialentrega  as filial,'
      '       pp.quantidade as quantidadeproduto,'
      
        '       estoques_colunapreco(p.codigo, pd.filialentrega) as preco' +
        ','
      '       estoques_preco(p.codigo,pd.filialentrega) as precoreal,'
      
        '       estoques_preconormal(p.codigo,pd.filialentrega) as precon' +
        'ormal,'
      '       (select e.ultimaentrada'
      '        from estoques e'
      '        where e.produto = pp.produto'
      '          and e.filial = pd.filialentrega) as ultimaentrada,'
      ''
      '       true as marcar,'
      ''
      '       CodigoBarras(p.Codigo) AS CodigoBarras,'
      ''
      '       (select  fp.fornecedor'
      '        from fornecedoresprodutos fp'
      '        where fp.caracteristica = c.codigo'
      '        order by fp.data desc limit 1) as codigofornecedor,'
      ''
      '       0    as entrada,'
      '       0.00 as total,'
      ''
      
        '       (select  f.nome from fornecedores f,  fornecedoresproduto' +
        's fp'
      '        where (fp.caracteristica = c.codigo)'
      '          and (f.codigo = fp.fornecedor)'
      '        order by fp.data desc limit 1) as nomefornecedor,'
      ''
      '       (select e.localizacao'
      '        from estoques e'
      '        where e.produto=pp.produto'
      '          and e.filial=pd.filialentrega) as localizacao,'
      
        '       cast(null as integer) as ListaPadrao, c.Peso, g.descricao' +
        ' as descricaogrupo'
      'From pedidos pd'
      '     join produtospedidos pp'
      '          join produtos p'
      '               join caracteristicas c'
      '                    join marcas m'
      '                    on c.marca = m.codigo'
      ''
      '                    join grupos g'
      '                    on c.grupo = g.codigo'
      ''
      '               on p.caracteristica = c.codigo'
      '          on pp.produto = p.codigo'
      '     on pd.numero = pp.pedido'
      '     join fornecedores f'
      '     on pd.fornecedor = f.codigo'
      ''
      'Where pd.numero = pp.pedido'
      '  and pp.produto = p.codigo'
      '  and p.caracteristica = c.codigo'
      '  and c.marca = m.codigo'
      '  and pd.fornecedor = f.codigo'
      '  %CondicaoPedido'
      '%OrdenacaoPedido')
    RequestLive = True
    Left = 138
    Top = 536
  end
