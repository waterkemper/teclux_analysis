  object qryEtiquetasProdutosNotasSaidas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftString
        Name = 'DADOSFISCAIS'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroProdutos'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select cast(COALESCE((select cast(cp.produto_cliente as varchar)'
      '                      from clientesprodutos cp'
      '                      where cp.cliente = df.cliente'
      '                        and cp.tipocliente = df.tipocliente'
      '                        and cp.produto = pdf.produto),'
      
        '                      cast(pdf.produto as varchar)) as varchar) ' +
        'as produtocliente,'
      '       pdf.produto as codigo, p.codigovisual, '
      '       0.00 as valorparcela,'
      '       0 as qtdeparcelas,'
      '       0.00 as totalparcelas,'
      '       0 as entrada,'
      
        '           CAST(UPPER(TO_ASCII(p.descricao, '#39'LATIN_1'#39')) AS VARCH' +
        'AR) as descricaoproduto,'
      
        '       (select  f.nome from fornecedores f,  fornecedoresproduto' +
        's fp  where (fp.caracteristica = c.codigo) and (f.codigo = fp.fo' +
        'rnecedor) order by data desc limit 1) as nomefornecedor,'
      
        '       (select gr.descricao from grades gr where gr.codigo = c.g' +
        'rade1) as linha,'
      
        '       (select gr.descricao from grades gr where gr.codigo = c.g' +
        'rade2) as coluna,'
      '       p.valorgrade1,'
      '       p.valorgrade2,'
      '       cast(COALESCE((select cast(cp.produto_cliente as varchar)'
      '                      from clientesprodutos cp'
      '                      where cp.cliente = df.cliente'
      '                        and cp.tipocliente = df.tipocliente'
      
        '                        and cp.produto = p.codigo)||'#39'-'#39'||cast(p.' +
        'referencia as varchar),'
      
        '                      cast(p.referencia as varchar)) as varchar)' +
        ' as referencia,'
      '       p.referencia as referencia, p.resultadocurvaabc,'
      
        '       (select  f.codigo from fornecedores f,  fornecedoresprodu' +
        'tos fp   where (fp.caracteristica = c.codigo) and (f.codigo = fp' +
        '.fornecedor) order by data desc limit 1) as codigofornecedor,'
      '       c.fatorpreco as fatorpreco,'
      '       c.unidade,'
      
        '       (select m.descricao from marcas m where m.codigo = c.marc' +
        'a) as descricaomarca,'
      '       pdf.filial,'
      '       pdf.quantidade as quantidadeproduto,'
      '       current_date as ultimaentrada,'
      '       precovenda as preco,'
      '           '
      '       CodigoBarras(p.Codigo) AS CodigoBarras,'
      ''
      '       precotabela as precoreal,'
      '       precotabela as preconormal,'
      ''
      '       0.00 as total,'
      '       true as marcar,'
      
        '       (select e.localizacao from estoques e where e.produto = p' +
        '.codigo and e.filial = pdf.filial) as localizacao,'
      
        '       cast(null as integer) as ListaPadrao, c.Peso, g.descricao' +
        ' as descricaogrupo'
      
        'from caracteristicas c, produtos p, produtosdadosfiscais pdf, da' +
        'dosfiscais df, grupos g'
      'where c.codigo  = p.caracteristica and c.grupo = g.codigo'
      '  and p.codigo  = pdf.produto'
      '  and df.numero = pdf.dadofiscal'
      '%DADOSFISCAIS'
      '%FiltroProdutos'
      'order by pdf.dadofiscal desc, pdf.numero')
    RequestLive = True
    Left = 217
    Top = 424
  end
  object qryProcuraSeries: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterScroll = qryProcuraSeriesAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT sf.fornecedor,'
      '       sf.serie,'
      '       sf.modelodoctofiscal'
      'FROM     seriesfornecedores sf'
      'WHERE (sf.fornecedor = :fornecedor) and'
      '              (sf.serie = :serie) and'
      '               ('#39'F'#39' = :tipo)'
      'UNION'
      'SELECT sc.cliente,'
      '       sc.serie,'
      '       sc.modelodoctofiscal'
      'FROM    seriesclientes sc'
      'WHERE (sc.cliente =:fornecedor) and'
      '             (sc.serie =:serie) and'
      '             ('#39'C'#39' =:tipo)'
      'union'
      'select sf.filial,'
      '       sf.valor as serie,'
      '       sf.modelodoctofiscal'
      'from seriesfiliais sf'
      'where (sf.filial = :FilialBase) and'
      '           (sf.valor = :serie) and'
      '          ('#39'C'#39' = :tipo) and'
      '          ((select count(*)'
      '             from seriesclientes'
      '             where cliente = :fornecedor) = 0)'
      'UNION'
      'SELECT sf.filial,'
      '       sf.valor as serie,'
      '       sf.modelodoctofiscal'
      'FROM    seriesfiliais sf'
      'WHERE (sf.filial = :fornecedor) and'
      '             (sf.valor = :serie) and'
      '             ('#39'L'#39' = :tipo)'
      'ORDER BY serie')
    RequestLive = False
