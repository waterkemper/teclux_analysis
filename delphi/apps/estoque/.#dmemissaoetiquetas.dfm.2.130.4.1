    Sql.Strings = (
      'SELECT sf.fornecedor,'
      '       sf.serie,'
      '       sf.modelodoctofiscal'
      'FROM     seriesfornecedores sf'
      'WHERE (sf.fornecedor = :fornecedor) and'
      '              (sf.serie = :serie) and'
      '               ('#39'F'#39' = :tipo)'
      'UNION'
      'SELECT sc.cliente,'
      '       sc.serie,'
      '       sc.modelodoctofiscal'
      'FROM    seriesclientes sc'
      'WHERE (sc.cliente =:fornecedor) and'
      '             (sc.serie =:serie) and'
      '             ('#39'C'#39' =:tipo)'
      'union'
      'select sf.filial,'
      '       sf.valor as serie,'
      '       sf.modelodoctofiscal'
      'from seriesfiliais sf'
      'where (sf.filial = :FilialBase) and'
      '           (sf.valor = :serie) and'
      '          ('#39'C'#39' = :tipo) and'
      '          ((select count(*)'
      '             from seriesclientes'
      '             where cliente = :fornecedor) = 0)'
      'UNION'
      'SELECT sf.filial,'
      '       sf.valor as serie,'
      '       sf.modelodoctofiscal'
      'FROM    seriesfiliais sf'
      'WHERE (sf.filial = :fornecedor) and'
      '             (sf.valor = :serie) and'
      '             ('#39'L'#39' = :tipo)'
      'ORDER BY serie')
