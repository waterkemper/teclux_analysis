    Constraints = <>
    AfterScroll = qryEtiquetasMagaluAfterScroll
    OnCalcFields = qryEtiquetasMagaluCalcFields
    OnFilterRecord = qryEtiquetasMagaluFilterRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'ListaVendedoresDadosFiscais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListaDadosFiscais'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select df.nome as nomecliente,'
      '       n.filial,'
      '       n.serie,'
      '       n.numero as numeronf,'
      '       n.dadofiscal,'
      '       df.chv_nfe,'
      '       df.data as datenf,'
      '       false as impresso,'
      '       df.vendedor as vendedordadofiscal,'
      '       u.nome as nomevendedordadofiscal,'
      '       f.cep as cepfilialvenda,'
      '       f.numero as endnumerofilialvenda,'
      '       f.nome as nomefilialvenda,'
      '       f.rua as ruafilialvenda,'
      '       f.complemento as endcomplementofilialvenda,'
      '       c_f.nome as nomecidadefilialvenda,'
      '       b_f.nome as nomebairrofilialvenda,'
      '       f.estado as estadofilialvenda,'
      ''
      '       ct.foneddd,'
      '       ct.fonenumero,'
      '       mk.numerocontratotransp,'
      '       c_ps.nome as entnomecidade,'
      '       b_ps.nome as entnomebairro,'
      '       mk.cartaopostagem,'
      '       false as imprimir,'
      '       ps.*'
      ''
      'from pedidos_site ps'
      '     join contratos ct'
      
        '          join (dadosfiscais df left join usuarios u on df.vende' +
        'dor = u.codigo)'
      '               join notas n'
      '               on df.numero = n.dadofiscal'
      ''
      '          on ct.numero = df.contrato'
      ''
      '          join filiais f'
      ''
      '               join cidades c_f'
      '               on f.cidade = c_f.codigo'
      '               and f.estado = c_f.estado'
      ''
      '               join bairros b_f'
      '               on f.cidade = b_f.cidade'
      '               and f.bairro = b_f.codigo'
      '               and f.estado = b_f.estado'
      ''
      ''
      '          on ct.filialvenda = f.codigo'
      '     on ct.numero=ps.contrato'
      ''
      '     join cidades c_ps'
      '     on ps.entcidade = c_ps.codigo'
      '     and ps.entestado = c_ps.estado'
      ''
      '     join bairros b_ps'
      '     on ps.entcidade = b_ps.cidade'
      '     and ps.entbairro = b_ps.codigo'
      '     and ps.entestado = b_ps.estado'
      ''
      '     join marketplace mk'
      '     on ps.codigo_marketplace = mk.codigo'
      ''
      'where (nullif(trim(ps.codigo_rastreamento),'#39#39') <> '#39#39')'
      '  and trim(mk.descricao) = '#39'INTEGRACOMMERCE'#39
      '  and df.situacao = '#39'N'#39
      '  and df.data between :DataInicial and :DataFinal'
      
        '  and case when :incluirJaImpresso then true else not coalesce(p' +
        's.etiqueta_impressa,false) end'
      '  %ListaVendedoresDadosFiscais'
      '  %ListaDadosFiscais'
      ''
      ''
      '')
    RequestLive = True
    Left = 880
    Top = 160
    ParamData = <
      item
        DataType = ftString
        Name = 'DataInicial'
        ParamType = ptUnknown
        Value = #39'2020-02-01'#39
      end
      item
        DataType = ftString
        Name = 'DataFinal'
        ParamType = ptUnknown
        Value = #39'2020-02-02'#39
      end
      item
        DataType = ftString
        Name = 'incluirJaImpresso'
        ParamType = ptUnknown
        Value = 'True'
      end>
