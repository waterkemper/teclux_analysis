      item
        DataType = ftString
        Name = 'QtdemEstoqueProdutosExposicao'
        ParamType = ptUnknown
        Value = 'true'
      end
      item
        DataType = ftString
        Name = 'QtdeZeradaProdutosExposicao'
        ParamType = ptUnknown
        Value = 'false'
      end>
