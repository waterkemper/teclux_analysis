  object qryplpb2w: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryplpb2wAfterOpen
    AfterScroll = qryplpb2wAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select plp_b2w.marketplace, '
      '       plp_b2w.plp, '
      '       plp_b2w.data_inclusao, '
      '       plp_b2w.impresso,'
      
        '       cast(trim(CAST(cast(plp_b2w.dados_plp as json)->'#39'plp'#39'->'#39'r' +
        'esumoServicos'#39'->0->'#39'codServico'#39' as "varchar"(10)),'#39'"'#39') as varcha' +
        'r(10)) as codServico,'
      
        '       cast(trim(CAST(cast(plp_b2w.dados_plp as json)->'#39'plp'#39'->'#39'r' +
        'esumoServicos'#39'->0->'#39'nomeServico'#39' as "varchar"(50)),'#39'"'#39') as varch' +
        'ar(50)) as nomeServico,'
      ''
      '       (select marketplace.vendedor'
      '        from marketplace'
      
        '        where marketplace.codigo = plp_b2w.marketplace) as vende' +
        'dor,'
      ''
      '       (select u.nome'
      
        '        from marketplace join usuarios u  on marketplace.vendedo' +
        'r = u.codigo'
      
        '        where marketplace.codigo = plp_b2w.marketplace) as nomev' +
        'endedor'
      ''
      'from plp_b2w'
      ''
      
        'where cast(plp_b2w.data_inclusao as date) between :DataInicial a' +
        'nd :DataFinal'
      
        'and case when :incluirJaImpresso then true else not coalesce(plp' +
        '_b2w.impresso,false) end'
      '')
    RequestLive = True
    Left = 1008
    Top = 272
    ParamData = <
      item
        DataType = ftString
        Name = 'DataInicial'
        ParamType = ptUnknown
        Value = #39'2019-01-01'#39
      end
      item
        DataType = ftString
        Name = 'datafinal'
        ParamType = ptUnknown
        Value = #39'2019-12-31'#39
      end
      item
        DataType = ftString
        Name = 'incluirJaImpresso'
        ParamType = ptUnknown
        Value = 'True'
      end>
    object qryplpb2wmarketplace: TIntegerField
      FieldName = 'marketplace'
      Required = True
    end
    object qryplpb2wplp: TLargeintField
      FieldName = 'plp'
      Required = True
    end
