  object qryEtiquetasMagalu: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterScroll = qryEtiquetasMagaluAfterScroll
    OnCalcFields = qryEtiquetasMagaluCalcFields
    OnFilterRecord = qryEtiquetasMagaluFilterRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'ListaVendedoresDadosFiscais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListaDadosFiscais'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select df.nome as nomecliente,'
      '       n.filial,'
      '       n.serie,'
      '       n.numero as numeronf,'
      '       n.dadofiscal,'
      '       df.chv_nfe,'
      '       df.data as datenf,'
      '       false as impresso,'
      '       df.vendedor as vendedordadofiscal,'
      '       u.nome as nomevendedordadofiscal,'
      '       f.cep as cepfilialvenda,'
      '       f.numero as endnumerofilialvenda,'
      '       f.nome as nomefilialvenda,'
      '       f.rua as ruafilialvenda,'
      '       f.complemento as endcomplementofilialvenda,'
      '       c_f.nome as nomecidadefilialvenda,'
      '       b_f.nome as nomebairrofilialvenda,'
      '       f.estado as estadofilialvenda,'
      ''
      '       ct.foneddd,'
      '       ct.fonenumero,'
      '       mk.numerocontratotransp,'
      '       c_ct.nome as entnomecidade,'
      '       b_ct.nome as entnomebairro,'
      '       mk.cartaopostagem,'
      '       false as imprimir,'
      ''
      '       case when ct.entcidade is not null and'
      '                 ct.entestado is not null and'
      '                 ct.entbairro is not null and'
      
        '                 ct.entcep is not null then ct.entcep else ct.ce' +
        'p end as entcep,'
      ''
      '       case when ct.entcidade is not null and'
      '                 ct.entestado is not null and'
      '                 ct.entbairro is not null and'
      
        '                 ct.entcep is not null then ct.entnumero else ct' +
        '.endnumero end as entnumero,'
      ''
      '       case when ct.entcidade is not null and'
      '                 ct.entestado is not null and'
      '                 ct.entbairro is not null and'
      
        '                 ct.entcep is not null then ct.entcomplemento el' +
        'se ct.endcomplemento end as entcomplemento,'
      ''
      '       case when ct.entcidade is not null and'
      '                 ct.entestado is not null and'
      '                 ct.entbairro is not null and'
      
        '                 ct.entcep is not null then ct.entestado else ct' +
        '.estado end as entestado,'
      ''
      '       case when ct.entcidade is not null and'
      '                 ct.entestado is not null and'
      '                 ct.entbairro is not null and'
      
        '                 ct.entcep is not null then ct.entcidade else ct' +
        '.cidade end as entcidade,'
      ''
      '       case when ct.entcidade is not null and'
      '                 ct.entestado is not null and'
      '                 ct.entbairro is not null and'
      
        '                 ct.entcep is not null then ct.entbairro else ct' +
        '.bairro end as entbairro,'
      ''
      '       ps.*'
      ''
      'from pedidos_site ps'
      '     join contratos ct'
      
        '          join (dadosfiscais df left join usuarios u on df.vende' +
        'dor = u.codigo)'
      '               join notas n'
      '               on df.numero = n.dadofiscal'
      ''
      '          on ct.numero = df.contrato'
      ''
      '          join filiais f'
      ''
      '               join cidades c_f'
      '               on f.cidade = c_f.codigo'
      '               and f.estado = c_f.estado'
      ''
      '               join bairros b_f'
      '               on f.cidade = b_f.cidade'
      '               and f.bairro = b_f.codigo'
      '               and f.estado = b_f.estado'
      ''
      ''
      '          on ct.filialvenda = f.codigo'
      '     on ct.numero=ps.contrato'
      ''
      '     join cidades c_ct'
      '     on (case when ct.entcidade is not null and'
      '                   ct.entestado is not null and'
      '                   ct.entbairro is not null and'
      '                   ct.entcep is not null then'
      ''
      '                   ct.entcidade = c_ct.codigo and'
      '                   ct.entestado = c_ct.estado'
      ''
      '                   else'
      ''
      '                   ct.cidade = c_ct.codigo and'
      '                   ct.estado=c_ct.estado end)'
      ''
      ''
      '     join bairros b_ct'
      '     on (case when ct.entcidade is not null and'
      '                   ct.entestado is not null and'
      '                   ct.entbairro is not null and'
      
        '                   ct.entcep is not null then ct.entcidade = b_c' +
        't.cidade and'
      
        '                                                 ct.entestado = ' +
        'b_ct.estado and'
      
        '                                                 ct.entbairro = ' +
        'b_ct.codigo'
      '                                                 else'
      
        '                                                 ct.cidade = b_c' +
        't.cidade and'
      
        '                                                 ct.estado = b_c' +
        't.estado and'
      
        '                                                 ct.bairro = b_c' +
        't.codigo end)'
      ''
      '     join marketplace mk'
      '     on ps.codigo_marketplace = mk.codigo'
      ''
      'where (nullif(trim(ps.codigo_rastreamento),'#39#39') <> '#39#39')'
      '  and trim(mk.descricao) = '#39'INTEGRACOMMERCE'#39
      '  and df.situacao = '#39'N'#39
      '  and df.data between :DataInicial and :DataFinal'
      
        '  and case when :incluirJaImpresso then true else not coalesce(p' +
        's.etiqueta_impressa,false) end'
      '  %ListaVendedoresDadosFiscais'
      '  %ListaDadosFiscais'
      ''
      ''
      '')
    RequestLive = True
