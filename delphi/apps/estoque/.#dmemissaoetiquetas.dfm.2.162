  object qryConsultaSeries: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select sf.fornecedor,'
      '         sf.serie'
      'from seriesfornecedores sf'
      'where (sf.fornecedor = :fornecedor) and'
      '         ('#39'F'#39' = :tipo)'
      'union'
      'select  sc.cliente,'
      '          sc.serie'
      'from seriesclientes sc'
      'where  (sc.cliente =:fornecedor) and'
      '           ('#39'C'#39' =:tipo)'
      'union'
      'select sf.filial,'
      '         sf.valor as serie'
      'from seriesfiliais sf'
      'where (sf.filial = :FilialBase) and'
      '          ('#39'C'#39' = :tipo) and'
      '          ((select count(*)'
      '             from seriesclientes'
      '             where cliente = :fornecedor) = 0)'
      'union'
      'select sf.filial,'
      '         sf.valor as serie'
      'from seriesfiliais sf'
      'where (sf.filial = :fornecedor) and'
      '          ('#39'L'#39' = :tipo)'
      'ORDER BY serie'
      '')
    RequestLive = False
    Left = 484
    Top = 12
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'fornecedor'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'tipo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FilialBase'
        ParamType = ptUnknown
      end>
    object qryConsultaSeriesserie: TStringField
      DisplayLabel = 'S'#233'rie'
      DisplayWidth = 10
      FieldName = 'serie'
      Required = True
      Size = 3
    end
  end
