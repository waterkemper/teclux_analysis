  object qryplpb2w_items: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryplpb2w_itemsCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';     '
      
        'select cast(cast(cast(docsExternos as json)->n_docExternos->'#39'cod' +
        'Cliente'#39' as varchar(50)) as bigint) as codCliente,'
      
        '       cast(trim(cast(cast(docsExternos as json)->n_docExternos-' +
        '>'#39'docExterno'#39' as varchar), '#39'"'#39') as varchar(15)) as docExterno,'
      ''
      
        '       cast(cast(cast(docsExternos as json)->n_docExternos->'#39'pes' +
        'oTotal'#39' as varchar) as numeric) as pesoTotal,'
      
        '       cast(trim(cast(cast(docsExternos as json)->n_docExternos-' +
        '>'#39'tpEntrega'#39' as varchar), '#39'"'#39') as varchar(20)) as tpEntrega,'
      ''
      
        '       cast(trim(cast(cast(docsExternos as json)->n_docExternos-' +
        '>'#39'dtPrometida'#39' as varchar), '#39'"'#39') as varchar(10)) as dtPrometida,'
      ''
      
        '       cast(trim(cast(cast(docsExternos as json)->n_docExternos-' +
        '>'#39'marca'#39' as varchar), '#39'"'#39') as varchar(20)) as marca,'
      
        '       cast(cast(cast(docsExternos as json)->n_docExternos->'#39'qtV' +
        'olumes'#39' as varchar) as INTEGER) as qtVolumes,'
      
        '       cast(trim(cast(cast(docsExternos as json)->n_docExternos-' +
        '>'#39'numeroContratoTransp'#39' as varchar), '#39'"'#39') as varchar(100)) as nu' +
        'meroContratoTransp,'
      
        '       cast(trim(cast(cast(docsExternos as json)->n_docExternos-' +
        '>'#39'nomeEmbarcador'#39' as varchar), '#39'"'#39') as varchar(100)) as nomeEmba' +
        'rcador,'
      
        '       cast(trim(cast(cast(docsExternos as json)->n_docExternos-' +
        '>'#39'telefoneEmbarcador'#39' as varchar), '#39'"'#39') as varchar(50)) as telef' +
        'oneEmbarcador,'
      
        '       cast(trim(cast(cast(docsExternos as json)->n_docExternos-' +
        '>'#39'emailEmbarcador'#39'  as varchar), '#39'"'#39') as varchar(100)) as emailE' +
        'mbarcador,'
      
        '       cast(trim(cast(cast(docsExternos as json)->n_docExternos-' +
        '>'#39'tpServico'#39' as varchar), '#39'"'#39') as varchar(50)) as tpServico,'
      
        '       cast(trim(cast(cast(docsExternos as json)->n_docExternos-' +
        '>'#39'numNotaFiscal'#39' as varchar),'#39'"'#39') as varchar(30)) as numNotaFisc' +
        'al,'
      
        '       cast(trim(cast(cast(docsExternos as json)->n_docExternos-' +
        '>'#39'serieNotaFiscal'#39' as varchar), '#39'"'#39') as varchar(10)) as serieNot' +
        'aFiscal,'
      
        '       cast(trim(cast(cast(docsExternos as json)->n_docExternos-' +
        '>'#39'megaRota'#39' as varchar), '#39'"'#39') as varchar(50)) as megaRota,'
      
        '       cast(trim(cast(cast(docsExternos as json)->n_docExternos-' +
        '>'#39'rota'#39' as varchar), '#39'"'#39') as varchar(50)) as rota,'
      
        '       cast(trim(cast(cast(docsExternos as json)->n_docExternos-' +
        '>'#39'telefoneContato'#39' as varchar), '#39'"'#39') as varchar(50)) as telefone' +
        'Contato,'
      
        '       cast(cast(cast(docsExternos as json)->n_docExternos->'#39'vlE' +
        'ntrega'#39' as varchar) as numeric) as vlEntrega,'
      
        '       cast(trim(cast(cast(docsExternos as json)->n_docExternos-' +
        '>'#39'cartaoPostagem'#39' as varchar), '#39'"'#39') as varchar(20)) as cartaoPos' +
        'tagem,'
      
        '       cast(trim(cast(cast(docsExternos as json)->n_docExternos-' +
