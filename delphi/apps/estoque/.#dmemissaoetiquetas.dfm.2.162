  object qryRepresentante: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select  rp.*,'
      '        c.nome as nomecidade,'
      '        b.nome as nomebairro'
      ''
      'From representante rp, estados e, cidades c, bairros b'
      'where (rp.estado = e.codigo) and'
      '      (rp.estado = c.estado) and'
      '      (rp.cidade = c.codigo) and'
      '      (rp.estado = b.estado) and'
      '      (rp.cidade = b.cidade) and'
      '      (rp.bairro = b.codigo)')
    RequestLive = True
    Left = 368
    Top = 176
