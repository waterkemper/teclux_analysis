                         if Col = 3 then begin
                            BeginDoc('', False);
//                             WriteTextLn('^default',  0);
                               WriteTextLn('N',         0);
                               WriteTextLn('q816',      0);

                                    if qryProcuraModelosEtiquetasDescricao.AsString = 'ZEBRA 3 COLUNAS (25 x 34 mm)' then WriteTextLn('Q192,24+0', 0)
                               else if qryProcuraModelosEtiquetasDescricao.AsString = 'ZEBRA 3 COLUNAS (22 x 34 mm)' then WriteTextLn('Q176,24+0', 0);
                               WriteTextLn('S2',        0);
                               WriteTextLn('D' + FStr(ParSistema.IntensidadeImpressaoZebra,$00),0);
                               WriteTextLn('ZT',        0);

                               for NL:= 1 to NrLinhas do
                                   for NC:= 1 to 3 do
                                       WriteTextLn(Linhas[NL, NC],0);
                               WriteTextLn('P1', 0);
                           EndDoc('TecLUX - Imprimindo Etiqueta ZEBRA TLP 2844');
                           Col := 0;           FillChar(Linhas,SizeOf(Linhas),0);
                         end;
                     end;
                  end;
                  qryEtiquetas.Next;
               end;

               if Col <> 0 then begin
                  BeginDoc('', False);
//                   WriteTextLn('^default',  0);
                     WriteTextLn('N',         0);
                     WriteTextLn('q816',      0);

                          if qryProcuraModelosEtiquetasDescricao.AsString = 'ZEBRA 3 COLUNAS (25 x 34 mm)' then WriteTextLn('Q192,24+0', 0)
                     else if qryProcuraModelosEtiquetasDescricao.AsString = 'ZEBRA 3 COLUNAS (22 x 34 mm)' then WriteTextLn('Q176,24+0', 0);

                     WriteTextLn('S2',        0);
                     WriteTextLn('D' + FStr(ParSistema.IntensidadeImpressaoZebra,$00),0);
                     WriteTextLn('ZT',        0);

                     for NL:= 1 to NrLinhas do
                         for NC:= 1 to 3 do
                             WriteTextLn(Linhas[NL, NC],0);
                     WriteTextLn('P1', 0);
                  EndDoc('TecLUX - Imprimindo Etiqueta ZEBRA TLP 2844');
               end;

            finally
               qryEtiquetas.EnableControls;
            end;
         end;
      end;
   end;


end;


procedure TdtmEmissaoEtiquetas.AtualizarQuantidadeEtiquetas(Qtde: Integer);
begin

  if not qryEtiquetas.IsEmpty then
  begin
    qryEtiquetas.DisableControls;
    try
      qryEtiquetas.First;
      while not qryEtiquetas.Eof do begin
        qryEtiquetas.Edit;
        qryEtiquetasQuantidadeProduto.AsInteger:= Qtde;
        qryEtiquetas.Post;
        qryEtiquetas.Next;
      end;
    finally
      qryEtiquetas.EnableControls;
    end;
  end;

end;

procedure TdtmEmissaoEtiquetas.qryEtiquetasAfterInsert(DataSet: TDataSet);
begin
  inherited;
  qryEtiquetas.Cancel;
end;

function TdtmEmissaoEtiquetas.ExcluirProdutoEtiqueta: Boolean;
begin
  Result:= False;
  if not qryEtiquetas.isEmpty then begin
    if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o ITEM DO PRODUTO'])) = smbOk then begin
     qryEtiquetas.Delete;
     Result := True;
    end
  end
end;


function TdtmEmissaoEtiquetas.ExcluirNotasSaidas: Boolean;
begin
  Result:= False;
  if not qryNotasSaidas.isEmpty then begin
    if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['a NOTA DE SAIDA'])) = smbOk then begin
     qryNotasSaidas.Delete;
     Result := True;
    end
  end
end;


function TdtmEmissaoEtiquetas.GravarNotasSaidas: Boolean;
begin
  Result:= True;
//  if qryNotasSaidas.CheckRequiredFields then
 if qryNotasSaidas.State = dsEdit then
    qryNotasSaidas.Post;
end;

function TdtmEmissaoEtiquetas.GravarProdutoEtiqueta: Boolean;
begin
  Result:= True;
  if qryEtiquetas.CheckRequiredFields then
    qryEtiquetas.Post;
end;

function TdtmEmissaoEtiquetas.IncluirProdutoEtiqueta(Editando: Boolean): Boolean;
begin
  Result:= True;
  if (not qryEtiquetas.IsEmpty and Editando) then begin
    qryEtiquetas.DisableControls;
    qryEtiquetas.Edit;
    qryEtiquetas.Cancel;
    qryEtiquetas.EnableControls;
  end
  else begin
    qryEtiquetas.AfterInsert:= nil;
    qryEtiquetas.Append;
    qryEtiquetasfilial.AsInteger := FilialBase;
    qryEtiquetasMarcar.AsBoolean := True;
    qryEtiquetas.AfterInsert     := qryEtiquetasAfterInsert;
  end;
end;

function TdtmEmissaoEtiquetas.GetTabelaEtiqueta: TtecQuery;
begin
  Result:= qryEtiquetas;
end;

procedure TdtmEmissaoEtiquetas.qryProcuraFiliaisAfterOpen(DataSet: TDataSet);
begin
