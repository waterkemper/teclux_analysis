begin
  inherited;
  EtiquetasaImprimirAux := qryEtiquetasquantidadeproduto.asinteger;;
end;

procedure TdtmEmissaoEtiquetas.frpEtiquetasApolonia_ProdutosExposicaoFotos_BeforePrint(
  Sender: TfrxReportComponent);
begin
  inherited;

  if sender.name = 'imgProduto' then
  begin
    if qryFotosProdutos.recordcount <> 0 then
    begin
      DownloadImagem('http://'+ parsistema.SiteEmpresa+'/fotos/'+qryFotosProdutos.fieldByName('nomefoto').asString, vImage, true);
      tfrxpictureview(sender).Picture := vImage.picture;
    end
    else
      tfrxpictureview(sender).clear;
  end;
end;

procedure TdtmEmissaoEtiquetas.frpEtiquetasMariah_SAGetValue(
  const VarName: String; var Value: Variant);
begin
  inherited;
  if VarName = 'fDataFabricacao' then
    Value := formatdatetime('dd/mm/yy',strtodatetime(fDataFabricacao))
  else
  if VarName = 'fDataValidade' then
    Value := formatdatetime('dd/mm/yy',strtodatetime(fDataValidade))
  else
  if VarName = 'fMargemSuperior' then
    Value := fMargemSuperior;  
end;

procedure TdtmEmissaoEtiquetas.frpEtiquetasMariah_SABeforePrint(
  Sender: TfrxReportComponent);
begin
  inherited;
//  tfrxReportpage(frpEtiquetasMariah_SA.pages[1]).TopMargin := fMargemSuperior;
end;

end.

