procedure TdtmEmissaoEtiquetas.GerarEtiquetasProdutosExposicao;
var
  LWhere, LFrom, Linha22,  LCampoListaPadrao, LOrdenacao: String;

begin

  LOrdenacao := 'Order By p.codigo, e.filial';

  LWhere := ' ';    LFrom := ' ';
  if FParametroProduto <> '' then
    LWhere := LWhere + ' and (' + FParametroProduto + ') ';

  if FParametroCaracteristicas <> '' then
      LWhere:= LWhere + ' and (' + FParametroCaracteristicas + ') ';

  if FParametroGrupo <> '' then
    LWhere := LWhere + ' and (' + FParametroGrupo + ') ';

  if FParametroClasse <> '' then
    LWhere := LWhere + ' and (' + FParametroClasse + ') ';

  if FParametroMarca <> '' then
    LWhere := LWhere + ' and (' + FParametroMarca + ') ';

  LCampoListaPadrao := ', cast(null as integer) as ListaPadrao';

  if FParametroListasPadrao <> '' then
  begin
    LFrom := ', produtoslistaspadrao plp, listaspadrao lp ';
    LWhere := LWhere + ' and  p.codigo = plp.produto and plp.listapadrao = lp.codigo and (' + FParametroListasPadrao + ')';
    LCampoListaPadrao := ', lp.codigo as ListaPadrao';
    LOrdenacao := 'Order By lp.codigo, p.codigo, e.filial';
//    LWhere := LWhere + ' and ( p.codigo in (select plp.produto from produtoslistaspadrao plp join listaspadrao lp on plp.listapadrao = lp.codigo where true and ' + FParametroListasPadrao + ' )) ';
  end;

  LWhere := LWhere + ' and e.filial = ' + FParametroFilial + ' ';

  if FQtdeZerada then
  begin
//    Linha22 := ' and (movimentos_emestoque(p.Codigo, e.filial) >= 0) '
    Linha22 := ''
  end
  else
  begin
    if QtdemEstoqueProdutosExposicao then
      Linha22 := ' and (/*movimentos_emestoque(p.Codigo, e.filial)*/e.emestoque > 0) ';

    if (lotetransferencia <> '') and (lotetransferencia<>'0') then
      Linha22 := Linha22 + ' and p.codigo in (select pf.produto from pedidosfiliais pf where pf.produto = p.codigo and pf.lotetransferencia = coalesce(:lotetransferencia,0) and coalesce(pf.qtderecebida,0)>0) ';

//      Linha22 := ' and (select sum(pf.qtderecebida)  from pedidosfiliais pf where pf.produto = p.codigo and pf.lotetransferencia = coalesce(:lotetransferencia,0)) > 0 ';
  end;

  if (ParametroDataInicial<>'') and (ParametroDataFinal<>'') then
    LWhere  := LWhere + ' and (select cp.alteracao from colunasprecos cp where cp.caracteristica = c.codigo and cp.preco = p.preco  '+
						'      and cp.coluna = (CASE WHEN estoques_produtoempromocao(p.codigo,e.filial) THEN f.precopromocao ELSE f.preconormal END))' +
                        ' between ' + quotedstr(FormatDateTime('yyyy-mm-dd', strtodate(ParametroDataInicial))) + ' and ' +
                                      quotedstr(FormatDateTime('yyyy-mm-dd', strtodate(ParametroDataFinal)))
  else
  if (ParametroDataInicial<>'') and (ParametroDataFinal='') then
    LWhere  := LWhere + ' and (select cp.alteracao from colunasprecos cp where cp.caracteristica = c.codigo and cp.preco = p.preco  '+
						'      and cp.coluna = (CASE WHEN estoques_produtoempromocao(p.codigo,e.filial) THEN f.precopromocao ELSE f.preconormal END))' +
                        ' >= ' + quotedstr(FormatDateTime('yyyy-mm-dd', strtodate(ParametroDataInicial)))
  else
  if (ParametroDataInicial='') and (ParametroDataFinal<>'') then
    LWhere  := LWhere + ' and (select cp.alteracao from colunasprecos cp where cp.caracteristica = c.codigo and cp.preco = p.preco  '+
						'      and cp.coluna = (CASE WHEN estoques_produtoempromocao(p.codigo,e.filial) THEN f.precopromocao ELSE f.preconormal END))' +
                        ' <= ' + quotedstr(FormatDateTime('yyyy-mm-dd', strtodate(ParametroDatafinal)));

  if FProdutoEmLinha and not FprodutoForadeLinha then
    LWhere := LWhere + ' and not p.foralinhal and not c.foralinhal'
  else
  if FprodutoForadeLinha and not Fprodutoemlinha then
    LWhere := LWhere + ' and (p.foralinhal or c.foralinhal)';

  if FProdutoAtivo and not FprodutoInativo then
    LWhere := LWhere +' and p.inativo is null'
  else
  if FprodutoInativo and not FprodutoAtivo then
    LWhere := LWhere + ' and p.inativo is not null';

  if ProdutoemExposicao then
    LWhere := LWhere + ' and coalesce(g.EmExposicao,false)';

  qryEtiquetas.sql.Clear;
  qryEtiquetas.Params.Clear;
  qryetiquetas.Sql.Text := qryEtiquetasProdutosExposicao.Sql.Text;

  qryEtiquetas.macrobyname('LFrom').asString := LFrom;
  qryEtiquetas.macrobyname('Linha').asString := Linha22;
  qryEtiquetas.macrobyname('LWhere').asString := LWhere;
  qryEtiquetas.macrobyname('CampoListaPadrao').asString := LCampoListaPadrao;
  qryEtiquetas.macrobyname('LOrdenacao').asString := LOrdenacao;

  qryEtiquetas.Close;

  qryEtiquetas.parambyname('QuantidadeLote').asBoolean := QuantidadeLote;
  qryEtiquetas.parambyname('lotetransferencia').asString := lotetransferencia;
  qryEtiquetas.parambyname('QtdemEstoqueProdutosExposicao').asBoolean := QtdemEstoqueProdutosExposicao;
  qryEtiquetas.parambyname('QtdeZeradaProdutosExposicao').asBoolean := QtdeZerada;

  qryEtiquetas.open;
  CalculaPlanos;
end;

procedure TdtmEmissaoEtiquetas.frxDBDataset1Next(Sender: TObject);
begin
  inherited;
  if (NrEtiquetas < EtiquetasaImprimir) then
  begin
    NrEtiquetas:= NrEtiquetas + 1;
    if (not qryEtiquetas.Eof) then
    begin
       qryEtiquetas.BeforeScroll := nil;
       frxDBDataset1.Prior;
       qryEtiquetas.BeforeScroll := qryEtiquetasBeforeScroll;
    end;
  end
  else
    NrEtiquetas:= 1;

end;

