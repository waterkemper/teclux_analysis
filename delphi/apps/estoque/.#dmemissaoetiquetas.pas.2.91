end;

procedure TdtmEmissaoEtiquetas.qryProcuraProdutosCadastroAfterOpen(DataSet: TDataSet);
begin
  inherited;
  if (qryEtiquetas.State in [dsEdit, dsInsert]) then
  begin
    qryEtiquetasdescricaoproduto.AsString := copy(qryProcuraProdutosCadastrodescricao.AsString,1,50);
    qryEtiquetaslinha.AsString := qryProcuraProdutosCadastrolinha.AsString;
    qryEtiquetasColuna.AsString := qryProcuraProdutosCadastroColuna.AsString;
    qryEtiquetasvalorgrade1.AsString := qryProcuraProdutosCadastrovalorgrade1.AsString;
    qryEtiquetasvalorgrade2.AsString := qryProcuraProdutosCadastrovalorgrade2.AsString;
    qryEtiquetasReferencia.AsString       := qryProcuraProdutosCadastroreferencia.AsString;
    qryEtiquetasresultadocurvaabc.AsString := qryProcuraProdutosCadastroresultadocurvaabc.AsString;
    qryEtiquetasdescricaomarca.AsString   := qryProcuraProdutosCadastrodescricaomarca.AsString;
    qryEtiquetasultimaentrada.AsDateTime  :=
    qryProcuraProdutosCadastroultimaentrada.AsDateTime;
    qryEtiquetasFatorPreco.AsString       := qryProcuraProdutosCadastrofatorpreco.AsString;
    qryEtiquetasprecoreal.AsCurrency      := qryProcuraProdutosCadastroprecoreal.AsCurrency;
    qryEtiquetaspreco.AsCurrency          := qryProcuraProdutosCadastropreco.AsCurrency;
  end;
end;

