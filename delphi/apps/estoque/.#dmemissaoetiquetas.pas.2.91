end;

procedure TdtmEmissaoEtiquetas.qryEtiquetasAfterScroll(DataSet: TDataSet);
begin
  inherited;
  if Assigned(FOnScrollLinhaColunaGrade) then
    FOnScrollLinhaColunaGrade(DataSet);

  if ImprimirFoto then
    if qryEtiquetas.state = dsBrowse then
    begin
      if qryEtiquetascodigo.asString<>'' then
        RefazConsultaPorNome(qryFotosProdutos, ['produto'], [qryEtiquetascodigo.asString])
