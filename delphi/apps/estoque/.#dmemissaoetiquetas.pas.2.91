  if Tipo = 'P' Then With TextPrinter do Begin     //----- PETIPE------
     Try
         qryEtiquetas.First;
         BeginDoc('', False);
         While not qryEtiquetas.Eof do
         Begin
           If qryEtiquetasMarcar.AsBoolean Then Begin
             NE:= 1;
             While NE <= qryEtiquetasQuantidadeProduto.AsInteger do
             Begin
               If qryEtiquetasTotal.AsCurrency = 0
               Then PrecoPrazo:= qryEtiquetasPreco.AsCurrency
               Else PrecoPrazo:= qryEtiquetasTotal.AsCurrency;

               Case Tamanho Of
                     0: If Esquerdo Then Begin //----------- ETIQUETA 1 GRANDE (PETIPE) -----------
                           WriteTextLn(#13,0);
                           WriteTextLn('N'          + #13,0);
                           WriteTextLn('q800'       + #13,0);
                           WriteTextLn('Q584,24+0'  + #13,0);
                           WriteTextLn('S2'         + #13,0);
                           WriteTextLn('D' + FStr(ParSistema.IntensidadeImpressaoZebra,$00),0);
                           WriteTextLn('ZB'         + #13,0);
                           WriteTextLn('TTh:m'      + #13,0);
                           WriteTextLn('TDy2:mn.dd' + #13,0);
                           WriteTextLn('O'          + #13,0);
                           WriteTextLn('A25,240,0,2,1,1,N,"Em caso de troca, favor"'       + #13,0);
                           WriteTextLn('A25,260,0,2,1,1,N,"conservar esta etiqueta fixada."'      + #13,0);
                           WriteTextLn('A25,280,0,2,1,1,N,"Prazo maximo de 30 dias."'      + #13,0);
                           WriteTextLn('A100,310,0,2,1,2,N,"'    + qryEtiquetasCodigoVisual.AsString +'"'                              + #13,0);
                           WriteTextLn('B80,350,0,1,3,4,70,N,"' + qryEtiquetasCodigoVisual.AsString +'"'                              + #13,0);
                           WriteTextLn('A100,430,0,2,1,1,N,"'    + qryEtiquetasCodigoVisual.AsString +'"'                              + #13,0);
                           WriteTextLn('A25,460,0,2,1,1,N,"' +Trocar(qryEtiquetasDescricaoProduto.AsString+' '+qryEtiquetasvalorgrade1.asstring+' '+qryEtiquetasvalorgrade2.asstring,'"','''') + '"' + #13,0);
                           WriteTextLn('A120,490,0,3,1,1,N,"'+preencheString(qryEtiquetasQtdeParcelas.AsString+'x de R$'+Format('%07.2f',[qryEtiquetasValorParcela.AsCurrency]),' ',19,false)+'"'+#13,0);
                           WriteTextLn('A120,520,0,3,1,1,N," Total de R$'+Format('%07.2f',[qryEtiquetasTotalParcelas.AsCurrency]) +'"'     + #13,0);
                           WriteTextLn('A120,550,0,3,1,1,N,"'+preencheString('AV. R$'+Format('%07.2f',[(1-(FPercentualAVista/100)) * qryEtiquetasPRECO.AsCurrency]),' ',19,false) +'"'  + #13,0);
                        End
                        Else Begin
                           WriteTextLn('A425,240,0,2,1,1,N,"Em caso de troca, favor"'       + #13,0);
                           WriteTextLn('A425,260,0,2,1,1,N,"conservar esta etiqueta fixada."'      + #13,0);
                           WriteTextLn('A425,280,0,2,1,1,N,"Prazo maximo de 30 dias."'      + #13,0);
                           WriteTextLn('A500,310,0,2,1,2,N,"'    + qryEtiquetasCodigoVisual.AsString +'"'                              + #13,0);
                           WriteTextLn('B480,350,0,1,3,4,70,N,"' + qryEtiquetasCodigoVisual.AsString +'"'                              + #13,0);
                           WriteTextLn('A500,430,0,2,1,1,N,"'    + qryEtiquetasCodigoVisual.AsString +'"'                              + #13,0);
                           WriteTextLn('A425,460,0,2,1,1,N,"'+Trocar(qryEtiquetasDescricaoProduto.AsString+' '+qryEtiquetasvalorgrade1.asstring+' '+qryEtiquetasvalorgrade2.asstring,'"','''') + '"' + #13,0);
                           WriteTextLn('A520,490,0,3,1,1,N,"'+preencheString(qryEtiquetasQtdeParcelas.AsString+'x de R$'+Format('%07.2f',[qryEtiquetasValorParcela.AsCurrency]),' ',19,false)+'"'+#13,0);
                           WriteTextLn('A520,520,0,3,1,1,N," Total de R$'+Format('%07.2f',[qryEtiquetasTotalParcelas.AsCurrency]) +'"'     + #13,0);
                           WriteTextLn('A520,550,0,3,1,1,N,"'+preencheString('AV. R$'+Format('%07.2f',[(1-(FPercentualAVista/100)) * qryEtiquetasPRECO.AsCurrency]),' ',19,false) +'"'  + #13,0);
                        End;
                     1: If Esquerdo Then Begin  //----------- ETIQUETA 2 ColunaS PEQUENA (PETIPE) ---------------
                           WriteTextLn(#13,0);
                           WriteTextLn('N'         + #13,0);
                           WriteTextLn('q800'      + #13,0);
                           WriteTextLn('Q400,16+0' + #13,0);
                           WriteTextLn('S2'        + #13,0);
                           WriteTextLn('D' + FStr(ParSistema.IntensidadeImpressaoZebra,$00),0);
                           WriteTextLn('ZB'        + #13,0);
                           WriteTextLn('TTh:m'     + #13,0);
                           WriteTextLn('TDy2.mn.dd'+ #13,0);
                           WriteTextLn('O'         + #13,0);
                           WriteTextLn('A15,40,0,2,1,1,N,"Em caso de troca, favor"' + #13,0);
                           WriteTextLn('A15,60,0,2,1,1,N,"conservar esta etiqueta fixada."' + #13,0);
                           WriteTextLn('A15,80,0,2,1,1,N,"Prazo maximo de 30 dias."' + #13,0);
                           WriteTextLn('A15,120,0,2,1,1,N,"'      + Trocar(qryEtiquetasDescricaoProduto.AsString+' '+qryEtiquetasvalorgrade1.asstring+' '+qryEtiquetasvalorgrade2.asstring,'"','''') + '"' + #13,0);
                           WriteTextLn('A60,170,0,3,2,2,N,"'   + qryEtiquetasCodigoVisual.AsString + '"' + #13,0);
                           WriteTextLn('B90,210,0,1,2,2,40,N,"' + qryEtiquetasCodigoVisual.AsString + '"' + #13,0);
                           WriteTextLn('A120,280,0,3,1,1,N,"'+preencheString(qryEtiquetasQtdeParcelas.AsString+'x de R$'+Format('%07.2f',[qryEtiquetasValorParcela.AsCurrency]),' ',19,false)+'"'+#13,0);
                           WriteTextLn('A120,310,0,3,1,1,N," Total de R$'+Format('%07.2f',[qryEtiquetasTotalParcelas.AsCurrency]) +'"'     + #13,0);
                           WriteTextLn('A120,340,0,3,1,1,N,"'+preencheString('AV. R$'+Format('%07.2f',[(1-(FPercentualAVista/100)) * qryEtiquetasPRECO.AsCurrency]),' ',19,false) +'"'  + #13,0);
                        End
                        Else Begin
                           WriteTextLn('A425,40,0,2,1,1,N,"Em caso de troca, favor"' + #13,0);
                           WriteTextLn('A425,60,0,2,1,1,N,"conservar esta etiqueta fixada."' + #13,0);
                           WriteTextLn('A425,80,0,2,1,1,N,"Prazo maximo de 30 dias."' + #13,0);
                           WriteTextLn('A425,120,0,2,1,1,N,"'      + Trocar(qryEtiquetasDescricaoProduto.AsString+' '+qryEtiquetasvalorgrade1.asstring+' '+qryEtiquetasvalorgrade2.asstring,'"','''') + '"' + #13,0);
                           WriteTextLn('A460,170,0,3,2,2,N,"'   + qryEtiquetasCodigoVisual.AsString + '"' + #13,0);
                           WriteTextLn('B500,210,0,1,2,2,40,N,"' + qryEtiquetasCodigoVisual.AsString + '"' + #13,0);
                           WriteTextLn('A530,280,0,3,1,1,N,"'+preencheString(qryEtiquetasQtdeParcelas.AsString+'x de R$'+Format('%07.2f',[qryEtiquetasValorParcela.AsCurrency]),' ',19,false)+'"'+#13,0);
                           WriteTextLn('A530,310,0,3,1,1,N," Total de R$'+Format('%07.2f',[qryEtiquetasTotalParcelas.AsCurrency]) +'"'     + #13,0);
                           WriteTextLn('A530,340,0,3,1,1,N,"'+preencheString('AV. R$'+Format('%07.2f',[(1-(FPercentualAVista/100)) * qryEtiquetasPRECO.AsCurrency]),' ',19,false) +'"'  + #13,0);
                        End;
                     End;
                     If not Esquerdo
                     Then WriteTextLn('P1' + #13,0);
                     Inc(NE);
                     Esquerdo:= not Esquerdo;
                  End;
               End;
               qryEtiquetas.Next;
         End;
         If not Esquerdo
         Then WriteTextLn('P1' + #13,0);
         EndDoc('TecLUX - Imprimindo Etiqueta ZEBRA TLP 2844');
      finally
        qryEtiquetas.EnableControls;
      end;
  end;




   if qryProcuraModelosEtiquetasTipo.AsString = 'FH' then with TextPrinter do begin     //---- FRETTA HOME CENTER----
      case qryProcuraModelosEtiquetasColuna.AsInteger of

      1: case qryProcuraModelosEtiquetasModelo.AsString[1] of
         'V': begin         // PREÇO 60 x 100 mm - [V]ERTICAL
                 try
                     CalculaPlanos;
                     Col := 0;    FillChar(Linhas,SizeOf(Linhas),0);
                     qryEtiquetas.First;
                     while not qryEtiquetas.EOF do begin
                        if qryEtiquetasMarcar.AsBoolean then begin

                           for NP:= 1 to qryEtiquetasQuantidadeProduto.AsInteger do begin
                               Inc(Col);
                               case Col of
                                  1: X:= 8;
                               end;

                               Linhas[1, Col]:= 'A' + FStr(X,$00) +  ',208,0,3,1,2,N,"' + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.  AsString,'"',''''), 1,32) + '"';
                               Linhas[2, Col]:= 'A' + FStr(X,$00) +  ',248,0,3,1,2,N,"' + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.  AsString,'"',''''),33,32) + '"';
                               Linhas[3, Col]:= 'A' + FStr(X,$00) +  ',288,0,2,1,1,N,"' + 'REF: ' + Copy(qryEtiquetasReferencia.AsString, 1,15) + '"';

                               if FImprimirPreco
                               then if qryProcuraPlanosCodigo.AsInteger <> 0 then begin
                                       Linhas[4, Col]:= 'A' + FStr(X+56,$00) + ',352,0,4,1,2,N,"';
                                       if qryProcuraPlanosPrazoVenctoEntrada.AsInteger = 0
                                       then Linhas[4, Col]:= Linhas[4, Col] + '1 + ';
                                       Linhas[4, Col]:= Linhas[4, Col] + FStr(qryEtiquetasQtdeParcelas.AsInteger,$00) + ' DE"';
                                       Linhas[5, Col]:= 'A' + FStr(X,$00) + ',448,0,5,1,2,N,"' + PreencheString('R$ ' + Trim(Format('%09.2n',[qryEtiquetasValorParcela.AsCurrency])),' ',12,False) + '"';

                                       Linhas[6, Col]:= 'A' + FStr(X,    $00) + ',600,0,3,1,1,N,"OU"';
                                       Linhas[7, Col]:= 'A' + FStr(X,    $00) + ',632,0,3,1,1,N,"A VISTA R$ ' + Trim(Format('%09.2n',[(1 - PercentualAVista/100) * qryEtiquetasPreco.AsCurrency])) + '"';
                                       Linhas[8, Col]:= 'A' + FStr(X+232,$00) + ',680,0,3,1,1,N,"TAXA: ' + Trim(Format('%05.2n', [qryProcuraPlanosTaxaMensalJuros.AsFloat])) + '% a.m."';
                                       Linhas[9, Col]:= 'A' + FStr(X+232,$00) + ',712,0,3,1,1,N,"TOTAL A PRAZO:"';

                                       if qryProcuraPlanosTaxaMensalJuros.AsFloat = 0
                                       then PrecoPrazo:= (1 - PercentualAVista/100) * qryEtiquetasPreco.AsCurrency
                                       else PrecoPrazo:= qryEtiquetasTotalParcelas.AsCurrency;
                                       Linhas[10,Col]:= 'A' + FStr(X+256,$00) + ',748,0,4,1,1,N,"' + PreencheString('R$ ' + Trim(Format('%09.2n',[PrecoPrazo])),' ',12,False) + '"';
                                    end
                                    else Linhas[5, Col]:= 'A' + FStr(X,$00) + ',448,0,5,1,2,N,"' + PreencheString('R$ ' + Trim(Format('%09.2n',[(1 - PercentualAVista/100) * qryEtiquetasPreco.AsCurrency])),' ',12,False) + '"';

                               Linhas[11, Col]:= 'B' + FStr(X,$00) +  ',680,0,1,2,2,80,B,"' + qryEtiquetasCodigoVisual.AsString + '"';

                               if Col = 1 then begin
                                  BeginDoc('', False);
                                     WriteTextLn('N',         0);
                                     WriteTextLn('q480',      0);
                                     WriteTextLn('Q800,24+0', 0);
                                     WriteTextLn('S2',        0);
                                     WriteTextLn('D' + FStr(ParSistema.IntensidadeImpressaoZebra,$00), 0);
                                     WriteTextLn('ZT',        0);
                                     WriteTextLn('O',         0);
{
A24,208,0,3,1,2,N,"BARBEADOR BD3150BR R3xxxxxxxxxxxxxxxx"
A24,248,0,3,1,2,N,"ELETRIC BLACK & DECKExxxxxxxxxxxxxxxx"
