             //COLOCAR AQUI LOGOTIPO DA GAMA
              //WriteTextLn('GW25,035,35,88,'+Copy(Buffer,1,Length(Buffer)),0);
              //WriteTextLn('A400,035,0,4,1,1,N,"WWW.GAMA-SC.COM.BR"'+#13,0);
              WriteTextLn('A055,140,0,4,1,1,N,"'     + qryEtiquetasReferencia.AsString+ '"' + #13,0);
              WriteTextLn('A525,140,0,4,1,1,N,"'     + preencheString(qryEtiquetaslocalizacao.AsString,' ',10,False) + '"' + #13,0);
              WriteTextLn('A055,180,0,5,1,1,N,"'     + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),01,19) + '"' + #13,0);
              WriteTextLn('A055,250,0,5,1,1,N,"'     + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),20,19) + '"' + #13,0);
              if NumeroAba <> 3 then
                WriteTextLn('B055,330,0,1,3,2,40,N,"'  + qryEtiquetasCodigoVisual.AsString + '"',0)
              else
                WriteTextLn('B055,330,0,1,3,2,40,N,"'  + qryEtiquetasprodutocliente.AsString + '"',0);
              //WriteTextLn('GW600,310,14,88,'         + Copy(Buffer1,1,Length(Buffer1)),0);
              WriteTextLn('P1',0);
              Inc(NE);
            End;
          End;
          qryEtiquetas.Next;
        End;
        EndDoc('TecLUX - Imprimindo Etiqueta ZEBRA TLP 2844');
