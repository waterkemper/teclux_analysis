                                             WriteTextLn(Linhas[NL, NC],0);
                                     WriteTextLn('P1', 0);
                                  EndDoc('TecLUX - Imprimindo Etiqueta ZEBRA TLP 2844');
                                  Col := 0;           FillChar(Linhas,SizeOf(Linhas),0);
                               end;
                           end;
                        end;
                        qryEtiquetas.Next;
                     end;

                     if Col <> 0 then begin
                        BeginDoc('', False);
                           WriteTextLn('N',         0);
                           WriteTextLn('q480',      0);
                           WriteTextLn('Q800,24+0', 0);
                           WriteTextLn('S2',        0);
                           WriteTextLn('D' + FStr(ParSistema.IntensidadeImpressaoZebra,$00),0);
                           WriteTextLn('ZT',        0);
                           WriteTextLn('O',         0);

                           for NL:= 1 to 11 do
                               for NC:= 1 to 1 do
                                   WriteTextLn(Linhas[NL, NC],0);
                           WriteTextLn('P1', 0);
                        EndDoc('TecLUX - Imprimindo Etiqueta ZEBRA TLP 2844');
                     end;

                 finally
                    qryEtiquetas.EnableControls;
                 end;
              end;

         'H': begin // PREÇO 100 x 60 mm - [H]ORIZONTAL
                 try

                     CalculaPlanos;
                     Col := 0;    FillChar(Linhas,SizeOf(Linhas),0);
                     qryEtiquetas.First;
                     while not qryEtiquetas.EOF do begin
                        if qryEtiquetasMarcar.AsBoolean then begin

                           for NP:= 1 to qryEtiquetasQuantidadeProduto.AsInteger do begin
                               Inc(Col);
                               case Col of
                                  1: Y:= 12;
                               end;
