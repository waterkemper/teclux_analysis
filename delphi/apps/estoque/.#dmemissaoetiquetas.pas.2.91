function TdtmEmissaoEtiquetas.ExisteCliente(campo, Codigo: String): Boolean;
const
SQL = ' and (to_ascii(V.%s,''latin1'') ilike to_ascii(''%s%s'',''latin1''))';
begin
  qryConsultaClientes.Close;
  qryConsultaClientes.MacroByName('branco').AsString := Format(SQL, [Campo, Codigo, '%']);
  qryConsultaClientes.Open;
  Result := (qryConsultaClientes.RecordCount > 0);
end;

