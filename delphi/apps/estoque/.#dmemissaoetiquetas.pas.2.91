            try
               Col := 0;    FillChar(Linhas,SizeOf(Linhas),0);
               qryEtiquetas.First;
               while not qryEtiquetas.EOF do begin
                  if qryEtiquetasMarcar.AsBoolean then begin

                     for NP:= 1 to qryEtiquetasQuantidadeProduto.AsInteger do begin
                         Inc(Col);
