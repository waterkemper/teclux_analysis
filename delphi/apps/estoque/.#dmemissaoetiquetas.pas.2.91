procedure TdtmEmissaoEtiquetas.qryEtiquetasCalcFields(DataSet: TDataSet);
begin
  inherited;
  qryEtiquetasDescricaoProdutoLC.AsString :=  qryEtiquetasdescricaoproduto.AsString;
  {
  +' '+
     qryEtiquetasvalorgrade1.AsString+' '+
     qryEtiquetasvalorgrade2.AsString; }

  if qryProcuraPlanosPrazoVenctoEntrada.AsInteger = 0
  then qryEtiquetasTotalParcelas.AsCurrency:= (qryEtiquetasQtdeParcelas.AsCurrency + 1) * qryEtiquetasValorParcela.AsCurrency
  else qryEtiquetasTotalParcelas.AsCurrency:=  qryEtiquetasQtdeParcelas.AsCurrency      * qryEtiquetasValorParcela.AsCurrency;

end;


procedure TdtmEmissaoEtiquetas.qryProcuraProdutosCadastroCalcFields(
  DataSet: TDataSet);
begin
  inherited;
    qryProcuraProdutosCadastrodescricaolc.AsString :=
    trim(
    qryProcuraProdutosCadastrodescricao.AsString+' '+
    qryProcuraProdutosCadastrovalorgrade1.AsString+' '+
    qryProcuraProdutosCadastrovalorgrade2.AsString);
end;


function TdtmEmissaoEtiquetas.ValidarData: TDateTime;
var
  DiaBase: Integer;
  Dia, Mes, Ano: Word;
  NewData : TDateTime;
begin
  qryEtiquetas.DisableControls;
  DiaBase:= 0;
  DecodeDate(DataServidor,Ano,Mes,Dia);
  if qryPlanosPagamentoaposdia.AsInteger > 0 then
    DiaBase:= qryPlanosPagamentoaposdia.AsInteger
  else if qryPlanosPagamentodiabase.AsInteger > 0 then
    DiaBase:= qryPlanosPagamentodiabase.AsInteger;

  if Dia <= DiaBase then
    NewData:= EncodeDate(Ano,Mes,DiaBase)
  else begin
    Mes:= Mes + 1;
    if Mes > 12 then begin
      Mes:= Mes - 1;
      Ano:= Ano + 1;
    end;
    NewData:= EncodeDate(Ano,Mes,DiaBase);
  end;
  Result:= NewData;
end;


function TdtmEmissaoEtiquetas.DiaFixo: Boolean;
begin
  Result:= ((qryPlanosPagamentoDIABASE.AsInteger <> 0) or (qryPlanosPagamentoAPOSDIA.AsInteger <> 0));
end;


//----- CALCULAR PLANOS COM ENTRADA -----------------------------------------------------------

procedure TdtmEmissaoEtiquetas.CalcularPlanosComEntrada;
var
  DataAux   : TDateTime;
  Desc      : Real;
  Financiado: Currency;
begin
  qryEtiquetas.DisableControls;
  try
    ReFazConsulta(qryPlanosPagamento,[0],[qryProcuraPlanosCodigo.AsInteger]);
    qryEtiquetas.First;

    while not qryEtiquetas.Eof do begin
      Financiado   := qryEtiquetasPRECO.AsCurrency;
      FDataCalculo := DateToStr(DataServidor);

      qryProcuraPlanos.Edit;

      if DiaFixo then
        DataAux:= ValidarData
      else begin
        if qryProcuraPlanosDiaVenctoEntrada.AsDateTime = 0 then begin
          if (qryProcuraPlanosPrazoVenctoEntrada.AsInteger = 30)  and qryProcuraPlanosMESTRINTADIAS.AsBoolean then
               DataAux:= SomarDia(StrToDate(FDataCalculo),30,'S')
          else DataAux:= SomarDia(StrToDate(FDataCalculo),qryProcuraPlanosPrazoVenctoEntrada.AsInteger,'N');
        end
        else   DataAux:= qryProcuraPlanosDiaVenctoEntrada.AsDateTime;
      end;

      qryProcuraPlanosVencimento.AsDateTime:= DataAux;
      qryProcuraPlanos.Post;

      FTaxaAcumulada:= tecFinanceira.TaxaAcumulada(qryProcuraPlanosVencimento.AsDateTime,
                                                   StrToDate(FDataCalculo),
                                                   qryProcuraPlanosQuantidadeParcelas.AsInteger,
                                                   qryProcuraPlanosINTERVALOPARCELAS.AsInteger,
                                                   qryProcuraPlanosTaxaMensalJuros.AsFloat);
      qryProcuraPlanos.Edit;

      if FTaxaAcumulada = 0 then
        qryProcuraPlanosValorParcela.AsCurrency := 0
      else
        qryProcuraPlanosValorParcela.AsCurrency:= RoundTo((Financiado / FTaxaAcumulada),-2);

      qryProcuraPlanos.Post;

      repeat
        Desc:= Financiado - tecFinanceira.ValorPresente(StrToDate(FDataCalculo),
                                                             qryProcuraPlanosQuantidadeParcelas.AsInteger,
                                                             qryProcuraPlanosVencimento.AsDateTime,


                                                             qryProcuraPlanosValorParcela.AsCurrency,
                                                             qryProcuraPlanosINTERVALOPARCELAS.AsInteger,
                                                             qryProcuraPlanosTaxaMensalJuros.AsFloat);
        if ((Abs(Desc)*100) > qryProcuraPlanosQuantidadeParcelas.AsInteger) then begin
          qryProcuraPlanos.Edit;
          qryProcuraPlanosValorParcela.AsCurrency:= RoundTo(qryProcuraPlanosValorParcela.AsCurrency +
                                                              (Desc / qryProcuraPlanosQuantidadeParcelas.AsInteger),-2);
          qryProcuraPlanos.Post;
        end;
      until ((Abs(Desc)*100) <= qryProcuraPlanosQuantidadeParcelas.AsInteger);

      if (qryProcuraPlanosTaxaMensalJuros.AsFloat > 0) then
        tecFinanceira.ArredondaValores(qryProcuraPlanos,
                                       qryProcuraPlanosQuantidadeParcelas,
                                       qryProcuraPlanosValorParcela,
                                       qryProcuraPlanosMULTIPLO.AsFloat,
                                       False);

      qryEtiquetas.Edit;
      qryEtiquetasEntrada.AsInteger       := 1;
      qryEtiquetasValorParcela.AsCurrency := qryProcuraPlanosValorParcela.AsCurrency;
      qryEtiquetasTotalParcelas.AsCurrency:= qryEtiquetasQtdeParcelas.AsInteger * qryEtiquetasValorParcela.AsCurrency;
      qryEtiquetasQtdeParcelas.AsInteger  := qryProcuraPlanosQuantidadeParcelas.AsInteger - 1;
      qryEtiquetas.Post;

      qryEtiquetas.Next;
    end;
  finally
    qryProcuraPlanos.First;
    qryEtiquetas.EnableControls;
  end;
end;


//----- CALCULAR PLANOS SEM ENTRADA -----------------------------------------------------------

procedure TdtmEmissaoEtiquetas.CalcularPlanosSemEntrada;
var
  DataAux : TDateTime;
  Desc: Real;
  Financiado: Currency;
begin
  qryEtiquetas.DisableControls;

  try
    ReFazConsulta(qryPlanosPagamento,[0],[qryProcuraPlanosCodigo.AsInteger]);
    qryEtiquetas.First;

    while not qryEtiquetas.Eof do begin

      Financiado   := qryEtiquetasPRECO.AsCurrency;
      FDataCalculo := DateToStr(DataServidor);

      qryProcuraPlanos.Edit;
      if DiaFixo then
        DataAux:= ValidarData
      else begin
        if qryProcuraPlanosDiaVenctoEntrada.AsDateTime = 0 then begin
          if (qryProcuraPlanosPrazoVenctoEntrada.AsInteger = 30) and qryProcuraPlanosMESTRINTADIAS.AsBoolean then
               DataAux:= SomarDia(StrToDate(FDataCalculo),30,'S')
          else DataAux:= SomarDia(StrToDate(FDataCalculo),qryProcuraPlanosPrazoVenctoEntrada.AsInteger,'N');
        end
        else   DataAux:= qryProcuraPlanosDiaVenctoEntrada.AsDateTime;
      end;
      
      qryProcuraPlanosVencimento.AsDateTime:= DataAux;
      qryProcuraPlanos.Post;

      FTaxaAcumulada:= tecFinanceira.TaxaAcumulada(qryProcuraPlanosVencimento.AsDateTime,
                                                   StrToDate(FDataCalculo),
                                                   qryProcuraPlanosQuantidadeParcelas.AsInteger,
                                                   qryProcuraPlanosINTERVALOPARCELAS.AsInteger,
                                                   qryProcuraPlanosTaxaMensalJuros.AsFloat);
      qryProcuraPlanos.Edit;
      qryProcuraPlanosValorParcela.AsCurrency:= RoundTo((Financiado / FTaxaAcumulada),-2);
      qryProcuraPlanos.Post;

      repeat
        Desc:= Financiado - tecFinanceira.ValorPresente(StrToDate(FDataCalculo),
                                                        qryProcuraPlanosQuantidadeParcelas.AsInteger,
                                                        qryProcuraPlanosVencimento.AsDateTime,
                                                        qryProcuraPlanosValorParcela.AsCurrency,
                                                        qryProcuraPlanosINTERVALOPARCELAS.AsInteger,
                                                        qryProcuraPlanosTaxaMensalJuros.AsFloat);

        if ((Abs(Desc)*100) > qryProcuraPlanosQuantidadeParcelas.AsInteger) then begin

          qryProcuraPlanos.Edit;
          qryProcuraPlanosValorParcela.AsCurrency:= RoundTo(qryProcuraPlanosValorParcela.AsCurrency +
                                                    (Desc / qryProcuraPlanosQuantidadeParcelas.AsInteger),-2);
          qryProcuraPlanos.Post;
        end;
      until ((Abs(Desc)*100) <= qryProcuraPlanosQuantidadeParcelas.AsInteger);

      if (qryProcuraPlanosTaxaMensalJuros.AsFloat > 0) then
         tecFinanceira.ArredondaValores(qryProcuraPlanos,
                                        qryProcuraPlanosQuantidadeParcelas,
                                        qryProcuraPlanosValorParcela,
                                        qryProcuraPlanosMULTIPLO.AsFloat,
                                        False);

      qryEtiquetas.Edit;
      qryEtiquetasQtdeParcelas.AsInteger  := qryProcuraPlanosQuantidadeParcelas.AsInteger;
      qryEtiquetasValorParcela.AsCurrency :=  qryProcuraPlanosValorParcela.AsCurrency;
      qryEtiquetasEntrada.AsInteger       := 0;
      qryEtiquetasTotalParcelas.AsCurrency:= qryEtiquetasQtdeParcelas.AsInteger * qryEtiquetasValorParcela.AsCurrency;
      qryEtiquetas.Post;

      qryEtiquetas.Next;
    end;
  finally
    qryProcuraPlanos.First;
    qryEtiquetas.EnableControls;
  end;
end;




//------------------ Etiquetas Petipé -------------------------------------------------------
procedure TdtmEmissaoEtiquetas.Etiquetas_Modelo_F;
const
  MaxCampo = 5;

type
  T_Etiquetas = Array of Record
    Expandido   : String[30];
    Parcelas    : String[30];
    ValorParcela: String[30];
    Descricao   : String[30];
    Produto     : String[14];
    Referencia  : String[14];
    Total       : String[18];
    DataValidade: String[10];
    Avista      : String[30];
  end;

var
  QtdeEtq, Cont, NC, Colunas : Integer;
  ETiquetas: T_Etiquetas;
  TamValor: Byte;
  Txt: String;
  Tamanho: Integer;
  TamParcela: Byte;
  Txt1: String;

  procedure Imprimir;
  Var
    ETQ, NrC: Integer;

  begin
    with TextPrinter do begin
      NrC:= 1; TamValor := 0;  TamParcela := 0;

      while (NrC <= MaxCampo) do begin
        case NrC of
          1: begin
               for ETQ:= 1 to Colunas do begin
                  TamValor  := Length(ETiquetas[ETQ-1].ValorParcela);
                  TamParcela:= Length(Etiquetas[ETQ-1].Parcelas);

                  if ETiquetas[ETQ-1].Produto <> '' then begin
                      Tamanho:= 30 - (2 * TamValor) - TamParcela + 2;
                      Txt:= FloaTtoStr(tamanho);
                      txt1 := FloatToStr(TamValor);

                      FTexto:= FTexto + '<sp>(' + txt + 'L)</sp>' + Etiquetas[ETQ-1].Parcelas +
                                         #$1B + 'W1' + Etiquetas[ETQ-1].ValorParcela + #$1B + 'W0' +
                                         '<sp>(04L)</sp>';
                  end;
               end;
               FTexto:= FTexto + '<sbl>';
               Inc(NrC);
             end;

          2: begin
               for ETQ:= 1 to Colunas do begin
                 if ETiquetas[ETQ-1].Produto <> '' then
                   FTexto:= FTexto + '<sp>(2L)</sp><e>' + ETiquetas[ETQ-1].Descricao + '(30L)</e><sp>(04L)</sp>';
               end;
               FTexto:= FTexto + '<sbl>';
               Inc(NrC);
             end;

          3: begin
               for ETQ:= 1 to Colunas do begin
                 if ETiquetas[ETQ-1].Produto <> '' then
                   FTexto:= FTexto + '<sp>(02L)</sp><e>' + ETiquetas[ETQ-1].Produto + '  ' +
                                                           ETiquetas[ETQ-1].Referencia + '(30L)</e><sp>(04L)</sp>';
               end;
               FTexto:= FTexto + '<sbl>';
               Inc(NrC);
             end;

         4: begin
               for ETQ:= 1 to Colunas do begin
                 if ETiquetas[ETQ-1].Produto <> '' then
                    FTexto:= FTexto + '<sp>(02L)</sp><e>' + ETiquetas[ETQ-1].Total + ' ' +
                             'VAL.: ' + ETiquetas[ETQ-1].DataValidade + '(30L)</e><sp>(04L)</sp>';

               end;
               FTexto:= FTexto + '<sbl>';
               Inc(NrC);
             end;

         5: begin
               for ETQ:= 1 to Colunas do begin
                 if ETiquetas[ETQ-1].Produto <> '' then
                    FTexto:= FTexto + '<sp>(02L)</sp><e>' + 'A VISTA: ' + ETiquetas[ETQ-1].AVista + '(30R)</e><sp>(04L)</sp>';
               end;
               FTexto:= FTexto + '<sbl><sbl><sbl><sbl>';
               Inc(NrC);
            end;
        end;
      end;

      FillChar(Etiquetas,SizeOf(Etiquetas),0);
      SetLength(Etiquetas,Colunas);
      qryProcuraPlanosCodigo.Clear;
      qryProcuraPlanosDESCRICAO.Clear;
      NC:= 1;
    end;
  end;

begin
  Colunas := qryProcuraModelosEtiquetasColuna.AsInteger;
  Cont:= 1; NC:= 1; QtdeEtq := 0;
  SetLength(Etiquetas,Colunas);
  qryEtiquetas.First;
  while not qryEtiquetas.Eof do begin
    if qryEtiquetasMarcar.AsBoolean then begin
      while (Cont <= qryEtiquetasQuantidadeProduto.AsInteger) do begin
        if (NC > Colunas) then  begin
          Imprimir;
          Inc(QtdeEtq);
        end
        else begin
          with TextPrinter do begin
            if QtdeEtq = 11 Then begin
               FTexto := FTexto + '<sbl>';
               QtdeEtq := 0;
            end
          end;

          ETiquetas[NC-1].Produto     := qryEtiquetasCodigoVisual.AsString;
          ETiquetas[NC-1].Descricao   := qryEtiquetasDescricaoProdutoLC.AsString;
          ETiquetas[NC-1].Referencia  := qryEtiquetasReferencia.AsString;

          if qryEtiquetasEntrada.AsInteger <> 0 then begin
             ETiquetas[NC-1].Parcelas     := qryEtiquetasEntrada.AsString + ' + '+  qryEtiquetasQtdeParcelas.AsStRing +  ' DE ';
             ETiquetas[NC-1].ValorParcela := TrimLeft(Format('%06.2f',[qryEtiquetasValorParcela.AsCurrency]));
          end
          else begin
             ETiquetas[NC-1].Parcelas     := qryEtiquetasQtdeParcelas.AsStRing +' DE ';
             ETiquetas[NC-1].ValorParcela := TrimLeft(Format('%06.2f',[qryEtiquetasValorParcela.AsCurrency]));
          end;

          Etiquetas[NC-1].Total       := 'TOTAL: ' + Format('%8.2f',[qryEtiquetasTotalParcelas.AsCurrency]);
          ETiquetas[NC-1].Avista      := Format('%08.2f',[qryEtiquetasPRECO.AsCurrency]);
          ETiquetas[NC-1].DataValidade:= qryProcuraPlanosVALIDADEFINAL.AsString;
          Inc(NC);
          Inc(Cont);
        end;
      end;

      Cont:= 1;
    end;
    qryEtiquetas.Next;
  end;
  Imprimir;
end;

Procedure TdtmEmissaoEtiquetas.ImprimirEtiquetasJato(Modificar: Boolean; EtiquetaemBranco: Integer; Arquivo, Impressora: String);
var Relatorio: TfrReport;
    frmPreview: TfrmPreviewPadrao;
    registroatual: Tbookmark;

begin
     Tipo := qryProcuraModelosEtiquetasTipo.AsString;
     nretiquetas:=1;
     qryEtiquetas.DisableControls;
     registroatual:=qryEtiquetas.GetBookmark;
     qryEtiquetas.AfterInsert := nil;
     if EtiquetaemBranco<>0 then
     begin
       qryetiquetas.First;
       qryetiquetas.Insert;
       qryEtiquetasCodigo.clear;
       qryEtiquetasCodigoVisual.clear;
       qryEtiquetasMarcar.Value := true;
       qryEtiquetasQuantidadeProduto.asinteger := EtiquetaemBranco;
       qryEtiquetasdescricaoproduto.AsString := '???';
       qryetiquetas.Post;
     end;
     qryEtiquetas.Append;
     qryEtiquetasMarcar.Value:=true;
     qryEtiquetasdescricaoproduto.AsString := '???';     
     qryEtiquetas.Post;
     qryetiquetas.AfterInsert := qryEtiquetasAfterInsert;
     qryEtiquetas.Filtered:=true;
     frpEtiquetasAndra.Dataset := fdsEtiquetas;

     if trim(arquivo) <> '' then
        frpEtiquetasAndra.LoadFromFile(trim(arquivo));

     if tipo = 'AP' then
     begin
//         frpEtiquetasApolonia_ProdutosExposicao_.designReport;
       if ImprimirFoto then
       begin
         try
           vImage := timage.create(nil);
           frpEtiquetasApolonia_ProdutosExposicaoFotos_.showreport;
         finally
           vImage.free;
           ImprimirFoto := false;
         end;  

       end
       else
         frpEtiquetasApolonia_ProdutosExposicao_.showreport;
     end
     else
     if tipo = 'MS' then  {Mariah-sa}
     begin
       tfrxReportpage(frpEtiquetasMariah_SA.pages[1]).TopMargin := fMargemSuperior;
//       frpEtiquetasMariah_SA.designReport;
       frpEtiquetasMariah_SA.showreport;
     end
     else
     begin

       frmPreview := TfrmPreviewPadrao.create(self);
       try
         Relatorio := frmPreview.frCompositeReport;
         frmPreview.frCompositeReport.Reports.Clear;
         if tipo = 'A' then
         begin
       //  frpEtiquetasAndra.DesignReport;
           frmPreview.frCompositeReport.Reports.Add(frpEtiquetasAndra)
         end
         else
         if tipo = 'K' then
           frmPreview.frCompositeReport.Reports.Add(frpEtiquetasKilar)
         else
         if tipo = 'FL' then
           frmPreview.frCompositeReport.Reports.Add(frp_A4_5Col);


         Relatorio.Preview := frmPreview.frPreviewPadrao;
         Relatorio.ShowReport;
         frmPreview.ShowModal;
       finally
         frmPreview.Free
       end;
     end;

     qryEtiquetas.Filtered:=false;
     qryEtiquetas.Last;
     if qryEtiquetasCodigoVisual.AsString = '' then
        qryEtiquetas.Delete;

     if EtiquetaemBranco<>0 then
     begin
      qryetiquetas.First;
      if qryEtiquetasCodigoVisual.AsString = '' then
         qryEtiquetas.Delete;
     end;

     qryEtiquetas.GotoBookmark(registroatual);
     qryEtiquetas.FreeBookmark(registroatual);
     qryEtiquetas.EnableControls;
end;

procedure TdtmEmissaoEtiquetas.fdsEtiquetasNext(Sender: TObject);
begin
  inherited;
  if (NrEtiquetas < EtiquetasaImprimir) then begin
    NrEtiquetas:= NrEtiquetas + 1;
    if (not qryEtiquetas.Eof) then
       fdsEtiquetas.Prior;
  end
  else
    NrEtiquetas:= 1;
end;

procedure TdtmEmissaoEtiquetas.frpEtiquetasAndraBeforePrint(
  Memo: TStringList; View: TfrView);
