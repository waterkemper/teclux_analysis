}
                               Linhas[1, Col]:= 'A576,' + FStr(Y,$00) + ',1,3,2,1,N,"' + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''), 1,30) + '"';
                               Linhas[2, Col]:= 'A536,' + FStr(Y,$00) + ',1,3,2,1,N,"' + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),31,30) + '"';
                               if Trim(Copy(qryEtiquetasReferencia.AsString,1,15)) <> ''
                               then Linhas[3, Col]:= 'A490,' + FStr(Y+200,$00) +  ',1,2,2,1,N,"' +
                                                     CenDirEsq('REF: ' + Trim(Copy(qryEtiquetasReferencia.AsString,1,15)),19,' ','D') + '"';

                               if FImprimirPreco
                               then if qryProcuraPlanosCodigo.AsInteger <> 0 then begin
