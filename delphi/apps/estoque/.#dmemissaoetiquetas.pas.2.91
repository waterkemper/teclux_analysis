procedure TdtmEmissaoEtiquetas.Etiquetas_Modelo_A;
const
  MaxCampo = 3;

type
  T_Etiquetas = Array of Record
    Produto      : String;
    Descricao    : String;
    Referencia   : String;
  end;

var
  Cont, NC, Colunas : Integer;
  ETiquetas: T_Etiquetas;

  procedure Imprimir;
  Var
    ETQ, NrC: Integer;

  begin
    with TextPrinter do begin
      NrC:= 1;
      while (NrC <= MaxCampo) do begin
        case NrC of
          1: begin
               for ETQ:= 1 to Colunas do begin
                 if ETiquetas[ETQ-1].Produto <> '' then
                    FTexto:= FTexto + '<sp>(5L)</sp><b><ex><e>' + ETiquetas[ETQ-1].Produto +
'(14C)</e></ex></b><sp>(3L)</sp>';
               end;
               FTexto:= FTexto + '<sbl><sbl>';
               Inc(NrC);
             end;
          2: begin
               for ETQ:= 1 to Colunas do begin
                 if ETiquetas[ETQ-1].Produto <> '' then
                   FTexto:= FTexto + '<sp>(2L)</sp><b><e>' + ETiquetas[ETQ-1].Descricao +
'(34C)</e></b>';
               end;
               FTexto:= FTexto + '<sbl>';
               Inc(NrC);
             end;
          3: begin
               for ETQ:= 1 to Colunas do begin
                 if ETiquetas[ETQ-1].Produto <> '' then
                   FTexto:= FTexto + '<sp>(08L)</sp><b><e>' + ETiquetas[ETQ-1].Referencia +
'(20C)</e></b><sp>(09L)</sp>';
               end;
               FTexto:= FTexto + '<sbl><sbl><sbl><sbl><sbl>';
               Inc(NrC);
             end;
        end;
      end;
      FillChar(Etiquetas,SizeOf(Etiquetas),0);
      SetLength(Etiquetas,Colunas);
      NC:= 1;
    end;
  end;

begin
  Colunas := qryProcuraModelosEtiquetasColuna.AsInteger;
  Cont:= 1; NC:= 1;
  SetLength(Etiquetas,Colunas);
  qryEtiquetas.First;
  while not qryEtiquetas.Eof do begin
    if qryEtiquetasMarcar.AsBoolean then begin
      while (Cont <= qryEtiquetasQuantidadeProduto.AsInteger) do begin
        if (NC > Colunas) then
          Imprimir
        else begin
          ETiquetas[NC-1].Produto    := qryEtiquetasCodigoVisual.AsString;
          ETiquetas[NC-1].Descricao  := qryEtiquetasDescricaoProdutoLC.AsString;
          ETiquetas[NC-1].Referencia := qryEtiquetasReferencia.AsString;
          Inc(NC);
          Inc(Cont);
        end;
      end;
      Cont:= 1;
    end;
    qryEtiquetas.Next;
  end;
  Imprimir;
end;

procedure TdtmEmissaoEtiquetas.Etiquetas_Modelo_C;
const
  MaxCampo = 4;

type
  T_Etiquetas = Array of Record
    Produto    : String;
    Descricao  : String;
    Referencia : String;
    Unidade    : String;
    Valor      : String;
  end;

var
  Cont, NC, Colunas : Integer;
  ETiquetas: T_Etiquetas;

  procedure Imprimir;
  Var
    ETQ, NrC: Integer;

  begin
    with TextPrinter do begin
      NrC:= 1;
      while (NrC <= MaxCampo) do begin
        case NrC of
          1: begin
               for ETQ:= 1 to Colunas do begin
                 if ETiquetas[ETQ-1].Produto <> '' then
                   FTexto:= FTexto + '<sp>(1L)</sp><b><e>' + ETiquetas[ETQ-1].Produto +
'(15R)</e></b><sp>(3L)</sp>' +
                                     '<b><e>' + ETiquetas[ETQ-1].Unidade +
'(02C)</e></b><sp>(12L)</sp>';
               end;
               FTexto:= FTexto + '<sbl>';
               Inc(NrC);
             end;
          2: begin
               for ETQ:= 1 to Colunas do begin
                 if ETiquetas[ETQ-1].Produto <> '' then
                   FTexto:= FTexto + '<sp>(1L)</sp><b><e>' + ETiquetas[ETQ-1].Descricao +
'(30L)</e></b><sp>(2L)</sp>';
               end;
               FTexto:= FTexto + '<sbl>';
               Inc(NrC);
             end;
          3: begin
               for ETQ:= 1 to Colunas do begin
                 if ETiquetas[ETQ-1].Produto <> '' then
                   FTexto:= FTexto + '<sp>(01L)</sp><b><e>' + ETiquetas[ETQ-1].Referencia +
'(20L)</e></b><sp>(12L)</sp>';
               end;
               FTexto:= FTexto + '<sbl>';
               Inc(NrC);
             end;
          4: begin
               for ETQ:= 1 to Colunas do begin
                 if ETiquetas[ETQ-1].Produto <> '' then
                   FTexto:= FTexto + '<sp>(7L)</sp><b><ex><e>' + ETiquetas[ETQ-1].Valor +
'(12R)</e></ex></b><sp>(2L)</sp>';
               end;
               FTexto:= FTexto + '<sbl><sbl><sbl><sbl><sbl>';
               Inc(NrC);
             end;
        end;
      end;
      FillChar(Etiquetas,SizeOf(Etiquetas),0);
      SetLength(Etiquetas,Colunas);
      NC:= 1;
    end;
  end;

begin
  Colunas := qryProcuraModelosEtiquetasColuna.AsInteger;
  Cont:= 1; NC:= 1;
  SetLength(Etiquetas,Colunas);
  qryEtiquetas.First;
  while not qryEtiquetas.Eof do begin
    if qryEtiquetasMarcar.AsBoolean then begin
      while (Cont <= qryEtiquetasQuantidadeProduto.AsInteger) do begin
        if (NC > Colunas) then
          Imprimir
        else begin
          ETiquetas[NC-1].Produto    := qryEtiquetasCodigoVisual.AsString;
          ETiquetas[NC-1].Descricao  := qryEtiquetasDescricaoProdutoLC.AsString;
          ETiquetas[NC-1].Referencia := qryEtiquetasReferencia.AsString;
          ETiquetas[NC-1].Unidade    := qryEtiquetasunidade.AsString;
          if ImprimirPreco then
               ETiquetas[NC-1].Valor := FormatarValor(qryEtiquetaspreco.AsCurrency,2)
          else ETiquetas[NC-1].Valor := '';
          Inc(NC);
          Inc(Cont);
        end;
      end;
      Cont:= 1;
    end;
    qryEtiquetas.Next;
  end;
  Imprimir;
end;

procedure TdtmEmissaoEtiquetas.Etiquetas_Modelo_D;
const
  MaxLinha = 3;

type
  T_Etiquetas = Array of Record
    Produto    : String;
    Descricao  : String;
    Referencia : String;
    Data       : String;
    FatorPreco : String;
    Valor      : String;
  end;

var
  Cont, NC, Colunas : Integer;
  ETiquetas: T_Etiquetas;
  Dia, Mes, Ano: Word;

  procedure Imprimir;
  Var
    ETQ, NrC: Integer;

  begin
    with TextPrinter do begin
      NrC:= 1;
      while (NrC <= MaxLinha) do begin
        case NrC of
          1: begin
               for ETQ:= 1 to Colunas do begin
                 if ETiquetas[ETQ-1].Produto <> '' then
                   FTexto:= FTexto + '<sp>(01L)</sp><cd><e>' + ETiquetas[ETQ-1].Produto +
'(12L)</e></cd><sp>(01L)</sp>' +
                                     '<cd><e>' + ETiquetas[ETQ-1].Referencia +
'(12R)</e></cd><sp>(2L)</sp>';
               end;
               FTexto:= FTexto + '<sbl>';
               Inc(NrC);
             end;
          2: begin
               for ETQ:= 1 to Colunas do begin
                 if ETiquetas[ETQ-1].Produto <> '' then
                   FTexto:= FTexto + '<cd><e>' + ETiquetas[ETQ-1].Descricao +
'(30L)</e></cd><sp>(1L)</sp>';
               end;
               FTexto:= FTexto + '<sbl>';
               Inc(NrC);
             end;
          3: begin
               for ETQ:= 1 to Colunas do begin
                 if ETiquetas[ETQ-1].Produto <> '' then begin
                   FTexto:= FTexto + '<cd><e>' + ETiquetas[ETQ-1].Data  +
'(05L)</e></cd><sp>(04L)</sp>' +
                                     '<cd><e>' + ETiquetas[ETQ-1].FatorPreco +
'(04L)</e></cd><sp>(02L)</sp>'     +
                                     '<cd><e>' + ETiquetas[ETQ-1].Valor +
'(06R)</e><sp>(01L)</sp></cd><sp>(02L)</sp>';
                 end;
               end;
               FTexto:= FTexto + '<sbl><sbl>';
               Inc(NrC);
             end;
        end;
      end;
      FillChar(Etiquetas,SizeOf(Etiquetas),0);
      SetLength(Etiquetas,Colunas);
      NC:= 1;
    end;
  end;

begin
  Colunas := qryProcuraModelosEtiquetasColuna.AsInteger;
  Cont:= 1; NC:= 1;
  SetLength(Etiquetas,Colunas);
  qryEtiquetas.First;
  while not qryEtiquetas.Eof do begin
    if qryEtiquetasMarcar.AsBoolean then begin
      while (Cont <= qryEtiquetasQuantidadeProduto.AsInteger) do begin
        if (NC > Colunas) then
          Imprimir
        else begin
          DecodeDate(qryEtiquetasultimaentrada.AsDateTime,Ano,Mes,Dia);
          ETiquetas[NC-1].Produto    := qryEtiquetasCodigoVisual.AsString;
          ETiquetas[NC-1].Descricao  := qryEtiquetasDescricaoProdutoLC.AsString;
          ETiquetas[NC-1].Referencia := qryEtiquetasReferencia.AsString;
          ETiquetas[NC-1].FatorPreco := qryEtiquetasFatorPreco.AsString;

          if ImprimirPreco then
            ETiquetas[NC-1].Valor    := FloatToStr(Int(qryEtiquetaspreco.AsCurrency))
          else
            ETiquetas[NC-1].Valor := '';
            
          ETiquetas[NC-1].Data       := ''; //IntToStr(Mes) + '/' + Copy(IntToStr(Ano),3,2);
          Inc(NC);
          Inc(Cont);
        end;
      end;
      Cont:= 1;
    end;
    qryEtiquetas.Next;
  end;
  Imprimir;
end;



procedure TdtmEmissaoEtiquetas.Etiquetas_Modelo_E;  //----- FRETTA LAGUNA -----


{   1...5...10....5...20....5.. 1...5...10....5...20....5..
 1  CÓDIGO PRODUTO.. ...UNIDADE CÓDIGO PRODUTO..... UNIDADE
 2  DESCRICAO_1................ DESCRICAO_1................
 3  DESCRICAO_2................ DESCRICAO_2................
 4  MM/AAAA  REF. XXXXXXXXXXXXX MM/AAAA REF. XXXXXXXXXXXXXX
 5      R$ 999.999.999,99             R$ 999.999.999,99
}

const NrLinhas = 5;

var   NrProdutos: integer;
      NrColunas:  integer;
      Linhas:  array[1..NrLinhas, 1..10] of string[27];


      procedure Imprimir;
      var Col, Lin: Integer;
      begin
         for Lin:= 1 to NrLinhas do begin
             for Col:= 1 to qryProcuraModelosEtiquetasColuna.AsInteger do
                 FTexto:= FTexto +  Linhas[Lin, Col] + ' ';
             FTexto:= FTexto + '<sbl>';
         end;
         FTexto:= FTexto + '<sbl>';
         NrColunas:= 1;
      end;


begin

   NrColunas := 1;
   NrProdutos:= 1;
   qryEtiquetas.First;
   while not qryEtiquetas.Eof do begin
      if qryEtiquetasMarcar.AsBoolean then begin
         while NrProdutos <= qryEtiquetasQuantidadeProduto.AsInteger do begin
            if NrColunas > qryProcuraModelosEtiquetasColuna.AsInteger then Imprimir;

            Linhas[1, NrColunas]:= qryEtiquetasCodigo.AsString;
            Linhas[1, NrColunas]:= CenDirEsq(Linhas[1, NrColunas],20,' ','E') +
                                   CenDirEsq(qryEtiquetasunidade.AsString,07, ' ', 'D');
            Linhas[2, NrColunas]:= CenDirEsq(copy(qryEtiquetasDescricaoProdutoLC.AsString, 1,27),27,' ','E');
            Linhas[3, NrColunas]:= CenDirEsq(copy(qryEtiquetasDescricaoProdutoLC.AsString,28,27),27,' ','E');
            if qryEtiquetasReferencia.AsString <> ''
            then Linhas[4, NrColunas]:= FStr(MonthOf(DataServidor),$21) + '/' + FStr(YearOf (DataServidor),$41) +
                                        CenDirEsq('REF: ' + qryEtiquetasReferencia.AsString,20,' ','D')
            else Linhas[4, NrColunas]:= FStr(MonthOf(DataServidor),$21) + '/' + FStr(YearOf (DataServidor),$41) + IncSt(' ',20);

            if ImprimirPreco
            then Linhas[5, NrColunas]:= CenDirEsq('R$ ' + FormatarValor(qryEtiquetaspreco.AsCurrency,2),27,' ','C')
            else Linhas[5, NrColunas]:= IncSt(' ', 27);
            Inc(NrProdutos);
            Inc(NrColunas);
         end;
      end;
      qryEtiquetas.Next;
   end;
   Imprimir;

end;

procedure TdtmEmissaoEtiquetas.GuardarEtiquetas;
var
  Modelo: String;
begin
  Modelo:= qryProcuraModelosEtiquetasmodelo.AsString;
  case Modelo[1] of
    'A' : Etiquetas_Modelo_A;   // RIBEIRO 2 ColunaS
    'C' : Etiquetas_Modelo_C;   // COM PRECO/SEM PRECO
    'D' : Etiquetas_Modelo_D;
    'E' : Etiquetas_Modelo_E;   // Fretta Laguna 2 colunas
    'F' : Etiquetas_Modelo_F;   // PETIPE
  end;
end;

