               //WriteTextLn('A355,020,0,2,1,1,N,"' + Copy(NomeFilialBase,1,33)                  + '"' + #13,0);
               //WriteTextLn('A355,040,0,2,1,1,N,"' + Copy(RuaFilialBase,1,33)                   + '"' + #13,0);
               //WriteTextLn('A355,060,0,2,1,1,N,"' + Copy(BairroFilialBase,1,33)                + '"' + #13,0);
               //WriteTextLn('A355,080,0,2,1,1,N,"' + FormatarCep(CepFilialBase)+ ' - '+ Trim(Copy(CidadeFilialBase,1,20)) + ' - '
               //                                   + EstadoFilialBase                            + '"' + #13,0);
               //WriteTextLn('A355,100,0,2,1,1,N,"' + 'FONE/FAX: ' + FormatarFone(DddFilialBase,FoneFilialBase)              + '"'  + #13,0);
               //WriteTextLn('A355,120,0,2,1,1,N,"WWW.GAMA-SC.COM.BR"'                           + #13,0);
               //WriteTextLn('GW655,55,14,88,'     + Copy(Buffer1,1,Length(Buffer1)),0);  // LOGO EMPILHADEIRA

               WriteTextLn('A055,160,0,3,1,1,N,"' + 'Para  : ' + qryNotasSaidasNome.AsString          + '"' + #13,0);
               WriteTextLn('A055,180,0,3,1,1,N,"' + 'Rua   : ' + qryNotasSaidasRua.AsString           + '"' + #13,0);
               WriteTextLn('A055,200,0,3,1,1,N,"' + 'Bairro: ' + qryNotasSaidasNomeBairro.AsString    + '"' + #13,0);
               WriteTextLn('A055,220,0,3,1,1,N,"' + 'Cidade: ' + PreencheString(qryNotasSaidasNomeCidade.AsString,' ',33,True) +
                                                    'UF: '     + qryNotasSaidasEstado.AsString        + '"'  + #13,0);
               WriteTextLn('A055,240,0,3,1,1,N,"' + 'Cep   : ' + FormatarCep(qryNotasSaidasCep.AsString)  + '"' + #13,0);
               WriteTextLn('A055,260,0,3,1,1,N,"' + 'ATT   : ' + qryNotasSaidasAtt.AsString        + '"' + #13,0);

               Obs  := Trim(qryNotasSaidasObservacoes.AsString);
               Obs1 := '';
               for J := 1 to Length(Obs) do
                   if obs[J] <> '"' then
                      obs1 := Obs1 + obs[J];

               WriteTextLn('A055,290,0,3,1,1,N,"' + 'OBS   : ' +  Trim(COPY(Obs1,01,41))   + '"' + #13,0);
               WriteTextLn('A055,320,0,3,1,1,N,"' + '        ' +  Trim(COPY(Obs1,42,39))   + '"' + #13,0);
               WriteTextLn('A055,345,0,3,1,1,N,"' + '        ' +  Trim(COPY(Obs1,81,39))   + '"' + #13,0);
               WriteTextLn('P1',0);
            End;
            qryNotasSaidas.Next;
          End;
          EndDoc('TecLUX - Imprimindo Etiqueta GRANDE (DEST./REM.) ZEBRA TLP 2844');
        finally
          qryNotasSaidas.EnableControls;
        End;
      End;
      EXIT;
  End;
  if Tipo='M1' then  //MOREIRA PEQUENA 2 ColunaS
     With TextPrinter do
       Begin
         Try
           qryEtiquetas.First;
           BeginDoc('', False);
           While not qryEtiquetas.Eof do
           Begin
             If qryEtiquetasMarcar.AsBoolean Then Begin
               NE:= 1;
               While NE <= qryEtiquetasQuantidadeProduto.AsInteger do
               Begin
                 If qryEtiquetasTotal.AsCurrency = 0
                 Then PrecoPrazo:= qryEtiquetasPreco.AsCurrency
                 Else PrecoPrazo:= qryEtiquetasTotal.AsCurrency;

                 Case Tamanho Of
                   0,1: If Esquerdo Then Begin
                           WriteTextLn('',0);
                           WriteTextLn('N'         + #13,0);
                           WriteTextLn('q800'      + #13,0);
                           WriteTextLn('Q200,20+0' + #13,0);
                           WriteTextLn('S2'        + #13,0);
                           WriteTextLn('D' + FStr(ParSistema.IntensidadeImpressaoZebra,$00),0);
                           WriteTextLn('ZT'        + #13,0);
                           WriteTextLn('TTh:m'     + #13,0);
                           WriteTextLn('TDy2.mn.dd'+ #13,0);
                           WriteTextLn('O'         + #13,0);
                           WriteTextLn('A120,10,0,3,1,1,N,"'      + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''), 1,20) + '"' + #13,0);
                           WriteTextLn('A120,30,0,3,1,1,N,"'      + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),21,20) + '"' + #13,0);
                           WriteTextLn('B160,60,0,1,2,2,40,N,"' + qryEtiquetasCodigoVisual.AsString + '"' + #13,0);
                           WriteTextLn('A160,125,0,4,1,1,N,"'      + qryEtiquetasCodigoVisual.AsString + '"' + #13,0);
                        End
                        Else
                        Begin
                           WriteTextLn('A452,10,0,3,1,1,N,"'      + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''), 1,20) + '"' + #13,0);
                           WriteTextLn('A452,30,0,3,1,1,N,"'      + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),21,20) + '"' + #13,0);
                           WriteTextLn('B492,60,0,1,2,2,40,N,"' + qryEtiquetasCodigoVisual.AsString + '"' + #13,0);
                           WriteTextLn('A492,125,0,4,1,1,N,"'      + qryEtiquetasCodigoVisual.AsString + '"' + #13,0);
                        End;
                 End;
                 If not Esquerdo Then WriteTextLn('P1' + #13,0);
                 Inc(NE);
                 Esquerdo:= not Esquerdo;
               End;
             End;
             qryEtiquetas.Next;
           End;
           If not Esquerdo Then WriteTextLn('P1' + #13,0);
           EndDoc('TecLUX - Imprimindo Etiqueta ZEBRA TLP 2844');
        Finally
        qryEtiquetas.EnableControls;
      end;
    end;

    {-------------------------------------------------------------- Nazaré - 3 Colunas (33 x 22 mm)}
    if Tipo = 'NZ' then with TextPrinter do begin
      case qryProcuraModelosEtiquetasColuna.AsInteger of
      3: begin
                 if qryProcuraModelosEtiquetasDescricao.AsString = 'ZEBRA 3 COLUNAS (25 x 34 mm)' then begin MaisY1:= 6; MaisY2:= 14; end
            else if qryProcuraModelosEtiquetasDescricao.AsString = 'ZEBRA 3 COLUNAS (22 x 34 mm)' then begin MaisY1:= 0; MaisY2:=  0; end
                                                                                                  else begin MaisY1:= 0; MaisY2:=  0; end;
            if ImprimirPreco then NrLinhas:= 7
                             else NrLinhas:= 6;
            try
               Col := 0;    FillChar(Linhas,SizeOf(Linhas),0);
               qryEtiquetas.First;
               while not qryEtiquetas.EOF do begin
                  if qryEtiquetasMarcar.AsBoolean then begin

                     for NP:= 1 to qryEtiquetasQuantidadeProduto.AsInteger do begin
                         Inc(Col);
                         case Col of
                             1: X:=  13;
                             2: X:= 294;
                             3: X:= 562;
                         end;
{
A13,3,0,2,1,1,N,"SANTA  TEREZINHA 7,"
A294,3,0,2,1,1,N,"SANTA  TEREZINHA 7,"
A594,3,0,2,1,1,N,"SANTA  TEREZINHA 7,"
A13,23,0,2,1,1,N,"5CM RESINA GOLD"
A294,23,0,2,1,1,N,"5CM RESINA GOLD"
A594,23,0,2,1,1,N,"5CM RESINA GOLD"
A21,43,0,2,1,1,N,""
A294,43,0,2,1,1,N,""
A562,43,0,2,1,1,N,""
A21,63,0,2,1,1,N,"      REF: 2209"
A294,63,0,2,1,1,N,"      REF: 2209"
A562,63,0,2,1,1,N,"      REF: 2209"
A21,80,0,4,1,1,N,"     R$ 9,00     "
A294,80,0,4,1,1,N,"     R$ 9,00     "
A562,80,0,4,1,1,N,"     R$ 9,00     "
B56,104,0,1,2,2,40,N,"6428"
B329,104,0,1,2,2,40,N,"6428"
B597,104,0,1,2,2,40,N,"6428"
A76,141,0,3,1,1,N,"6428"
A349,141,0,3,1,1,N,"6428"
A617,141,0,3,1,1,N,"6428"
}

                         Linhas[1, Col]:= 'A' + FStr(X,$00) +  ',3,0,2,1,1,N,"'  + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''), 1,19) + '"';
                         Linhas[2, Col]:= 'A' + FStr(X,$00) +  ',23,0,2,1,1,N,"' + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),20,19) + '"';
                         Linhas[3, Col]:= 'A' + FStr(X,$00) +  ',43,0,2,1,1,N,"' + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),40,19) + '"';
                         if Trim(Copy(qryEtiquetasReferencia.AsString,1,15)) <> ''
                         then Linhas[4, Col]:= 'A' + FStr(X+8,$00) +  ',63,0,2,1,1,N,"' + CenDirEsq('REF: ' +
                                                                                        Trim(Copy(qryEtiquetasReferencia.AsString,1,15)),19,' ','D') + '"'
                         else Linhas[4, Col]:= 'A' + FStr(X+8,$00) +  ',63,0,2,1,1,N,""';

                         if FImprimirPreco then begin
                            Linhas[5, Col]:= 'A' + FStr(X+08,$00) + ',' + FStr( 80+MaisY1,$00) + ',0,4,1,1,N,"' + CenDirEsq('R$ ' + FormatarValor(qryEtiquetaspreco.AsCurrency,2),17,' ','C') + '"';
                            Linhas[6, Col]:= 'B' + FStr(X+35,$00) + ',' + FStr(104+MaisY1,$00) + ',0,1,2,2,40,N,"' + qryEtiquetasCodigoVisual.AsString + '"';
                            Linhas[7, Col]:= 'A' + FStr(X+55,$00) + ',' + FStr(141+MaisY2,$00) + ',0,3,1,1,N,"'    + qryEtiquetasCodigoVisual.AsString + '"';
                         end
                         else begin
                            Linhas[5, Col]:= 'B' + FStr(X+35,$00) + ',' + FStr(104+MaisY1,$00) + ',0,1,2,2,40,N,"' + qryEtiquetasCodigoVisual.AsString + '"';
                            Linhas[6, Col]:= 'A' + FStr(X+55,$00) + ',' + FStr(141+MaisY2,$00) + ',0,3,1,1,N,"'    + qryEtiquetasCodigoVisual.AsString + '"';
                         end;

                         if Col = 3 then begin
                            BeginDoc('', False);
//                             WriteTextLn('^default',  0);
                               WriteTextLn('N',         0);
                               WriteTextLn('q816',      0);

                                    if qryProcuraModelosEtiquetasDescricao.AsString = 'ZEBRA 3 COLUNAS (25 x 34 mm)' then WriteTextLn('Q192,24+0', 0)
                               else if qryProcuraModelosEtiquetasDescricao.AsString = 'ZEBRA 3 COLUNAS (22 x 34 mm)' then WriteTextLn('Q176,24+0', 0);
                               WriteTextLn('S2',        0);
                               WriteTextLn('D' + FStr(ParSistema.IntensidadeImpressaoZebra,$00),0);
                               WriteTextLn('ZT',        0);

                               for NL:= 1 to NrLinhas do
                                   for NC:= 1 to 3 do
                                       WriteTextLn(Linhas[NL, NC],0);
                               WriteTextLn('P1', 0);
                           EndDoc('TecLUX - Imprimindo Etiqueta ZEBRA TLP 2844');
                           Col := 0;           FillChar(Linhas,SizeOf(Linhas),0);
                         end;
                     end;
                  end;
                  qryEtiquetas.Next;
               end;

               if Col <> 0 then begin
                  BeginDoc('', False);
//                   WriteTextLn('^default',  0);
                     WriteTextLn('N',         0);
                     WriteTextLn('q816',      0);

                          if qryProcuraModelosEtiquetasDescricao.AsString = 'ZEBRA 3 COLUNAS (25 x 34 mm)' then WriteTextLn('Q192,24+0', 0)
                     else if qryProcuraModelosEtiquetasDescricao.AsString = 'ZEBRA 3 COLUNAS (22 x 34 mm)' then WriteTextLn('Q176,24+0', 0);

                     WriteTextLn('S2',        0);
                     WriteTextLn('D' + FStr(ParSistema.IntensidadeImpressaoZebra,$00),0);
                     WriteTextLn('ZT',        0);

                     for NL:= 1 to NrLinhas do
                         for NC:= 1 to 3 do
                             WriteTextLn(Linhas[NL, NC],0);
                     WriteTextLn('P1', 0);
                  EndDoc('TecLUX - Imprimindo Etiqueta ZEBRA TLP 2844');
               end;

            finally
               qryEtiquetas.EnableControls;
            end;
         end;
      end;
    end; {FINAL --------------------------------------------------- Nazaré - 3 Colunas (33 x 22 mm)}

    if Tipo='M2' then  //MOREIRA PEQUENA 3 ColunaS
     With TextPrinter do
       Begin
         Try
           qryEtiquetas.First;
           BeginDoc('', False);
           While not qryEtiquetas.Eof do
           Begin
             If qryEtiquetasMarcar.AsBoolean Then Begin
               NE:= 1;
               While NE <= qryEtiquetasQuantidadeProduto.AsInteger do
               Begin
                 If qryEtiquetasTotal.AsCurrency = 0
                 Then PrecoPrazo:= qryEtiquetasPreco.AsCurrency
                 Else PrecoPrazo:= qryEtiquetasTotal.AsCurrency;

                 Case Tamanho Of
                   0,1: If Esquerdo Then Begin
                           WriteTextLn('',0);
                           WriteTextLn('N'         + #13,0);
                           WriteTextLn('q864'      + #13,0);
                           WriteTextLn('Q176,24+0' + #13,0);
                           WriteTextLn('S2'        + #13,0);
                           WriteTextLn('D' + FStr(ParSistema.IntensidadeImpressaoZebra,$00),0);
                           WriteTextLn('ZT'        + #13,0);
                           WriteTextLn('TTh:m'     + #13,0);
                           WriteTextLn('TDy2.mn.dd'+ #13,0);
                           WriteTextLn('O'         + #13,0);
                           WriteTextLn('A10,5,0,2,1,1,N,"'     + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''), 1,19) + '"' + #13,0);
                           WriteTextLn('A10,30,0,2,1,1,N,"'    + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),20,21) + '"' + #13,0);
                           WriteTextLn('B60,50,0,1,2,2,40,N,"' + qryEtiquetasCodigoVisual.AsString + '"' + #13,0);
                           WriteTextLn('A60,115,0,3,1,1,N,"'      + qryEtiquetasCodigoVisual.AsString + '"' + #13,0);
                        End
                        Else if (Meio) then
                        Begin
                           WriteTextLn('A300,5,0,2,1,1,N,"'     + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''), 1,19) + '"' + #13,0);
                           WriteTextLn('A300,30,0,2,1,1,N,"'    + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),20,21) + '"' + #13,0);
                           WriteTextLn('B350,70,0,1,2,2,40,N,"' + qryEtiquetasCodigoVisual.AsString + '"' + #13,0);
                           WriteTextLn('A350,115,0,3,1,1,N,"'      + qryEtiquetasCodigoVisual.AsString + '"' + #13,0);
                        End
                        Else
                        BEGIN
                           WriteTextLn('A600,5,0,2,1,1,N,"'     + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''), 1,19) + '"' + #13,0);
                           WriteTextLn('A600,30,0,2,1,1,N,"'    + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),20,21) + '"' + #13,0);
                           WriteTextLn('B650,70,0,1,2,2,40,N,"' + qryEtiquetasCodigoVisual.AsString + '"' + #13,0);
                           WriteTextLn('A650,115,0,3,1,1,N,"'      + qryEtiquetasCodigoVisual.AsString + '"' + #13,0);
                        END;
                 End;
                 If not Esquerdo and not Meio Then WriteTextLn('P1' + #13,0);
                 Inc(NE);
                 If Esquerdo then
                 begin
                    esquerdo:= false;
                    Meio    := True;
                 end
                 else If Meio Then
                 begin
                     Meio:= false;
                 end
                 else
                     esquerdo:= true;
                 //Esquerdo:= not Esquerdo;
               End;
             End;
             qryEtiquetas.Next;
           End;
           If not Esquerdo Then WriteTextLn('P1' + #13,0);
           EndDoc('TecLUX - Imprimindo Etiqueta ZEBRA TLP 2844');
        Finally
        qryEtiquetas.EnableControls;
      end;
    end;
    if Tipo='M3' then  //MOREIRA MENOR 3 ColunaS
     With TextPrinter do
       Begin
         Try
           qryEtiquetas.First;
           BeginDoc('', False);
           Primeira:=true;
           While not qryEtiquetas.Eof do
           Begin
             If qryEtiquetasMarcar.AsBoolean Then Begin
               if Primeira then
               begin
                           Primeira:=false;
                           WriteTextLn('',0);
