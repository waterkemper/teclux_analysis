                            Linhas[6, Col]:= 'B' + FStr(X+35,$00) + ',' + FStr(104+MaisY1,$00) + ',0,1,2,2,40,N,"' + qryEtiquetasCodigoVisual.AsString + '"';
                            Linhas[7, Col]:= 'A' + FStr(X+55,$00) + ',' + FStr(141+MaisY2,$00) + ',0,3,1,1,N,"'    + qryEtiquetasCodigoVisual.AsString + '"';
