 var
  Linhas : String;
{ dtmEmissaoEtiquetas: TdtmEmissaoEtiquetas; }

{Select p.Codigo as Codigo,0.00 as valorparcela,0 as Qtdeparcelas,0.00 as totalparcelas,0 as entrada,
       p.descricao as descricaoproduto,(select  f.nome from fornecedores f,  fornecedoresprodutos fp   where (fp.caracteristica = c.Codigo) and (f.Codigo = fp.fornecedor) order by data desc limit 1) as nomefornecedor,
       (select gr.descricao from grades gr where gr.Codigo = c.grade1) as linha,
       (select gr.descricao from grades gr where gr.Codigo = c.grade2) as Coluna,
        p.valorgrade1,
        (select  f.Codigo
         from fornecedores f,  fornecedoresprodutos fp
         where (fp.caracteristica = c.Codigo)
         and (f.Codigo = fp.fornecedor)
         order by data desc
         limit 1) as Codigofornecedor,
        p.valorgrade2,
        p.referencia as referencia,
         c.fatorpreco as fatorpreco,
         c.unidade,
         m.descricao as descricaomarca,
         0 as filial,
         0 as quantidadeproduto,
         current_date as ultimaentrada,
         0.00 as preco,
         0.00 as total,
         true as Marcar,
         '' as localizacao
  From   produtos p, caracteristicas c, marcas m
  Where  (p.Codigo = 0) and (p.caracteristica = c.Codigo) and (c.marca = m.Codigo)
}

const STX = #$02;



implementation

uses fmemissaoetiquetas;


{$R *.dfm}

constructor TdtmEmissaoEtiquetas.Create(AOwner: TComponent);
begin
  inherited;
//  try
  qryProcuraSeries.Tag                := ctTabelas;
  qryProcuraNotas.Tag                 := ctTabelas;
  qryProcuraClasses.Tag               := ctTabelas;
  qryProcuraFiliais.Tag               := ctTabelas;
  qryProcuraFornecedoresNotas.Tag     := ctTabelas;
  qryProcuraFornecedoresProdutos.Tag  := ctTabelas;
  qryProcuraClientes.Tag              := ctTabelas;
  qryProcuraGrupos.Tag                := ctTabelas;
  qryProcuraMarcas.Tag                := ctTabelas;
  qryProcuraTipoMovto.Tag             := ctTabelas;
  qryProcuraModelosEtiquetas.Tag      := ctTabelas;
  qryConsultaSeries.Tag               := ctPesquisaSerie;
  qryConsultaNotas.Tag                := ctPesquisaNota;
  qryConsultaClasses.Tag              := ctPesquisaClasse;
  qryConsultaFiliais.Tag              := ctPesquisaFilial;
  qryConsultaFornecedoresNotas.Tag    := ctPesquisaFornecedorNotas;
  qryConsultaFornecedores.Tag := ctPesquisaFornecedorProdutos;
  qryConsultaGrupos.Tag               := ctPesquisaGrupo;
  qryConsultaMarcas.Tag               := ctPesquisaMarca;
  qryConsultaTipoMovto.Tag            := ctPesquisaTiposMovimentos;
  qryConsultaModelosEtiquetas.Tag     := ctPesquisaModeloEtiqueta;
  qryConsultaPlanos.Tag               := ctPesquisaTipoPlano;
  qryPlanosPagamento.Tag              := ctTabelas;
  qryConsultaClientes.Tag             := ctConsultaClientes;

  qryProcuraProdutosCadastro.ParamByName('filial').AsInteger :=  FilialBase;
  qryProcuraClientes.Params[0].AsString := 'C';
  qryProcuraFornecedoresNotas.Params[0].AsString := 'F';

  qryEtiquetas.Sql.Text:= qryEtiquetasProdutos.Sql.Text;
//  qryEtiquetas.Params[0].AsInteger := FilialBase;
//linha abaixo comentada, abertura do modulo lenta
//  qryEtiquetas.Sql[24] := ' AND FALSE ';

//qryEtiquetas.macrobyname('LFrom').asString := LFrom;
//qryEtiquetas.macrobyname('Linha').asString := Linha22;
  qryEtiquetas.macrobyname('LWhere').asString := ' and false ';

  qryEtiquetas.parambyname('QuantidadeLote').asBoolean := false;
  qryEtiquetas.parambyname('lotetransferencia').asString := '0';
  qryEtiquetas.parambyname('QtdemEstoqueProdutosExposicao').asBoolean := true;
  qryEtiquetas.parambyname('QtdeZeradaProdutosExposicao').asBoolean := false;

  qryEtiquetas.Open;

  NrEtiquetas:= 1;


  qryProcuraSeries.Params[3].AsInteger   := FilialBase;
  qryConsultaSeries.Params[2].AsInteger   := FilialBase;


//  except
//     on E: Exception do ShowMessage(E.Message);
//  end;

end;

procedure TdtmEmissaoEtiquetas.Selecionar(TipoPesquisa: TTecPesquisa; Incluir: Boolean);
begin
  case TipoPesquisa of
            pesSERIES  : RefazConsulta(qryProcuraSeries, [1],[qryConsultaSeriesserie.AsString]);
            pesNOTAS   : RefazConsulta(qryProcuraNotas, [3], [qryConsultaNotasnumero.AsString]);
            pesGRUPOS  : RefazConsulta(qryProcuraGrupos, [0],[qryConsultaGruposCodigo.AsString]);
            pesCLASSES : RefazConsulta(qryProcuraClasses, [0],[qryConsultaClassesCodigo.AsString]);
            pesFILIAIS : if Incluir then begin
                           qryEtiquetas.Edit;
                           qryEtiquetasfilial.AsInteger:= qryConsultaFiliaisCodigo.AsInteger;
                         end else
                           RefazConsulta(qryProcuraFiliais, [0],[qryConsultaFiliaisCodigo.AsString]);

   pesFORNECEDORESNOTAS: RefazConsulta(qryProcuraFornecedoresNotas,[0,1],[qryConsultaFornecedoresNotastipo.AsString,
                                                                           qryConsultaFornecedoresNotasCodigo.AsString]);

pesFORNECEDORESPRODUTOS: RefazConsulta(qryProcuraFornecedoresProdutos, [0],[qryConsultaFornecedoresCodigo.AsString]);
pesFORNECEDORESPEDIDOS: RefazConsulta(qryProcuraFornecedoresPedidos, [0],[qryConsultaFornecedoresCodigo.AsString]);

            pesMARCAS  : RefazConsulta(qryProcuraMarcas, [0],[qryConsultaMarcasCodigo.AsString]);
     pesTIPOSMOVIMENTOS: ReFazConsulta(qryProcuraTipoMovto,[0],[qryConsultaTipoMovtoCodigo.AsString]);
      pesMODELOETIQUETA: ReFazConsulta(qryProcuraModelosEtiquetas,[0],[qryConsultaModelosEtiquetasCodigo.AsInteger]);
               pesPLANO: begin
                           ReFazConsulta(qryProcuraPlanos,[0],[qryConsultaPlanosCodigo.AsInteger]);
                         end;
            pesClientes: begin
                           ReFazConsulta(qryProcuraClientes,[0,1],[qryConsultaClientesTipo.AsString,
                                                                   qryConsultaClientesCodigo.AsInteger]);
  end;                   end;
end;

procedure TdtmEmissaoEtiquetas.AbreTabelaPesquisa(Tabela: TtecPesquisa);
begin
  case Tabela of
              pesSERIES         : Abre(ctPesquisaSerie);
              pesNOTAS          : Abre(ctPesquisaNota);
              pesGRUPOS         : Abre(ctPesquisaGrupo);
              pesCLASSES        : Abre(ctPesquisaClasse);
              pesFILIAIS        : Abre(ctPesquisaFilial);
     pesFORNECEDORESNOTAS       : begin
                                    qryConsultaFornecedoresNotas.MacroByName('branco').AsString := ' and False';
                                    Abre(ctPesquisaFornecedorNotas);
                                  end;
  pesFORNECEDORESPRODUTOS       : Abre(ctPesquisaFornecedorProdutos);
  pesFORNECEDORESPEDIDOS       : Abre(ctPesquisaFornecedorProdutos);  

              pesMARCAS         : Abre(ctPesquisaMarca);
       pesTIPOSMOVIMENTOS       : Abre(ctPesquisaTiposMovimentos);
       pesMODELOETIQUETA        : Abre(ctPesquisaModeloEtiqueta);
                pesPLANO        : Abre(ctPesquisaTipoPlano);
              pesCLIENTES       : begin
                                    qryConsultaClientes.MacroByName('branco').AsString := ' and False';
                                    qryConsultaClientes.Open;
                                  end;
                           
  end;
end;

procedure TdtmEmissaoEtiquetas.FechaTabelaPesquisa(Tabela: TtecPesquisa);
begin
  case Tabela of
            pesSERIES           : Fecha(ctPesquisaSerie);
            pesNOTAS            : Fecha(ctPesquisaNota);
            pesGRUPOS           : Fecha(ctPesquisaGrupo);
            pesCLASSES          : Fecha(ctPesquisaClasse);
            pesFILIAIS          : Fecha(ctPesquisaFilial);
   pesFORNECEDORESNOTAS         : Fecha(ctPesquisaFornecedorNotas);
pesFORNECEDORESPRODUTOS         : Fecha(ctPesquisaFornecedorProdutos);
pesFORNECEDORESPEDIDOS          : Fecha(ctPesquisaFornecedorProdutos);
            pesMARCAS           : Fecha(ctPesquisaMarca);
     pesTIPOSMOVIMENTOS         : Fecha(ctPesquisaTiposMovimentos);
      pesMODELOETIQUETA         : Fecha(ctPesquisaModeloEtiqueta);
              pesPlano          : Fecha(ctPesquisaTipoPlano);
            pesClientes         : qryConsultaClientes.Close;

  end;
end;

