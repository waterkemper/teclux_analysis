procedure TdtmEmissaoEtiquetas.qryEtiquetasFilterRecord(DataSet: TDataSet; var Accept:
Boolean);
begin
  inherited;
  if qryEtiquetasMarcar.Value then Accept:= True
                              else Accept:= False;
