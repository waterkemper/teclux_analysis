                                       if qryProcuraPlanosPrazoVenctoEntrada.AsInteger = 0
                                       then Linhas[4, Col]:= Linhas[4, Col] + '1 + ';
                                       Linhas[4, Col]:= Linhas[4, Col] + FStr(qryEtiquetasQtdeParcelas.AsInteger,$00) + ' DE"';
                                       Linhas[5, Col]:= 'A344,' + FStr(Y,$00) + ',1,5,2,1,N,"' + PreencheString('R$ ' + Trim(Format('%09.2n',[qryEtiquetasValorParcela.AsCurrency])),' ',12,False) + '"';

                                       Linhas[6, Col]:= 'A210,' + FStr(Y,    $00) + ',1,3,1,1,N,"OU"';
                                       Linhas[7, Col]:= 'A178,' + FStr(Y,    $00) + ',1,3,1,1,N,"A VISTA R$ ' + Trim(Format('%09.2n',[(1 - PercentualAVista/100) * qryEtiquetasPreco.AsCurrency])) + '"';
                                       Linhas[8, Col]:= 'A130,' + FStr(Y+208,$00) + ',1,3,1,1,N,"TAXA: ' + Trim(Format('%05.2n', [qryProcuraPlanosTaxaMensalJuros.AsFloat])) + '% a.m."';
                                       Linhas[9, Col]:= 'A98,'  + FStr(Y+208,$00) + ',1,3,1,1,N,"TOTAL A PRAZO:"';

                                       if qryProcuraPlanosTaxaMensalJuros.AsFloat = 0
                                       then PrecoPrazo:= (1 - PercentualAVista/100) * qryEtiquetasPreco.AsCurrency
                                       else PrecoPrazo:= qryEtiquetasTotalParcelas.AsCurrency;
                                       Linhas[10,Col]:= 'A66,' + FStr(Y+208,$00) + ',1,4,1,1,N,"' + PreencheString('R$ ' + Trim(Format('%09.2n',[PrecoPrazo])),' ',12,False) + '"';
                                    end
                                    else Linhas[5, Col]:= 'A354,' + FStr(Y,$00) + ',1,5,2,1,N,"' + PreencheString('R$ ' + Trim(Format('%09.2n',[(1 - PercentualAVista/100) * qryEtiquetasPreco.AsCurrency])),' ',12,False) + '"';

                               Linhas[11, Col]:= 'B130,' + FStr(Y,$00) +  ',1,1,2,2,80,B,"' + qryEtiquetasCodigoVisual.AsString + '"';

