procedure TdtmEmissaoEtiquetas.MarcarSelecionados(Marcando, Todos: Boolean; pagina: Integer);
begin
 if Pagina <> 3 then begin
    qryEtiquetas.DisableControls;
    MarcarRegistros(qryEtiquetas,qryEtiquetasMarcar,qryEtiquetasTotal, Marcando, Todos);
    qryEtiquetas.EnableControls;
 end
 else begin
    qryNotasSaidas.DisableControls;
    MarcarRegistros(qryNotasSaidas,qryNotasSaidasMarcarNotaSaida,qryNotasSaidasTotal,Marcando,Todos);
    qryNotasSaidas.EnableControls;
 end;
end;

procedure TdtmEmissaoEtiquetas.ImpressaoRABBIT(Tamanho: Byte);
var
  Coluna  : Integer;
  Col   : Byte;
  J      : Byte;
  Linha  : String;
  Linha1,Linha2,Linha3,Linha4,Linha5,Linha6,Linha7 : Array[1..3] of String;
  I      : Integer;
  Ref    : String;
  ValStr1: String;
  ValStr2: String;
  Y      : Byte;
begin
(* Paginas 50, 51, 52 do Manual
   Qualidade impressao pag: 38 Comando 'H'
   Velocidade impressao pag: 39 Comando 'P'
   Format Rthvoooyyyyxxxx onde:
     R = Print direction
     t = font type
     h = Horizontal scale       '190000100120420'
     v = Vertical scale
     ooo = sub font type
     yyyy = Y coordinate
     xxxx = X coordinate  *)

  Coluna:= qryProcuraMODELOSETIQUETASColuna.AsInteger;
  qryEtiquetas.DisableControls;

  if Coluna <> 3 then begin
     try
        qryEtiquetas.First;
        while not qryEtiquetas.Eof do begin

          if qryEtiquetasMarcar.AsBoolean then begin
            with TextPrinter do begin
              for I:= 1 to (15-Length(qryEtiquetasReferencia.AsString)) do
                  Ref:= Ref + ' ';

              Ref:= Ref + qryEtiquetasReferencia.AsString;

              for I:= 1 to qryEtiquetasQuantidadeProduto.Asinteger do begin
                  BeginDoc('');
                    WriteTextLn(STX+'m'+STX+'L'+'D11'+'H15'+'PE',0);
                    case Tamanho of
                      0: begin   //----------- ETIQUETA 1 GRANDE (ALCIDINO)
                           Linha:= '190000100720320' + Copy(qryEtiquetasDescricaoProdutoLC.AsString,1,18);
                           WriteTextLn(Linha,0);
                           Linha:= '190000100420320' + Copy(qryEtiquetasDescricaoProdutoLC.AsString,19,04);
                           WriteTextLn(Linha,0);
                           Linha:= '190000100420380' + Copy(Ref,01,15);
                           WriteTextLn(Linha,0);
                       //  Linha:= '190000100120320' + IntToStr(Mes) + '/' + Copy(IntToStr(Ano),3,2);
                       //  WriteTextLn(Linha,0);
                           Linha:= '190000100120320' + qryEtiquetasFatorPreco.AsString;
                           WriteTextLn(Linha,0);
                       //  Linha:= '190000200120400' + Format('%08.2f',[qryEtiquetasPRECO.AsCurrency]);

                           ValStr2 := '';
                           ValStr1 := qryEtiquetasPRECO.AsString;
                            for Y:=1 to Length(ValStr1) do begin
                                if ValStr1[y] = ',' then Break;
                                ValStr2 := ValStr2 + ValStr1[y];
                            end;

                           Linha:= '190000200120450' + ValStr2;
                           WriteTextLn(Linha,0);
                           Linha:= '1D5205000200040' + qryEtiquetasCodigoVisual.AsString;
                           WriteTextLn(Linha,0);
                         end;

                      1: begin  //----------- ETIQUETA 2 PEQUENA (ALCIDINO)
                           Linha:= '190000100650190' + Copy(qryEtiquetasDescricaoProdutoLC.AsString,1,12);
                           WriteTextLn(Linha,0);
                           Linha:= '190000100370190' + Copy(qryEtiquetasDescricaoProdutoLC.AsString,13,12);
                           WriteTextLn(Linha,0);
                           if qryEtiquetasFatorPreco.AsString = '' then qryEtiquetasFatorPreco.AsCurrency := 0;
                           Linha:= '190000100120190' + qryEtiquetasFatorPreco.AsString;
                           WriteTextLn(Linha,0);
              //           Linha:= '190000100120285' + Format('%08.2f',[qryEtiquetasPRECO.AsCurrency]);

                           ValStr2 := '';
                           ValStr1 := qryEtiquetasPRECO.AsString;
                            for Y:=1 to Length(ValStr1) do begin
                                if ValStr1[y] = ',' then Break;
                                ValStr2 := ValStr2 + ValStr1[y];
                            end;

                            Linha:= '190000100120285' + ValStr2;

                           WriteTextLn(Linha,0);
                           Linha:= '1D4205500100017' + qryEtiquetasCodigoVisual.AsString;
                           WriteTextLn(Linha,0);
                         end;
                    end;

                    WriteTextLn('E',0);
                    WriteTextLn(STX+'Q',0);
                  EndDoc('TecLUX - Imprimindo Etiqueta RABBIT');
              end;
            end;
          end;
          qryEtiquetas.Next;
        end;
      finally
        qryEtiquetas.EnableControls;
      end;
  end
  else begin   //---------- etiquetas com 3 Colunas --------------------------------------------------------
      try
        Col := 0;
        FillChar(Linha1,SizeOf(Linha1),0);    FillChar(Linha5,SizeOf(Linha5),0);
        FillChar(Linha2,SizeOf(Linha2),0);    FillChar(Linha6,SizeOf(Linha6),0);
        FillChar(Linha3,SizeOf(Linha3),0);    FillChar(Linha7,SizeOf(Linha7),0);
        FillChar(Linha4,SizeOf(Linha4),0);

        qryEtiquetas.First;
        while not qryEtiquetas.Eof do begin
          if qryEtiquetasMarcar.AsBoolean then begin
            with TextPrinter do begin

              for I:= 1 to qryEtiquetasQuantidadeProduto.AsInteger do begin
                    case Tamanho of
                      0: begin
                           //------ Filial ----------------------------------------------------------------------------------------------------------
                           Inc(Col);
                           if Col = 1 then Linha1[Col]:='190000204000040' + Copy(NomeFilialBase,1,15)
                           else
                           if Col = 2 then Linha1[Col]:='190000204000400' + Copy(NomeFilialBase,1,15)
                           else
                           if Col = 3 then Linha1[Col]:='190000204000760' + Copy(NomeFilialBase,1,15);
                           //------ Descrição do Produto (duas linhas )------------------------------------------------------------------------------
                           if Col = 1 then Linha2[Col] := '190000103400040' + Copy(qryEtiquetasDescricaoProdutoLC.AsString,1,20)
                           else
                           if Col = 2 then Linha2[Col] := '190000103400400' + Copy(qryEtiquetasDescricaoProdutoLC.AsString,1,20)
                           else
                           if Col = 3 then Linha2[Col] := '190000103400760' + Copy(qryEtiquetasDescricaoProdutoLC.AsString,1,20);
                           if Col = 1 then Linha3[Col] := '190000103100040' + Copy(qryEtiquetasDescricaoProdutoLC.AsString,21,40)
                           else
                           if Col = 2 then Linha3[Col] := '190000103100400' + Copy(qryEtiquetasDescricaoProdutoLC.AsString,21,40)
                           else
                           if Col = 3 then Linha3[Col] := '190000103100760' + Copy(qryEtiquetasDescricaoProdutoLC.AsString,21,40);
                           //------ Codigo do Produto ------------------------------------------------------------------------------------------------
                           if Col = 1 then Linha4[Col] := '190000302650060' +  qryEtiquetasCodigoVisual.AsString
                           else
                           if Col = 2 then Linha4[Col] := '190000302650450' +  qryEtiquetasCodigoVisual.AsString
                           else
                           if Col = 3 then Linha4[Col] := '190000302650810' +  qryEtiquetasCodigoVisual.AsString;
                           //------ Codigo de Barra -------------------------------------------------------------------------------------------------
                           if Col = 1 then Linha5[Col] := '1D5209001500060' + qryEtiquetasCodigoVisual.AsString
                           else       //E,B,C,A,F,G,H,I,J,K,L,M,N,O,
                           if Col = 2 then Linha5[Col] := '1D5209001500450' + qryEtiquetasCodigoVisual.AsString
                           else
                           if Col = 3 then Linha5[Col] := '1D5209001500810' + qryEtiquetasCodigoVisual.AsString;
                           //------ Codigo do Produto -----------------------------------------------------------------------------------------------
                           if Col = 1 then Linha6[Col] := '190000301100060' + qryEtiquetasCodigoVisual.AsString
                           else
                           if Col = 2 then Linha6[Col] := '190000301100450' + qryEtiquetasCodigoVisual.AsString
                           else
                           if Col = 3 then Linha6[Col] := '190000301100810' + qryEtiquetasCodigoVisual.AsString;
                           //------ Preço ------------------------------------------------------------------------------------------------------------
                           if Col = 1 then Linha7[Col] := '190000300300040' + 'R$ ' + Format('%10.2f',[qryEtiquetasPRECO.AsCurrency])
                           else
                           if Col = 2 then Linha7[Col] := '190000300300400' + 'R$ ' + Format('%10.2f',[qryEtiquetasPRECO.AsCurrency])
                           else
                           if Col = 3 then Linha7[Col] := '190000300300760' + 'R$ ' + Format('%10.2f',[qryEtiquetasPRECO.AsCurrency]);

                           if Col = 3 then begin
                              BeginDoc('');
                                WriteTextLn(STX+'m'+STX+'L'+'D11'+'H15'+'PE',0);
                                Col := 0;
                                for J := 1 to 3 do   WriteTextLn(Linha1[J],0);
                                for J := 1 to 3 do   WriteTextLn(Linha2[J],0);
                                for J := 1 to 3 do   WriteTextLn(Linha3[J],0);
                                for J := 1 to 3 do   WriteTextLn(Linha4[J],0);
                                for J := 1 to 3 do   WriteTextLn(Linha5[J],0);
                                for J := 1 to 3 do   WriteTextLn(Linha6[J],0);
                                for J := 1 to 3 do   WriteTextLn(Linha7[J],0);

                                WriteTextLn('E',0);
                                WriteTextLn(STX+'Q',0);
                                EndDoc('TecLUX - Imprimindo Etiqueta RABBIT');

                                FillChar(Linha1,SizeOf(Linha1),0);
                                FillChar(Linha2,SizeOf(Linha2),0);
                                FillChar(Linha3,SizeOf(Linha3),0);
                                FillChar(Linha4,SizeOf(Linha4),0);
                                FillChar(Linha5,SizeOf(Linha5),0);
                                FillChar(Linha6,SizeOf(Linha6),0);
                                FillChar(Linha7,SizeOf(Linha7),0);
                             end;
                         end;

                      1: begin
                           BeginDoc('');
                             WriteTextLn(STX+'m'+STX+'L'+'D11'+'H15'+'PE',0);
                             Linha:= '190000100900018' + qryEtiquetasCodigoVisual.AsString;
                             WriteTextLn(Linha,0);
                             Linha:= '190000100800435' + Copy(qryEtiquetasDescricaoProdutoLC.AsString,01,13);
                             WriteTextLn(Linha,0);
                             Linha:= '190000100540435' + Copy(qryEtiquetasDescricaoProdutoLC.AsString,14,13);
                             WriteTextLn(Linha,0);
                             Linha:= '190000100340435' + Copy(qryEtiquetasDescricaoProdutoLC.AsString,27,13);
                             WriteTextLn(Linha,0);
                             Linha:= '1D4205500100018' + qryEtiquetasCodigoVisual.AsString;
                             WriteTextLn(Linha,0);
                             Linha:= '190000100050435' + 'R$ ' + Format('%10.2f',[qryEtiquetasPRECO.AsCurrency]);
                             WriteTextLn(Linha,0);

                             WriteTextLn('E',0);
                             WriteTextLn(STX+'Q',0);
                           EndDoc('TecLUX - Imprimindo Etiqueta RABBIT');
                         end;
                    end;
              end;
            end;
          end;
          qryEtiquetas.Next;
        end;

        if (Linha1[1] <> '') and (TAMANHO = 0) then begin
           with TextPrinter do begin
              BeginDoc('');
                WriteTextLn(STX+'m'+STX+'L'+'D11'+'H15'+'PE',0);
                for J := 1 to 3 do   WriteTextLn(Linha1[J],0);
                for J := 1 to 3 do   WriteTextLn(Linha2[J],0);
                for J := 1 to 3 do   WriteTextLn(Linha3[J],0);
                for J := 1 to 3 do   WriteTextLn(Linha4[J],0);
                for J := 1 to 3 do   WriteTextLn(Linha5[J],0);
                for J := 1 to 3 do   WriteTextLn(Linha6[J],0);
                for J := 1 to 3 do   WriteTextLn(Linha7[J],0);
                WriteTextLn('E',0);
                WriteTextLn(STX+'Q',0);
              EndDoc('TecLUX - Imprimindo Etiqueta RABBIT');
           end;
        end;
      finally
        qryEtiquetas.EnableControls;
      end;
  end
end;

//--------- Impressora ARGOX O-214 PLUS ----------------------------------------
procedure TdtmEmissaoEtiquetas.ImpressaoARGOX(Tamanho: Byte);
var Linhas:     array[1..20, 1..3] of string; {20 linhas e 3 Colunas}
    Ref:        string;
    Col, NP, X: integer;
    CodProduto: string;
    Fornecedor: string;
    Buffer:     string;


   procedure ImprimirLinhas;
   var NL, NC: byte;
   begin
      with TextPrinter do begin
         BeginDoc('');
            WriteTextLn(STX + 'm'     + // Utilizar sistema métrico
                        STX + 'e'     + // Habilita o sensor de Gap
                        STX + 'M0600' + // Fixa o tamanho máximo da etiqueta
                        STX + 'L'     + // Ativação do estado de formatação de etiquetas
                        STX + 'C0000' + // Este comando fixa a margem esquerda
                        'D11'         + // Define a largura e altura do tamanho do pixel
                        'H15'         + // Define a qualidade da imagem (H00-H20)
                        'PE', 0);       // Define a velocidade de impressão (E = 3.0 ips)

            for NC:= 1 to qryProcuraModelosEtiquetasColuna.AsInteger do begin
//              if qryProcuraModelosEtiquetasTipo.AsString = 'LG' then begin
//                 WriteTextLn(STX + 'IAAF
//              end;

                for NL:= 1 to 20 do begin
                    if Linhas[NL, NC] <> ''
                    then WriteTextLn(Linhas[NL, NC],0);
                end;
            end;

            WriteTextLn('E', 0);       // Sai do modo de formatação de etiquetas
            WriteTextLn(STX + 'Q', 0); // Limpa a memória
         EndDoc('tecLUX - Imprimindo Etiqueta ARGOX');
         Col := 0;  FillChar(Linhas,SizeOf(Linhas),0);
      end;
   end; {ImprimirLinhas}



begin

//  NrColunas:= qryProcuraModelosEtiquetasColuna.AsInteger;
   NomeImpressoraEscolhida := ParSistema.NomeImpressoraEtiqueta;
   qryEtiquetas.DisableControls;

   {---------------------------------------------------------------------------------- MARIAH SÁ --}
   if qryProcuraModelosEtiquetasTipo.AsString = 'MS' then begin
      case qryProcuraModelosEtiquetasColuna.AsInteger of
      3: begin
            try
               Col := 0;    FillChar(Linhas,SizeOf(Linhas),0);
               qryEtiquetas.First;
               while not qryEtiquetas.EOF do begin
                  if qryEtiquetasMarcar.AsBoolean then with TextPrinter do begin

                     for NP:= 1 to qryEtiquetasQuantidadeProduto.AsInteger do begin
                         Inc(Col);
                         case Col of
                            1: X:=  60;
                            2: X:= 410;
                            3: X:= 760;
                         end;

                         // r    = Direção de impressão
                         // t    = Tipo de fonte
                         // h    = Escala horizontal
                         // v    = Escala vertical
                         // ooo  = Tipo de sub-fonte
                         // yyyy = Ordenada y
                         // xxxx = ordenada x

                                        // rthvoooyyyy         xxxx
                         Linhas[1, Col]:= '19000010172' + FStr(X,    $41) + Copy(qryEtiquetasDescricaoProdutoLC.AsString, 1,25);
                         Linhas[2, Col]:= '19000010148' + FStr(X,    $41) + Copy(qryEtiquetasDescricaoProdutoLC.AsString,26,25);
                         Linhas[3, Col]:= '19000010110' + FStr(X,    $41) + Copy(qryEtiquetasReferencia.AsString,1,15);
                         Linhas[4, Col]:= '19000010110' + FStr(X+200,$41) + FStr(MonthOf(DataServidor),$21) + '/' + FStr(YearOf(DataServidor),$41);
                         Linhas[5, Col]:= '1D520500020' + FStr(X,    $41) + qryEtiquetasCodigoVisual.AsString;
                         if ImprimirPreco then begin
                            Linhas[6, Col]:= '19000020060' + FStr(X+190,$41) + qryEtiquetasFatorPreco.AsString;
                            Linhas[7, Col]:= '19000020030' + FStr(X+180,$41) + Format('%08.2n',[(1 - PercentualAVista/100) * qryEtiquetasPreco.AsCurrency]);
                         end;
                         if Col = 3 then ImprimirLinhas;
                     end;
                  end;
                  qryEtiquetas.Next;
               end;

               if Linhas[1, 1] <> '' then ImprimirLinhas;

            finally
               qryEtiquetas.EnableControls;
            end;
         end;
      end;
   end
   else
   {--------------------------------------------------------------------- MARIAH SÁ - Leguminhos --}
   if qryProcuraModelosEtiquetasTipo.AsString = 'LG' then begin
      case qryProcuraModelosEtiquetasColuna.AsInteger of
      3: begin
            try
               Col := 0;    FillChar(Linhas,SizeOf(Linhas),0);
               qryEtiquetas.First;
               while not qryEtiquetas.EOF do begin
                  if qryEtiquetasMarcar.AsBoolean then with TextPrinter do begin

                     for NP:= 1 to qryEtiquetasQuantidadeProduto.AsInteger do begin
                         Inc(Col);
                         case Col of
                            1: X:=  60;
                            2: X:= 410;
                            3: X:= 760;
                         end;

                         // r    = Direção de impressão
                         // t    = Tipo de fonte
                         // h    = Escala horizontal
                         // v    = Escala vertical
                         // ooo  = Tipo de sub-fonte
                         // yyyy = Ordenada y
                         // xxxx = ordenada x

                                        // rthvoooyyyy         xxxx
                         Linhas[1, Col]:= '19000010172' + FStr(X,    $41) + Copy(qryEtiquetasDescricaoProdutoLC.AsString, 1,25);
                         Linhas[2, Col]:= '19000010148' + FStr(X,    $41) + Copy(qryEtiquetasDescricaoProdutoLC.AsString,26,25);
                         Linhas[3, Col]:= '19000010110' + FStr(X,    $41) + 'P. Líquido: ' + Format('%05.2n', [qryEtiquetasPeso.AsCurrency]);
                         Linhas[4, Col]:= '19000010080' + FStr(X+200,$41) + 'Fabricação: ' + fDataFabricacao;
                         Linhas[5, Col]:= '19000010050' + FStr(X,    $41) + 'Validade:   ' + fDataValidade;
                         Linhas[6, Col]:= '1D520500020' + FStr(X,    $41) + qryEtiquetasCodigoVisual.AsString;
//                       if ImprimirPreco then begin
//                          Linhas[6, Col]:= '19000020060' + FStr(X+190,$41) + qryEtiquetasFatorPreco.AsString;
//                          Linhas[7, Col]:= '19000020030' + FStr(X+180,$41) + Format('%08.2n',[(1 - PercentualAVista/100) * qryEtiquetasPreco.AsCurrency]);
//                       end;
                         if Col = 3 then ImprimirLinhas;
                     end;
                  end;
                  qryEtiquetas.Next;
               end;

               if Linhas[1, 1] <> '' then ImprimirLinhas;

            finally
               qryEtiquetas.EnableControls;
            end;
         end;
      end;
   end
   else
   {----------------------------------------------------------------------------- Shopping KILAR --}
   if qryProcuraModelosEtiquetasTipo.AsString = 'K' then begin
      case qryProcuraModelosEtiquetasColuna.AsInteger of
      2: begin
            try
               Col := 0;    FillChar(Linhas,SizeOf(Linhas),0);
               qryEtiquetas.First;
               while not qryEtiquetas.EOF do begin
                  if qryEtiquetasMarcar.AsBoolean then with TextPrinter do begin

                     for NP:= 1 to qryEtiquetasQuantidadeProduto.AsInteger do begin
                         Inc(Col);
                         case Col of
                            1: X:=  50;
                            2: X:= 600;
                         end;

                         // r    = Direção de impressão
                         // t    = Tipo de fonte
                         // h    = Escala horizontal
                         // v    = Escala vertical
                         // ooo  = Tipo de sub-fonte
                         // yyyy = Ordenada y
                         // xxxx = ordenada x


                         Fornecedor:= FStr(qryEtiquetasCodigoFornecedor.AsInteger,$00);
                         CodProduto:= qryEtiquetasCodigoVisual.AsString;
                         CodProduto:= PreencheString(CodProduto,' ',25-Length(Fornecedor),True) + Fornecedor;

                                        // rthvoooyyyy         xxxx
                         Linhas[1, Col]:= '12000010600' + FStr(X,   $41) + Copy(qryEtiquetasDescricaoProdutoLC.AsString, 1,18);
                         Linhas[2, Col]:= '12000010100' + FStr(X,   $41) + Copy(qryEtiquetasDescricaoProdutoLC.AsString,19,18);
                         Linhas[3, Col]:= '12000010120' + FStr(X,   $41) + CenDirEsq(qryEtiquetasReferencia.AsString,10,' ','E');
                         Linhas[4, Col]:= '12000000210' + FStr(X,   $41) + Trim(Copy(qryEtiquetasCodigoBarras. AsString,1,13));
                         Linhas[5, Col]:= '1d520502800' + FStr(X,   $41) + qryEtiquetasCodigoVisual.AsString;
                         if ImprimirPreco then begin
                            Linhas[6, Col]:= '13000020180' + FStr(X, $41) + PreencheString('R$ ' + Trim(Format('%08.2n',[(1 - PercentualAVista/100) * qryEtiquetasPreco.AsCurrency])),' ',19,False);
                         end;
                         if Col = qryProcuraModelosEtiquetasColuna.AsInteger then ImprimirLinhas;
                     end;
                  end;
                  qryEtiquetas.Next;
               end;

               if Linhas[1, 1] <> '' then ImprimirLinhas;

            finally
               qryEtiquetas.EnableControls;
            end;
         end;
      end;
   end
   else
   {--------------------------------------------------------------- Basílica de Nazaré (50 x 30 mm)}
   if qryProcuraModelosEtiquetasTipo.AsString = 'NZ' then begin
      case qryProcuraModelosEtiquetasColuna.AsInteger of
      2: begin
            try
               Col := 0;    FillChar(Linhas,SizeOf(Linhas),0);
               qryEtiquetas.First;
               while not qryEtiquetas.EOF do begin
                  if qryEtiquetasMarcar.AsBoolean then with TextPrinter do begin

                     for NP:= 1 to qryEtiquetasQuantidadeProduto.AsInteger do begin
                         Inc(Col);
                         case Col of
                            1: X:=  50;
                            2: X:= 600;
                         end;

                         // r    = Direção de impressão
                         // t    = Tipo de fonte
                         // h    = Escala horizontal
                         // v    = Escala vertical
                         // ooo  = Tipo de sub-fonte
                         // yyyy = Ordenada y
                         // xxxx = ordenada x


                         Fornecedor:= FStr(qryEtiquetasCodigoFornecedor.AsInteger,$00);
                         CodProduto:= qryEtiquetasCodigoVisual.AsString;
                         CodProduto:= PreencheString(CodProduto,' ',25-Length(Fornecedor),True) + Fornecedor;

                                        // rthvoooyyyy         xxxx

                         Linhas[1, Col]:= '12000010240' + FStr(X,   $41) +      Copy(qryEtiquetasDescricaoProdutoLC.AsString, 1,26);
                         Linhas[2, Col]:= '12000010200' + FStr(X,   $41) +      Copy(qryEtiquetasDescricaoProdutoLC.AsString,27,26);
                         Linhas[3, Col]:= '12000010160' + FStr(X,   $41) + CenDirEsq(qryEtiquetasReferencia.        AsString,10,' ','E') +
                                                                           CenDirEsq(qryEtiquetasCodigoBarras.      AsString,13,' ','D');
                         Linhas[4, Col]:= '12000000160' + FStr(X,   $41) + CodProduto;
                         Linhas[5, Col]:= '12000010120' + FStr(X,   $41) + FStr(MonthOf(DataServidor),$21) + '/' + FStr(YearOf(DataServidor),$41);
                         Linhas[6, Col]:= '1d630700015' + FStr(X+90,$41) + qryEtiquetasCodigoVisual.AsString;
                         if ImprimirPreco then begin
                            Linhas[7, Col]:= '13000020090' + FStr(X, $41) + PreencheString('R$ ' + Trim(Format('%08.2n',[(1 - PercentualAVista/100) * qryEtiquetasPreco.AsCurrency])),' ',19,False);
                         end;
                         if Col = qryProcuraModelosEtiquetasColuna.AsInteger then ImprimirLinhas;
                     end;
                  end;
                  qryEtiquetas.Next;
               end;

               if Linhas[1, 1] <> '' then ImprimirLinhas;

            finally
               qryEtiquetas.EnableControls;
            end;
         end;
      end;
   end
   else
   {---------------------------------------------------------- Planeta das Gêmeas (2 x 40x55 mm) --}
   if qryProcuraModelosEtiquetasTipo.AsString = 'PG' then begin
      case qryProcuraModelosEtiquetasColuna.AsInteger of
      2: begin
            try
               Col := 0;    FillChar(Linhas,SizeOf(Linhas),0);
//             LerArquivo(ExtractFilePath(Application.ExeName) + 'LogoPlanetalogo.bmp',Buffer);

               qryEtiquetas.First;
               while not qryEtiquetas.EOF do begin
                  if qryEtiquetasMarcar.AsBoolean then with TextPrinter do begin

                     for NP:= 1 to qryEtiquetasQuantidadeProduto.AsInteger do begin
                         Inc(Col);
                         case Col of
                            1: X:=  80;
                            2: X:= 480;
                         end;

                         // r    = Direção de impressão
                         // t    = Tipo de fonte
                         // h    = Escala horizontal
                         // v    = Escala vertical
                         // ooo  = Tipo de sub-fonte
                         // yyyy = Ordenada y
                         // xxxx = ordenada x
{
191200104000080BLUSA BASICA ML.........5
191200100600080BLUSA BASICA ML.........5
191200103500080BLUSA BASICA ML.........5
191200100100080BLUSA BASICA ML.........5
192200103000080       2501
1D52050010000802501
192200102500080           R$ 51,15
192200101200080           R$ 51,15
191200104000480BLUSA BASICA ML.........5
191200100600480BLUSA BASICA ML.........5
191200103500480BLUSA BASICA ML.........5
191200100100480BLUSA BASICA ML.........5
192200103000480       2501
1D52050010004802501
192200102500480           R$ 51,15
192200101200480           R$ 51,15
}
                                        // rthvoooyyyy         xxxx
                         Linhas[1, Col]:= '19120010400' + FStr(X,$41) + Copy(qryEtiquetasDescricaoProdutoLC.AsString, 1,25);
                         Linhas[2, Col]:= '19120010060' + FStr(X,$41) + Copy(qryEtiquetasDescricaoProdutoLC.AsString, 1,25);

                         Linhas[3, Col]:= '19120010350' + FStr(X,$41) + Copy(qryEtiquetasDescricaoProdutoLC.AsString,26,25);
                         Linhas[4, Col]:= '19120010010' + FStr(X,$41) + Copy(qryEtiquetasDescricaoProdutoLC.AsString,26,25);

                         Linhas[5, Col]:= '19220010300' + FStr(X,$41) + CenDirEsq(Copy(qryEtiquetasCodigoVisual.AsString,1,15),16,' ','C');
                         Linhas[6, Col]:= '1D520500100' + FStr(X,$41) + qryEtiquetasCodigoVisual.AsString;
                         if ImprimirPreco then begin
                            Linhas[7, Col]:= '19220010250' + FStr(X,$41) + PreencheString('R$ ' + Trim(Format('%08.2n',[(1 - PercentualAVista/100) * qryEtiquetasPreco.AsCurrency])),' ',19,False);
                            Linhas[8, Col]:= '19220010120' + FStr(X,$41) + PreencheString('R$ ' + Trim(Format('%08.2n',[(1 - PercentualAVista/100) * qryEtiquetasPreco.AsCurrency])),' ',19,False);
                         end;
                         if Col = 2 then ImprimirLinhas;
                     end;
                  end;
                  qryEtiquetas.Next;
               end;

               if Linhas[1, 1] <> '' then ImprimirLinhas;

            finally
               qryEtiquetas.EnableControls;
            end;
         end;
      end;
   end;
end;



//--------- Impressora Zebra TLP 2844 ----------------------------

{=============== D I C A   I M P O R T A N T E ==================}
{                                                                }
{ Nas impressoras ZEBRA, todas as medidas são em dots, sendo que }
{ 1 mm = 8 dots.                                                 }

procedure TdtmEmissaoEtiquetas.ImpressaoZebraTLP2844(Tamanho: Byte; NumeroAba: Integer);
var
  NE,I,J   : Integer;    NumCliente: Integer;  NotasStr: String;
  V        : Integer;
  Ref      : String;
  ValStr1  : String;
  ValStr2  : String;
  ValStr2Espaco: String;
  PrecoPrazo: Currency;

  Tipo     : String;
  Esquerdo,Meio,FlagNota,Primeira : Boolean;
  Buffer,Buffer1,Obs, obs1: String;

  MaisY1, MaisY2: byte;
  Col, NL, NC:    byte;
  NrLinhas:       byte;
  X, Y, NP:       integer;
  Linhas: array[1..11,1..3] of string; {7 linhas e 3 Colunas}

begin

   NomeImpressoraEscolhida:= ParSistema.NomeImpressoraEtiqueta;
   Tipo    := qryProcuraModelosEtiquetasTipo.AsString;
   Esquerdo:= True;

   if Tipo = 'J' then begin {--------------------------------------------------------------- Joalheria e Ótica ALCIDINO}
      try
         qryEtiquetas.First;
         while not qryEtiquetas.Eof do begin
            if qryEtiquetasMarcar.AsBoolean then with TextPrinter do begin
                Ref:= CenDirEsq(qryEtiquetasReferencia.AsString,15,' ','E');
                for I:= 1 to qryEtiquetasQuantidadeProduto.AsInteger do begin
                    BeginDoc('', False);
                    case Tamanho of

{
N
q760
Q80,24
S3
D7
ZB
A20,6,0,2,1,2,N,"   R$ 163,40    "
A20,40,0,2,1,2,N,"   461757500    "
A240,0,0,1,1,1,N,"BR 750ML ZIRC"
A240,15,0,1,1,1,N,""
A260,15,0,1,1,1,N,"BR 541-0,9GR"
A240,40,0,1,1,1,N,"AU"
A315,35,0,1,2,2,N,"   19"
P1
}


                       0: begin {--------------------------------------- Etiqueta 1 GRANDE - Joalheria e Ótica ALCIDINO}
                             WriteTextLn('N',      0);
                             WriteTextLn('q760',   0);
                             WriteTextLn('Q80,24', 0);
                             WriteTextLn('S3',     0);
                             WriteTextLn('D' + FStr(ParSistema.IntensidadeImpressaoZebra,$00),0);
                             WriteTextLn('ZB',     0);

                             {----------------------------------------- No modelo anterior, imprimia o Código de Barras}
//                           WriteTextLn('B40,0,0,3,1,3,40,B,"' + qryEtiquetasCodigoVisual.AsString + '"',0);

                             {--------------------------------------- Atualmente, imprime o preço do produto e o código}
                             if ImprimirPreco
                             then WriteTextLn('A20,6,0,2,1,2,N,"'   + CenDirEsq('R$ ' + Trim(Format('%-10.2n',[qryEtiquetasPrecoReal.ASCurrency])),16,' ','C') + '"', 0);
                             {WriteTextLn('A20,40,0,2,1,2,N,"'  + CenDirEsq(FStr(qryEtiquetasCodigo.AsInteger,$00),16,' ','C') + '"', 0);}
                             WriteTextLn('A20,40,0,2,1,2,N,"'  + CenDirEsq(qryEtiquetasCodigoVisual.AsString,16,' ','C') + '"', 0);

                             WriteTextLn('A240,0,0,1,1,1,N,"'  + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''), 1,18) + '"', 0);
                             WriteTextLn('A240,15,0,1,1,1,N,"' + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),19,18) + '"', 0);
                             WriteTextLn('A260,15,0,1,1,1,N,"' + Copy(qryEtiquetasReferencia.AsString ,1,15) + '"',0);
                             WriteTextLn('A240,40,0,1,1,1,N,"' + qryEtiquetasFatorPreco.AsString + '"',0);

                             ValStr2 := '';
                             ValStr1 := qryEtiquetasPRECO.AsString;
                             for Y:=1 to Length(ValStr1) do begin
                                 if ValStr1[y] = ',' then Break;
                                 ValStr2 := ValStr2 + ValStr1[y];
                             end;


                             //jr - Para completar 5 caracteres com espaços
                             ValStr2Espaco:='';
                             for V:= 1 to (5-Length(ValStr2)) do
                                 ValStr2Espaco:= ' ' + ValStr2Espaco;
                             ValStr2:= ValStr2Espaco + ValStr2;

                             WriteTextLn('A315,35,0,1,2,2,N,"' + ValStr2 + '"', 0);
                             WriteTextLn('P1', 0);
                          end;

                       1: begin {-------------------------------------- Etiqueta 1 PEQUENA - Joalheria e Ótica ALCIDINO}
                             WriteTextLn(#13,      0);                                         
                             WriteTextLn('N',      0);
                             WriteTextLn('q560',   0);
                             WriteTextLn('Q80,24', 0);
                             WriteTextLn('S3',     0);
                             WriteTextLn('ZB',     0);

                             WriteTextLn('B40,18,0,1,1,2,30,N,"' + qryEtiquetasCodigoVisual.AsString + '"', 0);
                             WriteTextLn('A150,20,0,1,1,1,N,"'   + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''), 1,12) + '"', 0);
                             WriteTextLn('A150,40,0,1,1,1,N,"'   + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),13,12) + '"', 0);

                             if qryEtiquetasFatorPreco.AsString = '' then qryEtiquetasFatorPreco.AsCurrency := 0;

                             WriteTextLn('A150,63,0,1,1,1,N,"' +qryEtiquetasFatorPreco.AsString + '"', 0);

                             ValStr2 := '';
                             ValStr1 := qryEtiquetasPRECO.AsString;
                             for Y:=1 to Length(ValStr1) do begin
                                 if ValStr1[y] = ',' then Break;
                                 ValStr2 := ValStr2 + ValStr1[y];
                             end;

                             WriteTextLn('A220,53,0,1,2,2,N,"'   +ValStr2 + '"', 0);
                             WriteTextLn('A40,53,0,1,1,2,N,"'    +qryEtiquetasCodigoVisual.AsString + '"', 0);
                             WriteTextLn('P1', 0);
                          end;
                    end;
                    EndDoc('TecLUX - Imprimindo Etiqueta ZEBRA TLP 2844');
                end;
            end;
            qryEtiquetas.Next;
         end;
      finally
         qryEtiquetas.EnableControls;
      end;
  end
  else
  if Tipo = 'JV'  then begin     //----- ALCIDINO------
     try
        qryEtiquetas.First;
        while not qryEtiquetas.Eof do begin
          if qryEtiquetasMarcar.AsBoolean then begin
            with TextPrinter do begin
              Ref:='';
              for I:= 1 to (15-Length(qryEtiquetasReferencia.AsString)) do
                  Ref:= Ref + ' ';

              Ref:= Ref + qryEtiquetasReferencia.AsString;
              for I:= 1 to qryEtiquetasQuantidadeProduto.AsInteger do
              begin
                BeginDoc('');
                WriteTextLn(#13,0);
                WriteTextLn('N'      + #13,0);
                WriteTextLn('q560'   +#13,0);
                WriteTextLn('Q80,24' + #13,0);
                WriteTextLn('S3'     + #13,0);
                WriteTextLn('ZB'     + #13,0);
                WriteTextLn('B40,18,0,1,1,2,30,N,"'  + qryEtiquetasCodigoVisual.AsString+'"' + #13,0);
                WriteTextLn('A40,53,0,1,1,2,N,"'    + qryEtiquetasCodigoVisual.AsString +'"' + #13,0);
                if qryEtiquetasFatorPreco.AsString = '' then
                  qryEtiquetasFatorPreco.AsCurrency := 0;
                if ImprimirPreco
                then WriteTextLn('A160,40,0,1,1,3,N,"R$' +Format('%07.2f',[qryEtiquetasPreco.ASCurrency])+'"' + #13,0);
                WriteTextLn('P1' + #13,0);
                EndDoc('TecLUX - Imprimindo Etiqueta ZEBRA TLP 2844');
              end;
            end;
          end;
          qryEtiquetas.Next;
        end;
      finally
        qryEtiquetas.EnableControls;
      end;
  end
  else
  if Tipo = 'AN'  then with TextPrinter do begin     //----- ANDRA------
     try
        BeginDoc('');
        qryEtiquetas.First;
        while not qryEtiquetas.Eof do
        begin
          if qryEtiquetasMarcar.AsBoolean then
          begin
               NE:= 1;
               While NE <= qryEtiquetasQuantidadeProduto.AsInteger do
               Begin
                 If Esquerdo Then
                 begin
                    WriteTextLn(#13,0);
                    WriteTextLn('N'      + #13,0);
                    WriteTextLn('q720'   +#13,0);
                    WriteTextLn('Q144,24' + #13,0);
                    WriteTextLn('S2'     + #13,0);
                    WriteTextLn('ZB'     + #13,0);
                    WriteTextLn('A10,5,0,1,1,2,N,"'  + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),1,34)+'"' + #13,0);
                    WriteTextLn('A10,30,0,1,1,2,N,"'  + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),35,6)+'"' + #13,0);
                    WriteTextLn('B10,60,0,1,2,5,35,N,"'  + qryEtiquetasCodigoVisual.AsString +'"' + #13,0);
                    WriteTextLn('A15,100,0,2,1,2,N,"'    + qryEtiquetasCodigoVisual.AsString +'"' + #13,0);
                    WriteTextLn('A230,60,0,2,1,2,N,"R$' +Format('%07.2f',[qryEtiquetasPreco.ASCurrency])+'"' + #13,0);
                 end
                 else
                 begin
                    WriteTextLn('A370,5,0,1,1,2,N,"'  + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),1,34)+'"' + #13,0);
                    WriteTextLn('A370,30,0,1,1,2,N,"'  + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),35,6)+'"' + #13,0);
                    WriteTextLn('B370,60,0,1,2,5,35,N,"'  + qryEtiquetasCodigoVisual.AsString +'"' + #13,0);
                    WriteTextLn('A375,100,0,2,1,2,N,"'    + qryEtiquetasCodigoVisual.AsString +'"' + #13,0);
                    WriteTextLn('A590,60,0,2,1,2,N,"R$' +Format('%07.2f',[qryEtiquetasPreco.ASCurrency])+'"' + #13,0)
                 end;
                 If not Esquerdo Then
                   WriteTextLn('P1' + #13,0);
                 Inc(NE);
                 Esquerdo:= not Esquerdo
              end;
          end;
          qryEtiquetas.Next;
        end;
        If not Esquerdo Then
          WriteTextLn('P1' + #13,0);
        EndDoc('TecLUX - Imprimindo Etiqueta ZEBRA TLP 2844');
      finally
        qryEtiquetas.EnableControls;
      end;
  end
  else
  if Tipo='A1' then  //ANDRA 3 ColunaS
     With TextPrinter do
       Begin
         Try
           qryEtiquetas.First;
           BeginDoc('', False);
           While not qryEtiquetas.Eof do
           Begin
             If qryEtiquetasMarcar.AsBoolean Then Begin
               NE:= 1;
               While NE <= qryEtiquetasQuantidadeProduto.AsInteger do
               Begin
                 If qryEtiquetasTotal.AsCurrency = 0
                 Then PrecoPrazo:= qryEtiquetasPreco.AsCurrency
                 Else PrecoPrazo:= qryEtiquetasTotal.AsCurrency;

                 Case Tamanho Of
                   0,1: If Esquerdo Then Begin
                           WriteTextLn('N',         0);
                           WriteTextLn('q880',      0);
                           WriteTextLn('Q392,24+0', 0);
                           WriteTextLn('S2',        0);
                           WriteTextLn('D' + FStr(ParSistema.IntensidadeImpressaoZebra,$00),0);
                           WriteTextLn('ZB',        0);
                           WriteTextLn('TTh:m',     0);
                           WriteTextLn('TDy2.mn.dd',0);
                           WriteTextLn('O',         0);
                           WriteTextLn('A10,56,0,3,1,1,N,"'      + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''), 1,16) + '"' + #13,0);
                           WriteTextLn('A10,86,0,3,1,1,N,"'      + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),17,16) + '"' + #13,0);
                           WriteTextLn('A10,116,0,3,1,1,N,"'      + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),33,18) + '"' + #13,0);
                           WriteTextLn('A64,160,0,3,1,1,N,"'      + qryEtiquetasCodigoVisual.AsString + '"' + #13,0);
                           WriteTextLn('B16,196,0,1,2,3,80,N,"' + qryEtiquetasCodigoVisual.AsString + '"' + #13,0);
                           WriteTextLn('A64,300,0,3,1,1,N,"'      + qryEtiquetasCodigoVisual.AsString + '"' + #13,0);
                           WriteTextLn('A20,344,0,4,1,1,N,"R$' +Format('%07.2f',[qryEtiquetasPreco.ASCurrency])+'"' + #13,0);
                        End
                        Else if (Meio) then
                        Begin
                           WriteTextLn('A306,56,0,3,1,1,N,"'      + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''), 1,16) + '"' + #13,0);
                           WriteTextLn('A306,86,0,3,1,1,N,"'      + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),17,16) + '"' + #13,0);
                           WriteTextLn('A306,116,0,3,1,1,N,"'     + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),33,18) + '"' + #13,0);
                           WriteTextLn('A360,160,0,3,1,1,N,"'     + qryEtiquetasCodigoVisual.AsString + '"' + #13,0);
                           WriteTextLn('B312,196,0,1,2,3,80,N,"' + qryEtiquetasCodigoVisual.AsString + '"' + #13,0);
                           WriteTextLn('A360,300,0,3,1,1,N,"'      + qryEtiquetasCodigoVisual.AsString + '"' + #13,0);
                           WriteTextLn('A316,344,0,4,1,1,N,"R$' +Format('%07.2f',[qryEtiquetasPreco.ASCurrency])+'"' + #13,0);
                        End
                        Else
                        BEGIN
                           WriteTextLn('A602,56,0,3,1,1,N,"'      + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''), 1,16) + '"' + #13,0);
                           WriteTextLn('A602,86,0,3,1,1,N,"'      + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),17,16) + '"' + #13,0);
                           WriteTextLn('A602,116,0,3,1,1,N,"'     + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),33,18) + '"' + #13,0);
                           WriteTextLn('A656,160,0,3,1,1,N,"'     + qryEtiquetasCodigoVisual.AsString + '"' + #13,0);
                           WriteTextLn('B608,196,0,1,2,3,80,N,"' + qryEtiquetasCodigoVisual.AsString + '"' + #13,0);
                           WriteTextLn('A656,300,0,3,1,1,N,"'      + qryEtiquetasCodigoVisual.AsString + '"' + #13,0);
                           WriteTextLn('A612,344,0,4,1,1,N,"R$' +Format('%07.2f',[qryEtiquetasPreco.ASCurrency])+'"' + #13,0);
                        END;
                 End;
                 If not Esquerdo and not Meio Then WriteTextLn('P1' + #13,0);
                 Inc(NE);
                 If Esquerdo then
                 begin
                    esquerdo:= false;
                    Meio    := True;
                 end
                 else If Meio Then
                 begin
                     Meio:= false;
                 end
                 else
                     esquerdo:= true;
                 //Esquerdo:= not Esquerdo;
               End;
             End;
             qryEtiquetas.Next;
           End;
           If not Esquerdo Then WriteTextLn('P1' + #13,0);
           EndDoc('TecLUX - Imprimindo Etiqueta ZEBRA TLP 2844');
        Finally
        qryEtiquetas.EnableControls;
      end;
    end
  else
  if Tipo = 'PP'  then With TextPrinter do //----- PETIT PAVE------
  begin
        Try
                qryEtiquetas.First;
                BeginDoc('', False);
                LerArquivo(ExtractFilePath(Application.ExeName)+'logopcx.txt',Buffer);
                While not qryEtiquetas.Eof do
                Begin
                        If qryEtiquetasMarcar.AsBoolean Then
                        Begin
                                NE:= 1;
                                While NE <= qryEtiquetasQuantidadeProduto.AsInteger do
                                Begin
                                        If qryEtiquetasTotal.AsCurrency = 0 Then
                                                PrecoPrazo:= qryEtiquetasPreco.AsCurrency
                                        Else
                                                PrecoPrazo:= qryEtiquetasTotal.AsCurrency;

                                        If Esquerdo Then
                                        Begin
                                             WriteTextLn('N',      0);
                                             WriteTextLn('Q736,8', 0);
                                             WriteTextLn('q800',   0);
                                             WriteTextLn('S2',     0);
                                             WriteTextLn('D' + FStr(ParSistema.IntensidadeImpressaoZebra,$00),0);
                                             WriteTextLn('ZB',     0);
                                             WriteTextLn('O',      0);
                                             WriteTextLn('GW60,50,35,82,'+Copy(Buffer,1,Length(Buffer)),0);
                                             WriteTextLn('A25,140,0,2,1,1,N,"Em caso de troca, favor"'       + #13,0);
                                             WriteTextLn('A25,160,0,2,1,1,N,"conservar esta etiqueta fixada."'      + #13,0);
                                             WriteTextLn('A25,180,0,2,1,1,N,"Prazo maximo de 30 dias."'      + #13,0);
                                             WriteTextLn('A25,220,0,2,1,2,N,"'+Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),1,25)+'"'+#13,0);
                                             WriteTextLn('A25,250,0,2,1,2,N,"'+Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),26,15) + ' ' + qryEtiquetasvalorgrade1.AsString + ' ' + qryEtiquetasvalorgrade2.AsString + '"'+#13,0);
                                             WriteTextLn('A25,300,0,2,1,2,N,"Data: ___/___/___"'+#13,0);
                                             WriteTextLn('A140,360,0,2,1,2,N,"'    + qryEtiquetasCodigoVisual.AsString +'"'                              + #13,0);
                                             WriteTextLn('B100,400,0,1,3,4,70,N,"' + qryEtiquetasCodigoVisual.AsString +'"'                              + #13,0);
                                             WriteTextLn('A140,480,0,2,1,2,N,"'    + qryEtiquetasCodigoVisual.AsString +'"'                              + #13,0);
                                             WriteTextLn('A25,530,0,2,1,2,N,"'+Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),1,25)+'"'+#13,0);
                                             WriteTextLn('A25,560,0,2,1,2,N,"'+Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),26,15) + ' ' + qryEtiquetasvalorgrade1.AsString + ' ' + qryEtiquetasvalorgrade2.AsString + '"'+#13,0);
                                             WriteTextLn('A120,610,0,3,1,1,N,"'+preencheString('AV. R$'+Format('%07.2f',[(1-(FPercentualAVista/100)) * qryEtiquetasPRECO.AsCurrency]),' ',19,false) +'"'  + #13,0);
                                             if (qryEtiquetasQtdeParcelas.AsInteger>0) then
                                             begin
                                               WriteTextLn('A120,640,0,3,1,1,N,"'+preencheString('Ou '+qryEtiquetasQtdeParcelas.AsString+'x de R$'+Format('%07.2f',[qryEtiquetasValorParcela.AsCurrency]),' ',19,false)+'"'+#13,0);
                                               WriteTextLn('A120,670,0,3,1,1,N," Total de R$'+Format('%07.2f',[qryEtiquetasTotalParcelas.AsCurrency]) +'"'     + #13,0);
                                             end;
                                        End
                                        Else
                                        Begin
                                             WriteTextLn('GW460,50,35,82,'+Copy(Buffer,1,Length(Buffer)),0);
                                             WriteTextLn('A425,140,0,2,1,1,N,"Em caso de troca, favor"'       + #13,0);
                                             WriteTextLn('A425,160,0,2,1,1,N,"conservar esta etiqueta fixada."'      + #13,0);
                                             WriteTextLn('A425,180,0,2,1,1,N,"Prazo maximo de 30 dias."'      + #13,0);
                                             WriteTextLn('A425,220,0,2,1,2,N,"'+Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),1,25)+'"'+#13,0);
                                             WriteTextLn('A425,250,0,2,1,2,N,"'+Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),26,15) + ' ' + qryEtiquetasvalorgrade1.AsString + ' ' + qryEtiquetasvalorgrade2.AsString + '"'+#13,0);
                                             WriteTextLn('A425,300,0,2,1,2,N,"Data: ___/___/___"'+#13,0);
                                             WriteTextLn('A540,360,0,2,1,2,N,"'    + qryEtiquetasCodigoVisual.AsString +'"'                              + #13,0);
                                             WriteTextLn('B500,400,0,1,3,4,70,N,"' + qryEtiquetasCodigoVisual.AsString +'"'                              + #13,0);
