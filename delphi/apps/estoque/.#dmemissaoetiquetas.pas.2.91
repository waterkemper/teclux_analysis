      3: begin
                 if qryProcuraModelosEtiquetasDescricao.AsString = 'ZEBRA 3 COLUNAS (25 x 34 mm)' then begin MaisY1:= 6; MaisY2:= 14; end
            else if qryProcuraModelosEtiquetasDescricao.AsString = 'ZEBRA 3 COLUNAS (22 x 34 mm)' then begin MaisY1:= 0; MaisY2:=  0; end
                                                                                                  else begin MaisY1:= 0; MaisY2:=  0; end;
