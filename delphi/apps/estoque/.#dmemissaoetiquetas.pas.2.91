   else if Tipo='G3' then
   With TextPrinter do Begin     //----- GAMA GRANDE------   (93 x 50 x 1)
      Try
        qryEtiquetas.First;
        BeginDoc('', False);
        //LerArquivo(ExtractFilePath(Application.ExeName)+'grandepcx.txt',Buffer);
        //LerArquivo(ExtractFilePath(Application.ExeName)+'empgrdpcx.txt',Buffer1);
        While not qryEtiquetas.Eof do
