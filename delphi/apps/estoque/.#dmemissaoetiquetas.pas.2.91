            Begin
              WriteTextLn('',0);
              WriteTextLn('N',0);
              WriteTextLn('q800'      + #13,0);
              WriteTextLn('Q398,21'   + #13,0);
              WriteTextLn('S1'        + #13,0);
              WriteTextLn('D' + FStr(ParSistema.IntensidadeImpressaoZebra,$00),0);
