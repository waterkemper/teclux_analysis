                         Linhas[1, Col]:= 'A' + FStr(X,$00) +  ',3,0,2,1,1,N,"'  + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''), 1,19) + '"';
                         Linhas[2, Col]:= 'A' + FStr(X,$00) +  ',23,0,2,1,1,N,"' + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),20,19) + '"';
                         Linhas[3, Col]:= 'A' + FStr(X,$00) +  ',43,0,2,1,1,N,"' + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),40,19) + '"';
                         if Trim(Copy(qryEtiquetasReferencia.AsString,1,15)) <> ''
                         then Linhas[4, Col]:= 'A' + FStr(X,$00) +  ',63,0,2,1,1,N,"' + CenDirEsq('REF: ' +
