                WriteTextLn('A445,135,0,3,1,1,N,"'     + preencheString(qryEtiquetaslocalizacao.AsString,' ',10,False) + '"',0);
              WriteTextLn('A185,175,0,4,1,1,N,"'     + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''), 1,27) + '"',0);
              WriteTextLn('A185,205,0,4,1,1,N,"'     + Copy(Trocar(qryEtiquetasDescricaoProdutoLC.AsString,'"',''''),28,13) + '"',0);
              if NumeroAba <> 3 then
                WriteTextLn('B185,235,0,1,2,2,40,N,"'  + qryEtiquetasCodigoVisual.AsString + '"',0)
              else
                WriteTextLn('B185,235,0,1,2,2,40,N,"'  + qryEtiquetasprodutocliente.AsString + '"',0);
              WriteTextLn('GW545,200,13,80,'+Copy(Buffer1,1,Length(Buffer1)),0);
              WriteTextLn('P1',0);
              Inc(NE);
            End;
          End;
          qryEtiquetas.Next;
        End;
        EndDoc('TecLUX - Imprimindo Etiqueta ZEBRA TLP 2844');
      Finally
        qryEtiquetas.EnableControls;
    end;
