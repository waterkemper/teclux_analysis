                           WriteTextLn('q800',      0);
                           WriteTextLn('Q480,24+0', 0);
                           WriteTextLn('S2',        0);
                           WriteTextLn('D' + FStr(ParSistema.IntensidadeImpressaoZebra,$00),0);
                           WriteTextLn('ZT',        0);
                           WriteTextLn('O',         0);

