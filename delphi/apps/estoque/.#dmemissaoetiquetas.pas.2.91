procedure TdtmEmissaoEtiquetas.LerArquivo(FName: String; Var Buffer: String);
var Arquivo: file of byte;

    function ErroIO: Boolean;
    var Erro: Integer;
    begin
       Erro:= IOResult;
       if Erro <> 0
       Then MensagemAviso('Erro ' + IntToStr(Erro) + ' no arquivo "' + FName + '"');
       Result:= Erro <> 0;
    End;

Begin
   system.Assign(Arquivo, FName);
   if not ErroIO then begin
      Reset(Arquivo);
      if not ErroIO then begin
         SetLength(Buffer,  Filesize(Arquivo));
         BlockRead(Arquivo, Buffer[1], FileSize(Arquivo));
      end;
   end;
end;

procedure TdtmEmissaoEtiquetas.qryNotasSaidasFilterRecord(
  DataSet: TDataSet; var Accept: Boolean);
begin
  inherited;
  if qryNotasSaidasMarcarNotaSaida.Value then Accept:= True
                                         else Accept:= False;
end;

procedure TdtmEmissaoEtiquetas.AcionaInclusaoNotasSaidas;
Type T_NotasSaidas = Record
     T_MarcarNotaSaida:  Boolean;
     T_Filial:           Integer;
     T_Serie:            String;
     T_Numero:           Integer;
     T_Cliente:          Integer;
     T_TipoCliente:      String;
     T_Nome:             String;
     T_Data:             String;
     T_Rua:              String;
     T_Bairro:           Integer;
     T_Cidade:           Integer;
     T_Estado:           String;
     T_Cep:              String;
     T_Observacoes:      String;
     T_NomeCidade:       String;
     T_NomeBairro:       String;
     T_Total:            Currency;
     T_Att:              String;
     T_Copia:            Boolean;
     End;
var
     NotasSaidas:      T_NotasSaidas;
begin
   if qryNotasSaidas.IsEmpty then Exit;

   FillChar(NotasSaidas,Sizeof(T_NotasSaidas),0);
   With NotasSaidas do begin
     T_MarcarNotaSaida:= qryNotasSaidasMarcarNotaSaida.AsBoolean;
     T_Filial         := qryNotasSaidasFilial.AsInteger;
     T_Serie          := qryNotasSaidasSerie.AsString;
     T_Numero         := qryNotasSaidasNumero.AsInteger;
     T_Cliente        := qryNotasSaidasCliente.AsInteger;
     T_TipoCliente    := qryNotasSaidasTipoCliente.AsString;
     T_Nome           := qryNotasSaidasNome.AsString;
     T_Data           := qryNotasSaidasData.AsString;
     T_Rua            := qryNotasSaidasRua.AsString;
     T_Bairro         := qryNotasSaidasBairro.AsInteger;
     T_Cidade         := qryNotasSaidasCidade.AsInteger;
     T_Estado         := qryNotasSaidasEstado.AsString;
     T_Cep            := qryNotasSaidasCep.AsString;
     T_Observacoes    := qryNotasSaidasObservacoes.AsString;
     T_NomeCidade     := qryNotasSaidasNomeCidade.AsString;
     T_NomeBairro     := qryNotasSaidasNomeBairro.AsString;
     T_Total          := qryNotasSaidasTotal.AsCurrency;
     T_Att            := qryNotasSaidasAtt.AsString;
     qryNotasSaidas.Edit;
     qryNotasSaidasCopia.AsBoolean := True;
     T_Copia          := qryNotasSaidasCopia.AsBoolean;
     qryNotasSaidas.Post;
   end;

   qryNotasSaidas.Insert;
   With NotasSaidas  do begin
     qryNotasSaidasMarcarNotaSaida.AsBoolean:= T_MarcarNotaSaida;
     qryNotasSaidasFilial.AsInteger         := T_Filial;
     qryNotasSaidasSerie.AsString           := T_Serie;
     qryNotasSaidasNumero.AsInteger         := 0;   //R_Numero;
     qryNotasSaidasCliente.AsInteger        := T_Cliente;
     qryNotasSaidasTipoCliente.AsString     := T_TipoCliente;
     qryNotasSaidasNome.AsString            := T_Nome;
     qryNotasSaidasData.AsString            := T_Data;
     qryNotasSaidasRua.AsString             := T_Rua;
     qryNotasSaidasBairro.AsInteger         := T_Bairro;
     qryNotasSaidasCidade.AsInteger         := T_Cidade;
     qryNotasSaidasEstado.AsString          := T_Estado;
     qryNotasSaidasCep.AsString             := T_Cep;
     qryNotasSaidasObservacoes.AsString     := T_Observacoes;
     qryNotasSaidasNomeCidade.AsString      := T_NomeCidade;
     qryNotasSaidasNomeBairro.AsString      := T_NomeBairro;
     qryNotasSaidasTotal.AsCurrency         := T_Total;
     qryNotasSaidasAtt.AsString             := T_Att;
     qryNotasSaidasCopia.AsBoolean          := T_Copia;
     qryNotasSaidas.Post;
   end;
end;


procedure TdtmEmissaoEtiquetas.CalculaPlanos;
begin
  if ((qryProcuraPlanos.Active) and (qryProcuraPlanos.RecordCount>0)) then
  begin
        if qryProcuraPlanosPrazoVenctoEntrada.AsInteger <> 0 then
                CalcularPlanosSemEntrada
        else
                CalcularPlanosComEntrada;
  end;
end;



function TdtmEmissaoEtiquetas.GerarEtiquetasProdutosNotas: Boolean;
var
  dadosfiscais, LWhere: String;

begin
  dadosfiscais := '';
  LWhere := '';

  if not qryNotasSaidas.IsEmpty then
  begin
    GuardarRegistroAtual(qryNotasSaidas,true);
    qryNotasSaidas.First;
    while not qryNotasSaidas.Eof do
    begin
      if qryNotasSaidasMarcarnotasaida.AsBoolean then
      begin
        dadosfiscais := dadosfiscais + qryNotasSaidasdadofiscal.AsString + ', ';
      end;
      qryNotasSaidas.Next;
    end;
    VoltarRegistroAtual(qryNotasSaidas);

    qryEtiquetas.Close;
    qryEtiquetas.sql.Clear;
    qryEtiquetas.Params.Clear;
    qryetiquetas.Sql.Text := qryEtiquetasProdutosNotasSaidas.Sql.Text;

    Delete(dadosfiscais, length(dadosfiscais)-1, 2);
    if dadosfiscais = '' then
      dadosfiscais := '0';

{    qryEtiquetas.ParamByName('cliente').AsInteger    := qryProcuraClientesCodigo.AsInteger;
    qryEtiquetas.ParamByName('tipocliente').AsString := qryProcuraClientestipo.AsString;

}    qryEtiquetas.MacroByName('DADOSFISCAIS').AsString := 'and pdf.dadofiscal in (' + dadosfiscais + ')';

    if FProdutoEmLinha and not FprodutoForadeLinha then
      LWhere:= LWhere + ' and not p.foralinhal and not c.foralinhal'
    else
    if FprodutoForadeLinha and not Fprodutoemlinha then
      LWhere:= LWhere + ' and (p.foralinhal or c.foralinhal)';

    if FProdutoAtivo and not FprodutoInativo then
      LWhere:= LWhere +' and p.inativo is null'
    else
    if FprodutoInativo and not FprodutoAtivo then
      LWhere:= LWhere + ' and p.inativo is not null';

     qryEtiquetas.MacroByName('FiltroProdutos').AsString := LWhere;

    qryEtiquetas.open;
    result := not qryetiquetas.IsEmpty;
    if not Result then
      MensagemAviso(ctSEMETIQUETASPARAIMPRIMIR)
    else
      CalculaPlanos;
  end;
end;

function TdtmEmissaoEtiquetas.ExisteFornecedoresNotas(campo,
  Codigo: String): Boolean;
const
SQL = ' and (to_ascii(V.%s,''latin1'') ilike to_ascii(''%s%s'',''latin1''))';
SQLNome = ' and (to_ascii(V.%s,''latin1'') ilike to_ascii(''%s%s'',''latin1'') or to_ascii(V.razao,''latin1'') ilike to_ascii(''%s%s'',''latin1''))';
begin
  qryConsultaFornecedoresNotas.Close;
  if campo = 'nome' then
    qryConsultaFornecedoresNotas.MacroByName('branco').AsString := Format(SQLNome, [Campo, Codigo, '%', Codigo, '%'])
  else
    qryConsultaFornecedoresNotas.MacroByName('branco').AsString := Format(SQL, [Campo, Codigo, '%']);

  qryConsultaFornecedoresNotas.Open;
  Result := (qryConsultaFornecedoresNotas.RecordCount > 0);
end;

procedure TdtmEmissaoEtiquetas.GerarEtiquetasPedidos;
var
  vCondicaoPedido, vOrdenacaoPedido : String;
begin
  qryEtiquetas.sql.Text := qryEtiquetasPedidos.Sql.Text;
  vCondicaoPedido := '';
  if ParametroPedido <> '' then
    vCondicaoPedido := 'and pd.numero = '+ParametroPedido
  else
  begin
    if ParametroFornecedorPedido <> '' then
      vCondicaoPedido := 'and pd.fornecedor = '+ParametroFornecedorPedido;

    if ParametroProdutoPedido <> '' then
      vCondicaoPedido := vCondicaoPedido +
                       ' and pp.produto = '+ParametroProdutoPedido;

    if ParametroDataInicialSaida <> '' then
      vCondicaoPedido := vCondicaoPedido +
                      ' and pd.emissao >= '+FormatDateTime('yyyy-mm-dd', strtodate(ParametroDataInicialPedido));

    if ParametroDataFinalPedido <> '' then
      vCondicaoPedido := vCondicaoPedido +
                      ' and pd.emissao <= '+FormatDateTime('yyyy-mm-dd', strtodate(ParametroDataFinalPedido));

    case ParametroSituacaoPedido of
    0: vCondicaoPedido := vCondicaoPedido + ' and (pd.situacao = ' + QuotedStr('A') + ')';  //Aberto
    1: vCondicaoPedido := vCondicaoPedido + ' and (pd.situacao = ' + QuotedStr('P') + ')';  //Parcial
    2: vCondicaoPedido := vCondicaoPedido + ' and (pd.situacao = ' + QuotedStr('Q') + ')';  //Parcial Liquidado
    3: vCondicaoPedido := vCondicaoPedido + ' and (pd.situacao = ' + QuotedStr('L') + ')';  //Concluido
    4: vCondicaoPedido := vCondicaoPedido + ' and (pd.situacao = ' + QuotedStr('C') + ')';  //Cancelado
    5: ; //Todos
    end;
  end;

  if FProdutoEmLinha and not FprodutoForadeLinha then
    vCondicaoPedido:= vCondicaoPedido + ' and not p.foralinhal and not c.foralinhal'
  else
  if FprodutoForadeLinha and not Fprodutoemlinha then
    vCondicaoPedido:= vCondicaoPedido + ' and (p.foralinhal or c.foralinhal)';

  if FProdutoAtivo and not FprodutoInativo then
    vCondicaoPedido:= vCondicaoPedido +' and p.inativo is null'
  else
  if FprodutoInativo and not FprodutoAtivo then
    vCondicaoPedido:= vCondicaoPedido + ' and p.inativo is not null';

  case ParametroOrdenacaoPedido of
  0: vOrdenacaoPedido := 'Order By pd.numero';
  1: vOrdenacaoPedido := 'Order By UPPER(TO_ASCII(p.Descricao,''LATIN1'')), pd.emissao';
  2: vOrdenacaoPedido := 'Order By UPPER(TO_ASCII(f.nome,''LATIN1'')), pd.emissao';
  3: vOrdenacaoPedido := 'Order By pd.emissao';
  4: vOrdenacaoPedido := 'Order By UPPER(TO_ASCII(pd.situacao,''LATIN1''))';
  end;

  qryEtiquetas.MacroByName('CondicaoPedido').asstring := vCondicaoPedido;
  qryEtiquetas.MacroByName('OrdenacaoPedido').asstring := vOrdenacaoPedido;
  qryEtiquetas.Open;

end;


procedure TdtmEmissaoEtiquetas.Etiquetas_Modelo_G;
begin

end;

procedure TdtmEmissaoEtiquetas.frp_A4_5ColGetValue(const ParName: String;
  var ParValue: Variant);
begin
  inherited;

       if ParName = 'PRODUTO'    then ParValue:=        qryEtiquetasCodigoVisual.AsString
  else if ParName = 'UNIDADE'    then ParValue:= ifthen(qryEtiquetasCodigoVisual.AsString <> '', qryEtiquetasunidade.AsString, '')
  else if ParName = 'DESCRICAO'  then ParValue:= ifthen(qryEtiquetasCodigoVisual.AsString <> '', qryEtiquetasDescricaoProdutoLC.asstring, '')
  else if Parname = 'REFERENCIA' then if qryEtiquetasReferencia.AsString <> ''
                                      then ParValue:= ifthen(qryEtiquetasCodigoVisual.AsString <> '',
                                                              FStr(MonthOf(DataServidor),$21) + '/' + FStr(YearOf (DataServidor),$41) + ' REF: ' + qryEtiquetasReferencia.AsString, '')
                                      else ParValue := ifthen(qryEtiquetasCodigoVisual.AsString <> '',
                                                              FStr(MonthOf(DataServidor),$21) + '/' + FStr(YearOf (DataServidor),$41), '')
  else if ParName = 'VALOR'      then if ImprimirPreco
                                      then ParValue:= ifthen(qryEtiquetasCodigoVisual.AsString <> '',
                                       'R$ ' + trim(FormatarValor(qryEtiquetaspreco.AsCurrency,2)), '')
                                      else ParValue := '';
end;

