                        End
                        Else
                        BEGIN
                           WriteTextLn('B490,8,0,1,2,30,30,B,"'      + qryEtiquetasCodigoVisual.AsString + '"' + #13,0);
                           //WriteTextLn('A490,16,0,1,1,1,N,"'      + Copy(qryEtiquetasDescricaoProdutoLC.AsString, 1,19) + '"' + #13,0);
                           //WriteTextLn('A490,32,0,1,1,1,N,"'      + Copy(qryEtiquetasDescricaoProdutoLC.AsString,20,21) + '"' + #13,0);
                        END;
                 End;
                 If not Esquerdo and not Meio Then WriteTextLn('P1' + #13,0);
                 Inc(NE);
                 If Esquerdo then
                 begin
                    esquerdo:= false;
                    Meio    := True;
                 end
                 else If Meio Then
                 begin
                     Meio:= false;
                 end
                 else
                     esquerdo:= true;
                 //Esquerdo:= not Esquerdo;
               End;
             End;
             qryEtiquetas.Next;
           End;
           If not Esquerdo Then WriteTextLn('P1' + #13,0);
           EndDoc('TecLUX - Imprimindo Etiqueta ZEBRA TLP 2844');
        Finally
        qryEtiquetas.EnableControls;
      end;
    end;

