  if Tipo= 'G4' then begin    //----- GAMA ETIQUETA GIGANTE (EMBARQUE) ------
      With TextPrinter do Begin
        Try
          BeginDoc('', False);
          //LerArquivo(ExtractFilePath(Application.ExeName)+'gigantepcx.txt',Buffer);
          //LerArquivo(ExtractFilePath(Application.ExeName)+'empgigpcx.txt',Buffer1);
          qryNotasSaidas.DisableControls;

          qryNotasSaidas.First;
          While not qryNotasSaidas.Eof do Begin
            If qryNotasSaidasMarcarNotaSaida.AsBoolean Then Begin
               WriteTextLn('',0);
               WriteTextLn('N',0);
               WriteTextLn('q800'      + #13,0);
               WriteTextLn('Q1119,37'  + #13,0);
               WriteTextLn('S1'        + #13,0);
               WriteTextLn('D' + FStr(ParSistema.IntensidadeImpressaoZebra,$00),0);
               WriteTextLn('ZB'        + #13,0);
               WriteTextLn('TTh:m'     + #13,0);
               WriteTextLn('TDy2.mn.dd'+ #13,0);
               WriteTextLn('O'         + #13,0);
            // COLOCAR AQUI LOGOTIPO DA GAMA
            //GW020,1000,35,88,
               //WriteTextLn('GW25,677,16,394,'+ Copy(Buffer,1,Length(Buffer)),0);
               //WriteTextLn('A025,600,3,4,1,1,N,"' + NomeFilialBase                 + '"' + #13,0);
               //WriteTextLn('A055,600,3,4,1,1,N,"' + RuaFilialBase                  + '"' + #13,0);
               //WriteTextLn('A085,600,3,4,1,1,N,"' + BairroFilialBase               + '"' +  #13,0);
               //WriteTextLn('A115,600,3,4,1,1,N,"' + FormatarCep(CepFilialBase) +' - '+CidadeFilialBase+ ' - '+ EstadoFilialBase+ '"'+#13,0);
               //WriteTextLn('A145,600,3,4,1,1,N,"' + 'FONE/FAX: ' + FormatarFone(DddFilialBase,FoneFilialBase)  + '"' +  #13,0);
               //WriteTextLn('A175,600,3,4,1,1,N,"WWW.GAMA-SC.COM.BR"'               +  #13,0);
               //WriteTextLn('GW090,30,16,146,'      + Copy(Buffer1,1,Length(Buffer1)),0);  // LOGO EMPILHADEIRA

               WriteTextLn('A285,1065,3,4,1,1,N,"' + 'Para  : ' + qryNotasSaidasNome.AsString        + '"' + #13,0);
               WriteTextLn('A330,1065,3,4,1,1,N,"' + 'Rua   : ' + qryNotasSaidasRua.AsString         + '"' + #13,0);
               WriteTextLn('A375,1065,3,4,1,1,N,"' + 'Bairro: ' + qryNotasSaidasNomeBairro.AsString  + '"' + #13,0);
               WriteTextLn('A420,1065,3,4,1,1,N,"' + 'Cidade: ' + PreencheString(qryNotasSaidasNomeCidade.AsString,' ',51,True)+
                                                     'UF: '     + qryNotasSaidasEstado.AsString      + '"'  + #13,0);

               NumCliente := 0;   NotasStr := ''; FlagNota := False;
               NumCliente := qryNotasSaidasCLIENTE.AsInteger;

               if qryNotasSaidasCopia.AsBoolean then begin
                  while (not qryNotasSaidas.Eof) and (NumCliente = qryNotasSaidasCliente.AsInteger) and
                    (qryNotasSaidasCopia.AsBoolean)  do Begin
                     if qryNotasSaidasMarcarNotaSaida.AsBoolean then
                        NotasStr := NotasStr + IntToStr(qryNotasSaidasNumero.AsInteger) + ' ';

                     qryNotasSaidas.Next;
                     FlagNota := True;
                  end;
               end else
                   NotasStr := IntToStr(qryNotasSaidasNumero.AsInteger) + ' ';

               if FlagNota then qryNotasSaidas.Prior;

               Obs  := Trim(qryNotasSaidasObservacoes.AsString);
               Obs1 := '';
               for J := 1 to Length(Obs) do
                   if obs[J] <> '"' then
                      obs1 := Obs1 + obs[J];

               WriteTextLn('A465,1065,3,4,1,1,N,"' + 'N.F.  : ' + NotasStr                             + '"'     + #13,0);
               WriteTextLn('A510,1065,3,4,1,1,N,"' + 'DATA  : ' + qryNotasSaidasDataEtiqueta.AsString  + '"'     + #13,0);

               WriteTextLn('A580,1065,3,4,1,1,N,"' + 'OBS   : ' + Trim(COPY(Obs1,001,55)) + '"' + #13,0);
               WriteTextLn('A630,1065,3,4,1,1,N,"' + '        ' + Trim(COPY(Obs1,056,55)) + '"' + #13,0);
               WriteTextLn('A680,1065,3,4,1,1,N,"' + '        ' + Trim(COPY(Obs1,107,55)) + '"' + #13,0);
               WriteTextLn('P1',0);
            End;
               qryNotasSaidas.Next;
          End;
          EndDoc('TecLUX - Imprimindo Etiqueta GIGANTE (EMBARQUE) ZEBRA TLP 2844');
        finally
          qryNotasSaidas.EnableControls;
        End;
      End;
      EXIT;
  End;

  if Tipo= 'G5' then
  begin     //----- GAMA ETIQUETA GRANDE (DESTINATÁARIO/REMETENTE) ------
      With TextPrinter do
      Begin
