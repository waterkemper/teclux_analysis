procedure TdtmEmissaoEtiquetas.GerarEtiquetasNota;
VAR
  LWhere : String;
begin
//  qryetiquetas.Sql.clear;
//  qryEtiquetas.Sql.Text := qryEtiquetasNotas.Sql.Text;

  if FProdutoEmLinha and not FprodutoForadeLinha then
    LWhere:= LWhere + ' and not p.foralinhal and not c.foralinhal'
  else
  if FprodutoForadeLinha and not Fprodutoemlinha then
    LWhere:= LWhere + ' and (p.foralinhal or c.foralinhal)';

  if FProdutoAtivo and not FprodutoInativo then
    LWhere:= LWhere +' and p.inativo is null'
  else
  if FprodutoInativo and not FprodutoAtivo then
    LWhere:= LWhere + ' and p.inativo is not null';

  qryEtiquetas.macrobyname('sql').asString := LWhere;

  RefazConsulta(qryEtiquetas, [0,1,2], [FParametroFornecedorNotas,
                                        FParametroSerie,
                                        FParametroNota]);
  CalculaPlanos;
end;

procedure TdtmEmissaoEtiquetas.GerarEtiquetasNotasSaida;
begin
  qryNotasSaidas.Close;
{  qryNotasSaidas.ParamByName('cliente').Value     := FParametroCliente;
  qryNotasSaidas.ParamByName('datainicial').Value := FParametroDataInicialSaida;
  qryNotasSaidas.ParamByName('datafinal').Value   := FParametroDataFinalSaida;
  qryNotasSaidas.ParamByName('notainicial').Value := FParametroNotaInicialSaida;
  qryNotasSaidas.ParamByName('notafinal').Value   := FParametroNotaFinalSaida;
}
  if FparametroCliente <> '' then
    qryNotasSaidas.MacroByName('cliente').AsString := 'and (d.cliente = ' + FparametroCliente + ')'
  else
    qryNotasSaidas.MacroByName('cliente').AsString := '';

  if (FParametroDataInicialSaida <> '') and (FParametroDataFinalSaida <> '')  then
    qryNotasSaidas.MacroByName('datainicialfinal').AsString := 'and (d.data between (''' + FParametroDataInicialSaida + ''') and (''' + FParametroDataFinalSaida + '''))'
  else
    qryNotasSaidas.MacroByName('datainicialfinal').AsString := '';

  if (FParametroNotaInicialSaida <> '') and (FParametroNotaFinalSaida <> '')  then
    qryNotasSaidas.MacroByName('notainicialfinal').AsString := 'and (n.numero between (''' + FParametroNotaInicialSaida + ''') and (''' + FParametroNotaFinalSaida + '''))'
  else
    qryNotasSaidas.MacroByName('notainicialfinal').AsString := '';


(*  if FparametroTipoMovto <> '' then
     qryEtiquetas.MacroByName('movimento').AsString := 'and (m.tipomovimento = ' +  FparametroTipoMovto + ')'
  else
     qryEtiquetas.MacroByName('movimento').AsString := ''; *)

  qryNotasSaidas.Open;
  CalculaPlanos;
end;

procedure TdtmEmissaoEtiquetas.GerarEtiquetasMovimento;
VAR
  LWhere : String;

begin
  qryEtiquetasMovimento.Sql[17]:= MontarIntervaloData('cast(t.data as date)',FParametroDataInicial,FParametroDataFinal);
  if FParametroFilialMovto <> '' then
       qryEtiquetasMovimento.Sql[18]:= 'and (t.filial = ' + FParametroFilialMovto + ')'
  else qryEtiquetasMovimento.Sql[18]:= '';

  if FParametroTipoMovto <> '' then
     qryEtiquetasMovimento.Sql[19]:= 'and (t.tipomovimento = ' + QuotedStr(FParametroTipoMovto) + ')'
  else
     qryEtiquetasMovimento.Sql[19]:= '';

  if FProdutoEmLinha and not FprodutoForadeLinha then
    LWhere:= LWhere + ' and not p.foralinhal and not c.foralinhal'
  else
  if FprodutoForadeLinha and not Fprodutoemlinha then
    LWhere:= LWhere + ' and (p.foralinhal or c.foralinhal)';

  if FProdutoAtivo and not FprodutoInativo then
    LWhere:= LWhere +' and p.inativo is null'
  else
  if FprodutoInativo and not FprodutoAtivo then
    LWhere:= LWhere + ' and p.inativo is not null';

  qryEtiquetasMovimento.Sql[20]:= LWhere;


  qryEtiquetas.Close;
  qryEtiquetas.sql.Clear;
  qryEtiquetas.Params.Clear;
  qryetiquetas.Sql.Text := qryEtiquetasMovimento.Sql.Text;
  qryEtiquetas.open;
  CalculaPlanos;
end;

procedure TdtmEmissaoEtiquetas.GerarEtiquetasProduto;
var
  LWhere, LFrom, Linha22: String;

begin
  LWhere := ' ';    LFrom := ' ';
  if FParametroProduto <> '' then
    LWhere := LWhere + ' and p.Codigo = ' + quotedstr(FParametroProduto) + ' '
  else
  if FParametroGrupo <> '' then
    LWhere := LWhere + ' and c.grupo = ''' + FParametroGrupo + ''' '
  else
  if FParametroClasse <> '' then
  begin
{    LFrom := LFrom + ' grupos g, ';}
    LWhere := LWhere + ' and c.classe = ' + quotedstr(FParametroClasse)
{                     + ' and c.grupo = g.Codigo '};
  end
  else
  if FParametroCaracteristicas <> '' then
      LWhere:= LWhere + ' and c.Codigo = ' + quotedstr(FParametroCaracteristicas) + ' ';



  if FProdutoEmLinha and not FprodutoForadeLinha then
    LWhere:= LWhere + ' and not p.foralinhal and not c.foralinhal'
  else
  if FprodutoForadeLinha and not Fprodutoemlinha then
    LWhere:= LWhere + ' and (p.foralinhal or c.foralinhal)';

  if FProdutoAtivo and not FprodutoInativo then
    LWhere:= LWhere +' and p.inativo is null'
  else
  if FprodutoInativo and not FprodutoAtivo then
    LWhere:= LWhere + ' and p.inativo is not null';

  if FParametroFornecedorProdutos <> '' then
  begin
    LFrom := LFrom + ' ,fornecedoresprodutos fp ';
    LWhere := LWhere + ' and fp.fornecedor = ' + FParametroFornecedorProdutos
                     + ' and c.Codigo = fp.caracteristica ';
  end
  else
  if FParametroMarca <> '' then
    LWhere := LWhere + ' and m.Codigo = ' + FParametroMarca
                     {+ ' and c.marca = m.Codigo '};

  LWhere := LWhere + ' and e.filial = ' + FParametroFilial + ' ';

  if FQtdeZerada then
    Linha22 := 'and (/*movimentos_emestoque(p.Codigo, e.filial)*/e.emestoque >= 0)'
  else
    Linha22 := 'and (/*movimentos_emestoque(p.Codigo, e.filial)*/e.emestoque > 0)';

  qryEtiquetas.sql.Clear;
  qryEtiquetas.Params.Clear;
  qryetiquetas.Sql.Text := qryEtiquetasProdutos.Sql.Text;
  qryEtiquetas.Close;

  qryEtiquetas.macrobyname('LFrom').asString := LFrom;
  qryEtiquetas.macrobyname('Linha').asString := Linha22;
  qryEtiquetas.macrobyname('LWhere').asString := LWhere;

  qryEtiquetas.parambyname('QuantidadeLote').asBoolean := false;
  qryEtiquetas.parambyname('lotetransferencia').asString := '0';
  qryEtiquetas.parambyname('QtdemEstoqueProdutosExposicao').asBoolean := true;
  qryEtiquetas.parambyname('QtdeZeradaProdutosExposicao').asBoolean := false;
  

  qryEtiquetas.open;
  CalculaPlanos;
end;

procedure TdtmEmissaoEtiquetas.qryProcuraFornecedoresNotasAfterScroll(DataSet: TDataSet);
begin
  qryProcuraSeries.ParamByName('fornecedor').Value  := qryProcuraFornecedoresNotasCodigo.AsInteger;
  qryProcuraSeries.ParamByName('tipo').asstring     := qryProcuraFornecedoresNotastipo.AsString;

  qryConsultaSeries.ParamByName('fornecedor').Value := qryProcuraFornecedoresNotasCodigo.AsInteger;
  qryConsultaSeries.ParamByName('tipo').asstring    := qryProcuraFornecedoresNotastipo.AsString;

  qryProcuraNotas.ParamByName('fornecedor').Value   := qryProcuraFornecedoresNotasCodigo.AsInteger;
  qryProcuraNotas.ParamByName('tipofornecedor').asstring      := qryProcuraFornecedoresNotastipo.AsString;

  qryConsultaNotas.ParamByName('fornecedor').Value  := qryProcuraFornecedoresNotasCodigo.AsInteger;
  qryConsultaNotas.ParamByName('tipofornecedor').asstring      := qryProcuraFornecedoresNotastipo.AsString;

end;

procedure TdtmEmissaoEtiquetas.qryProcuraSeriesAfterScroll(DataSet: TDataSet);
begin
  qryProcuraNotas.ParamByName('serie').Value := qryProcuraSeriesserie.AsString;
  qryConsultaNotas.ParamByName('serie').Value := qryProcuraSeriesserie.AsString;
end;

