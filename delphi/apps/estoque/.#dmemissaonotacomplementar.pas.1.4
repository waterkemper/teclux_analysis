function TdtmEmissaoNotaComplementar.GravarNotaFiscal: Boolean;
var
 Numero: Integer;

  function ValidarTotalProdutos: Boolean;
    var TotalProdutos: Currency;
  begin
    result := true;
    TotalProdutos := truncar(
                     (qryDadosFiscaistotalprodutos.AsCurrency +
                      qryDadosFiscaistotalvaloricmssubstituicao.AsCurrency +
                      qryDadosFiscaisvalorfrete.AsCurrency +
                      qryDadosFiscaisseguro.AsCurrency +
                      qryDadosFiscaisdespesasacessorias.AsCurrency +
                      qryDadosFiscaisvaloripi.AsCurrency +
                      qryDadosFiscaisvalorservicos.AsCurrency
                      ),2);

    if (TotalProdutos - qryDadosFiscaisvalortotal.AsCurrency)<> 0 then
    begin
      result := false;
      MensagemAviso(format
        (ctSOMATORIODIFERENTESTOTAL,[
          'os produtos, servicos e demais campos',
          FormatarValor(TotalProdutos,2),
          'a '+ansilowercase(ctNOTAFISCAL),
          formatarvalor(qryDadosFiscaisvalortotal.AsCurrency,2),
          FormatarValor((TotalProdutos - qryDadosFiscaisvalortotal.AsCurrency),2)
          ]));
    end;
  end;

  procedure PreencherChaveCalculosDadosFiscais;
  begin
    dtmGerarNotaFiscal.qryCalculosDadosFiscais.DisableControls;
    try
      dtmGerarNotaFiscal.qryCalculosDadosFiscais.First;
      while Not dtmGerarNotaFiscal.qryCalculosDadosFiscais.Eof do begin
        dtmGerarNotaFiscal.qryCalculosDadosFiscais.Edit;
        dtmGerarNotaFiscal.qryCalculosDadosFiscaisdadofiscal.AsInteger := qryDadosFiscaisnumero.AsInteger;
        dtmGerarNotaFiscal.qryCalculosDadosFiscais.Post;
        dtmGerarNotaFiscal.qryCalculosDadosFiscais.Next;
      end;
    finally
      dtmGerarNotaFiscal.qryCalculosDadosFiscais.EnableControls;
    end;
  end;

  procedure PreencherChaveProdutos;
  begin
    qryProdutos.First;
    Numero:=1;
    while Not qryProdutos.Eof do
    begin
      qryProdutos.Edit;
      qryProdutosdadofiscal.AsInteger := qryDadosFiscaisnumero.AsInteger;
      qryProdutosnumero.AsInteger:= Numero;
      Inc(Numero);
      qryProdutosmovimento.Clear;
      qryProdutos.Next;
    end;
  end;

begin
  CalcularValorTotalProdutos;
  CalcularValoresNotaFiscal;
  CalcularImpostos;
  GravarImpostosNotaFiscal;

  if qryDadosFiscais.CheckRequiredFields
     and ValidarTotalProdutos then
  begin
    qryDadosFiscaisnumero.AsInteger := NovoNumeroDadoFiscal;
    Result := PreencherNotaFiscal;

    PreencherChaveProdutos;

    if qryDadosFiscaisdesconto.IsNull then
     qryDadosFiscaisdesconto.AsCurrency := 0;

    PreencherChaveCalculosDadosFiscais;

    qryDadosFiscaisvalorvista.AsFloat := qryDadosFiscaisvalortotal.AsFloat;

    if not (qryDadosFiscais.State in [dsinsert,dsedit]) then
      qryDadosFiscais.Edit;
    //qryDadosFiscaisnumeronfcomplementar.AsInteger:= qryConsultadadosFiscaisnumeronota.AsInteger;
   // qryDadosFiscaisnfcomplementar.AsBoolean:= True;
    qryDadosFiscaisdata.AsDateTime:= DataServidor;
    qryDadosFiscaisdatasaida.AsDateTime:= DataServidor;

    qryDadosFiscais.Post;
    if qryProdutos.CheckRequiredFields then
      Perpetrar([qryDadosFiscais, qryProdutos, qrySeriesFiliais,
                 qryNotas, dtmGerarNotaFiscal.qryCalculosDadosFiscais]);
  end
  else
  Abort;

  qryConsultadadosFiscais.Cancel;
end;

function TdtmEmissaoNotaComplementar.PreencherNotaFiscal: Boolean;
begin
  Result:= True;

  RefazConsultaporNome(qrySeriesFiliais,['Filial','Serie'],[qryConsultadadosFiscaisfilial.AsVariant,
                                                            qryConsultadadosFiscaisserie.AsVariant]);

  if (qrySeriesFiliaisnumeroinicial.AsInteger > qryDadosFiscaisnumeronota.AsInteger) and
     (qrySeriesFiliaisnumerofinal.AsInteger < qryDadosFiscaisnumeronota.AsInteger) then
  begin
    Result:= False;
    Result:= MensagemConfirmacao('O número de série da nota esta fora do intervalo permitido para esta série.') = smbOK;
  end;

  if qryNotas.State = dsInactive then
    qryNotas.Open;
  qryNotas.Append;
  qryNotasfilial.AsInteger := qryConsultadadosFiscaisfilial.AsInteger;
  qryNotasserie.AsString:= qryConsultadadosFiscaisserie.AsString;
  qryNotasnumero.AsInteger:= qrySeriesFiliaisnumeroinicial.AsInteger;
  qryNotasdadofiscal.AsInteger := qryDadosFiscaisnumero.AsInteger;
  qryNotas.Post;

  if not (qryDadosFiscais.State in [dsinsert, dsedit]) then
    qryDadosFiscais.Edit;

  qryDadosFiscaisnumeronota.AsInteger:= qryNotasnumero.AsInteger;
  qryDadosFiscais.Post;


  qrySeriesFiliais.Edit;
  qrySeriesFiliaisnumeroinicial.AsInteger:= qrySeriesFiliaisnumeroinicial.AsInteger + 1;

  qrySeriesFiliais.Post;


  if qrySeriesFiliaisnumeroinicial.AsInteger <= qrySeriesFiliaisnumerofinal.AsInteger then
    Result := True
  else
    Result := MensagemAviso(Format(ctSERIEESGOTADA, [qrySeriesFiliaisnumerofinal.AsString]) + #13#10 + ctCONFIRMEINPRESSAO) = smbOK;

  if result then
    result := VerificaNotaFiscalJaCadastrada;
end;

function TdtmEmissaoNotaComplementar.VerificaNotaFiscalJaCadastrada: Boolean;
begin
  RefazConsultaPorNome(qryProcurarNota, ['Filial','Serie','Numero'], [qryDadosFiscaisfilial.AsInteger,
                                                                      qryDadosFiscaisserie.AsString,
                                                                      qrySeriesFiliaisnumeroinicial.AsInteger]);
  result := (qryProcurarNota.RecordCount=0);
  if not result then
  begin
    MensagemAviso('Existe outra nota (Série: '+qryDadosFiscaisserie.AsString +
                 ' Número: '+inttostr(qrySeriesFiliaisnumeroinicial.AsInteger) +
                 ') com a mesma série e número na filial ''' +
                 qryDadosFiscaisfilial.AsString + '''');
    qryNotas.Delete;
    qryDadosFiscaisnumeronota.Clear;
  end;
end;

