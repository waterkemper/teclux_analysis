function TdtmEmissaoNotaComplementar.GravarImpostosNotaFiscal: Boolean;
begin
  with dtmGerarNotaFiscal do
    if (qryCalculosDadosFiscais.State in [dsEdit, dsInsert]) then
    begin
      qryCalculosDadosFiscais.Edit;
      if qryCalculosDadosFiscaisaliquota.asstring = '' then
        qryCalculosDadosFiscaisaliquota.AsCurrency := 0;
      if qryCalculosDadosFiscaisbase.asstring = '' then
        qryCalculosDadosFiscaisbase.AsCurrency := 0;
      if qryCalculosDadosFiscaisisentas.asstring = '' then
        qryCalculosDadosFiscaisisentas.AsCurrency := 0;
      if qryCalculosDadosFiscaisoutras.asstring = '' then
        qryCalculosDadosFiscaisoutras.AsCurrency := 0;
      if qryCalculosDadosFiscaisvalor.asstring = '' then
        qryCalculosDadosFiscaisvalor.AsCurrency := 0;

      if dtmGerarNotaFiscal.qryCalculosDadosFiscais.CheckRequiredFields then begin
        dtmGerarNotaFiscal.qryCalculosDadosFiscais.Post;
        Result := True;
      end
      else
        Result:= False;
    end
    else
      Result:= False;
  if result then
    AtribuirValoresImpostos;
end;

