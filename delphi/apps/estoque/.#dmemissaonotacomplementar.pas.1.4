procedure TdtmEmissaoNotaComplementar.PreencherCampos(TabelaOrigem,TabelaDestino: TZDataset);
var
  a: Integer;
begin
  try
    TabelaDestino.Open;
    TabelaDestino.Append;
    for a:=0  to (TabelaOrigem.IndexFieldCount)-1 do
    begin
      case TabelaOrigem.Fields[a].DataType of
       ftString : begin
                    if TabelaOrigem.Fields[a].Value = '' then
                      TabelaOrigem.Fields[a].Clear
                    else
                      TabelaOrigem.Fields[a].Value;
                  end;
       ftInteger: begin
                    if TabelaOrigem.Fields[a].Value = 0 then
                        TabelaOrigem.Fields[a].Clear
                      else
                        TabelaOrigem.Fields[a].Value;
                    end;
      end;
      TabelaDestino.Fields[a].Value:= TabelaOrigem.Fields[a].Value;
    end;
  finally
   TabelaDestino.Post;
  end;
end;

procedure TdtmEmissaoNotaComplementar.PreencherCampoRequerido(CampoOrigem,
  CampoDestino: TField);
var
  a: Integer;
begin
  case CampoOrigem.DataType of
    ftString : begin
               if CampoOrigem.Value = '' then
                 CampoOrigem.Clear
               else
                 CampoOrigem.Value;
               end;
    ftInteger: begin
                 if CampoOrigem.Value = 0 then
                   CampoOrigem.Clear
                 else
                     CampoOrigem.Value;
                 end;
  end;
      CampoDestino.Value:= CampoOrigem.Value;
end;


