procedure TdtmEmissaoNotaComplementar.PreencherDadosFiscais;
begin
  qryDadosFiscais.Close;
  if qryConsultadadosFiscais.RecordCount > 0 then
  begin
    PreencherCampos(qryConsultadadosFiscais, qryDadosFiscais);
    if not (qryDadosFiscais.State in [dsinsert, dsedit]) then
      qryDadosFiscais.Edit;
    qryDadosFiscaisnatureza.AsString:= qryDadosFiscaisnatureza.AsString + ' - COMPLEMENTAR';
    qryDadosFiscaisobservacoescomplementar.AsString:= PreencherObservacoes;
    qryDadosFiscais.Post;
  end;
end;

function TdtmEmissaoNotaComplementar.PreencherObservacoes: String;
begin
  if qryConsultadadosFiscaisobservacoescomplementar.AsString = '' then
    if qryConsultadadosFiscaisvaloripi.AsFloat > 0 then
      Result:= format(ctOBSERVACOESCOMPLEMENTARESIPI,[qryConsultadadosFiscaisserie.AsString,
                                                      qryConsultadadosFiscaisnumeronota.AsInteger])
    else
      Result:= format(ctOBSERVACOESCOMPLEMENTARESSEMIPI,[qryConsultadadosFiscaisserie.AsString,
                                                         qryConsultadadosFiscaisnumeronota.AsInteger])
  else
    if qryConsultadadosFiscaisvaloripi.AsFloat > 0 then
      Result:= qryConsultadadosFiscaisobservacoescomplementar.AsString + format(ctOBSERVACOESCOMPLEMENTARESIPI,[qryConsultadadosFiscaisserie.AsString,
                                                                                qryConsultadadosFiscaisnumeronota.AsInteger])
    else
      Result:= qryConsultadadosFiscaisobservacoescomplementar.AsString + format(ctOBSERVACOESCOMPLEMENTARESSEMIPI,[qryConsultadadosFiscaisserie.AsString,
                                                                              qryConsultadadosFiscaisnumeronota.AsInteger]);
end;

procedure TdtmEmissaoNotaComplementar.PreencherProdutos;

var cont: integer;
begin
    if qryProdutos.RecordCount > 0 then
    begin
      qryProdutos.First;
      while not qryProdutos.Eof do
        qryProdutos.Delete;
      qryProdutos.Next;
    end;

  if not Assigned(qryProdutos) then
    qryProdutos.Open;

  qryConsultaProdutos.First;
  cont:= 1;
  while not qryConsultaProdutos.Eof do
  begin
    if qryConsultaProdutosok.AsBoolean then
    begin
      qryProdutos.Append;
      //Atribui os valores encontrados na Consulta para a qryProdutos
      qryProdutosnumero.AsInteger:= Cont;

      RefazConsultaPorNome(qryProcuraProduto,['codigovisual'],[qryConsultaProdutosprodutovisual.AsVariant]);
      qryProdutosproduto.AsLargeInt:= qryProcuraProdutocodigo.AsLargeInt;
      qryProdutoscodigofiscal.AsInteger:= qryConsultaProdutoscodigofiscal.AsInteger;
      qryProdutosprodutovisual.AsString:= qryConsultaProdutosprodutovisual.AsString;
      PreencherCampoRequerido(qryConsultaProdutosfilial,qryProdutosfilial);
      PreencherCampoRequerido(qryConsultaProdutosmovimento,qryProdutosmovimento);
      qryProdutosunidade.AsString:= qryConsultaProdutosunidade.AsString;
      qryProdutosquantidade.AsFloat:= qryConsultaProdutosquantidade.AsFloat;
      qryProdutosquantidadeantesgravar.AsFloat:= qryConsultaProdutosquantidadeantesgravar.AsFloat;
      qryProdutosprecovenda.AsFloat:= qryConsultaProdutosprecovenda.AsFloat;
      qryProdutosvalordescontoitem.AsFloat:= qryConsultaProdutosvalordescontoitem.AsFloat;
      qryProdutosprecotabela.AsFloat:= qryConsultaProdutosprecotabela.AsFloat;
      qryProdutosdescricaoprecovenda.AsString:= qryConsultaProdutosdescricaoprecovenda.AsString;
      qryProdutosaliquotaicms.AsFloat:= qryConsultaProdutosaliquotaicms.AsFloat;
      qryProdutosfatorsubstituicao.AsFloat:= qryConsultaProdutosfatorsubstituicao.AsFloat;
      PreencherCampoRequerido(qryConsultaProdutosicms,qryProdutosicms);
      qryProdutosincidencia.AsString:= qryConsultaProdutosincidencia.AsString;
      qryProdutosorigem.AsString:= qryConsultaProdutosorigem.AsString;
      qryProdutosdescricao.AsString:= qryConsultaProdutosdescricao.AsString;
      qryProdutoslinha.AsString:= qryConsultaProdutoslinha.AsString;
      qryProdutoscoluna.AsString:= qryConsultaProdutoscoluna.AsString;
      qryProdutosvalorgrade1.AsString:= qryConsultaProdutosvalorgrade1.AsString;
      qryProdutosvalorgrade2.AsString:= qryConsultaProdutosvalorgrade2.AsString;
      PreencherCampoRequerido(qryConsultaProdutosipi,qryProdutosipi);
      qryProdutosaliquotaipi.AsFloat:= qryConsultaProdutosaliquotaipi.AsFloat;
      qryProdutosvaloripi.AsFloat:= qryConsultaProdutosvaloripi.AsFloat;
      qryProdutosclassificacaofiscal.AsString:= qryConsultaProdutosclassificacaofiscal.AsString;
      qryProdutosbaseicms.AsFloat:= qryConsultaProdutosbaseicms.AsFloat;
      qryProdutosreducaobase.AsFloat:= qryConsultaProdutosreducaobase.AsFloat;
      qryProdutospercentualreducaobase.AsFloat:= qryConsultaProdutospercentualreducaobase.AsFloat;
      qryProdutoscomposto.AsBoolean:= qryConsultaProdutoscomposto.AsBoolean;
      qryProdutosdiscriminarcomposto.AsString:= qryConsultaProdutosdiscriminarcomposto.AsString;
      qryProdutosdiscriminarpreco.AsBoolean:= qryConsultaProdutosdiscriminarpreco.AsBoolean;
      qryProdutostipopreco.AsInteger:= qryConsultaProdutostipopreco.AsInteger;
      PreencherCampoRequerido(qryConsultaProdutoscodigonota,qryProdutoscodigonota);
      qryProdutosserienotafiscalentrada.AsString:= qryConsultaProdutosserienotafiscalentrada.AsString;
      qryProdutosnumeronotafiscalentrada.AsInteger:= qryConsultaProdutosnumeronotafiscalentrada.AsInteger;
      qryProdutosprodutototal.AsFloat:= (qryConsultaProdutosprecovenda.AsFloat*qryConsultaProdutosquantidade.AsFloat);
      qryProdutosbaseicmssubst.AsFloat:= qryProdutosbaseicmssubst.AsFloat;
      qryProdutosvaloricmssubst.AsFloat:= qryConsultaProdutosvaloricmssubst.AsFloat;
      qryProdutosvaloripidigitado.AsBoolean:= qryConsultaProdutosvaloripidigitado.AsBoolean;
      qryProdutosvalorreducaobasedigitada.AsBoolean:= qryConsultaProdutosvalorreducaobasedigitada.AsBoolean;
      qryProdutosvaloricms.AsFloat:= qryConsultaProdutosvaloricms.AsFloat;
      Inc(COnt);
      qryProdutos.Post;
    end;
  qryConsultaProdutos.Next;
  end;
end;

procedure TdtmEmissaoNotaComplementar.CalcularValorTotalProdutos;
var
  Pos: TBookmark;
  Produto, baseicmssubst,
  valoricmssubst, valoricms,
  valoripi, baseicms: Real;
  QtdeProdutos: currency;
begin
  Produto := 0;
  baseicmssubst := 0;
  valoricmssubst := 0;
  QtdeProdutos := 0;
  valoricms := 0;
  valoripi  :=0;
  baseicms  := 0;
  Numero:= 1;
  dsrConsultaProdutos.OnDataChange:= nil;
  Pos := qryConsultaProdutos.GetBookmark;
  qryConsultaProdutos.DisableControls;
  try
    qryConsultaProdutos.First;
    while Not qryConsultaProdutos.Eof do
      if qryConsultaProdutosok.AsBoolean then
      begin
        Produto := Produto + Truncar(qryConsultaProdutosquantidade.AsCurrency * qryConsultaProdutosprecovenda.AsFloat,2);
        QtdeProdutos := QtdeProdutos + qryConsultaProdutosquantidade.AsCurrency;
        baseicmssubst := baseicmssubst + qryConsultaProdutosbaseicmssubst.AsCurrency;
        valoricmssubst := valoricmssubst + qryConsultaProdutosvaloricmssubst.AsCurrency;
        valoricms:= valoricms + qryConsultaProdutosvaloricms.AsCurrency;
        valorIpi := ValorIpi + qryConsultaProdutosvaloripi.AsCurrency;
        baseicms := baseicms + qryConsultaProdutosbaseicms.AsFloat;

        Numero:= Numero + 1;

        qryConsultaProdutos.Next
      end
      else
        qryConsultaProdutos.Next;
  finally
    PreencherProdutos;
    if (qryConsultaProdutos.IsEmpty) and (produto=0) then
      qryDadosFiscaisprodutos.Clear
    else
      qryDadosFiscaisprodutos.AsFloat := Produto;

    qryDadosFiscaisTotalQtdeProdutos.AsCurrency := QtdeProdutos;

    qryDadosFiscaisvaloricms.AsCurrency := valoricms;
    qryDadosFiscaisvaloripi.AsCurrency  := valoripi;
    qryDadosFiscaisbaseicms.AsCurrency  := baseicms;

    if TipoNotaSaida = tnsDEVOLUCAOFORNECEDOR then
      if qrydadosfiscais.State = dsinsert then
      begin
        if not TotalValorICMSSubstAlterado then
        begin
          if baseicmssubst = 0 then
            qryDadosFiscaistotalbaseicmssubstituicao.Clear
          else
            qryDadosFiscaistotalbaseicmssubstituicao.AsCurrency := baseicmssubst;

          if valoricmssubst = 0 then
            qryDadosFiscaistotalvaloricmssubstituicao.clear
          else
            qryDadosFiscaistotalvaloricmssubstituicao.AsCurrency := valoricmssubst;
        end;
      end;
    dsrConsultaProdutos.OnDataChange:= dsrConsultaProdutosDataChange;

    qryConsultaProdutos.GotoBookmark(Pos);
    qryConsultaProdutos.FreeBookmark(Pos);
    qryConsultaProdutos.EnableControls;
  end;
end;

function TdtmEmissaoNotaComplementar.getTipoNotaSaida: TtecTipoNotaSaida;
var
  CodFiscal: Integer;
begin
  CodFiscal := qryDadosFiscaiscodigofiscal.AsInteger mod 1000;
  if (CodFiscal = ctCFOTRANSFERENCIA_150) or
     (CodFiscal = ctCFOTRANSFERENCIA_151) or
     (CodFiscal = ctCFOTRANSFERENCIA_152) or
     (CodFiscal = ctCFOTRANSFERENCIANAOTRANS) or
     (CodFiscal = ctCFOTRANSFERENCIASUBSTITUICAO)
  then
    FTipoNotaSaida := tnsTRANSFERENCIA
  else if (CodFiscal = ctCFOTRANSFERENCIACREDITOICMS) or
          (CodFiscal = ctCFOTRANSFERENCIASALDOCREDORICMS) or
          (CodFiscal = ctCFOTRANSFERENCIASALDODEVEDORICMS)
  then
    FTipoNotaSaida := tnsTRANSFERENCIAICMS
  else if (CodFiscal = ctCFODEVOLUCAOSUBSTITUICAO) then
    FTipoNotaSaida := tnsDEVOLUCAOFORNECEDOR
  else
    FTipoNotaSaida := tnsNORMAL;

  result := FTipoNotaSaida;
end;

procedure TdtmEmissaoNotaComplementar.CalcularValoresNotaFiscal;
begin
  qryDadosFiscaistotalprodutos.AsCurrency :=
  qryDadosFiscaisprodutos.AsCurrency +
  qryDadosFiscaisacrescimo.AsCurrency -
  qryDadosFiscaisdesconto.AsCurrency;

  qryDadosFiscaisvalorvista.AsFloat := Truncar(
                    (qryDadosFiscaistotalprodutos.AsCurrency -
                     qryDadosFiscaisacrescimo.AsFloat +
                     qryDadosFiscaistotalvaloricmssubstituicao.AsCurrency +
                     qryDadosFiscaisvalorfrete.AsCurrency +
                     qryDadosFiscaisseguro.AsCurrency +
                     qryDadosFiscaisdespesasacessorias.AsCurrency +
                     qryDadosFiscaisvalorservicos.AsCurrency +
                     qryDadosFiscaisvaloripi.AsCurrency),2);

  qryDadosFiscaisvalortotal.AsFloat := qryDadosFiscaisvalorvista.AsFloat +
                                       qryDadosFiscaisacrescimo.AsFloat;
end;

