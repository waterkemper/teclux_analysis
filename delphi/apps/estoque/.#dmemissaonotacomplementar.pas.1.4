procedure TdtmEmissaoNotaComplementar.setReadOnly(const Value: Boolean);
begin
  if (qryDadosFiscais.State = dsInsert) then
  begin
    qryDadosFiscais.RequestLive := true;
    qryProdutos.RequestLive := true;
  end
  else
  begin
    qryDadosFiscais.RequestLive     := Not Value or UsuarioLogin.AlterarDadosContabeis;
    qryProdutos.RequestLive         := Not Value or UsuarioLogin.AlterarDadosContabeis;
  end
end;

