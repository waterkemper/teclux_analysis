var
 Listar : TStringList;
begin
  inherited;
  Listar := tStringlist.create;
  if fileexists('c:\notacomplementar.sql') then
    Listar.loadfromfile('c:\notacomplementar.sql');
  Listar.add('');
  Listar.add(sql);
  Listar.add(result);
  listar.savetofile('c:\notacomplementar.sql');
