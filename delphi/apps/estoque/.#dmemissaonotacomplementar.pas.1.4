procedure TdtmEmissaoNotaComplementar.dsrConsultaProdutosDataChange(
  Sender: TObject; Field: TField);
begin
  inherited;
  if (Field = qryConsultaProdutosvaloripi) or
     (Field = qryConsultaProdutosprecovenda) or
     (Field = qryConsultaProdutosquantidade) or
     (Field = qryConsultaProdutosvaloricms) then
  begin
    qryConsultaProdutosok.AsBoolean:= True;
    CalcularValorTotalProdutos;
    CalcularValoresNotaFiscal;
  end;
end;


procedure TdtmEmissaoNotaComplementar.dsrDadosFiscaisDataChange(
  Sender: TObject; Field: TField);
begin
  inherited;
  if (field = qryDadosFiscaisdesconto) or
     (field = qryDadosFiscaisacrescimo ) or
     (field = qryDadosFiscaisvalorservicos) or
     (field = qryDadosFiscaisfrete) or
     (field = qryDadosFiscaisseguro) or
     (field = qryDadosFiscaisvaloripi) or
     (field = qryDadosFiscaisvaloricms) or
     (field = qryDadosFiscaisdespesasacessorias) then
  begin
    dsrDadosFiscais.OnDataChange:= nil;
    CalcularValorTotalProdutos;
    CalcularValoresNotaFiscal;
    dsrDadosFiscais.OnDataChange:= dsrDadosFiscaisDataChange;
  end;
end;

procedure TdtmEmissaoNotaComplementar.CalcularImpostos;
begin
  while not dtmGerarNotaFiscal.qryCalculosDadosFiscais.IsEmpty do
    dtmGerarNotaFiscal.qryCalculosDadosFiscais.Delete;

  with dtmGerarNotaFiscal do
  begin
    if qryDadosFiscaisvaloricms.AsFloat > 0 then
    begin
      qryCalculosDadosFiscais.Append;
      qryCalculosDadosFiscaisnomeimposto.AsString:= 'ICMS';
      qryCalculosDadosFiscaistipo.AsString:= 'M';
      qryCalculosDadosFiscaisaliquota.AsFloat:= 0;
      qryCalculosDadosFiscaisbase.AsFloat:= qryDadosFiscaisprodutos.AsFloat;
      qryCalculosDadosFiscaisoutras.AsFloat:= qryDadosFiscaisvaloripi.AsFloat;
      qryCalculosDadosFiscaisvalor.AsFloat:= qryDadosFiscaisvaloricms.AsFloat;
      qryCalculosDadosFiscaisisentas.AsFloat:= 0;

      qryCalculosDadosFiscais.Post;
    end;
  end;
end;

