    Sql.Strings = (
      'SELECT * FROM'
      '('
      'select n.filial,'
      '         n.serie,'
      '         n.numero,'
      '         (select coalesce(f.razao,f.nome) as nome'
      '          from vfornecedores f'
      '          where (d.cliente = f.codigo) and'
      '                    (d.tipocliente = cast(f.tipo as char(1))))'
      '         as cliente,'
      '         n.dadofiscal,'
      '         d.data,'
      '         d.tipocliente'
      'from notas n, dadosfiscais d'
