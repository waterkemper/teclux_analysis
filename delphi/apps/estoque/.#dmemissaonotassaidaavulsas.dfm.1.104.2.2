    Sql.Strings = (
      'select p.descricao,'
      '         p.valorgrade1,'
      '         p.valorgrade2,'
      '         p.codigo as produto,'
      '         p.codigovisual as produtovisual,'
      ''
      '         pdf.precovenda /* -'
      '         (pnp.desconto / pnp.quantidade) +'
      '         (pnp.acrescimo / pnp.quantidade) */ as preco,'
      ''
      '         pdf.precovenda as ultimocustomedio,'
      
        '         (case when (e.financeiro = 0) or (e.financeiro is null)' +
        ' then 0'
      
        '                  else round(e.financeiro/coalesce(nullif(quanti' +
        'dadetotaldoestoque(e.produto,e.filial),0),1),2)'
      '          end) as customedio,'
      ''
      '         e.valorultimacompra,'
      '         pdf.numero as NumeroProdutoTabela'
      ''
      'from (dadosfiscais df'
      '      join (produtosdadosfiscais pdf'
      '            join (produtos p'
      '                  join estoques e'
      '                  on p.codigo = e.produto)'
      '            on pdf.produto = p.codigo)'
      '      on df.numero = pdf.dadofiscal)'
      ''
      'where df.numero = pdf.dadofiscal'
      '  and pdf.produto = p.codigo'
      '  and p.codigo = e.produto'
      ''
      '  and ( cast(p.codigo as varchar) = :produtovisual or'
      
        '        upper(to_ascii(p.codigovisual,'#39'latin1'#39')) = upper(to_asci' +
        'i(:produtovisual,'#39'latin1'#39')) or'
      ''
      #9#9'p.codigo in (select pcb.produto'
      '                      from produtoscodigobarras pcb'
      '                      where pcb.codigobarras = :produtovisual)'
      #9'   )'
      ''
      '  and (pdf.numero = :numeroproduto or :numeroproduto is null)'
      '  and df.numero = :dadofiscal'
      '  and e.filial = :FilialBase'
      ''
      ''
      '%SQLListas'
      ''
      ''
      '/*'
      ''
      ':numeroproduto'
      ':codigonota'
      ''
      '*/')
