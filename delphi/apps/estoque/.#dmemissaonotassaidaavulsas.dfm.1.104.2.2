    Sql.Strings = (
      'select n.descricao,'
      
        '         case when '#39'F'#39' = :local then case when n.codigofiscal = ' +
        '5405 then n.codigofiscal + 999 else n.codigofiscal + 1000 end'
      '                 when '#39'E'#39' = :local then n.codigofiscal + 2000'
      '                 else  n.codigofiscal'
      '         end as codigofiscal,'
      '         n.tipomovimento,'
      '         (select t.operacao'
      '          from tiposmovimentos t'
      '          where t.codigo = n.tipomovimento'
      '         ) as operacao,'
      '         (select t.transferencia'
      '          from tiposmovimentos t'
      '          where t.codigo = n.tipomovimento'
      '         ) as transferencia,'
      '         n.debitar,'
      '         n.creditar,'
      '         n.historico,'
      '         n.gerarpagamento,'
      '         n.descricao as descricaonatureza,'
      
        '         n.codigo as codigonatureza, n.destacaripi, n.naoutiliza' +
        'robsautomaticas,'
      
        '         n.tipo, n.icmscst, n.ipicst, n.piscst, n.cofinscst, n.c' +
        'redbigualvalornota, n.GravarSemLanctos, n.lanctoscustomedio, n.N' +
        'aoGerarDebitoICMS, n.NaoGerarDebitoIPI, n.NaoCalcularIPISobreFre' +
        'te, n.icmssobreipi, n.naocalcularvaloresicmsdiferimento, n.Reque' +
        'rNFEntrada'
      
        'from naturezas n join codigosfiscais cf on n.codigofiscal = cf.c' +
        'odigo'
      'where (n.inativo is null)'
      '/*   and (Not n.gerarpagamento or (n.gerarpagamento is null)) */'
      '   and (n.tipo in ('#39'S'#39','#39'R'#39'))'
      '   %codigoconsulta'
      
        '   and ((case when '#39'F'#39' = :local and n.codigofiscal = 5405 then 4' +
        '04 else (mod(n.codigofiscal,1000)) end) = (select mod(cf.codigo,' +
        '1000)'
      
        '                                                                ' +
        '                                           from codigosfiscais c' +
        'f'
      
        '                                                                ' +
        '                                           where cf.codigo = :co' +
        'digofiscal))'
      
        '   and case when :finalidade = 4 then cf.devolucaoretorno else n' +
        'ot cf.devolucaoretorno end'
      '/*'
      '   and (Not ((mod(n.codigofiscal,1000)) in ('
      '          %ListaVendas'
      '          )))*/')
