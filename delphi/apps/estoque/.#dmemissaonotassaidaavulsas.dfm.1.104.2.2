  object qryDadosFiscais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeInsert = qryDadosFiscaisBeforeInsert
    AfterInsert = qryDadosFiscaisAfterInsert
    BeforeEdit = qryDadosFiscaisBeforeEdit
    BeforePost = qryDadosFiscaisBeforePost
    AfterCancel = qryDadosFiscaisAfterCancel
    AfterScroll = qryDadosFiscaisAfterScroll
    OnCalcFields = qryDadosFiscaisCalcFields
    OnNewRecord = qryDadosFiscaisNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select df.*,'
      '       n.filial,'
      '       n.serie,'
      '       n.numero as numeronota,'
      '       n.dadofiscalvinculado,'
      '       coalesce(df.valorprodutos,0) +'
      '       (coalesce(df.valortotal,0) -'
      '        coalesce(df.valorvista,0)) -'
      '       coalesce(df.desconto,0) as totalprodutos,'
      '       (cast(null as Numeric(9,3))) as totalqtdeprodutos,'
      
        '       (select sum(pdf.vCredICMSSN) from produtosdadosfiscais pd' +
        'f where pdf.dadofiscal = df.numero) as vCredICMSSN,'
      
        '       (select sum(pdf.vBCSTRet) from produtosdadosfiscais pdf w' +
        'here pdf.dadofiscal = df.numero) as vBCSTRet,'
      
        '       (select sum(pdf.vICMSSTRet) from produtosdadosfiscais pdf' +
        ' where pdf.dadofiscal = df.numero) as vICMSSTRet,'
      
        '       (select sum(pdf.icmsbasecalculo_dev) from produtosdadosfi' +
        'scais pdf where pdf.dadofiscal = df.numero) as icmsbasecalculo_d' +
        'ev,'
      
        '       (select sum(pdf.icmsvalor_dev) from produtosdadosfiscais ' +
        'pdf where pdf.dadofiscal = df.numero) as icmsvalor_dev,'
      
        '       cast(df.chv_nfe|| cast(df.digchaveacesso as varchar) as c' +
        'har(44)) as chave_nfe,'
      '       cast(null as numeric(15,4)) as peso,'
      '       cast(null as integer) as volumes,'
      ''
      
        '       (select nref.filial from notas nref where nref.dadofiscal' +
        ' = df.dadofiscalreferenciado) as filialnotasaidareferenciada,'
      
        '       (select nref.serie from notas nref  where nref.dadofiscal' +
        ' = df.dadofiscalreferenciado) as serienotasaidareferenciada,'
      
        '       (select nref.numero from notas nref where nref.dadofiscal' +
        ' = df.dadofiscalreferenciado) as numeronotasaidareferenciada,'
      ''
      
        '       (select nref.fornecedor from notaspag nref where nref.cod' +
        'igo = df.codigonotareferenciado) as fornecedornotaentradareferen' +
        'ciada,'
      
        '       (select nref.tipofornecedor from notaspag nref where nref' +
        '.codigo = df.codigonotareferenciado) as tipofornecedornotaentrad' +
        'areferenciada,'
      
        '       (select nref.serie from notaspag nref where nref.codigo =' +
        ' df.codigonotareferenciado) as serienotaentradareferenciada,'
      
        '       (select nref.numero from notaspag nref where nref.codigo ' +
        '= df.codigonotareferenciado) as numeronotaentradareferenciada,'
      ''
      
        '       (select sum(vdf.valorvencto) from venctosdadosfiscais vdf' +
        ' where vdf.dadofiscal = df.numero) as TotalValorVencto,'
      ''
      
        '       coalesce((select cf.exigenotareferenciada from codigosfis' +
        'cais cf where cf.codigo = df.codigofiscal),false) as exigenotare' +
        'ferenciada,'
      ''
      '      (select cf.codigoibge'
      '       from cidades cF'
      '       where cf.estado = f.estado'
      '         and cf.codigo = f.cidade) as CodigoCidadeIBGEFilial,'
      ''
      '      f.cnpj as CNPJFilial,'
      ''
      '      cast(null as varchar(1000)) as obsimpostosretidos'
      ''
      'from dadosfiscais df, notas n, filiais f'
      'where n.dadofiscal = df.numero and'
      '      df.filialemissao = f.codigo and'
      '          n.filial       = :filialbase and'
      '          n.serie     = :serie and'
      '          n.numero = :numero')
    RequestLive = True
    Left = 56
    Top = 117
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'filialbase'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'serie'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'numero'
        ParamType = ptUnknown
        Value = '0'
      end>
