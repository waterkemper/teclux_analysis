    Sql.Strings = (
      '/* produto filial fornecedor tipofornecedor serie numero*/'
      ';'
      'select * from'
      '('
      '('
      '  select np.fornecedor,'
      '         np.tipofornecedor,'
      '         np.serie,'
      '         np.numero,'
      '         np.codigo,'
      '         np.data,'
      '         np.chv_nfe as NumeroNFe,'
      '         vf.pessoanumero,'
      '         np.modelodocto,'
      '         np.numero as NumeroNF,'
      ''
      '        (select c.CodigoIBGE'
      '                   from cidades c'
      '                   where c.estado = vf.estado'
      '                     and c.codigo = vf.cidade) as CidadeIBGE'
      ''
      
        '  from notaspag np join vfornecedores vf on np.fornecedor = vf.c' +
        'odigo and np.tipofornecedor = vf.tipo'
      ''
      '  where  (np.fornecedor = :fornecedor'
      '         and np.tipofornecedor = :tipofornecedor'
      '         and np.serie  = :Serie'
      '         and np.numero = :Numero)'
      ''
      '  %SQL'
      ''
      ')'
      ''
      'union all'
      ''
      '('
      ''
      '  select df.cliente as fornecedor,'
      '         df.tipocliente as tipofornecedor,'
      '         n.serie,'
      '         n.numero,'
      '         df.numero as codigo,'
      '         df.data,'
      '         df.chv_nfe as NumeroNFe,'
      '         vf.pessoanumero,'
      '         df.modelodocto,'
