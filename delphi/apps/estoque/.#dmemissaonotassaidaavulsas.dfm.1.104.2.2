    AfterInsert = qryProdutosAfterInsert
    BeforeEdit = qryProdutosBeforeEdit
    BeforePost = qryProdutosBeforePost
    AfterPost = qryProdutosAfterPost
    BeforeCancel = qryProdutosBeforeCancel
    AfterScroll = qryProdutosAfterScroll
    OnCalcFields = qryProdutosCalcFields
    OnNewRecord = qryProdutosNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      
        'select coalesce(pdf.produtodigitado, p.codigovisual) as produtod' +
        'igitado, '
      '       pdf.*,'
      '       p.codigovisual as produtovisual,'
      '       pdf.quantidade as quantidadeantesgravar,'
      
        '       (select gr.descricao from grades gr where gr.codigo = c.g' +
        'rade1) as Linha,'
      
        '       (select gr.descricao from grades gr where gr.codigo = c.g' +
        'rade2) as Coluna,'
      '       p.valorgrade1,'
      '       p.valorgrade2,'
      '       c.composto,'
      '       c.discriminarcomposto,'
      '       c.discriminarpreco,'
      
        '       (select np.fornecedor from notaspag np where np.codigo = ' +
        'pdf.codigonota) as FornecedorNotaFiscalEntrada,'
      
        '       (select np.tipofornecedor from notaspag np where np.codig' +
        'o = pdf.codigonota) as TipoFornecedorNotaFiscalEntrada,'
      
        '       (select np.serie from notaspag np where np.codigo = pdf.c' +
        'odigonota) as SerieNotaFiscalEntrada,'
      
        '       (select np.numero from notaspag np where np.codigo = pdf.' +
        'codigonota) as NumeroNotaFiscalEntrada,'
      
        '       trunc(pdf.precovenda * pdf.quantidade ,2) as produtototal' +
        ','
      '       cast(0 as integer) as tipopreco,'
      '       '#39#39' as tipomovimento,'
      '       '#39#39' as operacao,'
      '       '#39#39' as transferencia,'
      '       false as destacarIPI,'
      ''
      '       (case when pdf.codigonota is not null then'
      '         (select sum(pnp.qtdeestoque)'
      '          from produtosnotaspag pnp'
      '          where pnp.codigonota = pdf.codigonota'
      '            and pnp.produto = pdf.produto) -'
      ''
      '         (select sum(pdf2.qtdeestoque)'
      '          from produtosdadosfiscais pdf2 ,dadosfiscais df2'
      '          where df2.numero=pdf2.dadofiscal'
      '            and df2.situacao='#39'N'#39
      '            and pdf2.dadofiscal <> pdf.dadofiscal'
      '            and pdf2.codigonota = pdf.codigonota)'
      ''
      
        '       else cast(null as numeric(9,3)) end) as quantidadenotaent' +
        'rada,'
      ''
      ''
      '       (case when pdf.codigonota is not null and'
      '                  pdf.numeroprodutotabela is not null and'
      '                  pdf.produto is not null then'
      ''
      '         (select sum(pnp.qtdeestoque)'
      '          from produtosnotaspag pnp'
      '          where pnp.codigonota = pdf.codigonota'
      '            and pnp.numero = pdf.numeroprodutotabela'
      '            and pnp.produto = pdf.produto)'
      ''
      
        '       else cast(null as numeric(9,3)) end) as quantidadenotaori' +
        'gem,'
      ''
      
        '       false as InformacoesSTdaNotadeEntrada,  /* utilizado para' +
        ' controlar os dados qdo trocado o codigo fiscal selecionado de u' +
        'ma nota de entrada*/'
      ''
      '       true as produtook,'
      
        '       (select u.descricao from unidades u where u.codigo = pdf.' +
        'unidade) as descricaounidade,'
      
        '       (select pf.lotetransferencia from pedidosfiliais pf where' +
        ' pf.dadofiscal = pdf.dadofiscal and pf.produto = pdf.produto) as' +
        ' lotetransferencia'
      ''
      'from produtosdadosfiscais pdf, produtos p, caracteristicas c'
      'where pdf.dadofiscal = :dadofiscal and'
      '           pdf.produto = p.codigo and'
      '           p.caracteristica = c.codigo'
      'order by pdf.numero')
    RequestLive = True
