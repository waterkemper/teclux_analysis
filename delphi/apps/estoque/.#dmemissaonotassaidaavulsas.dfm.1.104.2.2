      '       pdf.dadofiscal as NumeroDocumentoTabela,'
      #9'     pdf.numero as NumeroProdutoTabela ,'
      '       pdf.fatorconversao ,'
      '       cast(null as NUMERIC(9,3)) as quantidadenotaentrada'
      ''
      ''
      'from (dadosfiscais df'
      '     join (produtosdadosfiscais pdf'
      #9'       join ((produtos p'
      '   '#9'           join caracteristicas c'
      '               on p.caracteristica = c.codigo)'
      ''
      '              join estoques e'
      '              on p.codigo = e.produto)'
      ''
      '           on pdf.produto = p.codigo)'
      '     on df.numero = pdf.dadofiscal)'
      ''
      'where df.numero = :dadofiscal'
      '  and df.numero = pdf.dadofiscal'
      '  and pdf.produto = p.codigo'
      '  and p.codigo = e.produto'
      '  and p.caracteristica = c.codigo'
      '  and e.filial = df.filialemissao'
      ''
      '%FiltrarProdutos'
      ''
      '%SQLListas'
      ''
      
        'order by UPPER(TO_ASCII(p.descricao,'#39'latin1'#39')), p.valorgrade1, p' +
        '.valorgrade2'
      ''
      ''
      '/*'
