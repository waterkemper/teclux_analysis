        '  from pedidosfiliais pf join produtos p on pf.produto = p.codig' +
        'o'
      '  where pf.lotetransferencia = :lotetransferencia'
      ') as selecao'
      'where coalesce(selecao.qtderecebida,0) <>'
      '      coalesce(selecao.lido,0)'
      'order by lotetransferencia, produto      ')
