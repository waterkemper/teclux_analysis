      '                 where m.numero = (select max(m2.numero)'
      '                                   from movimentos m2'
      '                                    where m2.produto = p.codigo'
      #9#9#9#9#9#9#9#9#9'  and m2.filial = e.filial)'
      '                     ),0) as reservado,'
      '       c.unidade,'
