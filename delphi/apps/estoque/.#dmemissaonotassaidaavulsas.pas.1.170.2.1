function TdtmEmissaoNotaAvulsas.ConverterTamanho(campo: Integer): Integer;
Var VAlor: string;
begin
  Valor:= currtostr(Truncar((campo/8),0));
  Result:= strtoint(Valor);
end;

function TdtmEmissaoNotaAvulsas.CompararCampo(Campo: String): String;
var TamanhoCampo: Integer;
begin
  TamanhoCampo := Length(Campo);
  if TamanhoCampo < FTamanho then
  begin
    while not (TamanhoCampo = FTamanho) do
    Begin
      Campo:= Campo + ' ';
      Inc(TamanhoCampo);
      Result:= CAmpo;
    end;
  end
  else
    Result:= Copy(Campo,0, Ftamanho);
end;

function TdtmEmissaoNotaAvulsas.CompararCampoDireita(Campo: String): String;
var TamanhoCampo: Integer;
    TrimCampo: String;
begin
  TrimCampo:= Trim(Campo);
  TamanhoCampo := Length(TrimCampo);
  if TamanhoCampo < FTamanho then
  begin
    while not (TamanhoCampo = FTamanho) do
    Begin
      Campo:= ' ' + Campo;
      Inc(TamanhoCampo);
      Result:= CAmpo;
    end;
  end
  else
    Result:= Copy(Campo,0, Ftamanho);
end;

function TdtmEmissaoNotaAvulsas.CompararCampoCentro(Campo: String): String;
var TamanhoCampo, Meio, a, Resto,
    TotalCampo: Integer;
    TrimCampo: String;
begin
  A:=0;
  TrimCampo:= Trim(Campo);
  TamanhoCampo := Length(TrimCampo);
  if TamanhoCampo < FTamanho then
  begin
    Meio:= strtoint(currtostr(Truncar(((FTamanho - TamanhoCampo)/2),0)));
    Resto:= (Meio + TamanhoCampo);
    IF Meio > 0 then
    begin
      while not (a = Meio) do
      begin
        Campo:= ' ' + Campo;
        Inc(a);
      end;
    end;
    a:= 0;
    TotalCampo:= Length(Campo);
    if TotalCAmpo < FTamanho then
    begin
      while not (TotalCampo = FTamanho) do
      begin
        Campo:= Campo + ' ';
        inc(TotalCampo);
        Result:= Campo;
      end;
    end;
  end
  else
    Result:= Copy(Campo,0, Ftamanho);
end;
