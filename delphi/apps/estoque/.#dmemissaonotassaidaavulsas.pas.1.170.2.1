function TdtmEmissaoNotaAvulsas.TabelaReferenciada: TtecQuery;
var
  vListaCodigosNotasPag: String;
  vRegistroAtual : TBookMark;

begin
  result := nil;
  vListaCodigosNotasPag := RetornarLista(qryProdutos, qryProdutoscodigonota);
  if vListaCodigosNotasPag = '' then
    vListaCodigosNotasPag := '0';

  qryNotaEntradaRef.macrobyname('SQL').asString := 'or np.codigo in ('+vListaCodigosNotasPag+')';
  qryNotaEntradaRef.ParamByName('dadofiscalreferenciado').asinteger := qryDadosFiscaisdadofiscalreferenciado.AsInteger;

  qryNotaEntradaRef.close;
  qryNotaEntradaRef.open;

  vRegistroAtual := qryProdutos.GetBookmark;
  qryprodutos.DisableControls;
  qryprodutos.First;
  while not qryprodutos.Eof do
  begin
    if qryProdutoscodigonota.IsNull and not qryProdutoschv_nfe_referenciada.IsNull then
    begin
      if not qryNotaEntradaRef.Locate('numeronfe', qryProdutoschv_nfe_referenciada.asString, []) then
      begin
        qryNotaEntradaRef.append;
        qryNotaEntradaRefnumeronfe.AsString := qryProdutoschv_nfe_referenciada.asString;
        qryNotaEntradaRef.post;
      end;
    end;
    qryprodutos.Next;
  end;
  qryprodutos.EnableControls;
  qryprodutos.GotoBookmark(vRegistroAtual);
  qryprodutos.FreeBookmark(vRegistroAtual);

  qryNotaEntradaRef.macrobyname('SQL').asString := '';
  qryNotaEntradaRef.ParamByName('dadofiscalreferenciado').clear;

  result := qryNotaEntradaRef;
end;

