procedure TdtmEmissaoNotaAvulsas.gerarProdutosdoLotedeTransferencia(LoteTransferencia: integer);
begin

  qrypedidosfiliais.macrobyname('Condicao').asString := ' and pf.lotetransferencia = ' + inttostr(LoteTransferencia);
  qrypedidosfiliais.close;
  qrypedidosfiliais.open;
  dsrProdutos.OnDataChange := nil;


  if (qryProdutos.state in [dsedit, dsinsert]) then
    qryProdutos.cancel;

    {
  while qryProdutos.RecordCount > 0 do
    qryProdutos.Delete;
    }

  qrypedidosfiliais.First;
  while Not qrypedidosfiliais.Eof do
  begin
    if qrypedidosfiliaisqtderecebida.AsFloat <> 0 then
    begin

      if not qryprodutos.locate('produto;lotetransferencia',VarArrayOf([qrypedidosfiliaisproduto.AsLargeInt, LoteTransferencia]),[]) then
      begin
        qryProdutos.Append;
  //      qryProdutosnumero.AsInteger             := qryProdutos.recno;
        qryProdutosproduto.AsLargeInt           := qrypedidosfiliaisproduto.AsLargeInt;
      end
      else
        qryProdutos.edit;

      qryProdutosprodutook.AsBoolean := true;

      qryProdutosprodutovisual.AsString       := qrypedidosfiliaisprodutovisual.AsString;
      qryProdutosprodutodigitado.AsString     := qrypedidosfiliaisprodutovisual.AsString;

      qryProdutosfilial.AsInteger             := Filialbase;
      qryProdutosfatorconversao.asfloat := 1;
      qryProdutosquantidade.AsFloat        := qrypedidosfiliaisqtderecebida.AsFloat;
      qryProdutosqtdeestoque.AsFloat   := qryProdutosquantidade.AsFloat * qryProdutosfatorconversao.AsFloat;
      qryProdutoslotetransferencia.asinteger := LoteTransferencia;

      qryProdutostipopreco.AsInteger := ord(FTipoPreco);

      AtribuirDadosProdutos(qryprodutos, qryDadosFiscais, qryProcuraCodigoFiscalProduto, False, NotaAvulsa);
      GravarProduto;
    end;

    qrypedidosfiliais.Next

  end;

  dsrProdutos.OnDataChange := dsrProdutosDataChange;

  CalcularImpostos(true, qryprodutos, qryDadosFiscais, true, true, true, qryCalculosProdutos, nil, false, NotaAvulsa,
  qryDadosFiscaisvendaconsumidorfinal.asboolean, qryDadosFiscaisclientecontribicms.asboolean);
end;

procedure TdtmEmissaoNotaAvulsas.RefazerNumeroProdutos;
begin
  if qryProdutos.Active then
  begin
    qryProdutos.AfterScroll := nil;
    GuardarRegistroAtual(qryProdutos,true);
    qryProdutos.SortByField('numero');
    qryProdutos.First;
    while not qryProdutos.Eof do
    begin
      qryProdutos.Edit;
      qryProdutosnumero.AsInteger := qryProdutos.RecNo;
      qryprodutos.Post;
      qryprodutos.Next;
    end;
    VoltarRegistroAtual(qryProdutos);
    qryProdutos.AfterScroll     := qryProdutosAfterScroll;
  end;
end;

