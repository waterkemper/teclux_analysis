procedure TdtmEmissaoNotaAvulsas.qryProdutosprodutoChange(Sender: TField);
begin
  inherited;
  if (qryProcuraProduto.recordcount = 1) and
     (qryProdutos.State in [dsinsert, dsedit]) then
  begin
    dsrDadosFiscais.onDataChange := nil;
    dsrProdutos.OnDataChange := nil;
    if qryProcuraProdutonumeroprodutotabela.asinteger <> 0 then
      qryProdutosnumeroprodutotabela.asinteger := qryProcuraProdutonumeroprodutotabela.asinteger
    else
      qryProdutosnumeroprodutotabela.clear;

    //caso inserindo insere ultimo tipo de preco utilizado, se nao utiliza o ja selecionado
    if qryProdutos.State=dsInsert then
    begin
      if      TipoPreco=tpnVENDA      then qryProdutostipopreco.AsInteger := 0
      else if TipoPreco=tpnCUSTOMEDIO then qryProdutostipopreco.AsInteger := 1
      else                                 qryProdutostipopreco.AsInteger := 2;
    end;
    qryProdutosvaloripidigitado.AsBoolean := false;
    qryProdutosvaloricmsdigitado.AsBoolean := false;
    qryProdutosvaloricmsstdigitado.AsBoolean := false;
    qryProdutosvalorpisdigitado.AsBoolean := false;
    qryProdutosvalorcofinsdigitado.AsBoolean := false;


    qryProdutosvaloripi.clear;

    AtribuirDadosProdutos(qryprodutos, qryDadosFiscais, qryProcuraCodigoFiscalProduto, False, NotaAvulsa);

    if (DeveCalcularImpostos) and (qryProdutosquantidade.AsFloat<>0) and
       ((qryProdutosprecovenda.AsFloat<>0) or
        ((qryProcuraCodigoFiscaltipomovimento.AsString = '') and (qryProdutosprecovenda.AsFloat=0))) then
      CalcularImpostos(true, qryprodutos, qryDadosFiscais, true, true, true, qryCalculosProdutos, nil, false, NotaAvulsa,
      qryDadosFiscaisvendaconsumidorfinal.asboolean, qryDadosFiscaisclientecontribicms.asboolean);

    dsrDadosFiscais.onDataChange := dsrDadosFiscaisDataChange;
    dsrProdutos.OnDataChange := dsrProdutosDataChange;
    //forcar atribuicao csts
//    dsrProdutosDataChange(qryprodutos, qryProdutoscodigofiscal)
  end;

end;

procedure TdtmEmissaoNotaAvulsas.ExcluirInformacoesDadoFiscal(Cancelar: Boolean);
begin
  if (qryDadosFiscaisdadofiscalvinculado.AsInteger <> 0) then
  begin
    RefazConsultaPorNome(qryDadosFiscaisCupom,['dadofiscal'],[qryDadosFiscaisdadofiscalvinculado.AsInteger]);
    if qryDadosFiscaisCupom.RecordCount = 1 then
    begin
      qryDadosFiscaisCupom.Edit;
      qryDadosFiscaisCupomcodigofiscal.AsInteger := 5102; {Voltar a situação original do cupom ao cancelar a nota vinculada pois ao vincular é atribuido 5929}
      qryDadosFiscaisCupom.post;
    end;
  end;


(*  try
    if qryDadosFiscaisdadofiscalvinculado.AsInteger = 0 then {Notas vinculadas não alteraram a movimentação de produtos nem o a situação do contrato }
      ReadOnly := False;
 *)

    NullMovimentoProdutosDadosFiscais(Cancelar);

    if (qryDadosFiscaisdadofiscalvinculado.AsInteger = 0) then  {Notas vinculadas não alteraram a movimentação de produtos}
      ExcluirMovimentos;

    if (qryDadosFiscaisdadofiscalvinculado.AsInteger = 0) then {Notas vinculadas não alteraram a situação do contrato}
      VerificarContratos;

{  finally
    qryMovimentos.Sql[31] := 'm.numero = 0';
    ReadOnly := True;
  end}


  if qryDadosFiscaisvendatransferencia.AsBoolean then
  begin
    ReFazConsulta(qryParcelas, [0], [qryDadosFiscaiscontrato.AsString]);
    LimparTabela(qryParcelas);
    qrycontratos.Delete;
    if not (qryDadosFiscais.state in [dsedit, dsinsert]) then
      qryDadosFiscais.edit;
    qryDadosFiscaiscontrato.Clear;
    qryDadosFiscais.post;
  end;

  if cancelar then   {Nota Eletronica sempre será cancelar}
  begin
    if not qryDadosFiscaisnumcancelamentonfe.isnull or not qryDadosFiscaisnuminutilizacaonfe.isnull or not CondicaoEmissorNFE or
       (qryDadosFiscaisStatusNFSe.AsInteger in [1,3]) then
    begin
      qryDadosFiscais.Edit;
      qryDadosFiscaissituacao.AsString := 'C';
      qryDadosFiscaisdatacancelamento.AsDateTime := DataLocal;
      qryDadosFiscais.Post;

      LimparCampos(qryprodutos, [qryProdutoscodigonota, qryProdutoscodigonotaoriginal,
                                 qryProdutosnumeroprodutotabela,
                                 qryProdutosnumeroprodutooriginal,
                                 qryProdutosprodutooriginal]);

      if (qryDadosFiscaisStatusNFSe.AsInteger = 3) then
      begin
        qrydadosfiscais.AfterScroll := nil;
        qrydadosfiscais.Delete;
        qrydadosfiscais.AfterScroll := qryDadosFiscaisAfterScroll;
      end;

    end;
  end
  else
  begin
    qrydadosfiscais.AfterScroll := nil;
    qrydadosfiscais.Delete;
    qrydadosfiscais.AfterScroll := qryDadosFiscaisAfterScroll;
  end;




end;

