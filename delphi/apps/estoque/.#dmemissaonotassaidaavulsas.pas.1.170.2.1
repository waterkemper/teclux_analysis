procedure TdtmEmissaoNotaAvulsas.AtualizarListaProdutos;
var
  Posicao: TBookmark;
  PosicaoCodigoNota : Integer;
  ListaProdutos: String;

begin
  ListaProdutosNotasSelecionadas[CodigoNota].Clear;
  ListaProdutosNotasSelecionadas[produto].Clear;

  Posicao := qryProdutos.GetBookmark;
  qryProdutos.DisableControls;
  try
    qryProdutos.First;
    while not qryProdutos.Eof do
    begin
      if qryDadosFiscaisdadofiscalreferenciado.AsInteger <> 0 then
      begin
        PosicaoCodigoNota := ListaProdutosNotasSelecionadas[CodigoNota].IndexOf(qryDadosFiscaisdadofiscalreferenciado.asstring);
        if PosicaoCodigoNota <> -1 then
        begin
          ListaProdutos := ListaProdutosNotasSelecionadas[produto].Strings[PosicaoCodigoNota];
          if qryDadosFiscaisdadofiscalreferenciado.AsInteger <> 0 then
            if Pos('('+qryProdutosproduto.AsString+','+qryProdutosnumeroprodutotabela.AsString+')', ListaProdutos)=0 then
              ListaProdutosNotasSelecionadas[produto].Strings[PosicaoCodigoNota] :=
                ListaProdutos + '('+qryProdutosproduto.AsString+','+qryProdutosnumeroprodutotabela.AsString+')'
          else
            if Pos('('+qryProdutosproduto.AsString+')',ListaProdutos)=0 then
              ListaProdutosNotasSelecionadas[produto].Strings[PosicaoCodigoNota] :=
                ListaProdutos + '(' + qryProdutosproduto.AsString + ')'
        end
        else
        begin
          ListaProdutosNotasSelecionadas[CodigoNota].Append(qryDadosFiscaisdadofiscalreferenciado.AsString);
          if qryDadosFiscaisdadofiscalreferenciado.AsInteger <> 0 then
            ListaProdutosNotasSelecionadas[produto].Append('('+qryProdutosproduto.AsString+','+qryProdutosnumeroprodutotabela.asString+')')
          else
            ListaProdutosNotasSelecionadas[produto].Append('('+qryProdutosproduto.AsString+')');
        end;
      end
      else
      begin
        PosicaoCodigoNota := ListaProdutosNotasSelecionadas[CodigoNota].IndexOf(qryProdutoscodigonota.asstring);
        if PosicaoCodigoNota <> -1 then
        begin
          ListaProdutos := ListaProdutosNotasSelecionadas[produto].Strings[PosicaoCodigoNota];
          if qryProdutoscodigonota.AsInteger <> 0 then
            if Pos('('+qryProdutosproduto.AsString+','+qryProdutosnumeroprodutotabela.AsString+')', ListaProdutos)=0 then
              ListaProdutosNotasSelecionadas[produto].Strings[PosicaoCodigoNota] :=
                ListaProdutos + '('+qryProdutosproduto.AsString+','+qryProdutosnumeroprodutotabela.AsString+')'
          else
            if Pos('('+qryProdutosproduto.AsString+')',ListaProdutos)=0 then
              ListaProdutosNotasSelecionadas[produto].Strings[PosicaoCodigoNota] :=
                ListaProdutos + '(' + qryProdutosproduto.AsString + ')'
        end
        else
        begin
          ListaProdutosNotasSelecionadas[CodigoNota].Append(qryprodutoscodigonota.AsString);
          if qryprodutoscodigonota.AsInteger <> 0 then
            ListaProdutosNotasSelecionadas[produto].Append('('+qryProdutosproduto.AsString+','+qryProdutosnumeroprodutotabela.asString+')')
          else
            ListaProdutosNotasSelecionadas[produto].Append('('+qryProdutosproduto.AsString+')');
        end;
      end;
      qryProdutos.Next;
    end;
  finally
    qryProdutos.GotoBookmark(Posicao);
    qryProdutos.FreeBookmark(Posicao);
    qryProdutos.EnableControls
  end;
end;

