procedure TdtmEmissaoNotaAvulsas.gerarProdutosdaNotadeEntrada;
var
  vFornecedorNotaEntrada, CodigoNota, NumeroNota, CodigoFiscalSelecionado: Integer;
  vTipoFornecedoNotaEntrada, Serie: String;
begin
  GerandoProdutosdaNota := true;
  vFornecedorNotaEntrada := qryProdutosfornecedornotafiscalentrada.asinteger;
  vTipoFornecedoNotaEntrada := qryProdutostipofornecedornotafiscalentrada.AsString;
  NumeroNota := qryProdutosnumeronotafiscalentrada.AsInteger;
  CodigoNota := qryProdutoscodigonota.AsInteger;
  Serie := qryProdutosserienotafiscalentrada.AsString;

//  RefazConsultaPorNome(qryProdutosNotasPag,['codigonota'],[CodigoNota]);

  if CodigoNota <> 0 then
  begin
    qryConsultaProdutos.Close;
    qryConsultaProdutos.Open;

    qryProcuraProdutoBeforeOpen(qryProcuraProduto);
    qryProcuraProduto.BeforeOpen := nil;

    CodigoFiscalSelecionado := qryProdutoscodigofiscal.AsInteger;
    if qryProdutos.State in [dsedit, dsinsert] then
      qryprodutos.cancel;

    dsrProdutos.OnDataChange := nil;
    qryProdutosproduto.OnChange := nil;
    

    try
      DeveCalcularImpostos:=false;
      qryProdutos.DisableControls;

      qryConsultaProdutos.First;
      while not qryConsultaProdutos.Eof do
      begin
        if not qryprodutos.Locate('codigonota;produto;numeroprodutotabela;filial',
                                        VarArrayof([inttostr(CodigoNota),
                                                    qryConsultaProdutoscodigo.AsString,
                                                    qryConsultaProdutosnumeroprodutotabela.AsInteger,
                                                    qryConsultaProdutosfilial.AsInteger]),[]) then
        begin
          qryProdutos.Append;
          qryProdutoscodigonota.AsInteger := codigonota;
          qryProdutosfornecedornotafiscalentrada.AsInteger := vFornecedorNotaEntrada;
          qryProdutostipofornecedornotafiscalentrada.AsString := vTipoFornecedoNotaEntrada;
          qryProdutosnumeronotafiscalentrada.AsInteger := NumeroNota;
          qryProdutosserienotafiscalentrada.AsString := Serie;
          qryProdutosnumeroprodutotabela.AsInteger := qryConsultaProdutosnumeroprodutotabela.AsInteger;
          qryProdutosquantidadenotaentrada.AsFloat := qryConsultaProdutosquantidadenotaentrada.AsFloat;
          qryProdutosfatorconversao.asfloat := qryConsultaProdutosfatorconversao.asfloat;
          qryProdutosquantidade.AsFloat := qryProdutosquantidadenotaentrada.AsFloat;

          qryProdutosqtdeestoque.AsFloat   := qryProdutosquantidade.AsFloat * qryProdutosfatorconversao.AsFloat;

          qryProdutosproduto .AsString             := qryConsultaProdutoscodigo.AsString;
          qryProdutosprodutovisual.AsString := qryConsultaProdutoscodigovisual.AsString;
          qryProdutosprodutodigitado.AsString := qryConsultaProdutosprodutodigitado.AsString;

          qryProcuraProduto.ParamByName('produtovisual').AsString := qryConsultaProdutoscodigovisual.AsString;
          qryProcuraProduto.ParamByName('numeroproduto').AsInteger := qryConsultaProdutosnumeroprodutotabela.AsInteger;
          qryprocuraproduto.Close;
          qryprocuraproduto.Open;

          qryProdutosprodutototal.AsCurrency := Truncar((qryProdutosprecovenda.     AsCurrency *
                                                      qryProdutosquantidade.AsFloat) , 2);

          qryProcuraCodigoFiscalProduto.BeforeOpen := nil;
          RefazConsultaPorNome(qryProcuraCodigoFiscalProduto,['codigofiscal'],[codigofiscalselecionado]);
          qryProcuraCodigoFiscalProduto.BeforeOpen := qryProcuraCodigoFiscalProdutoBeforeOpen;



          qryProdutosprodutoChange(qryProdutosproduto);

          //dsrProdutosDataChange(qryprodutos,qryProdutosproduto);
          GravarProduto;
          dsrProdutos.OnDataChange := nil;

        end;
        qryConsultaProdutos.Next;
      end;


    finally
      DeveCalcularImpostos:=true;
      CalcularImpostos(true, qryprodutos, qryDadosFiscais, true, true, true, qryCalculosProdutos, nil, false, NotaAvulsa,
      qryDadosFiscaisvendaconsumidorfinal.asboolean, qryDadosFiscaisclientecontribicms.asboolean);
      qryConsultaProdutos.Close;
      qryProcuraProduto.BeforeOpen := qryProcuraProdutoBeforeOpen;
      AtualizarListaProdutos;
      qryprodutos.EnableControls;
      dsrProdutos.OnDataChange := dsrProdutosDataChange;
      qryProdutosproduto.OnChange :=  qryProdutosprodutoChange;

//      CalcularValorTotalProdutos;
    end;
  end;
  GerandoProdutosdaNota := false;

end;


procedure TdtmEmissaoNotaAvulsas.gerarProdutosdoContrato(contrato, estado, pessoatipo: String);
begin

  ReFazConsulta(qryProdutosContratos,[0,1,2,3,4], [EstadoFilialBase,
                                                 estado,
                                                 pessoatipo,
                                                 contrato,
                                                 filialbase]);
  dsrProdutos.OnDataChange := nil;

  if (qryProdutos.state in [dsedit, dsinsert]) then
    qryProdutos.cancel;

  while qryProdutos.RecordCount > 0 do
    qryProdutos.Delete;

  qryProdutosContratos.First;
  while Not qryProdutosContratos.Eof do begin
    qryProdutos.Append;
    qryProdutosnumero.AsInteger             := qryProdutosContratosnumero.AsInteger;
    qryProdutosproduto.AsLargeInt           := qryProdutosContratosproduto.AsLargeInt;

    qryProdutosprodutook.AsBoolean := true;

    qryProdutosprodutovisual.AsString       := qryProdutosContratosprodutovisual.AsString;
    qryProdutosprodutodigitado.AsString     := qryProdutosContratosprodutodigitado.AsString;

    qryProdutosfilial.AsInteger             := qryProdutosContratosfilial.AsInteger;

    qryProdutosdescricaoproduto.AsString    := trim(qryProdutosContratosdescricao.AsString + ' ' +
                                                    qryProdutosContratosvalorgrade1.AsString + ' '+
                                                    qryProdutosContratosvalorgrade2.AsString);

    qryProdutosunidade.AsString             := qryProdutosContratosunidade.AsString;
    qryProdutosfatorconversao.asfloat := 1;
    qryProdutosquantidade.AsFloat        := qryProdutosContratosquantidade.AsFloat - qryProdutosContratoscancelado.AsFloat;
    qryProdutosqtdeestoque.AsFloat   := qryProdutosquantidade.AsFloat * qryProdutosfatorconversao.AsFloat;

    qryProdutosdesconto.AsCurrency          := qryProdutosContratosdesconto.AsCurrency;
    qryProdutosvalordescontoitem.AsCurrency := qryProdutosContratosvalordescontoitem.AsCurrency;
    qryProdutosfrete.AsCurrency             := qryProdutosContratosfrete.AsCurrency;
    qryProdutosseguro.AsCurrency            := qryProdutosContratosseguro.AsCurrency;
    qryProdutosacrescimo.AsCurrency         := qryProdutosContratosacrescimo.AsCurrency;
//    qryProdutosprecotabela.AsFloat          := qryProdutosContratosprecotabela.AsFloat;
    qryProdutosdescricaoprecovenda.AsString := qryProdutosContratosdescricaoprecovenda.AsString;
    qryProdutosaliquotaicms.AsFloat         := qryProdutosContratosaliquotaicms.AsFloat;
    if Not qryProdutosContratosicms.IsNull then
      qryProdutosicms.AsInteger             := qryProdutosContratosicms.AsInteger;
    qryProdutosincidencia.AsString          := qryProdutosContratosincidencia.AsString;
    qryProdutoscsosn.AsString               := qryProdutosContratoscsosn.AsString;
    qryProdutosorigem.AsInteger             := qryProdutosContratosorigem.AsInteger;

    qryProdutosaliquotaipi.AsFloat          := qryProdutosContratosaliquotaipi.AsFloat;
    qryProdutoscomposto.AsBoolean           := qryProdutosContratoscomposto.AsBoolean;
    qryProdutospn.AsString                  := qryProdutosContratosproduto.AsString;
    if qryProdutoscontratosipi.AsInteger <> 0 then
      qryProdutosipi.AsInteger                := qryProdutoscontratosipi.AsInteger;
    qryProdutosprodutototal.AsCurrency := Truncar((qryProdutosprecovenda.     AsCurrency *
                                                qryProdutosquantidade.AsFloat) , 2);

    qryProdutosvaloripidigitado.AsBoolean := false;
    qryProdutosvaloricmsdigitado.AsBoolean := false;
    qryProdutosvaloricmsstdigitado.AsBoolean := false;

    qryProdutosvalorpisdigitado.AsBoolean := false;
    qryProdutosvalorcofinsdigitado.AsBoolean := false;

    AtribuirDadosProdutos(qryprodutos, qryDadosFiscais, qryProcuraCodigoFiscalProduto, False, NotaAvulsa);

    qryProdutosprecovenda.AsFloat        := qryProdutosContratosprecovenda.AsFloat;
    GravarProduto;
    qryProdutosContratos.Next
  end;

  dsrProdutos.OnDataChange := dsrProdutosDataChange;

  CalcularImpostos(true, qryprodutos, qryDadosFiscais, true, true, true, qryCalculosProdutos, nil, false, NotaAvulsa,
  qryDadosFiscaisvendaconsumidorfinal.asboolean, qryDadosFiscaisclientecontribicms.asboolean);
end;

