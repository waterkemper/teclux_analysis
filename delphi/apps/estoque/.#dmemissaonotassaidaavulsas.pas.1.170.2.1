    end;
  end
  else
    FValorCustodaMercadoria := qryDadosFiscaisvalortotal.AsCurrency -
                               qryDadosFiscaisvaloripi.AsCurrency -
                               qryDadosFiscaisvaloricms.AsCurrency;

