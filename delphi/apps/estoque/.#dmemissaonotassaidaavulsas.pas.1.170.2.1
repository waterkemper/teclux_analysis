     (not qryVenctosDadosFiscaisdatavencto.IsNull) and
     (qryVenctosDadosFiscaistiporecebimento.AsInteger <> 0) and
     ((qryVenctosDadosFiscaisvalorvencto.AsCurrency <> qryVenctosDadosFiscaisvalorvencto.OldValue) or
