procedure TdtmEmissaoNotaAvulsas.SelecionarCodigoFiscalNatureza(Descricao: String; Query: String = 'P');
var
  Q : TTecQuery;
begin
  if Query = 'P' then
    Q := qryProdutos
{  else
    Q := qryServicosDadosFiscais};
  if qryNaturezasPadrao.Locate('descricao',descricao,[]) then
  begin
    Q.FieldByName('natureza').AsInteger     := qryNaturezasPadraonatureza.AsInteger;
    Q.FieldByName('codigofiscal').AsInteger := qryNaturezasPadraocodigofiscal.AsInteger;
    Q.FieldByName('destacarIPI').AsBoolean  := qryNaturezasPadraodestacaripi.AsBoolean;
    Q.FieldByName('operacao').AsString := qryNaturezasPadraooperacao.AsString;
    Q.FieldByName('tipomovimento').AsString := qryNaturezasPadraotipomovimento.AsString;
    if Q.FieldByName('codigofiscal').AsInteger <> 8000 then
      if not (qryContratosestado.AsString = EstadoFilialBase) then
        if HeUnidadeFederacao(qryContratosestado.AsString) then
        begin
          if Q.FieldByName('codigofiscal').AsInteger = ctVENDASUBSTITUIDODENTROESTADO then
            Q.FieldByName('codigofiscal').AsInteger := Q.FieldByName('codigofiscal').AsInteger+999
          else
            Q.FieldByName('codigofiscal').AsInteger := Q.FieldByName('codigofiscal').AsInteger+1000;
        end
        else
          Q.FieldByName('codigofiscal').AsInteger := Q.FieldByName('codigofiscal').AsInteger+2000;


  end;
end;


