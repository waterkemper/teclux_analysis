function TdtmEmissaoNotaAvulsas.GerarLinha(Incluir: Boolean): String;
Var Campo,nomeCampo : String;
begin
  FTextolinhaProduto:= '';
  Result:= '';
  Tamanho:= 0;
  qryCamposNotaFiscal.First;
  while not qryCamposNotaFiscal.eof do
  begin
    FTamanho:= ConverterTamanho(qryCamposNotaFiscaltamanho.AsInteger);
    NomeCampo:=qryCamposNotaFiscalcampo.AsString;
    if NomeCampo = 'NUMERO' then
    begin
      if Incluir then
      begin
        if not (qryProdutos.State in [dsinsert, dsedit]) then
          qryProdutos.Edit;
        qryProdutosnumero.AsInteger:= NLinha;
        Inc(NLinha);
        qryProdutos.Post;
      end else if (qryProdutos.RecordCount = 1) then
      begin
        if not (qryProdutos.State in [dsinsert, dsedit]) then
          qryProdutos.Edit;
        NLinha:= 1;
        qryProdutosnumero.AsInteger:= NLinha;
        Inc(NLinha);
        qryProdutos.Post;
      end;
    end;
    Campo:= qryProdutos.FieldByName(nomecampo).AsString;

    if ((qryProdutos.FieldByName(nomecampo).DataType IN [ftFloat,ftCurrency]) AND
        (qryProdutos.FieldByName(nomecampo).AsString <> '')) then
    begin
      if ((NomeCampo <> 'QUANTIDADE') and (NomeCampo <> 'ALIQUOTAICMS') and
         (NomeCampo <> 'ALIQUOTAIPI')) then
      begin
        Campo:= FormatFloat('##0.00',strtofloat(Campo));
        Campo:= CompararCampoDireita(Campo);
      end
      else if ((NomeCampo = 'ALIQUOTAICMS') or
               (NomeCampo = 'ALIQUOTAIPI')) then
             Campo:= CompararCampoDireita(Campo)
      else if (NomeCampo = 'QUANTIDADE') Then
              Campo:= CompararCampoCentro(Campo)
      else
        Campo:= CompararCampo(qryProdutos.FieldByName(nomecampo).AsString);
    end
    else
      Campo:= CompararCampo(qryProdutos.FieldByName(nomecampo).AsString);

    FTextolinhaProduto:= FTextolinhaProduto + Campo;
    qryCamposNotaFiscal.Next;
   end;
  Result:= FTextolinhaProduto;
end;
}
