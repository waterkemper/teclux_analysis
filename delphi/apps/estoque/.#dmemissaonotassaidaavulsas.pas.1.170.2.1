function TdtmEmissaoNotaAvulsas.GetValordaNota: Currency;
begin
  FValordaNota := 0;
  if qrydadosfiscais.State = dsinsert then
  begin
    if qryProcuraCodigoFiscallanctoscustomedio.AsBoolean then
    begin
      AbrirProdutosEstoque(false);
      qryProdutos.First;
      while not qryProdutos.Eof do
      begin
        if qryEstoqueBloqueio.Locate('produto,filial',VarArrayOf([qryProdutosproduto.AsString,
                                                                  qryProdutosfilial.AsInteger]),[]) then
          FValordaNota := FValordaNota +
                         (qryProdutosquantidade.AsFloat * qryEstoqueBloqueiocustomedio.AsCurrency);
        qryprodutos.Next;
      end;
    end
    else
      FValordaNota := qryDadosFiscaisvalortotal.ascurrency;
