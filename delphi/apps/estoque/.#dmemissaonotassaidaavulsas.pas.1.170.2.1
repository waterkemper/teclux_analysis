function TdtmEmissaoNotaAvulsas.IncluirMovimentos(var Erro, v_produto, v_produtovisual, v_filial: String): Boolean;
var SituacaoProduto : TtecComposicao;
    Pos: TBookmark;
    Err, cont: Integer;
    WhereSQL: String;
    AchouEstoque: Boolean;

    function VerificarEstoque: Integer;
    var Estoque: array[1..8] of Currency;
        a: Integer;

    begin
       Result := 0;
       if AchouEstoque then begin
          Estoque[1] := qryEstoqueBloqueioemestoque.AsCurrency;
          Estoque[2] := qryEstoqueBloqueioreservado.AsCurrency;
          Estoque[3] := qryEstoqueBloqueiotransito.AsCurrency;
          Estoque[4] := qryEstoqueBloqueiodemonstracao.Ascurrency;
          Estoque[5] := qryEstoqueBloqueioconserto.AsCurrency;
          Estoque[6] := qryEstoqueBloqueiofuturo.AsCurrency;
          Estoque[7] := qryEstoqueBloqueiodanificada.Ascurrency;
          Estoque[8] := qryEstoqueBloqueioestoquefisico.AsCurrency;
       end
       else FillChar(Estoque, SizeOf(Estoque), 0);

       if qryProdutosOperacao.AsString <> ''
       then for a := 1 to 7 do
                case qryProdutosoperacao.AsString[a] of
                '-':  if Estoque[a] < qryProdutosqtdeestoque.AsCurrency then begin
                         Result := a;
                         break
                       end;
                end;

    end;

begin
  Err             := 0;
  Pos := qryProdutos.GetBookmark;
  qryProdutos.DisableControls;
  try
    if not qryProcuraCodigoFiscaltransferencia.IsNull then
    begin
      WhereSQL := '';
      qryProdutos.First;
      while not qryProdutos.Eof do begin
        WhereSQL := WhereSQL +
        '((e.produto = ' + qryProdutosproduto.AsString + ')and' +
        '(e.filial = '   + qryDadosFiscaiscliente.AsString  + '))or';

        qryProdutos.Next;
      end;
      Delete(WhereSQL, Length(WhereSQL) - 1, 2);
      qryEstoqueFilialTrans.Sql[12] := WhereSQL;
      qryEstoqueFilialTrans.Open;
    end;

    cont := 0;
    for SituacaoProduto := stNAOCOMPOSTO to stCOMPOSTO do
    begin
      qryProdutos.First;
      while not qryProdutos.Eof do
      begin
        if FiltrarComposto(qryProdutoscomposto.AsBoolean,SituacaoProduto) then
        begin
          AchouEstoque := qryEstoqueBloqueio.Locate('produto;filial', VarArrayOf(
                                                    [qryProdutosproduto.AsString,
                                                     qryProdutosfilial.AsInteger]) ,[]);
          Err := VerificarEstoque;
          if Err = 0 then
          begin
            NovoMovimento(qryProdutosproduto.AsLargeInt, qryProdutosfilial.AsInteger);
            qryMovimentosdadofiscal.AsInteger    := qryDadosFiscaisnumero.AsInteger;
            qryMovimentosquantidade.AsFloat   := qryProdutosqtdeestoque.AsFloat;
            qryMovimentostipomovimento.AsString  := qryProdutostipomovimento.AsString;
            if (qryProdutosoperacao.AsString[12] <> '*') then
              qryMovimentosvalor.AsCurrency := qryProdutosprecovenda.AsFloat * qryProdutosquantidade.AsCurrency {alteração pedido JR deve multiplicar pela quantidade}
            else
              qryMovimentosvalor.AsCurrency := 0;
            if qryDadosFiscaiscontrato.IsNull then
              qryMovimentosreferencia.AsString := ' NF ' + qryDadosFiscaisserie.AsString + '-' + qryDadosFiscaisnumeronota.AsString
            else
              qryMovimentosreferencia.AsString := 'CT '+ qryDadosFiscaiscontrato.AsString +
                                                  ' NF ' + qryDadosFiscaisserie.AsString +
                                                  '-' + qryDadosFiscaisnumeronota.AsString;
            if Not qryProdutostransferencia.IsNull then begin
              if Not qryEstoqueFilialTrans.Locate('produto;filial', VarArrayOf(
                                                 [qryProdutosproduto.AsString,
                                                  qryDadosFiscaiscliente.AsInteger]) ,[]) then begin
                qryEstoqueFilialTrans.Append;
                qryEstoqueFilialTransproduto.AsInteger       := qryProdutosproduto.AsInteger;
                qryEstoqueFilialTransfilial.AsInteger        := qryDadosFiscaiscliente.AsInteger;
                qryEstoqueFilialTransemestoque.asCurrency     := 0;
                qryEstoqueFilialTransreservado.asCurrency     := 0;
                qryEstoqueFilialTranstransito.asCurrency      := 0;
                qryEstoqueFilialTransdemonstracao.AsCurrency  := 0;
                qryEstoqueFilialTransconserto.asCurrency      := 0;
                qryEstoqueFilialTransfuturo.asCurrency        := 0;
                qryEstoqueFilialTransdanificada.asCurrency    := 0;
                qryEstoqueFilialTransestoquefisico.asCurrency := 0;
                qryEstoqueFilialTrans.Post;
              end;
              qryMovimentostrffilial.AsInteger := qryDadosFiscaiscliente.AsInteger;
            end;

            qryMovimentos.Post;
            qryProdutos.Edit;
            qryProdutosdadofiscal.AsInteger := qryDadosFiscaisnumero.AsInteger;
            qryProdutosnumero.AsInteger     := cont + 1;
            qryProdutos.Post;
            Inc(cont);

            //CASO TRABALHE COM RESERVA PRÉVIA A QUANTIDADE QUE NÃO FOI CONFIRMADA DEVERÁ VOLTAR PARA O ESTOQUE
            if (ParSistema.RequisicaoSubtraiEstoque) and
               qryPedidosFiliais.active then
            begin
              if qryPedidosFiliais.Locate('lotetransferencia;produto', VarArrayOf([qryProdutoslotetransferencia.asinteger,qryProdutosproduto.AsString]),[]) then
              begin
                if (qryProdutosquantidade.AsCurrency < qryPedidosFiliaisqtdepedida.AsCurrency) and
                   (qryPedidosFiliaisqtderecebida.AsCurrency>0) then
                begin
                   NovoMovimento(qryPedidosFiliaisproduto.AsLargeint,qryPedidosFiliaisrequisitada.AsInteger);
                   qryMovimentostipomovimento.AsString := 'TPE';
                   qryMovimentosquantidade.AsCurrency   := qryPedidosFiliaisqtdepedida.AsCurrency - qryProdutosquantidade.AsCurrency;
                   qryMovimentosreferencia.AsString    := 'REQUISICAO '+qryPedidosFiliaiscodigo.AsString+' QTDE NAO CONFIRMADA';
                   qryMovimentos.Post;
                end;
              end;
            end;

          end else begin
            Erro := TotalizadoresEstoque[Err];
            v_produto := qryProdutosproduto.AsString;
            v_produtovisual := qryProdutosprodutovisual.AsString;
            v_filial := qryProdutosfilial.AsString;
            break
          end;
        end;

        qryProdutos.Next;
      end;
    end;
    Result := Err = 0;
  finally
    qryProdutos.GotoBookmark(Pos);
    qryProdutos.FreeBookmark(Pos);
    qryProdutos.EnableControls
  end
end;

