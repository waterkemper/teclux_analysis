procedure TdtmEmissaoNotaAvulsas.GravarLinhas;
var Contador,a,b,
    ProdutosDadosFiscais: Integer;
begin
  qryProdutos.DisableControls;
  qryLinhasNotasFiscais.DisableControls;
  Contador:= 1;
  qryProdutos.First;

  while Not qryProdutos.Eof do begin
    qryProdutos.Edit;
    qryProdutosNumero.AsInteger := Contador;
    qryProdutos.Post;
    Inc(Contador);
    qryProdutos.Next;
  end;

  Contador:= 1;
  ProdutosDadosFiscais:= 1;
  qryLinhasNotasFiscais.First;
  While not qryLinhasNotasFiscais.Eof do begin
    qryLinhasNotasFiscais.Edit;
    if qryLinhasNotasFiscaistemproduto.AsBoolean then
    begin
      qryLinhasNotasFiscaisprodutodadofiscal.AsInteger:= ProdutosDadosFiscais;
      inc(ProdutosDadosFiscais);
    end;
    qryLinhasNotasFiscaislinha.AsInteger:= COntador;
    qryLinhasNotasFiscais.Post;
    Inc(Contador);
    qryLinhasNotasFiscais.Next;
  end;
  qryProdutos.EnableControls;
  qryLinhasNotasFiscais.EnableControls;
end;

procedure TdtmEmissaoNotaAvulsas.MontarlinhaProdutos(Incluir:Boolean);
begin
  if Incluir then
  begin
    if GerarLinha(true) <> '' then
    begin
      if (qryLinhasNotasFiscais.RecNo = qryLinhasNotasFiscais.RecordCount) then
        Append:= True;
      GravarLinhaProdutos(True);
    end;
  end
  else
    ApagarLinha;
    if GerarLinha(False) <> '' then
    begin
      GravarLinhaProdutos(False);
    end;
end;

