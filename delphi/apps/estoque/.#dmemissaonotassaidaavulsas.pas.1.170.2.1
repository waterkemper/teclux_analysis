procedure TdtmEmissaoNotaAvulsas.GerarRequisicoes;
begin
  //CASO NOTA SEJA DE TRANSFERENCIA GERAR PEDIDOS FILIAIS PARA QUE POSSA SER CONFIRMADA
  if vListaLotes<>'' then
    qrypedidosfiliais.macrobyname('Condicao').asString := ' and (pf.lotetransferencia) in ('+vListaLotes+')'
  else
    qrypedidosfiliais.macrobyname('Condicao').asString := ' and false ';

  qrypedidosfiliais.close;
  qrypedidosfiliais.open;

  if vListaLotes <> '' then
    qryDadosFiscaisobservacoes.asString := qryDadosFiscaisobservacoes.asString + 'Lotes Transf. ' + vListaLotes;

//  AtribuirDados(qrypedidosfiliais, [qryPedidosFiliaissituacao, qryPedidosFiliaisdadofiscal], ['F', qryDadosFiscaisnumero.asvariant]);

  qryProdutos.First;
  while not qryProdutos.Eof do
  begin
    if qrypedidosfiliais.locate('produto;lotetransferencia', VarArrayOf([qryprodutosproduto.asString, qryProdutoslotetransferencia.asString]), []) then
    begin
      qrypedidosfiliais.edit;
      qryPedidosFiliaissituacao.AsString   := 'F';
      qryPedidosFiliaisdadofiscal.AsInteger:=qryDadosFiscaisnumero.AsInteger;
      qryPedidosFiliais.post;
    end;

    if qryProdutoslotetransferencia.isnull then
    begin
      qryPedidosFiliais.Append;
      spcPedidosTransferenciaProximoCodigo.Open;
      qryPedidosFiliaiscodigo.AsInteger:= spcPedidosTransferenciaProximoCodigonumero.AsInteger;
      spcPedidosTransferenciaProximoCodigo.Close;
      qryPedidosFiliaisproduto.AsLargeInt:=qryProdutosproduto.AsLargeInt;
      qryPedidosFiliaisdata.AsDateTime        := DataHoraLocal;
      qryPedidosFiliaisrequisitante.AsInteger := qryDadosFiscaiscliente.AsInteger;
      qryPedidosFiliaisrequisitada.AsInteger  := FilialBase;
      qryPedidosFiliaisQtdepedida.ascurrency:=qryProdutosquantidade.AsFloat;
      qryPedidosFiliaisQtderecebida.ascurrency:=qryProdutosquantidade.AsFloat;
      qryPedidosFiliaissituacao.AsString      := 'F';
      qryPedidosFiliaisdadofiscal.AsInteger:=qryDadosFiscaisnumero.AsInteger;
      qryPedidosFiliais.Post;
    end;

    qryProdutos.Next;
  end;
  qryProdutos.First;

  AtribuirDados(qrypedidosfiliais, [qrypedidosfiliaislotetransferencia], [null], [qryPedidosFiliaisdadofiscal], [null], ['=']);


end;

procedure TdtmEmissaoNotaAvulsas.ReverAliquotaIcms;
begin
  if qryprodutos.RecordCount<>0 then
  begin
    qryProcuraProduto.MacroByName('SQLListas').AsString := '';
    GuardarRegistroAtual(qryProdutos, True);
    qryprodutos.First;
    while not qryprodutos.Eof do
    begin
      qryProcuraProduto.ParamByName('produtovisual').AsString :=
           qryProdutosprodutovisual.AsString;
      qryprocuraproduto.Close;
      qryprocuraproduto.Open;
      qryProdutos.Edit;
      dsrProdutosDataChange(qryprodutos, qryProdutosproduto);
      qryProdutos.Post;
      qryprodutos.next;
    end;
    VoltarRegistroAtual(qryProdutos);
  end;
end;

