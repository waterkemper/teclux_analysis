function TdtmEmissaoNotaAvulsas.ExcluirNotaFiscal(Cancelar: Boolean): Boolean;


var
  Ind: Integer;

begin

  result :=    (Not dtmEmissaoNotaAvulsas.Cancelada)

                        or (dtmEmissaoNotaAvulsas.Cancelada
                            and ((((ParSistema.ExclusaoNotaAvulsa = exnPERGUNTAR) or
                                  (ParSistema.ExclusaoNotaAvulsa = exnEXCLUIR)) and not dtmEmissaoNotaAvulsas.CondicaoEmissorNFE) or  // apagar fisicamente a nota não eletronica

								 (dtmEmissaoNotaAvulsas.CondicaoEmissorNFE and 
                                  (dtmEmissaoNotaAvulsas.qryDadosFiscaisnumcancelamentonfe.AsString='')  // cancelar nota eletronica sem protocolo
                                   and (qryDadosFiscaisnuminutilizacaonfe.asstring='')
                                   
                                   and not (parsistema.EmissorNfPSe and
                                            (qryServicosDadosFiscais.recordcount <> 0) and
                                            (ftipoemissaonfeservico = Florianopolis_SoftPlan))) or 
                                            
                                           (parsistema.EmissorNfPSe and
                                            (qryServicosDadosFiscais.recordcount <> 0) and
                                            (ftipoemissaonfeservico = Florianopolis_SoftPlan))
                                             
                                   
                                   
								  ));


  if Result then
  begin
    if (qryDadosFiscais.State = dsInsert) then
    begin
      qryDadosFiscais.Cancel;
      ReFazConsulta(qryProdutos,[0],[0]);
    end
    else
      result := PermitirExcluirNotaFiscal;

      (*
      try
        if qryDadosFiscaisdadofiscalvinculado.AsInteger = 0 then {Notas vinculadas não alteraram a movimentação de produtos nem o a situação do contrato }
          ReadOnly := False;

        NullMovimentoProdutosDadosFiscais(Cancelar);

        if (qryDadosFiscaisdadofiscalvinculado.AsInteger = 0) then  {Notas vinculadas não alteraram a movimentação de produtos}
            ExcluirMovimentos;

        if (qryDadosFiscaisdadofiscalvinculado.AsInteger = 0) then {Notas vinculadas não alteraram a situação do contrato}
             VerificarContratos

      finally
        qryMovimentos.Sql[31] := 'm.numero = 0';
        ReadOnly := True;
      end
      *)

  end;
end;

function TdtmEmissaoNotaAvulsas.ExcluirProduto: Boolean;
begin
  Result := False;
  qryDadosFiscais.ReadOnly := False;
  qryProdutos.ReadOnly     := False;
  if not qryProdutos.IsEmpty then
  begin
    if not (qrydadosfiscais.State in [dsinsert, dsedit]) then
      qryDadosFiscais.Edit;

    if qrydadosfiscais.State = dsedit then
    begin
      if not qryApagarMovimentos.Active then
        ReFazConsulta(qryApagarMovimentos,[0],[qryDadosFiscaisnumero.AsVariant]);
      qryApagarMovimentos.First;
      if qryApagarMovimentos.Locate('produto;filial',VarArrayOf([qryProdutosproduto.AsString,qryProdutosfilial.AsInteger]),[]) then
        qryApagarMovimentos.Delete;
    end;
    qryProdutos.Delete;
    RefazerNumeroProdutos;
    CalcularImpostos(true, qryprodutos, qryDadosFiscais, true, true, true, qryCalculosProdutos, nil, false, NotaAvulsa,
    qryDadosFiscaisvendaconsumidorfinal.asboolean, qryDadosFiscaisclientecontribicms.asboolean);
    AtualizarListaProdutos;
    Result := True;
  end
end;

