procedure TdtmEmissaoNotaAvulsas.AbrirProdutosEstoque(Bloquear: Boolean = true);
var
  Pos: TBookmark;
  WhereSQL: String;
begin
  Pos := qryProdutos.GetBookmark;
  qryProdutos.DisableControls;
  try
    if qryProdutos.RecordCount = 0 then
      WhereSQL := 'false'
    else begin
      WhereSQL := '';
      qryProdutos.First;

      if qrydadosfiscais.State = dsinsert then  //bloquear todos
      begin
        while Not qryProdutos.Eof do begin
          WhereSQL := WhereSQL +
          '((e.produto = ' + qryProdutosproduto.AsString + ')and' +
          '(e.filial = '   + qryProdutosfilial.AsString  + '))or';
          qryProdutos.Next
        end;
      end
      else
      begin  //bloquear os com quantidade alterados
        while Not qryProdutos.Eof do
        begin
          if qryProdutosquantidade.AsFloat <> qryProdutosquantidadeantesgravar.AsFloat then
          begin
            WhereSQL := WhereSQL +
            '((e.produto = ' + qryProdutosproduto.AsString + ')and' +
            '(e.filial = '   + qryProdutosfilial.AsString  + '))or';
          end;
          qryProdutos.Next;
        end;
      end;
      if WhereSQL<>'' then
        Delete(WhereSQL, Length(WhereSQL) - 1, 2)
      else WhereSQL := 'false';
    end
  finally
    qryProdutos.GotoBookmark(Pos);
    qryProdutos.FreeBookmark(Pos);
    qryProdutos.EnableControls;
  end;

  if bloquear then
    qryEstoqueBloqueio.Sql[22] := WhereSQL + ' for update '
  else
    qryEstoqueBloqueio.Sql[22] := WhereSQL;


  qryEstoqueBloqueio.Open;
end;

procedure TdtmEmissaoNotaAvulsas.CalcularDadosFiscais;
begin
{
  while dtmGerarNotaFiscal.qryCalculosDadosFiscais.RecordCount > 0 do
    dtmGerarNotaFiscal.qryCalculosDadosFiscais.Delete;

  if qryDadosFiscaiscontrato.IsNull then
    CalcularValoresNotafiscal;

  dtmGerarNotaFiscal.CalcularDadosFiscais(nfSAIDA,
                     qryDadosFiscaisnumero.AsInteger,
                     qryDadosFiscaiscodigofiscal.AsInteger,
                     qryDadosFiscaisvalorfrete.AsCurrency, 0.00, false,
                     qryDadosFiscaisseguro.AsCurrency, 0.00, false,
                     0.00,
                     qryDadosFiscaisdesconto.AsCurrency,
                     qryDadosFiscaisacrescimo.AsCurrency,
                     qryDadosFiscaisvalortotal.AsCurrency,
                     qryDadosFiscaisvalorprodutos.AsCurrency,
                     qryProdutos,
                     nil,
                     nil,
                     false,
                     false,true,
                     qryDadosFiscaisestadocfo.AsString,
                     qryDadosFiscaispessoatipo.AsString,
                     qryDadosFiscaistotalvaloricmssubstituicao.AsCurrency,
                     True, false,
                     qryDadosFiscaiscodigonatureza.AsInteger);

  AtribuirValoresImpostos;
}
end;


