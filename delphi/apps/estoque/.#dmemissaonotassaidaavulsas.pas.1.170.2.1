procedure TdtmEmissaoNotaAvulsas.AtribuirParametrosCodigoFiscal;
var
  CodFiscal: Integer;

begin
    FTipoCFO   := 'L';
    if qryDadosFiscaiscodigofiscal.AsInteger <> 0 then
      CodFiscal := (qryDadosFiscaiscodigofiscal.AsInteger mod 1000) + 5000;

    if (qryDadosFiscaisestado.AsString = EstadoFilialBase) then
    begin
      FTipoCFO   := 'L';
      if qryDadosFiscaiscodigofiscal.AsInteger <> 0 then
        CodFiscal := (qryDadosFiscaiscodigofiscal.AsInteger mod 1000) + 5000;
    end
    else
    if HeUnidadeFederacao(qryDadosFiscaisestado.AsString) and not qryDadosFiscaisestado.isnull then
    begin
      FTipoCFO   := 'F';
      if qryDadosFiscaiscodigofiscal.AsInteger <> 0 then
        CodFiscal := (qryDadosFiscaiscodigofiscal.AsInteger mod 1000) + 6000;
    end
    else
    if not HeUnidadeFederacao(qryDadosFiscaisestado.AsString) and not qryDadosFiscaisestado.isnull then
    begin
      FTipoCFO   := 'E';
      if qryDadosFiscaiscodigofiscal.AsInteger <> 0 then
        CodFiscal := (qryDadosFiscaiscodigofiscal.AsInteger mod 1000) + 7000;
    end;

    qryProcuraCodigoFiscal.ParamByName('local').asstring         := FTipoCFO;
    qryProcuraCodigoFiscalProduto.ParamByName('local').asstring         := FTipoCFO;

    if qryDadosFiscaiscodigofiscal.AsInteger <> 0 then
      qryProcuraCodigoFiscal.ParamByName('codigofiscal').AsInteger := CodFiscal;

    qryConsultaCodigoFiscal.ParamByName('local').asstring        := FTipoCFO;

    if qryDadosFiscaiscodigofiscal.AsInteger <> 0 then
      if (codfiscal<>qryDadosFiscaiscodigofiscal.AsInteger) then
        qryDadosFiscaiscodigofiscal.AsInteger      := CodFiscal;
end;

