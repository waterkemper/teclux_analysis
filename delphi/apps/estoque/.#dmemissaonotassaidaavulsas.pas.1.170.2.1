procedure TdtmEmissaoNotaAvulsas.AlterarMovimentos;
begin
  try
    GuardarRegistroAtual(qryProdutos,true);
    qryEstoqueBloqueio.First;
    while not qryEstoqueBloqueio.Eof do
    begin
      if qryprodutos.Locate('produto;filial',
               VarArrayOf([qryEstoqueBloqueioproduto.AsString,
                           qryEstoqueBloqueiofilial.Asinteger]),[]) then
      begin
        qryAtualizarMovimentos.ParamByName('quantidade').AsCurrency := qryProdutosquantidade.AsFloat;
        qryAtualizarMovimentos.ParamByName('dadofiscal').AsInteger := qryProdutosdadofiscal.AsInteger;
        qryAtualizarMovimentos.ParamByName('produto').AsString := qryProdutosproduto.AsString;
        qryAtualizarMovimentos.ParamByName('filial').AsInteger := qryProdutosfilial.AsInteger;
        qryAtualizarMovimentos.ExecSql;
      end;
      qryEstoqueBloqueio.Next;
    end;
  finally
    VoltarRegistroAtual(qryprodutos);
  end;
end;

procedure TdtmEmissaoNotaAvulsas.qryDadosFiscaisCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  if qryDadosFiscaistipocliente.AsString = 'L' then
    qryDadosFiscaisDescricaoTipoCliente.AsString := ctFILIAL
  else
  if qryDadosFiscaistipocliente.AsString = 'F' then
    qryDadosFiscaisDescricaoTipoCliente.AsString := ctFORNECEDOR
  else
    qryDadosFiscaisDescricaoTipoCliente.AsString := ctCLIENTE;


  if (qryDadosFiscaissituacao.AsString = 'N') or
     (trim(qryDadosFiscaissituacao.AsString) = '') then
    qryDadosFiscaisdescricaosituacao.asvariant := null
  else
  if qryDadosFiscaissituacao.AsString = 'C' then
    qryDadosFiscaisdescricaosituacao.AsString := ANSIUpperCase(ctCANCELADA)
  else
  if qryDadosFiscaissituacao.AsString = 'D' then
    qryDadosFiscaisdescricaosituacao.AsString := 'DENEGADA'
  else
  if qryDadosFiscaissituacao.AsString = 'P' then
    qryDadosFiscaisdescricaosituacao.AsString := ANSIUpperCase(ctParcial);


end;

