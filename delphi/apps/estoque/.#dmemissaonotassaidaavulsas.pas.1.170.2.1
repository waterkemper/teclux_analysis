procedure TdtmEmissaoNotaAvulsas.DefinirPreco(Tipo: TtecTipoPrecoNotaSaida);
begin
  case Tipo of
    tpnVENDA:       begin
                      if qryprodutos.State in [dsedit, dsinsert] then
                      begin
                        qryProdutosprecovenda.AsFloat := qryProcuraProdutopreco.AsFloat;
                        qryProdutostipopreco.AsInteger:= 0;
                      end;
                      FTipoPreco                    := tpnVENDA;
                    end;
    tpnCUSTOMEDIO:  begin
                      if qryprodutos.State in [dsedit, dsinsert] then
                      begin
                        qryProdutosprecovenda.AsFloat := qryProcuraProdutocustomedio.AsFloat;
                        qryProdutostipopreco.AsInteger:= 1;
                      end;
                      FTipoPreco                    := tpnCUSTOMEDIO;
                    end;
    tpnULTIMACOMPRA: begin
                      if qryprodutos.State in [dsedit, dsinsert] then
                      begin
                        qryProdutosprecovenda.AsFloat := qryProcuraProdutovalorultimacompra.AsFloat;
                        qryProdutostipopreco.AsInteger:= 2;
                      end;
                      FTipoPreco                    := tpnULTIMACOMPRA;
                    end;
  end
end;

procedure TdtmEmissaoNotaAvulsas.dsrDadosFiscaisDataChange(Sender: TObject;Field: TField);
var
  Dif: Integer;
  AntesAbrir: TDataSetNotifyEvent;
  procedure DefinirEmbarqueExportacao;
  begin
    if (copy(qryDadosFiscaiscodigofiscal.AsString,1,1)='7') then
    begin
      if qryDadosFiscaisexportacoes_ufembarque.IsNull then
        qryDadosFiscaisexportacoes_ufembarque.AsString := 'SC';

      if qryDadosFiscaisexportacoes_localembarque.IsNull then
        qryDadosFiscaisexportacoes_localembarque.AsString := 'ITAJAI';
    end
    else
    begin
      qryDadosFiscaisexportacoes_ufembarque.clear;
      qryDadosFiscaisexportacoes_localembarque.clear;
    end;
  end;


begin
  inherited;
  AntesAbrir:= qryProcuraCodigoFiscalBeforeOpen;
  qryProcuraCodigoFiscal.BeforeOpen:= nil;
  if Field = qryDadosFiscaiscodigonotareferenciado then
    qryDadosFiscaiscliente.ReadOnly := (field.AsInteger <> 0)
  else
  if (Field = qryDadosFiscaiscliente) or
     (Field = qryDadosFiscaisTipocliente) then
  begin
    dsrDadosFiscais.OnDataChange := nil;

    if AtribuirDadosCliente then
    begin

      AtribuirParametrosCodigoFiscal;

      if qryDadosFiscaispessoatipo.AsString = 'J' then
        qryDadosFiscaisestadocfo.AsString    := qryDadosFiscaisestado.AsString
      else qryDadosFiscaisestadocfo.AsString := EstadoFilialBase;

      if not ExisteCFOP then
      begin
        qryDadosFiscaiscodigofiscal.AsVariant := qryDadosFiscaiscodigofiscal.OldValue;
        MensagemAviso('CFOP inexistente');
      end;
      if (qryDadosFiscaispessoatipo.OldValue <> qryDadosFiscaispessoatipo.AsString) or
         (qryDadosFiscaisestadocfo.OldValue <> qryDadosFiscaisestadocfo.AsString) then
        ReverAliquotaIcms;
    end;
    dsrDadosFiscais.OnDataChange := dsrDadosFiscaisDataChange;
    CalcularImpostos(true, qryprodutos, qryDadosFiscais, true, true, true, qryCalculosProdutos, nil, false, NotaAvulsa,
                     qryDadosFiscaisvendaconsumidorfinal.asboolean, qryDadosFiscaisclientecontribicms.asboolean);
    DefinirEmbarqueExportacao;

  end else if (Field = qryDadosFiscaiscodigofiscal) then
  begin
    if not ExisteCFOP then
    begin
      dsrDadosFiscais.OnDataChange := nil;
      qryDadosFiscaiscodigofiscal.AsVariant := qryDadosFiscaiscodigofiscal.OldValue;
      RefazConsultaPorNome(qryProcuraCodigoFiscal,['codigofiscal'],[0]);
      dsrDadosFiscais.OnDataChange := dsrDadosFiscaisDataChange;
    end;

    dsrDadosFiscais.OnDataChange := nil;
    AtribuirParametrosCodigoFiscal;
    dsrDadosFiscais.OnDataChange := dsrDadosFiscaisDataChange;

    if qryDadosFiscaiscontrato.IsNull and
       (qryDadosFiscaiscodigofiscal.AsInteger > 0) then
      qryDadosFiscaisnatureza.AsString := qryProcuraCodigoFiscaldescricaonatureza.AsString;
      {
    else
      qryDadosFiscaisnatureza.AsString := '';}
    if qryDadosFiscaiscodigofiscal.AsInteger > 0 then
      qryDadosFiscaiscodigonatureza.AsInteger := qryProcuraCodigoFiscalcodigonatureza.AsInteger
    else
      qryDadosFiscaiscodigonatureza.AsInteger := 0;

    qryDadosFiscaisrequernfentrada.AsBoolean :=  qryProcuraCodigoFiscalrequernfentrada.AsBoolean;
    qryProdutosserienotafiscalentrada.Required := {eHNotaFiscalSaidaDevolucao(qryDadosFiscaiscodigofiscal.Asinteger)} qryDadosFiscaisrequernfentrada.AsBoolean;
    qryProdutosnumeronotafiscalentrada.Required := qryProdutosserienotafiscalentrada.Required;
    qryProdutosfornecedornotafiscalentrada.Required := qryProdutosserienotafiscalentrada.Required;
    qryProdutostipofornecedornotafiscalentrada.Required := qryProdutosserienotafiscalentrada.Required;

    qryDadosFiscaisnaoutilizarobsautomaticas.AsBoolean :=  qryProcuraCodigoFiscalnaoutilizarobsautomaticas.AsBoolean;


    DefinirEmbarqueExportacao;

    qryDadosFiscaisexigenotareferenciada.asboolean := exigenotareferenciada(qryDadosFiscaiscodigofiscal.asinteger);
  end
  else if Field = qryDadosFiscaiscontrato then
  begin
    if not qryDadosFiscaisvendatransferencia.AsBoolean then  // nota de venda via transferencia para empresa de mesmo grupo
    begin
      ReFazConsulta(qryContratos, [0], [qryDadosFiscaiscontrato.AsString]);
      ReFazConsulta(qryParcelas, [0], [qryDadosFiscaiscontrato.AsString]);
      ReFazConsulta(qryProdutosContratos,[0,1,2,3,4], [EstadoFilialBase,
                                                     qryProcuraContratoestado.asstring,
                                                     qryProcuraContratopessoatipo.asstring,
                                                     qryDadosFiscaiscontrato.AsString,
                                                     filialbase]);
      if qryDadosFiscaiscontrato.IsNull then
        LimparNotaFiscalComContrato
      else
      begin
        PreencherNotaFiscalComContrato;
        CalcularImpostos(true, qryprodutos, qryDadosFiscais, true, true, true, qryCalculosProdutos, nil, false, NotaAvulsa,
        qryDadosFiscaisvendaconsumidorfinal.asboolean, qryDadosFiscaisclientecontribicms.asboolean);
      end;
    end;

  end
{
  else if Field = qryDadosFiscaispessoatipo then
    qryProcuraProduto.ParamByName('TipoPessoa').AsString  := qryDadosFiscaispessoatipo.AsString
  else if Field = qryDadosFiscaisestadocfo then
    qryProcuraProduto.ParamByName('Estadocfo').AsString  := qryDadosFiscaisestadocfo.AsString
}
  else
  if (field = qryDadosFiscaisdesconto) then
  begin
      CalcularImpostos(true, qryprodutos, qryDadosFiscais, true, true, true, qryCalculosProdutos, nil, false, NotaAvulsa,
      qryDadosFiscaisvendaconsumidorfinal.asboolean, qryDadosFiscaisclientecontribicms.asboolean, nil, false, true, false, tpAltEsp_ValorDescontoNota)
  end
  else
  if (field = qryDadosFiscaisvalorfrete) then
  begin
      CalcularImpostos(true, qryprodutos, qryDadosFiscais, true, true, true, qryCalculosProdutos, nil, false, NotaAvulsa,
      qryDadosFiscaisvendaconsumidorfinal.asboolean, qryDadosFiscaisclientecontribicms.asboolean, nil, false, true, false, tpAltEsp_ValorFreteNota)
  end
  else
  if (field = qryDadosFiscaisacrescimofinanceiro) or
     (field = qryDadosFiscaisseguro) or
     (Field = qryDadosFiscaisvalorservicos) then
  begin
      CalcularImpostos(true, qryprodutos, qryDadosFiscais, true, true, true, qryCalculosProdutos, nil, false, NotaAvulsa,
      qryDadosFiscaisvendaconsumidorfinal.asboolean, qryDadosFiscaisclientecontribicms.asboolean)
  end
  else
  if field = qryDadosFiscaisserie then
    qryDadosFiscaismodelodocto.AsString := qryProcuraSeriemodelodoctofiscal.AsString
  else
  if field = qryDadosFiscaisdespesasacessorias then
  begin
//  if not {eHNotaFiscalSaidaDevolucao(qryDadosFiscaiscodigofiscal.AsInteger)} qryDadosFiscaisrequernfentrada.AsBoolean then
      CalcularImpostos(true, qryprodutos, qryDadosFiscais, true, true, true, qryCalculosProdutos, nil, false, NotaAvulsa,
      qryDadosFiscaisvendaconsumidorfinal.asboolean, qryDadosFiscaisclientecontribicms.asboolean, nil, false, true, false, tpAltEsp_DespesasAcessoriasNota)

  end
  else
  if field = qryDadosFiscaisrequernfentrada then
    qryProdutoscodigofiscal.ReadOnly := Field.asboolean;

  qryProcuraCodigoFiscal.BeforeOpen:= AntesAbrir;

end;

function  TdtmEmissaoNotaAvulsas.ConfirmarCFOPcliente: Boolean;
begin
  result := true;
  if (qryDadosFiscaiscodigofiscal.AsInteger<>8000) { NF de serviços } then
  begin
    if HeUnidadeFederacao(qryDadosFiscaisestado.AsString) then
    begin
      if qryDadosFiscaisestado.AsString = EstadoFilialBase then
        result := qryDadosFiscaiscodigofiscal.AsInteger - (qryDadosFiscaiscodigofiscal.AsInteger mod 1000) = 5000
      else
        result := qryDadosFiscaiscodigofiscal.AsInteger - (qryDadosFiscaiscodigofiscal.AsInteger mod 1000) = 6000;
    end
    else
      result := qryDadosFiscaiscodigofiscal.AsInteger - (qryDadosFiscaiscodigofiscal.AsInteger mod 1000) = 7000;
  end;
end;

procedure TdtmEmissaoNotaAvulsas.dsrProdutosDataChange(Sender: TObject; Field: TField);
begin
  inherited;
  if field = qryProdutoslotetransferencia then
  begin
    if not qryProdutoslotetransferencia.isNull then
    begin
      qryPedidosInconsistentes.parambyname('lotetransferencia').asinteger := qryProdutoslotetransferencia.asinteger;
      qryPedidosInconsistentes.close;
      qryPedidosInconsistentes.open;
      if qryPedidosInconsistentes.recordcount <> 0 then
      begin
        frmMensagemGrid := TfrmMensagemGrid.Create(frmMensagemGrid);
        frmMensagemGrid.Caption := 'Mensagem de inconsistência';
        frmMensagemGrid.lblTitulo.Caption := 'INCONSISTÊNCIA NOS PRODUTOS LIDOS!';
        frmMensagemGrid.lblTExto.Caption := 'Verifique no quadro abaixo os produtos que estão inconsistentes em relação a quantidade lida.';
        frmMensagemGrid.dbgMensagem.DataSource :=dsrPedidosInconsistentes;
        frmMensagemGrid.width := 750;
        frmMensagemGrid.ShowModal;
        frmMensagemGrid.Free;
//        dsrProdutos.onDataChange := nil;
        qryProdutoslotetransferencia.clear;
//        dsrProdutos.onDataChange := dsrProdutosDataChange;

      end;
    end;
  end;

  if field = qryProdutosprodutovisual then
  begin
    if qryProdutosprodutovisual.AsString<>'' then
      if qryProcuraProdutoproduto.AsLargeInt <> 0 then
        if qryProdutosproduto.AsLargeInt <> qryProcuraProdutoproduto.AsLargeInt then
          qryProdutosproduto.AsLargeInt := qryProcuraProdutoproduto.AsLargeInt;
  end;

  if (field = qryProdutosquantidade) or
     (field = qryProdutosfatorconversao) then
  begin
    dsrProdutos.OnDataChange := nil;
    qryProdutosqtdeestoque.AsFloat   := qryProdutosquantidade.AsFloat * qryProdutosfatorconversao.AsFloat;
    dsrProdutos.OnDataChange := dsrProdutosDataChange;
  end;

  if (field = qryProdutosqtdeestoque) then
  begin
//    dsrProdutos.OnDataChange := nil;
    qryProdutosquantidade.AsFloat   := qryProdutosqtdeestoque.AsFloat / qryProdutosfatorconversao.AsFloat;
//    dsrProdutos.OnDataChange := dsrProdutosDataChange;
  end;



  if (field = qryProdutosquantidade) or
     (field = qryProdutosprecovenda) then
  begin
    dsrProdutos.OnDataChange := nil;

    if {eHNotaFiscalSaidaDevolucao(qryDadosFiscaiscodigofiscal.Asinteger)} qryDadosFiscaisrequernfentrada.AsBoolean then
    begin
      if (qryProdutosproduto.AsString<>'') then
      begin

        if (qryProdutosquantidade.AsFloat > qryProdutosquantidadenotaentrada.AsFloat) then
        begin
          MensagemAviso('A quantidade esta superior ao saldo do produto da nota fiscal');        
//          MensagemErro('A quantidade não pode ser superior ao saldo do produto da nota fiscal');
//        qryProdutosquantidade.AsFloat := qryProdutosquantidade.OldValue;
        end;
{
        else
        begin
}
//        AtribuirDadosProdutos(qryprodutos, qryDadosFiscais, qryProcuraCodigoFiscalProduto, False, NotaAvulsa);
        CalcularImpostos(true, qryprodutos, qryDadosFiscais, true, true, true, qryCalculosProdutos, nil, false, NotaAvulsa,
        qryDadosFiscaisvendaconsumidorfinal.asboolean, qryDadosFiscaisclientecontribicms.asboolean);
//        end;

      end;
    end
    else
      CalcularImpostos(true, qryprodutos, qryDadosFiscais, true, true, true, qryCalculosProdutos, nil, false, NotaAvulsa,
      qryDadosFiscaisvendaconsumidorfinal.asboolean, qryDadosFiscaisclientecontribicms.asboolean);

    dsrProdutos.OnDataChange := dsrProdutosDataChange;
  end;

  if ((not (qryProdutosvaloripidigitado.AsBoolean)) or
      (qryProdutosvaloripi.AsCurrency=0)) and
     (field = qryProdutosaliquotaipi) then
  begin
    dsrProdutos.OnDataChange := nil;
    qryProdutosvaloripidigitado.AsBoolean := false;
    CalcularImpostos(true, qryprodutos, qryDadosFiscais, true, true, true, qryCalculosProdutos, nil, false, NotaAvulsa,
    qryDadosFiscaisvendaconsumidorfinal.asboolean, qryDadosFiscaisclientecontribicms.asboolean);
    dsrProdutos.OnDataChange := dsrProdutosDataChange;
  end;

  if (field = qryProdutosvaloripi) then
  begin
    dsrProdutos.OnDataChange := nil;
    qryProdutosvaloripidigitado.AsBoolean := true;
    CalcularImpostos(true, qryprodutos, qryDadosFiscais, true, true, true, qryCalculosProdutos, nil, false, NotaAvulsa,
    qryDadosFiscaisvendaconsumidorfinal.asboolean, qryDadosFiscaisclientecontribicms.asboolean);
    dsrProdutos.OnDataChange := dsrProdutosDataChange;
  end;

  if ((field = qryProdutospercentualreducaobase) or
      (field = qryProdutosreducaobase          ) or
      (field = qryProdutosicmsbasecalculo      ) or
      (field = qryProdutosicmsbasecalculo_dev  ) or
      (field = qryProdutosaliquotaicms         ) or
      (field = qryProdutosicmsvalor            ) or
      (field = qryProdutosicmsvalor_dev        )) and
     (field.Value <> null) then
  begin
    dsrProdutos.OnDataChange := nil;
    qryProdutosvaloricmsdigitado.AsBoolean := true;
    CalcularImpostos(true, qryprodutos, qryDadosFiscais, true, true, true, qryCalculosProdutos, nil, false, NotaAvulsa,
    qryDadosFiscaisvendaconsumidorfinal.asboolean, qryDadosFiscaisclientecontribicms.asboolean);
    dsrProdutos.OnDataChange := dsrProdutosDataChange;
  end;

  if ((field = qryProdutospredbcst) or
      (field = qryProdutosreducaobasest          ) or
      (field = qryProdutosicmsbasecalculost      ) or
      (field = qryProdutosaliquotaicmsst         ) or
      (field = qryProdutosicmsvalorst            ) or
      (field = qryProdutosvBCSTRet               ) or
      (field = qryProdutosvICMSSTRet             )) and
     (field.value <> null) then
  begin
    dsrProdutos.OnDataChange := nil;
    qryProdutosvaloricmsstdigitado.AsBoolean := true;
    CalcularImpostos(true, qryprodutos, qryDadosFiscais, true, true, true, qryCalculosProdutos, nil, false, NotaAvulsa,
    qryDadosFiscaisvendaconsumidorfinal.asboolean, qryDadosFiscaisclientecontribicms.asboolean);
    dsrProdutos.OnDataChange := dsrProdutosDataChange;
  end;

  if (Field = qryProdutoscodigofiscal) then
  begin
    if (qryProcuraCodigoFiscalProduto.recordcount = 1) then
    begin
      qryProdutosnatureza.AsInteger := qryProcuraCodigoFiscalProdutocodigonatureza.AsInteger;
      qryProdutosnaogerardebitoicms.AsBoolean := qryProcuraCodigoFiscalProdutonaogerardebitoicms.AsBoolean;
      qryProdutosnaogerardebitoipi.AsBoolean := qryProcuraCodigoFiscalProdutonaogerardebitoipi.AsBoolean;
      qryProdutosnaocalcularipisobrefrete.AsBoolean := qryProcuraCodigoFiscalnaocalcularipisobrefrete.AsBoolean;
      qryProdutosicmssobreipi.AsBoolean := qryProcuraCodigoFiscalicmssobreipi.AsBoolean;
      qryProdutosnaocalcularvaloresicmsdiferimento.AsBoolean := qryProcuraCodigoFiscalnaocalcularvaloresicmsdiferimento.AsBoolean;

      qryProdutosdestacaripi.AsBoolean := qryProcuraCodigoFiscalProdutodestacaripi.AsBoolean;
      qryProdutostipomovimento.AsString := qryProcuraCodigoFiscalProdutotipomovimento.AsString;
      qryProdutosoperacao.AsString      := qryProcuraCodigoFiscalProdutooperacao.AsString;

      if qryProcuraCodigoFiscalProdutocsosn.AsString <> '' then
        qryProdutoscsosn.AsString      := qryProcuraCodigoFiscalProdutocsosn.AsString;

      if qryProcuraCodigoFiscalProdutoicmscst.AsString <> '' then
        qryProdutosincidencia.AsString := qryProcuraCodigoFiscalProdutoicmscst.AsString;

      if qryProdutosincidencia.AsString = ctDIFERIMENTO then
        qryProdutospdif.asCurrency := qryProcuraCodigoFiscalProdutopdiferimento.ascurrency;

      if qryProcuraCodigoFiscalProdutoipicst.AsString <> '' then
        qryProdutosipicst.AsString     := qryProcuraCodigoFiscalProdutoipicst.AsString;

      if qryProcuraCodigoFiscalProdutopiscst.AsString <> '' then
        qryProdutospiscst.AsString     := qryProcuraCodigoFiscalProdutopiscst.AsString;

      if qryProcuraCodigoFiscalProdutocofinscst.AsString <> '' then
        qryProdutoscofinscst.AsString  := qryProcuraCodigoFiscalProdutocofinscst.AsString;

      if not qryProcuraCodigoFiscalProdutotransferencia.IsNull then
         qryProdutostransferencia.AsString := qryProcuraCodigoFiscalProdutotransferencia.AsString;

      if qryProcuraProduto.RecordCount = 1 then
      begin
        dsrProdutos.OnDataChange := nil;

