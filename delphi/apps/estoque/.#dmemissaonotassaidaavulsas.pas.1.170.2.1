function TdtmEmissaoNotaAvulsas.ListaProdutosCadastrados: String;
var
  PosicaoCodigoNota : Integer;
  ListaProdutos: String;
begin
  ListaProdutos := '';
  if qryDadosFiscaisdadofiscalreferenciado.AsInteger <> 0 then
  begin
    PosicaoCodigoNota := ListaProdutosNotasSelecionadas[CodigoNota].
                         IndexOf(qryDadosFiscaisdadofiscalreferenciado.asstring);
    if PosicaoCodigoNota <> -1 then
    begin
      ListaProdutos := ListaProdutosNotasSelecionadas[produto].
                       Strings[PosicaoCodigoNota];

      if qryprodutos.State <> dsinsert then
        if qryProdutosproduto.AsString<>'0' then
        begin
          if  qryDadosFiscaisdadofiscalreferenciado.AsInteger <> 0 then
            Delete(ListaProdutos,pos('('+qryProdutosproduto.AsString+','+qryProdutosnumeroprodutotabela.asstring+')',ListaProdutos),
                   length('('+qryProdutosproduto.AsString+','+qryProdutosnumeroprodutotabela.asstring+')'))
          else
            Delete(ListaProdutos,pos('('+qryProdutosproduto.AsString+')',ListaProdutos),
                   length('('+qryProdutosproduto.AsString+')'));
        end;
    end;
  end
  else
  begin
    PosicaoCodigoNota := ListaProdutosNotasSelecionadas[CodigoNota].
                         IndexOf(qryProdutoscodigonota.asstring);
    if PosicaoCodigoNota <> -1 then
    begin
      ListaProdutos := ListaProdutosNotasSelecionadas[produto].
                       Strings[PosicaoCodigoNota];

      if qryprodutos.State <> dsinsert then
        if qryProdutosproduto.AsString<>'0' then
        begin
          if  qryProdutoscodigonota.asinteger <> 0 then
            Delete(ListaProdutos,pos('('+qryProdutosproduto.AsString+','+qryProdutosnumeroprodutotabela.asstring+')',ListaProdutos),
                   length('('+qryProdutosproduto.AsString+','+qryProdutosnumeroprodutotabela.asstring+')'))
          else
            Delete(ListaProdutos,pos('('+qryProdutosproduto.AsString+')',ListaProdutos),
                   length('('+qryProdutosproduto.AsString+')'));
        end;
    end;
  end;
  result := trocar(ListaProdutos,')(','),(');
end;

