procedure TdtmEmissaoNotaAvulsas.setReadOnly(const Value: Boolean);
var
 i : integer;
begin
  if (qryDadosFiscais.State = dsInsert) then
  begin
    qryDadosFiscais        .RequestLive := true;
    qryProdutos            .RequestLive := true;
    for i:=0 to qryProdutos.fieldcount - 1 do
      qryprodutos.Fields[i].ReadOnly := false;
{    dtmGerarNotaFiscal.
    qryCalculosDadosFiscais.RequestLive := True ;}
  end
  else
  begin
    qryDadosFiscais.RequestLive := Not Value or
                        (UsuarioLogin.AlterarDadosContabeis and
                         not (TipoNotaSaida in [tnsTRANSFERENCIAICMS,
                                                tnsTRANSFERENCIA])) and
                         (qryDadosFiscaisdata.AsDateTime > ParSistema.DataContabil);

    if qryDadosFiscais.RequestLive then
    begin
      qryProdutos.RequestLive := true;
      for i:=0 to qryProdutos.fieldcount - 1 do
        qryprodutos.Fields[i].ReadOnly := True;

      qryProdutosprecovenda.ReadOnly := false;
      qryProdutospercentualreducaobase.ReadOnly := false;
      qryProdutosreducaobase.ReadOnly := false;
      qryProdutosicmsbasecalculo.ReadOnly := false;
      qryProdutosaliquotaicms.ReadOnly := false;
      qryProdutosicmsvalor.ReadOnly := false;

      qryProdutospredbcst.ReadOnly := false;
      qryProdutosreducaobasest.ReadOnly := false;
      qryProdutosicmsbasecalculost.ReadOnly := false;
      qryProdutosaliquotaicmsst.ReadOnly := false;
      qryProdutosicmsvalorst.ReadOnly := false;
      qryProdutosipibasecalculo.ReadOnly := false;

      qryProdutosvBCSTRet.ReadOnly := false;
      qryProdutosvICMSSTRet.ReadOnly := false;
      qryProdutosicmsbasecalculo_dev.ReadOnly := false;
      qryProdutosicmsvalor_dev.ReadOnly := false;

      qryProdutosaliquotaipi.ReadOnly := false;
      qryProdutosvaloripi.ReadOnly := false;

      qryProdutospiscst.ReadOnly := false;
      qryProdutospisbasecalculo.ReadOnly := false;
      qryProdutospisaliquota.ReadOnly := false;
      qryProdutospisvalor.ReadOnly := false;

      qryProdutoscofinscst.ReadOnly := false;
      qryProdutoscofinsbasecalculo.ReadOnly := false;
      qryProdutoscofinsaliquota.ReadOnly := false;
      qryProdutoscofinsvalor.ReadOnly := false;

    end
    else
      qryProdutos.RequestLive := qryDadosFiscais.RequestLive;

{    dtmGerarNotaFiscal.
    qryCalculosDadosFiscais.RequestLive := qryDadosFiscais.RequestLive;}

{
    qryProdutos.RequestLive         := Not Value or
                        UsuarioLogin.AlterarDadosContabeis;
    dtmGerarNotaFiscal.
    qryCalculosDadosFiscais.RequestLive := (Not Value or
                                            UsuarioLogin.AlterarDadosContabeis) and
                                            (qryDadosFiscaisdata.AsDateTime > ParSistema.DataContabil);
}
  end
end;

function TdtmEmissaoNotaAvulsas.VerificarSerieFilial: Boolean;
begin
  result := (qryDadosFiscais.State = dsedit);
  if not result then
  begin
    if qryDadosFiscaiscontrato.IsNull then
      ReFazConsulta(qrySeriesFiliais,[0,1],[FilialBase, SerieSugestao])
    else
      ReFazConsulta(qrySeriesFiliais,[0,1],[FilialBase, qryDadosFiscaisserie.AsString]);
    if qrySeriesFiliais.RecordCount = 0 then begin
      MensagemAviso(format(ctFILIALSEMSERIE, [FilialBase, 'mercadorias']));
      Result := False;
    end else if qrySeriesFiliaismodelonota.IsNull then begin
      MensagemAviso(ctSERIESUGESTAOSEMMODELO);
      Result := False;
    end else
      Result := True;
  end;
end;

