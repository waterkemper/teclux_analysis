function TdtmEmissaoNotaAvulsas.SomenteBrinde: Boolean;
begin
  ReFazConsulta(qryProdutosContratos_semVinculo,[0,1,2,3,4], [EstadoFilialBase,
                                                 qryContratosestado.asstring,
                                                 qryContratospessoatipo.asstring,
                                                 qryDadosFiscaiscontrato.AsString,
                                                 filialbase]);
  Result := True;
  GuardarRegistroAtual(qryProdutosContratos_semVinculo, True);
  try
    qryProdutosContratos_semVinculo.First;
    while Not qryProdutosContratos_semVinculo.Eof do begin
      if Not qryProdutosContratos_semVinculo.FieldByName('brinde').AsBoolean then begin
        Result := False;
        break
      end;
      qryProdutosContratos_semVinculo.Next
    end
  finally
    VoltarRegistroAtual(qryProdutosContratos_semVinculo);
  end
end;

procedure TdtmEmissaoNotaAvulsas.qryProdutosCalcFields(DataSet: TDataSet);
begin
  inherited;


  qryProdutosprodutototal.AsCurrency :=  truncar(qryProdutosprecovenda.AsFloat *
                                               qryProdutosquantidade.AsFloat ,2);


  qryProdutosTotalQuantidadeXPrecoUnitario.AsCurrency := roundto(
                (qryProdutosprecovenda.AsFloat *
                  qryProdutosquantidade.AsFloat),-2);

  qryProdutosTotalLiquido.asfloat := qryProdutosTotalQuantidadeXprecounitario.AsFloat -
                                               qryProdutosdesconto.AsFloat -
                                               qryProdutosvalordescontoitem.AsFloat;


  qryProdutosTotalProdutoMaisIPI.AsCurrency :=
    qryProdutosTotalLiquido.asfloat +
    qryProdutosvaloripi.AsCurrency;


end;

