procedure TdtmEmissaoNotaAvulsas.MontarVenctosDadosFiscais;
begin
  if qryVenctosDadosFiscais.RecordCount = 0 then
  begin
    qryTiposRecebimentos.first;
    if qrytiposrecebimentos.isempty then
      MensagemErro('A tabela de tipos de recebimentos não possue informações')
    else
    begin
      qryVenctosDadosFiscais.Append;
      qryVenctosDadosFiscaisnumero.AsInteger       := 1;
      qryVenctosDadosFiscaisdatavencto.AsDateTime  := qryDadosFiscaisdata.AsDateTime;
