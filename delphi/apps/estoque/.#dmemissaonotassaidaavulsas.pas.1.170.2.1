procedure TdtmEmissaoNotaAvulsas.GravarLancamentosContabeis;
begin
   if parsistema.GerarContabilidade then
   begin
     FProximoNrLancto := 0;
     with dtmLancamentoContabilidade do
     begin
       qrylancamentosNotasSaidas.First;
       while not qrylancamentosNotasSaidas.Eof do
       begin
         qrylancamentosNotasSaidas.Edit;
         if (qryLancamentosNotasSaidasnumerocriado.AsBoolean) then
           qrylancamentosNotasSaidasnrlancto.AsInteger := ProximoNrLancto;

         qrylancamentosNotasSaidasdata.AsDateTime         := qryDadosFiscaisdata.AsDateTime;
         qryLancamentosNotasSaidasexercicio.Asinteger     := yearof(qryDadosFiscaisdata.AsDateTime);
         qrylancamentosNotasSaidasnrorigem.AsString      := qryDadosFiscaisnumero.AsString;
         qryLancamentosNotasSaidasfilial.Asinteger        := qryDadosFiscaisfilialemissao.Asinteger;
         if pos('NF  - ',qryLancamentosNotasSaidascomplemento.AsString)<>0 then
            qryLancamentosNotasSaidascomplemento.AsString := Trocar(
              qryLancamentosNotasSaidascomplemento.AsString,
              'NF  - ',
              'NF '+qryDadosFiscaisnumeronota.AsString+' - ');
         qrylancamentosNotasSaidas.Next;
       end;
     end;
   end;
end;

function TdtmEmissaoNotaAvulsas.GetProximoNrLancto: integer;
begin
  if FProximoNrLancto=0 then
  begin
    spcLancamentosProximo.ParamByName('Exercicio').AsInteger:= yearof(qrydadosfiscaisdata.asdatetime);
    spcLancamentosProximo.ParamByName('Filial').AsInteger:= qryDadosFiscaisfilialemissao.AsInteger;
    spcLancamentosProximo.Open;
    FProximoNrLancto := spcLancamentosProximocodigo.AsInteger;
    spcLancamentosProximo.Close;
  end
  else
   FProximoNrLancto := FProximoNrLancto + 1;
  Result := FProximoNrLancto;
end;

