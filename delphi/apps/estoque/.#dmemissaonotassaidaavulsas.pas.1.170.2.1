function TdtmEmissaoNotaAvulsas.ExisteDiferencaIncidencia: Boolean;
const
  SQL = 'where p.codigo in (%s)';
var
  ListaProdutos: String;
begin
  result := false;
  ListaProdutos:='';
  try
    GuardarRegistroAtual(qryprodutos, true);
    qryprodutos.First;
    while Not qryProdutos.Eof do
    begin
       ListaProdutos := ListaProdutos + QuotedStr(qryProdutosproduto.AsString)+',';
       qryProdutos.Next
    end;

    if LIstaProdutos<>'' then
    begin
      delete(ListaProdutos,length(ListaProdutos),1);
      qryProdutos_Diferenca_Substituicao.close;
      qryProdutos_Diferenca_Substituicao.MacroByName('ListaProdutos').AsString := format(SQL,[ListaProdutos]);
      qryProdutos_Diferenca_Substituicao.Open;
      qryProdutos_Diferenca_Substituicao.First;
      while not qryProdutos_Diferenca_Substituicao.Eof do
      begin
        if qryProdutos.Locate('produto',qryProdutos_Diferenca_Substituicaocodigo.AsString,[]) then
        begin
          if qryProdutosincidencia.AsString <>
             qryProdutos_Diferenca_Substituicaovalor.AsString then
          begin
            qryprodutos.Edit;
            qryProdutosincidencia.AsString := qryProdutos_Diferenca_Substituicaovalor.AsString;
            qryprodutos.Post;
          end;
        end;
        qryProdutos_Diferenca_Substituicao.Next;
      end;

      if {eHNotaFiscalSaidaDevolucao(qryDadosFiscaiscodigofiscal.Asinteger)} qryDadosFiscaisrequernfentrada.AsBoolean then
      begin
        qryProdutos_Diferenca_Substituicao.First;
        while not qryProdutos_Diferenca_Substituicao.Eof do
        begin
          if qryProdutos_Diferenca_Substituicaovalor.AsString <> ctCOBRADOSUSTITUICAO then
          begin
            result := true;
            MensagemErro(format(ctPRODUTOSEMSUBSTTRIBUTARIA,
               [qryProdutos_Diferenca_Substituicaocodigo.asstring]));
            break;
          end;
          qryProdutos_Diferenca_Substituicao.Next;
        end;
      end;

    end;
  finally
    VoltarRegistroAtual(qryprodutos)
  end;

end;

function TdtmEmissaoNotaAvulsas.ExisteDiferencaIPI: Boolean;
const
  SQL = 'where p.codigo in (%s)';
var
  ListaProdutos: String;
begin
  result := false;
  if contribipi then
  begin
    ListaProdutos:='';
    if contribipi then
    try
      GuardarRegistroAtual(qryprodutos, true);
      qryprodutos.First;
      if (qrydadosfiscais.State = dsinsert) then
      begin
        while Not qryProdutos.Eof do begin
          ListaProdutos := ListaProdutos + QuotedStr(qryProdutosproduto.AsString)+',';
          qryProdutos.Next
        end;
      end
      else
      begin
        while Not qryProdutos.Eof do
        begin
          if qryProdutosquantidade.AsFloat <> qryProdutosquantidadeantesgravar.AsFloat then
            ListaProdutos := ListaProdutos + QuotedStr(qryProdutosproduto.AsString)+',';
          qryProdutos.Next;
        end;
      end;

      if LIstaProdutos<>'' then
      begin
        delete(ListaProdutos,length(ListaProdutos),1);
        qryProdutos_Diferenca_IPI.close;
        qryProdutos_Diferenca_IPI.MacroByName('ListaProdutos').AsString := format(SQL,[ListaProdutos]);
        qryProdutos_Diferenca_IPI.Open;
        qryProdutos.First;
        while not qryprodutos.Eof do
        begin
          if qryProdutos_Diferenca_IPI.Locate('codigo',qryProdutosproduto.asstring,[]) then
            if qryProdutos_Diferenca_IPIaliquota.AsCurrency <> qryProdutosaliquotaipi.AsCurrency then
            begin
              result := true;
              MensagemErro(format(ctDIFERENCAALIQUOTAIPI,
                 [qryProdutos_Diferenca_IPIcodigo.asstring,
                  formatarvalor(qryProdutosaliquotaipi.ascurrency,2)+'%',
                  formatarvalor(qryProdutos_Diferenca_IPIaliquota.AsCurrency,2)+'%']));
              break;
            end
            else
            begin
              qryprodutos.Edit;
              qryProdutosipi.AsInteger := qryProdutos_Diferenca_IPIipi.AsInteger;
              qryProdutosclassificacaofiscal.AsString := qryProdutos_Diferenca_IPIclassificacaofiscal.AsString;
              qryProdutosnacionalfederal.AsCurrency := qryProdutos_Diferenca_IPInacionalfederal.AsCurrency;
              qryProdutosimportadosfederal.AsCurrency := qryProdutos_Diferenca_IPIimportadosfederal.AsCurrency;
              qryProdutoscargaestadual.AsCurrency := qryProdutos_Diferenca_IPIcargaestadual.AsCurrency;
              qryProdutoschaveibpt.AsString:= qryProdutos_Diferenca_IPIchaveibpt.AsString;
              qryprodutos.Post;
            end;
          qryProdutos.Next;
        end;
      end;
    finally
      VoltarRegistroAtual(qryprodutos)
    end;
  end;
end;

function TdtmEmissaoNotaAvulsas.PerpetrarExclusao(Cancelar: Boolean):boolean;

  function CancelarNFe: boolean;
  var
    ControleNFe: TdtmControleNotasFiscaisEletronicas;
    vDadosFiscaisReadOnly : Boolean;
    vDadosFiscaissituacao : String;

    function GravarSituacaoDadoFiscal(Situacao: String): Boolean;
    begin
      vDadosFiscaisReadOnly := qryDadosFiscais.ReadOnly;
      qryDadosFiscais.ReadOnly := False;
      qryDadosFiscais.Edit;
      qryDadosFiscaissituacao.AsString := 'C';
      qryDadosFiscais.Post;
      qryDadosFiscais.ReadOnly := vDadosFiscaisReadOnly;
      result := perpetrar([qryDadosFiscais]);
    end;

  begin

    result := not qryDadosFiscaisnumcancelamentonfe.isnull or
            not qryDadosFiscaisnuminutilizacaonfe.isnull OR
            not (qryDadosFiscaisstatusnfse.AsInteger = 0);

    if not result then
    begin

      try
        vDadosFiscaissituacao := qryDadosFiscaissituacao.AsString;

        if GravarSituacaoDadoFiscal('C') then
        begin

          vDadosFiscaisReadOnly := qryDadosFiscais.ReadOnly;
          ControleNFe := TdtmControleNotasFiscaisEletronicas.Create(nil);
          if ControleNFe.SelecionarNotas(1,4,qryDadosFiscaisnumero.asInteger) then
            if ControleNFe.EnviarNotasFiscais('', false) then
            begin

              if ControleNFE.Tabela.FieldByName('nfpse').AsBoolean then
              begin

                if (qryDadosFiscaisnumprotocolonfse.AsString = '') and (ControleNFE.Tabela.FieldByName('numprotocolonfse').asstring <> '') then
                begin

                  qryDadosFiscais.ReadOnly := False;
                  qrydadosfiscais.Edit;
                  qryDadosFiscaisnumprotocolonfse.AsString := ControleNFE.Tabela.FieldByName('numprotocolonfse').asstring;
                  qrydadosfiscais.post;
                  qryDadosFiscais.ReadOnly := vDadosFiscaisReadOnly;
                end;

                if (qryDadosFiscaisstatusnfse.Asinteger = 0) and (ControleNFE.Tabela.FieldByName('statusnfse').asinteger<>0) then
                begin
                  qryDadosFiscais.ReadOnly := False;
                  qrydadosfiscais.Edit;
                  qryDadosFiscaisstatusnfse.Asinteger := ControleNFE.Tabela.FieldByName('statusnfse').asinteger;
                  qrydadosfiscais.post;
                  qryDadosFiscais.ReadOnly := vDadosFiscaisReadOnly;
                end;

                result := (qryDadosFiscaisstatusnfse.Asinteger in [1,3]);

              end
              else
              begin

                if (qryDadosFiscaisnumprotocolonfe.AsString = '') and (ControleNFe.Protocolo<>'') then
                begin

                  qryDadosFiscais.ReadOnly := False;
                  qrydadosfiscais.Edit;
                  qryDadosFiscaisnumprotocolonfe.AsString := ControleNFe.Protocolo;
                  qryDadosFiscaisstatusnfe.AsString := ControleNFe.status;

                  if (qryDadosFiscaisstatusnfe.AsString = '301') or    //denegada emitente
                     (qryDadosFiscaisstatusnfe.AsString = '302') then  //denegada destinatario
                    qryDadosFiscaissituacao.AsString := 'D';

                  if (qryDadosFiscaischave_nfe.AsString = '') then
                    qryDadosFiscaischave_nfe.AsString := ControleNFe.vchave_nfe;
                  qrydadosfiscais.post;
                  qryDadosFiscais.ReadOnly := vDadosFiscaisReadOnly;
                end;

                if (qryDadosFiscaisnumcancelamentonfe.AsString = '') and (ControleNFe.ProtocoloCancelamento<>'') then
                begin
                  qryDadosFiscais.ReadOnly := False;
                  qrydadosfiscais.Edit;
                  qryDadosFiscaisnumcancelamentonfe.AsString := ControleNFe.ProtocoloCancelamento;
                  if (qryDadosFiscaischave_nfe.AsString = '') then
                    qryDadosFiscaischave_nfe.AsString := ControleNFe.vchave_nfe;
                  qrydadosfiscais.post;
                  qryDadosFiscais.ReadOnly := vDadosFiscaisReadOnly;
                end;

                if (qryDadosFiscaisnuminutilizacaonfe.AsString = '') and (ControleNFe.ProtocoloInutilizacao<>'') then
                begin
                  qryDadosFiscais.ReadOnly := False;
                  qrydadosfiscais.Edit;
                  qryDadosFiscaisnuminutilizacaonfe.AsString := ControleNFe.ProtocoloInutilizacao;
                  if (qryDadosFiscaischave_nfe.AsString = '') then
                    qryDadosFiscaischave_nfe.AsString := ControleNFe.vchave_nfe;
                  qrydadosfiscais.post;
