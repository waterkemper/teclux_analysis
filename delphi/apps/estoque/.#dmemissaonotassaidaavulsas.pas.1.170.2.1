function TdtmEmissaoNotaAvulsas.PermitirExcluirNotaFiscal: Boolean;
var
  UsrAut: TtecUsuarios;
  vDataHora : TDateTime;

  function PossuiItensNFEntradaReferenciada: boolean;
  begin
    qryProdutosNotasPag.macroByName('CondicaoDadoFiscal').asString := 'and pnp.dadofiscal = :dadofiscal and np.situacao = ''N''';
    qryProdutosNotasPag.ParamByName('DadoFiscal').asinteger := qryDadosFiscaisnumero.asInteger;
    qryProdutosNotasPag.Close;
    qryProdutosNotasPag.Open;
    result := qryProdutosNotasPag.recordcount <> 0;
  end;

begin
  result := true;
  if ParSistema.DataContabil > qryDadosFiscaisdata.AsDateTime then
  begin
    Result := False;
    MensagemAviso(Format(ctDATACONTABILMAIORDATANOTA, [qryDadosFiscaisdata.AsString]));
  end
  else
  if PossuiItensNFEntradaReferenciada then
  begin
    result := false;
    MensagemAviso('Esta nota possui itens de entrada referenciados. Utilize a opção "devolução".');
  end
  else
  begin
    if CondicaoEmissorNFE then
    begin
      if (qryDadosFiscaisnumprotocolonfe.AsString <> '') then
      begin
        if not qryDadosFiscaisdhprocnfe.IsNull then
          vDataHora := qryDadosFiscaisdhprocnfe.AsDateTime
        else
          vDataHora := qryDadosFiscaisdatahoraemissao.AsDateTime;


        if (SecondsBetween(vDataHora, now) > (parsistema.LimitedediasparacancelamentodaNFE*24*60*60)) then
        begin
          result := false;
          MensagemAviso( 'A data para o cancelamento da NFE expirou em '+FormatDateTime('dd/mm/yyyy hh:mm:ss', (vdatahora+parsistema.LimitedediasparacancelamentodaNFE)));
        end;
      end
      else
      if (qryDadosFiscaisnumprotocolonfse.AsString <> '') then
      begin
        if not qryDadosFiscaisdhprocnfe.IsNull then
          vDataHora := qryDadosFiscaisdhprocnfe.AsDateTime
        else
          vDataHora := qryDadosFiscaisdatahoraemissao.AsDateTime;


        if (SecondsBetween(vDataHora, now) > (parsistema.LimitedediasparacancelamentodaNFPSE*24*60*60)) then
        begin
          result := false;
          MensagemAviso( 'A data para o cancelamento da NFPSE expirou em '+FormatDateTime('dd/mm/yyyy hh:mm:ss', (vdatahora+parsistema.LimitedediasparacancelamentodaNFPSE)));
        end;
      end;
    end;

    if result then
    begin
      UsrAut := ObterAutorizacao(taLOGIN, ctEXCLUSAONOTASAIDA, ctGERENTEESTOQUE, '');
      if Assigned(UsrAut) then
      begin
        if UsrAut.GerenteEstoque then
          Result := True
        else begin
          Result := False;
          MensagemAviso(ctUSUARIOSEMPERMISSAO);
        end
      end
      else
        result := False;
    end;

  end;
end;

function TdtmEmissaoNotaAvulsas.PreencherNotaFiscal: Boolean;
begin
  Result := True;
  if (qrySeriesFiliaisnumeroinicial.AsInteger > qryDadosFiscaisnumeronota.AsInteger) and
     (qrySeriesFiliaisnumerofinal.AsInteger < qryDadosFiscaisnumeronota.AsInteger) then
  begin
    result := false;
    case TipoNotaAvulsa of
      tnaNOTAJACADASTRADACOMCONTRATO, tnaNOTAJACADASTRADASEMCONTRATO:
          MensagemAviso('O número da nota está fora do intervalo permitido para esta série.');
      tnaNOTAINCLUSAO:
          result := MensagemConfirmacao('O número da nota está fora do intervalo permitido para esta série.') = smbOK;
    end;
  end;

  if Result then begin
    if not ReadOnlyProdutos then
    begin
      qryProdutos.First;
      while Not qryProdutos.Eof do begin
        qryProdutos.Edit;
        qryProdutosdadofiscal.AsInteger := qryDadosFiscaisnumero.AsInteger;
        qryProdutos.Next;
      end;
    end;
{
    if qryLinhasNotasFiscais.RecordCount > 0 then
    begin
      qryLinhasNotasFiscais.First;
      while not qryLinhasNotasFiscais.Eof do begin
        qryLinhasNotasFiscais.Edit;
        qryLinhasNotasFiscaisdadofiscal.AsInteger:= qryDadosFiscaisnumero.AsInteger;
        qryLinhasNotasFiscais.Next;
      end;
    end;
}
    if qryVenctosDadosFiscais.Active then
    begin
      qryVenctosDadosFiscais.AfterPost := nil;
      qryVenctosDadosFiscais.First;
      while Not qryVenctosDadosFiscais.Eof do begin
        qryVenctosDadosFiscais.Edit;
        qryVenctosDadosFiscaisnumero.AsInteger  := qryVenctosDadosFiscais.recno;
        qryVenctosDadosFiscaisdadofiscal.AsInteger := qryDadosFiscaisnumero.AsInteger;

        qryVenctosDadosFiscais.Next;
      end;
      qryVenctosDadosFiscais.AfterPost := qryVenctosDadosFiscaisAfterPost;
    end;

    if qryDadosFiscais.State = dsinsert then
    begin
      if qryNotas.State = dsInactive then
        qryNotas.Open;
      qryNotas.Append;
      qryNotasfilial.AsInteger := FilialBase;

      case TipoNotaAvulsa of
        tnaNOTAJACADASTRADACOMCONTRATO, tnaNOTAJACADASTRADASEMCONTRATO:
        begin
          qryNotasserie.AsString   := qryDadosFiscaisserie.AsString;;
          qryNotasnumero.AsInteger := qryDadosFiscaisnumeronota.AsInteger;
        end;
        tnaNOTAINCLUSAO:
        begin
          qryNotasserie.AsString   := SerieSugestao;
          qryNotasnumero.AsInteger := qrySeriesFiliaisnumeroinicial.AsInteger;
          qryDadosFiscaisnumeronota.AsInteger := qryNotasnumero.AsInteger;
          qrySeriesFiliais.Edit;
          qrySeriesFiliaisnumeroinicial.AsInteger := qrySeriesFiliaisnumeroinicial.AsInteger + 1;
          qrySeriesFiliais.Post;
        end;
      end;
      qryNotasdadofiscal.AsInteger := qryDadosFiscaisnumero.AsInteger;
      qryNotas.Post;
      if qrySeriesFiliaisnumeroinicial.AsInteger <= qrySeriesFiliaisnumerofinal.AsInteger then
        Result := True
      else
        Result := MensagemAviso(Format(ctSERIEESGOTADA, [qrySeriesFiliaisnumerofinal.AsString]) + sLineBreak + ctCONFIRMEINPRESSAO) = smbOK;
      if result then
        result := VerificaNotaFiscalJaCadastrada
    end;
  end;
end;

procedure TdtmEmissaoNotaAvulsas.PreencherNotaFiscalComContrato;
var
  Ped,
  Obs: String;

  procedure IncluirParcelas;
  begin
    qryVenctosDadosFiscais.Open;
    qryVenctosDadosFiscais.AfterDelete := nil;
    while qryVenctosDadosFiscais.RecordCount > 0 do
      qryVenctosDadosFiscais.Delete;
    qryVenctosDadosFiscais.AfterDelete := qryVenctosDadosFiscaisAfterDelete;

    qryVenctosDadosFiscais.AfterPost := nil;
    qryParcelas.First;
    while Not qryParcelas.Eof do begin
      qryVenctosDadosFiscais.Append;
      qryVenctosDadosFiscaisnumero.AsInteger       := qryParcelasnumero.AsInteger;
      qryVenctosDadosFiscaisdatavencto.AsDateTime  := qryParcelasdatavencto.AsDateTime;
      qryVenctosDadosFiscaisvalorvencto.AsCurrency := qryParcelasvalorvencto.AsCurrency;
      qryVenctosDadosFiscais.Post;
      qryParcelas.Next
    end;
    qryVenctosDadosFiscais.AfterPost := qryVenctosDadosFiscaisAfterPost;
  end;

  procedure IncluirProdutos;
  var
    EhNormal,
    EhSubstituicao,
    EhSubstituido,
    EhProducaoPropria,
    EhBrinde : Boolean;

  begin
    while qryProdutos.RecordCount > 0 do
      qryProdutos.Delete;
    qryProdutosContratos.First;
    while Not qryProdutosContratos.Eof do begin
      qryProdutos.Append;
      qryProdutosnumero.AsInteger             := qryProdutosContratosnumero.AsInteger;
      qryProdutosproduto.AsLargeInt           := qryProdutosContratosproduto.AsLargeInt;
      qryProdutosprodutovisual.AsString       := qryProdutosContratosprodutovisual.AsString;
      qryProdutosprodutodigitado.AsString     := qryProdutosContratosprodutodigitado.AsString;

      qryProdutosfilial.AsInteger             := qryProdutosContratosfilial.AsInteger;

      qryProdutosdescricaoproduto.AsString    := trim(qryProdutosContratosdescricao.AsString + ' ' +
                                                      qryProdutosContratosvalorgrade1.AsString + ' '+
                                                      qryProdutosContratosvalorgrade2.AsString);

      qryProdutosunidade.AsString             := qryProdutosContratosunidade.AsString;
      qryProdutosunidadenf.AsString           := qryProdutosContratosunidade.AsString;
      qryProdutosfatorconversao.AsCurrency    := 1;

      qryProdutosquantidade.AsFloat        := qryProdutosContratosquantidade.AsFloat - qryProdutosContratoscancelado.AsFloat;
      qryProdutosqtdeestoque.AsFloat        := qryProdutosquantidade.AsFloat * qryProdutosfatorconversao.AsFloat;

      qryProdutosdesconto.AsCurrency          := qryProdutosContratosdesconto.AsCurrency;
      qryProdutosvalordescontoitem.AsCurrency := qryProdutosContratosvalordescontoitem.AsCurrency;
      qryProdutosfrete.AsCurrency             := qryProdutosContratosfrete.AsCurrency;
      qryProdutosseguro.AsCurrency            := qryProdutosContratosseguro.AsCurrency;
      qryProdutosacrescimo.AsCurrency         := qryProdutosContratosacrescimo.AsCurrency;
      qryProdutosdescricaoprecovenda.AsString := qryProdutosContratosdescricaoprecovenda.AsString;

      if Not qryProdutosContratosicms.IsNull then
        qryProdutosicms.AsInteger             := qryProdutosContratosicms.AsInteger;
      qryProdutosincidencia.AsString          := qryProdutosContratosincidencia.AsString;
      qryProdutoscsosn.AsString               := qryProdutosContratoscsosn.AsString;
      qryProdutospiscst.AsString              := qryProdutosContratospiscst.AsString;
      qryProdutoscofinscst.AsString           := qryProdutosContratoscofinscst.AsString;
      qryProdutosclassificacaofiscal.AsString := qryProdutosContratosclassificacaofiscal.AsString;

      qryProdutosorigem.AsInteger              := qryProdutosContratosorigem.AsInteger;
      qryProdutosaliquotaipi.AsFloat          := qryProdutosContratosaliquotaipi.AsFloat;
      qryProdutoscomposto.AsBoolean           := qryProdutosContratoscomposto.AsBoolean;
      qryProdutospn.AsString                  := qryProdutosContratosproduto.AsString;


      if qryProdutoscontratosipi.AsInteger <> 0 then
        qryProdutosipi.AsInteger                := qryProdutoscontratosipi.AsInteger;
      qryProdutosprodutototal.AsCurrency := Truncar((qryProdutosprecovenda.     AsCurrency *
                                                  qryProdutosquantidade.AsFloat) , 2);

      if (qryProdutosincidencia.AsString = ctTRIBUTADASUBSTITUICAO) and
         (not qryContratosvendaconsumidorfinal.AsBoolean) then
        ReFazConsulta(qryEstadosIPI,[0],[qryProdutosContratosipi.AsVariant]);


      if (RegimeTributario=1) then  //SIMPLES NACIONAL
      begin
        EhNormal :=  (Not qryProdutosContratosbrinde.AsBoolean)          and
                     (not qryProdutosContratosproducaopropria.AsBoolean) and
                     ((qryProdutosContratoscsosn.AsString = '101')    or
                      (qryProdutosContratoscsosn.AsString = '102')    or

                      (qryProdutosContratoscsosn.AsString = '103')       or
                      (qryProdutosContratoscsosn.AsString = '300')       or
                      (qryProdutosContratoscsosn.AsString = '400')       or

                      (qryProdutosContratoscsosn.AsString = '500') or

                      (((qryProdutosContratoscsosn.AsString = '201') or
                        (qryProdutosContratoscsosn.AsString = '202') or
                        (qryProdutosContratoscsosn.AsString = '203')) and
                       qryContratosvendaconsumidorfinal.AsBoolean)             or

                      (((qryProdutosContratoscsosn.AsString = '201') or
                        (qryProdutosContratoscsosn.AsString = '202') or
                        (qryProdutosContratoscsosn.AsString = '203')) and
                       (not qryContratosvendaconsumidorfinal.AsBoolean)                    and
                       (not qryEstadosIPI.Locate('estado', qryContratosestado.AsString, []))));

        EhSubstituicao :=  Not qryProdutosContratosbrinde.AsBoolean and
                          (((qryProdutosContratoscsosn.AsString = '201') or
                            (qryProdutosContratoscsosn.AsString = '202') or
                            (qryProdutosContratoscsosn.AsString = '203')) and
                           (not qryContratosvendaconsumidorfinal.AsBoolean) and
                           (qryEstadosIPI.Locate('estado', qryContratosestado.AsString, [])));

        EhSubstituido  :=  Not qryProdutosContratosbrinde.AsBoolean and
                          ((qryProdutosContratoscsosn.AsString = '203') or
                           (qryProdutosContratoscsosn.AsString = '500'));

        EhProducaoPropria := (not qryProdutosContratosbrinde.AsBoolean)      		         and
                             (qryProdutosContratosproducaopropria.AsBoolean) 		         and

                             (qryProdutosContratoscsosn.AsString <> '500') and

                             ( ( not ((qryProdutosContratoscsosn.AsString = '201') or
                                      (qryProdutosContratoscsosn.AsString = '202') or
                                      (qryProdutosContratoscsosn.AsString = '203')))       or

                               ((    ((qryProdutosContratoscsosn.AsString = '201') or
                                      (qryProdutosContratoscsosn.AsString = '202') or
                                      (qryProdutosContratoscsosn.AsString = '203'))) and
                                     (qryContratosvendaconsumidorfinal.AsBoolean))         or

                                     (((qryProdutosContratoscsosn.AsString = '201') or
                                       (qryProdutosContratoscsosn.AsString = '202') or
                                       (qryProdutosContratoscsosn.AsString = '203')) and
                                      (not qryContratosvendaconsumidorfinal.AsBoolean) and
                                      (not qryEstadosIPI.Locate('estado', qryContratosestado.AsString, []))));


        EhBrinde :=  {Not Assigned(ECFPadrao) and} qryProdutosContratosbrinde.AsBoolean;

      end
      else
      begin
        EhNormal :=  (Not qryProdutosContratosbrinde.AsBoolean)          and
                     (not qryProdutosContratosproducaopropria.AsBoolean) and
                     ((qryProdutosContratosincidencia.AsString = ctTRIBUTADA)    or
                      (qryProdutosContratosincidencia.AsString = ctREDUCAOBASE)  or
                      (qryProdutosContratosincidencia.AsString = ctISENTA)       or
                      (qryProdutosContratosincidencia.AsString = ctNAOTRIBUTADA) or
                      (qryProdutosContratosincidencia.AsString = ctSUSPENSAO)    or
                      (qryProdutosContratosincidencia.AsString = ctDIFERIMENTO)  or
                      ((qryProdutosContratosincidencia.AsString = ctCOBRADOSUSTITUICAO) {and  Assigned(ECFPadrao)}) or
                      ((qryProdutosContratosincidencia.AsString = ctTRIBUTADASUBSTITUICAO) and
                       (qryContratosvendaconsumidorfinal.AsBoolean))             or
                      ((qryProdutosContratosincidencia.AsString = ctTRIBUTADASUBSTITUICAO) and
                       (not qryContratosvendaconsumidorfinal.AsBoolean)                    and
                       (not qryEstadosIPI.Locate('estado', qryContratosestado.AsString, []))));

        EhSubstituicao := {Not Assigned(ECFPadrao) and}
                          Not qryProdutosContratosbrinde.AsBoolean and
                          ((qryProdutosContratosincidencia.AsString = ctTRIBUTADASUBSTITUICAO) and
                           (not qryContratosvendaconsumidorfinal.AsBoolean) and
                           (qryEstadosIPI.Locate('estado', qryContratosestado.AsString, [])));

        EhSubstituido  := {Not Assigned(ECFPadrao) and}
                          Not qryProdutosContratosbrinde.AsBoolean and
                          ((qryProdutosContratosincidencia.AsString = ctISENTASUBSTITUICAO) or
                           (qryProdutosContratosincidencia.AsString = ctCOBRADOSUSTITUICAO) or
                           (qryProdutosContratosincidencia.AsString = ctREDUCAOBASESUBSTITUICAO));

        EhProducaoPropria := {(Not Assigned(ECFPadrao))                                         and}
                             (not qryProdutosContratosbrinde.AsBoolean)      		         and
                             (qryProdutosContratosproducaopropria.AsBoolean) 		         and
                             (qryProdutosContratosincidencia.AsString <> ctCOBRADOSUSTITUICAO) and
                             ((qryProdutosContratosincidencia.AsString <> ctTRIBUTADASUBSTITUICAO) or
                              ((qryProdutosContratosincidencia.AsString = ctTRIBUTADASUBSTITUICAO) and
                               (qryContratosvendaconsumidorfinal.AsBoolean))                       or
                              ((qryProdutosContratosincidencia.AsString = ctTRIBUTADASUBSTITUICAO) and
                               (not qryContratosvendaconsumidorfinal.AsBoolean)                    and
                               (not qryEstadosIPI.Locate('estado', qryContratosestado.AsString, []))));


        EhBrinde :=  {Not Assigned(ECFPadrao) and} qryProdutosContratosbrinde.AsBoolean;
      end;

      TemNormal          := TemNormal          or EhNormal;
      TemBrinde          := TemBrinde          or EhBrinde;
      TemSubstituicao    := TemSubstituicao    or EhSubstituicao;
      TemSubstituido     := TemSubstituido     or EhSubstituido;
      TemProducaoPropria := TemProducaoPropria or EhProducaoPropria;

      if EhNormal then
        SelecionarCodigoFiscalNatureza('VENDAS DE MERCADORIAS')
      else
      if EhBrinde then
        SelecionarCodigoFiscalNatureza('DOAÇÃO OU BRINDE')
      else
      if EhSubstituido then
        SelecionarCodigoFiscalNatureza('VENDAS ICMS SUBSTITUTO')
      else
      if EhSubstituicao then
        SelecionarCodigoFiscalNatureza('VENDAS ICMS SUBSTITUIÇÃO')
      else
      if EhProducaoPropria then
        SelecionarCodigoFiscalNatureza('VENDAS PRODUÇÃO PRÓPRIA');

      qryProcuraCodigoFiscalProduto.BeforeOpen := nil;
      RefazConsultaPorNome(qryProcuraCodigoFiscalProduto,['codigofiscal'],[qryProdutoscodigofiscal.Asinteger]);
      qryProcuraCodigoFiscalProduto.BeforeOpen := qryProcuraCodigoFiscalProdutoBeforeOpen;

      qryprocuracodigofiscalproduto.locate('codigonatureza', qryprodutosnatureza.AsInteger, []);

      AtribuirDadosProdutos(qryprodutos, qryDadosFiscais, qryProcuraCodigoFiscalProduto, False, NotaAvulsa);
      qryProdutosprecovenda.AsFloat        := qryProdutosContratosprecovenda.AsFloat;
      qryProdutosprecotabela.AsFloat          := qryProdutosContratosprecotabela.AsFloat;
      qryProdutosaliquotaicms.AsFloat         := qryProdutosContratosaliquotaicms.AsFloat;


      qryProdutosprodutook.AsBoolean := true;
      qryProdutos.Post;
      qryProdutosContratos.Next
    end
  end;

  procedure SelecionarCodigoNatureza(descricao: String);
  begin
    if qryNaturezasPadrao.Locate('descricao',descricao,[]) then
    begin
      qrydadosfiscaiscodigonatureza.asinteger := qryNaturezasPadraonatureza.AsInteger;
      qryDadosFiscaisnatureza.AsString := qryNaturezasPadraodescricao.AsString;
      qryDadosFiscaiscodigofiscal.AsInteger   := qryNaturezasPadraocodigofiscal.AsInteger;

      if qryProcuraCodigoFiscal.active then
        qryProcuraCodigoFiscal.locate('codigonatureza', qrydadosfiscaiscodigonatureza.asinteger, []);

      if qryDadosFiscaiscodigofiscal.AsInteger <> 8000 then
        if not (qryDadosFiscaisestadocfo.AsString = EstadoFilialBase) then
          if HeUnidadeFederacao(qryDadosFiscaisestadocfo.AsString) then
          begin
            if  qryDadosFiscaiscodigofiscal.AsInteger = ctVENDASUBSTITUIDODENTROESTADO then
              qryDadosFiscaiscodigofiscal.AsInteger := qryDadosFiscaiscodigofiscal.AsInteger+999
            else
              qryDadosFiscaiscodigofiscal.AsInteger := qryDadosFiscaiscodigofiscal.AsInteger+1000;
          end
          else
            qryDadosFiscaiscodigofiscal.AsInteger := qryDadosFiscaiscodigofiscal.AsInteger+2000;
    end;
  end;

begin
