procedure TdtmEmissaoNotaAvulsas.qryProcuraProdutoBeforeOpen(
  DataSet: TDataSet);
begin
  inherited;
  if qryProdutoscodigonota.AsInteger<>0 then
  begin
    qryProcuraProduto.Sql.Text := qryProcuraProdutoNotaEntrada.Sql.Text;
    qryProcuraProduto.ParamByName('FilialBase').AsInteger := FilialBase;
    qryProcuraProduto.ParamByName('codigoNota').AsInteger := qryProdutoscodigonota.AsInteger;

    if ListaProdutosCadastrados<>'' then
      qryProcuraProduto.MacroByName('SQLListas').AsString :=
         format(SQLListaProdutosNotasEntradas,[ListaProdutosCadastrados])
    else
      qryProcuraProduto.MacroByName('SQLListas').AsString := '';

    if qryProcuraProduto.ParamByName('numeroproduto').IsNull then
      qryProcuraProduto.MacroByName('SQLListas').AsString := qryProcuraProduto.MacroByName('SQLListas').AsString + ' limit 1';

  end
  else
  if qryDadosFiscaisdadofiscalreferenciado.AsInteger <> 0 then
  begin
    qryProcuraProduto.Sql.Text := qryProcuraProdutoNotaReferenciada.Sql.Text;
    qryProcuraProduto.ParamByName('FilialBase').AsInteger := FilialBase;
    qryProcuraProduto.ParamByName('dadofiscal').AsInteger := qryDadosFiscaisdadofiscalreferenciado.AsInteger;

    if ListaProdutosCadastrados<>'' then
      qryProcuraProduto.MacroByName('SQLListas').AsString :=
         format(SQLListaProdutosNotaReferenciada,[ListaProdutosCadastrados])
    else
      qryProcuraProduto.MacroByName('SQLListas').AsString := '';

    if qryProcuraProduto.ParamByName('numeroproduto').IsNull then
      qryProcuraProduto.MacroByName('SQLListas').AsString := qryProcuraProduto.MacroByName('SQLListas').AsString + ' limit 1';
  end
  else
  begin
    qryProcuraProduto.Sql.Text := qryProcuraProdutoNormal.Sql.Text;
    qryProcuraProduto.ParamByName('numeroproduto').clear;

    if (ListaProdutosCadastrados<>'') and not ParSistema.GravarProdutoContratoAutomaticamente then
      qryProcuraProduto.MacroByName('SQLListas').AsString := format(SQLListaProdutos,[ListaProdutosCadastrados])
    else
      qryProcuraProduto.MacroByName('SQLListas').AsString := '';

    qryProcuraProduto.ParamByName('FilialBase').AsInteger := FilialBase;
  end;

end;

