procedure TdtmEmissaoNotaAvulsas.VerificarContratos;
 procedure AtualizarSaldoCreditoCliente(tipo: String);
 begin
   if qryContratoscreditotroca.AsCurrency <> 0 then
   begin
     ReFazConsulta(qryProdutosTrocados,[],[]);
     qryprodutostrocados.Insert;
     spcProdutosTrocadosProximo.Open;
     qryProdutosTrocadosnumero.AsInteger := spcProdutosTrocadosProximonumero.AsInteger;
     spcProdutosTrocadosProximo.close;
     qryProdutosTrocadostipo.AsString := tipo;
     qryProdutosTrocadosdata.AsDateTime := now();
     qryProdutosTrocadoscliente.AsInteger := qryContratoscliente.AsInteger;
     qryProdutosTrocadostipocliente.AsString := qryContratostipocliente.AsString;
     qryProdutosTrocadoscontrato.AsString := qryContratosnumero.AsString;
     qryProdutosTrocadosfilial.Asinteger := FilialBase;
     qryProdutosTrocadosusuario.AsInteger := CodigoUsuario;
     qryProdutosTrocadosvalor.AsCurrency := qryContratoscreditotroca.AsCurrency;
     qryprodutostrocados.post;

     if tipo='E' then
     begin
       qryparcelas.First;
       while not qryparcelas.Eof do
       begin
         if qryParcelasformapagamento.AsString='T' then
         begin
           qryparcelas.edit;
           qryParcelasdatapagto.clear;
           qryParcelasvalorpagto.clear;
           qryParcelasfilialpagto.clear;
           qryParcelasNometipopagto.clear;
         end;
         qryparcelas.Next;
       end;
     end;
   end;
 end;

 function ExisteCancelamentoAutenticacaoPagtoParcela: boolean;
 begin
   RefazConsultaPorNome(qryCancelamentoAutenticacoesParcelas, ['contrato'], [qryContratosnumero.asString]);
   result := qryCancelamentoAutenticacoesParcelasexistente.asboolean;
   
 end;


begin
    if Not qryDadosFiscaiscontrato.IsNull then
    begin

      if not qryDadosFiscaisvendatransferencia.AsBoolean then    //se for uma transferencia na empresa com raiz cnpj diferente.
      begin
        ReFazConsulta(qryNotasContratos, [0,1], [qryDadosFiscaiscontrato.AsString, qryDadosFiscaisnumero.AsInteger]);
        ReFazConsulta(qryContratos, [0], [qryDadosFiscaiscontrato.AsString]);
        ReFazConsulta(qryParcelas, [0], [qryDadosFiscaiscontrato.AsString]);

        qryContratos.Edit;
        if SomenteBrinde or
          ( (qryNotasContratosquantidade.AsInteger      = 0) and
            ((qryContratosQtdadeparcelaspagas.AsInteger = 0) and
             not ExisteCancelamentoAutenticacaoPagtoParcela) ) then
        begin
          qryContratossituacao.AsString := 'R';
          qryContratosoperacao.AsString := 'C';

          if qryDadosFiscaissituacao.AsString <> 'C' then {já foi imputado o crédito se estiver cancelado}
          {AQUI ERRO 1 CADASTRAR CONTRATO ATE NF COM CREDIDO DE TROCA, CANCELAR NF PARA VOLTAR PARA RESERVADO, FATURAR NOVAMENTE E VER AS PARCELAS}

            AtualizarSaldoCreditoCliente('E');
        end
        else
        if qryNotasContratosquantidade.AsInteger > 0 then
          qryContratossituacao.AsString := 'P'
        else
        if ((qryNotasContratosquantidade.AsInteger     = 0) and
            ((qryContratosQtdadeparcelaspagas.AsInteger > 0) or
             ((qryContratosQtdadeparcelaspagas.AsInteger = 0) and ExisteCancelamentoAutenticacaoPagtoParcela)) ) then
          qryContratossituacao.AsString := 'F';
        qryContratos.Post;
      end;
    end;

end;

