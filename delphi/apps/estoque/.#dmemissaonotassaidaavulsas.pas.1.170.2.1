procedure TdtmEmissaoNotaAvulsas.AbrirDadosFiscais;
begin
  if (qryDadosFiscais.State = dsinsert) then
  begin
    if (qrydadosfiscais.Params[0].asstring<>'') and
       (qrydadosfiscais.Params[1].asstring<>'') and
       (qrydadosfiscais.Params[2].asstring<>'') then
    begin
      ReFazConsulta(qryProcuraNota, [0,1,2], [qrydadosfiscais.Params[0].asstring,
                                              qrydadosfiscais.Params[1].asstring,
                                              qrydadosfiscais.Params[2].asstring]);
      if (qryProcuraNota.RecordCount=1) then
      begin
        ReFazConsulta(qryDadosFiscais,[],[]);
        if not Alterando then
          MensagemAviso(Format('A nota ''%s'' já está cadastrada para a filial ''%s'' e série ''%s''',
                               [qryProcuraNotanumero.AsString,
                                qryProcuraNotafilial.AsString,
                                qryProcuraNotaserie.AsString]));
      end;
    end;
  end;
end;

