function TdtmEmissaoNotaAvulsas.getTipoNotaSaida: TtecTipoNotaSaida;
var
  CodFiscal: Integer;
begin
  CodFiscal := qryDadosFiscaiscodigofiscal.AsInteger mod 1000;
  if (CodFiscal = ctCFOTRANSFERENCIA_150) or
     (CodFiscal = ctCFOTRANSFERENCIA_151) or
     (CodFiscal = ctCFOTRANSFERENCIA_152) or
     (CodFiscal = ctCFOTRANSFERENCIANAOTRANS) or
     (CodFiscal = ctCFOTRANSFERENCIASUBSTITUICAO)
  then
    FTipoNotaSaida := tnsTRANSFERENCIA
  else if (CodFiscal = ctCFOTRANSFERENCIACREDITOICMS) or
          (CodFiscal = ctCFOTRANSFERENCIASALDOCREDORICMS) or
          (CodFiscal = ctCFOTRANSFERENCIASALDODEVEDORICMS)
  then
    FTipoNotaSaida := tnsTRANSFERENCIAICMS
  else if (CodFiscal = 410) or  // Devolução de compra para industrialização em operação com mercadoria sujeita ao regime de substituição tributária
          (CodFiscal = 411) or  // Devolução de compra para comercialização em operação com mercadoria sujeita ao regime de substituição tributária
          (CodFiscal = 412) or  // Devolução de bem do ativo imobilizado, em operação com mercadoria sujeita ao regime de substituição tributária
          (CodFiscal = 413) then  // Devolução de mercadoria destinada ao uso ou consumo, em operação com mercadoria sujeita ao regime de substituição tributária
    FTipoNotaSaida := tnsDEVOLUCAOFORNECEDORST
  {acrescentado 13/12/10 Gedovar: a seleção de nf esta somente p/ st e não nota normal}
  else if (CodFiscal = 201) or  // Devolução de compra para industrialização
          (CodFiscal = 202) or  // Devolução de compra para comercialização
          (CodFiscal = 205) or  // Anulação de valor relativo a aquisição de serviço de comunicação
          (CodFiscal = 206) or  // Anulação de valor relativo a aquisição de serviço de transporte
          (CodFiscal = 207) or  // Anulação de valor relativo à compra de energia elétrica
          (CodFiscal = 208) or  // Devolução de mercadoria recebida em transferência para industrialização
          (CodFiscal = 209) or  // Devolução de mercadoria recebida em transferência para comercialização
          (CodFiscal = 210) or  // Devolução de compra para utilização na prestação de serviço

          (CodFiscal = 553) or  // Devolução de compra de bem para o ativo imobilizado
          (CodFiscal = 555) or  // Devolução de bem do ativo imobilizado de terceiro, recebido para uso no estabelecimento
          (CodFiscal = 556) or  // Devolução de compra de material de uso ou consumo
          (CodFiscal = 902) or  //Retorno de mercadoria utilizada na industrialização por encomenda
          (CodFiscal = 903) then    //Retorno de mercadoria recebida para industrialização e não aplicada no referido processo
    FTipoNotaSaida := tnsDEVOLUCAOFORNECEDOR
  else
    FTipoNotaSaida := tnsNORMAL;

  result := FTipoNotaSaida;
end;

function TdtmEmissaoNotaAvulsas.VerificaNotaFiscalJaCadastrada: Boolean;
begin
  ReFazConsulta(qryProcuraNota, [0,1,2], [qryDadosFiscaisfilial.AsInteger,
                                         qryDadosFiscaisserie.AsString,
                                         qryDadosFiscaisnumeronota.AsInteger]);
  result := (qryProcuraNota.RecordCount=0);
  if not result then  // se encontrou
  begin
    MensagemAviso('Existe outra nota (Série:'+qryDadosFiscaisserie.AsString +
                 ' Número:'+qryDadosFiscaisnumeronota.AsString +
                 ') com a mesma série e número na filial ''' +
                 qryDadosFiscaisfilial.AsString + '''');
    qryNotas.Delete;
    qryDadosFiscaisnumeronota.Clear;
  end;
end;

function TdtmEmissaoNotaAvulsas.GravarNotaFiscal(var Erro:Integer): Boolean;
var
  erroestoque, v_produto, v_produtovisual, v_filial {, ChaveAcesso
  LoteNFe, ReciboNFe, ProtocoloNFe, status, DataHoraProcessamento} : String;
{  NFe: TTecNotaFiscalEletronica;}

  function ValidarTotalProdutos: Boolean;
   var TotalProdutos: Currency;
  begin
    result := true;
    TotalProdutos := truncar(
                     (qryDadosFiscaistotalprodutos.AsCurrency +
                      qryDadosFiscaistotalvaloricmssubstituicao.AsCurrency +
                      qryDadosFiscaisvalorfrete.AsCurrency +
                      qryDadosFiscaisseguro.AsCurrency +
                      qryDadosFiscaisdespesasacessorias.AsCurrency +
                      qryDadosFiscaisvicmsstretdesp.ascurrency +
                      qryDadosFiscaisvaloripi.AsCurrency +
                      qryDadosFiscaisvalorservicos.AsCurrency
                      ),2);

    if eHNotaFiscalSaidaDevolucao(qryDadosFiscaisCodigoFiscal.asinteger) and
      ((qryDadosFiscaisCodigoFiscal.asinteger div 1000) = 7) then  // devolução de nota de importação
      TotalProdutos := TotalProdutos + qryDadosFiscaisvaloricms.asCurrency;

    if (TotalProdutos - truncar(qryDadosFiscaisvalortotal.AsCurrency,2))<> 0 then
    begin
      result := false;
      erro := 1;
      MensagemAviso(format
        (ctSOMATORIODIFERENTESTOTAL,[
          'os produtos, servicos e demais campos',
          FormatarValor(TotalProdutos,2),
          'a '+ansilowercase(ctNOTAFISCAL),
          formatarvalor(qryDadosFiscaisvalortotal.AsCurrency,2),
          FormatarValor((TotalProdutos - qryDadosFiscaisvalortotal.AsCurrency),2)
          ]));
    end;

//    if result then
  end;


  procedure PreencherChaveValumes;
  begin
    qryVolumesDadosFiscais.DisableControls; //GuardarRegistroAtual(qryVolumesDadosFiscais,true);
    try
      qryVolumesDadosFiscais.First;
      while not qryVolumesDadosFiscais.Eof do
      begin
        if (qryVolumesDadosFiscaisvolumes.AsString           = '') and
           (qryVolumesDadosFiscaisnumeracao.AsString         = '') and
           (qryVolumesDadosFiscaispesobruto.AsString         = '') and
           (qryVolumesDadosFiscaispesoliquido.AsString       = '') and
           (qryVolumesDadosFiscaismarca.AsString             = '') and
           (qryVolumesDadosFiscaisespecietransporte.AsString = '') then
          qryVolumesDadosFiscais.Delete
        else
        begin
          qryVolumesDadosFiscais.Edit;
          qryVolumesDadosFiscaisdadofiscal.AsInteger := qryDadosFiscaisnumero.AsInteger;
          qryVolumesDadosFiscais.Post;
          qryLacresVolumesDadosFiscais.First;
          while not qryLacresVolumesDadosFiscais.Eof do
          begin
            if (qryLacresVolumesDadosFiscaislacre.AsString = '') then
              qryLacresVolumesDadosFiscais.Delete
            else
            begin
              qryLacresVolumesDadosFiscais.Edit;
              qryLacresVolumesDadosFiscaisdadofiscal.AsInteger := qryDadosFiscaisnumero.AsInteger;
              qryLacresVolumesDadosFiscais.Post;
            end;
            qryLacresVolumesDadosFiscais.Next;
          end;
        end;
        qryVolumesDadosFiscais.Next;
      end;
    finally
      qryVolumesDadosFiscais.EnableControls; //VoltarRegistroAtual(qryVolumesDadosFiscais);
    end;
  end;

  function PreencherChaveProdutos: Boolean;
  begin
    result := true;
    if not ReadOnlyProdutos then
    begin
      qryProdutos.First;
      while Not qryProdutos.Eof do
      begin
        qryProdutos.Edit;
        qryProdutosdadofiscal.AsInteger := qryDadosFiscaisnumero.AsInteger;
//        qryProdutoscodigofiscal.AsInteger:= qryDadosFiscaiscodigofiscal.AsInteger;
//        qryProdutostribquantidade.AsFloat := qryProdutosquantidade.AsFloat;
//        qryProdutostribunitario.AsFloat := qryProdutosprecovenda.AsFloat;
//        CalcularImpostos(true, qryprodutos, qryDadosFiscais, true, true, true, qryCalculosProdutos, nil, false, NotaAvulsa);
        ValorPIS := ValorPIS + qryProdutospisvalor.AsCurrency;

        if (qryProdutosprecovenda.AsFloat = 0) and not qryProcuraCodigoFiscalProdutodiferenciada.AsBoolean then
        begin
          MensagemErro(ctPRECOZERO+#10#13+
                       format(ctPRECOZERADO,[qryProdutosproduto.asstring]));
          result := false;
          break;
        end;

        qryProdutos.Next;
      end;
    end;
  end;

