  end;

  function VerificarVenctos: boolean;
  begin
    result := true;
    if eHNotaFiscalSaidaVenda(qryDadosFiscaiscodigofiscal.AsInteger) and qryProcuraCodigoFiscalgerarpagamento.AsBoolean then
    begin
      if qrytiposrecebimentos.isempty then
      begin
        MensagemErro('O sistema esta tentando gerar os vencimentos e a tabela de tipos de recebimentos não possue informações');
        result := false;
      end
      else
      begin
        frmVenctosDadosFiscaisRecebimentos:= TfrmVenctosDadosFiscaisRecebimentos.Create(frmVenctosDadosFiscaisRecebimentos);

        frmVenctosDadosFiscaisRecebimentos.ShowModal;
        result := frmVenctosDadosFiscaisRecebimentos.ModalResult = mrOk;
        frmVenctosDadosFiscaisRecebimentos.Free;
      end;
    end;
  end;

begin
  result := false;
  if (Not qryDadosFiscaiscontrato.IsNull) and
     (Not qryDadosFiscaisnumeronota.IsNull) then
    TipoNotaAvulsa := tnaNOTAJACADASTRADACOMCONTRATO
  else
  if (qryDadosFiscaiscontrato.IsNull) and
     (Not qryDadosFiscaisnumeronota.IsNull) then
    TipoNotaAvulsa := tnaNOTAJACADASTRADASEMCONTRATO
  else
    TipoNotaAvulsa := tnaNOTAINCLUSAO;

  if qryDadosFiscais.State = dsinsert then
      qryMovimentos.Open;

  try
    Result := False;
    case TipoNotaAvulsa of
      tnaNOTAJACADASTRADACOMCONTRATO, tnaNOTAJACADASTRADASEMCONTRATO:
      begin
        if qryDadosFiscais.State = dsinsert then
          Result := VerificaNotaFiscalJaCadastrada
        else
          Result := True;
      end;
      tnaNOTAINCLUSAO : Result := True;
    end;

    if Result then
    begin
      if (qryDadosFiscaisnumeronota.AsInteger = 0) and
         (Not qryDadosFiscaiscontrato.IsNull) then
      begin
        MensagemAviso('O Número da nota fiscal de saida não esta preenchido.');
        Result := False;
      end
      else
      begin

        if not qryDadosFiscaisexigenotareferenciada.asboolean  then
        begin
          refazconsultapornome(qryNotaEntradaRef, ['fornecedor','tipofornecedor','serie','numero'],
          [0, '', '', 0]);
          LimparDadosNotaEntradaReferenciada;
        end
        else
        begin
          result := qryNotaEntradaRef.CheckRequiredFields(false, True);
          if result then
          begin
            if parsistema.EmissorNfe then
              if (qryNotaEntradaRefmodelodocto.AsString = '55') and
                 (qryNotaEntradaRefnumeronfe.IsNull) then
              begin
                result := false;
                MensagemErro(format('A Nota de entrada %s série %s referencida nesta nota fiscal possui modelo 55 (Nfe) e o número da NFe não foi informado.'+chr(13)+
                                    'Informe o número da NFe no cadastro de notas fiscais de entrada.', [qryNotaEntradaRefnumero.AsString, qryNotaEntradaRefserie.AsString]));
              end;
          end;

        end;

        if result then
        begin
          if qryDadosFiscais.CheckRequiredFields
             and VerificarSerieFilial
    //         and not ExisteDiferencaIPI
    //         and not ExisteDiferencaIncidencia
             and ValidarTotalProdutos
             and VerificarVenctos
             {and ValidarTotalImpostos} then
          begin
            Result := ConfirmarCFOPcliente;

            if Result then
            begin
              if (qryProdutos.RecordCount = 0) and
                 (qryDadosFiscaiscodigofiscal.AsInteger<>8000) then
              begin
                {
                if qryProcuraCodigoFiscaltipomovimento.AsString <> '' then
                begin
                }
                  Result := False;
                  MensagemAviso(ctNOTASAIDASEMPRODUTO);
              {
                end
                else
                begin
                  if qryDadosFiscaisnumero.IsNull then
                    qryDadosFiscaisnumero.AsInteger := NovoNumeroDadoFiscal;
                  result := PreencherNotaFiscal;
                  if result then
                  begin
                   // IncluirImpostos;
                    qryDadosFiscaisvalorvista.AsFloat := qryDadosFiscaisvalortotal.AsFloat;
                  end;
                end;
               }

              end
              else
              begin
                if qrydadosfiscais.State = dsinsert then
                begin
                  if qryDadosFiscaisnumero.IsNull then
                    qryDadosFiscaisnumero.AsInteger := NovoNumeroDadoFiscal;

                  result := PreencherNotaFiscal;
                  if result then
                  begin
                    AbrirProdutosEstoque;
                    Result := IncluirMovimentos(erroestoque, v_produto, v_produtovisual, v_filial);
                    if Not Result then
                    begin
                      MensagemAviso(Format(ctSEMESTOQUEEMITIRNOTASAIDA, [v_produtovisual, v_filial, ErroEstoque]));
                      CancelarAtualizacoes([qrycontratos, qryEstoqueBloqueio, qryseriesfiliais, qryEstoquefilialtrans, qrynotas]);
                      if TipoNotaAvulsa = tnaNOTAINCLUSAO then // CFE BUG #2672, CASO OCORRESSE ALGUM PROBLEMA, O NUMERO DA NOTA SE MANTINHA
                        qryDadosFiscaisnumeronota.Clear;       // E ACARRETAVA COMPORTAMENTO INDEVIDO
                    end
                  end;
                end
                else
                begin
                  AbrirProdutosEstoque;
                  AlterarMovimentos;
                  result := true;
                end;

                if result then
                begin
                  result := PreencherChaveProdutos;
                  if result then
                  begin
    {                if qryDadosFiscaiscontrato.AsString<>'' then
                      RatearValoresProdutos;}

                    vListaLotes := RetornarLista(qryProdutos, [qryProdutoslotetransferencia]);

                    if (TipoNotaSaida in [tnsTRANSFERENCIAICMS,tnsTRANSFERENCIA]) or (vListaLotes<>'') then
                      GerarRequisicoes;
                  end;
                end;
              end;
            end
            else
              MensagemAviso('CFOP não confere com o estado!');


            if Result then
            begin
              if Not qryDadosFiscaiscontrato.IsNull then
                if qryDadosFiscaisagente.AsInteger <> qryProcuraContratoagente.AsInteger then
                begin
                  qryContratos.Edit;
                  qryContratosagente.AsInteger := qryDadosFiscaisagente.AsInteger;
                  qryContratos.Post;
                end;

    //          GravarLinhas;


    {          PreencherChaveCalculosDadosFiscais;}
              PreencherChaveValumes;


              // NF ELETRÔNICA
              if CondicaoEmissorNFE then
                result := EmitirNFE(true);

              if result then
              begin
                GravarLancamentosContabeis;
                if qryDadosFiscaiscontrato.IsNull then
                begin

                  if Assigned(dtmLancamentoContabilidade) then

                    result := Perpetrar([qryDadosFiscais, qryVenctosDadosFiscais, qryNotas, qryEstoqueFilialTrans, qryMovimentos,
                               qryVolumesDadosFiscais, qrylacresVolumesDadosFiscais,
                               qryProdutos, qryServicosDadosFiscais, qryPedidosFiliais,{dtmGerarNotaFiscal.qryCalculosDadosFiscais,} qrySeriesFiliais,
                               qryapagarmovimentos, qryAtualizarMovimentos,
                               dtmLancamentoContabilidade.qryLancamentosNotasSaidas])
                  else
                    result := Perpetrar([qrySeriesFiliais, qryDadosFiscais, qryVenctosDadosFiscais, qryNotas, qryEstoqueFilialTrans, qryMovimentos,
                               qryProdutos, qryServicosDadosFiscais, qryVolumesDadosFiscais, qrylacresVolumesDadosFiscais, qryPedidosFiliais,
                               qryapagarmovimentos, qryAtualizarMovimentos]);



                  if result then
                  begin
                    case TipoNotaAvulsa of
                      tnaNOTAINCLUSAO:
                      begin
        //                MensagemAviso('Impressão da Nota Fiscal será iniciada.');

                        if not CondicaoEmissorNFE then
                        begin
                          if MensagemConfirmacao(ctIMPRIMIRNOTASAIDA) = smbOK then
                            dtmEmissaoNotaAvulsas.ImprimirNotaFiscal
                        end
                        else
                          result := EmitirNFE;
                      end;
                    end;
                  end;
                end
                else
                begin
                  if Assigned(dtmLancamentoContabilidade) then
                    result := Perpetrar([qryDadosFiscais, qryNotas, qryEstoqueFilialTrans, qryMovimentos,
                               qryVolumesDadosFiscais, qrylacresVolumesDadosFiscais,
                               qryProdutos, qryServicosDadosFiscais, qryVenctosDadosFiscais, qryContratos,
                               {dtmGerarNotaFiscal.qryCalculosDadosFiscais,} qrySeriesFiliais,
                               dtmLancamentoContabilidade.qryLancamentosNotasSaidas])
                  else
                    result := Perpetrar([qryDadosFiscais, qryNotas, qryEstoqueFilialTrans, qryMovimentos,
                               qryVolumesDadosFiscais, qrylacresVolumesDadosFiscais,
                               qryProdutos, qryServicosDadosFiscais, qryVenctosDadosFiscais, qryContratos,
                               {dtmGerarNotaFiscal.qryCalculosDadosFiscais,} qrySeriesFiliais]);

                  if result then
                  begin
                    RefazConsultaPorNome(qryProdutosPendentes,['contrato'],[qryDadosFiscaiscontrato.asstring]);
                    if qryProdutosPendentespendente.AsBoolean then
                    begin
                      qryContratos.Edit;
                      qryContratossituacao.AsString := 'P';
                      qrycontratos.Post;
                      result  := perpetrar([qrycontratos]);
                    end;
                  end;
                end;

               {comentario JR 15/09/2017 ERRO ACCESS VIOLATION
               }
                if result then
                  AtualizarRegistro_a2_MeiosPagto(qryDadosFiscaisdata.asDateTime);
                ReadOnly := True;
              end;
            end;
          end;
        end;
      end;
    end;
  finally
    qryMovimentos.Sql[31] := 'm.numero = 0';
  end;
end;

