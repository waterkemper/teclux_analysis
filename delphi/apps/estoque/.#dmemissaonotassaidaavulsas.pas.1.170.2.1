function TdtmEmissaoNotaAvulsas.ExisteProduto(NomeCampo: String; Value: Variant): Boolean;
const
  SQL = ' and (to_ascii(%s,''latin1'') ilike to_ascii(''%s%s'',''latin1'')) ';

  SQLChaves = ' Where (to_ascii(cast(p.codigo as varchar),''latin1'') ilike to_ascii(''%s%s'',''latin1'')) '+
              ' or (to_ascii(cast(p.codigovisual as varchar),''latin1'') ilike to_ascii(''%s%s'',''latin1'')) '+
              ' or p.codigo in (select pcb.produto from produtoscodigobarras pcb where (to_ascii(pcb.codigobarras,''latin1'') ilike to_ascii(''%s%s'',''latin1''))) ';

begin
  if (NomeCampo='descricao') or (NomeCampo='codigovisual') then
    NomeCampo := 'p.'+NomeCampo;

  if (NomeCampo='p.codigovisual') then
  begin
    qryConsultaProdutos.MacroByName('FiltrarProdutos').AsString :=
         Format(SQLChaves, [ANSIUpperCase(Value), '%', ANSIUpperCase(Value), '%', ANSIUpperCase(Value), '%']);
  end
  else
    qryConsultaProdutos.MacroByName('FiltrarProdutos').AsString :=
         Format(SQL, [NomeCampo, ANSIUpperCase(Value), '%']);

  qryConsultaProdutos.close;
  qryConsultaProdutos.Open;
  Result := (qryConsultaProdutos.RecordCount > 0);
end;

