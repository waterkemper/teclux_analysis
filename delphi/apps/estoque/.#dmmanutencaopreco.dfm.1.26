      ';'
      'select colunas.*'
      'from'
      '('
      'Select codigo,'
      '       descricao,'
      '      (codigo = :PNormal) as normal,'
      '      (codigo = :PPromocao) as promocao'
      'From   colunas'
      'Where True'
      '%SQL'
      ')  as colunas'
      
        'Order By normal desc, promocao desc, codigo  /*A COLUNA NORMAL V' +
        'EM EM PRIMEIRO e PROMO'#199#195'O EM SEGUNDO*/')
