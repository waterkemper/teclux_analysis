    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select comissao_manutencao_preco('
      ''
      '  :pPercComissao,'
      '  :pvalorBaseComissao,'
      '  :pNomeVendedor'
      ''
      ') as comissao')
    RequestLive = False
