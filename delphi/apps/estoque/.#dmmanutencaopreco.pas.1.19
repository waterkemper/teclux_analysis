procedure TdtmManutencaoPreco.AbreTabelaPesquisa(TipoPesquisa: TtecPesquisa);
begin
  case TipoPesquisa of
             pesCOLUNAS : Abre(ctConsultaColunas);
        pesFORNECEDORES : Abre(ctConsultaFornecedores);
     pesTIPOSMOVIMENTOS : qryConsultaTipoMovimentos.Open;
               pesNOTAS : qryConsultaNfEntrada.Open;
  pesSERIESFORNECEDORES : qryConsultaSerieNfEntrada.Open;
   pesFORNECEDORESNOTAS : qryConsultaFornecedorNFentrada.Open;
             pesFILIAIS : if not FFornecedores then Abre(ctConsultaFiliais)
                          else qryConsultaFiliaisMovimentos.Open;
  end;
end;

function TdtmManutencaoPreco.ArredondarPrecoProduto(Produto: LargeInt; Valor: Currency; Coluna: Integer): Variant;
Var
  Mult: Real;
begin
  Mult:= 0;
  ReFazConsulta(qryMultiplosProduto,[0],[Produto]);
  if not qryMultiplosProduto.IsEmpty then begin
    if qryMultiplosProdutomultiplo_produto.AsFloat > 0 then
      Mult:= Multiplo(Valor,qryMultiplosProdutomultiplo_produto.AsFloat)
    else if (qryMultiplosProdutomultiplo_grupo.AsFloat > 0) then
      Mult:= Multiplo(Valor,qryMultiplosProdutomultiplo_grupo.AsFloat)
    else if (qryMultiplosProdutomultiplo_classe.AsFloat > 0) then
      Mult:= Multiplo(Valor,qryMultiplosProdutomultiplo_classe.AsFloat)
  end;
  if (Mult = 0) and (ParSistema.MultiploPreco > 0) then
    Mult:= Multiplo(Valor,ParSistema.MultiploPreco);
  if Mult > 0 then
       Result:= Mult
  else Result:= Valor;
end;

procedure TdtmManutencaoPreco.AplicarPercentualEValidade(Origem: Integer; Percentual, Validade: String);
var
  Pos: TBookmark;
  Orig, OrigDataVal, I: Integer;
  Perc: Real;
begin
  if Percentual <> '' then
       Perc:= StrToFloat(Percentual)
  else Perc:= 0;
//  Orig:= (12 + ((Origem -1 )* 2));

  if Origem = 1 then
  begin
    Orig:= (vLimiteCampoAlteravel + (Origem*2) - 1);
    OrigDataVal := Orig+2;
  end
  else
  begin
    Orig:= (vLimiteCampoAlteravel + (Origem*2) - 1) + 1;
    OrigDataVal := Orig+1;
  end;

  qryManutencaoPreco.DisableControls;
  Pos:= qryManutencaoPreco.GetBookmark;
  try
    VarrendoManutencao := True;
    qryManutencaoPreco.First;
    for I:= 1 to qryManutencaoPreco.RecordCount do
    begin
      if qryManutencaoPreco.FieldByName('alterar').asboolean then
      begin
        qryManutencaoPreco.Edit;
        if Perc <> 0 then
             qryManutencaoPreco.Fields[Orig].AsVariant:= ArredondarPrecoProduto(qryManutencaoPreco.FieldbyName('produto').AsVariant,
                                                                                (qryManutencaoPreco.Fields[Orig].AsFloat +
                                                                                 RoundTo(qryManutencaoPreco.Fields[Orig].AsFloat * (Perc / 100),-2)),
                                                                                Orig)
        else qryManutencaoPreco.Fields[Orig].AsVariant:= qryManutencaoPreco.Fields[Orig].AsVariant;
        if Validade <> '' then
             qryManutencaoPreco.Fields[OrigDataVal].asVariant:= Validade
        else qryManutencaoPreco.Fields[OrigDataVal].AsVariant:= qryManutencaoPreco.Fields[OrigDataVal].AsVariant;
        qryManutencaoPreco.Post;
        dsrManutencaoPrecoDataChange(self,qryManutencaoPreco.Fields[Orig]);
      end;
      qryManutencaoPreco.Next;
    end;
  finally
    qryManutencaoPreco.GotoBookmark(Pos);
    qryManutencaoPreco.FreeBookmark(Pos);
    qryManutencaoPreco.EnableControls;
    VarrendoManutencao := False;
  end;
end;

procedure TdtmManutencaoPreco.CopiarColunaPreco(Origem, Destino: Integer; Validade, Percentual: String);
var
  Pos: TBookmark;
  Orig, OrigDataVal, Dest, DestDataVal, I: Integer;
  Perc: Real;
  Valor : Variant;
  NomeCampo : String;
begin
  if Percentual <> '' then
       Perc:= StrToFloat(Percentual)
  else Perc:= 0;

  ////ATENÇÃO AO ESRQUEMA ABAIXO QUDO ACRESCENTAR NOVOS CAMPOS A TABELA;

  if Origem = 1 then
  begin
    Orig:= (vLimiteCampoAlteravel + (Origem*2) - 1);
    OrigDataVal := Orig+2;
  end  
  else
  begin
    Orig:= (vLimiteCampoAlteravel + (Origem*2) - 1) + 1;
    OrigDataVal := Orig+1;
  end;

  if Destino = 1 then
  begin
    Dest:= (vLimiteCampoAlteravel + (Destino*2) -1);
    DestDataVal := Dest + 2;
  end  
  else
  begin
    Dest:= (vLimiteCampoAlteravel + (Destino*2) -1) + 1;
    DestDataVal := Dest + 1;
  end;



  qryManutencaoPreco.DisableControls;
  Pos:= qryManutencaoPreco.GetBookmark;
  try
    VarrendoManutencao := True;
    qryManutencaoPreco.First;
    for I:= 1 to qryManutencaoPreco.RecordCount do
    begin
      if qryManutencaoPreco.FieldByName('alterar').asboolean then
      begin
        Valor := qryManutencaoPreco.Fields[Orig].AsVariant;

        {somente para debug}
        NomeCampo := qryManutencaoPreco.Fields[Orig].fieldname;
        NomeCampo := qryManutencaoPreco.Fields[OrigDataVal].fieldname;

        NomeCampo := qryManutencaoPreco.Fields[Dest].fieldname;
        NomeCampo := qryManutencaoPreco.Fields[DestDataVal].fieldname;
        //****************/

        
        if Valor > 0 then
        begin
          qryManutencaoPreco.Edit;
          if Perc <> 0 then
               qryManutencaoPreco.Fields[Dest].AsVariant:= ArredondarPrecoProduto(qryManutencaoPreco.Fieldbyname('produto').AsVariant,
                                                                                  (qryManutencaoPreco.Fields[Orig].AsVariant +
                                                                                   RoundTo(qryManutencaoPreco.Fields[Orig].AsVariant * (Perc / 100),-2)),
                                                                                  Dest)
          else qryManutencaoPreco.Fields[Dest].AsVariant:= qryManutencaoPreco.Fields[Orig].AsVariant;
          if Validade <> '' then
               qryManutencaoPreco.Fields[DestDataVal].AsVariant:= Validade
          else qryManutencaoPreco.Fields[DestDataVal].AsVariant:= qryManutencaoPreco.Fields[OrigDataVal].AsVariant;
          qryManutencaoPreco.Post;
          dsrManutencaoPrecoDataChange(self,qryManutencaoPreco.Fields[Dest]);
        end;
      end;
      qryManutencaoPreco.Next;
    end;
  finally
    qryManutencaoPreco.GotoBookmark(Pos);
    qryManutencaoPreco.FreeBookmark(Pos);
    qryManutencaoPreco.EnableControls;
    VarrendoManutencao := False;
  end;
end;

procedure TdtmManutencaoPreco.PreencherComboBox(Lista: TComboBox; definirpromocao: boolean);
var
  I, J: Integer;
begin
  Lista.Items.Clear;
  Lista.Items.Add('Nenhuma');
    {
    if not qryProcuraColunascodigo.IsNull then
    begin
      if (qryProcuraColunascodigo.AsInteger <> StrToInt(PNormal)) then begin
        if qryColuna.Locate('codigo',StrToInt(PNormal),[]) then
             Lista.Items.Add(PrimeiraMaiuscula(LowerCase(qryColunadescricao.AsString)))
        else Lista.Items.Add('');
      end;
      Lista.Items.Add(PrimeiraMaiuscula(LowerCase(qryProcuraColunasdescricao.AsString)));
    end
    else
    begin
      qryColuna.First;
      for I:= 1 to qryColuna.RecordCount do begin
        Lista.Items.Add(PrimeiraMaiuscula(LowerCase(qryColunadescricao.AsString)));
        qryColuna.Next;
      end;
    end;
    }

    J := 0;
    qryColuna.First;
    for I:= 1 to qryColuna.RecordCount do
    begin
      Lista.Items.Add(PrimeiraMaiuscula(LowerCase(qryColunadescricao.AsString)));

      if definirpromocao then
        if qryColunapromocao.asboolean then
        begin
          J := I;
          fColunaPromocao := I;
        end;

      qryColuna.Next;
    end;

    Lista.ItemIndex := J;



end;

constructor TdtmManutencaoPreco.Create(AOwner: TComponent);
begin
  inherited;
//  qryColuna.Tag                  := ctTabelas;
  qryProcuraColunas.Tag          := ctTabelas;
  qryProcuraFornecedores.Tag     := ctTabelas;
  qryProcuraFiliais.Tag          := ctTabelas;

  qryConsultaColunas.Tag         := ctConsultaColunas;
  qryConsultaFornecedores.Tag    := ctConsultaFornecedores;
  qryConsultaFiliais.Tag         := ctConsultaFiliais;
  qryManutencaoPreco.Tag         := ctManutencaoPreco;

  PrecosCaracteristicasAlterados[caract_preco_col] := TStringList.Create;
  PrecosCaracteristicasAlterados[Caracteristica] := TStringList.Create;
  PrecosCaracteristicasAlterados[preco] := TStringList.Create;
  PrecosCaracteristicasAlterados[coluna] := TStringList.Create;

  PrecosCaracteristicasAlterados[valor] := TStringList.Create;

  PrecosCaracteristicasAlterados[validade] := TStringList.Create;

  CaracteristicasAlteradas[caracteristicam] := TStringList.Create;
  CaracteristicasAlteradas[markup] := TStringList.Create;
  fColunaPromocao := 0;

end;

procedure TdtmManutencaoPreco.ExcluirColunaPreco(Coluna: Integer);
var
  Pos: TBookmark;
  Col, ColDataVal, I: Integer;
begin

  Col:= (12 + (Coluna*2) - 1);

  if coluna = 1 then
  begin
    col := (vLimiteCampoAlteravel + (coluna*2) - 1);
    ColDataVal := col+2;
  end  
  else
  begin
    col:= (vLimiteCampoAlteravel + (coluna*2) - 1) + 1;
    colDataVal := col+1;
  end;


  qryManutencaoPreco.DisableControls;
  Pos:= qryManutencaoPreco.GetBookmark;
  try
    VarrendoManutencao := True;
    qryManutencaoPreco.First;
    for I:= 1 to qryManutencaoPreco.RecordCount do
    begin
      if qryManutencaoPreco.FieldByName('alterar').asboolean then
      begin
        qryManutencaoPreco.Edit;
        qryManutencaoPreco.Fields[Col].AsCurrency  := 0;
        qryManutencaoPreco.Fields[ColDataVal].Clear;
        qryManutencaoPreco.Post;
        dsrManutencaoPrecoDataChange(self,qryManutencaoPreco.Fields[Col]);
      end;
      qryManutencaoPreco.Next;

    end;
  finally
    qryManutencaoPreco.GotoBookmark(Pos);
    qryManutencaoPreco.FreeBookmark(Pos);
    qryManutencaoPreco.EnableControls;
    VarrendoManutencao := False;
  end;
end;



function TdtmManutencaoPreco.ExisteColunas(Campo, codigo: String): Boolean;
begin
  Result:= ExisteCodigo(qryConsultaColunas, campo, codigo);
end;


function TdtmManutencaoPreco.ExisteFornecedores(campo, codigo: String): Boolean;
begin
  Result := ExisteCodigo(qryConsultaFornecedores, campo, codigo);
end;

function TdtmManutencaoPreco.ExisteFiliais(campo, codigo: String): Boolean;
begin
  Result:= ExisteCodigo(qryConsultaFiliais, campo, codigo);
end;

procedure TdtmManutencaoPreco.FechaTabelaPesquisa(TipoPesquisa: TtecPesquisa);
begin
  case TipoPesquisa of
     pesCARACTERISTICAS : Fecha(ctPesquisaCaracteristica);
             pesCLASSES : Fecha(ctPesquisaClasse);
              pesGRUPOS : Fecha(ctPesquisaGrupo);
             pesCOLUNAS : Fecha(ctConsultaColunas);
              pesMARCAS : Fecha(ctConsultaMarcas);
        pesFORNECEDORES : Fecha(ctConsultaFornecedores);
     pesTIPOSMOVIMENTOS : qryConsultaTipoMovimentos.Close;
               pesNOTAS : qryConsultaNfEntrada.Close;
  pesSERIESFORNECEDORES : qryConsultaSerieNfEntrada.Close;
   pesFORNECEDORESNOTAS : qryConsultaFornecedorNFentrada.Close;
             pesFILIAIS : if not FFornecedores then Fecha(ctConsultaFiliais)
                          else qryConsultaFiliaisMovimentos.Close;
  end;
end;


