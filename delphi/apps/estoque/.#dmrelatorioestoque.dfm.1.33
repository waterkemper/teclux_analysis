  object qryEstoques_Anterior: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'estoque_condicao_grade'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'estoque'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'produtos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'GradecomElementos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroComposto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'movimento'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'quantidades'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ordenacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'select Estoques.*,'
      '         f.nome as nomefornecedor'
      'from'
      '('
      'SELECT ep.*,'
      '       m1.emestoque,'
      '       m1.reservado,'
      '       m1.transito,'
      '       m1.demonstracao,'
      '       m1.conserto,'
      '       m1.danificada,'
      '       m1.futuro,'
      '       m1.reservaprevia,'
      '       m1.estoquefisico,'
      
        '       pedidos_estoquepedido ( ep.codigoitem, ep.codigofilial ) ' +
        'AS pedido,estoques_preco(ep.codigoitem,ep.codigofilial) AS preco' +
        'devenda,'
      '       case when :somenteestoquefisico then'
      
        '         custoestoquefisico(ep.codigoitem,ep.codigofilial,:data)' +
        '*m1.estoquefisico'
      '       else'
      '         coalesce(m1.financeiro,0)'
      '       end AS Custo_Medio,'
      '       m1.acabados,'
      '       m1.semiacabados,'
      '       m1.financeiro'
      'FROM'
      '(('
      '   SELECT'
      '   e.filial AS codigofilial,'
      '   e.produto AS codigoitem,'
      '   p.codigovisual as codigoitemvisual,'
      '   e.localizacao,'
      '   e.ultimavendadias,'
      '   CASE WHEN coalesce(e.precocomicms,0)=0 THEN'
      '        (SELECT precocomicms'
      '        from estoques e1'
      '        where e.produto=e1.produto'
      '        and precocomicms>0'
      '        order by e1.ultimaentrada'
      '        desc limit 1)'
      '   else'
      '     e.precocomicms'
      '   END as precocomicms,'
      '   CASE WHEN coalesce(e.precosemicms,0)=0 THEN'
      '        (SELECT precosemicms'
      '        from estoques e1'
      '        where e.produto=e1.produto'
      '        and precosemicms>0'
      '        order by e1.ultimaentrada'
      '        desc limit 1)'
      '   ELSE'
      '        e.precosemicms'
      '   END as precosemicms,'
      '   gf.descricao AS nomegrupofilial,'
      '   gf.codigo AS codigogrupofilial,'
      '   f.nome AS nomefilial,'
      '   cl.descricao AS classeproduto,'
      '   cl.codigo AS codigoclasse,'
      '   g.descricao AS grupoproduto,'
      '   g.codigo AS codigogrupo,'
      '   c.descricao AS produto,'
      '   c.codigo AS codigoproduto,'
      '   c.codigovisual AS codigoprodutovisual,'
      
        'coalesce(p.valorgrade1,'#39'ND'#39') as valorgrade1, COALESCE(p.valorgra' +
        'de2,'#39'ND'#39') as valorgrade2,'
      
        '   (select fp.fornecedor from fornecedoresprodutos fp where fp.c' +
        'aracteristica=c.codigo limit 1) as fornecedor,'
      
        '   cast(p.descricao||'#39' '#39'||coalesce(p.valorgrade1,'#39#39')||'#39' '#39'||coale' +
        'sce(p.valorgrade2,'#39#39') as varchar) AS item,'
      '   p.referencia,'
      '   ma.descricao AS marca,'
      '   c.unidade'
      ''
      '   FROM'
      '   ((( SELECT e.filial,'
      '                e.produto,'
      '                e.localizacao,'
      '                e.precocomicms,'
      '                e.precosemicms,'
      
        '                CASE WHEN e.ultimavenda IS NULL THEN -1 ELSE abs' +
        '(e.ultimavenda - :data)  END as ultimavendadias'
      '         FROM estoques e'
      ''
      '         /*%estoque_condicao_grade*/'
      ''
      '         Where true'
      ''
      '        %estoque /* WHERE ESTOQUE  where e.produto =0*/'
      ''
      
        '   ) AS e JOIN (produtos p JOIN (((caracteristicas c JOIN grupos' +
        ' g ON c.grupo = g.codigo)'
      
        '                                                    JOIN classes' +
        ' cl ON c.classe=cl.codigo)'
      
        '                                                    LEFT JOIN ma' +
        'rcas ma ON c.marca=ma.codigo) ON p.caracteristica=c.codigo)'
      '                ON  e.produto = p.codigo )'
      
        '          JOIN (filiais f  LEFT JOIN (filiaisgruposfiliais fgf L' +
        'EFT JOIN gruposfiliais gf ON fgf.grupo=gf.codigo) ON f.codigo=fg' +
        'f.filial)'
      '                           ON  e.filial = f.codigo )'
      '  %produtos    /* WHERE PRODUTOS */'
      '  %GradecomElementos'
      '  %FiltroComposto'
      
        '  ) AS ep LEFT JOIN movimentos m1 ON m1.produto = ep.codigoitem ' +
        'AND'
      
        '                                     m1.filial = ep.codigofilial' +
        ' AND'
      
        '                                     m1.numero =  (select m4.num' +
        'ero'
      '                                                   from'
      '                                                   ('
      
        '                                                     select m2.d' +
        'ata,'
      
        '                                                            (sel' +
        'ect max(m3.lancto)'
      
        '                                                             fro' +
        'm movimentos m3'
      
        '                                                             whe' +
        're m3.produto = ep.codigoitem'
      
        '                                                               a' +
        'nd m3.filial = ep.codigofilial'
      
        '                                                               a' +
        'nd m3.data = m2.data) as lancto'
      '                                                     from'
      '                                                     ('
      
        '                                                      select max' +
        '(m2.data) as data'
      
        '                                                      from movim' +
        'entos m2'
      
        '                                                      where m2.p' +
        'roduto = ep.codigoitem'
      
        '                                                        and m2.f' +
        'ilial = ep.codigofilial'
      
        '                                                        and m2.d' +
        'ata < (cast(:Data as date)+1)'
      '                                                     ) as m2'
      
        '                                                   ) as m join m' +
        'ovimentos m4 on m4.data = m.data'
      
        '                                                                ' +
        '            and m4.lancto = m.lancto'
      
        '                                                                ' +
        '            and m4.produto = ep.codigoitem'
      
        '                                                                ' +
        '            and m4.filial = ep.codigofilial'
      
        '                                                   order by m4.l' +
        'ancto desc limit 1'
      '                                                  )'
      ')'
      '%movimento/* WHERE MOVIMENTO */'
      
        ') as Estoques left join fornecedores f on f.codigo = Estoques.fo' +
        'rnecedor'
      '%quantidades /* WHERE QUANTIDADES */'
      '%ordenacao')
    RequestLive = False
    Left = 221
    Top = 337
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'somenteestoquefisico'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'data'
        ParamType = ptUnknown
        Value = #39'14/12/2005'#39
      end>
  end
  object qryEstoques_Atual: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'estoque_condicao_grade'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'estoque'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'produtos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'GradecomElementos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroComposto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'quantidades'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ordenacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'select Estoques.*,'
      '         f.nome as nomefornecedor'
      'from'
      '('
      'SELECT ep.*,'
      
        '       pedidos_estoquepedido ( ep.codigoitem, ep.codigofilial ) ' +
        'AS pedido,estoques_preco(ep.codigoitem,ep.codigofilial) AS preco' +
        'devenda,'
      '       case when :somenteestoquefisico then'
      
        '         custoestoquefisico(ep.codigoitem,ep.codigofilial,:data)' +
        '*ep.estoquefisico'
      '       else'
      '         coalesce(ep.financeiro,0)'
      '       end AS Custo_Medio'
      'FROM'
      '('
      '   SELECT'
      '   e.filial AS codigofilial,'
      '   e.produto AS codigoitem,'
      '   p.codigovisual as codigoitemvisual,'
      '   e.emestoque,'
      '   e.reservado,'
      '   e.transito,'
      '   e.demonstracao,'
      '   e.conserto,'
      '   e.danificada,'
      '   e.futuro,'
      '   e.reservaprevia,'
      '   e.estoquefisico,'
      '   e.localizacao,'
      '   e.ultimavendadias,'
      '   CASE WHEN coalesce(e.precocomicms,0)=0 THEN'
      '        (SELECT e1.precocomicms'
      '        from estoques e1'
      '        where e.produto=e1.produto'
      '        and e1.precocomicms>0'
      '        order by e1.ultimaentrada'
      '        desc limit 1)'
      '   else'
      '     e.precocomicms'
      '   END as precocomicms,'
      '   CASE WHEN coalesce(e.precosemicms,0)=0 THEN'
      '        (SELECT e1.precosemicms'
      '        from estoques e1'
      '        where e.produto=e1.produto'
      '        and e1.precosemicms>0'
      '        order by e1.ultimaentrada'
      '        desc limit 1)'
      '   ELSE'
      '        e.precosemicms'
      '   END as precosemicms,'
      '   e.financeiro,'
      '   gf.descricao AS nomegrupofilial,'
      '   gf.codigo AS codigogrupofilial,'
      '   f.nome AS nomefilial,'
      '   cl.descricao AS classeproduto,'
      '   cl.codigo AS codigoclasse,'
      '   g.descricao AS grupoproduto,'
      '   g.codigo AS codigogrupo,'
      '   c.descricao AS produto,'
      '   c.codigo AS codigoproduto,'
      '   c.codigovisual AS codigoprodutovisual,'
      
        '   coalesce(p.valorgrade1,'#39'ND'#39') as valorgrade1, COALESCE(p.valor' +
        'grade2,'#39'ND'#39') as valorgrade2,'
      
        '   (select fp.fornecedor from fornecedoresprodutos fp where fp.c' +
        'aracteristica=c.codigo limit 1) as fornecedor,'
      
        '   cast(p.descricao||'#39' '#39'||coalesce(p.valorgrade1,'#39#39')||'#39' '#39'||coale' +
        'sce(p.valorgrade2,'#39#39') as varchar) AS item,'
      '   p.referencia,'
      '   ma.descricao AS marca,'
      '   c.unidade,'
      '   e.acabados,'
      '   e.semiacabados'
      ''
      '   FROM'
      '   ((( SELECT e.filial,'
      '                e.produto,'
      '                e.emestoque,'
      '                e.reservado,'
      '                e.transito,'
      '                e.demonstracao,'
      '                e.conserto,'
      '                e.danificada,'
      '                e.futuro,'
      '                e.reservaprevia,'
      '                e.estoquefisico,'
      '                e.localizacao,'
      '                e.precocomicms,'
      '                e.precosemicms,'
      '                e.financeiro,'
      '                e.acabados,'
      '                e.semiacabados,'
      
        '                CASE WHEN e.ultimavenda IS NULL THEN -1 ELSE abs' +
        '(e.ultimavenda - :data)  END as ultimavendadias'
      '         FROM estoques e'
      '         /*%estoque_condicao_grade*/'
      ''
      '         where true'
      ''
      ''
      '        %estoque /* WHERE ESTOQUE where e.produto =0*/'
      ''
      
        '   ) AS e JOIN (produtos p JOIN (((caracteristicas c JOIN grupos' +
        ' g ON c.grupo = g.codigo)'
      
        '                                                    JOIN classes' +
        ' cl ON c.classe=cl.codigo)'
      
        '                                                    LEFT JOIN ma' +
        'rcas ma ON c.marca=ma.codigo) ON p.caracteristica=c.codigo)'
      '                ON  e.produto = p.codigo )'
      
        '          JOIN (filiais f  LEFT JOIN (filiaisgruposfiliais fgf L' +
        'EFT JOIN gruposfiliais gf ON fgf.grupo=gf.codigo) ON f.codigo=fg' +
        'f.filial)'
      '                           ON  e.filial = f.codigo )'
      '  %produtos    /* WHERE PRODUTOS */'
      '  %GradecomElementos'
      '  %FiltroComposto'
      '  '
      '  ) AS ep'
      
        ') as Estoques left join fornecedores f on f.codigo = Estoques.fo' +
        'rnecedor'
      '%quantidades /* WHERE QUANTIDADES */'
      '%ordenacao')
    RequestLive = False
