    Sql.Strings = (
      ';                                                   ;'
      'select g1.*,'
      ''
      '       cast((select count(*)'
      #9'    from'
      #9#9'('
      
        #9'    select codigoproduto, produto, COALESCE(valorgrade2,'#39'ND'#39') a' +
        's valorgrade2'
      '        from'
      '        ('
      ''
      ''
      '         %SQLEstoques_1'
      #9#9
      '        ) as temp'
      '        group by codigoproduto, produto, valorgrade2'
      #9#9') as temp'
      ''
      '        ) as integer)  as NElementosValorGrade2'
      ''
      'from'
      '('
      ''
      
        'select codigofilial, codigoproduto, produto, COALESCE(valorgrade' +
        '1,'#39'ND'#39') as valorgrade1'
      'from'
      '('
      ''
      '  %SQLEstoques_2'
      ''
      ') as temp'
      'group by codigofilial, codigoproduto, produto, valorgrade1'
      'order by codigofilial, codigoproduto, produto, valorgrade1'
      ') as g1')
