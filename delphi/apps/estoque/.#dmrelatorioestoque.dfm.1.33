      'var'
      ' LINHA: INTEGER;'
      ' vTGPrecoaPrazo, vTGPrecoCusto, vTGMarkup : Currency;'
      ''
      'procedure VendasOnBeforePrint(Sender: TfrxComponent);'
      'begin'
      '  LINHA := LINHA+1;'
      'end;'
      ''
      'procedure Page1OnBeforePrint(Sender: TfrxComponent);'
      'begin'
      '  vTGPrecoaPrazo := 0;'
      '  vTGPrecocUSTO := 0;'
      '  vTGMarkup := 0;'
      '  if (<Totalizacao>=0) or (<Totalizacao>=null) then'
      '   vendas.visible:=true'
      '  else'
      '   vendas.visible:=false;'
      ''
      
        '  if (VarToStr(<AgruparGrupoFilial>)='#39'True'#39') or <AgruparGrupoFil' +
        'ial>=null then'
      '  begin'
      '     CabecalhoGrupoFilial.visible:=true;'
      '     RodapeGrupoFilial.visible:=true;'
      '  end'
      '  else'
      '  begin'
      '    CabecalhoGrupoFilial.visible:=false;'
      '    RodapeGrupoFilial.visible:=false;'
      '  end;'
      ''
      '      {'
      '  if [AgruparFilial] then'
      '  begin'
      '   CabecalhoFilial.visible:=true;'
      '   RodapeFilial.visible:=true;'
      '  end'
      '  else'
      '  begin'
      '    CabecalhoFilial.visible:=false;'
      '    RodapeFilial.visible:=false;'
      '  end;'
      ''
      '{'
      '  if [AgruparConceito] then'
      '  begin'
      '   CabecalhoConceito.visible:=true;'
      '   RodapeConceito.visible:=true;'
      '  end'
      '  else'
      '  begin'
      '   CabecalhoConceito.visible:=false;'
      '   RodapeConceito.visible:=false;'
      '  end;'
      ''
      '  if [AgruparCliente] then'
      '  begin'
      '   CabecalhoCliente.visible:=true;'
      '   RodapeCliente.visible:=true;'
      '  end'
      '  else'
      '  begin'
      '   CabecalhoCliente.visible:=false;'
      '   RodapeCliente.visible:=false;'
      '  end;'
      ''
      
        '  if [AgruparFilial] and ([Ordenacao] = 0) and ([Totalizacao] = ' +
        '3) then'
      '  begin'
      '   CabecalhoFilialEmissao.visible := true;'
      '   RodapeFilialEmissao.visible := true;'
      '  end'
      '  else'
      '  begin'
      '   CabecalhoFilialEmissao.visible := false;'
      '   RodapeFilialEmissao.visible := false;'
      '  end;'
      '     }'
      'end;'
      ''
      'procedure mmoTGPrecoaPrazoOnAfterPrint(Sender: TfrxComponent);'
      'begin'
      
        '  vTGPrecoaPrazo := SUM(IIF(<frxDBcustomercvendidas_."tipo">='#39'D'#39 +
        ',<frxDBcustomercvendidas_."quantidade">*<frxDBcustomercvendidas_' +
        '."preco_prazo">,0),Vendas,1)+ 10;'
      '  if (vTGPrecoaPrazo<>0) and (vTGPrecoCusto<>0) then'
      
        '    vTGMarkup := (vTGPrecoaPrazo-vTGPrecoCusto)/vTGPrecoaPrazo*1' +
        '00'
      '  else'
      '    vTGMarkup := 0;'
      'end;'
      ''
      'procedure mmoTGPrecoCustoOnAfterPrint(Sender: TfrxComponent);'
      'begin'
      
        '  vTGPrecoCusto := SUM(IIF(<frxDBcustomercvendidas_."tipo">='#39'D'#39',' +
        '<frxDBcustomercvendidas_."quantidade">*<frxDBcustomercvendidas_.' +
        '"preco_custoo">,0),Vendas,1) + 1;'
      'end;'
      ''
      'procedure mmoTGMarkupOnBeforePrint(Sender: TfrxComponent);'
      'begin'
      'end;'
      ''
      'begin'
      'end.')
