procedure TdtmRelatorioEstoque.qryEstoquesAfterScroll(DataSet: TDataSet);
var
 i,nreg, vnElementosValorGrade2: integer;
begin
  inherited;
  if ComCodigodeBarras then
    if qryEstoquescodigoitem.AsString<>'' then
      RefazConsultaPorNome(qryCodigoBarras,['produto'],[qryEstoquescodigoitem.AsString])
    else
      RefazConsultaPorNome(qryCodigoBarras,['produto'],['0']);

  if ImpressaoemGrade and qryEstoquesGrade.active then
  begin
    nreg := qryEstoquesGrade.RecordCount;
    if qryEstoquesGradenElementosValorGrade2.AsInteger > 0 then
      vnElementosValorGrade2 := qryEstoquesGradenElementosValorGrade2.AsInteger
    else
      vnElementosValorGrade2 := 1;

    if nreg < 15 then
    begin
      for i:= nreg to 15 do
      begin
        qryEstoquesGrade.append;
        qryEstoquesGradecodigofilial.asinteger := qryEstoquescodigofilial.AsInteger;
        qryEstoquesGradecodigoproduto.asString := qryEstoquescodigoproduto.AsString;
        qryEstoquesGradeproduto.asString := qryEstoquesproduto.AsString;
        qryEstoquesGradevalorgrade1.clear;
        qryEstoquesGradenElementosValorGrade2.AsInteger := vnElementosValorGrade2;
        qryEstoquesGrade.post;
      end;
    end;
  end;
end;

