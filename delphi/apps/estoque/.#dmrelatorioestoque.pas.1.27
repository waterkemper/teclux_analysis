    property SomenteEstoqueFisico: Boolean read FSomenteEstoqueFisico write SetSomenteEstoqueFisico;
    property AcabadosSemiAcabados: Boolean read FAcabadosSemiAcabados write FAcabadosSemiAcabados;
    property DisponivelnoSite: Boolean read fDisponivelnoSite write fDisponivelnoSite;
    property NaoDisponivelnoSite: Boolean read fNaoDisponivelnoSite write fNaoDisponivelnoSite;
    property ImpressaoemGrade: boolean read fImpressaoemGrade write fImpressaoemGrade;
    property GradecomElementos: boolean read fGradecomElementos write fGradecomElementos;
    property Compostos : byte read fCompostos write fCompostos;

  end;

var
  dtmRelatorioEstoque: TdtmRelatorioEstoque;

implementation

{$R *.dfm}

{ TdtmRelatorioEstoque }

constructor TdtmRelatorioEstoque.Create(AOwner: TComponent);
begin
  inherited;
  qryItemProdutosInicial.Tag    := ctTabelas;
  qryItemProdutosFinal.Tag      := ctTabelas;
  qryprodutosInicial.Tag        := ctTabelas;
  qryprodutosFinal.Tag          := ctTabelas;
  qryGrupoProdutosInicial.Tag   := ctTabelas;
  qryGrupoProdutosFinal.Tag     := ctTabelas;
  qryClassesInicial.Tag         := ctTabelas;
  qryClassesFinal.Tag           := ctTabelas;
  qryMarcaInicial.tag           := ctTabelas;
  qryMarcaFinal.Tag             := ctTabelas;

  qryConsultaItemProdutos.Tag   := ctPesquisaItemProdutos;
  qryConsultaProdutos.Tag       := ctPesquisaProdutos;
  qryconsultaGrupoProdutos.Tag  := ctPesquisaGrupo;
  qryConsultaClasses.Tag        := ctPesquisaClasse;
  qryConsultaMarcas.Tag         := ctPesquisaMarca;
  frxRelatorioEstoqueGrade.AddFunction('CordoZebrado: Tcolor', 'TecSoft', 'CordoZebrado');


end;

function TdtmRelatorioEstoque.GetListaFiliais: TStrings;
begin
  FListaFiliais:= TStringList.Create;
  qryFiliais.Open;
  while not qryFiliais.Eof do
  begin
    FListaFiliais.AddObject(format('%3s',[qryFiliaiscodigo.AsString])+'.'+qryFiliaisnome.AsString, Pointer(qryFiliaiscodigo.AsInteger));
    qryFiliais.Next;
  end;
  qryFiliais.Close;
  Result := FListaFiliais;
end;

function TdtmRelatorioEstoque.GetListaGruposFiliais: TStrings;
begin
  FListaGruposFiliais:= TStringList.Create;
  qryGrupoFiliais.Open;
  while not qryGrupoFiliais.Eof do
  begin
    FListaGruposFiliais.AddObject(format('%2s',[qryGrupoFiliaiscodigo.asstring])+'.'+qryGrupoFiliaisdescricao.AsString, Pointer(qryGrupoFiliaiscodigo.AsInteger));
    qryGrupoFiliais.Next;
  end;
  qryGrupoFiliais.Close;
  Result := FListaGruposFiliais;
end;

function TdtmRelatorioEstoque.ExisteClasse(Campo, Codigo: string): Boolean;
begin
  Result := ExisteCodigo(qryConsultaClasses, campo, codigo);
end;

function TdtmRelatorioEstoque.ExisteGrupo(Campo, Codigo: string): Boolean;
begin
  Result := ExisteCodigo(qryConsultaGrupoProdutos, campo, codigo);
end;

function TdtmRelatorioEstoque.ExisteItemProduto(Campo,
  Codigo: string): Boolean;
const
  SQL = 'Where (to_ascii(p.%s,''latin1'') ilike to_ascii(''%s%s'',''latin1''))';
begin
  qryConsultaItemProdutos.Sql[03]:= Format(SQL, [Campo, Codigo, '%']);
  qryConsultaItemProdutos.Open;
  Result := (qryConsultaItemProdutos.RecordCount > 0);
end;

function TdtmRelatorioEstoque.ExisteProduto(Campo, Codigo: string): Boolean;
const
  SQL = 'Where (to_ascii(c.%s,''latin1'') ilike to_ascii(''%s%s'',''latin1''))';
begin
  qryConsultaProdutos.Sql[03]:= Format(SQL, [Campo, Codigo, '%']);
  qryConsultaProdutos.Open;
  Result := (qryConsultaProdutos.RecordCount > 0);
end;

function TdtmRelatorioEstoque.ExisteMarca(campo, codigo: String): boolean;
begin
  Result := ExisteCodigo(qryConsultaMarcas, campo, codigo);
end;



procedure TdtmRelatorioEstoque.AbreTabelaPesquisa(
  TipoPesquisa: TtecPesquisa);
begin
  case TipoPesquisa of
     pesITEMPRODUTOSINICIAL,
     pesITEMPRODUTOSFINAL : begin
                             qryConsultaItemProdutos.Sql[03]:= 'Where (p.codigo = 0)';
                             Abre(ctPesquisaItemProdutos);
                            end;
     pesPRODUTOSINICIAL,
     pesPRODUTOSFINAL     : begin
                             qryConsultaProdutos.Sql[03]:= 'Where (c.codigo = 0)';
                             Abre(ctPesquisaProdutos);
                           end;
     pesGRUPOSINICIAL,
     pesGRUPOSFINAL       : Abre(ctPesquisaGrupo);
     pesCLASSESINICIAL,
     pesCLASSESFINAL      : Abre(ctPesquisaClasse);
     pesMARCASINICIAL,
     pesMARCASFINAL       : Abre(ctPesquisaMarca);
  end;
end;

procedure TdtmRelatorioEstoque.FechaTabelaPesquisa(
  TipoPesquisa: TtecPesquisa);
begin
  case TipoPesquisa of
     pesITEMPRODUTOSINICIAL,
     pesITEMPRODUTOSFINAL : fecha(ctPesquisaItemProdutos);
     pesPRODUTOSINICIAL,
     pesPRODUTOSFINAL     : fecha(ctPesquisaProdutos);
     pesGRUPOSINICIAL,
     pesGRUPOSFINAL       : fecha(ctPesquisaGrupo);
     pesCLASSESINICIAL,
     pesCLASSESFINAL      : fecha(ctPesquisaClasse);
     pesMARCASINICIAL,
     pesMARCASFINAL       : fecha(ctPesquisaMarca);
  end;
end;

procedure TdtmRelatorioEstoque.Selecionar(TipoPesquisa: TTecPesquisa);
begin
  case TipoPesquisa of
    pesITEMPRODUTOSINICIAL : RefazConsulta(qryitemProdutosInicial,[0],[CodigoItemProduto]);
    pesITEMPRODUTOSFINAL   : RefazConsulta(qryitemProdutosFinal,[0],[CodigoItemProduto]);
    pesPRODUTOSINICIAL     : RefazConsulta(qryProdutosInicial,[0],[CodigoProduto]);
    pesPRODUTOSFINAL       : RefazConsulta(qryProdutosFinal,[0],[CodigoProduto]);
    pesGRUPOSINICIAL       : RefazConsulta(qryGrupoProdutosInicial,[0],[CodigoGrupo]);
    pesGRUPOSFINAL         : RefazConsulta(qryGrupoProdutosFinal,[0],[CodigoGrupo]);
    pesCLASSESINICIAL      : RefazConsulta(qryClassesInicial,[0],[CodigoClasse]);
    pesCLASSESFINAL        : RefazConsulta(qryClassesFinal,[0],[CodigoClasse]);
    pesMARCASINICIAL       : RefazConsulta(qryMarcaInicial, [0], [CodigoMarca]);
    pesMARCASFINAL         : RefazConsulta(qryMarcaFinal, [0], [CodigoMarca]);
  end;
end;

