function TdtmRelatorioEstoque.MontarParametroLocalizacao: String;
const
 SQLLocalizacao =  ' e.localizacao %s';
var
 SQL : String;
begin
 SQL := '';
 case FParametroSelecaoProdutos of
  0,1: begin
        if (FParametroLocalizacao <>'') then
        begin
          SQL := format(SQLLocalizacao,['ilike '+quotedstr(FParametroLocalizacao+'%')]);
          FParametroCabecalho:= FParametroCabecalho+' Localização: '+FParametroTituloLocalizacao;
        end;
      end;
 end;
 result := SQL;
end;
