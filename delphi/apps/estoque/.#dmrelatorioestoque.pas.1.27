procedure TdtmRelatorioEstoque.DefineOrdenacao;
var
 Ordenacao : String;
begin
  ordenacao:='';
  if AgruparGrupoFilial then
    Ordenacao:=Ordenacao+', nomegrupofilial, codigogrupofilial ';
  if AgruparFilial then
    Ordenacao:=Ordenacao+', nomefilial, codigofilial ';
  if AgruparFornecedor then
    Ordenacao:=Ordenacao+', nomefornecedor, fornecedor ';
  if AgruparLocalizacao then
    Ordenacao:= Ordenacao+', localizacao';
  if AgruparClasseProduto then
    Ordenacao:=Ordenacao+', classeProduto, codigoclasse';
  if AgruparGrupoProduto then
    Ordenacao:=Ordenacao+', GrupoProduto, CodigoGrupo';

  if AgruparProduto then
    Ordenacao:=Ordenacao+', Produto, CodigoProduto';

  if ImpressaoemGrade then
  begin
    if not AgruparProduto then
    begin
      if (ParametroOrdenacao = 0) then
        Ordenacao:=Ordenacao+', CodigoProduto, Produto'
      else
        Ordenacao:=Ordenacao+', Produto, CodigoProduto';
    end;

    Ordenacao:= Ordenacao+ ', valorgrade2, valorgrade1';
  end;

  case ParametroOrdenacao of
  0: Ordenacao:=Ordenacao+', codigoitem, item';
  1: Ordenacao:=Ordenacao+', item, codigoitem';
  2: Ordenacao:=Ordenacao+', codigofilial, item, codigoitem';
  3: Ordenacao:=Ordenacao+', localizacao, item, codigoitem';
  4: Ordenacao:=Ordenacao+', ultimavendadias, item, codigoitem';
  end;
  qryEstoques.MacroByName('ordenacao').AsString:='Order by '+copy(Ordenacao,2,length(Ordenacao)-1);
end;

procedure TdtmRelatorioEstoque.qryEstoquesCalcFields(DataSet: TDataSet);
begin
  inherited;
   qryEstoquesoutros.AsCurrency :=
   qryEstoquesreservado.AsCurrency +
   qryEstoquestransito.AsCurrency +
   qryEstoquesdemonstracao.AsCurrency +
   qryEstoquesdanificada.AsCurrency +
   qryEstoquesreservaprevia.AsCurrency+
   qryEstoquesfuturo.AsCurrency;

   if AcabadosSemiAcabados then
   begin
     qryEstoquesQtdeEstoque.asCurrency :=
     qryEstoquesemestoque.asCurrency { +
     qryEstoquesacabados.asCurrency +
     qryEstoquessemiacabados.asCurrency};
   end
   else
   begin
     if FSomenteEstoqueFisico then
       qryEstoquesQtdeEstoque.AsCurrency:=qryEstoquesestoquefisico.AsCurrency
     else
       qryEstoquesQtdeEstoque.asCurrency :=
       qryEstoquesemestoque.asCurrency +
       qryEstoquesreservado.asCurrency +
       qryEstoquestransito.asCurrency +
       qryEstoquesdemonstracao.asCurrency +
       qryEstoquesconserto.asCurrency +
       qryEstoquesdanificada.asCurrency +
       qryEstoquesreservaprevia.asCurrency;
   end;

end;

procedure TdtmRelatorioEstoque.frpRelatorioEstoqueBeforePrint(
  Memo: TStringList; View: TfrView);
begin
  inherited;
  if (View.Name = 'fpvLogo') or
     (View.Name = 'fpvLogo2')then
  begin
   if FileExists(LogotipoFilialBase) then
    try TfrPictureView(View).Picture.LoadFromFile(LogotipoFilialBase) except end;
  end
  else
  if TColor(strtoint(parsistema.CorZebradoRelatorio))<>TColor(clnone) then
   if (View.Name = 'mmoZebrado') then
    if (frpRelatorioEstoque.Dictionary.Variables.Variable['LINHA'] MOD 2)=0 then
      frpRelatorioEstoque.FindObject('mmoZebrado').FillColor := TColor(strtoint(parsistema.CorZebradoRelatorio))
    else
      frpRelatorioEstoque.FindObject('mmoZebrado').FillColor := clnone;
end;

