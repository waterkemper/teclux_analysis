    property emDemonstracao_Inicial: String read FemDemonstracao_Inicial write SetemDemonstracao_Inicial;
    property emDemonstracao_Final: String read FemDemonstracao_Final write SetemDemonstracao_Final;
    property emConserto_Inicial: String read FemConserto_Inicial write SetemConserto_Inicial;
    property emConserto_Final: String read FemConserto_Final write SetemConserto_Final;
    property Futuro_Inicial: String read FFuturo_Inicial write SetFuturo_Inicial;
    property Futuro_Final: String read FFuturo_Final write SetFuturo_Final;
    property Avariado_Inicial: String read FAvariado_Inicial write SetAvariado_Inicial;
    property Avariado_Final: String read FAvariado_Final write SetAvariado_Final;
    property Pedido_Inicial: String read FPedido_Inicial write SetPedido_Inicial;
    property Pedido_Final: String read FPedido_Final write SetPedido_Final;
    property Resumo: Integer read FResumo write FResumo;
    property ComValorFinanceiro: Boolean read FComValorFinanceiro write FComValorFinanceiro;
    property ComCodigodeBarras: Boolean read FComCodigodeBarras write FComCodigodeBarras;
    property ComPrecodeVenda: Boolean read FComPrecodeVenda write FComPrecodeVenda;
    property ComQuantidades: Boolean read FComQuantidades write FComQuantidades;
    property SemEstoqueZero: Boolean read FSemEstoqueZero write FSemEstoqueZero;
    property PrecoComICMS: Boolean read FPrecoComICMS write FPrecoComICMS;
    property PrecoSemICMS: Boolean read FPrecoSemICMS write FPrecoSemICMS;
    property NaoVendidosHaNDias: String read FNaoVendidosHaNDias write FNaoVendidosHaNDias;
    property AgruparProduto: Boolean read FAgruparProduto write FAgruparProduto;
    property AgruparGrupoProduto: Boolean read FAgruparGrupoProduto write FAgruparGrupoProduto;
    property AgruparClasseProduto: Boolean read FAgruparClasseProduto write FAgruparClasseProduto;
    property AgruparGrupoFilial: Boolean read FAgruparGrupoFilial write FAgruparGrupoFilial;
    property AgruparFilial: Boolean read FAgruparFilial write FAgruparFilial;
    property AgruparFornecedor: Boolean read FAgruparFornecedor write FAgruparFornecedor;
    property AgruparLocalizacao: Boolean read FAgruparLocalizacao write FAgruparLocalizacao;
    procedure DefineOrdenacao;
    property ParametroOrdenacao: Integer read FParametroOrdenacao write FParametroOrdenacao;
    procedure ImprimirRelatorio;
    procedure CancelarRelatorio;
    property SomenteEstoqueFisico: Boolean read FSomenteEstoqueFisico write SetSomenteEstoqueFisico;
    property AcabadosSemiAcabados: Boolean read FAcabadosSemiAcabados write FAcabadosSemiAcabados;


    property NaoDisponivelnoSite: Boolean read fNaoDisponivelnoSite write fNaoDisponivelnoSite;
    property ImpressaoemGrade: boolean read fImpressaoemGrade write fImpressaoemGrade;
    property InverterLinhaColuna: Boolean read fInverterLinhaColuna write fInverterLinhaColuna;
    property GradecomElementos: boolean read fGradecomElementos write fGradecomElementos;
    property Compostos : byte read fCompostos write fCompostos;

    property SomenteResumoporColuna: Boolean read fSomenteResumoporColuna write fSomenteResumoporColuna;

  end;

var
  dtmRelatorioEstoque: TdtmRelatorioEstoque;

implementation

{$R *.dfm}

{ TdtmRelatorioEstoque }

constructor TdtmRelatorioEstoque.Create(AOwner: TComponent);
begin
  inherited;
  qryItemProdutosInicial.Tag    := ctTabelas;
  qryItemProdutosFinal.Tag      := ctTabelas;
  qryprodutosInicial.Tag        := ctTabelas;
  qryprodutosFinal.Tag          := ctTabelas;
  qryGrupoProdutosInicial.Tag   := ctTabelas;
  qryGrupoProdutosFinal.Tag     := ctTabelas;
  qryClassesInicial.Tag         := ctTabelas;
  qryClassesFinal.Tag           := ctTabelas;
  qryMarcaInicial.tag           := ctTabelas;
  qryMarcaFinal.Tag             := ctTabelas;

  qryConsultaItemProdutos.Tag   := ctPesquisaItemProdutos;
  qryConsultaProdutos.Tag       := ctPesquisaProdutos;
  qryconsultaGrupoProdutos.Tag  := ctPesquisaGrupo;
  qryConsultaClasses.Tag        := ctPesquisaClasse;
  qryConsultaMarcas.Tag         := ctPesquisaMarca;
  frxRelatorioEstoqueGrade.AddFunction('CordoZebrado: Tcolor', 'TecSoft', 'CordoZebrado');
  frxRelatorioEstoqueGradeGrupo.AddFunction('CordoZebrado: Tcolor', 'TecSoft', 'CordoZebrado');


end;

function TdtmRelatorioEstoque.GetListaFiliais: TStrings;
begin
  FListaFiliais:= TStringList.Create;
  qryFiliais.Open;
  while not qryFiliais.Eof do
  begin
    FListaFiliais.AddObject(format('%3s',[qryFiliaiscodigo.AsString])+'.'+qryFiliaisnome.AsString, Pointer(qryFiliaiscodigo.AsInteger));
    qryFiliais.Next;
  end;
  qryFiliais.Close;
  Result := FListaFiliais;
end;

function TdtmRelatorioEstoque.GetListaGruposFiliais: TStrings;
begin
  FListaGruposFiliais:= TStringList.Create;
  qryGrupoFiliais.Open;
  while not qryGrupoFiliais.Eof do
  begin
    FListaGruposFiliais.AddObject(format('%2s',[qryGrupoFiliaiscodigo.asstring])+'.'+qryGrupoFiliaisdescricao.AsString, Pointer(qryGrupoFiliaiscodigo.AsInteger));
    qryGrupoFiliais.Next;
  end;
  qryGrupoFiliais.Close;
  Result := FListaGruposFiliais;
end;

function TdtmRelatorioEstoque.ExisteClasse(Campo, Codigo: string): Boolean;
begin
  Result := ExisteCodigo(qryConsultaClasses, campo, codigo);
end;

function TdtmRelatorioEstoque.ExisteGrupo(Campo, Codigo: string): Boolean;
begin
  Result := ExisteCodigo(qryConsultaGrupoProdutos, campo, codigo);
end;

function TdtmRelatorioEstoque.ExisteItemProduto(Campo,
  Codigo: string): Boolean;
const
  SQL = 'Where (to_ascii(p.%s,''latin1'') ilike to_ascii(''%s%s'',''latin1''))';
begin
  qryConsultaItemProdutos.Sql[03]:= Format(SQL, [Campo, Codigo, '%']);
  qryConsultaItemProdutos.Open;
  Result := (qryConsultaItemProdutos.RecordCount > 0);
end;

function TdtmRelatorioEstoque.ExisteProduto(Campo, Codigo: string): Boolean;
const
  SQL = 'Where (to_ascii(c.%s,''latin1'') ilike to_ascii(''%s%s'',''latin1''))';
begin
  qryConsultaProdutos.Sql[03]:= Format(SQL, [Campo, Codigo, '%']);
  qryConsultaProdutos.Open;
  Result := (qryConsultaProdutos.RecordCount > 0);
end;

function TdtmRelatorioEstoque.ExisteMarca(campo, codigo: String): boolean;
begin
  Result := ExisteCodigo(qryConsultaMarcas, campo, codigo);
end;



procedure TdtmRelatorioEstoque.AbreTabelaPesquisa(
  TipoPesquisa: TtecPesquisa);
begin
  case TipoPesquisa of
     pesITEMPRODUTOSINICIAL,
     pesITEMPRODUTOSFINAL : begin
                             qryConsultaItemProdutos.Sql[03]:= 'Where (p.codigo = 0)';
                             Abre(ctPesquisaItemProdutos);
                            end;
     pesPRODUTOSINICIAL,
     pesPRODUTOSFINAL     : begin
                             qryConsultaProdutos.Sql[03]:= 'Where (c.codigo = 0)';
                             Abre(ctPesquisaProdutos);
                           end;
     pesGRUPOSINICIAL,
     pesGRUPOSFINAL       : Abre(ctPesquisaGrupo);
     pesCLASSESINICIAL,
     pesCLASSESFINAL      : Abre(ctPesquisaClasse);
     pesMARCASINICIAL,
     pesMARCASFINAL       : Abre(ctPesquisaMarca);
  end;
end;

procedure TdtmRelatorioEstoque.FechaTabelaPesquisa(
  TipoPesquisa: TtecPesquisa);
begin
  case TipoPesquisa of
     pesITEMPRODUTOSINICIAL,
     pesITEMPRODUTOSFINAL : fecha(ctPesquisaItemProdutos);
     pesPRODUTOSINICIAL,
     pesPRODUTOSFINAL     : fecha(ctPesquisaProdutos);
     pesGRUPOSINICIAL,
     pesGRUPOSFINAL       : fecha(ctPesquisaGrupo);
     pesCLASSESINICIAL,
     pesCLASSESFINAL      : fecha(ctPesquisaClasse);
     pesMARCASINICIAL,
     pesMARCASFINAL       : fecha(ctPesquisaMarca);
  end;
end;

procedure TdtmRelatorioEstoque.Selecionar(TipoPesquisa: TTecPesquisa);
begin
  case TipoPesquisa of
    pesITEMPRODUTOSINICIAL : RefazConsulta(qryitemProdutosInicial,[0],[CodigoItemProduto]);
    pesITEMPRODUTOSFINAL   : RefazConsulta(qryitemProdutosFinal,[0],[CodigoItemProduto]);
    pesPRODUTOSINICIAL     : RefazConsulta(qryProdutosInicial,[0],[CodigoProduto]);
    pesPRODUTOSFINAL       : RefazConsulta(qryProdutosFinal,[0],[CodigoProduto]);
    pesGRUPOSINICIAL       : RefazConsulta(qryGrupoProdutosInicial,[0],[CodigoGrupo]);
    pesGRUPOSFINAL         : RefazConsulta(qryGrupoProdutosFinal,[0],[CodigoGrupo]);
    pesCLASSESINICIAL      : RefazConsulta(qryClassesInicial,[0],[CodigoClasse]);
    pesCLASSESFINAL        : RefazConsulta(qryClassesFinal,[0],[CodigoClasse]);
    pesMARCASINICIAL       : RefazConsulta(qryMarcaInicial, [0], [CodigoMarca]);
    pesMARCASFINAL         : RefazConsulta(qryMarcaFinal, [0], [CodigoMarca]);
  end;
end;

function TdtmRelatorioEstoque.GetCodigoProduto: String;
begin
 result := qryConsultaProdutoscodigovisual.AsString;
end;

function TdtmRelatorioEstoque.GetCodigoGrupo: String;
begin
 result := qryConsultaGrupoProdutoscodigo.Asstring;
end;

function TdtmRelatorioEstoque.GetCodigoClasse: String;
begin
 result := qryConsultaClassescodigo.AsString;
end;

function TdtmRelatorioEstoque.GetCodigoItemProduto: String;
begin
 result := qryConsultaItemProdutoscodigovisual.asstring;
end;

function TdtmRelatorioEstoque.GetCodigoMarca: Integer;
begin
  Result := qryConsultaMarcascodigo.AsInteger;
end;

function TdtmRelatorioEstoque.GetConsultarClasse: TtecQuery;
begin
 result := qryConsultaClasses;
end;

function TdtmRelatorioEstoque.GetConsultarGrupo: TtecQuery;
begin
 result := qryConsultaGrupoProdutos;
end;

function TdtmRelatorioEstoque.GetConsultarItemProduto: TTecQuery;
begin
 result := qryConsultaItemProdutos;
end;

function TdtmRelatorioEstoque.GetConsultarProduto: TtecQuery;
begin
 result := qryConsultaProdutos;
end;

function TdtmRelatorioEstoque.GetConsultarMarca: TtecQuery;
begin
  Result := qryConsultaMarcas;
end;


procedure TdtmRelatorioEstoque.qryItemProdutosInicialCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  qryItemProdutosInicialdescricaolc.AsString :=
    qryItemProdutosInicialdescricao.AsString+' '+
    qryItemProdutosInicialvalorgrade1.AsString+' '+
    qryItemProdutosInicialvalorgrade2.AsString;

end;

procedure TdtmRelatorioEstoque.qryItemProdutosFinalCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  qryItemProdutosFinaldescricaolc.AsString :=
    qryItemProdutosFinaldescricao.AsString+' '+
    qryItemProdutosFinalvalorgrade1.AsString+' '+
    qryItemProdutosFinalvalorgrade2.AsString;

end;

procedure TdtmRelatorioEstoque.qryConsultaItemProdutosAfterOpen(
  DataSet: TDataSet);
begin
  inherited;
  qryConsultaItemProdutosvalorgrade1.Visible := ParSistema.UsarGradesProdutos;
  qryConsultaItemProdutosvalorgrade2.Visible := ParSistema.UsarGradesProdutos;

end;

procedure TdtmRelatorioEstoque.ImprimirRelatorio;
var
//  Relatorio: TfrReport;
//  frmPreview: TfrmPreviewPadrao;
  PV: TfrxComponent;
  arquivofast : String;

  procedure AtribuirLogo;
  begin
    if FileExists(LogotipoFilialBase) then
    begin
      PV := frxRelatorioEstoqueGrade.FindObject('fpvLogo');
      if (PV is TfrxPictureView) then
        TfrxPictureView(PV).picture.LoadFromFile(LogotipoFilialBase);
    end;

    if FileExists(LogotipoFilialBase) then
    begin
      PV := frxRelatorioEstoqueGradeGrupo.FindObject('fpvLogo');
      if (PV is TfrxPictureView) then
        TfrxPictureView(PV).picture.LoadFromFile(LogotipoFilialBase);
    end;


  end;

begin


  if ImpressaoemGrade then
  begin

//  frxRelatorioEstoqueGrade.designreport;
//  frxRelatorioEstoqueGradeGrupo.designreport;
//  frxRelatorioEstoqueGradeGrupoResumo.designreport;

  frxRelatorioEstoqueGrade.Clear;

  frxRelatorioEstoqueGrade.OldStyleProgress:=True;
  frxRelatorioEstoqueGrade.ShowProgress:=True;

  frxRelatorioEstoqueGrade.EngineOptions.DoublePass:=True;
  frxRelatorioEstoqueGrade.EngineOptions.TempDir:=ExtractFilePath(Application.ExeName);
  frxRelatorioEstoqueGrade.EngineOptions.MaxMemSize:= 200; {tried from 100 to 1000 in every compilation}
  frxRelatorioEstoqueGrade.EngineOptions.UseFileCache:=True;


   case resumo of
   0: begin

        arquivofast := ExtractFilePath(Application.ExeName) + 'frxRelatorioEstoqueGrade.fr3';
        if not FileExists(arquivofast) then
          MensagemErro(format('O arquivo %s não encontrado na pasta do executável!',[arquivofast]))
        else
        begin
          frxRelatorioEstoqueGrade.LoadFromFile(arquivofast);
          AtribuirLogo;
          frxRelatorioEstoqueGrade.PrepareReport(true);
        end;

        if not SomenteResumoporColuna then
        begin
          arquivofast := ExtractFilePath(Application.ExeName) + 'frxRelatorioEstoqueGradeGrupo.fr3';
          if not FileExists(arquivofast) then
            MensagemErro(format('O arquivo %s não encontrado na pasta do executável!',[arquivofast]))
          else
          begin
            frxRelatorioEstoqueGrade.LoadFromFile(arquivofast);
            AtribuirLogo;
            frxRelatorioEstoqueGrade.PrepareReport(false);
          end;
        end;

        arquivofast := ExtractFilePath(Application.ExeName) + 'frxRelatorioEstoqueGradeGrupoResumo.fr3';
        if not FileExists(arquivofast) then
          MensagemErro(format('O arquivo %s não encontrado na pasta do executável!',[arquivofast]))
        else
        begin
          frxRelatorioEstoqueGrade.LoadFromFile(arquivofast);
          AtribuirLogo;
          frxRelatorioEstoqueGrade.PrepareReport(false);
        end;

        frxRelatorioEstoqueGrade.ShowPreparedReport;
      end;
   1: begin

        arquivofast := ExtractFilePath(Application.ExeName) + 'frxRelatorioEstoqueGrade.fr3';
        if not FileExists(arquivofast) then
          MensagemErro(format('O arquivo %s não encontrado na pasta do executável!',[arquivofast]))
        else
        begin
          frxRelatorioEstoqueGrade.LoadFromFile(arquivofast);
          AtribuirLogo;
          frxRelatorioEstoqueGrade.PrepareReport(true);
        end;

        frxRelatorioEstoqueGrade.ShowPreparedReport;

      end;
   2: begin

        if not SomenteResumoporColuna then
        begin
          arquivofast := ExtractFilePath(Application.ExeName) + 'frxRelatorioEstoqueGradeGrupo.fr3';
          if not FileExists(arquivofast) then
            MensagemErro(format('O arquivo %s não encontrado na pasta do executável!',[arquivofast]))
          else
          begin
            frxRelatorioEstoqueGrade.LoadFromFile(arquivofast);
            AtribuirLogo;
            frxRelatorioEstoqueGrade.PrepareReport(true);
          end;
        end;

        arquivofast := ExtractFilePath(Application.ExeName) + 'frxRelatorioEstoqueGradeGrupoResumo.fr3';
        if not FileExists(arquivofast) then
          MensagemErro(format('O arquivo %s não encontrado na pasta do executável!',[arquivofast]))
        else
        begin
          frxRelatorioEstoqueGrade.LoadFromFile(arquivofast);
          AtribuirLogo;
          frxRelatorioEstoqueGrade.PrepareReport(false);
        end;

        frxRelatorioEstoqueGrade.ShowPreparedReport;

      end;
   end

  end
  else
  begin

    frVariables['RAZAOFILIALBASE']  := RazaoFilialBase;
    frVariables['ENDERECO_BAIRRO']   := RuaFilialBase+ ' - '+BairroFilialBase;
    frVariables['CEP_CIDADE_UF']:= FormatarCEP(CEPFilialBase)+'  '+CidadeFilialBase+ '  '+ EstadoFilialBase;
    frVariables['Outras']:= FParametroCabecalho;
    frVariables['EmLinha']:=FprodutoEmLinha;
    frVariables['ForadeLinha']:=FprodutoForadeLinha;
    frVariables['Ativo']:=FProdutoAtivo;
    frVariables['Inativo']:=FProdutoInativo;
    frVariables['ComMontagem']:=FProdutoComMontagem;
    frVariables['SemMontagem']:=FProdutoSemMontagem;
    frVariables['Brinde']:=FProdutoBrinde;
    frVariables['NaoBrinde']:=FProdutoNaoBrinde;
    frVariables['AgruparGrupoFilial']:=AgruparGrupoFilial;
    frVariables['AgruparFilial']:=AgruparFilial;
    frVariables['AgruparFornecedor']:=AgruparFornecedor;
    frvariables['AgruparLocalizacao']:=AgruparLocalizacao;
    frVariables['AgruparClasseProduto']:=AgruparClasseProduto;
    frVariables['AgruparGrupoProduto']:=AgruparGrupoProduto;
    frVariables['AgruparProduto']:=AgruparProduto;
    frVariables['DataSituacao']:= ANSIUpperCase(ctSITUACAOEM+' '+DataExtenso(strtodate(FDataSituacao)));
    frVariables['ComQuantidades']:= FComQuantidades;
    frVariables['PrecoComICMS']:= FPrecoComICMS;
    frVariables['PrecoSemICMS']:= FPrecoSemICMS;

    //frpRelatorioEstoque.DesignReport;
//    frmPreview := TfrmPreviewPadrao.create(self);
    try
//     Relatorio := frmPreview.frCompositeReport;
//     with frmPreview do
//     begin
//      frCompositeReport.Reports.Clear;
      case FResumo of
       0 : if FComValorFinanceiro then
           begin
             if AcabadosSemiAcabados then
             begin
               ImprimirRelatoriofast(null, null, MPadrao, Resumo, [frpRelatorioEstoque_SemiAcabados, frpRelatorioEstoque_SemiAcabadosResumo], true, self)
{
               frCompositeReport.Reports.Add(frpRelatorioEstoque_SemiAcabados);
               frCompositeReport.Reports.Add(frpRelatorioEstoque_SemiAcabadosResumo);
               }
             end
             else
             begin

               if ComCodigodeBarras then
                 ImprimirRelatoriofast(null, null, MPadrao, Resumo, [frpRelatorioEstoque_comFinanceiroCB, frpRelatorioEstoque_comFinanceiroResumo], true, self)
//                 frCompositeReport.Reports.Add(frpRelatorioEstoque_comFinanceiroCB);
               else
                 ImprimirRelatoriofast(null, null, MPadrao, Resumo, [frpRelatorioEstoque_comFinanceiro, frpRelatorioEstoque_comFinanceiroResumo], true, self);

//                 frCompositeReport.Reports.Add(frpRelatorioEstoque_comFinanceiro);

//               frCompositeReport.Reports.Add(frpRelatorioEstoque_comFinanceiroResumo);
             end;
           end
           else
           if FComPrecodeVenda then
           begin
             ImprimirRelatoriofast(null, null, MPadrao, Resumo, [frpRelatorioEstoque_comPrecodeVenda, frpRelatorioEstoque_comPrecodeVendaResumo], true, self)

//             frCompositeReport.Reports.Add(frpRelatorioEstoque_comPrecodeVenda);
//             frCompositeReport.Reports.Add(frpRelatorioEstoque_comPrecodeVendaResumo);
           end
           else
             ImprimirRelatoriofast(null, null, MSimples, 0, [frpRelatorioEstoque], true, self);
//             frCompositeReport.Reports.Add(frpRelatorioEstoque);


       1 : if FComValorFinanceiro then
           begin
             if AcabadosSemiAcabados then
               ImprimirRelatoriofast(null, null, MSimples, 0, [frpRelatorioEstoque_SemiAcabados], true, self)
//               frCompositeReport.Reports.Add(frpRelatorioEstoque_SemiAcabados)
             else
             begin
               if ComCodigodeBarras then
                 ImprimirRelatoriofast(null, null, MSimples, 0, [frpRelatorioEstoque_comFinanceiroCB], true, self)
//                 frCompositeReport.Reports.Add(frpRelatorioEstoque_comFinanceiroCB)
               else
                 ImprimirRelatoriofast(null, null, MSimples, 0, [frpRelatorioEstoque_comFinanceiro], true, self)
//                 frCompositeReport.Reports.Add(frpRelatorioEstoque_comFinanceiro);
             end;
           end
           else if FComPrecodeVenda then
              ImprimirRelatoriofast(null, null, MSimples, 0, [frpRelatorioEstoque_comPrecodeVenda], true, self)
//              frCompositeReport.Reports.Add(frpRelatorioEstoque_comPrecodeVenda)
           else ImprimirRelatoriofast(null, null, MSimples, 0, [frpRelatorioEstoque], true, self);
               // frCompositeReport.Reports.Add(frpRelatorioEstoque);

       2 : if FComValorFinanceiro then
           begin
             if AcabadosSemiAcabados then
               ImprimirRelatoriofast(null, null, MSimples, 0, [frpRelatorioEstoque_SemiAcabadosResumo], true, self)
//               frCompositeReport.Reports.Add(frpRelatorioEstoque_SemiAcabadosResumo)
             else
              ImprimirRelatoriofast(null, null, MSimples, 0, [frpRelatorioEstoque_comFinanceiroResumo], true, self)
//              frCompositeReport.Reports.Add(frpRelatorioEstoque_comFinanceiroResumo)
           end
           else if FComPrecodeVenda then
              ImprimirRelatoriofast(null, null, MSimples, 0, [frpRelatorioEstoque_comPrecodeVendaResumo], true, self)
//              frCompositeReport.Reports.Add(frpRelatorioEstoque_comPrecodeVendaResumo)
           else  ImprimirRelatoriofast(null, null, MSimples, 0, [frpRelatorioEstoque], true, self);
//           frCompositeReport.Reports.Add(frpRelatorioEstoque);
      end;
//     end;
//     Relatorio.Preview := frmPreview.frPreviewPadrao;
//     Relatorio.ShowReport;

//     frmPreview.ShowModal;

    finally

//     frmPreview.Free

    end;
  end;
end;


procedure TdtmRelatorioEstoque.SetParametroFornecedor(const Value: String);
begin
  FParametroFornecedor := Value;
  if (value <>'') then
    ParametroCabecalho := ParametroCabecalho+' Fornec.: '+value;
end;

procedure TdtmRelatorioEstoque.MontarFiltroFiliais(Usar: TCheckListBox);
var
  STRFiliais: String;
  TodasFiliais: Boolean;
  cnt: Integer;
begin
  TodasFiliais := True;
  STRFiliais := '';
  for cnt := 0 to FListaFiliais.Count - 1 do
    if Usar.Checked[cnt] then
      STRFiliais := STRFiliais + '''' + IntToStr(Integer(FListaFiliais.Objects[cnt])) + ''','
    else
      TodasFiliais := False;

  STRFiliais := Copy(STRFiliais, 0, Length(STrFiliais) - 1);
  Filial:=STRFiliais;
  if Trim(STRFiliais) <> '' then
    if not TodasFiliais then
      FParametroCabecalho:=FParametroCabecalho+' Filiais: '+STRFiliais
    else Filial:='';
end;

procedure TdtmRelatorioEstoque.MontarFiltroGrupoFiliais(
  Usar: TCheckListBox);
var
  STRGruposFiliais: String;
  TodosGrupos: Boolean;
  cnt: Integer;
begin
  STRGruposFiliais := '';
  TodosGrupos := True;
  for cnt := 0 to FListaGruposFiliais.Count - 1 do
    if Usar.Checked[cnt] then
      STRGruposFiliais := STRGruposFiliais + '''' + IntToStr(Integer(FListaGruposFiliais.Objects[cnt])) + ''','
    else
      TodosGrupos := False;

  STRGruposFiliais := Copy(STRGruposFiliais, 0, Length(STrGruposFiliais) - 1);
  GrupoFilial:=STRGruposFiliais;
  if Trim(STRGruposFiliais) <> '' then
    if not TodosGrupos then
     FParametroCabecalho:=FParametroCabecalho+' Grupo de Filiais: '+STRGruposFiliais
    else
     GrupoFilial:='';
end;

procedure TdtmRelatorioEstoque.AbreConsultaEstoques (
                                                      Condicao_ItemdeProdutos,
                                                      Condicao_produtos,
                                                      Condicao_gruposprodutos,
                                                      Condicao_classesprodutos,
                                                      Condicao_marcasProdutos,
                                                      Condicao_MarketPlace,
                                                      Condicao_Promocoes
                                                       : String
                                                    );
const
 FiltroFornecedor =
  ' (e.produto in (Select p.codigo '+
               ' from (produtos p join (caracteristicas c'+
               ' join (fornecedoresprodutos fp JOIN vfornecedores vf on fp.fornecedor = vf.codigo and vf.tipo = ''F'') on c.codigo = fp.caracteristica)'+
               ' on p.caracteristica=c.codigo) '+
               ' where %s ))';


 FiltroGruposFornecedores = ' (e.produto in (Select p.codigo '+
                            ' from produtos p where p.caracteristica in '+
                            ' (select fp.caracteristica from fornecedoresprodutos fp where fp.fornecedor in (select f.codigo from fornecedores f join gruposfornecedores gf on f.grupofornecedor = gf.codigo where %s))))';

 FiltroFilial      = ' ( e.filial IN (%s)) ';
 FiltroGrupoFilial = ' ( e.filial IN (SELECT filial ' +
                                    'FROM filiaisgruposfiliais fgf '+
                                    'WHERE fgf.grupo IN (%s))) ';
 AgrupamentoResumo = ') as totais ) as totais group by nomegrupofilial, codigogrupofilial, nomefilial, codigofilial, localizacao, fornecedor, nomefornecedor, classeproduto, codigoclasse, grupoproduto, codigogrupo, produto, codigoproduto, codigoprodutovisual';
 SQLGradecomElementos = ' (p.valorgrade1 is not null or p.valorgrade2 is not null)';

 SQLEstoqueCondicaoGrade =  ' join produtos p on e.produto = p.codigo '+
                            '      join caracteristicas c on p.caracteristica = c.codigo '+
                            ' and c.codigo = g1.codigoproduto and e.filial = g1.codigofilial';

 SQLEstoqueCondicaoGradeGrupo =  ' join produtos p on e.produto = p.codigo '+
                            '      join caracteristicas c on p.caracteristica = c.codigo '+
                            ' and c.grupo = g1.codigogrupo';


 SQLCondicao_MarketPlace = ' and e.produto in (select pm.produto '+
                                             ' from produto_marketplace pm '+
                                             '      join marketplace mk '+
                                             '      on mk.codigo=pm.marketplace '+
                                             ' where true and %s )';




var
 SQLEstoque, SQLMovimento, SQLSituacaoProdutos, SQLQuantidades,SoAtivos,SoForaLinha : String;
begin
  SQLEstoque  := '';
  SQLMovimento := '';
  SQLSituacaoProdutos := '';
  SQLQuantidades := '';

  if SemEstoqueZero then
  begin
    if (StrToDate(FDataSituacao)<>DataLocal) then
    begin
      if not FSomenteEstoqueFisico then
        SQLMovimento := ' Where (quantidadetotaldoestoque(m1.numero)<>0) '//' Where (m1.financeiro <> 0) '
      else
        SQLMovimento := ' Where (m1.estoquefisico<>0) ';
    end
    else
    begin
      if not FSomenteEstoqueFisico then
        SqlEstoque   := ' (quantidadetotaldoestoque(e.produto,e.filial) <> 0) '
      else
        SqlEstoque   := ' (e.estoquefisico <> 0) '
    end;
  end;

  if (NaoVendidosHaNDias<>'0') then
  begin
    if length(SQLEstoque)<>0 then
      SQLEstoque := SQLEstoque + ' AND ' + '(e.ultimavenda <= (current_date - ' + NaoVendidosHaNDias+'))'
    else
      SQLEstoque := ' (e.ultimavenda <= (current_date - ' + NaoVendidosHaNDias+')) ';
  end;

  if (FFilial<>'') then
   if length(SQLEstoque)<>0 then
    SQLEstoque := SQLEstoque + ' and '+ format(FiltroFilial,[FFilial])
   else
    SQLEstoque := format(FiltroFilial,[FFilial]);

  if (FGrupoFilial<>'') then
   if length(SQLEstoque)<>0 then
    SQLEstoque := SQLEstoque + ' and (' + format(FiltroGrupoFilial,[FGrupoFilial]) + ' )'
   else
    SQLEstoque := format(FiltroGrupoFilial,[FGrupoFilial]);

  if Condicao_ItemdeProdutos<>'' then
    qryEstoques.MacroByName('Condicao_ItemdeProdutos').AsString := ' and (' + Condicao_ItemdeProdutos + ' )'
  else
    qryEstoques.MacroByName('Condicao_ItemdeProdutos').AsString := '';

  if Condicao_produtos<>'' then
    qryEstoques.MacroByName('Condicao_produtos').AsString := ' and (' + Condicao_produtos + ' )'
  else
    qryEstoques.MacroByName('Condicao_produtos').AsString := '';

  if Condicao_gruposprodutos<>'' then
    qryEstoques.MacroByName('Condicao_gruposprodutos').AsString := ' and (' + Condicao_gruposprodutos + ' )'
  else
    qryEstoques.MacroByName('Condicao_gruposprodutos').AsString := '';

  if Condicao_classesprodutos<>'' then
    qryEstoques.MacroByName('Condicao_classesprodutos').AsString := ' and (' + Condicao_classesprodutos + ' )'
  else
    qryEstoques.MacroByName('Condicao_classesprodutos').AsString := '';

  if Condicao_marcasProdutos<>'' then
    qryEstoques.MacroByName('Condicao_marcasProdutos').AsString := ' and (' + Condicao_marcasProdutos + ' )'
  else
    qryEstoques.MacroByName('Condicao_marcasProdutos').AsString := '';

  if Condicao_MarketPlace<>'' then
    qryEstoques.MacroByName('Condicao_MarketPlace').AsString :=  format(SQLCondicao_MarketPlace,[Condicao_MarketPlace])
  else
    qryEstoques.MacroByName('Condicao_MarketPlace').AsString := '';

  if Condicao_Promocoes<>'' then
  begin
    qryEstoques.MacroByName('Condicao_Promocoes_join').asString := ' join promocoes pro on p.promocao = pro.codigo ';
    qryEstoques.MacroByName('Condicao_Promocoes').AsString :=  ' and ( ' + Condicao_Promocoes + ' )';
  end
  else
  begin
    qryEstoques.MacroByName('Condicao_Promocoes_join').asString := '';
    qryEstoques.MacroByName('Condicao_Promocoes').AsString := '';
  end;


   if (FParametroLocalizacao <> '') then
     if Length(SQLEstoque) <> 0 then
       SQLEstoque := SQLEstoque+' and '+MontarParametroLocalizacao
     else
       SQLEstoque := MontarParametroLocalizacao;

  if (FParametroFornecedor<>'') then
   if Length(SQLEstoque)<>0 then
     SQLEstoque := SQLEstoque+' and '+format(FiltroFornecedor, [trocar(FParametroFornecedor,'codigo','vf.codigo')])
   else
     SQLEstoque := format(FiltroFornecedor, [trocar(FParametroFornecedor,'codigo','vf.codigo')]) ;


  if ListaGruposFornecedores<>'' then
  begin
   if length(SQLEstoque)<>0 then
     SQLEstoque := SQLEstoque +  ' and ' + format(FiltroGruposFornecedores, [trocar(ListaGruposFornecedores,'codigo','gf.codigo')])
   else
     SQLEstoque := format(FiltroGruposFornecedores, [trocar(ListaGruposFornecedores,'codigo','gf.codigo')]);
  end;


  if (length(SQLEstoque)<>0) then
    insert('and ', SQLEstoque, 0);

  if StrToDate(FDataSituacao)<>DataLocal then
        SoForaLinha:= 'or (p.foralinha>'''+FDataSituacao+''')'
  else
        SoForaLinha:='';

  if FProdutoEmLinha and not FprodutoForadeLinha then
    SQLSituacaoProdutos := SQLSituacaoProdutos +
                            ' and  (not (p.foralinhal) '+SoForaLinha+') and (not c.foralinhal)'
  else
  if FprodutoForadeLinha and not Fprodutoemlinha then
    SQLSituacaoProdutos := SQLSituacaoProdutos +
                           ' and  (p.foralinhal or c.foralinhal)';

  if StrToDate(FDataSituacao)<>DataLocal then
    SoAtivos:= 'or (p.inativo>'''+FDataSituacao+''')'
  else
    SoAtivos:='';

  if FProdutoAtivo and not FprodutoInativo then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and  (not (p.inativo is not null) '+ SoAtivos+ ')'
  else
  if FprodutoInativo and not FprodutoAtivo then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and  (p.inativo is not null)';

  if FProdutoComMontagem and not FProdutoSemMontagem then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and (c.montagem)'
  else
  if FProdutoSemMontagem and not FProdutoComMontagem then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and not (c.montagem)';

  if FProdutoBrinde and not FProdutoNaoBrinde then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and (c.brinde)'
  else
  if FProdutoNaoBrinde and not FProdutoBrinde then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and not (c.brinde)';

  if FDisponivelnoSite and not FNaoDisponivelnoSite then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and (p.aparecernosite)'
  else
  if FNaoDisponivelnoSite and not FDisponivelnoSite then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and not (p.aparecernosite)';

//  if (length(SQLSituacaoProdutos)<>0) then
//    insert('Where ', SQLSituacaoProdutos, 0);

  if (emEstoque_Inicial<>'-999999999') or (emEstoque_Final<>'999999999') then
  begin
    SQLQuantidades := SQLQuantidades+' emEstoque between ('+emEstoque_Inicial+') and ('+emEstoque_Final+')';
    FParametroCabecalho := FParametroCabecalho+' em Estoque entre: '+trim(emEstoque_Inicial)+' a '+trim(emEstoque_Final);
  end;

  if (Reservado_Inicial<>'-999999999') or (Reservado_Final<>'999999999') then
  begin
    if Length(SQLQuantidades)>0 then
     SQLQuantidades := SQLQuantidades+' and reservado between ('+Reservado_Inicial+') and ('+Reservado_Final+')'
    else SQLQuantidades := SQLQuantidades+' reservado between ('+Reservado_Inicial+') and ('+Reservado_Final+')';
    FParametroCabecalho := FParametroCabecalho+' Reservado entre: '+trim(Reservado_Inicial)+' a '+trim(Reservado_Final);
  end;

  if (ReservaPrevia_Inicial<>'-999999999') or (ReservaPrevia_Final<>'999999999') then
  begin
    if Length(SQLQuantidades)>0 then
     SQLQuantidades := SQLQuantidades+' and reservaprevia between ('+ReservaPrevia_Inicial+') and ('+ReservaPrevia_Final+')'
    else SQLQuantidades := SQLQuantidades+' reservaprevia between ('+reservaprevia_Inicial+') and ('+reservaprevia_Final+')';
    FParametroCabecalho := FParametroCabecalho+' Reserva Previa entre: '+trim(reservaprevia_Inicial)+' a '+trim(reservaprevia_Final);
  end;

  if (emTransito_Inicial<>'-999999999') or (emTransito_Final<>'999999999') then
  begin
    if Length(SQLQuantidades)>0 then
     SQLQuantidades := SQLQuantidades+' and Transito between ('+emTransito_Inicial+') and ('+emTransito_Final+')'
    else SQLQuantidades := SQLQuantidades+' Transito between ('+emTransito_Inicial+') and ('+emTransito_Final+')';
    FParametroCabecalho := FParametroCabecalho+' em Transito entre: '+trim(emTransito_Inicial)+' a '+trim(emTransito_Final);
  end;

  if (emDemonstracao_Inicial<>'-999999999') or (emDemonstracao_Final<>'999999999') then
  begin
    if Length(SQLQuantidades)>0 then
     SQLQuantidades := SQLQuantidades+' and demonstracao between ('+emDemonstracao_Inicial+') and ('+emDemonstracao_Final+')'
    else SQLQuantidades := SQLQuantidades+' demonstracao between ('+emDemonstracao_Inicial+') and ('+emDemonstracao_Final+')';
    FParametroCabecalho := FParametroCabecalho+' em Demonstr. entre: '+trim(emDemonstracao_Inicial)+' a '+trim(emDemonstracao_Final);
  end;

  if (emConserto_Inicial<>'-999999999') or (emConserto_Final<>'999999999') then
  begin
    if Length(SQLQuantidades)>0 then
     SQLQuantidades := SQLQuantidades+' and Conserto between ('+emConserto_Inicial+') and ('+emConserto_Final+')'
    else SQLQuantidades := SQLQuantidades+' Conserto between ('+emConserto_Inicial+') and ('+emConserto_Final+')';
    FParametroCabecalho := FParametroCabecalho+' em Conserto entre: '+trim(emConserto_Inicial)+' a '+trim(emConserto_Final);
  end;

  if (Futuro_Inicial<>'-999999999') or (Futuro_Final<>'999999999') then
  begin
    if Length(SQLQuantidades)>0 then
     SQLQuantidades := SQLQuantidades+' and Futuro between ('+Futuro_Inicial+') and ('+Futuro_Final+')'
    else SQLQuantidades := SQLQuantidades+' Futuro between ('+Futuro_Inicial+') and ('+Futuro_Final+')';
    FParametroCabecalho := FParametroCabecalho+' Futuro entre: '+trim(futuro_Inicial)+' a '+trim(futuro_Final);
  end;

  if (Avariado_Inicial<>'-999999999') or (Avariado_Final<>'999999999') then
  begin
    if Length(SQLQuantidades)>0 then
     SQLQuantidades := SQLQuantidades+' and danificada between ('+Avariado_Inicial+') and ('+Avariado_Final+')'
    else SQLQuantidades := SQLQuantidades+' danificada between ('+Avariado_Inicial+') and ('+Avariado_Final+')';
    FParametroCabecalho := FParametroCabecalho+' Avariado entre: '+trim(Avariado_Inicial)+' a '+trim(Avariado_Final);
  end;

  if (Pedido_Inicial<>'-999999999') or (Pedido_Final<>'999999999') then
  begin
    if Length(SQLQuantidades)>0 then
     SQLQuantidades := SQLQuantidades+' and Pedido between ('+Pedido_Inicial+') and ('+Pedido_Final+')'
    else SQLQuantidades := SQLQuantidades+' Pedido between ('+Pedido_Inicial+') and ('+Pedido_Final+')';
    FParametroCabecalho := FParametroCabecalho+' Pedido entre: '+trim(Pedido_Inicial)+' a '+trim(Pedido_Final);
  end;

  if Length(SQLQuantidades)>0 then
    Insert('Where ', SQLQuantidades, 0);

  qryEstoques.MacroByName('estoque').AsString:=SQLEstoque;
  qryEstoques.MacroByName('produtos').AsString:=SQLSituacaoProdutos;
  if STRTODATE(FDataSituacao)<>DataLocal then
    qryEstoques.MacroByName('movimento').AsString:=SQLMovimento;
  qryEstoques.MacroByName('quantidades').AsString:=SQLQuantidades;
  qryEstoques.ParamByName('somenteestoquefisico').AsBoolean:=FSomenteEstoqueFisico;


  case compostos of
  0: begin
       qryEstoques.MacroByName('FiltroComposto').AsString:= '';

     end;

  1: begin
       qryEstoques.MacroByName('FiltroComposto').AsString:= ' and not (coalesce(c.composto,false))';
       FParametroCabecalho := FParametroCabecalho + 'Sem compostos';
     end;

  2: begin
       qryEstoques.MacroByName('FiltroComposto').AsString:= ' and (coalesce(c.composto,false))';
       FParametroCabecalho := FParametroCabecalho + 'Somente compostos';
     end;
  end;

  if ImpressaoemGrade and GradecomElementos then
  begin
    if (SQLSituacaoProdutos <> '') or (qryEstoques.MacroByName('FiltroComposto').AsString<>'') then
      qryEstoques.MacroByName('GradecomElementos').AsString := ' and ' + SQLGradecomElementos;

  end
  else
   qryEstoques.MacroByName('GradecomElementos').AsString := '';


{  case Resumo of
  0,2: begin}
            qryEstoquesResumo.Sql.Clear;
            //tirando o ; do incio de qryEstoques.Sql
            qryEstoquesResumo.Sql.Text :=  qryEstoquesResumo_Totais.sql.Text+Copy(qryEstoques.Sql.Text,2,Length(qryEstoques.Sql.Text));
            qryEstoquesResumo.Sql.Add(AgrupamentoResumo);

            qryEstoquesResumo.Params := qryEstoques.params;
            qryEstoquesResumo.Macros := qryEstoques.Macros;

{       end;
  end;}

  qryEstoques.parambyname('somenteestoquefisico').asBoolean := FSomenteEstoqueFisico;
  qryEstoques.parambyname('data').asString := Datasituacao;

  qryEstoquesResumo.ParamByName('AgruparGrupoFilial').AsBoolean := AgruparGrupoFilial;
  qryEstoquesResumo.ParamByName('AgruparFilial').AsBoolean := AgruparFilial;
  qryEstoquesResumo.ParamByName('AgruparFornecedor').AsBoolean := AgruparFornecedor;
  qryEstoquesResumo.ParamByName('AgruparLocalizacao').AsBoolean := AgruparLocalizacao;
  qryEstoquesResumo.ParamByName('AgruparClasseproduto').AsBoolean := AgruparClasseproduto;
  qryEstoquesResumo.ParamByName('AgruparGrupoProduto').AsBoolean := AgruparGrupoProduto;
  qryEstoquesResumo.ParamByName('AgruparProduto').AsBoolean := AgruparProduto;
  qryEstoquesResumo.ParamByName('PrecoComICMS').AsBoolean := PrecoComICMS;
  qryEstoquesResumo.ParamByName('PrecoSemICMS').AsBoolean := PrecoSemICMS;
  qryEstoquesResumo.parambyname('somenteestoquefisico').asBoolean := FSomenteEstoqueFisico;
  qryEstoquesResumo.parambyname('data').asString := Datasituacao;

  qryEstoquesGrade.Sql.Text := qryEstoquesGrade_Aux_Produto.Sql.Text;
  qryEstoquesGrade.Sql.Insert(NumerodalinhanoTexto(qryEstoquesGrade.Sql, '%SQLEstoques_Linha_1'), trocar(qryEstoques.Sql.Text,';',''));
  qryEstoquesGrade.Sql.Insert(NumerodalinhanoTexto(qryEstoquesGrade.Sql, '%SQLEstoques_Linha_2'), trocar(qryEstoques.Sql.Text,';',''));
  qryEstoquesGrade.Params := qryEstoques.Params;
  qryEstoquesGrade.Macros := qryEstoques.Macros;

  qryEstoquesGradeporGrupos.sql.text := qryEstoquesGradeporGrupos_aux.sql.text;
  qryEstoquesGradeporGrupos.Sql.Insert(NumerodalinhanoTexto(qryEstoquesGradeporGrupos.Sql, '%SQLEstoques_Linha'), trocar(qryEstoques.Sql.Text,';',''));
  qryEstoquesGradeporGrupos.Params := qryEstoques.Params;
  qryEstoquesGradeporGrupos.Macros := qryEstoques.Macros;

  qryEstoquesColunasGrupos.Sql.Text := qryEstoquesColunasGrupo_Aux.Sql.Text;
  qryEstoquesColunasGrupos.Sql.Insert(NumerodalinhanoTexto(qryEstoquesColunasGrupos.Sql, '%SQLEstoques_Linha_1'), trocar(qryEstoques.Sql.Text,';',''));
  qryEstoquesColunasGrupos.Sql.Insert(NumerodalinhanoTexto(qryEstoquesColunasGrupos.Sql, '%SQLEstoques_Linha_2'), trocar(qryEstoques.Sql.Text,';',''));
  qryEstoquesColunasGrupos.Params := qryEstoques.Params;
  qryEstoquesColunasGrupos.Macros := qryEstoques.Macros;

  if ImpressaoemGrade then
  begin

    case resumo of
    0: begin
        RefazConsulta(qryEstoques,[],[]);
        RefazConsulta(qryEstoquesGrade,[],[]);

        RefazConsulta(qryEstoquesGradeporGrupos,[],[]);
        RefazConsulta(qryEstoquesColunasGrupos,[],[]);

       end;


    1: begin
        RefazConsulta(qryEstoques,[],[]);
        RefazConsulta(qryEstoquesGrade,[],[]);
       end;
    2: begin
         RefazConsulta(qryEstoquesGradeporGrupos,[],[]);
         RefazConsulta(qryEstoquesColunasGrupos,[],[]);
       end;
    end;
  end
  else
  begin
    case Resumo of
      0: begin
          RefazConsulta(qryEstoques,[],[]);
          RefazConsulta(qryEstoquesResumo,[],[]);
         end;

      1: RefazConsulta(qryEstoques,[],[]);

      2: RefazConsulta(qryEstoquesResumo,[],[]);
    end;
  end;
end;



procedure TdtmRelatorioEstoque.SetemEstoque_Inicial(const Value: String);
begin
  FemEstoque_Inicial := Value;
  if Value = '0' then
   FemEstoque_Inicial := '-999999999'
end;

procedure TdtmRelatorioEstoque.SetemEstoque_Final(const Value: String);
begin
  FemEstoque_Final := Value;
  if value = '0' then
   FemEstoque_Final := '999999999';
end;

