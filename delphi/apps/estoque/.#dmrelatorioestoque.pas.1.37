procedure TdtmRelatorioEstoque.qryEstoquesResumoCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  {
   qryEstoquesoutros.AsCurrency :=
   qryEstoquesreservado.AsCurrency +
   qryEstoquestransito.AsCurrency +
   qryEstoquesdemonstracao.AsCurrency +
   qryEstoquesdanificada.AsCurrency +
   qryEstoquesreservaprevia.AsCurrency+
   qryEstoquesfuturo.AsCurrency;
   }

   if AcabadosSemiAcabados then
   begin
     qryEstoquesResumoQtdeEstoque.asCurrency :=
     qryEstoquesResumoemestoque.asCurrency { +
     qryEstoquesacabados.asCurrency +
     qryEstoquessemiacabados.asCurrency};
   end
   else
   begin
     if FSomenteEstoqueFisico then
       qryEstoquesResumoQtdeEstoque.AsCurrency:=qryEstoquesResumoestoquefisico.AsCurrency
     else
       qryEstoquesResumoQtdeEstoque.asCurrency :=
       qryEstoquesResumoemestoque.asCurrency +
       qryEstoquesResumoreservado.asCurrency +
       qryEstoquesResumotransito.asCurrency +
       qryEstoquesResumodemonstracao.asCurrency +
       qryEstoquesResumoconserto.asCurrency +
       qryEstoquesResumodanificada.asCurrency +
       qryEstoquesResumoreservaprevia.asCurrency;
   end;

end;

