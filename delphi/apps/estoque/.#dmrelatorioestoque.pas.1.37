procedure TdtmRelatorioEstoque.SetParametroData(const Value: String);
begin
  FDataSituacao := Value;
  if strtodate(FDataSituacao)=DataLocal then
  begin
    qryEstoques.Sql.Text := qryEstoques_Atual.Sql.Text;
    qryEstoques.ParamByName('data').AsString:=FDataSituacao;
  end
  else
  begin
   qryEstoques.Sql.Text := qryEstoques_Anterior.Sql.Text;
   qryEstoques.ParamByName('data').AsString:=FDataSituacao;
  end;
end;

