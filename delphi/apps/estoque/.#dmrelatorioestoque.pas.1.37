procedure TdtmRelatorioEstoque.SetFuturo_Inicial(const Value: String);
begin
  FFuturo_Inicial := Value;
  if value = '0' then
   FFuturo_Inicial := '-999999999';
end;

procedure TdtmRelatorioEstoque.SetFuturo_Final(const Value: String);
begin
