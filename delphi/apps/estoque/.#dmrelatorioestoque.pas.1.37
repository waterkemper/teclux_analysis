   end
   else
   begin
     qryEstoquesGradeporGruposValorGrade_Linha.asString := qryEstoquesGradeporGruposvalorgrade1.asString;
     qryEstoquesGradeporGruposValorGrade_Coluna.asString := qryEstoquesGradeporGruposvalorgrade2.asString;
   end;
                                  {
   qryEstoquesGradeporGruposoutros.AsCurrency :=
   qryEstoquesGradeporGruposreservado.AsCurrency +
   qryEstoquesGradeporGrupostransito.AsCurrency +
   qryEstoquesGradeporGruposdemonstracao.AsCurrency +
