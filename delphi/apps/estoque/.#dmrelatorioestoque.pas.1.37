   end
   else
   begin
     if FSomenteEstoqueFisico then
       qryEstoquesGradeporGruposQtdeEstoque.AsCurrency:=qryEstoquesGradeporGruposestoquefisico.AsCurrency
     else
       qryEstoquesGradeporGruposQtdeEstoque.asCurrency :=
       qryEstoquesGradeporGruposemestoque.asCurrency +
       qryEstoquesGradeporGruposreservado.asCurrency +
       qryEstoquesGradeporGrupostransito.asCurrency +
       qryEstoquesGradeporGruposdemonstracao.asCurrency +
       qryEstoquesGradeporGruposconserto.asCurrency +
       qryEstoquesGradeporGruposdanificada.asCurrency +
       qryEstoquesGradeporGruposreservaprevia.asCurrency;
   end;

end;

