function TdtmRelatorioEstoque.MontarParametroLocalizacao: String;
const
 SQLLocalizacao =  ' e.localizacao %s';
var
 SQL : String;
begin
  SQL := '';

  if (FParametroLocalizacao <>'') then
  begin
    SQL := format(SQLLocalizacao,['ilike '+quotedstr(FParametroLocalizacao+'%')]);
    FParametroCabecalho:= FParametroCabecalho+' Localização: '+FParametroTituloLocalizacao;
  end;

  result := SQL;
end;
procedure TdtmRelatorioEstoque.ZMonitor1MonitorEvent(Sql, Result: String);
var
 Listar : TStringList;
 Arquivo: String;
begin
  inherited;
  Listar := tStringlist.create;
  Arquivo := 'c:\teclux\estoque.sql';
  if fileexists(Arquivo) then
    Listar.loadfromfile(Arquivo);
  Listar.add('');
  Listar.add(sql);
  Listar.add(result);
  listar.savetofile(Arquivo);
  listar.free;
end;

