    Sql.Strings = (
      'select np.codigo,'
      '          np.fornecedor,'
      '          np.tipofornecedor,'
      
        '          (select coalesce(vf.razao,vf.nome) as nome  from vforn' +
        'ecedores vf where vf.codigo = np.fornecedor and vf.tipo = np.tip' +
        'ofornecedor) as nome,'
      '          fgf.grupo as grupofilial,'
      '          gf.descricao as nomegrupofilial,'
      '          np.filial as filial,'
      '          f.nome as nomefilial,'
      '          np.serie,'
      '          np.numero,'
      '          np.codigofiscal,'
      '          np.natureza,'
      '          np.data,'
      '          np.emissao,'
      '          np.valornota,'
      '          np.documentopag,'
      '          dp.evento,'
      '          e.descricao as descricaoevento,'
      ''
      
        '          (select sum(d.valorvencto) from duplicatas d where d.d' +
        'ocumentopag = np.documentopag) as totalvalorvencto,'
      ''
      
        '          (select sum(d.valorpagto) from duplicatas d where d.do' +
        'cumentopag = np.documentopag) as totalvalorpagto,'
      ''
      
        '          (select sum((d.valorvencto-d.valorpagto))  from duplic' +
        'atas d'#9'where d.documentopag = np.documentopag'
      
        '                                                                ' +
        '      '#9'  and d.datapagto is not null) as totalvalorjurosdesconto' +
        ','
      ''
      
        '          (select sum(pnp.quantidade*pnp.precounitario) from pro' +
        'dutosnotaspag pnp where pnp.codigonota = np.codigo) as precotota' +
        'l,'
      
        '          (select sum(pnp.quantidade) from produtosnotaspag pnp ' +
        'where pnp.codigonota = np.codigo) as quantidadetotal'
      ''
      ''
      'from ((notaspag np'
      '      join (filiais f'
      '           left join (filiaisgruposfiliais fgf'
      
        '                      join gruposfiliais gf on fgf.grupo=gf.codi' +
        'go)'
      '           on f.codigo=fgf.filial)'
      '      on np.filial=f.codigo)'
      #9'  left join (documentospag dp'
      '               join eventos e'
      '               on dp.evento = e.codigo)'
      #9'  on np.documentopag = dp.numero)'
      ''
      ''
      'where'
      '%TipodeData'
      'between :datainicial and :dataFinal'
      'and np.situacao<>'#39'P'#39
      '%WhereCodigosFiscais'
      '%WhereFornecedores'
      '%WhereNaturezas'
      '%WhereFiliais'
      '%WhereGruposFiliais'
      '%WhereEventos'
      '%WhereListaProdutoAleatorio'
      ' '
      '%Ordenacao')
    RequestLive = False
