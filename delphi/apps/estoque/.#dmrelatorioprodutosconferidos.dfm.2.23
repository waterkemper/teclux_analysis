    end
    object qrySelecaoConferenciasaldo: TFloatField
      FieldKind = fkCalculated
      FieldName = 'saldo'
      DisplayFormat = '0.00'
      Calculated = True
    end
    object qrySelecaoConferenciapercentual: TFloatField
      FieldName = 'percentual'
      DisplayFormat = '0.00'
    end
    object qrySelecaoConferenciasituacao: TStringField
      FieldName = 'situacao'
      Size = 2
    end
    object qrySelecaoConferenciadocumentopesquisa: TStringField
