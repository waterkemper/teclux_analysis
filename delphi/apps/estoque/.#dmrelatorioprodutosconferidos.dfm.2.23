    object qrySelecaoConferenciaDescricaoSituacao: TStringField
      FieldKind = fkCalculated
      FieldName = 'DescricaoSituacao'
      Size = 50
      Calculated = True
    end
    object qrySelecaoConferenciadigitado: TBooleanField
      FieldName = 'digitado'
    end
    object qrySelecaoConferenciafilial: TIntegerField
      FieldName = 'filial'
      DisplayFormat = '0'
    end
    object qrySelecaoConferenciadatahora_alteracao: TDateTimeField
      FieldName = 'datahora_alteracao'
    end
  end
