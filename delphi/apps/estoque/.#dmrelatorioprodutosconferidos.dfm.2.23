  object qrySelecaoConferencia: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qrySelecaoConferenciaCalcFields
    OnFilterRecord = qrySelecaoConferenciaFilterRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'CondicaoDataDigitacao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListadeFiliaisCTR'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListadeUsuariosCTR'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListadeItemProdutos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListadeProdutos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListadeGrupos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListadeClasses'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListadeMarcas'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListaCondicionalPromocoes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListadeFiliaisNFS'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListadeUsuarios'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListadeFiliaisRequisitada'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListadeFiliaisNFE'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListadeFiliaisLPA'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'select selecao.*'
      'from'
      '('
      ''
      '('
      
        'select coalesce(contrato_atual(ct.numero),ct.numero) as document' +
        'opesquisa, coalesce(contrato_atual(ct.numero),ct.numero) as docu' +
        'mento, cast('#39'CTR'#39' as varchar(3)) as tipo, ct.data,'
      
        '       coalesce(pc.vendedor,ct.vendedor) as usuario, coalesce(u.' +
        'nome,cast('#39'N'#195'O IDENTIFICADO'#39' as varchar(40))) as nome,'
      
        '       pc.produto, pc.filial, p.descricao, pcf.lido, pc.quantida' +
        'de,'
      '       coalesce(pcf.lido,0)*100/pc.quantidade as percentual,'
      
        '       cast(null as varchar(2)) as situacao, pcf.digitado, pcf.d' +
        'atahora_alteracao'
      'from (contratos ct'
      '      join ((produtoscontratos pc'
      '            join usuarios u'
      '            on pc.vendedor = u.codigo)'
      
        '            join ((produtos p left join promocoes pro on p.promo' +
        'cao = pro.codigo)'
      '                  join (((caracteristicas c'
      '                          join classes cl'
      '                          on c.classe=cl.codigo)'
      '                          join grupos g'
      '                          on g.codigo=c.grupo)'
      '                          join marcas m'
      '                          on c.marca = m.codigo)'
      '                  on p.caracteristica=c.codigo)'
      ''
      '            on pc.produto = p.codigo)'
      '      on pc.contrato=ct.numero)'
      '      left join (conferencia cf'
      '                 join produtosconferencia pcf'
      '                 on cf.tipo = pcf.tipo'
      '                 and cf.codigo = pcf.codigo'
      '                 and cf.tipo = '#39'CTR'#39')'
      '      on ct.numero = cf.codigo'
      '      and pc.produto = pcf.produto'
      ''
      'where :TipoContrato'
      '  and ct.data between :datainicial and :datafinal'
      '  and ct.origem is null'
      '  and ct.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39')'
      '  %CondicaoDataDigitacao'
      '  %ListadeFiliaisCTR'
      '  %ListadeUsuariosCTR'
      '  %ListadeItemProdutos'
      '  %ListadeProdutos'
      '  %ListadeGrupos'
      '  %ListadeClasses'
      '  %ListadeMarcas'
      '  %ListaCondicionalPromocoes'
      ''
      ')'
      ''
      'union ALL'
      ''
      '('
      
        'select cast(df.numero as varchar(20)) as documentopesquisa, cast' +
        '(df.nrdocumento as varchar(20)) as documento, cast('#39'NFS'#39' as varc' +
        'har(3)) as tipo, df.data,'
      
        '       coalesce(cf.usuario,cast(0 as integer)) as usuario,  coal' +
        'esce(u.nome,cast('#39'N'#195'O IDENTIFICADO'#39' as varchar(40))) as nome,'
      
        '       pdf.produto, pdf.filial, p.descricao, pcf.lido, pdf.quant' +
        'idade,'
      '       coalesce(pcf.lido,0)*100/pdf.quantidade as percentual,'
      
        '       cast(null as varchar(2)) as situacao, pcf.digitado, pcf.d' +
        'atahora_alteracao'
      'from (dadosfiscais df'
      '      join (produtosdadosfiscais pdf'
      
        '            join ((produtos p left join promocoes pro on p.promo' +
        'cao = pro.codigo)'
      '                  join (((caracteristicas c'
      '                          join classes cl'
      '                          on c.classe=cl.codigo)'
      '                          join grupos g'
      '                          on g.codigo=c.grupo)'
      '                          join marcas m'
      '                          on c.marca = m.codigo)'
      '                  on p.caracteristica=c.codigo)'
      ''
      '            on pdf.produto = p.codigo)'
      '      on df.numero = pdf.dadofiscal)'
      '      left join ((conferencia cf'
      '                 join produtosconferencia pcf'
      '                 on cf.tipo = pcf.tipo'
      '                 and cf.codigo = pcf.codigo'
      '                 and cf.tipo = '#39'NFS'#39')'
      '                 join usuarios u'
      '                 on cf.usuario = u.codigo)'
      '      on df.numero = cast(cf.codigo as integer)'
      '      and pdf.produto = pcf.produto'
      ''
      'where :TipoNotaSaida'
      '  and df.data between :datainicial and :datafinal'
      '  and df.situacao = '#39'N'#39
      '  %CondicaoDataDigitacao'
      '  %ListadeFiliaisNFS'
      '  %ListadeUsuarios'
      '  %ListadeItemProdutos'
      '  %ListadeProdutos'
      '  %ListadeGrupos'
      '  %ListadeClasses'
      '  %ListadeMarcas'
      '  %ListaCondicionalPromocoes'
      ''
      ''
      ')'
      ''
      'union ALL'
      ''
      '('
      
        'select cast(df.numero as varchar(20)) as documentopesquisa, cast' +
        '(df.nrdocumento as varchar(20)) as documento, cast('#39'NST'#39' as varc' +
        'har(3)) as tipo, df.data,'
      
        '       coalesce(cf.usuario,cast(0 as integer)) as usuario,  coal' +
        'esce(u.nome,cast('#39'N'#195'O IDENTIFICADO'#39' as varchar(40))) as nome,'
      
        '       pdf.produto, pdf.filial, p.descricao, pcf.lido, pdf.quant' +
        'idade,'
      '       coalesce(pcf.lido,0)*100/pdf.quantidade as percentual,'
      
        '       cast(null as varchar(2)) as situacao, pcf.digitado, pcf.d' +
        'atahora_alteracao'
      'from (dadosfiscais df'
      '      join (produtosdadosfiscais pdf'
      
        '            join ((produtos p left join promocoes pro on p.promo' +
        'cao = pro.codigo)'
      '                  join (((caracteristicas c'
      '                          join classes cl'
      '                          on c.classe=cl.codigo)'
      '                          join grupos g'
      '                          on g.codigo=c.grupo)'
      '                          join marcas m'
      '                          on c.marca = m.codigo)'
      '                  on p.caracteristica=c.codigo)'
      ''
      '            on pdf.produto = p.codigo)'
      '      on df.numero = pdf.dadofiscal)'
      '      left join ((conferencia cf'
      '                 join produtosconferencia pcf'
      '                 on cf.tipo = pcf.tipo'
      '                 and cf.codigo = pcf.codigo'
      '                 and cf.tipo = '#39'NST'#39')'
      '                 join usuarios u'
      '                 on cf.usuario = u.codigo)'
      '      on df.numero = cast(cf.codigo as integer)'
      '      and pdf.produto = pcf.produto'
      ''
      'where :TipoNotaSaidaTransferencia'
      '  and df.data between :datainicial and :datafinal'
      '  and df.situacao = '#39'N'#39
      
        '  and (ehnotafiscalsaidatransferencia(coalesce(pdf.codigofiscal,' +
        ' df.codigofiscal)) or '
      
        '       ehnotafiscalsaidavenda(coalesce(pdf.codigofiscal, df.codi' +
        'gofiscal)))'
      '       '
      '  and df.tipocliente = '#39'L'#39'     '
      '       '
      '  '
      '  %CondicaoDataDigitacao'
      '  %ListadeFiliaisNFS'
      '  %ListadeUsuarios'
      '  %ListadeItemProdutos'
      '  %ListadeProdutos'
      '  %ListadeGrupos'
      '  %ListadeClasses'
      '  %ListadeMarcas'
      '  %ListaCondicionalPromocoes'
      ''
      ''
      ')'
      ''
      'union ALL'
      ''
      '('
      
        'select cast(lt.codigo as varchar(20)) as documentopesquisa, cast' +
        '(lt.codigo as varchar(20)) as documento, cast('#39'TRF'#39' as varchar(3' +
        ')) as tipo, cast(pf.data as date) as data,'
      
        '       coalesce(cf.usuario,cast(0 as integer)) as usuario,  coal' +
        'esce(u.nome,cast('#39'N'#195'O IDENTIFICADO'#39' as varchar(40))) as nome,'
      
        '       pf.produto, pf.requisitada as filial, p.descricao, pcf.li' +
        'do, pf.qtderecebida as quantidade,'
      ''
      '       case when coalesce(pf.qtderecebida,0)<>0 then'
      '         coalesce(pcf.lido,0)*100/pf.qtderecebida'
      '       else 0.00 end as percentual,'
      ''
      
        '       cast(null as varchar(2)) as situacao, pcf.digitado, pcf.d' +
        'atahora_alteracao'
      'from (lotestransferencia lt'
      '      join (pedidosfiliais pf'
      
        '            join ((produtos p left join promocoes pro on p.promo' +
        'cao = pro.codigo)'
      '                  join (((caracteristicas c'
      '                          join classes cl'
      '                          on c.classe=cl.codigo)'
      '                          join grupos g'
      '                          on g.codigo=c.grupo)'
      '                          join marcas m'
      '                          on c.marca = m.codigo)'
      '                  on p.caracteristica=c.codigo)'
      '            on pf.produto = p.codigo)'
      '      on lt.codigo = pf.lotetransferencia)'
      '      left join ((conferencia cf'
      '                 join produtosconferencia pcf'
      '                 on cf.tipo = pcf.tipo'
      '                 and cf.codigo = pcf.codigo'
      '                 and cf.tipo = '#39'TRF'#39')'
      '                 join usuarios u'
      '                 on cf.usuario = u.codigo)'
      '      on lt.codigo = cast(cf.codigo as integer)'
      '      and pf.produto = pcf.produto'
      ''
      'where :TipoTransferencia'
      
        '  and cast(lt.datahora as date) between :datainicial and :datafi' +
        'nal'
      '  %CondicaoDataDigitacao'
      '  %ListadeFiliaisRequisitada'
      '  %ListadeUsuarios'
      ''
      '  %ListadeItemProdutos'
      '  %ListadeProdutos'
      '  %ListadeGrupos'
      '  %ListadeClasses'
      '  %ListadeMarcas'
      '  %ListaCondicionalPromocoes'
      ''
      ''
      ')'
      ''
      'union all'
      ''
      '('
      
        'select cast(np.codigo as varchar(20)) as documentopesquisa, cast' +
        '(np.numero as varchar(20)) as documento, cast('#39'NFE'#39' as varchar(3' +
        ')) as tipo, np.data,'
      
        '       coalesce(cf.usuario,cast(0 as integer)) as usuario, coale' +
        'sce(u.nome,cast('#39'N'#195'O IDENTIFICADO'#39' as varchar(40))) as nome,'
      
        '       pnp.produto, pnp.filial, p.descricao, pcf.lido, pnp.quant' +
        'idade,'
      '       coalesce(pcf.lido,0)*100/pnp.quantidade as percentual,'
      
        '       cast(null as varchar(2)) as situacao, pcf.digitado, pcf.d' +
        'atahora_alteracao'
      'from (notaspag np'
      '      join (produtosnotaspag pnp'
      
        '            join ((produtos p left join promocoes pro on p.promo' +
        'cao = pro.codigo)'
      '                  join (((caracteristicas c'
      '                          join classes cl'
      '                          on c.classe=cl.codigo)'
      '                          join grupos g'
      '                          on g.codigo=c.grupo)'
      '                          join marcas m'
      '                          on c.marca = m.codigo)'
      '                  on p.caracteristica=c.codigo)'
      '            on pnp.produto = p.codigo)'
      '      on np.codigo = pnp.codigonota)'
      ''
      '      left join ((conferencia cf'
      '                 join produtosconferencia pcf'
      '                 on cf.tipo = pcf.tipo'
      '                 and cf.codigo = pcf.codigo'
      '                 and cf.tipo = '#39'NFE'#39')'
      '                 join usuarios u'
      '                 on cf.usuario = u.codigo)'
      '      on np.codigo = cast(somentenumero(cf.codigo) as integer)'
      '      and pnp.produto = pcf.produto'
      ''
      'where :TipoNotaEntrada'
      '  and np.data between :datainicial and :datafinal'
      '  and np.situacao = '#39'N'#39
      '  %CondicaoDataDigitacao'
      ''
      '  %ListadeFiliaisNFE'
      '  %ListadeUsuarios'
      ''
      '  %ListadeItemProdutos'
      '  %ListadeProdutos'
      '  %ListadeGrupos'
      '  %ListadeClasses'
      '  %ListadeMarcas'
      '  %ListaCondicionalPromocoes'
      ''
      ''
      ')'
      ''
      ''
      'union all'
      ''
      '('
      ''
      
        'select cast(lp.codigo as varchar(20)) as documentopesquisa, cast' +
        '(lp.codigo as varchar(20)) as documento, cast('#39'LPA'#39' as varchar(3' +
        ')) as tipo, cast(lp.datahora as date) as data,'
      
        '       coalesce(cf.usuario,cast(0 as integer)) as usuario, coale' +
        'sce(u.nome,cast('#39'N'#195'O IDENTIFICADO'#39' as varchar(40))) as nome,'
      
        '       plp.produto, lp.filial, p.descricao, pcf.lido, cast(1 as ' +
        'numeric(11,3)) as quantidade,'
      '       coalesce(pcf.lido,0)*100/1 as percentual,'
      
        '       cast(null as varchar(2)) as situacao, pcf.digitado, pcf.d' +
        'atahora_alteracao'
      'from (listaspadrao lp'
      '      join (produtoslistaspadrao plp'
      
        '            join ((produtos p left join promocoes pro on p.promo' +
        'cao = pro.codigo)'
      '                  join (((caracteristicas c'
      '                          join classes cl'
      '                          on c.classe=cl.codigo)'
      '                          join grupos g'
      '                          on g.codigo=c.grupo)'
      '                          join marcas m'
      '                          on c.marca = m.codigo)'
      '                  on p.caracteristica=c.codigo)'
      '            on plp.produto = p.codigo)'
      '      on lp.codigo = plp.listapadrao)'
      ''
      '      left join ((conferencia cf'
      '                 join produtosconferencia pcf'
      '                 on cf.tipo = pcf.tipo'
      '                 and cf.codigo = pcf.codigo'
      '                 and cf.tipo = '#39'LPA'#39')'
      '                 join usuarios u'
      '                 on cf.usuario = u.codigo)'
      '      on lp.codigo = cast(somentenumero(cf.codigo) as integer)'
      '      and plp.produto = pcf.produto'
      ''
      'where :TipoListaPadrao'
      
        '  and cast(lp.datahora as date) between :datainicial and :datafi' +
        'nal'
      '  %CondicaoDataDigitacao'
      ''
      '  %ListadeFiliaisLPA'
      '  %ListadeUsuarios'
      ''
      '  %ListadeItemProdutos'
      '  %ListadeProdutos'
      '  %ListadeGrupos'
      '  %ListadeClasses'
      '  %ListadeMarcas'
      '  %ListaCondicionalPromocoes'
      ''
      ''
      ')'
      ''
      ''
      ') as selecao'
      'order by nome, usuario, data, tipo, documento, documentopesquisa'
      ''
      ''
      '/*'
      ''
      ':datahora_inicial_alteracao'
      ':datahora_final_alteracao'
      ''
      '*/')
    RequestLive = True
    Left = 216
    Top = 112
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'TipoContrato'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'TipoNotaSaida'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'TipoNotaSaidaTransferencia'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'TipoTransferencia'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'TipoNotaEntrada'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'TipoListaPadrao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datahora_inicial_alteracao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datahora_final_alteracao'
        ParamType = ptUnknown
      end>
    object qrySelecaoConferenciadocumento: TStringField
      FieldName = 'documento'
    end
    object qrySelecaoConferenciatipo: TStringField
      FieldName = 'tipo'
      Size = 3
    end
    object qrySelecaoConferenciadata: TDateField
      Alignment = taCenter
