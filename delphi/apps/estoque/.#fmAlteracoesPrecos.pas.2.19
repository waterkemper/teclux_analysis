procedure TfrmAlteracoesPrecos.dbgAlteracoesPrecosGetCellColor(
  Sender: TObject; ARow, ACol: Integer; AState: TGridDrawState;
  ABrush: TBrush; AFont: TFont);
begin
  inherited;    

  if ARow > 0 then
    with TDBAdvGrid(sender) do
    begin
      if (ARow MOD 2)=0 then
        if not (gdSelected in AState) then
{           if (ABrush.Color = clwindow) or
              (TColorRef(Brush.Color) = TColorRef(strtoint(parsistema.CorZebradoRelatorio))) then
              }
                 ABrush.Color := TColorRef(strtoint(parsistema.CorZebradoRelatorio));
    end;

end;

procedure TfrmAlteracoesPrecos.dbgAlteracoesPrecosVPGetCellColor(
  Sender: TObject; ARow, ACol: Integer; AState: TGridDrawState;
  ABrush: TBrush; AFont: TFont);
begin
  inherited;
  if ARow > 0 then
    with TDBAdvGrid(sender) do
    begin
      if (ARow MOD 2)=0 then
        if not (gdSelected in AState) then
        begin
        {
           if (ABrush.Color = clwindow) or
              (TColorRef(Brush.Color) = TColorRef(strtoint(parsistema.CorZebradoRelatorio))) then
              }
                 ABrush.Color := TColorRef(strtoint(parsistema.CorZebradoRelatorio));
        end;
    end;

end;

procedure TfrmAlteracoesPrecos.dbgAlteracoesPrecosCanClickCell(
  Sender: TObject; ARow, ACol: Integer; var Allow: Boolean);
begin
  inherited;

  Allow := true;


end;

procedure TfrmAlteracoesPrecos.dbgAlteracoesPrecosCellChanging(
  Sender: TObject; OldRow, OldCol, NewRow, NewCol: Integer;
  var Allow: Boolean);
begin
  inherited;
  Allow := true;
  if newCol > (dbgAlteracoesPrecos.columnbyfieldname['margematual'].index+1) then
  begin
    if dbgAlteracoesPrecos.fixedcols <> 9 then
      dbgAlteracoesPrecos.fixedcols := 9;
  end
  else
  begin
    if dbgAlteracoesPrecos.fixedcols <> 1 then
      dbgAlteracoesPrecos.fixedcols := 1;
  end;

end;

procedure TfrmAlteracoesPrecos.dbgAlteracoesPrecosClickCell(
  Sender: TObject; ARow, ACol: Integer);
begin

  if not (Acol > (dbgAlteracoesPrecos.columnbyfieldname['margematual'].index+1)) then
  begin
    if dbgAlteracoesPrecos.fixedcols <> 1 then
    begin
      vLinhaClicada := aRow;
      vColunaClicada := aCol;

      dbgAlteracoesPrecos.col := dbgAlteracoesPrecos.columnbyfieldname['margematual'].index;

      dbgAlteracoesPrecos.col := vColunaclicada;
      dbgAlteracoesPrecos.row := vlinhaclicada;

    end;
  end;

  inherited;

end;

procedure TfrmAlteracoesPrecos.sbnManutencaoPrecoClick(Sender: TObject);
var
  vTMessageButton : TMessageButton;

begin
  inherited;

  if dbgAlteracoesPrecos.datasource.dataset.recordCount<>0 then
     vTMessageButton := MensagemSelecionaOpcao('Fazer a manutenção de preço de todos os produto?')
  else
     vTMessageButton := smbNO;

  case vTMessageButton of
     smbYES    :  tfrmManutencaoPreco.create(self).fraMultiplaSelecaoAleatoria1.
                    fraSelecaoAleatoriaItemdeProdutos.
                    fraSelecaoAleatoriaItemdeProduto.AdicionarListaItemNaLista
                    (RetornarListaTString(

                      TtecQuery(dbgAlteracoesPrecos.datasource.dataset),

                      dbgAlteracoesPrecos.datasource.dataset.fieldbyname('produto'),

                      nil, True));

     smbNO     :  tfrmManutencaoPreco.create(self).
                  fraMultiplaSelecaoAleatoria1.
                  fraSelecaoAleatoriaItemdeProdutos.
                  fraSelecaoAleatoriaItemdeProduto.AdicionarItemNaLista
                  (dbgAlteracoesPrecos.datasource.dataset.fieldbyname('produto').asString);
     smbCancel :
  end;

end;

end.

