procedure TfrmAlteracoesPrecos.sbnGerarClick(Sender: TObject);
var
i: integer;
begin
  inherited;
  if fraIntervaloDatas.edtDataInicial.text = '' then
  begin
    MensagemAviso('Informe a data inicial.');
    fraIntervaloDatas.edtDataInicial.setfocus;
  end
  else
  if fraIntervaloDatas.edtDataFinal.text = '' then
  begin
    MensagemAviso('Informe a data final.');
    fraIntervaloDatas.edtDataFinal.SetFocus;
  end
  {
  else
  if ((fraMultiplaSelecaoAleatoriAProdutos.fraSelecaoAleatoriaItemdeProdutos.ListaCondicional)='') and
     ((fraMultiplaSelecaoAleatoriAProdutos.fraSelecaoAleatoriaprodutos.ListaCondicional)='') then
  begin
    MensagemAviso('Informe pelo menos um ou mais itens na lista de produtos.');
    fraMultiplaSelecaoAleatoriAProdutos.fraSelecaoAleatoriaItemdeProdutos.fraSelecaoAleatoriaItemdeProduto.dbgSelecaoAleatoria.setfocus;
  end
  }
  else
  begin

    dbgAlteracoesPrecos.onGetCellColor := nil;

    dbgAlteracoesPrecos.onCellChanging := nil;

    dbgAlteracoesPrecos.Columns.clear;
    dbgAlteracoesPrecos.datasource := nil;

    dtmAlteracoesPrecos.AbrirConsulta(
    fraIntervaloDatas.edtDataInicial.text,
    fraIntervaloDatas.edtDataFinal.text,
    
    edtIntervaloInicial.Text,
    edtIntervaloFinal.Text,
    edtIntervaloNotaInicial.Text,
    edtIntervaloNotaFinal.Text,

      edtMargemLucro.text,
      edtVariancaoPrecoAtualeAnteior.text,
      ComboComparisonOperator.text,

      fraMultiplaSelecaoAleatoriAProdutos.fraSelecaoAleatoriaItemdeProdutos.ListaCondicional,
      fraMultiplaSelecaoAleatoriAProdutos.fraSelecaoAleatoriaprodutos.ListaCondicional,
      fraMultiplaSelecaoAleatoriAProdutos.fraSelecaoaleatoriagruposprodutos.ListaCondicional,
      fraMultiplaSelecaoAleatoriAProdutos.fraSelecaoaleatoriaclassesprodutos.ListaCondicional,
      fraMultiplaSelecaoAleatoriAProdutos.fraSelecaoAleatoriamarcasProdutos.ListaCondicional,

      fraMultiplaSelecaoAleatoriAProdutos.fraSelecaoaleatoriaPromocoes.ListaCondicional,
      fraMultiplaSelecaoAleatoriAProdutos.fraSelecaoAleatoriacst.ListaCondicional,
      fraMultiplaSelecaoAleatoriAProdutos.fraSelecaoAleatoriacsosn.ListaCondicional,
      fraMultiplaSelecaoAleatoriAProdutos.fraSelecaoaleatorialistaspadronizadas.ListaCondicional,

      fraSelecaoAleatoriaFornecedores.ListaCondicional,

      fraSelecaoAleatorianotas1.ListaCondicional,

      ckbProdutoEmLinha.checked,
      ckbProdutoForadeLinha.checked,

      ckbProdutoAtivo.checked,
      ckbProdutoInativo.checked,

      ckbProdutoComMontagem.Checked,
      ckbProdutoSemMontagem.Checked,

      ckbProdutoBrinde.Checked,
      ckbProdutoNaoBrinde.Checked,

      ckbDisponivelnoSite.checked,
      ckbNaoDisponivelnoSite.checked,
      ckbSomentecomEstoque.checked,
      ckbSomentePrecoNormal.checked,

      fraConsultaFilial.edfcodigo.text,
      fraConsultaTipoMovimentacao.edfcodigo.text,

//      fraConsultaColuna.edfcodigo.text,
//      fraConsultaFilialPreco.edfCodigo.text,

//      rgbPrecos.itemindex,
//      ckbPrecosDiferenciados.checked,

      cbbCompostos.itemIndex,
      rgbOrdenacao.itemindex


      );

    if dtmAlteracoesPrecos.qryAlteracoesPrecosCargos.RecordCount <> 0 then
    begin

      dbgAlteracoesPrecos.datasource := dtmAlteracoesPrecos.dsrAlteracoesPrecosCargos;
      dbgAlteracoesPrecos.onGetCellColor := dbgAlteracoesPrecosGetCellColor;

      dbgAlteracoesPrecos.onCellChanging := dbgAlteracoesPrecosCellChanging;
    (*
      dbgAlteracoesPrecos.HideColumn(7); //cargo
      dbgAlteracoesPrecos.HideColumn(5); //preco
      dbgAlteracoesPrecos.HideColumn(2); //prodtuo
      dbgAlteracoesPrecos.HideColumn(1); //identificador
      *)

      for i:= 15 to (dbgAlteracoesPrecos.ColCount)-1  do
      begin
        dbgAlteracoesPrecos.Columns[i].FloatFormat := '%.2n';
        dbgAlteracoesPrecos.Columns[i].Width := dbgAlteracoesPrecos.Columns[i].Width + 13;
      end;

     dbgAlteracoesPrecos.ColumnByFieldName['produtovisual'].Header := 'Produto';
     dbgAlteracoesPrecos.ColumnByFieldName['produtovisual'].width := 90;

     dbgAlteracoesPrecos.ColumnByFieldName['descricao_produto'].Header := 'Descrição do Produto';
     dbgAlteracoesPrecos.ColumnByFieldName['descricao_produto'].width := 250;

     dbgAlteracoesPrecos.ColumnByFieldName['descricao_preco'].Header := 'Descrição do Preço';
     dbgAlteracoesPrecos.ColumnByFieldName['descricao_preco'].width := 100;

     dbgAlteracoesPrecos.ColumnByFieldName['descricao_cargo'].Header := 'Descrição do Cargo';
     dbgAlteracoesPrecos.ColumnByFieldName['descricao_cargo'].width := 128;

     dbgAlteracoesPrecos.ColumnByFieldName['datacompra'].Header := 'Últ. Compra';
     dbgAlteracoesPrecos.ColumnByFieldName['datacompra'].width := dbgAlteracoesPrecos.ColumnByFieldName['datacompra'].width + 13;

     dbgAlteracoesPrecos.ColumnByFieldName['valoranterior'].Header := 'Preço Anter.';
     dbgAlteracoesPrecos.ColumnByFieldName['valoranterior'].width := dbgAlteracoesPrecos.ColumnByFieldName['valoranterior'].width + 10;
     dbgAlteracoesPrecos.ColumnByFieldName['valoranterior'].FloatFormat := '%.2n';

     dbgAlteracoesPrecos.ColumnByFieldName['valoratual'].Header := 'Preço Atual';
     dbgAlteracoesPrecos.ColumnByFieldName['valoratual'].width := dbgAlteracoesPrecos.ColumnByFieldName['valoratual'].width + 10;
     dbgAlteracoesPrecos.ColumnByFieldName['valoratual'].FloatFormat := '%.2n';

     dbgAlteracoesPrecos.ColumnByFieldName['trigger_user_preco_atual'].Header := 'Alterado por';
     dbgAlteracoesPrecos.ColumnByFieldName['trigger_user_preco_atual'].width := 80;

     dbgAlteracoesPrecos.ColumnByFieldName['diferenca'].Header := 'Diferença';
     dbgAlteracoesPrecos.ColumnByFieldName['diferenca'].width := dbgAlteracoesPrecos.ColumnByFieldName['diferenca'].width + 10;
     dbgAlteracoesPrecos.ColumnByFieldName['diferenca'].FloatFormat := '%.2n';

     dbgAlteracoesPrecos.ColumnByFieldName['margematual'].Header := 'Margem';
     dbgAlteracoesPrecos.ColumnByFieldName['margematual'].width := dbgAlteracoesPrecos.ColumnByFieldName['margematual'].width + 5;
     dbgAlteracoesPrecos.ColumnByFieldName['margematual'].FloatFormat := '%.2n';


//      dbgAlteracoesPrecos.fixedcols := 9;

      tstDados.tabvisible := true;
      pgcAlteracoesPrecos.ActivePage := tstDados;

{      dbgAlteracoesPrecos.filteractive := true;}

    end
    else
    begin
      mensagemaviso(format(ctNENHUMREGISTROENCONTRADO, ['registro']));
      tstDados.tabvisible := false;
    end;

  end;





end;

procedure TfrmAlteracoesPrecos.dbgAlteracoesPrecosGetColumnFilter(
  Sender: TObject; Column: Integer; Filter: TStrings);
begin
  inherited;
                 (*
  if (column = 12 {dbgAlteracoesPrecos.ColumnByFieldName['margematual'].Index}) then
  begin
    Filter.clear;
    Filter.Add('Clear');
    Filter.Add('<=0');
    Filter.Add('<=10');
    Filter.Add('<=20');
    Filter.Add('<=30');
    Filter.Add('<=40');
    Filter.Add('<=50');
    Filter.Add('<=60');
    Filter.Add('<=70');
    Filter.Add('<=80');
    Filter.Add('<=90');
    Filter.Add('<=100');
  end;

  *)
  {
  if (Column in [1,2]) then
    Filter.Clear;
    }
end;

procedure TfrmAlteracoesPrecos.Pesquizar1Click(Sender: TObject);
begin
  inherited;
  AdvGridFindDialog1.Execute;
end;

procedure TfrmAlteracoesPrecos.ExportarExcel1Click(Sender: TObject);
begin
  inherited;
  AdvGridExcelIO1.XLSExport(ExtractFilePath(Application.ExeName) + 'Saidas\Alteracoes_de_Preco.xls', 'Alteracoes_dePreco');
end;

procedure TfrmAlteracoesPrecos.sbnVisualizarFotoClick(Sender: TObject);
begin
  inherited;
  AcionarTelaVisualizarImageURL(self, dtmAlteracoesPrecos.GetProduto);
end;

procedure TfrmAlteracoesPrecos.Timer1Timer(Sender: TObject);
begin
  inherited;
  sbnVisualizarFoto.visible := (pgcAlteracoesPrecos.activepage = tstDados) and
     (dtmAlteracoesPrecos.qryAlteracoesPrecosCargos.recordcount<>0);

  sbnVisualizarDetalhesProdutosNota.visible := sbnVisualizarFoto.visible;
  sbnProdutos.visible := sbnVisualizarFoto.visible;

  tstMultiplasSelecoesProdutos.Highlighted := fraMultiplaSelecaoAleatoriaProdutos.tstItemdeProduto.Highlighted or
                                              fraMultiplaSelecaoAleatoriaProdutos.tstProduto.Highlighted or
                                              fraMultiplaSelecaoAleatoriaProdutos.tstSelecaoAleatoriaGrupoProduto.Highlighted or
                                              fraMultiplaSelecaoAleatoriaProdutos.tstSelecaoAleatoriaClasseProduto.Highlighted or
                                              fraMultiplaSelecaoAleatoriaProdutos.tstSelecaoAleatoriaMarcaProduto.Highlighted or
                                              fraMultiplaSelecaoAleatoriaProdutos.tstSelecaoAleatoriaPromocoes.Highlighted or
                                              fraMultiplaSelecaoAleatoriaProdutos.tstSelecaoAleatoriamodelosProduto.Highlighted or
                                              fraMultiplaSelecaoAleatoriaProdutos.tstSelecaoAleatoriaPromocoes.Highlighted or
                                              fraMultiplaSelecaoAleatoriaProdutos.tstCST.Highlighted or
                                              fraMultiplaSelecaoAleatoriaProdutos.tstCSOSN.Highlighted or
                                              fraMultiplaSelecaoAleatoriaProdutos.tstListaPadronizada.Highlighted;

  tstMultiplasSelecoesFornecedores.Highlighted := (fraSelecaoAleatoriaFornecedores.fraSelecaoAleatoriaCliente.qryselecaoaleatoria.recordcount <> 0);

  tstListadeNotasFiscais.Highlighted := (fraSelecaoAleatorianotas1.fraSelecaoAleatorianotas.qryselecaoaleatoria.recordcount <> 0) or
                                        (edtIntervaloNotaInicial.text<>'') or
                                        (edtIntervaloNotaFinal.text<>'');

end;

