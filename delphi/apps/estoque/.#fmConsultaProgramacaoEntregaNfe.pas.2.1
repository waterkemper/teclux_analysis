procedure TfrmConsultaProgramacaoEntregaNfe.dbaProgramacaoEntregaNfeDblClick(
  Sender: TObject);
begin
  inherited;
  {
  if (dbaProgramacaoEntregaNfe.ColumnByFieldName['recebido'].Index - 1) =
     dbaProgramacaoEntregaNfe.Col then
  begin

    dtmConsultaProgramacaoEntregaNfe.qryProgramacaoEntregaNfe.edit;
    dtmConsultaProgramacaoEntregaNfe.qryProgramacaoEntregaNferecebido.asBoolean :=
      not dtmConsultaProgramacaoEntregaNfe.qryProgramacaoEntregaNferecebido.asBoolean;
    dtmConsultaProgramacaoEntregaNfe.qryProgramacaoEntregaNfe.post;

    AGrupamento;

  end;
  }

