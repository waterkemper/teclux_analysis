procedure TfrmConsultaProgramacaoEntregaNfe.dbaProgramacaoEntregaNfeCheckBoxChange(
  Sender: TObject; ACol, ARow: Integer; State: Boolean);
begin
  inherited;

  if Acol = (dbaProgramacaoEntregaNfe.ColumnByFieldName['recebido'].Index - 1) then
  begin
    if dtmConsultaProgramacaoEntregaNfe.qryProgramacaoEntregaNfe.Locate(
      'pedido;serie;nrnfe',
      VarArrayOf([
        dbaProgramacaoEntregaNfe.Cells[dbaProgramacaoEntregaNfe.ColumnByFieldName['pedido'].Index-1, Arow],
        dbaProgramacaoEntregaNfe.Cells[dbaProgramacaoEntregaNfe.ColumnByFieldName['serie'].Index-1, Arow],
        dbaProgramacaoEntregaNfe.Cells[dbaProgramacaoEntregaNfe.ColumnByFieldName['nrnfe'].Index-1, Arow]]),[]) then
      dtmConsultaProgramacaoEntregaNfe.MarcarRecebido(State);
  end;

end;

