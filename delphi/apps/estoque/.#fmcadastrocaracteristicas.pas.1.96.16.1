procedure TfrmCadastroCaracteristicas.VerificarProdutosFornecedores;
begin
  if (dtmCadastroProdutos.qryProdutoscodigovisual.AsString <>
      dtmcadastroprodutos.qryProdutosFornecedoresprodutovisual.AsString) and
      not dtmcadastroprodutos.qryProdutosFornecedores.isempty then
  begin
    if ConsultaProduto.edfCodigo.Exist then
    begin
      if MensagemConfirmacao(format('Confirma a vinculação deste produto do fornecedor com o item de produto %s', [ConsultaProduto.qryProcuraItemProdutos.FieldByName('produtovisual').AsString])) = smbOK then
      begin
        dtmCadastroProdutos.qryProdutosFornecedores.edit;
        dtmCadastroProdutos.qryProdutosFornecedoresproduto.AsString := ConsultaProduto.qryProcuraItemProdutos.FieldByName('produto').AsString;
        dtmCadastroProdutos.qryProdutosFornecedoresprodutovisual.AsString := ConsultaProduto.qryProcuraItemProdutos.FieldByName('produtovisual').AsString;
        dtmCadastroProdutos.qryProdutosFornecedores.post;
        dtmCadastroProdutos.Perpetrar([dtmCadastroProdutos.qryprodutosfornecedores]);
        dtmCadastroProdutos.RefazConsultaProdutosFornecedores;
      end
      else
      begin
        dtmCadastroProdutos.qryProdutosFornecedores.edit;
        dtmCadastroProdutos.qryProdutosFornecedoresproduto.AsString := dtmCadastroProdutos.qryProdutoscodigo.AsString;
        dtmCadastroProdutos.qryProdutosFornecedoresprodutovisual.AsString := dtmCadastroProdutos.qryProdutoscodigovisual.AsString;
        dtmCadastroProdutos.qryProdutosFornecedores.post;
      end;
    end
    else
      dtmCadastroProdutos.qryProdutosFornecedores.cancel;
  end;
end;

procedure TfrmCadastroCaracteristicas.CondicoesItemProdutosFornecedores;
const
  SQL = 'and (p.codigo not in (%s) or p.codigo = %s)';
