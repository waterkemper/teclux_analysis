function TfrmCadastroCaracteristicas.ExisteInformacao(Parametro: Integer; NomeCampo: String; Value: Variant): Boolean;
begin
  with dtmCadastroProdutos do
    case TipoProcura of
           tpGRUPOS : Result := ExisteGrupo(NomeCampo, Value);
           tpCLASSE : Result := ExisteClasse(NomeCampo, Value);
        tpOBSLEGAIS : Result := ExisteObsLegal(NomeCampo, Value);
         tpUNIDADES : Result := ExisteUnidade(NomeCampo, Value);
              tpIPI : Result := ExisteIPI(NomeCampo, Value);
             tpICMS : Result := ExisteICMS(NomeCampo, Value);
    tpdescricaonanf : Result := ExisteDescricaonaNF(NomeCampo, Value);
           tpMARCAS : Result := ExisteMarca(NomeCampo, Value);
  tpCARACTERISTICAS : Result := ExisteCaracteristica(NomeCampo, Value);
          tpORIGENS : Result := ExisteOrigem(NomeCampo, Value);
      tpINCIDENCIAS : Result := ExisteIncidencia(NomeCampo, Value);
          tpFATORES : Result := ExisteFatoresPreco(NomeCampo, Value);
      tpLINHAGRADE,
      tpCOLUNAGRADE : Result := ExisteGrade(NomeCampo, Value);
    tpDebitarVendaaVista,
    tpCreditarVendaaVista,
    tpDebitarVendaaPrazo,
    tpCreditarVendaaPrazo,
    tpDebitarAbatimentos,
    tpCreditarAbatimentos,
    tpDebitarDevolucoes,
    tpCreditarDevolucoes : Result:= ExisteContaContabil(NomeCampo, Value);
    tpHistoricoVendaaVista,
    tpHistoricoVendaaPrazo,
    tpHistoricoAbatimentos,
    tpHistoricoDevolucoes : Result := ExisteHistorico(NomeCampo, Value)
      else
        Result := False;
    end;
end;

function TfrmCadastroCaracteristicas.InternoExcluir: Boolean;
