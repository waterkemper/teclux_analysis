procedure TfrmCadastroCaracteristicas.DBGridProdutos_ServicosKeyDown(
  Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;

  if (Shift = [ssCtrl]) and
     ((key = TeclaEditarRegistro) or
      (key = TeclaInserirRegistro)) then
  begin
    case Key of
      TeclaEditarRegistro  :
      begin
        if DBGridProdutos_Servicos.DataSource.DataSet.RecNo > 0 then
          DBGridProdutos_Servicos.DataSource.DataSet.edit
        else
          DBGridProdutos_Servicos.DataSource.DataSet.append;
      end;
      TeclaInserirRegistro : DBGridProdutos_Servicos.DataSource.DataSet.append;
    end;
  end
  else
  if (DBGridProdutos_Servicos.SelectedField = dtmCadastroProdutos.qryProdutos_Servicosservico) or
     (DBGridProdutos_Servicos.SelectedField = dtmCadastroProdutos.qryProdutos_Servicosdescricao) then
  begin
    if (key = VK_F9) and
       CtrlOn then
    begin
      ConsultaServicos.InternoPesquisar('SERVIÇOS');
      DBGridProdutos_Servicos.SetFocus;
    end
    else
    if key = VK_return then
    begin
      if ConsultaServicos.edfCodigo.Exist then
        AtribuirDadosServicos
    end;
  end;

end;

