    if StrToDate(DataInativa.Text) > dtmCadastroProdutos.DataServidor then
      if MensagemConfirmacao(ctDATASUPERIORAATUAL) = smbCancel then
        DataInativa.SetFocus;
end;

procedure TfrmCadastroCaracteristicas.edfCodigoFound(Found: Boolean);
begin
  inherited;
  if Found then
  begin
    if dtmCadastroProdutos.qryCaracteristicas.RecordCount > 1 then
    begin
      CtrlOn := false;
      dtmCadastroProdutos.vCondicaoDiversasChavesEncontradas := true;
      edfCodigo.setfocus;
      InternoPesquisar('Produto');
      dtmCadastroProdutos.vCondicaoDiversasChavesEncontradas := false;
    end
    else
    begin
      if ParSistema.GerarCodigoProdutoAutomatico or not dtmCadastroProdutos.Inserindo then
        FProdutoJaGravado := True;
//      if dtmCadastroProdutos.Composto then
//        lblTotalComponentesValor.Caption := FormatarValor(dtmCadastroProdutos.TotalComponentes,2);
    end;
  end
  else
    FProdutoJaGravado := False;

  ckbProdutoCompostoClick(nil);
end;

procedure TfrmCadastroCaracteristicas.pgcCaracteristicasChange(Sender: TObject);
begin
  inherited;
  with dtmCadastroProdutos do
  begin
    if (pgcCaracteristicas.ActivePage = tstParametros) or
       (pgcCaracteristicas.ActivePage = tstInformacoesFiscais) or
       (pgcCaracteristicas.ActivePage = tstObservacoes) then
      ExibirCaracteristicas := mcaCARACTERISTICAS
    else if pgcCaracteristicas.ActivePage = tstFornecedores then
    begin
      ExibirCaracteristicas := mcaFORNECEDORES;
      ReFazConsultaFornecedoresProdutos;
    end
    else if pgcCaracteristicas.ActivePage = tstSimilares then
    begin
      ExibirCaracteristicas := mcaSIMILARES;
      ReFazConsultaSimilares;
    end
    else if pgcCaracteristicas.ActivePage = tstPrecos then
    begin
      ExibirCaracteristicas := mcaPRECOS;
      ReFazConsultaPrecos;
    end
    else if pgcCaracteristicas.ActivePage = tstProdutosCargos then
    begin
      SetExibirProduto(mcaPRODUTOSCARGOS);
      RefazConsultaProdutosCargos;
    end;
  end;
end;

procedure TfrmCadastroCaracteristicas.pgcItensProdutoEstoqueChange(Sender: TObject);
begin
  inherited;
  with dtmCadastroProdutos do
  begin
    if pgcItensProdutoEstoque.ActivePage = tstItensProdutos then
    begin
      SetExibirProduto(mcaPRODUTOS);
      ReFazConsultaProdutos;
    end
    else
    if pgcItensProdutoEstoque.ActivePage = tstEstoque then
    begin
      SetExibirProduto(mcaESTOQUES);
      ReFazConsultaEstoques;
    end
    else
    if pgcItensProdutoEstoque.ActivePage = tstProdutosCodigoBarras then
    begin
      SetExibirProduto(mcaCODIGOSBARRAS);
      ReFazConsultaCodigoBarras
    end
    else
    if pgcItensProdutoEstoque.ActivePage = tstComposicao then
    begin
        ExibirProdutoComposto := True;
        ReFazConsultaProdutoComposto;
        ReFazConsultaProduto_Servicos;
{        if (lblTotalComponentesValor.Caption = '') or
           (lblTotalComponentesValor.Caption = '0,00') then
          lblTotalComponentesValor.Caption := FormatarValor(TotalComponentes,2);   }
    end
    else
    if pgcItensProdutoEstoque.ActivePage = tstFios then
    begin
       dtmCadastroProdutos.qryProdutoCompostoFios.After_Open := DBGridProdutosFios.RefazerOrdenacaoSequencial;
       ExibirProdutoComposto := True;
       ReFazConsultaProdutoCompostoFios;
    end
    else
    if pgcItensProdutoEstoque.ActivePage = tstFitas then
    begin
       dtmCadastroProdutos.qryProdutoCompostoFitas.After_Open := DBGridProdutosFitas.RefazerOrdenacaoSequencial;
       ExibirProdutoComposto := True;
       ReFazConsultaProdutoCompostoFitas;
    end
    else
    if pgcItensProdutoEstoque.ActivePage = tstClientes then
    begin
      SetExibirProduto(mcaCLIENTEs);
      ReFazConsultaClientesProdutos;
    end
    else
    if pgcItensProdutoEstoque.ActivePage = tstProdutosFornecedores then
      pgcProdutos_Unidades_FornecedoresChange(pgcItensProdutoEstoque)
  end;
end;

