procedure TfrmCadastroCaracteristicas.OperacaoPadrao(
  Value: array of Variant);
begin
  inherited;
  if Value[0] = 'Abrir' then
  begin
    if ((dtmCadastroProdutos.qryCaracteristicas.recordcount = 0) and
        (Value[1]<>0)) or
       ((dtmCadastroProdutos.qryCaracteristicas.recordcount > 0) and
        (Value[1]<>0) and
        (Value[1]<> dtmCadastroProdutos.qryCaracteristicascodigovisual.asString) and
        (MensagemConfirmacao('Abrir o produto '+inttostr(Value[1])) = smbOK)) then
    begin
      if (dtmCadastroProdutos.qryCaracteristicas.state in [dsedit, dsinsert]) then
        dtmCadastroProdutos.qryCaracteristicas.cancel;

      edfCodigo.text := inttostr(Value[1]);
      edfCodigo.exist;
      FProdutoJaGravado := True;
    end;
  end;
end;

