procedure TfrmCadastroCaracteristicas.dbgModelosKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if CtrlOn or (ssCtrl in Shift) then
  begin
    case Key of
      VK_F9 : begin
                 dbgModelos.SetFocus;
                 AcionaPesquisaGrade(pesMODELO);
               end;
    end;
  end
  {
  else
  begin
    case key of
      VK_RETURN,
      VK_Return :
      begin
        case dbgModelos.SelectedIndex of
        0 : begin
              if not fraConsultaModelo.edfCodigo.Exist then
              begin
                dbgModelos.DataSource.DataSet.FieldByName('descricaomodelo').Clear;
                dbgModelos.DataSource.DataSet.FieldByName('especificacao').Clear;
                dtmCadastroProdutos.qryModelosCaracteristicasobservacao.Clear;
              end;
              dbgModelos.SelectedIndex := 0;
              dbgModelos.SetFocus;
            end;
        end;

        if dtmCadastroProdutos.qryModelosCaracteristicas.State in [dsedit, dsinsert] then
           dtmCadastroProdutos.qryModelosCaracteristicas.Post;
      end;
    end;
  end;
  }
end;

procedure TfrmCadastroCaracteristicas.AcionaPesquisaGrade(Pesquisa : TtecPesquisa);
begin
  case Pesquisa of
    pesMODELO :
    begin
      if not assigned(fraConsultaModelo) then
        CriarConsultaModelo;

      fraConsultaModelo.CtrlOn := True;
      fraConsultaModelo.InternoPesquisar('Modelo de Produto');
      dbgModelos.SetFocus;
      dbgModelos.SelectedIndex :=  0;
    end;

    pesCargos:
    begin
      if not assigned(fraConsultaCargo) then
        CriarConsultaCargo;

      fraConsultaCargo.CtrlOn := True;
      fraConsultaCargo.InternoPesquisar('Cargos');
      dbgProdutosCargos.SetFocus;
      dbgProdutosCargos.SelectedIndex :=  0;
    end;

  end;
end;

procedure TfrmCadastroCaracteristicas.AtribuirDadosModelosProdutos;
begin

  if not assigned(fraConsultaModelo) then
    CriarConsultaModelo;

  with fraConsultaModelo do
  begin
    dtmCadastroProdutos.qryModelosCaracteristicasmodelo.AsString :=
      qryProcuraModelo.FieldByName('codigo').AsString;

    dtmCadastroProdutos.qryModelosCaracteristicasdescricaomodelo.AsString :=
      qryProcuraModelo.FieldByName('descricao').AsString;

    dtmCadastroProdutos.qryModelosCaracteristicasespecificacao.AsString :=
      qryProcuraModelo.FieldByName('especificacao').AsString;

    dtmCadastroProdutos.qryModelosCaracteristicasobservacao.AsString :=
      qryProcuraModelo.FieldByName('observacao').AsString;
  end;

end;

