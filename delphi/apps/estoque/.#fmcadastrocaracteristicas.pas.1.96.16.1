function TfrmCadastroCaracteristicas.AcionaCadastroProdutoComposto(
  Editar: Boolean): Boolean;
begin
  Result:= False;
  if not dtmCadastroProdutos.TabelaProduto.IsEmpty then
  begin
    dtmCadastroProdutos.tipoProcuraProdutosEstoque := tpPRODUTOS;
    frmCadastroProdutoComposto := TfrmCadastroProdutoComposto.Create(frmCadastroProdutoComposto);
    with frmCadastroProdutoComposto do
    begin
      DataSet := dtmCadastroProdutos.TabelaProdutoComposto;
      Result:= dtmCadastroProdutos.IncluirProdutoComposto(Editar);
      if ShowModal =  mrOK then
        dtmCadastroProdutos.qryProdutoComposto.RefreshCurrRow;
      free;
    end;
//    lblTotalComponentesValor.Caption := FormatarValor(dtmCadastroProdutos.TotalComponentes,2);
  end
  else
  begin
    MensagemAviso(ctCARACTERISTICASEMPRODUTO);
    DBGridProdutosComponentes.SetFocus;
  end;
end;

