function TfrmCadastroCaracteristicas.InternoGravar: Boolean;
begin
//  pgcCaracteristicas.ActivePage := tstparametros;
  Result := false;
  if dtmCadastroProdutos.ICMSObrigatorio and (dtmCadastroProdutos.ICMS = 0) then
  begin
    MensagemAviso('O campo ICMS é obrigatório e não está preenchido com uma informação válida.');
    pgcCaracteristicas.ActivePage := tstInformacoesFiscais;
{   pgcInformacoesFiscais.ActivePage := tstICMS;}
    flkICMS.SetFocus;
  end
  else
  begin
    Result := inherited InternoGravar;
    if Result then  begin
      if not ParSistema.GerarCodigoProdutoAutomatico then
       if (edfCodigo.Text = '') then begin
         MensagemAviso(ctCODIGONECESSARIO +#13#10+ 'O Campo Código não está preenchido com uma informação válida.');
         Result:= False;
       end;

//       if Result then
//         result := VerificarElementosdaGrade;

       if result then
         FProdutoJaGravado:= dtmCadastroProdutos.GravarCaracteristica;

       if FProdutoJaGravado then
       begin
         if (dbgColunasPrecos.DataSource.DataSet.RecordCount = 0) and
            not ParSistema.UsarGradesProdutos and
            not (dtmCadastroProdutos.NumeroItens>0) and
            AcionaCadastroColunasPrecosAutomatico(False)
             then
           result := dtmCadastroProdutos.CadastroItemAutomatico;
         if edfCodigo.Enabled then
           edfCodigo.SetFocus
         else edtDescricao.SetFocus;
       end;

    end;
  end;
end;

function TfrmCadastroCaracteristicas.InternoIncluir: Boolean;
begin
  Result:= inherited InternoIncluir;
  if Result then
  begin
    if not CtrlOn then begin
      FProdutoJaGravado:= False;
      Result := dtmCadastroProdutos.IncluirCaracteristica;

      pgcCaracteristicas.ActivePage := tstParametros;

      if ParSistema.GerarCodigoProdutoAutomatico then
        fraConsultaTipoProduto.edfcodigo.setfocus
      else edfCodigo.SetFocus;
      
    end
  end;
end;

function TfrmCadastroCaracteristicas.InternoPesquisar(Titulo:String): Integer;
var
  vCodigoaux : String;
begin
  Result := mrNone;
  if PermitirProcura then
  begin
    dtmCadastroProdutos.AbreTabelasConsulta(TipoProcura);
    Result := inherited InternoPesquisar(GetTitulo);
    if Result = mrOK then
    begin
     if TipoProcura = tpCaracteristicas then
     begin
      {Atenção: o componente cpdbfindcontrols não esta alterando a propriedade modified quando por esta selecção e assim não refazendo a pesquisa qryprocuraorigens
       que permite zero, solução: atribuir modified = true quando a seleção for pela pesquisa isto se o codigo for diferente}
      vCodigoAux := edfcodigo.text;
      dtmCadastroProdutos.SelecionarCaracteristica;
      edfcodigo.modified := (vCodigoAux <> dtmCadastroProdutos.qryCaracteristicasCodigo.AsString);
     end
     else
      dtmCadastroProdutos.Selecionar(TipoProcura);
    end
    else
     if ReabrirFormulario then
       InternoPesquisar('');
    dtmCadastroProdutos.FechaTabelasConsulta(TipoProcura);
  end;
  tstComposicao.TabVisible := (dtmCadastroProdutos.qryCaracteristicascomposto.AsBoolean or
                               dtmCadastroProdutos.qryCaracteristicascomposto2.AsBoolean);

  tstFios.TabVisible := (dtmCadastroProdutos.qryCaracteristicascomposto.AsBoolean or
                         dtmCadastroProdutos.qryCaracteristicascomposto2.AsBoolean) and ParSistema.ControlesVoltadosparaIndustria;

  tstFitas.TabVisible := (dtmCadastroProdutos.qryCaracteristicascomposto.AsBoolean or
                          dtmCadastroProdutos.qryCaracteristicascomposto2.AsBoolean) and ParSistema.ControlesVoltadosparaIndustria;

end;

function TfrmCadastroCaracteristicas.JanelaPesquisa: TfrmConsultaBasica;
begin
  if TipoProcura = tpCARACTERISTICAS then
  begin
    if not assigned(JanelaProduto) then
    begin
      JanelaProduto := TfrmConsultaPorCampo.Create(nil);


      JanelaProduto.ConsultaInterativa := False;
      JanelaProduto.UsarParametrosDaTabela:= false;
      JanelaProduto.ExibirUltimoParametro:= true;

      JanelaProduto.ckbOpcional1.Caption := ctITEMPRODUTO;
      JanelaProduto.ckbOpcional1.Visible := true;
      JanelaProduto.ckbOpcional1.OnClick := nil;
      JanelaProduto.ckbOpcional1.OnClick := JanelaProduto.ckbOpcional1Click;


      JanelaProduto.ckbOpcional2.Caption := 'Cliente/PN';
      JanelaProduto.ckbOpcional2.Visible := true;
      JanelaProduto.ckbOpcional2.OnClick := nil;
      JanelaProduto.ckbOpcional2.OnClick := JanelaProduto.ckbOpcional2Click;

      JanelaProduto.gbxSelecionar.visible := true;
      JanelaProduto.cbbOpcao.visible := true;

      JanelaProduto.cbbOpcao.items.clear;
      JanelaProduto.cbbOpcao.items.Add('ATIVOS');
      JanelaProduto.cbbOpcao.items.Add('INATIVOS');
      JanelaProduto.cbbOpcao.items.Add('AMBOS');
      JanelaProduto.cbbOpcao.text := 'ATIVOS';
      JanelaProduto.cbbOpcao.OnSelect := FiltrarDados;

      JanelaProduto.ManterParametros := true;
    end;

    JanelaProduto.ckbOpcional1.Checked := fFormaPesquisaProduto = fpItemProdutos;
    JanelaProduto.ckbOpcional2.Checked := fFormaPesquisaProduto = fpItemProdutosCliente;

    JanelaProduto.OntecClose := ConfiguracaoJanela;
    result := Janelaproduto;
  end
  else
  begin
    Result := TfrmConsultaPorCampo.Create(nil);
    TfrmConsultaPorCampo(Result).ConsultaInterativa := True;
    TfrmConsultaPorCampo(Result).ckbOpcional1.Visible := false;
    TfrmConsultaPorCampo(Result).ckbOpcional2.Visible := false;
    TfrmConsultaPorCampo(Result).UsarParametrosDaTabela:= False;
  end;
end;

procedure TfrmCadastroCaracteristicas.KeyDown(var Key: Word; Shift: TShiftState);
begin
  case Key of
     VK_F4 : if sbnCopiar.enabled then sbnCopiarClick(nil);
     VK_Right: if (Shift = [ssCtrl]) then
                  if dbgProdutos.Focused then
                    AlternarColunaProduto(dbgProdutos.ColumnByName('codigorecolha'), True);

      VK_Left: if (Shift = [ssCtrl]) then
                  if dbgProdutos.Focused then
                    AlternarColunaProduto(dbgProdutos.ColumnByName('codigorecolha'), False);

      VK_Escape :  if pnlGradeProduto.Visible then
                      VisualizarItensProdutos;
                      
   VK_Return : if Shift = [] then begin
                  if ActiveControl = flkFator then begin
                    pgcCaracteristicas.ActivePage:= tstInformacoesFiscais;
                    //flkOrigem.SetFocus;
                    Key:= 0;
                  end
                  else if ActiveControl = edtAliquotaPis then begin
                    pgcCaracteristicas.ActivePage:= tstObservacoes;
                    mmoObservacaoProdutosGerais.SetFocus;
                    Key:= 0;
                  end
                  else if ActiveControl = mmoObservacaoProdutosVendas then begin
                    pgcCaracteristicas.ActivePage:= tstFornecedores;
                    dbgFornecedor.SetFocus;
                    Key:= 0;
                  end
                  else if ActiveControl = dbgFornecedor then begin
                    pgcCaracteristicas.ActivePage := tstSimilares;
                    dbgSimilares.SetFocus;
                    Key:= 0;
                  end
                  else if ActiveControl = dbgSimilares then begin
                    dbgSimilaresItemProdutos.SetFocus;
                    Key:= 0;
                  end
                  else if ActiveControl = dbgSimilaresItemProdutos then begin
                    pgcCaracteristicas.ActivePage := tstPrecos;
                    dbgPrecos.SetFocus;
                    Key:= 0;
                  end
                  else if ActiveControl = dbgPrecos then begin
                    dbgColunasPrecos.SetFocus;
                    Key:= 0;
                  end
                  else if ActiveControl = dbgColunasPrecos then begin
                    pgcCaracteristicas.ActivePage := tstParametros;
                    ckbMontagem.SetFocus;
                    Key:= 0;
                  end;
                end
                else if Shift = [ssShift] then begin
                  if ActiveControl = dbgColunasPrecos then begin
                    dbgPrecos.SetFocus;
                    Key:= 0;
                  end
                  else if ActiveControl = dbgPrecos then begin
                    pgcCaracteristicas.ActivePage := tstSimilares;
                    dbgSimilares.SetFocus;
                    Key:= 0;
                  end
                  else if ActiveControl = dbgSimilares then begin
                    pgcCaracteristicas.ActivePage := tstFornecedores;
                    dbgFornecedor.SetFocus;
                    Key:= 0;
                  end
                  else if ActiveControl = dbgFornecedor then begin
                    pgcCaracteristicas.ActivePage := tstObservacoes;
                    mmoObservacaoProdutosGerais.SetFocus;
                    Key:= 0;
                  end
                  else if ActiveControl = mmoObservacaoProdutosVendas then begin
                    pgcCaracteristicas.ActivePage:= tstInformacoesFiscais;
                    flkOrigem.SetFocus;
                    Key:= 0;
                  end
                  else if ActiveControl = flkOrigem then begin
                    pgcCaracteristicas.ActivePage:= tstParametros;
                    ckbMontagem.SetFocus;
                    Key:= 0;
                  end;
                end;
  else
    if alton or (Shift = [ssAlt]) then
      begin
       case key of
       vk_1 : begin
               if tstParametros.TabVisible then
                 pgcCaracteristicas.ActivePage := tstParametros;
              end;
       vk_2 : begin
               if tstInformacoesFiscais.TabVisible then
                 pgcCaracteristicas.ActivePage := tstInformacoesFiscais;
              end;
       vk_3 : begin
               if tstGrades.TabVisible then
                 pgcCaracteristicas.ActivePage := tstGrades;
              end;
       vk_4 : begin
               if tstObservacoes.TabVisible then
                 pgcCaracteristicas.ActivePage := tstObservacoes;
              end;
       vk_5 : begin
               if tstFornecedores.TabVisible then
                pgcCaracteristicas.ActivePage := tstFornecedores;
              end;
       vk_6 : begin
               if tstSimilares.TabVisible then
                 pgcCaracteristicas.ActivePage := tstSimilares;
              end;
       vk_7 : begin
               if tstPrecos.TabVisible then
                 pgcCaracteristicas.ActivePage := tstPrecos;
              end;
       vk_8 : begin
               if tstContabil.TabVisible then
                 pgcCaracteristicas.ActivePage := tstContabil;
              end;
       vk_9 : begin
               if tstItensProdutos.TabVisible then
                 pgcCaracteristicas.ActivePage := tstItensProdutos;
              end;   
      end;
    end;
  end;
  inherited;
end;

