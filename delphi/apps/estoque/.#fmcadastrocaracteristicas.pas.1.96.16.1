procedure TfrmCadastroCaracteristicas.CriarConsultaModelo;
begin
  fraConsultaModelo := TfraConsultaCodigo.Create(self);
  fraConsultaModelo.Name := 'fraConsultaModelo';
  fraConsultaModelo.edfCodigo.MaxLength := 15;
  fraConsultaModelo.edfCodigo.DataSource := dtmCadastroProdutos.dsrModelosCaracteristicas;
  fraConsultaModelo.edfCodigo.DataField := 'modelo';
  fraConsultaModelo.edfCodigo.Operacao := opATRIBUICAO;
  fraConsultaModelo.edfCodigo.LookupSource := fraConsultaModelo.dsrProcuraModelo;
  fraConsultaModelo.edfCodigo.LookupField := 'codigo';
  fraConsultaModelo.edfCodigo.LookupQueryParameter := 'codigo';
  fraConsultaModelo.AbrirTabelaProcura := false;
  fraConsultaModelo.OnFound := AtribuirDadosModelosProdutos;
  fraConsultaModelo.TipoPesquisa := pesMODELO;
end;

