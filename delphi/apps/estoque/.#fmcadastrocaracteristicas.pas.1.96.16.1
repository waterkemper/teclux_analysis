procedure TfrmCadastroCaracteristicas.dbgProdutosCargosKeyDown(
  Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;
  if key = vk_return then
  begin
    if dbgProdutosCargos.SelectedField = dtmCadastroProdutos.qryProdutosCargocargo then
    begin
      if not assigned(fraConsultaCargo) then
        CriarConsultaCargo;

      fraConsultaCargo.edfCodigo.doexit;
      if not fraconsultacargo.qryProcuraCargos.IsEmpty then
      begin
        AtribuirDadosCargosProdutos;
        dtmCadastroProdutos.GravarProdutosCargo;
      end
      else
      begin
        key := 0;
        dbgProdutosCargos.SelectedField := dtmCadastroProdutos.qryProdutosCargocargo;
        dbgProdutosCargos.setfocus;
      end;
    end
    else
      dtmCadastroProdutos.GravarProdutosCargo
  end    
  else
  if (dbgProdutosCargos.SelectedField = dtmCadastroProdutos.qryProdutosCargocargo) or
     (dbgProdutosCargos.SelectedField = dtmCadastroProdutos.qryProdutosCargodescricaocargo) then
  begin
    if (key = VK_F9) and (CtrlOn or (ssCtrl in Shift)) then
    begin
      dbgProdutosCargos.SetFocus;
      AcionaPesquisaGrade(pesCargos);
    end
  end;
end;

procedure TfrmCadastroCaracteristicas.CriarConsultaCargo;
begin
  fraConsultaCargo := TfraConsultaCodigo.Create(self);
  fraConsultaCargo.Name := 'fraConsultaCargo';
  fraConsultaCargo.edfCodigo.MaxLength := 15;
  fraConsultaCargo.edfCodigo.DataSource := dtmCadastroProdutos.dsrprodutosCargo;
  fraConsultaCargo.edfCodigo.DataField := 'Cargo';
  fraConsultaCargo.edfCodigo.Operacao := opATRIBUICAO;
  fraConsultaCargo.edfCodigo.LookupSource := fraConsultaCargo.dsrProcuraCargos;
  fraConsultaCargo.edfCodigo.LookupField := 'codigo';
  fraConsultaCargo.edfCodigo.LookupQueryParameter := 'codigo';
  fraConsultaCargo.AbrirTabelaProcura := false;
  fraConsultaCargo.OnFound := AtribuirDadosCargosProdutos;
  fraConsultaCargo.CondicoesdaConsulta := CondicoesConsultaCargos;
  fraConsultaCargo.TipoPesquisa := pesCargos;

end;

