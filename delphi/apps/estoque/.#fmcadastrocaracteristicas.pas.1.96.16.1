procedure TfrmCadastroCaracteristicas.dbgGradesDrawColumnCell(
  Sender: TObject; const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
var
 RegistroAtual: TBookMark;
begin
  inherited;

  if column.Index <> 0 then
  begin
    With dtmCadastroProdutos do begin
      qryprodutos.DisableControls;
      if not (qryprodutos.State in [dsedit,dsinsert]) then
      begin
        RegistroAtual := qryProdutos.GetBookmark;
        if PosicionarLinhaColunanoProduto(trim(column.Title.Caption)) then
        begin
          if (ProdutoForaLinha or ProdutoInativo) then begin
            TDBGrid(Sender).Canvas.Brush.Color := $7DBEFF;
            TDBGrid(Sender).Canvas.Font.Color  := clBlack;
          end;
          if ProdutoRecolhido then begin
            TDBGrid(Sender).Canvas.Brush.Color := $00FFD9A4;
            TDBGrid(Sender).Canvas.Font.Color  := clBlack;
          end;
          TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
        end;
        qryProdutos.GotoBookmark(RegistroAtual);
        qryProdutos.FreeBookmark(RegistroAtual);
      end;
      qryprodutos.EnableControls;
    end;
  end;
end;

procedure TfrmCadastroCaracteristicas.PosicionarLinhaColunaNaGrade;
begin
 dbggrades.SetFocus;
 with  dtmCadastroProdutos do
 begin
  dbggrades.SelectedIndex := Colunas.IndexOf(ProdutoColunaGrade)+1;
  qrygrade.First;
  while not qrygrade.Eof do
  begin
   if qrygrade.Fields[0].AsString = ProdutoLinhaGrade then
    break;
   qrygrade.Next;
  end;
 end;
end;

