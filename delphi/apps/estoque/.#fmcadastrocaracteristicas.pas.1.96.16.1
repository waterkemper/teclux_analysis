procedure TfrmCadastroCaracteristicas.sbnCopiarClick(Sender: TObject);
var
frmCopiaProduto: TfrmCodigoCopiaProduto;
CodigoCopia: String;
continuar: boolean;
begin
  inherited;
  if not CtrlOn then
  begin
    FProdutoJaGravado:= False;
    continuar:=true;
    CodigoCopia:='';

    //abre janela para digitacao do novo codigo de produto
    if not Parsistema.GerarCodigoProdutoAutomatico then
    begin
      frmCopiaProduto := TfrmCodigoCopiaProduto.Create(self);
      frmCopiaProduto.edCodigoProduto.EditMask:='';
      frmCopiaProduto.ShowModal;
      if ((frmCopiaProduto.edCodigoProduto.Text='') or (frmCopiaProduto.ModalResult=mrcancel)) then
        continuar:=false
      else
        CodigoCopia:= frmCopiaProduto.edcodigoproduto.Text;
      frmCopiaProduto.Free;
    end;

    if continuar then
    begin
      dtmCadastroProdutos.CopiarCaracteristica(CodigoCopia);
      if dtmCadastroProdutos.vIncluidoapartirdoRegistroAtual then
      begin
        InternoGravar;
        dtmCadastroProdutos.EditarCaracteristica;
      end;
    end;

  end;
end;

