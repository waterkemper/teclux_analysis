end;

function TfrmCadastroCaracteristicas.AcionaCadastroProdutos(Editar: Boolean):Boolean;
begin
  Result := PermiteInclusaoProdutos;
  if result then
  begin
    frmCadastroProdutos := TfrmCadastroProdutos.Create(frmCadastroProdutos);
    with frmCadastroProdutos do
    begin
      {SetDataModulo(dtmCadastroProdutos);}
      DataSet := dtmCadastroProdutos.TabelaProduto;
      pnlGrade.Visible := dtmCadastroProdutos.UtilizandoGrade;

      dbcElementoLinhaGrade.Visible := (flkLinhaGrade.Text<>'');
      dbcElementoColunaGrade.Visible := (flkColunaGrade.Text<>'');
      Result:= dtmCadastroProdutos.IncluirProduto(Editar);
      dbcElementoLinhaGrade.ReadOnly := pnlGradeProduto.Visible;
      dbcElementoColunaGrade.ReadOnly := pnlGradeProduto.Visible;

      if not editar and pnlGradeProduto.Visible then
        dtmCadastroProdutos.AtribuiLinhaColunanoProduto(trim(dbggrades.Columns[dbgGrades.SelectedIndex].Title.caption));

      if Result then
      begin
        ShowModal;
        free;
        if pnlGradeProduto.Visible then
         dbgGrades.SetFocus
        else
        dbgProdutos.SetFocus;
      end
      else
       MensagemAviso(ctCOMBINACOESINEXISTENTES);
    end;
  end;
end;

