procedure TfrmCadastroCaracteristicas.actHabilitarABAsUpdate(Sender: TObject);
begin
  inherited;
  tstFornecedores.TabVisible:= FProdutoJaGravado;


  tstSimilares.TabVisible   := FProdutoJaGravado;
  tstPrecos.TabVisible      := FProdutoJaGravado;
  if sbnGerarLinhasColunas.Visible then
    sbnGerarLinhasColunas.Enabled := ((flkLinhaGrade.Text<>'') or
                                      (flkColunaGrade.Text<>'')) and
                                      FProdutoJaGravado;
//  flkICMS.ReadOnly       := not dtmCadastroProdutos.ComTributo;
//  edtReducaoBase.ReadOnly:= not dtmCadastroProdutos.ComReducao;
  sbnVisualizarGrade.Visible := dtmCadastroProdutos.UtilizandoGrade and
                                FProdutoJaGravado;
  rgpDiscriminarComposto.Enabled := ckbProdutoComposto.Checked;
  if (not rgpDiscriminarComposto.Enabled) or (not rbnComComposicao.Checked) then
    ckbDiscriminarPreco.Checked := False;
  ckbDiscriminarPreco.Enabled := ckbProdutoComposto.Visible and ckbProdutoComposto.Checked
                                 and rbnComComposicao.Checked;

  pgcFiosFitas.Visible := (copy(uppercase(edtDescricao.Text),1,3)='FIO') or
                          (copy(uppercase(edtDescricao.Text),1,4)='FITA');
  if pgcFiosFitas.Visible then
  begin
    if (copy(uppercase(edtDescricao.Text),1,3)='FIO') then
      pgcfiosfitas.activepage := tstFiosProdutos
    else
    if (copy(uppercase(edtDescricao.Text),1,4)='FITA') then
      pgcfiosfitas.activepage := tstFitasProdutos;
  end;

  tstProdutosCargos.TabVisible := FProdutoJaGravado and parsistema.PrecosporCargo;

  sbnDeslocarParaCima.enabled := (self.ActiveControl <> DBGridProdutos_Servicos);
  sbnDeslocarRegistroParaBaixo.enabled := sbnDeslocarParaCima.enabled;
//  sbnconferircomposto.visible := dtmCadastroProdutos.qryCaracteristicascomposto.asBoolean;


  sbnIncluirLotes.visible := not dtmCadastroProdutos.qryprodutos.isempty;
  sbnExcluirLotes.visible := not dtmCadastroProdutos.qryprodutoslotes.isempty;


  tstLotes.tabvisible := dtmCadastroProdutos.qryCaracteristicasgerenciarloteevalidade.asboolean;

end;

procedure TfrmCadastroCaracteristicas.AlternarColunaProduto(Column: TColumn; Incrementa: Boolean);
begin

  if (Column.fieldname = 'codigorecolha') or
     (Column.fieldname = 'foralinha') or
     (Column.fieldname = 'inativo') then
  begin
    if (Column.fieldname = 'codigorecolha') then
    begin
      if Incrementa then
      begin
        Column.Title.Caption := 'FORA LINHA...';
        Column.fieldname     := 'foralinha';
        Column.Width         := 115;
      end
      else
      begin
        Column.Title.Caption := 'INATIVO...';
        Column.fieldname     := 'inativo';
        Column.Width         := 115;
      end;
    end
    else
    if (Column.fieldname = 'foralinha') then
    begin
      if Incrementa then
      begin
        Column.Title.Caption := 'INATIVO...';
        Column.fieldname     := 'inativo';
        Column.Width         := 115;
      end
      else
      begin
        Column.Title.Caption := 'CÓDIGO RECOLHA...';
        Column.fieldname     := 'codigorecolha';
        Column.Width         := 115;
      end;
    end
    else
    if (Column.fieldname = 'inativo') then
    begin
      if Incrementa then
      begin
        Column.Title.Caption := 'CÓDIGO RECOLHA...';
        Column.fieldname     := 'codigorecolha';
        Column.Width         := 115;
      end
      else
      begin
        Column.Title.Caption := 'FORA LINHA...';
        Column.fieldname     := 'foralinha';
        Column.Width         := 115;
      end;
    end;
  end;  
end;

