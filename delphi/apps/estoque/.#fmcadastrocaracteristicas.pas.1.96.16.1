function TfrmCadastroCaracteristicas.TabelaDePesquisa: TZDataSet;
begin
  with dtmCadastroProdutos do
    case TipoProcura of
              tpGRUPOS : Result := ConsultarGrupo;
              tpCLASSE : Result := ConsultarClasse;
           tpOBSLEGAIS : Result := ConsultarObsLegal;
            tpUNIDADES : Result := ConsultarUnidade;
                 tpIPI : Result := ConsultarIPI;
                tpICMS : Result := ConsultarICMS;
       tpDescricaonaNF : result := dtmCadastroProdutos.qryDescricaoProdutoNF;
              tpMARCAS : Result := ConsultarMarca;

     tpCARACTERISTICAS : case fFormaPesquisaProduto of
                           fpCaracteristicas : Result := ConsultarCaracteristica;
                           fpItemProdutos    : Result := ConsultarCaracteristicaProduto;
                           fpItemProdutosCliente : Result := qryConsultaCaracteristicasProdutosClientes;
                         end;

             tpORIGENS : Result := ConsultarOrigem;
         tpINCIDENCIAS : Result := ConsultarIncidencia;
             tpFATORES : Result := ConsultarFatoresPreco;
         tpLINHAGRADE,
        tpCOLUNAGRADE  : Result := ConsultarGrades;
  tpDebitarVendaaVista,
  tpCreditarVendaaVista,
  tpDebitarVendaaPrazo,
  tpCreditarVendaaPrazo,
  tpDebitarAbatimentos,
  tpCreditarAbatimentos,
  tpDebitarDevolucoes,
  tpCreditarDevolucoes : result:= qryconsultacontacontabil;
  tpHistoricoVendaaVista,
  tpHistoricoVendaaPrazo,
  tpHistoricoAbatimentos,
  tpHistoricoDevolucoes  : result := qryconsultahistorico;
      else
        Result := nil;
    end;
end;

