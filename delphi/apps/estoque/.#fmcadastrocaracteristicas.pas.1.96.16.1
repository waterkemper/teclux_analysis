procedure TfrmCadastroCaracteristicas.AcionarPesquisaGrade;
begin

  if  ActiveControl = dbgProdutosFornecedores then
  begin
    ConsultaProduto.CtrlOn := True;
    dbgProdutosFornecedores.SetFocus;
    case dbgProdutosFornecedores.SelectedIndex of
      0: begin
           case ConsultaProduto.InternoPesquisar(ctPRODUTO) of
           mrOk   : begin
                      dbgProdutosFornecedores.SetFocus;
                      dbgProdutosFornecedores.SelectedIndex :=  0;
                    end;
           mrCancel: begin
                      dbgProdutosFornecedores.SetFocus;
                      dbgProdutosFornecedores.SelectedIndex :=  0;
                    end;
           end
         end;
    end;
  end
  else
  if ActiveControl = dbgProdutosFornecedoresUnidades then
  begin
    if (dbgProdutosFornecedoresUnidades.SelectedField = dtmCadastroProdutos.qryProdutosFornecedoresUnidadesfornecedor) or
       (dbgProdutosFornecedoresUnidades.SelectedField = dtmCadastroProdutos.qryProdutosFornecedoresUnidadesTipofornecedor) or
       (dbgProdutosFornecedoresUnidades.SelectedField = dtmCadastroProdutos.qryProdutosFornecedoresUnidadesnomefornecedor) then
    begin
      case ConsultaFornecedor.InternoPesquisar(ctFORNECEDORES) of
      mrOk   : begin
                 dbgProdutosFornecedoresUnidades.SetFocus;
                 dbgProdutosFornecedoresUnidades.SelectedField :=  dtmCadastroProdutos.qryProdutosFornecedoresUnidadesunidade;
               end;
      mrCancel: begin
                 dbgProdutosFornecedoresUnidades.SetFocus;
                 dbgProdutosFornecedoresUnidades.SelectedField :=  dtmCadastroProdutos.qryProdutosFornecedoresUnidadesfornecedor;
               end;
      end
    end
    else
    if (dbgProdutosFornecedoresUnidades.SelectedField = dtmCadastroProdutos.qryProdutosFornecedoresUnidadesunidade) or
       (dbgProdutosFornecedoresUnidades.SelectedField = dtmCadastroProdutos.qryProdutosFornecedoresUnidadesdescricaounidade) then
    begin
      case ConsultaUnidades.InternoPesquisar('UNIDADES') of
      mrOk   : begin
                 dbgProdutosFornecedoresUnidades.SetFocus;
                 dbgProdutosFornecedoresUnidades.SelectedField :=  dtmCadastroProdutos.qryProdutosFornecedoresUnidadesfatorconversao;
               end;
      mrCancel: begin
                 dbgProdutosFornecedoresUnidades.SetFocus;
                 dbgProdutosFornecedoresUnidades.SelectedField :=  dtmCadastroProdutos.qryProdutosFornecedoresUnidadesunidade;
               end;
      end;
    end;
  end;
end;

