var
  frmCadastroFornecedores: TfrmCadastroFornecedores;
  JaTestouEmail: Boolean;
  Procura: TtecPesquisa;

implementation

uses fmnavcontroles, fmcadastrofornecedoresgrupos, fmcadastrocontatos;

{$R *.dfm}

constructor TfrmCadastroFornecedores.Create(AOwner: TComponent);
begin
  dtmCadastroFornecedores := TdtmCadastroFornecedores.Create(Self);
  inherited;
  dtmConsultaEnderecos := TdtmConsultaEnderecos.Create(Self);
  DataSet := dtmCadastroFornecedores.TabelaFornecedor;
//  dtmCadastroFornecedores.Abre(ctTabelasFornecedores);
  pgcFornecedores.ActivePage:= tstEndereco;
  JaTestouEmail:= False;
  Procura:= pesNENHUMA;
  tstContabilidade.TabVisible := ParSistema.GerarContabilidade;

  fraConsultaDebitar.TipoContaContabilConsultaSelecionavel := 'A';
  fraConsultaDebitar.TipoContaContabilDebitoSelecionavel   := 'A';
  fraConsultaDebitar.TipoPesquisa:= pesCONTADEBITO;

  fraConsultaCreditar.TipoContaContabilConsultaSelecionavel := 'A';
  fraConsultaCreditar.TipoContaContabilCreditoSelecionavel  := 'A';
  fraConsultaCreditar.TipoPesquisa:= pesCONTACREDITO;

  fraConsultaAdiantamento.TipoContaContabilConsultaSelecionavel := 'A';
  fraConsultaAdiantamento.TipoContaContabilCreditoSelecionavel  := 'A';
  fraConsultaAdiantamento.TipoPesquisa:= pesCONTACREDITO;

  fraConsultaModeloDocto := TfraConsultaCodigoContabil.Create(self);
  fraConsultaModeloDocto.Name := 'ConsultaModeloDocto';
  fraConsultaModeloDocto.edfCodigo.MaxLength := 2;
  fraConsultaModeloDocto.edfCodigo.DataSource := dtmCadastroFornecedores.dsrSeriesFornecedores;
  fraConsultaModeloDocto.edfCodigo.DataField := 'modelodoctofiscal';
  fraConsultaModeloDocto.edfCodigo.Operacao := opATRIBUICAO;
  fraConsultaModeloDocto.edfCodigo.LookupSource := fraConsultaModeloDocto.dsrProcuraModeloDoctosFiscais;
  fraConsultaModeloDocto.edfCodigo.LookupField := 'codigo';
  fraConsultaModeloDocto.edfCodigo.LookupQueryParameter := 'codigo';
  fraConsultaModeloDocto.AbrirTabelaProcura := false;
  fraConsultaModeloDocto.TipoPesquisa := pesMODELODOCTOSFISCAIS;

  dbgSerieFornecedor.OnDelete := dtmCadastroFornecedores.ExcluirSeriesFornecedores;

  fraConsultaHistorico.TipoPesquisa:= pesHISTORICOCONTABIL;
  fraConsultaHistoricoPagtoDuplicata.TipoPesquisa:= pesHISTORICOCONTABIL;

  if not Assigned(fraConsultaFornecedores) then
    fraConsultaFornecedores := TfraConsultaCodigo.Create(self);
  fraConsultaFornecedores.edfCodigo.ActiveSetControls := false;
  fraConsultaFornecedores.edfCodigo.DataSource := dtmCadastroFornecedores.dsrFornecedores;
  fraConsultaFornecedores.edfCodigo.DataField := 'codigo';
  fraConsultaFornecedores.edfCodigo.Operacao := opATRIBUICAO;
  fraConsultaFornecedores.AbrirTabelaProcura := false;
  fraConsultaFornecedores.TipoPesquisa := pesFORNECEDORES;
  fraConsultaFornecedores.TipoCliente:= 'F';
  fraConsultaFornecedores.Tipovfornecedor:= 'F';

  fraConsultaProcessoJudicialReinf.TipoPesquisa := pesProcessoJudicialReinf;
  fraConsultaSuspensaoExibilidadeTributos.TipoPesquisa := pesSuspensaoExibilidadeTributos;
  fraConsultaSuspensaoExibilidadeTributos.OnFound := AtribuirDadosSuspensaoExibilidadeTributos_pr;


  fraConsultaProcessoJudicialReinf_Ad.TipoPesquisa := pesProcessoJudicialReinf;
  fraConsultaSuspensaoExibilidadeTributos_Ad.TipoPesquisa := pesSuspensaoExibilidadeTributos;

  fraConsultaSuspensaoExibilidadeTributos_Ad.OnFound := AtribuirDadosSuspensaoExibilidadeTributos_ad;

end;

destructor TfrmCadastroFornecedores.Destroy;
begin
  dtmCadastroFornecedores := nil;
  inherited;
  frmCadastroFornecedores := nil;
end;

function TfrmCadastroFornecedores.ExisteInformacao(Parametro: Integer; NomeCampo: String; Value: Variant): Boolean;
begin
  case Procura of
    pesGRUPOSFORNECEDORES : Result:= dtmCadastroFornecedores.ExisteGrupoFornecedore(NomeCampo, Value);
    else                    Result:= False;
  end;
end;

function TfrmCadastroFornecedores.InternoExcluir: Boolean;
begin
  Result:= inherited InternoExcluir;
  if Result then  begin
    if not CtrlOn then begin
      dtmCadastroFornecedores.ExcluirFornecedor;
      pgcFornecedores.ActivePage:= tstEndereco;
    end
  end
end;

function TfrmCadastroFornecedores.InternoGravar: Boolean;
begin
  Result:= True;
  edtDocumento.Estado:= dtmCadastroFornecedores.EstadoFornecedor;
  if  edtDocumento.Criticar then
  begin
    Result:= inherited InternoGravar;
    if Result then
    begin
      if JaTestouEmail or EmailValido(edtEmail.Text) then
      begin
        if fracgcoucpf1.edtCPFCNPJ.Criticar(ActiveControl <>
           fracgcoucpf1.edtCPFCNPJ) then
          dtmCadastroFornecedores.GravarFornecedor
      end
      else
      begin
        if not (pgcFornecedores.ActivePage = tstInformacoes) then
           pgcFornecedores.ActivePage := tstInformacoes;
        edtEmail.SetFocus;
        JaTestouEmail:= False;
        Result:= False;
      end;
    end;
  end;
end;

function TfrmCadastroFornecedores.InternoIncluir: Boolean;
begin
  Result:= inherited InternoIncluir;
  if Result then
    if not CtrlOn then
    begin
      dtmCadastroFornecedores.IncluirFornecedor;
      pgcFornecedores.ActivePage:= tstEndereco;
    end
  else
    Result:= False;
end;

procedure TfrmCadastroFornecedores.sbnExcluirOpcoesClick(Sender: TObject);
begin
  dtmCadastroFornecedores.ExcluirSeriesFornecedores;
end;

function TfrmCadastroFornecedores.InternoPesquisar(Titulo: String): Integer;
begin

  if CtrlOn then
  begin
    if flkGrupo.Focused then Procura := pesGRUPOSFORNECEDORES;
  end
  else
  begin
    Procura := pesNENHUMA;
    if fraConsultaFornecedores.InternoPesquisar(ctFornecedores) = mrOK then
    begin
      edfCodigo.text := fraConsultaFornecedores.ValorSelecionado;
      with dtmCadastroFornecedores do
         ReFazConsulta(qryFornecedores,[0], [fraConsultaFornecedores.ValorSelecionado]);
    end;
    self.SetFocus;

  end;

  if Procura <> pesNENHUMA then
  begin
    dtmCadastroFornecedores.AbrirTabelasConsulta(Procura);
    Result:= inherited InternoPesquisar(Titulo);
    if Result = mrOk then
      dtmCadastroFornecedores.PosicionarTabelas(Procura);
    dtmCadastroFornecedores.FecharTabelasConsulta(Procura);
    Procura := pesNENHUMA;
  end;

end;

function TfrmCadastroFornecedores.JanelaPesquisa: TfrmConsultaBasica;
begin
  Result:= TfrmConsultaPorCampo.Create(nil);
  TfrmConsultaPorCampo(result).ConsultaInterativa:= True;
  TfrmConsultaPorCampo(Result).UsarParametrosDaTabela := False;
end;

procedure TfrmCadastroFornecedores.KeyDown(var Key: Word; Shift: TShiftState);
begin
  case Key of
    VK_RETURN: if (Shift = []) then
    begin
       if (ActiveControl = fraFax.edtNumero) then
       begin
         pgcFornecedores.ActivePage := tstInformacoes;
         Key:= 0;
       end
       else if (ActiveControl = mmoObsrvacoes) then
       begin
         pgcFornecedores.ActivePage:= tstEndereco;
         edtRazaoSocial.SetFocus;
         Key:= 0;
       End;
     end
     else if (Shift = [ssCtrl]) then
     begin
       if (ActiveControl = dbgGrupos) then
       begin
         pgcFornecedores.ActivePage:= tstObservacoes;
         mmoObsrvacoes.SetFocus;
         Key:= 0;
       end
     end;
  end;
  inherited;
end;

function TfrmCadastroFornecedores.TabelaDePesquisa: TZDataSet;
begin
  case Procura of
    pesGRUPOSFORNECEDORES : Result := dtmCadastroFornecedores.ConsultaGruposFornecedores;
    else                    Result:= Nil;
  end;
end;

procedure TfrmCadastroFornecedores.edtEmailExit(Sender: TObject);
begin
  if not EmailValido(edtEmail.Text) then begin
       edtEmail.SetFocus;
       JaTestouEmail:= True;
  end
  else inherited;
end;

procedure TfrmCadastroFornecedores.dbgSerieFornecedorKeyPress(Sender: TObject; var Key: Char);
begin
  inherited;
  if Key in ['a'..'z'] then
    Key:= UpCase(Key);
end;


procedure TfrmCadastroFornecedores.edtDocumentoExit(Sender: TObject);
begin
  edtDocumento.Estado:= dtmCadastroFornecedores.EstadoFornecedor;
  edtDocumento.Criticar;
end;

procedure TfrmCadastroFornecedores.sbnGrupoFornecedorClick(Sender: TObject);
begin
  inherited;
  InternoPesquisar(flkGrupo, ctGRUPODEFORNECEDOR);
end;

procedure TfrmCadastroFornecedores.fracgcoucpf1rgbTipoPessoaChange(Sender: TObject);
begin
  inherited;
  if Assigned(fracgcoucpf1) then
    fracgcoucpf1.edtCPFCNPJ.Tipo:= dtmCadastroFornecedores.TipoPessoa;
end;

procedure TfrmCadastroFornecedores.fracgcoucpf1edtCPFCNPJExit(Sender: TObject);
begin
  inherited;
  if dtmCadastroFornecedores.FornecedorJaCadastrado(fracgcoucpf1.edtCPFCNPJ.Text) then
    if fracgcoucpf1.edtCPFCNPJ.CanFocus then
      fracgcoucpf1.edtCPFCNPJ.SetFocus;
end;


procedure TfrmCadastroFornecedores.actAbilitarUpdate(Sender: TObject);
begin
  inherited;
  tstGrupos.TabVisible     := not dtmCadastroFornecedores.Inserindo and
                              not dtmCadastroFornecedores.TabelaFornecedorVazia;

  tstReinf.TabVisible :=   dtmCadastroFornecedores.qryFornecedorestipofornec_maoobra_l.AsBoolean or ckbTipoFornec_MaodeObra.Checked;

end;

procedure TfrmCadastroFornecedores.AcionaCadastroGrupos(Editando: Boolean);
begin
  frmCadastroFornecedoresGrupos := TfrmCadastroFornecedoresGrupos.Create(frmCadastroFornecedoresGrupos);
  try
    dtmCadastroFornecedores.IncluirFornecedoresGrupos(Editando);
    frmCadastroFornecedoresGrupos.ShowModal
  finally
    frmCadastroFornecedoresGrupos.Free;
  end
end;

procedure TfrmCadastroFornecedores.sbnIncluirGruposClick(Sender: TObject);
begin
  inherited;
  AcionaCadastroGrupos(False);
end;

procedure TfrmCadastroFornecedores.sbnExcluirGruposClick(Sender: TObject);
begin
  inherited;
  dtmCadastroFornecedores.ExcluirFornecedoresGrupos;
end;

procedure TfrmCadastroFornecedores.dbgGruposKeyDown(Sender: TObject;
          var Key: Word; Shift: TShiftState);
begin
  inherited;
  if Shift = [ssCtrl] then
    case Key of
      TeclaInserirRegistro: AcionaCadastroGrupos(False);
      TeclaEditarRegistro : AcionaCadastroGrupos(True);
    end;
end;

procedure TfrmCadastroFornecedores.dbgGruposDblClick(Sender: TObject);
begin
  inherited;
  AcionaCadastroGrupos(True);
end;

procedure TfrmCadastroFornecedores.OperacaoPadrao(Value: array of Variant);
begin
  inherited;
  edfCodigo.SetFocus;
  edfCodigo.Text := Value[0];
  dtmCadastroFornecedores.ReFazConsultaFornecedor(Value[0]);
end;


procedure TfrmCadastroFornecedores.sbnExcluirContatoClick(Sender: TObject);
begin
  inherited;
        dtmCadastroFornecedores.ExcluirFornecedoresContatos;
end;

procedure TfrmCadastroFornecedores.AcionaCadastroContatos(Editando: Boolean);
begin
  frmcadastrocontatos := Tfrmcadastrocontatos.Create(frmcadastrocontatos);
  try
    frmcadastrocontatos.DataSet := dtmCadastroFornecedores.qryContatosFornecedores;
    frmcadastrocontatos.dsrContatos.DataSet := dtmCadastroFornecedores.qryContatosFornecedores;
    if not editando then
      frmcadastrocontatos.dsrContatos.DataSet.Append;
      frmcadastrocontatos.ShowModal
  finally
    frmcadastrocontatos.Free;
    edfCodigo.SetFocus;
  end
end;

procedure TfrmCadastroFornecedores.dbgContatosDblClick(Sender: TObject);
begin
  inherited;
    AcionaCadastroContatos(True);
end;

procedure TfrmCadastroFornecedores.dbgContatosKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if Shift = [ssCtrl] then
    case Key of
      TeclaInserirRegistro: AcionaCadastroContatos(False);
      TeclaEditarRegistro : AcionaCadastroContatos(True);
    end;
end;

procedure TfrmCadastroFornecedores.rgpTipoFornecimentoChange(
  Sender: TObject);
begin
  inherited;
  gbxRNTC.Visible          := ckbTipoFornec_Transporte.Checked;
end;

procedure TfrmCadastroFornecedores.dbgSerieFornecedorKeyDown(
  Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;
  if CtrlOn then
  begin
    case Key of
      VK_F9 : AcionaPesquisaGrade
    end;
  end
  else
  begin
    case key of
      VK_RETURN :
      begin
        case dbgSerieFornecedor.SelectedIndex of
        1 : begin
              if not fraConsultaModeloDocto.edfCodigo.Exist then
                dbgSerieFornecedor.DataSource.DataSet.FieldByName('modelodoctofiscal').Clear;
              dbgSerieFornecedor.SelectedIndex := 1;
              dbgSerieFornecedor.SetFocus;
            end;
        end;
        if dtmCadastroFornecedores.qrySeriesFornecedores.State in [dsedit, dsinsert] then
           dtmCadastroFornecedores.qrySeriesFornecedores.Post;
      end;
    end;
  end;

end;

procedure TfrmCadastroFornecedores.AcionaPesquisaGrade;
begin
  fraConsultaModeloDocto.CtrlOn := True;
  dbgSerieFornecedor.SetFocus;
  fraConsultaModeloDocto.InternoPesquisar('Modelo do Documento Fiscal');
  dbgSerieFornecedor.SelectedIndex :=  1;
end;

