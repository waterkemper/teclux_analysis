procedure TfrmCadastroNotasFiscais.sbnLerXMLNfeClick(Sender: TObject);
begin
  inherited;
  try
     {
    dbgProdutosNotaFiscal.datasource := nil;
    dbgProdutosNFE.datasource := nil;
    dbgProdutosNotasPagNFEItems.datasource := nil;
    dbgSituacaoProdutoNFE.datasource := nil;
    mmoinfadprod.datasource := nil;
    }

  flkFornecedor.SetFocus;
  flkFornecedor.SelectAll;
  odlLerXMLNfe.FileName  :=  '';
  odlLerXMLNfe.Title := 'Selecione a NFE';
  odlLerXMLNfe.DefaultExt := '*.XML';
  odlLerXMLNfe.Filter := 'Arquivos XML (*.XML)|*.XML|Arquivos NFE (*-nfe.XML)|*-nfe.XML|Arquivos TXT (*.TXT)|*.TXT|Todos os Arquivos (*.*)|*.*';
  if odlLerXMLNfe.Execute then
  begin
//    dtmCadastroNotasFiscais.OnChangeTipoFornecedor := nil;
    dtmCadastroNotasFiscais.EntradaViaXML := True;
    dtmCadastroNotasFiscais.ArquivoXMLNFe := odlLerXMLNfe.FileName;
    dtmCadastroNotasFiscais.EntradaViaXML := False;
    flkNotaFiscalExit(nil);
//    dtmCadastroNotasFiscais.OnChangeTipoFornecedor := OnChangeTipoFornecedor;
  end;

  finally
                         {
    dbgProdutosNotaFiscal.datasource := dtmCadastroNotasFiscais.dsrProdutosNotaFiscal;
    dbgProdutosNFE.datasource := dtmCadastroNotasFiscais.dsrProdutosNotasPagNFE;
    dbgProdutosNotasPagNFEItems.datasource := dtmCadastroNotasFiscais.dsrProdutosNotasPagNFEItems;
    dbgSituacaoProdutoNFE.datasource := dtmCadastroNotasFiscais.dsrProdutosNotasPagNFEItemsSituacao;
    mmoinfadprod.datasource := dtmCadastroNotasFiscais.dsrProdutosNotasPagNFE;
    }


  end;

end;

procedure TfrmCadastroNotasFiscais.dbgProdutosNFEDrawColumnCell(
  Sender: TObject; const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  inherited;
  if gdSelected in State then
  begin
    TDBGrid(Sender).Canvas.Font.Color := clRed;
    TDBGrid(Sender).Canvas.Font.Style := [fsBold];
  end
  else
  begin
    TDBGrid(Sender).Canvas.Font.Color := clBlack;
    TDBGrid(Sender).Canvas.Font.Style := [];
  end;
  dbgProdutosNFE.DefaultDrawColumnCell(Rect,DataCol,Column,State);

end;

procedure TfrmCadastroNotasFiscais.dbgProdutosNotasPagNFEItemsDrawColumnCell(
  Sender: TObject; const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  inherited;
  if gdSelected in State then
  begin

    TDBGrid(Sender).Canvas.Brush.Color := clRed;
//    TDBGrid(Sender).Canvas.Font.Color := clRed;
//    TDBGrid(Sender).Canvas.Font.Style := [fsBold];

  end
  else
  begin

     if (Column.FieldName =
         dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemspercUnitario_x_Pedido.FieldName) then
       if truncar(dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemspercUnitario_x_Pedido.AsFloat, 2) <> 0 then
         TDBGrid(Sender).Canvas.Font.Color:= clRed;



//    TDBGrid(Sender).Canvas.Font.Color := clBlack;
//    TDBGrid(Sender).Canvas.Font.Style := [];
  end;
  dbgProdutosNotasPagNFEItems.DefaultDrawColumnCell(Rect,DataCol,Column,State);

end;

