procedure TfrmCadastroNotasFiscais.sbnIncluirAdicoesClick(Sender: TObject);
begin
  inherited;
  CtrlOn:= True;
  TipoCadastro:= cnfADICAO;
  IncluirAdicao(False);
end;

function TfrmCadastroNotasFiscais.IncluirAdicao(
  Editar: Boolean): Boolean;
begin
  if not dtmCadastroNotasFiscais.SomenteLeituraProdutos then begin
    if dtmCadastroNotasFiscais.TabelaNotaFiscalVazia then
      Result := False
    else begin
      frmCadastroAdicoes := TfrmCadastroAdicoes.Create(frmCadastroAdicoes, dtmCadastroNotasFiscais);
      frmCadastroAdicoes.DataSet := dtmCadastroNotasFiscais.qryAdicoesImportacao;
      Result := dtmCadastroNotasFiscais.IncluirAdicao(Editar);
      frmCadastroAdicoes.ShowModal;
      frmCadastroAdicoes.Free;
    end;
    dbgAdicoes.SetFocus;
  end else
    Result := False
end;

procedure TfrmCadastroNotasFiscais.sbnExcluirAdicoesClick(Sender: TObject);
begin
  inherited;
  dbgAdicoes.SetFocus;
  CtrlOn := True;
  dtmCadastroNotasFiscais.ExcluirAdicao;
end;

procedure TfrmCadastroNotasFiscais.sbnInlcuirProdutosImportadosClick(
  Sender: TObject);
begin
  inherited;
  CtrlOn:= True;
  TipoCadastro:= cnfADICAO;
  IncluirProdutoImportado(False);
end;

function TfrmCadastroNotasFiscais.IncluirProdutoImportado(
  Editar: Boolean): Boolean;
begin
  if dtmCadastroNotasFiscais.TabelaNotaFiscalVazia then
    Result := False
  else
  begin
    frmCadastroProdutosImportados := TfrmCadastroProdutosImportados.Create(frmCadastroProdutosImportados, dtmCadastroNotasFiscais);
    frmCadastroProdutosImportados.DataSet := dtmCadastroNotasFiscais.qryProdutosImportados;
    Result := dtmCadastroNotasFiscais.IncluirProdutoImportado(Editar);
    frmCadastroProdutosImportados.ShowModal;
    frmCadastroProdutosImportados.Free;
  end;
  dbgProdutosImportados.SetFocus;
end;

procedure TfrmCadastroNotasFiscais.sbnExcluirProdutosImportadosClick(
  Sender: TObject);
begin
  inherited;
  dbgProdutosImportados.SetFocus;
  CtrlOn := True;
  dtmCadastroNotasFiscais.ExcluirProdutoImportado;
end;

