procedure TfrmCadastroNotasFiscais.sbnCustoePrecoVendaClick(
  Sender: TObject);
var
  vAux_VisualizarDetalhesProdutosNota : Boolean;
begin
  inherited;
  vAux_VisualizarDetalhesProdutosNota := dtmCadastroNotasFiscais.VisualizarDetalhesProdutosNota;
  visulizandoCustoePrecoVenda := not visulizandoCustoePrecoVenda;
  if visulizandoCustoePrecoVenda then
  begin
    if vAux_VisualizarDetalhesProdutosNota then
      dtmCadastroNotasFiscais.VisualizarDetalhesProdutosNota := false;

    if dtmCadastroNotasFiscais.CalcularCusto then
      dtmCadastroNotasFiscais.CalcularPrecoVenda;

    if vAux_VisualizarDetalhesProdutosNota then
      dtmCadastroNotasFiscais.VisualizarDetalhesProdutosNota := true;
  end;
  VisualizarPaineisCusto;
end;

procedure TfrmCadastroNotasFiscais.dbgProdutosNotaFiscalDrawColumnCell(
  Sender: TObject; const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  inherited;
  TDBGrid(Sender).Canvas.Font.Color:= clBlack;

  with dtmCadastroNotasFiscais do
  begin
     if (column.FieldName =
         dtmCadastroNotasFiscais.qryProdutosNotaFiscalprecodigitado.FieldName) then
       if qryProdutosNotaFiscalprecodigitadoalterado.AsBoolean then TDBGrid(Sender).Canvas.Font.Color:= clRed;
  end;

  if visulizandoCustoePrecoVenda then
  begin
     if (Column.FieldName =
         dtmCadastroNotasFiscais.qryProdutosNotaFiscalpercUnitario_x_Pedido.FieldName) then
       if truncar(dtmCadastroNotasFiscais.qryProdutosNotaFiscalpercUnitario_x_Pedido.AsFloat,2) <> 0 then
         TDBGrid(Sender).Canvas.Font.Color:= clRed;

     if (Column.FieldName =
         dtmCadastroNotasFiscais.qryProdutosNotaFiscalpercAtual_x_Venda.FieldName) then
       if truncar(dtmCadastroNotasFiscais.qryProdutosNotaFiscalpercAtual_x_Venda.AsFloat,2) <> 0 then
         TDBGrid(Sender).Canvas.Font.Color:= clRed;

     if (Column.FieldName =
         dtmCadastroNotasFiscais.qryProdutosNotaFiscalpercVenda_x_Digitado.FieldName) then
       if truncar(dtmCadastroNotasFiscais.qryProdutosNotaFiscalpercVenda_x_Digitado.AsFloat,2) <> 0 then
         TDBGrid(Sender).Canvas.Font.Color:= clRed;
  end;
  TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
end;

procedure TfrmCadastroNotasFiscais.VisualizarPaineisCusto;
begin
  pnlLegenda.Visible := not pnlLegenda.Visible;
  dbgProdutosNotaFiscal.Columnbyname('pedido').Visible :=
    not dbgProdutosNotaFiscal.Columnbyname('pedido').Visible;

  dbgProdutosNotaFiscal.Columnbyname('percUnitario_x_Pedido').Visible :=
    not dbgProdutosNotaFiscal.Columnbyname('percUnitario_x_Pedido').Visible;

  dbgProdutosNotaFiscal.Columnbyname('percUnitario_x_Pedido').width := 50;

  dbgProdutosNotaFiscal.Columnbyname('precounitariopedido').Visible :=
    not dbgProdutosNotaFiscal.Columnbyname('precounitariopedido').Visible;

//  dbgProdutosNotaFiscal.Columnbyname('quantidade').Visible :=
//    not dbgProdutosNotaFiscal.Columnbyname('quantidade').Visible;

// ? se retirar a especificação do tamanho abaixo o tamanho da coluna fica estranhamente expandido
  dbgProdutosNotaFiscal.Columnbyname('unidadenf').width := 30;

  dbgProdutosNotaFiscal.Columnbyname('produtototal').Visible :=
    not dbgProdutosNotaFiscal.Columnbyname('produtototal').Visible;

  dbgProdutosNotaFiscal.Columnbyname('aliquotaicms').Visible :=
    not dbgProdutosNotaFiscal.Columnbyname('aliquotaicms').Visible;

  dbgProdutosNotaFiscal.Columnbyname('aliquotaipi').Visible :=
    not dbgProdutosNotaFiscal.Columnbyname('aliquotaipi').Visible;

  dbgProdutosNotaFiscal.Columnbyname('valoripi').Visible :=
    not dbgProdutosNotaFiscal.Columnbyname('valoripi').Visible;

  dbgProdutosNotaFiscal.Columnbyname('custoparavenda').Visible :=
    not dbgProdutosNotaFiscal.Columnbyname('custoparavenda').Visible;

  dbgProdutosNotaFiscal.Columnbyname('precoatual').Visible :=
    not dbgProdutosNotaFiscal.Columnbyname('precoatual').Visible;

  dbgProdutosNotaFiscal.Columnbyname('percAtual_x_Venda').Visible :=
    not dbgProdutosNotaFiscal.Columnbyname('percAtual_x_Venda').Visible;

  dbgProdutosNotaFiscal.Columnbyname('percAtual_x_Venda').width := 50;

  dbgProdutosNotaFiscal.Columnbyname('precovenda').Visible :=
    not dbgProdutosNotaFiscal.Columnbyname('precovenda').Visible;

  dbgProdutosNotaFiscal.Columnbyname('percVenda_x_Digitado').Visible :=
    not dbgProdutosNotaFiscal.Columnbyname('percVenda_x_Digitado').Visible;

  dbgProdutosNotaFiscal.Columnbyname('percVenda_x_Digitado').width := 50;

  dbgProdutosNotaFiscal.Columnbyname('precodigitado').Visible :=
    not dbgProdutosNotaFiscal.Columnbyname('precodigitado').Visible;

  dbgProdutosNotaFiscal.Columnbyname('permitiratualizardigitado').Visible :=
    not dbgProdutosNotaFiscal.Columnbyname('permitiratualizardigitado').Visible;

  dbgProdutosNotaFiscal.Columnbyname('codigofiscal').Visible :=
    not dbgProdutosNotaFiscal.Columnbyname('codigofiscal').Visible;

  dbgProdutosNotaFiscal.Columnbyname('valoricms').Visible :=
    not dbgProdutosNotaFiscal.Columnbyname('valoricms').Visible;

  dbgProdutosNotaFiscal.Columnbyname('icmsoutras').Visible :=
    not dbgProdutosNotaFiscal.Columnbyname('icmsoutras').Visible;

  dbgProdutosNotaFiscal.Columnbyname('icmsisentas').Visible :=
    not dbgProdutosNotaFiscal.Columnbyname('icmsisentas').Visible;

  dbgProdutosNotaFiscal.Columnbyname('preco').Visible :=
    not dbgProdutosNotaFiscal.Columnbyname('preco').Visible;

  dbgProdutosNotaFiscal.Columnbyname('descricaoprecoproduto').Visible :=
    not dbgProdutosNotaFiscal.Columnbyname('descricaoprecoproduto').Visible;
end;

procedure TfrmCadastroNotasFiscais.dbgProdutosNotaFiscalDrawDataCell(
  Sender: TObject; const Rect: TRect; Field: TField;
  State: TGridDrawState);
begin
  inherited;
  with dbgProdutosNotaFiscal.Canvas do
  begin
    if DataSet.FieldByName('precodigitadoalterado').AsBoolean then
      Font.Color:= clRed
    else
      Font.Color:= clblack;
