function TfrmCadastroNotasFiscais.TabelaDePesquisa: TZDataSet;
begin
  case TipoProcura of
    pnfFornecedor:        Result := dtmCadastroNotasFiscais.TabelaConsultaFornecedores;
    pnfEVENTO:            Result := dtmCadastroNotasFiscais.TabelaConsultaEvento;
    pnfSerie:             Result := dtmCadastroNotasFiscais.TabelaConsultaSerieFornecedor;
    pnfNATUREZA:          Result := dtmCadastroNotasFiscais.TabelaConsultaNaturezaOperacao;
    pnfCONHECIMENTOFRETE: Result := dtmCadastroNotasFiscais.TabelaConsultaConhecimento;
    pnfTRANSPORTADOR:     Result := dtmCadastroNotasFiscais.TabelaConsultaFornecedorTransporte;
    pnfESTADOPLACA:       Result := dtmCadastroNotasFiscais.TabelaConsultaEstados;
    pnfPRODUTONFE: Result := dtmCadastroNotasFiscais.qryConsultaProdutosNotaFiscal;
    pnfPEDIDOPRODUTONFE : Result := dtmCadastroNotasFiscais.qryConsultaPedidosProdutoNFE;
    pnfPEDIDONOTASPAG:  Result := dtmCadastroNotasFiscais.qryConsultaPedidosNotaFiscal;
    pnfNATUREZAPRODUTONFE: Result := dtmCadastroNotasFiscais.TabelaConsultaNaturezaOperacao;
    pnfNOTAFISCAL: Result := dtmCadastroNotasFiscais.TabelaConsultaNotaFiscais;
  else
    Result := nil;
  end;
end;

function TfrmCadastroNotasFiscais.TabelaDoParametro(Parametro: Integer): TZDataSet;
begin
  case Parametro of
    0: Result := dtmCadastroNotasFiscais.TabelaConsultaFornecedores;
    1: Result := dtmCadastroNotasFiscais.TabelaConsultaSerieFornecedor;
  else
    Result := nil;
  end
end;


procedure TfrmCadastroNotasFiscais.sbnVisualizarGradeClick(
  Sender: TObject);
begin
  inherited;
  AcionaCadastroProdutosNotasFiscaisGrade;
end;

function TfrmCadastroNotasFiscais.AcionaCadastroProdutosNotasFiscaisGrade: Boolean;
begin
  Result := true;

  try

//    if dtmCadastroNotasFiscais.qryNotaFiscal.State = dsinsert then
      dtmCadastroNotasFiscais.GravarNotaParcial(true);

    RefazConsultaPorNome(dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal, ['codigonota'], [dtmCadastroNotasFiscais.qryNotaFiscalcodigo.asinteger]);
    if dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.IsEmpty then
      dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscalcodigovisual.readonly := false;

    dtmCadastroNotasFiscais.VisualizandoGrade := True;

    if visulizandoCustoePrecoVenda then
     sbnCustoePrecoVendaClick(nil);

    if result then
    begin
      frmCadastroNotasFiscaisGrade := TfrmCadastroNotasFiscaisGrade.Create(frmCadastroNotasFiscaisGrade, dtmCadastroNotasFiscais);

      dtmCadastroNotasFiscais.GerarTabelaGrade;

      if dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.recordcount = 0 then
        frmCadastroNotasFiscaisGrade.ActiveControl := frmCadastroNotasFiscaisGrade.dbgCaracteristicasNotasFiscais
      else
        frmCadastroNotasFiscaisGrade.ActiveControl := frmCadastroNotasFiscaisGrade.dbgGrades;



      frmCadastroNotasFiscaisGrade.ShowModal;
      frmCadastroNotasFiscaisGrade.free;



      pgcNotasPag.ActivePage := tstProdutos;
      pgcProdutos.ActivePage := tstProdutosNota;

      tstProdutos.SetFocus;
      dbgProdutosNotaFiscal.SetFocus;
    end;

  finally
    dtmCadastroNotasFiscais.VisualizandoGrade := false;

  end;

end;

procedure TfrmCadastroNotasFiscais.edtDataEmissaoExit(Sender: TObject);
var
 NDias : Integer;
begin
  inherited;
  edtDataLancamento.Minimo := dtmCadastroNotasFiscais.NDiasLimiteData(
                          edtDataEmissao.Text);
end;

procedure TfrmCadastroNotasFiscais.edtDataLancamentoExit(Sender: TObject);
{
   Function AnoMesDia(Data: String): String;
   Begin
      AnoMesDia:= Copy(Data,7,4) + Copy(Data,4,2) + Copy(Data,1,2);
   End;
}
begin
  inherited;
  {
  If AnoMesDia(EdtDataEmissao.   Text) >
     AnoMesDia(EdtDataLancamento.Text) Then Begin
     EdtDataEmissao.Text:= EdtDataLancamento.Text;
  End;
  }
end;

procedure TfrmCadastroNotasFiscais.pgcNotasPagChange(Sender: TObject);
begin
  inherited;
  if pgcNotasPag.ActivePage = tstContabilidade then
  begin
    with fraLancamentoContabilidade do
    begin
    {
      sbnIncluirLancamento.Enabled :=
        dtmCadastroNotasFiscais.qryNotaFiscalsituacao.AsString <> 'C';
      sbnExcluirLancamento.Enabled :=
        dtmCadastroNotasFiscais.qryNotaFiscalsituacao.AsString <> 'C';
      sbnGerarLancamento.Enabled :=
        dtmCadastroNotasFiscais.qryNotaFiscalsituacao.AsString <> 'C';
     }
//      if sbnIncluirLancamento.Enabled then
        if not ExisteLancamentosContabeis then
          GerarLancamentosContabeis;
    end;
  end
  else
  if pgcNotasPag.ActivePage = tstImportacao then
  begin
    edfDeclaracao.SetFocus;
    edfDeclaracao.SelectAll;
  end
  else
  if pgcNotasPag.ActivePage = tstProdutos then
  begin

    if (dtmCadastroNotasFiscais.qryProdutosNotaFiscal.active) and
       (dtmCadastroNotasFiscais.qryProdutosNotasPagNFE.active) and
       (dtmCadastroNotasFiscais.qryProdutosNotaFiscal.RecordCount = 0) and
       (dtmCadastroNotasFiscais.qryProdutosNotasPagNFE.RecordCount <> 0) then
    begin
      pgcprodutos.ActivePage := tstProdutosNFE;
      pgcProdutosChange(self);

    end
    else
      pgcProdutos.ActivePage := tstProdutosNota;
  end
  else
  if pgcNotasPag.ActivePage = tstPedidos then
  begin
    dtmCadastroNotasFiscais.refazerConsultaPedidos;
    dbgConsultaPedidos.AutoSizeRows(false);
  end;

end;


procedure TfrmCadastroNotasFiscais.BloquearValores(Bloquear: Boolean);
begin
  gbxCofinsRetida.Enabled := not bloquear;
  edtCofinsRetido.Enabled := gbxCofinsRetida.Enabled;

  gbxCSLLRetida.Enabled := not bloquear;
  edtCSLLRetido.Enabled := gbxCSLLRetida.Enabled;

  gbxINSS      .Enabled := not bloquear;
  edtINSSRetido.Enabled := gbxINSS.Enabled;

  gbxIRRF      .Enabled := not bloquear;
  edtIRRetido  .Enabled := gbxIRRF.Enabled;

  gbxISSQN     .Enabled := not bloquear;
  edtISSRetido .Enabled := gbxISSQN.Enabled;

  gbxPISRetido .Enabled := not bloquear;
  edtPISRetido .Enabled := gbxPISRetido.enabled;

  gbxPISCOFINSCSLL .Enabled := not bloquear;
  edtPIS_COFINS_CSLL .Enabled := gbxPISCOFINSCSLL.enabled;


end;

procedure TfrmCadastroNotasFiscais.VenctosImpostosRetidosEntradasAfterOpen(
  Sender: TObject);
var
  vLancamentosFiliais: TtecLancamentosContasEntradas;
begin
  BloquearValores(true);
  with dtmCadastroNotasFiscais do

  if ((dtmCadastroNotasFiscais.CodigoFiscal mod 1000) = cfSERVICOTRANSPORTE) then
  begin
    for vLancamentosFiliais := lceCOFINSretida to lcePIS_COFINS_CSLL do
    begin
      if qryVenctosImpostosRetidosEntradas.Locate('Descricao', FilialContasEntradas[vLancamentosFiliais],[]) then
      begin
        case vLancamentosFiliais of
          lceCOFINSretida : begin
                              gbxCofinsRetida.Enabled := true;
                              edtCofinsRetido.Enabled := gbxCofinsRetida.Enabled;
                            end;
          lceCSLLretida   : begin
                              gbxCSLLRetida  .Enabled := true;
                              edtCSLLRetido  .Enabled := gbxCSLLRetida.Enabled;
                            end;
          lceINSSRetido   : begin
                              gbxINSS  .Enabled := true;
                              edtINSSRetido  .Enabled := gbxINSS.Enabled;
                            end;
          lceIRRetido     : begin
                              gbxIRRF    .Enabled := true;
                              edtIRRetido.Enabled := gbxIRRF.Enabled;
                            end;
          lceISSRetido    : begin
                              gbxISSQN    .Enabled := true;
                              edtISSRetido.Enabled := gbxISSQN.Enabled;
                              if (dtmCadastroNotasFiscais.qryVenctosImpostosRetidosEntradasfornecedor.AsInteger = 0) and
                                 edtISSRetido.Enabled and not dtmCadastroNotasFiscais.qryNotaFiscalissretido.ReadOnly then
                                sbnPesquisarFornecedorParaISS.Visible := true
                              else
                                sbnPesquisarFornecedorParaISS.Visible := false;
                            end;

          lcePISRetido    : begin
                              gbxPISRetido.Enabled := true;
                              edtPISRetido.Enabled := gbxPISRetido.enabled;
                            end;

      lcePIS_COFINS_CSLL : begin
                              gbxPISCOFINSCSLL.Enabled := true;
                              edtPIS_COFINS_CSLL.Enabled := gbxPISCOFINSCSLL.enabled;
                          end;
        end;
      end;
    end;
  end;
end;

procedure TfrmCadastroNotasFiscais.Action1Update(Sender: TObject);
begin
  inherited;
  with dtmCadastroNotasFiscais do
  begin
    sbnImprimirAutorizacao.enabled := ExisteDuplicatasemAberto and not (qryNotaFiscal.State in [dsinsert, dsedit]);
    sbnEspelhoNota.Enabled := not qryNotaFiscal.IsEmpty;
    
    if sbnManutencaoPrecos.visible then
      sbnManutencaoPrecos.enabled := not qryProdutosNotaFiscal.IsEmpty;
{
    sbnExcluir.Enabled := ((CodigoFiscal mod 1000) <> ctDEVOLUCAO) and
                          not (NotaCancelada) and
                          not (ExisteQuitacaoImpostosRetidosDuplicatas or
                               ExisteQuitacaoImpostosRetidosNotas);}

    sbnExcluir.Enabled  := (UsuarioLogin.AlterarDadosContabeis or  UsuarioLogin.Pagamento);


    sbnGerarDuplicatas.Enabled:= ((CodigoFiscal mod 1000) <> ctDEVOLUCAO) and
                              not (NotaCancelada) and
                              not (ExisteQuitacaoImpostosRetidosDuplicatas or
                                   ExisteQuitacaoImpostosRetidosNotas) and
                              not (SomenteLeituraDuplicata);

    sbnExcluirDuplicatas.Enabled  := sbnGerarDuplicatas.Enabled;
    sbnIncluirDuplicatas.Enabled  := sbnGerarDuplicatas.Enabled;




{    sbnIncluirImposto.Enabled := not notacancelada and
                                 not SomenteLeituraImpostos;
    sbnExcluirImposto.Enabled := sbnIncluirImposto.Enabled; }
{    sbnIncluirAliquotasImpostos.Enabled := sbnIncluirImposto.Enabled;}


    sbnIncluirProduto.enabled := not notacancelada and
                                 not SomenteLeituraProdutos and
                                 not IncluindoViaXml and
                                 not IncluidoViaXml;

    sbnExcluirProduto.Enabled := sbnIncluirProduto.enabled;

    {
    fraLancamentoContabilidade.sbnIncluirLancamento.Enabled := not notacancelada and
                                not SomenteLeituraContabilidade;

    fraLancamentoContabilidade.sbnExcluirLancamento.Enabled :=
        fraLancamentoContabilidade.sbnIncluirLancamento.Enabled;

    fraLancamentoContabilidade.sbnGerarLancamento.Enabled :=
        fraLancamentoContabilidade.sbnIncluirLancamento.Enabled;
}        

    tstAdicoes.Enabled            := qryDadosImportacoesnumero.AsString <> '';
    tstProdutosImportacao.Enabled := tstAdicoes.Enabled and not qryAdicoesImportacao.IsEmpty;

    sbnGerarImportacao.Enabled := tstAdicoes.Enabled and not qryAdicoesImportacao.IsEmpty and not qryProdutosImportados.IsEmpty and
                                  not qryProdutosNotaFiscal.ReadOnly;

    sbnIncluirAdicoes.Enabled := not qryAdicoesImportacao.ReadOnly;
    sbnExcluirAdicoes.Enabled := not qryAdicoesImportacao.ReadOnly;
    sbnInlcuirProdutosImportados.Enabled := not qryProdutosImportados.ReadOnly;
    sbnExcluirProdutosImportados.Enabled := not qryProdutosImportados.ReadOnly;

    edtChaveNFe.TabStop := not dtmCadastroNotasFiscais.qryNotaFiscalchv_nfe.ReadOnly;
    edtChaveNFe.Enabled := edtChaveNFe.TabStop;

//    flkPedido.ReadOnly := dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsproduto.AsInteger = 0;
//    sbnProcurarPedido.enabled := not flkPedido.ReadOnly;

    tstProdutosNFE.TabVisible := (dtmCadastroNotasFiscais.IncluidoViaXml or
                                  dtmCadastroNotasFiscais.IncluindoViaXml) and
                                  not dtmCadastroNotasFiscais.qryProdutosNotasPagNFE.isempty;


    //sbnLerXMLNfe.Enabled := qryNotaFiscal.IsEmpty;

    if {(dbgProdutosNotasPagNFEItems.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsproduto) or
       (dbgProdutosNotasPagNFEItems.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsprodutovisual)  or}
       
       (dbgProdutosNotasPagNFEItems.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsprodutodigitado) or
       (dbgProdutosNotasPagNFEItems.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsdescricaoproduto) or
       (dbgProdutosNotasPagNFEItems.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsncmempresa) or
       (dbgProdutosNotasPagNFEItems.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemspedido) or
       (dbgProdutosNotasPagNFEItems.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemscodigofiscal) or
       (dbgProdutosNotasPagNFEItems.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsdescricaocodigofiscal) or
       (dbgProdutosNotasPagNFEItems.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsnatureza) or
       (dbgProdutosNotasPagNFEItems.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsdescricaonatureza) or
       (dbgPedidosNFE.SelectedField = dtmCadastroNotasFiscais.qryPedidosNotasPagpedido)  then
      stbMensagemGridNFE.Panels[0].Text := 'Pressione CTRL+F9 para pesquisar'
    else
      stbMensagemGridNFE.Panels[0].Text := '';

    sbnLerXMLNfe.Enabled := sbnIncluir.Enabled;


    if pgcProdutos.ActivePage = tstProdutosNFE then
    begin
      dbgProdutosNFE.ColumnByName('csticms').Visible := qryProdutosNotasPagNFEcsticms.visible;
      dbgProdutosNFE.ColumnByName('csosn').Visible := qryProdutosNotasPagNFEcsosn.visible;
      dbgProdutosNFE.ColumnByName('pCredSN').Visible := qryProdutosNotasPagNFEpCredSN.visible;
      dbgProdutosNFE.ColumnByName('vCredICMSSN').Visible := qryProdutosNotasPagNFEvCredICMSSN.visible;
    end;

    pnlPedidosNFE.Visible := (pgcProdutos.ActivePage = tstProdutosNFE) and (pgcNotasPag.ActivePage = tstprodutos);

    sbnConciliarProdutosPedidos_x_ProdutosNFE.Enabled := qryPedidosNotasPag.RecordCount <> 0;
    sbnIncluirnalistadepedidos.Enabled := not (qryPedidosNotasPag.state = dsinsert);
    sbnExcluirdaListadePedidos.Enabled := qryPedidosNotasPag.RecordCount <> 0;

    tstDetalhesNFE.TabVisible := dtmCadastroNotasFiscais.CondicaoEmissorNFE;

    if (dtmCadastroNotasFiscais.qrynotafiscal.state = dsinsert) and
       (dtmCadastroNotasFiscais.qryProdutosNotaFiscal.isempty) then
    begin
      rgpFinalidadeNFE.enabled := true;
      rbnNormal.tabstop := true;
    end
    else
    begin
      rgpFinalidadeNFE.enabled := false;
      rbnNormal.tabstop := false;
    end;

    tstReferenciada.tabvisible := qryNotaFiscalexigenotareferenciada.asboolean or (qryNotaFiscalfinalidadenf.asinteger = 3);

    sbnConferir.Enabled := {not sbnSalvar.enabled and} (dtmCadastroNotasFiscais.qryProdutosNotaFiscal.recordcount <> 0);

    sbnIncluirLotes.enabled := not (qryprodutosnotaspagnfelotes.state in [dsinsert, dsedit]);
    sbnExcluirLotes.enabled := sbnIncluirLotes.enabled;
    sbnRefazerLotes.enabled := sbnIncluirLotes.enabled and (qryprodutosnotaspagnfelotes.recordcount<>0);

    sbnConfirmarLotes.enabled := (qryprodutosnotaspagnfelotes.state in [dsinsert, dsedit]);




  end;
end;

