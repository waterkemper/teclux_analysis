  Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;
  if Shift = [ssCtrl] then
  begin
    case Key of
      TeclaEditarRegistro : IncluirProdutoImportado(True);
      TeclaInserirRegistro: IncluirProdutoImportado(False);
    end;
  end;
end;

