procedure TfrmCadastroNotasFiscais.dbgImpostosDblClick(Sender: TObject);
begin
  inherited;
  IncluirImpostosNotaFiscal(True)
end;
}

{
procedure TfrmCadastroNotasFiscais.dbgImpostosKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;
  if Shift = [ssCtrl] then begin
    case Key of
      TeclaEditarRegistro : IncluirImpostosNotaFiscal(True);
      TeclaInserirRegistro: IncluirImpostosNotaFiscal(False);
    end;
  end;
end;
}

procedure TfrmCadastroNotasFiscais.dbgProdutosNotaFiscalDblClick(Sender: TObject);
begin
  inherited;
//  if dbgProdutosNotaFiscal.SelectedIndex = 31 then
  if dbgProdutosNotaFiscal.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotaFiscalpermitiratualizardigitado then
    dtmCadastroNotasFiscais.PermitirAtualizarDigitado := not dtmCadastroNotasFiscais.PermitirAtualizarDigitado
  else
  begin
    if dtmCadastroNotasFiscais.qryProdutosNotaFiscal.IsEmpty then
    begin
      if sbnIncluirProduto.Enabled then
        IncluirProdutosNotaFiscal(False);
    end
    else
       IncluirProdutosNotaFiscal(True);
  end;
end;

procedure TfrmCadastroNotasFiscais.dbgProdutosNotaFiscalKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;
  if Shift = [ssCtrl] then
  begin
    case Key of
      TeclaEditarRegistro :
      begin
        if dtmCadastroNotasFiscais.qryProdutosNotaFiscal.IsEmpty then
        begin
          if sbnIncluirProduto.Enabled then
            IncluirProdutosNotaFiscal(False);
        end
        else
          IncluirProdutosNotaFiscal(True);
      end;
      TeclaInserirRegistro:
      begin
        if sbnIncluirProduto.Enabled then
          IncluirProdutosNotaFiscal(False);
      end;

      VK_SPACE: //if dbgProdutosNotaFiscal.SelectedIndex = 17 then
                if dbgProdutosNotaFiscal.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotaFiscalpermitiratualizardigitado then
                   dtmCadastroNotasFiscais.PermitirAtualizarDigitado := not dtmCadastroNotasFiscais.PermitirAtualizarDigitado;
    end;
  end
  else
  if key = VK_F11 then
    sbnAcionarTelaFormacaoPrecoVendaClick(nil);
end;

destructor TfrmCadastroNotasFiscais.Destroy;
begin

  AclHabilitar.Actions[0].OnExecute := nil;
  Action1.OnExecute := nil;

  dtmCadastroNotasFiscais.Fecha(ctTabelaCadastroNotaFiscal);

  if assigned(frmManutencaoPreco) then
    freeandnil(frmManutencaoPreco);
  
  inherited;
  {
  dtmCadastroNotasFiscais := nil;
  frmCadastroNotasFiscais := nil;
  }
end;

procedure TfrmCadastroNotasFiscais.edtBaseICMSKeyPress(Sender: TObject; var Key: Char);
begin
  inherited;
  Key:= Converte(Key);
end;

procedure TfrmCadastroNotasFiscais.edtICMSKeyPress(Sender: TObject; var Key: Char);
begin
  inherited;
  Key:= Converte(Key);
end;

function TfrmCadastroNotasFiscais.ExisteInformacao(Parametro: Integer; NomeCampo: String; Value: Variant): Boolean;
begin
  Result := false;
  with dtmCadastroNotasFiscais do
  begin
    case TipoProcura of
      pnfFORNECEDOR:        Result := ExisteFornecedor          (NomeCampo, Value);
      pnfEVENTO:            Result := ExisteEvento              (NomeCampo, Value);
      pnfSERIE:             Result := ExisteSerieFornecedor     (NomeCampo, Value);
      pnfNATUREZA:          Result := ExisteNatureza            (NomeCampo, Value);
      pnfCONHECIMENTOFRETE: Result := ExisteConhecimentoFrete   (NomeCampo, Value);
      pnfTRANSPORTADOR:     Result := ExisteFornecedorTransporte(NomeCampo, Value);
      pnfESTADOPLACA:       Result := ExisteEstado              (NomeCampo, Value);
      pnfPRODUTONFE:        Result := ExisteProdutoNotaFiscal(NomeCampo, Value);
      pnfPEDIDOPRODUTONFE:  Result := ExistePedidoProdutoNFE(NomeCampo, Value);
      pnfPEDIDONOTASPAG:    Result := ExistePedidoNotaFiscal(NomeCampo, Value);
      pnfNATUREZAPRODUTONFE: Result := ExisteNatureza(NomeCampo, Value);
      pnfNOTAFISCAL :
      begin
        case Parametro of
         -1: Result := ExisteNotaFiscal(NomeCampo, Value);
          0: Result := ExisteFornecedor(NomeCampo, Value);
          1: Result := ExisteSerieFornecedor(NomeCampo, Value);
        end;
      end;
    end;
  end;
  
end;

procedure TfrmCadastroNotasFiscais.flkNaturezaOperacaoExit(Sender: TObject);
var
 vResult : integer;
begin
  inherited;
  vResult := mrOK;
  if dtmCadastroNotasFiscais.QuantidadeNaturezas then
    vresult := InternoPesquisar(flkNaturezaOperacao,ctCODIGOFISCAL);

  if vResult = mrOk then
  begin
    tstProdutos.TabVisible        := dtmCadastroNotasFiscais.TipoMovimentoNatureza <> '';
    tstFrete.TabVisible           := tstProdutos.TabVisible;
    tstImpostosRetidos.TabVisible := ((dtmCadastroNotasFiscais.CodigoFiscal mod 1000) = cfSERVICOTRANSPORTE);
    tstTransportador.TabVisible   := dtmCadastroNotasFiscais.TipoMovimentoNatureza <> '';
    if not tstImpostosRetidos.TabVisible then
      dtmCadastroNotasFiscais.LimparRetencoes
    else
      if ParSistema.GeracaoAutomaticadoImpostoRetido then
        VenctosImpostosRetidosEntradasAfterOpen(nil);
    tstDuplicatas.TabVisible      := dtmCadastroNotasFiscais.GerarDocumentoPag;
    tstContabilidade.TabVisible := ParSistema.GerarContabilidade;
    pgcNotasPag.ActivePage := tstDadosNota;
  {  sbnCustoePrecoVenda.visible := dtmCadastroNotasFiscais.VerificarPrecoVenda;}
    gbxNfSaida.Visible := dtmCadastroNotasFiscais.VisualizarGrade;

    tstImportacao.TabVisible := dtmCadastroNotasFiscais.Importacao_;

    if dtmCadastroNotasFiscais.NotaReferenciada and
       dtmCadastroNotasFiscais.qryNotaFiscaldadofiscalreferenciado.IsNull then
    begin
      pgcNotasPag.ActivePage := tstDadosNota;
      tstReferenciada.tabVisible := true;
      pgcDetalhes.ActivePage := tstReferenciada;
      fraConsultaSerieSaida.edfcodigo.setfocus;
    end;
  end;
end;

var
  FornecAnt: String;

procedure TfrmCadastroNotasFiscais.flkNotaFiscalEnter(Sender: TObject);
begin
  inherited;
//  FornecAnt := Trim(flkFornecedor.Text);
  CodClienteAnt := dtmCadastroNotasFiscais.qryProcuraFornecedorescodigo.AsInteger;
  TipoClienteAnt := dtmCadastroNotasFiscais.qryProcuraFornecedorestipo.AsString;
end;

procedure TfrmCadastroNotasFiscais.flkNotaFiscalExit(Sender: TObject);
begin
  inherited;
//  dtmCadastroNotasFiscais.SomenteLeitura := false; // Not dtmCadastroNotasFiscais.IncluindoNota;
//  if not dtmCadastroNotasFiscais.EntradaViaXML then
    if ((CodClienteAnt <> dtmCadastroNotasFiscais.qryProcuraFornecedorescodigo.AsInteger) or
        (TipoClienteAnt <> dtmCadastroNotasFiscais.qryProcuraFornecedorestipo.AsString)) or

        ((CodClienteAnt=0) and (TipoclienteAnt='') and
         (dtmCadastroNotasFiscais.qryProcuraFornecedorescodigo.AsInteger<>0) and
         (dtmCadastroNotasFiscais.qryProcuraFornecedorestipo.AsString<>'')) then
    begin
      dtmCadastroNotasFiscais.ExibirFicha(ClassName);
      {
      flkFornecedor.setfocus;
      flkFornecedor.selectall;
      }

    end;

end;

procedure TfrmCadastroNotasFiscais.flkNotaFiscalFound(Found: Boolean);
begin
  inherited;
  dtmCadastroNotasFiscais.SomenteLeitura := false;
  dtmCadastroNotasFiscais.SetarFornecedorPedido;

  if Found then
  begin

    edtDataLancamento.Minimo := dtmCadastroNotasFiscais.NDiasLimiteLancto;
    if dtmCadastroNotasFiscais.IncluindoNota then
      edtDataEmissao.Minimo    := ParSistema.DiasNotaRetroativa
    else
    begin
      dtmCadastroNotasFiscais.ReFazConsultaDetalhesNotaFiscal;
      edtDataEmissao.Minimo := DaysBetween(dtmCadastroNotasFiscais.DataServidor,
         (dtmCadastroNotasFiscais.qryNotaFiscalemissao.AsDateTime -
          ParSistema.DiasNotaRetroativa));
      flkNaturezaOperacaoExit(nil);
    end;

    pgcNotasPag.ActivePage := tstDadosNota;

    flkSerieNota.Group := 'NotaFiscal';
    flkNotaFiscal.Group := 'NotaFiscal';

    ControlarEdicaoPISCOFINSCSLL;
  end

  else
  if (flkFornecedor.Text = '') and (flkSerieNota.Text = '') and (flkNotaFiscal.Text = '') then
  begin
    edtCNPJCPF.clear;
    dtmCadastroNotasFiscais.LimparDetalhesNotaFiscal(False);
  end;

  if dtmCadastroNotasFiscais.TipoPessoa = tsFISICA then 
    gbxCNPJ.Caption  := 'CPF MF'
  else
  if dtmCadastroNotasFiscais.TipoPessoa = tsJURIDICA then
    gbxCNPJ.Caption  := gbxCNPJCaption;
end;

procedure TfrmCadastroNotasFiscais.flkSerieNotaEnter(Sender: TObject);
begin
  inherited;
  if (FornecAnt <> Trim(flkFornecedor.Text)) and (FornecAnt<>'') and  (Trim(flkFornecedor.Text)<>'') then
    if Not flkSerieNota.Exist then
      flkSerieNota.Text := '';
end;

function TfrmCadastroNotasFiscais.IncluirDuplicataNotaFiscal(Editar:Boolean): Boolean;
begin
  if sbnIncluirDuplicatas.Enabled then
  begin
    if dtmCadastroNotasFiscais.TabelaNotaFiscalVazia then
      Result := False
    else
    begin
      frmCadastroDuplicatas := TfrmCadastroDuplicatas.Create(frmCadastroDuplicatas, dtmCadastroNotasFiscais);
      //comentado por JR, fazer uma rotina depois, tanto para essa geraçao como para a automatica
      //sempre que a data for menor do que a do lancto alertar o usuario, mas deixar passar.
      if edtDataEmissao.DataValida then
        frmCadastroDuplicatas.DataMinima := StrToDate(edtDataEmissao.Text);
      Result := dtmCadastroNotasFiscais.IncluirDuplicataNotaFiscal(Editar);
      frmCadastroDuplicatas.ShowModal;
      frmCadastroDuplicatas.Free;
      dtmCadastroNotasFiscais.CancelarDuplicatas;
    end;
    dbgDuplicatas.SetFocus
  end else
    Result := False
end;

{
function TfrmCadastroNotasFiscais.IncluirImpostosNotaFiscal(Editar:Boolean): Boolean;
begin
  if not dtmCadastroNotasFiscais.SomenteLeituraImpostos then
  begin
    if dtmCadastroNotasFiscais.TabelaNotaFiscalVazia then
      Result := False
    else
    begin
      frmCadastroImpostosNotaFiscal := TfrmCadastroImpostosNotaFiscal.Create(Self);
      Result := dtmCadastroNotasFiscais.IncluirImpostosNotaFiscal(Editar);
      frmCadastroImpostosNotaFiscal.ShowModal;
      frmCadastroImpostosNotaFiscal.Free;
      dtmCadastroNotasFiscais.CancelarImpostos
    end;
    dbgImpostos.SetFocus
  end
  else
    Result := False
end;
}

function TfrmCadastroNotasFiscais.IncluirProdutosNotaFiscal(Editar:Boolean): Boolean;
//var
//  frmCadastroProdutosNotaFiscal: TfrmCadastroProdutosNotaFiscal;
begin
  if not dtmCadastroNotasFiscais.SomenteLeituraProdutos then
  begin
    if not assigned(frmCadastroProdutosNotaFiscal) then
    if visulizandoCustoePrecoVenda then
      sbnCustoePrecoVendaClick(nil);

    if dtmCadastroNotasFiscais.TabelaNotaFiscalVazia then
      Result := False
    else
    begin
      if dtmCadastroNotasFiscais.NotaReferenciada and
         (dtmCadastroNotasFiscais.qryNotaFiscaldadofiscalreferenciado.asinteger = 0) then
      begin
//        rgpFinalidadeNFEClick(nil);

        pgcNotasPag.ActivePage := tstDadosNota;
        tstReferenciada.tabVisible := true;
        pgcDetalhes.ActivePage := tstReferenciada;
        fraConsultaSerieSaida.edfcodigo.setfocus;

        MensagemAviso('Informe a nota fiscal referenciada');
        result := false;
      end
      else
        result := true;

      if result then
      begin
        frmCadastroProdutosNotaFiscal := TfrmCadastroProdutosNotaFiscal.Create(frmCadastroProdutosNotaFiscal, dtmCadastroNotasFiscais);
        frmCadastroProdutosNotaFiscal.DataSet := dtmCadastroNotasFiscais.qryProdutosNotaFiscal;
        Result := dtmCadastroNotasFiscais.IncluirProdutosNotaFiscal(Editar);

        dtmCadastroNotasFiscais.ExecutarScrollTabelaProdutos := True;

        if dtmCadastroNotasFiscais.EntradaporPedido and
           not (dtmCadastroNotasFiscais.qryNotaFiscalfinalidadenf.asinteger in [3,4]) then
          frmCadastroProdutosNotaFiscal.pgcEntrada.ActivePage := frmCadastroProdutosNotaFiscal.tstEntradaPedido
        else
        begin
          dtmCadastroNotasFiscais.FechaTabelas_PesquisarNota;
          frmCadastroProdutosNotaFiscal.pgcEntrada.ActivePage := frmCadastroProdutosNotaFiscal.tstEntradaNotas;

          if (dtmCadastroNotasFiscais.qryNotaFiscalfinalidadenf.asinteger in [3,4]) or
             (dtmCadastroNotasFiscais.qryNotaFiscalrequernfsaida.AsBoolean) then
          begin
            frmCadastroProdutosNotaFiscal.gbxFilial.Enabled := true;
            frmCadastroProdutosNotaFiscal.gbxSerieNF.Enabled := true;
            frmCadastroProdutosNotaFiscal.gbxNumeroNF.Enabled := true;
            frmCadastroProdutosNotaFiscal.gbxDataInicial.Enabled := true;
            frmCadastroProdutosNotaFiscal.gbxDataFinal.Enabled := true;
          end
          else
          begin
            frmCadastroProdutosNotaFiscal.gbxFilial.Enabled := false;
            frmCadastroProdutosNotaFiscal.gbxSerieNF.Enabled := false;
            frmCadastroProdutosNotaFiscal.gbxNumeroNF.Enabled := false;
            frmCadastroProdutosNotaFiscal.gbxDataInicial.Enabled := false;
            frmCadastroProdutosNotaFiscal.gbxDataFinal.Enabled := false;
            frmCadastroProdutosNotaFiscal.ActiveControl := frmCadastroProdutosNotaFiscal.flkCodigoProduto;
            frmCadastroProdutosNotaFiscal.flkCodigoProduto.SelectAll;
          end;

          dtmCadastroNotasFiscais.AbreTabelas_pesquisarNota;
        end;

  //      frmCadastroProdutosNotaFiscal.flkProduto.Exist;
  //      dtmCadastroNotasFiscais.ReFazConsulta(dtmCadastroNotasFiscais.qryProcuraNaturezasProduto,[],[]);

  //      frmCadastroProdutosNotaFiscal.flkNaturezaProduto.Exist;
        frmCadastroProdutosNotaFiscal.ShowModal;

        {
        if frmCadastroProdutosNotaFiscal.modalresult = mrOk then

        else
        }


        frmCadastroProdutosNotaFiscal.Free;
        dtmCadastroNotasFiscais.AtualizaSQLProdutosExistenteNotas;
        dtmCadastroNotasFiscais.ExecutarScrollTabelaProdutos := False;
      end;
    end;
    if result then
      dbgProdutosNotaFiscal.SetFocus;
  end
  else
    Result := False
end;

function TfrmCadastroNotasFiscais.InternoExcluir: Boolean;
begin
  if CtrlOn then
  begin
    if dtmCadastroNotasFiscais.SomenteLeitura then
      Result:= False
    else
    begin
      Result:= False;
      case TipoCadastro of
        cnfDuplicata:
          if (ActiveControl = dbgDuplicatas) then
          begin
            result := not dtmCadastroNotasFiscais.SomenteLeituraDuplicata;
            if result then  Result := dtmCadastroNotasFiscais.ExcluirDuplicataNotaFiscal;
          end;
        cnfProduto:
          if (ActiveControl = dbgProdutosNotaFiscal) then
          begin
            result := not dtmCadastroNotasFiscais.SomenteLeituraProdutos;
            if result then Result := dtmCadastroNotasFiscais.ExcluirProdutosNotaFiscal;
          end;
{        cnfImpostos:
          if (ActiveControl = dbgImpostos) then
          begin
            result := not dtmCadastroNotasFiscais.SomenteLeituraImpostos;
            if result then Result := dtmCadastroNotasFiscais.ExcluirImpostoNotaFiscal;
          end;}
      end
    end
  end
  else
  begin


    inherited InternoExcluir;
    result := dtmCadastroNotasFiscais.VerificarBloqueiodaTabela;

    if result then
    begin
      Result:= dtmCadastroNotasFiscais.ExcluirNotaFiscal;
      if result then
      begin
        if ParSistema.GerarContabilidade then
        begin
          fraLancamentoContabilidade.ApagarLancamentos;
          fraLancamentoContabilidade.GerarLancamentosP_Dupla(false);
        end;

        dtmCadastroNotasFiscais.PerpetrarExclusao;

        dtmCadastroNotasFiscais.CancelarNFe;
      end;
    end;
  end
end;

function TfrmCadastroNotasFiscais.InternoGravar: Boolean;
var
  Erro: Integer;
//  BaseICMS,
//  ICMS: Real;
//  Frm: TForm;


  function VerificarCHV_NFE: boolean;
  begin
    result := true;
    if trim(edtChaveNFe.Text) <> '' then
    begin
      if (length(trim(SomenteNumero(edtChaveNFe.Text))) <> 44) and
         (length(trim(SomenteNumero(edtChaveNFe.Text))) <> 0)  then
      begin
        result := false;
        MensagemErro('O tamanho campo CHAVE DA NFE deve ter 44 caracteres.');
        edtChaveNFe.SetFocus;
      end
      else
      if not (PossuiSomenteNumero(copy(edtChaveNFe.Text, 3, 4)) and
              (copy(edtChaveNFe.Text, 3, 4) = FormatDateTime('YYMM',dtmCadastroNotasFiscais.qryNotaFiscalemissao.AsDateTime))) then
      begin
        result := false;
        MensagemErro('O ano e mês do campo CHAVE DA NFE difere da nota fiscal.');
        edtChaveNFe.SetFocus;
      end
      (*
      else
      if not (PossuiSomenteNumero(copy(edtChaveNFe.Text, 7, 14)) and
              PossuiSomenteNumero(edtCNPJCPF.Text) and
             (copy(edtChaveNFe.Text, 7, 14) = somentenumero(edtCNPJCPF.Text))) and
{
             (dtmCadastroNotasFiscais.qryNotaFiscalcodigofiscal.AsInteger -
             (dtmCadastroNotasFiscais.qryNotaFiscalcodigofiscal.AsInteger mod 1000) <> 3000)
}
              not dtmCadastroNotasFiscais.qryNotaFiscalPermitirImprimir.asboolean  then //não seja nota emitida na própria empresa
      begin
        result := false;
        MensagemErro('O cnpj do campo CHAVE DA NFE difere do cnpj da nota fiscal.');
        edtChaveNFe.SetFocus;
      end
      *)
      else
      if not (PossuiSomenteNumero(copy(edtChaveNFe.Text, 23, 3)) and
              PossuiSomenteNumero(flkSerieNota.Text) and
              (strtoint(SomenteNumero(copy(edtChaveNFe.Text, 23, 3))) = strtoint(flkSerieNota.Text))) then
      begin
        result := false;
        MensagemErro('A série do campo CHAVE DA NFE difere da série da nota fiscal.');
        edtChaveNFe.SetFocus;
      end
      else
      if not (PossuiSomenteNumero(copy(edtChaveNFe.Text, 26, 9)) and
              PossuiSomenteNumero(flkNotaFiscal.Text) and
              (strtoint(SomenteNumero(copy(edtChaveNFe.Text, 26, 9))) = strtoint(flkNotaFiscal.Text))) then
      begin
        result := false;
        MensagemErro('O número da NF do campo CHAVE DA NFE difere do número da nota fiscal.');
        edtChaveNFe.SetFocus;
      end
      else
      if not (PossuiSomenteNumero(copy(edtChaveNFe.Text, 1, 43)) and
              (modulo11(SomenteNumero(copy(edtChaveNFe.Text, 1, 43))) = copy(edtChaveNFe.Text, 44,1))) then
      begin
        result := false;
        MensagemErro('O dígito verificador do campo CHAVE DA NFE está incorreto.');
        edtChaveNFe.SetFocus;
      end;
    end
    else
    if dtmCadastroNotasFiscais.EhNfeouCTE then
    begin
      if dtmCadastroNotasFiscais.IncluindoNota and
         dtmCadastroNotasFiscais.qryNotaFiscalpermitirimprimir.AsBoolean then
       result := true
      else
      begin
        result := false;
        MensagemErro('O campo CHAVE DA NFE é obrigatorio.');
        edtChaveNFe.SetFocus;
      end;
    end;

  end;

begin
  Erro:= -1;
  Result := dtmCadastroNotasFiscais.VerificarBloqueiodaTabela;

  if result then
  begin
    if dtmCadastroNotasFiscais.ValidarCNPJ(edtCNPJCPF.Text) then
    begin
     if (ActiveControl is TtecFindCustom) and
        (TtecFindCustom(ActiveControl).Text <> '') and
        (dtmCadastroNotasFiscais.IncluindoNota) then
     begin
        if ActiveControl = flkFornecedor then
          Result:= flkFornecedor.Exist and flkSerieNota.Exist
        else if ActiveControl = flkSerieNota then
                Result:= flkSerieNota.Exist
             else
             if ActiveControl = flkNotaFiscal then
                Result:= flkNotaFiscal.Exist;
     end;

     if result then
     begin
       if parsistema.gerarcontabilidade then
         result := fraLancamentoContabilidade.VerificarLancamentosContabeis;
         
       if not result then
         erro := 4;
     end;

     if result then
       Result := VerificarCHV_NFE;

     if Result then begin
        Result:= inherited InternoGravar;
        if Result then begin
    //           BaseICMS := edtBaseICMS.ValorSemFormatacao;
    //           ICMS     := edtICMS.ValorSemFormatacao;
           result := dtmCadastroNotasFiscais.GravarNotaFiscal(Erro);
        end
     end;

     if (Erro > -1)  then begin
        case Erro of
        0: begin
              pgcNotasPag.ActivePage:= tstProdutos;
              ActiveControl:= dbgProdutosNotaFiscal;
           end;
        1: begin
              pgcNotasPag.ActivePage:= tstDuplicatas;
              ActiveControl:= dbgDuplicatas;
           end;
    {        2: begin
              pgcNotasPag.ActivePage:= tstImpostos;
              ActiveControl:= dbgImpostos;
           end;                           }
        3: begin
             pgcNotasPag.ActivePage := tstProdutos;
             if not visulizandoCustoePrecoVenda then
                VisualizarPaineisCusto;
           end;
        4: begin
              pgcNotasPag.ActivePage:= tstContabilidade;
              ActiveControl:= fraLancamentoContabilidade.dbgContabilidade;
           end;
        5: begin
              pgcValoresNota.ActivePage:= tstImpostosRetidos;
              ActiveControl := edtISSRetido;
           end;
           (*
        6:  //evento não informado qdo existe duplicatas e integrado com bancos
             pgcNotasPag.ActivePage := tstDadosNota;
             *)
        end;
     end
     else
     begin
       pgcNotasPag.ActivePage:= tstDadosNota;
       if tstContabilidade.TabVisible then
         fraLancamentoContabilidade.atualizarDescricaoHistorico;
       flkSerieNota.Group := 'NotaFiscal';
       flkNotaFiscal.Group := 'NotaFiscal';
     end;
    end
    else begin
      MensagemAviso('CNPJ/CPF da Nota não informado.');
      if edtCNPJCPF.CanFocus
      then edtCNPJCPF.SetFocus;
    end;
    dbgProdutosNotaFiscal.Refresh;
  end;


  dtxCancelada.update;
  dtxCancelada.refresh;

end;

function TfrmCadastroNotasFiscais.InternoIncluir: Boolean;
begin
  if CtrlOn then
    Result := False
  else if MensagemConfirmacao('Será cadastrada uma nota de entrada emitida pela própria empresa.') = smbOK then begin
    flkSerieNota.Group := '';
    flkNotaFiscal.Group := '';
    Result := dtmCadastroNotasFiscais.IncluirNotaEntrada;
    flkFornecedor.Exist;
    flkSerieNota.Enabled      := False;
    flkNotaFiscal.Enabled     := False;
    flkFornecedor.SetControl(True);
    flkFornecedor.SetFocus;
    flkFornecedor.SelectAll;
  end else
    Result := False;

  if visulizandoCustoePrecoVenda then
    sbnCustoePrecoVendaClick(nil);
end;

function TfrmCadastroNotasFiscais.InternoPesquisar(Titulo: String): Integer;
var
  Procurar: Boolean;
  FecharTab: Integer;
  CtrlF9: Boolean;

  procedure TipoDeProcura;
  begin
    if CtrlOn then
      if flkFornecedor.Focused then
        TipoProcura := pnfFORNECEDOR
      else if flkSerieNota.Focused then
        TipoProcura := pnfSERIE
      else if flkNaturezaOperacao.Focused then
        TipoProcura := pnfNATUREZA
      else if flkEvento.Focused then
        TipoProcura := pnfEVENTO
      else if flkCodConhecFrete.Focused or
              flkSerieConhecFrete.Focused or
              flkNroConhecFrete.Focused   then
        TipoProcura := pnfCONHECIMENTOFRETE
      else if flkFornecedorTransporte.Focused then
        TipoProcura := pnfTRANSPORTADOR
      else if flkEstadoPlaca.Focused then
        TipoProcura := pnfESTADOPLACA
      else
        TipoProcura := pnfNENHUMA;
  end;

begin
  Result := mrNone;
  if CtrlOn then
  begin
    if ActiveControl is TtecFindCustom then
      if TipoProcura = pnfNENHUMA then
        TipoDeProcura;
  end;

  if (TipoProcura <> pnfNENHUMA) then
  begin
    with dtmCadastroNotasFiscais do
    begin
      if Not SomenteLeitura or (TipoProcura = pnfNOTAFISCAL) then
      begin
        Procurar := True;
        CtrlF9 := CtrlOn;
        FecharTab := -1;
        case TipoProcura of
          pnfNATUREZA: begin
                         Abre(ctTabelaNaturezaOperacoes);
                         Titulo := ctCODIGOFISCAL;
                         FecharTab := ctTabelaNaturezaOperacoes
                       end;
          pnfFornecedor: if IncluindoNota then begin
                           Abre(ctTabelasConsultaFornecedores);
                           Titulo := ctFORNECEDORES;
                           FecharTab := ctTabelasConsultaFornecedores
                         end else
                           Procurar := False;
          pnfEVENTO:  begin
                          Abre(ctTabelaConsultaEvento);
                          Titulo := ctEVENTO;
                          FecharTab := ctTabelaConsultaEvento
                        end;
          pnfSerie: if IncluindoNota then begin
                      Abre(ctTabelaConsultaSerieFornecedor);
                      Titulo := ctSERIEFORNECEDORES;
                      FecharTab := ctTabelaConsultaSerieFornecedor
                    end else
                      Procurar := False;
          pnfCONHECIMENTOFRETE: begin
                                  Abre(ctTabelaConsultaConhecimentoFrete);
                                  Titulo := 'Conhecimento de Frete';
                                  FecharTab := ctTabelaConsultaConhecimentoFrete
                                end;
          pnfNOTAFISCAL: begin
                           AbreTabelaProcuraNotaFiscal;
                           Titulo := ctNOTASFISCAIS;
                         end;
          pnfTRANSPORTADOR: begin
                              Abre(ctTabelaConsultaFornecedoresTransp);
                              Titulo := ctTRANSPORTE;
                              FecharTab := ctTabelaConsultaFornecedoresTransp
                            end;
          pnfESTADOPLACA: begin
                            Abre(ctTabelaConsultaEstado);
                            Titulo := ctESTADO;
                            FecharTab := ctTabelaConsultaEstado
                          end;

          pnfPRODUTONFE: begin
                           Titulo := ctPRODUTO;
                           dtmCadastroNotasFiscais.AbreTabelaConsultaProdutosNotaFiscal(ckbFiltrarProdutosPorFornecedor.Checked,
                                                                                        (dtmCadastroNotasFiscais.ListadePedidosMarcados<>'0') or
                                                                                        (dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemspedido.AsInteger <> 0)
                                                                                        , false, true);
                         end;

          pnfPEDIDOPRODUTONFE: begin
                                 Titulo := Format(ctPEDIDOSFORNECEDORES, ['(' + dtmCadastroNotasFiscais.NomeFornecedor + ')']);
                                 dtmCadastroNotasFiscais.AbrirConsultaPedidosProdutosNotasPagNFE;
                               end;

          pnfPEDIDONOTASPAG : begin
                                Titulo := Format(ctPEDIDOSFORNECEDORES, ['(' + dtmCadastroNotasFiscais.NomeFornecedor + ')']);
                                dtmCadastroNotasFiscais.SetarFornecedorPedido;
                                dtmCadastroNotasFiscais.qryConsultaPedidosNotaFiscal.Open;
                              end;

          pnfNATUREZAPRODUTONFE: begin
                                   Titulo := ctNATUREZAS;
                                   dtmCadastroNotasFiscais.abreConsultaNaturezaProduto;
                                 end;


          pnfNENHUMA: Procurar := False;
        end;

        if Procurar then begin
          Result := inherited InternoPesquisar(Titulo);
          if Result = mrOK then begin
            if CtrlF9 then
              case TipoProcura of
                pnfFornecedor:   begin
                                   SetarTipoFornecedor;
                                   flkFornecedor.Text := CodigoFornecedorConsultado;
                                   flkFornecedor.Exist;
                                   SetarFornecedorPedido;
                                 end;
                pnfEVENTO:       SelecionarEvento;
                pnfSerie:        begin
                                   flkSerieNota.Text := SerieFornecedorConsultado;
                                   flkSerieNota.exist;
                                 end;

                pnfNATUREZA:     SelecionarNatureza;
                pnfCONHECIMENTOFRETE: begin
                                        dtmCadastroNotasFiscais.qryConhecimentoFrete.AfterOpen := nil;
                                        flkCodConhecFrete.text := dtmCadastroNotasFiscais.qryConsultaConhecimentoFretefornecedor.AsString;
                                        flkCodConhecFrete.exist;
                                        flkSerieConhecFrete.text := dtmCadastroNotasFiscais.qryConsultaConhecimentoFreteserie.AsString;
                                        flkSerieConhecFrete.exist;
                                        flkNroConhecFrete.text := dtmCadastroNotasFiscais.qryConsultaConhecimentoFretenumero.AsString;
                                        flkNroConhecFrete.Exist;

                                        //AbrirConhecimentoFrete;
                                        SelecionarConhecimentoFrete;
                                        dtmCadastroNotasFiscais.qryConhecimentoFrete.AfterOpen := dtmCadastroNotasFiscais.qryConhecimentoFreteAfterOpen;

                                      end;
                pnfTRANSPORTADOR: SelecionarFornecedorTransporte;
                pnfESTADOPLACA: SelecionarEstadoPlaca;
                pnfPRODUTONFE : begin
                                  dtmCadastroNotasFiscais.SelecionarProdutoNFE;
                                  dbgProdutosNotasPagNFEItems.editandocelula := true;
                                end;
                pnfNATUREZAPRODUTONFE: begin
                                          with dtmCadastroNotasFiscais do
                                          begin
                                            SelecionarNaturezaProdutoNFE(dtmCadastroNotasFiscais.qryConsultaNaturezascodigo.asinteger,
                                                                                             dtmCadastroNotasFiscais.qryConsultaNaturezascodigofiscal.asinteger, true);

                                            dbgProdutosNotasPagNFEItems.editandocelula := true;
                                          end;
                                       end;

                pnfPEDIDOPRODUTONFE : begin
                                        dtmCadastroNotasFiscais.SelecionarPedidoNFE;
                                        dbgProdutosNotasPagNFEItems.editandocelula := true;
                                      end;

                pnfPEDIDONOTASPAG : dtmCadastroNotasFiscais.SelecionarPedidoNotasPag;

              end
            else
            begin
              Selecionar;
              FecharTab := -1;
            end
          end;
          if FecharTab = -1 then
          begin
            if TipoProcura = pnfPRODUTONFE then
               dtmCadastroNotasFiscais.qryConsultaProdutosNotaFiscal.close
            else
            if (TipoProcura = pnfPEDIDOPRODUTONFE) then
              dtmCadastroNotasFiscais.qryConsultaPedidosProdutoNFE.close
            else
            if(TipoProcura = pnfPEDIDONOTASPAG) then
              dtmCadastroNotasFiscais.FecharConsultaPedidosNFE
            else
            if TipoProcura = pnfNATUREZAPRODUTONFE then
               dtmCadastroNotasFiscais.fechaConsultaNaturezaProduto
            else
               FechaTabelaProcuraNotaFiscal;
          end
          else
            Fecha(FecharTab);

          TipoProcura := pnfNENHUMA;
        end else
          Result := mrNone
      end
      else
        Result := mrNone
    end;
  end;
end;

function TfrmCadastroNotasFiscais.JanelaPesquisa: TfrmConsultaBasica;
begin
  JanProc := TfrmConsultaPorCampo.Create(nil);
  Result := JanProc;
  TfrmConsultaPorCampo(Result).ConsultaInterativa := TipoProcura <> pnfPRODUTONFE;

  if TipoProcura = pnfSERIE then
    TfrmConsultaPorCampo(Result).UsarParametrosDaTabela := False
  else if TipoProcura in [pnfFORNECEDOR, pnfNOTAFISCAL] then
    TfrmConsultaPorCampo(Result).ConsultaInterativa := False
  else if TipoProcura in [pnfNATUREZA, pnfPRODUTONFE,
                          pnfPEDIDOPRODUTONFE,
                          pnfPEDIDONOTASPAG,
                          pnfNATUREZAPRODUTONFE] then
    TfrmConsultaPorCampo(Result).UsarParametrosDaTabela := False;

end;

procedure TfrmCadastroNotasFiscais.KeyDown(var Key: Word; Shift: TShiftState);
begin

  if (key = VK_F9) and not ctrlon and sbnProcurar.enabled then
    TipoProcura := pnfNOTAFISCAL;

  inherited;
  if key = VK_G then
  begin
    if Shift = [ssCtrl] then
    begin
      if pgcNotasPag.ActivePage = tstProdutos then
      begin
        if sbnVisualizarGrade.Visible then
          sbnVisualizarGradeClick(sbnVisualizarGrade);
      end
      else
      if pgcNotasPag.ActivePage = tstDuplicatas then
        sbnGerarDuplicatasClick(nil)
        {
      else
      if pgcNotasPag.ActivePage = tstImpostos then
        sbnIncluirAliquotasImpostosClick(nil)};
    end;
  end
  else
  if key = VK_V then
  begin
    if Shift = [ssCtrl] then
    begin
      if sbnCustoePrecoVenda.Visible and
         sbnCustoePrecoVenda.Enabled then
      begin
        pgcNotasPag.ActivePage := tstProdutos;
        sbnCustoePrecoVendaClick(sbnCustoePrecoVenda);
      end;
    end;
  end
  else
  if key = VK_H then
  begin
    if Shift = [ssCtrl] then
    begin
      if sbnVisualizarDetalhesProdutosNota.Visible and
         sbnVisualizarDetalhesProdutosNota.Enabled then
      begin
        pgcNotasPag.ActivePage := tstProdutos;
        sbnVisualizarDetalhesProdutosNotaClick(sbnVisualizarDetalhesProdutosNota);
      end;
    end;
  end
  else
  if key = VK_I then
  begin
    if Shift = [ssCtrl] then
    begin
      if pgcNotasPag.ActivePage = tstProdutos then
        sbnGerarTotalIPIClick(sbnGerarTotalIPI);
    end;
  end
  else
  if (key = VK_F6) and (Shift = [ssCtrl]) then
  begin
    if edfDeclaracao.CanFocus then
      sbnGerarImportacao.Click;
  end
  else
  if (key = VK_Escape) then
  begin
    flkSerieNota.Group := 'NotaFiscal';
    flkNotaFiscal.Group := 'NotaFiscal';
    flkSerieNota.Enabled      := true;
    flkNotaFiscal.Enabled     := true;
    flkFornecedor.SetControl(True);
  end
  else
  if (key = VK_F12) then
  begin
    IF sbnLerXMLNfe.Enabled THEN
      sbnLerXMLNfe.Click;
  end;

end;

procedure TfrmCadastroNotasFiscais.PosicionarTabelaNoParametro(Ind: Integer; var continuar: Boolean);
begin
  inherited;
  continuar := False;
  if not (CtrlOn {and (ActiveControl is TtecFindCustom)}) then
    case Ind of
      0: continuar := False;
      1: continuar := dtmCadastroNotasFiscais.PosicionarSerieFornecedor;
    end
end;

procedure TfrmCadastroNotasFiscais.ProximoControle(Ind: Integer);
begin
  if not (CtrlOn {and (ActiveControl is TtecFindCustom)}) then
    case Ind of
      0: begin
           JanProc.ConsultaInterativa := True;
           dtmCadastroNotasFiscais.PosicionarSerieFornecedor;
         end;
      1: begin
           JanProc.ConsultaInterativa := False;
           dtmCadastroNotasFiscais.PosicionarNotaFiscal;
         end
    end
end;

