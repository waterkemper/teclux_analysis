procedure TfrmCadastroNotasFiscais.OperacaoPadrao(Value: array of Variant);
var
  vProsseguir : Boolean;
begin
  inherited;
  if Length(Value) > 0 then
  begin
    if Value[0] = 'Abrir' then
    begin
      if ((dtmCadastroNotasFiscais.qryNotaFiscal.recordcount = 0) and (Value[1]<>0)) or
         ((dtmCadastroNotasFiscais.qryNotaFiscal.recordcount > 0) and (Value[1]<>0) and
          (Value[1] <> dtmCadastroNotasFiscais.qryNotaFiscalcodigo.asinteger) and
          (MensagemSelecionaOpcao(format('Já existe uma nota fiscal em edição. ' + chr(13) +
                                      'Ao Prosseguir as informações serão descartadas.' + chr(13) +
                                      'Abrir a nota fiscal Fornecedor: %s%s, Série %s e Número %s', [Value[2], Value[3], value[4], value[5]])) = smbYes)) then
      begin
        if (dtmCadastroNotasFiscais.qryNotaFiscal.state in [dsedit, dsinsert]) then
          dtmCadastroNotasFiscais.qryNotaFiscal.cancel;


        dtmCadastroNotasFiscais.qryProcuraFornecedores.parambyname('codigo').asString := Value[2];
        dtmCadastroNotasFiscais.qryProcuraFornecedores.parambyname('tipo').asString := Value[3];

        dtmCadastroNotasFiscais.qryProcuraSeriesFornecedor.Parambyname('fornecedor').AsInteger  := Value[2];
        dtmCadastroNotasFiscais.qryProcuraSeriesFornecedor.Parambyname('serie').AsString := Value[4];
        dtmCadastroNotasFiscais.qryProcuraSeriesFornecedor.Parambyname('tipo').AsString := Value[3];

        dtmCadastroNotasFiscais.qryNotaFiscal.Parambyname('fornecedor').AsInteger  := Value[2];
        dtmCadastroNotasFiscais.qryNotaFiscal.Parambyname('serie').AsString := Value[4];
        dtmCadastroNotasFiscais.qryNotaFiscal.Parambyname('tipofornecedor').AsString := Value[3];
        dtmCadastroNotasFiscais.qryNotaFiscal.Parambyname('numero').AsString := Value[5];

//        dtmCadastroNotasFiscais.qryNotaFiscal.open;


        flkFornecedor.text := Value[2];
        flkFornecedor.modified := true;
        flkFornecedor.doexit;
//        flkFornecedor.ForeignFound := stFound;
//        flkFornecedor.exist;


        flkSerieNota.text := Value[4];
        flkSerieNota.modified := true;
        flkSerieNota.doexit;
//        flkSerieNota.ForeignFound := stFound;
//        flkSerieNota.exist;


//        flkNotaFiscal.text := value[5];
//        flkNotaFiscal.modified := true;
//        flkNotaFiscal.doexit;
//        flkNotaFiscal.ForeignFound := stFound;

                         {
        if dtmCadastroNotasFiscais.qryNotaFiscal.recordcount = 0 then
          OperacaoPadrao(Value)
        else
          flkNotaFiscalFound(true);
          }
          


//        flkNotaFiscal.Exist;


        {


        dtmCadastroNotasFiscais.qryProcuraFornecedores.parambyname('tipo').asString := Value[3];
        dtmCadastroNotasFiscais.qryNotaFiscal.parambyname('tipofornecedor').asString := Value[3];

        flkFornecedor.Text :=  Value[2];
        flkfornecedor.setfocus;
        flkfornecedor.selectall;
      //  keybd_event(VK_RETURN,0,0,0);
        flkfornecedor.modified := true;
        flkfornecedor.DoExit;
      //  flkfornecedor.exist;



        flkSerieNota.Text := Value[4];
        flkSerieNota.setfocus;
        flkSerieNota.selectall;
      //  keybd_event(VK_RETURN,0,0,0);
        flkSerieNota.modified := true;
        flkSerieNota.doexit;
      //  flkSerieNota.exist;


        flkNotaFiscal.Text := value[5];
        flkNotaFiscal.setfocus;
        flkNotaFiscal.SelectAll;
      //  keybd_event(VK_RETURN,0,0,0);
        flkfornecedor.modified := true;
        flkSerieNota.modified := true;
        flkNotaFiscal.modified := true;
        flkNotaFiscal.doexit;
      //  flkNotaFiscal.exist;

        pgcNotasPag.ActivePage := tstDadosNota;
        pgcDetalhes.ActivePage := tstDetalhesNotaFiscal;
        flkNotaFiscal.SetControl(true);

        flkNaturezaOperacao.SetFocus;
        }

      end;
    end
    else
    if Value[0] = 'IncluiRNFeviaXML' then
    begin
      vProsseguir := true;
      if dtmCadastroNotasFiscais.qryNotaFiscal.state in [dsedit, dsinsert] then
        vProsseguir := MensagemSelecionaOpcao('Já existe uma nota fiscal de entrada em edição. ' + chr(13)+
                                               'Ao Prosseguir as informações serão descartadas.') = smbYes;

      if vProsseguir then
      begin
        pgcNotasPag.activePage := tstDadosNota;

        flkFornecedor.SetFocus;
        flkFornecedor.SelectAll;
        odlLerXMLNfe.FileName  := Value[1];
        odlLerXMLNfe.Title := 'Selecione a NFE';
        odlLerXMLNfe.DefaultExt := '*.XML';
        odlLerXMLNfe.Filter := 'Arquivos XML (*.XML)|*.XML|Arquivos NFE (*-nfe.XML)|*-nfe.XML|Arquivos TXT (*.TXT)|*.TXT|Todos os Arquivos (*.*)|*.*';

        dtmCadastroNotasFiscais.EntradaViaXML := True;
        dtmCadastroNotasFiscais.ArquivoXMLNFe := Value[1];
        dtmCadastroNotasFiscais.EntradaViaXML := False;

        Application.ProcessMessages;

        if Value[2] = 'Gravar' then
          if sbnSalvar.enabled then
            InternoGravar;

      end;

    end;

  end;

end;

