procedure TfrmCadastroNotasFiscais.edtCNPJCPFExit(Sender: TObject);
begin
  inherited;

  if (edtCNPJCPF.Text <> '') then
    if not dtmCadastroNotasFiscais.ValidarCNPJ(edtCNPJCPF.Text) then begin
      if edtCNPJCPF.CanFocus then
        edtCNPJCPF.SetFocus;
    end;
end;

procedure TfrmCadastroNotasFiscais.AfterOpenNotaFiscal(Sender: TObject);
begin
  if tstContabilidade.tabvisible then
    with fraLancamentoContabilidade do
    begin
      AbrirLancamentos('E', CodigoDocumento, dtmCadastroNotasFiscais.IncluindoNota);
{
      sbnIncluirLancamento.Enabled := not SomenteLeituraContabilidade;
      sbnExcluirLancamento.Enabled := not SomenteLeituraContabilidade;
      sbnGerarLancamento.Enabled := not SomenteLeituraContabilidade;
}      
    end;
end;

procedure TfrmCadastroNotasFiscais.sbnIncluirNFSaidaClick(Sender: TObject);
begin
  inherited;
  CtrlOn:= True;
  IncluirNotaFiscalSaida(False);;
end;

function TfrmCadastroNotasFiscais.IncluirNotaFiscalSaida(Editar: Boolean): Boolean;
begin
  frmcadastronfsaidafrete:= Tfrmcadastronfsaidafrete.Create(frmcadastronfsaidafrete, dtmCadastroNotasFiscais);
  try
    Result:= dtmCadastroNotasFiscais.IncluirNotaSaida;
    frmcadastronfsaidafrete.ShowModal;
  finally
    frmcadastronfsaidafrete.Free;
  end;
end;

procedure TfrmCadastroNotasFiscais.dbgAdicoesDrawColumnCell(
  Sender: TObject; const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  inherited;

   TDBGrid(Sender).Canvas.Font.Color:= clBlack;
    with dtmCadastroNotasFiscais do begin
     case column.Index of
        10: if abs((qryAdicoesImportacaobaseicms.AsCurrency -
                qryAdicoesImportacaobaseicmscalculada.AsCurrency))>=0.01
           then TDBGrid(Sender).Canvas.Font.Color:= clRed
           else TDBGrid(Sender).Canvas.Font.Color:= clBlack;

        12: if abs((qryAdicoesImportacaovaloricms.AsCurrency -
                qryAdicoesImportacaovaloricmscalculado.AsCurrency)) >= 0.01
           then TDBGrid(Sender).Canvas.Font.Color:= clRed
           else TDBGrid(Sender).Canvas.Font.Color:= clBlack;
     end;
     TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
  end;

  {
  if not (gdFocused in State) then
  begin
    if not dbgAdicoes.DataSource.DataSet.FieldByName('totais').AsBoolean then
      TDBGrid(Sender).Canvas.Font.Style := [];
  end;
  TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
}
end;

