procedure TfrmCadastroNotasFiscais.EntrarChavesNota(Sender: TObject);
{var vSerie: String;}
begin
{
  with dtmCadastroNotasFiscais do
    LimparDetalhesNotaFiscal(true);

    ver bu ao recelecionar nota
    }

    {
  flkFornecedor.clear;
  flkSerieNota.clear;
  flkNotaFiscal.clear;
  flkNotaFiscal.Exist;
  }



  flkFornecedor.Text := inttostr(dtmCadastroNotasFiscais.vcodigo) {dtmCadastroNotasFiscais.qryFornecedor.fieldbyname('codigo').AsString};
  flkfornecedor.setfocus;
  flkfornecedor.selectall;
//  keybd_event(VK_RETURN,0,0,0);
