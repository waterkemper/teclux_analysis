  begin
    edtValorConhecimento.text := trim(format('%8.2f',[dtmCadastroNotasFiscais.ValorConhecimentoFrete]));
    dtmCadastroNotasFiscais.ErroValorConhecimentoFrete := false;
    edtValorConhecimento.SetFocus;
    edtValorConhecimento.SelectAll;
  end;
end;

procedure TfrmCadastroNotasFiscais.flkFornecedorFound(Found: Boolean);
begin
  inherited;
  if found then
  begin
    flkSerieNota.Group := 'NotaFiscal';
    flkNotaFiscal.Group := 'NotaFiscal';
  end;
end;

procedure TfrmCadastroNotasFiscais.ExibirMensagemPadronizadaDataEmissao;
begin
  if dtmCadastroNotasFiscais.IncluindoNota then
    if strtodate(edtDataEmissao.Text) < DataLocal - edtDataEmissao.Minimo then
      MensagemAviso(format(ctDATACONTABILMAIOROUIGUALDATALANCTO, ['de emissão',
                       edtDataEmissao.Text, 'retroativa',
                       datetostr(DataLocal - edtDataEmissao.Minimo)]))
  else
    if strtodate(edtDataEmissao.Text) < DataLocal - DaysBetween(dtmCadastroNotasFiscais.DataServidor,
                                           (dtmCadastroNotasFiscais.qryNotaFiscalemissao.AsDateTime -
                                             ParSistema.DiasNotaRetroativa)) then
      MensagemAviso(format(ctDATACONTABILMAIOROUIGUALDATALANCTO, ['de emissão',
                       edtDataEmissao.Text, 'retroativa',
                       DataLocal - DaysBetween(dtmCadastroNotasFiscais.DataServidor,
                                             (dtmCadastroNotasFiscais.qryNotaFiscalemissao.AsDateTime -
                                             ParSistema.DiasNotaRetroativa) )]));
end;

procedure TfrmCadastroNotasFiscais.ExibirMensagemPadronizadaDataLancto;
begin
  if strtodate(edtDataLancamento.Text) <= ParSistema.DataContabil then
    MensagemAviso(format(ctDATACONTABILMAIORDATALANCTO, ['de lançamento',
                     edtDataLancamento.Text, 'contábil', ParSistema.DataContabilstring]))
  else
  if strtodate(edtDataLancamento.Text) < strtodate(edtDataEmissao.Text) then
    MensagemAviso(format(ctDATACONTABILMAIOROUIGUALDATALANCTO, ['de lançamento',
                     edtDataLancamento.Text, 'emissão', edtDataEmissao.Text]))
end;

