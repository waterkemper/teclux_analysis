procedure TfrmCadastroNotasFiscais.dbgAdicoesKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if Shift = [ssCtrl] then
  begin
    case Key of
      TeclaEditarRegistro : IncluirAdicao(True);
      TeclaInserirRegistro: IncluirAdicao(False);
    end;
  end;
end;

