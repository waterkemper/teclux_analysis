procedure TfrmCadastroNotasFiscais.DBAdvGridLotesCanClickCell(
  Sender: TObject; ARow, ACol: Integer; var Allow: Boolean);
begin
  inherited;

  Allow := not (dtmCadastroNotasFiscais.qryProdutosnotaspagnfelotes.state in [dsedit, dsinsert]) or
              (Arow = dtmCadastroNotasFiscais.qryProdutosnotaspagnfelotes.recno);

end;

procedure TfrmCadastroNotasFiscais.DBAdvGridLotesCanEditCell(
  Sender: TObject; ARow, ACol: Integer; var CanEdit: Boolean);
begin
  inherited;

    if Arow = dtmCadastroNotasFiscais.qryProdutosnotaspagnfelotes.recno then

      CanEdit := (dtmCadastroNotasFiscais.qryProdutosnotaspagnfelotespermitealterar.asBoolean or
                 (Acol =  DBAdvGridLotes.ColumnByFieldName['qlote'].Index))

    else
    if not (dtmCadastroNotasFiscais.qryProdutosnotaspagnfelotes.state in [dsedit, dsinsert]) then

      CanEdit := (dtmCadastroNotasFiscais.qryProdutosnotaspagnfelotespermitealterar.asBoolean or
                 (Acol =  DBAdvGridLotes.ColumnByFieldName['qlote'].Index))

    else
      CanEdit := false;

end;

procedure TfrmCadastroNotasFiscais.DBAdvGridLotesSelectCell(
  Sender: TObject; ACol, ARow: Integer; var CanSelect: Boolean);
begin
  inherited;

  CanSelect := not (dtmCadastroNotasFiscais.qryProdutosnotaspagnfelotes.state in [dsedit, dsinsert])  or
              (Arow = dtmCadastroNotasFiscais.qryProdutosnotaspagnfelotes.recno);

end;

