procedure TfrmCadastroNotasFiscais.CondicoesConsultaFornecedorISS;
begin
  ConsultaFornecedor.qryConsultaClientes.MacroByName('CondicaodaConsulta').AsString :=
   'and (select f.fornecedorparaiss from fornecedores f where f.codigo = v.codigo and v.tipo=''F'')';
end;

procedure TfrmCadastroNotasFiscais.sbnPesquisarFornecedorParaISSClick(
  Sender: TObject);
begin
  inherited;
  edtISSRetido.SetFocus;
  PesquisarFornecedorParaISS;
end;

procedure TfrmCadastroNotasFiscais.PesquisarFornecedorParaISS;
begin
  ConsultaFornecedor.CtrlOn := true;
  ConsultaFornecedor.InternoPesquisar(ctFORNECEDORES);
  ConsultaFornecedor.CtrlOn := false;
  edtISSRetido.SetFocus;
  edtISSRetido.SelectAll;
end;

procedure TfrmCadastroNotasFiscais.edtISSRetidoEnter(Sender: TObject);
begin
  inherited;
  ValorISSQN := edtISSRetido.Text;
end;

procedure TfrmCadastroNotasFiscais.edtISSRetidoExit(Sender: TObject);
begin
  inherited;
  if sbnPesquisarFornecedorParaISS.Visible then
    if dtmCadastroNotasFiscais.qryNotaFiscal.State in [dsEdit, dsInsert] then
      if ((ValorISSQN <> edtISSRetido.Text) or
          (dtmCadastroNotasFiscais.qryNotaFiscalfornecedorparaiss.IsNull)) and
         (dtmCadastroNotasFiscais.qryNotaFiscalissretido.AsCurrency<>0)  then
        PesquisarFornecedorParaISS;
end;

procedure TfrmCadastroNotasFiscais.edtISSRetidoKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if CtrlOn then
    if key = VK_F9 then
      if sbnPesquisarFornecedorParaISS.Visible then
        PesquisarFornecedorParaISS;
end;

procedure TfrmCadastroNotasFiscais.TotalizarAdicoes(Sender: TObject);
begin
  with dtmCadastroNotasFiscais do
  begin
    lblMercadoria.Caption := FormatarValor(MercadoriasAdicoes,2);
    lblFrete.Caption      := FormatarValor(FreteAdicoes,2);
    lblEmbalagem.Caption  := FormatarValor(EmbalagemAdicoes,2);
    lblTHC.Caption        := FormatarValor(THCAdicoes,2);
    lblII.Caption         := FormatarValor(IIAdicoes,2);
    lblIPI.Caption        := FormatarValor(IPIAdicoes,2);
    lblPIS.Caption        := FormatarValor(PISAdicoes,2);
    lblCOFINS.Caption     := FormatarValor(COFINSAdicoes,2);
    lblSISCOMEX.Caption   := FormatarValor(SISCOMEXAdicoes,2);
    lblBaseICMS.Caption   := FormatarValor(BaseICMSAdicoes,2);
    lblValorICMS.Caption  := FormatarValor(ValorICMSAdicoes,2);
  end;
end;

procedure TfrmCadastroNotasFiscais.ControlarEdicaoPISCOFINSCSLL;
begin
  if ParSistema.GeracaoAutomaticadoImpostoRetido then
  begin
    edtPISRetido.Enabled       := gbxPISRetido.Enabled;
    edtCofinsRetido.Enabled    := gbxCOFINSRetida.Enabled;
    edtCSLLRetido.Enabled      := gbxCSLLRetida.Enabled;
    edtPIS_COFINS_CSLL.Enabled := gbxPISCOFINSCSLL.Enabled;

    with dtmCadastroNotasFiscais do
    begin
      if ((qryNotaFiscalpisretido.AsCurrency<>0) or
          (qryNotaFiscalcofinsretido.AsCurrency<>0) or
          (qryNotaFiscalcsllretido.AsCurrency<>0)) then
        edtPIS_COFINS_CSLL.Enabled := FALSE
      else
      begin
        if (qryNotaFiscalpiscofinscsllretido.AsCurrency<>0) then
        begin
          edtPISRetido.Enabled    := false;
          edtCofinsRetido.Enabled := false;
          edtCSLLRetido.Enabled   := false;
        end;
      end;
    end;
  end;
end;

procedure TfrmCadastroNotasFiscais.edtPISRetidoExit(Sender: TObject);
begin
  inherited;
  ControlarEdicaoPISCOFINSCSLL;
end;

procedure TfrmCadastroNotasFiscais.edtCofinsRetidoExit(Sender: TObject);
begin
  inherited;
  ControlarEdicaoPISCOFINSCSLL;

end;

procedure TfrmCadastroNotasFiscais.edtCSLLRetidoExit(Sender: TObject);
begin
  inherited;
  ControlarEdicaoPISCOFINSCSLL;

end;

procedure TfrmCadastroNotasFiscais.edtPIS_COFINS_CSLLExit(Sender: TObject);
begin
  inherited;
  ControlarEdicaoPISCOFINSCSLL;
end;

procedure TfrmCadastroNotasFiscais.OnChangeCodigoFiscal(Sender: TObject);
begin
  if (dtmCadastroNotasFiscais.qryProcuraSeriesFornecedormodelodoctofiscal.AsString =
      ctNotaFiscalFornecEnergia) or
     (dtmCadastroNotasFiscais.qryProcuraSeriesFornecedormodelodoctofiscal.AsString =
      ctNotaFiscalFornecGas) then
  begin
    gbxServicos_nt.Visible := true;

    gbxServicos.Caption := 'VALOR CONSUMIDO';

    gbxProdutos_6.Caption := 'TOTAL CONSUMO';

    gbxFrete_6.Caption := 'VALOR PIS';
    edtFreteInterno.DataField := 'valorpis';

    gbxSeguro.Caption := 'VALOR COFINS';
    edtSeguro.DataField := 'valorcofins';

    gbxIPI.Caption := 'VALOR TERCEIROS';
    edtValorIPI.DataField := 'valorterceiros';
  end
  else
  begin
    gbxServicos_nt.Visible := false;

    gbxServicos.Caption := 'VALOR SERVIÇOS';

    gbxProdutos_6.Caption := 'TOTAL PRODUTOS';

    gbxFrete_6.Caption := 'FRETE INTERNO';
    edtFreteInterno.DataField := 'freteinterno';

    gbxSeguro.Caption := 'SEGURO';
    edtSeguro.DataField := 'seguro';

    gbxIPI.Caption := 'VALOR DO IPI';
    edtValorIPI.DataField := 'valoripi';

  end;
end;

