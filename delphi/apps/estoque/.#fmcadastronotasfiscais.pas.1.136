procedure TfrmCadastroNotasFiscais.AtribuirDadosConsultanotasaida;
begin

  if fraConsultaSerieSaida.qryProcuraSerie.ParamByName('serie').asstring <> fraConsultanotasaida.qryProcuraNFSaidaserie.AsString then
  begin
    fraConsultaSerieSaida.qryProcuraSerie.ParamByName('serie').asstring := fraConsultanotasaida.qryProcuraNFSaidaserie.AsString;
    fraConsultaSerieSaida.edfcodigo.exist;
  end;

  dtmCadastroNotasFiscais.qryDadosFiscaisRef.ParamByName('filial').AsInteger := fraConsultanotasaida.qryProcuraNFSaidafilial.AsInteger;
  dtmCadastroNotasFiscais.qryDadosFiscaisRef.ParamByName('serie').AsString := fraConsultanotasaida.qryProcuraNFSaidaserie.AsString;
//  dtmCadastroNotasFiscais.qryDadosFiscaisRef.fieldByName('serie').AsString := fraConsultanotasaida.qryProcuraNFSaidaserie.AsString;
  dtmCadastroNotasFiscais.qryDadosFiscaisRef.ParamByName('numero').AsInteger := fraConsultanotasaida.qryProcuraNFSaidanumero.AsInteger;

  if (fraConsultaSerieSaida.edfCodigo.Text <> fraConsultanotasaida.qryProcuraNFSaidaserie.AsString) or
     (fraConsultanotasaida.edfCodigo.Text <> fraConsultanotasaida.qryProcuraNFSaidanumero.AsString) then
  begin
    fraConsultaSerieSaida.edfCodigo.Text := fraConsultanotasaida.qryProcuraNFSaidaserie.AsString;
    fraConsultanotasaida.edfCodigo.Text := fraConsultanotasaida.qryProcuraNFSaidanumero.AsString;;
    fraConsultanotasaida.edfCodigo.exist;
  end;
end;

procedure TfrmCadastroNotasFiscais.CondicoesdaConsultaNotaSaida;
begin
  fraConsultanotasaida.qryConsultaNFSaida.ParamByName('filial').asinteger :=
    dtmCadastroNotasFiscais.qryNotaFiscalfilial.AsInteger;

  fraConsultanotasaida.qryConsultaNFSaida.ParamByName('serie').asString :=
//    fraConsultaSerieSaida.qryProcuraSerieserie.AsString;
    dtmCadastroNotasFiscais.qryNotaFiscalserie.asString;

  fraConsultanotasaida.qryProcuraNFSaida.ParamByName('filial').asinteger :=
    dtmCadastroNotasFiscais.qryNotaFiscalfilial.AsInteger;

  fraConsultanotasaida.qryProcuraNFSaida.ParamByName('serie').asString :=
//    fraConsultaSerieSaida.qryProcuraSerieserie.AsString;
    dtmCadastroNotasFiscais.qryNotaFiscalserie.asString;

  fraConsultanotasaida.qryProcuraNFSaida.macrobyname('SQL').asstring := ' and df.cliente = ' + inttostr(dtmCadastroNotasFiscais.qryNotaFiscalfornecedor.Asinteger) +
                                                                        ' and df.tipocliente = ' + quotedstr(dtmCadastroNotasFiscais.qryNotaFiscaltipofornecedor.AsString) +
                                                                        ' and df.dadofiscalreferenciado is null ';

  fraConsultanotasaida.qryConsultaNFSaida.macrobyname('SQL').asstring := ' and df.cliente = ' + inttostr(dtmCadastroNotasFiscais.qryNotaFiscalfornecedor.Asinteger) +
                                                                        ' and df.tipocliente = ' + quotedstr(dtmCadastroNotasFiscais.qryNotaFiscaltipofornecedor.AsString) +
                                                                        ' and df.dadofiscalreferenciado is null ';
                                                                        
end;

procedure TfrmCadastroNotasFiscais.CondicoesdaConsultaSerieSaida;
begin
  fraConsultaSerieSaida.qryProcuraSerie.ParamByName('filial').AsInteger := dtmCadastroNotasFiscais.qryNotaFiscalfilial.AsInteger;
  fraConsultaSerieSaida.qryConsultaSerie.ParamByName('filial').AsInteger := dtmCadastroNotasFiscais.qryNotaFiscalfilial.AsInteger;

  fraConsultaSerieSaida.qryProcuraSerie.MacroByName('SQLCondicao').AsString := ' and (sf.filial,sf.valor) in ( '+
                                                                               ' select n.filial,n.serie '+
                                                                               ' from notas n join dadosfiscais df on n.dadofiscal = df.numero '+
                                                                               ' where n.dadofiscal = df.numero '+
                                                                               ' and df.cliente = ' + inttostr(dtmCadastroNotasFiscais.qryNotaFiscalfornecedor.AsInteger) +
                                                                               ' and df.tipocliente = ' + quotedstr(dtmCadastroNotasFiscais.qryNotaFiscaltipofornecedor.AsString)+
                                                                               ' and df.dadofiscalcomplementar is null )';

  fraConsultaSerieSaida.qryConsultaSerie.MacroByName('SQLCondicao').AsString := fraConsultaSerieSaida.qryProcuraSerie.MacroByName('SQLCondicao').AsString;
end;

