end;

procedure TfrmCadastroNotasFiscais.dbgProdutosNotasPagNFEItemsKeyDown(
  Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;
  if dtmCadastroNotasFiscais.qryprodutosnotaspagnfe.active then
  begin

    if ShiftOn then
    begin
      if (key = vk_tab) {or (key = vk_return))} then
        dtmCadastroNotasFiscais.PosicionarProdutosNotasPagNFEComerro
    end
    else
    if {(dbgProdutosNotasPagNFEItems.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsproduto) or
        (dbgProdutosNotasPagNFEItems.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsprodutovisual) or}

       (dbgProdutosNotasPagNFEItems.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsprodutodigitado) or
       (dbgProdutosNotasPagNFEItems.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsdescricaoproduto) or
       (dbgProdutosNotasPagNFEItems.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsncmempresa)   then
    begin
      if (key = VK_F9) and
         CtrlOn then
      begin
        TipoProcura := pnfPRODUTONFE;
        CtrlOn := true;
        InternoPesquisar(ctPRODUTO);
        dbgProdutosNotasPagNFEItems.SetFocus;
      end
      else
      if key = VK_return then
      begin
  //      flkProdutonaEmpresa.Exist;

        dtmCadastroNotasFiscais.GuardarPosicaoProdutosNotasPagNFE;

        dtmCadastroNotasFiscais.dsrProdutosNotasPagNFEItemsDataChange(nil, dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsprodutodigitado);
        dtmCadastroNotasFiscais.VoltarPosicaoProdutosNotasPagNFE;

        dtmCadastroNotasFiscais.CampoProdutosNotasPagNFEItemsAlterado := nil;
        dtmCadastroNotasFiscais.VerificarValoresProdutosNotasPagNFEItems;

      end;
    end
    else
    if (dbgProdutosNotasPagNFEItems.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemspedido) then
    begin
      if (key = VK_F9) and
         CtrlOn then
      begin
        TipoProcura := pnfPEDIDOPRODUTONFE;
        CtrlOn := true;

        InternoPesquisar(ctPEDIDOS);
        dbgProdutosNotasPagNFEItems.SetFocus;
      end
      else
      if key = VK_return then
      begin
  //      flkPedido.Exist;
        dtmCadastroNotasFiscais.dsrProdutosNotasPagNFEItemsDataChange(nil, dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemspedido);
      end;
    end
    else
    if (dbgProdutosNotasPagNFEItems.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemscodigofiscal) or
       (dbgProdutosNotasPagNFEItems.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsdescricaocodigofiscal) or
       (dbgProdutosNotasPagNFEItems.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsnatureza) or
       (dbgProdutosNotasPagNFEItems.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsdescricaonatureza) then
    begin
      if (key = VK_F9) and
         CtrlOn then
      begin
        TipoProcura := pnfNATUREZAPRODUTONFE;
        dtmCadastroNotasFiscais.qryConsultaNaturezas.MacroByName('CodigoFiscal').AsString := '';
        CtrlOn := true;
        InternoPesquisar(ctCODIGOFISCAL);
        dbgProdutosNotasPagNFEItems.SetFocus;
      end
      else
      if key = VK_return then
      begin
        dtmCadastroNotasFiscais.dsrProdutosNotasPagNFEItemsDataChange(nil, dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemscodigofiscal);
        if dtmCadastroNotasFiscais.QuantidadeNaturezasProdutoNFE then
        begin
          TipoProcura := pnfNATUREZAPRODUTONFE;
          CtrlOn := true;
          InternoPesquisar(ctCODIGOFISCAL);
          dbgProdutosNotasPagNFEItems.SetFocus;
        end;
      end;

    end
    else
    if (dbgProdutosNotasPagNFEItems.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsdescricaounidadenfe) then
    begin
      if key = VK_return then
      begin
        dtmCadastroNotasFiscais.CampoProdutosNotasPagNFEItemsAlterado := dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsdescricaounidadenfe;
        dtmCadastroNotasFiscais.dsrProdutosNotasPagNFEItemsDataChange(nil, dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsdescricaounidadenfe);
      end;
    end
    else
    if (dbgProdutosNotasPagNFEItems.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsfatorconversao) then
    begin
      if key = VK_return then
      begin
        dtmCadastroNotasFiscais.CampoProdutosNotasPagNFEItemsAlterado := dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsfatorconversao;
        dtmCadastroNotasFiscais.dsrProdutosNotasPagNFEItemsDataChange(nil, dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsfatorconversao);
      end;
    end
    else
    if (dbgProdutosNotasPagNFEItems.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsquantidade) then
    begin
      if key = VK_return then
      begin
        dtmCadastroNotasFiscais.CampoProdutosNotasPagNFEItemsAlterado := dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsquantidade;

        if dbgProdutosNotasPagNFEItems.EditandoCelula then
          dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItems.Post;

  //      dtmCadastroNotasFiscais.dsrProdutosNotasPagNFEItemsDataChange(nil, dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsquantidade);
      end;
    end
    else
    if (dbgProdutosNotasPagNFEItems.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsqtdeestoque) then
    begin
      if key = VK_return then
      begin
        dtmCadastroNotasFiscais.CampoProdutosNotasPagNFEItemsAlterado := dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsqtdeestoque;
        dtmCadastroNotasFiscais.dsrProdutosNotasPagNFEItemsDataChange(nil, dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsqtdeestoque);
      end;
    end
    else
    if (dbgProdutosNotasPagNFEItems.SelectedField = dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsnlote) then
    begin
      if key = VK_return then
      begin
        dtmCadastroNotasFiscais.CampoProdutosNotasPagNFEItemsAlterado := dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsnlote;
        dtmCadastroNotasFiscais.dsrProdutosNotasPagNFEItemsDataChange(nil, dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsnlote);
      end;
    end;
  end;

  AtualizarDBAdvGridLotes;

end;

