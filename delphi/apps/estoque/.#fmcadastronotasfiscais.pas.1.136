procedure TfrmCadastroNotasFiscais.sbnIncluirLotesClick(Sender: TObject);
begin
  inherited;


  if dtmCadastroNotasFiscais.qryProdutosNotasPagNFELotes.CheckRequiredFields then
  begin
    dtmCadastroNotasFiscais.qryProdutosNotasPagNFELotes.last;
    dtmCadastroNotasFiscais.qryProdutosNotasPagNFELotes.readonly := false;
    DBAdvGridLotes.setfocus;
    DBAdvGridLotes.col := 2;

    dtmCadastroNotasFiscais.qryProdutosNotasPagNFELotes.append;
    DBAdvGridLotes.col := 1;
//    DBAdvGridLotes.ShowInplaceEdit;
  end;

end;

procedure TfrmCadastroNotasFiscais.sbnExcluirLotesClick(Sender: TObject);
begin
  inherited;
  if dtmCadastroNotasFiscais.qryProdutosNotasPagNFELotespermitealterar.asBoolean then
    dtmCadastroNotasFiscais.qryProdutosNotasPagNFELotes.delete
  else
  begin
    if MensagemConfirmacao('Confirma a exclusão do lote tendo como origem uma ''NFe''') = smbOK then
      dtmCadastroNotasFiscais.qryProdutosNotasPagNFELotes.delete;
  end;
end;

procedure TfrmCadastroNotasFiscais.DBAdvGridLotesGetEditorType(
  Sender: TObject; ACol, ARow: Integer; var AEditor: TEditorType);
begin
  inherited;
  if dtmCadastroNotasFiscais.qryProdutosNotasPagNFELotespermitealterar.asBoolean then
  begin

    PlannerDBDatePicker1.visible := false;
    DBAdvEdit.visible := false;
    DBAdvEditFloat.visible := false;
    DBMaplistCombobox1.visible := false;

    fraConsulta_.visible := false;
    fraConsultaContabil_.visible := false;

    DBCheckBoxBoolean.visible := true;


    PlannerDBDatePicker1.left := DBCheckBoxBoolean.width + 3;

    PlannerDBDatePicker1.calendar.MaxDate.Use := false;
    PlannerDBDatePicker1.calendar.MinDate.Use := false;

    DBAdvEditFloat.left := DBCheckBoxBoolean.width + 3;
    DBAdvEdit.left := DBCheckBoxBoolean.width + 3;
    DBMaplistCombobox1.left := DBCheckBoxBoolean.width + 3;
    fraConsulta_.left := DBCheckBoxBoolean.width + 3;
    fraConsultaContabil_.left := DBCheckBoxBoolean.width + 3;

    DBCheckBoxBoolean.AllowGrayed := false;

    if dtmCadastroNotasFiscais.qryProdutosNotasPagNFELotes.FindField('Nulo_'+TDBAdvGrid(Sender).Columns[Acol].FieldName)<>nil then
    begin
      DBCheckBoxBoolean.DataSource := TDBAdvGrid(Sender).DataSource;
      DBCheckBoxBoolean.datafield := 'Nulo_'+TDBAdvGrid(Sender).Columns[Acol].FieldName;
    end;


    if TDBAdvGrid(Sender).Columns[Acol].Field.DataType = ftDate then
    begin
      if (TDBAdvGrid(Sender).Columns[Acol].FieldName = 'dval') then
      begin
        PlannerDBDatePicker1.calendar.MinDate.Use := not TDBAdvGrid(Sender).ColumnByFieldName['dfab'].Field.isnull;
        if PlannerDBDatePicker1.calendar.MinDate.Use then
          PlannerDBDatePicker1.calendar.MinDate.Date := TDBAdvGrid(Sender).ColumnByFieldName['dfab'].Field.Value;
      end
      else
      if (TDBAdvGrid(Sender).Columns[Acol].FieldName = 'dfab') then
      begin
        PlannerDBDatePicker1.calendar.MaxDate.Use := not TDBAdvGrid(Sender).ColumnByFieldName['dval'].Field.isnull;
        if PlannerDBDatePicker1.calendar.MaxDate.Use then
          PlannerDBDatePicker1.calendar.MaxDate.Date := TDBAdvGrid(Sender).ColumnByFieldName['dval'].Field.Value;
      end;


      PlannerDBDatePicker1.DataSource := TDBAdvGrid(Sender).DataSource;
      PlannerDBDatePicker1.datafield := TDBAdvGrid(Sender).Columns[Acol].FieldName;
      PlannerDBDatePicker1.width :=  TDBAdvGrid(Sender).Columns[Acol].Width - DBCheckBoxBoolean.width - 5;
      PlannerDBDatePicker1.visible := true;
    end
    else
    if (TDBAdvGrid(Sender).Columns[Acol].Field.DataType = ftFloat) or
       (TDBAdvGrid(Sender).Columns[Acol].FieldName = 'qlote') then
    begin
      DBAdvEditFloat.datasource := TDBAdvGrid(Sender).DataSource;
      DBAdvEditFloat.datafield := TDBAdvGrid(Sender).Columns[Acol].Fieldname;
      DBAdvEditFloat.visible := true;
      DBAdvEditFloat.width :=  TDBAdvGrid(Sender).Columns[Acol].Width -  5;

    end
    else
    begin

      DBCheckBoxBoolean.visible := false;
      DBAdvEdit.left := 3;

      DBAdvEdit.DataSource := TDBAdvGrid(Sender).DataSource;
      DBAdvEdit.datafield := TDBAdvGrid(Sender).Columns[Acol].Fieldname;
      DBAdvEdit.EditType := etString;
      DBAdvEdit.visible := true;
      DBAdvEdit.width :=  TDBAdvGrid(Sender).Columns[Acol].Width {- DBCheckBoxBoolean.width} - 5;

    end;
  end;  

end;

procedure TfrmCadastroNotasFiscais.DBAdvGridLotesCheckRequiredFields(
  Sender: TObject; var Allow: Boolean);
begin
  inherited;
//  if DBAdvGridLotes.col = DBAdvGridLotes.ColumnByFieldName['dval'].index then
  begin
    Allow := dtmCadastroNotasFiscais.qryProdutosNotasPagNFELotes.CheckRequiredFields(False, false, true, self, true, false);
    if allow  then
      dtmCadastroNotasFiscais.VerificarValoresProdutosNotasPagNFEItems;
  end;
end;

procedure TfrmCadastroNotasFiscais.DBAdvGridLotesKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if Shift = [ssCtrl] then
  begin
    case Key of
      TeclaEditarRegistro :
      begin
        if sbnIncluirLotes.enabled then
        begin
          DBAdvGridLotes.setfocus;
          DBAdvGridLotes.datasource.dataset.edit;
        end;
      end;
      TeclaInserirRegistro:
        begin
           if sbnIncluirLotes.enabled then
             DBAdvGridLotes.datasource.dataset.append;
        end;
    end;
  end
  else
  if key = vk_return then
  begin
    if dtmCadastroNotasFiscais.qryProdutosNotasPagNFELotes.CheckRequiredFields(false, false, false, self, true, false) then
      dtmCadastroNotasFiscais.qryProdutosNotasPagNFELotes.post;
  end;

end;

procedure TfrmCadastroNotasFiscais.FormControlEditLink1SetEditorFocus(
  Sender: TObject; Grid: TAdvStringGrid; AControl: TWinControl);
begin
  inherited;
  if (TDBAdvGrid(Grid).Columns[Grid.col].Field.DataType = ftFloat) or
     (TDBAdvGrid(grid).Columns[grid.col].FieldName = 'qlote') then
    DBAdvEditFloat.setfocus
  else
  if TDBAdvGrid(Grid).Columns[Grid.col].Field.DataType = ftDate then
    PlannerDBDatePicker1.setfocus
  else
  if TDBAdvGrid(Grid).Columns[Grid.col].Field.DataType = ftBoolean then
    DBCheckBoxBoolean.setfocus
  else
    DBAdvEdit.setfocus;

end;

