procedure TfrmCadastroNotasFiscais.AtualizarDBAdvGridLotes;
var
 vRecno : integer;
begin
{
  vRecno := DBAdvGridLotes.datasource.dataset.recno;

    DBAdvGridLotes.datasource.dataset.first;
    DBAdvGridLotes.datasource.dataset.last;

    DBAdvGridLotes.datasource.dataset.recno := vrecno;

    DBAdvGridLotes.Refresh;
    DBAdvGridLotes.Invalidate;
    }

end;

procedure TfrmCadastroNotasFiscais.CalcularTotaisProdutosNotasPagNFELotes;
begin

  if (pgcProdutos.activepage = tstProdutosNFE) AND dtmCadastroNotasFiscais.VisualizandoProdutosdaNFE then
  begin

  DBAdvGridLotesTotais.DataSource := nil;
  DBAdvGridLotesTotais.DataSource := DBAdvGridLotes.DataSource;
  DBAdvGridLotesTotais.FloatingFooter.ColumnCalc[
    DBAdvGridLotesTotais.ColumnByFieldName['qlote'].Index] := acsum;
//  DBAdvGridLotesTotais.CalcFooter(DBAdvGridLotesTotais.ColumnByFieldName['qlote'].Index);
  end;

end;

