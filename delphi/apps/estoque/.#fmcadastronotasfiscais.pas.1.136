procedure TfrmCadastroNotasFiscais.AfterScrollLinhaColunaGrade(Sender: TObject);
begin
  dbgProdutosNotaFiscal.ColumnbyName('valorgrade1').Title.Caption := dtmCadastroNotasFiscais.LinhadaGrade;
  dbgProdutosNotaFiscal.ColumnbyName('valorgrade2').Title.Caption := dtmCadastroNotasFiscais.ColunadaGrade;

  if  dtmCadastroNotasFiscais.VisualizarDetalhesProdutosNota then
    fraProdutosNotasFiscaisAnteriores1.AbrirqryProdutosNotaFiscalAnteriores;

  dbgProdutosNotaFiscal.Refresh;  

end;

constructor TfrmCadastroNotasFiscais.Create(AOwner: TComponent);
begin

  dtmCadastroNotasFiscais := TdtmCadastroNotasFiscais.Create(Self);

  inherited Create(AOwner);



  try
    dtmCadastroNotasFiscais.Abre(ctTabelaCadastroNotaFiscal);

    if ParSistema.PermitirProdutoAlfanumerico then
       dbgProdutosNotaFiscal.Columns[2].Width:= 215
    else
       dbgProdutosNotaFiscal.Columns[2].Width:= 140;

    DataSet := dtmCadastroNotasFiscais.TabelaNotaFiscais;
    TipoCadastro := cnfProduto;
    pgcNotasPag.ActivePage   := tstDadosNota;
    pgcValoresNota.ActivePage := tstValoresNota;
    tstProdutos.TabVisible   := False;
    tstFrete.TabVisible      := False;
    tstDuplicatas.TabVisible := False;
    tstImpostosRetidos.TabVisible := False;
    tstTransportador.TabVisible := false;
    tstImportacao.TabVisible := False;
  //  pnlICMSFreteSeguro.BringToFront;
    gbxCNPJCaption := gbxCNPJ.Caption;

    dbgProdutosNotaFiscal.ColumnbyName('valorgrade1').Visible := ParSistema.UsarGradesProdutos;
    dbgProdutosNotaFiscal.ColumnbyName('valorgrade2').Visible := ParSistema.UsarGradesProdutos;

    sbnVisualizarGrade.Visible := ParSistema.UsarGradesProdutos;
    dtmCadastroNotasFiscais.OnScrollLinhaColunaGrade := AfterScrollLinhaColunaGrade;
    dtmCadastroNotasFiscais.OnChangeTipoFornecedor := OnChangeTipoFornecedor;
    dtmCadastroNotasFiscais.OnChangeCodigoFiscal := OnChangeCodigoFiscal;
    dtmCadastroNotasfiscais.OnTotalizarAdicoes := TotalizarAdicoes;
  //  ParSistema.DataContabil;
    tstContabilidade.TabVisible := ParSistema.GerarContabilidade;
//    if dbgProdutosNotaFiscal.Columnbyname('quantidade').Width < ParSistema.tamanhoMascaraQuantidade then
//      dbgProdutosNotaFiscal.Columnbyname('quantidade').Width := ParSistema.tamanhoMascaraQuantidade;

    if dbgProdutosImportados.Columnbyname('quantidade').Width < ParSistema.tamanhoMascaraQuantidade then
      dbgProdutosImportados.Columnbyname('quantidade').Width := ParSistema.tamanhoMascaraQuantidade;

    dtmCadastroNotasFiscais.VenctosImpostosRetidosEntradasAfterOpen :=
       VenctosImpostosRetidosEntradasAfterOpen;
    BloquearValores(ParSistema.GeracaoAutomaticadoImpostoRetido);
    visulizandoCustoePrecoVenda := false;
  {  sbnCustoePrecoVenda.visible := false;}
    pnlLegenda.visible := false;
    edtDataEmissao.MensagemPadronizada := ExibirMensagemPadronizadaDataEmissao;
    edtDataLancamento.MensagemPadronizada := ExibirMensagemPadronizadaDataLancto;
    dtmCadastroNotasFiscais.AfterOpenNotaFiscal := AfterOpenNotaFiscal;
    dtmCadastroNotasFiscais.EntrarChavesNota := EntrarChavesNota;
  

    with fraLancamentoContabilidade do
    begin
      VaLorICMS                := dtmCadastroNotasFiscais.getvaloricms;
      ValorIPI                 := dtmCadastroNotasFiscais.getValorIPI;
      ValorPIS                 := dtmCadastroNotasFiscais.getValorPIS;
      ValordaNota              := dtmCadastroNotasFiscais.GetValordaNota;
      ValordosProdutos         := dtmCadastroNotasFiscais.GetValorProdutos;
//      ValorServicos            := dtmCadastroNotasFiscais.GetValorServicos;
      ValorServicos            := dtmCadastroNotasFiscais.RetornaZero;
      ValorAcrescimo           := dtmCadastroNotasFiscais.GetValorAcrescimo;
      ValorCofinsaRecolher     := dtmCadastroNotasFiscais.GetValorCofinsaRecolher;
      ValorFrete               := dtmCadastroNotasFiscais.GetValorFrete;
      ValorSeguro              := dtmCadastroNotasFiscais.GetValorSeguro;
      ValorDespesasAcessorias  := dtmCadastroNotasFiscais.GetValorDespesasAcessorias;
      ValorDespesasCOFINS      := dtmCadastroNotasFiscais.GetValorDespesasCOFINS;
      ValorCustodaMercadoria   := dtmCadastroNotasFiscais.GetValorCustodaMercadoria;
      ValorEstoquedaMercadoria := dtmCadastroNotasFiscais.GetValorEstoquedaMercadoria;
      ValorICMSSubstituicao    := dtmCadastroNotasFiscais.GetValorICMSSubstituicao;
      ValorcofinsRetido        := dtmCadastroNotasFiscais.GetCofinsRetido;
      ValorcsllRetido          := dtmCadastroNotasFiscais.GetCSLLRetido;
      ValorinssRetido          := dtmCadastroNotasFiscais.GetINSSRetido;
      ValorirRetido            := dtmCadastroNotasFiscais.GetIRRetido;
  //    Valoriss                 := dtmEmissaoNotaAvulsas.GetValorISS;
      Valoriss                 := dtmCadastroNotasFiscais.RetornaZero;
      ValorissRetido           := dtmCadastroNotasFiscais.GetISSRetido;
      ValorpisRetido           := dtmCadastroNotasFiscais.GetPISRetido;
      ValorPISCOFINSCSLLRetido := dtmCadastroNotasFiscais.GetPISCOFINSCSLLRetido;
      ValorDescontos           := dtmCadastroNotasFiscais.GetValordesconto;
      ValorReceitasDespesasFinanceiras := dtmCadastroNotasFiscais.RetornaZero;
      DataDocumento            := dtmCadastroNotasFiscais.GetDataDocumento;
      CodigoNatureza           := dtmCadastroNotasFiscais.GetCodigoNatureza;
      DebitoFornecedor         := dtmCadastroNotasFiscais.getDebitoFornecedor;
      CreditoFornecedor        := dtmCadastroNotasFiscais.getCreditoFornecedor;
      FornecedorParaISS        := dtmCadastroNotasFiscais.getFornecedorParaISS;
      SomenteLeituraContabilidade := dtmCadastroNotasFiscais.getSomenteLeituraContabilidade;
      GerarDuplicatas          := dtmCadastroNotasFiscais.GetGerarDocumentoPag;
      DescricaoHistorico       := dtmCadastroNotasFiscais.getdescricaohistorico;
      FilialDocumento          := dtmCadastroNotasFiscais.GetFilialDocumento;
      CodigoDocumento          := dtmCadastroNotasFiscais.GetCodigoDocumento;
      NumeroNotaFiscal         := dtmCadastroNotasFiscais.getnumeronotafiscal;
      ContaDebitarouCreditar   := dtmCadastroNotasFiscais.GetContaCreditar;
      HistoricoDebitarouCreditar := dtmCadastroNotasFiscais.GetHistoricoDebitar;
      CReDBigualValorNota        := dtmCadastroNotasFiscais.GetCReDBigualValorNota;
      GravarSemLanctos           := dtmCadastroNotasFiscais.GetGravarSemLanctos;

      Origem                   := 'E';
      OrigemFormulario         := 'E';;
      NomeOrigemFormulario     := self.name;

      AtribuirContaDocumento   := dtmCadastroNotasFiscais.AtribuirContaCreditoDocumentoPag;
      EditarDocumento          := dtmCadastroNotasFiscais.EditarNotaFiscal;
    end;

    with dtmCadastroNotasFiscais do
    begin
      AcertarLarguraGradeCasasDecimais(dbgProdutosNotaFiscal,8);
      AcertarCasasDecimais(qryProdutosNotaFiscalprecounitario);
      AcertarCasasDecimais(qryProdutosNotasPagNFEprecounitario);
      AcertarCasasDecimais(qryProdutosNotasPagNFEItemsprecounitario);
    end;

    dbgProdutosNotaFiscal.OnDelete := sbnExcluirProduto.Click;

    pgcImportacao.ActivePage := tstAdicoes;
    fraConsultaCodigoExportador.TipoCliente := 'F';
    fraConsultaCodigoExportador.Tipovfornecedor := 'F';
    fraConsultaCodigoExportador.TipoPesquisa := pesFORNECEDORES;

    fraConsultaUFDesembaracaoImportacao.TipoPesquisa := pesESTADOS;
    fraConsultaUFAdquirente.TipoPesquisa := pesESTADOS;


    ConsultaFornecedor := TfraConsultaCodigo.Create(self);
    ConsultaFornecedor.Name := 'ConsultaFornecedor';
    ConsultaFornecedor.TipoCliente := 'F';
    ConsultaFornecedor.Tipovfornecedor := 'F';
    ConsultaFornecedor.edfCodigo.Operacao := opATRIBUICAO;
    ConsultaFornecedor.AbrirTabelaProcura := false;
    ConsultaFornecedor.ConsultarTodos := true;
    ConsultaFornecedor.TipoPesquisa := pesFORNECEDORES;
    ConsultaFornecedor.CondicoesdaConsulta := CondicoesConsultaFornecedorISS;
    ConsultaFornecedor.OnFound := AtribuirCodigoFornecedorParaISS;

    fraConsultaModeloDocto.TipoPesquisa := pesMODELODOCTOSFISCAIS;

    sbnPesquisarFornecedorParaISS.Visible := false;

    dbgPedidosNFE.OnDelete := dtmCadastroNotasFiscais.ExcluirdaListadePedidos;


    fraConsultaSerieSaida.TipoPesquisa := pesSERIES;
    fraConsultaSerieSaida.CondicoesdaConsulta := CondicoesdaConsultaSerieSaida;
//    fraConsultaSerieSaida.onFound := AtribuirDadosConsultaSerieSaida;
    fraConsultanotasaida.TipoPesquisa := pesNOTASNUMERO;
    fraConsultanotasaida.CondicoesdaConsulta := CondicoesdaConsultaNotaSaida;
    fraConsultanotasaida.OnFound := AtribuirDadosConsultanotasaida;

    rgpFinalidadeNFE.tabstop := true;

    pgcDetalhes.ActivePage := tstDetalhesNotaFiscal;

    fraProdutosNotasFiscaisAnteriores1.visible := false;
    VisualizarPaineisCusto;

    fraProdutosNotasFiscaisAnteriores1.CodigoNota := dtmCadastroNotasFiscais.GetCodigoDocumento;
    fraProdutosNotasFiscaisAnteriores1.Produto := dtmCadastroNotasFiscais.GetProduto;

    sbnManutencaoPrecos.Visible :=  assigned(tfrmTecsoft(Application.MainForm).mitManutencaoPreco) and
                                    tfrmTecsoft(Application.MainForm).mitManutencaoPreco.Enabled;

    dbgConsultaPedidos.Bands.PrimaryColor := TColor(strtoint(parsistema.CorZebradoRelatorio));

    dbgProdutosNFE.ColumnByName('ipiLookup').Visible :=  parsistema.AtualizarNCMNotaEntrada;
    dbgProdutosNFE.ColumnByName('ipi').Visible :=  false;
    dbgProdutosNFE.ColumnByName('descricaoipi').Visible :=  false;

    dbgProdutosNotasPagNFEItems.ColumnByName('ipiLookup').Visible :=  parsistema.AtualizarNCMNotaEntrada;
    dbgProdutosNotasPagNFEItems.ColumnByName('ipi').Visible :=  false;
    dbgProdutosNotasPagNFEItems.ColumnByName('descricaoipi').Visible :=  false;



  except
    on E: Exception do ShowMessage(E.Message);
  end;


end;

procedure TfrmCadastroNotasFiscais.dbgDuplicatasDblClick(Sender: TObject);
begin
  inherited;
  IncluirDuplicataNotaFiscal(True)
end;

procedure TfrmCadastroNotasFiscais.dbgDuplicatasKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;
  if Shift = [ssCtrl] then begin
    case Key of
      TeclaEditarRegistro : IncluirDuplicataNotaFiscal(True);
      TeclaInserirRegistro: IncluirDuplicataNotaFiscal(False);
    end;
  end;
end;

