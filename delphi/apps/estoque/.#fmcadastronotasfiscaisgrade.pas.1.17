unit fmcadastronotasfiscaisgrade;

interface

uses
  SysUtils, Types, Classes, Variants, Graphics, Controls, Forms, Dialogs,
  fmajuda, Grids, DBGrids, cpdbgrid, db, biblio, ctconstantes, zquery,
  // projeto
  dmcadastronotasfiscais, Buttons, fmcadastropadrao, ComCtrls, ExtCtrls,
  StdCtrls, DBCtrls, cpdbtext, Windows, cpnumero, Mask, cpdbfindcontrols,
  // Repositorio
  fmconsultaporcampo, fmconsultabasica, fmcadastropadraonavegacao, ToolWin,
  Menus, frselecaoaleatoriaprodutos, cpdbdata, DBIntCheckBox, frconsulta, frconsultacodigo;


type
  TfrmCadastroNotasFiscaisGrade = class(TfrmCadastroPadraoNav)
    pnlSituacaoProdutos: TPanel;
    lblPreco: TLabel;
    lblICMS: TLabel;
    lblIPI: TLabel;
    lblReducaoBase: TLabel;
    dbgGrades: TtecDBGrid;
    edtReducaoBase: TEditNumero;
    edtIPI: TEditNumero;
    edtICMS: TEditNumero;
    edtPreco: TEditNumero;
    ckbValoresPadrao: TCheckBox;
    sbnTrocarLInhaColuna: TSpeedButton;
    lblTotalProdutos: TLabel;
    dtxValorProdutos: TtecDBText;
    lblTotalIPI: TLabel;
    dtxTotalIPI: TtecDBText;
    lblTotalProdutoIPI: TLabel;
    dtxTotalProdutos: TtecDBText;
    PopupMenu: TPopupMenu;
    pnlSelecaoProduto: TPanel;
    dbSelecionarProdutosDesde: TDBIntCheckBox;
    edtSelecionarProdutosDesde: TDBEditData;
    gbxCaracteristicasNotasFiscais: TPanel;
    dbgCaracteristicasNotasFiscais: TtecDBGrid;
    pnlLabels: TPanel;
    sbnProcura: TSpeedButton;
    sbnExcluirProduto: TSpeedButton;
    sbnIncluirItem: TSpeedButton;
    Timer1: TTimer;
    lblCaracteristicasNotasFiscais: TStaticText;
    lblGrades: TStaticText;
    procedure dbgGradesDrawColumnCell(Sender: TObject; const Rect: TRect;
      DataCol: Integer; Column: TColumn; State: TGridDrawState);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure dbgGradesDblClick(Sender: TObject);
    procedure dbgGradesKeyPress(Sender: TObject; var Key: Char);
    procedure dbgGradesKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure sbnTrocarLInhaColunaClick(Sender: TObject);
    procedure sbnProcuraCaracteristicaClick(Sender: TObject);
    procedure ckbValoresPadraoClick(Sender: TObject);
    procedure PopupMenuPopup(Sender: TObject);
    procedure dbgCaracteristicasNotasFiscaisDblClick(Sender: TObject);
    procedure sbnProcuraClick(Sender: TObject);
    procedure sbnIncluirItemClick(Sender: TObject);
    procedure dbgCaracteristicasNotasFiscaisKeyDown(Sender: TObject;
      var Key: Word; Shift: TShiftState);
    procedure sbnExcluirClick(Sender: TObject);
    procedure Timer1Timer(Sender: TObject);
    procedure sbnExcluirProdutoClick(Sender: TObject);
    procedure SpeedButton1Click(Sender: TObject);
  private
    fncolunasgrade: integer;
    fraConsultaProduto: TfraConsultaCodigo;

    function getncolunasgrade: integer;
    procedure AcionarPesquisaGrade;

    procedure onPosicionarLinhaColunaNaGrade(Sender: TObject);
    procedure GradeAfterOpen(Sender: TObject);

    procedure  SetDataModulo (Dtm: TdtmCadastroNotasFiscais);

    { Private declarations }
  protected
//    function ExisteInformacao(Parametro: Integer; NomeCampo: String; Value: Variant): Boolean; override;
    dtmCadastroNotasFiscais : tdtmCadastroNotasFiscais;
    procedure AlterarEstadoBotoes; override;
    function InternoIncluir: Boolean; override;
    function InternoGravar: Boolean; override;
    function  InternoCancelar: Boolean; override;
    procedure KeyDown(var Key: Word; Shift: TShiftState); override;
//    function AcionaCadastroProdutosNotasFiscais: Boolean;
//    function AbrirGrade: Boolean;
    procedure AtualizarValores;
    property ncolunasgrade: integer read getncolunasgrade write fncolunasgrade;

    procedure CondicoesProduto;
    procedure AtribuirDadosProdutos;


  public
    { Public declarations }
    constructor Create(AOwner: TComponent; dtm: TdtmCadastroNotasFiscais);  reintroduce;
    destructor Destroy; override;
{    procedure  SetDataModulo (Dtm: TdtmCadastroNotasFiscais);}
    procedure PosicionarLinhaColunaNaGrade;
  end;

var
  frmCadastroNotasFiscaisGrade: TfrmCadastroNotasFiscaisGrade;

implementation

uses fmcadastroprodutosnotafiscal, fmadicionarlinhagrade, fmListaItensnfe;

{$R *.dfm}

{ TfrmCadastronotasfiscaisGrade }

procedure TfrmCadastroNotasFiscaisGrade.AlterarEstadoBotoes;
begin
  if (not (sbnSalvar.Enabled)) and
     (dtmCadastroNotasFiscais.TabelaGrade.State<>dsinsert) and
     (not dtmCadastroNotasFiscais.PodeInserirnaGrade) then
    inherited;
  sbnIncluir.Enabled := (not (dtmCadastroNotasFiscais.SomenteLeitura));
end;

constructor TfrmCadastroNotasFiscaisGrade.Create(AOwner: TComponent; dtm: TdtmCadastroNotasFiscais);
begin
  inherited create(AOwner);
  SetDataModulo(dtm);

  DataSet:= dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal;

  with dtmCadastroNotasFiscais do
  begin
    dtmCadastroNotasFiscais.PosicionarLinhaColunaNaGrade := onPosicionarLinhaColunaNaGrade;
    dtmCadastroNotasFiscais.GradeAfterOpen := GradeAfterOpen;
  end;

  fraConsultaProduto := TfraConsultaCodigo.Create(self);
  fraConsultaProduto.Name := 'fraConsultaProduto';
  fraConsultaProduto.edfCodigo.MaxLength := 30;
  fraConsultaProduto.edfCodigo.DataSource := dtmCadastroNotasFiscais.dsrCaracteristicasNotaFiscal;
  fraConsultaProduto.edfCodigo.DataField := 'codigovisual';
  fraConsultaProduto.edfCodigo.Operacao := opATRIBUICAO;
  fraConsultaProduto.edfCodigo.LookupSource := fraConsultaProduto.dsrProcuraProdutos;
  fraConsultaProduto.edfCodigo.LookupQueryParameter := 'caracteristicavisual';
  fraConsultaProduto.edfCodigo.LookupField := 'codigovisual';
//  ConsultaProduto.edfCodigo.LocateParameters := 'produtovisual';
  fraConsultaProduto.AbrirTabelaProcura := false;
  fraConsultaProduto.CondicoesdaConsulta := CondicoesProduto;
  fraConsultaProduto.TipoPesquisa := pesPRODUTOS;
  fraConsultaProduto.OnFound := AtribuirDadosProdutos;
  self.visible := false;
end;

destructor TfrmCadastroNotasFiscaisGrade.Destroy;
begin
  inherited;
  frmCadastroNotasFiscaisGrade := nil;
end;

function TfrmCadastroNotasFiscaisGrade.InternoGravar: Boolean;

begin
{
  result := true;

  if dtmCadastroNotasFiscais.ExistePrecoemBranco then
    result := MensagemConfirmacao(ctPRECOEMBRANCOSERAODESCONSIDERADOS) = smbOK;

  if result then
  begin
   dtmCadastroNotasFiscais.GravarCopiaProdutosNotasFiscais;
   sbnSalvar.Enabled := false;
   edfCaracteristica.SetFocus;
  end;
  }
end;

procedure TfrmCadastroNotasFiscaisGrade.PosicionarLinhaColunaNaGrade;
var
  vNomedocampo: String;
begin
 //dbggrades.SetFocus;
 with  dtmCadastroNotasFiscais do
 begin

  if not qryProdutosNotaFiscal.IsEmpty then
  begin

    if dbggrades.canfocus then
      dbggrades.setfocus;

    case tipoGrade of
     tpLINHA : begin

                 if nomedocampoposicionar = '' then
                    vnomedocampo := CopiaProdutoColunaGrade
                 else
                    vnomedocampo := nomedocampoposicionar;

                 if dbggrades.SelectedIndex <> Colunas.IndexOf(vnomedocampo)+1 then
                   dbggrades.SelectedIndex := Colunas.IndexOf(vnomedocampo)+1;

                 if trim(dtmCadastroNotasFiscais.qryGrade.fieldbyname('valorlinha').asString) <> CopiaProdutoLinhaGrade then
                 begin
                   dtmCadastroNotasFiscais.qryGrade.first;
                   while not dtmCadastroNotasFiscais.qryGrade.eof do
                   begin
                     if trim(dtmCadastroNotasFiscais.qryGrade.fieldbyname('valorlinha').asString) = CopiaProdutoLinhaGrade then
                       break
                     else
                       dtmCadastroNotasFiscais.qryGrade.next;
                   end;
                 end;

               end;
     tpCOLUNA: begin

                 if nomedocampoposicionar='' then
                    vnomedocampo := CopiaProdutoLinhaGrade
                 else
                    vnomedocampo := nomedocampoposicionar;
 
                 if dbggrades.SelectedIndex <> Colunas.IndexOf(vnomedocampo)+1 then
                   dbggrades.SelectedIndex := Colunas.IndexOf(vnomedocampo)+1;

                 if trim(dtmCadastroNotasFiscais.qryGrade.fieldbyname('valorlinha').asString) <> CopiaProdutoColunaGrade then
                 begin
                   dtmCadastroNotasFiscais.qryGrade.first;
                   while not dtmCadastroNotasFiscais.qryGrade.eof do
                   begin
                     if trim(dtmCadastroNotasFiscais.qryGrade.fieldbyname('valorlinha').asString) = CopiaProdutoColunaGrade then
                       break
                     else
                       dtmCadastroNotasFiscais.qryGrade.next;
                   end;
                 end;
               end;
    end;
    nomedocampoposicionar := '';

  end;
 end;
end;

{
procedure TfrmCadastroNotasFiscaisGrade.SetDataModulo(Dtm: TdtmCadastroNotasFiscais);
begin
  dtmCadastroNotasFiscais := Dtm;
end;
}

procedure TfrmCadastroNotasFiscaisGrade.dbgGradesDrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  inherited;
  With dtmCadastroNotasFiscais do
  begin
    if (column.Index <> 0) and
       (column.Index < (ncolunasgrade-6))  then
    begin

//     dtmCadastroNotasFiscais.ColunaAtual := trim(dbggrades.Columns[dbgGrades.SelectedIndex].Title.caption);
     dtmCadastroNotasFiscais.PosicionarLinhaColunanoProdutoNotaFiscalCopia(trim(dbggrades.Columns[dbgGrades.SelectedIndex].Title.caption));
//     PosicionarLinhaColunanoProduto(trim(column.Title.Caption));
//      if not PosicionarLinhaColunanoProduto(trim(column.Title.Caption)) then
//        TDBGrid(Sender).Canvas.Brush.Color := clBtnFace;
//      TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
    end;

    if (column.Index = (ncolunasgrade-2))  then
    begin
      if Gradereducaobasediferente then
        TDBGrid(Sender).Canvas.font.Color := clred;
      TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
    end;

    if (column.Index = (ncolunasgrade-3))  then
    begin
      if Gradeipidiferente then
        TDBGrid(Sender).Canvas.font.Color := clred;
      TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
    end;

    if (column.Index = (ncolunasgrade-4))  then
    begin
      if Gradeicmsdiferente then
        TDBGrid(Sender).Canvas.font.Color := clred;
      TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
    end;

    if (column.Index = (ncolunasgrade-5))  then
    begin
      if Gradeprecodiferente then
        TDBGrid(Sender).Canvas.Font.Color := clred;
      TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
    end;
  end;
end;

procedure TfrmCadastroNotasFiscaisGrade.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  inherited;
//  PosicionarLinhaColunaNaGrade(field)
  dtmCadastroNotasFiscais.PosicionarLinhaColunanoProdutoNotaFiscal(
     trim(dbggrades.Columns[dbgGrades.SelectedIndex].Title.caption));
end;

procedure TfrmCadastroNotasFiscaisGrade.dbgGradesDblClick(Sender: TObject);
begin
  inherited;
  PopupMenuPopup(Sender); 
  {
  if ((dbgGrades.SelectedIndex<>0) and
     (dbggrades.SelectedIndex < (ncolunasgrade-6))) then
     AcionaCadastroProdutosNotasFiscais
     }
end;

