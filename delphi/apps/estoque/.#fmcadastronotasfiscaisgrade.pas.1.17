procedure TfrmCadastroNotasFiscaisGrade.dbgGradesKeyPress(Sender: TObject;
  var Key: Char);
begin
  inherited;
  with dtmCadastroNotasFiscais do
  begin
    if (dbgGrades.SelectedIndex <= (ncolunasgrade-7)) then
    begin
      if key = '0' then
      begin
        dtmCadastroNotasFiscais.ApagarProdutosNotasPagGrade(trim(dbggrades.Columns[dbgGrades.SelectedIndex].Title.caption), dbgGrades.SelectedField.FieldName );
        dbgGrades.Ordenacao := 'valorlinha';
        dbgGrades.refresh;

      end;
    end
    else
    if (dbgGrades.SelectedIndex = (ncolunasgrade-5)) then
    begin
        if Gradeprecodiferente then
          MensagemAviso(format(ctCAMPONAOPODESERALTERADO, [ANSIUpperCase(ctPRECO)]));
    end
    else
    if (dbgGrades.SelectedIndex = (ncolunasgrade-4)) then
    begin
        if Gradeicmsdiferente then
          MensagemAviso(format(ctCAMPONAOPODESERALTERADO, [ANSIUpperCase(ctICMS)]));
    end
    else
    if (dbgGrades.SelectedIndex = (ncolunasgrade-3)) then
    begin
        if Gradeipidiferente then
          MensagemAviso(format(ctCAMPONAOPODESERALTERADO, [ANSIUpperCase(ctIPI)]));
    end
    else
    if (dbgGrades.SelectedIndex = (ncolunasgrade-2)) then
    begin
        if GradeReducaoBaseDiferente then
          MensagemAviso(format(ctCAMPONAOPODESERALTERADO, [ANSIUpperCase(ctREDBASE)]));
    end;

  end;
end;

procedure TfrmCadastroNotasFiscaisGrade.dbgGradesKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  {
  if Shift = [ssCtrl] then
  begin
   if ((dbgGrades.SelectedIndex<>0) and
      (dbggrades.SelectedIndex < (ncolunasgrade-6))) then
    case key of
      TeclaEditarRegistro,
      TeclaInserirRegistro: AcionaCadastroProdutosNotasFiscais;
    end;
  end
  else
  }
  if key = VK_F9 then
    PopupMenuPopup(Sender)
end;

procedure TfrmCadastroNotasFiscaisGrade.sbnTrocarLInhaColunaClick(
  Sender: TObject);
var
 GradeEdicao : Boolean;
begin
  inherited;
  GradeEdicao := sbnSalvar.Enabled;
  dtmCadastroNotasFiscais.PosicionarLinhaColunanoProdutoNotaFiscalCopia(trim(dbggrades.Columns[dbgGrades.SelectedIndex].Title.caption));
  case tipograde of
   tpLINHA : tipograde := tpCOLUNA;
   tpCOLUNA : tipograde := tpLINHA;
  end;
  dtmCadastroNotasFiscais.GerarTabelaGrade;
  DataSet:= dtmCadastroNotasFiscais.TabelaGrade;
  dtmCadastroNotasFiscais.EditarGrade(GradeEdicao);
  PosicionarLinhaColunanaGrade;
end;

procedure TfrmCadastroNotasFiscaisGrade.sbnProcuraCaracteristicaClick(
  Sender: TObject);
begin
  inherited;
end;

{
function TfrmCadastroNotasFiscaisGrade.ExisteInformacao(Parametro: Integer;
  NomeCampo: String; Value: Variant): Boolean;
begin
 Result := dtmCadastroNotasFiscais.ExisteCaracteristica(NomeCampo, Value);
end;
}


procedure TfrmCadastroNotasFiscaisGrade.ckbValoresPadraoClick(
  Sender: TObject);
begin
  inherited;
  with dtmCadastroNotasFiscais do
  begin
   UtilizarValoresPadrao      := ckbValoresPadrao.Checked;
   ValorPadraoprecounitario   := edtPreco.ValorSemFormatacao;
   ValorPadraoaliquotaicms    := edtICMS.ValorSemFormatacao;
   ValorPadraoaliquotaipi     := edtIPI.ValorSemFormatacao;
   ValorPadraovalorreducaobase:= edtReducaoBase.ValorSemFormatacao;
  end;
end;

{
function TfrmCadastroNotasFiscaisGrade.AbrirGrade: Boolean;
begin
  if (dtmCadastroNotasFiscais.UltimaGradeCaracteristica<>
      edfCaracteristica.Text) and
      (dtmCadastroNotasFiscais.UltimaGradeCaracteristica<>'') and
      sbnSalvar.Enabled then
  begin
    if MensagemConfirmacao(ctINFORMACOESSERAOPERDIDAS) = smbOK then
    begin
      dtmCadastroNotasFiscais.EliminarCalculosIncluidos;
      result := true;
    end
    else
    begin
      result := false;
      edfCaracteristica.Text :=  dtmCadastroNotasFiscais.UltimaGradeCaracteristica;
      edfCaracteristica.Exist;
    end;
  end
  else
   result := dtmCadastroNotasFiscais.UltimaGradeCaracteristica<>
             edfCaracteristica.Text;

  if result then
  begin
    dtmCadastroNotasFiscais.TabelaGrade.Close;
    tipograde := tpLINHA;
    dtmCadastroNotasFiscais.GerarTabelaGrade;
    DataSet:= dtmCadastroNotasFiscais.TabelaGrade;
    sbnTrocarLInhaColuna.Enabled := dtmCadastroNotasFiscais.PodeTrocarVisualizacaoGrade;
  end;

end;
}

function TfrmCadastroNotasFiscaisGrade.InternoIncluir: Boolean;
begin
  Result := true;
  dtmCadastroNotasFiscais.AbrirElementosNaoCadastrados;
  if not Assigned (frmAdicionarLinhaGrade) then
    frmAdicionarLinhaGrade:= TfrmAdicionarLinhaGrade.Create(frmAdicionarLinhaGrade, dtmCadastroNotasFiscais);
  with frmAdicionarLinhaGrade do
  begin
    ShowModal;
    if frmAdicionarLinhaGrade.ModalResult = mrok then
      dtmCadastroNotasFiscais.GerarTabelaGrade;
    Free;
  end;
  dbggrades.Refresh;
  frmCadastroNotasFiscaisGrade.SetFocus;
end;

procedure TfrmCadastroNotasFiscaisGrade.AtualizarValores;
begin
 with dtmCadastroNotasFiscais do
 begin
//  edtpreco.Text := CaracteristicaNotaFiscalpreco;
//  edtICMS.text := CaracteristicaNotaFiscalicms;
//  edtIPI.Text := CaracteristicaNotaFiscalipi;
 end;
end;

procedure TfrmCadastroNotasFiscaisGrade.KeyDown(var Key: Word;
  Shift: TShiftState);
begin
  case Key of
    VK_F3: begin
              if (Shift = []) and sbnIncluir.Enabled then
                sbnIncluirClick(sbnIncluir);
            end;
    VK_F5: begin
              if (Shift = []) and sbnSalvar.Enabled then
                sbnSalvarClick(sbnSalvar);
            end;
    VK_G: begin
             if Shift = [ssCtrl] then
              if sbnTrocarLInhaColuna.Visible then
               sbnTrocarLInhaColunaClick(sbnTrocarLInhaColuna);
           end;
  else

  if self.ActiveControl = dbgGrades then
  begin
    case key of
     VK_PRIOR,
     VK_NEXT :
     begin
       BloquerAcaoBotes_Prior_Next := true;
       inherited KeyDown(Key, Shift);
       BloquerAcaoBotes_Prior_Next := false;

     end;
    end;
  end
  else
    inherited KeyDown(Key, Shift);
  end;
end;

function TfrmCadastroNotasFiscaisGrade.getncolunasgrade: integer;
begin
  fncolunasgrade := dbggrades.columns.count;
  Result := fncolunasgrade;
end;


function TfrmCadastroNotasFiscaisGrade.InternoCancelar: Boolean;
begin
  dtmCadastroNotasFiscais.EliminarCalculosIncluidos;
end;

procedure TfrmCadastroNotasFiscaisGrade.onPosicionarLinhaColunaNaGrade(
  Sender: TObject);
begin
  posicionarLinhaColunanaGrade;
end;

procedure TfrmCadastroNotasFiscaisGrade.PopupMenuPopup(Sender: TObject);
begin
  inherited;
  if (dbgGrades.SelectedIndex <> 0) and
     (dbgGrades.SelectedIndex <= dbgGrades.Columns.Count - 7) and
     (dbgGrades.datasource.DataSet.recordcount <> 0) then
  begin

    dtmCadastroNotasFiscais.VisualizandoProdutosdaNFE := true;
    dtmCadastroNotasFiscais.VisualizandoProdutosdaNFELC := true;

    dtmCadastroNotasFiscais.qryProdutosNotasPagNFE.AfterScroll := nil;
    dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItems.AfterScroll := nil;


    frmListaItensnfe := TfrmListaItensnfe.create(self, dtmCadastroNotasFiscais);
    frmListaItensnfe.ckbVisualizarComSaldosQuantidadeNFe.Checked := dtmCadastroNotasFiscais.VisualizarComSaldosQuantidadeNFe;

    {
    frmListaItensnfe.edtLinha.Text := dtmCadastroNotasFiscais.qrygrade.fieldbyname('valorlinha').asstring;
    frmListaItensnfe.edtColuna.Text := dtmCadastroNotasFiscais.Colunas.Strings[dbgGrades.SelectedIndex-1];
    }

    dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.edit;
    dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscalvalorgrade1.asString := dtmCadastroNotasFiscais.qrygrade.fieldbyname('valorlinha').asstring;
    dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscalvalorgrade2.asString := dtmCadastroNotasFiscais.Colunas.Strings[dbgGrades.SelectedIndex-1];
    dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.post;


    frmListaItensnfe.vValorLinha :=  dtmCadastroNotasFiscais.qrygrade.fieldbyname('valorlinha').asstring;
    frmListaItensnfe.vValorColuna := dtmCadastroNotasFiscais.Colunas.Strings[dbgGrades.SelectedIndex-1];

    frmListaItensnfe.dtxProdutoDescricao.text := dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscaldescricao.asString+
                                                 dtmCadastroNotasFiscais.qrygrade.fieldbyname('valorlinha').asstring+
                                                 dtmCadastroNotasFiscais.Colunas.Strings[dbgGrades.SelectedIndex-1];

    dtmCadastroNotasFiscais.qryProdutosNotasPagNFE.filtered := false;

    frmListaItensnfe.VerificarVisualizacoes;

    dtmCadastroNotasFiscais.qryProdutosNotasPagNFE.filtered :=
      dtmCadastroNotasFiscais.aplicarfiltroProdutosNotasPagNFE;

    frmListaItensnfe.showmodal;
    if frmListaItensnfe.modalresult = mrOk then
    begin
      dtmCadastroNotasFiscais.ColunaAtual := dtmCadastroNotasFiscais.Colunas.Strings[dbgGrades.SelectedIndex-1];;
      dtmCadastroNotasFiscais.NomeCampoColunaAtual := dbgGrades.SelectedField.FieldName;
      dtmCadastroNotasFiscais.AtualizarItensgradenfe;
    end;
    frmListaItensnfe.free;

    dtmCadastroNotasFiscais.VisualizandoProdutosdaNFE := false;
    dtmCadastroNotasFiscais.VisualizandoProdutosdaNFELC := false;
    dtmCadastroNotasFiscais.qryProdutosNotasPagNFE.filtered := false;


    dtmCadastroNotasFiscais.qryProdutosNotasPagNFE.AfterScroll := dtmCadastroNotasFiscais.qryProdutosNotasPagNFEAfterScroll;
    dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItems.AfterScroll := dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsAfterScroll;

  end
  else

  if dbgGrades.datasource.DataSet.recordcount = 0 then
    InternoIncluir;
end;

procedure TfrmCadastroNotasFiscaisGrade.CondicoesProduto;
var
  vCondicaoGrade: String;
  vCondicaoDesde: String;

begin
  vCondicaoGrade := ' and c.grade1 is not null and c.grade2 is not null ';

  if dbSelecionarProdutosDesde.Checked then
    vCondicaoDesde := ' and c.datacadastro >= '+quotedstr(FormatDateTime('yyyy-mm-dd',dtmCadastroNotasFiscais.qryNotaFiscaldataselecaoprodutosgrade.Asdatetime));

//  fraConsultaProduto.qryConsultaProdutos.close;

  fraConsultaProduto.qryConsultaProdutos.MacroByName('CondicaoGrade').asString := vCondicaoGrade;
  fraConsultaProduto.qryProcuraProdutos.MacroByName('CondicaoGrade').asString := vCondicaoGrade;

  fraConsultaProduto.qryConsultaProdutos.MacroByName('SelecionarProdutosDesde').asString := vCondicaoDesde;

end;

procedure TfrmCadastroNotasFiscaisGrade.AtribuirDadosProdutos;
begin
  with dtmCadastroNotasFiscais do
  begin
    qryCaracteristicasNotaFiscaldescricao.AsString := fraConsultaProduto.qryProcuraProdutos.FieldByName('descricao').AsString;
    qryCaracteristicasNotaFiscalcaracteristica.asString := fraConsultaProduto.qryProcuraProdutos.FieldByName('codigo').AsString;
    qryCaracteristicasNotaFiscalcodigovisual.asString := fraConsultaProduto.qryProcuraProdutos.FieldByName('codigo').AsString;
    qryCaracteristicasNotaFiscalgrade1.asInteger := fraConsultaProduto.qryProcuraProdutos.FieldByName('grade1').AsInteger;
    qryCaracteristicasNotaFiscalgrade2.asInteger := fraConsultaProduto.qryProcuraProdutos.FieldByName('grade2').AsInteger;
    qryCaracteristicasNotaFiscallinha.asString := fraConsultaProduto.qryProcuraProdutos.FieldByName('linha').AsString;
    qryCaracteristicasNotaFiscalcoluna.asString := fraConsultaProduto.qryProcuraProdutos.FieldByName('coluna').AsString;

    qryCaracteristicasNotaFiscal.Post;

    GerarTabelaGrade;
  end;

end;

procedure TfrmCadastroNotasFiscaisGrade.dbgCaracteristicasNotasFiscaisDblClick(
  Sender: TObject);
begin
  inherited;
//  acionarPesquisaGrade;

end;

procedure TfrmCadastroNotasFiscaisGrade.AcionarPesquisaGrade;
begin
  if (dtmCadastroNotasFiscais.qryProdutosNotaFiscal.RecordCount = 0) or
     (dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.state in [dsinsert, dsedit]) then
    with fraConsultaProduto do
    begin
      dbgCaracteristicasNotasFiscais.SetFocus;
      fraConsultaProduto.CtrlOn := True;
      fraConsultaProduto.InternoPesquisar('Item de Produto');
      dbgCaracteristicasNotasFiscais.SetFocus;
      dbgCaracteristicasNotasFiscais.SelectedIndex :=  0;
    end;
end;

procedure TfrmCadastroNotasFiscaisGrade.sbnProcuraClick(Sender: TObject);
begin
  inherited;
  AcionarPesquisaGrade;
end;

procedure TfrmCadastroNotasFiscaisGrade.sbnIncluirItemClick(
  Sender: TObject);
begin
  inherited;
  dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.Append;
  dbgCaracteristicasNotasFiscais.SelectedIndex :=  0;
end;

procedure TfrmCadastroNotasFiscaisGrade.dbgCaracteristicasNotasFiscaisKeyDown(
  Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;
  if Shift = [ssCtrl] then
  begin
    case Key of
      VK_F3    : begin
                   if sbnIncluirItem.enabled then
                      sbnIncluirItemClick(nil);
                 end;

      VK_Delete : begin
                    if sbnExcluirProduto.enabled then
                       sbnExcluirProdutoClick(nil);
                  end;

      VK_F9    : begin

                   if  (dbgCaracteristicasNotasFiscais.SelectedField = dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscalcodigovisual) or
                       (dbgCaracteristicasNotasFiscais.SelectedField = dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscaldescricao) then
                   begin
                     fraConsultaProduto.CtrlOn := Shift = [ssCtrl];
                     if (Shift = []) or fraConsultaProduto.CtrlOn then
                       AcionarPesquisaGrade
                   end;

                 end;
    end;
  end
  else
  case Key of
    VK_Return: if (dbgCaracteristicasNotasFiscais.SelectedField = dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscalcodigovisual) then
                begin
                  if not dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscalcodigovisual.readonly then
                  begin

                    fraConsultaProduto.edfCodigo.text := dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscalcodigovisual.asString;
                    fraConsultaProduto.edfCodigo.exist;

                    if not fraConsultaProduto.qryProcuraProdutos.IsEmpty then
                      AtribuirDadosProdutos
                    else
                    begin
                      key := 0;
                      dbgCaracteristicasNotasFiscais.SelectedIndex :=  0;
                      dbgCaracteristicasNotasFiscais.SetFocus;
                    end;

                  end;
                end;
  end;

end;

procedure TfrmCadastroNotasFiscaisGrade.sbnExcluirClick(Sender: TObject);
begin
  inherited;
  if (dtmCadastroNotasFiscais.qryProdutosNotaFiscal.RecordCount = 0) or
     (dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.state in [dsinsert, dsedit]) then
    dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.delete;

end;

procedure TfrmCadastroNotasFiscaisGrade.Timer1Timer(Sender: TObject);
begin
  inherited;
  sbnIncluir.enabled := not ((dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.RecordCount = 0) or
                             (dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.state in [dsinsert, dsedit]));

  sbnProcura.enabled :=  (dtmCadastroNotasFiscais.qryProdutosNotaFiscal.RecordCount = 0) {or
                         (dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.state in [dsinsert, dsedit])};

  sbnExcluirproduto.enabled := (dtmCadastroNotasFiscais.qryProdutosNotaFiscal.RecordCount = 0);

  if sbnExcluirproduto.enabled then
    lblCaracteristicasNotasFiscais.Caption :=
     'Ctrl+F9 - Procurar  |  Ctrl+Del - Excluir  |  Ctrl+F2 - Incluir';

end;

procedure TfrmCadastroNotasFiscaisGrade.sbnExcluirProdutoClick(
  Sender: TObject);
begin
  inherited;
  if (dtmCadastroNotasFiscais.qryProdutosNotaFiscal.RecordCount = 0) or
     (dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.state in [dsinsert, dsedit]) then
    dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.delete;

end;

procedure TfrmCadastroNotasFiscaisGrade.SpeedButton1Click(Sender: TObject);
begin
  inherited;
  dbgCaracteristicasNotasFiscais.Refresh;
end;

procedure TfrmCadastroNotasFiscaisGrade.GradeAfterOpen(Sender: TObject);
begin
 dbgGrades.Ordenacao := 'valorlinha';
end;

procedure TfrmCadastroNotasFiscaisGrade.SetDataModulo(
  Dtm: TdtmCadastroNotasFiscais);
begin
  dtmCadastroNotasFiscais := dtm;
  dtxValorProdutos.DataSource := dtmCadastroNotasFiscais.dsrNotaFiscal;
  dtxTotalIPI.DataSource := dtmCadastroNotasFiscais.dsrNotaFiscal;
  dtxTotalProdutos.DataSource := dtmCadastroNotasFiscais.dsrNotaFiscal;
  edtSelecionarProdutosDesde.DataSource := dtmCadastroNotasFiscais.dsrNotaFiscal;
  dbgCaracteristicasNotasFiscais.DataSource := dtmCadastroNotasFiscais.dsrCaracteristicasNotaFiscal;
  dbgGrades.DataSource := dtmCadastroNotasFiscais.dsrGrade;
end;

end.
