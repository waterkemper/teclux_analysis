procedure TfrmCadastroPedidos.ckbMarcarTodosClick(Sender: TObject);
begin
  inherited;
  dtmCadastroPedidos.MarcarDesmarcarAtualizarPrecodeVenda(ckbMarcarTodos.Checked);
end;

procedure TfrmCadastroPedidos.pgcPedidosChange(Sender: TObject);
begin
  inherited;
  if pgcPedidos.ActivePage = tstNotasPendentesdeEntrada then
    dtmCadastroPedidos.ConsultaProdutosEntradaSefaz;
end;

procedure TfrmCadastroPedidos.Criar_frmCadastroProdutosPedidos_;
begin
  if not assigned(frmCadastroProdutosPedidos_)  then
    frmCadastroProdutosPedidos_ := TfrmCadastroProdutosPedidos_.Create(self);

  with frmCadastroProdutosPedidos_ do
  begin
    SetDataModulo(dtmCadastroPedidos);
    DataSet:= dtmCadastroPedidos.TabelaProdutoPedido;
  end;

end;

end.
