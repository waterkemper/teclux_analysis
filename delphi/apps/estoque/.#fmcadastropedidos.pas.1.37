      ((CodClienteAnt=0) and (TipoclienteAnt='') and
       (dtmCadastroPedidos.qryPedidosfornecedor.AsInteger<>0) and
       ('F'<>'')) then
  begin
    dtmCadastroPedidos.ExibirFicha(ClassName);
