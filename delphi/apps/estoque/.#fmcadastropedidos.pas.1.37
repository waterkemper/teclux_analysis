procedure TfrmCadastroPedidos.sbnAcionarTelaFormacaoPrecoVendaClick(
  Sender: TObject);
begin
  inherited;
  if not (dtmCadastroPedidos.qryPedidos.state in [dsedit, dsinsert]) then
     AcionarTelaFormacaoPrecoVenda(dtmCadastroPedidos.qryProdutosPedidospedido.asInteger,
                                 dtmCadastroPedidos.qryProdutosPedidosnumero.asInteger,
                                 dtmCadastroPedidos.qryProdutosPedidosproduto.asString,
                                 'Pedidos')
  else
    MensagemAviso('Para visualizar a formação do preço de venda grave o pedido');
end;

procedure TfrmCadastroPedidos.sbnCustoePrecoVendaClick(Sender: TObject);
var
  vAux_VisualizarDetalhesProdutosNota : Boolean;
begin
  inherited;
{  if Not dtmCadastroPedidos.SomenteLeitura then}
//  if (dtmCadastroPedidos.qryProdutosPedidossituacao.asString = 'P') or
//     (dtmCadastroPedidos.qryProdutosPedidossituacao.asString = 'A') then
  begin
    vAux_VisualizarDetalhesProdutosNota := dtmCadastroPedidos.VisualizarDetalhesProdutosNota;
    visulizandoCustoePrecoVenda := not visulizandoCustoePrecoVenda;
    if visulizandoCustoePrecoVenda then
    begin
      if vAux_VisualizarDetalhesProdutosNota then
        dtmCadastroPedidos.VisualizarDetalhesProdutosNota := false;

      if dtmCadastroPedidos.CalcularCusto then
        dtmCadastroPedidos.CalcularPrecoVenda;

      if vAux_VisualizarDetalhesProdutosNota then
        dtmCadastroPedidos.VisualizarDetalhesProdutosNota := true;
    end;
    VisualizarPaineisCusto;
  end;
end;

