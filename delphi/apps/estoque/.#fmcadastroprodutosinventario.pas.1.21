begin
 if not fraConsulta_.qryProcuraEstoquesLotesProdutosproduto.IsNull then
 begin
   dtmCadastroInventario.AtribuirQuantidadesLotes(false);
 end
 else
 begin
   {
   with dtmCadastroInventario do
