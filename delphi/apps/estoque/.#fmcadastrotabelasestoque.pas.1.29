procedure TfrmCadastroTabelasEstoque.DBAdvGridClassesGetEditorType(
  Sender: TObject; ACol, ARow: Integer; var AEditor: TEditorType);
begin
  inherited;
  fraConsulta_.visible := false;

  if (TDBAdvGrid(Sender).Columns[Acol].FieldName = 'classe') then
  begin
    With fraConsulta_ do
    begin
      fraConsulta_.Width := TDBAdvGrid(Sender).Columns[Acol].Width;
      fraConsulta_.edfcodigo.Width := fraConsulta_.Width-23;
      fraConsulta_.sbnprocura.left := fraConsulta_.edfcodigo.Width;

      fraConsulta_.edfCodigo.Operacao := opATRIBUICAO;
      fraConsulta_.edfCodigo.MaxLength := 4;

      fraConsulta_.edfCodigo.DataaFieldInterno := '';
      fraConsulta_.edfCodigo.DataaFieldVisual := '';
      fraConsulta_.edfCodigo.DataField := '';


      fraConsulta_.edfCodigo.DataSource := dtmCadastroTabelasEstoques.dsrCashBackClasses;
      fraConsulta_.edfCodigo.DataField := TDBAdvGrid(Sender).Columns[Acol].FieldName;


      fraConsulta_.edfCodigo.LookupaFieldinterno := '';
      fraConsulta_.edfCodigo.LookupaFieldvisual := '';
      fraConsulta_.edfCodigo.LookupQueryParameter := '';
      fraConsulta_.edfCodigo.LookupField := '';
      
      fraConsulta_.edfCodigo.LookupSource := fraConsulta_.dsrProcuraClasses;
      fraConsulta_.edfCodigo.LookupQueryParameter := 'codigo';
      fraConsulta_.edfCodigo.LookupField := 'codigo';

      fraConsulta_.OnFound := AtribuirDadosClassesCashBack;
      TipoPesquisa := pesCLASSES;

      fraConsulta_.edfCodigo.text := dtmCadastroTabelasEstoques.dsrCashBackClasses.dataset.fieldbyname(TDBAdvGrid(Sender).Columns[Acol].fieldname).asString;
      fraConsulta_.edfCodigo.exist;

    end;
    fraConsulta_.visible := true;

  end;

end;

procedure TfrmCadastroTabelasEstoque.AtribuirDadosClassesCashBack(Found: Boolean);
begin
  if DBAdvGridClasses.GetDistinctValues(1, DBAdvGridClasses.row, true ).indexof(fraConsulta_.qryProcuraClasses.fieldbyname('codigo').asString)<>-1 then
  begin
    MensagemAviso('Classe já cadastrado!');
    dtmCadastroTabelasEstoques.qryCashBackClasses.cancel;
  end
  else
    dtmCadastroTabelasEstoques.qryCashBackClassesdescricaoclasse.asString :=
       fraConsulta_.qryProcuraClasses.fieldbyname('descricao').asString;

end;

