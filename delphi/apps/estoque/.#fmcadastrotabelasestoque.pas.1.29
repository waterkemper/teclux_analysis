Uses
  //Biblio
  clparametrossistema, DB, dmbasico;

{$R *.dfm}

constructor TfrmCadastroTabelasEstoque.Create(AOwner: TComponent);
begin
  dtmCadastroTabelasEstoques := TdtmCadastroTabelasEstoques.Create(Self);
  inherited;
  DataSet := dtmCadastroTabelasEstoques.TabelaGrupos;
  dtmCadastroTabelasEstoques.Abre(ctTabelaGrupos);
  pgcTabelas.ActivePage := tstGrupos;
  tstGradesProdutos.TabVisible := ParSistema.UsarGradesProdutos;
  fraConsultaClassificacaoIPI.TipoPesquisa:= pesNCMTABELAIPI;
  fraConsultaClassificacaoIPI.CondicoesdaConsulta:= NCMAntesAbrir;

  dbgGruposComissoes.OnDelete := dtmCadastroTabelasEstoques.ExcluirGruposComissoes;
  stxClassesVendaSem.Height:= 11;
  stxGruposVendaSem. Height:= 11;
  dbgAgendamentoGrupos.onDelete := dtmCadastroTabelasEstoques.ExcluirGruposAgendamentos;

  fraConsultaCodigoCashBack.tipopesquisa := pesCashBack;
  pnlEdicaoDados.visible := false;

  AdvDBDateTimePickervalidadeinicial.DateTime := dtmCadastroTabelasEstoques.DataHoraServidor;
  AdvDBDateTimePickervalidadeFinal.DateTime := dtmCadastroTabelasEstoques.DataHoraServidor;


  fraConsultaCodigoAtributos.tipopesquisa := pesAtributos;
  fraConsultaCodigoAtributos.OnFound := AtribuirDadosAtributos;


  fraConsultaClassificacao_Vigilancia_Sanitaria.tipopesquisa := pesClassificacao_Vigilancia_Sanitaria;


end;

destructor TfrmCadastroTabelasEstoque.Destroy;
begin
  dtmCadastroTabelasEstoques:=nil;
  inherited;
  frmCadastroTabelasEstoque := nil;
end;


procedure TfrmCadastroTabelasEstoque.sbnReplicarValoresICMSClick(Sender: TObject);
begin
  dtmCadastroTabelasEstoques.ReplicarValoresICMS
end;

procedure TfrmCadastroTabelasEstoque.sbnSincronizarICMSEstadosClick(Sender: TObject);
begin
  dtmCadastroTabelasEstoques.SincronizarICMSEstados(0);
end;

procedure TfrmCadastroTabelasEstoque.pgcTabelasChange(Sender: TObject);
begin
  with dtmCadastroTabelasEstoques do begin
    case TtecTabelasEstoque(pgcTabelas.ActivePageIndex) of
      tbeGRADES             : DataSet := TabelaGrade;
      tbeGRUPOS             : DataSet := TabelaGrupos;
      tbeCLASSES            : DataSet := TabelaClasses;
      tbeUNIDADES           : DataSet := TabelaUnidades;
      tbeICMS               : DataSet := TabelaICMS;
      tbeIPI                : DataSet := TabelaIPI;
      tbeOBSLEGAIS          : DataSet := TabelaObsLegais;
      tbeOBSLIVROSFISCAIS   : DataSet := qryObsLivrosFiscais;
      tbeCOLUNAS            : DataSet := TabelaColunas;
      tbePROMOCOES          : DataSet := TabelaPromocoes;
      tbeCASHBACK           :
      begin
        DataSet := qryCashBack;
        {
        AdvDBDateTimePickervalidadeinicial.Date := dtmCadastroTabelasEstoques.DataServidor;
        AdvDBDateTimePickervalidadeinicial.Time := dtmCadastroTabelasEstoques.HoraServidor;
        }
//        AdvDBDateTimePickervalidadeinicial.DateTime := dtmCadastroTabelasEstoques.DataHoraServidor;

//        AdvDBDateTimePickervalidadeinicial.Checked := false;

//        AdvDBDateTimePickervalidadeFinal.Date := dtmCadastroTabelasEstoques.DataServidor;
//        AdvDBDateTimePickervalidadeFinal.Time := dtmCadastroTabelasEstoques.HoraServidor;
//        AdvDBDateTimePickervalidadeFinal.DateTime := dtmCadastroTabelasEstoques.DataHoraServidor;

//        AdvDBDateTimePickervalidadefinal.Checked := false;

      end;
      tbeMARCAS             : DataSet := TabelaMarcas;
      tbeMODELOS            : DataSet := qryModelos;
      tbeGRUPOSFORNECEDORES : DataSet := TabelaGruposFornecedores;
      tbeFATORES            : DataSet := TabelaFatoresPreco;
      tbeATRIBUTOS          : DataSet := qryAtributos_Produtos;
    end;
    TipoTabela := TtecTabelasEstoque(pgcTabelas.ActivePageIndex);
    AbrirTabelasCadastro(TipoTabela);
    PosicionarCursor;
  end;
end;

function TfrmCadastroTabelasEstoque.PesquisaHabilitada: Boolean;
begin
  if pgcTabelas.activepage = tstCashBack then
  begin
    result := false;
//    if ActiveControl =  fraConsultaCodigoCashBack.edfCodigo then
      fraConsultaCodigoCashBack.InternoPesquisar('Cash Back');
  end
  else
  if pgcTabelas.activepage = tstAtributos then
  begin
    result := false;
//    if ActiveControl =  fraConsultaCodigoAtributos.edfCodigo then
      fraConsultaCodigoAtributos.InternoPesquisar('Atributos');
  end
  else
  begin
    if CtrlOn then
    begin

      if ActiveControl is TtecDBFindLookup then
      begin
        if fraConsultaClassificacaoIPI.edfCodigo.Focused then
          Result:= False
        else
          Result:= True;

      end
      else
        Result:= False;

    end
    else
    begin
      TipoPesquisa:= pesNENHUMA;
      Result:= True;
    end;
  end;  

end;

function TfrmCadastroTabelasEstoque.InternoPesquisar(Titulo:String): Integer;
begin
  Result:= mrNone;
  if PesquisaHabilitada then
    with dtmCadastroTabelasEstoques do
    begin
      AbrirTabelasConsulta(TipoTabela);
      Result:= inherited InternoPesquisar(TituloPesquisa);
      if Result = mrOK then
        SelecionarMultiplas(TipoTabela, TipoPesquisa);
      FecharTabelasConsulta(TipoTabela);
    end;
end;

function TfrmCadastroTabelasEstoque.InternoIncluir: Boolean;
begin
  PosicionarCursor;
  Result:= inherited InternoIncluir;
  if Result and not CtrlOn then
     with dtmCadastroTabelasEstoques do
      case TipoTabela of
        tbeGRADES             : Result := IncluirGrade;
        tbeGRUPOS             : Result := IncluirGrupos;
        tbeCLASSES            : Result := IncluirClasses;
        tbeUNIDADES           : Result := IncluirUnidades;
        tbeICMS               : Result := IncluirICMS;
        tbeIPI                : Result := IncluirIPI;
        tbeOBSLEGAIS          : Result := IncluirObsLegais;
        tbeOBSLIVROSFISCAIS   : Result := IncluirObsLivrosFiscais;
        tbeCOLUNAS            : Result := IncluirColunas;
        tbePROMOCOES          : Result := IncluirPromocoes;
        tbeCASHBACK           :
        begin
          Result := IncluirCashBack;
          AdvDBDateTimePickervalidadeFinal.checked := false;
        end;
        tbeMARCAS             : Result := IncluirMarcas;
        tbeMODELOS            : Result := IncluirModelos;
        tbeGRUPOSFORNECEDORES : Result := IncluirGruposFornecedores;
        tbeFATORES            : Result := IncluirFatoresPreco;
        tbeATRIBUTOS          : begin
                                  result := IncluirAtributos_Produtos;
                                   
                                end;
      end;
end;

function TfrmCadastroTabelasEstoque.InternoExcluir: Boolean;
begin
  Result:= inherited InternoExcluir;
  if Result and not CtrlOn then
    with dtmCadastroTabelasEstoques do begin
      case TipoTabela of
        tbeGRADES             : Result := ExcluirGrade;
        tbeGRUPOS             : Result := ExcluirGrupos;
        tbeCLASSES            : Result := ExcluirClasses;
        tbeUNIDADES           : Result := ExcluirUnidades;
        tbeICMS               : Result := ExcluirICMS;
        tbeIPI                : Result := ExcluirIPI;
        tbeOBSLEGAIS          : Result := ExcluirObsLegaisNotas;
        tbeOBSLIVROSFISCAIS   : Result := ExcluirObsLegaisLivros;
        tbeCOLUNAS            : Result := ExcluirColunas;
        tbePROMOCOES          : Result := ExcluirPromocoes;
        tbeCASHBACK           : Result := ExcluirCashBack;
        tbeMARCAS             : Result := ExcluirMarcas;
        tbeMODELOS            : Result := ExcluirModelos;
        tbeGRUPOSFORNECEDORES : Result := ExcluirGruposFornecedores;
        tbeFATORES            : Result := ExcluirFatoresPreco;
        tbeATRIBUTOS          : Result := ExcluirAtributos_Produtos;
      end;
    end;
    PosicionarCursor;
end;

function TfrmCadastroTabelasEstoque.InternoGravar: Boolean;
begin
  Result := True;
  if ActiveControl is TtecDBFindLookup then
    Result := TtecDBFindLookup(ActiveControl).Exist;
  if Result then begin
    Result := inherited InternoGravar;
    if Result then
      with dtmCadastroTabelasEstoques do
      case TipoTabela of
        tbeGRADES             : Result := GravarGrade;
        tbeGRUPOS             : Result := GravarGrupos;
        tbeCLASSES            : Result := GravarClasses;
        tbeUNIDADES           : Result := GravarUnidades;
        tbeICMS               : Result := GravarICMS;
        tbeIPI                : Result := GravarIPI;
        tbeOBSLEGAIS          : Result := GravarObsLegaisNotas;
        tbeOBSLIVROSFISCAIS   : Result := GravarObsLegaisLivros;
        tbeCOLUNAS            : Result := GravarColunas;
        tbePROMOCOES          : Result := GravarPromocoes;
        tbeCASHBACK           : Result := GravarCashBack;
        tbeMARCAS             : Result := GravarMarcas;
        tbeModelos            : Result := GravarModelos;
        tbeGRUPOSFORNECEDORES : Result := GravarGruposFornecedores;
        tbeFATORES            : Result := GravarFatoresPreco;
        tbeATRIBUTOS          :
        begin
          Result := GravarAtributos_Produtos;

        end;
      end;
    if Result then
      PosicionarCursor
  end;
end;

function TfrmCadastroTabelasEstoque.TituloPesquisa: String;
begin
  case TipoTabela of
    tbeGRADES            : Result := 'Grades';
    tbeGRUPOS    :  case TipoPesquisa of
                       pesCLASSES:  Result := 'Classes';
                     else           Result := 'Grupos';
                     end;
    tbeCLASSES            : Result := 'Classes';
    tbeUNIDADES           : Result := 'Unidades';
    tbeICMS               : Result := 'ICMS';
    tbeIPI                : Result := 'IPI';
    tbeOBSLEGAIS,
    tbeOBSLIVROSFISCAIS   : Result := 'Observações Legais';
    tbeCOLUNAS            : Result := 'Colunas';
    tbePROMOCOES          : Result := 'Promoções';


    tbeMARCAS             : Result := 'Marcas';
    tbeMODELOS            : Result := 'Modelos';
    tbeGRUPOSFORNECEDORES : Result := 'Grupos Fornecedores';
    tbeFATORES            : Result := 'Fatores Preço';
  end;
end;

function TfrmCadastroTabelasEstoque.JanelaPesquisa: TfrmConsultaBasica;
begin
  Result := TfrmConsultaPorCampo.Create(nil);
  TfrmConsultaPorCampo(Result).ConsultaInterativa := True;
end;

function TfrmCadastroTabelasEstoque.TabelaDePesquisa: TZDataSet;
begin
  with dtmCadastroTabelasEstoques do
    case TipoTabela of
      tbeGRADES             : Result := ConsultarGrade;
      tbeGRUPOS    : case TipoPesquisa of
                       pesCLASSES:  Result := ConsultarClasses;
                     else           Result := ConsultarGrupos;
                     end;
      tbeCLASSES            : Result := ConsultarClasses;
      tbeUNIDADES           : Result := ConsultarUnidades;
      tbeICMS               : Result := ConsultarICMS;
      tbeIPI                : Result := ConsultarIPI;
      tbeOBSLEGAIS          : Result := ConsultarObsLegais;
      tbeOBSLIVROSFISCAIS   : Result := qryConsultaObsLivrosFiscais;
      tbeCOLUNAS            : Result := ConsultarColunas;
      tbePROMOCOES          : REsult := ConsultarPromocoes;
      tbeMARCAS             : Result := ConsultarMarcas;
      tbeModelos            : Result := qryConsultaModelos;
      tbeGRUPOSFORNECEDORES : Result := ConsultarGruposFornecedores;
      tbeFATORES            : Result := ConsultarFatoresPreco;
      else                    Result := nil;
    end;
end;

function TfrmCadastroTabelasEstoque.ExisteInformacao(Parametro: Integer; NomeCampo: String; Value: Variant): Boolean;
begin
  with dtmCadastroTabelasEstoques do
  case TipoTabela of
    tbeGRADES             : Result := ExisteGrade(NomeCampo, Value);
    tbeGRUPOS    : case TipoPesquisa of
                     pesCLASSES: Result := ExisteClasses(NomeCampo, Value)
                   else          Result := ExisteGrupos(NomeCampo, Value)
                   end;
    tbeCLASSES            : Result := ExisteClasses(NomeCampo, Value);
    tbeUNIDADES           : Result := ExisteUnidades(NomeCampo, Value);
    tbeICMS               : Result := ExisteICMS(NomeCampo, Value);
    tbeIPI                : Result := ExisteIPI(NomeCampo, Value);
    tbeOBSLEGAIS          : Result := ExisteObsLegais(NomeCampo, Value);
    tbeOBSLIVROSFISCAIS   : Result := ExisteLivrosFiscais(NomeCampo, Value);
    tbeCOLUNAS            : Result := ExisteColunas(NomeCampo, Value);
    tbePROMOCOES          : REsult := ExistePromocao(NomeCampo, Value);
    tbeMARCAS             : Result := ExisteMarcas(NomeCampo, Value);
    tbeModelos            : result := ExisteModelos(NomeCampo, Value);
    tbeGRUPOSFORNECEDORES : Result := ExisteGruposFornecedores(NomeCampo, Value);
    tbeFATORES            : Result := ExisteFatoresPreco(NomeCampo, Value);
    else                    Result := False;
  end;
end;

procedure TfrmCadastroTabelasEstoque.Keydown(var Key: Word; Shift: TShiftState);
begin
  inherited;
  if ((pgcTabelas.ActivePage = tstICMS) and
      sbnReplicarValoresICMS.Enabled  and
      (Shift = [ssCtrl]) and(Key = VK_R))
  then
    sbnReplicarValoresICMSClick(nil);
end;

procedure TfrmCadastroTabelasEstoque.PosicionarCursor;
begin
   case TipoTabela of
     tbeGRADES             : edfGradesProdutos.SetFocus;
     tbeGRUPOS             : edfGrupo.SetFocus;
     tbeCLASSES            : edfClasse.SetFocus;
     tbeUNIDADES           : edfUnidade.SetFocus;
     tbeFATORES            : edfCodigoFator.SetFocus;
     tbeICMS               : if edfICMS.canfocus then
                               edfICMS.SetFocus
                             else
                               edtDescricaoICMS.SetFocus;

     tbeIPI                : if edfIPI.canfocus then
                               edfIPI.SetFocus
                             else
                               edtDescricaoIPI.SetFocus;

     tbeOBSLEGAIS          : if edfObsLegaisNotas.canfocus then
                               edfObsLegaisNotas.SetFocus
                             else
                               mmoDescricaoObsLegais.SetFocus;

     tbeOBSLIVROSFISCAIS   : if edfObsLegaisLivros.canfocus then
                               edfObsLegaisLivros.SetFocus
                             else
                               mmoDescricaoObsLegaisLivros.SetFocus;

     tbeCOLUNAS            : if edfColuna.canfocus then
                               edfColuna.SetFocus
                             else
                               edtDescricaoColunas.SetFocus;

     tbePROMOCOES          : if edfPromocao.canfocus then
                               edfPromocao.SetFocus
                             else
                               edtDescricaoPromocao.SetFocus;

     tbeCASHBACK           : if fraConsultaCodigoCashBack.edfCodigo.canfocus then
                               fraConsultaCodigoCashBack.edfCodigo.SetFocus
                             else
                               edtDescricaoCashBack.SetFocus;

     tbeATRIBUTOS           : if fraConsultaCodigoAtributos.edfCodigo.CanFocus then
                               fraConsultaCodigoAtributos.edfCodigo.SetFocus
                             else
                               edtDescricaoAtributo.SetFocus;

     tbeMARCAS             : if edfMarca.canfocus then
                               edfMarca.SetFocus
                             else
                               edtDescricaoMarcas.SetFocus;

     tbeMODELOS             : if edfCodigoModelo.canfocus then
                               edfCodigoModelo.SetFocus
                             else
                               edtEspecificacao.SetFocus;

     tbeGRUPOSFORNECEDORES : if edfCodigoGruposFornecedores.canfocus then
                               edfCodigoGruposFornecedores.SetFocus
                             else
                               edtDescricaoGruposFornecedores.SetFocus;
   end;
end;

