  Sender: TObject; ACol, ARow: Integer; var AEditor: TEditorType);
begin
  inherited;


  fraConsulta_.visible := false;

  if (TDBAdvGrid(Sender).Columns[Acol].FieldName = 'grupo') then
  begin
    With fraConsulta_ do
    begin
      fraConsulta_.Width := TDBAdvGrid(Sender).Columns[Acol].Width;
      fraConsulta_.edfcodigo.Width := fraConsulta_.Width-23;
      fraConsulta_.sbnprocura.left := fraConsulta_.edfcodigo.Width;



      fraConsulta_.edfCodigo.Operacao := opATRIBUICAO;
      fraConsulta_.edfCodigo.MaxLength := 4;

      fraConsulta_.edfCodigo.DataaFieldInterno := '';
      fraConsulta_.edfCodigo.DataaFieldVisual := '';
      fraConsulta_.edfCodigo.DataField := '';

      fraConsulta_.edfCodigo.DataSource := dtmCadastroTabelasEstoques.dsrCashBackGrupos;

      fraConsulta_.edfCodigo.DataaFieldInterno := TDBAdvGrid(Sender).Columns[Acol].FieldName;
      fraConsulta_.edfCodigo.DataaFieldVisual := TDBAdvGrid(Sender).Columns[Acol].FieldName;
      fraConsulta_.edfCodigo.DataField := TDBAdvGrid(Sender).Columns[Acol].FieldName;


      fraConsulta_.edfCodigo.LookupaFieldinterno := '';
      fraConsulta_.edfCodigo.LookupaFieldvisual := '';
      fraConsulta_.edfCodigo.LookupQueryParameter := '';
      fraConsulta_.edfCodigo.LookupField := '';

      fraConsulta_.edfCodigo.LookupSource := fraConsulta_.dsrProcuraGrupoProdutos;
      fraConsulta_.edfCodigo.LookupaFieldinterno := 'codigo';
      fraConsulta_.edfCodigo.LookupaFieldvisual := 'codigo';

      fraConsulta_.edfCodigo.LookupQueryParameter := 'codigo';
      fraConsulta_.edfCodigo.LookupField := 'codigo';

      fraConsulta_.OnFound := AtribuirDadosGruposCashBack;
      TipoPesquisa := pesGRUPOS;

      fraConsulta_.edfCodigo.text := dtmCadastroTabelasEstoques.dsrCashBackGrupos.dataset.fieldbyname(TDBAdvGrid(Sender).Columns[Acol].fieldname).asString;
      fraConsulta_.edfCodigo.exist;
      
    end;
    fraConsulta_.visible := true;

  end;

end;

procedure TfrmCadastroTabelasEstoque.AtribuirDadosGruposCashBack(Found: Boolean);
begin
  if DBAdvGridGrupos.GetDistinctValues(1, DBAdvGridGrupos.row, true ).indexof(fraConsulta_.qryProcuraGrupoProdutos.fieldbyname('codigo').asString)<>-1 then
  begin
    MensagemAviso('Grupo já cadastrado!');
    dtmCadastroTabelasEstoques.qryCashBackGrupos.cancel;
  end
  else
    dtmCadastroTabelasEstoques.qryCashBackGruposdescricaogrupo.asString :=
