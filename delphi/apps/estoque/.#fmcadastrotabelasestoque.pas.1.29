procedure TfrmCadastroTabelasEstoque.Pesquizar1Click(Sender: TObject);
begin
  inherited;
  if pgcTabelas.ActivePage = tstCashBack then
  begin
    if AdvPageControlGrupos.ActivePage = AdvTabSheetProdutos then
      AdvGridFindDialog1.Grid := DBAdvGridProdutos
    else
    if AdvPageControlGrupos.ActivePage = AdvTabSheetGrupos then
      AdvGridFindDialog1.Grid := DBAdvGridGrupos
    else
    if AdvPageControlGrupos.ActivePage = AdvTabSheetClasses then
      AdvGridFindDialog1.Grid := DBAdvGridClasses
    else
    if AdvPageControlGrupos.ActivePage = AdvTabSheetMarcas then
      AdvGridFindDialog1.Grid := DBAdvGridMarcas
    else
    if AdvPageControlGrupos.ActivePage = AdvTabSheetCargos then
      AdvGridFindDialog1.Grid := DBAdvGridCargos
    else
    if AdvPageControlGrupos.ActivePage = AdvTabSheetFiliais then
      AdvGridFindDialog1.Grid := DBAdvGridFiliais;

  end;
  AdvGridFindDialog1.Execute;

end;

procedure TfrmCadastroTabelasEstoque.ExportarExcel1Click(Sender: TObject);
var vnomearquivo: String;
begin
  inherited;
  if pgcTabelas.ActivePage = tstCashBack then
  begin
    if AdvPageControlGrupos.ActivePage = AdvTabSheetProdutos then
    begin
      AdvGridExcelIO1.AdvStringGrid := DBAdvGridProdutos;
      vNomeArquivo := ExtractFilePath(Application.ExeName) + 'Saidas\CashBack_Produtos.xls';
      AdvGridExcelIO1.XLSExport(vNomeArquivo, 'CashBack_Produtos');
    end
    else
    if AdvPageControlGrupos.ActivePage = AdvTabSheetGrupos then
    begin
      AdvGridExcelIO1.AdvStringGrid := DBAdvGridGrupos;
      vNomeArquivo := ExtractFilePath(Application.ExeName) + 'Saidas\CashBack_Grupos.xls';
      AdvGridExcelIO1.XLSExport(vNomeArquivo, 'CashBack_Grupos');
    end
    else
    if AdvPageControlGrupos.ActivePage = AdvTabSheetClasses then
    begin
      AdvGridExcelIO1.AdvStringGrid := DBAdvGridClasses;
      vNomeArquivo := ExtractFilePath(Application.ExeName) + 'Saidas\CashBack_Classes.xls';
      AdvGridExcelIO1.XLSExport(vNomeArquivo, 'CashBack_Classes');
    end
    else
    if AdvPageControlGrupos.ActivePage = AdvTabSheetMarcas then
    begin
      AdvGridExcelIO1.AdvStringGrid := DBAdvGridMarcas;
      vNomeArquivo := ExtractFilePath(Application.ExeName) + 'Saidas\CashBack_Marcas.xls';
      AdvGridExcelIO1.XLSExport(vNomeArquivo, 'CashBack_Marcas');
    end
    else
    if AdvPageControlGrupos.ActivePage = AdvTabSheetCargos then
    begin
      AdvGridExcelIO1.AdvStringGrid := DBAdvGridCargos;
      vNomeArquivo := ExtractFilePath(Application.ExeName) + 'Saidas\CashBack_Cargos.xls';
      AdvGridExcelIO1.XLSExport(vNomeArquivo, 'CashBack_Cargos');
    end
    else
    if AdvPageControlGrupos.ActivePage = AdvTabSheetFiliais then
    begin
      AdvGridExcelIO1.AdvStringGrid := DBAdvGridFiliais;
      vNomeArquivo := ExtractFilePath(Application.ExeName) + 'Saidas\CashBack_Filiais.xls';
      AdvGridExcelIO1.XLSExport(vNomeArquivo, 'CashBack_Filiais');
    end;

  end;
end;

end.
