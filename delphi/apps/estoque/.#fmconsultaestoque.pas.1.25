procedure TfrmConsultaEstoque.OperacaoPadrao(Value: array of Variant);
begin
  inherited;
  edfFilial.clear;
  fraConsultaCaracteristica.edfCodigo.clear;
  edfGrupo.clear;
  edfClasse.clear;
  pgcItensProdutos.activepageindex := 0;
  pgcExclusivos.activepageindex := 0;

//  edfFilial.text := value[0];
//  edfFilial.exist;

  edfFilial.clear;
  fraConsultaEstoqueItemProduto.edfCodigo.text := value[1];
  fraConsultaEstoqueItemProduto.edfCodigo.exist;

  sbnGerarClick(sbngerar);

end;

