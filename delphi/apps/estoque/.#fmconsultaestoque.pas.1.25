procedure TfrmConsultaEstoque.edtValorUltimacompraKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if dtmconsultaestoque.qryAjustarValorUltimaCompra.State in [dsinsert, dsedit] then
  begin
    if ((Key = VK_RETURN) or (Key = VK_Return)) then
      sbnGravarValorClick(Self);
  end;
end;

procedure TfrmConsultaEstoque.sbnGravarValorClick(Sender: TObject);
begin
  inherited;
  dtmconsultaestoque.qryAjustarValorUltimaCompra.Edit;
  dtmconsultaestoque.GravarValorUltimaCompra(edtValorUltimaCompra.ValorSemFormatacao, False);
  sbnGravarValor.Enabled:= False;
end;

procedure TfrmConsultaEstoque.pgcEstoquesSimilaresChange(Sender: TObject);
begin
  inherited;
  {
  with dtmconsultaestoque do
  begin
    if (pgcEstoquesSimilares.ActivePage = tstEstoquesSimilares) then
    begin
      Mostrar:= 'E';
      AbrirTabelasEstoque(similares);
    end
    else if (pgcEstoquesSimilares.ActivePage = tstAcumuladoresSimilares) and tstAcumuladoresSimilares.TabVisible then
    begin
      Mostrar:= 'A';
      AbrirTabelasAcumuladores(True);
    end;
  end;
  }
end;

