  var AllowChange: Boolean);
begin
  inherited;
  case pgcItensProdutos.ActivePageIndex of
  1: begin
     end;

  2: begin
//      gbxInformacoesProdutos.Visible := false;
      with dtmconsultaestoque do
       if qryGrade.Active then
         PosicionarLinhaColunanoProduto(dbgGrades_.Cells[0, Arow_], dbgGrades_.Cells[Acol_, 0], qryconsultaestoques)
     end;
  end;
