begin
  inherited;
  edfFilial.clear;
  pgcItensProdutos.activepageindex := 0;
  fraMultiplaSelecaoAleatoria.pgcMultiplaSelecaoAleatoria.ActivePageIndex := 0;
  edffilial.text := value[0];
  edffilial.exist;
  fraMultiplaSelecaoAleatoria.fraSelecaoAleatoriaItemdeProdutos.SetarCodigo(Value[1]);
  sbnGerarClick(sbngerar);

end;

