uses dmbasico, frselecaoaleatoriaprodutos,
  frselecaoaleatoriagruposprodutos, frselecaoaleatoriaclassesprodutos,
  frselecaoaleatoriamarcasprodutos, frselecaoaleatoriapromocoes;

{$R *.dfm}

constructor TfrmConsultaEstoque.Create(AOwner: TComponent);
begin
//  dtmConsultaEstoque := TdtmConsultaEstoque.Create(Self);
  inherited;

//  dtmconsultaestoque.Mostrar := 'E';
  fraMultiplaSelecaoAleatoria.pgcMultiplaSelecaoAleatoria.ActivePageIndex := 0;
  fraMultiplaSelecaoAleatoria.fraSelecaoAleatoriaItemdeProdutos.fraSelecaoAleatoriaItemdeProduto.dbgSelecaoAleatoria.setfocus;
  pgcEstoques.ActivePage   := tstEstoque;
  pgcItensProdutos.ActivePage :=tstItensProdutos;
  tstMovimento.TabVisible    := UsuarioLogin.GerenteEstoque;
  tstPrecosCargos.TabVisible := ParSistema.PrecosporCargo;
  tstPrecos.TabVisible := not ParSistema.PrecosporCargo;
  tstPrecosporCliente.TabVisible := ParSistema.PrecoParaCliente;
  tstAcumuladores.TabVisible := UsuarioLogin.GerenteEstoque;
  FIndex:= 1;
  if ParSistema.FiliaisIndependentes then begin
//    lblFilial.Visible               := False;
    pnlTopLeft.Visible := False;
    dbgProdutos.Columnbyname('filial').Visible  := False;
    dbgSimilares.Columnbyname('filial').Visible := False;
    dtxPedidos.DataField:= 'totalfiliais';
  end;
  dtxValorPromocao.Font.Color :=$00142EDC;
  dtxValidadePromocao.Font.Color:=$00142EDC;
  tstGradeProdutos.TabVisible := ParSistema.UsarGradesProdutos;
  dbgProdutos.Columnbyname('valorgrade1').Visible := ParSistema.UsarGradesProdutos;
  dbgProdutos.Columnbyname('valorgrade2').Visible := ParSistema.UsarGradesProdutos;
  dbgSimilares.Columnbyname('valorgrade1').Visible := ParSistema.UsarGradesProdutos;
  dbgSimilares.Columnbyname('valorgrade2').Visible := ParSistema.UsarGradesProdutos;
  dbgComponentes.Columnbyname('valorgrade1').Visible := ParSistema.UsarGradesProdutos;
  dbgComponentes.Columnbyname('valorgrade2').Visible := ParSistema.UsarGradesProdutos;

  if not ParSistema.UsarGradesProdutos then
  begin
    dbgProdutos.Font.Size:=9;
    dbgSimilares.Font.Size:=9;
  end;
  if ParSistema.TamanhoMascaraQuantidade > dbgProdutos.Columnbyname('emestoque').Width then
    dbgProdutos.Columnbyname('emestoque').Width := ParSistema.TamanhoMascaraQuantidade;

  if ParSistema.TamanhoMascaraQuantidade > dbgVendas.Columns[2].Width then
    dbgVendas.Columns[2].Width := ParSistema.TamanhoMascaraQuantidade;

  if ParSistema.TamanhoMascaraQuantidade > dbgCompras.Columns[2].Width then
    dbgCompras.Columns[2].Width := ParSistema.TamanhoMascaraQuantidade;

  if ParSistema.TamanhoMascaraQuantidade > dbgCompras.Columns[1].Width then
    dbgProdutosPedidos.Columns[1].Width := ParSistema.TamanhoMascaraQuantidade;

  pnlcstproduto.Visible := dtmconsultaestoque.ExisteCRTNormal;
  pnlcsosnproduto.Visible := dtmconsultaestoque.ExisteCRTSimples;

{
  fraConsultaEstoqueItemProduto.TipoPesquisa := pesItemProdutosConsulta;
  fraConsultaEstoqueItemProduto.CondicoesdaConsulta := CondicoesConsultaEstoqueItemProduto;
}

  fraMultiplaSelecaoAleatoria.fraSelecaoAleatoriaItemdeProdutos.fraSelecaoAleatoriaItemdeProduto.ConsultaSelecaoAleatoria.TipoPesquisa := pesItemProdutosConsulta;
  fraMultiplaSelecaoAleatoria.fraSelecaoAleatoriaItemdeProdutos.onEnter_ := GerarDados;
//  fraMultiplaSelecaoAleatoria.fraSelecaoAleatoriaItemdeProdutos.fraSelecaoAleatoriaItemdeProduto.ConsultaSelecaoAleatoria.CondicoesdaConsulta := CondicoesConsultaEstoqueItemProduto;


  dbgGrades_.Bands.PrimaryColor := TColor(strtoint(parsistema.CorZebradoRelatorio));
  
end;

destructor TfrmConsultaEstoque.Destroy;
begin
  dtmConsultaEstoque:=nil;
  inherited;
  frmConsultaEstoque := nil;
end;

procedure TfrmConsultaEstoque.sbnProcuraFilialClick(Sender: TObject);
begin
  CtrlOn := True;
  edfFilial.SetFocus;
  InternoPesquisar('');
end;



procedure TfrmConsultaEstoque.sbnGerarClick(Sender: TObject);
begin
  if VerificaCamposConsulta then begin
    with dtmConsultaEstoque do begin  
      Filial     := edfFilial.Text;
      ItemProduto:= fraMultiplaSelecaoAleatoria.fraSelecaoAleatoriaItemdeProdutos.ListaCondicional;
      Produto    := fraMultiplaSelecaoAleatoria.fraSelecaoAleatoriaprodutos.ListaCondicional;
      Grupo      := fraMultiplaSelecaoAleatoria.fraSelecaoaleatoriagruposprodutos.ListaCondicional;
      Classe     := fraMultiplaSelecaoAleatoria.fraSelecaoaleatoriaclassesprodutos.ListaCondicional;
      ListaCondicaoMarcas    := fraMultiplaSelecaoAleatoria.fraSelecaoAleatoriamarcasProdutos.ListaCondicional;
      ListaCondicaoPromocoes := fraMultiplaSelecaoAleatoria.fraSelecaoaleatoriapromocoes.ListaCondicional;

      if AbrirTabelaConsultaEstoques then
      begin
        if edfFilial.CanFocus then
         edfFilial.SetFocus;
      end
      else
      begin
        if pgcItensProdutos.ActivePage = tstGradeProdutos then
          pgcItensProdutosChange(pgcItensProdutos);
      end;
    end;
  end;

  pgcItensProdutos.ActivePageIndex := 0;

end;

procedure TfrmConsultaEstoque.edfGrupoKeyDown(Sender: TObject;var Key: Word; Shift: TShiftState);
begin
  if TeclaEnterOuReturn(Key) and (Shift = []) then
    sbnGerar.Click;
end;

procedure TfrmConsultaEstoque.KeyDown(var Key: Word; Shift: TShiftState);
begin
  inherited;
  case Key of
  VK_Escape: begin
               dtmconsultaestoque.ReFazConsultaTabelas;
               edfFilial.SetFocus;
             end;
     VK_F6 : sbnGerar.Click;
  end;
end;

function TfrmConsultaEstoque.JanelaPesquisa: TfrmConsultaBasica;
begin
  Result := TfrmConsultaPorCampo.Create(nil);
  if (TipoPesquisa in [pesITEMPRODUTOS, pesCARACTERISTICAS]) then
       TfrmConsultaPorCampo(Result).ConsultaInterativa := False
  else TfrmConsultaPorCampo(Result).ConsultaInterativa := True;
  TfrmConsultaPorCampo(Result).UsarParametrosDaTabela := False;
end;

function TfrmConsultaEstoque.TituloPesquisa: String;
begin
  case TipoPesquisa of
       pesITEMPRODUTOS: Result := 'Item produto';
    pesCARACTERISTICAS: Result := 'Produto';
             pesGRUPOS: Result := 'Grupo';
            pesCLASSES: Result := 'Classe';
            pesFILIAIS: Result := 'Filial';
  end;
end;

function TfrmConsultaEstoque.ExisteInformacao(Parametro: Integer; NomeCampo: String; Value: Variant): Boolean;
begin
  with dtmConsultaEstoque do
    case TipoPesquisa of
               pesFILIAIS: Result := ExisteFilial(NomeCampo, Value);
    else                   Result := False;
    end;
end;

function TfrmConsultaEstoque.TabelaDePesquisa: TZDataSet;
begin
  with dtmConsultaEstoque do
    case TipoPesquisa of
              pesFILIAIS: Result := ConsultaFilial;
    else                  Result := nil;
    end;
end;

function TfrmConsultaEstoque.InternoPesquisar(Titulo:String): Integer;
begin
 try
  Result := mrNone;
  if PesquisaHabilitada then
    with dtmConsultaEstoque do begin
      AbreTabelasPesquisa(TipoPesquisa);
      Result := inherited InternoPesquisar(TituloPesquisa);
      if Result = mrOK then
         Selecionar(TipoPesquisa);
      FechaTabelasPesquisa(TipoPesquisa);
    end
  except
    on E: Exception do ShowMessage(E.Message);
  end
end;

function TfrmConsultaEstoque.PesquisaHabilitada: Boolean;
begin
  Result:= False;
  if CtrlOn then begin
    if ActiveControl is TtecDBEditFind then begin
      if edfFilial.Focused then
        TipoPesquisa := pesFILIAIS;
      Result := True;
    end;
  end;
end;

function TfrmConsultaEstoque.VerificaCamposConsulta: Boolean;
begin
  Result := (fraMultiplaSelecaoAleatoria.fraSelecaoAleatoriaItemdeProdutos.fraSelecaoAleatoriaItemdeProduto.qrySelecaoAleatoria.recordcount <> 0) or
            (fraMultiplaSelecaoAleatoria.fraSelecaoAleatoriaprodutos.fraSelecaoAleatoriaProduto.qrySelecaoAleatoria.recordcount <> 0) or
            (fraMultiplaSelecaoAleatoria.fraSelecaoaleatoriagruposprodutos.fraSelecaoAleatoriaGrupoProduto.qrySelecaoAleatoria.recordcount <> 0) or
            (fraMultiplaSelecaoAleatoria.fraSelecaoaleatoriaclassesprodutos.fraSelecaoAleatoriaClasseProduto.qrySelecaoAleatoria.recordcount <> 0) or
            (fraMultiplaSelecaoAleatoria.fraSelecaoAleatoriamarcasProdutos.fraSelecaoAleatoriamarcasProduto.qrySelecaoAleatoria.recordcount <> 0) or
            (fraMultiplaSelecaoAleatoria.fraSelecaoaleatoriapromocoes.fraSelecaoAleatoriapromocoes.qrySelecaoAleatoria.recordcount <> 0);

  if Result then
    Result := OperadorTernario(Trim(edfFilial.Text) <> '',(edfFilial.Exist), True)
  else
  begin
    MensagemAviso('Informe um parâmetro para a consulta!');
    fraMultiplaSelecaoAleatoria.pgcMultiplaSelecaoAleatoria.ActivePageIndex := 0;
    fraMultiplaSelecaoAleatoria.fraSelecaoAleatoriaItemdeProdutos.fraSelecaoAleatoriaItemdeProduto.dbgSelecaoAleatoria.setfocus;
  end;


end;

procedure TfrmConsultaEstoque.pgcEstoquesChange(Sender: TObject);
begin
  inherited;
  with dtmconsultaestoque do begin
    if (pgcEstoques.ActivePage = tstEstoque) then
    begin
      if pgcItensProdutos.activepage = tstItensProdutos then
        AbrirTabelasEstoque(produtos)
      else
      if pgcItensProdutos.activepage = tstSimilares then
        AbrirTabelasEstoque(similares)
      else
      if pgcItensProdutos.activepage = tstComponentes then
        AbrirTabelasEstoque(componentes);
    end
    else if (pgcEstoques.ActivePage = tstAcumuladores) and tstAcumuladores.TabVisible then
    begin
//      Mostrar:= 'A';
      if pgcItensProdutos.ActivePage = tstItensProdutos then
        AbrirTabelasAcumuladores(false)
      else
      if pgcItensProdutos.activepage = tstSimilares then
        AbrirTabelasAcumuladores(true)
      else
      if pgcItensProdutos.ActivePage = tstComponentes then
        AbrirTabelasAcumuladores(false);
    end;
  end;
end;

procedure TfrmConsultaEstoque.pgcItensProdutosChange(Sender: TObject);
var
 i: integer;
begin
  inherited;
  case pgcItensProdutos.ActivePageIndex of
  0: begin
       dtmconsultaestoque.AbrirTabelasEstoque(produtos);
       pgcEstoques.Parent := tstItensProdutos;
       pnlRotulos.Parent := tstItensProdutos;
       dtmconsultaestoque.dsrConsultaEstoques.DataSet := dtmconsultaestoque.qryConsultaEstoques;

       if assigned(frmConsultaProdutosNotasFiscaisAnteriores) and (frmConsultaProdutosNotasFiscaisAnteriores.owner = self) then
         frmConsultaProdutosNotasFiscaisAnteriores.fraProdutosNotasFiscaisAnteriores1.AbrirqryProdutosNotaFiscalAnteriores;

       pgcEstoquesChange(nil);

     end;

  1: begin
       dtmconsultaestoque.AbrirTabelaProdutosSimilares ;
       dtmconsultaestoque.AbrirTabelasEstoque(similares);
       pgcEstoques.Parent := tstSimilares;
       pnlRotulos.Parent := tstSimilares;
       dtmconsultaestoque.dsrConsultaEstoques.DataSet := dtmconsultaestoque.qryConsultaEstoquesSimilares;
       if assigned(frmConsultaProdutosNotasFiscaisAnteriores) and (frmConsultaProdutosNotasFiscaisAnteriores.owner = self) then
         frmConsultaProdutosNotasFiscaisAnteriores.fraProdutosNotasFiscaisAnteriores1.AbrirqryProdutosNotaFiscalAnteriores;

       pgcEstoquesChange(nil);
       
     end;
  2: begin
//      gbxInformacoesProdutos.Visible := true;
      with dtmconsultaestoque do
      begin
       if UtilizandoGrade then
       begin

         dbgGrades_.FixedCols := 0;
         GerarTabelaGrade;


         if dtmconsultaestoque.qryGrade.Active then
         begin
           if  dbgGrades_.FixedCols <> 1 then
              dbgGrades_.FixedCols := 1;

           if dbgGrades_.FixedRows <> 1 then
             dbgGrades_.FixedRows := 1;


           for i:=0 to dbgGrades_.Columns.Count-1 do
             if not dbgGrades_.Columns[i].ShowBands then
             dbgGrades_.Columns[i].ShowBands := true;

         end;

         PosicionarLinhaColunanaGrade;

         if not dbgGrades_.wordwrap then
           dbgGrades_.wordwrap := true;

         dbgGrades_.AutoSizeRows(false);
         dbgGrades_.Refresh;

       end;
      end;
     end;
  3: dtmconsultaestoque.AbrirTabelaProdutosModelos;
  4: begin
       dtmconsultaestoque.AbrirTabelaComponentes ;
       dtmconsultaestoque.AbrirTabelasEstoque(componentes);
       pgcEstoques.Parent := tstComponentes;
       pnlRotulos.Parent := tstComponentes;
       dtmconsultaestoque.dsrConsultaEstoques.DataSet := dtmconsultaestoque.qryConsultaEstoquesComponentes;

     end;
 end;
end;

procedure TfrmConsultaEstoque.dbgProdutosDrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  inherited;
  if  (dtmConsultaEstoque.ProdutoInativo or dtmConsultaEstoque.ProdutoForaLinha) then
  begin
    TDBGrid(Sender).Canvas.Brush.Color := $007DBEFF;
    TDBGrid(Sender).Canvas.Font.Color := clBlack;
  end
  else if dtmconsultaestoque.ProdutoEmPromocao then
  begin
    TDBGrid(Sender).Canvas.Brush.Color := clWhite;
    TDBGrid(Sender).Canvas.Font.Color := clRed;
  end;
  TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
end;

