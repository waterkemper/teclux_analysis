procedure TfrmConsultaEstoque.dbgGrades_GetCellColor(Sender: TObject; ARow,
  ACol: Integer; AState: TGridDrawState; ABrush: TBrush; AFont: TFont);
begin
  inherited;
//  if (gdFocused in AState) or (gdFixed in AState) then
    if (Acol <> 0) and (ARow <> 0) and dtmconsultaestoque.qryGrade.active then
    begin

      With dtmconsultaestoque do
      begin

  //      if PosicionarLinhaColunanoProduto( trim(dtmconsultaestoque.qryGrade.Fields[ACol].DisplayName), qryConsultaLinhaColuna) then
        if PosicionarLinhaColunanoProduto(dbgGrades_.Cells[0, Arow], dbgGrades_.Cells[Acol, 0], qryConsultaLinhaColuna) then

        begin
          if ProdutoLinhacolunaEmPromocao then
          begin
             AFont.Color := clRed;
             AFont.Style := [fsBold];

             if (gdselected in AState) then
               dbgGrades_.SelectionTextColor := clRed;
          end
          else
            if (gdselected in AState) then
              dbgGrades_.SelectionTextColor := clBlack;
        end;

      end;
    
    end;

end;

procedure TfrmConsultaEstoque.dbgGrades_SelectCell(Sender: TObject; ACol,
  ARow: Integer; var CanSelect: Boolean);
begin
  inherited;
  ACol_ := ACol;
  ARow_ := Arow;
  dtmconsultaestoque.PosicionarLinhaColunanoProduto(dbgGrades_.Cells[0, Arow], dbgGrades_.Cells[Acol, 0], nil );
  dtmconsultaestoque.AbrirConsulteEstoque;
end;

end.

