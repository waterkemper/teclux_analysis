  else if dtmconsultaestoque.ProdutoSimilarEmPromocao then
  begin
    TDBGrid(Sender).Canvas.Font.Color := clRed;
    TDBGrid(Sender).Canvas.Brush.Color:= clWhite;
  end;
  TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
end;

procedure TfrmConsultaEstoque.AfterScrollLinhaColunaGrade(Sender: TObject);
begin
 dbgProdutos.Columnbyname('valorgrade1').Title.Caption := dtmconsultaestoque.LinhadaGrade;
 dbgProdutos.Columnbyname('valorgrade2').Title.Caption := dtmconsultaestoque.colunadaGrade;
 tstGradeProdutos.TabVisible := (dtmconsultaestoque.LinhadaGrade<>'') or
                                (dtmconsultaestoque.ColunadaGrade<>'');

 if assigned(frmConsultaProdutosNotasFiscaisAnteriores) and (frmConsultaProdutosNotasFiscaisAnteriores.owner = self) then
   frmConsultaProdutosNotasFiscaisAnteriores.fraProdutosNotasFiscaisAnteriores1.AbrirqryProdutosNotaFiscalAnteriores;


end;

procedure TfrmConsultaEstoque.CriarDataModulo;
begin
  inherited;
  dtmConsultaEstoque := TdtmConsultaEstoque.Create(Self);
  dtmConsultaEstoque.OnScrollLinhaColunaGrade := AfterScrollLinhaColunaGrade;
  dtmConsultaEstoque.OnScrollLinhaColunaGradeSimilar := AfterScrollLinhaColunaGradeSimilar;
  dtmConsultaEstoque.OnScrollLinhaColunaGradeComponente := AfterScrollLinhaColunaGradeComponente;
end;

procedure TfrmConsultaEstoque.AjustarGradeProdutos;
Var
 I: Integer;
begin
  inherited;
  {
  with dtmconsultaestoque do
  begin
    dbgGrades.Columns[0].Width :=100;
    dbgGrades.Columns[0].Title.Caption := LinhadaGrade+'/'+ColunadaGrade;
    dbgGrades.Columns[0].Title.Alignment := taCenter;
    for I:=1 to dbgGrades.Columns.Count-1 do
    begin
      dbggrades.Columns[I].Width :=130;
      dbggrades.Columns[I].Alignment := taRightJustify;
      dbgGrades.Columns[I].Title.Alignment := taCenter;
      if dbgGrades.Columns.Count > 2 then
        dbggrades.Columns[I].Title.Caption := Colunas.Strings[I-1]
      else dbggrades.Columns[I].Title.Caption := ' ';
    end;
    dbgGrades.FixedCols := 1;
  end;
  }
end;

procedure TfrmConsultaEstoque.PosicionarLinhaColunaNaGrade;
var
{
 vCol, vRow : integer;
 }

 Loc: TPoint;
 Fp: TFindParams;



begin

 {
 dbggrades.SetFocus;
 with  dtmconsultaestoque do
 begin
  dbggrades.SelectedIndex := Colunas.IndexOf(ProdutoColunaGrade)+1;
  qrygrade.First;
  while not qrygrade.Eof do
  begin
   if qrygrade.Fields[0].AsString = ProdutoLinhaGrade then
   begin
    vRow := qrygrade.recno;
    break;
   end;
   qrygrade.Next;
  end;
 end;

 vCol := dtmconsultaestoque.Colunas.IndexOf(dtmconsultaestoque.ProdutoColunaGrade)+1;
 }

// Loc := Point(-1,-1);
// fp := [fnAutoGoto, fnDirectionLeftRight, fnMatchRegular];

 dbgGrades_.FindFirst(dtmConsultaEstoque.qryConsultaEstoquesprodutovisual.AsString+'*',[fnAutoGoto, fnDirectionLeftRight, fnMatchRegular]);

// Loc := dbgGrades_.Find(loc, dtmConsultaEstoque.qryConsultaEstoquesprodutovisual.AsString+'*',fp);


// dbggrades_.SelectCols(0,vCol);
// dbggrades_.SelectRows(0,vRow);
 dbggrades_.Refresh;

end;

