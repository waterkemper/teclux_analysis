procedure TfrmEmissaoEtiquetas.dbgplp_b2wGetColumnFilter(Sender: TObject;
  Column: Integer; Filter: TStrings);
begin
  inherited;
  if not (Column in [7,8]) then
    Filter.Clear;
end;


procedure TfrmEmissaoEtiquetas.dbgplp_b2wFilterProgress(Sender: TObject;
  progress: Smallint);
var
  vplp : String;
begin
  inherited;
  if dbgplp_b2w.RowCount > 0 then
  begin
    vplp := dbgplp_b2w.Cells[2, dbgplp_b2w.row];
    if vplp <> dtmEmissaoEtiquetas.qryplpb2wplp.asString then
      if vplp <> '' then
        dtmEmissaoEtiquetas.qryplpb2w.locate('plp', strtoint(vplp), []);
  end;

end;

procedure TfrmEmissaoEtiquetas.dbgplp_b2wSelectCell(Sender: TObject; ACol,
  ARow: Integer; var CanSelect: Boolean);
var
  vplp : String;
begin
  inherited;
  if dbgplp_b2w.rowcount > 0 then
  begin
    vplp := dbgplp_b2w.Cells[2, ARow];
    if vplp <> dtmEmissaoEtiquetas.qryplpb2wplp.asString then
      if vplp <> '' then
        dtmEmissaoEtiquetas.qryplpb2w.locate('plp', strtoint(vplp), []);
  end;
end;

procedure TfrmEmissaoEtiquetas.DBAdvGridMagaluSelectCell(Sender: TObject;
  ACol, ARow: Integer; var CanSelect: Boolean);
var
  vCodigo: String;
begin
  inherited;
  if DBAdvGridMagalu.rowcount > 0 then
  begin
    vCodigo := DBAdvGridMagalu.Cells[1, ARow];
    if vCodigo <> dtmEmissaoEtiquetas.qryEtiquetasMagalucodigo_pedido_marketplace.asString then
      if vCodigo <> '' then
        dtmEmissaoEtiquetas.qryEtiquetasMagalu.locate('codigo_pedido_marketplace', vcodigo, []);
  end;      

end;

procedure TfrmEmissaoEtiquetas.ckbSelecionarTodasEtiquetasMagaluClick(
  Sender: TObject);
begin
  inherited;
  if pgcEtiquetas.ActivePage = tstMagalu then
    dtmEmissaoEtiquetas.MarcarDesmarcarEtiquetasMagalu(ckbSelecionarTodasEtiquetasMagalu.checked)
  else
    dtmEmissaoEtiquetas.MarcarDesmarcarEtiquetasCorreios(ckbSelecionarTodasEtiquetasMagalu.checked)

end;

