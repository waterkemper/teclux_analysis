procedure TfrmEmissaoEtiquetas.pgcEtiquetasChange(Sender: TObject);
begin
  inherited;

  pgcEtiquetas.height := 253;

  gbxEtiquetaemBranco.visible := True;
  stxNrEtiquetas.visible := True;

  if pgcEtiquetas.ActivePageIndex = 3 then
     pgcNotasProdutos.ActivePageIndex := 1
  else
  if pgcEtiquetas.ActivePage = tstb2w_ then
  begin

    gbxIntervalorInclusaob2W.Parent := pnlParametrosB2W;
    gbxIntervalorInclusaob2W.taborder := 0;

    ckbIncluirB2WJaImpressos.Parent := pnlParametrosB2W;
    ckbIncluirB2WJaImpressos.taborder := 1;

//    ckbSomenteUmaPorPedido.parent := pnlParametrosB2W;
//    ckbSomenteUmaPorPedido.taborder := 2;

    pgcNotasProdutos.ActivePageIndex := 2;
    gbxEtiquetaemBranco.visible := false;
    stxNrEtiquetas.visible := false;

    edtDataInicialInclusaoB2W.text := FormatDateTime('dd/MM/yyyy', dtmEmissaoEtiquetas.DataServidor);
    edtDataFinalInclusaoB2W.text := FormatDateTime('dd/MM/yyyy', dtmEmissaoEtiquetas.DataServidor);

    sbnGerarClick(nil);

  end
  else
  if pgcEtiquetas.ActivePage = tstMagalu then
  begin

    DBAdvGridMagalu.dataSource := dtmEmissaoEtiquetas.dsrEtiquetasMagalu;

    pgcEtiquetas.height := 425;

    ckbSelecionarTodasEtiquetasMagalu.checked := False;
    dtmEmissaoEtiquetas.EtiquetasMagaluMarcadas := 0;

    fraselecaoaleatorianotassaidas1.parent := tstMagalu;
    pnlGridMagalu.parent := tstMagalu;

    gbxIntervalorInclusaob2W.Parent := pnlParametrosMagalu;
    gbxIntervalorInclusaob2W.taborder := 0;

    ckbIncluirB2WJaImpressos.Parent := pnlParametrosMagalu;
    ckbIncluirB2WJaImpressos.taborder := 1;

//    ckbSomenteUmaPorPedido.parent := pnlParametrosMagalu;
//    ckbSomenteUmaPorPedido.taborder := 2;

    lblQtdadeEtiquetasporPedido.parent := pnlParametrosMagalu;
    edtQtdadeEtiquetasporPedido.parent := pnlParametrosMagalu;
    edtQtdadeEtiquetasporPedido.taborder := 2;



//    fraSelecaoAleatoriavendedores1.parent := pnlParametrosMagalu;

    pgcNotasProdutos.ActivePageIndex := 0;
    gbxEtiquetaemBranco.visible := false;
    stxNrEtiquetas.visible := false;

    edtDataInicialInclusaoB2W.text := FormatDateTime('dd/MM/yyyy', dtmEmissaoEtiquetas.DataServidor);
    edtDataFinalInclusaoB2W.text := FormatDateTime('dd/MM/yyyy', dtmEmissaoEtiquetas.DataServidor);

    sbnGerarClick(nil);

  end
  else
  if pgcEtiquetas.ActivePage = tstCorreios then
  begin
    DBAdvGridMagalu.dataSource := dtmEmissaoEtiquetas.dsrEtiquetasCorreios;
    pgcEtiquetas.height := 425;

    ckbSelecionarTodasEtiquetasMagalu.checked := False;
    dtmEmissaoEtiquetas.EtiquetasMagaluMarcadas := 0;

    fraselecaoaleatorianotassaidas1.parent := tstCorreios;
    pnlGridMagalu.parent := tstCorreios;

    gbxIntervalorInclusaob2W.Parent := pnlParametrosCorreios;
    gbxIntervalorInclusaob2W.taborder := 0;

    ckbIncluirB2WJaImpressos.Parent := pnlParametrosCorreios;
    ckbIncluirB2WJaImpressos.taborder := 1;

//    ckbSomenteUmaPorPedido.parent := pnlParametrosCorreios;
//    ckbSomenteUmaPorPedido.taborder := 2;

    lblQtdadeEtiquetasporPedido.parent := pnlParametrosCorreios;
    edtQtdadeEtiquetasporPedido.parent := pnlParametrosCorreios;
    edtQtdadeEtiquetasporPedido.taborder := 2;

//    fraSelecaoAleatoriavendedores1.parent := pnlParametrosCorreios;

    pgcNotasProdutos.ActivePageIndex := 0;
    gbxEtiquetaemBranco.visible := false;
    stxNrEtiquetas.visible := false;

    edtDataInicialInclusaoB2W.text := FormatDateTime('dd/MM/yyyy', dtmEmissaoEtiquetas.DataServidor);
    edtDataFinalInclusaoB2W.text := FormatDateTime('dd/MM/yyyy', dtmEmissaoEtiquetas.DataServidor);

    sbnGerarClick(nil)

  end
  else
     pgcNotasProdutos.ActivePageIndex := 0;





end;

procedure TfrmEmissaoEtiquetas.LerPercentualDesconto;
var
  ArquivoCFG: TIniFile;
begin
  if FileExists(NomeArquivoCFG) then
  begin
     ArquivoCFG := TIniFile.Create(NomeArquivoCFG);
    try
      if ArquivoCFG.SectionExists('Outros') then begin
        edtPercentualAVista.Text := ArquivoCFG.ReadString('Outros', 'percentualdescontoetiqueta', '');
      end;
    finally
      ArquivoCFG.Free;
    end;
  end;
end;
procedure TfrmEmissaoEtiquetas.SalvarPercentualDesconto;
var
  ArquivoCFG: TIniFile;
begin
  if FileExists(NomeArquivoCFG) then
  begin
    ArquivoCFG := TIniFile.Create(NomeArquivoCFG);
    try
        ArquivoCFG.WriteString('Outros', 'percentualdescontoetiqueta',edtPercentualAVista.Text);
    finally
      ArquivoCFG.UpdateFile;
      ArquivoCFG.Free;
    end;
  end;
end;

procedure TfrmEmissaoEtiquetas.pgcNotasProdutos2Change(Sender: TObject);
begin
  inherited;
  if pgcNotasProdutos2.ActivePage = tstProdutos then
  begin
    if dtmEmissaoEtiquetas.GerarEtiquetasProdutosNotas then
      dbgProdutosNotas.SetFocus;
  end;
end;

procedure TfrmEmissaoEtiquetas.AtribuirDadosPedidos;
begin
  if fraConsultaPedido.qryProcuraPedido.FieldByName('fornecedor').asstring <> '' then
  begin
    fraConsultaFornecedorPedido.edfcodigo.text := fraConsultaPedido.qryProcuraPedido.FieldByName('fornecedor').asstring;
    fraConsultaFornecedorPedido.edfcodigo.exist;
    dtmemissaoetiquetas.parametropedido := fraConsultaPedido.qryProcuraPedido.FieldByName('numero').text;
  end;  
end;

procedure TfrmEmissaoEtiquetas.CondicaoConsultaPedido;
var
 vSQLConsultaPedido: String;
begin

  vSQLConsultaPedido := '';
  if fraConsultaFornecedorPedido.edfcodigo.text <> '' then
    vSQLConsultaPedido := ' and f.codigo = ' + fraConsultaFornecedorPedido.edfcodigo.text;

  if fraConsultaItemProdutoPedido.edfcodigo.text <> '' then
    vSQLConsultaPedido := vSQLConsultaPedido + ' and exists (select pp.pedido from produtospedidos pp where pp.pedido = p.numero and pp.produto = ' +
                        fraConsultaItemProdutoPedido.edfcodigo.ValoraDataFieldInterno + ' limit 1)';

  if edtDataInicialPedido.text <> '' then
    vSQLConsultaPedido := vSQLConsultaPedido + ' and p.emissao >= '+ formatdatetime('yyyy-mm-dd', strtodate(edtDataInicialPedido.text));

  if edtDataFinalPedido.text <> '' then
    vSQLConsultaPedido := vSQLConsultaPedido + ' and p.emissao <= '+ formatdatetime('yyyy-mm-dd', strtodate(edtDataFinalPedido.text));

  case rgbSituacao.itemindex of
    0: vSQLConsultaPedido := vSQLConsultaPedido + ' and (p.situacao = ' + QuotedStr('A') + ')';  //Aberto
    1: vSQLConsultaPedido := vSQLConsultaPedido + ' and (p.situacao = ' + QuotedStr('P') + ')';  //Parcial
    2: vSQLConsultaPedido := vSQLConsultaPedido + ' and (p.situacao = ' + QuotedStr('Q') + ')';  //Parcial Liquidado
    3: vSQLConsultaPedido := vSQLConsultaPedido + ' and (p.situacao = ' + QuotedStr('L') + ')';  //Concluido
    4: vSQLConsultaPedido := vSQLConsultaPedido + ' and (p.situacao = ' + QuotedStr('C') + ')';  //Cancelado
    5: ; //Todos
  end;
{
  case rgbOrdenar.itemindex of
    0: vOrdenacaoPedido := 'Order By pd.numero';
    1: vOrdenacaoPedido := 'Order By UPPER(TO_ASCII(p.Descricao,''LATIN1'')), pd.emissao';
    2: vOrdenacaoPedido := 'Order By UPPER(TO_ASCII(f.nome,''LATIN1'')), pd.emissao';
    3: vOrdenacaoPedido := 'Order By pd.emissao';
    4: vOrdenacaoPedido := 'Order By UPPER(TO_ASCII(pd.situacao,''LATIN1''))';
  end;
}

  fraConsultaPedido.qryProcuraPedido.macrobyname('SQLConsultaPedido').asstring := vSQLConsultaPedido;
  fraConsultaPedido.qryConsultaPedido.macrobyname('SQLConsultaPedido').asstring := vSQLConsultaPedido;

end;

procedure TfrmEmissaoEtiquetas.btnAjustarClick(Sender: TObject);
begin
   with TextPrinter do begin
      BeginDoc('', False);
      WriteTextLn('^default',0);
      EndDoc('TecLUX - Imprimindo Etiqueta ZEBRA TLP 2844');
   end;
end;

procedure TfrmEmissaoEtiquetas.CondicoesdaConsultaItemProdutoPedido;
begin
  if fraConsultaPedido.edfcodigo.text <> '' then
    fraConsultaItemProdutoPedido.qryProcuraItemProdutos.macroByName('SQLFiltroPedidos').asString :=
      ' and p.codigo in (select pp.produto from produtospedidos pp where pp.pedido = ' +
                                            fraConsultaPedido.edfcodigo.text + ')'
  else
    fraConsultaItemProdutoPedido.qryProcuraItemProdutos.macroByName('SQLFiltroPedidos').asString := '';

  fraConsultaItemProdutoPedido.qryConsultaItemProdutos.macroByName('SQLFiltroPedidos').asString :=
    fraConsultaItemProdutoPedido.qryProcuraItemProdutos.macroByName('SQLFiltroPedidos').asString

end;

procedure TfrmEmissaoEtiquetas.ckbQtdemEstoqueProdutosExposicaoClick(
  Sender: TObject);
begin
  inherited;

  ckbQusntidadeLote.onClick := nil;

  if ckbQtdemEstoqueProdutosExposicao.Checked then
  begin
    gbxQuantidadeProdutosExposicao.Visible := False;
    ckbQtdeZeradaProdutosExposicao.Checked := False;

    ckbQusntidadeLote.Checked := False;
  end
  else
  begin
    gbxQuantidadeProdutosExposicao.Visible := True;
    ckbQtdeZeradaProdutosExposicao.Checked := true;
    ckbQusntidadeLote.Checked := False;
  end;

  ckbQusntidadeLote.onClick := ckbQusntidadeLoteClick;
end;

procedure TfrmEmissaoEtiquetas.ckbQtdeZeradaProdutosExposicaoClick(
  Sender: TObject);
begin
  inherited;
  dtmEmissaoEtiquetas.QtdeZerada := ckbQtdeZeradaProdutosExposicao.Checked;
  if ckbQtdeZeradaProdutosExposicao.Checked then
  begin
    ckbQtdemEstoqueProdutosExposicao.Checked:= false;
    gbxQuantidadeProdutosExposicao.Visible  := true;
  end
  else
  begin
    ckbQtdemEstoqueProdutosExposicao.Checked:= true;
    gbxQuantidadeProdutosExposicao.Visible := not ckbQtdemEstoqueProdutosExposicao.Checked;
  end;
end;

procedure TfrmEmissaoEtiquetas.ckbQusntidadeLoteClick(Sender: TObject);
begin
  inherited;
  ckbQtdemEstoqueProdutosExposicao.onClick := nil;

  if ckbQusntidadeLote.Checked then
  begin
    gbxQuantidadeProdutosExposicao.Visible := False;
    ckbQtdeZeradaProdutosExposicao.Checked := False;

    ckbQtdemEstoqueProdutosExposicao.Checked := False;

//    gbxNrLote.visible := true;
  end
  else
  begin
    gbxQuantidadeProdutosExposicao.Visible := True;
    ckbQtdeZeradaProdutosExposicao.Checked := true;
    ckbQtdemEstoqueProdutosExposicao.Checked := False;

//    gbxNrLote.visible := false;
  end;

  ckbQtdemEstoqueProdutosExposicao.onClick := ckbQtdemEstoqueProdutosExposicaoClick;
end;

