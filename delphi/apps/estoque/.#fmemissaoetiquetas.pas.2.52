procedure TfrmEmissaoEtiquetas.AcionaInclusaoProduto(Editando: Boolean);
begin
  if not assigned(frmCadastroProdutosEmitirEtiquetas) then
    frmCadastroProdutosEmitirEtiquetas:= TfrmCadastroProdutosEmitirEtiquetas.Create(self);

  with frmCadastroProdutosEmitirEtiquetas do begin
    SetDataModulo(dtmEmissaoEtiquetas);
    DataSet := dtmEmissaoEtiquetas.TabelaEtiqueta;
    dtmEmissaoEtiquetas.IncluirProdutoEtiqueta(Editando);
    ShowModal;
//  Free;
  end;
  dbgEmissaoEtiquetas.SetFocus;
end;

