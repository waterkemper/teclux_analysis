procedure TfrmEmissaoEtiquetas.FormActivate(Sender: TObject);
begin
  inherited;
       if ParSistema.TipoImpressoraEtiqueta = ctRABBIT    then lblTipoImpressora.Caption := 'R A B B I T'
  else if ParSistema.TipoImpressoraEtiqueta = ctZEBRA     then lblTipoImpressora.Caption := 'Z E B R A'
  else if ParSistema.TipoImpressoraEtiqueta = ctARGOX     then lblTipoImpressora.Caption := 'A R G O X'
  else if ParSistema.TipoImpressoraEtiqueta = ctMATRICIAL then lblTipoImpressora.Caption := 'M A T R I C I A L'
  else if ParSistema.TipoImpressoraEtiqueta = ctJATO      then lblTipoImpressora.Caption := 'J A T O   T I N T A';

  btnAjustar.Visible:= ParSistema.TipoImpressoraEtiqueta = ctZEBRA;
end;

procedure TfrmEmissaoEtiquetas.edtQuantidadeChange(Sender: TObject);
begin
  inherited;
  if pgcEtiquetas.ActivePageIndex = 0 then
  begin
     if not dtmEmissaoEtiquetas.qryEtiquetas.IsEmpty then
     begin
        if edtQuantidade.Text <> '' then
           dtmEmissaoEtiquetas.AtualizarQuantidadeEtiquetas(StrToInt(edtQuantidade.Text))
        else
           MensagemAviso(ctETIQUETASEMQUANTIDADE);
     end;
  end
  else
  if pgcEtiquetas.ActivePageIndex = 5 then
  begin
     if not dtmEmissaoEtiquetas.qryEtiquetas.IsEmpty then
     begin
        if edtQuantidadeProdutosExposicao.Text <> '' then
           dtmEmissaoEtiquetas.AtualizarQuantidadeEtiquetas(StrToInt(edtQuantidadeProdutosExposicao.Text))
        else
           MensagemAviso(ctETIQUETASEMQUANTIDADE);
     end;
  end;

end;


