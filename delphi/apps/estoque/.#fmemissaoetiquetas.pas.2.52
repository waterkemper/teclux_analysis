{$R *.dfm}

constructor TfrmEmissaoEtiquetas.Create(AOwner: TComponent);
begin
  dtmEmissaoEtiquetas := TdtmEmissaoEtiquetas.Create(Self);

  inherited;
//  try
//  dtmEmissaoEtiquetas.Abre(ctTabelas);

  dbgEmissaoEtiquetas.ColumnBYNAME('valorgrade1').Visible := ParSistema.UsarGradesProdutos;
  dbgEmissaoEtiquetas.Columnbyname('valorgrade2').Visible := ParSistema.UsarGradesProdutos;

  dtmEmissaoEtiquetas.OnScrollLinhaColunaGrade := AfterScrollLinhaColunaGrade;
  gbxEtiquetaemBranco.Visible:= (ParSistema.TipoImpressoraEtiqueta = ctJATO);
  stxNrEtiquetas     .Visible:= (ParSistema.TipoImpressoraEtiqueta = ctJATO);
  edtetiquetaBranco.Text := '0';
  pgcEtiquetas.ActivePageindex := 0;
  pgcProduto.ActivePageIndex:=0;
  gbxQuantidade.Visible:= false;
  pgcNotasProdutos.ActivePageIndex:=0;
  LerPercentualDesconto;

  fraConsultaPedido.TipoPesquisa := pesPEDIDOS;
  fraConsultaPedido.CondicoesdaConsulta := CondicaoConsultaPedido;
  fraConsultaPedido.OnFound := AtribuirDadosPedidos;

  fraConsultaItemProduto.TipoPesquisa := pesITEMPRODUTOS;
  fraConsultaProduto.TipoPesquisa     := pesPRODUTOS;
  fraConsultaItemProdutoPedido.TipoPesquisa := pesITEMPRODUTOS;
  fraConsultaItemProdutoPedido.CondicoesdaConsulta := CondicoesdaConsultaItemProdutoPedido;

  fraConsultaFilialProdutosExposicao.TipoPesquisa := pesFILIAIS;

  SalvarPropriedadesFormulario := true;
  CarregarConfiguracoesFormulario;

  stxNrEtiquetas.   Height:= 10;
  stxDataFabricacao.Height:= 10;
  stxDataValidade.  Height:= 10;
  stxMargemSuperior.Height:= 10;

  edtDataFabricacao.Text:= DateToStr(dtmEmissaoEtiquetas.DataServidor);
  edtDataValidade.  Text:= DateToStr(dtmEmissaoEtiquetas.DataServidor + 90);

//  fraConsultaFornecedorNota.qryProcuraCliente.ParamByName('NaoConsiderarTipoCliente').asBoolean := false;
//  fraConsultaFornecedorNota.qryProcuraCliente.ParamByName('codigo').asString := fraConsultaFornecedorNota.edfcodigo.text;
//  fraConsultaFornecedorNota.qryProcuraCliente.ParamByName('tipocliente').asString := 'F';
  fraConsultaFornecedorNota.TipoPesquisa := pesFORNECEDORES;
  fraConsultaFornecedorNota.TipoCliente := 'F';

//  fraConsultaFornecedorNOta.Tipovfornecedor := 'F';
  dtmEmissaoEtiquetas.qryProcuraFornecedoresNotas := fraConsultaFornecedorNota.qryProcuraCliente;

  fraConsultaFornecedorNota.qryProcuraCliente.AfterScroll := dtmEmissaoEtiquetas.qryProcuraFornecedoresNotasAfterScroll;

  fraConsultaFornecedorPedido.qryProcuraCliente.ParamByName('NaoConsiderarTipoCliente').asBoolean := false;
  fraConsultaFornecedorPedido.TipoPesquisa := pesFORNECEDORES;
  fraConsultaFornecedorPedido.TipoCliente := 'F';
  fraConsultaFornecedorPedido.Tipovfornecedor := 'F';

  fraConsultaFornecedorProduto.qryProcuraCliente.ParamByName('NaoConsiderarTipoCliente').asBoolean := false;
  fraConsultaFornecedorProduto.TipoPesquisa := pesFORNECEDORES;
  fraConsultaFornecedorProduto.TipoCliente := 'F';
  fraConsultaFornecedorProduto.Tipovfornecedor := 'F';

  SetarActivePage(self);


//  except
//     on E: Exception do ShowMessage(E.Message);
//  end;
end;

destructor TfrmEmissaoEtiquetas.Destroy;
begin
  if assigned(frmCadastroProdutosEmitirEtiquetas) then
    frmCadastroProdutosEmitirEtiquetas.free;
    
  dtmEmissaoEtiquetas:=nil;
  inherited;
  frmEmissaoEtiquetas := nil;
end;

procedure TfrmEmissaoEtiquetas.sbnProcuraSerieClick(Sender: TObject);
begin
  InternoPesquisar(edfSerie);
end;

procedure TfrmEmissaoEtiquetas.sbnProcuraNotaClick(Sender: TObject);
begin
  InternoPesquisar(edfNota);
end;

procedure TfrmEmissaoEtiquetas.sbnProcuraGrupoClick(Sender: TObject);
begin
  InternoPesquisar(edfGrupo);
end;

procedure TfrmEmissaoEtiquetas.sbnProcuraClasseClick(Sender: TObject);
begin
  InternoPesquisar(edfClasse);
end;

procedure TfrmEmissaoEtiquetas.sbnProcuraFilialClick(Sender: TObject);
begin
  InternoPesquisar(edfFilial);
end;

procedure TfrmEmissaoEtiquetas.sbnProcuraMarcaClick(Sender: TObject);
begin
  InternoPesquisar(edfMarca);
end;

procedure TfrmEmissaoEtiquetas.sbnGerarClick(Sender: TObject);
begin
  if pgcEtiquetas.ActivePageIndex = 3 then
  begin
    if (edtIntervaloInicialSaida.Text = '') or (edtIntervaloFinalSaida.Text = '') then
    begin
       MensagemAviso('Falta digitar a(s) data(s)');
       Exit;
    end;
  end;

  if edfModeloEtiqueta.Text = '' then begin
       MensagemAviso('Selecione um modelo de etiqueta!');
       edfModeloEtiqueta.SetFocus;
       Exit;
  end;

  if pgcEtiquetas.ActivePageIndex = 5 then
  begin
    if ckbQusntidadeLote.checked and (edtNrLote.text='') then
    begin
      MensagemAviso('Indique o número do lote de transferência!');
      edtNrLote.setfocus;
      edtNrLote.selectall;
      exit;
    end;
  end;

  if (pgcEtiquetas.ActivePageIndex in [6,7,8]) then
  begin
    if (edtDataInicialInclusaoB2W.Text = '') or (edtDataFinalInclusaoB2W.Text = '') then
    begin
       MensagemAviso('Falta digitar a(s) data(s)');
       edtDataInicialInclusaoB2W.SetFocus;
       Exit;
    end;
  end;


  if VerificaCamposConsulta then begin
    with dtmEmissaoEtiquetas do begin
      case pgcEtiquetas.ActivePageIndex of
        0: begin
             pgcProdutoChange(nil);
             ParametroFornecedorProdutos := fraConsultaFornecedorProduto.edfCodigo.Text;
             ParametroProduto := fraConsultaItemProduto.edfCodigo.ValoraDataFieldInterno;
             ParametroGrupo   := edfGrupo.Text;
             ParametroClasse  := edfClasse.Text;
             ParametroCaracteristicas := fraConsultaProduto.edfcodigo.ValoraDataFieldInterno;
             ParametroFilial  := edfFilial.Text;
             ParametroMarca   := edfMarca.Text;
             ProdutoEmLinha     := ckbProdutoEmLinha_1.checked;
             ProdutoForadeLinha := ckbProdutoForadeLinha_1.checked;
             ProdutoAtivo       := ckbProdutoAtivo_1.checked;
             ProdutoInativo     := ckbProdutoInativo_1.checked;

             GerarEtiquetasProduto;
           end;
        1: begin
             ParametroFornecedorNotas := fraConsultaFornecedorNota.edfcodigo.Text;
             ParametroSerie := edfSerie.Text;
             ParametroNota := edfNota.Text;

             ProdutoEmLinha     := ckbProdutoEmLinha_2.checked;
             ProdutoForadeLinha := ckbProdutoForadeLinha_2.checked;
             ProdutoAtivo       := ckbProdutoAtivo_2.checked;
             ProdutoInativo     := ckbProdutoInativo_2.checked;

             qryetiquetas.Sql.clear;
             qryEtiquetas.Sql.Text := qryEtiquetasNotas.Sql.Text;
             if rdbDescricaoProduto.Checked then
                qryEtiquetas.Sql.Text := qryEtiquetas.Sql.Text +
                                         'Order BY UPPER(TO_ASCII(p.Descricao,''LATIN1'')),pn.numero,p.codigo,p.valorgrade1,p.valorgrade1,UPPER(TO_ASCII(m.Descricao,''LATIN1'')),c.volumes,pn.quantidade,pn.filial'
             else
                qryEtiquetas.Sql.Text := qryEtiquetas.Sql.Text +
                                         'Order BY pn.numero,p.codigo,UPPER(TO_ASCII(p.Descricao,''LATIN1'')),p.valorgrade1,p.valorgrade1,UPPER(TO_ASCII(m.Descricao,''LATIN1'')),c.volumes,pn.quantidade,pn.filial';
             GerarEtiquetasNota;
           end;
        2: begin
             ParametroFilialMovto := edfFilialMovto.Text;
             ParametroTipoMovto   := edfTipoMovimento.Text;
             ParametroDataInicial := edtIntervaloInicial.Text;
             ParametroDataFinal   := edtIntervaloFinal.Text;

             ProdutoEmLinha     := ckbProdutoEmLinha_3.checked;
             ProdutoForadeLinha := ckbProdutoForadeLinha_3.checked;
             ProdutoAtivo       := ckbProdutoAtivo_3.checked;
             ProdutoInativo     := ckbProdutoInativo_3.checked;

             GerarEtiquetasMovimento;
           end;
        3: begin
             ParametroCliente         := edfClientesSaida.Text;
             ParametroDataInicialSaida:= edtIntervaloInicialSaida.Text;
             ParametroDataFinalSaida  := edtIntervaloFinalSaida.Text;
             ParametroNotaInicialSaida:= edtNotaInicialSaida.Text;
             ParametroNotaFinalSaida  := edtNotaFinalSaida.Text;
//           ParametroTipoMovto       := edfTipoMovimentoSaida.Text;

             ProdutoEmLinha     := ckbProdutoEmLinha_4.checked;
             ProdutoForadeLinha := ckbProdutoForadeLinha_4.checked;
             ProdutoAtivo       := ckbProdutoAtivo_4.checked;
             ProdutoInativo     := ckbProdutoInativo_4.checked;

             GerarEtiquetasNotasSaida;

             pgcNotasProdutos2.ActivePageIndex := 0;
             if qryNotasSaidas.IsEmpty then
                MensagemAviso(ctSEMETIQUETASPARAIMPRIMIR)
             else
                dbgNotasSaidas.SetFocus;

             Exit;
           end;
        4: begin
            pgcNotasProdutos.ActivePageIndex := 0;
            ParametroPedido := fraConsultaPedido.edfcodigo.text;
            ParametroFornecedorPedido := fraConsultaFornecedorPedido.edfcodigo.text;
            ParametroProdutoPedido := fraConsultaItemProdutoPedido.edfcodigo.ValoraDataFieldInterno;
            ParametroDataInicialPedido := edtDataInicialPedido.text;
            ParametroDataFinalPedido := edtDataFinalPedido.text;
            ParametroSituacaoPedido := rgbSituacao.ItemIndex;
            ParametroOrdenacaoPedido := rgbOrdenar.ItemIndex;

            ProdutoEmLinha     := ckbProdutoEmLinha_5.checked;
            ProdutoForadeLinha := ckbProdutoForadeLinha_5.checked;
            ProdutoAtivo       := ckbProdutoAtivo_5.checked;
            ProdutoInativo     := ckbProdutoInativo_5.checked;

            GerarEtiquetasPedidos;

           end;

        5: begin
             ParametroFilial  := fraConsultaFilialProdutosExposicao.qryProcuraFiliais.FieldByName('codigo').AsString;
             ParametroProduto :=  fraMultiplaSelecaoAleatoriaProdutosExposicao.fraSelecaoAleatoriaItemdeProdutos.ListaCondicional;
             ParametroCaracteristicas := fraMultiplaSelecaoAleatoriaProdutosExposicao.fraSelecaoAleatoriaprodutos.ListaCondicional;
             ParametroGrupo   := fraMultiplaSelecaoAleatoriaProdutosExposicao.fraSelecaoaleatoriagruposprodutos.ListaCondicional;
             ParametroClasse  := fraMultiplaSelecaoAleatoriaProdutosExposicao.fraSelecaoaleatoriaclassesprodutos.ListaCondicional;
             ParametroMarca   := fraMultiplaSelecaoAleatoriaProdutosExposicao.fraSelecaoAleatoriamarcasProdutos.ListaCondicional;
             ListaCondicionalPromocoes := fraMultiplaSelecaoAleatoriaProdutosExposicao.fraSelecaoaleatoriapromocoes.ListaCondicional;

             ParametroListasPadrao :=  fraSelecaoaleatorialistaspadronizadas1.ListaCondicional;

             ParametroDataInicial := edtIntervaloInicialAlteracaoProdutosExposicao.Text;
             ParametroDataFinal   := edtIntervaloFinalAlteracaoProdutosExposicao.Text;

             QuantidadeLote := ckbQusntidadeLote.checked;
             lotetransferencia := edtNrLote.ValorSemFormatacao;
             QtdemEstoqueProdutosExposicao := ckbQtdemEstoqueProdutosExposicao.checked;
             QtdeZerada := ckbQtdeZeradaProdutosExposicao.checked;

             ProdutoEmLinha     := ckbProdutoEmLinha_6.checked;
             ProdutoForadeLinha := ckbProdutoForadeLinha_6.checked;
             ProdutoAtivo       := ckbProdutoAtivo_6.checked;
             ProdutoInativo     := ckbProdutoInativo_6.checked;

             produtoEmExposicao := ckbEmExposicao.checked;
             produtoForaExposicao := ckbForaExposicao.checked;

             ProdutosEmPromocao := ckbEmPromocao.Checked;
             ProdutosForaPromocao := ckbForaPromocao.Checked;

             GerarEtiquetasProdutosExposicao;
           end;

        6: begin
             dbgplp_b2w.filter.Clear;
             dbgplp_b2w.FilterActive := False;
             dbgplp_b2w.DataSource.DataSet.close;

//             dbgplp_b2w.DataSource.DataSet.first;
             ParametroDataInicialInclusaoB2W := edtDataInicialInclusaoB2W.Text;
             ParametroDataFinalInclusaoB2W   := edtDataFinalInclusaoB2W.Text;
             ParametroIncluirB2wJaImpressos :=  ckbIncluirB2WJaImpressos.checked;
//             ParametroSomenteUmaPorPedido := ckbSomenteUmaPorPedido.checked;
             GerarEtiquetasProdutosB2W;

//             dbgplp_b2w.reload;

             dbgplp_b2w.DataSource.DataSet.Next;
             dbgplp_b2w.DataSource.DataSet.Prior;
             dbgplp_b2w.FilterActive := True;

           end;

        7: begin

             EtiquetasMagaluMarcadas := 0;

             DBAdvGridMagalu.filter.Clear;
             DBAdvGridMagalu.FilterActive := False;
             DBAdvGridMagalu.DataSource.DataSet.close;

//             dbgplp_b2w.DataSource.DataSet.first;
             ParametroDataInicialInclusaoB2W := edtDataInicialInclusaoB2W.Text;
             ParametroDataFinalInclusaoB2W   := edtDataFinalInclusaoB2W.Text;
             ParametroIncluirB2wJaImpressos :=  ckbIncluirB2WJaImpressos.checked;
//             ParametroSomenteUmaPorPedido := ckbSomenteUmaPorPedido.checked;
             ParametroListaVendedores := fraSelecaoAleatoriavendedores1.ListaCondicional;
             ParametroListaDadosFiscais := fraselecaoaleatorianotassaidas1.ListaCondicional;
             GerarEtiquetasProdutosMagalu;

//             dbgplp_b2w.reload;

             DBAdvGridMagalu.DataSource.DataSet.Next;
             DBAdvGridMagalu.DataSource.DataSet.Prior;
             DBAdvGridMagalu.FilterActive := True;

             DBAdvGridMagalu.AutoNumberCol(0);
             DBAdvGridMagalu.AutoNumberCol(0);
             DBAdvGridMagalu.refresh;
             

           end;

        8: begin

             EtiquetasMagaluMarcadas := 0;

             DBAdvGridMagalu.filter.Clear;
             DBAdvGridMagalu.FilterActive := False;
             DBAdvGridMagalu.DataSource.DataSet.close;

//             dbgplp_b2w.DataSource.DataSet.first;
             ParametroDataInicialInclusaoB2W := edtDataInicialInclusaoB2W.Text;
             ParametroDataFinalInclusaoB2W   := edtDataFinalInclusaoB2W.Text;
             ParametroIncluirB2wJaImpressos :=  ckbIncluirB2WJaImpressos.checked;
             
             ParametroListaVendedores := fraSelecaoAleatoriavendedores2.ListaCondicional;
             ParametroListaDadosFiscais := fraselecaoaleatorianotassaidas1.ListaCondicional;
             GerarEtiquetasProdutosCorreios;

//             dbgplp_b2w.reload;

             DBAdvGridMagalu.DataSource.DataSet.Next;
             DBAdvGridMagalu.DataSource.DataSet.Prior;
             DBAdvGridMagalu.FilterActive := True;

             DBAdvGridMagalu.AutoNumberCol(0);
             DBAdvGridMagalu.AutoNumberCol(0);
             DBAdvGridMagalu.refresh;


           end;


      end;

      if not (pgcEtiquetas.ActivePageIndex in [6,7,8]) then
      begin
        if qryetiquetas.IsEmpty then
           MensagemAviso(ctSEMETIQUETASPARAIMPRIMIR)
        else
           if pgcEtiquetas.ActivePageIndex = 0 then begin
              if not ckbQtdemEstoque.Checked then
                 if edtQuantidade.Text <> '' then
                    AtualizarQuantidadeEtiquetas(StrToInt(edtQuantidade.Text))
                 else
                    MensagemAviso(ctETIQUETASEMQUANTIDADE);
           end
           else
           if pgcEtiquetas.ActivePageIndex = 5 then
           begin
              if not ckbQtdemEstoqueProdutosExposicao.Checked and
                 not ckbQusntidadeLote.checked then
              begin
                if edtQuantidadeProdutosExposicao.Text <> '' then
                  AtualizarQuantidadeEtiquetas(StrToInt(edtQuantidadeProdutosExposicao.Text))
                else
                  MensagemAviso(ctETIQUETASEMQUANTIDADE);
              end;
           end;

           if (pgcNotasProdutos.ActivePageIndex=0) then
             dbgEmissaoEtiquetas.SetFocus
           else
             dbgNotasSaidas.SetFocus;
        end;
      end;
  end else
    if pgcEtiquetas.ActivePageindex = 3 then
       edtIntervaloInicialSaida.SetFocus;
end;

procedure TfrmEmissaoEtiquetas.pgcProdutoChange(Sender: TObject);
begin
  with dtmEmissaoEtiquetas do
  begin
    if pgcProduto.ActivePage = tstProduto then
    begin
      fraConsultaItemProduto.edfcodigo.SetFocus;
      fraConsultaProduto.edfcodigo.Clear;
      edfGrupo.Clear;
      edfClasse.Clear;
      fraConsultaFornecedorProduto.edfCodigo.clear;
      edfMarca.clear;
    end
    else
      if pgcProduto.ActivePage = tstcaracteristicas then
      begin
        fraConsultaItemProduto.edfcodigo.clear;
        fraConsultaProduto.edfcodigo.SetFocus;
        edfGrupo.Clear;
        edfClasse.Clear;
        fraConsultaFornecedorProduto.edfCodigo.clear;
        edfMarca.clear;
      end
      else
        if pgcProduto.ActivePage = tstGrupo then
        begin
          fraConsultaItemProduto.edfcodigo.clear;
          fraConsultaProduto.edfcodigo.clear;
          edfGrupo.SetFocus;
          edfClasse.Clear;
          fraConsultaFornecedorProduto.edfCodigo.clear;
          edfMarca.clear;
        end
        else
          if pgcProduto.ActivePage = tstClasse then
          begin
            fraConsultaItemProduto.edfcodigo.clear;
            fraConsultaProduto.edfcodigo.clear;
            edfGrupo.clear;
            edfClasse.setfocus;
            fraConsultaFornecedorProduto.edfCodigo.clear;
            edfMarca.clear;
          end
          else
            if pgcProduto.ActivePage = tstFornecedor then
            begin
              fraConsultaItemProduto.edfcodigo.clear;
              fraConsultaProduto.edfcodigo.clear;
              edfGrupo.clear;
              edfClasse.clear;
              fraConsultaFornecedorProduto.edfCodigo.setfocus;
              edfMarca.clear;
            end
            else
              if pgcProduto.ActivePage = tstMarca then
              begin
                fraConsultaItemProduto.edfcodigo.clear;
                fraConsultaProduto.edfcodigo.clear;
                edfGrupo.clear;
                edfClasse.clear;
                fraConsultaFornecedorProduto.edfCodigo.clear;
                edfMarca.setfocus;
              end;
  end;
end;


procedure TfrmEmissaoEtiquetas.actImprimirExecute(Sender: TObject);
var
 Imp: String;
 Res: Boolean;
 vplp : String;
 i :integer;
begin
//  dtmemissaoetiquetas.ParametroSomenteUmaPorPedido := ckbSomenteUmaPorPedido.checked;

  dtmemissaoetiquetas.TipoImpressaoEtiquetas := tpeOutros;
  dtmemissaoetiquetas.fMargemSuperior := EDTMargemSuperior.valorsemformatacao;
  dtmemissaoetiquetas.fMargemEsquerda := EDTMargemEsquerda.valorsemformatacao;

  dtmEmissaoEtiquetas.ImprimirFoto := false;

  RemoverControles;
  if (ParSistema.TipoImpressoraEtiqueta <> ctZEBRA) and
     (ParSistema.TipoImpressoraEtiqueta <> ctRABBIT) and
     (ParSistema.TipoImpressoraEtiqueta <> ctARGOX) then
     TtecEditionControlItem(ecvEmissaoEtiquetas.EditionControl.Add).Control:= edfModeloEtiqueta;
  Res:= True; // ecvEmissaoEtiquetas.Verify(gbxEtiquetaProduto, ControleValido);

 if Res then
     Res := OperadorTernario(Trim(edfModeloEtiqueta.Text)  <> '', edfModeloEtiqueta.Exist, True);

  If Res then
  begin
     FRelatorioAberto:=True;
     sbnImprimir.Enabled:=false;
     sbnGerar.Enabled:=false;

    with dtmEmissaoEtiquetas do
    begin
      ImprimirPreco    := ckbImprimirPreco.Checked;
      PercentualAvista := edtPercentualAVista.ValorSemFormatacao;
      case pgcEtiquetas.ActivePageIndex of
        0: begin
            ImprimirQtadeemEstoqueouNota := ckbQtdemEstoque.Checked;
            QtadeaImprimir := edtQuantidade.ValorSemFormatacao;
           end;
    1,2,3: ImprimirQtadeemEstoqueouNota := True;

        5: begin

            ImprimirFoto := ckbImprimirFotoProduto.checked;
            ImprimirQtadeemEstoqueouNota := ckbQtdemEstoque.Checked;
            QtadeaImprimir := edtQuantidade.ValorSemFormatacao;
            dtmEmissaoEtiquetas.ProdutosEmPromocao := false;

            SalvarConfiguracoesFormulario('PRODUTOS EM EXPOSIÇÃO');

           end;

      end;

      if ParSistema.TipoImpressoraEtiqueta = ctRABBIT then
           ImpressaoRABBIT(rgpTipoEtiqueta.ItemIndex)
      else
      if ParSistema.TipoImpressoraEtiqueta = ctZEBRA then
           ImpressaoZebraTLP2844(rgpTipoEtiqueta.ItemIndex,pgcEtiquetas.ActivePageIndex)
      else
      if ParSistema.TipoImpressoraEtiqueta = ctARGOX then
           ImpressaoARGOX(rgpTipoEtiqueta.ItemIndex)
      else
      if ParSistema.TipoImpressoraEtiqueta = ctMATRICIAL then begin
         Imp := ParSistema.NomeImpressoraEtiqueta;
         ImprimirEtiquetas(ckbModificar.Checked, edtArquivo.Text, Imp);
      end else
      if ParSistema.TipoImpressoraEtiqueta = ctJATO then
      begin
         Imp := ParSistema.NomeImpressoraEtiqueta;

         if pgcEtiquetas.ActivePageIndex = 6 then
         begin
          if dbgplp_b2w.RowCount > 0 then
          begin
            dtmemissaoetiquetas.TipoImpressaoEtiquetas := tpeB2W;
            dtmemissaoetiquetas.Tipo_ := 'Fast4';
            vplp := dbgplp_b2w.Cells[2, dbgplp_b2w.row];
            if vplp <> '' then
              dtmEmissaoEtiquetas.qryplpb2w.locate('plp', strtoint(vplp), []);

             ImprimirEtiquetasProdutosB2W;

            dtmEmissaoEtiquetas.qryplpb2w.AfterScroll := nil;
            dbgplp_b2w.Reload;
            dtmEmissaoEtiquetas.qryplpb2w.AfterScroll := qryplpb2wAfterScroll;
          end;

         end
         else
         if pgcEtiquetas.ActivePageIndex = 7 then
         begin

          {
          if dbgplp_b2w.rowcount > 0 then
          begin
            vplp := dbgplp_b2w.Cells[2, dbgplp_b2w.row];
            if vplp <> '' then
              dtmEmissaoEtiquetas.qryEtiquetasMagalu.locate('codigo_pedido_marketplace', strtoint(vplp), []);
          }
            dtmemissaoetiquetas.TipoImpressaoEtiquetas := tpeMagalu;
            dtmemissaoetiquetas.Tipo_ := 'Fast4';

            ImprimirEtiquetasProdutosMagalu;

            dtmEmissaoEtiquetas.qryEtiquetasMagalu.AfterScroll := nil;
            DBAdvGridMagalu.Reload;
            dtmEmissaoEtiquetas.qryEtiquetasMagalu.AfterScroll := qryEtiquetasMagaluAfterScroll;
//          end;

         end
         else
         if pgcEtiquetas.ActivePageIndex = 8 then
         begin
            QtadeaImprimir := edtQtdadeEtiquetasporPedido.ValorSemFormatacao;
            dtmemissaoetiquetas.TipoImpressaoEtiquetas := tpeCorreios;
            dtmemissaoetiquetas.Tipo_ := 'Fast4';
            ImprimirEtiquetasProdutosCorreios;
            dtmEmissaoEtiquetas.qryEtiquetasCorreios.afterScroll := nil;
            DBAdvGridMagalu.Reload;
            dtmEmissaoEtiquetas.qryEtiquetasCorreios.AfterScroll := qryEtiquetasCorreiosAfterScroll;
         end
         else
           ImprimirEtiquetasJato(ckbModificar.Checked, strtoint(edtetiquetaBranco.ValorSemFormatacao), edtArquivo.Text, Imp);
      end
      else
      begin
        frmSelecionarImpressoras := TfrmSelecionarImpressoras.Create(frmSelecionarImpressoras, ' ');
        try
          if frmSelecionarImpressoras.ShowModal = mrok then begin
            Imp := frmSelecionarImpressoras.NomeImpressora;
            ImprimirEtiquetas(ckbModificar.Checked, edtArquivo.Text, Imp);
          end else
            MensagemAviso(ctSELECIONARIMPRESSORA)
        finally
          frmSelecionarImpressoras.Free;
        end
      end
    end;
    sbnGerar.Enabled:=True;
    sbnImprimir.Enabled:=True;
    FRelatorioAberto:=False;
    SalvarPercentualDesconto;
  end;
end;

procedure TfrmEmissaoEtiquetas.actImprimirUpdate(Sender: TObject);
begin
  with dtmEmissaoEtiquetas do

   if not FRelatorioAberto then

      if pgcEtiquetas.ActivePage = tstNotaFiscalSaidas then
         sbnImprimir.Enabled := not qryNotasSaidas.IsEmpty
      else
      if pgcEtiquetas.ActivePage = tstb2w_ then
        sbnImprimir.Enabled := not qryplpb2w_items.IsEmpty
      else
      if pgcEtiquetas.ActivePage = tstMagalu then
        sbnImprimir.Enabled := (EtiquetasMagaluMarcadas <> 0)
      else
      if pgcEtiquetas.ActivePage = tstCorreios then
        sbnImprimir.Enabled := (EtiquetasMagaluMarcadas <> 0)
      else
        sbnImprimir.Enabled := not qryEtiquetas.IsEmpty;
end;

function TfrmEmissaoEtiquetas.JanelaPesquisa;
begin
  Result := TfrmConsultaPorCampo.Create(nil);
  if (TipoPesquisa in [pesCLIENTES]) then
     TfrmConsultaPorCampo(Result).ConsultaInterativa:= False
  else
     TfrmConsultaPorCampo(Result).ConsultaInterativa:= True;

  TfrmConsultaPorCampo(Result).UsarParametrosDaTabela:=False;
end;

function TfrmEmissaoEtiquetas.InternoPesquisar(Titulo: String): Integer;
begin
  Result := mrNone;
  with dtmEmissaoEtiquetas do
    if PesquisaHabilitada then begin
      AbreTabelaPesquisa(TipoPesquisa);
      Result := inherited InternoPesquisar(TituloPesquisa);
      if Result = mrOK then
        Selecionar(TipoPesquisa,False);
      FechaTabelaPesquisa(TipoPesquisa);
    end;
end;

function TfrmEmissaoEtiquetas.ExisteInformacao(Parametro: Integer;NomeCampo: String; Value: Variant): Boolean;
begin
  with dtmEmissaoEtiquetas do
    case TipoPesquisa of
            pesSERIES           : Result:= ExisteSerie(NomeCampo, Value);
            pesNOTAS            : Result:= ExisteNota(NomeCampo, Value);
            pesGRUPOS           : Result:= ExisteGrupo(NomeCampo, Value);
            pesCLASSES          : Result:= ExisteClasse(NomeCampo, Value);
            pesFILIAIS          : Result:= ExisteFilial(NomeCampo, Value);
            pesMARCAS           : Result:= ExisteMarca(NomeCampo, Value);
     pesTIPOSMOVIMENTOS         : Result:= ExisteTipoMovto(NomeCampo, Value);
     pesMODELOETIQUETA          : Result:= ExisteModelosEtiquetas(NomeCampo, Value);
              pesPLANO          : Result:= ExistePlano(NomeCampo, Value);
           pesCLIENTES          : Result:= ExisteCliente(NomeCampo, Value);

    else
      Result := False;
    end;
end;

function TfrmEmissaoEtiquetas.TabelaDePesquisa: TZDataSet;
begin
  with dtmEmissaoEtiquetas do
    case TipoPesquisa of
              pesSERIES          : Result:= ConsultarSerie;
              pesNOTAS           : Result:= ConsultarNota;
              pesGRUPOS          : Result:= ConsultarGrupo;
              pesCLASSES         : Result:= ConsultarClasse;
              pesFILIAIS         : Result:= ConsultarFilial;
              pesMARCAS          : Result:= ConsultarMarca;
       pesTIPOSMOVIMENTOS        : Result:= ConsultarTipoMovto;
       pesMODELOETIQUETA         : Result:= ConsultaModeloEtiqueta;
                pesPlano         : Result:= ConsultarPlano;
              pesClientes        : Result:= ConsultarClientes;
    else
      Result := nil;
    end;
end;

procedure TfrmEmissaoEtiquetas.KeyDown(var Key: Word; Shift: TShiftState);
begin
  inherited;
  case Key of
    VK_Escape : begin
                   dtmEmissaoEtiquetas.FecharTabelaEtiqueta;
                   case pgcEtiquetas.ActivePageIndex of
                     0: edfFilial.SetFocus;
                     1: fraConsultaFornecedorNota.edfcodigo.SetFocus;
                     2: edfFilialMovto.SetFocus;
                     3: edfClientesSaida.SetFocus;
                   end;
                 end;
        VK_F6 : if sbnGerar.enabled then sbnGerar.Click;
        VK_F7 : if sbnimprimir.Enabled then sbnimprimir.Click;
  end;
end;

function TfrmEmissaoEtiquetas.PesquisaHabilitada: Boolean;
begin
  Result:= False;
  if CtrlOn then begin
    if ActiveControl is TtecDBEditFind then begin
      if edfSerie.Focused then
        TipoPesquisa := pesSERIES
      else
      if edfNota.Focused then
        TipoPesquisa := pesNOTAS
      else
      if edfGrupo.Focused then
        TipoPesquisa := pesGRUPOS
      else
      if edfClasse.Focused then
        TipoPesquisa := pesCLASSES
      else
      if (edfFilial.Focused or edfFilialMovto.Focused) then
        TipoPesquisa := pesFILIAIS
      else if edfModeloEtiqueta.Focused then
        TipoPesquisa := pesMODELOETIQUETA
      else if edfTipoMovimento.Focused then
        TipoPesquisa := pesTIPOSMOVIMENTOS
      else if edfPlano.Focused then
        TipoPesquisa := pesPlano
      else
      if edfClientesSaida.Focused then
        TipoPesquisa := pesClientes
      else
        TipoPesquisa := pesMARCAS;

      Result := True;
    end
  end;
end;

function TfrmEmissaoEtiquetas.TituloPesquisa: String;
begin
  case TipoPesquisa of
              pesSERIES                 : Result := 'Séries';
              pesNOTAS                  : Result := 'Notas';
              pesGRUPOS                 : Result := 'Grupos';
              pesCLASSES                : Result := 'Classes';
              pesFILIAIS                : Result := 'Filiais';
              pesMARCAS                 : Result := 'Marcas';
       pesTIPOSMOVIMENTOS               : Result := 'Tipos Movimentos';
        pesMODELOETIQUETA               : Result := 'Modelos Etiquetas';
                 pesPlano               : Result := 'Tipo Plano';
              pesCLIENTES               : Result := 'Clientes';
  end;
end;

procedure TfrmEmissaoEtiquetas.RemoverControles;
Var
  A: Integer;
begin
  for A:= ecvEmissaoEtiquetas.EditionControl.Count-1 DownTo 0 do
      ecvEmissaoEtiquetas.EditionControl.Delete(A);
end;

function TfrmEmissaoEtiquetas.VerificaCamposConsulta: Boolean;
begin
  Result := False;
  RemoverControles;
  case pgcEtiquetas.ActivePageIndex of
    0: //tstEtiquetaProduto
    begin
      TtecEditionControlItem(ecvEmissaoEtiquetas.EditionControl.Add).Control:= edfFilial;
      if not ckbQtdemEstoque.Checked then
        TtecEditionControlItem(ecvEmissaoEtiquetas.EditionControl.Add).Control:= edtQuantidade;
      Result:= ecvEmissaoEtiquetas.Verify(pnlFundoJanela, ControleValido);
    end;

    1: //tstEtiquetaNota
    begin
      TtecEditionControlItem(ecvEmissaoEtiquetas.EditionControl.Add).Control:= fraConsultaFornecedorNota.edfcodigo;
      TtecEditionControlItem(ecvEmissaoEtiquetas.EditionControl.Add).Control:= edfSerie;
      TtecEditionControlItem(ecvEmissaoEtiquetas.EditionControl.Add).Control:= edfNota;
      Result:= ecvEmissaoEtiquetas.Verify(pnlFundoJanela, ControleValido);
    end;

    2: //tstMovimentacao
    begin
      TtecEditionControlItem(ecvEmissaoEtiquetas.EditionControl.Add).Control:= edfTipoMovimento;
      TtecEditionControlItem(ecvEmissaoEtiquetas.EditionControl.Add).Control:= edtIntervaloInicial;
      TtecEditionControlItem(ecvEmissaoEtiquetas.EditionControl.Add).Control:= edtIntervaloFinal;
  //    if not ParSistema.ImpressaoRabbitEtiqueta then
  //      TtecEditionControlItem(ecvEmissaoEtiquetas.EditionControl.Add).Control:= edfModeloEtiqueta;
      Result:= ecvEmissaoEtiquetas.Verify(pnlFundoJanela, ControleValido);
    end;


    3: //tstNotaFiscalSaidas
    begin
      Result := True;
    end;

    4: //tstPedidos
    begin
      Result := True;
      if not ((fraConsultaPedido.edfCodigo.Text <> '') or
              ((fraConsultaFornecedorPedido.edfcodigo.text <> '') and
               (edtDataInicialPedido.Text <> '') and
               (edtDataFinalPedido.Text <> ''))) then
      begin
        if not (fraConsultaFornecedorPedido.edfcodigo.text <> '') then
          TtecEditionControlItem(ecvEmissaoEtiquetas.EditionControl.Add).Control:= fraConsultaPedido.edfcodigo;

        TtecEditionControlItem(ecvEmissaoEtiquetas.EditionControl.Add).Control:= fraConsultaFornecedorPedido.edfcodigo;
        TtecEditionControlItem(ecvEmissaoEtiquetas.EditionControl.Add).Control:= edtDataInicialPedido;
        TtecEditionControlItem(ecvEmissaoEtiquetas.EditionControl.Add).Control:= edtDataFinalPedido;
        Result:= ecvEmissaoEtiquetas.Verify(pnlFundoJanela, ControleValido);
      end;
    end;

    5: //produtos em exposicao
    begin
      TtecEditionControlItem(ecvEmissaoEtiquetas.EditionControl.Add).Control:= fraConsultaFilialProdutosExposicao.edfCodigo;
      if not ckbQtdemEstoqueProdutosExposicao.Checked then
        TtecEditionControlItem(ecvEmissaoEtiquetas.EditionControl.Add).Control:= edtQuantidadeProdutosExposicao;
      Result:= ecvEmissaoEtiquetas.Verify(pnlFundoJanela, ControleValido);
    end;

    6,7,8: //b2w
    begin
      Result := True;
    end;

  end;

//OperadorTernario(Trim(edfModeloEtiqueta.Text)  <> '', edfModeloEtiqueta.Exist, True) and

  if Result then
    case pgcEtiquetas.ActivePageIndex of
      0: Result := OperadorTernario(Trim(edfFilial.Text)  <> '', edfFilial.Exist, False) and
                   OperadorTernario(Trim(fraConsultaItemProduto.edfcodigo.Text) <> '', fraConsultaItemProduto.edfcodigo.Exist,True)  and
                   OperadorTernario(Trim(edfGrupo.Text)   <> '', edfGrupo.Exist,  True)  and
                   OperadorTernario(Trim(edfClasse.Text)  <> '', edfClasse.Exist, True)  and
                   OperadorTernario(Trim(fraConsultaFornecedorProduto.edfCodigo.Text) <> '', fraConsultaFornecedorProduto.edfCodigo.Exist, True) and
                   OperadorTernario(Trim(edfMarca.Text)   <> '', edfMarca.Exist,  True);

      1: Result := fraConsultaFornecedorNota.edfcodigo.Exist and edfSerie.Exist and edfNota.Exist;

      2: Result := OperadorTernario(Trim(edfFilialMovto.Text)  <> '', edfFilial.Exist,True)  and
                   OperadorTernario(Trim(edfTipoMovimento.Text)<> '', edfTipoMovimento.Exist, False);

 //   3: Result := edfClientesSaida.Exist; and OperadorTernario(Trim(edfTipoMovimentoSaida.Text)  <> '', edfTipoMovimentoSaida.Exist, False);

      5: Result := OperadorTernario(Trim(fraConsultaFilialProdutosExposicao.edfCodigo.Text)  <> '', fraConsultaFilialProdutosExposicao.edfCodigo.Exist, False); 

    end;

end;

