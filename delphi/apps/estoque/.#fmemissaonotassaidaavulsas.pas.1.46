procedure TfrmEmissaoNotasSaidaAvulsas.ProximoControle(Ind: Integer);
begin
  inherited;
  if TipoConsulta = cnsCONTRATO then
    if Ind = 0 then begin
      Jan.ConsultaInterativa := True;
      dtmEmissaoNotaAvulsas.AbreConsultaContrato;
    end else
      Jan.ConsultaInterativa := False;
end;

