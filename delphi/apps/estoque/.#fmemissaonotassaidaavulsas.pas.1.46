{$R *.dfm}

{ TfrmEmissaoNotasAvulsas }

procedure TfrmEmissaoNotasSaidaAvulsas.AfterScrollLinhaColunaGrade(Sender: TObject);
begin
  dbgProdutos.Columns[5].Title.Caption := dtmEmissaoNotaAvulsas.LinhadaGrade;
  dbgProdutos.Columns[6].Title.Caption := dtmEmissaoNotaAvulsas.ColunadaGrade;
end;

procedure TfrmEmissaoNotasSaidaAvulsas.AlterarEstadoBotoes;
begin
  inherited;
  {
  sbnExcluir.Enabled :=    (Not dtmEmissaoNotaAvulsas.Cancelada)

                        or (dtmEmissaoNotaAvulsas.Cancelada
                            and ((ParSistema.ExclusaoNotaAvulsa = exnPERGUNTAR) or
                                 (ParSistema.ExclusaoNotaAvulsa = exnEXCLUIR)))

                         and sbnExcluir.Enabled;
}

  sbnExcluir.Enabled :=    ((Not dtmEmissaoNotaAvulsas.Cancelada) 

                        or (dtmEmissaoNotaAvulsas.Cancelada
                            and ((((ParSistema.ExclusaoNotaAvulsa = exnPERGUNTAR) or
                                  (ParSistema.ExclusaoNotaAvulsa = exnEXCLUIR)) and
                                   not dtmEmissaoNotaAvulsas.CondicaoEmissorNFE ) or

								 (dtmEmissaoNotaAvulsas.CondicaoEmissorNFE and (dtmEmissaoNotaAvulsas.qryDadosFiscaisnumcancelamentonfe.AsString='')
                                        and (dtmEmissaoNotaAvulsas.qryDadosFiscaisnuminutilizacaonfe.asstring=''))

								  ))) and

   not (dtmEmissaoNotaAvulsas.qryDadosFiscaissituacao.AsString = 'D') and sbnExcluir.Enabled;


  if dtmEmissaoNotaAvulsas.Cancelada or
    (ParSistema.ExclusaoNotaAvulsa = exnEXCLUIR) then
    sbnExcluir.Caption := 'Excluir F6'
end;

constructor TfrmEmissaoNotasSaidaAvulsas.Create(AOwner: TComponent);
begin
  inherited;

  tstProdutos.TabVisible   := False;
  tstTransporte.TabVisible := False;
//  gbxValoresNota.Visible   := False;
//  gbxValoresNota.Left      := gbxValores.Left;
  FLabelCliente := tstDestino.Caption;
  dtmEmissaoNotaAvulsas := TdtmEmissaoNotaAvulsas.Create(Self);
  DataSet := dtmEmissaoNotaAvulsas.TabelaDadosFiscais;
  dtmEmissaoNotaAvulsas.Abre(ctTabelaCadastroNotaFiscal);
  dbgProdutos.Columns[5].Visible := ParSistema.UsarGradesProdutos;
  dbgProdutos.Columns[6].Visible := ParSistema.UsarGradesProdutos;
//  dbgprodutos.Columns[7].Visible := dtmEmissaoNotaAvulsas.ContribIPI;
  dtmEmissaoNotaAvulsas.OnScrollLinhaColunaGrade := AfterScrollLinhaColunaGrade;
  dtmEmissaoNotaAvulsas.AfterOpenDadosFiscais := AfterOpenDadosFiscais;
  tstContabilidade.TabVisible := ParSistema.GerarContabilidade;
  pgcNotasSaida.ActivePageIndex := 0;

  edtDataEmissao.MensagemPadronizada := ExibirMensagemPadronizadaDataEmissao;
  edtDataSaida.MensagemPadronizada := ExibirMensagemPadronizadaDataSaida;

  if dbgProdutos.Columns[1].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutos.Columns[1].Width := ParSistema.TamanhoMascaraQuantidade;

  with fraLancamentoContabilidade do
  begin
    VaLorICMS                := dtmEmissaoNotaAvulsas.getvaloricms;
    ValorIPI                 := dtmEmissaoNotaAvulsas.getValorIPI;
    ValorPIS                 := dtmEmissaoNotaAvulsas.getValorPIS;
    ValordaNota              := dtmEmissaoNotaAvulsas.GetValordaNota;
    ValordosProdutos         := dtmEmissaoNotaAvulsas.GetValorProdutos;
    ValorServicos            := dtmEmissaoNotaAvulsas.GetValorServicos;
    ValorAcrescimo           := dtmEmissaoNotaAvulsas.GetValorAcrescimo;
    ValorCofinsaRecolher     := dtmEmissaoNotaAvulsas.GetValorCofinsaRecolher;
    ValorFrete               := dtmEmissaoNotaAvulsas.GetValorFrete;
    ValorSeguro              := dtmEmissaoNotaAvulsas.GetValorSeguro;
    ValorDespesasAcessorias  := dtmEmissaoNotaAvulsas.GetValorDespesasAcessorias;
    ValorDespesasCOFINS      := dtmEmissaoNotaAvulsas.GetValorDespesasCOFINS;
    ValorCustodaMercadoria   := dtmEmissaoNotaAvulsas.GetValorCustodaMercadoria;
    ValorEstoquedaMercadoria := dtmEmissaoNotaAvulsas.GetValorEstoquedaMercadoria;
    ValorICMSSubstituicao    := dtmEmissaoNotaAvulsas.GetValorICMSSubstituicao;
    ValorcofinsRetido        := dtmEmissaoNotaAvulsas.GetValorCofinsRetido;
    ValorcsllRetido          := dtmEmissaoNotaAvulsas.GetValorcsllRetido;
    ValorinssRetido          := dtmEmissaoNotaAvulsas.GetValorinssRetido;
    ValorirRetido            := dtmEmissaoNotaAvulsas.GetValorirRetido;
    Valoriss                 := dtmEmissaoNotaAvulsas.GetValorISS;
    ValorissRetido           := dtmEmissaoNotaAvulsas.GetValorISSRetido;
    ValorpisRetido           := dtmEmissaoNotaAvulsas.GetValorpisRetido;
    ValorDescontos           := dtmEmissaoNotaAvulsas.GetValordesconto;
    ValorReceitasDespesasFinanceiras := dtmEmissaoNotaAvulsas.RetornaZero;
    DataDocumento            := dtmEmissaoNotaAvulsas.GetDataDocumento;
    CodigoNatureza           := dtmEmissaoNotaAvulsas.GetCodigoNatureza;
    DebitoFornecedor         := dtmEmissaoNotaAvulsas.getDebitoFornecedor;
    CreditoFornecedor        := dtmEmissaoNotaAvulsas.getCreditoFornecedor;
    SomenteLeituraContabilidade := dtmEmissaoNotaAvulsas.getSomenteLeituraContabilidade;
    GerarDuplicatas          := dtmEmissaoNotaAvulsas.GetGerarDocumentoPag;
    DescricaoHistorico       := dtmEmissaoNotaAvulsas.getdescricaohistorico;
    FilialDocumento          := dtmEmissaoNotaAvulsas.GetFilialDocumento;
    CodigoDocumento          := dtmEmissaoNotaAvulsas.GetCodigoDocumento;
    NumeroNotaFiscal         := dtmEmissaoNotaAvulsas.getnumeronotafiscal;
    ContaDebitarouCreditar   := dtmEmissaoNotaAvulsas.GetContaDebitar;
    HistoricoDebitarouCreditar := dtmEmissaoNotaAvulsas.GetHistoricoDebitar;
    CReDBigualValorNota        := dtmEmissaoNotaAvulsas.GetCReDBigualValorNota;
    GravarSemLanctos           := dtmEmissaoNotaAvulsas.GetGravarSemLanctos;


    Origem                   := 'S';
    OrigemFormulario         := 'S';;
    NomeOrigemFormulario     := self.name;

    AtribuirContaDocumento   := dtmEmissaoNotaAvulsas.AtribuirContaCreditoDocumentoPag;
    EditarDocumento          := dtmEmissaoNotaAvulsas.EditarNotaFiscal;
  end;
  CASE ParSistema.PrecoUnitarioCasasDecimais of
      2: dbgProdutos.Columns[7].Width:= 84;
      3: dbgProdutos.Columns[7].Width:= 94;
      4: dbgProdutos.Columns[7].Width:= 104;
      5: dbgProdutos.Columns[7].Width:= 114;
      6: dbgProdutos.Columns[7].Width:= 124;
      7: dbgProdutos.Columns[7].Width:= 134;
      8: dbgProdutos.Columns[7].Width:= 144;
    end;
  dtmEmissaoNotaAvulsas.AcertarCasasDecimais(dtmEmissaoNotaAvulsas.qryProdutosprecovenda);
  dtmEmissaoNotaAvulsas.OnChangeTipoFornecedor := OnChangeTipoFornecedor;
{  if ParSistema.ControlesVoltadosparaIndustria then
    MontarGrids
  else
  begin
    Panel3.Visible := false;
  end;
}
  edtLocalEntregaCNPJ.Tipo := 'J';
  edtLocalRetiradaCNPJ.Tipo := 'J';

  fraEnderecoRetirada.CampoCidadeIBGE := dtmEmissaoNotaAvulsas.qryDadosFiscaislocalretirada_cidadeibge;
  fraEnderecoEntrega.CampoCidadeIBGE := dtmEmissaoNotaAvulsas.qryDadosFiscaislocalentrega_cidadeibge;
  fraEnderecoCliente.CampoCidadeIBGE := dtmEmissaoNotaAvulsas.qryDadosFiscaiscidadeibge;

  fraConsultaUFEmbarque.TipoPesquisa := pesESTADOS;
  
  fraConsultaCodigoTransportadora.OnFound := AtribuirDadosTransportadora;
  fraConsultaCodigoTransportadora.TipoPesquisa := pesTRANSPORTADORES;

  NumeroAnterior:= 0;

  if dtmEmissaoNotaAvulsas.CondicaoEmissorNFE then
  begin
    edtDataEmissao.ReadOnly := True;
    edtDataEmissao.TabStop  := False;
    gbxNFe.Visible          := True;
  end;

  dbgimpostosprodutos.columns[1].Title.caption := ifthen((dtmEmissaoNotaAvulsas.RegimeTributario=1),'CSOSN','CST');

  fraConsultaTributacaopis.TipoPesquisa := pesTRIBUTOSPIS;
  fraConsultaTributacaoCOFINS.TipoPesquisa := pesTRIBUTOSCOFINS;

  with fraCartaCorrecaoEletronica1 do
  begin
    chave_nfe  := dtmEmissaoNotaAvulsas.Getchave_nfe;
    tiponota   := 'S';
    codigonota := dtmEmissaoNotaAvulsas.GetCodigodaNota;
    email      := dtmEmissaoNotaAvulsas.GetEmail;
    filial     := dtmEmissaoNotaAvulsas.GetFilialNota;
    NumeroNota := dtmEmissaoNotaAvulsas.GetNumeroNota;
    DataNota   := dtmEmissaoNotaAvulsas.getDataNota;
    EmailNotaVinculada :=  dtmEmissaoNotaAvulsas.GetEmailNotaVinculada;
    SerieNota := dtmEmissaoNotaAvulsas.GetSerieNota;
    CondicaoCartaDevolucao := dtmEmissaoNotaAvulsas.GetCondicaoCartaCorrecao;
  end;

  pgcDetalhes.ActivePage := tstDetalhesNotaFiscal;

  fraConsultaSerieSaida.TipoPesquisa := pesSERIES;
  fraConsultaSerieSaida.CondicoesdaConsulta := CondicoesdaConsultaSerieSaida;

  fraConsultanotasaida.TipoPesquisa := pesNOTASNUMERO;
  fraConsultanotasaida.CondicoesdaConsulta := CondicoesdaConsultaNotaSaida;
  fraConsultanotasaida.OnFound := AtribuirDadosConsultanotasaida;

  fraConsultaSerieEntrada.TipoPesquisa := pesSERIESFORNECEDORES;
  fraConsultaSerieEntrada.CondicoesdaConsulta := CondicoesSeriesFornecedoresNotaEntradaRef;

  fraConsultaNotaEntrada.TipoPesquisa := pesNOTASFORNECEDOR;
  fraConsultaNotaEntrada.CondicoesdaConsulta := CondicoesNotaEntradaRef;
  fraConsultaNotaEntrada.OnFound := AtribuirDadosNotaEntradaRef;

//  fraConsultaCliente.TipoCliente := 'C';
//fraConsultaCliente.Tipovfornecedor := 'C';
//  fraConsultaCliente.CondicoesdaConsulta := AtribuirTipoCliente;
  fraConsultaCliente.OnFound := AtribuirDadosClientes;
  fraConsultaCliente.TipoPesquisa := pesCLIENTES;

end;

procedure TfrmEmissaoNotasSaidaAvulsas.dbgProdutosDblClick(Sender: TObject);
begin
  inherited;
  IncluirEditarProduto(False);
  SetFocus;
end;

function TfrmEmissaoNotasSaidaAvulsas.ExisteInformacao(Parametro: Integer; NomeCampo: String; Value: Variant): Boolean;
begin
  case TipoConsulta of
    cnsNATUREZA:      Result := dtmEmissaoNotaAvulsas.ExisteNatureza(NomeCampo, Value);
    cnsNOTA:          Result := dtmEmissaoNotaAvulsas.ExisteNota(NomeCampo, Value);
    cnsESTADO:        Result := dtmEmissaoNotaAvulsas.ExisteEstado(NomeCampo, Value);
    cnsFILIAL:        Result := dtmEmissaoNotaAvulsas.ExisteFilial(NomeCampo, Value);
    cnsSERIE:         Result := dtmEmissaoNotaAvulsas.ExisteSerie(NomeCampo, Value);
    cnsCONTRATO:      if Parametro = 0 then
                        Result := dtmEmissaoNotaAvulsas.ExisteCliente(NomeCampo, Value)
                      else
                        Result := dtmEmissaoNotaAvulsas.ExisteContrato(NomeCampo, Value);
    cnsAGENTE:        Result := dtmEmissaoNotaAvulsas.ExisteAgente(NomeCampo, Value);
  else
    Result := False
  end
end;

procedure TfrmEmissaoNotasSaidaAvulsas.flkCodigoFiscalExit(Sender: TObject);
begin
  inherited;

  if dtmEmissaoNotaAvulsas.QuantidadeNaturezas then
    InternoPesquisar(flkCodigoFiscal,ctCODIGOFISCAL);
  VerificarTipoNotaSaida(true);
  tstExportacao.TabVisible := (copy(flkCodigoFiscal.Text,1,1)='7');

  if (dtmEmissaoNotaAvulsas.qryDadosFiscaisfinalidadenf.AsInteger = 2) then { complementar nf de saida }
  begin
    tstReferenciada.tabvisible := true;
    pgcDetalhes.ActivePage := tstReferenciada;
    fraConsultaSerieSaida.edfcodigo.setfocus;
  end
  else
  if ((dtmEmissaoNotaAvulsas.qryDadosFiscaisfinalidadenf.AsInteger = 4) and  {referencia a entrada}
      (dtmEmissaoNotaAvulsas.qryDadosFiscaisexigenotareferenciada.asboolean)) then {ver tabela de codigosfiscais campo exigenotareferenciada}
  begin
    tstReferenciada.tabvisible := true;
    pgcDetalhes.ActivePage := tstReferenciada;
    fraConsultaSerieEntrada.edfcodigo.setfocus;
  end;
end;

procedure TfrmEmissaoNotasSaidaAvulsas.flkContratoExit(Sender: TObject);
begin
  inherited;
  VerificarTipoNotaSaida(false);
  flkAgente.ReadOnly := Trim(flkContrato.Text) = '';
  sbnConsultaAgente.Enabled := Trim(flkContrato.Text) <> '';
end;

procedure TfrmEmissaoNotasSaidaAvulsas.flkContratoFound(Found: Boolean);
begin
  inherited;
  flkAgente.ReadOnly := Not Found;
  sbnConsultaAgente.Enabled := Found;
end;

Var
  FilialAnt: String;

procedure TfrmEmissaoNotasSaidaAvulsas.flkFilialNotaExit(Sender: TObject);
begin
  inherited;
  FilialAnt := Trim(flkFilialNota.Text)
end;

procedure TfrmEmissaoNotasSaidaAvulsas.flkNotaFound(Found: Boolean);
begin
  inherited;
  if Found then
  begin
    if (NumeroAnterior > 0) and (strtoint(edfNumeroNota.Text) <> (NumeroAnterior)) then
    begin
      dtmEmissaoNotaAvulsas.qryDadosFiscais.Params[0].AsInteger:= strtoint(flkFilialNota.Text);
      dtmEmissaoNotaAvulsas.qryDadosFiscais.Params[1].AsString := flkSerieNota.Text;
      dtmEmissaoNotaAvulsas.qryDadosFiscais.Params[2].AsInteger:= strtoint(edfNumeroNota.Text);
      dtmEmissaoNotaAvulsas.Alterando:= True;
      dtmEmissaoNotaAvulsas.AbrirDadosFiscais
    end
      //dtmEmissaoNotaAvulsas.SelecionarNota2(strtoint(flkFilialNota.Text),strtoint(edfNumeroNota.Text), flkSerieNota.Text)
    else
      dtmEmissaoNotaAvulsas.SelecionarNota1;
    flkCodigoFiscal.Exist;
    fraconsultacliente.edfCodigo.Exist;
    edtCPFCNPJ.ReadOnly := false;
    edtDataEmissao.Minimo := dtmEmissaoNotaAvulsas.NDiasLimiteEmissao;
    edtDataSaida.Minimo := dtmEmissaoNotaAvulsas.NDiasLimiteEmissao;
    if not dtmEmissaoNotaAvulsas.Incluindo then
    begin
      edtDataEmissao.Minimo := DaysBetween(dtmEmissaoNotaAvulsas.DataServidor, (dtmEmissaoNotaAvulsas.DataEmissao-ParSistema.DiasNotaRetroativa));
      edtDataSaida.Minimo := DaysBetween(dtmEmissaoNotaAvulsas.DataServidor, (dtmEmissaoNotaAvulsas.DataSaida-ParSistema.DiasNotaRetroativa));
    end;
    VerificarTipoNotaSaida(false);
  end;
  if edfNumeroNota.Text <> '' then
    NumeroAnterior := strtoint(edfNumeroNota.Text);
end;

procedure TfrmEmissaoNotasSaidaAvulsas.flkSerieNotaEnter(Sender: TObject);
begin
  inherited;
  if Trim(flkFilialNota.Text) <> FilialAnt then
    if Not flkSerieNota.Exist then
      flkSerieNota.Text := '';
end;

function TfrmEmissaoNotasSaidaAvulsas.IncluirEditarProduto(Incluindo: Boolean): Boolean;
begin
{
  if dtmEmissaoNotaAvulsas.ReadOnlyProdutos then
    Result := False
  else
  begin
}

    frmCadastroProdutosNotaSaida := TfrmCadastroProdutosNotaSaida.Create(frmCadastroProdutosNotaSaida);
    try
      Result := dtmEmissaoNotaAvulsas.IncluirProdutoEditar(Incluindo);
      if Result then
      begin
        if dtmEmissaoNotaAvulsas.qryDadosFiscaisrequernfentrada.AsBoolean or
           dtmEmissaoNotaAvulsas.ehNotaReferenciadaDevolucaoRetorno then
        begin
          if dtmEmissaoNotaAvulsas.ehNotaReferenciadaDevolucaoRetorno then
          begin
            if (dtmEmissaoNotaAvulsas.qryDadosFiscaisexigenotareferenciada.asBoolean) and
                (dtmEmissaoNotaAvulsas.qryDadosFiscaiscodigonotareferenciado.AsInteger=0) then
            begin
              pgcDetalhes.ActivePage := tstReferenciada;
              MensagemAviso('Informe a nota fiscal de entrada referenciada');
            end
            else
            begin
              frmCadastroProdutosNotaSaida.pgcEntrada.ActivePage := frmCadastroProdutosNotaSaida.tstEntradaNotas;
              frmCadastroProdutosNotaSaida.tstEntradaNotas.Enabled := true;
            //  frmCadastroProdutosNotaSaida.gbxFornecedorEntrada.Enabled := false;
            //  frmCadastroProdutosNotaSaida.gbxSerieNF.Enabled := false;
            //  frmCadastroProdutosNotaSaida.gbxNumeroNF.Enabled := false;
            //  frmCadastroProdutosNotaSaida.tstNotaReferenciada.Enabled := false;
            //  frmCadastroProdutosNotaSaida.tstEntradasContratos.Enabled := false;

              frmCadastroProdutosNotaSaida.ActiveControl := frmCadastroProdutosNotaSaida.edtQuantidade;
              frmCadastroProdutosNotaSaida.edtQuantidade.SelectAll;
              frmCadastroProdutosNotaSaida.ShowModal;
            end;
          end
          else
          begin
            frmCadastroProdutosNotaSaida.pgcEntrada.ActivePage := frmCadastroProdutosNotaSaida.tstEntradaNotas;
            frmCadastroProdutosNotaSaida.tstEntradaNotas.Enabled := true;
            frmCadastroProdutosNotaSaida.tstNotaReferenciada.Enabled := false;
            frmCadastroProdutosNotaSaida.tstEntradasContratos.Enabled := false;

            frmCadastroProdutosNotaSaida.ActiveControl := frmCadastroProdutosNotaSaida.fraConsultaFornecedorEntrada.edfCodigo;
            frmCadastroProdutosNotaSaida.ShowModal;
          end;
        end
        else
        if dtmEmissaoNotaAvulsas.ehNotaReferenciadaComplementar then
        begin
          if dtmEmissaoNotaAvulsas.qryDadosFiscaisdadofiscalreferenciado.AsInteger <> 0 then
          begin
            frmCadastroProdutosNotaSaida.pgcEntrada.ActivePage := frmCadastroProdutosNotaSaida.tstNotaReferenciada;
            frmCadastroProdutosNotaSaida.tstNotaReferenciada.Enabled := true;
            frmCadastroProdutosNotaSaida.tstEntradaNotas.Enabled := false;
            frmCadastroProdutosNotaSaida.tstEntradasContratos.Enabled := false;
            frmCadastroProdutosNotaSaida.ActiveControl :=
                frmCadastroProdutosNotaSaida.edtQuantidade;
            frmCadastroProdutosNotaSaida.edtQuantidade.SelectAll;
            frmCadastroProdutosNotaSaida.ShowModal;
          end
          else
          begin
            pgcDetalhes.ActivePage := tstReferenciada;
            MensagemAviso('Informe a nota fiscal de saída referenciada');
          end;
        end
        else
        begin
          if dtmEmissaoNotaAvulsas.eHNotaFiscalSaidaDevolucao(dtmEmissaoNotaAvulsas.qryDadosFiscaiscodigofiscal.asinteger) then
            frmCadastroProdutosNotaSaida.pgcEntrada.Visible := false
          else
          begin
            frmCadastroProdutosNotaSaida.pgcEntrada.ActivePage := frmCadastroProdutosNotaSaida.tstEntradasContratos;
            frmCadastroProdutosNotaSaida.tstEntradaNotas.Enabled := false;
            frmCadastroProdutosNotaSaida.tstNotaReferenciada.Enabled := false;
            frmCadastroProdutosNotaSaida.tstEntradasContratos.Enabled := true;

            if (parsistema.ValordaQuantidade > 0) then
            begin
              frmCadastroProdutosNotaSaida.ActiveControl := frmCadastroProdutosNotaSaida.flkCodigoProduto;
              frmCadastroProdutosNotaSaida.flkCodigoProduto.SelectAll;
            end
            else
            begin
              frmCadastroProdutosNotaSaida.ActiveControl := frmCadastroProdutosNotaSaida.edtQuantidade;
              frmCadastroProdutosNotaSaida.edtQuantidade.SelectAll;
            end
          end;
          frmCadastroProdutosNotaSaida.ShowModal;
        end;
      end;
    finally
{      if dtmEmissaoNotaAvulsas.Alteracoes then
        if Incluindo then
        begin
          dtmEmissaoNotaAvulsas.MontarlinhaProdutos(True);
          Gravar:= False;
        end
        else
          dtmEmissaoNotaAvulsas.MontarlinhaProdutos(False); }

        dtmEmissaoNotaAvulsas.OnScrollProdutos := nil;  
        frmCadastroProdutosNotaSaida.Free
    end;

//  end
end;

function TfrmEmissaoNotasSaidaAvulsas.InternoCancelar: Boolean;
begin
  Result := inherited InternoCancelar;
  if Result then begin
    dtmEmissaoNotaAvulsas.CancelarInclusao;
    if Not fraconsultacliente.edfCodigo.Focused then
      fraconsultacliente.edfCodigo.Exist;
    {
    if UsuarioLogin.AlterarDadosContabeis then
    begin
      edtDataSaida.Minimo := 37353;
      edtDataEmissao.Minimo := 37353;
    end
    else
    begin
      edtDataEmissao.Minimo := DaysBetween(dtmEmissaoNotaAvulsas.DataServidor, (dtmEmissaoNotaAvulsas.DataEmissao-ParSistema.DiasNotaRetroativa));
      edtDataSaida.Minimo := DaysBetween(dtmEmissaoNotaAvulsas.DataServidor, (dtmEmissaoNotaAvulsas.DataSaida-ParSistema.DiasNotaRetroativa));
    end;
    }
    VerificarTipoNotaSaida(false);
  end;
end;

function TfrmEmissaoNotasSaidaAvulsas.InternoExcluir: Boolean;
var frmAjuda: TForm;
    Cancelar: Boolean;
    Msg: String;
    incluindonota : Boolean;
begin
  incluindonota := dtmEmissaoNotaAvulsas.Incluindo;
  result := true;
  if CtrlOn then
    sbnExcluirProduto.Click
  else
  begin
    Result:= inherited InternoExcluir;
    Cancelar := False;
    if Result then
    begin
      if dtmEmissaoNotaAvulsas.CondicaoEmissorNFE then
        Cancelar := True
      else
      if ParSistema.ExclusaoNotaAvulsa = exnCANCELAR then
        Cancelar:= True
      else
      begin
        if (ParSistema.ExclusaoNotaAvulsa = exnPERGUNTAR) and
           (not dtmEmissaoNotaAvulsas.Cancelada)  then
        begin
          Cancelar:= MensagemConfirmacao(ctCANCELARNOTAAVULSA) = smbCANCEL;
          if not Cancelar then
          begin
            Msg    := Format(ctCONFIRMEEXCLUIR, ['a nota fiscal']);
            Result := MensagemConfirmacao(Msg) = smbOk;
          end
        end
        else
        begin
          Cancelar:= False;
          Msg    := Format(ctCONFIRMEEXCLUIR, ['a nota fiscal']);
          Result := MensagemConfirmacao(Msg) = smbOk;
        end
      end
    end;

    if Result then
    begin
      { Gedovar 16/07/2013: não entendi a razao de limpar o numero da nota em uma exclusão ou cancelamento da mesma }
      if not cancelar then
        edfNumeroNota.Clear;

      dtmEmissaoNotaAvulsas.CodigoDocumento :=
        dtmEmissaoNotaAvulsas.qryDadosFiscaisnumero.Asinteger;

      Result := dtmEmissaoNotaAvulsas.ExcluirNotaFiscal(cancelar);
      if result and ParSistema.GerarContabilidade then
      begin
        fraLancamentoContabilidade.ApagarLancamentos;
        fraLancamentoContabilidade.GerarLancamentosP_Dupla(false);
      end;

      if result then
      begin
        Result := dtmEmissaoNotaAvulsas.PerpetrarExclusao(Cancelar);
        dtmEmissaoNotaAvulsas.CodigoDocumento := 0;
      end;
    end;

    if Result then
    begin
      if dtmEmissaoNotaAvulsas.PossuiContrato and (dtmEmissaoNotaAvulsas.qryDadosFiscaisnotavinculada.AsString <> 'True') then
      begin
        frmAjuda := FormExists('TfrmCadastroContratos');
        if Assigned(frmAjuda) then
          TfrmAjuda(frmAjuda).OperacaoPadrao([]);
        frmAjuda := FormExists('TfrmOperacoesContratos');
        if Assigned(frmAjuda) then
          TfrmAjuda(frmAjuda).OperacaoPadrao([]);
      end;
      VerificarTipoNotaSaida(false);
      if incluindonota then
      begin
        InternoCancelar;
        pgcDetalhes.ActivePage := tstDetalhesNotaFiscal;
        flkFilialNota.SetFocus;
        flkFilialNota.SetControl(false);
      end;
    end;

  end
end;

function TfrmEmissaoNotasSaidaAvulsas.InternoGravar: Boolean;
var
  Erro: Integer;
begin
  Erro := -1;
  pgcDetalhes.ActivePage := tstDetalhesNotaFiscal;
  if flkFilialNota.CanFocus then
    flkFilialNota.SetFocus
  else if flkContrato.CanFocus then
    flkContrato.SetFocus;

  result := fraLancamentoContabilidade.VerificarLancamentosContabeis;
  if not result then
    erro := 3;

  if result then
    Result := dtmEmissaoNotaAvulsas.GravarNotaFiscal(Erro);

  case erro of
     //diferenca entre produtos e demais campos com o total da nota
  1: pgcNotasSaida.ActivePage := tstValores;
     //diferemca entre os impostos e o total da nota;
  2: pgcNotasSaida.ActivePage := tstImpostos;
  3: pgcNotasSaida.ActivePage := tstContabilidade;
  else
    if tstContabilidade.TabVisible then
      fraLancamentoContabilidade.atualizarDescricaoHistorico;
  end;

  sbnConsultaFilial.Enabled := flkFilialNota.Enabled;
end;

function TfrmEmissaoNotasSaidaAvulsas.InternoIncluir: Boolean;
begin
  result := true;
  if not CtrlOn then
  begin
    edfNumeroNota.Clear;
    pgcNotasSaida.ActivePage:= tstDestino;
    Result := dtmEmissaoNotaAvulsas.IncluirNotaFiscal;
    edtDataSaida.Minimo := dtmEmissaoNotaAvulsas.NDiasLimiteEmissao;
    edtDataEmissao.Minimo := dtmEmissaoNotaAvulsas.NDiasLimiteEmissao;
    VerificarTipoNotaSaida(false);
    BloquearControle(Parsistema.padraonotamanual);
    pgcDetalhes.ActivePage := tstDetalhesNotaFiscal;
    {
    if ParSistema.PadraoNotaManual then
      flkSerieNota.SetFocus
    else
    if flkAgente.canfocus then
      flkAgente.setfocus
    else
      fraconsultacliente.edfCodigo.setfocus;
      }
{      flkCodigoFiscal.SetFocus;}
  end;
  sbnConsultaFilial.Enabled := flkFilialNota.Enabled;

end;

function TfrmEmissaoNotasSaidaAvulsas.InternoPesquisar(Titulo: String): Integer;
var
  Arq: Integer;
begin
  Arq := -1;
  if CtrlOn then
  begin
    if dtmEmissaoNotaAvulsas.ReadOnly then
      Arq := -1
    else if flkCodigoFiscal.Focused then begin
      dtmEmissaoNotaAvulsas.Abre(ctTabelaNaturezaOperacoes);
      Arq          := ctTabelaNaturezaOperacoes;
      Titulo       := ctCODIGOFISCAL;
      TipoConsulta := cnsNATUREZA;
    end else if flkEstadoPlaca.Focused then begin
      dtmEmissaoNotaAvulsas.Abre(ctTabelaConsultaEstado);
      Arq          := ctTabelaConsultaEstado;
      Titulo       := ctESTADO;
      TipoConsulta := cnsESTADO
    end else if flkFilialNota.Focused then begin
      dtmEmissaoNotaAvulsas.Abre(ctTabelaConsultaFilial);
      Arq          := ctTabelaConsultaFilial;
      Titulo       := ctFILIAIS;
      TipoConsulta := cnsFILIAL
    end else if flkSerieNota.Focused then begin
      dtmEmissaoNotaAvulsas.Abre(ctTabelaConsultaSerie);
      Arq          := ctTabelaConsultaSerie;
      Titulo       := ctSERIES;
      TipoConsulta := cnsSERIE
    end else if flkContrato.Focused then begin
      dtmEmissaoNotaAvulsas.Abre(ctTabelaConsultaClientes);
      Arq          := ctTabelaConsultaContratos;
      Titulo       := ctCONTRATOS;
      TipoConsulta := cnsCONTRATO
    end else if flkAgente.Focused and Not flkAgente.ReadOnly then begin
      dtmEmissaoNotaAvulsas.Abre(ctTabelaConsultaAgentes);
      TipoConsulta := cnsAGENTE;
      Arq          := ctTabelaConsultaAgentes;
      Titulo       := ctAGENTES;
    end
{
    else if (ActiveControl = flkDebitar) then
    begin
      if dtmEmissaoNotaAvulsas.qryDadosFiscaiscreditar.AsInteger<>0 then
         dtmEmissaoNotaAvulsas.qryConsultaContaContabil.MacroByName('consulta').AsString :=
            'and codigo <> '+dtmEmissaoNotaAvulsas.qryDadosFiscaiscreditar.AsString;
      dtmEmissaoNotaAvulsas.Abre(ctConsultaContaContabil);
      TipoConsulta := cnsCONTADEBITO;
      arq          := ctConsultaContaContabil;
    end
    else if (ActiveControl = flkCreditar) then
    begin
      if dtmEmissaoNotaAvulsas.qryDadosFiscaisdebitar.AsInteger<>0 then
         dtmEmissaoNotaAvulsas.qryConsultaContaContabil.MacroByName('consulta').AsString :=
            'and codigo <> '+dtmEmissaoNotaAvulsas.qryDadosFiscaisdebitar.AsString;
      dtmEmissaoNotaAvulsas.Abre(ctConsultaContaContabil);
      TipoConsulta := cnsCONTACREDITO;
      arq          := ctConsultaContaContabil;
    end
    else if (ActiveControl = flkHistorico) then begin
      dtmEmissaoNotaAvulsas.abre(ctConsultaHistoricos);
      TipoConsulta:= cnsHISTORICO;
      arq := ctConsultaHistoricos;
    end;
}

  end else begin
    dtmEmissaoNotaAvulsas.Abre(ctTabelaConsultaNotaFiscal);
    Arq          := ctTabelaConsultaNotaFiscal;
    Titulo       := ctNOTASFISCAIS;
    TipoConsulta := cnsNOTA;
  end;

  if Arq = -1 then
    Result := mrNONE
  else begin
    Result := inherited InternoPesquisar(Titulo);
    if Result = mrOK then
      case TipoConsulta of
        cnsNATUREZA:      dtmEmissaoNotaAvulsas.SelecionarCodigoFiscal;
        cnsNOTA:          begin
                            dtmEmissaoNotaAvulsas.SelecionarNota;
                          end;
        cnsFILIAL:        begin
                            flkFilialNota.Text := dtmEmissaoNotaAvulsas.FilialConsulta;
                            flkFilialNota.Exist;
                          end;
        cnsSERIE:         flkSerieNota.Text := dtmEmissaoNotaAvulsas.SerieConsulta;
        cnsESTADO:        dtmEmissaoNotaAvulsas.SelecionarEstado;
        cnsCONTRATO:      begin
                            dtmEmissaoNotaAvulsas.SelecionarContrato;
                            VerificarTipoNotaSaida(false);
                          end;
        cnsAGENTE:        dtmEmissaoNotaAvulsas.SelecionarAgente;
      end;
      dtmEmissaoNotaAvulsas.Fecha(Arq);
  end;

  CtrlOn:=False;
end;

function TfrmEmissaoNotasSaidaAvulsas.JanelaPesquisa: TfrmConsultaBasica;
begin
  Jan := TfrmConsultaPorCampo.Create(nil);
  if TipoConsulta in [cnsCLIENTES, cnsNATUREZA, cnsSERIE, cnsNOTA] then
    Jan.UsarParametrosDaTabela := False;
  if Not (TipoConsulta in [cnsCLIENTES, cnsCONTRATO, cnsNOTA]) then
    Jan.ConsultaInterativa := True
  else Jan.ConsultaInterativa := false;
  Result := Jan
end;

