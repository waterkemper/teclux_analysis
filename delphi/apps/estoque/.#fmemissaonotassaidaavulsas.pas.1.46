  Sender: TObject);
begin
  inherited;
  if dtmEmissaoNotaAvulsas.qryDadosFiscais.state = dsinsert then
    if rbnnormal.checked or rbnAjuste.checked then
    begin
      dtmEmissaoNotaAvulsas.LimparDadosNotaReferenciada;
      fraConsultaSerieSaida.edfCodigo.Clear;
      fraConsultanotasaida.edfCodigo.Clear;
