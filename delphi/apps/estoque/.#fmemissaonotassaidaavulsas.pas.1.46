{
procedure TfrmEmissaoNotasSaidaAvulsas.MontarGrids;
var a, TamTotal: integer;
begin
  TamTotal:= 0;

  dtmEmissaoNotaAvulsas.qrycamposnotafiscal.open;

  dtmEmissaoNotaAvulsas.qrycamposnotafiscal.first;
  for A:= 0 to dtmEmissaoNotaAvulsas.qrycamposnotafiscal.RecordCount -1 do
  begin
    dbgtitulos.ColCount:= dtmEmissaoNotaAvulsas.qrycamposnotafiscal.RecordCount;
    dbgTitulos.Font.Size:= 7;
    dbgtitulos.Cells[a,0]:= dtmEmissaoNotaAvulsas.qryCamposNotaFiscaldescricao.AsString;
    dbgtitulos.ColWidths[a]:= dtmEmissaoNotaAvulsas.qryCamposNotaFiscaltamanho.AsInteger;
    TamTotal:= TamTotal + dtmEmissaoNotaAvulsas.qryCamposNotaFiscaltamanho.AsInteger+1;
    dtmEmissaoNotaAvulsas.qrycamposnotafiscal.Next;
  end;
    dbgLinhasNf.Columns[0].Width:= TamTotal;
    dtmEmissaoNotaAvulsas.qryLinhasNotasFiscais.Open;
end;

procedure TfrmEmissaoNotasSaidaAvulsas.dbglinhasNfDblClick(
  Sender: TObject);
begin
  inherited;
  if dtmEmissaoNotaAvulsas.qryLinhasNotasFiscaistemproduto.AsBoolean then
  begin
    dtmEmissaoNotaAvulsas.Alteracoes:= True;
    IncluirEditarProduto(False);
  end;
end;

procedure TfrmEmissaoNotasSaidaAvulsas.dbglinhasNfKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if (Key = VK_Return) or (Key = VK_RETURN) then
  begin
    if dtmEmissaoNotaAvulsas.Gravar then
    begin
      if dtmEmissaoNotaAvulsas.qryLinhasNotasFiscaistexto.AsString <> '' then
      begin
        dtmEmissaoNotaAvulsas.qryLinhasNotasFiscais.Post;
        dtmEmissaoNotaAvulsas.Gravar:= False;
      end;
    end
    else
    begin
      if (dtmEmissaoNotaAvulsas.qryLinhasNotasFiscais.RecNo =
          dtmEmissaoNotaAvulsas.qryLinhasNotasFiscais.RecordCount) then
      begin
        dtmEmissaoNotaAvulsas.qryLinhasNotasFiscais.Append;
        dtmEmissaoNotaAvulsas.Gravar:= True;
      end
      else
        dtmEmissaoNotaAvulsas.qryLinhasNotasFiscais.Next;
    end;
  end;

  if (Key = Key_F11) then
  begin
    dtmEmissaoNotaAvulsas.qryLinhasNotasFiscais.Insert;
  end;
end;

procedure TfrmEmissaoNotasSaidaAvulsas.dbgtitulosDrawCell(Sender: TObject;
  ACol, ARow: Integer; Rect: TRect; State: TGridDrawState);
var texto : string;
   largurat, alturat : integer;
   largurac, alturac : integer;
begin
  inherited;
  texto := dbgtitulos.Cells[ACol, ARow];
  alturat  := CAnvas.TextHeight(texto) div 2;
  alturac  := dbgtitulos.RowHeights[ACol] div 2;
  largurat := Canvas.TextWidth(texto) div 2;
  largurac := dbgtitulos.ColWidths[ACol] div 2;

  dbgtitulos.Canvas.FillRect(Rect);
  dbgtitulos.Canvas.TextOut(Rect.Left+largurac-largurat,Rect.Top+alturac-alturat, texto);
end;
}
procedure TfrmEmissaoNotasSaidaAvulsas.AtribuirDadosTransportadora;
begin
  with dtmEmissaoNotaAvulsas do
  begin
    qryDadosFiscaisTransportadora_CNPJ.AsString :=
    fraConsultaCodigoTransportadora.qryProcuraTransportadorpessoanumero.AsString;

    qryDadosFiscaistransportadora_ie.AsString :=
    fraConsultaCodigoTransportadora.qryProcuraTransportadorinscricaoestadual.AsString;

    qryDadosFiscaisTransportadora_Nome.AsString  :=
    fraConsultaCodigoTransportadora.qryProcuraTransportadorrazao.AsString;

    qryDadosFiscaisTransportadora_Rua.AsString   :=
    fraConsultaCodigoTransportadora.qryProcuraTransportadorrua.AsString;

    qryDadosFiscaisTransportadora_Bairro.AsString:=
    fraConsultaCodigoTransportadora.qryProcuraTransportadorbairro.AsString;

    qryDadosFiscaisTransportadora_NomeBairro.AsString :=
    fraConsultaCodigoTransportadora.qryProcuraTransportadornomebairro.AsString;

    qryDadosFiscaisTransportadora_Cidade.AsString     :=
    fraConsultaCodigoTransportadora.qryProcuraTransportadorcidade.AsString;

    qryDadosFiscaisTransportadora_NomeCidade.AsString :=
    fraConsultaCodigoTransportadora.qryProcuraTransportadornomecidade.AsString;

    qryDadosFiscaisTransportadora_CidadeIBGE.AsString :=
    fraConsultaCodigoTransportadora.qryProcuraTransportadorcodigocidadeibge.AsString;

    qryDadosFiscaisTransportadora_estado.AsString     :=
    fraConsultaCodigoTransportadora.qryProcuraTransportadorestado.AsString;

    qryDadosFiscaisTransportadora_RNTC.AsString       :=
    fraConsultaCodigoTransportadora.qryProcuraTransportadorrntc.AsString;
  end;

end;

procedure TfrmEmissaoNotasSaidaAvulsas.ExibirMensagemPadronizadaDataEmissao;
begin
  if strtodate(edtDataEmissao.Text) <= ParSistema.DataContabil then
    MensagemAviso(format(ctDATACONTABILMAIORDATALANCTO, ['de emissão',
                     edtDataEmissao.Text, 'contábil', ParSistema.DataContabilstring]))
  else
  if dtmEmissaoNotaAvulsas.Incluindo then
  begin
    if strtodate(edtDataEmissao.Text) < DataLocal - edtDataEmissao.minimo then
      MensagemAviso(format(ctDATACONTABILMAIOROUIGUALDATALANCTO, ['de emissão',
                       edtDataEmissao.Text, 'retroativa',
                       datetostr(DataLocal - edtDataEmissao.Minimo)]))
  end
  else
    if strtodate(edtDataEmissao.Text) < DataLocal - DaysBetween(dtmEmissaoNotaAvulsas.DataServidor,
                                           (dtmEmissaoNotaAvulsas.qryDadosFiscaisdata.AsDateTime -
                                             ParSistema.DiasNotaRetroativa)) then
      MensagemAviso(format(ctDATACONTABILMAIOROUIGUALDATALANCTO, ['de emissão',
                       edtDataEmissao.Text, 'retroativa',
                       DataLocal - DaysBetween(dtmEmissaoNotaAvulsas.DataServidor,
                                             (dtmEmissaoNotaAvulsas.qryDadosFiscaisdata.AsDateTime -
                                             ParSistema.DiasNotaRetroativa) )]));
end;

procedure TfrmEmissaoNotasSaidaAvulsas.ExibirMensagemPadronizadaDataSaida;
begin
  if strtodate(edtDataSaida.Text) <= ParSistema.DataContabil then
    MensagemAviso(format(ctDATACONTABILMAIORDATALANCTO, ['de saída',
                     edtDataSaida.Text, 'contábil', ParSistema.DataContabilstring]))
  else
  if strtodate(edtDataSaida.Text) < strtodate(edtDataEmissao.Text) then
    MensagemAviso(format(ctDATACONTABILMAIOROUIGUALDATALANCTO, ['de saída',
                     edtDataSaida.Text, 'emissão', edtDataEmissao.Text]))
end;

procedure TfrmEmissaoNotasSaidaAvulsas.Action1Update(Sender: TObject);
begin
  inherited;
  with dtmEmissaoNotaAvulsas do
  begin
    sbnIncluirProduto.Enabled := not ReadOnlyProdutos;
    sbnExcluirProduto.Enabled := sbnIncluirProduto.Enabled;

//    sbnIncluirImposto.Enabled := not SomenteLeituraImpostos;
//    sbnExcluirImposto.Enabled := sbnIncluirImposto.Enabled;
//    sbnIncluirAliquotasImpostos.Enabled := sbnIncluirImposto.Enabled;
    tstServicos.tabVisible := dtmEmissaoNotaAvulsas.qryServicosDadosFiscais.RecordCount <> 0;

    tstReferenciada.tabvisible := (dtmEmissaoNotaAvulsas.qryDadosFiscaisfinalidadenf.AsInteger = 2) or { complementar nf de saida }
                                  ((dtmEmissaoNotaAvulsas.qryDadosFiscaisfinalidadenf.AsInteger = 4) and  {referencia a entrada}
                                   (dtmEmissaoNotaAvulsas.qryDadosFiscaisexigenotareferenciada.asboolean)); {ver tabela de codigosfiscais campo exigenotareferenciada}


//    edtDespesasAcessorias.ReadOnly := dtmEmissaoNotaAvulsas.qryDadosFiscaisrequernfentrada.AsBoolean and dtmEmissaoNotaAvulsas.eHNotaFiscalSaidaDevolucao(dtmEmissaoNotaAvulsas.qryDadosFiscaiscodigofiscal.AsInteger, true);

    if (qryDadosFiscais.state = dsinsert) and
       (qryProdutos.isempty) then
    begin
      rgpFinalidadeNFE.enabled := true;
      rbnNormal.tabstop := true;
    end
    else
    begin
      rgpFinalidadeNFE.enabled := false;
      rbnNormal.tabstop := false;
    end;

    if not qryProdutos.readonly then
    begin
      fraConsultaSerieEntrada.edfCodigo.ReadOnly := not qryProdutos.isempty;
      fraConsultaNotaEntrada.edfCodigo.ReadOnly := fraConsultaSerieEntrada.edfCodigo.ReadOnly;
    end;  

  end;



end;

procedure TfrmEmissaoNotasSaidaAvulsas.dbgImpostosProdutosDrawColumnCell(
  Sender: TObject; const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  inherited;
  with dtmEmissaoNotaAvulsas do begin
      if (qryCalculosProdutostipo.asstring = 'TOTAL ICMS') or
         (qryCalculosProdutostipo.asstring = 'TOTAL IPI') or
         (qryCalculosProdutostipo.asstring = 'TOTAL ISS') then
      begin
         if ((abs((qryCalculosProdutostotal.ascurrency -
              qryDadosFiscaisvalortotal.AsCurrency))>=0.01))
         then TDBGrid(Sender).Canvas.Font.Color:= clRed
         else TDBGrid(Sender).Canvas.Font.Color:= clBlack;
        TDBGrid(Sender).Canvas.Font.Style := [fsBold];
        if not (gdSelected in State) then
          TDBGrid(Sender).Canvas.Brush.Color := TColor(strtoint(parsistema.CorZebradoRelatorio));
      end
      else TDBGrid(Sender).Canvas.Font.Style := []
  end;
  TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);

end;

procedure TfrmEmissaoNotasSaidaAvulsas.edtPlacaKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if key = VK_DELETE then
  begin
    dtmEmissaoNotaAvulsas.qryDadosFiscaisplaca.Clear;
    edtplaca.Clear;
    edtplaca.SelectAll;
  end;

end;

