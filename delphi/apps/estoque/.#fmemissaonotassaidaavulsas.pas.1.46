end;

*)

procedure TfrmEmissaoNotasSaidaAvulsas.rbnComplementarClick(
  Sender: TObject);
begin
  inherited;
  if tstReferenciada.TabVisible then
    pgcDetalhes.ActivePage := tstReferenciada;

  gbxNFSaida.Visible := true;
  gbxNotaFiscalEntrada.Visible := false;

end;

procedure TfrmEmissaoNotasSaidaAvulsas.rbnNormalClick(Sender: TObject);
begin
  inherited;
  dtmEmissaoNotaAvulsas.LimparDadosNotaEntradaReferenciada;
  dtmEmissaoNotaAvulsas.LimparDadosNotaSaidaReferenciada;

  fraConsultaSerieSaida.edfCodigo.Clear;
  fraConsultanotasaida.edfCodigo.Clear;

  fraConsultaSerieEntrada.edfCodigo.Clear;
  fraConsultaNotaEntrada.edfCodigo.Clear;

end;

procedure TfrmEmissaoNotasSaidaAvulsas.rbnDevolucaoRetornoClick(
  Sender: TObject);
begin
  inherited;
  if tstReferenciada.TabVisible then
    pgcDetalhes.ActivePage := tstReferenciada;

  gbxNFSaida.Visible := false;
  gbxNotaFiscalEntrada.Visible := true;

end;


procedure TfrmEmissaoNotasSaidaAvulsas.CondicoesSeriesFornecedoresNotaEntradaRef;
begin
  fraConsultaSerieEntrada.qryProcuraSeriesFornecedor.ParamByName('fornecedor').AsInteger :=  dtmEmissaoNotaAvulsas.qryDadosFiscaiscliente.AsInteger;
  fraConsultaSerieEntrada.qryProcuraSeriesFornecedor.ParamByName('tipo').AsString :=         dtmEmissaoNotaAvulsas.qryDadosFiscaistipocliente.AsString;
  fraConsultaSerieEntrada.qryProcuraSeriesFornecedor.ParamByName('filialbase').Asinteger :=  dtmEmissaoNotaAvulsas.qryDadosFiscaisfilialemissao.AsInteger;

  fraConsultaSerieEntrada.qryConsultaSeriesFornecedor.ParamByName('fornecedor').AsInteger := dtmEmissaoNotaAvulsas.qryDadosFiscaiscliente.AsInteger;
  fraConsultaSerieEntrada.qryConsultaSeriesFornecedor.ParamByName('tipo').AsString :=        dtmEmissaoNotaAvulsas.qryDadosFiscaistipocliente.AsString;
  fraConsultaSerieEntrada.qryConsultaSeriesFornecedor.ParamByName('filialbase').Asinteger := dtmEmissaoNotaAvulsas.qryDadosFiscaisfilialemissao.AsInteger;

  fraConsultaSerieEntrada.qryProcuraSeriesFornecedor.MacroByName('SQLCondicao').AsString := ' and (fornecedor,serie) in ( '+
                                                                               ' select np.fornecedor, np.serie '+
                                                                               ' from notaspag np '+
                                                                               ' where np.fornecedor  = ' + inttostr(dtmEmissaoNotaAvulsas.qryDadosFiscaiscliente.AsInteger) +
                                                                               ' and np.tipofornecedor = ' + quotedstr(dtmEmissaoNotaAvulsas.qryDadosFiscaistipocliente.AsString)+')';

  fraConsultaSerieEntrada.qryConsultaSeriesFornecedor.MacroByName('SQLCondicao').AsString := fraConsultaSerieEntrada.qryProcuraSeriesFornecedor.MacroByName('SQLCondicao').AsString;


end;


procedure TfrmEmissaoNotasSaidaAvulsas.CondicoesNotaEntradaRef;
const
  SQLSitucao = 'and (np.situacao = ''N'')';
begin

  fraConsultaNotaEntrada.qryConsultaNotaspag.MacroByName('SQL').AsString := SQLSitucao;
  fraConsultaNotaEntrada.qryConsultaNotaspag.ParamByName('fornecedor').asinteger := dtmEmissaoNotaAvulsas.qryDadosFiscaiscliente.AsInteger;
  fraConsultaNotaEntrada.qryConsultaNotaspag.ParamByName('tipofornecedor').asString := dtmEmissaoNotaAvulsas.qryDadosFiscaistipocliente.AsString;
  fraConsultaNotaEntrada.qryConsultaNotaspag.ParamByName('serie').asString := fraConsultaSerieEntrada.qryProcuraSeriesFornecedorserie.AsString;

  fraConsultaNotaEntrada.qryProcuraNotasPag.MacroByName('SQL').AsString := SQLSitucao;
  fraConsultaNotaEntrada.qryProcuraNotasPag.ParamByName('fornecedor').asinteger := dtmEmissaoNotaAvulsas.qryDadosFiscaiscliente.AsInteger;
  fraConsultaNotaEntrada.qryProcuraNotasPag.ParamByName('tipofornecedor').asString := dtmEmissaoNotaAvulsas.qryDadosFiscaistipocliente.AsString;
  fraConsultaNotaEntrada.qryProcuraNotasPag.ParamByName('serie').asString := fraConsultaSerieEntrada.qryProcuraSeriesFornecedorserie.AsString;

end;


procedure TfrmEmissaoNotasSaidaAvulsas.AtribuirDadosNotaEntradaRef;
begin
  if fraConsultaNotaEntrada.qryProcuraNotasPagserie.AsString <> fraConsultaSerieEntrada.qryProcuraSeriesFornecedor.ParamByName('serie').asstring then
  begin
    fraConsultaSerieEntrada.qryProcuraSeriesFornecedor.ParamByName('serie').asstring := fraConsultaNotaEntrada.qryProcuraNotasPagserie.AsString;
    fraConsultaSerieEntrada.edfcodigo.exist;
  end;

  dtmEmissaoNotaAvulsas.qryNotaEntradaRef.ParamByName('fornecedor').AsInteger    := fraConsultaNotaEntrada.qryProcuraNotasPagfornecedor.AsInteger;
  dtmEmissaoNotaAvulsas.qryNotaEntradaRef.ParamByName('tipofornecedor').AsString := fraConsultaNotaEntrada.qryProcuraNotasPagtipofornecedor.AsString;
  dtmEmissaoNotaAvulsas.qryNotaEntradaRef.ParamByName('serie').AsString          := fraConsultaNotaEntrada.qryProcuraNotasPagserie.AsString;
  dtmEmissaoNotaAvulsas.qryNotaEntradaRef.ParamByName('numero').AsInteger        := fraConsultaNotaEntrada.qryProcuraNotasPagnumero.AsInteger;

  if (fraConsultaSerieEntrada.edfCodigo.Text <> fraConsultaNotaEntrada.qryProcuraNotasPagserie.AsString) or
     (fraConsultaNotaEntrada.edfCodigo.Text <> fraConsultaNotaEntrada.qryProcuraNotasPagnumero.AsString) then
  begin
    fraConsultaSerieEntrada.edfCodigo.Text := fraConsultaNotaEntrada.qryProcuraNotasPagserie.AsString;
    fraConsultaNotaEntrada.edfCodigo.Text := fraConsultaNotaEntrada.qryProcuraNotasPagnumero.AsString;
    fraConsultaNotaEntrada.edfCodigo.exist;
  end;


  {
  with dtmEmissaoNotaAvulsas do
  begin
    fornecedornotafiscalentrada := fraConsultaNotaEntrada.qryProcuraNotasPagfornecedor.AsInteger;
    tipofornecedornotafiscalentrada := fraConsultaNotaEntrada.qryProcuraNotasPagtipofornecedor.AsString;
    SeriedoProduto := fraConsultaNotaEntrada.qryProcuraNotasPagserie.AsString;
    NotaFiscaldoProduto := fraConsultaNotaEntrada.qryProcuraNotasPagnumero.AsInteger;
    CodigoNotadoProduto := fraConsultaNotaEntrada.qryProcuraNotasPagcodigo.AsInteger;
  end;
  }
end;

procedure TfrmEmissaoNotasSaidaAvulsas.fraConsultaSerieEntradaedfCodigoFound(
  Found: Boolean);
begin
  inherited;
  if found then
    AtribuirDadosNotaEntradaRef;
end;

procedure TfrmEmissaoNotasSaidaAvulsas.fraConsultaSerieSaidaedfCodigoFound(
  Found: Boolean);
begin
  inherited;
  if found then
    AtribuirDadosConsultanotasaida;
end;


procedure TfrmEmissaoNotasSaidaAvulsas.AtribuirDadosClientes;
begin
  dtmEmissaoNotaAvulsas.qryProcuraCliente.paramByname('tipo').asString := fraConsultaCliente.qryProcuraClientetipo.AsString ;
  dtmEmissaoNotaAvulsas.qryProcuraCliente.paramByname('codigo').asInteger := fraConsultaCliente.qryProcuraClientecodigo.AsInteger;
  dtmEmissaoNotaAvulsas.qrydadosfiscaistipocliente.asString := fraConsultaCliente.qryProcuraClientetipo.AsString ;
  dtmEmissaoNotaAvulsas.qrydadosfiscaiscliente.asinteger := fraConsultaCliente.qryProcuraClientecodigo.AsInteger;


end;

procedure TfrmEmissaoNotasSaidaAvulsas.tstReferenciadaHide(
  Sender: TObject);
begin
  inherited;
  pgcDetalhes.ActivePage := tstDetalhesNotaFiscal;
end;

end.

