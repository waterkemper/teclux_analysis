procedure TfrmEmissaoNotasSaidaAvulsas.pgcNotasSaidaChange(
  Sender: TObject);
begin
  inherited;
  if pgcNotasSaida.Enabled then
  begin
    SelectNext(ActiveControl,true,true);
{    if ActivePage = tstDestino then
    begin
      if pgcEnderecos.ActivePage = tstEndereco then
        fraEnderecoCliente.mmoRua.SetFocus
      else if pgcEnderecos.ActivePage = tstRetirada then
        fraEnderecoRetirada.mmoRua.SetFocus
      else if pgcEnderecos.ActivePage = tstEntrega then
        fraEnderecoEntrega.mmoRua.SetFocus;
    end
    else if ActivePage = tstValores then
      gbxServicos.SetFocus
    else if ActivePage = tstTransporte then
      gbxTranportadora.SetFocus
    else if ActivePage = tstServicos then
      gbxValorServicos.SetFocus
    else if ActivePage = tstExportacao then
      gbxUFEmbarque.SetFocus
}
    if pgcNotasSaida.ActivePage = tstContabilidade then
      with fraLancamentoContabilidade do
      begin
        sbnIncluirLancamento.Enabled := dtmEmissaoNotaAvulsas.qryDadosFiscaissituacao.AsString = 'N';
        sbnExcluirLancamento.Enabled := sbnIncluirLancamento.Enabled;
        sbnGerarLancamento.Enabled := sbnIncluirLancamento.Enabled;
        if sbnIncluirLancamento.Enabled then
          if not ExisteLancamentosContabeis then
            GerarLancamentosContabeis;
      end;
    {
    if pgcNotasSaida.ActivePage = tstTransporte then
      dtmEmissaoNotaAvulsas.AtribuirTotais_Peso_e_Volumes;
    }
  end;
end;

