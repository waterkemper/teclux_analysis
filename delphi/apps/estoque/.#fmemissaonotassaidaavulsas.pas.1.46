procedure TfrmEmissaoNotasSaidaAvulsas.FormActivate(Sender: TObject);
begin
  inherited;
  pgcDetalhes.ActivePage := tstDetalhesNotaFiscal;
end;

procedure TfrmEmissaoNotasSaidaAvulsas.CondicoesdaConsultaSerieSaida;
begin
  fraConsultaSerieSaida.qryProcuraSerie.ParamByName('filial').AsInteger := dtmEmissaoNotaAvulsas.qryDadosFiscaisfilialemissao.AsInteger;
  fraConsultaSerieSaida.qryConsultaSerie.ParamByName('filial').AsInteger := dtmEmissaoNotaAvulsas.qryDadosFiscaisfilialemissao.AsInteger;

  fraConsultaSerieSaida.qryProcuraSerie.MacroByName('SQLCondicao').AsString := ' and (sf.filial,sf.valor) in ( '+
                                                                               ' select n.filial,n.serie '+
                                                                               ' from notas n join dadosfiscais df on n.dadofiscal = df.numero '+
                                                                               ' where n.dadofiscal = df.numero '+
                                                                               ' and df.cliente = ' + inttostr(dtmEmissaoNotaAvulsas.qryDadosFiscaiscliente.AsInteger) +
                                                                               ' and df.tipocliente = ' + quotedstr(dtmEmissaoNotaAvulsas.qryDadosFiscaistipocliente.AsString)+
                                                                               ' and df.dadofiscalcomplementar is null )';
  fraConsultaSerieSaida.qryConsultaSerie.MacroByName('SQLCondicao').AsString := fraConsultaSerieSaida.qryProcuraSerie.MacroByName('SQLCondicao').AsString;
end;

procedure TfrmEmissaoNotasSaidaAvulsas.CondicoesdaConsultaNotaSaida;
begin
  fraConsultanotasaida.qryConsultaNFSaida.ParamByName('filial').asinteger :=
    dtmEmissaoNotaAvulsas.qryDadosFiscaisfilialemissao.AsInteger;

  fraConsultanotasaida.qryConsultaNFSaida.ParamByName('serie').asString :=
    fraConsultaSerieSaida.qryProcuraSerieserie.AsString;

  fraConsultanotasaida.qryProcuraNFSaida.ParamByName('filial').asinteger :=
    dtmEmissaoNotaAvulsas.qryDadosFiscaisfilialemissao.AsInteger;

  fraConsultanotasaida.qryProcuraNFSaida.ParamByName('serie').asString :=
    fraConsultaSerieSaida.qryProcuraSerieserie.AsString;

  fraConsultanotasaida.qryProcuraNFSaida.macrobyname('SQL').asstring := ' and df.cliente = ' + inttostr(dtmEmissaoNotaAvulsas.qryDadosFiscaiscliente.Asinteger) +
                                                                        ' and df.tipocliente = ' + quotedstr(dtmEmissaoNotaAvulsas.qryDadosFiscaistipocliente.AsString) +
                                                                        ' and df.dadofiscalreferenciado is null ';

  fraConsultanotasaida.qryConsultaNFSaida.macrobyname('SQL').asstring := ' and df.cliente = ' + inttostr(dtmEmissaoNotaAvulsas.qryDadosFiscaiscliente.Asinteger) +
                                                                        ' and df.tipocliente = ' + quotedstr(dtmEmissaoNotaAvulsas.qryDadosFiscaistipocliente.AsString) +
                                                                        ' and df.dadofiscalreferenciado is null ';

end;

procedure TfrmEmissaoNotasSaidaAvulsas.AtribuirDadosConsultanotasaida;
begin
  if fraConsultaSerieSaida.qryProcuraSerie.ParamByName('serie').asstring <> fraConsultanotasaida.qryProcuraNFSaidaserie.AsString then
  begin
    fraConsultaSerieSaida.qryProcuraSerie.ParamByName('serie').asstring := fraConsultanotasaida.qryProcuraNFSaidaserie.AsString;
    fraConsultaSerieSaida.edfcodigo.exist;
  end;

  dtmEmissaoNotaAvulsas.qryDadosFiscaisRef.ParamByName('filial').AsInteger := fraConsultanotasaida.qryProcuraNFSaidafilial.AsInteger;
  dtmEmissaoNotaAvulsas.qryDadosFiscaisRef.ParamByName('serie').AsString := fraConsultanotasaida.qryProcuraNFSaidaserie.AsString;
  dtmEmissaoNotaAvulsas.qryDadosFiscaisRef.ParamByName('numero').AsInteger := fraConsultanotasaida.qryProcuraNFSaidanumero.AsInteger;

  if (fraConsultaSerieSaida.edfCodigo.Text <> fraConsultanotasaida.qryProcuraNFSaidaserie.AsString) or
     (fraConsultanotasaida.edfCodigo.Text <> fraConsultanotasaida.qryProcuraNFSaidanumero.AsString) then
  begin
    fraConsultaSerieSaida.edfCodigo.Text := fraConsultanotasaida.qryProcuraNFSaidaserie.AsString;
    fraConsultanotasaida.edfCodigo.Text := fraConsultanotasaida.qryProcuraNFSaidanumero.AsString;;
    fraConsultanotasaida.edfCodigo.exist;
  end;

end;

(*

