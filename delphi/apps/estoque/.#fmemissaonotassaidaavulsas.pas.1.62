procedure TfrmEmissaoNotasSaidaAvulsas.CondicoesdaConsultaMaoObraFornecedor;
begin
  fraConsultaCNOPrestador.qryProcuraMaoObraFornecedor.ParamByName('fornecedor').asinteger := dtmEmissaoNotaAvulsas.qryDadosFiscaiscliente.AsInteger;
  fraConsultaCNOPrestador.qryProcuraMaoObraFornecedor.ParamByName('tipofornecedor').asString := dtmEmissaoNotaAvulsas.qryDadosFiscaistipocliente.AsString;

  fraConsultaCNOPrestador.qryConsultaMaoObraFornecedor.ParamByName('fornecedor').asinteger := dtmEmissaoNotaAvulsas.qryDadosFiscaiscliente.AsInteger;
  fraConsultaCNOPrestador.qryConsultaMaoObraFornecedor.ParamByName('tipofornecedor').asString := dtmEmissaoNotaAvulsas.qryDadosFiscaistipocliente.AsString;
end;

