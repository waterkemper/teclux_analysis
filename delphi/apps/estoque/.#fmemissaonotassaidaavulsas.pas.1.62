//  AdvStringGrid1.FloatingFooter.ColumnCalc[4] := acMax;
//  AdvStringGrid1.RandomFill(False, 100);
  dbgEnvioReinf_2020_infoTpServ.AutoNumberRow(0);
  dbgEnvioReinf_2020_infoTpServ.AutoNumberCol(0);
//  dbgEnvioReinf_2020_infoTpServ.FloatingFooter.ColumnCalc[1]


  dbgEnvioReinf_2020_infoTpServ.Bands.PrimaryColor := TColor(strtoint(parsistema.CorZebradoRelatorio));
