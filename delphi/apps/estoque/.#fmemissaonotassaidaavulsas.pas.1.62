procedure TfrmEmissaoNotasSaidaAvulsas.rbnNormalClick(Sender: TObject);
begin
  inherited;
  dtmEmissaoNotaAvulsas.LimparDadosNotaEntradaReferenciada;
  dtmEmissaoNotaAvulsas.LimparDadosNotaSaidaReferenciada;

  fraConsultaSerieSaida.edfCodigo.Clear;
  fraConsultanotasaida.edfCodigo.Clear;

  fraConsultaSerieEntrada.edfCodigo.Clear;
  fraConsultaNotaEntrada.edfCodigo.Clear;

end;

