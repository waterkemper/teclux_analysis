procedure TfrmEmissaoNotasSaidaAvulsas.VerificarTipoNotaSaida(DefinirTipoCliente: boolean);
var
  TipoNotaSaidaAnt : TtecTipoNotaSaida;
begin
  TipoNotaSaidaAnt := dtmEmissaoNotaAvulsas.FTipoNotaSaida;
  with dtmEmissaoNotaAvulsas do
  begin
//    if Incluindo then
 //   begin
      case TipoNotaSaida of
      tnsTRANSFERENCIAICMS:
        begin
          gbxDestinatario.Caption := ansiuppercase(ctFILIAL);
          tstDestino.Caption    := '&1 - '+ctFILIAL;
          if DefinirTipoCliente and (dtmEmissaoNotaAvulsas.qryDadosFiscaiscliente.AsInteger = 0) then
            TipoProcuraCliente('L');
		  DefinirPreco(tpnCUSTOMEDIO);
        end;
      tnsTRANSFERENCIA:
        begin
          gbxDestinatario.Caption := ansiuppercase(ctFILIAL);
          tstDestino.Caption := '&1 - '+ctFILIAL;
          if DefinirTipoCliente and (dtmEmissaoNotaAvulsas.qryDadosFiscaiscliente.AsInteger = 0) then
            TipoProcuraCliente('L');
		  DefinirPreco(tpnCUSTOMEDIO);
        end;
      tnsNORMAL:
        begin
          gbxDestinatario.Caption := ansiuppercase(ctCLIENTE);
          tstDestino.Caption := FLabelCliente;
          if DefinirTipoCliente and (dtmEmissaoNotaAvulsas.qryDadosFiscaiscliente.AsInteger = 0) then
            TipoProcuraCliente('C');
        end;
      tnsDEVOLUCAOFORNECEDOR, tnsDEVOLUCAOFORNECEDORST:
        begin
          gbxDestinatario.Caption := ansiuppercase(ctFORNECEDOR);
          tstDestino.Caption := '&1 - '+ctFORNECEDOR;
          if DefinirTipoCliente and (dtmEmissaoNotaAvulsas.qryDadosFiscaiscliente.AsInteger = 0) then
            TipoProcuraCliente('F');
          DefinirPreco(tpnULTIMOCUSTO);
        end
      end;
//    end;

    if (TipoNotaSaidaAnt = tnsDEVOLUCAOFORNECEDORST) and
       (TipoNotaSaida <> tnsDEVOLUCAOFORNECEDORST) then
      dtmEmissaoNotaAvulsas.AlterarItensSubstTributaria;

    if (TipoNotaSaidaAnt <> tnsDEVOLUCAOFORNECEDORST) and
       (TipoNotaSaida = tnsDEVOLUCAOFORNECEDORST) then
      dtmEmissaoNotaAvulsas.ExisteDiferencaIncidencia;

 //   gbxBaseSubstituicao.Enabled := TipoNotaSaida = tnsDEVOLUCAOFORNECEDOR;
//    gbxICMSSubstituicacao.Enabled := gbxBaseSubstituicao.Enabled;

   { if TipoNotaSaida <> tnsNORMAL then
      ZerarOutrosValores; Gedovar 04/07/13 troca a aba impostos e zera valores}

    if MovimentarEstoque and ((qryDadosFiscaiscodigofiscal.AsInteger mod 1000) = ctNOTAFISCALVINCULADA) then
      ZerarValoresICMS;

    tstTransporte.TabVisible        := MovimentarEstoque;
    tstProdutos.TabVisible          := MovimentarEstoque or (dtmEmissaoNotaAvulsas.qryProdutos.recordcount <> 0);
  end;
end;




