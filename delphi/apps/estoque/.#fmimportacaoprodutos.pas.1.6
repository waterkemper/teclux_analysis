            qryColunasPrecosvalor.AsString            := Campos[3];
            qryColunasPrecosvalidade.AsString         := Campos[4];
            qryColunasPrecosdata.AsString             := Campos[5];
            qryColunasPrecosalteracao.AsString        := Campos[6];
            qryColunasPrecos.Post;
          finally
            FreeAndNil(Campos);
          end;
        end;
      finally
        Lista.Free;
        lblImportacao.caption :=  'IMPORTAÇÃO DAS COLUNASPREÇOS FINALIZADA!';
        lblImportacao.Refresh;
        proImportacao.Position := 0;
        proImportacao.Refresh;
      end;
    end;
  except
    on e:Exception do
    begin
      Result := False;
//      proImportacao.Font.Color := clRed;
      lblerro.caption :=  e.Message;
      lblImportacao.Refresh;
    end;
  end;
end;


