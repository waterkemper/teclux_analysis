function TfrmImportacaoProdutos.ImportarProdutos: Boolean;
var
  Lista,
  Campos: TStringList;
  i: integer;
  codigos: String;
begin
  Result := True;
  try
    if FileExists(fDirImportacao+'ItensProdutos.txt') then
    begin
      codigos := '';
      Lista := TStringList.Create;
      try
        Lista.LoadFromFile(fDirImportacao+'ItensProdutos.txt');
        InicializarProgressBar(Lista.Count);
        lblImportacao.caption := 'AGUARDE...IMPORTANDO ITENS DE PRODUTOS 1/2';
        lblImportacao.Refresh;
        for i:=0 to Lista.Count-1 do
        begin
          proImportacao.Position := i;
          Campos := Explode(';',Lista.Strings[i]);
          try
            codigos := codigos + Campos[0] + ',';
          finally
            FreeAndNil(Campos);
          end;
        end;
        Delete(codigos,length(codigos),1);
        qryEstoques.Close;
        qryEstoques.MacroByName('codigos').AsString := 'or produto in (' + codigos + ')';
        qryestoques.Open;

        qryProdutos.close;
        qryProdutos.MacroByName('codigos').AsString := 'or codigo in (' + codigos + ')';
        qryProdutos.Open;

        InicializarProgressBar(Lista.Count);
        lblImportacao.caption := 'AGUARDE...IMPORTANDO ITENS DE PRODUTOS 2/2';
        lblImportacao.Refresh;
        for i:=0 to Lista.Count-1 do
        begin
          proImportacao.Position := i;
          Campos        := Explode(';',Lista.Strings[i]);
          try

            if qryProdutos.Locate('codigo',Campos[0],[]) then
              qryProdutos.Edit
            else
            begin
              qryProdutos.append;
              qryProdutoscodigo.AsString              := Campos[0];
            end;

            qryProdutoscodigovisual.AsString          := Campos[1];
            qryProdutosdescricao.AsString             := Campos[2];
            qryProdutoscaracteristica.AsString        := Campos[3];
            //SOH ATUALIZAR SE EXISTIR O ARQUIVO DE COLUNAS DE PRECOS caso contrario nao deve mexer nos precos
            if FileExists(fDirImportacao+'Colunas.txt') then
                qryProdutospreco.AsString                 := Campos[4];

            if (Campos[5] <> qryProdutosreferencia.AsString) then
            begin
              if Campos[5] <> '' then
                qryProdutosreferencia.AsString            := Campos[5]
              else
                qryProdutosreferencia.clear;
            end;

            if Campos[6] <> '' then
              qryProdutosvalorgrade1.AsString           := Campos[6]
            else
              qryProdutosvalorgrade1.Clear;

            if Campos[7] <> '' then
              qryProdutosvalorgrade2.AsString           := Campos[7]
            else
              qryProdutosvalorgrade2.Clear;

            qryProdutosinativo.AsString               := Campos[8];
            qryProdutosforalinha.AsString             := Campos[9];
            qryProdutoscodigorecolha.AsString         := Campos[10];

            if Campos[11] <> '' then
              qryProdutosdescricaocomplementar.AsString := Campos[11]
            else
              qryProdutosdescricaocomplementar.Clear;

            if Campos[12] <> qryProdutoscaracteristicas.AsString then
            begin
              if Campos[12] <> '' then
                qryProdutoscaracteristicas.AsString       := Campos[12]
              else
                qryProdutoscaracteristicas.clear;
            end;

            if Campos[13] <> '' then
              qryProdutospalavraschave.AsString         := Campos[13]
            else
              qryProdutospalavraschave.Clear;
            qryProdutosaparecernosite.AsString        := Campos[14];
            qryProdutosforalinhal.AsString            := Campos[15];
            qryProdutosinativol.AsString              := Campos[16];
            qryProdutosdata.AsString                  := Campos[17];
            qryProdutos.Post;


            if not qryestoques.Active then
              qryEstoques.open;

            qryFiliais.First;
            while not qryFiliais.Eof do
            begin
              if not qryEstoques.Locate('produto;filial',VarArrayof([qryprodutoscodigo.asstring, qryfiliaiscodigo.asstring]),[]) then
              begin
                qryEstoques.Append;

                qryEstoquesproduto.AsString := Campos[0];
                qryEstoquesfilial.AsInteger := qryFiliaiscodigo.AsInteger;
                qryEstoquesemestoque.AsCurrency := 0;
                qryEstoquesreservado.AsCurrency := 0;
