  Lista,
  Campos: TStringList;
  i: integer;
  codigos: String;
begin
  Result := True;
  try
    if FileExists(fDirImportacao+'ColunasPrecos.txt') then
    begin
      codigos := '';
      Lista := TStringList.Create;
      try
        Lista.LoadFromFile(fDirImportacao+'ColunasPrecos.txt');
        InicializarProgressBar(Lista.Count);
        lblImportacao.caption := 'AGUARDE...IMPORTANDO COLUNASPREÇOS 1/2';
        lblImportacao.Refresh;
        for i:=0 to Lista.Count-1 do
        begin
          proImportacao.Position := i;
          Campos := Explode(';',Lista.Strings[i]);
          try
            codigos := codigos + '('+Campos[0] + ',' + Campos[1] + ',' + Campos[2] + '),';
          finally
            FreeAndNil(Campos);
          end;
        end;
        Delete(codigos,length(codigos),1);
        qryColunasPrecos.close;
        if(length(codigos)>0) then
          qryColunasPrecos.MacroByName('codigos').AsString := 'and (caracteristica,preco,coluna) in (' + codigos + ')';
        qryColunasPrecos.Open;
        InicializarProgressBar(Lista.Count);
        lblImportacao.caption := 'AGUARDE...IMPORTANDO COLUNASPREÇOS 2/2';
        lblImportacao.Refresh;
        for i:=0 to Lista.Count-1 do
        begin
          proImportacao.Position := i;
          Campos        := Explode(';',Lista.Strings[i]);
          try
            if qryColunasPrecos.Locate('caracteristica;preco;coluna', VarArrayOf([Campos[0],Campos[1],Campos[2]]),[]) then
              qryColunasPrecos.Edit
            else
            begin
              qryColunasPrecos.Append;
              qryColunasPrecoscaracteristica.AsString := Campos[0];
              qryColunasPrecospreco.AsString          := Campos[1];
              qryColunasPrecoscoluna.AsString         := Campos[2];
