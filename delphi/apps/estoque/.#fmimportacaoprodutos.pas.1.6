constructor TfrmImportacaoProdutos.Create(AOwner: TComponent);
var
  ArquivoCFG: TIniFile;
begin
  inherited;
  dtmBasico := TdtmBasico.Create(self);
  if FileExists(NomeArquivoCFG) then
  begin
    ArquivoCFG := TIniFile.Create(NomeArquivoCFG);
    try
      lblDiretorioImportacao.Caption := ArquivoCFG.ReadString(ImportacaoProdutosSection, 'DirImportaçãoProdutos'  , '');
    finally
      ArquivoCFG.Free
    end;
  end;
  qryFiliais.Open;
end;

function TfrmImportacaoProdutos.ImportarClasses: Boolean;
var
  Lista,
  Campos: TStringList;
  i: integer;
  codigos: String;
begin
  Result := True;
  try
    if FileExists(fDirImportacao+'Classes.txt') then
    begin
      codigos := '';
      Lista := TStringList.Create;
      try
        Lista.LoadFromFile(fDirImportacao+'Classes.txt');
        InicializarProgressBar(Lista.Count);
        lblImportacao.caption := 'AGUARDE...IMPORTANDO CLASSES 1/2';
        lblImportacao.Refresh;
        for i:=0 to Lista.Count-1 do
        begin
          proImportacao.Position := i;
          Campos := Explode(';',Lista.Strings[i]);
          try
            codigos := codigos + QuotedStr(Campos[0]) + ',';
          finally
            FreeAndNil(Campos);
          end;
        end;
        Delete(codigos,length(codigos),1);
        qryClasses.close;
        qryClasses.MacroByName('codigos').AsString := 'and codigo in (' + codigos + ')';
        qryClasses.Open;
        InicializarProgressBar(Lista.Count);
        lblImportacao.caption := 'AGUARDE...IMPORTANDO CLASSES 2/2';
        lblImportacao.Refresh;
        for i:=0 to Lista.Count-1 do
        begin
          proImportacao.Position := i;
          Campos        := Explode(';',Lista.Strings[i]);
          try
            if qryClasses.Locate('codigo',Campos[0],[]) then
              qryClasses.Edit
            else
            begin
              qryClasses.Append;
              qryClassescodigo.AsString      := Campos[0];
            end;
            qryClassesdescricao.AsString     := Campos[1];
            qryClassescomissao.AsString      := Campos[2];
            qryClassestipocomissao.AsString  := Campos[3];
            if Campos[4] <> '' then
              qryClassesvendanegativa.AsString := Campos[4]
            else
              qryClassesvendanegativa.Clear;
            qryClassesmultiplo.AsString      := Campos[5];
            qryClassesinativo.AsString       := Campos[6];
            qryClassesnaoreplicar.AsString   := Campos[7];
            qryClasses.Post;
          finally
            FreeAndNil(Campos);
          end;
        end;
      finally
        Lista.Free;
        lblImportacao.caption :=  'IMPORTAÇÃO DAS CLASSES FINALIZADA!';
        lblImportacao.Refresh;
        proImportacao.Position := 0;
        proImportacao.Refresh;
      end;
    end;
  except
    on e:Exception do
    begin
      result := false;
//      proImportacao.Font.Color := clRed;
      lblerro.caption :=  e.Message;
      lblImportacao.Refresh;
    end;
  end;
end;

