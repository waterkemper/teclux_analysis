procedure TfrmImportacaoProdutos.sbnImportarDadosClick(Sender: TObject);
var
  Resultado : Boolean;
  ArquivoCFG: TIniFile;

begin
  inherited;
  if lblDiretorioImportacao.Caption <> '' then
  begin
    DirImportacao := lblDiretorioImportacao.Caption;
    if not ImportarClasses then exit;
    if not ImportarGrupos then exit;
    if not ImportarUnidades then exit;
    if not ImportarIPI then exit;
    if not ImportarICMS then exit;
    if not ImportarMarcas then exit;
    if not ImportarGrades then exit;
    if not ImportarPlanosContas then exit;
    if not ImportarHistoricos then exit;
    if not ImportarEstados then exit;
    if not ImportarCidades then exit;
    if not ImportarTabelaFrete then exit;
    if not ImportarRegioes then exit;
    if not ImportarBairros then exit;
    if not ImportarGruposFornecedores then exit;
    if not ImportarConceitos then exit;
    if not importarFornecedores then exit;
    if not ImportarCaracteristicas then exit;
    if not ImportarFornecedoresProdutos then exit;
    if not ImportarPrecos then exit;
    if not ImportarColunas then exit;
    if not ImportarColunasPrecos then exit;
    if not ImportarProdutos then exit;

    try
      resultado := dtmBasico.Perpetrar([qryClasses,qryGrupos,qryUnidades,qryIPI,qryICMS,
                           qryMarcas,qryGrades,qryPlanoContas,qryHistoricos,
                           qryCaracteristicas, qryColunas, qryPrecos,qryColunasPrecos,
                           qryProdutos, qryestoques, qryEstados, qryCidades, qryTabelaFretes,
                           qryRegioes, qryBairros, qryGruposFornecedores, qryConceitos,
                           qryFornecedores, qryFornecedoresProdutos]);
     if resultado then
     begin
        qryUpdateTipFornecedor.Sql.Text := SQLTipoFornecimento;
        qryUpdateTipFornecedor.ExecSql;
        dtmBasico.Perpetrar([]);
     end;

      lblImportacao.caption := 'IMPORTAÇÃO FINALIZADA';
      lblImportacao.Refresh;
      proImportacao.Position := 0;
      proImportacao.Refresh;
      if resultado then
      begin
        if FileExists(NomeArquivoCFG) then
        begin
          ArquivoCFG := TIniFile.Create(NomeArquivoCFG);
          try
            ArquivoCFG.WriteString(ImportacaoProdutosSection, 'DirImportaçãoProdutos', lblDiretorioImportacao.Caption);
          finally
            ArquivoCFG.Free
          end;
        end;
      end;
    except
      on e:Exception do
      begin
        lblImportacao.Font.Color := clred;
        lblImportacao.caption := e.message;
        lblImportacao.Refresh;
      end;
    end;
  end
  else
    MensagemAviso('Informe o diretório de importação');
end;

