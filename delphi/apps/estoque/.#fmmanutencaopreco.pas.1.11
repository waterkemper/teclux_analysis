procedure TfrmManutencaoPreco.dbgPrecosDrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  inherited;

  if TDBGrid(Sender).DataSource.DataSet.FieldByName('alterado').AsBoolean then
    TDBGrid(Sender).Canvas.Font.Style := [fsBold]
  else
    TDBGrid(Sender).Canvas.Font.Style := [];

  TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
end;

procedure TfrmManutencaoPreco.dbgColunasPrecosDrawColumnCell(
  Sender: TObject; const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  inherited;
  if TDBGrid(Sender).DataSource.DataSet.FieldByName('alterado').AsBoolean then
    TDBGrid(Sender).Canvas.Font.Style := [fsBold]
  else
    TDBGrid(Sender).Canvas.Font.Style := [];

  TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);  
end;

procedure TfrmManutencaoPreco.ckbMarcarTodosClick(Sender: TObject);
begin
  inherited;
  dtmManutencaoPreco.MarcarRegistrosManutencaoPrecosAtualizar(ckbMarcarTodos.checked, true);
  lblExibirTotalMarcados.Caption := inttostr(dtmManutencaoPreco.QtdeMarcados);
end;

procedure TfrmManutencaoPreco.dbgPrecosKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if CtrlOn and (Key = VK_Space) then
    dtmManutencaoPreco.MarcarRegistrosManutencaoPrecosAtualizar(false, false);
  lblExibirTotalMarcados.Caption := inttostr(dtmManutencaoPreco.QtdeMarcados);

end;

