procedure TfrmManutencaoPreco.dbgPrecosKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if CtrlOn then
  begin
    if  (Key = VK_Space) then
    begin
      dtmManutencaoPreco.MarcarRegistrosManutencaoPrecosAtualizar(false, false);
      lblExibirTotalMarcados.Caption := inttostr(dtmManutencaoPreco.QtdeMarcados);
    end;

    if (key = vk_f9) then
      PopupMenuPopup(nil);

  end
  else
  if (key = vk_delete) then
  begin
    if (dbgPrecos.SelectedField = dtmManutencaoPreco.qryManutencaoPreco.fieldByName('promocao')) or
       (dbgPrecos.SelectedField = dtmManutencaoPreco.qryManutencaoPreco.fieldByName('descricaopromocao')) then
      dtmManutencaoPreco.limparPromocoes;
  end;
end;

