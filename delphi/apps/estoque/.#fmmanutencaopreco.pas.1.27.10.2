procedure TfrmManutencaoPreco.PopupMenuPopup(Sender: TObject);
begin
  inherited;
  if (dbgPrecos.SelectedField = dtmManutencaoPreco.qryManutencaoPreco.fieldByName('descpreco')) or
     (dbgPrecos.SelectedField = dtmManutencaoPreco.qryManutencaoPreco.fieldByName('preco')) then
  begin

    frmManejarListas := TfrmManejarListas.create(self);
    dtmManutencaoPreco.qryPrecos.close;
    dtmManutencaoPreco.qryPrecos.open;
    frmManejarListas.dsrLista.dataset := dtmManutencaoPreco.qryPrecos;
    frmManejarListas.showmodal;
    if frmManejarListas.modalresult = mrOk then
      dtmManutencaoPreco.AtualizarCampoPrecoTabelaPreco;
    frmManejarListas.free;  

  end
  else
  if (dbgPrecos.SelectedField = dtmManutencaoPreco.qryManutencaoPreco.fieldByName('grupo')) or
     (dbgPrecos.SelectedField = dtmManutencaoPreco.qryManutencaoPreco.fieldByName('descricaogrupo')) then
  begin

    fraConsultaGrupoProdutos.CtrlOn := True;
    fraConsultaGrupoProdutos.InternoPesquisar('Grupo de Produtos');
    dbgPrecos.SetFocus;
    dbgPrecos.SelectedField := dtmManutencaoPreco.qryManutencaoPreco.fieldbyname('grupo');

  end
  else
  if (dbgPrecos.SelectedField = dtmManutencaoPreco.qryManutencaoPreco.fieldByName('Promocao')) or
     (dbgPrecos.SelectedField = dtmManutencaoPreco.qryManutencaoPreco.fieldByName('descricaoPromocao')) then
  begin

    fraConsultaPromocaoProdutos.CtrlOn := True;
    fraConsultaPromocaoProdutos.InternoPesquisar('Promoção de Produtos');
    dbgPrecos.SetFocus;
    dbgPrecos.SelectedField := dtmManutencaoPreco.qryManutencaoPreco.fieldbyname('Promocao');

  end
  else
  if (dbgPrecos.SelectedField = dtmManutencaoPreco.qryManutencaoPreco.fieldByName('classe')) or
     (dbgPrecos.SelectedField = dtmManutencaoPreco.qryManutencaoPreco.fieldByName('descricaoclasse')) then
  begin

    fraConsultaclasseProdutos.CtrlOn := True;
    fraConsultaclasseProdutos.InternoPesquisar('Classe de Produtos');
    dbgPrecos.SetFocus;
    dbgPrecos.SelectedField := dtmManutencaoPreco.qryManutencaoPreco.fieldbyname('classe');

  end
  else
  if (dbgPrecos.SelectedField = dtmManutencaoPreco.qryManutencaoPreco.fieldByName('marca')) or
     (dbgPrecos.SelectedField = dtmManutencaoPreco.qryManutencaoPreco.fieldByName('descricaomarca')) then
  begin

    fraConsultamarcaProdutos.CtrlOn := True;
    fraConsultamarcaProdutos.InternoPesquisar('Marca de Produtos');
    dbgPrecos.SetFocus;
    dbgPrecos.SelectedField := dtmManutencaoPreco.qryManutencaoPreco.fieldbyname('marca');

  end;

end;

