function TfrmManutencaoPreco.PosicaodaColuna(titulo: String): integer;
var
  j : integer;
begin
  result := 0;
  for j:= 0 to dbgColunasPrecos.columns.count-1 do
  begin
    if dbgColunasPrecos.columns[j].visible and
       (uppercase(dbgColunasPrecos.columns[j].title.caption) = uppercase(titulo)) then
    begin
      result := j;
      break;
    end;
  end;
end;

