procedure TfrmManutencaoPreco.sbnGerarClick(Sender: TObject);
begin
  AtualizandoPrecos := true;
  if ckbPrecosDiferenciados.Checked and (edfFilial.Text = '') then begin
    MensagemAviso('O campo Filial deve ser informado.');
    edfFilial.SetFocus;
  end
  else begin
    with dtmManutencaoPreco do begin
      if ValidarCampos then begin
        SelecaoProdutos  := rgbProdutos.ItemIndex;
        SomenteComEstoque := ckbSomentecomEstoque.checked;
        Precos    := rgbPrecos.ItemIndex;
        Ordenacao := rgbOrdenacao.ItemIndex;
        PrecosDiferenciados:= ckbPrecosDiferenciados.Checked;
        DataInicial         := edtDataInicial.Text;
        DataFinal           := edtDataFinal.Text;
        DataMovtoInicial    := edtIntervaloInicial.Text;
        DataMovtoFinal      := edtIntervaloFinal.Text;
        DataNotaInicial     := edtIntervaloNotaInicial.Text;
        DataNotaFinal       := edtIntervaloNotaFinal.Text;
        ListaCodigosPromocao      := fraMultiplaSelecaoAleatoria1.fraSelecaoaleatoriaPromocoes.ListaCondicional;

//        fraConsultaPromocao.edfCodigo.Text;

        SomenteComPromocoes := ckbSomenteComPromocoes.checked;

        MontarSQLManutencaoPreco(fraMultiplaSelecaoAleatoria1.fraSelecaoAleatoriaprodutos.ListaCondicional,
                                 fraMultiplaSelecaoAleatoria1.fraSelecaoAleatoriaItemdeProdutos.ListaCondicional,
                                 fraMultiplaSelecaoAleatoria1.fraSelecaoAleatoriamarcasProdutos.ListaCondicional,
                                 fraMultiplaSelecaoAleatoria1.fraSelecaoaleatoriagruposprodutos.ListaCondicional,
                                 fraMultiplaSelecaoAleatoria1.fraSelecaoaleatoriaclassesprodutos.ListaCondicional);
                                 
        if NumeroRegistro > 0 then
        begin
//          if edfColuna.Text <> '' then begin
//          dtmManutencaoPreco.PreencherComboBox(cmbExcluir);
//            cmbExcluir.Items.Clear;
//            cmbExcluir.Items.Add('Nenhuma');
//            cmbExcluir.Items.Add(dtmManutencaoPreco.DescricaoColuna);
//          end
//          else

          dtmManutencaoPreco.PreencherComboBox(cmbOrigem);
          dtmManutencaoPreco.PreencherComboBox(cmbDestino);
          dtmManutencaoPreco.PreencherComboBox(cmbExcluir);
          dtmManutencaoPreco.PreencherComboBox(cmbDestino);
          dtmManutencaoPreco.PreencherComboBox(cmbColunaPromocao, true);

          CorColunasPadrao;
          MontarTituloColunas;
          lblExibirTotal.Caption:= IntToStr(NumeroRegistro);
          lblExibirTotalMarcados.Caption:= IntToStr(NumeroRegistro);
          dtmManutencaoPreco.QtdeMarcados := NumeroRegistro;
          pgcManutencaoPreco.ActivePageIndex:= 1;
          dbgColunasPrecos.SetFocus;
          dbgColunasPrecos.SelectedIndex:= 0;
        end
        else begin
          lblExibirTotal.Caption:= '0';
          lblExibirTotalMarcados.Caption:= '0';
          dtmManutencaoPreco.QtdeMarcados := 0;

          dtmManutencaoPreco.Fecha(ctManutencaoPreco);
          MensagemAviso(Format(ctNENHUMREGISTROSELECIONADO,['registro']));
          pgcManutencaoPreco.ActivePageIndex:= 0;
        end;
      end;
    end;
  end;
  AtualizandoPrecos := false;
end;


function TfrmManutencaoPreco.TabelaDePesquisa: TZDataSet;
begin
  with dtmManutencaoPreco do begin
    case TipoPesquisa of
              pesCOLUNAS : Result := ConsultarColunas;
      pesTIPOSMOVIMENTOS : Result := qryConsultaTipoMovimentos;
   pesSERIESFORNECEDORES : Result := qryConsultaSerieNfEntrada;
                pesNOTAS : Result := qryConsultaNfEntrada;
              pesFILIAIS : if not dtmManutencaoPreco.Fornecedores then
                             Result := ConsultaFiliais
                           else
                             Result := qryConsultaFiliaisMovimentos;
      else                 Result := nil;
    end;
  end;
end;

function TfrmManutencaoPreco.ValidarCampos: Boolean;
begin
  Result:= OperadorTernario(edfColuna.Text  <> '', edfColuna.Exist,  True) and
           OperadorTernario(edfFilial.Text  <> '', edfFilial.Exist,  True);
end;


