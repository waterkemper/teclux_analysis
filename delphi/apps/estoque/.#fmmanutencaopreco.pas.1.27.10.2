  inherited;
  if (cmbExcluir.ItemIndex > 0) then begin
    if MensagemConfirmacao(Format(ctEXCLUIRVALORESCOLUNA,[cmbExcluir.Items[cmbExcluir.itemIndex]])) = smbOk then
