procedure TfrmManutencaoPreco.sbnAplicarClick(Sender: TObject);
begin
  inherited;
  if (cmbOrigem.itemIndex = 0) then
    MensagemAviso('Nenhuma COLUNA ORIGEM foi definida.')
  else begin
    if edtValidade.DataValida then begin
      if MensagemConfirmacao('Confirma a alteração dos valores (preço/validade) da coluna ' +
                              cmbOrigem.Items[cmbOrigem.itemIndex] + '?') = smbOk then
        dtmManutencaoPreco.AplicarPercentualEValidade(cmbOrigem.itemIndex, edtPercentual.Text, edtValidade.Text)
    end
    else edtValidade.SetFocus;
  end;
end;


