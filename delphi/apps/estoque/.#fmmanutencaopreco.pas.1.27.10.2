function TfrmManutencaoPreco.ExisteInformacao(Parametro: Integer;NomeCampo: String; Value: Variant): Boolean;
begin
  with dtmManutencaoPreco do begin
    case TipoPesquisa of
              pesCOLUNAS : Result := ExisteColunas(NomeCampo, Value);
      pesTIPOSMOVIMENTOS : Result := ExisteTipoMovto(NomeCampo, Value);
   pesSERIESFORNECEDORES : Result := ExisteSerieNota(NomeCampo, Value);
                pesNOTAS : Result := ExisteNota(NomeCampo, Value);
              pesFILIAIS : if not dtmManutencaoPreco.Fornecedores then
                             Result := ExisteFiliais(NomeCampo, Value)
                           else
                             Result:= ExisteFilialFornec(NomeCampo, Value);
      else                 Result := False;
    end;
  end;
end;

function TfrmManutencaoPreco.InternoPesquisar(Titulo:String): Integer;
begin
  Result:= mrNone;
  if ActiveControl is TtecFindCustom then begin
    if CtrlOn then
    begin
      if (ActiveControl = edfFilial) and not edfFilial.ReadOnly then begin
        TipoPesquisa:= pesFILIAIS;
        Titulo      := 'Filiais';
      end
      else if (ActiveControl = edfFilialMovto) and not edfFilialMovto.ReadOnly then begin
        TipoPesquisa:= pesFILIAIS;
        Titulo      := 'Filiais';
      end
      else if (ActiveControl = edfTipoMovimento) and not edfTipoMovimento.ReadOnly then begin
        TipoPesquisa:= pesTIPOSMOVIMENTOS;
        Titulo      := 'Tipos de Movimentos';
      end
      else if (ActiveControl = edfSerie) and not edfSerie.ReadOnly then begin
        TipoPesquisa:= pesSERIESFORNECEDORES;
        Titulo      := 'Séries';
      end
      else if (ActiveControl = edfNota) and not edfNota.ReadOnly then begin
        TipoPesquisa:= pesNOTAS;
        Titulo      := 'Notas de Entrada';
      end
      else TipoPesquisa:= pesNENHUMA;

      if TipoPesquisa <> pesNENHUMA then begin
        with dtmManutencaoPreco do begin
          AbreTabelaPesquisa(TipoPesquisa);
          Result := inherited InternoPesquisar(Titulo);
          if Result = mrOK then
            Selecionar(TipoPesquisa);
          FechaTabelaPesquisa(TipoPesquisa);
        end;
      end;
    end;
  end;
end;

function TfrmManutencaoPreco.JanelaPesquisa: TfrmConsultaBasica;
begin
  Result := TfrmConsultaPorCampo.Create(nil);
  if (TipoPesquisa = pesCARACTERISTICAS) then
       TfrmConsultaPorCampo(Result).ConsultaInterativa := False
  else TfrmConsultaPorCampo(Result).ConsultaInterativa := True;

  TfrmConsultaPorCampo(Result).UsarParametrosDaTabela:= False;
end;

procedure TfrmManutencaoPreco.KeyDown(var Key: Word; Shift: TShiftState);
var
  Ok: Boolean;
begin
  case Key of
    VK_Escape : begin
                 Ok:= not sbnAlterar.Enabled;
                 if not Ok then
                   Ok:= MensagemConfirmacao(ctINFORMACOESSERAOPERDIDAS) = smbOk;
                 if Ok then begin
                   LimpaTabelas;
                   dtmManutencaoPreco.Editando:= False;
                   edtValidade.Clear;
                   edtPercentual.Clear;
                   cmbOrigem.ItemIndex := 0;
                   cmbOrigemChange(nil);

                   cmbDestino.ItemIndex:= 0;
                   cmbDestinoChange(nil);

                   cmbExcluir.ItemIndex:= 0;
                   cmbExcluirSelect(nil);
                 end
                 else
                   dbgPrecos.SetFocus;
                end;

    VK_F6 : if (Shift = []) and sbnGerar.Enabled then sbnGerar.Click;
    VK_F7 : if (Shift = []) and sbnCopiar.Enabled then sbnCopiar.Click;
    VK_F5 : if (Shift = []) and sbnAlterar.Enabled then sbnAlterar.Click;

    vk_delete :
    begin
      if (dbgPrecos.SelectedField = dtmManutencaoPreco.qryManutencaoPreco.fieldByName('promocao')) or
         (dbgPrecos.SelectedField = dtmManutencaoPreco.qryManutencaoPreco.fieldByName('descricaopromocao')) then
        dtmManutencaoPreco.limparPromocoes;
    end;
  end;
  inherited;
end;

