procedure TfrmManutencaoPreco.CorColunasPadrao;
var
  i, Ind, IndOP, IndDP, Col: Integer;
begin

  //coluna normal

  for i := 1 to cmbOrigem.Items.Count do
  begin
    Ind := posicaodacoluna(cmbOrigem.Items[i]);

    if ind <> 0 then
    begin
      if (i = 1) then // padrao
      begin
       dbgColunasPrecos.Columns[ind].Color   := $00E5E8E2;
       dbgColunasPrecos.Columns[ind+1].Color   := $00E5E8E2;
       dbgColunasPrecos.Columns[ind+2].Color   := $00E5E8E2;
      end
      else
      if (cmbColunaPromocao.ItemIndex > 0) and (cmbColunaPromocao.ItemIndex = i) then  //promoção
      begin
        dbgColunasPrecos.Columns[Ind].Color   := $00EAECE8;
        dbgColunasPrecos.Columns[Ind+1].Color := $00EAECE8;
        dbgColunasPrecos.Columns[Ind+2].Color := $00EAECE8;
      end
      else
      begin
        dbgColunasPrecos.Columns[Ind].Color   := clWindow;
        dbgColunasPrecos.Columns[Ind+1].Color := clWindow;
        dbgColunasPrecos.Columns[Ind+2].Color := clWindow;
      end;
    end;
  end;


  if dtmManutencaoPreco.ColunaPromocao <> cmbColunaPromocao.ItemIndex then
    dtmManutencaoPreco.ColunaPromocao := cmbColunaPromocao.ItemIndex;

end;

