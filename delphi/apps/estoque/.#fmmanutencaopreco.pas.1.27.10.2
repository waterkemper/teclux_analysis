procedure TfrmManutencaoPreco.actEventoUpdate(Sender: TObject);
begin
  inherited;
  gbxCopiar.Enabled  := (dtmManutencaoPreco.NumeroRegistro > 0) and
                        (dbgPrecos.Columns.Count > 5)           and
//                        (edfColuna.Text = '')                   and
                        (cmbExcluir.ItemIndex = 0);
  gbxPercentualValidade.Enabled:= gbxCopiar.Enabled;
//     ((edfColuna.Text <> '') or gbxCopiar.Enabled) and (cmbExcluir.itemIndex = 0);
  gbxExcluir.Enabled := (dtmManutencaoPreco.NumeroRegistro > 0) and (dbgPrecos.Columns.Count > 5) and
                        (cmbOrigem.itemindex = 0) and (cmbdestino.ItemIndex = 0);

  sbnCopiar.Enabled  := (cmbOrigem.itemIndex > 0)  and
                        (cmbDestino.itemIndex > 0) and
                        (pgcManutencaoPreco.ActivePageIndex = 1);

  sbnAlterar.Enabled := (dtmManutencaoPreco.Editando or (cmbExcluir.itemIndex > 0)) and
                        (pgcManutencaoPreco.ActivePageIndex = 1);
  sbnAplicar.Enabled := (dtmManutencaoPreco.NumeroRegistro > 0) and
//                        (edfColuna.Text <> '')                  and
                        ((edtPercentual.Text <> '') or (edtValidade.Text <> ''));
  sbnGerar.Enabled   := (pgcManutencaoPreco.ActivePageIndex = 0);

  gbxColunaPromocao.Enabled := (cmbExcluir.ItemIndex = 0) and
                               (cmbOrigem.itemindex = 0) and
                               (cmbdestino.ItemIndex = 0);

  sbnConsultaVendas.enabled := (dtmManutencaoPreco.NumeroRegistro > 0);
  sbnProdutos.enabled := sbnConsultaVendas.enabled;

  if dtmManutencaoPreco.qryManutencaoPreco.active then
    if (dbgPrecos.SelectedField = dtmManutencaoPreco.qryManutencaoPreco.fieldByName('descpreco')) or
       (dbgPrecos.SelectedField = dtmManutencaoPreco.qryManutencaoPreco.fieldByName('preco')) or
       (dbgPrecos.SelectedField = dtmManutencaoPreco.qryManutencaoPreco.fieldByName('grupo')) or
       (dbgPrecos.SelectedField = dtmManutencaoPreco.qryManutencaoPreco.fieldByName('descricaogrupo')) or
       (dbgPrecos.SelectedField = dtmManutencaoPreco.qryManutencaoPreco.fieldByName('promocao')) or
       (dbgPrecos.SelectedField = dtmManutencaoPreco.qryManutencaoPreco.fieldByName('descricaopromocao')) or
       (dbgPrecos.SelectedField = dtmManutencaoPreco.qryManutencaoPreco.fieldByName('classe')) or
       (dbgPrecos.SelectedField = dtmManutencaoPreco.qryManutencaoPreco.fieldByName('descricaoclasse')) or
       (dbgPrecos.SelectedField = dtmManutencaoPreco.qryManutencaoPreco.fieldByName('marca')) or
       (dbgPrecos.SelectedField = dtmManutencaoPreco.qryManutencaoPreco.fieldByName('descricaomarca')) then
      lblLegenda.Caption := '[Ctrl Barra de Espaço] Marcar/Desmarcar - [Ctrl F9 ou Clique Botão Direito] Janela de Pesquisa'
    else
      lblLegenda.Caption := '[Ctrl Barra de Espaço] Marcar/Desmarcar';
end;

procedure TfrmManutencaoPreco.cmbDestinoChange(Sender: TObject);
var
  Ind: Integer;
begin
  inherited;

  if (cmbOrigem.ItemIndex <> cmbDestino.itemIndex) or (cmbOrigem.itemIndex = 0) then
  begin
    Ind := PosicaoDacoluna(cmbDestino.Items[cmbDestino.itemindex]);

    if ind <> 0 then
    begin
      dbgColunasPrecos.Columns[Ind].Color := $D0FFFF;
      dbgColunasPrecos.Columns[Ind+1].Color := $D0FFFF;
      dbgColunasPrecos.Columns[Ind+2].Color := $D0FFFF;

      dtmmanutencaoPreco.CampoColunaDestino := dbgColunasPrecos.Columns[Ind].fieldname;

      cmbExcluir.ItemIndex:= 0;
      cmbExcluirSelect(nil);

    end;

    if FColunaDestino <> cmbDestino.ItemIndex then
    begin
      Ind := PosicaoDacoluna(cmbDestino.Items[FColunaDestino]);
      if INd <> 0 then
      begin
        if FColunaDestino = 1 then    //padrao
        begin
         dbgColunasPrecos.Columns[ind].Color   := $00E5E8E2;
         dbgColunasPrecos.Columns[ind+1].Color   := $00E5E8E2;
         dbgColunasPrecos.Columns[ind+2].Color   := $00E5E8E2;
        end
        else
        if FColunaDestino = dtmManutencaoPreco.ColunaPromocao then    //promocao
        begin
          dbgColunasPrecos.Columns[Ind].Color   := $00EAECE8;
          dbgColunasPrecos.Columns[Ind+1].Color := $00EAECE8;
          dbgColunasPrecos.Columns[Ind+2].Color := $00EAECE8;
        end
        else
        begin
          dbgColunasPrecos.Columns[Ind].Color := clWindow;
          dbgColunasPrecos.Columns[Ind+1].Color := clWindow;
          dbgColunasPrecos.Columns[Ind+2].Color :=  clWindow;
        end;
      end;
      FColunaDestino := cmbDestino.ItemIndex;
    end;

  end
  else
  begin
    cmbDestino.ItemIndex := 0;
    cmbDestinoChange(nil);
  end;



end;

procedure TfrmManutencaoPreco.cmbExcluirSelect(Sender: TObject);
var
  Ind: Integer;
begin
  inherited;

  Ind := PosicaoDacoluna(cmbExcluir.Items[cmbExcluir.itemindex]);

  if ind <> 0 then
  begin
    dbgColunasPrecos.Columns[Ind].Color := $7D7DFF;
    dbgColunasPrecos.Columns[Ind+1].Color := $7D7DFF;
    dbgColunasPrecos.Columns[Ind+2].Color := $7D7DFF;
    dtmmanutencaoPreco.CampoColunaExcluir := dbgColunasPrecos.Columns[Ind].fieldname;

    cmbOrigem.ItemIndex := 0;
    cmbOrigemChange(nil);

    cmbDestino.ItemIndex:= 0;
    cmbDestinoChange(nil);

  end;

  if FColunaExcluir <> cmbExcluir.ItemIndex then
  begin
    Ind := PosicaoDacoluna(cmbExcluir.Items[FColunaExcluir]);
    if INd <> 0 then
    begin
      if FColunaExcluir = 1 then    //padrao
      begin
       dbgColunasPrecos.Columns[ind].Color   := $00E5E8E2;
       dbgColunasPrecos.Columns[ind+1].Color   := $00E5E8E2;
       dbgColunasPrecos.Columns[ind+2].Color   := $00E5E8E2;
      end
      else
      if FColunaExcluir = dtmManutencaoPreco.ColunaPromocao then    //promocao
      begin
        dbgColunasPrecos.Columns[Ind].Color   := $00EAECE8;
        dbgColunasPrecos.Columns[Ind+1].Color := $00EAECE8;
        dbgColunasPrecos.Columns[Ind+2].Color := $00EAECE8;
      end
      else
      begin
        dbgColunasPrecos.Columns[Ind].Color := clWindow;
        dbgColunasPrecos.Columns[Ind+1].Color := clWindow;
        dbgColunasPrecos.Columns[Ind+2].Color :=  clWindow;
      end;
    end;
    FColunaExcluir := cmbExcluir.ItemIndex;
  end;




end;

