function TdtmConsultaProgramacaoEntregaNfe.PosicionarRegistro(entrega,
  filial, nomefornecedor, serie, qvol,
  raiz_nomefornecedortransporte: String): Boolean;
begin
  result := False;
  if (filial<>'') then
  begin
    if raiz_nomefornecedortransporte='' then
    begin
      if qryProgramacaoEntregaNfe.Locate(
         'entrega;filial;nomefornecedor;serie;qvol;raiz_nomefornecedortransporte',
          VarArrayOf([strtodate(entrega),strtoint(filial),nomefornecedor,serie,StrToInt64(qvol),null]), []) then
       result := true;
    end
    else
    if qryProgramacaoEntregaNfe.Locate(
       'entrega;filial;nomefornecedor;serie;qvol;raiz_nomefornecedortransporte',
        VarArrayOf([strtodate(entrega),strtoint(filial),nomefornecedor,serie,StrToInt64(qvol),raiz_nomefornecedortransporte]), []) then
     result := true;
  end;

 if not result then
 begin
  qryPedidos.close;
  qryPedidos.MacroByName('Lista_de_Pedidos').asString := '0';
  qryPedidos.open;
 end;

end;

function TdtmConsultaProgramacaoEntregaNfe.PosicionarRegistroPedidos(
  Pedido: String): Boolean;
begin
  result := False;
  if (Pedido<>'') then
  begin
    if qryPedidos.Locate('numero', pedido, []) then
     result := true;
  end;

end;

procedure TdtmConsultaProgramacaoEntregaNfe.qryProgramacaoEntregaNfeAfterScroll(
  DataSet: TDataSet);
begin
  inherited;
  if qryProgramacaoEntregaNfe.recordcount<> 0 then
  begin

    qryPedidos.close;
    if qryProgramacaoEntregaNfelista_pedidos.asString<>'' then
      qryPedidos.MacroByName('Lista_de_Pedidos').asString := qryProgramacaoEntregaNfelista_pedidos.asString
    else
      qryPedidos.MacroByName('Lista_de_Pedidos').asString := '0';
    qryPedidos.open;
  end;  

end;

