function TdtmConsultaProgramacaoEntregaNfe.GerarConsulta: Boolean;
begin
  qryProgramacaoEntregaNfe.AfterScroll := nil;

  qryProgramacaoEntregaNfe.close;
  
  if (DataInicial<>'') and (datafinal<>'') then
    qryProgramacaoEntregaNfe.MacroByName('IntervaloEntregas').asString :=
    format(' and pe.entrega between %s and %s',
      [quotedstr(FormatDateTime('yyyy-MM-dd',strtodate(datainicial))),
       quotedstr(FormatDateTime('yyyy-MM-dd',strtodate(datafinal)))])
  else
  if (DataInicial<>'') and (datafinal='') then
    qryProgramacaoEntregaNfe.MacroByName('IntervaloEntregas').asString :=
    format(' and pe.entrega >= %s ',
      [quotedstr(FormatDateTime('yyyy-MM-dd',strtodate(datainicial)))])
  else
  if (DataInicial='') and (datafinal<>'') then
    qryProgramacaoEntregaNfe.MacroByName('IntervaloEntregas').asString :=
    format(' and pe.entrega <= %s ',
      [quotedstr(FormatDateTime('yyyy-MM-dd',strtodate(datafinal)))])
  else
  if (DataInicial='') and (datafinal='') then
    qryProgramacaoEntregaNfe.MacroByName('IntervaloEntregas').asString := '';


  qryProgramacaoEntregaNfe.open;


  result := qryProgramacaoEntregaNfe.recordcount <> 0;

  if result then
  begin
    qryProgramacaoEntregaNfe.first;
    qryProgramacaoEntregaNfe.AfterScroll := qryProgramacaoEntregaNfeAfterScroll;
  end;



end;

