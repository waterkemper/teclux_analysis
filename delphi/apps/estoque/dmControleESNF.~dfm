    Sql.Strings = (
      ';'
      'select selecao.*,'
      ''
      '     RecebidodoFornecedor_1912 -'
      #9'   DevolvidoParaoFornecedor_5913 as SaldoFornecedor,'
      
        '     cast(:SALDO_A_DEVOLVER_PARA_O_CLIENTE as boolean) as SALDO_' +
        'A_DEVOLVER_PARA_O_CLIENTE'
      ''
      ''
      'from'
      '('
      '/* ENTRADA PARA DEMONSTRA'#199#195'O DO PRODUTO DO FORNECEDOR 1912 */'
      
        'select np1.fornecedor as cliente, np1.tipofornecedor as tipoclie' +
        'nte, vf.nome as nomecliente,'
      
        '       np1.data, np1.datahoraemissao, np1.fornecedor, np1.tipofo' +
        'rnecedor, cast((select f.nome from filiais f where f.codigo = np' +
        '1.filial) as varchar(60)) as localizacao,'
      
        '       case when coalesce(/*np1.permitirimprimir*/ false, false)' +
        ' then np1.filial else np1.fornecedor end as emitente,'
      
        '       case when coalesce(/*np1.permitirimprimir*/ false, false)' +
        ' then cast('#39'L'#39' as char(1)) else np1.tipofornecedor end as tipoem' +
        'itente,'
      '       np1.serie, np1.numero,'
      
        '       pnp1.produto, p.codigovisual as produtovisual, pnp1.numer' +
        'o as numeroproduto, pnp1.codigonota as codigonotaoriginal, pnp1.' +
        'numero as numeroprodutooriginal, p.descricao as descricaoproduto' +
        ', pnp1.quantidade,'
      '       pnp1.quantidade as RecebidodoFornecedor_1912,'
      
        '       cast(0 as numeric(11,3)) as DevolvidoParaoFornecedor_5913' +
        ','
      '       cast('#39'E'#39' as char(1)) as operacao, pnp1.codigofiscal'
      ''
      'from ((notaspag np1'
      '      join (produtosnotaspag pnp1'
      '            join produtos p'
      '            on pnp1.produto = p.codigo)'
      '      on np1.codigo = pnp1.codigonota)'
      ''
      '      join vfornecedores vf'
      '      on np1.fornecedor = vf.codigo'
      '      and np1.tipofornecedor = vf.tipo)'
      ''
      'where np1.data between :datainicial and :datafinal'
      
        ' and pnp1.natureza in (%ListadeNaturezas_EntradaParaDemonstracao' +
        '_1912)'
      ' and np1.situacao = '#39'N'#39
      ''
      ''
      'union ALL'
      ''
      '/* RETORNO DE BEM REMETIDO PARA DEMONSTRACAO 5913 */'
      
        'select np1.fornecedor as cliente, np1.tipofornecedor as tipoclie' +
        'nte, vf.nome as nomecliente,'
      
        ' df1.data, df1.datahoraemissao, df1.cliente as fornecedor, df1.t' +
        'ipocliente as tipofornecedor,'
      
        ' cast((select vf2.nome from vfornecedores vf2 where vf2.codigo =' +
        ' df1.cliente and vf2.tipo = df1.tipocliente) as varchar(60)) as ' +
        'localizacao,'
      ' n.filial as emitente, cast('#39'L'#39' as char(1)) as tipoemitente,'
      ' n.serie, n.numero,'
      
        ' pdf1.produto, p.codigovisual as produtovisual, pdf1.numero as n' +
        'umeroproduto, pdf1.codigonotaoriginal, pdf1.numeroprodutoorigina' +
        'l, p.descricao as descricaoproduto, pdf1.quantidade,'
      ' pnp1.quantidade as RecebidodoFornecedor_1912,'
      ''
      
        ' /* somatorio das quantidades da nota de devolucao p/ fornecedor' +
        ' relaciondaa nota de demonst do proprio emintente (fornecedor) *' +
        '/'
      ' coalesce((select sum(pdf_1.quantidade)'
      ' from dadosfiscais df_1'
      ' join produtosdadosfiscais pdf_1'
      ' on df_1.numero = pdf_1.dadofiscal'
      ' where df_1.data between :DataInicial and df1.data'
      ' and df_1.datahoraemissao <= df1.datahoraemissao'
      
        ' and pdf_1.natureza in (%ListadeNaturezas_RetornoRecebidoDemonst' +
        'racaoFornecedor_5913)'
      ' and df_1.situacao = '#39'N'#39
      ''
      ' and pdf_1.codigonota = pnp1.codigonota'
      ' and pdf_1.numeroprodutotabela = pnp1.numero'
      
        ' and pdf_1.produto = pnp1.produto),0) as DevolvidoParaoFornecedo' +
        'r_5913,'
      ''
      ' cast('#39'S'#39' as char(1)) as operacao, pdf1.codigofiscal'
      ''
      'from ((dadosfiscais df1'
      '       join ((produtosdadosfiscais pdf1'
      '              join produtos p'
      '              on pdf1.produto = p.codigo)'
      ''
      '              join (produtosnotaspag pnp1'
      '                    join (notaspag np1'
      '                          join vfornecedores vf'
      '                          on np1.fornecedor = vf.codigo'
      '                          and np1.tipofornecedor = vf.tipo)'
      ''
      '                    on pnp1.codigonota = np1.codigo)'
      ''
      '              on pdf1.codigonotaoriginal = pnp1.codigonota'
      '              and pdf1.numeroprodutooriginal = pnp1.numero'
      '              and pdf1.produtooriginal = pnp1.produto)'
      ''
      '       on df1.numero = pdf1.dadofiscal)'
      ''
      '      join notas n'
      '      on df1.numero = n.dadofiscal)'
      ''
      'where df1.data between :DataInicial and :DataFinal'
      
        ' and pdf1.natureza in (%ListadeNaturezas_RetornoRecebidoDemonstr' +
        'acaoFornecedor_5913)'
      ' and df1.situacao = '#39'N'#39
      ''
      ' and np1.data between :DataInicial and :DataFinal'
      
        ' and pnp1.natureza in (%ListadeNaturezas_EntradaParaDemonstracao' +
        '_1912)'
      ' and np1.situacao = '#39'N'#39
      ''
      ''
      ') as selecao'
      
        'order by nomecliente, cliente, tipocliente, produtovisual, produ' +
        'to, numeroprodutooriginal, codigonotaoriginal, data, datahoraemi' +
        'ssao'
      ''
      ''
      '/*'
