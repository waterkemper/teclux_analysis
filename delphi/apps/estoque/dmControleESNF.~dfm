      ''
      '           on df1.numero = pdf1.dadofiscal)'
      ''
      '           join notas n'
      '           on df1.numero = n.dadofiscal)'
      ''
      '           join filiais f'
      '           on df1.filialemissao = f.codigo)'
      ''
      '           join vfornecedores vf'
      '           on df1.cliente = vf.codigo'
      '           and df1.tipocliente = vf.tipo)'
      ''
      '  where df1.data between :DataInicial and :DataFinal'
      
        '    and pdf1.natureza in (%ListadeNaturezas_SaidaConsignacao_591' +
        '7)'
      '    and df1.situacao = '#39'N'#39
      ''
      ''
      '   union all'
      ''
      '  /* RETORNO REMESSA CONSIGNA'#199#195'O DA EMPRESA 1918 */'
      ''
