        '         pdf1.produto, p.codigovisual as produtovisual, pdf1.num' +
        'ero as numeroproduto, pdf1.dadofiscal, pdf1.numero as numeroprod' +
        'utotabela, p.descricao as descricaoproduto, pdf1.quantidade,'
      '         pdf1.quantidade as EnviadoCliente_5917,'
      
        '         cast(0 as numeric(11,3)) as RecebidoRetornoConsignacao_' +
        '1918,'
      '         cast('#39'S'#39' as char(1)) as operacao, pdf1.codigofiscal'
      ''
      '  from ((((dadosfiscais df1'
      '           join (produtosdadosfiscais pdf1'
      '                 join produtos p'
