function TdtmManutencaoProdutos.GravarAlteracoesAtributos: Boolean;
var
  vListaItem, vListaProduto,
  vNomedoCampoProduto,
  vNomedoCampoCaracteristica : String;
  i: integer;
  vAtributos_valores : String;
begin

// {"Material":"PLÁSTICO DURO","Tamanho da Tela":"32","Capacidade de armazenamento":"128","teste BOOLEAN":"true","TESTE DATA":"02/12/2021"}
// {"Material":"PLÁSTICO DURO","Tamanho da Tela":"42","Capacidade de armazenamento":"256","teste BOOLEAN":null,"TESTE DATA":"23/12/2021"}

  try

    qryManutencaoAtributos.GuardarRegistroAtual(true);

    qryAtualizarProdutosJSON.close;
    vListaItem := RetornarLista(qryManutencaoAtributos, qryManutencaoAtributos.FieldByName('Produto'), qryManutencaoAtributos.FieldByName('selecionar'), false);
    qryAtualizarProdutosJSON.macrobyname('ListaProdutos').asString := vListaItem;
    qryAtualizarProdutosJSON.open;

    qryManutencaoAtributos.first;

    while not qryManutencaoAtributos.eof do
    begin

      if qryManutencaoAtributos.FieldByName('selecionar').asBoolean then
      begin

        result := qryManutencaoAtributos.CheckRequiredFields(false, false, true);

        if result then
        begin

          vAtributos_valores := qryManutencaoAtributos.ToJsonObject(qryManutencaoAtributos.fieldbyname('selecionar').index+1, false);
          if qryAtualizarProdutosJSON.locate('codigovisual', qryManutencaoAtributos.fieldbyname('Produto').asString, []) then
          begin
            qryAtualizarProdutosJSON.edit;
            qryAtualizarProdutosJSONatributos.asinteger := qryListaAtributos.parambyname('atributo').asinteger;
            qryAtualizarProdutosJSONatributos_valores.asString := vAtributos_valores;
            qryAtualizarProdutosJSON.post;

            {
            vAtributos_valores := '';
            for i := qryManutencaoAtributos.fieldbyname('selecionar').index+1 to qryManutencaoAtributos.fieldcount -1 do
            begin
              if PosicionarListaAtributos('nome',  qryManutencaoAtributos.fields[i].Fieldname) then
              begin
                if qryManutencaoAtributos.fields[i].isNull then
                  vAtributos_valores := vAtributos_valores + '{"' + qryManutencaoAtributos.fields[i].Fieldname + '":"null'
                else
                if qryListaAtributostipo.asString =  'Texto' then
                  vAtributos_valores := vAtributos_valores + '{"' + qryManutencaoAtributos.fields[i].Fieldname + '":"' + qryManutencaoAtributos.fields[i].asString + '"'
                else
                if qryListaAtributostipo.asString =  'Numérico' then
                  vAtributos_valores := vAtributos_valores + '{"' + qryManutencaoAtributos.fields[i].Fieldname + '":"' + qryManutencaoAtributos.fields[i].asString + '"'
                  result :=  result + '"'+qryListaAtributosnome.asString+'" numeric(15,2),'
                else
                if qryListaAtributostipo.asString =  'Inteiro' then
                  result :=  result + '"'+qryListaAtributosnome.asString+'" integer,'
                else
                if qryListaAtributostipo.asString =  'Sim/Não' then
                  result :=  result + '"'+qryListaAtributosnome.asString+'" Boolean,'
                else
                if qryListaAtributostipo.asString =  'Data' then
                  result :=  result + '"'+qryListaAtributosnome.asString+'" Date,';



              end
              else
                MensagemAviso(format('Erro inesperado! O campo "%s" não foi encontrado na lista de atributos.', [qryManutencaoAtributos.fields[i].Fieldname]));



              vNomedoCampoProduto := trocar(qryManutencaoAtributos.fields[i].fieldname, '_produto', '');

              if (pos('_produto', qryManutencaoAtributos.fields[i].fieldname)<>0) and
                 (qryAtualizarProdutos.findfield(vNomedoCampoProduto)<>nil) and
                 (qryAtualizarProdutos.fieldbyname(vNomedoCampoProduto).value <>
                  qryManutencaoAtributos.fields[i].value) then
              begin
                qryAtualizarProdutos.edit;
                qryAtualizarProdutos.fieldbyname(vNomedoCampoProduto).value := qryManutencaoAtributos.fields[i].value;
              end;

              vNomedoCampoCaracteristica := trocar(qryManutencaoAtributos.fields[i].fieldname, '_caracteristica', '');

              if (pos('_caracteristica', qryManutencaoAtributos.fields[i].fieldname)<>0) and
                 (qryAtualizarCaracteristicas.findfield(vNomedoCampoCaracteristica)<>nil) and
                 (qryAtualizarCaracteristicas.fieldbyname(vNomedoCampoCaracteristica).value <>
                  qryManutencaoAtributos.fields[i].value) then
              begin
                qryAtualizarCaracteristicas.edit;
                qryAtualizarCaracteristicas.fieldbyname(vNomedoCampoCaracteristica).value := qryManutencaoAtributos.fields[i].value;
              end;
            end;
            }

          end
          else
          begin
            MensagemErro(format('O produto %s na manutenção de produtos não foi encontrado',
                        [qryManutencaoAtributos.fieldbyname('Produto').asString]));
            exit;
          end;


        end
        else
        begin
          qryManutencaoAtributos.EnableControls;
          exit;
        end;

      end;


      qryManutencaoAtributos.next;

      vPosition :=  (qryManutencaoAtributos.RecNo * 100) / qryManutencaoAtributos.recordcount;

      TAdvSmoothProgressBar(self.owner.FindComponent('AdvSmoothProgressBar1')).visible := true;
      TAdvSmoothProgressBar(self.owner.FindComponent('AdvSmoothProgressBar1')).Appearance.ValueFormat := 'Gravando alterações nos atributos dos produtos %.0f%%';
      TAdvSmoothProgressBar(self.owner.FindComponent('AdvSmoothProgressBar1')).Position := vPosition;

      Application.ProcessMessages;

    end;

    TAdvSmoothProgressBar(self.owner.FindComponent('AdvSmoothProgressBar1')).visible := false;

  finally
    if result then
    begin
      if qryAtualizarProdutosJSON.state = dsedit then
        qryAtualizarProdutosJSON.post;

      result := perpetrar([qryAtualizarProdutosJSON]);

      if result then
      begin
        vAplicadosAtributos := 0;
        MensagemAviso('As alterações foram gravadas com sucesso!');
      end;
      qryManutencaoAtributos.VoltarRegistro;
    end;
  end;

end;

