function TdtmManutencaoProdutos.AbrirConsulta: Boolean;
var

{  ListaCST,
  ListaCSOSN,}
  Where, CondicoesSQL : String;

begin
  qryProdutosLinha.close;
  qryProdutosLinha.open;
  qryProdutosLinha.append;
  {
  qryProdutosLinhanulo_inativo_produto.asBoolean := false;
  qryProdutosLinhanulo_foralinha_produto.asBoolean := false;
  qryProdutosLinhanulo_dval_produto.asBoolean := false;
  qryProdutosLinhanulo_foralinha_caracteristica.asBoolean := false;
  qryProdutosLinhanulo_inativo_caracteristica.asBoolean := false;
  }
  qryProdutosLinhaexigenumeroserie_caracteristica.clear;



  qryProdutos.parambyname('estado').asString := estadofilialbase;


  CondicoesSQL := tfraMultiplaSelecaoAleatoria(self.owner.FindComponent('fraMultiplaSelecaoAleatoria1')).CondicoesSQL;

  if CondicoesSQL <> '' then
    qryProdutos.Macrobyname('Condicao').asString := ' and ' + CondicoesSQL
  else
    qryProdutos.Macrobyname('Condicao').asString := ' and true ';

{
  ListaCST := TfraSelecaoAleatoriacst(self.owner.FindComponent('fraSelecaoAleatoriacst')).ListaCondicional;
  ListaCSOSN := TfraSelecaoAleatoriacsosn(self.owner.FindComponent('fraSelecaoAleatoriacsosn')).ListaCondicional;
}
{
  if ListaCST <> '' then
    qryProdutos.Macrobyname('CondicaoListaCST').asString := ' and ' + ListaCST
  else
    qryProdutos.Macrobyname('CondicaoListaCST').asString := '';

  if ListaCSOSN <> '' then
    qryProdutos.Macrobyname('CondicaoListaCSOSN').asString := ' and ' + ListaCSOSN
  else
    qryProdutos.Macrobyname('CondicaoListaCSOSN').asString := '';
}

  if ParametroListasPadrao <> '' then
    qryProdutos.Macrobyname('CondicaoParametroListasPadrao').asString :=
      ' and (p.codigo in (select plp.produto '+
                                                ' from produtoslistaspadrao plp '+
                                                '      join listaspadrao lp '+
                                                '      on plp.listapadrao = lp.codigo '+
                                                ' where ' + ParametroListasPadrao + '))'


  else
    qryProdutos.Macrobyname('CondicaoParametroListasPadrao').asString := '';


  if not qryProcuraFornecedores.fieldbyname('codigo').IsNull then
    qryProdutos.Macrobyname('CondicaoFornecedor').asString :=

      ' and ((SELECT COUNT(*) ' +
                            ' FROM fornecedoresprodutos fp ' +
                            ' WHERE (fp.caracteristica = c.codigo) and ' +
                                  '(fp.fornecedor = ' + qryProcuraFornecedores.fieldbyname('codigo').AsString + ')) > 0)'

  else
    qryProdutos.Macrobyname('CondicaoFornecedor').asString := '';

  Where := '';

  if FProdutoEmLinha and not FprodutoForadeLinha then
     Where := Where + ' and  not p.foralinhal and not c.foralinhal'
  else
  if FprodutoForadeLinha and not Fprodutoemlinha then
     Where := Where + ' and  (p.foralinhal or c.foralinhal)';

  if FProdutoAtivo and not FprodutoInativo then
     Where := Where + ' and  (not (p.inativo is not null))'
  else
  if FprodutoInativo and not FprodutoAtivo then
     Where := Where + ' and  (p.inativo is not null)';

  if FProdutoComMontagem and not FProdutoSemMontagem then
     Where := Where + ' and (c.montagem)'
  else
  if FProdutoSemMontagem and not FProdutoComMontagem then
     Where := Where + ' and not (c.montagem)';

  if FProdutoBrinde and not FProdutoNaoBrinde then
     Where := Where + ' and (c.brinde)'
  else
  if FProdutoNaoBrinde and not FProdutoBrinde then
     Where := Where + ' and not (c.brinde)';

  if FDisponivelnoSite and not FNaoDisponivelnoSite then
     Where := Where + ' and (p.aparecernosite)'
  else
  if FNaoDisponivelnoSite and not FDisponivelnoSite then
     Where := Where + ' and not (p.aparecernosite)';

  qryProdutos.Macrobyname('CondicaoExtra').asString := Where;

//  qryManutencaoAtributos.params := qryProdutos.params;
  qryManutencaoAtributos.macros := qryProdutos.macros;

  if LastPageOpened.Name = 'tstDadosProdutos'  then
  begin

    if (vmarcadosProdutos <> 0) and
       (vAplicadosProdutos <> 0) then

      result := MensagemConfirmacao('Existe uma gravação pendente. Ao gerar os dados a mesma será perdida.') = smbOK;

    if result then
    begin
      TCheckBox(self.owner.FindComponent('ckbSelecionarTodos')).checked := False;

      vMarcadosprodutos := 0;
      vAplicadosprodutos := 0;

      qryProdutos.close;
      qryProdutos.open;
      result := qryProdutos.recordcount <> 0;
      if not result then
        MensagemAviso(format(ctNENHUMREGISTROENCONTRADO,['registro']));
    end;
  end
  else
  if (LastPageOpened.Name = 'tstDadosAtributos') and (qryProcuraAtributos.RecordCount > 0) then
  begin
    qryManutencaoAtributos.ParamByName('atributo').asinteger := qryProcuraAtributos.fieldbyName('codigo').AsInteger;

    qryManutencaoAtributos.Close;
    qryManutencaoAtributos.Open;

    TDBAdvGrid(self.owner.FindComponent('DBAdvManutencaoAtributos')).AutoSize := false;
    TDBAdvGrid(self.owner.FindComponent('DBAdvManutencaoAtributos')).AutoSize := true;
    TDBAdvGrid(self.owner.FindComponent('DBAdvManutencaoAtributos')).AutoSize := false;


    qryManutencaoAtributos_Linha.Params := qryManutencaoAtributos.Params;
    qryManutencaoAtributos_Linha.Macros := qryManutencaoAtributos.Macros;

    qryManutencaoAtributos_Linha.MacroByName('Lista_de_Campos_1').asString :=
    Lista_de_Campos_1_Linha;

    

    qryManutencaoAtributos_Linha.Close;
    qryManutencaoAtributos_Linha.Open;

    qryManutencaoAtributos_Linha.DELETE;

    qryManutencaoAtributos_Linha.append;

    TDBAdvGrid(self.owner.FindComponent('DBAdvManutencaoAtributos_Linha')).AutoSize := false;
    TDBAdvGrid(self.owner.FindComponent('DBAdvManutencaoAtributos_Linha')).AutoSize := true;
    TDBAdvGrid(self.owner.FindComponent('DBAdvManutencaoAtributos_Linha')).AutoSize := false;

    TfrmManutencaoProdutos(self.owner).SincronizarTodasLarguraColuna(
      TDBAdvGrid(self.owner.FindComponent('DBAdvManutencaoAtributos')),
      TDBAdvGrid(self.owner.FindComponent('DBAdvManutencaoAtributos_Linha')));

    result := qryManutencaoAtributos.recordcount <> 0;

    if not result then
      MensagemAviso(format(ctNENHUMREGISTROENCONTRADO,['registro']));

//    qryManutencaoAtributos_Linha.edit;

  end;

end;

procedure TdtmManutencaoProdutos.AplicarAlteracoes;
var
 i: integer;
 vFoiAplicado : Boolean;
 vRecno : Integer;


 procedure AdicionarListaCaracteristica(NomedoCampo: String);
 begin
   if pos('_caracteristica', NomedoCampo)<>0 then
   begin
     if vListaCaracteristicas.IndexOf(qryProdutoscodigo_caracteristica.asString)=-1 then
       vListaCaracteristicas.append(qryProdutoscodigo_caracteristica.asString);
   end
 end;

begin
  try
    vListaCaracteristicas.Clear;

    qryProdutos.GuardarRegistroAtual(true);
    qryProdutos.first;
    while not qryProdutos.eof do
    begin

      if qryProdutosmarcar.asBoolean then
      begin

        vFoiAplicado := false;


        qryProdutos.edit;
        for i:=0 to qryProdutosLinha.fieldcount-1 do
        begin
          if (qryProdutosLinha.fields[i].fieldname <> 'marcar') and
             (copy(qryProdutosLinha.fields[i].fieldname,1,5) <> 'nulo_') and
             not qryProdutosLinha.fields[i].ReadOnly then
          begin
            if (qryprodutoslinha.FindField('nulo_'+qryProdutosLinha.fields[i].fieldname) <> nil) and
                not qryProdutosLinha.fieldbyname('nulo_'+qryProdutosLinha.fields[i].fieldname).asBoolean then
            begin
              if not qryProdutos.fieldbyname(qryProdutosLinha.fields[i].fieldname).isnull then
                qryProdutos.fieldbyname(qryProdutosLinha.fields[i].fieldname).clear;
              vFoiAplicado := true;
              AdicionarListaCaracteristica(qryProdutosLinha.fields[i].fieldname);
            end
            else
            if not qryProdutosLinha.fields[i].isnull and (trim(qryProdutosLinha.fields[i].asString)<>'') THEN
            begin

              case qryProdutosLinha.fields[i].DataType of
                ftBoolean   :
                begin
                  if qryProdutos.fieldbyname(qryProdutosLinha.fields[i].fieldname).AsBoolean <> qryProdutosLinha.fields[i].asBoolean then
                  begin
                    qryProdutos.fieldbyname(qryProdutosLinha.fields[i].fieldname).AsBoolean := qryProdutosLinha.fields[i].asBoolean;
                    vFoiAplicado := true;
                    AdicionarListaCaracteristica(qryProdutosLinha.fields[i].fieldname);
                  end;
                end;

                ftinteger,
                ftlargeint,
                ftstring,
                ftMemo    :
                begin
                  if qryProdutos.fieldbyname(qryProdutosLinha.fields[i].fieldname).AsString <> qryProdutosLinha.fields[i].asstring then
                  begin
                    qryProdutos.fieldbyname(qryProdutosLinha.fields[i].fieldname).AsString := qryProdutosLinha.fields[i].asstring;
                    vFoiAplicado := true;
                    AdicionarListaCaracteristica(qryProdutosLinha.fields[i].fieldname);
                  end;
                end;
                ftCurrency  :
                begin
                  if qryProdutos.fieldbyname(qryProdutosLinha.fields[i].fieldname).AsCurrency <> qryProdutosLinha.fields[i].asCurrency then
                  begin
                    qryProdutos.fieldbyname(qryProdutosLinha.fields[i].fieldname).AsCurrency := qryProdutosLinha.fields[i].asCurrency;
                    vFoiAplicado := true;
                    AdicionarListaCaracteristica(qryProdutosLinha.fields[i].fieldname);
                  end;
                end;

                ftDate, ftDateTime  :
                begin
                  if qryProdutosLinha.fields[i].asDateTime <>
                     qryProdutos.fieldbyname(qryProdutosLinha.fields[i].fieldname).asDateTime then
                  begin
                    qryProdutos.fieldbyname(qryProdutosLinha.fields[i].fieldname).AsDateTime := qryProdutosLinha.fields[i].asDateTime;
                    vFoiAplicado := true;
                    AdicionarListaCaracteristica(qryProdutosLinha.fields[i].fieldname);
                  end;
                end;


                else
                begin
                  if qryProdutos.fieldbyname(qryProdutosLinha.fields[i].fieldname).value <> qryProdutosLinha.fields[i].value then
                  begin
                    qryProdutos.fieldbyname(qryProdutosLinha.fields[i].fieldname).value := qryProdutosLinha.fields[i].value;
                    vFoiAplicado := true;
                    AdicionarListaCaracteristica(qryProdutosLinha.fields[i].fieldname);
                  end;
                end
              end;

            end;

          end;
        end;

        qryProdutos.post;

        if vFoiAplicado then
          inc(vAplicadosprodutos);

      end;

      qryProdutos.next;

      vPosition :=  (qryProdutos.RecNo * 100) / qryProdutos.recordcount;

      TAdvSmoothProgressBar(self.owner.FindComponent('AdvSmoothProgressBar1')).visible := true;
      TAdvSmoothProgressBar(self.owner.FindComponent('AdvSmoothProgressBar1')).Appearance.ValueFormat := 'Aplicando alterações nos produtos selecionados %.0f%%';
      TAdvSmoothProgressBar(self.owner.FindComponent('AdvSmoothProgressBar1')).Position := vPosition;

      Application.ProcessMessages;

    end;

    TAdvSmoothProgressBar(self.owner.FindComponent('AdvSmoothProgressBar1')).visible := false;

  finally
    qryProdutos.VoltarRegistro;
    AplicarAlteracoesCaracteristicas;
  end;

end;

