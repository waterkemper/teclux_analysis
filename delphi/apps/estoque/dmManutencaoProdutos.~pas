procedure TdtmManutencaoProdutos.qryManutencaoAtributos_LinhaGetText(
  Sender: TField; var Text: String; DisplayText: Boolean);
begin
  inherited;

  if qryManutencaoAtributos_Linha.findfield('nulo_'+TField(Sender).fieldname)<>nil then
  begin
    if not qryManutencaoAtributos_Linha.fieldbyname('nulo_'+TField(Sender).fieldname).isnull and not qryManutencaoAtributos_Linha.fieldbyname('nulo_'+TField(Sender).fieldname).asBoolean then
      Text := 'Nulo'
    else
    if TField(Sender).isnull then
      DisplayText := false
    else
    begin
      if TField(Sender).DataType = ftDate then
        Text := FormatDateTime('dd/mm/yyyy', TField(Sender).asDateTime)
      else
        Text := TField(Sender).asString;
    end;
  end
  else
  if TField(Sender).DataType = ftBoolean then
  begin
    if TField(Sender).isnull then
      DisplayText := false
    else
      Text := TField(Sender).asString;
  end;

end;

