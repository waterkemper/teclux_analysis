procedure TdtmManutencaoProdutos.qryProdutosLinhaGetText(Sender: TField;
  var Text: String; DisplayText: Boolean);
begin
  if qryProdutosLinha.findfield('nulo_'+TField(Sender).fieldname)<>nil then
  begin
    if not qryProdutosLinha.fieldbyname('nulo_'+TField(Sender).fieldname).isnull and not qryProdutosLinha.fieldbyname('nulo_'+TField(Sender).fieldname).asBoolean then
      Text := 'Nulo'
    else
    if TField(Sender).isnull then
      DisplayText := false
    else
    begin
      if TField(Sender).DataType = ftDate then
        Text := FormatDateTime('dd/mm/yyyy', TField(Sender).asDateTime)
      else
        Text := TField(Sender).asString;
    end;
  end
  else
  if TField(Sender).DataType = ftBoolean then
  begin
    if TField(Sender).isnull then
      DisplayText := false
    else
      Text := TField(Sender).asString;
  end;
end;


procedure TdtmManutencaoProdutos.qryProdutosLinhaNewRecord(
  DataSet: TDataSet);
var
  i: integer;

begin
  inherited;
  for i:=0 to Dataset.fieldcount -1 do
  begin
    if dataset.fields[i].DataType = ftBoolean then
      if lowercase(copy(dataset.fields[i].fieldname,1,5))='nulo_' then
        TBooleanField(dataset.fields[i]).asBoolean := true;
  end;
end;

procedure TdtmManutencaoProdutos.SetLastPageOpened(const Value: tTabSheet);
var
 vGerar : Boolean;
begin

