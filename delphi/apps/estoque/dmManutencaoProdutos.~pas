procedure TdtmManutencaoProdutos.AplicarAlteracoesAtributos;
var
 i: integer;
 vFoiAplicado : Boolean;
 vRecno : Integer;


 procedure AdicionarListaCaracteristica(NomedoCampo: String);
 begin
   if pos('_caracteristica', NomedoCampo)<>0 then
   begin
     if vListaCaracteristicas.IndexOf(qryProdutoscodigo_caracteristica.asString)=-1 then
       vListaCaracteristicas.append(qryProdutoscodigo_caracteristica.asString);
   end
 end;

begin
  try
    qryManutencaoAtributos.GuardarRegistroAtual(true);
    qryManutencaoAtributos.first;
    while not qryManutencaoAtributos.eof do
    begin

      if qryManutencaoAtributos.fieldbyname('selecionar').asBoolean then
      begin

        vFoiAplicado := false;


        qryManutencaoAtributos.edit;
        for i:= qryManutencaoAtributos_Linha.fieldbyname('selecionar').index+1 to
                qryManutencaoAtributos_Linha.fieldcount-1 do
        begin
          if (qryManutencaoAtributos_Linha.fields[i].fieldname <> 'selecionar') and
             (lowercase(copy(qryManutencaoAtributos_Linha.fields[i].fieldname,1,5)) <> 'nulo_') and
             not qryManutencaoAtributos_Linha.fields[i].ReadOnly then
          begin
            if (qryManutencaoAtributos_Linha.FindField('nulo_'+qryManutencaoAtributos_Linha.fields[i].fieldname) <> nil) and
                not qryManutencaoAtributos_Linha.fieldbyname('nulo_'+qryManutencaoAtributos_Linha.fields[i].fieldname).asBoolean then
            begin
              if not qryManutencaoAtributos.fieldbyname(qryManutencaoAtributos_Linha.fields[i].fieldname).isnull then
                qryManutencaoAtributos.fieldbyname(qryManutencaoAtributos_Linha.fields[i].fieldname).clear;
              vFoiAplicado := true;
//              AdicionarListaCaracteristica(qryManutencaoAtributos_Linha.fields[i].fieldname);
            end
            else
            if not qryManutencaoAtributos_Linha.fields[i].isnull and (trim(qryManutencaoAtributos_Linha.fields[i].asString)<>'') THEN
            begin

              case qryManutencaoAtributos_Linha.fields[i].DataType of
                ftBoolean   :
                begin
                  if qryManutencaoAtributos.fieldbyname(qryManutencaoAtributos_Linha.fields[i].fieldname).AsBoolean <> qryManutencaoAtributos_Linha.fields[i].asBoolean then
                  begin
                    qryManutencaoAtributos.fieldbyname(qryManutencaoAtributos_Linha.fields[i].fieldname).AsBoolean := qryManutencaoAtributos_Linha.fields[i].asBoolean;
                    vFoiAplicado := true;
//                    AdicionarListaCaracteristica(qryManutencaoAtributos_Linha.fields[i].fieldname);
                  end;
                end;

                ftinteger,
                ftlargeint,
                ftstring,
                ftMemo    :
                begin
                  if qryManutencaoAtributos.fieldbyname(qryManutencaoAtributos_Linha.fields[i].fieldname).AsString <> qryManutencaoAtributos_Linha.fields[i].asstring then
                  begin
                    qryManutencaoAtributos.fieldbyname(qryManutencaoAtributos_Linha.fields[i].fieldname).AsString := qryManutencaoAtributos_Linha.fields[i].asstring;
                    vFoiAplicado := true;
//                    AdicionarListaCaracteristica(qryManutencaoAtributos_Linha.fields[i].fieldname);
                  end;
                end;
                ftCurrency, ftfloat  :
                begin
                  if qryManutencaoAtributos.fieldbyname(qryManutencaoAtributos_Linha.fields[i].fieldname).AsCurrency <> qryManutencaoAtributos_Linha.fields[i].asCurrency then
                  begin
                    qryManutencaoAtributos.fieldbyname(qryManutencaoAtributos_Linha.fields[i].fieldname).AsCurrency := qryManutencaoAtributos_Linha.fields[i].asCurrency;
                    vFoiAplicado := true;
//                    AdicionarListaCaracteristica(qryManutencaoAtributos_Linha.fields[i].fieldname);
                  end;
                end;

                ftDate, ftDateTime  :
                begin
                  if qryManutencaoAtributos_Linha.fields[i].asDateTime <>
                     qryManutencaoAtributos.fieldbyname(qryManutencaoAtributos_Linha.fields[i].fieldname).asDateTime then
                  begin
                    qryManutencaoAtributos.fieldbyname(qryManutencaoAtributos_Linha.fields[i].fieldname).AsDateTime := qryManutencaoAtributos_Linha.fields[i].asDateTime;
                    vFoiAplicado := true;
//                    AdicionarListaCaracteristica(qryManutencaoAtributos_Linha.fields[i].fieldname);
                  end;
                end;


                else
                begin
                  if qryManutencaoAtributos.fieldbyname(qryManutencaoAtributos_Linha.fields[i].fieldname).value <> qryManutencaoAtributos_Linha.fields[i].value then
                  begin
                    qryManutencaoAtributos.fieldbyname(qryManutencaoAtributos_Linha.fields[i].fieldname).value := qryManutencaoAtributos_Linha.fields[i].value;
                    vFoiAplicado := true;
//                    AdicionarListaCaracteristica(qryManutencaoAtributos_Linha.fields[i].fieldname);
                  end;
                end
              end;

            end;

          end;
        end;

        qryManutencaoAtributos.post;

        if vFoiAplicado then
          inc(vAplicadosprodutos);

      end;

      qryManutencaoAtributos.next;

      vPosition :=  (qryManutencaoAtributos.RecNo * 100) / qryManutencaoAtributos.recordcount;

      TAdvSmoothProgressBar(self.owner.FindComponent('AdvSmoothProgressBar1')).visible := true;
      TAdvSmoothProgressBar(self.owner.FindComponent('AdvSmoothProgressBar1')).Appearance.ValueFormat := 'Aplicando alterações nos produtos selecionados %.0f%%';
      TAdvSmoothProgressBar(self.owner.FindComponent('AdvSmoothProgressBar1')).Position := vPosition;

      Application.ProcessMessages;

    end;

    TAdvSmoothProgressBar(self.owner.FindComponent('AdvSmoothProgressBar1')).visible := false;

  finally
    qryManutencaoAtributos.VoltarRegistro;
//    AplicarAlteracoesCaracteristicas;
  end;

end;

