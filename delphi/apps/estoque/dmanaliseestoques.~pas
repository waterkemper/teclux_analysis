    qryAnaliseEstoquesprecoultimaentrada: TFloatField;
    qryAnaliseEstoquesdataultimaentrada: TDateField;
    qryAnaliseEstoquespreco_prazo_cmv: TFloatField;
    qryAnaliseEstoquespreco_custo_cmv: TFloatField;
    qryAnaliseEstoquesmargem_cmv: TFloatField;
    qryAnaliseEstoquesestoques_preconormal: TFloatField;
    qryAnaliseEstoquescusto_unitario_cmv: TFloatField;
    qryAnaliseEstoquesmargem_uc: TFloatField;
