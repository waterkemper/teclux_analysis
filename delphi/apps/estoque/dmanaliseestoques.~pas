  TdtmAnaliseestoques = class(TdtmBasico)
    qryAnaliseEstoques: TtecQuery;
    dsrAnaliseEstoques: TtecDataSource;
    qryAnaliseEstoques_aux: TtecQuery;
    qryAnaliseEstoques_auxanomes: TStringField;
    qryAnaliseEstoques_auxMesAnoExtenso: TStringField;
    qrynMeses: TtecQuery;
    qrynmeses_aux: TtecQuery;
    qryAnaliseEstoquesgrupo: TStringField;
    qryAnaliseEstoquesdescricao_grupo: TStringField;
    qryAnaliseEstoquesresultadocurvaabc: TStringField;
    qryAnaliseEstoquesproduto: TStringField;
    qryAnaliseEstoquesdescricao_produto: TStringField;
    qryAnaliseEstoquesquantidade_total_estoque: TFloatField;
    qryAnaliseEstoquesquantidade_totao_pedidos: TFloatField;
    qryAnaliseEstoquespromocao: TIntegerField;
    qryAnaliseEstoquesdescricao_promocao: TStringField;
    qryAnaliseEstoquesmes_11_2018: TFloatField;
    qryAnaliseEstoquesmes_12_2018: TFloatField;
