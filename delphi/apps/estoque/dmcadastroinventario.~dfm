      '                    where ml.produto = ipl.produto'
      '                      and ml.filial = i.filial'
      '                      and ml.loteproduto = ipl.lote'
      '                      and ml.data <= i.processamento'
      
        '                    order by ml.data desc, ml.lancto desc limit ' +
        '1),0) as transitoprocessamento,'
      ''
      '           coalesce((select ml.demonstracao'
      '                    from movimentoslotes ml'
      '                    where ml.produto = ipl.produto'
      '                      and ml.filial = i.filial'
      '                      and ml.loteproduto = ipl.lote'
      '                      and ml.data <= i.processamento'
      
        '                    order by ml.data desc, ml.lancto desc limit ' +
