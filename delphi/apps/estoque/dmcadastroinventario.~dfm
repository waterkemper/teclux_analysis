        '                                   financeiroprocessamento    = ' +
        'selecao.financeiroprocessamento'
      'from'
      ''
      '('
      '   select  ipl.inventario, ipl.produto, ipl.lote,'
      ''
      '           coalesce((select ml.emestoque'
