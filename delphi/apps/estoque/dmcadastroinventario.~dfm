      '          ep.produto,'
      '          ep.codigovisual,'
      '          ep.lote,'
      '          0.00,'
      '          true'
      'from'
      '('
      ''
      '   select ip.inventario,'
      '          ip.sequencia,'
      '          ip.produto,'
      '          p.codigovisual,'
      '          el.lote,'
      #9#9'  e.filial'
      ''
      '   from inventarioprodutos ip'
      '        join inventario i'
      '        on ip.inventario = i.numero'
      ''
      '        join produtos p'
      '             join caracteristicas c'
      '             on p.caracteristica = c.codigo'
      '        on ip.produto = p.codigo'
      ''
      '        join estoques e'
