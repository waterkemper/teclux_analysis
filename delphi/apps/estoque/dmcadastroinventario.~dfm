        '       (select gr.descricao from grades gr where gr.codigo = c.g' +
        'rade2) as coluna,'
      ''
      '       (select e.localizacao'
      '        from estoques e'
      '        where e.produto = ip.produto'
      
        '          and e.filial = (select i.filial from inventario i wher' +
        'e i.numero = ip.inventario)) as localizacao,'
      ''
      '       (select e.Sublocalizacao'
      '        from estoques e'
      '        where e.produto = ip.produto'
      
        '          and e.filial = (select i.filial from inventario i wher' +
        'e i.numero = ip.inventario)) as Sublocalizacao'
      ''
      'from inventarioprodutos ip,'
      
        '     (produtos p join caracteristicas c on p.caracteristica = c.' +
        'codigo)'
      'where ip.produto = p.codigo'
      '  and ip.inventario = :inventario'
