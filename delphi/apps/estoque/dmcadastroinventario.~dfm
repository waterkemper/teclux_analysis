      '      %SQLFiltroGruposFornecedores'
      '      %SQLFiltroFornecedor'
      '      %SQLFiltroDescricaoProduto'
      '      %SQLEmLinha_ForadeLinha'
      '      %SQLAtivo_Inativo'
      '      %SQLCondicaoCompostos'
      ''
      ''
      '   ) AS ep, movimentos m1'
      '      Where m1.numero = (select m2.numero'
      '                         from movimentos m2'
      '                         where m2.produto = ep.codigoitem'
      '                           and m2.filial = ep.codigofilial'
      '                           and m2.data <= cast(:data as date)'
      
        '                         order by m2.data desc, m2.lancto desc l' +
