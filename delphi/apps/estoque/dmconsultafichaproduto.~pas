procedure TdtmConsultaFichaProduto.qryFichaProduto_ContratoBeforeOpen(
  DataSet: TDataSet);
var
  ListadeContratos : String;
begin
  inherited;
  try
    qryFichaProduto.GuardarRegistroAtual(true);
    qryFichaProduto.afterscroll := nil;
    ListadeContratos := RetornarLista(qryFichaProduto, qryFichaProdutocontrato, nil, true);

    if ListadeContratos='' then
      ListadeContratos := '''0''';
    qryFichaProduto_Contrato.Macrobyname('ListadeContratos').asString := ListadeContratos;
    qryFichaProdutoLote_Contrato.Macrobyname('ListadeContratos').asString := ListadeContratos;

  finally
    qryFichaProduto.VoltarRegistro;
    qryFichaProduto.AfterScroll := qryFichaProdutoAfterScroll;
  end;

end;

