procedure TdtmConsultaFichaProduto.IncluirLinhaSaldoLotes;
var
  i: integer;
  vLoteProduto : String;
begin
  //Lotes
  if not qryFichaProdutoLote.locate('referencia', 'SALDO ANTERIOR', []) then
  begin
    if qryFichaProdutoLote_Saldo.isempty then
    begin
     qryFichaProdutoLote.First;
     vLoteProduto := qryFichaProdutoLoteloteproduto.AsString;
     qryFichaProdutoLote.Insert;
     qryFichaProdutoLotereferencia.AsString := 'SALDO ANTERIOR';
