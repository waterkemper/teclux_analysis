procedure TdtmConsultaFichaProduto.ConsultaFichaProduto;
var
  Linha : String;
  i : integer;
begin
  Linha := 'and (m.data >= to_timestamp(''' + FParametroDataInicial +''', ''dd/mm/yyyy''))';
  Linha := Linha + 'and (m.data <= to_timestamp(''' + FParametroDataFinal + ' 23:59:59'', ''dd/mm/yyyy hh24:mi:ss''))';
  if Trim(FParametroFilial) <> '' then
    Linha := Linha + ' and ( m.filial = ' + FParametroFilial + ' )';
  if Trim(FParametroTipoMovimento) <> '' then
    Linha := Linha + ' and (m.tipomovimento = ''' + FParametroTipoMovimento + ''')';


  qryFichaProdutoLote_Saldo.macrobyname('Linha').asString := Linha;


  if SomenteLancamentosAvulsos then
    Linha := linha + ' and m.usuarioautorizacao is not null ';

  qryFichaProduto.MacroByName('Linha').AsString := Linha;
  qryFichaProdutolote.MacroByName('Linha').AsString := Linha;

  if ParametroLote<>'' then
  begin
    qryFichaProduto.MacroByName('CondicaoLote').AsString := ' and m.loteproduto = '+ParametroLote;
    qryFichaProduto_Saldo.MacroByName('CondicaoLote').AsString := ' and m.loteproduto = '+ParametroLote;
    qryFichaProdutoLote.MacroByName('CondicaoLote').AsString := ' and m.loteproduto = '+ParametroLote;
    qryFichaProdutoLote_Saldo.MacroByName('CondicaoLote').AsString := ' and m.loteproduto = '+ParametroLote;
  end
  else
  begin
    qryFichaProduto.MacroByName('CondicaoLote').AsString := '';
    qryFichaProduto_Saldo.MacroByName('CondicaoLote').AsString := '';

    qryFichaProdutoLote.MacroByName('CondicaoLote').AsString := '';
    qryFichaProdutoLote_Saldo.MacroByName('CondicaoLote').AsString := '';

  end;

  // Setando o WHERE O CÁLCULO DO SALDO ANTERIOR (não do lote)
  Linha := '';
  if Trim(FParametroFilial) <> '' then
    Linha := ' and ( m.filial = ' + FParametroFilial + ' )';
  if Trim(FParametroTipoMovimento) <> '' then
    Linha := Linha + ' and (m.tipomovimento = ''' + FParametroTipoMovimento + ''')';


  qryFichaProduto_Saldo.macrobyname('Linha').asString := Linha;


  RefazConsulta(qryFichaProduto,[0],[FParametroProduto]);
  RefazConsulta(qryFichaProdutoLote,[0],[FParametroProduto]);

  RefazConsulta(qryFichaProduto_Saldo,[0,1],[FParametroProduto,FParametroDataInicial]);
  RefazConsultaPornome(qryFichaProdutoLote_Saldo,['produto','datainicial'],[FParametroProduto,FParametroDataInicial]);

//  qryFichaProdutoContrato.params := qryFichaProduto.params;
//  qryFichaProdutoContrato.macros := qryFichaProduto.macros;

  if VisualizarProdutosporContrato then
  begin
    RefazConsulta(qryFichaProduto_Contrato,[0],[FParametroProduto]);
    RefazConsulta(qryFichaProdutoLote_Contrato,[0],[FParametroProduto]);
  end;

  IncluirLinhaSaldo;
end;

