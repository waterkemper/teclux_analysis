     qryFichaProdutoLotemoeda.Clear;
  //   qryFichaProdutoLotemoedaLookup.Clear;
     qryFichaProdutoLote.Post;
    end
    else
    begin
     qryFichaProdutoLote.First;
     qryFichaProdutoLote.Insert;
     for i:=0 to qryFichaProdutoLote_Saldo.FieldCount -1 do
     begin
       if qryFichaProdutoLote_Saldo.Fields[i].FieldName <> 'naoprocessartriggers' then
         qryFichaProdutoLote.Fields[i].AsVariant := qryFichaProdutoLote_Saldo.Fields[i].asvariant;
     end;
     qryFichaProdutoLote.Post;
    end;

  end;

