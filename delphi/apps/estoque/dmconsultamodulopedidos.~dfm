    Sql.Strings = (
      'Select pe.numero,'
      '        pe.emissao,'
      '        pe.entrega,'
      '        pe.fornecedor,'
      '        pe.situacao, pe.concluido, pe.cancelado,'
      '        pp.quantidade,'
      '        pp.produto, p.codigovisual as produtovisual,'
      ''
      '        cast(case when c.complemento is not null then'
      
        '             p.descricao || coalesce('#39' '#39'||p.valorgrade1,'#39#39') || c' +
        'oalesce('#39' '#39'||p.valorgrade2||'#39' '#39','#39#39') || c.complemento'
      
        '             else p.descricao || coalesce('#39' '#39'||p.valorgrade1,'#39#39')' +
        ' || coalesce('#39' '#39'||p.valorgrade2,'#39#39') end as varchar(434)) as desc' +
        'ricaoproduto,'
      ''
      
        '        (select gr.descricao from grades gr where gr.codigo = c.' +
        'grade1) as linha,'
      
        '        (select gr.descricao from grades gr where gr.codigo = c.' +
        'grade2) as coluna,'
      ''
      '        p.valorgrade1,'
      '        p.valorgrade2,'
      '        vf.razao as nomefornecedor,'
      
        '        produtospedidos_recebido(pp.pedido, pp.produto) as receb' +
        'ido,'
      '        pp.preco,'
      '        pp.desconto,'
      '        pe.filialentrega,'
      ''
      ''
      '        (select cast(case when media=0'
      '                    then 0'
      '                    else (select emestoque+transito'
      '                          from estoques'
      '                          where produto = sel1.produto'
      
        '                            and filial = sel1.filial) / sel1.med' +
        'ia'
      '                     end as integer) as dias_em_estoque'
      '        from'
      '        ('
      ''
      '          select abs(vendidos)/:ndias as media,produto,filial'
      '          from'
      '            ('
      
        '             select sum(vendido) as vendidos,produto,filial from' +
        ' movimentosvendascompras'
      
        '             where data > (current_date - cast(:ndias as integer' +
        '))'
      '               and filial = pe.filialentrega'
      '               and produto = pp.produto'
      '             group by produto,filial'
      '            )'
      '            as sel'
      '        ) as sel1) as dias_em_estoque,'
      '       false as marcar'
      ''
      'From    ((pedidos pe'
      '          join (produtospedidos pp'
      ''
      
        '             join ((produtos p left join promocoes pro on p.prom' +
        'ocao = pro.codigo)'
      '                  join (((caracteristicas c'
      '                       join grupos g'
      '                       on c.grupo = g.codigo)'
      ''
      '                       join classes cl'
      '                       on c.classe = cl.codigo)'
      ''
      '                       join marcas m'
      '                       on c.marca = m.codigo)'
      ''
      '                  on p.caracteristica = c.codigo)'
      ''
      '             on pp.produto = p.codigo)'
      ''
      '        on pe.numero = pp.pedido)'
      ''
      '        join vfornecedores vf'
      '        on pe.fornecedor = vf.codigo and vf.tipo = '#39'F'#39')'
      ''
      'Where true and  '
      '    '
      '    %Emissao'
      '    %Situacao'
      '    %Fornecedor'
      '    %Produto'
      '    %ItemdeProdutos'
      '    %marcasProdutos'
      '    %gruposprodutos'
      '    %classesprodutos'
      '    %GruposFornecedores'
      '    %ListadeFiliaisdeEntrega'
      ''
      '    %Ordenacao')
    RequestLive = True
    Left = 48
    Top = 10
    ParamData = <
      item
        DataType = ftInteger
        Name = 'ndias'
        ParamType = ptUnknown
        Value = '1'
      end>
