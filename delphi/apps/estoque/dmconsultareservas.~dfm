    Macros = <>
    Sql.Strings = (
      'Select pr.produto,'
      '           pr.quantidade, '
      '           pr.filial as filialestoque,'
      '           pr.baixado, '
      '           r.numero,  '
      '           cast(r.data as date) as data,'
      '           r.cliente,  '
      '           r.usuario,'
      '           r.endereco,'
      '           r.filial as filialreserva,  '
      '           p.descricao as descricaoproduto,'
      
        '           (select gr.descricao from grades gr where gr.codigo =' +
        ' c.grade1) as linha,'
      
        '           (select gr.descricao from grades gr where gr.codigo =' +
        ' c.grade2) as coluna,'
      '            p.valorgrade1,'
      '            p.valorgrade2,'
      '           u.nome as nomeusuario'
      
        'From   produtosreservas pr, reservas r, produtos p, caracteristi' +
        'cas c, usuarios u'
      'Where  '
      '    /*             Periodo             */'
      '    /*             Reserva            */'
      '    /*             Produtos           */'
      '    /*             Filial                  */'
      '    /*             Usuario             */'
      '    /*             Situacao            */'
      '    and ( pr.reserva = r.numero )'
      '    and ( pr.produto = p.codigo)'
      '    and ( p.caracteristica = c.codigo)'
      '    and ( r.usuario = u.codigo)'
      '   /*            Ordenacao          */')
