    Macros = <>
    Sql.Strings = (
      'select pc.contrato,'
      '       pc.produto,'
      '       p.codigovisual as produtovisual, pc.produtodigitado,'
      '       pc.filial,'
      '       pc.numero,'
      '       pc.quantidade,'
      '       pc.cancelado,'
      '       pc.precovenda,'
      '       pc.precotabela,'
      '       pc.descricaoprecovenda,'
      '       pc.montagem,'
      '       pc.entrega,'
      '       pc.produtolista,'
      '       coalesce((select m.emestoque'
      '                 from movimentos m'
      '                 where m.numero = (select max(m2.numero)'
      '                                   from movimentos m2'
      
        '                                   where (m2.produto = pc.produt' +
        'o) and'
      '                                         (m2.filial = pc.filial)'
      '                                  )'
      '               ),0)'
      '       as emestoque,'
      ''
      '       coalesce((select m.reservado'
      '                 from movimentos m'
      '                 where m.numero = (select max(m2.numero)'
      '                                   from movimentos m2'
      
        '                                   where (m2.produto = pc.produt' +
        'o) and'
      '                                         (m2.filial = pc.filial)'
      '                                  )'
      '               ),0)'
      '       as reservado,'
      '       coalesce((select m.futuro'
      '                 from movimentos m'
      '                 where m.numero = (select max(m2.numero)'
      '                                   from movimentos m2'
      
        '                                   where (m2.produto = pc.produt' +
        'o) and'
      '                                         (m2.filial = pc.filial)'
      '                                  )'
      '               ),0)'
      '       as futuro,'
      '       (select p.descricao'
      '        from produtos p'
      '        where p.codigo = pc.produto) as descricao,'
      '       (select c.unidade'
      '        from caracteristicas c'
      '        where c.codigo = p.caracteristica) as unidade,'
      '       (select c.vendanegativa'
      '        from caracteristicas c'
      '        where c.codigo = p.caracteristica) as vendasemestoque,'
      
        '        Selecionar_AliquotaIcms(:EstadoFilialBase,:Estadocfo,:Ti' +
        'poPessoa, pc.produto) as aliquotaicms,'
      '       (select c1.icms'
      '        from caracteristicas c1'
      '        where c1.codigo = p.caracteristica) as icms,'
      '       (select i.aliquota'
      '        from ipi i'
      '        where i.codigo = (select c.ipi '
      '                                     from caracteristicas c'
      
        '                                     where c.codigo = p.caracter' +
        'istica)'
      '       ) as aliquotaipi,'
      ''
      '       (select c.origem'
      '           from caracteristicas c'
      '           where c.codigo = p.caracteristica) as origem,'
      ''
      '       (select t.valor'
      '        from tributosicms t'
      '        where t.codigo = (select c4.incidencia'
      '                          from caracteristicas c4'
      
        '                          where c4.codigo = p.caracteristica)) a' +
        's incidencia,'
      ''
      '       (select c.csosn'
      '        from caracteristicas c'
      '        where c.codigo = p.caracteristica) as csosn,'
      ''
      '       (select c.piscst'
      '        from caracteristicas c'
      '        where c.codigo = p.caracteristica) as piscst,'
      ''
      '       (select c.cofinscst'
      '        from caracteristicas c'
      '        where c.codigo = p.caracteristica) as cofinscst,'
      ''
      ''
      '       (select ipi.classificacaofiscal'
      '        from ipi'
      '        where ipi.codigo = (select c.ipi'
      '                            from caracteristicas c'
      
        '                            where c.codigo = p.caracteristica)) ' +
        'as classificacaofiscal,'
      ''
      ''
      '       (select f.transfautomatica'
      '        from filiais f'
      '        where f.codigo = pc.filial'
      '       ) as transfautomatica,'
      '       (select c.montagem'
      '        from caracteristicas c'
      '        where c.codigo = p.caracteristica) as montagemoriginal,'
      '       (select c.percreducaobase'
      '        from caracteristicas c'
      '        where c.codigo = p.caracteristica) as percreducaobase,'
      '       pc.reserva,'
      '       pc.brinde,'
      '       pc.vendedor,'
      '       pc.movimento,'
      '       cast(0 as numeric(9,3)) as qtdecopiar,'
      '       false as incluirnanotafiscal,'
      '       false as incluirnalistacasamento,'
      '       false as promocao,'
      
        '       (select g.descricao from grades g, caracteristicas c wher' +
        'e c.codigo = p.caracteristica and g.codigo = c.grade1) as linha,'
      
        '       (select g.descricao from grades g, caracteristicas c wher' +
        'e c.codigo = p.caracteristica and g.codigo = c.grade2) as coluna' +
        ','
      '       p.valorgrade1,'
      '       p.valorgrade2,'
      '       (select c.composto'
      '        from caracteristicas c'
      '        where c.codigo = p.caracteristica) as composto,'
      '       (select c.producaopropria'
      '        from caracteristicas c'
      '        where c.codigo = p.caracteristica) as producaopropria,'
      ''
      '       pc.ipi,'
      '       pc.desconto,'
      '       pc.descontofinanceiro,'
      '       pc.descontogeral,'
      '       pc.desconto_cashback,'
      '       pc.valordescontoitem,'
      '       pc.valordescontoitemcupomdesconto,'
      '       pc.acrescimo,'
      '       pc.frete,'
      '       pc.seguro,'
      ''
      '      (select sum(pcl.quantidade)'
      '       from produtoscontratoslotes pcl'
      '       where pcl.contrato = pc.contrato'
      '         and pcl.produto = pc.produto'
      '         and pcl.filial = pc.filial'
      
        '         and coalesce(c.gerenciarloteevalidade,false)) as quanti' +
        'dadelotes'
      ''
      'from produtoscontratos pc'
      '     join produtos p'
      '     on pc.produto = p.codigo'
      ''
      '     join filiais f'
      '     on pc.filial = f.codigo'
      ''
      'where p.codigo    = pc.produto'
      '  and pc.filial   = f.codigo'
      '  and pc.contrato = :contrato'
      ''
      '  /* :FilialBase */'
      'Order By pc.numero')
