      #9#9'sum(valor) as valor,'
      #9#9'sum(icmsvalorst) as valorst,'
      '        sum(isentas) as isentas,'
      ''
      '        sum(outras) +'
      '           (select sum(base+isentas+outras)'
      '            from calculosdadosfiscais_(:dadofiscal)'
      '            where tipo = '#39'M'#39') as outras,'
      ''
      '        sum(base + isentas + outras) +'
      '           (select sum(base+isentas+outras)'
      '            from calculosdadosfiscais_(:dadofiscal)'
      '            where tipo = '#39'M'#39')'
      ''
      '         as total'
      ''
      'from calculosdadosfiscais_(:dadofiscal)'
      'where tipo = '#39'S'#39
      ') as selecao where coalesce(total,0)<>0')
