    Sql.Strings = (
      'select p.descricao,'
      '       p.valorgrade1,'
      '       p.valorgrade2,'
      '       p.codigo as produto,'
      '       p.codigovisual as produtovisual,'
      '       estoques_preco(p.codigo, e.filial) as preco,'
      
        '       (select case when (m.financeiro = 0) or (m.financeiro is ' +
        'null) then 0'
      
        '                         else round(m.financeiro/coalesce(nullif' +
        '(quantidadetotaldoestoque(m.numero),0),1),2) end'
      '          from movimentos m'
      '           where m.numero = (select Max(m1.numero)'
      '                                    from movimentos m1'
      
        '                                      where (m1.produto = e.Prod' +
        'uto) and'
      
        '                                                 (m1.filial  = e' +
        '.Filial))) as ultimocustomedio,'
      ''
      
        '       (case when (e.financeiro = 0) or (e.financeiro is null) t' +
        'hen 0'
      
        '                 else round(e.financeiro/coalesce(nullif(quantid' +
        'adetotaldoestoque(e.produto,e.filial),0),1),2)'
      '         end) as customedio,'
      ''
      '       e.valorultimacompra,'
      '       cast(null as integer) as NumeroProdutoTabela,'
      '       cast(null as numeric(11,3)) as quantidadenotaentrada,'
      ''
      '       c.gerenciarloteevalidade,'
      ''
      '       cast(null as bigint) as lote,'
      '       cast(null as varchar(20)) as nrlote,'
      '       cast(null as date) as validade,'
      '       cast(null as date) as fabricacao'
      ''
      'from produtos p'
