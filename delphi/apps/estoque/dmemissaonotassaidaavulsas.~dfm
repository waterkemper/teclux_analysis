        '        upper(to_ascii(p.codigovisual,'#39'latin1'#39')) = upper(to_asci' +
        'i(:produtovisual,'#39'latin1'#39')) or'
      ''
      #9#9'p.codigo in (select pcb.produto'
      '                      from produtoscodigobarras pcb'
      '                      where pcb.codigobarras = :produtovisual)'
      ''
      #9'   )'
      ''
      '  and  (e.filial     = :FilialBase)'
      '  and  (p.inativo is null)'
      '  and  (0 < (select count(*)'
      '                  from estoques e1'
      '                  where (e1.filial = e.filial) and'
      '                            (e1.produto = p.codigo)'
      '          )      )'
      ''
      '%SQLListas'
      ''
      ''
      '/*'
      ''
      '  :numeroproduto'
