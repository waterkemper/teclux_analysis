  object qryListaPrecosporCargo: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'CamposdeCargos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereOrdenacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      
        'select selecao.*, produto_listacodigobarras(selecao.produto) as ' +
        'listacodigobarras'
      'from'
      '('
      'select * from crosstab'
      '('
      #39
      ''
      'Select distinct'
      '       e.produto,'
      '       p.descricao as DescricaoProduto,'
      '       cr.descricao as DescricaoCargo,'
      '       estoques_preco(e.produto,e.filial,(Select pc.markup'
      '                                          from produtoscargos pc'
      
        '                                          where pc.cargo = cr.co' +
        'digo'
      
        '                                          and pc.produto = e.pro' +
        'duto)) as valorproduto'
      'from estoques e'
      
        '     join (produtos p left join promocoes pro on p.promocao = pr' +
        'o.codigo)'
      
        '          join caracteristicas c  join marcas m on c.marca = m.c' +
        'odigo join grupos g on c.grupo = g.codigo join classes cl on c.c' +
        'lasse = cl.codigo'
      '          on p.caracteristica = c.codigo'
      '     on e.produto = p.codigo'
      ''
      '     join produtoscargos pc'
      '          join  cargos cr on pc.cargo = cr.codigo'
      '     on e.produto = pc.produto'
      'where true'
      '/*  %ParametroFilial_1 */'
      ''
      
        '/*  %ParametroProduto_1      NAO RETIRE A LINHA EM BRANCO KIRIDO' +
        ' */'
      ''
      '/*  %ParametroMarca_1 */'
      ''
      '/* %ParametroPromocoes_1 */'
      ''
      '/*  %ParametroGrupo_1 */'
      ''
      '/*  %ParametroClasse_1 */'
      ''
      '/*  %ParametroFornecedor_1 */'
      ''
      '/*  %SQLSituacaoProdutos_1 */'
      ''
      'order by e.produto, p.descricao, cr.descricao'
      ''
      ''
      #39','
      ''
      #39
      ''
      'Select distinct cr.descricao as DescricaoCargo'
      'from estoques e'
      
        '     join (produtos p left join promocoes pro on p.promocao = pr' +
        'o.codigo)'
      
        '          join caracteristicas c join marcas m on c.marca = m.co' +
        'digo join grupos g on c.grupo = g.codigo  join classes cl on c.c' +
        'lasse = cl.codigo'
      '          on p.caracteristica = c.codigo'
      '     on e.produto = p.codigo'
      ''
      '     join produtoscargos pc'
      '          join  cargos cr'
      '          on pc.cargo = cr.codigo'
      '     on e.produto = pc.produto'
      'where true'
      '/*  %ParametroFilial_2 */'
      ''
      '/*  %ParametroProduto_2   NAO RETIRE A LINHA EM BRANCO KIRIDO */'
      ''
      '/*  %ParametroMarca_2 */'
      ''
      '/* %ParametroPromocoes_2 */'
      ''
      '/*  %ParametroGrupo_2 */'
      ''
      '/*  %ParametroClasse_2 */'
      ''
      '/*  %ParametroFornecedor_2 */'
      ''
      '/*  %SQLSituacaoProdutos_2 */'
      ''
      'order by cr.descricao'
      #39
      ')'
      ''
      'AS'
      ' ('
      '   Produto bigint,'
      '   DescricaoProduto varchar(100),'
      '   %CamposdeCargos'
      ''
      '   /*'
      '   TABELA_DE_BALCAO numeric(15,2),'
      '   TABELA_DE_CLINICA numeric(15,2),'
      '   TABELA_DE_ESTUDANTE numeric(15,2),'
      '   TABELA_DE_FISIO numeric(15,2),'
      '   TABELA_DE_OUTRAS_ESPECIALIDADE numeric(15,2),'
      '   TABELA_DE_TATTOO numeric(15,2)'
      '   */'
      ''
      ')'
      ''
      '%WhereOrdenacao'
      ''
      ''
