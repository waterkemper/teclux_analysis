        Name = 'WhereSituacoes'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'WhereOrdenacao'
        ParamType = ptUnknown
        Value = 
          'Order By UPPER(TO_ASCII(m.descricao,'#39'LATIN1'#39')), UPPER(TO_ASCII(p' +
          '.descricao,'#39'LATIN1'#39')), p.valorgrade1, p.valorgrade2, p.codigo'
      end>
    Sql.Strings = (
      
        'Select distinct(p.codigo) as codigoproduto, p.descricao, p.valor' +
        'grade1, p.valorgrade2,'
      
        '           cast(p.descricao||'#39' '#39'||coalesce(p.valorgrade1,'#39#39')||'#39' ' +
        #39'||coalesce(p.valorgrade2,'#39#39')as varchar) as produto,'
      '           p.referencia,'
      '           m.codigo as codigomarca,'
      '           m.descricao as marca,'
      '           g.codigo as codigogrupo,'
      '           cp.valor as valor,'
      
        '           case when (((select estoques_produtoempromocao(p.codi' +
        'go,:filial)) = True) and (cp.coluna =:colunapromocao)) then'
      '                 cast('#39'P'#39' as varchar)'
      '           else  cast(null as varchar)  end as tipopreco,'
      '           case when :DataAlteracao is not null then'
      
        '              (case when cp.alteracao >= :DataAlteracao then cp.' +
        'alteracao else cast(null as date) end)'
      '           else cast(null as date) end as alteracao,'
      '           cp.validade,'
      '           (select f.nome'
      
        '            from fornecedoresprodutos fp join fornecedores f on ' +
        ' fp.fornecedor=f.codigo'
      '            where fp.caracteristica = c.codigo'
      '            order by fp.data limit 1) as nomefornecedor,'
      '            CodigoBarras(p.Codigo) AS CodigoBarras,'
      '            p.codigovisual'
      ''
      'From   (colunasprecos cp join ((((caracteristicas c'
      
        '                                  join ((produtos p left join pr' +
        'omocoes pro on p.promocao = pro.codigo)'
      '                                        left join estoques e'
      '                                        on p.codigo = e.produto'
      '                                        and e.filial = :filial)'
      
        '                                  on c.codigo = p.caracteristica' +
        ')'
      ''
      '                                 join marcas m'
      '                                 on c.marca = m.codigo)'
      ''
      '                                join grupos g'
      '                                on c.grupo = g.codigo)'
      ''
      '                               join classes cl'
      '                               on c.classe = cl.codigo)'
      ''
      '                         on cp.caracteristica = c.codigo)'
      ''
      'Where cp.preco = p.preco and'
      
        '      coalesce(cp.alteracao,cp.data) between :dataInicial and :d' +
        'atafinal'
      ''
      '%WhereColuna'
      '%WhereFilial'
      '%WhereProduto'
      '%WhereMarca'
      '%ListaCondicionalPromocoes'
      '%WhereGrupo'
      '%whereClasse'
      '%WhereFornecedor'
      '%WhereValidade'
      '%WhereSituacoes'
      '%WhereOrdenacao'
      ''
      ''
      '      ')
    RequestLive = False
    Left = 61
    Top = 17
    ParamData = <
      item
        DataType = ftInteger
        Name = 'filial'
        ParamType = ptInput
      end
      item
