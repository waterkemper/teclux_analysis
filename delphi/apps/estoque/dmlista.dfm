  object qryListaDescricao: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'ParametroFilial_2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ParametroProduto_2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ParametroMarca_2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ParametroPromocoes_2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ParametroGrupo_2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ParametroClasse_2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ParametroFornecedor_2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SQLSituacaoProdutos_2'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select distinct cr.descricao as DescricaoCargo'
      'from estoques e'
      
        '     join (produtos p left join promocoes pro on p.promocao = pr' +
        'o.codigo)'
      
        '          join caracteristicas c join marcas m on c.marca = m.co' +
        'digo join grupos g on c.grupo = g.codigo join classes cl on c.cl' +
        'asse = cl.codigo'
      '          on p.caracteristica = c.codigo'
      '     on e.produto = p.codigo'
      ''
      '     join produtoscargos pc'
      '          join  cargos cr'
      '          on pc.cargo = cr.codigo'
      '     on e.produto = pc.produto'
      'where true'
      '  %ParametroFilial_2'
      ''
      
        '  %ParametroProduto_2   /* NAO RETIRE A LINHA EM BRANCO KIRIDO *' +
        '/'
      ''
      '  %ParametroMarca_2'
      ''
      '  %ParametroPromocoes_2 '
      ''
      '  %ParametroGrupo_2'
      ''
      '  %ParametroClasse_2'
      ''
      '  %ParametroFornecedor_2'
      ''
      '  %SQLSituacaoProdutos_2'
      '  '
      'order by cr.descricao')
    RequestLive = False
    Left = 56
    Top = 264
    object qryListaDescricaodescricaocargo: TStringField
      FieldName = 'descricaocargo'
      Size = 30
    end
  end
