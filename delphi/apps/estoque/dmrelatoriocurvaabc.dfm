    Sql.Strings = (
      ' select abc.*,codigobarras(produtos.codigo) as codigo_barras'
      ' from abc_prod(cast(:perc_A as integer),'
      '                                  cast(:perc_B as integer),'
      '                                  cast(:perc_C as integer),'
      
        '                                  cast(:TipoAnalise as smallint)' +
        ','
      
        '                                  cast(:TipoCurvaABC as smallint' +
        '),'
      
        '                                  cast(:TipoFiltroProdutos as sm' +
        'allint),'
      '                                  cast(:Quantidade as integer),'
      '                                  cast(:Produto as bigint),'
      '                                  cast(:Grupo as varchar),'
      '                                  cast(:Classe as varchar),'
      '                                  cast(:Marca as smallint),'
      '                                  cast(:ordenacao as varchar),'
      #9#9'      cast(:datainicial as varchar),'
      #9#9'      cast(:datafinal as varchar),'
      #9#9'      cast(:filiais as varchar),'
      '          cast(:filiaisestoque as varchar),'
      '          cast(:filiaismovimento as varchar),'
      #9#9'      cast(:produtos as varchar),'
      #9#9'      cast(:linha as varchar),'
      #9#9'      cast(:ativo as varchar),'
      #9#9'      cast(:montagem as varchar),'
      
        #9#9'      cast(:brinde as varchar)) as abc left join produtos on (' +
        'abc.codigo=produtos.codigo);'
      '')
