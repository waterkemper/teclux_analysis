procedure TdtmRelatorioCurvaABC.AtualizarResultadoCurvaABC;
begin
  qryAtualizarProdutos.Sql.Clear;
  qryAtualizarProdutos.sql.Append('update produtos set resultadocurvaabc = null, veiodatriggercaracteristicas = true where resultadocurvaabc is not null;');

  GuardarRegistroAtual(qryVendas,true);
  qryvendas.First;
  while not qryvendas.Eof do
  begin
    qryAtualizarProdutos.sql.Append(format('update produtos set resultadocurvaabc = %s, veiodatriggercaracteristicas = true where codigo = %s;',[quotedstr(qryVendastipo.AsString), qryVendascodigo.AsString]));
    qryVendas.Next;
  end;
  VoltarRegistroAtual(qryVendas);

  qryAtualizarProdutos.ExecSql;
  perpetrar([]);

end;

