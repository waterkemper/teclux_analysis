procedure TdtmRelatorioCurvaABC.GravarExcel;
var
  Excel, oWB, oSheet: Variant;
  Linha, QtdeLinhas, Planilhas, NumeroLinhas: integer;
  Pos: TBookmark;
begin
  QtdeLinhas:= 64;
  NumeroLinhas:= 1;
  Excel:= CreateOleObject('Excel.Application');
  Excel.Visible:= False;

  oWB := Excel.Workbooks.Add;
  oSheet := oWB.ActiveSheet;

  {
  case ftipoCurvaABC of
    0,1,2: Excel.WorkBooks.Open(ExtractFilePath(Application.ExeName)+'CurvaABC.xls');
    3:     Excel.WorkBooks.Open(ExtractFilePath(Application.ExeName)+'CurvaABCFornecedores.xls');
    4:     Excel.WorkBooks.Open(ExtractFilePath(Application.ExeName)+'CurvaABCGrupos.xls');
  end;
  }

  Excel.WorkBooks[1].Sheets[1].Cells[1,1]:= fTitulo;
  Excel.WorkBooks[1].Sheets[1].Cells[3,1]:= fSubtitulo;
  Excel.WorkBooks[1].Sheets[1].Cells[5,1]:= RazaoFilialBase;
  Excel.WorkBooks[1].Sheets[1].Cells[6,1]:= RuaFilialBase+' - '+BairroFilialBase;
  Excel.WorkBooks[1].Sheets[1].Cells[7,1]:= 'CEP: '+CEPFilialBase+ ' - '+CidadeFilialBase+' - '+EstadoFilialBase;


  Excel.WorkBooks[1].Sheets[1].Cells[1,12]:= Now;
  Excel.WorkBooks[1].Sheets[1].Cells[2,12]:= 1;
  Excel.WorkBooks[1].Sheets[1].Cells[4,6]:= fOutras;

  Excel.WorkBooks[1].Sheets[1].Cells[7,6]:= 'Em Linha';
  if fEmLinha then
    Excel.WorkBooks[1].Sheets[1].Cells[7,5]:= 'X'
  else
    Excel.WorkBooks[1].Sheets[1].Cells[7,5]:= '';

  Excel.WorkBooks[1].Sheets[1].Cells[7,9]:= 'Com Montagem';
  if fComMontagem then
    Excel.WorkBooks[1].Sheets[1].Cells[7,8]:= 'X'
  else
    Excel.WorkBooks[1].Sheets[1].Cells[7,8]:= '';

  Excel.WorkBooks[1].Sheets[1].Cells[7,12]:= 'Brinde';
  if fBrinde then
    Excel.WorkBooks[1].Sheets[1].Cells[7,11]:= 'X'
  else
    Excel.WorkBooks[1].Sheets[1].Cells[7,11]:= '';

  Excel.WorkBooks[1].Sheets[1].Cells[8,6]:= 'Fora de Linha';
  if fForadeLinha then
    Excel.WorkBooks[1].Sheets[1].Cells[8,5]:= 'X'
  else
    Excel.WorkBooks[1].Sheets[1].Cells[8,5]:= '';


  Excel.WorkBooks[1].Sheets[1].Cells[8,9]:= 'Sem Montagem';
  if fSemMontagem then
    Excel.WorkBooks[1].Sheets[1].Cells[8,8]:= 'X'
  else
    Excel.WorkBooks[1].Sheets[1].Cells[8,8]:= '';


  Excel.WorkBooks[1].Sheets[1].Cells[8,12]:= 'Não Brinde';
  if fNaoBrinde then
    Excel.WorkBooks[1].Sheets[1].Cells[8,11]:= 'X'
  else
    Excel.WorkBooks[1].Sheets[1].Cells[8,11]:= '';

  Linha:= 13;

  Pos:= qryVendas.GetBookmark;
  qryVendas.DisableControls;
  qryVendas.First;
  while not qryVendas.Eof do
  begin
    case ftipoCurvaABC of
