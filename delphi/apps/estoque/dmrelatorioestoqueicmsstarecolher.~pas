procedure Tdtmrelatorioestoqueicmsstarecolher.qryProdutosSTaRecolherCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  qryProdutosSTaRecolherValorICMS.AsCurrency := truncar(((qryProdutosSTaRecolherquantidade.AsCurrency *
                                                         qryProdutosSTaRecolherprecounitario.AsCurrency) *
                                                         qryProdutosSTaRecolheraliquotaicms.AsCurrency / 100),2);

  qryProdutosSTaRecolherValorIPI.AsCurrency := truncar((qryProdutosSTaRecolherquantidade.AsCurrency *
                                               qryProdutosSTaRecolherprecounitario.AsCurrency +

                                                truncar(((qryProdutosSTaRecolherquantidade.AsCurrency *
                                                         qryProdutosSTaRecolherprecounitario.AsCurrency) *
                                                         qryProdutosSTaRecolheraliquotaipi.AsCurrency / 100),2)),2);

  qryProdutosSTaRecolherBaseICMSSubstituicao.AsCurrency := truncar(((1 + qryEstoquemva.AsCurrency /100) * qryProdutosSTaRecolherValorIPI.AsCurrency),2);

  if qryProdutosSTaRecolherestado.AsString <> 'SC' then
    qryProdutosSTaRecolherBaseICMSSubstituicao.AsCurrency := truncar((qryProdutosSTaRecolherBaseICMSSubstituicao.AsCurrency * 0.88/ 0.83),2);

  qryProdutosSTaRecolherValorICMSSubstituicao.AsCurrency := truncar((qryProdutosSTaRecolherBaseICMSSubstituicao.AsCurrency * qryEstoquealiquotaicms.AsCurrency / 100),2)
                                                           { - qryProdutosSTaRecolherValorICMS.AsCurrency};

end;

