procedure Tdtmrelatorioestoqueicmsstarecolher.ImprimirRelatorio;
var
  Relatorio: TfrReport;
  frmPreview: TfrmPreviewPadrao;
  vSaldoQuantidade : Currency;
  vProduto : String;

  ListaProdutos : TStringList;
  vStringLista: String;
  i : integer;

begin

  ListaProdutos := tStringlist.create;
  vStringLista := '';

  if FileExists(ExtractFilePath(Application.ExeName) + 'listaprodutos.txt') then
  begin
    ListaProdutos.loadfromfile(ExtractFilePath(Application.ExeName) + 'listaprodutos.txt');
    for i:=0 to listaprodutos.Count-1  do
      vStringLista := vStringLista + ListaProdutos.Strings[i];

    {qryEstoque.MacroByName('ListaProdutos').AsString := 'and m1.produto not in ('+vStringLista+')';}
    qryEstoque.MacroByName('ListaProdutos').AsString := 'where estoquetotal.codigoitem not in ('+vStringLista+')';

    qryProdutosNotasPag.MacroByName('ListaProdutos').AsString := 'and pnp.produto not in ('+vStringLista+')';
  end
  else
    MensagemErro(format(ctARQUIVONAOENCONTRADO,[ExtractFilePath(Application.ExeName)+'listaprodutos.txt']));

  qryProdutosSTaRecolher.close;
  qryProdutosSTaRecolher.Open;
  RefazConsultaPorNome(qryEstoque, ['datainventario'], [datainventario]);
  RefazConsultaPorNome(qryProdutosNotasPag, ['datainventario'], [datainventario]);


  vSaldoQuantidade := 0;

  qryEstoque.First;

  vProduto := '';
  while not qryEstoque.Eof do
  begin

    {
    if vProduto <> qryEstoquecodigoitem.AsString then
    begin

      RefazConsultaPorNome(qryProdutosNotasPag, ['DataInventario','produto'],
         [FormatDateTime('YYYY-MM-DD',DataInventario), qryEstoquecodigoitem.AsVariant]);
      vProduto := qryProdutosNotasPagproduto.AsString;
    end;
    }

    vSaldoQuantidade := qryEstoqueQtdestoquefilial.AsCurrency;

    qryProdutosNotasPag.first;
    while not qryProdutosNotaspag.Eof do
    begin
      if qryProdutosNotasPagquantidade.AsCurrency > 0 then
      begin
        if vSaldoQuantidade <= qryProdutosNotasPagquantidade.AsCurrency then
        begin
          qryProdutosSTaRecolher.Append;
          qryProdutosSTaRecolherfornecedor.AsInteger    := qryProdutosNotasPagfornecedor.AsInteger;
          qryProdutosSTaRecolhertipofornecedor.AsString := qryProdutosNotasPagtipofornecedor.AsString;
          qryProdutosSTaRecolherestado.AsString        := qryProdutosNotasPagestado.AsString;
          qryProdutosSTaRecolherserie.AsString         := qryProdutosNotasPagserie.AsString;
          qryProdutosSTaRecolhernumeronota.AsInteger    := qryProdutosNotasPagnumeronota.AsInteger;

          qryProdutosSTaRecolherproduto.AsString    := qryEstoquecodigoitem.AsString;
          qryProdutosSTaRecolherfilial.AsInteger    := qryEstoquefilial.AsInteger;

          qryProdutosSTaRecolherquantidade.AsCurrency    := vSaldoQuantidade;
          vSaldoQuantidade := vSaldoQuantidade - qryProdutosSTaRecolherquantidade.AsCurrency;

          qryProdutosSTaRecolherprecounitario.AsCurrency := qryProdutosNotasPagprecounitario.AsCurrency;
          qryProdutosSTaRecolheraliquotaipi.AsCurrency   := qryProdutosNotasPagaliquotaipi.AsCurrency;
          qryProdutosSTaRecolheraliquotaicms.AsCurrency  := qryProdutosNotasPagaliquotaicms.AsCurrency;

          qryProdutosSTaRecolher.post;


          qryProdutosNotasPag.Edit;
          qryProdutosNotasPagquantidade.AsCurrency := qryProdutosNotasPagquantidade.AsCurrency -
                                                      qryProdutosSTaRecolherquantidade.AsCurrency;
          qryProdutosNotasPag.post;

          break;
        end
        else
        begin
          qryProdutosSTaRecolher.Append;
          qryProdutosSTaRecolherfornecedor.AsInteger    := qryProdutosNotasPagfornecedor.AsInteger;
          qryProdutosSTaRecolhertipofornecedor.AsString := qryProdutosNotasPagtipofornecedor.AsString;
          qryProdutosSTaRecolherestado.AsString        := qryProdutosNotasPagestado.AsString;
          qryProdutosSTaRecolherserie.AsString         := qryProdutosNotasPagserie.AsString;
          qryProdutosSTaRecolhernumeronota.AsInteger    := qryProdutosNotasPagnumeronota.AsInteger;

          qryProdutosSTaRecolherproduto.AsString    := qryEstoquecodigoitem.AsString;
          qryProdutosSTaRecolherfilial.AsInteger    := qryEstoquefilial.AsInteger;
          
          qryProdutosSTaRecolherquantidade.AsCurrency    := qryProdutosNotasPagquantidade.AsCurrency;
          vSaldoQuantidade := vSaldoQuantidade - qryProdutosSTaRecolherquantidade.AsCurrency;

          qryProdutosSTaRecolherprecounitario.AsCurrency := qryProdutosNotasPagprecounitario.AsCurrency;
          qryProdutosSTaRecolheraliquotaipi.AsCurrency   := qryProdutosNotasPagaliquotaipi.AsCurrency;
          qryProdutosSTaRecolheraliquotaicms.AsCurrency  := qryProdutosNotasPagaliquotaicms.AsCurrency;

          qryProdutosSTaRecolher.post;

          qryProdutosNotasPag.Edit;
          qryProdutosNotasPagquantidade.AsCurrency := 0;
          qryProdutosNotasPag.post;

          qryProdutosNotaspag.Next;
        end;
      end
      else
        qryProdutosNotaspag.Next;

    end;

    if (vSaldoQuantidade <> 0) and (vSaldoQuantidade <> qryEstoqueQtdestoquefilial.AsCurrency) then
    begin
      qryestoque.Edit;
      qryEstoqueQtdestoquefilial.AsCurrency := qryEstoqueQtdestoquefilial.AsCurrency - vSaldoQuantidade;
      qryestoque.Post;
    end;

    if qryProdutosSTaRecolher.RecordCount = 0 then
    begin
    {
      qryEstoque.next;
      if not qryestoque.Eof then
      begin
        GuardarRegistroAtual(qryestoque,false);
        qryEstoque.Prior;
        qryestoque.Delete;
        VoltarRegistroAtual(qryestoque);
      end
      else
      begin
        qryEstoque.delete;
        qryEstoque.next;
      end;
     }
     qryestoque.Delete;
    end
    else
      qryEstoque.next;

  end;

//  qryProdutosSTaRecolher.MasterSource := dsrEstoque;
//  qryProdutosSTaRecolher.LinkFields := 'codigoitem=produto,filial=filial';

  qryEstoque.Filtered := false;
  qryEstoque.Filtered := true;
  qryEstoque.Filter := 'filial = '+inttostr(Filial);

  qryProdutosSTaRecolher.Filtered := false;
  qryProdutosSTaRecolher.Filtered := true;
  qryProdutosSTaRecolher.Filter := 'filial = '+inttostr(Filial);


  AtribuirParametrosBaseRelatorio(inttostr(Filial));

  frVariables['Titulo']:= 'INVENTÁRIO DOS PRODUTOS';
  frVariables['subTitulo']:= 'SUJEITOS À ST EM '+datetostr(FDataInventario);

  frVariables['Livro']:=FParametroLivro;
  frVariables['Pagina']:=FParametroPagina;
  frVariables['Maximo']:=FParametroMaximo;


  frmPreview := TfrmPreviewPadrao.create(self);
  frmPreview.cmbZoom.ItemIndex := 2;
  try
    Relatorio := frmPreview.frCompositeReport;
     with frmPreview do
     begin
       frCompositeReport.Reports.Clear;
//       frCompositeReport.DoublePass:= True;
       frpEstoqueICMSSTaRecolher.DesignReport;
       frxReport1.DesignReport;

       frCompositeReport.Reports.Add(frpEstoqueICMSSTaRecolher);
     end;
     Relatorio.Preview := frmPreview.frPreviewPadrao;
     Relatorio.ShowReport;
     frmPreview.ShowModal;
  finally
    frmPreview.Free;
    qryEstoque.Filtered := false;
    qryProdutosSTaRecolher.Filtered := false;
  end;
end;



