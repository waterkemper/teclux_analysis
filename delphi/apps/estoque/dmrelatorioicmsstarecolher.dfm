  object qryNotasFiscaisEntrada: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Wherefilial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereFornecedor'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WherePeriodo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereProduto'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';SELECT *'
      'FROM'
      '(select distinct np.codigo,'
      '       np.fornecedor,'
      '       np.tipofornecedor,'
      
        '       (select coalesce(vf.razao,vf.nome) as nome  from vfornece' +
        'dores vf where vf.codigo = np.fornecedor and vf.tipo = np.tipofo' +
        'rnecedor) as nome,'
      '       fgf.grupo as grupofilial,'
      '       gf.descricao as nomegrupofilial,'
      '       np.filial as filial,'
      '       f.nome as nomefilial,'
      '       np.serie,'
      '       np.numero,'
      '       np.codigofiscal,'
      '       np.natureza,'
      '       np.data,'
      '       np.emissao,'
      '       np.valornota,'
      '       np.documentopag,'
      '       np.valoricmssubstituicao'
      
        'from (notaspag np join (filiais f left join (filiaisgruposfiliai' +
        's fgf join gruposfiliais gf on fgf.grupo=gf.codigo)'
      '                                         on f.codigo=fgf.filial)'
      '                    on np.filial=f.codigo)'
      
        '                  join (produtosnotaspag pnp join (produtos p jo' +
        'in caracteristicas c on p.caracteristica = c.codigo) on pnp.prod' +
        'uto = p.codigo) on pnp.codigonota = np.codigo'
      ''
      
        '    WHERE (((np.CRT =  1 AND COALESCE(pnp.CSOSN_NF, '#39#39') IN ('#39'600' +
        #39','#39'201'#39','#39'202'#39','#39'203'#39')) OR'
      
        '            (np.crt <> 1 AND (COALESCE(pnp.CST_NF,  '#39#39') IN ('#39'10'#39 +
        ', '#39'30'#39', '#39'70'#39') OR'
      
        '                             (COALESCE(pnp.CST_NF,  '#39#39') IN ('#39'90'#39 +
        ') AND pnp.ICMSValorST > 0))) )'
      ''
      
        '       OR (((np.CRT =  1 AND COALESCE(pnp.CSOSN_NF,'#39#39') <> '#39'500'#39')' +
        ' OR'
      
        '            (np.CRT <> 1 AND COALESCE(pnp.CST_NF,  '#39#39') NOT IN ('#39 +
        '40'#39','#39'60'#39'))) AND'
      
        '           ((np.RegimeTributario <> 1 AND COALESCE(pnp.CST_Produ' +
        'to,  '#39#39') = '#39'60'#39') OR'
      
        '            (np.RegimeTributario =  1 AND COALESCE(pnp.CSOSN_Pro' +
        'duto,'#39#39') = '#39'500'#39' ))) )'
      ''
      '      AND NOT COALESCE(np.PermitirImprimir, FALSE)'
      '      AND np.Situacao = '#39'N'#39
      #9'    AND EhNotaFiscalEntradaCompra(pnp.CodigoFiscal)'
      ''
      ''
      ''
      
        '/*  and not coalesce((select f.NaoSubstituto from fornecedores f' +
        ' where f.codigo = np.fornecedor and np.tipofornecedor='#39'F'#39'),false' +
        ')'
      
        '  and not coalesce((select f.distribuidor from fornecedores f wh' +
        'ere f.codigo = np.fornecedor and np.tipofornecedor='#39'F'#39'),false) *' +
        '/'
      ''
      '%Wherefilial'
      '%WhereFornecedor'
      '%WherePeriodo'
      '%WhereProduto'
      ''
      ')as p'
      'order by fornecedor, codigo'
      '')
    RequestLive = False
    Left = 80
    Top = 32
