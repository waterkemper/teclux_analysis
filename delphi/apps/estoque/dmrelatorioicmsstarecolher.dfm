  object qryProdutosNotasEntrada: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'codigo = codigonota'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrNotasFiscaisEntrada
    Constraints = <>
    BeforeOpen = qryProdutosNotasEntradaBeforeOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftString
        Name = 'Codigos'
        ParamType = ptUnknown
        Value = '0'
      end
      item
        DataType = ftUnknown
        Name = 'WhereProduto'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      ''
      
        '/*--------------------------------------------------------------' +
        '----------------'
      
        'A Secretaria de Estado da Fazenda de Santa Catarina publicou o D' +
        'ecreto n'#186' 306, de 14 de junho de'
      
        '2011, o qual regulamentou, no territ'#243'rio catarinense, o benef'#237'ci' +
        'o de que trata o Conv'#234'nio ICMS n'#186
      
        '35/2011, segundo o qual nas opera'#231#245'es interestaduais, com destin' +
        'o a SC, se o fornecedor do outro'
      
        'Estado for optante pelo Simples Nacional, o ICMS a recolher por ' +
        'substitui'#231#227'o tribut'#225'ria para SC ser'#225
      
        'recolhido com a utiliza'#231#227'o da MVA Original prevista no RICMS-SC/' +
        '01 para a mercadoria, e n'#227'o com a'
      
        'MVA Ajustada, independentemente de a empresa adquirente de SC se' +
        'r, ou n'#227'o, optante pelo Simples'
      'Nacional.'
      ''
      
        'Esse benef'#237'cio entra em vigor, no territ'#243'rio catarinense, com ef' +
        'eitos retroativos a 1'#186' de junho de'
      
        '2011, e poder'#225' ser utilizado juntamente com o benef'#237'cio de redu'#231 +
        #227'o da MVA em 70./., mas isso desde'
      
        'que a empresa adquirente, de SC, seja optante pelo Simples Nacio' +
        'nal (Decreto n'#186' 3.467/2010).'
      ''
      'Ent'#227'o, via de regra'
      ''
      
        'a) se o fornecedor for do Simples Nacional e empresa adquirente ' +
        'n'#227'o for utiliza-se a a MVA original,'
      
        '   sem redu'#231#227'o em 70 ./.;                                       ' +
        '                         TRUE  FALSE'
      ''
      
        'b) se o fornecedor for do Simples Nacional e empresa adquirente ' +
        'tamb'#233'm utiliza-se a MVA original'
      
        '   reduzida em 70./.;                                           ' +
        '                         TRUE  TRUE'
      ''
      
        'c) se o fornecedor n'#227'o for do Simples Nacional e empresa adquire' +
        'nte tamb'#233'm n'#227'o for utiliza-se a MVA'
      
        '   ajustada, sem a redu'#231#227'o em 70./.;                            ' +
        '                         FALSE FALSE'
      ''
      
        'd) se o fornecedor n'#227'o for do Simples Nacional, e empresa adquir' +
        'ente '#233' do Simples Nacional utiliza-'
      
        '   se a MVA Ajustada reduzida em 70./..                         ' +
        '                         FALSE TRUE'
      
        '----------------------------------------------------------------' +
        '--------------*/'
      ''
      ''
      'SELECT p5.*,   '
      '       CASE WHEN vBCST = 0'
      '            THEN 0'
      
        '            ELSE TRUNC((vBCST * (pICMS_dentro / 100)  ), 2) - vI' +
        'CMS'
      '       END AS vICMSST'
      'FROM'
      ''
      '('
      ' select p4.*,'
      '        CASE WHEN Fator = 0'
      '             THEN 0'
      
        '             ELSE TRUNC((vProd + vOutro + valoripi) * (1 - predb' +
        'cst / 100) * (1 + MVAAjustado / 100), 2)'
      #9#9' '
      '        END AS vBCST'
      ' from'
      '('
      ' SELECT p3.*,'
      '        CASE WHEN Fator = 0'
      '             THEN 0'
      
        '             ELSE TRUNC(100 * ((1 + (Fator - 1) * AjusteMVA) * E' +
        'qualizacao - 1), 2)'
      
        '/*           ELSE TRUNC((Fator - 1) * 100 * AjusteMVA * Equaliza' +
        'cao, 2) */'
      '        END AS MVAAjustado'
      ''
      ''
      ' FROM'
      ''
      ' ('
      '  SELECT p2.*,'
      '         TRUNC(vBC * pICMS/100  , 2) AS vICMS,'
      ''
      '         CASE WHEN ICMSCaracteristica IS NULL'
      '             THEN 0.00'
      '             ELSE TRUNC(vBC * (picms_dentro / 100), 2)'
      '         END AS ICMSDentro,'
      ''
      ''
      '         CASE WHEN (SELECT c.ICMS'
      '                       FROM Produtos p'
      
        '                            JOIN Caracteristicas c ON c.Codigo =' +
        ' p.Caracteristica AND'
      
        '                                                      p.Codigo =' +
        ' Produto) IS NULL'
      '              THEN 0.00'
      '              ELSE TRUNC(vBC * (picms / 100), 2)'
      '         END AS ICMSFora,'
      ''
      
        '         CASE WHEN :RegimeTributario = 1                        ' +
        '            /* Empresa no SIMPLES */'
      '              THEN 1.00 - 0.70'
      '              ELSE 1.00'
      '         END AS AjusteMVA,'
      ''
      
        '         CASE WHEN (EstadoNota = :EstadoFilial) OR (CRT = 1)    ' +
        '         /* Fornecedor no SIMPLES */'
      '              THEN 1'
      '              ELSE (1 - pICMS / 100) / (1 -pICMS_dentro / 100)'
      '         END AS Equalizacao         '
      ''
      '  FROM'
      ''
      '  ('
      
        '   SELECT CRT, Fornecedor, ValorICMSSubstituicao, EstadoNota, Nu' +
        'mero, FornecedorNoSimples, codigonota,'
      
        '          Produto, Quantidade, PrecoUnitario, vProd, ((vprod+vOu' +
        'tro+ValoricmssSobreIPI+valoricmssobredespesasacessorias) * (1 - ' +
        'predbc / 100))  as vBC, valoripi,'
      '          vOutro, CodigoCaracteristica,'
      
        '          NomeProduto, ICMSCaracteristica, predbc,  predbcst, nc' +
        'm, pICMS, Fator,'
      
        '                                                                ' +
        '                      /* Em 30/MAI/2019, na reuni'#227'o do Alto  Com' +
        'ando'
      
        '                                                                ' +
        '                         das situa'#231#245'es para ICMS ST resolveu com' +
        'entar'
      
        '                                                                ' +
        '                         o trecho abaixo porque o calculo do ICM' +
        'S ST'
      
        '                                                                ' +
        '                         na Apol'#244'nia, NF 93 1 63.055 n'#227'o fechava' +
        ' */'
      
        '          CASE WHEN /* (EstadoNota =  :EstadoFilial AND pICMS_de' +
        'ntro <> pICMS) OR */'
      
        '                    (EstadoNota <> :EstadoFilial AND pICMS_dentr' +
        'o <  pICMS)'
      '               THEN pICMS'
      '               ELSE pICMS_dentro'
      '          END AS pICMS_dentro'
      '   FROM'
      ''
      '   ('
      '    SELECT np.CRT, np.Fornecedor,'
      '           np.ValorICMSSubstituicao,'
      '           np.Estado AS EstadoNota,'
      '           np.Numero,'
      ''
      '          (SELECT COALESCE(f.NoSimples, FALSE)'
      '              FROM Fornecedores f'
      
        '              WHERE f.Codigo = np.Fornecedor) AS FornecedorNoSim' +
        'ples,'
      ''
      '           pnp.codigonota,'
      '           pnp.Produto,'
      '           pnp.Quantidade,'
      '           pnp.PrecoUnitario,'
      ''
      
        '           TRUNC((pnp.Quantidade * pnp.PrecoUnitario), 2) AS vPr' +
        'od,'
      ''
      '           COALESCE(pnp.Frete, 0)   + COALESCE(pnp.Seguro,0) - '
      
        '           COALESCE(pnp.Desconto,0) - COALESCE(pnp.ValorDesconto' +
        'Item,0) AS vOutro,'
      ''
      '           CASE WHEN COALESCE(pnp.ICMSSobreIPI, FALSE)'
      '                THEN COALESCE(pnp.ValorIPI, 0)'
      '                ELSE 0'
      '           END AS ValoricmssSobreIPI,'
      '           '
      
        '           CASE WHEN COALESCE(pnp.ICMSSobreDespesasAcessorias, F' +
        'ALSE)'
      '                THEN COALESCE(pnp.DespesasAcessorias, 0)'
      '                ELSE 0'
      '           END AS ValorICMSSobreDespesasAcessorias,'
      ''
      '           COALESCE(pnp.ValorIPI, 0) AS ValorIPI,'
      ''
      '           c.Codigo AS CodigoCaracteristica,'
      ''
      
        '           CAST(SUBSTRING(p.Descricao,1,100) AS VARCHAR) AS Nome' +
        'Produto,'
      ''
      '           c.ICMS AS ICMSCaracteristica,'
      ''
      '           CASE WHEN :NCMEmpresa OR pnpnfei.CodigoNota IS NULL'
      '                THEN COALESCE(c.PercReducaoBase, 0)'
      '                ELSE COALESCE(pnpnfe.PRedBC,0)'
      '           END AS PRedBC,'
      ''
      '           CASE WHEN :NCMEmpresa OR pnpnfei.CodigoNota IS NULL'
      '                THEN COALESCE(c.PRedBCST, 0)'
      '                ELSE COALESCE(pnpnfe.PRedBCST, 0)'
      '           END AS PRedBCST,'
      ''
      '           CASE WHEN :NCMEmpresa OR pnpnfei.CodigoNota IS NULL'
      
        '                THEN (SELECT IPI.ClassificacaoFiscal FROM IPI WH' +
        'ERE IPI.Codigo = c.IPI)'
      '                ELSE pnpnfe.NCMFornecedor'
      '           END AS NCM,'
      ''
      
        '           CASE WHEN (pnp.AliquotaICMS IS NULL) OR (pnp.Aliquota' +
        'ICMS = 0)'
      
        '                THEN Selecionar_AliquotaICMS(np.Estado, :EstadoF' +
        'ilial, vf.pessoatipo, pnp.Produto)'
      '                ELSE pnp.AliquotaICMS'
      '           END AS pICMS,'
      ''
      
        '           Selecionar_AliquotaICMS(:EstadoFilial, :EstadoFilial,' +
        ' vf.pessoatipo, pnp.Produto) as pICMS_Dentro,'
      ''
      '           CASE WHEN :NCMEmpresa OR pnpnfei.CodigoNota IS NULL'
      
        '                THEN COALESCE((SELECT DISTINCT ei.FatorSubstitui' +
        'cao'
      '                                  FROM Caracteristicas c'
      
        '                                       JOIN Produtos p ON p.Cara' +
        'cteristica = c.Codigo'
      
        '                                       JOIN (IPI i JOIN EstadosI' +
        'PI ei ON ei.IPI    = i.Codigo AND'
      
        '                                                                ' +
        '         ei.Estado = :EstadoFilial)'
      '                                       ON c.IPI = i.Codigo'
      
        '                                  WHERE p.Codigo = pnp.Produto A' +
        'ND ei.Ativo), 0)'
      ''
      '                ELSE 1 + COALESCE(pnpnfe.pmvast, 0) / 100'
      '           END AS Fator'
      ''
      '    FROM Notaspag np'
      '         JOIN ((ProdutosNotaspag pnp'
      '               JOIN (Produtos p'
      '                     JOIN Caracteristicas c'
      #9#9#9#9#9' ON p.Caracteristica = c.Codigo)'
      '               ON pnp.Produto = p.Codigo)'
      ''
      '               LEFT JOIN (ProdutosNotasPagNFeItems pnpnfei'
      '                          JOIN ProdutosNotasPagNFe pnpnfe'
      
        '                          ON pnpnfei.CodigoNota = pnpnfe.codigoN' +
        'ota AND'
      
        '                             pnpnfei.NumeroSequenciaNFe = pnpnfe' +
        '.Numero)'
      
        '               ON pnpnfei.CodigoNota         = pnp.CodigoNota   ' +
        '       AND'
      
        '                  pnpnfei.NumeroSequenciaNFe = pnp.NumeroProduto' +
        'Tabela AND'
      '                  pnpnfei.Produto            = pnp.Produto)'
      ''
      '         ON pnp.CodigoNota = np.Codigo'
      ''
      
        '         JOIN vFornecedores vf ON np.Fornecedor = vf.Codigo AND ' +
        'vf.Tipo = np.TipoFornecedor'
      ''
      
        '    WHERE (((np.CRT =  1 AND COALESCE(pnp.CSOSN_NF, '#39#39') IN ('#39'600' +
        #39','#39'201'#39','#39'202'#39','#39'203'#39')) OR'
      
        '            (np.crt <> 1 AND (COALESCE(pnp.CST_NF,  '#39#39') IN ('#39'10'#39 +
        ', '#39'30'#39', '#39'70'#39') OR'
      
        '                             (COALESCE(pnp.CST_NF,  '#39#39') IN ('#39'90'#39 +
        ') AND pnp.ICMSValorST > 0))) )'
      ''
      
        '       OR (((np.CRT =  1 AND COALESCE(pnp.CSOSN_NF,'#39#39') <> '#39'500'#39')' +
        ' OR'
      
        '            (np.CRT <> 1 AND COALESCE(pnp.CST_NF,  '#39#39') NOT IN ('#39 +
        '40'#39','#39'60'#39'))) AND'
      
        '           ((np.RegimeTributario <> 1 AND COALESCE(pnp.CST_Produ' +
        'to,  '#39#39') = '#39'60'#39') OR'
      
        '            (np.RegimeTributario =  1 AND COALESCE(pnp.CSOSN_Pro' +
        'duto,'#39#39') = '#39'500'#39' ))) )'
      ''
      '      AND NOT COALESCE(np.PermitirImprimir, FALSE)'
      '      AND np.Situacao = '#39'N'#39
      #9'    AND EhNotaFiscalEntradaCompra(pnp.CodigoFiscal)'
      '      AND np.Codigo IN (%Codigos)'
      '      %WHEREProduto'
      ''
      '  ) AS p1b '
      ''
      '  ORDER BY Fornecedor, CodigoNota'
      ' ) as p2'
      ''
      ' ) AS p3'
      ') as p4'
      ') as p5'
      '')
    RequestLive = False
    Left = 248
    Top = 112
    ParamData = <
      item
        DataType = ftString
        Name = 'RegimeTributario'
        ParamType = ptUnknown
        Value = '1'
      end
      item
        DataType = ftString
        Name = 'EstadoFilial'
        ParamType = ptUnknown
        Value = 'SC'
      end
      item
        DataType = ftString
        Name = 'NCMEmpresa'
        ParamType = ptUnknown
        Value = 'True'
      end>
