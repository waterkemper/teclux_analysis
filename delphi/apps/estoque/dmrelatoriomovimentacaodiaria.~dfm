    Sql.Strings = (
      ';'
      
        'Select  data, processamento, filial, referencia, tipomovimento, ' +
        'emestoque, financeiro, precocomicms,'
      
        '          clientefornecedor, descricaoproduto, referenciaproduto' +
        ', referenciaprodutovisual,'
      
        '          localizacao, nomefilial, nomegrupofilial, codigogrupof' +
        'ilial, codigocaracteristica,'
      
        '          codigocaracteristicavisual, descricaocaracteristica, d' +
        'escricaomovimento,'
      '          grupoproduto, descricaogrupoproduto, descricaopreco,'
      ''
      '          case when (entradaousaida='#39'S'#39' and valor>0 ) then'
      '            -1*valor else valor end  as valor,'
      ''
      '          case when (entradaousaida='#39'S'#39' and quantidade>0)  then'
      '            -1*quantidade  else quantidade end as quantidade'
      'from'
      '('
      'select mov.*,'
      
        '       case when mov.financeiro > mov.financeiroanterior and mov' +
        '.valor<>0 then '#39'E'#39
      
        '  else case when mov.financeiro < mov.financeiroanterior and mov' +
        '.valor<>0   then '#39'S'#39' else '#39'X'#39' end end as entradaousaida'
      'from'
      '('
      'select movimentos.*,'
      '       COALESCE((SELECT m1.financeiro'
      '                  FROM movimentos m1'
      '                  WHERE m1.numero = (SELECT m2.numero'
      '                                         FROM movimentos m2'
      
        '                                         Where m2.produto=movime' +
        'ntos.referenciaproduto'
      
        '                                         AND m2.filial=Movimento' +
        's.filial'
      
        '                                         AND ((m2.data < Movimen' +
        'tos.data) OR (m2.data=movimentos.data and m2.lancto<movimentos.l' +
        'ancto))'
      
        '                                         ORDER BY m2.data DESC,m' +
        '2.lancto DESC LIMIT 1)),0)  AS financeiroanterior'
      'from'
      '('
      
        '  Select  cast(m.data as date) as data, m.processamento, m.lanct' +
        'o,'
      '          m.filial,'
      '          m.referencia,'
      '          m.quantidade,'
      '          m.tipomovimento,'
      '          m.emestoque,'
      '          m.valor,'
      '          m.financeiro,'
      '          m.precocomicms,'
      '          case when codigonota is null'
      '           then (select coalesce(v.razao,v.nome) as nome'
      '                 from vfornecedores v'
      
        '                 where (v.codigo = cliente) and (v.tipo = tipocl' +
        'iente)'
      '                )'
      '           else'
      '                (select coalesce(v.razao,v.nome) as nome'
      '                 from vfornecedores v'
      
        '                 where (v.codigo, v.tipo) in (select n.fornecedo' +
        'r,n.tipofornecedor'
      '                                              from notaspag n'
      
        '                                               where n.codigo = ' +
        'codigonota))'
      '          end as clientefornecedor,'
      
        '          cast(p.descricao||'#39' '#39'||coalesce(p.valorgrade1,'#39#39')||'#39' '#39 +
        '||coalesce(p.valorgrade2,'#39#39') as varchar) as descricaoproduto,'
      '          p.codigo as referenciaproduto,'
      '          p.codigovisual as referenciaprodutovisual,'
      '          e.localizacao,'
      '          f.nome as nomefilial,'
      '          gf.descricao as nomegrupofilial,'
      '          gf.codigo as codigogrupofilial,'
      '          c.codigo as codigocaracteristica,'
      '          c.codigovisual as codigocaracteristicavisual,'
      '          c.descricao as descricaocaracteristica,'
      '          tp.descricao as descricaomovimento,'
      '          c.grupo as grupoproduto,'
      '          gr.descricao as descricaogrupoproduto,'
      '          pr.descricao as descricaopreco'
      ''
      ''
      '  From    movimentos m'
      '          JOIN (filiais f'
      '                LEFT JOIN (filiaisgruposfiliais fgf'
      '                           JOIN gruposfiliais gf'
      '                           ON fgf.grupo=gf.codigo)'
      '                ON f.codigo=fgf.filial)'
      '          ON  f.codigo=m.filial'
      ''
      '          JOIN tiposmovimentos tp'
      '          ON m.tipomovimento = tp.codigo'
      ''
      '          JOIN produtos p'
      '               JOIN caracteristicas c'
      '                    JOIN grupos gr'
      '                    ON c.grupo = gr.codigo'
      '               ON  p.caracteristica=c.codigo'
      ''
      '               JOIN precos pr'
      '               on pr.caracteristica = p.caracteristica'
      '               and pr.codigo = p.preco'
      ''
      '          ON m.produto = p.codigo'
      ''
      '          JOIN estoques e'
      '          ON m.produto = e.produto'
      '             and m.filial = e.filial'
      ''
      '  Where f.codigo         = m.filial'
      '    and m.tipomovimento  = tp.codigo'
      '    and p.caracteristica = c.codigo'
      '    and m.produto        = p.codigo'
      '    and m.produto        = e.produto'
      '    and m.filial         = e.filial'
      '    and c.grupo          = gr.codigo'
      ''
      '  %Movimentos'
      '  %Filiais'
      '  %Grupos'
      '  %Periodo'
      '  %PeriodoProcessamento'
      '  %TiposMovimentos'
      '  %Ordenacao'
      ''
      ') as movimentos'
      ') as mov'
      ') as mov')
