    Sql.Strings = (
      
        ';SELECT codigogrupofilial,nomegrupofilial,filial,nomefilial,tipo' +
        'movimento,descricaomovimento,operacao,entradaousaida,case when (' +
        'entradaousaida='#39'S'#39' and valor>0 ) then -1*valor else valor end  a' +
        's valor,case when (entradaousaida='#39'S'#39' and quantidade>0)  then -1' +
        '*quantidade  else quantidade end as quantidade'
      'FROM'
      '('
      
        'SELECT codigogrupofilial,nomegrupofilial,filial,nomefilial,tipom' +
        'ovimento,descricaomovimento,operacao,entradaousaida,SUM(valor) a' +
        's valor,SUM(quantidade) as quantidade'
      'FROM'
      '('
      'SELECT  MOV.* ,'
      
        '        case when mov.financeiro > financeiroanterior and mov.va' +
        'lor<>0 then '#39'E'#39' else case when mov.financeiro<financeiroanterior' +
        ' and mov.valor<>0 then '#39'S'#39' else '#39'X'#39' end end as entradaousaida,'
      
        '        cast(p.descricao||'#39' '#39'||coalesce(p.valorgrade1,'#39#39')||'#39' '#39'||' +
        'coalesce(p.valorgrade2,'#39#39') as varchar) as descricaoproduto,'
      '        p.codigo as referenciaproduto,'
      '        c.grupo as grupoproduto,'
      '        gr.descricao as descricaogrupoproduto,'
      '        e.localizacao,'
      '        tp.descricao as descricaomovimento,tp.operacao'
      'FROM'
      '('
      
        ' SELECT Movimentos.numero,Movimentos.tipomovimento,Movimentos.va' +
        'lor,Movimentos.financeiro,Cast(Movimentos.data as date) as data,'
      
        '                Movimentos.quantidade,Movimentos.produto,Movimen' +
        'tos.filial,'
      '               COALESCE((SELECT m1.financeiro'
      '                          FROM movimentos m1'
      '                          WHERE m1.numero = (SELECT m2.numero'
      
        '                                                 FROM movimentos' +
        ' m2'
      
        '                                                 Where m2.produt' +
        'o=Movimentos.produto'
      
        '                                                 AND m2.filial=M' +
        'ovimentos.filial'
      
        '                                                 AND ((m2.data <' +
        ' Movimentos.data) OR (m2.data=movimentos.data and m2.lancto<movi' +
        'mentos.lancto))'
      
        '                                                 ORDER BY m2.dat' +
        'a DESC,m2.lancto DESC LIMIT 1)),0)  AS financeiroanterior,'
      '             f.nome as nomefilial,'
      '            gf.descricao as nomegrupofilial,'
      '            gf.codigo as codigogrupofilial'
      '            FROM'
      '('
      'Select m.data,'
      '           m.filial,'
      '           m.numero,'
      '           m.quantidade,'
      '           m.tipomovimento,'
      '           m.emestoque,'
      '           m.valor,'
      '           m.financeiro,'
      '           m.precocomicms,'
      '           m.produto'
      'FROM movimentos m'
      ''
      '%Periodo'
      '%PeriodoProcessamento'
      '%Filiais'
      '%Movimentos'
      '%Ordenacao'
      ''
      ''
      ') AS Movimentos'
      '     JOIN (filiais f'
      '           LEFT JOIN (filiaisgruposfiliais fgf'
      '                      JOIN gruposfiliais gf'
      '                      ON fgf.grupo=gf.codigo)'
      '           ON f.codigo=fgf.filial)'
      '     ON  f.codigo=movimentos.filial'
      ''
      ') AS MOV,'
      '    tiposmovimentos tp, produtos p,caracteristicas c, estoques e'
      ''
      ''
      'WHERE (mov.produto = p.codigo)'
      '  AND (mov.tipomovimento = tp.codigo)'
      '  AND (p.caracteristica=c.codigo)'
      '  AND (e.filial = mov.filial)'
      '  AND (e.produto = mov.produto)'
      ''
      '%Grupos'
      ''
      ''
      ') AS TODOS'
      
        'GROUP BY codigogrupofilial,nomegrupofilial,filial,nomefilial,ent' +
        'radaousaida,tipomovimento,descricaomovimento,operacao'
      ''
      '%OrdenacaoFinal'
      ''
      ') as t')
