  object qryMovimentosResumoSaldoInicial: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT   codigogrupofilial,'
      '         nomegrupofilial,'
      #9' codigofilial,'
      #9' nomefilial,'
      #9' cast(null as varchar) as tipomovimento,'
      #9' cast('#39'Saldo Anterior'#39' as varchar) as descricaomovimento,'
      #9' cast(null as varchar) as operacao,'
      #9' '#39'A'#39' as entradaousaida,'
      '         sum(Total) as Total,0 as quantidade'
      'from'
      '('
      
        'select   case When '#39't'#39' then codigogrupofilial else cast(null as ' +
        'integer) end as codigogrupofilial,'
      
        '         case When '#39't'#39' then nomegrupofilial   else cast(null as ' +
        'varchar) end as nomegrupofilial,'
      
        '         case When '#39't'#39' then codigofilial      else cast(null as ' +
        'integer) end as codigofilial,'
      
        '         case When '#39't'#39' then nomefilial        else cast(null as ' +
        'varchar) end as nomefilial,'
      '         case When '#39't'#39' then'
      '            Custo_medio'
      '         else'
      #9'  (case when coalesce(qtdultimaentrada,0)<>0 then'
      '            (qtdestoque*(custo_ultimaentrada/qtdultimaentrada))'
      #9'   else cast(null as numeric) end)'
      #9' end as Total'
      'from'
      '('
      'SELECT ep.*,'
      
        '       ( ep.emestoque + ep.reservado + ep.transito +  ep.demonst' +
        'racao + ep.conserto + ep.danificada+ep.reservaprevia)'
      '       AS qtdestoque,'
      '       f.nome AS nomefilial,'
      '       gf.descricao as nomegrupofilial,'
      '       gf.codigo as codigogrupofilial'
      'FROM'
      ' ('
      '    SELECT ep.*,'
      '           m2.valor as Custo_ultimaEntrada,'
      '           m2.quantidade as qtdUltimaEntrada'
      '    FROM'
      '    ('
      '     SELECT ep.*,'
      '            m1.emestoque,'
      #9'    m1.reservado,'
      #9'    m1.transito,'
      #9'    m1.demonstracao,'
      #9'    m1.conserto,'
      #9'    m1.danificada,m1.reservaprevia,'
      '            m1.financeiro as Custo_Medio'
      '     FROM'
      '     ('
      '      SELECT e.filial as codigofilial,'
      '             e.precocomicms,'
      #9'     e.produto as codigoitem'
      '      FROM estoques e'
      
        '      ) AS ep JOIN movimentos m1 ON m1.produto = ep.codigoitem A' +
        'ND'
      '                              m1.filial = ep.codigofilial AND'
      '                              m1.numero = (SELECT m.numero'
      '                                           from movimentos m'
      
        '                                           where m.produto=ep.co' +
        'digoitem and'
      
        '                                           m.filial=ep.codigofil' +
        'ial and'
      '                                           m.data < :datainicial'
      
        '                                           ORDER BY m.data DESC,' +
        'm.lancto DESC LIMIT 1) and'
      '                              m1.financeiro<>0'
      
        '     ) as ep LEFT JOIN movimentos m2 ON m2.produto = ep.codigoit' +
        'em AND'
      
        '                                        m2.filial = ep.codigofil' +
        'ial  AND'
      
        '                                        m2.numero = (SELECT m.nu' +
        'mero'
      
        '                                                     from movime' +
        'ntos m'
      
        '                                                     where m.pro' +
        'duto=ep.codigoitem and'
      
        '                                                           m.fil' +
        'ial=ep.codigofilial and'
      
        '                                                           m.dat' +
        'a < :datainicial and'
      
        '                                                           subst' +
        'ring(m.operacao from 12 for 1)='#39'+'#39
      
        '                                                     ORDER BY m.' +
        'data DESC,m.lancto DESC LIMIT 1)'
      
        '    ) as ep JOIN (filiais f left join (filiaisgruposfiliais fgf ' +
        'join gruposfiliais gf on fgf.grupo = gf.codigo)'
      
        '                                                               o' +
        'n fgf.filial = f.codigo)'
      '                           ON  f.codigo = ep.codigofilial'
      'Order by  UPPER(TO_ASCII(f.nome,'#39'LATIN1'#39')), codigofilial'
      ') as temp where qtdestoque>0) as temp'
      
        'GROUP BY codigogrupofilial,nomegrupofilial, nomefilial, codigofi' +
        'lial,entradaousaida')
    RequestLive = False
    Left = 596
    Top = 222
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end>
  end
  object qryMovimentosResumoRepositorio: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Periodo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'PeriodoProcessamento'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Filiais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Movimentos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Grupos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'TiposMovimentos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Ordenacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      
        'SELECT codigogrupofilial,nomegrupofilial,filial,nomefilial,tipom' +
        'ovimento,descricaomovimento,operacao,entradaousaida,case when (e' +
        'ntradaousaida='#39'S'#39' and valor>0 ) then -1*valor else valor end  as' +
        ' valor,case when (entradaousaida='#39'S'#39' and quantidade>0)  then -1*' +
        'quantidade  else quantidade end as quantidade'
      'FROM'
      '('
      
        'SELECT codigogrupofilial,nomegrupofilial,filial,nomefilial,tipom' +
        'ovimento,descricaomovimento,operacao,entradaousaida,SUM(valormov' +
        'imentado) as valor,SUM(quantidade) as quantidade'
      'FROM'
      '('
      'SELECT  MOV.* ,'
      
        '        case when (mov.financeiro > financeiroanterior and (mov.' +
        'valor<>0 or substr(operacao,12,1)='#39'='#39')) or (substr(operacao,12,1' +
        ')='#39'+'#39') then '#39'E'#39' else case when (mov.financeiro<financeiroanterio' +
        'r and (mov.valor<>0 or substr(operacao,12,1)='#39'='#39')) or (substr(op' +
        'eracao,12,1)='#39'+'#39') or (valor<0) then '#39'S'#39' else '#39'X'#39' end end as entr' +
        'adaousaida,'
      
        '        case when (mov.financeiro > financeiroanterior and (mov.' +
        'valor<>0 or substr(operacao,12,1)='#39'='#39')) or (substr(operacao,12,1' +
        ')='#39'+'#39') then mov.financeiro-financeiroanterior else case when (mo' +
        'v.financeiro<financeiroanterior and (mov.valor<>0 or substr(oper' +
        'acao,12,1)='#39'='#39')) or (substr(operacao,12,1)='#39'+'#39') or (valor<0) the' +
        'n financeiroanterior-mov.financeiro else mov.valor end end as va' +
        'lormovimentado,'
      
        '        cast(p.descricao||'#39' '#39'||coalesce(p.valorgrade1,'#39#39')||'#39' '#39'||' +
        'coalesce(p.valorgrade2,'#39#39') as varchar) as descricaoproduto,'
      '        p.codigo as referenciaproduto,'
      '        e.localizacao,'
      '        tp.descricao as descricaomovimento,tp.operacao'
      'FROM'
      '('
      
        ' SELECT Movimentos.numero,Movimentos.tipomovimento,Movimentos.va' +
        'lor,Movimentos.financeiro,Cast(Movimentos.data as date) as data,'
      
        '                Movimentos.quantidade,Movimentos.produto,Movimen' +
        'tos.filial,'
      '               COALESCE((SELECT m1.financeiro'
      '                                    FROM movimentos m1'
      #9'                      WHERE m1.numero = (SELECT m2.numero'
      
        '                                                 FROM movimentos' +
        ' m2'
      
        '                                                 Where m2.produt' +
        'o=Movimentos.produto'
      
        '                                                 AND m2.filial=M' +
        'ovimentos.filial'
      
        '                                                 AND ((m2.data <' +
        ' Movimentos.data) OR (m2.data=movimentos.data and m2.lancto<movi' +
        'mentos.lancto))'
      
        '                                                 ORDER BY m2.dat' +
        'a DESC,m2.lancto DESC LIMIT 1)),0)  AS financeiroanterior,'
      '             f.nome as nomefilial,'
      '            gf.descricao as nomegrupofilial,'
      '            gf.codigo as codigogrupofilial'
      '            FROM'
      '('
      'Select m.data,m.lancto,'
      '           m.filial,'
      '           m.numero,'
      '           m.quantidade,'
      '           m.tipomovimento,'
      '           m.emestoque,'
      '           m.valor,'
      '           m.financeiro,'
      '           m.precocomicms,'
      '           m.produto'
      'FROM    movimentos m'
      ''
      '%Periodo'
      '%PeriodoProcessamento'
      '%Filiais'
      '%Movimentos'
      ''
      ''
      
        ') AS Movimentos JOIN (filiais f LEFT JOIN (filiaisgruposfiliais ' +
        'fgf LEFT JOIN gruposfiliais gf ON fgf.grupo=gf.codigo)  ON f.cod' +
        'igo=fgf.filial)  ON  f.codigo=movimentos.filial'
      
        ') AS MOV,tiposmovimentos tp, produtos p,caracteristicas c, estoq' +
        'ues e'
      'WHERE (mov.produto = p.codigo)'
      'AND (mov.tipomovimento = tp.codigo)'
      'AND (p.caracteristica=c.codigo)'
      'AND (e.filial = mov.filial)'
      'AND (e.produto = mov.produto)'
      ''
      '%Grupos'
      '%TiposMovimentos'
      ''
      ''
      ') AS TODOS'
      
        'GROUP BY codigogrupofilial,nomegrupofilial,filial,nomefilial,ent' +
        'radaousaida,tipomovimento,descricaomovimento,operacao'
      ''
      '%Ordenacao'
      ''
      ') as t')
    RequestLive = False
    Left = 600
    Top = 152
  end
