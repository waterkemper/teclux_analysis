  object qrySugestaoCompra: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterScroll = qrySugestaoCompraAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';select *,'
      '        (minimo-saldo) as sugestaocompramin,'
      '        (maximo-saldo) as sugestaocompramax'
      'from'
      '('
      'SELECT'
      '   gf.descricao AS nomegrupofilial,'
      '   gf.codigo AS codigogrupofilial,'
      '   f.nome AS nomefilial,'
      '   e.filial AS codigofilial,'
      '   cl.descricao AS classegrupo,'
      '   cl.codigo AS codigoclasse,'
      '   g.descricao AS grupoproduto,'
      '   g.codigo AS codigogrupo,'
      '   c.descricao AS produto,'
      '   c.codigo AS codigoproduto,'
      
        '   cast(p.descricao||'#39' '#39'||coalesce(p.valorgrade1,'#39#39')||'#39' '#39'||coale' +
        'sce(p.valorgrade2,'#39#39') as varchar) AS item,'
      '   e.produto AS codigoitem,'
      '   ma.descricao AS marca,'
      '   c.unidade,'
      '   e.emestoque,'
      '   e.reservado,'
      '   e.transito,'
      '   e.demonstracao,'
      '   e.conserto,'
      '   e.futuro,'
      '   e.danificada,'
      '   (e.emestoque+e.reservado) as estoquevenda,'
      
        '   (e.emestoque+e.reservado+e.transito+e.demonstracao+e.conserto' +
        '+e.danificada) as estoquetotal,'
      '   coalesce(e.minimo,0) as minimo,'
      '   coalesce(e.maximo,0) as maximo,'
      '  pedidos_estoquepedido(e.produto,e.filial) as qtdepedido,'
      ''
      
        '  (e.emestoque+e.reservado+e.transito+e.demonstracao+e.conserto+' +
        'e.danificada)'
      '  +pedidos_estoquepedido(e.produto,e.filial)-e.futuro as saldo,'
      ''
      '   case when e.financeiro<>0 then'
      
        '     round(e.financeiro / COALESCE(NULLIF(e.emestoque+e.reservad' +
        'o+e.transito+e.demonstracao+e.conserto+e.danificada,0),1),2)'
      '   else'
      
        '     (select round(m2.financeiro / COALESCE(NULLIF(m2.emestoque+' +
        'm2.reservado+m2.transito+m2.demonstracao+m2.conserto+m2.danifica' +
        'da,0),1),2) from movimentos m2'
      '      where m2.produto=e.produto and'
      '               m2.filial=e.filial and'
      
        '               m2.numero = (select max(m3.numero) from movimento' +
        's m3'
      
        '                                   where m3.produto = e.produto ' +
        'and'
      
        '                                             m3.filial = e.filia' +
        'l and'
      '                                             m3.data <='#39'now'#39' and'
      '                                             m3.financeiro<>0))'
      '   end as customedio,'
      '   e.precosemicms as Custo_ultimaEntrada'
      '  FROM'
      
        '  ((estoques e JOIN (produtos p JOIN (((caracteristicas c JOIN g' +
        'rupos g ON c.grupo = g.codigo)'
      
        '                                                                ' +
        '                  JOIN classes cl ON c.classe=cl.codigo)'
      
        '                                                                ' +
        '     LEFT JOIN marcas ma ON c.marca=ma.codigo)'
      
        '                                                                ' +
        '     ON p.caracteristica=c.codigo)'
      
        '                                       ON  e.produto = p.codigo ' +
        ')'
      
        '                 JOIN (filiais f LEFT JOIN (filiaisgruposfiliais' +
        ' fgf JOIN gruposfiliais gf ON fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                           ON f.codigo=fgf.filial)'
      '                                       ON  e.filial = f.codigo )'
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      'WHERE (('
      ''
      ''
      
        '              (e.emestoque+e.reservado+e.transito+e.demonstracao' +
        '+e.conserto+e.danificada)'
      
        '              +pedidos_estoquepedido(e.produto,e.filial))-coales' +
        'ce(e.futuro,0))<='
      
        '              (case when coalesce(e.minimo,0)=0 then 0  else (e.' +
        'minimo+((e.minimo*:percentual)/100)) end)'
      '/* where filiais */'
      '/* where produto */'
      '/* where Existe Movimenta'#231#227'o */'
      ' and (coalesce(e.minimo,0)<>0)'
      ') as temp'
      'Where (minimo-saldo)<>0'
      
        'ORDER by UPPER(TO_ASCII(nomegrupofilial,'#39'LATIN1'#39')), codigogrupof' +
        'ilial, Maiusculo(nomefilial), codigofilial, classegrupo, codigoc' +
        'lasse, grupoproduto, codigogrupo, produto, codigoproduto, item, ' +
        'codigoitem'
      '')
    RequestLive = False
    Left = 72
    Top = 18
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'percentual'
        ParamType = ptUnknown
      end>
    object qrySugestaoCompranomegrupofilial: TStringField
      FieldName = 'nomegrupofilial'
      Size = 30
    end
    object qrySugestaoCompracodigogrupofilial: TIntegerField
      FieldName = 'codigogrupofilial'
      DisplayFormat = '0'
    end
    object qrySugestaoCompranomefilial: TStringField
      FieldName = 'nomefilial'
