  object qryTransferenciaFiliais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'FiltroData'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select t.filialrecebimento,'
      '       t.produto,'
      '       p.codigovisual as produtovisual,'
      '       t.quantidade,'
      '       t.transferido,'
      '       t.dadofiscal,'
      
        '       (select d.data from dadosfiscais d where t.dadofiscal = d' +
        '.numero) as data,'
      
        '       (select n.serie from notas n where n.dadofiscal = t.dadof' +
        'iscal) as serie,'
      
        '       (select n.numero from notas n where n.dadofiscal = t.dado' +
        'fiscal) as numero,'
      
        '       (select c.numero from cupons c where c.dadofiscal = t.dad' +
        'ofiscal) as cupom,'
      '       (select ti.valor'
      '        from tributosicms ti'
      '        where ti.codigo = (select c.incidencia'
      '                                  from caracteristicas c'
      
        '                                  where c.codigo = (select p.car' +
        'acteristica'
      
        '                                                            from' +
        ' produtos p'
      
        '                                                            wher' +
        'e p.codigo = t.produto'
      '                                                           )'
      '                                 )'
      '        ) as incidencia,'
      '        c.ipicst,'
      '        c.cofinscst,'
      '        c.piscst,'
      ''
      '       (select c.origem'
      '           from caracteristicas c'
      '           where c.codigo = (select p.caracteristica'
      '                                from produtos p'
      
        '                                where p.codigo = t.produto)) as ' +
        'origem,'
      ''
      '        (select m.valor / m.quantidade'
      '         from movimentos m'
      '         where (m.numero = (select Max(m1.numero)'
      '                                          from movimentos m1'
      
        '                                          where (m1.produto = t.' +
        'produto) and'
      
        '                                                     (m1.filial ' +
        ' = t.filialemitente) and'
      
        '                                                     (m1.valor i' +
        's not null)'
      '                   )                   )'
      '        ) as valorcusto,'
      '        estoques_preco(t.produto,:FilialBase) as preconormal,'
      
        '        (select e.valorultimacompra from estoques e where e.prod' +
        'uto = p.codigo and e.filial = t.filialemitente) as valorultimaco' +
        'mpra,'
      '        cast(:ParametroSelecionado as boolean) as selecionado,'
      '        f.razao,'
      '        f.inscricaoestadual,'
      '        f.rua,'
      '        f.cep,'
      '        f.estado,'
      '        f.cidade,'
      '        f.bairro,'
      '        f.cnpj,'
      
        '        Selecionar_AliquotaIcms(:EstadoFilialBase, f.estado,:Tip' +
        'oPessoa, p.codigo) as aliquotaicms,'
      '        c.percreducaobase'
      
        'from transferenciasfiliais t, filiais f, caracteristicas c, prod' +
        'utos p'
      'where (t.filialrecebimento = f.codigo) and'
      '          (t.filialemitente = :FilialBase) and'
      '          (t.produto = p.codigo) and'
      '          (c.codigo = p.caracteristica) and'
      '          (Not t.transferido)'
      ''
      '%FiltroData'
      ''
      'order by t.filialrecebimento, data, t.produto')
    RequestLive = True
    Left = 70
    Top = 29
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'FilialBase'
        ParamType = ptUnknown
      end
      item
        DataType = ftBoolean
        Name = 'ParametroSelecionado'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'EstadoFilialBase'
        ParamType = ptUnknown
