procedure TfrmConsultaProgramacaoEntregaNfe.dbaProgramacaoEntregaNfeGetFloatFormat(
  Sender: TObject; ACol, ARow: Integer; var IsFloat: Boolean;
  var FloatFormat: String);
begin
  inherited;
  if (Acol = (dbaProgramacaoEntregaNfe.ColumnByFieldName['qvol'].Index)-1) then
      FloatFormat := '%.0n';

end;

procedure TfrmConsultaProgramacaoEntregaNfe.dbaProgramacaoEntregaNfeSelectCell(
  Sender: TObject; ACol, ARow: Integer; var CanSelect: Boolean);

  Function ValorCampoEntrega: String;
  var i: integer;
  begin
    result := '';
    for i:=Arow downto 1 do
      if dbaProgramacaoEntregaNfe.Cells[dbaProgramacaoEntregaNfe.ColumnByFieldName['nomefornecedor'].Index-1, i]='' then
      begin
        result := trim(dbaProgramacaoEntregaNfe.Cells[dbaProgramacaoEntregaNfe.ColumnByFieldName['entrega'].Index, i]);
        break;
      end;
  end;

begin
  inherited;

  if pgcConsultaPedidos.activepage = tstDados then
    if dbaProgramacaoEntregaNfe.rowcount > 0 then
      dtmConsultaProgramacaoEntregaNfe.PosicionarRegistro(ValorCampoEntrega,
           trim(dbaProgramacaoEntregaNfe.Cells[dbaProgramacaoEntregaNfe.ColumnByFieldName['filial'].Index-1, Arow]),
           trim(dbaProgramacaoEntregaNfe.Cells[dbaProgramacaoEntregaNfe.ColumnByFieldName['nomefornecedor'].Index-1, Arow]),
           trim(dbaProgramacaoEntregaNfe.Cells[dbaProgramacaoEntregaNfe.ColumnByFieldName['serie'].Index-1, Arow]),
           trim(dbaProgramacaoEntregaNfe.Cells[dbaProgramacaoEntregaNfe.ColumnByFieldName['qvol'].Index-1, Arow]),
           trim(dbaProgramacaoEntregaNfe.Cells[dbaProgramacaoEntregaNfe.ColumnByFieldName['raiz_nomefornecedortransporte'].Index-1, Arow]));

end;

procedure TfrmConsultaProgramacaoEntregaNfe.DBAdvPedidosCheckBoxChange(
  Sender: TObject; ACol, ARow: Integer; State: Boolean);
begin
  inherited;

  if Acol = (DBAdvPedidos.ColumnByFieldName['recebido'].Index) then
     dtmConsultaProgramacaoEntregaNfe.MarcarRecebido(State);

end;

procedure TfrmConsultaProgramacaoEntregaNfe.DBAdvPedidosSelectCell(
  Sender: TObject; ACol, ARow: Integer; var CanSelect: Boolean);
begin
  inherited;
  if DBAdvPedidos.rowcount > 0 then
    dtmConsultaProgramacaoEntregaNfe.PosicionarRegistroPedidos(DBAdvPedidos.Cells[DBAdvPedidos.ColumnByFieldName['numero'].Index, Arow]);

end;

procedure TfrmConsultaProgramacaoEntregaNfe.FormActivate(Sender: TObject);
begin
  inherited;

  if assigned(dtmConsultaProgramacaoEntregaNfe) then
    dtmConsultaProgramacaoEntregaNfe.qryProgramacaoEntregaNfeAfterScroll(nil);
    
end;

