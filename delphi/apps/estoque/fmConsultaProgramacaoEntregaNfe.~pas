implementation

{$R *.dfm}

{ TForm2 }

constructor TfrmConsultaProgramacaoEntregaNfe.Create(AOwner: TComponent);
begin
  dtmConsultaProgramacaoEntregaNfe := TdtmConsultaProgramacaoEntregaNfe.Create(Self);
  inherited;
  DataSet := dtmConsultaProgramacaoEntregaNfe.qryProgramacaoEntregaNfe;

  edtDataInicial.text := DateToStr(Date);
  edtDataFinal.text := '';

  dbaProgramacaoEntregaNfe.Bands.active := true;
  dbaProgramacaoEntregaNfe.Bands.PrimaryColor :=  TColor(strtoint(parsistema.CorZebradoRelatorio));

  DBAdvPedidos.Bands.active := true;
  DBAdvPedidos.Bands.PrimaryColor :=  TColor(strtoint(parsistema.CorZebradoRelatorio));

  pgcConsultaPedidos.activepage := tstParametros;


end;

destructor TfrmConsultaProgramacaoEntregaNfe.Destroy;
begin

  inherited;
end;

procedure TfrmConsultaProgramacaoEntregaNfe.KeyDown(var Key: Word;
  Shift: TShiftState);
begin
  inherited;
  if (key = vk_f6) and not ctrlon then
  begin
    if sbnGerar.enabled then
      sbnGerarClick(nil);
  end
  else
  if (key = vk_f8) and not ctrlon then
    if sbnAbrirPedido.enabled then
      sbnAbrirPedido.Click;

end;

procedure TfrmConsultaProgramacaoEntregaNfe.sbnGerarClick(Sender: TObject);
begin
  inherited;
  with dtmConsultaProgramacaoEntregaNfe do
  begin
     DataInicial   := edtDataInicial.Text;
     DataFinal     := edtDataFinal.Text;

     if not GerarConsulta then
     begin
       MensagemAviso(format(ctNENHUMREGISTROSELECIONADO,['registro']));
       edtDataInicial.SetFocus;
     end
     else
     begin
       AGrupamento;
       pgcConsultaPedidos.ActivePage:= tstDados;
     end;  

  end;
end;

procedure TfrmConsultaProgramacaoEntregaNfe.Timer1Timer(Sender: TObject);
begin
  inherited;
  sbnGerar.enabled := pgcConsultaPedidos.activepage = tstParametros;
  sbnAbrirPedido.enabled := (pgcConsultaPedidos.ActivePage = tstDados) and (dtmConsultaProgramacaoEntregaNfe.qryPedidos.RecordCount <> 0);
end;

procedure TfrmConsultaProgramacaoEntregaNfe.Pesquizar1Click(
  Sender: TObject);
begin
  inherited;
  AdvGridFindDialog1.Grid := dbaProgramacaoEntregaNfe;
  AdvGridFindDialog1.Execute;

end;

procedure TfrmConsultaProgramacaoEntregaNfe.ExportarExcel1Click(
  Sender: TObject);
var
  vNomeArquivo: String;  
begin
  inherited;
  AdvGridExcelIO1.AdvStringGrid := dbaProgramacaoEntregaNfe;
  vNomeArquivo := ExtractFilePath(Application.ExeName) + 'Saidas\ProgramaçãoEntregaNfe.xls';
  AdvGridExcelIO1.XLSExport(vNomeArquivo, 'ProgramaçãoEntregaNfe');

end;

procedure TfrmConsultaProgramacaoEntregaNfe.Copia1Click(Sender: TObject);
begin
  inherited;
  dbaProgramacaoEntregaNfe.CopySelectionToClipboard;
end;

