procedure TfrmCadastroNotasFiscaisGrade.AlterarEstadoBotoes;
begin
  if (not (sbnSalvar.Enabled)) and
     (dtmCadastroNotasFiscais.TabelaGrade.State<>dsinsert) and
     (not dtmCadastroNotasFiscais.PodeInserirnaGrade) then
    inherited;
  sbnIncluir.Enabled := (not (dtmCadastroNotasFiscais.SomenteLeitura));
end;

constructor TfrmCadastroNotasFiscaisGrade.Create(AOwner: TComponent; dtm: TdtmCadastroNotasFiscais);
begin
  inherited create(AOwner);
  SetDataModulo(dtm);

  DataSet:= dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal;

  dtmCadastroNotasFiscais.PosicionarLinhaColunaNaGrade := onPosicionarLinhaColunaNaGrade;
  dtmCadastroNotasFiscais.GradeBeforeOpen := GradeBeforeOpen;
  dtmCadastroNotasFiscais.GradeAfterOpen := GradeAfterOpen;
  dtmCadastroNotasFiscais.AtualizarTotais := AtualizarTotais; 

  dtmCadastroNotasFiscais.CaracteristicasNotaFiscalAfterOpen := CaracteristicasNotaFiscalAfterOpen;
  dtmCadastroNotasFiscais.CaracteristicasNotaFiscalBeforeOpen := CaracteristicasNotaFiscalBeforeOpen;

  fraConsultaProduto := TfraConsultaCodigo.Create(self);
  fraConsultaProduto.Name := 'fraConsultaProduto';
  fraConsultaProduto.edfCodigo.MaxLength := 30;
  fraConsultaProduto.edfCodigo.DataSource := dtmCadastroNotasFiscais.dsrCaracteristicasNotaFiscal;
  fraConsultaProduto.edfCodigo.DataField := 'codigovisual';
  fraConsultaProduto.edfCodigo.Operacao := opATRIBUICAO;
  fraConsultaProduto.edfCodigo.LookupSource := fraConsultaProduto.dsrProcuraProdutos;
  fraConsultaProduto.edfCodigo.LookupQueryParameter := 'caracteristicavisual';
  fraConsultaProduto.edfCodigo.LookupField := 'codigovisual';
  fraConsultaProduto.AbrirTabelaProcura := false;
  fraConsultaProduto.CondicoesdaConsulta := CondicoesProduto;
  fraConsultaProduto.TipoPesquisa := pesPRODUTOS;
  fraConsultaProduto.OnFound := AtribuirDadosProdutos;
  self.visible := false;

  dbgCaracteristicasNotasFiscais.ColumnByFieldName['quantidade'].FloatFormat := '%.0n';

  dbgCaracteristicasNotasFiscaisTotal.ColumnByFieldName['quantidade'].FloatFormat := '%.0n';
  dbgCaracteristicasNotasFiscaisTotal.FloatingFooter.Visible := True;
  dbgCaracteristicasNotasFiscaisTotal.FloatingFooter.ColumnCalc[dbgCaracteristicasNotasFiscaisTotal.ColumnByFieldName['quantidade'].Index] := acSum;







end;

destructor TfrmCadastroNotasFiscaisGrade.Destroy;
begin
  inherited;
  frmCadastroNotasFiscaisGrade := nil;
end;

procedure TfrmCadastroNotasFiscaisGrade.PosicionarLinhaColunaNaGrade;
var
  vNomedocampo: String;
begin
 with  dtmCadastroNotasFiscais do
 begin

  if not qryProdutosNotaFiscal.IsEmpty then
  begin


    if DBAdvGridGradeProdutosNotaEntrada.canfocus and self.visible then
      DBAdvGridGradeProdutosNotaEntrada.setfocus;

    case tipoGrade of
     tpLINHA : begin

                 if nomedocampoposicionar = '' then
                    vnomedocampo := CopiaProdutoColunaGrade
                 else
                    vnomedocampo := nomedocampoposicionar;

                 DBAdvGridGradeProdutosNotaEntrada.col := Colunas.IndexOf(vnomedocampo)+2;


                 if trim(dtmCadastroNotasFiscais.qryGrade.fieldbyname('valorlinha').asString) <> CopiaProdutoLinhaGrade then
                 begin
                   dtmCadastroNotasFiscais.qryGrade.first;
                   while not dtmCadastroNotasFiscais.qryGrade.eof do
                   begin
                     if trim(dtmCadastroNotasFiscais.qryGrade.fieldbyname('valorlinha').asString) = CopiaProdutoLinhaGrade then
                       break
                     else
                       dtmCadastroNotasFiscais.qryGrade.next;
                   end;
                 end;

               end;
     tpCOLUNA: begin

                 if nomedocampoposicionar='' then
                    vnomedocampo := CopiaProdutoLinhaGrade
                 else
                    vnomedocampo := nomedocampoposicionar;


                 DBAdvGridGradeProdutosNotaEntrada.col := Colunas.IndexOf(vnomedocampo)+2;

                 if trim(dtmCadastroNotasFiscais.qryGrade.fieldbyname('valorlinha').asString) <> CopiaProdutoColunaGrade then
                 begin
                   dtmCadastroNotasFiscais.qryGrade.first;
                   while not dtmCadastroNotasFiscais.qryGrade.eof do
                   begin
                     if trim(dtmCadastroNotasFiscais.qryGrade.fieldbyname('valorlinha').asString) = CopiaProdutoColunaGrade then
                       break
                     else
                       dtmCadastroNotasFiscais.qryGrade.next;
                   end;
                 end;
               end;
    end;
    nomedocampoposicionar := '';


  end;
 end;

end;


procedure TfrmCadastroNotasFiscaisGrade.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  inherited;

  dtmCadastroNotasFiscais.PosicionarLinhaColunanoProdutoNotaFiscal(
     trim(DBAdvGridGradeProdutosNotaEntrada.Cells[DBAdvGridGradeProdutosNotaEntrada.col, 0]));



end;



procedure TfrmCadastroNotasFiscaisGrade.sbnTrocarLInhaColunaClick(
  Sender: TObject);
var
 GradeEdicao : Boolean;
begin
  inherited;
  GradeEdicao := sbnSalvar.Enabled;
  dtmCadastroNotasFiscais.PosicionarLinhaColunanoProdutoNotaFiscalCopia(trim(DBAdvGridGradeProdutosNotaEntrada.Cells[DBAdvGridGradeProdutosNotaEntrada.col, 0]));
  case tipograde of
   tpLINHA : tipograde := tpCOLUNA;
   tpCOLUNA : tipograde := tpLINHA;
  end;
  dtmCadastroNotasFiscais.GerarTabelaGrade;
  DataSet:= dtmCadastroNotasFiscais.TabelaGrade;
  dtmCadastroNotasFiscais.EditarGrade(GradeEdicao);
  PosicionarLinhaColunanaGrade;
end;

procedure TfrmCadastroNotasFiscaisGrade.ckbValoresPadraoClick(
  Sender: TObject);
begin
  inherited;
  with dtmCadastroNotasFiscais do
  begin
   UtilizarValoresPadrao      := ckbValoresPadrao.Checked;
   ValorPadraoprecounitario   := edtPreco.ValorSemFormatacao;
   ValorPadraoaliquotaicms    := edtICMS.ValorSemFormatacao;
   ValorPadraoaliquotaipi     := edtIPI.ValorSemFormatacao;
   ValorPadraovalorreducaobase:= edtReducaoBase.ValorSemFormatacao;
  end;
end;


function TfrmCadastroNotasFiscaisGrade.InternoIncluir: Boolean;
begin
  Result := true;
  dtmCadastroNotasFiscais.AbrirElementosNaoCadastrados;
  if not Assigned (frmAdicionarLinhaGrade) then
    frmAdicionarLinhaGrade:= TfrmAdicionarLinhaGrade.Create(frmAdicionarLinhaGrade, dtmCadastroNotasFiscais);
  with frmAdicionarLinhaGrade do
  begin
    ShowModal;
    if frmAdicionarLinhaGrade.ModalResult = mrok then
      dtmCadastroNotasFiscais.GerarTabelaGrade;
    Free;
  end;
  DBAdvGridGradeProdutosNotaEntrada.Refresh;
  frmCadastroNotasFiscaisGrade.SetFocus;
end;

procedure TfrmCadastroNotasFiscaisGrade.KeyDown(var Key: Word;
  Shift: TShiftState);
begin
  case Key of
    VK_F3: begin
              if (Shift = []) and sbnIncluir.Enabled then
                sbnIncluirClick(sbnIncluir);
            end;
    VK_F5: begin
              if (Shift = []) and sbnSalvar.Enabled then
                sbnSalvarClick(sbnSalvar);
            end;
    VK_G: begin
             if Shift = [ssCtrl] then
              if sbnTrocarLInhaColuna.Visible then
               sbnTrocarLInhaColunaClick(sbnTrocarLInhaColuna);
           end;
  else

  if self.ActiveControl = DBAdvGridGradeProdutosNotaEntrada then
  begin
    case key of
     VK_PRIOR,
     VK_NEXT :
     begin
       BloquerAcaoBotes_Prior_Next := true;
       inherited KeyDown(Key, Shift);
       BloquerAcaoBotes_Prior_Next := false;

     end;
    end;
  end
  else
    inherited KeyDown(Key, Shift);
  end;
end;

function TfrmCadastroNotasFiscaisGrade.getncolunasgrade: integer;
begin
  fncolunasgrade := DBAdvGridGradeProdutosNotaEntrada.Columns.count;
  Result := fncolunasgrade;
end;


function TfrmCadastroNotasFiscaisGrade.InternoCancelar: Boolean;
begin
  dtmCadastroNotasFiscais.EliminarCalculosIncluidos;
end;

procedure TfrmCadastroNotasFiscaisGrade.onPosicionarLinhaColunaNaGrade(
  Sender: TObject);
begin
  posicionarLinhaColunanaGrade;
end;

procedure TfrmCadastroNotasFiscaisGrade.PopupMenuPopup(Sender: TObject);
begin
  inherited;

  if dtmCadastroNotasFiscais.tpModoGrade = Todos then
  begin
    if (DBAdvGridGradeProdutosNotaEntrada.col >= 2) and
       (DBAdvGridGradeProdutosNotaEntrada.col <= DBAdvGridGradeProdutosNotaEntrada.Columns.Count -11) and
       (DBAdvGridGradeProdutosNotaEntrada.DataSource.DataSet.RecordCount <> 0) then
    begin
      dtmCadastroNotasFiscais.VisualizandoProdutosdaNFELC := true;

      dtmCadastroNotasFiscais.qryProdutosNotasPagNFE.AfterScroll := nil;
      dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItems.AfterScroll := nil;


      frmListaItensnfe := TfrmListaItensnfe.create(self, dtmCadastroNotasFiscais);
      frmListaItensnfe.ckbVisualizarComSaldosQuantidadeNFe.Checked := dtmCadastroNotasFiscais.VisualizarComSaldosQuantidadeNFe;

      try
        dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.AfterScroll := nil;
        dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.GuardarRegistroAtual(false);

        dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.edit;
        dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscalvalorgrade1.asString := dtmCadastroNotasFiscais.qrygrade.fieldbyname('valorlinha').asstring;
        dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscalvalorgrade2.asString := dtmCadastroNotasFiscais.Colunas.Strings[DBAdvGridGradeProdutosNotaEntrada.col-2];
        dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.post;
      finally
        dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.VoltarRegistro;
        dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.AfterScroll := dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscalAfterScroll;
      end;


      frmListaItensnfe.vValorLinha :=  dtmCadastroNotasFiscais.qrygrade.fieldbyname('valorlinha').asstring;
      frmListaItensnfe.vValorColuna := dtmCadastroNotasFiscais.Colunas.Strings[DBAdvGridGradeProdutosNotaEntrada.col-2];

      frmListaItensnfe.dtxProdutoDescricao.text := dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscaldescricao.asString+
                                                   dtmCadastroNotasFiscais.qrygrade.fieldbyname('valorlinha').asstring+
                                                   dtmCadastroNotasFiscais.Colunas.Strings[DBAdvGridGradeProdutosNotaEntrada.col-2];

      dtmCadastroNotasFiscais.qryProdutosNotasPagNFE.filtered := false;

      frmListaItensnfe.VerificarVisualizacoes;

      dtmCadastroNotasFiscais.qryProdutosNotasPagNFE.filtered :=
        dtmCadastroNotasFiscais.aplicarfiltroProdutosNotasPagNFE;

      frmListaItensnfe.showmodal;
      if frmListaItensnfe.modalresult = mrOk then
      begin
        dtmCadastroNotasFiscais.ColunaAtual := dtmCadastroNotasFiscais.Colunas.Strings[DBAdvGridGradeProdutosNotaEntrada.col-2];
        dtmCadastroNotasFiscais.NomeCampoColunaAtual := DBAdvGridGradeProdutosNotaEntrada.Columns.Items[DBAdvGridGradeProdutosNotaEntrada.col].FieldName;
        dtmCadastroNotasFiscais.AtualizarItensgradenfe;

        AtualizarTotais(nil);

      end;
      frmListaItensnfe.free;

      dtmCadastroNotasFiscais.VisualizandoProdutosdaNFELC := false;
      dtmCadastroNotasFiscais.qryProdutosNotasPagNFE.filtered := false;


      dtmCadastroNotasFiscais.qryProdutosNotasPagNFE.AfterScroll := dtmCadastroNotasFiscais.qryProdutosNotasPagNFEAfterScroll;
      dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItems.AfterScroll := dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsAfterScroll;

    end
    else
    if DBAdvGridGradeProdutosNotaEntrada.datasource.DataSet.recordcount = 0 then
      InternoIncluir;
  end;

end;

procedure TfrmCadastroNotasFiscaisGrade.CondicoesProduto;
var
  vCondicaoGrade: String;
  vCondicaoDesde: String;

begin
  vCondicaoGrade := ' and c.grade1 is not null and c.grade2 is not null ';

  if dbSelecionarProdutosDesde.Checked then
    vCondicaoDesde := ' and c.datacadastro >= '+quotedstr(FormatDateTime('yyyy-mm-dd',dtmCadastroNotasFiscais.qryNotaFiscaldataselecaoprodutosgrade.Asdatetime));

  fraConsultaProduto.qryConsultaProdutos.MacroByName('CondicaoGrade').asString := vCondicaoGrade;
  fraConsultaProduto.qryProcuraProdutos.MacroByName('CondicaoGrade').asString := vCondicaoGrade;

  fraConsultaProduto.qryConsultaProdutos.MacroByName('SelecionarProdutosDesde').asString := vCondicaoDesde;

end;

procedure TfrmCadastroNotasFiscaisGrade.AtribuirDadosProdutos(Found: Boolean);
begin

  if dbgCaracteristicasNotasFiscais.GetDistinctValues(
             dbgCaracteristicasNotasFiscais.ColumnByFieldName['codigovisual'].index,
             dbgCaracteristicasNotasFiscais.row, true ).indexof(fraConsultaProduto.qryProcuraProdutos.FieldByName('codigovisual').AsString)<>-1 then
  begin
    MensagemAviso('Produto já cadastrado!');
    dbgCaracteristicasNotasFiscais.datasource.dataset.cancel;
  end
  else
  begin
    with dtmCadastroNotasFiscais do
    begin
      qryCaracteristicasNotaFiscaldescricao.AsString := fraConsultaProduto.qryProcuraProdutos.FieldByName('descricao').AsString;
      qryCaracteristicasNotaFiscalcaracteristica.asString := fraConsultaProduto.qryProcuraProdutos.FieldByName('codigo').AsString;
      qryCaracteristicasNotaFiscalcodigovisual.asString := fraConsultaProduto.qryProcuraProdutos.FieldByName('codigovisual').AsString;
      qryCaracteristicasNotaFiscalgrade1.asInteger := fraConsultaProduto.qryProcuraProdutos.FieldByName('grade1').AsInteger;
      qryCaracteristicasNotaFiscalgrade2.asInteger := fraConsultaProduto.qryProcuraProdutos.FieldByName('grade2').AsInteger;
      qryCaracteristicasNotaFiscallinha.asString := fraConsultaProduto.qryProcuraProdutos.FieldByName('linha').AsString;
      qryCaracteristicasNotaFiscalcoluna.asString := fraConsultaProduto.qryProcuraProdutos.FieldByName('coluna').AsString;
      qryCaracteristicasNotaFiscal.Post;
      GerarTabelaGrade;
    end;
  end;
end;


procedure TfrmCadastroNotasFiscaisGrade.AcionarPesquisaGrade;
begin
  if (dtmCadastroNotasFiscais.qryProdutosNotaFiscal.RecordCount = 0) or
     (dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.state in [dsinsert, dsedit]) then
    with fraConsultaProduto do
    begin
      dbgCaracteristicasNotasFiscais.SetFocus;
      fraConsultaProduto.CtrlOn := True;
      fraConsultaProduto.InternoPesquisar('Item de Produto');
      dbgCaracteristicasNotasFiscais.SetFocus;
      dbgCaracteristicasNotasFiscais.col :=  1;
    end;
end;

procedure TfrmCadastroNotasFiscaisGrade.sbnProcuraClick(Sender: TObject);
begin
  inherited;
  AcionarPesquisaGrade;
end;

procedure TfrmCadastroNotasFiscaisGrade.sbnIncluirItemClick(
  Sender: TObject);
begin
  inherited;
  with dtmCadastroNotasFiscais do
  begin
    dtmCadastroNotasFiscais.UnlockedGerarTabelaGrade := false;
    dbgCaracteristicasNotasFiscais.Datasource.dataset.append;
    qryCaracteristicasNotaFiscalcodigovisual.readonly := false;
    dbgCaracteristicasNotasFiscais.setfocus;
  end;
end;

procedure TfrmCadastroNotasFiscaisGrade.dbgCaracteristicasNotasFiscaisKeyDown(
  Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;
  if Shift = [ssCtrl] then
  begin
    case Key of
      VK_F3    : begin
                   if sbnIncluirItem.enabled then
                      sbnIncluirItemClick(nil);
                 end;

      VK_Delete : begin
                    if sbnExcluirProduto.enabled then
                       sbnExcluirProdutoClick(nil);
                  end;

      VK_F9    : begin

                   if  (dbgCaracteristicasNotasFiscais.SelectedField = dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscalcodigovisual) or
                       (dbgCaracteristicasNotasFiscais.SelectedField = dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscaldescricao) then
                   begin
                     fraConsultaProduto.CtrlOn := Shift = [ssCtrl];
                     if (Shift = []) or fraConsultaProduto.CtrlOn then
                       AcionarPesquisaGrade
                   end;

                 end;
    end;
  end
  else
  case Key of
    VK_Return: if (dbgCaracteristicasNotasFiscais.SelectedField = dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscalcodigovisual) then
                begin
                  if not dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscalcodigovisual.readonly then
                  begin

                    fraConsultaProduto.edfCodigo.text := dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscalcodigovisual.asString;
                    fraConsultaProduto.edfCodigo.exist;

                    if not fraConsultaProduto.qryProcuraProdutos.IsEmpty then
                      AtribuirDadosProdutos
                    else
                    begin
                      key := 0;
