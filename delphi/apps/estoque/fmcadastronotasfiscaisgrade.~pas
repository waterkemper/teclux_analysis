procedure TfrmCadastroNotasFiscaisGrade.AtualizarTotais(Sender: TObject);
var
  vRecno : integer;
begin
  if DBAdvGridGradeProdutosNotaEntrada.datasource <> nil then
  begin


    if (dtmCadastroNotasFiscais.qryGrade.FindField('quantidade')<>nil) then
      DBAdvGridGradeProdutosNotaEntrada.CalcFooter(DBAdvGridGradeProdutosNotaEntrada.ColumnByFieldName['quantidade'].index);

    DBAdvGridGradeProdutosNotaEntrada.refresh;


    try
      dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.AfterScroll := nil;
      dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.AfterPost := nil;

      dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.GuardarRegistroAtual(false);

      if (dtmCadastroNotasFiscais.qryGrade.FindField('quantidade')<>nil) then
      begin
        dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.edit;
        dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscalquantidade.AsCurrency :=
          DBAdvGridGradeProdutosNotaEntrada.CellToReal(DBAdvGridGradeProdutosNotaEntrada.ColumnByFieldName['quantidade'].index,
                                                       DBAdvGridGradeProdutosNotaEntrada.RowCount-1);
        dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.post;

        dbgCaracteristicasNotasFiscaisTotal.Reload;
        dbgCaracteristicasNotasFiscaisTotal.FloatingFooter.ColumnCalc[3] := acSum;
        dbgCaracteristicasNotasFiscaisTotal.CalcFooter(3);
        dbgCaracteristicasNotasFiscaisTotal.refresh;
      end;

    finally
      dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.VoltarRegistro;
      dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.AfterScroll := dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscalAfterScroll;
      dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscal.AfterPost := dtmCadastroNotasFiscais.qryCaracteristicasNotaFiscalAfterPost;
    end;

    dbgCaracteristicasNotasFiscais.Refresh;
    dbgCaracteristicasNotasFiscaisTotal.Refresh;

    dbgCaracteristicasNotasFiscais.setfocus;
    DBAdvGridGradeProdutosNotaEntrada.setfocus;

  end;
end;

