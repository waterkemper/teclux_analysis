procedure TfrmCadastroNotasFiscaisGrade.DBAdvGridGradeProdutosNotaEntradaKeyDown(
  Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;

  if key = VK_F9 then
    PopupMenuPopup(Sender)
  else
  if key = VK_RETURN then
  begin
    if (DBAdvGridGradeProdutosNotaEntrada.col <= (ncolunasgrade-7)) then
    begin

      dtmCadastroNotasFiscais.qryProdutosNotasPagNFE.AfterScroll := nil;
      dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItems.AfterScroll := nil;

      dtmCadastroNotasFiscais.ColunaAtual := dtmCadastroNotasFiscais.Colunas.Strings[DBAdvGridGradeProdutosNotaEntrada.col-2];
      dtmCadastroNotasFiscais.NomeCampoColunaAtual := DBAdvGridGradeProdutosNotaEntrada.Columns.Items[DBAdvGridGradeProdutosNotaEntrada.col].FieldName;
      dtmCadastroNotasFiscais.AtualizarItensgradenfe;

      AtualizarTotais(nil);

      dtmCadastroNotasFiscais.qryProdutosNotasPagNFE.AfterScroll := dtmCadastroNotasFiscais.qryProdutosNotasPagNFEAfterScroll;
      dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItems.AfterScroll := dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsAfterScroll;

    end;
  end
  else
  if (key = VK_DELETE) and (Shift = [ssCtrl]) then
  begin

    dtmCadastroNotasFiscais.qryProdutosNotasPagNFE.AfterScroll := nil;
    dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItems.AfterScroll := nil;

    dtmCadastroNotasFiscais.ApagarProdutosNotasPagGrade(trim(
      DBAdvGridGradeProdutosNotaEntrada.Cells[DBAdvGridGradeProdutosNotaEntrada.col,0]),
      DBAdvGridGradeProdutosNotaEntrada.Columns.Items[DBAdvGridGradeProdutosNotaEntrada.col].FieldName);

    AtualizarTotais(nil);

    dtmCadastroNotasFiscais.qryProdutosNotasPagNFE.AfterScroll := dtmCadastroNotasFiscais.qryProdutosNotasPagNFEAfterScroll;
    dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItems.AfterScroll := dtmCadastroNotasFiscais.qryProdutosNotasPagNFEItemsAfterScroll;

  end;

end;

procedure TfrmCadastroNotasFiscaisGrade.DBAdvGridGradeProdutosNotaEntradaKeyPress(
  Sender: TObject; var Key: Char);
begin
  inherited;

  with dtmCadastroNotasFiscais do
  begin
    if (DBAdvGridGradeProdutosNotaEntrada.Columns.Items[DBAdvGridGradeProdutosNotaEntrada.col].FieldName = 'precounitario') then
    begin
        if Gradeprecodiferente then
          MensagemAviso(format(ctCAMPONAOPODESERALTERADO, [ANSIUpperCase(ctPRECO)]));
