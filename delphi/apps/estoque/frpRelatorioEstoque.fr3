<TfrReport ScriptLanguage="PascalScript" ScriptText.text="procedure Page1OnBeforePrint(Sender: TfrComponent);&#13;&#10;begin&#13;&#10;  with Page1, Engine do&#13;&#10;  begin&#13;&#10;  StretchToPrint := True;&#13;&#10;  if [AgruparGrupoFilial] then&#13;&#10;  begin&#13;&#10;    CabecalhoGrupoFilial.visible:=true;&#13;&#10;    RodapeGrupoFilial.visible:=true;  &#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    CabecalhoGrupoFilial.visible:=false;&#13;&#10;    RodapeGrupoFilial.visible:=false;     &#13;&#10;  end; &#13;&#10;&#13;&#10;  if [AgruparFilial] then&#13;&#10;  begin&#13;&#10;    CabecalhoFilial.visible:=true;&#13;&#10;    RodapeFilial.visible:=true;  &#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    CabecalhoFilial.visible:=false;&#13;&#10;    RodapeFilial.visible:=false;  &#13;&#10;  end; &#13;&#10;&#13;&#10;  if [AgruparFornecedor] then&#13;&#10;    CabecalhoFornecedor.visible:=true&#13;&#10;  else&#13;&#10;    CabecalhoFornecedor.visible:=false;&#13;&#10;&#13;&#10;  if [AgruparClasseProduto] then&#13;&#10;  begin&#13;&#10;    CabecalhoClasseProduto.visible:=true;&#13;&#10;    RodapeClasseProduto.visible:=true;&#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    CabecalhoClasseProduto.visible:=false;&#13;&#10;    RodapeClasseProduto.visible:=false;&#13;&#10;  end; &#13;&#10; &#13;&#10;  if [AgruparGrupoProduto] then&#13;&#10;  begin&#13;&#10;    CabecalhoGrupoProduto.visible:=true;&#13;&#10;    RodapeGrupoProduto.visible:=true;  &#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    CabecalhoGrupoProduto.visible:=false;&#13;&#10;    RodapeGrupoProduto.visible:=false;  &#13;&#10;  end; &#13;&#10;&#13;&#10;  if [AgruparProduto] then&#13;&#10;  begin&#13;&#10;    CabecalhoProduto.visible:=true;&#13;&#10;    RodapeProduto.visible:=true;  &#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    CabecalhoProduto.visible:=false;&#13;&#10;    RodapeProduto.visible:=false;  &#13;&#10;  end; &#13;&#10;  end&#13;&#10;end;&