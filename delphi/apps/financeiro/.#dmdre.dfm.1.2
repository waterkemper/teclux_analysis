      #9#9#9'   coalesce(ct.desconto,0)<>0'
      ''
      '    )'
      '    union all'
      '    ('
      '       /* DESCONTOS DE VENDAS SEM CONTRATO */'
      ''
      '      select'
      '      c.tipoproduto,'
      
        '      cast('#39'DESCONTOS - '#39' as varchar)||cast(tp.descricao as varc' +
        'har) as descricaotipoproduto,'
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
