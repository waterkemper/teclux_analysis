  object qryDespesasOperacionais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select cast(3 as integer) as classificacao,'
      
        '       cast('#39'(-) DESPESAS OPERACIONAIS'#39' as varchar(50)) as descr' +
        'icaoclassificacao,'
      '       evento, descricaoevento, sum(valor) as valor'
      ''
      'from'
      '('
      ''
      '  ('
      
        '  select dp.evento, e.descricao as descricaoevento, - abs(d.valo' +
        'rvencto) as valor'
      '  from documentospag dp'
      '       join eventos e'
      '       on dp.evento = e.codigo'
      ''
      '       join duplicatas d'
      '       on dp.numero = d.documentopag'
      ''
      '  where d.datavencto between :datainicial and :datafinal'
      '    and coalesce(e.incluirnadre,false)'
      '    and e.tipomovimentacao ='#39'S'#39
      '    and not coalesce(dp.previsao,false)'
      '  order by dp.evento, e.descricao'
      '  )'
      ''
      '  union all'
      ''
      '  ('
      
        '  select mbe.evento, e.descricao as descricaoevento,  - abs(mbe.' +
        'valor) as valor'
      '  from movtosbancos mb'
      '       join movtosbancoseventos mbe'
      '            join eventos e on mbe.evento = e.codigo'
      '        on mb.conta = mbe.conta'
      '        and mb.data = mbe.data'
      '        and mb.sequencia = mbe.sequencia    '
      '  where mbe.data between :datainicial and :datafinal'
      '    and mb.origemlancto = '#39'B'#39
      '    and coalesce(e.incluirnadre,false)'
      '    and e.tipomovimentacao = '#39'S'#39
      ''
      '  order by mbe.evento, e.descricao'
      '  )'
      ''
      ') as despesasoperacionais'
      'group by evento, descricaoevento'
      ''
      '')
    RequestLive = False
    Left = 120
    Top = 232
    ParamData = <
      item
        DataType = ftString
        Name = 'datainicial'
        ParamType = ptUnknown
        Value = #39'2015-01-01'#39
      end
      item
        DataType = ftString
        Name = 'datafinal'
        ParamType = ptUnknown
        Value = #39'2015-01-31'#39
      end>
  end
