    Macros = <>
    Sql.Strings = (
      ';'
      '  select cast(3 as integer) as classificacao,'
      
        '         cast('#39'(-) CUSTOS DAS VENDAS'#39' as varchar(50)) as descric' +
        'aoclassificacao,'
      '         custo.tipoproduto,'
