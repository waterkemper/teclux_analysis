      ' ) as custo'
      ' where valor is not null'
      ''
      '        group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo, grupo,'
      '            descricaoclasse,'
      '            classe'
      ''
      ''
      '        order by tipoproduto,'
      '            descricaotipoproduto,'
