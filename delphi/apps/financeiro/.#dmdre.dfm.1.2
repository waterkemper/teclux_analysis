        'roduto = pc.produto'
      
        '                                                        and m2.f' +
        'ilial = pc.filial'
      
        '                                                        and m2.d' +
        'ata < (cancelados.datapagto +1)'
      
        '                                                        and coal' +
        'esce(m2.financeiro,0)<>0'
      
        '                                                        and coal' +
        'esce(m2.emestoque,0)<>0'
      '                                                     ) as m2'
      
        '                                                   ) as m join m' +
        'ovimentos m4 on m4.data = m.data'
      
        '                                                                ' +
        '            and m4.lancto = m.lancto'
      
        '                                                                ' +
        '            and m4.produto = pc.produto'
      
        '                                                                ' +
        '            and m4.filial = pc.filial'
      
        '                                                   order by m4.l' +
        'ancto desc limit 1'
      '                                                  )'#9#9#9#9#9#9'   '
      ''
      ''
      '                           '
      '    where true'
      ''
      ''
      '   )'
      '   '
      '   union all'
      '   '
      '   ('
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      
        '      cast('#39'DEVOLU'#199#213'ES - '#39' as varchar)||cast(tp.descricao as var' +
        'char) as descricaotipoproduto,'
      ''
      
        '      case when :AgruparGrupo then c.grupo     else cast(null as' +
        ' varchar(4)) end as grupo,'
      
        '      case when :AgruparGrupo then g.descricao else cast(null as' +
        ' varchar(30)) end as descricaogrupo,'
      
        '      case when :AGruparClasse then c.classe    else cast(null a' +
        's varchar(2)) end as classe,'
      
        '      case when :AGruparClasse then cl.descricao else cast(null ' +
        'as varchar(30)) end as descricaoclasse,'
      ''
      ''
      #9'  pnp.quantidade * abs(m1.valor/m1.quantidade) as valor'
      ''
      '     from (notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      
        '           on pnp.produto=p.codigo) on np.codigo = pnp.codigonot' +
        'a)'
      #9#9'   '
      
        #9#9'               JOIN movimentos m1 ON m1.produto = pnp.produto ' +
        'AND'
      '                                     m1.filial = pnp.filial AND'
      '                                     m1.data = np.data and'
      
        '                                     m1.codigonota = pnp.codigon' +
        'ota and'
      
        '                                     m1.numero =  (select m4.num' +
        'ero'
      '                                                   from'
      '                                                   ('
      
        '                                                     select m2.d' +
        'ata,'
      
        '                                                            (sel' +
        'ect max(m3.lancto)'
      
        '                                                             fro' +
        'm movimentos m3'
      
        '                                                             whe' +
        're m3.produto = pnp.produto'
      
        '                                                               a' +
        'nd m3.filial = pnp.filial'
      
        '                                                               a' +
        'nd m3.data = np.data'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'   and m3.codigonota = pnp.codigonota'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'   and m3.numerocontrole = pnp.numero'
      #9'    '#9#9#9#9#9#9#9#9#9#9#9#9#9'   and coalesce(m3.valor,0)<>0'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'   ) as lancto'
      '                                                     from'
      '                                                     ('
      
        '                                                      select max' +
        '(m2.data) as data'
      
        '                                                      from movim' +
        'entos m2'
      
        '                                                      where m2.p' +
        'roduto = pnp.produto'
      
        '                                                        and m2.f' +
        'ilial = pnp.filial'
      
        '                                                        and m2.d' +
        'ata = np.data'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9'and m2.codigonota = pnp.codigonota'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9'and m2.numerocontrole = pnp.numero'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9'and coalesce(m2.valor,0)<>0'
      '                                                     ) as m2'
      
        '                                                   ) as m join m' +
        'ovimentos m4 on m4.produto = pnp.produto'
      
        '                                                                ' +
        '            and m4.filial = pnp.filial'
      
        '                                                                ' +
        '            and m4.data = m.data'
      
        '                                                                ' +
        '            and m4.codigonota = pnp.codigonota'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'and m4.numerocontrole = pnp.numero'
      
        '                                                                ' +
        '            and m4.lancto = m.lancto'
      ''
      
        '                                                                ' +
        '            '
      
        '                                                   order by m4.l' +
        'ancto desc limit 1'
      '                                                  )'
      ''
      #9#9'   '
      #9#9'   '
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      ''
      '   )'
