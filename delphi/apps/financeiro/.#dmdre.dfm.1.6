  object qryReceitasDespesasFinanceiras: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      
        'select classificacao, descricaoclassificacao, DescricaoEvento, s' +
        'um(valor) as valor'
      'from'
      '('
      ''
      '  ('
      '    select cast(5 as integer) as classificacao,'
      
        '           cast('#39'Receitas Financeiras'#39' as varchar(50)) as descri' +
        'caoclassificacao,'
      
        '           cast('#39'Juros Recebidos'#39' as varchar(50)) as DescricaoEv' +
        'ento,'
      '           sum(valor) as valor'
      '    from'
      '    ('
      ''
      '    select  p.valorpagto - p.valorvencto as valor'
      '    from parcelas p'
      '    where p.datapagto between :datainicial and :datafinal'
      '      and (p.valorpagto - p.valorvencto) > 0'
      '    ) as jurosrecebidos'
      '  )'
      ''
      '  union all'
      ''
      '  ('
      '    select cast(5 as integer) as classificacao,'
      
        '           cast('#39'Receitas Financeiras'#39' as varchar(50)) as descri' +
        'caoclassificacao,'
      
        '           cast('#39'Descontos Recebidos'#39' as varchar(50)) as Descric' +
        'aoEvento,'
      '           sum(valor) as valor'
      '    from'
      '    ('
      ''
      '    select  d.valorvencto - d.valorpagto  as valor'
      '    from duplicatas d'
      '    where d.datapagto between :datainicial and :datafinal'
      '      and (d.valorvencto - d.valorpagto) > 0'
      '    ) as jurospagos'
      '  )'
      ''
      ''
      '  union all'
      ''
      '  ('
      '    select cast(6 as integer) as classificacao,'
      
        '           cast('#39'Despesas Financeiras'#39' as varchar(50)) as descri' +
        'caoclassificacao,'
      
        '           cast('#39'Descontos Concedidos'#39' as varchar(50)) as Descri' +
        'caoEvento,'
      '           sum(valor) as valor'
      '    from'
      '    ('
      ''
      '    select  p.valorpagto - p.valorvencto as valor'
      '    from parcelas p'
      '    where p.datapagto between :datainicial and :datafinal'
      '      and (p.valorpagto - p.valorvencto) < 0'
      '    ) as descontosconcedidos'
      '  )'
      ''
      '  union all'
      ''
      '  ('
      '    select cast(6 as integer) as classificacao,'
      
        '           cast('#39'Despesas Financeiras'#39' as varchar(50)) as descri' +
        'caoclassificacao,'
      
        '           cast('#39'Juros Pagos'#39' as varchar(50)) as DescricaoEvento' +
        ','
      '           sum(valor) as valor'
      '    from'
      '    ('
      ''
      '    select  d.valorvencto - d.valorpagto  as valor'
      '    from duplicatas d'
      '    where d.datapagto between :datainicial and :datafinal'
      '      and (d.valorvencto - d.valorpagto) < 0'
      '    ) as jurospagos'
      '  )'
      ')  as receitasdespesas'
      ''
