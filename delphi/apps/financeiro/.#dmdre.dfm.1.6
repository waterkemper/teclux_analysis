  object qryCustoMercadoria: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      '  select cast(3 as integer) as classificacao,'
      
        '         cast('#39'(-) CUSTOS DAS VENDAS'#39' as varchar(50)) as descric' +
        'aoclassificacao,'
      '         custo.tipoproduto,'
      '         custo.descricaotipoproduto,'
      '         custo.grupo,'
      '         custo.descricaogrupo,'
      '         custo.classe,'
      '         custo.descricaoclasse,'
      '         sum(custo.valor) as valor'
      '  from'
      '  ('
      ''
      ''
      
        '    /* CUSTO DOS PRODTUOS DOS CONTRATOS FATURADOS RETIRNANDO AS ' +
        'NOTAS FISCAIS */'
      '    ('
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      
        '      case when :AgruparGrupo then c.grupo     else cast(null as' +
        ' varchar(4)) end as grupo,'
      
        '      case when :AgruparGrupo then g.descricao else cast(null as' +
        ' varchar(30)) end as descricaogrupo,'
      
        '      case when :AGruparClasse then c.classe    else cast(null a' +
        's varchar(2)) end as classe,'
      
        '      case when :AGruparClasse then cl.descricao else cast(null ' +
        'as varchar(30)) end as descricaoclasse,'
      ''
      ''
      '      -'
      
        #9'    case when coalesce(m1.financeiro,0) <> 0 and coalesce(m1.em' +
        'estoque,0) <> 0 then'
      '      ((pc.quantidade - (select sum(pdf.quantidade)'
      '                       from produtosdadosfiscais pdf'
      '                            join dadosfiscais df'
      '                            on pdf.dadofiscal = df.numero'
      '                       where df.contrato = ct.numero'
      '                         and pdf.produto = pc.produto'
      '                         and df.situacao = '#39'N'#39
      
        '                         and df.data between(:DataInicial) and (' +
        ':DataFinal))) *  (m1.financeiro/m1.emestoque))'
      '     else'
      '       0'
      '  '#9' end as valor'
      ''
      '     from (contratos ct'
      '           join (produtoscontratos pc'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on pc.produto=p.codigo)'
      #9#9#9#9
      '           on ct.numero = pc.contrato)'
      ''
      #9#9
      
        '           LEFT JOIN movimentos m1 ON m1.produto = pc.produto AN' +
        'D'
      '                                     m1.filial = pc.filial AND'
      
        '                                     m1.numero =  (select m4.num' +
        'ero'
      '                                                   from'
      '                                                   ('
      
        '                                                     select m2.d' +
        'ata,'
      
        '                                                            (sel' +
        'ect max(m3.lancto)'
      
        '                                                             fro' +
        'm movimentos m3'
      
        '                                                             whe' +
        're m3.produto = pc.produto'
      
        '                                                               a' +
        'nd m3.filial = pc.filial'
      
        '                                                               a' +
        'nd m3.data = m2.data'
      #9'    '#9#9#9#9#9#9#9#9#9#9#9#9#9'   and coalesce(m3.financeiro,0)<>0'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9'       and coalesce(m3.emestoque,0)<>0'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'   ) as lancto'
      '                                                     from'
      '                                                     ('
      
        '                                                      select max' +
        '(m2.data) as data'
      
        '                                                      from movim' +
        'entos m2'
      
        '                                                      where m2.p' +
        'roduto = pc.produto'
      
        '                                                        and m2.f' +
        'ilial = pc.filial'
      
        '                                                        and m2.d' +
        'ata < (ct.faturamento +1)'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9'and coalesce(m2.financeiro,0)<>0'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9'and coalesce(m2.emestoque,0)<>0'
      '                                                     ) as m2'
      
        '                                                   ) as m join m' +
        'ovimentos m4 on m4.data = m.data'
      
        '                                                                ' +
        '            and m4.lancto = m.lancto'
      
        '                                                                ' +
        '            and m4.produto = pc.produto'
      
        '                                                                ' +
        '            and m4.filial = pc.filial'
      
        '                                                   order by m4.l' +
        'ancto desc limit 1'
      '                                                  )'
      #9#9#9#9#9#9#9#9#9#9#9#9
      ''
      '     where not pc.brinde'
      #9'   and ct.faturamento between(:DataInicial) and (:DataFinal)'
      #9'   and (coalesce(ct.valorvista,0)<>0)'
      #9'   and ct.origem is null'
      #9
      #9'   and (pc.quantidade - (select sum(pdf.quantidade)'
      '                             from produtosdadosfiscais pdf'
      '                              join dadosfiscais df'
      '                            on pdf.dadofiscal = df.numero'
      '                       where df.contrato = ct.numero'
      '                         and pdf.produto = pc.produto'
      '                         and df.situacao = '#39'N'#39
      
        '                         and df.data between(:DataInicial) and (' +
        ':DataFinal))) > 0'
      #9
      #9#9#9
      '   )'
      ''
      '    union all'
      ''
      '    /* CUSTO DOS PRODTUOS DAS NOTAS FISCAIS */'
      ''
      '   ('
      ''
      '          select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      ''
      
        '      case when :AgruparGrupo then c.grupo     else cast(null as' +
        ' varchar(4)) end as grupo,'
      
        '      case when :AgruparGrupo then g.descricao else cast(null as' +
        ' varchar(30)) end as descricaogrupo,'
      
        '      case when :AGruparClasse then c.classe    else cast(null a' +
        's varchar(2)) end as classe,'
      
        '      case when :AGruparClasse then cl.descricao else cast(null ' +
        'as varchar(30)) end as descricaoclasse,'
      ''
      #9'  -'
      #9'  pdf.quantidade * abs(m1.valor/m1.quantidade) as valor'
      ''
      '      from (dadosfiscais df'
      '             join (produtosdadosfiscais pdf'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      ''
      '                         on p.caracteristica=c.codigo)'
      
        '             on pdf.produto=p.codigo) on df.numero = pdf.dadofis' +
        'cal)'
      #9#9#9
      #9#9#9
      '            JOIN movimentos m1 ON m1.produto = pdf.produto AND'
      '                                     m1.filial = pdf.filial AND'
      '                                     m1.data = df.data and'
      
        '                                     m1.dadofiscal = pdf.dadofis' +
        'cal and'
      
        '                                     m1.numero =  (select m4.num' +
        'ero'
      '                                                   from'
      '                                                   ('
      
        '                                                     select m2.d' +
        'ata,'
      
        '                                                            (sel' +
        'ect max(m3.lancto)'
      
        '                                                             fro' +
        'm movimentos m3'
      
        '                                                             whe' +
        're m3.produto = pdf.produto'
      
        '                                                               a' +
        'nd m3.filial = pdf.filial'
      
        '                                                               a' +
        'nd m3.data = df.data'
      
        #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'                                 and m3.dadofisca' +
        'l = df.numero'
      #9'    '#9#9#9#9#9#9#9#9#9#9#9#9#9'   and coalesce(m3.valor,0)<>0'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'   ) as lancto'
      '                                                     from'
      '                                                     ('
      
        '                                                      select max' +
        '(m2.data) as data'
      
        '                                                      from movim' +
        'entos m2'
      
        '                                                      where m2.p' +
        'roduto = pdf.produto'
      
        '                                                        and m2.f' +
        'ilial = pdf.filial'
      
        '                                                        and m2.d' +
        'ata = df.data'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9'and m2.dadofiscal = df.numero'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9'and coalesce(m2.valor,0)<>0'
      '                                                     ) as m2'
      
        '                                                   ) as m join m' +
        'ovimentos m4 on m4.produto = pdf.produto'
      
        '                                                                ' +
        '            and m4.filial = pdf.filial'
      
        '                                                                ' +
        '            and m4.data = m.data'
      
        '                                                                ' +
        '            and m4.dadofiscal = df.numero'
      
        '                                                                ' +
        '            and m4.lancto = m.lancto'
      ''
      
        '                                                                ' +
        '            '
      
        '                                                   order by m4.l' +
        'ancto desc limit 1'
      '                                                  )'
      ''
      '      Where (df.data between (:DataInicial) and (:DataFinal))'
      '              and df.situacao='#39'N'#39
      '              and eHNotaFiscalSaidaVenda(pdf.codigofiscal)'
      '        and not coalesce(df.notavinculada,false)'
      ''
      '    )'
      ''
      '    union all'
      ''
      '    ('
      ''
      
        '       /* CONTRATOS FATURADOS DEVOLVIDOS  - ABATIMENTO DO VALOR ' +
        'NEGATIVO */'
      '        select'
      ''
      '        c.tipoproduto,'
      
        '        cast('#39'DEVOLU'#199#213'ES - '#39' as varchar)||cast(tp.descricao as v' +
        'archar) as descricaotipoproduto,'
      ''
      
        '        case when :AgruparGrupo then c.grupo     else cast(null ' +
        'as varchar(4)) end as grupo,'
      
        '        case when :AgruparGrupo then g.descricao else cast(null ' +
        'as varchar(30)) end as descricaogrupo,'
      
        '        case when :AGruparClasse then c.classe    else cast(null' +
