  object qryDespesasOperacionais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select cast(3 as integer) as classificacao,'
      
        '       cast('#39'(-) DESPESAS OPERACIONAIS'#39' as varchar(50)) as descr' +
        'icaoclassificacao,'
      
        '       evento, tipo, classificacaoevento, descricaoevento, sum(v' +
        'alor) as valor'
      ''
      'from'
      '('
      ''
      '  ('
      '  '
      '  select e.codigo as evento,'
      '         e.descricao as descricaoevento,'
      '         e.tipo,'
      '         e.classificacao as classificacaoevento,'
      '         sum(lista.valor) as valor'
      '         '
      '  from'
      '  (                  '
      
        '  select unnest(pg_catalog.string_to_array(sinteticas,'#39','#39')) as c' +
        'lassificacao,'
      '         valor'
      '  from'
      '  ('
      '    '
      '  select       '
      '         '
      '         (select string_agg(es.classificacao, '#39','#39')'
      '          from eventos es'
      '          where es.tipomovimentacao='#39'S'#39
      '            and position(es.classificacao in e.classificacao)=1 '
      '          ) as sinteticas,'
      '          '
      '         - abs(d.valorvencto) as valor'
      '  from documentospag dp'
      '       join eventos e'
      '       on dp.evento = e.codigo'
      ''
      '       join duplicatas d'
      '       on dp.numero = d.documentopag'
      ''
      '  where d.datavencto between :DataInicial and :DataFinal'
      '    and coalesce(e.incluirnadre,false)'
      '    and e.tipomovimentacao ='#39'S'#39
      '    and not coalesce(dp.previsao,false)'
      '  '
      '  ) as lista '
      '  ) as lista'
      '    join eventos e on lista.classificacao = e.classificacao'
      '  '
      '  group by e.codigo, e.descricao'
      '  order by e.classificacao, e.tipo, e.codigo, e.descricao'
      '  )'
      ''
      '  union all'
      ''
      '  ('
      '  '
      '    select e.codigo as evento,'
      '         e.descricao as descricaoevento,'
      '         e.tipo,'
      '         e.classificacao as classificacaoevento,'
      '         sum(lista.valor) as valor'
      '         '
      '  from'
      '  (                  '
      
        '  select unnest(pg_catalog.string_to_array(sinteticas,'#39','#39')) as c' +
        'lassificacao,'
      '         valor'
      '  from'
      '  ('
      ''
      '   select'
      '   (select string_agg(es.classificacao, '#39','#39')'
      '    from eventos es'
      '    where es.tipomovimentacao='#39'S'#39
      
        '      and position(es.classificacao in e.classificacao)=1) as si' +
        'nteticas,'
      '          '
      '         - abs(mbe.valor) as valor'
      '  '
      '  '
      '  from movtosbancos mb'
      '       join movtosbancoseventos mbe'
      '            join eventos e on mbe.evento = e.codigo'
      '        on mb.conta = mbe.conta'
      '        and mb.data = mbe.data'
      '        and mb.sequencia = mbe.sequencia    '
      '  where mbe.data between :DataInicial and :DataFinal'
      '    and mb.origemlancto = '#39'B'#39
      '    and coalesce(e.incluirnadre,false)'
      '    and e.tipomovimentacao = '#39'S'#39
      ''
      '  order by mbe.evento, e.descricao'
      '  '
      '  ) as lista '
      '  ) as lista'
      '    join eventos e on lista.classificacao = e.classificacao'
      '  '
      '  group by e.codigo, e.descricao'
      '  order by e.classificacao, e.tipo, e.codigo, e.descricao'
      '  '
      '  )'
      ') as despesasoperacionais'
      'group by classificacaoevento, tipo, descricaoevento, evento'
      'order by classificacaoevento, tipo, descricaoevento, evento'
      ''
      ''
      '')
    RequestLive = False
    Left = 120
    Top = 232
    ParamData = <
      item
        DataType = ftString
        Name = 'datainicial'
        ParamType = ptUnknown
        Value = #39'2015-01-01'#39
      end
      item
        DataType = ftString
        Name = 'datafinal'
        ParamType = ptUnknown
        Value = #39'2015-01-31'#39
      end>
