  object qryReceita_Operacional_Bruta: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select sel.*'
      'from'
      '('
      ''
      '('
      '   /* VENDAS COM CONTRATOS */'
      '  select cast(1 as integer) as classificacao,'
      
        '         cast('#39'RECEITA OPERACIONAL BRUTA'#39' as varchar(50)) as des' +
        'cricaoclassificacao,'
      '         vp.tipoproduto,'
      '         vp.descricaotipoproduto,'
      '         vp.grupo,'
      '         vp.descricaogrupo,'
      '         vp.classe,'
      '         vp.descricaoclasse,'
      '         sum(vp.ValorBrutodoProduto) as ValorBrutodoProduto'
      '  from'
      '  ('
      '    ('
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      #9'  '
      #9'  /* VALOR BRUTO */'
      #9'  ((pc.quantidade*pc.precovenda) +'
      
        '      (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quantid' +
        'ade*pc.precovenda))  /'
      
        '       (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-' +
        'coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '               coalesce((select  sum(sc.quantidade*coalesce(sc.v' +
        'alorservico,0))'
      '                from servicoscontratos sc'
      '                where sc.contrato = ct.numero),0)),0),1)))) +'
      ''
      #9'  /* ACRESCIMO */'#9#9#9
      
        '      (((ValorPrazo-ValorVista)*(pc.quantidade*pc.precovenda))  ' +
        '/'
      
        '       (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-' +
        'coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '               coalesce((select  sum(sc.quantidade*coalesce(sc.v' +
        'alorservico,0))'
      '                from servicoscontratos sc'
      '                where sc.contrato = ct.numero),0)),0),1)))'
      #9#9#9#9
      '      as  ValorBrutodoProduto'
      ''
      ''
      '     from (contratos ct'
      '           join (produtoscontratos pc'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on pc.produto=p.codigo)'
      '           on ct.numero = pc.contrato)'
      ''
      '     where not pc.brinde and'
      
        '               ct.faturamento between(:datainicial) and (:datafi' +
        'nal) and'
      '               (coalesce(ct.valorvista,0)<>0) and'
      '               ct.origem is null'
      ''
      '    )'
      '    union all'
      '    ('
      '      /* VENDAS SEM CONTRATO */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      ''
      '       /* VALOR BRUTO */'
      #9'  ((pdf.quantidade*pdf.precovenda) +'
      
        '      (((coalesce(df.valorfrete,0)+coalesce(df.seguro,0))*(pdf.q' +
        'uantidade*pdf.precovenda))  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '        where sdf.dadofiscal = df.numero),0)),0),1))'
      '          )) +'
      #9'   /* ACRESCIMO */'
      ''
      
        '      (((df.Valortotal-df.ValorVista)*(pdf.quantidade*pdf.precov' +
        'enda))  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      ''
      #9'   as ValorBrutodoProduto'
      ''
      '      from (dadosfiscais df'
      '             join (produtosdadosfiscais pdf'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      ''
      '                         on p.caracteristica=c.codigo)'
      
        '             on pdf.produto=p.codigo) on df.numero = pdf.dadofis' +
        'cal)'
      ''
      
        '      Where (df.data between (:datainicial) and (:datafinal)) an' +
        'd df.contrato is null'
      '              and df.situacao='#39'N'#39
      '              and eHNotaFiscalSaidaVenda(pdf.codigofiscal)'
      '        and not coalesce(df.notavinculada,false)'
      ''
      ''
      '    )'
      '  )  as vp'
      '     group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo,'
      '            grupo,'
      '            descricaoclasse,'
      '            classe'
      ''
      ''
      ')'
      ''
      '  union all'
      ''
      '('
      '    select'
      ''
      '      cast(1 as integer) as classificacao,'
      
        '      cast('#39'RECEITA OPERACIONAL BRUTA'#39' as varchar(50)) as descri' +
        'caoclassificacao,'
      ''
      '      cast('#39'09'#39' as varchar(2)) as tipoproduto,'
      
        '      (select tp.descricao from tiposproduto tp where tp.codigo ' +
        '= '#39'09'#39') as descricaotipoproduto,'
      ''
      #9'  '
      
        #9'  case when :AgruparGrupo then cast('#39'SE'#39' as varchar(4))        ' +
        'else cast(null as varchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then cast('#39'SERVICOS'#39' as varchar(30)) ' +
        'else cast(null as varchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then cast('#39'SE'#39' as varchar(02))      ' +
        ' else cast(null as varchar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cast('#39'SERVICOS'#39' as varchar(30))' +
        ' else cast(null as varchar(30)) end as descricaoclasse,'
      ''
      '/*'#9'  '
      '      cast('#39'SE'#39' as varchar(4)) as grupo,'
      '      cast('#39'SERVICOS'#39' as varchar(30)) as descricaogrupo,'
      ''
      '      cast('#39'SE'#39' as varchar(02)) as classe,'
      '      cast('#39'SERVICOS'#39' as varchar(30)) as descricaoclasse,'
      '*/'#9'  '
      ''
      
        '      sum(round((coalesce(sc.quantidade,0)*coalesce(sc.valorserv' +
        'ico,0)),2)) as valorBrutodoProduto'
      ''
      '   from (contratos ct'
      ''
      '                              join servicoscontratos sc'
      
        '                                                                ' +
        '        on ct.numero = sc.contrato)'
      '   where ct.faturamento between(:DataInicial) and (:DataFinal)'
      ''
      '   /*'
      '   group by tipoproduto,'
      '            descricaotipoproduto,'
      '            grupo,'
      '            descricaogrupo,'
      '            classe,'
      '            descricaoclasse'
      #9#9#9'*/'
      ''
      ')'
      ''
      'union all'
      ''
      ''
      '('
      '  select cast(2 as integer) as classificacao,'
      
        '        cast('#39'(-) DEDU'#199#213'ES DA RECEITA BRUTA'#39' as varchar(50)) as ' +
        'descricaoclassificacao,'
      '        dev.tipoproduto,'
      '        dev.descricaotipoproduto,'
      '        dev.grupo,'
      '        dev.descricaogrupo,'
      '        dev.classe,'
      '        dev.descricaoclasse,'
      '        sum(dev.ValorBrutodoproduto) as ValorBrutodoproduto'
      '  from'
      '  ('
      ''
      '    ('
      ''
      '       /* CONTRATOS FATURADOS DEVOLVIDOS */'
      '        select'
      ''
      '        c.tipoproduto,'
      
        '        cast('#39'DEVOLU'#199#213'ES - '#39' as varchar)||cast(tp.descricao as v' +
        'archar) as descricaotipoproduto,'
      #9#9
      
        '  '#9'    case when :AgruparGrupo then c.grupo     else cast(null a' +
        's varchar(4)) end as grupo,'
      
        #9'    case when :AgruparGrupo then g.descricao else cast(null as ' +
        'varchar(30)) end as descricaogrupo,'
      
        #9'    case when :AGruparClasse then c.classe    else cast(null as' +
        ' varchar(2)) end as classe,'
      
        #9'    case when :AGruparClasse then cl.descricao else cast(null a' +
        's varchar(30)) end as descricaoclasse,'
      #9#9
      ''
      '        -'
      #9#9'/* VALOR BRUTO */'
      #9#9'((cd.valorvista + cd.desconto) +'
      #9#9'/* ACRESCIMO*/'
      #9#9' (cd.ValorPrazo-cd.ValorVista))'
      #9#9'as ValorBrutodoproduto'
      ''
      '        from ((contratosdevolvidos cd'
      '               join contratos ct'
      '               on cd.contrato=ct.numero)'
      ''
      '               join (produtos p'
      '                     join (((caracteristicas c'
      '                             join classes cl'
      '                             on c.classe=cl.codigo)'
      ''
      '                             join grupos g'
      '                             on c.grupo = g.codigo)'
      ''
      '                             join tiposproduto tp'
      '                             on c.tipoproduto = tp.codigo)'
      ''
      '                     on p.caracteristica=c.codigo)'
      '               on cd.produto=p.codigo)'
      ''
      
        '        where cd.devolucao between(:DataInicial) and (:DataFinal' +
        ')'
      '          /* and cd.tipo = '#39'D'#39' */'
      
        '          and case when ct.os then ct.tipoequipamento in (1,2) a' +
        'nd not (coalesce(ct.os_garantia,false) and ct.os_garantia_status' +
        '='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '          and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturadas' +
        ' as outras entram pelas notas fiscais devido a cr'#233'ditos de troca' +
        ' */'
      ''
      '    )'
      ''
      ''
      '    union all'
      ''
      '    ('
      '        /* CONTRATOS FATURADOS TOTALMENTE CANCELADOS  */'
      '        select'
      '        c.tipoproduto,'
      
        #9#9'    cast('#39'DEVOLU'#199#213'ES - '#39' as varchar)||cast(tp.descricao as var' +
        'char) as descricaotipoproduto,'
      #9#9#9
      
        #9'    case when :AgruparGrupo then c.grupo     else cast(null as ' +
        'varchar(4)) end as grupo,'
      
        #9'    case when :AgruparGrupo then g.descricao else cast(null as ' +
        'varchar(30)) end as descricaogrupo,'
      
        #9'    case when :AGruparClasse then c.classe    else cast(null as' +
        ' varchar(2)) end as classe,'
      
        #9'    case when :AGruparClasse then cl.descricao else cast(null a' +
        's varchar(30)) end as descricaoclasse,'
      #9#9#9#9#9
      '      - '#9'  '
      #9'  /* VALOR BRUTO */'
      #9'  (((pc.quantidade*pc.precovenda) +'
      
        '      (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quantid' +
        'ade*pc.precovenda))  /'
      
        '      (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-c' +
        'oalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                   coalesce((select  sum(sc.quan' +
        'tidade*coalesce(sc.valorservico,0))'
      '        from servicoscontratos sc'
      '        where sc.contrato = ct.numero),0)),0),1))'
      '      )) +'
      #9'  '
      #9'  /* ACRESCIMO */'
      #9'  '
      
        #9'   (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precovenda' +
        '))  /'
      
        '       (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-' +
        'coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '               coalesce((select  sum(sc.quantidade*coalesce(sc.v' +
        'alorservico,0))'
      '                from servicoscontratos sc'
      '                where sc.contrato = ct.numero),0)),0),1))) -'
      #9#9#9#9
      #9#9'/* DESCONTO */'#9#9
      
        '       ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)) ' +
        ' /'
      
        '       (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-' +
        'coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '               coalesce((select  sum(sc.quantidade*coalesce(sc.v' +
        'alorservico,0))'
      '                from servicoscontratos sc'
      '                where sc.contrato = ct.numero),0)),0),1))))'
      #9'  '
      #9'  as ValorBrutodoProduto'
      ''
      ''
      '    from (select distinct ct.numero, p.datapagto'
      '          from contratos ct, parcelas p'
      '          where ct.numero=p.contrato '
      #9#9'   and ct.situacao='#39'C'#39' '
      #9#9'   and not exists (select p2.numero'
      '                           from parcelas p2'
      '                           where p2.contrato = ct.numero '
      #9#9#9#9#9#9'     and p2.tipopagto<>'#39'E'#39') '
      #9#9'   and p.datapagto between :datainicial and :datafinal '
      #9#9'   and not exists (select cd.contrato'
      '                           from contratosdevolvidos cd'
      
        '                           where cd.contrato = ct.numero /*and c' +
        'd.tipo='#39'D'#39'*/ )'
      
        '           and case when ct.os then ct.tipoequipamento in (1,2) ' +
        'and not (coalesce(ct.os_garantia,false) and ct.os_garantia_statu' +
        's='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '         ) as cancelados, (contratos ct '
      #9#9'                   join (produtoscontratos pc'
      #9#9#9#9#9#9'         join (produtos p'
      #9#9#9#9#9#9#9#9'       join (((caracteristicas c'
      #9#9#9#9#9#9#9#9#9'           join classes cl'
      #9#9#9#9#9#9#9#9#9#9#9'   on c.classe = cl.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9#9#9#9#9'  join grupos g'
      #9#9#9#9#9#9#9#9#9#9#9'  on c.grupo = g.codigo)'
      ''
      #9#9#9#9#9#9#9#9#9#9#9' join tiposproduto tp'
      #9#9#9#9#9#9#9#9#9#9#9' on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                       on p.caracteristica = c.c' +
        'odigo)'
      '                                 on pc.produto=p.codigo)'
      '                           on pc.contrato = ct.numero)'
      '    where cancelados.numero = ct.numero'
      #9#9
      ''
      '    )'
      ''
      '    union all'
      ''
      '    ('
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      
        '      cast('#39'DEVOLU'#199#213'ES - '#39' as varchar)||cast(tp.descricao as var' +
        'char) as descricaotipoproduto,'
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      '      -'
      '      ((pnp.quantidade * pnp.precounitario)'
      '      - coalesce(pnp.valordescontoitem,0)'
      '      - coalesce(pnp.desconto,0)'
      '      + coalesce(pnp.acrescimo,0)'
      '      + coalesce(pnp.frete,0)'
      '      + coalesce(pnp.seguro,0)'
      '      + coalesce(pnp.valoripi,0)'
      '      + coalesce(pnp.icmsvalorst,0)'
      '      + coalesce(pnp.despesasacessorias,0))'
      #9'   as ValorBrutodoProduto'
      ''
      '     from (notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      
        '           on pnp.produto=p.codigo) on np.codigo = pnp.codigonot' +
        'a)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      ''
      '    )'
      ''
      #9'union all'
      ''
      ''
      '    ('
      ''
      '       /* DESCONTOS DE VENDAS COM CONTRATO */'
      ''
      '      select'
      '      c.tipoproduto,'
      
        #9'  cast('#39'DESCONTOS - '#39' as varchar)||cast(tp.descricao as varchar' +
        ') as descricaotipoproduto,'
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
