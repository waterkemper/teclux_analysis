procedure Tdtmdre.SetDevolucoesPeriodoAnterior(
  const Value: Boolean);
const
 SQLDevolucoesPeriodoAnterior = 'and ct.faturamento < :DataInicial';
 SQLDevolucoesPeriodoSelecionado = 'and ct.faturamento between (:DataInicial) and (:DataFinal)';

begin
  FDevolucoesPeriodoAnterior := Value;
  qryRes_SinteticoFiliais.MacroByName('Inicio_Devolucoes_Contratos').AsString := '/* inicio Devolucoes */';
  qryRes_SinteticoFiliais.MacroByName('Final_Devolucoes_Contratos').AsString := '/* final devolucoes */';
