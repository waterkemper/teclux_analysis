  qryFiliaisVendedores.MacroByName('Final_Devolucoes_Contratos').AsString := '/* final devolucoes */';

  if FDevolucoesPeriodoAnterior and FDevolucoesPeriodoSelecionado then
  begin
    qryFiliaisTipodePlano.MacroByName('Devolucoes').AsString := '';
    qryFiliaisClasseProdutos.MacroByName('Devolucoes').AsString := '';
    qryFiliaisVendedores.MacroByName('Devolucoes').AsString := '';
  end
  else
   if FDevolucoesPeriodoAnterior then
   begin
     qryFiliaisTipodePlano.MacroByName('Devolucoes').AsString := SQLDevolucoesPeriodoAnterior;
     qryFiliaisClasseProdutos.MacroByName('Devolucoes').AsString := SQLDevolucoesPeriodoAnterior;
     qryFiliaisVendedores.MacroByName('Devolucoes').AsString := SQLDevolucoesPeriodoAnterior;
   end
   else
   if FDevolucoesPeriodoSelecionado then
   begin
     qryFiliaisTipodePlano.MacroByName('Devolucoes').AsString := SQLDevolucoesPeriodoSelecionado;
     qryFiliaisClasseProdutos.MacroByName('Devolucoes').AsString := SQLDevolucoesPeriodoSelecionado;
     qryFiliaisVendedores.MacroByName('Devolucoes').AsString := SQLDevolucoesPeriodoSelecionado;
   end
   else
   begin
    qryRes_SinteticoFiliais.MacroByName('Inicio_Devolucoes_Contratos').AsString := '/* inicio Devolucoes ';
    qryRes_SinteticoFiliais.MacroByName('Final_Devolucoes_Contratos').AsString := ' final devolucoes */';
    qryFiliaisTipodePlano.MacroByName('Inicio_Devolucoes_Contratos').AsString := '/* inicio Devolucoes ';
    qryFiliaisTipodePlano.MacroByName('Final_Devolucoes_Contratos').AsString := ' final devolucoes */';
    qryFiliaisClasseProdutos.MacroByName('Inicio_Devolucoes_Contratos').AsString := '/* inicio Devolucoes ';
    qryFiliaisClasseProdutos.MacroByName('Final_Devolucoes_Contratos').AsString := ' final devolucoes */';
    qryFiliaisVendedores.MacroByName('Inicio_Devolucoes_Contratos').AsString := '/* inicio Devolucoes ';
    qryFiliaisVendedores.MacroByName('Final_Devolucoes_Contratos').AsString := ' final devolucoes */';
   end;
end;

