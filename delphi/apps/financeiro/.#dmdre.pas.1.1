procedure Tdtmdre.SetProdutos(
  const Value: String);
var
CondicaoProduto_v,
CondicaoProdutoContrato_v,
CondicaoProdutoContratoDevolvido_v,
CondicaoServico_v,
CondicaoProdutoVendedorContrato_v,
CondicaoProdutoVendedorDadoFiscal_v,
CondicaoProdutoVendedor_d : String;
begin
  CondicaoProduto_v:=
  ' and (produto in (Select p.codigo from produtos p join caracteristicas c'+
  ' on p.caracteristica=c.codigo and c.codigo = '+quotedstr(Value)+'))';

  CondicaoProdutoContrato_v:=
  ' and (pc.produto in (Select p.codigo from produtos p join caracteristicas c'+
  ' on p.caracteristica=c.codigo and c.codigo = '+quotedstr(Value)+'))';

  CondicaoProdutoContratoDevolvido_v:=
  ' and (cd.produto in (Select p.codigo from produtos p join caracteristicas c'+
  ' on p.caracteristica=c.codigo and c.codigo = '+quotedstr(Value)+'))';

  CondicaoProduto_v:=
  ' and (produto in (Select p.codigo from produtos p join caracteristicas c'+
  ' on p.caracteristica=c.codigo and c.codigo = '+quotedstr(Value)+'))';

  CondicaoServico_v:= 'and servico is null';

  CondicaoProdutoVendedorContrato_v:=
  ' and exists (select pc.produto '+
               'from produtoscontratos pc '+
               'where pc.contrato=ct.numero and '+
               'pc.produto in (Select p.codigo '+
                              'from produtos p join caracteristicas c '+
                               ' on p.caracteristica=c.codigo and c.codigo = '+quotedstr(Value)+'))';
  CondicaoProdutoVendedorDadoFiscal_v:=
  ' and exists (select pdf.produto '+
               'from produtosdadosfiscais pdf '+
               'where pdf.dadofiscal=df.numero and '+
               'pdf.produto in (Select p.codigo '+
                              'from produtos p join caracteristicas c '+
                               ' on p.caracteristica=c.codigo and c.codigo = '+quotedstr(Value)+'))';

  CondicaoProdutoVendedor_d:=
  ' and (cd.produto in (Select p.codigo from produtos p join caracteristicas c'+
  ' on p.caracteristica=c.codigo and c.codigo = '+quotedstr(Value)+'))';

  if (value <> '') then
  begin
   qryFiliaisClasseProdutos.MacroByName('Produtos').AsString := CondicaoProduto_v;
   qryFiliaisClasseProdutos.MacroByName('ProdutosContratos').AsString := CondicaoProdutoContrato_v;
   qryFiliaisClasseProdutos.MacroByName('ProdutosContratosDevolvidos').AsString := CondicaoProdutoContratoDevolvido_v;
   qryFiliaisClasseProdutos.MacroByName('Servicos').AsString := CondicaoServico_v;

   qryFiliaisVendedores.MacroByName('ProdutoseServicosContratos').AsString := CondicaoProdutoVendedorContrato_v;
   qryFiliaisVendedores.MacroByName('ProdutoseServicosDadosFiscais').AsString := CondicaoProdutoVendedorDadoFiscal_v;
   qryFiliaisVendedores.MacroByName('ProdutosDevolucoes').AsString := CondicaoProdutoVendedor_d;

   FParametroCabecalho:=FParametroCabecalho+' Produtos: '+Value;
  end;
end;

procedure Tdtmdre.SetClasseProdutos(
  const Value: String);
var
CondicaoClasseProduto_v,
CondicaoClasseProdutoContrato_v,
CondicaoClasseProdutoContratoDevolvido_v,
CondicaoClasseServico_v,
CondicaoClasseProdutoVendedorDadoFiscal_v,
CondicaoClasseProdutoVendedorContrato_v,
CondicaoClasseProdutoVendedor_d : String;
begin
  CondicaoClasseProduto_v:=
  ' and (produto in (Select p.codigo '+
  '                     from produtos p, caracteristicas c '+
  '                     where p.caracteristica = c.codigo '+
  '                           and c.classe = '+quotedstr(Value)+'))';

  CondicaoClasseProdutoContrato_v:=
  ' and (pc.produto in (Select p.codigo '+
  '                     from produtos p, caracteristicas c '+
  '                     where p.caracteristica = c.codigo '+
  '                           and c.classe = '+quotedstr(Value)+'))';

  CondicaoClasseProdutoContratoDevolvido_v:=
  ' and (cd.produto in (Select p.codigo '+
  '                     from produtos p, caracteristicas c '+
  '                     where p.caracteristica = c.codigo '+
  '                           and c.classe = '+quotedstr(Value)+'))';

  CondicaoClasseServico_v:= 'and servico is null';

  CondicaoClasseProdutoVendedorContrato_v:=
  ' and exists (select pc.produto '+
               'from produtoscontratos pc '+
               'where pc.contrato=ct.numero and '+
               '      pc.produto in (Select p.codigo '+
               '                     from produtos p, caracteristicas c '+
               '                     where p.caracteristica=c.codigo '+
               '                           and c.classe = '+quotedstr(Value)+'))';

  CondicaoClasseProdutoVendedorDadoFiscal_v:=
  ' and exists (select pdf.produto '+
               'from produtosdadosfiscais pdf '+
               'where pdf.dadofiscal = df.numero and '+
               '      pdf.produto in (Select p.codigo '+
               '                     from produtos p, caracteristicas c '+
               '                     where p.caracteristica=c.codigo '+
               '                           and c.classe = '+quotedstr(Value)+'))';

  CondicaoClasseProdutoVendedor_d:=
  ' and (cd.produto in (Select p.codigo '+
  '                     from produtos p, caracteristicas c '+
  '                     where p.caracteristica=c.codigo '+
  '                           and c.classe = '+quotedstr(Value)+'))';

  if (value <> '') then
  begin
   qryFiliaisClasseProdutos.MacroByName('Produtos').AsString := CondicaoClasseProduto_v;
   qryFiliaisClasseProdutos.MacroByName('ProdutosContratos').AsString := CondicaoClasseProdutoContrato_v;
   qryFiliaisClasseProdutos.MacroByName('ProdutosContratosDevolvidos').AsString := CondicaoClasseProdutoContratoDevolvido_v;
   qryFiliaisClasseProdutos.MacroByName('Servicos').AsString := CondicaoClasseServico_v;

   qryFiliaisVendedores.MacroByName('ProdutoseServicosContratos').AsString := CondicaoClasseProdutoVendedorContrato_v;
   qryFiliaisVendedores.MacroByName('ProdutoseServicosDadosFiscais').AsString := CondicaoClasseProdutoVendedorDadoFiscal_v;
   qryFiliaisVendedores.MacroByName('ProdutosDevolucoes').AsString := CondicaoClasseProdutoVendedor_d;
   FParametroCabecalho:=FParametroCabecalho+' Classe de Produtos: '+Value;
  end;
end;

procedure Tdtmdre.SetDataFinal(
  const Value: String);
begin
  if Value<>'' then
  begin
    FDataFinal := Value;
    if FDataInicial='' then
      FDataInicial:=FDataFinal;
  end
  else
    FDataFinal := FDataInicial;

  qryReceita_Operacional_Bruta.ParamByName('DataInicial').AsString:=FDataInicial;
  qryCustoMercadoria.ParamByName('DataInicial').AsString:=FDataInicial;
  qryDespesasOperacionais.ParamByName('DataInicial').AsString:=FDataInicial;
  qryReceitasDespesasFinanceiras.ParamByName('DataInicial').AsString:=FDataInicial;

  qryReceita_Operacional_Bruta.ParamByName('DataFinal').AsString:=FDataFinal;
  qryCustoMercadoria.ParamByName('DataFinal').AsString:=FDataFinal;
  qryDespesasOperacionais.ParamByName('DataFinal').AsString:=FDataFinal;
  qryReceitasDespesasFinanceiras.ParamByName('DataFinal').AsString:=FDataFinal;

  FParametroCabecalho:=FParametroCabecalho+'Entre: '+FDataInicial+' e '+FDataFinal;

end;

procedure Tdtmdre.SetFiliais(
  const Value: String);
Var
CondicaoFilial: String;
begin
 fFiliais := Value;
 if (Value <> '') then
   CondicaoFilial:=' and (filialvenda in (' + Value + '))'
 else
   CondicaoFilial:='';

 qryRes_SinteticoFiliais.MacroByName('Filiais').AsString := CondicaoFilial;
 qryFiliaisTipodePlano.MacroByName('Filiais').AsString := CondicaoFilial;
 qryFiliaisClasseProdutos.MacroByName('Filiais').AsString := CondicaoFilial;
 qryFiliaisVendedores.MacroByName('Filiais').AsString := CondicaoFilial;
end;

procedure Tdtmdre.SetGrupoFiliais(
  const Value: String);
var
CondicaoGrupoFilial: String;
begin
 fGrupoFiliais := value;
 CondicaoGrupoFilial:=
 ' and (filialvenda in (Select filial From filiaisgruposfiliais '+
 'Where grupo =' + Value + '))';
 if (Value <> '') then
 begin
   if ParSistema.RelatorioSomenteFiliaisAutorizadas then
   begin
     qryRes_SinteticoFiliais.MacroByName('Filiais').AsString :=
       qryRes_SinteticoFiliais.MacroByName('Filiais').AsString + ' and ' +
       CondicaoGrupoFilial;
     qryFiliaisTipodePlano.MacroByName('Filiais').AsString :=
       qryFiliaisTipodePlano.MacroByName('Filiais').AsString + ' and ' +
       CondicaoGrupoFilial;
     qryFiliaisClasseProdutos.MacroByName('Filiais').AsString :=
       qryFiliaisClasseProdutos.MacroByName('Filiais').AsString + ' and ' +
       CondicaoGrupoFilial;
     qryFiliaisVendedores.MacroByName('Filiais').AsString :=
       qryFiliaisVendedores.MacroByName('Filiais').AsString + ' and ' +
       CondicaoGrupoFilial;
   end
   else
   begin
     qryRes_SinteticoFiliais.MacroByName('Filiais').AsString := CondicaoGrupoFilial;
     qryFiliaisTipodePlano.MacroByName('Filiais').AsString := CondicaoGrupoFilial;
     qryFiliaisClasseProdutos.MacroByName('Filiais').AsString := CondicaoGrupoFilial;
     qryFiliaisVendedores.MacroByName('Filiais').AsString := CondicaoGrupoFilial;
   end;
 end;
end;

