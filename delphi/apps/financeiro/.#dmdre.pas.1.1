procedure Tdtmdre.MontarOrdenacao;
var
CondicaoAgrupamento: String;
AgrupamentoContratosProdutos: String;
AgrupamentoContratosServicos: String;
AgrupamentoDadosFiscaisProdutos : String;
AgrupamentoDadosFiscaisServicos : String;
AgrupamentoContratosDevolvidos : String;

begin
  CondicaoAgrupamento:='';
  AgrupamentoContratosProdutos :='';
  AgrupamentoContratosServicos :='';
  AgrupamentoDadosFiscaisProdutos :='';
  AgrupamentoDadosFiscaisServicos :='';
  AgrupamentoContratosDevolvidos :='';

  if FAgruparGrupoFilial then
    CondicaoAgrupamento:=CondicaoAgrupamento+
    ' and (filialvenda in (Select filial From filiaisgruposfiliais '+
    'Where grupo = '+qryRes_SinteticoFiliaisgrupofilialvenda.Asstring+
    '))';

  if FAgruparFilial then
    CondicaoAgrupamento:=CondicaoAgrupamento+' and filialvenda = '+
    qryRes_SinteticoFiliaisfilialvenda.Asstring;




  if FAgruparVendedor then
  begin
    AgrupamentoContratosProdutos := CondicaoAgrupamento+' and pc.vendedor = '+qryRes_SinteticoFiliaisvendedor.Asstring;
    AgrupamentoContratosServicos := CondicaoAgrupamento+' and ct.vendedor = '+qryRes_SinteticoFiliaisvendedor.Asstring;
    AgrupamentoDadosFiscaisProdutos := CondicaoAgrupamento+ ' and pdf.vendedor = '+qryRes_SinteticoFiliaisvendedor.Asstring;
    AgrupamentoDadosFiscaisServicos := CondicaoAgrupamento+ ' and df.vendedor = '+qryRes_SinteticoFiliaisvendedor.Asstring;
    AgrupamentoContratosDevolvidos := CondicaoAgrupamento+ ' and ((select pc.vendedor '+
                                                           '      from produtoscontratos pc '+
                                                           '      where pc.contrato = cd.contrato and '+
                                                           '            pc.produto = cd.produto and '+
                                                           '            pc.filial = cd.filial) = '+qryRes_SinteticoFiliaisvendedor.Asstring+')';
    CondicaoAgrupamento:=CondicaoAgrupamento+' and vendedor = '+qryRes_SinteticoFiliaisvendedor.Asstring;
  end
  else
  begin
    AgrupamentoContratosProdutos := CondicaoAgrupamento;
    AgrupamentoContratosServicos := CondicaoAgrupamento;
    AgrupamentoDadosFiscaisProdutos := CondicaoAgrupamento;
    AgrupamentoDadosFiscaisServicos := CondicaoAgrupamento;
    AgrupamentoContratosDevolvidos := CondicaoAgrupamento;
  end;

  qryFiliaisTipodePlano.MacroByName('Agrupamento').asstring := CondicaoAgrupamento;

  qryFiliaisClasseProdutos.MacroByName('AgrupamentoContratosProdutos').asstring := AgrupamentoContratosProdutos;
  qryFiliaisClasseProdutos.MacroByName('AgrupamentoContratosServicos').asstring := AgrupamentoContratosServicos;
  qryFiliaisClasseProdutos.MacroByName('AgrupamentoDadosFiscaisProdutos').asstring := AgrupamentoDadosFiscaisProdutos;
  qryFiliaisClasseProdutos.MacroByName('AgrupamentoDadosFiscaisServicos').asstring := AgrupamentoDadosFiscaisServicos;
  qryFiliaisClasseProdutos.MacroByName('AgrupamentoContratosDevolvidos').asstring := AgrupamentoContratosDevolvidos;

  qryFiliaisVendedores.MacroByName('Agrupamento').asstring := CondicaoAgrupamento;
end;

