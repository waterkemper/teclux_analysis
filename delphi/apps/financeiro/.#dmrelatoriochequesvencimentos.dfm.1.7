    Sql.Strings = (
      'Select   h.filial as filial,'
      '             f.nome as nomefilial,'
      '             cast(substr(h.numero,01,03) as varchar) as banco,'
      '             cast(substr(h.numero,04,04) as varchar) as agencia,'
      '             cast(substr(h.numero,20,10) as varchar) as conta,'
      '             cast(substr(h.numero,12,06) as varchar) as cheque,'
      '             h.data,'
      '             h.vencto,'
      '             h.titular,'
      '             h.valor, h.observacao,'
      
        '             case when (h.segundadevolucao is not null and (h.se' +
        'gundadevolucao <=:datadevolucao)) then'
      
        '                               (h.valor - (Select coalesce(sum(p' +
        'c.valorpagto),0) From parcelascheques pc Where (pc.cheque = h.nu' +
        'mero) and (pc.resgate = '#39'2'#39')))'
      
        '                     when (h.primeiradevolucao is not null and (' +
        'h.primeiradevolucao <=:datadevolucao)) then'
      
        '                               (h.valor - (Select coalesce(sum(p' +
        'c.valorpagto),0) From parcelascheques pc Where (pc.cheque = h.nu' +
        'mero) and (pc.resgate = '#39'1'#39')))'
      '                     else  h.valor'
      '             end as saldo,'
      '             h.primeiradevolucao,'
      '             h.segundadevolucao,'
      '             coalesce(vf.razao,vf.nome) as nomecliente,'
      '             h.usuario,'
      '             u.nome as nomeusuario'
      ''
      'From     cheques h join filiais f on h.filial = f.codigo'
      '                   join usuarios u on h.usuario = u.codigo'
      
        '                   join vfornecedores vf on h.cliente = vf.codig' +
        'o and h.tipocliente = vf.tipo'
      ''
      ''
      '          %Periodo'
      '          %ListaporCobrador'
      '          %TipoCheque'
      '          %Situacao'
      '          %Filial'
      '          %GrupoFilial'
      '          %Remessa'
      '          %Resgate'
      '          %Considerar'
      '          %Ordenacao')
