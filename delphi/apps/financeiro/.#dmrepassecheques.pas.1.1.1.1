  result := false;
  if assigned(usuario) then
    Usuario.Free;

  Usuario:= TtecUsuarios.Create(dtmTecSoft.Database);
//  try
    if UsuarioLogin.Pagamento then
         Usuario:= ObterAutorizacao(taSENHA)
    else Usuario:= ObterAutorizacao(taLOGIN, ctAUTORIZACAOPAGAMENTO, ctAUTORIZADO);

    if Assigned(Usuario) and Usuario.Pagamento then
      result := true
    else
      MensagemAviso(format(ctUSUARIONAOAUTORIZADO,['autorizar o cancelamento do repasse.']));

//  finally
//    Usuario.Free;
//  end;
end;

procedure Tdtmrepassecheques.ImprimirRepasse;
var
  Relatorio: TfrReport;
  frmPreview: TfrmPreviewPadrao;
begin
//  qryChequesRepassados.Filtered := true;
//  qryChequesRepassados.DisableControls;

  frVariables['Titulo']:='REPASSE DE CHEQUES';
  frVariables['DATAEXTENSO']:=ANSIUpperCase(FormatDateTime('dd',now)+' de '+NomeMeses[strtoint(FormatDateTime('mm',now))]+' de '+FormatDateTime('yyyy',now) );

  frmPreview := TfrmPreviewPadrao.create(self);
  frmPreview.cmbZoom.ItemIndex := 3;

  try
    with frmPreview do
    begin
      Relatorio := frmPreview.frCompositeReport;
      frCompositeReport.Reports.Clear;
      frCompositeReport.DoublePass := true;
//      frpRepasseCheques.DesignReport;

      frCompositeReport.Reports.Add(frpRepasseCheques);
      Relatorio.Preview := frPreviewPadrao;
      Relatorio.ShowReport;
      ShowModal;
    end;
  finally
    frmPreview.Free;
//    qryChequesRepassados.Filtered := false;
//    qryChequesRepassados.EnableControls;
  end;

end;

