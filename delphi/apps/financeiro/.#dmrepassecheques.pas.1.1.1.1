procedure Tdtmrepassecheques.SetarSomenteLeitura;
var
 i: integer;
begin
  if not (qryRepasseCheques.State = dsinsert) then
  begin
    qryChequesRepassados.ReadOnly := true;
    for i:= 0 to qryRepasseCheques.FieldCount - 1 do
      qryRepasseCheques.fields[i].ReadOnly := true;
  end
  else
  begin
    qryChequesRepassados.ReadOnly := false;
    for i:= 0 to qryRepasseCheques.FieldCount - 1 do
      qryRepasseCheques.fields[i].ReadOnly := false;
  end;
end;

procedure Tdtmrepassecheques.qryRepasseChequesAfterPost(DataSet: TDataSet);
begin
  inherited;
  SetarSomenteLeitura;
end;

function Tdtmrepassecheques.ListadeCheques: vString;
var
  a: Integer;
  Pos: TBookmark;
begin
  Pos := qryChequesRepassados.GetBookmark;
  qryChequesRepassados.DisableControls;
  try
    a := 1;
    qryChequesRepassados.First;
    while not qryChequesRepassados.Eof do
    begin
      SetLength(Result, a);
      Result[a-1] := qryChequesRepassadoscheque.AsString;
      Inc(a);
      qryChequesRepassados.Next;
    end;
  finally
    qryChequesRepassados.EnableControls;
    qryChequesRepassados.GotoBookmark(Pos);
    qryChequesRepassados.FreeBookmark(Pos);
  end;
end;

end.
