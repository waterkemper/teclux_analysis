function Tdtmrepassecheques.ExecutarConsultaCheque(ListadeFiliais,
  DataInicial, DataFinal, cliente, tipocliente, banco, valorinicial, valorfinal: String): Boolean;
begin
  if ListadeFiliais<>'' then
    qryCheques.MacroByName('listadefiliais').AsString := 'and c.filial in ('+ ListadeFiliais +')'
  else
    qryCheques.MacroByName('listadefiliais').AsString := '';

  if (DataInicial<>'') and (DataFinal<>'') then
    qryCheques.MacroByName('periododevencimento').AsString := 'and c.vencto between '+
      quotedstr(formatdatetime('yyyy-mm-dd',strtodate(DataInicial))) + ' and '+
      quotedstr(formatdatetime('yyyy-mm-dd',strtodate(DataFinal)))
  else
  if (DataInicial<>'') and (DataFinal='') then
    qryCheques.MacroByName('periododevencimento').AsString := 'and c.vencto >= '+
      quotedstr(formatdatetime('yyyy-mm-dd',strtodate(DataInicial)))
  else
  if (DataInicial='') and (DataFinal<>'') then
    qryCheques.MacroByName('periododevencimento').AsString := 'and c.vencto <= '+
      quotedstr(formatdatetime('yyyy-mm-dd',strtodate(DataFinal)))
  else
    qryCheques.MacroByName('periododevencimento').AsString := '';

  if cliente<>'' then
    qryCheques.MacroByName('cliente').AsString := 'and c.cliente = ' + cliente +' and c.tipocliente = ' + QuotedStr(tipocliente)
  else
    qryCheques.MacroByName('cliente').AsString := '';

  if banco<>'' then
    qryCheques.MacroByName('banco').AsString := 'and substring(c.numero,1,3) = ' + quotedstr(banco)
  else
    qryCheques.MacroByName('banco').AsString := '';

  if (valorinicial<>'0') and (valorfinal<>'0') then
    qryCheques.MacroByName('faixadevalores').AsString := 'and c.valor between ' + trocar(valorinicial,',','.')+' and '+trocar(valorfinal,',','.')
  else
  if (valorinicial<>'0') and (valorfinal='0') then
    qryCheques.MacroByName('faixadevalores').AsString := 'and c.valor >= ' + trocar(valorinicial,',','.')
  else
  if (valorinicial='0') and (valorfinal<>'0') then
    qryCheques.MacroByName('faixadevalores').AsString := 'and c.valor <= ' + trocar(valorfinal,',','.')
  else
    qryCheques.MacroByName('faixadevalores').AsString := '';

  qryCheques.MacroByName('NumerodoCheque').AsString := '';

  qryCheques.close;
  qryCheques.Open;

  result := qryCheques.RecordCount<>0;

end;

