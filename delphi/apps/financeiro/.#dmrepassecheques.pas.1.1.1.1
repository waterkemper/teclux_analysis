end;

procedure Tdtmrepassecheques.AtualizarListadeChequesRepassados;
var
  vQuantidadeRepasse, vQuantidadeRepasseCancelado : integer;
  vTotalRepasse, vTotalRepasseCancelado : Currency;
begin
  vQuantidadeRepasse := 0;
  vTotalRepasse := 0;

  vQuantidadeRepasseCancelado := 0;
  vTotalRepasseCancelado := 0;

  ListadeChequesRepassados := '';

  GuardarRegistroAtual(qryChequesRepassados,true);
  qryChequesRepassados.First;
  while not qryChequesRepassados.Eof do
  begin
    inc(vQuantidadeRepasse);
    vTotalRepasse := vTotalRepasse + qryChequesRepassadosvalor.AsCurrency;

    if not qryRepasseChequesexcluido.IsNull or not qryChequesRepassadosdevolvido.IsNull then
    begin
      inc(vQuantidadeRepasseCancelado);
      vTotalRepasseCancelado := vTotalRepasseCancelado + qryChequesRepassadosvalor.AsCurrency;

      if not qryRepasseChequesexcluido.IsNull then
        qryRepasseChequessituacao.AsString := 'CANCELADO'
      else
        qryRepasseChequessituacao.AsString := 'DEVOLVIDO';
    end
    else
      ListadeChequesRepassados := ListadeChequesRepassados + QuotedStr(qryChequesRepassadoscheque.AsString)+',';

    qryChequesRepassados.Next;
  end;
  VoltarRegistroAtual(qryChequesRepassados);

  if ListadeChequesRepassados<>'' then
    delete(FListadeChequesRepassados,length(FListadeChequesRepassados),1);

  qryRepasseChequesquantidaderepasse.AsInteger := vQuantidadeRepasse;
  qryRepasseChequestotalrepasse.AsCurrency := vTotalRepasse;

  qryRepasseChequesquantidaderepassedevolvido.AsInteger := vQuantidadeRepasseCancelado;
  qryRepasseChequestotalrepassedevolvido.AsCurrency := vTotalRepasseCancelado;

end;

