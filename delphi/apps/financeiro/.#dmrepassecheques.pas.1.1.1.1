procedure Tdtmrepassecheques.AtribuirDadosChequesemChequesRepassados(SomenteMarcados: boolean = true);
var
  RegistroAtual : TBookMark;
begin
  RegistroAtual := qrycheques.GetBookmark;
  qrycheques.DisableControls;
  qryCheques.First;

  while not qryCheques.Eof do
  begin
    if (SomenteMarcados and qryChequesmarcar.AsBoolean) or (not SomenteMarcados) then
    begin
      if not (qryRepasseCheques.State in [dsinsert]) then
        qryRepasseCheques.append;

      if not (qryChequesRepassados.State = dsinsert) then
        qryChequesRepassados.Append;

      qryChequesRepassadoscheque.AsString       := qryChequesnumero.AsString;
      qryChequesRepassadosnumerocheque.AsString := qryChequescheque.AsString;
      qryChequesRepassadosbanco.AsString        := qryChequesbanco.AsString;
      qryChequesRepassadosagencia.AsString      := qryChequesagencia.AsString;
      qryChequesRepassadosconta.asstring        := qryChequesconta.asstring;

      qryChequesRepassadosdata.AsDateTime       := qryChequesdata.AsDateTime;
      qryChequesRepassadosvalor.AsCurrency      := qryChequesvalor.AsCurrency;
      qryChequesRepassadosvencto.AsDateTime     := qryChequesvencto.AsDateTime;
      qryChequesRepassadosfilial.AsInteger      := qryChequesfilial.asinteger;
      qryChequesRepassadosnomecliente.AsString  := qryChequesnomecliente.AsString;
      qryChequesRepassadoscliente.AsInteger     := qryChequescliente.AsInteger;
      qryChequesRepassadostipocliente.AsString  := qryChequestipocliente.AsString;

      qryChequesRepassados.Post;
    end;
    qrycheques.Next;
  end;

  qrycheques.GotoBookmark(RegistroAtual);
  qrycheques.EnableControls;

end;

function Tdtmrepassecheques.ExcluirRepasseCheques: boolean;
begin
  result := false;
  if (MensagemConfirmacao(format(ctCONFIRMECANCELAR, ['os cheques repassados'])) = smbOk) then
  begin
    if obterAutorizacaopagamento then
    begin
      if not (qryRepasseCheques.State in [dsedit, dsinsert]) then
        qryRepasseCheques.Edit;

      qryRepasseChequesexcluidor.AsInteger := Usuario.CodigoUsuario;
      qryRepasseChequesnomeexcluidor.AsString := Usuario.NomeUsuario;
      qryRepasseChequesexcluido.AsDateTime := now;

      qryRepasseChequessituacao.AsString := 'CANCELADO';

      AtualizarListadeChequesRepassados;
      qryRepasseCheques.post;
      result := perpetrar([qryRepasseCheques]);

    end
  end;
end;

function Tdtmrepassecheques.DevolverChequeRepassado: boolean;
begin
  result := false;
  if (MensagemConfirmacao(format(ctCONFIRMEDEVOLUCAO, ['o cheque repassado'])) = smbOk) then
  begin
    if ObterAutorizacaoPagamento then
    begin
      qryChequesRepassados.afterPost := nil;

      qryChequesRepassados.ReadOnly := false;
      qryChequesRepassados.Edit;
      qryChequesRepassadosdevolvido.AsDateTime := now();
      qryChequesRepassadosdevolvedor.AsInteger := usuario.CodigoUsuario;
      qryChequesRepassadosnomedevolvedor.AsString := usuario.NomeUsuario;

      qryRepasseChequessituacao.AsString := 'DEVOLVIDO';

      qryChequesRepassados.post;
      result := perpetrar([qrychequesrepassados]);
      qryChequesRepassados.ReadOnly := true;

      qryChequesRepassados.afterPost := qryChequesRepassadosAfterPost;

      AtualizarListadeChequesRepassados;
    end;
  end;
end;

function Tdtmrepassecheques.ExcluirChequeRepassado: boolean;
begin
  result := false;
  if (MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o cheque repassado'])) = smbOk) then
  begin
    try
      qryChequesRepassados.Delete;
    finally
      result := true;
    end;
  end;
end;

