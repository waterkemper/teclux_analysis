function Tdtmrepassecheques.GravarRepasseCheques: Boolean;
var
 vnow : TDateTime;
begin
  vnow := now;
  if qryRepasseCheques.CheckRequiredFields then
  begin
    if qryChequesRepassados.RecordCount <> 0 then
    begin
      if obterautorizacaopagamento then
      begin
        if qryRepasseCheques.State = dsinsert then
        begin
          qryRepasseChequesrepassador.AsInteger := Usuario.CodigoUsuario;
          qryRepasseChequesnomerepassador.AsString := usuario.NomeUsuario;
          qryRepasseChequesdatarepasse.AsDateTime := now;

          spcrepassecheques_proximo.Open;
          qryRepasseChequesnumero.AsInteger := spcrepassecheques_proximonumero.AsInteger;
          spcrepassecheques_proximo.close;


          qryChequesRepassados.AfterPost := nil;


          AtribuirChave(qryChequesRepassados,
                        [qryChequesRepassadosrepasse],
                        [qryRepasseChequesnumero],
                        True);

          qryChequesRepassados.AfterPost := qryChequesRepassadosAfterPost;

          qryRepasseCheques.Post;
          qryRepasseCheques.ReadOnly := false;
          qryChequesRepassados.ReadOnly := false;

          result := perpetrar([qryRepasseCheques, qryChequesRepassados]);
          SetarSomenteLeitura;

          ListadeChequesRepassados := '';
        end;
      end;
    end
    else
      MensagemAviso('Não existem cheques cadastrados no repasse');
  end;
end;

procedure Tdtmrepassecheques.IncluirChequesRepassados;
begin
  qryChequesRepassados.Append;
end;

function Tdtmrepassecheques.GravarChequesRepassados(
  NumeroCheque: String): Boolean;
begin

  qryCheques.MacroByName('listadefiliais').AsString := '';
  qryCheques.MacroByName('periododevencimento').AsString := '';
  qryCheques.MacroByName('cliente').AsString := '';
  qryCheques.MacroByName('banco').AsString := '';
  qryCheques.MacroByName('faixadevalores').AsString := '';
  qryCheques.MacroByName('NumerodoCheque').AsString := ' and c.numero = '+ quotedstr(NumeroCheque);

  qrycheques.close;
  qrycheques.open;

  if (qrycheques.recordcount=0) then
  begin
    result := false;
    if (pos(NumeroCheque, ListadeChequesRepassados)<>0) then
      MensagemAviso('Cheque já cadastrado neste repasse.')
    else
      MensagemAviso('Cheque não encontrado no cadastro de cheques ou já incluido em outros repasses.')
  end
  else
  begin
    Result := true;
    AtribuirDadosChequesemChequesRepassados(false);
  end;

end;

