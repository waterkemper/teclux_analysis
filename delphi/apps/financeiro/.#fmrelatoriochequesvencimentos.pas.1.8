procedure TfrmRelatorioChequesVencimentos.AtribuirDadosCobrador;
begin
  with fraSelecaoAleatoriaCobrador do
  begin
    qrySelecaoAleatoria.Edit;
    qrySelecaoAleatoria.FieldByName('codigo').AsInteger :=
        ConsultaSelecaoAleatoria.qryProcuraCobrador.fieldbyname('codigo').AsInteger;

    qrySelecaoAleatoria.FieldByName('nome').AsString :=
        ConsultaSelecaoAleatoria.qryProcuraCobrador.fieldbyname('nome').AsString;

    qrySelecaoAleatoria.Post;

  end;
end;

procedure TfrmRelatorioChequesVencimentos.fraSelecaoAleatoriaCobradorqrySelecaoAleatoriaAfterOpen(
  DataSet: TDataSet);
begin
  inherited;
  with fraSelecaoAleatoriaCobrador do
  begin
    qrySelecaoAleatoria.FieldByName('codigo').DisplayLabel := 'Código';
    qrySelecaoAleatoria.FieldByName('codigo').ReadOnly := False;

    qrySelecaoAleatoria.FieldByName('nome').DisplayLabel := 'Nome';
    qrySelecaoAleatoria.FieldByName('nome').ReadOnly := true;

    qrySelecaoAleatoria.Append;
    qrySelecaoAleatoria.Post;
  end;

end;

procedure TfrmRelatorioChequesVencimentos.AcionarPesquisaGrade;
begin
  with fraSelecaoAleatoriaCobrador do
  begin
    dbgSelecaoAleatoria.SetFocus;
    ConsultaSelecaoAleatoria.CtrlOn := True;
    ConsultaSelecaoAleatoria.InternoPesquisar(ctCOBRADORES);
    dbgSelecaoAleatoria.SetFocus;
    dbgSelecaoAleatoria.SelectedIndex :=  0;
  end;
end;

procedure TfrmRelatorioChequesVencimentos.fraSelecaoAleatoriaCobradordbgSelecaoAleatoriaDblClick(
  Sender: TObject);
begin
  inherited;
  acionarPesquisaGrade;
end;

procedure TfrmRelatorioChequesVencimentos.fraSelecaoAleatoriaCobradordbgSelecaoAleatoriaKeyDown(
  Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;
  if Shift = [ssCtrl] then
  begin
    case Key of
      VK_F9     : begin
                     fraSelecaoAleatoriaCobrador.ConsultaSelecaoAleatoria.CtrlOn := Shift = [ssCtrl];
                     if (Shift = []) or fraSelecaoAleatoriaCobrador.ConsultaSelecaoAleatoria.CtrlOn then
                       AcionarPesquisaGrade
                   end;
    end;
  end
  else
  case Key of
    VK_Return: if fraSelecaoAleatoriaCobrador.dbgSelecaoAleatoria.SelectedIndex = 0  then
                begin
                  fraSelecaoAleatoriaCobrador.ConsultaSelecaoAleatoria.edfCodigo.DoExit;
                  if not fraSelecaoAleatoriaCobrador.ConsultaSelecaoAleatoria.qryProcuraCobrador.IsEmpty then
                    AtribuirDadosCobrador
                  else
                  begin
                    key := 0;
                    fraSelecaoAleatoriaCobrador.dbgSelecaoAleatoria.SelectedIndex := 0;
                    fraSelecaoAleatoriaCobrador.dbgSelecaoAleatoria.SetFocus;
                  end;
                end;
  end;
  inherited;
end;

procedure TfrmRelatorioChequesVencimentos.fraSelecaoAleatoriaCobradorsbnProcuraClick(
  Sender: TObject);
begin
  inherited;
  AcionarPesquisaGrade;
end;

