    AfterScroll = qryMoedasCotacoesAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '('
      ' SELECT mc.Moeda,'
      '        mc.Data                                AS Data1,'
      '        CAST(TO_CHAR(mc.Data,'#39'dd'#39') AS INTEGER) AS Dia1,'
      '        mc.Cotacao                             AS Cotacao1,'
      '        mc.Observacoes                         AS Observacoes1,'
      ''
      
        '       (SELECT mc2.Data                                FROM Moed' +
        'asCotacoes mc2 WHERE mc2.Moeda = mc.Moeda AND mc2.Data = mc.Data' +
        ' + 10) AS Data2,'
      
        '       (SELECT CAST(TO_CHAR(mc2.Data,'#39'dd'#39') AS INTEGER) FROM Moed' +
        'asCotacoes mc2 WHERE mc2.Moeda = mc.Moeda AND mc2.Data = mc.Data' +
        ' + 10) AS Dia2,'
      
        '       (SELECT mc2.Cotacao                             FROM Moed' +
        'asCotacoes mc2 WHERE mc2.Moeda = mc.Moeda AND mc2.Data = mc.Data' +
        ' + 10) AS Cotacao2,'
      
        '       (SELECT mc2.Observacoes                         FROM Moed' +
        'asCotacoes mc2 WHERE mc2.Moeda = mc.Moeda AND mc2.Data = mc.Data' +
        ' + 10) AS Observacoes2,'
      ''
      
        '       /* Para limitar os valores da 3'#170' coluna em fevereiro at'#233' ' +
        'o dia 28 ou 29 -------------------------------------------------' +
        '-------------------------------------------------------------*/'
      
        '       CASE WHEN mc.Data + 20 <= :DataFinal THEN (SELECT mc2.Dat' +
        'a                                FROM MoedasCotacoes mc2 WHERE m' +
        'c2.Moeda = mc.Moeda AND mc2.Data = mc.Data + 20) END AS Data3,'
      
        '       CASE WHEN mc.Data + 20 <= :DataFinal THEN (SELECT CAST(TO' +
        '_CHAR(mc2.Data,'#39'dd'#39') AS INTEGER) FROM MoedasCotacoes mc2 WHERE m' +
        'c2.Moeda = mc.Moeda AND mc2.Data = mc.Data + 20) END AS Dia3,'
      
        '       CASE WHEN mc.Data + 20 <= :DataFinal THEN (SELECT mc2.Cot' +
        'acao                             FROM MoedasCotacoes mc2 WHERE m' +
        'c2.Moeda = mc.Moeda AND mc2.Data = mc.Data + 20) END AS Cotacao3' +
        ','
      
        '       CASE WHEN mc.Data + 20 <= :DataFinal THEN (SELECT mc2.Obs' +
        'ervacoes                         FROM MoedasCotacoes mc2 WHERE m' +
        'c2.Moeda = mc.Moeda AND mc2.Data = mc.Data + 20) END AS Observac' +
        'oes3'
      ''
      ' FROM MoedasCotacoes mc'
      ' WHERE mc.Moeda = :Moeda AND'
      
        '       mc.Data BETWEEN CAST(:DataInicial AS DATE) AND CAST(:Data' +
        'Inicial AS DATE)+9'
      ''
      ' ORDER BY mc.Data'
      ')'
      ''
      'UNION ALL'
      ''
      '('
      
        ' /* Para exibir os dados na 3'#170' coluna quando o m'#234's tem 31 dias *' +
        '/'
      ' SELECT mc.Moeda,'
      '        CAST(NULL AS DATE)        AS Data1,'
      '        CAST(NULL AS INTEGER)     AS Dia1,'
      '        CAST(NULL AS NUMERIC)     AS Cotacao1,'
      '        CAST(NULL AS VARCHAR(50)) AS Observacoes1,'
      ''
      '        CAST(NULL AS DATE)        AS Data2,'
      '        CAST(NULL AS INTEGER)     AS dia2,'
      '        CAST(NULL AS NUMERIC)     AS Cotacao2,'
      '        CAST(NULL AS VARCHAR(50)) AS Observacoes2,'
      ''
      '        mc.Data                                AS Data3,'
      '        CAST(TO_CHAR(mc.Data,'#39'dd'#39') AS INTEGER) AS dia3,'
      '        mc.Cotacao                             AS Cotacao3,'
      '        mc.Observacoes                         AS Observacoes3'
      ''
      ' FROM MoedasCotacoes mc'
      ' WHERE mc.Moeda = :Moeda AND'
      '       mc.Data BETWEEN :DataFinal AND :DataFinal AND'
      '       EXTRACT(MONTH FROM mc.Data) IN (1, 3, 5, 7, 8, 10, 12)'
      ')')
    RequestLive = True
    Left = 48
    Top = 176
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'DataFinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'moeda'
        ParamType = ptUnknown
      end
      item
