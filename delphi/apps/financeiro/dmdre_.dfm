  object qryCustoMercadoria: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '/* qryCustoMercadoria */'
      ''
      ';'
      '  select cast(3 as integer) as classificacao,'
      
        '         cast('#39'(-) CUSTOS DAS VENDAS'#39' as varchar(50)) as descric' +
        'aoclassificacao,'
      '         custo.tipoproduto,'
      '         custo.descricaotipoproduto,'
      '         custo.grupo,'
      '         custo.descricaogrupo,'
      '         custo.classe,'
      '         custo.descricaoclasse,'
      ''
      '         custo.documento,'
      '         custo.data,'
      '         custo.cliente,'
      '         custo.tipocliente,'
      '         custo.nomecliente,'
      ''
      '         sum(custo.valor) as valor'
      '  from'
      '  ('
      ''
      ''
      
        '    /* CUSTO DOS PRODTUOS DOS CONTRATOS FATURADOS RETIRNANDO AS ' +
        'NOTAS FISCAIS */'
      '    ('
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      
        '      case when :AgruparGrupo then c.grupo     else cast(null as' +
        ' varchar(4)) end as grupo,'
      
        '      case when :AgruparGrupo then g.descricao else cast(null as' +
        ' varchar(30)) end as descricaogrupo,'
      
        '      case when :AGruparClasse then c.classe    else cast(null a' +
        's varchar(2)) end as classe,'
      
        '      case when :AGruparClasse then cl.descricao else cast(null ' +
        'as varchar(30)) end as descricaoclasse,'
      ''
      '      cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '      ct.faturamento as data,'
      '      ct.cliente,'
      '      ct.tipocliente,'
      '      ct.nome as nomecliente,'
      ''
      ''
      ''
      '      -'
      
        #9'    case when coalesce(m1.financeiro,0) <> 0 and coalesce(m1.em' +
        'estoque,0) <> 0 then'
      '      ((pc.quantidade - (select sum(pdf.quantidade)'
      '                       from produtosdadosfiscais pdf'
      '                            join dadosfiscais df'
      '                            on pdf.dadofiscal = df.numero'
      '                       where df.contrato = ct.numero'
      '                         and pdf.produto = pc.produto'
      '                         and df.situacao = '#39'N'#39
      
        '                         and df.data between(:DataInicial) and (' +
        ':DataFinal))) *  (m1.financeiro/m1.emestoque))'
      '     else'
      '       0'
      '  '#9' end as valor'
      ''
      '     from (contratos ct'
      '           join (produtoscontratos pc'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on pc.produto=p.codigo)'
      #9#9#9#9
      '           on ct.numero = pc.contrato)'
      ''
      #9#9
      
        '           LEFT JOIN movimentos m1 ON m1.produto = pc.produto AN' +
        'D'
      '                                     m1.filial = pc.filial AND'
      
        '                                     m1.numero =  (select m4.num' +
        'ero'
      '                                                   from'
      '                                                   ('
      
        '                                                     select m2.d' +
        'ata,'
      
        '                                                            (sel' +
        'ect max(m3.lancto)'
      
        '                                                             fro' +
        'm movimentos m3'
      
        '                                                             whe' +
        're m3.produto = pc.produto'
      
        '                                                               a' +
        'nd m3.filial = pc.filial'
      
        '                                                               a' +
        'nd m3.data = m2.data'
      #9'    '#9#9#9#9#9#9#9#9#9#9#9#9#9'   and coalesce(m3.financeiro,0)<>0'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9'       and coalesce(m3.emestoque,0)<>0'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'   ) as lancto'
      '                                                     from'
      '                                                     ('
      
        '                                                      select max' +
        '(m2.data) as data'
      
        '                                                      from movim' +
        'entos m2'
      
        '                                                      where m2.p' +
        'roduto = pc.produto'
      
        '                                                        and m2.f' +
        'ilial = pc.filial'
      
        '                                                        and m2.d' +
        'ata < (ct.faturamento +1)'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9'and coalesce(m2.financeiro,0)<>0'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9'and coalesce(m2.emestoque,0)<>0'
      '                                                     ) as m2'
      
        '                                                   ) as m join m' +
        'ovimentos m4 on m4.data = m.data'
      
        '                                                                ' +
        '            and m4.lancto = m.lancto'
      
        '                                                                ' +
        '            and m4.produto = pc.produto'
      
        '                                                                ' +
        '            and m4.filial = pc.filial'
      
        '                                                   order by m4.l' +
        'ancto desc limit 1'
      '                                                  )'
      #9#9#9#9#9#9#9#9#9#9#9#9
      ''
      '     where not pc.brinde'
      #9'   and ct.faturamento between(:DataInicial) and (:DataFinal)'
      #9'   and (coalesce(ct.valorvista,0)<>0)'
      #9'   and ct.origem is null'
      #9
      #9'   and (pc.quantidade - (select sum(pdf.quantidade)'
      '                             from produtosdadosfiscais pdf'
      '                              join dadosfiscais df'
      '                            on pdf.dadofiscal = df.numero'
      '                       where df.contrato = ct.numero'
      '                         and pdf.produto = pc.produto'
      '                         and df.situacao = '#39'N'#39
      
        '                         and df.data between(:DataInicial) and (' +
        ':DataFinal))) > 0'
      #9
      #9#9#9
      '   )'
      ''
      '    union all'
      ''
      '    /* CUSTO DOS PRODTUOS DAS NOTAS FISCAIS */'
      ''
      '   ('
      ''
      '          select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      ''
      
        '      case when :AgruparGrupo then c.grupo     else cast(null as' +
        ' varchar(4)) end as grupo,'
      
        '      case when :AgruparGrupo then g.descricao else cast(null as' +
        ' varchar(30)) end as descricaogrupo,'
      
        '      case when :AGruparClasse then c.classe    else cast(null a' +
        's varchar(2)) end as classe,'
      
        '      case when :AGruparClasse then cl.descricao else cast(null ' +
        'as varchar(30)) end as descricaoclasse,'
      ''
      '      case when n.dadofiscal is not null then'
      '        cast('#39'NF '#39'||n.numero||'#39' S'#233'rie '#39'||n.serie as varchar(30))'
      '      else'
      
        '        cast('#39'CF '#39'||cp.numero||'#39' Mq. '#39'||cp.maquina||'#39' Int.'#39'||cp.' +
        'intervensao as varchar(30))'
      '      end as documento,'
      '      df.data,'
      '      df.cliente,'
      '      df.tipocliente,'
      '      df.nome as nomecliente,'
      ''
      ''
      #9'  -'
      #9'  pdf.quantidade * abs(m1.valor/m1.quantidade) as valor'
      ''
      '      from (dadosfiscais df'
      '             join (produtosdadosfiscais pdf'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      ''
      '                         on p.caracteristica=c.codigo)'
      
        '             on pdf.produto=p.codigo) on df.numero = pdf.dadofis' +
        'cal)'
      ''
      '             left join notas n on df.numero = n.dadofiscal'
      '             left join cupons cp on df.numero = cp.dadofiscal'
      ''
      #9#9#9
      #9#9#9
      '            JOIN movimentos m1 ON m1.produto = pdf.produto AND'
      '                                     m1.filial = pdf.filial AND'
      '                                     m1.data = df.data and'
      
        '                                     m1.dadofiscal = pdf.dadofis' +
        'cal and'
      
        '                                     m1.numero =  (select m4.num' +
        'ero'
      '                                                   from'
      '                                                   ('
      
        '                                                     select m2.d' +
        'ata,'
      
        '                                                            (sel' +
        'ect max(m3.lancto)'
      
        '                                                             fro' +
        'm movimentos m3'
      
        '                                                             whe' +
        're m3.produto = pdf.produto'
      
        '                                                               a' +
        'nd m3.filial = pdf.filial'
      
        '                                                               a' +
        'nd m3.data = df.data'
      
        #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'                                 and m3.dadofisca' +
        'l = df.numero'
      #9'    '#9#9#9#9#9#9#9#9#9#9#9#9#9'   and coalesce(m3.valor,0)<>0'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'   ) as lancto'
      '                                                     from'
      '                                                     ('
      
        '                                                      select max' +
        '(m2.data) as data'
      
        '                                                      from movim' +
        'entos m2'
      
        '                                                      where m2.p' +
        'roduto = pdf.produto'
      
        '                                                        and m2.f' +
        'ilial = pdf.filial'
      
        '                                                        and m2.d' +
        'ata = df.data'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9'and m2.dadofiscal = df.numero'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9'and coalesce(m2.valor,0)<>0'
      '                                                     ) as m2'
      
        '                                                   ) as m join m' +
        'ovimentos m4 on m4.produto = pdf.produto'
      
        '                                                                ' +
        '            and m4.filial = pdf.filial'
      
        '                                                                ' +
        '            and m4.data = m.data'
      
        '                                                                ' +
        '            and m4.dadofiscal = df.numero'
      
        '                                                                ' +
        '            and m4.lancto = m.lancto'
      ''
      
        '                                                                ' +
        '            '
      
        '                                                   order by m4.l' +
        'ancto desc limit 1'
      '                                                  )'
      ''
      '      Where (df.data between (:DataInicial) and (:DataFinal))'
      '              and df.situacao='#39'N'#39
      '              and eHNotaFiscalSaidaVenda(pdf.codigofiscal)'
      '        and not coalesce(df.notavinculada,false)'
      ''
      '    )'
      ''
      '    union all'
      ''
      '    ('
      ''
      
        '       /* CONTRATOS FATURADOS DEVOLVIDOS  - ABATIMENTO DO VALOR ' +
        'NEGATIVO */'
      '        select'
      ''
      '        c.tipoproduto,'
      
        '        cast('#39'DEVOLU'#199#213'ES - '#39' as varchar)||cast(tp.descricao as v' +
        'archar) as descricaotipoproduto,'
      ''
      
        '        case when :AgruparGrupo then c.grupo     else cast(null ' +
        'as varchar(4)) end as grupo,'
      
        '        case when :AgruparGrupo then g.descricao else cast(null ' +
        'as varchar(30)) end as descricaogrupo,'
      
        '        case when :AGruparClasse then c.classe    else cast(null' +
        ' as varchar(2)) end as classe,'
      
        '        case when :AGruparClasse then cl.descricao else cast(nul' +
        'l as varchar(30)) end as descricaoclasse,'
      ''
      '      cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '      ct.faturamento as data,'
      '      ct.cliente,'
      '      ct.tipocliente,'
      '      ct.nome as nomecliente,'
      ''
      ''
      ''
      
        #9'    case when coalesce(m1.financeiro,0) <> 0 and coalesce(m1.em' +
        'estoque,0) <> 0 then'
      '           (cd.quantidade  *  (m1.financeiro/m1.emestoque))'
      '        else'
      '          0'
      '  '#9'    end as valor'
      #9#9
      #9#9
      '        from ((contratosdevolvidos cd'
      '               join contratos ct'
      '               on cd.contrato=ct.numero)'
      ''
      '               join (produtos p'
      '                     join (((caracteristicas c'
      '                             join classes cl'
      '                             on c.classe=cl.codigo)'
      ''
      '                             join grupos g'
      '                             on c.grupo = g.codigo)'
      ''
      '                             join tiposproduto tp'
      '                             on c.tipoproduto = tp.codigo)'
      ''
      '                     on p.caracteristica=c.codigo)'
      '               on cd.produto=p.codigo)'
      ''
      
        '           LEFT JOIN movimentos m1 ON m1.produto = cd.produto AN' +
        'D'
      '                                     m1.filial = cd.filial AND'
      
        '                                     m1.numero =  (select m4.num' +
        'ero'
      '                                                   from'
      '                                                   ('
      
        '                                                     select m2.d' +
        'ata,'
      
        '                                                            (sel' +
        'ect max(m3.lancto)'
      
        '                                                             fro' +
        'm movimentos m3'
      
        '                                                             whe' +
        're m3.produto = cd.produto'
      
        '                                                               a' +
        'nd m3.filial = cd.filial'
      
        '                                                               a' +
        'nd m3.data = m2.data'
      
        '                                                               a' +
        'nd coalesce(m3.financeiro,0)<>0'
      
        '                                                               a' +
        'nd coalesce(m3.emestoque,0)<>0'
      
        '                                                             ) a' +
        's lancto'
      '                                                     from'
      '                                                     ('
      
        '                                                      select max' +
        '(m2.data) as data'
      
        '                                                      from movim' +
        'entos m2'
      
        '                                                      where m2.p' +
        'roduto = cd.produto'
      
        '                                                        and m2.f' +
        'ilial = cd.filial'
      
        '                                                        and m2.d' +
        'ata < (cd.devolucao +1)'
      
        '                                                        and coal' +
        'esce(m2.financeiro,0)<>0'
      
        '                                                        and coal' +
        'esce(m2.emestoque,0)<>0'
      '                                                     ) as m2'
      
        '                                                   ) as m join m' +
        'ovimentos m4 on m4.data = m.data'
      
        '                                                                ' +
        '            and m4.lancto = m.lancto'
      
        '                                                                ' +
        '            and m4.produto = cd.produto'
      
        '                                                                ' +
        '            and m4.filial = cd.filial'
      
        '                                                   order by m4.l' +
        'ancto desc limit 1'
      '                                                  )'
      #9#9#9
      ''
      
        '        where cd.devolucao between(:DataInicial) and (:DataFinal' +
        ')'
      '          /* and cd.tipo = '#39'D'#39' */'
      
        '          and case when ct.os then ct.tipoequipamento in (1,2) a' +
        'nd not (coalesce(ct.os_garantia,false) and ct.os_garantia_status' +
        '='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '          and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturadas' +
        ' as outras entram pelas notas fiscais devido a cr'#233'ditos de troca' +
        ' */'
      ''
      '    )'
      ''
      '   union all'
      ''
      '   ('
      ''
      '        /* CONTRATOS FATURADOS TOTALMENTE CANCELADOS  */'
      '        select'
      '        c.tipoproduto,'
      
        #9#9'    cast('#39'DEVOLU'#199#213'ES - '#39' as varchar)||cast(tp.descricao as var' +
        'char) as descricaotipoproduto,'
      ''
      
        '        case when :AgruparGrupo then c.grupo     else cast(null ' +
        'as varchar(4)) end as grupo,'
      
        '        case when :AgruparGrupo then g.descricao else cast(null ' +
        'as varchar(30)) end as descricaogrupo,'
      
        '        case when :AGruparClasse then c.classe    else cast(null' +
        ' as varchar(2)) end as classe,'
      
        '        case when :AGruparClasse then cl.descricao else cast(nul' +
        'l as varchar(30)) end as descricaoclasse,'
      ''
      '      cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '      ct.faturamento as data,'
      '      ct.cliente,'
      '      ct.tipocliente,'
      '      ct.nome as nomecliente,'
      ''
      ''
      ''
      ''
      
        #9'    case when coalesce(m1.financeiro,0) <> 0 and coalesce(m1.em' +
        'estoque,0) <> 0 then'
      '           (pc.quantidade  *  (m1.financeiro/m1.emestoque))'
      '        else'
      '          0'
      '  '#9'    end as valor'
      ''
      ''
      '    from (select distinct ct.numero, p.datapagto'
      '          from contratos ct, parcelas p'
      '          where ct.numero=p.contrato '
      #9#9'   and ct.situacao='#39'C'#39' '
      #9#9'   and not exists (select p2.numero'
      '                           from parcelas p2'
      '                           where p2.contrato = ct.numero '
      #9#9#9#9#9#9'     and p2.tipopagto<>'#39'E'#39') '
      #9#9'   and p.datapagto between :datainicial and :datafinal '
      #9#9'   and not exists (select cd.contrato'
      '                           from contratosdevolvidos cd'
      
        '                           where cd.contrato = ct.numero /*and c' +
        'd.tipo='#39'D'#39'*/ )'
      
        '           and case when ct.os then ct.tipoequipamento in (1,2) ' +
        'and not (coalesce(ct.os_garantia,false) and ct.os_garantia_statu' +
        's='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '         ) as cancelados join '
      #9#9'                  contratos ct '
      #9#9'                   join (produtoscontratos pc'
      #9#9#9#9#9#9'         join (produtos p'
      #9#9#9#9#9#9#9#9'       join (((caracteristicas c'
      #9#9#9#9#9#9#9#9#9'           join classes cl'
      #9#9#9#9#9#9#9#9#9#9#9'   on c.classe = cl.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9#9#9#9#9'  join grupos g'
      #9#9#9#9#9#9#9#9#9#9#9'  on c.grupo = g.codigo)'
      ''
      #9#9#9#9#9#9#9#9#9#9#9' join tiposproduto tp'
      #9#9#9#9#9#9#9#9#9#9#9' on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                        on p.caracteristica = c.' +
        'codigo)'
      '                                 on pc.produto=p.codigo)'
      '                            on pc.contrato = ct.numero'#9#9#9#9#9#9'   '
      #9#9#9#9#9#9'  on cancelados.numero = ct.numero'
      #9#9#9#9#9#9'   '
      #9#9#9#9#9#9'   '
      
        '                           LEFT JOIN movimentos m1 ON m1.produto' +
        ' = pc.produto AND'
      '                                     m1.filial = pc.filial AND'
      
        '                                     m1.numero =  (select m4.num' +
        'ero'
      '                                                   from'
      '                                                   ('
      
        '                                                     select m2.d' +
        'ata,'
      
        '                                                            (sel' +
        'ect max(m3.lancto)'
      
        '                                                             fro' +
        'm movimentos m3'
      
        '                                                             whe' +
        're m3.produto = pc.produto'
      
        '                                                               a' +
        'nd m3.filial = pc.filial'
      
        '                                                               a' +
        'nd m3.data = m2.data'
      
        '                                                               a' +
        'nd coalesce(m3.financeiro,0)<>0'
      
        '                                                               a' +
        'nd coalesce(m3.emestoque,0)<>0'
      
        '                                                             ) a' +
        's lancto'
      '                                                     from'
      '                                                     ('
      
        '                                                      select max' +
        '(m2.data) as data'
      
        '                                                      from movim' +
        'entos m2'
      
        '                                                      where m2.p' +
        'roduto = pc.produto'
      
        '                                                        and m2.f' +
        'ilial = pc.filial'
      
        '                                                        and m2.d' +
        'ata < (cancelados.datapagto +1)'
      
        '                                                        and coal' +
        'esce(m2.financeiro,0)<>0'
      
        '                                                        and coal' +
        'esce(m2.emestoque,0)<>0'
      '                                                     ) as m2'
      
        '                                                   ) as m join m' +
        'ovimentos m4 on m4.data = m.data'
      
        '                                                                ' +
        '            and m4.lancto = m.lancto'
      
        '                                                                ' +
        '            and m4.produto = pc.produto'
      
        '                                                                ' +
        '            and m4.filial = pc.filial'
      
        '                                                   order by m4.l' +
        'ancto desc limit 1'
      '                                                  )'#9#9#9#9#9#9'   '
      ''
      ''
      '                           '
      '    where true'
      ''
      ''
      '   )'
      '   '
      '   union all'
      '   '
      '   ('
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      
        '      cast('#39'DEVOLU'#199#213'ES - '#39' as varchar)||cast(tp.descricao as var' +
        'char) as descricaotipoproduto,'
      ''
      
        '      case when :AgruparGrupo then c.grupo     else cast(null as' +
        ' varchar(4)) end as grupo,'
      
        '      case when :AgruparGrupo then g.descricao else cast(null as' +
        ' varchar(30)) end as descricaogrupo,'
      
        '      case when :AGruparClasse then c.classe    else cast(null a' +
        's varchar(2)) end as classe,'
      
        '      case when :AGruparClasse then cl.descricao else cast(null ' +
        'as varchar(30)) end as descricaoclasse,'
      ''
      '        cast('#39'NF '#39'||np.numero as varchar(30)) as documento,'
      '        np.data,'
      '        np.fornecedor as cliente,'
      '        np.tipofornecedor as tipocliente,'
      '        np.nome as nomecliente,'
      ''
      #9'  pnp.quantidade * abs(m1.valor/m1.quantidade) as valor'
      ''
      '     from (notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      
        '           on pnp.produto=p.codigo) on np.codigo = pnp.codigonot' +
        'a)'
      #9#9'   '
      
        #9#9'               JOIN movimentos m1 ON m1.produto = pnp.produto ' +
        'AND'
      '                                     m1.filial = pnp.filial AND'
      '                                     m1.data = np.data and'
      
        '                                     m1.codigonota = pnp.codigon' +
        'ota and'
      
        '                                     m1.numero =  (select m4.num' +
        'ero'
      '                                                   from'
      '                                                   ('
      
        '                                                     select m2.d' +
        'ata,'
      
        '                                                            (sel' +
        'ect max(m3.lancto)'
      
        '                                                             fro' +
        'm movimentos m3'
      
        '                                                             whe' +
        're m3.produto = pnp.produto'
      
        '                                                               a' +
        'nd m3.filial = pnp.filial'
      
        '                                                               a' +
        'nd m3.data = np.data'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'   and m3.codigonota = pnp.codigonota'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'   and m3.numerocontrole = pnp.numero'
      #9'    '#9#9#9#9#9#9#9#9#9#9#9#9#9'   and coalesce(m3.valor,0)<>0'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'   ) as lancto'
      '                                                     from'
      '                                                     ('
      
        '                                                      select max' +
        '(m2.data) as data'
      
        '                                                      from movim' +
        'entos m2'
      
        '                                                      where m2.p' +
        'roduto = pnp.produto'
      
        '                                                        and m2.f' +
        'ilial = pnp.filial'
      
        '                                                        and m2.d' +
        'ata = np.data'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9'and m2.codigonota = pnp.codigonota'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9'and m2.numerocontrole = pnp.numero'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9'and coalesce(m2.valor,0)<>0'
      '                                                     ) as m2'
      
        '                                                   ) as m join m' +
        'ovimentos m4 on m4.produto = pnp.produto'
      
        '                                                                ' +
        '            and m4.filial = pnp.filial'
      
        '                                                                ' +
        '            and m4.data = m.data'
      
        '                                                                ' +
        '            and m4.codigonota = pnp.codigonota'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'and m4.numerocontrole = pnp.numero'
      
        '                                                                ' +
        '            and m4.lancto = m.lancto'
      ''
      
        '                                                                ' +
        '            '
      
        '                                                   order by m4.l' +
        'ancto desc limit 1'
      '                                                  )'
      ''
      #9#9'   '
      #9#9'   '
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      ''
      '   )'
      ''
      ' ) as custo'
      ' where valor is not null'
      ''
      '        group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo, grupo,'
      '            descricaoclasse,'
      '            classe,'
      ''
      '         custo.documento,'
      '         custo.data,'
      '         custo.cliente,'
      '         custo.tipocliente,'
      '         custo.nomecliente'
      ''
      ''
      ''
      '        order by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo,'
      '            grupo,'
      '            descricaoclasse,'
      '            classe,'
      ''
      '         custo.data,'
      '         custo.documento,'
      '         custo.cliente,'
      '         custo.tipocliente,'
      '         custo.nomecliente'
      ''
      ''
      '')
    RequestLive = False
    Left = 208
    Top = 192
    ParamData = <
      item
        DataType = ftString
        Name = 'AgruparGrupo'
        ParamType = ptUnknown
        Value = 'true'
      end
      item
        DataType = ftUnknown
        Name = 'AGruparClasse'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'datainicial'
        ParamType = ptUnknown
        Value = #39'2015-01-01'#39
      end
      item
        DataType = ftString
        Name = 'datafinal'
        ParamType = ptUnknown
        Value = #39'2015-01-31'#39
      end>
  end
