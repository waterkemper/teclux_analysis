      '      mmoZebradoGroupHeaderReceitaporGrupo.color := clNone;'
      '      vZebrar := true;'
      '    end;'
      '  end;'
      ''
      'end;'
      ''
      
        'procedure GroupFooterReceitaporGrupoOnBeforePrint(Sender: TfrxCo' +
