  object qryReceita_Operacional_Bruta_Tentativa_1: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ''
      '/* qryReceita_Operacional_Bruta */'
      ''
      ';'
      'select sel.*'
      'from'
      '('
      ''
      '('
      '   /* VENDAS COM CONTRATOS */'
      '  select cast(1 as integer) as classificacao,'
      
        '         cast('#39'RECEITA OPERACIONAL BRUTA'#39' as varchar(50)) as des' +
        'cricaoclassificacao,'
      '         vp.tipoproduto,'
      '         vp.descricaotipoproduto,'
      '         vp.grupo,'
      '         vp.descricaogrupo,'
      '         vp.classe,'
      '         vp.descricaoclasse,'
      '         sum(vp.ValorBrutodoProduto) as ValorBrutodoProduto'
      '  from'
      '    ('
      '       ('
      
        '        select tipoproduto, descricaotipoproduto, grupo, descric' +
        'aogrupo,'
      
        '               classe, descricaoclasse, contrato, NumeroParcela,' +
        ' data,'
      '               sum(ValorBrutodoProduto) as ValorBrutodoProduto'
      '        from'
      ''
      '         ('
      '              select distinct'
      '              pa.contrato, pc.produto, pc.filial,'
      
        '              case when :Regime = '#39'Caixa'#39' then pa.numero else ca' +
        'st(null as integer) end as NumeroParcela,'
      ''
      '              c.tipoproduto,'
      '              tp.descricao as descricaotipoproduto,'
      ''
      
        '              case when :AgruparGrupo then c.grupo     else cast' +
        '(null as varchar(4)) end as grupo,'
      
        '              case when :AgruparGrupo then g.descricao else cast' +
        '(null as varchar(30)) end as descricaogrupo,'
      
        '              case when :AGruparClasse then c.classe    else cas' +
        't(null as varchar(2)) end as classe,'
      
        '              case when :AGruparClasse then cl.descricao else ca' +
        'st(null as varchar(30)) end as descricaoclasse,'
      ''
      '              case when :Regime='#39'Caixa'#39' then'
      '                pa.datapagto'
      '              else'
      '                ct.faturamento'
      '              end as data,'
      ''
      
        '              case when :Regime = '#39'Caixa'#39' then ((pc.quantidade*p' +
        'c.precovenda) + coalesce(pc.frete,0) + coalesce(pc.seguro,0) + c' +
        'oalesce(pc.acrescimo,0)) * (pa.valorvencto / ct.valorprazo)'
      
        '                   when :Regime = '#39'Compet'#234'ncia'#39' then ((pc.quanti' +
        'dade*pc.precovenda) + coalesce(pc.frete,0) + coalesce(pc.seguro,' +
        '0) + coalesce(pc.acrescimo,0))'
      '              end as ValorBrutodoProduto'
      ''
      ''
      '             from (contratos ct'
      '                   join (produtoscontratos pc'
      '                         join (produtos p'
      '                               join (((caracteristicas c'
      '                                       join classes cl'
      '                                       on c.classe=cl.codigo)'
      ''
      '                                       join grupos g'
      '                                       on c.grupo = g.codigo)'
      ''
      '                                       join tiposproduto tp'
      
        '                                       on c.tipoproduto = tp.cod' +
        'igo)'
      ''
      '                               on p.caracteristica=c.codigo)'
      '                         on pc.produto=p.codigo)'
      '                   on ct.numero = pc.contrato)'
      ''
      '                   join parcelas pa'
      '                        join recebimentos r'
      '                        on pa.transacao = r.transacao'
      '                   on ct.numero = pa.contrato'
      ''
      '             where not pc.brinde and'
      '                       case when :Regime='#39'Caixa'#39' then'
      
        '                          pa.datapagto between(:datainicial) and' +
        ' (:datafinal)'
      '                       else'
      
        '                         ct.faturamento between(:datainicial) an' +
        'd (:datafinal)'
      '                       end and'
      '                       (coalesce(ct.valorvista,0)<>0) and'
      '                       ct.origem is null'
      ''
      ''
      ''
      '      ) as ct'
      
        '      group by tipoproduto, descricaotipoproduto, grupo, descric' +
        'aogrupo, classe, descricaoclasse'
      '  '
      '   )'
      '  '
      '    '
      '    union all'
      '    '
      '   ('
      '      /* VENDAS SEM CONTRATO */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      ''
      '       /* VALOR BRUTO */'
      #9'  ((pdf.quantidade*pdf.precovenda) +'
      
        '      (((coalesce(df.valorfrete,0)+coalesce(df.seguro,0))*(pdf.q' +
        'uantidade*pdf.precovenda))  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '        where sdf.dadofiscal = df.numero),0)),0),1))'
      '          )) +'
      #9'   /* ACRESCIMO */'
      ''
      
        '      (((df.Valortotal-df.ValorVista)*(pdf.quantidade*pdf.precov' +
        'enda))  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      ''
      #9'   as ValorBrutodoProduto'
      ''
      '      from (dadosfiscais df'
      '             join (produtosdadosfiscais pdf'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      ''
      '                         on p.caracteristica=c.codigo)'
      
        '             on pdf.produto=p.codigo) on df.numero = pdf.dadofis' +
        'cal)'
      ''
      
        '      Where (df.data between (:datainicial) and (:datafinal)) an' +
        'd df.contrato is null'
      '              and df.situacao='#39'N'#39
      '              and eHNotaFiscalSaidaVenda(pdf.codigofiscal)'
      '        and not coalesce(df.notavinculada,false)'
      ''
      ''
      '   )'
      '   '
      '  )  as vp'
      '     group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo,'
      '            grupo,'
      '            descricaoclasse,'
      '            classe'
      ''
      ''
      ')'
      ''
      '  union all'
      ''
      '('
      
        '  select classificacao, descricaoclassificacao,  tipoproduto, de' +
        'scricaotipoproduto, grupo, descricaogrupo, classe, descricaoclas' +
        'se,'
      '         sum(ValorBrutodoProduto) as ValorBrutodoProduto'
      '   from'
      '   '
      '  ('
      '    select distinct '
      '    '
      '              p.contrato, sc.servico,'
      
        '              case when :Regime = '#39'Caixa'#39' then p.numero else cas' +
        't(null as integer) end as NumeroParcela,'
      ''
      '      cast(1 as integer) as classificacao,'
      
        '      cast('#39'RECEITA OPERACIONAL BRUTA'#39' as varchar(50)) as descri' +
        'caoclassificacao,'
      ''
      '      cast('#39'09'#39' as varchar(2)) as tipoproduto,'
      
        '      (select tp.descricao from tiposproduto tp where tp.codigo ' +
        '= '#39'09'#39') as descricaotipoproduto,'
      ''
      #9'  '
      
        #9'  case when :AgruparGrupo then cast('#39'SE'#39' as varchar(4))        ' +
        'else cast(null as varchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then cast('#39'SERVICOS'#39' as varchar(30)) ' +
        'else cast(null as varchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then cast('#39'SE'#39' as varchar(02))      ' +
        ' else cast(null as varchar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cast('#39'SERVICOS'#39' as varchar(30))' +
        ' else cast(null as varchar(30)) end as descricaoclasse,'
      '      '
      
        '              case when :Regime = '#39'Caixa'#39' then round((coalesce(s' +
        'c.quantidade,0)*coalesce(sc.valorservico,0)),2) * (p.valorvencto' +
        ' / ct.valorprazo)'
      
        '                   when :Regime = '#39'Compet'#234'ncia'#39' then round((coal' +
        'esce(sc.quantidade,0)*coalesce(sc.valorservico,0)),2)'
      '              end as ValorBrutodoProduto'
      ''
      '   from ((contratos ct'
      '         join servicoscontratos sc'
      '         on ct.numero = sc.contrato)'
      '   '
      '             join parcelas p on ct.numero = p.contrato)'
      ''
      '             where   case when :Regime='#39'Caixa'#39' then'
      
        '                          p.datapagto between(:datainicial) and ' +
        '(:datafinal) '
      '                       else   '
      
        '                         ct.faturamento between(:datainicial) an' +
        'd (:datafinal) '
      '                       end and'
      
        '                       (coalesce(ct.valorvista,0)<>0) and       ' +
        '        '
      '                       ct.origem is null'
      '  ) as sc'
      '  '
      
        '  group by classificacao, descricaoclassificacao,  tipoproduto, ' +
        'descricaotipoproduto, grupo, descricaogrupo, classe, descricaocl' +
        'asse '
      '  '
      ')'
      ''
      'union all'
      ''
      ''
      '('
      '  select cast(2 as integer) as classificacao,'
      
        '        cast('#39'(-) DEDU'#199#213'ES DA RECEITA BRUTA'#39' as varchar(50)) as ' +
        'descricaoclassificacao,'
      '        dev.tipoproduto,'
      '        dev.descricaotipoproduto,'
      '        dev.grupo,'
      '        dev.descricaogrupo,'
      '        dev.classe,'
      '        dev.descricaoclasse,'
      '        sum(dev.ValorBrutodoproduto) as ValorBrutodoproduto'
      '  from'
      '  ('
      ''
      '    ('
      ''
      '       /* CONTRATOS FATURADOS DEVOLVIDOS */'
      '        select'
      ''
      '        c.tipoproduto,'
      
        '        cast('#39'DEVOLU'#199#213'ES - '#39' as varchar)||cast(tp.descricao as v' +
        'archar) as descricaotipoproduto,'
      #9#9
      
        '  '#9'    case when :AgruparGrupo then c.grupo     else cast(null a' +
        's varchar(4)) end as grupo,'
      
        #9'    case when :AgruparGrupo then g.descricao else cast(null as ' +
        'varchar(30)) end as descricaogrupo,'
      
        #9'    case when :AGruparClasse then c.classe    else cast(null as' +
        ' varchar(2)) end as classe,'
      
        #9'    case when :AGruparClasse then cl.descricao else cast(null a' +
        's varchar(30)) end as descricaoclasse,'
      #9#9
      ''
      '        -'
      #9#9'/* VALOR BRUTO */'
      #9#9'((cd.valorvista + cd.desconto) +'
      #9#9'/* ACRESCIMO*/'
      #9#9' (cd.ValorPrazo-cd.ValorVista))'
      #9#9'as ValorBrutodoproduto'
      ''
      '        from ((contratosdevolvidos cd'
      '               join contratos ct'
      '               on cd.contrato=ct.numero)'
      ''
      '               join (produtos p'
      '                     join (((caracteristicas c'
      '                             join classes cl'
      '                             on c.classe=cl.codigo)'
      ''
      '                             join grupos g'
      '                             on c.grupo = g.codigo)'
      ''
      '                             join tiposproduto tp'
      '                             on c.tipoproduto = tp.codigo)'
      ''
      '                     on p.caracteristica=c.codigo)'
      '               on cd.produto=p.codigo)'
      ''
      
        '        where cd.devolucao between(:DataInicial) and (:DataFinal' +
        ')'
      '          /* and cd.tipo = '#39'D'#39' */'
      
        '          and case when ct.os then ct.tipoequipamento in (1,2) a' +
        'nd not (coalesce(ct.os_garantia,false) and ct.os_garantia_status' +
        '='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '          and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturadas' +
        ' as outras entram pelas notas fiscais devido a cr'#233'ditos de troca' +
        ' */'
      ''
      '    )'
      ''
      ''
      '    union all'
      ''
      '    ('
      '        /* CONTRATOS FATURADOS TOTALMENTE CANCELADOS  */'
      '        select'
      '        c.tipoproduto,'
      
        #9#9'    cast('#39'DEVOLU'#199#213'ES - '#39' as varchar)||cast(tp.descricao as var' +
        'char) as descricaotipoproduto,'
      #9#9#9
      
        #9'    case when :AgruparGrupo then c.grupo     else cast(null as ' +
        'varchar(4)) end as grupo,'
      
        #9'    case when :AgruparGrupo then g.descricao else cast(null as ' +
        'varchar(30)) end as descricaogrupo,'
      
        #9'    case when :AGruparClasse then c.classe    else cast(null as' +
        ' varchar(2)) end as classe,'
      
        #9'    case when :AGruparClasse then cl.descricao else cast(null a' +
        's varchar(30)) end as descricaoclasse,'
      #9#9#9#9#9
      '      - '#9'  '
      #9'  /* VALOR BRUTO */'
      #9'  (((pc.quantidade*pc.precovenda) +'
      
        '      (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quantid' +
        'ade*pc.precovenda))  /'
      
        '      (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-c' +
        'oalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                   coalesce((select  sum(sc.quan' +
        'tidade*coalesce(sc.valorservico,0))'
      '        from servicoscontratos sc'
      '        where sc.contrato = ct.numero),0)),0),1))'
      '      )) +'
      #9'  '
      #9'  /* ACRESCIMO */'
      #9'  '
      
        #9'   (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precovenda' +
        '))  /'
      
        '       (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-' +
        'coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '               coalesce((select  sum(sc.quantidade*coalesce(sc.v' +
        'alorservico,0))'
      '                from servicoscontratos sc'
      '                where sc.contrato = ct.numero),0)),0),1))) -'
      #9#9#9#9
      #9#9'/* DESCONTO */'#9#9
      
        '       ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)) ' +
        ' /'
      
        '       (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-' +
        'coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '               coalesce((select  sum(sc.quantidade*coalesce(sc.v' +
        'alorservico,0))'
      '                from servicoscontratos sc'
      '                where sc.contrato = ct.numero),0)),0),1))))'
      #9'  '
      #9'  as ValorBrutodoProduto'
      ''
      ''
      '    from (select distinct ct.numero, p.datapagto'
      '          from contratos ct, parcelas p'
      '          where ct.numero=p.contrato '
      #9#9'   and ct.situacao='#39'C'#39' '
      #9#9'   and not exists (select p2.numero'
      '                           from parcelas p2'
      '                           where p2.contrato = ct.numero '
      #9#9#9#9#9#9'     and p2.tipopagto<>'#39'E'#39') '
      #9#9'   and p.datapagto between :datainicial and :datafinal '
      #9#9'   and not exists (select cd.contrato'
      '                           from contratosdevolvidos cd'
      
        '                           where cd.contrato = ct.numero /*and c' +
        'd.tipo='#39'D'#39'*/ )'
      
        '           and case when ct.os then ct.tipoequipamento in (1,2) ' +
        'and not (coalesce(ct.os_garantia,false) and ct.os_garantia_statu' +
        's='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '         ) as cancelados, (contratos ct '
      #9#9'                   join (produtoscontratos pc'
      #9#9#9#9#9#9'         join (produtos p'
      #9#9#9#9#9#9#9#9'       join (((caracteristicas c'
      #9#9#9#9#9#9#9#9#9'           join classes cl'
      #9#9#9#9#9#9#9#9#9#9#9'   on c.classe = cl.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9#9#9#9#9'  join grupos g'
      #9#9#9#9#9#9#9#9#9#9#9'  on c.grupo = g.codigo)'
      ''
      #9#9#9#9#9#9#9#9#9#9#9' join tiposproduto tp'
      #9#9#9#9#9#9#9#9#9#9#9' on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                       on p.caracteristica = c.c' +
        'odigo)'
      '                                 on pc.produto=p.codigo)'
      '                           on pc.contrato = ct.numero)'
      '    where cancelados.numero = ct.numero'
      #9#9
      ''
      '    )'
      ''
      '    union all'
      ''
      '    ('
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      
        '      cast('#39'DEVOLU'#199#213'ES - '#39' as varchar)||cast(tp.descricao as var' +
        'char) as descricaotipoproduto,'
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      '      -'
      '      ((pnp.quantidade * pnp.precounitario)'
      '      - coalesce(pnp.valordescontoitem,0)'
      '      - coalesce(pnp.desconto,0)'
      '      + coalesce(pnp.acrescimo,0)'
      '      + coalesce(pnp.frete,0)'
      '      + coalesce(pnp.seguro,0)'
      '      + coalesce(pnp.valoripi,0)'
      '      + coalesce(pnp.icmsvalorst,0)'
      '      + coalesce(pnp.despesasacessorias,0))'
      #9'   as ValorBrutodoProduto'
      ''
      '     from (notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      
        '           on pnp.produto=p.codigo) on np.codigo = pnp.codigonot' +
        'a)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      ''
      '    )'
      ''
      #9'union all'
      ''
      ''
      '    ('
      ''
      '       /* DESCONTOS DE VENDAS COM CONTRATO */'
      ''
      '      select'
      '      c.tipoproduto,'
      
        #9'  cast('#39'DESCONTOS - '#39' as varchar)||cast(tp.descricao as varchar' +
        ') as descricaotipoproduto,'
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      '      - '
      #9'  '
      #9'  ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))  /'
      
        '       (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-' +
        'coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '               coalesce((select  sum(sc.quantidade*coalesce(sc.v' +
        'alorservico,0))'
      '                from servicoscontratos sc'
      '                where sc.contrato = ct.numero),0)),0),1)))'
      #9#9#9#9
      #9'  as  ValorBrutodoProduto'
      ''
      ''
      '     from (contratos ct'
      '           join (produtoscontratos pc'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on pc.produto=p.codigo)'
      '           on ct.numero = pc.contrato)'
      ''
      '     where not pc.brinde and'
      
        '               ct.faturamento between(:datainicial) and (:datafi' +
        'nal) and'
      '               (coalesce(ct.valorvista,0)<>0) and'
      '               ct.origem is null and'
      #9#9#9'   coalesce(ct.desconto,0)<>0'
      ''
      '    )'
      '    union all'
      '    ('
      '       /* DESCONTOS DE VENDAS SEM CONTRATO */'
      ''
      '      select'
      '      c.tipoproduto,'
      
        '      cast('#39'DESCONTOS - '#39' as varchar)||cast(tp.descricao as varc' +
        'har) as descricaotipoproduto,'
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      '      - '
      ''
      
        '      ((coalesce(df.desconto,0)*(pdf.quantidade*pdf.precovenda))' +
        '  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      ''
      #9'   as ValorBrutodoProduto'
      ''
      ''
      '      from (dadosfiscais df'
      '             join (produtosdadosfiscais pdf'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      ''
      '                         on p.caracteristica=c.codigo)'
      
        '             on pdf.produto=p.codigo) on df.numero = pdf.dadofis' +
        'cal)'
      ''
      
        '      Where (df.data between (:datainicial) and (:datafinal)) an' +
        'd df.contrato is null'
      '              and df.situacao='#39'N'#39
      '              and eHNotaFiscalSaidaVenda(pdf.codigofiscal)'
      '        and not coalesce(df.notavinculada,false) and'
      #9#9#9'   coalesce(df.desconto,0)<>0'
      ''
      ''
      '    )'
      ''
      #9#9'union all'
      ''
      '    /*'
      '    ('
      '      select'
      '      c.tipoproduto,'
      
        #9'  cast('#39'CR'#201'DITO TROCA - '#39' as varchar)||cast(tp.descricao as var' +
        'char) as descricaotipoproduto,'
      '      c.grupo,'
      '      g.descricao as descricaogrupo,'
      '      c.classe,'
      '      cl.descricao as descricaoclasse,'
      ''
      '      -'
      ''
      '--'#9'   VALOR BRUTO'
      #9'  ((((pc.quantidade*pc.precovenda) +'
      
        '      (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quantid' +
        'ade*pc.precovenda))  /'
      
        '       (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-' +
        'coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '               coalesce((select  sum(sc.quantidade*coalesce(sc.v' +
        'alorservico,0))'
      '                from servicoscontratos sc'
      '                where sc.contrato = ct.numero),0)),0),1)))) +'
      ''
      '--'#9'   ACRESCIMO'
      
        '      (((ValorPrazo-ValorVista)*(pc.quantidade*pc.precovenda))  ' +
        '/'
      
        '       (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-' +
        'coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '               coalesce((select  sum(sc.quantidade*coalesce(sc.v' +
        'alorservico,0))'
      '                from servicoscontratos sc'
      '                where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '--'#9'  DESCONTO'
      #9'  ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))  /'
      
        '       (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-' +
        'coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '               coalesce((select  sum(sc.quantidade*coalesce(sc.v' +
        'alorservico,0))'
      '                from servicoscontratos sc'
      
        '                where sc.contrato = ct.numero),0)),0),1))))*ct.c' +
        'reditotroca)/(COALESCE(NULLIF(valorprazo,0),1))'
      #9#9#9#9
      #9'  as  ValorBrutodoProduto'
      #9'  '
      ''
      ''
      '     from (contratos ct'
      '           join (produtoscontratos pc'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on pc.produto=p.codigo)'
      '           on ct.numero = pc.contrato)'
      ''
      '     where not pc.brinde and'
      
        '               ct.faturamento between(:datainicial) and (:datafi' +
        'nal) and'
      '               (coalesce(ct.valorvista,0)<>0) and'
      '               ct.origem is null and'
      #9#9#9'   coalesce(ct.creditotroca,0)<>0'
      ''
      '    )'
      #9
      #9'union all'
      '  */'
      #9
      #9'('
      #9
      #9'  /* IMPOSTOS - REGIME SIMPLES */'
      #9
      '     select impostos.tipoproduto,'
      
        '            cast('#39'IMPOSTOS - '#39' as varchar)||cast(impostos.descri' +
        'caotipoproduto as varchar) as descricaotipoproduto,'
      '            impostos.grupo,'
      '            impostos.descricaogrupo,'
      '            impostos.classe,'
      '            impostos.descricaoclasse,'
      
        '            - sum(case when coalesce(impostos.aliquotaicmssn,0) ' +
        '= 0 then 0  else impostos.ValorBrutodoProduto * impostos.aliquot' +
        'aicmssn / 100 end) as ValorBrutodoProduto '
      #9'from'#9#9
      #9
      #9'('
      #9
      '      ('
      
        '            /* VENDAS COM CONTRATO BRUTO + ACRESIMCO - DESCONTO ' +
        '*/'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      #9#9
      
        '  '#9'    case when :AgruparGrupo then c.grupo     else cast(null a' +
        's varchar(4)) end as grupo,'
      
        #9'    case when :AgruparGrupo then g.descricao else cast(null as ' +
        'varchar(30)) end as descricaogrupo,'
      
        #9'    case when :AGruparClasse then c.classe    else cast(null as' +
        ' varchar(2)) end as classe,'
      
        #9'    case when :AGruparClasse then cl.descricao else cast(null a' +
        's varchar(30)) end as descricaoclasse,'
      #9#9
      '      (select asn.aliquotaicms'
      '       from aliquotassimplesnacional asn'
      '         where asn.filial = ct.filialvenda'
      
        '         and asn.mesano = to_char(ct.faturamento, '#39'mm/yyyy'#39'))  a' +
        's aliquotaicmssn,'
      ''
      ''
      '      /* VALOR BRUTO */'
      '      ((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1)))) +'
      ''
      '      /* ACRESCIMO */'
      
        '        (((ValorPrazo-ValorVista)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '      /* DESCONTO */'
      
        '        ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1)))'
      ''
      '        as  ValorBrutodoProduto'
      ''
      ''
      '       from (contratos ct'
      '             join (produtoscontratos pc'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      ''
      '                         on p.caracteristica=c.codigo)'
      '                   on pc.produto=p.codigo)'
      '             on ct.numero = pc.contrato)'
      ''
      '       where not pc.brinde'
      
        '         and ct.faturamento between(:datainicial) and (:datafina' +
        'l)'
      '         and (coalesce(ct.valorvista,0)<>0)'
      '         and ct.origem is null'
      
        '         and (select f.regimetributario from filiais f where f.c' +
        'odigo = ct.filialvenda)=1  /* simples nacional*/'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      '        /* VENDAS SEM CONTRATO */'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      #9#9
      
        #9'    case when :AgruparGrupo then c.grupo     else cast(null as ' +
        'varchar(4)) end as grupo,'
      
        #9'    case when :AgruparGrupo then g.descricao else cast(null as ' +
        'varchar(30)) end as descricaogrupo,'
      
        #9'    case when :AGruparClasse then c.classe    else cast(null as' +
        ' varchar(2)) end as classe,'
      
        #9'    case when :AGruparClasse then cl.descricao else cast(null a' +
        's varchar(30)) end as descricaoclasse,'
      #9#9
      ''
      '      (select asn.aliquotaicms'
      '       from aliquotassimplesnacional asn'
      '         where asn.filial = df.filialvenda'
      
        '         and asn.mesano = to_char(df.data, '#39'mm/yyyy'#39'))  as aliqu' +
        'otaicmssn,'
      ''
      ''
      ''
      '         /* VALOR BRUTO */'
      '      ((pdf.quantidade*pdf.precovenda) +'
      
        '        (((coalesce(df.valorfrete,0)+coalesce(df.seguro,0))*(pdf' +
        '.quantidade*pdf.precovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      '          where sdf.dadofiscal = df.numero),0)),0),1)))) +'
      '       /* ACRESCIMO */'
      ''
      
        '        (((df.Valortotal-df.ValorVista)*(pdf.quantidade*pdf.prec' +
        'ovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      
        '                  where sdf.dadofiscal = df.numero),0)),0),1))) ' +
        ' -'
      '       /* DESCONTO */'
      ''
      
        '      ((coalesce(df.desconto,0)*(pdf.quantidade*pdf.precovenda))' +
        '  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      ''
      ''
      '       as ValorBrutodoProduto'
      ''
      '        from (dadosfiscais df'
      '               join (produtosdadosfiscais pdf'
      '                     join (produtos p'
      '                           join (((caracteristicas c'
      '                                   join classes cl'
      '                                   on c.classe=cl.codigo)'
      ''
      '                                   join grupos g'
      '                                   on c.grupo = g.codigo)'
      ''
      '                                   join tiposproduto tp'
      '                                   on c.tipoproduto = tp.codigo)'
      ''
      '                           on p.caracteristica=c.codigo)'
      
        '               on pdf.produto=p.codigo) on df.numero = pdf.dadof' +
        'iscal)'
      ''
      '        Where (df.data between (:datainicial) and (:datafinal))'
      '          and df.contrato is null'
      '          and df.situacao='#39'N'#39
      '          and eHNotaFiscalSaidaVenda(pdf.codigofiscal)'
      '          and not coalesce(df.notavinculada,false)'
      
        '          and (select f.regimetributario from filiais f where f.' +
        'codigo = df.filialvenda)=1  /* simples nacional*/'
      ''
      ''
      '     )'
      ''
      '       union all'
      ''
      '     ('
      '         /* DEVOLUCOES COM CONTRATO */'
      ''
      '          select'
      ''
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        '  '#9'      case when :AgruparGrupo then c.grupo     else cast(null' +
        ' as varchar(4)) end as grupo,'
      
        #9'      case when :AgruparGrupo then g.descricao else cast(null a' +
        's varchar(30)) end as descricaogrupo,'
      
        #9'      case when :AGruparClasse then c.classe    else cast(null ' +
        'as varchar(2)) end as classe,'
      
        #9'      case when :AGruparClasse then cl.descricao else cast(null' +
        ' as varchar(30)) end as descricaoclasse,'
      #9#9'  '
      '      (select asn.aliquotaicms'
      '       from aliquotassimplesnacional asn'
      '         where asn.filial = ct.filialvenda'
      
        '         and asn.mesano = to_char(cd.devolucao, '#39'mm/yyyy'#39'))  as ' +
        'aliquotaicmssn,'
      #9#9
      #9#9
      '          - '
      '      /* VALOR BRUTO */'
      '      ((cd.valorvista + cd.desconto) +'
      '      /* ACRESCIMO*/'
      '       (cd.ValorPrazo-cd.ValorVista))'
      '      as ValorBrutodoproduto'
      ''
      '          from ((contratosdevolvidos cd'
      '                 join contratos ct'
      '                 on cd.contrato=ct.numero)'
      ''
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on cd.produto=p.codigo)'
      ''
      
        '          where cd.devolucao between(:DataInicial) and (:DataFin' +
        'al)'
      '            /* and cd.tipo = '#39'D'#39' */'
      
        '            and case when ct.os then ct.tipoequipamento in (1,2)' +
        ' and not (coalesce(ct.os_garantia,false) and ct.os_garantia_stat' +
        'us='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '            and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturad' +
        'as as outras entram pelas notas fiscais devido a cr'#233'ditos de tro' +
        'ca */'
      
        '            and (select f.regimetributario from filiais f where ' +
        'f.codigo = ct.filialvenda)=1  /* simples nacional*/'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      ''
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      '            (select asn.aliquotaicms'
      '       from aliquotassimplesnacional asn'
      '         where asn.filial = np.filial'
      
        '         and asn.mesano = to_char(np.data, '#39'mm/yyyy'#39'))  as aliqu' +
        'otaicmssn,'
      ''
      ''
      '      -'
      '      ((pnp.quantidade * pnp.precounitario)'
      '      - coalesce(pnp.valordescontoitem,0)'
      '      - coalesce(pnp.desconto,0)'
      '      + coalesce(pnp.acrescimo,0)'
      '      + coalesce(pnp.frete,0)'
      '      + coalesce(pnp.seguro,0)'
      '      + coalesce(pnp.valoripi,0)'
      '      + coalesce(pnp.icmsvalorst,0)'
      '      + coalesce(pnp.despesasacessorias,0))'
      #9'   as ValorBrutodoProduto'
      ''
      '     from (notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      
        '           on pnp.produto=p.codigo) on np.codigo = pnp.codigonot' +
        'a)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      
        '       and (select f.regimetributario from filiais f where f.cod' +
        'igo = np.filial)=1  /* simples nacional*/'
      ''
      ''
      '      )'
      ''
      ''
      '      union all'
      ''
      '      ('
      
        '         /* CONTRATOS CANCELADOS SEM CONTRATOS DEVOLVIDOS, TOTAL' +
        'MENTE CANCELADOS SEM PARCELAS PAGAS */'
      '          select'
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      #9#9
      '      (select asn.aliquotaicms'
      '         from aliquotassimplesnacional asn'
      '           where asn.filial = ct.filialvenda'
      
        '           and asn.mesano = to_char(cancelados.datapagto, '#39'mm/yy' +
        'yy'#39'))  as aliquotaicmssn,'
      #9#9
      '        - '#9'  '
      '      /* VALOR BRUTO */'
      '      (((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '        (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)' +
        '-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                     coalesce((select  sum(sc.qu' +
        'antidade*coalesce(sc.valorservico,0))'
      '          from servicoscontratos sc'
      '          where sc.contrato = ct.numero),0)),0),1))'
      '        )) +'
      #9'  '
      '      /* ACRESCIMO */'
      #9'  '
      
        '       (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precove' +
        'nda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      '                  '
      #9#9#9' /*  DESCONTO */'
      
        '         ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)' +
        ')  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))))'
      #9'  '
      '      as ValorBrutodoProduto'
      ''
      ''
      '      from (select distinct ct.numero, p.datapagto'
      '            from contratos ct, parcelas p'
      '            where ct.numero=p.contrato '
      '         and ct.situacao='#39'C'#39' '
      '         and not exists (select p2.numero'
      '                             from parcelas p2'
      '                             where p2.contrato = ct.numero '
      '                   and p2.tipopagto<>'#39'E'#39') '
      '         and p.datapagto between :datainicial and :datafinal '
      '         and not exists (select cd.contrato'
      '                             from contratosdevolvidos cd'
      
        '                             where cd.contrato = ct.numero /*and' +
        ' cd.tipo='#39'D'#39'*/)'
      
        '             and case when ct.os then ct.tipoequipamento in (1,2' +
        ') and not (coalesce(ct.os_garantia,false) and ct.os_garantia_sta' +
        'tus='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '           ) as cancelados, (contratos ct '
      '                         join (produtoscontratos pc'
      '                       join (produtos p'
      '                         join (((caracteristicas c'
      '                               join classes cl'
      '                           on c.classe = cl.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      '                          join grupos g'
      '                          on c.grupo = g.codigo)'
      ''
      '                         join tiposproduto tp'
      '                         on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                         on p.caracteristica = c' +
        '.codigo)'
      '                                   on pc.produto=p.codigo)'
      '                             on pc.contrato = ct.numero)'
      '      where cancelados.numero = ct.numero'
      
        '        and (select f.regimetributario from filiais f where f.co' +
        'digo = ct.filialvenda)=1  /* simples nacional*/'
      ''
      ''
      '      )'
      ''
      #9') as impostos'
      #9'       group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo,'
      '            grupo,'
      '            descricaoclasse,'
      '            classe,'
      #9#9#9'aliquotaicmssn'
      '   )'
      '   '
      '   union all'
      '   '
      '   '
      '  ('
      '  '
      '    /* IMPOSTOS - ICMS - REGIME NORMAL */'
      #9
      '     select impostos.tipoproduto,'
      
        '            cast('#39'IMPOSTOS - ICMS - '#39' as varchar)||cast(impostos' +
        '.descricaotipoproduto as varchar) as descricaotipoproduto,'
      '            impostos.grupo,'
      '            impostos.descricaogrupo,'
      '            impostos.classe,'
      '            impostos.descricaoclasse,'
      
        '            sum(impostos.ValorBrutodoProduto) as ValorBrutodoPro' +
        'duto '
      #9'from'#9#9
      #9
      #9'('
      #9
      '      ('
      
        '            /* VENDAS COM CONTRATO  BRUTO + ACRESIMCO - DESCONTO' +
        ' */'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      '      -'#9' '
      '      /* VALOR BRUTO */'#9'  '
      '      (((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1)))) +'
      ''
      '      /* ACRESCIMO */'
      
        '        (((ValorPrazo-ValorVista)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '      /* DESCONTO */'
      
        '        ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1))))*(1' +
        '-coalesce(c.percreducaobase,0)/100)) * Selecionar_Aliquotaicms(f' +
        '.estado, ct.estado, ct.pessoatipo, p.codigo)/100)'
      #9#9#9#9'  '#9#9#9'  '
      ''
      '        as  ValorBrutodoProduto'
      ''
      ''
      '       from ((contratos ct'
      '             join (produtoscontratos pc'
      '                   join (produtos p'
      '                         join ((((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9#9' join tributosicms ti'
      #9#9#9#9#9#9#9#9' on c.incidencia = ti.codigo)'
      ''
      '                         on p.caracteristica=c.codigo)'
      '                   on pc.produto=p.codigo)'
      '             on ct.numero = pc.contrato)'
      #9#9#9' '
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = ct.filialvenda)'
      ''
      '       where not pc.brinde'
      
        '         and ct.faturamento between(:datainicial) and (:datafina' +
        'l)'
      '         and (coalesce(ct.valorvista,0)<>0)'
      '         and ct.origem is null'
      '         and f.regimetributario <> 1  /* regime normal */'
      #9#9' and ti.valor in ('#39'00'#39','#39'20'#39')'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      '        /* VENDAS SEM CONTRATO */'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      #9#9
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      '/*'
      '       -- VALOR BRUTO '
      '      ((pdf.quantidade*pdf.precovenda) +'
      
        '        (((coalesce(df.valorfrete,0)+coalesce(df.seguro,0))*(pdf' +
        '.quantidade*pdf.precovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      '          where sdf.dadofiscal = df.numero),0)),0),1)))) +'
      #9#9'  '
      '       -- ACRESCIMO '
      
        '        (((df.Valortotal-df.ValorVista)*(pdf.quantidade*pdf.prec' +
        'ovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      
        '                  where sdf.dadofiscal = df.numero),0)),0),1))) ' +
        ' -'
      #9#9#9#9'  '
      '       -- DESCONTO '#9'   '
      
        '      ((coalesce(df.desconto,0)*(pdf.quantidade*pdf.precovenda))' +
        '  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      #9#9#9#9
      '       as ValorBrutodoProduto'
      '*/'
      ''
      '       - pdf.icmsvalor as ValorBrutodoProduto'
      #9'   '
      ''
      '       from ((dadosfiscais df'
      '               join (produtosdadosfiscais pdf'
      '                     join (produtos p'
      '                           join (((caracteristicas c'
      '                                   join classes cl'
      '                                   on c.classe=cl.codigo)'
      ''
      '                                   join grupos g'
      '                                   on c.grupo = g.codigo)'
      ''
      '                                   join tiposproduto tp'
      '                                   on c.tipoproduto = tp.codigo)'
      ''
      '                           on p.caracteristica=c.codigo)'
      '                    on pdf.produto=p.codigo) '
      #9#9#9'   on df.numero = pdf.dadofiscal)'
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = df.filialvenda)'
      #9#9#9'   '
      #9#9#9'   '
      '       Where (df.data between (:datainicial) and (:datafinal))'
      '          and df.contrato is null'
      '          and df.situacao='#39'N'#39
      '          and eHNotaFiscalSaidaVenda(pdf.codigofiscal)'
      '          and not coalesce(df.notavinculada,false)'
      '          and f.regimetributario <> 1  /* regime normal */'
      #9#9'  and pdf.incidencia in ('#39'00'#39','#39'20'#39')'
      ''
      '     )'
      ''
      '       union all'
      ''
      '     ('
      '         /* DEVOLUCOES COM CONTRATO */'
      ''
      '          select'
      ''
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      #9#9
      '           '
      '      /* VALOR BRUTO */'
      '      ((((cd.valorvista + cd.desconto) +'
      '      /* ACRESCIMO*/'
      
        '       (cd.ValorPrazo-cd.ValorVista)) * (1-coalesce(c.percreduca' +
        'obase,0)/100)) * Selecionar_Aliquotaicms(f.estado, ct.estado, ct' +
        '.pessoatipo, p.codigo)/100) as ValorBrutodoproduto'
      ''
      '          from ((contratosdevolvidos cd'
      '                 join (contratos ct'
      #9#9#9#9'       join filiais f'
      #9#9#9#9#9'   on ct.filialvenda = f.codigo)'
      '                 on cd.contrato=ct.numero)'
      ''
      '                 join (produtos p'
      '                       join ((((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      #9#9#9#9#9#9#9'   join tributosicms ti'
      #9#9#9#9#9#9#9'   on c.incidencia = ti.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on cd.produto=p.codigo)'
      ''
      
        '          where cd.devolucao between(:DataInicial) and (:DataFin' +
        'al)'
      '            /* and cd.tipo = '#39'D'#39' */'
      
        '            and case when ct.os then ct.tipoequipamento in (1,2)' +
        ' and not (coalesce(ct.os_garantia,false) and ct.os_garantia_stat' +
        'us='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '            and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturad' +
        'as as outras entram pelas notas fiscais devido a cr'#233'ditos de tro' +
        'ca */'
      '            and f.regimetributario <> 1  /* regime normal */'
      #9#9#9'and ti.valor in ('#39'00'#39','#39'20'#39')'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      '      pnp.icmsvalor as ValorBrutodoProduto'
      ''
      '     from ((notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join ((((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      #9#9#9#9#9#9#9'   join tributosicms ti'
      #9#9#9#9#9#9#9'   on c.incidencia = ti.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on pnp.produto=p.codigo) '
      #9#9'   on np.codigo = pnp.codigonota)'
      #9#9'   '
      '           join filiais f'
      #9'       on np.filial = f.codigo)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      #9'   and f.regimetributario <> 1  /* regime normal */'
      #9'   and ti.valor in ('#39'00'#39','#39'20'#39')'
      ''
      '      )'
      ''
      ''
      '      union all'
      ''
      '      ('
      
        '         /* CONTRATOS CANCELADOS SEM CONTRATOS DEVOLVIDOS, TOTAL' +
        'MENTE CANCELADOS SEM PARCELAS PAGAS */'
      '          select'
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      #9#9#9#9
      '      /* VALOR BRUTO */'
      '      (((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '        (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)' +
        '-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                     coalesce((select  sum(sc.qu' +
        'antidade*coalesce(sc.valorservico,0))'
      '          from servicoscontratos sc'
      '          where sc.contrato = ct.numero),0)),0),1))'
      '        )) +'
      #9'  '
      '      /* ACRESCIMO */'
      #9'  '
      
        '       (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precove' +
        'nda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      '                  '
      #9#9#9' /*  DESCONTO */'
      
        '         ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)' +
        ')  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1)))) * ' +
        '(1-coalesce(c.percreducaobase,0)/100)) * Selecionar_Aliquotaicms' +
        '(f.estado, ct.estado, ct.pessoatipo, p.codigo)/100)'
      #9'  '
      '      as ValorBrutodoProduto'
      #9'  '
      #9'  '
      '      from (select distinct ct.numero, p.datapagto'
      '            from contratos ct, parcelas p'
      '            where ct.numero=p.contrato '
      '         and ct.situacao='#39'C'#39' '
      '         and not exists (select p2.numero'
      '                             from parcelas p2'
      '                             where p2.contrato = ct.numero '
      '                   and p2.tipopagto<>'#39'E'#39') '
      '         and p.datapagto between :datainicial and :datafinal '
      '         and not exists (select cd.contrato'
      '                             from contratosdevolvidos cd'
      
        '                             where cd.contrato = ct.numero /*and' +
        ' cd.tipo='#39'D'#39'*/)'
      
        '             and case when ct.os then ct.tipoequipamento in (1,2' +
        ') and not (coalesce(ct.os_garantia,false) and ct.os_garantia_sta' +
        'tus='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '           ) as cancelados, ((contratos ct '
      '                             join (produtoscontratos pc'
      '                                   join (produtos p'
      
        '                                         join ((((caracteristica' +
        's c'
      '                                                 join classes cl'
      
        '                                                 on c.classe = c' +
        'l.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      '                                                 join grupos g'
      
        '                                                 on c.grupo = g.' +
        'codigo)'
      ''
      
        '                                                join tiposprodut' +
        'o tp'
      
        '                                                on c.tipoproduto' +
        ' = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9#9
      #9#9#9#9#9#9#9#9#9#9#9#9'join tributosicms ti'
      #9#9#9#9#9#9#9'                    on c.incidencia = ti.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                         on p.caracteristica = c' +
        '.codigo)'
      '                                   on pc.produto=p.codigo)'
      '                             on pc.contrato = ct.numero)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' join filiais f'
      #9#9#9#9#9'         on ct.filialvenda = f.codigo)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' '
      '      where cancelados.numero = ct.numero'
      #9#9'and f.regimetributario <> 1  /* regime normal */'
      #9#9'and ti.valor in ('#39'00'#39','#39'20'#39')'
      ''
      ''
      '      )'
      ''
      #9') as impostos'
      #9'       group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo,'
      '            grupo,'
      '            descricaoclasse,'
      '            classe'
      '   )'
      '   '
      '   union all'
      '   '
      '   ('
      '   '
      '   '
      '    /* IMPOSTOS - PIS - REGIME NORMAL */'
      #9
      '     select impostos.tipoproduto,'
      
        '            cast('#39'IMPOSTOS - PIS - '#39' as varchar)||cast(impostos.' +
        'descricaotipoproduto as varchar) as descricaotipoproduto,'
      '            impostos.grupo,'
      '            impostos.descricaogrupo,'
      '            impostos.classe,'
      '            impostos.descricaoclasse,'
      
        '            sum(impostos.ValorBrutodoProduto) as ValorBrutodoPro' +
        'duto '
      #9'from'#9#9
      #9
      #9'('
      #9
      '      ('
      
        '            /* VENDAS COM CONTRATO BRUTO + ACRESIMCO - DESCONTO ' +
        '*/'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      '      -'#9' '
      '      /* VALOR BRUTO */'#9'  '
      '      ((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1)))) +'
      ''
      '      /* ACRESCIMO */'
      
        '        (((ValorPrazo-ValorVista)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '      /* DESCONTO */'
      
        '        ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1)))) * ' +
        'coalesce(c.aliquotapis,0)/100)'
      #9#9#9#9'  '#9#9#9'  '
      '        as  ValorBrutodoProduto'
      ''
      ''
      '       from ((contratos ct'
      '             join (produtoscontratos pc'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9' '
      '                         on p.caracteristica=c.codigo)'
      '                   on pc.produto=p.codigo)'
      '             on ct.numero = pc.contrato)'
      #9#9#9' '
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = ct.filialvenda)'
      ''
      '       where not pc.brinde'
      
        '         and ct.faturamento between(:datainicial) and (:datafina' +
        'l)'
      '         and (coalesce(ct.valorvista,0)<>0)'
      '         and ct.origem is null'
      '         and f.regimetributario <> 1  /* regime normal */'
      #9#9' and c.piscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      #9#9' and coalesce(c.aliquotapis,0)<>0'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      '        /* VENDAS SEM CONTRATO */'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      #9#9
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      #9#9'-'
      '       (((pdf.quantidade * pdf.precovenda)'
      '         - coalesce(pdf.valordescontoitem,0)'
      '         - coalesce(pdf.desconto,0)'
      '         + coalesce(pdf.acrescimo,0)'
      '         + coalesce(pdf.frete,0)'
      '         + coalesce(pdf.seguro,0)'
      '         + coalesce(pdf.valoripi,0)'
      
        '         + coalesce(pdf.despesasacessorias,0)) * coalesce(c.aliq' +
        'uotapis,0)/100) as ValorBrutodoProduto'
      #9#9
      #9#9#9#9#9#9
      '/*'
      '       -- VALOR BRUTO '
      '      ((pdf.quantidade*pdf.precovenda) +'
      
        '        (((coalesce(df.valorfrete,0)+coalesce(df.seguro,0))*(pdf' +
        '.quantidade*pdf.precovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      '          where sdf.dadofiscal = df.numero),0)),0),1)))) +'
      #9#9'  '
      '       -- ACRESCIMO '
      
        '        (((df.Valortotal-df.ValorVista)*(pdf.quantidade*pdf.prec' +
        'ovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      
        '                  where sdf.dadofiscal = df.numero),0)),0),1))) ' +
        ' -'
      #9#9#9#9'  '
      '       -- DESCONTO '#9'   '
      
        '      ((coalesce(df.desconto,0)*(pdf.quantidade*pdf.precovenda))' +
        '  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      #9#9#9#9
      '       as ValorBrutodoProduto'
      '*/'#9'   '
      ''
      #9'   '
      ''
      '       from ((dadosfiscais df'
      '               join (produtosdadosfiscais pdf'
      '                     join (produtos p'
      '                           join (((caracteristicas c'
      '                                   join classes cl'
      '                                   on c.classe=cl.codigo)'
      ''
      '                                   join grupos g'
      '                                   on c.grupo = g.codigo)'
      ''
      '                                   join tiposproduto tp'
      '                                   on c.tipoproduto = tp.codigo)'
      ''
      '                           on p.caracteristica=c.codigo)'
      '                    on pdf.produto=p.codigo) '
      #9#9#9'   on df.numero = pdf.dadofiscal)'
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = df.filialvenda)'
      #9#9#9'   '
      #9#9#9'   '
      '       Where (df.data between (:datainicial) and (:datafinal))'
      '          and df.contrato is null'
      '          and df.situacao='#39'N'#39
      
        '          and ((eHNotaFiscalSaidaVenda(pdf.codigofiscal) and c.p' +
        'iscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')) or /* vendas */'
      
        #9#9'       (eHNotaFiscalSaidaDevolucao(pdf.codigofiscal) and c.pis' +
        'cst in ('#39'49'#39')))    /* devolu'#231#245'es de compras, conforme regra do s' +
        'ped */'
      '          and not coalesce(df.notavinculada,false)'
      '          and f.regimetributario <> 1  /* regime normal */'
      #9#9'  '
      ''
      '     )'
      ''
      '       union all'
      ''
      '     ('
      '         /* DEVOLUCOES COM CONTRATO */'
      ''
      '          select'
      ''
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      #9#9
      '           '
      '      /* VALOR BRUTO */'
      '      (((cd.valorvista + cd.desconto) +'
      '      /* ACRESCIMO*/'
      
        '       (cd.ValorPrazo-cd.ValorVista)) * coalesce(c.aliquotapis,0' +
        ')/100) as ValorBrutodoproduto'
      ''
      '          from ((contratosdevolvidos cd'
      '                 join (contratos ct'
      #9#9#9#9'       join filiais f'
      #9#9#9#9#9'   on ct.filialvenda = f.codigo)'
      '                 on cd.contrato=ct.numero)'
      ''
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      '                       on p.caracteristica=c.codigo)'
      '                 on cd.produto=p.codigo)'
      ''
      
        '          where cd.devolucao between(:DataInicial) and (:DataFin' +
        'al)'
      '            /* and cd.tipo = '#39'D'#39' */'
      
        '            and case when ct.os then ct.tipoequipamento in (1,2)' +
        ' and not (coalesce(ct.os_garantia,false) and ct.os_garantia_stat' +
        'us='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '            and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturad' +
        'as as outras entram pelas notas fiscais devido a cr'#233'ditos de tro' +
        'ca */'
      '            and f.regimetributario <> 1  /* regime normal */'
      #9#9#9'and c.piscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      #9'  '
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      #9'  '
      #9'  '
      '      ((pnp.quantidade * pnp.precounitario)'
      '      - coalesce(pnp.valordescontoitem,0)'
      '      - coalesce(pnp.desconto,0)'
      '      + coalesce(pnp.acrescimo,0)'
      '      + coalesce(pnp.frete,0)'
      '      + coalesce(pnp.seguro,0)'
      '      + coalesce(pnp.valoripi,0)'
      
        '      + coalesce(pnp.despesasacessorias,0)) * coalesce(c.aliquot' +
        'apis,0)/100'
      #9'   as ValorBrutodoProduto'
      #9'   '
      ''
      '     from ((notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      '                       on p.caracteristica=c.codigo)'
      '                 on pnp.produto=p.codigo) '
      #9#9'   on np.codigo = pnp.codigonota)'
      #9#9'   '
      '           join filiais f'
      #9'       on np.filial = f.codigo)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      #9'   and f.regimetributario <> 1  /* regime normal */'
      
        #9'   and c.piscst in ('#39'50'#39','#39'51'#39','#39'52'#39','#39'53'#39','#39'54'#39','#39'55'#39','#39'56'#39','#39'60'#39','#39'61' +
        #39','#39'62'#39','#39'63'#39','#39'64'#39','#39'65'#39','#39'66'#39')'
      ''
      '      )'
      ''
      ''
      '      union all'
      ''
      '      ('
      
        '         /* CONTRATOS CANCELADOS SEM CONTRATOS DEVOLVIDOS, TOTAL' +
        'MENTE CANCELADOS SEM PARCELAS PAGAS */'
      '          select'
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      #9#9#9#9
      '      /* VALOR BRUTO */'
      '      ((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '        (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)' +
        '-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                     coalesce((select  sum(sc.qu' +
        'antidade*coalesce(sc.valorservico,0))'
      '          from servicoscontratos sc'
      '          where sc.contrato = ct.numero),0)),0),1))'
      '        )) +'
      #9'  '
      '      /* ACRESCIMO */'
      #9'  '
      
        '       (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precove' +
        'nda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      '                  '
      #9#9#9' /*  DESCONTO */'
      
        '         ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)' +
        ')  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1)))) * ' +
        'coalesce(c.aliquotapis,0)/100) as ValorBrutodoProduto'
      #9'  '
      #9'  '
      '      from (select distinct ct.numero, p.datapagto'
      '            from contratos ct, parcelas p'
      '            where ct.numero=p.contrato '
      '         and ct.situacao='#39'C'#39' '
      '         and not exists (select p2.numero'
      '                             from parcelas p2'
      '                             where p2.contrato = ct.numero '
      '                   and p2.tipopagto<>'#39'E'#39') '
      '         and p.datapagto between :datainicial and :datafinal '
      '         and not exists (select cd.contrato'
      '                             from contratosdevolvidos cd'
      
        '                             where cd.contrato = ct.numero /*and' +
        ' cd.tipo='#39'D'#39'*/)'
      
        '             and case when ct.os then ct.tipoequipamento in (1,2' +
        ') and not (coalesce(ct.os_garantia,false) and ct.os_garantia_sta' +
        'tus='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '           ) as cancelados, ((contratos ct '
      '                             join (produtoscontratos pc'
      '                                   join (produtos p'
      
        '                                         join (((caracteristicas' +
        ' c'
      '                                                 join classes cl'
      
        '                                                 on c.classe = c' +
        'l.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      '                                                 join grupos g'
      
        '                                                 on c.grupo = g.' +
        'codigo)'
      ''
      
        '                                                join tiposprodut' +
        'o tp'
      
        '                                                on c.tipoproduto' +
        ' = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                         on p.caracteristica = c' +
        '.codigo)'
      '                                   on pc.produto=p.codigo)'
      '                             on pc.contrato = ct.numero)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' join filiais f'
      #9#9#9#9#9'         on ct.filialvenda = f.codigo)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' '
      '      where cancelados.numero = ct.numero'
      #9#9'and f.regimetributario <> 1  /* regime normal */'
      #9#9'and c.piscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      ''
      ''
      '      )'
      ''
      #9') as impostos'
      #9'       group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo,'
      '            grupo,'
      '            descricaoclasse,'
      '            classe'
      ''
      '   )'
      '   '
      '   union all'
      '   '
      '   ('
      '   '
      '   '
      '    /* IMPOSTOS - COFINS - REGIME NORMAL */'
      #9
      '     select impostos.tipoproduto,'
      
        '            cast('#39'IMPOSTOS - COFINS - '#39' as varchar)||cast(impost' +
        'os.descricaotipoproduto as varchar) as descricaotipoproduto,'
      '            impostos.grupo,'
      '            impostos.descricaogrupo,'
      '            impostos.classe,'
      '            impostos.descricaoclasse,'
      
        '            sum(impostos.ValorBrutodoProduto) as ValorBrutodoPro' +
        'duto '
      #9'from'#9#9
      #9
      #9'('
      #9
      '      ('
      
        '            /* VENDAS COM CONTRATO BRUTO + ACRESIMCO - DESCONTO ' +
        '*/'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      #9#9
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      '      -'#9' '
      '      /* VALOR BRUTO */'#9'  '
      '      ((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1)))) +'
      ''
      '      /* ACRESCIMO */'
      
        '        (((ValorPrazo-ValorVista)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '      /* DESCONTO */'
      
        '        ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1)))) * ' +
        'coalesce(c.aliquotacofins,0)/100)'
      #9#9#9#9'  '#9#9#9'  '
      '        as  ValorBrutodoProduto'
      ''
      ''
      '       from ((contratos ct'
      '             join (produtoscontratos pc'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9' '
      '                         on p.caracteristica=c.codigo)'
      '                   on pc.produto=p.codigo)'
      '             on ct.numero = pc.contrato)'
      #9#9#9' '
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = ct.filialvenda)'
      ''
      '       where not pc.brinde'
      
        '         and ct.faturamento between(:datainicial) and (:datafina' +
        'l)'
      '         and (coalesce(ct.valorvista,0)<>0)'
      '         and ct.origem is null'
      '         and f.regimetributario <> 1  /* regime normal */'
      #9#9' and c.cofinscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      #9#9' and coalesce(c.aliquotacofins,0)<>0'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      '        /* VENDAS SEM CONTRATO */'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      #9#9
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      #9#9'-'
      '       (((pdf.quantidade * pdf.precovenda)'
      '         - coalesce(pdf.valordescontoitem,0)'
      '         - coalesce(pdf.desconto,0)'
      '         + coalesce(pdf.acrescimo,0)'
      '         + coalesce(pdf.frete,0)'
      '         + coalesce(pdf.seguro,0)'
      '         + coalesce(pdf.valoripi,0)'
      
        '         + coalesce(pdf.despesasacessorias,0)) * coalesce(c.aliq' +
        'uotacofins,0)/100) as ValorBrutodoProduto'
      #9#9
      #9#9#9#9#9#9
      '/*'
      '       -- VALOR BRUTO '
      '      ((pdf.quantidade*pdf.precovenda) +'
      
        '        (((coalesce(df.valorfrete,0)+coalesce(df.seguro,0))*(pdf' +
        '.quantidade*pdf.precovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      '          where sdf.dadofiscal = df.numero),0)),0),1)))) +'
      #9#9'  '
      '       -- ACRESCIMO '
      
        '        (((df.Valortotal-df.ValorVista)*(pdf.quantidade*pdf.prec' +
        'ovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      
        '                  where sdf.dadofiscal = df.numero),0)),0),1))) ' +
        ' -'
      #9#9#9#9'  '
      '       -- DESCONTO '#9'   '
      
        '      ((coalesce(df.desconto,0)*(pdf.quantidade*pdf.precovenda))' +
        '  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      #9#9#9#9
      '       as ValorBrutodoProduto'
      '*/'#9'   '
      ''
      #9'   '
      ''
      '       from ((dadosfiscais df'
      '               join (produtosdadosfiscais pdf'
      '                     join (produtos p'
      '                           join (((caracteristicas c'
      '                                   join classes cl'
      '                                   on c.classe=cl.codigo)'
      ''
      '                                   join grupos g'
      '                                   on c.grupo = g.codigo)'
      ''
      '                                   join tiposproduto tp'
      '                                   on c.tipoproduto = tp.codigo)'
      ''
      '                           on p.caracteristica=c.codigo)'
      '                    on pdf.produto=p.codigo) '
      #9#9#9'   on df.numero = pdf.dadofiscal)'
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = df.filialvenda)'
      #9#9#9'   '
      #9#9#9'   '
      '       Where (df.data between (:datainicial) and (:datafinal))'
      '          and df.contrato is null'
      '          and df.situacao='#39'N'#39
      
        '          and ((eHNotaFiscalSaidaVenda(pdf.codigofiscal) and c.c' +
        'ofinscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')) or /* vendas */'
      
        #9#9'       (eHNotaFiscalSaidaDevolucao(pdf.codigofiscal) and c.cof' +
        'inscst in ('#39'49'#39')))    /* devolu'#231#245'es de compras, conforme regra d' +
        'o sped */'
      '          and not coalesce(df.notavinculada,false)'
      '          and f.regimetributario <> 1  /* regime normal */'
      #9#9'  '
      ''
      '     )'
      ''
      '       union all'
      ''
      '     ('
      '         /* DEVOLUCOES COM CONTRATO */'
      ''
      '          select'
      ''
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      #9#9
      '           '
      '      /* VALOR BRUTO */'
      '      (((cd.valorvista + cd.desconto) +'
      '      /* ACRESCIMO*/'
      
        '       (cd.ValorPrazo-cd.ValorVista)) * coalesce(c.aliquotacofin' +
        's,0)/100) as ValorBrutodoproduto'
      ''
      '          from ((contratosdevolvidos cd'
      '                 join (contratos ct'
      #9#9#9#9'       join filiais f'
      #9#9#9#9#9'   on ct.filialvenda = f.codigo)'
      '                 on cd.contrato=ct.numero)'
      ''
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      '                       on p.caracteristica=c.codigo)'
      '                 on cd.produto=p.codigo)'
      ''
      
        '          where cd.devolucao between(:DataInicial) and (:DataFin' +
        'al)'
      '            /* and cd.tipo = '#39'D'#39' */'
      
        '            and case when ct.os then ct.tipoequipamento in (1,2)' +
        ' and not (coalesce(ct.os_garantia,false) and ct.os_garantia_stat' +
        'us='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '            and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturad' +
        'as as outras entram pelas notas fiscais devido a cr'#233'ditos de tro' +
        'ca */'
      '            and f.regimetributario <> 1  /* regime normal */'
      #9#9#9'and c.cofinscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      #9'  '
      #9'  '
      '      ((pnp.quantidade * pnp.precounitario)'
      '      - coalesce(pnp.valordescontoitem,0)'
      '      - coalesce(pnp.desconto,0)'
      '      + coalesce(pnp.acrescimo,0)'
      '      + coalesce(pnp.frete,0)'
      '      + coalesce(pnp.seguro,0)'
      '      + coalesce(pnp.valoripi,0)'
      
        '      + coalesce(pnp.despesasacessorias,0)) * coalesce(c.aliquot' +
        'acofins,0)/100'
      #9'   as ValorBrutodoProduto'
      #9'   '
      ''
      '     from ((notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      '                       on p.caracteristica=c.codigo)'
      '                 on pnp.produto=p.codigo) '
      #9#9'   on np.codigo = pnp.codigonota)'
      #9#9'   '
      '           join filiais f'
      #9'       on np.filial = f.codigo)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      #9'   and f.regimetributario <> 1  /* regime normal */'
      
        #9'   and c.cofinscst in ('#39'50'#39','#39'51'#39','#39'52'#39','#39'53'#39','#39'54'#39','#39'55'#39','#39'56'#39','#39'60'#39',' +
        #39'61'#39','#39'62'#39','#39'63'#39','#39'64'#39','#39'65'#39','#39'66'#39')'
      ''
      '      )'
      ''
      ''
      '      union all'
      ''
      '      ('
      
        '         /* CONTRATOS CANCELADOS SEM CONTRATOS DEVOLVIDOS, TOTAL' +
        'MENTE CANCELADOS SEM PARCELAS PAGAS */'
      '          select'
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      #9#9#9#9
      '      /* VALOR BRUTO */'
      '      ((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '        (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)' +
        '-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                     coalesce((select  sum(sc.qu' +
        'antidade*coalesce(sc.valorservico,0))'
      '          from servicoscontratos sc'
      '          where sc.contrato = ct.numero),0)),0),1))'
      '        )) +'
      #9'  '
      '      /* ACRESCIMO */'
      #9'  '
      
        '       (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precove' +
        'nda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      '                  '
      #9#9#9' /*  DESCONTO */'
      
        '         ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)' +
        ')  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1)))) * ' +
        'coalesce(c.aliquotacofins,0)/100) as ValorBrutodoProduto'
      #9'  '
      #9'  '
      '      from (select distinct ct.numero, p.datapagto'
      '            from contratos ct, parcelas p'
      '            where ct.numero=p.contrato '
      '         and ct.situacao='#39'C'#39' '
      '         and not exists (select p2.numero'
      '                             from parcelas p2'
      '                             where p2.contrato = ct.numero '
      '                   and p2.tipopagto<>'#39'E'#39') '
      '         and p.datapagto between :datainicial and :datafinal '
      '         and not exists (select cd.contrato'
      '                             from contratosdevolvidos cd'
      
        '                             where cd.contrato = ct.numero /*and' +
        ' cd.tipo='#39'D'#39'*/)'
      
        '             and case when ct.os then ct.tipoequipamento in (1,2' +
        ') and not (coalesce(ct.os_garantia,false) and ct.os_garantia_sta' +
        'tus='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '           ) as cancelados, ((contratos ct '
      '                             join (produtoscontratos pc'
      '                                   join (produtos p'
      
        '                                         join (((caracteristicas' +
        ' c'
      '                                                 join classes cl'
      
        '                                                 on c.classe = c' +
        'l.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      '                                                 join grupos g'
      
        '                                                 on c.grupo = g.' +
        'codigo)'
      ''
      
        '                                                join tiposprodut' +
        'o tp'
      
        '                                                on c.tipoproduto' +
        ' = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                         on p.caracteristica = c' +
        '.codigo)'
      '                                   on pc.produto=p.codigo)'
      '                             on pc.contrato = ct.numero)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' join filiais f'
      #9#9#9#9#9'         on ct.filialvenda = f.codigo)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' '
      '      where cancelados.numero = ct.numero'
      #9#9'and f.regimetributario <> 1  /* regime normal */'
      #9#9'and c.cofinscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      ''
      ''
      '      )'
      ''
      #9') as impostos'
      #9'       group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo, grupo,'
      '            descricaoclasse, classe'
      ''
      '   )'
      ''
      '   '
      '  ) as dev'
      '       group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo, grupo, descricaoclasse, classe'
      ''
      ''
      ')'
      ''
      ') as sel'
      'where valorBrutodoProduto is not null'
      ''
      '   order by classificacao,  descricaoclassificacao,'
      '            tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo, grupo,'
      '            descricaoclasse, classe')
    RequestLive = False
    Left = 440
    Top = 360
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'Regime'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'AgruparGrupo'
        ParamType = ptUnknown
        Value = 'true'
      end
      item
        DataType = ftUnknown
        Name = 'AGruparClasse'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'datainicial'
        ParamType = ptUnknown
        Value = #39'2015-01-01'#39
      end
      item
        DataType = ftString
        Name = 'datafinal'
        ParamType = ptUnknown
        Value = #39'2015-01-31'#39
      end>
  end
  object qryReceita_Operacional_Bruta: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select sel.*'
      'from'
      '('
      ''
      '('
      '   /* VENDAS COM CONTRATOS */'
      '  select cast(1 as integer) as classificacao,'
      
        '         cast('#39'RECEITA OPERACIONAL BRUTA'#39' as varchar(50)) as des' +
        'cricaoclassificacao,'
      '         vp.tipoproduto,'
      '         vp.descricaotipoproduto,'
      '         vp.grupo,'
      '         vp.descricaogrupo,'
      '         vp.classe,'
      '         vp.descricaoclasse,'
      '         '
      '         vp.documento,'
      '         vp.data,'
      '         vp.cliente,'
      '         vp.tipocliente,'
      '         vp.nomecliente,'
      '         '
      '         sum(vp.ValorBrutodoProduto) as ValorBrutodoProduto'
      '  from'
      '  ('
      '    ('
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      ''
      
        '      case when :AgruparGrupo  then c.grupo      else cast(null ' +
        'as varchar(4))  end as grupo,'
      
        '      case when :AgruparGrupo  then g.descricao  else cast(null ' +
        'as varchar(30)) end as descricaogrupo,'
      
        '      case when :AGruparClasse then c.classe     else cast(null ' +
        'as varchar(2))  end as classe,'
      
        '      case when :AGruparClasse then cl.descricao else cast(null ' +
        'as varchar(30)) end as descricaoclasse,'
      '      '
      '      cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '      ct.faturamento as data,'
      '      ct.cliente,'
      '      ct.tipocliente,'
      '      ct.nome as nomecliente,'
      '      '
      ''
      '      ((pc.quantidade*pc.precovenda) +'
      '                coalesce(pc.frete,0) +'
      '               coalesce(pc.seguro,0) +'
      '           coalesce(pc.acrescimo,0)) as  ValorBrutodoProduto'
      ''
      ''
      '     from (contratos ct'
      '           join (produtoscontratos pc'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on pc.produto=p.codigo)'
      '           on ct.numero = pc.contrato)'
      ''
      '     where not pc.brinde and'
      
        '               ct.faturamento between(:datainicial) and (:datafi' +
        'nal) and'
      '               (coalesce(ct.valorvista,0)<>0) and'
      '               ct.origem is null'
      ''
      '    )'
      '    union all'
      '    ('
      '      /* VENDAS SEM CONTRATO */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      
        '      case when :AgruparGrupo then c.grupo     else cast(null as' +
        ' varchar(4)) end as grupo,'
      
        '      case when :AgruparGrupo then g.descricao else cast(null as' +
        ' varchar(30)) end as descricaogrupo,'
      
        '      case when :AGruparClasse then c.classe    else cast(null a' +
        's varchar(2)) end as classe,'
      
        '      case when :AGruparClasse then cl.descricao else cast(null ' +
        'as varchar(30)) end as descricaoclasse,'
      '      '
      '      case when n.dadofiscal is not null then'
      '        cast('#39'NF '#39'||n.numero||'#39' S'#233'rie '#39'||n.serie as varchar(30))'
      '      else'
      
        '        cast('#39'CF '#39'||cp.numero||'#39' Mq. '#39'||cp.maquina||'#39' Int.'#39'||cp.' +
        'intervensao as varchar(30))'
      '      end as documento,'
      '      df.data,'
      '      df.cliente,'
      '      df.tipocliente,'
      '      df.nome as nomecliente,'
      '      '
      ''
      '      ((pdf.quantidade*pdf.precovenda) +'
      '                 coalesce(pdf.frete,0) +'
      '                coalesce(pdf.seguro,0) +'
      
        '                coalesce(pdf.acrescimo,0)) as ValorBrutodoProdut' +
        'o'
      ''
      ''
      '      from (dadosfiscais df'
      '             join (produtosdadosfiscais pdf'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      ''
      '                         on p.caracteristica=c.codigo)'
      
        '             on pdf.produto=p.codigo) on df.numero = pdf.dadofis' +
        'cal)'
      '             '
      '             left join notas n on df.numero = n.dadofiscal'
      '             left join cupons cp on df.numero = cp.dadofiscal'
      ''
      
        '      Where (df.data between (:datainicial) and (:datafinal)) an' +
        'd df.contrato is null'
      '              and df.situacao='#39'N'#39
      '              and eHNotaFiscalSaidaVenda(pdf.codigofiscal)'
      '        and not coalesce(df.notavinculada,false)'
      ''
      ''
      '    )'
      '  )  as vp'
      '     group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo,'
      '            grupo,'
      '            descricaoclasse,'
      '            classe,'
      ''
      '         vp.data,'
      '         vp.documento,'
      '         vp.cliente,'
      '         vp.tipocliente,'
      '         vp.nomecliente'
      ''
      '            '
      ''
      ''
      ')'
      ''
      '  union all'
      ''
      '('
      '    select'
      ''
      '      cast(1 as integer) as classificacao,'
      
        '      cast('#39'RECEITA OPERACIONAL BRUTA'#39' as varchar(50)) as descri' +
        'caoclassificacao,'
      ''
      '      cast('#39'09'#39' as varchar(2)) as tipoproduto,'
      
        '      (select tp.descricao from tiposproduto tp where tp.codigo ' +
        '= '#39'09'#39') as descricaotipoproduto,'
      ''
      #9'  '
      
        #9'  case when :AgruparGrupo then cast('#39'SE'#39' as varchar(4))        ' +
        'else cast(null as varchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then cast('#39'SERVICOS'#39' as varchar(30)) ' +
        'else cast(null as varchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then cast('#39'SE'#39' as varchar(02))      ' +
        ' else cast(null as varchar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cast('#39'SERVICOS'#39' as varchar(30))' +
        ' else cast(null as varchar(30)) end as descricaoclasse,'
      '      '
      '      cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '      ct.faturamento as data,'
      '      ct.cliente,'
      '      ct.tipocliente,'
      '      ct.nome as nomecliente,'
      '      '
      ''
      
        '      sum(round((coalesce(sc.quantidade,0)*coalesce(sc.valorserv' +
        'ico,0)),2)) as valorBrutodoProduto'
      ''
      '   from (contratos ct'
      ''
      '                              join servicoscontratos sc'
      
        '                                                                ' +
        '        on ct.numero = sc.contrato)'
      '   where ct.faturamento between(:DataInicial) and (:DataFinal)'
      ''
      
        '   group by ct.numero, ct.faturamento, ct.cliente, ct.tipoclient' +
        'e, ct.nome'
      ''
      ')'
      ''
      'union all'
      ''
      ''
      '('
      '  select cast(2 as integer) as classificacao,'
      
        '        cast('#39'(-) DEDU'#199#213'ES DA RECEITA BRUTA'#39' as varchar(50)) as ' +
        'descricaoclassificacao,'
      '        dev.tipoproduto,'
      '        dev.descricaotipoproduto,'
      '        dev.grupo,'
      '        dev.descricaogrupo,'
      '        dev.classe,'
      '        dev.descricaoclasse,'
      '        '
      '        dev.documento,'
      '        dev.data,'
      '        dev.cliente,'
      '        dev.tipocliente,'
      '        dev.nomecliente,'
      '        '
      '        sum(dev.ValorBrutodoproduto) as ValorBrutodoproduto'
      '  from'
      '  ('
      ''
      '    ('
      ''
      '       /* CONTRATOS FATURADOS DEVOLVIDOS */'
      '        select'
      ''
      '        c.tipoproduto,'
      
        '        cast('#39'DEVOLU'#199#213'ES - '#39' as varchar)||cast(tp.descricao as v' +
        'archar) as descricaotipoproduto,'
      #9#9
      
        '  '#9'    case when :AgruparGrupo then c.grupo     else cast(null a' +
        's varchar(4)) end as grupo,'
      
        #9'    case when :AgruparGrupo then g.descricao else cast(null as ' +
        'varchar(30)) end as descricaogrupo,'
      
        #9'    case when :AGruparClasse then c.classe    else cast(null as' +
        ' varchar(2)) end as classe,'
      
        #9'    case when :AGruparClasse then cl.descricao else cast(null a' +
        's varchar(30)) end as descricaoclasse,'
      '        '
      '        cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '        ct.faturamento as data,'
      '        ct.cliente,'
      '        ct.tipocliente,'
      '        ct.nome as nomecliente,'
      ''
      '        -'
      #9#9'/* VALOR BRUTO */'
      #9#9'((cd.valorvista + cd.desconto) +'
      #9#9'/* ACRESCIMO*/'
      #9#9' (cd.ValorPrazo-cd.ValorVista))'
      #9#9'as ValorBrutodoproduto'
      ''
      '        from ((contratosdevolvidos cd'
      '               join contratos ct'
      '               on cd.contrato=ct.numero)'
      ''
      '               join (produtos p'
      '                     join (((caracteristicas c'
      '                             join classes cl'
      '                             on c.classe=cl.codigo)'
      ''
      '                             join grupos g'
      '                             on c.grupo = g.codigo)'
      ''
      '                             join tiposproduto tp'
      '                             on c.tipoproduto = tp.codigo)'
      ''
      '                     on p.caracteristica=c.codigo)'
      '               on cd.produto=p.codigo)'
      ''
      
        '        where cd.devolucao between(:DataInicial) and (:DataFinal' +
        ')'
      '          /* and cd.tipo = '#39'D'#39' */'
      
        '          and case when ct.os then ct.tipoequipamento in (1,2) a' +
        'nd not (coalesce(ct.os_garantia,false) and ct.os_garantia_status' +
        '='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '          and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturadas' +
        ' as outras entram pelas notas fiscais devido a cr'#233'ditos de troca' +
        ' */'
      ''
      '    )'
      ''
      ''
      '    union all'
      ''
      '    ('
      '        /* CONTRATOS FATURADOS TOTALMENTE CANCELADOS  */'
      '        select'
      '        c.tipoproduto,'
      
        #9#9'    cast('#39'DEVOLU'#199#213'ES - '#39' as varchar)||cast(tp.descricao as var' +
        'char) as descricaotipoproduto,'
      ''
      
        #9'    case when :AgruparGrupo then c.grupo     else cast(null as ' +
        'varchar(4)) end as grupo,'
      
        #9'    case when :AgruparGrupo then g.descricao else cast(null as ' +
        'varchar(30)) end as descricaogrupo,'
      
        #9'    case when :AGruparClasse then c.classe    else cast(null as' +
        ' varchar(2)) end as classe,'
      
        #9'    case when :AGruparClasse then cl.descricao else cast(null a' +
        's varchar(30)) end as descricaoclasse,'
      '        '
      '        cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '        ct.faturamento as data,'
      '        ct.cliente,'
      '        ct.tipocliente,'
      '        ct.nome as nomecliente,       '
      ''
      '            -'
      '            ((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      '            ) as  ValorBrutodoProduto'
      ''
      #9'     /*'
      '      -'
      #9'   VALOR BRUTO'
      ''
      #9'  (((pc.quantidade*pc.precovenda) +'
      
        '      (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quantid' +
        'ade*pc.precovenda))  /'
      
        '      (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-c' +
        'oalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                   coalesce((select  sum(sc.quan' +
        'tidade*coalesce(sc.valorservico,0))'
      '        from servicoscontratos sc'
      '        where sc.contrato = ct.numero),0)),0),1))'
      '      )) +'
      ''
      #9'   ACRESCIMO'
      ''
      
        #9'   (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precovenda' +
        '))  /'
      
        '       (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-' +
        'coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '               coalesce((select  sum(sc.quantidade*coalesce(sc.v' +
        'alorservico,0))'
      '                from servicoscontratos sc'
      '                where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      #9#9' DESCONTO'
      
        '       ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)) ' +
        ' /'
      
        '       (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-' +
        'coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '               coalesce((select  sum(sc.quantidade*coalesce(sc.v' +
        'alorservico,0))'
      '                from servicoscontratos sc'
      '                where sc.contrato = ct.numero),0)),0),1))))'
      ''
      #9'  as ValorBrutodoProduto'
      ''
      '          */'
      ''
      ''
      '    from (select distinct ct.numero, p.datapagto'
      '          from contratos ct, parcelas p'
      '          where ct.numero=p.contrato '
      #9#9'   and ct.situacao='#39'C'#39' '
      #9#9'   and not exists (select p2.numero'
      '                           from parcelas p2'
      '                           where p2.contrato = ct.numero '
      #9#9#9#9#9#9'     and p2.tipopagto<>'#39'E'#39') '
      #9#9'   and p.datapagto between :datainicial and :datafinal '
      #9#9'   and not exists (select cd.contrato'
      '                           from contratosdevolvidos cd'
      
        '                           where cd.contrato = ct.numero /*and c' +
        'd.tipo='#39'D'#39'*/ )'
      
        '           and case when ct.os then ct.tipoequipamento in (1,2) ' +
        'and not (coalesce(ct.os_garantia,false) and ct.os_garantia_statu' +
        's='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '         ) as cancelados, (contratos ct '
      #9#9'                   join (produtoscontratos pc'
      #9#9#9#9#9#9'         join (produtos p'
      #9#9#9#9#9#9#9#9'       join (((caracteristicas c'
      #9#9#9#9#9#9#9#9#9'           join classes cl'
      #9#9#9#9#9#9#9#9#9#9#9'   on c.classe = cl.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9#9#9#9#9'  join grupos g'
      #9#9#9#9#9#9#9#9#9#9#9'  on c.grupo = g.codigo)'
      ''
      #9#9#9#9#9#9#9#9#9#9#9' join tiposproduto tp'
      #9#9#9#9#9#9#9#9#9#9#9' on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                       on p.caracteristica = c.c' +
        'odigo)'
      '                                 on pc.produto=p.codigo)'
      '                           on pc.contrato = ct.numero)'
      '    where cancelados.numero = ct.numero'
      #9#9
      ''
      '    )'
      ''
      '    union all'
      ''
      '    ('
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      
        '      cast('#39'DEVOLU'#199#213'ES - '#39' as varchar)||cast(tp.descricao as var' +
        'char) as descricaotipoproduto,'
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '        cast('#39'NF '#39'||np.numero as varchar(30)) as documento,'
      '        np.data,'
      '        np.fornecedor as cliente,'
      '        np.tipofornecedor as tipocliente,'
      '        np.nome as nomecliente,'
      '      '
      ''
      '      -'
      '      ((pnp.quantidade * pnp.precounitario)'
      '      - coalesce(pnp.valordescontoitem,0)'
      '      - coalesce(pnp.desconto,0)'
      '      + coalesce(pnp.acrescimo,0)'
      '      + coalesce(pnp.frete,0)'
      '      + coalesce(pnp.seguro,0)'
      '      + coalesce(pnp.valoripi,0)'
      '      + coalesce(pnp.icmsvalorst,0)'
      '      + coalesce(pnp.despesasacessorias,0))'
      #9'   as ValorBrutodoProduto'
      ''
      '     from (notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      
        '           on pnp.produto=p.codigo) on np.codigo = pnp.codigonot' +
        'a)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      ''
      '    )'
      ''
      #9'union all'
      ''
      ''
      '    ('
      ''
      '       /* DESCONTOS DE VENDAS COM CONTRATO */'
      ''
      '      select'
      '      c.tipoproduto,'
      
        #9'  cast('#39'DESCONTOS - '#39' as varchar)||cast(tp.descricao as varchar' +
        ') as descricaotipoproduto,'
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '        cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '        ct.faturamento as data,'
      '        ct.cliente,'
      '        ct.tipocliente,'
      '        ct.nome as nomecliente,       '
      '      '
      ''
      '          - pc.descontogeral as ValorBrutodoProduto'
      ''
      '          /*'
      '      -'
      ''
      #9'  ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))  /'
      
        '       (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-' +
        'coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '               coalesce((select  sum(sc.quantidade*coalesce(sc.v' +
        'alorservico,0))'
      '                from servicoscontratos sc'
      '                where sc.contrato = ct.numero),0)),0),1)))'
      ''
      #9'  as  ValorBrutodoProduto'
      '          */'
      ''
      ''
      '     from (contratos ct'
      '           join (produtoscontratos pc'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on pc.produto=p.codigo)'
      '           on ct.numero = pc.contrato)'
      ''
      '     where not pc.brinde and'
      
        '               ct.faturamento between(:datainicial) and (:datafi' +
        'nal) and'
      '               (coalesce(ct.valorvista,0)<>0) and'
      '               ct.origem is null and'
      #9#9#9'   coalesce(ct.desconto,0)<>0'
      ''
      '    )'
      '    union all'
      '    ('
      '       /* DESCONTOS DE VENDAS SEM CONTRATO */'
      ''
      '      select'
      '      c.tipoproduto,'
      
        '      cast('#39'DESCONTOS - '#39' as varchar)||cast(tp.descricao as varc' +
        'har) as descricaotipoproduto,'
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '      case when n.dadofiscal is not null then'
      '        cast('#39'NF '#39'||n.numero||'#39' S'#233'rie '#39'||n.serie as varchar(30))'
      '      else'
      
        '        cast('#39'CF '#39'||cp.numero||'#39' Mq. '#39'||cp.maquina||'#39' Int.'#39'||cp.' +
        'intervensao as varchar(30))'
      '      end as documento,'
      '      df.data,'
      '      df.cliente,'
      '      df.tipocliente,'
      '      df.nome as nomecliente,'
      '      '
      ''
      ''
      
        '      - (coalesce(pdf.desconto,0) + coalesce(pdf.valordescontoit' +
        'em,0)) as ValorBrutodoProduto'
      ''
      '      /*'
      '      -'
      
        '      ((coalesce(df.desconto,0)*(pdf.quantidade*pdf.precovenda))' +
        '  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      #9'   as ValorBrutodoProduto'
      '           */'
      ''
      ''
      '      from (dadosfiscais df'
      '             join (produtosdadosfiscais pdf'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      ''
      '                         on p.caracteristica=c.codigo)'
      
        '             on pdf.produto=p.codigo) on df.numero = pdf.dadofis' +
        'cal)'
      '             '
      '             left join notas n on df.numero = n.dadofiscal'
      '             left join cupons cp on df.numero = cp.dadofiscal'
      '             '
      ''
      
        '      Where (df.data between (:datainicial) and (:datafinal)) an' +
        'd df.contrato is null'
      '              and df.situacao='#39'N'#39
      '              and eHNotaFiscalSaidaVenda(pdf.codigofiscal)'
      '        and not coalesce(df.notavinculada,false) and'
      #9#9#9'   coalesce(df.desconto,0)<>0'
      ''
      ''
      '    )'
      ''
      #9#9'union all'
      ''
      ''
      #9'('
      ''
      #9'  /* IMPOSTOS - REGIME SIMPLES */'
      ''
      '     select impostos.tipoproduto,'
      
        '            cast('#39'IMPOSTOS - '#39' as varchar)||cast(impostos.descri' +
        'caotipoproduto as varchar) as descricaotipoproduto,'
      '            impostos.grupo,'
      '            impostos.descricaogrupo,'
      '            impostos.classe,'
      '            impostos.descricaoclasse,'
      '            '
      '            impostos.documento,'
      '            impostos.data,'
      '            impostos.cliente,'
      '            impostos.tipocliente,'
      '            impostos.nomecliente,       '
      '            '
      
        '            - sum(case when coalesce(impostos.aliquotaicmssn,0) ' +
        '= 0 then 0  else impostos.ValorBrutodoProduto * impostos.aliquot' +
        'aicmssn / 100 end) as ValorBrutodoProduto'
      #9'from'
      ''
      #9'('
      ''
      '      ('
      
        '            /* VENDAS COM CONTRATO BRUTO + ACRESIMCO - DESCONTO ' +
        '*/'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      ''
      
        '  '#9'    case when :AgruparGrupo then c.grupo     else cast(null a' +
        's varchar(4)) end as grupo,'
      
        #9'    case when :AgruparGrupo then g.descricao else cast(null as ' +
        'varchar(30)) end as descricaogrupo,'
      
        #9'    case when :AGruparClasse then c.classe    else cast(null as' +
        ' varchar(2)) end as classe,'
      
        #9'    case when :AGruparClasse then cl.descricao else cast(null a' +
        's varchar(30)) end as descricaoclasse,'
      '        '
      '        cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '        ct.faturamento as data,'
      '        ct.cliente,'
      '        ct.tipocliente,'
      '        ct.nome as nomecliente,'
      ''
      ''
      '      (select asn.aliquotaicms'
      '       from aliquotassimplesnacional asn'
      '         where asn.filial = ct.filialvenda'
      
        '         and asn.mesano = to_char(ct.faturamento, '#39'mm/yyyy'#39'))  a' +
        's aliquotaicmssn,'
      ''
      '            ((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      '            ) as  ValorBrutodoProduto'
      ''
      '            /*'
      ''
      '       VALOR BRUTO'
      '      ((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1)))) +'
      ''
      '       ACRESCIMO'
      
        '        (((ValorPrazo-ValorVista)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      
        '        ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1)))'
      ''
      '        as  ValorBrutodoProduto'
      ''
      '        */'
      ''
      ''
      '       from (contratos ct'
      '             join (produtoscontratos pc'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      ''
      '                         on p.caracteristica=c.codigo)'
      '                   on pc.produto=p.codigo)'
      '             on ct.numero = pc.contrato)'
      ''
      '       where not pc.brinde'
      
        '         and ct.faturamento between(:datainicial) and (:datafina' +
        'l)'
      '         and (coalesce(ct.valorvista,0)<>0)'
      '         and ct.origem is null'
      
        '         and (select f.regimetributario from filiais f where f.c' +
        'odigo = ct.filialvenda)=1  /* simples nacional*/'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      '        /* VENDAS SEM CONTRATO */'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      #9#9
      
        #9'    case when :AgruparGrupo then c.grupo     else cast(null as ' +
        'varchar(4)) end as grupo,'
      
        #9'    case when :AgruparGrupo then g.descricao else cast(null as ' +
        'varchar(30)) end as descricaogrupo,'
      
        #9'    case when :AGruparClasse then c.classe    else cast(null as' +
        ' varchar(2)) end as classe,'
      
        #9'    case when :AGruparClasse then cl.descricao else cast(null a' +
        's varchar(30)) end as descricaoclasse,'
      '        '
      '      case when n.dadofiscal is not null then'
      '        cast('#39'NF '#39'||n.numero||'#39' S'#233'rie '#39'||n.serie as varchar(30))'
      '      else'
      
        '        cast('#39'CF '#39'||cp.numero||'#39' Mq. '#39'||cp.maquina||'#39' Int.'#39'||cp.' +
        'intervensao as varchar(30))'
      '      end as documento,'
      '      df.data,'
      '      df.cliente,'
      '      df.tipocliente,'
      '      df.nome as nomecliente,'
      '        '
      #9#9
      ''
      '      (select asn.aliquotaicms'
      '       from aliquotassimplesnacional asn'
      '         where asn.filial = df.filialvenda'
      
        '         and asn.mesano = to_char(df.data, '#39'mm/yyyy'#39'))  as aliqu' +
        'otaicmssn,'
      ''
      ''
      ''
      '      ((pdf.quantidade*pdf.precovenda) +'
      '                 coalesce(pdf.frete,0) +'
      '                coalesce(pdf.seguro,0) +'
      '             coalesce(pdf.acrescimo,0) -'
      ''
      '              coalesce(pdf.desconto,0) -'
      '      coalesce(pdf.valordescontoitem,0)'
      ''
      '      ) as ValorBrutodoProduto'
      ''
      ''
      '      /*'
      ''
      '          VALOR BRUTO'
      ''
      '      ((pdf.quantidade*pdf.precovenda) +'
      
        '        (((coalesce(df.valorfrete,0)+coalesce(df.seguro,0))*(pdf' +
        '.quantidade*pdf.precovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      '          where sdf.dadofiscal = df.numero),0)),0),1)))) +'
      ''
      '        ACRESCIMO'
      ''
      
        '        (((df.Valortotal-df.ValorVista)*(pdf.quantidade*pdf.prec' +
        'ovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      
        '                  where sdf.dadofiscal = df.numero),0)),0),1))) ' +
        ' -'
      ''
      '        DESCONTO'
      ''
      
        '      ((coalesce(df.desconto,0)*(pdf.quantidade*pdf.precovenda))' +
        '  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      ''
      ''
      '       as ValorBrutodoProduto'
      ''
      '       */'
      ''
      '        from (dadosfiscais df'
      '               join (produtosdadosfiscais pdf'
      '                     join (produtos p'
      '                           join (((caracteristicas c'
      '                                   join classes cl'
      '                                   on c.classe=cl.codigo)'
      ''
      '                                   join grupos g'
      '                                   on c.grupo = g.codigo)'
      ''
      '                                   join tiposproduto tp'
      '                                   on c.tipoproduto = tp.codigo)'
      ''
      '                           on p.caracteristica=c.codigo)'
      
        '               on pdf.produto=p.codigo) on df.numero = pdf.dadof' +
        'iscal)'
      '               '
      '             left join notas n on df.numero = n.dadofiscal'
      '             left join cupons cp on df.numero = cp.dadofiscal'
      '               '
      ''
      '        Where (df.data between (:datainicial) and (:datafinal))'
      '          and df.contrato is null'
      '          and df.situacao='#39'N'#39
      '          and eHNotaFiscalSaidaVenda(pdf.codigofiscal)'
      '          and not coalesce(df.notavinculada,false)'
      
        '          and (select f.regimetributario from filiais f where f.' +
        'codigo = df.filialvenda)=1  /* simples nacional*/'
      ''
      ''
      '     )'
      ''
      '       union all'
      ''
      '     ('
      '         /* DEVOLUCOES COM CONTRATO */'
      ''
      '          select'
      ''
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        '  '#9'      case when :AgruparGrupo then c.grupo     else cast(null' +
        ' as varchar(4)) end as grupo,'
      
        #9'      case when :AgruparGrupo then g.descricao else cast(null a' +
        's varchar(30)) end as descricaogrupo,'
      
        #9'      case when :AGruparClasse then c.classe    else cast(null ' +
        'as varchar(2)) end as classe,'
      
        #9'      case when :AGruparClasse then cl.descricao else cast(null' +
        ' as varchar(30)) end as descricaoclasse,'
      '          '
      '          cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '          ct.faturamento as data,'
      '          ct.cliente,'
      '          ct.tipocliente,'
      '          ct.nome as nomecliente,          '
      #9#9'  '
      '      (select asn.aliquotaicms'
      '       from aliquotassimplesnacional asn'
      '         where asn.filial = ct.filialvenda'
      
        '         and asn.mesano = to_char(cd.devolucao, '#39'mm/yyyy'#39'))  as ' +
        'aliquotaicmssn,'
      #9#9
      #9#9
      '          - '
      '      /* VALOR BRUTO */'
      '      ((cd.valorvista + cd.desconto) +'
      '      /* ACRESCIMO*/'
      '       (cd.ValorPrazo-cd.ValorVista))'
      '      as ValorBrutodoproduto'
      ''
      '          from ((contratosdevolvidos cd'
      '                 join contratos ct'
      '                 on cd.contrato=ct.numero)'
      ''
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on cd.produto=p.codigo)'
      ''
      
        '          where cd.devolucao between(:DataInicial) and (:DataFin' +
        'al)'
      '            /* and cd.tipo = '#39'D'#39' */'
      
        '            and case when ct.os then ct.tipoequipamento in (1,2)' +
        ' and not (coalesce(ct.os_garantia,false) and ct.os_garantia_stat' +
        'us='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '            and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturad' +
        'as as outras entram pelas notas fiscais devido a cr'#233'ditos de tro' +
        'ca */'
      
        '            and (select f.regimetributario from filiais f where ' +
        'f.codigo = ct.filialvenda)=1  /* simples nacional*/'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      ''
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '        cast('#39'NF '#39'||np.numero as varchar(30)) as documento,'
      '        np.data,'
      '        np.fornecedor as cliente,'
      '        np.tipofornecedor as tipocliente,'
      '        np.nome as nomecliente,'
      '      '
      ''
      '            (select asn.aliquotaicms'
      '       from aliquotassimplesnacional asn'
      '         where asn.filial = np.filial'
      
        '         and asn.mesano = to_char(np.data, '#39'mm/yyyy'#39'))  as aliqu' +
        'otaicmssn,'
      ''
      ''
      '      -'
      '      ((pnp.quantidade * pnp.precounitario)'
      '      - coalesce(pnp.valordescontoitem,0)'
      '      - coalesce(pnp.desconto,0)'
      '      + coalesce(pnp.acrescimo,0)'
      '      + coalesce(pnp.frete,0)'
      '      + coalesce(pnp.seguro,0)'
      '      + coalesce(pnp.valoripi,0)'
      '      + coalesce(pnp.icmsvalorst,0)'
      '      + coalesce(pnp.despesasacessorias,0))'
      #9'   as ValorBrutodoProduto'
      ''
      '     from (notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      
        '           on pnp.produto=p.codigo) on np.codigo = pnp.codigonot' +
        'a)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      
        '       and (select f.regimetributario from filiais f where f.cod' +
        'igo = np.filial)=1  /* simples nacional*/'
      ''
      ''
      '      )'
      ''
      ''
      '      union all'
      ''
      '      ('
      
        '         /* CONTRATOS CANCELADOS SEM CONTRATOS DEVOLVIDOS, TOTAL' +
        'MENTE CANCELADOS SEM PARCELAS PAGAS */'
      '          select'
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      ''
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '      cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '      ct.faturamento as data,'
      '      ct.cliente,'
      '      ct.tipocliente,'
      '      ct.nome as nomecliente,'
      '      '
      ''
      '      (select asn.aliquotaicms'
      '         from aliquotassimplesnacional asn'
      '           where asn.filial = ct.filialvenda'
      
        '           and asn.mesano = to_char(cancelados.datapagto, '#39'mm/yy' +
        'yy'#39'))  as aliquotaicmssn,'
      ''
      ''
      '            -'
      '            ((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      '            ) as  ValorBrutodoProduto'
      ''
      '        /*'
      '        -'
      '       VALOR BRUTO'
      '      (((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '        (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)' +
        '-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                     coalesce((select  sum(sc.qu' +
        'antidade*coalesce(sc.valorservico,0))'
      '          from servicoscontratos sc'
      '          where sc.contrato = ct.numero),0)),0),1))'
      '        )) +'
      ''
      '       ACRESCIMO'
      ''
      
        '       (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precove' +
        'nda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      ''
      
        '         ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)' +
        ')  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))))'
      ''
      '      as ValorBrutodoProduto'
      ''
      '      */'
      ''
      ''
      '      from (select distinct ct.numero, p.datapagto'
      '            from contratos ct, parcelas p'
      '            where ct.numero=p.contrato '
      '         and ct.situacao='#39'C'#39' '
      '         and not exists (select p2.numero'
      '                             from parcelas p2'
      '                             where p2.contrato = ct.numero '
      '                   and p2.tipopagto<>'#39'E'#39') '
      '         and p.datapagto between :datainicial and :datafinal '
      '         and not exists (select cd.contrato'
      '                             from contratosdevolvidos cd'
      
        '                             where cd.contrato = ct.numero /*and' +
        ' cd.tipo='#39'D'#39'*/)'
      
        '             and case when ct.os then ct.tipoequipamento in (1,2' +
        ') and not (coalesce(ct.os_garantia,false) and ct.os_garantia_sta' +
        'tus='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '           ) as cancelados, (contratos ct '
      '                         join (produtoscontratos pc'
      '                       join (produtos p'
      '                         join (((caracteristicas c'
      '                               join classes cl'
      '                           on c.classe = cl.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      '                          join grupos g'
      '                          on c.grupo = g.codigo)'
      ''
      '                         join tiposproduto tp'
      '                         on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                         on p.caracteristica = c' +
        '.codigo)'
      '                                   on pc.produto=p.codigo)'
      '                             on pc.contrato = ct.numero)'
      '      where cancelados.numero = ct.numero'
      
        '        and (select f.regimetributario from filiais f where f.co' +
        'digo = ct.filialvenda)=1  /* simples nacional*/'
      ''
      ''
      '      )'
      ''
      #9') as impostos'
      #9'       group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo,'
      '            grupo,'
      '            descricaoclasse,'
      '            classe,'
      #9#9#9'aliquotaicmssn,'
      ''
      '            impostos.documento,'
      '            impostos.data,'
      '            impostos.cliente,'
      '            impostos.tipocliente,'
      '            impostos.nomecliente'
      ''
      ''
      '   )'
      '   '
      '   union all'
      '   '
      '   '
      '  ('
      '  '
      '    /* IMPOSTOS - ICMS - REGIME NORMAL */'
      #9
      '     select impostos.tipoproduto,'
      
        '            cast('#39'IMPOSTOS - ICMS - '#39' as varchar)||cast(impostos' +
        '.descricaotipoproduto as varchar) as descricaotipoproduto,'
      '            impostos.grupo,'
      '            impostos.descricaogrupo,'
      '            impostos.classe,'
      '            impostos.descricaoclasse,'
      '            '
      '            impostos.documento,'
      '            impostos.data,'
      '            impostos.cliente,'
      '            impostos.tipocliente,'
      '            impostos.nomecliente,                   '
      '            '
      
        '            sum(impostos.ValorBrutodoProduto) as ValorBrutodoPro' +
        'duto '
      #9'from'#9#9
      #9
      #9'('
      #9
      '      ('
      
        '            /* VENDAS COM CONTRATO  BRUTO + ACRESIMCO - DESCONTO' +
        ' */'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '        cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '        ct.faturamento as data,'
      '        ct.cliente,'
      '        ct.tipocliente,'
      '        ct.nome as nomecliente,       '
      '      '
      ''
      '        -'
      '          (((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      
        '            ) * Selecionar_Aliquotaicms(f.estado, ct.estado, ct.' +
        'pessoatipo, p.codigo)/100) as  ValorBrutodoProduto'
      ''
      '        /*'
      '      -'
      '       VALOR BRUTO'
      '      (((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1)))) +'
      ''
      '       ACRESCIMO'
      
        '        (((ValorPrazo-ValorVista)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      
        '        ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1))))*(1' +
        '-coalesce(c.percreducaobase,0)/100)) *'
      ''
      
        '                  Selecionar_Aliquotaicms(f.estado, ct.estado, c' +
        't.pessoatipo, p.codigo)/100)'
      '        as  ValorBrutodoProduto'
      ''
      '        */'
      ''
      ''
      '       from ((contratos ct'
      '             join (produtoscontratos pc'
      '                   join (produtos p'
      '                         join ((((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9#9' join tributosicms ti'
      #9#9#9#9#9#9#9#9' on c.incidencia = ti.codigo)'
      ''
      '                         on p.caracteristica=c.codigo)'
      '                   on pc.produto=p.codigo)'
      '             on ct.numero = pc.contrato)'
      #9#9#9' '
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = ct.filialvenda)'
      ''
      '       where not pc.brinde'
      
        '         and ct.faturamento between(:datainicial) and (:datafina' +
        'l)'
      '         and (coalesce(ct.valorvista,0)<>0)'
      '         and ct.origem is null'
      '         and f.regimetributario <> 1  /* regime normal */'
      #9#9' and ti.valor in ('#39'00'#39','#39'20'#39')'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      '        /* VENDAS SEM CONTRATO */'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      #9#9
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '      case when n.dadofiscal is not null then'
      '        cast('#39'NF '#39'||n.numero||'#39' S'#233'rie '#39'||n.serie as varchar(30))'
      '      else'
      
        '        cast('#39'CF '#39'||cp.numero||'#39' Mq. '#39'||cp.maquina||'#39' Int.'#39'||cp.' +
        'intervensao as varchar(30))'
      '      end as documento,'
      '      df.data,'
      '      df.cliente,'
      '      df.tipocliente,'
      '      df.nome as nomecliente,'
      '      '
      ''
      '/*'
      '       -- VALOR BRUTO '
      '      ((pdf.quantidade*pdf.precovenda) +'
      
        '        (((coalesce(df.valorfrete,0)+coalesce(df.seguro,0))*(pdf' +
        '.quantidade*pdf.precovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      '          where sdf.dadofiscal = df.numero),0)),0),1)))) +'
      #9#9'  '
      '       -- ACRESCIMO '
      
        '        (((df.Valortotal-df.ValorVista)*(pdf.quantidade*pdf.prec' +
        'ovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      
        '                  where sdf.dadofiscal = df.numero),0)),0),1))) ' +
        ' -'
      #9#9#9#9'  '
      '       -- DESCONTO '#9'   '
      
        '      ((coalesce(df.desconto,0)*(pdf.quantidade*pdf.precovenda))' +
        '  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      #9#9#9#9
      '       as ValorBrutodoProduto'
      '*/'
      ''
      '       - pdf.icmsvalor as ValorBrutodoProduto'
      #9'   '
      ''
      '       from ((dadosfiscais df'
      '               join (produtosdadosfiscais pdf'
      '                     join (produtos p'
      '                           join (((caracteristicas c'
      '                                   join classes cl'
      '                                   on c.classe=cl.codigo)'
      ''
      '                                   join grupos g'
      '                                   on c.grupo = g.codigo)'
      ''
      '                                   join tiposproduto tp'
      '                                   on c.tipoproduto = tp.codigo)'
      ''
      '                           on p.caracteristica=c.codigo)'
      '                    on pdf.produto=p.codigo) '
      #9#9#9'   on df.numero = pdf.dadofiscal)'
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = df.filialvenda)'
      '             '
      '             left join notas n on df.numero = n.dadofiscal'
      '             left join cupons cp on df.numero = cp.dadofiscal'
      ''
      #9#9#9'   '
      #9#9#9'   '
      '       Where (df.data between (:datainicial) and (:datafinal))'
      '          and df.contrato is null'
      '          and df.situacao='#39'N'#39
      '          and eHNotaFiscalSaidaVenda(pdf.codigofiscal)'
      '          and not coalesce(df.notavinculada,false)'
      '          and f.regimetributario <> 1  /* regime normal */'
      #9#9'  and pdf.incidencia in ('#39'00'#39','#39'20'#39')'
      ''
      '     )'
      ''
      '       union all'
      ''
      '     ('
      '         /* DEVOLUCOES COM CONTRATO */'
      ''
      '          select'
      ''
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '          cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '          ct.faturamento as data,'
      '          ct.cliente,'
      '          ct.tipocliente,'
      '          ct.nome as nomecliente,          '
      '      '
      #9#9
      '           '
      '      /* VALOR BRUTO */'
      '      ((((cd.valorvista + cd.desconto) +'
      '      /* ACRESCIMO*/'
      
        '       (cd.ValorPrazo-cd.ValorVista)) * (1-coalesce(c.percreduca' +
        'obase,0)/100)) * Selecionar_Aliquotaicms(f.estado, ct.estado, ct' +
        '.pessoatipo, p.codigo)/100) as ValorBrutodoproduto'
      ''
      '          from ((contratosdevolvidos cd'
      '                 join (contratos ct'
      #9#9#9#9'       join filiais f'
      #9#9#9#9#9'   on ct.filialvenda = f.codigo)'
      '                 on cd.contrato=ct.numero)'
      ''
      '                 join (produtos p'
      '                       join ((((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      #9#9#9#9#9#9#9'   join tributosicms ti'
      #9#9#9#9#9#9#9'   on c.incidencia = ti.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on cd.produto=p.codigo)'
      ''
      
        '          where cd.devolucao between(:DataInicial) and (:DataFin' +
        'al)'
      '            /* and cd.tipo = '#39'D'#39' */'
      
        '            and case when ct.os then ct.tipoequipamento in (1,2)' +
        ' and not (coalesce(ct.os_garantia,false) and ct.os_garantia_stat' +
        'us='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '            and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturad' +
        'as as outras entram pelas notas fiscais devido a cr'#233'ditos de tro' +
        'ca */'
      '            and f.regimetributario <> 1  /* regime normal */'
      #9#9#9'and ti.valor in ('#39'00'#39','#39'20'#39')'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '        cast('#39'NF '#39'||np.numero as varchar(30)) as documento,'
      '        np.data,'
      '        np.fornecedor as cliente,'
      '        np.tipofornecedor as tipocliente,'
      '        np.nome as nomecliente,'
      '      '
      ''
      '      pnp.icmsvalor as ValorBrutodoProduto'
      ''
      '     from ((notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join ((((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      #9#9#9#9#9#9#9'   join tributosicms ti'
      #9#9#9#9#9#9#9'   on c.incidencia = ti.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on pnp.produto=p.codigo) '
      #9#9'   on np.codigo = pnp.codigonota)'
      #9#9'   '
      '           join filiais f'
      #9'       on np.filial = f.codigo)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      #9'   and f.regimetributario <> 1  /* regime normal */'
      #9'   and ti.valor in ('#39'00'#39','#39'20'#39')'
      ''
      '      )'
      ''
      ''
      '      union all'
      ''
      '      ('
      
        '         /* CONTRATOS CANCELADOS SEM CONTRATOS DEVOLVIDOS, TOTAL' +
        'MENTE CANCELADOS SEM PARCELAS PAGAS */'
      '          select'
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '      cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '      ct.faturamento as data,'
      '      ct.cliente,'
      '      ct.tipocliente,'
      '      ct.nome as nomecliente,'
      '      '
      ''
      ''
      '            (((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      
        '            ) * Selecionar_Aliquotaicms(f.estado, ct.estado, ct.' +
        'pessoatipo, p.codigo)/100 ) as  ValorBrutodoProduto'
      ''
      '            /*'
      ''
      '       VALOR BRUTO'
      '      (((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '        (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)' +
        '-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                     coalesce((select  sum(sc.qu' +
        'antidade*coalesce(sc.valorservico,0))'
      '          from servicoscontratos sc'
      '          where sc.contrato = ct.numero),0)),0),1))'
      '        )) +'
      ''
      '       ACRESCIMO'
      ''
      
        '       (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precove' +
        'nda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '        DESCONTO'
      
        '         ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)' +
        ')  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1)))) * ' +
        '(1-coalesce(c.percreducaobase,0)/100)) * Selecionar_Aliquotaicms' +
        '(f.estado, ct.estado, ct.pessoatipo, p.codigo)/100)'
      ''
      '      as ValorBrutodoProduto'
      '      */'
      #9'  '
      #9'  '
      '      from (select distinct ct.numero, p.datapagto'
      '            from contratos ct, parcelas p'
      '            where ct.numero=p.contrato '
      '         and ct.situacao='#39'C'#39' '
      '         and not exists (select p2.numero'
      '                             from parcelas p2'
      '                             where p2.contrato = ct.numero '
      '                   and p2.tipopagto<>'#39'E'#39') '
      '         and p.datapagto between :datainicial and :datafinal '
      '         and not exists (select cd.contrato'
      '                             from contratosdevolvidos cd'
      
        '                             where cd.contrato = ct.numero /*and' +
        ' cd.tipo='#39'D'#39'*/)'
      
        '             and case when ct.os then ct.tipoequipamento in (1,2' +
        ') and not (coalesce(ct.os_garantia,false) and ct.os_garantia_sta' +
        'tus='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '           ) as cancelados, ((contratos ct '
      '                             join (produtoscontratos pc'
      '                                   join (produtos p'
      
        '                                         join ((((caracteristica' +
        's c'
      '                                                 join classes cl'
      
        '                                                 on c.classe = c' +
        'l.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      '                                                 join grupos g'
      
        '                                                 on c.grupo = g.' +
        'codigo)'
      ''
      
        '                                                join tiposprodut' +
        'o tp'
      
        '                                                on c.tipoproduto' +
        ' = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9#9
      #9#9#9#9#9#9#9#9#9#9#9#9'join tributosicms ti'
      #9#9#9#9#9#9#9'                    on c.incidencia = ti.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                         on p.caracteristica = c' +
        '.codigo)'
      '                                   on pc.produto=p.codigo)'
      '                             on pc.contrato = ct.numero)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' join filiais f'
      #9#9#9#9#9'         on ct.filialvenda = f.codigo)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' '
      '      where cancelados.numero = ct.numero'
      #9#9'and f.regimetributario <> 1  /* regime normal */'
      #9#9'and ti.valor in ('#39'00'#39','#39'20'#39')'
      ''
      ''
      '      )'
      ''
      #9') as impostos'
      '   group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo,'
      '            grupo,'
      '            descricaoclasse,'
      '            classe,'
      ''
      '            impostos.documento,'
      '            impostos.data,'
      '            impostos.cliente,'
      '            impostos.tipocliente,'
      '            impostos.nomecliente'
      ''
      ''
      '   )'
      '   '
      '   union all'
      '   '
      '   ('
      '   '
      '   '
      '    /* IMPOSTOS - PIS - REGIME NORMAL */'
      #9
      '     select impostos.tipoproduto,'
      
        '            cast('#39'IMPOSTOS - PIS - '#39' as varchar)||cast(impostos.' +
        'descricaotipoproduto as varchar) as descricaotipoproduto,'
      '            impostos.grupo,'
      '            impostos.descricaogrupo,'
      '            impostos.classe,'
      '            impostos.descricaoclasse,'
      ''
      '            impostos.documento,'
      '            impostos.data,'
      '            impostos.cliente,'
      '            impostos.tipocliente,'
      '            impostos.nomecliente,       '
      '            '
      
        '            sum(impostos.ValorBrutodoProduto) as ValorBrutodoPro' +
        'duto '
      #9'from'#9#9
      #9
      #9'('
      #9
      '      ('
      
        '            /* VENDAS COM CONTRATO BRUTO + ACRESIMCO - DESCONTO ' +
        '*/'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '        cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '        ct.faturamento as data,'
      '        ct.cliente,'
      '        ct.tipocliente,'
      '        ct.nome as nomecliente,       '
      '      '
      ''
      '           -'
      '          (((pc.quantidade*pc.precovenda) +'
      ''
      '                    coalesce(pc.frete,0) +'
      '                   coalesce(pc.seguro,0) +'
      '                coalesce(pc.acrescimo,0) -'
      '            coalesce(pc.descontogeral,0)'
      ''
      
        '          ) * coalesce(c.aliquotapis,0)/100) as  ValorBrutodoPro' +
        'duto'
      ''
      '          /*'
      ''
      '      -'
      '       VALOR BRUTO'
      '      ((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1)))) +'
      ''
      '       ACRESCIMO'
      
        '        (((ValorPrazo-ValorVista)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      
        '        ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1)))) * ' +
        'coalesce(c.aliquotapis,0)/100)'
      ''
      '        as  ValorBrutodoProduto'
      '        */'
      ''
      ''
      '       from ((contratos ct'
      '             join (produtoscontratos pc'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9' '
      '                         on p.caracteristica=c.codigo)'
      '                   on pc.produto=p.codigo)'
      '             on ct.numero = pc.contrato)'
      #9#9#9' '
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = ct.filialvenda)'
      ''
      '       where not pc.brinde'
      
        '         and ct.faturamento between(:datainicial) and (:datafina' +
        'l)'
      '         and (coalesce(ct.valorvista,0)<>0)'
      '         and ct.origem is null'
      '         and f.regimetributario <> 1  /* regime normal */'
      #9#9' and c.piscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      #9#9' and coalesce(c.aliquotapis,0)<>0'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      '        /* VENDAS SEM CONTRATO */'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      #9#9
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '      case when n.dadofiscal is not null then'
      '        cast('#39'NF '#39'||n.numero||'#39' S'#233'rie '#39'||n.serie as varchar(30))'
      '      else'
      
        '        cast('#39'CF '#39'||cp.numero||'#39' Mq. '#39'||cp.maquina||'#39' Int.'#39'||cp.' +
        'intervensao as varchar(30))'
      '      end as documento,'
      '      df.data,'
      '      df.cliente,'
      '      df.tipocliente,'
      '      df.nome as nomecliente,'
      ''
      ''
      #9#9'-'
      '       (((pdf.quantidade * pdf.precovenda)'
      '         - coalesce(pdf.valordescontoitem,0)'
      '         - coalesce(pdf.desconto,0)'
      '         + coalesce(pdf.acrescimo,0)'
      '         + coalesce(pdf.frete,0)'
      '         + coalesce(pdf.seguro,0)'
      '         + coalesce(pdf.valoripi,0)'
      
        '         + coalesce(pdf.despesasacessorias,0)) * coalesce(c.aliq' +
        'uotapis,0)/100) as ValorBrutodoProduto'
      #9#9
      #9#9#9#9#9#9
      '/*'
      '       -- VALOR BRUTO '
      '      ((pdf.quantidade*pdf.precovenda) +'
      
        '        (((coalesce(df.valorfrete,0)+coalesce(df.seguro,0))*(pdf' +
        '.quantidade*pdf.precovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      '          where sdf.dadofiscal = df.numero),0)),0),1)))) +'
      #9#9'  '
      '       -- ACRESCIMO '
      
        '        (((df.Valortotal-df.ValorVista)*(pdf.quantidade*pdf.prec' +
        'ovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      
        '                  where sdf.dadofiscal = df.numero),0)),0),1))) ' +
        ' -'
      #9#9#9#9'  '
      '       -- DESCONTO '#9'   '
      
        '      ((coalesce(df.desconto,0)*(pdf.quantidade*pdf.precovenda))' +
        '  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      #9#9#9#9
      '       as ValorBrutodoProduto'
      '*/'#9'   '
      ''
      #9'   '
      ''
      '       from ((dadosfiscais df'
      '               join (produtosdadosfiscais pdf'
      '                     join (produtos p'
      '                           join (((caracteristicas c'
      '                                   join classes cl'
      '                                   on c.classe=cl.codigo)'
      ''
      '                                   join grupos g'
      '                                   on c.grupo = g.codigo)'
      ''
      '                                   join tiposproduto tp'
      '                                   on c.tipoproduto = tp.codigo)'
      ''
      '                           on p.caracteristica=c.codigo)'
      '                    on pdf.produto=p.codigo) '
      #9#9#9'   on df.numero = pdf.dadofiscal)'
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = df.filialvenda)'
      '             '
      '             left join notas n on df.numero = n.dadofiscal'
      '             left join cupons cp on df.numero = cp.dadofiscal'
      '             '
      #9#9#9'   '
      #9#9#9'   '
      '       Where (df.data between (:datainicial) and (:datafinal))'
      '          and df.contrato is null'
      '          and df.situacao='#39'N'#39
      
        '          and ((eHNotaFiscalSaidaVenda(pdf.codigofiscal) and c.p' +
        'iscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')) or /* vendas */'
      
        #9#9'       (eHNotaFiscalSaidaDevolucao(pdf.codigofiscal) and c.pis' +
        'cst in ('#39'49'#39')))    /* devolu'#231#245'es de compras, conforme regra do s' +
        'ped */'
      '          and not coalesce(df.notavinculada,false)'
      '          and f.regimetributario <> 1  /* regime normal */'
      #9#9'  '
      ''
      '     )'
      ''
      '       union all'
      ''
      '     ('
      '         /* DEVOLUCOES COM CONTRATO */'
      ''
      '          select'
      ''
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '          cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '          ct.faturamento as data,'
      '          ct.cliente,'
      '          ct.tipocliente,'
      '          ct.nome as nomecliente,          '
      '      '
      #9#9
      '           '
      '      /* VALOR BRUTO */'
      '      (((cd.valorvista + cd.desconto) +'
      '      /* ACRESCIMO*/'
      
        '       (cd.ValorPrazo-cd.ValorVista)) * coalesce(c.aliquotapis,0' +
        ')/100) as ValorBrutodoproduto'
      ''
      '          from ((contratosdevolvidos cd'
      '                 join (contratos ct'
      #9#9#9#9'       join filiais f'
      #9#9#9#9#9'   on ct.filialvenda = f.codigo)'
      '                 on cd.contrato=ct.numero)'
      ''
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      '                       on p.caracteristica=c.codigo)'
      '                 on cd.produto=p.codigo)'
      ''
      
        '          where cd.devolucao between(:DataInicial) and (:DataFin' +
        'al)'
      '            /* and cd.tipo = '#39'D'#39' */'
      
        '            and case when ct.os then ct.tipoequipamento in (1,2)' +
        ' and not (coalesce(ct.os_garantia,false) and ct.os_garantia_stat' +
        'us='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '            and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturad' +
        'as as outras entram pelas notas fiscais devido a cr'#233'ditos de tro' +
        'ca */'
      '            and f.regimetributario <> 1  /* regime normal */'
      #9#9#9'and c.piscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      #9'  '
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '        cast('#39'NF '#39'||np.numero as varchar(30)) as documento,'
      '        np.data,'
      '        np.fornecedor as cliente,'
      '        np.tipofornecedor as tipocliente,'
      '        np.nome as nomecliente,'
      '      '
      #9'  '
      #9'  '
      '      ((pnp.quantidade * pnp.precounitario)'
      '      - coalesce(pnp.valordescontoitem,0)'
      '      - coalesce(pnp.desconto,0)'
      '      + coalesce(pnp.acrescimo,0)'
      '      + coalesce(pnp.frete,0)'
      '      + coalesce(pnp.seguro,0)'
      '      + coalesce(pnp.valoripi,0)'
      
        '      + coalesce(pnp.despesasacessorias,0)) * coalesce(c.aliquot' +
        'apis,0)/100'
      #9'   as ValorBrutodoProduto'
      #9'   '
      ''
      '     from ((notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      '                       on p.caracteristica=c.codigo)'
      '                 on pnp.produto=p.codigo) '
      #9#9'   on np.codigo = pnp.codigonota)'
      #9#9'   '
      '           join filiais f'
      #9'       on np.filial = f.codigo)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      #9'   and f.regimetributario <> 1  /* regime normal */'
      
        #9'   and c.piscst in ('#39'50'#39','#39'51'#39','#39'52'#39','#39'53'#39','#39'54'#39','#39'55'#39','#39'56'#39','#39'60'#39','#39'61' +
        #39','#39'62'#39','#39'63'#39','#39'64'#39','#39'65'#39','#39'66'#39')'
      ''
      '      )'
      ''
      ''
      '      union all'
      ''
      '      ('
      
        '         /* CONTRATOS CANCELADOS SEM CONTRATOS DEVOLVIDOS, TOTAL' +
        'MENTE CANCELADOS SEM PARCELAS PAGAS */'
      '          select'
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '      cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '      ct.faturamento as data,'
      '      ct.cliente,'
      '      ct.tipocliente,'
      '      ct.nome as nomecliente,'
      '      '
      ''
      '          (((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      
        '            ) * coalesce(c.aliquotapis,0)/100) as  ValorBrutodoP' +
        'roduto'
      ''
      '            /*'
      ''
      '       VALOR BRUTO'
      '      ((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '        (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)' +
        '-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                     coalesce((select  sum(sc.qu' +
        'antidade*coalesce(sc.valorservico,0))'
      '          from servicoscontratos sc'
      '          where sc.contrato = ct.numero),0)),0),1))'
      '        )) +'
      ''
      '       ACRESCIMO'
      ''
      
        '       (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precove' +
        'nda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      
        '         ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)' +
        ')  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1)))) * ' +
        'coalesce(c.aliquotapis,0)/100) as ValorBrutodoProduto'
      ''
      '                  */'
      ''
      ''
      '      from (select distinct ct.numero, p.datapagto'
      '            from contratos ct, parcelas p'
      '            where ct.numero=p.contrato'
      '         and ct.situacao='#39'C'#39
      '         and not exists (select p2.numero'
      '                             from parcelas p2'
      '                             where p2.contrato = ct.numero '
      '                   and p2.tipopagto<>'#39'E'#39') '
      '         and p.datapagto between :datainicial and :datafinal '
      '         and not exists (select cd.contrato'
      '                             from contratosdevolvidos cd'
      
        '                             where cd.contrato = ct.numero /*and' +
        ' cd.tipo='#39'D'#39'*/)'
      
        '             and case when ct.os then ct.tipoequipamento in (1,2' +
        ') and not (coalesce(ct.os_garantia,false) and ct.os_garantia_sta' +
        'tus='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '           ) as cancelados, ((contratos ct '
      '                             join (produtoscontratos pc'
      '                                   join (produtos p'
      
        '                                         join (((caracteristicas' +
        ' c'
      '                                                 join classes cl'
      
        '                                                 on c.classe = c' +
        'l.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      '                                                 join grupos g'
      
        '                                                 on c.grupo = g.' +
        'codigo)'
      ''
      
        '                                                join tiposprodut' +
        'o tp'
      
        '                                                on c.tipoproduto' +
        ' = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                         on p.caracteristica = c' +
        '.codigo)'
      '                                   on pc.produto=p.codigo)'
      '                             on pc.contrato = ct.numero)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' join filiais f'
      #9#9#9#9#9'         on ct.filialvenda = f.codigo)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' '
      '      where cancelados.numero = ct.numero'
      #9#9'and f.regimetributario <> 1  /* regime normal */'
      #9#9'and c.piscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      ''
      ''
      '      )'
      ''
      #9') as impostos'
      #9'       group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo,'
      '            grupo,'
      '            descricaoclasse,'
      '            classe,'
      ''
      '            impostos.data,'
      '            impostos.documento,'
      '            impostos.cliente,'
      '            impostos.tipocliente,'
      '            impostos.nomecliente'
      '            '
      ''
      '   )'
      '   '
      '   union all'
      '   '
      '   ('
      '   '
      '   '
      '    /* IMPOSTOS - COFINS - REGIME NORMAL */'
      #9
      '     select impostos.tipoproduto,'
      
        '            cast('#39'IMPOSTOS - COFINS - '#39' as varchar)||cast(impost' +
        'os.descricaotipoproduto as varchar) as descricaotipoproduto,'
      '            impostos.grupo,'
      '            impostos.descricaogrupo,'
      '            impostos.classe,'
      '            impostos.descricaoclasse,'
      ''
      '            impostos.documento,'
      '            impostos.data,'
      '            impostos.cliente,'
      '            impostos.tipocliente,'
      '            impostos.nomecliente,       '
      '            '
      
        '            sum(impostos.ValorBrutodoProduto) as ValorBrutodoPro' +
        'duto '
      #9'from'#9#9
      #9
      #9'('
      ''
      '      ('
      
        '            /* VENDAS COM CONTRATO BRUTO + ACRESIMCO - DESCONTO ' +
        '*/'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      ''
      
        #9'case when :AgruparGrupo then c.grupo     else cast(null as varc' +
        'har(4)) end as grupo,'
      
        #9'case when :AgruparGrupo then g.descricao else cast(null as varc' +
        'har(30)) end as descricaogrupo,'
      
        #9'case when :AGruparClasse then c.classe    else cast(null as var' +
        'char(2)) end as classe,'
      
        #9'case when :AGruparClasse then cl.descricao else cast(null as va' +
        'rchar(30)) end as descricaoclasse,'
      '    '
      '        cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '        ct.faturamento as data,'
      '        ct.cliente,'
      '        ct.tipocliente,'
      '        ct.nome as nomecliente,       '
      '    '
      ''
      '          -'
      '          (((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      
        '            ) * coalesce(c.aliquotacofins,0)/100) as  ValorBruto' +
        'doProduto'
      ''
      '        /*'
      ''
      '      -'
      '       VALOR BRUTO'
      '      ((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1)))) +'
      ''
      '       ACRESCIMO'
      
        '        (((ValorPrazo-ValorVista)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      
        '        ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1)))) * ' +
        'coalesce(c.aliquotacofins,0)/100)'
      ''
      '        as  ValorBrutodoProduto'
      ''
      '        */'
      ''
      ''
      '       from ((contratos ct'
      '             join (produtoscontratos pc'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9' '
      '                         on p.caracteristica=c.codigo)'
      '                   on pc.produto=p.codigo)'
      '             on ct.numero = pc.contrato)'
      #9#9#9' '
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = ct.filialvenda)'
      ''
      '       where not pc.brinde'
      
        '         and ct.faturamento between(:datainicial) and (:datafina' +
        'l)'
      '         and (coalesce(ct.valorvista,0)<>0)'
      '         and ct.origem is null'
      '         and f.regimetributario <> 1  /* regime normal */'
      #9#9' and c.cofinscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      #9#9' and coalesce(c.aliquotacofins,0)<>0'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      '        /* VENDAS SEM CONTRATO */'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      #9#9
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '      case when n.dadofiscal is not null then'
      '        cast('#39'NF '#39'||n.numero||'#39' S'#233'rie '#39'||n.serie as varchar(30))'
      '      else'
      
        '        cast('#39'CF '#39'||cp.numero||'#39' Mq. '#39'||cp.maquina||'#39' Int.'#39'||cp.' +
        'intervensao as varchar(30))'
      '      end as documento,'
      '      df.data,'
      '      df.cliente,'
      '      df.tipocliente,'
      '      df.nome as nomecliente,'
      '      '
      ''
      #9#9'-'
      '       (((pdf.quantidade * pdf.precovenda)'
      '         - coalesce(pdf.valordescontoitem,0)'
      '         - coalesce(pdf.desconto,0)'
      '         + coalesce(pdf.acrescimo,0)'
      '         + coalesce(pdf.frete,0)'
      '         + coalesce(pdf.seguro,0)'
      '         + coalesce(pdf.valoripi,0)'
      
        '         + coalesce(pdf.despesasacessorias,0)) * coalesce(c.aliq' +
        'uotacofins,0)/100) as ValorBrutodoProduto'
      #9#9
      #9#9#9#9#9#9
      '/*'
      '       -- VALOR BRUTO '
      '      ((pdf.quantidade*pdf.precovenda) +'
      
        '        (((coalesce(df.valorfrete,0)+coalesce(df.seguro,0))*(pdf' +
        '.quantidade*pdf.precovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      '          where sdf.dadofiscal = df.numero),0)),0),1)))) +'
      #9#9'  '
      '       -- ACRESCIMO '
      
        '        (((df.Valortotal-df.ValorVista)*(pdf.quantidade*pdf.prec' +
        'ovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      
        '                  where sdf.dadofiscal = df.numero),0)),0),1))) ' +
        ' -'
      #9#9#9#9'  '
      '       -- DESCONTO '#9'   '
      
        '      ((coalesce(df.desconto,0)*(pdf.quantidade*pdf.precovenda))' +
        '  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      #9#9#9#9
      '       as ValorBrutodoProduto'
      '*/'#9'   '
      ''
      #9'   '
      ''
      '       from ((dadosfiscais df'
      '               join (produtosdadosfiscais pdf'
      '                     join (produtos p'
      '                           join (((caracteristicas c'
      '                                   join classes cl'
      '                                   on c.classe=cl.codigo)'
      ''
      '                                   join grupos g'
      '                                   on c.grupo = g.codigo)'
      ''
      '                                   join tiposproduto tp'
      '                                   on c.tipoproduto = tp.codigo)'
      ''
      '                           on p.caracteristica=c.codigo)'
      '                    on pdf.produto=p.codigo) '
      #9#9#9'   on df.numero = pdf.dadofiscal)'
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = df.filialvenda)'
      '             '
      '             left join notas n on df.numero = n.dadofiscal'
      '             left join cupons cp on df.numero = cp.dadofiscal'
      '             '
      #9#9#9'   '
      #9#9#9'   '
      '       Where (df.data between (:datainicial) and (:datafinal))'
      '          and df.contrato is null'
      '          and df.situacao='#39'N'#39
      
        '          and ((eHNotaFiscalSaidaVenda(pdf.codigofiscal) and c.c' +
        'ofinscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')) or /* vendas */'
      
        #9#9'       (eHNotaFiscalSaidaDevolucao(pdf.codigofiscal) and c.cof' +
        'inscst in ('#39'49'#39')))    /* devolu'#231#245'es de compras, conforme regra d' +
        'o sped */'
      '          and not coalesce(df.notavinculada,false)'
      '          and f.regimetributario <> 1  /* regime normal */'
      #9#9'  '
      ''
      '     )'
      ''
      '       union all'
      ''
      '     ('
      '         /* DEVOLUCOES COM CONTRATO */'
      ''
      '          select'
      ''
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '          cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '          ct.faturamento as data,'
      '          ct.cliente,'
      '          ct.tipocliente,'
      '          ct.nome as nomecliente,          '
      '      '
      #9#9
      '           '
      '      /* VALOR BRUTO */'
      '      (((cd.valorvista + cd.desconto) +'
      '      /* ACRESCIMO*/'
      
        '       (cd.ValorPrazo-cd.ValorVista)) * coalesce(c.aliquotacofin' +
        's,0)/100) as ValorBrutodoproduto'
      ''
      '          from ((contratosdevolvidos cd'
      '                 join (contratos ct'
      #9#9#9#9'       join filiais f'
      #9#9#9#9#9'   on ct.filialvenda = f.codigo)'
      '                 on cd.contrato=ct.numero)'
      ''
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      '                       on p.caracteristica=c.codigo)'
      '                 on cd.produto=p.codigo)'
      ''
      
        '          where cd.devolucao between(:DataInicial) and (:DataFin' +
        'al)'
      '            /* and cd.tipo = '#39'D'#39' */'
      
        '            and case when ct.os then ct.tipoequipamento in (1,2)' +
        ' and not (coalesce(ct.os_garantia,false) and ct.os_garantia_stat' +
        'us='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '            and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturad' +
        'as as outras entram pelas notas fiscais devido a cr'#233'ditos de tro' +
        'ca */'
      '            and f.regimetributario <> 1  /* regime normal */'
      #9#9#9'and c.cofinscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '        cast('#39'NF '#39'||np.numero as varchar(30)) as documento,'
      '        np.data,'
      '        np.fornecedor as cliente,'
      '        np.tipofornecedor as tipocliente,'
      '        np.nome as nomecliente,'
      '      '
      #9'  '
      #9'  '
      '      ((pnp.quantidade * pnp.precounitario)'
      '      - coalesce(pnp.valordescontoitem,0)'
      '      - coalesce(pnp.desconto,0)'
      '      + coalesce(pnp.acrescimo,0)'
      '      + coalesce(pnp.frete,0)'
      '      + coalesce(pnp.seguro,0)'
      '      + coalesce(pnp.valoripi,0)'
      
        '      + coalesce(pnp.despesasacessorias,0)) * coalesce(c.aliquot' +
        'acofins,0)/100'
      #9'   as ValorBrutodoProduto'
      #9'   '
      ''
      '     from ((notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      '                       on p.caracteristica=c.codigo)'
      '                 on pnp.produto=p.codigo) '
      #9#9'   on np.codigo = pnp.codigonota)'
      #9#9'   '
      '           join filiais f'
      #9'       on np.filial = f.codigo)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      #9'   and f.regimetributario <> 1  /* regime normal */'
      
        #9'   and c.cofinscst in ('#39'50'#39','#39'51'#39','#39'52'#39','#39'53'#39','#39'54'#39','#39'55'#39','#39'56'#39','#39'60'#39',' +
        #39'61'#39','#39'62'#39','#39'63'#39','#39'64'#39','#39'65'#39','#39'66'#39')'
      ''
      '      )'
      ''
      ''
      '      union all'
      ''
      '      ('
      
        '         /* CONTRATOS CANCELADOS SEM CONTRATOS DEVOLVIDOS, TOTAL' +
        'MENTE CANCELADOS SEM PARCELAS PAGAS */'
      '          select'
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '      cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '      ct.faturamento as data,'
      '      ct.cliente,'
      '      ct.tipocliente,'
      '      ct.nome as nomecliente,'
      '      '
      ''
      '          (((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      
        '            ) * coalesce(c.aliquotacofins,0)/100) as  ValorBruto' +
        'doProduto'
      ''
      '        /*'
      ''
      '       VALOR BRUTO'
      '      ((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '        (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)' +
        '-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                     coalesce((select  sum(sc.qu' +
        'antidade*coalesce(sc.valorservico,0))'
      '          from servicoscontratos sc'
      '          where sc.contrato = ct.numero),0)),0),1))'
      '        )) +'
      ''
      '       ACRESCIMO'
      ''
      
        '       (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precove' +
        'nda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      
        '         ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)' +
        ')  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1)))) * ' +
        'coalesce(c.aliquotacofins,0)/100) as ValorBrutodoProduto'
      '       */'
      ''
      '      from (select distinct ct.numero, p.datapagto'
      '            from contratos ct, parcelas p'
      '            where ct.numero=p.contrato'
      '         and ct.situacao='#39'C'#39
      '         and not exists (select p2.numero'
      '                             from parcelas p2'
      '                             where p2.contrato = ct.numero'
      '                   and p2.tipopagto<>'#39'E'#39')'
      '         and p.datapagto between :datainicial and :datafinal'
      '         and not exists (select cd.contrato'
      '                             from contratosdevolvidos cd'
      
        '                             where cd.contrato = ct.numero /*and' +
        ' cd.tipo='#39'D'#39'*/)'
      
        '             and case when ct.os then ct.tipoequipamento in (1,2' +
        ') and not (coalesce(ct.os_garantia,false) and ct.os_garantia_sta' +
        'tus='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '           ) as cancelados, ((contratos ct '
      '                             join (produtoscontratos pc'
      '                                   join (produtos p'
      
        '                                         join (((caracteristicas' +
        ' c'
      '                                                 join classes cl'
      
        '                                                 on c.classe = c' +
        'l.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      '                                                 join grupos g'
      
        '                                                 on c.grupo = g.' +
        'codigo)'
      ''
      
        '                                                join tiposprodut' +
        'o tp'
      
        '                                                on c.tipoproduto' +
        ' = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                         on p.caracteristica = c' +
        '.codigo)'
      '                                   on pc.produto=p.codigo)'
      '                             on pc.contrato = ct.numero)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' join filiais f'
      #9#9#9#9#9'         on ct.filialvenda = f.codigo)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' '
      '      where cancelados.numero = ct.numero'
      #9#9'and f.regimetributario <> 1  /* regime normal */'
      #9#9'and c.cofinscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      ''
      ''
      '      )'
      ''
      #9') as impostos'
      ''
      #9'    group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo, grupo,'
      '            descricaoclasse, classe,'
      ''
      '            impostos.documento,'
      '            impostos.data,'
      '            impostos.cliente,'
      '            impostos.tipocliente,'
      '            impostos.nomecliente'
      ''
      ''
      ''
      ''
      '   )'
      ''
      ''
      '  ) as dev'
      '       group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo, grupo, descricaoclasse, classe,'
      ''
      '            dev.documento,'
      '            dev.data,'
      '            dev.cliente,'
      '            dev.tipocliente,'
      '            dev.nomecliente'
      ''
      ''
      ''
      ''
      ')'
      ''
      ') as sel'
      'where valorBrutodoProduto is not null'
      ''
      '   order by classificacao,  descricaoclassificacao,'
      '            tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo, grupo,'
      '            descricaoclasse, classe,'
      ''
      '            data,'
      '            documento,'
      '            cliente,'
      '            tipocliente,'
      '            nomecliente')
    RequestLive = False
    Left = 208
    Top = 136
    ParamData = <
      item
        DataType = ftString
        Name = 'AgruparGrupo'
        ParamType = ptUnknown
        Value = 'true'
      end
      item
        DataType = ftUnknown
        Name = 'AGruparClasse'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'datainicial'
        ParamType = ptUnknown
        Value = #39'2015-01-01'#39
      end
      item
        DataType = ftString
        Name = 'datafinal'
        ParamType = ptUnknown
        Value = #39'2015-01-31'#39
      end>
  end
  object qryReceita_Operacional_Bruta_Tentativa_2: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select sel.*'
      'from'
      '('
      ''
      '('
      '   /* VENDAS COM CONTRATOS */'
      '  select cast(1 as integer) as classificacao,'
      
        '         cast('#39'RECEITA OPERACIONAL BRUTA'#39' as varchar(50)) as des' +
        'cricaoclassificacao,'
      '         vp.tipoproduto,'
      '         vp.descricaotipoproduto,'
      '         vp.grupo,'
      '         vp.descricaogrupo,'
      '         vp.classe,'
      '         vp.descricaoclasse,'
      '         sum(vp.ValorBrutodoProduto) as ValorBrutodoProduto'
      '  from'
      '  ('
      '    ('
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      ''
      
        '      case when :AgruparGrupo then c.grupo     else cast(null as' +
        ' varchar(4)) end as grupo,'
      
        '      case when :AgruparGrupo then g.descricao else cast(null as' +
        ' varchar(30)) end as descricaogrupo,'
      
        '      case when :AGruparClasse then c.classe    else cast(null a' +
        's varchar(2)) end as classe,'
      
        '      case when :AGruparClasse then cl.descricao else cast(null ' +
        'as varchar(30)) end as descricaoclasse,'
      ''
      '      ((pc.quantidade*pc.precovenda) +'
      '                coalesce(pc.frete,0) +'
      '               coalesce(pc.seguro,0) +'
      '           coalesce(pc.acrescimo,0)) as  ValorBrutodoProduto'
      ''
      ''
      #9'  /* VALOR BRUTO'
      #9'  ((pc.quantidade*pc.precovenda) +'
      
        '      (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quantid' +
        'ade*pc.precovenda))  /'
      
        '       (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-' +
        'coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '               coalesce((select  sum(sc.quantidade*coalesce(sc.v' +
        'alorservico,0))'
      '                from servicoscontratos sc'
      '                where sc.contrato = ct.numero),0)),0),1)))) +'
      ''
      #9'   ACRESCIMO'
      
        '      (((ValorPrazo-ValorVista)*(pc.quantidade*pc.precovenda))  ' +
        '/'
      
        '       (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-' +
        'coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '               coalesce((select  sum(sc.quantidade*coalesce(sc.v' +
        'alorservico,0))'
      '                from servicoscontratos sc'
      '                where sc.contrato = ct.numero),0)),0),1)))'
      ''
      '      as  ValorBrutodoProduto'
      '      */'
      ''
      ''
      '     from (contratos ct'
      '           join (produtoscontratos pc'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on pc.produto=p.codigo)'
      '           on ct.numero = pc.contrato)'
      ''
      '     where not pc.brinde and'
      
        '               ct.faturamento between(:datainicial) and (:datafi' +
        'nal) and'
      '               (coalesce(ct.valorvista,0)<>0) and'
      '               ct.origem is null'
      ''
      '    )'
      '    union all'
      '    ('
      '      /* VENDAS SEM CONTRATO */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      
        '      case when :AgruparGrupo then c.grupo     else cast(null as' +
        ' varchar(4)) end as grupo,'
      
        '      case when :AgruparGrupo then g.descricao else cast(null as' +
        ' varchar(30)) end as descricaogrupo,'
      
        '      case when :AGruparClasse then c.classe    else cast(null a' +
        's varchar(2)) end as classe,'
      
        '      case when :AGruparClasse then cl.descricao else cast(null ' +
        'as varchar(30)) end as descricaoclasse,'
      ''
      '      ((pdf.quantidade*pdf.precovenda) +'
      '                 coalesce(pdf.frete,0) +'
      '                coalesce(pdf.seguro,0) +'
      
        '                coalesce(pdf.acrescimo,0)) as ValorBrutodoProdut' +
        'o'
      ''
      ''
      '       /* VALOR BRUTO'
      #9'  ((pdf.quantidade*pdf.precovenda) +'
      ''
      
        '      (((coalesce(df.valorfrete,0)+coalesce(df.seguro,0))*(pdf.q' +
        'uantidade*pdf.precovenda))  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '        where sdf.dadofiscal = df.numero),0)),0),1))'
      '          )) +'
      ''
      #9'    ACRESCIMO'
      ''
      
        '      (((df.Valortotal-df.ValorVista)*(pdf.quantidade*pdf.precov' +
        'enda))  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      ''
      #9'   as ValorBrutodoProduto'
      '       */'
      ''
      '      from (dadosfiscais df'
      '             join (produtosdadosfiscais pdf'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      ''
      '                         on p.caracteristica=c.codigo)'
      
        '             on pdf.produto=p.codigo) on df.numero = pdf.dadofis' +
        'cal)'
      ''
      
        '      Where (df.data between (:datainicial) and (:datafinal)) an' +
        'd df.contrato is null'
      '              and df.situacao='#39'N'#39
      '              and eHNotaFiscalSaidaVenda(pdf.codigofiscal)'
      '        and not coalesce(df.notavinculada,false)'
      ''
      ''
      '    )'
      '  )  as vp'
      '     group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo,'
      '            grupo,'
      '            descricaoclasse,'
      '            classe'
      ''
      ''
      ')'
      ''
      '  union all'
      ''
      '('
      '    select'
      ''
      '      cast(1 as integer) as classificacao,'
      
        '      cast('#39'RECEITA OPERACIONAL BRUTA'#39' as varchar(50)) as descri' +
        'caoclassificacao,'
      ''
      '      cast('#39'09'#39' as varchar(2)) as tipoproduto,'
      
        '      (select tp.descricao from tiposproduto tp where tp.codigo ' +
        '= '#39'09'#39') as descricaotipoproduto,'
      ''
      #9'  '
      
        #9'  case when :AgruparGrupo then cast('#39'SE'#39' as varchar(4))        ' +
        'else cast(null as varchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then cast('#39'SERVICOS'#39' as varchar(30)) ' +
        'else cast(null as varchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then cast('#39'SE'#39' as varchar(02))      ' +
        ' else cast(null as varchar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cast('#39'SERVICOS'#39' as varchar(30))' +
        ' else cast(null as varchar(30)) end as descricaoclasse,'
      ''
      '/*'#9'  '
      '      cast('#39'SE'#39' as varchar(4)) as grupo,'
      '      cast('#39'SERVICOS'#39' as varchar(30)) as descricaogrupo,'
      ''
      '      cast('#39'SE'#39' as varchar(02)) as classe,'
      '      cast('#39'SERVICOS'#39' as varchar(30)) as descricaoclasse,'
      '*/'#9'  '
      ''
      
        '      sum(round((coalesce(sc.quantidade,0)*coalesce(sc.valorserv' +
        'ico,0)),2)) as valorBrutodoProduto'
      ''
      '   from (contratos ct'
      ''
      '                              join servicoscontratos sc'
      
        '                                                                ' +
        '        on ct.numero = sc.contrato)'
      '   where ct.faturamento between(:DataInicial) and (:DataFinal)'
      ''
      '   /*'
      '   group by tipoproduto,'
      '            descricaotipoproduto,'
      '            grupo,'
      '            descricaogrupo,'
      '            classe,'
      '            descricaoclasse'
      #9#9#9'*/'
      ''
      ')'
      ''
      'union all'
      ''
      ''
      '('
      '  select cast(2 as integer) as classificacao,'
      
        '        cast('#39'(-) DEDU'#199#213'ES DA RECEITA BRUTA'#39' as varchar(50)) as ' +
        'descricaoclassificacao,'
      '        dev.tipoproduto,'
      '        dev.descricaotipoproduto,'
      '        dev.grupo,'
      '        dev.descricaogrupo,'
      '        dev.classe,'
      '        dev.descricaoclasse,'
      '        sum(dev.ValorBrutodoproduto) as ValorBrutodoproduto'
      '  from'
      '  ('
      ''
      '    ('
      ''
      '       /* CONTRATOS FATURADOS DEVOLVIDOS */'
      '        select'
      ''
      '        c.tipoproduto,'
      
        '        cast('#39'DEVOLU'#199#213'ES - '#39' as varchar)||cast(tp.descricao as v' +
        'archar) as descricaotipoproduto,'
      #9#9
      
        '  '#9'    case when :AgruparGrupo then c.grupo     else cast(null a' +
        's varchar(4)) end as grupo,'
      
        #9'    case when :AgruparGrupo then g.descricao else cast(null as ' +
        'varchar(30)) end as descricaogrupo,'
      
        #9'    case when :AGruparClasse then c.classe    else cast(null as' +
        ' varchar(2)) end as classe,'
      
        #9'    case when :AGruparClasse then cl.descricao else cast(null a' +
        's varchar(30)) end as descricaoclasse,'
      #9#9
      ''
      '        -'
      #9#9'/* VALOR BRUTO */'
      #9#9'((cd.valorvista + cd.desconto) +'
      #9#9'/* ACRESCIMO*/'
      #9#9' (cd.ValorPrazo-cd.ValorVista))'
      #9#9'as ValorBrutodoproduto'
      ''
      '        from ((contratosdevolvidos cd'
      '               join contratos ct'
      '               on cd.contrato=ct.numero)'
      ''
      '               join (produtos p'
      '                     join (((caracteristicas c'
      '                             join classes cl'
      '                             on c.classe=cl.codigo)'
      ''
      '                             join grupos g'
      '                             on c.grupo = g.codigo)'
      ''
      '                             join tiposproduto tp'
      '                             on c.tipoproduto = tp.codigo)'
      ''
      '                     on p.caracteristica=c.codigo)'
      '               on cd.produto=p.codigo)'
      ''
      
        '        where cd.devolucao between(:DataInicial) and (:DataFinal' +
        ')'
      '          /* and cd.tipo = '#39'D'#39' */'
      
        '          and case when ct.os then ct.tipoequipamento in (1,2) a' +
        'nd not (coalesce(ct.os_garantia,false) and ct.os_garantia_status' +
        '='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '          and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturadas' +
        ' as outras entram pelas notas fiscais devido a cr'#233'ditos de troca' +
        ' */'
      ''
      '    )'
      ''
      ''
      '    union all'
      ''
      '    ('
      '        /* CONTRATOS FATURADOS TOTALMENTE CANCELADOS  */'
      '        select'
      '        c.tipoproduto,'
      
        #9#9'    cast('#39'DEVOLU'#199#213'ES - '#39' as varchar)||cast(tp.descricao as var' +
        'char) as descricaotipoproduto,'
      ''
      
        #9'    case when :AgruparGrupo then c.grupo     else cast(null as ' +
        'varchar(4)) end as grupo,'
      
        #9'    case when :AgruparGrupo then g.descricao else cast(null as ' +
        'varchar(30)) end as descricaogrupo,'
      
        #9'    case when :AGruparClasse then c.classe    else cast(null as' +
        ' varchar(2)) end as classe,'
      
        #9'    case when :AGruparClasse then cl.descricao else cast(null a' +
        's varchar(30)) end as descricaoclasse,'
      ''
      '            -'
      '            ((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      '            ) as  ValorBrutodoProduto'
      ''
      #9'     /*'
      '      -'
      #9'   VALOR BRUTO'
      ''
      #9'  (((pc.quantidade*pc.precovenda) +'
      
        '      (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quantid' +
        'ade*pc.precovenda))  /'
      
        '      (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-c' +
        'oalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                   coalesce((select  sum(sc.quan' +
        'tidade*coalesce(sc.valorservico,0))'
      '        from servicoscontratos sc'
      '        where sc.contrato = ct.numero),0)),0),1))'
      '      )) +'
      ''
      #9'   ACRESCIMO'
      ''
      
        #9'   (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precovenda' +
        '))  /'
      
        '       (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-' +
        'coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '               coalesce((select  sum(sc.quantidade*coalesce(sc.v' +
        'alorservico,0))'
      '                from servicoscontratos sc'
      '                where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      #9#9' DESCONTO'
      
        '       ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)) ' +
        ' /'
      
        '       (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-' +
        'coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '               coalesce((select  sum(sc.quantidade*coalesce(sc.v' +
        'alorservico,0))'
      '                from servicoscontratos sc'
      '                where sc.contrato = ct.numero),0)),0),1))))'
      ''
      #9'  as ValorBrutodoProduto'
      ''
      '          */'
      ''
      ''
      '    from (select distinct ct.numero, p.datapagto'
      '          from contratos ct, parcelas p'
      '          where ct.numero=p.contrato '
      #9#9'   and ct.situacao='#39'C'#39' '
      #9#9'   and not exists (select p2.numero'
      '                           from parcelas p2'
      '                           where p2.contrato = ct.numero '
      #9#9#9#9#9#9'     and p2.tipopagto<>'#39'E'#39') '
      #9#9'   and p.datapagto between :datainicial and :datafinal '
      #9#9'   and not exists (select cd.contrato'
      '                           from contratosdevolvidos cd'
      
        '                           where cd.contrato = ct.numero /*and c' +
        'd.tipo='#39'D'#39'*/ )'
      
        '           and case when ct.os then ct.tipoequipamento in (1,2) ' +
        'and not (coalesce(ct.os_garantia,false) and ct.os_garantia_statu' +
        's='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '         ) as cancelados, (contratos ct '
      #9#9'                   join (produtoscontratos pc'
      #9#9#9#9#9#9'         join (produtos p'
      #9#9#9#9#9#9#9#9'       join (((caracteristicas c'
      #9#9#9#9#9#9#9#9#9'           join classes cl'
      #9#9#9#9#9#9#9#9#9#9#9'   on c.classe = cl.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9#9#9#9#9'  join grupos g'
      #9#9#9#9#9#9#9#9#9#9#9'  on c.grupo = g.codigo)'
      ''
      #9#9#9#9#9#9#9#9#9#9#9' join tiposproduto tp'
      #9#9#9#9#9#9#9#9#9#9#9' on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                       on p.caracteristica = c.c' +
        'odigo)'
      '                                 on pc.produto=p.codigo)'
      '                           on pc.contrato = ct.numero)'
      '    where cancelados.numero = ct.numero'
      #9#9
      ''
      '    )'
      ''
      '    union all'
      ''
      '    ('
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      
        '      cast('#39'DEVOLU'#199#213'ES - '#39' as varchar)||cast(tp.descricao as var' +
        'char) as descricaotipoproduto,'
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      '      -'
      '      ((pnp.quantidade * pnp.precounitario)'
      '      - coalesce(pnp.valordescontoitem,0)'
      '      - coalesce(pnp.desconto,0)'
      '      + coalesce(pnp.acrescimo,0)'
      '      + coalesce(pnp.frete,0)'
      '      + coalesce(pnp.seguro,0)'
      '      + coalesce(pnp.valoripi,0)'
      '      + coalesce(pnp.icmsvalorst,0)'
      '      + coalesce(pnp.despesasacessorias,0))'
      #9'   as ValorBrutodoProduto'
      ''
      '     from (notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      
        '           on pnp.produto=p.codigo) on np.codigo = pnp.codigonot' +
        'a)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      ''
      '    )'
      ''
      #9'union all'
      ''
      ''
      '    ('
      ''
      '       /* DESCONTOS DE VENDAS COM CONTRATO */'
      ''
      '      select'
      '      c.tipoproduto,'
      
        #9'  cast('#39'DESCONTOS - '#39' as varchar)||cast(tp.descricao as varchar' +
        ') as descricaotipoproduto,'
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      '          - pc.descontogeral as ValorBrutodoProduto'
      ''
      '          /*'
      '      -'
      ''
      #9'  ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))  /'
      
        '       (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-' +
        'coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '               coalesce((select  sum(sc.quantidade*coalesce(sc.v' +
        'alorservico,0))'
      '                from servicoscontratos sc'
      '                where sc.contrato = ct.numero),0)),0),1)))'
      ''
      #9'  as  ValorBrutodoProduto'
      '          */'
      ''
      ''
      '     from (contratos ct'
      '           join (produtoscontratos pc'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on pc.produto=p.codigo)'
      '           on ct.numero = pc.contrato)'
      ''
      '     where not pc.brinde and'
      
        '               ct.faturamento between(:datainicial) and (:datafi' +
        'nal) and'
      '               (coalesce(ct.valorvista,0)<>0) and'
      '               ct.origem is null and'
      #9#9#9'   coalesce(ct.desconto,0)<>0'
      ''
      '    )'
      '    union all'
      '    ('
      '       /* DESCONTOS DE VENDAS SEM CONTRATO */'
      ''
      '      select'
      '      c.tipoproduto,'
      
        '      cast('#39'DESCONTOS - '#39' as varchar)||cast(tp.descricao as varc' +
        'har) as descricaotipoproduto,'
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      ''
      
        '      - (coalesce(pdf.desconto,0) + coalesce(pdf.valordescontoit' +
        'em,0)) as ValorBrutodoProduto'
      ''
      '      /*'
      '      -'
      
        '      ((coalesce(df.desconto,0)*(pdf.quantidade*pdf.precovenda))' +
        '  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      #9'   as ValorBrutodoProduto'
      '           */'
      ''
      ''
      '      from (dadosfiscais df'
      '             join (produtosdadosfiscais pdf'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      ''
      '                         on p.caracteristica=c.codigo)'
      
        '             on pdf.produto=p.codigo) on df.numero = pdf.dadofis' +
        'cal)'
      ''
      
        '      Where (df.data between (:datainicial) and (:datafinal)) an' +
        'd df.contrato is null'
      '              and df.situacao='#39'N'#39
      '              and eHNotaFiscalSaidaVenda(pdf.codigofiscal)'
      '        and not coalesce(df.notavinculada,false) and'
      #9#9#9'   coalesce(df.desconto,0)<>0'
      ''
      ''
      '    )'
      ''
      #9#9'union all'
      ''
      ''
      #9'('
      ''
      #9'  /* IMPOSTOS - REGIME SIMPLES */'
      ''
      '     select impostos.tipoproduto,'
      
        '            cast('#39'IMPOSTOS - '#39' as varchar)||cast(impostos.descri' +
        'caotipoproduto as varchar) as descricaotipoproduto,'
      '            impostos.grupo,'
      '            impostos.descricaogrupo,'
      '            impostos.classe,'
      '            impostos.descricaoclasse,'
      
        '            - sum(case when coalesce(impostos.aliquotaicmssn,0) ' +
        '= 0 then 0  else impostos.ValorBrutodoProduto * impostos.aliquot' +
        'aicmssn / 100 end) as ValorBrutodoProduto'
      #9'from'
      ''
      #9'('
      ''
      '      ('
      
        '            /* VENDAS COM CONTRATO BRUTO + ACRESIMCO - DESCONTO ' +
        '*/'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      ''
      
        '  '#9'    case when :AgruparGrupo then c.grupo     else cast(null a' +
        's varchar(4)) end as grupo,'
      
        #9'    case when :AgruparGrupo then g.descricao else cast(null as ' +
        'varchar(30)) end as descricaogrupo,'
      
        #9'    case when :AGruparClasse then c.classe    else cast(null as' +
        ' varchar(2)) end as classe,'
      
        #9'    case when :AGruparClasse then cl.descricao else cast(null a' +
        's varchar(30)) end as descricaoclasse,'
      ''
      '      (select asn.aliquotaicms'
      '       from aliquotassimplesnacional asn'
      '         where asn.filial = ct.filialvenda'
      
        '         and asn.mesano = to_char(ct.faturamento, '#39'mm/yyyy'#39'))  a' +
        's aliquotaicmssn,'
      ''
      '            ((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      '            ) as  ValorBrutodoProduto'
      ''
      '            /*'
      ''
      '       VALOR BRUTO'
      '      ((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1)))) +'
      ''
      '       ACRESCIMO'
      
        '        (((ValorPrazo-ValorVista)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      
        '        ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1)))'
      ''
      '        as  ValorBrutodoProduto'
      ''
      '        */'
      ''
      ''
      '       from (contratos ct'
      '             join (produtoscontratos pc'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      ''
      '                         on p.caracteristica=c.codigo)'
      '                   on pc.produto=p.codigo)'
      '             on ct.numero = pc.contrato)'
      ''
      '       where not pc.brinde'
      
        '         and ct.faturamento between(:datainicial) and (:datafina' +
        'l)'
      '         and (coalesce(ct.valorvista,0)<>0)'
      '         and ct.origem is null'
      
        '         and (select f.regimetributario from filiais f where f.c' +
        'odigo = ct.filialvenda)=1  /* simples nacional*/'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      '        /* VENDAS SEM CONTRATO */'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      #9#9
      
        #9'    case when :AgruparGrupo then c.grupo     else cast(null as ' +
        'varchar(4)) end as grupo,'
      
        #9'    case when :AgruparGrupo then g.descricao else cast(null as ' +
        'varchar(30)) end as descricaogrupo,'
      
        #9'    case when :AGruparClasse then c.classe    else cast(null as' +
        ' varchar(2)) end as classe,'
      
        #9'    case when :AGruparClasse then cl.descricao else cast(null a' +
        's varchar(30)) end as descricaoclasse,'
      #9#9
      ''
      '      (select asn.aliquotaicms'
      '       from aliquotassimplesnacional asn'
      '         where asn.filial = df.filialvenda'
      
        '         and asn.mesano = to_char(df.data, '#39'mm/yyyy'#39'))  as aliqu' +
        'otaicmssn,'
      ''
      ''
      ''
      '      ((pdf.quantidade*pdf.precovenda) +'
      '                 coalesce(pdf.frete,0) +'
      '                coalesce(pdf.seguro,0) +'
      '             coalesce(pdf.acrescimo,0) -'
      ''
      '              coalesce(pdf.desconto,0) -'
      '      coalesce(pdf.valordescontoitem,0)'
      ''
      '      ) as ValorBrutodoProduto'
      ''
      ''
      '      /*'
      ''
      '          VALOR BRUTO'
      ''
      '      ((pdf.quantidade*pdf.precovenda) +'
      
        '        (((coalesce(df.valorfrete,0)+coalesce(df.seguro,0))*(pdf' +
        '.quantidade*pdf.precovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      '          where sdf.dadofiscal = df.numero),0)),0),1)))) +'
      ''
      '        ACRESCIMO'
      ''
      
        '        (((df.Valortotal-df.ValorVista)*(pdf.quantidade*pdf.prec' +
        'ovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      
        '                  where sdf.dadofiscal = df.numero),0)),0),1))) ' +
        ' -'
      ''
      '        DESCONTO'
      ''
      
        '      ((coalesce(df.desconto,0)*(pdf.quantidade*pdf.precovenda))' +
        '  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      ''
      ''
      '       as ValorBrutodoProduto'
      ''
      '       */'
      ''
      '        from (dadosfiscais df'
      '               join (produtosdadosfiscais pdf'
      '                     join (produtos p'
      '                           join (((caracteristicas c'
      '                                   join classes cl'
      '                                   on c.classe=cl.codigo)'
      ''
      '                                   join grupos g'
      '                                   on c.grupo = g.codigo)'
      ''
      '                                   join tiposproduto tp'
      '                                   on c.tipoproduto = tp.codigo)'
      ''
      '                           on p.caracteristica=c.codigo)'
      
        '               on pdf.produto=p.codigo) on df.numero = pdf.dadof' +
        'iscal)'
      ''
      '        Where (df.data between (:datainicial) and (:datafinal))'
      '          and df.contrato is null'
      '          and df.situacao='#39'N'#39
      '          and eHNotaFiscalSaidaVenda(pdf.codigofiscal)'
      '          and not coalesce(df.notavinculada,false)'
      
        '          and (select f.regimetributario from filiais f where f.' +
        'codigo = df.filialvenda)=1  /* simples nacional*/'
      ''
      ''
      '     )'
      ''
      '       union all'
      ''
      '     ('
      '         /* DEVOLUCOES COM CONTRATO */'
      ''
      '          select'
      ''
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        '  '#9'      case when :AgruparGrupo then c.grupo     else cast(null' +
        ' as varchar(4)) end as grupo,'
      
        #9'      case when :AgruparGrupo then g.descricao else cast(null a' +
        's varchar(30)) end as descricaogrupo,'
      
        #9'      case when :AGruparClasse then c.classe    else cast(null ' +
        'as varchar(2)) end as classe,'
      
        #9'      case when :AGruparClasse then cl.descricao else cast(null' +
        ' as varchar(30)) end as descricaoclasse,'
      #9#9'  '
      '      (select asn.aliquotaicms'
      '       from aliquotassimplesnacional asn'
      '         where asn.filial = ct.filialvenda'
      
        '         and asn.mesano = to_char(cd.devolucao, '#39'mm/yyyy'#39'))  as ' +
        'aliquotaicmssn,'
      #9#9
      #9#9
      '          - '
      '      /* VALOR BRUTO */'
      '      ((cd.valorvista + cd.desconto) +'
      '      /* ACRESCIMO*/'
      '       (cd.ValorPrazo-cd.ValorVista))'
      '      as ValorBrutodoproduto'
      ''
      '          from ((contratosdevolvidos cd'
      '                 join contratos ct'
      '                 on cd.contrato=ct.numero)'
      ''
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on cd.produto=p.codigo)'
      ''
      
        '          where cd.devolucao between(:DataInicial) and (:DataFin' +
        'al)'
      '            /* and cd.tipo = '#39'D'#39' */'
      
        '            and case when ct.os then ct.tipoequipamento in (1,2)' +
        ' and not (coalesce(ct.os_garantia,false) and ct.os_garantia_stat' +
        'us='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '            and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturad' +
        'as as outras entram pelas notas fiscais devido a cr'#233'ditos de tro' +
        'ca */'
      
        '            and (select f.regimetributario from filiais f where ' +
        'f.codigo = ct.filialvenda)=1  /* simples nacional*/'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      ''
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      '            (select asn.aliquotaicms'
      '       from aliquotassimplesnacional asn'
      '         where asn.filial = np.filial'
      
        '         and asn.mesano = to_char(np.data, '#39'mm/yyyy'#39'))  as aliqu' +
        'otaicmssn,'
      ''
      ''
      '      -'
      '      ((pnp.quantidade * pnp.precounitario)'
      '      - coalesce(pnp.valordescontoitem,0)'
      '      - coalesce(pnp.desconto,0)'
      '      + coalesce(pnp.acrescimo,0)'
      '      + coalesce(pnp.frete,0)'
      '      + coalesce(pnp.seguro,0)'
      '      + coalesce(pnp.valoripi,0)'
      '      + coalesce(pnp.icmsvalorst,0)'
      '      + coalesce(pnp.despesasacessorias,0))'
      #9'   as ValorBrutodoProduto'
      ''
      '     from (notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      
        '           on pnp.produto=p.codigo) on np.codigo = pnp.codigonot' +
        'a)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      
        '       and (select f.regimetributario from filiais f where f.cod' +
        'igo = np.filial)=1  /* simples nacional*/'
      ''
      ''
      '      )'
      ''
      ''
      '      union all'
      ''
      '      ('
      
        '         /* CONTRATOS CANCELADOS SEM CONTRATOS DEVOLVIDOS, TOTAL' +
        'MENTE CANCELADOS SEM PARCELAS PAGAS */'
      '          select'
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      ''
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      '      (select asn.aliquotaicms'
      '         from aliquotassimplesnacional asn'
      '           where asn.filial = ct.filialvenda'
      
        '           and asn.mesano = to_char(cancelados.datapagto, '#39'mm/yy' +
        'yy'#39'))  as aliquotaicmssn,'
      ''
      ''
      '            -'
      '            ((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      '            ) as  ValorBrutodoProduto'
      ''
      '        /*'
      '        -'
      '       VALOR BRUTO'
      '      (((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '        (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)' +
        '-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                     coalesce((select  sum(sc.qu' +
        'antidade*coalesce(sc.valorservico,0))'
      '          from servicoscontratos sc'
      '          where sc.contrato = ct.numero),0)),0),1))'
      '        )) +'
      ''
      '       ACRESCIMO'
      ''
      
        '       (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precove' +
        'nda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      ''
      
        '         ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)' +
        ')  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))))'
      ''
      '      as ValorBrutodoProduto'
      ''
      '      */'
      ''
      ''
      '      from (select distinct ct.numero, p.datapagto'
      '            from contratos ct, parcelas p'
      '            where ct.numero=p.contrato '
      '         and ct.situacao='#39'C'#39' '
      '         and not exists (select p2.numero'
      '                             from parcelas p2'
      '                             where p2.contrato = ct.numero '
      '                   and p2.tipopagto<>'#39'E'#39') '
      '         and p.datapagto between :datainicial and :datafinal '
      '         and not exists (select cd.contrato'
      '                             from contratosdevolvidos cd'
      
        '                             where cd.contrato = ct.numero /*and' +
        ' cd.tipo='#39'D'#39'*/)'
      
        '             and case when ct.os then ct.tipoequipamento in (1,2' +
        ') and not (coalesce(ct.os_garantia,false) and ct.os_garantia_sta' +
        'tus='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '           ) as cancelados, (contratos ct '
      '                         join (produtoscontratos pc'
      '                       join (produtos p'
      '                         join (((caracteristicas c'
      '                               join classes cl'
      '                           on c.classe = cl.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      '                          join grupos g'
      '                          on c.grupo = g.codigo)'
      ''
      '                         join tiposproduto tp'
      '                         on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                         on p.caracteristica = c' +
        '.codigo)'
      '                                   on pc.produto=p.codigo)'
      '                             on pc.contrato = ct.numero)'
      '      where cancelados.numero = ct.numero'
      
        '        and (select f.regimetributario from filiais f where f.co' +
        'digo = ct.filialvenda)=1  /* simples nacional*/'
      ''
      ''
      '      )'
      ''
      #9') as impostos'
      #9'       group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo,'
      '            grupo,'
      '            descricaoclasse,'
      '            classe,'
      #9#9#9'aliquotaicmssn'
      '   )'
      '   '
      '   union all'
      '   '
      '   '
      '  ('
      '  '
      '    /* IMPOSTOS - ICMS - REGIME NORMAL */'
      #9
      '     select impostos.tipoproduto,'
      
        '            cast('#39'IMPOSTOS - ICMS - '#39' as varchar)||cast(impostos' +
        '.descricaotipoproduto as varchar) as descricaotipoproduto,'
      '            impostos.grupo,'
      '            impostos.descricaogrupo,'
      '            impostos.classe,'
      '            impostos.descricaoclasse,'
      
        '            sum(impostos.ValorBrutodoProduto) as ValorBrutodoPro' +
        'duto '
      #9'from'#9#9
      #9
      #9'('
      #9
      '      ('
      
        '            /* VENDAS COM CONTRATO  BRUTO + ACRESIMCO - DESCONTO' +
        ' */'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      '        -'
      '          (((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      
        '            ) * Selecionar_Aliquotaicms(f.estado, ct.estado, ct.' +
        'pessoatipo, p.codigo)/100) as  ValorBrutodoProduto'
      ''
      '        /*'
      '      -'
      '       VALOR BRUTO'
      '      (((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1)))) +'
      ''
      '       ACRESCIMO'
      
        '        (((ValorPrazo-ValorVista)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      
        '        ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1))))*(1' +
        '-coalesce(c.percreducaobase,0)/100)) *'
      ''
      
        '                  Selecionar_Aliquotaicms(f.estado, ct.estado, c' +
        't.pessoatipo, p.codigo)/100)'
      '        as  ValorBrutodoProduto'
      ''
      '        */'
      ''
      ''
      '       from ((contratos ct'
      '             join (produtoscontratos pc'
      '                   join (produtos p'
      '                         join ((((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9#9' join tributosicms ti'
      #9#9#9#9#9#9#9#9' on c.incidencia = ti.codigo)'
      ''
      '                         on p.caracteristica=c.codigo)'
      '                   on pc.produto=p.codigo)'
      '             on ct.numero = pc.contrato)'
      #9#9#9' '
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = ct.filialvenda)'
      ''
      '       where not pc.brinde'
      
        '         and ct.faturamento between(:datainicial) and (:datafina' +
        'l)'
      '         and (coalesce(ct.valorvista,0)<>0)'
      '         and ct.origem is null'
      '         and f.regimetributario <> 1  /* regime normal */'
      #9#9' and ti.valor in ('#39'00'#39','#39'20'#39')'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      '        /* VENDAS SEM CONTRATO */'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      #9#9
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      '/*'
      '       -- VALOR BRUTO '
      '      ((pdf.quantidade*pdf.precovenda) +'
      
        '        (((coalesce(df.valorfrete,0)+coalesce(df.seguro,0))*(pdf' +
        '.quantidade*pdf.precovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      '          where sdf.dadofiscal = df.numero),0)),0),1)))) +'
      #9#9'  '
      '       -- ACRESCIMO '
      
        '        (((df.Valortotal-df.ValorVista)*(pdf.quantidade*pdf.prec' +
        'ovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      
        '                  where sdf.dadofiscal = df.numero),0)),0),1))) ' +
        ' -'
      #9#9#9#9'  '
      '       -- DESCONTO '#9'   '
      
        '      ((coalesce(df.desconto,0)*(pdf.quantidade*pdf.precovenda))' +
        '  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      #9#9#9#9
      '       as ValorBrutodoProduto'
      '*/'
      ''
      '       - pdf.icmsvalor as ValorBrutodoProduto'
      #9'   '
      ''
      '       from ((dadosfiscais df'
      '               join (produtosdadosfiscais pdf'
      '                     join (produtos p'
      '                           join (((caracteristicas c'
      '                                   join classes cl'
      '                                   on c.classe=cl.codigo)'
      ''
      '                                   join grupos g'
      '                                   on c.grupo = g.codigo)'
      ''
      '                                   join tiposproduto tp'
      '                                   on c.tipoproduto = tp.codigo)'
      ''
      '                           on p.caracteristica=c.codigo)'
      '                    on pdf.produto=p.codigo) '
      #9#9#9'   on df.numero = pdf.dadofiscal)'
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = df.filialvenda)'
      #9#9#9'   '
      #9#9#9'   '
      '       Where (df.data between (:datainicial) and (:datafinal))'
      '          and df.contrato is null'
      '          and df.situacao='#39'N'#39
      '          and eHNotaFiscalSaidaVenda(pdf.codigofiscal)'
      '          and not coalesce(df.notavinculada,false)'
      '          and f.regimetributario <> 1  /* regime normal */'
      #9#9'  and pdf.incidencia in ('#39'00'#39','#39'20'#39')'
      ''
      '     )'
      ''
      '       union all'
      ''
      '     ('
      '         /* DEVOLUCOES COM CONTRATO */'
      ''
      '          select'
      ''
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      #9#9
      '           '
      '      /* VALOR BRUTO */'
      '      ((((cd.valorvista + cd.desconto) +'
      '      /* ACRESCIMO*/'
      
        '       (cd.ValorPrazo-cd.ValorVista)) * (1-coalesce(c.percreduca' +
        'obase,0)/100)) * Selecionar_Aliquotaicms(f.estado, ct.estado, ct' +
        '.pessoatipo, p.codigo)/100) as ValorBrutodoproduto'
      ''
      '          from ((contratosdevolvidos cd'
      '                 join (contratos ct'
      #9#9#9#9'       join filiais f'
      #9#9#9#9#9'   on ct.filialvenda = f.codigo)'
      '                 on cd.contrato=ct.numero)'
      ''
      '                 join (produtos p'
      '                       join ((((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      #9#9#9#9#9#9#9'   join tributosicms ti'
      #9#9#9#9#9#9#9'   on c.incidencia = ti.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on cd.produto=p.codigo)'
      ''
      
        '          where cd.devolucao between(:DataInicial) and (:DataFin' +
        'al)'
      '            /* and cd.tipo = '#39'D'#39' */'
      
        '            and case when ct.os then ct.tipoequipamento in (1,2)' +
        ' and not (coalesce(ct.os_garantia,false) and ct.os_garantia_stat' +
        'us='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '            and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturad' +
        'as as outras entram pelas notas fiscais devido a cr'#233'ditos de tro' +
        'ca */'
      '            and f.regimetributario <> 1  /* regime normal */'
      #9#9#9'and ti.valor in ('#39'00'#39','#39'20'#39')'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      '      pnp.icmsvalor as ValorBrutodoProduto'
      ''
      '     from ((notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join ((((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      #9#9#9#9#9#9#9'   join tributosicms ti'
      #9#9#9#9#9#9#9'   on c.incidencia = ti.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on pnp.produto=p.codigo) '
      #9#9'   on np.codigo = pnp.codigonota)'
      #9#9'   '
      '           join filiais f'
      #9'       on np.filial = f.codigo)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      #9'   and f.regimetributario <> 1  /* regime normal */'
      #9'   and ti.valor in ('#39'00'#39','#39'20'#39')'
      ''
      '      )'
      ''
      ''
      '      union all'
      ''
      '      ('
      
        '         /* CONTRATOS CANCELADOS SEM CONTRATOS DEVOLVIDOS, TOTAL' +
        'MENTE CANCELADOS SEM PARCELAS PAGAS */'
      '          select'
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      ''
      '            (((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      
        '            ) * Selecionar_Aliquotaicms(f.estado, ct.estado, ct.' +
        'pessoatipo, p.codigo)/100 ) as  ValorBrutodoProduto'
      ''
      '            /*'
      ''
      '       VALOR BRUTO'
      '      (((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '        (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)' +
        '-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                     coalesce((select  sum(sc.qu' +
        'antidade*coalesce(sc.valorservico,0))'
      '          from servicoscontratos sc'
      '          where sc.contrato = ct.numero),0)),0),1))'
      '        )) +'
      ''
      '       ACRESCIMO'
      ''
      
        '       (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precove' +
        'nda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '        DESCONTO'
      
        '         ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)' +
        ')  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1)))) * ' +
        '(1-coalesce(c.percreducaobase,0)/100)) * Selecionar_Aliquotaicms' +
        '(f.estado, ct.estado, ct.pessoatipo, p.codigo)/100)'
      ''
      '      as ValorBrutodoProduto'
      '      */'
      #9'  '
      #9'  '
      '      from (select distinct ct.numero, p.datapagto'
      '            from contratos ct, parcelas p'
      '            where ct.numero=p.contrato '
      '         and ct.situacao='#39'C'#39' '
      '         and not exists (select p2.numero'
      '                             from parcelas p2'
      '                             where p2.contrato = ct.numero '
      '                   and p2.tipopagto<>'#39'E'#39') '
      '         and p.datapagto between :datainicial and :datafinal '
      '         and not exists (select cd.contrato'
      '                             from contratosdevolvidos cd'
      
        '                             where cd.contrato = ct.numero /*and' +
        ' cd.tipo='#39'D'#39'*/)'
      
        '             and case when ct.os then ct.tipoequipamento in (1,2' +
        ') and not (coalesce(ct.os_garantia,false) and ct.os_garantia_sta' +
        'tus='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '           ) as cancelados, ((contratos ct '
      '                             join (produtoscontratos pc'
      '                                   join (produtos p'
      
        '                                         join ((((caracteristica' +
        's c'
      '                                                 join classes cl'
      
        '                                                 on c.classe = c' +
        'l.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      '                                                 join grupos g'
      
        '                                                 on c.grupo = g.' +
        'codigo)'
      ''
      
        '                                                join tiposprodut' +
        'o tp'
      
        '                                                on c.tipoproduto' +
        ' = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9#9
      #9#9#9#9#9#9#9#9#9#9#9#9'join tributosicms ti'
      #9#9#9#9#9#9#9'                    on c.incidencia = ti.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                         on p.caracteristica = c' +
        '.codigo)'
      '                                   on pc.produto=p.codigo)'
      '                             on pc.contrato = ct.numero)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' join filiais f'
      #9#9#9#9#9'         on ct.filialvenda = f.codigo)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' '
      '      where cancelados.numero = ct.numero'
      #9#9'and f.regimetributario <> 1  /* regime normal */'
      #9#9'and ti.valor in ('#39'00'#39','#39'20'#39')'
      ''
      ''
      '      )'
      ''
      #9') as impostos'
      #9'       group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo,'
      '            grupo,'
      '            descricaoclasse,'
      '            classe'
      '   )'
      '   '
      '   union all'
      '   '
      '   ('
      '   '
      '   '
      '    /* IMPOSTOS - PIS - REGIME NORMAL */'
      #9
      '     select impostos.tipoproduto,'
      
        '            cast('#39'IMPOSTOS - PIS - '#39' as varchar)||cast(impostos.' +
        'descricaotipoproduto as varchar) as descricaotipoproduto,'
      '            impostos.grupo,'
      '            impostos.descricaogrupo,'
      '            impostos.classe,'
      '            impostos.descricaoclasse,'
      
        '            sum(impostos.ValorBrutodoProduto) as ValorBrutodoPro' +
        'duto '
      #9'from'#9#9
      #9
      #9'('
      #9
      '      ('
      
        '            /* VENDAS COM CONTRATO BRUTO + ACRESIMCO - DESCONTO ' +
        '*/'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      '           -'
      '          (((pc.quantidade*pc.precovenda) +'
      ''
      '                    coalesce(pc.frete,0) +'
      '                   coalesce(pc.seguro,0) +'
      '                coalesce(pc.acrescimo,0) -'
      '            coalesce(pc.descontogeral,0)'
      ''
      
        '          ) * coalesce(c.aliquotapis,0)/100) as  ValorBrutodoPro' +
        'duto'
      ''
      '          /*'
      ''
      '      -'
      '       VALOR BRUTO'
      '      ((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1)))) +'
      ''
      '       ACRESCIMO'
      
        '        (((ValorPrazo-ValorVista)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      
        '        ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1)))) * ' +
        'coalesce(c.aliquotapis,0)/100)'
      ''
      '        as  ValorBrutodoProduto'
      '        */'
      ''
      ''
      '       from ((contratos ct'
      '             join (produtoscontratos pc'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9' '
      '                         on p.caracteristica=c.codigo)'
      '                   on pc.produto=p.codigo)'
      '             on ct.numero = pc.contrato)'
      #9#9#9' '
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = ct.filialvenda)'
      ''
      '       where not pc.brinde'
      
        '         and ct.faturamento between(:datainicial) and (:datafina' +
        'l)'
      '         and (coalesce(ct.valorvista,0)<>0)'
      '         and ct.origem is null'
      '         and f.regimetributario <> 1  /* regime normal */'
      #9#9' and c.piscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      #9#9' and coalesce(c.aliquotapis,0)<>0'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      '        /* VENDAS SEM CONTRATO */'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      #9#9
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      #9#9'-'
      '       (((pdf.quantidade * pdf.precovenda)'
      '         - coalesce(pdf.valordescontoitem,0)'
      '         - coalesce(pdf.desconto,0)'
      '         + coalesce(pdf.acrescimo,0)'
      '         + coalesce(pdf.frete,0)'
      '         + coalesce(pdf.seguro,0)'
      '         + coalesce(pdf.valoripi,0)'
      
        '         + coalesce(pdf.despesasacessorias,0)) * coalesce(c.aliq' +
        'uotapis,0)/100) as ValorBrutodoProduto'
      #9#9
      #9#9#9#9#9#9
      '/*'
      '       -- VALOR BRUTO '
      '      ((pdf.quantidade*pdf.precovenda) +'
      
        '        (((coalesce(df.valorfrete,0)+coalesce(df.seguro,0))*(pdf' +
        '.quantidade*pdf.precovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      '          where sdf.dadofiscal = df.numero),0)),0),1)))) +'
      #9#9'  '
      '       -- ACRESCIMO '
      
        '        (((df.Valortotal-df.ValorVista)*(pdf.quantidade*pdf.prec' +
        'ovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      
        '                  where sdf.dadofiscal = df.numero),0)),0),1))) ' +
        ' -'
      #9#9#9#9'  '
      '       -- DESCONTO '#9'   '
      
        '      ((coalesce(df.desconto,0)*(pdf.quantidade*pdf.precovenda))' +
        '  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      #9#9#9#9
      '       as ValorBrutodoProduto'
      '*/'#9'   '
      ''
      #9'   '
      ''
      '       from ((dadosfiscais df'
      '               join (produtosdadosfiscais pdf'
      '                     join (produtos p'
      '                           join (((caracteristicas c'
      '                                   join classes cl'
      '                                   on c.classe=cl.codigo)'
      ''
      '                                   join grupos g'
      '                                   on c.grupo = g.codigo)'
      ''
      '                                   join tiposproduto tp'
      '                                   on c.tipoproduto = tp.codigo)'
      ''
      '                           on p.caracteristica=c.codigo)'
      '                    on pdf.produto=p.codigo) '
      #9#9#9'   on df.numero = pdf.dadofiscal)'
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = df.filialvenda)'
      #9#9#9'   '
      #9#9#9'   '
      '       Where (df.data between (:datainicial) and (:datafinal))'
      '          and df.contrato is null'
      '          and df.situacao='#39'N'#39
      
        '          and ((eHNotaFiscalSaidaVenda(pdf.codigofiscal) and c.p' +
        'iscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')) or /* vendas */'
      
        #9#9'       (eHNotaFiscalSaidaDevolucao(pdf.codigofiscal) and c.pis' +
        'cst in ('#39'49'#39')))    /* devolu'#231#245'es de compras, conforme regra do s' +
        'ped */'
      '          and not coalesce(df.notavinculada,false)'
      '          and f.regimetributario <> 1  /* regime normal */'
      #9#9'  '
      ''
      '     )'
      ''
      '       union all'
      ''
      '     ('
      '         /* DEVOLUCOES COM CONTRATO */'
      ''
      '          select'
      ''
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      #9#9
      '           '
      '      /* VALOR BRUTO */'
      '      (((cd.valorvista + cd.desconto) +'
      '      /* ACRESCIMO*/'
      
        '       (cd.ValorPrazo-cd.ValorVista)) * coalesce(c.aliquotapis,0' +
        ')/100) as ValorBrutodoproduto'
      ''
      '          from ((contratosdevolvidos cd'
      '                 join (contratos ct'
      #9#9#9#9'       join filiais f'
      #9#9#9#9#9'   on ct.filialvenda = f.codigo)'
      '                 on cd.contrato=ct.numero)'
      ''
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      '                       on p.caracteristica=c.codigo)'
      '                 on cd.produto=p.codigo)'
      ''
      
        '          where cd.devolucao between(:DataInicial) and (:DataFin' +
        'al)'
      '            /* and cd.tipo = '#39'D'#39' */'
      
        '            and case when ct.os then ct.tipoequipamento in (1,2)' +
        ' and not (coalesce(ct.os_garantia,false) and ct.os_garantia_stat' +
        'us='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '            and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturad' +
        'as as outras entram pelas notas fiscais devido a cr'#233'ditos de tro' +
        'ca */'
      '            and f.regimetributario <> 1  /* regime normal */'
      #9#9#9'and c.piscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      #9'  '
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      #9'  '
      #9'  '
      '      ((pnp.quantidade * pnp.precounitario)'
      '      - coalesce(pnp.valordescontoitem,0)'
      '      - coalesce(pnp.desconto,0)'
      '      + coalesce(pnp.acrescimo,0)'
      '      + coalesce(pnp.frete,0)'
      '      + coalesce(pnp.seguro,0)'
      '      + coalesce(pnp.valoripi,0)'
      
        '      + coalesce(pnp.despesasacessorias,0)) * coalesce(c.aliquot' +
        'apis,0)/100'
      #9'   as ValorBrutodoProduto'
      #9'   '
      ''
      '     from ((notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      '                       on p.caracteristica=c.codigo)'
      '                 on pnp.produto=p.codigo) '
      #9#9'   on np.codigo = pnp.codigonota)'
      #9#9'   '
      '           join filiais f'
      #9'       on np.filial = f.codigo)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      #9'   and f.regimetributario <> 1  /* regime normal */'
      
        #9'   and c.piscst in ('#39'50'#39','#39'51'#39','#39'52'#39','#39'53'#39','#39'54'#39','#39'55'#39','#39'56'#39','#39'60'#39','#39'61' +
        #39','#39'62'#39','#39'63'#39','#39'64'#39','#39'65'#39','#39'66'#39')'
      ''
      '      )'
      ''
      ''
      '      union all'
      ''
      '      ('
      
        '         /* CONTRATOS CANCELADOS SEM CONTRATOS DEVOLVIDOS, TOTAL' +
        'MENTE CANCELADOS SEM PARCELAS PAGAS */'
      '          select'
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      '          (((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      
        '            ) * coalesce(c.aliquotapis,0)/100) as  ValorBrutodoP' +
        'roduto'
      ''
      '            /*'
      ''
      '       VALOR BRUTO'
      '      ((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '        (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)' +
        '-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                     coalesce((select  sum(sc.qu' +
        'antidade*coalesce(sc.valorservico,0))'
      '          from servicoscontratos sc'
      '          where sc.contrato = ct.numero),0)),0),1))'
      '        )) +'
      ''
      '       ACRESCIMO'
      ''
      
        '       (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precove' +
        'nda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      
        '         ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)' +
        ')  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1)))) * ' +
        'coalesce(c.aliquotapis,0)/100) as ValorBrutodoProduto'
      ''
      '                  */'
      ''
      ''
      '      from (select distinct ct.numero, p.datapagto'
      '            from contratos ct, parcelas p'
      '            where ct.numero=p.contrato'
      '         and ct.situacao='#39'C'#39
      '         and not exists (select p2.numero'
      '                             from parcelas p2'
      '                             where p2.contrato = ct.numero '
      '                   and p2.tipopagto<>'#39'E'#39') '
      '         and p.datapagto between :datainicial and :datafinal '
      '         and not exists (select cd.contrato'
      '                             from contratosdevolvidos cd'
      
        '                             where cd.contrato = ct.numero /*and' +
        ' cd.tipo='#39'D'#39'*/)'
      
        '             and case when ct.os then ct.tipoequipamento in (1,2' +
        ') and not (coalesce(ct.os_garantia,false) and ct.os_garantia_sta' +
        'tus='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '           ) as cancelados, ((contratos ct '
      '                             join (produtoscontratos pc'
      '                                   join (produtos p'
      
        '                                         join (((caracteristicas' +
        ' c'
      '                                                 join classes cl'
      
        '                                                 on c.classe = c' +
        'l.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      '                                                 join grupos g'
      
        '                                                 on c.grupo = g.' +
        'codigo)'
      ''
      
        '                                                join tiposprodut' +
        'o tp'
      
        '                                                on c.tipoproduto' +
        ' = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                         on p.caracteristica = c' +
        '.codigo)'
      '                                   on pc.produto=p.codigo)'
      '                             on pc.contrato = ct.numero)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' join filiais f'
      #9#9#9#9#9'         on ct.filialvenda = f.codigo)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' '
      '      where cancelados.numero = ct.numero'
      #9#9'and f.regimetributario <> 1  /* regime normal */'
      #9#9'and c.piscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      ''
      ''
      '      )'
      ''
      #9') as impostos'
      #9'       group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo,'
      '            grupo,'
      '            descricaoclasse,'
      '            classe'
      ''
      '   )'
      '   '
      '   union all'
      '   '
      '   ('
      '   '
      '   '
      '    /* IMPOSTOS - COFINS - REGIME NORMAL */'
      #9
      '     select impostos.tipoproduto,'
      
        '            cast('#39'IMPOSTOS - COFINS - '#39' as varchar)||cast(impost' +
        'os.descricaotipoproduto as varchar) as descricaotipoproduto,'
      '            impostos.grupo,'
      '            impostos.descricaogrupo,'
      '            impostos.classe,'
      '            impostos.descricaoclasse,'
      
        '            sum(impostos.ValorBrutodoProduto) as ValorBrutodoPro' +
        'duto '
      #9'from'#9#9
      #9
      #9'('
      ''
      '      ('
      
        '            /* VENDAS COM CONTRATO BRUTO + ACRESIMCO - DESCONTO ' +
        '*/'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      ''
      
        #9'case when :AgruparGrupo then c.grupo     else cast(null as varc' +
        'har(4)) end as grupo,'
      
        #9'case when :AgruparGrupo then g.descricao else cast(null as varc' +
        'har(30)) end as descricaogrupo,'
      
        #9'case when :AGruparClasse then c.classe    else cast(null as var' +
        'char(2)) end as classe,'
      
        #9'case when :AGruparClasse then cl.descricao else cast(null as va' +
        'rchar(30)) end as descricaoclasse,'
      ''
      '          -'
      '          (((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      
        '            ) * coalesce(c.aliquotacofins,0)/100) as  ValorBruto' +
        'doProduto'
      ''
      '        /*'
      ''
      '      -'
      '       VALOR BRUTO'
      '      ((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1)))) +'
      ''
      '       ACRESCIMO'
      
        '        (((ValorPrazo-ValorVista)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      
        '        ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1)))) * ' +
        'coalesce(c.aliquotacofins,0)/100)'
      ''
      '        as  ValorBrutodoProduto'
      ''
      '        */'
      ''
      ''
      '       from ((contratos ct'
      '             join (produtoscontratos pc'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9' '
      '                         on p.caracteristica=c.codigo)'
      '                   on pc.produto=p.codigo)'
      '             on ct.numero = pc.contrato)'
      #9#9#9' '
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = ct.filialvenda)'
      ''
      '       where not pc.brinde'
      
        '         and ct.faturamento between(:datainicial) and (:datafina' +
        'l)'
      '         and (coalesce(ct.valorvista,0)<>0)'
      '         and ct.origem is null'
      '         and f.regimetributario <> 1  /* regime normal */'
      #9#9' and c.cofinscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      #9#9' and coalesce(c.aliquotacofins,0)<>0'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      '        /* VENDAS SEM CONTRATO */'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      #9#9
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      #9#9'-'
      '       (((pdf.quantidade * pdf.precovenda)'
      '         - coalesce(pdf.valordescontoitem,0)'
      '         - coalesce(pdf.desconto,0)'
      '         + coalesce(pdf.acrescimo,0)'
      '         + coalesce(pdf.frete,0)'
      '         + coalesce(pdf.seguro,0)'
      '         + coalesce(pdf.valoripi,0)'
      
        '         + coalesce(pdf.despesasacessorias,0)) * coalesce(c.aliq' +
        'uotacofins,0)/100) as ValorBrutodoProduto'
      #9#9
      #9#9#9#9#9#9
      '/*'
      '       -- VALOR BRUTO '
      '      ((pdf.quantidade*pdf.precovenda) +'
      
        '        (((coalesce(df.valorfrete,0)+coalesce(df.seguro,0))*(pdf' +
        '.quantidade*pdf.precovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      '          where sdf.dadofiscal = df.numero),0)),0),1)))) +'
      #9#9'  '
      '       -- ACRESCIMO '
      
        '        (((df.Valortotal-df.ValorVista)*(pdf.quantidade*pdf.prec' +
        'ovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      
        '                  where sdf.dadofiscal = df.numero),0)),0),1))) ' +
        ' -'
      #9#9#9#9'  '
      '       -- DESCONTO '#9'   '
      
        '      ((coalesce(df.desconto,0)*(pdf.quantidade*pdf.precovenda))' +
        '  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      #9#9#9#9
      '       as ValorBrutodoProduto'
      '*/'#9'   '
      ''
      #9'   '
      ''
      '       from ((dadosfiscais df'
      '               join (produtosdadosfiscais pdf'
      '                     join (produtos p'
      '                           join (((caracteristicas c'
      '                                   join classes cl'
      '                                   on c.classe=cl.codigo)'
      ''
      '                                   join grupos g'
      '                                   on c.grupo = g.codigo)'
      ''
      '                                   join tiposproduto tp'
      '                                   on c.tipoproduto = tp.codigo)'
      ''
      '                           on p.caracteristica=c.codigo)'
      '                    on pdf.produto=p.codigo) '
      #9#9#9'   on df.numero = pdf.dadofiscal)'
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = df.filialvenda)'
      #9#9#9'   '
      #9#9#9'   '
      '       Where (df.data between (:datainicial) and (:datafinal))'
      '          and df.contrato is null'
      '          and df.situacao='#39'N'#39
      
        '          and ((eHNotaFiscalSaidaVenda(pdf.codigofiscal) and c.c' +
        'ofinscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')) or /* vendas */'
      
        #9#9'       (eHNotaFiscalSaidaDevolucao(pdf.codigofiscal) and c.cof' +
        'inscst in ('#39'49'#39')))    /* devolu'#231#245'es de compras, conforme regra d' +
        'o sped */'
      '          and not coalesce(df.notavinculada,false)'
      '          and f.regimetributario <> 1  /* regime normal */'
      #9#9'  '
      ''
      '     )'
      ''
      '       union all'
      ''
      '     ('
      '         /* DEVOLUCOES COM CONTRATO */'
      ''
      '          select'
      ''
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      #9#9
      '           '
      '      /* VALOR BRUTO */'
      '      (((cd.valorvista + cd.desconto) +'
      '      /* ACRESCIMO*/'
      
        '       (cd.ValorPrazo-cd.ValorVista)) * coalesce(c.aliquotacofin' +
        's,0)/100) as ValorBrutodoproduto'
      ''
      '          from ((contratosdevolvidos cd'
      '                 join (contratos ct'
      #9#9#9#9'       join filiais f'
      #9#9#9#9#9'   on ct.filialvenda = f.codigo)'
      '                 on cd.contrato=ct.numero)'
      ''
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      '                       on p.caracteristica=c.codigo)'
      '                 on cd.produto=p.codigo)'
      ''
      
        '          where cd.devolucao between(:DataInicial) and (:DataFin' +
        'al)'
      '            /* and cd.tipo = '#39'D'#39' */'
      
        '            and case when ct.os then ct.tipoequipamento in (1,2)' +
        ' and not (coalesce(ct.os_garantia,false) and ct.os_garantia_stat' +
        'us='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '            and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturad' +
        'as as outras entram pelas notas fiscais devido a cr'#233'ditos de tro' +
        'ca */'
      '            and f.regimetributario <> 1  /* regime normal */'
      #9#9#9'and c.cofinscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      #9'  '
      #9'  '
      '      ((pnp.quantidade * pnp.precounitario)'
      '      - coalesce(pnp.valordescontoitem,0)'
      '      - coalesce(pnp.desconto,0)'
      '      + coalesce(pnp.acrescimo,0)'
      '      + coalesce(pnp.frete,0)'
      '      + coalesce(pnp.seguro,0)'
      '      + coalesce(pnp.valoripi,0)'
      
        '      + coalesce(pnp.despesasacessorias,0)) * coalesce(c.aliquot' +
        'acofins,0)/100'
      #9'   as ValorBrutodoProduto'
      #9'   '
      ''
      '     from ((notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      '                       on p.caracteristica=c.codigo)'
      '                 on pnp.produto=p.codigo) '
      #9#9'   on np.codigo = pnp.codigonota)'
      #9#9'   '
      '           join filiais f'
      #9'       on np.filial = f.codigo)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      #9'   and f.regimetributario <> 1  /* regime normal */'
      
        #9'   and c.cofinscst in ('#39'50'#39','#39'51'#39','#39'52'#39','#39'53'#39','#39'54'#39','#39'55'#39','#39'56'#39','#39'60'#39',' +
        #39'61'#39','#39'62'#39','#39'63'#39','#39'64'#39','#39'65'#39','#39'66'#39')'
      ''
      '      )'
      ''
      ''
      '      union all'
      ''
      '      ('
      
        '         /* CONTRATOS CANCELADOS SEM CONTRATOS DEVOLVIDOS, TOTAL' +
        'MENTE CANCELADOS SEM PARCELAS PAGAS */'
      '          select'
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      ''
      '          (((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      
        '            ) * coalesce(c.aliquotacofins,0)/100) as  ValorBruto' +
        'doProduto'
      ''
      '        /*'
      ''
      '       VALOR BRUTO'
      '      ((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '        (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)' +
        '-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                     coalesce((select  sum(sc.qu' +
        'antidade*coalesce(sc.valorservico,0))'
      '          from servicoscontratos sc'
      '          where sc.contrato = ct.numero),0)),0),1))'
      '        )) +'
      ''
      '       ACRESCIMO'
      ''
      
        '       (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precove' +
        'nda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      
        '         ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)' +
        ')  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1)))) * ' +
        'coalesce(c.aliquotacofins,0)/100) as ValorBrutodoProduto'
      '       */'
      ''
      '      from (select distinct ct.numero, p.datapagto'
      '            from contratos ct, parcelas p'
      '            where ct.numero=p.contrato'
      '         and ct.situacao='#39'C'#39
      '         and not exists (select p2.numero'
      '                             from parcelas p2'
      '                             where p2.contrato = ct.numero'
      '                   and p2.tipopagto<>'#39'E'#39')'
      '         and p.datapagto between :datainicial and :datafinal'
      '         and not exists (select cd.contrato'
      '                             from contratosdevolvidos cd'
      
        '                             where cd.contrato = ct.numero /*and' +
        ' cd.tipo='#39'D'#39'*/)'
      
        '             and case when ct.os then ct.tipoequipamento in (1,2' +
        ') and not (coalesce(ct.os_garantia,false) and ct.os_garantia_sta' +
        'tus='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '           ) as cancelados, ((contratos ct '
      '                             join (produtoscontratos pc'
      '                                   join (produtos p'
      
        '                                         join (((caracteristicas' +
        ' c'
      '                                                 join classes cl'
      
        '                                                 on c.classe = c' +
        'l.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      '                                                 join grupos g'
      
        '                                                 on c.grupo = g.' +
        'codigo)'
      ''
      
        '                                                join tiposprodut' +
        'o tp'
      
        '                                                on c.tipoproduto' +
        ' = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                         on p.caracteristica = c' +
        '.codigo)'
      '                                   on pc.produto=p.codigo)'
      '                             on pc.contrato = ct.numero)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' join filiais f'
      #9#9#9#9#9'         on ct.filialvenda = f.codigo)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' '
      '      where cancelados.numero = ct.numero'
      #9#9'and f.regimetributario <> 1  /* regime normal */'
      #9#9'and c.cofinscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      ''
      ''
      '      )'
      ''
      #9') as impostos'
      #9'       group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo, grupo,'
      '            descricaoclasse, classe'
      ''
      '   )'
      ''
      '   '
      '  ) as dev'
      '       group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo, grupo, descricaoclasse, classe'
      ''
      ''
      ')'
      ''
      ') as sel'
      'where valorBrutodoProduto is not null'
      ''
      '   order by classificacao,  descricaoclassificacao,'
      '            tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo, grupo,'
      '            descricaoclasse, classe')
    RequestLive = False
    Left = 440
    Top = 408
    ParamData = <
      item
        DataType = ftString
        Name = 'AgruparGrupo'
        ParamType = ptUnknown
        Value = 'true'
      end
      item
        DataType = ftUnknown
        Name = 'AGruparClasse'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'datainicial'
        ParamType = ptUnknown
        Value = #39'2015-01-01'#39
      end
      item
        DataType = ftString
        Name = 'datafinal'
        ParamType = ptUnknown
        Value = #39'2015-01-31'#39
      end>
  end
  object qryDespesasOperacionais_Tentativa_3: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '/* qryDespesasOperacionais */'
      ''
      ';'
      'select cast(3 as integer) as classificacao,'
      
        '       cast('#39'(-) DESPESAS OPERACIONAIS'#39' as varchar(50)) as descr' +
        'icaoclassificacao,'
      
        '       evento, tipo, classificacaoevento, descricaoevento, sum(v' +
        'alor) as valor'
      ''
      'from'
      '('
      ''
      '  ('
      '  '
      '  select e.codigo as evento,'
      '         e.descricao as descricaoevento,'
      '         e.tipo,'
      '         e.classificacao as classificacaoevento,'
      '         sum(lista.valor) as valor'
      ''
      '  from'
      '  ('
      
        '  select cast(unnest(pg_catalog.string_to_array(codigos_eventos,' +
        #39','#39')) as integer) as evento,'
      '         valor'
      '  from'
      '  ('
      ''
      '     select'
      ''
      ''
      '         (select string_agg(CAST(es.codigo as varchar), '#39','#39')'
      '          from eventos es'
      '          where /*es.tipomovimentacao='#39'S'#39
      
        '            and */ position(es.classificacao in e.classificacao)' +
        '=1'
      
        '            and case when es.tipo = '#39'A'#39' then es.codigo = dp.even' +
        'to else true  end'
      '          ) as codigos_eventos,'
      ''
      '         case when e.tipomovimentacao='#39'S'#39' then'
      ''
      '           - abs(dp.valor) else'
      ''
      '             abs(dp.valor)'
      ''
      '         end as valor'
      ''
      '     from'
      ''
      '      ('
      ''
      '        select distinct'
      ''
      '            dp.numero,'
      ''
      '            case when :Regime = '#39'Compet'#234'ncia'#39' and'
      '                       not coalesce(dp.regimedecaixa,false) then'
      '               cast(null as integer)'
      '            else d.numero end as numeroduplicata,'
      ''
      '            case when :Regime = '#39'Caixa'#39' then'
      '                      d.valorvencto'
      ''
      '                 when :Regime = '#39'Compet'#234'ncia'#39' then'
      ''
      
        '                    case when coalesce(dp.regimedecaixa,false) t' +
        'hen'
      '                      d.valorvencto'
      '                    else'
      '                      dp.valor -'
      '                      dp.IRRetido -'
      '                      dp.INSSRetido -'
      '                      dp.ISSRetido -'
      '                      dp.PISRetido -'
      '                      dp.COFINSRetido -'
      '                      dp.CSLLRetido -'
      '                      dp.PISCOFINSCSLLRetido'
      '                    end'
      ''
      '                 else d.valorvencto'
      '            end as valor,'
      ''
      '            case when d.datapagto is not null then'
      '               d.evento else'
      '              dp.evento end as evento'
      ''
      '        from documentospag dp'
      '             join duplicatas d'
      '             on dp.numero = d.documentopag'
      ''
      '        where case when :Regime = '#39'Caixa'#39' then'
      
        '                        d.datapagto between :DataInicial and :Da' +
        'taFinal'
      '                   when :Regime = '#39'Compet'#234'ncia'#39' then'
      
        '                      case when coalesce(dp.regimedecaixa,false)' +
        ' then'
      
        '                        d.datavencto between :DataInicial and :D' +
        'ataFinal else'
      
        '                        dp.datalancto between :DataInicial and :' +
        'DataFinal end'
      
        '                   else d.datavencto between :DataInicial and :D' +
        'ataFinal end'
      ''
      ''
      '          /*and e.tipomovimentacao ='#39'S'#39'*/'
      '          and not coalesce(dp.previsao,false)'
      ''
      '      ) as dp join eventos e'
      '              on dp.evento = e.codigo'
      '        where coalesce(e.incluirnadre,false)'
      ''
      ''
      ''
      ''
      '  ) as lista'
      '  ) as lista'
      '    join eventos e on lista.evento = e.codigo'
      ''
      '  group by e.codigo, e.descricao'
      '  order by e.classificacao, e.tipo, e.codigo, e.descricao'
      '  )'
      ''
      '  union all'
      ''
      '  ('
      '  '
      '    select e.codigo as evento,'
      '         e.descricao as descricaoevento,'
      '         e.tipo,'
      '         e.classificacao as classificacaoevento,'
      '         sum(lista.valor) as valor'
      ''
      '  from'
      '  (                  '
      
        '  select cast(unnest(pg_catalog.string_to_array(codigos_eventos,' +
        #39','#39')) as integer) as evento,'
      '         valor'
      '  from'
      '  ('
      ''
      '   select'
      ''
      ''
      '         (select string_agg(CAST(es.codigo as varchar), '#39','#39')'
      '          from eventos es'
      '          where /*es.tipomovimentacao='#39'S'#39
      
        '            and */ position(es.classificacao in e.classificacao)' +
        '=1'
      
        '            and case when es.tipo = '#39'A'#39' then es.codigo = mbe.eve' +
        'nto else true  end'
      '          ) as codigos_eventos,'
      ''
      
        '         case when e.tipomovimentacao='#39'S'#39' then  - abs(mbe.valor)' +
        ' else abs(mbe.valor) end as valor'
      '  '
      '  '
      '  from movtosbancos mb'
      '       join movtosbancoseventos mbe'
      '            join eventos e on mbe.evento = e.codigo'
      '        on mb.conta = mbe.conta'
      '        and mb.data = mbe.data'
      '        and mb.sequencia = mbe.sequencia    '
      '  where mbe.data between :DataInicial and :DataFinal'
      '    and mb.origemlancto = '#39'B'#39
      '    and coalesce(e.incluirnadre,false)'
      '    /* and e.tipomovimentacao = '#39'S'#39' */'
      ''
      '  order by mbe.evento, e.descricao'
      '  '
      '  ) as lista '
      '  ) as lista'
      '    join eventos e on lista.evento = e.codigo'
      '  '
      '  group by e.codigo, e.descricao'
      '  order by e.classificacao, e.tipo, e.codigo, e.descricao'
      '  '
      '  )'
      ') as despesasoperacionais'
      'group by classificacaoevento, tipo, descricaoevento, evento'
      'order by classificacaoevento, tipo, descricaoevento, evento'
      ''
      ''
      '')
    RequestLive = False
    Left = 440
    Top = 464
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'Regime'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'datainicial'
        ParamType = ptUnknown
        Value = #39'2015-01-01'#39
      end
      item
        DataType = ftString
        Name = 'datafinal'
        ParamType = ptUnknown
        Value = #39'2015-01-31'#39
      end>
  end
  object qryReceita_Operacional_Bruta_Regime_de_Caixa: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select sel.*'
      'from'
      '('
      ''
      '('
      '   /* VENDAS COM CONTRATOS */'
      '  select cast(1 as integer) as classificacao,'
      
        '         cast('#39'RECEITA OPERACIONAL BRUTA'#39' as varchar(50)) as des' +
        'cricaoclassificacao,'
      '         vp.tipoproduto,'
      '         vp.descricaotipoproduto,'
      '         vp.grupo,'
      '         vp.descricaogrupo,'
      '         vp.classe,'
      '         vp.descricaoclasse,'
      ''
      '         vp.documento,'
      '         vp.data,'
      '         vp.cliente,'
      '         vp.tipocliente,'
      '         vp.nomecliente,'
      ''
      '         sum(vp.ValorBrutodoProduto) as ValorBrutodoProduto'
      '  from'
      '  ('
      '    ('
      ''
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      ''
      
        '      case when :AgruparGrupo  then c.grupo      else cast(null ' +
        'as varchar(4))  end as grupo,'
      
        '      case when :AgruparGrupo  then g.descricao  else cast(null ' +
        'as varchar(30)) end as descricaogrupo,'
      
        '      case when :AGruparClasse then c.classe     else cast(null ' +
        'as varchar(2))  end as classe,'
      
        '      case when :AGruparClasse then cl.descricao else cast(null ' +
        'as varchar(30)) end as descricaoclasse,'
      ''
      '      cast('#39'CT '#39'||ct.numero'
      '                ||'#39' Parc. '#39
      '                ||pa.numero'
      '                ||'#39' Rec. '#39
      '                ||r.controle'
      '                ||'#39'/'#39
      '                ||(select max(r2.controle)'
      '                   from recebimentos r2'
      '                   where r2.transacao = r.transacao)'
      ''
      '                as varchar(30)) as documento,'
      ''
      '      r.data_confirmacao as data,'
      '      ct.cliente,'
      '      ct.tipocliente,'
      '      ct.nome as nomecliente,'
      ''
      ''
      '      (((pc.quantidade*pc.precovenda) +'
      '                coalesce(pc.frete,0) +'
      '               coalesce(pc.seguro,0) +'
      '           coalesce(pc.acrescimo,0) ) *'
      '    r.valorlancto / ct.valorprazo) as  ValorBrutodoProduto'
      ''
      '     from (contratos ct'
      '           join (produtoscontratos pc'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on pc.produto=p.codigo)'
      '           on ct.numero = pc.contrato)'
      ''
      '           join parcelas pa'
      '                join recebimentos r'
      '                on pa.transacao = r.transacao'
      '           on pa.contrato = ct.numero'
      ''
      '     where not pc.brinde and'
      
        '               r.data_confirmacao between :datainicial and :data' +
        'final and'
      '               coalesce(r.confirmado,false) and'
      '               (coalesce(ct.valorvista,0)<>0) and'
      '               ct.origem is null and'
      '               r.situacao = '#39'N'#39
      ''
      ''
      '    )'
      '    union all'
      '    ('
      '      /* VENDAS SEM CONTRATO */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      
        '      case when :AgruparGrupo then c.grupo     else cast(null as' +
        ' varchar(4)) end as grupo,'
      
        '      case when :AgruparGrupo then g.descricao else cast(null as' +
        ' varchar(30)) end as descricaogrupo,'
      
        '      case when :AGruparClasse then c.classe    else cast(null a' +
        's varchar(2)) end as classe,'
      
        '      case when :AGruparClasse then cl.descricao else cast(null ' +
        'as varchar(30)) end as descricaoclasse,'
      ''
      '      case when n.dadofiscal is not null then'
      '        cast('#39'NF '#39'||n.numero'
      '                  ||'#39' S'#233'rie '#39
      '                  ||n.serie'
      '                  ||'#39' Rec. '#39
      '                  ||r.controle'
      '                  ||'#39'/'#39
      '                  ||(select max(r2.controle)'
      '                     from recebimentos r2'
      
        '                     where r2.transacao = r.transacao) as varcha' +
        'r(30))'
      '      else'
      '        cast('#39'CF '#39'||cp.numero'
      '                  ||'#39' Mq. '#39'||cp.maquina'
      '                  ||'#39' Int.'#39'||cp.intervensao'
      '                  ||'#39' Rec. '#39
      '                  ||r.controle'
      '                  ||'#39'/'#39
      '                  ||(select max(r2.controle)'
      '                     from recebimentos r2'
      
        '                     where r2.transacao = r.transacao) as varcha' +
        'r(30))'
      '      end as documento,'
      ''
      '      r.data_confirmacao as data,'
      '      df.cliente,'
      '      df.tipocliente,'
      '      df.nome as nomecliente,'
      ''
      ''
      '      (((pdf.quantidade*pdf.precovenda) +'
      '                 coalesce(pdf.frete,0) +'
      '                coalesce(pdf.seguro,0) +'
      '                coalesce(pdf.acrescimo,0)) *'
      '        r.valorlancto / df.valorTotal) as  ValorBrutodoProduto'
      ''
      ''
      '      from (((dadosfiscais df'
      '             join (produtosdadosfiscais pdf'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      ''
      '                         on p.caracteristica=c.codigo)'
      
        '             on pdf.produto=p.codigo) on df.numero = pdf.dadofis' +
        'cal)'
      ''
      '             left join notas n on df.numero = n.dadofiscal)'
      '             left join cupons cp on df.numero = cp.dadofiscal),'
      ''
      '             recebimentos r'
      ''
      ''
      
        '      Where r.data_confirmacao between :datainicial and :datafin' +
        'al'
      '        and df.contrato is null'
      '        and df.situacao='#39'N'#39
      '        and eHNotaFiscalSaidaVenda(pdf.codigofiscal)'
      '        and not coalesce(df.notavinculada,false)'
      '        and r.situacao = '#39'N'#39
      
        '        and not exists (select p.contrato from parcelas p where ' +
        'p.transacao = r.transacao limit 1)'
      
        '        and df.numero = (select distinct vdf.dadofiscal from ven' +
        'ctosdadosfiscais vdf where vdf.transacao = r.transacao order by ' +
        'vdf.dadofiscal desc limit 1)'
      ''
      ''
      '    )'
      '  )  as vp'
      '     group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo,'
      '            grupo,'
      '            descricaoclasse,'
      '            classe,'
      ''
      '         vp.data,'
      '         vp.documento,'
      '         vp.cliente,'
      '         vp.tipocliente,'
      '         vp.nomecliente'
      ''
      '            '
      ''
      ''
      ')'
      ''
      '  union all'
      ''
      '('
      '    select'
      ''
      '       cast(1 as integer) as classificacao,'
      
        '       cast('#39'RECEITA OPERACIONAL BRUTA'#39' as varchar(50)) as descr' +
        'icaoclassificacao,'
      ''
      '       cast('#39'09'#39' as varchar(2)) as tipoproduto,'
      
        '      (select tp.descricao from tiposproduto tp where tp.codigo ' +
        '= '#39'09'#39') as descricaotipoproduto,'
      ''
      
        '      case when :AgruparGrupo then cast('#39'SE'#39' as varchar(4))     ' +
        '   else cast(null as varchar(4)) end as grupo,'
      
        '      case when :AgruparGrupo then cast('#39'SERVICOS'#39' as varchar(30' +
        ')) else cast(null as varchar(30)) end as descricaogrupo,'
      
        '      case when :AGruparClasse then cast('#39'SE'#39' as varchar(02))   ' +
        '    else cast(null as varchar(2)) end as classe,'
      
        '      case when :AGruparClasse then cast('#39'SERVICOS'#39' as varchar(3' +
        '0)) else cast(null as varchar(30)) end as descricaoclasse,'
      ''
      '      cast('#39'CT '#39'||ct.numero'
      '                ||'#39' Parc. '#39
      '                ||pa.numero'
      '                ||'#39' Rec. '#39
      '                ||r.controle'
      '                ||'#39'/'#39
      '                ||(select max(r2.controle)'
      '                   from recebimentos r2'
      '                   where r2.transacao = r.transacao)'
      ''
      '                as varchar(30)) as documento,'
      ''
      '      r.data_confirmacao as data,'
      '      ct.cliente,'
      '      ct.tipocliente,'
      '      ct.nome as nomecliente,'
      ''
      
        '      sum((round((coalesce(sc.quantidade,0)*coalesce(sc.valorser' +
        'vico,0)),2)*'
      '      r.valorlancto / ct.valorprazo)) as  ValorBrutodoProduto'
      ''
      '   from ((contratos ct'
      '          join servicoscontratos sc'
      '          on ct.numero = sc.contrato)'
      ''
      '          join parcelas pa'
      '               join recebimentos r'
      '               on pa.transacao = r.transacao'
      '          on pa.contrato = ct.numero)'
      '          '
      ''
      
        '     where  r.data_confirmacao between(:datainicial) and (:dataf' +
        'inal) and'
      '            coalesce(r.confirmado,false) and'
      '           (coalesce(ct.valorvista,0)<>0) and'
      '            ct.origem is null and'
      '            r.situacao = '#39'N'#39
      ''
      
        '   group by ct.numero, ct.faturamento, ct.cliente, ct.tipoclient' +
        'e, ct.nome, pa.numero, r.controle, r.transacao, r.data_confirmac' +
        'ao'
      ''
      ')'
      ''
      'union all'
      ''
      ''
      '('
      '  select cast(2 as integer) as classificacao,'
      
        '        cast('#39'(-) DEDU'#199#213'ES DA RECEITA BRUTA'#39' as varchar(50)) as ' +
        'descricaoclassificacao,'
      '        dev.tipoproduto,'
      '        dev.descricaotipoproduto,'
      '        dev.grupo,'
      '        dev.descricaogrupo,'
      '        dev.classe,'
      '        dev.descricaoclasse,'
      '        '
      '        dev.documento,'
      '        dev.data,'
      '        dev.cliente,'
      '        dev.tipocliente,'
      '        dev.nomecliente,'
      '        '
      '        sum(dev.ValorBrutodoproduto) as ValorBrutodoproduto'
      '  from'
      '  ('
      ''
      '    ('
      ''
      '       /* CONTRATOS FATURADOS DEVOLVIDOS */'
      '        select'
      ''
      '        c.tipoproduto,'
      
        '        cast('#39'DEVOLU'#199#213'ES - '#39' as varchar)||cast(tp.descricao as v' +
        'archar) as descricaotipoproduto,'
      #9#9
      
        '  '#9'    case when :AgruparGrupo then c.grupo     else cast(null a' +
        's varchar(4)) end as grupo,'
      
        #9'    case when :AgruparGrupo then g.descricao else cast(null as ' +
        'varchar(30)) end as descricaogrupo,'
      
        #9'    case when :AGruparClasse then c.classe    else cast(null as' +
        ' varchar(2)) end as classe,'
      
        #9'    case when :AGruparClasse then cl.descricao else cast(null a' +
        's varchar(30)) end as descricaoclasse,'
      '        '
      '        cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '        ct.faturamento as data,'
      '        ct.cliente,'
      '        ct.tipocliente,'
      '        ct.nome as nomecliente,'
      ''
      '        -'
      #9#9'/* VALOR BRUTO */'
      #9#9'((cd.valorvista + cd.desconto) +'
      #9#9'/* ACRESCIMO*/'
      #9#9' (cd.ValorPrazo-cd.ValorVista))'
      #9#9'as ValorBrutodoproduto'
      ''
      '        from ((contratosdevolvidos cd'
      '               join contratos ct'
      '               on cd.contrato=ct.numero)'
      ''
      '               join (produtos p'
      '                     join (((caracteristicas c'
      '                             join classes cl'
      '                             on c.classe=cl.codigo)'
      ''
      '                             join grupos g'
      '                             on c.grupo = g.codigo)'
      ''
      '                             join tiposproduto tp'
      '                             on c.tipoproduto = tp.codigo)'
      ''
      '                     on p.caracteristica=c.codigo)'
      '               on cd.produto=p.codigo)'
      ''
      
        '        where cd.devolucao between(:DataInicial) and (:DataFinal' +
        ')'
      '          /* and cd.tipo = '#39'D'#39' */'
      
        '          and case when ct.os then ct.tipoequipamento in (1,2) a' +
        'nd not (coalesce(ct.os_garantia,false) and ct.os_garantia_status' +
        '='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '          and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturadas' +
        ' as outras entram pelas notas fiscais devido a cr'#233'ditos de troca' +
        ' */'
      ''
      '    )'
      ''
      ''
      '    union all'
      ''
      '    ('
      '        /* CONTRATOS FATURADOS TOTALMENTE CANCELADOS  */'
      '        select'
      '        c.tipoproduto,'
      
        #9#9'    cast('#39'DEVOLU'#199#213'ES - '#39' as varchar)||cast(tp.descricao as var' +
        'char) as descricaotipoproduto,'
      ''
      
        #9'    case when :AgruparGrupo then c.grupo     else cast(null as ' +
        'varchar(4)) end as grupo,'
      
        #9'    case when :AgruparGrupo then g.descricao else cast(null as ' +
        'varchar(30)) end as descricaogrupo,'
      
        #9'    case when :AGruparClasse then c.classe    else cast(null as' +
        ' varchar(2)) end as classe,'
      
        #9'    case when :AGruparClasse then cl.descricao else cast(null a' +
        's varchar(30)) end as descricaoclasse,'
      '        '
      '        cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '        ct.faturamento as data,'
      '        ct.cliente,'
      '        ct.tipocliente,'
      '        ct.nome as nomecliente,       '
      ''
      '            -'
      '            ((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      '            ) as  ValorBrutodoProduto'
      ''
      #9'     /*'
      '      -'
      #9'   VALOR BRUTO'
      ''
      #9'  (((pc.quantidade*pc.precovenda) +'
      
        '      (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quantid' +
        'ade*pc.precovenda))  /'
      
        '      (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-c' +
        'oalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                   coalesce((select  sum(sc.quan' +
        'tidade*coalesce(sc.valorservico,0))'
      '        from servicoscontratos sc'
      '        where sc.contrato = ct.numero),0)),0),1))'
      '      )) +'
      ''
      #9'   ACRESCIMO'
      ''
      
        #9'   (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precovenda' +
        '))  /'
      
        '       (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-' +
        'coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '               coalesce((select  sum(sc.quantidade*coalesce(sc.v' +
        'alorservico,0))'
      '                from servicoscontratos sc'
      '                where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      #9#9' DESCONTO'
      
        '       ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)) ' +
        ' /'
      
        '       (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-' +
        'coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '               coalesce((select  sum(sc.quantidade*coalesce(sc.v' +
        'alorservico,0))'
      '                from servicoscontratos sc'
      '                where sc.contrato = ct.numero),0)),0),1))))'
      ''
      #9'  as ValorBrutodoProduto'
      ''
      '          */'
      ''
      ''
      '    from (select distinct ct.numero, p.datapagto'
      '          from contratos ct, parcelas p'
      '          where ct.numero=p.contrato '
      #9#9'   and ct.situacao='#39'C'#39' '
      #9#9'   and not exists (select p2.numero'
      '                           from parcelas p2'
      '                           where p2.contrato = ct.numero '
      #9#9#9#9#9#9'     and p2.tipopagto<>'#39'E'#39') '
      #9#9'   and p.datapagto between :datainicial and :datafinal '
      #9#9'   and not exists (select cd.contrato'
      '                           from contratosdevolvidos cd'
      
        '                           where cd.contrato = ct.numero /*and c' +
        'd.tipo='#39'D'#39'*/ )'
      
        '           and case when ct.os then ct.tipoequipamento in (1,2) ' +
        'and not (coalesce(ct.os_garantia,false) and ct.os_garantia_statu' +
        's='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '         ) as cancelados, (contratos ct '
      #9#9'                   join (produtoscontratos pc'
      #9#9#9#9#9#9'         join (produtos p'
      #9#9#9#9#9#9#9#9'       join (((caracteristicas c'
      #9#9#9#9#9#9#9#9#9'           join classes cl'
      #9#9#9#9#9#9#9#9#9#9#9'   on c.classe = cl.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9#9#9#9#9'  join grupos g'
      #9#9#9#9#9#9#9#9#9#9#9'  on c.grupo = g.codigo)'
      ''
      #9#9#9#9#9#9#9#9#9#9#9' join tiposproduto tp'
      #9#9#9#9#9#9#9#9#9#9#9' on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                       on p.caracteristica = c.c' +
        'odigo)'
      '                                 on pc.produto=p.codigo)'
      '                           on pc.contrato = ct.numero)'
      '    where cancelados.numero = ct.numero'
      #9#9
      ''
      '    )'
      ''
      '    union all'
      ''
      '    ('
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      
        '      cast('#39'DEVOLU'#199#213'ES - '#39' as varchar)||cast(tp.descricao as var' +
        'char) as descricaotipoproduto,'
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '        cast('#39'NF '#39'||np.numero as varchar(30)) as documento,'
      '        np.data,'
      '        np.fornecedor as cliente,'
      '        np.tipofornecedor as tipocliente,'
      '        np.nome as nomecliente,'
      '      '
      ''
      '      -'
      '      ((pnp.quantidade * pnp.precounitario)'
      '      - coalesce(pnp.valordescontoitem,0)'
      '      - coalesce(pnp.desconto,0)'
      '      + coalesce(pnp.acrescimo,0)'
      '      + coalesce(pnp.frete,0)'
      '      + coalesce(pnp.seguro,0)'
      '      + coalesce(pnp.valoripi,0)'
      '      + coalesce(pnp.icmsvalorst,0)'
      '      + coalesce(pnp.despesasacessorias,0))'
      #9'   as ValorBrutodoProduto'
      ''
      '     from (notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      
        '           on pnp.produto=p.codigo) on np.codigo = pnp.codigonot' +
        'a)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      ''
      '    )'
      ''
      #9'union all'
      ''
      ''
      '    ('
      ''
      '       /* DESCONTOS DE VENDAS COM CONTRATO */'
      ''
      '      select'
      '      c.tipoproduto,'
      
        #9'  cast('#39'DESCONTOS - '#39' as varchar)||cast(tp.descricao as varchar' +
        ') as descricaotipoproduto,'
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '        cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '        ct.faturamento as data,'
      '        ct.cliente,'
      '        ct.tipocliente,'
      '        ct.nome as nomecliente,       '
      '      '
      ''
      '          - pc.descontogeral as ValorBrutodoProduto'
      ''
      '          /*'
      '      -'
      ''
      #9'  ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))  /'
      
        '       (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-' +
        'coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '               coalesce((select  sum(sc.quantidade*coalesce(sc.v' +
        'alorservico,0))'
      '                from servicoscontratos sc'
      '                where sc.contrato = ct.numero),0)),0),1)))'
      ''
      #9'  as  ValorBrutodoProduto'
      '          */'
      ''
      ''
      '     from (contratos ct'
      '           join (produtoscontratos pc'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on pc.produto=p.codigo)'
      '           on ct.numero = pc.contrato)'
      ''
      '     where not pc.brinde and'
      
        '               ct.faturamento between(:datainicial) and (:datafi' +
        'nal) and'
      '               (coalesce(ct.valorvista,0)<>0) and'
      '               ct.origem is null and'
      #9#9#9'   coalesce(ct.desconto,0)<>0'
      ''
      '    )'
      '    union all'
      '    ('
      '       /* DESCONTOS DE VENDAS SEM CONTRATO */'
      ''
      '      select'
      '      c.tipoproduto,'
      
        '      cast('#39'DESCONTOS - '#39' as varchar)||cast(tp.descricao as varc' +
        'har) as descricaotipoproduto,'
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '      case when n.dadofiscal is not null then'
      '        cast('#39'NF '#39'||n.numero||'#39' S'#233'rie '#39'||n.serie as varchar(30))'
      '      else'
      
        '        cast('#39'CF '#39'||cp.numero||'#39' Mq. '#39'||cp.maquina||'#39' Int.'#39'||cp.' +
        'intervensao as varchar(30))'
      '      end as documento,'
      '      df.data,'
      '      df.cliente,'
      '      df.tipocliente,'
      '      df.nome as nomecliente,'
      '      '
      ''
      ''
      
        '      - (coalesce(pdf.desconto,0) + coalesce(pdf.valordescontoit' +
        'em,0)) as ValorBrutodoProduto'
      ''
      '      /*'
      '      -'
      
        '      ((coalesce(df.desconto,0)*(pdf.quantidade*pdf.precovenda))' +
        '  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      #9'   as ValorBrutodoProduto'
      '           */'
      ''
      ''
      '      from (dadosfiscais df'
      '             join (produtosdadosfiscais pdf'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      ''
      '                         on p.caracteristica=c.codigo)'
      
        '             on pdf.produto=p.codigo) on df.numero = pdf.dadofis' +
        'cal)'
      '             '
      '             left join notas n on df.numero = n.dadofiscal'
      '             left join cupons cp on df.numero = cp.dadofiscal'
      '             '
      ''
      
        '      Where (df.data between (:datainicial) and (:datafinal)) an' +
        'd df.contrato is null'
      '              and df.situacao='#39'N'#39
      '              and eHNotaFiscalSaidaVenda(pdf.codigofiscal)'
      '        and not coalesce(df.notavinculada,false) and'
      #9#9#9'   coalesce(df.desconto,0)<>0'
      ''
      ''
      '    )'
      ''
      #9#9'union all'
      ''
      ''
      #9'('
      ''
      #9'  /* IMPOSTOS - REGIME SIMPLES */'
      ''
      '     select impostos.tipoproduto,'
      
        '            cast('#39'IMPOSTOS - '#39' as varchar)||cast(impostos.descri' +
        'caotipoproduto as varchar) as descricaotipoproduto,'
      '            impostos.grupo,'
      '            impostos.descricaogrupo,'
      '            impostos.classe,'
      '            impostos.descricaoclasse,'
      '            '
      '            impostos.documento,'
      '            impostos.data,'
      '            impostos.cliente,'
      '            impostos.tipocliente,'
      '            impostos.nomecliente,       '
      '            '
      
        '            - sum(case when coalesce(impostos.aliquotaicmssn,0) ' +
        '= 0 then 0  else impostos.ValorBrutodoProduto * impostos.aliquot' +
        'aicmssn / 100 end) as ValorBrutodoProduto'
      #9'from'
      ''
      #9'('
      ''
      '      ('
      
        '            /* VENDAS COM CONTRATO BRUTO + ACRESIMCO - DESCONTO ' +
        '*/'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      ''
      
        '  '#9'    case when :AgruparGrupo then c.grupo     else cast(null a' +
        's varchar(4)) end as grupo,'
      
        #9'    case when :AgruparGrupo then g.descricao else cast(null as ' +
        'varchar(30)) end as descricaogrupo,'
      
        #9'    case when :AGruparClasse then c.classe    else cast(null as' +
        ' varchar(2)) end as classe,'
      
        #9'    case when :AGruparClasse then cl.descricao else cast(null a' +
        's varchar(30)) end as descricaoclasse,'
      '        '
      '        cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '        ct.faturamento as data,'
      '        ct.cliente,'
      '        ct.tipocliente,'
      '        ct.nome as nomecliente,'
      ''
      ''
      '      (select asn.aliquotaicms'
      '       from aliquotassimplesnacional asn'
      '         where asn.filial = ct.filialvenda'
      
        '         and asn.mesano = to_char(ct.faturamento, '#39'mm/yyyy'#39'))  a' +
        's aliquotaicmssn,'
      ''
      '            ((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      '            ) as  ValorBrutodoProduto'
      ''
      '            /*'
      ''
      '       VALOR BRUTO'
      '      ((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1)))) +'
      ''
      '       ACRESCIMO'
      
        '        (((ValorPrazo-ValorVista)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      
        '        ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1)))'
      ''
      '        as  ValorBrutodoProduto'
      ''
      '        */'
      ''
      ''
      '       from (contratos ct'
      '             join (produtoscontratos pc'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      ''
      '                         on p.caracteristica=c.codigo)'
      '                   on pc.produto=p.codigo)'
      '             on ct.numero = pc.contrato)'
      ''
      '       where not pc.brinde'
      
        '         and ct.faturamento between(:datainicial) and (:datafina' +
        'l)'
      '         and (coalesce(ct.valorvista,0)<>0)'
      '         and ct.origem is null'
      
        '         and (select f.regimetributario from filiais f where f.c' +
        'odigo = ct.filialvenda)=1  /* simples nacional*/'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      '        /* VENDAS SEM CONTRATO */'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      #9#9
      
        #9'    case when :AgruparGrupo then c.grupo     else cast(null as ' +
        'varchar(4)) end as grupo,'
      
        #9'    case when :AgruparGrupo then g.descricao else cast(null as ' +
        'varchar(30)) end as descricaogrupo,'
      
        #9'    case when :AGruparClasse then c.classe    else cast(null as' +
        ' varchar(2)) end as classe,'
      
        #9'    case when :AGruparClasse then cl.descricao else cast(null a' +
        's varchar(30)) end as descricaoclasse,'
      '        '
      '      case when n.dadofiscal is not null then'
      '        cast('#39'NF '#39'||n.numero||'#39' S'#233'rie '#39'||n.serie as varchar(30))'
      '      else'
      
        '        cast('#39'CF '#39'||cp.numero||'#39' Mq. '#39'||cp.maquina||'#39' Int.'#39'||cp.' +
        'intervensao as varchar(30))'
      '      end as documento,'
      '      df.data,'
      '      df.cliente,'
      '      df.tipocliente,'
      '      df.nome as nomecliente,'
      '        '
      ''
      ''
      '      (select asn.aliquotaicms'
      '       from aliquotassimplesnacional asn'
      '         where asn.filial = df.filialvenda'
      
        '         and asn.mesano = to_char(df.data, '#39'mm/yyyy'#39'))  as aliqu' +
        'otaicmssn,'
      ''
      ''
      ''
      '      ((pdf.quantidade*pdf.precovenda) +'
      '                 coalesce(pdf.frete,0) +'
      '                coalesce(pdf.seguro,0) +'
      '             coalesce(pdf.acrescimo,0) -'
      ''
      '              coalesce(pdf.desconto,0) -'
      '      coalesce(pdf.valordescontoitem,0)'
      ''
      '      ) as ValorBrutodoProduto'
      ''
      ''
      '      /*'
      ''
      '          VALOR BRUTO'
      ''
      '      ((pdf.quantidade*pdf.precovenda) +'
      
        '        (((coalesce(df.valorfrete,0)+coalesce(df.seguro,0))*(pdf' +
        '.quantidade*pdf.precovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      '          where sdf.dadofiscal = df.numero),0)),0),1)))) +'
      ''
      '        ACRESCIMO'
      ''
      
        '        (((df.Valortotal-df.ValorVista)*(pdf.quantidade*pdf.prec' +
        'ovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      
        '                  where sdf.dadofiscal = df.numero),0)),0),1))) ' +
        ' -'
      ''
      '        DESCONTO'
      ''
      
        '      ((coalesce(df.desconto,0)*(pdf.quantidade*pdf.precovenda))' +
        '  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      ''
      ''
      '       as ValorBrutodoProduto'
      ''
      '       */'
      ''
      '        from (dadosfiscais df'
      '               join (produtosdadosfiscais pdf'
      '                     join (produtos p'
      '                           join (((caracteristicas c'
      '                                   join classes cl'
      '                                   on c.classe=cl.codigo)'
      ''
      '                                   join grupos g'
      '                                   on c.grupo = g.codigo)'
      ''
      '                                   join tiposproduto tp'
      '                                   on c.tipoproduto = tp.codigo)'
      ''
      '                           on p.caracteristica=c.codigo)'
      
        '               on pdf.produto=p.codigo) on df.numero = pdf.dadof' +
        'iscal)'
      '               '
      '             left join notas n on df.numero = n.dadofiscal'
      '             left join cupons cp on df.numero = cp.dadofiscal'
      '               '
      ''
      '        Where (df.data between (:datainicial) and (:datafinal))'
      '          and df.contrato is null'
      '          and df.situacao='#39'N'#39
      '          and eHNotaFiscalSaidaVenda(pdf.codigofiscal)'
      '          and not coalesce(df.notavinculada,false)'
      
        '          and (select f.regimetributario from filiais f where f.' +
        'codigo = df.filialvenda)=1  /* simples nacional*/'
      ''
      ''
      '     )'
      ''
      '       union all'
      ''
      '     ('
      '         /* DEVOLUCOES COM CONTRATO */'
      ''
      '          select'
      ''
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        '  '#9'      case when :AgruparGrupo then c.grupo     else cast(null' +
        ' as varchar(4)) end as grupo,'
      
        #9'      case when :AgruparGrupo then g.descricao else cast(null a' +
        's varchar(30)) end as descricaogrupo,'
      
        #9'      case when :AGruparClasse then c.classe    else cast(null ' +
        'as varchar(2)) end as classe,'
      
        #9'      case when :AGruparClasse then cl.descricao else cast(null' +
        ' as varchar(30)) end as descricaoclasse,'
      '          '
      '          cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '          ct.faturamento as data,'
      '          ct.cliente,'
      '          ct.tipocliente,'
      '          ct.nome as nomecliente,          '
      #9#9'  '
      '      (select asn.aliquotaicms'
      '       from aliquotassimplesnacional asn'
      '         where asn.filial = ct.filialvenda'
      
        '         and asn.mesano = to_char(cd.devolucao, '#39'mm/yyyy'#39'))  as ' +
        'aliquotaicmssn,'
      #9#9
      #9#9
      '          - '
      '      /* VALOR BRUTO */'
      '      ((cd.valorvista + cd.desconto) +'
      '      /* ACRESCIMO*/'
      '       (cd.ValorPrazo-cd.ValorVista))'
      '      as ValorBrutodoproduto'
      ''
      '          from ((contratosdevolvidos cd'
      '                 join contratos ct'
      '                 on cd.contrato=ct.numero)'
      ''
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on cd.produto=p.codigo)'
      ''
      
        '          where cd.devolucao between(:DataInicial) and (:DataFin' +
        'al)'
      '            /* and cd.tipo = '#39'D'#39' */'
      
        '            and case when ct.os then ct.tipoequipamento in (1,2)' +
        ' and not (coalesce(ct.os_garantia,false) and ct.os_garantia_stat' +
        'us='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '            and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturad' +
        'as as outras entram pelas notas fiscais devido a cr'#233'ditos de tro' +
        'ca */'
      
        '            and (select f.regimetributario from filiais f where ' +
        'f.codigo = ct.filialvenda)=1  /* simples nacional*/'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      ''
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '        cast('#39'NF '#39'||np.numero as varchar(30)) as documento,'
      '        np.data,'
      '        np.fornecedor as cliente,'
      '        np.tipofornecedor as tipocliente,'
      '        np.nome as nomecliente,'
      '      '
      ''
      '            (select asn.aliquotaicms'
      '       from aliquotassimplesnacional asn'
      '         where asn.filial = np.filial'
      
        '         and asn.mesano = to_char(np.data, '#39'mm/yyyy'#39'))  as aliqu' +
        'otaicmssn,'
      ''
      ''
      '      -'
      '      ((pnp.quantidade * pnp.precounitario)'
      '      - coalesce(pnp.valordescontoitem,0)'
      '      - coalesce(pnp.desconto,0)'
      '      + coalesce(pnp.acrescimo,0)'
      '      + coalesce(pnp.frete,0)'
      '      + coalesce(pnp.seguro,0)'
      '      + coalesce(pnp.valoripi,0)'
      '      + coalesce(pnp.icmsvalorst,0)'
      '      + coalesce(pnp.despesasacessorias,0))'
      #9'   as ValorBrutodoProduto'
      ''
      '     from (notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      
        '           on pnp.produto=p.codigo) on np.codigo = pnp.codigonot' +
        'a)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      
        '       and (select f.regimetributario from filiais f where f.cod' +
        'igo = np.filial)=1  /* simples nacional*/'
      ''
      ''
      '      )'
      ''
      ''
      '      union all'
      ''
      '      ('
      
        '         /* CONTRATOS CANCELADOS SEM CONTRATOS DEVOLVIDOS, TOTAL' +
        'MENTE CANCELADOS SEM PARCELAS PAGAS */'
      '          select'
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      ''
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '      cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '      ct.faturamento as data,'
      '      ct.cliente,'
      '      ct.tipocliente,'
      '      ct.nome as nomecliente,'
      '      '
      ''
      '      (select asn.aliquotaicms'
      '         from aliquotassimplesnacional asn'
      '           where asn.filial = ct.filialvenda'
      
        '           and asn.mesano = to_char(cancelados.datapagto, '#39'mm/yy' +
        'yy'#39'))  as aliquotaicmssn,'
      ''
      ''
      '            -'
      '            ((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      '            ) as  ValorBrutodoProduto'
      ''
      '        /*'
      '        -'
      '       VALOR BRUTO'
      '      (((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '        (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)' +
        '-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                     coalesce((select  sum(sc.qu' +
        'antidade*coalesce(sc.valorservico,0))'
      '          from servicoscontratos sc'
      '          where sc.contrato = ct.numero),0)),0),1))'
      '        )) +'
      ''
      '       ACRESCIMO'
      ''
      
        '       (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precove' +
        'nda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      ''
      
        '         ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)' +
        ')  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))))'
      ''
      '      as ValorBrutodoProduto'
      ''
      '      */'
      ''
      ''
      '      from (select distinct ct.numero, p.datapagto'
      '            from contratos ct, parcelas p'
      '            where ct.numero=p.contrato '
      '         and ct.situacao='#39'C'#39' '
      '         and not exists (select p2.numero'
      '                             from parcelas p2'
      '                             where p2.contrato = ct.numero '
      '                   and p2.tipopagto<>'#39'E'#39') '
      '         and p.datapagto between :datainicial and :datafinal '
      '         and not exists (select cd.contrato'
      '                             from contratosdevolvidos cd'
      
        '                             where cd.contrato = ct.numero /*and' +
        ' cd.tipo='#39'D'#39'*/)'
      
        '             and case when ct.os then ct.tipoequipamento in (1,2' +
        ') and not (coalesce(ct.os_garantia,false) and ct.os_garantia_sta' +
        'tus='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '           ) as cancelados, (contratos ct '
      '                         join (produtoscontratos pc'
      '                       join (produtos p'
      '                         join (((caracteristicas c'
      '                               join classes cl'
      '                           on c.classe = cl.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      '                          join grupos g'
      '                          on c.grupo = g.codigo)'
      ''
      '                         join tiposproduto tp'
      '                         on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                         on p.caracteristica = c' +
        '.codigo)'
      '                                   on pc.produto=p.codigo)'
      '                             on pc.contrato = ct.numero)'
      '      where cancelados.numero = ct.numero'
      
        '        and (select f.regimetributario from filiais f where f.co' +
        'digo = ct.filialvenda)=1  /* simples nacional*/'
      ''
      ''
      '      )'
      ''
      #9') as impostos'
      #9'       group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo,'
      '            grupo,'
      '            descricaoclasse,'
      '            classe,'
      #9#9#9'aliquotaicmssn,'
      ''
      '            impostos.documento,'
      '            impostos.data,'
      '            impostos.cliente,'
      '            impostos.tipocliente,'
      '            impostos.nomecliente'
      ''
      ''
      '   )'
      '   '
      '   union all'
      '   '
      '   '
      '  ('
      '  '
      '    /* IMPOSTOS - ICMS - REGIME NORMAL */'
      #9
      '     select impostos.tipoproduto,'
      
        '            cast('#39'IMPOSTOS - ICMS - '#39' as varchar)||cast(impostos' +
        '.descricaotipoproduto as varchar) as descricaotipoproduto,'
      '            impostos.grupo,'
      '            impostos.descricaogrupo,'
      '            impostos.classe,'
      '            impostos.descricaoclasse,'
      '            '
      '            impostos.documento,'
      '            impostos.data,'
      '            impostos.cliente,'
      '            impostos.tipocliente,'
      '            impostos.nomecliente,                   '
      '            '
      
        '            sum(impostos.ValorBrutodoProduto) as ValorBrutodoPro' +
        'duto '
      #9'from'#9#9
      #9
      #9'('
      #9
      '      ('
      
        '            /* VENDAS COM CONTRATO  BRUTO + ACRESIMCO - DESCONTO' +
        ' */'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '        cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '        ct.faturamento as data,'
      '        ct.cliente,'
      '        ct.tipocliente,'
      '        ct.nome as nomecliente,       '
      '      '
      ''
      '        -'
      '          (((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      
        '            ) * Selecionar_Aliquotaicms(f.estado, ct.estado, ct.' +
        'pessoatipo, p.codigo)/100) as  ValorBrutodoProduto'
      ''
      '        /*'
      '      -'
      '       VALOR BRUTO'
      '      (((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1)))) +'
      ''
      '       ACRESCIMO'
      
        '        (((ValorPrazo-ValorVista)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      
        '        ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1))))*(1' +
        '-coalesce(c.percreducaobase,0)/100)) *'
      ''
      
        '                  Selecionar_Aliquotaicms(f.estado, ct.estado, c' +
        't.pessoatipo, p.codigo)/100)'
      '        as  ValorBrutodoProduto'
      ''
      '        */'
      ''
      ''
      '       from ((contratos ct'
      '             join (produtoscontratos pc'
      '                   join (produtos p'
      '                         join ((((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9#9' join tributosicms ti'
      #9#9#9#9#9#9#9#9' on c.incidencia = ti.codigo)'
      ''
      '                         on p.caracteristica=c.codigo)'
      '                   on pc.produto=p.codigo)'
      '             on ct.numero = pc.contrato)'
      #9#9#9' '
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = ct.filialvenda)'
      ''
      '       where not pc.brinde'
      
        '         and ct.faturamento between(:datainicial) and (:datafina' +
        'l)'
      '         and (coalesce(ct.valorvista,0)<>0)'
      '         and ct.origem is null'
      '         and f.regimetributario <> 1  /* regime normal */'
      #9#9' and ti.valor in ('#39'00'#39','#39'20'#39')'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      '        /* VENDAS SEM CONTRATO */'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      #9#9
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '      case when n.dadofiscal is not null then'
      '        cast('#39'NF '#39'||n.numero||'#39' S'#233'rie '#39'||n.serie as varchar(30))'
      '      else'
      
        '        cast('#39'CF '#39'||cp.numero||'#39' Mq. '#39'||cp.maquina||'#39' Int.'#39'||cp.' +
        'intervensao as varchar(30))'
      '      end as documento,'
      '      df.data,'
      '      df.cliente,'
      '      df.tipocliente,'
      '      df.nome as nomecliente,'
      '      '
      ''
      '/*'
      '       -- VALOR BRUTO '
      '      ((pdf.quantidade*pdf.precovenda) +'
      
        '        (((coalesce(df.valorfrete,0)+coalesce(df.seguro,0))*(pdf' +
        '.quantidade*pdf.precovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      '          where sdf.dadofiscal = df.numero),0)),0),1)))) +'
      #9#9'  '
      '       -- ACRESCIMO '
      
        '        (((df.Valortotal-df.ValorVista)*(pdf.quantidade*pdf.prec' +
        'ovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      
        '                  where sdf.dadofiscal = df.numero),0)),0),1))) ' +
        ' -'
      #9#9#9#9'  '
      '       -- DESCONTO '#9'   '
      
        '      ((coalesce(df.desconto,0)*(pdf.quantidade*pdf.precovenda))' +
        '  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      #9#9#9#9
      '       as ValorBrutodoProduto'
      '*/'
      ''
      '       - pdf.icmsvalor as ValorBrutodoProduto'
      #9'   '
      ''
      '       from ((dadosfiscais df'
      '               join (produtosdadosfiscais pdf'
      '                     join (produtos p'
      '                           join (((caracteristicas c'
      '                                   join classes cl'
      '                                   on c.classe=cl.codigo)'
      ''
      '                                   join grupos g'
      '                                   on c.grupo = g.codigo)'
      ''
      '                                   join tiposproduto tp'
      '                                   on c.tipoproduto = tp.codigo)'
      ''
      '                           on p.caracteristica=c.codigo)'
      '                    on pdf.produto=p.codigo) '
      #9#9#9'   on df.numero = pdf.dadofiscal)'
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = df.filialvenda)'
      '             '
      '             left join notas n on df.numero = n.dadofiscal'
      '             left join cupons cp on df.numero = cp.dadofiscal'
      ''
      #9#9#9'   '
      #9#9#9'   '
      '       Where (df.data between (:datainicial) and (:datafinal))'
      '          and df.contrato is null'
      '          and df.situacao='#39'N'#39
      '          and eHNotaFiscalSaidaVenda(pdf.codigofiscal)'
      '          and not coalesce(df.notavinculada,false)'
      '          and f.regimetributario <> 1  /* regime normal */'
      #9#9'  and pdf.incidencia in ('#39'00'#39','#39'20'#39')'
      ''
      '     )'
      ''
      '       union all'
      ''
      '     ('
      '         /* DEVOLUCOES COM CONTRATO */'
      ''
      '          select'
      ''
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '          cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '          ct.faturamento as data,'
      '          ct.cliente,'
      '          ct.tipocliente,'
      '          ct.nome as nomecliente,          '
      '      '
      #9#9
      '           '
      '      /* VALOR BRUTO */'
      '      ((((cd.valorvista + cd.desconto) +'
      '      /* ACRESCIMO*/'
      
        '       (cd.ValorPrazo-cd.ValorVista)) * (1-coalesce(c.percreduca' +
        'obase,0)/100)) * Selecionar_Aliquotaicms(f.estado, ct.estado, ct' +
        '.pessoatipo, p.codigo)/100) as ValorBrutodoproduto'
      ''
      '          from ((contratosdevolvidos cd'
      '                 join (contratos ct'
      #9#9#9#9'       join filiais f'
      #9#9#9#9#9'   on ct.filialvenda = f.codigo)'
      '                 on cd.contrato=ct.numero)'
      ''
      '                 join (produtos p'
      '                       join ((((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      #9#9#9#9#9#9#9'   join tributosicms ti'
      #9#9#9#9#9#9#9'   on c.incidencia = ti.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on cd.produto=p.codigo)'
      ''
      
        '          where cd.devolucao between(:DataInicial) and (:DataFin' +
        'al)'
      '            /* and cd.tipo = '#39'D'#39' */'
      
        '            and case when ct.os then ct.tipoequipamento in (1,2)' +
        ' and not (coalesce(ct.os_garantia,false) and ct.os_garantia_stat' +
        'us='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '            and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturad' +
        'as as outras entram pelas notas fiscais devido a cr'#233'ditos de tro' +
        'ca */'
      '            and f.regimetributario <> 1  /* regime normal */'
      #9#9#9'and ti.valor in ('#39'00'#39','#39'20'#39')'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '        cast('#39'NF '#39'||np.numero as varchar(30)) as documento,'
      '        np.data,'
      '        np.fornecedor as cliente,'
      '        np.tipofornecedor as tipocliente,'
      '        np.nome as nomecliente,'
      '      '
      ''
      '      pnp.icmsvalor as ValorBrutodoProduto'
      ''
      '     from ((notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join ((((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      #9#9#9#9#9#9#9'   join tributosicms ti'
      #9#9#9#9#9#9#9'   on c.incidencia = ti.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on pnp.produto=p.codigo) '
      #9#9'   on np.codigo = pnp.codigonota)'
      #9#9'   '
      '           join filiais f'
      #9'       on np.filial = f.codigo)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      #9'   and f.regimetributario <> 1  /* regime normal */'
      #9'   and ti.valor in ('#39'00'#39','#39'20'#39')'
      ''
      '      )'
      ''
      ''
      '      union all'
      ''
      '      ('
      
        '         /* CONTRATOS CANCELADOS SEM CONTRATOS DEVOLVIDOS, TOTAL' +
        'MENTE CANCELADOS SEM PARCELAS PAGAS */'
      '          select'
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '      cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '      ct.faturamento as data,'
      '      ct.cliente,'
      '      ct.tipocliente,'
      '      ct.nome as nomecliente,'
      '      '
      ''
      ''
      '            (((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      
        '            ) * Selecionar_Aliquotaicms(f.estado, ct.estado, ct.' +
        'pessoatipo, p.codigo)/100 ) as  ValorBrutodoProduto'
      ''
      '            /*'
      ''
      '       VALOR BRUTO'
      '      (((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '        (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)' +
        '-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                     coalesce((select  sum(sc.qu' +
        'antidade*coalesce(sc.valorservico,0))'
      '          from servicoscontratos sc'
      '          where sc.contrato = ct.numero),0)),0),1))'
      '        )) +'
      ''
      '       ACRESCIMO'
      ''
      
        '       (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precove' +
        'nda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '        DESCONTO'
      
        '         ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)' +
        ')  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1)))) * ' +
        '(1-coalesce(c.percreducaobase,0)/100)) * Selecionar_Aliquotaicms' +
        '(f.estado, ct.estado, ct.pessoatipo, p.codigo)/100)'
      ''
      '      as ValorBrutodoProduto'
      '      */'
      #9'  '
      #9'  '
      '      from (select distinct ct.numero, p.datapagto'
      '            from contratos ct, parcelas p'
      '            where ct.numero=p.contrato '
      '         and ct.situacao='#39'C'#39' '
      '         and not exists (select p2.numero'
      '                             from parcelas p2'
      '                             where p2.contrato = ct.numero '
      '                   and p2.tipopagto<>'#39'E'#39') '
      '         and p.datapagto between :datainicial and :datafinal '
      '         and not exists (select cd.contrato'
      '                             from contratosdevolvidos cd'
      
        '                             where cd.contrato = ct.numero /*and' +
        ' cd.tipo='#39'D'#39'*/)'
      
        '             and case when ct.os then ct.tipoequipamento in (1,2' +
        ') and not (coalesce(ct.os_garantia,false) and ct.os_garantia_sta' +
        'tus='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '           ) as cancelados, ((contratos ct '
      '                             join (produtoscontratos pc'
      '                                   join (produtos p'
      
        '                                         join ((((caracteristica' +
        's c'
      '                                                 join classes cl'
      
        '                                                 on c.classe = c' +
        'l.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      '                                                 join grupos g'
      
        '                                                 on c.grupo = g.' +
        'codigo)'
      ''
      
        '                                                join tiposprodut' +
        'o tp'
      
        '                                                on c.tipoproduto' +
        ' = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9#9
      #9#9#9#9#9#9#9#9#9#9#9#9'join tributosicms ti'
      #9#9#9#9#9#9#9'                    on c.incidencia = ti.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                         on p.caracteristica = c' +
        '.codigo)'
      '                                   on pc.produto=p.codigo)'
      '                             on pc.contrato = ct.numero)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' join filiais f'
      #9#9#9#9#9'         on ct.filialvenda = f.codigo)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' '
      '      where cancelados.numero = ct.numero'
      #9#9'and f.regimetributario <> 1  /* regime normal */'
      #9#9'and ti.valor in ('#39'00'#39','#39'20'#39')'
      ''
      ''
      '      )'
      ''
      #9') as impostos'
      '   group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo,'
      '            grupo,'
      '            descricaoclasse,'
      '            classe,'
      ''
      '            impostos.documento,'
      '            impostos.data,'
      '            impostos.cliente,'
      '            impostos.tipocliente,'
      '            impostos.nomecliente'
      ''
      ''
      '   )'
      '   '
      '   union all'
      '   '
      '   ('
      '   '
      '   '
      '    /* IMPOSTOS - PIS - REGIME NORMAL */'
      #9
      '     select impostos.tipoproduto,'
      
        '            cast('#39'IMPOSTOS - PIS - '#39' as varchar)||cast(impostos.' +
        'descricaotipoproduto as varchar) as descricaotipoproduto,'
      '            impostos.grupo,'
      '            impostos.descricaogrupo,'
      '            impostos.classe,'
      '            impostos.descricaoclasse,'
      ''
      '            impostos.documento,'
      '            impostos.data,'
      '            impostos.cliente,'
      '            impostos.tipocliente,'
      '            impostos.nomecliente,       '
      '            '
      
        '            sum(impostos.ValorBrutodoProduto) as ValorBrutodoPro' +
        'duto '
      #9'from'#9#9
      #9
      #9'('
      #9
      '      ('
      
        '            /* VENDAS COM CONTRATO BRUTO + ACRESIMCO - DESCONTO ' +
        '*/'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '        cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '        ct.faturamento as data,'
      '        ct.cliente,'
      '        ct.tipocliente,'
      '        ct.nome as nomecliente,       '
      '      '
      ''
      '           -'
      '          (((pc.quantidade*pc.precovenda) +'
      ''
      '                    coalesce(pc.frete,0) +'
      '                   coalesce(pc.seguro,0) +'
      '                coalesce(pc.acrescimo,0) -'
      '            coalesce(pc.descontogeral,0)'
      ''
      
        '          ) * coalesce(c.aliquotapis,0)/100) as  ValorBrutodoPro' +
        'duto'
      ''
      '          /*'
      ''
      '      -'
      '       VALOR BRUTO'
      '      ((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1)))) +'
      ''
      '       ACRESCIMO'
      
        '        (((ValorPrazo-ValorVista)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      
        '        ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1)))) * ' +
        'coalesce(c.aliquotapis,0)/100)'
      ''
      '        as  ValorBrutodoProduto'
      '        */'
      ''
      ''
      '       from ((contratos ct'
      '             join (produtoscontratos pc'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9' '
      '                         on p.caracteristica=c.codigo)'
      '                   on pc.produto=p.codigo)'
      '             on ct.numero = pc.contrato)'
      #9#9#9' '
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = ct.filialvenda)'
      ''
      '       where not pc.brinde'
      
        '         and ct.faturamento between(:datainicial) and (:datafina' +
        'l)'
      '         and (coalesce(ct.valorvista,0)<>0)'
      '         and ct.origem is null'
      '         and f.regimetributario <> 1  /* regime normal */'
      #9#9' and c.piscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      #9#9' and coalesce(c.aliquotapis,0)<>0'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      '        /* VENDAS SEM CONTRATO */'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      #9#9
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '      case when n.dadofiscal is not null then'
      '        cast('#39'NF '#39'||n.numero||'#39' S'#233'rie '#39'||n.serie as varchar(30))'
      '      else'
      
        '        cast('#39'CF '#39'||cp.numero||'#39' Mq. '#39'||cp.maquina||'#39' Int.'#39'||cp.' +
        'intervensao as varchar(30))'
      '      end as documento,'
      '      df.data,'
      '      df.cliente,'
      '      df.tipocliente,'
      '      df.nome as nomecliente,'
      ''
      ''
      #9#9'-'
      '       (((pdf.quantidade * pdf.precovenda)'
      '         - coalesce(pdf.valordescontoitem,0)'
      '         - coalesce(pdf.desconto,0)'
      '         + coalesce(pdf.acrescimo,0)'
      '         + coalesce(pdf.frete,0)'
      '         + coalesce(pdf.seguro,0)'
      '         + coalesce(pdf.valoripi,0)'
      
        '         + coalesce(pdf.despesasacessorias,0)) * coalesce(c.aliq' +
        'uotapis,0)/100) as ValorBrutodoProduto'
      #9#9
      #9#9#9#9#9#9
      '/*'
      '       -- VALOR BRUTO '
      '      ((pdf.quantidade*pdf.precovenda) +'
      
        '        (((coalesce(df.valorfrete,0)+coalesce(df.seguro,0))*(pdf' +
        '.quantidade*pdf.precovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      '          where sdf.dadofiscal = df.numero),0)),0),1)))) +'
      #9#9'  '
      '       -- ACRESCIMO '
      
        '        (((df.Valortotal-df.ValorVista)*(pdf.quantidade*pdf.prec' +
        'ovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      
        '                  where sdf.dadofiscal = df.numero),0)),0),1))) ' +
        ' -'
      #9#9#9#9'  '
      '       -- DESCONTO '#9'   '
      
        '      ((coalesce(df.desconto,0)*(pdf.quantidade*pdf.precovenda))' +
        '  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      #9#9#9#9
      '       as ValorBrutodoProduto'
      '*/'#9'   '
      ''
      #9'   '
      ''
      '       from ((dadosfiscais df'
      '               join (produtosdadosfiscais pdf'
      '                     join (produtos p'
      '                           join (((caracteristicas c'
      '                                   join classes cl'
      '                                   on c.classe=cl.codigo)'
      ''
      '                                   join grupos g'
      '                                   on c.grupo = g.codigo)'
      ''
      '                                   join tiposproduto tp'
      '                                   on c.tipoproduto = tp.codigo)'
      ''
      '                           on p.caracteristica=c.codigo)'
      '                    on pdf.produto=p.codigo) '
      #9#9#9'   on df.numero = pdf.dadofiscal)'
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = df.filialvenda)'
      '             '
      '             left join notas n on df.numero = n.dadofiscal'
      '             left join cupons cp on df.numero = cp.dadofiscal'
      '             '
      #9#9#9'   '
      #9#9#9'   '
      '       Where (df.data between (:datainicial) and (:datafinal))'
      '          and df.contrato is null'
      '          and df.situacao='#39'N'#39
      
        '          and ((eHNotaFiscalSaidaVenda(pdf.codigofiscal) and c.p' +
        'iscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')) or /* vendas */'
      
        #9#9'       (eHNotaFiscalSaidaDevolucao(pdf.codigofiscal) and c.pis' +
        'cst in ('#39'49'#39')))    /* devolu'#231#245'es de compras, conforme regra do s' +
        'ped */'
      '          and not coalesce(df.notavinculada,false)'
      '          and f.regimetributario <> 1  /* regime normal */'
      #9#9'  '
      ''
      '     )'
      ''
      '       union all'
      ''
      '     ('
      '         /* DEVOLUCOES COM CONTRATO */'
      ''
      '          select'
      ''
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '          cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '          ct.faturamento as data,'
      '          ct.cliente,'
      '          ct.tipocliente,'
      '          ct.nome as nomecliente,          '
      '      '
      #9#9
      '           '
      '      /* VALOR BRUTO */'
      '      (((cd.valorvista + cd.desconto) +'
      '      /* ACRESCIMO*/'
      
        '       (cd.ValorPrazo-cd.ValorVista)) * coalesce(c.aliquotapis,0' +
        ')/100) as ValorBrutodoproduto'
      ''
      '          from ((contratosdevolvidos cd'
      '                 join (contratos ct'
      #9#9#9#9'       join filiais f'
      #9#9#9#9#9'   on ct.filialvenda = f.codigo)'
      '                 on cd.contrato=ct.numero)'
      ''
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      '                       on p.caracteristica=c.codigo)'
      '                 on cd.produto=p.codigo)'
      ''
      
        '          where cd.devolucao between(:DataInicial) and (:DataFin' +
        'al)'
      '            /* and cd.tipo = '#39'D'#39' */'
      
        '            and case when ct.os then ct.tipoequipamento in (1,2)' +
        ' and not (coalesce(ct.os_garantia,false) and ct.os_garantia_stat' +
        'us='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '            and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturad' +
        'as as outras entram pelas notas fiscais devido a cr'#233'ditos de tro' +
        'ca */'
      '            and f.regimetributario <> 1  /* regime normal */'
      #9#9#9'and c.piscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      #9'  '
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '        cast('#39'NF '#39'||np.numero as varchar(30)) as documento,'
      '        np.data,'
      '        np.fornecedor as cliente,'
      '        np.tipofornecedor as tipocliente,'
      '        np.nome as nomecliente,'
      '      '
      #9'  '
      #9'  '
      '      ((pnp.quantidade * pnp.precounitario)'
      '      - coalesce(pnp.valordescontoitem,0)'
      '      - coalesce(pnp.desconto,0)'
      '      + coalesce(pnp.acrescimo,0)'
      '      + coalesce(pnp.frete,0)'
      '      + coalesce(pnp.seguro,0)'
      '      + coalesce(pnp.valoripi,0)'
      
        '      + coalesce(pnp.despesasacessorias,0)) * coalesce(c.aliquot' +
        'apis,0)/100'
      #9'   as ValorBrutodoProduto'
      #9'   '
      ''
      '     from ((notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      '                       on p.caracteristica=c.codigo)'
      '                 on pnp.produto=p.codigo) '
      #9#9'   on np.codigo = pnp.codigonota)'
      #9#9'   '
      '           join filiais f'
      #9'       on np.filial = f.codigo)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      #9'   and f.regimetributario <> 1  /* regime normal */'
      
        #9'   and c.piscst in ('#39'50'#39','#39'51'#39','#39'52'#39','#39'53'#39','#39'54'#39','#39'55'#39','#39'56'#39','#39'60'#39','#39'61' +
        #39','#39'62'#39','#39'63'#39','#39'64'#39','#39'65'#39','#39'66'#39')'
      ''
      '      )'
      ''
      ''
      '      union all'
      ''
      '      ('
      
        '         /* CONTRATOS CANCELADOS SEM CONTRATOS DEVOLVIDOS, TOTAL' +
        'MENTE CANCELADOS SEM PARCELAS PAGAS */'
      '          select'
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '      cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '      ct.faturamento as data,'
      '      ct.cliente,'
      '      ct.tipocliente,'
      '      ct.nome as nomecliente,'
      '      '
      ''
      '          (((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      
        '            ) * coalesce(c.aliquotapis,0)/100) as  ValorBrutodoP' +
        'roduto'
      ''
      '            /*'
      ''
      '       VALOR BRUTO'
      '      ((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '        (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)' +
        '-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                     coalesce((select  sum(sc.qu' +
        'antidade*coalesce(sc.valorservico,0))'
      '          from servicoscontratos sc'
      '          where sc.contrato = ct.numero),0)),0),1))'
      '        )) +'
      ''
      '       ACRESCIMO'
      ''
      
        '       (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precove' +
        'nda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      
        '         ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)' +
        ')  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1)))) * ' +
        'coalesce(c.aliquotapis,0)/100) as ValorBrutodoProduto'
      ''
      '                  */'
      ''
      ''
      '      from (select distinct ct.numero, p.datapagto'
      '            from contratos ct, parcelas p'
      '            where ct.numero=p.contrato'
      '         and ct.situacao='#39'C'#39
      '         and not exists (select p2.numero'
      '                             from parcelas p2'
      '                             where p2.contrato = ct.numero '
      '                   and p2.tipopagto<>'#39'E'#39') '
      '         and p.datapagto between :datainicial and :datafinal '
      '         and not exists (select cd.contrato'
      '                             from contratosdevolvidos cd'
      
        '                             where cd.contrato = ct.numero /*and' +
        ' cd.tipo='#39'D'#39'*/)'
      
        '             and case when ct.os then ct.tipoequipamento in (1,2' +
        ') and not (coalesce(ct.os_garantia,false) and ct.os_garantia_sta' +
        'tus='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '           ) as cancelados, ((contratos ct '
      '                             join (produtoscontratos pc'
      '                                   join (produtos p'
      
        '                                         join (((caracteristicas' +
        ' c'
      '                                                 join classes cl'
      
        '                                                 on c.classe = c' +
        'l.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      '                                                 join grupos g'
      
        '                                                 on c.grupo = g.' +
        'codigo)'
      ''
      
        '                                                join tiposprodut' +
        'o tp'
      
        '                                                on c.tipoproduto' +
        ' = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                         on p.caracteristica = c' +
        '.codigo)'
      '                                   on pc.produto=p.codigo)'
      '                             on pc.contrato = ct.numero)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' join filiais f'
      #9#9#9#9#9'         on ct.filialvenda = f.codigo)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' '
      '      where cancelados.numero = ct.numero'
      #9#9'and f.regimetributario <> 1  /* regime normal */'
      #9#9'and c.piscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      ''
      ''
      '      )'
      ''
      #9') as impostos'
      #9'       group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo,'
      '            grupo,'
      '            descricaoclasse,'
      '            classe,'
      ''
      '            impostos.data,'
      '            impostos.documento,'
      '            impostos.cliente,'
      '            impostos.tipocliente,'
      '            impostos.nomecliente'
      '            '
      ''
      '   )'
      '   '
      '   union all'
      '   '
      '   ('
      '   '
      '   '
      '    /* IMPOSTOS - COFINS - REGIME NORMAL */'
      #9
      '     select impostos.tipoproduto,'
      
        '            cast('#39'IMPOSTOS - COFINS - '#39' as varchar)||cast(impost' +
        'os.descricaotipoproduto as varchar) as descricaotipoproduto,'
      '            impostos.grupo,'
      '            impostos.descricaogrupo,'
      '            impostos.classe,'
      '            impostos.descricaoclasse,'
      ''
      '            impostos.documento,'
      '            impostos.data,'
      '            impostos.cliente,'
      '            impostos.tipocliente,'
      '            impostos.nomecliente,       '
      '            '
      
        '            sum(impostos.ValorBrutodoProduto) as ValorBrutodoPro' +
        'duto '
      #9'from'#9#9
      #9
      #9'('
      ''
      '      ('
      
        '            /* VENDAS COM CONTRATO BRUTO + ACRESIMCO - DESCONTO ' +
        '*/'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      ''
      
        #9'case when :AgruparGrupo then c.grupo     else cast(null as varc' +
        'har(4)) end as grupo,'
      
        #9'case when :AgruparGrupo then g.descricao else cast(null as varc' +
        'har(30)) end as descricaogrupo,'
      
        #9'case when :AGruparClasse then c.classe    else cast(null as var' +
        'char(2)) end as classe,'
      
        #9'case when :AGruparClasse then cl.descricao else cast(null as va' +
        'rchar(30)) end as descricaoclasse,'
      '    '
      '        cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '        ct.faturamento as data,'
      '        ct.cliente,'
      '        ct.tipocliente,'
      '        ct.nome as nomecliente,       '
      ''
      ''
      '          -'
      '          (((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      
        '            ) * coalesce(c.aliquotacofins,0)/100) as  ValorBruto' +
        'doProduto'
      ''
      '        /*'
      ''
      '      -'
      '       VALOR BRUTO'
      '      ((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1)))) +'
      ''
      '       ACRESCIMO'
      
        '        (((ValorPrazo-ValorVista)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      
        '        ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1)))) * ' +
        'coalesce(c.aliquotacofins,0)/100)'
      ''
      '        as  ValorBrutodoProduto'
      ''
      '        */'
      ''
      ''
      '       from ((contratos ct'
      '             join (produtoscontratos pc'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9' '
      '                         on p.caracteristica=c.codigo)'
      '                   on pc.produto=p.codigo)'
      '             on ct.numero = pc.contrato)'
      #9#9#9' '
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = ct.filialvenda)'
      ''
      '       where not pc.brinde'
      
        '         and ct.faturamento between(:datainicial) and (:datafina' +
        'l)'
      '         and (coalesce(ct.valorvista,0)<>0)'
      '         and ct.origem is null'
      '         and f.regimetributario <> 1  /* regime normal */'
      #9#9' and c.cofinscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      #9#9' and coalesce(c.aliquotacofins,0)<>0'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      '        /* VENDAS SEM CONTRATO */'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      #9#9
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '      case when n.dadofiscal is not null then'
      '        cast('#39'NF '#39'||n.numero||'#39' S'#233'rie '#39'||n.serie as varchar(30))'
      '      else'
      
        '        cast('#39'CF '#39'||cp.numero||'#39' Mq. '#39'||cp.maquina||'#39' Int.'#39'||cp.' +
        'intervensao as varchar(30))'
      '      end as documento,'
      '      df.data,'
      '      df.cliente,'
      '      df.tipocliente,'
      '      df.nome as nomecliente,'
      '      '
      ''
      #9#9'-'
      '       (((pdf.quantidade * pdf.precovenda)'
      '         - coalesce(pdf.valordescontoitem,0)'
      '         - coalesce(pdf.desconto,0)'
      '         + coalesce(pdf.acrescimo,0)'
      '         + coalesce(pdf.frete,0)'
      '         + coalesce(pdf.seguro,0)'
      '         + coalesce(pdf.valoripi,0)'
      
        '         + coalesce(pdf.despesasacessorias,0)) * coalesce(c.aliq' +
        'uotacofins,0)/100) as ValorBrutodoProduto'
      #9#9
      #9#9#9#9#9#9
      '/*'
      '       -- VALOR BRUTO '
      '      ((pdf.quantidade*pdf.precovenda) +'
      
        '        (((coalesce(df.valorfrete,0)+coalesce(df.seguro,0))*(pdf' +
        '.quantidade*pdf.precovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      '          where sdf.dadofiscal = df.numero),0)),0),1)))) +'
      #9#9'  '
      '       -- ACRESCIMO '
      
        '        (((df.Valortotal-df.ValorVista)*(pdf.quantidade*pdf.prec' +
        'ovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      
        '                  where sdf.dadofiscal = df.numero),0)),0),1))) ' +
        ' -'
      #9#9#9#9'  '
      '       -- DESCONTO '#9'   '
      
        '      ((coalesce(df.desconto,0)*(pdf.quantidade*pdf.precovenda))' +
        '  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      #9#9#9#9
      '       as ValorBrutodoProduto'
      '*/'#9'   '
      ''
      #9'   '
      ''
      '       from ((dadosfiscais df'
      '               join (produtosdadosfiscais pdf'
      '                     join (produtos p'
      '                           join (((caracteristicas c'
      '                                   join classes cl'
      '                                   on c.classe=cl.codigo)'
      ''
      '                                   join grupos g'
      '                                   on c.grupo = g.codigo)'
      ''
      '                                   join tiposproduto tp'
      '                                   on c.tipoproduto = tp.codigo)'
      ''
      '                           on p.caracteristica=c.codigo)'
      '                    on pdf.produto=p.codigo) '
      #9#9#9'   on df.numero = pdf.dadofiscal)'
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = df.filialvenda)'
      '             '
      '             left join notas n on df.numero = n.dadofiscal'
      '             left join cupons cp on df.numero = cp.dadofiscal'
      '             '
      #9#9#9'   '
      #9#9#9'   '
      '       Where (df.data between (:datainicial) and (:datafinal))'
      '          and df.contrato is null'
      '          and df.situacao='#39'N'#39
      
        '          and ((eHNotaFiscalSaidaVenda(pdf.codigofiscal) and c.c' +
        'ofinscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')) or /* vendas */'
      
        #9#9'       (eHNotaFiscalSaidaDevolucao(pdf.codigofiscal) and c.cof' +
        'inscst in ('#39'49'#39')))    /* devolu'#231#245'es de compras, conforme regra d' +
        'o sped */'
      '          and not coalesce(df.notavinculada,false)'
      '          and f.regimetributario <> 1  /* regime normal */'
      #9#9'  '
      ''
      '     )'
      ''
      '       union all'
      ''
      '     ('
      '         /* DEVOLUCOES COM CONTRATO */'
      ''
      '          select'
      ''
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '          cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '          ct.faturamento as data,'
      '          ct.cliente,'
      '          ct.tipocliente,'
      '          ct.nome as nomecliente,          '
      '      '
      #9#9
      '           '
      '      /* VALOR BRUTO */'
      '      (((cd.valorvista + cd.desconto) +'
      '      /* ACRESCIMO*/'
      
        '       (cd.ValorPrazo-cd.ValorVista)) * coalesce(c.aliquotacofin' +
        's,0)/100) as ValorBrutodoproduto'
      ''
      '          from ((contratosdevolvidos cd'
      '                 join (contratos ct'
      #9#9#9#9'       join filiais f'
      #9#9#9#9#9'   on ct.filialvenda = f.codigo)'
      '                 on cd.contrato=ct.numero)'
      ''
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      '                       on p.caracteristica=c.codigo)'
      '                 on cd.produto=p.codigo)'
      ''
      
        '          where cd.devolucao between(:DataInicial) and (:DataFin' +
        'al)'
      '            /* and cd.tipo = '#39'D'#39' */'
      
        '            and case when ct.os then ct.tipoequipamento in (1,2)' +
        ' and not (coalesce(ct.os_garantia,false) and ct.os_garantia_stat' +
        'us='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '            and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturad' +
        'as as outras entram pelas notas fiscais devido a cr'#233'ditos de tro' +
        'ca */'
      '            and f.regimetributario <> 1  /* regime normal */'
      #9#9#9'and c.cofinscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '        cast('#39'NF '#39'||np.numero as varchar(30)) as documento,'
      '        np.data,'
      '        np.fornecedor as cliente,'
      '        np.tipofornecedor as tipocliente,'
      '        np.nome as nomecliente,'
      '      '
      #9'  '
      ''
      '      ((pnp.quantidade * pnp.precounitario)'
      '      - coalesce(pnp.valordescontoitem,0)'
      '      - coalesce(pnp.desconto,0)'
      '      + coalesce(pnp.acrescimo,0)'
      '      + coalesce(pnp.frete,0)'
      '      + coalesce(pnp.seguro,0)'
      '      + coalesce(pnp.valoripi,0)'
      
        '      + coalesce(pnp.despesasacessorias,0)) * coalesce(c.aliquot' +
        'acofins,0)/100'
      #9'   as ValorBrutodoProduto'
      #9'   '
      ''
      '     from ((notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      '                       on p.caracteristica=c.codigo)'
      '                 on pnp.produto=p.codigo) '
      #9#9'   on np.codigo = pnp.codigonota)'
      #9#9'   '
      '           join filiais f'
      #9'       on np.filial = f.codigo)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      #9'   and f.regimetributario <> 1  /* regime normal */'
      
        #9'   and c.cofinscst in ('#39'50'#39','#39'51'#39','#39'52'#39','#39'53'#39','#39'54'#39','#39'55'#39','#39'56'#39','#39'60'#39',' +
        #39'61'#39','#39'62'#39','#39'63'#39','#39'64'#39','#39'65'#39','#39'66'#39')'
      ''
      '      )'
      ''
      ''
      '      union all'
      ''
      '      ('
      
        '         /* CONTRATOS CANCELADOS SEM CONTRATOS DEVOLVIDOS, TOTAL' +
        'MENTE CANCELADOS SEM PARCELAS PAGAS */'
      '          select'
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '      cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '      ct.faturamento as data,'
      '      ct.cliente,'
      '      ct.tipocliente,'
      '      ct.nome as nomecliente,'
      '      '
      ''
      '          (((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      
        '            ) * coalesce(c.aliquotacofins,0)/100) as  ValorBruto' +
        'doProduto'
      ''
      '        /*'
      ''
      '       VALOR BRUTO'
      '      ((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '        (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)' +
        '-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                     coalesce((select  sum(sc.qu' +
        'antidade*coalesce(sc.valorservico,0))'
      '          from servicoscontratos sc'
      '          where sc.contrato = ct.numero),0)),0),1))'
      '        )) +'
      ''
      '       ACRESCIMO'
      ''
      
        '       (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precove' +
        'nda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      
        '         ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)' +
        ')  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1)))) * ' +
        'coalesce(c.aliquotacofins,0)/100) as ValorBrutodoProduto'
      '       */'
      ''
      '      from (select distinct ct.numero, p.datapagto'
      '            from contratos ct, parcelas p'
      '            where ct.numero=p.contrato'
      '         and ct.situacao='#39'C'#39
      '         and not exists (select p2.numero'
      '                             from parcelas p2'
      '                             where p2.contrato = ct.numero'
      '                   and p2.tipopagto<>'#39'E'#39')'
      '         and p.datapagto between :datainicial and :datafinal'
      '         and not exists (select cd.contrato'
      '                             from contratosdevolvidos cd'
      
        '                             where cd.contrato = ct.numero /*and' +
        ' cd.tipo='#39'D'#39'*/)'
      
        '             and case when ct.os then ct.tipoequipamento in (1,2' +
        ') and not (coalesce(ct.os_garantia,false) and ct.os_garantia_sta' +
        'tus='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '           ) as cancelados, ((contratos ct '
      '                             join (produtoscontratos pc'
      '                                   join (produtos p'
      
        '                                         join (((caracteristicas' +
        ' c'
      '                                                 join classes cl'
      
        '                                                 on c.classe = c' +
        'l.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      '                                                 join grupos g'
      
        '                                                 on c.grupo = g.' +
        'codigo)'
      ''
      
        '                                                join tiposprodut' +
        'o tp'
      
        '                                                on c.tipoproduto' +
        ' = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                         on p.caracteristica = c' +
        '.codigo)'
      '                                   on pc.produto=p.codigo)'
      '                             on pc.contrato = ct.numero)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' join filiais f'
      #9#9#9#9#9'         on ct.filialvenda = f.codigo)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' '
      '      where cancelados.numero = ct.numero'
      #9#9'and f.regimetributario <> 1  /* regime normal */'
      #9#9'and c.cofinscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      ''
      ''
      '      )'
      ''
      #9') as impostos'
      ''
      #9'    group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo, grupo,'
      '            descricaoclasse, classe,'
      ''
      '            impostos.documento,'
      '            impostos.data,'
      '            impostos.cliente,'
      '            impostos.tipocliente,'
      '            impostos.nomecliente'
      ''
      ''
      ''
      ''
      '   )'
      ''
      ''
      '  ) as dev'
      '       group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo, grupo, descricaoclasse, classe,'
      ''
      '            dev.documento,'
      '            dev.data,'
      '            dev.cliente,'
      '            dev.tipocliente,'
      '            dev.nomecliente'
      ''
      ''
      ''
      ''
      ')'
      ''
      ') as sel'
      'where valorBrutodoProduto is not null'
      ''
      '   order by classificacao,  descricaoclassificacao,'
      '            tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo, grupo,'
      '            descricaoclasse, classe,'
      ''
      '            data,'
      '            documento,'
      '            cliente,'
      '            tipocliente,'
      '            nomecliente')
    RequestLive = False
    Left = 112
    Top = 16
    ParamData = <
      item
        DataType = ftString
        Name = 'AgruparGrupo'
        ParamType = ptUnknown
        Value = 'true'
      end
      item
        DataType = ftUnknown
        Name = 'AGruparClasse'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'datainicial'
        ParamType = ptUnknown
        Value = #39'2015-01-01'#39
      end
      item
        DataType = ftString
        Name = 'datafinal'
        ParamType = ptUnknown
        Value = #39'2015-01-31'#39
      end>
  end
  object qryReceita_Operacional_Bruta_Regime_de_Competencia: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select sel.*'
      'from'
      '('
      ''
      '('
      '   /* VENDAS COM CONTRATOS */'
      '  select cast(1 as integer) as classificacao,'
      
        '         cast('#39'RECEITA OPERACIONAL BRUTA'#39' as varchar(50)) as des' +
        'cricaoclassificacao,'
      '         vp.tipoproduto,'
      '         vp.descricaotipoproduto,'
      '         vp.grupo,'
      '         vp.descricaogrupo,'
      '         vp.classe,'
      '         vp.descricaoclasse,'
      '         '
      '         vp.documento,'
      '         vp.data,'
      '         vp.cliente,'
      '         vp.tipocliente,'
      '         vp.nomecliente,'
      '         '
      '         sum(vp.ValorBrutodoProduto) as ValorBrutodoProduto'
      '  from'
      '  ('
      '    ('
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      ''
      
        '      case when :AgruparGrupo  then c.grupo      else cast(null ' +
        'as varchar(4))  end as grupo,'
      
        '      case when :AgruparGrupo  then g.descricao  else cast(null ' +
        'as varchar(30)) end as descricaogrupo,'
      
        '      case when :AGruparClasse then c.classe     else cast(null ' +
        'as varchar(2))  end as classe,'
      
        '      case when :AGruparClasse then cl.descricao else cast(null ' +
        'as varchar(30)) end as descricaoclasse,'
      '      '
      '      cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '      ct.faturamento as data,'
      '      ct.cliente,'
      '      ct.tipocliente,'
      '      ct.nome as nomecliente,'
      '      '
      ''
      '      ((pc.quantidade*pc.precovenda) +'
      '                coalesce(pc.frete,0) +'
      '               coalesce(pc.seguro,0) +'
      '           coalesce(pc.acrescimo,0)) as  ValorBrutodoProduto'
      ''
      ''
      '     from (contratos ct'
      '           join (produtoscontratos pc'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on pc.produto=p.codigo)'
      '           on ct.numero = pc.contrato)'
      ''
      '     where not pc.brinde and'
      
        '               ct.faturamento between(:datainicial) and (:datafi' +
        'nal) and'
      '               (coalesce(ct.valorvista,0)<>0) and'
      '               ct.origem is null'
      ''
      '    )'
      '    union all'
      '    ('
      '      /* VENDAS SEM CONTRATO */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      
        '      case when :AgruparGrupo then c.grupo     else cast(null as' +
        ' varchar(4)) end as grupo,'
      
        '      case when :AgruparGrupo then g.descricao else cast(null as' +
        ' varchar(30)) end as descricaogrupo,'
      
        '      case when :AGruparClasse then c.classe    else cast(null a' +
        's varchar(2)) end as classe,'
      
        '      case when :AGruparClasse then cl.descricao else cast(null ' +
        'as varchar(30)) end as descricaoclasse,'
      '      '
      '      case when n.dadofiscal is not null then'
      '        cast('#39'NF '#39'||n.numero||'#39' S'#233'rie '#39'||n.serie as varchar(30))'
      '      else'
      
        '        cast('#39'CF '#39'||cp.numero||'#39' Mq. '#39'||cp.maquina||'#39' Int.'#39'||cp.' +
        'intervensao as varchar(30))'
      '      end as documento,'
      '      df.data,'
      '      df.cliente,'
      '      df.tipocliente,'
      '      df.nome as nomecliente,'
      '      '
      ''
      '      ((pdf.quantidade*pdf.precovenda) +'
      '                 coalesce(pdf.frete,0) +'
      '                coalesce(pdf.seguro,0) +'
      
        '                coalesce(pdf.acrescimo,0)) as ValorBrutodoProdut' +
        'o'
      ''
      ''
      '      from (dadosfiscais df'
      '             join (produtosdadosfiscais pdf'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      ''
      '                         on p.caracteristica=c.codigo)'
      
        '             on pdf.produto=p.codigo) on df.numero = pdf.dadofis' +
        'cal)'
      '             '
      '             left join notas n on df.numero = n.dadofiscal'
      '             left join cupons cp on df.numero = cp.dadofiscal'
      ''
      
        '      Where (df.data between (:datainicial) and (:datafinal)) an' +
        'd df.contrato is null'
      '              and df.situacao='#39'N'#39
      '              and eHNotaFiscalSaidaVenda(pdf.codigofiscal)'
      '        and not coalesce(df.notavinculada,false)'
      ''
      ''
      '    )'
      '  )  as vp'
      '     group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo,'
      '            grupo,'
      '            descricaoclasse,'
      '            classe,'
      ''
      '         vp.data,'
      '         vp.documento,'
      '         vp.cliente,'
      '         vp.tipocliente,'
      '         vp.nomecliente'
      ''
      '            '
      ''
      ''
      ')'
      ''
      '  union all'
      ''
      '('
      '    select'
      ''
      '      cast(1 as integer) as classificacao,'
      
        '      cast('#39'RECEITA OPERACIONAL BRUTA'#39' as varchar(50)) as descri' +
        'caoclassificacao,'
      ''
      '      cast('#39'09'#39' as varchar(2)) as tipoproduto,'
      
        '      (select tp.descricao from tiposproduto tp where tp.codigo ' +
        '= '#39'09'#39') as descricaotipoproduto,'
      ''
      #9'  '
      
        #9'  case when :AgruparGrupo then cast('#39'SE'#39' as varchar(4))        ' +
        'else cast(null as varchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then cast('#39'SERVICOS'#39' as varchar(30)) ' +
        'else cast(null as varchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then cast('#39'SE'#39' as varchar(02))      ' +
        ' else cast(null as varchar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cast('#39'SERVICOS'#39' as varchar(30))' +
        ' else cast(null as varchar(30)) end as descricaoclasse,'
      '      '
      '      cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '      ct.faturamento as data,'
      '      ct.cliente,'
      '      ct.tipocliente,'
      '      ct.nome as nomecliente,'
      '      '
      ''
      
        '      sum(round((coalesce(sc.quantidade,0)*coalesce(sc.valorserv' +
        'ico,0)),2)) as valorBrutodoProduto'
      ''
      '   from (contratos ct'
      ''
      '                              join servicoscontratos sc'
      
        '                                                                ' +
        '        on ct.numero = sc.contrato)'
      '   where ct.faturamento between(:DataInicial) and (:DataFinal)'
      ''
      
        '   group by ct.numero, ct.faturamento, ct.cliente, ct.tipoclient' +
        'e, ct.nome'
      ''
      ')'
      ''
      'union all'
      ''
      ''
      '('
      '  select cast(2 as integer) as classificacao,'
      
        '        cast('#39'(-) DEDU'#199#213'ES DA RECEITA BRUTA'#39' as varchar(50)) as ' +
        'descricaoclassificacao,'
      '        dev.tipoproduto,'
      '        dev.descricaotipoproduto,'
      '        dev.grupo,'
      '        dev.descricaogrupo,'
      '        dev.classe,'
      '        dev.descricaoclasse,'
      '        '
      '        dev.documento,'
      '        dev.data,'
      '        dev.cliente,'
      '        dev.tipocliente,'
      '        dev.nomecliente,'
      '        '
      '        sum(dev.ValorBrutodoproduto) as ValorBrutodoproduto'
      '  from'
      '  ('
      ''
      '    ('
      ''
      '       /* CONTRATOS FATURADOS DEVOLVIDOS */'
      '        select'
      ''
      '        c.tipoproduto,'
      
        '        cast('#39'DEVOLU'#199#213'ES - '#39' as varchar)||cast(tp.descricao as v' +
        'archar) as descricaotipoproduto,'
      #9#9
      
        '  '#9'    case when :AgruparGrupo then c.grupo     else cast(null a' +
        's varchar(4)) end as grupo,'
      
        #9'    case when :AgruparGrupo then g.descricao else cast(null as ' +
        'varchar(30)) end as descricaogrupo,'
      
        #9'    case when :AGruparClasse then c.classe    else cast(null as' +
        ' varchar(2)) end as classe,'
      
        #9'    case when :AGruparClasse then cl.descricao else cast(null a' +
        's varchar(30)) end as descricaoclasse,'
      '        '
      '        cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '        ct.faturamento as data,'
      '        ct.cliente,'
      '        ct.tipocliente,'
      '        ct.nome as nomecliente,'
      ''
      '        -'
      #9#9'/* VALOR BRUTO */'
      #9#9'((cd.valorvista + cd.desconto) +'
      #9#9'/* ACRESCIMO*/'
      #9#9' (cd.ValorPrazo-cd.ValorVista))'
      #9#9'as ValorBrutodoproduto'
      ''
      '        from ((contratosdevolvidos cd'
      '               join contratos ct'
      '               on cd.contrato=ct.numero)'
      ''
      '               join (produtos p'
      '                     join (((caracteristicas c'
      '                             join classes cl'
      '                             on c.classe=cl.codigo)'
      ''
      '                             join grupos g'
      '                             on c.grupo = g.codigo)'
      ''
      '                             join tiposproduto tp'
      '                             on c.tipoproduto = tp.codigo)'
      ''
      '                     on p.caracteristica=c.codigo)'
      '               on cd.produto=p.codigo)'
      ''
      
        '        where cd.devolucao between(:DataInicial) and (:DataFinal' +
        ')'
      '          /* and cd.tipo = '#39'D'#39' */'
      
        '          and case when ct.os then ct.tipoequipamento in (1,2) a' +
        'nd not (coalesce(ct.os_garantia,false) and ct.os_garantia_status' +
        '='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '          and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturadas' +
        ' as outras entram pelas notas fiscais devido a cr'#233'ditos de troca' +
        ' */'
      ''
      '    )'
      ''
      ''
      '    union all'
      ''
      '    ('
      '        /* CONTRATOS FATURADOS TOTALMENTE CANCELADOS  */'
      '        select'
      '        c.tipoproduto,'
      
        #9#9'    cast('#39'DEVOLU'#199#213'ES - '#39' as varchar)||cast(tp.descricao as var' +
        'char) as descricaotipoproduto,'
      ''
      
        #9'    case when :AgruparGrupo then c.grupo     else cast(null as ' +
        'varchar(4)) end as grupo,'
      
        #9'    case when :AgruparGrupo then g.descricao else cast(null as ' +
        'varchar(30)) end as descricaogrupo,'
      
        #9'    case when :AGruparClasse then c.classe    else cast(null as' +
        ' varchar(2)) end as classe,'
      
        #9'    case when :AGruparClasse then cl.descricao else cast(null a' +
        's varchar(30)) end as descricaoclasse,'
      '        '
      '        cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '        ct.faturamento as data,'
      '        ct.cliente,'
      '        ct.tipocliente,'
      '        ct.nome as nomecliente,       '
      ''
      '            -'
      '            ((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      '            ) as  ValorBrutodoProduto'
      ''
      #9'     /*'
      '      -'
      #9'   VALOR BRUTO'
      ''
      #9'  (((pc.quantidade*pc.precovenda) +'
      
        '      (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quantid' +
        'ade*pc.precovenda))  /'
      
        '      (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-c' +
        'oalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                   coalesce((select  sum(sc.quan' +
        'tidade*coalesce(sc.valorservico,0))'
      '        from servicoscontratos sc'
      '        where sc.contrato = ct.numero),0)),0),1))'
      '      )) +'
      ''
      #9'   ACRESCIMO'
      ''
      
        #9'   (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precovenda' +
        '))  /'
      
        '       (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-' +
        'coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '               coalesce((select  sum(sc.quantidade*coalesce(sc.v' +
        'alorservico,0))'
      '                from servicoscontratos sc'
      '                where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      #9#9' DESCONTO'
      
        '       ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)) ' +
        ' /'
      
        '       (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-' +
        'coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '               coalesce((select  sum(sc.quantidade*coalesce(sc.v' +
        'alorservico,0))'
      '                from servicoscontratos sc'
      '                where sc.contrato = ct.numero),0)),0),1))))'
      ''
      #9'  as ValorBrutodoProduto'
      ''
      '          */'
      ''
      ''
      '    from (select distinct ct.numero, p.datapagto'
      '          from contratos ct, parcelas p'
      '          where ct.numero=p.contrato '
      #9#9'   and ct.situacao='#39'C'#39' '
      #9#9'   and not exists (select p2.numero'
      '                           from parcelas p2'
      '                           where p2.contrato = ct.numero '
      #9#9#9#9#9#9'     and p2.tipopagto<>'#39'E'#39') '
      #9#9'   and p.datapagto between :datainicial and :datafinal '
      #9#9'   and not exists (select cd.contrato'
      '                           from contratosdevolvidos cd'
      
        '                           where cd.contrato = ct.numero /*and c' +
        'd.tipo='#39'D'#39'*/ )'
      
        '           and case when ct.os then ct.tipoequipamento in (1,2) ' +
        'and not (coalesce(ct.os_garantia,false) and ct.os_garantia_statu' +
        's='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '         ) as cancelados, (contratos ct '
      #9#9'                   join (produtoscontratos pc'
      #9#9#9#9#9#9'         join (produtos p'
      #9#9#9#9#9#9#9#9'       join (((caracteristicas c'
      #9#9#9#9#9#9#9#9#9'           join classes cl'
      #9#9#9#9#9#9#9#9#9#9#9'   on c.classe = cl.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9#9#9#9#9'  join grupos g'
      #9#9#9#9#9#9#9#9#9#9#9'  on c.grupo = g.codigo)'
      ''
      #9#9#9#9#9#9#9#9#9#9#9' join tiposproduto tp'
      #9#9#9#9#9#9#9#9#9#9#9' on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                       on p.caracteristica = c.c' +
        'odigo)'
      '                                 on pc.produto=p.codigo)'
      '                           on pc.contrato = ct.numero)'
      '    where cancelados.numero = ct.numero'
      #9#9
      ''
      '    )'
      ''
      '    union all'
      ''
      '    ('
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      
        '      cast('#39'DEVOLU'#199#213'ES - '#39' as varchar)||cast(tp.descricao as var' +
        'char) as descricaotipoproduto,'
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '        cast('#39'NF '#39'||np.numero as varchar(30)) as documento,'
      '        np.data,'
      '        np.fornecedor as cliente,'
      '        np.tipofornecedor as tipocliente,'
      '        np.nome as nomecliente,'
      '      '
      ''
      '      -'
      '      ((pnp.quantidade * pnp.precounitario)'
      '      - coalesce(pnp.valordescontoitem,0)'
      '      - coalesce(pnp.desconto,0)'
      '      + coalesce(pnp.acrescimo,0)'
      '      + coalesce(pnp.frete,0)'
      '      + coalesce(pnp.seguro,0)'
      '      + coalesce(pnp.valoripi,0)'
      '      + coalesce(pnp.icmsvalorst,0)'
      '      + coalesce(pnp.despesasacessorias,0))'
      #9'   as ValorBrutodoProduto'
      ''
      '     from (notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      
        '           on pnp.produto=p.codigo) on np.codigo = pnp.codigonot' +
        'a)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      ''
      '    )'
      ''
      #9'union all'
      ''
      ''
      '    ('
      ''
      '       /* DESCONTOS DE VENDAS COM CONTRATO */'
      ''
      '      select'
      '      c.tipoproduto,'
      
        #9'  cast('#39'DESCONTOS - '#39' as varchar)||cast(tp.descricao as varchar' +
        ') as descricaotipoproduto,'
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '        cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '        ct.faturamento as data,'
      '        ct.cliente,'
      '        ct.tipocliente,'
      '        ct.nome as nomecliente,       '
      '      '
      ''
      '          - pc.descontogeral as ValorBrutodoProduto'
      ''
      '          /*'
      '      -'
      ''
      #9'  ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))  /'
      
        '       (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)-' +
        'coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '               coalesce((select  sum(sc.quantidade*coalesce(sc.v' +
        'alorservico,0))'
      '                from servicoscontratos sc'
      '                where sc.contrato = ct.numero),0)),0),1)))'
      ''
      #9'  as  ValorBrutodoProduto'
      '          */'
      ''
      ''
      '     from (contratos ct'
      '           join (produtoscontratos pc'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on pc.produto=p.codigo)'
      '           on ct.numero = pc.contrato)'
      ''
      '     where not pc.brinde and'
      
        '               ct.faturamento between(:datainicial) and (:datafi' +
        'nal) and'
      '               (coalesce(ct.valorvista,0)<>0) and'
      '               ct.origem is null and'
      #9#9#9'   coalesce(ct.desconto,0)<>0'
      ''
      '    )'
      '    union all'
      '    ('
      '       /* DESCONTOS DE VENDAS SEM CONTRATO */'
      ''
      '      select'
      '      c.tipoproduto,'
      
        '      cast('#39'DESCONTOS - '#39' as varchar)||cast(tp.descricao as varc' +
        'har) as descricaotipoproduto,'
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '      case when n.dadofiscal is not null then'
      '        cast('#39'NF '#39'||n.numero||'#39' S'#233'rie '#39'||n.serie as varchar(30))'
      '      else'
      
        '        cast('#39'CF '#39'||cp.numero||'#39' Mq. '#39'||cp.maquina||'#39' Int.'#39'||cp.' +
        'intervensao as varchar(30))'
      '      end as documento,'
      '      df.data,'
      '      df.cliente,'
      '      df.tipocliente,'
      '      df.nome as nomecliente,'
      '      '
      ''
      ''
      
        '      - (coalesce(pdf.desconto,0) + coalesce(pdf.valordescontoit' +
        'em,0)) as ValorBrutodoProduto'
      ''
      '      /*'
      '      -'
      
        '      ((coalesce(df.desconto,0)*(pdf.quantidade*pdf.precovenda))' +
        '  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      #9'   as ValorBrutodoProduto'
      '           */'
      ''
      ''
      '      from (dadosfiscais df'
      '             join (produtosdadosfiscais pdf'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      ''
      '                         on p.caracteristica=c.codigo)'
      
        '             on pdf.produto=p.codigo) on df.numero = pdf.dadofis' +
        'cal)'
      '             '
      '             left join notas n on df.numero = n.dadofiscal'
      '             left join cupons cp on df.numero = cp.dadofiscal'
      '             '
      ''
      
        '      Where (df.data between (:datainicial) and (:datafinal)) an' +
        'd df.contrato is null'
      '              and df.situacao='#39'N'#39
      '              and eHNotaFiscalSaidaVenda(pdf.codigofiscal)'
      '        and not coalesce(df.notavinculada,false) and'
      #9#9#9'   coalesce(df.desconto,0)<>0'
      ''
      ''
      '    )'
      ''
      #9#9'union all'
      ''
      ''
      #9'('
      ''
      #9'  /* IMPOSTOS - REGIME SIMPLES */'
      ''
      '     select impostos.tipoproduto,'
      
        '            cast('#39'IMPOSTOS - '#39' as varchar)||cast(impostos.descri' +
        'caotipoproduto as varchar) as descricaotipoproduto,'
      '            impostos.grupo,'
      '            impostos.descricaogrupo,'
      '            impostos.classe,'
      '            impostos.descricaoclasse,'
      '            '
      '            impostos.documento,'
      '            impostos.data,'
      '            impostos.cliente,'
      '            impostos.tipocliente,'
      '            impostos.nomecliente,       '
      '            '
      
        '            - sum(case when coalesce(impostos.aliquotaicmssn,0) ' +
        '= 0 then 0  else impostos.ValorBrutodoProduto * impostos.aliquot' +
        'aicmssn / 100 end) as ValorBrutodoProduto'
      #9'from'
      ''
      #9'('
      ''
      '      ('
      
        '            /* VENDAS COM CONTRATO BRUTO + ACRESIMCO - DESCONTO ' +
        '*/'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      ''
      
        '  '#9'    case when :AgruparGrupo then c.grupo     else cast(null a' +
        's varchar(4)) end as grupo,'
      
        #9'    case when :AgruparGrupo then g.descricao else cast(null as ' +
        'varchar(30)) end as descricaogrupo,'
      
        #9'    case when :AGruparClasse then c.classe    else cast(null as' +
        ' varchar(2)) end as classe,'
      
        #9'    case when :AGruparClasse then cl.descricao else cast(null a' +
        's varchar(30)) end as descricaoclasse,'
      '        '
      '        cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '        ct.faturamento as data,'
      '        ct.cliente,'
      '        ct.tipocliente,'
      '        ct.nome as nomecliente,'
      ''
      ''
      '      (select asn.aliquotaicms'
      '       from aliquotassimplesnacional asn'
      '         where asn.filial = ct.filialvenda'
      
        '         and asn.mesano = to_char(ct.faturamento, '#39'mm/yyyy'#39'))  a' +
        's aliquotaicmssn,'
      ''
      '            ((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      '            ) as  ValorBrutodoProduto'
      ''
      '            /*'
      ''
      '       VALOR BRUTO'
      '      ((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1)))) +'
      ''
      '       ACRESCIMO'
      
        '        (((ValorPrazo-ValorVista)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      
        '        ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1)))'
      ''
      '        as  ValorBrutodoProduto'
      ''
      '        */'
      ''
      ''
      '       from (contratos ct'
      '             join (produtoscontratos pc'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      ''
      '                         on p.caracteristica=c.codigo)'
      '                   on pc.produto=p.codigo)'
      '             on ct.numero = pc.contrato)'
      ''
      '       where not pc.brinde'
      
        '         and ct.faturamento between(:datainicial) and (:datafina' +
        'l)'
      '         and (coalesce(ct.valorvista,0)<>0)'
      '         and ct.origem is null'
      
        '         and (select f.regimetributario from filiais f where f.c' +
        'odigo = ct.filialvenda)=1  /* simples nacional*/'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      '        /* VENDAS SEM CONTRATO */'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      #9#9
      
        #9'    case when :AgruparGrupo then c.grupo     else cast(null as ' +
        'varchar(4)) end as grupo,'
      
        #9'    case when :AgruparGrupo then g.descricao else cast(null as ' +
        'varchar(30)) end as descricaogrupo,'
      
        #9'    case when :AGruparClasse then c.classe    else cast(null as' +
        ' varchar(2)) end as classe,'
      
        #9'    case when :AGruparClasse then cl.descricao else cast(null a' +
        's varchar(30)) end as descricaoclasse,'
      '        '
      '      case when n.dadofiscal is not null then'
      '        cast('#39'NF '#39'||n.numero||'#39' S'#233'rie '#39'||n.serie as varchar(30))'
      '      else'
      
        '        cast('#39'CF '#39'||cp.numero||'#39' Mq. '#39'||cp.maquina||'#39' Int.'#39'||cp.' +
        'intervensao as varchar(30))'
      '      end as documento,'
      '      df.data,'
      '      df.cliente,'
      '      df.tipocliente,'
      '      df.nome as nomecliente,'
      '        '
      #9#9
      ''
      '      (select asn.aliquotaicms'
      '       from aliquotassimplesnacional asn'
      '         where asn.filial = df.filialvenda'
      
        '         and asn.mesano = to_char(df.data, '#39'mm/yyyy'#39'))  as aliqu' +
        'otaicmssn,'
      ''
      ''
      ''
      '      ((pdf.quantidade*pdf.precovenda) +'
      '                 coalesce(pdf.frete,0) +'
      '                coalesce(pdf.seguro,0) +'
      '             coalesce(pdf.acrescimo,0) -'
      ''
      '              coalesce(pdf.desconto,0) -'
      '      coalesce(pdf.valordescontoitem,0)'
      ''
      '      ) as ValorBrutodoProduto'
      ''
      ''
      '      /*'
      ''
      '          VALOR BRUTO'
      ''
      '      ((pdf.quantidade*pdf.precovenda) +'
      
        '        (((coalesce(df.valorfrete,0)+coalesce(df.seguro,0))*(pdf' +
        '.quantidade*pdf.precovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      '          where sdf.dadofiscal = df.numero),0)),0),1)))) +'
      ''
      '        ACRESCIMO'
      ''
      
        '        (((df.Valortotal-df.ValorVista)*(pdf.quantidade*pdf.prec' +
        'ovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      
        '                  where sdf.dadofiscal = df.numero),0)),0),1))) ' +
        ' -'
      ''
      '        DESCONTO'
      ''
      
        '      ((coalesce(df.desconto,0)*(pdf.quantidade*pdf.precovenda))' +
        '  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      ''
      ''
      '       as ValorBrutodoProduto'
      ''
      '       */'
      ''
      '        from (dadosfiscais df'
      '               join (produtosdadosfiscais pdf'
      '                     join (produtos p'
      '                           join (((caracteristicas c'
      '                                   join classes cl'
      '                                   on c.classe=cl.codigo)'
      ''
      '                                   join grupos g'
      '                                   on c.grupo = g.codigo)'
      ''
      '                                   join tiposproduto tp'
      '                                   on c.tipoproduto = tp.codigo)'
      ''
      '                           on p.caracteristica=c.codigo)'
      
        '               on pdf.produto=p.codigo) on df.numero = pdf.dadof' +
        'iscal)'
      '               '
      '             left join notas n on df.numero = n.dadofiscal'
      '             left join cupons cp on df.numero = cp.dadofiscal'
      '               '
      ''
      '        Where (df.data between (:datainicial) and (:datafinal))'
      '          and df.contrato is null'
      '          and df.situacao='#39'N'#39
      '          and eHNotaFiscalSaidaVenda(pdf.codigofiscal)'
      '          and not coalesce(df.notavinculada,false)'
      
        '          and (select f.regimetributario from filiais f where f.' +
        'codigo = df.filialvenda)=1  /* simples nacional*/'
      ''
      ''
      '     )'
      ''
      '       union all'
      ''
      '     ('
      '         /* DEVOLUCOES COM CONTRATO */'
      ''
      '          select'
      ''
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        '  '#9'      case when :AgruparGrupo then c.grupo     else cast(null' +
        ' as varchar(4)) end as grupo,'
      
        #9'      case when :AgruparGrupo then g.descricao else cast(null a' +
        's varchar(30)) end as descricaogrupo,'
      
        #9'      case when :AGruparClasse then c.classe    else cast(null ' +
        'as varchar(2)) end as classe,'
      
        #9'      case when :AGruparClasse then cl.descricao else cast(null' +
        ' as varchar(30)) end as descricaoclasse,'
      '          '
      '          cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '          ct.faturamento as data,'
      '          ct.cliente,'
      '          ct.tipocliente,'
      '          ct.nome as nomecliente,          '
      #9#9'  '
      '      (select asn.aliquotaicms'
      '       from aliquotassimplesnacional asn'
      '         where asn.filial = ct.filialvenda'
      
        '         and asn.mesano = to_char(cd.devolucao, '#39'mm/yyyy'#39'))  as ' +
        'aliquotaicmssn,'
      #9#9
      #9#9
      '          - '
      '      /* VALOR BRUTO */'
      '      ((cd.valorvista + cd.desconto) +'
      '      /* ACRESCIMO*/'
      '       (cd.ValorPrazo-cd.ValorVista))'
      '      as ValorBrutodoproduto'
      ''
      '          from ((contratosdevolvidos cd'
      '                 join contratos ct'
      '                 on cd.contrato=ct.numero)'
      ''
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on cd.produto=p.codigo)'
      ''
      
        '          where cd.devolucao between(:DataInicial) and (:DataFin' +
        'al)'
      '            /* and cd.tipo = '#39'D'#39' */'
      
        '            and case when ct.os then ct.tipoequipamento in (1,2)' +
        ' and not (coalesce(ct.os_garantia,false) and ct.os_garantia_stat' +
        'us='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '            and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturad' +
        'as as outras entram pelas notas fiscais devido a cr'#233'ditos de tro' +
        'ca */'
      
        '            and (select f.regimetributario from filiais f where ' +
        'f.codigo = ct.filialvenda)=1  /* simples nacional*/'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      ''
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '        cast('#39'NF '#39'||np.numero as varchar(30)) as documento,'
      '        np.data,'
      '        np.fornecedor as cliente,'
      '        np.tipofornecedor as tipocliente,'
      '        np.nome as nomecliente,'
      '      '
      ''
      '            (select asn.aliquotaicms'
      '       from aliquotassimplesnacional asn'
      '         where asn.filial = np.filial'
      
        '         and asn.mesano = to_char(np.data, '#39'mm/yyyy'#39'))  as aliqu' +
        'otaicmssn,'
      ''
      ''
      '      -'
      '      ((pnp.quantidade * pnp.precounitario)'
      '      - coalesce(pnp.valordescontoitem,0)'
      '      - coalesce(pnp.desconto,0)'
      '      + coalesce(pnp.acrescimo,0)'
      '      + coalesce(pnp.frete,0)'
      '      + coalesce(pnp.seguro,0)'
      '      + coalesce(pnp.valoripi,0)'
      '      + coalesce(pnp.icmsvalorst,0)'
      '      + coalesce(pnp.despesasacessorias,0))'
      #9'   as ValorBrutodoProduto'
      ''
      '     from (notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      
        '           on pnp.produto=p.codigo) on np.codigo = pnp.codigonot' +
        'a)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      
        '       and (select f.regimetributario from filiais f where f.cod' +
        'igo = np.filial)=1  /* simples nacional*/'
      ''
      ''
      '      )'
      ''
      ''
      '      union all'
      ''
      '      ('
      
        '         /* CONTRATOS CANCELADOS SEM CONTRATOS DEVOLVIDOS, TOTAL' +
        'MENTE CANCELADOS SEM PARCELAS PAGAS */'
      '          select'
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      ''
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '      cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '      ct.faturamento as data,'
      '      ct.cliente,'
      '      ct.tipocliente,'
      '      ct.nome as nomecliente,'
      '      '
      ''
      '      (select asn.aliquotaicms'
      '         from aliquotassimplesnacional asn'
      '           where asn.filial = ct.filialvenda'
      
        '           and asn.mesano = to_char(cancelados.datapagto, '#39'mm/yy' +
        'yy'#39'))  as aliquotaicmssn,'
      ''
      ''
      '            -'
      '            ((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      '            ) as  ValorBrutodoProduto'
      ''
      '        /*'
      '        -'
      '       VALOR BRUTO'
      '      (((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '        (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)' +
        '-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                     coalesce((select  sum(sc.qu' +
        'antidade*coalesce(sc.valorservico,0))'
      '          from servicoscontratos sc'
      '          where sc.contrato = ct.numero),0)),0),1))'
      '        )) +'
      ''
      '       ACRESCIMO'
      ''
      
        '       (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precove' +
        'nda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      ''
      
        '         ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)' +
        ')  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))))'
      ''
      '      as ValorBrutodoProduto'
      ''
      '      */'
      ''
      ''
      '      from (select distinct ct.numero, p.datapagto'
      '            from contratos ct, parcelas p'
      '            where ct.numero=p.contrato '
      '         and ct.situacao='#39'C'#39' '
      '         and not exists (select p2.numero'
      '                             from parcelas p2'
      '                             where p2.contrato = ct.numero '
      '                   and p2.tipopagto<>'#39'E'#39') '
      '         and p.datapagto between :datainicial and :datafinal '
      '         and not exists (select cd.contrato'
      '                             from contratosdevolvidos cd'
      
        '                             where cd.contrato = ct.numero /*and' +
        ' cd.tipo='#39'D'#39'*/)'
      
        '             and case when ct.os then ct.tipoequipamento in (1,2' +
        ') and not (coalesce(ct.os_garantia,false) and ct.os_garantia_sta' +
        'tus='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '           ) as cancelados, (contratos ct '
      '                         join (produtoscontratos pc'
      '                       join (produtos p'
      '                         join (((caracteristicas c'
      '                               join classes cl'
      '                           on c.classe = cl.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      '                          join grupos g'
      '                          on c.grupo = g.codigo)'
      ''
      '                         join tiposproduto tp'
      '                         on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                         on p.caracteristica = c' +
        '.codigo)'
      '                                   on pc.produto=p.codigo)'
      '                             on pc.contrato = ct.numero)'
      '      where cancelados.numero = ct.numero'
      
        '        and (select f.regimetributario from filiais f where f.co' +
        'digo = ct.filialvenda)=1  /* simples nacional*/'
      ''
      ''
      '      )'
      ''
      #9') as impostos'
      #9'       group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo,'
      '            grupo,'
      '            descricaoclasse,'
      '            classe,'
      #9#9#9'aliquotaicmssn,'
      ''
      '            impostos.documento,'
      '            impostos.data,'
      '            impostos.cliente,'
      '            impostos.tipocliente,'
      '            impostos.nomecliente'
      ''
      ''
      '   )'
      '   '
      '   union all'
      '   '
      '   '
      '  ('
      '  '
      '    /* IMPOSTOS - ICMS - REGIME NORMAL */'
      #9
      '     select impostos.tipoproduto,'
      
        '            cast('#39'IMPOSTOS - ICMS - '#39' as varchar)||cast(impostos' +
        '.descricaotipoproduto as varchar) as descricaotipoproduto,'
      '            impostos.grupo,'
      '            impostos.descricaogrupo,'
      '            impostos.classe,'
      '            impostos.descricaoclasse,'
      '            '
      '            impostos.documento,'
      '            impostos.data,'
      '            impostos.cliente,'
      '            impostos.tipocliente,'
      '            impostos.nomecliente,                   '
      '            '
      
        '            sum(impostos.ValorBrutodoProduto) as ValorBrutodoPro' +
        'duto '
      #9'from'#9#9
      #9
      #9'('
      #9
      '      ('
      
        '            /* VENDAS COM CONTRATO  BRUTO + ACRESIMCO - DESCONTO' +
        ' */'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '        cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '        ct.faturamento as data,'
      '        ct.cliente,'
      '        ct.tipocliente,'
      '        ct.nome as nomecliente,       '
      '      '
      ''
      '        -'
      '          (((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      
        '            ) * Selecionar_Aliquotaicms(f.estado, ct.estado, ct.' +
        'pessoatipo, p.codigo)/100) as  ValorBrutodoProduto'
      ''
      '        /*'
      '      -'
      '       VALOR BRUTO'
      '      (((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1)))) +'
      ''
      '       ACRESCIMO'
      
        '        (((ValorPrazo-ValorVista)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      
        '        ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1))))*(1' +
        '-coalesce(c.percreducaobase,0)/100)) *'
      ''
      
        '                  Selecionar_Aliquotaicms(f.estado, ct.estado, c' +
        't.pessoatipo, p.codigo)/100)'
      '        as  ValorBrutodoProduto'
      ''
      '        */'
      ''
      ''
      '       from ((contratos ct'
      '             join (produtoscontratos pc'
      '                   join (produtos p'
      '                         join ((((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9#9' join tributosicms ti'
      #9#9#9#9#9#9#9#9' on c.incidencia = ti.codigo)'
      ''
      '                         on p.caracteristica=c.codigo)'
      '                   on pc.produto=p.codigo)'
      '             on ct.numero = pc.contrato)'
      #9#9#9' '
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = ct.filialvenda)'
      ''
      '       where not pc.brinde'
      
        '         and ct.faturamento between(:datainicial) and (:datafina' +
        'l)'
      '         and (coalesce(ct.valorvista,0)<>0)'
      '         and ct.origem is null'
      '         and f.regimetributario <> 1  /* regime normal */'
      #9#9' and ti.valor in ('#39'00'#39','#39'20'#39')'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      '        /* VENDAS SEM CONTRATO */'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      #9#9
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '      case when n.dadofiscal is not null then'
      '        cast('#39'NF '#39'||n.numero||'#39' S'#233'rie '#39'||n.serie as varchar(30))'
      '      else'
      
        '        cast('#39'CF '#39'||cp.numero||'#39' Mq. '#39'||cp.maquina||'#39' Int.'#39'||cp.' +
        'intervensao as varchar(30))'
      '      end as documento,'
      '      df.data,'
      '      df.cliente,'
      '      df.tipocliente,'
      '      df.nome as nomecliente,'
      '      '
      ''
      '/*'
      '       -- VALOR BRUTO '
      '      ((pdf.quantidade*pdf.precovenda) +'
      
        '        (((coalesce(df.valorfrete,0)+coalesce(df.seguro,0))*(pdf' +
        '.quantidade*pdf.precovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      '          where sdf.dadofiscal = df.numero),0)),0),1)))) +'
      #9#9'  '
      '       -- ACRESCIMO '
      
        '        (((df.Valortotal-df.ValorVista)*(pdf.quantidade*pdf.prec' +
        'ovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      
        '                  where sdf.dadofiscal = df.numero),0)),0),1))) ' +
        ' -'
      #9#9#9#9'  '
      '       -- DESCONTO '#9'   '
      
        '      ((coalesce(df.desconto,0)*(pdf.quantidade*pdf.precovenda))' +
        '  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      #9#9#9#9
      '       as ValorBrutodoProduto'
      '*/'
      ''
      '       - pdf.icmsvalor as ValorBrutodoProduto'
      #9'   '
      ''
      '       from ((dadosfiscais df'
      '               join (produtosdadosfiscais pdf'
      '                     join (produtos p'
      '                           join (((caracteristicas c'
      '                                   join classes cl'
      '                                   on c.classe=cl.codigo)'
      ''
      '                                   join grupos g'
      '                                   on c.grupo = g.codigo)'
      ''
      '                                   join tiposproduto tp'
      '                                   on c.tipoproduto = tp.codigo)'
      ''
      '                           on p.caracteristica=c.codigo)'
      '                    on pdf.produto=p.codigo) '
      #9#9#9'   on df.numero = pdf.dadofiscal)'
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = df.filialvenda)'
      '             '
      '             left join notas n on df.numero = n.dadofiscal'
      '             left join cupons cp on df.numero = cp.dadofiscal'
      ''
      #9#9#9'   '
      #9#9#9'   '
      '       Where (df.data between (:datainicial) and (:datafinal))'
      '          and df.contrato is null'
      '          and df.situacao='#39'N'#39
      '          and eHNotaFiscalSaidaVenda(pdf.codigofiscal)'
      '          and not coalesce(df.notavinculada,false)'
      '          and f.regimetributario <> 1  /* regime normal */'
      #9#9'  and pdf.incidencia in ('#39'00'#39','#39'20'#39')'
      ''
      '     )'
      ''
      '       union all'
      ''
      '     ('
      '         /* DEVOLUCOES COM CONTRATO */'
      ''
      '          select'
      ''
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '          cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '          ct.faturamento as data,'
      '          ct.cliente,'
      '          ct.tipocliente,'
      '          ct.nome as nomecliente,          '
      '      '
      #9#9
      '           '
      '      /* VALOR BRUTO */'
      '      ((((cd.valorvista + cd.desconto) +'
      '      /* ACRESCIMO*/'
      
        '       (cd.ValorPrazo-cd.ValorVista)) * (1-coalesce(c.percreduca' +
        'obase,0)/100)) * Selecionar_Aliquotaicms(f.estado, ct.estado, ct' +
        '.pessoatipo, p.codigo)/100) as ValorBrutodoproduto'
      ''
      '          from ((contratosdevolvidos cd'
      '                 join (contratos ct'
      #9#9#9#9'       join filiais f'
      #9#9#9#9#9'   on ct.filialvenda = f.codigo)'
      '                 on cd.contrato=ct.numero)'
      ''
      '                 join (produtos p'
      '                       join ((((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      #9#9#9#9#9#9#9'   join tributosicms ti'
      #9#9#9#9#9#9#9'   on c.incidencia = ti.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on cd.produto=p.codigo)'
      ''
      
        '          where cd.devolucao between(:DataInicial) and (:DataFin' +
        'al)'
      '            /* and cd.tipo = '#39'D'#39' */'
      
        '            and case when ct.os then ct.tipoequipamento in (1,2)' +
        ' and not (coalesce(ct.os_garantia,false) and ct.os_garantia_stat' +
        'us='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '            and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturad' +
        'as as outras entram pelas notas fiscais devido a cr'#233'ditos de tro' +
        'ca */'
      '            and f.regimetributario <> 1  /* regime normal */'
      #9#9#9'and ti.valor in ('#39'00'#39','#39'20'#39')'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '        cast('#39'NF '#39'||np.numero as varchar(30)) as documento,'
      '        np.data,'
      '        np.fornecedor as cliente,'
      '        np.tipofornecedor as tipocliente,'
      '        np.nome as nomecliente,'
      '      '
      ''
      '      pnp.icmsvalor as ValorBrutodoProduto'
      ''
      '     from ((notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join ((((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      #9#9#9#9#9#9#9'   join tributosicms ti'
      #9#9#9#9#9#9#9'   on c.incidencia = ti.codigo)'
      ''
      '                       on p.caracteristica=c.codigo)'
      '                 on pnp.produto=p.codigo) '
      #9#9'   on np.codigo = pnp.codigonota)'
      #9#9'   '
      '           join filiais f'
      #9'       on np.filial = f.codigo)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      #9'   and f.regimetributario <> 1  /* regime normal */'
      #9'   and ti.valor in ('#39'00'#39','#39'20'#39')'
      ''
      '      )'
      ''
      ''
      '      union all'
      ''
      '      ('
      
        '         /* CONTRATOS CANCELADOS SEM CONTRATOS DEVOLVIDOS, TOTAL' +
        'MENTE CANCELADOS SEM PARCELAS PAGAS */'
      '          select'
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '      cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '      ct.faturamento as data,'
      '      ct.cliente,'
      '      ct.tipocliente,'
      '      ct.nome as nomecliente,'
      '      '
      ''
      ''
      '            (((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      
        '            ) * Selecionar_Aliquotaicms(f.estado, ct.estado, ct.' +
        'pessoatipo, p.codigo)/100 ) as  ValorBrutodoProduto'
      ''
      '            /*'
      ''
      '       VALOR BRUTO'
      '      (((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '        (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)' +
        '-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                     coalesce((select  sum(sc.qu' +
        'antidade*coalesce(sc.valorservico,0))'
      '          from servicoscontratos sc'
      '          where sc.contrato = ct.numero),0)),0),1))'
      '        )) +'
      ''
      '       ACRESCIMO'
      ''
      
        '       (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precove' +
        'nda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '        DESCONTO'
      
        '         ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)' +
        ')  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1)))) * ' +
        '(1-coalesce(c.percreducaobase,0)/100)) * Selecionar_Aliquotaicms' +
        '(f.estado, ct.estado, ct.pessoatipo, p.codigo)/100)'
      ''
      '      as ValorBrutodoProduto'
      '      */'
      #9'  '
      #9'  '
      '      from (select distinct ct.numero, p.datapagto'
      '            from contratos ct, parcelas p'
      '            where ct.numero=p.contrato '
      '         and ct.situacao='#39'C'#39' '
      '         and not exists (select p2.numero'
      '                             from parcelas p2'
      '                             where p2.contrato = ct.numero '
      '                   and p2.tipopagto<>'#39'E'#39') '
      '         and p.datapagto between :datainicial and :datafinal '
      '         and not exists (select cd.contrato'
      '                             from contratosdevolvidos cd'
      
        '                             where cd.contrato = ct.numero /*and' +
        ' cd.tipo='#39'D'#39'*/)'
      
        '             and case when ct.os then ct.tipoequipamento in (1,2' +
        ') and not (coalesce(ct.os_garantia,false) and ct.os_garantia_sta' +
        'tus='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '           ) as cancelados, ((contratos ct '
      '                             join (produtoscontratos pc'
      '                                   join (produtos p'
      
        '                                         join ((((caracteristica' +
        's c'
      '                                                 join classes cl'
      
        '                                                 on c.classe = c' +
        'l.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      '                                                 join grupos g'
      
        '                                                 on c.grupo = g.' +
        'codigo)'
      ''
      
        '                                                join tiposprodut' +
        'o tp'
      
        '                                                on c.tipoproduto' +
        ' = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9#9
      #9#9#9#9#9#9#9#9#9#9#9#9'join tributosicms ti'
      #9#9#9#9#9#9#9'                    on c.incidencia = ti.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                         on p.caracteristica = c' +
        '.codigo)'
      '                                   on pc.produto=p.codigo)'
      '                             on pc.contrato = ct.numero)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' join filiais f'
      #9#9#9#9#9'         on ct.filialvenda = f.codigo)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' '
      '      where cancelados.numero = ct.numero'
      #9#9'and f.regimetributario <> 1  /* regime normal */'
      #9#9'and ti.valor in ('#39'00'#39','#39'20'#39')'
      ''
      ''
      '      )'
      ''
      #9') as impostos'
      '   group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo,'
      '            grupo,'
      '            descricaoclasse,'
      '            classe,'
      ''
      '            impostos.documento,'
      '            impostos.data,'
      '            impostos.cliente,'
      '            impostos.tipocliente,'
      '            impostos.nomecliente'
      ''
      ''
      '   )'
      '   '
      '   union all'
      '   '
      '   ('
      '   '
      '   '
      '    /* IMPOSTOS - PIS - REGIME NORMAL */'
      #9
      '     select impostos.tipoproduto,'
      
        '            cast('#39'IMPOSTOS - PIS - '#39' as varchar)||cast(impostos.' +
        'descricaotipoproduto as varchar) as descricaotipoproduto,'
      '            impostos.grupo,'
      '            impostos.descricaogrupo,'
      '            impostos.classe,'
      '            impostos.descricaoclasse,'
      ''
      '            impostos.documento,'
      '            impostos.data,'
      '            impostos.cliente,'
      '            impostos.tipocliente,'
      '            impostos.nomecliente,       '
      '            '
      
        '            sum(impostos.ValorBrutodoProduto) as ValorBrutodoPro' +
        'duto '
      #9'from'#9#9
      #9
      #9'('
      #9
      '      ('
      
        '            /* VENDAS COM CONTRATO BRUTO + ACRESIMCO - DESCONTO ' +
        '*/'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '        cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '        ct.faturamento as data,'
      '        ct.cliente,'
      '        ct.tipocliente,'
      '        ct.nome as nomecliente,       '
      '      '
      ''
      '           -'
      '          (((pc.quantidade*pc.precovenda) +'
      ''
      '                    coalesce(pc.frete,0) +'
      '                   coalesce(pc.seguro,0) +'
      '                coalesce(pc.acrescimo,0) -'
      '            coalesce(pc.descontogeral,0)'
      ''
      
        '          ) * coalesce(c.aliquotapis,0)/100) as  ValorBrutodoPro' +
        'duto'
      ''
      '          /*'
      ''
      '      -'
      '       VALOR BRUTO'
      '      ((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1)))) +'
      ''
      '       ACRESCIMO'
      
        '        (((ValorPrazo-ValorVista)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      
        '        ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1)))) * ' +
        'coalesce(c.aliquotapis,0)/100)'
      ''
      '        as  ValorBrutodoProduto'
      '        */'
      ''
      ''
      '       from ((contratos ct'
      '             join (produtoscontratos pc'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9' '
      '                         on p.caracteristica=c.codigo)'
      '                   on pc.produto=p.codigo)'
      '             on ct.numero = pc.contrato)'
      #9#9#9' '
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = ct.filialvenda)'
      ''
      '       where not pc.brinde'
      
        '         and ct.faturamento between(:datainicial) and (:datafina' +
        'l)'
      '         and (coalesce(ct.valorvista,0)<>0)'
      '         and ct.origem is null'
      '         and f.regimetributario <> 1  /* regime normal */'
      #9#9' and c.piscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      #9#9' and coalesce(c.aliquotapis,0)<>0'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      '        /* VENDAS SEM CONTRATO */'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      #9#9
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '      case when n.dadofiscal is not null then'
      '        cast('#39'NF '#39'||n.numero||'#39' S'#233'rie '#39'||n.serie as varchar(30))'
      '      else'
      
        '        cast('#39'CF '#39'||cp.numero||'#39' Mq. '#39'||cp.maquina||'#39' Int.'#39'||cp.' +
        'intervensao as varchar(30))'
      '      end as documento,'
      '      df.data,'
      '      df.cliente,'
      '      df.tipocliente,'
      '      df.nome as nomecliente,'
      ''
      ''
      #9#9'-'
      '       (((pdf.quantidade * pdf.precovenda)'
      '         - coalesce(pdf.valordescontoitem,0)'
      '         - coalesce(pdf.desconto,0)'
      '         + coalesce(pdf.acrescimo,0)'
      '         + coalesce(pdf.frete,0)'
      '         + coalesce(pdf.seguro,0)'
      '         + coalesce(pdf.valoripi,0)'
      
        '         + coalesce(pdf.despesasacessorias,0)) * coalesce(c.aliq' +
        'uotapis,0)/100) as ValorBrutodoProduto'
      #9#9
      #9#9#9#9#9#9
      '/*'
      '       -- VALOR BRUTO '
      '      ((pdf.quantidade*pdf.precovenda) +'
      
        '        (((coalesce(df.valorfrete,0)+coalesce(df.seguro,0))*(pdf' +
        '.quantidade*pdf.precovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      '          where sdf.dadofiscal = df.numero),0)),0),1)))) +'
      #9#9'  '
      '       -- ACRESCIMO '
      
        '        (((df.Valortotal-df.ValorVista)*(pdf.quantidade*pdf.prec' +
        'ovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      
        '                  where sdf.dadofiscal = df.numero),0)),0),1))) ' +
        ' -'
      #9#9#9#9'  '
      '       -- DESCONTO '#9'   '
      
        '      ((coalesce(df.desconto,0)*(pdf.quantidade*pdf.precovenda))' +
        '  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      #9#9#9#9
      '       as ValorBrutodoProduto'
      '*/'#9'   '
      ''
      #9'   '
      ''
      '       from ((dadosfiscais df'
      '               join (produtosdadosfiscais pdf'
      '                     join (produtos p'
      '                           join (((caracteristicas c'
      '                                   join classes cl'
      '                                   on c.classe=cl.codigo)'
      ''
      '                                   join grupos g'
      '                                   on c.grupo = g.codigo)'
      ''
      '                                   join tiposproduto tp'
      '                                   on c.tipoproduto = tp.codigo)'
      ''
      '                           on p.caracteristica=c.codigo)'
      '                    on pdf.produto=p.codigo) '
      #9#9#9'   on df.numero = pdf.dadofiscal)'
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = df.filialvenda)'
      '             '
      '             left join notas n on df.numero = n.dadofiscal'
      '             left join cupons cp on df.numero = cp.dadofiscal'
      '             '
      #9#9#9'   '
      #9#9#9'   '
      '       Where (df.data between (:datainicial) and (:datafinal))'
      '          and df.contrato is null'
      '          and df.situacao='#39'N'#39
      
        '          and ((eHNotaFiscalSaidaVenda(pdf.codigofiscal) and c.p' +
        'iscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')) or /* vendas */'
      
        #9#9'       (eHNotaFiscalSaidaDevolucao(pdf.codigofiscal) and c.pis' +
        'cst in ('#39'49'#39')))    /* devolu'#231#245'es de compras, conforme regra do s' +
        'ped */'
      '          and not coalesce(df.notavinculada,false)'
      '          and f.regimetributario <> 1  /* regime normal */'
      #9#9'  '
      ''
      '     )'
      ''
      '       union all'
      ''
      '     ('
      '         /* DEVOLUCOES COM CONTRATO */'
      ''
      '          select'
      ''
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '          cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '          ct.faturamento as data,'
      '          ct.cliente,'
      '          ct.tipocliente,'
      '          ct.nome as nomecliente,          '
      '      '
      #9#9
      '           '
      '      /* VALOR BRUTO */'
      '      (((cd.valorvista + cd.desconto) +'
      '      /* ACRESCIMO*/'
      
        '       (cd.ValorPrazo-cd.ValorVista)) * coalesce(c.aliquotapis,0' +
        ')/100) as ValorBrutodoproduto'
      ''
      '          from ((contratosdevolvidos cd'
      '                 join (contratos ct'
      #9#9#9#9'       join filiais f'
      #9#9#9#9#9'   on ct.filialvenda = f.codigo)'
      '                 on cd.contrato=ct.numero)'
      ''
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      '                       on p.caracteristica=c.codigo)'
      '                 on cd.produto=p.codigo)'
      ''
      
        '          where cd.devolucao between(:DataInicial) and (:DataFin' +
        'al)'
      '            /* and cd.tipo = '#39'D'#39' */'
      
        '            and case when ct.os then ct.tipoequipamento in (1,2)' +
        ' and not (coalesce(ct.os_garantia,false) and ct.os_garantia_stat' +
        'us='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '            and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturad' +
        'as as outras entram pelas notas fiscais devido a cr'#233'ditos de tro' +
        'ca */'
      '            and f.regimetributario <> 1  /* regime normal */'
      #9#9#9'and c.piscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      #9'  '
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '        cast('#39'NF '#39'||np.numero as varchar(30)) as documento,'
      '        np.data,'
      '        np.fornecedor as cliente,'
      '        np.tipofornecedor as tipocliente,'
      '        np.nome as nomecliente,'
      '      '
      #9'  '
      #9'  '
      '      ((pnp.quantidade * pnp.precounitario)'
      '      - coalesce(pnp.valordescontoitem,0)'
      '      - coalesce(pnp.desconto,0)'
      '      + coalesce(pnp.acrescimo,0)'
      '      + coalesce(pnp.frete,0)'
      '      + coalesce(pnp.seguro,0)'
      '      + coalesce(pnp.valoripi,0)'
      
        '      + coalesce(pnp.despesasacessorias,0)) * coalesce(c.aliquot' +
        'apis,0)/100'
      #9'   as ValorBrutodoProduto'
      #9'   '
      ''
      '     from ((notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      '                       on p.caracteristica=c.codigo)'
      '                 on pnp.produto=p.codigo) '
      #9#9'   on np.codigo = pnp.codigonota)'
      #9#9'   '
      '           join filiais f'
      #9'       on np.filial = f.codigo)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      #9'   and f.regimetributario <> 1  /* regime normal */'
      
        #9'   and c.piscst in ('#39'50'#39','#39'51'#39','#39'52'#39','#39'53'#39','#39'54'#39','#39'55'#39','#39'56'#39','#39'60'#39','#39'61' +
        #39','#39'62'#39','#39'63'#39','#39'64'#39','#39'65'#39','#39'66'#39')'
      ''
      '      )'
      ''
      ''
      '      union all'
      ''
      '      ('
      
        '         /* CONTRATOS CANCELADOS SEM CONTRATOS DEVOLVIDOS, TOTAL' +
        'MENTE CANCELADOS SEM PARCELAS PAGAS */'
      '          select'
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '      cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '      ct.faturamento as data,'
      '      ct.cliente,'
      '      ct.tipocliente,'
      '      ct.nome as nomecliente,'
      '      '
      ''
      '          (((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      
        '            ) * coalesce(c.aliquotapis,0)/100) as  ValorBrutodoP' +
        'roduto'
      ''
      '            /*'
      ''
      '       VALOR BRUTO'
      '      ((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '        (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)' +
        '-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                     coalesce((select  sum(sc.qu' +
        'antidade*coalesce(sc.valorservico,0))'
      '          from servicoscontratos sc'
      '          where sc.contrato = ct.numero),0)),0),1))'
      '        )) +'
      ''
      '       ACRESCIMO'
      ''
      
        '       (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precove' +
        'nda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      
        '         ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)' +
        ')  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1)))) * ' +
        'coalesce(c.aliquotapis,0)/100) as ValorBrutodoProduto'
      ''
      '                  */'
      ''
      ''
      '      from (select distinct ct.numero, p.datapagto'
      '            from contratos ct, parcelas p'
      '            where ct.numero=p.contrato'
      '         and ct.situacao='#39'C'#39
      '         and not exists (select p2.numero'
      '                             from parcelas p2'
      '                             where p2.contrato = ct.numero '
      '                   and p2.tipopagto<>'#39'E'#39') '
      '         and p.datapagto between :datainicial and :datafinal '
      '         and not exists (select cd.contrato'
      '                             from contratosdevolvidos cd'
      
        '                             where cd.contrato = ct.numero /*and' +
        ' cd.tipo='#39'D'#39'*/)'
      
        '             and case when ct.os then ct.tipoequipamento in (1,2' +
        ') and not (coalesce(ct.os_garantia,false) and ct.os_garantia_sta' +
        'tus='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '           ) as cancelados, ((contratos ct '
      '                             join (produtoscontratos pc'
      '                                   join (produtos p'
      
        '                                         join (((caracteristicas' +
        ' c'
      '                                                 join classes cl'
      
        '                                                 on c.classe = c' +
        'l.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      '                                                 join grupos g'
      
        '                                                 on c.grupo = g.' +
        'codigo)'
      ''
      
        '                                                join tiposprodut' +
        'o tp'
      
        '                                                on c.tipoproduto' +
        ' = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                         on p.caracteristica = c' +
        '.codigo)'
      '                                   on pc.produto=p.codigo)'
      '                             on pc.contrato = ct.numero)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' join filiais f'
      #9#9#9#9#9'         on ct.filialvenda = f.codigo)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' '
      '      where cancelados.numero = ct.numero'
      #9#9'and f.regimetributario <> 1  /* regime normal */'
      #9#9'and c.piscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      ''
      ''
      '      )'
      ''
      #9') as impostos'
      #9'       group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo,'
      '            grupo,'
      '            descricaoclasse,'
      '            classe,'
      ''
      '            impostos.data,'
      '            impostos.documento,'
      '            impostos.cliente,'
      '            impostos.tipocliente,'
      '            impostos.nomecliente'
      '            '
      ''
      '   )'
      '   '
      '   union all'
      '   '
      '   ('
      '   '
      '   '
      '    /* IMPOSTOS - COFINS - REGIME NORMAL */'
      #9
      '     select impostos.tipoproduto,'
      
        '            cast('#39'IMPOSTOS - COFINS - '#39' as varchar)||cast(impost' +
        'os.descricaotipoproduto as varchar) as descricaotipoproduto,'
      '            impostos.grupo,'
      '            impostos.descricaogrupo,'
      '            impostos.classe,'
      '            impostos.descricaoclasse,'
      ''
      '            impostos.documento,'
      '            impostos.data,'
      '            impostos.cliente,'
      '            impostos.tipocliente,'
      '            impostos.nomecliente,       '
      '            '
      
        '            sum(impostos.ValorBrutodoProduto) as ValorBrutodoPro' +
        'duto '
      #9'from'#9#9
      #9
      #9'('
      ''
      '      ('
      
        '            /* VENDAS COM CONTRATO BRUTO + ACRESIMCO - DESCONTO ' +
        '*/'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      ''
      
        #9'case when :AgruparGrupo then c.grupo     else cast(null as varc' +
        'har(4)) end as grupo,'
      
        #9'case when :AgruparGrupo then g.descricao else cast(null as varc' +
        'har(30)) end as descricaogrupo,'
      
        #9'case when :AGruparClasse then c.classe    else cast(null as var' +
        'char(2)) end as classe,'
      
        #9'case when :AGruparClasse then cl.descricao else cast(null as va' +
        'rchar(30)) end as descricaoclasse,'
      '    '
      '        cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '        ct.faturamento as data,'
      '        ct.cliente,'
      '        ct.tipocliente,'
      '        ct.nome as nomecliente,       '
      '    '
      ''
      '          -'
      '          (((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      
        '            ) * coalesce(c.aliquotacofins,0)/100) as  ValorBruto' +
        'doProduto'
      ''
      '        /*'
      ''
      '      -'
      '       VALOR BRUTO'
      '      ((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1)))) +'
      ''
      '       ACRESCIMO'
      
        '        (((ValorPrazo-ValorVista)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      
        '        ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda))' +
        '  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1)))) * ' +
        'coalesce(c.aliquotacofins,0)/100)'
      ''
      '        as  ValorBrutodoProduto'
      ''
      '        */'
      ''
      ''
      '       from ((contratos ct'
      '             join (produtoscontratos pc'
      '                   join (produtos p'
      '                         join (((caracteristicas c'
      '                                 join classes cl'
      '                                 on c.classe=cl.codigo)'
      ''
      '                                 join grupos g'
      '                                 on c.grupo = g.codigo)'
      ''
      '                                 join tiposproduto tp'
      '                                 on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9#9' '
      '                         on p.caracteristica=c.codigo)'
      '                   on pc.produto=p.codigo)'
      '             on ct.numero = pc.contrato)'
      #9#9#9' '
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = ct.filialvenda)'
      ''
      '       where not pc.brinde'
      
        '         and ct.faturamento between(:datainicial) and (:datafina' +
        'l)'
      '         and (coalesce(ct.valorvista,0)<>0)'
      '         and ct.origem is null'
      '         and f.regimetributario <> 1  /* regime normal */'
      #9#9' and c.cofinscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      #9#9' and coalesce(c.aliquotacofins,0)<>0'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      '        /* VENDAS SEM CONTRATO */'
      '        select'
      '        c.tipoproduto,'
      '        tp.descricao as descricaotipoproduto,'
      #9#9
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '      case when n.dadofiscal is not null then'
      '        cast('#39'NF '#39'||n.numero||'#39' S'#233'rie '#39'||n.serie as varchar(30))'
      '      else'
      
        '        cast('#39'CF '#39'||cp.numero||'#39' Mq. '#39'||cp.maquina||'#39' Int.'#39'||cp.' +
        'intervensao as varchar(30))'
      '      end as documento,'
      '      df.data,'
      '      df.cliente,'
      '      df.tipocliente,'
      '      df.nome as nomecliente,'
      '      '
      ''
      #9#9'-'
      '       (((pdf.quantidade * pdf.precovenda)'
      '         - coalesce(pdf.valordescontoitem,0)'
      '         - coalesce(pdf.desconto,0)'
      '         + coalesce(pdf.acrescimo,0)'
      '         + coalesce(pdf.frete,0)'
      '         + coalesce(pdf.seguro,0)'
      '         + coalesce(pdf.valoripi,0)'
      
        '         + coalesce(pdf.despesasacessorias,0)) * coalesce(c.aliq' +
        'uotacofins,0)/100) as ValorBrutodoProduto'
      #9#9
      #9#9#9#9#9#9
      '/*'
      '       -- VALOR BRUTO '
      '      ((pdf.quantidade*pdf.precovenda) +'
      
        '        (((coalesce(df.valorfrete,0)+coalesce(df.seguro,0))*(pdf' +
        '.quantidade*pdf.precovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      '          where sdf.dadofiscal = df.numero),0)),0),1)))) +'
      #9#9'  '
      '       -- ACRESCIMO '
      
        '        (((df.Valortotal-df.ValorVista)*(pdf.quantidade*pdf.prec' +
        'ovenda))  /'
      
        '         (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0' +
        ')-coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '                 coalesce((select  sum(sdf.quantidade*coalesce(s' +
        'df.valorservico,0))'
      '                  from servicosdadosfiscais sdf'
      
        '                  where sdf.dadofiscal = df.numero),0)),0),1))) ' +
        ' -'
      #9#9#9#9'  '
      '       -- DESCONTO '#9'   '
      
        '      ((coalesce(df.desconto,0)*(pdf.quantidade*pdf.precovenda))' +
        '  /'
      
        '       (COALESCE(NULLIF(((df.valorvista+coalesce(df.desconto,0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)) -'
      
        '               coalesce((select  sum(sdf.quantidade*coalesce(sdf' +
        '.valorservico,0))'
      '                from servicosdadosfiscais sdf'
      '                where sdf.dadofiscal = df.numero),0)),0),1)))'
      #9#9#9#9
      '       as ValorBrutodoProduto'
      '*/'#9'   '
      ''
      #9'   '
      ''
      '       from ((dadosfiscais df'
      '               join (produtosdadosfiscais pdf'
      '                     join (produtos p'
      '                           join (((caracteristicas c'
      '                                   join classes cl'
      '                                   on c.classe=cl.codigo)'
      ''
      '                                   join grupos g'
      '                                   on c.grupo = g.codigo)'
      ''
      '                                   join tiposproduto tp'
      '                                   on c.tipoproduto = tp.codigo)'
      ''
      '                           on p.caracteristica=c.codigo)'
      '                    on pdf.produto=p.codigo) '
      #9#9#9'   on df.numero = pdf.dadofiscal)'
      #9#9#9' join filiais f '
      #9#9#9' on f.codigo = df.filialvenda)'
      '             '
      '             left join notas n on df.numero = n.dadofiscal'
      '             left join cupons cp on df.numero = cp.dadofiscal'
      '             '
      #9#9#9'   '
      #9#9#9'   '
      '       Where (df.data between (:datainicial) and (:datafinal))'
      '          and df.contrato is null'
      '          and df.situacao='#39'N'#39
      
        '          and ((eHNotaFiscalSaidaVenda(pdf.codigofiscal) and c.c' +
        'ofinscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')) or /* vendas */'
      
        #9#9'       (eHNotaFiscalSaidaDevolucao(pdf.codigofiscal) and c.cof' +
        'inscst in ('#39'49'#39')))    /* devolu'#231#245'es de compras, conforme regra d' +
        'o sped */'
      '          and not coalesce(df.notavinculada,false)'
      '          and f.regimetributario <> 1  /* regime normal */'
      #9#9'  '
      ''
      '     )'
      ''
      '       union all'
      ''
      '     ('
      '         /* DEVOLUCOES COM CONTRATO */'
      ''
      '          select'
      ''
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '          cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '          ct.faturamento as data,'
      '          ct.cliente,'
      '          ct.tipocliente,'
      '          ct.nome as nomecliente,          '
      '      '
      #9#9
      '           '
      '      /* VALOR BRUTO */'
      '      (((cd.valorvista + cd.desconto) +'
      '      /* ACRESCIMO*/'
      
        '       (cd.ValorPrazo-cd.ValorVista)) * coalesce(c.aliquotacofin' +
        's,0)/100) as ValorBrutodoproduto'
      ''
      '          from ((contratosdevolvidos cd'
      '                 join (contratos ct'
      #9#9#9#9'       join filiais f'
      #9#9#9#9#9'   on ct.filialvenda = f.codigo)'
      '                 on cd.contrato=ct.numero)'
      ''
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      '                       on p.caracteristica=c.codigo)'
      '                 on cd.produto=p.codigo)'
      ''
      
        '          where cd.devolucao between(:DataInicial) and (:DataFin' +
        'al)'
      '            /* and cd.tipo = '#39'D'#39' */'
      
        '            and case when ct.os then ct.tipoequipamento in (1,2)' +
        ' and not (coalesce(ct.os_garantia,false) and ct.os_garantia_stat' +
        'us='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '            and cd.situacao = '#39'F'#39' /*  somente devolu'#231#245'es faturad' +
        'as as outras entram pelas notas fiscais devido a cr'#233'ditos de tro' +
        'ca */'
      '            and f.regimetributario <> 1  /* regime normal */'
      #9#9#9'and c.cofinscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      ''
      '      /* NOTAS DE ENTRADA DE DEVOLU'#199#195'O - TODAS */'
      '      select'
      '      c.tipoproduto,'
      '      tp.descricao as descricaotipoproduto,'
      #9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '        cast('#39'NF '#39'||np.numero as varchar(30)) as documento,'
      '        np.data,'
      '        np.fornecedor as cliente,'
      '        np.tipofornecedor as tipocliente,'
      '        np.nome as nomecliente,'
      '      '
      #9'  '
      #9'  '
      '      ((pnp.quantidade * pnp.precounitario)'
      '      - coalesce(pnp.valordescontoitem,0)'
      '      - coalesce(pnp.desconto,0)'
      '      + coalesce(pnp.acrescimo,0)'
      '      + coalesce(pnp.frete,0)'
      '      + coalesce(pnp.seguro,0)'
      '      + coalesce(pnp.valoripi,0)'
      
        '      + coalesce(pnp.despesasacessorias,0)) * coalesce(c.aliquot' +
        'acofins,0)/100'
      #9'   as ValorBrutodoProduto'
      #9'   '
      ''
      '     from ((notaspag np'
      '           join (produtosnotaspag pnp'
      '                 join (produtos p'
      '                       join (((caracteristicas c'
      '                               join classes cl'
      '                               on c.classe=cl.codigo)'
      ''
      '                               join grupos g'
      '                               on c.grupo = g.codigo)'
      ''
      '                               join tiposproduto tp'
      '                               on c.tipoproduto = tp.codigo)'
      #9#9#9#9#9#9#9'   '
      '                       on p.caracteristica=c.codigo)'
      '                 on pnp.produto=p.codigo) '
      #9#9'   on np.codigo = pnp.codigonota)'
      #9#9'   '
      '           join filiais f'
      #9'       on np.filial = f.codigo)'
      ''
      '     Where (np.data between (:datainicial) and (:datafinal))'
      '       and np.situacao='#39'N'#39
      '       and eHNotaFiscalEntradaDevolucao(pnp.codigofiscal)'
      #9'   and f.regimetributario <> 1  /* regime normal */'
      
        #9'   and c.cofinscst in ('#39'50'#39','#39'51'#39','#39'52'#39','#39'53'#39','#39'54'#39','#39'55'#39','#39'56'#39','#39'60'#39',' +
        #39'61'#39','#39'62'#39','#39'63'#39','#39'64'#39','#39'65'#39','#39'66'#39')'
      ''
      '      )'
      ''
      ''
      '      union all'
      ''
      '      ('
      
        '         /* CONTRATOS CANCELADOS SEM CONTRATOS DEVOLVIDOS, TOTAL' +
        'MENTE CANCELADOS SEM PARCELAS PAGAS */'
      '          select'
      '          c.tipoproduto,'
      '          tp.descricao as descricaotipoproduto,'
      #9#9'  '
      
        #9'  case when :AgruparGrupo then c.grupo     else cast(null as va' +
        'rchar(4)) end as grupo,'
      
        #9'  case when :AgruparGrupo then g.descricao else cast(null as va' +
        'rchar(30)) end as descricaogrupo,'
      
        #9'  case when :AGruparClasse then c.classe    else cast(null as v' +
        'archar(2)) end as classe,'
      
        #9'  case when :AGruparClasse then cl.descricao else cast(null as ' +
        'varchar(30)) end as descricaoclasse,'
      '      '
      '      cast('#39'CT '#39'||ct.numero as varchar(30)) as documento,'
      '      ct.faturamento as data,'
      '      ct.cliente,'
      '      ct.tipocliente,'
      '      ct.nome as nomecliente,'
      '      '
      ''
      '          (((pc.quantidade*pc.precovenda) +'
      ''
      '                      coalesce(pc.frete,0) +'
      '                     coalesce(pc.seguro,0) +'
      '                  coalesce(pc.acrescimo,0) -'
      '              coalesce(pc.descontogeral,0)'
      ''
      
        '            ) * coalesce(c.aliquotacofins,0)/100) as  ValorBruto' +
        'doProduto'
      ''
      '        /*'
      ''
      '       VALOR BRUTO'
      '      ((((pc.quantidade*pc.precovenda) +'
      
        '        (((coalesce(ct.frete,0)+coalesce(ct.seguro,0))*(pc.quant' +
        'idade*pc.precovenda))  /'
      
        '        (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0)' +
        '-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                                     coalesce((select  sum(sc.qu' +
        'antidade*coalesce(sc.valorservico,0))'
      '          from servicoscontratos sc'
      '          where sc.contrato = ct.numero),0)),0),1))'
      '        )) +'
      ''
      '       ACRESCIMO'
      ''
      
        '       (((ct.ValorPrazo-ct.ValorVista)*(pc.quantidade*pc.precove' +
        'nda))  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      '                  where sc.contrato = ct.numero),0)),0),1))) -'
      ''
      '       DESCONTO'
      
        '         ((coalesce(ct.desconto,0)*(pc.quantidade*pc.precovenda)' +
        ')  /'
      
        '         (COALESCE(NULLIF(((ct.valorvista+coalesce(ct.desconto,0' +
        ')-coalesce(ct.frete,0)-coalesce(ct.seguro,0)) -'
      
        '                 coalesce((select  sum(sc.quantidade*coalesce(sc' +
        '.valorservico,0))'
      '                  from servicoscontratos sc'
      
        '                  where sc.contrato = ct.numero),0)),0),1)))) * ' +
        'coalesce(c.aliquotacofins,0)/100) as ValorBrutodoProduto'
      '       */'
      ''
      '      from (select distinct ct.numero, p.datapagto'
      '            from contratos ct, parcelas p'
      '            where ct.numero=p.contrato'
      '         and ct.situacao='#39'C'#39
      '         and not exists (select p2.numero'
      '                             from parcelas p2'
      '                             where p2.contrato = ct.numero'
      '                   and p2.tipopagto<>'#39'E'#39')'
      '         and p.datapagto between :datainicial and :datafinal'
      '         and not exists (select cd.contrato'
      '                             from contratosdevolvidos cd'
      
        '                             where cd.contrato = ct.numero /*and' +
        ' cd.tipo='#39'D'#39'*/)'
      
        '             and case when ct.os then ct.tipoequipamento in (1,2' +
        ') and not (coalesce(ct.os_garantia,false) and ct.os_garantia_sta' +
        'tus='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '           ) as cancelados, ((contratos ct '
      '                             join (produtoscontratos pc'
      '                                   join (produtos p'
      
        '                                         join (((caracteristicas' +
        ' c'
      '                                                 join classes cl'
      
        '                                                 on c.classe = c' +
        'l.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9' '
      '                                                 join grupos g'
      
        '                                                 on c.grupo = g.' +
        'codigo)'
      ''
      
        '                                                join tiposprodut' +
        'o tp'
      
        '                                                on c.tipoproduto' +
        ' = tp.codigo)'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9' '#9#9#9#9#9#9#9#9#9#9#9' '
      
        '                                         on p.caracteristica = c' +
        '.codigo)'
      '                                   on pc.produto=p.codigo)'
      '                             on pc.contrato = ct.numero)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' join filiais f'
      #9#9#9#9#9'         on ct.filialvenda = f.codigo)'
      #9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' '
      '      where cancelados.numero = ct.numero'
      #9#9'and f.regimetributario <> 1  /* regime normal */'
      #9#9'and c.cofinscst in ('#39'01'#39','#39'02'#39','#39'03'#39','#39'05'#39')'
      ''
      ''
      '      )'
      ''
      #9') as impostos'
      ''
      #9'    group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo, grupo,'
      '            descricaoclasse, classe,'
      ''
      '            impostos.documento,'
      '            impostos.data,'
      '            impostos.cliente,'
      '            impostos.tipocliente,'
      '            impostos.nomecliente'
      ''
      ''
      ''
      ''
      '   )'
      ''
      ''
      '  ) as dev'
      '       group by tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo, grupo, descricaoclasse, classe,'
      ''
      '            dev.documento,'
      '            dev.data,'
      '            dev.cliente,'
      '            dev.tipocliente,'
      '            dev.nomecliente'
      ''
      ''
      ''
      ''
      ')'
      ''
      ') as sel'
      'where valorBrutodoProduto is not null'
      ''
      '   order by classificacao,  descricaoclassificacao,'
      '            tipoproduto,'
      '            descricaotipoproduto,'
      '            descricaogrupo, grupo,'
      '            descricaoclasse, classe,'
      ''
      '            data,'
      '            documento,'
      '            cliente,'
      '            tipocliente,'
      '            nomecliente')
    RequestLive = False
    Left = 112
    Top = 64
    ParamData = <
      item
        DataType = ftString
        Name = 'AgruparGrupo'
        ParamType = ptUnknown
        Value = 'true'
      end
      item
        DataType = ftUnknown
        Name = 'AGruparClasse'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'datainicial'
        ParamType = ptUnknown
        Value = #39'2015-01-01'#39
      end
      item
