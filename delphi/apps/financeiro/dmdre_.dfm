  object qryDespesasOperacionais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '/* qryDespesasOperacionais */'
      ''
      ';'
      'select cast(3 as integer) as classificacao,'
      
        '       cast('#39'(-) DESPESAS OPERACIONAIS'#39' as varchar(50)) as descr' +
        'icaoclassificacao,'
      
        '       documento, data, fornecedor, tipofornecedor, nomeforneced' +
        'or,          '
      
        '       evento, tipo, classificacaoevento, descricaoevento, sum(v' +
        'alor) as valor'
      ''
      'from'
      '('
      ''
      '  ('
      '  '
      
        '  select dp.documento, dp.data, dp.fornecedor, dp.tipofornecedor' +
        ', dp.nomefornecedor,'
      ''
      '         dp.evento,'
      '         e.descricao as descricaoevento,'
      '         e.tipo,'
      '         e.classificacao as classificacaoevento,'
      '         sum(dp.valor) as valor'
      ''
      '  from'
      '  ('
      
        '  select dp.documento, dp.data, dp.fornecedor, dp.tipofornecedor' +
        ', dp.nomefornecedor,   '
      
        '         cast(unnest(pg_catalog.string_to_array(codigos_eventos,' +
        #39','#39')) as integer) as evento,'
      '         valor'
      '  from'
      '  ('
      ''
      
        '     select dp.documento, dp.data, dp.fornecedor, dp.tipofornece' +
        'dor, dp.nomefornecedor, '
      ''
      ''
      '         (select string_agg(CAST(es.codigo as varchar), '#39','#39')'
      '          from eventos es'
      '          where /*es.tipomovimentacao='#39'S'#39
      
        '            and */ position(es.classificacao in e.classificacao)' +
        '=1'
      
        '            and case when es.tipo = '#39'A'#39' then es.codigo = dp.even' +
        'to else true  end'
      '          ) as codigos_eventos,'
      ''
      '         case when e.tipomovimentacao='#39'S'#39' then'
      ''
      '           - abs(dp.valor) else'
      ''
      '             abs(dp.valor)'
      ''
      '         end as valor'
      ''
      '     from'
      ''
      '      ('
      ''
      '        select distinct'
      ''
      '            '
      '            case when :Regime = '#39'Compet'#234'ncia'#39' and'
      '                       not coalesce(dp.regimedecaixa,false) then'
      
        '               cast('#39'DP '#39'||dp.numero||coalesce(case when dp.comp' +
        'lemento is not null then '#39' COMPL. '#39'||dp.complemento end,'#39#39') as v' +
        'archar(50))'
      '            else'
      
        '               cast('#39'DP '#39'||dp.numero||'#39' N'#176' '#39'||d.numero||coalesce' +
        '(case when dp.complemento is not null then '#39' COMPL. '#39'||dp.comple' +
        'mento end,'#39#39') as varchar(50))'
      '            end as documento,'
      ''
      ''
      '            case when :Regime = '#39'Caixa'#39' then'
      '                        d.datapagto'
      '                 when :Regime = '#39'Compet'#234'ncia'#39' then'
      
        '                      case when coalesce(dp.regimedecaixa,false)' +
        ' then'
      '                        d.datavencto'
      '                      else'
      '                        dp.datalancto'
      '                      end'
      '            end as data,'
      ''
      ''
      '            dp.fornecedor,'
      '            dp.tipofornecedor,'
      '            vf.nome  as nomefornecedor,'
      ''
      '            case when :Regime = '#39'Caixa'#39' then'
      '                      d.valorvencto'
      ''
      '                 when :Regime = '#39'Compet'#234'ncia'#39' then'
      ''
      
        '                    case when coalesce(dp.regimedecaixa,false) t' +
        'hen'
      '                      d.valorvencto'
      '                    else'
      '                      coalesce(dp.valor,0) -'
      '                      coalesce(dp.IRRetido,0) -'
      '                      coalesce(dp.INSSRetido,0) -'
      '                      coalesce(dp.ISSRetido,0) -'
      '                      coalesce(dp.PISRetido,0) -'
      '                      coalesce(dp.COFINSRetido,0) -'
      '                      coalesce(dp.CSLLRetido,0) -'
      '                      coalesce(dp.PISCOFINSCSLLRetido,0)'
      '                    end'
      ''
      '                 else d.valorvencto'
      '            end as valor,'
      ''
      '            case when d.datapagto is not null then'
      '               coalesce(d.evento,dp.evento) else'
      '              dp.evento end as evento'
      ''
      '        from documentospag dp'
      '             left join vfornecedores vf'
      '             on dp.fornecedor = vf.codigo'
      '             and dp.tipofornecedor = vf.tipo'
      ''
      '             join duplicatas d'
      '             on dp.numero = d.documentopag'
      ''
      '        where case when :Regime = '#39'Caixa'#39' then'
      
        '                        d.datapagto between :DataInicial and :Da' +
        'taFinal'
      '                   when :Regime = '#39'Compet'#234'ncia'#39' then'
      
        '                      case when coalesce(dp.regimedecaixa,false)' +
        ' then'
      
        '                        d.datavencto between :DataInicial and :D' +
        'ataFinal else'
      
        '                        dp.datalancto between :DataInicial and :' +
        'DataFinal end'
      
        '                   else d.datavencto between :DataInicial and :D' +
        'ataFinal end'
      ''
      ''
      '          /*and e.tipomovimentacao ='#39'S'#39'*/'
      '          and not coalesce(dp.previsao,false)'
      ''
      '/*          and dp.numero in (6641, 7253, 4997)*/'
      ''
      '      ) as dp join eventos e'
      '              on dp.evento = e.codigo'
      '        where coalesce(e.incluirnadre,false)'
      ''
      ''
      ''
      ''
      '  ) as dp'
      '  ) as dp'
      '    join eventos e on dp.evento = e.codigo'
      ''
      
        '  group by dp.documento, dp.data, dp.fornecedor, dp.tipoforneced' +
        'or, dp.nomefornecedor,  dp.evento,  e.codigo, e.descricao, e.tip' +
        'o, e.classificacao'
      
        '  order by e.classificacao, e.tipo, e.codigo, e.descricao, dp.da' +
        'ta, dp.documento'
      '  )'
      ''
      '  union all'
      ''
      '  ('
      '  '
      '         '
      
        '   select mb.documento, mb.data, mb.fornecedor, mb.tipofornecedo' +
        'r, mb.nomefornecedor,   '
      '  '
      '         mb.evento,'
      '         e.descricao as descricaoevento,'
      '         e.tipo,'
      '         e.classificacao as classificacaoevento,'
      '         sum(mb.valor) as valor'
      '         '
      ''
      '  from'
      '  (                  '
      
        '  select mb.documento, mb.data, mb.fornecedor, mb.tipofornecedor' +
        ', mb.nomefornecedor,'
      
        '         cast(unnest(pg_catalog.string_to_array(codigos_eventos,' +
        #39','#39')) as integer) as evento,'
      '         valor'
      ''
      '  from'
      '  ('
      ''
      '   select'
      ''
      
        '         cast('#39'CTA '#39'||mb.conta||'#39' Seq '#39'||mb.sequencia||'#39' - '#39'||mb' +
        'e.sequenciaevento||case when mb.documento is not null then mb.do' +
        'cumento else '#39#39' end as varchar(50)) as documento,'
      ''
      '         mbe.data,'
      '         cast(null as integer) as fornecedor,'
      '         cast(null as char(1)) as tipofornecedor,'
      '         substring(mbe.observacoes,1,60) as nomefornecedor,'
      ''
      ''
      '         (select string_agg(CAST(es.codigo as varchar), '#39','#39')'
      '          from eventos es'
      '          where /*es.tipomovimentacao='#39'S'#39
      
        '            and */ position(es.classificacao in e.classificacao)' +
        '=1'
      
        '            and case when es.tipo = '#39'A'#39' then es.codigo = mbe.eve' +
        'nto else true  end'
      '          ) as codigos_eventos,'
      ''
      
        '         case when e.tipomovimentacao='#39'S'#39' then  - abs(mbe.valor)' +
        ' else abs(mbe.valor) end as valor'
      ''
      ''
      '  from movtosbancos mb'
      '       join movtosbancoseventos mbe'
      '            join eventos e on mbe.evento = e.codigo'
      '        on mb.conta = mbe.conta'
      '        and mb.data = mbe.data'
      '        and mb.sequencia = mbe.sequencia'
      '  where mbe.data between :DataInicial and :DataFinal'
      '    and mb.origemlancto = '#39'B'#39
      '    and coalesce(e.incluirnadre,false)'
      '    /* and e.tipomovimentacao = '#39'S'#39' */'
      ''
      '  order by mbe.evento, e.descricao'
      ''
      '  ) as mb'
      '  ) as mb'
      '    join eventos e on mb.evento = e.codigo'
      ''
      
        '  group by mb.documento, mb.data, mb.fornecedor, mb.tipoforneced' +
        'or, mb.nomefornecedor,  mb.evento,  e.codigo, e.descricao, e.tip' +
        'o, e.classificacao'
      
        '  order by e.classificacao, e.tipo, e.codigo, e.descricao, mb.da' +
        'ta, mb.documento'
      ''
      ''
      '  )'
      ') as despesasoperacionais'
      
        'group by classificacaoevento, tipo, descricaoevento, evento, doc' +
        'umento, data, fornecedor, tipofornecedor, nomefornecedor'
      
        'order by classificacaoevento, tipo, descricaoevento, evento, dat' +
        'a, documento'
      ''
      ''
      '')
    RequestLive = False
    Left = 120
    Top = 256
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'Regime'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'datainicial'
        ParamType = ptUnknown
        Value = #39'2015-01-01'#39
      end
      item
        DataType = ftString
        Name = 'datafinal'
        ParamType = ptUnknown
        Value = #39'2015-01-31'#39
      end>
  end
  object frxDBDespesasOperacionais: TfrxDBDataset
    UserName = 'frxDBDespesasOperacionais'
    CloseDataSource = False
    FieldAliases.Strings = (
      'classificacao=classificacao'
      'descricaoclassificacao=descricaoclassificacao'
      'documento=documento'
      'data=data'
      'fornecedor=fornecedor'
      'tipofornecedor=tipofornecedor'
      'nomefornecedor=nomefornecedor'
      'evento=evento'
      'tipo=tipo'
      'classificacaoevento=classificacaoevento'
      'descricaoevento=descricaoevento'
      'valor=valor')
    OpenDataSource = False
    DataSet = qryDespesasOperacionais
    Left = 512
    Top = 192
  end
  object qryReceitasDespesasFinanceiras: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ''
      '/* qryReceitasDespesasFinanceiras */'
      ''
      ';'
      'select classificacao, descricaoclassificacao, DescricaoEvento,'
      '       documento, data, cliente, tipocliente, nomecliente,'
      '       sum(valor) as valor'
      'from'
      '('
      ''
      '  ('
      '    select cast(5 as integer) as classificacao,'
      
        '           cast('#39'Receitas Financeiras'#39' as varchar(50)) as descri' +
        'caoclassificacao,'
      
        '           cast('#39'Juros Recebidos'#39' as varchar(50)) as DescricaoEv' +
        'ento,'
      '           documento, data, cliente, tipocliente, nomecliente,'
      '           sum(valor) as valor'
      '    from'
      '    ('
      ''
      
        '    select cast('#39'CT '#39'||ct.numero||'#39' Parcela '#39'||p.numero as varch' +
        'ar(30)) as documento,'
      '           p.datapagto as  data,'
      '           ct.cliente,'
      '           ct.tipocliente,'
      '           ct.nome as nomecliente,'
      ''
      '           p.valorpagto - p.valorvencto as valor'
      ''
      '    from parcelas p join contratos ct on p.contrato = ct.numero'
      '    where p.datapagto between :datainicial and :datafinal'
      '      and (p.valorpagto - p.valorvencto) > 0'
      ''
      '    ) as jurosrecebidos'
      '    group by documento, data, cliente, tipocliente, nomecliente'
      ''
      '  )'
      ''
      '  union all'
      ''
      '  ('
      '    select cast(5 as integer) as classificacao,'
      
        '           cast('#39'Receitas Financeiras'#39' as varchar(50)) as descri' +
        'caoclassificacao,'
      
        '           cast('#39'Descontos Recebidos'#39' as varchar(50)) as Descric' +
        'aoEvento,'
      '           documento, data, cliente, tipocliente, nomecliente,'
      '           sum(valor) as valor'
      '    from'
      '    ('
      ''
      '    select'
      ''
      
        '            cast('#39'DP '#39'||dp.numero||'#39' N'#176' '#39'||d.numero||coalesce(ca' +
        'se when dp.complemento is not null then '#39' COMPL. '#39'||dp.complemen' +
        'to end,'#39#39') as varchar(50)) as documento,'
      '            d.datapagto as data,'
      '            dp.fornecedor as cliente,'
      '            dp.tipofornecedor as tipocliente,'
      '            vf.nome as nomecliente,'
      ''
      '            d.valorvencto - d.valorpagto  as valor'
      ''
      '    from documentospag dp'
      '         left join vfornecedores vf'
      '         on dp.fornecedor = vf.codigo'
      '         and dp.tipofornecedor = vf.tipo'
      ''
      '         join duplicatas d'
      '         on dp.numero = d.documentopag'
      ''
      '    where d.datapagto between :datainicial and :datafinal'
      '      and (d.valorvencto - d.valorpagto) > 0'
      '    ) as jurospagos'
      '    group by documento, data, cliente, tipocliente, nomecliente'
      ''
      '  )'
      ''
      ''
      '  union all'
      ''
      '  ('
      '    select cast(6 as integer) as classificacao,'
      
        '           cast('#39'Despesas Financeiras'#39' as varchar(50)) as descri' +
        'caoclassificacao,'
      
        '           cast('#39'Descontos Concedidos'#39' as varchar(50)) as Descri' +
        'caoEvento,'
      '           documento, data, cliente, tipocliente, nomecliente,'
      '           sum(valor) as valor'
      '    from'
      '    ('
      ''
      
        '    select cast('#39'CT '#39'||ct.numero||'#39' Parcela '#39'||p.numero as varch' +
        'ar(30)) as documento,'
      '           p.datapagto as data,'
      '           ct.cliente,'
      '           ct.tipocliente,'
      '           ct.nome as nomecliente,'
      '           p.valorpagto - p.valorvencto as valor'
      ''
      '    from parcelas p join contratos ct on p.contrato = ct.numero'
      '    where p.datapagto between :datainicial and :datafinal'
      '      and (p.valorpagto - p.valorvencto) < 0'
      '    ) as descontosconcedidos'
      '    group by documento, data, cliente, tipocliente, nomecliente'
      '  )'
      ''
      '  union all'
      ''
      '  ('
      '    select cast(6 as integer) as classificacao,'
      
        '           cast('#39'Despesas Financeiras'#39' as varchar(50)) as descri' +
        'caoclassificacao,'
      
        '           cast('#39'Juros Pagos'#39' as varchar(50)) as DescricaoEvento' +
        ','
      '           documento, data, cliente, tipocliente, nomecliente,'
      '           sum(valor) as valor'
      '    from'
      '    ('
      ''
      
        '    select cast('#39'DP '#39'||dp.numero||'#39' N'#176' '#39'||d.numero||coalesce(cas' +
        'e when dp.complemento is not null then '#39' COMPL. '#39'||dp.complement' +
        'o end,'#39#39') as varchar(50)) as documento,'
      '           d.datapagto as data,'
      '           dp.fornecedor as cliente,'
      '           dp.tipofornecedor as tipocliente,'
      '           vf.nome as nomecliente,'
      '           d.valorvencto - d.valorpagto  as valor'
      ''
      '    from documentospag dp'
      '         left join vfornecedores vf'
      '         on dp.fornecedor = vf.codigo'
      '         and dp.tipofornecedor = vf.tipo'
      ''
      '         join duplicatas d'
      '         on dp.numero = d.documentopag'
      ''
      '    where d.datapagto between :datainicial and :datafinal'
      '      and (d.valorvencto - d.valorpagto) < 0'
      '    ) as jurospagos'
      '    group by documento, data, cliente, tipocliente, nomecliente'
      '  )'
      ')  as receitasdespesas'
      ''
      
        'group by classificacao, descricaoclassificacao, DescricaoEvento,' +
        ' documento, data, cliente, tipocliente, nomecliente'
      
        'order by classificacao, descricaoclassificacao, DescricaoEvento,' +
        ' data, documento, cliente, tipocliente, nomecliente'
      ''
      '')
    RequestLive = False
    Left = 192
    Top = 296
    ParamData = <
      item
        DataType = ftString
        Name = 'datainicial'
        ParamType = ptUnknown
        Value = #39'2015-01-01'#39
      end
      item
        DataType = ftString
        Name = 'datafinal'
        ParamType = ptUnknown
        Value = #39'2015-01-31'#39
      end>
  end
  object frxDBReceitasDespesasFinanceiras: TfrxDBDataset
    UserName = 'frxDBReceitasDespesasFinanceiras'
