    AfterOpen = qryChequesRepassadosAfterOpen
    AfterClose = qryChequesRepassadosAfterClose
    AfterPost = qryChequesRepassadosAfterPost
    AfterDelete = qryChequesRepassadosAfterDelete
    OnFilterRecord = qryChequesRepassadosFilterRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select cr.*,'
      '       cast(substring(c.numero,01,03) as varchar) as banco,'
      '       cast(substring(c.numero,04,04) as varchar) as agencia,'
      '       cast(substring(c.numero,20,10) as varchar) as conta,'
      
        '       cast(substring(c.numero,12,06) as varchar) as numerochequ' +
        'e,'
      '       c.data,'
      '       c.valor,'
      '       c.vencto,'
      '       c.titular,'
      '       c.situacao,'
      '       c.filial,'
      
        '       (Select coalesce(v.razao,v.nome) as nome  From vfornecedo' +
        'res v Where c.cliente = v.codigo and c.tipocliente = v.tipo) as ' +
        'nomecliente,'
      '       c.cliente,'
      '       c.tipocliente,'
      
        '       (select u.nome from usuarios u where u.codigo = cr.devolv' +
        'edor) as nomedevolvedor'
      '      '
      'from chequesrepassados cr join cheques c on cr.cheque = c.numero'
      'where cr.repasse = :repasse'
      'order by cr.cheque')
    RequestLive = True
    Left = 216
    Top = 112
    ParamData = <
      item
        DataType = ftString
        Name = 'repasse'
        ParamType = ptUnknown
      end>
