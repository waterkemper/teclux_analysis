  object qryCheques: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryChequesBeforeOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'NumerodoCheque'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'periododevencimento'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'listadefiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'banco'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'faixadevalores'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListadeChequesJaSelecionados'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select c.numero,'
      '           cast(substring(c.numero,01,03) as varchar) as banco,'
      
        '           cast(substring(c.numero,04,04) as varchar) as agencia' +
        ','
      '           cast(substring(c.numero,20,10) as varchar) as conta,'
      '           cast(substring(c.numero,12,06) as varchar) as cheque,'
      '           c.data,'
      '           c.valor,'
      '           c.vencto,'
      '           c.titular,'
      '           c.usuario,'
      '           c.situacao,'
      '           c.filial,'
      
        '           (Select coalesce(v.razao,v.nome) as nome  From vforne' +
        'cedores v Where c.cliente = v.codigo and c.tipocliente = v.tipo)' +
        ' as nomecliente,'
      '           c.cliente,'
      '           c.tipocliente,'
      '           false as marcar'
      'From  cheques c'
      'Where c.situacao='#39'N'#39
      
        '  and (Select cheques_situacaocheque(c.numero))='#39'NORMAL'#39'   /* AL' +
        'TERAR A FUN'#199#195'O E NO CAIXA ACEITAR O "NORMAL" PARA QUE HAJA TB'#201'M ' +
        'O RESGATE */'
      '  and not exists (select cr.cheque'
      
        '                  from chequesrepassados cr join repassecheques ' +
        'rc on cr.repasse = rc.numero'
      '                  where rc.excluido is null'
      '                    and cr.devolvido is null'
      '                    and cr.cheque = c.numero limit 1)'
      ''
      '%NumerodoCheque'
      '%periododevencimento'
      '%listadefiliais'
      '%cliente'
      '%banco'
      '%faixadevalores'
      '%ListadeChequesJaSelecionados'
      ''
      'Order by c.valor, c.vencto')
    RequestLive = True
    Left = 58
    Top = 10
    object qryChequesnumero: TStringField
      FieldName = 'numero'
      Size = 30
    end
