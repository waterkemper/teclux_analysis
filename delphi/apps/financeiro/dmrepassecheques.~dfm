    OnCalcFields = qryRepasseChequesCalcFields
    OnNewRecord = qryRepasseChequesNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select rc.*,'
      '       (select count(*)'
      '        from chequesrepassados cr'
      '        where cr.repasse = rc.numero) as QuantidadeRepasse,'
      ''
      '       (select sum(c.valor)'
      
        '        from chequesrepassados cr join cheques c on cr.cheque = ' +
        'c.numero'
      '        where cr.repasse = rc.numero) as TotalRepasse,'
      ''
      '       (select count(*)'
      '        from chequesrepassados cr'
      '        where cr.repasse = rc.numero'
      '          and rc.excluidor is null'
      
        '          OR cr.devolvedor is NOT null) as QuantidadeRepasseDevo' +
        'lvido,'
      ''
      '       (select sum(c.valor)'
      
        '        from chequesrepassados cr join cheques c on cr.cheque = ' +
        'c.numero'
      '        where cr.repasse = rc.numero'
      '          and rc.excluidor is null'
      
        '          OR cr.devolvedor is NOT null) as TotalRepasseDevolvido' +
        ','
      ''
      ''
      
        '         cast((case when vf.pessoatipo = '#39'F'#39' then '#39'CPF'#39' else '#39'CN' +
        'PJ'#39' end) as varchar) as nomepessoanumero,'
      '         formatar_cpf_cnpj(vf.pessoanumero) as pessoanumero,'
      ''
      
        '       (select u.nome from usuarios u where u.codigo = rc.repass' +
        'ador) as nomerepassador,'
      
        '       (select u.nome from usuarios u where u.codigo = rc.exclui' +
        'dor) as nomeexcluidor,'
      ''
      '       (case when rc.excluidor is NOT null then'
      '                  cast('#39'CANCELADO'#39' as varchar(9))'
      '             else'
      
        '               (case when exists (select cr.repasse from cheques' +
        'repassados cr where cr.repasse = rc.numero and cr.devolvedor is ' +
        'not null limit 1) then'
      '                  cast('#39'DEVOLVIDO'#39' as varchar(9))'
      '                else cast('#39'NORMAL'#39' as varchar(9))'
      '                end)'
      '        end) as situacao,'
      '        '
      '        vf.nome as nomefornecedor'
      ''
      
        'from repassecheques rc join vfornecedores vf on rc.fornecedor = ' +
        'vf.codigo and rc.tipofornecedor = vf.tipo'
      'where rc.numero = :numero')
