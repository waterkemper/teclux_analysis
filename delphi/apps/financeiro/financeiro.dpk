package financeiro;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  repositorio,
  vclx,
  vcl,
  rtl,
  dbrtl,
  vcldb,
  tecsoft6,
  frx,
  visualdbclx,
  visualclx,
  designide,
  vclactnband,
  VclSmp,
  ZPgSql6,
  ZDbware6,
  ZCommon6;

contains
  dmchequesgeracao in 'dmchequesgeracao.pas' {dtmChequesGeracao: TDataModule},
  dmmanutencaocheques in 'dmmanutencaocheques.pas' {dtmManutencaoCheques: TDataModule},
  dmrelatoriochequesvencimentos in 'dmrelatoriochequesvencimentos.pas' {dtmRelatorioChequesVencimentos: TDataModule},
  fmalteraremessa in 'fmalteraremessa.pas' {frmAlteraRemessa},
  fmchequesgeracao in 'fmchequesgeracao.pas' {frmChequesGeracao},
  fmmanutencaocheques in 'fmmanutencaocheques.pas' {frmManutencaoCheques},
  fmrelatoriochequesvencimentos in 'fmrelatoriochequesvencimentos.pas' {frmRelatorioChequesVencimentos},
  rgfinanceiro in 'rgfinanceiro.pas',
  fmlerdadosdefinicaocobrador in 'fmlerdadosdefinicaocobrador.pas' {frmLerDadosDefinicaoCobrador},
  fmlerdadosdefinirmotivo in 'fmlerdadosdefinirmotivo.pas' {frmLerDadosDefinirMotivo},
  fmplanilhacusto in 'fmplanilhacusto.pas' {frmPlanilhaCusto},
  dmcadastromoedas in 'dmcadastromoedas.pas' {dtmCadastroMoedas: TDataModule},
  fmcadastromoedas in 'fmcadastromoedas.pas' {frmCadastroMoedas},
  fmcadastromoedascotacoes in 'fmcadastromoedascotacoes.pas' {frmCadastroMoedasCotacoes},
  dmrepassecheques in 'dmrepassecheques.pas' {dtmrepassecheques: TDataModule},
  fmrepassecheques in 'fmrepassecheques.pas' {frmrepassecheques},
  fmcadastrochequesrepassados in 'fmcadastrochequesrepassados.pas' {frmCadastroChequesRepassados},
  fmcadastrocheques in '..\adminsistema\fmcadastrocheques.pas' {frmCadastroCheques},
  dmcadastrocheques in '..\adminsistema\dmcadastrocheques.pas' {dtmCadastroCheques: TDataModule},
  dmdre in 'dmdre.pas' {dtmdre: TDataModule},
  fmdre in 'fmdre.pas' {frmdre},
  dmDREGerencial in 'dmDREGerencial.pas' {dtmDREGerencial: TDataModule},
  fmDREGerencial in 'fmDREGerencial.pas' {frmDREGerencial};

end.
