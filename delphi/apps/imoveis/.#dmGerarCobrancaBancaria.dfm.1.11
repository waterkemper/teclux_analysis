  object qryClienteContrato: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT *,'
      
        '       (Select coalesce(v.razao,v.nome)  from vfornecedores v wh' +
        'ere v.codigo = g.cliente and g.tipocliente = v.tipo) as nomeclie' +
        'nte,'
      
        '       (Select e.nome from empreendimentos e where e.codigo = g.' +
        'empreendimento) as nomeempreendimento'
      'FROM'
      '('
      'SELECT c.cliente,'
      '       c.tipocliente,'
      
        '       (Select vi.empreendimento from vendasimoveis vi where vi.' +
        'contrato = c.contrato) as empreendimento'
      'FROM  compradores c'
      'WHERE c.contrato = :Contrato'
      ') as g')
    RequestLive = False
    Left = 368
    Top = 104
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'Contrato'
        ParamType = ptUnknown
      end>
