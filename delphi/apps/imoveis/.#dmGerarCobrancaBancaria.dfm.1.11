  object qryRetornoACBr: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'vQueParcelas'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      
        '/*------------------------------------------------------ A estru' +
        'tura '#233' id'#234'ntica a qryDadosRetorno */'
      ';'
      'SELECT s.* FROM'
      ''
      '('
      ' SELECT pi.Contrato,'
      ''
      '       (SELECT vi.Situacao FROM VendasImoveis vi'
      '           WHERE vi.Contrato = pi.Contrato) AS Situacao,'
      ''
      '       (SELECT vi.Empreendimento FROM VendasImoveis vi'
      '           WHERE vi.Contrato = pi.Contrato) AS Empreendimento,'
      ''
      '       (SELECT e.Nome FROM Empreendimentos e'
      
        '           WHERE e.Codigo = (SELECT vi.Empreendimento FROM Venda' +
        'sImoveis vi'
      
        '                               WHERE vi.Contrato = pi.Contrato))' +
        ' AS NomeEmpreendimento,'
      ''
      '       (SELECT c.Cliente FROM Compradores c'
      '           WHERE c.Contrato = pi.Contrato AND'
      '                 c.Principal) AS Cliente,'
      ''
      '       (SELECT vf.Nome FROM vFornecedores vf'
      
        '           WHERE vf.Codigo = (SELECT c.Cliente FROM Compradores ' +
        'c'
      
        '                                 WHERE c.Contrato = pi.Contrato ' +
        'AND'
      '                                       c.Principal) AND'
      
        '                 vf.Tipo   = (SELECT c.TipoCliente FROM Comprado' +
        'res c'
      
        '                                 WHERE c.Contrato = pi.Contrato ' +
        'AND'
      
        '                                       c.Principal)) AS NomeClie' +
        'nte,'
      ''
      '        pi.Tipo AS TipoParcela,'
      '        pi.Numero AS Parcela,'
      '        pi.Origem AS OrigemParcela,'
      '        CAST(NULL  AS INTEGER) AS Banco,'
      '        CAST(NULL  AS INTEGER) AS CodMov,'
      '        CAST(NULL  AS VARCHAR) AS DesccricaoMov,'
      '        pi.DataVencto,'
      '        pi.ValorVencto,'
      '        pi.DataPagto,'
      '        pi.ValorPagto,'
      '        CAST(NULL  AS DATE)    AS DataCreditado,'
      '        CAST(NULL  AS NUMERIC) AS ValorCreditado,'
      '        CAST(NULL  AS INTEGER) AS Moeda,'
      '        CAST(NULL  AS NUMERIC) AS Acrescimo,'
      '        CAST(NULL  AS NUMERIC) AS Descontos,'
      '        CAST(NULL  AS NUMERIC) AS IOF,'
      '        CAST(NULL  AS NUMERIC) AS Abatimentos,'
      '        CAST(NULL  AS NUMERIC) AS Tarifa,'
      '        CAST(FALSE AS BOOLEAN) AS Erro,'
      '        CAST(NULL  AS VARCHAR) AS DescErro,'
      '        CAST(FALSE AS BOOLEAN) AS Outras,'
      '        CAST(FALSE AS BOOLEAN) AS tecLUX,'
      '        CAST(FALSE AS BOOLEAN) AS Site,'
      '        CAST(FALSE AS BOOLEAN) AS tecVIM,'
      '        CAST(FALSE AS BOOLEAN) AS CobCaixa,'
      '        CAST(NULL  AS VARCHAR) AS Observacoes'
      ''
      ' FROM  ParcelasImoveis pi'
      ''
      ' WHERE TRUE'
      '       %vQueParcelas'
      ') AS s'
      
        'ORDER BY UPPER(TO_ASCII(s.NomeCliente,'#39'LATIN1'#39')), s.Contrato, s.' +
        'TipoParcela, s.Parcela'
      '')
    RequestLive = True
    Left = 608
    Top = 224
