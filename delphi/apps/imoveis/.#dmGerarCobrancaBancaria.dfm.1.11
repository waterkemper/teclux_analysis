  object qryDadosRetorno: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT CAST(NULL  AS INTEGER) AS Contrato,'
      '       CAST(NULL  AS INTEGER) AS Empreendimento,'
      '       CAST(NULL  AS VARCHAR) AS NomeEmpreendimento,'
      '       CAST(NULL  AS INTEGER) AS Cliente,'
      '       CAST(NULL  AS VARCHAR) AS NomeCliente,'
      '       CAST(NULL  AS VARCHAR) AS TipoParcela,'
      '       CAST(NULL  AS INTEGER) AS Parcela,'
      '       CAST(NULL  AS VARCHAR) AS OrigemParcela,'
      '       CAST(NULL  AS INTEGER) AS Banco,'
      '       CAST(NULL  AS INTEGER) AS CodMov,'
      '       CAST(NULL  AS VARCHAR) AS DesccricaoMov,'
      '       CAST(NULL  AS DATE)    AS DataVencto,'
      '       CAST(NULL  AS NUMERIC) AS ValorVencto,'
      '       CAST(NULL  AS DATE)    AS DataPagto,'
      '       CAST(NULL  AS NUMERIC) AS ValorPagto,'
      '       CAST(NULL  AS DATE)    AS DataCreditado,'
      '       CAST(NULL  AS NUMERIC) AS ValorCreditado,'
      '       CAST(NULL  AS INTEGER) AS Moeda,'
      '       CAST(NULL  AS NUMERIC) AS Acrescimo,'
      '       CAST(NULL  AS NUMERIC) AS Descontos,'
      '       CAST(NULL  AS NUMERIC) AS IOF,'
      '       CAST(NULL  AS NUMERIC) AS Abatimentos,'
      '       CAST(NULL  AS NUMERIC) AS Tarifa,'
      '       CAST(FALSE AS BOOLEAN) AS Erro,'
      '       CAST(NULL  AS VARCHAR) AS DescErro,'
      '       CAST(FALSE AS BOOLEAN) AS Outras,'
      '       CAST(FALSE AS BOOLEAN) AS tecLUX,'
      '       CAST(FALSE AS BOOLEAN) AS Site,'
      '       CAST(FALSE AS BOOLEAN) AS tecVIM,'
      '       CAST(FALSE AS BOOLEAN) AS CobCaixa,'
      '       CAST(NULL  AS VARCHAR) AS Observacoes')
    RequestLive = True
    Left = 264
    Top = 16
