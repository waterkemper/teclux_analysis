  object qryParcelasRetorno: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'MacroWhere'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select pi.*,'
      
        '       (select valorcorrigido(pi.contrato,pi.tipo, pi.numero,pi.' +
        'nrpagto,pi.datavencto,true)) as valorcorrigido,'
      
        '       (select valordevido(pi.contrato,pi.tipo, pi.numero,pi.nrp' +
        'agto,pi.datavencto)) as valordevido'
      
        'from parcelasimoveis pi join vendasimoveis vi on pi.contrato = v' +
        'i.contrato'
      
        '                        join compradores co on pi.contrato = co.' +
        'contrato'
      '%MacroWhere'
      '/*:DataVencto'
      '  :Empreendimento'
      '  :TipoParcela'
      '  :Numero'
      '  :Cliente'
      '  :Contrato */'
      '')
    RequestLive = True
    Left = 120
    Top = 152
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'DataVencto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Empreendimento'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'TipoParcela'
        ParamType = ptUnknown
      end
