  object qryContratosParcelas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryContratosParcelasCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Empreendimento'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'SELECT *,'
      '       CASE WHEN LENGTH(Endereco) > 40'
      '            THEN TRUE'
      '            ELSE FALSE'
      '       END AS CampoMaior'
      'FROM ('
      '      SELECT DISTINCT co.Contrato, co.Cliente,'
      '                      pi.Tipo       AS TipoParcela,'
      '                      pi.Numero     AS NrParcela,'
      '                      pi.Origem     AS OrigemParcela,'
      '                      pi.DataVencto AS VenctoParcela,'
      '                      pi.NossoNumero,'
      '                      COALESCE(vi.AtrasoJuros, 0) AS TaxaJuros,'
      
        '                      COALESCE(vi.AtrasoMulta, 0) AS PercentualM' +
        'ulta,'
      ''
      
        '                     (SELECT ValorDevido(pi.Contrato, pi.Tipo, p' +
        'i.Numero,'
      
        '                                         pi.NrPagto,  pi.DataVen' +
        'cto)) AS ValorParcela,'
      ''
      
        '                      CASE WHEN vf.Numero IS NULL     AND vf.Com' +
        'plemento IS NULL     THEN vf.Rua'
      
        '                           WHEN vf.Numero IS NOT NULL AND vf.Com' +
        'plemento IS NULL     THEN vf.Rua || '#39','#39' || CAST(vf.Numero AS VAR' +
        'CHAR)'
      
        '                           WHEN vf.Numero IS NOT NULL AND vf.Com' +
        'plemento IS NOT NULL THEN vf.Rua || '#39','#39' || CAST(vf.Numero AS VAR' +
        'CHAR) || '#39'-'#39' || vf.Complemento'
      '                           ELSE vf.Rua'
      '                      END AS Endereco,'
      ''
      '                      vf.*,'
      
        '                      UPPER(TO_ASCII(COALESCE(vf.Razao, vf.Nome)' +
        ' , '#39'LATIN1'#39')) AS NomeCliente,'
      '                     (SELECT Nome FROM Bairros b'
      '                         WHERE b.Estado = vf.Estado AND'
      '                               b.Cidade = vf.Cidade AND'
      
        '                               b.Codigo = vf.Bairro) AS NomeBair' +
        'ro,'
      '                         '
      '                     (SELECT Nome FROM Cidades d'
      '                         WHERE d.Estado = vf.Estado AND'
      
        '                               d.Codigo = vf.Cidade) AS NomeCida' +
        'de,'
      ''
      '                      FALSE AS Selecionado'
      ''
      '         FROM Compradores co'
      
        '              JOIN vFornecedores vf ON co.Cliente     = vf.Codig' +
        'o AND'
      '                                       co.TipoCliente = vf.Tipo'
      
        '              JOIN ParcelasImoveis pi ON pi.Contrato = co.Contra' +
        'to'
      
        '              JOIN VendasImoveis   vi ON vi.Contrato = co.Contra' +
        'to'
      ''
      '         WHERE co.Contrato IN (SELECT pi.Contrato'
      '                                  FROM ParcelasImoveis pi'
      
        '                                       JOIN VendasImoveis vi ON ' +
        'pi.Contrato = vi.Contrato'
      '                                            %Empreendimento'
      
        '                                  WHERE pi.DataVencto BETWEEN :D' +
        'ataInicial AND :DataFinal AND'
      '                                        pi.DataPagto IS NULL AND'
      '                                        '
      
        '                                        CASE WHEN vi.Situacao IN' +
        ' ('#39'C'#39','#39'R'#39','#39'T'#39','#39'G'#39','#39'Q'#39','#39'S'#39') THEN FALSE'
      
        '                                             WHEN vi.Situacao IN' +
        ' ('#39'V'#39','#39'F'#39','#39'D'#39') THEN TRUE'
      '                                             ELSE FALSE'
      '                                        END'
      '                              ) AND'
      '               co.principal     AND'
      
        '               pi.DataVencto BETWEEN :DataInicial AND :DataFinal' +
        ' AND'
      '               pi.DataPagto IS NULL'
      ''
      
        '         ORDER BY NomeCliente, co.Cliente, co.Contrato, pi.Tipo,' +
        ' pi.Numero'
      '     ) AS s'
      '')
    RequestLive = True
    Left = 48
    Top = 16
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'DataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataFinal'
        ParamType = ptUnknown
      end>
