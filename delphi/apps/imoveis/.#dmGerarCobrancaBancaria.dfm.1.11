  object qryParcelasImoveis: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      
        'SELECT pi.*, vi.Empreendimento, c.Cliente, COALESCE(vf.Razao,vf.' +
        'Nome) AS Nome'
      'FROM ParcelasImoveis pi'
      '     JOIN VendasImoveis vi'
      '          JOIN Compradores c'
      
        '               JOIN vFornecedores vf ON c.Cliente     = vf.Codig' +
        'o AND'
      '                                        c.TipoCliente = vf.Tipo'
      '          ON vi.Contrato = c.Contrato AND'
      '                           c.Principal'
      '     ON pi.Contrato = vi.Contrato'
      'WHERE pi.NossoNumero = :NossoNumero'
      '')
    RequestLive = False
    Left = 56
    Top = 360
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'nossonumero'
        ParamType = ptUnknown
      end>
  end
