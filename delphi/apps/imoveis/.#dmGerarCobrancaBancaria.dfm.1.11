  object qryParcelas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Empreendimento'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'SELECT pi.*,'
      
        '      (SELECT ValorDevido(pi.Contrato, pi.Tipo, pi.Numero, pi.Nr' +
        'Pagto, pi.DataVencto)) AS Valordevido,'
      
        '      (SELECT JurosContratuais(pi.ValorCorrigido, pi.TaxaJuros, ' +
        'pi.DataBase, pi.DataVencto)) AS Juros'
      'FROM'
      '     ('
      '      SELECT DISTINCT pi.Contrato,'
      '                      pi.Tipo,'
      '                      pi.Origem,'
      '                      pi.Numero,'
      '                      pi.TaxaJuros,'
      '                      pi.Moeda,'
      '                      pi.NrPagto,'
      '                      pi.DataBase,'
      '                      pi.DataVencto,'
      '                      pi.ValorHistorico,'
      
        '                    (SELECT ValorCorrigido(pi.Contrato, pi.Tipo,' +
        ' pi.Numero,'
      
        '                                           pi.NrPagto,  pi.DataV' +
        'encto, TRUE)) AS ValorCorrigido'
      '         FROM ParcelasImoveis pi'
      '              JOIN VendasImoveis vi'
      '                   ON pi.Contrato = vi.Contrato'
      '                      %Empreendimento'
      ''
      
        '         WHERE pi.DataVencto BETWEEN :DataInicial AND :DataFinal' +
        ' AND'
      '               pi.DataPagto IS NULL AND'
      '               '
      
        '               CASE WHEN vi.Situacao IN ('#39'C'#39', '#39'R'#39')           THE' +
        'N FALSE'
      
        '                    WHEN vi.Situacao IN ('#39'T'#39', '#39'G'#39', '#39'Q'#39', '#39'S'#39') THE' +
        'N FALSE'
      
        '                    WHEN vi.Situacao IN ('#39'F'#39', '#39'D'#39')           THE' +
        'N TRUE'
      
        '                    WHEN vi.Situacao IN ('#39'V'#39')                THE' +
        'N TRUE'
      '                    ELSE FALSE'
      '               END'
      '         ORDER BY pi.Contrato'
      '     ) AS pi'
      '')
    RequestLive = False
    Left = 152
    Top = 16
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'DataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataFinal'
        ParamType = ptUnknown
      end>
