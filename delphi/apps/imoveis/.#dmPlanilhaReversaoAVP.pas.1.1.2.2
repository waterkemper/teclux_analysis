  FR_DBSet, FR_Class, biblio, clparametrossistema, fmpreviewpadrao,
  FR_Desgn, StdCtrls, Variants, Graphics, DB, cpdatasource, ZQuery,
  ZPgSqlQuery, cpquery, ZTransact, frxClass, frxDBSet, frxExportODF,
  frxExportTXT, frxExportMail, frxExportCSV, frxExportText, frxExportImage,
  frxExportRTF, frxExportXML, frxExportXLS, frxExportHTML,dateutils;

type
  TdtmPlanilhaReversaoAVP = class(TdtmBasico)
    qryParcelas: TtecQuery;
    dsrParcelas: TtecDataSource;
    qryParcelascontrato: TIntegerField;
    qryParcelascliente: TIntegerField;
    qryParcelasdata: TDateField;
    qryParcelasnomeempreendimento: TStringField;
    qryParcelasnomecliente: TStringField;
    qryParcelasorigem: TStringField;
    qryParcelastipo: TStringField;
    qryParcelasnumero: TIntegerField;
    qryParcelasnrpagto: TIntegerField;
    qryParcelasvalorpagto: TFloatField;
    qryParcelasdatapagto: TDateField;
    qryParcelasvalorhistorico: TFloatField;
    qryParcelasvalorcorrigido: TFloatField;
    qryParcelasvalordevido: TFloatField;
    qryParcelascorrecao: TFloatField;
    qryParcelasjuros: TFloatField;
    frpRelatorioParcelas: TfrReport;
    fdsParcelas: TfrDBDataSet;
    qryParcelasvalorcontratado: TFloatField;
    qryParcelasdescontos: TFloatField;
    qryParcelasjurosmulta: TFloatField;
    qryParcelascontapagto: TMemoField;
    qryParcelasconta: TIntegerField;
    qryParcelasdatavencto: TDateField;
    qryParcelasvalordevidoinicioperiodo: TFloatField;
    qryParcelasanomespagto: TMemoField;
    frxDBParcelas: TfrxDBDataset;
    frxDBParcelas_: TfrxDBDataset;
    frxParcelas: TfrxReport;
    frxHTMLExport1: TfrxHTMLExport;
    frxXLSExport1: TfrxXLSExport;
    frxXMLExport1: TfrxXMLExport;
    frxRTFExport1: TfrxRTFExport;
    frxBMPExport1: TfrxBMPExport;
    frxJPEGExport1: TfrxJPEGExport;
    frxTIFFExport1: TfrxTIFFExport;
