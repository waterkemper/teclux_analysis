    { Public declarations }
    property DataInicial : TDateTime read FDataInicial write FDataInicial;
    property DataFinal : TDateTime read FDataFinal write FDataFinal;
    property Empreendimento : Integer read FEmpreendimento write FEmpreendimento;
    property Cliente : Integer read FCliente write FCliente;

    procedure ImprimirRelatorio;
  end;

var
  dtmPlanilhaReversaoAVP: TdtmPlanilhaReversaoAVP;

implementation

{$R *.dfm}

procedure TdtmPlanilhaReversaoAVP.ImprimirRelatorio;
var
  PV: TfrxComponent;
begin

  qryparcelas.Close;
  qryParcelas.Open;

  AtribuirParametrosBaseRelatorio;
  frxGlobalVariables['TITULO']:= 'PLANILHA PARA REVERSÃO AVP ENTRE '+FormatDateTime('MM/YYYY',FDataInicial)+
                          ' E '+FormatDateTime('MM/YYYY',FDataFinal);

    if FileExists(LogotipoFilialBase) then
    begin
      PV := frxParcelas.FindObject('fpvLogo');
      if (PV is TfrxPictureView) then
        TfrxPictureView(PV).picture.LoadFromFile(LogotipoFilialBase);
    end;


  frxParcelaS.ShowReport(true);
end;

procedure TdtmPlanilhaReversaoAVP.qryParcelasBeforeOpen(DataSet: TDataSet);
begin
  inherited;
  qryParcelas.ParamByName('DataInicial').AsDateTime:= FDataInicial;
  qryParcelas.ParamByName('DataFinal').AsDateTime  := FDataFinal;
  if FEmpreendimento > 0 then
    qryParcelas.MacroByName('WhereEmpreendimentos').AsString:= 'AND e.codigo = '+IntToStr(FEmpreendimento)
  else
    qryParcelas.MacroByName('WhereEmpreendimentos').AsString:= '';
  if FCliente > 0 then
    qryParcelas.MacroByName('WhereClientes').AsString:= 'AND cliente = ' + inttostr(FCliente)
  else
    qryParcelas.MacroByName('WhereClientes').AsString:= '';

//  qryParcelas.MacroByName('Ordenacao').ASString := 'ORDER BY datapagto, TO_ASCII(NomeEmpreendimento, ''LATIN1''), TO_ASCII(NomeCliente, ''LATIN1''), contrato';

end;

procedure TdtmPlanilhaReversaoAVP.frpRelatorioParcelasBeforePrint(Memo: TStringList; View: TfrView);
begin
  inherited;
  ZebrarLinhaRelatorio(frpRelatorioParcelas, View);
end;


procedure TdtmPlanilhaReversaoAVP.frxParcelasGetValue(
  const VarName: String; var Value: Variant);
begin
  inherited;
  if VarName = 'CordoZebrado' then
    Value :=  strtoint(parsistema.CorZebradoRelatorio)
  else if VarName = 'RAZAOFILIALBASE' then
    Value := RazaoFilialBase
  else if VarName = 'ENDERECO_BAIRRO' then
    Value :=  RuaFilialBase+ ' - '+BairroFilialBase
  else if VarName = 'CEP_CIDADE_UF' then
    Value :=  FormatarCEP(CEPFilialBase)+'  '+CidadeFilialBase+ '  '+ EstadoFilialBase
  else if VarName = 'TITULO' then
    Value := 'PLANILHA PARA REVERSÃO AVP ENTRE '+FormatDateTime('MM/YYYY',FDataInicial)+
                          ' E '+FormatDateTime('MM/YYYY',FDataFinal)
  else if VarName = 'SUBTITULO' then
  begin
    if (Empreendimento <> 0) then
      Value := ' EMPREENDIMENTO: '+inttostr(Empreendimento);
    if (Cliente <> 0) then
      Value := value + ' CLIENTE: '+inttostr(cliente);
  end
  else if VarName = 'DATASALDOINICIAL' then
    Value := formatdatetime('dd/mm/yy', strtodate('01/01/'+inttostr(YearOf(DataInicial)))-1);

end;

end.
