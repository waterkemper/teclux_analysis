    Sql.Strings = (
      
        'update parcelasimoveis set valorcontratadoateHabitese = valorcon' +
        'tratado,'
      '                           moedaateHabitese           = moeda,'
      
        '                           taxajurosateHabitese       = taxajuro' +
        's,'
      
        '                           tipojurosatehabitese       = juroscom' +
        'postos,'
      
        '                           database                   = :dataHab' +
        'itese,'
      ''
      
        '                           moeda                      = indexado' +
        'raposhabitese,'
      
        '                           databaseateHabitese        = database' +
        ','
      '                           taxajuros                  = juros,'
      
        '                           valorcontratado            = valorcor' +
        'rigido(pi.contrato, pi.tipo, pi.numero, pi.nrpagto, :dataHabites' +
        'e, false)'
      ''
      ''
      'from'
      ' ('
      ''
      '  select pi.contrato,'
      '         pi.tipo,'
      '         pi.numero,'
      '         pi.nrpagto,'
      ''
      '         vi.indexadoraposhabitese,'
      '         vi.juros'
      ''
      '  from parcelasimoveis pi'
      '       join vendasimoveis vi'
      '       on pi.contrato = vi.contrato'
      ''
      '  where pi.contrato = vi.contrato'
      '    and pi.datapagto is null'
      '    and vi.empreendimento = :empreendimento'
      '    and vi.situacao in ('#39'V'#39','#39'F'#39','#39'D'#39')'
      ''
      ' ) as pi'
      ' where pi.contrato = parcelasimoveis.contrato'
      '   and pi.tipo     = parcelasimoveis.tipo'
      '   and pi.numero   = parcelasimoveis.numero'
      '   and pi.nrpagto  = parcelasimoveis.nrpagto')
