function TdtmContratosImoveis.GetSituacaoContrato: TtecSituacaoContratoImoveis;
begin
  if qryContratossituacao.AsString = 'R' then
    Result:= sciRESERVADO
  else
  if qryContratossituacao.AsString = 'C' then
    Result:= sciCANCELADO
  else
  if qryContratossituacao.AsString = 'V' then
    Result:= sciVENDIDO
  else
  if qryContratossituacao.AsString = 'Q' then
    Result:= sciQUITADO
  else
  if qryContratossituacao.AsString = 'S' then
    Result:= sciRESCINDIDO
  else
  if qryContratossituacao.AsString = 'T' then
    Result:= sciTRANSFERIDO
  else
  if qryContratossituacao.AsString = 'F' then
    Result:= sciTRANSFERENCIA
  else
  if qryContratossituacao.AsString = 'G' then
    Result:= sciRENEGOCIADO
  else
  if qryContratossituacao.AsString = 'D' then
    Result:= sciRENEGOCIACAO
  else
    Result:= sciNENHUM;

{
                            CHECK (Situacao IN ('R',   -- [R]eservado
                                                'V',   -- [V]endido
                                                'C',   -- [C]ancelado
                                                'Q',   -- [Q]uitado
                                                'T',   -- [T]ransferido para
                                                'F',   -- trans[F]erido de
                                                'G',   -- Rene[G]ociado para
                                                'D',   -- Renegocia[D]o de
                                                'S')), -- Re[S]cindido
}
end;

