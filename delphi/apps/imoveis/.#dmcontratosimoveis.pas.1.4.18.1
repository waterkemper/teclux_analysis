function TdtmContratosImoveis.GetNrOrigem: Int64;
var Contrato, Parcela, TipoStr, NrPagto : String;
    Evento, Tipo, Mes, Ano: Integer;
begin
  if (dtmContratosImoveis.qryParcelasContratonumeroorigem.AsSTring <> '') and (NrOrigem[1] = 'T') then
    Result:= StrToInt64(dtmContratosImoveis.qryParcelasContratonumeroorigem.AsSTring)
  else
  begin
    case FNrOrigem[1] of
      'V' : Evento:= 1;
      'H' : Evento:= 2;
      'O' : Evento:= 3;
      'T' : Evento:= 4;
      'G' : Evento:= 5;
    end;
    Contrato:= preencheString(qryContratoscontrato.AsString,'0',6,false)+inttostr(Evento);
    if Evento < 3 then
      Result:= strtoint64(Contrato + '0000000')
    else if Evento = 3 then
    begin
      Mes:= MonthOf(Date);
      Ano:= YearOf(Date);
      Result:= StrToInt64(contrato + '0'+inttostr(Mes)+inttostr(Ano));
    end
    else if Evento = 4 then
    begin
      Tipo   := ConverterTipoParcela(qryParcelasContratotipo.AsString[1]);
      Parcela:= preencheString(qryParcelasContratonumero.AsString, '0',3,False);
      NrPagto:= preencheString(qryParcelasContratonrpagto.AsString,'0',2,False);
      TipoStr:= preencheString(inttostr(Tipo),'0',2,False);
      Result := strtoint64(Contrato + TipoStr + Parcela + NrPagto);
    end
    else if Evento = 5 then
    begin
      if OperacaoRescisao = 'EP' then
        Result:= StrToInt64(Contrato+'1000000')
      else if OperacaoRescisao = 'EI' then
        Result:= StrToInt64(Contrato+'2000000')
      else if OperacaoRescisao = 'EV' then
        Result:= StrToInt64(Contrato+'3000000')
      else if OperacaoTransferencia then
        Result:= StrToInt64(Contrato+'4000000')
      else if OperacaoRenegociacao then
        Result:= StrToInt64(Contrato+'5000000')
    end;
  end;
end;

procedure TdtmContratosImoveis.GravarLancamentosContabeis;
begin
  if parsistema.GerarContabilidade then
  begin
    FProximoNrLancto := 0;
    dtmLancamentoContabilidade.qrylancamentosDocumentos.First;
    while not dtmLancamentoContabilidade.qrylancamentosDocumentos.Eof do
    begin
      dtmLancamentoContabilidade.qrylancamentosDocumentos.Edit;
      if (dtmLancamentoContabilidade.qryLancamentosDocumentosnumerocriado.AsBoolean) then
        dtmLancamentoContabilidade.qryLancamentosDocumentosnrlancto.AsInteger := ProximoNrLancto;

      if NrOrigem = 'H' then
        dtmLancamentoContabilidade.qrylancamentosDocumentosdata.AsDateTime     := qryContratosdatachaves.AsDateTime
      else if NrOrigem = 'G' then
      begin
        if dtmContratosImoveis.OperacaoRescisao <> '' then
          dtmLancamentoContabilidade.qrylancamentosDocumentosdata.AsDateTime     := FDataAlteracao
        else if (dtmContratosImoveis.OperacaoTransferencia or dtmContratosImoveis.OperacaoRenegociacao) then
          dtmLancamentoContabilidade.qrylancamentosDocumentosdata.AsDateTime     :=  qryContratosdata.AsDateTime;
      end
      else
        dtmLancamentoContabilidade.qrylancamentosDocumentosdata.AsDateTime     := qryContratosdata.AsDateTime;
      dtmLancamentoContabilidade.qryLancamentosDocumentosexercicio.AsInteger :=
                                          yearof(dtmLancamentoContabilidade.qryLancamentosDocumentosdata.AsDateTime);
      dtmLancamentoContabilidade.qrylancamentosDocumentosnrorigem.AsString   := IntToStr(GetNrOrigem);
      dtmLancamentoContabilidade.qryLancamentosDocumentosfilial.AsInteger    := FilialBase;
      dtmLancamentoContabilidade.qrylancamentosDocumentos.post;
      dtmLancamentoContabilidade.qrylancamentosDocumentos.Next;
    end;
  end;
end;

procedure TdtmContratosImoveis.dsrContratosDataChange(Sender: TObject;
  Field: TField);
begin
  inherited;
  if Field = qryContratosdatachaves then
  begin
    if  qryContratosdatachaves.AsDateTime > 0 then
    begin
      if VerificarCamposHistoricos then
      begin
        if Assigned(FAfterScrollChaves) then
          FAfterScrollChaves(qryContratos);
      end
      else
        MensagemAviso('Alguns campos não foram preechidos:'+#10#13+ Msg);
    end
    else
    begin
      if not IncluindoContrato then
      begin
        FApagarLancamentos:= True;
        if Assigned(FAfterScrollChaves) then
          FAfterScrollChaves(qryContratos);
        FApagarLancamentos:= False;
      end;
    end;
  end
  else if ((field = qryContratospishistorico) or
           (field = qryContratosirpjhistorico) or
           (field = qryContratoscsllhistorico) or
           (field = qryContratoscofinshistorico) or
           (field = qryContratossaldovenda) or
           (field = qryContratossaldocorrecao) or
           (field = qryContratossaldocusto) or
           (field = qryContratoscustoimovel) or
           (field = qryContratosdespesavenda)) then
  begin
  if  qryContratosdatachaves.AsDateTime > 0 then
  begin
    if not IncluindoContrato then
    begin
      FApagarLancamentos:= True;
      if Assigned(FAfterScrollChaves) then
        FAfterScrollChaves(qryContratos);
      FApagarLancamentos:= False;
      FAfterScrollChaves(qryContratos);
    end;
  end;
{  else
  if field = qryContratossituacao then
    ReadOnlyContrato;                 }
end;
end;

