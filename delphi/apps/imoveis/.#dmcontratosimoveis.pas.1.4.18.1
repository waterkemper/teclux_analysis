const
  SQLParcelas       = 'SELECT pi.Contrato,'+#10#13+
                      'pi.Tipo,'+#10#13+
                      'pi.Origem,'+#10#13+
                      'pi.Numero,'+#10#13+
                      'pi.NrPagto,'+#10#13+
                      'pi.DataVencto,'+#10#13+
                      'pi.ValorHistorico,'+#10#13+
                      'pi.ValorContratado,'+#10#13+
                      'pi.Valorvencto,'+#10#13+
                      '(SELECT ValorDevido(pi.Contrato, pi.Tipo, pi.Numero, pi.NrPagto,'+#10#13+
                      '                   (CASE WHEN pi.Datapagto IS NULL'+#10#13+
                      '                         THEN CURRENT_DATE'+#10#13+
                      '                         ELSE pi.Datapagto'+#10#13+
                      '                    END))) AS ValorDevido,'+#10#13+
                      '(SELECT ValorCorrigido(pi.Contrato, pi.Tipo, pi.Numero, pi.NrPagto,'+#10#13+
                      '                     (CASE WHEN pi.Datapagto IS NULL'+#10#13+
                      '                           THEN CURRENT_DATE'+#10#13+
                      '                           ELSE pi.Datapagto'+#10#13+
                      '                      END),true)) AS ValorCorrigido,'+#10#13+
                      'pi.Datapagto,'+#10#13+
                     ' pi.ValorPagto,'+#10#13+
                     '(SELECT JurosContratuais(pi.Contrato, pi.Tipo, pi.Numero, pi.NrPagto,'+#10#13+
                     '                        (CASE WHEN pi.Datapagto IS NULL'+#10#13+
                     '                            THEN CURRENT_DATE'+#10#13+
                     '                            ELSE pi.Datapagto'+#10#13+
                     '                         END))) AS Juros,'+#10#13+
                     'pi.moeda,'+#10#13+
                     '(select m.descricao from moedas m where pi.moeda = m.codigo) as DescricaoMoeda,'+#10#13+
                     'pi.Database,'+#10#13+
                     'pi.TaxaJuros,'+#10#13+
                     'pi.Juroscompostos,'+#10#13+
                     'pi.cheque,'+#10#13+
                     'pi.contapagto,'+#10#13+
                     'pi.agencia,'+#10#13+
                     'pi.bancocheque,'+#10#13+
                     'pi.emitente,'+#10#13+
                     'pi.recibopagto,'+#10#13+
                     'pi.sequencia,'+#10#13+
                     '((SELECT ValorCorrigido(pi.Contrato, pi.Tipo, pi.Numero, pi.NrPagto,'+#10#13+
                     '                       (CASE WHEN pi.Datapagto IS NULL'+#10#13+
                     '                             THEN CURRENT_DATE'+#10#13+
                     '                             ELSE pi.Datapagto'+#10#13+
                     '                       END),true)) - pi.ValorHistorico) AS Correcao,'+#10#13+
                     '(CASE WHEN pi.DataPagto IS NULL'+#10#13+
                     '      THEN NULL'+#10#13+
                     '      ELSE CASE WHEN (pi.Valorpagto - (SELECT ValorDevido(pi.Contrato, pi.Tipo,'+#10#13+
                     '                                                          pi.Numero,pi.NrPagto,'+#10#13+
                     '                                                         pi.Datapagto))) = 0'+#10#13+
                     '                THEN NULL'+#10#13+
                     '                ELSE (pi.Valorpagto - (SELECT ValorDevido(pi.Contrato, pi.Tipo,'+#10#13+
                     '                                                          pi.Numero,   pi.NrPagto,'+#10#13+
                     '                                                          pi.Datapagto)))'+#10#13+
                     '           END'+#10#13+
                     'END) AS Diferenca,'+#10#13+
                     'pi.promissoria,'+#10#13+
                     'pi.documento,'+#10#13+
                     'pi.observacoes,'+#10#13+
                     'pi.tipopagto,'+#10#13+
                     'pi.numeroorigem,'+#10#13+
                     '(SELECT coalesce(v.razao,v.nome) '+#10#13+
	             '       FROM vFornecedores v'+#10#13+
	             '            JOIN Compradores co ON v.codigo  = co.Cliente AND'+#10#13+
	             '                                   v.tipo    = co.tipoCliente AND'+#10#13+
	             '                                   pi.Contrato = co.Contrato'+#10#13+
	             '            WHERE v.codigo  = co.Cliente     AND'+#10#13+
	             '                  v.tipo    = co.tipoCliente AND'+#10#13+
	             '                  pi.Contrato = co.Contrato AND co.principal) AS NomeCliente,'+#10#13+
                     'False as Selecionado,'+#10#13+
                '    pi.ValorContratadoAteHabiteSe,'+#10#13+
                '    pi.MoedaAteHabiteSe,'+#10#13+
                '    pi.TaxaJurosAteHabiteSe,'+#10#13+
                '    pi.DataBaseAteHabiteSe,'+#10#13+
                '    pi.TipoJurosAteHabiteSe'+#10#13+
                     'FROM parcelasimoveis pi'+#10#13+
                     'WHERE pi.Contrato = :Contrato';

var
  dtmContratosImoveis: TdtmContratosImoveis;
  VarRecebimentos: TRecebimentos;
  Msg: String;

implementation

{$R *.dfm}

{ TRecebimentos }

constructor TRecebimentos.Create(QuitacaoLote: Boolean);
begin
  if QuitacaoLote then
  begin
    MontarQuery;
    ZerarValores;
  end
  else
    BuscarParcela;
end;

procedure TRecebimentos.BuscarParcela;
begin
  MontarQuery;
  Contrato     := qryParcelas.FieldByName('Contrato').AsString;
  Tipo         := qryParcelas.FieldByName('tipo').AsString;
  Numero       := qryParcelas.FieldByName('numero').AsInteger;
  Parcela      := qryParcelas.FieldByName('origem').AsString;
  Vencimento   := qryParcelas.FieldByName('datavencto').AsDateTime;
  Sequencia    := qryParcelas.FieldByName('sequencia').AsInteger;
  Evento       := GetEventoRecebimento;
  if AlterandoParcela then
  begin
    Pagamento     := qryParcelas.FieldByName('datapagto').AsDateTime;
    ValorRecebido := qryParcelas.FieldByName('valorpagto').AsCurrency;
  end
  else
    Pagamento  := DataAtual;
  GetDiferenca;
  NrPagto      := qryParcelas.FieldByName('nrpagto').AsInteger;
  NroCheque    := qryParcelas.FieldByName('cheque').AsString;
  Conta        := qryParcelas.FieldByName('contapagto').AsInteger;
  BancoCheque  := qryParcelas.FieldByName('bancocheque').AsInteger;
  Emitente     := qryParcelas.FieldByName('emitente').AsString;
  Agencia      := qryParcelas.FieldByName('agencia').AsInteger;
  ValorDevido  := qryParcelas.FieldByName('valordevido').AsCurrency;
  ValorHistorico   := qryParcelas.FieldByName('valorhistorico').AsCurrency;
  ValorCorrigido   := qryParcelas.FieldByName('valorcorrigido').AsCurrency;
  ValorContratado  := qryParcelas.FieldByName('valorcontratado').AsCurrency;
  JurosContratuais := qryParcelas.FieldByName('juros').AsCurrency;
  if qryParcelas.FieldByName('numeroOrigem').AsString <> '' then
    NumeroOrigem     := StrToInt64(qryParcelas.FieldByName('numeroOrigem').AsString);
  Correcao         := ValorDevido - JurosContratuais - ValorContratado;
  CorrecaoContabil := qryParcelas.FieldByName('correcao').AsCurrency;
  TaxaJuros    := dtmContratosImoveis.qryContratosatrasojuros.AsFloat;
  MultaContrato:= dtmContratosImoveis.qryContratosatrasomulta.AsFloat;
  ValorJuros   := GetJurosMora;
  ValorMulta   := GetMulta;
  ValorTotal   := ValorDevido + ValorJuros + ValorMulta;
  if not AlterandoParcela then
    ValorRecebido:= ValorTotal;
end;

procedure TRecebimentos.MontarQuery;
var result: Boolean;
begin
  Result:= False;
  qryParcelas                       := TtecQuery.Create(nil);
  qryParcelas.CachedUpdates         := True;
  qryParcelas.Sql.Text              := SQLParcelas;
  qryParcelas.DataBase              := dtmTecSoft.dbaTecSoft;
  qryParcelas.Transaction           := dtmTecSoft.tstTecSoft;
  qryParcelas.RequestLive           := True;
  qryParcelas.Sql.Append(AddSqlParcelas);

  qryParcelas.ParamByName('Contrato').AsString:= dtmContratosImoveis.qryContratoscontrato.AsString;


  qryParcelas.Open;
  dtmContratosImoveis.RefazConsultaPorNome(dtmContratosImoveis.qryContasSaidasFiliais,['Filial'],[FilialBase]);
  dtmContratosImoveis.qryContasEntradasFiliais.Open;
  if dtmContratosImoveis.QuitarDiversas then
    qryParcelas.First
  else
    if qryParcelas.Locate('tipo;numero;nrpagto',VarArrayOf([dtmContratosImoveis.qryParcelasContratotipo.AsString,
                                                            dtmContratosImoveis.qryParcelasContratonumero.AsInteger,
                                                            dtmContratosImoveis.qryParcelasContratonrpagto.AsInteger]),[]) then
      Result:= True;
  TFloatField(qryParcelas.FieldByName('valordevido')).DisplayFormat:= '###,###,##0.00';
end;

function TRecebimentos.GravarModificacoes: Boolean;
var DeletarProxima: Boolean;
    ValorCProxima, ValorCAteHProxima, ValorHProxima: Real;
   function VerificarPosterior : boolean;
   var NumPagto, Numparcela : Integer;
       TipoPar: String;
   begin
     Result:= True;
     dtmContratosImoveis.GuardarRegistroAtual(qryParcelas, True);
     TipoPar      := qryParcelas.FieldByName('tipo').AsString;
     Numparcela   := qryParcelas.FieldByName('numero').AsInteger;
     NumPagto     := qryParcelas.FieldByName('nrpagto').AsInteger;

     ValorHProxima:= qryParcelas.FieldByName('valorhistorico').AsCurrency;
     ValorCProxima:= qryParcelas.FieldByName('valorcontratado').AsCurrency;
     ValorCAteHProxima:= qryParcelas.FieldByName('valorcontratadoatehabitese').AsCurrency;

     qryParcelas.Next;
     if ((TipoPar = qryParcelas.FieldByName('tipo').AsString) and
         (Numparcela = qryParcelas.FieldByName('numero').AsInteger) and
         ((NumPagto + 1) = qryParcelas.FieldByName('nrpagto').AsInteger)) then
     begin
       ValorHProxima:= ValorHProxima + qryParcelas.FieldByName('valorhistorico').AsCurrency;
       ValorCProxima:= ValorCProxima + qryParcelas.FieldByName('valorcontratado').AsCurrency;
       ValorCAteHProxima := ValorCAteHProxima + qryParcelas.FieldByName('valorcontratadoatehabitese').AsCurrency;
       if qryParcelas.FieldByName('datapagto').AsString <> '' then
         Result:= False;
     end;
     dtmContratosImoveis.VoltarRegistroAtual(qryParcelas);
   end;
begin
  DeletarProxima:= False;
  dtmContratosImoveis.Gravado := True;

  if dtmContratosImoveis.CancelarRecebimento then
  begin
    if not dtmContratosImoveis.QuitarDiversas then
    begin
      if qryParcelas.FieldByName('tipopagto').AsString = 'P' then
        DeletarProxima:= True;
      if VerificarPosterior then
      begin
        if not (qryParcelas.State = dsedit) then
          qryParcelas.Edit;
        qryParcelas.FieldByName('ValorPagto').Clear;
        qryParcelas.FieldByName('datapagto').Clear;
        qryParcelas.FieldByName('valorvencto').Clear;
        qryParcelas.FieldByName('bancocheque').Clear;
        qryParcelas.FieldByName('cheque').Clear;
        qryParcelas.FieldByName('emitente').Clear;
        qryParcelas.FieldByName('contapagto').Clear;
        qryParcelas.FieldByName('agencia').Clear;
        qryParcelas.FieldByName('sequencia').Clear;
        qryParcelas.FieldByName('recibopagto').Clear;
        qryParcelas.FieldByName('tipopagto').Clear;
        qryParcelas.FieldByName('numeroorigem').Clear;
        qryParcelas.Post;
        If DeletarProxima then
        begin
          dtmContratosImoveis.GuardarRegistroAtual(qryParcelas, True);
          qryParcelas.Next;
          qryParcelas.Delete;
          dtmContratosImoveis.VoltarRegistroAtual(qryParcelas);
          EditarParcela;
          qryParcelas.FieldByName('valorcontratado').AsCurrency:= ValorCProxima;
          qryParcelas.FieldByName('valorhistorico').AsCurrency := ValorHProxima;
          qryParcelas.FieldByName('valorcontratadoatehabitese').AsCurrency:= ValorCAteHProxima;

          qryParcelas.Post;
        end;
        dtmContratosImoveis.Gravado := True;
      end
      else
      begin
        MensagemAviso('Não foi possível cancelar esta quitação.'+#13#10+
                      'Esta parcela foi paga parcialmente e seu saldo foi quitado.'+#13#10+
                      'Cancele a quitação da parcela de saldo.');
        dtmContratosImoveis.Gravado := False;
      end;
    end
    else
    begin
      qryParcelas.First;
      while not qryParcelas.Eof do
      begin
        if qryParcelas.FieldByName('selecionado').AsBoolean then
        begin
          if not (qryParcelas.State = dsedit) then
            qryParcelas.Edit;
          qryParcelas.FieldByName('ValorPagto').Clear;
          qryParcelas.FieldByName('datapagto').Clear;
          qryParcelas.FieldByName('valorvencto').Clear;
          qryParcelas.FieldByName('bancocheque').Clear;
          qryParcelas.FieldByName('cheque').Clear;
          qryParcelas.FieldByName('emitente').Clear;
          qryParcelas.FieldByName('contapagto').Clear;
          qryParcelas.FieldByName('agencia').Clear;
          qryParcelas.FieldByName('sequencia').Clear;
          qryParcelas.FieldByName('recibopagto').Clear;
          qryParcelas.FieldByName('tipopagto').Clear;
          qryParcelas.FieldByName('numeroorigem').Clear;
          qryParcelas.Post;
        end;
        qryParcelas.Next;
      end;
    end;
  end
  else
  begin
    if not dtmContratosImoveis.QuitarDiversas then
    begin
      if not AlterandoParcela then
      begin
        dtmContratosImoveis.spcRecibos.Open;
        FRecibo:= dtmContratosImoveis.spcRecibosrecibo.AsInteger;
        dtmContratosImoveis.spcRecibos.Close;
      end;
      if not (qryParcelas.State = dsedit) then
        qryParcelas.Edit;
      PosicionarParcelasContratoaPagar;
      FNumeroOrigem:= GetNrOrigem;
      if qryParcelas.FieldByName('TipoPagto').IsNull then
        qryParcelas.FieldByName('TipoPagto').AsString  := 'Q';
      qryParcelas.FieldByName('ValorPagto').AsFloat    := FValorRecebido;
      qryParcelas.FieldByName('datapagto').AsDateTime  := FPagamento;
      qryParcelas.FieldByName('valorvencto').AsFloat   := FValorDevido;
      if FBancoCheque > 0 then
        qryParcelas.FieldByName('bancocheque').AsFloat := FBancoCheque;
      qryParcelas.FieldByName('cheque').AsString       := FNroCheque;
      qryParcelas.FieldByName('emitente').AsString     := FEmitente;
      qryParcelas.FieldByName('contapagto').AsInteger  := FConta;
      qryParcelas.FieldByName('agencia').AsInteger     := FAgencia;
      qryParcelas.FieldByName('sequencia').AsInteger   := FSequencia;
      qryParcelas.FieldByName('recibopagto').AsInteger := FRecibo;
      qryParcelas.FieldByName('numeroorigem').AsString := IntToStr(FNumeroOrigem);
      qryParcelas.Post;
    end
    else
    begin
      if not AlterandoParcela then
      begin
        dtmContratosImoveis.spcRecibos.Open;
        FRecibo:= dtmContratosImoveis.spcRecibosrecibo.AsInteger;
        dtmContratosImoveis.spcRecibos.Close;
      end;

      qryParcelas.First;
      FNumeroOrigem := 0;
      while not qryParcelas.Eof do
      begin
        if qryParcelas.FieldByName('selecionado').AsBoolean then
        begin
          PosicionarParcelasContratoaPagar;
          if FNumeroOrigem = 0 then
            FNumeroOrigem:= GetNrOrigem;

          if not (qryParcelas.State = dsedit) then
            qryParcelas.Edit;
          If not DescontoJuros then
          begin
            if LiberarJuroseMulta then
              qryParcelas.FieldByName('ValorPagto').AsFloat  := qryParcelas.FieldByName('ValorDevido').AsFloat
            else
            begin
              qryParcelas.FieldByName('ValorPagto').AsFloat  := qryParcelas.FieldByName('ValorDevido').AsFloat+
                                                                CalcularJurosParcela(qryParcelas.FieldByName('DataVencto').AsDateTime,
                                                                                     FPagamento,
                                                                                     qryParcelas.FieldByName('ValorDevido').AsFloat,
                                                                                     FTaxaJuros) +
                                                                CalcularMultaParcela(qryParcelas.FieldByName('ValorDevido').AsFloat,
                                                                                     FTaxaJuros);
            end;
          end;
          qryParcelas.FieldByName('datapagto').AsDateTime := FPagamento;
          if FBancoCheque > 0 then
            qryParcelas.FieldByName('bancocheque').AsFloat:= FBancoCheque;
          qryParcelas.FieldByName('cheque').AsString      := FNroCheque;
          qryParcelas.FieldByName('emitente').AsString    := FEmitente;
          qryParcelas.FieldByName('contapagto').AsInteger := FConta;
          qryParcelas.FieldByName('agencia').AsInteger    := FAgencia;
          qryParcelas.FieldByName('sequencia').AsInteger  := FSequencia;
          qryParcelas.FieldByName('recibopagto').AsInteger:= FRecibo;
          qryParcelas.FieldByName('TipoPagto').AsString   := 'Q';
          qryParcelas.FieldByName('numeroorigem').AsString:= inttostr(FNumeroOrigem);
          qryParcelas.Post;
        end;
        qryParcelas.Next;
      end;
      PosicionarPrimeiraaPagar;
    end;
  end;

  if dtmContratosImoveis.Gravado then
  begin
    try
      dtmContratosImoveis.Perpetrar([qryparcelas],False);
      dtmContratosImoveis.Perpetrar([dtmLancamentoContabilidade.qrylancamentosDocumentos],False);
      dtmContratosImoveis.Perpetrar([dtmContratosImoveis.qryMovtosBancos,dtmContratosImoveis.qryMovtosBancosEventos],False);
      Result:= True;
    except
      Result:= False;
    end;
  end;
end;

function TRecebimentos.ValidarValorRecebido: Boolean;
Var ValorJuros : Currency;
begin
  Result:= True;
  if not dtmContratosImoveis.QuitarDiversas then
  begin
    if FValorTotal > FValorRecebido then
    begin
      case MensagemSimNaoOpcaoCancelar('O Valor a ser pago é menor que o Valor do vencimento.' + #10#13 +
                                       'A operação a ser realizada, refere-se a um Pagamento'  + #10#13 +
                                       'Parcial. Confirma?','',true,
                                       '&Gerar outra parcela',
                                       '&Desconto obtido') of
        mrYes: begin
                 ParcelaPagaMenor(FValorTotal, True);
                 GerarNovaParcela;
               end;
        mrNo : ValorDesconto := FValorTotal - FValorRecebido;
        mrCancel: Result:= False ;
      end;
    end;
  end
  else
    if FValorTotal <> FValorRecebido then
    begin
      if FValorTotal > FValorRecebido then
        FValorDesconto := FValorTotal - FValorRecebido
      else
        FDiferencaPagoAmais := FValorRecebido - FValorTotal;
      if ((FValorDesconto > 0) or (ValorJuros > 0))  then
      begin
        DescontoJuros:= True;

        AtribuirDescontoJurosQuitacaoDiversas;
      end;
    end
    else
      AlterarValorDevidoParcela;
end;

procedure TRecebimentos.GerarNovaParcela;
var
  Contrato, Numero, NrPagto : Integer;
  Tipo, Origem, Moeda : String;
  DataVencto, DataBase : TDateTime;
  TaxaJuros, Diferenca, Historico : Currency;
  JurosCompostos: Boolean;
begin
  Diferenca       := FDiferenca;
  Historico       := FDiferencaHistorico;
  AtribuirTipoPagto('P');
  Contrato        := qryParcelas.FieldByName('Contrato').AsVariant;
  Numero          := qryParcelas.FieldByName('Numero').AsVariant;
  NrPagto         := qryParcelas.FieldByName('NrPagto').AsVariant;
  Tipo            := qryParcelas.FieldByName('Tipo').AsVariant;
  Origem          := qryParcelas.FieldByName('Origem').AsVariant;
  if not(qryParcelas.FieldByName('Moeda').IsNull) then
    Moeda           := qryParcelas.FieldByName('Moeda').AsVariant;
  DataVencto      := qryParcelas.FieldByName('DataVencto').AsVariant;
  if not(qryParcelas.FieldByName('DataBase').IsNull) then
    DataBase        := qryParcelas.FieldByName('DataBase').AsVariant;
  if not(qryParcelas.FieldByName('TaxaJuros').IsNull) then
    TaxaJuros       := qryParcelas.FieldByName('TaxaJuros').AsVariant;
  if not(qryParcelas.FieldByName('JurosCompostos').IsNull) then
    JurosCompostos  := qryParcelas.FieldByName('JurosCompostos').AsVariant;

  dtmContratosImoveis.GuardarRegistroAtual(qryParcelas, True);

  qryParcelas.Append;
  qryParcelas.FieldByName('Contrato').AsVariant        := Contrato;
  qryParcelas.FieldByName('Numero').AsVariant          := Numero;
  qryParcelas.FieldByName('NrPagto').AsVariant         := NrPagto+1;
  qryParcelas.FieldByName('Tipo').AsVariant            := Tipo;
  qryParcelas.FieldByName('Origem').AsVariant          := Origem;
  qryParcelas.FieldByName('Moeda').AsVariant           := Moeda;
  qryParcelas.FieldByName('DataVencto').AsVariant      := DataVencto;
  qryParcelas.FieldByName('DataBase').AsVariant        := DataBase;
  qryParcelas.FieldByName('ValorHistorico').AsVariant  := Historico;
  qryParcelas.FieldByName('ValorContratado').AsVariant := Diferenca;
  qryParcelas.FieldByName('ValorContratadoAteHabitese').AsVariant := DiferencaAteHabiteSe;

  qryParcelas.FieldByName('MoedaAteHabiteSe').AsVariant := dtmContratosImoveis.qryParcelasContratomoedaatehabitese.AsVariant;
  qryParcelas.FieldByName('TaxaJurosAteHabiteSe').AsVariant := dtmContratosImoveis.qryParcelasContratotaxajurosatehabitese.AsVariant;
  qryParcelas.FieldByName('DataBaseAteHabiteSe').AsVariant := dtmContratosImoveis.qryParcelasContratoDataBaseAteHabiteSe.AsVariant;
  qryParcelas.FieldByName('TipoJurosAteHabiteSe').AsVariant := dtmContratosImoveis.qryParcelasContratoTipoJurosAteHabiteSe.AsVariant;

  if TaxaJuros > 0 then
    qryParcelas.FieldByName('TaxaJuros').AsVariant       := TaxaJuros;
  qryParcelas.FieldByName('JurosCompostos').AsVariant  := JurosCompostos;
  qryParcelas.FieldByName('tipopagto').AsString        := 'S';
  qryParcelas.Post;

  dtmContratosImoveis.VoltarRegistroAtual(qryParcelas);

  //GravarModificacoes;
end;

function TRecebimentos.GetJurosMora: Currency;
begin
  if not FAlterandoParcelas then
    if Pagamento > Vencimento then
      Result:= CalcularJurosParcela(Vencimento,Pagamento,ValorDevido,TaxaJuros)
    else
      Result:= 0
  else
    Result:= 0;
end;

function TRecebimentos.GetMulta: Currency;
begin
  if not FAlterandoParcelas then
    if Pagamento > Vencimento then
      Result:= CalcularMultaParcela(ValorDevido, MultaContrato)
    else
      Result:= 0
  else
    Result:= 0;
end;

procedure TRecebimentos.LiberarMulta(ComMulta: Boolean);
var EstAnterior: Boolean;
begin
  if ComMulta then
  begin
    EstAnterior:= FAlterandoParcelas;
    if FAlterandoParcelas then
      FAlterandoParcelas:= False;
    FValorJuros:= GetJurosMora;
    FValorMulta:= GetMulta;
    FValorTotal:= FValorDevido + FValorJuros + FValorMulta;
    FAlterandoParcelas:= EstAnterior;
  end
  else
  begin
    FValorJuros:= 0;
    FValorMulta:=0;
    FValorTotal:= FValorDevido;
  end;
end;

procedure TRecebimentos.ValorParcelasSelecionadas;
begin
  dtmContratosImoveis.GuardarRegistroAtual(qryParcelas, True);
  ZerarValores;
  qryParcelas.First;
  while not qryParcelas.Eof do
  begin
    if qryParcelas.FieldByName('Selecionado').AsBoolean then
    begin
      ValorContratado  := ValorContratado + qryParcelas.FieldByName('ValorContratado').AsFloat;
      ValorHistorico   := ValorHistorico  + qryParcelas.FieldByName('ValorHistorico').AsFloat;
      JurosContratuais := JurosContratuais + qryParcelas.FieldByName('Juros').AsFloat;
      ValorDevido      := ValorDevido + qryParcelas.FieldByName('ValorDevido').AsFloat;
      Vencimento       := qryParcelas.FieldByName('datavencto').AsFloat;
      CorrecaoContabil := CorrecaoContabil + qryParcelas.FieldByName('correcao').AsFloat;
      If AlterandoParcela then
        Pagamento:=  qryParcelas.FieldByName('datapagto').AsFloat
      else
        Pagamento        := DataAtual;
      TaxaJuros        := dtmContratosImoveis.qryContratosatrasojuros.AsFloat;
      MultaContrato    := dtmContratosImoveis.qryContratosatrasomulta.AsFloat;
      ValorJuros       := ValorJuros + GetJurosMora;
      valorPago        := ValorPago + qryParcelas.FieldByName('valorpagto').AsFloat;
      ValorMulta       := ValorMulta + GetMulta;
      ValorTotal       := (ValorDevido + ValorJuros + ValorMulta);
      ValorRecebido    := ValorPago;
    end;
    qryParcelas.Next;
  end;
  Correcao         := (ValorDevido - JurosContratuais - ValorContratado);
  dtmContratosImoveis.VoltarRegistroAtual(qryParcelas);
end;

