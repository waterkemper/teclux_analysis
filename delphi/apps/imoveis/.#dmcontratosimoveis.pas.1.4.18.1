procedure TdtmContratosImoveis.AtualizarValorHistoricoParcelas;
var ValorHistorico, TotalHistorico: Currency;
begin
  TotalHistorico:= 0;
  GuardarRegistroAtual(qryParcelasContrato, True);
  qryParcelasContrato.First;
  while not qryParcelasContrato.Eof do
  begin
    qryParcelasContrato.Edit;
    ValorHistorico:= Truncar((FSaldoHistorico * qryParcelasContratovalorcontratado.AsCurrency) / qryContratosvalortotal.AsCurrency,2);
    TotalHistorico:= TotalHistorico + ValorHistorico;
    qryParcelasContratovalorhistorico.AsCurrency:= ValorHistorico;
    qryParcelasContrato.Post;
    qryParcelasContrato.Next;
  end;
  qryParcelasContrato.Last;
  qryParcelasContrato.Edit;
  If TotalHistorico < FSaldoHistorico then
    qryParcelasContratovalorhistorico.AsCurrency:= qryParcelasContratovalorhistorico.AsCurrency + (FSaldoHistorico - TotalHistorico)
  else if TotalHistorico > FSaldoHistorico then
    qryParcelasContratovalorhistorico.AsCurrency:= qryParcelasContratovalorhistorico.AsCurrency - (FSaldoHistorico - TotalHistorico);
  qryParcelasContrato.Post;
  VoltarRegistroAtual(qryParcelasContrato);
end;

