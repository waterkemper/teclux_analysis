function TdtmContratosImoveis.AtribuirCompradores_NovoContrato(NovoContrato,
  ContratoOrigem: Integer): Boolean;
var Compradores : T_CompradoresImoveis;
    a, i: Integer;
begin
  a:= 0;
  ReadOnlyContrato(False);
  RefazConsultaPorNome(qryCompradores,['Contrato'], [ContratoOrigem]);
  SetLength(Compradores, qryCompradores.RecordCount);
  qryCompradores.First;
  while not qryCompradores.Eof do
  begin
    Compradores[a].contrato          := qryCompradorescontrato.AsInteger;
    Compradores[a].cliente           := qryCompradorescliente.AsInteger;
    Compradores[a].nomecliente       := qryCompradoresnomecliente.AsString;
    Compradores[a].percentual        := qryCompradorespercentual.AsCurrency;
    Compradores[a].representante     := qryCompradoresrepresentante.AsInteger;
    Compradores[a].nomerepresentante := qryCompradoresnomerepresentante.AsString;
    Compradores[a].fiador            := qryCompradoresfiador.AsInteger;
    Compradores[a].nomefiador        := qryCompradoresnomefiador.AsString;
    Compradores[a].observacoes       := qryCompradoresobservacoes.AsString;
    Compradores[a].tipocliente       := qryCompradorestipocliente.AsString;
    Compradores[a].tiporepresentante := qryCompradorestiporepresentante.AsString;
    Compradores[a].tipofiador        := qryCompradorestipofiador.AsString;
    Compradores[a].principal         := qryCompradoresprincipal.AsBoolean;

    Inc(a);
    qryCompradores.Next;
  end;
  qryCompradores.Close;
  qryCompradores.ParamByName('Contrato').Clear;
  qryCompradores.Open;
  for i:=0 to a-1 do
  begin
    qryCompradores.Append;
    qryCompradorescontrato.AsInteger         := Compradores[i].contrato;
    qryCompradorescliente.AsInteger          := Compradores[i].cliente;
    qryCompradoresnomecliente.AsString       := Compradores[i].nomecliente;
    qryCompradorespercentual.AsCurrency      := Compradores[i].percentual;
    qryCompradoresrepresentante.AsInteger    := Compradores[i].representante;
    qryCompradoresnomerepresentante.AsString := Compradores[i].nomerepresentante;
    qryCompradoresfiador.AsInteger           := Compradores[i].fiador;
    qryCompradoresnomefiador.AsString        := Compradores[i].nomefiador;
    qryCompradoresobservacoes.AsString       := Compradores[i].observacoes;
    qryCompradorestipocliente.AsString       := Compradores[i].tipocliente;
    qryCompradorestiporepresentante.AsString := Compradores[i].tiporepresentante;
    qryCompradorestipofiador.AsString        := Compradores[i].tipofiador;
    qryCompradoresprincipal.AsBoolean        := Compradores[i].principal;
    qryCompradores.Post;
  end;
  ReadOnlyContrato();
end;

