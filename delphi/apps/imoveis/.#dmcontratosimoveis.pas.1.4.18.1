procedure TdtmContratosImoveis.ParametrosImoveis(Empreendimento, Bloco, Imovel, Unidade: String);
begin
  qryConsultaTiposUnidades.close;
  qryConsultaImoveis.close;
  qryConsultaBlocos.close;

  if Bloco <> '' then
  begin
//    qryConsultaBlocos.MacroByName('WhereBloco').AsString:= 'and b.codigo = '+Bloco;

    if unidade <> '' then
      qryConsultaImoveis.MacroByName('WhereUnidades').AsString:= 'and i.unidade = '+unidade;

    if Imovel <> '' then
      qryConsultaImoveis.MacroByName('WhereImoveis').AsString:= 'and i.numero = '+quotedstr(Imovel);

    ReFazConsulta(qryConsultaTiposUnidades,[0],[Bloco]);
    ReFazConsulta(qryConsultaImoveis,[0],[Bloco]);
  end;
  ReFazConsulta(qryConsultaBlocos,[0],[Empreendimento]);
end;

