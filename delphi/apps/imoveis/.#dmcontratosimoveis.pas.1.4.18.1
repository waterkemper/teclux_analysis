    FValorDesconto:= 0;
    FValorMulta:= 0;
  end;
end;

procedure TRecebimentos.AtribuirDescontoJurosQuitacaoDiversas;
var DescontoJurosParcela, SaldoDiferenca: Currency;
    TipoParcela : String;
    NParcela, NrPagtoParcela : Integer;
begin
  DescontoJurosParcela:= 0;
  qryParcelas.First;
  while not qryParcelas.Eof do
  begin
    if qryParcelas.FieldByName('selecionado').AsBoolean then
    begin
      if not (qryParcelas.State = dsedit) then
        qryParcelas.Edit;

      if LiberarJuroseMulta then
        qryParcelas.FieldByName('ValorPagto').AsCurrency  := CalculoDescontoJurosQuitacaoDiversas
      else
      begin
        qryParcelas.FieldByName('ValorPagto').AsCurrency  := CalculoDescontoJurosQuitacaoDiversas +
                                                          CalcularJurosParcela(qryParcelas.FieldByName('DataVencto').AsDateTime,
                                                                               FPagamento,
                                                                               qryParcelas.FieldByName('ValorDevido').AsFloat,
                                                                               FTaxaJuros) +
                                                          CalcularMultaParcela(qryParcelas.FieldByName('ValorDevido').AsFloat,
                                                                               FTaxaJuros);
      end;
      DescontoJurosParcela := DescontoJurosParcela + qryParcelas.FieldByName('ValorPagto').AsCurrency;
      TipoParcela    := qryParcelas.FieldByName('tipo').AsString;
      NParcela       := qryParcelas.FieldByName('numero').AsInteger;
      NrPagtoParcela := qryParcelas.FieldByName('nrpagto').AsInteger;
      qryParcelas.Post;
    end;
    qryParcelas.Next;
  end;
  if FValorRecebido <> DescontoJurosParcela then
  begin
    qryParcelas.Locate('tipo;numero,nrpagto',VarArrayOf([TipoParcela,NParcela,NrPagtoParcela]),[]);
    qryParcelas.Edit;
    if FValorRecebido > DescontoJurosParcela then
    begin
      SaldoDiferenca := FValorRecebido - DescontoJurosParcela;
      qryParcelas.FieldByName('ValorPagto').AsCurrency  := qryParcelas.FieldByName('ValorPagto').AsCurrency + SaldoDiferenca;
    end
    else
    begin
      SaldoDiferenca := DescontoJurosParcela - FValorRecebido;
      qryParcelas.FieldByName('ValorPagto').AsCurrency  := qryParcelas.FieldByName('ValorPagto').AsCurrency - SaldoDiferenca;
    end;
  end;
end;

function TRecebimentos.CalculoDescontoJurosQuitacaoDiversas: Currency;
begin
    Result:= Truncar((qryParcelas.FieldByName('ValorDevido').AsCurrency * FValorRecebido)/FValorDevido,2);
end;

procedure TRecebimentos.AtualizarValorDevido;
Var ValorDevidoAnt: Currency;
begin
  qryParcelas.First;
  while not qryParcelas.Eof do
  begin
    if qryParcelas.FieldByName('selecionado').AsBoolean then
    begin
      if not (qryParcelas.State = dsedit) then
        qryParcelas.Edit;
      ValorDevidoAnt := qryParcelas.FieldByName('ValorDevido').AsCurrency;
      qryParcelas.FieldByName('ValorDevido').AsCurrency:= CalculoDescontoJurosQuitacaoDiversas;
      qryParcelas.Post;
    end;
    qryParcelas.Next;
  end;
  FValorDevido:= CalcularTotal('ValorDevido');
end;

function TRecebimentos.CalcularTotal(Campo: String): Currency;
begin
  Result:= 0;
  qryParcelas.First;
  while not qryParcelas.Eof do
  begin
    if qryParcelas.FieldByName('selecionado').AsBoolean then
      Result:= Result + qryParcelas.FieldByName(Campo).AsCurrency;
    qryParcelas.Next;
  end;
end;

function TRecebimentos.CalculoValorCorrecaoParcelaQuitacaoDiversas(ValorAnterior: Currency): Currency;
begin
  Result:= Truncar((qryParcelas.FieldByName('correcao').AsCurrency * qryParcelas.FieldByName('ValorDevido').AsCurrency)/ValorAnterior,2);
end;

function TRecebimentos.CalculoValorJurosParcelaQuitacaoDiversas(ValorAnterior: Currency): Currency;
begin
  Result:= Truncar((qryParcelas.FieldByName('juros').AsCurrency * qryParcelas.FieldByName('ValorDevido').AsCurrency)/ValorAnterior,2);
end;

procedure TRecebimentos.AlterarValorDevidoParcela;
Var ValorDevidoParcela: Currency;
begin
  FValorDevido:= CalcularTotal('ValorDevido');
  qryParcelas.First;
  while not qryParcelas.Eof do
  begin
    if qryParcelas.FieldByName('selecionado').AsBoolean then
    begin
      if not (qryParcelas.State = dsedit) then
        qryParcelas.Edit;
      ValorDevidoParcela := (FValorRecebido * qryParcelas.FieldByName('ValorDevido').AsCurrency)/FValorDevido;
      qryParcelas.FieldByName('ValorDevido').AsCurrency:= ValorDevidoParcela;
      qryParcelas.Post;
    end;
    qryParcelas.Next;
  end;
