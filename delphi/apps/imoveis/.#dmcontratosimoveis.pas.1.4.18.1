function TdtmContratosImoveis.MaiordataPagamento: Variant;
var data: TDateTime;
begin
  data:= 0;
  GuardarRegistroAtual(qryParcelasContrato, True);
  qryParcelasContrato.First;
  while not qryParcelasContrato.Eof do
  begin
    if data < qryParcelasContratodatapagto.AsDateTime then
      data:= qryParcelasContratodatapagto.AsVariant;
    qryParcelasContrato.Next;
  end;
  VoltarRegistroAtual(qryParcelasContrato);
  if Data < dtmContratosImoveis.qryContratosdata.AsDateTime then
    data:= dtmContratosImoveis.qryContratosdata.AsDateTime
  else if data < dtmContratosImoveis.qryContratosdatachaves.AsDateTime then
    data:= dtmContratosImoveis.qryContratosdatachaves.AsDateTime
  else if data < dtmContratosImoveis.qryContratoshabite_se.AsDateTime then
    data:= dtmContratosImoveis.qryContratoshabite_se.AsDateTime;
  Result:= DataAtual - data;
end;

