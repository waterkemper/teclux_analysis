procedure TdtmContratosImoveis.SetReadOnly(const Value: Boolean);
begin
  fReadOnly := Value;
  qryContratos.ReadOnly       := Value;
  qryImoveisVendidos.ReadOnly := Value;
  qryCompradores.ReadOnly     := Value;
  qryParcelasContrato.ReadOnly := Value;

  {situação qdo transferido e ainda não salvo}
  if qryCompradores.ReadOnly then
     qryCompradores.ReadOnly := not ((qryContratos.Recno = 2) and (SituacaoContrato = sciTRANSFERENCIA));

  {situação qdo contrato é aberto}
  if qryParcelasContrato.ReadOnly then
    qryParcelasContrato.ReadOnly := not (qryContratoscontratoatual.AsBoolean and not (SituacaoContrato in [sciCANCELADO,sciRESCINDIDO]));

  {situação qdo renegociado/transferido e ainda não salvo}
  if qryParcelasContrato.ReadOnly then
    qryParcelasContrato.ReadOnly :=  not ((qryContratos.Recno = 2) and (SituacaoContrato in [sciTRANSFERENCIA, sciRENEGOCIACAO]));


end;

procedure TdtmContratosImoveis.SetSituacaoContrato(const Value: TtecSituacaoContratoImoveis);
begin
  if SituacaoContrato <> Value then
  begin
    SituacaoAnt:= SituacaoContrato;
//    if SituacaoAnt = sciVendido then
//      ReadOnly := False;
    if qryContratos.State = dsbrowse then
      qryContratos.Edit;
    case Value of
      sciRESERVADO    : qryContratossituacao.AsString := 'R';
      sciCANCELADO    : qryContratossituacao.AsString := 'C';
      sciVENDIDO      : qryContratossituacao.AsString := 'V';
      sciQUITADO      : qryContratossituacao.AsString := 'Q';
      sciRESCINDIDO   : qryContratossituacao.AsString := 'S';
      sciRENEGOCIADO  : qryContratossituacao.AsString := 'G';
      sciRENEGOCIACAO : qryContratossituacao.AsString := 'D';
      sciTRANSFERIDO  : qryContratossituacao.AsString := 'T';
      sciTRANSFERENCIA : qryContratossituacao.AsString := 'F';
    end;
  end;

  if (Value in [sciRENEGOCIADO, sciTRANSFERIDO]) then
    qryContratosnomesituacao.AsString:= vstrSituacaoContratoImoveis[SituacaoContrato]+' PARA Nº '+qryContratoscontrato_gerado.AsString
