function TdtmContratosImoveis.AtribuirImoveis_NovoContrato(NovoContrato, ContratoOrigem: Integer): Boolean;
var Imoveis : T_ImoveisVendidos;
    a, i: Integer;
begin
  a:= 0;
  ReadOnlyContrato(false);
  RefazConsultaPorNome(qryImoveisVendidos,['Contrato'], [ContratoOrigem]);
  SetLength(Imoveis, qryImoveisVendidos.RecordCount);
  qryImoveisVendidos.First;
  while not qryImoveisVendidos.Eof do
  begin
    Imoveis[a].Contrato        := NovoContrato;
    Imoveis[a].Emp             := qryImoveisVendidoscodigoempreendimento.AsInteger;
    Imoveis[a].NomeEmp         := qryImoveisVendidosempreendimento.AsString;
    Imoveis[a].Bloco           := qryImoveisVendidosbloco.AsInteger;
    Imoveis[a].NomeBloco       := qryImoveisVendidosnomebloco.AsString;
    Imoveis[a].Numero          := qryImoveisVendidosnumero.AsString;
    Imoveis[a].unidade         := qryImoveisVendidosunidade.AsInteger;
    Imoveis[a].NomeUnidade     := qryImoveisVendidostipounidade.AsString;
    Imoveis[a].Obs             := qryImoveisVendidosobservacoes.AsString;
    Imoveis[a].Preco           := qryImoveisVendidosPreco.AsCurrency;
    Imoveis[a].PrecoVenda      := qryImoveisVendidosPrecoVenda.AsCurrency;
    Imoveis[a].pavimento       := qryImoveisVendidospavimento.AsString;
    Imoveis[a].situacao        := qryImoveisVendidossituacao.AsString;
    Imoveis[a].areaprivativa   := qryImoveisVendidosareaprivativa.AsCurrency;
    Imoveis[a].areacomum       := qryImoveisVendidosareacomum.AsCurrency;
    Imoveis[a].areatotal       := qryImoveisVendidosareatotal.AsCurrency;
    Imoveis[a].fracaoideal     := qryImoveisVendidosfracaoideal.AsCurrency;
    Imoveis[a].datahabitese    := qryImoveisVendidosdatahabitese.AsDateTime;
    Imoveis[a].codigo          := qryImoveisVendidoscodigo.AsInteger;
    Imoveis[a].nome            := qryImoveisVendidosnome.AsString;
    Imoveis[a].contavenda      := qryImoveisVendidoscontavenda.AsInteger;
    Imoveis[a].contacofins     := qryImoveisVendidoscontacofins.AsInteger;
    Imoveis[a].contacsll       := qryImoveisVendidoscontacsll.AsInteger;
    Imoveis[a].contairpj       := qryImoveisVendidoscontairpj.AsInteger;
    Imoveis[a].contapis        := qryImoveisVendidoscontapis.AsInteger;
    Imoveis[a].debitocustos    := qryImoveisVendidosdebitocustos.AsInteger;
    Imoveis[a].creditovendachaves            := qryImoveisVendidoscreditovendachaves.AsInteger;
    Imoveis[a].debitocustochaves             := qryImoveisVendidosdebitocustochaves.AsInteger;
    Imoveis[a].creditoatualizacaomonetaria   := qryImoveisVendidoscreditoatualizacaomonetaria.AsInteger;
    Inc(a);
    qryImoveisVendidos.Next;
  end;
  qryImoveisVendidos.Close;
  qryImoveisVendidos.ParamByName('Contrato').Clear;
  qryImoveisVendidos.Open;

  qryImoveisVendidos.AfterInsert := nil;

  for i:=0 to a-1 do
  begin
    qryImoveisVendidos.Append;
    qryImoveisVendidoscodigoempreendimento.AsInteger       := Imoveis[i].Emp;
    qryImoveisVendidosempreendimento.AsString          	   := Imoveis[i].NomeEmp;
    qryImoveisVendidosbloco.AsInteger             	   := Imoveis[i].Bloco;
    qryImoveisVendidosnomebloco.AsString         	   := Imoveis[i].NomeBloco;
    qryImoveisVendidosnumero.AsString           	   := Imoveis[i].Numero;
    qryImoveisVendidosunidade.AsInteger         	   := Imoveis[i].unidade;
    qryImoveisVendidostipounidade.AsString      	   := Imoveis[i].Nomeunidade;
    qryImoveisVendidosobservacoes.AsString                 := Imoveis[i].Obs;
    qryImoveisVendidosPrecoVenda.AsCurrency     	   := Imoveis[i].PrecoVenda;
    qryImoveisVendidosPreco.AsCurrency            	   := Imoveis[i].Preco;
    qryImoveisVendidospavimento.AsString        	   := Imoveis[i].pavimento;
    qryImoveisVendidossituacao.AsString         	   := Imoveis[i].situacao;
    qryImoveisVendidosareaprivativa.AsCurrency     	   := Imoveis[i].areaprivativa;
    qryImoveisVendidosareacomum.AsCurrency         	   := Imoveis[i].areacomum;
    qryImoveisVendidosareatotal.AsCurrency         	   := Imoveis[i].areatotal;
    qryImoveisVendidosfracaoideal.AsCurrency           	   := Imoveis[i].fracaoideal;
    qryImoveisVendidosdatahabitese.AsDateTime      	   := Imoveis[i].datahabitese;
    qryImoveisVendidoscodigo.AsInteger            	   := Imoveis[i].codigo;
    qryImoveisVendidosnome.AsString             	   := Imoveis[i].nome;
    qryImoveisVendidoscontavenda.AsInteger       	   := Imoveis[i].contavenda;
    qryImoveisVendidoscontacofins.AsInteger       	   := Imoveis[i].contacofins;
    qryImoveisVendidoscontacsll.AsInteger          	   := Imoveis[i].contacsll;
    qryImoveisVendidoscontairpj.AsInteger        	   := Imoveis[i].contairpj;
    qryImoveisVendidoscontapis.AsInteger                   := Imoveis[i].contapis;
    qryImoveisVendidosdebitocustos.AsInteger       	   := Imoveis[i].debitocustos;
    qryImoveisVendidoscreditovendachaves.AsInteger         := Imoveis[i].creditovendachaves;
    qryImoveisVendidosdebitocustochaves.AsInteger          := Imoveis[i].debitocustochaves;
    qryImoveisVendidoscreditoatualizacaomonetaria.AsInteger:= Imoveis[i].creditoatualizacaomonetaria;
    qryImoveisVendidos.Post;
  end;

  qryImoveisVendidos.AfterInsert := qryImoveisVendidosAfterInsert;

  ReadOnlyContrato();
end;

procedure TdtmContratosImoveis.AlteracoesContrato(Excluido, GravarLancamentos: Boolean);
begin
  if Excluido then
  begin
    if ParSistema.GerarContabilidade then
    begin
//      if ReadOnly then
//        ReadOnly:= False;
      ReadOnlyContrato(false);
      Perpetrar([qryContratos, qryParcelasContrato, qryImoveis, qryImoveisVendidos]);
      if GravarLancamentos then
        Perpetrar([dtmLancamentoContabilidade.qrylancamentosDocumentos]);
      ReadOnlyContrato
//      if (SituacaoContrato in [sciVENDIDO,sciQUITADO, sciRENEGOCIADO, sciTRANSFERIDO, sciRESCINDIDO]) then
//        ReadOnly := True;
    end
    else
      Perpetrar([qryContratos, qryParcelasContrato, qryImoveis, qryImoveisVendidos]);

    RefazConsultaPorNome(qryContratos,['Contrato'],[qryContratosContrato.AsString]);
  end;
end;

