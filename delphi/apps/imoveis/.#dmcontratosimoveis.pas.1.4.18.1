  qryParcelas.Post;
end;

procedure TRecebimentos.ParcelaPagaMenor(ValorAnterior: Real; Editar: Boolean);
Var Multa, JurosMora, Devido, Partida, Historico,
    CorrContrato, JurosContrato, ValorContratadoAteHabiteSe: Real;
begin
  if FLiberarJuroseMulta then
    Devido := FValorRecebido
  else
    Devido       := (FValorRecebido/(1+(CalcularTotalJuros(FVencimento,FPagamento, FTaxaJuros)+FMultaContrato)/100));
  Partida      := (Devido * FValorContratado)/FValorDevido;
  Historico    := (Devido * FValorHistorico)/FValorDevido;
  ValorContratadoAteHabiteSe:= SimpleRoundTo((Devido * dtmContratosImoveis.qryParcelasContratoValorContratadoAteHabiteSe.AsCurrency)
                                               / FValorDevido);
  CorrContrato := Devido - Partida;
  JurosContrato:= (Partida * FJurosContratuais)/FValorContratado;
  if FPagamento > FVencimento then
    if FValorMulta > 0 THEN
      Multa        := CalcularMultaParcela(Devido, FMultaContrato)
    ELSE
      Multa:= 0;
  JurosMora    :=(Devido * FValorJuros)/FValorDevido;

  FJurosContratuais  := SimpleRoundTo(JurosContrato);
  FCorrecao          := SimpleRoundTo(CorrContrato);
  FValorJuros        := SimpleRoundTo(JurosMora);
  FValorMulta        := SimpleRoundTo(Multa);
  FValorDevido       := SimpleRoundTo(Devido);
  FValorTotal        := SimpleRoundTo(FValorRecebido);
  FDiferenca         := SimpleRoundTo((FValorContratado - Partida));
  FDiferencaHistorico:= SimpleRoundTo((FValorHistorico - Historico));
  FValorContratado   := SimpleRoundTo(Partida);
  FValorHistorico    := SimpleRoundTo(Historico);
  fDiferencaAteHabiteSe := SimpleRoundTo(dtmContratosImoveis.qryParcelasContratoValorContratadoAteHabiteSe.AsCurrency -
                                 ValorContratadoAteHabiteSe);

  if Editar then
  begin
    EditarParcela;
    qryParcelas.FieldByName('valorcontratado').AsCurrency:= FValorContratado;
    qryParcelas.FieldByName('valorhistorico').AsCurrency := FValorHistorico;
    qryParcelas.FieldByName('ValorContratadoAteHabiteSe').AsCurrency := ValorContratadoAteHabiteSe;

    qryParcelas.Post;
  end;
end;

