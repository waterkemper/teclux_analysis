procedure TdtmContratosImoveis.GerarParcelas(Tipo, Moeda: String;
  NroParcelas, Intervalo: Integer; Vencimento, DataBase,
  DataJuros: TDateTime; TaxaJuros, ValorParcela: Currency;
  JurosCompostos : Boolean);
var TotalParcelas, ValorContrato, ValorHistorico: Currency;
    I: Integer;
    Resultado: Boolean;
begin
  if ((NroParcelas > 0) and (ValorParcela > 0))  then
  begin
    ValorContrato:= qryContratosvalortotal.AsCurrency;
    if not qryParcelasContrato.IsEmpty then
      DeletarParcelar(Tipo);
    if qryParcelasContrato.State = dsinactive then
      qryParcelasContrato.Open;

    TotalParcelas:= 0;
      if (SituacaoContrato in [sciRENEGOCIACAO, sciTRANSFERENCIA]) then
        Resultado:= True
      else
        if ((NroParcelas * ValorParcela)+TotalizarParcelas) <= ValorContrato then
          Resultado:= True
        else
          Resultado:= False;
      if Resultado then
      begin
      try
        qryParcelasContrato.DisableControls;
        For I:= 0 to NroParcelas -1 do
        begin
          TotalParcelas:= TotalParcelas + ValorParcela;
          qryParcelasContrato.Append;
          qryParcelasContratodatavencto.AsDateTime:= SomarDia(Vencimento,(I * Intervalo),'S');
          qryParcelasContratotipo.AsString:= Tipo;
          qryParcelasContratonumero.AsInteger:= I+1;
          qryParcelasContratonrpagto.AsInteger:= 1;
          qryParcelasContratojuroscompostos.AsBoolean:= JurosCompostos;
          qryParcelasContratoorigem.AsString:= preencheString(inttostr(I+1),'0',3,False)+'/'+preencheString(IntToStr(NroParcelas),'0',3,False);
          if (SituacaoContrato in [sciRENEGOCIACAO, sciTRANSFERENCIA]) then
            qryParcelasContratovalorhistorico.Clear
          else
            qryParcelasContratovalorhistorico.AsCurrency:= ValorParcela;
          qryParcelasContratovalorcontratado.AsCurrency:= ValorParcela;
          if DataBase > 0 then
            qryParcelasContratodatabase.AsDateTime:= DataBase;
          if TaxaJuros > 0 then
            qryParcelasContratotaxajuros.AsCurrency:= TaxaJuros;
          if Moeda <> '' then
            qryParcelasContratomoeda.AsString:= Moeda;

          qryParcelasContrato.Post;
        end;
      finally
        qryParcelasContrato.EnableControls;
      end;
        TotaldeParcelas:= TotalizarParcelas;
        Diferenca:= ValorContrato - TotaldeParcelas;
        qryParcelasContrato.First;
        EditarContrato;
      end
      else
      begin
        DeletarParcelar(Tipo);
        MensagemAviso('O Valor das parcelas excede o valor do contrato.');
      end;
  end
  else
    MensagemAviso('O Número de parcelas ou o valor das parcelas deve ser maior do que zero.');
end;

function TdtmContratosImoveis.DeletarParcelar(Tipo: String): Boolean;
begin
  qryParcelasContrato.DisableControls;
  qryParcelasContrato.First;
  while not qryParcelasContrato.Eof do
  begin
    if (qryParcelasContratotipo.AsString = Tipo) and
       (qryParcelasContratodatapagto.AsString = '') then
      qryParcelasContrato.Delete
    else
      qryParcelasContrato.Next;
  end;
  qryParcelasContrato.EnableControls;
  Result:= true;
end;

function TdtmContratosImoveis.TotalizarParcelas: Currency;
begin
  Result:= 0;
  qryParcelasContrato.DisableControls;
  qryParcelasContrato.First;
  while not qryParcelasContrato.Eof do
  begin
    Result:= Result + qryParcelasContratovalorhistorico.AsCurrency;
    qryParcelasContrato.Next
  end;
  qryParcelasContrato.EnableControls;
  qryParcelasContrato.First;
end;

function TdtmContratosImoveis.ExcluirParcelasContrato(Todos: Boolean): Boolean;
begin
  if Todos then
    DeletarParcelar(qryParcelasContratotipo.AsString)
  else
  begin
    qryParcelasContrato.Delete;
    ReordenarParcelas(qryParcelasContratotipo.AsString);
  end;
  TotaldeParcelas:= TotalizarParcelas;
  Diferenca:= qryContratosvalortotal.AsCurrency - TotaldeParcelas;
  qryParcelasContrato.First;
  Result:= True;
end;

procedure TdtmContratosImoveis.ReordenarParcelas(Tipo: String);
var i, NrParcelas: Integer;
    pos: TBookmark;
begin
  i:= 0;
  Pos:= qryParcelasContrato.GetBookmark;
  qryParcelasContrato.DisableControls;
  qryParcelasContrato.SortByField('tipo,numero,datavencto');
  qryParcelasContrato.First;
  while not qryParcelasContrato.Eof do
  begin
    if  qryParcelasContratotipo.AsString = Tipo then
      Inc(i);
    qryParcelasContrato.Next;
  end;
  NrParcelas:= i;
  qryParcelasContrato.First;
  i:=1;
  while not qryParcelasContrato.Eof do
  begin
    if qryParcelasContratotipo.AsString = tipo then
    begin
      qryParcelasContrato.Edit;
      qryParcelasContratonumero.AsInteger:= i;
      qryParcelasContratoorigem.AsString:= preencheString(inttostr(i),'0',3,False)+'/'+preencheString(inttostr(NrParcelas),'0',3,False);
      qryParcelasContrato.AfterPost := nil;
      qryParcelasContrato.Post;
      qryParcelasContrato.AfterPost:= qryParcelasContratoAfterPost;
      inc(i)
    end;
    qryParcelasContrato.Next;
  end;
  qryParcelasContrato.GotoBookmark(Pos);
  qryParcelasContrato.FreeBookmark(Pos);
  qryParcelasContrato.EnableControls;
end;


function TdtmContratosImoveis.GetPrecisaReCalcularParcelas: Boolean;
begin
  TotaldeParcelas:= TotalizarParcelas;
  Diferenca:= qryContratosvalortotal.AsCurrency - TotaldeParcelas;
  Result:= Diferenca <> 0;
end;

function TdtmContratosImoveis.GravarContrato: Boolean;
begin
  Result:= true;

  if GravarParcelas then
  begin
    if not (SituacaoContrato in [sciRENEGOCIACAO, sciTRANSFERENCIA]) then
    Begin
      if  PrecisaReCalcularParcelas then
      begin
        MensagemAviso(Format(ctSOMATORIODIFERENTESTOTAL,['as parcelas',
                                                         FormatFloat('###,###,###,##0.00',TotaldeParcelas),
                                                         'o contrato',
                                                         FormatFloat('###,###,###,##0.00',qryContratosvalortotal.AsCurrency),
                                                         FormatFloat('###,###,###,##0.00',Diferenca)]));
        Result:= False
      end
    end
    else
    begin
      if GetTotalContratado <> FSaldoDevedor then
        result :=  MensagemConfirmacao(Format('O somatório das parcelas R$ %s é diferente do saldo devedor do contrato anterior R$ %s',
                                     [FormatFloat('###,###,###,##0.00',GetTotalContratado),
                                     FormatFloat('###,###,###,##0.00',FSaldoDevedor)])) = smbOk
      else
       result := MensagemConfirmacao('Confirma a gravação do novo contrato?') = smbOK;

      if result then
      begin
        AtualizarValorContrato;
        AtualizarValorHistoricoParcelas;
      end;
    end;
  end
  else
    Result:= True;

  if Result then
    if (qryContratosvendedor.AsInteger > 0) and
        (qryContratosdata.AsDateTime > 0) and
        (qryContratosvalortotal.AsFloat > 0) then
      Result:= true
    else
    begin
      Result:= False;
      MensagemAviso(ctVALIDARCONTROLES);
    end;

  if Result then
  begin
    if qryContratosdatachaves.AsDateTime > 0 then
    begin
      if (qryContratosdatachaves.AsDateTime >= qryContratoshabite_se.AsDateTime) then
        Result:= true
      else
      begin
        if MensagemConfirmacao('A data de entrega das chaves é anterior a data do habite-se'+#10#13+
                               'Confirma?') = smbOK THEN
          result:= true
        else
          result:= false;
      end;
    end;
  end;

  if result then
    if qryCompradores.IsEmpty then
    begin
      MensagemAviso('Contrato sem compradores cadastrados.');
      Result:= False;
    end
    else
    begin
      if ConfirmaPercentual <> 100 then
      begin
        MensagemAviso('A soma dos percentuais dos compradores difere de 100%.');
        Result:= False;
      end;
      if not ExistePrincipal then
      begin
        MensagemAviso('Deve ser definido um comprador principal para o contrato'+#10#13+
                      'ou o contrato possui mais de um comprador como principal.');
        Result:= False;
      end;
    end;

  If Result then
    If qryImoveisVendidos.IsEmpty then
    begin
      MensagemAviso('Contrato sem imóveis cadastrados.');
      Result:= False;
    end;

  if result then
    if qryParcelasContrato.IsEmpty then
    begin
      MensagemAviso('Contrato sem parcelas cadastradas.');
      Result:= False;
    end;

  if result then
  begin
    qrySituacaoImoveis.First;
    while not qrySituacaoImoveis.Eof do
    begin
      RefazConsultaPorNome(qryImoveis,['Bloco','Numero','Unidade'],[qrySituacaoImoveisbloco.asinteger, qrySituacaoImoveisnumero.AsString, qrySituacaoImoveisunidade.AsInteger]);
      qryImoveis.Edit;
      qryImoveissituacao.AsString:= qrySituacaoImoveissituacao.AsString;
      qryImoveis.Post;
      perpetrar([qryImoveis], False);

      qrySituacaoImoveis.Next;
    end;
  end;

  if result then
  begin
    RefazConsultaPorNome(qrycontratoorigem,['contrato_origem'],[qryContratoscontrato_origem.AsVariant]);
    if (qrycontratoorigem.RecordCount<>0) and
       (qryContratosdata.AsDateTime <> qryContratoOrigemdataalteracao.AsDateTime) then
    begin
      qryContratoOrigem.Edit;
      qryContratoOrigemdataalteracao.AsDateTime := qryContratosdata.AsDateTime;
      qryContratoOrigem.Post;
    end;
  end;

//  ReadOnly := false;
  ReadOnlyContrato(false);

  if not(dtmContratosImoveis.SituacaoContrato in [sciVENDIDO,sciQUITADO, sciRENEGOCIADO, sciTRANSFERIDO, sciRESCINDIDO]) then
  begin
    if result then
    begin
      if (qryContratos.State = dsInsert) and
          not(SituacaoContrato IN [sciTRANSFERENCIA, sciRENEGOCIACAO]) then
      begin
        qryContratos.Edit;
        if SituacaoContrato = sciRESERVADO then
          qryContratosnomesituacao.AsString:= 'RESERVADO';
        qryContratoscontrato.AsInteger:= NovaSequenciaContratos;
        qryContratos.Post;
        qryContratossituacao.AsString:= 'R';
      end;

      qryImoveisVendidos.DisableControls;
      qryImoveisVendidos.First;
      while not qryImoveisVendidos.Eof do
      begin
        if qryImoveisVendidoscontrato.AsInteger <> qryContratoscontrato.AsVariant then
        begin
          qryImoveisVendidos.Edit;
          qryImoveisVendidoscontrato.AsInteger:= qryContratoscontrato.AsVariant;
          qryImoveisVendidos.Post;
        end;
        qryImoveisVendidos.Next;
      end;
      qryImoveisVendidos.EnableControls;
      qryImoveisVendidos.First;

      qryCompradores.DisableControls;
      qryCompradores.First;
      while not qryCompradores.Eof do
      begin
        if qryCompradorescontrato.AsInteger <> qryContratoscontrato.AsVariant then
        begin
          qryCompradores.Edit;
          qryCompradorescontrato.AsInteger:= qryContratoscontrato.AsVariant;
          qryCompradores.Post;
        end;
        qryCompradores.Next;
      end;
      qryCompradores.EnableControls;
      qryCompradores.First;

      qryParcelasContrato.DisableControls;
      qryParcelasContrato.AfterPost:= nil;
      qryParcelasContrato.First;
      while not qryParcelasContrato.Eof do
      begin
        if qryParcelasContratocontrato.AsInteger <> qryContratoscontrato.AsVariant then
        begin
          qryParcelasContrato.Edit;
          qryParcelasContratocontrato.AsInteger:= qryContratoscontrato.AsVariant;
          qryParcelasContrato.AfterPost := nil;
          qryParcelasContrato.Post;
          qryParcelasContrato.AfterPost:= qryParcelasContratoAfterPost;
        end;
        qryParcelasContrato.Next;
      end;
      qryParcelasContrato.EnableControls;
      qryParcelasContrato.First;
      RefazConsultaPorNome(qryTotaisParcelas,['Contrato'],[qryContratoscontrato.AsVariant]);
      RefazConsultaPorNome(qryTotaisParcelasAberto,['Contrato'],[qryContratoscontrato.AsVariant]);
      qryParcelasContrato.AfterPost:= qryParcelasContratoAfterPost;
      Result:= True;
    end;

    if Result then
    begin
    {
      if SituacaoContrato = sciTRANSFERENCIA then
        AlterarEstadoImoveis(ctESTADOVENDIDO, True)
      else
        AlterarEstadoImoveis(ctESTADORESERVADO, True);
    }

      if not (SituacaoContrato in [sciNENHUM, sciRESERVADO]) and ParSistema.GerarContabilidade then
        Perpetrar([qryContratos, qryParcelasContrato, qryCompradores, qryImoveisVendidos, qryImoveis, dtmLancamentoContabilidade.qrylancamentosDocumentos, qryContratoOrigem])
      else
        Perpetrar([qryContratos, qryParcelasContrato, qryCompradores, qryImoveisVendidos, qryImoveis, qryContratoOrigem]);


        RefazConsultaPorNome(qryContratos,['Contrato'],[qryContratosContrato.AsString]);


      GravarParcelas:= False;
    end;
  end
  else
  begin
    if Result then
    begin
      if GravarParcelas then
      begin
//        qryContratos.ReadOnly:= False;
//        qryParcelasContrato.ReadOnly:= False;

        qryParcelasContrato.DisableControls;
        qryParcelasContrato.First;
        while not qryParcelasContrato.Eof do
        begin
          if qryParcelasContratocontrato.AsInteger <> qryContratoscontrato.AsVariant then
          begin
            qryParcelasContrato.Edit;
            qryParcelasContratocontrato.AsInteger:= qryContratoscontrato.AsVariant;
            qryParcelasContrato.Post;
          end;
          qryParcelasContrato.Next;
        end;
        qryParcelasContrato.EnableControls;
        qryParcelasContrato.First;
      end;

      if ParSistema.GerarContabilidade then
      begin
//        if ReadOnly then
//          ReadOnly:= False;

        if not (SituacaoContrato in [sciNENHUM, sciRESERVADO]) then
          Perpetrar([qryContratos, qryParcelasContrato, qryCOmpradores, qryImoveisVendidos, qryImoveis, dtmLancamentoContabilidade.qrylancamentosDocumentos, qryContratoOrigem])
        else
          Perpetrar([qryContratos, qryParcelasContrato, qryCOmpradores, qryImoveisVendidos, qryImoveis, qryContratoOrigem]);

        RefazConsultaPorNome(qryContratos,['Contrato'],[qryContratosContrato.AsString]);


//        if not (SituacaoContrato = sciRESERVADO) then
//          ReadOnly := True;
      end
      else
      begin
        Perpetrar([qryContratos, qryParcelasContrato, qryCompradores, qryImoveisVendidos, qryImoveis, qryContratoOrigem]);
        RefazConsultaPorNome(qryContratos,['Contrato'],[qryContratosContrato.AsString]);
      end
    end;
    GravarParcelas:= False;
  end;
end;

