procedure TdtmContratosImoveis.ReadOnlyContrato(Bloquear: Boolean = true);
var
 i: integer;
begin
  if not Bloquear then
    ReadOnly:= False
  else
  begin

    ReadOnly := not (SituacaoContrato  in [sciRESERVADO, sciNENHUM]);

    if ReadOnly then
    begin
      if (qryContratoscontratoatual.AsBoolean and
         not (SituacaoContrato  in [sciCANCELADO, sciRESCINDIDO])
                                                                                                                // SITUAÇÃO DAS DATAS
         and  ((qryContratosdata.AsDateTime > ParSistema.DataContabil) or                                       // CONTRATO
         (qryContratosdatachaves.IsNull or (qryContratosdatachaves.AsDateTime > ParSistema.DataContabil))))     // CHAVES
          {qdo rencegocidao/transferido: liberar os campos}
         or ((qrycontratos.Recno = 2) and (situacaoContrato in [sciTRANSFERENCIA, sciRENEGOCIACAO]))  then
      begin
         qrycontratos.ReadOnly := false;
         for i :=0 to qrycontratos.FieldCount-1 do
         begin
           if ((qrycontratos.Recno = 2) and (situacaoContrato in [sciTRANSFERENCIA, sciRENEGOCIACAO])) then
             qrycontratos.Fields[i].ReadOnly := false
           else
             qrycontratos.Fields[i].ReadOnly := not UsuarioLogin.AlterarDadosContabeis;
         end;

         if (qryContratosdata.AsDateTime > ParSistema.DataContabil) then
           qryContratosdata.ReadOnly := false
         else
           qryContratosdata.ReadOnly := true;

         if (qryContratosdatachaves.IsNull or
            (qryContratosdatachaves.AsDateTime > ParSistema.DataContabil)) then
           qryContratosdatachaves.ReadOnly := false
         else
           qryContratosdatachaves.ReadOnly := true;


      end;
    end
    else
    begin
      for i :=0 to qrycontratos.FieldCount-1 do
        qrycontratos.Fields[i].ReadOnly := false;
    end;
  end;
end;


