function TdtmContratosImoveis.GetProximoNrLancto: integer;
begin
  if FProximoNrLancto=0 then
  begin
    if NrOrigem = 'H' then
      spcLancamentosProximo.ParamByName('Exercicio').AsInteger:= yearof(qryContratosdatachaves.AsDateTime)
    else if NrOrigem = 'T' then
      spcLancamentosProximo.ParamByName('Exercicio').AsInteger:= yearof(VarRecebimentos.Pagamento)
    else if NrOrigem = 'G' then
    begin
      if OperacaoRescisao <> '' then
        spcLancamentosProximo.ParamByName('Exercicio').AsInteger:= yearof(FDataAlteracao)
      else IF (OperacaoTransferencia or OperacaoRenegociacao) then
        spcLancamentosProximo.ParamByName('Exercicio').AsInteger:= yearof(qryContratosdata.AsDateTime);
    end
    else
      spcLancamentosProximo.ParamByName('Exercicio').AsInteger:= yearof(qryContratosdata.AsDateTime);

    spcLancamentosProximo.ParamByName('Filial').AsInteger:= FilialBase;
    spcLancamentosProximo.Open;
    FProximoNrLancto := spcLancamentosProximocodigo.AsInteger;
    spcLancamentosProximo.Close;
  end
  else
   FProximoNrLancto := FProximoNrLancto + 1;
  Result := FProximoNrLancto;
end;

