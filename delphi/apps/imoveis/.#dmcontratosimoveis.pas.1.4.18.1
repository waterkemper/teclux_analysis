procedure TdtmContratosImoveis.AtualizarSituacaoImovel(HeExclusao: boolean);
begin
  if HeExclusao then
  begin
    if qrySituacaoImoveis.Locate('bloco;numero;unidade', VarArrayof([qryImoveisVendidosbloco.AsInteger,qryImoveisVendidosnumero.AsString, qryImoveisVendidosunidade.asinteger]),[]) then
      qrySituacaoImoveis.edit
    else
      qrySituacaoImoveis.Append;

    qrySituacaoImoveisbloco.AsInteger := qryImoveisVendidosbloco.AsInteger;
    qrySituacaoImoveisnumero.AsString := qryImoveisVendidosnumero.AsString;
    qrySituacaoImoveisunidade.AsInteger := qryImoveisVendidosunidade.AsInteger;

    qrySituacaoImoveissituacao.AsString := 'D';
    qrySituacaoImoveis.post;

    if not qryImoveisVendidosblocoanterior.IsNull and not qryImoveisVendidosnumeroanterior.IsNull and not qryImoveisVendidosunidadeanterior.IsNull then
      if (qryImoveisVendidosbloco.AsInteger <> qryImoveisVendidosblocoanterior.AsInteger) and
         (qryImoveisVendidosnumero.AsString <> qryImoveisVendidosnumeroanterior.AsString) and
         (qryImoveisVendidosunidade.AsInteger <> qryImoveisVendidosunidadeanterior.AsInteger) then
      begin
        if qrySituacaoImoveis.Locate('bloco;numero;unidade', VarArrayof([qryImoveisVendidosblocoanterior.AsInteger,
                                                                         qryImoveisVendidosnumeroanterior.AsString,
                                                                         qryImoveisVendidosunidadeanterior.AsInteger]),[]) then
          qrySituacaoImoveis.edit
        else
          qrySituacaoImoveis.Append;

        qrySituacaoImoveisbloco.AsInteger := qryImoveisVendidosblocoanterior.AsInteger;
        qrySituacaoImoveisnumero.AsString := qryImoveisVendidosnumeroanterior.AsString;
        qrySituacaoImoveisunidade.Asinteger := qryImoveisVendidosunidadeanterior.Asinteger;

        qrySituacaoImoveissituacao.AsString := 'D';
        qrySituacaoImoveis.post;
      end;
  end
  else
  begin
    if qrySituacaoImoveis.Locate('bloco;numero;unidade', VarArrayof([qryImoveisVendidosbloco.AsInteger,
                                                                     qryImoveisVendidosnumero.AsString,
                                                                     qryImoveisVendidosunidade.AsInteger]),[]) then
      qrySituacaoImoveis.edit
    else
      qrySituacaoImoveis.Append;

    qrySituacaoImoveisbloco.AsInteger := qryImoveisVendidosbloco.AsInteger;
    qrySituacaoImoveisnumero.AsString := qryImoveisVendidosnumero.AsString;
    qrySituacaoImoveisunidade.AsInteger := qryImoveisVendidosunidade.AsInteger;

    qrySituacaoImoveissituacao.AsString := ifthen(SituacaoContrato=sciRESERVADO, 'R','V');
    qrySituacaoImoveis.post;

    if not qryImoveisVendidosblocoanterior.IsNull and not qryImoveisVendidosnumeroanterior.IsNull and not qryImoveisVendidosunidadeanterior.IsNull then
      if (qryImoveisVendidosbloco.AsInteger <> qryImoveisVendidosblocoanterior.AsInteger) and
         (qryImoveisVendidosnumero.AsString <> qryImoveisVendidosnumeroanterior.AsString) and
         (qryImoveisVendidosunidade.AsInteger <> qryImoveisVendidosunidadeanterior.AsInteger)  then
      begin
        if qrySituacaoImoveis.Locate('bloco;numero;unidade', VarArrayof([qryImoveisVendidosblocoanterior.AsInteger,
                                                                         qryImoveisVendidosnumeroanterior.AsString,
                                                                         qryImoveisVendidosunidadeanterior.AsInteger]),[]) then
          qrySituacaoImoveis.edit
        else
          qrySituacaoImoveis.Append;

        qrySituacaoImoveisbloco.AsInteger := qryImoveisVendidosblocoanterior.AsInteger;
        qrySituacaoImoveisnumero.AsString := qryImoveisVendidosnumeroanterior.AsString;
        qrySituacaoImoveisunidade.AsInteger := qryImoveisVendidosunidadeanterior.AsInteger;

        qrySituacaoImoveissituacao.AsString := 'D';
        qrySituacaoImoveis.post;
      end;
  end;

end;

