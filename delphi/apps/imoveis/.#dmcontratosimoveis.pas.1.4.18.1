procedure TRecebimentos.GetDiferenca;
begin
  if FAlterandoParcelas then
    if FDiferenca > 0 then
      FValorJuros := FDiferenca
    else if FDiferenca < 0 then
      FValorDesconto := FDiferenca
  else
