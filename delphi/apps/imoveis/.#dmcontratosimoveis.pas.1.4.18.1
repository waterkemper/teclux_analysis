function TRecebimentos.GetNrOrigem: Int64;
var Contrato, Parcela, TipoStr, NrPagto : String;
    Evento, Tipo: Integer;
begin
  if dtmContratosImoveis.qryParcelasContratonumeroorigem.AsSTring <> '' then
    Result:= StrToInt64(dtmContratosImoveis.qryParcelasContratonumeroorigem.AsSTring)
  else
  begin
    case dtmContratosImoveis.FNrOrigem[1] of
      'V' : Evento:= 1;
      'H' : Evento:= 2;
      'A' : Evento:= 3;
      'T' : Evento:= 4;
    end;
    Contrato:= preencheString(qryParcelas.FieldByName('Contrato').AsString,'0',6,false)+inttostr(Evento);
    if Evento = 4 then
    begin
      Tipo   := ConverterTipoParcela(qryParcelas.FieldByName('tipo').AsString[1]);
      Parcela:= preencheString(qryParcelas.FieldByName('numero').AsString, '0',3,False);
      NrPagto:= preencheString(qryParcelas.FieldByName('nrpagto').AsString,'0',2,False);
      TipoStr:= preencheString(inttostr(Tipo),'0',2,False);
      Result := strtoint64(Contrato + TipoStr + Parcela + NrPagto);
    end;
  end;
end;

