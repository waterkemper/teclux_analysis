procedure TdtmContratosImoveis.SetarSituacaoContratoOrigem;
begin
  Contrato_Origem :=  qryContratoscontrato_origem.AsInteger;
  RefazConsultaPorNome(qryContratosOrigem, ['contratoorigem'],[Contrato_Origem]);
{
  Situações do contrato:
  'R',   -- [R]eservado
  'V',   -- [V]endido
  'C',   -- [C]ancelado
  'Q',   -- [Q]uitado

  'T',   -- [T]ransferido para
  'F',   -- trans[F]erido de

  'G',   -- Rene[G]ociado para
  'D',   -- Renegocia[D]o de

  'S')), -- Re[S]cindido
 }


  {A situacao do contrato dependerá da situação do seu anterior}
  if qryContratosOrigemsituacao_contrato_origem.AsString = 'T' then {'T',   -- [T]ransferido para}
  begin
    qryContratosOrigem.Edit;
    qryContratosOrigemsituacao.AsString := 'F';                     {'F',   -- trans[F]erido de}
    qryContratosOrigem.post;
  end
  else
  if qryContratosOrigemsituacao_contrato_origem.AsString = 'G' then {'G',   -- Rene[G]ociado para}
  begin
    qryContratosOrigem.Edit;
    qryContratosOrigemsituacao.AsString := 'D';                     {'D',   -- Renegocia[D]o de}
    qryContratosOrigem.post;
  end
  else
  begin
    qryContratosOrigem.Edit;
    qryContratosOrigemsituacao.AsString := 'V';                     {'V',   -- [V]endido}
    qryContratosOrigem.post;
  end;

end;

