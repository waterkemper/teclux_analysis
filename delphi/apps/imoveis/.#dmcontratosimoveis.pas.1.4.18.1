function TdtmContratosImoveis.GetSaldoDevedor: Currency;
begin
  FSaldoDevedor:= 0;
  FSaldoHistorico := 0;
  GuardarRegistroAtual(qryParcelasContrato, True);
  qryParcelasContrato.First;
  while not qryParcelasContrato.Eof do
  begin
    if qryParcelasContratodatapagto.IsNull then
    begin
      FSaldoDevedor    := FSaldoDevedor + qryParcelasContratovalordevido.AsCurrency;
      FSaldoHistorico  := FSaldoHistorico + qryParcelasContratovalorhistorico.AsCurrency;
    end;
    qryParcelasContrato.Next;
  end;
  VoltarRegistroAtual(qryParcelasContrato);

  if DataAlteracao <> DataAtual then
  begin
    RefazConsultaPorNome(qrySaldoDevedor,['contrato','data'],[qryContratoscontrato.asinteger,formatdatetime('yyyy-mm-dd',dataalteracao)]);
    FSaldoDevedor := qrySaldoDevedorvalor.AsCurrency;
  end;

  Result := FSaldoDevedor;

end;

