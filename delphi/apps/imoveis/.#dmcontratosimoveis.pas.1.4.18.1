procedure TdtmContratosImoveis.qryConsultarImoveisBeforeOpen(DataSet: TDataSet);
var Imoveis, MacroEmpreendimento, MacroImoveis: String;
    Pos: TBookmark;
begin
  inherited;
  Imoveis:= '';
  MacroEmpreendimento:= '';
  MacroImoveis:= '';
{  if Empreendimento <> '' then}
  if qryContratosempreendimento.AsInteger <> 0 then
    MacroEmpreendimento:= 'and e.codigo = '+{Empreendimento} qryContratosempreendimento.AsString ;
  if qryImoveisVendidos.RecordCount > 0 then
  begin
    qryImoveisVendidos.DisableControls;
    Pos:= qryImoveisVendidos.GetBookmark;
    qryImoveisVendidos.First;
    while not qryImoveisVendidos.Eof do
    begin
      Imoveis:= Imoveis + qryImoveisVendidosnumero.AsString+', ';
      qryImoveisVendidos.Next;
    end;
    Delete(Imoveis,length(Imoveis)-1,1);
    MacroImoveis:= ' and i.Numero not in ('+Imoveis+')';
    qryImoveisVendidos.GotoBookmark(Pos);
    qryImoveisVendidos.FreeBookmark(Pos);
    qryImoveisVendidos.EnableControls;
  end;
  if (MacroEmpreendimento <> '') or (MacroImoveis <> '') then
    qryConsultarImoveis.MacroByName('JaCadastrado').AsString:= MacroEmpreendimento + MacroImoveis;
end;


function TdtmContratosImoveis.AlterarEstadoImoveis(Estado: String; Todos: Boolean): Boolean;
begin

  if Todos then
  begin
    GuardarRegistroAtual(qryImoveisVendidos, True);
    qryImoveisVendidos.First;
    while not qryImoveisVendidos.Eof do
    begin
      RefazConsultaPorNome(qryImoveis,['Bloco','Numero','Unidade'],[qryImoveisVendidosbloco.AsVariant,
                                    qryImoveisVendidosnumero.AsVariant, qryImoveisVendidosunidade.AsVariant ]);
      qryImoveis.Edit;
      qryImoveissituacao.AsString:= Estado;
      qryImoveis.Post;
      perpetrar([qryImoveis], False);
      qryImoveisVendidos.Next;
    end;
    VoltarRegistroAtual(qryImoveisVendidos);
  end
  else
  begin
    RefazConsultaPorNome(qryImoveis,['Bloco','Numero','Unidade'],[qryImoveisVendidosbloco.AsVariant,
                           qryImoveisVendidosnumero.AsVariant, qryImoveisVendidosunidade.AsVariant]);
    qryImoveis.Edit;
    qryImoveissituacao.AsString:= Estado;
    qryImoveis.Post;
    perpetrar([qryImoveis], False);
  end;

end;

procedure TdtmContratosImoveis.qryContratosAfterScroll(DataSet: TDataSet);
begin
  inherited;
  FValorAtualizacaoMonetariaEntregaChaves := 0;
  FValorDescontoCorrecao := 0;
  fValorDescontoPrincipal := 0;

{  Empreendimento:= '';}
  if qryContratos.RecordCount > 0 then
  begin
    RefazConsultaPorNome(qryCompradores,['Contrato'],[qryContratoscontrato.AsVariant]);
    RefazConsultaPorNome(qryImoveisVendidos,['Contrato'],[qryContratoscontrato.AsVariant]);
    RefazConsultaPorNome(qryParcelasContrato,['Contrato'],[qryContratoscontrato.AsVariant]);
    RefazConsultaPorNome(qryTotaisParcelas,['Contrato'],[qryContratoscontrato.AsVariant]);
    RefazConsultaPorNome(qryTotaisParcelasAberto,['Contrato'],[qryContratoscontrato.AsVariant]);
    RefazConsultaPorNome(qryCompradores_Anteriores,['Contrato'],[qryContratoscontrato_origem.AsVariant]);
    if qryImoveisVendidos.RecordCount > 0 then
    begin
      if Assigned(FAtualizarDisplay) then
        FAtualizarDisplay(Self);
    end;
  end;

  ReadOnlyContrato;

  qryParametros.Open;
  if not (qryContratos.State = dsinsert) then
    if Assigned(FAfterOpenContratos) then
      FAfterOpenContratos(Dataset);
  FDataChavesAnt:= qryContratosdatachaves.AsDateTime;

  qrySituacaoImoveis.close;
  qrySituacaoImoveis.open;
  qrySituacaoImoveis.delete;

end;

