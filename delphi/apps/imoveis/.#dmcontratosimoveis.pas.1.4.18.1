function TdtmContratosImoveis.GetValorAtualizacaoMonetariaEntregaChaves: Currency;
var Contrato, MesInicio, MesFinal, ano , mes, mesinicial, anoinicial  : Integer;
    Datacorrecao, DataChaves : TDateTime;
    TotalDescontos: Currency;
begin
  if FValorAtualizacaoMonetariaEntregaChaves = 0 then
  begin
    Contrato := qryContratoscontrato.AsInteger;

    if qryContratosdatabasecorrecao.asdatetime  = 0 then
      Datacorrecao := qryContratosdata.AsDateTime
    else
      Datacorrecao := qryContratosdatabasecorrecao.AsDateTime;

    mesinicial := monthof(Datacorrecao)+1;
    anoinicial := yearof(Datacorrecao);

    if mesinicial > 12 then
    begin
      mesinicial := 1;
      inc(anoinicial);
    end;

    DataChaves   := qryContratosdatachaves.AsDateTime;

    for ano := anoinicial to YearOf(DataChaves) do
    begin
      if ano = anoinicial then
        mesinicio := mesinicial
      else
        mesinicio := 1;

      if ano = yearof(DataChaves) then
        mesfinal := monthof(DataChaves)
      else
        mesfinal := 12;

      for mes := MesInicio to MesFinal do
      begin
        RefazConsultaPorNome(qryCorrecaoMes,['Contrato', 'Exercicio', 'Mes'],
                         [contrato, ano, mes]);
        FValorAtualizacaoMonetariaEntregaChaves := FValorAtualizacaoMonetariaEntregaChaves + qryCorrecaoMesvalor.AsCurrency;
      end;
    end;
  end;
  
  result := FValorAtualizacaoMonetariaEntregaChaves;

end;

