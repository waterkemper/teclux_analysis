function TdtmContratosImoveis.GetCofinsRetidoChaves: Currency;
begin
  Result:= truncar(((GetValorContratoChaves - ValorDescontoPrincipal) * (ParSistema.CofinsBaseImoveis/100)*(ParSistema.CofinsAliquotaImoveis/100)),2);
end;

function TdtmContratosImoveis.GetCSLLRetidoChaves: Currency;
begin
  if qryContratoscsllhistorico.AsCurrency > 0 then
    Result:=  qryContratoscsllhistorico.AsCurrency +
             truncar((((ValorAtualizacaoMonetariaEntregaChaves - ValorDescontoPrincipal - ValorDescontoCorrecao) *
              (ParSistema.CSLLBaseImoveis/100))*(ParSistema.CSLLAliquotaImoveis/100)),2)
  else
    Result:=  truncar((((GetValorContratoChaves + ValorAtualizacaoMonetariaEntregaChaves - ValorDescontoPrincipal - ValorDescontoCorrecao) *
              (ParSistema.CSLLBaseImoveis/100))*(ParSistema.CSLLAliquotaImoveis/100)),2);
end;

function TdtmContratosImoveis.GetIRRetidoChaves: Currency;
begin

  if qrycontratosirpjhistorico.AsCurrency > 0 then
    Result:= qrycontratosirpjhistorico.AsCurrency +
             Truncar((((ValorAtualizacaoMonetariaEntregaChaves - ValorDescontoPrincipal - ValorDescontoCorrecao) *
              (ParSistema.IRBaseImoveis/100))*(ParSistema.IRAliquotaImoveis/100)),2)
  else
    Result:=  Truncar((((GetValorContratoChaves + ValorAtualizacaoMonetariaEntregaChaves - ValorDescontoPrincipal - ValorDescontoCorrecao) *
              (ParSistema.IRBaseImoveis/100))*(ParSistema.IRAliquotaImoveis/100)),2);


end;

function TdtmContratosImoveis.GetPISRetidoChaves: Currency;
begin
  Result:= truncar(((GetValorContratoChaves - ValorDescontoPrincipal) * (ParSistema.PISBaseImoveis/100)*(ParSistema.PISAliquotaImoveis/100)),2);
end;

