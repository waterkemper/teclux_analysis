function TRecebimentos.DescricaoParcelasPagas: String;
var Tipo, Parcela, Saida: String;
    Numero, a, i, g, Total: Integer;
    ArquivoParcelas: T_ParcelasPagas;
    SequenciaParcelas: T_SeqParcelas;
begin
  if dtmContratosImoveis.QuitarDiversas then
  begin
    a:= 0;
    i:= -1;
    Numero := 0;
    tipo:= '';
    Saida:= '';
    dtmContratosImoveis.GuardarRegistroAtual(qryParcelas, True);
    qryParcelas.First;
    SetLength(ArquivoParcelas, qryParcelas.RecordCount);
    while not qryParcelas.Eof do
    begin
      if qryParcelas.FieldByName('selecionado').AsBoolean then
      begin
        ArquivoParcelas[a].Tipo     := qryParcelas.FieldByName('tipo').AsString;
        ArquivoParcelas[a].Numero   := qryParcelas.FieldByName('numero').AsInteger;
        ArquivoParcelas[a].Origem   := qryParcelas.FieldByName('origem').AsString;
        ArquivoParcelas[a].Resultado:= qryParcelas.FieldByName('tipo').AsString + '-'+
                                       qryParcelas.FieldByName('origem').AsString;
        inc(a);
      end;

      qryParcelas.Next;
    end;
    dtmContratosImoveis.VoltarRegistroAtual(qryParcelas);
    Total:= a;
    SetLength(SequenciaParcelas,Total+1);
    for a:=0 to Total-1 do
    begin
      if Tipo <> ArquivoParcelas[a].Tipo then
      begin
        inc(i);
        Tipo:= ArquivoParcelas[a].Tipo;
        SequenciaParcelas[i].Tipo:= ArquivoParcelas[a].Tipo;
        SequenciaParcelas[i].NI  := ArquivoParcelas[a].Numero;
        SequenciaParcelas[i].OrI := ArquivoParcelas[a].Resultado;
        SequenciaParcelas[i].NF  := ArquivoParcelas[a].Numero;
        SequenciaParcelas[i].OrF := ArquivoParcelas[a].Resultado;
      end
      else
      begin
        if (ArquivoParcelas[a].Numero - SequenciaParcelas[i].NF) = 1 then
        begin
          SequenciaParcelas[i].NF  := ArquivoParcelas[a].Numero;
          SequenciaParcelas[i].OrF := ArquivoParcelas[a].Resultado;
          SequenciaParcelas[i].Seq := True;
        end
        else
        begin
          Inc(i);
          SequenciaParcelas[i].Tipo:= ArquivoParcelas[a].Tipo;
          SequenciaParcelas[i].NI  := ArquivoParcelas[a].Numero;
          SequenciaParcelas[i].OrI := ArquivoParcelas[a].Resultado;
          SequenciaParcelas[i].NF  := ArquivoParcelas[a].Numero;
          SequenciaParcelas[i].OrF := ArquivoParcelas[a].Resultado;
        end;
      end;
    end;
    g:= i;
    for a:=0 to g do
    begin
      if SequenciaParcelas[a].Seq = True then
        if g-1 = a then
          Saida:= Saida + SequenciaParcelas[a].Tipo+'-'+preencheString(inttostr(SequenciaParcelas[a].NI),'0',3,False)+' A '+SequenciaParcelas[a].OrF+' E '
        else
          Saida:= Saida + SequenciaParcelas[a].Tipo+'-'+preencheString(inttostr(SequenciaParcelas[a].NI),'0',3,False)+' A '+SequenciaParcelas[a].OrF+', '
      else
        if g-1 = a then
          Saida:= Saida + SequenciaParcelas[a].OrI+ ' E '
        else
          Saida:= Saida + SequenciaParcelas[a].OrI+ ', ';
      end;
    Delete(Saida,length(Trim(Saida)),1);
    FDescricaoParcelas:= 'NP '+Saida+' CT '+qryParcelas.FieldByName('contrato').AsString+ ' * '+qryParcelas.fieldByName('NomeCliente').AsString;
    Result:= Saida;
  end
  else
  Begin
    Result:= 'NP '+qryParcelas.FieldByName('tipo').AsString+'-'+qryParcelas.fieldByName('origem').AsString +
             ' CT '+qryParcelas.FieldByName('contrato').AsString+ ' - '+qryParcelas.fieldByName('NomeCliente').AsString;
    FDescricaoParcelas:= Result;
  end;
end;

procedure TRecebimentos.RecalcularValores;
begin
  if dtmContratosImoveis.QuitarDiversas then
  begin
    FValorDevido:= 0;
    FCorrecao:= 0;
    FCorrecaoContabil:= 0;
    FJurosContratuais:= 0;
    FValorJuros:= 0;
    FValorMulta:= 0;
    FValorTotal:= 0;
    FValorRecebido:= 0;
    with dtmContratosImoveis do
    begin
      GuardarRegistroAtual(qryParcelas,True);
      qryParcelas.First;
      while not qryParcelas.Eof do
      begin
        if qryParcelas.FieldByName('selecionado').AsBoolean then
        begin
          RefazConsultaPorNome(qryRecalcularParcelas,['Data','Contrato','Tipo','Numero','NrPagto'],
                                                     [FPagamento,
                                                      qryParcelas.FieldByName('contrato').AsVariant,
                                                      qryParcelas.FieldByName('tipo').AsVariant,
                                                      qryParcelas.FieldByName('numero').AsVariant,
                                                      qryParcelas.FieldByName('nrpagto').AsVariant]);
          FValorDevido := FValorDevido + qryRecalcularParcelasvalordevido.AsCurrency;
          qryParcelas.Edit;
          qryParcelas.FieldByName('valordevido').AsCurrency := qryRecalcularParcelasvalordevido.AsCurrency;
          qryParcelas.Post;
          FJurosContratuais:= FJurosContratuais + qryRecalcularParcelasjuros.AsCurrency;
          FCorrecaoContabil:= FCorrecaoContabil + qryRecalcularParcelascorrecao.AsCurrency;
          FCorrecao    := FCorrecao + (FValorDevido - FJurosContratuais - FValorContratado);
          FVencimento  := qryRecalcularParcelasdatavencto.AsDateTime;
          if FPagamento > FVencimento then
          begin
           FValorJuros:= FValorJuros + CalcularJurosParcela(FVencimento, FPagamento,FValorDevido, FTaxaJuros);
           FValorMulta:= FValorMulta + CalcularMultaParcela(FValorDevido, FTaxaJuros);
          end
          else
          begin
           FValorJuros:= FValorJuros +  0;
           FValorMulta:= FValorMulta + 0;
          end;
          FValorTotal:= FValorDevido + FValorJuros + FValorMulta;
          FValorRecebido:=  FValorTotal;
        end;
        qryParcelas.Next;
      end;
      VoltarRegistroAtual(qryParcelas);
    end;
  end
  else
  begin
    with dtmContratosImoveis do
    begin
      RefazConsultaPorNome(qryRecalcularParcelas,['Data','Contrato','Tipo','Numero','NrPagto'],
                                                 [FPagamento,FContrato, FTipo, FNumero, FNrpagto]);
      FValorDevido := qryRecalcularParcelasvalordevido.AsCurrency;
      FJurosContratuais:= qryRecalcularParcelasjuros.AsCurrency;
      FCorrecaoContabil:= qryRecalcularParcelascorrecao.AsCurrency;
      FCorrecao    := FValorDevido - FJurosContratuais - FValorContratado;
      if FPagamento > FVencimento then
        if not FLiberarJuroseMulta then
        begin
         FValorJuros:= CalcularJurosParcela(FVencimento, FPagamento,FValorDevido, FTaxaJuros);
         FValorMulta:= CalcularMultaParcela(FValorDevido, FTaxaJuros);
        end
        else
        begin
         FValorJuros:= 0;
         FValorMulta:= 0;
        end
      else
      begin
       FValorJuros:= 0;
       FValorMulta:= 0;
      end;
      FValorTotal:= FValorDevido + FValorJuros + FValorMulta;
      FValorRecebido:=  FValorTotal;
    end;
  end;
end;

procedure TRecebimentos.ParcelasRecibo(Recibo: Integer);
var i: Integer;
begin
  i:= 0;
  if FAlterandoParcelas then
  begin
    with dtmContratosImoveis do
    begin
      GuardarRegistroAtual(qryParcelas, True);
      qryParcelas.First;
      while not qryParcelas.Eof do
      begin
        if ((qryParcelas.FieldByName('recibopagto').AsInteger = Recibo) and
             (qryParcelas.FieldByName('recibopagto').AsInteger > 0))then
        begin
          if not (qryParcelas.State = dsedit) then
            qryParcelas.Edit;
          qryParcelas.FieldByName('selecionado').AsBoolean:= True;
          qryParcelas.Post;
          inc(i);
        end;
        qryParcelas.Next;
      end;
      VoltarRegistroAtual(qryParcelas);
      if i > 1 then
      begin
        FQuitarDiversas:= True;
        ValorParcelasSelecionadas;
        DescricaoParcelasPagas;
      end;
    end;
  end;
end;

