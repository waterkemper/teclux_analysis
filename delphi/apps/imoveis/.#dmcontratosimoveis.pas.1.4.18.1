procedure TdtmContratosImoveis.GerarNovoContrato(Contrato: Integer; Alteracao: String);
var Numero_Contrato, Novo_Numero, debitovenda, Vendedor, EmpContrato: Integer;
    situacao, observacoes, indexadoratehabitese, indexadoraposhabitese,
    tipoalteracao, datachaves : String;
    juroscompostos: Boolean;
    valortotal, juros, atrasomulta, atrasojuros, valor,
    saldovenda, saldocorrecao, custoimovel, despesavenda,
    pishistorico, cofinshistorico,irpjhistorico, csllhistorico: Currency;
    data, data_base, habite_se,  databasecorrecao, datachaves_contrato_origem: TDateTime;
begin
  ReadOnlyContrato(false);
  EditarContrato;
  Numero_Contrato       := qryContratoscontrato.AsInteger;
  data                  := qryContratosdata.AsDateTime;
  valortotal            := SaldoDevedor;
  situacao              := qryContratossituacao.AsString;
  vendedor              := qryContratosvendedor.AsInteger;
  observacoes           := qryContratosobservacoes.AsString;
  indexadoratehabitese  := qryContratosindexadoratehabitese.AsString;
  indexadoraposhabitese := qryContratosindexadoraposhabitese.AsString;
  data_base             := FDataAlteracao;
  juros                 := qryContratosjuros.AsCurrency;
  Empcontrato           := qryContratosempreendimento.AsInteger;
  juroscompostos        := qryContratosjuroscompostos.AsBoolean;
  atrasomulta           := qryContratosatrasomulta.AsCurrency;
  atrasojuros           := qryContratosatrasojuros.AsCurrency;
  habite_se             := qryContratoshabite_se.AsDateTime;
//  valor                 := qryContratosvalor.AsCurrency;
  datachaves            := qryContratosdatachaves.AsString;
  debitovenda           := qryContratosdebitovenda.AsInteger;

  pishistorico          := GetPISRetido;
  cofinshistorico       := GetCofinsRetido;
  irpjhistorico         := (GetIRRetido + GetValorTotalIRPJAtualizacoaoMonetaria);
  csllhistorico         := (GetCSLLRetido +  GetValorTotalCSLLAtualizacoaoMonetaria);

  if qryContratossaldovenda.AsCurrency = 0 then
    saldovenda          := qryContratosvalortotal.AsCurrency
  else
    saldovenda          := qryContratossaldovenda.AsCurrency;

  saldocorrecao         := GetValorSaldoCorrecao;
  databasecorrecao      := qryContratosdatabasecorrecao.AsDateTime;
  custoimovel           := qryContratoscustoimovel.AsCurrency;
  despesavenda          := qryContratosdespesavenda.AsCurrency;

  Novo_Numero:= NovaSequenciaContratos;
  qryContratoscontrato_gerado.AsInteger:= Novo_Numero;
  qryContratossituacao.AsString        := Alteracao;
  qryContratosdataalteracao.AsDateTime := FDataAlteracao;
  qryContratos.Post;

  RefazConsultaPorNome(qryTotaisParcelas,['Contrato'],[Numero_Contrato]);
  RefazConsultaPorNome(qryTotaisParcelasAberto,['Contrato'],[Numero_Contrato]);
  FTotalAmTransf      := GetTotalAMContrato;
  FTotalJuroeAmTransf := GetTotalJurosEAMContrato;

  if IncluirContrato then
  begin
    qryContratoscontrato.AsInteger:= Novo_Numero;
    qryContratosdata.AsDateTime:= FDataAlteracao;
    qryContratoscontrato_origem.AsInteger:= Numero_Contrato;
    if Alteracao = 'T' then
      SituacaoContrato:= sciTRANSFERENCIA
    else if Alteracao = 'G' then
      SituacaoContrato:= sciRENEGOCIACAO;
    qryContratosvendedor.AsInteger:= Vendedor;
    qryContratosvalortotal.AsCurrency:= valortotal;
    qryContratosobservacoes.AsString:= observacoes;
    if data_base > 0 then
      qryContratosdatabase.AsDateTime:= data_base
    else
        qryContratosdatabase.Clear;
    qryContratosjuros.AsCurrency:= juros;
    qryContratosatrasomulta.AsCurrency:= atrasomulta;
    qryContratosatrasojuros.AsCurrency:= atrasojuros;
    qryContratosindexadoratehabitese.AsString:= indexadoratehabitese;
    qryContratosindexadoraposhabitese.AsString:= indexadoraposhabitese;
//    qryContratosdebitovenda.AsInteger:= debitovenda;
    qryContratosjuroscompostos.AsBoolean:= juroscompostos;
    qryContratosempreendimento.AsInteger:= EmpContrato;
    if habite_se > 0 then
      qryContratoshabite_se.AsDateTime:= habite_se
    else
        qryContratoshabite_se.Clear;
    try
      dsrContratos.OnDataChange:= nil;
      if datachaves <> '' then
        qryContratosdatachaves.AsDateTime:= strtodate(datachaves)
      else
        qryContratosdatachaves.Clear;
    except
    end;
    dsrContratos.OnDataChange:= dsrContratosDataChange;
    if qryContratosdatachaves.AsDateTime = 0 then
    begin
      qryContratospishistorico.AsCurrency:= pishistorico;
      qryContratoscofinshistorico.AsCurrency:= cofinshistorico;
      qryContratosirpjhistorico.AsCurrency:= irpjhistorico;
      qryContratoscsllhistorico.AsCurrency:= csllhistorico;
      qryContratossaldovenda.AsCurrency:= saldovenda;
      qryContratossaldocorrecao.AsCurrency:= saldocorrecao;
      qryContratosdatabasecorrecao.AsCurrency:= databasecorrecao;
      qryContratoscustoimovel.AsCurrency:= custoimovel;
      qryContratosdespesavenda.AsCurrency:= despesavenda;
      qryContratosdatachaves_contrato_origem.AsDateTime := datachaves_contrato_origem;
//      qryContratosvalor.AsCurrency:= valor;
    end
    else
    begin
      qryContratospishistorico.Clear;
      qryContratoscofinshistorico.Clear;
      qryContratosirpjhistorico.Clear;
      qryContratoscsllhistorico.Clear;
      qryContratossaldovenda.Clear;
      qryContratossaldocorrecao.Clear;
      qryContratosdatabasecorrecao.Clear;
      qryContratoscustoimovel.Clear;
      qryContratosdespesavenda.Clear;
      qryContratosdatachaves_contrato_origem.clear;
//      qryContratosvalor.Clear;
    end;

    RefazConsultaPorNome(qryCompradores_Anteriores,['Contrato'],[Numero_Contrato]);
    if dtmContratosImoveis.SituacaoContrato =  sciRENEGOCIACAO then
      AtribuirCompradores_NovoContrato(Novo_Numero, Numero_Contrato);
    AtribuirImoveis_NovoContrato(Novo_Numero, Numero_Contrato);
  end;
  ReadOnlyContrato();

end;

