end;

function TRecebimentos.ValidarDatasPagamentos: boolean;
var tipoPArcela : String;
    numeroParcela, nrpagtoParcela : Integer;
begin
  Result:= True;
  dtmContratosImoveis.GuardarRegistroAtual(qryParcelas, True);
  qryParcelas.First;
  while not qryParcelas.Eof do
  begin
    if qryParcelas.FieldByName('selecionado').AsBoolean then
    begin
      if qryParcelas.FieldByName('nrpagto').asInteger > 1 then
      begin
        tipoPArcela:= qryParcelas.FieldByName('tipo').asString;
        numeroParcela:= qryParcelas.FieldByName('numero').asInteger;
        nrpagtoParcela:= (qryParcelas.FieldByName('nrpagto').asInteger-1);
        if  dtmContratosImoveis.qryParcelasContrato.Locate('tipo;numero;nrpagto',VarArrayOf([tipoPArcela,numeroParcela,nrpagtoParcela]),[]) then
          if dtmContratosImoveis.qryParcelasContratodatapagto.AsDateTime > FPagamento then
          begin
            Result:= False;
            break;
          end;
      end
    end;
    qryParcelas.Next;
  end;
  dtmContratosImoveis.voltarRegistroAtual(qryParcelas);
end;

