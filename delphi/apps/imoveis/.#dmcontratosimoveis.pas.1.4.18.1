  while not qryCompradores.Eof do
  begin
    if not (qryCompradorescliente.AsInteger = Cliente) then
    begin
      qryCompradores.Edit;
      qryCompradoresprincipal.AsBoolean:= False;
      qryCompradores.Post;
    end
    else
