  object qryLivroDiario: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'CondicoesImoveisDiarioAuxiliarDebito'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CondicoesImoveisDiarioAuxiliarCredito'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';SELECT * FROM'
      '('
      '   ('
      '     SELECT ld.Data,'
      '            ld.NrLancto,'
      '            ld.Filial,'
      '            ld.Historico,'
      '               COALESCE((SELECT  h.Descricao'
      '                           FROM  Historicos h'
      
        '                           WHERE h.Codigo = ld.Historico),'#39#39') ||' +
        ' '#39' '#39' ||'
      '                         COALESCE(ld.Complemento,'#39#39')'
      
        '                                  AS DescricaoHistoricoComplemen' +
        'to,'
      '            pl.Codigo,'
      '            pl.Descricao,'
      '            cast('#39'D'#39' as char(1)) as Tipo,'
      '            ld.Valor              AS Valor'
      ''
      
        '     FROM   PlanoContas pl JOIN Lancamentos ld ON pl.Codigo = ld' +
        '.Debitar'
      ''
      '     WHERE ld.Data BETWEEN :DataInicial AND :DataFinal'
      '       and ld.filial = :filial'
      ''
      '       %CondicoesImoveisDiarioAuxiliarDebito'
      ''
      
        '     ORDER BY ld.Data, ld.NrLancto, UPPER(TO_ASCII(pl.Descricao,' +
        #39'LATIN1'#39')), pl.Codigo'
      '    )'
      ''
      '    UNION ALL'
      ''
      '   ('
      '    SELECT lc.Data,'
      '           lc.NrLancto,'
      '           lc.Filial,'
      '           lc.Historico,'
      '              COALESCE((SELECT   h.Descricao'
      '                           FROM  Historicos h'
      
        '                           WHERE h.Codigo = lc.Historico),'#39#39') ||' +
        ' '#39' '#39' ||'
      '                        COALESCE(lc.Complemento,'#39#39')'
      
        '                                 AS DescricaoHistoricoComplement' +
        'o,'
      '           pl.Codigo,'
      '           pl.Descricao,'
      '           cast('#39'C'#39' as char(1)) as Tipo,'
      '           lc.Valor              AS Valor'
      ''
      
        '    FROM   PlanoContas pl JOIN Lancamentos lc ON pl.Codigo = lc.' +
        'Creditar'
      ''
      '    WHERE  lc.Data BETWEEN :DataInicial and :DataFinal'
      '      and lc.filial = :filial'
      ''
      '      %CondicoesImoveisDiarioAuxiliarCredito'
      ''
      
        '    ORDER BY lc.Data, lc.NrLancto, UPPER(TO_ASCII(pl.Descricao,'#39 +
        'LATIN1'#39')), pl.Codigo'
      '   )'
      ''
      ') AS Saldos'
      ''
      'ORDER BY Data, NrLancto')
    RequestLive = False
    Left = 440
    Top = 56
    ParamData = <
      item
        DataType = ftString
        Name = 'datainicial'
