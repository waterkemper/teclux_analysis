      end>
    Sql.Strings = (
      'Select temp.*,'
      
        '       (select tu.nome from tiposunidades tu where tu.codigo = t' +
        'emp.unidade) as TipoUnidade'
      'from'
      '('
      'Select iv.contrato, vi.data as DataContrato,'
      '       e.sigla,'
      '       b.empreendimento as codigoempreendimento,'
      '       iv.numero,'
      '       e.nome as empreendimento, '
      '       b.descricao,'
      '       (Select i.unidade'
      '        from imoveis i'
      '        where i.bloco = iv.bloco'
      '          and i.numero = iv.numero'
      '          and i.unidade = iv.unidade) as Unidade'
      '             '
      
        'from vendasimoveis vi join (imoveisvendidos iv join (blocos b jo' +
        'in empreendimentos e on b.empreendimento = e.codigo) on iv.bloco' +
        ' = b.codigo)'
      '                        on vi.contrato = iv.contrato'
      'where vi.contrato in (%Contratos)'
      ') as temp')
