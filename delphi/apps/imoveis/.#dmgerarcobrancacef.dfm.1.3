    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Empreendimento'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select pi.*,'
      
        '       (select valordevido(pi.contrato,pi.tipo, pi.numero,pi.nrp' +
        'agto,pi.datavencto)) as valordevido,'
      
        '       (select juroscontratuais(pi.valorcorrigido,pi.taxajuros,p' +
        'i.database,pi.datavencto)) as juros'
      'from'
      '('
      'select distinct pi.contrato,'
      '       pi.tipo,'
      '       pi.origem,'
      '       pi.numero,'
      '       pi.taxajuros,'
      '       pi.moeda,'
      '       pi.nrpagto,'
      '       pi.database,'
      '       pi.datavencto,'
      '       pi.valorhistorico,'
      
        '       (select valorcorrigido(pi.contrato,pi.tipo, pi.numero,pi.' +
        'nrpagto,pi.datavencto,true)) as valorcorrigido'
      
        'from parcelasimoveis pi join Vendasimoveis vi on pi.contrato = v' +
        'i.contrato %Empreendimento'
      'where pi.datavencto between :DataInicial and :DataFinal and'
      '      pi.datapagto is null'
      '      AND CASE WHEN vi.Situacao in ('#39'C'#39','#39'R'#39') THEN FALSE'
      '               WHEN vi.Situacao in ('#39'T'#39','#39'G'#39','#39'Q'#39','#39'S'#39') THEN FALSE'
      '               WHEN vi.Situacao in ('#39'F'#39','#39'D'#39') THEN TRUE'
      '               WHEN vi.Situacao in ('#39'V'#39') THEN TRUE'
      '               ELSE FALSE'
      '          END'
      'order by pi.contrato'
      ')as pi')
    RequestLive = False
    Left = 152
    Top = 16
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'DataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
