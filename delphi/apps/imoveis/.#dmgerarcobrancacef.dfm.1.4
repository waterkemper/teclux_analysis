    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Empreendimento'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';SELECT *,'
      '       CASE WHEN LENGTH(endereco) > 40 THEN TRUE'
      '            ELSE FALSE'
      '       END as campomaior'
      'FROM'
      '(SELECT DISTINCT co.Contrato, co.Cliente,'
      '                pi.Tipo       AS TipoParcela,'
      '                pi.Numero     AS NumeroParcela,'
      '                pi.Origem     AS OrigemParcela,'
      '                pi.DataVencto AS VenctoParcela,'
      ''
      
        '               (SELECT ValorDevido(pi.Contrato, pi.Tipo, pi.Nume' +
        'ro,'
      
        '                                   pi.NrPagto,  pi.DataVencto)) ' +
        'AS ValorParcela,'
      
        '               CASE WHEN vf.numero IS NULL and vf.complemento IS' +
        ' NULL THEN vf.rua'
      
        '                     WHEN vf.numero IS NOT NULL and vf.complemen' +
        'to IS NULL THEN vf.rua||'#39','#39'||cast(vf.numero as varchar)'
      
        '                     WHEN vf.numero IS NOT NULL and vf.complemen' +
        'to IS NOT NULL THEN vf.rua||'#39','#39'||cast(vf.numero as varchar)||'#39'-'#39 +
        '||vf.complemento'
      '                     ELSE vf.rua'
      '                END as endereco, '
      '                vf.*,'
      
        '                UPPER(TO_ASCII(coalesce(vf.razao,vf.nome) , '#39'LAT' +
        'IN1'#39')) AS NomeCliente,'
      '               (SELECT Nome FROM Bairros b'
      '                   WHERE b.Estado = vf.Estado AND '
      '                         b.Cidade = vf.Cidade AND'
      '                         b.Codigo = vf.Bairro) AS NomeBairro,'
      '                         '
      '               (SELECT Nome FROM Cidades d'
      '                   WHERE d.Estado = vf.Estado AND '
      '                         d.Codigo = vf.Cidade) AS NomeCidade,'
      ''
      '                FALSE AS Selecionado'
      ''
      'FROM Compradores co'
      '     JOIN vFornecedores vf ON co.Cliente     = vf.Codigo AND'
      '                              co.TipoCliente = vf.Tipo'
      '     JOIN ParcelasImoveis pi ON pi.Contrato = co.Contrato'
      ''
      'WHERE co.Contrato IN (SELECT pi.Contrato'
      '                         FROM ParcelasImoveis pi'
      
        '                              JOIN VendasImoveis vi ON pi.Contra' +
        'to = vi.Contrato'
      
        '                                                       %Empreend' +
        'imento'
      
        '                         WHERE pi.DataVencto BETWEEN :DataInicia' +
        'l AND'
      
        '                                                     :DataFinal ' +
        '  AND'
      
        '                               pi.DataPagto IS NULL             ' +
        '  '
      
        '                               AND CASE WHEN vi.Situacao in ('#39'C'#39 +
        ','#39'R'#39','#39'T'#39','#39'G'#39','#39'Q'#39','#39'S'#39') THEN FALSE'
      
        '                                        WHEN vi.Situacao in ('#39'V'#39 +
        ','#39'F'#39','#39'D'#39') THEN TRUE'
      '                                        ELSE FALSE'
      '                               END'
      ''
      '                     ) AND'
      '      co.principal     AND'
      '      pi.DataVencto BETWEEN :DataInicial AND'
      '                            :DataFinal'
      ''
      
        'ORDER BY NomeCliente, co.Cliente, co.Contrato, pi.Tipo, pi.Numer' +
        'o'
      ') as e')
    RequestLive = True
    Left = 48
    Top = 16
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'DataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataFinal'
        ParamType = ptUnknown
      end>
