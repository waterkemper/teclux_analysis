{$R *.dfm}

{ TdtmOperacoesImoveis }

constructor TdtmOperacoesImoveis.Create(AOwner: TComponent; Contrato: String);
begin
  inherited Create(AOwner);
  RefazConsultaPorNome(qryContratosImoveis,['Contrato'],[Contrato]);
end;

destructor TdtmOperacoesImoveis.Destroy;
begin
  dtmOperacoesImoveis.Free;
  inherited;
end;

function TdtmOperacoesImoveis.ExisteParcelasPagas(Contrato: String): Boolean;
begin
  Result:= False;
  qryParcelasImoveis.Close;
  qryParcelasImoveis.MacroByName('Contrato').AsString:= 'pi.Contrato = '+Contrato;
  qryParcelasImoveis.Open;
  if qryParcelasImoveis.RecordCount > 0 then
  begin
    GuardarRegistroAtual(qryParcelasImoveis, True);
    qryParcelasImoveis.First;
    while not qryParcelasImoveis.Eof do
    begin
      if ((qryParcelasImoveisdatapagto.AsString <> '') and
          (qryParcelasImoveisvalorpagto.AsCurrency > 0)) then
      begin
        Result:= True;
        Break;
      end;
      qryParcelasImoveis.Next;
    end;
    VoltarRegistroAtual(qryParcelasImoveis);
  end;
end;

function TdtmOperacoesImoveis.GetDataContabil: TDateTime;
begin
  Result:= ParSistema.DataContabil;
end;

function TdtmOperacoesImoveis.ContratosEmpreendimentos(Empreendimento: Integer): String;
var Contratos: String;
begin
  Contratos:= '';
  RefazConsultaPorNome(qryContratosEmpreendimento,['Empreendimento'],[Empreendimento]);
  qryContratosEmpreendimento.First;
  while not qryContratosEmpreendimento.Eof do
  begin
    Contratos:= Contratos + qryContratosEmpreendimentocontrato.AsString + ',';
    qryContratosEmpreendimento.Next;
  end;
  Delete(Contratos,length(COntratos)-1,1);
  Result:= Contratos;
  FNumeroContratos:= Contratos;
end;

procedure TdtmOperacoesImoveis.qryEmpreendimentosAfterOpen(DataSet: TDataSet);
begin
  inherited;
  ContratosEmpreendimentos(qryEmpreendimentoscodigo.AsInteger);
end;

function TdtmOperacoesImoveis.VerificarDataHabiteseValida: Boolean;
begin
  Result:= True;
  if dataContabil >= DataHabitese then
  begin
    qryParcelasImoveis.Close;
    qryParcelasImoveis.MacroByName('Contrato').AsString:= 'in ('+FNumeroContratos+')';
    qryParcelasImoveis.Open;

    qryParcelasImoveis.First;
    while not qryParcelasImoveis.Eof do
    begin
      if qryParcelasImoveisdatapagto.AsString <> '' then
       if DataHabitese <= qryParcelasImoveisdatapagto.AsDateTime then
        begin
         Break;
         MensagemAviso('O Contrato '+qryParcelasImoveiscontrato.AsString+' possui parcelas pagas com data de pagamento'+#13#10+
                       'maior ou igual a data do Habite-se('+datetostr(DataHabitese)+')');
         Result:= False;
        end
        else
        begin
          AjustarParcelas(qryParcelasImoveiscontrato.AsInteger,
                          qryParcelasImoveisnumero.AsInteger,
                          qryParcelasImoveisnrpagto.AsInteger,
                          qryParcelasImoveistipo.AsString,
                          DataLocal);
        end;
      qryParcelasImoveis.Next;
    end
  end
  else
  begin
    MensagemAviso(Format(ctDATACONTABILMAIORDATALANCTO,['contábil',datetostr(DataContabil),'do habite-se',datetostr(DataHabitese)]));
    Result:= False;
  end;
end;

procedure TdtmOperacoesImoveis.AjustarParcelas(Contrato, Numero, NrPagto: Integer; Tipo: String; Data: TDateTime);
begin
  RefazConsultaPorNome(qryValorCorrecao,['Contrato','TipoParcela','NumeroParcela','NrPagtoParcela','Data'],
                                        [Contrato, Tipo, Numero, NrPagto, Data]);
  if not (qryParcelasImoveis.State = dsedit) then
    qryParcelasImoveis.Edit;
  qryParcelasImoveisvalorcontratado.AsCurrency := qryValorCorrecaovalor.AsCurrency;
  qryParcelasImoveismoeda.AsString             := qryParcelasImoveisindexadoraposhabitese.AsString;
  qryParcelasImoveisdatabase.AsDateTime        := DataHabitese;
  qryParcelasImoveistaxajuros.AsCurrency       := qryParcelasImoveisjurosaposhabitese.AsCurrency;
  qryParcelasImoveis.Post;
end;

