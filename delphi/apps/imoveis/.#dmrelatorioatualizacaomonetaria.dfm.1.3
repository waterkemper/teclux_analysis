    Sql.Strings = (
      'SELECT *'
      'FROM (SELECT Contrato, Empreendimento, NomeEmpreendimento,'
      '                       Cliente,        NomeCliente,'
      ''
      
        '             Janeiro, Fevereiro, Marco,    Abril,   Maio,     Ju' +
        'nho,'
      
        '             Julho,   Agosto,    Setembro, Outubro, Novembro, De' +
        'zembro,'
      ''
      
        '            (Janeiro + Fevereiro + Marco    + Abril   + Maio    ' +
        ' + Junho + '
      
        '             Julho   + Agosto    + Setembro + Outubro + Novembro' +
        ' + Dezembro)'
      
        '                                                                ' +
        '        AS Total'
      ''
      '      FROM (SELECT DISTINCT Contrato,  Empreendimento, '
      '                   NomeEmpreendimento, Cliente, '
      '                  (SELECT coalesce(v.razao,v.nome) as nome'
      '                      FROM vFornecedores v'
      '                      WHERE v.Codigo  = Cliente AND'
      
        '                            v.Tipo    = TipoCliente) AS NomeClie' +
        'nte,'
      ''
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  1) A' +
        'S Janeiro,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  2) A' +
        'S Fevereiro,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  3) A' +
        'S Marco,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  4) A' +
        'S Abril,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  5) A' +
        'S Maio,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  6) A' +
        'S Junho,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  7) A' +
        'S Julho,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  8) A' +
        'S Agosto,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  9) A' +
        'S Setembro,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio, 10) A' +
        'S Outubro,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio, 11) A' +
        'S Novembro,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio, 12) A' +
        'S Dezembro'
      ''
      
        '            FROM (SELECT DISTINCT vi.Contrato, vi.Empreendimento' +
        ','
      '                        (SELECT e.nome '
      '                            FROM Empreendimentos e '
      
        '                            WHERE vi.empreendimento = e.codigo) ' +
        'AS NomeEmpreendimento,'
      ''
      '                        (SELECT co.Cliente'
      '                            FROM Compradores co'
      '                            WHERE co.Contrato = vi.Contrato AND'
      '                                  co.Principal) AS Cliente,'
      ''
      '                        (SELECT co.TipoCliente'
      '                            FROM Compradores co'
      '                            WHERE co.Contrato = vi.Contrato AND'
      '                                  co.Principal) AS TipoCliente'
      ''
      '                  FROM VendasImoveis vi'
      '                  WHERE TRUE'
      '                        %WhereEmpreendimentos'
      ''
      '           ) AS Vendas'
      '            %WhereClientes'
      '     ) AS Total'
      ') AS s'
      ''
      'WHERE (Janeiro <> 0) OR (Fevereiro <> 0) OR (Marco    <> 0) OR '
      '      (Abril   <> 0) OR (Maio      <> 0) OR (Junho    <> 0) OR '
      '      (Julho   <> 0) OR (Agosto    <> 0) OR (Setembro <> 0) OR'
      '      (Outubro <> 0) OR (Novembro  <> 0) OR (Dezembro <> 0)'
      ''
      
        'ORDER BY TO_ASCII(NomeEmpreendimento, '#39'LATIN1'#39'), TO_ASCII(NomeCl' +
        'iente, '#39'LATIN1'#39'), Contrato'
      '')
