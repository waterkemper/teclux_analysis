  object qryAtualizacaoMonetariaEmp: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryAtualizacaoMonetariaEmpBeforeOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereEmpreendimentos'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'SELECT DISTINCT Codigo AS Empreendimento,'
      #9'             Nome   AS NomeEmpreendimento,'
      ''
      '       SUM(Janeiro)   AS Janeiro,     SUM(Julho)    AS Julho,'
      '       SUM(Fevereiro) AS Fevereiro,   SUM(Agosto)   AS Agosto,'
      '       SUM(Marco)     AS Marco,       SUM(Setembro) AS Setembro,'
      '       SUM(Abril)     AS Abril,       SUM(Outubro)  AS Outubro,'
      '       SUM(Maio)      AS Maio,        SUM(Novembro) AS novembro,'
      '       SUM(Junho)     AS Junho,       SUM(Dezembro) AS Dezembro,'
      ''
      '      (SUM(Janeiro) + SUM(Fevereiro) + SUM(Marco)    +'
      '       SUM(Abril)   + SUM(Maio)      + SUM(Junho)    +'
      '       SUM(Julho)   + SUM(Agosto)    + SUM(Setembro) +'
      '       SUM(Outubro) + SUM(Novembro)  + SUM(Dezembro)) AS Total'
      ''
      'FROM (SELECT Codigo, Nome,'
      
        '             ValorCorrecaoMes(Contrato, :pExercicio,  1) AS Jane' +
        'iro,'
      
        '             ValorCorrecaoMes(Contrato, :pExercicio,  2) AS Feve' +
        'reiro,'
      
        '             ValorCorrecaoMes(Contrato, :pExercicio,  3) AS Marc' +
        'o,'
      
        '             ValorCorrecaoMes(Contrato, :pExercicio,  4) AS Abri' +
        'l,'
      
        '             ValorCorrecaoMes(Contrato, :pExercicio,  5) AS Maio' +
        ','
      
        '             ValorCorrecaoMes(Contrato, :pExercicio,  6) AS Junh' +
        'o,'
      
        '             ValorCorrecaoMes(Contrato, :pExercicio,  7) AS Julh' +
        'o,'
      
        '             ValorCorrecaoMes(Contrato, :pExercicio,  8) AS Agos' +
        'to,'
      
        '             ValorCorrecaoMes(Contrato, :pExercicio,  9) AS Sete' +
        'mbro,'
      
        '             ValorCorrecaoMes(Contrato, :pExercicio, 10) AS Outu' +
        'bro,'
      
        '             ValorCorrecaoMes(Contrato, :pExercicio, 11) AS Nove' +
        'mbro,'
      
        '             ValorCorrecaoMes(Contrato, :pExercicio, 12) AS Deze' +
        'mbro'
      ''
      '         FROM (SELECT DISTINCT vi.Contrato, e.Codigo, e.nome'
      '                  FROM VendasImoveis vi'
      '                       JOIN Empreendimentos e'
      '                       ON vi.Empreendimento = e.Codigo'
      '                  WHERE vi.Empreendimento = e.Codigo'
      '                        %WhereEmpreendimentos'
      '               ) AS QueContratos'
      '      ) AS Meses'
      ''
      'WHERE (Janeiro <> 0) OR (Fevereiro <> 0) OR (Marco    <> 0) OR'
      '      (Abril   <> 0) OR (Maio      <> 0) OR (Junho    <> 0) OR'
      '      (Julho   <> 0) OR (Agosto    <> 0) OR (Setembro <> 0) OR'
      '      (Outubro <> 0) OR (Novembro  <> 0) OR (Dezembro <> 0)'#9
      ''
      'GROUP BY Empreendimento, NomeEmpreendimento'
      '')
    RequestLive = False
    Left = 368
    Top = 24
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'pExercicio'
        ParamType = ptUnknown
      end>
