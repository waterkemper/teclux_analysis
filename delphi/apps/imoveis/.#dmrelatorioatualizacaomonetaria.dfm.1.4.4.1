        Value = 'AND vi.Empreendimento = 5010'
      end
      item
        DataType = ftUnknown
        Name = 'WhereClientes'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'SELECT *'
      'FROM (SELECT Contrato, Empreendimento, NomeEmpreendimento,'
      '                       Cliente,        NomeCliente,'
      ''
      
        '             Janeiro, Fevereiro, Marco,    Abril,   Maio,     Ju' +
        'nho,'
      
        '             Julho,   Agosto,    Setembro, Outubro, Novembro, De' +
        'zembro,'
      ''
      
        '             Janeiro_CP, Fevereiro_CP, Marco_CP, Abril_CP, Maio_' +
        'CP, Junho_CP,'
      
        '             Julho_CP, Agosto_CP, Setembro_CP, Outubro_CP, Novem' +
        'bro_CP, Dezembro_CP,'
      ''
      
        '             Janeiro_LP, Fevereiro_LP, Marco_LP, Abril_LP, Maio_' +
        'LP, Junho_LP,'
      
        '             Julho_LP, Agosto_LP, Setembro_LP, Outubro_LP, Novem' +
        'bro_LP, Dezembro_LP,'
      ''
      
        '            (Janeiro + Fevereiro + Marco    + Abril   + Maio    ' +
        ' + Junho +'
      
        '             Julho   + Agosto    + Setembro + Outubro + Novembro' +
        ' + Dezembro) AS Total,'
      ''
      
        '            (Janeiro_CP + Fevereiro_CP + Marco_CP + Abril_CP + M' +
        'aio_CP + Junho_CP +'
      
        '             Julho_CP + Agosto_CP + Setembro_CP + Outubro_CP + N' +
        'ovembro_CP + Dezembro_CP) AS Total_CP,'
      ''
      
        '            (Janeiro_LP + Fevereiro_LP + Marco_LP + Abril_LP + M' +
        'aio_LP + Junho_LP +'
      
        '             Julho_LP + Agosto_LP + Setembro_LP + Outubro_LP + N' +
        'ovembro_LP + Dezembro_LP) AS Total_LP'
      ''
      '      FROM (SELECT DISTINCT Contrato,  Empreendimento,'
      '                   NomeEmpreendimento, Cliente,'
      '                  (SELECT coalesce(v.razao,v.nome) as nome'
      '                      FROM vFornecedores v'
      '                      WHERE v.Codigo  = Cliente AND'
      
        '                            v.Tipo    = TipoCliente) AS NomeClie' +
        'nte,'
      ''
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  1) A' +
        'S Janeiro,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  1, '#39 +
        'CURTO'#39') AS Janeiro_CP,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  1, '#39 +
        'LONGO'#39') AS Janeiro_LP,'
      ''
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  2) A' +
        'S Fevereiro,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  2, '#39 +
        'CURTO'#39') AS Fevereiro_CP,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  2, '#39 +
        'LONGO'#39') AS Fevereiro_LP,'
      ''
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  3) A' +
        'S Marco,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  3, '#39 +
        'CURTO'#39') AS Marco_CP,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  3, '#39 +
        'LONGO'#39') AS Marco_LP,'
      ''
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  4) A' +
        'S Abril,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  4, '#39 +
        'CURTO'#39') AS Abril_CP,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  4, '#39 +
        'LONGO'#39') AS Abril_LP,'
      ''
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  5) A' +
        'S Maio,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  5, '#39 +
        'CURTO'#39') AS Maio_CP,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  5, '#39 +
        'LONGO'#39') AS Maio_LP,'
      ''
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  6) A' +
        'S Junho,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  6, '#39 +
        'CURTO'#39') AS Junho_CP,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  6, '#39 +
        'LONGO'#39') AS Junho_LP,'
      ''
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  7) A' +
        'S Julho,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  7, '#39 +
        'CURTO'#39') AS Julho_CP,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  7, '#39 +
        'LONGO'#39') AS Julho_LP,'
      ''
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  8) A' +
        'S Agosto,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  8, '#39 +
        'CURTO'#39') AS Agosto_CP,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  8, '#39 +
        'LONGO'#39') AS Agosto_LP,'
      ''
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  9) A' +
        'S Setembro,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  9, '#39 +
        'CURTO'#39') AS Setembro_CP,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio,  9, '#39 +
        'LONGO'#39') AS Setembro_LP,'
      ''
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio, 10) A' +
        'S Outubro,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio, 10, '#39 +
        'CURTO'#39') AS Outubro_CP,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio, 10, '#39 +
        'LONGO'#39') AS Outubro_LP,'
      ''
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio, 11) A' +
        'S Novembro,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio, 11, '#39 +
        'CURTO'#39') AS Novembro_CP,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio, 11, '#39 +
        'LONGO'#39') AS Novembro_LP,'
      ''
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio, 12) A' +
        'S Dezembro,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio, 12, '#39 +
        'CURTO'#39') AS Dezembro_CP,'
      
        '                   ValorCorrecaoMes(Contrato, :pExercicio, 12, '#39 +
        'LONGO'#39') AS Dezembro_LP'
      ''
      
        '            FROM (SELECT DISTINCT vi.Contrato, vi.Empreendimento' +
        ','
      '                        (SELECT e.nome'
      '                            FROM Empreendimentos e'
      
        '                            WHERE vi.empreendimento = e.codigo) ' +
        'AS NomeEmpreendimento,'
      ''
      '                        (SELECT co.Cliente'
      '                            FROM Compradores co'
      '                            WHERE co.Contrato = vi.Contrato AND'
      '                                  co.Principal) AS Cliente,'
      ''
      '                        (SELECT co.TipoCliente'
      '                            FROM Compradores co'
      '                            WHERE co.Contrato = vi.Contrato AND'
      '                                  co.Principal) AS TipoCliente'
      ''
      '                  FROM VendasImoveis vi'
      '                  WHERE TRUE'
      '                        %WhereEmpreendimentos'
      ''
      '           ) AS Vendas'
      '            %WhereClientes'
      '     ) AS Total'
      ') AS s'
      ''
      'WHERE (Janeiro <> 0) OR (Fevereiro <> 0) OR (Marco    <> 0) OR'
      '      (Abril   <> 0) OR (Maio      <> 0) OR (Junho    <> 0) OR'
      '      (Julho   <> 0) OR (Agosto    <> 0) OR (Setembro <> 0) OR'
      '      (Outubro <> 0) OR (Novembro  <> 0) OR (Dezembro <> 0) OR'
      ''
      
        '      (Janeiro_CP <> 0) OR (Fevereiro_CP <> 0) OR (Marco_CP    <' +
        '> 0) OR'
      
        '      (Abril_CP   <> 0) OR (Maio_CP      <> 0) OR (Junho_CP    <' +
        '> 0) OR'
      
        '      (Julho_CP   <> 0) OR (Agosto_CP    <> 0) OR (Setembro_CP <' +
        '> 0) OR'
      
        '      (Outubro_CP <> 0) OR (Novembro_CP  <> 0) OR (Dezembro_CP <' +
        '> 0) OR'
      ''
      
        '      (Janeiro_LP <> 0) OR (Fevereiro_LP <> 0) OR (Marco_LP    <' +
        '> 0) OR'
      
        '      (Abril_LP   <> 0) OR (Maio_LP      <> 0) OR (Junho_LP    <' +
        '> 0) OR'
      
        '      (Julho_LP   <> 0) OR (Agosto_LP    <> 0) OR (Setembro_LP <' +
        '> 0) OR'
      
        '      (Outubro_LP <> 0) OR (Novembro_LP  <> 0) OR (Dezembro_LP <' +
        '> 0)'
      ''
      
        'ORDER BY TO_ASCII(NomeEmpreendimento, '#39'LATIN1'#39'), TO_ASCII(NomeCl' +
        'iente, '#39'LATIN1'#39'), Contrato')
    RequestLive = False
