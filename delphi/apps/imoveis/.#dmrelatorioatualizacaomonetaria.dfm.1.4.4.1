      '       SUM(Julho_cp)   + SUM(Agosto_cp)    + SUM(Setembro_cp) +'
      
        '       SUM(Outubro_cp) + SUM(Novembro_cp)  + SUM(Dezembro_cp)) A' +
        'S Total_cp,'
      ''
      
        '       SUM(Janeiro_lp)   AS Janeiro_lp,     SUM(Julho_lp)    AS ' +
        'Julho_lp,'
      
        '       SUM(Fevereiro_lp) AS Fevereiro_lp,   SUM(Agosto_lp)   AS ' +
