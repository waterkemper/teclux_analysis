    Sql.Strings = (
      ';'
      'SELECT * FROM ('
      ''
      'SELECT DISTINCT vi.Contrato, pi.Cliente, vi.Data,'
      '       e.Nome AS NomeEmpreendimento,'
      ''
      '      (SELECT coalesce(v.razao,v.nome)'
      '          FROM vFornecedores v'
      
        '             JOIN Compradores co ON v.Codigo    = co.Cliente    ' +
        ' AND'
      
        '                                    v.Tipo      = co.TipoCliente' +
        ' AND'
      '                                    vi.Contrato = co.Contrato'
      '            WHERE v.Codigo  = co.Cliente     AND'
      '                  v.Tipo    = co.TipoCliente AND'
      '                  vi.Contrato = co.Contrato  AND'
      '                  co.Principal) AS NomeCliente,'
      '       pi.contapagto,'
      '       pi.conta,'
      '       SUM(pi.ValorPagto)      AS ValorPagto,'
      '       SUM(pi.ValorHistorico)  AS ValorHistorico,'
      '       SUM(pi.ValorContratado) AS ValorContratado,'
      '       SUM(pi.ValorCorrigido)  AS ValorCorrigido,'
      '       SUM(pi.ValorDevido)     AS ValorDevido,'
      '       SUM(pi.Correcao)        AS Correcao,'
      '       SUM(pi.Juros)           AS Juros,'
      '       SUM(CASE WHEN pi.Diferenca > 0 THEN pi.Diferenca'
      '           END) AS JurosMulta,'
      '           '
      '       SUM(CASE WHEN pi.Diferenca < 0 THEN -pi.Diferenca'
      '           END) AS Descontos'
      '           '
      
        'FROM (SELECT DISTINCT pi.Contrato,     pi.Cliente,          pi.O' +
        'rigem, pi.contapagto,'
      
        '                      pi.Tipo,         pi.Numero,           pi.N' +
        'rPagto, pi.conta,'
      
        '                      pi.DataPagto,    pi.ValorHistorico,   pi.V' +
        'alorContratado,'
      
        '                      pi.ValorPagto,   pi.ValorCorrigido,   pi.J' +
        'uros,'
      
        '                      pi.Correcao,     pi.Diferenca,        pi.V' +
        'alorDevido'
      ''
      
        '         FROM (SELECT DISTINCT Contrato, Cliente,Origem, Tipo, N' +
        'umero, NrPagto,'
      
        '                               DataPagto, ValorPagto, ValorHisto' +
        'rico, ValorContratado,'
      
