        'rPagto, Datapagto, TRUE) AS ValorCorrigido,'
      
        '                      JurosContratuais(Contrato, Tipo, Numero, N' +
        'rPagto, Datapagto) AS Juros,'
      
        '                      ValorDevido     (Contrato, Tipo, Numero, N' +
        'rPagto, DataPagto) AS ValorDevido,'
      
        '                     (ValorCorrigido  (Contrato, Tipo, Numero, N' +
        'rPagto, Datapagto, TRUE) - ValorHistorico)'
      
        '                                                                ' +
        '                   AS Correcao,'
      
        '                     (select conta||'#39'-'#39'||digito||'#39' - '#39'||(select ' +
        'b.nome from bancos b where b.codigo = banco)'
      '                        from contas'
      
