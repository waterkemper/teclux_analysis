      '                      END AS Diferenca'
      '                      '
      '                  FROM (SELECT DISTINCT  vi.Contrato,'
      
        '                               pi.Origem,          pi.Tipo,     ' +
        ' pi.Numero, pi.contapagto,                        '
      
        '                               pi.NrPagto,         pi.Moeda,    ' +
        ' pi.ValorPagto, pi.contapagto as conta,'
      
        '                               pi.JurosCompostos,  pi.TaxaJuros,' +
        ' pi.Datapagto,'
      
        '                               pi.ValorHistorico,  pi.ValorContr' +
        'atado,'
      '                              (SELECT co.Cliente'
      '                                  FROM Compradores co'
      
        '                                  WHERE co.Contrato = vi.Contrat' +
        'o AND'
      '                                        co.Principal) AS Cliente'
      ''
      '                           FROM VendasImoveis vi'
      '                                JOIN ImoveisVendidos iv'
      '                                     JOIN Blocos b'
      '                                          JOIN Empreendimentos e'
      
        '                                          ON b.Empreendimento = ' +
        'e.Codigo'
      '                                     ON iv.Bloco = b.Codigo'
      '                                ON vi.Contrato = iv.Contrato'
      ''
      '                                JOIN ParcelasImoveis pi'
      '                                ON vi.Contrato = pi.Contrato'
      ''
      
        '                           WHERE vi.Contrato = pi.Contrato      ' +
        'AND'
      
