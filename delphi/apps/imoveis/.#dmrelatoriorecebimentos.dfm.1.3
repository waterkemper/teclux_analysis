        'AND'
      
        '                                 iv.Bloco    = b.Codigo         ' +
        'AND'
      
        '                                 e.Codigo    = b.Empreendimento ' +
        'AND'
      
        '                                 pi.Datapagto IS NOT NULL       ' +
        'AND'
      
        '                                 pi.DataPagto BETWEEN :DataInici' +
        'al AND :DataFinal'
      '                            AND (vi.Situacao NOT IN ('#39'C'#39','#39'R'#39') OR'
      '                                 vi.Situacao     IN ('#39'T'#39','#39'G'#39'))'
      '                        ) AS Selecao'
      '               ) AS pi'
