  object qryRelatorioporEmp: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryRelatorioporEmpBeforeOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereConta'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereClientes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereEmpreendimentos'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'SELECT * FROM ('
      ''
      'SELECT distinct e.Codigo as Empreendimento,'
      #9'        e.Nome AS NomeEmpreendimento,'
      #9'        SUM(ParcelasImoveis.ValorPagto) as VAlorPagto,'
      #9'        SUM(ParcelasImoveis.ValorHistorico) as ValorHistorico,'
      
        '                SUM(ParcelasImoveis.VAlorContratado) as VAlorCon' +
        'tratado,'
      #9'        SUM(ParcelasImoveis.ValorCorrigido) as ValorCorrigido,'
      #9'        SUM(ParcelasImoveis.ValorDevido) as VAlorDevido,'
      #9'        SUM(ParcelasImoveis.Correcao) as Correcao,'
      #9'        SUM(ParcelasImoveis.Juros) as Juros,'
      
        #9'        SUM((CASE WHEN ParcelasImoveis.Diferenca > 0 then ABS(P' +
        'arcelasImoveis.Diferenca) END)) as jurosmulta,'
      
        '            SUM((CASE WHEN ParcelasImoveis.Diferenca < 0 then AB' +
        'S(ParcelasImoveis.Diferenca) END)) as descontos,'
      '  '#9'        sum(ParcelasImoveis.avpvalorlongo) as avpvalorlongo,'
      #9'        sum(ParcelasImoveis.avpvalorcurto) as avpvalorcurto'#9'   '
      #9#9#9#9
      'FROM ('
      '      SELECT DISTINCT ParcelasImoveis.Contrato,'
      '                      ParcelasImoveis.Cliente,'
      '                      ParcelasImoveis.Origem,'
      '                      ParcelasImoveis.Tipo,'
      '                      ParcelasImoveis.Numero,'
      '                      ParcelasImoveis.NrPagto,'
      '                      ParcelasImoveis.DataPagto,'
      '                      ParcelasImoveis.ValorHistorico,'
      '                      ParcelasImoveis.ValorContratado,'
      '                      ParcelasImoveis.ValorPagto,'
      '                      ParcelasImoveis.VAlorCorrigido,'
      '                      ParcelasImoveis.Juros,'
      '                      ParcelasImoveis.Correcao,'
      '                      ParcelasImoveis.Diferenca,'
      '                      ParcelasImoveis.ValorDevido,'
      
        '                '#9'  case when avpprazo = '#39'LONGO'#39' then avpvalor el' +
        'se 0 end as avpvalorlongo,'
      
        #9'                  case when avpprazo = '#39'CURTO'#39' then avpvalor el' +
        'se 0 end as avpvalorcurto'
      #9#9#9#9#9'  '
      '      FROM ('
      
        '            SELECT DISTINCT Contrato, Cliente,Origem, Tipo, Nume' +
        'ro, NrPagto, DataPagto, ValorPagto, ValorHistorico, VAlorContrat' +
        'ado,'
      
        '                            ValorCorrigido(Contrato, Tipo, Numer' +
        'o, NrPagto,Datapagto,TRUE) AS ValorCorrigido,'
      
        '                            JurosContratuais(Contrato, Tipo, Num' +
        'ero, NrPagto,Datapagto) AS Juros,'
      
        '                            (ValorCorrigido(Contrato, Tipo, Nume' +
        'ro, NrPagto,Datapagto,TRUE) - ValorHistorico) AS Correcao,'
      '                            (CASE WHEN DataPagto IS NULL'
      '                                  THEN NULL'
      
        '                                  ELSE CASE WHEN (Valorpagto - (' +
        'SELECT ValorDevido(Contrato, Tipo, Numero,NrPagto,Datapagto))) =' +
        ' 0'
      '                                            THEN NULL'
      
        '                                            ELSE (Valorpagto - (' +
        'SELECT ValorDevido(Contrato, Tipo, Numero, NrPagto, Datapagto)))' +
        ' END'
      '                             END) AS Diferenca,'
      
        #9'                     ValorDevido(Contrato, Tipo,Numero, NrPagto' +
        ',datapagto) AS ValorDevido,'
      #9#9#9#9#9#9' avpvalor, avpprazo'
      #9#9#9#9#9#9' '
      '            FROM ('
      '                  SELECT DISTINCT VendasImoveis.Contrato,'
      '                         (Select compradores.cliente'
      '                            FROM compradores'
      
        '                            where Vendasimoveis.contrato = compr' +
        'adores.contrato AND'
      
        '                                  Compradores.Principal)as clien' +
        'te,'
      '                         ParcelasImoveis.Origem,'
      '                         ParcelasImoveis.Tipo,'
      '                         ParcelasImoveis.Numero,'
      '                         ParcelasImoveis.NrPagto,'
      '                         ParcelasImoveis.Moeda,'
      '                         PArcelasImoveis.ValorPagto,'
      '                         ParcelasImoveis.ValorHistorico,'
      '                         ParcelasImoveis.Valorcontratado,'
      '                         ParcelasImoveis.juroscompostos,'
      '                         ParcelasImoveis.taxajuros,'
      '                         ParcelasImoveis.contapagto,'
      '                         ParcelasImoveis.contapagto as conta,'
      '                         Parcelasimoveis.datapagto,'
      #9#9#9#9#9#9' Parcelasimoveis.avpvalor, '
      #9#9#9#9#9#9' Parcelasimoveis.avpprazo'
      #9'          FROM VendasImoveis'
      '                     JOIN Empreendimentos'
      
        '                       ON VendasImoveis.Empreendimento = Empreen' +
        'dimentos.Codigo'
      '                     JOIN ParcelasImoveis'
      
        '                       ON VendasImoveis.Contrato = ParcelasImove' +
        'is.Contrato'
      
        '                  WHERE VendasImoveis.Contrato = ParcelasImoveis' +
        '.Contrato'
      
        '                    AND VendasImoveis.Empreendimento = Empreendi' +
        'mentos.Codigo'
      
        '                    AND ParcelasImoveis.Datapagto IS NOT NULL AN' +
        'D'
      
        '                        ParcelasImoveis.DataPagto between :DataI' +
        'nicial AND :DataFinal'
      
        '                    AND  (VendasImoveis.Situacao NOT IN ('#39'C'#39','#39'R'#39 +
        ') OR'
      
        '                          VendasImoveis.Situacao     IN ('#39'T'#39','#39'G'#39 +
        '))'
      #9'          ) AS Selecao'
      '                  %WhereConta'
      #9'        ) AS ParcelasImoveis'
      '                  %WhereClientes'
      '              ) AS ParcelasImoveis'
      '                    JOIN VendasImoveis vi'
      '                        JOIN Empreendimentos e'
      '                          ON vi.empreendimento = e.codigo'
      '                      ON vi.Contrato = ParcelasImoveis.Contrato'
      'where true '
      '      %WhereEmpreendimentos'
      ''
      'group by e.Nome,'
      '         e.Codigo'
      ') AS s'
      ''
      'ORDER BY TO_ASCII(NomeEmpreendimento, '#39'LATIN1'#39');'
      '')
    RequestLive = False
    Left = 304
    Top = 40
    ParamData = <
      item
        DataType = ftString
        Name = 'DataInicial'
