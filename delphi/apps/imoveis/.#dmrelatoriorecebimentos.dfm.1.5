  object qryRelatorioporClientes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryRelatorioporClientesBeforeOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereEmpreendimentos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereClientes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereConta'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Ordenacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'SELECT * FROM ('
      ''
      'SELECT DISTINCT vi.Contrato, pi.Cliente, vi.Data,'
      '       e.Nome AS NomeEmpreendimento,'
      ''
      '      (SELECT coalesce(v.razao,v.nome)'
      '          FROM vFornecedores v'
      
        '             JOIN Compradores co ON v.Codigo    = co.Cliente    ' +
        ' AND'
      
        '                                    v.Tipo      = co.TipoCliente' +
        ' AND'
      '                                    vi.Contrato = co.Contrato'
      '            WHERE v.Codigo  = co.Cliente     AND'
      '                  v.Tipo    = co.TipoCliente AND'
      '                  vi.Contrato = co.Contrato  AND'
      '                  co.Principal) AS NomeCliente,'
      '       pi.contapagto,'
      '       pi.conta,'
      '       SUM(pi.ValorPagto)      AS ValorPagto,'
      '       SUM(pi.ValorHistorico)  AS ValorHistorico,'
      '       SUM(pi.ValorContratado) AS ValorContratado,'
      #9'     sum(pi.avpvalorlongo) as avpvalorlongo,'
      #9'     sum(pi.avpvalorcurto) as avpvalorcurto,'#9'   '
      '       SUM(pi.ValorCorrigido)  AS ValorCorrigido,'
      '       SUM(pi.ValorDevido)     AS ValorDevido,'
      '       SUM(pi.Correcao)        AS Correcao,'
      '       SUM(pi.Juros)           AS Juros,'
      '       SUM(CASE WHEN pi.Diferenca > 0 THEN pi.Diferenca'
      '           END) AS JurosMulta,'
      '           '
      '       SUM(CASE WHEN pi.Diferenca < 0 THEN -pi.Diferenca'
      '           END) AS Descontos'
      '           '
      
        'FROM (SELECT DISTINCT pi.Contrato,     pi.Cliente,          pi.O' +
        'rigem, pi.contapagto,'
      
        '                      pi.Tipo,         pi.Numero,           pi.N' +
        'rPagto, pi.conta,'
      
        '                      pi.DataPagto,    pi.ValorHistorico,   pi.V' +
        'alorContratado, '
      #9#9#9#9#9'  '
      
        '                '#9' case when pi.avpprazo = '#39'LONGO'#39' then pi.avpval' +
        'or else 0 end as avpvalorlongo,'
      
        #9'                 case when pi.avpprazo = '#39'CURTO'#39' then pi.avpval' +
        'or else 0 end as avpvalorcurto,'#9'   '
      #9#9#9#9#9'  '#9#9#9#9#9'  '
      
        '                      pi.ValorPagto,   pi.ValorCorrigido,   pi.J' +
        'uros,'
      
        '                      pi.Correcao,     pi.Diferenca,        pi.V' +
        'alorDevido'
      ''
      
        '         FROM (SELECT DISTINCT Contrato, Cliente,Origem, Tipo, N' +
        'umero, NrPagto,'
      
        '                               DataPagto, ValorPagto, ValorHisto' +
        'rico, ValorContratado, avpvalor, avpprazo,'
      
        '                      ValorCorrigido  (Contrato, Tipo, Numero, N' +
        'rPagto, Datapagto, TRUE) AS ValorCorrigido,'
      
        '                      JurosContratuais(Contrato, Tipo, Numero, N' +
        'rPagto, Datapagto) AS Juros,'
      
        '                      ValorDevido     (Contrato, Tipo, Numero, N' +
        'rPagto, DataPagto) AS ValorDevido,'
      
        '                     (ValorCorrigido  (Contrato, Tipo, Numero, N' +
        'rPagto, Datapagto, TRUE) - ValorHistorico)'
      
        '                                                                ' +
        '                   AS Correcao,'
      
        '                     (select conta||'#39'-'#39'||digito||'#39' - '#39'||(select ' +
        'b.nome from bancos b where b.codigo = banco)'
      '                        from contas'
      
        '                          where conta = contapagto) as contapagt' +
        'o,'
      '                      conta,'
      '                      CASE WHEN DataPagto IS NULL'
      '                           THEN  NULL'
      
        '                           ELSE CASE WHEN (Valorpagto - (SELECT ' +
        'ValorDevido(Contrato, Tipo, Numero,NrPagto,Datapagto))) = 0'
      '                                     THEN  NULL'
      
        '                                     ELSE (ValorPagto - (SELECT ' +
        'ValorDevido(Contrato, Tipo, Numero, NrPagto, Datapagto))) END'
      '                      END AS Diferenca'
      '                      '
      '                  FROM (SELECT DISTINCT  vi.Contrato,'
      
        '                               pi.Origem,          pi.Tipo,     ' +
        ' pi.Numero, pi.contapagto,                        '
      
        '                               pi.NrPagto,         pi.Moeda,    ' +
        ' pi.ValorPagto, pi.contapagto as conta,'
      
        '                               pi.JurosCompostos,  pi.TaxaJuros,' +
        ' pi.Datapagto,'
      
        '                               pi.ValorHistorico,  pi.ValorContr' +
        'atado, pi.avpvalor, pi.avpprazo,'
      '                              (SELECT co.Cliente'
      '                                  FROM Compradores co'
      
        '                                  WHERE co.Contrato = vi.Contrat' +
        'o AND'
      '                                        co.Principal) AS Cliente'
      ''
      '                           FROM VendasImoveis vi'
      '                                JOIN ImoveisVendidos iv'
      '                                     JOIN Blocos b'
      '                                          JOIN Empreendimentos e'
      
        '                                          ON b.Empreendimento = ' +
        'e.Codigo'
      '                                     ON iv.Bloco = b.Codigo'
      '                                ON vi.Contrato = iv.Contrato'
      ''
      '                                JOIN ParcelasImoveis pi'
      '                                ON vi.Contrato = pi.Contrato'
      ''
      
        '                           WHERE vi.Contrato = pi.Contrato      ' +
        'AND'
      
        '                                 vi.Contrato = iv.Contrato      ' +
        'AND'
      
        '                                 iv.Bloco    = b.Codigo         ' +
        'AND'
      
        '                                 e.Codigo    = b.Empreendimento ' +
        'AND'
      
        '                                 pi.Datapagto IS NOT NULL       ' +
        'AND'
      
        '                                 pi.DataPagto BETWEEN :DataInici' +
        'al AND :DataFinal'
      '                            AND (vi.Situacao NOT IN ('#39'C'#39','#39'R'#39') OR'
      '                                 vi.Situacao     IN ('#39'T'#39','#39'G'#39'))'
      '                        ) AS Selecao'
      '               ) AS pi'
      '     ) AS pi'
      '          JOIN VendasImoveis vi'
      '              JOIN Empreendimentos e'
      '                 ON vi.empreendimento = e.codigo'
      '             ON vi.Contrato = pi.Contrato               '
      'WHERE TRUE '
      '      %WhereEmpreendimentos'
      '      %WhereClientes'
      '      %WhereConta'
      ''
      
        'GROUP BY pi.Cliente, vi.Contrato, vi.Data, e.Nome, NomeCliente, ' +
        'pi.conta, pi.contapagto'
      ''
      ') AS s'
      ''
      '%Ordenacao'
      ''
      '')
    RequestLive = False
    Left = 160
    Top = 48
    ParamData = <
      item
        DataType = ftString
        Name = 'DataInicial'
        ParamType = ptUnknown
        Value = '01/01/00'
      end
      item
        DataType = ftString
        Name = 'DataFinal'
        ParamType = ptUnknown
        Value = '01/01/00'
      end>
