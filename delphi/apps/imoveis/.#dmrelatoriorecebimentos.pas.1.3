procedure TdtmRelatorioRecebimentos.ZMonitor1MonitorEvent(Sql,
  Result: String);
var
 Listar : TStringList;
 arquivo: String;
begin
  inherited;
  Listar := tStringlist.Create;
  arquivo := 'C:\RecebimentosParcelas.sql';
  if fileexists(arquivo) then
    Listar.loadfromfile(arquivo);
  Listar.add('');
  Listar.add(sql);
  Listar.add(result);
  listar.savetofile(arquivo);
  listar.free;
end;

