procedure TdtmRelatorioRecebimentos.ImprimirRelatorio;
var
  Relatorio: TfrReport;
  frmPreview: TfrmPreviewPadrao;
begin

  if FSoCliente then
  begin
    qryRelatorioporClientes.Close;
    qryRelatorioporClientes.Open;
  end;
  if FComParcelas then
  begin
    qryparcelas.Close;
    qryParcelas.Open;
  end;
  if FSoEmpreendimento then
  begin
    qryRelatorioporEmp.Close;
    qryRelatorioporEmp.Open;
  end;
  AtribuirParametrosBaseRelatorio;
  frVariables['Titulo']:= 'RECEBIMENTOS ENTRE '+FormatDateTime('DD/MM/YYYY',FDataInicial)+
                          ' E '+FormatDateTime('DD/MM/YYYY',FDataFinal);
  frVariables['Totalizador']:= 'TOTAL DE RECEBIMENTOS ENTRE '+FormatDateTime('DD/MM/YYYY',FDataInicial)+' E '+FormatDateTime('DD/MM/YYYY',FDataFinal);
  frVariables['CabecalhoContas']:= FTotaisporConta;

  frVariables['SubTituloClientes']       := 'RESUMO POR CLIENTE';
  frVariables['SubTituloEmpreendimentos']:= 'RESUMO POR EMPREENDIMENTO';
  //frpRelatorioEmp.DesignReport;
  frmPreview := TfrmPreviewPadrao.create(self);
  frmPreview.cmbZoom.ItemIndex := 3; //125%
  try
   Relatorio := frmPreview.frCompositeReport;
   with frmPreview do
   begin
     frCompositeReport.Reports.Clear;
     frCompositeReport.DoublePass:= True;
     if FComParcelas then
       frCompositeReport.Reports.Add(frpRelatorioParcelas);
     if FSoCliente then
       frCompositeReport.Reports.Add(frpRelatorioClientes);
     if FSoEmpreendimento then
       frCompositeReport.Reports.Add(frpRelatorioEmp);
     Relatorio.Preview := frmPreview.frPreviewPadrao;
     Relatorio.ShowReport;
     frmPreview.ShowModal;
   end;
  finally
   frmPreview.Free
  end;
end;

procedure TdtmRelatorioRecebimentos.qryParcelasBeforeOpen(DataSet: TDataSet);
begin
  inherited;
  qryParcelas.ParamByName('DataInicial').AsDateTime:= FDataInicial;
  qryParcelas.ParamByName('DataFinal').AsDateTime  := FDataFinal;
  if FEmpreendimento > 0 then
    qryParcelas.MacroByName('WhereEmpreendimentos').AsString:= 'AND e.codigo = '+IntToStr(FEmpreendimento)
  else
    qryParcelas.MacroByName('WhereEmpreendimentos').AsString:= '';
  if FCliente > 0 then
    qryParcelas.MacroByName('WhereClientes').AsString:= 'AND cliente = ' + inttostr(FCliente)
  else
    qryParcelas.MacroByName('WhereClientes').AsString:= '';
  if FContaPagto > 0 then
    qryParcelas.MacroByName('WhereConta').ASString := 'AND conta = ' + inttostr(FContaPagto)
  else
    qryParcelas.MacroByName('WhereConta').ASString := '';

  if TotaisporConta then
    qryParcelas.MacroByName('Ordenacao').ASString := 'ORDER BY TO_ASCII(NomeEmpreendimento, ''LATIN1''), contapagto, TO_ASCII(NomeCliente, ''LATIN1''), contrato'
  else
    qryParcelas.MacroByName('Ordenacao').ASString := 'ORDER BY TO_ASCII(NomeEmpreendimento, ''LATIN1''), TO_ASCII(NomeCliente, ''LATIN1''), contrato';

end;

procedure TdtmRelatorioRecebimentos.frpRelatorioParcelasBeforePrint(Memo: TStringList; View: TfrView);
