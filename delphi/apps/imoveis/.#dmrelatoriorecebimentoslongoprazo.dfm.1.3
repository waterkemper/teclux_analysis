    Sql.Strings = (
      ';'
      'SELECT * FROM ('
      ''
      
        'SELECT contrato, cliente, nomecliente, sum(valorhistorico) as va' +
        'lorhistorico, sum(correcao) as correcao, sum(juros) as juros,'
      
        '        sum(valorhistorico+correcao+juros) as total, empreendime' +
        'nto,'
      '        (SELECT e.nome'
      '           FROM empreendimentos e'
      
        '           WHERE e.codigo = empreendimento) as NomeEmpreendiment' +
        'o'
      '         FROM'
      '(SELECT pi.Contrato,'
      '        pi.Tipo,'
      '        pi.Origem,'
      '        pi.Numero,'
      '        pi.NrPagto,'
      '        (SELECT co.cliente'
      '             FROM compradores co'
      '             WHERE co.contrato = pi.contrato AND'
      '                   co.principal) as Cliente,'
      '        (SELECT coalesce(v.razao,v.nome)'
      '             FROM vFornecedores v'
      
        '             JOIN Compradores co ON v.codigo     = co.Cliente   ' +
        '  AND'
      
        '                                    v.Tipo       = co.TipoClient' +
        'e AND'
      '                                    pi.Contrato = co.Contrato'
      '             WHERE co.Cliente     = v.codigo     AND'
      '                   co.TipoCliente = v.Tipo       AND'
      '                   co.Contrato    = pi.Contrato AND'
      '                   co.Principal) AS NomeCliente,'
      '        pi.DataVencto,'
      '        pi.ValorHistorico,'
      
        '        (SELECT ValorDevido(pi.Contrato, pi.Tipo, pi.Numero, pi.' +
        'NrPagto,'
      '                            :DataBaseParcela)) AS ValorDevido,'
      ''
      
        '        (SELECT ValorCorrigido(pi.Contrato, pi.Tipo, pi.Numero, ' +
        'pi.NrPagto,'
      
        '                               :DataBaseParcela,true)) AS ValorC' +
        'orrigido,'
      '        pi.Datapagto,'
      '        pi.ValorPagto,'
      
        '        (SELECT JurosContratuais(pi.Contrato, pi.Tipo, pi.Numero' +
        ', pi.NrPagto,'
      '                                 :DataBaseParcela)) AS Juros,'
      
        '        ((SELECT ValorCorrigido(pi.Contrato, pi.Tipo, pi.Numero,' +
        ' pi.NrPagto,'
      
        '                               :DataBaseParcela,true)) - pi.Valo' +
        'rHistorico) AS Correcao,'
      '        (SELECT vi.empreendimento from Vendasimoveis vi'
      '            WHERE vi.contrato = pi.contrato) as Empreendimento'
      'FROM ParcelasImoveis pi'
      '           JOIN VendasImoveis vi'
      '                ON    vi.Contrato = pi.Contrato'
      ''
      '      WHERE vi.Contrato = pi.Contrato AND'
      '            vi.Data    <= :DataBaseParcela AND'
      
        '            pi.datavencto BETWEEN :DataInicial AND :DataFinal AN' +
        'D'
      '            (pi.Datapagto IS NULL OR'
      '            pi.DataPagto > :DataBaseParcela) AND'
      ''
      '            CASE WHEN vi.Situacao IN ('#39'C'#39', '
      '                                      '#39'R'#39') THEN FALSE'
      '         '
      '                 WHEN vi.Situacao IN ('#39'T'#39','
      '                                      '#39'G'#39','
      '                                      '#39'S'#39') AND'
      
        '                      vi.DataAlteracao > :DataBaseParcela THEN T' +
        'RUE'
      '           '
      '                 WHEN vi.Situacao IN ('#39'F'#39','
      '                                      '#39'D'#39','
      '                                      '#39'Q'#39','
      '                                      '#39'V'#39') THEN TRUE'
      '                      '
      '                 ELSE FALSE'
      '            END'
      'ORDER BY pi.contrato, pi.Tipo, pi.Numero, pi.NrPagto'
      ')as grupo'
      '%Empreendimento'
      '%Cliente'
      'group by contrato, cliente, nomecliente, empreendimento'
      ''
      ')AS s'
      
        'ORDER BY Empreendimento, TO_ASCII(NomeCliente, '#39'LATIN1'#39'), Contra' +
        'to, Cliente')
