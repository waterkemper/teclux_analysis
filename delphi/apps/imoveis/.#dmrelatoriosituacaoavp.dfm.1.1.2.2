        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      
        'SELECT Contrato, Data, situacao, Empreendimento, NomeEmpreendime' +
        'nto, SiglaEmpreendimento,'
      '       Cliente, NomeCliente,'
      '       ValorCP, ValorLP, SaldoDevedor,'
      '       SaldoInicialCP, SaldoInicialLP,'
      '       MaisCP, MaisLP,'
      '       MenosCP, MenosLP,'
      '       (SaldoInicialCP + MaisCP - MenosCP) AS SaldoFinalCP,'
      '       (SaldoInicialLP + MaisLP - MenosLP) AS SaldoFinalLP'
      ''
      ''
      'FROM (SELECT DISTINCT vi.Contrato, vi.Empreendimento, Data,'
      ''
      '/*'
      '            (SELECT e.nome'
      '                FROM Empreendimentos e'
      
        '                       WHERE vi.empreendimento = e.codigo) AS No' +
        'meEmpreendimento,'
      ''
      '            (SELECT e.sigla'
      '                FROM Empreendimentos e'
      
        '                       WHERE vi.empreendimento = e.codigo) AS Si' +
        'glaEmpreendimento,'
      '*/'
      ''
      '           em.nome as nomeempreendimento,'
      '           em.sigla as siglaempreendimento,'
      ''
      '            comp.cliente,'
      ''
      '            /*'
      '            (SELECT co.Cliente'
      '                FROM Compradores co'
      '                WHERE co.Contrato = vi.Contrato AND'
      '                      co.Principal) AS Cliente,'
      '             */'
      ''
      '            vf.nome as nomecliente,'
      ''
      ''
      
        '            /* NomeClienteContratoImoveis(vi.Contrato) AS NomeCl' +
        'iente, */'
      ''
      '            /*'
      '             CASE WHEN vi.Situacao = '#39'V'#39' THEN '#39'[V]endido'#39
      '                  WHEN vi.Situacao = '#39'C'#39' THEN '#39'[C]ancelado'#39
      '                  WHEN vi.Situacao = '#39'Q'#39' THEN '#39'[Q]uitado'#39
      '                  WHEN vi.Situacao = '#39'S'#39' THEN '#39're[S]cindido'#39
      
        '                  WHEN vi.Situacao = '#39'T'#39' THEN '#39'[T]ransferido par' +
        'a '#39' || CAST((SELECT Contrato FROM VendasImoveis'
      
        '                                                                ' +
        '                WHERE Contrato_Origem = vi.Contrato) AS VARCHAR)'
      ''
      
        '                  WHEN vi.Situacao = '#39'F'#39' THEN '#39'trans[F]erido de ' +
        #39'   || CAST(vi.Contrato_Origem AS VARCHAR)'
      
        '                  WHEN vi.Situacao = '#39'G'#39' THEN '#39'rene[G]ociado par' +
        'a '#39' || CAST((SELECT Contrato FROM VendasImoveis'
      
        '                                                                ' +
        '                WHERE Contrato_Origem = vi.Contrato) AS VARCHAR)'
      ''
      
        '                  WHEN vi.Situacao = '#39'D'#39' THEN '#39'renegocia[D]o de ' +
        #39'   || CAST(vi.Contrato_Origem AS VARCHAR)'
      '             END AS NomeSituacao,'
      '             */'
      ''
      
        '             SituacaoContratoImoveisNaData(vi.contrato, cast(:Da' +
        'taFinal as date)) as situacao,'
      ''
      
        '             ValorCurtoPrazo(2017, vi.Contrato, :DataFinal) AS V' +
        'alorCP,'
      
        '             ValorLongoPrazo(2017, vi.Contrato, :DataFinal) AS V' +
        'alorLP,'
      
        '             SaldoDevedorImoveis(vi.Contrato, :DataFinal) AS Sal' +
        'doDevedor,'
      ''
      
        '             COALESCE((SELECT SUM(pi.AVPValor) FROM ParcelasImov' +
        'eis pi'
      '                          WHERE vi.Data < :DataInicial AND'
      '                                pi.Contrato = vi.Contrato    AND'
      '                                pi.AVPPrazo = '#39'CURTO'#39'        AND'
      '                               (pi.DataPagto IS NULL OR'
      
        '                                pi.DataPagto >= :DataInicial)), ' +
        '0) AS SaldoInicialCP,'
      ''
      
        '             COALESCE((SELECT SUM(pi.AVPValor) FROM ParcelasImov' +
        'eis pi'
      '                          WHERE vi.Data < :DataInicial AND'
      
        '                                pi.Contrato = vi.Contrato       ' +
        'AND'
      '                                pi.AVPPrazo = '#39'LONGO'#39'        AND'
      '                               (pi.DataPagto IS NULL OR'
      
        '                                pi.DataPagto >= :DataInicial)), ' +
        '0) AS SaldoInicialLP,'
      ''
      
        '             COALESCE((SELECT SUM(pi.AVPValor) FROM ParcelasImov' +
        'eis pi'
      
        '                          WHERE vi.Data BETWEEN :DataInicial AND' +
        ' :DataFinal AND'
      '                                pi.Contrato = vi.Contrato    AND'
      '                                pi.AVPPrazo = '#39'CURTO'#39'        AND'
      
        '                                pi.DataVencto > :DataInicial), 0' +
        ') AS MaisCP,'
      ''
      
        '             COALESCE((SELECT SUM(pi.AVPValor) FROM ParcelasImov' +
        'eis pi'
      
        '                          WHERE vi.Data BETWEEN :DataInicial AND' +
        ' :DataFinal AND'
      '                                pi.Contrato = vi.Contrato    AND'
      '                                pi.AVPPrazo = '#39'LONGO'#39'        AND'
      
        '                                pi.DataVencto > :DataInicial), 0' +
        ') AS MaisLP,'
      ''
      
        '             COALESCE((SELECT SUM(pi.AVPValor) FROM ParcelasImov' +
        'eis pi'
      '                          WHERE pi.Contrato = vi.Contrato AND'
      '                                pi.AVPPrazo = '#39'CURTO'#39'     AND'
      
        '                                pi.DataPagto BETWEEN :DataInicia' +
        'l AND :DataFinal), 0)'
      ''
      
        '                        +                             /* AVP Cur' +
        'to Prazo revertido na transfer'#234'ncia,'
      
        '                                                         renegoc' +
        'ia'#231#227'o ou rescis'#227'o */'
      
        '                       CASE WHEN vi.DataAlteracao BETWEEN :DataI' +
        'nicial AND :DataFinal AND'
      
        '                                 vi.Situacao IN ('#39'T'#39',           ' +
        '              /* -- [T]ransferido para */'
      
        '                                                 '#39'G'#39',           ' +
        '              /* -- rene[G]ociado para */'
      
        '                                                 '#39'S'#39')           ' +
        '              /* -- re[S]cindido       */'
      
        '                            THEN COALESCE((SELECT SUM(pi.AVPValo' +
        'r) FROM ParcelasImoveis pi'
      
        '                                              WHERE pi.Contrato ' +
        '= vi.Contrato AND'
      
        '                                                    pi.AVPPrazo ' +
        '= '#39'CURTO'#39'     AND'
      
        '                                                    pi.DataPagto' +
        ' IS NULL), 0)'
      '                            ELSE 0'
      '                       END AS MenosCP,'
      ''
      
        '             COALESCE((SELECT SUM(pi.AVPValor) FROM ParcelasImov' +
        'eis pi'
      '                          WHERE pi.Contrato = vi.Contrato    AND'
      '                                pi.AVPPrazo = '#39'LONGO'#39'     AND'
      
        '                                pi.DataPagto BETWEEN :DataInicia' +
        'l AND :DataFinal), 0)'
      '                                    '
      
        '                        +                             /* AVP Lon' +
        'go Prazo revertido na transfer'#234'ncia,'
      
        '                                                         renegoc' +
        'ia'#231#227'o ou rescis'#227'o */'
      
        '                       CASE WHEN vi.DataAlteracao BETWEEN :DataI' +
        'nicial AND :DataFinal AND'
      
        '                                 vi.Situacao IN ('#39'T'#39',           ' +
        '               /* -- [T]ransferido para */'
      
        '                                                 '#39'G'#39',           ' +
        '               /* -- rene[G]ociado para */'
      
        '                                                 '#39'S'#39')           ' +
        '               /* -- re[S]cindido       */'
      
        '                            THEN COALESCE((SELECT SUM(pi.AVPValo' +
        'r) FROM ParcelasImoveis pi'
      
        '                                              WHERE pi.Contrato ' +
        '= vi.Contrato AND'
      
        '                                                    pi.AVPPrazo ' +
        '= '#39'LONGO'#39'     AND'
      
        '                                                    pi.DataPagto' +
        ' IS NULL), 0)'
      '                            ELSE 0'
      '                       END AS MenosLP'
      ''
      '        FROM VendasImoveis vi'
      ''
      '             join empreendimentos em'
      '             on vi.empreendimento = em.codigo'
      ''
      '             join compradores comp'
      '               join vfornecedores vf'
      '               on vf.codigo = comp.cliente and'
      '                  vf.tipo = comp.tipocliente'
      ''
      '             on comp.contrato = vi.contrato'
      '                and coalesce(comp.principal,false)'
      ''
      '        WHERE TRUE'
      '          AND vi.Situacao <> '#39'R'#39
      '          AND vi.Data <= :DataFinal'
      ''
      '          %WhereEmpreendimentos'
      '          %WhereClientes'
      ''
      '     ) AS vi'
      ''
      'WHERE SaldoInicialCP <> 0 OR MaisCP <> 0 OR MaisCP <> 0 OR'
      '      SaldoInicialLP <> 0 OR MaisLP <> 0 OR MaisLP <> 0 or'
      '      SaldoDevedor <> 0'
      ''
      '      %ListaSituacao'
      ''
      '%Ordenacao'
      ''
      '/*'
      
        'ORDER BY TO_ASCII(NomeEmpreendimento, '#39'LATIN1'#39'), TO_ASCII(NomeCl' +
        'iente, '#39'LATIN1'#39'), Contrato'
      ''
      '*/'
      ''
      '/*'
      ' :AgruparEmpreendimento'
      '*/'
      '')
    RequestLive = False
    Left = 72
