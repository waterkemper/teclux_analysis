function TfrmContratosImoveis.IncluirEditarImoveisContrato(Editar: Boolean): Boolean;
var
  Usuario           : TtecUsuarios;
  vContinuar : boolean;
begin
  Result:= False;

  if  (dtmContratosImoveis.SituacaoContrato = sciRESERVADO) or
      (dtmContratosImoveis.qryContratoscontratoatual.asboolean  and
       (dtmContratosImoveis.SituacaoContrato <> sciCANCELADO)) then
  begin
    vContinuar := true;
    if dtmContratosImoveis.SituacaoContrato <> sciRESERVADO then
    begin
      Editar := true;

      if UsuarioLogin.TrocaProduto then
        Usuario := dtmContratosImoveis.ObterAutorizacao(taSENHA)
      else
        Usuario:= dtmContratosImoveis.ObterAutorizacao(taLOGIN, ctTROCAPRODUTO, ctAUTORIZADO);

      try
        if Assigned(Usuario) and Usuario.TrocaProduto then
          vContinuar := true
        else
        begin
          vContinuar := false;
          MensagemAviso(ctUSUARIOSEMPERMISSAO);
        end

      finally
        Usuario.Free;
      end;
    end;

    if vContinuar then
    begin
      dtmContratosImoveis.ReadOnlyContrato(false);
      frmCadastroImoveisContrato:=  TfrmCadastroImoveisContrato.Create(frmCadastroImoveisContrato);
      if Editar then
        Result:= dtmContratosImoveis.EditarImoveisContrato
      else
        Result:= true;
      If Result then
        try
          if Editar then
            frmCadastroImoveisContrato.Editar:= True
          else
          begin
            frmCadastroImoveisContrato.Editar:= False;
            dtmContratosImoveis.qryConsultaImoveis.macrobyname('WhereSituacao').AsString := 'and i.situacao = ''D''';
            dtmContratosImoveis.qryImoveisVendidos.Append;
          end;
          dtmContratosImoveis.qryImoveisVendidosempreendimento.ReadOnly :=
             dtmContratosImoveis.qryImoveisVendidos.RecordCount <> 0;
          Result:= frmCadastroImoveisContrato.ShowModal = mrOk;
        finally
          dtmContratosImoveis.ReadOnlyContrato;
          frmCadastroImoveisContrato.Free;
          AtualizarDisplay(Self);
          dtmContratosImoveis.FecharTabelasConsultas;;
          SetFocus;
        end;
    end;
  end
  else
    Result:= False;
end;

