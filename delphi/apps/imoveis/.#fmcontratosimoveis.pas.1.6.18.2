procedure TfrmContratosImoveis.QuitarContrato;
begin
  if not dtmContratosImoveis.PossuiParcelasemAberto then
  begin
    dtmContratosImoveis.ReadOnlyContrato(False);
    dtmContratosImoveis.EditarContrato;
    dtmContratosImoveis.SituacaoContrato:= sciQUITADO;
    dtmContratosImoveis.AtribuirDataAlteracao;
    AfterOpenContratos(Self);
    dtmContratosImoveis.ReadOnlyContrato();
  end
  else
    MensagemAviso('O contrato possui parcelas em aberto');
end;

