procedure TfrmContratosImoveis.sbnContabilizarChavesClick(Sender: TObject);
begin
  inherited;
  if sbnContabilizarChaves.Caption = 'Contabilizar F12' then
  begin
    dtmContratosImoveis.ContabilizarChaves;
    fraLancamentoContabeisChaves.sbnGerarLancamentoClick(Self);
    fraLancamentoContabeisChaves.Origem:= 'H';
    fraLancamentoContabeisChaves.VerificarLancamentosContabeis;
    dtmContratosImoveis.GravarLancamentosContabeis;
  end
  else
  if sbnContabilizarChaves.Caption = 'Extornar F12' then
  begin
    dtmContratosImoveis.ExtornarContabilizacaodasChaves;
    fraLancamentoContabeisChaves.ApagarLancamentos;
  end;
  
  InternoGravar;
  AlterarEstadoBotoes;
end;

