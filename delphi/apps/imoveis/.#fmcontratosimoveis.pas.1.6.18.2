procedure TfrmContratosImoveis.pgcContratosChange(Sender: TObject);
begin
  inherited;
  if pgcContratos.ActivePage = tstParcelas then
  begin
    if dtmContratosImoveis.qryContratosvalortotal.AsFloat <=0 then
    begin
      MensagemAviso('O Valor do contrato precisa ser preenchido');
      pgcContratos.ActivePage := tstImoveis;
      edtTotalContrato.SetFocus;
    end
    else
      dbgPArcelas.SetFocus;
  end
  else if pgcContratos.ActivePage = tstCompradores then
  begin
    dbgCompradores.SetFocus;
  end
  else if pgcContratos.ActivePage = tstImoveis then
  begin
    dbgimoveisVendidos.SetFocus;
  end
  else if pgcContratos.ActivePage = tstContabil then
    if (dtmContratosImoveis.SituacaoContrato in [sciTRANSFERENCIA, sciRENEGOCIACAO]) then
      pgcContabil.ActivePage := tstTransferencias
    else if (dtmContratosImoveis.SituacaoContrato in [sciRESCINDIDO]) then
      pgcContabil.ActivePage := tstRescisao
    else
      pgcContabil.ActivePage := tstVenda;
  end;

procedure TfrmContratosImoveis.sbnGerarParcelasClick(Sender: TObject);
begin
  inherited;
  if not (dtmContratosImoveis.SituacaoContrato in [sciVENDIDO,sciQUITADO, sciRENEGOCIADO, sciTRANSFERIDO, sciRESCINDIDO]) then
  begin
    frmCalcularParcelasImoveis := TfrmCalcularParcelasImoveis.Create(Self);
    frmCalcularParcelasImoveis.edtVencimento.Minimo:= DaysBetween(Date,
                                            dtmContratosImoveis.qryContratosdata.AsDateTime);
    frmCalcularParcelasImoveis.ShowModal;

    if frmCalcularParcelasImoveis.ModalResult = mrOK then
      dtmContratosImoveis.GerarParcelas(frmCalcularParcelasImoveis.TipoParcela,
                                        frmCalcularParcelasImoveis.Moeda,
                                        frmCalcularParcelasImoveis.NroParcela,
                                        frmCalcularParcelasImoveis.Intervalo,
                                        frmCalcularParcelasImoveis.Vencimento,
                                        frmCalcularParcelasImoveis.DataBase,
                                        frmCalcularParcelasImoveis.DataJuros,
                                        frmCalcularParcelasImoveis.TaxaJuros,
                                        frmCalcularParcelasImoveis.ValorParcela,
                                        frmCalcularParcelasImoveis.JurosCompostos);
    frmCalcularParcelasImoveis.Free;
    pgcContratos.ActivePage:= tstParcelas;
    dbgPArcelas.SetFocus;
    TotaisdeParcelas(False);
  end;
end;

