procedure TfrmContratosImoveis.DisplayCompradores(Sender: TObject);
var Comprador: String;
begin
  with dtmContratosImoveis do
  begin
    if not (qryCompradores.State = dsinactive) then
    begin
      if qryCompradores.RecordCount > 1 then
      begin
        qryCompradores.First;
        while not qryCompradores.Eof do
        begin
          if qryCompradoresprincipal.asBoolean then
          begin
            Comprador:= UpperCase(qryCompradoresnomecliente.AsString) + ' &  OUTROS ';
