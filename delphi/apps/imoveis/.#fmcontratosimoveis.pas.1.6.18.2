  DisplayValorHistorico := 0;
  DisplayValorContratado:= 0;
  DisplayValorHistoricoAberto := 0;
  DisplayValorContratadoAberto:= 0;
  DisplayValorDevido    := 0;
  DisplayValorDevidoAberto    := 0;
  DisplayValorPago      := 0;
  DisplayValorCorrecao  := 0;
  DisplayValorJuros     := 0;
  DisplayValorCorrecaoAberto  := 0;
  DisplayValorJurosAberto     := 0;
  DisplayValorDiferenca := 0;
  dtxValorHistorico.Clear;
  dtxValorContratado.Clear;
  dtxValorDevido.Clear;
  dtxValorPago.Clear;
  dtxJuros.Clear;
  dtxCorrecao.Clear;
  dtxDiferenca.Clear;

  with dtmContratosImoveis do
  begin
    if not Limpar then
    begin
      GuardarRegistroAtual(qryParcelasContrato, True);
      qryParcelasContrato.First;
      while not qryParcelasContrato.Eof do
      begin
        DisplayValorHistorico := DisplayValorHistorico  + qryParcelasContratovalorhistorico.AsCurrency;
        DisplayValorContratado:= DisplayValorContratado + qryParcelasContratovalorcontratado.AsCurrency;
        DisplayValorDevido    := DisplayValorDevido     + qryParcelasContratovalordevido.AsCurrency;
        DisplayValorPago      := DisplayValorPago       + qryParcelasContratovalorpagto.AsCurrency;
        DisplayValorCorrecao  := DisplayValorCorrecao   + qryParcelasContratocorrecao.AsCurrency;
        DisplayValorJuros     := DisplayValorJuros      + qryParcelasContratojuros.AsCurrency;
        DisplayValorDiferenca := DisplayValorDiferenca  + qryParcelasContratodiferenca.AsCurrency;
        
        if qryParcelasContratodatapagto.IsNull then
        begin
          DisplayValorHistoricoAberto := DisplayValorHistoricoAberto  + qryParcelasContratovalorhistorico.AsCurrency;
          DisplayValorContratadoAberto:= DisplayValorContratadoAberto + qryParcelasContratovalorcontratado.AsCurrency;
          DisplayValorDevidoAberto    := DisplayValorDevidoAberto     + qryParcelasContratovalordevido.AsCurrency;
          DisplayValorCorrecaoAberto  := DisplayValorCorrecaoAberto   + qryParcelasContratocorrecao.AsCurrency;
          DisplayValorJurosAberto     := DisplayValorJurosAberto      + qryParcelasContratojuros.AsCurrency;
        end;
        qryParcelasContrato.Next;
      end;
      VoltarRegistroAtual(qryParcelasContrato);

      dtxValorHistorico.Text  := currtostr(DisplayValorHistorico);
      dtxValorContratado.Text := currtostr(DisplayValorContratado);
      dtxValorDevido.Text     := currtostr(DisplayValorDevido);
      dtxValorPago.Text       := currtostr(DisplayValorPago);
      dtxJuros.Text           := currtostr(DisplayValorJuros);
      dtxCorrecao.Text        := currtostr(DisplayValorCorrecao);
      dtxDiferenca.Text       := currtostr(DisplayValorDiferenca);

      dtxValorHistoricoAberto.Text  := currtostr(DisplayValorHistoricoAberto);
      dtxValorContratadoAberto.Text := currtostr(DisplayValorContratadoAberto);
      dtxValorDevidoAberto.Text     := currtostr(DisplayValorDevidoAberto);
      dtxJurosAberto.Text           := currtostr(DisplayValorJurosAberto);
      dtxCorrecaoAberto.Text        := currtostr(DisplayValorCorrecaoAberto);
    end;
  end;
end;

