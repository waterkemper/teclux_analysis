end;

function TfrmContratosImoveis.ValidarLancamentos: Boolean;
begin
  if dtmContratosImoveis.SituacaoContrato = sciRESCINDIDO then
  begin
    Result:= False;
    dtmContratosImoveis.OperacaoRescisao:= 'EV';
    if LancamentosEstornoVenda.VerificarLancamentosContabeis then
    begin
      dtmContratosImoveis.GravarLancamentosContabeis;
      dtmContratosImoveis.Perpetrar([dtmLancamentoContabilidade.qryLancamentosDocumentos]);
      dtmContratosImoveis.OperacaoRescisao:= 'EI';
      if LancamentosEstornoImpostos.VerificarLancamentosContabeis then
      begin
        dtmContratosImoveis.GravarLancamentosContabeis;
        dtmContratosImoveis.Perpetrar([dtmLancamentoContabilidade.qryLancamentosDocumentos]);
        dtmContratosImoveis.OperacaoRescisao:= 'EP';
        if LancamentoEstornoValoresPagos.VerificarLancamentosContabeis then
        begin
          dtmContratosImoveis.GravarLancamentosContabeis;
          dtmContratosImoveis.Perpetrar([dtmLancamentoContabilidade.qryLancamentosDocumentos]);
          Result:= True;
          LancamentosValidados:= true;
        end
        else
          MensagemAviso('Lançamentos do estorno dos valores pagos não estão corretos');
      end
      else
        MensagemAviso('Lançamentos do estorno dos impostos sobre a rescisão não estão corretos');
    end
    else
      MensagemAviso('Lançamentos do estorno dos Valores de venda não estão corretos');
    if not Result then
      LancamentosValidados:= False;
  end
  else
    Result:= True;

  if dtmContratosImoveis.SituacaoContrato > sciRESERVADO then
  begin
    dtmContratosImoveis.NrOrigem:= 'V';
    if not fraLancamentoContabeisVenda.VerificarLancamentosContabeis then
    begin
      MensagemAviso('Lançamentos contábeis de venda não estão corretos');
      Result:= False;
    end
    else
    begin
      dtmContratosImoveis.GravarLancamentosContabeis;
      dtmContratosImoveis.Perpetrar([dtmLancamentoContabilidade.qryLancamentosDocumentos]);
    end;

    dtmContratosImoveis.NrOrigem:= 'H';
    if not fraLancamentoContabeisChaves.VerificarLancamentosContabeis then
    begin
      MensagemAviso('Lançamentos contábeis da entrega de chaves não estão corretos');
      Result:= False;
    end
    else
    begin
      dtmContratosImoveis.GravarLancamentosContabeis;
      dtmContratosImoveis.Perpetrar([dtmLancamentoContabilidade.qryLancamentosDocumentos]);
    end;

    dtmContratosImoveis.NrOrigem:= 'G';
    if (dtmContratosImoveis.SituacaoContrato in [sciTRANSFERENCIA, sciRENEGOCIACAO]) then
    begin
      if dtmContratosImoveis.qryContratos.State = dsinsert then
        LancamentosTransf.AbrirLancamentos('G', dtmContratosImoveis.GetNrOrigem, False);

      if not LancamentosTransf.VerificarLancamentosContabeis then
      begin
        MensagemAviso('Lançamentos contábeis da transferência/renegociação não estão corretos');
        Result:= False;
      end
      else
      begin
        dtmContratosImoveis.GravarLancamentosContabeis;
        dtmContratosImoveis.Perpetrar([dtmLancamentoContabilidade.qryLancamentosDocumentos]);
      end;
    end;
  end;

end;

