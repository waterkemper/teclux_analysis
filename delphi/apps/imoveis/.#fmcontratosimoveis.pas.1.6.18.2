  if dtmContratosImoveis.SituacaoContrato <> sciTRANSFERIDO then
    dtmContratosImoveis.OperacaoTransferencia:= False;
  if dtmContratosImoveis.SituacaoContrato <> sciRENEGOCIADO then
    dtmContratosImoveis.OperacaoRenegociacao:= FALSE;
  dtmContratosImoveis.OperacaoRescisao:= Operacao;
  dtmContratosImoveis.NrOrigem:= Origem;
