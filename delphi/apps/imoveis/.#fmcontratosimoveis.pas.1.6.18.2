procedure TfrmContratosImoveis.AlterarEstadoBotoes;
begin
  inherited;

  //??????
  {
  if (dtmContratosImoveis.SituacaoContrato in [sciRENEGOCIADO, sciTRANSFERIDO]) then
    sbnAlterarSituacao.Caption:= vstrAlterarSituacaoContratoImoveis[dtmContratosImoveis.SituacaoContrato]+'PARA Nº '+dtmContratosImoveis.qryContratoscontrato_gerado.AsString+' F11'
  else if (dtmContratosImoveis.SituacaoContrato in [sciRENEGOCIADO, sciTRANSFERIDO]) then
    sbnAlterarSituacao.Caption:= vstrAlterarSituacaoContratoImoveis[dtmContratosImoveis.SituacaoContrato]+'DE Nº '+dtmContratosImoveis.qryContratoscontrato_origem.AsString+' F11'
  else
    sbnAlterarSituacao.Caption:= vstrAlterarSituacaoContratoImoveis[dtmContratosImoveis.SituacaoContrato]+' F11';
  }

  sbnAlterarSituacao.Enabled:= dtmContratosImoveis.SituacaoContrato = sciRESERVADO;


  if (dtmContratosImoveis.SituacaoContrato in [sciVENDIDO,sciQUITADO, sciRENEGOCIACAO, sciTRANSFERENCIA]) then
  begin
    sbnIncluirComprador.Enabled:= False;
    sbnExcluirComprador.Enabled:= False;
    sbnInserirImoveis.Enabled  := False;
    sbnExcluirImoveis.Enabled  := False;
    sbnRecebimentos.Enabled    := True;
    sbnIncluirParcelas.Visible := False;
    sbnExcluirParcelas.Visible := False;
    sbnGerarParcelas.Visible   := False;
  end
  else if (dtmContratosImoveis.SituacaoContrato in [sciRENEGOCIADO, sciTRANSFERIDO, sciRESCINDIDO]) then
  begin
    sbnIncluirComprador.Enabled:= False;
    sbnExcluirComprador.Enabled:= False;
    sbnInserirImoveis.Enabled  := False;
    sbnExcluirImoveis.Enabled  := False;
    sbnRecebimentos.Enabled    := False;
    sbnIncluirParcelas.Visible := False;
    sbnExcluirParcelas.Visible := False;
    sbnGerarParcelas.Visible   := False;
  end
  else
  begin
    sbnIncluirComprador.Enabled:= True;
    sbnExcluirComprador.Enabled:= True;
    sbnInserirImoveis.Enabled  := True;
    sbnExcluirImoveis.Enabled  := True;
    sbnRecebimentos.Enabled    := False;
    sbnIncluirParcelas.Visible := True;
    sbnExcluirParcelas.Visible := True;
    sbnGerarParcelas.Visible   := True;
  end;

  if (dtmContratosImoveis.SituacaoContrato in [SCIreservado, sciNENHUM, sciRENEGOCIADO, sciTRANSFERIDO, sciRESCINDIDO]) then
  BEGIN
    sbnReceberPArcela.Visible      := False;
    sbnLancamentosContabeis.Visible:= False;
  end
  else
  begin
    sbnReceberPArcela.Visible      := True;
    sbnLancamentosContabeis.Visible:= True;
  end;

  if not (dtmContratosImoveis.SituacaoContrato in [sciRESCINDIDO, sciRENEGOCIADO, sciTRANSFERIDO]) then
    sbnAlteracao.Enabled := dtmContratosImoveis.qryContratos.RecordCount > 0
  else
    sbnAlteracao.Enabled := False;

  if sbnSalvar.Enabled then
    sbnAlteracao.Enabled := false;


  sbnImprimirContrato.Enabled:= dtmContratosImoveis.qryContratos.RecordCount > 0;


  if (dtmContratosImoveis.SituacaoContrato in [sciCANCELADO]) then
  begin
    sbnExcluir.Enabled:= True;
    sbnExcluir.Caption := sbnExcluirCaption;
  end
  else if (dtmContratosImoveis.SituacaoContrato in  [sciVENDIDO, sciRESERVADO, sciRESCINDIDO, sciTRANSFERENCIA, sciRENEGOCIACAO]) then
  begin
    sbnExcluir.Caption := 'Cancelar F6';
    sbnExcluir.Enabled:= True;
  end
  else
  begin
    sbnExcluir.Enabled:= false;
    sbnExcluir.Caption := sbnExcluirCaption;
  end;

  if sbnSalvar.Enabled then
    sbnExcluir.Enabled := false;
  

  if dtmContratosImoveis.SituacaoContrato in [sciCANCELADO, sciRESCINDIDO, sciTRANSFERIDO] then
    dtxSituacao.Font.Color    := clRed
  else
    dtxSituacao.Font.Color := Font.Color;

  {Vendido, Transferido de, Renegocidado de}
  if dtmContratosImoveis.qryContratosdatachaves.IsNull
     and not dtmContratosImoveis.qryContratoshabite_se.IsNull
     and ((dtmContratosImoveis.SituacaoContrato in [sciTRANSFERENCIA, sciRENEGOCIACAO])
          or
          ((dtmContratosImoveis.SituacaoContrato in [sciVENDIDO])
            and (fraLancamentoContabeisVenda.qryLancamentos.RecordCount <> 0))) then
  begin
    sbnContabilizarChaves.Caption := 'Contabilizar F12';
    sbnContabilizarChaves.hint := 'Gerar a contabilização da entrega da chave';
    sbnContabilizarChaves.Enabled := True;
  end
  else
  if not dtmContratosImoveis.qryContratosdatachaves.IsNull
     and not dtmContratosImoveis.qryContratoshabite_se.IsNull
     and ((dtmContratosImoveis.SituacaoContrato in [sciTRANSFERENCIA, sciRENEGOCIACAO])
          or
          ((dtmContratosImoveis.SituacaoContrato in [sciVENDIDO])
            and (fraLancamentoContabeisVenda.qryLancamentos.RecordCount <> 0))) then
  begin
    sbnContabilizarChaves.Caption := 'Extornar F12';
    sbnContabilizarChaves.hint := 'Gerar o extorno da contabilização da entrega da chave';
    sbnContabilizarChaves.Enabled := True;
  end
  else
  begin
    sbnContabilizarChaves.Caption := 'Contabilizar F12';
    sbnContabilizarChaves.hint := 'Gerar a contabilização da entrega da chave';
    sbnContabilizarChaves.Enabled := false;
  end;

end;

