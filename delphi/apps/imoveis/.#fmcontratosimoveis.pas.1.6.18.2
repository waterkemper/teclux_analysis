procedure TfrmContratosImoveis.CancelarAlteracoes;
begin
  if ValidouDados then
  begin
    edtQtdeImoveis.Clear;
    edtTotalImoveis.Clear;
    LblCompradores.Caption:= '';
    edfNumeroCOntrato.Enabled:= True;
    TotaisdeParcelas(True);
  end;
end;

constructor TfrmContratosImoveis.Create(AOwner: TComponent);
begin
  try
    dtmContratosImoveis:= TdtmContratosImoveis.Create(Self);
    inherited;
    AtribuirPrincipal:= False;
    LancamentosValidados:= True;
    sbnExcluirCaption    := sbnExcluir.Caption;
    sbnAlterarSituacao.Enabled:= False;
    sbnAlteracao.Enabled:= False;
    sbnImprimirContrato.Enabled:= False;
    sbnRecebimentos.Enabled    := False;
    DataSet := dtmContratosImoveis.qryContratos;
    dtmContratosImoveis.AtualizarDisplay:= AtualizarDisplay;
    fraCreditoVenda.TipoPesquisa:= pesCONTACREDITO;
    fraIndexadorAteHabitese.TipoPesquisa  := pesMOEDAS;
    fraIndexadorAposHabitese.TipoPesquisa := pesMOEDAS;
    ConsultaContrato := TfraConsultaCodigo.Create(self);
    ConsultaContrato.Name := 'fraConsultaContrato';
    ConsultaContrato.edfCodigo.DataSource := dtmContratosImoveis.dsrContratos;
    ConsultaContrato.edfCodigo.DataField := 'Contrato';
    ConsultaContrato.edfCodigo.Operacao := opATRIBUICAO;
    ConsultaContrato.AbrirTabelaProcura := false;
    ConsultaContrato.TipoCliente := 'C';
    ConsultaContrato.Tipovfornecedor := 'C';
    ConsultaContrato.TipoPesquisa := pesCONTRATOSIMOVEIS;
    ConsultaContrato.OnFound := AbrirContrato;


    dtmContratosImoveis.AfterOpenContratos:= AfterOpenContratos;
    dbgImoveisVendidos.CampoSequencial:= 'ordem';
    dtmContratosImoveis.qryImoveisVendidos.After_Open := dbgImoveisVendidos.RefazerOrdenacaoSequencial;
//    dbgImoveisVendidos.OnDelete := dtmCadastroProdutos.ExcluirProdutoComposto;
  dtmContratosImoveis.AfterScrollChaves:= AfterScrollChaves;
    AtribuirDadosVendaImoveis;
    dtmContratosImoveis.AfterScrollCompradores:= DisplayCompradores;
    dtmContratosImoveis.AfterCancelContratos  := BeforeCancelContratos;
    AtribuirDadosChavesVendaImoveis;
    AtribuirDadosFramesAlteracoes;
    atribuirDAdosTransferencias;

    edtdataContrato.Minimo := DaysBetween(DataAtual,ParSistema.DataContabil)-1;
    edtdataChaves.Minimo := DaysBetween(DataAtual,ParSistema.DataContabil)-1;

    edtdataContrato.MensagemPadronizada := ExibirMensagemPadronizadadataContrato;
    edtdataChaves.MensagemPadronizada := ExibirMensagemPadronizadaDataChaves;

    sbnContabilizarChaves.Enabled := false;


   except
      on E: Exception do ShowMessage(E.Message);
   end;
end;

destructor TfrmContratosImoveis.Destroy;
begin
  //VarRecebimentos := nil;
  dtmContratosImoveis := nil;
  inherited;
  frmContratosImoveis := nil;
end;

function TfrmContratosImoveis.InternoCancelar: Boolean;
begin
  Result := inherited InternoCancelar;
  if Result then
  begin
    if dtmContratosImoveis.qryImoveis.UpdatesPending then
      dtmContratosImoveis.qryImoveis.CancelUpdates;
    ValidouDados:= True;
    CancelarAlteracoes;
    TotaisdeParcelas(True);
  end;
end;

function TfrmContratosImoveis.InternoExcluir: Boolean;
begin
  with dtmContratosImoveis do
  begin
    case SituacaoContrato of
      sciVENDIDO :        {passar de vendido para reservado}
      begin
        if dtmContratosImoveis.qryContratosdata.AsDateTime > ParSistema.DataContabil then
        begin
          if not (ExisteParcelasPagas) then
          begin
            if MensagemConfirmacao(Format(ctCONFIRMECANCELAR,['o Contrato'])) = smbOK then
            begin
              NrOrigem:= 'V';
              ApagarLancamentosContabeis(NrOrigem, GetNrOrigem);
              fraLancamentoContabeisVenda.qryLancamentos.Params[0].Clear;
              fraLancamentoContabeisVenda.qryLancamentos.Params[1].Clear;

              NrOrigem:= 'H';
              ApagarLancamentosContabeis(NrOrigem, GetNrOrigem);
              fraLancamentoContabeisChaves.qryLancamentos.Params[0].Clear;
              fraLancamentoContabeisChaves.qryLancamentos.Params[1].Clear;

              AlterarEstadoImoveis('R', True);  {tornar o imovel reservado}

//              if ReadOnly then
//                Readonly:= False;
              ReadOnlyContrato(false);

              AlterarEstadoContrato('R');
              EditarContrato;
              qryContratosdatachaves.AsString:= '';
              qryContratos.Post;
              Perpetrar([qryImoveis, qryContratos]);

//              ReadOnlyContrato();

              RefazConsultaPorNome(qryContratos,['Contrato'],[qryContratoscontrato.AsVariant]);

            end;
          end
          else
            MensagemAviso(Format(ctPARCELASNAOPODEMSEREXCLUIDAS,[qryContratosContrato.AsString]));
        end
        else
        MensagemAviso('A data de venda "' + DateToStr(dtmContratosImoveis.qryContratosdata.AsDateTime) +
                      '" é anterior à data contábil "' + DateToStr(ParSistema.DataContabil) + '".');
      end;

      sciRESERVADO :  {passar de reservado para cancelado}
      begin
        if MensagemConfirmacao(Format(ctCONFIRMECANCELAR,['o Contrato'])) = smbOk then
        begin
          if not (ExisteParcelasPagas) then
          begin
            AlterarEstadoImoveis('D',True); {tornar o imóvel disponível}
            AlterarEstadoContrato('C');
            EstornarParcelas;
            Perpetrar([qryImoveis, qryContratos, qryParcelasContrato]);

//            ReadOnlyContrato(False);
            RefazConsultaPorNome(qryContratos,['Contrato'],[qryContratoscontrato.AsVariant]);

          end
          else
            MensagemAviso(Format(ctPARCELASNAOPODEMSEREXCLUIDAS,[qryContratosContrato.AsString]));
        end;
      end;

      sciCANCELADO :
      begin
        if MensagemConfirmacao(Format(ctCONFIRMEEXCLUIR,['o Contrato'])) = smbOk then
        begin
          if not (ExisteParcelasPagas) then
          begin
            ReadOnlyContrato(False);
            DeletarDadosContrato;
            perpetrar([qryCompradores, qryImoveisVendidos, qryParcelasContrato, qryContratos]);
            ReadOnlyContrato();
          end
          else
            MensagemAviso(Format(ctPARCELASNAOPODEMSEREXCLUIDAS,[qryContratosContrato.AsString]));
        end;
      end;


      sciRESCINDIDO :  {passar de rescindido para vendido ou transferido_de ou renegociado_de}
      begin
        if MensagemConfirmacao('Este contrato foi rescindido. Deseja reverter esta operação?') = smbok then
        begin
          ReadOnlyContrato(false);
          AlterarEstadoImoveis('V', True);
//          AlterarEstadoContrato('V');
          EditarContrato;
          if qryContratossituacao_contrato_origem.AsString = 'T' then {'T',   -- [T]ransferido para}
            qryContratossituacao.AsString := 'F'                {'F',   -- trans[F]erido de}
          else
          if qryContratossituacao_contrato_origem.AsString = 'G' then {'G',   -- Rene[G]ociado para}
            qryContratossituacao.AsString := 'D'                {'D',   -- Renegocia[D]o de}
          else
            qryContratossituacao.AsString := 'V';               {'V',   -- [V]endido}
          qrycontratos.Post;

          ExcluirLancamentos(LancamentosEstornoVenda,'EV','G');
          ExcluirLancamentos(LancamentosEstornoImpostos,'EI','G');
          ExcluirLancamentos(LAncamentoEstornoValoresPagos,'EP','G');

          Perpetrar([qryImoveis, qryContratos]);

//          ReadOnlyContrato();
          RefazConsultaPorNome(qryContratos,['Contrato'],[qryContratoscontrato.AsVariant]);

        end;
      end;

{  situacao alterada para permitir a operação somente no último contrato
   else if SituacaoContrato = sciTRANSFERIDO then }
      sciTRANSFERENCIA :
      begin
        if MensagemConfirmacao('Este contrato é de transferência. Deseja reverter esta operação?') = smbok then
        begin
          if PossuiParcelasPagas then
            MensagemAviso(Format(ctPARCELASNAOPODEMSEREXCLUIDAS,[qryContratosContrato.AsString]))
          else
          begin
            ReadOnlyContrato(False);
            DeletarLancamentosGeradosTransferencia;
            SetarSituacaoContratoOrigem;
            DeletarDadosContrato;
            perpetrar([dtmLancamentoContabilidade.qryLancamentosDocumentos,
                      qryCompradores, qryImoveisVendidos, qryParcelasContrato, qryContratos, qryContratosOrigem]);
            RefazConsultaPorNome(qryContratos,['Contrato'],[contrato_origem]);

          end
        end;
      end;

      sciRENEGOCIACAO :
      begin
        if MensagemConfirmacao('Este contrato é de renegociação. Deseja reverter esta operação?') = smbok then
        begin
          if PossuiParcelasPagas then
            MensagemAviso(Format(ctPARCELASNAOPODEMSEREXCLUIDAS,[qryContratosContrato.AsString]))
          else
          begin
            ReadOnlyContrato(False);
            DeletarLancamentosGeradosRenegociacao;
            SetarSituacaoContratoOrigem;
            DeletarDadosContrato;
            perpetrar([dtmLancamentoContabilidade.qryLancamentosDocumentos,
                      qryCompradores, qryImoveisVendidos, qryParcelasContrato, qryContratos, qryContratosOrigem]);
            RefazConsultaPorNome(qryContratos,['Contrato'],[contrato_origem]);
          end
        end;
      end;
    end;
  end;
end;

function TfrmContratosImoveis.InternoGravar: Boolean;
begin
  Result:= inherited InternoGravar;
  if Result then
  begin
    if dtmContratosImoveis.qryParcelasContrato.IsEmpty then
        MensagemErro('Não há parcelas cadastradas.')
    else
    begin
      if ValidarLancamentos then
        if dtmContratosImoveis.GravarContrato then
          edfNumeroCOntrato.SetFocus;
    end;
  end;
  TotaisdeParcelas(False);
end;

function TfrmContratosImoveis.InternoIncluir: Boolean;
begin
  Result := inherited InternoIncluir;
  if CtrlOn then
  begin
    if dbgimoveisVendidos.Focused then
      IncluirEditarImoveisContrato(False)
    else if dbgCompradores.Focused then
      IncluirEditarCompradoresContrato(False);
  end
  else
  begin
    dtmContratosImoveis.IncluirContrato;
    if Result then
    begin
      AfterOpenContratos(Self);
      pgcContratos.ActivePage:= tstCompradores;
      edtdataContrato.SetFocus;
      edtDatabase.Text:= edtdataContrato.Text;
      edfNumeroCOntrato.Enabled:= false;
      DisplayCompradores(Self);
      TotaisdeParcelas(True);
    end;
  end;
end;

function TfrmContratosImoveis.InternoPesquisar(Titulo: String): Integer;
begin
  if CtrlOn then
  begin
    if flkVendedor.Focused then
      if not dtmContratosImoveis.ReadOnly then
      begin
        TipoPesquisa:= pesVENDEDORES;
        dtmContratosImoveis.AbreTabelasConsulta(TipoPesquisa);
        Titulo:= 'Vendedores';
        result:= inherited InternoPesquisar(Titulo);
        if result = mrOK then
          dtmContratosImoveis.Selecionar(TipoPesquisa);

        CtrlOn := true;
        AlterarEstadoBotoes;
      end;
  end;
end;

function TfrmContratosImoveis.JanelaPesquisa: TfrmConsultaBasica;
begin
  Jan := TfrmConsultaPorCampo.Create(nil);
  Jan.ConsultaInterativa := Not (TipoPesquisa in [pesVENDEDORES]) and CtrlOn;
  Result := Jan
end;

procedure TfrmContratosImoveis.KeyDown(var Key: Word; Shift: TShiftState);
begin
  inherited;
  if ((Key = TeclaEditarRegistro) and (Shift = [ssctrl])) then
  begin
    if dbgCompradores.Focused then
      IncluirEditarCompradoresContrato(True)
    else if dbgimoveisVendidos.Focused then
      IncluirEditarImoveisContrato(True)
    else if dbgPArcelas.Focused then
      IncluirEditarParcelasContrato(True)
  end
  else if ((Key = VK_Delete) and (Shift = [ssctrl])) then
  begin
    if dbgCompradores.Focused then
      sbnExcluirCompradorClick(Self)
    else if dbgimoveisVendidos.Focused then
      sbnExcluirImoveisClick(Self)
    else if dbgPArcelas.Focused then
      sbnExcluirParcelasClick(Self);
  end;

  if (key = VK_F10) then
  begin
    if sbnAlterarSituacao.Enabled then
      sbnAlterarSituacaoClick(Self);
  end;

  if (key = VK_F11) then
  begin
    if sbnAlteracao.Enabled then
      sbnAlteracaoClick(Self);
  end;

  if (key = VK_F12) then
  begin
    if sbnContabilizarChaves.Enabled then
      sbnContabilizarChavesClick(Self);
  end;

  if ((Key =  VK_G) and (shift = [ssctrl])) then
  begin
    if dbgPArcelas.Focused then
      if sbnGerarParcelas.Enabled then
        sbnGerarParcelasClick(Self);
  end;

  if not CtrlOn then
  begin
    if (key = VK_F9) then
      if sbnProcurar.Enabled then
      begin
        ConsultaContrato.InternoPesquisar('Contratos');
        Self.SetFocus;
      end;
  end;

  if (key = VK_F8) then
  begin
    if not CtrlOn then
      if sbnRecebimentos.Enabled then
        sbnRecebimentosClick(Self)
    else
      if sbnReceberPArcela.Enabled then
        sbnReceberPArcelaClick(Self)
  end;

  if (key = VK_F7) then
  begin
    if not CtrlOn then
      if sbnImprimirContrato.Enabled then
        sbnImprimirContratoClick(Self)
  end;

end;

procedure TfrmContratosImoveis.OperacaoPadrao(Value: array of Variant);
begin
  inherited;
  with dtmContratosImoveis do
  begin
    if Length(Value) > 0 then
      RefazConsultaPorNome(qryContratos,['Contrato'],[Value[0]])
    else
      dtmContratosImoveis.RefazConsultaContrato;
    edfNumeroCOntrato.SetFocus;

    if (high(Value)=2) then
    begin
      Application.ProcessMessages;
      Close;
    end;
  end;
end;

