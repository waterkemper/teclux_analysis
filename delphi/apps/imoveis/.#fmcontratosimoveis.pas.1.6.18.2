begin
  inherited;
  AbrirRecebimentos(True);
end;

function TfrmContratosImoveis.AbrirRecebimentos(QuitacaoLote: Boolean): Boolean;
begin
  dtmContratosImoveis.CapturarParcelaAtual;
  if not QuitacaoLote then
  begin
    with dtmContratosImoveis do
    begin
      dtmContratosImoveis.QuitarDiversas:= False;

      if not assigned(frmrecebimentos) then
        frmrecebimentos:= Tfrmrecebimentos.Create(frmrecebimentos)
      else
        VerificarForm;

      try
        Result:= Frmrecebimentos.ShowModal = mrOk;
      finally
        with dtmContratosImoveis do
        begin
          RefazConsultaPorNome(qryParcelasContrato,['Contrato'], [qryContratoscontrato.AsVariant]);
        end;
        frmrecebimentos.Free;
        dbgPArcelas.SetFocus;
      end;
    end;
  end
  else
  begin
    dtmContratosImoveis.QuitarDiversas:= True;
    frmQuitacaoParcelasLote:= TfrmQuitacaoParcelasLote.Create(frmQuitacaoParcelasLote);
    try
      Result:= frmQuitacaoParcelasLote.ShowModal = mrOk;
    finally
      with dtmContratosImoveis do
      begin
        RefazConsultaPorNome(qryParcelasContrato,['Contrato'], [qryContratoscontrato.AsVariant]);
      end;
      frmQuitacaoParcelasLote.Free;
      SetFocus;
    end;
  end;
  dtmContratosImoveis.VoltarParcelaEditada;
end;

procedure TfrmContratosImoveis.sbnReceberPArcelaClick(Sender: TObject);
begin
  inherited;
  if dtmContratosImoveis.qryParcelasContratodatapagto.AsString <> '' then
    if dtmContratosImoveis.qryParcelasContratodatapagto.AsDateTime > ParSistema.DataContabil then
      AbrirRecebimentos(False)
    else
      MensagemAviso('Não é possível alterar o recebimento'+#10#13+Format(ctDATACONTABILANTERIOR,['Data de recebimento',
                                                                                                 'a data contábil',
                                                                                                 parSistema.DataContabilString]))
  else
