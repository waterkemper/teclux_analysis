procedure TfrmContratosImoveis.AfterScrollChaves(Sender: TObject);
var Estado: Boolean;
begin
  if dtmContratosImoveis.ApagarLancamentos then
  begin
    ApagartodosLancamentosContabeis(fraLancamentoContabeisChaves, 'H');
  end
