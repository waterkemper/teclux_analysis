    if edtdataContrato.Text <> '' then
      edtdataChaves.Minimo := NDiasLimiteData(edtdataContrato.Text);
  end;
end;

procedure TfrmContratosImoveis.ExibirMensagemPadronizadaDataChaves;
begin
  if strtodate(edtdataChaves.Text) <= ParSistema.DataContabil then
  begin
    MensagemAviso(format(ctDATACONTABILMAIORDATALANCTO, ['das chaves',
                     edtDataChaves.Text, 'contábil', ParSistema.DataContabilstring]));
    edtdataChaves.SetFocus;
  end
  else
  if strtodate(edtdataChaves.Text) < strtodate(edtdataContrato.Text) then
  begin
    MensagemAviso(format(ctDATACONTABILMAIOROUIGUALDATALANCTO, ['das chaves',
                     edtDataChaves.Text, 'do contrato', edtDataContrato.Text]));
    edtdataChaves.SetFocus;
  end;
end;

