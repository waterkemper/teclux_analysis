procedure TfrmContratosImoveis.sbnAlteracaoClick(Sender: TObject);
begin
  inherited;
  frmAlteracoes := TfrmAlteracoes.Create(Self);
  try
    frmAlteracoes.ShowModal;
    if frmAlteracoes.ModalResult = mrok then
    begin
      dtmContratosImoveis.DataAlteracao:= StrToDate(frmAlteracoes.edtData.Text);
      if dtmContratosImoveis.DataAlteracao > ParSistema.DataContabil then
      begin
        if frmAlteracoes.Alteracao = 'Q' then
          QuitarContrato
        else if frmAlteracoes.Alteracao = 'R' then
          RescindirContrato
        else if frmAlteracoes.Alteracao = 'T' then
          TransferirContrato
        else if frmAlteracoes.Alteracao = 'G' then
           RenegociarContratos;
      end
      else
        MensagemAviso(Format(ctDATACONTABILMAIORDATALANCTO,['data de alteração',
                                                            datetostr(dtmContratosImoveis.DataAlteracao),
                                                            'data contábil',
                                                            ParSistema.DataContabilString]));
    end;
  finally
    frmAlteracoes.Free;
  end;
end;

procedure TfrmContratosImoveis.RescindirContrato;
