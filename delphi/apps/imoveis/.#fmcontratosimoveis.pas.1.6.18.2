  edtTotalImoveis.Text:= FormatFloat('###,###,###,##0.00',dtmContratosImoveis.CalcularValorTotalImoveis);

  if (dtmContratosImoveis.SituacaoContrato in [sciVENDIDO,sciQUITADO, sciRENEGOCIADO, sciTRANSFERIDO, sciRESCINDIDO]) then
