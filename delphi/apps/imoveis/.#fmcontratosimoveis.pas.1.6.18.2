function TfrmContratosImoveis.IncluirEditarParcelasCOntrato(Editar: Boolean): Boolean;
begin
  try
    frmCadastroParcelasContrato:= TfrmCadastroParcelasContrato.Create(frmCadastroParcelasContrato);

    if Editar then
      Result:= dtmContratosImoveis.EditarParcela
    else
    begin
      Result:= dtmContratosImoveis.IncluirParcela;
      if Result then
        dtmContratosImoveis.IncluirInformacoes;
    end;
    if Result then
      Result:= frmCadastroParcelasContrato.ShowModal = mrOk;
  finally
     TotaisdeParcelas(False);
     frmCadastroParcelasContrato.Free;
  end;
end;

procedure TfrmContratosImoveis.dbgParcelasDblClick(Sender: TObject);
begin
  inherited;
  if (dtmContratosImoveis.SituacaoContrato in [sciRESERVADO]) then
  begin
    if (dtmContratosImoveis.qryParcelasContratodatapagto.AsString = '') then
      IncluirEditarParcelasContrato(True)
    else if (not(dtmContratosImoveis.qryParcelasContratodatapagto.IsNull) and
             (dtmContratosImoveis.qryParcelasContratodatapagto.AsDateTime > ParSistema.DataContabil)) then
      IncluirEditarParcelasContrato(True)
    else
      MensagemAviso('Não é possível editar a parcela, pois ela está quitada e a data de'+#10#13+
                    'pagto é anterior à data contábil ('+datetostr(ParSistema.DataContabil)+').');
  end
  else
    if (dtmContratosImoveis.SituacaoContrato in [sciVENDIDO, sciRENEGOCIACAO, sciTRANSFERENCIA]) then
      sbnReceberParcelaClick(Self);
end;

procedure TfrmContratosImoveis.AbrirContrato;
begin
  edfNumeroCOntrato.Text:= ConsultaContrato.ValorSelecionado;

  dtmContratosImoveis.RefazConsultaPorNome(dtmContratosImoveis.qryContratos,['Contrato'],
                                                     [ConsultaContrato.ValorSelecionado]);
end;

procedure TfrmContratosImoveis.sbnProcurarClick(Sender: TObject);
begin
  inherited;
  if not CtrlOn then
  begin
    ConsultaContrato.InternoPesquisar('Contratos de Imóveis');
    self.SetFocus;
  end;
end;

procedure TfrmContratosImoveis.ExcluirParcelaContrato;
var result : TModalResult;
begin
  Result:= MensagemSimNaoOpcaoCancelar('Deseja exclui todas as parcelas'+#10#13+
                          'do tipo '+dtmContratosImoveis.qryParcelasContratotipo.AsString,'',True);

  if  Result = mryes then
    dtmContratosImoveis.ExcluirParcelasContrato(True)
  else if Result = mrno then
    dtmContratosImoveis.ExcluirParcelasContrato(False);
  TotaisdeParcelas(False);
end;

procedure TfrmContratosImoveis.sbnImprimirContratoClick(Sender: TObject);
begin
  inherited;
  frmimpressaocontratoimoveis:= Tfrmimpressaocontratoimoveis.Create(frmimpressaocontratoimoveis);
  try
    if dtmContratosImoveis.qryContratosdataalteracao.AsVariant > 0 then
      frmimpressaocontratoimoveis.DataAlteracao:= dtmContratosImoveis.qryContratosdataalteracao.AsVariant
    else
      frmimpressaocontratoimoveis.DataAlteracao:= 0;
    if dtmContratosImoveis.qryContratosdata.AsVariant > 0 then
      frmimpressaocontratoimoveis.DataContrato := dtmContratosImoveis.qryContratosdata.AsVariant
    else
      frmimpressaocontratoimoveis.DataContrato := 0;
    frmimpressaocontratoimoveis.ShowModal;

    if frmimpressaocontratoimoveis.ModalResult = mrok then
    begin
      if frmimpressaocontratoimoveis.Imprimir = 'C' then
        dtmContratosImoveis.ImprimirContrato

      else if frmimpressaocontratoimoveis.Imprimir = 'E' then
        dtmContratosImoveis.ImprimirExtrato(frmimpressaocontratoimoveis.RelatorioCompleto, frmimpressaocontratoimoveis.Data)
      else if frmimpressaocontratoimoveis.Imprimir = 'R' then
      begin
        dtmContratosImoveis.OrigemReciboRecebimentos:= False;
        dtmContratosImoveis.ImprimirRecibo;
      end;
    end;

  finally
    frmimpressaocontratoimoveis.Free;
  end;
end;

procedure TfrmContratosImoveis.sbnAlterarSituacaoClick(Sender: TObject);
begin
  inherited;
  if dtmContratosImoveis.SituacaoContrato = sciRESERVADO then
  begin
    if dtmContratosImoveis.qryContratosdata.AsDateTime > ParSistema.DataContabil then
    begin
      if VerificarContas then
      begin
        dtmContratosImoveis.AlterarEstadoContrato;
        if ParSistema.GerarContabilidade then
        begin
          fraLancamentoContabeisVenda.sbnGerarLancamentoClick(Self);
  //        fraLancamentoContabeisVenda.Origem:= 'V';
          dtmContratosImoveis.NrOrigem:= 'V';
          fraLancamentoContabeisVenda.VerificarLancamentosContabeis;
          dtmContratosImoveis.GravarLancamentosContabeis;

          if dtmContratosImoveis.qryContratosdatachaves.AsDateTime > 0 then
          begin
            fraLancamentoContabeisChaves.sbnGerarLancamentoClick(Self);
{            fraLancamentoContabeisVenda.Origem:= 'H';}
            fraLancamentoContabeisChaves.Origem:= 'H';
            fraLancamentoContabeisChaves.VerificarLancamentosContabeis;
            dtmContratosImoveis.GravarLancamentosContabeis;
          end;
        end;

        with dtmContratosImoveis do
        begin
          AlterarEstadoImoveis('V', True);
          InternoGravar;
//        RefazConsultaPorNome(qryContratos,['Contrato'],[qryContratoscontrato.AsVariant]);
//        RefazConsultaContrato(qrycontratoscontrato.asString);
        end;

      end
      else
        MensagemAviso('As seguintes contas não foram preenchidas:'+sLineBreak+MsgContas);
    end
    else
      MensagemAviso('A data de venda "' + DateToStr(dtmContratosImoveis.qryContratosdata.AsDateTime) +
                    '" é anterior à data contábil "' + DateToStr(ParSistema.DataContabil) + '".');
  end;
end;

procedure TfrmContratosImoveis.AfterOpenContratos(Sender: TObject);
begin
  if tstContabil.TabVisible then
  begin
    with fraLancamentoContabeisVenda do
    begin
      dtmContratosImoveis.NrOrigem:= 'V';
      AbrirLancamentos('V', CodigoDocumento, dtmContratosImoveis.IncluindoContrato);
      AlterarEstadoBotoes;
    end;
    with fraLancamentoContabeisChaves do
    begin
      dtmContratosImoveis.NrOrigem:= 'H';
      AbrirLancamentos('H', CodigoDocumento, dtmContratosImoveis.IncluindoContrato);
    end;
  end;


{  if dtmContratosImoveis.SituacaoContrato > sciVENDIDO then
    gbxDataAlteracao.Visible:= true
  else
    gbxDataAlteracao.Visible:= False;
    }



    {
    sciRESERVADO     = 'R'
    sciCANCELADO     = 'C'
    sciVENDIDO       = 'V'
    sciQUITADO       = 'Q'
    sciRESCINDIDO    = 'S'

    sciTRANSFERIDO   = 'T'
    sciTRANSFERENCIA = 'F'

    sciRENEGOCIADO   = 'G'
    sciRENEGOCIACAO  = 'D'


       cast(case when c.situacao = 'R' then 'RESERVADO'
                 when c.situacao = 'C' then 'CANCELADO'
                 when c.situacao = 'V' then 'VENDIDO'
                 when c.situacao = 'Q' then 'QUITADO'
                 when c.situacao = 'G' then 'RENEGOCIADO PARA Nº '||cast((select vig.contrato
                                                                          from vendasimoveis vig
                                                                          where vig.contrato_origem = c.contrato) as varchar)
                 when c.situacao = 'D' then 'RENEGOCIADO DE Nº '|| cast(c.contrato_origem as varchar)
                 when c.situacao = 'S' then 'RESCINDIDO'
                 when c.situacao = 'T' then 'TRANSFERIDO PARA Nº '||cast((select vig.contrato
                                                                          from vendasimoveis vig
                                                                          where vig.contrato_origem = c.contrato) as varchar)
                 when c.situacao = 'F' then 'TRANSFERIDO DE Nº '|| cast(c.contrato_origem as varchar)
            end as varchar) as NomeSituacao,

    }


  if (dtmContratosImoveis.SituacaoContrato = sciTRANSFERENCIA) or
     ((dtmContratosImoveis.SituacaoContrato = sciRENEGOCIADO) and
       (dtmContratosImoveis.qryContratossituacao_contrato_origem.AsString = 'T')) then
  begin
    pgcContabil.Pages[2].TabVisible:= True;
    pgcContabil.Pages[2].Caption   := 'Transferências';
    dtmContratosImoveis.DataAlteracao:= dtmContratosImoveis.qryContratosdataalteracao.AsDateTime;
    with LancamentosTransf do
    begin
      dtmContratosImoveis.OperacaoTransferencia:= TRue;
      dtmContratosImoveis.OperacaoRenegociacao:= False;
      dtmContratosImoveis.OperacaoRescisao:= '';
      dtmContratosImoveis.NrOrigem:= 'G';
      if not dtmContratosImoveis.IncluindoContrato then
        AbrirLancamentos('G', CodigoDocumento, dtmContratosImoveis.IncluindoContrato);
    end
  end
  else if (dtmContratosImoveis.SituacaoContrato = sciRENEGOCIACAO) or
          ((dtmContratosImoveis.SituacaoContrato <> sciRENEGOCIACAO) and
           (dtmContratosImoveis.qryContratossituacao_contrato_origem.AsString = 'G')) then
  begin
    pgcContabil.Pages[2].TabVisible:= True;
    pgcContabil.Pages[2].Caption   := 'Renegociação';
    dtmContratosImoveis.DataAlteracao:= dtmContratosImoveis.qryContratosdataalteracao.AsDateTime;
    with LancamentosTransf do
    begin
      dtmContratosImoveis.OperacaoTransferencia:= False;
      dtmContratosImoveis.OperacaoRenegociacao:= True;
      dtmContratosImoveis.OperacaoRescisao:= '';
      dtmContratosImoveis.NrOrigem:= 'G';
      if not dtmContratosImoveis.IncluindoContrato then
        AbrirLancamentos('G', CodigoDocumento, dtmContratosImoveis.IncluindoContrato);
    end
  end
  else
    pgcContabil.Pages[2].TabVisible:= False;

  if dtmContratosImoveis.SituacaoContrato = sciRESCINDIDO then
  begin
    pgcContabil.Pages[3].TabVisible:= True;
    dtmContratosImoveis.NrOrigem:= 'G';
    dtmContratosImoveis.DataAlteracao:= dtmContratosImoveis.qryContratosdataalteracao.AsDateTime;
    with LancamentosEstornoVenda do
    begin
      dtmContratosImoveis.OperacaoTransferencia:= False;
      dtmContratosImoveis.OperacaoRenegociacao:= False;
      dtmContratosImoveis.OperacaoRescisao:= 'EV';
      dtmContratosImoveis.NrOrigem:= 'G';
      AbrirLancamentos('G', CodigoDocumento, dtmContratosImoveis.IncluindoContrato);
    end;
    with LancamentosEstornoImpostos do
    begin
      dtmContratosImoveis.OperacaoTransferencia:= False;
      dtmContratosImoveis.OperacaoRenegociacao := False;
      dtmContratosImoveis.OperacaoRescisao:= 'EI';
      dtmContratosImoveis.NrOrigem:= 'G';
      AbrirLancamentos('G', CodigoDocumento, dtmContratosImoveis.IncluindoContrato);
    end;
    with LAncamentoEstornoValoresPagos do
    begin
      dtmContratosImoveis.OperacaoTransferencia:= False;
      dtmContratosImoveis.OperacaoRenegociacao := False;
      dtmContratosImoveis.OperacaoRescisao:= 'EP';
      dtmContratosImoveis.NrOrigem:= 'G';
      AbrirLancamentos('G', CodigoDocumento, dtmContratosImoveis.IncluindoContrato);
    end;
  end
  else
  begin
    pgcContabil.Pages[3].TabVisible:= False;
  end;
  if dtmContratosImoveis.qryCompradores_Anteriores.RecordCount > 0 then
    gbxCompradoresAnteriores.Visible:= True
  else
    gbxCompradoresAnteriores.Visible:= False;
  DisplayCompradores(self);

  if dtmContratosImoveis.qryContratos.RecordCount > 0 then
    TotaisdeParcelas(False)
  else
    TotaisdeParcelas(True);

  if dtmContratosImoveis.qryContratos.RecordCount > 0 then
  begin
    case dtmContratosImoveis.SituacaoContrato of
      sciVENDIDO,sciRESERVADO: begin
                                 if pgcContratos.Pages[2].Enabled then
                                   pgcContratos.ActivePage:= tstParcelas;
                               end;
      sciRENEGOCIADO         : pgcContabil.ActivePage:= tstrescisao;
    end;
  end;

  if not (dtmContratosImoveis.SituacaoContrato in [sciVENDIDO, sciRESERVADO, sciRESCINDIDO, sciTRANSFERIDO]) then
    pgcContratos.Pages[4].Caption:= ' &5 - Valores Anteriores'
  else
    pgcContratos.Pages[4].Caption:= ' &5 - Anterior a 2009';
end;

function TfrmContratosImoveis.VerificarContas: Boolean;
begin
  MsgContas:= '';
  with dtmContratosImoveis do
  begin
    RefazConsultaPorNome(qryImoveisVendidos,['Contrato'],[qryContratosContrato.AsVariant]);
    if GetContaCreditoCofinsRetido <= 0 then
      MsgContas:= '- Crédito COFINS Venda' + sLineBreak;
    if GetContaCreditoCSLLRetido <= 0 then
      MsgContas:= MsgContas + '- Crédito CSLL Venda' + sLineBreak;
    if GetContaCreditoIRRetido <= 0 then
      MsgContas:= MsgContas + '- Crédito IRPJ Venda' + sLineBreak;
    if GetContaCreditoPISRetido <= 0 then
      MsgContas:= MsgContas + '- Crédito PIS Venda' + sLineBreak;
    if GetContaDebitoCofinsRetido <= 0 then
      MsgContas:= MsgContas + '- Débito Cofins Venda' + sLineBreak;
    if GetContaDebitoCSLLRetido <= 0 then
      MsgContas:= MsgContas + '- Débito CSLL Venda' + sLineBreak;
    if GetContaDebitoIRRetido <= 0 then
      MsgContas:= MsgContas + '- Débito IRPJ Venda' + sLineBreak;
    if GetContaDebitoPISRetido <= 0 then
      MsgContas:= MsgContas + '- Débito PIS Venda' + sLineBreak;
    if GetContaCreditoCofinsChaves <= 0 then
      MsgContas:= MsgContas + '- Crédito COFINS Chaves' + sLineBreak;
    if GetContaCreditoCSLLChaves <= 0 then
      MsgContas:= MsgContas + '- Crédito CSLL Chaves' + sLineBreak;
    if GetContaCreditoIRChaves <= 0 then
      MsgContas:= MsgContas + '- Crédito IRPJ Chaves' + sLineBreak;
    if GetContaCreditoPISChaves <= 0 then
      MsgContas:= MsgContas + '- Crédito PIS Chaves' + sLineBreak;
    if GetContaDebitoCofinsChaves <= 0 then
      MsgContas:= MsgContas + '- Débito COFINS Chaves' + sLineBreak;
    if GetContaDebitoCSLLChaves <= 0 then
      MsgContas:= MsgContas + '- Débito CSLL Chaves' + sLineBreak;
    if GetContaDebitoIRChaves <= 0 then
      MsgContas:= MsgContas + '- Débito IRPJ Chaves' + sLineBreak;
    if GetContaDebitoPISChaves <= 0 then
      MsgContas:= MsgContas + '- Débito PIS Chaves' + sLineBreak;
    if GetDebitoVendaImoveis <= 0 then
      MsgContas:= MsgContas + '- Débito Venda do Imóvel' + sLineBreak;
    if GetCreditoVendaImoveis <= 0 then
      MsgContas:= MsgContas + '- Crédito Venda do Imóvel' + sLineBreak;
    if GetDebitoChavesImoveis <= 0 then
      MsgContas:= MsgContas + '- Débito Chaves do Imóvel' + sLineBreak;
    if GetCreditoChavesImoveis <= 0 then
      MsgContas:= MsgContas + '- Crédito Chaves do Imóvel' + sLineBreak;
    if GetCustodoImovel < 0 then
      MsgContas:= MsgContas + '- Valor do custo do imóvel' + sLineBreak;
    if GetContaCreditoCusto <= 0 then
      MsgContas:= MsgContas + '- Crédito Custo do Imóvel' + sLineBreak;
    if GetContaDebitoCusto <= 0 then
      MsgContas:= MsgContas + '- Débito Custo do Imóvel' + sLineBreak;
  end;
  Result:= MsgContas = '';
end;

