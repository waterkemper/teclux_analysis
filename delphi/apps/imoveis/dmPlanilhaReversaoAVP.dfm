  object qryParcelas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryParcelasBeforeOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereEmpreendimentos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereClientes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereConta'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'SELECT * FROM ('
      ''
      'SELECT DISTINCT vi.Contrato, pi.Cliente, vi.Data,'
      '       e.Nome AS NomeEmpreendimento,'
      ''
      '      (SELECT coalesce(v.Razao, v.Nome)'
      '          FROM vFornecedores v'
      
        '             JOIN Compradores co ON v.Codigo    = co.Cliente    ' +
        ' AND'
      
        '                                    v.Tipo      = co.TipoCliente' +
        ' AND'
      '                                    vi.Contrato = co.Contrato'
      '            WHERE v.Codigo    = co.Cliente     AND'
      '                  v.Tipo      = co.TipoCliente AND'
      '                  vi.Contrato = co.Contrato    AND'
      '                  co.Principal) AS NomeCliente,'
      
        '        pi.Origem,          pi.Tipo,             pi.Numero, pi.C' +
        'ontaPagto,'
      '        pi.NrPagto,         pi.ValorPagto,       pi.DataPagto,'
      
        '        pi.ValorHistorico,  pi.ValorContratado,  pi.ValorCorrigi' +
        'do,'
      '        pi.ValorDevido,     pi.ValorDevidoInicioPeriodo,'
      '        pi.Correcao,        pi.Juros,            pi.Conta,'
      
        '        pi.DataVencto,      pi.AVPCurtoPrazo,    pi.AVPLongoPraz' +
        'o,'
      ''
      '        CASE WHEN pi.Diferenca > 0 THEN pi.Diferenca'
      '        END AS JurosMulta,'
      ''
      '        CASE WHEN pi.Diferenca < 0 THEN -pi.Diferenca'
      '        END AS Descontos,'
      ''
      
        '        CAST(TO_CHAR(pi.DataPagto, '#39'MM/YYYY'#39') AS VARCHAR(7)) AS ' +
        'AnoMesPagto'
      ''
      ''
      
        'FROM (SELECT DISTINCT pi.Contrato,   pi.Cliente,        pi.Orige' +
        'm,  pi.Conta,'
      
        '                      pi.Tipo,       pi.Numero,         pi.NrPag' +
        'to, pi.ContaPagto,'
      
        '                      pi.DataPagto,  pi.ValorHistorico, pi.Valor' +
        'Contratado,'
      
        '                      pi.ValorPagto, pi.ValorCorrigido, pi.Juros' +
        ','
      
        '                      pi.Correcao,   pi.Diferenca,      pi.Valor' +
        'Devido, pi.ValorDevidoInicioPeriodo,'
      
        '                      pi.DataVencto, pi.AVPCurtoPrazo,  pi.AVPLo' +
        'ngoPrazo'
      ''
      
        '      FROM (SELECT DISTINCT Contrato,  Cliente,    Origem,  Tipo' +
        ',  Numero, NrPagto,'
      
        '                            DataPagto, ValorPagto, ValorHistoric' +
        'o, ValorContratado, DataVencto,'
      
        '                   ValorCorrigido  (Contrato, Tipo, Numero, NrPa' +
        'gto, DataPagto, TRUE) AS ValorCorrigido,'
      
        '                   JurosContratuais(Contrato, Tipo, Numero, NrPa' +
        'gto, DataPagto)       AS Juros,'
      
        '                   ValorDevido     (Contrato, Tipo, Numero, NrPa' +
        'gto, DataPagto)       AS ValorDevido,'
      
        '                  (ValorCorrigido  (Contrato, Tipo, Numero, NrPa' +
        'gto, DataPagto, TRUE)'
      
        '                                                              - ' +
        'ValorHistorico)       AS Correcao,'
      
        '                  (SELECT CAST(Conta AS VARCHAR) || '#39'-'#39' || Digit' +
        'o || '#39' - '#39' || Titular'
      '                      FROM Contas'
      '                      WHERE Conta = ContaPagto) AS ContaPagto,'
      '                   Conta,'
      '               '
      '                   CASE WHEN DataPagto IS NULL'
      '                        THEN NULL'
      '                        ELSE CASE WHEN (ValorPagto -'
      
        '                                       (SELECT ValorDevido(Contr' +
        'ato, Tipo, Numero,'
      
        '                                                            NrPa' +
        'gto, DataPagto))) = 0'
      '                                  THEN  NULL'
      
        '                                  ELSE (ValorPagto - (SELECT Val' +
        'orDevido(Contrato, Tipo, Numero,'
      
        '                                                                ' +
        '               NrPagto, DataPagto)))'
      '                             END'
      '                   END AS Diferenca,'
      '               '
      
        '                  (SELECT ValorDevido(Contrato, Tipo, Numero, Nr' +
        'Pagto,'
      
        '                          (CAST(EXTRACT(YEAR FROM TIMESTAMP :Dat' +
        'aInicial)||'#39'-01-01'#39' AS DATE)-1)))'
      
        '                                                                ' +
        '      AS ValorDevidoInicioPeriodo,'
      '                   AVPCurtoPrazo, AVPLongoPrazo'
      '               '
      ''
      
        '            FROM (SELECT DISTINCT vi.Contrato,       pi.Origem, ' +
        '        pi.Tipo,  pi.ContaPagto,'
      
        '                                  pi.Numero,         pi.NrPagto,' +
        '        pi.Moeda, pi.ContaPagto AS Conta,'
      
        '                                  pi.ValorPagto,     pi.ValorHis' +
        'torico, pi.ValorContratado,'
      
        '                                  pi.JurosCompostos, pi.TaxaJuro' +
        's,      pi.DataPagto,'
      '                                  pi.DataVencto,'
      '                                  '
      
        '                                  CASE WHEN pi.AVPPrazo = '#39'CURTO' +
        #39' THEN AVPValor END AS AVPCurtoPrazo,'
      
        '                                  CASE WHEN pi.AVPPrazo = '#39'LONGO' +
        #39' THEN AVPValor END AS AVPLongoPrazo,'
      ''
      '                                 (SELECT co.cliente'
      '                                     FROM Compradores co'
      
        '                                     WHERE co.Contrato = vi.Cont' +
        'rato AND'
      
        '                                           co.Principal) AS Clie' +
        'nte'
      ''
      '                  FROM VendasImoveis vi'
      '                      JOIN Empreendimentos e'
      '                         ON vi.Empreendimento = e.Codigo'
      '                      JOIN ParcelasImoveis pi'
      '                         ON vi.Contrato = pi.Contrato'
      '                  WHERE vi.Contrato      = pi.Contrato    AND'
      '                        vi.Empreendimento = e.codigo      AND'
      '                        pi.DataPagto IS NOT NULL          AND'
      '                        pi.DataPagto BETWEEN :DataInicial AND'
      '                                             :DataFinal   AND'
      '                       (vi.Situacao NOT IN ('#39'C'#39','#39'R'#39') OR'
      '                        vi.Situacao     IN ('#39'T'#39','#39'G'#39'))'
      '                 ) AS Selecao'
      '           ) AS pi'
      '     ) AS pi'
      '       JOIN VendasImoveis vi'
      '           JOIN Empreendimentos e'
      '             ON vi.Empreendimento = e.Codigo'
      '         ON vi.Contrato = pi.Contrato'
      ''
      'WHERE TRUE'
      '      %WhereEmpreendimentos'
      '      %WhereClientes'
      '      %WhereConta'
      ') AS s'
      ''
      
        'ORDER BY TO_CHAR(DataPagto, '#39'YYYYMM'#39'), TO_ASCII(NomeEmpreendimen' +
        'to, '#39'LATIN1'#39'), TO_ASCII(NomeCliente, '#39'LATIN1'#39'), Contrato, DataPa' +
        'gto'
      '')
    RequestLive = False
    Left = 32
    Top = 40
    ParamData = <
      item
        DataType = ftString
        Name = 'DataInicial'
        ParamType = ptUnknown
        Value = '2016-01-01'
      end
      item
        DataType = ftString
        Name = 'DataFinal'
        ParamType = ptUnknown
        Value = '2016-01-31'
      end>
