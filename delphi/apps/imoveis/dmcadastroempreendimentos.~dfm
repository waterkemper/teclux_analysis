        '        OR (vi.Situacao IN ('#39'T'#39', '#39'G'#39')      AND vi.Data < :DataHa' +
        'biteSe AND'
      
        '               NOT COALESCE(((vitg.Situacao IN ('#39'F'#39', '#39'D'#39', '#39'Q'#39') A' +
        'ND vitg.Data <= :DataHabiteSe)'
      
        '                          OR (vitg.Situacao IN ('#39'S'#39')  AND vitg.D' +
        'ataAlteracao > :DataHabiteSe AND vitg.Data <= :DataHabiteSe)), F' +
        'ALSE)))'
      '     ) AS pi'
      ''
