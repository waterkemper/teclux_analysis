  object qryImoveisDiarioAuxiliar_Anterior: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select ida.*,'
      '       pl.descricao as descricaoplano,'
      '       pl.classificacao as classificacaoplano,'
      '       pl.tipo as tipocontacontabil,'
      '       h.descricao as descricaohistorico'
      '       '
      'from imoveisdiarioauxiliar ida'
      '     join planocontas pl'
      '     on ida.conta = pl.codigo'
      ''
      '     left join historicos h'
      '     on ida.historico = h.codigo'
      ''
      'where ida.filial = :filial'
      '  and ida.Periodo = (select ida2.periodo'
      '                     from imoveisdiarioauxiliar ida2'
      '                     where filial = :filial'
      '                       and periodo < :periodo'
      '                      order by periodo desc limit 1) '
      ''
      'order by ida.numero  '
      '')
    RequestLive = True
    Left = 160
    Top = 184
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'periodo'
        ParamType = ptUnknown
      end>
    object qryImoveisDiarioAuxiliar_Anteriorperiodo: TStringField
      FieldName = 'periodo'
      Size = 7
    end
    object qryImoveisDiarioAuxiliar_Anteriorfilial: TIntegerField
      FieldName = 'filial'
    end
    object qryImoveisDiarioAuxiliar_Anteriorconta: TIntegerField
      FieldName = 'conta'
    end
    object qryImoveisDiarioAuxiliar_Anteriordeboucred: TStringField
      FieldName = 'deboucred'
      Size = 1
    end
    object qryImoveisDiarioAuxiliar_Anteriorhistorico: TIntegerField
      FieldName = 'historico'
    end
    object qryImoveisDiarioAuxiliar_Anteriordescricaoplano: TStringField
      FieldName = 'descricaoplano'
      Size = 50
    end
    object qryImoveisDiarioAuxiliar_Anteriorclassificacaoplano: TStringField
      FieldName = 'classificacaoplano'
    end
    object qryImoveisDiarioAuxiliar_Anteriortipocontacontabil: TStringField
      FieldName = 'tipocontacontabil'
      Size = 1
    end
    object qryImoveisDiarioAuxiliar_Anteriordescricaohistorico: TStringField
      FieldName = 'descricaohistorico'
