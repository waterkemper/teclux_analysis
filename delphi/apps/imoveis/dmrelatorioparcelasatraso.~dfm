    Sql.Strings = (
      'SELECT *'
      ''
      'FROM ('
      '      SELECT s1.*,'
      ''
      '            (SELECT e.Nome'
      '                FROM Empreendimentos e'
      
        '                WHERE e.Codigo = s1.Empreendimento) AS NomeEmpre' +
        'endimento,'
      ''
      '            (SELECT co.Cliente'
      '                FROM Compradores co'
      '                WHERE co.Contrato = s1.Contrato AND'
      '                      co.Principal) AS Cliente,'
      ''
      '            (SELECT COALESCE(vf.Razao,vf.Nome)'
      '                FROM vFornecedores vf'
      
        '                JOIN Compradores co ON vf.codigo   = co.Cliente ' +
        '    AND'
      
        '                                       vf.Tipo     = co.TipoClie' +
        'nte AND'
      '                                       s1.Contrato = co.Contrato'
      '                WHERE co.Cliente     = vf.Codigo   AND'
      '                      co.TipoCliente = vf.Tipo     AND'
      '                      co.Contrato    = s1.Contrato AND'
      '                      co.Principal) AS NomeCliente'
      '      FROM ('
      
        '            SELECT vi.Contrato, ValorEmAtrasoImoveis (vi.Contrat' +
        'o,   0,   30, :DataBase) AS Ate30Dias,'
      
        '                                ValorEmAtrasoImoveis (vi.Contrat' +
        'o,  31,   60, :DataBase) AS Ate60Dias,'
      
        '                                ValorEmAtrasoImoveis (vi.Contrat' +
        'o,  61,   90, :DataBase) AS Ate90Dias,'
      
        '                                ValorEmAtrasoImoveis (vi.Contrat' +
        'o,  91,  120, :DataBase) AS Ate120Dias,'
      
        '                                ValorEmAtrasoImoveis (vi.Contrat' +
        'o, 121,  150, :DataBase) AS Ate150Dias,'
      
        '                                ValorEmAtrasoImoveis (vi.Contrat' +
        'o, 151,  180, :DataBase) AS Ate180Dias,'
      
        '                                ValorEmAtrasoImoveis (vi.Contrat' +
        'o, 181, NULL, :DataBase) AS Mais180Dias,'
      ''
      '                   vi.Empreendimento'
      ''
      ''
      '            FROM VendasImoveis vi'
      ''
      '            WHERE vi.Data <= :DataBase AND'
      ''
      
        '                  CASE WHEN vi.Situacao IN ('#39'C'#39',             /*-' +
        '--------------------- [C]ancelado */'
      
        '                                            '#39'R'#39') THEN FALSE  /*-' +
        '--------------------- [R]eservado */'
      ''
      '                       WHEN vi.DataAlteracao > :DataBase AND'
      
        '                            vi.Situacao IN ('#39'T'#39',             /*-' +
        '-------------- [T]ransferido para */'
      
        '                                            '#39'G'#39',             /*-' +
        '-------------- Rene[G]ociado para */'
      
        '                                            '#39'S'#39') THEN TRUE   /*-' +
        '-------------- Re[S]cindido       */'
      ''
      
        '                      WHEN vi.Situacao IN ('#39'F'#39',              /*-' +
        '--------------- Trans[F]erido de  */'
      
        '                                           '#39'D'#39',              /*-' +
        '--------------- Renegocia[D]o de  */'
      
        '                                           '#39'Q'#39',              /*-' +
        '--------------- [Q]uitado         */'
      
        '                                           '#39'V'#39') THEN TRUE    /*-' +
        '--------------- [V]endido         */'
      '                      ELSE FALSE'
      '                 END'
      '                 '
      '                 %Empreendimento'
      '                 %Cliente'
      '           ) AS s1'
      '           '
      
        '      WHERE s1.Ate30Dias  > 0 OR s1.Ate60Dias  > 0 OR s1.Ate90Di' +
        'as   > 0 OR s1.Ate120Dias > 0 OR'
      
        '            s1.Ate150Dias > 0 OR s1.Ate180Dias > 0 OR s1.Mais180' +
        'Dias > 0'
      '            '
      '     ) AS s2'
      
        'ORDER BY TO_ASCII(NomeEmpreendimento, '#39'LATIN1'#39'), TO_ASCII(NomeCl' +
        'iente, '#39'LATIN1'#39'), Contrato'
      ''
      '')
