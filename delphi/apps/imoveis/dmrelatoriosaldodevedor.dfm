  object qryRelatorioporEmp: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryRelatorioporEmpBeforeOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereEmpreendimento'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'SELECT *'
      'FROM ('
      '      SELECT DISTINCT s3.Contrato,'
      '                      s3.Codigo AS Empreendimento,'
      '                      s3.Nome   AS NomeEmpreendimento,'
      '                      s3.ImovelNumero,'
      '                      s3.ImovelBloco,'
      '                      s3.Cliente,'
      '                     (SELECT COALESCE(vf.Razao, vf.Nome)'
      #9'               FROM vFornecedores vf'
      #9'               WHERE vf.Codigo = s3.Cliente AND'
      
        '                       vf.Tipo   = s3.TipoCliente) AS NomeClient' +
        'e,'
      ''
      #9'            SUM(s3.ValorHistorico) AS ValorHistorico,'
      #9'            SUM(s3.Correcao)       AS Correcao,'
      #9'            SUM(s3.Juros)          AS Juros'
      ''
      '      FROM ('
      
        '            SELECT s2.Contrato,    s2.Codigo, s2.Nome, s2.Imovel' +
        'Numero, s2.ImovelBloco, s2.Cliente,'
      
        '                   s2.TipoCliente, s2.ValorHistorico,  s2.Juros,' +
        ' s2.Correcao'
      ''
      '            FROM ('
      
        '                  SELECT Contrato, Codigo, Nome, ImovelNumero, I' +
        'movelBloco,'
      '                         Cliente,   TipoCliente, ValorHistorico,'
      
        '                         JurosContratuais(Contrato, Tipo, Numero' +
        ', NrPagto, :Data) AS Juros,'
      
        '                        (ValorCorrigido(Contrato, Tipo, Numero, ' +
        'NrPagto, :Data, TRUE) -'
      
        '                                                                ' +
        '         ValorHistorico) AS Correcao'
      '                  FROM ('
      '                        SELECT DISTINCT vi.Contrato,'
      '                                        ep.Codigo,'
      '                                        ep.nome,'
      '                                       (SELECT iv.Numero'
      
        '                                           FROM ImoveisVendidos ' +
        'iv'
      
        '                                           WHERE vi.Contrato = i' +
        'v.Contrato'
      
        '                                           ORDER BY iv.OID DESC ' +
        'LIMIT 1) AS ImovelNumero,'
      ''
      
        '                                       (SELECT (SELECT b.Descric' +
        'ao'
      '                                                   FROM Blocos b'
      
        '                                                   WHERE b.Codig' +
        'o = iv.Bloco) AS Imovel'
      
        '                                           FROM ImoveisVendidos ' +
        'iv'
      
        '                                           WHERE vi.Contrato = i' +
        'v.Contrato'
      
        '                                           ORDER BY iv.OID DESC ' +
        'LIMIT 1) AS ImovelBloco,'
      ''
      '                                       (SELECT cp.cliente'
      '                                           FROM Compradores cp'
      
        '                                           WHERE vi.Contrato = c' +
        'p.Contrato AND'
      
        '                                                 cp.Principal) A' +
        'S Cliente,'
      ''
      '                                       (SELECT cp.TipoCliente'
      '                                           FROM Compradores cp'
      
        '                                           WHERE vi.Contrato = c' +
        'p.Contrato AND'
      
        '                                                 cp.Principal) A' +
        'S TipoCliente,'
      '                                        pi.Origem,'
      '                                        pi.Tipo,'
      '                                        pi.Numero,'
      '                                        pi.NrPagto,'
      '                                        pi.Moeda,'
      '                                        pi.DataPagto,'
      '                                        pi.ValorPagto,'
      '                                        pi.ValorHistorico'
      ''
      '                        FROM VendasImoveis vi'
      #9'                   JOIN ImoveisVendidos iv'
      '                                  JOIN Blocos b'
      
        '                                  JOIN Empreendimentos ep ON b.E' +
        'mpreendimento = ep.Codigo'
      '                             ON iv.Bloco = b.Codigo'
      '                             ON vi.Contrato = iv.Contrato'
      ''
      '                             JOIN ParcelasImoveis pi'
      '                                  ON vi.Contrato = pi.Contrato'
      ''
      '                        WHERE vi.Contrato      = pi.Contrato AND'
      '                              vi.Contrato      = iv.Contrato AND'
      '                              iv.Bloco         = b.Codigo    AND'
      '                              b.Empreendimento = ep.Codigo   AND'
      
        '                              vi.Situacao NOT IN ('#39'C'#39',          ' +
        '         /*---------- [C]ancelado */'
      
        '                                                  '#39'R'#39')       AND' +
        '         /*---------- [R]eservado */'
      ''
      
        '                              CASE WHEN vi.Situacao IN ('#39'C'#39',    ' +
        '         /*---------- [C]ancelado */'
      
        '                                                        '#39'R'#39') THE' +
        'N FALSE  /*---------- [R]eservado */'
      ''
      
        '                                   WHEN vi.DataAlteracao > :Data' +
        ' AND'
      
        '                                        vi.Situacao IN ('#39'T'#39',    ' +
        '         /*--- [T]ransferido para */'
      
        '                                                        '#39'G'#39',    ' +
        '         /*--- Rene[G]ociado para */'
      
        '                                                        '#39'Q'#39',    ' +
        '         /*--- [Q]uitado          */'
      
        '                                                        '#39'S'#39') THE' +
        'N TRUE   /*--- Re[S]cindido       */'
      ''
      '                                   WHEN vi.Data <= :Data AND'
      
        '                                        vi.Situacao IN ('#39'F'#39',    ' +
        '         /*----- trans[F]erido de */'
      
        '                                                        '#39'D'#39') THE' +
        'N TRUE   /*----- Renegocia[D]o de */'
      
        '                                                                ' +
        '                                    '
      
        '                                   WHEN vi.Situacao IN ('#39'V'#39') THE' +
        'N TRUE   /*----------- [V]endido  */'
      
        '                                                             ELS' +
        'E FALSE'
      '                              END                            AND'
      '                           '
      '                              vi.data <= :Data               AND'
      '                             (pi.DataPagto IS NULL OR'
      '                              pi.DataPagto > :Data)'
      '                           '
      '                              %WHEREEmpreendimento'
      ''
      
        '                        ORDER BY pi.Tipo, pi.Numero, pi.DataPagt' +
        'o'
      #9'             ) AS s1'
      #9'       ) AS s2'
      '           ) AS s3'
      '             JOIN VendasImoveis vi'
      '                  ON (vi.Contrato = s3.Contrato)'
      ''
      '      WHERE TRUE'
      ''
      
        '      GROUP BY s3.Contrato,    s3.Cliente, s3.TipoCliente, s3.Im' +
        'ovelNumero,'
      '               s3.ImovelBloco, s3.Nome,    s3.Codigo'
      '     ) AS s4'
      
        '       ORDER BY TO_ASCII(NomeEmpreendimento, '#39'LATIN1'#39'), TO_ASCII' +
        '(NomeCliente, '#39'LATIN1'#39');')
    RequestLive = False
    Left = 48
    Top = 16
    ParamData = <
      item
        DataType = ftString
        Name = 'Data'
        ParamType = ptUnknown
        Value = #39'2016-01-01'#39
      end>
