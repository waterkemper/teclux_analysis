    end
    object qryRelatorioporEmpcorrecao: TFloatField
      FieldName = 'correcao'
      DisplayFormat = '0.00'
    end
    object qryRelatorioporEmpjuros: TFloatField
      FieldName = 'juros'
      DisplayFormat = '0.00'
    end
  end
