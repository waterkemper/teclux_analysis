procedure TfrmCadastroImoveisContrato.AtribuirParametros;
begin
  fraConsultaEmpreendimentoedfCodigoFound(true);
{  dtmContratosImoveis.ParametrosImoveis(fraConsultaEmpreendimento.edfCodigo.Text,'','','');}
{
