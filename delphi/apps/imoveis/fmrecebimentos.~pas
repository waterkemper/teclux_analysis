end;

procedure Tfrmrecebimentos.InicializarCampos;
begin
  if not dtmContratosImoveis.QuitarDiversas then
  begin
    VarRecebimentos := TRecebimentos.Create(False);
    RecebimentosInt := VarRecebimentos;
    RecebimentosInt.ParcelasRecibo(RecebimentosInt.qryparcelas.FieldByname('recibopagto').AsInteger);
    PreencherCampos;
  end
  else
  begin
    RecebimentosInt := VarRecebimentos;
    PreencherCampos;
  end;
end;

procedure Tfrmrecebimentos.KeyDown(var Key: Word; Shift: TShiftState);
begin
  inherited;
  if Key = VK_F5 then
    sbnSalvarClick(Self);
end;

procedure Tfrmrecebimentos.PreencherCampos;
begin
  edtTipoParcela.Text      := RecebimentosInt.Tipo;
  edtParcela.Text          := RecebimentosInt.Parcela;
  edtNrPagto.Text          := IntToStr(RecebimentosInt.NrPagto);
  edtValorContratado.Text  := FloatToStr(RecebimentosInt.ValorContratado);
  edtValorHistorico.Text   := FloatToStr(RecebimentosInt.ValorHistorico);
  if RecebimentosInt.Conta > 0 then
  begin
    fraConsultaContas.edfCodigo.Text:= IntToStr(RecebimentosInt.Conta);
    fraConsultaContas.edfCodigo.Exist;
  end;
  if RecebimentosInt.NroCheque <> '' then
    edtnrCheque.Text         := RecebimentosInt.NroCheque;
  if RecebimentosInt.BancoCheque > 0 then
  begin
    fraConsultaBancos.edfCodigo.Text := inttostr(RecebimentosInt.BancoCheque);
    fraConsultaBancos.edfCodigo.Exist;
    if RecebimentosInt.Agencia > 0 then
      edtagencia.Text:= IntToStr(RecebimentosInt.Agencia);
    edtEmitente.Text:= RecebimentosInt.Emitente;
  end;
  edtJurosContratuais.Text := FloatToStr(RecebimentosInt.JurosContratuais);
  edtCorrecao.Text         := CurrToStrF(RecebimentosInt.CorrecaoContabil,ffNumber,2);
  edtValorDevido.Text      := FloatToStr(RecebimentosInt.ValorDevido);
  edtMulta.Text            := FloatToStr(RecebimentosInt.ValorMulta);
  edtJurosMora.Text        := FloatToStr(RecebimentosInt.ValorJuros);
  edtTotal.Text            := FloatToStr(RecebimentosInt.ValorTotal);
  edtValorRecebido.Text    := FloatToStr(RecebimentosInt.ValorRecebido);
  edtDataPagto.Text        := datetostr(RecebimentosInt.Pagamento);
  edtVencimento.Text       := datetostr(RecebimentosInt.Vencimento);
  edtTotal.Text            := FloatToStr(RecebimentosInt.ValorTotal);
end;

procedure Tfrmrecebimentos.sbnSalvarClick(Sender: TObject);
var Concluido: Boolean;
begin
  inherited;
  Concluido:= True;
  if RecebimentosInt.ValidarDatasPagamentos then
  begin
    If VerificarCamposObrigatorios then
    begin
      if RecebimentosInt.Pagamento > ParSistema.DataContabil then
      begin
        if dtmContratosImoveis.VerificarCotacaoMoeda(dtmContratosImoveis.qryParcelasContratomoeda.AsString,
                                 datetostr(RecebimentosInt.Pagamento)) then
        begin
          try
            RecebimentosInt.DescricaoParcelasPagas;
            RecebimentosInt.ValorRecebido:= edtValorRecebido.ValorSemFormatacao;
            RecebimentosInt.LiberarJuroseMulta:= cbxLiberarJuros.Checked;
            RecebimentosInt.JurosContratuais := edtJurosContratuais.ValorSemFormatacao;
            RecebimentosInt.ContaContabil   := fraConsultaContas.qryProcuraContascontacontabil.AsInteger;
            if edtNrCheque.Text <> '' then
              RecebimentosInt.NroCheque    := edtNrCheque.ValorSemFormatacao;
            RecebimentosInt.Evento       := RecebimentosInt.GetEventoRecebimento;
            if fraConsultaContas.edfCodigo.Text <> '' then
              RecebimentosInt.Conta      := strtoint(fraConsultaContas.edfCodigo.Text);
            if fraConsultaBancos.edfCodigo.Text <> '' then
              RecebimentosInt.BancoCheque:= strtoint(fraConsultaBancos.edfCodigo.Text);
            if edtagencia.Text <> '' then
              RecebimentosInt.Agencia    := strtoint(edtagencia.Text);
            if edtNrCheque.Text <> '' then
              if edtEmitente.Text = '' then
              begin
                dtmContratosImoveis.qryCompradores.First;
                RecebimentosInt.Emitente   := dtmContratosImoveis.qryCompradoresnomecliente.AsString;
              end
              else
                RecebimentosInt.Emitente   := edtEmitente.Text;

            if RecebimentosInt.ValidarValorRecebido then
            begin
              if RecebimentosInt.AlterandoParcela then
                if ((FPagtoAnt = 0) or (FPagtoAnt = RecebimentosInt.Pagamento)) then
                  ApagarMovimentacaoBancaria(RecebimentosInt.Pagamento)
                else
                  ApagarMovimentacaoBancaria(FPagtoAnt);
              GerarMovimentacaoBancaria;
              //Perpetra Tudo
              if RecebimentosInt.GravarModificacoes then
              begin
                if GerarLancamentosContabeis then
                  RecebimentosInt.Perpetrar_
                else
                begin
                  RecebimentosInt.Rollback_;
                  Concluido:= False;
                  modalresult := mrCancel;
                  close;
                end;

              end;
              //Emissão Recibo

            end;
          finally
            If Concluido then
            begin
              dtmContratosImoveis.ContaRecebimentos:= RecebimentosInt.Conta;
              sbnSalvar.Enabled:= False;
              sbnCancelar.Enabled:= not sbnSalvar.Enabled;
              if MensagemConfirmacao('Deseja Imprimir o Recibo?') = smbOk then
              begin
//                dtmContratosImoveis.RefazConsultaContrato(dtmContratosImoveis.qryContratoscontrato.asString);
                dtmContratosImoveis.OrigemReciboRecebimentos:= True;
                dtmContratosImoveis.ImprimirRecibo;
              end;
            end
            else
              MensagemAviso('Operação Abortada');
          end;
        end
        else
          MensagemAviso('Não existe cotação da moeda ' + dtmContratosImoveis.qryParcelasContratomoeda.AsString + #10#13 +
                        'na data ' + datetostr(RecebimentosInt.Pagamento));
      end
      else
        MensagemAviso(Format(ctDATACONTABILMAIORDATALANCTO,['de lançamento',
                                                            datetostr(RecebimentosInt.Pagamento),
                                                            'contábil',
                                                            Parsistema.DataContabilString]));
    end
    else
    begin
      MensagemAviso(ctVALIDARCONTROLES);
      fraConsultaContas.edfCodigo.SetFocus;
    end;
  end
  else
    MensagemErro('Há parcela parcial com parcela anterior paga com data posterior')
end;

procedure Tfrmrecebimentos.cbxLiberarJurosClick(Sender: TObject);
begin
  inherited;
  if RecebimentosInt.VerificarParcelaPosterior then
  begin
    if cbxLiberarJuros.Checked then
    begin
      RecebimentosInt.LiberarMulta(False);
      edtJurosMora.Text     := '0,00';
      edtMulta.Text         := '0,00';
      edtTotal.Text         := FloatToStr(RecebimentosInt.ValorTotal);
      edtValorRecebido.Text := FloatToStr(RecebimentosInt.ValorTotal);
      RecebimentosInt.LiberarJuroseMulta:= True;
    end
    else
    begin
      RecebimentosInt.LiberarMulta(True);
      edtJurosMora.Text     := FloatToStr(RecebimentosInt.ValorJuros);
      edtMulta.Text         := FloatToStr(RecebimentosInt.ValorMulta);
      edtTotal.Text         := FloatToStr(RecebimentosInt.ValorTotal);
      edtValorRecebido.Text := FloatToStr(RecebimentosInt.ValorTotal);
      RecebimentosInt.LiberarJuroseMulta:= False;
    end;
    if sbnSalvar.Enabled = False then
      sbnSalvar.Enabled:= True;
  end;
end;

