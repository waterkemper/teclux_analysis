procedure Tfrmrecebimentos.GerarMovimentacaoBancaria;
Var Sequencia: Integer;
  procedure InserirMovto;
  begin
    with dtmContratosImoveis do
    begin
      RefazConsulta(qryMovtosBancos,[],[]);
      qryMovtosBancos.Append;
      qryMovtosBancosconta.AsInteger        := RecebimentosInt.Conta;
      qryMovtosBancosdata.AsDateTime        := RecebimentosInt.Pagamento;
      qryMovtosBancossequencia.AsInteger    := RecebimentosInt.Sequencia;
      qryMovtosBancoscompensacao.AsDateTime := RecebimentosInt.Pagamento;
      qryMovtosBancosevento.AsInteger       := RecebimentosInt.Evento;
      qryMovtosBancosorigemlancto.AsString  := 'T';
      qryMovtosBancosdocumento.AsString     := RecebimentosInt.NroCheque;
      qryMovtosBancosobservacoes.AsString   := RecebimentosInt.DescricaoParcelas;
      qryMovtosBancosvalor.AsFloat        := RecebimentosInt.ValorRecebido;
      qryMovtosBancos.Post;

      qryMovtosBancosEventos.Open;
      qryMovtosBancosEventos.Append;
      qryMovtosBancosEventosconta.AsInteger        := RecebimentosInt.Conta;
      qryMovtosBancosEventosdata.AsDateTime        := RecebimentosInt.Pagamento;
      qryMovtosBancosEventossequencia.AsInteger    := RecebimentosInt.Sequencia;
      qryMovtosBancosEventosevento.AsInteger       := RecebimentosInt.Evento;
      qryMovtosBancosEventosvalor.AsFloat          := RecebimentosInt.ValorRecebido;
      qryMovtosBancosEventos.Post;
    end;
  end;

begin
  with dtmContratosImoveis do
  begin
    RecebimentosInt.DescricaoParcelasPagas;
    if RecebimentosInt.AlterandoParcela then
    begin
      RefazConsultaPorNome(qryMovtosBancos,['ContaPagto','DataPagto','Sequencia'],
                                           [RecebimentosInt.Conta,
                                            RecebimentosInt.Pagamento,
                                            RecebimentosInt.Sequencia]);
      if qryMovtosBancos.RecordCount > 0 then
      begin
        if not (qryMovtosBancos.State = dsedit) then
          qryMovtosBancos.Edit;
        qryMovtosBancosdocumento.AsString   := RecebimentosInt.NroCheque;
        qryMovtosBancosobservacoes.AsString := RecebimentosInt.DescricaoParcelas;
        qryMovtosBancosvalor.AsFloat        := RecebimentosInt.ValorRecebido;
        qryMovtosBancos.Post;
      end
      else
      begin
        RefazConsultaPorNome(qrySequencia,['ContaPagto','DataPagto'],[RecebimentosInt.Conta,
                                                                      RecebimentosInt.Pagamento]);
        RecebimentosInt.Sequencia:= qrySequenciasequencia.AsInteger + 1;
        InserirMovto;
      end;
    end
    else
    begin
      RefazConsultaPorNome(qrySequencia,['ContaPagto','DataPagto'],[RecebimentosInt.Conta,
                                                                      RecebimentosInt.Pagamento]);
      RecebimentosInt.Sequencia:= qrySequenciasequencia.AsInteger + 1;
      InserirMovto;
    end;
  end;
end;

procedure Tfrmrecebimentos.edtDataPagtoExit(Sender: TObject);
begin
  inherited;
  if RecebimentosInt.VerificarParcelaPosterior then
  begin
     FPagtoAnt:= RecebimentosInt.Pagamento;
     if (strtodate(edtDataPagto.Text) <> RecebimentosInt.Pagamento) then
     begin
       RecebimentosInt.Pagamento:= strtodate(edtDataPagto.Text);
       RecebimentosInt.RecalcularValores;
       PreencherCampos;
       if sbnSalvar.Enabled = False then
         sbnSalvar.Enabled:= True;
       sbnCancelar.Enabled:= not sbnSalvar.Enabled;
     end;
  end;
end;

procedure Tfrmrecebimentos.OnChangeCampos(Atual, Anterior: String);
begin
  if RecebimentosInt.VerificarParcelaPosterior then
  begin
     if Atual <> Anterior then
       if sbnSalvar.Enabled = False then
         sbnSalvar.Enabled:= True;
     sbnCancelar.Enabled:= not sbnSalvar.Enabled;
  end;
end;

