procedure Tfrmrecebimentos.sbnCancelarClick(Sender: TObject);
var Estado, Concluido, ReadOnlyTabela: Boolean;
begin
  inherited;
  Concluido:= False;
  if MensagemConfirmacao(Format(ctCANCELARQUITACAO,[RecebimentosInt.Tipo + '-'+
                                                    RecebimentosInt.Parcela])) = smbOk then
  begin
    try
      dtmContratosImoveis.CancelarRecebimento:= True;
      dtmContratosImoveis.ApagarLancamentosContabeis('T',RecebimentosInt.NumeroOrigem, true);
      RecebimentosInt.GravarModificacoes;
      if dtmContratosImoveis.Gravado then
      begin
        ApagarMovimentacaoBancaria(RecebimentosInt.Pagamento);
        Concluido:= True;
      end;
    finally
      if Concluido then
        frmrecebimentos.Close;
      dtmContratosImoveis.CancelarRecebimento:= False;
      dtmContratosImoveis.Perpetrar([])
    end;
  end;
end;

procedure Tfrmrecebimentos.ApagarMovimentacaoBancaria(Data: TDateTime);
begin
  with dtmContratosImoveis do
  begin
    RefazConsultaPorNome(qryMovtosBancos,['ContaPagto','DataPagto','Sequencia'],
                                         [RecebimentosInt.Conta,
                                          Data,
                                          RecebimentosInt.Sequencia]);
    if qryMovtosBancos.RecordCount > 0 then
    begin
      qryMovtosBancos.Delete;
      Perpetrar([qryMovtosBancos]);
    end;
  end;

end;

