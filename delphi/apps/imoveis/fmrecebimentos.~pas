procedure Tfrmrecebimentos.FormShow(Sender: TObject);
begin
  inherited;
  edtValorRecebido.SetFocus;
  if dtmContratosImoveis.QuitarDiversas then
  begin
    pgcParcelas.ActivePage:= tstVariasParcelas;
    lblSaida.Caption:= RecebimentosInt.DescricaoParcelas;
  end
  else
    pgcParcelas.ActivePage:= tstUnicaParcela;

  if (dtmContratosImoveis.ContaRecebimentos = 0) then
    if RecebimentosInt.Conta = 0 then
      fraConsultaContas.edfCodigo.SetFocus
    else
      edtValorRecebido.SetFocus
  else
  begin
    if RecebimentosInt.Conta = 0 then
      fraConsultaContas.edfCodigo.Text:= inttostr(dtmContratosImoveis.ContaRecebimentos)
    else
        fraConsultaContas.edfCodigo.Text:= inttostr(RecebimentosInt.Conta);
    fraConsultaContas.edfCodigo.Exist;
    edtValorRecebido.SetFocus;
  end;
  if not RecebimentosInt.AlterandoParcela then
  begin
    cbxLiberarJuros.Checked:= True;
    cbxLiberarJurosClick(Self);
  end;

  if RecebimentosInt.AlterandoParcela then
    RecebimentosInt.Pagamento:= RecebimentosInt.qryParcelas.FieldbyName('datapagto').AsDateTime;

  if RecebimentosInt.AlterandoParcela then
  begin
    sbnSalvar.Enabled:= False;
    if not RecebimentosInt.VerificarParcelaPosterior then
      sbnCancelar.Enabled:= False
    else
      sbnCancelar.Enabled:= not sbnSalvar.Enabled;
  end;
end;

