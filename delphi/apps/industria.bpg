#------------------------------------------------------------------------------
VERSION = BWS.01
#------------------------------------------------------------------------------
!ifndef ROOT
ROOT = $(MAKEDIR)\..
!endif
#------------------------------------------------------------------------------
MAKE = $(ROOT)\bin\make.exe -$(MAKEFLAGS) -f$**
DCC = $(ROOT)\bin\dcc32.exe $**
BRCC = $(ROOT)\bin\brcc32.exe $**
#------------------------------------------------------------------------------
PROJECTS = tecsoft6.bpl automacao.bpl repositorio.bpl teclux.exe vendas.bpl \
  estoque.bpl producao.bpl contasareceber.bpl adminsistema.bpl bancos.bpl \
  caixa.bpl cobranca.bpl contabil.bpl contaspagar.bpl entrega.bpl financeiro.bpl \
  interlojas.bpl livrosfiscais.bpl montagens.bpl sac.bpl
#------------------------------------------------------------------------------
default: $(PROJECTS)
#------------------------------------------------------------------------------


tecsoft6.bpl: ..\industria\biblio\componentes\tecsoft6.dpk
  $(DCC)

repositorio.bpl: ..\industria\repositorio\repositorio.dpk
  $(DCC)

vendas.bpl: ..\industria\apps\vendas\vendas.dpk
  $(DCC)

automacao.bpl: ..\industria\biblio\automacao\automacao.dpk
  $(DCC)

teclux.exe: ..\industria\apps\tecsoft\teclux.dpr
  $(DCC)

estoque.bpl: ..\industria\apps\estoque\estoque.dpk
  $(DCC)

producao.bpl: ..\industria\apps\producao\producao.dpk
  $(DCC)

adminsistema.bpl: ..\industria\apps\adminsistema\adminsistema.dpk
  $(DCC)

bancos.bpl: ..\industria\apps\bancos\bancos.dpk
  $(DCC)

caixa.bpl: ..\industria\apps\caixa\caixa.dpk
  $(DCC)

cobranca.bpl: ..\industria\apps\cobranca\cobranca.dpk
  $(DCC)

contabil.bpl: ..\industria\apps\contabil\contabil.dpk
  $(DCC)

contaspagar.bpl: ..\industria\apps\contaspagar\contaspagar.dpk
  $(DCC)

entrega.bpl: ..\industria\apps\entrega\entrega.dpk
  $(DCC)

financeiro.bpl: ..\industria\apps\financeiro\financeiro.dpk
  $(DCC)

interlojas.bpl: ..\industria\apps\interlojas\interlojas.dpk
  $(DCC)

livrosfiscais.bpl: ..\industria\apps\livrosfiscais\livrosfiscais.dpk
  $(DCC)

montagens.bpl: ..\industria\apps\montagens\montagens.dpk
  $(DCC)

sac.bpl: ..\industria\apps\sac\sac.dpk
  $(DCC)

contasareceber.bpl: contasareceber\contasareceber.dpk
  $(DCC)


