  object qryPedidosFiliais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterScroll = qryPedidosFiliaisAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select     pf.codigo,'
      
        '               cast(to_char(pf.data,'#39'DD/MM/YYYY HH24:MI'#39') as var' +
        'char) as data,'
      '               pf.requisitada,'
      '               pf.produto,'
      '               pf.qtdepedida,'
      '               pf.qtderecebida,'
      '               pf.dadofiscal,'
      
        '               cast(('#39'N-'#39' || cast(n.numero as varchar) || '#39'  S-'#39 +
        ' || n.serie) as varchar) as nota_serie,'
      '               f.nome,'
      '               p.descricao,'
      
        '               (select gr.descricao from grades gr where gr.codi' +
        'go = c.grade1) as linha,'
      
        '               (select gr.descricao from grades gr where gr.codi' +
        'go = c.grade2) as coluna, '
      '               p.valorgrade1,'
      '               p.valorgrade2,'
      '               false as selecionar,'
      '               0.00 as semvalor'
      
        'From       pedidosfiliais pf left join notas n on (pf.dadofiscal' +
        ' = n.dadofiscal),  produtos p,  filiais f,  caracteristicas c'
      'Where     '
      '/*           Periodo               */               '
      '       and  (pf.requisitante =:requisitante)'
      '       and  (pf.situacao = '#39'F'#39')'
      '       and  (pf.produto = p.codigo)    '
      '       and  (p.caracteristica = c.codigo)'
      '/*           Usuario         */       '
      '       and  (pf.requisitada = f.codigo)'
      '               ')
    RequestLive = True
    Left = 80
    Top = 80
    ParamData = <
      item
        DataType = ftInteger
        Name = 'requisitante'
        ParamType = ptUnknown
        Value = '0'
      end>
