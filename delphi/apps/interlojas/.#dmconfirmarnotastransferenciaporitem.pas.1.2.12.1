end;

procedure TdtmConfirmarNotasTransferenciaPorItem.FecharTabelas;
begin
  Fecha(ctLOJTabelaConsultaUsuarios);
end;

function TdtmConfirmarNotasTransferenciaPorItem.GerarConsultaPedidosFiliais: Boolean;
begin
  if qryPedidosFiliais.Active then
    qryPedidosFiliais.Close;
  qryPedidosFiliais.Params[0].AsInteger:= FilialBase;
  qryPedidosFiliais.Open;
  Result:= qryPedidosFiliais.IsEmpty;
  if Result then
    qryPedidosFiliais.Close;
  QtdeMarcados:= 0;
end;

