begin
  inherited;
  qryProcurarUsuarios.Tag := ctTabelas;
  qryConsultaUsuarios.Tag := ctLOJTabelaConsultaUsuarios;
  qryProcurarUsuarios.Params[0].AsInteger := CodigoUsuario;
