procedure TdtmConfirmarNotasTransferenciaPorItem.AbrirTabelas;
begin
  Abre(ctLOJTabelaConsultaUsuarios);
end;

procedure TdtmConfirmarNotasTransferenciaPorItem.BloquearEstoque;
var
  Pos: TBookmark;
  WhereSQL: String;
begin
  Pos := qryProdutosNotasPag.GetBookmark;
  qryProdutosNotasPag.DisableControls;
  try
    if qryProdutosNotasPag.RecordCount = 0 then
      WhereSQL := 'false'
    else begin
      WhereSQL := '';
      qryProdutosNotasPag.First;
      while Not qryProdutosNotasPag.Eof do begin
        WhereSQL := WhereSQL +
        '((e.produto = ' + qryProdutosNotasPagproduto.AsString + ')and' +
        '(e.filial = '   + qryProdutosNotasPagfilial.AsString  + '))or';
        qryProdutosNotasPag.Next
      end;
      Delete(WhereSQL, Length(WhereSQL) - 1, 2);
    end
  finally
    qryProdutosNotasPag.GotoBookmark(Pos);
    qryProdutosNotasPag.FreeBookmark(Pos);
    qryProdutosNotasPag.EnableControls;
  end;
  qryEstoqueBloqueio.Sql[06] := WhereSQL;
  qryEstoqueBloqueio.Open;
end;

procedure TdtmConfirmarNotasTransferenciaPorItem.CadastrarNotaEntrada(DF: Integer);
begin
  ReFazConsulta(qryNotaEntregue,[0],[DF],false);
  if (qryNotaEntreguequantidade.AsCurrency = 0) then begin

    ReFazConsulta(qryNaturezasPadrao,[],[]);

    ReFazConsulta(qryDadosFiscais,[0],[DF]);
    ReFazConsulta(qryProdutosDadosFiscais,[0],[DF]);
//    ReFazConsulta(qryCalculosDadosFiscais,[0],[DF]);

    InicializarTabelas;
    IncluirNota;
    IncluirProdutos;
    BloquearEstoque;
    IncluirMovimentos;
    Perpetrar([qryNotasPag, qryMovimentos, qryProdutosNotasPag]);
  end
end;

procedure TdtmConfirmarNotasTransferenciaPorItem.ConfirmarTransferencia;
var
  Pos: TBookmark;
  DF : Integer;
  Lista: String;
begin
  if MensagemConfirmacao(ctCONFIRMARPRODUTOSTRANSFERENCIA) = smbOk then begin
    Pos:= qryPedidosFiliais.GetBookmark;
    qryPedidosFiliais.DisableControls;
    try
      Lista:= '';
      qryPedidosFiliais.First;
      while not qryPedidosFiliais.Eof do begin
        if qryPedidosFiliaisselecionar.AsBoolean then
          Lista:= Lista + qryPedidosFiliaiscodigo.AsString + ',';
        qryPedidosFiliais.Next;
      end;
    finally
      qryPedidosFiliais.GotoBookmark(Pos);
      qryPedidosFiliais.FreeBookmark(Pos);
      qryPedidosFiliais.EnableControls;
    end;
    if (Lista <> '') then begin
      Delete(Lista,Length(Lista),1);
      qryAtualizarPedidosFiliais.Sql[06]:= '(pf.codigo in (' + Lista + '))';
      qryAtualizarPedidosFiliais.Open;
      if (qryAtualizarPedidosFiliais.RecordCount > 0) then begin
        qryAtualizarPedidosFiliais.First;
        while not qryAtualizarPedidosFiliais.Eof do begin
          qryAtualizarPedidosFiliais.Edit;
          qryAtualizarPedidosFiliaissituacao.AsString:= 'D';
          qryAtualizarPedidosFiliais.Post;
          qryAtualizarPedidosFiliais.Next;
        end;
      end;
      Perpetrar([qryAtualizarPedidosFiliais]);
    end;

    qryAtualizarPedidosFiliais.First;
    DF := qryAtualizarPedidosFiliaisdadofiscal.AsInteger;
    while not qryAtualizarPedidosFiliais.Eof do begin
      if (DF <> qryAtualizarPedidosFiliaisdadofiscal.AsInteger) then
        CadastrarNotaEntrada(DF);
      DF := qryAtualizarPedidosFiliaisdadofiscal.AsInteger;
      qryAtualizarPedidosFiliais.Next;
    end;
    CadastrarNotaEntrada(DF);

    GerarConsultaPedidosFiliais;
  end;
end;

