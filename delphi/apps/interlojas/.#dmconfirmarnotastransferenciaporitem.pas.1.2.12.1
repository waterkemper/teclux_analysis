procedure TdtmConfirmarNotasTransferenciaPorItem.IncluirMovimentos;
var
  SituacaoProduto : TtecComposicao;
  Pos: TBookMark;
  QtdeMovto: Currency;
  MovExtra : Boolean;
begin
  Pos := qryProdutosNotasPag.GetBookmark;
  qryProdutosNotasPag.DisableControls;
  try
    for SituacaoProduto := stNAOCOMPOSTO to stCOMPOSTO do
    begin
      qryProdutosNotasPag.First;
      while not qryProdutosNotasPag.Eof do begin
        if FiltrarComposto(qryProdutosNotasPagcomposto.AsBoolean ,SituacaoProduto) then
        begin
          QtdeMovto:= 0;
          MovExtra:= False;
          if qryEstoqueBloqueio.Locate('produto;filial', VarArrayOf([qryProdutosNotasPagproduto.AsString,
                                                                     qryProdutosNotasPagfilial.AsInteger]) ,[]) then begin
            while (QtdeMovto < qryProdutosNotasPagquantidade.AsCurrency) do begin
              NovoMovimento(qryProdutosNotasPagproduto.AsLargeInt, qryProdutosNotasPagfilial.AsInteger);
              qryMovimentosreferencia.AsString  := 'NF-' + IntToStr(qryNotasPagnumero.AsInteger) +
                                                   ' S-' + qryNotasPagserie.AsString + ' TRANSFERENCIA';
              qryMovimentoscodigonota.AsInteger := qryProdutosNotasPagcodigonota.AsInteger;
              if (qryEstoqueBloqueiofuturo.AsCurrency > 0) then begin
                if MovExtra then begin
                  qryMovimentosquantidade.AsCurrency   := qryEstoqueBloqueiofuturo.AsCurrency;
                  qryMovimentostipomovimento.AsString := 'FTR';
                  qryMovimentosvalor.AsCurrency:= RoundTo((qryMovimentosquantidade.AsCurrency *
                                                           qryProdutosNotasPagprecounitario.AsCurrency),-2);
                end
                else begin
                  qryMovimentosquantidade.AsCurrency   := (qryProdutosNotasPagquantidade.AsCurrency -
                                                          qryEstoqueBloqueiofuturo.AsCurrency);
                  qryMovimentostipomovimento.AsString := 'STC';
                  qryMovimentosvalor.AsCurrency:= RoundTo((qryMovimentosquantidade.AsCurrency *
                                                           qryProdutosNotasPagprecounitario.AsCurrency),-2);
                end;
                QtdeMovto:= QtdeMovto + qryMovimentosquantidade.AsCurrency;
              end
              else begin
                qryMovimentosquantidade.AsCurrency   := qryProdutosNotasPagquantidade.AsCurrency;
                qryMovimentostipomovimento.AsString := 'STC';
                qryMovimentosvalor.AsCurrency:= RoundTo((qryMovimentosquantidade.AsCurrency *
                                                         qryProdutosNotasPagprecounitario.AsCurrency),-2);
                QtdeMovto:= QtdeMovto + qryMovimentosquantidade.AsCurrency;
              end;
              qryMovimentos.Post;
              MovExtra:= (QtdeMovto < qryProdutosNotasPagquantidade.AsCurrency);
            end;
          end;
        end;
        qryProdutosNotasPag.Next;
      end;
    end;
    qryProdutosNotasPag.Filtered := false;
  finally
    qryProdutosNotasPag.GotoBookmark(Pos);
    qryProdutosNotasPag.FreeBookmark(Pos);
    qryProdutosNotasPag.EnableControls
  end
end;

procedure TdtmConfirmarNotasTransferenciaPorItem.IncluirNota;
  procedure SelecionarCodigoNaturezaNotasPag(descricao: String);
  begin
    if qryNaturezasPadrao.Locate('descricao',descricao,[]) then
    begin
      qryNotasPagcodigonatureza.asinteger := qryNaturezasPadraonatureza.AsInteger;
      qryNotasPagnatureza.AsString       := qryNaturezasPadraodescricao.AsString;
      qryNotasPagcodigofiscal.AsInteger   := qryNaturezasPadraocodigofiscal.AsInteger;

      if HeUnidadeFederacao(qryNotasPagestado.AsString) then
      begin
        if qryNotasPagestado.AsString = EstadoFilialBase then
           qryNotasPagcodigofiscal.AsInteger := 1000 + qryNotasPagcodigofiscal.AsInteger mod 1000
        else
           qryNotasPagcodigofiscal.AsInteger := 2000 + qryNotasPagcodigofiscal.AsInteger mod 1000;
      end
      else
        qryNotasPagcodigofiscal.AsInteger := 3000 + qryNotasPagcodigofiscal.AsInteger mod 1000;
    end
    else
      MensagemAviso(ctNATUREZAPADRAONAOVINCULADA);
  end;
begin
  ReFazConsulta(qryFilialOrigem,[0],[qryDadosFiscaisfilial.AsInteger]);
  qryNotasPag.Insert;
  spcNotasPagProximo.Open;
  qryNotasPagcodigo.AsInteger:= spcNotasPagProximocodigo.AsInteger;
  spcNotasPagProximo.Close;

  qryNotasPagfornecedor.AsInteger       := qryDadosFiscaisfilial.AsInteger;
  qryNotasPagtipofornecedor.AsString    := 'L';
  qryNotasPagserie.AsString             := qryDadosFiscaisserie.AsString;
  qryNotasPagnumero.AsInteger           := qryDadosFiscaisnumeronota.AsInteger;
  qryNotasPagfilial.AsInteger           := qryDadosFiscaiscliente.AsInteger;
  qryNotasPagestado.AsString            := qryDadosFiscaisestadocfo.AsString;

  SelecionarCodigoNaturezaNotasPag(noTRANSFERENCIAMERCADORIAS);

  {
  if qryNotasPagestado.AsString = EstadoFilialBase then
     qryNotasPagcodigofiscal.AsInteger := (1000 + ctCFOTRANSFERENCIA)
  else if HeUnidadeFederacao(qryNotasPagestado.AsString) then
     qryNotasPagcodigofiscal.AsInteger := (2000 + ctCFOTRANSFERENCIA)
  else
     qryNotasPagcodigofiscal.AsInteger := (3000 + ctCFOTRANSFERENCIA);
  qryNotasPagnatureza.AsString          := qryDadosFiscaisnatureza.AsString;
  qryNotasPagcodigonatureza.AsInteger   := qryDadosFiscaiscodigonatureza.AsInteger;
  }

  qryNotasPagemissao.AsDateTime         := qryDadosFiscaisdata.AsDateTime;
  qryNotasPagdata.AsDateTime            := DataServidor;
  qryNotasPagcnpj.AsString              := qryFilialOrigemcnpj.AsString;
  qryNotasPaginscricaoestadual.AsString := qryFilialOrigeminscricaoestadual.AsString;
  qryNotasPagvalornota.AsCurrency       := qryDadosFiscaisvalortotal.AsCurrency;
  qryNotasPagsituacao.AsString := 'N';
  qryNotasPag.Post;
  qryFilialOrigem.Close;
end;

