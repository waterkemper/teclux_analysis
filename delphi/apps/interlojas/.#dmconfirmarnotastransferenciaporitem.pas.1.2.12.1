procedure TdtmConfirmarNotasTransferenciaPorItem.MontaIntervaloData;
const
  Data_1: String = '(cast(pf.data as date) = ';
  Data_2: String = '(cast(pf.data as date) between (';
begin
  if not DataEmBranco(FDataInicial) then begin
    if DataEmBranco(FDataFinal) then
         qryPedidosFiliais.Sql[WherePeriodo]:= Data_1 + '''' + FDataInicial + ''')'
    else qryPedidosFiliais.Sql[WherePeriodo]:= Data_2 + '''' + FDataInicial + ''') and (''' + FDataFinal + '''))';
  end
  else begin
    if not DataEmBranco(FDataFinal) then
         qryPedidosFiliais.Sql[WherePeriodo]:= Data_1 + '''' + FDataFinal + ''')'
    else qryPedidosFiliais.Sql[WherePeriodo]:= '';
  end;
end;

