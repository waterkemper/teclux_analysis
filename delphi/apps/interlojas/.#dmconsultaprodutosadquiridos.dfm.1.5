        Name = 'Fornecedor'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';Select   adquiridos.filial,'
      '          adquiridos.produto,'
      '          adquiridos.quantidade,'
      '          adquiridos.fornecedor,'
      '          adquiridos.tipofornecedor,'
      '          adquiridos.data,'
      '          (SELECT emestoque'
      '           FROM estoques'
      '           WHERE produto=adquiridos.produto'
      
        '           AND filial= CASE WHEN f.tipofilial=''V'' THEN COALESCE(' +
        'f.filial_estoque,f.codigo) ELSE f.codigo END'
      '           ) as emestoque,'
      '          p.descricao,'
      '          p.referencia,'
      
        '          (select gr.descricao from grades gr where gr.codigo = ' +
        'c.grade1) as linha,'
      
        '          (select gr.descricao from grades gr where gr.codigo = ' +
        'c.grade2) as coluna,'
      '          p.valorgrade1,'
      '          p.valorgrade2,'
      '          vf.nome,'
      '          false as selecionar,'
      '          true as requisitado,'
      '          0.00 as semvalor,'
      '          c.composto,'
      
        '          CASE WHEN f.tipofilial=''V'' THEN COALESCE(f.filial_esto' +
        'que,f.codigo) ELSE f.codigo END AS filial_estoque'
      'From     ( Select   pn.filial,'
      '                    pn.produto,'
      '                    sum(pn.quantidade) as quantidade,'
      '                    n.fornecedor,'
      '                    n.tipofornecedor,'
      '                    max(n.data) as data'
      '           From    produtosnotaspag pn, notaspag n'
      
        '           Where  (pn.codigonota = n.codigo) and (n.situacao<>''P' +
        ''')'
      '                   %Transferencias'
      '                   %Periodo'
      '                   %Filial'
      '                   %Fornecedor'
      
        '           Group By n.fornecedor, n.tipofornecedor, pn.filial, p' +
        'n.produto'
      
        '           ) as adquiridos, produtos p, caracteristicas c, vforn' +
        'ecedores vf,filiais f'
      'Where     (adquiridos.fornecedor = vf.codigo)   and'
      '          (adquiridos.tipofornecedor = vf.tipo) and'
      '          (adquiridos.produto = p.codigo) and'
      '          (p.caracteristica = c.codigo) and'
      '          (f.codigo=adquiridos.filial)')
    RequestLive = True
    Left = 79
    Top = 149
