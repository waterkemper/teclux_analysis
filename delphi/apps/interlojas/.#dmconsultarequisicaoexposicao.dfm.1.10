  object qryPedidosConfirmados: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select   pf.codigo,'
      '             pf.produto,'
      '             cast(case when pf.situacao = '#39'F'#39' then '#39'FECHADO'#39
      
        '                             when pf.situacao = '#39'D'#39' then '#39'CONFIR' +
        'MADO'#39
      '                             else '#39' '#39
      
        '                     end as varchar) as descsituacao,           ' +
        '       '
      '             p.descricao,'
      
        '            (select gr.descricao from grades gr where gr.codigo ' +
        '= c.grade1) as linha,'
      
        '            (select gr.descricao from grades gr where gr.codigo ' +
        '= c.grade2) as coluna,'
      '            p.valorgrade1,'
      '            p.valorgrade2,'
      '            c.grupo'
      'From     pedidosfiliais pf, produtos p, caracteristicas c'
      'Where  (pf.dadofiscal =:dadofiscal)  and'
      '            (pf.produto = p.codigo) and'
      '            (p.caracteristica = c.codigo)'
      '            ')
    RequestLive = False
    Left = 64
    Top = 101
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'dadofiscal'
        ParamType = ptUnknown
      end>
    object qryPedidosConfirmadoscodigo: TIntegerField
      FieldName = 'codigo'
    end
