  object qryPedidosFiliais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeInsert = qryPedidosFiliaisBeforeInsert
    AfterPost = qryPedidosFiliaisAfterPost
    AfterScroll = qryPedidosFiliaisAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Periodo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Situacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select pf.codigo,'
      '       pf.produto,'
      
        '       cast(to_char(pf.data,'#39'DD/MM/YYYY HH24:MI'#39') as varchar) as' +
        ' data,'
      '       pf.requisitante,'
      '       pf.requisitada,'
      '       pf.qtdepedida,'
      '       pf.qtdepedida as qtdepedidaantiga,'
      '       pf.qtderecebida,'
      '       pf.situacao,'
      '       pf.observacao,'
      '       pf.dadofiscal,'
      '       p.descricao,'
      
        '       (select gr.descricao from grades gr, caracteristicas c wh' +
        'ere gr.codigo = c.grade1 and c.codigo = p.caracteristica) as lin' +
        'ha,'
      
        '       (select gr.descricao from grades gr, caracteristicas c wh' +
        'ere gr.codigo = c.grade2 and c.codigo = p.caracteristica) as col' +
        'una,'
      '       p.valorgrade1,'
      '       p.valorgrade2,'
      
        '       cast(('#39'N-'#39' || cast(n.numero as varchar) || '#39'  S-'#39' || n.se' +
        'rie) as varchar) as nota_serie,'
      
        '       (Select e1.emestoque From estoques e1 Where (e1.produto =' +
        ' pf.produto) and (e1.filial = CASE WHEN f.tipofilial='#39'V'#39' THEN CO' +
        'ALESCE(f.filial_estoque,f.codigo) ELSE f.codigo END)) AS estoque' +
        'requisitada,'
      
        '       (Select e2.reservaprevia FROM estoques e2 WHERE (e2.produ' +
        'to=pf.produto) AND (e2.filial=CASE WHEN f.tipofilial='#39'V'#39' THEN CO' +
        'ALESCE(f.filial_estoque,f.codigo) ELSE f.codigo END)) AS reserva' +
        'previa,'
      
        '       (Select e3.emestoque From estoques e3 Where (e3.produto =' +
        ' pf.produto) and (e3.filial = pf.requisitante))AS estoquerequisi' +
        'tante,'
      '       p.referencia,'
      
        '       CASE WHEN f.tipofilial='#39'V'#39' THEN COALESCE(f.filial_estoque' +
        ',f.codigo) ELSE f.codigo END as filial_estoque'
      ''
      
        'From   pedidosfiliais pf left join notas n on (pf.dadofiscal = n' +
        '.dadofiscal), produtos p,filiais f'
      'Where (pf.produto = p.codigo)'
      'AND pf.requisitada=f.codigo'
      'AND (pf.requisitante =:requisitante)'
      '%Periodo'
      '%Situacao'
      'Order By pf.requisitada, pf.produto')
    RequestLive = True
    Left = 74
    Top = 25
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'requisitante'
        ParamType = ptUnknown
      end>
