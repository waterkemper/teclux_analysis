function TdtmExportacaoNotasTransferencia.GerarConsultaNotas: Boolean;
begin
  qryNotas.Close;

  if fFilial <> 0 then
    qrynotas.MacroByName('FILIAL').AsString := 'AND notas.filial = ' + IntToStr(fFilial);
  if fSerie <> '' then
    qryNotas.MacroByName('SERIE').AsString := 'AND notas.serie = ' + fSerie;
  if fNumero <> 0 then
    qryNotas.MacroByName('NUMERO').AsString := 'AND notas.numero = ' + IntToStr(fNumero);
  qryNotas.MacroByName('DATA').AsString := MontarIntervaloData('dadosfiscais.data',DateTimeToStr(fDataInicial),DateTimeToStr(fDataFinal));
  qryNotas.MacroByName('CFOP').AsString := 'AND dadosfiscais.codigofiscal % 1000 IN (' + IntToStr(ctCFOTRANSFERENCIA_150) + ',' + IntToStr(ctCFOTRANSFERENCIA_151) + ',' +
                                                                                       IntToStr(ctCFOTRANSFERENCIA_152) + ',' + IntToStr(ctCFOTRANSFERENCIANAOTRANS) + ',' +
                                                                                       IntToStr(ctCFOTRANSFERENCIASUBSTITUICAO) + ')';
  qryNotas.Open;
  Result := not qryNotas.IsEmpty
end;

function TdtmExportacaoNotasTransferencia.getQtdeNotas: Integer;
begin
  result := qryNotas.RecordCount
end;

function TdtmExportacaoNotasTransferencia.getTotalNotas: Currency;
begin
  result := TotalizarValores[qryNotas,qryNotasvalortotal]
end;

procedure TdtmExportacaoNotasTransferencia.MarcarSelecionados(Marcando,
  Todos: Boolean);
begin
  MarcarRegistros(qryNotas,
                  qryNotasselecionar,
                  qryNotasvalortotal,
                  Marcando,
                  Todos);
end;

function TdtmExportacaoNotasTransferencia.TemNotaSelecionada: Boolean;
begin
  result := qryNotas.Active;
  if result then
  begin
    GuardarRegistroAtual(qryNotas,true);
    try
      qryNotas.First;
      while not qryNotas.Eof do
      begin
        Result := qryNotasselecionar.AsBoolean;
        if Result then
          Break;
        qryNotas.Next;
      end;
    finally
      VoltarRegistroAtual(qryNotas);
    end;
  end;
end;

