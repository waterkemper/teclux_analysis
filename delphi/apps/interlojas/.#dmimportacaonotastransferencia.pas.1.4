function TdtmImportacaoNotasTransferencia.CorrigirChaves(var Msg: String): Boolean;
var
  DadoFiscal: Integer;
begin
  Result := True;
  try
    qryDadosFiscais.First;
    while not qryDadosFiscais.Eof do
    begin
      spcDadosFiscaisProximo.Open;
      DadoFiscal := spcDadosFiscaisProximonumero.AsInteger;
      spcDadosFiscaisProximo.Close;

      if qryNotas.Active then
      begin
        qryNotas.First;
        while not qryNotas.Eof do
        begin
          if qryNotasdadofiscal.AsInteger = qryDadosFiscaisnumero.AsInteger then
          begin
            qryNotas.Edit;
            qryNotasdadofiscal.AsInteger := DadoFiscal;
            qryNotas.Post;
          end;
          qryNotas.Next;
        end;
      end;

      if qryMovimentos.Active then
      begin
        qryMovimentos.First;
        while not qryMovimentos.Eof do
        begin

          qryMovimentos.Edit;

          if qryMovimentosdadofiscal.AsInteger = qryDadosFiscaisnumero.AsInteger then
            qryMovimentosdadofiscal.AsInteger := DadoFiscal;

          spcMovimentosProximo.Open;
          qryMovimentosnumero.AsInteger := spcMovimentosProximonumero.AsInteger;
          spcMovimentosProximo.Close;
          qryMovimentos.Post;

          qryMovimentos.Next;
        end;
      end;

      if qryProdutosDadosFiscais.Active then
      begin
        qryProdutosDadosFiscais.First;
        while not qryProdutosDadosFiscais.Eof do
        begin
          if qryProdutosDadosFiscaisdadofiscal.AsInteger = qryDadosFiscaisnumero.AsInteger then
          begin
            qryProdutosDadosFiscais.Edit;
            qryProdutosDadosFiscaisdadofiscal.AsInteger := DadoFiscal;
            qryProdutosDadosFiscais.Post;
          end;
          qryProdutosDadosFiscais.Next;
        end;
      end;

      if qryPedidosFiliais.Active then
      begin
        qryPedidosFiliais.First;
        while not qryPedidosFiliais.Eof do
        begin
          if qryPedidosFiliaisdadofiscal.AsInteger = qryDadosFiscaisnumero.AsInteger then
          begin
            qryPedidosFiliais.Edit;
            spcPedidosTransferenciaProximo.Open;
            qryPedidosFiliaiscodigo.AsInteger := spcPedidosTransferenciaProximocodigo.AsInteger;
            spcPedidosTransferenciaProximo.Close;
            qryPedidosFiliaisdadofiscal.AsInteger := DadoFiscal;
            qryPedidosFiliais.Post;
          end;
          qryPedidosFiliais.Next;
        end;
      end;

      qryDadosFiscais.Edit;
      qryDadosFiscaisnumero.AsInteger := DadoFiscal;
      qryDadosFiscais.Post;
      qryDadosFiscais.Next;
    end;
  except
    on e:exception do
    begin
      Msg := e.Message;
      Result := False;
    end;
  end;
end;

constructor TdtmImportacaoNotasTransferencia.Create(AOwner: TComponent);
begin
  inherited;
  fDirImportacao := '';
end;

function TdtmImportacaoNotasTransferencia.GravarTabelas: Boolean;
begin
  Result := Perpetrar([qryDadosFiscais, qryNotas, qryMovimentos,
                       qryProdutosDadosFiscais, qryPedidosFiliais]);
end;

function TdtmImportacaoNotasTransferencia.ImportarArquivos: Boolean;
var
  Msg: String;
begin
  Msg := '';

  result := ImportarNotasVerificacao(Msg);

  if result then
  begin
    Result := ImportarDadosFiscais(Msg);
    if Result then
      Result := ImportarNotas(Msg);

    if Result then
      Result := ImportarMovimentos(Msg);

    if Result then
      Result := ImportarProdutos(Msg);

    if Result then
      Result := ImportarPedidos(Msg);

    if Result then
      Result := CorrigirChaves(Msg)
    else
      MensagemAviso(Msg);

    if Result then
      Result := GravarTabelas;
  end;

  qryNotasVerificacao.Close;
  qryDadosFiscais.Close;
  qryNotas.Close;
  qryMovimentos.Close;
  qryProdutosDadosFiscais.Close;
  qryPedidosFiliais.Close;
  
end;

function TdtmImportacaoNotasTransferencia.ImportarDadosFiscais(var Msg: String): Boolean;
var
  Lista,
  Campos: TStringList;
  i,j: integer;
  codigos: String;
begin
  Result := True;
  try
    if FileExists(fDirImportacao+'DadosFiscais.txt') then
    begin
      codigos := '';
      Lista := TStringList.Create;
      try
        Lista.LoadFromFile(fDirImportacao+'DadosFiscais.txt');
        for i:=0 to Lista.Count-1 do
        begin
          Campos := Explode(';',Lista.Strings[i]);
          try
            if not qryDadosFiscais.Active then
              qryDadosFiscais.Open;

            qryDadosFiscais.Append;

            for j:=0 to qryDadosFiscais.FieldCount -1 do
            begin
              if campos[j] <> '' then
              begin
                qryDadosFiscais.Fields[j].AsString := campos[j];
                if qryDadosFiscais.Fields[j].FieldName = 'numero' then
                 if qryNotasVerificacao.Locate('dadofiscal',qryDadosFiscais.Fields[j].AsInteger,[]) then
                 begin
                   qrydadosfiscais.Cancel;
                   break;
                 end;
              end;
            end;

            if qryDadosFiscais.state = dsinsert then
              qryDadosFiscais.Post;
          finally
            FreeAndNil(Campos);
          end;
        end;
      finally
        Lista.Free;
      end;
    end;
  except
    on e:Exception do
    begin
      Msg := e.Message;
      result := false;
    end;
  end;
end;

function TdtmImportacaoNotasTransferencia.ImportarMovimentos(var Msg: String): Boolean;
var
  Lista,
  Campos: TStringList;
  i,j: integer;
  codigos: String;
begin
  Result := True;
  try
    if FileExists(fDirImportacao+'Movimentos.txt') then
    begin
      codigos := '';
      Lista := TStringList.Create;
      try
        Lista.LoadFromFile(fDirImportacao+'Movimentos.txt');
        for i:=0 to Lista.Count-1 do
        begin
          Campos := Explode(';',Lista.Strings[i]);
          try
            if not qryMovimentos.Active then
              qryMovimentos.Open;
            qryMovimentos.Append;

            for j:=0 to qryMovimentos.FieldCount -1 do
            begin
              if campos[j] <> '' then
              begin
                qryMovimentos.Fields[j].AsString := campos[j];

                if qryMovimentos.Fields[j].FieldName = 'dadofiscal' then
                begin
                  if qryNotasVerificacao.Locate('dadofiscal',qryMovimentos.Fields[j].AsInteger,[]) then
                  begin
                    qryMovimentos.Cancel;
                    break;
                  end;
                  qryMovimentos.Fields[j].Clear; {não deve ser gravado, imitando ATR}
                end;

              end;
            end;

            if qryMovimentos.state = dsinsert then
              qryMovimentos.Post;
          finally
            FreeAndNil(Campos);
          end;
        end;
      finally
        Lista.Free;
      end;
    end;
  except
    on e:Exception do
    begin
      Msg := e.Message;
      result := false;
    end;
  end;
end;

function TdtmImportacaoNotasTransferencia.ImportarNotas(var Msg: String): Boolean;
var
  Lista,
  Campos: TStringList;
  i,j: integer;
  codigos: String;
begin
  Result := True;
  try
    if FileExists(fDirImportacao+'Notas.txt') then
    begin
      codigos := '';
      Lista := TStringList.Create;
      try
        Lista.LoadFromFile(fDirImportacao+'Notas.txt');
        for i:=0 to Lista.Count-1 do
        begin
          Campos := Explode(';',Lista.Strings[i]);
          try
            if not qryNotas.Active then
              qryNotas.Open;
            qryNotas.Append;

            for j:=0 to qryNotas.FieldCount -1 do
            begin
              if campos[j] <> '' then
              begin
                qryNotas.Fields[j].AsString := campos[j];

                if qryNotas.Fields[j].FieldName = 'dadofiscal' then
                 if qryNotasVerificacao.Locate('dadofiscal',qryNotas.Fields[j].AsInteger,[]) then
                 begin
                   qryNotas.Cancel;
                   break;
                 end;

              end;
            end;
            if qryNotas.state = dsinsert then
              qryNotas.Post;
          finally
            FreeAndNil(Campos);
          end;
        end;
      finally
        Lista.Free;
      end;
    end;
  except
    on e:Exception do
    begin
      Msg := e.Message;
      result := false;
    end;
  end;
end;

function TdtmImportacaoNotasTransferencia.ImportarNotasVerificacao(
  var Msg: String): Boolean;
var
  Lista,
  Campos: TStringList;
  i,j: integer;
  codigos: String;
begin
  Result := True;
  try
    if FileExists(fDirImportacao+'Notas.txt') then
    begin
      codigos := '';
      Lista := TStringList.Create;
      try
        Lista.LoadFromFile(fDirImportacao+'Notas.txt');
        for i:=0 to Lista.Count-1 do
        begin
          Campos := Explode(';',Lista.Strings[i]);
          try
            if not qryNotasVerificacao.Active then
              qryNotasVerificacao.Open;
            qryNotasVerificacao.Append;
            for j:=0 to qryNotas.FieldCount -1 do
              if campos[j] <> '' then
                qryNotasVerificacao.Fields[j].AsString := campos[j];
            qryNotasVerificacao.Post;
          finally
            FreeAndNil(Campos);
          end;
        end;
      finally
        Lista.Free;
      end;
    end;
  except
    on e:Exception do
    begin
      Msg := e.Message;
      result := false;
    end;
  end;

  if result then
  begin
    qryNotasVerificacao.First;
    while not qryNotasVerificacao.Eof do
    begin
      RefazConsultaPorNome(qrynotas,['filial','serie','numero'],
        [qryNotasVerificacaofilial.AsVariant,
         qryNotasVerificacaoserie.AsVariant,
         qryNotasVerificacaonumero.AsVariant]);

      if qrynotas.RecordCount = 0 then
        qryNotasVerificacao.Delete
      else
        qryNotasVerificacao.Next;
    end;
    qrynotas.Close;
  end;

end;


