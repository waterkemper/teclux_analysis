    Constraints = <>
    AfterOpen = qryPedidosFiliaisAfterOpen
    BeforeInsert = qryPedidosFiliaisBeforeInsert
    BeforePost = qryPedidosFiliaisBeforePost
    AfterPost = qryPedidosFiliaisAfterPost
