  object qryPedidosFiliais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryPedidosFiliaisAfterOpen
    BeforeInsert = qryPedidosFiliaisBeforeInsert
    BeforePost = qryPedidosFiliaisBeforePost
    AfterPost = qryPedidosFiliaisAfterPost
    AfterScroll = qryPedidosFiliaisAfterScroll
    OnFilterRecord = qryPedidosFiliaisFilterRecord
    Filtered = True
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Periodo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Requisitante'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Situacao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CurvaABC'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'QtdeConfirmada'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select pf.codigo,'
      '           pf.produto,'
      
        '           pf.requisitante, (select f.estado from filiais f wher' +
        'e f.codigo = pf.requisitante) as estadorequisitante,'
      '           pf.requisitada,'
      '           pf.qtdepedida,'
      '           pf.qtderecebida,'
      '           pf.qtderecebida as qtderecebidaanterior,'
      '           pf.situacao,'
      '           pf.observacao,'
      '           n.numero,'
      '           n.serie,'
      '           p.descricao,'
      '           p.referencia,'
      
        '           (select gr.descricao from grades gr, caracteristicas ' +
        'c where gr.codigo = c.grade1 and c.codigo = p.caracteristica) as' +
        ' linha,'
      
        '           (select gr.descricao from grades gr, caracteristicas ' +
        'c where gr.codigo = c.grade2 and c.codigo = p.caracteristica) as' +
        ' coluna,'
      '           p.valorgrade1,'
      '           p.valorgrade2,'
      
        '           /*cast(to_char(pf.data,'#39'DD/MM/YYYY HH24:MI'#39') as varch' +
        'ar) as data,*/'
      '           pf.data,'
      
        '           cast(('#39'N-'#39' || cast(n.numero as varchar) || '#39'  S-'#39' || ' +
        'n.serie) as varchar) as nota_serie,'
      '           (Select e1.emestoque From estoques e1'
      
        '                                               Where (e1.produto' +
        ' = pf.produto) and'
      
        '                                                          (e1.fi' +
        'lial = pf.requisitante)) as estoquerequisitante,'
      '           (Select e1.emestoque From estoques e1'
      
        '                                               Where (e1.produto' +
        ' = pf.produto) and'
      
        '                                                          (e1.fi' +
        'lial = pf.requisitada)) as estoquerequisitada,'
      
        '           (Select e1.reservaprevia From estoques e1 Where e1.pr' +
        'oduto=pf.produto and e1.filial=pf.requisitada) as reservapreviar' +
        'equisitada,'
      '           0.00 as semvalor,'
      
        '           (select i.classificacaofiscal  from ipi i    where (i' +
        '.codigo = c.ipi)) as classificacaofiscal,'
      
        '           (select ipi.extipi from ipi where ipi.codigo = c.ipi)' +
        ' as extipi,'
      
        '           (select ipi.genero from ipi where ipi.codigo = c.ipi)' +
        ' as genero,'
      '           c.unidade,'
      '           c.ICMSModalidade,'
      '           c.ICMSModSubst,'
      '           p.resultadocurvaabc,'
      '           pf.lotetransferencia,'
      '           case when pf.lotetransferencia is not null then true'
      '           else false end as marcarlotetransferencia,'
      '           p.codigovisual'
      ''
      
        'From   pedidosfiliais pf left join notas n on (pf.dadofiscal = n' +
        '.dadofiscal), produtos p, caracteristicas c'
      'Where (pf.produto = p.codigo) and (p.caracteristica = c.codigo)'
      '    and (pf.requisitada =:requisitada)'
      ''
      '%Periodo'
      '%Requisitante'
      '%Situacao'
      '%CurvaABC'
      '%QtdeConfirmada'
      ''
      'Order By pf.requisitante, pf.produto')
    RequestLive = True
    Active = True
    Left = 218
    Top = 9
    ParamData = <
      item
        DataType = ftInteger
        Name = 'requisitada'
        ParamType = ptUnknown
        Value = '0'
      end>
