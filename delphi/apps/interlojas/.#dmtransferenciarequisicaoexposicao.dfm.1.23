  object qryConsultaProduto: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AutoCalcFields = False
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      
        'Select Selecionar_AliquotaIcms(:EstadoFilialBase, :EstadoFilialD' +
        'estino, :TipoPessoa, p.codigo) as aliquotaicms,'
      '       (Select c.icms From  caracteristicas c'
      '                              Where c.codigo = p.caracteristica'
      '       ) as icms,'
      '       c.origem,'
      '       (Select t.valor From tributosicms t'
      
        '                              Where (t.codigo = c.incidencia) an' +
        'd'
      
        '                                         (c.codigo = p.caracteri' +
        'stica)'
      '       ) as incidencia,'
      '       c.csosn,'
      ''
      '       c.ipicst,'
      '       c.cofinscst,'
      '       c.piscst,'
      ''
      
        '       (Select Round(m.financeiro / quantidadetotaldoestoque(m.n' +
        'umero),2)'
      '        From movimentos m'
      '        Where m.numero = (Select m1.numero'
      '                          From movimentos m1'
      '                          Where (m1.produto = p.codigo) and'
      '                          (m1.filial  =:filial)'
      
        '                          order by m1.data desc, m1.lancto desc ' +
        'limit 1'
      '                          )'
      '       ) as customedio,'
      
        '       (select e.valorultimacompra from estoques e where e.produ' +
        'to=p.codigo and e.filial=:filial) as valorultimacompra,'
      '       (Select i.aliquota From  ipi i'
      '                              Where i.codigo = c.ipi'
      '       ) as aliquotaipi,'
      '       c.percreducaobase,'
      '       c.composto'
      'From produtos p, caracteristicas c'
      'Where (p.codigo = :produto)   and'
      '           (p.caracteristica = c.codigo)'
      '')
    RequestLive = False
    Left = 356
    Top = 269
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'EstadoFilialBase'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'EstadoFilialDestino'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'TipoPessoa'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'produto'
        ParamType = ptUnknown
      end>
    object qryConsultaProdutoaliquotaicms: TFloatField
      FieldName = 'aliquotaicms'
      DisplayFormat = '0.00'
    end
    object qryConsultaProdutoicms: TIntegerField
      FieldName = 'icms'
      DisplayFormat = '0'
    end
