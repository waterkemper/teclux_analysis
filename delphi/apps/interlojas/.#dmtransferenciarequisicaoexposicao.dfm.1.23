    Sql.Strings = (
      'Select f.codigo,'
      '       f.nome,'
      '       f.razao,'
      '       f.rua,'
      '       f.estado,'
      '       f.bairro,'
      '       (select b.nome'
      '        from bairros b'
      '        where b.estado = f.estado'
      '          and b.cidade = f.cidade'
      '          and b.codigo = f.bairro) as nomebairro,'
      '       f.cidade,'
      '       (select c.nome'
      '        from cidades c'
      '        where c.codigo = f.cidade'
      '          and c.estado = f.estado) as nomecidade,'
      '       f.cep,'
      '       f.cnpj,'
      '       f.foneddd,'
      '       f.fonenumero,'
      '       f.inscricaoestadual,'
      '       (select c.codigoibge'
      '        from cidades c'
      '        where c.codigo = f.cidade'
      '          and c.estado = f.estado) as codigoibge,'
      '       f.numero,'
      '       f.complemento,'
      '       f.contribicms'
      ''
      'From   filiais f'
      'Where f.codigo = :requisitante'
      '           ')
    RequestLive = False
