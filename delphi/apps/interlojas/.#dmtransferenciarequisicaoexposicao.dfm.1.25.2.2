        Name = 'CurvaABC'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'QtdeConfirmada'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select     pf.codigo,'
      '           pf.produto,'
      '           pf.requisitante,'
      '           pf.requisitada,'
      '           pf.qtdepedida,'
      '           pf.qtderecebida,'
      '           pf.qtderecebida as qtderecebidaanterior,'
      '           pf.situacao,'
      '           pf.observacao,'
      '           n.numero,'
      '           n.serie,'
      '           p.descricao,'
      '           p.referencia,'
      
        '           (select gr.descricao from grades gr, caracteristicas ' +
        'c where gr.codigo = c.grade1 and c.codigo = p.caracteristica) as' +
        ' linha,'
      
        '           (select gr.descricao from grades gr, caracteristicas ' +
        'c where gr.codigo = c.grade2 and c.codigo = p.caracteristica) as' +
        ' coluna,'
      '           p.valorgrade1,'
      '           p.valorgrade2,'
      '           pf.data,'
      
        '           cast(('#39'N-'#39' || cast(n.numero as varchar) || '#39'  S-'#39' || ' +
        'n.serie) as varchar) as nota_serie,'
      '           (Select e1.emestoque'
      '            From estoques e1'
      '            Where (e1.produto = pf.produto)'
      
        '            and (e1.filial = pf.requisitante)) as estoquerequisi' +
        'tante,'
      ''
      '           (Select e1.emestoque'
      '            From estoques e1'
      '            Where (e1.produto = pf.produto)'
      
        '            and (e1.filial = (case when f.tipofilial='#39'V'#39' then CO' +
        'ALESCE(f.filial_estoque,f.codigo) ELSE f.codigo END))) as estoqu' +
        'erequisitada,'
      ''
      '           (Select e1.reservaprevia'
      '            From estoques e1'
      '            Where e1.produto=pf.produto'
      
        '            and e1.filial= (case when f.tipofilial='#39'V'#39' then COAL' +
        'ESCE(f.filial_estoque,f.codigo) ELSE f.codigo END)) as reservapr' +
        'eviarequisitada,'
      '           0.00 as semvalor,'
      '           p.resultadocurvaabc,'
      '           pf.lotetransferencia,'
      '           case when pf.lotetransferencia is not null then true'
      '           else false end as marcarlotetransferencia,'
      '           p.codigovisual,'
      
        '           case when f.tipofilial='#39'V'#39' then COALESCE(f.filial_est' +
        'oque,f.codigo) ELSE f.codigo END as filial_estoque'
      ''
      
        'From   pedidosfiliais pf left join notas n on (pf.dadofiscal = n' +
        '.dadofiscal), produtos p, caracteristicas c,filiais f'
      
        'Where (pf.produto = p.codigo) and (p.caracteristica = c.codigo) ' +
        'and f.codigo=pf.requisitada'
      '    and (pf.requisitada =:requisitada)'
      ''
      '%Periodo'
      '%Requisitante'
      '%Situacao'
      '%CurvaABC'
      '%QtdeConfirmada'
      ''
      'Order By pf.requisitante, pf.produto')
    RequestLive = True
    Left = 218
    Top = 9
    ParamData = <
      item
        DataType = ftInteger
        Name = 'requisitada'
        ParamType = ptUnknown
        Value = '0'
      end>
