  object qryPedidosInconsistentes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftString
        Name = 'ListaLotesProdutos'
        ParamType = ptUnknown
        Value = '((0,0))'
      end
      item
        DataType = ftString
        Name = 'CondicaoInconsistencia'
        ParamType = ptUnknown
        Value = 'false'
      end>
    Sql.Strings = (
      ';'
      'select selecao.*'
      'from'
      '('
      '  select pf.*,'
      '         (select pc.lido'
      '          from produtosconferencia pc'
      
        '          where pc.codigo = cast(pf.lotetransferencia as varchar' +
        ')'
      '            and pc.tipo = '#39'TRF'#39
      '            and pc.produto = pf.produto) as lido,'
      ''
      '         (Select e1.reservaprevia'
      '          From estoques e1'
      '          Where e1.produto=pf.produto'
      
        '            and e1.filial= (case when f.tipofilial='#39'V'#39' then COAL' +
        'ESCE(f.filial_estoque,f.codigo) ELSE f.codigo END)) as reservapr' +
        'eviarequisitada,'
      ''
      '         p.codigovisual as produtovisual'
      ''
      '  from pedidosfiliais pf'
      '       join produtos p'
      '       on pf.produto = p.codigo'
      ''
      '       join filiais f'
      '       on f.codigo=pf.requisitada'
      ''
      
        '  where (pf.lotetransferencia,pf.produto) in (%ListaLotesProduto' +
        's)'
      ''
      ') as selecao'
      
        'where %CondicaoInconsistencia  /* coalesce(selecao.qtderecebida,' +
        '0) <> coalesce(selecao.lido,0) */'
      'order by lotetransferencia, produto      ')
    RequestLive = False
    Left = 432
    Top = 24
    object qryPedidosInconsistenteslotetransferencia: TIntegerField
      DisplayLabel = 'LOTE'
      FieldName = 'lotetransferencia'
    end
