  object qryProcuraFiliais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select codigo,'
      '       nome,'
      '       cnpj,'
      '      estado,'
      
        '      CASE WHEN tipofilial='#39'V'#39' then COALESCE(filial_estoque,codi' +
        'go) ELSE codigo END as filial_estoque'
      'From   filiais'
      'Where (codigo =:codigo) and'
      '           not (codigo in (:requisitada))')
    RequestLive = False
    Left = 74
    Top = 19
    ParamData = <
      item
        DataType = ftInteger
        Name = 'codigo'
        ParamType = ptUnknown
        Value = '0'
      end
      item
        DataType = ftInteger
        Name = 'requisitada'
        ParamType = ptUnknown
        Value = '0'
      end>
    object qryProcuraFiliaiscodigo: TIntegerField
      FieldName = 'codigo'
      DisplayFormat = '0'
    end
