  object qryPedidosFiliaisCodigoBarras: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Periodo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Requisitante'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Situacao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CurvaABC'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'QtdeConfirmada'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select pf.produto,'
      '       pcb.codigobarras'
      ''
      'From   pedidosfiliais pf'
      '       join produtos p'
      '            join caracteristicas c'
      '            on p.caracteristica = c.codigo'
      '       on pf.produto = p.codigo'
      '       join produtoscodigobarras pcb'
      '       on pf.produto = pcb.produto'
      ''
      'where pf.requisitada =:requisitada'
      ''
      '%Periodo'
      '%Requisitante'
      '%Situacao'
      '%CurvaABC'
      '%QtdeConfirmada'
      ''
      'Order By pf.requisitante, pf.produto')
    RequestLive = True
    Left = 242
    Top = 353
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'requisitada'
        ParamType = ptUnknown
      end>
    object qryPedidosFiliaisCodigoBarrasproduto: TLargeintField
      FieldName = 'produto'
    end
    object qryPedidosFiliaisCodigoBarrascodigobarras: TStringField
      DisplayLabel = 'C'#243'digo Barras'
      DisplayWidth = 18
      FieldName = 'codigobarras'
      Required = True
      Size = 60
    end
  end
