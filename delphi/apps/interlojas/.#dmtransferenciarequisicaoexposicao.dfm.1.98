  object qryPedidosFiliais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryPedidosFiliaisAfterOpen
    BeforeInsert = qryPedidosFiliaisBeforeInsert
    BeforePost = qryPedidosFiliaisBeforePost
    AfterPost = qryPedidosFiliaisAfterPost
    AfterScroll = qryPedidosFiliaisAfterScroll
    OnCalcFields = qryPedidosFiliaisCalcFields
    OnFilterRecord = qryPedidosFiliaisFilterRecord
    Filtered = True
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Periodo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Requisitante'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Situacao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CurvaABC'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'QtdeConfirmada'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'produtos'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select     pf.*,'
      '           f1.nome as nomefilialrequisitante,'
      '           n.numero,'
      '           n.serie,'
      '           p.descricao,'
      '           p.referencia,'
      
        '           (select gr.descricao from grades gr, caracteristicas ' +
        'c where gr.codigo = c.grade1 and c.codigo = p.caracteristica) as' +
        ' linha,'
      
        '           (select gr.descricao from grades gr, caracteristicas ' +
        'c where gr.codigo = c.grade2 and c.codigo = p.caracteristica) as' +
        ' coluna,'
      '           p.valorgrade1,'
      '           p.valorgrade2,'
      
        '           cast(('#39'N-'#39' || cast(n.numero as varchar) || '#39'  S-'#39' || ' +
        'n.serie) as varchar) as nota_serie,'
      ''
      '           (Select e1.emestoque'
      '            From estoques e1'
      '            Where (e1.produto = pf.produto)'
      
        '            and (e1.filial = pf.requisitante)) as estoquerequisi' +
        'tante,'
      ''
      '           (Select e1.minimo'
      '            From estoques e1'
      '            Where (e1.produto = pf.produto)'
      '            and (e1.filial = pf.requisitante)) as minimo,'
      ''
      '           (Select e1.maximo'
      '            From estoques e1'
      '            Where (e1.produto = pf.produto)'
      '            and (e1.filial = pf.requisitante)) as maximo,'
      ''
      '           (Select e1.emestoque'
      '            From estoques e1'
      '            Where (e1.produto = pf.produto)'
      
        '            and (e1.filial = (case when f.tipofilial='#39'V'#39' then CO' +
        'ALESCE(f.filial_estoque,f.codigo) ELSE f.codigo END))) as estoqu' +
        'erequisitada,'
      ''
      '           (Select e1.reservaprevia'
      '            From estoques e1'
      '            Where e1.produto=pf.produto'
      
        '            and e1.filial= (case when f.tipofilial='#39'V'#39' then COAL' +
        'ESCE(f.filial_estoque,f.codigo) ELSE f.codigo END)) as reservapr' +
        'eviarequisitada,'
      '           0.00 as semvalor,'
      '           p.resultadocurvaabc,'
      '           '
      
        '           case when pf.lotetransferencia is not null or (coales' +
        'ce(pf.qtderecebida,0)<>0) then true'
      '           else false end as marcarlotetransferencia,'
      ''
      '           p.codigovisual,'
      
        '           case when f.tipofilial='#39'V'#39' then COALESCE(f.filial_est' +
        'oque,f.codigo) ELSE f.codigo END as filial_estoque,'
      
        '           case when f1.tipofilial='#39'V'#39' then COALESCE(f1.filial_e' +
        'stoque,f1.codigo) ELSE f1.codigo END as filial_estoque_requisita' +
        'nte,'
      
        '           (select ti.valor from tributosicms ti where ti.codigo' +
        ' = c.incidencia) as cst_produto,'
      '           c.csosn as csosn_produto,'
      '           c.piscst as piscst_produto,'
      '           c.cofinscst as cofinscst_produto,'
      '           f1.estado as estadofilialrequisitante,'
      '    '#9#9'   e.localizacao,'
      '           p.promocao,'
      '           pro.descricao as descricaopromocao,'
      '           pf.qtderecebida as qtderecebidaanterior,'
      ''
      '           false as LoteVerificado,'
      '           false as HouveOutraAlteracao'
      ''
      'From  pedidosfiliais pf'
      '         left join notas n'
      '         on pf.dadofiscal = n.dadofiscal'
      ''
      '        join ( (produtos p'
      '                join caracteristicas c'
      '                on p.caracteristica = c.codigo)'
      ''
      '                left join promocoes pro'
      '                on p.promocao = pro.codigo)'
      ''
      '        on pf.produto = p.codigo'
      ''
      '        join filiais f'
      '        on f.codigo=pf.requisitada'
      ''
      '        join filiais f1'
      '        on f1.codigo=pf.requisitante'
      ''
      '        join estoques e'
      '        on e.produto = pf.produto'
      '        and e.filial = pf.requisitada'
      ''
      'Where pf.requisitada = :requisitada'
      ''
      '%Periodo'
      '%Requisitante'
      '%Situacao'
      '%CurvaABC'
      '%QtdeConfirmada'
      ''
      '%produtos'
      ''
      'Order By pf.requisitante, pf.produto')
    RequestLive = True
    Left = 186
    Top = 41
    ParamData = <
      item
        DataType = ftInteger
        Name = 'requisitada'
        ParamType = ptUnknown
        Value = '0'
      end>
