    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select nome,'
      '           codigo'
      'From   filiais'
      'Where not (codigo in (:requisitada))'
      'Order By UPPER(TO_ASCII(nome,'#39'LATIN1'#39'))')
    RequestLive = False
    Left = 100
    Top = 51
    ParamData = <
      item
        DataType = ftInteger
        Name = 'requisitada'
        ParamType = ptUnknown
      end>
