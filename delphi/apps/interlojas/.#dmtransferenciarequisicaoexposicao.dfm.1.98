  object qryComprasFiliaisGrupo: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkFields = 'produto=produto;grupo=grupo'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrComprasGruposFiliais
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftString
        Name = 'quantidadeemestoque'
        ParamType = ptUnknown
        Value = 'e.emEstoque + e.transito - e.futuro'
      end
      item
        DataType = ftUnknown
        Name = 'ListadeProdutos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'produtos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Filiais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'estoques'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '/* qryComprasFiliaisGrupo */'
      ';'
      'select *,'
      '       case when sugestao1 <= 0 then 0'
      
        '       else (cast(ROUND( ( cast((total_vendido) as float) / peri' +
        'odo) * :diasproporcional ) as float) - total_estoque - total_ped' +
        'ido + selecionados.futuro)'
      '       end as sugestao,'
      ''
      '       cast('
      '       case when coalesce(total_vendido,0)<>0 then'
      
        '         ((emEstoque + case when true then 0 else total_pedido e' +
        'nd)/'
      '          (Total_vendido / Periodo))'
      '       else'
      '         cast(999999.99 as numeric(11,2))'
      '       end as numeric(12,2)) as diasestoque,'
      ''
      '       cast('
      '       case when coalesce(total_vendido,0)<>0 then'
      
        '         ((total_estoque + case when  false then 0 else total_pe' +
        'dido end)/'
      '          (Total_vendido / Periodo))'
      '       else'
      '         cast(999999.99 as numeric(11,2))'
      '       end as numeric(12,2)) as diasestoquecompedidosdecompra,'
      ''
      '       selecionados.datapedido,'
      ''
      '       ped.entrega as entregapedidocompra,'
      '       pped.quantidade as quantidadepedidocompra,'
      '       ped.emissao as emissaopedidocompra'
      ''
      ''
      'from'
      ''
      '('
      
        'SELECT *, (cast(ROUND( ( cast(total_vendido as float)/ periodo) ' +
        '* :diasestoque ) as float) - total_estoque - total_pedido + futu' +
        'ro)  AS sugestao1,'
      
        '       case when :EstoqueTotal <> 0 then cast(total_estoque * 10' +
        '0 / :EstoqueTotal as numeric(6,2)) else 0 end as percEstoque,'
      ''
      '       (select max(m.data)'
      '        from movimentos m'
      '        where m.produto = selecionados.produto'
      '          and m.filial = selecionados.filial'
      '          and m.tipomovimento = '#39'STC'#39') as datapedido,'
      ''
      '       (select pped.pedido'
      '        from pedidos ped'
      '             join produtospedidos pped'
      '             on ped.numero = pped.pedido'
      ''
      '        where ped.filialentrega = selecionados.filial'
      '          and pped.produto = selecionados.produto'
      '          and ped.situacao in ('#39'A'#39', '#39'P'#39')'
      
        '          and pedidos_estoquepedido(pped.produto, ped.filialentr' +
        'ega, pped.pedido) > 0'
      '        order by ped.entrega desc limit 1'
      '        ) as PedidoCompra'
      ''
      'FROM'
      '  ('
      '        SELECT'
      '              s.filial,'
      '              s.produto,'
      '              s.periodo,'
      '              fgf.grupo,'
      '              filiais.mnemonico,'
      '              filiais.tipofilial,'
      '               ( s.estoque ) AS total_estoque,'
      '               ( s.emestoque ) AS emestoque,'
      '               ( s.transito ) AS total_transito,'
      '               ( s.pedido + s.pedidos_filiais) AS total_pedido,'
      '               ( s.pedido ) AS total_pedidos_fornecedores,'
      '               ( s.pedidos_filiais) AS total_pedidos_filiais,'
      '               ( s.vendido ) AS total_vendido,'
      '              s.reservado,'
      '              s.reservaprevia,'
      '              s.ultimavenda,              '
      '              s.precovenda,'
      '              s.datacompra,'
      
        '              s.minimo, case when (s.minimo - s.saldo)<0 then 0 ' +
        'else (s.minimo-s.saldo) end as sugestaominimo,'
      
        '              s.maximo,case when (s.maximo - s.saldo)<0 then 0 e' +
        'lse (s.maximo-s.saldo) end as sugestaomaximo, s.futuro'
      '       FROM'
      '       ('
      ''
      '              select e.*,'
      
        '                   coalesce(pedidos_estoquepedido,0) + produtosp' +
        'edidos_recebido_semnotaparcial AS pedido,'
      
        '                   e.estoque + pedidos_estoquepedido - e.futuro ' +
        'as saldo,'
      
        '                   case when e.datacadastro between :inicio and ' +
        ':fim then'
      
        '                                                      case when ' +
        ':fim = e.datacadastro then 1'
      
        '                                                      else :fim ' +
        '- e.datacadastro end'
      '                   else :periodo end as periodo'
      ''
      '              from'
      '              ('
      '              select e.*,'
      '                    case when :NaoConsiderarPedidosCompra then 0'
      
        '                    else produtospedidos_recebido_semnotaparcial' +
        '(e.produto,e.filial) end as produtospedidos_recebido_semnotaparc' +
        'ial'
      ''
      '              FROM'
      '              ('#9
      '              select e.*,'
      
        '                     case when :NaoConsiderarPedidosCompra then ' +
        '0'
      
        '                     else pedidos_estoquepedido(e.produto,e.fili' +
        'al) end as pedidos_estoquepedido'
      ''
      '              from'
      '              ('
      '              select e.*,'
      
        '                     case when :conceitos='#39#39' then movimentos_ven' +
        'dido(:inicio,:fim, e.produto, e.filial)'
      
        '                      else movimentos_vendido_porconceito(:inici' +
        'o,:fim, e.produto, e.filial,:conceitos) end'
      '                      as vendido'
      ''
      '              from'
      ''
      '              ('#9
      ''
      '              select e.*,'
      ''
      '                   case when not :PedidosEntreFiliais then 0'
      '                   else'
      ''
      
        '                     coalesce((select sum(case when pf.situacao ' +
        '= '#39'A'#39' then pf.qtdepedida'
      
        '                                      when pf.situacao = '#39'F'#39' the' +
        'n 0 end)'
      '                      from pedidosfiliais pf'
      '                      where pf.produto = e.produto'
      '                       and pf.requisitante = e.filial'
      
        '                       and pf.situacao in ('#39'A'#39','#39'F'#39')),0) /*+ e.tr' +
        'ansito*/'
      ''
      '                   end  as pedidos_filiais'
      ''
      ''
      ''
      '              from'
      '              ('
      '              select e.produto,'
      '                     p.datacadastro,'
      '                     e.filial,'
      '                       e.datacompra,'
      '                       %quantidadeemestoque  as estoque,'
      '                       e.emestoque,'
      '                       e.futuro,'
      '                       e.transito,'
      '                       e.reservado,'
      '                       e.reservaprevia,'
      '                       e.ultimavenda,'
      '                       '
      '                       (select cp.valor '
      '                        from colunasprecos cp '
      
        '                        where cp.caracteristica = p.caracteristi' +
        'ca '
      '                          and cp.preco = p.preco'
      
        '                          and cp.coluna = f.preconormal) as prec' +
        'ovenda,'
      '                        '
      '                       coalesce(e.minimo,0) as minimo,'
      '                       coalesce(e.maximo,0) as maximo'
      ''
      ''
      '              from estoques e '
      '                   join filiais f'
      '                   on e.filial = f.codigo'
      '                   '
      '                   join produtos p '
      '                   on e.produto = p.codigo'
      ''
      '              where p.codigo in (%ListadeProdutos)'
      '                          %produtos'
      '                          %Filiais'
      '                          %estoques'
      ''
      '              ) as e'
      '              ) as e'
      '              ) as e'
      '              ) as e'
      '              ) as e'
      '              order by filial, produto'
      ''
      ''
      '       ) AS s'
      '           JOIN filiais'
      '           join (filiaisgruposfiliais fgf'
      '                 join gruposfiliais g'
      '                   on fgf.grupo = g.codigo)'
      '           on filiais.codigo = fgf.filial'
      '           on s.filial=filiais.codigo'
      
        '      order BY s.produto,fgf.grupo, s.filial, filiais.mnemonico,' +
        ' filiais.tipofilial, s.reservado, s.reservaprevia, s.futuro, s.m' +
        'inimo, s.maximo, s.saldo, s.periodo, s.ultimavenda, s.datacompra'
      '   ) AS selecionados'
      ''
      ''
      ''
      
        '/*where  (total_estoque<>0) or (total_pedido<>0) or (total_vendi' +
        'do<>0)*/'
      ''
      '  ORDER BY mnemonico'
      ''
      ' ) AS selecionados'
      ''
      '     left join (produtospedidos pped'
      '                join pedidos ped'
      '                on pped.pedido = ped.numero)'
      '     on selecionados.pedidocompra = pped.pedido'
      '     and selecionados.produto = pped.produto'
      ''
      '       ')
    RequestLive = True
    Left = 886
    Top = 218
    ParamData = <
      item
        DataType = ftString
        Name = 'diasproporcional'
        ParamType = ptUnknown
        Value = '0'
      end
      item
        DataType = ftString
        Name = 'diasestoque'
        ParamType = ptUnknown
        Value = '0'
      end
      item
        DataType = ftString
        Name = 'EstoqueTotal'
        ParamType = ptUnknown
        Value = '0'
      end
      item
        DataType = ftUnknown
        Name = 'inicio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'fim'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'periodo'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'NaoConsiderarPedidosCompra'
        ParamType = ptUnknown
        Value = 'False'
      end
      item
        DataType = ftUnknown
        Name = 'conceitos'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'PedidosEntreFiliais'
        ParamType = ptUnknown
        Value = 'True'
      end>
