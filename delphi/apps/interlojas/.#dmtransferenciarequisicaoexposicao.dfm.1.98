  object qryLotesPedidosFiliais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Periodo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Requisitante'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Situacao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CurvaABC'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'QtdeConfirmada'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'select * from'
      '('
      ''
      
        '  select cast(lotetransferencia as varchar(6)) as lotetransferen' +
        'cia,'
      '  false as selecionar'
      '  from'
      ''
      '    ('
      
        '    Select distinct lpad(cast(pf.lotetransferencia as varchar), ' +
        '6, '#39' '#39') as lotetransferencia'
      
        '    From   pedidosfiliais pf left join notas n on (pf.dadofiscal' +
        ' = n.dadofiscal), produtos p, caracteristicas c'
      
        '    Where (pf.produto = p.codigo) and (p.caracteristica = c.codi' +
        'go)'
      '        and (pf.requisitada = :requisitada)'
      ''
      '    %Periodo'
      '    %Requisitante'
      '    %Situacao'
      '    %CurvaABC'
      '    %QtdeConfirmada'
      ''
      '    Order By lpad(cast(pf.lotetransferencia as varchar), 6, '#39' '#39')'
      ''
      '    ) as temp'
      ''
      '    where lotetransferencia is not null'
      ''
      ') as temp'
      '')
    RequestLive = True
    Left = 706
    Top = 25
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'requisitada'
        ParamType = ptUnknown
      end>
    object qryLotesPedidosFiliaislotetransferencia: TStringField
      FieldName = 'lotetransferencia'
      Size = 6
    end
    object qryLotesPedidosFiliaisselecionar: TBooleanField
      FieldName = 'selecionar'
    end
  end
