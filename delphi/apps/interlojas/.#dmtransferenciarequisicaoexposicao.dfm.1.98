  object qryDadosNotasPag: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select dadosnotaspag.*,'
      '       0.00 as QtdeDevolvida'
      'from'
      '('
      '  select pnp.codigonota, pnp.numero, np.data,'
      '         pnp.quantidade - coalesce((select sum(pdf.quantidade)'
      
        '                           from produtosdadosfiscais pdf join da' +
        'dosfiscais df on pdf.dadofiscal = df.numero'
      '                           where pdf.codigonota = pnp.codigonota'
      '                             and pdf.produto = pnp.produto'
      
        '                             and pdf.numeroprodutotabela = pnp.n' +
        'umero'
      
        '                             and df.situacao = '#39'N'#39'),0) as quanti' +
        'dade'
      ''
      '  from produtosnotaspag pnp'
      '       join notaspag np'
      '       on pnp.codigonota = np.codigo'
      ''
      '  where np.fornecedor = :filialdevolucao'
      '    and np.tipofornecedor = '#39'L'#39
      '    and np.situacao = '#39'N'#39
      '    and ehnotafiscalentradacompra(pnp.codigofiscal)'
      '    and pnp.produto = :produto'
      ''
      ') as dadosnotaspag'
      'where quantidade > 0'
      'order by data desc, codigonota desc, numero desc')
    RequestLive = True
    Left = 600
    Top = 416
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'filialdevolucao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'produto'
        ParamType = ptUnknown
      end>
    object qryDadosNotasPagcodigonota: TIntegerField
      FieldName = 'codigonota'
    end
    object qryDadosNotasPagnumero: TIntegerField
      FieldName = 'numero'
    end
    object qryDadosNotasPagdata: TDateField
      FieldName = 'data'
    end
    object qryDadosNotasPagquantidade: TFloatField
      FieldName = 'quantidade'
    end
    object qryDadosNotasPagqtdedevolvida: TFloatField
      FieldName = 'qtdedevolvida'
    end
  end
  object qryNotaEntradaRef: TtecQuery
