        ParamType = ptUnknown
        Value = False
      end
      item
        DataType = ftString
        Name = 'conceitos'
        ParamType = ptUnknown
      end
      item
        DataType = ftBoolean
        Name = 'PedidosEntreFiliais'
        ParamType = ptUnknown
        Value = True
      end>
