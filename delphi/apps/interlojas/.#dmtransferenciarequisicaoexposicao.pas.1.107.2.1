function TdtmTransferenciaRequisicaoExposicao.ImprimirNotaFiscal: Boolean;
var
  ChaveAcesso: String;
//  NFe: TTecNotaFiscalEletronica;
  LoteNFe, ReciboNFe, ProtocoloNFe, status, DataHoraProcessamento: String;
//  ValorPIS, ValorCOFINS: Currency;
  vListaNFeEmailValidos : String;


  function PreencherDadoFiscal: boolean;
  var
    Cont: Integer;
  begin
    try

      result := True;

      qryNotas.Edit;
      qryNotasdadofiscal.AsInteger := NovoNumeroDadoFiscal;
      qryNotas.Post;

//   Já foi dado o post em ComplementoDadosFiscais

//      if qryDadosFiscais.state <> dsinsert then
//        qryDadosFiscais.Insert;

      qryDadosFiscais.edit;

      qryDadosFiscais.FieldByName('numero').AsInteger       := qryNotasdadofiscal.AsInteger;
      qryDadosFiscais.FieldByName('data').AsDateTime        := DataServidor;
      qryDadosFiscais.FieldByName('situacao').AsString      := 'N';
      qryDadosFiscais.FieldByName('filialvenda').AsInteger  := FilialBase;
      qryDadosFiscais.FieldByName('estadocfo').AsString     := qryFilialDestinoestado.AsString;

      fnumContrato := '';
      case TipoNotaFiscalaEmitir of

        VendaTransferencia:
        begin
          qryDadosFiscais.FieldByName('contratofrentecaixa').AsString := numContrato;
          qryDadosFiscais.FieldByName('vendedor').asInteger := UsuarioLogin.CodigoUsuario;
          qryDadosFiscais.FieldByName('vendatransferencia').asBoolean := true;
        end;

        DevolucaoTransferencia:
          qryDadosFiscais.FieldByName('finalidadenf').AsInteger := 4;   // devolução

      end;

      qryDadosFiscais.FieldByName('codigonatureza').AsInteger := qryprodutos.fieldbyname('natureza').AsInteger;
      qryDadosFiscais.FieldByName('natureza').AsString       := qryprodutos.fieldbyname('descricaonatureza').AsString;
      qryDadosFiscais.FieldByName('codigofiscal').AsInteger  := qryprodutos.fieldbyname('codigofiscal').AsInteger;

      qryDadosFiscais.FieldByName('pessoatipo').AsString    := 'J';
      qryDadosFiscais.FieldByName('pessoanumero').AsString  := qryFilialDestinocnpj.AsString;
      qryDadosFiscais.FieldByName('nome').AsString          := qryFilialDestinorazao.AsString;
      qryDadosFiscais.fieldbyname('clientecontribicms').AsBoolean := qryFilialDestinocontribicms.AsBoolean;

      if qryFilialDestinoestado.AsString='.' then {estrangeiro}
      begin
        qryDadosFiscais.FieldByName('pais').AsString    := qryFilialDestinocodigoibge.AsString;
        qryDadosFiscais.FieldByName('nomepais').AsString                 := qryFilialDestinonomecidade.AsString;
        qryDadosFiscais.FieldByName('rua').AsString                      := qryFilialDestinorua.AsString;
        qryDadosFiscais.FieldByName('endnumero').AsString                := qryFilialDestinonumero.AsString;
        qryDadosFiscais.FieldByName('endcomplemento').AsString           := qryFilialDestinocomplemento.AsString;
        qryDadosFiscais.FieldByName('bairro').AsInteger                   := qryFilialDestinobairro.AsInteger;
        //qryDadosFiscaisnomebairro.AsString               := qryFilialDestinonomebairro.AsString;
        qryDadosFiscais.FieldByName('cidade').AsInteger                   := qryFilialDestinocidade.AsInteger;
        qryDadosFiscais.FieldByName('nomecidade').AsString               := qryFilialDestinonomebairro.AsString;
        //qryDadosFiscaiscidadeibge.AsString             := qryFilialDestinocodigoibge.AsString;
        qryDadosFiscais.FieldByName('estado').AsString                   := qryFilialDestinoestado.AsString;
        //qryDadosFiscaiscep.AsInteger                     := ConsultaOSP.qryProcuraClientecep.AsInteger;
      end
      else
      begin
        qryDadosFiscais.FieldByName('pais').AsInteger                    := 1058;
        qryDadosFiscais.FieldByName('nomepais').AsString                 := 'Brasil';
        qryDadosFiscais.FieldByName('rua').AsString                      := qryFilialDestinorua.AsString;
        qryDadosFiscais.FieldByName('endnumero').AsString                := qryFilialDestinonumero.AsString;
        qryDadosFiscais.FieldByName('endcomplemento').AsString           := qryFilialDestinocomplemento.AsString;
        qryDadosFiscais.FieldByName('bairro').Asinteger                  := qryFilialDestinobairro.AsInteger;
        qryDadosFiscais.FieldByName('nomebairro').AsString               := qryFilialDestinonomebairro.AsString;
        qryDadosFiscais.FieldByName('cidade').AsInteger                   := qryFilialDestinocidade.AsInteger;
        qryDadosFiscais.FieldByName('nomecidade').AsString               := qryFilialDestinonomecidade.AsString;
        qryDadosFiscais.FieldByName('cidadeibge').Asstring    := qryFilialDestinocodigoibge.AsString;
        qryDadosFiscais.FieldByName('estado').AsString                   := qryFilialDestinoestado.AsString;
        qryDadosFiscais.FieldByName('cep').AsInteger                      := qryFilialDestinocep.AsInteger;
      end;

      qryDadosFiscais.FieldByName('foneddd').AsInteger      := qryFilialDestinofoneddd.AsInteger;
      qryDadosFiscais.FieldByName('fonenumero').AsInteger   := qryFilialDestinofonenumero.AsInteger;
      qryDadosFiscais.FieldByName('documento').AsString     := qryFilialDestinoinscricaoestadual.AsString;

      qryDadosFiscais.FieldByName('filialemissao').AsInteger:= FilialBase;
      qryDadosFiscais.FieldByName('datasaida').AsDateTime   := DataServidor;
      qryDadosFiscais.FieldByName('Desconto').AsCurrency    := 0;
      qryDadosFiscais.FieldByName('seguro').AsCurrency      := 0;
      qryDadosFiscais.FieldByName('cliente').AsInteger      := qryFilialDestinocodigo.AsInteger;
      qryDadosFiscais.FieldByName('tipocliente').AsString   := 'L';

      qryDadosFiscais.FieldByName('viatransporte').AsString := 'R';
      qryDadosFiscais.FieldByName('frete').AsString         := '1';
      qryDadosFiscais.Post;

      Cont := 0;
      GuardarRegistroAtual(qryProdutos,True);
      try
        qryProdutos.First;
        while not qryProdutos.Eof do
        begin
          qryProdutos.Edit;
          qryProdutos.FieldByName('dadofiscal').AsInteger := qryDadosFiscais.FieldByName('numero').AsInteger;
          qryProdutos.FieldByName('numero').AsInteger     := Cont + 1;
          qryProdutos.Post;

  //        ValorPIS := ValorPIS + qryProdutos.FieldByName('pisvalor').AsCurrency;
  //        ValorCOFINS := ValorCOFINS + qryProdutos.FieldByname('cofinsvalor').AsCurrency;

          qryProdutos.Next;
          Inc(Cont);
        end;
      finally
        VoltarRegistroAtual(qryProdutos);
      end;

      AtribuirChave(qryVolumesDadosFiscais, [qryVolumesDadosFiscaisdadofiscal], [qryDadosFiscais.Fieldbyname('numero')]);

    except on E: Exception do
      begin

        result := false;
        CancelarAtualizacoes([]);
        raise Exception.Create('Erro na função ''PreencherDadoFiscal'': ' + E.Message);
        exit;

      end;
    end;

  end;

  function ImprimirNFE(Validando: Boolean = False) : boolean;
  begin
    qryDadosFiscais.Edit;
    qryDadosFiscais.FieldByName('nrdocumento').AsInteger  := qryNotasnumero.AsInteger;

    qryDadosFiscais.FieldByName('codaleatorio').Asinteger := Aleatorio(qryDadosFiscais.FieldByName('data').AsDateTime, qryDadosFiscais.FieldByName('nrdocumento').Asstring);

    ChaveAcesso :=
               copy(CodigoCidadeIBGEFilialBase,1,2)+                       // 2
               FormatDateTime('YYMM',qryDadosFiscais.FieldByName('data').AsDateTime)+      // 4
               preencheString(CNPJFilialBase,'0',14,false)+                // 14
               preencheString(qryDadosFiscais.FieldByName('modelodocto').AsString,'0',2,false)+ // 2
               preencheString(SerieSugestao,'0',3,false)+                  // 3
               preencheString(qryDadosFiscais.FieldByName('nrdocumento').Asstring,'0',9,false) + // 9
               qryDadosFiscais.fieldbyname('formaemissao').AsString +  //1
               preencheString(qryDadosFiscais.FieldByName('codaleatorio').Asstring,'0',8,false);  // 8

    qryDadosFiscais.FieldByName('digchaveacesso').AsString   := Modulo11(ChaveAcesso);
    qryDadosFiscais.FieldByName('chv_nfe').AsString := ChaveAcesso + qryDadosFiscais.FieldByName('digchaveacesso').AsString;
  //             modulo11(ChaveAcesso,'98765432',false);

    {1 - PRODUÇÃO 2 - HOMOLOGAÇÃO}
    qryDadosFiscais.FieldByName('ambiente').AsInteger         := NFeAmbiente;// '2';

    {1 - normal 2 - compelementar}
    {if qryDadosFiscais.FieldByName('dadofiscalcomplementar').AsInteger=0 then
       qryDadosFiscais.FieldByName('finalidadenf').AsInteger  := 1
    else
       qryDadosFiscais.FieldByName('finalidadenf').AsInteger  := 2;}

    qryDadosFiscais.FieldByName('procemissao').AsString      := '0';
    qryDadosFiscais.FieldByName('versaoteclux').AsString     := VersaoTecLUX;
    qryDadosFiscais.FieldByName('infcomplementar').AsString := qryDadosFiscais.FieldByName('observacoes').AsString;

    if (regimetributario = 1) and //simples
       (parsistema.obsnfeClientesnoSimples <> '') then
       qryDadosFiscais.FieldByName('infcomplementar').AsString := qryDadosFiscais.FieldByName('infcomplementar').AsString +
                                                  parsistema.obsnfeClientesnoSimples;

{    qryDadosFiscais.FieldByName('totalvalorpis').AsCurrency := ValorPIS;
    qryDadosFiscais.FieldByName('totalvalorcofins').AsCurrency := ValorCOFINS;
}

    qryDadosFiscais.Post;

    if not Validando then
      NFe := TTecNotaFiscalEletronica.Create
    else
      NFe := TTecNotaFiscalEletronica.Create(dtmTecSoft.Database);

      {
    NFe.DiretorioEnvio       := NFeDirEnvio;
    NFe.DiretorioEnviado     := NFeDirEnviados;
    NFe.DiretorioRetorno     := NFeDirRetorno;
    NFe.DiretorioCompartilha := NfeDirCompartilha;
    NFe.Executavel           := NFeExecNFe;
    }
    try
      if not validando then
      begin
        ShowProcessando('Gerando o arquivo da NF-e!');
        Sleep(500);
      end;

      // EMITENTE
      NFe.Emit_Documento := CNPJFilialBase;
      NFe.Emit_Nome      := RazaoFilialBase;
      NFe.Emit_Rua       := RuaSemNumeroFilialBase;
      NFe.Emit_Nro       := NumeroFilialBase;
      NFe.Emit_Compl     := ComplementoFilialBase;
      NFe.Emit_Bairro    := BairroFilialBase;
      NFe.Emit_CodMun    := CodigoCidadeIBGEFilialBase;
      NFe.Emit_Mun       := CidadeFilialBase;
      NFe.Emit_UF        := EstadoFilialBase;
      NFe.Emit_CEP       := CEPFilialBase;
      NFe.Emit_Fone      := DDDFilialBase+FoneFilialBase;
      NFe.Emit_IE        := InscricaoEstadualFilialBase;
      NFe.Emit_IM        := InscricaoMunicipalFilialBase;
      NFe.Emit_CNAE      := CNAEFiscalFilialBase;
      NFe.Emit_CRT       := qrydadosfiscais.fieldbyname('regimetributario').AsInteger;


      // DESTINATARIO
      NFe.Dest_TipoPessoa := qryDadosFiscais.fieldbyname('pessoatipo').AsString;
      NFe.Dest_Documento := qryDadosFiscais.fieldbyname('pessoanumero').AsString;
      NFe.Dest_Nome      := qryDadosFiscais.fieldbyname('nome').AsString;
      NFe.Dest_Rua       := qryDadosFiscais.fieldbyname('rua').AsString;
      NFe.Dest_Nro       := qryDadosFiscais.fieldbyname('endnumero').AsString;
      NFe.Dest_Compl     := qryDadosFiscais.fieldbyname('endcomplemento').AsString;
      NFe.Dest_Bairro    := qryDadosFiscais.fieldbyname('nomebairro').AsString;
      NFe.Dest_CodMun    := qryDadosFiscais.fieldbyname('cidadeibge').AsString;
      NFe.Dest_Mun       := qryDadosFiscais.fieldbyname('nomecidade').AsString;
      NFe.Dest_UF        := qryDadosFiscais.fieldbyname('estado').AsString;
      NFe.Dest_CEP       := qryDadosFiscais.fieldbyname('cep').AsString;
      NFe.Dest_CodPais   := qryDadosFiscais.fieldbyname('pais').AsInteger;
      NFe.Dest_Pais      := qryDadosFiscais.fieldbyname('nomepais').AsString;
