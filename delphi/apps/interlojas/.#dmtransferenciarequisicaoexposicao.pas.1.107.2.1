procedure TdtmTransferenciaRequisicaoExposicao.BloquearEstoqueCancelamentoRequisicao(produto, filial: String);
var
  Pos: TBookmark;
  WhereSQL: String;

  procedure IncluirProdutoNoEstoque;
  begin
    qryEstoques.Insert;
    qryEstoquesproduto.AsString      := produto;
    qryEstoquesfilial.AsString        := filial;
    qryEstoquesemestoque.AsCurrency     := 0;
    qryEstoquesreservado.AsCurrency     := 0;
    qryEstoquestransito.AsCurrency      := 0;
    qryEstoquesdemonstracao.AsCurrency  := 0;
    qryEstoquesconserto.AsCurrency      := 0;
    qryEstoquesfuturo.AsCurrency        := 0;
    qryEstoquesdanificada.AsCurrency    := 0;
    qryEstoquesestoquefisico.AsCurrency := 0;
    qryEstoques.Post;
  end;

begin
// Verifica a existencia do produto na filial requisitante.
  ReFazConsulta(qryExisteEstoque,[0,1],[produto, Filial]);
  if qryExisteEstoque.IsEmpty then
  begin
    IncluirProdutoNoEstoque;
    Perpetrar([qryEstoques]);
  end;


  WhereSQL :=
  '((e.produto = ' + produto + ') and' +
  '(e.filial = '   + filial  + '))';

  qryEstoqueBloqueio.MacroByName('ProdutoFilial').AsString := WhereSQL;
  if qryEstoqueBloqueio.Active then
    qryEstoqueBloqueio.Close;
  qryEstoqueBloqueio.Open;

end;

function TdtmTransferenciaRequisicaoExposicao.AtualizarQtdePedida: boolean;
var
  vListaNumeroPedidos: String;
begin

   Result := True;

   try

     vListaNumeroPedidos := '';

     qryPedidosFiliais.GuardarRegistroAtual(true);

     qryPedidosFiliais.first;
     while not qryPedidosFiliais.eof do
     begin

       while not qryPedidosFiliais.Eof do
       begin
         if (qryPedidosFiliaisqtderecebida.AsCurrency > 0) and
            (qryPedidosFiliaissituacao.AsString = 'A') and
            (qryPedidosFiliaismarcarlotetransferencia.asBoolean) then

           vListaNumeroPedidos := vListaNumeroPedidos + qryPedidosFiliaiscodigo.asString + ', ';

         qryPedidosFiliais.next;
       end;

     end;

   finally
     qryPedidosFiliais.VoltarRegistro;
   end;

   if vListaNumeroPedidos <> '' then
      delete(vListaNumeroPedidos,length(vListaNumeroPedidos)-1, 2);

  if vListaNumeroPedidos <> '' then
  begin

    qryPedidosFiliaisAtuais.macrobyname('ListaNumeroPedidos').asString := vListaNumeroPedidos;
    qryPedidosFiliaisAtuais.filtered := false;
    qryPedidosFiliaisAtuais.close;
    qryPedidosFiliaisAtuais.open;


    try
      FImprimindoNota := True;
      qryPedidosFiliais.GuardarRegistroAtual(true);

      qryPedidosFiliaisAtuais.first;
      while not qryPedidosFiliaisAtuais.eof do
      begin

        if qryPedidosFiliais.locate('codigo',
           qryPedidosFiliaisAtuais.fieldByName('codigo').asInteger, []) then
        begin
          if ExisteDiferenca(qryPedidosFiliaisAtuais, qryPedidosFiliais, false, true, true, true) then
          begin
                        {
            if qryPedidosFiliaisAtuaisqtdePedida.asinteger <>
              qryPedidosFiliaisqtdepedida.asinteger then
            begin
              qryPedidosFiliais.edit;
              qryPedidosFiliaisqtdepedida.asinteger := qryPedidosFiliaisAtuaisqtdePedida.asinteger;
              qryPedidosFiliais.post;
            end;

            if qryPedidosFiliaisAtuaisqtderecebida.asinteger <>
              qryPedidosFiliaisqtderecebida.asinteger then
            begin
              qryPedidosFiliais.edit;
              qryPedidosFiliaisqtderecebida.asinteger := qryPedidosFiliaisAtuaisqtderecebida.asinteger;
              qryPedidosFiliais.post;
            end;

            }
           qryPedidosFiliaisAtuais.edit;
           qryPedidosFiliaisAtuaisalterado.asBoolean := true;

           qryPedidosFiliaisAtuaisPedidaAtual.asinteger := qryPedidosFiliaisqtdepedida.asinteger;
           qryPedidosFiliaisAtuaisrecebidaatual.asinteger := qryPedidosFiliaisqtderecebida.asinteger; 

           qryPedidosFiliaisAtuais.post;

           Result := False;

          end;

        end;

        qryPedidosFiliaisAtuais.next;
      end;
    finally
      qryPedidosFiliais.VoltarRegistro;
//      qryPedidosFiliais.filtered := false;
//      qryPedidosFiliais.filtered := true;
      FImprimindoNota := False;
      qryPedidosFiliaisAtuais.filtered := true;

    end;

  end;

end;

procedure TdtmTransferenciaRequisicaoExposicao.qryPedidosFiliaisAtuaisFilterRecord(
  DataSet: TDataSet; var Accept: Boolean);
begin
  inherited;
  if qryPedidosFiliais.filtered then
    Accept := qryPedidosFiliaisAtuaisAlterado.asBoolean;
end;

procedure TdtmTransferenciaRequisicaoExposicao.AbrirDadosComprasFiliais;
var
   vperiodo: integer;
begin
    vperiodo := daysbetween(DataServidor,
                 DataServidor - TEditNumero(Self.Owner.findcomponent('edtNumero_dias_de_Vendas')).valorsemformatacao);

    if vperiodo = 0 then
      vperiodo := 1;


  if TPanel(self.owner.FindComponent('pnlBottom')).visible then
  begin

    if

      (qryComprasGruposFiliais.paramByName('diasproporcional').asInteger <> TEditNumero(Self.Owner.findcomponent('edtDiasProporcionalEstoque')).valorsemformatacao) or
      (qryComprasGruposFiliais.paramByName('diasestoque').asInteger <> TEditNumero(Self.Owner.findcomponent('edtDiasEstoque')).valorsemformatacao)                  or
      (qryComprasGruposFiliais.paramByName('inicio').asDate <> DataServidor - TEditNumero(Self.Owner.findcomponent('edtNumero_dias_de_Vendas')).valorsemformatacao) or
      (qryComprasGruposFiliais.paramByName('fim').asDate <> DataServidor)                                                                                           or
      (qryComprasGruposFiliais.paramByName('periodo').asInteger <> vPeriodo) or
      not qryComprasGruposFiliais.active

    then

    begin


      qryComprasGruposFiliais.paramByName('diasproporcional').asInteger := TEditNumero(Self.Owner.findcomponent('edtDiasProporcionalEstoque')).valorsemformatacao;
      qryComprasGruposFiliais.paramByName('diasestoque').asInteger := TEditNumero(Self.Owner.findcomponent('edtDiasEstoque')).valorsemformatacao;
      qryComprasGruposFiliais.paramByName('inicio').asDate := DataServidor - TEditNumero(Self.Owner.findcomponent('edtNumero_dias_de_Vendas')).valorsemformatacao;
      qryComprasGruposFiliais.paramByName('fim').asDate := DataServidor;
      qryComprasGruposFiliais.paramByName('periodo').asInteger := vPeriodo;

  //    qryComprasGruposFiliais.macrobyname('ListadeProdutos').asString := RetornarLista(qryPedidosFiliais, qryPedidosFiliaisproduto);

      qryComprasFiliaisGrupo.parambyname('diasproporcional').asInteger := qryComprasGruposFiliais.paramByName('diasproporcional').asInteger;
      qryComprasFiliaisGrupo.paramByName('diasestoque').asInteger := qryComprasGruposFiliais.paramByName('diasestoque').asInteger;
      qryComprasFiliaisGrupo.paramByName('inicio').asDate := qryComprasGruposFiliais.paramByName('inicio').asDate;
      qryComprasFiliaisGrupo.paramByName('fim').asDate := DataServidor;
      qryComprasFiliaisGrupo.paramByName('periodo').asInteger := vPeriodo;
      qryComprasFiliaisGrupo.paramByName('estoquetotal').asInteger := 0;
      qryComprasFiliaisGrupo.macrobyname('ListadeProdutos').asString := qryComprasGruposFiliais.macrobyname('ListadeProdutos').asString;

      qryComprasGruposFiliais.ParamByName('conceitos').AsString:='';
      qryComprasFiliaisGrupo.ParamByName('conceitos').AsString:='';


      qryComprasGruposFiliais.close;
      qryComprasGruposFiliais.open;

      qryComprasFiliaisGrupo.close;
      qryComprasFiliaisGrupo.open;
    end;

  end;

end;

function TdtmTransferenciaRequisicaoExposicao.GetProduto: String;
begin
  result := qryPedidosFiliaisproduto.asString;
end;


procedure TdtmTransferenciaRequisicaoExposicao.Reatualizar(
  vListaProdutos: String);
var
 vrecno: integer;
 vReadonly : Boolean;

begin
  try

    DesligarEventos;

    qryPedidosFiliais.GuardarRegistroAtual(false);
    qryComprasGruposFiliais.GuardarRegistroAtual(false);
    qryComprasFiliaisGrupo.GuardarRegistroAtual(false);

    self.dsrPedidosFiliais.onDataChange := nil;

    dtmTransferenciaRequisicaoExposicao_.qryPedidosFiliais.sql.text := self.qryPedidosFiliais.sql.text;
    dtmTransferenciaRequisicaoExposicao_.qryPedidosFiliais.macros := self.qryPedidosFiliais.macros;
    dtmTransferenciaRequisicaoExposicao_.qryPedidosFiliais.params := self.qryPedidosFiliais.params;

    dtmTransferenciaRequisicaoExposicao_.qryPedidosFiliais.macrobyname('Situacao').asstring := '';

    dtmTransferenciaRequisicaoExposicao_.qryComprasGruposFiliais.sql.text := self.qryComprasGruposFiliais.sql.text;
    dtmTransferenciaRequisicaoExposicao_.qryComprasGruposFiliais.macros := self.qryComprasGruposFiliais.macros;
    dtmTransferenciaRequisicaoExposicao_.qryComprasGruposFiliais.params := self.qryComprasGruposFiliais.params;

    dtmTransferenciaRequisicaoExposicao_.qryComprasFiliaisGrupo.sql.text := self.qryComprasFiliaisGrupo.sql.text;
    dtmTransferenciaRequisicaoExposicao_.qryComprasFiliaisGrupo.macros := self.qryComprasFiliaisGrupo.macros;
    dtmTransferenciaRequisicaoExposicao_.qryComprasFiliaisGrupo.params := self.qryComprasFiliaisGrupo.params;

    dtmTransferenciaRequisicaoExposicao_.qryPedidosFiliais.MacroByName('produtos').AsString :=
      dtmTransferenciaRequisicaoExposicao_.qryPedidosFiliais.MacroByName('produtos').AsString +
       ' and p.codigo in (' + qryPedidosFiliaisproduto.asString + ')';

    dtmTransferenciaRequisicaoExposicao_.qryComprasGruposFiliais.MacroByName('produtos').AsString :=
       dtmTransferenciaRequisicaoExposicao_.qryComprasGruposFiliais.MacroByName('produtos').AsString +
       ' and p.codigo in (' + qryPedidosFiliaisproduto.asString + ')';

    dtmTransferenciaRequisicaoExposicao_.qryComprasFiliaisGrupo.MacroByName('produtos').AsString :=
       dtmTransferenciaRequisicaoExposicao_.qryComprasFiliaisGrupo.MacroByName('produtos').AsString +
       ' and p.codigo in (' + qryPedidosFiliaisproduto.asString + ')';

    dtmTransferenciaRequisicaoExposicao_.qryPedidosFiliais.close;

    dtmTransferenciaRequisicaoExposicao_.qryComprasGruposFiliais.close;
    dtmTransferenciaRequisicaoExposicao_.qryComprasFiliaisGrupo.close;

    dtmTransferenciaRequisicaoExposicao_.desligareventos;
    dtmTransferenciaRequisicaoExposicao_.qryPedidosFiliais.open;

    dtmTransferenciaRequisicaoExposicao_.qryComprasGruposFiliais.open;
    dtmTransferenciaRequisicaoExposicao_.qryComprasFiliaisGrupo.open;

    dtmTransferenciaRequisicaoExposicao_.qryPedidosFiliais.first;

    while not dtmTransferenciaRequisicaoExposicao_.qryPedidosFiliais.eof do
    begin
      if self.qryPedidosFiliais.locate('codigo', dtmTransferenciaRequisicaoExposicao_.qryPedidosFiliaiscodigo.asstring, []) then
      begin
        vReadonly := self.qryPedidosFiliais.readonly;

        if vReadonly then
          self.qryPedidosFiliais.readonly := false;

        CopiaRegistrosporNome(dtmTransferenciaRequisicaoExposicao_.qryPedidosFiliais, self.qryPedidosFiliais, false, false, false, true, true, true);

        if vReadonly then
          self.qryPedidosFiliais.readonly := true;


        dtmTransferenciaRequisicaoExposicao_.qryComprasGruposFiliais.first;
        while not dtmTransferenciaRequisicaoExposicao_.qryComprasGruposFiliais.eof do
        begin

          if self.qryComprasGruposFiliais.locate('produto;grupo',
               VarArrayOf([
               dtmTransferenciaRequisicaoExposicao_.qryComprasGruposFiliaisproduto.asString,
               dtmTransferenciaRequisicaoExposicao_.qryComprasGruposFiliaisgrupo.asString]),[]) then
          begin
            vrecno := dtmTransferenciaRequisicaoExposicao_.qryComprasGruposFiliais.recno;
            CopiaRegistrosporNome(dtmTransferenciaRequisicaoExposicao_.qryComprasGruposFiliais, self.qryComprasGruposFiliais, false, false, false, true, true, true);
            dtmTransferenciaRequisicaoExposicao_.qryComprasGruposFiliais.recno := vrecno;

            dtmTransferenciaRequisicaoExposicao_.qryComprasFiliaisGrupo.first;
            while not dtmTransferenciaRequisicaoExposicao_.qryComprasFiliaisGrupo.eof do
            begin
              if self.qryComprasFiliaisGrupo.locate('produto;grupo;filial',
                   VarArrayOf([
                   dtmTransferenciaRequisicaoExposicao_.qryComprasFiliaisGrupoproduto.asString,
                   dtmTransferenciaRequisicaoExposicao_.qryComprasFiliaisGrupogrupo.asString,
                   dtmTransferenciaRequisicaoExposicao_.qryComprasFiliaisGrupofilial.asString]),[]) then
              begin
                vrecno := dtmTransferenciaRequisicaoExposicao_.qryComprasFiliaisGrupo.recno;
                CopiaRegistrosporNome(dtmTransferenciaRequisicaoExposicao_.qryComprasFiliaisGrupo, self.qryComprasFiliaisGrupo, false, false, false, true, true, true);
                dtmTransferenciaRequisicaoExposicao_.qryComprasFiliaisGrupo.recno := vrecno;
              end;


              dtmTransferenciaRequisicaoExposicao_.qryComprasFiliaisGrupo.next;
            end;
          end;
          dtmTransferenciaRequisicaoExposicao_.qryComprasGruposFiliais.next;
        end;
      end;
      dtmTransferenciaRequisicaoExposicao_.qryPedidosFiliais.next
    end;


  finally
    qryPedidosFiliais.VoltarRegistro;
    qryComprasGruposFiliais.VoltarRegistro;
    qryComprasFiliaisGrupo.VoltarRegistro;

    self.dsrPedidosFiliais.onDataChange := self.dsrPedidosFiliaisDataChange;

    ligarEventos;
  end;

end;

procedure TdtmTransferenciaRequisicaoExposicao.DesligarEventos;
begin
  qryPedidosFiliais.AfterScroll := nil;

  qryPedidosFiliais.AfterOpen := nil;
  qryPedidosFiliais.AfterPost := nil;
  qryPedidosFiliais.BeforeInsert := nil;
  qryPedidosFiliais.BeforePost := nil;
  qryPedidosFiliais.onFilterRecord := nil;

end;

procedure TdtmTransferenciaRequisicaoExposicao.LigarEventos;
begin
  qryPedidosFiliais.AfterScroll := qryPedidosFiliaisAfterScroll;

  qryPedidosFiliais.AfterOpen := qryPedidosFiliaisAfterOpen;
  qryPedidosFiliais.AfterPost := qryPedidosFiliaisAfterPost;
  qryPedidosFiliais.BeforeInsert := qryPedidosFiliaisBeforeInsert;
  qryPedidosFiliais.BeforePost := qryPedidosFiliaisBeforePost;
  qryPedidosFiliais.onFilterRecord := qryPedidosFiliaisFilterRecord;

end;

function TdtmTransferenciaRequisicaoExposicao.GetdtmTransferenciaRequisicaoExposicao_: TdtmTransferenciaRequisicaoExposicao;
begin


  try
    if not assigned(fdtmTransferenciaRequisicaoExposicao_) then
      fdtmTransferenciaRequisicaoExposicao_ := TdtmTransferenciaRequisicaoExposicao.Create(self);
  except
  end;

  Result := fdtmTransferenciaRequisicaoExposicao_;

end;

