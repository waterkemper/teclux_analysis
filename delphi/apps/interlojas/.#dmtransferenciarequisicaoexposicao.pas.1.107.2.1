      NFe.Entrega_Rua       := qryDadosFiscais.fieldbyname('localentrega_rua').AsString;
      nfe.Entrega_Nome      := qryDadosFiscais.fieldbyname('entnomedestinatario').AsString;
      NFe.Entrega_Nro       := qryDadosFiscais.fieldbyname('localentrega_numero').AsString;
      NFe.Entrega_Compl     := qryDadosFiscais.fieldbyname('localentrega_complemento').AsString;
      NFe.Entrega_Bairro    := qryDadosFiscais.fieldbyname('localentrega_nomebairro').AsString;
      NFe.Entrega_CodMun    := qryDadosFiscais.fieldbyname('localentrega_cidadeibge').AsString;
      NFe.Entrega_Mun       := qryDadosFiscais.fieldbyname('localentrega_nomecidade').AsString;
      NFe.Entrega_UF        := qryDadosFiscais.fieldbyname('localentrega_estado').AsString;
      NFe.Entrega_CEP       := qryDadosFiscais.fieldbyname('localentrega_cep').AsString;


      nfe.Validando := validando;

      result:=NFe.GerarNFe(qryDadosFiscais, TabelaReferenciada, qryProdutos,nil,nil,nil,
                   qryVolumesDadosFiscais, nil, nil,nil,SerieSugestao,'S');

