function TdtmTransferenciaRequisicaoExposicao.ReservaPreviaProduto(
  Situacao: String): Boolean;

  procedure NovoMovimentoReservaPrevia(Produto: int64; Filial: Integer);
  begin
    if qryMovimentosCancelamentoReabertura.State = dsInactive then
      qryMovimentosCancelamentoReabertura.Open;
    qryMovimentosCancelamentoReabertura.Append;
    spcMovimentosProximo.Open;
    qryMovimentosCancelamentoReaberturanumero.AsInteger := spcMovimentosProximonumero.AsInteger;
    spcMovimentosProximo.Close;
    qryMovimentosCancelamentoReaberturaproduto.AsLargeInt   := Produto;
    qryMovimentosCancelamentoReaberturafilial.AsInteger     := Filial;
    qryMovimentosCancelamentoReaberturareferencia.AsString:='REQUISICAO ' + qryPedidosFiliaiscodigo.AsString;
  end;

begin
  result := true;
  BloquearEstoqueCancelamentoRequisicao(qryPedidosFiliaisproduto.AsString, qryPedidosFiliaisfilial_estoque.AsString);

  if Situacao='C' then
  begin

    NovoMovimentoReservaPrevia(qryPedidosFiliaisproduto.AsLargeInt,qryPedidosFiliaisfilial_estoque.AsInteger);
    qryMovimentosCancelamentoReaberturatipomovimento.AsString:='TPE';
    qryMovimentosCancelamentoReaberturaquantidade.AsCurrency:=qryPedidosFiliaisqtdepedida.AsCurrency;
    qryMovimentosCancelamentoReabertura.Post;

     if qryEstoqueBloqueiofuturo.asCurrency<>0 then  //possui venda em futuro
     begin
       NovoMovimentoReservaPrevia(qryPedidosFiliaisproduto.AsLargeInt,qryPedidosFiliaisfilial_estoque.AsInteger);
       qryMovimentosCancelamentoReaberturatipomovimento.AsString := 'TFR';
       if qryEstoqueBloqueiofuturo.asCurrency > qryPedidosFiliaisqtdepedida.AsCurrency then
           // transfere para a reserva a quantidade do movimento
         qryMovimentosCancelamentoReaberturaquantidade.AsCurrency   := qryPedidosFiliaisqtdepedida.AsCurrency
       else
           // transfere para a reserva a quantidade do futuro
         qryMovimentosCancelamentoReaberturaquantidade.AsCurrency   := qryEstoqueBloqueiofuturo.asCurrency;
       qryMovimentosCancelamentoReabertura.Post;
     end;

  end
  else
  begin
    if (qryEstoqueBloqueioemestoque.AsCurrency < qryPedidosFiliaisqtdepedida.AsCurrency)
       {and ParSistema.RequisicaoSubtraiEstoque} then
    begin
      MensagemAviso('A quantidade solicitada é maior do que o estoque da filial requisitada.');
      result := False;
    end
    else
    begin
      NovoMovimentoReservaPrevia(qryPedidosFiliaisproduto.AsLargeInt,qryPedidosFiliaisfilial_estoque.AsInteger);
      qryMovimentosCancelamentoReaberturatipomovimento.AsString:='TEP';
      qryMovimentosCancelamentoReaberturaquantidade.AsCurrency:=qryPedidosFiliaisqtdepedida.AsCurrency;
      qryMovimentosCancelamentoReabertura.Post;
    end;
  end;

end;

