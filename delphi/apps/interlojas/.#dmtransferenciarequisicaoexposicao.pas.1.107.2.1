procedure TdtmTransferenciaRequisicaoExposicao.qryPedidosFiliaisAfterPost(DataSet: TDataSet);
var
  vRetorno : Boolean;
{
  produto: String;
  filial : Integer;}

begin
  try

  if not FImprimindoNota then
  begin
    qryPedidosFiliais.GuardarRegistroAtual(True);
    try
      vRetorno := Perpetrar([qryPedidosFiliais]);
    finally

      qryPedidosFiliais.VoltarRegistro;

      if not vRetorno then
      begin
        dtmTransferenciaRequisicaoExposicao.AtualizarQtdePedida;
        if assigned(ExibirGradeDiferencas) then
          ExibirGradeDiferencas(DAtaSet);
      end;

    end;
  end;
  finally
    qryPedidosFiliaisAfterOpen(qryPedidosFiliais);
  end;  
end;

