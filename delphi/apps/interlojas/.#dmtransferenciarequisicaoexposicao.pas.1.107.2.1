function TdtmTransferenciaRequisicaoExposicao.ExisteInconsistenciaLotes_Confirmada_X_Lida: Boolean;
var
 vLista: String;
begin
  result := false;
  if not parsistema.Permitir_Requisicoes_de_Produtos_Duplicadas then
  begin

    vlista := '';
    guardarregistroAtual(qryPedidosFiliais, true);
    qryPedidosFiliais.first;
    while not qryPedidosFiliais.eof do
    begin
      if not qryPedidosFiliaislotetransferencia.isnull and
         (qryPedidosFiliaisqtderecebida.AsCurrency > 0) and
         (qryPedidosFiliaissituacao.AsString = 'A')    then
        vLista := vLista + '('+qryPedidosFiliaislotetransferencia.asString + ','+qryPedidosFiliaisproduto.asString + '),';

      qryPedidosFiliais.next;
    end;
    VoltarRegistroAtual(qryPedidosFiliais);

    if vlista = '' then
      result := false
    else
    begin
      if not parsistema.Permitir_Requisicoes_de_Produtos_Duplicadas then
      begin

        delete(vlista,length(vlista), 1);
        qryPedidosInconsistentes.macrobyname('ListaLotesProdutos').asString := vlista;
        qryPedidosInconsistentes.macrobyname('CondicaoInconsistencia').asString := 'coalesce(selecao.qtderecebida,0) <> coalesce(selecao.lido,0)';

        qryPedidosInconsistenteslido.Visible := true;
        qryPedidosInconsistentesreservapreviarequisitada.Visible := false;

        qryPedidosInconsistentes.close;
        qryPedidosInconsistentes.open;
        if qryPedidosInconsistentes.recordcount = 0 then
          result := false
        else
        begin
          result := true;
          frmMensagemGrid := TfrmMensagemGrid.Create(frmMensagemGrid);
          frmMensagemGrid.Caption := 'Mensagem de inconsistência';
          frmMensagemGrid.lblTitulo.Caption := 'INCONSISTÊNCIA NOS PRODUTOS LIDOS!';
          frmMensagemGrid.lblTExto.Caption := 'Verifique no quadro abaixo os produtos que estão inconsistentes em relação a quantidade lida.';
          frmMensagemGrid.dbgMensagem.DataSource :=dsrPedidosInconsistentes;
          frmMensagemGrid.width := 750;
          frmMensagemGrid.ShowModal;
          frmMensagemGrid.Free;

        end;
      end;

    end;
  end;
end;

