procedure TdtmTransferenciaRequisicaoExposicao.SetFilialRequisitante(const Value: String);
begin
  if Value <> '' then
       qryPedidosFiliais.macrobyname('Requisitante').asstring := 'and (pf.requisitante = ' + Value + ')'
  else qryPedidosFiliais.macrobyname('Requisitante').asstring := '';
