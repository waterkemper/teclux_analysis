function TdtmTransferenciaRequisicaoExposicao.VerificarSaldoEstoqueouReserva: boolean;
var
  SituacaoProduto : TtecComposicao;
  QuantidadeCompara: Currency;
  vProduto : String;
  vFilial : Integer;

begin

  for SituacaoProduto := stNAOCOMPOSTO to stCOMPOSTO do
  begin
    qryProdutos.First;
    while not qryProdutos.Eof do
    begin
      vProduto := qryProdutos.FieldByName('produto').AsString;
      vFilial := qryProdutos.FieldByName('filial').AsInteger;

      if FiltrarComposto(qryProdutos.FieldByName('composto').AsBoolean, SituacaoProduto) then
      begin
        if qryEstoqueBloqueio.Locate('produto;filial', VarArrayOf([vProduto,
                                                                   qryProdutos.FieldByName('filial').AsInteger]) ,[]) then
        begin
          if (ParSistema.RequisicaoSubtraiEstoque) then
            QuantidadeCompara:=qryEstoqueBloqueioreservaprevia.AsCurrency
          else
            QuantidadeCompara:=qryEstoqueBloqueioemestoque.AsCurrency;

          if not (QuantidadeCompara >= qryProdutos.FieldByName('quantidade').AsCurrency) then
            qryProdutos.Delete
          else
            qryProdutos.next;
        end
        else
          qryProdutos.Next;
      end
      else
        qryProdutos.Next;
    end;
  end;

  result := (qryProdutos.recordcount <> 0);

  if not result then CancelarAtualizacoes([]);

end;

