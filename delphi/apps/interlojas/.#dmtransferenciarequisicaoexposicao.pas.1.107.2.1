function TdtmTransferenciaRequisicaoExposicao.AtualizarPedidosFiliais: Boolean;
var
  vListaPedidos : tStringlist;
  i: integer;

begin
  try
    result := true;

    qryAtualizarPedidosFiliais.Open;
    if qryAtualizarPedidosFiliais.RecordCount > 0 then
    begin
      vListapedidos := tStringList.Create;
      try

        qryProdutos.First;
        while not qryProdutos.Eof do
        begin
          vListaPedidos := Explode(',',qryProdutos.FieldByName('Listacodigopedidofilial').AsSTring);

          for i:=0 to vListaPedidos.Count-1 do
          begin
            if (qryAtualizarPedidosFiliais.Locate('codigo',vListaPedidos[i],[])) then
            begin
              qryAtualizarPedidosFiliais.Edit;
              qryAtualizarPedidosFiliaissituacao.AsString   := 'F';
              qryAtualizarPedidosFiliaisdadofiscal.AsInteger:= qryNotasdadofiscal.AsInteger;
              qryAtualizarPedidosFiliais.Post;
            end;
          end;

          qryProdutos.Next;
        end;
      finally
        vListapedidos.free;
      end;
    end;

  except on E: Exception do
    begin

      result := false;
      CancelarAtualizacoes([]);
      raise Exception.Create('Erro na função ''AtualizarPedidosFiliais'': ' + E.Message);
      exit;

    end;
  end;

end;

procedure TdtmTransferenciaRequisicaoExposicao.BloquearEstoque;
var
  WhereSQL: String;

  procedure IncluirProdutoNoEstoque;
  begin
    qryEstoques.Insert;
    qryEstoquesproduto.AsString      := qryProdutos.FieldByName('produto').AsString;
    qryEstoquesfilial.AsInteger        := FFilialEstoqueRequisitante;
    qryEstoquesemestoque.AsCurrency     := 0;
    qryEstoquesreservado.AsCurrency     := 0;
    qryEstoquestransito.AsCurrency      := 0;
    qryEstoquesdemonstracao.AsCurrency  := 0;
    qryEstoquesconserto.AsCurrency      := 0;
    qryEstoquesfuturo.AsCurrency        := 0;
    qryEstoquesdanificada.AsCurrency    := 0;
    qryEstoquesestoquefisico.AsCurrency := 0;
    qryEstoques.Post;
  end;

begin
  // Verifica a existencia do produto na filial requisitante.
  qryProdutos.First;
  while not qryProdutos.Eof do begin
    ReFazConsulta(qryExisteEstoque,[0,1],[qryProdutos.FieldByName('produto').AsString, FFilialEstoqueRequisitante]);
    if qryExisteEstoque.IsEmpty then
      IncluirProdutoNoEstoque;
    qryProdutos.Next;
  end;
  Perpetrar([qryEstoques]);

  qryProdutos.GuardarRegistroAtual(true);
  try
    if qryProdutos.RecordCount = 0 then
      WhereSQL := 'false'
    else begin
      WhereSQL := '';
      qryProdutos.First;
      while Not qryProdutos.Eof do begin
        WhereSQL := WhereSQL +
        '((e.produto = ' + qryProdutos.FieldByName('produto').AsString + ')and' +
        '(e.filial = '   + qryProdutos.FieldByName('filial').AsString  + '))or';
        qryProdutos.Next
      end;
      Delete(WhereSQL, Length(WhereSQL) - 1, 2);
    end
  finally
    qryProdutos.VoltarRegistro
  end;
  qryEstoqueBloqueio.MacroByName('ProdutoFilial').AsString := WhereSQL;
  if qryEstoqueBloqueio.Active then
    qryEstoqueBloqueio.Close;
  qryEstoqueBloqueio.Open;
end;

function TdtmTransferenciaRequisicaoExposicao.CancelarRequisicao: Boolean;
var
  Op: String;
  SitAux: String;
  vObservacaoAux : String;
  vPedidosReadOnly : Boolean;
begin

  //SE CANCELAMENTO - RETORNAR QUANTIDADES PARA O ESTOQUE  - CASO REABERTURA COLOCAR NA RESERVA PREVIA
  if Cancelado then Op:= ' a Re-abertura'
  else              Op:= ' o cancelamento';
  Result:= False;

  if MensagemSimNaoopcaocancelamotivo(self, 'Confirma' + Op + ' da REQUISIÇÃO DO PRODUTO?', '', false, '&Sim', '&Não', '', True,
  parsistema.InformarMotivoCancelamentoPedido, 'P') = mrYes then
  begin
     if qryPedidosFiliaissituacao.AsString = 'C' then
        SitAux := 'A'
     else SitAux := 'C';

     vObservacaoAux := TRIM(qryPedidosFiliaisobservacao.asString + ' ''Motivo d' + trim(Op) + ':''' + vTextoJanelaMensagem);

     if ParSistema.RequisicaoSubtraiEstoque then
       result := ReservaPreviaProduto(SitAux);

     if result then
     begin
       vPedidosReadOnly := qryPedidosFiliais.readonly;
       if qryPedidosFiliais.readonly then
         qryPedidosFiliais.readonly := false;

       try
         qryPedidosFiliais.GuardarRegistroAtual(true);
         qryPedidosFiliais.AfterPost := nil;

         qryPedidosFiliais.edit;
         qryPedidosFiliaisobservacao.asString := vObservacaoAux;
         qryPedidosFiliaisMotivo.asString := vMotivoJanelaMensagem;
         qryPedidosFiliaissituacao.asstring := SitAux;

         if SitAux = 'C' then
           qryPedidosFiliaisqtderecebida.clear;

         if qryPedidosFiliais.state = dsedit then
           qryPedidosFiliais.post;

         result := Perpetrar([qryEstoques, qryMovimentosCancelamentoReabertura, qryPedidosFiliais]);

       finally

          qryPedidosFiliais.readonly := vPedidosReadOnly;
          qryPedidosFiliais.VoltarRegistro;
          qryPedidosFiliais.AfterPost := qryPedidosFiliaisAfterPost;
          qryPedidosFiliaisAfterOpen(qryPedidosFiliais);

       end;

     end;
  end;

end;

function TdtmTransferenciaRequisicaoExposicao.ComplementoDadosFiscais: Boolean;
begin
  Result:= True;
  if FPrimeiraVez then
  begin
    if qryDadosFiscais.state <> dsinsert then
      qryDadosFiscais.insert;

    frmDadosTransportador:= TfrmDadosTransportador.Create(frmDadosTransportador);
    try
//      frmDadosTransportador.DataModulo:= Self;
      Result:= frmDadosTransportador.ShowModal = mrOk;
    finally
      frmDadosTransportador.Free;
    end;
  end;

  if Result then
  begin
    if qryDadosFiscais.state <> dsinsert then
      qryDadosFiscais.insert;

    with TranspNotaFiscal do
    begin
      if FornecedorTransporte > 0 then
        qryDadosFiscais.fieldbyname('FornecedorTransporte').AsInteger := FornecedorTransporte;
      if TipoFrete <> '' then
        qryDadosFiscais.fieldbyname('frete').AsString             := TipoFrete;
      if TipoTransp <> '' then
        qryDadosFiscais.fieldbyname('viatransporte').AsString     := TipoTransp;
      if EstadoPlaca <> '' then
        qryDadosFiscais.fieldbyname('estadoplaca').AsString       := EstadoPlaca;
      if Placa <> '' then
        qryDadosFiscais.fieldbyname('placa').AsString             := Placa;
      if Observacao <> '' then
        qryDadosFiscais.fieldbyname('observacoes').AsString       := {qryDadosFiscais.fieldbyname('observacoes').AsString +} Observacao;

      if not FPrimeiraVez then
        qryVolumesDadosFiscais.Append
      else
        qryVolumesDadosFiscais.edit;

      qryVolumesDadosFiscaisdadofiscal.AsInteger  := qryDadosFiscais.fieldbyname('numero').AsInteger;
      qryVolumesDadosFiscaiscodigo.AsInteger      := 1;
      if Volumes > 0 then
        qryVolumesDadosFiscaisvolumes.AsInteger   := Volumes;
      if PesoBruto > 0 then
        qryVolumesDadosFiscaispesobruto.AsFloat   := PesoBruto;
      if PesoLiquido > 0 then
        qryVolumesDadosFiscaispesoliquido.AsFloat := PesoLiquido;
      if Numeracao <> '' then
        qryVolumesDadosFiscaisnumeracao.AsString  := Numeracao;
      if Marca <> '' then
        qryVolumesDadosFiscaismarca.AsString      := Marca;
      if EspecieTransporte <> '' then
        qryVolumesDadosFiscaisespecietransporte.AsString := EspecieTransporte;
    end;
    qryDadosFiscais.Post;
    qryVolumesDadosFiscais.Post;
  end;
end;

function TdtmTransferenciaRequisicaoExposicao.ConfirmaRequisicao: Boolean;
var
  WhereSQL: String;
begin
  result := true;

  if not ExisteInconsistenciaLotes_qtderecebida_X_reservapreviarequisitada then
    if not ExisteInconsistenciaLotes_Confirmada_X_Lida then
    begin
      if MensagemConfirmacao(ctCONFIRMATRANSFERENCIA) = smbOk then
      begin

        vListaDadosFiscaisGravados := '';

        TipoNotaFiscalaEmitir := NaoEmitir;

        ReFazConsulta(qryNaturezasPadrao_,[],[]);
        FImprimindoNota:= True;
        FPrimeiraVez   := True;
        WhereSQL:= '';
        ListadeLotes := '';
        qryPedidosFiliais.GuardarRegistroAtual(true);

        try
          InicializarTabelas;
          qryPedidosFiliais.First;

          while not qryPedidosFiliais.Eof do
          begin

            if (qryPedidosFiliaisqtderecebida.AsCurrency > 0) and
               (qryPedidosFiliaissituacao.AsString = 'A') and
               (qryPedidosFiliaismarcarlotetransferencia.asBoolean) then
            begin
              if (Frequisitante > 0) and (Frequisitante <> qryPedidosFiliaisrequisitante.AsInteger) then
              begin
                Delete(WhereSQL,Length(WhereSQL),1);
                delete(ListadeLotes, Length(ListadeLotes)-1,2);

                qryAtualizarPedidosFiliais.Sql[08]:= '(pf.codigo in (' + WhereSql + '))';
                ImprimirNotaFiscal;
                InicializarTabelas;
                FPrimeiraVez:= False;
                WhereSQL:= '';
                ListadeLotes := '';
              end;

              Frequisitante := qryPedidosFiliaisRequisitante.AsInteger;
              FFilialEstoqueRequisitante := qryPedidosFiliaisfilial_estoque_requisitante.AsInteger;
              result := IncluirProdutos;

              if not result then
                break;

              WhereSQL:= WhereSQL + qryPedidosFiliaiscodigo.AsString + ',';

              if pos(qryPedidosFiliaislotetransferencia.AsString+', ', ListadeLotes)=0 then
                ListadeLotes := ListadeLotes + qryPedidosFiliaislotetransferencia.AsString + ', ';

            end;
            qryPedidosFiliais.Next;

          end;

          if result then
            if (qryProdutos.RecordCount > 0) then begin
              Delete(WhereSQL,Length(WhereSQL),1);
              delete(ListadeLotes, Length(ListadeLotes)-1,2);
              qryAtualizarPedidosFiliais.Sql[08]:= '(pf.codigo in (' + WhereSql + '))';
              ImprimirNotaFiscal;
            end;

        finally
          qryPedidosFiliais.VoltarRegistro;
          FImprimindoNota:= False;
          GerarConsultaRequisicao;
          qryPedidosFiliais.Filtered := false;
          qryPedidosFiliais.Filtered := true;

          if vListaDadosFiscaisGravados<>'' then
          begin
            delete(vListaDadosFiscaisGravados, length(vListaDadosFiscaisGravados)-1,2);
            TfrmPrincipalBasico(Application.MainForm).MostrarFormRegistrado([vListaDadosFiscaisGravados,'Imprimir Volumes NF Saída'], 'TfrmEmissaoEtiquetas', True);
          end;

        end;

      end;
    end
    else
      result := false;
end;

