        if NFeTipoEmissao in [1,3] then
        begin
          ShowProcessando;
          ShowProcessando('Verificando status do serviço NF-e!');
          Sleep(500);
          if NFe.VerificarStatusServico(IntToStr(NFeAmbiente)) then
          begin
            ShowProcessando;
            ShowProcessando('Processando o arquivo de envio da NF-e!');
            Sleep(500);
            Result := NFe.EnviarNFe(ChaveAcesso+qryDadosFiscais.fieldbyname('digchaveacesso').AsString, LoteNFe, ReciboNFe);
            if Result then
            begin
              qryDadosFiscais.Edit;
              qryDadosFiscais.fieldbyname('numlotenfe').AsString   := LoteNFe;
              qryDadosFiscais.fieldbyname('numrecibonfe').AsString := ReciboNFe;
              qryDadosFiscais.Post;
              Result := Perpetrar([qryDadosFiscais]);
              if Result then
              begin
                ShowProcessando;
                ShowProcessando('Consultando o arquivo de retorno da NF-e!');
                Sleep(5000);
                Result := NFe.ConsultarSituacaoLote(ReciboNFe, ProtocoloNFe, status, DataHoraProcessamento, IntToStr(NFeAmbiente));
              end;
              if Result then
              begin
                qryDadosFiscais.Edit;
                qryDadosFiscais.fieldbyname('numprotocolonfe').AsString := ProtocoloNFe;
                qryDadosFiscais.fieldbyname('statusnfe').AsString := status;
                qryDadosFiscais.fieldbyname('dhprocnfe').AsDateTime := FormatarTimeStamp(DataHoraProcessamento);

                if (qryDadosFiscais.fieldbyname('statusnfe').AsString = '301') or
                   (qryDadosFiscais.fieldbyname('statusnfe').AsString = '302') then
                begin
                  qryDadosFiscais.Edit;
                  qryDadosFiscais.fieldbyname('situacao').AsString := 'D';
                  qryDadosFiscais.Post;
                  //LimparTabela(qrymovimentos);
                  //Result := Perpetrar([qryMovimentos, qryDadosFiscais]);
                  Result := Perpetrar([qryDadosFiscais]);
                  MensagemAviso('Nota fiscal em uso denegado.');
                end
                else
                begin

                  Result := Perpetrar([qryDadosFiscais]);

                  if Result then
                  begin
                    ShowProcessando;
                    ShowProcessando('Gerando o arquivo de compartilhamento da NF-e!');
                    Sleep(500);
                    Result := NFe.CompartilharXML(ChaveAcesso+qryDadosFiscais.fieldbyname('digchaveacesso').AsString,
                                                  ReciboNFe, qryDadosFiscais.fieldbyname('filialemissao').AsString,
                                                  SerieSugestao, qryDadosFiscais.fieldbyname('nrdocumento').AsString,
                                                  qryDadosFiscais.fieldbyname('data').AsDateTime);
                    if Result then
                    begin
                      SalvarConteudoxml('S', qryDadosFiscais.fieldbyname('numero').asString);
                      {if not NFeVisualizarDANFE then
                        MensagemAviso('Impressão da Nota Fiscal será iniciada.')
                      else
                      begin
                      } ShowProcessando;
                        ShowProcessando('Imprimindo o DANFE!');
                      //end;
                      NFe.ImprimirDanfe({ChaveAcesso+qryDadosFiscaisdigchaveacesso.AsString,}
                                        qryDadosFiscais.fieldbyname('filialemissao').AsString,
                                        SerieSugestao,
                                        qryDadosFiscais.fieldbyname('nrdocumento').AsString,
                                        qryDadosFiscais.fieldbyname('localentrega_cep').AsString,
                                        qryDadosFiscais.fieldbyname('email').AsString,
                                        IntToStr(NFeNVias), NFeLogotipoDANFE,
                                        ParSistema.NomeImpressoraNotaMercadorias, NFeVisualizarDANFE,
                                        qryDadosFiscais.fieldbyname('data').AsDateTime,
                                        qryProdutos, NFeExecDANFE, Enviar, 'S');
                      ShowProcessando;


                      vListaNFeEmailValidos := '';
                      ListaStringEmailValido(ListadeEmails('DF', qryDadosFiscais.fieldbyname('numero').AsInteger), vListaNFeEmailValidos, true);


                      if (vListaNFeEmailValidos <> '')      and
                         (UsuarioLogin.PortaSmtp        <> '')      and
                         (UsuarioLogin.HostSmtp         <> '')      and
                         (UsuarioLogin.Email            <> '')      and
                         (UsuarioLogin.SenhaEmail       <> '') then
                      begin
                        ShowProcessando('Enviando email para o cliente');
                        try
                                                          if not NFe.EnviarEmail(UsuarioLogin.Email, vListaNFeEmailValidos,
                                                                              qryDadosFiscais.fieldbyname('nrdocumento').AsString, SerieSugestao, IntToStr(FilialBase),
                                                                              NomeFilialBase, RazaoFilialBase, CNPJFilialBase, DDDFilialBase, FoneFilialBase,
                                                                              DDDFaxFilialBase, FaxFilialBase, UsuarioLogin.NomeUsuario, UsuarioLogin.PortaSMTP,
                                                                              UsuarioLogin.HostSMTP, UsuarioLogin.UsuarioEmail, UsuarioLogin.SenhaEmail,
                                                                              qryDadosFiscais.fieldbyname('data').AsDateTime, qryDadosFiscais.fieldbyname('valortotal').AsCurrency,
                                                                              UsuarioLogin.AutenticarSMTP, qryDadosFiscais.fieldbyname('data').AsDateTime) then
                                                                MensagemAviso('Ocorreu um erro inesperado no envio do email')
                                                        finally
                                                              ShowProcessando;
                                                        end;
                      end;
                    end
                    else
                      ShowProcessando;
                  end;

                end;
              end
              else
                ShowProcessando;
            end
            else
              ShowProcessando;
          end
          else
            ShowProcessando;
        end
        else
        begin
          if not NFeVisualizarDANFE then
            MensagemAviso('Impressão da Nota Fiscal será iniciada.');
          NFe.ImprimirDanfe({ChaveAcesso+qryDadosFiscaisdigchaveacesso.AsString,}
                            qryDadosFiscais.fieldbyname('filialemissao').AsString,
                            SerieSugestao,
                            qryDadosFiscais.fieldbyname('nrdocumento').AsString,
                            qryDadosFiscais.fieldbyname('localentrega_cep').AsString,
                            qryDadosFiscais.fieldbyname('email').AsString,
