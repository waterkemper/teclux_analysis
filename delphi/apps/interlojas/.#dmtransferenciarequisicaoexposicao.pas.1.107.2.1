procedure TdtmTransferenciaRequisicaoExposicao.dsrPedidosFiliaisDataChange(Sender: TObject; Field: TField);
var
  DisponivelParaTransferir : Currency;
begin
  inherited;

  dsrPedidosFiliais.OnDataChange:= nil;

  if Field = qryPedidosFiliaisqtderecebida then
  begin

    if qryPedidosFiliaisqtderecebida.AsCurrency = 0 then
    begin
      if (qryPedidosFiliaislotetransferencia.asinteger <> 0) then
      begin
        qryPedidosFiliaismarcarlotetransferencia.asboolean := false;
        dsrPedidosFiliaisDataChange(self, qryPedidosFiliaismarcarlotetransferencia);
      end;
    end;

    if (qryPedidosFiliaiscodigo.AsInteger > 0) then
    begin
      if ParSistema.RequisicaoSubtraiEstoque then
        DisponivelParaTransferir:=qryPedidosFiliaisreservapreviarequisitada.Ascurrency
      else
        DisponivelParaTransferir:=qryPedidosFiliaisestoquerequisitada.AsCurrency;

      if (qryPedidosFiliaisqtderecebida.AsCurrency > DisponivelParaTransferir) then
      begin
        MensagemAviso(ctQUANTIDADEINDISPONILVEL);
//        qryPedidosFiliais.FieldByName('qtderecebida').FocusControl;
        if qryPedidosFiliais.State = dsEdit then
        begin
//          qryPedidosFiliaisqtderecebida.Clear;
          if qryPedidosFiliaisqtderecebidaanterior.AsCurrency <> 0 then
            qryPedidosFiliaisqtderecebida.AsCurrency := qryPedidosFiliaisqtderecebidaanterior.AsCurrency
          else
            qryPedidosFiliaisqtderecebida.AsCurrency := 0;
//          qryPedidosFiliais.Post;
        end;
      end
      else
      if (qryPedidosFiliaisqtdepedida.AsCurrency > 0) and
              (qryPedidosFiliaisqtderecebida.AsCurrency > qryPedidosFiliaisqtdepedida.AsCurrency) then
      begin
        if MensagemConfirmacao(ctQTDETRANSFERIDAMAIORPEDIDA) = smbCancel then
        begin
//          qryPedidosFiliaisqtderecebida.Clear;
//          qryPedidosFiliais.FieldByName('qtderecebida').FocusControl;
          if qryPedidosFiliais.State = dsEdit then
          begin
            if qryPedidosFiliaisqtderecebidaanterior.AsCurrency <> 0 then
              qryPedidosFiliaisqtderecebida.AsCurrency := qryPedidosFiliaisqtderecebidaanterior.AsCurrency
            else
              qryPedidosFiliaisqtderecebida.AsCurrency := 0;
          end;
//        else
//          qryPedidosFiliais.FieldByName('qtderecebida').FocusControl;
        end;
      end
      else
      if qryPedidosFiliais.State = dsEdit then
      begin
//        qryPedidosFiliais.DisableControls;
        qryPedidosFiliais.bloquearordenacao := true;
        qryPedidosFiliais.Post;
        qryPedidosFiliais.bloquearordenacao := false;
//        qryPedidosFiliais.EnableControls;

      end;

      qryPedidosFiliais.FieldByName('qtderecebida').FocusControl;
    end;
  end
  else
  if field = qryPedidosFiliaismarcarlotetransferencia then
  begin
    if not field.AsBoolean then
    begin
      if (qryPedidosFiliaislotetransferencia.asinteger <> 0) then
      begin
        if MensagemSelecionaOpcao('Confirma a retirada do produto do lote?') = smbYES then
        begin
          qryApagarProdutoConferencia.parambyname('lotetransferencia').asString := qryPedidosFiliaislotetransferencia.asString;
          qryApagarProdutoConferencia.parambyname('produto').asString := qryPedidosFiliaisproduto.asString;
          qryApagarProdutoConferencia.execSQL;

          qryPedidosFiliaisqtderecebida.clear;
          qryPedidosFiliaislotetransferencia.Clear;

        end
        else
        begin
          if qryPedidosFiliaisqtderecebidaanterior.AsCurrency <> 0 then
            qryPedidosFiliaisqtderecebida.AsCurrency := qryPedidosFiliaisqtderecebidaanterior.AsCurrency
          else
            qryPedidosFiliaisqtderecebida.clear;

          qryPedidosFiliaismarcarlotetransferencia.asBoolean := true;
        end;
      end
      else
      begin
        qryPedidosFiliaisqtderecebida.clear;
        qryPedidosFiliaislotetransferencia.Clear;
      end;
    end
    else
      qryPedidosFiliaisqtderecebida.AsFloat := qryPedidosFiliaisqtdepedida.AsFloat;
  end;

  dsrPedidosFiliais.OnDataChange:= dsrPedidosFiliaisDataChange;
end;

