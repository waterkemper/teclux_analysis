procedure TdtmTransferenciaRequisicaoExposicao.ReservaPreviaProduto(
  Situacao: String);

  procedure NovoMovimentoReservaPrevia(Produto: int64; Filial: Integer);
  begin
    if qryMovimentosCancelamentoReabertura.State = dsInactive then
      qryMovimentosCancelamentoReabertura.Open;
    qryMovimentosCancelamentoReabertura.Append;
    spcMovimentosProximo.Open;
    qryMovimentosCancelamentoReaberturanumero.AsInteger := spcMovimentosProximonumero.AsInteger;
    spcMovimentosProximo.Close;
    qryMovimentosCancelamentoReaberturaproduto.AsLargeInt   := Produto;
    qryMovimentosCancelamentoReaberturafilial.AsInteger     := Filial;
    qryMovimentosCancelamentoReaberturareferencia.AsString:='REQUISICAO ' + qryPedidosFiliaiscodigo.AsString;
  end;

begin
  NovoMovimentoReservaPrevia(qryPedidosFiliaisproduto.AsLargeInt,qryPedidosFiliaisfilial_estoque.AsInteger);
  if Situacao='C' then
    qryMovimentosCancelamentoReaberturatipomovimento.AsString:='TPE'
  else
    qryMovimentosCancelamentoReaberturatipomovimento.AsString:='TEP';
  qryMovimentosCancelamentoReaberturaquantidade.AsCurrency:=qryPedidosFiliaisqtdepedida.AsCurrency;
  qryMovimentosCancelamentoReabertura.Post;
end;

procedure TdtmTransferenciaRequisicaoExposicao.Selecionar(TipoConsulta: TtecTransferenciaRequisicao);
begin
  case TipoConsulta of
    ttrFORNECEDORES: begin
                       qryDadosFiscais.Edit;
                       qryDadosFiscais.fieldbyname('fornecedortransporte').AsInteger:= qryConsultaFornecedorTransportecodigo.AsInteger;
                       qryDadosFiscais.Post;
                     end;
    ttrESTADOS     : begin
                       qryDadosFiscais.Edit;
                       qryDadosFiscais.fieldbyname('estadoplaca').AsString:= qryConsultaEstadoscodigo.AsString;
                       qryDadosFiscais.Post;
                     end;
    ttrFILIAIS     : ReFazConsulta(qryProcuraFiliais,[0],[qryConsultaFiliaiscodigo.AsInteger]);
  end;
end;

procedure TdtmTransferenciaRequisicaoExposicao.SetDataFinal(const Value: String);
begin
  if FDataFinal <> Value then
    FDataFinal:= Value;
  MontaIntervaloData;
end;

procedure TdtmTransferenciaRequisicaoExposicao.SetDataInicial(const Value: String);
begin
  if FDataInicial <> Value then
    FDataInicial:= Value;
  MontaIntervaloData;
end;

procedure TdtmTransferenciaRequisicaoExposicao.SetFilialRequisitante(const Value: String);
begin
  if Value <> '' then
       qryPedidosFiliais.macrobyname('Requisitante').asstring := 'and (pf.requisitante = ' + Value + ')'
  else qryPedidosFiliais.macrobyname('Requisitante').asstring := '';
end;

procedure TdtmTransferenciaRequisicaoExposicao.SetSituacao(const Value: Integer);
begin
  case Value of
    0: qryPedidosFiliais.macrobyname('Situacao').asstring := 'and (pf.situacao = ' + QuotedStr('A') + ')';
    1: qryPedidosFiliais.macrobyname('Situacao').AsString := 'and (pf.situacao = ' + QuotedStr('F') + ')';
    2: qryPedidosFiliais.macrobyname('Situacao').AsString := 'and (pf.situacao = ' + QuotedStr('D') + ')';
    3: qryPedidosFiliais.macrobyname('Situacao').AsString := 'and (pf.situacao = ' + QuotedStr('C') + ')';
  end;
end;

function TdtmTransferenciaRequisicaoExposicao.VerificarSerieFilial: Boolean;
begin
  ReFazConsulta(qrySeriesFiliais, [0,1], [FilialBase, SerieSugestao]);
  if qrySeriesFiliais.RecordCount = 0 then begin
    MensagemAviso(format(ctFILIALSEMSERIE, [FilialBase, 'mercadorias']));
    Result := False;
  end else if qrySeriesFiliaismodelonota.IsNull then begin
    MensagemAviso(ctSERIESUGESTAOSEMMODELO);
    Result := False;
  end else
    Result := True;
end;

