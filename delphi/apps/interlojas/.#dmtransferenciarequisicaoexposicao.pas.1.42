{ TdtmTransferenciaRequisicaoExposicao }

procedure TdtmTransferenciaRequisicaoExposicao.AbrirTabelas(TipoConsulta: TtecTransferenciaRequisicao);
begin
  case TipoConsulta of
    ttrFORNECEDORES: Abre(ctLOJTabelaConsultaFornecedoresTransporte);
         ttrESTADOS: Abre(ctLOJTabelaConsultaEstados);
         ttrFILIAIS: Abre(ctLOJTabelaConsultaFiliais);
  end;
end;

procedure TdtmTransferenciaRequisicaoExposicao.AtualizarPedidosFiliais;
begin
  qryAtualizarPedidosFiliais.Open;
  if qryAtualizarPedidosFiliais.RecordCount > 0 then begin
    qryProdutos.First;
    while not qryProdutos.Eof do begin
      if (qryAtualizarPedidosFiliais.Locate('codigo',qryProdutos.FieldByName('codigopedidofilial').AsInteger,[])) then begin
        qryAtualizarPedidosFiliais.Edit;
        qryAtualizarPedidosFiliaissituacao.AsString   := 'F';
        qryAtualizarPedidosFiliaisdadofiscal.AsInteger:= qryNotasdadofiscal.AsInteger;
        qryAtualizarPedidosFiliais.Post;
      end;
      qryProdutos.Next;
    end;
  end;
end;

procedure TdtmTransferenciaRequisicaoExposicao.BloquearEstoque;
var
  Pos: TBookmark;
  WhereSQL: String;

  procedure IncluirProdutoNoEstoque;
  begin
    qryEstoques.Insert;
    qryEstoquesproduto.AsString      := qryProdutos.FieldByName('produto').AsString;
    qryEstoquesfilial.AsInteger        := FFilialEstoqueRequisitante;
    qryEstoquesemestoque.AsCurrency     := 0;
    qryEstoquesreservado.AsCurrency     := 0;
    qryEstoquestransito.AsCurrency      := 0;
    qryEstoquesdemonstracao.AsCurrency  := 0;
    qryEstoquesconserto.AsCurrency      := 0;
    qryEstoquesfuturo.AsCurrency        := 0;
    qryEstoquesdanificada.AsCurrency    := 0;
    qryEstoquesestoquefisico.AsCurrency := 0;
    qryEstoques.Post;
  end;

begin
  // Verifica a existencia do produto na filial requisitante.
  qryProdutos.First;
  while not qryProdutos.Eof do begin
    ReFazConsulta(qryExisteEstoque,[0,1],[qryProdutos.FieldByName('produto').AsString, FFilialEstoqueRequisitante]);
    if qryExisteEstoque.IsEmpty then
      IncluirProdutoNoEstoque;
    qryProdutos.Next;
  end;
  Perpetrar([qryEstoques]);

  Pos := qryProdutos.GetBookmark;
  qryProdutos.DisableControls;
  try
    if qryProdutos.RecordCount = 0 then
      WhereSQL := 'false'
    else begin
      WhereSQL := '';
      qryProdutos.First;
      while Not qryProdutos.Eof do begin
        WhereSQL := WhereSQL +
        '((e.produto = ' + qryProdutos.FieldByName('produto').AsString + ')and' +
        '(e.filial = '   + qryProdutos.FieldByName('filial').AsString  + '))or';
        qryProdutos.Next
      end;
      Delete(WhereSQL, Length(WhereSQL) - 1, 2);
    end
  finally
    qryProdutos.GotoBookmark(Pos);
    qryProdutos.FreeBookmark(Pos);
    qryProdutos.EnableControls;
  end;
  qryEstoqueBloqueio.MacroByName('ProdutoFilial').AsString := WhereSQL;
  if qryEstoqueBloqueio.Active then
    qryEstoqueBloqueio.Close;
  qryEstoqueBloqueio.Open;
end;

function TdtmTransferenciaRequisicaoExposicao.CancelarRequisicao: Boolean;
var
  Op: String;
  SitAux: String;
begin
  //SE CANCELAMENTO - RETORNAR QUANTIDADES PARA O ESTOQUE  - CASO REABERTURA COLOCAR NA RESERVA PREVIA
  if Cancelado then Op:= ' a Re-abertura '
  else              Op:= ' o cancelamento ';
  Result:= False;
  if MensagemConfirmacao('Confirma' + Op + 'da REQUISIÇÃO DO PRODUTO?') = smbOK then
  begin
    //try
       if qryPedidosFiliaissituacao.AsString = 'C' then
          SitAux := 'A'
       else SitAux := 'C';
       QryUpdPedidosFiliais.Sql.Clear;
       QryUpdPedidosFiliais.Sql.Add('UPDATE pedidosfiliais');
       QryUpdPedidosFiliais.Sql.Add('SET situacao='+''''+SitAux+''''+',');
       QryUpdPedidosFiliais.Sql.Add('qtderecebida=0');
       QryUpdPedidosFiliais.Sql.Add('WHERE codigo='+qryPedidosFiliaisCodigo.AsString);
       QryUpdPedidosFiliais.ExecSql;
       if ParSistema.RequisicaoSubtraiEstoque then
       begin
         ReservaPreviaProduto(SitAux);
         result := Perpetrar([qryMovimentosCancelamentoReabertura]);
       end;

    //except
    //  Result := False;
    //  Exit;
    //end;
    //Result:= True;
    // para fazer update dos dados -> eles não deveriam estar mais aparecendo na tela,
    // neste ponto
    if result then
    begin
      qryPedidosFiliais.Close;
      qryPedidosFiliais.Open;
    end;
  end;
end;

function TdtmTransferenciaRequisicaoExposicao.ComplementoDadosFiscais: Boolean;
begin
  Result:= True;
  if FPrimeiraVez then
  begin
    frmDadosTransportador:= TfrmDadosTransportador.Create(frmDadosTransportador);
    try
//      frmDadosTransportador.DataModulo:= Self;
      Result:= frmDadosTransportador.ShowModal = mrOk;
    finally
      frmDadosTransportador.Free;
    end;
  end;

  if Result then begin
    qryDadosFiscais.Edit;
    with TranspNotaFiscal do begin
      if FornecedorTransporte > 0 then
        qryDadosFiscais.fieldbyname('FornecedorTransporte').AsInteger := FornecedorTransporte;
      if TipoFrete <> '' then
        qryDadosFiscais.fieldbyname('frete').AsString             := TipoFrete;
      if TipoTransp <> '' then
        qryDadosFiscais.fieldbyname('viatransporte').AsString     := TipoTransp;
      if EstadoPlaca <> '' then
        qryDadosFiscais.fieldbyname('estadoplaca').AsString       := EstadoPlaca;
      if Placa <> '' then
        qryDadosFiscais.fieldbyname('placa').AsString             := Placa;
      if Observacao <> '' then
        qryDadosFiscais.fieldbyname('observacoes').AsString       := qryDadosFiscais.fieldbyname('observacoes').AsString + Observacao;
      if not FPrimeiraVez then
        qryVolumesDadosFiscais.Append
      else
        qryVolumesDadosFiscais.edit;
      qryVolumesDadosFiscaisdadofiscal.AsInteger  := qryDadosFiscais.fieldbyname('numero').AsInteger;
      qryVolumesDadosFiscaiscodigo.AsInteger      := 1;
      if Volumes > 0 then
        qryVolumesDadosFiscaisvolumes.AsInteger   := Volumes;
      if PesoBruto > 0 then
        qryVolumesDadosFiscaispesobruto.AsFloat   := PesoBruto;
      if PesoLiquido > 0 then
        qryVolumesDadosFiscaispesoliquido.AsFloat := PesoLiquido;
      if Numeracao <> '' then
        qryVolumesDadosFiscaisnumeracao.AsString  := Numeracao;
      if Marca <> '' then
        qryVolumesDadosFiscaismarca.AsString      := Marca;
      if EspecieTransporte <> '' then
        qryVolumesDadosFiscaisespecietransporte.AsString := EspecieTransporte;
    end;
    qryDadosFiscais.Post;
    qryVolumesDadosFiscais.Post;
  end;
end;

function TdtmTransferenciaRequisicaoExposicao.ConfirmaRequisicao: Boolean;
var
  WhereSQL: String;
  Pos: TBookmark;
begin
  result := true;
  if MensagemConfirmacao(ctCONFIRMATRANSFERENCIA) = smbOk then
  begin

    TipoNotaFiscalaEmitir := NaoEmitir;

    ReFazConsulta(qryNaturezasPadrao,[],[]);
    FImprimindoNota:= True;
    FPrimeiraVez   := True;
    WhereSQL:= '';
    Pos:= qryPedidosFiliais.GetBookmark;
    qryPedidosFiliais.DisableControls;
    try
      InicializarTabelas;
      qryPedidosFiliais.First;

      while not qryPedidosFiliais.Eof do
      begin
        if (qryPedidosFiliaisqtderecebida.AsCurrency > 0) and
           (qryPedidosFiliaissituacao.AsString = 'A')    then
        begin
          if (Frequisitante > 0) and (Frequisitante <> qryPedidosFiliaisrequisitante.AsInteger) then
          begin
            Delete(WhereSQL,Length(WhereSQL),1);
            qryAtualizarPedidosFiliais.Sql[08]:= '(pf.codigo in (' + WhereSql + '))';
            ImprimirNotaFiscal;
            InicializarTabelas;
            FPrimeiraVez:= False;
            WhereSQL:= '';
          end;
          Frequisitante:= qryPedidosFiliaisRequisitante.AsInteger;
          FFilialEstoqueRequisitante:=qryPedidosFiliaisfilial_estoque_requisitante.AsInteger;
          result := IncluirProdutos;

          if not result then
            break;
          WhereSQL:= WhereSQL + qryPedidosFiliaiscodigo.AsString + ',';
        end;
        qryPedidosFiliais.Next;
      end;

      if result then
        if (qryProdutos.RecordCount > 0) then begin
          Delete(WhereSQL,Length(WhereSQL),1);
          qryAtualizarPedidosFiliais.Sql[08]:= '(pf.codigo in (' + WhereSql + '))';
          ImprimirNotaFiscal;
        end;

    finally

      qryPedidosFiliais.GotoBookmark(Pos);
      qryPedidosFiliais.FreeBookmark(Pos);
      qryPedidosFiliais.EnableControls;
      FImprimindoNota:= False;
      GerarConsultaRequisicao;
      qryPedidosFiliais.Filtered := false;
      qryPedidosFiliais.Filtered := true;
    end;
  end;
end;

constructor TdtmTransferenciaRequisicaoExposicao.Create(AOwner: TComponent);
begin
  inherited;
  qryProcuraFiliais.Tag := ctTabelas;
  qryProcuraFornecedorTransporte.Tag := ctTabelas;
  qryProcuraEstados.Tag := ctTabelas;
  qryTiposRecebimentos.Tag := ctTabelas;
  qryProdutosTrocados.Tag := ctTabelas;
  qryConsultaFiliais.Tag:= ctLOJTabelaConsultaFiliais;
  qryConsultaFornecedorTransporte.Tag := ctLOJTabelaConsultaFornecedoresTransporte;
  qryConsultaEstados.Tag := ctLOJTabelaConsultaEstados;
  qryProcuraFiliais.Params[1].AsInteger := FilialBase;
  qryConsultaFiliais.Params[0].AsInteger:= FilialBase;
  qryPedidosFiliais.Params[0].AsInteger := FilialBase;
  FImprimindoNota:= False;
  FRequisitante:= 0;
  FFilialEstoqueRequisitante:=0;
  qryPedidosFiliaisestoquerequisitante     .DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryPedidosFiliaisestoquerequisitada      .DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryPedidosFiliaisreservapreviarequisitada.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryPedidosFiliaisqtdepedida              .DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryPedidosFiliaisqtderecebida            .DisplayFormat := ParSistema.MascaraQuantidadeGrade;

  qryTotaisPedidosFiliaisqtdepedida              .DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryTotaisPedidosFiliaisqtderecebida            .DisplayFormat := ParSistema.MascaraQuantidadeGrade;



end;

procedure TdtmTransferenciaRequisicaoExposicao.dsrPedidosFiliaisDataChange(Sender: TObject; Field: TField);
var
  DisponivelParaTransferir : Currency;
begin
  inherited;
  dsrPedidosFiliais.OnDataChange:= nil;
  if Field = qryPedidosFiliaisqtderecebida then begin
    if (qryPedidosFiliaiscodigo.AsInteger > 0) then begin
      if ParSistema.RequisicaoSubtraiEstoque then
        DisponivelParaTransferir:=qryPedidosFiliaisreservapreviarequisitada.Ascurrency
      else
        DisponivelParaTransferir:=qryPedidosFiliaisestoquerequisitada.AsCurrency;

      if (qryPedidosFiliaisqtderecebida.AsCurrency > DisponivelParaTransferir) then
      begin
        MensagemAviso(ctQUANTIDADEINDISPONILVEL);
//        qryPedidosFiliais.FieldByName('qtderecebida').FocusControl;
        if qryPedidosFiliais.State = dsEdit then
        begin
//          qryPedidosFiliaisqtderecebida.Clear;
          if qryPedidosFiliaisqtderecebidaanterior.AsCurrency <> 0 then
            qryPedidosFiliaisqtderecebida.AsCurrency := qryPedidosFiliaisqtderecebidaanterior.AsCurrency
          else
            qryPedidosFiliaisqtderecebida.AsCurrency := 0;
//          qryPedidosFiliais.Post;
        end;
      end
      else
      if (qryPedidosFiliaisqtdepedida.AsCurrency > 0) and
              (qryPedidosFiliaisqtderecebida.AsCurrency > qryPedidosFiliaisqtdepedida.AsCurrency) then
      begin
        if MensagemConfirmacao(ctQTDETRANSFERIDAMAIORPEDIDA) = smbCancel then
        begin
//          qryPedidosFiliaisqtderecebida.Clear;
//          qryPedidosFiliais.FieldByName('qtderecebida').FocusControl;
          if qryPedidosFiliais.State = dsEdit then
          begin
            if qryPedidosFiliaisqtderecebidaanterior.AsCurrency <> 0 then
              qryPedidosFiliaisqtderecebida.AsCurrency := qryPedidosFiliaisqtderecebidaanterior.AsCurrency
            else
              qryPedidosFiliaisqtderecebida.AsCurrency := 0;
          end;
//        else
//          qryPedidosFiliais.FieldByName('qtderecebida').FocusControl;
        end;
      end
      else
      if qryPedidosFiliais.State = dsEdit then
      begin
//        qryPedidosFiliais.DisableControls;
        qryPedidosFiliais.bloquearordenacao := true;
        qryPedidosFiliais.Post;
        qryPedidosFiliais.bloquearordenacao := false;
//        qryPedidosFiliais.EnableControls;

      end;

      qryPedidosFiliais.FieldByName('qtderecebida').FocusControl;
    end;
  end
  else
  if field = qryPedidosFiliaismarcarlotetransferencia then
  begin
    if not field.AsBoolean then
    begin
      if (qryPedidosFiliaislotetransferencia.asinteger <> 0) then
      begin
        qryApagarProdutoConferencia.parambyname('lotetransferencia').asString := qryPedidosFiliaislotetransferencia.asString;
        qryApagarProdutoConferencia.parambyname('produto').asString := qryPedidosFiliaisproduto.asString;
        qryApagarProdutoConferencia.execSQL;
      end;

      qryPedidosFiliaisqtderecebida.clear;
      qryPedidosFiliaislotetransferencia.Clear;
    end
    else
      qryPedidosFiliaisqtderecebida.AsFloat := qryPedidosFiliaisqtdepedida.AsFloat;
  end;

  dsrPedidosFiliais.OnDataChange:= dsrPedidosFiliaisDataChange;
end;

