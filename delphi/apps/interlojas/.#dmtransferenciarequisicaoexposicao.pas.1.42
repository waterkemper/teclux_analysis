procedure TdtmTransferenciaRequisicaoExposicao.qryDadosFiscaisNewRecord(
  DataSet: TDataSet);
begin
  inherited;
  qryDadosFiscais.fieldbyname('modelodocto').AsString := ModeloDoctoFiscal;
  qryDadosFiscais.fieldbyname('manual').Asboolean := False;
  qryDadosFiscais.fieldbyname('versaolayout').AsCurrency   := 3.10;
  { 0 – pagamento à vista   1 – pagamento à prazo     2 - outros }
  qryDadosFiscais.fieldbyname('formapagto').AsInteger      := 2;
  { 1-Retrato/ 2-Paisagem }
  qryDadosFiscais.fieldbyname('formatodanfe').AsInteger    := 1;
  {1-Normal/ 2-Contingência}
  qryDadosFiscais.fieldbyname('formaemissao').AsInteger    := NFeTipoEmissao;
  qrydadosfiscais.fieldbyname('regimetributario').AsInteger := RegimeTributario;
  qryDadosFiscais.fieldbyname('indpres').AsInteger := 1;
end;

procedure TdtmTransferenciaRequisicaoExposicao.qryPedidosFiliaisFilterRecord(
  DataSet: TDataSet; var Accept: Boolean);
begin
  inherited;
  Accept := true;
  if vImprimindoRequisicoes then
  begin
    if ParSistema.ImprimirRequisicaoNaoConfirmada then
      Accept := qryPedidosFiliaisqtderecebida.AsCurrency >= 0
    else
      Accept := qryPedidosFiliaisqtderecebida.AsCurrency > 0;
  end;

  if (trim(qryLotesPedidosFiliaislotetransferencia.asstring)<>'') then
    Accept := Accept and (trim(qryPedidosFiliaislotetransferencia.AsString) =
                          trim(qryLotesPedidosFiliaislotetransferencia.AsString))
  else
    Accept := Accept;


end;

procedure TdtmTransferenciaRequisicaoExposicao.LocalizarProduto(
  TextodePesquisa: String; TipoPesquisaProduto: TtecTipoPesquisaProduto);
begin
  case TipoPesquisaProduto of
    pesCODIGOBARRAS:
    begin
      if not qryPedidosFiliaisCodigoBarras.Locate('codigobarras',TextodePesquisa,[]) then
        MensagemAviso('O Código de Barras não foi encontrado', true)
      else
      if not qryPedidosFiliais.Locate('produto', qryPedidosFiliaisCodigoBarrasproduto.AsString,[]) then
        MensagemAviso('O Código de Barras não foi encontrado', true)
      else
      begin
        qryPedidosFiliais.Edit;
        qryPedidosFiliaisqtderecebida.AsCurrency := qryPedidosFiliaisqtderecebida.AsCurrency + 1;
      end;
    end;

    pesPRODUTO:
    begin
      if not qrypedidosfiliais.Locate('produto',TextodePesquisa,[]) then
        MensagemAviso('O Produto não foi localizado')
      else
      begin
        qryPedidosFiliais.Edit;
        qryPedidosFiliaisqtderecebida.AsCurrency := qryPedidosFiliaisqtderecebida.AsCurrency + 1;
      end;
    end;
  end;
end;

procedure TdtmTransferenciaRequisicaoExposicao.qryPedidosFiliaisBeforePost(
  DataSet: TDataSet);
begin
  inherited;
  qryPedidosFiliaisqtderecebidaanterior.AsCurrency := qryPedidosFiliaisqtderecebida.AsCurrency
end;

procedure TdtmTransferenciaRequisicaoExposicao.qryPedidosFiliaisAfterOpen(
  DataSet: TDataSet);
begin
  inherited;
  qryTotaisPedidosFiliais.Close;
  qryTotaisPedidosFiliais.Open;
  qryTotaisPedidosFiliais.Append;
  qryTotaisPedidosFiliaisqtdepedida.AsCurrency := SomarValores(qryPedidosFiliais, [qryPedidosFiliaisqtdepedida],[],[],[]);
  qryTotaisPedidosFiliaisqtderecebida.AsCurrency := SomarValores(qryPedidosFiliais, [qryPedidosFiliaisqtderecebida],[],[],[]);
  qryTotaisPedidosFiliais.post;

  AbrirLotesPedidosFiliais;

end;

procedure TdtmTransferenciaRequisicaoExposicao.VerificarLoteTransferencia;
var
  produto: String;
  n, i, filial : Integer;
  VarArray: Variant;
  vproduto: String;
begin

  if qryPedidosFiliaislotetransferencia.IsNull then
  begin
    qryPedidosFiliais.AfterPost := nil;

    qryLotesTransferencia_ProximoCodigo.Close;
    qryLotesTransferencia_ProximoCodigo.OPen;
    qryLotesTransferencia.Close;
    qryLotesTransferencia.Open;
    qryLotesTransferencia.Append;
    qryLotesTransferenciacodigo.AsInteger := qryLotesTransferencia_ProximoCodigocodigo.AsInteger;
    qryLotesTransferenciausuario.AsInteger := UsuarioLogin.CodigoUsuario;
    qryLotesTransferenciadatahora.AsDateTime := DataHoraServidor;
    qryLotesTransferencia.post;

    GuardarRegistroAtual(qryPedidosFiliais, true);

    VarArray := VarArrayCreate([0,0], varVariant);

    qryPedidosFiliais.First;
    while not qryPedidosFiliais.Eof do
    begin
      if qryPedidosFiliaismarcarlotetransferencia.AsBoolean and
         qryPedidosFiliaislotetransferencia.IsNull then
      begin
        n  := VarArrayHighBound(VarArray, 1);
        if not VarIsEmpty(VarArrayGet(VarArray, [n])) then
        begin
          inc(n);
          VarArrayRedim(VarArray, n);
        end;
        VarArrayPut(VarArray, qrypedidosfiliaisproduto.asvariant, n);
      end;
      qryPedidosFiliais.Next;
    end;

   { Now read the elements of the array }
    for I := VarArrayLowBound(VarArray, 1) to VarArrayHighBound(VarArray, 1) do
    begin
      vproduto := VarArrayGet(VarArray, [I]);
      if qrypedidosfiliais.Locate('produto', vproduto,[]) then
      begin
        qryPedidosFiliais.Edit;
        qryPedidosFiliaislotetransferencia.AsInteger := qryLotesTransferenciacodigo.AsInteger;
        qryPedidosFiliais.post;
      end;
    end;

    VoltarRegistroAtual(qryPedidosFiliais);

    produto := qryPedidosFiliaisproduto.AsString;
    filial  := qryPedidosFiliaisrequisitante.AsInteger;
    perpetrar([qryLotesTransferencia, qryPedidosFiliais]);
    qryPedidosFiliais.Locate('produto;requisitante', varArrayOf([produto,filial]),[]);

    qryPedidosFiliais.AfterPost := qryPedidosFiliaisAfterPost;


  end;

end;

function TdtmTransferenciaRequisicaoExposicao.GetCondicaoEmissorNFE: Boolean;
begin
  if qryDadosFiscais.recordcount <> 0 then
    fCondicaoEmissorNFE := parsistema.EmissorNfe and
                           ((qryDadosFiscais.fieldbyname('modelodocto').AsString = '55') or
                            (qryDadosFiscais.fieldbyname('modelodocto').AsString = '57'))
  else
    fCondicaoEmissorNFE := parsistema.EmissorNfe and
                           ((ModeloDoctoFiscal = '55') or
                            (ModeloDoctoFiscal = '57'));

  Result := fCondicaoEmissorNFE;
end;

procedure TdtmTransferenciaRequisicaoExposicao.AbrirLotesPedidosFiliais;
begin
  qryLotesPedidosFiliais.ParamByName('requisitada').Asinteger := qryPedidosFiliais.ParamByName('requisitada').Asinteger;
  qryLotesPedidosFiliais.Macros := qryPedidosFiliais.Macros;
  qryLotesPedidosFiliais.Close;
  qryLotesPedidosFiliais.Open;
  qryLotesPedidosFiliais.First;

  qryLotesPedidosFiliais_.ParamByName('requisitada').Asinteger := qryPedidosFiliais.ParamByName('requisitada').Asinteger;
  qryLotesPedidosFiliais_.Macros := qryPedidosFiliais.Macros;
  qryLotesPedidosFiliais_.Close;
  qryLotesPedidosFiliais_.Open;
  qryLotesPedidosFiliais_.First;


end;

function TdtmTransferenciaRequisicaoExposicao.GetNumContrato: String;
begin
  if (fNumContrato = '')  then
  begin
    spcContratosProximo.Close;
    spcContratosProximo.Open;
    fNumContrato := spcContratosProximonumero.AsString;
  end;
  result := fNumContrato;
end;

end.

