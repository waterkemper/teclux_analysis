  if qryPedidosFiliais.State = dsEdit then
    qryPedidosFiliais.Post;
end;

function TdtmTransferenciaRequisicaoExposicao.ImprimirNotaFiscal: Boolean;
var
  ChaveAcesso: String;
  NFe: TTecNotaFiscalEletronica;
  LoteNFe, ReciboNFe, ProtocoloNFe, status, DataHoraProcessamento: String;
//  ValorPIS, ValorCOFINS: Currency;


  procedure PreencherDadoFiscal;
  var
    Cont: Integer;
  begin
    qryNotas.Edit;
    qryNotasdadofiscal.AsInteger := NovoNumeroDadoFiscal;
    qryNotas.Post;

    qryDadosFiscais.Insert;
    qryDadosFiscais.FieldByName('numero').AsInteger       := qryNotasdadofiscal.AsInteger;
    qryDadosFiscais.FieldByName('data').AsDateTime        := DataServidor;
    qryDadosFiscais.FieldByName('situacao').AsString      := 'N';
    qryDadosFiscais.FieldByName('filialvenda').AsInteger  := FilialBase;
    qryDadosFiscais.FieldByName('estadocfo').AsString     := qryFilialDestinoestado.AsString;

    fnumContrato := '';
    if TipoNotaFiscalaEmitir = VendaTransferencia then
    begin
      qryDadosFiscais.FieldByName('contratofrentecaixa').AsString := numContrato;
      qryDadosFiscais.FieldByName('vendedor').asInteger := UsuarioLogin.CodigoUsuario;
      qryDadosFiscais.FieldByName('vendatransferencia').asBoolean := true;
    end;

    qryDadosFiscais.FieldByName('codigonatureza').AsInteger := qryprodutos.fieldbyname('natureza').AsInteger;
    qryDadosFiscais.FieldByName('natureza').AsString       := qryprodutos.fieldbyname('descricaonatureza').AsString;
    qryDadosFiscais.FieldByName('codigofiscal').AsInteger  := qryprodutos.fieldbyname('codigofiscal').AsInteger;

    qryDadosFiscais.FieldByName('pessoatipo').AsString    := 'J';
    qryDadosFiscais.FieldByName('pessoanumero').AsString  := qryFilialDestinocnpj.AsString;
    qryDadosFiscais.FieldByName('nome').AsString          := qryFilialDestinorazao.AsString;
    qryDadosFiscais.fieldbyname('clientecontribicms').AsBoolean := qryFilialDestinocontribicms.AsBoolean;

    if qryFilialDestinoestado.AsString='.' then {estrangeiro}
    begin
      qryDadosFiscais.FieldByName('pais').AsString    := qryFilialDestinocodigoibge.AsString;
      qryDadosFiscais.FieldByName('nomepais').AsString                 := qryFilialDestinonomecidade.AsString;
      qryDadosFiscais.FieldByName('rua').AsString                      := qryFilialDestinorua.AsString;
      qryDadosFiscais.FieldByName('endnumero').AsString                := qryFilialDestinonumero.AsString;
      qryDadosFiscais.FieldByName('endcomplemento').AsString           := qryFilialDestinocomplemento.AsString;
      qryDadosFiscais.FieldByName('bairro').AsInteger                   := qryFilialDestinobairro.AsInteger;
      //qryDadosFiscaisnomebairro.AsString               := qryFilialDestinonomebairro.AsString;
      qryDadosFiscais.FieldByName('cidade').AsInteger                   := qryFilialDestinocidade.AsInteger;
      qryDadosFiscais.FieldByName('nomecidade').AsString               := qryFilialDestinonomebairro.AsString;
      //qryDadosFiscaiscidadeibge.AsString             := qryFilialDestinocodigoibge.AsString;
      qryDadosFiscais.FieldByName('estado').AsString                   := qryFilialDestinoestado.AsString;
      //qryDadosFiscaiscep.AsInteger                     := ConsultaOSP.qryProcuraClientecep.AsInteger;
    end
    else
    begin
      qryDadosFiscais.FieldByName('pais').AsInteger                    := 1058;
      qryDadosFiscais.FieldByName('nomepais').AsString                 := 'Brasil';
      qryDadosFiscais.FieldByName('rua').AsString                      := qryFilialDestinorua.AsString;
      qryDadosFiscais.FieldByName('endnumero').AsString                := qryFilialDestinonumero.AsString;
      qryDadosFiscais.FieldByName('endcomplemento').AsString           := qryFilialDestinocomplemento.AsString;
      qryDadosFiscais.FieldByName('bairro').Asinteger                  := qryFilialDestinobairro.AsInteger;
      qryDadosFiscais.FieldByName('nomebairro').AsString               := qryFilialDestinonomebairro.AsString;
      qryDadosFiscais.FieldByName('cidade').AsInteger                   := qryFilialDestinocidade.AsInteger;
      qryDadosFiscais.FieldByName('nomecidade').AsString               := qryFilialDestinonomecidade.AsString;
      qryDadosFiscais.FieldByName('cidadeibge').Asstring    := qryFilialDestinocodigoibge.AsString;
      qryDadosFiscais.FieldByName('estado').AsString                   := qryFilialDestinoestado.AsString;
      qryDadosFiscais.FieldByName('cep').AsInteger                      := qryFilialDestinocep.AsInteger;
    end;

    qryDadosFiscais.FieldByName('foneddd').AsInteger      := qryFilialDestinofoneddd.AsInteger;
    qryDadosFiscais.FieldByName('fonenumero').AsInteger   := qryFilialDestinofonenumero.AsInteger;
    qryDadosFiscais.FieldByName('documento').AsString     := qryFilialDestinoinscricaoestadual.AsString;

    qryDadosFiscais.FieldByName('filialemissao').AsInteger:= FilialBase;
    qryDadosFiscais.FieldByName('datasaida').AsDateTime   := DataServidor;
    qryDadosFiscais.FieldByName('Desconto').AsCurrency    := 0;
    qryDadosFiscais.FieldByName('seguro').AsCurrency      := 0;
    qryDadosFiscais.FieldByName('cliente').AsInteger      := qryFilialDestinocodigo.AsInteger;
    qryDadosFiscais.FieldByName('tipocliente').AsString   := 'L';

    qryDadosFiscais.FieldByName('viatransporte').AsString := 'R';
    qryDadosFiscais.FieldByName('frete').AsString         := '1';
    qryDadosFiscais.Post;

    Cont := 0;
    GuardarRegistroAtual(qryProdutos,True);
    try
      qryProdutos.First;
      while not qryProdutos.Eof do
      begin
        qryProdutos.Edit;
        qryProdutos.FieldByName('dadofiscal').AsInteger := qryDadosFiscais.FieldByName('numero').AsInteger;
        qryProdutos.FieldByName('numero').AsInteger     := Cont + 1;
        qryProdutos.Post;

//        ValorPIS := ValorPIS + qryProdutos.FieldByName('pisvalor').AsCurrency;
//        ValorCOFINS := ValorCOFINS + qryProdutos.FieldByname('cofinsvalor').AsCurrency;

        qryProdutos.Next;
        Inc(Cont);
      end;
    finally
      VoltarRegistroAtual(qryProdutos);
    end;
  end;

  function ImprimirNFE(Validando: Boolean = False) : boolean;
  begin
    qryDadosFiscais.Edit;
    qryDadosFiscais.FieldByName('nrdocumento').AsInteger  := qryNotasnumero.AsInteger;

    qryDadosFiscais.FieldByName('codaleatorio').Asinteger := Aleatorio(qryDadosFiscais.FieldByName('data').AsDateTime, qryDadosFiscais.FieldByName('nrdocumento').Asstring);

    ChaveAcesso :=
               copy(CodigoCidadeIBGEFilialBase,1,2)+                       // 2
               FormatDateTime('YYMM',qryDadosFiscais.FieldByName('data').AsDateTime)+      // 4
               preencheString(CNPJFilialBase,'0',14,false)+                // 14
               preencheString(qryDadosFiscais.FieldByName('modelodocto').AsString,'0',2,false)+ // 2
               preencheString(SerieSugestao,'0',3,false)+                  // 3
               preencheString(qryDadosFiscais.FieldByName('nrdocumento').Asstring,'0',9,false) + // 9
               qryDadosFiscais.fieldbyname('formaemissao').AsString +  //1
               preencheString(qryDadosFiscais.FieldByName('codaleatorio').Asstring,'0',8,false);  // 8

    qryDadosFiscais.FieldByName('digchaveacesso').AsString   := Modulo11(ChaveAcesso);
    qryDadosFiscais.FieldByName('chv_nfe').AsString := ChaveAcesso + qryDadosFiscais.FieldByName('digchaveacesso').AsString;
  //             modulo11(ChaveAcesso,'98765432',false);

    {1 - PRODUÇÃO 2 - HOMOLOGAÇÃO}
    qryDadosFiscais.FieldByName('ambiente').AsInteger         := NFeAmbiente;// '2';

    {1 - normal 2 - compelementar}
    if qryDadosFiscais.FieldByName('dadofiscalcomplementar').AsInteger=0 then
       qryDadosFiscais.FieldByName('finalidadenf').AsInteger  := 1
    else
       qryDadosFiscais.FieldByName('finalidadenf').AsInteger  := 2;

    qryDadosFiscais.FieldByName('procemissao').AsString      := '0';
    qryDadosFiscais.FieldByName('versaoteclux').AsString     := VersaoTecLUX;
    qryDadosFiscais.FieldByName('infcomplementar').AsString := qryDadosFiscais.FieldByName('observacoes').AsString;

    if (regimetributario = 1) and //simples
       (parsistema.obsnfeClientesnoSimples <> '') then
       qryDadosFiscais.FieldByName('infcomplementar').AsString := qryDadosFiscais.FieldByName('infcomplementar').AsString +
                                                  parsistema.obsnfeClientesnoSimples;

{    qryDadosFiscais.FieldByName('totalvalorpis').AsCurrency := ValorPIS;
    qryDadosFiscais.FieldByName('totalvalorcofins').AsCurrency := ValorCOFINS;
}

    qryDadosFiscais.Post;

    if not Validando then
      NFe := TTecNotaFiscalEletronica.Create
    else
      NFe := TTecNotaFiscalEletronica.Create(dtmTecSoft.Database);

    NFe.DiretorioEnvio       := NFeDirEnvio;
    NFe.DiretorioEnviado     := NFeDirEnviados;
    NFe.DiretorioRetorno     := NFeDirRetorno;
    NFe.DiretorioCompartilha := NfeDirCompartilha;
    NFe.Executavel           := NFeExecNFe;
    try
      if not validando then
      begin
        ShowProcessando('Gerando o arquivo da NF-e!');
        Sleep(500);
      end;

      // EMITENTE
      NFe.Emit_Documento := CNPJFilialBase;
      NFe.Emit_Nome      := RazaoFilialBase;
      NFe.Emit_Rua       := RuaSemNumeroFilialBase;
      NFe.Emit_Nro       := NumeroFilialBase;
      NFe.Emit_Compl     := ComplementoFilialBase;
      NFe.Emit_Bairro    := BairroFilialBase;
      NFe.Emit_CodMun    := CodigoCidadeIBGEFilialBase;
      NFe.Emit_Mun       := CidadeFilialBase;
      NFe.Emit_UF        := EstadoFilialBase;
      NFe.Emit_CEP       := CEPFilialBase;
      NFe.Emit_Fone      := DDDFilialBase+FoneFilialBase;
      NFe.Emit_IE        := InscricaoEstadualFilialBase;
      NFe.Emit_IM        := InscricaoMunicipalFilialBase;
      NFe.Emit_CNAE      := CNAEFiscalFilialBase;
      NFe.Emit_CRT       := qrydadosfiscais.fieldbyname('regimetributario').AsInteger;


      // DESTINATARIO
      NFe.Dest_TipoPessoa := qryDadosFiscais.fieldbyname('pessoatipo').AsString;
      NFe.Dest_Documento := qryDadosFiscais.fieldbyname('pessoanumero').AsString;
      NFe.Dest_Nome      := qryDadosFiscais.fieldbyname('nome').AsString;
      NFe.Dest_Rua       := qryDadosFiscais.fieldbyname('rua').AsString;
      NFe.Dest_Nro       := qryDadosFiscais.fieldbyname('endnumero').AsString;
      NFe.Dest_Compl     := qryDadosFiscais.fieldbyname('endcomplemento').AsString;
      NFe.Dest_Bairro    := qryDadosFiscais.fieldbyname('nomebairro').AsString;
      NFe.Dest_CodMun    := qryDadosFiscais.fieldbyname('cidadeibge').AsString;
      NFe.Dest_Mun       := qryDadosFiscais.fieldbyname('nomecidade').AsString;
      NFe.Dest_UF        := qryDadosFiscais.fieldbyname('estado').AsString;
      NFe.Dest_CEP       := qryDadosFiscais.fieldbyname('cep').AsString;
      NFe.Dest_CodPais   := qryDadosFiscais.fieldbyname('pais').AsInteger;
      NFe.Dest_Pais      := qryDadosFiscais.fieldbyname('nomepais').AsString;
      NFe.Dest_Fone      := qryDadosFiscais.fieldbyname('foneddd').AsString+qryDadosFiscais.fieldbyname('fonenumero').AsString;
      NFe.Dest_IE        := qryDadosFiscais.fieldbyname('documento').AsString;
      NFe.Dest_ISUF      := qryDadosFiscais.fieldbyname('iesubsttributario').AsString;

      // ENTREGA
      NFe.Entrega_Documento := qryDadosFiscais.fieldbyname('localentrega_cnpj').AsString;
      NFe.Entrega_Rua       := qryDadosFiscais.fieldbyname('localentrega_rua').AsString;
      NFe.Entrega_Nro       := qryDadosFiscais.fieldbyname('localentrega_numero').AsString;
      NFe.Entrega_Compl     := qryDadosFiscais.fieldbyname('localentrega_complemento').AsString;
      NFe.Entrega_Bairro    := qryDadosFiscais.fieldbyname('localentrega_nomebairro').AsString;
      NFe.Entrega_CodMun    := qryDadosFiscais.fieldbyname('localentrega_cidadeibge').AsString;
      NFe.Entrega_Mun       := qryDadosFiscais.fieldbyname('localentrega_nomecidade').AsString;
      NFe.Entrega_UF        := qryDadosFiscais.fieldbyname('localentrega_estado').AsString;

      nfe.Validando := validando;

      result:=NFe.GerarNFe(qryDadosFiscais,nil,qryProdutos,nil,nil,nil,
                   qryVolumesDadosFiscais, nil, nil,nil,SerieSugestao,
                   'S');

      if result and not validando then
      begin
        if NFeTipoEmissao in [1,3] then
        begin
          ShowProcessando;
          ShowProcessando('Verificando status do serviço NF-e!');
          Sleep(500);
          if NFe.VerificarStatusServico(IntToStr(NFeAmbiente)) then
          begin
            ShowProcessando;
            ShowProcessando('Processando o arquivo de envio da NF-e!');
            Sleep(500);
            Result := NFe.EnviarNFe(ChaveAcesso+qryDadosFiscais.fieldbyname('digchaveacesso').AsString, LoteNFe, ReciboNFe);
            if Result then
            begin
              qryDadosFiscais.Edit;
              qryDadosFiscais.fieldbyname('numlotenfe').AsString   := LoteNFe;
              qryDadosFiscais.fieldbyname('numrecibonfe').AsString := ReciboNFe;
              qryDadosFiscais.Post;
              Result := Perpetrar([qryDadosFiscais]);
              if Result then
              begin
                ShowProcessando;
                ShowProcessando('Consultando o arquivo de retorno da NF-e!');
                Sleep(5000);
                Result := NFe.ConsultarSituacaoLote(ReciboNFe, ProtocoloNFe, status, DataHoraProcessamento, IntToStr(NFeAmbiente));
              end;
              if Result then
              begin
                qryDadosFiscais.Edit;
                qryDadosFiscais.fieldbyname('numprotocolonfe').AsString := ProtocoloNFe;
                qryDadosFiscais.fieldbyname('statusnfe').AsString := status;
                qryDadosFiscais.fieldbyname('dhprocnfe').AsDateTime := FormatarTimeStamp(DataHoraProcessamento);

                if (qryDadosFiscais.fieldbyname('statusnfe').AsString = '301') or
                   (qryDadosFiscais.fieldbyname('statusnfe').AsString = '302') then
                begin
                  qryDadosFiscais.Edit;
                  qryDadosFiscais.fieldbyname('situacao').AsString := 'D';
                  qryDadosFiscais.Post;
                  //LimparTabela(qrymovimentos);
                  //Result := Perpetrar([qryMovimentos, qryDadosFiscais]);
                end;
                //else
                  Result := Perpetrar([qryDadosFiscais]);

                if Result then
                begin
                  ShowProcessando;
                  ShowProcessando('Gerando o arquivo de compartilhamento da NF-e!');
                  Sleep(500);
                  Result := NFe.CompartilharXML(ChaveAcesso+qryDadosFiscais.fieldbyname('digchaveacesso').AsString,
                                                ReciboNFe, qryDadosFiscais.fieldbyname('filialemissao').AsString,
                                                SerieSugestao, qryDadosFiscais.fieldbyname('nrdocumento').AsString,
                                                qryDadosFiscais.fieldbyname('data').AsDateTime);
                  if Result then
                  begin
                    {if not NFeVisualizarDANFE then
                      MensagemAviso('Impressão da Nota Fiscal será iniciada.')
                    else
                    begin
                    } ShowProcessando;
                      ShowProcessando('Imprimindo o DANFE!');
                    //end;
                    NFe.ImprimirDanfe({ChaveAcesso+qryDadosFiscaisdigchaveacesso.AsString,}
                                      qryDadosFiscais.fieldbyname('filialemissao').AsString,
                                      SerieSugestao,
                                      qryDadosFiscais.fieldbyname('nrdocumento').AsString,
                                      qryDadosFiscais.fieldbyname('localentrega_cep').AsString,
                                      qryDadosFiscais.fieldbyname('email').AsString,
                                      IntToStr(NFeNVias), NFeLogotipoDANFE,
                                      ParSistema.NomeImpressoraNotaMercadorias, NFeVisualizarDANFE,
                                      qryDadosFiscais.fieldbyname('data').AsDateTime,
                                      qryProdutos, NFeExecDANFE);
                    ShowProcessando;
                    if (qryDadosFiscais.fieldbyname('email').AsString <> '')      and
                       (UsuarioLogin.PortaSmpt        <> '')      and
                       (UsuarioLogin.HostSmtp         <> '')      and
                       (UsuarioLogin.Email            <> '')      and
                       (UsuarioLogin.SenhaEmail       <> '')      and
                       EmailValido(qryDadosFiscais.fieldbyname('email').AsString) then
                    begin
                      ShowProcessando('Enviando email para o cliente');
                      {NFe.EnviarEmail(MontarEmailNFe,
                                      'Envio da NFe(xml) - Emitente: ' + NomeFilialBase + ' - ' +
                                                             'N.Doc: ' + FormatarNroNFe(qryDadosFiscaisnrdocumento.AsString) +
                                                          ' - Série: ' + preencheString(SerieSugestao,'0',3,False),
                                      LowerCase(UsuarioLogin.Email), LowerCase(qryDadosFiscaisemail.AsString),
                                      NomeFilialBase, UsuarioLogin.PortaSmpt,UsuarioLogin.HostSmtp,
                                      LowerCase(UsuarioLogin.Email), UsuarioLogin.SenhaEmail,
                                      qryDadosFiscaisfilialvenda.AsString, SerieSugestao,
                                      qryDadosFiscaisnrdocumento.AsString, UsuarioLogin.AutenticarSmtp);}
                      try
                                                        if not NFe.EnviarEmail(UsuarioLogin.Email,qryDadosFiscais.fieldbyname('email').AsString,
                                                                            qryDadosFiscais.fieldbyname('nrdocumento').AsString, SerieSugestao, IntToStr(FilialBase),
                                                                            NomeFilialBase, RazaoFilialBase, CNPJFilialBase, DDDFilialBase, FoneFilialBase,
                                                                            DDDFaxFilialBase, FaxFilialBase, UsuarioLogin.NomeUsuario, UsuarioLogin.PortaSMPT,
                                                                            UsuarioLogin.HostSMTP, UsuarioLogin.UsuarioEmail, UsuarioLogin.SenhaEmail,
                                                                            qryDadosFiscais.fieldbyname('data').AsDateTime, qryDadosFiscais.fieldbyname('valortotal').AsCurrency,
                                                                            UsuarioLogin.AutenticarSMTP, qryDadosFiscais.fieldbyname('data').AsDateTime) then
                                                              MensagemAviso('Ocorreu um erro inesperado no envio do email')
                                                      finally
                                                            ShowProcessando;
                                                      end;
                    end;
                  end
                  else
                    ShowProcessando;
                end;
              end
              else
                ShowProcessando;
            end
            else
              ShowProcessando;
          end
          else
            ShowProcessando;
        end
        else
        begin
          if not NFeVisualizarDANFE then
            MensagemAviso('Impressão da Nota Fiscal será iniciada.');
          NFe.ImprimirDanfe({ChaveAcesso+qryDadosFiscaisdigchaveacesso.AsString,}
                            qryDadosFiscais.fieldbyname('filialemissao').AsString,
                            SerieSugestao,
                            qryDadosFiscais.fieldbyname('nrdocumento').AsString,
                            qryDadosFiscais.fieldbyname('localentrega_cep').AsString,
                            qryDadosFiscais.fieldbyname('email').AsString,
                            IntToStr(NFeNVias), NFeLogotipoDANFE,
                            ParSistema.NomeImpressoraNotaMercadorias, NFeVisualizarDANFE,
                            qryDadosFiscais.fieldbyname('data').AsDateTime,
                            qryProdutos, NFeExecDANFE);
        end;
      end;
    finally
      FreeAndNil(NFe); //NFe.Free;
    end;
  end;

  procedure IncluirEntradaCreditoTrocaFilial;
  begin
      qryProdutosTrocados.append;

      spcProdutosTrocadosProximo.Open;
      qryProdutosTrocadosnumero.AsInteger := spcProdutosTrocadosProximonumero.AsInteger;
      spcProdutosTrocadosProximo.close;

      qryProdutosTrocadostipo.AsString := 'E';
      qryProdutosTrocadosdata.Asdatetime := DataHoraServidor;
      qryProdutosTrocadoscliente.AsInteger := filialbase;
      qryProdutosTrocadostipocliente.AsString := 'L';
      qryProdutosTrocadosfilial.asinteger := qryDadosFiscais.fieldbyname('cliente').asinteger;
      qryProdutosTrocadosvalor.AsCurrency := qryDadosFiscais.fieldbyname('valortotal').AsCurrency;
      qryProdutosTrocadosdefeito.AsBoolean := false;
      qryProdutosTrocadosusuario.AsInteger := CodigoUsuario;
      qryProdutosTrocadosreferencia.asString := 'NF TRANSF. DEV. FILIAL ' + qrydadosfiscais.fieldbyname('cliente').asString
                                                                  + ' SÉRIE ' + qryNotasserie.asString
                                                                  + ' N° ' + qryNotasnumero.asstring;
      qryProdutosTrocados.Post;
  end;

  procedure IncluirSaidaCreditoTrocaFilial;
  var
    vSaldoCreditoTroca : Currency;
  begin
      vSaldoCreditoTroca := ValorCreditoTrocaEntreFiliais(FilialBase, qryFilialDestinocodigo.AsInteger);

      if vSaldoCreditoTroca <> 0 then
      begin
        qryDadosFiscais.edit;
        if vSaldoCreditoTroca > qryDadosFiscais.fieldbyname('valortotal').AsCurrency then
          qryDadosFiscais.FieldByName('creditotroca').asCurrency := qryDadosFiscais.fieldbyname('valortotal').AsCurrency
        else
          qryDadosFiscais.FieldByName('creditotroca').asCurrency := vSaldoCreditoTroca;

        qryDadosFiscais.post;

        qryProdutosTrocados.append;

        spcProdutosTrocadosProximo.Open;
        qryProdutosTrocadosnumero.AsInteger := spcProdutosTrocadosProximonumero.AsInteger;
        spcProdutosTrocadosProximo.close;

        qryProdutosTrocadostipo.AsString := 'S';
        qryProdutosTrocadosdata.Asdatetime := DataHoraServidor;
        qryProdutosTrocadoscliente.AsInteger := qryDadosFiscais.fieldbyname('cliente').asinteger;
        qryProdutosTrocadostipocliente.AsString := 'L';
        qryProdutosTrocadosfilial.asinteger := filialbase;
        qryProdutosTrocadosvalor.AsCurrency := qryDadosFiscais.FieldByName('creditotroca').asCurrency;
        qryProdutosTrocadosdefeito.AsBoolean := false;
        qryProdutosTrocadosusuario.AsInteger := CodigoUsuario;
        qryProdutosTrocadosreferencia.asString := 'NF TRANSF. VENDA. FILIAL ' + inttostr(filialbase)
                                                                  + ' SÉRIE ' + qryNotasserie.asString
                                                                  + ' N° ' + qryNotasnumero.asstring;
        qryProdutosTrocados.Post;
      end;
  end;


begin
  result := VerificarSerieFilial;
  if result then
  begin
    result := PreencherNotaFiscal;
    if result  then
    begin
//      ReFazConsulta(qryFilialDestino,[0],[Frequisitante], false);
      BloquearEstoque;

//      ValorPIS   := 0;
//      ValorCOFINS:= 0;

      PreencherDadoFiscal;
      IncluirMovimentos;
      AtualizarPedidosFiliais;

      result := CalcularImpostos(qryProdutos, qryDadosFiscais, ContribIPI,true, true, nil, nil, false, TransferenciaSaida);

      if result then
         result := ComplementoDadosFiscais;

      if result then
      begin
        refazconsulta(qryVenctosDadosFiscais,[],[]);
        case TipoNotaFiscalaEmitir of
          DevolucaoTransferencia : IncluirEntradaCreditoTrocaFilial;
          VendaTransferencia     :
          begin
            IncluirSaidaCreditoTrocaFilial;
            if qryDadosFiscais.fieldbyname('creditotroca').AsCurrency<>0 then
            begin
              qryVenctosDadosFiscais.Append;
              qryVenctosDadosFiscaisdadofiscal.AsInteger      := qryDadosFiscais.fieldByName('numero').AsInteger;
              qryVenctosDadosFiscaisnumero.AsInteger          := 1;
              qryVenctosDadosFiscaisdatavencto.AsDateTime     := qryDadosFiscais.fieldByName('data').AsDateTime;
              qryVenctosDadosFiscaisvalorvencto.AsCurrency    := qryDadosFiscais.fieldbyname('creditotroca').AsCurrency;

               if qryTiposRecebimentoscodigo.asinteger <> 0 then
                qryVenctosDadosFiscaistiporecebimento.asInteger := qryTiposRecebimentoscodigo.asinteger
              else
                qryVenctosDadosFiscaistiporecebimento.clear;

              qryVenctosDadosFiscaisformapagamento.AsString   := 'T';
              qryVenctosDadosFiscaistransacao.clear;
              qryVenctosDadosFiscais.Post;

              if ((qryDadosFiscais.fieldbyname('valortotal').AsCurrency - qryDadosFiscais.fieldbyname('creditotroca').AsCurrency) <> 0) then
              begin
                qryVenctosDadosFiscais.Append;
                qryVenctosDadosFiscaisdadofiscal.AsInteger      := qryDadosFiscais.fieldByName('numero').AsInteger;
                qryVenctosDadosFiscaisnumero.AsInteger          := 2;
                qryVenctosDadosFiscaisdatavencto.AsDateTime     := qryDadosFiscais.fieldByName('data').AsDateTime;
                qryVenctosDadosFiscaisvalorvencto.AsCurrency    := qryDadosFiscais.fieldbyname('valortotal').AsCurrency - qryDadosFiscais.fieldbyname('creditotroca').AsCurrency;
                qryVenctosDadosFiscaistiporecebimento.AsInteger := 1;
                qryVenctosDadosFiscaisformapagamento.AsString   := 'D';
                qryVenctosDadosFiscaistransacao.clear;
                qryVenctosDadosFiscais.Post;
              end;
            end
            else
            begin
              qryVenctosDadosFiscais.Append;
              qryVenctosDadosFiscaisdadofiscal.AsInteger      := qryDadosFiscais.fieldByName('numero').AsInteger;
              qryVenctosDadosFiscaisnumero.AsInteger          := 1;
              qryVenctosDadosFiscaisdatavencto.AsDateTime     := qryDadosFiscais.fieldByName('data').AsDateTime;
              qryVenctosDadosFiscaisvalorvencto.AsCurrency    := qryDadosFiscais.fieldbyname('valortotal').AsCurrency;
              qryVenctosDadosFiscaistiporecebimento.AsInteger := 1;
              qryVenctosDadosFiscaisformapagamento.AsString   := 'D';
              qryVenctosDadosFiscaistransacao.clear;
              qryVenctosDadosFiscais.Post;
            end;
          end;
        end;

        if CondicaoEmissorNFE then
           result := ImprimirNFE(true);

        if result then
        begin

          result := Perpetrar([qryDadosFiscais, qryVenctosDadosFiscais, qryNotas, qryMovimentos, qryProdutos,
                              qrySeriesFiliais, qryAtualizarPedidosFiliais, qryVolumesDadosFiscais, qryProdutosTrocados]);

          if result then
          begin
            if TipoNotaFiscalaEmitir = VendaTransferencia then
            begin
              qryFuncaoGerarContratoporDadoFiscal.close;
              qryFuncaoGerarContratoporDadoFiscal.ParamByName('dadofiscal').asinteger := qryDadosFiscais.FieldByName('numero').AsInteger;
              qryFuncaoGerarContratoporDadoFiscal.ParamByName('origem').asString := 'Transferencia';
              qryFuncaoGerarContratoporDadoFiscal.open;
              result := perpetrar([]);

              if result then
              begin
                if (qrydadosfiscais.RecordCount <> 0) then
                begin
                  qryDadosFiscais.edit;
                  qryDadosFiscais.fieldbyname('contrato').asstring := qryDadosFiscais.FieldByName('contratofrentecaixa').AsString;
                  qryDadosFiscais.FieldByName('contratofrentecaixa').clear;
                  qryDadosFiscais.post;
                  perpetrar([qryDadosFiscais]);
                end;
              end;
            end;

            if not CondicaoEmissorNFE then
            begin
              dtmImprimeFiscal := TdtmImprimeFiscal.Create(Self);
              try
                dtmImprimeFiscal.ImprimirNota(qryDadosFiscais.fieldbyname('numero').AsInteger, qrySeriesFiliaismodelonota.AsInteger);
              finally
                dtmImprimeFiscal.Free
              end;
            end
            else
              result := ImprimirNFE;
          end;
        end;

      end
      else Abort;

    end;
  end;
end;

procedure TdtmTransferenciaRequisicaoExposicao.ImprimirRequisicoes;
var
  Relatorio: TfrReport;
  frmPreview: TfrmPreviewPadrao;
begin
  vImprimindoRequisicoes := true;

  frVariables['Rua']   := RuaFilialBase;
  frVariables['Bairro']:= BairroFilialBase + ' - CEP: ' + CEPFilialBase;
  frVariables['Cidade']:= CidadeFilialBase + ' - ' + EstadoFilialBase;
  frVariables['Fone']  := FoneFilialBase;
  frVariables['Outras']:= RazaoFilialBase;
//  frpPedidosFiliais.DesignReport;
  frmPreview := TfrmPreviewPadrao.create(self);
  try
//   qryPedidosFiliais.Filtered := True;

   Relatorio := frmPreview.frCompositeReport;
   frmPreview.frCompositeReport.Reports.Clear;
   frmPreview.frCompositeReport.Reports.Add(frpPedidosFiliais);
   Relatorio.Preview := frmPreview.frPreviewPadrao;
   Relatorio.ShowReport;

   frmPreview.ShowModal;

  finally
   frmPreview.Free;
//   qryPedidosFiliais.Filtered := False;

   vImprimindoRequisicoes := false;
  end;
end;

procedure TdtmTransferenciaRequisicaoExposicao.IncluirMovimentos;
var
  SituacaoProduto : TtecComposicao;
//  Pos: TBookMark;
  Total: Currency;
  QuantidadeCompara: Currency;
  vProduto : String;
  vFilial : Integer;
begin
//  Pos := qryProdutos.GetBookmark;
  GuardarRegistroAtual(qryPedidosFiliais,True);
//  qryProdutos.DisableControls;
  try
    Total:= 0;
    for SituacaoProduto := stNAOCOMPOSTO to stCOMPOSTO do
    begin

      qryProdutos.First;

      while not qryProdutos.Eof do begin
        vProduto := qryProdutos.FieldByName('produto').AsString;
        vFilial := qryProdutos.FieldByName('filial').AsInteger;
        if FiltrarComposto(qryProdutos.FieldByName('composto').AsBoolean, SituacaoProduto) then
        begin
          if qryEstoqueBloqueio.Locate('produto;filial', VarArrayOf([vProduto,
                                                                     qryProdutos.FieldByName('filial').AsInteger]) ,[]) then
          begin
            if (ParSistema.RequisicaoSubtraiEstoque) then
              QuantidadeCompara:=qryEstoqueBloqueioreservaprevia.AsCurrency
            else
              QuantidadeCompara:=qryEstoqueBloqueioemestoque.AsCurrency;
            if (QuantidadeCompara >= qryProdutos.FieldByName('quantidade').AsCurrency) then
            begin
              NovoMovimento(vProduto, qryProdutos.FieldByName('filial').AsInteger);
              qryMovimentosquantidade.AsCurrency   := qryProdutos.FieldByName('quantidade').AsCurrency;
              if (ParSistema.RequisicaoSubtraiEstoque) then
                qryMovimentostipomovimento.AsString := 'SPT'
              else
                qryMovimentostipomovimento.AsString := 'SET';
              qryMovimentosreferencia.AsString    := 'NF-' + IntToStr(qryNotasnumero.AsInteger) +
                                                     ' S-' + SerieSugestao + ' TRANSFERENCIA';
              qryMovimentosvalor.AsCurrency       := truncar((qryMovimentosquantidade.AsCurrency *
                                                              qryProdutos.FieldByName('precovenda').AsCurrency),2);
              qryMovimentostrfproduto.AsString  := vProduto;
              qryMovimentostrffilial.AsInteger    := FFilialEstoqueRequisitante;
              qryMovimentosdadofiscal.AsInteger   := qryDadosFiscais.fieldbyname('numero').AsInteger;
              qryMovimentos.Post;

              Total:= Total + qryMovimentosvalor.AsCurrency;
              if qryPedidosFiliais.Locate('produto;filial_estoque', VarArrayOf([vproduto,vfilial]),[]) then
              begin
                //CASO TRABALHE COM RESERVA PRÉVIA A QUANTIDADE QUE NÃO FOI CONFIRMADA DEVERÁ VOLTAR PARA O ESTOQUE
                if (ParSistema.RequisicaoSubtraiEstoque) and
                   (qryProdutos.FieldByName('quantidade').AsCurrency < qryPedidosFiliaisqtdepedida.AsCurrency) and
                   (qryPedidosFiliaisqtderecebida.AsCurrency>0) then
                begin
                   NovoMovimento(qryPedidosFiliaisproduto.AsString,qryPedidosFiliaisfilial_estoque.AsInteger);
                   qryMovimentostipomovimento.AsString := 'TPE';
                   qryMovimentosquantidade.AsCurrency   := qryPedidosFiliaisqtdepedida.AsCurrency - qryProdutos.FieldByName('quantidade').AsCurrency;
                   qryMovimentosreferencia.AsString    := 'REQUISICAO '+qryPedidosFiliaiscodigo.AsString+' QTDE NAO CONFIRMADA';
                   qryMovimentos.Post;
                end;
              end;
            end
            else qryProdutos.Delete;
          end;
        end;
        qryProdutos.Next;
      end;
    end;

    qryDadosFiscais.Edit;
    qryDadosFiscais.fieldbyname('valorvista').AsCurrency:= Total;
    qryDadosFiscais.fieldbyname('valortotal').AsCurrency:= Total;
    qryDadosFiscais.Post;

  finally
    VoltarRegistroAtual(qryPedidosFiliais);
//    qryProdutos.GotoBookmark(Pos);
//    qryProdutos.FreeBookmark(Pos);
    qryProdutos.EnableControls
  end
end;

function TdtmTransferenciaRequisicaoExposicao.IncluirProdutos: Boolean;
begin
  result := true;
  if result then
  begin
    if (qryFilialDestinocodigo.asInteger <> Frequisitante) or (TipoNotaFiscalaEmitir = NaoEmitir) then
    begin
      ReFazConsulta(qryFilialDestino,[0],[Frequisitante], false);
      if not ehRaizCNPJ(qryFilialDestinocnpj.AsString) then
      begin
        case MensagemSimNaoOpcaoCancelar('Definição do tipo de nota fiscal.','',true,' NF de &Venda ',' Nfe de &Devolução ') of
          mrYes    : TipoNotaFiscalaEmitir := VendaTransferencia;
          mrNo     : TipoNotaFiscalaEmitir := DevolucaoTransferencia;
          mrCancel : begin
                       TipoNotaFiscalaEmitir := NaoEmitir;
                       result := false;
                     end;
        end;
      end
      else
        TipoNotaFiscalaEmitir := Transferencia;
    end;

    if result then
    begin
      qryProdutos.Insert;
      qryProdutos.FieldByName('produto').AsString    := qryPedidosFiliaisproduto.AsString;
      qryProdutos.FieldByName('filial').AsInteger      := FilialEstoque;
      qryProdutos.FieldByName('quantidade').AsCurrency := qryPedidosFiliaisqtderecebida.AsCurrency;
      qryProdutos.FieldByName('tribquantidade').AsCurrency := qryPedidosFiliaisqtderecebida.AsCurrency;
      AtribuirDadosProdutos(qryprodutos, nil, nil, false, TransferenciaSaida, qryProcuraFiliaisestado.asString );
      qryProdutos.FieldByName('quantidade').AsCurrency := qryPedidosFiliaisqtderecebida.AsCurrency;
      qryProdutos.FieldByName('tribquantidade').AsCurrency := qryPedidosFiliaisqtderecebida.AsCurrency;
      qryProdutos.FieldByName('codigopedidofilial').AsInteger:= qryPedidosFiliaiscodigo.AsInteger;
      qryProdutos.FieldByName('entregar').AsBoolean    := True;

      case TipoNotaFiscalaEmitir of
        Transferencia : AtribuirDadosCalculosImpostos(nil, qryDadosProdutos, nil, qryProdutos, TransferenciaSaida, false, noTRANSFERENCIAMERCADORIASSAIDA, qryProcuraFiliaisestado.asString);
        VendaTransferencia : AtribuirDadosCalculosImpostos(nil, qryDadosProdutos, nil, qryProdutos, TransferenciaSaida, true, noVENDAS_TRANSFERENCIA_ENTRE_EMPRESA, qryProcuraFiliaisestado.asString);
        DevolucaoTransferencia : AtribuirDadosCalculosImpostos(nil, qryDadosProdutos, nil, qryProdutos, TransferenciaSaida, true, noSAIDADEVOLUCAO_TRANSFERENCIA_ENTRE_EMPRESA, qryProcuraFiliaisestado.asString);
      end;

      if (qryProdutos.FieldByName('precovenda').AsCurrency=0)  then
      begin
        result := false;
        MensagemAviso('Produto  '+ qryPedidosFiliaisproduto.AsString +' com custo zerado!');
      end
      else
        qryProdutos.Post;
    end;
  end;
end;

procedure TdtmTransferenciaRequisicaoExposicao.InicializarTabelas;
begin
  if qryDadosFiscais.Active then
    qryDadosFiscais.Close;
  qryDadosFiscais.Open;

  if qryNotas.Active then
    qryNotas.Close;
  qryNotas.Open;

  if qryProdutos.Active then
    qryProdutos.Close;
  qryProdutos.Open;

{  if qryCalculos.Active then
    qryCalculos.Close;
  qryCalculos.Open;}

  if qryMovimentos.Active then
    qryMovimentos.Close;
  qryMovimentos.Open;

  if qryEstoques.Active then
    qryEstoques.Close;
  qryEstoques.Open;

  if qryVolumesDadosFiscais.Active then
    qryVolumesDadosFiscais.Close;
  qryVolumesDadosFiscais.Open;
end;

procedure TdtmTransferenciaRequisicaoExposicao.MontaIntervaloData;
const
  Data_1: String = 'and (cast(pf.data as date) = ';
  Data_2: String = 'and (cast(pf.data as date) between (';
begin
  if not DataEmBranco(FDataInicial) then begin
    if DataEmBranco(FDataFinal) then
         qryPedidosFiliais.macrobyname('Periodo').asstring := Data_1 + '''' + FDataInicial + ''')'
    else qryPedidosFiliais.macrobyname('Periodo').asstring := Data_2 + '''' + FDataInicial + ''') and (''' + FDataFinal + '''))';
  end
  else begin
    if not DataEmBranco(FDataFinal) then
         qryPedidosFiliais.macrobyname('Periodo').asstring := Data_1 + '''' + FDataFinal + ''')'
    else qryPedidosFiliais.macrobyname('Periodo').asstring := '';
  end;
end;

procedure TdtmTransferenciaRequisicaoExposicao.NovoMovimento(Produto: String; Filial: Integer);
begin
  qryMovimentos.Append;
  spcMovimentosProximo.Open;
  qryMovimentosnumero.AsInteger := spcMovimentosProximonumero.AsInteger;
  spcMovimentosProximo.Close;
  qryMovimentosproduto.AsString   := Produto;
  qryMovimentosfilial.AsInteger     := Filial;
  qryMovimentoscliente.AsInteger    := Filial;
  qryMovimentostipocliente.AsString := 'L';
end;

function TdtmTransferenciaRequisicaoExposicao.NovoNumeroDadoFiscal: Integer;
begin
  spcDadosFiscaisProximo.Open;
  Result := spcDadosFiscaisProximonumero.AsInteger;
  spcDadosFiscaisProximo.Close;
end;


function TdtmTransferenciaRequisicaoExposicao.PreencherNotaFiscal: Boolean;
begin
  qryNotas.Append;
  qryNotasfilial.AsInteger            := FilialBase;
  qryNotasserie.AsString              := SerieSugestao;
  qryNotasnumero.AsInteger            := qrySeriesFiliaisnumeroinicial.AsInteger;

  qrySeriesFiliais.Edit;
  qrySeriesFiliaisnumeroinicial.AsInteger := qrySeriesFiliaisnumeroinicial.AsInteger + 1;
  qrySeriesFiliais.Post;

  if qrySeriesFiliaisnumeroinicial.AsInteger <= qrySeriesFiliaisnumerofinal.AsInteger then
    Result := True
  else
    Result := MensagemAviso(Format(ctSERIEESGOTADA, [qrySeriesFiliaisnumerofinal.AsString]) + #13#10 + ctCONFIRMEINPRESSAO) = smbOK;
end;

