procedure TdtmTransferenciaRequisicaoExposicao.GravarInformacoesFornecedorTransporte;
begin
  FillChar(TranspNotaFiscal,SizeOf(TranspNotaFiscal),0);
  with TranspNotaFiscal do begin
    FornecedorTransporte := qryDadosFiscais.fieldbyname('FornecedorTransporte').AsInteger;
    TipoFrete            := qryDadosFiscais.fieldbyname('frete').AsString;
    TipoTransp           := qryDadosFiscais.fieldbyname('viatransporte').AsString;
    EstadoPlaca          := Trim(qryDadosFiscais.fieldbyname('estadoplaca').AsString);
    Placa                := Trim(qryDadosFiscais.fieldbyname('placa').AsString);
    Observacao           := qryDadosFiscais.fieldbyname('observacoes').AsString;
    Volumes              := qryVolumesDadosFiscaisvolumes.AsInteger;
    PesoBruto            := qryVolumesDadosFiscaispesobruto.AsFloat;
    PesoLiquido          := qryVolumesDadosFiscaispesoliquido.AsFloat;
    Numeracao            := Trim(qryVolumesDadosFiscaisnumeracao.AsString);
    Marca                := Trim(qryVolumesDadosFiscaismarca.AsString);
    EspecieTransporte    := Trim(qryVolumesDadosFiscaisespecietransporte.AsString);
  end;
end;

