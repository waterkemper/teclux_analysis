    Sql.Strings = (
      'Select   e.produto,'
      '         p.codigovisual as produtovisual,'
      '         e.filial,'
      '         (Select e1.emestoque'
      '          From estoques e1'
      '          Where e1.produto = e.produto'
      
        '          and e1.filial =CASE WHEN (select tipofilial from filia' +
        'is where codigo=:requisitante)='#39'V'#39' THEN COALESCE((select filial_' +
        'estoque from filiais where codigo=:requisitante),:requisitante) ' +
        'ELSE :requisitante END) as estoquerequisitante,'
      '         e.emestoque as estoquerequisitada,'
      
        '         cast(p.descricao||'#39' '#39'||coalesce(p.valorgrade1,'#39#39')||'#39' '#39'|' +
        '|coalesce(p.valorgrade2,'#39#39') as varchar) as descricao,'
      '         c.unidade,'
      
        '         case when f.tipofilial='#39'V'#39' THEN COALESCE(f.filial_estoq' +
        'ue,f.codigo) ELSE f.codigo END as filial_estoque'
      'From     estoques e, produtos p, caracteristicas c,filiais f'
      '//Where p.codigovisual = :produtovisual'
      ''
      
        'where ( upper(pg_catalog.to_ascii(p.codigovisual,'#39'latin1'#39')) = up' +
        'per(pg_catalog.to_ascii(:produtovisual,'#39'latin1'#39')) or'
      ''
      #9#9'p.codigo in (select pcb.produto'
      '                      from produtoscodigobarras pcb'
      '                      where pcb.codigobarras = :produtovisual)'
      ''
      #9'   )'
      '  and f.codigo=:requisitada'
      
        '  and e.filial = CASE WHEN f.tipofilial='#39'V'#39' THEN coalesce(f.fili' +
        'al_estoque,:requisitada) ELSE :requisitada END'
      '  and e.produto = p.codigo'
      '  and p.caracteristica = c.codigo'
      ''
      '%SQLCondicaoCompostos')
