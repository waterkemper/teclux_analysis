package interlojask;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$SONAME 'interlojas'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  baseclx,
  visualclx,
  repositoriok;

contains
  fmrequisicaoexposicao in 'fmrequisicaoexposicao.pas' {frmRequisicaoExposicao},
  dmrequisicaoexposicao in 'dmrequisicaoexposicao.pas' {dtmRequisicaoExposicao: TDataModule},
  rginterlojas in 'rginterlojas.pas',
  fmconsultarequisicaoexposicao in 'fmconsultarequisicaoexposicao.pas' {frmConsultaRequisicaoExposicao},
  dmconsultarequisicaoexposicao in 'dmconsultarequisicaoexposicao.pas' {dtmConsultaRequisicaoExposicao: TDataModule},
  fmconsultaprodutosadquiridos in 'fmconsultaprodutosadquiridos.pas' {frmConsultaProdutosAdquiridos},
  dmconsultaprodutosadquiridos in 'dmconsultaprodutosadquiridos.pas' {dtmConsultaProdutosAdquiridos: TDataModule},
  fmtransferenciarequisicaoexposicao in 'fmtransferenciarequisicaoexposicao.pas' {frmTransferenciaRequisicaoExposicao},
  dmtransferenciarequisicaoexposicao in 'dmtransferenciarequisicaoexposicao.pas' {dtmTransferenciaRequisicaoExposicao: TDataModule},
  fmconfirmarnotastransferencia in 'fmconfirmarnotastransferencia.pas' {frmConfirmarNotasTransferencia},
  dmconfirmarnotastransferencia in 'dmconfirmarnotastransferencia.pas' {dtmConfirmarNotasTransferencia: TDataModule},
  fmconfirmarnotastransferenciaporitem in 'fmconfirmarnotastransferenciaporitem.pas' {frmConfirmarNotasTransferenciaPorItem},
  dmconfirmarnotastransferenciaporitem in 'dmconfirmarnotastransferenciaporitem.pas' {dtmConfirmarNotasTransferenciaPorItem: TDataModule},
  fmdadostransportador in 'fmdadostransportador.pas' {frmDadosTransportador};

end.
