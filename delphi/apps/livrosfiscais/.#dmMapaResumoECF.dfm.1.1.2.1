  object qryMapaResumoDetalhes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkFields = 
      'filial = filial; numerousuario=numerousuario; cro = cro; numerof' +
      'abricacao = numerofabricacao; datamovimento = datamovimento'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrMapaResumoECF
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select detalhes.*'
      'FROM'
      '('
      '('
      
        'select rzd.filial, rzd.numerousuario, rzd.cro, rzd.numerofabrica' +
        'cao, rzd.datamovimento,'
      '       rzd.aliquota, rzd.valoracumulado as valortributado,'
      ''
      '     (select sum(rzdi.valoracumulado)'
      '      from reducoeszdetalhes rzdi'
      '      where rzdi.filial = rzd.filial'
      '       and rzdi.numerousuario = rzd.numerousuario'
      '       and rzdi.cro = rzd.cro'
      '       and rzdi.numerofabricacao = rzd.numerofabricacao'
      '       and rzdi.datamovimento = rzd.datamovimento'
      '       and rzdi.tipototalizadorparcial='#39'I1'#39') as isentas,'
      ''
      '     (select sum(rzdi.valoracumulado)'
      '      from reducoeszdetalhes rzdi'
      '      where rzdi.filial = rzd.filial'
      '       and rzdi.numerousuario = rzd.numerousuario'
      '       and rzdi.cro = rzd.cro'
      '       and rzdi.numerofabricacao = rzd.numerofabricacao'
      '       and rzdi.datamovimento = rzd.datamovimento'
      '       and rzdi.tipototalizadorparcial='#39'N1'#39') as naotributadas,'
      ''
      '     (select sum(rzdi.valoracumulado)'
      '      from reducoeszdetalhes rzdi'
      '      where rzdi.filial = rzd.filial'
      '       and rzdi.numerousuario = rzd.numerousuario'
      '       and rzdi.cro = rzd.cro'
      '       and rzdi.numerofabricacao = rzd.numerofabricacao'
      '       and rzdi.datamovimento = rzd.datamovimento'
      '       and rzdi.tipototalizadorparcial='#39'F1'#39') as outras'
      ''
      'from reducoesz rz'
      '     join filiais f'
      '          join cidades c'
      '          on f.cidade = c.codigo'
      '          and f.estado = c.estado'
      '     on rz.filial = f.codigo'
      ''
      '     join reducoeszdetalhes rzd'
      '     on rz.filial = rzd.filial'
      '     and rz.numerousuario = rzd.numerousuario'
      '     and rz.cro = rzd.cro'
      '     and rz.numerofabricacao = rzd.numerofabricacao'
      '     and rz.datamovimento = rzd.datamovimento'
      ''
      'where rz.datamovimento between :datainicial and :datafinal'
      '  and coalesce(rzd.aliquota,0)<>0'
      '  and rzd.aliquota = (select min(rzdi.aliquota)'
      '                       from reducoeszdetalhes rzdi'
      '                       where rzdi.filial = rzd.filial'
      
        '                         and rzdi.numerousuario = rzd.numerousua' +
        'rio'
      '                         and rzdi.cro = rzd.cro'
      
        '                         and rzdi.numerofabricacao = rzd.numerof' +
        'abricacao'
      
        '                         and rzdi.datamovimento = rzd.datamovime' +
        'nto'
      '                         and coalesce(rzdi.aliquota,0)<>0)'
      ''
      ''
      ')'
      ''
      'union all'
      ''
      '('
      
        'select rzd.filial, rzd.numerousuario, rzd.cro, rzd.numerofabrica' +
        'cao, rzd.datamovimento,'
      '     rzd.aliquota, rzd.valoracumulado as valortributado,'
      '     0.00 as isentas,'
      '     0.00 as naotributadas,'
      '     0.00 as outras'
      ''
      'from reducoesz rz'
      '     join filiais f'
      '          join cidades c'
      '          on f.cidade = c.codigo'
      '          and f.estado = c.estado'
      '     on rz.filial = f.codigo'
      ''
      '     join reducoeszdetalhes rzd'
      '     on rz.filial = rzd.filial'
      '     and rz.numerousuario = rzd.numerousuario'
      '     and rz.cro = rzd.cro'
      '     and rz.numerofabricacao = rzd.numerofabricacao'
      '     and rz.datamovimento = rzd.datamovimento'
      ''
      'where rz.datamovimento between :datainicial and :datafinal'
      '  and coalesce(rzd.aliquota,0)<>0'
      '  and rzd.aliquota <> (select min(rzdi.aliquota)'
      '                       from reducoeszdetalhes rzdi'
      '                       where rzdi.filial = rzd.filial'
      
        '                         and rzdi.numerousuario = rzd.numerousua' +
        'rio'
      '                         and rzdi.cro = rzd.cro'
      
        '                         and rzdi.numerofabricacao = rzd.numerof' +
        'abricacao'
      
        '                         and rzdi.datamovimento = rzd.datamovime' +
        'nto'
      '                         and coalesce(rzdi.aliquota,0)<>0)'
      'order by rzd.aliquota'
      ')'
      ') as detalhes'
      
        'order by filial, datamovimento, numerousuario, cro, numerofabric' +
        'acao, aliquota')
    RequestLive = False
    Active = True
    Left = 96
    Top = 112
    ParamData = <
      item
        DataType = ftString
        Name = 'datainicial'
        ParamType = ptUnknown
        Value = '2014-01-01'
      end
      item
        DataType = ftString
        Name = 'datafinal'
        ParamType = ptUnknown
        Value = '2014-09-05'
      end>
