    Sql.Strings = (
      'select rz.filial, rz.numerousuario, rz.cro,'
      '       rz.datamovimento, cast(null as integer) as numeracao,'
      
        '       f.nome as nomefilial, f.rua, f.numero as numerorua, c.nom' +
        'e as nomecidade, f.estado,'
      
        '       f.cnpj, f.inscricaomunicipal, f.inscricaoestadual, rz.num' +
        'erofabricacao,'
      '       rz.crz,'
      '       rz.vendabrutadiaria -'
      '       (select sum(rzd.valoracumulado)'
      '        from reducoeszdetalhes rzd'
      '        where rzd.filial = rz.filial'
      '          and rzd.numerousuario = rz.numerousuario'
      '          and rzd.cro = rz.cro'
      '          and rzd.numerofabricacao = rz.numerofabricacao'
      '          and rzd.datamovimento = rz.datamovimento'
      
        '          and rzd.tipototalizadorparcial in ('#39'DT'#39', '#39'Can-T'#39')) as ' +
        'valorcontabil'
      'from reducoesz rz'
      '     join filiais f'
      '          join cidades c'
      '          on f.cidade = c.codigo'
      '          and f.estado = c.estado'
      '     on rz.filial = f.codigo'
      'where rz.datamovimento between :datainicial and :datafinal'
      
        '  order by  rz.filial, rz.datamovimento, rz.numerousuario, rz.cr' +
        'o, rz.crz')
