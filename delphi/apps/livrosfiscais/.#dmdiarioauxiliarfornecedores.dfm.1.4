  object qryDiarioAuxiliarFornecedores: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'FilialEmissao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FilialPagamento'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '('
      'select cast('#39'01/01/1900'#39' as date) as emissao,'
      '       cast('#39'01/01/1900'#39' as date) as datalancto,'
      '       cast(null as integer) as documentopag,'
      '       cast(null as varchar(40)) as nomefornecedor,'
      '       cast(null as integer) as fornecedor,'
      '       cast(null as varchar(15)) as codigodaconta,'
      '       0 as codigodaconta_ordem,'
      
        '       cast('#39'SALDO ANTERIOR'#39' as varchar(125)) as descricaoevento' +
        ','
      '       case when :saldodebito>:saldocredito then'
      '           :saldodebito - :saldocredito'
      '       end as debito,'
      '       case when :saldocredito>=:saldodebito then'
      '           :saldocredito - :saldodebito'
      '       end as credito'
      ')'
      'union all'
      '('
      ' select dp.emissao,'
      '       dp.datalancto,'
      '       dp.numero as documentopag,'
      '       coalesce(vf.razao,vf.nome) as nomefornecedor,'
      '       dp.fornecedor,'
      '       cast(:FORNECEDOR as varchar(100)) as codigodaconta,'
      '       1 as codigodaconta_ordem,'
      ''
      '       cast((case when f.tipofornecimento[1]='#39'T'#39' then'
      '         '#39'SERVI'#199'O DE TRANSPORTE CFE CF '#39
      '             when mod((select np.codigofiscal'
      '                    from notaspag np'
      
        '                    where np.documentopag = dp.numero),1000) in ' +
        '(101,102,103,401,402,403) then'
      '         '#39'COMPRA DE MERCADORIAS CFE NF '#39
      '        else'
      '         '#39'REF. NF '#39
      
        '        end)||dp.complemento as varchar(125)) as descricaoevento' +
        ','
      ''
      '       cast(null as numeric) as debito,'
      '       dp.valor as credito'
      ''
      ' from documentospag dp'
      ''
      '     left join fornecedores f'
      '     on dp.fornecedor = f.codigo'
      ''
      '     join vfornecedores vf'
      '     on dp.fornecedor = vf.codigo'
      '        and dp.tipofornecedor = vf.tipo'
      ''
      ' where dp.datalancto between :datainicial and :datafinal'
      ' %FilialEmissao'
      ')'
      'union all'
      '('
      'select d.datapagto as emissao,'
      '       d.datapagto as datalancto,'
      '       dp.numero as documentopag,'
      '       coalesce(vf.razao,vf.nome) as nomefornecedor,'
      '       dp.fornecedor,'
      '       cast(:FORNECEDOR as varchar(100)) as codigodaconta,'
      '       2 as codigodaconta_ordem,'
      '       case when d.tipopagamento is null  or'
      '                (select tp.saidadocaixa'
      '                 from tipospagamentos tp'
      '                 where tp.codigo = d.tipopagamento) then'
      
        '         cast('#39'PAGTO DUPLICATA '#39'||coalesce(dp.complemento,'#39#39')||'#39 +
        '-'#39'||chr(64+d.numero) as varchar(125))'
      '       else'
      
        '         case when d.contapagto is not null and d.chequepagto is' +
        ' not null then'
      
        '           cast('#39'PAGTO DUPLICATA '#39'||coalesce(dp.complemento,'#39#39')|' +
        '|'#39'-'#39'||chr(64+d.numero)||'#39'*'#39'||'
      '               coalesce((select b.sigla'
      '                from bancos b'
      '                where b.codigo = (select c.banco'
      '                                  from contas c'
      
        '                                  where c.conta = d.contapagto) ' +
        'limit 1),'#39#39')||'
      
        '               cast(d.contapagto as varchar)||'#39'-'#39'||coalesce((sel' +
        'ect c.digito'
      '                                   from contas c'
      
        '                                   where c.conta = d.contapagto)' +
        ','#39#39')||'#39'*CH '#39'||'
      '               cast(d.chequepagto as varchar) as varchar(125))'
      '         else'
      '           case when d.contapagto is not null then'
      
        '             cast('#39'PAGTO DUPLICATA '#39'||coalesce(dp.complemento,'#39#39 +
        ')||'#39'-'#39'||chr(64+d.numero)||'#39'*'#39'||'
      '                 coalesce((select b.sigla'
      '                  from bancos b'
      '                  where b.codigo = (select c.banco'
      '                                  from contas c'
      
        '                                  where c.conta = d.contapagto) ' +
        'limit 1),'#39#39')||'
      
        '                 cast(d.contapagto as varchar)||'#39'-'#39'||coalesce((s' +
        'elect c.digito'
      '                                     from contas c'
      
        '                                     where c.conta = d.contapagt' +
        'o),'#39#39') as varchar(125))'
      '           else'
      '             case when d.chequepagto is not null then'
      
        '               cast('#39'PAGTO DUPLICATA '#39'||coalesce(dp.complemento,' +
        #39#39')||'#39'-'#39'||chr(64+d.numero)||'#39'*'#39'||'
      
        '                   '#39'*CH '#39'||cast(d.chequepagto as varchar) as var' +
        'char(125))'
      '             end'
      '           end'
      '         end'
      '       end as descricaoevento,'
      ''
      '       d.valorvencto as debito,'
      '       cast(null as numeric) as credito'
      'from duplicatas d'
      '     join documentospag dp'
      ''
      #9'  left join vfornecedores vf'
      '          on dp.fornecedor = vf.codigo'
      #9'     and dp.tipofornecedor = vf.tipo'
      ''
      '     on d.documentopag = dp.numero'
      ''
      'where d.datapagto between :datainicial and :datafinal'
      '  %FilialPagamento'
      ')'
      'union all'
      '('
      'select d.datapagto as emissao,'
      '       d.datapagto as datalancto,'
      '       dp.numero as documentopag,'
      '       coalesce(vf.razao,vf.nome) as nomefornecedor,'
      '       dp.fornecedor,'
      '       cast(:JUROS as varchar(100)) as codigodaconta,'
      '       3 as codigodaconta_ordem,'
      
        '       cast('#39'PAGTO JUROS DUPLICATA '#39'||dp.complemento||'#39'-'#39'||chr(6' +
        '4+d.numero) as varchar(125)) as descricaoevento,'
      '       d.valorpagto - d.valorvencto as debito,'
      '       cast(null as numeric) as credito'
      'from duplicatas d'
      '     join documentospag dp'
      ''
      #9'  join vfornecedores vf'
      '          on dp.fornecedor = vf.codigo'
      #9'     and dp.tipofornecedor = vf.tipo'
      ''
      '          left join eventos e'
      '          on dp.evento = e.codigo'
      ''
      '     on d.documentopag = dp.numero'
      'where d.datapagto between :datainicial and :datafinal'
      '   and d.valorvencto < d.valorpagto'
      '  %FilialPagamento'
      ')'
      'union all'
      '('
      'select d.datapagto as emissao,'
      '       d.datapagto as datalancto,'
      '       dp.numero as documentopag,'
      '       coalesce(vf.razao,vf.nome) as nomefornecedor,'
      '       dp.fornecedor,'
      '       cast(:DESCONTOS as varchar(100)) as codigodaconta,'
      '       4 as codigodaconta_ordem,'
      
        '       cast('#39'RECBTO DESCONTO DUPLICATA '#39'||dp.complemento||'#39'-'#39'||c' +
        'hr(64+d.numero) as varchar(125)) as descricaoevento,'
      '       cast(null as numeric) as debito,'
      '       d.valorvencto - d.valorpagto as credito'
      'from duplicatas d'
      '     join documentospag dp'
      ''
      #9'  join vfornecedores vf'
      '          on dp.fornecedor = vf.codigo'
      #9'     and dp.tipofornecedor = vf.tipo'
      ''
      '     on d.documentopag = dp.numero'
      'where d.datapagto between :datainicial and :datafinal'
      '   and d.valorvencto > d.valorpagto'
      '  %FilialPagamento'
      ')'
      
        'order by datalancto, codigodaconta_ordem, documentopag, forneced' +
        'or')
    RequestLive = True
    Left = 64
    Top = 136
    ParamData = <
      item
