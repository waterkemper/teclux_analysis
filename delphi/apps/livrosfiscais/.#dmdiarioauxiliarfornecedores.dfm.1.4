    Sql.Strings = (
      '('
      'select cast('#39'01/01/1900'#39' as date) as emissao,'
      '          cast('#39'01/01/1900'#39' as date) as datalancto,'
      '          cast(null as integer) as notafiscal,'
      '          cast(null as integer) as documentopag,'
      '          cast(null as varchar(40)) as fornecedor,'
      '          null as contrapartida,'
      '          '#39'SALDO ANTERIOR'#39' as historico,'
      '          case when :saldodebito>:saldocredito then'
      '             :saldodebito - :saldocredito'
      '          end as debito,'
      '          case when :saldocredito>=:saldodebito then'
      '             :saldocredito - :saldodebito'
      '          end as credito'
      ')'
      'union all'
      '('
      'select dp.emissao,'
      '       dp.emissao as datalancto,'
      '       np.numero as notafiscal,'
      '       dp.numero as documentopag,'
      '       coalesce(vf.razao,vf.nome) as fornecedor,'
      '       (case when f.tipofornecimento[1]='#39'T'#39' then'
      '          '#39'80845 - FRETES E CARRETOS'#39
      
        ' '#9'else '#39'61409 - MERCADORIAS COMPRAS'#39' end) as contrapartida,     ' +
        '  '
      ''
      '       (case when np.documentopag is null then'
      
        '          (case when vf.tipo<>'#39'F'#39' then '#39'DOC. '#39'||dp.numero||'#39' FOR' +
        'NECEDOR: '#39'||vf.tipo||vf.codigo'
      
        '           else '#39'DOC. '#39'||dp.numero||'#39' FORNECEDOR: '#39'||vf.codigo e' +
        'nd)'
      '        else '
      '          (case when vf.tipo<>'#39'F'#39' then '
      
        '             '#39'NF. '#39'||np.numero||'#39' SERIE '#39'||np.serie||'#39' FORNECEDO' +
        'R: '#39'||vf.tipo||vf.codigo'
      
        '           else  '#39'NF. '#39'||np.numero||'#39' SERIE '#39'||np.serie||'#39' FORNE' +
        'CEDOR: '#39'||vf.codigo end)'
      '       end) as historico,'
      ''
      '       cast(null as numeric) as debito,'
      '       dp.valor as credito'
      
        'from (((documentospag dp left join fornecedores f on dp.forneced' +
        'or = f.codigo)'
      
        '                         left join notaspag np on dp.numero = np' +
        '.documentopag)'
      #9#9#9'      join vfornecedores vf on dp.fornecedor = vf.codigo'
      #9#9#9'                           and dp.tipofornecedor = vf.tipo)'
      'where dp.emissao between :datainicial and :datafinal'
      '%FilialEmissao'
      ')'
      'union all'
      '('
      'select d.datapagto as emissao,'
      #9'd.datapagto as datalancto,'
      '       np.numero as notafiscal,'
      '       dp.numero as documentopag,'
      '       coalesce(vf.razao,vf.nome) as fornecedor,'
      '       '#39'60003 - CAIXA'#39'  as contrapartida,'
      '       (case when np.documentopag is null then'
      
        '          (case when vf.tipo<>'#39'F'#39' then '#39'PAGTO DUP. '#39'||d.numero||' +
        #39' DOC. '#39'||d.documentopag||'#39' FORNECEDOR: '#39'||vf.tipo||vf.codigo'
      
        '           else '#39'PAGTO DUP. '#39'||d.numero||'#39' DOC. '#39'||d.documentopa' +
        'g||'#39' FORNECEDOR: '#39'||vf.codigo end)'
      '        else '
      '          (case when vf.tipo<>'#39'F'#39' then '
      
        '             '#39'PAGTO DUP. '#39'||d.numero||'#39' NF. '#39'||np.numero||'#39' SERI' +
        'E '#39'||np.serie||'#39' FORNECEDOR: '#39'||vf.tipo||vf.codigo'
      
        '           else  '#39'PAGTO DUP. '#39'||d.numero||'#39' NF. '#39'||np.numero||'#39' ' +
        'SERIE '#39'||np.serie||'#39' FORNECEDOR: '#39'||vf.codigo end)'
      '       end) as historico,'
      '        d.valorvencto as debito,'
      #9'cast(null as numeric) as credito'
      
        'from (duplicatas d join (((documentospag dp left join fornecedor' +
        'es f on dp.fornecedor = f.codigo)'
      
        '                                            left join notaspag n' +
        'p on dp.numero = np.documentopag)'
      
        #9#9'            '#9#9#9' join vfornecedores vf on dp.fornecedor = vf.co' +
        'digo'
      
        #9#9#9'                                              and dp.tipoforn' +
        'ecedor = vf.tipo)'
      #9#9#9#9#9'    on d.documentopag = dp.numero)'
      'where d.datapagto between :datainicial and :datafinal'
      '   and d.datapagto is not null'
      '   and d.valorvencto = d.valorpagto'
      '  %FilialPagamento'
      ')'
      'union all'
      '('
      'select d.datapagto as emissao,'
      #9'd.datapagto as datalancto,'
      '       np.numero as notafiscal,'
      '       dp.numero as documentopag,'
      '       coalesce(vf.razao,vf.nome) as fornecedor,'
      #9#39'83909 - JUROS'#39'  as contrapartida,'
      '       (case when np.documentopag is null then'
      
        '          (case when vf.tipo<>'#39'F'#39' then '#39'PAGTO JUROS '#39'||d.numero|' +
        '|'#39' DOC. '#39'||d.documentopag||'#39' FORNECEDOR: '#39'||vf.tipo||vf.codigo'
      
        '           else '#39'PAGTO JUROS '#39'||d.numero||'#39' DOC. '#39'||d.documentop' +
        'ag||'#39' FORNECEDOR: '#39'||vf.codigo end)'
      '        else '
      '          (case when vf.tipo<>'#39'F'#39' then '
      
        '             '#39'PAGTO JUROS. '#39'||d.numero||'#39' NF. '#39'||np.numero||'#39' SE' +
        'RIE '#39'||np.serie||'#39' FORNECEDOR: '#39'||vf.tipo||vf.codigo'
      
        '           else  '#39'PAGTO JUROS '#39'||d.numero||'#39' NF. '#39'||np.numero||'#39 +
        ' SERIE '#39'||np.serie||'#39' FORNECEDOR: '#39'||vf.codigo end)'
      '       end) as historico,'
      '        d.valorpagto - d.valorvencto as debito,'
      #9'cast(null as numeric) as credito'
      
        'from (duplicatas d join (((documentospag dp left join fornecedor' +
        'es f on dp.fornecedor = f.codigo)'
      
        '                                            left join notaspag n' +
        'p on dp.numero = np.documentopag)'
      
        #9#9'            '#9#9#9' join vfornecedores vf on dp.fornecedor = vf.co' +
        'digo'
      
        #9#9#9'                                              and dp.tipoforn' +
        'ecedor = vf.tipo)'
      #9#9#9#9#9'    on d.documentopag = dp.numero)'
      'where d.datapagto between :datainicial and :datafinal'
      '   and d.datapagto is not null'
      '   and d.valorvencto < d.valorpagto'
      '  %FilialPagamento'
      ')'
      'union all'
      '('
      'select d.datapagto as emissao,'
      #9'd.datapagto as datalancto,'
      '       np.numero as notafiscal,'
      '       dp.numero as documentopag,'
      '       coalesce(vf.razao,vf.nome) as fornecedor,'
      #9#39'87700 - DESCONTO'#39'  as contrapartida,'
      '       (case when np.documentopag is null then'
      
        '          (case when vf.tipo<>'#39'F'#39' then '#39'DESCONTO DUP. '#39'||d.numer' +
        'o||'#39' DOC. '#39'||d.documentopag||'#39' FORNECEDOR: '#39'||vf.tipo||vf.codigo'
      
        '           else '#39'DESCONTO DUP. '#39'||d.numero||'#39' DOC. '#39'||d.document' +
        'opag||'#39' FORNECEDOR: '#39'||vf.codigo end)'
      '        else '
      '          (case when vf.tipo<>'#39'F'#39' then '
      
        '             '#39'DESCONTO DUP. '#39'||d.numero||'#39' NF. '#39'||np.numero||'#39' S' +
        'ERIE '#39'||np.serie||'#39' FORNECEDOR: '#39'||vf.tipo||vf.codigo'
      
        '           else  '#39'DESCONTO DUP. '#39'||d.numero||'#39' NF. '#39'||np.numero|' +
        '|'#39' SERIE '#39'||np.serie||'#39' FORNECEDOR: '#39'||vf.codigo end)'
      '       end) as historico,'
      '        d.valorvencto - d.valorpagto as debito,'
      #9'cast(null as numeric) as credito'
      
        'from (duplicatas d join (((documentospag dp left join fornecedor' +
        'es f on dp.fornecedor = f.codigo)'
      
        '                                            left join notaspag n' +
        'p on dp.numero = np.documentopag)'
      
        #9#9'            '#9#9#9' join vfornecedores vf on dp.fornecedor = vf.co' +
        'digo'
      
        #9#9#9'                                              and dp.tipoforn' +
        'ecedor = vf.tipo)'
      #9#9#9#9#9'    on d.documentopag = dp.numero)'
      'where d.datapagto between :datainicial and :datafinal'
      '   and d.datapagto is not null'
      '   and d.valorvencto > d.valorpagto'
      '  %FilialPagamento'
      ')'
      'order by emissao, notafiscal, documentopag, fornecedor')
