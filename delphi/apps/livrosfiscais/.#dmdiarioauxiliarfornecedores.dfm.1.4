  object qryCodigosEmitentes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'FilialEmissao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FilialPagamento'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'select * from'
      '('
      
        'select distinct fornecedor, tipofornecedor, nome, estado, cnpj, ' +
        'inscricaoestadual'
      ' from'
      '('
      '  ('
      '   select distinct'
      '     dp.fornecedor,'
      '     dp.tipofornecedor,'
      '     coalesce(vf.razao, vf.nome) as nome,'
      '     coalesce(np.estado, vf.estado) as estado,'
      '     formatar_cpf_cnpj(coalesce(np.cnpj,vf.cnpj)) as cnpj,'
      
        '     coalesce(np.inscricaoestadual,vf.inscricaoestadual) as insc' +
        'ricaoestadual'
      ''
      '   from documentospag dp'
      '       left join notaspag np'
      '       on dp.numero = np.documentopag'
      ''
      '       join vfornecedores vf'
      '       on dp.fornecedor = vf.codigo'
      '          and dp.tipofornecedor = vf.tipo'
      ''
      '   where dp.datalancto between :datainicial and :datafinal'
      '   %FilialEmissao'
      '  )'
      '  union'
      '  ('
      '  select distinct'
      '     dp.fornecedor,'
      '     dp.tipofornecedor,'
      '     coalesce(vf.razao, vf.nome) as nome,'
      '     coalesce(np.estado, vf.estado) as estado,'
      '     formatar_cpf_cnpj(coalesce(np.cnpj,vf.cnpj)) as cnpj,'
      
        '     coalesce(np.inscricaoestadual,vf.inscricaoestadual) as insc' +
        'ricaoestadual'
      ''
      '  from duplicatas d'
      '       join documentospag dp'
      ''
      '            left join notaspag np'
      '            on dp.numero = np.documentopag'
      ''
      '            left join vfornecedores vf'
      '            on dp.fornecedor = vf.codigo'
      '               and dp.tipofornecedor = vf.tipo'
      ''
      '       on d.documentopag = dp.numero'
      ''
      '  where d.datapagto between :datainicial and :datafinal'
      '    %FilialPagamento'
      '  )'
      ') as temp'
      
        'ORDER by fornecedor, tipofornecedor, nome, estado, cnpj, inscric' +
        'aoestadual'
      ') as temp'
      
        'ORDER by fornecedor, tipofornecedor, UPPER(TO_ASCII(nome,'#39'LATIN1' +
        #39')), estado, cnpj, inscricaoestadual'
      '')
