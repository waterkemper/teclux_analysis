uses ACBrECDBloco_I, ACBrECDBloco_0;



{$R *.dfm}

{ TdtmECD }


{
    BLOCO 0: ABERTURA, IDENTIFICAÇÃO E REFERÊNCIAS
    BLOCO I: LANÇAMENTOS CONTÁBEIS
    BLOCO J: DEMONSTRAÇÕES CONTÁBEIS

}
function TdtmECD.GerarArquivo(pArquivo: String): Boolean;
var
  NRegistrosDeclaracao,
  NRegistrosTotal : integer;
  Arq: TextFile;
  vPath,
  Barra,
  formato : String;
begin

  result := false;

  {$IFDEF LINUX}
    Barra := '/';
  {$ELSE}
    Barra := '\';
  {$ENDIF}

  vPath := SpedContabilDir+Barra;

  result := true;

  if SetarIntervalodeDatas then
  begin

    Bloco_0;
    Bloco_I;
    Bloco_J;
    Bloco_9;

    try
      with ACBrSPEDContabil do
      begin
        DT_INI := DataInicial;
        DT_FIN := DataFinal;
        Path := vPath;
        Arquivo := pArquivo;
{        SaveFileTXT(pArquivo);}
        SaveFileTXT;

      end;

    finally
      with ACBrSPEDContabil do
      begin
        Bloco_0.LimpaRegistros;
        Bloco_I.LimpaRegistros;
        Bloco_J.LimpaRegistros;
        Bloco_J.RegistroJ100Count := 0;
        Bloco_J.RegistroJ150Count := 0;
        Bloco_9.LimpaRegistros;
      end;
    end;

    qryecd.Edit;
    qryecddata.AsDateTime := now();
    qryecd.post;
  end
  else
    MensagemAviso('Esta filial não possui lançamentos contábeis no período');  

end;



procedure TdtmECD.ACBrSPEDContabilError(const MsnError: String);
begin
  inherited;
  Erro := MsnError;
  if Assigned(ACBrSPEDContabilonError) then
    ACBrSPEDContabilonError(self);

end;


procedure TdtmECD.Bloco_0;
begin
  with ACBrSPEDContabil.Bloco_0 do
  begin
    P_Registro0000; //Abertura, Identificação e Referências
    P_Registro0001; //ABERTURA DO BLOCO 0
    P_Registro0007; //OUTRAS INSCRIÇÕES CADASTRAIS DO EMPRESÁRIO OU SOCIEDADE EMPRESÁRIA
    P_Registro0020;
  end;

end;

procedure TdtmECD.P_Registro0000;
begin
  with ACBrSPEDContabil.Bloco_0.Registro0000 do
  begin
    DT_INI      := DataInicial; // Data inicial das informações contidas no arquivo
    DT_FIN      := DataFinal; // Data final das informações contidas no arquivo
    NOME        := copy(qryFiliaisrazao.AsString,1,100); //Nome empresarial do empresário ou sociedade empresária.
    CNPJ        := somentenumero(qryFiliaiscnpj.AsString); // Número de inscrição do empresário ou sociedade empresária no CNPJ.
    UF          := qryFiliaisestado.AsString; // Sigla da unidade da federação do empresário ou sociedade empresária.
    IE          := copy(somentenumero(qryFiliaisinscricaoestadual.AsString),1,14); // Inscrição Estadual do empresário ou sociedade empresária.
    COD_MUN     := qryFiliaiscidadeibge.AsString; // Código do município do domicílio fiscal do empresário ou sociedade empresária, conforme tabela do IBGE - Instituto Brasileiro de Geografia e Estatística.
    IM          := qryFiliaisinscricaomunicipal.AsString; // Inscrição Municipal do empresário ou sociedade empresária.
    if qryecdsituacao.AsString <> '7' then
      IND_SIT_ESP := qryecdsituacao.AsString /// Indicador de situação especial (conforme tabela publicada pelo Sped)
    else
      IND_SIT_ESP := '';

    IND_SIT_INI_PER := qryecdind_sit_ini_per.asString; /// Indicador de situação no início do período (conforme tabela publicada pelo Sped).

    if qryFiliaisjunta.AsString <> '' then
      IND_NIRE        := '1'        /// Indicador de existência de NIRE
    else
      IND_NIRE        := '0';

    IND_FIN_ESC     := qryecdind_fin_esc.AsString;     /// Indicador de finalidade da escrituração
//    COD_HASH_SUB    := String;    /// Hash da escrituração substituída.
    NIRE_SUBST      := qryecdnire_subst.asstring;      /// NIRE da escrituração substituída.
    IND_EMP_GRD_PRT := trim(qryecdind_emp_grd_prt.asString); /// Indicador de empresa de grande porte:

    TIP_ECD := inttostr(self.tip_ecd);

    IDENT_MF := qryecdIDENT_MF.asString;

  end;
end;

procedure TdtmECD.P_Registro0001;
begin
  ACBrSPEDContabil.Bloco_0.Registro0001.IND_DAD := 0;
end;


procedure TdtmECD.P_Registro0007;
begin
  qryRespAdmCadastro.First;
  while not qryRespAdmCadastro.Eof do
  begin
    with ACBrSPEDContabil.Bloco_0.Registro0007.New do
    begin
      COD_ENT_REF := qryRespAdmCadastroinstituicao.AsString;
      COD_INSCR   := qryRespAdmCadastrocodigo.AsString;
    end;
    qryRespAdmCadastro.Next;
  end;
end;

procedure TdtmECD.P_Registro0020;
begin
  if qryFiliaisfilialconsolidadoradime.AsInteger=0 then
    RefazConsultaPorNome(qryFiliaisConsolidacao,['filialconsolidadoradime','filial'],
      [qryFiliaiscodigo.AsVariant,0])
  else
    RefazConsultaPorNome(qryFiliaisConsolidacao,['filialconsolidadoradime','filial'],
      [0,qryFiliaisfilialconsolidadoradime.AsVariant]);

  qryFiliaisConsolidacao.First;
  while not qryFiliaisConsolidacao.Eof do
  begin
    with ACBrSPEDContabil.Bloco_0.Registro0020.New do
    begin
      if qryFiliaisfilialconsolidadoradime.AsInteger=0 then
        IND_DEC :=  0       // Indicador de descentralização: 0 - escrituração da matriz; 1 - escrituração da filial.
      else  IND_DEC :=  1;
      CNPJ    :=  somentenumero(qryFiliaisConsolidacaocnpj.AsString); // Número de inscrição do empresário ou sociedade empresária no CNPJ da matriz ou da filial.
      UF      :=  qryFiliaisConsolidacaoestado.AsString;              // Sigla da unidade da federação da matriz ou da filial.
      IE      :=  copy(somentenumero(qryFiliaisconsolidacaoinscricaoestadual.AsString),1,14);        // Inscrição estadual da matriz ou da filial.
      COD_MUN :=  qryFiliaisconsolidacaocidadeibge.AsString;        // Código do município do domicílio da matriz ou da filial.
      IM      :=  qryFiliaisconsolidacaoinscricaomunicipal.AsString;        // Número de Inscrição Municipal da matriz ou da filial.
      NIRE    :=  somentenumero(qryFiliaisconsolidacaojunta.AsString);        // Número de Identificação do Registro de Empresas da matriz ou da filial na Junta Comercial.
    end;
    qryFiliaisConsolidacao.Next;
  end;

end;





procedure TdtmECD.P_Registro0150;
{

Nº	Campo	Descrição	Tipo	Tam	Dec

01	REG	Texto fixo contendo "0150".	C	004	-
02	COD_PART	Código de identificação do participante no arquivo.	C	-	-
03	NOME	Nome pessoal ou empresarial do participante.	C	-	-
04	COD_PAIS	Código do país do participante, conforme a tabela do Banco Central do Brasil.	N	005	-
05	CNPJ	CNPJ do participante.	N	014	-
06	CPF	CPF do participante.	N	011	-
07	NIT	Número de Identificação do Trabalhador, Pis, Pasep, SUS.	N	011	-
08	UF	Sigla da unidade da federação do participante.	C	002	-
09	IE	Inscrição Estadual do participante.	C	-	-
10	IE_ST	Inscrição Estadual do participante na unidade da federação do destinatário, na condição de contribuinte substituto.	C	-	-
11	CÓD_MUN	Código do município, conforme a tabela do IBGE.	N	007	-
12	IM	Inscrição Municipal do participante.	C	-	-
13	SUFRAMA	Número de inscrição do participante na Suframa.	C	009	-

Observações:
Nível hierárquico - 2
Ocorrência - vários (por arquivo)
Este registro deve ser preenchido, na escrituração contábil, somente quando se
referir a participantes cujos códigos de relacionamento constem da tabela interna
ao Sped (relativa ao campo 02 - COD_REL do registro 0180).
Chave: [COD_PART]

}
begin
{

  RefazConsultaPorNome(qryRegistro0150,
    ['datainicial','datafinal','filial'],[datainicial,datafinal,qryecdFilial.asinteger]);
  qryRegistro0150.First;

  while not qryRegistro0150.Eof do
  begin
    with ACBrSPEDContabil.Bloco_0.Registro0150New do
    begin
      COD_PART := qryRegistro0150.fieldbyname('cod_part').asstring ; /// Código de identificação do participante:
      NOME     := qryRegistro0150.fieldbyname('nome')    .asstring ; /// Nome pessoal ou empresarial:
      COD_PAIS := qryRegistro0150.fieldbyname('cod_pais').asstring ; /// Código do país do participante:
      CNPJ     := somentenumero(qryRegistro0150.fieldbyname('cnpj').asstring) ; /// CNPJ do participante:
      CPF      := qryRegistro0150.fieldbyname('cpf')     .asstring ; /// CPF do participante na unidade da federação do destinatário:
      IE       := copy(SomenteNumero(qryRegistro0150.fieldbyname('ie').asstring),1,14) ; /// Inscrição Estadual do participante:

      COD_MUN  := qryRegistro0150.fieldbyname('cod_mun') .AsInteger ; /// Código do município:
      SUFRAMA  := qryRegistro0150.fieldbyname('suframa') .asstring ; /// Número de inscrição na Suframa:
      ENDERECO := trim(qryRegistro0150.fieldbyname('end')     .asstring) ; /// Logradouro e endereço do imóvel:
      NUM      := qryRegistro0150.fieldbyname('num')     .asstring ; /// Número do imóvel:
      COMPL    := trim(qryRegistro0150.fieldbyname('compl')    .asstring) ; /// Dados complementares do endereço:
      BAIRRO   := qryRegistro0150.fieldbyname('bairro')  .asstring ; /// Bairro em que o imóvel está situado:

      P_Registro0180;

    end;
    qryRegistro0150.Next;
  end;

}
end;


procedure TdtmECD.P_Registro0180;
begin
  {
    2.1.6.	REGISTRO 0180: IDENTIFICAÇÃO DO RELACIONAMENTO COM O PARTICIPANTE
    Nº	Campo	Descrição	Tipo	Tam	Dec
    01	REG	Texto fixo contendo "0180".	C	004	-
    02	CÓD_REL	Código do relacionamento conforme tabela interna ao Sped.	N	002	-
    03	DT_INI_REL	Data do início do relacionamento.	N	008	-
    04	DT_FIN_REL	Data do término do relacionamento.	N	008	-
    Observações:
    Nível hierárquico - 3
    Ocorrência - 1:N
    Somente preencher este registro quando o participante se enquadrar em uma
    das hipóteses indicadas no campo 02 - COD_REL.
  }
end;

constructor TdtmECD.Create(AOwner: TComponent);
begin
  inherited;
  qryecd.Tag := ctTabelas;
  qryRegistroJ930.Tag := ctTabelas;
end;

function TdtmECD.Excluirecd: Boolean;
begin
  qryecd.Delete;
  Perpetrar([qryecd]);
  Result := True
end;

function TdtmECD.Gravarecd: Boolean;
var
  ValorTotalDebito: Currency;
begin
  result := qryecd.CheckRequiredFields;
  if result then
  begin
    qryecd.Post;
    result := Perpetrar([qryecd]);
  end;
end;

function TdtmECD.Incluirecd: Boolean;
begin
//  qryecd.Params[0].Clear;
  qryecd.append;
  Result := True;
end;

procedure TdtmECD.qryecdAfterScroll(DataSet: TDataSet);
begin
  inherited;
  RefazConsultaPorNome(qryFiliais,['codigo'],[qryecdfilial.asinteger]);

  if qryecdexercicio.asstring<>'' then
  begin
    DataInicial := strtodate('01/01/'+qryecdexercicio.asstring);
    DataFinal := strtodate('31/12/'+qryecdexercicio.asstring);
  end;

end;

procedure TdtmECD.qryecdNewRecord(DataSet: TDataSet);
begin
  inherited;
  qryecddata.AsDateTime := now();
  qryecdsituacao.AsString := '7';
  qryecdnatureza.AsString := 'Diário';
  qryecdind_sit_ini_per.asString := '0';

  if qryFiliaisjunta.AsString <> '' then
    qryFiliaisjunta.AsString := '1' // Indicador de existência de NIRE
  else
    qryFiliaisjunta.AsString := '0';
    
  qryecdind_fin_esc.AsString := '0';
  qryecdind_emp_grd_prt.asString := '0';
  qryecdident_mf.asString := 'N';
end;



procedure TdtmECD.qryFiliaisAfterScroll(DataSet: TDataSet);
begin
  inherited;
  RefazConsultaPorNome(qryRespAdmCadastro,['filial'],[qryecdfilial.asinteger]);
end;

procedure TdtmECD.Bloco_I;
begin
  P_RegistroI001;
    P_RegistroI010;
      P_RegistroI030;
      P_RegistroI050;
      P_RegistroI075;
      P_RegistroI150;
      P_RegistroI200;
      P_RegistroI350;
end;

procedure TdtmECD.P_RegistroI001;
begin
  ACBrSPEDContabil.Bloco_I.RegistroI001.IND_DAD := 0;
end;

procedure TdtmECD.P_RegistroI010;
begin
  ACBrSPEDContabil.Bloco_I.RegistroI010.IND_ESC := 'G';
  if DataInicial >= strtodate('01/01/2015') then
    ACBrSPEDContabil.Bloco_I.RegistroI010.COD_VER_LC := '4.00'
  else
  if DataInicial >= strtodate('01/01/2014') then
    ACBrSPEDContabil.Bloco_I.RegistroI010.COD_VER_LC := '3.00'
  else
  if DataInicial >= strtodate('01/01/2013') then
    ACBrSPEDContabil.Bloco_I.RegistroI010.COD_VER_LC := '2.00'
  else
    ACBrSPEDContabil.Bloco_I.RegistroI010.COD_VER_LC := '1.00';
end;


procedure TdtmECD.P_RegistroI030;
{
2.2.6.	REGISTRO I030: TERMO DE ABERTURA DO LIVRO
Nº	Campo	Descrição	Tipo	Tam	Dec
01	REG	Texto fixo contendo "I030".	C	004	-
02	DNRC_ABERT	Texto fixo contendo "TERMO DE ABERTURA".	C	017	-
03	NUM_ORD	Número de ordem do instrumento de escrituração.	N	-	-
04	NAT_LIVR	Natureza do livro; finalidade a que se destina o instrumento.	C	80	-
05	QTD_LIN	Quantidade total de linhas do arquivo digital.	N	-	-
06	NOME	Nome empresarial.	C	-	-
07	NIRE	Número de Identificação do Registro de Empresas da Junta Comercial.	N	011	-
08	CNPJ	Número de inscrição no CNPJ .	N	014	-
09	DT_ARQ	Data do arquivamento dos atos constitutivos.	N	008	-
10	DT_ARQ_CONV	Data de arquivamento do ato de conversão de sociedade simples em sociedade empresária.	N	008
11	DESC_MUN	 Município.	C	-	-
 Observações:
Registro obrigatório
Registro obrigatório e exclusivo para as pessoas jurídicas sujeitas a registro em Juntas Comerciais (Redação dada pela IN RFB nº 926/09)
Nível hierárquico - 3
Ocorrência - um (por arquivo)
Deve ser utilizada uma seqüência específica de numeração para o campo NUM_ORD por NAT_LIVR.
}
begin
  with ACBrSPEDContabil.Bloco_I.RegistroI030 do
  begin
    NUM_ORD := qryecdnum_ord.AsString;
    NAT_LIVR := qryecdnatureza.AsString;
//    QTD_LIN := 372; {Pegar no final}
    NOME := qryFiliaisrazao.AsString;
    NIRE := somentenumero(qryFiliaisjunta.AsString);
    CNPJ := somentenumero(qryFiliaiscnpj.AsString);
    DT_ARQ := qryFiliaisjuntadata.AsDateTime;
//    DT_ARQ_CONV := StrToDate('20/06/2000');
    DESC_MUN := qryFiliaisnomecidade.AsString;
    DT_EX_SOCIAL := DataFinal;
  end;
end;

procedure TdtmECD.P_RegistroI050;
begin
  RefazConsultaPorNome(qryRegistroI050,['filial','datainicial','datafinal','exercicio'],
    [qryecdfilial.AsVariant, datainicial, datafinal, qryecdexercicio.AsVariant]);

    RefazConsultaPorNome(qryRegistroI052,['filial','datainicial','datafinal','exercicio'],
    [qryecdfilial.AsVariant, datainicial, datafinal, qryecdexercicio.AsVariant]);


  qryRegistroI050.First;
  while not qryRegistroI050.Eof do
  begin
    with ACBrSPEDContabil.Bloco_I.RegistroI050.New do
    begin
      DT_ALT     :=  datainicial; // Data da inclusão/alteração.
      COD_NAT    :=  qryRegistroI050.fieldbyname('COD_NAT')    .asString;     // Código da natureza da conta/grupo de contas, conforme tabela publicada pelo Sped.
      IND_CTA    :=  qryRegistroI050.fieldbyname('IND_CTA')    .asString;         // Indicador do tipo de conta: S - Sintética (grupo de contas);A - Analítica (conta).
      NIVEL      :=  qryRegistroI050.fieldbyname('NIVEL')      .asString;         // Nível da conta analítica/grupo de contas.
      COD_CTA    :=  qryRegistroI050.fieldbyname('COD_CTA')    .asString;         // Código da conta analítica/grupo de contas.
      COD_CTA_SUP:=  qryRegistroI050.fieldbyname('COD_CTA_SUP').asString;         // Código da conta sintética /grupo de contas de nível imediatamente superior.
      CTA        :=  qryRegistroI050.fieldbyname('CTA')        .asString;         // Nome da conta analítica/grupo de contas.
    end;
    P_RegistroI051;
    P_RegistroI052;
    qryRegistroI050.Next;
  end;
end;

