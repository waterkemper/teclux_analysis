begin
  ACBrSPEDContabil.Bloco_J.RegistroJ001.IND_DAD := 0;
end;

procedure TdtmECD.P_RegistroJ900;
begin
  with ACBrSPEDContabil.Bloco_J.RegistroJ900 do
  begin
    NUM_ORD     := qryecdnum_ord.AsString;   // Número de ordem do instrumento de escrituração.
    NAT_LIVRO   := qryecdnatureza.AsString;  // Natureza do livro; finalidade a que se destinou o instrumento.
    NOME        := qryFiliaisrazao.AsString; // Nome empresarial.
//    QTD_LIN     := Integer;                // Quantidade total de linhas do arquivo digital.
    DT_INI_ESCR := datainicial;              // Data de inicio da escrituração.
    DT_FIN_ESCR := datafinal;                // Data de término da escrituração.
    P_RegistroJ930;
 end;
end;

procedure TdtmECD.P_RegistroJ930;
begin
  qryRegistroJ930.First;
  while not qryRegistroJ930.Eof do
  begin
    with ACBrSPEDContabil.Bloco_J.RegistroJ930.New do
    begin
      IDENT_NOM   := qryRegistroJ930nome.asString; // Nome do signatário.
      IDENT_CPF   := qryRegistroJ930cpf.asString; // CPF.
      IDENT_QUALIF:= qryRegistroJ930descricaoqualificacao.AsString; // Qualificação do assinante, conforme tabela do Departamento Nacional de Registro do Comércio - DNRC.
      COD_ASSIN   := qryRegistroJ930qualificacao.asString; // Código de qualificação do assinante, conforme tabela do Departamento Nacional de Registro do Comércio - DNRC.
      IND_CRC     := qryRegistroJ930crc.asString; // Número de inscrição do contabilista no Conselho Regional de Contabilidade.
      EMAIL       := qryRegistroJ930email.AsString;          /// Email do signatário
      FONE        := qryRegistroJ930fone.AsString;           /// Telefone do signatário.
      UF_CRC      := qryRegistroJ930uf_crc.AsString;         /// Indicação da unidade da federação que expediu o CRC.
      DT_CRC      := qryRegistroJ930data_crc.AsDateTime;      /// Data de validade do CRC do contador
      NUM_SEQ_CRC := qryRegistroJ930num_seq_crc.AsString;    /// Número sequencial no seguinte formato: UF/ano/número
    end;
    qryRegistroJ930.Next;
  end;
end;

procedure TdtmECD.dsrecdDataChange(Sender: TObject; Field: TField);
begin
  inherited;
  if (field = qryecdexercicio) or
     (field = qryecdfilial) then
  begin
    if (qryecd.State = dsinsert) and
       ((qryecdexercicio.AsString <> '') and
        (qryecdfilial.AsInteger <> 0)) then
    begin
      DataInicial := strtodate('01/01/'+qryecdexercicio.asstring);
      DataFinal := strtodate('31/12/'+qryecdexercicio.asstring);
    end;
    qryecdnomearquivo.AsString := 'ECD_'+
      qryecdfilial.AsString+'_'+
      qryecdexercicio.AsString+'.TXT';
  end;
end;

