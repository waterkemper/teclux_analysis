procedure TdtmECD.P_RegistroJ005;
begin
  RefazConsultaPorNome(qryRegistroJ100,['filial','datainicial', 'datafinal','exercicio'],
    [qryecdfilial.AsVariant, datainicial, datafinal, qryecdexercicio.AsVariant]);

  RefazConsultaPorNome(qryRegistroJ150,['filial','datainicial','datafinal','exercicio'],
    [qryecdfilial.AsVariant, datainicial, datafinal, qryecdexercicio.AsVariant]);

  with ACBrSPEDContabil.Bloco_J.RegistroJ005.New do
  begin
    DT_INI  := DataInicial; // Data inicial das demonstrações contábeis.
    DT_FIN  := DataFinal;   // Data final das demonstrações contábeis.
    ID_DEM  := 1;           // Identificação das demonstrações: 1 - demonstrações contábeis do empresário ou sociedade empresária a que se refere a escrituração; 2 - demonstrações consolidadas ou de outros empresários ou sociedades empresárias.
//    CAB_DEM := String;    // Cabeçalho das demonstrações.
    P_RegistroJ100;
    P_RegistroJ150;
  end;
end;

procedure TdtmECD.P_RegistroJ100;
begin
  qryRegistroJ100.First;
  while not qryRegistroJ100.Eof do
  begin
    with ACBrSPEDContabil.Bloco_J.RegistroJ005.Items[0].RegistroJ100.New do
    begin
      COD_AGL       := qryRegistroJ100.fieldbyname('COD_AGL')      .asString;   // Código de aglutinação das contas, atribuído pelo empresário ou sociedade empresária.
      NIVEL_AGL     := qryRegistroJ100.fieldbyname('NIVEL_AGL')    .asString;   // Nível do Código de aglutinação (mesmo conceito do plano de contas - Registro I050).
      IND_GRP_BAL   := qryRegistroJ100.fieldbyname('IND_GRP_BAL')  .asString;   // Indicador de grupo do balanço: 1 - Ativo; 2 - Passivo e Patrimônio Líquido;
      DESCR_COD_AGL := qryRegistroJ100.fieldbyname('DESCR_COD_AGL').asString;   // Descrição do Código de aglutinação.
      VL_CTA        := qryRegistroJ100.fieldbyname('VL_CTA')       .asCurrency; // Valor total do Código de aglutinação no Balanço Patrimonial no exercício informado, ou de período definido em norma específica.
      IND_DC_BAL    := qryRegistroJ100.fieldbyname('IND_DC_BAL')   .asString;   // Indicador da situação do saldo informado no campo anterior: D - Devedor; C - Credor.
      VL_CTA_INI    := qryRegistroJ100.fieldbyname('VL_CTA_INI')       .asCurrency;   /// Valor inicial do código de aglutinação no Balanço Patrimonial no exercício informado, ou de período definido em norma específica.
      IND_DC_BAL_INI:= qryRegistroJ100.fieldbyname('IND_DC_BAL_INI')   .asString; /// Indicador da situação do saldo inicial informado no campo anterior: D - Devedor; C – Credor.
    end;
    qryRegistroJ100.Next;
  end;
end;

procedure TdtmECD.P_RegistroI051;
begin
  if (qryRegistroI050.fieldbyname('cod_cta_ref').AsString<>'') and
     (qryRegistroI050.fieldbyname('ind_cta').AsString='A') then
  begin
    with ACBrSPEDContabil.Bloco_I.RegistroI050.Items[qryRegistroI050.RecNo-1].RegistroI051.New do
    begin
(*     COD_ENT_REF := '10'; // Código da instituição responsável pela manutenção do plano de contas referencial. *)

       COD_PLAN_REF := qryRegistroI050cod_plan_ref.asString;
//    COD_CCUS: String;  // Código do centro de custo.
      COD_CTA_REF := qryRegistroI050.fieldbyname('cod_cta_ref').AsString ; // Código da conta de acordo com o plano de contas referencial, conforme tabela publicada pelos órgãos indicados no campo 02- COD_ENT_REF.
    end;
  end;
end;

procedure TdtmECD.P_RegistroI052;
begin
  qryRegistroI052.First;
  while not qryRegistroI052.Eof do
  begin
    with ACBrSPEDContabil.Bloco_I.RegistroI050.Items[qryRegistroI050.RecNo-1].RegistroI052.New do
    begin
//      COD_CCUS :=  String; /// Código do centro de custo.
      COD_AGL  := qryRegistroI052cod_agl.AsString;  /// Código de aglutinação utilizado no Balanço Patrimonial e na Demonstração de Resultado do Exercício no Bloco J (somente para as contas analíticas).
    end;
    qryRegistroI052.Next;
  end;
end;

procedure TdtmECD.qryRegistroI052FilterRecord(DataSet: TDataSet;
  var Accept: Boolean);
begin
  inherited;
  Accept := (pos(qryRegistroI052cod_agl.AsString, qryRegistroI050cod_cta.AsString)=1) AND
            (qryRegistroI050ind_cta.AsString='A');
end;

procedure TdtmECD.P_RegistroJ150;
begin
  qryRegistroJ150.First;
  while not qryRegistroJ150.Eof do  {era para ser registro filho do J005, porém...}
  begin
    with ACBrSPEDContabil.Bloco_J.RegistroJ005.Items[0].RegistroJ150.New do
    begin
      COD_AGL       := qryRegistroJ150.fieldbyname('COD_AGL')      .asString;   // Código de aglutinação das contas, atribuído pelo empresário ou sociedade empresária.
      NIVEL_AGL     := qryRegistroJ150.fieldbyname('NIVEL_AGL')    .asString;   // Nível do Código de aglutinação (mesmo conceito do plano de contas - Registro I050).
      DESCR_COD_AGL := qryRegistroJ150.fieldbyname('DESCR_COD_AGL').asString;   // Descrição do Código de aglutinação.
      VL_CTA        := qryRegistroJ150.fieldbyname('VL_CTA')       .asCurrency; // Valor total do Código de aglutinação na Demonstração do Resultado do Exercício no período informado.
      IND_VL        := qryregistroJ150.fieldbyname('IND_VL')       .asString;   // Indicador da situação do valor informado no campo anterior:
                                                                                // D - Despesa ou valor que represente parcela redutora do lucro;
                                                                                // R - Receita ou valor que represente incremento do lucro;
                                                                                // P - Subtotal ou total positivo;
                                                                                // N - Subtotal ou total negativo.
      VL_CTA_ULT_DRE := 0;
      IND_VL_ULT_DRE := '';                                                                          
    end;
    qryRegistroJ150.Next;
  end;
end;

function TdtmECD.SetarIntervalodeDatas: Boolean;
begin
 RefazConsultaPorNome(qryIntervaloDatas,['filial','exercicio'],[qryecdfilial.AsVariant,qryecdexercicio.AsVariant]);
 if qryIntervaloDatas.RecordCount<>0 then
 begin
   result := true;
   DataInicial := qryIntervaloDatasdatainicial.AsDateTime;
   DataFinal := qryIntervaloDatasdatafinal.AsDateTime;
 end
 else
   result := false;
end;

end.

