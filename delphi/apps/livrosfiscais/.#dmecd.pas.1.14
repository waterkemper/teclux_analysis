      COD_HIST   := qryRegistroI075.fieldbyname('codigo').asString; // Código do histórico padronizado.
      DESCR_HIST := qryRegistroI075.fieldbyname('descricao').asString;  // Descrição do histórico padronizado.
    end;
    qryRegistroI075.Next;
  end;

end;

procedure TdtmECD.P_RegistroI150;
begin

  RefazConsultaPorNome(qryRegistroI150,['filial','datainicial','datafinal','exercicio'],
      [qryecdfilial.AsVariant, datainicial, datafinal, qryecdexercicio.AsVariant]);


    RefazConsultaPorNome(qryRegistroI155,['filial','datainicial','datafinal','exercicio'],
      [qryecdfilial.AsVariant, datainicial, datafinal, qryecdexercicio.AsVariant]);


  qryRegistroI150.First;
  while not qryRegistroI150.Eof do
  begin
    if qryRegistroI155.RecordCount<>0 then
    begin
      with ACBrSPEDContabil.Bloco_I.RegistroI150.New do
      begin
         DT_INI := qryregistroI150.fieldbyname('datainicial').AsDateTime;
         DT_FIN := qryregistroI150.fieldbyname('datafinal').AsDateTime;
      end;
      P_RegistroI155;
    end;  
    qryRegistroI150.Next;
  end;

end;

procedure TdtmECD.P_RegistroI155;
begin
  qryRegistroI155.First;
  while not qryRegistroI155.Eof do
  begin
    with ACBrSPEDContabil.Bloco_I.RegistroI150.Items[qryRegistroI150.RecNo-1].RegistroI155.New do
    begin
      COD_CTA   := qryregistroI155.fieldbyname('COD_CTA')   .asString;   // Código da conta analítica.
//      COD_CCUS  := qryregistroI155.fieldbyname('COD_CCUS').asString;   // Código do centro de custos.
      VL_SLD_INI:= qryregistroI155.fieldbyname('VL_SLD_INI').asCurrency; // Valor do saldo inicial do período.
      IND_DC_INI:= qryregistroI155.fieldbyname('IND_DC_INI').asString;   // Indicador da situação do saldo inicial:D - Devedor;C - Credor.
      VL_DEB    := qryregistroI155.fieldbyname('VL_DEB')    .asCurrency; // Valor total dos débitos no período.
      VL_CRED   := qryregistroI155.fieldbyname('VL_CRED')   .asCurrency; // Valor total dos créditos no período.
      VL_SLD_FIN:= qryregistroI155.fieldbyname('VL_SLD_FIN').asCurrency; // Valor do saldo final do período.
      IND_DC_FIN:= qryregistroI155.fieldbyname('IND_DC_FIN').asString;   // Indicador da situação do saldo final: D - Devedor; C - Credor.
    end;
    qryRegistroI155.Next;
  end;

end;

