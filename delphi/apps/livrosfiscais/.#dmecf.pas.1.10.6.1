procedure Tdtmecf.GravarListaContabil_p200;
var
  vListaPlanoContas: String;
  vListaPosicaoSaldo: String;
begin

  vListaPlanoContas := RetornarLista(qryPlanoContas, qryPlanoContascodigo);
  vListaPosicaoSaldo := RetornarLista(qryPlanoContas, qryPlanoContasposicaosaldo);
  if qryecf_td_P200.locate('codigo', qryecf_P200codigo_td_P200.asString, []) then
  begin
    qryecf_td_P200.edit;
    if vListaPlanoContas <> '' then
    begin
      qryecf_td_P200ListaContasContabeis.asString := vListaPlanoContas;
      qryecf_td_P200listaposicaosaldocontascontabeis.asString := vListaPosicaoSaldo;
    end
    else
    begin
      qryecf_td_P200ListaContasContabeis.clear;
      qryecf_td_P200listaposicaosaldocontascontabeis.clear;
    end;

    qryecf_td_P200.post;
  end;

  qryecf_P200.AfterScroll := nil;
  qryecf_P200.AfterPost := nil;

  guardarregistroatual(qryp030, false);
  qryP030.first;
  while not qryP030.eof do
  begin
    qryecf_P200.edit;
    if vListaPlanoContas<>'' then
    begin
      qryecf_P200listacontascontabeis.asString := vListaPlanoContas;
      qryecf_P200listaposicaosaldocontascontabeis.asString := vListaPosicaoSaldo;
    end
    else
    begin
      qryecf_P200listacontascontabeis.clear;
      qryecf_P200listaposicaosaldocontascontabeis.clear;
    end;
    qryecf_P200.post;

//    if AtualizarSaldoAoSelecionarExcluirCC_P200 then
//    begin
      qryecf_P200.edit;
      if vListaPlanoContas = '' then
        qryecf_P200valor.clear
      else
        qryecf_P200valor.asCurrency :=  ValorSaldoContabil(qryecf_P200listacontascontabeis.asString,
                                        qryecf_P200listaposicaosaldocontascontabeis.asString);
      qryecf_P200.post;
//    end;
    qryP030.next;
  end;

  VoltarRegistroAtual(qryP030);

  qryecf_P200.AfterScroll := qryecf_P200AfterScroll;


  qryecf.edit;

end;

