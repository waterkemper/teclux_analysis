procedure Tdtmecf.qryecf_m300AfterScroll(DataSet: TDataSet);
begin
  inherited;
  qryecf_m300.readonly := (qryecf_m300Tipo.asString = 'R') or
                          (qryecf_m300Tipo.asString = 'CNA');

  qryPlanoContas.close;

  if qryecf_m300listacontascontabeis.asString <> '' then
  begin
    qryPlanoContas.macrobyname('ListaPlanoContas').asString := qryecf_m300listacontascontabeis.asString;
    qryPlanoContas.macrobyname('ListaPlanoContas_s').asString := quotedstr(qryecf_m300listacontascontabeis.asString);
    qryPlanoContas.macrobyname('listaposicaosaldocontascontabeis_s').asString := quotedstr(qryecf_m300listaposicaosaldocontascontabeis.asString);
  end
  else
  begin
    qryPlanoContas.macrobyname('ListaPlanoContas').asString := '0';
    qryPlanoContas.macrobyname('ListaPlanoContas_s').asString := quotedstr('0');
    qryPlanoContas.macrobyname('listaposicaosaldocontascontabeis_s').asString := quotedstr('');
  end;


  qryPlanoContas.open;

end;

procedure Tdtmecf.GravarListaContabil_m300;
var
  vListaPlanoContas: String;
  vListaPosicaoSaldo: String;
begin

  vListaPlanoContas := RetornarLista(qryPlanoContas, qryPlanoContascodigo);
  vListaPosicaoSaldo := RetornarLista(qryPlanoContas, qryPlanoContasposicaosaldo);

  if qryecf_td_m300.locate('codigo', qryecf_m300codigo_td_m300.asString, []) then
  begin
    qryecf_td_m300.edit;
    if vListaPlanoContas <> ''  then
    begin
      qryecf_td_m300ListaContasContabeis.asString := vListaPlanoContas;
      qryecf_td_m300listaposicaosaldocontascontabeis.asString := vListaPosicaoSaldo;
    end
    else
    begin
      qryecf_td_m300ListaContasContabeis.clear;
      qryecf_td_m300listaposicaosaldocontascontabeis.clear;
    end;
    qryecf_td_m300.post;
  end;

  qryecf_m300.AfterScroll := nil;
  qryecf_m300.AfterPost := nil;

  guardarregistroatual(qryl030, false);
  qryl030.first;
  while not qryL030.eof do
  begin
    qryecf_m300.edit;
    if vListaPlanoContas <> '' then
    begin
      qryecf_m300listacontascontabeis.asString := vListaPlanoContas;
      qryecf_m300listaposicaosaldocontascontabeis.asString := vListaPosicaoSaldo;
    end
    else
    begin
      qryecf_m300listacontascontabeis.clear;
      qryecf_m300listaposicaosaldocontascontabeis.clear;
    end;
    qryecf_m300.post;

    if AtualizarSaldoAoSelecionarExcluirCC_L210 {desativado para ver se necessario -> esta true} then
    begin
      qryecf_m300.edit;
      if vListaPlanoContas = '' then
      begin
        qryecf_m300valor.clear;
        qryecf_m300ind_relacao.asinteger := 4;
      end
      else
      begin
        qryecf_m300valor.asCurrency :=  ValorSaldoContabil(
                                        qryecf_m300listacontascontabeis.asString,
                                        qryecf_m300listaposicaosaldocontascontabeis.asString);

        qryecf_m300ind_relacao.asinteger := 2;
      end;
      qryecf_m300.post;
    end;
    qryL030.next;
  end;

  VoltarRegistroAtual(qryL030);

  qryecf_m300.AfterScroll := qryecf_m300AfterScroll;
  qryecf_m300.AfterPost := qryecf_m300AfterPost;

  qryecf_m300AfterPost(nil);

  qryecf.edit;

end;

