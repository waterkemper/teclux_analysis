procedure Tdtmecf.P_RegistroL030;
var
  I: integer;
  vPER_APUR : String;

  function NVezes: integer;
  begin
    if (ACBrSPEDECF.Bloco_0.Registro0010.FORMA_APUR = 'T') or
       ((ACBrSPEDECF.Bloco_0.Registro0010.FORMA_APUR = 'A') and
        (ACBrSPEDECF.Bloco_0.Registro0010.FORMA_TRIB =
          TACBrFormaTributacaoLucro(GetEnumValue(TypeInfo(TACBrFormaTributacaoLucroAux),'v2')))) then {2 – Lucro Real/Arbitrado.}
      result := 4
    else
    if (ACBrSPEDECF.Bloco_0.Registro0010.FORMA_APUR = 'A') then
      result := 13
  end;

  function RetornaData(i: integer; Inicial: boolean): TDateTime;
  begin
    if NVezes = 4 then
    begin
      vPER_APUR := 'T0'+inttostr(i);
      if inicial then
        result := StartOfTheMonth(IncMonth(EndOfAMonth(yearof(datainicial), i*3),-2))
      else
        result := EndOfAMonth(yearof(datainicial), i*3);
    end
    else
    begin
      if i = 1 then
      begin
        vPER_APUR := 'AOO';
        if inicial then result := DataInicial
        else            result := dataFinal;
      end
      else
      begin
        vPER_APUR := 'A0'+inttostr(i-1);
        if inicial then
          result := StartOfAMonth(yearof(datainicial), i-1)
        else
          result := EndOfAMonth(yearof(datainicial), i-1);
      end;
    end;
  end;

begin
  {
  for i:= 1 to NVezes do
  begin
    with ACBrSPEDECF.Bloco_L.RegistroL030New do
    begin
      DT_INI   := RetornaData(i, true);
      DT_FIN   := RetornaData(i, false);
      PER_APUR := vPER_APUR;
      P_RegistroL200;
    end;
  end;
  }
  qryL030.first;
  while not qryL030.eof do
  begin
    with ACBrSPEDECF.Bloco_L.RegistroL030New do
    begin
      DT_INI   := qryL030datainicial.asDateTime;
      DT_FIN   := qryL030datafinal.asDateTime;
      PER_APUR := qryL030seq.asString;
      P_RegistroL200;
      P_RegistroL210;
//      P_RegistroL300;
    end;

    qryL030.next;

  end;
end;

