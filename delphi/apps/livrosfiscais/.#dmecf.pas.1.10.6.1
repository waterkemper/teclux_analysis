procedure Tdtmecf.GravarListaContabil_L210;
var
  vListaPlanoContas: String;
  vListaPosicaoSaldo: String;
begin

  vListaPlanoContas := RetornarLista(qryPlanoContas, qryPlanoContascodigo);
  vListaPosicaoSaldo := RetornarLista(qryPlanoContas, qryPlanoContasposicaosaldo);
  if qryecf_td_l210.locate('codigo', qryecf_l210codigo_td_l210.asString, []) then
  begin
    qryecf_td_l210.edit;
    if vListaPlanoContas <> '' then
    begin
      qryecf_td_l210ListaContasContabeis.asString := vListaPlanoContas;
      qryecf_td_l210listaposicaosaldocontascontabeis.asString := vListaPosicaoSaldo;
    end
    else
    begin
      qryecf_td_l210ListaContasContabeis.clear;
      qryecf_td_l210listaposicaosaldocontascontabeis.clear;
    end;

    qryecf_td_l210.post;
  end;

  qryecf_l210.AfterScroll := nil;
  qryecf_l210.AfterPost := nil;

  guardarregistroatual(qryL030, false);
  qryL030.first;
  while not qryL030.eof do
  begin
    qryecf_l210.edit;
    if vListaPlanoContas<>'' then
    begin
      qryecf_l210listacontascontabeis.asString := vListaPlanoContas;
      qryecf_l210listaposicaosaldocontascontabeis.asString := vListaPosicaoSaldo;
    end
    else
    begin
      qryecf_l210listacontascontabeis.clear;
      qryecf_l210listaposicaosaldocontascontabeis.clear;
    end;
    qryecf_l210.post;

    if AtualizarSaldoAoSelecionarExcluirCC_L210 then
    begin
      qryecf_l210.edit;
      if vListaPlanoContas = '' then
        qryecf_l210valor.clear
      else
        qryecf_l210valor.asCurrency :=  ValorSaldoContabil(qryecf_l210listacontascontabeis.asString,
                                        qryecf_l210listaposicaosaldocontascontabeis.asString);
      qryecf_l210.post;
    end;
    qryL030.next;
  end;

  VoltarRegistroAtual(qryL030);

  qryecf_l210.AfterScroll := qryecf_l210AfterScroll;
  qryecf_l210.AfterPost := qryecf_l210AfterPost;

  qryecf_l210AfterPost(nil);

  qryecf.edit;

end;

procedure Tdtmecf.ExcluirListaContabil;
begin
  qryPlanoContas.delete;

  case tipopesplano of
    ecf_l210 : GravarListaContabil_L210;
    ecf_m300 : GravarListaContabil_m300;
    ecf_m010 : GravarListaContabil_m010;
    ecf_p200 : GravarListaContabil_p200;
    ecf_p300 : GravarListaContabil_p300;
    ecf_p400 : GravarListaContabil_p400;
    ecf_p500 : GravarListaContabil_p500;
  end;
end;

