function Tdtmecf.GerarArquivo(pArquivo: String): Boolean;
var
  NRegistrosDeclaracao,
  NRegistrosTotal : integer;
  Arq: TextFile;
  vPath,
  Barra,
  formato : String;
begin

  result := false;

  {$IFDEF LINUX}
    Barra := '/';
  {$ELSE}
    Barra := '\';
  {$ENDIF}

  vPath := SpedContabilDir+Barra;

  result := true;

  if SetarIntervalodeDatas then
  begin

    Bloco_0;
//    Bloco_I;
    Bloco_J;

    if qryL030.recordcount<>0 then
    begin
      qryECF_k155.mastersource := dsrL030;
      qryECF_k355.mastersource := dsrL030;
      Bloco_K;
      Bloco_L;
      Bloco_m;
    end;

    if qryP030.recordcount<>0 then
    begin
      qryECF_k155.mastersource := dsrP030;
      qryECF_k355.mastersource := dsrP030;      
      Bloco_K;
      Bloco_p;
    end;

    Bloco_y;


//    Bloco_9;

    try
      with ACBrSPEDECF do
      begin
        DT_INI := DataInicial;
        DT_FIN := DataFinal;
        Path := vPath;
        Arquivo := pArquivo;
{        SaveFileTXT(pArquivo);}
        SaveFileTXT;

      end;

    finally
      with ACBrSPEDECF do
      begin
        Bloco_0.LimpaRegistros;
//        Bloco_I.LimpaRegistros;
        Bloco_J.LimpaRegistros;
        Bloco_k.LimpaRegistros;
        Bloco_L.LimpaRegistros;
        Bloco_M.LimpaRegistros;
        Bloco_P.LimpaRegistros;
        Bloco_y.LimpaRegistros;


//        Bloco_J.RegistroJ100Count := 0;
//        Bloco_J.RegistroJ150Count := 0;
//        Bloco_9.LimpaRegistros;
      end;
    end;

    qryecf.Edit;
    qryecfdata.AsDateTime := now();
    qryecf.post;
  end
  else
    MensagemAviso('Esta filial não possui lançamentos contábeis no período');

end;



