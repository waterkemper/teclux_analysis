  inherited;
  qryecf_p400.readonly := (qryecf_p400Tipo.asString = 'R') or
                          (qryecf_p400Tipo.asString = 'CNA');

  qryPlanoContas.close;

  if qryecf_p400listacontascontabeis.asString <> '' then
  begin
    qryPlanoContas.macrobyname('ListaPlanoContas').asString := qryecf_p400listacontascontabeis.asString;
    qryPlanoContas.macrobyname('ListaPlanoContas_s').asString := quotedstr(qryecf_p400listacontascontabeis.asString);
    qryPlanoContas.macrobyname('listaposicaosaldocontascontabeis_s').asString := quotedstr(qryecf_p400listaposicaosaldocontascontabeis.asString);
  end
  else
  begin
    qryPlanoContas.macrobyname('ListaPlanoContas').asString := '0';
    qryPlanoContas.macrobyname('ListaPlanoContas_s').asString := quotedstr('0');
    qryPlanoContas.macrobyname('listaposicaosaldocontascontabeis_s').asString := quotedstr('');
  end;

  qryPlanoContas.open;

end;

