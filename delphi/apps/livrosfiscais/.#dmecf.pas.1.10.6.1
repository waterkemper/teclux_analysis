procedure Tdtmecf.GravarListaContabil_p400;
var
  vListaPlanoContas: String;
  vListaPosicaoSaldo: String;
begin

  vListaPlanoContas := RetornarLista(qryPlanoContas, qryPlanoContascodigo);
  vListaPosicaoSaldo := RetornarLista(qryPlanoContas, qryPlanoContasposicaosaldo);
  if qryecf_td_p400.locate('codigo', qryecf_p400codigo_td_p400.asString, []) then
  begin
    qryecf_td_p400.edit;
    if vListaPlanoContas <> '' then
    begin
      qryecf_td_p400ListaContasContabeis.asString := vListaPlanoContas;
      qryecf_td_p400listaposicaosaldocontascontabeis.asString := vListaPosicaoSaldo;
    end
    else
    begin
      qryecf_td_p400ListaContasContabeis.clear;
      qryecf_td_p400listaposicaosaldocontascontabeis.clear;
    end;

    qryecf_td_p400.post;
  end;

  qryecf_p400.AfterScroll := nil;
  qryecf_p400.AfterPost := nil;

  guardarregistroatual(qryp030, false);
  qryP030.first;
  while not qryP030.eof do
  begin
    qryecf_p400.edit;
    if vListaPlanoContas<>'' then
    begin
      qryecf_p400listacontascontabeis.asString := vListaPlanoContas;
      qryecf_p400listaposicaosaldocontascontabeis.asString := vListaPosicaoSaldo;
    end
    else
    begin
      qryecf_p400listacontascontabeis.clear;
      qryecf_p400listaposicaosaldocontascontabeis.clear;
    end;
    qryecf_p400.post;

//    if AtualizarSaldoAoSelecionarExcluirCC_p400 then
//    begin
      qryecf_p400.edit;
      if vListaPlanoContas = '' then
        qryecf_p400valor.clear
      else
        qryecf_p400valor.asCurrency :=  ValorSaldoContabil(qryecf_p400listacontascontabeis.asString,
                                        qryecf_p400listaposicaosaldocontascontabeis.asString);
      qryecf_p400.post;
//    end;
    qryP030.next;
  end;

  VoltarRegistroAtual(qryP030);

  qryecf_p400.AfterScroll := qryecf_p400AfterScroll;
//  qryecf_p400.AfterPost := qryecf_p400AfterPost;
//  qryecf_p400AfterPost(nil);

  qryecf.edit;

end;

