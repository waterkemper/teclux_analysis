function Tdtmecf.Gravarecf: Boolean;
var
  ValorTotalDebito: Currency;
begin
  result := qryecf.CheckRequiredFields;
  if result then
  begin
    if qryecf.state = dsinsert then
    begin
      qryecf.Post;
      result := Perpetrar([qryecf]);  {necessario gravar para regras de banco e prosseguir com gravações de dados em l210 gerada pelo banco }
      AbrirTabelas;
//      AtualizarValoresContabeis;
    end
    else
    begin

      if result then
        if qryecf_m010.active then
        result := qryecf_m010.CheckRequiredFields(true);

      if result then
      begin
        qryecf.Post;
        result := Perpetrar([qryecf, qryecf_l210, qryecf_td_l210, qryecf_m300, qryecf_td_m300, qryecf_m010,
                             qryecf_p200, qryecf_p300, qryecf_p400, qryecf_p500]);
      end;
    end;
  end;
end;

