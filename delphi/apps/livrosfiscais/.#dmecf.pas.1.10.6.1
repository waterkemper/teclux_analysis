function Tdtmecf.ValorSaldoContabil(listacontascontabeis, listaposicaosaldocontascontabeis: String): Currency;
begin
  if listacontascontabeis <> '' then
  begin
    qrySaldoContabil.macrobyname('ListaContaContabil').asString :=  quotedstr(listacontascontabeis);
    qrySaldoContabil.macrobyname('listaposicaosaldocontascontabeis').asString :=  quotedstr(listaposicaosaldocontascontabeis);

    case tipopesplano of
      ecf_l210,
      ecf_m300,
      ecf_m010 : RefazConsultapornome(qrySaldoContabil, ['filial','datainicial','datafinal','exercicio'], [qryEcfFilial.asinteger, qryL030datainicial.asDateTime, qryL030datafinal.asDateTime, qryecfExercicio.asinteger]);

      ecf_p200,
      ecf_p300,
      ecf_p400,
      ecf_p500 : RefazConsultapornome(qrySaldoContabil, ['filial','datainicial','datafinal','exercicio'], [qryEcfFilial.asinteger, qryP030datainicial.asDateTime, qryP030datafinal.asDateTime, qryecfExercicio.asinteger]);
    end;
                       
    result := qrySaldoContabilsaldo.ascurrency;
  end
  else
    result := 0;
end;


