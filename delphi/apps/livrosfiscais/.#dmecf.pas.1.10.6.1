procedure Tdtmecf.P_Registro0010;
var
 vopt_refis : string;
begin
  with ACBrSPEDECF.Bloco_0.Registro0010New do
  begin

    COD_QUALIF_PJ    := qryfiliais.fieldbyname('QUALI_PJ').asString;
    FORMA_APUR       := qryfiliais.fieldbyname('FORM_APUR').asstring;

    FORMA_TRIB       := TACBrFormaTributacaoLucro(GetEnumValue(TypeInfo(TACBrFormaTributacaoLucroAux),'v'+qryfiliais.fieldbyname('FORM_TRIBUT').asString));

    FORMA_TRIB_PER   := qryfiliais.fieldbyname('formatrib_1_periodo').asstring+
                        qryfiliais.fieldbyname('formatrib_2_periodo').asstring+
                        qryfiliais.fieldbyname('formatrib_3_periodo').asstring+
                        qryfiliais.fieldbyname('formatrib_4_periodo').asstring;

//   HASH_ECF_ANTERIOR:= qryfiliais.fieldbyname('HASH_ECF_ANTERIOR').asstring;

    if FORMA_APUR = 'A' then  {Anaual / Trimestral}
      MES_BAL_RED      := qryfiliais.fieldbyname('mes_bal_red_1').asstring+
                          qryfiliais.fieldbyname('mes_bal_red_2').asstring+
                          qryfiliais.fieldbyname('mes_bal_red_3').asstring+
                          qryfiliais.fieldbyname('mes_bal_red_4').asstring+
                          qryfiliais.fieldbyname('mes_bal_red_5').asstring+
                          qryfiliais.fieldbyname('mes_bal_red_6').asstring+
                          qryfiliais.fieldbyname('mes_bal_red_7').asstring+
                          qryfiliais.fieldbyname('mes_bal_red_8').asstring+
                          qryfiliais.fieldbyname('mes_bal_red_9').asstring+
                          qryfiliais.fieldbyname('mes_bal_red_10').asstring+
                          qryfiliais.fieldbyname('mes_bal_red_11').asstring+
                          qryfiliais.fieldbyname('mes_bal_red_12').asstring;

    OPT_EXT_RTT      := qryfiliais.fieldbyname('OPT_EXT_RTT').asstring;

    if (OPT_EXT_RTT = 'S') and (qryecfexercicio.asinteger=2014) then
      DIF_FCONT        := qryfiliais.fieldbyname('DIF_FCONT').asSTring
    else
      DIF_FCONT        := qryfiliais.fieldbyname('DIF_FCONT').asSTring;

    OPT_PAES         := TACBrIndicador(GetEnumValue(TypeInfo(TACBrIndicadorAux),qryfiliais.fieldbyname('OPT_PAES').asString));
    OPT_REFIS        := TACBrIndicador(GetEnumValue(TypeInfo(TACBrIndicadorAux),qryfiliais.fieldbyname('OPT_REFIS').asString));

    // quando envolver imune ou isento
                     // 08           09
    if (FORMA_TRIB in [ftlImuneIRPJ, ftlIsentoIRPJ]) then
    begin
       TIP_ENT          := qryfiliais.fieldbyname('TIP_ENT').asString;
       FORMA_APUR_I     := qryfiliais.fieldbyname('FORMA_APUR_I').asstring;
       APUR_CSLL        := qryfiliais.fieldbyname('APUR_CSLL').asstring;
    end;

                      // Quando envolver Lucro presumido
                      // 03                   04                              05                 07
    if (FORMA_TRIB in [ftlLucroPresumidoReal, ftlLucroPresumidoRealArbitrado, ftlLucroPresumido, ftlLucroPresumidoArbitrado]) then
      TIP_ESC_PRE      := qryfiliais.fieldbyname('TIP_ESC_PRE').asstring;
  end;
end;

