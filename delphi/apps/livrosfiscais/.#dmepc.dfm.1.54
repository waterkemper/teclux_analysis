  object qryRegistroD010: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select f.codigo,'
      '       f.cnpj,'
      '       f.sped_pis_cofins'
      'from filiais f'
      'where  f.codigo in (select distinct np.filial'
      
        '                    from notaspag np join filiais fnp on np.fili' +
        'al = fnp.codigo'
      
        '                    where np.data between :datainicial and :data' +
        'final'
      '                      and np.situacao = '#39'N'#39
      
        '                      and cast(coalesce(np.modelodocto,'#39'01'#39') as ' +
        'varchar(2)) in ('#39'07'#39','#39'08'#39','#39'8B'#39','#39'09'#39','#39'10'#39','#39'11'#39','#39'26'#39','#39'27'#39','#39'57'#39','#39'21' +
        #39','#39'22'#39')'
      
        '                      and (fnp.filialconsolidadoradime = :codigo' +
        ' or np.filial = :codigo)'
      
        '                      and (fnp.sped_pis_cofins or fnp.sped_pis_c' +
        'ofins_rb or fnp.sped_pis_cofins_rem)'
      '                      and exists (select pnp.codigonota'
      '                                    from produtosnotaspag pnp'
      
        '                                    where pnp.codigonota = np.co' +
        'digo limit 1))'
      ' and :codinctrib<>2                                     ')
    RequestLive = False
    Left = 248
    Top = 309
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
