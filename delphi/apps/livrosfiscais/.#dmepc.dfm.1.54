  object qryRegistroD501: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkFields = 'chave=chave;filial=filial'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroD500
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      
        'select chave, filial, cst_pis, sum(vl_item) as vl_item, nat_bc_c' +
        'red, sum(vl_bc_pis) as vl_bc_pis, aliq_pis, sum(vl_pis) as vl_pi' +
        's'
      'from'
      '('
      '  select np.codigo as chave,'
      '         np.filial,'
      '         pnp.piscst         as cst_pis,'
      '         (pnp.quantidade * pnp.precounitario) +'
      '          coalesce(pnp.frete,0) +'
      '          coalesce(pnp.seguro,0) +'
      '          coalesce(pnp.despesasacessorias,0) +'
      '          coalesce(pnp.acrescimo,0) -'
      '          coalesce(pnp.desconto,0) -'
      '          coalesce(pnp.valordescontoitem,0) +'
      '          coalesce(pnp.icmsvalorst,0) +'
      '          coalesce(pnp.valoripi,0) as vl_item,'
      ''
      '         cast('#39'03'#39' as char(2)) as NAT_BC_CRED,'
      '         pnp.PISBaseCalculo as vl_bc_pis,'
      '         pnp.pisaliquota       as aliq_pis,'
      '         pnp.PISValor          as vl_pis'
      ''
      '  from notaspag np'
      '       join produtosnotaspag pnp'
      '       on np.codigo = pnp.codigonota'
      '  where np.codigo = pnp.codigonota'
      '    and np.data between :datainicial and :datafinal'
      
        '    and cast(coalesce(np.modelodocto,'#39'01'#39') as varchar(2)) in('#39'21' +
        #39','#39'22'#39')'
      '    and np.situacao = '#39'N'#39
      '    and (np.filial = :filial or'
      '         np.filial in (select f.codigo'
      '                       from filiais f'
      '                       where f.filialconsolidadoradime = :filial'
      
        '                       and (f.sped_pis_cofins or f.sped_pis_cofi' +
        'ns_rb or f.sped_pis_cofins_rem)))'
      '    and pnp.piscst in ('#39'50'#39','#39'51'#39','#39'52'#39','#39'53'#39','#39'54'#39','#39'55'#39','#39'56'#39')'
      '    and :codinctrib<>2'
      '                           '
      ') as selecao'
      'group by chave, filial, cst_pis, nat_bc_cred, aliq_pis')
