  object qryRegistro0400: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkFields = 'codigo = filial'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistro0140
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select n.codigo,'
      '       n.descricao,'
      '       naturezas_diversas.filial'
      'from naturezas n join'
      '  ('
      '  select pdf.natureza as cod_nat, df.filialemissao as filial'
      '  from dadosfiscais df'
      '       join notas n'
      '       on df.numero = n.dadofiscal'
      '       join produtosdadosfiscais pdf'
      '       on df.numero = pdf.dadofiscal'
      '  where df.numero = pdf.dadofiscal'
      '    and df.data between :datainicial and :datafinal'
      '/*    and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')*/'
      '    and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '    and df.CodigoFiscal < 8000'
      '    and df.situacao = '#39'N'#39
      '    and (df.filialemissao = :filial or'
      '         df.filialemissao in (select f.codigo'
      '                              from filiais f'
      
        '                              where f.filialconsolidadoradime = ' +
        ':filial'
      
        '                              and (f.sped_pis_cofins or f.sped_p' +
        'is_cofins_rb or f.sped_pis_cofins_rem)))'
      
        '    and (n.filial,n.serie) in (select sf.filial,sf.valor from se' +
        'riesfiliais sf where sf.ativa)'
      '  union'
      '  select sdf.natureza as cod_nat, df.filialemissao as filial'
      '  from dadosfiscais df'
      '       join notas n'
      '       on df.numero = n.dadofiscal'
      '       join servicosdadosfiscais sdf'
      '            join servicos s'
      '            on sdf.servico = s.codigo'
      '       on df.numero = sdf.dadofiscal'
      '  where df.numero = sdf.dadofiscal'
      '    and df.data between :datainicial and :datafinal'
      '/*    and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')*/'
      '    and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '    and df.CodigoFiscal < 8000'
      '    and df.situacao = '#39'N'#39
      '    and (df.filialemissao = :filial or'
      '         df.filialemissao in (select f.codigo'
      '                              from filiais f'
      
        '                              where f.filialconsolidadoradime = ' +
        ':filial'
      
        '                              and (f.sped_pis_cofins or f.sped_p' +
        'is_cofins_rb or f.sped_pis_cofins_rem)))'
      
        '    and (n.filial,n.serie) in (select sf.filial,sf.valor from se' +
        'riesfiliais sf where sf.ativa)'
      '  union'
      '  select pnp.natureza as cod_nat, np.filial'
      '  from notaspag np'
      '       join produtosnotaspag pnp'
      '       on np.codigo = pnp.codigonota'
      '  where np.codigo = pnp.codigonota'
      '    and np.data between :datainicial and :datafinal'
      '    and np.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '    and np.situacao = '#39'N'#39
      '    /*and not (np.permitirimprimir and np.modelodocto='#39'55'#39')*/'
      '    and (np.filial = :filial or'
      '     np.filial in (select f.codigo'
      '                   from filiais f'
      '                   where f.filialconsolidadoradime = :filial'
      
        '                   and (f.sped_pis_cofins or f.sped_pis_cofins_r' +
        'b or f.sped_pis_cofins_rem)))'
      ''
      
        '    and (:codinctrib<>2 or (:codinctrib=2 and mod(np.codigofisca' +
        'l,1000) in ('
      ''
      '   201, /* Devolu'#231#227'o de venda de produ'#231#227'o do estabelecimento */'
      
        '   202, /* Devolu'#231#227'o de venda de mercadoria adquirida ou recebid' +
        'a de terceiros */'
      
        '   410, /* Devolu'#231#227'o de venda de produ'#231#227'o do estabelecimento em ' +
        'opera'#231#227'o com produto sujeito ao regime de substitui'#231#227'o tribut'#225'ri' +
        'a */'
      
        '   411  /* Devolu'#231#227'o de venda de mercadoria adquirida ou recebid' +
        'a de terceiros em opera'#231#227'o com mercadoria sujeita ao regime de s' +
        'ubstitui'#231#227'o tribut'#225'ria */'
      ''
      '    )))'
      ''
      ') as naturezas_diversas on naturezas_diversas.cod_nat = n.codigo'
      'order by n.codigo')
    RequestLive = False
    Left = 36
    Top = 267
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codinctrib'
        ParamType = ptUnknown
      end>
    object qryRegistro0400codigo: TIntegerField
      FieldName = 'codigo'
      DisplayFormat = '0'
    end
    object qryRegistro0400descricao: TStringField
      FieldName = 'descricao'
      Size = 80
    end
    object qryRegistro0400filial: TIntegerField
      FieldName = 'filial'
      DisplayFormat = '0'
    end
  end
  object qryRegistro0450: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkFields = 'codigo = filial'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistro0140
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select informacoes.txt, filial'
      'from'
      '('
      
        '  select cast(RetiraBrancoePipeeASCII255(observacoes) as varchar' +
        '(255)) as txt, filial'
      '  from notaspag'
      '  where observacoes is not null'
      '    and (btrim(observacoes)<>'#39#39')'
      '    and data between :datainicial and :datafinal'
      
        '    and modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39','#39'07'#39','#39'08'#39','#39'8B'#39','#39'09'#39',' +
        #39'10'#39','#39'11'#39','#39'26'#39','#39'27'#39','#39'57'#39')'
      '    and situacao='#39'N'#39
      '    /*and not (permitirimprimir and modelodocto='#39'55'#39')*/'
      '    and (filial = :filial or'
      '         filial in (select f.codigo'
      '                   from filiais f'
      '                   where f.filialconsolidadoradime = :filial'
      
        '                   and (f.sped_pis_cofins or f.sped_pis_cofins_r' +
        'b or f.sped_pis_cofins_rem)))'
      '    and :codinctrib<>2               '
      '  group by observacoes, filial'
      '  union'
      
        '  select cast(RetiraBrancoePipeeASCII255(infcomplementar) as var' +
        'char(255)) as txt, filial'
      '  from notaspag'
      '  where infcomplementar is not null'
      '    and (btrim(infcomplementar)<>'#39#39')'
      '    and data between :datainicial and :datafinal'
      '    and modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39','#39'07'#39')'
      '    and situacao='#39'N'#39
      '    /*and not (permitirimprimir and modelodocto='#39'55'#39')*/'
      '    and (filial = :filial or'
      '         filial in (select f.codigo'
      '                   from filiais f'
      '                   where f.filialconsolidadoradime = :filial'
      
        '                   and (f.sped_pis_cofins or f.sped_pis_cofins_r' +
        'b or f.sped_pis_cofins_rem)))'
      '  group by infcomplementar, filial'
      '  union'
      
        '  select cast(RetiraBrancoePipeeASCII255(observacoes) as varchar' +
        '(255)) as txt, filialemissao as filial'
      
        '  from dadosfiscais join notas n on dadosfiscais.numero = n.dado' +
        'fiscal'
      '  where observacoes is not null'
      '    and (btrim(observacoes)<>'#39#39')'
      '    and data between :datainicial and :datafinal'
      '/*    and modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')*/'
      '    and modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '    and situacao = '#39'N'#39
      '    and (filialemissao = :filial or'
      '         filialemissao in (select f.codigo'
      '                              from filiais f'
      
        '                              where f.filialconsolidadoradime = ' +
        ':filial'
      
        '                              and (f.sped_pis_cofins or f.sped_p' +
        'is_cofins_rb or f.sped_pis_cofins_rem)))'
      
        '    and (n.filial,n.serie) in (select sf.filial,sf.valor from se' +
        'riesfiliais sf where sf.ativa)'
      '  group by observacoes, filialemissao'
      '  union'
      
        '  select cast(RetiraBrancoePipeeASCII255(observacoescomplementar' +
        ') as varchar(255)) as txt, filialemissao as filial'
      
        '  from dadosfiscais join notas n on dadosfiscais.numero = n.dado' +
        'fiscal'
      '  where observacoescomplementar is not null'
      '    and (btrim(observacoescomplementar)<>'#39#39')'
      '    and data between :datainicial and :datafinal'
      '/*    and modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')*/'
      '    and modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '    and situacao = '#39'N'#39
      '    and (filialemissao = :filial or'
      '         filialemissao in (select f.codigo'
      '                              from filiais f'
      
        '                              where f.filialconsolidadoradime = ' +
        ':filial'
      
        '                              and (f.sped_pis_cofins or f.sped_p' +
        'is_cofins_rb or f.sped_pis_cofins_rem)))'
      
        '    and (n.filial,n.serie) in (select sf.filial,sf.valor from se' +
        'riesfiliais sf where sf.ativa)'
      '  group by observacoescomplementar, filialemissao'
      '  union'
      
        '  select cast(RetiraBrancoePipeeASCII255(infcomplementar) as var' +
        'char(255)) as txt, filialemissao as filial'
      
        '  from dadosfiscais join notas n on dadosfiscais.numero = n.dado' +
        'fiscal'
      '  where infcomplementar is not null'
      '    and (btrim(infcomplementar)<>'#39#39')'
      '    and data between :datainicial and :datafinal'
      '/*    and modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')*/'
      '    and modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '    and situacao = '#39'N'#39
      '    and (filialemissao = :filial or'
      '         filialemissao in (select f.codigo'
      '                              from filiais f'
      
        '                              where f.filialconsolidadoradime = ' +
        ':filial'
      
        '                              and (f.sped_pis_cofins or f.sped_p' +
        'is_cofins_rb or f.sped_pis_cofins_rem)))'
      
        '    and (n.filial,n.serie) in (select sf.filial,sf.valor from se' +
        'riesfiliais sf where sf.ativa)'
      '  group by infcomplementar, filialemissao'
      '  union all'
      
        '  select cast(:ctREFERENTECUPOMFISCAL||cast(c.numero as varchar)' +
        ' as varchar(255)) as txt, df.filialemissao as filial'
      '  from (dadosfiscais df'
      '        join (notas n'
      '              join cupons c'
      '              on n.dadofiscalvinculado = c.dadofiscal)'
      '        on df.numero = n.dadofiscal)'
      '  where df.data between :datainicial and :datafinal'
      '/*    and modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')*/'
      '    and modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '    and situacao = '#39'N'#39
      '    and (df.filialemissao = :filial or'
      '         df.filialemissao in (select f.codigo'
      '                              from filiais f'
      
        '                              where f.filialconsolidadoradime = ' +
        ':filial'
      
        '                              and (f.sped_pis_cofins or f.sped_p' +
        'is_cofins_rb or f.sped_pis_cofins_rem)))'
      ') as informacoes'
      'where coalesce(txt,'#39#39')<>'#39#39
      'order by txt')
    RequestLive = False
    Left = 33
    Top = 323
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codinctrib'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ctREFERENTECUPOMFISCAL'
        ParamType = ptUnknown
      end>
    object qryRegistro0450txt: TStringField
      FieldName = 'txt'
      Size = 255
    end
    object qryRegistro0450filial: TIntegerField
      FieldName = 'filial'
    end
  end
  object qryRegistro0500: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkFields = 'codigo = filial'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistro0140
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select cast(:datainicial as date) as dt_alt,'
      '       cast(case when pl.natureza = '#39'A'#39'   then '#39'01'#39
      '                 when pl.natureza = '#39'P'#39'        then '#39'02'#39
      '                 when pl.natureza = '#39'L'#39'        then '#39'03'#39
      '                 when pl.natureza IN ('#39'R'#39','#39'D'#39') then '#39'04'#39
      '                 when pl.natureza = '#39'C'#39'        then '#39'05'#39
      '                 when pl.natureza = '#39'O'#39'        then '#39'09'#39
      '            end as varchar(2)) as cod_nat_cc,'
      '       cast(pl.tipo as char(1)) as ind_cta,'
      
        '       length(trim(pl.classificacao)) - length(trim(replace(pl.c' +
        'lassificacao,'#39'.'#39','#39#39')))+1 as nivel,'
      '       case when pl.tipo = '#39'A'#39' then'
      
        '         cast(pl.classificacao||trim(to_char(pl.codigo,'#39'000000'#39')' +
        ') as varchar(60))'
      '       else'
      '         cast(pl.classificacao as varchar(60))'
      '       end as cod_cta,'
      '       pl.descricao as nome_cta'
      'from planocontas pl'
      '/* VERIFICAR QUAIS CONTAS */')
    RequestLive = False
    Left = 40
    Top = 381
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end>
  end
  object qryRegistroA100: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkFields = 'codigo = filial'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroA010
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select df.numero as chave,'
      '       df.filialemissao as filial,'
      '       cast(1 as varchar(1)) as ind_oper,   '
      '       cast(0 as varchar(1)) as ind_emit,'
      
        '       cast(df.tipocliente||cast(df.cliente as varchar) as varch' +
        'ar(60)) as cod_part,'
      #9'   '
      '       df.modelodocto as  cod_mod,'
      #9'   '
      
        '       case when df.situacao = '#39'C'#39' '#9#9'       then cast('#39'02'#39' as va' +
        'rchar(2))  /* cancelado    */'
      
        '            when df.dadofiscalcomplementar is not null then cast' +
        '('#39'06'#39' as varchar(2))  /* complementar */'
      
        '            /*when df.datasaida > :datafinal             then ca' +
        'st('#39'01'#39' as varchar(2))*/  /* regular extemporaneo */'
      '            when  (mod(df.codigofiscal,1000) = 929) and'
      '                  (select count(*)'
      '                  from cupons cp'
      
        '                  where cp.dadofiscal = n.dadofiscalvinculado)>0' +
        ' then cast('#39'08'#39' as varchar(2)) /* regime especial -> cupom vincu' +
        'lado */'
      '       else'
      
        '                                                            cast' +
        '('#39'00'#39' as varchar(2))  /* regular      */'
      '       end as cod_sit,'
      #9'   '
      '       n.serie as ser,'
      #9'   '
      '       cast(null as varchar(4)) as sub,'
      '       n.numero as num_doc,'
      '       df.chv_nfe as chv_nfse,'
      '       df.data as dt_doc,'
      '       df.datasaida as dt_exe_serv,'
      '       df.valortotal as vl_doc,'
      #9'   '
      '       case when coalesce((select count(*)'
      '                           from venctosdadosfiscais vdf'
      '                           where vdf.dadofiscal = df.numero'
      '                            and vdf.datavencto > df.data'
      
        '                            limit 1),0)<>0                      ' +
        '  then 1'
      '            when coalesce((select count(*)'
      '                           from venctosdadosfiscais vdf'
      '                           where vdf.dadofiscal = df.numero'
      '                            and vdf.datavencto <= df.data'
      '                            limit 1),0)<>0 '#9#9#9'  then 0'
      #9#9#9#9#9#9#9#9'  else 2'
      '       end as ind_pgto,'
      #9'   '
      '       0.00 as vl_desc,'
      '       (select sum(sdf.pisbasecalculo)'
      '        from servicosdadosfiscais sdf'
      '        where sdf.dadofiscal = df.numero) as VL_BC_PIS,'
      #9#9
      '       (select sum(sdf.pisvalor)'
      '        from servicosdadosfiscais sdf'
      '        where sdf.dadofiscal = df.numero) as VL_PIS,'#9
      '       (select sum(sdf.cofinsbasecalculo)'
      '        from servicosdadosfiscais sdf'
      '        where sdf.dadofiscal = df.numero) as VL_BC_COFINS,'
      #9#9
      '       (select sum(sdf.cofinsvalor)'
      '        from servicosdadosfiscais sdf'
      '        where sdf.dadofiscal = df.numero) as VL_COFINS,'#9
      '       (select irc.valorimpostoretido '
      #9'    from impostosretidoscontratos irc'
      '             join impostosretidos ir'
      #9#9#9' on irc.impostoretido = ir.codigo'
      '  '#9'    where irc.contrato = df.contrato'
      #9#9'  and ir.descricao='#39'PIS'#39') as VL_PIS_RET,'
      ''
      '       (select irc.valorimpostoretido'
      #9'    from impostosretidoscontratos irc'
      '             join impostosretidos ir'
      #9#9#9' on irc.impostoretido = ir.codigo'
      '  '#9'    where irc.contrato = df.contrato'
      #9#9'  and ir.descricao='#39'COFINS'#39') as VL_COFINS_RET,'
      ''
      '       (select sum(sdf.valorissqn)'
      '        from servicosdadosfiscais sdf'
      '        where sdf.dadofiscal = df.numero) as VL_ISS,'
      ''
      '      (select vf.pessoanumero'
      '       from vfornecedores vf'
      '       where vf.codigo = df.cliente'
      '         and vf.tipo = df.tipocliente) as cnpj'
      ''
      'from (dadosfiscais df'
      '       join notas n'
      '       on df.numero = n.dadofiscal)'
      'where df.data between :datainicial and :datafinal'
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      
        '/*  and ((df.CodigoFiscal >= 8000) or (df.CodigoFiscal = 5933))*' +
        '/'
      '  and df.CodigoFiscal >= 8000'
      '  and exists (select sdf.dadofiscal'
      '              from servicosdadosfiscais sdf'
      '              where sdf.dadofiscal = df.numero limit 1)'
      '  '
      '  and (df.filialemissao = :filial or'
      '       df.filialemissao in (select f.codigo'
      '                              from filiais f'
      
        '                              where f.filialconsolidadoradime = ' +
        ':filial'
      
        '                              and (f.sped_pis_cofins or f.sped_p' +
        'is_cofins_rb or f.sped_pis_cofins_rem)))'
      '  '
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)')
