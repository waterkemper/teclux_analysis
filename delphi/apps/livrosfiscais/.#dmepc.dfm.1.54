  object qryRegistroD505: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkFields = 'chave=chave;filial=filial'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroD500
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      
        'select chave, filial, IND_NAT_FRT, cst_cofins, sum(vl_item) as v' +
        'l_item, nat_bc_cred, sum(vl_bc_cofins) as vl_bc_cofins, aliq_cof' +
        'ins, sum(vl_cofins) as vl_cofins'
      'from'
      '('
      '  select np.codigo as chave,'
      '       np.filial,'
      '       cast(2 as integer) as IND_NAT_FRT,'
      '              (pnp.quantidade * pnp.precounitario) +'
      '        coalesce(pnp.frete,0) +'
      '        coalesce(pnp.seguro,0) +'
      '        coalesce(pnp.despesasacessorias,0) +'
      '        coalesce(pnp.acrescimo,0) -'
      '        coalesce(pnp.desconto,0) -'
      '        coalesce(pnp.valordescontoitem,0) +'
      '        coalesce(pnp.icmsvalorst,0) +'
      '        coalesce(pnp.valoripi,0) as vl_item,'
      '       cast('#39'03'#39' as char(2))    as NAT_BC_CRED,'
      '       pnp.Cofinscst            as cst_Cofins,'
      '       pnp.CofinsBaseCalculo    as vl_bc_Cofins,'
      '       pnp.Cofinsaliquota       as aliq_Cofins,'
      '       pnp.CofinsValor          as vl_Cofins'
      '  from notaspag np'
      '     join produtosnotaspag pnp'
      '     on np.codigo = pnp.codigonota'
      '  where np.codigo = pnp.codigonota'
      '  and np.data between :datainicial and :datafinal'
      
        '  and cast(coalesce(np.modelodocto,'#39'01'#39') as varchar(2)) in('#39'21'#39',' +
        #39'22'#39')'
      '  and np.situacao = '#39'N'#39
      '  and (np.filial = :filial or'
      '       np.filial in (select f.codigo'
      '                     from filiais f'
      '                     where f.filialconsolidadoradime = :filial'
      
        '                     and (f.sped_pis_cofins or f.sped_pis_cofins' +
        '_rb or f.sped_pis_cofins_rem)))'
      '  and pnp.cofinscst in ('#39'50'#39','#39'51'#39','#39'52'#39','#39'53'#39','#39'54'#39','#39'55'#39','#39'56'#39')'
      '  and :codinctrib<>2              '
      ') as selecao'
      
        'group by chave, filial, IND_NAT_FRT, cst_cofins, nat_bc_cred, al' +
        'iq_cofins')
    RequestLive = False
    Left = 368
    Top = 565
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codinctrib'
        ParamType = ptUnknown
      end>
