  object qryAtualizarRegistroM110: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select sum(pisvalor) as pisvalor,'
      '       sum(cofinsvalor) as cofinsvalor'
      'from'
      '('
      'select'
      
        '      round(((d.valorvencto - d.valorpagto) *  coalesce((select ' +
        'max(pnp.pisaliquota)'
      
        '                                                   from produtos' +
        'notaspag pnp'
      
        '                                                   where pnp.cod' +
        'igonota = np.codigo),0)/100),2) as pisvalor,'
      ''
      
        '      round(((d.valorvencto - d.valorpagto) *  coalesce((select ' +
        'max(pnp.cofinsaliquota)'
      
        '                                                   from produtos' +
        'notaspag pnp'
      
        '                                                   where pnp.cod' +
        'igonota = np.codigo),0)/100),2) as cofinsvalor'
      ''
      'from duplicatas d'
      '     join documentospag dp'
      '          join notaspag np'
      '          on np.documentopag = dp.numero'
      '     on d.documentopag = dp.numero'
      'where to_char(cast(d.datapagto as date), '#39'MM/YYYY'#39')= :MesAno'
      '  and d.valorpagto < d.valorvencto'
      ''
      '  and (np.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39') or'
      '       np.modelodocto in ('#39'02'#39','#39'2D'#39','#39'2E'#39','#39'59'#39') or'
      '       np.modelodocto in ('#39'06'#39','#39'28'#39', '#39'29'#39') or'
      
        '       np.modelodocto in ('#39'07'#39','#39'08'#39','#39'8B'#39','#39'09'#39','#39'10'#39','#39'11'#39','#39'26'#39','#39'27' +
        #39','#39'57'#39') or'
      '       np.modelodocto in ('#39'21'#39','#39'22'#39'))'
      ''
      '  and exists (select pnp.piscst'
      '              from produtosnotaspag pnp'
      '              where pnp.codigonota = np.codigo'
      
        '                and pnp.piscst in ('#39'50'#39','#39'51'#39','#39'52'#39','#39'53'#39','#39'54'#39','#39'55'#39 +
        ','#39'56'#39','#39'60'#39','#39'61'#39','#39'62'#39','#39'63'#39','#39'64'#39','#39'65'#39','#39'66'#39')'
      '              limit 1)'
      ''
      '  and exists (select pnp.cofinscst'
      '              from produtosnotaspag pnp'
      '              where pnp.codigonota = np.codigo'
      
        '                and pnp.cofinscst in ('#39'50'#39','#39'51'#39','#39'52'#39','#39'53'#39','#39'54'#39','#39 +
        '55'#39','#39'56'#39','#39'60'#39','#39'61'#39','#39'62'#39','#39'63'#39','#39'64'#39','#39'65'#39','#39'66'#39')'
      '              limit 1)'
      ''
      '  and np.situacao = '#39'N'#39
      '  and (np.filial = :filialconsolidadora or'
      '       np.filial in (select f.codigo'
      '                     from filiais f'
      
        '                     where f.filialconsolidadoradime = :filialco' +
        'nsolidadora'
      
        '                     and (f.sped_pis_cofins or f.sped_pis_cofins' +
        '_rb or f.sped_pis_cofins_rem)))'
      '  and :codinctrib<>2                     '
      ') as selecao')
    RequestLive = False
    Left = 416
    Top = 632
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'MesAno'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filialconsolidadora'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codinctrib'
        ParamType = ptUnknown
      end>
    object qryAtualizarRegistroM110pisvalor: TFloatField
      FieldName = 'pisvalor'
    end
    object qryAtualizarRegistroM110cofinsvalor: TFloatField
      FieldName = 'cofinsvalor'
    end
  end
  object qryAlugueis_F100: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select a.numero as documentorec,'
      '       a.filialemissao as filial,'
      '       a.data as dt_oper,'
      '       cast(1 as integer) as ind_oper,'
      '       a.cliente as cod_part,'
      '       cast('#39'C'#39' as char(1)) as tipocod_part,'
      '       a.valor as vl_oper,'
      '       a.piscst as cst_pis,'
      '       a.valor as vl_bc_pis,'
      '       a.pisaliquota as aliq_pis,'
      '       (a.valor * a.pisaliquota / 100) as vl_pis,'
      '       a.cofinscst as cst_cofins,'
      '       a.valor as vl_bc_cofins,'
      '       a.cofinsaliquota as aliq_cofins,'
      '       (a.valor * a.cofinsaliquota / 100) as vl_cofins,'
      '       a.nat_bc_cred,'
      '       cast(0 as integer) as ind_orig_cred,'
      '       cl.pessoanumero'
      ''
      'from alugueis a'
      '     join clientes cl'
      '     on a.cliente = cl.codigo'
      ''
      'where a.data between :datainicial and :datafinal'
      '  and (a.filialemissao = :filial or'
      '       a.filialemissao in (select f.codigo'
      '                     from filiais f'
      '                     where f.filialconsolidadoradime = :filial'
      
        '                     and (f.sped_pis_cofins or f.sped_pis_cofins' +
        '_rb or f.sped_pis_cofins_rem)))'
      '  and (a.piscst is not null or a.cofinscst is not null)'
      'order by a.data')
    RequestLive = False
    Left = 408
    Top = 400
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
    object qryAlugueis_F100documentorec: TIntegerField
      FieldName = 'documentorec'
      Required = True
    end
    object qryAlugueis_F100filial: TIntegerField
      FieldName = 'filial'
    end
    object qryAlugueis_F100dt_oper: TDateField
      FieldName = 'dt_oper'
      Required = True
    end
    object qryAlugueis_F100ind_oper: TIntegerField
      FieldName = 'ind_oper'
