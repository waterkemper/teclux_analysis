  object qryRegistroF010: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select f.codigo,'
      '       f.cnpj,'
      '       f.sped_pis_cofins'
      'from filiais f'
      'where  f.codigo in ('
      #9#9#9#9#9'select distinct piscofins_f100.filial'
      
        '                    from piscofins_f100 join filiais fpc on pisc' +
        'ofins_f100.filial = fpc.codigo'
      '                    where periodo = :periodo'
      
        '                      and (fpc.filialconsolidadoradime = :codigo' +
        ' or piscofins_f100.filial = :codigo)'
      
        '                      and (fpc.sped_pis_cofins or fpc.sped_pis_c' +
        'ofins_rb or fpc.sped_pis_cofins_rem)'
      ''
      #9#9#9#9'    union all'
      ''
      #9#9#9#9#9'select distinct piscofins_f120.filial'
      
        '                    from piscofins_f120 join filiais fpc on pisc' +
        'ofins_f120.filial = fpc.codigo'
      '                    where periodo = :periodo'
      
        '                      and (fpc.filialconsolidadoradime = :codigo' +
        ' or piscofins_f120.filial = :codigo)'
      
        '                      and (fpc.sped_pis_cofins or fpc.sped_pis_c' +
        'ofins_rb or fpc.sped_pis_cofins_rem)'
      ''
      #9#9#9#9#9
      #9#9#9#9#9'union all'
      ''
      #9#9#9#9#9'select distinct piscofins_f130.filial'
      
        '                    from piscofins_f130 join filiais fpc on pisc' +
        'ofins_f130.filial = fpc.codigo'
      '                    where periodo = :periodo'
      
        '                      and (fpc.filialconsolidadoradime = :codigo' +
        ' or piscofins_f130.filial = :codigo)'
      
        '                      and (fpc.sped_pis_cofins or fpc.sped_pis_c' +
        'ofins_rb or fpc.sped_pis_cofins_rem)'
      #9#9#9#9#9
      #9#9#9#9#9'union all'
      #9#9#9#9#9
      #9#9#9#9#9'select distinct piscofins_f150.filial'
      
        '                    from piscofins_f150 join filiais fpc on pisc' +
        'ofins_f150.filial = fpc.codigo'
      '                    where periodo = :periodo'
      
        '                      and (fpc.filialconsolidadoradime = :codigo' +
        ' or piscofins_f150.filial = :codigo)'
      
        '                      and (fpc.sped_pis_cofins or fpc.sped_pis_c' +
        'ofins_rb or fpc.sped_pis_cofins_rem)'
      #9#9#9#9#9
      #9#9#9#9#9'union all'
      #9#9#9#9#9
      #9#9#9#9#9'select distinct piscofins_f200.filial'
      
        '                    from piscofins_f200 join filiais fpc on pisc' +
