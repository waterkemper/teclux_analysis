  object qryRegistro0140: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select f.codigo,'
      '       f.suframa,'
      '       f.ind_perfil,'
      '       f.ind_ativ,'
      '       f.razao,'
      '       f.cnpj,'
      '       f.inscricaoestadual,'
      '       f.inscricaomunicipal,'
      '       f.estado,'
      '      (select c.codigoibge'
      '       from cidades c'
      '       where c.estado = f.estado'
      '         and c.codigo = f.cidade) as cidadeIBGE,'
      '       f.filialconsolidadoradime,'
      '       f.junta,'
      '       f.juntadata,'
      '      (select c.nome'
      '       from cidades c'
      '       where c.estado = f.estado'
      '         and c.codigo = f.cidade) as nomecidade,'
      '       f.IND_NAT_PJ,'
      '       f.sped_pis_cofins,'
      '       f.sped_pis_cofins_rb,'
      '       f.sped_pis_cofins_rem'
      ''
      'from filiais f'
      'where f.codigo = :codigo'
      '   or f.codigo in ((select distinct df.filialemissao'
      
        '                    from dadosfiscais df join filiais fd on df.f' +
        'ilialemissao = fd.codigo'
      
        '                    where df.data between :datainicial and :data' +
        'final'
      '                      and df.situacao = '#39'N'#39
      '                      and fd.filialconsolidadoradime = :codigo'
      
        '                      and (fd.sped_pis_cofins or fd.sped_pis_cof' +
        'ins_rb or fd.sped_pis_cofins_rem))'
      '                     union all'
      '                    (select distinct np.filial'
      
        '                     from notaspag np join filiais fnp on np.fil' +
        'ial = fnp.codigo'
      
        '                     where np.data between :datainicial and :dat' +
        'afinal'
      '                       and np.situacao = '#39'N'#39
      '                       and fnp.filialconsolidadoradime = :codigo'
      
        '                       and (fnp.sped_pis_cofins or fnp.sped_pis_' +
        'cofins_rb or fnp.sped_pis_cofins_rem)'
      '                       and :codinctrib<>2)'
      '                    union all'
      '                    (select distinct piscofins_f100.filial'
      
        '                     from piscofins_f100 join filiais fpc on pis' +
        'cofins_f100.filial = fpc.codigo'
      
        '                     where DT_OPER between :datainicial and :dat' +
        'afinal'
      '                       and fpc.filialconsolidadoradime = :codigo'
      
        '                       and (fpc.sped_pis_cofins or fpc.sped_pis_' +
        'cofins_rb or fpc.sped_pis_cofins_rem))'
      '                     union all'
      '                    (select distinct piscofins_p100.filial'
      
        '                     from piscofins_p100 join filiais fpc on pis' +
        'cofins_p100.filial = fpc.codigo'
      
        '                     where DT_INI between :datainicial and :data' +
        'final'
      '                       and fpc.filialconsolidadoradime = :codigo'
      
        '                       and (fpc.sped_pis_cofins_rb or fpc.sped_p' +
        'is_cofins_rem))'
      '                       )'
      '/* VERIFICAR O TIPO DE NOTA C/ L'#218'CIO */')
    RequestLive = False
    Left = 32
    Top = 53
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codinctrib'
        ParamType = ptUnknown
      end>
