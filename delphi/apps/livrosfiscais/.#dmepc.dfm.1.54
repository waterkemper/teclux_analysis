      Required = True
      Size = 60
    end
    object qryRegistro0140cnpj: TStringField
      FieldName = 'cnpj'
      Size = 14
    end
    object qryRegistro0140inscricaoestadual: TStringField
      FieldName = 'inscricaoestadual'
    end
    object qryRegistro0140inscricaomunicipal: TStringField
      FieldName = 'inscricaomunicipal'
    end
    object qryRegistro0140estado: TStringField
      FieldName = 'estado'
      Required = True
      Size = 2
    end
    object qryRegistro0140cidadeibge: TIntegerField
