  object qryRegistroA170: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkFields = 'chave=chave;ind_oper=ind_oper'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroA100
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select df.numero '#9#9#9'       as chave,'
      '       df.filialemissao as filial,'
      '       cast(1 as varchar(1)) '#9#9'       as ind_oper,'
      '       cast(null as integer)                   as num_item,'
      
        '       cast(('#39'S'#39'||cast(sdf.servico as varchar)) as varchar(60)) ' +
        'as cod_item,'
      
        '       cast(RetiraBrancoePipeeASCII255(s.descricao) as varchar(2' +
        '55)) as descr_compl,'
      '       sdf.valorservico * sdf.quantidade  as vl_item,'
      '       0.00                     as vl_desc,'
      '       cast(null as char(2)) as NAT_BC_CRED, /*VERIFICAR */'
      #9'   cast(0 as integer) as IND_ORIG_CRED,'
      #9'   sdf.piscst as cst_pis,'
      #9'   sdf.pisbasecalculo as VL_BC_PIS,'
      ''
      #9'   sdf.aliquotapis as ALIQ_PIS,'
      #9'   sdf.pisvalor as VL_PIS,'
      #9'   sdf.piscst as cst_cofins,'
      #9'   sdf.cofinsbasecalculo as VL_BC_COFINS,'
      #9'   sdf.aliquotacofins as ALIQ_COFINS,'
      #9'   sdf.cofinsvalor as VL_COFINS,'
      #9'   cast(null as varchar(60)) as COD_CTA,'
      '  '#9'   cast(null as varchar(60)) as COD_CCUS'
      #9'   '#9'   '
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      '     join servicosdadosfiscais sdf'
      '          join servicos s'
      '          on sdf.servico = s.codigo'
      '     on df.numero = sdf.dadofiscal'
      'where df.numero = sdf.dadofiscal'
      '  and df.data between :datainicial and :datafinal'
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  /*and df.CodigoFiscal < 8000*/'
      '  and df.situacao = '#39'N'#39
      '  and (df.filialemissao = :filial or'
      '       df.filialemissao in (select f.codigo'
      '                              from filiais f'
      
        '                              where f.filialconsolidadoradime = ' +
        ':filial'
      
        '                              and (f.sped_pis_cofins or f.sped_p' +
        'is_cofins_rb or f.sped_pis_cofins_rem)))'
      '  and not coalesce(df.notavinculada,false)'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)')
    RequestLive = False
    Left = 223
    Top = 230
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
