  object qryRegistroC110: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkFields = 'chave=chave, ind_oper=ind_oper, filial=filial'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroC100
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select distinct chave, filial, ind_oper, txt'
      'from'
      '('
      'select df.numero as chave, df.filialemissao as filial,'
      '       cast(1 as varchar(1)) as ind_oper,'
      
        '       cast(RetiraBrancoePipeeASCII255(df.observacoes) as varcha' +
        'r(255)) as txt'
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      'where df.data between :datainicial and :datafinal'
      '  and (btrim(df.observacoes)<>'#39#39')'
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and df.CodigoFiscal < 8000'
      '  and df.situacao = '#39'N'#39
      '  and (df.filialemissao = :filial or'
      '       df.filialemissao in (select f.codigo'
      '                              from filiais f'
      
        '                              where f.filialconsolidadoradime = ' +
        ':filial'
      
        '                              and (f.sped_pis_cofins or f.sped_p' +
        'is_cofins_rb or f.sped_pis_cofins_rem)))'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      'union all'
      'select df.numero as chave, df.filialemissao as filial,'
      '       cast(1 as varchar(1)) as ind_oper,'
      
        '       cast(RetiraBrancoePipeeASCII255(df.observacoescomplementa' +
        'r) as varchar(255)) as txt'
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      'where df.data between :datainicial and :datafinal'
      '  and (btrim(df.observacoescomplementar)<>'#39#39')'
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and df.CodigoFiscal < 8000'
      '  and df.situacao = '#39'N'#39
      '  and (df.filialemissao = :filial or'
      '       df.filialemissao in (select f.codigo'
      '                              from filiais f'
      
        '                              where f.filialconsolidadoradime = ' +
        ':filial'
      
        '                              and (f.sped_pis_cofins or f.sped_p' +
        'is_cofins_rb or f.sped_pis_cofins_rem)))'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      'union all'
      'select df.numero as chave, df.filialemissao as filial,'
      '       cast(1 as varchar(1)) as ind_oper,'
      
        '       cast(RetiraBrancoePipeeASCII255(df.infcomplementar) as va' +
        'rchar(255)) as txt'
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      'where df.data between :datainicial and :datafinal'
      '  and (btrim(df.infcomplementar)<>'#39#39')'
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and df.CodigoFiscal < 8000'
      '  and df.situacao = '#39'N'#39
      '  and (df.filialemissao = :filial or'
      '       df.filialemissao in (select f.codigo'
      '                              from filiais f'
      
        '                              where f.filialconsolidadoradime = ' +
        ':filial'
      
        '                              and (f.sped_pis_cofins or f.sped_p' +
        'is_cofins_rb or f.sped_pis_cofins_rem)))'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      'union all'
      'select df.numero as chave, df.filialemissao as filial,'
      '       cast(1 as varchar(1)) as ind_oper,'
      
        '       cast(:ctREFERENTECUPOMFISCAL||cast(c.numero as varchar) a' +
        's varchar(255)) as txt'
      'from (dadosfiscais df'
      '       join (notas n'
      '            join cupons c'
      '            on c.dadofiscal = n.dadofiscalvinculado)'
      '       on df.numero = n.dadofiscal)'
      'where df.data between :datainicial and :datafinal'
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and df.CodigoFiscal < 8000'
      '  and df.situacao = '#39'N'#39
      '  and (df.filialemissao = :filial or'
      '       df.filialemissao in (select f.codigo'
      '                              from filiais f'
      
        '                              where f.filialconsolidadoradime = ' +
        ':filial'
      
        '                              and (f.sped_pis_cofins or f.sped_p' +
        'is_cofins_rb or f.sped_pis_cofins_rem)))'
      
        '  /*and (n.filial,n.serie) in (select sf.filial,sf.valor from se' +
        'riesfiliais sf where sf.ativa)*/'
      'union all'
      'select np.codigo as chave, np.filial,'
      '       cast(0 as varchar(1)) as ind_oper,'
      
        '       cast(RetiraBrancoePipeeASCII255(np.observacoes) as varcha' +
        'r(255)) as txt'
      'from notaspag np'
      'where np.data between :datainicial and :datafinal'
      '  and np.situacao='#39'N'#39
      '  and (btrim(np.observacoes)<>'#39#39')'
      '  and np.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and np.situacao = '#39'N'#39
      '  and (np.filial = :filial or'
      '       np.filial in (select f.codigo'
      '                     from filiais f'
      '                     where f.filialconsolidadoradime = :filial'
      
        '                     and (f.sped_pis_cofins or f.sped_pis_cofins' +
        '_rb or f.sped_pis_cofins_rem)))'
      
        '  and (:codinctrib<>2 or (:codinctrib=2 and mod(np.codigofiscal,' +
        '1000) in ('
      ''
      ' 201, /* Devolu'#231#227'o de venda de produ'#231#227'o do estabelecimento */'
      
        ' 202, /* Devolu'#231#227'o de venda de mercadoria adquirida ou recebida ' +
        'de terceiros */'
      
        ' 410, /* Devolu'#231#227'o de venda de produ'#231#227'o do estabelecimento em op' +
        'era'#231#227'o com produto sujeito ao regime de substitui'#231#227'o tribut'#225'ria ' +
        '*/'
      
        ' 411  /* Devolu'#231#227'o de venda de mercadoria adquirida ou recebida ' +
        'de terceiros em opera'#231#227'o com mercadoria sujeita ao regime de sub' +
        'stitui'#231#227'o tribut'#225'ria */'
      ''
      '  )))'
      ''
      'union all'
      'select np.codigo as chave, np.filial,'
      '       cast(0 as varchar(1)) as ind_oper,'
      
        '       cast(RetiraBrancoePipeeASCII255(np.infcomplementar) as va' +
        'rchar(255)) as txt'
      'from notaspag np'
      'where np.data between :datainicial and :datafinal'
      '  and np.situacao='#39'N'#39
      '  and (btrim(np.infcomplementar)<>'#39#39')'
      '  and np.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and np.situacao = '#39'N'#39
      '  and (np.filial = :filial or'
      '       np.filial in (select f.codigo'
      '                     from filiais f'
      '                     where f.filialconsolidadoradime = :filial'
      
        '                     and (f.sped_pis_cofins or f.sped_pis_cofins' +
        '_rb or f.sped_pis_cofins_rem)))'
      ''
      
        '  and (:codinctrib<>2 or (:codinctrib=2 and mod(np.codigofiscal,' +
        '1000) in ('
      ''
      ' 201, /* Devolu'#231#227'o de venda de produ'#231#227'o do estabelecimento */'
      
        ' 202, /* Devolu'#231#227'o de venda de mercadoria adquirida ou recebida ' +
        'de terceiros */'
      
        ' 410, /* Devolu'#231#227'o de venda de produ'#231#227'o do estabelecimento em op' +
        'era'#231#227'o com produto sujeito ao regime de substitui'#231#227'o tribut'#225'ria ' +
        '*/'
      
        ' 411  /* Devolu'#231#227'o de venda de mercadoria adquirida ou recebida ' +
        'de terceiros em opera'#231#227'o com mercadoria sujeita ao regime de sub' +
        'stitui'#231#227'o tribut'#225'ria */'
      ''
      '  )))'
      '  '
      ') as temp'
      'where coalesce(txt,'#39#39')<>'#39#39
      'order by chave, filial, ind_oper, txt')
    RequestLive = False
    Left = 404
    Top = 189
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ctREFERENTECUPOMFISCAL'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codinctrib'
        ParamType = ptUnknown
      end>
    object qryRegistroC110chave: TIntegerField
      FieldName = 'chave'
      DisplayFormat = '0'
    end
    object qryRegistroC110filial: TIntegerField
      FieldName = 'filial'
    end
    object qryRegistroC110ind_oper: TStringField
      FieldName = 'ind_oper'
      Size = 1
    end
    object qryRegistroC110txt: TStringField
      FieldName = 'txt'
      Size = 255
    end
  end
  object qryRegistroC120: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkFields = 'chave=chave, ind_oper=ind_oper, filial=filial'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroC100
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select np.codigo as chave,'
      '       np.filial,'
      '       cast(0 as varchar(1)) as ind_oper,'
      '       0 as cod_doc_imp,'
      '       np.ndi as num_doc_imp,'
      '       coalesce((select sum(a.pis)'
      '                 from adicoes a'
      
        '                 where a.dadoimportacao = di.numero),0) as pis_i' +
        'mp,'
      '       coalesce((select sum(a.cofins)'
      '                 from adicoes a'
      
        '                 where a.dadoimportacao = di.numero),0) as cofin' +
        's_imp'
      'from notaspag np'
      '     join dadosimportacoes di'
      '     on np.ndi = di.numero'
      'where np.data between :datainicial and :datafinal'
      '  and np.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and np.situacao = '#39'N'#39
      '  and (np.filial = :filial or'
      '       np.filial in (select f.codigo'
      '                     from filiais f'
      '                     where f.filialconsolidadoradime = :filial'
      
        '                     and (f.sped_pis_cofins or f.sped_pis_cofins' +
        '_rb or f.sped_pis_cofins_rem)))'
      '                     '
      
        '  and (:codinctrib<>2 or (:codinctrib=2 and mod(np.codigofiscal,' +
        '1000) in ('
      ''
      ' 201, /* Devolu'#231#227'o de venda de produ'#231#227'o do estabelecimento */'
      
        ' 202, /* Devolu'#231#227'o de venda de mercadoria adquirida ou recebida ' +
        'de terceiros */'
      
        ' 410, /* Devolu'#231#227'o de venda de produ'#231#227'o do estabelecimento em op' +
        'era'#231#227'o com produto sujeito ao regime de substitui'#231#227'o tribut'#225'ria ' +
        '*/'
      
        ' 411  /* Devolu'#231#227'o de venda de mercadoria adquirida ou recebida ' +
        'de terceiros em opera'#231#227'o com mercadoria sujeita ao regime de sub' +
        'stitui'#231#227'o tribut'#225'ria */'
      ''
      '  )))'
      '')
    RequestLive = False
    Left = 410
    Top = 238
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codinctrib'
        ParamType = ptUnknown
      end>
