  object qryRegistroD100: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkFields = 'codigo = filial'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroD010
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select np.codigo as chave,'
      '       np.filial,'
      '       cast(0 as varchar(1)) as ind_oper,'
      '       case when permitirimprimir then'
      '            cast(0 as varchar(1))  /* emiss'#227'o pr'#243'pria */'
      '       else cast(1 as varchar(1))  /* terceiros       */'
      '       end as ind_emit,'
      
        '       cast((np.tipofornecedor||cast(np.fornecedor as varchar)) ' +
        'as varchar(60)) as cod_part,'
      '       np.modelodocto as cod_mod,'
      
        '       case when np.situacao = '#39'C'#39' '#9#9'       then cast('#39'02'#39' as va' +
        'rchar(2))  /* cancelado */'
      
        '       else                                                 cast' +
        '('#39'00'#39' as varchar(2))  /* regular   */'
      '       end as cod_sit,'
      '       np.serie as ser,'
      '       cast(null as varchar(4)) as sub,'
      '       np.numero as num_doc,'
      '       np.chv_nfe as chv_cte,'
      '       np.data as dt_doc,'
      '       np.emissao as dt_a_p,'
      '       cast(null as varchar(1)) as TP_CTe,'
      '       cast(null as varchar(44)) as chv_cte_ref,'
      '       np.valornota as vl_doc,'
      '       coalesce(np.desconto,0) as vl_desc,'
      '       cast(2 as integer) as ind_frt,'
      '       np.valorservicos as vl_serv,'
      '       (select sum(cnp.base)'
      '        from calculosnotaspag cnp'
      '        where cnp.codigonota = np.codigo'
      '          and cnp.tipo='#39'M'#39') as vl_bc_icms,'
      '       (select sum(cnp.valor)'
      '        from calculosnotaspag cnp'
      '        where cnp.codigonota = np.codigo'
      '         and cnp.tipo='#39'M'#39') as vl_icms,'
      '       (select sum(cnp.isentas)+sum(cnp.outras)'
      '        from calculosnotaspag cnp'
      '        where cnp.codigonota = np.codigo'
      '         and cnp.tipo='#39'M'#39') as vl_nt,'
      '         /*'
      '       (select sum(pnp.icmsbasecalculo)'
      '        from produtosnotaspag pnp'
      '        where pnp.codigonota = np.codigo) as vl_bc_icms,'
      '       (select sum(pnp.icmsvalor)'
      '        from produtosnotaspag pnp'
      '        where pnp.codigonota = np.codigo) as vl_icms,'
      '        0.00 as vl_nt,'
      '        */'
      
        '       cast(RetiraBrancoePipeeASCII255(np.observacoes) as varcha' +
        'r(255)) as txt'
      'from notaspag np'
      'where np.data between :datainicial and :datafinal'
      '  and (np.filial = :filial or'
      '       np.filial in (select f.codigo'
      '                     from filiais f'
      '                     where f.filialconsolidadoradime = :filial'
      
        '                     and (f.sped_pis_cofins or f.sped_pis_cofins' +
        '_rb or f.sped_pis_cofins_rem)))'
      '                     '
      '  and np.situacao='#39'N'#39
      '  and cast(coalesce(np.modelodocto,'#39'01'#39') as varchar(2)) in'
      '  ('#39'07'#39','#39'08'#39','#39'8B'#39','#39'09'#39','#39'10'#39','#39'11'#39','#39'26'#39','#39'27'#39','#39'57'#39')'
      '  and :codinctrib<>2')
    RequestLive = False
    Left = 244
    Top = 389
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codinctrib'
        ParamType = ptUnknown
      end>
