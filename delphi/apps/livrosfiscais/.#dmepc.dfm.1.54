  object qryRegistroC010: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select f.codigo,'
      '       f.cnpj,'
      
        '       cast(2 as int2) as ND_ESCRI, /* VERIFICAR O QUE VAI NESTE' +
        ' CAMPO*/'
      '       f.sped_pis_cofins'
      'from filiais f'
      'where  f.codigo in ((select distinct df.filialemissao'
      
        '                    from dadosfiscais df join filiais fd on df.f' +
        'ilialemissao = fd.codigo'
      
        '                    where df.data between :datainicial and :data' +
        'final'
      
        '                      and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39 +
        ')'
      '                      and df.CodigoFiscal < 8000'
      
        '                      and (fd.filialconsolidadoradime = :codigo ' +
        'or df.filialemissao = :codigo)'
      
        '                      and (fd.sped_pis_cofins or fd.sped_pis_cof' +
        'ins_rb or fd.sped_pis_cofins_rem))'
      '                     union all'
      '                    (select distinct np.filial'
      
        '                     from notaspag np join filiais fnp on np.fil' +
        'ial = fnp.codigo'
      
        '                     where np.data between :datainicial and :dat' +
        'afinal'
      '                       and np.situacao = '#39'N'#39
      
        '                       and ( cast(coalesce(np.modelodocto,'#39'01'#39') ' +
        'as varchar(2)) in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39') or  /* C100 */'
      
        '                             cast(coalesce(np.modelodocto,'#39'01'#39') ' +
        'as varchar(2)) in ('#39'02'#39','#39'2D'#39','#39'2E'#39','#39'59'#39') or    /* C395 */'
      
        '                             cast(coalesce(np.modelodocto,'#39'01'#39') ' +
        'as varchar(2)) in ('#39'06'#39','#39'28'#39', '#39'29'#39')) /* C500 */'
      ''
      
        '                       and (fnp.filialconsolidadoradime = :codig' +
        'o or np.filial = :codigo)'
      
        '                       and (fnp.sped_pis_cofins or fnp.sped_pis_' +
        'cofins_rb or fnp.sped_pis_cofins_rem)'
      ''
      
        '                       and (:codinctrib<>2 or (:codinctrib=2 and' +
        ' mod(np.codigofiscal,1000) in ('
      ''
      
        '                       201, /* Devolu'#231#227'o de venda de produ'#231#227'o do' +
        ' estabelecimento */'
      
        '                       202, /* Devolu'#231#227'o de venda de mercadoria ' +
        'adquirida ou recebida de terceiros */'
      
        '                       410, /* Devolu'#231#227'o de venda de produ'#231#227'o do' +
        ' estabelecimento em opera'#231#227'o com produto sujeito ao regime de su' +
        'bstitui'#231#227'o tribut'#225'ria */'
      
        '                       411  /* Devolu'#231#227'o de venda de mercadoria ' +
        'adquirida ou recebida de terceiros em opera'#231#227'o com mercadoria su' +
        'jeita ao regime de substitui'#231#227'o tribut'#225'ria */'
      ''
      '                       )))'
      ''
      '                       and exists (select pnp.codigonota'
      '                                    from produtosnotaspag pnp'
      
        '                                    where pnp.codigonota = np.co' +
        'digo limit 1)))')
    RequestLive = False
    Left = 408
    Top = 53
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codinctrib'
        ParamType = ptUnknown
      end>
