      FieldName = 'chave'
    end
    object qryRegistroC396filial: TIntegerField
      FieldName = 'filial'
    end
    object qryRegistroC396cod_item: TStringField
      FieldName = 'cod_item'
      Size = 60
    end
    object qryRegistroC396vl_item: TFloatField
      FieldName = 'vl_item'
    end
    object qryRegistroC396vl_desc: TFloatField
      FieldName = 'vl_desc'
    end
