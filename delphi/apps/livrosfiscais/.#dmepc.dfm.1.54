  object qryRecebimentosImoveis_F200: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select ind_oper, unid_imob, ident_emp,'
      
        '       DESC_UNID_IMOB, NUM_CONT, CPF_CNPJ_ADQU, DT_OPER, VL_TOT_' +
        'VEND, VL_REC_ACUM,'
      '       sum(VL_TOT_REC)  as VL_TOT_REC,'
      '       CAST('#39'01'#39' as char(2)) as cst_pis,'
      '       CAST('#39'01'#39' as char(2)) as cst_cofins,'
      
        '       cast(replace((select parametros_valor('#39'PIS Aliquota Imove' +
        'is'#39')),'#39','#39','#39'.'#39') as numeric(5,2)) as ALIQ_PIS,'
      
        '       cast(replace((select parametros_valor('#39'COFINS Aliquota Im' +
        'oveis'#39')),'#39','#39','#39'.'#39') as numeric(5,2)) as ALIQ_COFINS,'
      '       ind_nat_emp, filial, situacao'
      'from'
      '('
      'select case when habite_se is not null then'
      '            case when (select count(*)'
      '                       from parcelasimoveis pin'
      '                       where pin.contrato = vi.contrato'
      
        '                         and pin.datavencto > vi.data) = 0 then ' +
        'cast('#39'01'#39' as char(2)) /* 01 '#8211' Venda a Vista de Unidade Conclu'#237'da' +
        ' */'
      
        '                  else                                         c' +
        'ast('#39'02'#39' as char(2)) /* 02 '#8211' Venda a Prazo de Unidade Conclu'#237'da ' +
        '*/'
      '                  end'
      '       else'
      '            case when (select count(*)'
      '                       from parcelasimoveis pin'
      '                       where pin.contrato = vi.contrato'
      
        '                         and pin.datavencto > vi.data) = 0 then ' +
        'cast('#39'03'#39' as char(2)) /* 03 '#8211' Venda a Vista de Unidade em Constr' +
        'u'#231#227'o; */'
      
        '                  else                                         c' +
        'ast('#39'04'#39' as char(2)) /* 04 '#8211' Venda a Prazo de Unidade em Constru' +
        #231#227'o */'
      '                  end'
      '       end as IND_OPER,'
      ''
      '       e.unid_imob,'
      ''
      '       e.nome as IDENT_EMP,'
      ''
      
        '       (select '#39'BL '#39'||b.descricao||'#39' UN '#39'||ti.nome||'#39' NR '#39'||i.nu' +
        'mero'
      '        from imoveisvendidos iv'
      '             join imoveis i'
      '                  join blocos b'
      '                  on i.bloco = b.codigo'
      ''
      '                  join tiposunidades ti'
      '                  on i.unidade = ti.codigo'
      ''
      '             on iv.bloco = i.bloco'
      '             and iv.numero = i.numero'
      '             and iv.unidade = i.unidade'
      '        where iv.contrato = vi.contrato'
      
        '          and coalesce(iv.precovenda,0)<> 0 order by ordem limit' +
        ' 1) as DESC_UNID_IMOB,'
      ''
      '       vi.contrato as NUM_CONT,'
      ''
      '       (select vf.pessoanumero'
      '        from compradores c'
      '             join vfornecedores vf'
      '             on c.cliente = vf.codigo'
      '             and c.tipocliente = vf.tipo'
      '        where c.contrato = vi.contrato'
      '           and c.principal limit 1) as CPF_CNPJ_ADQU,'
      ''
      '        vi.data as DT_OPER,'
      ''
      '       vi.valortotal as  VL_TOT_VEND,'
      ''
      '       (select sum(pia.valorhistorico)'
      '        from parcelasimoveis pia'
      '        where pia.contrato = vi.contrato'
      
        '          and pia.datapagto < (cast(:datainicial as date)-1)) as' +
        ' VL_REC_ACUM,   /*parametro UltimaDiaMesAnterior */'
      ''
      '       pi.valorhistorico as VL_TOT_REC,'
      ''
      '       e.ind_nat_emp,'
      '       vi.filial,'
      '       vi.situacao'
      ''
      'from vendasimoveis vi'
      '     join empreendimentos e'
      '     on vi.empreendimento = e.codigo'
      ''
      '     join parcelasimoveis pi'
      '     on pi.contrato = vi.contrato'
      ''
      'where pi.datapagto between :datainicial and :datafinal'
      '  and vi.situacao <> '#39'R'#39
      '  and (vi.filial = :filial or'
      '       vi.filial in (select f.codigo'
      '                     from filiais f'
      '                     where f.filialconsolidadoradime = :filial'
      
        '                     and (f.sped_pis_cofins or f.sped_pis_cofins' +
        '_rb or f.sped_pis_cofins_rem)))'
      ''
      ') as selecao'
      ''
      
        'group by ind_oper, unid_imob, ident_emp, DESC_UNID_IMOB, NUM_CON' +
        'T, CPF_CNPJ_ADQU, DT_OPER, VL_TOT_VEND, VL_REC_ACUM, ind_nat_emp' +
        ', filial, situacao'
      'order by num_cont')
    RequestLive = False
    Left = 408
    Top = 456
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
    object qryRecebimentosImoveis_F200ind_oper: TStringField
      FieldName = 'ind_oper'
      Size = 2
    end
    object qryRecebimentosImoveis_F200unid_imob: TStringField
      FieldName = 'unid_imob'
      Size = 2
