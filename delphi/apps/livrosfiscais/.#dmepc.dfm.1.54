  object qryRegistro0190: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkFields = 'codigo = filial'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistro0140
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select u.codigo as unid,'
      '       u.descricao as descr,'
      '       unidadesprodutos.filial'
      'from'
      '('
      
        'select distinct coalesce(c.unidade,'#39'UN'#39') as unidade, df.filialem' +
        'issao as filial'
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      '     join produtosdadosfiscais pdf'
      '     on df.numero = pdf.dadofiscal'
      '     join produtos p on pdf.produto = p.codigo'
      '     join caracteristicas c on p.caracteristica = c.codigo'
      'where df.numero = pdf.dadofiscal'
      '  and df.data between :DataInicial and :DataFinal'
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and df.CodigoFiscal < 8000'
      '  and df.situacao = '#39'N'#39
      '  and (df.filialemissao = :filial or'
      '       df.filialemissao in (select f.codigo'
      '                            from filiais f'
      
        '                            where f.filialconsolidadoradime = :f' +
        'ilial'
      
        '                            and (f.sped_pis_cofins or f.sped_pis' +
        '_cofins_rb or f.sped_pis_cofins_rem)))'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      ''
      'union'
      'select distinct coalesce(pnp.unidade,'#39'UN'#39') as unidade, np.filial'
      'from notaspag np'
      '     join produtosnotaspag pnp'
      '     on np.codigo = pnp.codigonota'
      '/*   join produtos p on pnp.produto = p.codigo'
      '     join caracteristicas c on p.caracteristica = c.codigo */'
      'where np.data between :DataInicial and :DataFinal'
      '  and np.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and np.situacao = '#39'N'#39
      '  /*and not (np.permitirimprimir and np.modelodocto='#39'55'#39')*/'
      '  and (np.filial = :filial or'
      '      np.filial in (select f.codigo'
      '                    from filiais f'
      '                    where f.filialconsolidadoradime = :filial'
      
        '                    and (f.sped_pis_cofins or f.sped_pis_cofins_' +
        'rb or f.sped_pis_cofins_rem)))'
      '  and :codinctrib <> 2                  '
      ''
      'union'
      'Select distinct coalesce(c.unidade,'#39'UN'#39') as unidade, dc.filial'
      'from dadositemcupom dic'
      '     join dadoscupom dc'
      '       on dc.filial = dic.filial'
      '       and dc.num_usu = dic.num_usu'
      '       and dc.cro = dic.cro'
      '       and dc.coo = dic.coo'
      '       join detalhecupom dlc'
      '         on dc.filial = dlc.filial'
      '         and dc.num_usu = dlc.num_usu'
      '         and dc.cro = dlc.cro'
      '         and dc.coo = dlc.coo'
      '     join produtos p on cast(dic.cod_item as bigint) = p.codigo'
      '     join caracteristicas c on p.caracteristica = c.codigo'
      
        'where cast(dlc.dt_ini as date) between :datainicial and :datafin' +
        'al'
      '  and (dc.filial = :filial or'
      '       dc.filial in (select f.codigo'
      '                    from filiais f'
      '                    where f.filialconsolidadoradime = :filial'
      
        '                    and (f.sped_pis_cofins or f.sped_pis_cofins_' +
        'rb or f.sped_pis_cofins_rem)))'
      ''
      
        ') as unidadesprodutos join unidades u on unidadesprodutos.unidad' +
        'e = u.codigo'
      'where unidadesprodutos.unidade = u.codigo')
    RequestLive = False
    Left = 36
    Top = 172
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'DataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataFinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codinctrib'
        ParamType = ptUnknown
      end>
    object qryRegistro0190unid: TStringField
      FieldName = 'unid'
      Size = 8
    end
    object qryRegistro0190descr: TStringField
      FieldName = 'descr'
      Size = 30
    end
    object qryRegistro0190filial: TIntegerField
      FieldName = 'filial'
    end
  end
  object qryRegistro0200: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkFields = 'codigo = filial'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistro0140
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '('
      'select distinct'
      
        '       cast(('#39'S'#39'||cast(sdf.servico as varchar)) as varchar(60)) ' +
        'as cod_item, df.filialemissao as filial,'
      ''
      '       (select RetiraBrancoePipeeASCII255(s.descricao)'
      '        from servicos s'
      '        where s.codigo =  sdf.servico) as descr_item,'
      '        '
      '       cast(null as varchar(30)) as cod_barra,'
      
        '       cast(null as varchar(60)) as cod_ant_item, /* **n'#227'o exist' +
        'e ** */'
      '       cast('#39'UN'#39' as varchar(6)) as unid_inv,'
      '       cast('#39'09'#39' as varchar(2)) as tipo_item,'
      '       cast(null as varchar(8)) as cod_ncm,'
      '       cast(null as varchar(3)) as ex_ipi,'
      '       cast(0 as integer) as cod_gen,'
      '       (select s.codigolcp116'
      '        from servicos s'
      '        where s.codigo =  sdf.servico) as cod_lst,'
      '       cast(null as numeric(5,2)) as aliq_icms'
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      '     join servicosdadosfiscais sdf'
      '     on df.numero = sdf.dadofiscal'
      'where df.numero = sdf.dadofiscal'
      '  and df.data between :datainicial and :datafinal'
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '/*  and df.CodigoFiscal < 8000*/'
      '  and df.situacao = '#39'N'#39
      '  and (df.filialemissao = :filial or'
      '       df.filialemissao in (select f.codigo'
      '                            from filiais f'
      
        '                            where f.filialconsolidadoradime = :f' +
        'ilial'
      
        '                            and (f.sped_pis_cofins or f.sped_pis' +
        '_cofins_rb or f.sped_pis_cofins_rem)))'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      ')'
      'union all'
      '('
      
        'Select cast(('#39'P'#39'||cast(p.codigo as varchar)) as varchar(60)) as ' +
        'cod_item, produtos_diversos.filial,'
      '       RetiraBrancoePipeeASCII255(p.descricao) as descr_item,'
      '       (select pcb.codigobarras'
      '        from produtoscodigobarras pcb'
      '        where pcb.produto = p.codigo limit 1) as cod_barra,'
      
        '       cast(null as varchar(60)) as cod_ant_item, /* **n'#227'o exist' +
        'e ** */'
      '       c.unidade as unid_inv,'
      '       coalesce(c.tipoproduto,'#39'00'#39') as tipo_item,'
      '       /*n'#227'o '#233' aceito este 99 deve ter 8 digitos */'
      '       case when (select ipi.classificacaofiscal'
      '                  from ipi'
      
        '                  where ipi.codigo = c.ipi) = '#39'99'#39' then cast(nul' +
        'l as varchar(8))'
      '       else'
      '                 (select ipi.classificacaofiscal'
      '                  from ipi'
      '                  where ipi.codigo = c.ipi) end as cod_ncm,'
      ''
      '      (select ipi.extipi'
      '       from ipi'
      '       where ipi.codigo = c.ipi) as ex_ipi,'
      '       61 as cod_gen,'
      '       cast(null as varchar(4)) as cod_lst, /* **verificar** */'
      '      (select ei.valor'
      '       from estadosicms ei'
      '       where icms = c.icms'
      '         and ei.estado = :estado) as aliq_icms'
      'from produtos p'
      '     join caracteristicas c'
      '     on p.caracteristica = c.codigo'
      ''
      '     join'
      '     /*where p.codigo in*/ ('
      'select distinct i.cod_item, filial'
      'from'
      '('
      
        '/* MOVIMENTO SI os bens entraram antes do periodo de apuracao e ' +
        'possuem saldo a apropriar */'
      '('
      'select i.codigobem as cod_item, i.filialcontribuinte as filial'
      'from'
      '('
      'select i.numero,'
      ' i.codigobem,'
      ' i.filialcontribuinte'
      'from imobilizado i'
      ' join notaspag np'
      ' on i.codigonota = np.codigo'
      ' join produtosnotaspag pnp'
      ' on pnp.codigonota = i.codigonota'
      ' and pnp.produto = i.codigobem'
      ' and pnp.filial = i. filialcontribuinte'
      'where i.data_entrada < :datainicial'
      ' and i.filialcontribuinte = :Filial'
      ''
      ''
      ' and (i.filialcontribuinte = :filial or'
      '       i.filialcontribuinte in (select f.codigo'
      '                            from filiais f'
      
        '                            where f.filialconsolidadoradime = :f' +
        'ilial'
      
        '                            and (f.sped_pis_cofins or f.sped_pis' +
        '_cofins_rb or f.sped_pis_cofins_rem)))'
      ' '
      ' and exists (select aii.numeroimobilizado'
      ' from apropriacaoicmsimobilizado aii'
      ' where aii.numeroimobilizado = i.numero'
      ' and aii.periodo between :datainicial and :datafinal'
      ' and aii.dataapropriacao between :datainicial and :datafinal)'
      ') as i join'
      ' (select i2.numero,'
      ' aii2.sequencia,'
      ' aii2.valor'
      
        ' from imobilizado i2 join apropriacaoicmsimobilizado aii2 on i2.' +
        'numero = aii2.numeroimobilizado'
      ' where aii2.periodo between :datainicial and :datafinal'
      ' and i2.filialcontribuinte = :filial'
      
        ' and aii2.dataapropriacao between :datainicial and :datafinal) a' +
        's i2 on i.numero = i2.numero'
      ')'
      'union'
      
        '/* MOVIMENTO IM o bem entrou no periodo de apura'#231#227'o e n'#227'o '#233' tran' +
        'sf. do ativo circulante*/'
      '('
      'select I.codigobem as cod_item, i.filialcontribuinte as filial'
      'from imobilizado i'
      ' join apropriacaoicmsimobilizado aii'
      ' on i.numero = aii.numeroimobilizado'
      ' join notaspag np'
      ' on i.codigonota = np.codigo'
      ' join produtosnotaspag pnp'
      ' on pnp.codigonota = i.codigonota'
      ' and pnp.produto = i.codigobem'
      ' and pnp.filial = i. filialcontribuinte'
      'where i.data_entrada between :datainicial and :datafinal'
      ' '
      ' and (i.filialcontribuinte = :filial or'
      '      i.filialcontribuinte in (select f.codigo'
      '                            from filiais f'
      
        '                            where f.filialconsolidadoradime = :f' +
        'ilial'
      
        '                            and (f.sped_pis_cofins or f.sped_pis' +
        '_cofins_rb or f.sped_pis_cofins_rem)))'
      ' '
      ' and aii.periodo between :datainicial and :datafinal'
      ' and aii.dataapropriacao between :datainicial and :datafinal'
      ' and not exists (select pnp.codigonota'
      ' from notaspag np'
      ' join produtosnotaspag pnp'
      ' on np.codigo = pnp.codigonota'
      ' where np.codigo = pnp.codigonota'
      ' and i.codigonota = np.codigo'
      ' /*'
      ' and i.fornecedor_entrada = np.fornecedor'
      ' and i.tipofornecedor_entrada = np.tipofornecedor'
      ' and i.serie_entrada = np.serie'
      ' and i.numero_entrada = np.numero'
      ' */'
      ' and pnp.produto = i.codigobem'
      ' and pnp.filial = i.filialcontribuinte'
      ' /*and i.numitemdocfiscal = pnp.numero*/'
      ' and mod(pnp.codigofiscal,1000)=552'
      ' and np.data between :datainicial and :datafinal)'
      ')'
      'UNION ALL'
      '('
      
        '/* MOVIMENTO MC o bem entrou no periodo de apura'#231#227'o e '#233' transf. ' +
        'do ativo circulante*/'
      'select i.codigobem as cod_item, i.filialcontribuinte as filial'
      'from imobilizado i'
      ' join notaspag np on i.codigonota = np.codigo'
      ' /*i.fornecedor_entrada = np.fornecedor'
      ' and i.tipofornecedor_entrada = np.tipofornecedor'
      ' and i.serie_entrada = np.serie'
      ' and i.numero_entrada = np.numero*/'
      ' join produtosnotaspag pnp on i.codigonota = pnp.codigonota'
      ' and pnp.produto = i.codigobem'
      ' and pnp.filial = i.filialcontribuinte'
      ' /*and i.numitemdocfiscal = pnp.numero*/'
      
        ' join apropriacaoicmsimobilizado aii on i.numero = aii.numeroimo' +
        'bilizado'
      'where i.data_entrada between :datainicial and :datafinal'
      ' '
      ' and (i.filialcontribuinte = :filial or'
      '      i.filialcontribuinte in (select f.codigo'
      '                            from filiais f'
      
        '                            where f.filialconsolidadoradime = :f' +
        'ilial'
      
        '                            and (f.sped_pis_cofins or f.sped_pis' +
        '_cofins_rb or f.sped_pis_cofins_rem)))'
      ' '
      ' and np.data between :datainicial and :datafinal'
      ' and aii.periodo between :datainicial and :datafinal'
      ' and aii.dataapropriacao between :datainicial and :datafinal'
      ' and mod(np.codigofiscal,1000)=552'
      ')'
      ') as i'
      'UNION ALL'
      'select i.codigobem as cod_item, i.filialcontribuinte as filial'
      'from imobilizado i'
      ' join apropriacaoicmsimobilizado aii'
      ' on i.numero = aii.numeroimobilizado'
      ' join dadosfiscais df'
      ' join notas n'
      ' on n.dadofiscal = df.numero'
      ' on i.dadofiscal = df.numero'
      ' join produtosdadosfiscais pdf'
      ' on pdf.dadofiscal = i.dadofiscal'
      ' and pdf.produto = i.codigobem'
      ' and pdf.filial = i.filialcontribuinte'
      'where i.data_saida between :datainicial and :datafinal'
      ' '
      ' and (i.filialcontribuinte = :filial or'
      '      i.filialcontribuinte in (select f.codigo'
      '                            from filiais f'
      
        '                            where f.filialconsolidadoradime = :f' +
        'ilial'
      
        '                            and (f.sped_pis_cofins or f.sped_pis' +
        '_cofins_rb or f.sped_pis_cofins_rem)))'
      ' '
      ' and aii.periodo between :datainicial and :datafinal'
      ' and aii.dataapropriacao between :datainicial and :datafinal'
      
        ' and (n.filial,n.serie) in (select sf.filial,sf.valor from serie' +
        'sfiliais sf where sf.ativa)'
      'union'
      'select pdf.produto as cod_item, df.filialemissao as filial'
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      '     join produtosdadosfiscais pdf'
      '     on df.numero = pdf.dadofiscal'
      '          join produtos p'
      '            on pdf.produto = p.codigo'
      '            join caracteristicas c'
      '            on p.caracteristica = c.codigo'
      'where df.numero = pdf.dadofiscal'
      '  and df.data between :datainicial and :datafinal'
      '/*  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')*/'
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and df.CodigoFiscal < 8000'
      '  and df.situacao = '#39'N'#39
      ''
      '  and (df.filialemissao = :filial or'
      '       df.filialemissao in (select f.codigo'
      '                            from filiais f'
      
        '                            where f.filialconsolidadoradime = :f' +
        'ilial'
      
        '                            and (f.sped_pis_cofins or f.sped_pis' +
        '_cofins_rb or f.sped_pis_cofins_rem)))'
      ''
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      'union'
      'select pnp.produto as cod_item, np.filial'
      'from notaspag np'
      '     join produtosnotaspag pnp'
      '       on np.codigo = pnp.codigonota'
      '      join produtos p'
      '        on pnp.produto = p.codigo'
      '        join caracteristicas c'
      '        on p.caracteristica = c.codigo'
      'where np.codigo = pnp.codigonota'
      '  and np.data between :datainicial and :datafinal'
      '  and np.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and np.situacao='#39'N'#39
      '  /*and not (np.permitirimprimir and np.modelodocto='#39'55'#39')*/'
      '  and (np.filial = :filial or'
      '       np.filial in (select f.codigo'
      '                     from filiais f'
      '                     where f.filialconsolidadoradime = :filial'
      
        '                     and (f.sped_pis_cofins or f.sped_pis_cofins' +
        '_rb or f.sped_pis_cofins_rem)))'
      ''
      
        '  and (:codinctrib<>2 or (:codinctrib=2 and mod(np.codigofiscal,' +
        '1000) in ('
      ''
      '   201, /* Devolu'#231#227'o de venda de produ'#231#227'o do estabelecimento */'
      
        '   202, /* Devolu'#231#227'o de venda de mercadoria adquirida ou recebid' +
        'a de terceiros */'
      
        '   410, /* Devolu'#231#227'o de venda de produ'#231#227'o do estabelecimento em ' +
        'opera'#231#227'o com produto sujeito ao regime de substitui'#231#227'o tribut'#225'ri' +
        'a */'
      
        '   411  /* Devolu'#231#227'o de venda de mercadoria adquirida ou recebid' +
        'a de terceiros em opera'#231#227'o com mercadoria sujeita ao regime de s' +
        'ubstitui'#231#227'o tribut'#225'ria */'
      ''
      '    )))'
      ''
      'union'
      'Select cast(dic.cod_item as bigint) as cod_item, dc.filial'
      'from dadositemcupom dic'
      '    join produtos p'
      '      on cast(dic.cod_item as bigint) = p.codigo'
      '      join caracteristicas c'
      '      on p.caracteristica = c.codigo'
      '     join dadoscupom dc'
      '       on dc.filial = dic.filial'
      '       and dc.num_usu = dic.num_usu'
      '       and dc.cro = dic.cro'
      '       and dc.coo = dic.coo'
      '       join detalhecupom dlc'
      '         on dc.filial = dlc.filial'
      '         and dc.num_usu = dlc.num_usu'
      '         and dc.cro = dlc.cro'
      '         and dc.coo = dlc.coo'
      
        'where cast(dlc.dt_ini  as date) between :datainicial and :datafi' +
        'nal'
      '  and dlc.canc='#39'N'#39
      '  and dic.ind_canc='#39'N'#39
      ''
      '  and (dc.filial = :filial or'
      '       dc.filial in (select f.codigo'
      '                     from filiais f'
      '                     where f.filialconsolidadoradime = :filial'
      
        '                     and (f.sped_pis_cofins or f.sped_pis_cofins' +
        '_rb or f.sped_pis_cofins_rem)))'
      ''
      ') as produtos_diversos on  produtos_diversos.cod_item = p.codigo'
      ')'
      'order by cod_item')
    RequestLive = False
    Left = 36
    Top = 220
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'estado'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codinctrib'
        ParamType = ptUnknown
      end>
    object qryRegistro0200cod_item: TStringField
      FieldName = 'cod_item'
      Size = 60
    end
    object qryRegistro0200filial: TIntegerField
      FieldName = 'filial'
      DisplayFormat = '0'
    end
    object qryRegistro0200descr_item: TStringField
      FieldName = 'descr_item'
      Size = 70
    end
    object qryRegistro0200cod_barra: TStringField
      FieldName = 'cod_barra'
      Size = 50
    end
    object qryRegistro0200cod_ant_item: TStringField
      FieldName = 'cod_ant_item'
      Size = 60
    end
    object qryRegistro0200unid_inv: TStringField
      FieldName = 'unid_inv'
      Size = 50
    end
    object qryRegistro0200tipo_item: TStringField
      FieldName = 'tipo_item'
      Size = 50
    end
    object qryRegistro0200cod_ncm: TStringField
