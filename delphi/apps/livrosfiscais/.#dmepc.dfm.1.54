    object qryRecebimentosImoveis_F200cst_pis: TStringField
      FieldName = 'cst_pis'
      Size = 2
    end
    object qryRecebimentosImoveis_F200cst_cofins: TStringField
      FieldName = 'cst_cofins'
      Size = 2
    end
    object qryRecebimentosImoveis_F200aliq_pis: TFloatField
      FieldName = 'aliq_pis'
      DisplayFormat = '0.00'
    end
    object qryRecebimentosImoveis_F200aliq_cofins: TFloatField
      FieldName = 'aliq_cofins'
      DisplayFormat = '0.00'
    end
    object qryRecebimentosImoveis_F200ind_nat_emp: TStringField
      FieldName = 'ind_nat_emp'
      Size = 1
    end
