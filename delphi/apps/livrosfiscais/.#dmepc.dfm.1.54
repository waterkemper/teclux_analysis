  object qryDocumentosPag_F100: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select dp.numero as documentopag,'
      '       dp.filialemissao as filial,'
      '       dp.datalancto as dt_oper,'
      '       cast(0 as integer) as ind_oper,'
      '       dp.fornecedor as cod_part,'
      '       dp.tipofornecedor as tipocod_part,'
      '       dp.valor as vl_oper,'
      '       dp.piscst as cst_pis,'
      '       dp.pisbasecalculo as vl_bc_pis,'
      '       dp.pisaliquota as aliq_pis,'
      '       dp.pisvalor as vl_pis,'
      '       dp.cofinscst as cst_cofins,'
      '       dp.cofinsbasecalculo as vl_bc_cofins,'
      '       dp.cofinsaliquota as aliq_cofins,'
      '       dp.cofinsvalor as vl_cofins,'
      '       dp.nat_bc_cred,'
      '       cast(0 as integer) as ind_orig_cred'
      ''
      'from documentospag dp'
      ''
      'where dp.datalancto between :datainicial and :datafinal'
      '  and (dp.filialemissao = :filial or'
      '       dp.filialemissao in (select f.codigo'
      '                     from filiais f'
      '                     where f.filialconsolidadoradime = :filial'
      
        '                     and (f.sped_pis_cofins or f.sped_pis_cofins' +
        '_rb or f.sped_pis_cofins_rem)))'
      '  and (dp.piscst is not null or dp.cofinscst is not null)'
      'order by dp.datalancto')
    RequestLive = False
    Left = 408
    Top = 352
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
