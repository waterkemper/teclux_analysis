  object qryRegistroC500: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkFields = 'codigo = filial'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroC010
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select np.codigo as chave,'
      '       np.filial,'
      
        '       cast((np.tipofornecedor||cast(np.fornecedor as varchar)) ' +
        'as varchar(60)) as cod_part,'
      '       np.modelodocto as cod_mod,'
      
        '       case when np.situacao = '#39'C'#39' '#9#9'       then cast('#39'02'#39' as va' +
        'rchar(2))  /* cancelado */'
      
        '       else                                                 cast' +
        '('#39'00'#39' as varchar(2))  /* regular   */'
      '       end as cod_sit,'
      '       np.serie as ser,'
      '       np.numero as num_doc,'
      '       np.emissao as dt_doc,'
      '       np.data as dt_e_s,'
      '       coalesce(np.valornota,0) as vl_doc,'
      '       (select sum(pnp.icmsvalor)'
      '        from produtosnotaspag pnp'
      '        where pnp.codigonota = np.codigo'
      '          and pnp.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'90'#39')'
      '          and not pnp.naogerarcreditoicms'
      '        ) as vl_icms,'
      ''
      '       (select sum(pnp.pisvalor)'
      '        from produtosnotaspag pnp'
      '        where pnp.codigonota = np.codigo) as vl_pis,'
      ''
      '       (select sum(pnp.cofinsvalor)'
      '        from produtosnotaspag pnp'
      '        where pnp.codigonota = np.codigo) as vl_cofins'
      ''
      'from notaspag np'
      'where np.data between :datainicial and :datafinal'
      '  and np.situacao='#39'N'#39
      '  and np.modelodocto in ('#39'06'#39','#39'28'#39', '#39'29'#39')'
      '  and (np.filial = :filial or'
      '       np.filial in (select f.codigo'
      '                     from filiais f'
      '                     where f.filialconsolidadoradime = :filial'
      
        '                     and (f.sped_pis_cofins or f.sped_pis_cofins' +
        '_rb or f.sped_pis_cofins_rem)))'
      '  and :codinctrib<>2                      ')
    RequestLive = False
    Left = 836
    Top = 134
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codinctrib'
        ParamType = ptUnknown
      end>
