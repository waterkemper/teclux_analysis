  object qryRegistroC481: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkFields = 'filial=filial;numerousuario=num_usu;cro=cro;crz=crz'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroC405
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select cst_pis,'
      '       sum(vl_item) as vl_item,'
      
        '       sum(vl_bc_pis)  as vl_bc_pis, /* o valor j'#225' esta totaliza' +
        'do, hei hei foi trocado o max pelo sum */'
      '       aliq_pis,'
      #9'   sum(qtde_item) as quant_bc_pis,'
      
        #9'   sum(vl_bc_pis)/sum(qtde_item) as ALIQ_PIS_QUANT, /* VERIFICA' +
        'R ??? hei hei foi trocado o max pelo sum */'
      #9'   sum(vl_pis) as vl_pis,'
      #9'   cod_item,'
      '     classificacaofiscal,'
      '       filial,'
      '       num_usu ,'
      '       cro ,'
      '       crz'
      'from'
      ' ('
      '  select (select pdf.piscst'
      
        '          from cupons c, dadosfiscais df, produtosdadosfiscais p' +
        'df'
      '          where dc.filial = c.filial'
      '             and dc.num_usu = c.maquina'
      '            /*and dc.cro = c.intervensao*/'
      '             and dc.coo = c.numero'
      '             and df.numero = c.dadofiscal'
      '             and pdf.dadofiscal = df.numero'
      
        '             and pdf.produto = cast(dic.cod_item as bigint) limi' +
        't 1) as cst_pis,'
      ''
      '         (select pdf.classificacaofiscal'
      
        '          from cupons c, dadosfiscais df, produtosdadosfiscais p' +
        'df'
      '          where dc.filial = c.filial'
      '             and dc.num_usu = c.maquina'
      '            /*and dc.cro = c.intervensao*/'
      '             and dc.coo = c.numero'
      '             and df.numero = c.dadofiscal'
      '             and pdf.dadofiscal = df.numero'
      
        '             and pdf.produto = cast(dic.cod_item as bigint) limi' +
        't 1) as classificacaofiscal,'
      ''
      
        '             round(coalesce((dic.vl_tot_item - dic.vl_tot_item *' +
        '  case when dlc.tp_descto = '#39'V'#39' then dlc.sub_descto end / dlc.su' +
        'b_docto '
      
        '                             + dic.vl_tot_item *  case when dlc.' +
        'tp_acres = '#39'V'#39' then dlc.sub_acres   end / dlc.sub_docto),0),2) +'
      #9#9#9#9#9#9#9'   '
      '                  (select coalesce(pdf.icmsvalorst,0) +'
      #9#9#9#9#9#9'  coalesce(pdf.frete,0) +'
      #9#9#9#9#9#9'  coalesce(pdf.seguro,0) +'
      #9#9#9#9#9#9'  coalesce(pdf.despesasacessorias,0) +'
      #9#9#9#9#9#9'  coalesce(pdf.valoripi,0) /* +'
      ''
      #9#9#9#9#9#9'  coalesce(pdf.acrescimo,0) -'
      #9#9#9#9#9#9'  coalesce(pdf.desconto,0) -'
      #9#9#9#9#9#9'  coalesce(pdf.valordescontoitem,0) */'
      #9#9' '
      
        '                           from cupons c, dadosfiscais df, produ' +
        'tosdadosfiscais pdf'
      '                           where dc.filial = c.filial'
      '                             and dc.num_usu = c.maquina'
      '                             /*and dc.cro = c.intervensao*/'
      '                             and dc.coo = c.numero'
      '                             and df.numero = c.dadofiscal'
      '                             and pdf.dadofiscal = df.numero'
      
        '                             and pdf.produto = cast(dic.cod_item' +
        ' as bigint) limit 1) as vl_item,'
      #9#9
      '         (select pdf.pisbasecalculo'
      
        '          from cupons c, dadosfiscais df, produtosdadosfiscais p' +
        'df'
      '          where dc.filial = c.filial'
      '             and dc.num_usu = c.maquina'
      '            /*and dc.cro = c.intervensao*/'
      '             and dc.coo = c.numero'
      '             and df.numero = c.dadofiscal'
      '             and pdf.dadofiscal = df.numero'
      
        '             and pdf.produto = cast(dic.cod_item as bigint) limi' +
        't 1) as VL_BC_PIS,'
      ''
      '         (select pdf.pisaliquota'
      
        '          from cupons c, dadosfiscais df, produtosdadosfiscais p' +
        'df'
      '          where dc.filial = c.filial'
      '             and dc.num_usu = c.maquina'
      '            /*and dc.cro = c.intervensao*/'
      '             and dc.coo = c.numero'
      '             and df.numero = c.dadofiscal'
      '             and pdf.dadofiscal = df.numero'
      
        '             and pdf.produto = cast(dic.cod_item as bigint) limi' +
        't 1) as ALIQ_PIS,'
      #9#9#9
      #9#9' dic.qtde_item,'
      #9#9' '#9#9
      #9#9' (select pdf.pisvalor'
      
        '          from cupons c, dadosfiscais df, produtosdadosfiscais p' +
        'df'
      '          where dc.filial = c.filial'
      '             and dc.num_usu = c.maquina'
      '            /*and dc.cro = c.intervensao*/'
      '             and dc.coo = c.numero'
      '             and df.numero = c.dadofiscal'
      '             and pdf.dadofiscal = df.numero'
      
        '             and pdf.produto = cast(dic.cod_item as bigint) limi' +
        't 1) as VL_PIS,'#9#9
      #9#9' cast('#39'P'#39'||dic.cod_item as varchar(60)) as cod_item,'#9#9#9
      '         dic.filial,'
      '         dic.num_usu ,'
      '         dic.cro ,'
      '         dlc.crz'
      #9#9
      '  from dadositemcupom dic'
      '/*'
      '       join produtos p'
      '         on cast(dic.cod_item as bigint) = p.codigo'
      '         join caracteristicas ca'
      '         on p.caracteristica = ca.codigo'
      '         join tributosicms ti'
      '         on ca.incidencia = ti.codigo'
      '*/'
      '       join dadoscupom dc'
      '/*            join cupons c'
      '            on dc.filial = c.filial'
      '            and dc.num_usu = c.maquina */'
      '            /*and dc.cro = c.intervensao*/'
      '/*            and dc.coo = c.numero*/'
      '         on dc.filial = dic.filial'
      '         and dc.num_usu = dic.num_usu'
      '         and dc.cro = dic.cro'
      '         and dc.coo = dic.coo'
      '         join detalhecupom dlc'
      '           on dc.filial = dlc.filial'
      '           and dc.num_usu = dlc.num_usu'
      '           and dc.cro = dlc.cro'
      '           and dc.coo = dlc.coo'
      '/*       join dadosfiscais df'
      '       on df.numero = c.dadofiscal*/'
      '/*       join produtosdadosfiscais pdf'
      '       on pdf.dadofiscal = df.numero'
      '       and pdf.produto = cast(dic.cod_item as bigint)*/'
      '/*       and pdf.filial = dic.filial*/'
      '/*       and pdf.numero = dic.num_item */'
      
        '  where cast(dlc.dt_ini as date) between :datainicial and :dataf' +
        'inal'
      '    and dlc.canc = '#39'N'#39
      '    and dic.ind_canc = '#39'N'#39
      '    and (dic.filial = :filial or'
      '         dic.filial in (select f.codigo'
      '                     from filiais f'
      '                     where f.filialconsolidadoradime = :filial'
      
        '                     and (f.sped_pis_cofins or f.sped_pis_cofins' +
        '_rb or f.sped_pis_cofins_rem)))'
      '/*'
      '    and not exists ('
      '       select pdf.dadofiscal'
      '       from produtosdadosfiscais pdf'
      '       where pdf.dadofiscal = df.numero'
      '         and pdf.produto = cast(dic.cod_item as bigint))'
      '*/'
      ' ) as registros'
      
        'group by cst_pis, aliq_pis, cod_item, classificacaofiscal, filia' +
        'l, num_usu, cro, crz'
      
        'order by cst_pis, aliq_pis, cod_item, classificacaofiscal, filia' +
        'l, num_usu, cro, crz')
    RequestLive = False
    Left = 688
    Top = 285
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
    object qryRegistroC481cst_pis: TStringField
      FieldName = 'cst_pis'
      Size = 50
    end
    object qryRegistroC481vl_item: TFloatField
      FieldName = 'vl_item'
    end
    object qryRegistroC481vl_bc_pis: TFloatField
      FieldName = 'vl_bc_pis'
    end
    object qryRegistroC481aliq_pis: TFloatField
      FieldName = 'aliq_pis'
    end
    object qryRegistroC481quant_bc_pis: TFloatField
      FieldName = 'quant_bc_pis'
    end
    object qryRegistroC481aliq_pis_quant: TFloatField
      FieldName = 'aliq_pis_quant'
    end
    object qryRegistroC481vl_pis: TFloatField
      FieldName = 'vl_pis'
    end
    object qryRegistroC481cod_item: TStringField
      FieldName = 'cod_item'
      Size = 60
    end
    object qryRegistroC481filial: TIntegerField
      FieldName = 'filial'
    end
    object qryRegistroC481num_usu: TIntegerField
      FieldName = 'num_usu'
    end
    object qryRegistroC481cro: TIntegerField
      FieldName = 'cro'
    end
    object qryRegistroC481crz: TIntegerField
      FieldName = 'crz'
    end
    object qryRegistroC481classificacaofiscal: TStringField
      FieldName = 'classificacaofiscal'
      Size = 50
    end
  end
  object qryRegistroC485: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkFields = 'filial=filial;numerousuario=num_usu;cro=cro;crz=crz'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroC405
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select cst_cofins,'
      '       sum(vl_item) as vl_item,'
      
        '       sum(vl_bc_cofins)  as vl_bc_cofins, /* o valor j'#225' esta to' +
        'talizado */'
      '       aliq_cofins,'
      #9'   sum(qtde_item) as quant_bc_cofins,'
      
        #9'   sum(vl_bc_cofins)/sum(qtde_item) as ALIQ_cofins_QUANT, /* VE' +
        'RIFICAR ??? */'
      #9'   sum(vl_cofins) as vl_cofins,'
      #9'   cod_item,'
      '       filial,'
      '       num_usu ,'
      '       cro ,'
      '       crz'
      'from'
      ' ('
      '  select (select pdf.cofinscst'
      
        '          from cupons c, dadosfiscais df, produtosdadosfiscais p' +
        'df'
      '          where dc.filial = c.filial'
      '             and dc.num_usu = c.maquina'
      '            /*and dc.cro = c.intervensao*/'
      '             and dc.coo = c.numero'
      '             and df.numero = c.dadofiscal'
      '             and pdf.dadofiscal = df.numero'
      
        '             and pdf.produto = cast(dic.cod_item as bigint) limi' +
        't 1) as cst_cofins,'
      ''
      ''
      
        '             round(coalesce((dic.vl_tot_item - dic.vl_tot_item *' +
        '  case when dlc.tp_descto = '#39'V'#39' then dlc.sub_descto end / dlc.su' +
        'b_docto '
      
        '                             + dic.vl_tot_item *  case when dlc.' +
        'tp_acres = '#39'V'#39' then dlc.sub_acres   end / dlc.sub_docto),0),2) +'
      #9#9#9#9#9#9#9'   '
      '                  (select coalesce(pdf.icmsvalorst,0) +'
      #9#9#9#9#9#9'  coalesce(pdf.frete,0) +'
      #9#9#9#9#9#9'  coalesce(pdf.seguro,0) +'
      #9#9#9#9#9#9'  coalesce(pdf.despesasacessorias,0) +'
      #9#9#9#9#9#9'  coalesce(pdf.valoripi,0) /*+'
      #9#9#9#9#9#9'  coalesce(pdf.acrescimo,0) -'
      #9#9#9#9#9#9'  coalesce(pdf.desconto,0) -'
      #9#9#9#9#9#9'  coalesce(pdf.valordescontoitem,0)*/'
      #9#9' '
      
        '                           from cupons c, dadosfiscais df, produ' +
        'tosdadosfiscais pdf'
      '                           where dc.filial = c.filial'
      '                             and dc.num_usu = c.maquina'
      '                             /*and dc.cro = c.intervensao*/'
      '                             and dc.coo = c.numero'
      '                             and df.numero = c.dadofiscal'
      '                             and pdf.dadofiscal = df.numero'
      
        '                             and pdf.produto = cast(dic.cod_item' +
        ' as bigint) limit 1) as vl_item,'
      ''
      ''
      '         (select pdf.cofinsbasecalculo'
      
        '          from cupons c, dadosfiscais df, produtosdadosfiscais p' +
        'df'
      '          where dc.filial = c.filial'
      '             and dc.num_usu = c.maquina'
      '            /*and dc.cro = c.intervensao*/'
      '             and dc.coo = c.numero'
      '             and df.numero = c.dadofiscal'
      '             and pdf.dadofiscal = df.numero'
      
        '             and pdf.produto = cast(dic.cod_item as bigint) limi' +
        't 1) as VL_BC_cofins,'
      '             '#9
      '         (select pdf.cofinsaliquota'
      
        '          from cupons c, dadosfiscais df, produtosdadosfiscais p' +
        'df'
      '          where dc.filial = c.filial'
      '             and dc.num_usu = c.maquina'
      '            /*and dc.cro = c.intervensao*/'
      '             and dc.coo = c.numero'
      '             and df.numero = c.dadofiscal'
      '             and pdf.dadofiscal = df.numero'
      
        '             and pdf.produto = cast(dic.cod_item as bigint) limi' +
        't 1) as ALIQ_cofins,'#9#9#9
      #9#9#9
      #9#9' dic.qtde_item,'
      #9#9' '#9#9
      #9#9' (select pdf.cofinsvalor'
      
        '          from cupons c, dadosfiscais df, produtosdadosfiscais p' +
        'df'
      '          where dc.filial = c.filial'
      '             and dc.num_usu = c.maquina'
      '            /*and dc.cro = c.intervensao*/'
      '             and dc.coo = c.numero'
      '             and df.numero = c.dadofiscal'
      '             and pdf.dadofiscal = df.numero'
      
        '             and pdf.produto = cast(dic.cod_item as bigint) limi' +
        't 1) as VL_cofins,'#9#9
      #9#9' cast('#39'P'#39'||dic.cod_item as varchar(60)) as cod_item,'#9#9#9
      '         dic.filial,'
      '         dic.num_usu ,'
      '         dic.cro ,'
      '         dlc.crz'
      #9#9
      '  from dadositemcupom dic'
      '/*'
      '       join produtos p'
      '         on cast(dic.cod_item as bigint) = p.codigo'
      '         join caracteristicas ca'
      '         on p.caracteristica = ca.codigo'
      '         join tributosicms ti'
      '         on ca.incidencia = ti.codigo'
      '*/'
      '       join dadoscupom dc'
      '/*            join cupons c'
      '            on dc.filial = c.filial'
      '            and dc.num_usu = c.maquina */'
      '            /*and dc.cro = c.intervensao*/'
      '/*            and dc.coo = c.numero*/'
      '         on dc.filial = dic.filial'
      '         and dc.num_usu = dic.num_usu'
      '         and dc.cro = dic.cro'
      '         and dc.coo = dic.coo'
      '         join detalhecupom dlc'
      '           on dc.filial = dlc.filial'
      '           and dc.num_usu = dlc.num_usu'
      '           and dc.cro = dlc.cro'
      '           and dc.coo = dlc.coo'
      '/*       join dadosfiscais df'
      '       on df.numero = c.dadofiscal*/'
      '/*       join produtosdadosfiscais pdf'
      '       on pdf.dadofiscal = df.numero'
      '       and pdf.produto = cast(dic.cod_item as bigint)*/'
      '/*       and pdf.filial = dic.filial*/'
      '/*       and pdf.numero = dic.num_item */'
      
        '  where cast(dlc.dt_ini as date) between :datainicial and :dataf' +
        'inal'
      '    and dlc.canc = '#39'N'#39
      '    and dic.ind_canc = '#39'N'#39
      '    and (dic.filial = :filial or'
      '         dic.filial in (select f.codigo'
      '                     from filiais f'
      '                     where f.filialconsolidadoradime = :filial))'
      '/*'
      '    and not exists ('
      '       select pdf.dadofiscal'
      '       from produtosdadosfiscais pdf'
      '       where pdf.dadofiscal = df.numero'
      '         and pdf.produto = cast(dic.cod_item as bigint))'
      '*/'
      ' ) as registros'
      
        'group by cst_cofins, aliq_cofins, cod_item, filial, num_usu, cro' +
        ', crz'
      
        'order by cst_cofins, aliq_cofins, cod_item, filial, num_usu, cro' +
        ', crz')
    RequestLive = False
    Left = 776
    Top = 285
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
