    MasterSource = dsrRegistro0140
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select filial,'
      '       case when fpc.sped_pis_cofins_rb then cast(1 as integer)'
      '            when fpc.sped_pis_cofins_rem then cast(2 as integer)'
      '       end as cod_inc_trib,'
      '       sum(VL_REC_TOT_EST) as VL_REC_TOT,'
      '       sum(VL_REC_ATIV_ESTAB) as VL_REC_ATIV,'
      '       sum(VL_CONT_APU) as VL_CONT_APU'
      ''
      'from piscofins_p100'
      '     join filiais fpc'
      '     on piscofins_p100.filial = fpc.codigo'
      ''
      'where periodo = :periodo'
      
        '  and (fpc.filialconsolidadoradime = :codigo or fpc.codigo = :co' +
        'digo)'
      '  and (fpc.sped_pis_cofins_rb or fpc.sped_pis_cofins_rem)'
      ''
      'group by filial, fpc.sped_pis_cofins_rb, fpc.sped_pis_cofins_rem')
    RequestLive = False
    Left = 124
    Top = 125
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'periodo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end>
