  object qryRegistroA010: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select f.codigo,'
      '       f.cnpj,'
      '       f.sped_pis_cofins'
      'from filiais f'
      'where  f.codigo in ((select distinct df.filialemissao'
      
        '                    from dadosfiscais df join filiais fd on df.f' +
        'ilialemissao = fd.codigo'
      
        '                                         join notas n on df.nume' +
        'ro = n.dadofiscal'
      
        '                    where df.data between :datainicial and :data' +
        'final'
      
        '                      and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39 +
        ')'
      '                      and exists (select sdf.dadofiscal'
      '                                  from servicosdadosfiscais sdf'
      #9#9'      '#9'          where sdf.dadofiscal = df.numero limit 1)'
      
        '                      and (n.filial,n.serie) in (select sf.filia' +
        'l,sf.valor from seriesfiliais sf where sf.ativa)'
      
        '                      and (fd.filialconsolidadoradime = :codigo ' +
        'or df.filialemissao = :codigo)'
      
        '                      and (fd.sped_pis_cofins or fd.sped_pis_cof' +
        'ins_rb or fd.sped_pis_cofins_rem) )'
      '                     /*'
      '                     union all'
      '                    (select distinct np.filial'
      
        '                     from notaspag np join filiais fnp on np.fil' +
        'ial = fnp.codigo'
      
        '                     where np.data between :datainicial and :dat' +
        'afinal'
      '                       and np.situacao = '#39'N'#39
      
        '                       and cast(coalesce(np.modelodocto,'#39'01'#39') as' +
        ' varchar(2)) in ('#39'07'#39','#39'08'#39','#39'8B'#39','#39'09'#39','#39'10'#39','#39'11'#39','#39'26'#39','#39'27'#39','#39'57'#39')'
      
        '                       and (fnp.filialconsolidadoradime = :codig' +
        'o or np.filial = :codigo))*/)'
      '/* VERIFICAR O TIPO DE NOTA C/ L'#218'CIO */')
    RequestLive = False
    Left = 216
    Top = 53
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end>
    object qryRegistroA010codigo: TIntegerField
      FieldName = 'codigo'
      DisplayFormat = '0'
    end
    object qryRegistroA010cnpj: TStringField
      FieldName = 'cnpj'
      Size = 14
    end
    object qryRegistroA010sped_pis_cofins: TBooleanField
      FieldName = 'sped_pis_cofins'
    end
  end
