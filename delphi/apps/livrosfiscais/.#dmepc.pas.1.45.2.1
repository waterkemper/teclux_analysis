function TdtmEPC.ACBrCodCont(tipo: String): TACBrCodCont;
begin
       if tipo = '01' then result := ccNaoAcumAliqBasica                 // 01 // Contribuição não-cumulativa apurada a alíquota básica
  else if tipo = '02' then result := ccNaoAcumAliqDiferenciada           // 02 // Contribuição não-cumulativa apurada a alíquotas diferenciadas
  else if tipo = '03' then result := ccNaoAcumAliqUnidProduto            // 03 // Contribuição não-cumulativa apurada a alíquota por unidade de medida de produto
  else if tipo = '04' then result := ccNaoAcumAliqBasicaAtivImobiliaria  // 04 // Contribuição não-cumulativa apurada a alíquota básica - Atividade Imobiliária
  else if tipo = '31' then result := ccApuradaPorST                      // 31 // Contribuição apurada por substituição tributária
  else if tipo = '32' then result := ccApuradaPorSTManaus                // 32 // Contribuição apurada por substituição tributária - Vendas à Zona Franca de Manaus
  else if tipo = '51' then result := ccAcumAliqBasica                    // 51 // Contribuição cumulativa apurada a alíquota básica
  else if tipo = '52' then result := ccAcumAliqDiferenciada              // 52 // Contribuição cumulativa apurada a alíquotas diferenciadas
  else if tipo = '53' then result := ccAcumAliqUnidProduto               // 53 // Contribuição cumulativa apurada a alíquota por unidade de medida de produto
  else if tipo = '54' then result := ccAcumAliqBasicaAtivImobiliaria     // 54 // Contribuição cumulativa apurada a alíquota básica - Atividade Imobiliária
  else if tipo = '70' then result := ccApuradaAtivImobiliaria            // 70 // Contribuição apurada da Atividade Imobiliária - RET
  else if tipo = '71' then result := ccApuradaSCPNaoCumulativa           // 71 // Contribuição apurada de SCP - Incidência Não Cumulativa
  else if tipo = '72' then result := ccApuradaSCPCumulativa              // 72 // Contribuição apurada de SCP - Incidência Cumulativa
  else if tipo = '99' then result := ccPISPasepSalarios;                 // 99 // Contribuição para o PIS/Pasep - Folha de Salários

end;

