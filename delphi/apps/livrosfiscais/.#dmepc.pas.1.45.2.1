                   'Descrição não encontrada: '+qryRegistroA110txt.AsString);
    qryRegistroA110.Next;
  end;
end;

procedure TdtmEPC.P_REGISTROA170;

  {VERIFICAR OBRIGATORIEDADE }
  function ACBrBaseCalculoCredito(ind: String) : TACBrBaseCalculoCredito;
  begin
    if      ind = '01' then result := bccAqBensRevenda                 // '01' // Aquisição de bens para revenda
    else if ind = '02' then result := bccAqBensUtiComoInsumo           // '02' // Aquisição de bens utilizados como insumo
    else if ind = '03' then result := bccAqServUtiComoInsumo           // '03' // Aquisição de serviços utilizados como insumo
    else if ind = '04' then result := bccEnergiaEletricaTermica        // '04' // Energia elétrica e térmica, inclusive sob a forma de vapor
    else if ind = '05' then result := bccAluguelPredios                // '05' // Aluguéis de prédios
    else if ind = '06' then result := bccAluguelMaqEquipamentos        // '06' // Aluguéis de máquinas e equipamentos
    else if ind = '07' then result := bccArmazenagemMercadoria         // '07' // Armazenagem de mercadoria e frete na operação de venda
    else if ind = '08' then result := bccConArrendamentoMercantil      // '08' // Contraprestações de arrendamento mercantil
    else if ind = '09' then result := bccMaqCredDepreciacao            // '09' // Máquinas, equipamentos e outros bens incorporados ao ativo imobilizado (crédito sobre encargos de depreciação).
    else if ind = '10' then result := bccMaqCredAquisicao              // '10' // Máquinas, equipamentos e outros bens incorporados ao ativo imobilizado (crédito com base no valor de aquisição).
    else if ind = '11' then result := bccAmortizacaoDepreciacaoImoveis // '11' // Amortização e Depreciação de edificações e benfeitorias em imóveis
    else if ind = '12' then result := bccDevolucaoSujeita              // '12' // Devolução de Vendas Sujeitas à Incidência Não-Cumulativa
    else if ind = '13' then result := bccOutrasOpeComDirCredito        // '13' // Outras Operações com Direito a Crédito
    else if ind = '14' then result := bccAtTransporteSubcontratacao    // '14' // Atividade de Transporte de Cargas – Subcontratação
    else if ind = '15' then result := bccAtImobCustoIncorrido          // '15' // Atividade Imobiliária – Custo Incorrido de Unidade Imobiliária
    else if ind = '16' then result := bccAtImobCustoOrcado             // '16' // Atividade Imobiliária – Custo Orçado de unidade não concluída
    else if ind = '17' then result := bccAtPresServ                    // '17' // Atividade de Prestação de Serviços de Limpeza, Conservação e Manutenção – vale-transporte, vale-refeição ou vale-alimentação, fardamento ou uniforme.
    else if ind = '18' then result := bccEstoqueAberturaBens;           // '18' // Estoque de abertura de bens
  end;



begin
  qryRegistroA170.First;
  while not qryRegistroA170.eof do
  begin
    with ACBrSPEDPisCofins.Bloco_A.RegistroA170New do
    begin
      if not qryRegistroA170.fieldbyname('NUM_ITEM').IsNull then
        NUM_ITEM      := qryRegistroA170.fieldbyname('NUM_ITEM').asinteger
      else
        NUM_ITEM      := qryRegistroA170.recno;

      COD_ITEM        := qryRegistroA170.fieldbyname('COD_ITEM').asstring;
      DESCR_COMPL     := trim(qryRegistroA170.fieldbyname('DESCR_COMPL').asstring);
      VL_ITEM         := {qryRegistroA170VL_BC_PIS.ASCurrency;} qryRegistroA170.fieldbyname('VL_ITEM').AsCurrency;
      VL_DESC         := qryRegistroA170.fieldbyname('VL_DESC').AsCurrency;
      NAT_BC_CRED     := ACBrBaseCalculoCredito(qryRegistroA170nat_bc_cred.AsString);  //07	Código da Base de Cálculo do Crédito, conforme a Tabela indicada no item 4.3.7, caso seja informado código representativo de crédito no Campo 09 (CST_PIS) ou no Campo 13 (CST_COFINS).	C	002*	-
      IND_ORIG_CRED   := ACBrOrigemCredito(qryRegistroA170ind_orig_cred.AsInteger);    //08	Indicador da origem do crédito:0 – Operação no Mercado Interno 1 – Operação de Importação	C	001*	-
      CST_PIS         := ACBrSituacaoTribPIS(qryRegistroA170CST_PIS.AsString);         //09	Código da Situação Tributária referente ao PIS/PASEP – Tabela 4.3.3.	N	002*	-
      VL_BC_PIS       := qryRegistroA170VL_BC_PIS.ASCurrency;                          //10	Valor da base de cálculo do PIS/PASEP.	N	- 	02
      ALIQ_PIS        := qryRegistroA170ALIQ_PIS.ASCurrency;                           //11	Alíquota do PIS/PASEP (em percentual)	N	-	02
      VL_PIS          := qryRegistroA170VL_PIS.ASCurrency;                             //12	Valor do PIS/PASEP	N	-	02
      CST_COFINS      := ACBrSituacaoTribCOFINS(qryRegistroA170CST_COFINS.AsString);   //13	Código da Situação Tributária referente ao COFINS – Tabela 4.3.4.	N	002*	-
      VL_BC_COFINS    := qryRegistroA170VL_BC_COFINS.ASCurrency;                       //14	Valor da base de cálculo da COFINS	N	 	02
      ALIQ_COFINS     := qryRegistroA170ALIQ_COFINS.ASCurrency;                        //15	Alíquota do COFINS (em percentual)	N	006	02
      VL_COFINS       := qryRegistroA170VL_COFINS.ASCurrency;                          //16	Valor da COFINS	N	-	02
      COD_CTA         := qryRegistroA170COD_CTA.ASstring;                              //17	Código da conta analítica contábil debitada/creditada	C	060	-
      COD_CCUS        := qryRegistroA170COD_CCUS.ASstring;                             //18	Código do centro de custos	C	060	-

    end;
    qryRegistroA170.next;
  end;
end;

