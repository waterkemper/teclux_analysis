                                              qryRegistroM200vl_out_ded_nc.AsCurrency;

  qryRegistroM200vl_cont_cum_rec.AsCurrency := qryRegistroM200vl_tot_cont_cum_per.AsCurrency -
                                               qryRegistroM200vl_ret_cum.AsCurrency -
                                               qryRegistroM200vl_out_ded_cum.AsCurrency;

  qryRegistroM200vl_tot_cont_rec.AsCurrency  := qryRegistroM200vl_cont_nc_rec.AsCurrency +
