  qryRegistro0140.First;
  while not qryRegistro0140.Eof do
  begin
    with ACBrSPEDPisCofins.Bloco_0.Registro0140New do
    begin
      COD_EST := qryRegistro0140codigo.asstring;  // Código de identificação do estabelecimento
      NOME    := qryRegistro0140razao.asstring;  // Nome empresarial do estabelecimento
      CNPJ    := somentenumero(qryRegistro0140cnpj.AsString);  // Número de inscrição do estabelecimento no CNPJ
      UF      := qryRegistro0140estado.AsString;  // Sigla da unidade da federação do estabelecimento
