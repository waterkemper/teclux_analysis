      DT_DOC   := qryRegistroD100.fieldbyname('DT_DOC').asDateTime;
      DT_A_P   := qryRegistroD100.fieldbyname('DT_DOC').asDateTime;
      TP_CT_e  := qryRegistroD100.fieldbyname('TP_CTe').AsString;
      CHV_CTE_REF := qryRegistroD100.fieldbyname('CHV_CTE_REF').AsString;
      VL_DOC        := qryRegistroD100.fieldbyname('VL_DOC').ascurrency;
      VL_DESC       := qryRegistroD100.fieldbyname('VL_DESC').ascurrency;

      if qryRegistroD100.fieldbyname('IND_FRT').IsNull then
        IND_FRT := tfNenhum
      else
        IND_FRT := ACBrTipoFrete(qryRegistroD100.fieldbyname('IND_FRT').AsInteger);

      VL_SERV := qryRegistroD100.fieldbyname('VL_SERV').ascurrency;

      VL_BC_ICMS := qryRegistroD100.fieldbyname('VL_BC_ICMS').ascurrency;
      VL_ICMS := qryRegistroD100.fieldbyname('VL_ICMS').ascurrency;
      VL_NT := qryRegistroD100.fieldbyname('VL_NT').ascurrency;

      if qryRegistroD100txt.AsString<>'' then
      begin
        if qryRegistro0140.Locate('codigo',qryRegistroD100filial.AsInteger,[]) then
        begin
          if qryRegistro0450.Locate('txt;filial',VarArrayOf([qryRegistroD100txt.AsString,qryRegistroD100filial.Asinteger]),[]) then
            COD_INF := inttostr(qryRegistro0450.RecNo)
          else
            MensagemErro('Inconsistência: Registro0450 x REgistroD100'+#10#13+
                         'Descrição não encontrada: '+qryRegistroD100txt.AsString);
        end
        else
          MensagemErro('Inconsistência: Registro0450 x REgistroD100'+#10#13+
                         'Descrição não encontrada: '+qryRegistroD100txt.AsString);
      end;
//      COD_CTA: String;

    end;

    P_RegistroD101;
    P_RegistroD105;

    qryRegistroD100.Next;
  end;

end;

