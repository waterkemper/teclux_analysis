procedure TdtmEPC.P_Registro0000;

  function ACBrTipoEscrituracao(tipo: byte): TACBrTipoEscrituracao;
  begin
    case tipo of
    0: result := tpEscrOriginal;
    1: result := tpEscrRetificadora;
    end;
  end;

  function ACBrIndicadorSituacaoEspecial(tipo: byte): TACBrIndicadorSituacaoEspecial;
  begin
    case tipo of
    0: result := indSitAbertura;      // 0 - Abertura
    1: result := indSitCisao;         // 1 - Cisão
    2: result := indSitFusao;         // 2 - Fusão
    3: result := indSitIncorporacao;  // 3 - Incorporação
    4: result := indSitEncerramento;  // 4 - Encerramento
    5: result := indNenhum;            // 5 - Vazio
    end;
  end;

  function ACBrIndicadorNaturezaPJ(tipo: byte): TACBrIndicadorNaturezaPJ;
  begin
    case tipo of
    0: result := indNatPJSocEmpresariaGeral; // 0 - Sociedade empresária geral
    1: result := indNatPJSocCooperativa;     // 1 - Sociedade Cooperativa
    2: result := indNatPJEntExclusivaFolhaSal;// 2 - Entidade sujeita ao PIS/Pasep exclusivamente com base  na folha de salários
    end;
  end;

  function ACBrIndicadorAtividade(tipo: byte): TACBrIndicadorAtividade;
  begin
    case tipo of
    0: result := indAtivIndustrial;       // 0 - Industrial ou equiparado a industrial
    1: result := indAtivPrestadorServico; // 1 - Prestador de serviços
    2: result := indAtivComercio;         // 2 - Atividade de comércios
    3: result := indAtivoFincanceira;     // 3 - Atividade Financeira
    4: result := indAtivoImobiliaria;     // 4 - Atividade Imobiliária
    5: result := indAtivoOutros;           // 9 - Outros
    end;
  end;

begin
  with ACBrSPEDPisCofins.Bloco_0.Registro0000 do
  begin

    COD_VER          := vlVersao201;                     //Código da versão do leiaute conforme a tabela 3.1.1
    TIPO_ESCRIT      := ACBrTipoEscrituracao(qryepctipo.AsInteger); //Tipo de escrituração: 0 - Original; 1 – Retificadora;
    IND_SIT_ESP      := ACBrIndicadorSituacaoEspecial(qryepcsituacao.AsInteger);  //Indicador de situação especial: 0 - Abertura; 1 - Cisão; 2 - Fusão; 3 - Incorporação; 4 – Encerramento;
    NUM_REC_ANTERIOR := qryepcNro_Rec_Anterior.AsString;                         //Número do Recibo da Escrituração anterior a ser retificada, utilizado quando TIPO_ESCRIT for igual a 1
    DT_INI           := DataInicial;                      //Data inicial das informações contidas no arquivo
    DT_FIN           := DataFinal;                      //Data final das informações contidas no arquivo
    NOME             := copy(qryFiliaisrazao.AsString,1,100);;                         //Nome empresarial da pessoa jurídica
    CNPJ             := somentenumero(qryFiliaiscnpj.AsString);                         //Número de inscrição do estabelecimento matriz da pessoa jurídica no CNPJ
    UF               := qryFiliaisestado.AsString;                         //Sigla da Unidade da Federação da pessoa jurídica
    COD_MUN          := qryFiliaiscidadeibge.AsInteger;                        //Código do município do domicílio fiscal da pessoa jurídica, conforme a tabela IBGE
    SUFRAMA          := qryFiliaissuframa.AsString;                         //Inscrição da pessoa jurídica na Suframa
    IND_NAT_PJ       := ACBrIndicadorNaturezaPJ(qryFiliaisind_nat_pj.asinteger);       //Indicador da natureza da pessoa jurídica: 00 – Sociedade empresária em geral 01 – Sociedade cooperativa 02 – Entidade sujeita ao PIS/Pasep exclusivamente com base na Folha de Salários
    IND_ATIV         := ACBrIndicadorAtividade(qryFiliaisind_ativ.AsInteger);        //Indicador de tipo de atividade preponderante: 0 – Industrial ou equiparado a industrial; 1 – Prestador de serviços; 2 - Atividade de comércio; 3 – Atividade financeira; 4 – Atividade imobiliária; 9 – Outros.

  end;
end;

