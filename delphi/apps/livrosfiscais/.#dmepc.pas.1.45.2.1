procedure TdtmEPC.CalcularTotalAjusteCreditoCofinsEntradas;
var
  vRegistroEncontrado : boolean;
begin

  vRegistroEncontrado := false;

  {O recalculo do bloco m500 c/ efeito no m600 se dá somente no regime nao cum e no nao cum e cum,
   qdo exclusivo no regime cum. não há credito pelas entradas}

  if (qryepcCOD_INC_TRIB.AsInteger in [1,3]) then
  begin

    if not (qryregistrom500.state in [dsedit, dsinsert]) then
      qryRegistroM500.edit;

    qryRegistroM500vl_ajus_reduc.AsCurrency := 0;

    qryregistrom510.first;
    while not qryregistrom510.Eof do
    begin
      if (qryRegistroM510ind_aj.AsInteger = 0) and
         (qryRegistroM510geradosistemasn.asstring = 'S') and
         (qryRegistroM510cod_aj.AsString = '05') and
         (qryRegistroM510descr_aj.AsString = 'DESCONTOS RECEBIDOS') then
      begin
        vRegistroEncontrado := true;
         break;
      end
      else
        qryregistrom510.Next;
    end;


  //  if not qryRegistroM510.Locate('IND_AJ;geradosistemaSN;cod_aj;descr_aj',VarArrayof([0,'S','05','DESCONTOS RECEBIDOS']),[]) then // 0 : AJUSTE DE REDUÇÃO
    if not vRegistroEncontrado then
    begin
      if qryAtualizarRegistroM110cofinsvalor.ascurrency <> 0 then
      begin
        qryRegistroM510.Append;
        qryRegistroM510ind_aj.AsInteger := 0;
        qryRegistroM510cod_aj.AsString := '05';
        qryRegistroM510descr_aj.AsString := 'DESCONTOS RECEBIDOS';
        qryRegistroM510dt_ref.AsDateTime := DataInicial;
        qryRegistroM510vl_aj.AsCurrency := qryAtualizarRegistroM110cofinsvalor.ascurrency;
        qryRegistroM510geradosistema.asboolean := true;

        qryRegistroM510.AfterPost := nil;
        qryRegistroM510.post;
        qryRegistroM510.AfterPost := qryRegistroM510AfterPost;
      end;
    end
    else
    begin
      if qryAtualizarRegistroM110cofinsvalor.ascurrency <> 0 then
      begin
        qryRegistroM510.edit;
        qryRegistroM510vl_aj.AsCurrency := qryAtualizarRegistroM110cofinsvalor.ascurrency;
        qryRegistroM510.AfterPost := nil;
        qryRegistroM510.post;
        qryRegistroM510.AfterPost := qryRegistroM510AfterPost;
      end
      else
      begin
        qryRegistroM510.AfterDelete := nil;
        qryRegistroM510.delete;
        qryRegistroM510.AfterDelete := qryRegistroM510AfterDelete;
      end;
    end;

    qryRegistroM510.First;
    while not qryregistrom510.eof do
    begin
      qryRegistroM500vl_ajus_reduc.AsCurrency := qryRegistroM500vl_ajus_reduc.AsCurrency + qryRegistroM510vl_aj.AsCurrency;
      qryregistrom510.next;
    end;
    qryRegistroM500.post;

    GuardarRegistroAtual(qryRegistroM500, false);
    AdicionarValores_M600;
    VoltarRegistroAtual(qryRegistroM500);

  end
  else
  begin
  
    GuardarRegistroAtual(qryRegistroM500, false);
    AdicionarValores_M600;
    VoltarRegistroAtual(qryRegistroM500);


  {
    while not qryregistrom500.eof do
      qryregistrom500.delete;
      }
  end;
end;

