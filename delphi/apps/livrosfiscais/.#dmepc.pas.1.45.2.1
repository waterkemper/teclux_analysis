procedure TdtmEPC.P_RegistroC170;
var
  vExibirDados : Boolean;

  function MovimentacaoFisica(tipo: byte): TACBrMovimentacaoFisica;
  begin
    case tipo of
     1: result := mfSim;
    else result := mfNao;
    end;
  end;

  function ACBrSituacaoTribICMS(tipo: String) : TACBrSituacaoTribICMS;
  begin
         if tipo = '000' then result := sticmsTributadaIntegralmente                               // '000' //	Tributada integralmente
    else if tipo = '010' then result := sticmsTributadaComCobracaPorST                             // '010' //	Tributada e com cobrança do ICMS por substituição tributária
    else if tipo = '020' then result := sticmsComReducao                                           // '020' //	Com redução de base de cálculo
    else if tipo = '030' then result := sticmsIsentaComCobracaPorST                                // '030' //	Isenta ou não tributada e com cobrança do ICMS por substituição tributária
    else if tipo = '040' then result := sticmsIsenta                                               // '040' //	Isenta
    else if tipo = '041' then result := sticmsNaoTributada                                         // '041' //	Não tributada
    else if tipo = '050' then result := sticmsSuspensao                                            // '050' //	Suspensão
    else if tipo = '051' then result := sticmsDiferimento                                          // '051' //	Diferimento
    else if tipo = '060' then result := sticmsCobradoAnteriormentePorST                            // '060' //	ICMS cobrado anteriormente por substituição tributária
    else if tipo = '070' then result := sticmsComReducaoPorST                                      // '070' //	Com redução de base de cálculo e cobrança do ICMS por substituição tributária
    else if tipo = '090' then result := sticmsOutros                                               // '090' //	Outros
    else if tipo = '100' then result := sticmsEstrangeiraImportacaoDiretaTributadaIntegralmente    // '100' // Estrangeira - Importação direta - Tributada integralmente
    else if tipo = '110' then result := sticmsEstrangeiraImportacaoDiretaTributadaComCobracaPorST  // '110' // Estrangeira - Importação direta - Tributada e com cobrança do ICMS por substituição tributária
    else if tipo = '120' then result := sticmsEstrangeiraImportacaoDiretaComReducao                // '120' // Estrangeira - Importação direta - Com redução de base de cálculo
    else if tipo = '130' then result := sticmsEstrangeiraImportacaoDiretaIsentaComCobracaPorST     // '130' // Estrangeira - Importação direta - Isenta ou não tributada e com cobrança do ICMS por substituição tributária
    else if tipo = '140' then result := sticmsEstrangeiraImportacaoDiretaIsenta                    // '140' // Estrangeira - Importação direta - Isenta
    else if tipo = '141' then result := sticmsEstrangeiraImportacaoDiretaNaoTributada              // '141' // Estrangeira - Importação direta - Não tributada
    else if tipo = '150' then result := sticmsEstrangeiraImportacaoDiretaSuspensao                 // '150' // Estrangeira - Importação direta - Suspensão
    else if tipo = '151' then result := sticmsEstrangeiraImportacaoDiretaDiferimento               // '151' // Estrangeira - Importação direta - Diferimento
    else if tipo = '160' then result := sticmsEstrangeiraImportacaoDiretaCobradoAnteriormentePorST // '160' // Estrangeira - Importação direta - ICMS cobrado anteriormente por substituição tributária
    else if tipo = '170' then result := sticmsEstrangeiraImportacaoDiretaComReducaoPorST           // '170' // Estrangeira - Importação direta - Com redução de base de cálculo e cobrança do ICMS por substituição tributária
    else if tipo = '180' then result := sticmsEstrangeiraImportacaoDiretaOutros                    // '190' // Estrangeira - Importação direta - Outras
    else if tipo = '200' then result := sticmsEstrangeiraAdqMercIntTributadaIntegralmente          // '200' // Estrangeira - Adquirida no mercado interno - Tributada integralmente
    else if tipo = '210' then result := sticmsEstrangeiraAdqMercIntTributadaComCobracaPorST        // '210' // Estrangeira - Adquirida no mercado interno - Tributada e com cobrança do ICMS por substituição tributária
    else if tipo = '220' then result := sticmsEstrangeiraAdqMercIntComReducao                      // '220' // Estrangeira - Adquirida no mercado interno - Com redução de base de cálculo
    else if tipo = '230' then result := sticmsEstrangeiraAdqMercIntIsentaComCobracaPorST           // '230' // Estrangeira - Adquirida no mercado interno - Isenta ou não tributada e com cobrança do ICMS por substituição tributária
    else if tipo = '240' then result := sticmsEstrangeiraAdqMercIntIsenta                          // '240' // Estrangeira - Adquirida no mercado interno - Isenta
    else if tipo = '241' then result := sticmsEstrangeiraAdqMercIntNaoTributada                    // '241' // Estrangeira - Adquirida no mercado interno - Não tributada
    else if tipo = '250' then result := sticmsEstrangeiraAdqMercIntSuspensao                       // '250' // Estrangeira - Adquirida no mercado interno - Suspensão
    else if tipo = '251' then result := sticmsEstrangeiraAdqMercIntDiferimento                     // '251' // Estrangeira - Adquirida no mercado interno - Diferimento
    else if tipo = '260' then result := sticmsEstrangeiraAdqMercIntCobradoAnteriormentePorST       // '260' // Estrangeira - Adquirida no mercado interno - ICMS cobrado anteriormente por substituição tributária
    else if tipo = '270' then result := sticmsEstrangeiraAdqMercIntComReducaoPorST                 // '270' // Estrangeira - Adquirida no mercado interno - Com redução de base de cálculo e cobrança do ICMS por substituição tributária
    else if tipo = '290' then result := sticmsEstrangeiraAdqMercIntOutros                          // '290' // Estrangeira - Adquirida no mercado interno - Outras
    else if tipo = '101' then result := sticmsSimplesNacionalTributadaComPermissaoCredito          // '101' // Simples Nacional - Tributada pelo Simples Nacional com permissão de crédito
    else if tipo = '102' then result := sticmsSimplesNacionalTributadaSemPermissaoCredito          // '102' // Simples Nacional - Tributada pelo Simples Nacional sem permissão de crédito
    else if tipo = '103' then result := sticmsSimplesNacionalIsencaoPorFaixaReceitaBruta           // '103' // Simples Nacional - Isenção do ICMS no Simples Nacional para faixa de receita bruta
    else if tipo = '201' then result := sticmsSimplesNacionalTributadaComPermissaoCreditoComST     // '201' // Simples Nacional - Tributada pelo Simples Nacional com permissão de crédito e com cobrança do ICMS por substituição tributária
    else if tipo = '202' then result := sticmsSimplesNacionalTributadaSemPermissaoCreditoComST     // '202' // Simples Nacional - Tributada pelo Simples Nacional sem permissão de crédito e com cobrança do ICMS por substituição tributária
    else if tipo = '203' then result := sticmsSimplesNacionalIsencaoPorFaixaReceitaBrutaComST      // '203' // Simples Nacional - Isenção do ICMS no Simples Nacional para faixa de receita bruta e com cobrança do ICMS por substituição tributária
    else if tipo = '300' then result := sticmsSimplesNacionalImune                                 // '300' // Simples Nacional - Imune
    else if tipo = '400' then result := sticmsSimplesNacionalNaoTributada                          // '400' // Simples Nacional - Não tributada pelo Simples Nacional
    else if tipo = '500' then result := sticmsSimplesNacionalCobradoAnteriormentePorST             // '500' // Simples Nacional - ICMS cobrado anteriormente por substituição tributária (substituído) ou por antecipação
    else if tipo = '900' then result := sticmsSimplesNacionalOutros;                               // '900' // Simples Nacional - Outros
  end;


  function ApuracaoIPI(tipo: byte): TACBrApuracaoIPI;
  begin
    case tipo of
      0: result := iaMensal;
      1: result := iaDecendial;
    end;
  end;

  function ACBrSituacaoTribIPI(tipo: String) : TACBrSituacaoTribIPI;
  begin
         if tipo = '00' then result := stipiEntradaRecuperacaoCredito // '00' // Entrada com recuperação de crédito
    else if tipo = '01' then result := stipiEntradaTributradaZero     // '01' // Entrada tributada com alíquota zero
    else if tipo = '02' then result := stipiEntradaIsenta             // '02' // Entrada isenta
    else if tipo = '03' then result := stipiEntradaNaoTributada       // '03' // Entrada não-tributada
    else if tipo = '04' then result := stipiEntradaImune              // '04' // Entrada imune
    else if tipo = '05' then result := stipiEntradaComSuspensao       // '05' // Entrada com suspensão
    else if tipo = '49' then result := stipiOutrasEntradas            // '49' // Outras entradas
    else if tipo = '50' then result := stipiSaidaTributada            // '50' // Saída tributada
    else if tipo = '51' then result := stipiSaidaTributadaZero        // '51' // Saída tributada com alíquota zero
    else if tipo = '52' then result := stipiSaidaIsenta               // '52' // Saída isenta
    else if tipo = '53' then result := stipiSaidaNaoTributada         // '53' // Saída não-tributada
    else if tipo = '54' then result := stipiSaidaImune                // '54' // Saída imune
    else if tipo = '55' then result := stipiSaidaComSuspensao         // '55' // Saída com suspensão
    else if tipo = '99' then result := stipiOutrasSaidas;             // '99' // Outras saídas
  end;
begin

  qryRegistroC170.First;
  while not qryRegistroC170.Eof do
  begin
    with ACBrSPEDPisCofins.bloco_c.RegistroC170New do
    begin
      if not qryRegistroC170.fieldbyname('NUM_ITEM').IsNull then
        NUM_ITEM      := qryRegistroC170.fieldbyname('NUM_ITEM').asstring
      else
        NUM_ITEM      := inttostr(qryRegistroC170.recno);

      COD_ITEM        := qryRegistroC170.fieldbyname('COD_ITEM').asstring;
      DESCR_COMPL     := trim(qryRegistroC170.fieldbyname('DESCR_COMPL').asstring);
      QTD             := qryRegistroC170.fieldbyname('QTD').AsCurrency;
      UNID            := qryRegistroC170.fieldbyname('UNID').asstring;

      VL_ITEM         := {qryRegistroC170.fieldbyname('VL_BC_PIS').AsCurrency} qryRegistroC170.fieldbyname('VL_ITEM').AsCurrency;

      VL_DESC         := qryRegistroC170.fieldbyname('VL_DESC').AsCurrency;
      IND_MOV         := MovimentacaoFisica(qryRegistroC170.fieldbyname('IND_MOV').AsInteger);
      CST_ICMS        := ACBrSituacaoTribICMS(preencheString(trim(qryRegistroC170.fieldbyname('CST_ICMS').asstring),'0',3,false));
      CFOP            := qryRegistroC170.fieldbyname('CFOP').asstring;
      COD_NAT         := qryRegistroC170.fieldbyname('COD_NAT').asstring;
      VL_BC_ICMS      := qryRegistroC170.fieldbyname('VL_BC_ICMS').AsCurrency;
      ALIQ_ICMS       := qryRegistroC170.fieldbyname('ALIQ_ICMS').AsCurrency;
      VL_ICMS         := qryRegistroC170.fieldbyname('VL_ICMS').AsCurrency;
      VL_BC_ICMS_ST   := qryRegistroC170.fieldbyname('VL_BC_ICMS_ST').AsCurrency;
      ALIQ_ST         := qryRegistroC170.fieldbyname('ALIQ_ST').AsCurrency;
      VL_ICMS_ST      := qryRegistroC170.fieldbyname('VL_ICMS_ST').AsCurrency;
      IND_APUR        := ApuracaoIPI(qryRegistroC170.fieldbyname('IND_APUR').AsInteger);
      CST_IPI         := ACBrSituacaoTribIPI(qryRegistroC170.fieldbyname('CST_IPI').asstring);
//        COD_ENQ         := qryRegistroC170.fieldbyname('COD_ENQ').asstring; {ainda não definida pelo governo}
      VL_BC_IPI       := qryRegistroC170.fieldbyname('VL_BC_IPI').AsCurrency;
      ALIQ_IPI        := qryRegistroC170.fieldbyname('ALIQ_IPI').AsCurrency;
      VL_IPI          := qryRegistroC170.fieldbyname('VL_IPI').AsCurrency;
      CST_PIS         := ACBrSituacaoTribPIS(qryRegistroC170.fieldbyname('CST_PIS').asstring);

      // 202, 411  : devolução de venda
      vExibirDados:=  (( {(qryRegistroC170.fieldbyname('CFOP').asinteger mod 1000<>202) and
                          (qryRegistroC170.fieldbyname('CFOP').asinteger mod 1000<>411)}
                         not eHNotaFiscalSaidaDevolucao(qryRegistroC170cfop.asinteger)
                       ) and
                      (qryRegistroC100ind_oper.asinteger=1)
                      ) or
                     (qryRegistroC100ind_oper.asinteger=0);

      VL_BC_PIS       := ifthen(vExibirDados, qryRegistroC170.fieldbyname('VL_BC_PIS').AsCurrency,0);

      ALIQ_PIS_PERC   := qryRegistroC170.fieldbyname('ALIQ_PIS_PERC').AsCurrency;

      QUANT_BC_PIS    := qryRegistroC170.fieldbyname('QUANT_BC_PIS').AsCurrency;
      ALIQ_PIS_R      := qryRegistroC170.fieldbyname('ALIQ_PIS_R').AsCurrency;

      VL_PIS          := ifthen(vExibirDados, qryRegistroC170.fieldbyname('VL_PIS').AsCurrency,0);

      CST_COFINS      := ACBrSituacaoTribCOFINS(qryRegistroC170.fieldbyname('CST_COFINS').asstring);

      VL_BC_COFINS    := ifthen(vExibirDados, qryRegistroC170.fieldbyname('VL_BC_COFINS').AsCurrency,0);

      ALIQ_COFINS_PERC:= qryRegistroC170.fieldbyname('ALIQ_COFINS_PERC').AsCurrency;

      QUANT_BC_COFINS := qryRegistroC170.fieldbyname('QUANT_BC_COFINS').AsCurrency;
      ALIQ_COFINS_R   := qryRegistroC170.fieldbyname('ALIQ_COFINS_R').AsCurrency;

      VL_COFINS       := ifthen(vExibirDados, qryRegistroC170.fieldbyname('VL_COFINS').AsCurrency,0);

      COD_CTA         := qryRegistroC170.fieldbyname('COD_CTA').asstring;


    end;
    qryRegistroC170.Next;
  end;

end;

