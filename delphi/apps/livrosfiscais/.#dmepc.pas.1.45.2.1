        VL_BC_ICMS_ST := qryRegistroC100.fieldbyname('VL_BC_ICMS_ST').AsCurrency;
        VL_ICMS_ST    := qryRegistroC100.fieldbyname('VL_ICMS_ST').AsCurrency;
        VL_IPI        := qryRegistroC100.fieldbyname('VL_IPI').AsCurrency;
