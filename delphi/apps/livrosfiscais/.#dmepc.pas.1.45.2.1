procedure TdtmEPC.CalcularBloco_P;
var
  vTotalServicos : currency;
  vTotalReceitaBruta : Currency;
  VtotalAtribuido : Boolean;

  procedure AdicionarRegistroP100(Filial: integer; classificacaofiscal : String; valor : Currency);
  var
   vcod_ativ_econ: String;
   vAliquota : Currency;
   begin
    vcod_ativ_econ := '';
    vAliquota := 0;

    if (classificacaofiscal<>'') then
    begin
      qrypiscofins_t511.first;
      while not qrypiscofins_t511.eof do
      begin
        if (trim(qryPISCofins_T511ncm.AsString)<>'') and
           (pos(SomenteNumero(trim(qryPISCofins_T511ncm.AsString)), SomenteNumero(classificacaofiscal)) = 1) then
        begin
          vcod_ativ_econ := qryPISCofins_T511codigo.asstring;
          vAliquota := qryPISCofins_T511aliquota.AsCurrency;
          break;
        end;
        qrypiscofins_t511.next;
      end;
    end;

    if vcod_ativ_econ<>'' then
    begin
      if qryregistrop100.Locate('filial;cod_ativ_econ',VarArrayOf([filial, vcod_ativ_econ]),[]) then
      begin
        qryRegistroP100.edit;
        qryRegistroP100vl_rec_ativ_estab.AsCurrency := qryRegistroP100vl_rec_ativ_estab.AsCurrency + valor;
        qryRegistroP100.post;
      end
      else
      begin
        qryRegistroP100.append;
        qryRegistroP100filial.AsInteger := filial;
        qryRegistroP100cod_ativ_econ.AsString := vcod_ativ_econ;
        qryRegistroP100vl_rec_ativ_estab.AsCurrency := valor;
        qryRegistroP100aliq_cont.AsCurrency := vAliquota;
        qryRegistroP100.post;
      end;
    end;

  end;

begin
  qrypiscofins_t511.close;
  qrypiscofins_t511.open;

  vTotalServicos := 0;

  qryRegistroP100.First;
  while not qryRegistroP100.Eof do
  begin
//    qryRegistroP200.First;
//    while not qryRegistroP200.Eof do
//      qryregistrop200.Delete;
    qryRegistroP100.Delete;
  end;

  P_RegistroA001(false); // abrir tabelas do bloco a

  qryRegistroA010.First;  //filiais
  while not qryRegistroA010.Eof do
  begin
    vTotalServicos := 0;
    qryregistroA100.First;
    while not qryregistroa100.Eof do  //notas fiscais de servicos saidas
    begin
      qryRegistroa170.First;  //itens
      while not qryRegistroa170.Eof do
      begin
        vTotalServicos := vTotalServicos + qryRegistroA170vl_item.AsCurrency;
        qryRegistroa170.Next;
      end;
      qryRegistroa100.Next;
    end;

    if vTotalServicos <> 0 then
    begin
      qryRegistroP100.Append;
      qryRegistroP100filial.AsInteger := qryRegistroA010codigo.AsInteger;
      qryRegistroP100cod_ativ_econ.AsString := '99999999';
      qryRegistroP100vl_rec_ativ_estab.AsCurrency := vTotalServicos;
    end;
    qryRegistroA010.next;
  end;


  P_RegistroC001(false); // abrir tabelas do bloco C

  qryRegistroc010.First;  //filiais
  while not qryRegistroc010.Eof do
  begin
    vTotalReceitaBruta := 0;
    vTotalAtribuido := false;
    qryregistroc100.First;
    while not qryregistroc100.Eof do
    begin
      if qryRegistroC100ind_oper.AsInteger = 1 then  //NF
      begin
        qryRegistroC170.First;  //itens
        while not qryRegistroC170.Eof do
        begin
          if not (qryRegistroC170cst_pis.Asinteger in [49]) and
             (qryRegistroC170cfop.AsInteger mod 1000 in [101,102,122,123]) then
          begin
            vTotalReceitaBruta := vTotalReceitaBruta + qryRegistroC170vl_item.AsCurrency;
            AdicionarRegistroP100(qryRegistroC010codigo.AsInteger, qryRegistroC170classificacaofiscal.AsString, qryRegistroC170vl_item.AsCurrency);
          end;
          qryRegistroC170.Next;
        end;
      end;
      qryRegistroC100.Next;
    end;

    // ecf´s
    qryRegistroc400.First;
    while not qryRegistroC400.Eof do
    begin
      qryregistroc405.First;
      while not qryRegistroc405.Eof do
      begin
        qryregistroc481.First;
        while not qryRegistroc481.Eof do
        begin
          vTotalReceitaBruta := vTotalReceitaBruta + qryRegistroC481vl_item.AsCurrency;
          AdicionarRegistroP100(qryRegistroC010codigo.AsInteger, qryRegistroC481classificacaofiscal.AsString, qryRegistroC481vl_item.AsCurrency);
          qryregistroc481.next;
        end;
        qryregistroc405.next;
      end;
      qryRegistroc400.next;
    end;

    qryregistrop100.First;
    while not qryregistrop100.eof do
    begin
      if qryRegistroP100filial.AsInteger = qryRegistroC010codigo.AsInteger then
      begin
        qryRegistroP100.edit;
        qryRegistroP100vl_rec_tot_est.AsCurrency := vTotalReceitaBruta;
        qryRegistroP100.Post;
        vTotalAtribuido := true;
      end;
      qryregistrop100.next;
    end;


    if not VtotalAtribuido then
    begin
      qryRegistroP100.Append;
      qryRegistroP100filial.AsInteger := qryRegistroA010codigo.AsInteger;
      qryRegistroP100vl_rec_tot_est.AsCurrency := vTotalReceitaBruta;
      qryRegistroP100.post;
    end;

    qryRegistroc010.next;
  end;

end;

