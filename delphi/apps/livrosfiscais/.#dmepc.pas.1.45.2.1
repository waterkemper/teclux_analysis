function TdtmEPC.ACBrInd_Rec(ind: byte): TACBrInd_Rec;
begin
  case ind of
    1: result := crCliente;          //01- Clientes
    2: result := crAdministradora;   //02- Administradora de cartão de débito/crédito
    3: result := crTituloDeCredito;  //03- Título de crédito - Duplicata, nota promissória, cheque, etc.
    4: result := crDocumentoFiscal;  //04- Documento fiscal
    5: result := crItemVendido;      //05- Item vendido (produtos e serviços)
    99: result := crOutros;           //99- Outros (Detalhar no campo 10 – Informação Complementar)
  end;
end;

