procedure TdtmEPC.P_Registro0100;
begin
  with ACBrSPEDPisCofins.Bloco_0.Registro0100New do
  begin
    NOME    := copy(trim(parsistema.NomeContador),1,60);  /// Nome do contabilista/escritório:
    CPF     := copy(trim(parsistema.CPFContador),1,11);   /// Número de inscrição no CPF:
    CRC     := copy(trim(parsistema.CRCContador),1,15);   /// Número de inscrição no Conselho Regional:
    CNPJ    := '';                                        /// CNPJ do escritório de contabilidade, se houver:
    CEP     := format('%8.8d', [strtoint(CEPFilialBase)]);/// Código de Endereçamento Postal:
    ENDERECO:= trim(copy(trim(RuaFilialBase),1,60));            /// Logradouro e endereço do imóvel:
    NUM     := trim(NumeroFilialBase);                    /// Número do imóvel:
    COMPL   := copy(trim(ComplementoFilialBase),1,60);    /// Dados complementares do endereço:
    BAIRRO  := copy(trim(BairroFilialBase),1,60);         /// Bairro em que o imóvel está situado:
    FONE    := copy((inttostr(parsistema.DDDContador)+
               inttostr(parsistema.TeleFoneContador)),1,10); /// Número do telefone:
    FAX     := copy((trim(DDDFaxFilialBase)+trim(FaxFilialBase)),1,10); /// Número do fax:
    EMAIL   := ParSistema.EmailContador;                  /// Endereço do correio eletrônico:
    COD_MUN := strtoint(CodigoCidadeIBGEFilialBase);  /// Código do município, conforme tabela IBGE:
  end;

end;

procedure TdtmEPC.P_Registro0110;

  function ACBrCodIndIncTributaria(tipo: byte): TACBrCodIndIncTributaria;
  begin
    case tipo of
      1: result := codEscrOpIncNaoCumulativo; // 0 - Escrituração de operações com incidencia exclusivamente no regime não cumulativo
      2: result := codEscrOpIncCumulativo;    // 1 - Escrituração de operações com incidencia exclusivamente no regime cumulativo
      3: result := codEscrOpIncAmbos;         // 2 - Escrituração de operações com incidencia nos regimes cumulativo e não cumulativo
    end;
  end;

  function ACBrIndAproCred(tipo: byte): TACBrIndAproCred;
  begin
    case tipo of
      1: result :=  indMetodoApropriacaoDireta;   // 0 - Método de apropriação direta
      2: result :=  indMetodoDeRateioProporcional;// 1 - Método de rateio proporcional(Receita Bruta);
    end;
  end;

  function ACBrCodIndTipoCon(tipo: byte): TACBrCodIndTipoCon;
  begin
    case tipo of
      1: result := codIndTipoConExclAliqBasica; // 0 - Apuração da Contribuição Exclusivamente a Alíquota Básica
      2: result := codIndTipoAliqEspecificas;   // 1 - Apuração da Contribuição a Alíquotas Específicas (Diferenciadas e/ou por Unidade de Medida de Produto)
    end;
  end;

  function ACBrCodIndCritEscrit(tipo: byte): TACBrCodIndCritEscrit;
  begin
    case tipo of
      1 : result := codRegimeCaixa;                   //1 – Regime de Caixa – Escrituração consolidada (Registro F500);
      2 : result := codRegimeCompetEscritConsolidada; //2 – Regime de Competência - Escrituração consolidada (Registro F550);
      9 : result := codRegimeCompetEscritDetalhada;   //9 – Regime de Competência - Escrituração detalhada, com base nos registros dos Blocos “A”, “C”, “D” e “F”.
    end;
  end;

begin
  if qryFiliaissped_pis_cofins.AsBoolean then
  begin
    with ACBrSPEDPisCofins.Bloco_0.Registro0110New do
    begin
