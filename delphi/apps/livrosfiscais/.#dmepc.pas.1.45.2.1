        if qryRegistroC100.fieldbyname('COD_MOD').AsString='55' then
          CHV_NFE       := qryRegistroC100.fieldbyname('CHV_NFE').AsString;

        DT_DOC        := qryRegistroC100.fieldbyname('DT_DOC').AsDateTime;

        if qryRegistroC100.fieldbyname('DT_E_S').AsDateTime <= DataFinal then
          DT_E_S        := qryRegistroC100.fieldbyname('DT_E_S').AsDateTime;

        VL_DOC        := qryRegistroC100.fieldbyname('VL_DOC').AsCurrency;

        if qryRegistroC100.fieldbyname('IND_PGTO').IsNull then
          IND_PGTO      := tpSemPagamento
        else
          IND_PGTO      := TipoPagamento(qryRegistroC100.fieldbyname('IND_PGTO').AsInteger);

        VL_DESC       := qryRegistroC100.fieldbyname('VL_DESC').AsCurrency;
        VL_ABAT_NT    := qryRegistroC100.fieldbyname('VL_ABAT_NT').AsCurrency;
        VL_MERC       := qryRegistroC100.fieldbyname('VL_MERC').AsCurrency;

        if qryRegistroC100.fieldbyname('IND_FRT').IsNull then
          IND_FRT := tfNenhum
        else
          IND_FRT       := ACBrTipoFrete(qryRegistroC100.fieldbyname('IND_FRT').AsInteger);

        VL_FRT        := qryRegistroC100.fieldbyname('VL_FRT').AsCurrency;
        VL_SEG        := qryRegistroC100.fieldbyname('VL_SEG').AsCurrency;
        VL_OUT_DA     := qryRegistroC100.fieldbyname('VL_OUT_DA').AsCurrency;
        VL_BC_ICMS    := qryRegistroC100.fieldbyname('VL_BC_ICMS').AsCurrency;
