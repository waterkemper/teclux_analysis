        RefazConsultaPorNome(qryRegistroD501, ['filial','datainicial','datafinal'],
                             [qryepcfilial.asinteger, datainicial, datafinal]);

        RefazConsultaPorNome(qryRegistroD505, ['filial','datainicial','datafinal'],
