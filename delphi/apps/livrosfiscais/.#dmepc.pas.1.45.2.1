procedure TdtmEPC.P_RegistroM001;
begin
  if (qryRegistrof500.RecordCount > 0) or
     (qryRegistroM100.RecordCount > 0) or
     (qryRegistroM200.RecordCount > 0) or
     (qryRegistroM300.RecordCount > 0) or
     (qryRegistroM400.RecordCount > 0) or

     (qryRegistroM500.RecordCount > 0) or
     (qryRegistroM600.RecordCount > 0) or
     (qryRegistroM700.RecordCount > 0) or
     (qryRegistroM800.RecordCount > 0) then
  begin
    ACBrSPEDPisCofins.Bloco_M.RegistroM001.IND_MOV := imComDados;
    P_RegistroM100;
    P_RegistroM200;
    P_RegistroM300;
    P_RegistroM400;

    P_RegistroM500;
    P_RegistroM600;
    P_RegistroM700;
    P_RegistroM800;


  end
  else
  begin
    ACBrSPEDPisCofins.Bloco_M.RegistroM001.IND_MOV := imSemDados;
    {
    ACBrSPEDPisCofins.Bloco_M.RegistroM001.IND_MOV := imComDados;
    P_RegistroM200;
    P_RegistroM600;
    }
  end;
end;

