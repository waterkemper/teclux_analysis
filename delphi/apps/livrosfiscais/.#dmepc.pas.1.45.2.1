procedure TdtmEPC.qryRegistroM505CalcFields(DataSet: TDataSet);
begin
  inherited;
  qryRegistroM505vl_bc_cofins_nc.ascurrency := qryRegistroM505vl_bc_cofins_tot.ascurrency -
                                            qryRegistroM505vl_bc_cofins_cum.ascurrency;
{
Valor da Base de Cálculo do Crédito, vinculada ao tipo de
Crédito escriturado em M100.
- Para os CST_PIS = “50”, “51”, “52”, “60”, “61” e “62”:
Informar o valor do Campo 06 (VL_BC_PIS_NC);
- Para os CST_PIS = “53”, “54”, “55”, “56”, “63”, “64”
“65” e “66” (Crédito sobre operações vinculadas a mais
de um tipo de receita): Informar a parcela do valor do
Campo 06 (VL_BC_PIS_NC) vinculada especificamente
ao tipo de crédito escriturado em M100.

O valor deste campo será transportado para o Campo 04
(VL_BC_PIS) do registro M100.   ?????????????

}
  if (qryRegistroM505cst_cofins.AsString = '50') or
     (qryRegistroM505cst_cofins.AsString = '51') or
     (qryRegistroM505cst_cofins.AsString = '52') or
     (qryRegistroM505cst_cofins.AsString = '60') or
     (qryRegistroM505cst_cofins.AsString = '61') or
     (qryRegistroM505cst_cofins.AsString = '62') then
    if qryRegistroM505vl_bc_cofins.AsCurrency <> qryRegistroM505vl_bc_cofins_nc.ascurrency then
       qryRegistroM505vl_bc_cofins.AsCurrency := qryRegistroM505vl_bc_cofins_nc.ascurrency;

end;

procedure TdtmEPC.AdicionarValores_M210(VL_ITEM, VL_BC_PIS, ALIQ_PIS, VL_PIS, VL_AJUS_REDUC: Currency; CST_PIS, Origem: String; NumeroNota: String);
var
  vCOD_CONT : String;
  v : String;
begin
{ cst pis
 01     | Operação Tributável com Alíquota Básica
 02     | Operação Tributável com Alíquota Diferenciada
 03     | Operação Tributável com Alíquota por Unidade de Medida de Produto
 05     | Operação Tributável por Substituição Tributária

}

  vCOD_CONT := '';
  if Origem <> 'f200' then
  begin
    if (qryepcCOD_INC_TRIB.AsInteger in [1,3]) and (CST_PIS='01') and (ALIQ_PIS=1.65) then  {1-Não Cumulativa  2-Cum  3-Não Cum. e Cum}
      vCOD_CONT := '01' //Contribuição não-cumulativa apurada a alíquota básica
    else
    if ((qryepcCOD_INC_TRIB.AsInteger in [2,3]) and (CST_PIS='01') and (ALIQ_PIS=0.65)) or  {Situação para Notas de Saídas}

       ((qryepcCOD_INC_TRIB.AsInteger in [2]) and (strtoint(CST_PIS) in [50,51,52,53,54,55,56,60,61,62,63,64,65,66]) and
        (ALIQ_PIS=0.65) and
        (VL_AJUS_REDUC<>0) and
        (NumeroNota<>'') ) then  {Situação para Notas de Entrada de Devolução}

      vCOD_CONT := '51' // Contribuição cumulativa apurada a alíquota básica
    else
    if (qryepcCOD_INC_TRIB.AsInteger in [1,3]) and (CST_PIS='02') then
      vCOD_CONT := '02' // Contribuição não-cumulativa apurada a alíquotas diferenciadas
    else
    if (qryepcCOD_INC_TRIB.AsInteger in [2]) and (CST_PIS='02') then
      vCOD_CONT := '52' //Contribuição cumulativa apurada a alíquotas diferenciadas
    else
    if (qryepcCOD_INC_TRIB.AsInteger in [1,3]) and (CST_PIS='03') then
      vCOD_CONT := '03' // Contribuição não-cumulativa apurada a alíquota por unidade de medida de produto
    else
    if (qryepcCOD_INC_TRIB.AsInteger in [2]) and (CST_PIS='03') then
      vCOD_CONT := '53' // Contribuição cumulativa apurada a alíquota por unidade de medida de produto
    else
    if (CST_PIS='05') and (ALIQ_PIS=0.65) then
      vCOD_CONT := '31' // Contribuição apurada por substituição tributária
    else
    if (CST_PIS='05') and ((ALIQ_PIS=0.65) or (ALIQ_PIS<>0)) then
      vCOD_CONT := '32'; // Contribuição apurada por substituição tributária – Vendas à Zona Franca de Manaus
  end
  else
  begin
    if (CST_PIS='01') and (ALIQ_PIS=1.65) and (qryepcCOD_INC_TRIB.AsInteger in [1,3]) then
      vCOD_CONT := '04' //Contribuição não-cumulativa apurada a alíquota básica - Atividade Imobiliária
    else
    if (CST_PIS='01') and (ALIQ_PIS=0.65) and (qryepcCOD_INC_TRIB.AsInteger in [2,3]) then
      vCOD_CONT := '54'; //Contribuição cumulativa apurada a alíquota básica - Atividade Imobiliária
  end;

  if vCOD_CONT = '' then
  begin
   v := '1';
  {
    MensagemErro('Não foi possível enquadrar um Código da contribuição social apurada no período, conforme a Tabela 4.3.5, '+#13+
                 'COD_IND_TRIB = ' + qryepcCOD_INC_TRIB.AsString +#13+
                 'CST_PIS = ' + CST_PIS +#13+
                 'ALIQ_PIS = ' + floattostr(aliq_pis))
   }
  end
  else
  begin
    if qryRegistroM200.RecordCount = 0 then
    begin
      qryRegistroM200.Append;
      qryRegistroM200.post;
    end;

    if ((vCOD_CONT='03') or (vCOD_CONT='53')) then
    begin
      if not qryRegistroM210.Locate('cod_cont', VarArrayOf([vCOD_CONT]), []) then
      begin
        qryRegistroM210.Append;
        qryRegistroM210cod_cont.AsString   := vCOD_CONT;
      end
      else
        qryRegistroM210.edit;
    end
    else
    begin
      if not qryRegistroM210.Locate('cod_cont;aliq_pis', VarArrayOf([vCOD_CONT, ALIQ_PIS]), []) then
      begin
        qryRegistroM210.Append;
        qryRegistroM210cod_cont.AsString   := vCOD_CONT;
        qryRegistroM210aliq_pis.AsCurrency := ALIQ_PIS;
      end
      else
        qryRegistroM210.edit;
    end;


    {
    Quando o valor do campo 02 (COD_CONT) for igual a 01, 51, 02, 52, 31 ou 32, o valor do campo será igual
à soma dos seguintes campos (quando o CST da operação vinculada for 01, 02, 03, 04, 05 com alíquota diferente de zero
e 49):
    }
    if (qryRegistroM210cod_cont.AsInteger in [01, 51, 02, 52, 31, 32, 04, 54]) and  { no manual não esta o 04, 54 (porém ao gerar os calculos no epc ele gera )}
       (((strtoint(CST_PIS) IN [01, 02, 03, 04, 05]) and (ALIQ_PIS<>0)) or
        (strtoint(CST_PIS) IN [49])) then
    begin

      qryRegistroM210VL_REC_BRT.AsCurrency := qryRegistroM210VL_REC_BRT.AsCurrency + VL_ITEM;

      if qryepcIND_APRO_CRED.asinteger = 2 then  //rateio proporcional
      begin
        if (vCOD_CONT = '01') or
           (vCOD_CONT = '02') or
           (vCOD_CONT = '03') or
           (vCOD_CONT = '04') then { no manual não esta o 04, 54 (porém ao gerar os calculos no epc ele gera )}
          qryepcREC_BRU_NCUM_TRIB_MI.AsCurrency := qryepcREC_BRU_NCUM_TRIB_MI.AsCurrency + VL_ITEM
        else
        if (vCOD_CONT = '51') or
           (vCOD_CONT = '52') or
           (vCOD_CONT = '53') or
           (vCOD_CONT = '54') then { no manual não esta o 04, 54 (porém ao gerar os calculos no epc ele gera )}
          qryepcREC_BRU_CUM.AsCurrency := qryepcREC_BRU_CUM.AsCurrency + VL_ITEM;
      end;
    end;


{Quando a natureza da pessoa jurídica (IND_NAT_PJ do registro 0000 igual a 00 ou 02) não for sociedade
cooperativa e o valor do campo COD_CONT for igual a 01, 51, 02, 52, 31 ou 32, o valor do campo será igual a:}

    if (qryFiliaisind_nat_pj.asinteger in [0,2]) and
       (qryRegistroM210cod_cont.AsInteger in [01, 51, 02, 52, 31, 32, 04, 54]) then    { no manual não esta o 04, 54 (porém ao gerar os calculos no epc ele gera )}
    begin
       {  VL_BC_PIS do registro F100, quando o valor do campo ALIQ_PIS não conste nas alíquotas da tabela 4.3.11 -
         “Produtos Sujeitos à Incidência Monofásica da Contribuição Social – Alíquotas por Unidade de Medida de
         Produto (CST 04 - Revenda)” }

      qryRegistroM210VL_BC_CONT.AsCurrency := qryRegistroM210VL_BC_CONT.AsCurrency + VL_BC_PIS;
      qryRegistroM210VL_CONT_APUR.AsCurrency := qryRegistroM210VL_CONT_APUR.AsCurrency + VL_PIS; {Alterado cofe verificação do Sr. Manoel em 10/10/2012 }
      {qryRegistroM210VL_CONT_APUR.AsCurrency := qryRegistroM210VL_BC_CONT.AsCurrency * qryRegistroM210aliq_pis.ascurrency / 100;}

    end;

    qryRegistroM210VL_AJUS_REDUC.ascurrency := qryRegistroM210VL_AJUS_REDUC.ascurrency + VL_AJUS_REDUC;

    qryRegistroM210.Post;

    {O valor da redução só vai existir no caso de regime cumulativo}
    if (qryepcCOD_INC_TRIB.AsInteger = 2) and (VL_AJUS_REDUC <> 0) then
    begin
      qryRegistroM220.AfterPost := nil;
      if not qryRegistroM220.Locate('IND_AJ;geradosistemaSN',VarArrayof([0,'S']),[]) then // 0 : AJUSTE DE REDUÇÃO
      begin
        qryRegistroM220.Append;
        qryRegistroM220ind_aj.AsInteger := 0;
        qryRegistroM220cod_aj.AsString := '03';
        qryRegistroM220num_doc.AsString := NumeroNota;
        qryRegistroM220descr_aj.AsString := 'DEVOLUÇÃO DE VENDAS';
        qryRegistroM220dt_ref.AsDateTime := DataInicial;
        qryRegistroM220geradosistema.asboolean := true;
      end
      else
      begin
        qryRegistroM220.edit;
        qryRegistroM220num_doc.AsString := qryRegistroM220num_doc.AsString +', ';
        if pos(NumeroNota+',',qryRegistroM220num_doc.AsString)=0 then
          qryRegistroM220num_doc.AsString := qryRegistroM220num_doc.AsString + NumeroNota;
      end;

      qryRegistroM220vl_aj.AsCurrency := qryRegistroM220vl_aj.AsCurrency + VL_AJUS_REDUC;
      qryRegistroM220.Post;

      qryRegistroM220.AfterPost := qryRegistroM220AfterPost;

    end;

  end;

end;

procedure TdtmEPC.AdicionarValores_M200;
var
 vvl_bc_pis: Currency;
begin

  qryRegistroM200.first;
//  while not qryRegistroM200.eof do
//    qryRegistroM200.Delete;



    {SOMATÓRIO DO REGISTRO M200}
    qryRegistroM200.edit;

    {informar o valor total da contribuição não cumulativa do período, correspondendo à soma
do campo 13 (VL_CONT_PER) do registro M210, quando o valor do campo “COD_CONT” for igual a 01, 02, 03, 04,
32 (neste caso quando a pessoa jurídica estiver sujeita a não cumulatividade, exclusivamente ou não) ou 71. No caso da
pessoa jurídica sujeitar-se exclusivamente ao regime cumulativo da contribuição, o valor do campo deverá ser igual a 0.}

    qryRegistroM200VL_TOT_CONT_NC_PER.ascurrency := 0;

    qryRegistroM210.First;
    while not qryRegistroM210.eof do
    begin
      if ((qryRegistroM210cod_cont.AsInteger in [01, 02, 03, 04, 32]) and (qryepcCOD_INC_TRIB.AsInteger in [1,3])) or
         ((qryRegistroM210cod_cont.AsInteger in [71]) and (qryepcCOD_INC_TRIB.AsInteger in [1])) then
        qryRegistroM200VL_TOT_CONT_NC_PER.ascurrency := qryRegistroM200VL_TOT_CONT_NC_PER.ascurrency +
                                                        qryRegistroM210VL_CONT_PER.AsCurrency;
      qryRegistroM210.next;
    end;

{informar o valor do crédito descontado, apurado no próprio período da escrituração,
correspondendo ao somatório do campo 14 (VL_CRED_DESC) dos diversos registros M100. No caso da pessoa jurídica
estar sujeita exclusivamente ao regime cumulativo da contribuição, o valor deste campo deverá ser igual a 0.
Validação: O somatório dos campos VL_TOT_CRED_DESC e VL_TOT_CRED_DESC_ANT deve ser menor ou igual
ao valor do campo VL_TOT_CONT_NC_PER.}

    if (qryepcCOD_INC_TRIB.AsInteger in [1,3]) then
    begin
      if qryepcIND_APRO_CRED.asinteger = 2 then  //rateio proporcional
      begin
        qryRegistroM100.First;
        while not qryRegistroM100.eof do
        begin
          vvl_bc_pis := 0;
          qryRegistroM100.Edit;
          qryRegistroM100vl_bc_pis.clear;
          qryRegistroM100.post;

          qryRegistroM105.First;
          while not qryregistroM105.Eof do
          begin
            qryRegistroM105.edit;
            qryRegistroM105vl_bc_pis_cum.ascurrency :=  roundto(qryRegistroM105vl_bc_pis_tot.ascurrency * qryepcREC_BRU_CUM.ascurrency /  qryepcTotalRegistro111.ascurrency, -2);
            qryRegistroM105.post;
            qryRegistroM105.next;
          end;

          qryRegistroM105.First;
          while not qryregistroM105.Eof do
          begin
            vvl_bc_pis :=  vvl_bc_pis + qryRegistroM105vl_bc_pis.AsCurrency;
            qryregistroM105.next;
          end;

          qryRegistroM100.Edit;
          qryRegistroM100vl_bc_pis.AsCurrency := vvl_bc_pis;
          qryRegistroM100.post;

          qryRegistroM100.next;
        end;
      end;

      qryRegistroM200vl_tot_cred_desc.AsCurrency := 0;
      qryRegistroM100.first;
      while not qryRegistroM100.eof do
      begin
        qryRegistroM200vl_tot_cred_desc.AsCurrency := qryRegistroM200vl_tot_cred_desc.AsCurrency +
                                                      qryRegistroM100vl_cred_desc.AsCurrency;
        qryRegistroM100.next;
      end;

    end;


{ FALTA IMPLEMNTAR O BLOCO 1
informar o valor do crédito descontado, apurado em período de apuração anterior,
correspondendo ao somatório do campo 13 (VL_CRED_DESC_EFD), dos diversos registros 1100. Na geração
automática da apuração pela PVA, este campo será preenchido automaticamente com o somatório do campo 13 dos
registros 1100. No caso da pessoa jurídica estar sujeita exclusivamente ao regime cumulativo da contribuição, o valor
deste campo deverá ser igual a 0.

VL_TOT_CRED_DESC_ANT

}


{ FALTA IMPLEMNTAR O BLOCO 1
informar o valor na fonte deduzido do valor da contribuição não cumulativa devida no
período. Caso a retenção na fonte tenha ocorrido no próprio período da escrituração, ela deverá estar detalhada no registro
F600 e também no registro 1300. No caso de saldo de retenções de períodos anteriores, os valores retidos e utilizados
deverão ser informados no registro 1300. No caso da pessoa jurídica estar sujeita exclusivamente ao regime cumulativo
da contribuição, o valor deste campo deverá ser igual a 0.
VL_RET_NC
}
    qryRegistroM200VL_RET_NC.ascurrency := 0;
    if (qryepcCOD_INC_TRIB.AsInteger in [1,3]) then
    begin
      qryRegistroF600.First;
      while not qryRegistroF600.eof do
      begin
        if (qryRegistroM200VL_RET_NC.AsCurrency + qryRegistroF600vl_ret_pis.AsCurrency) >
           qryRegistroM200vl_tot_cont_nc_dev.AsCurrency then
        begin
          qryRegistroM200vl_ret_cum.AsCurrency := (qryRegistroM200VL_RET_NC.AsCurrency + qryRegistroF600vl_ret_pis.AsCurrency) -
                                                   qryRegistroM200vl_tot_cont_nc_dev.AsCurrency;

          qryRegistroM200VL_RET_NC.AsCurrency := qryRegistroM200vl_tot_cont_nc_dev.AsCurrency;
        end
        else
          qryRegistroM200VL_RET_NC.AsCurrency := qryRegistroM200VL_RET_NC.AsCurrency +
                                                 qryRegistroF600vl_ret_pis.AsCurrency;
        qryRegistroF600.next;
      end;
    end;

{informar o valor de outras deduções do valor da contribuição não cumulativa devida no
período, correspondendo ao somatório do campo VL_DED_PIS dos registros F700 quando IND_NAT_DED = 0
(dedução de natureza não cumulativa). No caso da pessoa jurídica estar sujeita exclusivamente ao regime cumulativo da
contribuição, o valor deste campo deverá ser igual a 0.}



    qryRegistroM200VL_OUT_DED_NC.AsCurrency := 0;
    if (qryepcCOD_INC_TRIB.AsInteger in [1,3]) then
    begin
      qryRegistroF700.First;
      while not qryRegistroF700.eof do
      begin
        if qryRegistroF700ind_nat_ded.AsInteger = 0 then  //dedução de natureza não cumulativa
          qryRegistroM200VL_OUT_DED_NC.AsCurrency := qryRegistroM200VL_OUT_DED_NC.AsCurrency +
                                                 qryRegistroF700vl_ded_pis.AsCurrency;
        qryRegistroF700.next;
      end;
    end;

{informar o valor total da contribuição cumulativa do período, correspondendo à soma do
campo 13 (VL_CONT_PER) do registro M210, quando o valor do campo “COD_CONT” for igual a 31, 32 (neste caso
quando a pessoa jurídica estiver sujeita exclusivamente ao regime cumulativo), 51, 52, 53, 54 ou 72. No caso da pessoa
jurídica estar sujeita exclusivamente ao regime não cumulativo da contribuição, o valor deste campo deverá ser igual a 0.}


    qryRegistroM200vl_tot_cont_cum_per.ascurrency := 0;
    qryRegistroM210.First;
    while not qryRegistroM210.eof do
    begin
      if ((qryRegistroM210cod_cont.AsInteger in [31, 32]) and (qryepcCOD_INC_TRIB.AsInteger in [2])) or
         ((qryRegistroM210cod_cont.AsInteger in [51, 52, 53, 54, 72]) and (qryepcCOD_INC_TRIB.AsInteger in [2,3])) then
        qryRegistroM200vl_tot_cont_cum_per.ascurrency := qryRegistroM200vl_tot_cont_cum_per.ascurrency +
                                                        qryRegistroM210VL_CONT_PER.AsCurrency;
      qryRegistroM210.next;
    end;

{FALTA IMPLEMNTAR O BLOCO 1
informar o valor na fonte deduzido do valor da contribuição cumulativa devida no período.
Caso a retenção na fonte tenha ocorrido no próprio período da escrituração, ela deverá estar detalhada no registro F600 e
também no registro 1300. No caso de saldo de retenções de períodos anteriores, os valores retidos e utilizados deverão ser
informados no registro 1300. No caso da pessoa jurídica estar sujeita exclusivamente ao regime não cumulativo da
contribuição, o valor deste campo deverá ser igual a 0}

    qryRegistroM200vl_ret_cum.AsCurrency := 0;
    if (qryepcCOD_INC_TRIB.AsInteger in [2,3]) then
    begin
      qryRegistroF600.First;
      while not qryRegistroF600.eof do
      begin
        qryRegistroM200vl_ret_cum.AsCurrency := qryRegistroM200vl_ret_cum.AsCurrency +
                                               qryRegistroF600vl_ret_pis.AsCurrency;
        qryRegistroF600.next;
      end;
    end;

{informar o valor de outras deduções do valor da contribuição cumulativa devida no
período, correspondendo, no máximo, ao somatório do campo VL_DED_PIS dos registros F700 quando IND_NAT_DED
= 1 (dedução de natureza cumulativa). No caso da pessoa jurídica estar sujeita exclusivamente ao regime não cumulativo
da contribuição, o valor deste campo deverá ser igual a 0.}

    qryRegistroM200vl_out_ded_cum.AsCurrency := 0;
    if (qryepcCOD_INC_TRIB.AsInteger in [2,3]) then
    begin
      qryRegistroF700.First;
      while not qryRegistroF700.eof do
      begin
        if qryRegistroF700ind_nat_ded.AsInteger = 0 then  //dedução de natureza cumulativa
          qryRegistroM200vl_out_ded_cum.AsCurrency := qryRegistroM200vl_out_ded_cum.AsCurrency +
                                                 qryRegistroF700vl_ded_pis.AsCurrency;
        qryRegistroF700.next;
      end;
    end;

    qryRegistroM200.Post;

end;

procedure TdtmEPC.AdicionarValores_M600;
var
 vvl_bc_cofins: Currency;
begin
  qryRegistroM600.first;

    {SOMATÓRIO DO REGISTRO M600}
    qryRegistroM600.edit;

    {informar o valor total da contribuição não cumulativa do período, correspondendo à soma
do campo 13 (VL_CONT_PER) do registro M610, quando o valor do campo “COD_CONT” for igual a 01, 02, 03, 04,
32 (neste caso quando a pessoa jurídica estiver sujeita a não cumulatividade, exclusivamente ou não) ou 71. No caso da
pessoa jurídica sujeitar-se exclusivamente ao regime cumulativo da contribuição, o valor do campo deverá ser igual a 0.}

    qryRegistroM600VL_TOT_CONT_NC_PER.ascurrency := 0;
    qryRegistroM610.First;
    while not qryRegistroM610.eof do
    begin
      if ((qryRegistroM610cod_cont.AsInteger in [01, 02, 03, 04, 32]) and (qryepcCOD_INC_TRIB.AsInteger in [1,3])) or
         ((qryRegistroM610cod_cont.AsInteger in [71]) and (qryepcCOD_INC_TRIB.AsInteger in [1])) then
        qryRegistroM600VL_TOT_CONT_NC_PER.ascurrency := qryRegistroM600VL_TOT_CONT_NC_PER.ascurrency +
                                                        qryRegistroM610VL_CONT_PER.AsCurrency;
      qryRegistroM610.next;
    end;

{informar o valor do crédito descontado, apurado no próprio período da escrituração,
correspondendo ao somatório do campo 14 (VL_CRED_DESC) dos diversos registros M500. No caso da pessoa jurídica
estar sujeita exclusivamente ao regime cumulativo da contribuição, o valor deste campo deverá ser igual a 0.
Validação: O somatório dos campos VL_TOT_CRED_DESC e VL_TOT_CRED_DESC_ANT deve ser menor ou igual
ao valor do campo VL_TOT_CONT_NC_PER.}

    if (qryepcCOD_INC_TRIB.AsInteger in [1,3]) then
    begin
      if qryepcIND_APRO_CRED.asinteger = 2 then  //rateio proporcional
      begin
        qryRegistroM500.First;
        while not qryRegistroM500.eof do
        begin
          vvl_bc_cofins := 0;
          qryRegistroM500.Edit;
          qryRegistroM500vl_bc_cofins.clear;
          qryRegistroM500.post;

          qryRegistroM505.First;
          while not qryregistroM505.Eof do
          begin
            qryRegistroM505.edit;
            qryRegistroM505vl_bc_cofins_cum.ascurrency :=  roundto(qryRegistroM505vl_bc_cofins_tot.ascurrency * qryepcREC_BRU_CUM.ascurrency /  qryepcTotalRegistro111.ascurrency,-2);
            qryRegistroM505.post;
            qryRegistroM505.next;
          end;

          qryRegistroM505.First;
          while not qryregistroM505.Eof do
          begin
            vvl_bc_cofins :=  vvl_bc_cofins + qryRegistroM505vl_bc_cofins.AsCurrency;
            qryregistroM505.next;
          end;

          qryRegistroM500.Edit;
          qryRegistroM500vl_bc_cofins.AsCurrency := vvl_bc_cofins;
          qryRegistroM500.post;

          qryRegistroM500.next;
        end;
      end;

      qryRegistroM500.First;
      qryRegistroM600vl_tot_cred_desc.AsCurrency := 0;
      while not qryRegistroM500.eof do
      begin
        qryRegistroM600vl_tot_cred_desc.AsCurrency := qryRegistroM600vl_tot_cred_desc.AsCurrency +
                                                      qryRegistroM500vl_cred_desc.AsCurrency;
        qryRegistroM500.next;
      end;
    end;

{ FALTA IMPLEMNTAR O BLOCO 1
informar o valor do crédito descontado, apurado em período de apuração anterior,
correspondendo ao somatório do campo 13 (VL_CRED_DESC_EFD), dos diversos registros 1100. Na geração
automática da apuração pela PVA, este campo será preenchido automaticamente com o somatório do campo 13 dos
registros 1100. No caso da pessoa jurídica estar sujeita exclusivamente ao regime cumulativo da contribuição, o valor
deste campo deverá ser igual a 0.

VL_TOT_CRED_DESC_ANT

}


{ FALTA IMPLEMNTAR O BLOCO 1
informar o valor na fonte deduzido do valor da contribuição não cumulativa devida no
período. Caso a retenção na fonte tenha ocorrido no próprio período da escrituração, ela deverá estar detalhada no registro
F600 e também no registro 1300. No caso de saldo de retenções de períodos anteriores, os valores retidos e utilizados
deverão ser informados no registro 1300. No caso da pessoa jurídica estar sujeita exclusivamente ao regime cumulativo
da contribuição, o valor deste campo deverá ser igual a 0.
VL_RET_NC
}

    qryRegistroM600VL_RET_NC.AsCurrency := 0;
    if (qryepcCOD_INC_TRIB.AsInteger in [1,3]) then
    begin
      qryRegistroF600.First;
      while not qryRegistroF600.eof do
      begin
        if (qryRegistroM600VL_RET_NC.AsCurrency + qryRegistroF600vl_ret_cofins.AsCurrency) >
           qryRegistroM600vl_tot_cont_nc_dev.AsCurrency then
        begin
          qryRegistroM600vl_ret_cum.AsCurrency := (qryRegistroM600VL_RET_NC.AsCurrency + qryRegistroF600vl_ret_cofins.AsCurrency) -
                                                   qryRegistroM600vl_tot_cont_nc_dev.AsCurrency;
          qryRegistroM600VL_RET_NC.AsCurrency := qryRegistroM600vl_tot_cont_nc_dev.AsCurrency;
        end
        else
          qryRegistroM600VL_RET_NC.AsCurrency := qryRegistroM600VL_RET_NC.AsCurrency +
                                                 qryRegistroF600vl_ret_cofins.AsCurrency;
        qryRegistroF600.next;
      end;
    end;

{informar o valor de outras deduções do valor da contribuição não cumulativa devida no
período, correspondendo ao somatório do campo VL_DED_cofins dos registros F700 quando IND_NAT_DED = 0
(dedução de natureza não cumulativa). No caso da pessoa jurídica estar sujeita exclusivamente ao regime cumulativo da
contribuição, o valor deste campo deverá ser igual a 0.}

    qryRegistroM600VL_OUT_DED_NC.AsCurrency := 0;
    if (qryepcCOD_INC_TRIB.AsInteger in [1,3]) then
    begin
      qryRegistroF700.First;
      while not qryRegistroF700.eof do
      begin
        if qryRegistroF700ind_nat_ded.AsInteger = 0 then  //dedução de natureza não cumulativa
          qryRegistroM600VL_OUT_DED_NC.AsCurrency := qryRegistroM600VL_OUT_DED_NC.AsCurrency +
                                                 qryRegistroF700vl_ded_cofins.AsCurrency;
        qryRegistroF700.next;
      end;
    end;

{informar o valor total da contribuição cumulativa do período, correspondendo à soma do
campo 13 (VL_CONT_PER) do registro M610, quando o valor do campo “COD_CONT” for igual a 31, 32 (neste caso
quando a pessoa jurídica estiver sujeita exclusivamente ao regime cumulativo), 51, 52, 53, 54 ou 72. No caso da pessoa
jurídica estar sujeita exclusivamente ao regime não cumulativo da contribuição, o valor deste campo deverá ser igual a 0.}

    qryRegistroM600vl_tot_cont_cum_per.ascurrency := 0;
    qryRegistroM610.First;
    while not qryRegistroM610.eof do
    begin
      if ((qryRegistroM610cod_cont.AsInteger in [31, 32]) and (qryepcCOD_INC_TRIB.AsInteger in [2])) or
         ((qryRegistroM610cod_cont.AsInteger in [51, 52, 53, 54, 72]) and (qryepcCOD_INC_TRIB.AsInteger in [2,3])) then
        qryRegistroM600vl_tot_cont_cum_per.ascurrency := qryRegistroM600vl_tot_cont_cum_per.ascurrency +
                                                        qryRegistroM610VL_CONT_PER.AsCurrency;
      qryRegistroM610.next;
    end;

{FALTA IMPLEMNTAR O BLOCO 1
informar o valor na fonte deduzido do valor da contribuição cumulativa devida no período.
Caso a retenção na fonte tenha ocorrido no próprio período da escrituração, ela deverá estar detalhada no registro F600 e
também no registro 1300. No caso de saldo de retenções de períodos anteriores, os valores retidos e utilizados deverão ser
informados no registro 1300. No caso da pessoa jurídica estar sujeita exclusivamente ao regime não cumulativo da
contribuição, o valor deste campo deverá ser igual a 0}


    qryRegistroM600vl_ret_cum.AsCurrency := 0;
    if (qryepcCOD_INC_TRIB.AsInteger in [2,3]) then
    begin
      qryRegistroF600.First;
      while not qryRegistroF600.eof do
      begin
        qryRegistroM600vl_ret_cum.AsCurrency := qryRegistroM600vl_ret_cum.AsCurrency +
                                               qryRegistroF600vl_ret_cofins.AsCurrency;
        qryRegistroF600.next;
      end;
    end;

{informar o valor de outras deduções do valor da contribuição cumulativa devida no
período, correspondendo, no máximo, ao somatório do campo VL_DED_cofins dos registros F700 quando IND_NAT_DED
= 1 (dedução de natureza cumulativa). No caso da pessoa jurídica estar sujeita exclusivamente ao regime não cumulativo
da contribuição, o valor deste campo deverá ser igual a 0.}

    if (qryepcCOD_INC_TRIB.AsInteger in [2,3]) then
    begin
      qryRegistroM600vl_out_ded_cum.AsCurrency := 0;
      qryRegistroF700.First;
      while not qryRegistroF700.eof do
      begin
        if qryRegistroF700ind_nat_ded.AsInteger = 0 then  //dedução de natureza não cumulativa
          qryRegistroM600vl_out_ded_cum.AsCurrency := qryRegistroM600vl_out_ded_cum.AsCurrency +
                                                 qryRegistroF700vl_ded_cofins.AsCurrency;
        qryRegistroF700.next;
      end;
    end;

    qryRegistroM600.Post;

end;

procedure TdtmEPC.AdicionarValores_M610(VL_ITEM, VL_BC_COFINS, ALIQ_COFINS, VL_COFINS, VL_AJUS_REDUC: Currency; CST_COFINS, Origem: String; NumeroNota: String);
var
  vCOD_CONT : String;
  v : String;
begin
{ cst cofins
 01     | Operação Tributável com Alíquota Básica
 02     | Operação Tributável com Alíquota Diferenciada
 03     | Operação Tributável com Alíquota por Unidade de Medida de Produto
}

  vCOD_CONT := '';
  if Origem <> 'f200' then
  begin

    if (qryepcCOD_INC_TRIB.AsInteger in [1,3]) and (CST_cofins='01') and (ALIQ_cofins=7.6) then  {1-Não Cumulativa  2-Cum  3-Não Cum. e Cum}
      vCOD_CONT := '01' //Contribuição não-cumulativa apurada a alíquota básica
    else
    if (qryepcCOD_INC_TRIB.AsInteger in [2,3]) and (CST_cofins='01') and (ALIQ_cofins=3) or { Situacao para notas de saida }

       ((qryepcCOD_INC_TRIB.AsInteger in [2]) and (strtoint(CST_COFINS) in [50,51,52,53,54,55,56,60,61,62,63,64,65,66]) and
        (ALIQ_COFINS=3) and
        (VL_AJUS_REDUC<>0) and
        (NumeroNota<>'') ) then  {Situação para Notas de Entrada de Devolução}


      vCOD_CONT := '51' // Contribuição cumulativa apurada a alíquota básica
    else
    if (qryepcCOD_INC_TRIB.AsInteger in [1,3]) and (CST_cofins='02') then
      vCOD_CONT := '02' // Contribuição não-cumulativa apurada a alíquotas diferenciadas
    else
    if (qryepcCOD_INC_TRIB.AsInteger in [2]) and (CST_cofins='02') then
      vCOD_CONT := '52' //Contribuição cumulativa apurada a alíquotas diferenciadas
    else
    if (qryepcCOD_INC_TRIB.AsInteger in [1,3]) and (CST_cofins='03') then
      vCOD_CONT := '03' // Contribuição não-cumulativa apurada a alíquota por unidade de medida de produto
    else
    if (qryepcCOD_INC_TRIB.AsInteger in [2]) and (CST_cofins='03') then
      vCOD_CONT := '53' // Contribuição cumulativa apurada a alíquota por unidade de medida de produto
    else
    if (CST_cofins='05') and (ALIQ_cofins=3) then
      vCOD_CONT := '31' // Contribuição apurada por substituição tributária
    else
    if (CST_cofins='05') and ((ALIQ_cofins=3) or (ALIQ_cofins<>0)) then
      vCOD_CONT := '32'; // Contribuição apurada por substituição tributária – Vendas à Zona Franca de Manaus
  end
  else
  begin
    if (CST_COFINS='01') and (ALIQ_COFINS=7.6) and (qryepcCOD_INC_TRIB.AsInteger in [1,3]) then
      vCOD_CONT := '04' //Contribuição não-cumulativa apurada a alíquota básica - Atividade Imobiliária
    else
    if (CST_COFINS='01') and (ALIQ_COFINS=3) and (qryepcCOD_INC_TRIB.AsInteger in [2,3]) then
      vCOD_CONT := '54'; //Contribuição cumulativa apurada a alíquota básica - Atividade Imobiliária
  end;


  if vCOD_CONT = '' then
  begin
     v := '1';

    {
    MensagemErro('Não foi possível enquadrar um Código da contribuição social apurada no período, conforme a Tabela 4.3.5, '+#13+
                 'COD_IND_TRIB = ' + qryepcCOD_INC_TRIB.AsString +#13+
                 'CST_cofins = ' + CST_cofins +#13+
                 'ALIQ_cofins = ' + floattostr(aliq_cofins))
    }
  end
  else
  begin
    if qryRegistroM600.RecordCount = 0 then
    begin
      qryRegistroM600.Append;
      qryRegistroM600.post;
    end;

    if ((vCOD_CONT='03') or (vCOD_CONT='53')) then
    begin
      if not qryRegistroM610.Locate('cod_cont', VarArrayOf([vCOD_CONT]), []) then
      begin
        qryRegistroM610.Append;
        qryRegistroM610cod_cont.AsString   := vCOD_CONT;
      end
      else
        qryRegistroM610.edit;
    end
    else
    begin
      if not qryRegistroM610.Locate('cod_cont;aliq_cofins', VarArrayOf([vCOD_CONT, ALIQ_cofins]), []) then
      begin
        qryRegistroM610.Append;
        qryRegistroM610cod_cont.AsString   := vCOD_CONT;
        qryRegistroM610aliq_cofins.AsCurrency := ALIQ_cofins;
      end
      else
        qryRegistroM610.edit;
    end;


    {
    Quando o valor do campo 02 (COD_CONT) for igual a 01, 51, 02, 52, 31 ou 32, o valor do campo será igual
à soma dos seguintes campos (quando o CST da operação vinculada for 01, 02, 03, 04, 05 com alíquota diferente de zero
e 49):
    }
    if (qryRegistroM610cod_cont.AsInteger in [01, 51, 02, 52, 31, 32, 04, 54]) and    { no manual não esta o 04, 54 (porém ao gerar os calculos no epc ele gera )}
       (((strtoint(CST_cofins) IN [01, 02, 03, 04, 05]) and (ALIQ_cofins<>0)) or
        (strtoint(CST_cofins) IN [49])) then
       qryRegistroM610VL_REC_BRT.AsCurrency := qryRegistroM610VL_REC_BRT.AsCurrency + VL_ITEM;


{Quando a natureza da pessoa jurídica (IND_NAT_PJ do registro 0000 igual a 00 ou 02) não for sociedade
cooperativa e o valor do campo COD_CONT for igual a 01, 51, 02, 52, 31 ou 32, o valor do campo será igual a:}

    if (qryFiliaisind_nat_pj.asinteger in [0,2]) and
       (qryRegistroM610cod_cont.AsInteger in [01, 51, 02, 52, 31, 32, 04, 54]) then
    begin
       {  VL_BC_cofins do registro F100, quando o valor do campo ALIQ_cofins não conste nas alíquotas da tabela 4.3.11 -
         “Produtos Sujeitos à Incidência Monofásica da Contribuição Social – Alíquotas por Unidade de Medida de
         Produto (CST 04 - Revenda)” }
      qryRegistroM610VL_BC_CONT.AsCurrency := qryRegistroM610VL_BC_CONT.AsCurrency + VL_BC_cofins;
       qryRegistroM610VL_CONT_APUR.AsCurrency := qryRegistroM610VL_CONT_APUR.AsCurrency + VL_cofins; {alterado conforme verificação do Manoel Abreu em 10/10/2012 }
      {qryRegistroM610VL_CONT_APUR.AsCurrency := qryRegistroM610VL_BC_CONT.AsCurrency * qryRegistroM610aliq_cofins.ascurrency / 100;}

    end;
    qryRegistroM610.Post;

    {O valor da redução só vai existir no caso de regime cumulativo}
    if (qryepcCOD_INC_TRIB.AsInteger = 2) and (VL_AJUS_REDUC <> 0) then
    begin
      qryRegistroM620.AfterPost := nil;
      if not qryRegistroM620.Locate('IND_AJ;geradosistemaSN',VarArrayof([0,'S']),[]) then // 0 : AJUSTE DE REDUÇÃO
      begin
        qryRegistroM620.Append;
        qryRegistroM620ind_aj.AsInteger := 0;
        qryRegistroM620cod_aj.AsString := '03';
        qryRegistroM620num_doc.AsString := NumeroNota;
        qryRegistroM620descr_aj.AsString := 'DEVOLUÇÃO DE VENDAS';
        qryRegistroM620dt_ref.AsDateTime := DataInicial;
        qryRegistroM620geradosistema.asboolean := true;
      end
      else
      begin
        qryRegistroM620.edit;
        qryRegistroM620num_doc.AsString := qryRegistroM620num_doc.AsString +', ';
        if pos(NumeroNota+',',qryRegistroM620num_doc.AsString)=0 then
          qryRegistroM620num_doc.AsString := qryRegistroM620num_doc.AsString + NumeroNota;
      end;

      qryRegistroM620vl_aj.AsCurrency := qryRegistroM620vl_aj.AsCurrency + VL_AJUS_REDUC;
      qryRegistroM620.Post;

      qryRegistroM620.AfterPost := qryRegistroM620AfterPost;

    end;

  end;

end;

procedure TdtmEPC.AdicionarValores_M400(VL_ITEM: Currency; CST_PIS,
  Origem: String);
begin
{ cst pis:
 04     | Operação Tributável Monofásica - Revenda a Alíquota Zero
 05     | Operação Tributável por Substituição Tributária
 06     | Operação Tributável a Alíquota Zero
 07     | Operação sem Incidência da Contribuição
 08     | Operação Sem Incidência da Contribuição
 09     | Operação com Suspensão da Contribuição
}
  if strtoint(cst_pis) in [04, 05, 06, 07, 08, 09] then
  begin
    if not qryRegistroM400.Locate('cst_pis', CST_PIS, []) then
    begin
      qryRegistroM400.Append;
      qryRegistroM400cst_pis.AsString   := CST_PIS;
      qryRegistroM400.post;

      qryRegistroM410.Append;
      qryRegistroM410nat_rec.AsString := '999'; //  Outras receitas com isenção
      qryRegistroM410.post;
    end;

    qryRegistroM400.edit;
    qryRegistroM400vl_tot_rec.AsCurrency := qryRegistroM400vl_tot_rec.AsCurrency + VL_ITEM;
    qryRegistroM400.post;

    qryRegistroM410.edit;
    qryRegistroM410vl_rec.AsCurrency := qryRegistroM410vl_rec.AsCurrency + VL_ITEM;
    qryRegistroM410.post;

    if qryepcIND_APRO_CRED.asinteger = 2 then  //rateio proporcional
      qryepcREC_BRU_NCUM_NT_MI.AsCurrency := qryRegistroM410vl_rec.AsCurrency;
  end;

end;

