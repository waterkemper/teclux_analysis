      COD_SIT    := ACBrCodSitF(qryRegistro1900cod_sit.AsString);
      VL_TOT_REC := qryRegistro1900VL_TOT_REC.asCurrency;
      QUANT_DOC  := qryRegistro1900quant_doc.asInteger;
      CST_PIS    := ACBrSituacaoTribPIS(qryRegistro1900cst_pis.AsString);
      CST_COFINS := ACBrSituacaoTribCOFINS(qryRegistro1900cst_cofins.AsString);
//      CFOP       := qryRegistro1900cfop.AsInteger;
      INF_COMPL  := qryRegistro1900inf_compl.asstring;
      COD_CTA    := qryRegistro1900cod_cta.AsString;
    end;
    qryRegistro1900.Next;
  end;
end;

function TdtmEPC.ACBrCodSitF(ind: String): TACBrCodSitF;
begin

      if ind = '00' then result := csffRegular            // 00 – Documento regular
 else if ind = '02' then result := csfCancelado           // 02 – Documento cancelado
 else if ind = '99' then result := csfOutros;             // 99 – Outros

end;

end.



