procedure TdtmEPC.P_REGISTROC110;
begin
  qryRegistroC110.First;
  while not qryRegistroC110.Eof do
  begin
    if qryRegistro0140.Locate('codigo',qryRegistroC110filial.AsInteger,[]) then
    begin
      if qryRegistro0450.Locate('txt;filial',VarArrayOf([qryRegistroC110txt.AsString, qryRegistroC110filial.AsInteger]),[]) then
      begin
        with ACBrSPEDPisCofins.Bloco_C.RegistroC110New do
        begin
          COD_INF   := IntToStr(qryRegistro0450.RecNo);
          TXT_COMPL := qryRegistro0450txt.AsString;
        end;
      end
      else
        MensagemErro('Inconsistência: Registro0450 x REgistroC110'+#10#13+
                     'Descrição não encontrada: '+qryRegistroC110txt.AsString);
    end
    else
      MensagemErro('Inconsistência: Registro0450 x REgistroC110'+#10#13+
                   'Descrição não encontrada: '+qryRegistroC110txt.AsString);
    qryRegistroC110.Next;
  end;

end;

