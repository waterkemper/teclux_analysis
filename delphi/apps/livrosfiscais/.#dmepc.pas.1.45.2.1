procedure TdtmEPC.qryRegistroM500CalcFields(DataSet: TDataSet);
begin
  inherited;

  qryRegistroM500vl_cred.AsCurrency := roundtod(qryRegistroM500vl_bc_cofins.AsCurrency * qryRegistroM500aliq_cofins.AsCurrency / 100, 2);

  qryRegistroM500VL_CRED_DISP.ascurrency := qryRegistroM500VL_CRED      .AsCurrency +
                                            qryRegistroM500VL_AJUS_ACRES.AsCurrency -
                                            qryRegistroM500VL_AJUS_REDUC.AsCurrency -
                                            qryRegistroM500VL_CRED_DIF  .AsCurrency;

  if qryRegistroM500IND_DESC_CRED.asinteger = 0 then
    if qryRegistroM500VL_CRED_DESC.ascurrency <> qryRegistroM500VL_CRED_DISP.ascurrency then
       qryRegistroM500VL_CRED_DESC.ascurrency := qryRegistroM500VL_CRED_DISP.ascurrency;

  qryRegistroM500SLD_CRED.AsCurrency := qryRegistroM500VL_CRED_DISP.ascurrency -
                                        qryRegistroM500VL_CRED_DESC.ascurrency;

end;

