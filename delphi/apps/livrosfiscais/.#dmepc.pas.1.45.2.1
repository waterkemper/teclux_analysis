function TdtmEPC.ACBrNaturezaFrtContratado(
  tipo: byte): TACBrNaturezaFrtContratado;
begin
  case tipo of
  0: result := nfcVendaOnusEstVendedor;    //0 - Operações de vendas; com ônus suportado pelo estabelecimento vendedor
  1: result := nfcVendaOnusAdquirente;     //1 - Operações de vendas; com ônus suportado pelo adquirente
  2: result := nfcCompraGeraCred;          //2 - Operações de compras (bens para revenda; matériasprima e outros produtos; geradores de crédito)
  3: result := nfcCompraNaoGeraCred;       //3 - Operações de compras (bens para revenda; matériasprima e outros produtos; não geradores de crédito)
  4: result := nfcTransfAcabadosPJ;        //4 - Transferência de produtos acabados entre estabelecimentos da pessoa jurídica
  5: result := nfcTransfNaoAcabadosPJ;     //5 - Transferência de produtos em elaboração entre estabelecimentos da pessoa jurídica
  9: result := nfcOutras;                   //9 - Outras.end;
  end;
end;  

procedure TdtmEPC.ZMonitor1MonitorEvent(Sql, Result: String);
var
 Listar : TStringList;
begin
  inherited;
  Listar := tStringlist.create;
  if fileexists('c:\logepc.sql') then
    Listar.loadfromfile('c:\logepc.sql');
  Listar.add('');
  Listar.add(sql);
  Listar.add(result);
  listar.savetofile('c:\logepc.sql');
  listar.free;
end;

