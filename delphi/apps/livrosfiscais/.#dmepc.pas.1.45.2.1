    if qryRegistro0140.Locate('codigo',qryRegistroA110filial.AsInteger,[]) then
    begin
      if qryRegistro0450.Locate('txt;filial',VarArrayOf([qryRegistroA110txt.AsString, qryRegistroA110filial.AsInteger]),[]) then
      begin
        with ACBrSPEDPisCofins.Bloco_A.RegistroA110New do
        begin
          COD_INF   := IntToStr(qryRegistro0450.RecNo);
          TXT_COMPL := qryRegistro0450txt.AsString;
        end;
      end
      else
        MensagemErro('Inconsistência: Registro0450 x REgistroA110'+#10#13+
                     'Descrição não encontrada: '+qryRegistroA110txt.AsString);
