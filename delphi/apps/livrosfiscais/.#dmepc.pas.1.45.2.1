  inherited;
  qryRegistroF200vl_pis.AsCurrency := roundtod(qryRegistroF200vl_bc_pis.AsCurrency * qryRegistroF200aliq_pis.AsCurrency / 100, 2);
  qryRegistroF200vl_cofins.AsCurrency := roundtod(qryRegistroF200vl_bc_cofins.AsCurrency * qryRegistroF200aliq_cofins.AsCurrency / 100, 2);
  if qryRegistroF200vl_tot_vend.AsCurrency <> 0 then
    qryRegistroF200perc_rec_receb.AsCurrency := (qryRegistroF200vl_rec_acum.AsCurrency + qryRegistroF200vl_tot_rec.AsCurrency) / qryRegistroF200vl_tot_vend.AsCurrency * 100
  else
    qryRegistroF200perc_rec_receb.AsCurrency := 0;
end;

procedure TdtmEPC.qryRegistroF205CalcFields(DataSet: TDataSet);
begin
  inherited;
  qryRegistroF205vl_cus_inc_acum.ascurrency := qryRegistroF205vl_cus_inc_acum_ant.ascurrency + qryRegistroF205vl_cus_inc_per_esc.ascurrency;
  qryRegistroF205vl_bc_cus_inc.AsCurrency := qryRegistroF205vl_cus_inc_acum.ascurrency - qryRegistroF205vl_exc_bc_cus_inc_acum.AsCurrency;
  qryRegistroF205vl_cred_pis_acum.AsCurrency := roundtod(qryRegistroF205vl_bc_cus_inc.AsCurrency * qryRegistroF205aliq_pis.AsCurrency / 100, 2);
  qryRegistroF205vl_cred_cofins_acum.AsCurrency := roundtod(qryRegistroF205vl_bc_cus_inc.AsCurrency * qryRegistroF205aliq_cofins.AsCurrency / 100, 2);

  qryRegistroF205vl_cred_pis_desc_fut.AsCurrency := qryRegistroF205vl_cred_pis_acum.AsCurrency - qryRegistroF205vl_cred_pis_desc_ant.AsCurrency - qryRegistroF205vl_cred_pis_desc.AsCurrency;
  qryRegistroF205vl_cred_cofins_desc_fut.AsCurrency := qryRegistroF205vl_cred_cofins_acum.AsCurrency - qryRegistroF205vl_cred_cofins_desc_ant.AsCurrency - qryRegistroF205vl_cred_cofins_desc.AsCurrency;
end;

