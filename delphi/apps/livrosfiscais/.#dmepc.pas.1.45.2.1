procedure TdtmEPC.P_REGISTROA100;


  function ACBrIndicadorEmitenteDF(ind: byte): TACBrIndicadorEmitenteDF;
  begin
    case ind of
      0: result := iedfProprio;       // 0 - Emissão própria
      1: result := iedfTerceiro;       // 1 - Emissão de Terceiros
    end;
  end;

  function ACBrSituacaoDF(ind: String): TACBrSituacaoDF;
  begin
         if ind = '00' then result := sdfRegular          // 00 – Documento regular
    else if ind = '01' then result := sdfExtRegular       // 01 - Escrituração extemporânea de documento regular
    else if ind = '02' then result := sdfCancelado        // 02 – Documento cancelado
    else if ind = '03' then result := sdfExtCancelado     // 03 Escrituração extemporânea de documento cancelado
    else if ind = '04' then result := sdfDenegado         // 04 NF-e ou CT-e – denegado
    else if ind = '05' then result := sdfInutilizado      // 05 NF-e ou CT-e - Numeração inutilizada
    else if ind = '06' then result := sdfComplementar     // 06 Documento Fiscal Complementar
    else if ind = '07' then result := sdfExtComplementar  // 07 Escrituração extemporânea de documento complementar
    else if ind = '08' then result := sdfEspecial;        // 08 Documento Fiscal emitido com base em Regime Especial ou Norma Específica
  end;

  function ACBrTipoPagamento(ind: byte): TACBrTipoPagamento;
  begin
    case ind of
      0: result := tpVista;        // 0 - À Vista
      1: result := tpPrazo;        // 1 - A Prazo
      2: result := tpSemPagamento; // 9 - Sem pagamento
    else
       result := tpNenhum          // Preencher vazio
    end;
  end;

begin
  qryRegistroA100.First;
  while not qryRegistroA100.Eof do
  begin
    with ACBrSPEDPisCofins.Bloco_A.RegistroA100New do
    begin

      if (qryRegistroA100.fieldbyname('COD_SIT').AsString = '02') then //cancelada
      begin
        IND_OPER      := ACBrIndicadorTpOperacao(qryRegistroA100ind_oper.asInteger); //02	Indicador do tipo de operação: 0 - Serviço Contratado pelo Estabelecimento; 1 - Serviço Prestado pelo Estabelecimento.	C	001*
        IND_EMIT      := ACBrIndicadorEmitenteDF(qryRegistroA100ind_emit.asInteger); //03	Indicador do emitente do documento fiscal: 0 - Emissão própria; 1 - Emissão de Terceiros	C	001*
        COD_SIT       := ACBrSituacaoDF(qryRegistroA100cod_sit.AsString);            //05	Código da situação do documento fiscal:00 – Documento regular 02 – Documento cancelado	N	002*
        SER           := qryRegistroA100ser.AsString;                                //06	Série do documento fiscal	C	020
        NUM_DOC       := qryRegistroA100num_doc.AsString;                            //08	Número do documento fiscal ou documento internacional equivalente	C	060
        IND_PGTO      := tpSemPagamento;
        if qryRegistroA100.fieldbyname('COD_MOD').AsString='55' then
          CHV_NFSE      := qryRegistroA100chv_nfse.AsString;                           //09	Chave/Código de Verificação da nota fiscal de serviço eletrônica	C	060
      end;

      if (qryRegistroA100.fieldbyname('COD_SIT').AsString = '08') then //regime especial
      begin
        IND_OPER      := ACBrIndicadorTpOperacao(qryRegistroA100ind_oper.asInteger); //02	Indicador do tipo de operação: 0 - Serviço Contratado pelo Estabelecimento; 1 - Serviço Prestado pelo Estabelecimento.	C	001*
        IND_EMIT      := ACBrIndicadorEmitenteDF(qryRegistroA100ind_emit.asInteger); //03	Indicador do emitente do documento fiscal: 0 - Emissão própria; 1 - Emissão de Terceiros	C	001*
        COD_PART      := qryRegistroA100cod_part.AsString;                           //04	Código do participante (campo 02 do Registro 0150):- do emitente do documento, no caso de emissão de terceiros;- do adquirente, no caso de serviços prestados.	C	060
        COD_SIT       := ACBrSituacaoDF(qryRegistroA100cod_sit.AsString);            //05	Código da situação do documento fiscal:00 – Documento regular 02 – Documento cancelado	N	002*
        NUM_DOC       := qryRegistroA100num_doc.AsString;                            //08	Número do documento fiscal ou documento internacional equivalente	C	060
        DT_DOC        := qryRegistroA100dt_doc.AsDateTime;                           //10	Data da emissão do documento fiscal	N	008*
        VL_DOC        := qryRegistroA100vl_doc.ascurrency;                           //12	Valor total do documento	N	-	02

        P_REGISTROA110;
        P_REGISTROA170;
      end;

      if (qryRegistroA100.fieldbyname('COD_SIT').AsString = '00') or  // normal
         (qryRegistroA100.fieldbyname('COD_SIT').AsString = '01') or  // normal extemporanea
         (qryRegistroA100.fieldbyname('COD_SIT').AsString = '06') then // complementar
      begin
        IND_OPER      := ACBrIndicadorTpOperacao(qryRegistroA100ind_oper.asInteger); //02	Indicador do tipo de operação: 0 - Serviço Contratado pelo Estabelecimento; 1 - Serviço Prestado pelo Estabelecimento.	C	001*
        IND_EMIT      := ACBrIndicadorEmitenteDF(qryRegistroA100ind_emit.asInteger); //03	Indicador do emitente do documento fiscal: 0 - Emissão própria; 1 - Emissão de Terceiros	C	001*
        COD_PART      := qryRegistroA100cod_part.AsString;                           //04	Código do participante (campo 02 do Registro 0150):- do emitente do documento, no caso de emissão de terceiros;- do adquirente, no caso de serviços prestados.	C	060
        COD_SIT       := ACBrSituacaoDF(qryRegistroA100cod_sit.AsString);            //05	Código da situação do documento fiscal:00 – Documento regular 02 – Documento cancelado	N	002*
        SER           := qryRegistroA100ser.AsString;                                //06	Série do documento fiscal	C	020
        SUB           := qryRegistroA100sub.AsString;;                               //07	Subsérie do documento fiscal	C	020
        NUM_DOC       := qryRegistroA100num_doc.AsString;                            //08	Número do documento fiscal ou documento internacional equivalente	C	060
        CHV_NFSE      := qryRegistroA100chv_nfse.AsString;                           //09	Chave/Código de Verificação da nota fiscal de serviço eletrônica	C	060
        DT_DOC        := qryRegistroA100dt_doc.AsDateTime;                           //10	Data da emissão do documento fiscal	N	008*
        DT_EXE_SERV   := qryRegistroA100dt_exe_serv.AsDateTime;                      //11	Data de Execução / Conclusão do Serviço	N	008*
        VL_DOC        := qryRegistroA100vl_doc.ascurrency;                           //12	Valor total do documento	N	-	02
        IND_PGTO      := ACBrTipoPagamento(qryRegistroA100ind_pgto.AsInteger);       //13	Indicador do tipo de pagamento:0- À vista;1- A prazo;9- Sem pagamento.	C	001*	-
        VL_DESC       := qryRegistroA100vl_desc.ascurrency;                          //14	Valor total do desconto	N	-	02
        VL_BC_PIS     := qryRegistroA100vl_bc_pis.ascurrency;                        //15	Valor da base de cálculo do PIS/PASEP	N	-	02
        VL_PIS        := qryRegistroA100VL_PIS.ascurrency;                           //16	Valor total do PIS	N	-	02
        VL_BC_COFINS  := qryRegistroA100VL_BC_COFINS.ascurrency;                     //17	Valor da base de cálculo da COFINS	N	-	02
        VL_COFINS     := qryRegistroA100VL_COFINS.ascurrency;                        //18	Valor total da COFINS	N	-	02
        VL_PIS_RET    := qryRegistroA100VL_PIS_RET.ascurrency;                       //19	Valor total do PIS retido na fonte	N	-	02
        VL_COFINS_RET := qryRegistroA100VL_COFINS_RET.ascurrency;                    //20	Valor total da COFINS retido na fonte.	N	-	02
        VL_ISS        := qryRegistroA100VL_ISS.ascurrency;                           //21	Valor do ISS	N	-	02

        P_REGISTROA110;
        P_REGISTROA170;

      end;

    end;
    qryRegistroA100.Next;

  end;
end;

procedure TdtmEPC.P_REGISTROA110;
begin
  qryRegistroA110.First;
  while not qryRegistroA110.Eof do
