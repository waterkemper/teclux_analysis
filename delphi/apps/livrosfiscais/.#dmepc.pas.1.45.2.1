procedure TdtmEPC.P_Registro0200;

function TipoItem(tipo: String): TACBrTipoItem;
begin
       if tipo = '00' then result := tiMercadoriaRevenda
  else if tipo = '01' then result := tiMateriaPrima
  else if tipo = '02' then result := tiEmbalagem
  else if tipo = '03' then result := tiProdutoProcesso
  else if tipo = '04' then result := tiProdutoAcabado
  else if tipo = '05' then result := tiSubproduto
  else if tipo = '06' then result := tiProdutoIntermediario
  else if tipo = '07' then result := tiMaterialConsumo
  else if tipo = '08' then result := tiAtivoImobilizado
  else if tipo = '09' then result := tiServicos
  else if tipo = '10' then result := tiOutrosInsumos
  else if tipo = '99' then result := tiOutras;
end;

begin

  qryRegistro0200.First;
  while not qryRegistro0200.Eof do
  begin
    with ACBrSPEDPisCofins.Bloco_0.Registro0200New do
    begin
      COD_ITEM    := qryRegistro0200.fieldbyname('COD_ITEM').asstring;       /// Código do item:
      DESCR_ITEM  := trim(qryRegistro0200.fieldbyname('DESCR_ITEM').asstring);     /// Descrição do item:
      COD_BARRA   := qryRegistro0200.fieldbyname('COD_BARRA').asstring;      /// Código de barra do produto, se houver:
      COD_ANT_ITEM:= qryRegistro0200.fieldbyname('COD_ANT_ITEM').asstring;   /// Código anterior do item (ultima apresentado):
      UNID_INV    := qryRegistro0200.fieldbyname('UNID_INV').asstring;       /// Unidade de medida do estoque:
      TIPO_ITEM   := tipoitem(qryRegistro0200.fieldbyname('TIPO_ITEM').asstring);      /// Tipo do item - Atividades Industriais, Comerciais e Serviços: 00 - Mercadoria para Revenda, 01 - Matéria-Prima,  02 - Embalagem, 03 - Produto em Processo, 04 - Produto Acabado, 05 - Subproduto, 06 - Produto Intermediário, 07 - Material de Uso e Consumo, 08 - Ativo Imobilizado, 09 - Serviços, 10 - Outros insumos, 99 - Outras
      COD_NCM     := SomenteNumero(qryRegistro0200.fieldbyname('COD_NCM').asstring);        /// Código da Nomenclatura Comum do Mercosul:
      EX_IPI      := qryRegistro0200.fieldbyname('EX_IPI').asstring;         /// Código EX, conforme a TIPI:
      COD_GEN     := format('%2.2d',[qryRegistro0200.fieldbyname('COD_GEN').asinteger]);        /// Código gênero item, tabela indicada item 4.2.1:
      COD_LST     := somentenumero(qryRegistro0200.fieldbyname('COD_LST').asstring);        /// Código serviço Anexo I - Lei nº116/03:
      ALIQ_ICMS   := qryRegistro0200.fieldbyname('ALIQ_ICMS').AsCurrency;      /// Alíquota ICMS aplicável (operações internas):
    end;
    qryRegistro0200.Next;

  end;

end;


