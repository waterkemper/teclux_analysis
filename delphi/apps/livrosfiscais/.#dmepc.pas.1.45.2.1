procedure TdtmEPC.AdicionarValores_M100(CST_PIS, NAT_BC_CRED: String; ALIQ_PIS, VL_BC_PIS, VL_CRED, VL_AJUS_REDUC : Currency);
begin
  if not qryRegistroM100.Locate('cod_cred;aliq_pis',VarArrayOf([CodigoTipoCredito(CST_PIS,ALIQ_PIS),ALIQ_PIS]),[]) then
  begin
    qryRegistroM100.Append;
    qryRegistroM100cod_cred.AsInteger := CodigoTipoCredito(CST_PIS,ALIQ_PIS); //Crédito vinculado à receita tributada no mercado interno – Alíquota Básica
    if (qryepcsituacao.AsInteger in [1,2,3]) then   //1 - Cisao  2 - Fuscao 3 - Incorporação
      qryRegistroM100ind_cred_ori.AsInteger := 1
    else
      qryRegistroM100ind_cred_ori.AsInteger := 0; //Operações próprias
    qryRegistroM100IND_DESC_CRED.asinteger := 0; //0 – Utilização do valor total para desconto da contribuição apurada no período, no Registro M200;

    qryRegistroM100ALIQ_PIS.ascurrency      := ALIQ_PIS;
  end
  else
    qryRegistroM100.edit;

  qryRegistroM100VL_BC_PIS.AsCurrency     := qryRegistroM100VL_BC_PIS.AsCurrency + VL_BC_PIS;
  //qryRegistroM100QUANT_BC_PIS.ascurrency;
  //qryRegistroM100ALIQ_PIS_QUANT.ascurrency;
  qryRegistroM100VL_CRED.ascurrency       := qryRegistroM100VL_CRED.ascurrency + VL_CRED;
  //qryRegistroM100VL_AJUS_ACRES.ascurrency;
  qryRegistroM100VL_AJUS_REDUC.ascurrency := qryRegistroM100VL_AJUS_REDUC.ascurrency + VL_AJUS_REDUC;
  //qryRegistroM100vL_CRED_DIF.ascurrency;
  //qryRegistroM100VL_CRED_DISP.ascurrency;
  //qryRegistroM100IND_DESC_CRED.AsInteger;
  //qryRegistroM100VL_CRED_DESC.ascurrency;
 // qryRegistroM100SLD_CRED.ascurrency;

  qryRegistroM100.post;

  if VL_BC_PIS <> 0 then
  begin
    if not qryRegistroM105.Locate('nat_bc_cred;cst_pis',VarArrayOf([nat_bc_cred,cst_pis]),[]) then
    begin
      qryRegistroM105.Append;
      qryRegistroM105nat_bc_cred.AsString := NAT_BC_CRED;
      qryRegistroM105cst_pis.AsString := CST_PIS;
    end
    else
      qryRegistroM105.edit;

    qryRegistroM105vl_bc_pis_tot.AsCurrency := qryRegistroM105vl_bc_pis_tot.AsCurrency +  VL_BC_PIS;
    qryRegistroM105.Post;

  end;

  if VL_AJUS_REDUC <> 0 then
  begin
    qryRegistroM110.AfterPost := nil;
    if not qryRegistroM110.Locate('IND_AJ;geradosistemaSN',VarArrayof([0,'S']),[]) then // 0 : AJUSTE DE REDUÇÃO
    begin
      qryRegistroM110.Append;
      qryRegistroM110ind_aj.AsInteger := 0;
      qryRegistroM110cod_aj.AsString := '05';
      qryRegistroM110descr_aj.AsString := 'DEVOLUÇÃO DE COMPRAS';
      qryRegistroM110dt_ref.AsDateTime := DataInicial;
      qryRegistroM110geradosistema.asboolean := true;
    end
    else
      qryRegistroM110.edit;

    qryRegistroM110vl_aj.AsCurrency := qryRegistroM110vl_aj.AsCurrency + VL_AJUS_REDUC;
    qryRegistroM110.Post;

    qryRegistroM110.AfterPost := qryRegistroM110AfterPost;

  end;

end;

