procedure TdtmEPC.CalcularBloco_M;
var
  vNat_BC_CRED : String;
begin
  if qryepcIND_APRO_CRED.asinteger = 2 then
  begin
    qryepc.Edit;
    qryepcREC_BRU_NCUM_TRIB_MI.Clear;
    qryepcREC_BRU_NCUM_NT_MI.Clear;
    qryepcREC_BRU_NCUM_EXP.Clear;
    qryepcREC_BRU_CUM.Clear;
  end;

  if qryepcIND_REG_CUM.AsInteger = 1 then
  begin

    qryRegistrof500.First;
    while not qryRegistrof500.eof do
      qryRegistrof500.delete;

    qryRegistroF525.First;
    while not qryRegistroF525.eof do
      qryRegistroF525.delete;

    qryRegistro1900.First;
    while not qryRegistro1900.eof do
      qryRegistro1900.delete;

    qryRegistrof500.AfterDelete := nil;
    qryRegistrof500.AfterEdit   := nil;
    qryRegistrof500.AfterInsert := nil;

    qryRegistrof525.AfterDelete := nil;
    qryRegistrof525.AfterEdit   := nil;
    qryRegistrof525.AfterInsert := nil;


    RefazConsultaPorNome(qryAlugueis_F100, ['datainicial', 'datafinal', 'filial'], [DataInicial, DataFinal, qryepcfilial.asinteger]);
    qryAlugueis_F100.First;
    while not qryAlugueis_F100.Eof do
    begin
      if qryRegistrof500.IsEmpty then
      begin
        qryRegistrof500.Append;
        qryRegistro1900.Append;
      end
      else
      begin
        qryRegistrof500.edit;
        qryRegistro1900.edit;
      end;

      qryRegistroF500vl_rec_caixa.AsCurrency := qryRegistroF500vl_rec_caixa.AsCurrency + qryAlugueis_F100vl_oper.AsCurrency;
      qryRegistroF500cst_pis.AsString := qryAlugueis_F100cst_pis.AsString;
      qryRegistroF500vl_desc_pis.clear;
      qryRegistroF500vl_bc_pis.AsCurrency := qryRegistroF500vl_bc_pis.AsCurrency + qryAlugueis_F100vl_oper.AsCurrency;
      qryRegistroF500aliq_pis.AsCurrency := qryAlugueis_F100aliq_pis.AsCurrency;
      qryRegistroF500vl_pis.AsCurrency := qryRegistroF500vl_pis.AsCurrency + qryAlugueis_F100vl_pis.AsCurrency;
      qryRegistroF500cst_cofins.AsString := qryAlugueis_F100cst_cofins.AsString;
      qryRegistroF500vl_desc_cofins.clear;
      qryRegistroF500vl_bc_cofins.AsCurrency := qryRegistroF500vl_bc_cofins.AsCurrency + qryAlugueis_F100vl_oper.AsCurrency;
      qryRegistroF500aliq_cofins.AsCurrency := qryAlugueis_F100aliq_cofins.AsCurrency;
      qryRegistroF500vl_cofins.AsCurrency := qryRegistroF500vl_cofins.AsCurrency + qryAlugueis_F100vl_cofins.AsCurrency;
      qryRegistroF500cod_mod.clear;
      qryRegistroF500cfop.clear;
      qryRegistroF500cod_cta.clear;
      qryRegistroF500inf_compl.Clear;
      qryRegistroF500filial.AsInteger := qryepcfilial.AsInteger;

      qryRegistroF500.Post;

      qryRegistro1900cnpj.AsString := somentenumero(qryFiliaiscnpj.AsString);
      qryRegistro1900cod_mod.asstring := '99'; //99 – Outros Documentos
      qryRegistro1900ser.clear;
      qryRegistro1900sub_ser.clear;
      qryRegistro1900cod_sit.AsString := '00'; // Documento regular
      qryRegistro1900vl_tot_rec.AsCurrency := qryRegistro1900vl_tot_rec.AsCurrency + qryAlugueis_F100vl_oper.AsCurrency;
      qryRegistro1900quant_doc.AsInteger := qryRegistro1900quant_doc.AsInteger + 1;
      qryRegistro1900cst_pis.clear;
      qryRegistro1900cst_cofins.clear;
      qryRegistro1900cfop.clear;
      qryRegistro1900cod_cta.clear;
      qryRegistro1900inf_compl.clear;
      qryRegistro1900.post;

      qryRegistroF525.Append;
      qryRegistroF525vl_rec.AsCurrency := qryAlugueis_F100vl_oper.AsCurrency;
      qryRegistroF525ind_rec.AsString := '04';  // documento fiscal
      qryRegistroF525cnpj_cpf.AsString :=  qryAlugueis_F100pessoanumero.AsString;
      qryRegistroF525num_doc.asstring := '1';
      qryRegistroF525cod_item.clear;
      qryRegistroF525vl_rec_det.AsCurrency := qryAlugueis_F100vl_oper.AsCurrency;
      qryRegistroF525cst_pis.AsString           := qryAlugueis_F100cst_pis.AsString;
      qryRegistroF525cst_cofins.AsString        := qryAlugueis_F100cst_cofins.AsString;
      qryRegistroF525cod_cta.clear;
      qryRegistroF525inf_compl.clear;
      qryRegistroF525filial.AsInteger := qryepcfilial.AsInteger;
      qryRegistroF525.Post;
      qryAlugueis_F100.next;
    end;


    qryRegistrof500.AfterDelete := qryRegistrof500AfterDelete;
    qryRegistrof500.AfterEdit   := qryRegistrof500AfterEdit;
    qryRegistrof500.AfterInsert := qryRegistrof500AfterInsert;

    qryRegistrof525.AfterDelete := qryRegistrof525AfterDelete;
    qryRegistrof525.AfterEdit   := qryRegistrof525AfterEdit;
    qryRegistrof525.AfterInsert := qryRegistrof525AfterInsert;


  end
  else
  begin

    qryRegistroF100.AfterDelete := nil;
    qryRegistroF100.AfterEdit   := nil;
    qryRegistroF100.AfterInsert := nil;

    qryRegistroF100.First;
    while not qryRegistroF100.Eof do
    begin
      if not qryRegistroF100documentopag.IsNull or
         not qryRegistroF100aluguel.IsNull then
        qryRegistroF100.delete
      else
        qryRegistroF100.next;
    end;

    RefazConsultaPorNome(qryDocumentosPag_F100, ['datainicial', 'datafinal', 'filial'], [DataInicial, DataFinal, qryepcfilial.asinteger]);
    qryDocumentosPag_F100.First;
    while not qryDocumentosPag_F100.Eof do
    begin
      qryRegistroF100.Append;
      qryRegistroF100filial.asinteger           := qryDocumentosPag_F100filial.AsInteger;
      qryRegistroF100dt_oper.AsDateTime         := qryDocumentosPag_F100dt_oper.AsDateTime;
      qryRegistroF100ind_oper.AsInteger         := qryDocumentosPag_F100ind_oper.AsInteger;
      qryRegistroF100cod_part.AsInteger         := qryDocumentosPag_F100cod_part.AsInteger;
      qryRegistroF100tipocod_part.AsString      := qryDocumentosPag_F100tipocod_part.AsString;
      qryRegistroF100vl_oper.AsCurrency         := qryDocumentosPag_F100vl_oper.AsCurrency;
      qryRegistroF100cst_pis.AsString           := qryDocumentosPag_F100cst_pis.AsString;
      qryRegistroF100vl_bc_pis.AsCurrency       := qryDocumentosPag_F100vl_bc_pis.AsCurrency;
