      if (qryRegistroC100.fieldbyname('COD_SIT').AsString = '00') or  // normal
         (qryRegistroC100.fieldbyname('COD_SIT').AsString = '01') or  // normal extemporanea
         (qryRegistroC100.fieldbyname('COD_SIT').AsString = '06') then // complementar
      begin
        IND_OPER := ACBrOperacao(qryRegistroC100.fieldbyname('IND_OPER').Asinteger);
