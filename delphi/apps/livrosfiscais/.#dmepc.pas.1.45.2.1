procedure TdtmEPC.CalcularTotalAjusteCreditoPisEntradas;
var
  vRegistroEncontrado : boolean;
begin

  vRegistroEncontrado := false;

 {O recalculo do bloco m100 c/ efeito no m200 se dá somente no regime nao cum e no nao cum e cum,
  qdo exclusivo no regime cum. não há credito pelas entradas}

  if (qryepcCOD_INC_TRIB.AsInteger in [1,3]) then
  begin
    if not (qryregistrom100.state in [dsedit, dsinsert]) then
      qryRegistroM100.edit;

    qryRegistroM100vl_ajus_reduc.AsCurrency := 0;

    RefazConsultaPorNome(qryAtualizarRegistroM110,['mesano','filialconsolidadora'], [qryepcperiodo.asstring,qryepcfilial.asinteger]);

    qryregistrom110.first;
    while not qryregistrom110.Eof do
    begin
      if (qryRegistroM110ind_aj.AsInteger = 0) and
         (qryRegistroM110geradosistemasn.asstring = 'S') and
         (qryRegistroM110cod_aj.AsString = '05') and
         (qryRegistroM110descr_aj.AsString = 'DESCONTOS RECEBIDOS') then
      begin
        vRegistroEncontrado := true;
         break;
      end
      else
        qryregistrom110.Next;
    end;

