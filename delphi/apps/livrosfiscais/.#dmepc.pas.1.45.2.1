procedure TdtmEPC.qryRegistroM100CalcFields(DataSet: TDataSet);
begin
  inherited;

  qryRegistroM100vl_cred.AsCurrency := roundtod(qryRegistroM100vl_bc_pis.AsCurrency * qryRegistroM100aliq_pis.AsCurrency / 100, 2);

  qryRegistroM100VL_CRED_DISP.ascurrency := qryRegistroM100VL_CRED      .AsCurrency +
                                            qryRegistroM100VL_AJUS_ACRES.AsCurrency -
                                            qryRegistroM100VL_AJUS_REDUC.AsCurrency -
                                            qryRegistroM100VL_CRED_DIF  .AsCurrency;

  if qryRegistroM100IND_DESC_CRED.asinteger = 0 then
    if qryRegistroM100VL_CRED_DESC.ascurrency <> qryRegistroM100VL_CRED_DISP.ascurrency then
      qryRegistroM100VL_CRED_DESC.ascurrency := qryRegistroM100VL_CRED_DISP.ascurrency;

  qryRegistroM100SLD_CRED.AsCurrency := qryRegistroM100VL_CRED_DISP.ascurrency -
                                        qryRegistroM100VL_CRED_DESC.ascurrency

end;

