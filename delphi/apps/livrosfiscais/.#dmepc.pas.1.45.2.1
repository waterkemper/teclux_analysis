function  TdtmEPC.ACBrSituacaoDocto(Situacao: String): TACBrCodSit;
begin
      if Situacao = '00' then result := sdfRegular
 else if Situacao = '01' then result := sdfExtRegular
 else if Situacao = '02' then result := sdfCancelado
