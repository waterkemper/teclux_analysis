      SUFRAMA := qryRegistro0140suframa.AsString;  // Inscrição do estabelecimento na Suframa
    end;

    if qryFiliaissped_pis_cofins_rb.AsBoolean or qryFiliaissped_pis_cofins_rem.AsBoolean then
      P_Registro0145;

