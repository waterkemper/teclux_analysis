    BLOCO I: LANÇAMENTOS CONTÁBEIS
    BLOCO J: DEMONSTRAÇÕES CONTÁBEIS

}
function TdtmEPC.GerarArquivo(pArquivo: String): Boolean;
var
  NRegistrosDeclaracao,
  NRegistrosTotal : integer;
  Arq: TextFile;
  vPath,
  Barra,
  formato : String;
begin

  result := false;

  {$IFDEF LINUX}
    Barra := '/';
  {$ELSE}
    Barra := '\';
  {$ENDIF}

  vPath := SpedContabilDir+Barra;

  result := true;

  Bloco_0;

  Bloco_A;
  Bloco_C;
  Bloco_D;

  Bloco_F;

  Bloco_M;
  Bloco_P;
  Bloco_1;
  Bloco_9;



  try
    with ACBrSpedPisCofins do
    begin
      DT_INI := DataInicial;
      DT_FIN := DataFinal;
      Path := vPath;
      Arquivo := pArquivo;
      SaveFileTXT;
    end;

  finally
    with ACBrSPEDPisCofins do
    begin
      Bloco_0.LimpaRegistros;
      Bloco_A.LimpaRegistros;
      Bloco_C.LimpaRegistros;
      Bloco_D.LimpaRegistros;

      Bloco_F.LimpaRegistros;
      Bloco_M.LimpaRegistros;
      Bloco_1.LimpaRegistros;
      Bloco_9.LimpaRegistros;
    end;
  end;

  qryepc.Edit;
  qryepcdata.AsDateTime := now();
  qryepc.post;

  Perpetrar([qryepc]);

end;



procedure TdtmEPC.ACBrSPEDPisCofinsError(const MsnError: String);
begin
  inherited;
  Erro := MsnError;
  if Assigned(ACBrSPEDPisCofinsonError) then
    ACBrSPEDPisCofinsonError(self);

end;


