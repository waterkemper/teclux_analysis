function TdtmEPC.ACBrSituacaoTribPIS(ind: String): TACBrSituacaoTribPIS;
begin
       if ind = '01' then result := stpisValorAliquotaNormal                            // '01' // Operação Tributável com Alíquota Básica   // valor da operação alíquota normal (cumulativo/não cumulativo)).
  else if ind = '02' then result := stpisValorAliquotaDiferenciada                      // '02' // Operação Tributável com Alíquota Diferenciada // valor da operação (alíquota diferenciada)).
  else if ind = '03' then result := stpisQtdeAliquotaUnidade                            // '03' // Operação Tributável com Alíquota por Unidade de Medida de Produto // quantidade vendida x alíquota por unidade de produto).
  else if ind = '04' then result := stpisMonofaticaAliquotaZero                         // '04' // Operação Tributável Monofásica - Revenda a Alíquota Zero
  else if ind = '05' then result := stpisValorAliquotaPorST                             // '05' // Operação Tributável por Substituição Tributária
  else if ind = '06' then result := stpisAliquotaZero                                   // '06' // Operação Tributável a Alíquota Zero
  else if ind = '07' then result := stpisIsentaContribuicao                             // '07' // Operação Isenta da Contribuição
  else if ind = '08' then result := stpisSemIncidenciaContribuicao                      // '08' // Operação sem Incidência da Contribuição
  else if ind = '09' then result := stpisSuspensaoContribuicao                          // '09' // Operação com Suspensão da Contribuição
  else if ind = '49' then result := stpisOutrasOperacoesSaida                           // '49' // Outras Operações de Saída
  else if ind = '50' then result := stpisOperCredExcRecTribMercInt                      // '50' // Operação com Direito a Crédito - Vinculada Exclusivamente a Receita Tributada no Mercado Interno
  else if ind = '51' then result := stpisOperCredExcRecNaoTribMercInt                   // '51' // Operação com Direito a Crédito – Vinculada Exclusivamente a Receita Não Tributada no Mercado Interno
  else if ind = '52' then result := stpisOperCredExcRecExportacao                       // '52' // Operação com Direito a Crédito - Vinculada Exclusivamente a Receita de Exportação
  else if ind = '53' then result := stpisOperCredRecTribNaoTribMercInt                  // '53' // Operação com Direito a Crédito - Vinculada a Receitas Tributadas e Não-Tributadas no Mercado Interno
  else if ind = '54' then result := stpisOperCredRecTribMercIntEExportacao              // '54' // Operação com Direito a Crédito - Vinculada a Receitas Tributadas no Mercado Interno e de Exportação
  else if ind = '55' then result := stpisOperCredRecNaoTribMercIntEExportacao           // '55' // Operação com Direito a Crédito - Vinculada a Receitas Não-Tributadas no Mercado Interno e de Exportação
  else if ind = '56' then result := stpisOperCredRecTribENaoTribMercIntEExportacao      // '56' // Operação com Direito a Crédito - Vinculada a Receitas Tributadas e Não-Tributadas no Mercado Interno e de Exportação
  else if ind = '60' then result := stpisCredPresAquiExcRecTribMercInt                  // '60' // Crédito Presumido - Operação de Aquisição Vinculada Exclusivamente a Receita Tributada no Mercado Interno
  else if ind = '61' then result := stpisCredPresAquiExcRecNaoTribMercInt               // '61' // Crédito Presumido - Operação de Aquisição Vinculada Exclusivamente a Receita Não-Tributada no Mercado Interno
  else if ind = '62' then result := stpisCredPresAquiExcExcRecExportacao                // '62' // Crédito Presumido - Operação de Aquisição Vinculada Exclusivamente a Receita de Exportação
  else if ind = '63' then result := stpisCredPresAquiRecTribNaoTribMercInt              // '63' // Crédito Presumido - Operação de Aquisição Vinculada a Receitas Tributadas e Não-Tributadas no Mercado Interno
  else if ind = '64' then result := stpisCredPresAquiRecTribMercIntEExportacao          // '64' // Crédito Presumido - Operação de Aquisição Vinculada a Receitas Tributadas no Mercado Interno e de Exportação
  else if ind = '65' then result := stpisCredPresAquiRecNaoTribMercIntEExportacao       // '65' // Crédito Presumido - Operação de Aquisição Vinculada a Receitas Não-Tributadas no Mercado Interno e de Exportação
  else if ind = '66' then result := stpisCredPresAquiRecTribENaoTribMercIntEExportacao  // '66' // Crédito Presumido - Operação de Aquisição Vinculada a Receitas Tributadas e Não-Tributadas no Mercado Interno e de Exportação
  else if ind = '67' then result := stpisOutrasOperacoes_CredPresumido                  // '67' // Crédito Presumido - Outras Operações
  else if ind = '70' then result := stpisOperAquiSemDirCredito                          // '70' // Operação de Aquisição sem Direito a Crédito
  else if ind = '71' then result := stpisOperAquiComIsensao                             // '71' // Operação de Aquisição com Isenção
  else if ind = '72' then result := stpisOperAquiComSuspensao                           // '72' // Operação de Aquisição com Suspensão
  else if ind = '73' then result := stpisOperAquiAliquotaZero                           // '73' // Operação de Aquisição a Alíquota Zero
  else if ind = '74' then result := stpisOperAqui_SemIncidenciaContribuicao             // '74' // Operação de Aquisição sem Incidência da Contribuição
  else if ind = '75' then result := stpisOperAquiPorST                                  // '75' // Operação de Aquisição por Substituição Tributária
  else if ind = '98' then result := stpisOutrasOperacoesEntrada                         // '98' // Outras Operações de Entrada
  else if ind = '99' then result := stpisOutrasOperacoes;                               // '99' // Outras Operações
end;

function TdtmEPC.ACBrBaseCalculoCredito(ind: String) : TACBrBaseCalculoCredito;
begin
  if      ind = '01' then result := bccAqBensRevenda                 // '01' // Aquisição de bens para revenda
  else if ind = '02' then result := bccAqBensUtiComoInsumo           // '02' // Aquisição de bens utilizados como insumo
  else if ind = '03' then result := bccAqServUtiComoInsumo           // '03' // Aquisição de serviços utilizados como insumo
  else if ind = '04' then result := bccEnergiaEletricaTermica        // '04' // Energia elétrica e térmica, inclusive sob a forma de vapor
  else if ind = '05' then result := bccAluguelPredios                // '05' // Aluguéis de prédios
  else if ind = '06' then result := bccAluguelMaqEquipamentos        // '06' // Aluguéis de máquinas e equipamentos
  else if ind = '07' then result := bccArmazenagemMercadoria         // '07' // Armazenagem de mercadoria e frete na operação de venda
  else if ind = '08' then result := bccConArrendamentoMercantil      // '08' // Contraprestações de arrendamento mercantil
  else if ind = '09' then result := bccMaqCredDepreciacao            // '09' // Máquinas, equipamentos e outros bens incorporados ao ativo imobilizado (crédito sobre encargos de depreciação).
  else if ind = '10' then result := bccMaqCredAquisicao              // '10' // Máquinas, equipamentos e outros bens incorporados ao ativo imobilizado (crédito com base no valor de aquisição).
  else if ind = '11' then result := bccAmortizacaoDepreciacaoImoveis // '11' // Amortização e Depreciação de edificações e benfeitorias em imóveis
  else if ind = '12' then result := bccDevolucaoSujeita              // '12' // Devolução de Vendas Sujeitas à Incidência Não-Cumulativa
  else if ind = '13' then result := bccOutrasOpeComDirCredito        // '13' // Outras Operações com Direito a Crédito
  else if ind = '14' then result := bccAtTransporteSubcontratacao    // '14' // Atividade de Transporte de Cargas – Subcontratação
  else if ind = '15' then result := bccAtImobCustoIncorrido          // '15' // Atividade Imobiliária – Custo Incorrido de Unidade Imobiliária
  else if ind = '16' then result := bccAtImobCustoOrcado             // '16' // Atividade Imobiliária – Custo Orçado de unidade não concluída
  else if ind = '17' then result := bccAtPresServ                    // '17' // Atividade de Prestação de Serviços de Limpeza, Conservação e Manutenção – vale-transporte, vale-refeição ou vale-alimentação, fardamento ou uniforme.
  else if ind = '18' then result := bccEstoqueAberturaBens;           // '18' // Estoque de abertura de bens
end;


