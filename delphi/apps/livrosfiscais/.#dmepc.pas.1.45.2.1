procedure TdtmEPC.dsrepcDataChange(Sender: TObject; Field: TField);
begin
  inherited;
  if (field = qryepcfilial) then
    RefazConsultaPorNome(qryFiliais,['codigo'],[qryepcfilial.asinteger]);

  if (field = qryepcperiodo) or
     (field = qryepcfilial) then
  begin
    if (qryepc.State = dsinsert) and
       ((qryepcperiodo.AsString <> '') and
        (qryepcfilial.AsInteger <> 0)) then
    begin
      DataInicial := strtodate('01/'+qryepcperiodo.asstring);
      DataFinal := strtodate(inttostr(DaysInMonth(strtodate('01/'+qryepcperiodo.asstring)))+'/'+qryepcperiodo.asstring);
    end;
  end;

  if ((field = qryepctipo) or
      (field = qryepcperiodo)) and
      (qryepcperiodo.AsString <> '') then
    qryepcnomearquivo.AsString := 'epc_'+
      qryepcfilial.AsString+'_'+
      FormatDateTime('yyyy-mm',strtodate('01/'+qryepcperiodo.AsString)) + '_'+
      qryepctipo.AsString+'.TXT';

end;


