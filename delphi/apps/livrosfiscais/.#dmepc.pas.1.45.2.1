  if strtoint(CST_COFINS) in [04, 05, 06, 07, 08, 09] then
  begin
    if not qryRegistroM800.Locate('cst_cofins', CST_COFINS, []) then
    begin
      qryRegistroM800.Append;
      qryRegistroM800cst_cofins.AsString   := CST_COFINS;
      qryRegistroM800.post;

      qryRegistroM810.Append;
      qryRegistroM810nat_rec.AsString := '999'; //  Outras receitas com isenção
      qryRegistroM810.post
    end;

    qryRegistroM800.edit;
    qryRegistroM800vl_tot_rec.AsCurrency := qryRegistroM800vl_tot_rec.AsCurrency + VL_ITEM;
    qryRegistroM800.post;

    qryRegistroM810.edit;
    qryRegistroM810vl_rec.AsCurrency := qryRegistroM810vl_rec.AsCurrency + VL_ITEM;
    qryRegistroM810.post;

  end;





end;

