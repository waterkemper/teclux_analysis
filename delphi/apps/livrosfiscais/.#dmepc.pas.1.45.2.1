begin
  inherited;
  qryRegistroM100periodo.AsString := qryepcperiodo.AsString;
  qryRegistroM100filialepc.AsInteger := qryepcfilial.AsInteger;
  qryRegistroM100numero.AsInteger := piscofins_M100_proximocodigo;

  qryRegistroM100ind_cred_ori.AsInteger := 0;
  qryRegistroM100IND_DESC_CRED.AsInteger := 0;
