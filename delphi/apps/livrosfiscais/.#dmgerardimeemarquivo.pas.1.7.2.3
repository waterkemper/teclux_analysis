function TdtmGerarDIMEEmArquivo.getq_46_999_totalregimeespecial: currency;
var
 q_46_999_atual : Currency;
begin
  q_46_999_atual := 0;
  fq_46_999_totalregimeespecial_1  := 0;
  fq_46_999_totalregimeespecial_2  := 0;
  fq_46_999_totalregimeespecial_3  := 0;
  fq_46_999_totalregimeespecial_4  := 0;
  fq_46_999_totalregimeespecial_11 := 0;
  fq_46_999_totalregimeespecial_12 := 0;
  fq_46_999_totalregimeespecial_13 := 0;
  fq_46_999_totalregimeespecial_90 := 0;

  qryq46_RegimeEspecial.First;
  while not qryq46_regimeespecial.Eof do
  begin
    q_46_999_atual := q_46_999_atual + qryq46_RegimeEspecialvalor.AsCurrency;
    case qryq46_RegimeEspecialorigem.AsInteger of
      1 : fq_46_999_totalregimeespecial_1 := fq_46_999_totalregimeespecial_1 + qryq46_RegimeEspecialvalor.AsCurrency;
      2 : fq_46_999_totalregimeespecial_2 := fq_46_999_totalregimeespecial_2 + qryq46_RegimeEspecialvalor.AsCurrency;
      3 : fq_46_999_totalregimeespecial_3 := fq_46_999_totalregimeespecial_3 + qryq46_RegimeEspecialvalor.AsCurrency;
      4 : fq_46_999_totalregimeespecial_4 := fq_46_999_totalregimeespecial_4 + qryq46_RegimeEspecialvalor.AsCurrency;
      11: fq_46_999_totalregimeespecial_11:= fq_46_999_totalregimeespecial_11+ qryq46_RegimeEspecialvalor.AsCurrency;
      12: fq_46_999_totalregimeespecial_12:= fq_46_999_totalregimeespecial_12+ qryq46_RegimeEspecialvalor.AsCurrency;
      13: fq_46_999_totalregimeespecial_13:= fq_46_999_totalregimeespecial_13+ qryq46_RegimeEspecialvalor.AsCurrency;
      90: fq_46_999_totalregimeespecial_90:= fq_46_999_totalregimeespecial_90+ qryq46_RegimeEspecialvalor.AsCurrency;
    end;
    qryq46_regimeespecial.Next;
  end;

  if (q_46_999_atual <> fq_46_999_totalregimeespecial) then
  begin
    fq_46_999_totalregimeespecial := q_46_999_atual;
    AtualizaQuadrosDime;
  end;

  result := fq_46_999_totalregimeespecial;
end;


procedure TdtmGerarDIMEEmArquivo.AtualizaQuadrosDime;
begin
  case qryQuadrosDIMEq00_070_apuracaoconsolidada.AsInteger of
  2: begin // consolidado
      qryQuadrosDIMEq04_010_debitopelassaidas.AsCurrency := q_02_valor;
      qryQuadrosDIMEq05_020_creditopelasentradas.AsCurrency := q_01_valor - q_09_060_e_transf_cred - q_09_020_e_transf_deb;
     end;
  3: begin // consolidado
      qryQuadrosDIMEq04_010_debitopelassaidas.AsCurrency := q_02_valor - q_09_130_s_transf_deb - q_09_150_s_transf_cred;
      qryQuadrosDIMEq05_020_creditopelasentradas.AsCurrency := q_01_valor - q_09_060_e_transf_cred - q_09_020_e_transf_deb;
     end;
  1: begin //não é apuração consolidada
      qryQuadrosDIMEq04_010_debitopelassaidas.AsCurrency := q_02_valor;
      qryQuadrosDIMEq05_020_creditopelasentradas.AsCurrency := q_01_valor;
     end;
  end;


  qryQuadrosDIMEq43_010_credtransfcredacum.AsCurrency := q_46_999_totalregimeespecial_1;
  qryQuadrosDIMEq44_140_aplicfuncultural.AsCurrency := q_46_999_totalregimeespecial_2;
  qryQuadrosDIMEq44_150_aplicfunturismo.AsCurrency := q_46_999_totalregimeespecial_3;
  qryQuadrosDIMEq44_160_aplicfundesporte.AsCurrency := q_46_999_totalregimeespecial_4;
  qryQuadrosDIMEq41_220_esdebtrcredrelexportacoes.AsCurrency := q_46_999_totalregimeespecial_11;
  qryQuadrosDIMEq41_230_estdebtrcredrelsaidasisentas.AsCurrency := q_46_999_totalregimeespecial_12;
  qryQuadrosDIMEq41_240_estdebportransfcredrelsaidif.AsCurrency := q_46_999_totalregimeespecial_13;
  qryQuadrosDIMEq05_140_credregimeespecial.AsCurrency := q_46_999_totalregimeespecial_90;

  // estimativa social
  qryQuadrosDIMEq08_010_Debapnomes.AsCurrency := q_02_valor;
  qryQuadrosDIMEq08_030_credapnomes.AsCurrency := q_01_valor;

  // consolidador
  if (qryQuadrosDIMEq00_070_apuracaoconsolidada.AsInteger=2) then
  begin
    qryQuadrosDIMEq09_020_saldodevrecestabcons.AsCurrency := q_09_020_e_transf_deb;
    qryQuadrosDIMEq09_060_SaldoCredRecEstaCons.AsCurrency := q_09_060_e_transf_cred;
  end;

  qryQuadrosDIMECalcFields(qryQuadrosDIME);

end;

procedure TdtmGerarDIMEEmArquivo.LerTotaisq_01;
begin
  fq_01_valor := 0;
  fq_09_020_e_transf_deb := 0;
  fq_09_060_e_transf_cred  := 0;
  fq_01_isentas := 0;
  fq_01_outras := 0;
  fq_01_icmsbasecalculost := 0;
  fq_01_icmsvalorst := 0;
  fq_01_vcredicmssn := 0;

  fq_01_valornota := 0;
  fq_01_base := 0;
  qryq01_NotasEntradasCalculos.First;
  while not qryq01_NotasEntradasCalculos.Eof do
  begin
    if qryq01_NotasEntradasCalculoscodigofiscal.AsString = '1605' then
      fq_09_020_e_transf_deb := fq_09_020_e_transf_deb + qryq01_NotasEntradasCalculosvalor.AsCurrency;
    if qryq01_NotasEntradasCalculoscodigofiscal.AsString = '1602' then
      fq_09_060_e_transf_cred := fq_09_060_e_transf_cred + qryq01_NotasEntradasCalculosvalor.AsCurrency;
    fq_01_valor := fq_01_valor + qryq01_NotasEntradasCalculosvalor.AsCurrency;
    fq_01_isentas := fq_01_isentas + qryq01_NotasEntradasCalculosisentas.AsCurrency;
    fq_01_outras := fq_01_outras + qryq01_NotasEntradasCalculosoutras.AsCurrency;
    fq_01_valornota := fq_01_valornota + qryq01_NotasEntradasCalculosvalornota.AsCurrency;
    fq_01_base := fq_01_base + qryq01_NotasEntradasCalculosbase.AsCurrency;
    fq_01_icmsbasecalculost := fq_01_icmsbasecalculost + qryq01_NotasEntradasCalculosicmsbasecalculost.AsCurrency;
    fq_01_icmsvalorst := fq_01_icmsvalorst + qryq01_NotasEntradasCalculosicmsvalorst.AsCurrency;
    fq_01_vcredicmssn := fq_01_vcredicmssn + qryq01_NotasEntradasCalculosvcredicmssn.AsCurrency;

    qryq01_NotasEntradasCalculos.Next;
  end;
  AtualizaQuadrosDime;
end;

procedure TdtmGerarDIMEEmArquivo.LerTotaisq_02;
begin
  fq_02_valor := 0;
  fq_02_isentas := 0;
  fq_02_outras := 0;
  fq_02_icmsbasecalculost := 0;
  fq_02_icmsvalorst := 0;

  fq_02_valornota := 0;
  fq_02_base := 0;
  fq_09_130_s_transf_deb := 0;
  fq_09_150_s_transf_cred := 0;

  qryq02_NotasSaidasCalculos.First;
  while not qryq02_NotasSaidasCalculos.Eof do
  begin
    fq_02_valor := fq_02_valor + qryq02_NotasSaidasCalculosvalor.AsCurrency;
    fq_02_isentas := fq_02_isentas + qryq02_NotasSaidasCalculosisentas.AsCurrency;
    fq_02_outras := fq_02_outras + qryq02_NotasSaidasCalculosoutras.AsCurrency;
    fq_02_icmsbasecalculost := fq_02_icmsbasecalculost + qryq02_NotasSaidasCalculosicmsbasecalculost.AsCurrency;
    fq_02_icmsvalorst := fq_02_icmsvalorst + qryq02_NotasSaidasCalculosicmsvalorst.AsCurrency;

    fq_02_valornota := fq_02_valornota + qryq02_NotasSaidasCalculosvalornota.AsCurrency;
    fq_02_base := fq_02_base + qryq02_NotasSaidasCalculosbase.AsCurrency;
    if qryq02_NotasSaidasCalculoscodigofiscal.AsInteger=5605 then
      fq_09_130_s_transf_deb := fq_09_130_s_transf_deb + qryq02_NotasSaidasCalculosvalor.AsCurrency
    else
    if qryq02_NotasSaidasCalculoscodigofiscal.asinteger=5602 then
      fq_09_150_s_transf_cred := fq_09_150_s_transf_cred + qryq02_NotasSaidasCalculosvalor.AsCurrency;
    qryq02_NotasSaidasCalculos.Next;
  end;
  AtualizaQuadrosDime;
end;

