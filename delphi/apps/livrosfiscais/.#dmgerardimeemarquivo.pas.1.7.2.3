function TdtmGerarDIMEEmArquivo.GetListaFiliais: TStrings;
begin
  FListaFiliais:= TStringList.Create;
  qryFiliais.Open;
  while not qryFiliais.Eof do
  begin
    FListaFiliais.AddObject(format('%3s',[qryFiliaiscodigo.AsString])+'.'+qryFiliaisnome.AsString, Pointer(qryFiliaiscodigo.AsInteger));
    qryFiliais.Next;
  end;
  qryFiliais.Close;
  Result := FListaFiliais;
end;

function TdtmGerarDIMEEmArquivo.GetListaGruposFiliais: TStrings;
begin
  FListaGruposFiliais:= TStringList.Create;
  qryGrupoFiliais.Open;
  while not qryGrupoFiliais.Eof do
  begin
    FListaGruposFiliais.AddObject(format('%2s',[qryGrupoFiliaiscodigo.asstring])+'.'+qryGrupoFiliaisdescricao.AsString, Pointer(qryGrupoFiliaiscodigo.AsInteger));
    qryGrupoFiliais.Next;
  end;
  qryGrupoFiliais.Close;
  Result := FListaGruposFiliais;
end;

procedure TdtmGerarDIMEEmArquivo.MontarFiltroFiliais(Usar: TCheckListBox);
var
  STRFiliais: String;
  TodasFiliais: Boolean;
  cnt: Integer;
begin
  TodasFiliais := True;
  STRFiliais := '';
  for cnt := 0 to FListaFiliais.Count - 1 do
    if Usar.Checked[cnt] then
      STRFiliais := STRFiliais + '''' + IntToStr(Integer(FListaFiliais.Objects[cnt])) + ''','
    else
      TodasFiliais := False;

  STRFiliais := Copy(STRFiliais, 0, Length(STrFiliais) - 1);
  Filiais := STRFiliais;
  if Trim(STRFiliais) <> '' then
    if TodasFiliais then
      Filiais := '';
end;

procedure TdtmGerarDIMEEmArquivo.MontarFiltroGrupoFiliais(
  Usar: TCheckListBox);
var
  STRGruposFiliais: String;
  TodosGrupos: Boolean;
  cnt: Integer;
begin
  STRGruposFiliais := '';
  TodosGrupos := True;
  for cnt := 0 to FListaGruposFiliais.Count - 1 do
    if Usar.Checked[cnt] then
      STRGruposFiliais := STRGruposFiliais + '''' + IntToStr(Integer(FListaGruposFiliais.Objects[cnt])) + ''','
    else
      TodosGrupos := False;

  STRGruposFiliais := Copy(STRGruposFiliais, 0, Length(STrGruposFiliais) - 1);
  GrupoFiliais:=STRGruposFiliais;
  if Trim(STRGruposFiliais) <> '' then
   if TodosGrupos then
    GrupoFiliais:='';
end;


procedure TdtmGerarDIMEEmArquivo.SetFiliais(const Value: String);
begin
  if (Value <> '') then
   qryQuadrosDIME.MacroByName('ListadeFiliais').asstring := Format(FiltroFilial,[Value])
  else
   qryQuadrosDIME.MacroByName('ListadeFiliais').asstring := ''
end;

procedure TdtmGerarDIMEEmArquivo.SetGrupoFiliais(const Value: String);
begin
  if (Value <> '') then
   qryQuadrosDIME.MacroByName('ListadeFiliais').asstring := Format(FiltroGrupoFilial,[Value]);
end;

procedure TdtmGerarDIMEEmArquivo.SetMesFinal(const Value: String);
begin
  if not MesAnoEmBranco(Value) then
  begin
    FMesFinal := Value;
    if DataEmBranco(FMesInicial) then
      FMesInicial:=FMesFinal;
  end
  else
   FMesFinal := FMesInicial;
end;

procedure TdtmGerarDIMEEmArquivo.SetMesInicial(const Value: String);
begin
  if not MesAnoEmBranco(Value) then
    FMesInicial := Value;
end;

