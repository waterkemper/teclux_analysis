function TdtmGerarDIMEEmArquivo.GerarArquivo(NomeArquivo: String): Boolean;
var
  PosBarra,
  Sequencia,
  NRegistrosDeclaracao,
  NRegistrosTotal : integer;
  Arq: TextFile;
  formato : String;

  procedure GravarLinha_String(str : String);
  begin
  {$IFDEF LINUX}
   Writeln(Arq, str+#13);
  {$ELSE }
   Writeln(Arq, str);
  {$ENDIF}
   NRegistrosDeclaracao := NRegistrosDeclaracao + 1;
   NRegistrosTotal := NRegistrosTotal + 1;
  end;

  procedure GravarLinha_valor(identificacao: String;
               valor:Currency;
               NaoVerificarValor: Boolean;
               tamanhovalor: integer);
  var
   i: integer;
  begin
   if (Length(formato)<>tamanhovalor) then
     formato := '';

   if (formato = '') then
     for i:=1 to tamanhovalor do
       formato := formato + '0';
   if (valor<>0) or NaoVerificarValor then
   begin
    {$IFDEF LINUX}
     Writeln(Arq, identificacao+formatfloat(formato,round((valor*100)))+#13);
    {$ELSE }
     Writeln(Arq, identificacao+formatfloat(formato,round((valor*100))));
    {$ENDIF }
     NRegistrosDeclaracao := NRegistrosDeclaracao +1;
     NRegistrosTotal := NRegistrosTotal + 1;
   end;
  end;

begin
 result := true;

    {$IFDEF LINUX}
      PosBarra := Pos('/', NomeArquivo);
    {$ELSE }
      PosBarra := Pos('\', NomeArquivo);
    {$ENDIF }
      if PosBarra = 0 then
        NomeArquivo := ExtractFilePath(Application.ExeName) + NomeArquivo;
      try
        AssignFile(Arq, NomeArquivo);
    //    if FileExists(NomeArquivo) then
          Rewrite(Arq);

    // Registro tipo 20 - Dados do Contabilista / Responsável

    GravarLinha_String('20'+'  '+format('%11.11d',[strtoint64(SomenteNumero(ParSistema.CPFContador))])+format('%-50s', [parsistema.nomeContador]) +FormatDateTime('YYYYMMDDHHMMSS',now()));

//    qryQuadrosDIME.First;
    while not qryQuadrosDIME.Eof do
    begin
      NRegistrosDeclaracao := 0;
      //Registro tipo 21 - Dados iniciais
      GravarLinha_String(
             '21' +
             '00' +
             format('%9.9d',[strtoint(SomenteNumero(qryQuadrosDIMEinscricaoestadual.AsString))])+
             format('%-50s',[qryQuadrosDIMErazao.AsString]) +
             copy(qryQuadrosDIMEperiodo.AsString,1,2)+copy(qryQuadrosDIMEperiodo.AsString,4,4) +
             qryQuadrosDIMEq00_040_tipodedeclaracao.asstring +
             qryQuadrosDIMEq00_050_regimedeapuracao.asstring +
             {
             qryQuadrosDIMEq00_060_portedaempresa.asstring +}
             '1'+
             qryQuadrosDIMEq00_070_apuracaoconsolidada.asstring +
             qryQuadrosDIMEq00_080_apuracaocentralizada.asstring +
             qryQuadrosDIMEq00_090_transfcreditosnoperiodo.asstring +
{             qryQuadrosDIMEq00_100_temcreditospresumidos.asstring +} '1' +
{             qryQuadrosDIMEq00_110_temcreditosporincentfiscais.asstring +} '1' +
             qryQuadrosDIMEq00_120_movimentos.asstring +
             qryQuadrosDIMEq00_130_substitutotributario.asstring +
             qryQuadrosDIMEq00_140_temescritacontabil.asstring +
             format('%5.5d', [qryQuadrosDIMEq00_150_qttrabalhadoresnaativ.Asinteger])
             );

      //Registro tipo 22 - Valores Fiscais Entradas
      qryq01_NotasEntradasCalculos.First;
      while not qryq01_NotasEntradasCalculos.Eof do
      begin
        GravarLinha_String(
               '22' +
               '01' +
               format('%5.5d', [qryq01_NotasEntradasCalculoscodigofiscal.Asinteger])+
               formatfloat('00000000000000000',round((qryq01_NotasEntradasCalculosvalornota.Ascurrency*100)))+
               formatfloat('00000000000000000',round((qryq01_NotasEntradasCalculosbase.Ascurrency*100)))+
               formatfloat('00000000000000000',round((qryq01_NotasEntradasCalculosvalor.Ascurrency*100)))+
               formatfloat('00000000000000000',round((qryq01_NotasEntradasCalculosisentas.Ascurrency*100)))+
               formatfloat('00000000000000000',round((qryq01_NotasEntradasCalculosoutras.Ascurrency*100)))+
               formatfloat('00000000000000000',round((qryq01_NotasEntradasCalculosicmsbasecalculost.Ascurrency*100)))+
               formatfloat('00000000000000000',round((qryq01_NotasEntradasCalculosicmsvalorst.Ascurrency*100)))+
               formatfloat('00000000000000000',round((qryq01_NotasEntradasCalculosvcredicmssn.Ascurrency*100)))

             );
        qryq01_NotasEntradasCalculos.next;
      end;

      //Registro tipo 23 - Valores Fiscais Saídas
      qryq02_NotasSaidasCalculos.First;
      while not qryq02_NotasSaidasCalculos.Eof do
      begin
        GravarLinha_String(
               '23' +
               '02' +
               format('%5.5d', [qryq02_NotasSaidasCalculoscodigofiscal.Asinteger])+
               formatfloat('00000000000000000',round((qryq02_NotasSaidasCalculosvalornota.Ascurrency*100)))+
               formatfloat('00000000000000000',round((qryq02_NotasSaidasCalculosbase.Ascurrency*100)))+
               formatfloat('00000000000000000',round((qryq02_NotasSaidasCalculosvalor.Ascurrency*100)))+
               formatfloat('00000000000000000',round((qryq02_NotasSaidasCalculosisentas.Ascurrency*100)))+
               formatfloat('00000000000000000',round((qryq02_NotasSaidasCalculosoutras.Ascurrency*100)))+

               formatfloat('00000000000000000',round((qryq02_NotasSaidasCalculosicmsbasecalculost.Ascurrency*100)))+
               formatfloat('00000000000000000',round((qryq02_NotasSaidasCalculosicmsvalorst.Ascurrency*100)))+
               '00000000000000000'


              );
        qryq02_NotasSaidasCalculos.next;
      end;

      //Registro tipo 24 - Resumo dos Valores Fiscais
      GravarLinha_valor('24'+'03'+'010',q_01_valornota, false, 17);
      GravarLinha_valor('24'+'03'+'020',q_01_base, false, 17);
      GravarLinha_valor('24'+'03'+'030',q_01_valor, false, 17);
      GravarLinha_valor('24'+'03'+'040',q_01_isentas, false, 17);
      GravarLinha_valor('24'+'03'+'050',q_01_outras, false, 17);
      GravarLinha_valor('24'+'03'+'053',q_01_icmsbasecalculost, false, 17);
      GravarLinha_valor('24'+'03'+'054',q_01_icmsvalorst, false, 17);
      GravarLinha_valor('24'+'03'+'057',q_01_vcredicmssn, false, 17);

      GravarLinha_valor('24'+'03'+'060',q_02_valornota, false, 17);
      GravarLinha_valor('24'+'03'+'070',q_02_base, false, 17);
      GravarLinha_valor('24'+'03'+'080',q_02_valor, false, 17);
      GravarLinha_valor('24'+'03'+'090',q_02_isentas, false, 17);
      GravarLinha_valor('24'+'03'+'100',q_02_outras, false, 17);

      GravarLinha_valor('24'+'03'+'103',q_02_icmsbasecalculost, false, 17);
      GravarLinha_valor('24'+'03'+'104',q_02_icmsvalorst, false, 17);
      GravarLinha_String('24'+'03'+'199'+'00000000000000000');


      case qryQuadrosDIMEq00_050_regimedeapuracao.AsInteger of
      2,  // Regime Normal
      9 : begin  // Regime Prod. Primario
            //Registro tipo 25 - Resumo da Apuração dos Débitos
            GravarLinha_valor('25'+'04'+'010',qryQuadrosDIMEq04_010_debitopelassaidas.AsCurrency, false, 17);
            GravarLinha_valor('25'+'04'+'020',qryQuadrosDIMEq04_020_debdifaliqativperm.AsCurrency, false, 17);
            GravarLinha_valor('25'+'04'+'030',qryQuadrosDIMEq04_030_debdifaliqmatusoons.AsCurrency, false, 17);
