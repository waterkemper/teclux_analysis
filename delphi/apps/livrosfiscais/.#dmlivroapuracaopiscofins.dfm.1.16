  object qryLivroApuracaoPISCofins_Creditos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      
        'select filialemissao, fornecedor, tipofornecedor, data, especie,' +
        ' serie, numero, modelodocto, valortotal, codigofiscal,'
      ''
      '       piscst,'
      '       sum(pisbasecalculo) as pisbasecalculo,'
      '       sum(pisvalor) as pisvalor,'
      '       pisaliquota,'
      ''
      #9'   cofinscst,'
      '       sum(cofinsbasecalculo) as cofinsbasecalculo,'
      '       sum(cofinsvalor) as cofinsvalor,'
      #9'   cofinsaliquota,'
      ''
      #9'   ctc436, descricaot437,'
      #9'   cbcc437, descricaot436'
      ''
      'from'
      '('
      'select piscofins.*,'
      ''
      ''
      
        '       case when especie in ('#39'DESCONTOS RECEBIDOS'#39', '#39'AJ. ACRESC.' +
        ' COFINS LANCTO MAN'#39', '#39'AJ. ACRESC. PIS LANCTO MANUAL'#39','
      
        '                             '#39'AJ. REDU'#199#195'O COFINS LANCTO MAN'#39', '#39'A' +
        'J. REDU'#199#195'O PIS LANCTO MANUAL'#39', '#39'AJ. REDU'#199#195'O NF DEV COMPRAS'#39') the' +
        'n'
      '         cast('#39'Ajustes'#39' as varchar(200))'
      
        '       else coalesce(piscofins_t437.descricao, cast('#39'SEM OCORR'#202'N' +
        'CIA DE CR'#201'DITO'#39' as varchar(200))) end as descricaot437,'
      ''
      
        '       case when especie in ('#39'DESCONTOS RECEBIDOS'#39', '#39'AJ. ACRESC.' +
        ' COFINS LANCTO MAN'#39', '#39'AJ. ACRESC. PIS LANCTO MANUAL'#39','
      
        '                             '#39'AJ. REDU'#199#195'O COFINS LANCTO MAN'#39', '#39'A' +
        'J. REDU'#199#195'O PIS LANCTO MANUAL'#39', '#39'AJ. REDU'#199#195'O NF DEV COMPRAS'#39') the' +
        'n'
      '         cast('#39'Ajustes de Redu'#231#227'o/Acr'#233'scimos'#39' as varchar(200))'
      
        '       else coalesce(piscofins_t436.descricao, cast('#39'SEM OCORR'#202'N' +
        'CIA DE CR'#201'DITO'#39' as varchar(200))) end as descricaot436'
      'from'
      '('
      'select piscofins.*,'
      ''
      #9'  case when piscst = '#39'50'#39' and'
      '              cofinscst = '#39'50'#39' and'
      
        '              especie not in ('#39'DESCONTOS RECEBIDOS'#39', '#39'AJ. ACRESC' +
        '. COFINS LANCTO MAN'#39', '#39'AJ. ACRESC. PIS LANCTO MANUAL'#39','
      
        '                                        '#39'AJ. REDU'#199#195'O COFINS LANC' +
        'TO MAN'#39', '#39'AJ. REDU'#199#195'O PIS LANCTO MANUAL'#39', '#39'AJ. REDU'#199#195'O NF DEV CO' +
        'MPRAS'#39') and'
      '         (cbcc437 is not null and cbcc437<>'#39'99'#39') then'
      ''
      
        #9#9#9#9' case when (pisaliquota = 0.65) or (cofinsaliquota = 3) or  ' +
        '/* No Regime Cumulativo - PIS 0,65 e COFINS 3,00 */'
      
        #9#9#9#9#9#9'   (pisaliquota = 1.65) or (cofinsaliquota = 7.6) then  /*' +
        ' No Regime N'#195'O Cumulativo - PIS 1,65 e COFINS 7,6 */'
      
        #9#9#9#9'   101  /* 101 Cr'#233'dito vinculado '#224' receita tributada no merc' +
        'ado interno '#8211' Al'#237'quota B'#225'sica */'
      #9#9#9#9' else'
      
        #9#9#9#9'   102  /* 102 Cr'#233'dito vinculado '#224' receita tributada no merc' +
        'ado interno '#8211' Al'#237'quotas Diferenciadas */'
      ''
      
        #9#9#9#9' /*   103 Cr'#233'dito vinculado '#224' receita tributada no mercado i' +
        'nterno '#8211' Al'#237'quota por Unidade de Produto'
      
        #9#9#9#9#9'  104 Cr'#233'dito vinculado '#224' receita tributada no mercado inte' +
        'rno '#8211' Estoque de Abertura'
      
        #9#9#9#9#9'  105 Cr'#233'dito vinculado '#224' receita tributada no mercado inte' +
        'rno '#8211' Aquisi'#231#227'o Embalagens para revenda'
      
        #9#9#9#9#9'  106 Cr'#233'dito vinculado '#224' receita tributada no mercado inte' +
        'rno '#8211' Presumido da Agroind'#250'stria'
      
        #9#9#9#9#9'  108 Cr'#233'dito vinculado '#224' receita tributada no mercado inte' +
        'rno '#8211' Importa'#231#227'o'
      
        #9#9#9#9#9'  109 Cr'#233'dito vinculado '#224' receita tributada no mercado inte' +
        'rno '#8211' Atividade Imobili'#225'ria'
      
        #9#9#9#9#9'  199 Cr'#233'dito vinculado '#224' receita tributada no mercado inte' +
        'rno '#8211' Outros'
      #9#9#9#9' */'
      #9#9#9#9'  end'
      ''
      #9#9'  when piscst = '#39'51'#39' and'
      '           cofinscst = '#39'51'#39' and'
      
        '           especie not in ('#39'DESCONTOS RECEBIDOS'#39', '#39'AJ. ACRESC. C' +
        'OFINS LANCTO MAN'#39', '#39'AJ. ACRESC. PIS LANCTO MANUAL'#39','
      
        '                                        '#39'AJ. REDU'#199#195'O COFINS LANC' +
        'TO MAN'#39', '#39'AJ. REDU'#199#195'O PIS LANCTO MANUAL'#39', '#39'AJ. REDU'#199#195'O NF DEV CO' +
        'MPRAS'#39') and'
      '           (cbcc437 is not null and cbcc437<>'#39'99'#39') then'
      ''
      
        #9#9#9#9'  case when (pisaliquota = 0.65) or (cofinsaliquota = 3) or ' +
        ' /* No Regime Cumulativo - PIS 0,65 e COFINS 3,00 */'
      
        #9#9#9#9#9#9'   (pisaliquota = 1.65) or (cofinsaliquota = 7.6) then  /*' +
        ' No Regime N'#195'O Cumulativo - PIS 1,65 e COFINS 7,6 */'
      
        #9#9#9#9#9'201  /* 201 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no me' +
        'rcado interno '#8211' Al'#237'quota B'#225'sica */'
      #9#9#9#9'  else'
      
        #9#9#9#9#9'202  /* 202 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no me' +
        'rcado interno '#8211' Al'#237'quotas Diferenciadas */'
      ''
      
        #9#9#9#9' /*   203 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no merca' +
        'do interno '#8211' Al'#237'quota por Unidade de Produto'
      
        #9#9#9#9#9'  204 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no mercado ' +
        'interno '#8211' Estoque de Abertura'
      
        #9#9#9#9#9'  205 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no mercado ' +
        'interno '#8211' Aquisi'#231#227'o Embalagens para revenda'
      
        #9#9#9#9#9'  206 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no mercado ' +
        'interno '#8211' Presumido da Agroind'#250'stria'
      
        #9#9#9#9#9'  208 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no mercado ' +
        'interno '#8211' Importa'#231#227'o'
      
        #9#9#9#9#9'  299 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no mercado ' +
        'interno '#8211' Outros  */'
      #9#9#9#9'  end'
      ''
      ''
      #9#9'  when piscst = '#39'52'#39' and'
      '           cofinscst = '#39'52'#39' and'
      
        '           especie not in ('#39'DESCONTOS RECEBIDOS'#39', '#39'AJ. ACRESC. C' +
        'OFINS LANCTO MAN'#39', '#39'AJ. ACRESC. PIS LANCTO MANUAL'#39','
      
        '                                        '#39'AJ. REDU'#199#195'O COFINS LANC' +
        'TO MAN'#39', '#39'AJ. REDU'#199#195'O PIS LANCTO MANUAL'#39', '#39'AJ. REDU'#199#195'O NF DEV CO' +
        'MPRAS'#39') and'
      '           (cbcc437 is not null and cbcc437<>'#39'99'#39') then'
      ''
      
        #9#9#9#9'  case when (pisaliquota = 0.65) or (cofinsaliquota = 3) or ' +
        ' /* No Regime Cumulativo - PIS 0,65 e COFINS 3,00 */'
      
        #9#9#9#9#9#9'   (pisaliquota = 1.65) or (cofinsaliquota = 7.6) then  /*' +
        ' No Regime N'#195'O Cumulativo - PIS 1,65 e COFINS 7,6 */'
      
        #9#9#9#9#9'301  /* 201 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no me' +
        'rcado interno '#8211' Al'#237'quota B'#225'sica */'
      #9#9#9#9'  else'
      
        #9#9#9#9#9'302  /* 202 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no me' +
        'rcado interno '#8211' Al'#237'quotas Diferenciadas */'
      ''
      
        #9#9#9#9' /*   303 Cr'#233'dito vinculado '#224' receita de exporta'#231#227'o '#8211' Al'#237'quo' +
        'ta por Unidade de Produto'
      
        #9#9#9#9#9'  304 Cr'#233'dito vinculado '#224' receita de exporta'#231#227'o '#8211' Estoque d' +
        'e Abertura'
      
        #9#9#9#9#9'  305 Cr'#233'dito vinculado '#224' receita de exporta'#231#227'o '#8211' Aquisi'#231#227'o' +
        ' Embalagens para revenda'
      
        #9#9#9#9#9'  306 Cr'#233'dito vinculado '#224' receita de exporta'#231#227'o '#8211' Presumido' +
        ' da Agroind'#250'stria'
      
        #9#9#9#9#9'  308 Cr'#233'dito vinculado '#224' receita de exporta'#231#227'o '#8211' Importa'#231#227 +
        'o'
      
        #9#9#9#9#9'  399 Cr'#233'dito vinculado '#224' receita de exporta'#231#227'o '#8211' Outros  *' +
        '/'
      #9#9#9#9'  end'
      ''
      #9#9'  else'
      '      case when cod_cred is not null then'
      '        cod_cred'
      
        '      else cast(null as integer) end /* FALTA MAPEAR O RESTANTE ' +
        'DOS C'#211'DIGOS */'
      #9'  end as ctc436'
      ''
      ' from'
      ' '
      '('
      '   select piscofins.*,'
      
        '      case when piscofins.piscst in ('#39'50'#39','#39'51'#39','#39'52'#39','#39'53'#39','#39'54'#39','#39'5' +
        '5'#39','#39'56'#39','#39'60'#39','#39'61'#39','#39'62'#39','#39'63'#39','#39'64'#39','#39'65'#39','#39'66'#39') and'
      
        '                piscofins.cofinscst in ('#39'50'#39','#39'51'#39','#39'52'#39','#39'53'#39','#39'54'#39 +
        ','#39'55'#39','#39'56'#39','#39'60'#39','#39'61'#39','#39'62'#39','#39'63'#39','#39'64'#39','#39'65'#39','#39'66'#39') and'
      
        '                nat_bc_cred is null  and especie not in ('#39'DESCON' +
        'TOS RECEBIDOS'#39', '#39'AJ. ACRESC. COFINS LANCTO MAN'#39', '#39'AJ. ACRESC. PI' +
        'S LANCTO MANUAL'#39','
      
        '                                        '#39'AJ. REDU'#199#195'O COFINS LANC' +
        'TO MAN'#39', '#39'AJ. REDU'#199#195'O PIS LANCTO MANUAL'#39', '#39'AJ. REDU'#199#195'O NF DEV CO' +
        'MPRAS'#39') then'
      ''
      
        '         case when (mod(piscofins.codigofiscal,1000) in (101,111' +
        ',116,120,122,126,128,401,407,556,651,653,101,111,116,120,122,126' +
        ',128,401,407,'
      
        '                                                         556,651' +
        ',653,101,126,128,556,651,653)/*'
      
        '                    piscofins.modelodocto in ('#39'02'#39','#39'2D'#39','#39'2E'#39','#39'59' +
        #39')*/) then cast('#39'02'#39' as varchar(2)) /* Aquisi'#231#227'o de bens utiliza' +
        'dos como insumo */'
      ''
      
        '              when mod(piscofins.codigofiscal,1000) in (201,202,' +
        '203,204,410,411,660,661,662,201,202,410,411,660,661,662) then ca' +
        'st('#39'12'#39' as varchar(2)) /* Devolu'#231#227'o de Vendas Sujeitas '#224' Incid'#234'n' +
        'cia N'#227'o-Cumulativa */'
      
        '              when piscofins.modelodocto in ('#39'06'#39','#39'28'#39', '#39'29'#39') th' +
        'en cast('#39'04'#39' as varchar(2)) /* Energia el'#233'trica e t'#233'rmica, inclu' +
        'sive sob a forma de vapor */'
      
        '              when piscofins.modelodocto in ('#39'07'#39','#39'08'#39','#39'8B'#39','#39'09'#39 +
        ','#39'10'#39','#39'11'#39','#39'26'#39','#39'27'#39','#39'57'#39') then cast('#39'14'#39' as varchar(2)) /* Ativ' +
        'idade de Transporte de Cargas  Subcontrata'#231#227'o */'
      '              when piscofins.modelodocto in ('#39'21'#39','#39'22'#39') or'
      
        '                   mod(piscofins.codigofiscal,1000) in (124,125,' +
        '933,124,125,933) then cast('#39'03'#39' as varchar(2)) /*  Aquisi'#231#227'o de ' +
        'servi'#231'os utilizados como insumo */'
      ''
      
        '              when mod(piscofins.codigofiscal,1000) in (101,111,' +
        '116,120,122,126,128,401,407,556,651,653,101,111,116,120,122,126,' +
        '128,'
      
        '                                                        401,407,' +
        '556,651,653,101,126,128,556,651,653) then cast('#39'02'#39' as varchar(2' +
        '))  /* Aquisi'#231#227'o de Bens Utilizados como Insumo */'
      ''
      
        '              when mod(piscofins.codigofiscal,1000) in (102,113,' +
        '117,118,121,251,403,652,102,113,117,'
      
        '                                                        118,121,' +
        '251,403,652,102,251,652) then cast('#39'01'#39' as varchar(2))  /* Aquis' +
        'i'#231#227'o de bens para revenda */'
      '         else cast('#39'99'#39' as varchar(2)) end /* Indefinido */'
      ''
      '       else'
      
        '         case when nat_bc_cred is not null then nat_bc_cred else' +
        ' cast(null as varchar(2)) end'
      '       end as cbcc437'
      'from'
      '('
      
        'select np.filial as filialemissao, np.fornecedor, np.tipofornece' +
        'dor,'
      '       np.data,'
      
        '       cast('#39'NOTAS FISCAIS DE ENTRADA'#39' as varchar(30)) as especi' +
        'e,'
      #9'   np.serie,'
      #9'   np.numero,'
      #9'   np.modelodocto,'
      #9'   np.valornota as valortotal,'
      #9'   pnp.codigofiscal,'
      ''
      #9'   pnp.piscst,'
      #9'   pnp.PISBaseCalculo,'
      #9'   pnp.pisvalor,'
      '       pnp.pisaliquota,'
      ''
      #9'   pnp.cofinscst,'
      '       pnp.cofinsbasecalculo,'
      '       pnp.cofinsvalor,'
      #9'   pnp.cofinsaliquota,'
      #9'   cast(null as varchar(2)) as nat_bc_cred,'
      '     cast(null as integer) as cod_cred'
      ''
      'from notaspag np'
      '     join produtosnotaspag pnp'
      '     on np.codigo = pnp.codigonota'
      'where np.codigo = pnp.codigonota'
      '  and to_char(cast(np.data as date), '#39'MM/YYYY'#39')= :MesAno'
      ''
      '/* C170 -> '#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39
      '   C396 -> '#39'02'#39','#39'2D'#39','#39'2E'#39','#39'59'#39
      '   C501 -> '#39'06'#39','#39'28'#39', '#39'29'#39
      '   D101 -> '#39'07'#39','#39'08'#39','#39'8B'#39','#39'09'#39','#39'10'#39','#39'11'#39','#39'26'#39','#39'27'#39','#39'57'#39
      '   D501 -> '#39'21'#39','#39'22'#39' */'
      ''
      '  and (np.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39') or'
      '       np.modelodocto in ('#39'02'#39','#39'2D'#39','#39'2E'#39','#39'59'#39') or'
      '       np.modelodocto in ('#39'06'#39','#39'28'#39', '#39'29'#39') or'
      
        '       np.modelodocto in ('#39'07'#39','#39'08'#39','#39'8B'#39','#39'09'#39','#39'10'#39','#39'11'#39','#39'26'#39','#39'27' +
        #39','#39'57'#39') or'
      '       np.modelodocto in ('#39'21'#39','#39'22'#39'))'
      ''
      '  and np.situacao = '#39'N'#39
      '  and (np.filial = :filialconsolidadora or'
      '       np.filial in (select f.codigo'
      '                     from filiais f'
      
        '                     where f.filialconsolidadoradime = :filialco' +
        'nsolidadora'
      
        '                     and (f.sped_pis_cofins or f.sped_pis_cofins' +
        '_rb or f.sped_pis_cofins_rem)))'
      ''
      '  and'
      
        '  (case when :NotasdeCompra then ehnotafiscalentradacompra(pnp.c' +
        'odigofiscal) else false end or'
      
        '   case when :NotasdeDevolucao_s then ehnotafiscalentradadevoluc' +
        'ao(pnp.codigofiscal) else false end or'
      
        '   case when :NotasdeTransferencia_s then ehnotafiscalentradatra' +
        'nsferencia(pnp.codigofiscal) else false end)'
      ''
      ''
      'union all'
      ''
      
        'select filial as filialemissao, filial as fornecedor, cast('#39'L'#39' a' +
        's varchar(1)) as tipofornecedor, dt_oper as data, cast('#39'DEMAIS D' +
        'OCTOS MANUAIS'#39' as varchar(30)) as especie,'
      
        '        cast(null as varchar(3)) as serie, cast(null as integer)' +
        ' as numero, cast(null as varchar(2)) as modelodocto,'
      #9#9'vl_oper as valortotal, cast(null as integer) as codigofiscal,'
      
        #9#9'cst_pis as piscst, vl_bc_pis as pisbasecalculo, vl_pis as pisv' +
        'alor, aliq_pis as pisaliquota,'
      
        #9#9'cst_cofins as cofinscst, vl_bc_cofins as cofinsbasecalculo, vl' +
        '_cofins as cofinsvalor, aliq_cofins as cofinsaliquota,'
      #9#9'nat_bc_cred,'
      '    cast(null as integer) as cod_cred'
      ''
      'from piscofins_f100'
      'where periodo = :MesAno'
      '  and documentopag is null  /* n'#227'o gerada pelo contas a pagar */'
      '  and ind_oper  = 0 /* sa'#237'das */'
      '  and filialepc = :filialconsolidadora'
      ''
      'union all'
      ''
      
        'select filial as filialemissao, filial as fornecedor, cast('#39'L'#39' a' +
        's varchar(1)) as tipofornecedor, cast(null as date) as data, cas' +
        't('#39'DEPRECIA'#199#195'O DE BENS'#39' as varchar(30)) as especie,'
      
        '        cast(null as varchar(3)) as serie, cast(null as integer)' +
        ' as numero, cast(null as varchar(2)) as modelodocto,'
      
        #9#9'vl_oper_dep as valortotal, cast(null as integer) as codigofisc' +
        'al,'
      
        #9#9'cst_pis as piscst, vl_bc_pis as pisbasecalculo, vl_pis as pisv' +
        'alor, aliq_pis as pisaliquota,'
      
        #9#9'cst_cofins as cofinscst, vl_bc_cofins as cofinsbasecalculo, vl' +
        '_cofins as cofinsvalor, aliq_cofins as cofinsaliquota,'
      #9#9'nat_bc_cred,'
      '    cast(null as integer) as cod_cred'
      ''
      'from piscofins_f120'
      'where periodo = :MesAno'
      '  and filialepc = :filialconsolidadora'
      ''
      ''
      'union all'
      ''
      
        'select filial as filialemissao, filial as fornecedor, cast('#39'L'#39' a' +
        's varchar(1)) as tipofornecedor, cast(null as date) as data, cas' +
        't('#39'AQUISI'#199#195'O DE BENS'#39' as varchar(30)) as especie,'
      
        '        cast(null as varchar(3)) as serie, cast(null as integer)' +
        ' as numero, cast(null as varchar(2)) as modelodocto,'
      
        #9#9'vl_oper_aquis as valortotal, cast(null as integer) as codigofi' +
        'scal,'
      
        #9#9'cst_pis as piscst, vl_bc_pis as pisbasecalculo, vl_pis as pisv' +
        'alor, aliq_pis as pisaliquota,'
      
        #9#9'cst_cofins as cofinscst, vl_bc_cofins as cofinsbasecalculo, vl' +
        '_cofins as cofinsvalor, aliq_cofins as cofinsaliquota,'
      #9#9'nat_bc_cred,'
      '    cast(null as integer) as cod_cred'
      ''
      'from piscofins_f130'
      'where periodo = :MesAno'
      '  and filialepc = :filialconsolidadora'
      ''
      'union all'
      ''
      
        'select dp.filialemissao, dp.fornecedor, dp.tipofornecedor, dp.da' +
        'talancto as data, cast('#39'DOCUMENTOS A PAGAR'#39' as varchar(30)) as e' +
        'specie,'
      
        '       cast(null as varchar(3)) as serie, dp.numero, cast(null a' +
        's varchar(2)) as modelodocto,'
      
        '       dp.valor as valortotal, cast(null as integer) as codigofi' +
        'scal,'
      
        '       dp.piscst, dp.pisbasecalculo, dp.pisvalor, dp.pisaliquota' +
        ','
      
        '       dp.cofinscst, dp.cofinsbasecalculo, dp.cofinsvalor, dp.co' +
        'finsaliquota,'
      '       dp.nat_bc_cred,'
      '       cast(null as integer) as cod_cred'
      ''
      'from documentospag dp'
      ''
      'where to_char(cast(dp.datalancto as date), '#39'MM/YYYY'#39')= :MesAno'
      ''
      '  and (dp.filialemissao = :filialconsolidadora or'
      '       dp.filialemissao in (select f.codigo'
      '                     from filiais f'
      
        '                     where f.filialconsolidadoradime = :filialco' +
        'nsolidadora'
      
        '                     and (f.sped_pis_cofins or f.sped_pis_cofins' +
        '_rb or f.sped_pis_cofins_rem)))'
      '  and (dp.piscst is not null or dp.cofinscst is not null)'
      ''
      'union all'
      ''
      
        'select df.filialemissao, df.cliente as fornecedor, df.tipoclient' +
        'e as tipofornecedor,'
      '       df.data,'
      
        '       cast('#39'AJ. REDU'#199#195'O NF DEV COMPRAS'#39' as varchar(30)) as espe' +
        'cie,'
      '       n.serie, n.numero, df.modelodocto, /*df.cliente,'
      '       df.tipocliente,*/ - df.valortotal, pdf.codigofiscal,'
      ''
      
        '       pdf.piscst, - pdf.pisbasecalculo, -pdf.pisvalor, pdf.pisa' +
        'liquota,'
      
        '       pdf.cofinscst, - pdf.cofinsbasecalculo, - pdf.cofinsvalor' +
        ', pdf.cofinsaliquota,'
      '       cast(null as varchar(2)) as nat_bc_cred,'
      '       cast(null as integer) as cod_cred'
      ''
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      '     join produtosdadosfiscais pdf'
      '     on df.numero = pdf.dadofiscal'
      ''
      'where df.numero = pdf.dadofiscal'
      '  and to_char(df.data, '#39'MM/YYYY'#39')=:MesAno'
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and df.CodigoFiscal < 8000'
      '  and df.situacao = '#39'N'#39
      '  and (df.filialemissao  = :filialconsolidadora or'
      '       df.filialemissao in (select f.codigo'
      '                              from filiais f'
      
        '                              where f.filialconsolidadoradime  =' +
        ' :filialconsolidadora'
      
        '                              and (f.sped_pis_cofins or f.sped_p' +
        'is_cofins_rb or f.sped_pis_cofins_rem)))'
      '  and not coalesce(df.notavinculada,false)'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      '  and pdf.piscst = '#39'49'#39'  /* devolu'#231#245'es */'
      '  and pdf.cofinscst = '#39'49'#39
      '  and mod(pdf.codigofiscal,1000) in (202,411)'
      ''
      ''
      'union all'
      ''
      'select m110.filialepc as filialemissao,'
      
        '       m110.filialepc as fornecedor, cast('#39'L'#39' as varchar(1)) as ' +
        'tipofornecedor,'
      '       m110.dt_ref as data,'
      
        '       cast('#39'AJ. REDU'#199#195'O PIS LANCTO MANUAL'#39' as varchar(30)) as e' +
        'specie,'
      '       cast(null as varchar(3)) as serie,'
      '       m110.numero,'
      '       cast(null as varchar(2)) as modelodocto,'
      '       - vl_aj as valortotal,'
      '       cast(null as integer) as codigofiscal,'
      ''
      '       cast(null as varchar(2)) as piscst,'
      '       cast(null as numeric(15,2)) as pisbasecalculo,'
      '       - vl_aj as pisvalor,'
      '       cast(null as numeric(5,2)) as pisaliquota,'
      ''
      '       cast(null as varchar(2)) as cofinscst,'
      '       cast(null as numeric(15,2)) as cofinsbasecalculo,'
      '       cast(null as numeric(15,2)) as cofinsvalor,'
      '       cast(null as numeric(5,2)) as cofinsaliquota,'
      ''
      '       cast(null as varchar(2)) as nat_bc_cred,'
      ''
      '       m100.cod_cred'
      ''
      ''
      'from piscofins_m110 m110'
      '     join piscofins_m100 m100'
      '     on m110.filialepc = m100.filialepc and'
      '        m110.periodo = m100.periodo and'
      '        m110.numero = m100.numero'
      ''
      'where m110.ind_aj = 0'
      '  and not m110.geradosistema'
      '  and m100.periodo = :MesAno'
      '  and m100.filialepc = :filialconsolidadora'
      ''
      'union all'
      ''
      'select m510.filialepc as filialemissao,'
      
        '       m510.filialepc as fornecedor, cast('#39'L'#39' as varchar(1)) as ' +
        'tipofornecedor,'
      '       m510.dt_ref as data,'
      
        '       cast('#39'AJ. REDU'#199#195'O COFINS LANCTO MAN'#39' as varchar(30)) as e' +
        'specie,'
      '       cast(null as varchar(3)) as serie,'
      '       m510.numero,'
      '       cast(null as varchar(2)) as modelodocto,'
      '       - vl_aj as valortotal,'
      '       cast(null as integer) as codigofiscal,'
      ''
      '       cast(null as varchar(2)) as piscst,'
      '       cast(null as numeric(15,2)) as pisbasecalculo,'
      '       cast(null as numeric(15,2)) as pisvalor,'
      '       cast(null as numeric(5,2)) as pisaliquota,'
      ''
      '       cast(null as varchar(2)) as cofinscst,'
      '       cast(null as numeric(15,2)) as cofinsbasecalculo,'
      '       - vl_aj as cofinsvalor,'
      '       cast(null as numeric(5,2)) as cofinsaliquota,'
      ''
      '       cast(null as varchar(2)) as nat_bc_cred,'
      ''
      '       m500.cod_cred'
      ''
      'from piscofins_m510 m510'
      '     join piscofins_m500 m500'
      '     on m510.filialepc = m500.filialepc and'
      '        m510.periodo = m500.periodo and'
      '        m510.numero = m500.numero'
      ''
      'where m510.ind_aj = 0'
      '  and not m510.geradosistema'
      '  and m500.periodo = :MesAno'
      '  and m500.filialepc = :filialconsolidadora'
      ''
      ''
      'union all'
      ''
      'select m110.filialepc as filialemissao,'
      
        '       m110.filialepc as fornecedor, cast('#39'L'#39' as varchar(1)) as ' +
        'tipofornecedor,'
      '       m110.dt_ref as data,'
      
        '       cast('#39'AJ. ACRESC. PIS LANCTO MANUAL'#39' as varchar(30)) as e' +
        'specie,'
      '       cast(null as varchar(3)) as serie,'
      '       m110.numero,'
      '       cast(null as varchar(2)) as modelodocto,'
      '       vl_aj as valortotal,'
      '       cast(null as integer) as codigofiscal,'
      ''
      '       cast(null as varchar(2)) as piscst,'
      '       cast(null as numeric(15,2)) as pisbasecalculo,'
      '       vl_aj as pisvalor,'
      '       cast(null as numeric(5,2)) as pisaliquota,'
      ''
      '       cast(null as varchar(2)) as cofinscst,'
      '       cast(null as numeric(15,2)) as cofinsbasecalculo,'
      '       cast(null as numeric(15,2)) as cofinsvalor,'
      '       cast(null as numeric(5,2)) as cofinsaliquota,'
      ''
      '       cast(null as varchar(2)) as nat_bc_cred,'
      ''
      '       m100.cod_cred'
      ''
      'from piscofins_m110 m110'
      '     join piscofins_m100 m100'
      '     on m110.filialepc = m100.filialepc and'
      '        m110.periodo = m100.periodo and'
      '        m110.numero = m100.numero'
      ''
      'where m110.ind_aj = 1'
      '  and not m110.geradosistema'
      '  and m100.periodo = :MesAno'
      '  and m100.filialepc = :filialconsolidadora'
      ''
      'union all'
      ''
      'select m510.filialepc as filialemissao,'
      
        '       m510.filialepc as fornecedor, cast('#39'L'#39' as varchar(1)) as ' +
        'tipofornecedor,'
      '       m510.dt_ref as data,'
      
        '       cast('#39'AJ. ACRESC. COFINS LANCTO MAN'#39' as varchar(30)) as e' +
        'specie,'
      '       cast(null as varchar(3)) as serie,'
      '       m510.numero,'
      '       cast(null as varchar(2)) as modelodocto,'
      '       vl_aj as valortotal,'
      '       cast(null as integer) as codigofiscal,'
      ''
      '       cast(null as varchar(2)) as piscst,'
      '       cast(null as numeric(15,2)) as pisbasecalculo,'
      '       cast(null as numeric(15,2)) as pisvalor,'
      '       cast(null as numeric(5,2)) as pisaliquota,'
      ''
      '       cast(null as varchar(2)) as cofinscst,'
      '       cast(null as numeric(15,2)) as cofinsbasecalculo,'
      '       vl_aj as cofinsvalor,'
      '       cast(null as numeric(5,2)) as cofinsaliquota,'
      ''
      '       cast(null as varchar(2)) as nat_bc_cred,'
      ''
      '       m500.cod_cred'
      ''
      'from piscofins_m510 m510'
      '     join piscofins_m500 m500'
      '     on m510.filialepc = m500.filialepc and'
      '        m510.periodo = m500.periodo and'
      '        m510.numero = m500.numero'
      ''
      'where m510.ind_aj = 0'
      '  and not m510.geradosistema'
      '  and m500.periodo = :MesAno'
      '  and m500.filialepc = :filialconsolidadora'
      ''
      'union all'
      ''
      'select np.filial as filialemissao,'
      '       np.fornecedor, np.tipofornecedor,'
      '       d.datapagto as data,'
      '       cast('#39'DESCONTOS RECEBIDOS'#39' as varchar(30)) as especie,'
      '       np.serie,'
      #9'   np.numero,'
      #9'   np.modelodocto,'
      #9'   d.valorvencto - d.valorpagto as valortotal,'
      #9'   np.codigofiscal,'
      ''
      '       (select pnp.piscst'
      '       from produtosnotaspag pnp'
      '        where pnp.codigonota = np.codigo'
      '        order by pisaliquota desc limit 1) as piscst,'
      ''
      '     - (d.valorvencto - d.valorpagto) as pisbasecalculo,'
      
        '     - ((d.valorvencto - d.valorpagto) *  coalesce((select max(p' +
        'np.pisaliquota)'
      
        '                                                   from produtos' +
        'notaspag pnp'
      
        '                                                   where pnp.cod' +
        'igonota = np.codigo),0)/100) as pisvalor,'
      '       (select max(pnp.pisaliquota)'
      '        from produtosnotaspag pnp'
      '        where pnp.codigonota = np.codigo) as pisaliquota,'
      ''
      '       (select pnp.cofinscst'
      '       from produtosnotaspag pnp'
      '        where pnp.codigonota = np.codigo'
      '        order by pisaliquota desc limit 1) as cofinscst,'
      ''
      '     - (d.valorvencto - d.valorpagto) as cofinsbasecalculo,'
      
        '     - ((d.valorvencto - d.valorpagto) *  coalesce((select max(p' +
        'np.cofinsaliquota)'
      
        '                                                   from produtos' +
        'notaspag pnp'
      
        '                                                   where pnp.cod' +
        'igonota = np.codigo),0)/100) as cofinsvalor,'
      ''
      '       (select max(pnp.cofinsaliquota)'
      '        from produtosnotaspag pnp'
      '        where pnp.codigonota = np.codigo) as pisaliquota,'
      ''
      #9'   cast(null as varchar(2)) as nat_bc_cred,'
      '       cast(null as integer) as cod_cred'
      ''
      'from duplicatas d'
      '     join documentospag dp'
      '          join notaspag np'
      '          on np.documentopag = dp.numero'
      '     on d.documentopag = dp.numero'
      'where to_char(cast(d.datapagto as date), '#39'MM/YYYY'#39')= :MesAno'
      '  and d.valorpagto < d.valorvencto'
      ''
      '  and (np.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39') or'
      '       np.modelodocto in ('#39'02'#39','#39'2D'#39','#39'2E'#39','#39'59'#39') or'
      '       np.modelodocto in ('#39'06'#39','#39'28'#39', '#39'29'#39') or'
      
        '       np.modelodocto in ('#39'07'#39','#39'08'#39','#39'8B'#39','#39'09'#39','#39'10'#39','#39'11'#39','#39'26'#39','#39'27' +
        #39','#39'57'#39') or'
      '       np.modelodocto in ('#39'21'#39','#39'22'#39'))'
      ''
      '  and exists (select pnp.piscst'
      '              from produtosnotaspag pnp'
      '              where pnp.codigonota = np.codigo'
      
        '                and pnp.piscst in ('#39'50'#39','#39'51'#39','#39'52'#39','#39'53'#39','#39'54'#39','#39'55'#39 +
        ','#39'56'#39','#39'60'#39','#39'61'#39','#39'62'#39','#39'63'#39','#39'64'#39','#39'65'#39','#39'66'#39')'
      '              limit 1)'
      ''
      '  and exists (select pnp.cofinscst'
      '              from produtosnotaspag pnp'
      '              where pnp.codigonota = np.codigo'
      
        '                and pnp.cofinscst in ('#39'50'#39','#39'51'#39','#39'52'#39','#39'53'#39','#39'54'#39','#39 +
        '55'#39','#39'56'#39','#39'60'#39','#39'61'#39','#39'62'#39','#39'63'#39','#39'64'#39','#39'65'#39','#39'66'#39')'
      '              limit 1)'
      ''
      '  and np.situacao = '#39'N'#39
      '  and (np.filial = :filialconsolidadora or'
      '       np.filial in (select f.codigo'
      '                     from filiais f'
      
        '                     where f.filialconsolidadoradime = :filialco' +
        'nsolidadora'
      
        '                     and (f.sped_pis_cofins or f.sped_pis_cofins' +
        '_rb or f.sped_pis_cofins_rem)))'
      ''
      ''
      ') as piscofins'
      ') as piscofins'
      
        ') as piscofins left join piscofins_t437 on piscofins.cbcc437 = p' +
        'iscofins_t437.codigo'
      
        '               left join piscofins_t436 on piscofins.ctc436 = pi' +
        'scofins_t436.codigo'
      ') as piscofins'
      
        'group by filialemissao, fornecedor, tipofornecedor, data, especi' +
        'e, serie, numero, modelodocto, valortotal, codigofiscal, piscst,' +
        ' pisaliquota, cofinscst, cofinsaliquota,'
      #9'   ctc436, descricaot437, cbcc437, descricaot436'
      ''
      
        'order by descricaot436, ctc436, descricaot437, cbcc437, especie,' +
        ' data, serie, numero'
      '')
    RequestLive = False
    Left = 200
    Top = 144
    ParamData = <
      item
        DataType = ftString
        Name = 'MesAno'
        ParamType = ptUnknown
        Value = '05/2012'
      end
      item
        DataType = ftString
        Name = 'filialconsolidadora'
        ParamType = ptUnknown
        Value = '1'
