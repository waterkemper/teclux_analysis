  object qryProcuraFiliais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select'
      '    f.codigo,'
      '    f.nome,'
      '    f.razao,'
      '    f.cnpj,'
      '    f.inscricaoestadual,'
      '    f.rua,'
      '    f.estado,'
      '    c.nome as nomecidade,'
      '    b.nome as nomebairro,'
      '    f.cep,'
      '    f.junta,'
      '    f.juntadata'
      'From filiais f, estados e, cidades c, bairros b'
      'where (f.estado = e.codigo) and'
      '      (f.estado = c.estado) and'
      '      (f.cidade = c.codigo) and'
      '      (f.estado = b.estado) and'
      '      (f.cidade = b.cidade) and'
      '      (f.bairro = b.codigo) and'
      '      (f.codigo = :codigo)  and'
      '       f.filialconsolidadoradime is null')
    RequestLive = False
    Left = 42
    Top = 6
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end>
    object qryProcuraFiliaiscodigo: TIntegerField
      FieldName = 'codigo'
      Required = True
    end
    object qryProcuraFiliaisnome: TStringField
      FieldName = 'nome'
      Required = True
      Size = 40
    end
    object qryProcuraFiliaisrazao: TStringField
      FieldName = 'razao'
      Required = True
      Size = 40
    end
    object qryProcuraFiliaiscnpj: TStringField
      FieldName = 'cnpj'
      Size = 14
    end
    object qryProcuraFiliaisinscricaoestadual: TStringField
      FieldName = 'inscricaoestadual'
    end
    object qryProcuraFiliaisrua: TStringField
      FieldName = 'rua'
      Size = 100
    end
    object qryProcuraFiliaisestado: TStringField
      FieldName = 'estado'
      Size = 2
    end
    object qryProcuraFiliaisnomecidade: TStringField
      FieldName = 'nomecidade'
      Size = 30
    end
    object qryProcuraFiliaisnomebairro: TStringField
      FieldName = 'nomebairro'
      Size = 30
    end
    object qryProcuraFiliaiscep: TIntegerField
      FieldName = 'cep'
    end
    object qryProcuraFiliaisjunta: TStringField
      FieldName = 'junta'
    end
    object qryProcuraFiliaisjuntadata: TDateField
      FieldName = 'juntadata'
    end
  end
  object dsrProcuraFiliais: TtecDataSource
    DataSet = qryProcuraFiliais
    Left = 42
    Top = 58
  end
  object qryConsultaFiliais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT nome,codigo'
      'FROM filiais'
      'where filialconsolidadoradime is null'
      'ORDER BY UPPER(TO_ASCII(nome,'#39'LATIN1'#39'))')
    RequestLive = True
    Left = 45
    Top = 110
    object qryConsultaFiliaisnome: TStringField
      FieldName = 'nome'
      Size = 40
    end
    object qryConsultaFiliaiscodigo: TIntegerField
      FieldName = 'codigo'
    end
  end
  object qryLivroApuracaoPISCofins_Debitos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      
        'select piscofins.*, retencoes.cofins as cofinsretido, retencoes.' +
        'pis as pisretido'
      'from'
      '('
      
        'select tipocontribuicao, filial, data, especie, serie, numero, v' +
        'alortotal, codigofiscal, piscst,'
      '       pisaliquota, cofinscst,  aliquotacofins, cod_inc_trib,'
      #9'   ccs435, descricaot435, dadofiscal,'
      '     sum(pisbasecalculo) as pisbasecalculo,'
      #9'   sum(pisvalor) as pisvalor,'
      '     sum(cofinsbasecalculo) as cofinsbasecalculo,'
      #9'   sum(cofinsvalor) as cofinsvalor'
      'from'
      '('
      'select piscofins.*,'
      
        '       case when ccs435 in ('#39'01'#39','#39'02'#39','#39'03'#39') then cast('#39'N'#195'O CUMUL' +
        'ATIVA'#39' as varchar(25))'
      
        '  '#9'        when ccs435 in ('#39'51'#39','#39'52'#39','#39'53'#39') then cast('#39'CUMULATIVA' +
        #39' as varchar(25))'
      
        #9'      '#9#9'when ccs435 in ('#39'31'#39','#39'32'#39') then cast('#39'SUBSTITUI'#199#195'O TRIB' +
        'UT'#193'RIA'#39' as varchar(25))'
      
        #9'     else cast('#39'SEM OCORR'#202'NCIA DE D'#201'BITO'#39' as varchar(25)) end a' +
        's tipocontribuicao,'
      '       t435.descricao as descricaot435'
      'from'
      '('
      'select piscofins.*,'
      
        '  (case when COD_INC_TRIB in (1,3) and (piscst='#39'01'#39' and pisaliqu' +
        'ota=1.65)  and'
      
        '                                       (cofinscst='#39'01'#39' and aliqu' +
        'otacofins=7.6) THEN cast('#39'01'#39' as char(2))  /* 01 Contribui'#231#227'o n'#227 +
        'o-cumulativa apurada a al'#237'quota b'#225'sica */'
      ''
      
        '       when COD_INC_TRIB in (2,3) and (piscst='#39'01'#39' and pisaliquo' +
        'ta=0.65) and'
      
        #9'                                  (cofinscst='#39'01'#39' and  aliquota' +
        'cofins=3)   THEN cast('#39'51'#39' as char(2))  /* 51 Contribui'#231#227'o cumul' +
        'ativa apurada a al'#237'quota b'#225'sica */'
      ''
      
        '       when COD_INC_TRIB in (1,3) and (piscst='#39'02'#39' and cofinscst' +
        '='#39'02'#39')         THEN cast('#39'02'#39' as char(2))  /* 02 Contribui'#231#227'o n'#227 +
        'o-cumulativa apurada a al'#237'quotas diferenciadas */'
      ''
      
        '       when COD_INC_TRIB in (2)   and (piscst='#39'02'#39' and cofinscst' +
        '='#39'02'#39')         THEN cast('#39'52'#39' as char(2))  /* 52 Contribui'#231#227'o cu' +
        'mulativa apurada a al'#237'quotas diferenciadas */'
      ''
      
        '       when COD_INC_TRIB in (1,3) and (piscst='#39'03'#39' and cofinscst' +
        '='#39'03'#39')         THEN cast('#39'03'#39' as char(2))  /* 03 Contribui'#231#227'o n'#227 +
        'o-cumulativa apurada a al'#237'quota por unidade de medida de produto' +
        ' */'
      ''
      
        '       when COD_INC_TRIB in (2)   and (piscst='#39'03'#39' and cofinscst' +
        '='#39'03'#39')         THEN cast('#39'53'#39' as char(2))  /* 53 Contribui'#231#227'o cu' +
        'mulativa apurada a al'#237'quota por unidade de medida de produto */'
      ''
      
        '       when                           (piscst='#39'05'#39' and pisaliquo' +
        'ta=0.65) and'
      
        #9'                                  (cofinscst='#39'05'#39' and aliquotac' +
        'ofins=3)    THEN cast('#39'31'#39' as char(2))  /* 31 Contribui'#231#227'o apura' +
        'da por substitui'#231#227'o tribut'#225'ria */'
      ''
      
        '       when                           (piscst='#39'05'#39' and (pisaliqu' +
        'ota=0.65 or pisaliquota<>0)) and'
      
        #9'                                  (cofinscst='#39'05'#39' and (aliquota' +
        'cofins=3 or aliquotacofins<>0))'
      
        #9#9#9#9#9#9#9#9#9'                                           THEN cast('#39'3' +
        '2'#39' as char(2))  /* 32 Contribui'#231#227'o apurada por substitui'#231#227'o trib' +
        'ut'#225'ria '#8211' Vendas '#224' Zona Franca de Manaus */'
      ''
      '  else cast('#39#39' as char(2)) end) as CCS435'
      ''
      'from'
      '('
      ''
      'select df.filialemissao as filial,'
      '       df.data,'
      '       cast('#39'NF SERVI'#199'OS'#39' as varchar(15)) as especie,'
      '       n.serie, n.numero, /*df.cliente,'
      '       df.tipocliente,*/ df.valortotal, sdf.codigofiscal,'
      '       sdf.piscst, sdf.pisbasecalculo, sdf.pisvalor,'
      '       sdf.aliquotapis as pisaliquota, sdf.cofinscst,'
      '       sdf.cofinsbasecalculo,'
      '       sdf.cofinsvalor, sdf.aliquotacofins,'
      '       (select f.COD_INC_TRIB'
      
        '        from filiais f where f.codigo  = :filialconsolidadora) a' +
        's cod_inc_trib,'
      '       sdf.dadofiscal'
      ''
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      '     join servicosdadosfiscais sdf'
      '     on df.numero = sdf.dadofiscal'
      ''
      'where df.numero = sdf.dadofiscal'
      ''
      '  and to_char(df.data, '#39'MM/YYYY'#39')=:MesAno'
      ''
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and df.situacao = '#39'N'#39
      '  and (df.filialemissao  = :filialconsolidadora or'
      '       df.filialemissao in (select f.codigo'
      '                              from filiais f'
      
        '                              where f.filialconsolidadoradime  =' +
        ' :filialconsolidadora'
      
        '                              and (f.sped_pis_cofins or f.sped_p' +
        'is_cofins_rb or f.sped_pis_cofins_rem)))'
      '  and not coalesce(df.notavinculada,false)'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      ''
      'union all'
      ''
      'select df.filialemissao as filial,'
      '       df.data,'
      '       cast('#39'NF PRODUTOS'#39' as varchar(15)) as especie,'
      '       n.serie, n.numero, /*df.cliente,'
      '       df.tipocliente,*/ df.valortotal, pdf.codigofiscal,'
      '       pdf.piscst, pdf.pisbasecalculo, pdf.pisvalor,'
      '       pdf.pisaliquota, pdf.cofinscst,'
      '       pdf.cofinsbasecalculo,'
      '       pdf.cofinsvalor, pdf.cofinsaliquota as aliquotacofins,'
      '       (select f.COD_INC_TRIB'
      
        '        from filiais f where f.codigo  = :filialconsolidadora) a' +
        's cod_inc_trib,'
      '       pdf.dadofiscal'
      #9'   '#9
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      '     join produtosdadosfiscais pdf'
      '     on df.numero = pdf.dadofiscal'
      ''
      'where df.numero = pdf.dadofiscal'
      '  and to_char(df.data, '#39'MM/YYYY'#39')=:MesAno'
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and df.CodigoFiscal < 8000'
      '  and df.situacao = '#39'N'#39
      '  and (df.filialemissao  = :filialconsolidadora or'
      '       df.filialemissao in (select f.codigo'
      '                              from filiais f'
      
        '                              where f.filialconsolidadoradime  =' +
        ' :filialconsolidadora'
      
        '                              and (f.sped_pis_cofins or f.sped_p' +
        'is_cofins_rb or f.sped_pis_cofins_rem)))'
      '  and not coalesce(df.notavinculada,false)'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      '  and'
      
        '  (case when :NotasdeVenda then ehnotafiscalsaidavenda(pdf.codig' +
        'ofiscal) else false end or'
      
        '   case when :NotasdeDevolucao_e then ehnotafiscalsaidadevolucao' +
        '(pdf.codigofiscal) else false end or'
      
        '   case when :NotasdeTransferencia_e then ehnotafiscalsaidatrans' +
        'ferencia(pdf.codigofiscal) else false end)'
      ''
      ''
      ''
      'union all'
      ''
      '  select dc.filial,'
      '         cast(dlc.dt_ini as date) as data,'
      #9#9' cast('#39'CUPOM FISCAL'#39' as varchar(15)) as especie,'
      #9#9' cast(dc.num_usu as varchar(3)) as serie,'
      #9#9' dlc.coo as numero,'
      #9#9' dlc.vl_tot as valortotal,'
      ''
      '         (select pdf.codigofiscal'
      
        '          from cupons c, dadosfiscais df, produtosdadosfiscais p' +
        'df'
      '          where dc.filial = c.filial'
      '             and dc.num_usu = c.maquina'
      '            /*and dc.cro = c.intervensao*/'
      '             and dc.coo = c.numero'
      '             and dc.num_fab = c.numeroserie'
      '             and df.numero = c.dadofiscal'
      '             and pdf.dadofiscal = df.numero'
      
        '             and pdf.produto = cast(dic.cod_item as bigint) limi' +
        't 1) as codigofiscal,'
      ''
      '         coalesce((select pdf.piscst'
      
        '          from cupons c, dadosfiscais df, produtosdadosfiscais p' +
        'df'
      '          where dc.filial = c.filial'
      '             and dc.num_usu = c.maquina'
      '            /*and dc.cro = c.intervensao*/'
      '             and dc.coo = c.numero'
      '             and dc.num_fab = c.numeroserie'
      '             and df.numero = c.dadofiscal'
      '             and pdf.dadofiscal = df.numero'
      
        '             and pdf.produto = cast(dic.cod_item as bigint) limi' +
        't 1), ca.piscst) as piscst,'
      #9#9#9
      '         coalesce((select pdf.pisbasecalculo'
      
        '          from cupons c, dadosfiscais df, produtosdadosfiscais p' +
        'df'
      '          where dc.filial = c.filial'
      '             and dc.num_usu = c.maquina'
      '            /*and dc.cro = c.intervensao*/'
      '             and dc.coo = c.numero'
      '             and dc.num_fab = c.numeroserie'
      '             and df.numero = c.dadofiscal'
      '             and pdf.dadofiscal = df.numero'
      
        '             and pdf.produto = cast(dic.cod_item as bigint) limi' +
        't 1),'
      ''
      
        '          round(coalesce((dic.vl_tot_item - dic.vl_tot_item *  c' +
        'ase when dlc.tp_descto = '#39'V'#39' then dlc.sub_descto end / dlc.sub_d' +
        'octo'
      
        '                             + dic.vl_tot_item *  case when dlc.' +
        'tp_acres = '#39'V'#39' then dlc.sub_acres   end / dlc.sub_docto),0),2) *' +
        ' dic.qtde_item) as pisbasecalculo,'
      ''
      #9#9' coalesce((select pdf.pisvalor'
      
        '          from cupons c, dadosfiscais df, produtosdadosfiscais p' +
        'df'
      '          where dc.filial = c.filial'
      '             and dc.num_usu = c.maquina'
      '            /*and dc.cro = c.intervensao*/'
      '             and dc.coo = c.numero'
      '             and dc.num_fab = c.numeroserie'
      '             and df.numero = c.dadofiscal'
      '             and pdf.dadofiscal = df.numero'
      
        '             and pdf.produto = cast(dic.cod_item as bigint) limi' +
        't 1),'
      ''
      
        '          (round(coalesce((dic.vl_tot_item - dic.vl_tot_item *  ' +
        'case when dlc.tp_descto = '#39'V'#39' then dlc.sub_descto end / dlc.sub_' +
        'docto'
      
        '                             + dic.vl_tot_item *  case when dlc.' +
        'tp_acres = '#39'V'#39' then dlc.sub_acres   end / dlc.sub_docto),0),2) *' +
        ' dic.qtde_item) * ca.aliquotapis / 100) as pisvalor,'
      #9#9#9
      '         coalesce((select pdf.pisaliquota'
      
        '          from cupons c, dadosfiscais df, produtosdadosfiscais p' +
        'df'
      '          where dc.filial = c.filial'
      '             and dc.num_usu = c.maquina'
      '            /*and dc.cro = c.intervensao*/'
      '             and dc.coo = c.numero'
      '             and dc.num_fab = c.numeroserie'
      '             and df.numero = c.dadofiscal'
      '             and pdf.dadofiscal = df.numero'
      
        '             and pdf.produto = cast(dic.cod_item as bigint) limi' +
        't 1), ca.aliquotapis) as pisaliquota,'
      ''
      '         coalesce((select pdf.cofinscst'
      
        '          from cupons c, dadosfiscais df, produtosdadosfiscais p' +
        'df'
      '          where dc.filial = c.filial'
      '             and dc.num_usu = c.maquina'
      '            /*and dc.cro = c.intervensao*/'
      '             and dc.coo = c.numero'
      '             and dc.num_fab = c.numeroserie'
      '             and df.numero = c.dadofiscal'
      '             and pdf.dadofiscal = df.numero'
      
        '             and pdf.produto = cast(dic.cod_item as bigint) limi' +
        't 1), ca.cofinscst) as cofinscst,'
      ''
      '         coalesce((select pdf.cofinsbasecalculo'
      
        '          from cupons c, dadosfiscais df, produtosdadosfiscais p' +
        'df'
      '          where dc.filial = c.filial'
      '             and dc.num_usu = c.maquina'
      '            /*and dc.cro = c.intervensao*/'
      '             and dc.coo = c.numero'
      '             and dc.num_fab = c.numeroserie'
      '             and df.numero = c.dadofiscal'
      '             and pdf.dadofiscal = df.numero'
      
        '             and pdf.produto = cast(dic.cod_item as bigint) limi' +
        't 1),'
      ''
      
        '          round(coalesce((dic.vl_tot_item - dic.vl_tot_item *  c' +
        'ase when dlc.tp_descto = '#39'V'#39' then dlc.sub_descto end / dlc.sub_d' +
        'octo'
      
        '                             + dic.vl_tot_item *  case when dlc.' +
        'tp_acres = '#39'V'#39' then dlc.sub_acres   end / dlc.sub_docto),0),2) *' +
        ' dic.qtde_item) as cofinsbasecalculo,'
      ''
      #9#9' coalesce((select pdf.cofinsvalor'
      
        '          from cupons c, dadosfiscais df, produtosdadosfiscais p' +
        'df'
      '          where dc.filial = c.filial'
      '             and dc.num_usu = c.maquina'
      '            /*and dc.cro = c.intervensao*/'
      '             and dc.coo = c.numero'
      '             and dc.num_fab = c.numeroserie'
      '             and df.numero = c.dadofiscal'
      '             and pdf.dadofiscal = df.numero'
      
        '             and pdf.produto = cast(dic.cod_item as bigint) limi' +
        't 1),'
      ''
      
        '          (round(coalesce((dic.vl_tot_item - dic.vl_tot_item *  ' +
        'case when dlc.tp_descto = '#39'V'#39' then dlc.sub_descto end / dlc.sub_' +
        'docto'
      
        '                             + dic.vl_tot_item *  case when dlc.' +
        'tp_acres = '#39'V'#39' then dlc.sub_acres   end / dlc.sub_docto),0),2) *' +
        ' dic.qtde_item) * ca.aliquotacofins / 100) as cofinsvalor,'
      ''
      '         coalesce((select pdf.cofinsaliquota'
      
        '          from cupons c, dadosfiscais df, produtosdadosfiscais p' +
        'df'
      '          where dc.filial = c.filial'
      '             and dc.num_usu = c.maquina'
      '            /*and dc.cro = c.intervensao*/'
      '             and dc.coo = c.numero'
      '             and dc.num_fab = c.numeroserie'
      '             and df.numero = c.dadofiscal'
      '             and pdf.dadofiscal = df.numero'
      
        '             and pdf.produto = cast(dic.cod_item as bigint) limi' +
        't 1), ca.aliquotacofins) as aliquotacofins,'
      #9#9#9
      '       (select f.COD_INC_TRIB'
      
        '        from filiais f where f.codigo = :filialconsolidadora) as' +
        ' cod_inc_trib,'
      '       cast(null as integer) as dadofiscal'
      #9#9
      #9#9
      '  from dadositemcupom dic'
      ''
      '       join produtos p'
      '         on cast(dic.cod_item as bigint) = p.codigo'
      '         join caracteristicas ca'
      '              join ipi'
      '              on ca.ipi = ipi.codigo'
      '         on p.caracteristica = ca.codigo'
      '/*'
      '         join tributosicms ti'
      '         on ca.incidencia = ti.codigo'
      '*/'
      '       join dadoscupom dc'
      '/*            join cupons c'
      '            on dc.filial = c.filial'
      '            and dc.num_usu = c.maquina */'
      '            /*and dc.cro = c.intervensao*/'
      '/*            and dc.coo = c.numero*/'
      '         on dc.filial = dic.filial'
      '         and dc.num_usu = dic.num_usu'
      '         and dc.cro = dic.cro'
      '         and dc.coo = dic.coo'
      '         and dc.num_fab = dic.num_fab'
      ''
      '         join detalhecupom dlc'
      '           on dc.filial = dlc.filial'
      '           and dc.num_usu = dlc.num_usu'
      '           and dc.cro = dlc.cro'
      '           and dc.coo = dlc.coo'
      '           and dc.num_fab = dlc.num_fab'
      '/*       join dadosfiscais df'
      '       on df.numero = c.dadofiscal*/'
      '/*       join produtosdadosfiscais pdf'
      '       on pdf.dadofiscal = df.numero'
      '       and pdf.produto = cast(dic.cod_item as bigint)*/'
      '/*       and pdf.filial = dic.filial*/'
      '/*       and pdf.numero = dic.num_item */'
      '  where to_char(cast(dlc.dt_ini as date), '#39'MM/YYYY'#39')=:MesAno'
      '    and dlc.canc = '#39'N'#39
      '    and dic.ind_canc = '#39'N'#39
      '    and (dic.filial = :filialconsolidadora or'
      '         dic.filial in (select f.codigo'
      '                     from filiais f'
      
        '                     where f.filialconsolidadoradime = :filialco' +
        'nsolidadora'
      
        '                     and (f.sped_pis_cofins or f.sped_pis_cofins' +
        '_rb or f.sped_pis_cofins_rem)))'
      '/*'
      '    and not exists ('
      '       select pdf.dadofiscal'
      '       from produtosdadosfiscais pdf'
      '       where pdf.dadofiscal = df.numero'
      '         and pdf.produto = cast(dic.cod_item as bigint))'
      '*/'
      ''
      'union all'
      ''
      
        'select filial, dt_oper as data, cast('#39'DEMAIS DOCTOS'#39' as varchar(' +
        '15)) as especie,'
      
        '        cast(null as varchar(3)) as serie, cast(null as integer)' +
        ' as numero,'
      #9#9'vl_oper as valortotal, cast(null as integer) as codigofiscal,'
      
        #9#9'cst_pis as piscst, vl_bc_pis as pisbasecalculo, vl_pis as pisv' +
        'alor, aliq_pis as pisaliquota,'
      
        #9#9'cst_cofins as cofinscst, vl_bc_cofins as cofinsbasecalculo, vl' +
        '_cofins as cofinsvalor, aliq_cofins as cofinsaliquota,'
      '       (select f.COD_INC_TRIB'
      
        '        from filiais f where f.codigo = :filialconsolidadora) as' +
        ' cod_inc_trib,'
      '       cast(null as integer) as dadofiscal'
      ''
      'from piscofins_f100'
      'where periodo = :MesAno'
      '  and documentopag is null  /* n'#227'o gerada pelo contas a pagar */'
      '  and ind_oper  = 1 /* sa'#237'das */'
      ''
      ') as piscofins'
      ') as piscofins'
      '     left join piscofins_t435 t435'
      '     on piscofins.CCS435 = t435.codigo'
      ') as piscofins'
      
        'group by tipocontribuicao, CCS435, descricaot435, especie, data,' +
        ' serie, numero, dadofiscal, filial, codigofiscal,'
      
        '        valortotal, codigofiscal, piscst, pisaliquota, cofinscst' +
        ', aliquotacofins, cod_inc_trib'
      ''
      
        'order by tipocontribuicao, CCS435, descricaot435, especie, data,' +
        ' serie, numero'
      ') as piscofins'
      ''
      '  left join'
      ''
      ''
      '('
      
        'select dadofiscal, sum(ValorTotal) as ValorTotal, sum(cofins) as' +
        ' cofins, sum(pis) as pis'
      'from'
      '('
      ''
      ' SELECT dadofiscal,'
      
        '        sum((TRUNC(ValorVencto,     2) + TRUNC(COFINSProporciona' +
        'l,2) +'
      
        '             TRUNC(CSLLProporcional,2) + TRUNC(INSSProporcional,' +
        '  2) +'
      
        '             TRUNC(IRRFProporcional,2) + TRUNC(ISSProporcional, ' +
        '  2) +'
      
        '                                    TRUNC(PISProporcional,   2))' +
        ') AS ValorTotal,'
      ''
      '        sum(TRUNC(COFINS,2)) AS COFINS,'
      '        sum(TRUNC(PIS, 2)) AS PIS'
      ' FROM'
      ' ('
      '       SELECT df.numero as dadofiscal,'
      '              vdf.ValorVencto,'
      ''
      
        '             (vdf.ValorVencto * COALESCE(df.COFINSRetido, 0)) / ' +
        '(df.ValorTotal -'
      
        '                    (COALESCE(df.COFINSRetido, 0) + COALESCE(df.' +
        'CSLLRetido, 0) +'
      
        '                     COALESCE(df.INSSRetido,   0) + COALESCE(df.' +
        'IRRetido,   0) +'
      
        '                     COALESCE(df.ISSRetido,    0) + COALESCE(df.' +
        'PISRetido,  0)))'
      
        '                                                          AS COF' +
        'INSProporcional,'
      ''
      
        '             (vdf.ValorVencto * COALESCE(df.CSLLRetido, 0)) / (d' +
        'f.ValorTotal -'
      
        '                    (COALESCE(df.COFINSRetido, 0) + COALESCE(df.' +
        'CSLLRetido, 0) +'
      
        '                     COALESCE(df.INSSRetido,   0) + COALESCE(df.' +
        'IRRetido,   0) +'
      
        '                     COALESCE(df.ISSRetido,    0) + COALESCE(df.' +
        'PISRetido,  0)))'
      
        '                                                            AS C' +
        'SLLProporcional,'
      ''
      
        '             (vdf.ValorVencto * COALESCE(df.INSSRetido, 0)) / (d' +
        'f.ValorTotal -'
      
        '                    (COALESCE(df.COFINSRetido, 0) + COALESCE(df.' +
        'CSLLRetido, 0) +'
      
        '                     COALESCE(df.INSSRetido,   0) + COALESCE(df.' +
        'IRRetido,   0) +'
      
        '                     COALESCE(df.ISSRetido,    0) + COALESCE(df.' +
        'PISRetido,  0)))'
      
        '                                                            AS I' +
        'NSSProporcional,'
      ''
      
        '             (vdf.ValorVencto * COALESCE(df.IRRetido, 0)) / (df.' +
        'ValorTotal -'
      
        '                    (COALESCE(df.COFINSRetido, 0) + COALESCE(df.' +
        'CSLLRetido, 0) +'
      
        '                     COALESCE(df.INSSRetido,   0) + COALESCE(df.' +
        'IRRetido,   0) +'
      
        '                     COALESCE(df.ISSRetido,    0) + COALESCE(df.' +
        'PISRetido,  0)))'
      
        '                                                            AS I' +
        'RRFProporcional,'
      ''
      
        '              (vdf.ValorVencto * COALESCE(df.ISSRetido, 0)) / (d' +
        'f.ValorTotal -'
      
        '                    (COALESCE(df.COFINSRetido, 0) + COALESCE(df.' +
        'CSLLRetido, 0) +'
      
        '                     COALESCE(df.INSSRetido,   0) + COALESCE(df.' +
        'IRRetido,   0) +'
      
        '                     COALESCE(df.ISSRetido,    0) + COALESCE(df.' +
        'PISRetido,  0)))'
      
        '                                                             AS ' +
        'ISSProporcional,'
      ''
      
        '              (vdf.ValorVencto * COALESCE(df.PISRetido, 0)) / (d' +
        'f.ValorTotal -'
      
        '                    (COALESCE(df.COFINSRetido, 0) + COALESCE(df.' +
        'CSLLRetido, 0) +'
      
        '                     COALESCE(df.INSSRetido,   0) + COALESCE(df.' +
        'IRRetido,   0) +'
      
        '                     COALESCE(df.ISSRetido,    0) + COALESCE(df.' +
        'PISRetido,  0)))'
      
        '                                                             AS ' +
        'PISProporcional,'
      ''
      '               CASE WHEN (SELECT Regime'
      '                             FROM ImpostosRetidos'
      
        '                             WHERE Descricao = '#39'COFINS'#39') = '#39'CAIX' +
        'A'#39
      
        '                    THEN  (vdf.ValorVencto * COALESCE(df.COFINSR' +
        'etido, 0)) / (df.ValorTotal -'
      
        '                                  (COALESCE(df.COFINSRetido, 0) ' +
        '+ COALESCE(df.CSLLRetido, 0) +'
      
        '                                   COALESCE(df.INSSRetido,   0) ' +
        '+ COALESCE(df.IRRetido,   0) +'
      
        '                                   COALESCE(df.ISSRetido,    0) ' +
        '+ COALESCE(df.PISRetido,  0)))'
      '                    ELSE 0'
      '               END AS COFINS,'
      ''
      '               CASE WHEN (SELECT Regime'
      '                             FROM ImpostosRetidos'
      '                             WHERE Descricao = '#39'PIS'#39') = '#39'CAIXA'#39
      
        '                    THEN (vdf.ValorVencto * COALESCE(df.PISRetid' +
        'o, 0)) / (df.ValorTotal -'
      
        '                             (COALESCE(df.COFINSRetido, 0) + COA' +
        'LESCE(df.CSLLRetido, 0) +'
      
        '                              COALESCE(df.INSSRetido,   0) + COA' +
        'LESCE(df.IRRetido,   0) +'
      
        '                              COALESCE(df.ISSRetido,    0) + COA' +
        'LESCE(df.PISRetido,  0)))'
      '                    ELSE 0'
      '               END AS PIS'
      ''
      '       FROM Parcelas p'
      '            JOIN Contratos ct'
      '                  JOIN DadosFiscais df'
      '                       JOIN vfornecedores vf'
      
        '                       on df.cliente = vf.codigo and df.tipoclie' +
        'nte = vf.tipo'
      '                       JOIN Notas n'
      '                       ON n.DadoFiscal = df.Numero'
      '                  ON df.Contrato = ct.Numero'
      '            ON p.Contrato = ct.Numero,'
      ''
      '            VenctosDadosFiscais vdf'
      ''
      '       WHERE vdf.DadoFiscal = df.Numero'
      '         AND vdf.Numero = p.Numero'
      '         AND to_char(p.Datapagto, '#39'MM/YYYY'#39')=:MesAno'
      '         AND df.Situacao = '#39'N'#39
      '         AND (((COALESCE(df.COFINSRetido, 0) <> 0) AND'
      '               (SELECT Regime'
      '                   FROM ImpostosRetidos'
      '                   WHERE Descricao = '#39'COFINS'#39') = '#39'CAIXA'#39') OR'
      ''
      '              ((COALESCE(df.PISRetido, 0) <> 0) AND'
      '               (SELECT Regime'
      '                   FROM ImpostosRetidos'
      '                   WHERE Descricao = '#39'PIS'#39') = '#39'CAIXA'#39'))'
      ''
      '      and (df.filialemissao = :filialconsolidadora  or'
      '           df.filialemissao in (select f.codigo'
      '                         from filiais f'
      
        '                         where f.filialconsolidadoradime = :fili' +
        'alconsolidadora'
      
        '                         and (f.sped_pis_cofins or f.sped_pis_co' +
        'fins_rb or f.sped_pis_cofins_rem)))'
      ''
      '       ORDER BY p.Datapagto, n.Serie, n.Numero'
      ' ) AS Pagamentos'
      '  group by dadofiscal'
      ' '
      '  UNION ALL'
      ''
      
        '  select dadofiscal, sum(valortotal) as valortotal, sum(cofins) ' +
        'as cofins, sum(pis) as pis'
      '  from'
      ''
      '  ('
      '    SELECT df.numero as dadofiscal,'
      '        df.ValorTotal,'
      ''
      '        CASE WHEN (SELECT Regime'
      '                      FROM ImpostosRetidos'
      
        '                      WHERE Descricao = '#39'COFINS'#39') = '#39'COMPET'#202'NCIA' +
        #39
      '             THEN COALESCE(df.COFINSRetido, 0)'
      '             ELSE 0'
      '        END AS COFINS,'
      ''
      ''
      '        CASE WHEN (SELECT Regime'
      '                      FROM ImpostosRetidos'
      '                      WHERE Descricao = '#39'PIS'#39') = '#39'COMPET'#202'NCIA'#39
      '             THEN COALESCE(df.PISRetido, 0)'
      '             ELSE 0'
      '        END AS PIS'
      ''
      ' FROM DadosFiscais df'
      '      JOIN vfornecedores vf'
      '      on df.cliente = vf.codigo and df.tipocliente = vf.tipo'
      ''
      '      JOIN Notas n'
      '      ON n.DadoFiscal = df.Numero'
      ''
      ' WHERE to_char(df.data, '#39'MM/YYYY'#39')=:MesAno'
      '   AND df.Situacao = '#39'N'#39
      '   AND (((COALESCE(df.COFINSRetido, 0) <> 0) AND'
      '         (SELECT Regime'
      '             FROM ImpostosRetidos'
      '             WHERE Descricao = '#39'COFINS'#39') = '#39'COMPET'#202'NCIA'#39') OR'
      ''
      '        ((COALESCE(df.PISRetido, 0) <> 0) AND'
      '         (SELECT Regime'
      '             FROM ImpostosRetidos'
      '             WHERE Descricao = '#39'PIS'#39') = '#39'COMPET'#202'NCIA'#39'))'
      ''
      '  and (df.filialemissao = :filialConsolidadora  or'
      '       df.filialemissao in (select f.codigo'
      '                     from filiais f'
      
        '                     where f.filialconsolidadoradime = :filialCo' +
        'nsolidadora'
      
        '                     and (f.sped_pis_cofins or f.sped_pis_cofins' +
        '_rb or f.sped_pis_cofins_rem)))'
      ''
      ''
      ' ORDER BY df.Data, n.Serie, n.Numero'
      ') as T2'
      '  GROUP BY dadofiscal'
      ') as piscofins'
      'GROUP BY dadofiscal'
      'ORDER BY dadofiscal'
      ') as retencoes'
      ''
      'on piscofins.dadofiscal = retencoes.dadofiscal'
      ''
      
        'order by tipocontribuicao, ccs435, descricaot435, especie, data,' +
        ' filial, serie, numero, codigofiscal'
      ''
      '')
    RequestLive = False
    Left = 200
    Top = 24
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'filialconsolidadora'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'MesAno'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NotasdeVenda'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NotasdeDevolucao_e'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NotasdeTransferencia_e'
        ParamType = ptUnknown
      end>
