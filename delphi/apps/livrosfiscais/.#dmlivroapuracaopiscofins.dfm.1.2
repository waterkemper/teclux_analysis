  object qryLivroApuracaoPISCofins_Creditos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      
        'select filialemissao, data, especie, serie, numero, modelodocto,' +
        ' valortotal, codigofiscal,'
      ''
      '       piscst,'
      '       sum(pisbasecalculo) as pisbasecalculo,'
      '       sum(pisvalor) as pisvalor,'
      '       pisaliquota,'
      ''
      #9'   cofinscst,'
      '       sum(cofinsbasecalculo) as cofinsbasecalculo,'
      '       sum(cofinsvalor) as cofinsvalor,'
      #9'   cofinsaliquota,'
      ''
      #9'   ctc436, descricaot437,'
      #9'   cbcc437, descricaot436'
      ''
      ''
      ''
      'from'
      '('
      'select piscofins.*,'
      
        '       coalesce(piscofins_t437.descricao,cast('#39'N'#195'O DEFINIDA'#39' as ' +
        'varchar(200))) as descricaot437,'
      
        '       coalesce(piscofins_t436.descricao,cast('#39'N'#195'O DEFINIDA'#39' as ' +
        'varchar(200))) as descricaot436'
      'from'
      '('
      'select piscofins.*,'
      #9'  case when (piscst = 50) and (cofinscst = 50) then'
      
        #9#9#9#9' case when (pisaliquota = 0.65) or (cofinsaliquota = 3) or  ' +
        '/* No Regime Cumulativo - PIS 0,65 e COFINS 3,00 */'
      
        #9#9#9#9#9#9'   (pisaliquota = 1.65) or (cofinsaliquota = 7.6) then  /*' +
        ' No Regime N'#195'O Cumulativo - PIS 1,65 e COFINS 7,6 */'
      
        #9#9#9#9'   101  /* 101 Cr'#233'dito vinculado '#224' receita tributada no merc' +
        'ado interno '#8211' Al'#237'quota B'#225'sica */'
      #9#9#9#9' else'
      
        #9#9#9#9'   102  /* 102 Cr'#233'dito vinculado '#224' receita tributada no merc' +
        'ado interno '#8211' Al'#237'quotas Diferenciadas */'
      ''
      
        #9#9#9#9' /*   103 Cr'#233'dito vinculado '#224' receita tributada no mercado i' +
        'nterno '#8211' Al'#237'quota por Unidade de Produto'
      
        #9#9#9#9#9'  104 Cr'#233'dito vinculado '#224' receita tributada no mercado inte' +
        'rno '#8211' Estoque de Abertura'
      
        #9#9#9#9#9'  105 Cr'#233'dito vinculado '#224' receita tributada no mercado inte' +
        'rno '#8211' Aquisi'#231#227'o Embalagens para revenda'
      
        #9#9#9#9#9'  106 Cr'#233'dito vinculado '#224' receita tributada no mercado inte' +
        'rno '#8211' Presumido da Agroind'#250'stria'
      
        #9#9#9#9#9'  108 Cr'#233'dito vinculado '#224' receita tributada no mercado inte' +
        'rno '#8211' Importa'#231#227'o'
      
        #9#9#9#9#9'  109 Cr'#233'dito vinculado '#224' receita tributada no mercado inte' +
        'rno '#8211' Atividade Imobili'#225'ria'
      
        #9#9#9#9#9'  199 Cr'#233'dito vinculado '#224' receita tributada no mercado inte' +
        'rno '#8211' Outros'
      #9#9#9#9' */'
      #9#9#9#9'  end'
      ''
      #9#9'  when (piscst = 51) and (cofinscst = 51) then'
      
        #9#9#9#9'  case when (pisaliquota = 0.65) or (cofinsaliquota = 3) or ' +
        ' /* No Regime Cumulativo - PIS 0,65 e COFINS 3,00 */'
      
        #9#9#9#9#9#9'   (pisaliquota = 1.65) or (cofinsaliquota = 7.6) then  /*' +
        ' No Regime N'#195'O Cumulativo - PIS 1,65 e COFINS 7,6 */'
      
        #9#9#9#9#9'201  /* 201 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no me' +
        'rcado interno '#8211' Al'#237'quota B'#225'sica */'
      #9#9#9#9'  else'
      
        #9#9#9#9#9'202  /* 202 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no me' +
        'rcado interno '#8211' Al'#237'quotas Diferenciadas */'
      ''
      
        #9#9#9#9' /*   203 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no merca' +
        'do interno '#8211' Al'#237'quota por Unidade de Produto'
      
        #9#9#9#9#9'  204 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no mercado ' +
        'interno '#8211' Estoque de Abertura'
      
        #9#9#9#9#9'  205 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no mercado ' +
        'interno '#8211' Aquisi'#231#227'o Embalagens para revenda'
      
        #9#9#9#9#9'  206 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no mercado ' +
        'interno '#8211' Presumido da Agroind'#250'stria'
      
        #9#9#9#9#9'  208 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no mercado ' +
        'interno '#8211' Importa'#231#227'o'
      
        #9#9#9#9#9'  299 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no mercado ' +
        'interno '#8211' Outros  */'
      #9#9#9#9'  end'
      ''
      ''
      #9#9'  when (piscst = 52) and (cofinscst = 52) then'
      
        #9#9#9#9'  case when (pisaliquota = 0.65) or (cofinsaliquota = 3) or ' +
        ' /* No Regime Cumulativo - PIS 0,65 e COFINS 3,00 */'
      
        #9#9#9#9#9#9'   (pisaliquota = 1.65) or (cofinsaliquota = 7.6) then  /*' +
        ' No Regime N'#195'O Cumulativo - PIS 1,65 e COFINS 7,6 */'
      
        #9#9#9#9#9'301  /* 201 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no me' +
        'rcado interno '#8211' Al'#237'quota B'#225'sica */'
      #9#9#9#9'  else'
      
        #9#9#9#9#9'302  /* 202 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no me' +
        'rcado interno '#8211' Al'#237'quotas Diferenciadas */'
      ''
      
        #9#9#9#9' /*   303 Cr'#233'dito vinculado '#224' receita de exporta'#231#227'o '#8211' Al'#237'quo' +
        'ta por Unidade de Produto'
      
        #9#9#9#9#9'  304 Cr'#233'dito vinculado '#224' receita de exporta'#231#227'o '#8211' Estoque d' +
        'e Abertura'
      
        #9#9#9#9#9'  305 Cr'#233'dito vinculado '#224' receita de exporta'#231#227'o '#8211' Aquisi'#231#227'o' +
        ' Embalagens para revenda'
      
        #9#9#9#9#9'  306 Cr'#233'dito vinculado '#224' receita de exporta'#231#227'o '#8211' Presumido' +
        ' da Agroind'#250'stria'
      
        #9#9#9#9#9'  308 Cr'#233'dito vinculado '#224' receita de exporta'#231#227'o '#8211' Importa'#231#227 +
        'o'
      
        #9#9#9#9#9'  399 Cr'#233'dito vinculado '#224' receita de exporta'#231#227'o '#8211' Outros  *' +
        '/'
      #9#9#9#9'  end'
      ''
      #9#9'  else'
      
        #9#9#9'cast(null as integer) /* FALTA MAPEAR O RESTANTE DOS C'#211'DIGOS ' +
        '*/'
      #9'  end as ctc436,'
      ''
      
        '      case when piscofins.piscst in ('#39'50'#39','#39'51'#39','#39'52'#39','#39'53'#39','#39'54'#39','#39'5' +
        '5'#39','#39'56'#39','#39'60'#39','#39'61'#39','#39'62'#39','#39'63'#39','#39'64'#39','#39'65'#39','#39'66'#39') and'
      
        '                piscofins.cofinscst in ('#39'50'#39','#39'51'#39','#39'52'#39','#39'53'#39','#39'54'#39 +
        ','#39'55'#39','#39'56'#39','#39'60'#39','#39'61'#39','#39'62'#39','#39'63'#39','#39'64'#39','#39'65'#39','#39'66'#39') and'
      '                nat_bc_cred is null then'
      ''
      
        '         case when (mod(piscofins.codigofiscal,1000) in (126,653' +
        ',556) or'
      
        '                    piscofins.modelodocto in ('#39'02'#39','#39'2D'#39','#39'2E'#39','#39'59' +
        #39')) then cast('#39'02'#39' as varchar(2)) /* Aquisi'#231#227'o de bens utilizado' +
        's como insumo */'
      
        '              when mod(piscofins.codigofiscal,1000) in (411,202)' +
        ' then cast('#39'12'#39' as varchar(2)) /* Devolu'#231#227'o de Vendas Sujeitas '#224 +
        ' Incid'#234'ncia N'#227'o-Cumulativa */'
      
        '              when piscofins.modelodocto in ('#39'06'#39','#39'28'#39', '#39'29'#39') th' +
        'en cast('#39'04'#39' as varchar(2)) /* Energia el'#233'trica e t'#233'rmica, inclu' +
        'sive sob a forma de vapor */'
      
        '              when piscofins.modelodocto in ('#39'07'#39','#39'08'#39','#39'8B'#39','#39'09'#39 +
        ','#39'10'#39','#39'11'#39','#39'26'#39','#39'27'#39','#39'57'#39') then cast('#39'14'#39' as varchar(2)) /* Ativ' +
        'idade de Transporte de Cargas  Subcontrata'#231#227'o */'
      
        '              when piscofins.modelodocto in ('#39'21'#39','#39'22'#39') then cas' +
        't('#39'03'#39' as varchar(2)) /*  Aquisi'#231#227'o de servi'#231'os utilizados como ' +
        'insumo */'
      
        '         else cast('#39'01'#39' as varchar(2)) end /* Aquisi'#231#227'o de bens ' +
        'para revenda */'
      ''
      '       else'
      
        '         case when nat_bc_cred is not null then nat_bc_cred else' +
        ' cast(null as varchar(2)) end'
      '       end as cbcc437'
      'from'
      '('
      'select np.filial as filialemissao,'
      '       np.data,'
      '       cast('#39'NOTAS FISCAIS'#39' as varchar(15)) as especie,'
      #9'   np.serie,'
      #9'   np.numero,'
      #9'   np.modelodocto,'
      #9'   np.valornota as valortotal,'
      #9'   pnp.codigofiscal,'
      ''
      #9'   pnp.piscst,'
      #9'   pnp.PISBaseCalculo,'
      #9'   pnp.pisvalor,'
      '       pnp.pisaliquota,'
      ''
      #9'   pnp.cofinscst,'
      '       pnp.cofinsbasecalculo,'
      '       pnp.cofinsvalor,'
      #9'   pnp.cofinsaliquota,'
      #9'   cast(null as varchar(2)) as nat_bc_cred'
      ''
      'from notaspag np'
      '     join produtosnotaspag pnp'
      '     on np.codigo = pnp.codigonota'
      'where np.codigo = pnp.codigonota'
      '  and to_char(cast(np.data as date), '#39'MM/YYYY'#39')= :MesAno'
      ''
      '/* C1170 -> '#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39
      '   C396 -> '#39'02'#39','#39'2D'#39','#39'2E'#39','#39'59'#39
      '   C501 -> '#39'06'#39','#39'28'#39', '#39'29'#39
      '   D101 -> '#39'07'#39','#39'08'#39','#39'8B'#39','#39'09'#39','#39'10'#39','#39'11'#39','#39'26'#39','#39'27'#39','#39'57'#39
      '   D501 -> '#39'21'#39','#39'22'#39' */'
      ''
      '  and (np.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39') or'
      '       np.modelodocto in ('#39'02'#39','#39'2D'#39','#39'2E'#39','#39'59'#39') or'
      '       np.modelodocto in ('#39'06'#39','#39'28'#39', '#39'29'#39') or'
      
