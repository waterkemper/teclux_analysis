  object qryLivroApuracaoPISCofins_Creditos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      
        'select filialemissao, data, especie, serie, numero, modelodocto,' +
        ' valortotal, codigofiscal,'
      ''
      '       piscst,'
      '       sum(pisbasecalculo) as pisbasecalculo,'
      '       sum(pisvalor) as pisvalor,'
      '       pisaliquota,'
      ''
      #9'   cofinscst,'
      '       sum(cofinsbasecalculo) as cofinsbasecalculo,'
      '       sum(cofinsvalor) as cofinsvalor,'
      #9'   cofinsaliquota,'
      ''
      #9'   ctc436, descricaot437,'
      #9'   cbcc437, descricaot436'
      ''
      'from'
      '('
      'select piscofins.*,'
      ''
      ''
      
        '       case when especie in ('#39'DESCONTOS RECEBIDOS'#39', '#39'AJ. ACRESC.' +
        ' COFINS LANCTO MAN'#39', '#39'AJ. ACRESC. PIS LANCTO MANUAL'#39','
      
        '                             '#39'AJ. REDU'#199#195'O COFINS LANCTO MAN'#39', '#39'A' +
        'J. REDU'#199#195'O PIS LANCTO MANUAL'#39', '#39'AJ. REDU'#199#195'O NF DEV COMPRAS'#39') the' +
        'n'
      '         cast('#39'Ajustes'#39' as varchar(200))'
      
        '       else coalesce(piscofins_t437.descricao, cast('#39'SEM OCORR'#202'N' +
        'CIA DE CR'#201'DITO'#39' as varchar(200))) end as descricaot437,'
      ''
      
        '       case when especie in ('#39'DESCONTOS RECEBIDOS'#39', '#39'AJ. ACRESC.' +
        ' COFINS LANCTO MAN'#39', '#39'AJ. ACRESC. PIS LANCTO MANUAL'#39','
      
        '                             '#39'AJ. REDU'#199#195'O COFINS LANCTO MAN'#39', '#39'A' +
        'J. REDU'#199#195'O PIS LANCTO MANUAL'#39', '#39'AJ. REDU'#199#195'O NF DEV COMPRAS'#39') the' +
        'n'
      '         cast('#39'Ajustes de Redu'#231#227'o/Acr'#233'scimos'#39' as varchar(200))'
      
        '       else coalesce(piscofins_t436.descricao, cast('#39'SEM OCORR'#202'N' +
        'CIA DE CR'#201'DITO'#39' as varchar(200))) end as descricaot436'
      'from'
      '('
      'select piscofins.*,'
      ''
      #9'  case when piscst = '#39'50'#39' and'
      '              cofinscst = '#39'50'#39' and'
      
        '              especie not in ('#39'DESCONTOS RECEBIDOS'#39', '#39'AJ. ACRESC' +
        '. COFINS LANCTO MAN'#39', '#39'AJ. ACRESC. PIS LANCTO MANUAL'#39','
      
        '                                        '#39'AJ. REDU'#199#195'O COFINS LANC' +
        'TO MAN'#39', '#39'AJ. REDU'#199#195'O PIS LANCTO MANUAL'#39', '#39'AJ. REDU'#199#195'O NF DEV CO' +
        'MPRAS'#39') then'
      ''
      
        #9#9#9#9' case when (pisaliquota = 0.65) or (cofinsaliquota = 3) or  ' +
        '/* No Regime Cumulativo - PIS 0,65 e COFINS 3,00 */'
      
        #9#9#9#9#9#9'   (pisaliquota = 1.65) or (cofinsaliquota = 7.6) then  /*' +
        ' No Regime N'#195'O Cumulativo - PIS 1,65 e COFINS 7,6 */'
      
        #9#9#9#9'   101  /* 101 Cr'#233'dito vinculado '#224' receita tributada no merc' +
        'ado interno '#8211' Al'#237'quota B'#225'sica */'
      #9#9#9#9' else'
      
        #9#9#9#9'   102  /* 102 Cr'#233'dito vinculado '#224' receita tributada no merc' +
        'ado interno '#8211' Al'#237'quotas Diferenciadas */'
      ''
      
        #9#9#9#9' /*   103 Cr'#233'dito vinculado '#224' receita tributada no mercado i' +
        'nterno '#8211' Al'#237'quota por Unidade de Produto'
      
        #9#9#9#9#9'  104 Cr'#233'dito vinculado '#224' receita tributada no mercado inte' +
        'rno '#8211' Estoque de Abertura'
      
        #9#9#9#9#9'  105 Cr'#233'dito vinculado '#224' receita tributada no mercado inte' +
        'rno '#8211' Aquisi'#231#227'o Embalagens para revenda'
      
        #9#9#9#9#9'  106 Cr'#233'dito vinculado '#224' receita tributada no mercado inte' +
        'rno '#8211' Presumido da Agroind'#250'stria'
      
        #9#9#9#9#9'  108 Cr'#233'dito vinculado '#224' receita tributada no mercado inte' +
        'rno '#8211' Importa'#231#227'o'
      
        #9#9#9#9#9'  109 Cr'#233'dito vinculado '#224' receita tributada no mercado inte' +
        'rno '#8211' Atividade Imobili'#225'ria'
      
        #9#9#9#9#9'  199 Cr'#233'dito vinculado '#224' receita tributada no mercado inte' +
        'rno '#8211' Outros'
      #9#9#9#9' */'
      #9#9#9#9'  end'
      ''
      #9#9'  when piscst = '#39'51'#39' and'
      '           cofinscst = '#39'51'#39' and'
      
        '           especie not in ('#39'DESCONTOS RECEBIDOS'#39', '#39'AJ. ACRESC. C' +
        'OFINS LANCTO MAN'#39', '#39'AJ. ACRESC. PIS LANCTO MANUAL'#39','
      
        '                                        '#39'AJ. REDU'#199#195'O COFINS LANC' +
        'TO MAN'#39', '#39'AJ. REDU'#199#195'O PIS LANCTO MANUAL'#39', '#39'AJ. REDU'#199#195'O NF DEV CO' +
        'MPRAS'#39') then'
      ''
      
        #9#9#9#9'  case when (pisaliquota = 0.65) or (cofinsaliquota = 3) or ' +
        ' /* No Regime Cumulativo - PIS 0,65 e COFINS 3,00 */'
      
        #9#9#9#9#9#9'   (pisaliquota = 1.65) or (cofinsaliquota = 7.6) then  /*' +
        ' No Regime N'#195'O Cumulativo - PIS 1,65 e COFINS 7,6 */'
      
        #9#9#9#9#9'201  /* 201 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no me' +
        'rcado interno '#8211' Al'#237'quota B'#225'sica */'
      #9#9#9#9'  else'
      
        #9#9#9#9#9'202  /* 202 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no me' +
        'rcado interno '#8211' Al'#237'quotas Diferenciadas */'
      ''
      
        #9#9#9#9' /*   203 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no merca' +
        'do interno '#8211' Al'#237'quota por Unidade de Produto'
      
        #9#9#9#9#9'  204 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no mercado ' +
        'interno '#8211' Estoque de Abertura'
      
        #9#9#9#9#9'  205 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no mercado ' +
        'interno '#8211' Aquisi'#231#227'o Embalagens para revenda'
      
        #9#9#9#9#9'  206 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no mercado ' +
        'interno '#8211' Presumido da Agroind'#250'stria'
      
        #9#9#9#9#9'  208 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no mercado ' +
        'interno '#8211' Importa'#231#227'o'
      
        #9#9#9#9#9'  299 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no mercado ' +
        'interno '#8211' Outros  */'
      #9#9#9#9'  end'
      ''
      ''
      #9#9'  when piscst = '#39'52'#39' and'
      '           cofinscst = '#39'52'#39' and'
      
        '           especie not in ('#39'DESCONTOS RECEBIDOS'#39', '#39'AJ. ACRESC. C' +
        'OFINS LANCTO MAN'#39', '#39'AJ. ACRESC. PIS LANCTO MANUAL'#39','
      
        '                                        '#39'AJ. REDU'#199#195'O COFINS LANC' +
        'TO MAN'#39', '#39'AJ. REDU'#199#195'O PIS LANCTO MANUAL'#39', '#39'AJ. REDU'#199#195'O NF DEV CO' +
        'MPRAS'#39') then'
      ''
      
        #9#9#9#9'  case when (pisaliquota = 0.65) or (cofinsaliquota = 3) or ' +
        ' /* No Regime Cumulativo - PIS 0,65 e COFINS 3,00 */'
      
        #9#9#9#9#9#9'   (pisaliquota = 1.65) or (cofinsaliquota = 7.6) then  /*' +
        ' No Regime N'#195'O Cumulativo - PIS 1,65 e COFINS 7,6 */'
      
        #9#9#9#9#9'301  /* 201 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no me' +
        'rcado interno '#8211' Al'#237'quota B'#225'sica */'
      #9#9#9#9'  else'
      
        #9#9#9#9#9'302  /* 202 Cr'#233'dito vinculado '#224' receita n'#227'o tributada no me' +
        'rcado interno '#8211' Al'#237'quotas Diferenciadas */'
      ''
      
        #9#9#9#9' /*   303 Cr'#233'dito vinculado '#224' receita de exporta'#231#227'o '#8211' Al'#237'quo' +
        'ta por Unidade de Produto'
      
        #9#9#9#9#9'  304 Cr'#233'dito vinculado '#224' receita de exporta'#231#227'o '#8211' Estoque d' +
        'e Abertura'
      
        #9#9#9#9#9'  305 Cr'#233'dito vinculado '#224' receita de exporta'#231#227'o '#8211' Aquisi'#231#227'o' +
