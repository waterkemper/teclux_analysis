      ' ('
      '  ('
      '  '
      '  SELECT grupofilial,'
      '         nomegrupofilial,'
      '         filialemissao, '
      '         nomefilial, '
      '         codigofiscal, '
      '         sum(base+isentas+outras) as valortotal,'
