      '   SELECT grupofilial,'
      '          nomegrupofilial,'
      '          filialemissao,'
      '          nomefilial,'
      '          situacao,'
      
        '          cast(cast(filial as varchar)||cast(maquina as varchar)' +
        '||cast(intervensao as varchar)||cast(numeroinicial as varchar)||' +
        'cast(numerofinal as varchar)||cast(data as varchar)||situacao/*|' +
        '|estadocfo*/ as varchar) as numero,'
      '          cast(null as varchar(2)) as estadocfo,'
      '/*          estadocfo,*/'
      '          valortotal,'
