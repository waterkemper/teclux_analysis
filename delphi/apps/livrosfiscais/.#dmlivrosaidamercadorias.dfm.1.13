  object qryDadosFiscaisNotas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryDadosFiscaisNotasCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'FiltroFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroSeries'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroIncluirNFCopiaECF'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'SELECT'
      '  df.situacao,'
      '  df.numero as dadofiscal,'
      '  df.estadocfo,'
      ''
      '  case when df.situacao='#39'N'#39' then'
      '       case when :ExisteFiltroCodigo then'
      '        (select sum(cdf.base+cdf.isentas+cdf.outras)'
      '         from calculosdadosfiscais_(df.numero) cdf'
      '         Where cdf.dadofiscal = df.numero'
      '              and cdf.tipo='#39'M'#39
      '              and df.situacao='#39'N'#39
      '              and cdf.codigofiscal not in (5933,6933,7933)  '
      
        '              and cdf.codigofiscal between (:CodigoFiscalInicial' +
        ') and (:CodigoFiscalFinal)'
      '        )'
      '       else df.valortotal'
      '       end'
      '  else 0'
      '  end as valortotal,'
      ''
      '  n.serie,'
      '  n.numero as numeroinicial,'
      '  n.numero as numerofinal,'
      '  n.filial,'
      '  df.data,'
      ''
      '  (select sum(cdf.base+cdf.isentas+cdf.outras)'
      '   from calculosdadosfiscais_(df.numero) cdf'
      '   Where cdf.dadofiscal = df.numero'
      '        and cdf.tipo='#39'M'#39
      '        and df.situacao='#39'N'#39') as valortotal_icms,'
      ''
      '  (select sum(cdf.valor+cdf.base+cdf.isentas+cdf.outras)'
      '   from calculosdadosfiscais_(df.numero) cdf'
      '   Where cdf.dadofiscal = df.numero'
      '        and cdf.tipo='#39'P'#39
      '        and df.situacao='#39'N'#39') as valortotal_ipi,'
      ''
      
        '  /*substr(df.observacoes,0,strpos(df.observacoes,chr(13))) as o' +
        'bservacao,*/'
      '  cast(null as text) as observacao,'
      
        '  case when (select count(*)  from parcelas p Where p.contrato =' +
        ' df.contrato)=0 then '#39'OUTRAS'#39'  else'
      
        '   case when (select count(*) from parcelas p Where p.contrato= ' +
        'df.contrato and'
      
        '                                   p.datavencto > (select ct.dat' +
        'a from contratos ct where ct.numero=df.contrato))=0             ' +
        '       then '#39'A VISTA'#39'      else'
      
        '                                                                ' +
        '                                                                ' +
        '                                                            '#39'A P' +
        'RAZO'#39'    end'
      '  end as Operacao'
      ''
      'FROM dadosfiscais df join notas n on df.numero = n.dadofiscal'
      'Where df.data between (:DataInicial) and (:DataFinal)'
      '     /* and df.codigofiscal not in (5933,6933,7933) */ '
      '      and exists (select cdf.codigofiscal'
      '                  from calculosdadosfiscais_(df.numero) cdf'
      '                  where cdf.dadofiscal = df.numero'
      
        '                    and cdf.codigofiscal between (:CodigoFiscalI' +
        'nicial) and (:CodigoFiscalFinal) limit 1)'
      '%FiltroFiliais'
      '%FiltroSeries'
      '%FiltroIncluirNFCopiaECF'
      ''
      'ORDER BY df.Data, n.Serie, n.numero'
      '')
    RequestLive = False
    Left = 456
    Top = 23
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'ExisteFiltroCodigo'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'CodigoFiscalInicial'
        ParamType = ptUnknown
        Value = '0'
      end
      item
        DataType = ftString
        Name = 'CodigoFiscalFinal'
        ParamType = ptUnknown
        Value = '999999'
      end
      item
        DataType = ftString
        Name = 'DataInicial'
        ParamType = ptUnknown
        Value = #39'2008-12-01'#39
      end
      item
        DataType = ftString
        Name = 'DataFinal'
        ParamType = ptUnknown
        Value = #39'2008-12-15'#39
      end>
    object qryDadosFiscaisNotassituacao: TStringField
      FieldName = 'situacao'
      Size = 1
    end
    object qryDadosFiscaisNotasdadofiscal: TIntegerField
      FieldName = 'dadofiscal'
      DisplayFormat = '0'
    end
    object qryDadosFiscaisNotasestadocfo: TStringField
      FieldName = 'estadocfo'
      Size = 2
    end
    object qryDadosFiscaisNotasvalortotal: TFloatField
      FieldName = 'valortotal'
      DisplayFormat = '0.00'
    end
    object qryDadosFiscaisNotasserie: TStringField
      FieldName = 'serie'
      Size = 3
    end
    object qryDadosFiscaisNotasnumeroinicial: TIntegerField
      FieldName = 'numeroinicial'
      DisplayFormat = '0'
    end
    object qryDadosFiscaisNotasnumerofinal: TIntegerField
      FieldName = 'numerofinal'
      DisplayFormat = '0'
    end
    object qryDadosFiscaisNotasfilial: TIntegerField
      FieldName = 'filial'
      DisplayFormat = '0'
    end
    object qryDadosFiscaisNotasdata: TDateField
      Alignment = taCenter
      FieldName = 'data'
      EditMask = '99/99/9999;1; '
    end
    object qryDadosFiscaisNotasvalortotal_icms: TFloatField
      FieldName = 'valortotal_icms'
      DisplayFormat = '0.00'
    end
    object qryDadosFiscaisNotasvalortotal_ipi: TFloatField
      FieldName = 'valortotal_ipi'
      DisplayFormat = '0.00'
    end
    object qryDadosFiscaisNotasdifvalortotal_icms: TBooleanField
      FieldKind = fkCalculated
      FieldName = 'difvalortotal_icms'
      Calculated = True
    end
    object qryDadosFiscaisNotasdifvalortotal_ipi: TBooleanField
      FieldKind = fkCalculated
      FieldName = 'difvalortotal_ipi'
      Calculated = True
    end
    object qryDadosFiscaisNotasoperacao: TMemoField
      FieldName = 'operacao'
      BlobType = ftMemo
    end
    object qryDadosFiscaisNotasobservacao: TMemoField
      FieldName = 'observacao'
      BlobType = ftMemo
    end
  end
  object qryDadosFiscaisNotas_ICMS: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkFields = 'dadofiscal=dadofiscal'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrDadosFiscaisNotas
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'FiltroFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroSeries'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroIncluirNFCopiaECF'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'select cdf.dadofiscal,'
      '       cdf.tipo,'
      '       cdf.aliquota,'
      '       cdf.codigofiscal,'
      '       sum(base) as base,'
      '       sum(valor) as valor'
      'from'
      '('
      '  select cdf.dadofiscal,'
      '         cast(1 as smallint) as tipo,'
      '         cdf.aliquota,'
      '         cdf.codigofiscal,'
      
        '         case when df.situacao='#39'N'#39' then cdf.base else 0 end as b' +
        'ase,'
      
        '         case when df.situacao='#39'N'#39' then cdf.valor else 0 end as ' +
        'valor'
      
        '  from (dadosfiscais df join (select * from calculosdadosfiscais' +
        '_(:DataInicial,:DataFinal)) cdf on df.numero=cdf.dadofiscal)'
      '                        join notas n on df.numero = n.dadofiscal'
      ''
      '  Where df.data between (:DataInicial) and (:DataFinal)'
      '    and cdf.tipo = '#39'M'#39
      '    and cdf.codigofiscal not in (5933,6933,7933) '
      
        '    and cdf.codigofiscal between (:CodigoFiscalInicial) and (:Co' +
        'digoFiscalFinal)'
      '    and (cdf.base<>0)'
      ''
      '    %FiltroFiliais'
      '    %FiltroSeries'
      '    %FiltroIncluirNFCopiaECF'
      ''
      '  union all'
      ''
      '  select cdf.dadofiscal,'
      '         cast(2 as smallint) as tipo,'
      '         cast(null as numeric(5,2)) as aliquota,'
      '         cdf.codigofiscal,'
      
        '         case when df.situacao='#39'N'#39' then cdf.isentas else 0 end a' +
        's base,'
      '         cast(null as numeric(11,2)) as valor'
      
        '  from (dadosfiscais df join (select * from calculosdadosfiscais' +
        '_(:DataInicial,:DataFinal)) cdf on df.numero=cdf.dadofiscal)'
      '                       join notas n on df.numero = n.dadofiscal'
      ''
      '  Where df.data between (:DataInicial) and (:DataFinal)'
      '    and cdf.tipo = '#39'M'#39
      '    and cdf.codigofiscal not in (5933,6933,7933) '
      
        '    and cdf.codigofiscal between (:CodigoFiscalInicial) and (:Co' +
        'digoFiscalFinal)'
      '    and (cdf.isentas<>0)'
      ''
      '    %FiltroFiliais'
      '    %FiltroSeries'
      '    %FiltroIncluirNFCopiaECF'
      ''
      '  union all'
      ''
      '  select cdf.dadofiscal,'
      '         cast(3 as smallint) as tipo,'
      '         cast(null as numeric(5,2)) as aliquota,'
      '         cdf.codigofiscal,'
      
        '         case when df.situacao='#39'N'#39' then cdf.outras else 0 end as' +
        ' base,'
      '         cast(null as numeric(11,2)) as valor'
      
        '  from (dadosfiscais df join (select * from calculosdadosfiscais' +
        '_(:DataInicial,:DataFinal)) cdf on df.numero=cdf.dadofiscal)'
      '                       join notas n on df.numero = n.dadofiscal'
      ''
      '  Where df.data between (:DataInicial) and (:DataFinal)'
      '    and cdf.tipo = '#39'M'#39
      '    and cdf.codigofiscal not in (5933,6933,7933) '
      
        '    and cdf.codigofiscal between (:CodigoFiscalInicial) and (:Co' +
        'digoFiscalFinal)'
      '    and (cdf.outras<>0)'
      ''
      '    %FiltroFiliais'
      '    %FiltroSeries'
      '    %FiltroIncluirNFCopiaECF'
      ''
      ') as cdf'
      ''
      
        'group by cdf.dadofiscal, cdf.tipo, cdf.aliquota, cdf.codigofisca' +
        'l'
      'order by cdf.dadofiscal, cdf.tipo')
