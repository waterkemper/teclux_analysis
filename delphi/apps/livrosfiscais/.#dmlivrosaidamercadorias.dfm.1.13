  object qryResumoSinteticoMapasECF: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'FiltroFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroSeries'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroIncluirNFCopiaECF'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'SELECT * FROM'
      '('
      'select temp.*,'
      '              CAST(titulo.codigo AS INTEGER) as titulo,'
      
        '              CAST(titulo.descricao AS VARCHAR) as descricaotitu' +
        'lo,'
      '              CAST( (select subtitulo.codigo'
      #9'            from codigosfiscais subtitulo'
      #9#9#9' where subtitulo.codigo<temp.codigofiscal'
      
        #9#9#9'   and tipo='#39'S'#39' order by subtitulo.codigo desc limit 1) AS IN' +
        'TEGER) as subtitulo,'
      '              CAST( (select subtitulo.descricao'
      #9'            from codigosfiscais subtitulo'
      #9#9#9' where subtitulo.codigo<temp.codigofiscal'
      
        #9#9#9'   and tipo='#39'S'#39' order by subtitulo.codigo desc limit 1) AS VA' +
        'RCHAR) as descricaosubtitulo'
      'from'
      '('
      ' SELECT CAST(grupofilial AS INTEGER) as grupofilial,'
      
        '              CAST(nomegrupofilial AS VARCHAR) as nomegrupofilia' +
        'l,'
      '              CAST(filialemissao AS INTEGER) as filial, '
      '              CAST(nomefilial AS VARCHAR) as nomefilial,'
      '              CAST(SUM(valortotal) AS NUMERIC) as valortotal, '
      '              CAST(SUM(base) AS NUMERIC) as base,'
      '              CAST(SUM(valor) AS NUMERIC) as valor,'
      '              CAST(SUM(isentas) AS NUMERIC) as isentas,'
      '              CAST(SUM(outras) AS NUMERIC) as outras,'
      '              CAST(codigofiscal AS INTEGER) as codigofiscal,'
      '              CAST(cf.descricao AS VARCHAR) as descricao'
      'FROM '
      ' ('
      '  ('
      '  '
      '  SELECT grupofilial,'
      '         nomegrupofilial,'
      '         filialemissao, '
      '         nomefilial, '
      '         codigofiscal, '
      '         sum(base+isentas+outras) as valortotal,'
      '         sum(base) as base,'
      '         sum(valor) as valor,'
      '         sum(isentas) as isentas, '
      '         sum(outras) as outras'
      '  FROM'
      '  ('
      '    ('
      '     SELECT'
      
        '      case When :AgruparGrupoFilial then fgf.grupo              ' +
        'else null end as grupofilial,'
      
        '      case When :AgruparGrupoFilial then gf.descricao         el' +
        'se null end as nomegrupofilial,'
      
        '      case When :AgruparFilial          then df.filialemissao   ' +
        '   else null end as filialemissao,'
      
        '      case When :AgruparFilial          then f.nome             ' +
        '    else null end as nomefilial,'
      '      df.codigofiscal,'
      
        '      case When df.CodigoFiscal in (5929,6929) then 0 else (case' +
        ' When df.situacao='#39'N'#39' then cdf.base else 0 end) end as base,'
      
        '      case When df.CodigoFiscal in (5929,6929) then 0 else (case' +
        ' When df.situacao='#39'N'#39' then cdf.valor else 0 end) end as valor,'
      
        '      case When df.CodigoFiscal in (5929,6929) then 0 else (case' +
        ' When df.situacao='#39'N'#39' then cdf.isentas else 0 end) end as isenta' +
        's,'
      '      case When df.situacao='#39'N'#39' then'
      '       (case When df.CodigoFiscal in (5929,6929) then'
      '         (cdf.base+cdf.isentas+cdf.outras)'
      '        else cdf.outras end) else 0 end as outras'
      '    '
      '    FROM (((dadosfiscais df '
      '             join (notas n '
      
        '                   left join cupons c on n.dadofiscalvinculado=c' +
        '.dadofiscal)'
      '             '
      '             on df.numero = n.dadofiscal)'
      '             '
      '             join calculosdadosfiscais cdf '
      '             on df.numero=cdf.dadofiscal)'
      '             '
      '             '
      '             '
      
        '             join (filiais f left join (filiaisgruposfiliais fgf' +
        ' left join gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                           on f.codigo=fgf.filial)'
      
        '                                                             on ' +
        'df.filialemissao=f.codigo)'
      '    '
      '    Where cdf.tipo='#39'M'#39
      '     /* and df.codigofiscal not in (5933,6933,7933) */ '
      '      and df.data between (:DataInicial) and (:DataFinal)  '
      '      and (exists (select cdf.codigofiscal'
      '                  from calculosdadosfiscais cdf'
      '                  where cdf.dadofiscal = df.numero'
      
        '                    and cdf.codigofiscal between (:CodigoFiscalI' +
        'nicial) and (:CodigoFiscalFinal) limit 1) or'
      
        '           df.codigofiscal between (:CodigoFiscalInicial) and (:' +
        'CodigoFiscalFinal))'
      ''
      ''
      '    %FiltroFiliais'
      '    %FiltroSeries'
      '    %FiltroIncluirNFCopiaECF'
      ''
      '    )'
      '    union all'
      '    ('
      '    SELECT'
      
        '      case When :AgruparGrupoFilial then fgf.grupo              ' +
        'else null end as grupofilial,'
      
        '      case When :AgruparGrupoFilial then gf.descricao         el' +
        'se null end as nomegrupofilial,'
      
        '      case When :AgruparFilial          then df.filialemissao   ' +
        '   else null end as filialemissao,'
      
        '      case When :AgruparFilial          then f.nome             ' +
        '    else null end as nomefilial,'
      
        '      cast(substring(cast(df.codigofiscal as varchar),1,1)||'#39'933' +
        #39' as integer) as codigofiscal,'
      '      0.00 as base,'
      '      0.00 as valor,'
      '      0.00 as isentas,'
      
        '      case When df.situacao='#39'N'#39' then cdf.base+cdf.isentas+cdf.ou' +
        'tras else 0 end as outras'
      ''
      '    FROM (((dadosfiscais df '
      '             join (notas n '
      
        '                   left join cupons c on n.dadofiscalvinculado=c' +
        '.dadofiscal)'
      '             on df.numero = n.dadofiscal)'
      
        '                                       join calculosdadosfiscais' +
        ' cdf on df.numero=cdf.dadofiscal)'
      '                                       '
      
        '                                       join (filiais f left join' +
        ' (filiaisgruposfiliais fgf left join gruposfiliais gf on fgf.gru' +
        'po=gf.codigo)'
      
        '                                                                ' +
        '                           on f.codigo=fgf.filial)'
      
        '                                                             on ' +
        'df.filialemissao=f.codigo)'
      '    Where cdf.tipo = '#39'S'#39
      '     and df.data between (:DataInicial) and (:DataFinal)'
      '     and ((exists (select cdf.codigofiscal'
      '                  from calculosdadosfiscais cdf'
      '                  where cdf.dadofiscal = df.numero'
      
        '                    and cdf.codigofiscal between (:CodigoFiscalI' +
        'nicial) and (:CodigoFiscalFinal) limit 1)) or'
      
        '           df.codigofiscal between (:CodigoFiscalInicial) and (:' +
        'CodigoFiscalFinal) or'
      '          (exists (select cdf.codigofiscal'
      '                  from calculosdadosfiscais cdf'
      '                  where cdf.dadofiscal = df.numero'
      
        '                    and cast(substring(cast(cdf.codigofiscal as ' +
        'varchar),1,1)||'#39'933'#39' as integer) between (:CodigoFiscalInicial) ' +
        'and (:CodigoFiscalFinal) limit 1)))'
      ''
      '    %FiltroFiliais'
      '    %FiltroSeries'
      '    %FiltroIncluirNFCopiaECF'
      ''
      '    )'
      '  ) as notascalculos'
      
        '    group by grupofilial, nomegrupofilial, filialemissao, nomefi' +
        'lial, codigofiscal'
      ' )'
      ''
      'union all'
      ''
      ' ('
      '   SELECT grupofilial,'
      '          nomegrupofilial,'
      '          filialemissao,'
      '          nomefilial,'
      '          codigofiscal,'
      '          sum(base+isentas+outras) as valortotal,'
      '          sum(base) as base,'
      '          sum(valor) as valor,'
      '          sum(isentas) as isentas,'
      '          sum(outras) as outras'
      '   FROM'
      '  ('
      '   ('
      '    SELECT'
      
        '      case When :AgruparGrupoFilial then fgf.grupo              ' +
        'else null end as grupofilial,'
      
        '      case When :AgruparGrupoFilial then gf.descricao         el' +
        'se null end as nomegrupofilial,'
      
        '      case When :AgruparFilial          then df.filialemissao   ' +
        '   else null end as filialemissao,'
      
        '      case When :AgruparFilial          then f.nome             ' +
        '    else null end as nomefilial,'
      '      df.codigofiscal,'
      '      0 as base,'
      '      0 as valor,'
      '      me.isento as isentas,'
      
        '      me.cancelamentos-(me.descontos+me.substituicao+me.naotribu' +
        'tado) as outras'
      
        '    FROM (((dadosfiscais df join cupons c on df.numero = c.dadof' +
        'iscal)'
      
        '                                      join mapasECF me on c.fili' +
        'al=me.filial and'
      
        '                                                                ' +
        '      c.maquina=me.maquina and'
      
        '                                                                ' +
        '      c.intervensao=me.intervensao and'
      
        '                                                                ' +
        '      df.data=me.data)'
      
        '                                       left join (filiais f left' +
        ' join (filiaisgruposfiliais fgf left join gruposfiliais gf on fg' +
        'f.grupo=gf.codigo)'
      
        '                                                                ' +
        '                           on f.codigo=fgf.filial)'
      
        '                                                             on ' +
        'df.filialemissao=f.codigo)'
      ''
      
        '    Where (select count(*) from MapasECFTributados met where  me' +
        't.filial=me.filial and'
      
        '                                                                ' +
        '                          met.maquina=me.maquina and'
      
        '                                                                ' +
        '                          met.intervensao=me.intervensao and'
      
        '                                                                ' +
        '                          met.data=me.data)>1 and'
      '     df.data between (:DataInicial) and (:DataFinal)'
      '       and (exists (select cdf.codigofiscal'
      '                   from calculosdadosfiscais cdf'
      '                   where cdf.dadofiscal = df.numero'
      
        '                     and cdf.codigofiscal between (:CodigoFiscal' +
        'Inicial) and (:CodigoFiscalFinal) limit 1) or'
      
        '            df.codigofiscal between (:CodigoFiscalInicial) and (' +
        ':CodigoFiscalFinal))'
      ''
      '      %FiltroFiliais'
      ''
      '    )'
      '    union'
      '    ('
      '    SELECT'
      
        '      case When :AgruparGrupoFilial then fgf.grupo              ' +
        'else null end as grupofilial,'
      
        '      case When :AgruparGrupoFilial then gf.descricao         el' +
        'se null end as nomegrupofilial,'
      
        '      case When :AgruparFilial          then df.filialemissao   ' +
        '   else null end as filialemissao,'
      
        '      case When :AgruparFilial          then f.nome             ' +
        '    else null end as nomefilial,'
      '      df.codigofiscal,'
      '      met.valor as base,'
      '      (met.valor*met.base)/100 as valor,'
      
        '      case when (select count(*) from MapasECFTributados met whe' +
        're met.filial=me.filial and'
      
        '                                                                ' +
        '                                  met.maquina=me.maquina and'
      
        '                                                                ' +
        '                                  met.intervensao=me.intervensao' +
        ' and'
      
        '                                                                ' +
        '                                  met.data=me.data)=1 then  me.i' +
        'sento else 0'
      '      end as isentas,'
      ''
      
        '      case when (select count(*) from MapasECFTributados met whe' +
        're met.filial=me.filial and'
      
        '                                                                ' +
        '                                  met.maquina=me.maquina and'
      
        '                                                                ' +
        '                                  met.intervensao=me.intervensao' +
        ' and'
      
        '                                                                ' +
        '                                  met.data=me.data)=1 then (me.d' +
        'escontos+me.substituicao+me.naotributado)-me.cancelamentos else ' +
        '0'
      '      end  as outras'
      
        '    FROM (((dadosfiscais df join cupons c on df.numero = c.dadof' +
        'iscal)'
      
        '                                      join (mapasECF me  left jo' +
        'in mapasECFTributados met on me.filial=met.filial and'
      
        '                                                                ' +
        '                                                       me.maquin' +
        'a=met.maquina and'
      
        '                                                                ' +
        '                                                       me.interv' +
        'ensao=met.intervensao and'
      
        '                                                                ' +
        '                                                       me.data=m' +
        'et.data)'
      
        '                                                                ' +
        '      on c.filial=me.filial and'
      
        '                                                                ' +
        '      c.maquina=me.maquina and'
      
        '                                                                ' +
        '      c.intervensao=me.intervensao and'
      
        '                                                                ' +
        '      df.data=me.data)'
      
        '                                       left join (filiais f left' +
        ' join (filiaisgruposfiliais fgf left join gruposfiliais gf on fg' +
        'f.grupo=gf.codigo)'
      
        '                                                                ' +
        '                           on f.codigo=fgf.filial)'
      
        '                                                             on ' +
        'df.filialemissao=f.codigo)'
      '    Where df.data between (:DataInicial) and (:DataFinal)'
      '       and (exists (select cdf.codigofiscal'
      '                   from calculosdadosfiscais cdf'
      '                   where cdf.dadofiscal = df.numero'
      
        '                     and cdf.codigofiscal between (:CodigoFiscal' +
        'Inicial) and (:CodigoFiscalFinal) limit 1) or'
      
        '            df.codigofiscal between (:CodigoFiscalInicial) and (' +
        ':CodigoFiscalFinal))'
      ''
      ''
      '      %FiltroFiliais'
      ''
      '    )'
      '   ) as mapasECFCalculos'
      
        '    group by grupofilial, nomegrupofilial, filialemissao, nomefi' +
        'lial, codigofiscal'
      ''
      ' )'
      
        ') as temp left join CodigosFiscais cf on temp.codigofiscal=cf.co' +
        'digo'
      
        'group by nomegrupofilial, grupofilial, nomefilial, filial, codig' +
        'ofiscal, cf.descricao'
      ') as temp'
      
        '              left join CodigosFiscais titulo on cast(substring(' +
        'cast(codigofiscal as varchar) from 1 for 1)||'#39'000'#39' as integer)=t' +
        'itulo.codigo'
      ') as rs'
      ''
      
        'ORDER BY upper(to_ascii(rs.NomeGrupoFilial,'#39'latin1'#39')), rs.GrupoF' +
        'ilial,'
      
        '         upper(to_ascii(rs.NomeFilial,'#39'latin1'#39')), rs.Filial, rs.' +
        'Titulo,'
      
        '         upper(to_ascii(rs.DescricaoTitulo,'#39'latin1'#39')), rs.Subtit' +
        'ulo,'
      
        '         upper(to_ascii(rs.DescricaoSubTitulo,'#39'latin1'#39')), rs.Cod' +
        'igoFiscal,'
      '         upper(to_ascii(rs.Descricao,'#39'latin1'#39'))'
      '')
    RequestLive = False
    Left = 120
    Top = 439
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'AgruparGrupoFilial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'AgruparFilial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataFinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CodigoFiscalInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CodigoFiscalFinal'
        ParamType = ptUnknown
      end>
  end
  object qryCalculosDadosFiscais_Notas_e_Cupons: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'FiltroFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroSeries'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroIncluirNFCopiaECF'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'SELECT numero,'
      '       codigofiscal,'
      '       base,'
      '       aliquota,'
      '       valor,'
      '       isentas,'
      '       outras,'
      '       cast(observacao as varchar(50)) as observacao,'
      '       operacao'
      'FROM'
      '('
      '  ('
      
        '   select numero, codigofiscal, sum(base) as base, aliquota, sum' +
        '(valor) as valor, sum(isentas) as isentas, sum(outras) as outras' +
        ','
      '          observacao, operacao'
      '   from'
      ''
      '    ('
      '     SELECT'
      
        '      cast(cast(n.filial as varchar)||n.serie||cast(n.numero as ' +
        'varchar) as varchar) as numero,'
      
        '      case When df.CodigoFiscal in (5929,6929) then cast(5929 as' +
        ' integer) else cdf.codigofiscal end as codigofiscal,'
      
        '      case When df.CodigoFiscal in (5929,6929) then 0 else (case' +
        ' When df.situacao='#39'N'#39' then cdf.base else 0 end) end as base,'
      
        '      case When df.CodigoFiscal in (5929,6929) then 0 else cdf.a' +
        'liquota  end as aliquota,'
      
        '      case When df.CodigoFiscal in (5929,6929) then 0 else (case' +
        ' When df.situacao='#39'N'#39' then cdf.valor else 0 end) end as valor,'
      
        '      case When df.CodigoFiscal in (5929,6929) then 0 else (case' +
        ' When df.situacao='#39'N'#39' then cdf.isentas else 0 end) end as isenta' +
        's,'
      '      case When df.situacao='#39'N'#39' then'
      '       (case When df.CodigoFiscal in (5929,6929) then'
      '         (cdf.base+cdf.isentas+cdf.outras)'
      '        else cdf.outras end) else 0 end as outras,'
      
        '      case When df.CodigoFiscal in (5929,6929) then '#39'CF M-'#39'||cas' +
        't(c.maquina as varchar)||'#39' '#39'||cast(c.numero as varchar)||'#39' '#39'||su' +
        'bstr(df.observacoes,0,strpos(df.observacoes,chr(10)))'
      
        '             else  substr(df.observacoes,0,strpos(df.observacoes' +
        ',chr(10))) end as observacao,'
      
        '      case when (select count(*)  from parcelas p Where p.contra' +
        'to=(select ct.numero from contratos ct where ct.numero=df.contra' +
        'to))=0 then '#39'OUTRAS'#39'  else'
      
        '      case when (select count(*) from parcelas p Where p.contrat' +
        'o=(select ct.numero from contratos ct where ct.numero=df.contrat' +
        'o) and'
      
        '                                                      p.datavenc' +
        'to > (select ct.data from contratos ct where ct.numero=df.contra' +
        'to))=0                    then '#39'A VISTA'#39'      else'
      
        '                                                                ' +
        '                                                                ' +
        '                                                                ' +
        #39'A PRAZO'#39'    end'
      '      end as Operacao'
      ''
      '     FROM ((dadosfiscais df '
      '            join (notas n '
      '                  left join cupons c '
      '                  on n.dadofiscalvinculado=c.dadofiscal)'
      '            on df.numero = n.dadofiscal)'
      '            '
      
        '            join (select * from calculosdadosfiscais_(:DataInici' +
        'al,:DataFinal)) cdf '
      '            on df.numero=cdf.dadofiscal)'
      '                                     '
      '     Where cdf.tipo='#39'M'#39
      '      and cdf.codigofiscal not in (5933,6933,7933) '
      '      and df.data between (:DataInicial) and (:DataFinal)'
      
        '      and (cdf.codigofiscal between (:CodigoFiscalInicial) and (' +
        ':CodigoFiscalFinal) or'
      
        '            df.codigofiscal between (:CodigoFiscalInicial) and (' +
        ':CodigoFiscalFinal))'
      ''
      '     %FiltroFiliais'
      '     %FiltroSeries'
      '     %FiltroIncluirNFCopiaECF'
      ''
      '    ) as selecao'
      
        '     group by  numero, codigofiscal, aliquota, observacao, opera' +
        'cao'
      '  )'
      '  union all'
      '  ('
      '   SELECT'
      
        '    cast(cast(n.filial as varchar)||n.serie||cast(n.numero as va' +
        'rchar) as varchar) as numero,'
      
        '    cast(substring(cast(cdf.codigofiscal as varchar),1,1)||'#39'933'#39 +
        ' as integer) as codigofiscal,'
      '    0.00 as base,'
      '    0.00 as aliquota,'
      '    0.00 as valor,'
      '    0.00 as isentas,'
      
        '    case When df.situacao='#39'N'#39' then cdf.base+cdf.isentas+cdf.outr' +
        'as else 0 end as outras,'
      
        '    case When df.CodigoFiscal in (5929,6929) then '#39'CF M-'#39'||cast(' +
        'c.maquina as varchar)||'#39' '#39'||cast(c.numero as varchar)||'#39' '#39'||subs' +
        'tr(df.observacoes,0,strpos(df.observacoes,chr(10)))'
      
        '            else  substr(df.observacoes,0,strpos(df.observacoes,' +
        'chr(10))) end as observacao,'
      
        '    case when (select count(*)  from parcelas p Where p.contrato' +
        '=(select ct.numero from contratos ct where ct.numero=df.contrato' +
        '))=0 then '#39'OUTRAS'#39'  else'
      
        '    case when (select count(*) from parcelas p Where p.contrato=' +
        '(select ct.numero from contratos ct where ct.numero=df.contrato)' +
        ' and'
      
        '                                                    p.datavencto' +
        ' > (select ct.data from contratos ct where ct.numero=df.contrato' +
        '))=0                    then '#39'A VISTA'#39'      else'
      
        '                                                                ' +
        '                                                                ' +
        '                                                              '#39'A' +
        ' PRAZO'#39'    end'
      '    end as Operacao'
      ''
      '                                  '
      '                                     '
      '   FROM ((dadosfiscais df '
      '            join (notas n '
      '                  left join cupons c '
      '                  on n.dadofiscalvinculado=c.dadofiscal)'
      '            on df.numero = n.dadofiscal)'
      '            '
      
        '            join (select * from calculosdadosfiscais_(:DataInici' +
        'al,:DataFinal)) cdf '
      '            on df.numero=cdf.dadofiscal)'
      '                                     '
      '   Where cdf.tipo = '#39'S'#39
      '    and df.data between (:DataInicial) and (:DataFinal)'
      
        '    and (cdf.codigofiscal between (:CodigoFiscalInicial) and (:C' +
        'odigoFiscalFinal) or'
      
        '         df.codigofiscal between (:CodigoFiscalInicial) and (:Co' +
        'digoFiscalFinal) or'
      
        '         cast(substring(cast(cdf.codigofiscal as varchar),1,1)||' +
        #39'933'#39' as integer) between (:CodigoFiscalInicial) and (:CodigoFis' +
        'calFinal))'
      ''
      '   %FiltroFiliais'
      '   %FiltroSeries'
      '   %FiltroIncluirNFCopiaECF'
      ''
      '  )'
      '  union all'
      '  ('
      '   SELECT'
      
        '    cast(cast(c.filial as varchar)||cast(c.maquina as varchar)||' +
        'cast(c.intervensao as varchar)||cast(c.numero as varchar) as var' +
        'char) as numero,'
      '    cast(5102 as integer) as codigofiscal,'
      '    case when df.situacao='#39'N'#39' then cdf.base else 0 end as base,'
      '    cdf.aliquota,'
      
        '    case when df.situacao='#39'N'#39' then cdf.valor else 0 end as valor' +
        ','
      
        '    case when df.situacao='#39'N'#39' then cdf.isentas else 0 end as ise' +
        'ntas,'
      
        '    case when df.situacao='#39'N'#39' then cdf.outras else 0 end as outr' +
        'as,'
      
        '    case When df.CodigoFiscal in (5929,6929) then '#39'NF S-'#39'||trim(' +
        'n.serie)||'#39' '#39'||cast(n.numero as varchar)||'#39' '#39'||substr(df.observa' +
        'coes,0,strpos(df.observacoes,chr(10)))'
      
        '            else  substr(df.observacoes,0,strpos(df.observacoes,' +
        'chr(10))) end as observacao,'
      
        '    case when (select count(*)  from parcelas p Where p.contrato' +
        '=(select ct.numero from contratos ct where ct.numero=df.contrato' +
        '))=0 then '#39'OUTRAS'#39'  else'
      
        '    case when (select count(*) from parcelas p Where p.contrato=' +
        '(select ct.numero from contratos ct where ct.numero=df.contrato)' +
        ' and'
      
        '                                                       p.dataven' +
        'cto > (select ct.data from contratos ct where ct.numero=df.contr' +
        'ato))=0                    then '#39'A VISTA'#39'      else'
      
        '                                                                ' +
        '                                                                ' +
        '                                                              '#39'A' +
        ' PRAZO'#39'    end'
      '    end as Operacao'
      '   FROM ((dadosfiscais df '
      '           join (cupons c '
      '                 left join notas n '
      '                 on c.dadofiscal = n.dadofiscalvinculado'
      '                 )           '
      '           on df.numero = c.dadofiscal)'
      '           '
      
        '           join (select * from calculosdadosfiscais_(:DataInicia' +
        'l,:DataFinal)) cdf'
      '           on df.numero=cdf.dadofiscal)'
      '           '
      '                                     '
      '   Where cdf.tipo='#39'M'#39
      '    and df.data between (:DataInicial) and (:DataFinal)'
      
        '    and (cdf.codigofiscal between (:CodigoFiscalInicial) and (:C' +
        'odigoFiscalFinal) or'
      
        '         df.codigofiscal between (:CodigoFiscalInicial) and (:Co' +
        'digoFiscalFinal))'
      ''
      '    %FiltroFiliais'
      ''
      '  )'
      ') as notascalculos')
    RequestLive = False
    Left = 106
    Top = 231
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'DataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataFinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CodigoFiscalInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CodigoFiscalFinal'
        ParamType = ptUnknown
      end>
  end
  object qryCalculosDadosFiscais_Notas_e_CuponsMapasECFCalculos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'FiltroFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroSeries'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroIncluirNFCopiaECF'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'SELECT numero,'
      '       codigofiscal,'
      '       base,'
      '       aliquota,'
      '       valor,'
      '       isentas,'
      '       outras,'
      '       cast(observacao as varchar(50)) as observacao,'
      '       operacao'
      'FROM'
      '('
      ''
      '  ('
      '   SELECT'
      
        '    cast(cast(n.filial as varchar)||n.serie||cast(n.numero as va' +
        'rchar) as varchar) as numero,'
      '    cdf.codigofiscal,'
      
        '    case When cdf.CodigoFiscal in (5929,6929) then 0 else (case ' +
        'When df.situacao='#39'N'#39' then cdf.base else 0 end) end as base,'
      
        '    case When cdf.CodigoFiscal in (5929,6929) then 0 else cdf.al' +
        'iquota  end as aliquota,'
      
        '    case When cdf.CodigoFiscal in (5929,6929) then 0 else (case ' +
        'When df.situacao='#39'N'#39' then cdf.valor else 0 end) end as valor,'
      
        '    case When cdf.CodigoFiscal in (5929,6929) then 0 else (case ' +
        'When df.situacao='#39'N'#39' then cdf.isentas else 0 end) end as isentas' +
        ','
      '    case When df.situacao='#39'N'#39' then'
      '     (case When cdf.CodigoFiscal in (5929,6929) then'
      '       (cdf.base+cdf.isentas+cdf.outras)'
      '      else cdf.outras end) else 0 end as outras,'
      
        '    case When cdf.CodigoFiscal in (5929,6929) then '#39'CF M-'#39'||cast' +
        '(c.maquina as varchar)||'#39' '#39'||cast(c.numero as varchar)||'#39' '#39'||sub' +
        'str(df.observacoes,0,strpos(df.observacoes,chr(10)))'
      
        '           else  substr(df.observacoes,0,strpos(df.observacoes,c' +
        'hr(10))) end as observacao,'
      
        '    case when (select count(*)  from parcelas p Where p.contrato' +
        '=(select ct.numero from contratos ct where ct.numero=df.contrato' +
        '))=0 then '#39'OUTRAS'#39'  else'
      
        '    case when (select count(*) from parcelas p Where p.contrato=' +
        '(select ct.numero from contratos ct where ct.numero=df.contrato)' +
        ' and'
      
        '                                                    p.datavencto' +
        ' > (select ct.data from contratos ct where ct.numero=df.contrato' +
        '))=0                    then '#39'A VISTA'#39'      else'
      
        '                                                                ' +
        '                                                                ' +
        '                                                              '#39'A' +
        ' PRAZO'#39'    end'
      '    end as Operacao'
      ''
      '   FROM ((dadosfiscais df '
      '          join (notas n '
      '                left join cupons c '
      '                on c.dadofiscal=n.dadofiscalvinculado)'
      '                '
      '          on df.numero = n.dadofiscal)'
      '   '
      
        '          join calculosdadosfiscais cdf on df.numero=cdf.dadofis' +
        'cal)'
      '                                     '
      ''
      '   Where cdf.tipo='#39'M'#39
      '    and cdf.codigofiscal not in (5933,6933,7933) '
      '    and df.data between (:DataInicial) and (:DataFinal)'
      ''
      
        '        and (cdf.codigofiscal between (:CodigoFiscalInicial) and' +
        ' (:CodigoFiscalFinal) or'
      
        '             df.codigofiscal between (:CodigoFiscalInicial) and ' +
        '(:CodigoFiscalFinal))'
      ''
      ''
      '   %FiltroFiliais'
      '   %FiltroSeries'
      '   %FiltroIncluirNFCopiaECF'
      ''
      '  )'
      '  union all'
      '  ('
      '   SELECT'
      
        '    cast(cast(n.filial as varchar)||n.serie||cast(n.numero as va' +
        'rchar) as varchar) as numero,'
      
        '    cast(substring(cast(cdf.codigofiscal as varchar),1,1)||'#39'933'#39 +
        ' as integer) as codigofiscal,'
      '    0.00 as base,'
      '    0.00 as aliquota,'
      '    0.00 as valor,'
      '    0.00 as isentas,'
      
        '    case When df.situacao='#39'N'#39' then cdf.base+cdf.isentas+cdf.outr' +
        'as else 0 end as outras,'
      
        '    case When cdf.CodigoFiscal in (5929,6929) then '#39'CF M-'#39'||cast' +
        '(c.maquina as varchar)||'#39' '#39'||cast(c.numero as varchar)||'#39' '#39'||sub' +
        'str(df.observacoes,0,strpos(df.observacoes,chr(10)))'
      
        '            else  substr(df.observacoes,0,strpos(df.observacoes,' +
        'chr(10))) end as observacao,'
      
        '    case when (select count(*)  from parcelas p Where p.contrato' +
        '=(select ct.numero from contratos ct where ct.numero=df.contrato' +
        '))=0 then '#39'OUTRAS'#39'  else'
      
        '    case when (select count(*) from parcelas p Where p.contrato=' +
        '(select ct.numero from contratos ct where ct.numero=df.contrato)' +
        ' and'
      
        '                                                    p.datavencto' +
        ' > (select ct.data from contratos ct where ct.numero=df.contrato' +
        '))=0                    then '#39'A VISTA'#39'      else'
      
        '                                                                ' +
        '                                                                ' +
        '                                                              '#39'A' +
        ' PRAZO'#39'    end'
      '    end as Operacao'
      ''
      '   FROM ((dadosfiscais df '
      '          join (notas n '
      
        '                left join cupons c on n.dadofiscalvinculado=c.da' +
        'dofiscal)'
      '          on df.numero = n.dadofiscal)'
      '          '
      
        '          join calculosdadosfiscais cdf on df.numero=cdf.dadofis' +
        'cal)'
      '                                     '
      '   Where cdf.tipo = '#39'S'#39
      '    and df.data between (:DataInicial) and (:DataFinal)'
      ''
      
        '    and (cdf.codigofiscal between (:CodigoFiscalInicial) and (:C' +
        'odigoFiscalFinal) or'
      
        '         df.codigofiscal between (:CodigoFiscalInicial) and (:Co' +
        'digoFiscalFinal) or'
      
        '         cast(substring(cast(cdf.codigofiscal as varchar),1,1)||' +
        #39'933'#39' as integer) between (:CodigoFiscalInicial) and (:CodigoFis' +
        'calFinal))'
      ''
      ''
      '   %FiltroFiliais'
      '   %FiltroSeries'
      '   %FiltroIncluirNFCopiaECF'
      ''
      '  )'
      '   union all'
      ''
      '  ('
      '   SELECT  distinct'
      
        '    cast(cast(me.filial as varchar)||cast(me.maquina as varchar)' +
        '||cast(me.intervensao as varchar)||cast(me.data as varchar)||df.' +
        'situacao as varchar) as numero,'
      '    5102 as codigofiscal,'
      '    0 as base,'
      '    0 as aliquota,'
      '    0 as valor,'
      '    me.isento as isentas,'
      
        '    me.cancelamentos-(me.descontos+me.substituicao+me.naotributa' +
        'do) as outras,'
      
        '    '#39'RZ '#39'||cast(me.reducoes as varchar)||'#39' M '#39'||cast(me.maquina ' +
        'as varchar)||'#39'  '#39'||cast(me.intervensao as varchar)||'#39' '#39'||substr(' +
        'df.observacoes,0,strpos(df.observacoes,chr(10))) as observacao,'
      '    cast(null as varchar) as operacao'
      
        '  FROM ((dadosfiscais df join cupons c on df.numero = c.dadofisc' +
        'al)'
      
        '                                    join mapasECF me on c.filial' +
        '=me.filial and'
      
        '                                                        c.maquin' +
        'a=me.maquina and'
      
        '                                                        c.interv' +
        'ensao=me.intervensao and'
      
        '                                                        df.data=' +
        'me.data)'
      ''
      '  Where (select count(*)'
      '         from MapasECFTributados met'
      '         where met.filial=me.filial'
      '           and met.maquina=me.maquina'
      '           and met.intervensao=me.intervensao'
      '           and met.data=me.data)>1'
      '     and df.data between (:DataInicial) and (:DataFinal)'
      ''
      '      and ((exists (select cdf.codigofiscal'
      '                   from calculosdadosfiscais cdf'
      '                   where cdf.dadofiscal = df.numero'
      
        '                     and cdf.codigofiscal between :CodigoFiscalI' +
        'nicial and :CodigoFiscalFinal limit 1)) or'
      
        '                  (df.codigofiscal between :CodigoFiscalInicial ' +
        'and :CodigoFiscalFinal))'
      ''
      ''
      '    %FiltroFiliais'
      ''
      '  )'
      ''
      'union all'
      ''
      '  ('
      '  SELECT distinct'
      
        '    cast(cast(me.filial as varchar)||cast(me.maquina as varchar)' +
        '||me.intervensao||cast(me.data as varchar)||df.situacao as varch' +
        'ar) as numero,'
      '    5102 as codigofiscal,'
      '    met.valor as base,'
      '    met.base as aliquota,'
      '    (met.valor*met.base)/100 as valor,'
      '    case when (select count(*) from MapasECFTributados met'
      '               where met.filial=me.filial'
      '                 and met.maquina=me.maquina'
      '                 and met.intervensao=me.intervensao'
      '                 and met.data=me.data)=1 then  me.isento else 0'
      '    end as isentas,'
      ''
      '    case when (select count(*)'
      '               from MapasECFTributados met'
      '               where met.filial=me.filial'
      '                 and met.maquina=me.maquina'
      '                 and met.intervensao=me.intervensao'
      
        '                 and met.data=me.data)=1 then (me.descontos+me.s' +
        'ubstituicao+me.naotributado)-me.cancelamentos else 0'
      '    end  as outras,'
      
        '    '#39'RZ '#39'||cast(me.reducoes as varchar)||'#39' M '#39'||cast(me.maquina ' +
        'as varchar)||'#39'  '#39'||cast(me.intervensao as varchar)||'#39' '#39'||substr(' +
        'df.observacoes,0,strpos(df.observacoes,chr(10))) as observacao,'
      '    cast(null as varchar) as operacao'
      
        '  FROM ((dadosfiscais df join cupons c on df.numero = c.dadofisc' +
        'al)'
      
        '                                    join (mapasECF me  left join' +
        ' mapasECFTributados met on'
      
        '                                                                ' +
        '   me.filial=met.filial and'
      
        '                                                                ' +
        '   me.maquina=met.maquina and'
      
        '                                                                ' +
        '   me.intervensao=met.intervensao and'
      
        '                                                                ' +
        '   me.data=met.data)'
      
        '                                                                ' +
        '    on c.filial=me.filial and'
      
        '                                                                ' +
        '    c.maquina=me.maquina and'
      
        '                                                                ' +
        '    c.intervensao=me.intervensao and'
      
        '                                                                ' +
        '    df.data=me.data)'
      '  Where df.data between (:DataInicial) and (:DataFinal)'
      ''
      '        and ((exists (select cdf.codigofiscal'
      '                     from calculosdadosfiscais cdf'
      '                     where cdf.dadofiscal = df.numero'
      
        '                       and cdf.codigofiscal between :CodigoFisca' +
        'lInicial and :CodigoFiscalFinal limit 1)) or'
      
        '                    (df.codigofiscal between :CodigoFiscalInicia' +
        'l and :CodigoFiscalFinal))'
      ''
      ''
      ''
      '    %FiltroFiliais'
      ''
      '  )'
      ') as mapasECFCalculos')
    RequestLive = False
    Left = 136
    Top = 357
    ParamData = <
      item
        DataType = ftString
        Name = 'DataInicial'
        ParamType = ptUnknown
        Value = #39'2009-01-02'#39
      end
      item
        DataType = ftString
        Name = 'DataFinal'
        ParamType = ptUnknown
        Value = #39'2009-01-02'#39
      end
      item
        DataType = ftString
        Name = 'CodigoFiscalInicial'
        ParamType = ptUnknown
        Value = '0'
      end
      item
        DataType = ftString
        Name = 'CodigoFiscalFinal'
        ParamType = ptUnknown
        Value = '9999'
      end>
  end
