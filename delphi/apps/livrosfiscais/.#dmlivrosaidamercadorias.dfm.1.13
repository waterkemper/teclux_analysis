      item
        DataType = ftUnknown
        Name = 'FiltroSeries'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroIncluirNFCopiaECF'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'SELECT * FROM'
      '('
      '  select grupofilial,'
      '         nomegrupofilial,'
      '         filialemissao,'
      '         nomefilial,'
      '         data,'
      
        '         sum(case when Operacao='#39'OUTRAS'#39'   then valortotal else ' +
        '0 end) as OutrasValorTotal,'
      
        '         sum(case when Operacao='#39'OUTRAS'#39'   then base       else ' +
        '0 end) as OutrasBase,'
      
        '         sum(case when Operacao='#39'OUTRAS'#39'   then valor       else' +
        ' 0 end) as OutrasValor,'
      
        '         sum(case when Operacao='#39'A VISTA'#39'   then valortotal else' +
        ' 0 end) as AVistaValorTotal,'
      
        '         sum(case when Operacao='#39'A VISTA'#39'   then base       else' +
        ' 0 end) as AVistaBase,'
      
        '         sum(case when Operacao='#39'A VISTA'#39'   then valor       els' +
        'e 0 end) as AVistaValor,'
      
        '         sum(case when Operacao='#39'A PRAZO'#39' then valortotal else 0' +
        ' end) as APrazoValorTotal,'
      
        '         sum(case when Operacao='#39'A PRAZO'#39' then base       else 0' +
        ' end) as APrazoBase,'
      
        '         sum(case when Operacao='#39'A PRAZO'#39' then valor       else ' +
        '0 end) as APrazoValor'
      '  from'
      ' ('
      '  ('
      '   SELECT grupofilial,'
      '          nomegrupofilial,'
      '          filialemissao,'
      '          nomefilial,'
      '          data,'
      '          base+isentas+outras as valortotal,'
      '          base,'
      '          valor,'
      '          operacao'
      '   FROM'
      '   ('
      '     ('
      '      SELECT'
      
        '       case When :AgruparGrupoFilial then fgf.grupo             ' +
        ' else null end as grupofilial,'
      
        '       case When :AgruparGrupoFilial then gf.descricao         e' +
        'lse null end as nomegrupofilial,'
      
        '       case When :AgruparFilial          then df.filialemissao  ' +
        '    else null end as filialemissao,'
      
        '       case When :AgruparFilial          then f.nome            ' +
        '     else null end as nomefilial,'
      '       df.data,'
      
        '       case When df.CodigoFiscal in (5929,6929) then 0 else (cas' +
        'e When df.situacao='#39'N'#39' then cdf.base else 0 end) end as base,'
      
        '       case When df.CodigoFiscal in (5929,6929) then 0 else (cas' +
        'e When df.situacao='#39'N'#39' then cdf.valor else 0 end) end as valor,'
      
        '       case When df.CodigoFiscal in (5929,6929) then 0 else (cas' +
        'e When df.situacao='#39'N'#39' then cdf.isentas else 0 end) end as isent' +
        'as,'
      '       case When df.situacao='#39'N'#39' then'
      '        (case When df.CodigoFiscal in (5929,6929) then'
      '          (cdf.base+cdf.isentas+cdf.outras)'
      '         else cdf.outras end) else 0 end as outras,'
      
        '       case when (select count(*)  from parcelas p Where p.contr' +
        'ato=(select ct.numero from contratos ct where ct.numero=df.contr' +
        'ato))=0 then '#39'OUTRAS'#39'  else'
      
        '       case when (select count(*) from parcelas p Where p.contra' +
        'to=(select ct.numero from contratos ct where ct.numero=df.contra' +
        'to) and'
      
        '                                                       p.dataven' +
        'cto > (select ct.data from contratos ct where ct.numero=df.contr' +
        'ato))=0                    then '#39'A VISTA'#39'      else'
      
        '                                                                ' +
        '                                                                ' +
        '                                                                ' +
        ' '#39'A PRAZO'#39'    end'
      '       end as Operacao'
      ''
      '     FROM (((dadosfiscais df '
      '              join (notas n '
      '                    left join cupons c '
      '                    on c.dadofiscal=n.dadofiscalvinculado)'
      '              on df.numero = n.dadofiscal)'
      '     '
      
        '                                        join calculosdadosfiscai' +
        's cdf on df.numero=cdf.dadofiscal)'
      '                                        '
      
        '                                        join (filiais f left joi' +
        'n (filiaisgruposfiliais fgf left join gruposfiliais gf on fgf.gr' +
        'upo=gf.codigo)'
      
        '                                                                ' +
        '                            on f.codigo=fgf.filial)'
      
        '                                                              on' +
        ' df.filialemissao=f.codigo)'
      ''
      '     Where cdf.tipo='#39'M'#39
      '      /* and df.codigofiscal not in (5933,6933,7933) */ '
      '       and df.data between (:DataInicial) and (:DataFinal)'
      '       and (exists (select cdf.codigofiscal'
      '                   from calculosdadosfiscais cdf'
      '                   where cdf.dadofiscal = df.numero'
      
        '                     and cdf.codigofiscal between (:CodigoFiscal' +
        'Inicial) and (:CodigoFiscalFinal) limit 1) or'
      
        '            df.codigofiscal between (:CodigoFiscalInicial) and (' +
        ':CodigoFiscalFinal))'
      ''
      '     %FiltroFiliais'
      '     %FiltroSeries'
      '     %FiltroIncluirNFCopiaECF'
      ''
      '     )'
      '     union all'
      '     ('
      '     SELECT'
      
        '       case When :AgruparGrupoFilial then fgf.grupo             ' +
        ' else null end as grupofilial,'
      
        '       case When :AgruparGrupoFilial then gf.descricao         e' +
        'lse null end as nomegrupofilial,'
      
        '       case When :AgruparFilial          then df.filialemissao  ' +
        '    else null end as filialemissao,'
      
        '       case When :AgruparFilial          then f.nome            ' +
        '     else null end as nomefilial,'
      '       df.data,'
      '       0.00 as base,'
      '       0.00 as valor,'
      '       0.00 as isentas,'
      
        '       case When df.situacao='#39'N'#39' then cdf.base+cdf.isentas+cdf.o' +
        'utras else 0 end as outras,'
      
        '       case when (select count(*)  from parcelas p Where p.contr' +
        'ato=(select ct.numero from contratos ct where ct.numero=df.contr' +
        'ato))=0 then '#39'OUTRAS'#39'  else'
      
        '       case when (select count(*) from parcelas p Where p.contra' +
        'to=(select ct.numero from contratos ct where ct.numero=df.contra' +
        'to) and'
      
        '                                                       p.dataven' +
        'cto > (select ct.data from contratos ct where ct.numero=df.contr' +
        'ato))=0                    then '#39'A VISTA'#39'      else'
      
        '                                                                ' +
        '                                                                ' +
        '                                                                ' +
        ' '#39'A PRAZO'#39'    end'
      '       end as Operacao'
      ''
      '     FROM (((dadosfiscais df '
      '              join (notas n '
      '                   left join cupons c '
      '                   on c.dadofiscal=n.dadofiscalvinculado) '
      '                   '
      '              on df.numero = n.dadofiscal)'
      '              '
      
        '              join calculosdadosfiscais cdf on df.numero=cdf.dad' +
        'ofiscal)'
      '                                        '
      
        '                                        join (filiais f left joi' +
        'n (filiaisgruposfiliais fgf left join gruposfiliais gf on fgf.gr' +
        'upo=gf.codigo)'
      
        '                                                                ' +
        '                            on f.codigo=fgf.filial)'
      
        '                                                              on' +
        ' df.filialemissao=f.codigo)'
      '     Where cdf.tipo = '#39'S'#39
      '      and df.data between (:DataInicial) and (:DataFinal)'
      '      and ((exists (select cdf.codigofiscal'
      '                   from calculosdadosfiscais cdf'
      '                   where cdf.dadofiscal = df.numero'
      
        '                     and cdf.codigofiscal between (:CodigoFiscal' +
        'Inicial) and (:CodigoFiscalFinal) limit 1)) or'
      
        '            df.codigofiscal between (:CodigoFiscalInicial) and (' +
        ':CodigoFiscalFinal) or'
      '           (exists (select cdf.codigofiscal'
      '                   from calculosdadosfiscais cdf'
      '                   where cdf.dadofiscal = df.numero'
      
        '                     and cast(substring(cast(cdf.codigofiscal as' +
        ' varchar),1,1)||'#39'933'#39' as integer) between (:CodigoFiscalInicial)' +
        ' and (:CodigoFiscalFinal) limit 1)))'
      ''
      '     %FiltroFiliais'
      '     %FiltroSeries'
      '     %FiltroIncluirNFCopiaECF'
      ''
      '     )'
      '   ) as notascalculos'
      '  )'
      '  union all'
      '  ('
      '   SELECT grupofilial,'
      '        nomegrupofilial,'
      '        filialemissao,'
      '        nomefilial,'
      '        data,'
      '        base+isentas+outras as valortotal,'
      '        base,'
      '        valor,'
      '        operacao'
      '    FROM'
      '    ('
      '    ('
      '    SELECT'
      
        '      case When :AgruparGrupoFilial then fgf.grupo              ' +
        'else null end as grupofilial,'
      
        '      case When :AgruparGrupoFilial then gf.descricao         el' +
        'se null end as nomegrupofilial,'
      
        '      case When :AgruparFilial          then df.filialemissao   ' +
        '   else null end as filialemissao,'
      
        '      case When :AgruparFilial          then f.nome             ' +
        '    else null end as nomefilial,'
      '      df.data,'
      '      0 as base,'
      '      0 as valor,'
      '      me.isento as isentas,'
      
        '      me.cancelamentos-(me.descontos+me.substituicao+me.naotribu' +
        'tado) as outras,'
      '      cast(null as varchar) as operacao'
      
        '    FROM (((dadosfiscais df join cupons c on df.numero = c.dadof' +
        'iscal)'
      
        '                                      join mapasECF me on c.fili' +
        'al=me.filial and'
      
        '                                                                ' +
        '      c.maquina=me.maquina and'
      
        '                                                                ' +
        '      c.intervensao=me.intervensao and'
      
        '                                                                ' +
        '      df.data=me.data)'
      
        '                                       left join (filiais f left' +
        ' join (filiaisgruposfiliais fgf left join gruposfiliais gf on fg' +
        'f.grupo=gf.codigo)'
      
        '                                                                ' +
        '                           on f.codigo=fgf.filial)'
      
        '                                                             on ' +
        'df.filialemissao=f.codigo)'
      ''
      
        '    Where (select count(*) from MapasECFTributados met where  me' +
        't.filial=me.filial and'
      
        '                                                                ' +
        '                          met.maquina=me.maquina and'
      
        '                                                                ' +
        '                          met.intervensao=me.intervensao and'
      
        '                                                                ' +
        '                          met.data=me.data)>1 and'
      '     df.data between (:DataInicial) and (:DataFinal)'
      '       and (exists (select cdf.codigofiscal'
      '                   from calculosdadosfiscais cdf'
      '                   where cdf.dadofiscal = df.numero'
      
        '                     and cdf.codigofiscal between (:CodigoFiscal' +
        'Inicial) and (:CodigoFiscalFinal) limit 1) or'
      
        '            df.codigofiscal between (:CodigoFiscalInicial) and (' +
        ':CodigoFiscalFinal))'
      ''
      '      %FiltroFiliais'
      ''
      '    )'
      '    union'
      '    ('
      '    SELECT'
      
        '      case When :AgruparGrupoFilial then fgf.grupo              ' +
        'else null end as grupofilial,'
      
        '      case When :AgruparGrupoFilial then gf.descricao         el' +
        'se null end as nomegrupofilial,'
      
        '      case When :AgruparFilial          then df.filialemissao   ' +
        '   else null end as filialemissao,'
      
        '      case When :AgruparFilial          then f.nome             ' +
        '    else null end as nomefilial,'
      '      df.data,'
      '      met.valor as base,'
      '      (met.valor*met.base)/100 as valor,'
      
        '      case when (select count(*) from MapasECFTributados met whe' +
        're met.filial=me.filial and'
      
        '                                                                ' +
        '                                  met.maquina=me.maquina and'
      
        '                                                                ' +
        '                                  met.intervensao=me.intervensao' +
        ' and'
      
        '                                                                ' +
        '                                  met.data=me.data)=1 then  me.i' +
        'sento else 0'
      '      end as isentas,'
      ''
      
        '      case when (select count(*) from MapasECFTributados met whe' +
        're met.filial=me.filial and'
      
        '                                                                ' +
        '                                  met.maquina=me.maquina and'
      
        '                                                                ' +
        '                                  met.intervensao=me.intervensao' +
        ' and'
      
        '                                                                ' +
        '                                  met.data=me.data)=1 then (me.d' +
        'escontos+me.substituicao+me.naotributado)-me.cancelamentos else ' +
        '0'
      '      end  as outras,'
      '      cast(null as varchar) as operacao'
      
        '    FROM (((dadosfiscais df join cupons c on df.numero = c.dadof' +
        'iscal)'
      
        '                                      join (mapasECF me  left jo' +
        'in mapasECFTributados met on me.filial=met.filial and'
      
        '                                                                ' +
        '                                                       me.maquin' +
        'a=met.maquina and'
      
        '                                                                ' +
        '                                                       me.interv' +
        'ensao=met.intervensao and'
      
        '                                                                ' +
        '                                                       me.data=m' +
        'et.data)'
      
        '                                                                ' +
        '      on c.filial=me.filial and'
      
        '                                                                ' +
        '      c.maquina=me.maquina and'
      
        '                                                                ' +
        '      c.intervensao=me.intervensao and'
      
        '                                                                ' +
        '      df.data=me.data)'
      
        '                                       left join (filiais f left' +
        ' join (filiaisgruposfiliais fgf left join gruposfiliais gf on fg' +
        'f.grupo=gf.codigo)'
      
        '                                                                ' +
        '                           on f.codigo=fgf.filial)'
      
        '                                                             on ' +
        'df.filialemissao=f.codigo)'
      '    Where df.data between (:DataInicial) and (:DataFinal)'
      '       and (exists (select cdf.codigofiscal'
      '                   from calculosdadosfiscais cdf'
      '                   where cdf.dadofiscal = df.numero'
      
        '                     and cdf.codigofiscal between (:CodigoFiscal' +
        'Inicial) and (:CodigoFiscalFinal) limit 1) or'
      
        '            df.codigofiscal between (:CodigoFiscalInicial) and (' +
        ':CodigoFiscalFinal))'
      ''
      '      %FiltroFiliais'
      ''
      '    )'
      '    ) as mapasECFCalculos'
      '  )'
      ' ) as notas_e_cupons'
      
        '    group by nomegrupofilial, grupofilial, nomefilial, filialemi' +
        'ssao, data'
      ''
      ') AS rd'
      
        'ORDER BY upper(to_ascii(rd.NomeGrupoFilial,'#39'latin1'#39')), rd.GrupoF' +
        'ilial,'
      
        '         upper(to_ascii(rd.NomeFilial,'#39'latin1'#39')), rd.FilialEmiss' +
        'ao, rd.Data')
    RequestLive = False
    Left = 112
    Top = 519
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'AgruparGrupoFilial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'AgruparFilial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataFinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CodigoFiscalInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CodigoFiscalFinal'
        ParamType = ptUnknown
      end>
  end
  object qryDadosFiscais: TtecQuery
