  object qryCalculosDadosFiscais_Notas_e_CuponsAgrupados: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'FiltroFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroSeries'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroIncluirNFCopiaECF'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'SELECT numero,'
      '       codigofiscal,'
      '       base,'
      '       aliquota,'
      '       valor,'
      '       isentas,'
      '       outras,'
      '       cast(observacao as varchar(50)) as observacao,'
      '       operacao'
      'FROM'
      '('
      '  ('
      
        '   select numero, codigofiscal, sum(base) as base, aliquota, sum' +
        '(valor) as valor, sum(isentas) as isentas, sum(outras) as outras' +
        ','
      '          observacao, operacao'
      '   from'
      '      ('
      '       SELECT'
      
        '        cast(cast(n.filial as varchar)||n.serie||cast(n.numero a' +
        's varchar) as varchar) as numero,'
      
        '        case When df.CodigoFiscal in (5929,6929) then cast(5929 ' +
        'as integer) else cdf.codigofiscal end as codigofiscal,'
      
        '        case When df.CodigoFiscal in (5929,6929) then 0 else (ca' +
        'se When df.situacao='#39'N'#39' then cdf.base else 0 end) end as base,'
      
        '        case When df.CodigoFiscal in (5929,6929) then 0 else cdf' +
        '.aliquota  end as aliquota,'
      
        '        case When df.CodigoFiscal in (5929,6929) then 0 else (ca' +
        'se When df.situacao='#39'N'#39' then cdf.valor else 0 end) end as valor,'
      
        '        case When df.CodigoFiscal in (5929,6929) then 0 else (ca' +
        'se When df.situacao='#39'N'#39' then cdf.isentas else 0 end) end as isen' +
        'tas,'
      '        case When df.situacao='#39'N'#39' then'
      '         (case When df.CodigoFiscal in (5929,6929) then'
      '           (cdf.base+cdf.isentas+cdf.outras)'
      '          else cdf.outras end) else 0 end as outras,'
      
        '        case When df.CodigoFiscal in (5929,6929) then '#39'CF M-'#39'||c' +
        'ast(c.maquina as varchar)||'#39' '#39'||cast(c.numero as varchar)||'#39' '#39'||' +
        'substr(df.observacoes,0,strpos(df.observacoes,chr(10)))'
      
        '               else  substr(df.observacoes,0,strpos(df.observaco' +
        'es,chr(10))) end as observacao,'
      
        '        case when (select count(*)  from parcelas p Where p.cont' +
        'rato=(select ct.numero from contratos ct where ct.numero=df.cont' +
        'rato))=0 then '#39'OUTRAS'#39'  else'
      
        '        case when (select count(*) from parcelas p Where p.contr' +
        'ato=(select ct.numero from contratos ct where ct.numero=df.contr' +
        'ato) and'
      
        '                                                        p.datave' +
        'ncto > (select ct.data from contratos ct where ct.numero=df.cont' +
        'rato))=0                    then '#39'A VISTA'#39'      else'
      
        '                                                                ' +
        '                                                                ' +
        '                                                                ' +
        '  '#39'A PRAZO'#39'    end'
      '        end as Operacao'
      ''
      ''
      '       FROM (((dadosfiscais df'
      '               join (notas n'
      '                     left join cupons c'
      '                     on c.dadofiscal=n.dadofiscalvinculado)'
      ''
      '               on df.numero = n.dadofiscal)'
      ''
      
        '               join (select * from calculosdadosfiscais_(:DataIn' +
        'icial,:DataFinal)) cdf'
      '               on df.numero=cdf.dadofiscal)'
      ''
      '               join (filiais f'
      '                     left join (filiaisgruposfiliais fgf'
      '                                join gruposfiliais gf'
      '                                on fgf.grupo=gf.codigo)'
      '                     on f.codigo=fgf.filial)'
      '               on df.filialemissao=f.codigo)'
      ''
      '       Where cdf.tipo='#39'M'#39
      '        and cdf.codigofiscal not in (5933,6933,7933)'
      '        and df.data between (:DataInicial) and (:DataFinal)'
      
        '        and (cdf.codigofiscal between (:CodigoFiscalInicial) and' +
        ' (:CodigoFiscalFinal) or'
      
        '             df.codigofiscal between (:CodigoFiscalInicial) and ' +
        '(:CodigoFiscalFinal))'
      ''
      '       %FiltroFiliais'
      '       %FiltroSeries'
      '       %FiltroIncluirNFCopiaECF'
      ''
      '      ) as selecao'
      
        '   group by  numero, codigofiscal, aliquota, observacao, operaca' +
        'o'
      ''
      '  )'
      '  union all'
      '  ('
      '   SELECT'
      
        '   cast(cast(n.filial as varchar)||n.serie||cast(n.numero as var' +
        'char) as varchar) as numero,'
      
        '    cast(substring(cast(cdf.codigofiscal as varchar),1,1)||'#39'933'#39 +
        ' as integer) as codigofiscal,'
      '    0.00 as base,'
      '    0.00 as aliquota,'
      '    0.00 as valor,'
      '    0.00 as isentas,'
      
        '    case When df.situacao='#39'N'#39' then cdf.base+cdf.isentas+cdf.outr' +
        'as else 0 end as outras,'
      
        '    case When df.CodigoFiscal in (5929,6929) then '#39'CF M-'#39'||cast(' +
        'c.maquina as varchar)||'#39' '#39'||cast(c.numero as varchar)||'#39' '#39'||subs' +
        'tr(df.observacoes,0,strpos(df.observacoes,chr(10)))'
      
        '            else  substr(df.observacoes,0,strpos(df.observacoes,' +
        'chr(10))) end as observacao,'
      
        '    case when (select count(*)  from parcelas p Where p.contrato' +
        '=(select ct.numero from contratos ct where ct.numero=df.contrato' +
        '))=0 then '#39'OUTRAS'#39'  else'
      
        '    case when (select count(*) from parcelas p Where p.contrato=' +
        '(select ct.numero from contratos ct where ct.numero=df.contrato)' +
        ' and'
      
        '                                                    p.datavencto' +
        ' > (select ct.data from contratos ct where ct.numero=df.contrato' +
        '))=0                    then '#39'A VISTA'#39'      else'
      
        '                                                                ' +
        '                                                                ' +
        '                                                              '#39'A' +
        ' PRAZO'#39'    end'
      '    end as Operacao'
      ''
      '   FROM (((dadosfiscais df '
      '           join (notas n '
      '                 left join cupons c '
      '                 on n.dadofiscalvinculado = c.dadofiscal)'
      '                 '
      '           on df.numero = n.dadofiscal)'
      '           '
      
        '           join (select * from calculosdadosfiscais_(:DataInicia' +
        'l,:DataFinal)) cdf '
      '           on df.numero=cdf.dadofiscal)'
      '                                     '
      '           join (filiais f '
      '                 left join (filiaisgruposfiliais fgf '
      
        '                            left join gruposfiliais gf on fgf.gr' +
        'upo=gf.codigo)'
      '                 on f.codigo=fgf.filial)'
      '           on df.filialemissao=f.codigo)'
      '           '
      '   Where cdf.tipo = '#39'S'#39
      '    and df.data between (:DataInicial) and (:DataFinal)'
      
        '    and (cdf.codigofiscal between (:CodigoFiscalInicial) and (:C' +
        'odigoFiscalFinal) or'
      
        '         df.codigofiscal between (:CodigoFiscalInicial) and (:Co' +
        'digoFiscalFinal) or'
      
        '         cast(substring(cast(cdf.codigofiscal as varchar),1,1)||' +
        #39'933'#39' as integer) between (:CodigoFiscalInicial) and (:CodigoFis' +
        'calFinal))'
      ''
      ''
      '   %FiltroFiliais'
      '   %FiltroSeries'
      '   %FiltroIncluirNFCopiaECF'
      ''
      '  )'
      '  union all'
      '  ('
      
        '   select cast(cast(cupons.filial as varchar)||cast(cupons.maqui' +
        'na as varchar)||cast(cupons.intervensao as varchar)||'
      '              cast((select min(c.numero)'
      
        '               from dadosfiscais df join cupons c on df.numero =' +
        ' c.dadofiscal'
      
        '                                    join (select * from calculos' +
        'dadosfiscais_(cupons.filial, cupons.maquina, cupons.intervensao,' +
        ' cupons.data)) cdf on df.numero = cdf.dadofiscal'
      '               where c.filial = cupons.filial'
      '                 and c.maquina = cupons.maquina'
      '                 and c.intervensao = cupons.intervensao'
      '                 and df.data = cupons.data'
      '                 and df.situacao='#39'N'#39
      '                 and cdf.tipo='#39'M'#39
      
        '                 and (cdf.codigofiscal between (:CodigoFiscalIni' +
        'cial) and (:CodigoFiscalFinal) or'
      
        '                       df.codigofiscal between (:CodigoFiscalIni' +
        'cial) and (:CodigoFiscalFinal))'
      '                %FiltroFiliais  ) as varchar)||'
      ''
      '              cast((select max(c.numero)'
      
        '               from dadosfiscais df join cupons c on df.numero =' +
        ' c.dadofiscal'
      
        '                                    join (select * from calculos' +
        'dadosfiscais_(cupons.filial, cupons.maquina, cupons.intervensao,' +
        ' cupons.data)) cdf on df.numero = cdf.dadofiscal'
      '               where c.filial = cupons.filial'
      '                 and c.maquina = cupons.maquina'
      '                 and c.intervensao = cupons.intervensao'
      '                 and df.data = cupons.data'
      '                 and df.situacao='#39'N'#39
      '                 and cdf.tipo='#39'M'#39
      
        '                 and (cdf.codigofiscal between (:CodigoFiscalIni' +
        'cial) and (:CodigoFiscalFinal) or'
      
        '                       df.codigofiscal between (:CodigoFiscalIni' +
        'cial) and (:CodigoFiscalFinal))'
      
        '                %FiltroFiliais ) as varchar) ||cast(cupons.data ' +
        'as varchar)||cupons.situacao  as varchar) as numero,'
      
        '          codigofiscal, base,aliquota,valor,isentas,outras,obser' +
        'vacao,operacao'
      '   from'
      '    ('
      '     SELECT'
      '      c.filial,'
      '      c.maquina,'
      '      c.intervensao,'
      '      df.data,'
      '      df.situacao,'
      '      cast(5102 as integer) as codigofiscal,'
      
        '      sum(case When df.situacao='#39'N'#39' then cdf.base else 0 end) as' +
        ' base,'
      '      cdf.aliquota,'
      
        '      sum(case When df.situacao='#39'N'#39' then cdf.valor else 0 end) a' +
        's valor,'
      
        '      sum(case When df.situacao='#39'N'#39' then cdf.isentas else 0 end)' +
        ' as isentas,'
      
        '      sum(case When df.situacao='#39'N'#39' then cdf.outras else 0 end) ' +
        'as outras,'
      
        '      '#39'Maq.: '#39'||cast(c.maquina as varchar)||'#39' Inter.: '#39'||cast(c.' +
        'intervensao as varchar) as observacao,'
      '      cast(null as varchar) as operacao'
      
        '     FROM (((dadosfiscais df join cupons c on df.numero=c.dadofi' +
        'scal)'
      
        '                                      join (select * from calcul' +
        'osdadosfiscais_(:dataInicial, :DataFinal)) cdf on df.numero=cdf.' +
        'dadofiscal)'
      
        '                                       left join (filiais f left' +
        ' join (filiaisgruposfiliais fgf left join gruposfiliais gf on fg' +
        'f.grupo=gf.codigo)'
      
        '                                                                ' +
        '                           on f.codigo=fgf.filial)'
      
        '                                                             on ' +
        'df.filialemissao=f.codigo)'
      '     Where cdf.tipo='#39'M'#39
      '       and df.data between (:DataInicial) and (:DataFinal)'
      ''
      
        '        and (cdf.codigofiscal between (:CodigoFiscalInicial) and' +
        ' (:CodigoFiscalFinal) or'
      
        '             df.codigofiscal between (:CodigoFiscalInicial) and ' +
        '(:CodigoFiscalFinal))'
      ''
      ''
      '      %FiltroFiliais'
      ''
      
        '     group by c.filial, c.maquina, c.intervensao, df.data, cdf.a' +
        'liquota, df.situacao/*, df.estadocfo*/'
