      '          numerofinal,'
      '          data,'
      '          operacao,'
      '          case when :ExisteFiltroCodigo then false'
      '          else'
      '            ((situacao='#39'N'#39') and'
      '            ((select sum(cdf.base+cdf.isentas+cdf.outras)'
      
        '              from CalculosDadosFiscais_(cuponsagrupados.dadofis' +
        'cal) cdf'
      '              where cdf.dadofiscal = cuponsagrupados.dadofiscal'
      '                and cdf.tipo='#39'M'#39')<>cuponsagrupados.valortotal))'
      '          end as diferente'
      '    from'
      '    ('
      '    SELECT grupofilial,'
      '           nomegrupofilial,'
      '           filialemissao,'
      '           nomefilial,'
      '           situacao,'
      '           dadofiscal,'
      '/*           estadocfo,*/'
      '           SUM(valortotal) as valortotal,'
      '           serie,'
      '           min(numeroinicial) as numeroinicial,'
      '           max(numerofinal) as numerofinal,'
      '           filial,'
      '           maquina,'
      '           intervensao,'
      '           data,'
      '           operacao'
      ''
      ''
      '    FROM'
      '    ('
      '      SELECT distinct'
      
        '        case When :AgruparGrupoFilial then fgf.grupo            ' +
        '  else null end as grupofilial,'
      
        '        case When :AgruparGrupoFilial then gf.descricao         ' +
        'else null end as nomegrupofilial,'
      
        '        case When :AgruparFilial          then df.filialemissao ' +
        '     else null end as filialemissao,'
      
        '        case When :AgruparFilial          then f.nome           ' +
        '      else null end as nomefilial,'
      '        df.situacao,'
      '        0 as dadofiscal,'
      '        /*df.estadocfo,*/'
      ''
      '        case when :ExisteFiltroCodigo and (df.situacao='#39'N'#39') then'
      '                (select case when :ContribICMS then'
      
        '                             sum(cdf.base+cdf.isentas+cdf.outras' +
        ')'
      
        '                        else sum(cdf.base+cdf.isentas+cdf.outras' +
        '+cdf.valor)'
      '                        end'
      '                 from CalculosDadosFiscais_(c.dadofiscal) cdf'
      '                 where cdf.dadofiscal = c.dadofiscal'
      '                   and ((cdf.tipo='#39'M'#39' and :ContribICMS) or'
      '                        (cdf.tipo='#39'P'#39' and not :ContribICMS))'
      
        '                   and (cdf.codigofiscal between (:CodigoFiscalI' +
        'nicial) and (:CodigoFiscalFinal) or df.codigofiscal between (:Co' +
        'digoFiscalInicial) and (:CodigoFiscalFinal))'
      '                )'
      '             when df.situacao='#39'N'#39' then df.valortotal'
      '             else 0'
      '        end as valortotal,'
      ''
      '        cast(5102 as integer) as codigofiscal,'
      
        '        '#39'E'#39'||cast(c.maquina as varchar)||cast(c.intervensao as v' +
        'archar) as serie,'
      '        c.numero as numeroinicial,'
      '        c.numero as numerofinal,'
      '        c.filial,'
      '        c.maquina,'
      '        c.intervensao,'
      '        df.data,'
      '        cast(null AS VARCHAR) as operacao'
      ''
      
        '      FROM ((dadosfiscais df join cupons c on df.numero = c.dado' +
        'fiscal)'
      
        '                                         left join (filiais f le' +
        'ft join (filiaisgruposfiliais fgf left join gruposfiliais gf on ' +
        'fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                             on f.codigo=fgf.filial)'
      
        '                                                               o' +
        'n df.filialemissao=f.codigo)'
      ''
      
        '      Where exists (select cdf.dadofiscal from calculosdadosfisc' +
        'ais_(df.numero) cdf where cdf.tipo='#39'M'#39')'
      '       and df.data between (:DataInicial) and (:DataFinal)'
      ''
      ''
      '        and ((exists (select cdf.codigofiscal'
      '                     from calculosdadosfiscais_(df.numero) cdf'
      '                     where cdf.dadofiscal = df.numero'
      
        '                       and cdf.codigofiscal between :CodigoFisca' +
        'lInicial and :CodigoFiscalFinal limit 1)) or'
      
        '                    (df.codigofiscal between :CodigoFiscalInicia' +
        'l and :CodigoFiscalFinal))'
      ''
      ''
      '      %FiltroFiliais'
      ''
      '    ) as cuponsagrupados'
      
        '    group by nomegrupofilial, grupofilial, nomefilial, filialemi' +
        'ssao,  data, situacao, dadofiscal, /*estadocfo,*/ filial, serie,' +
        ' maquina, intervensao, operacao'
      '    ) as cuponsagrupados'
      ''
      '  )'
      ') AS df'
      '/*where diferente*/'
      
        'ORDER BY upper(to_ascii(df.NomeGrupoFilial,'#39'latin1'#39')), df.Grupof' +
        'ilial,'
      
        '         upper(to_ascii(df.NomeFilial,'#39'latin1'#39')), df.FilialEmiss' +
        'ao,'
      '         df.Data, df.NumeroInicial, df.NumeroFinal, df.numero,'
      '         df.Serie, df.Situacao,'
      '         df.EstadoCFO')
    RequestLive = False
    Left = 95
    Top = 279
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'ExisteFiltroCodigo'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'AgruparGrupoFilial'
        ParamType = ptUnknown
        Value = 'false'
      end
      item
        DataType = ftString
        Name = 'AgruparFilial'
        ParamType = ptUnknown
        Value = 'false'
      end
      item
        DataType = ftUnknown
        Name = 'ContribICMS'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'CodigoFiscalInicial'
        ParamType = ptUnknown
        Value = '0'
      end
      item
        DataType = ftString
        Name = 'CodigoFiscalFinal'
        ParamType = ptUnknown
        Value = '99999'
      end
      item
        DataType = ftString
        Name = 'DataInicial'
        ParamType = ptUnknown
        Value = #39'2009-01-02'#39
      end
      item
        DataType = ftString
        Name = 'DataFinal'
        ParamType = ptUnknown
        Value = #39'2009-01-02'#39
      end>
  end
  object qryDadosFiscais_Notas_e_CuponsMapasECF: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryDadosFiscaisBeforeOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'FiltroFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroSeries'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroIncluirNFCopiaECF'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'SELECT * FROM'
      '('
      ' ('
      '   SELECT grupofilial,'
      '          nomegrupofilial,'
      '          filialemissao,'
      '          nomefilial,'
      '          situacao,'
      '          numero,'
      '          estadocfo,'
      '          valortotal,'
      '          serie,'
      '          numeroinicial,'
      '          numerofinal,'
      '          data,'
      '          operacao,'
      '          case when :ExisteFiltroCodigo then false'
      '          else'
      '           ((situacao='#39'N'#39') and'
      '            ((select sum(cdf.base+cdf.isentas+cdf.outras)'
      '              from CalculosDadosFiscais cdf'
      '              where cdf.dadofiscal = notas.dadofiscal'
      '              and cdf.tipo='#39'M'#39')<>notas.valortotal))'
      '          end'
      '          as diferente'
      '    FROM'
      '    ('
      '      ('
      '       SELECT distinct'
      
        '        case When :AgruparGrupoFilial then fgf.grupo            ' +
        '  else null end as grupofilial,'
      
        '        case When :AgruparGrupoFilial then gf.descricao         ' +
        'else null end as nomegrupofilial,'
      
        '        case When :AgruparFilial          then df.filialemissao ' +
        '     else null end as filialemissao,'
      
        '        case When :AgruparFilial          then f.nome           ' +
        '      else null end as nomefilial,'
      '        df.situacao,'
      '        df.numero as dadofiscal,'
      
        '       cast(cast(n.filial as varchar)||n.serie||cast(n.numero as' +
        ' varchar) as varchar) as numero,'
      '        df.estadocfo,'
      ''
      '        case when :ExisteFiltroCodigo and (df.situacao='#39'N'#39') then'
      '                (select case when :ContribICMS then'
      
        '                             sum(cdf.base+cdf.isentas+cdf.outras' +
        ')'
      
        '                        else sum(cdf.base+cdf.isentas+cdf.outras' +
        '+cdf.valor)'
      '                        end'
      '                 from CalculosDadosFiscais cdf'
      '                 where cdf.dadofiscal = n.dadofiscal'
      '                   and ((cdf.tipo='#39'M'#39' and :ContribICMS) or'
      '                        (cdf.tipo='#39'P'#39' and not :ContribICMS))'
      
        '                   and cdf.codigofiscal between (:CodigoFiscalIn' +
        'icial) and (:CodigoFiscalFinal)'
      '                )'
      
        '             when df.situacao='#39'N'#39' then df.valortotal - coalesce(' +
        '(select sum(cdf2.base+cdf2.isentas+cdf2.outras)'
      
        '                                                                ' +
        ' from calculosdadosfiscais cdf2'
      '      '#9#9#9#9#9#9'                 where cdf2.dadofiscal = df.numero'
      '      '#9#9#9#9#9#9'                   and cdf2.tipo='#39'S'#39
      
        '                                                                ' +
        ' ),0)'
      '             else 0'
      '        end as valortotal,'
      ''
      '    /*    df.codigofiscal,*/'
      '        n.serie,'
      '        n.numero as numeroinicial,'
      '        n.numero as numerofinal,'
      '        df.data,'
      '        case when (select count(*)'
      '                   from parcelas p'
      '                   Where p.contrato = (select ct.numero'
      '                                       from contratos ct'
      
        '                                       where ct.numero=df.contra' +
        'to))=0 then '#39'OUTRAS'#39'  else'
      '        case when (select count(*)'
      '                   from parcelas p'
      '                   Where p.contrato= (select ct.numero'
      '                                      from contratos ct'
      '    '#9#9#9'          where ct.numero=df.contrato)'
      '     '#9#9#9'    '#9'    and p.datavencto > (select ct.data'
      '    '#9#9#9#9#9#9#9'from contratos ct'
      '    '#9#9#9#9#9#9#9'where ct.numero=df.contrato))=0'
      
        '                                                                ' +
        '       then '#39'A VISTA'#39'    else                                   ' +
        '                                                                ' +
        '                                                                ' +
        '                         '#39'A PRAZO'#39'    end'
      '        end as Operacao'
      
        '      FROM (((dadosfiscais df join notas n on df.numero = n.dado' +
        'fiscal)'
      
        '                                         join calculosdadosfisca' +
        'is cdf on df.numero=cdf.dadofiscal)'
      
        '                                         join (filiais f left jo' +
        'in (filiaisgruposfiliais fgf left join gruposfiliais gf on fgf.g' +
        'rupo=gf.codigo)'
      
        '                                                                ' +
        '                             on f.codigo=fgf.filial)'
      
        '                                                               o' +
        'n df.filialemissao=f.codigo)'
      '      Where cdf.tipo='#39'M'#39
      '       /* and df.codigofiscal not in (5933,6933,7933) */ '
      '        and df.data between (:DataInicial) and (:DataFinal)'
      ''
      '        and ((exists (select cdf.codigofiscal'
      '                     from calculosdadosfiscais cdf'
      '                     where cdf.dadofiscal = df.numero'
      
        '                       and cdf.codigofiscal between :CodigoFisca' +
        'lInicial and :CodigoFiscalFinal limit 1)) or'
      
        '                    (df.codigofiscal between :CodigoFiscalInicia' +
        'l and :CodigoFiscalFinal))'
      ''
      ''
      ''
      '      %FiltroFiliais'
      '      %FiltroSeries'
      '      %FiltroIncluirNFCopiaECF'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      '       SELECT distinct'
      
        '        case When :AgruparGrupoFilial then fgf.grupo            ' +
        '  else null end as grupofilial,'
      
        '        case When :AgruparGrupoFilial then gf.descricao         ' +
        'else null end as nomegrupofilial,'
      
        '        case When :AgruparFilial          then df.filialemissao ' +
        '     else null end as filialemissao,'
      
        '        case When :AgruparFilial          then f.nome           ' +
        '      else null end as nomefilial,'
      '        df.situacao,'
      '        df.numero as dadofiscal,'
      
        '       cast(cast(n.filial as varchar)||n.serie||cast(n.numero as' +
        ' varchar) as varchar) as numero,'
      '        df.estadocfo,'
      ''
      '        case when :ExisteFiltroCodigo and (df.situacao='#39'N'#39') then'
      '                (select sum(cdf.base+cdf.isentas+cdf.outras)'
      '                 from CalculosDadosFiscais cdf'
      '                 where cdf.dadofiscal = n.dadofiscal'
      '                   and cdf.tipo='#39'S'#39
      
        '                   and cdf.codigofiscal between (:CodigoFiscalIn' +
        'icial) and (:CodigoFiscalFinal)'
      '                )'
      
        '             when df.situacao='#39'N'#39' then coalesce((select sum(cdf2' +
        '.base+cdf2.isentas+cdf2.outras)'
      
        '                                                  from calculosd' +
        'adosfiscais cdf2'
      '      '#9#9#9#9'                   where cdf2.dadofiscal = df.numero'
      '      '#9#9#9#9'                     and cdf2.tipo='#39'S'#39
      
        '                                                                ' +
        ' ),0)'
      '             else 0'
      '        end as valortotal,'
      ''
      
        '        /*cast(substring(cast(codigofiscal as varchar),1,1)||'#39'93' +
        '3'#39' as integer) as codigofiscal,*/'
      '        n.serie,'
      '        n.numero as numeroinicial,'
      '        n.numero as numerofinal,'
      '        df.data,'
      '        case when (select count(*)'
      '                   from parcelas p'
      '                   Where p.contrato=(select ct.numero'
      '                                     from contratos ct'
      
        '                                     where ct.numero=df.contrato' +
        '))=0 then '#39'OUTRAS'#39'  else'
      '        case when (select count(*)'
      '                   from parcelas p'
      '                   Where p.contrato=(select ct.numero'
      '                                     from contratos ct'
      
        '                                     where ct.numero=df.contrato' +
        ')'
      
        '                                       and p.datavencto > (selec' +
        't ct.data'
      
        '                                                           from ' +
        'contratos ct'
      
        '                                                           where' +
        ' ct.numero=df.contrato))=0'
      
        '                                                                ' +
        '     then '#39'A VISTA'#39'   else                                      ' +
        '                                                                ' +
        '                                                                ' +
        '                        '#39'A PRAZO'#39'    end'
      '        end as Operacao'
      
        '      FROM (((dadosfiscais df join notas n on df.numero = n.dado' +
        'fiscal)'
      
        '                                         join calculosdadosfisca' +
        'is cdf on df.numero=cdf.dadofiscal)'
      
        '                                         join (filiais f left jo' +
        'in (filiaisgruposfiliais fgf left join gruposfiliais gf on fgf.g' +
        'rupo=gf.codigo)'
      
        '                                                                ' +
        '                             on f.codigo=fgf.filial)'
      
        '                                                               o' +
        'n df.filialemissao=f.codigo)'
      '      Where cdf.tipo = '#39'S'#39
      '       and df.data between (:DataInicial) and (:DataFinal)'
      ''
      '       and (((exists (select cdf.codigofiscal'
      '                    from calculosdadosfiscais cdf'
      '                    where cdf.dadofiscal = df.numero'
      
        '                      and cdf.codigofiscal between (:CodigoFisca' +
        'lInicial) and (:CodigoFiscalFinal) limit 1)) or'
      '             (exists (select cdf.codigofiscal'
      '                    from calculosdadosfiscais cdf'
      '                    where cdf.dadofiscal = df.numero'
      
        '                      and cast(substring(cast(cdf.codigofiscal a' +
        's varchar),1,1)||'#39'933'#39' as integer) between (:CodigoFiscalInicial' +
        ') and (:CodigoFiscalFinal) limit 1))) or'
      
        '                    (df.codigofiscal between :CodigoFiscalInicia' +
        'l and :CodigoFiscalFinal))'
      ''
      ''
      '      %FiltroFiliais'
      '      %FiltroSeries'
      '      %FiltroIncluirNFCopiaECF'
      ''
      '      )'
      '    ) as notas'
      '  )'
      '  union all'
      ''
      ' ('
      ''
      '  SELECT grupofilial,'
      '         nomegrupofilial,'
      '         filialemissao,'
      '         nomefilial,'
      '         situacao,'
      '         numero,'
      '         estadocfo,'
      '         valortotal,'
      '         serie,'
      '         numeroinicial,'
      '         numerofinal,'
      '         data,'
      '         operacao,'
      '         false as diferente'
      '  FROM'
      '    ('
      '     SELECT'
      
        '      case When :AgruparGrupoFilial then fgf.grupo              ' +
        'else null end as grupofilial,'
      
        '      case When :AgruparGrupoFilial then gf.descricao         el' +
        'se null end as nomegrupofilial,'
      
        '      case When :AgruparFilial          then df.filialemissao   ' +
        '   else null end as filialemissao,'
      
        '      case When :AgruparFilial          then f.nome             ' +
        '    else null end as nomefilial,'
      '      df.situacao,'
      '      0 as dadofiscal,'
      
        '      cast(cast(me.filial as varchar)||cast(me.maquina as varcha' +
        'r)||cast(me.intervensao as varchar)||cast(me.data as varchar)||d' +
        'f.situacao as varchar) as numero,'
      '      df.estadocfo,'
      ''
      '      sum('
      '      case when :ExisteFiltroCodigo then'
      '              (select case when :ContribICMS then'
      '                           sum(cdf.base+cdf.isentas+cdf.outras)'
      
        '                      else sum(cdf.base+cdf.isentas+cdf.outras+c' +
        'df.valor)'
      '                      end'
      '               from CalculosDadosFiscais cdf'
      '               where cdf.dadofiscal = c.dadofiscal'
      '                 and cdf.tipo='#39'M'#39
      
        '                 and cdf.codigofiscal between (:CodigoFiscalInic' +
        'ial) and (:CodigoFiscalFinal)'
      '              )'
      '           /*when df.situacao='#39'N'#39' then df.valortotal*/'
      '           else df.valortotal'
      '      end) as valortotal,'
      ''
      '  /*    5102 as codigofiscal,*/'
      
        '      '#39'E'#39'||cast(me.maquina as varchar)||cast(me.intervensao as v' +
        'archar) as serie,'
      '      min(c.numero) as numeroinicial,'
      '      max(c.numero) as numerofinal,'
      '      me.data,'
      '      cast(null as varchar) as operacao'
      ''
      
        '    FROM (((dadosfiscais df join cupons c on df.numero = c.dadof' +
        'iscal)'
      ''
      
        '                                      join mapasECF me on c.fili' +
        'al=me.filial and'
      
        '                                                                ' +
        '      c.maquina=me.maquina and'
      
        '                                                                ' +
        '      c.intervensao=me.intervensao and'
      
        '                                                                ' +
        '      df.data=me.data)'
      ''
      
        '                                       left join (filiais f left' +
        ' join (filiaisgruposfiliais fgf join gruposfiliais gf on fgf.gru' +
        'po=gf.codigo)'
      
        '                                                                ' +
        '                           on f.codigo=fgf.filial)'
      
        '                                                             on ' +
        'df.filialemissao=f.codigo)'
      '    Where df.data between (:DataInicial) and (:DataFinal)'
      ''
      '        and ((exists (select cdf.codigofiscal'
      '                     from calculosdadosfiscais cdf'
      '                     where cdf.dadofiscal = df.numero'
      
        '                       and cdf.codigofiscal between :CodigoFisca' +
        'lInicial and :CodigoFiscalFinal limit 1)) or'
      
        '                    (df.codigofiscal between :CodigoFiscalInicia' +
        'l and :CodigoFiscalFinal))'
      ''
      ''
      ''
      '    %FiltroFiliais'
      ''
      
        '    group by gf.descricao, fgf.grupo, f.nome, df.filialemissao, ' +
        'df.estadocfo, me.filial, me.maquina, me.intervensao, me.data, df' +
        '.situacao'
      '    ) as mapasECFCalculos'
      ''
      '  )'
      ') AS df'
      '/*where diferente*/'
      
        'ORDER BY upper(to_ascii(df.NomeGrupoFilial,'#39'latin1'#39')), df.Grupof' +
        'ilial,'
      
        '         upper(to_ascii(df.NomeFilial,'#39'latin1'#39')), df.FilialEmiss' +
        'ao,'
      '         df.Data, df.NumeroInicial, df.NumeroFinal,'
      '         df.numero, df.Serie, df.Situacao,'
      '         df.EstadoCFO')
    RequestLive = False
    Left = 103
    Top = 343
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'ExisteFiltroCodigo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'AgruparGrupoFilial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'AgruparFilial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ContribICMS'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CodigoFiscalInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CodigoFiscalFinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataFinal'
        ParamType = ptUnknown
      end>
  end
  object qryResumoDiarioCalculosDadosFiscais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'FiltroFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroSeries'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroIncluirNFCopiaECF'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'SELECT * FROM '
      '('
      '  select grupofilial,'
      '         nomegrupofilial,'
      '         filialemissao,'
      '         nomefilial,'
      '         data, '
      
        '         sum(case when Operacao='#39'OUTRAS'#39'  then valortotal else 0' +
        ' end) as OutrasValorTotal,'
      
        '         sum(case when Operacao='#39'OUTRAS'#39'  then base       else 0' +
        ' end) as OutrasBase,'
      
        '         sum(case when Operacao='#39'OUTRAS'#39'  then valor      else 0' +
        ' end) as OutrasValor,'
      
        '         sum(case when Operacao='#39'A VISTA'#39' then valortotal else 0' +
        ' end) as AVistaValorTotal,'
      
        '         sum(case when Operacao='#39'A VISTA'#39' then base       else 0' +
        ' end) as AVistaBase,'
      
        '         sum(case when Operacao='#39'A VISTA'#39' then valor      else 0' +
        ' end) as AVistaValor,'
      
        '         sum(case when Operacao='#39'A PRAZO'#39' then valortotal else 0' +
        ' end) as APrazoValorTotal,'
      
        '         sum(case when Operacao='#39'A PRAZO'#39' then base       else 0' +
        ' end) as APrazoBase,'
      
        '         sum(case when Operacao='#39'A PRAZO'#39' then valor      else 0' +
        ' end) as APrazoValor'
      '  from'
      ' ('
      '  ('
      '   SELECT grupofilial,'
      '          nomegrupofilial,'
      '          filialemissao,'
      '          nomefilial,'
      '          data,'
      '          base+isentas+outras as valortotal,'
      '          base,'
      '          valor,'
      '          operacao'
      '   FROM'
      '   ('
      '     ('
      '      SELECT'
      
        '       case When :AgruparGrupoFilial then fgf.grupo             ' +
        ' else null end as grupofilial,'
      
        '       case When :AgruparGrupoFilial then gf.descricao         e' +
        'lse null end as nomegrupofilial,'
      
        '       case When :AgruparFilial          then df.filialemissao  ' +
        '    else null end as filialemissao,'
      
        '       case When :AgruparFilial          then f.nome            ' +
        '     else null end as nomefilial,'
      '       df.data,'
      
        '       case When df.CodigoFiscal in (5929,6929) then 0 else (cas' +
        'e When df.situacao='#39'N'#39' then cdf.base else 0 end) end as base,'
      
        '       case When df.CodigoFiscal in (5929,6929) then 0 else (cas' +
        'e When df.situacao='#39'N'#39' then cdf.valor else 0 end) end as valor,'
      
        '       case When df.CodigoFiscal in (5929,6929) then 0 else (cas' +
        'e When df.situacao='#39'N'#39' then cdf.isentas else 0 end) end as isent' +
        'as,'
      '       case When df.situacao='#39'N'#39' then'
      '        (case When df.CodigoFiscal in (5929,6929) then'
      '          0'
      '         else cdf.outras end) else 0 end as outras,'
      
        '       case when (select count(*)  from parcelas p Where p.contr' +
        'ato=(select ct.numero from contratos ct where ct.numero=df.contr' +
        'ato))=0 then '#39'OUTRAS'#39'  else'
      
        '       case when (select count(*) from parcelas p Where p.contra' +
        'to=(select ct.numero from contratos ct where ct.numero=df.contra' +
        'to) and'
      
        '                                                       p.dataven' +
        'cto > (select ct.data from contratos ct where ct.numero=df.contr' +
        'ato))=0                    then '#39'A VISTA'#39'      else'
      
        '                                                                ' +
        '                                                                ' +
        '                                                                ' +
        ' '#39'A PRAZO'#39'    end'
      '       end as Operacao'
      ''
      '     FROM (((dadosfiscais df '
      '              join (notas n '
      '                    left join cupons c '
      '                    on n.dadofiscalvinculado=c.dadofiscal)'
      ''
      '              on df.numero = n.dadofiscal)'
      
        '              join (select * from calculosdadosfiscais_(:DataIni' +
        'cial,:DataFinal)) cdf on df.numero=cdf.dadofiscal)'
      
        '              join (filiais f left join (filiaisgruposfiliais fg' +
        'f left join gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                            on f.codigo=fgf.filial)'
      
        '                                                              on' +
        ' df.filialemissao=f.codigo)'
      ''
      '     Where cdf.tipo='#39'M'#39
      '     /*  and df.codigofiscal not in (5933,6933,7933) */'
      '       and df.data between (:DataInicial) and (:DataFinal)'
      '       and (exists (select cdf.codigofiscal'
      '                   from calculosdadosfiscais_(df.numero) cdf'
      '                   where cdf.dadofiscal = df.numero'
      
        '                     and cdf.codigofiscal between (:CodigoFiscal' +
        'Inicial) and (:CodigoFiscalFinal) limit 1) or'
      
        '            df.codigofiscal between (:CodigoFiscalInicial) and (' +
        ':CodigoFiscalFinal))'
      ''
      '     %FiltroFiliais'
      '     %FiltroSeries'
      '     %FiltroIncluirNFCopiaECF'
      ''
      '     )'
      '     union all'
      '     ('
      '     SELECT'
      
        '       case When :AgruparGrupoFilial then fgf.grupo             ' +
        ' else null end as grupofilial,'
      
        '       case When :AgruparGrupoFilial then gf.descricao         e' +
        'lse null end as nomegrupofilial,'
      
        '       case When :AgruparFilial          then df.filialemissao  ' +
        '    else null end as filialemissao,'
      
        '       case When :AgruparFilial          then f.nome            ' +
        '     else null end as nomefilial,'
      '       df.data,'
      '       0.00 as base,'
      '       0.00 as valor,'
      '       0.00 as isentas,'
      
        '       case When df.situacao='#39'N'#39' then cdf.base+cdf.isentas+cdf.o' +
        'utras else 0 end as outras,'
      
        '       case when (select count(*)  from parcelas p Where p.contr' +
        'ato=(select ct.numero from contratos ct where ct.numero=df.contr' +
        'ato))=0 then '#39'OUTRAS'#39'  else'
      
        '       case when (select count(*) from parcelas p Where p.contra' +
        'to=(select ct.numero from contratos ct where ct.numero=df.contra' +
        'to) and'
      
        '                                                       p.dataven' +
        'cto > (select ct.data from contratos ct where ct.numero=df.contr' +
        'ato))=0                    then '#39'A VISTA'#39'      else'
      
        '                                                                ' +
        '                                                                ' +
        '                                                                ' +
        ' '#39'A PRAZO'#39'    end'
      '       end as Operacao'
      ''
      '     FROM (((dadosfiscais df '
      '              join (notas n '
      
        '                    left join cupons c on n.dadofiscalvinculado=' +
        'c.dadofiscal)'
      '              on df.numero = n.dadofiscal)'
      '     '
      
        '              join (select * from calculosdadosfiscais_(:DataIni' +
        'cial,:DataFinal)) cdf on df.numero=cdf.dadofiscal)'
      '              '
      
        '              join (filiais f left join (filiaisgruposfiliais fg' +
        'f left join gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                            on f.codigo=fgf.filial)'
      
        '                                                              on' +
        ' df.filialemissao=f.codigo)'
      '     Where cdf.tipo = '#39'S'#39
      '      and df.data between (:DataInicial) and (:DataFinal)'
      '      and ((exists (select cdf.codigofiscal'
      '                   from calculosdadosfiscais_(df.numero) cdf'
      '                   where cdf.dadofiscal = df.numero'
      
        '                     and cdf.codigofiscal between (:CodigoFiscal' +
        'Inicial) and (:CodigoFiscalFinal) limit 1)) or'
      
        '            df.codigofiscal between (:CodigoFiscalInicial) and (' +
        ':CodigoFiscalFinal) or'
      '           (exists (select cdf.codigofiscal'
      '                   from calculosdadosfiscais_(df.numero) cdf'
      '                   where cdf.dadofiscal = df.numero'
      
        '                     and cast(substring(cast(cdf.codigofiscal as' +
        ' varchar),1,1)||'#39'933'#39' as integer) between (:CodigoFiscalInicial)' +
        ' and (:CodigoFiscalFinal) limit 1)))'
      ''
      '     %FiltroFiliais'
      '     %FiltroSeries'
      '     %FiltroIncluirNFCopiaECF'
      ''
      '     )'
      '   ) as notascalculos'
      '  )'
      '  union all'
      '  ('
      ''
      '     SELECT grupofilial,'
      '            nomegrupofilial,'
      '            filialemissao,'
      '            nomefilial,'
      '            data,'
      '            base+isentas+outras as valortotal,'
      '            base,'
      '            valor,'
      '            operacao'
      '    FROM'
      '    ('
      '    SELECT'
      
        '      case When :AgruparGrupoFilial then fgf.grupo              ' +
        'else null end as grupofilial,'
      
        '      case When :AgruparGrupoFilial then gf.descricao         el' +
        'se null end as nomegrupofilial,'
      
        '      case When :AgruparFilial          then df.filialemissao   ' +
        '   else null end as filialemissao,'
      
        '      case When :AgruparFilial          then f.nome             ' +
        '    else null end as nomefilial,'
      '      df.data,'
      
        '      case when df.situacao='#39'N'#39' then cdf.base else 0 end as base' +
        ','
      
        '      case when df.situacao='#39'N'#39' then cdf.valor else 0 end as val' +
        'or,'
      
        '      case when df.situacao='#39'N'#39' then cdf.isentas else 0 end as i' +
        'sentas,'
      
        '      case when df.situacao='#39'N'#39' then cdf.outras else 0 end as ou' +
        'tras,'
      
        '      case when (select count(*)  from parcelas p Where p.contra' +
        'to=(select ct.numero from contratos ct where ct.numero=df.contra' +
        'to))=0 then '#39'OUTRAS'#39'  else'
      
        '      case when (select count(*) from parcelas p Where p.contrat' +
        'o=(select ct.numero from contratos ct where ct.numero=df.contrat' +
        'o) and'
      
        '                                                         p.datav' +
        'encto > (select ct.data from contratos ct where ct.numero=df.con' +
        'trato))=0                    then '#39'A VISTA'#39'      else'
      
        '                                                                ' +
        '                                                                ' +
        '                                                                ' +
        #39'A PRAZO'#39'    end'
      '      end as Operacao'
      '    FROM (((dadosfiscais df '
      '             join (cupons c '
      
        '                   left join notas n on c.dadofiscal=n.dadofisca' +
        'lvinculado)'
      '             on df.numero = c.dadofiscal)'
      '    '
      
        '                                       join (select * from calcu' +
        'losdadosfiscais_(:DataInicial,:DataFinal)) cdf on df.numero=cdf.' +
        'dadofiscal)'
      '                                       '
      
        '                                       left join (filiais f left' +
        ' join (filiaisgruposfiliais fgf left join gruposfiliais gf on fg' +
        'f.grupo=gf.codigo)'
      
        '                                                                ' +
        '                           on f.codigo=fgf.filial)'
      
        '                                                             on ' +
        'df.filialemissao=f.codigo)'
      '    Where cdf.tipo='#39'M'#39
      '     and df.data between (:DataInicial) and (:DataFinal)'
      '         and (exists (select cdf.codigofiscal'
      '                     from calculosdadosfiscais_(df.numero) cdf'
      '                     where cdf.dadofiscal = df.numero'
      
        '                       and cdf.codigofiscal between (:CodigoFisc' +
        'alInicial) and (:CodigoFiscalFinal) limit 1) or'
      
        '             df.codigofiscal between (:CodigoFiscalInicial) and ' +
        '(:CodigoFiscalFinal))'
      ''
      '      %FiltroFiliais'
      ''
      '    ) as cuponscalculos'
      '  )'
      ' ) as notas_e_cupons'
      
        '    group by nomegrupofilial, grupofilial, nomefilial, filialemi' +
        'ssao, data'
      ''
      ') AS rd'
      
        'ORDER BY upper(to_ascii(rd.NomeGrupoFilial,'#39'latin1'#39')), rd.GrupoF' +
        'ilial,'
      
        '         upper(to_ascii(rd.NomeFilial,'#39'latin1'#39')), rd.FilialEmiss' +
        'ao, rd.Data')
    RequestLive = False
    Left = 80
    Top = 503
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'AgruparGrupoFilial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'AgruparFilial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataFinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CodigoFiscalInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CodigoFiscalFinal'
        ParamType = ptUnknown
      end>
  end
  object qryResumoDiarioMapasECF: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
