    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';SELECT (SELECT MIN(Codigo)'
      '           FROM CodigosFiscais'
      '           WHERE Tipo   = '#39'A'#39' AND'
      '                 Codigo > 5000) AS MenorCodigo,'
      ''
      '       (SELECT  MAX(Codigo) FROM CodigosFiscais'
      '           WHERE Tipo   = '#39'A'#39' AND'
      '                 Codigo < 8000) AS MaiorCodigo;'
      '')
    RequestLive = False
