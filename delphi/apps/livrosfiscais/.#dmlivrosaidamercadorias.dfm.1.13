  object qryDadosFiscais_Notas_e_Cupons: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryDadosFiscaisBeforeOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'FiltroFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroSeries'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroIncluirNFCopiaECF'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'SELECT * FROM'
      '('
      ' ('
      '   SELECT grupofilial,'
      '          nomegrupofilial,'
      '          filialemissao,'
      '          nomefilial,'
      '          situacao,'
      '          numero,'
      '          estadocfo,'
      '          valortotal,'
      '          serie,'
      '          numeroinicial,'
      '          numerofinal,'
      '          data,'
      '          operacao,'
      '          case when :ExisteFiltroCodigo then false'
      '          else'
      '           ((notas.situacao='#39'N'#39') and'
      '            ((select sum(cdf.base+cdf.isentas+cdf.outras)'
      '              from CalculosDadosFiscais_(notas.dadofiscal) cdf'
      '              where cdf.dadofiscal = notas.dadofiscal'
      '                and cdf.tipo in ('#39'M'#39','#39'S'#39'))<>notas.valortotal))'
      '          end as diferente'
      '    FROM'
      '    ('
      '     SELECT grupofilial,'
      '             nomegrupofilial,'
      '             filialemissao,'
      '             nomefilial,'
      '             situacao,'
      '             numero,'
      '             estadocfo,'
      '             serie,'
      '             numeroinicial,'
      '             numerofinal,'
      '             data,'
      '             operacao, dadofiscal,'
      '             SUM(valortotal) as valortotal'
      '     from'
      '     ('
      '      ('
      '       SELECT distinct'
      
        '        case When :AgruparGrupoFilial then fgf.grupo            ' +
        '  else null end as grupofilial,'
      
        '        case When :AgruparGrupoFilial then gf.descricao         ' +
        'else null end as nomegrupofilial,'
      
        '        case When :AgruparFilial          then df.filialemissao ' +
        '     else null end as filialemissao,'
      
        '        case When :AgruparFilial          then f.nome           ' +
        '      else null end as nomefilial,'
      '        df.situacao,'
      '        df.numero as dadofiscal,'
      
        '        cast(cast(n.filial as varchar)||n.serie||cast(n.numero a' +
        's varchar) as varchar) as numero,'
      '        df.estadocfo,'
      ''
      '        case when :ExisteFiltroCodigo and (df.situacao='#39'N'#39') then'
      '                (select case when :ContribICMS then'
      
        '                             sum(cdf.base+cdf.isentas+cdf.outras' +
        ')'
      
        '                        else sum(cdf.base+cdf.isentas+cdf.outras' +
        '+cdf.valor)'
      '                        end'
      '                 from CalculosDadosFiscais_(n.dadofiscal) cdf'
      '                 where cdf.dadofiscal = n.dadofiscal'
      '                   and ((cdf.tipo='#39'M'#39' and :ContribICMS) or'
      '                        (cdf.tipo='#39'P'#39' and not :ContribICMS))'
      
        '                   and (cdf.codigofiscal between (:CodigoFiscalI' +
        'nicial) and (:CodigoFiscalFinal) or df.codigofiscal between (:Co' +
        'digoFiscalInicial) and (:CodigoFiscalFinal))'
      '                )'
      
        '             when df.situacao='#39'N'#39' then df.valortotal - coalesce(' +
        '(select sum(cdf2.base+cdf2.isentas+cdf2.outras)'
      
        '                                                                ' +
        ' from calculosdadosfiscais_(df.numero) cdf2'
      '      '#9#9#9#9#9#9'                 where cdf2.dadofiscal = df.numero'
      '      '#9#9#9#9#9#9'                   and cdf2.tipo='#39'S'#39
      
        '                                                                ' +
        ' ),0)'
      '             else 0'
      '        end as valortotal,'
      ''
      '    /*    df.codigofiscal,*/'
      '        n.serie,'
      '        n.numero as numeroinicial,'
      '        n.numero as numerofinal,'
      '        df.data,'
      '        case when (select count(*)'
      '                   from parcelas p'
      '                   Where p.contrato = (select ct.numero'
      '                                       from contratos ct'
      
        '                                       where ct.numero=df.contra' +
        'to))=0 then '#39'OUTRAS'#39'  else'
      '        case when (select count(*)'
      '                   from parcelas p'
      '                   Where p.contrato= (select ct.numero'
      '                                      from contratos ct'
      '    '#9#9#9'          where ct.numero=df.contrato)'
      '     '#9#9#9'    '#9'    and p.datavencto > (select ct.data'
      '    '#9#9#9#9#9#9#9'from contratos ct'
      '    '#9#9#9#9#9#9#9'where ct.numero=df.contrato))=0'
      
        '                                                                ' +
        '       then '#39'A VISTA'#39'    else                                   ' +
        '                                                                ' +
        '                                                                ' +
        '                         '#39'A PRAZO'#39'    end'
      '        end as Operacao'
      
        '      FROM (((dadosfiscais df join notas n on df.numero = n.dado' +
        'fiscal)'
      
        '                                         join (select * from cal' +
        'culosdadosfiscais_(:DataInicial,:DataFinal)) cdf on df.numero=cd' +
        'f.dadofiscal)'
      
        '                                         join (filiais f left jo' +
        'in (filiaisgruposfiliais fgf left join gruposfiliais gf on fgf.g' +
        'rupo=gf.codigo)'
      
        '                                                                ' +
        '                             on f.codigo=fgf.filial)'
      
        '                                                               o' +
        'n df.filialemissao=f.codigo)'
      '      Where cdf.tipo='#39'M'#39
      '        /* and df.codigofiscal not in (5933,6933,7933) */'
      '        and df.data between (:DataInicial) and (:DataFinal)'
      ''
      '        and ((exists (select cdf.codigofiscal'
      '                     from calculosdadosfiscais_(df.numero) cdf'
      '                     where cdf.dadofiscal = df.numero'
      
        '                       and cdf.codigofiscal between :CodigoFisca' +
        'lInicial and :CodigoFiscalFinal limit 1)) or'
      
        '                    (df.codigofiscal between :CodigoFiscalInicia' +
        'l and :CodigoFiscalFinal))'
      ''
      ''
      ''
      '      %FiltroFiliais'
      '      %FiltroSeries'
      '      %FiltroIncluirNFCopiaECF'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      '       SELECT distinct'
      
        '        case When :AgruparGrupoFilial then fgf.grupo            ' +
        'else null end as grupofilial,'
      
        '        case When :AgruparGrupoFilial then gf.descricao         ' +
        'else null end as nomegrupofilial,'
      
        '        case When :AgruparFilial          then df.filialemissao ' +
        'else null end as filialemissao,'
      
        '        case When :AgruparFilial          then f.nome           ' +
        'else null end as nomefilial,'
      '        df.situacao,'
      '        df.numero as dadofiscal,'
      
        '        cast(cast(n.filial as varchar)||n.serie||cast(n.numero a' +
        's varchar) as varchar) as numero,'
      '        df.estadocfo,'
      ''
      '        case when :ExisteFiltroCodigo and (df.situacao='#39'N'#39') then'
      '                (select sum(cdf.base+cdf.isentas+cdf.outras)'
      '                 from CalculosDadosFiscais_(n.dadofiscal) cdf'
      '                 where cdf.dadofiscal = n.dadofiscal'
      '                   and cdf.tipo='#39'S'#39
      
        '                   and (cdf.codigofiscal between (:CodigoFiscalI' +
        'nicial) and (:CodigoFiscalFinal) or df.codigofiscal between (:Co' +
        'digoFiscalInicial) and (:CodigoFiscalFinal))'
      '                )'
      
        '             when df.situacao='#39'N'#39' then coalesce((select sum(cdf2' +
        '.base+cdf2.isentas+cdf2.outras)'
      
        '                                                  from calculosd' +
        'adosfiscais_(df.numero) cdf2'
      '      '#9#9#9#9'                   where cdf2.dadofiscal = df.numero'
      '      '#9#9#9#9'                     and cdf2.tipo='#39'S'#39
      
        '                                                                ' +
        ' ),0)'
      '             else 0'
      '        end as valortotal,'
      ''
      
        '        /*cast(substring(cast(codigofiscal as varchar),1,1)||'#39'93' +
        '3'#39' as integer) as codigofiscal,*/'
      '        n.serie,'
      '        n.numero as numeroinicial,'
      '        n.numero as numerofinal,'
      '        df.data,'
      '        case when (select count(*)'
      '                   from parcelas p'
      '                   Where p.contrato=(select ct.numero'
      '                                     from contratos ct'
      
        '                                     where ct.numero=df.contrato' +
        '))=0 then '#39'OUTRAS'#39'  else'
      '        case when (select count(*)'
      '                   from parcelas p'
      '                   Where p.contrato=(select ct.numero'
      '                                     from contratos ct'
      
        '                                     where ct.numero=df.contrato' +
        ')'
      
        '                                       and p.datavencto > (selec' +
        't ct.data'
      
        '                                                           from ' +
        'contratos ct'
      
        '                                                           where' +
        ' ct.numero=df.contrato))=0'
      
        '                                                                ' +
        '     then '#39'A VISTA'#39'   else                                      ' +
        '                                                                ' +
        '                                                                ' +
        '                        '#39'A PRAZO'#39'    end'
      '        end as Operacao'
      
        '      FROM (((dadosfiscais df join notas n on df.numero = n.dado' +
        'fiscal)'
      
        '                                         join (select * from cal' +
        'culosdadosfiscais_(:DataInicial,:DataFinal)) cdf on df.numero=cd' +
        'f.dadofiscal)'
      
        '                                         join (filiais f left jo' +
        'in (filiaisgruposfiliais fgf left join gruposfiliais gf on fgf.g' +
        'rupo=gf.codigo)'
      
        '                                                                ' +
        '                             on f.codigo=fgf.filial)'
      
        '                                                               o' +
        'n df.filialemissao=f.codigo)'
      '      Where cdf.tipo = '#39'S'#39
      '       and df.data between (:DataInicial) and (:DataFinal)'
      '       and (((exists (select cdf.codigofiscal'
      '                    from calculosdadosfiscais_(df.numero) cdf'
      '                    where cdf.dadofiscal = df.numero'
      
        '                      and cdf.codigofiscal between (:CodigoFisca' +
        'lInicial) and (:CodigoFiscalFinal) limit 1)) or'
      '             (exists (select cdf.codigofiscal'
      '                    from calculosdadosfiscais_(df.numero) cdf'
      '                    where cdf.dadofiscal = df.numero'
      
        '                      and cast(substring(cast(cdf.codigofiscal a' +
        's varchar),1,1)||'#39'933'#39' as integer) between (:CodigoFiscalInicial' +
        ') and (:CodigoFiscalFinal) limit 1))) or'
      
        '                    (df.codigofiscal between :CodigoFiscalInicia' +
        'l and :CodigoFiscalFinal))'
      ''
      ''
      '      %FiltroFiliais'
      '      %FiltroSeries'
      '      %FiltroIncluirNFCopiaECF'
      ''
      '      )'
      '     ) as nota'
      '      group by grupofilial,'
      '               nomegrupofilial,'
      '               filialemissao,'
      '               nomefilial,'
      '               situacao,'
      '               numero,'
      '               estadocfo,'
      '               serie,'
      '               numeroinicial,'
      '               numerofinal,'
      '               data,'
      '               operacao, dadofiscal'
      '    ) as notas'
      '  )'
      '  union all'
      ' ('
      '  SELECT grupofilial,'
      '     nomegrupofilial,'
      '     filialemissao,'
      '     nomefilial,'
      '     situacao,'
      '     numero,'
      '     estadocfo,'
      '     valortotal,'
      '     serie,'
      '     numeroinicial,'
      '     numerofinal,'
      '     data,'
      '     operacao,'
      ''
      '     case when :ExisteFiltroCodigo then false'
      '     else'
      '      ((cupons.situacao='#39'N'#39') and'
      '       ((select sum(cdf.base+cdf.isentas+cdf.outras)'
      '         from CalculosDadosFiscais_(cupons.dadofiscal) cdf'
      '         where cdf.dadofiscal = cupons.dadofiscal'
      '           and cdf.tipo='#39'M'#39')<>cupons.valortotal))'
      '     end as diferente'
      '  FROM'
      '  ('
      '    SELECT distinct'
      
        '      case When :AgruparGrupoFilial then fgf.grupo              ' +
        'else null end as grupofilial,'
      
        '      case When :AgruparGrupoFilial then gf.descricao         el' +
        'se null end as nomegrupofilial,'
      
        '      case When :AgruparFilial          then df.filialemissao   ' +
        '   else null end as filialemissao,'
      
        '      case When :AgruparFilial          then f.nome             ' +
        '    else null end as nomefilial,'
      '      df.situacao,'
      '      df.numero as dadofiscal,'
      
        '      cast(cast(c.filial as varchar)||cast(c.maquina as varchar)' +
        '||cast(c.intervensao as varchar)||cast(c.numero as varchar) as v' +
        'archar)  as numero,'
      '      df.estadocfo,'
      ''
      '      case when :ExisteFiltroCodigo and (df.situacao='#39'N'#39') then'
      '              (select case when :ContribICMS then'
      '                           sum(cdf.base+cdf.isentas+cdf.outras)'
      
        '                      else sum(cdf.base+cdf.isentas+cdf.outras+c' +
        'df.valor)'
      '                      end'
      '               from CalculosDadosFiscais_(c.dadofiscal) cdf'
      '               where cdf.dadofiscal = c.dadofiscal'
      '                 and ((cdf.tipo='#39'M'#39' and :ContribICMS) or'
      '                      (cdf.tipo='#39'P'#39' and not :ContribICMS))'
      
        '                 and (cdf.codigofiscal between (:CodigoFiscalIni' +
        'cial) and (:CodigoFiscalFinal) or df.codigofiscal between (:Codi' +
        'goFiscalInicial) and (:CodigoFiscalFinal))'
      '              )'
      '           when df.situacao='#39'N'#39' then df.valortotal'
      '           else 0'
      '      end as valortotal,'
      ''
      '      /*    5102 as codigofiscal,*/'
      
        '      '#39'E'#39'||cast(c.maquina as varchar)||cast(c.intervensao as var' +
        'char) as serie,'
      '      c.numero as numeroinicial,'
      '      c.numero as numerofinal,'
      '      df.data,'
      '      case when (select count(*)'
      '                 from parcelas p'
      '                 Where p.contrato = (select ct.numero'
      '                                     from contratos ct'
      
        '                                     where ct.numero=df.contrato' +
        '))=0 then '#39'OUTRAS'#39'  else'
      '      case when (select count(*)'
      '                 from parcelas p'
      '                 Where p.contrato = (select ct.numero'
      '                                     from contratos ct'
      
        '                                     where ct.numero=df.contrato' +
        ')'
      
        '                                       and p.datavencto > (selec' +
        't ct.data'
      
        '                                                           from ' +
        'contratos ct'
      
        '                                                           where' +
        ' ct.numero=df.contrato))=0'
      
        '                                                                ' +
        '     then '#39'A VISTA'#39'  else                                       ' +
        '                                                                ' +
        '                                                                ' +
        '                      '#39'A PRAZO'#39'    end'
      '      end as Operacao'
      
        '      FROM (((dadosfiscais df join cupons c on df.numero = c.dad' +
        'ofiscal)'
      
        '                                       join (select * from calcu' +
        'losdadosfiscais_(:DataInicial,:DataFinal)) cdf on df.numero=cdf.' +
        'dadofiscal)'
      
        '                                       left join (filiais f left' +
        ' join (filiaisgruposfiliais fgf left join gruposfiliais gf on fg' +
        'f.grupo=gf.codigo)'
      
        '                                                                ' +
        '                           on f.codigo=fgf.filial)'
      
        '                                                             on ' +
        'df.filialemissao=f.codigo)'
      '      Where cdf.tipo='#39'M'#39
      '       and df.data between (:DataInicial) and (:DataFinal)'
      ''
      '        and ((exists (select cdf.codigofiscal'
      '                     from calculosdadosfiscais_(df.numero) cdf'
      '                     where cdf.dadofiscal = df.numero'
      
        '                       and cdf.codigofiscal between :CodigoFisca' +
        'lInicial and :CodigoFiscalFinal limit 1)) or'
      
        '                    (df.codigofiscal between :CodigoFiscalInicia' +
        'l and :CodigoFiscalFinal))'
      ''
      ''
      ''
      '      %FiltroFiliais'
      ''
      ''
      '   ) as cupons'
      '  )'
      ') AS df'
      '/*where diferente*/'
      
        'ORDER BY upper(to_ascii(df.NomeGrupoFilial,'#39'latin1'#39')), df.Grupof' +
        'ilial,'
      
        '         upper(to_ascii(df.NomeFilial,'#39'latin1'#39')), df.FilialEmiss' +
        'ao,'
      '         df.Data, df.NumeroInicial, df.NumeroFinal, df.numero,'
      '         df.Serie, df.Situacao,'
      '         df.EstadoCFO')
    RequestLive = False
    Left = 71
    Top = 215
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'ExisteFiltroCodigo'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'AgruparGrupoFilial'
        ParamType = ptUnknown
        Value = 'false'
      end
      item
        DataType = ftString
        Name = 'AgruparFilial'
        ParamType = ptUnknown
        Value = 'false'
      end
      item
        DataType = ftUnknown
        Name = 'ContribICMS'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'CodigoFiscalInicial'
        ParamType = ptUnknown
        Value = '0'
      end
      item
        DataType = ftString
        Name = 'CodigoFiscalFinal'
        ParamType = ptUnknown
        Value = '99999'
      end
      item
        DataType = ftString
        Name = 'DataInicial'
        ParamType = ptUnknown
        Value = #39'2009-01-01'#39
      end
      item
        DataType = ftString
        Name = 'DataFinal'
        ParamType = ptUnknown
        Value = #39'2009-01-31'#39
      end>
  end
  object qryDadosFiscais_Notas_e_CuponsAgrupados: TtecQuery
    Tag = -1
