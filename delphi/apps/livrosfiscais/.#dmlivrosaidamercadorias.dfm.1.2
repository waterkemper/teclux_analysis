    Sql.Strings = (
      ';'
      'select cdf.dadofiscal,'
      '       cdf.tipo,'
      '       cdf.aliquota,'
      '       cdf.codigofiscal,'
      '       sum(base) as base,'
      '       sum(valor) as valor'
      'from'
      '('
      '  select cdf.dadofiscal,'
      '         cast(1 as smallint) as tipo,'
