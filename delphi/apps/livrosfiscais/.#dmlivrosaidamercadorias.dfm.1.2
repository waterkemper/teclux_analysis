      '              and cdf.tipo='#39'M'#39
      '              and df.situacao='#39'N'#39
      '              and cdf.codigofiscal not in (5933,6933,7933)'
      
        '              and cdf.codigofiscal between (:CodigoFiscalInicial' +
        ') and (:CodigoFiscalFinal)'
      '        )'
      '       else df.valortotal'
      '       end'
      '  else 0'
      '  end as valortotal,'
      ''
      '  n.serie,'
      '  n.numero as numeroinicial,'
      '  n.numero as numerofinal,'
      '  n.filial,'
      '  df.data,'
      ''
      '  (select sum(cdf.base+cdf.isentas+cdf.outras)'
      '   from calculosdadosfiscais cdf'
      '   Where cdf.dadofiscal = df.numero'
      '        and cdf.tipo='#39'M'#39
      '        and df.situacao='#39'N'#39') as valortotal_icms,'
      ''
      '  (select sum(cdf.valor+cdf.base+cdf.isentas+cdf.outras)'
      '   from calculosdadosfiscais cdf'
      '   Where cdf.dadofiscal = df.numero'
      '        and cdf.tipo='#39'P'#39
      '        and df.situacao='#39'N'#39') as valortotal_ipi,'
      ''
      
        '  /*substr(df.observacoes,0,strpos(df.observacoes,chr(13))) as o' +
        'bservacao,*/'
      '  cast(null as text) as observacao,'
      
        '  case when (select count(*)  from parcelas p Where p.contrato =' +
        ' df.contrato)=0 then '#39'OUTRAS'#39'  else'
      
        '   case when (select count(*) from parcelas p Where p.contrato= ' +
        'df.contrato and'
      
        '                                   p.datavencto > (select ct.dat' +
        'a from contratos ct where ct.numero=df.contrato))=0             ' +
        '       then '#39'A VISTA'#39'      else'
      
        '                                                                ' +
        '                                                                ' +
        '                                                            '#39'A P' +
        'RAZO'#39'    end'
      '  end as Operacao'
      ''
      'FROM dadosfiscais df join notas n on df.numero = n.dadofiscal'
      'Where df.data between (:DataInicial) and (:DataFinal)'
      '      and df.codigofiscal not in (5933,6933,7933)'
      '      and exists (select cdf.codigofiscal'
      '                  from calculosdadosfiscais cdf'
      '                  where cdf.dadofiscal = df.numero'
      
        '                    and cdf.codigofiscal between (:CodigoFiscalI' +
        'nicial) and (:CodigoFiscalFinal) limit 1)'
      '%FiltroFiliais'
      '%FiltroSeries'
      '%FiltroIncluirNFCopiaECF'
      ''
      'ORDER BY df.Data, n.Serie, n.numero'
      '')
