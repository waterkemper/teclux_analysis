      item
        DataType = ftUnknown
        Name = 'FiltroSeries'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'SELECT * FROM('
      'select temp.*,'
      '              CAST(titulo.codigo AS INTEGER) as titulo,'
      
        '              CAST(titulo.descricao AS VARCHAR) as descricaotitu' +
        'lo,'
      '              CAST( (select subtitulo.codigo'
      #9'            from codigosfiscais subtitulo'
      #9#9#9' where subtitulo.codigo<temp.codigofiscal'
      
        #9#9#9'   and tipo='#39'S'#39' order by subtitulo.codigo desc limit 1) AS IN' +
        'TEGER) as subtitulo,'
      '              CAST( (select subtitulo.descricao'
      #9'            from codigosfiscais subtitulo'
      #9#9#9' where subtitulo.codigo<temp.codigofiscal'
      
        #9#9#9'   and tipo='#39'S'#39' order by subtitulo.codigo desc limit 1) AS VA' +
        'RCHAR) as descricaosubtitulo'
      'from'
      '('
      ' SELECT       CAST(SUM(valortotal) AS NUMERIC) as valortotal,'
      '              CAST(SUM(base) AS NUMERIC) as base,'
      '              CAST(SUM(valor) AS NUMERIC) as valor,'
      '              CAST(SUM(isentas) AS NUMERIC) as isentas,'
      '              CAST(SUM(outras) AS NUMERIC) as outras,'
      '              codigofiscal,'
      '              cf.descricao'
      'FROM'
      '('
      '  ('
      '    select'
      '    cdf.codigofiscal,'
      '    sum(cdf.base+cdf.isentas+cdf.outras) as valortotal,'
      '    sum(cdf.base) as base,'
      '    sum(cdf.valor) as valor,'
      '    sum(cdf.isentas) as isentas,'
      '    sum(cdf.outras) as outras'
      
        '    FROM dadosfiscais df join calculosdadosfiscais cdf on df.num' +
        'ero = cdf.dadofiscal'
      
        '                         join notas n on df.numero = n.dadofisca' +
        'l'
      ''
      '    Where df.data between (:DataInicial) and (:DataFinal)'
      '     and df.situacao='#39'N'#39
      '     and cdf.tipo='#39'M'#39
      '     and cdf.codigofiscal not in (5933,6933,7933)'
      
        '     and cdf.codigofiscal between (:CodigoFiscalInicial) and (:C' +
        'odigoFiscalFinal)'
      '    %FiltroFiliais'
      '    %FiltroSeries'
      '    group by cdf.codigofiscal'
      '  )'
      
        ') as temp left join CodigosFiscais cf on temp.codigofiscal=cf.co' +
        'digo'
      'group by codigofiscal, cf.descricao'
      ') as temp'
      
        '              left join CodigosFiscais titulo on cast(substring(' +
        'cast(codigofiscal as varchar) from 1 for 1)||'#39'000'#39' as integer)=t' +
        'itulo.codigo'
      ') AS rs'
      ''
      'ORDER BY rs.titulo,'
      
        '         upper(to_ascii(rs.DescricaoTitulo,'#39'latin1'#39')), rs.Subtit' +
        'ulo,'
      
        '         upper(to_ascii(rs.DescricaoSubTitulo,'#39'latin1'#39')), rs.Cod' +
        'igoFiscal,'
      '         upper(to_ascii(rs.Descricao,'#39'latin1'#39'))'
      '')
