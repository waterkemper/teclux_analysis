    Sql.Strings = (
      ';'
      'select cdf.dadofiscal,'
      '       cdf.tipo,'
      '       cdf.aliquota,'
      '       cdf.codigofiscal,'
      '       sum(base) as base,'
      '       sum(valor) as valor'
      'from'
      '('
      '  select cdf.dadofiscal,'
      '         cast(1 as smallint) as tipo,'
      '         cdf.aliquota,'
      '         cdf.codigofiscal,'
      
        '         case when df.situacao='#39'N'#39' then cdf.base else 0 end as b' +
        'ase,'
      
        '         case when df.situacao='#39'N'#39' then cdf.valor else 0 end as ' +
        'valor'
      
        '  from (dadosfiscais df join (select * from calculosdadosfiscais' +
