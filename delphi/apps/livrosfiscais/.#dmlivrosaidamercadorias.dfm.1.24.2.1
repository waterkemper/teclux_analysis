  object qryResumoSintetico_Aux: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'FiltroSeries'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroIncluirNFCopiaECF'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';SELECT * FROM'
      '('
      'select temp.*,'
      '              CAST(titulo.codigo AS INTEGER) as titulo,'
      
        '              CAST(titulo.descricao AS VARCHAR) as descricaotitu' +
        'lo,'
      '              CAST( (select subtitulo.codigo'
      #9'            from codigosfiscais subtitulo'
      #9#9#9' where subtitulo.codigo<temp.codigofiscal'
      
        #9#9#9'   and tipo='#39'S'#39' order by subtitulo.codigo desc limit 1) AS IN' +
        'TEGER) as subtitulo,'
      '              CAST( (select subtitulo.descricao'
      #9'            from codigosfiscais subtitulo'
      #9#9#9' where subtitulo.codigo<temp.codigofiscal'
      
        #9#9#9'   and tipo='#39'S'#39' order by subtitulo.codigo desc limit 1) AS VA' +
        'RCHAR) as descricaosubtitulo'
      'from'
      '('
      ' SELECT       CAST(SUM(valortotal) AS NUMERIC) as valortotal,'
      '              CAST(SUM(base) AS NUMERIC) as base,'
      '              CAST(SUM(valor) AS NUMERIC) as valor,'
      '              CAST(SUM(isentas) AS NUMERIC) as isentas,'
      '              CAST(SUM(outras) AS NUMERIC) as outras,'
      '              CAST(codigofiscal AS INTEGER) as codigofiscal,'
      '              CAST(cf.descricao AS VARCHAR) as descricao'
      'FROM'
      ' ('
      '  ('
      ''
      '  SELECT codigofiscal,'
      '         sum(base+isentas+outras) as valortotal,'
      '         sum(base) as base,'
      '         sum(valor) as valor,'
      '         sum(isentas) as isentas,'
      '         sum(outras) as outras'
      ''
      '  FROM'
      '  ('
      '    ('
      '     SELECT  '
      
        '      case When df.CodigoFiscal in (5929,6929) then df.codigofis' +
        'cal else cdf.CodigoFiscal end as CodigoFiscal,'
      
        '      case When df.CodigoFiscal in (5929,6929) then 0 else (case' +
        ' When df.situacao='#39'N'#39' then cdf.base else 0 end) end as base,'
      
        '      case When df.CodigoFiscal in (5929,6929) then 0 else (case' +
        ' When df.situacao='#39'N'#39' then cdf.valor else 0 end) end as valor,'
      
        '      case When df.CodigoFiscal in (5929,6929) then 0 else (case' +
        ' When df.situacao='#39'N'#39' then cdf.isentas else 0 end) end as isenta' +
        's,'
      '      case When df.situacao='#39'N'#39' then'
      '       (case When df.CodigoFiscal in (5929,6929) then'
      '         (cdf.base+cdf.isentas+cdf.outras)'
      '        else cdf.outras end) else 0 end as outras'
      ''
      
        '    FROM ((dadosfiscais df join notas n on df.numero = n.dadofis' +
        'cal)'
      
        '                                       join (select * from calcu' +
        'losdadosfiscais_(:DataInicial,:DataFinal,false)) cdf on df.numer' +
        'o=cdf.dadofiscal)'
      '                                                             '
      ''
      '    Where cdf.tipo='#39'M'#39
      '      and cdf.codigofiscal not in (5933,6933,7933)'
      '      and df.data between (:DataInicial) and (:DataFinal)'
      '      /*and df.filialemissao = :filialemissao*/'
      
        '      and (df.filialemissao  = :filialemissao or df.filialemissa' +
        'o in (select f.codigo from filiais f where f.filialconsolidadora' +
        'dime  = :filialemissao))'
      
        '      and (cdf.codigofiscal between (:CodigoFiscalInicial) and (' +
        ':CodigoFiscalFinal) or'
      
        '           df.codigofiscal between (:CodigoFiscalInicial) and (:' +
        'CodigoFiscalFinal))'
      ''
      '    %FiltroSeries'
      '    %FiltroIncluirNFCopiaECF'
      ''
      '    )'
      #9
      '    union all'
      #9
      '    ('
      '    SELECT'
      
        '      cast(substring(cast(cdf.codigofiscal as varchar),1,1)||'#39'93' +
        '3'#39' as integer) as codigofiscal,'
      '      0.00 as base,'
      '      0.00 as valor,'
      '      0.00 as isentas,'
      
        '      case When df.situacao='#39'N'#39' then cdf.base+cdf.isentas+cdf.ou' +
        'tras else 0 end as outras'
      ''
      
        '    FROM ((dadosfiscais df join notas n on df.numero = n.dadofis' +
        'cal)'
      
        '                                       join (select * from calcu' +
        'losdadosfiscais_(:DataInicial,:DataFinal,false)) cdf on df.numer' +
        'o=cdf.dadofiscal)'
      '    Where cdf.tipo = '#39'S'#39
      '     and df.data between (:DataInicial) and (:DataFinal)'
      #9'    /*and df.filialemissao = :filialemissao*/'
      
        '      and (df.filialemissao  = :filialemissao or df.filialemissa' +
        'o in (select f.codigo from filiais f where f.filialconsolidadora' +
        'dime  = :filialemissao))'
      
        '     and (cdf.codigofiscal between (:CodigoFiscalInicial) and (:' +
        'CodigoFiscalFinal) or'
      
        '          df.codigofiscal between (:CodigoFiscalInicial) and (:C' +
        'odigoFiscalFinal) or'
      
        '          cast(substring(cast(cdf.codigofiscal as varchar),1,1)|' +
        '|'#39'933'#39' as integer) between (:CodigoFiscalInicial) and (:CodigoFi' +
        'scalFinal))'
      ''
      '    %FiltroSeries'
      '    %FiltroIncluirNFCopiaECF'
      ''
      '    )'
      '  ) as notascalculos'
      '    group by codigofiscal'
      ' )'
      'union all'
      ' ('
      
        #9#9'select codigofiscal, sum(valortributado+isentas+naotributadas+' +
        'outras) as valortotal,'
      #9'           sum(valortributado) as base,'
      '               sum(valoricms) as valor, '
      #9#9#9'   sum(isentas + naotributadas) as isentas, '
      #9#9#9'   sum(outras) as outras'#9#9#9'   '
      #9#9'FROM'
      #9#9'('
      #9#9'('
      #9#9'select  cast(5405 as integer) as codigofiscal,'
      '    '#9#9'    0.00 as valortributado,'
      #9#9#9'      0.00 as valoricms,'
      
        #9#9#9'      sum(case when rzd.tipototalizadorparcial='#39'I1'#39' then rzd.' +
        'valoracumulado else 0.00 end) as isentas,'
      
        #9#9#9'      sum(case when rzd.tipototalizadorparcial='#39'N1'#39' then rzd.' +
        'valoracumulado else 0.00 end) as naotributadas,'
      
        #9#9#9'      sum(case when rzd.tipototalizadorparcial='#39'F1'#39' then rzd.' +
        'valoracumulado else 0.00 end) as outras'
      ''
      #9#9'from reducoesz rz'
      #9#9#9' join reducoeszdetalhes rzd'
      #9#9#9' on rz.filial = rzd.filial'
      #9#9#9' and rz.numerousuario = rzd.numerousuario'
      #9#9#9' and rz.cro = rzd.cro'
      #9#9#9' and rz.numerofabricacao = rzd.numerofabricacao'
      #9#9#9' and rz.datamovimento = rzd.datamovimento'
      ''
      #9#9'where rz.datamovimento between :datainicial and :datafinal'
      #9#9'  and rzd.tipototalizadorparcial  in ('#39'F1'#39', '#39'N1'#39', '#39'I1'#39')'
      '/*      and rz.filial = :filialemissao */'
      
        '      and (rz.filial  = :filialemissao or rz.filial in (select f' +
        '.codigo from filiais f where f.filialconsolidadoradime  = :filia' +
        'lemissao))'
      
        '      and (5405 between :CodigoFiscalInicial and :CodigoFiscalFi' +
        'nal)'
      ''
      #9#9')'
      ''
      #9#9'union all'
      ''
      #9#9'('
      #9#9'select cast(5102 as integer) as codigofiscal,'
      #9#9#9'     rzd.valoracumulado as valortributado,'
      '    '#9#9#9' (rzd.valoracumulado * rzd.aliquota)/100 as valoricms,'
      '    '#9#9#9' 0.00 as isentas,'
      #9#9'    '#9' 0.00 as naotributadas,'
      '    '#9#9#9' 0.00 as outras'
      ''
      #9#9'from reducoesz rz'
      #9#9#9' join reducoeszdetalhes rzd'
      #9#9#9' on rz.filial = rzd.filial'
      #9#9#9' and rz.numerousuario = rzd.numerousuario'
      #9#9#9' and rz.cro = rzd.cro'
      #9#9#9' and rz.numerofabricacao = rzd.numerofabricacao'
      #9#9#9' and rz.datamovimento = rzd.datamovimento'
      ''
      #9#9'where rz.datamovimento between :datainicial and :datafinal'
      '/*      and rz.filial = :filialemissao */'
      
        '      and (rz.filial  = :filialemissao or rz.filial in (select f' +
        '.codigo from filiais f where f.filialconsolidadoradime  = :filia' +
        'lemissao))'
      ''
      #9#9'  and coalesce(rzd.aliquota,0)<>0'
      #9#9'  and rzd.tipototalizadorparcial  not in ('#39'F1'#39', '#39'N1'#39', '#39'I1'#39')'
      
        '      and (5102 between :CodigoFiscalInicial and :CodigoFiscalFi' +
        'nal)'
      #9#9')'
      ''
      #9#9') as detalhes'
      #9#9'group by codigofiscal'
      ''
      ' )'
      
        ') as temp left join CodigosFiscais cf on temp.codigofiscal=cf.co' +
        'digo'
      'group by codigofiscal, cf.descricao'
      ') as temp'
      
        '              left join CodigosFiscais titulo on cast(substring(' +
        'cast(codigofiscal as varchar) from 1 for 1)||'#39'000'#39' as integer)=t' +
        'itulo.codigo'
      ') as rs'
      ''
      'ORDER BY rs.Titulo,'
      
        '         upper(to_ascii(rs.DescricaoTitulo,'#39'latin1'#39')), rs.Subtit' +
        'ulo,'
      
        '         upper(to_ascii(rs.DescricaoSubTitulo,'#39'latin1'#39')), rs.Cod' +
        'igoFiscal,'
      '         upper(to_ascii(rs.Descricao,'#39'latin1'#39'))')
    RequestLive = False
    Left = 152
    Top = 455
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'DataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataFinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filialemissao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CodigoFiscalInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CodigoFiscalFinal'
        ParamType = ptUnknown
      end>
  end
  object qryCalculosDadosFiscais_Notas_e_Cupons: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'FiltroSeries'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroIncluirNFCopiaECF'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'SELECT numero,'
      '       codigofiscal,'
      '       base,'
      '       aliquota,'
      '       valor,'
      '       isentas,'
      '       outras,'
      '       cast(observacao as varchar(50)) as observacao,'
      '       operacao'
      'FROM'
      '('
      '  ('
      
        '   select numero, codigofiscal, sum(base) as base, aliquota, sum' +
        '(valor) as valor, sum(isentas) as isentas, sum(outras) as outras' +
        ','
      '          observacao, operacao'
      '   from'
      '      ('
      '       SELECT'
      
        '        cast(cast(n.filial as varchar)||n.serie||cast(n.numero a' +
        's varchar) as varchar) as numero,'
      
        '        case When df.CodigoFiscal in (5929,6929) then cast(5929 ' +
        'as integer) else cdf.codigofiscal end as codigofiscal,'
      
        '        case When df.CodigoFiscal in (5929,6929) then 0 else (ca' +
        'se When df.situacao='#39'N'#39' then cdf.base else 0 end) end as base,'
      
        '        case When df.CodigoFiscal in (5929,6929) then 0 else cdf' +
        '.aliquota  end as aliquota,'
      
        '        case When df.CodigoFiscal in (5929,6929) then 0 else (ca' +
        'se When df.situacao='#39'N'#39' then cdf.valor else 0 end) end as valor,'
      
        '        case When df.CodigoFiscal in (5929,6929) then 0 else (ca' +
        'se When df.situacao='#39'N'#39' then cdf.isentas else 0 end) end as isen' +
        'tas,'
      '        case When df.situacao='#39'N'#39' then'
      '         (case When df.CodigoFiscal in (5929,6929) then'
      '           (cdf.base+cdf.isentas+cdf.outras)'
      '          else cdf.outras end) else 0 end as outras,'
      
        '        case When df.CodigoFiscal in (5929,6929) then '#39'CF M-'#39'||c' +
        'ast(c.maquina as varchar)||'#39' '#39'||cast(c.numero as varchar)||'#39' '#39'||' +
        'substr(df.observacoes,0,strpos(df.observacoes,chr(10)))'
      
        '               else  substr(df.observacoes,0,strpos(df.observaco' +
        'es,chr(10))) end as observacao,'
      
        '        case when (select count(*)  from parcelas p Where p.cont' +
        'rato=(select ct.numero from contratos ct where ct.numero=df.cont' +
        'rato))=0 then '#39'OUTRAS'#39'  else'
      
        '        case when (select count(*) from parcelas p Where p.contr' +
        'ato=(select ct.numero from contratos ct where ct.numero=df.contr' +
        'ato) and'
      
        '                                                        p.datave' +
        'ncto > (select ct.data from contratos ct where ct.numero=df.cont' +
        'rato))=0                    then '#39'A VISTA'#39'      else'
      
        '                                                                ' +
