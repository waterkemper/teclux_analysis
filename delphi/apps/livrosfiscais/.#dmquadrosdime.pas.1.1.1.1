         qryq02_NotasSaidasCalculosbase.AsCurrency := 0.00;
         qryq02_NotasSaidasCalculosvalor.AsCurrency := q_01_valor + qryQuadrosDIMEsaldocredormesant.AsCurrency - q_02_valor;
         qryq02_NotasSaidasCalculosisentas.AsCurrency := 0.00;
         qryq02_NotasSaidasCalculosoutras.AsCurrency := 0.00;
         qryq02_NotasSaidasCalculos.Post;
         q_02_valor := q_02_valor + qryq02_NotasSaidasCalculosvalor.AsCurrency;
         q_09_150_s_transf_cred  := qryq02_NotasSaidasCalculosvalor.AsCurrency;
       end
       else
       if (q_01_valor + qryQuadrosDIMEsaldocredormesant.AsCurrency) < q_02_valor then
       begin
         qryq02_NotasSaidasCalculos.Append;
         qryq02_NotasSaidasCalculosfilial.AsInteger := qryQuadrosDIMEfilial.AsInteger;
         qryq02_NotasSaidasCalculosperiodo.AsString := qryQuadrosDIMEperiodo.AsString;
