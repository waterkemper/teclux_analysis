procedure TdtmQuadrosDIME.Atualizaq_01Consolidado;
begin
  qryq01_NotasEntradasCalculos.AfterPost := nil;
  qryq01_NotasEntradasCalculos.AfterDelete := nil;

  qryq01_NotasEntradasCalculos.First;
  while not qryq01_NotasEntradasCalculos.Eof do
  begin
    if (qryq01_NotasEntradasCalculoscodigofiscal.AsInteger = 1602) or
       (qryq01_NotasEntradasCalculoscodigofiscal.AsInteger = 1605) then
      qryq01_NotasEntradasCalculos.Delete
    else
      qryq01_NotasEntradasCalculos.Next;
  end;

  if qryQuadrosDIMEq00_070_apuracaoconsolidada.AsInteger = 2 then
  begin
    ReFazConsulta(qryMovTransfSaldoConsolidado, [0,1],
    [qryQuadroSDIMEfilial.AsVariant, qryQuadrosDIMEperiodo.AsVariant]);
    if qryMovTransfSaldoConsolidadocredito.AsCurrency > 0 then
    begin
       qryq01_NotasEntradasCalculos.Append;
       qryq01_NotasEntradasCalculosfilial.AsVariant := qryQuadroSDIMEfilial.AsVariant;
       qryq01_NotasEntradasCalculosperiodo.AsVariant := qryQuadrosDIMEperiodo.AsVariant;
       qryq01_NotasEntradasCalculoscodigofiscal.AsVariant := 1602;
       qryq01_NotasEntradasCalculosdescricao.AsVariant := 'ENTRADA TRANSF. CREDITO CONSOLIDADO';
       qryq01_NotasEntradasCalculosvalornota.AsCurrency := 0.00;
       qryq01_NotasEntradasCalculosbase.AsCurrency := 0.00;
       qryq01_NotasEntradasCalculosvalor.AsCurrency := qryMovTransfSaldoConsolidadocredito.AsCurrency;
       qryq01_NotasEntradasCalculosisentas.AsCurrency := 0.00;
       qryq01_NotasEntradasCalculosoutras.AsCurrency := 0.00;
       qryq01_NotasEntradasCalculos.post;
    end;
    if qryMovTransfSaldoConsolidadodebito.AsCurrency > 0 then
    begin
       qryq01_NotasEntradasCalculos.Append;
       qryq01_NotasEntradasCalculosfilial.AsVariant := qryQuadroSDIMEfilial.AsVariant;
       qryq01_NotasEntradasCalculosperiodo.AsVariant := qryQuadrosDIMEperiodo.AsVariant;
       qryq01_NotasEntradasCalculoscodigofiscal.AsVariant := 1605;
       qryq01_NotasEntradasCalculosdescricao.AsVariant := 'ENTRADA TRANSF. DEBITO CONSOLIDADO';
       qryq01_NotasEntradasCalculosvalornota.AsCurrency := 0.00;
       qryq01_NotasEntradasCalculosbase.AsCurrency := 0.00;
       qryq01_NotasEntradasCalculosvalor.AsCurrency := qryMovTransfSaldoConsolidadodebito.AsCurrency;
       qryq01_NotasEntradasCalculosisentas.AsCurrency := 0.00;
       qryq01_NotasEntradasCalculosoutras.AsCurrency := 0.00;
       qryq01_NotasEntradasCalculos.post;
    end;
  end;

 qryq01_NotasEntradasCalculos.AfterPost := qryq01_NotasEntradasCalculosAfterPost;
 qryq01_NotasEntradasCalculos.AfterDelete := qryq01_NotasEntradasCalculosAfterPost;
end;

function TdtmQuadrosDIME.ValidarCreditomesseguinte: boolean;
begin
  result := true;
  if qryQuadrosDIMEq09_998_SaldoCredPerSeguinte_calculado.AsCurrency <> 0 then
     if qryQuadrosDIMEq09_160_saldocredorcredrelexport.AsCurrency +
        qryQuadrosDIMEq09_170_saldocredorcredrelsaidisent.AsCurrency +
        qryQuadrosDIMEq09_180_saldocredorcredrelsaidif.AsCurrency +
        qryQuadrosDIMEq09_190_saldocredordeoutroscreditos.AsCurrency <>
        qryQuadrosDIMEq09_998_SaldoCredPerSeguinte_calculado.AsCurrency then
     begin
       result := false;
       MensagemErro('Quadro 09'+#13#10+
                    'O saldo credor para o mês seguinte não está fechando com as discriminações.');
     end;
end;

