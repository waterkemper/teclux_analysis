         qryq02_NotasSaidasCalculosdescricao.AsString := 'TRANSFERENCIA DE DEBITO DE ICMS';
         qryq02_NotasSaidasCalculosvalornota.AsCurrency := 0.00;
         qryq02_NotasSaidasCalculosbase.AsCurrency := 0.00;
         qryq02_NotasSaidasCalculosvalor.AsCurrency := q_02_valor - q_01_valor;
         qryq02_NotasSaidasCalculosisentas.AsCurrency := 0.00;
         qryq02_NotasSaidasCalculosoutras.AsCurrency := 0.00;
         qryq02_NotasSaidasCalculos.Post;
         q_02_valor := q_02_valor + qryq02_NotasSaidasCalculosvalor.AsCurrency;
         q_09_130_s_transf_deb := qryq02_NotasSaidasCalculosvalor.AsCurrency;
