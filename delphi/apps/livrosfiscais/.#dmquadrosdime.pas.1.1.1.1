function TdtmQuadrosDIME.GravarQuadroDIME: Boolean;
begin
  result := qryQuadroSDIME.CheckRequiredFields;
  if result then
  begin
    qryq01_NotasEntradasCalculos.AfterPost := nil;
    qryq01_NotasEntradasCalculos.First;
    while not qryq01_NotasEntradasCalculos.Eof do
    begin
     qryq01_NotasEntradasCalculos.edit;
     qryq01_NotasEntradasCalculosfilial.AsVariant := qryQuadrosDIMEfilial.AsVariant;
     qryq01_NotasEntradasCalculosperiodo.AsVariant := qryQuadrosDIMEperiodo.AsVariant;
     qryq01_NotasEntradasCalculos.Post;
     qryq01_NotasEntradasCalculos.Next;
    end;
    qryq01_NotasEntradasCalculos.AfterPost := qryq01_NotasEntradasCalculosAfterPost;

    result := qryq01_NotasEntradasCalculos.IsEmpty or
              qryq01_NotasEntradasCalculos.CheckRequiredFields;
    if result then
    begin
      qryq02_NotasSaidasCalculos.AfterPost := nil;
      qryq02_NotasSaidasCalculos.First;
      while not qryq02_NotasSaidasCalculos.Eof do
      begin
       qryq02_NotasSaidasCalculos.edit;
       qryq02_NotasSaidasCalculosfilial.AsVariant := qryQuadrosDIMEfilial.AsVariant;
       qryq02_NotasSaidasCalculosperiodo.AsVariant := qryQuadrosDIMEperiodo.AsVariant;
       qryq02_NotasSaidasCalculos.Post;
       qryq02_NotasSaidasCalculos.Next;
      end;
      qryq02_NotasSaidasCalculos.AfterPost := qryq02_NotasSaidasCalculosAfterPost;

      result := qryq02_NotasSaidasCalculos.IsEmpty or
                qryq02_NotasSaidasCalculos.CheckRequiredFields;
      if result then
      begin
        qryq12_discrpagtos.First;
        while not qryq12_discrpagtos.Eof do
        begin
         qryq12_discrpagtos.edit;
         qryq12_discrpagtosfilial.AsVariant := qryQuadrosDIMEfilial.AsVariant;
         qryq12_discrpagtosperiodo.AsVariant := qryQuadrosDIMEperiodo.AsVariant;
         qryq12_discrpagtos.Post;
         qryq12_discrpagtos.Next;
        end;
        result := qryq12_discrpagtos.IsEmpty or
                  qryq12_discrpagtos.CheckRequiredFields;

        if result then
        begin
          qryq46_RegimeEspecial.AfterPost := nil;
          qryq46_RegimeEspecial.First;
          while not qryq46_RegimeEspecial.Eof do
          begin
           qryq46_RegimeEspecial.edit;
           qryq46_RegimeEspecialfilial.AsVariant := qryQuadrosDIMEfilial.AsVariant;
           qryq46_RegimeEspecialperiodo.AsVariant := qryQuadrosDIMEperiodo.AsVariant;
           qryq46_RegimeEspecial.Post;
           qryq46_RegimeEspecial.Next;
          end;
          qryq46_RegimeEspecial.AfterPost := qryq46_RegimeEspecialAfterPost;
          result := qryq46_RegimeEspecial.IsEmpty or
                    qryq46_RegimeEspecial.CheckRequiredFields;
          if result then
          begin
           qryq47_compraexproagrop.AfterPost := nil;
           qryq47_compraexproagrop.First;
           while not qryq47_compraexproagrop.Eof do
           begin
             qryq47_compraexproagrop.edit;
             qryq47_compraexproagropfilial.AsVariant := qryQuadrosDIMEfilial.AsVariant;
             qryq47_compraexproagropperiodo.AsVariant := qryQuadrosDIMEperiodo.AsVariant;
             qryq47_compraexproagrop.Post;
             qryq47_compraexproagrop.Next;
           end;
           qryq47_compraexproagrop.AfterPost := qryq47_compraexproagropAfterPost;
           result := qryq47_compraexproagrop.IsEmpty or
                     qryq47_compraexproagrop.CheckRequiredFields;
           if result then
           begin
             qryq48_recprestservfornenereletrica.AfterPost := nil;
             qryq48_recprestservfornenereletrica.First;
             while not qryq48_recprestservfornenereletrica.Eof do
             begin
               qryq48_recprestservfornenereletrica.edit;
               qryq48_recprestservfornenereletricafilial.AsVariant := qryQuadrosDIMEfilial.AsVariant;
               qryq48_recprestservfornenereletricaperiodo.AsVariant := qryQuadrosDIMEperiodo.AsVariant;
               qryq48_recprestservfornenereletrica.Post;
               qryq48_recprestservfornenereletrica.Next;
             end;
             qryq48_recprestservfornenereletrica.AfterPost := qryq48_recprestservfornenereletricaAfterPost;
             result := qryq48_recprestservfornenereletrica.IsEmpty or
                       qryq48_recprestservfornenereletrica.CheckRequiredFields;
             if result then
             begin
               qryq49_entmercbensaqservicos.AfterPost := nil;
               qryq49_entmercbensaqservicos.First;
               while not qryq49_entmercbensaqservicos.Eof do
               begin
                 qryq49_entmercbensaqservicos.edit;
                 qryq49_entmercbensaqservicosfilial.AsVariant := qryQuadrosDIMEfilial.AsVariant;
                 qryq49_entmercbensaqservicosperiodo.AsVariant := qryQuadrosDIMEperiodo.AsVariant;
                 qryq49_entmercbensaqservicos.Post;
                 qryq49_entmercbensaqservicos.Next;
               end;
               qryq49_entmercbensaqservicos.AfterPost := qryq49_entmercbensaqservicosAfterPost;
               result := qryq49_entmercbensaqservicos.IsEmpty or
                         qryq49_entmercbensaqservicos.CheckRequiredFields;

               if result then
               begin
                 qryq50_saimercforneletrservicos.AfterPost := nil;
                 qryq50_saimercforneletrservicos.First;
                 while not qryq50_saimercforneletrservicos.Eof do
                 begin
                   qryq50_saimercforneletrservicos.edit;
                   qryq50_saimercforneletrservicosfilial.AsVariant := qryQuadrosDIMEfilial.AsVariant;
                   qryq50_saimercforneletrservicosperiodo.AsVariant := qryQuadrosDIMEperiodo.AsVariant;
                   qryq50_saimercforneletrservicos.Post;
                   qryq50_saimercforneletrservicos.Next;
                 end;
                 qryq50_saimercforneletrservicos.AfterPost := qryq50_saimercforneletrservicosAfterPost;
                 result := qryq50_saimercforneletrservicos.IsEmpty or
                           qryq50_saimercforneletrservicos.CheckRequiredFields;
                 if result then
                 begin
                   qryRecolhimentoDime.AfterPost := nil;
                   qryRecolhimentoDime.First;
                   while not qryRecolhimentoDime.Eof do
                   begin
                     qryRecolhimentoDime.edit;
                     qryRecolhimentoDimefilial.AsVariant := qryQuadrosDIMEfilial.AsVariant;
                     qryRecolhimentoDimeperiodo.AsVariant := qryQuadrosDIMEperiodo.AsVariant;
                     qryRecolhimentoDime.Post;
                     qryRecolhimentoDime.Next;
                   end;
                   qryRecolhimentoDime.AfterPost := qryRecolhimentoDimeAfterPost;
                   result := qryRecolhimentoDime.IsEmpty or
                             qryRecolhimentoDime.CheckRequiredFields;
                   if result then
                   begin
                    qryQuadrosDIMEq09_998_SaldoCredPerSeguinte.AsCurrency := qryQuadrosDIMEq09_998_SaldoCredPerSeguinte_calculado.AsCurrency;

                    qryQuadrosDIMEq11_170_saldodevedor.AsCurrency := qryQuadrosDIMEq11_170_saldodevedor_calculado.AsCurrency;
                    qryQuadrosDIMEq11_190_saldocredor.AsCurrency := qryQuadrosDIMEq11_190_saldocredor_calculado.AsCurrency;
                    qryQuadrosDIMEq11_200_Sldcredtrestcons.AsCurrency := qryQuadrosDIMEq11_200_Sldcredtrestcons_calculado.AsCurrency;
                    qryQuadrosDIMEq11_180_Slddevtrestcons.AsCurrency := qryQuadrosDIMEq11_180_Slddevtrestcons_calculado.AsCurrency;
                    qryQuadrosDIMEq11_998_saldocredorparaomesseguinte.AsCurrency := qryQuadrosDIMEq11_998_saldocredorparaomesseguinte_calculado.AsCurrency;
                    qryQuadrosDIMEq11_999_imparecolhersobresubsttribut.AsCurrency := qryQuadrosDIMEq11_999_imparecolhersobresubsttribut_calculado.AsCurrency;
                    qryQuadroSDIME.Post;
                    result := Perpetrar([qryQuadrosDIME,
                                         qryq01_NotasEntradasCalculos,
                                         qryq02_NotasSaidasCalculos,
                                         qryq12_discrpagtos,
                                         qryq46_RegimeEspecial,
                                         qryq47_compraexproagrop,
                                         qryq48_recprestservfornenereletrica,
                                         qryq49_entmercbensaqservicos,
                                         qryq50_saimercforneletrservicos,
                                         qryRecolhimentoDime
                                         ]);
                   end;
                 end;
               end;
             end;
           end;
          end;
        end;
      end;
    end;
  end;
end;

