procedure TdtmQuadrosDIME.LerTotaisq_01;
var
 q_01_valor,
 q_09_020_e_transf_deb,
 q_09_060_e_transf_cred  : currency;
 pos: TBookmark;
begin
  q_01_valor := 0;
  q_09_020_e_transf_deb := 0;
  q_09_060_e_transf_cred  := 0;
  fq_01_isentas := 0;
  fq_01_outras := 0;
  fq_01_valornota := 0;
  fq_01_base := 0;
  pos:=qryq01_NotasEntradasCalculos.GetBookmark;
  qryq01_NotasEntradasCalculos.First;
  while not qryq01_NotasEntradasCalculos.Eof do
  begin
    if qryq01_NotasEntradasCalculoscodigofiscal.AsString = '1605' then
      q_09_020_e_transf_deb := q_09_020_e_transf_deb + qryq01_NotasEntradasCalculosvalor.AsCurrency;
    if qryq01_NotasEntradasCalculoscodigofiscal.AsString = '1602' then
      q_09_060_e_transf_cred := q_09_060_e_transf_cred + qryq01_NotasEntradasCalculosvalor.AsCurrency;
    q_01_valor := q_01_valor + qryq01_NotasEntradasCalculosvalor.AsCurrency;
    fq_01_isentas := fq_01_isentas + qryq01_NotasEntradasCalculosisentas.AsCurrency;
    fq_01_outras := fq_01_outras + qryq01_NotasEntradasCalculosoutras.AsCurrency;
    fq_01_valornota := fq_01_valornota + qryq01_NotasEntradasCalculosvalornota.AsCurrency;
    fq_01_base := fq_01_base + qryq01_NotasEntradasCalculosbase.AsCurrency;
    qryq01_NotasEntradasCalculos.Next;
  end;
  qryq01_NotasEntradasCalculos.GotoBookmark(pos);

  if (q_01_valor <> fq_01_valor) or
     (q_09_020_e_transf_deb <> fq_09_020_e_transf_deb) or
     (q_09_060_e_transf_cred <> fq_09_060_e_transf_cred) then
