function TdtmQuadrosDIME.mes_anterior(mes_atual: String): String;
begin
  if (copy(mes_atual,1,2)='01') or
     (copy(mes_atual,1,2)='07') then
    result := '0'
  else
   result := formatdatetime('mm/yyyy',IncMonth(strtodate('01/'+mes_atual),-1));
end;

function TdtmQuadrosDIME.mes_inicial(mes_atual: String): String;
begin
  if (copy(mes_atual,1,2)='01') or
     (copy(mes_atual,1,2)='07') then
    result := '0'
  else
   if (strtoint(copy(mes_atual,1,2)) <= 6)   then
     result := '01'+copy(mes_atual,3,5)
   else
     result := '06'+copy(mes_atual,3,5);
end;

