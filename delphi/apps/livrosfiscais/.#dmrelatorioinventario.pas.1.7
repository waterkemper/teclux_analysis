{$IFDEF MSWINDOWS}
procedure Tdtmrelatorioinventario.GravarExcel;
var
  Excel, oMergeRange, oWB, oSheet: Variant;
  Linha, QtdeLinhas, Planilhas, NumeroLinhas: integer;
  Pos: TBookmark;
begin
  QtdeLinhas:= 64;
  NumeroLinhas:= 1;
  Excel:= CreateOleObject('Excel.Application');
  Excel.Visible:= false;

  oWB := Excel.Workbooks.Add;
  oSheet := oWB.ActiveSheet;


//  Excel.WorkBooks.Open(ExtractFilePath(Application.ExeName)+'Relatorio_Inventario_Mercadorias.xls');

//  Excel.WorkBooks.Open(LocalGravacao);

  Excel.WorkBooks[1].Sheets[1].Cells[1,10]:= 'LIVRO INVENTÁRIO DE MERCADORIAS';
  Excel.WorkBooks[1].Sheets[1].Cells[2,10]:= ANSIUpperCase(ctSITUACAOEM+' '+DataExtenso(strtodate(FParametroData)));
  Excel.WorkBooks[1].Sheets[1].Cells[3,10]:= ParametroCabecalho;
  Excel.WorkBooks[1].Sheets[1].Cells[5,4]:= RazaoFilialBase;
  Excel.WorkBooks[1].Sheets[1].Cells[6,4]:= RuaFilialBase+' - '+BairroFilialBase;
  Excel.WorkBooks[1].Sheets[1].Cells[7,4]:= 'CEP: '+CEPFilialBase+ ' - '+CidadeFilialBase+' - '+EstadoFilialBase;

  Linha:= 10;

  Pos:= qryInventario.GetBookmark;
  qryInventario.DisableControls;

  qryInventario.First;
  while not qryInventario.Eof do
  begin
   Excel.WorkBooks[1].Sheets[1].Cells[Linha,1]:= qryInventariocodigoitem.AsString;
   Excel.WorkBooks[1].Sheets[1].Cells[Linha,4]:= qryInventariounidade.AsString;
   Excel.WorkBooks[1].Sheets[1].Cells[Linha,6]:= qryInventarioitem.AsString;
   Excel.WorkBooks[1].Sheets[1].Cells[Linha,17]:= qryInventarioclassificacaofiscal.AsString;
   Excel.WorkBooks[1].Sheets[1].Cells[Linha,21]:= qryInventarioreferencia.AsString;
   Excel.WorkBooks[1].Sheets[1].Cells[Linha,24]:= qryInventariogrupoproduto.AsString;
   Excel.WorkBooks[1].Sheets[1].Cells[Linha,27]:= qryInventariocodigofilial.AsString;
   Excel.WorkBooks[1].Sheets[1].Cells[Linha,29]:= qryInventariosubconta.AsString;
   Excel.WorkBooks[1].Sheets[1].Cells[Linha,32]:= qryInventarioqtdestoque.AsFloat;

   if ParametroCusto=0 then
     Excel.WorkBooks[1].Sheets[1].Cells[Linha,35] := qryInventariocusto_medio.AsFloat /
                                                     qryInventarioqtdestoque.AsFloat
   else
   if ParametroCusto=1 then
     Excel.WorkBooks[1].Sheets[1].Cells[Linha,35] := qryInventariocusto_ultimaentrada.AsFloat /
                                                     qryInventarioqtdultimaentrada.AsFloat
   else
   if ParametroCusto=2 then
     Excel.WorkBooks[1].Sheets[1].Cells[Linha,35] := qryInventariocusto_ultimaentrada.AsFloat;

   if ParametroCusto=0 then
     Excel.WorkBooks[1].Sheets[1].Cells[Linha,39] := qryInventariocusto_medio.AsFloat
   else
   if ParametroCusto=1 then
     Excel.WorkBooks[1].Sheets[1].Cells[Linha,39] :=
       qryInventarioqtdestoque.asfloat * (qryInventariocusto_ultimaentrada.asfloat / qryInventarioqtdultimaentrada.asfloat)
   else
   if ParametroCusto=2 then
     Excel.WorkBooks[1].Sheets[1].Cells[Linha,39] :=
       qryInventarioqtdestoque.asfloat * qryInventariocusto_ultimaentrada.asfloat;

   if ComPrecodeVenda then
   begin
     Excel.WorkBooks[1].Sheets[1].Cells[Linha,40] := qryInventarioprecovenda.asfloat;
     Excel.WorkBooks[1].Sheets[1].Cells[Linha,41] := qryInventarioprecovenda.asfloat *
                                                     qryInventarioqtdestoque.AsFloat;
   end
   else
   begin
     Excel.WorkBooks[1].Sheets[1].Cells[Linha,40].ColumnWidth := 0;
     Excel.WorkBooks[1].Sheets[1].Cells[Linha,41].ColumnWidth := 0;
   end;

   inc(Linha);
   inc(NumeroLinhas);
   qryInventario.Next;

   //Excel.WorkBooks[1].Sheets[1].Rows.Rows[linha].Insert;
  end;
  qryInventario.EnableControls;
  qryInventario.GotoBookmark(Pos);
  qryInventario.FreeBookmark(Pos);

  Excel.WorkBooks[1].SaveAs(LocalGravacao);
  Excel.WorkBooks.Open(LocalGravacao);
  Excel.Visible:= True;
end;
