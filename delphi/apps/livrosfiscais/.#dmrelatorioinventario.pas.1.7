procedure Tdtmrelatorioinventario.SetParametroClasse(const Value: String);
const
SQL = ' and c.classe = %s';

begin
  FParametroClasse := Value;
  if value<>'' then
     SQLEstoqueProduto := SQLEstoqueProduto + format(SQL, [quotedstr(FParametroClasse)]);
end;

procedure Tdtmrelatorioinventario.SetParametroData(const Value: String);
begin
  FParametroData := Value;
  if strtodate(FParametroData)=DataLocal then
  begin
    qryInventario.Sql.Text := qryInventario_atual.Sql.Text;
    qryInventario.ParamByName('data').AsString:=FParametroData;
    IF NOT FSomenteEstoqueFisico THEN
      SQLEstoque :='Where e.financeiro<>0 ';
  end
  else
  begin
   qryInventario.Sql.Text := qryInventario_anterior.Sql.Text;
   IF NOT FSomenteEstoqueFisico THEN
     qryInventario.MacroByName('financeiro').AsString:='and   m.financeiro<>0';
   qryInventario.ParamByName('data').AsString:=FParametroData;
  end;
end;

procedure Tdtmrelatorioinventario.SetParametroFilial(const Value: String);
const
SQL = ' %s (e.filial = %s ) ';
begin
  FParametroFilial := Value;
  if Value<>'' then
   if Length(SQLEstoque)=0 then
     SQLEstoque := format(SQL, ['Where', FParametroFilial])
   else
     SQLEstoque := SQLEstoque + format(SQL, ['and', FParametroFilial]);
end;

procedure Tdtmrelatorioinventario.SetParametroGrupo(const Value: String);
const
SQL = ' and c.grupo = %s ';
begin
  FParametroGrupo := Value;
  if value<>'' then
     SQLEstoqueProduto := SQLEstoqueProduto + format(SQL, [quotedstr(FParametroGrupo)])
end;

procedure Tdtmrelatorioinventario.SetParametroGrupoFilial(
  const Value: String);
const
SQL = ' %s (e.filial IN (SELECT filial FROM '+
      ' filiaisgruposfiliais fgf WHERE fgf.grupo = %s )) ';

begin
  FParametroGrupoFilial := Value;
  if Value<>'' then
   if Length(SQLEstoque)=0 then
     SQLEstoque := format(SQL, ['Where', FParametroGrupoFilial])
   else
     SQLEstoque := SQLEstoque + format(SQL, ['and', FParametroGrupoFilial])
end;

procedure Tdtmrelatorioinventario.SetParametroProduto(const Value: String);
const
 SQL = 'and c.codigo = %s ';
begin
  FParametroProduto := Value;
  if Value<>'' then
    SQLEstoqueProduto := format(SQL, [FParametroProduto])
end;

procedure Tdtmrelatorioinventario.SetParametroSubContaFinal(
  const Value: String);
const
 SQL1 = ' and c.subconta = %s ';
 SQL2 = ' and c.subconta between %s and %s ';
begin
  FParametroSubContaFinal := Value;
  SQLSubConta := '';
  if (FParametroSubContaInicial<>'') and (FParametroSubContaFinal<>'') then
    SQLSubConta := format(SQL2, [FParametroSubContaInicial, FParametroSubContaFinal])
  else if (FParametroSubContaInicial<>'') then
    SQLSubConta := format(SQL1, [FParametroSubContaInicial])
  else if (FParametroSubContaFinal<>'') then
    SQLSubConta := format(SQL1, [FParametroSubContaFinal]);
end;

procedure Tdtmrelatorioinventario.ImprimirRelatorio(datainicial, datafinal: String);
var
 Relatorio: TfrReport;
 frmPreview: TfrmPreviewPadrao;
begin
  if  ParametroFilial <> '' then
    AtribuirParametrosBaseRelatorio(ParametroFilial);

  frVariables['Custo']:= FParametroCusto;
  frVariables['Ordenacao']:=FParametroOrdenacao;
  frVariables['Livro']:=FParametroLivro;
  frVariables['Pagina']:=FParametroPagina;
  frVariables['Maximo']:=FParametroMaximo;
  frVariables['DataSituacao']:= ANSIUpperCase(ctSITUACAOEM+' '+DataExtenso(strtodate(FParametroData)));
  frVariables['DataExtenso']:= DataExtenso(strtodate(FParametroData));

  frVariables['DataExtensoInicial']:= DataExtenso(strtodate(DataInicial));
  frVariables['DataExtensoFinal']:= DataExtenso(strtodate(DataFinal));
  frVariables['DataInicial']:= DataInicial;
  frVariables['DataFinal']:= DataFinal;

  //------------------FR-VARIABLES----------------------//
  frVariables['AgruparGrupoFilial']:=AgruparGrupoFilial;
  frVariables['AgruparFilial']:=AgruparFilial;
  frVariables['AgruparLocalizacao']:= AgruparLocalizacao;
  frVariables['AgruparClasseGrupo']:=AgruparClasseGrupo;
  frVariables['AgruparGrupoProduto']:=AgruparGrupoProduto;
  frVariables['AgruparProduto']:=AgruparProduto;
  frVariables['Titulo']  := 'LIVRO INVENTÁRIO DE MERCADORIAS';
  //frpInventarioResumo.DesignReport;
  frmPreview := TfrmPreviewPadrao.create(self);
  frmPreview.cmbZoom.ItemIndex := 3;
  try
   Relatorio := frmPreview.frCompositeReport;
   with frmPreview do
   begin
    frCompositeReport.Reports.Clear;
    case FParametroRelatorio of
    0: case FParametroResumo of
         0 : begin
              if (FComPrecodeVenda) then
              begin
                frCompositeReport.Reports.Add(frpInventario_PV);
                frCompositeReport.Reports.Add(frpInventarioResumo_PV);
              end
              else
              begin
                frCompositeReport.Reports.Add(frpInventario);
                frCompositeReport.Reports.Add(frpInventarioResumo);
              end;
             end;
         1 : begin
                if(FComPrecodeVenda) then
                  frCompositeReport.Reports.Add(frpInventario_PV)
                else
                  frCompositeReport.Reports.Add(frpInventario);
             end;
         2 : begin
                if(FComPrecodeVenda) then
                  frCompositeReport.Reports.Add(frpInventarioResumo_PV)
                else
                  frCompositeReport.Reports.Add(frpInventarioResumo);
             end;
       end;
    1: begin
        if not Assigned(ImpressaoTermos) then
          ImpressaoTermos := TdtmImprimeTermos.Create(Self);
        frCompositeReport.Reports.Add(ImpressaoTermos.frpTermos_R);
       end;
    end;
   end;
//   frpInventario.DesignReport;
   Relatorio.Preview := frmPreview.frPreviewPadrao;
   Relatorio.ShowReport;

   frmPreview.ShowModal;

  finally

   frmPreview.Free;
   AtribuirParametrosBaseRelatorio;

  end;

end;
