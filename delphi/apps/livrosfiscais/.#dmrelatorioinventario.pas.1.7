function Tdtmrelatorioinventario.GetParametroCabecalho: String;
begin
  FParametroCabecalho := '';
  if FParametroFilial<>'' then
    FParametroCabecalho := FParametroCabecalho+'Filial: '+FParametroFilial
  else
    if ParametroGrupoFilial<>'' then
      FParametroCabecalho := FParametroCabecalho+'Grupo de Filial: '+FParametroGrupoFilial;

  if FParametroProduto<>'' then
    FParametroCabecalho := FParametroCabecalho+' Produto: '+FParametroProduto
  else
   if FParametroGrupo<>'' then
    FParametroCabecalho := FParametroCabecalho+' Grupo Produto: '+FParametroGrupo
   else
    if FParametroClasse<>'' then
      FParametroCabecalho := FParametroCabecalho+' Classe Grupo: '+FParametroClasse
   else
    if FParametroLocalTitulo<>'' then
      FParametroCabecalho := FParametroCabecalho+' Localização: '+FParametroLocalTitulo;

  if (FParametroSubContaInicial<>'') and (FParametroSubContaFinal<>'') then
    FParametroCabecalho := FParametroCabecalho+' Intervalo Sub Conta: '+FParametroSubContaInicial + ' a '+FParametroSubContaFinal
  else if (FParametroSubContaInicial<>'') then
    FParametroCabecalho := fParametroCabecalho+' Sub Conta: '+FParametroSubContaInicial
  else if (FParametroSubContaFinal<>'') then
    FParametroCabecalho := FParametroCabecalho+' Sub Conta: '+FParametroSubContaFinal;

  if FTiposdeProdutos<>'' then
    FParametroCabecalho := FParametroCabecalho + ' Tipo de produtos: '+FTiposdeProdutos;

  case FParametroCusto of
   0: frVariables['Outras']:= FParametroCabecalho+ ' Custo: Medio';
   1: frVariables['Outras']:= FParametroCabecalho+ ' Custo: Ultima Entrada';
  end;

  case compostos of
  0: FParametroCabecalho := FParametroCabecalho;
  1: FParametroCabecalho := FParametroCabecalho + 'Sem compostos';
  2: FParametroCabecalho := FParametroCabecalho + 'Somente compostos';
  end;

  Result := FParametroCabecalho;
end;

end.


