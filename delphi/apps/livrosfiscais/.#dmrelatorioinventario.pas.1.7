procedure Tdtmrelatorioinventario.MontarFiltroColunas(
  Coluna: TCheckListBox);
var
  STRColunas: String;
  Ind: Integer;
begin
  STRColunas := '';
  for Ind:= 0 to (Length(ListaColunas) - 1) do
    if Coluna.Checked[Ind] then
    begin
      if Ind<8 then
      STRColunas := STRColunas + FListaColunas[Ind].codigo + '+';
    end;
  STRColunas := Copy(STRColunas, 0, Length(STRColunas) - 1);
  if STRColunas <> '' then
       FColunas:= '(' + STRColunas + ')'
  else
  begin
       FColunas:= '( ep.emestoque + ep.reservado + ep.transito +  ep.demonstracao + ep.conserto + ep.danificada + ep.reservaprevia)';
  end;
  qryInventario.MacroByName('colunas').AsString:=FColunas;

  if FSomenteEstoqueFisico then
  begin
    qryInventario.ParamByName('estoquefisico').AsString:='t';
    qryInventarioResumo_Totais.MacroByName('ultimaentrada').AsString:='qtdestoque*custo_ultimaentrada';
    FParametroCusto:=2;
  end
  else
  begin
    qryInventario.ParamByName('estoquefisico').AsString:='f';
    qryInventarioResumo_Totais.MacroByName('ultimaentrada').AsString:='(case when coalesce(qtdultimaentrada,0)<>0 then  (qtdestoque*(custo_ultimaentrada/qtdultimaentrada)) else cast(null as numeric) end)';
  end;
end;

procedure Tdtmrelatorioinventario.MontarFiltroTipodeProdutos(
  Coluna: TCheckListBox);
var
  Ind: Integer;
begin
  FTiposdeProdutos := '';
  for Ind:= 0 to coluna.Items.Count -1 do
    if Coluna.Checked[Ind] then
      FTiposdeProdutos := FTiposdeProdutos + quotedstr(copy(coluna.Items[Ind],1,2))+',';

  FTiposdeProdutos := Copy(FTiposdeProdutos, 0, Length(FTiposdeProdutos) - 1);
  if FTiposdeProdutos<>'' then
    qryInventario.MacroByName('TipodeProdutos').AsString:=' and c.tipoproduto in ('+FTiposdeProdutos+')'
  else
    qryInventario.MacroByName('TipodeProdutos').AsString:='';
end;


function Tdtmrelatorioinventario.GetListaColunas: TLista;
begin
  FillChar(FListaColunas,SizeOf(FListaColunas),0);
  SetLength(FListaColunas,8);
  FListaColunas[0].codigo   := 'ep.emestoque';
  FListaColunas[1].codigo   := 'ep.reservado';
  FListaColunas[2].codigo   := 'ep.transito';
  FListaColunas[3].codigo   := 'ep.demonstracao';
