procedure Tdtmrelatorioinventario.SetParametroLocalizacao(const Value: String);
const  SQL = '%s (e.localizacao) ilike %s';
begin
  FParametroLocalizacao := Value+'%';
  if Value<>'' then
   if Length(SQLEstoque)=0 then
     SQLEstoque := format(SQL, ['Where', quotedstr(FParametroLocalizacao)])
   else
     SQLEstoque := SQLEstoque + format(SQL, ['and',quotedstr(FParametroLocalizacao)]);

end;

procedure Tdtmrelatorioinventario.SetParametroIncidencia(const Value: String);
const SQL = '%s (e.produto in (Select p.codigo from produtos p join caracteristicas c on '+
            'p.caracteristica=c.codigo and c.incidencia = %s))';
begin
  FParametroIncidencia := Value;
  if (Value <> null) and (Value <> '') then
    if Length(SQLEstoque) = 0 then
      SQLEstoque:= Format(SQL,['Where', FParametroIncidencia])
    else
      SQLEstoque := SQLEstoque + format(SQL, ['and',FParametroIncidencia]);
end;

