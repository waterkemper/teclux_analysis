  qryConsultaGruposFiliais.Tag:= ctPesquisaGrupoFilial;
  qryConsultaProdutos.Tag:= ctPesquisaProdutos;
  qryConsultaGrupoProdutos.Tag:= ctPesquisaGrupo;
  qryConsultaClasses.Tag:= ctPesquisaClasse;
  qryInventario.Tag:= ctInventario;
  qryProcuraFiliais.Tag:= ctTabelas;
  qryProcuraGruposFiliais.Tag:= ctTabelas;
  qryProcuraProdutos.Tag:= ctTabelas;
  qryProcuraClasses.Tag:= ctTabelas;
  qryProcuraGrupoProdutos.Tag:= ctTabelas;
  qryInventario.MacroByName('colunas').AsString:='( ep.emestoque + ep.reservado + ep.transito +  ep.demonstracao + ep.conserto + ep.danificada + ep.reservaprevia)';
//  qryInventario_anterior.MacroByName('colunas').AsString:='( ep.emestoque + ep.reservado + ep.transito +  ep.demonstracao + ep.conserto + ep.danificada + ep.reservaprevia)';
