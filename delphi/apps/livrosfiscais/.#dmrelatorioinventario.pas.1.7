function Tdtmrelatorioinventario.AbrirConsultaInventario: Boolean;
var
 n: integer;
Const
  SQL = ') as temp ) as temp '+
        'group by nomegrupofilial, codigogrupofilial, '+
                 'nomefilial, codigofilial, '+
                 'localizacao, '+
                 'classeproduto, codigoclasse, '+
                 'GrupoProduto, CodigoGrupo, '+
                 'Produto, CodigoProduto';
begin
//  qryInventario.Sql[42] := SQLEstoque;
  qryInventario.MacroByName('estoque').AsString:=SQLEstoque;
  qryInventario.MacroByName('estoqueproduto').AsString:=SQLEstoqueProduto;
  qryInventario.MacroByName('SubConta').AsString:=SQLSubConta;

  case compostos of
  0: qryInventario.MacroByName('FiltroComposto').AsString:= '';
  1: qryInventario.MacroByName('FiltroComposto').AsString:= ' and not (coalesce(c.composto,false))';
  2: qryInventario.MacroByName('FiltroComposto').AsString:= ' and (coalesce(c.composto,false))';
  end;

  case FParametroResumo of
  0,2: begin
         qryInventarioResumo.Sql.Clear;
         qryInventarioResumo.Sql.Text :=
             qryInventarioResumo_Totais.sql.Text+
             qryinventario.Sql.Text;
         qryInventarioResumo.Sql.Add(SQL);
         qryInventarioResumo.Sql.Add(FOrdenacaoResumo);
         qryInventarioResumo.ParamByName('AgruparGrupoFilial').AsBoolean := FAgruparGrupoFilial;
         qryInventarioResumo.ParamByName('AgruparFilial').AsBoolean := FAgruparFilial;
         qryInventarioResumo.ParamByName('AgruparLocalizacao').AsBoolean:= FAgruparLocalizacao;
         qryInventarioResumo.ParamByName('AgruparClasseProduto').AsBoolean := FAgruparClasseGrupo;
         qryInventarioResumo.ParamByName('AgruparGrupoProduto').AsBoolean := FAgruparGrupoProduto;
         qryInventarioResumo.ParamByName('AgruparProduto').AsBoolean := FAgruparProduto;
         qryInventarioResumo.ParamByName('CustoMedio').AsBoolean := (FParametroCusto=0);
         qryInventarioResumo.Macros := qryInventario.Macros;
         qryInventarioResumo.MacroByName('ultimaentrada').AsString:=qryInventarioResumo_Totais.MacroByName('ultimaentrada').ASstring;
         for n := 0 to qryInventario.macrocount - 1 do
           qryInventarioResumo.MacroByName(qryInventario.macros[n].Name).AsString:=qryInventario.Macros[n].AsString;

{
         qryInventarioResumo.MacroByName('colunas').AsString:=qryInventario.MacroByName('colunas').AsString;
         qryInventarioResumo.MacroByName('estoque').AsString:=qryInventario.MacroByName('estoque').AsString;
         qryInventarioResumo.MacroByName('SubConta').AsString:=qryInventario.MacroByName('SubConta').AsString;

         qryInventarioResumo.MacroByName('ultimaentrada').AsString:=qryInventarioResumo_Totais.MacroByName('ultimaentrada').ASstring;
         qryInventarioResumo.MacroByName('TipodeProdutos').AsString := qryInventario.MacroByName('TipodeProdutos').AsString;
}
         qryInventarioResumo.ParamByName('estoquefisico').AsString:=qryInventario.ParamByName('estoquefisico').AsString;
         qryInventarioResumo.ParamByName('data').AsString := FParametroData;

       end;
  end;
  case FParametroResumo of
  0: begin
      qryInventario.Close;
      qryInventario.Open;
      qryInventarioResumo.Close;
      qryInventarioResumo.Open;
     end;
  1: begin
      qryInventario.Close;
      qryInventario.Open;
     end;
  2: begin
      qryInventarioResumo.Close;
      qryInventarioResumo.Open;
     end;
  end;
  result := not qryinventario.IsEmpty or
            not qryinventarioresumo.isempty;
end;

