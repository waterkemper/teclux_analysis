procedure Tdtmrelatorioinventario.DefineOrdenacao;
begin
  Fordenacao:='';
  FOrdenacaoResumo:='';
  if AgruparGrupoFilial then
    FOrdenacao:=FOrdenacao+', nomegrupofilial, codigogrupofilial ';
  if AgruparFilial then
    FOrdenacao:=FOrdenacao+', nomefilial, codigofilial ';
  if AgruparLocalizacao then
    FOrdenacao:= FOrdenacao+', localizacao ';
  if AgruparClasseGrupo then
    FOrdenacao:=FOrdenacao+', classeproduto, codigoclasse';
  if AgruparGrupoProduto then
    FOrdenacao:=FOrdenacao+', GrupoProduto, CodigoGrupo';
  if AgruparProduto then
    FOrdenacao:=FOrdenacao+', Produto, CodigoProduto';
  FOrdenacaoResumo:='Order by '+copy(FOrdenacao,2,length(FOrdenacao)-1);
  case ParametroOrdenacao of
  0: FOrdenacao:=FOrdenacao+', codigoitem, item';
  1: FOrdenacao:=FOrdenacao+', item, codigoitem';
  end;
  qryInventario.MacroByName('ordenacao').AsString:='Order by '+copy(FOrdenacao,2,length(FOrdenacao)-1);

end;

