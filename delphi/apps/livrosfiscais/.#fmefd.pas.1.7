constructor TfrmEFD.Create(AOwner: TComponent);
begin
  inherited;
  dtmEFD := TdtmEFD.Create(self);
  DataSet := dtmEFD.qryefd;
  dtmEFD.ACBrSPEDFiscalonError := ACBrSPEDFiscalonError;

  fraConsultaICMSObrigacoes := TfraConsultaCodigoContabil.Create(self);
  fraConsultaICMSObrigacoes.Name := 'fraConsultaICMSObrigacoes';
  fraConsultaICMSObrigacoes.edfCodigo.MaxLength := 3;
  fraConsultaICMSObrigacoes.edfCodigo.DataSource := dtmEFD.dsrEFD_E116;
  fraConsultaICMSObrigacoes.edfCodigo.DataField := 'icmsobrigacao';
  fraConsultaICMSObrigacoes.edfCodigo.Operacao := opATRIBUICAO;
  fraConsultaICMSObrigacoes.edfCodigo.LookupSource := fraConsultaICMSObrigacoes.dsrProcuraICMSObrigacoes;
  fraConsultaICMSObrigacoes.edfCodigo.LookupField := 'codigo';
  fraConsultaICMSObrigacoes.edfCodigo.LookupQueryParameter := 'codigo';
  fraConsultaICMSObrigacoes.AbrirTabelaProcura := false;
  fraConsultaICMSObrigacoes.TipoPesquisa := pesICMSOBRIGACOES;
  fraConsultaICMSObrigacoes.OnFound := AtribuirDadosICMSObrigacao;

  fraConsultaCodigodeReceitas := TfraConsultaCodigoContabil.Create(self);
  fraConsultaCodigodeReceitas.Name := 'fraConsultaCodigodeReceitas';
  fraConsultaCodigodeReceitas.edfCodigo.MaxLength := 30;
  fraConsultaCodigodeReceitas.edfCodigo.DataSource := dtmEFD.dsrEFD_E116;
  fraConsultaCodigodeReceitas.edfCodigo.DataField := 'cod_rec';
  fraConsultaCodigodeReceitas.edfCodigo.Operacao := opATRIBUICAO;
  fraConsultaCodigodeReceitas.edfCodigo.LookupSource := fraConsultaCodigodeReceitas.dsrProcuraEFD_CodigosdeReceita;
  fraConsultaCodigodeReceitas.edfCodigo.LookupField := 'codigo';
  fraConsultaCodigodeReceitas.edfCodigo.LookupQueryParameter := 'codigo';
  fraConsultaCodigodeReceitas.AbrirTabelaProcura := false;
  fraConsultaCodigodeReceitas.TipoPesquisa := pesCODIGODERECEITAS;


  fraConsultaAjusteICMS := TfraConsultaCodigoContabil.Create(self);
  fraConsultaAjusteICMS.Name := 'fraConsultaAjusteICMS';
  fraConsultaAjusteICMS.edfCodigo.MaxLength := 8;
  fraConsultaAjusteICMS.edfCodigo.DataSource := dtmEFD.dsrEFD_E111;
  fraConsultaAjusteICMS.edfCodigo.DataField := 'cod_aj_apur';
  fraConsultaAjusteICMS.edfCodigo.Operacao := opATRIBUICAO;
  fraConsultaAjusteICMS.edfCodigo.LookupSource := fraConsultaAjusteICMS.dsrProcuraAjusteICMS;
  fraConsultaAjusteICMS.edfCodigo.LookupField := 'codigo';
  fraConsultaAjusteICMS.edfCodigo.LookupQueryParameter := 'codigo';
  fraConsultaAjusteICMS.AbrirTabelaProcura := false;
  fraConsultaAjusteICMS.TipoPesquisa := pesTABELAAJUSTEICMS;
  fraConsultaAjusteICMS.OnFound := AtribuirDadosTabelaAjusteICMS;

  fraConsultaAjusteIPI := TfraConsultaCodigoContabil.Create(self);
  fraConsultaAjusteIPI.Name := 'fraConsultaAjusteIPI';
  fraConsultaAjusteIPI.edfCodigo.MaxLength := 3;
  fraConsultaAjusteIPI.edfCodigo.DataSource := dtmEFD.dsrEFD_E530;
  fraConsultaAjusteIPI.edfCodigo.DataField := 'cod_aj_apur';
  fraConsultaAjusteIPI.edfCodigo.Operacao := opATRIBUICAO;
  fraConsultaAjusteIPI.edfCodigo.LookupSource := fraConsultaAjusteIPI.dsrProcuraAjusteIPI;
  fraConsultaAjusteIPI.edfCodigo.LookupField := 'codigo';
  fraConsultaAjusteIPI.edfCodigo.LookupQueryParameter := 'codigo';
  fraConsultaAjusteIPI.AbrirTabelaProcura := false;
  fraConsultaAjusteIPI.TipoPesquisa := pesTABELAAJUSTEIPI;
  fraConsultaAjusteIPI.OnFound := AtribuirDadosTabelaAjusteIPI;

  fraConsultaefd := TfraConsultaCodigoContabil.Create(self);
  fraConsultaefd.edfCodigo.Operacao := opPESQUISA;
  fraConsultaefd.AbrirTabelaProcura := false;
  fraConsultaefd.TipoPesquisa := pesefd;
  fraConsultaefd.OnFound := Abrirefd;

  fraConsultaFilial.TipoPesquisa := pesFILIAIS;

  dbgObrigacoes.OnDelete := dtmEFD.ExcluirEFD_E116;

  dbgAJUSTEICMS.OnDelete := dtmefd.ExcluirEFD_E111;
  sbnGerarArquivo.Enabled := false;
  edtMesInicial.SetFocus;
  edtMesInicial.SelectAll;
  edtMesInicial.SelStart := 0;

