                    object stxM505_07_VL_BC_COFINS: TStaticText
                      Left = 10
                      Top = 219
                      Width = 568
                      Height = 93
                      AutoSize = False
                      BorderStyle = sbsSunken
                      Caption = 
                        '  07 - Valor da base de c'#225'lculo do cr'#233'dito, vinculada ao tipo de' +
                        ' cr'#233'dito escriturado em M100.                                 - ' +
                        'Para os CST_PIS = 50, 51, 52, 60, 61 e 62: informar o valor do c' +
                        'ampo 06;                                                      - ' +
                        'Para os CST_PIS = 53, 54, 55, 56, 63, 64, 65 e 66 (c'#233'dito sobre ' +
                        'opera'#231#245'es vinculadas a mais de             um tipo de receita): ' +
                        'informar a parcela do valor do campo 06 vinculada especificament' +
                        'e ao tipo                 de cr'#233'dito escriturado em M100.       ' +
                        '                                                                ' +
                        '                                                          O valo' +
                        'r deste campo ser'#225' transportado para o campo 04  do registro M10' +
                        '0.'
                      Font.Charset = DEFAULT_CHARSET
                      Font.Color = clBlack
                      Font.Height = -12
                      Font.Name = 'helvetica'
                      Font.Pitch = fpVariable
                      Font.Style = []
                      ParentFont = False
                      TabOrder = 13
                    end
