procedure TfrmEPC.AcionaPesquisaGradeContaContabil_M810;
begin
  if dbg_M810.Focused then
  begin
    case dbg_M810.SelectedIndex of
    2,3 :
      begin
        fraConsultaContaContabil_M810.CtrlOn := True;
        fraConsultaContaContabil_M810.InternoPesquisar('Conta Contábil');
        dbg_M810.SetFocus;
        dbg_M810.SelectedIndex :=  2;
      end;
    end;
  end;

end;

procedure TfrmEPC.dbg_M810KeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  inherited;
  if CtrlOn then
  begin
    case Key of
      VK_F9 : AcionaPesquisaGradeContaContabil_M810;
    end;
  end
  else
  begin
    case key of
      VK_Return :
      begin
        case dbg_M810.SelectedIndex of
        2,3 : begin
                if not fraConsultaContaContabil_M810.edfCodigo.Exist then
                  dtmEPC.qryRegistroM810descricaocontacontabil.clear
                else
                  AtribuirDadosContaContabil_M810;

                dbg_M810.SelectedIndex := 2;
                dbg_M810.SetFocus;
              end;
        end;

        if dtmEPC.qryregistrom810.State in [dsedit, dsinsert] then
           dtmEPC.qryREgistroM810.Post;

      end;
    end;
  end;

end;

procedure TfrmEPC.ParametroF100ClienteouFornecedor;
begin
  if not (dtmEPC.qryRegistroF100.State  in [dsinsert]) then
      if dtmEPC.qryRegistroF100tipocod_part.AsString<>''      then
        fraConsultaClienteDemaisDoctos.qryProcuraCliente.ParamByName('tipocliente').AsString:= dtmEPC.qryRegistroF100tipocod_part.AsString;
end;

