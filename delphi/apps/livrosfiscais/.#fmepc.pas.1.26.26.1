procedure TfrmEPC.CondicaoFilialSelecionavel;
var
 i: integer;
begin
  for i:=0 to self.ComponentCount -1 do
  begin
    if (self.Components[i].ClassType = TfraConsultaCodigo) and
       (pos(self.Components[i].Name, 'fraConsultaFilial')<>0) then
    begin
      TfraConsultaCodigo(self.Components[i]).qryprocurafiliais.macrobyname('SQL').asstring := format('and (codigo = %s or '+
                                                                                ' codigo in (select f2.codigo '+
                                                                                           ' from filiais f2 '+
                                                                                           ' where f2.filialconsolidadoradime = %s)) '+
                                                                                'and (sped_pis_cofins or sped_pis_cofins_rb or sped_pis_cofins_rem)',
                                                        [dtmepc.qryepcfilial.asstring, dtmepc.qryepcfilial.asstring]);

      TfraConsultaCodigo(self.Components[i]).qryconsultafiliais.macrobyname('SQL').asstring := format('and (codigo = %s or '+
                                                                                ' codigo in (select f2.codigo '+
                                                                                           ' from filiais f2 '+
                                                                                           ' where f2.filialconsolidadoradime = %s)) '+
                                                                                'and (sped_pis_cofins or sped_pis_cofins_rb or sped_pis_cofins_rem)',
                                                        [dtmepc.qryepcfilial.asstring, dtmepc.qryepcfilial.asstring]);
     {
      fraConsultaFilialOperAtivImob.qryprocurafiliais.macrobyname('SQL').asstring := format('and (codigo = %s or '+
                                                                                ' codigo in (select f2.codigo '+
                                                                                           ' from filiais f2 '+
                                                                                           ' where f2.filialconsolidadoradime = %s))',
                                                        [dtmepc.qryepcfilial.asstring, dtmepc.qryepcfilial.asstring]);

      fraConsultaFilialOperAtivImob.qryconsultafiliais.macrobyname('SQL').asstring := format('and (codigo = %s or '+
                                                                                ' codigo in (select f2.codigo '+
                                                                                           ' from filiais f2 '+
                                                                                           ' where f2.filialconsolidadoradime = %s))',
                                                        [dtmepc.qryepcfilial.asstring, dtmepc.qryepcfilial.asstring]);
     }
    end;
  end;
end;


