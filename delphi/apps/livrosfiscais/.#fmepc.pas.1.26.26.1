procedure TfrmEPC.dbg_M410KeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  inherited;
  if CtrlOn then
  begin
    case Key of
      VK_F9 : AcionaPesquisaGradeContaContabil_M410;
    end;
  end
  else
  begin
    case key of
      VK_Return :
      begin
        case dbg_M410.SelectedIndex of
        2,3 : begin
                if not fraConsultaContaContabil_M410.edfCodigo.Exist then
                  dtmEPC.qryRegistroM410descricaocontacontabil.clear
                else
                  AtribuirDadosContaContabil_M410;

                dbg_M410.SelectedIndex := 2;
                dbg_M410.SetFocus;
              end;
        end;

        if dtmEPC.qryregistrom410.State in [dsedit, dsinsert] then
           dtmEPC.qryREgistroM410.Post;

      end;
    end;
  end;

end;

