procedure TfrmEPC.sbnGerarArquivoClick(Sender: TObject);
begin
  inherited;
  if ValidarCamposSelecao then
  begin
     with dtmEPC do
     begin
       if GerarArquivo(qryepcnomearquivo.AsString) then
         MensagemAviso(format(ctARQUIVOGERADOSUCESSO,[qryepcnomearquivo.AsString]));
     end;
  end
end;

function TfrmEPC.ValidarCamposSelecao: Boolean;
begin

  result := not MesAnoEmBranco(edtMesInicial.text);
  if not result then
  begin
    MensagemAviso(ctDATAINVALIDA);
    edtMesInicial.SetFocus;
  end
  else
  if dtmEPC.qryepcCOD_INC_TRIB.IsNull then
  begin
    result := false;
    MensagemAviso('"CÓDIGO INDICADOR DA INCIDÊNCIA TRIBUTÁRIA NO PERÍODO" não informado');
    pgcEscrituracaoPISCOFINS.ActivePage := tstRegistro_110;
    dbrINC_TRIB_PERIODO.SetFocus;
  end
  else
  if (dtmEPC.qryepcCOD_INC_TRIB.AsInteger in [1,3]) and dtmEPC.qryepcIND_APRO_CRED.isnull then
  begin
    result := false;
    MensagemAviso('"MÉTODO DE APROPRIAÇÃO DE CRÉDITOS NO REGIME NÃO CUMULATIVO" não informado');
    pgcEscrituracaoPISCOFINS.ActivePage := tstRegistro_110;
    dbrMET_REG_NAO_CUM.SetFocus;
  end
  else
  if (dtmEPC.qryepcCOD_INC_TRIB.AsInteger in [2]) and dtmEPC.qryepcIND_REG_CUM.isnull then
  begin
    result := false;
    MensagemAviso('"TIPO DE REGIME CUMULATIVO" não informado');
    pgcEscrituracaoPISCOFINS.ActivePage := tstRegistro_110;
    dbrTIPO_REG_CUM.SetFocus;
  end;
  
end;


function TfrmEPC.InternoExcluir: Boolean;
begin
  Result := inherited InternoExcluir;
  if Result then
    if MensagemConfirmacao(Format(ctCONFIRMEEXCLUIR, ['a escrita contábil digital'])) = smbOK then
      Result := dtmEPC.Excluirepc
    else
      Result := False
end;

function TfrmEPC.InternoGravar: Boolean;
begin
  inherited InternoGravar;
  Result := dtmEPC.Gravarepc
end;

function TfrmEPC.InternoIncluir: Boolean;
begin
  result := inherited internoincluir;
  if result then
    Result := dtmEPC.Incluirepc;
end;

destructor TfrmEPC.Destroy;
begin
  dtmEPC := nil;
  inherited;
  frmEPC := nil;
end;


procedure TfrmEPC.AbrirEPC;
begin

  dtmepc.
        refazconsulta(dtmepc.qryepc,[0,1],
             [fraConsultaepc.qryProcuraepcperiodo.AsString,
              fraConsultaepc.qryProcuraepcfilial.AsString]);
  fraConsultaFilial.edfCodigo.Exist

end;

procedure TfrmEPC.sbnProcurarClick(Sender: TObject);
begin
  inherited;
  fraConsultaepc.InternoPesquisar('EPC - Escrita Contábil Digital');
  self.SetFocus;
end;

procedure TfrmEPC.KeyDown(var Key: Word; Shift: TShiftState);
begin
  inherited;
  if not CtrlOn then
  begin
    if (key = VK_F9) then
    begin
      if sbnProcurar.Enabled then
      begin
        fraConsultaepc.InternoPesquisar('efd - Escrita Contábil Digital');
        self.SetFocus;
      end
    end
    else
    if (key = VK_F8) then
    begin
      if sbnGerarArquivo.Enabled then
        sbnGerarArquivoClick(nil);
    end;
  end;
end;

procedure TfrmEPC.AlterarEstadoBotoes;
begin
  inherited;

  sbnGerarArquivo.Enabled := sbnIncluir.Enabled and
                             not sbnSalvar.Enabled and
                             (dtmEPC.qryepc.RecordCount<>0);
end;

procedure TfrmEPC.Action1Update(Sender: TObject);
begin
  inherited;

  dbrMET_REG_NAO_CUM.Enabled := rbnINC_TRIB_PERIODO_1.Checked or rbnINC_TRIB_PERIODO_3.Checked;
  dbrTIPO_REG_CUM.Enabled := rbnINC_TRIB_PERIODO_2.Checked;
  gbxRegistro111.Enabled := rbnMET_REG_NAO_CUM_2.Checked;

  sbnIncluirRegistroF100.Enabled := not (dtmEPC.qryRegistroF100.State in [dsedit, dsinsert]);
