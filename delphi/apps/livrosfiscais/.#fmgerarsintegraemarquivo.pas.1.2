  Sender: TObject);
begin
  inherited;
  MarcarLista(clbGrupodeFiliais, True);
  MarcarLista(clbFiliais, False);
end;

procedure TfrmGerarSintegraEmArquivo.sbnDesmarcarGrupodeFiliaisClick(
  Sender: TObject);
begin
  inherited;
