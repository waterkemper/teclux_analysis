    procedure sbnConsultaCodigoFiscalSaidaInicialClick(Sender: TObject);
    procedure sbnConsultaCodigoFiscalEntradaFinalClick(Sender: TObject);
    procedure sbnConsultaCodigoFiscalSaidaFinalClick(Sender: TObject);
