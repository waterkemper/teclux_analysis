{$R *.dfm}

{ Tfrmrelatorioinventario }

constructor Tfrmrelatorioinventario.Create(AOwner: TComponent);
begin
  dtmRelatorioInventario := TdtmRelatorioInventario.Create(Self);
  inherited;
  edtData.Text := DateToStr(UltimoDiaMesPassado(1));
//  edtData.Text := DateToStr(date());
  pgcFilialGrupoFilial.ActivePage := tstFilial;
  pgcProdutos.ActivePage := tstProdutos;
  edtpagina.Text:='2';
  edtMaximo.Text:='499';
  if ParSistema.LivrosFiscaisFolhaouPagina = 0 then
    gbxPagina.Caption := UpperCase(ctFOLHA);
  MarcarLista(clbColunas,True);
  clbTiposProdutos.Checked[0] := true;
  clbColunas.Checked[7]:=False;
  gbxPeriodo.Visible := false;
  dtmrelatorioinventario.qryLocalizacao.Open;
  dtmrelatorioinventario.qryProcuraIncidencia.Open;
  edtDataInicial.Text := edtData.Text;
  edtDataFinal.Text := edtData.Text;
  fraConsultaProduto.TipoPesquisa     := pesPRODUTOS;

end;

destructor Tfrmrelatorioinventario.Destroy;
begin
  dtmRelatorioInventario:=nil;
  inherited;
  frmRelatorioInventario := nil;
end;

function Tfrmrelatorioinventario.ExisteInformacao(Parametro: Integer;
  NomeCampo: String; Value: Variant): Boolean;
begin
  with dtmRelatorioInventario do
    case TipoPesquisa of
      pesFILIAIS      : Result := ExisteFilial(NomeCampo, Value);
      pesGRUPOSFILIAIS: Result := ExisteGrupoFilial(Nomecampo,Value);
      pesPRODUTOS     : Result := ExisteProduto(NomeCampo, Value);
      pesGRUPOS       : Result := ExisteGrupo(NomeCampo, Value);
      pesCLASSES      : Result := ExisteClasse(NomeCampo, Value);
      pesLOCALIZACAO  : Result := ExisteLocalizacao(NomeCampo, Value);
      pesINCIDENCIA   : Result := ExisteIncidencia(NomeCampo, Value);
    else  Result:= False;
    end;
end;

function Tfrmrelatorioinventario.InternoPesquisar(Titulo: String): Integer;
begin
  if PesquisaHabilitada then
    with dtmRelatorioInventario do
    begin
      AbreTabelaPesquisa(TipoPesquisa);
      Result := inherited InternoPesquisar(TituloPesquisa);
      if Result = mrOK then
        Selecionar(TipoPesquisa);
      FechaTabelaPesquisa(TipoPesquisa);
    end
  else
    Result := 0;
end;

function Tfrmrelatorioinventario.JanelaPesquisa: TfrmConsultaBasica;
begin
  Result := TfrmConsultaPorCampo.Create(nil);
  TfrmConsultaPorCampo(Result).ConsultaInterativa:= True;
end;

function Tfrmrelatorioinventario.PesquisaHabilitada: Boolean;
begin
  Result:= False;
  if (CtrlOn) and (ActiveControl is TtecDBEditFind) then
  begin
    if edfFilial.Focused then
      TipoPesquisa := pesFILIAIS
    else
    if edfGrupoFilial.Focused then
      TipoPesquisa := pesGRUPOSFILIAIS
    else
    if fraConsultaProduto.edfCodigo.Focused then
      TipoPesquisa := pesPRODUTOS
    else
    if edfGrupoProduto.Focused then
      TipoPesquisa := pesGRUPOS
    else
    if edfClasse.Focused then
      TipoPesquisa := pesCLASSES
    else
    if edtLocalizacao.Focused then
      TipoPesquisa := pesLOCALIZACAO
    else
    if edfIncidencia.Focused then
      TipoPesquisa := pesINCIDENCIA;
    Result:= True;
  end;
end;

function Tfrmrelatorioinventario.TabelaDePesquisa: TZDataSet;
begin
  with dtmRelatorioInventario do
    case TipoPesquisa of
      pesFILIAIS      : Result := ConsultarFilial;
      pesGRUPOSFILIAIS: Result := ConsultarGrupoFilial;
      pesPRODUTOS     : Result := ConsultarProduto;
      pesGRUPOS       : Result := ConsultarGrupo;
      pesCLASSES      : Result := ConsultarClasse;
      pesLOCALIZACAO  : Result := Localizacao;
      pesINCIDENCIA   : Result := ConsultaIncidencia;
    else  Result:= nil;
    end;
end;

function Tfrmrelatorioinventario.TituloPesquisa: String;
begin
  case TipoPesquisa of
    pesFILIAIS      : Result := ctFILIAIS;
    pesGRUPOSFILIAIS: Result := ctGRUPOFILIAIS;
    pesPRODUTOS     : Result := ctPRODUTO;
    pesGRUPOS       : Result := ctGRUPOS;
    pesCLASSES      : Result := ctCLASSES;
    pesLOCALIZACAO  : Result := ctLOCALIZACAO;
    pesINCIDENCIA   : Result := ctINCIDENCIA;
  end;
end;

function Tfrmrelatorioinventario.ValidarCamposSelecao: Boolean;
begin
  Result:=ecvValida.Verify(gbxParametros, ControleValido);
  if (edtpagina.text<>'') then
   if (strtoint(edtpagina.text) < 2) then
   begin
     result := false;
     mensagemaviso(ctPAGINAINICIAL);
     edtpagina.setfocus;
   end;
  if result then
  begin
   Result := OperadorTernario((Trim(edfFilial.Text) <> ''), edfFilial.Exist, True) and
             OperadorTernario((Trim(edfGrupoFilial.Text) <> ''), edfGrupoFilial.Exist, True) and
             OperadorTernario((Trim(fraConsultaProduto.edfCodigo.Text) <> ''), fraConsultaProduto.edfCodigo.Exist, True) and
             OperadorTernario((Trim(edfGrupoProduto.Text) <> ''), edfGrupoProduto.Exist, True) and
             OperadorTernario((Trim(edfClasse.Text) <> ''), edfClasse.Exist, True);
   if Result then
   begin
     if edtLivro.Text<>'' then
     begin
      if edfFilial.Text='' then
      begin
       Result:=False;
       MensagemAviso(ctINFORMACAOLIVROFILIAL);
      end
      else
       Result:=True;
     end
     else
     begin
        if (rgpRelatorio.ItemIndex=1) and
         ((edtLivro.Text='') or
          (edtDataInicial.Text='') or
          (edtdatafinal.Text='')) then
      begin
       Result:=False;
       MensagemAviso(ctPARAMETROSINEXISTENTES);
       edtLivro.SetFocus;
      end
      else
       Result:=True;
     end;
   end;
  end;
end;

