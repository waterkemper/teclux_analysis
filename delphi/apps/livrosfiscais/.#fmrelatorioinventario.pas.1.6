procedure Tfrmrelatorioinventario.MontaPesquisa;
begin
  if ValidarCamposSelecao then
  begin
    with dtmrelatorioinventario do
    begin
      SQLEstoque := '';
      SQLEstoqueProduto := '';
      SQLSubConta := '';
      SomenteEstoqueFisico:=SomenteFisico();
      ParametroData := edtData.Text;
      ParametroFilial := edfFilial.Text;
      ParametroGrupoFilial:= edfGrupoFilial.Text;
      ParametroLocalTitulo:= edtLocalizacao.Text;
      ParametroIncidencia:= edfIncidencia.text;

      ParametroProduto:= fraConsultaProduto.edfcodigo.ValoraDataFieldInterno;
      ParametroClasse := edfClasse.Text;
      ParametroGrupo := edfGrupoProduto.Text;
      PArametroLocalizacao:= edtLocalizacao.Text;

      ParametroSubContaInicial := edtSubContaInicial.Text;
      ParametroSubContaFinal := edtSubContaFinal.Text;
      ParametroCusto:= rgpCusto.itemindex;
      ParametroLivro:=edtlivro.ValorSemFormatacao;
      ParametroPagina:=edtpagina.ValorSemFormatacao;
      ParametroMaximo:=edtMaximo.ValorSemFormatacao;
      ParametroResumo:=rgpResumo.ItemIndex;
      ParametroRelatorio:=rgpRelatorio.ItemIndex;
      AgruparGrupoFilial:=ckbAgruparGrupoFilial.Checked;
      AgruparFilial:=ckbAgruparFilial.Checked;
      AgruparClasseGrupo:=ckbAgruparClasseProduto.Checked;
      AgruparGrupoProduto:=ckbAgruparGrupoProduto.Checked;
      AgruparProduto:=ckbAgruparProduto.Checked;
      AgruparLocalizacao:= ckbAgruparLocalizacao.Checked;
      ParametroOrdenacao:=rgpOrdenacao.ItemIndex;
      ComPrecodeVenda := ckbComPrecodeVenda.Checked;
      Compostos := cbbCompostos.itemIndex;
      MontarFiltroColunas(clbColunas);
      MontarFiltroTipodeProdutos(clbTiposProdutos);
      DefineOrdenacao;
      case ParametroRelatorio of
       0: begin
          if AbrirConsultaInventario then
          begin
            (*
            {$IFDEF MSWINDOWS}
            if MensagemSimNaoOpcaoCancelar('Deseja Exportar para o Excel','',False) = mryes then
            begin
              svdExportarExcel.FileName:= 'Relatório Inventário';
              if svdExportarExcel.Execute then
              begin
                dtmrelatorioinventario.LocalGravacao:= svdExportarExcel.FileName;
                dtmrelatorioinventario.GravarExcel;
              end;
            end
            else
              ImprimirRelatorio(edtdatainicial.text, edtdatafinal.Text);
            {$ELSE }
            *)

              ImprimirRelatorio(edtdatainicial.text, edtdatafinal.Text);

//            {$ENDIF}

          end
          else
          begin
            MensagemAviso(Format(ctNENHUMREGISTROENCONTRADO,['Registro']));
            if pgcFilialGrupoFilial.ActivePage = tstFilial then
               edfFilial.setFocus
            else
               edfGrupoFilial.setFocus;
          end;
         end;
       1: ImprimirRelatorio(edtDataInicial.text,edtdatafinal.text);
      end;
    end;
  end;
end;


procedure Tfrmrelatorioinventario.pgcFilialGrupoFilialChange(
  Sender: TObject);
begin
  inherited;
  if pgcFilialGrupoFilial.ActivePage = tstFilial then begin
    edfGrupoFilial.Clear;
    edfFilial.setFocus;
  end
  else begin
    edfFilial.Clear;
    edfGrupoFilial.setFocus;
  end;
end;


procedure Tfrmrelatorioinventario.pgcProdutosChange(Sender: TObject);
begin
  inherited;
    if pgcProdutos.ActivePage = tstProdutos then
    begin
     edfGrupoProduto.Clear;
     edfClasse.Clear;
     fraConsultaProduto.edfcodigo.SetFocus;
    end
    else
      if pgcProdutos.ActivePage = tstGrupodeProdutos then
      begin
       fraConsultaProduto.edfcodigo.Clear;
       edfClasse.Clear;
       edfGrupoProduto.SetFocus;
      end
      else
        if pgcProdutos.ActivePage = tstClasses then
        begin
         fraConsultaProduto.edfcodigo.Clear;
         edfGrupoProduto.Clear;
         edfClasse.SetFocus;
        end
      else
        if pgcProdutos.ActivePage = tstlocalizacao then
        begin
        edtLocalizacao.Clear;
        edtLocalizacao.SetFocus;
        end;
end;

