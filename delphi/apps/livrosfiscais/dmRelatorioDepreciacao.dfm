  object qryDepreciacao: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryDepreciacaoCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Ordenacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select * from crosstab'
      '('
      ' '#39
      
        ' select i.numero, i.codigobem, p.codigovisual, p.descricao as de' +
        'scricaoproduto,'
      '        i.ccdobem,  plb.descricao as descricaoccdobem,'
      
        #9#9'i.ccdepreciacaoacumulada, plda.descricao as descricaoccdepreci' +
        'acaoacumulada,'
      #9#9'i.ccdepreciacao, pld.descricao as descricaoccdepreciacao,'
      
        #9#9'i.iniciouso, i.taxadepreciacao, i.valordepreciar, i.data_saida' +
        ','
      '        cast(i.mes as varchar(7)) as mes,'
      #9#9'ValorDepreciacao(i.numero, i.data)'
      ' from'
      ' ('
      
        '  select i.numero, i.codigobem, i.ccdobem, i.ccdepreciacaoacumul' +
        'ada, i.ccdepreciacao, i.iniciouso, i.taxadepreciacao, i.valordep' +
        'reciar, i.data_saida, '
      
        '         d.mes, cast(date_trunc('#39#39'month'#39#39', cast(mes||'#39#39'-01'#39#39' as ' +
        'date)) + INTERVAL '#39#39'1 month'#39#39' - INTERVAL '#39#39'1 day'#39#39' as date) as d' +
        'ata'
      '  from imobilizado i,'
      '     (select distinct to_char(cast('#39#39
      '        %datainicial_r'
      '      '#39#39' as date)  + s.a,'#39#39'YYYY-MM'#39#39') as mes'
      '      from generate_series(1, cast('#39#39
      '      %datafinal_r'
      '      '#39#39' as date) - cast('#39#39
      '      %datainicial_r'
      '      '#39#39' as date)) as s(a) order by 1) as d'
      '  where true'
      '  %SQLListadeBens    '
      '  order by i.numero, d.mes'
      ' ) as i join produtos p on i.codigobem = p.codigo'
      '        join planocontas plb on i.ccdobem = plb.codigo'
      
        #9#9'join planocontas plda on i.ccdepreciacaoacumulada = plda.codig' +
        'o'
      #9#9'join planocontas pld on i.ccdepreciacao = pld.codigo'
      ' order by 1'#39','
      ''
      #39'select distinct to_char(cast('#39#39
      '                                %datainicial_p'
      
        '                                '#39#39' as date)  + s.a,'#39#39'YYYY-MM'#39#39') ' +
        'as mes'
      '      from generate_series(1, cast('#39#39
      '                                %datafinal_p'
      '                                '#39#39' as date) - cast('#39#39
      '                                %datainicial_p'
      '                                '#39#39' as date)) as s(a) order by 1'#39
      ')'
      ''
      'AS'
      ' ( numero integer,'
      '   codigobem bigint,'
      '   codigovisual varchar(30),'
      '   descricaoproduto varchar(50),'
      '   ccdobem integer,'
      '   descricaoccdobem varchar(50),'
      '   ccdepreciacaoacumulada integer,'
      '   descricaoccdepreciacaoacumulada varchar(50),'
      '   ccdepreciacao integer,'
      '   descricaoccdepreciacao varchar(50),'
      '   iniciouso date,'
      '   taxadepreciacao numeric(11,2),'
      '   valordepreciar numeric(11,2),'
      '   data_saida date,'
      '   m01_ano numeric(11,2),'
      '   m02_ano numeric(11,2),'
      '   m03_ano numeric(11,2),'
      '   m04_ano numeric(11,2),'
      '   m05_ano numeric(11,2),'
      '   m06_ano numeric(11,2),'
      '   m07_ano numeric(11,2),'
      '   m08_ano numeric(11,2),'
      '   m09_ano numeric(11,2),'
      '   m10_ano numeric(11,2),'
      '   m11_ano numeric(11,2),'
      '   m12_ano numeric(11,2)'
      ')'
      ''
      '%Ordenacao'
      
        '/* order by ccdobem, descricaoccdobem, ccdepreciacaoacumulada, d' +
        'escricaoccdepreciacaoacumulada, ccdepreciacao, descricaoccdeprec' +
        'iacao,  descricaoproduto, codigobem, codigovisual */'
      '')
    RequestLive = True
    Left = 40
    Top = 96
