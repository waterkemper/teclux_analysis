    Sql.Strings = (
      'select * from crosstab'
      '('
      ' '#39
      
        ' select i.numero, i.codigobem, p.codigovisual, i.iniciouso, i.ta' +
        'xadepreciacao, i.valordepreciar, i.data_saida, p.descricao as de' +
        'scricaoproduto, c.grupo, g.descricao as descricaogrupo, cast(i.m' +
        'es as varchar(7)) as mes, ValorDepreciacao(i.numero, i.data)'
      ' from'
      ' ('
      
        '  select i.numero, i.codigobem, i.iniciouso, i.taxadepreciacao, ' +
        'i.valordepreciar, i.data_saida, d.mes, cast(date_trunc('#39#39'month'#39#39 +
        ', cast(mes||'#39#39'-01'#39#39' as date)) + INTERVAL '#39#39'1 month'#39#39' - INTERVAL ' +
        #39#39'1 day'#39#39' as date) as data'
      '  from imobilizado i,'
      '     (select distinct to_char(cast('#39#39
      '        %datainicial_r'
      '      '#39#39' as date)  + s.a,'#39#39'YYYY-MM'#39#39') as mes'
      '      from generate_series(1, cast('#39#39
      '      %datafinal_r'
      '      '#39#39' as date) - cast('#39#39
      '      %datainicial_r'
      '      '#39#39' as date)) as s(a) order by 1) as d'
      '  where true'
      '  %SQLListadeBens    '
      '  order by i.numero, d.mes'
      ' ) as i join produtos p on i.codigobem = p.codigo'
      
        '             join caracteristicas c on p.caracteristica = c.codi' +
        'go'
      '                  join grupos g on c.grupo = g.codigo'
      ' order by 1'#39','
      ''
      #39'select distinct to_char(cast('#39#39
      '                                %datainicial_p'
      
        '                                '#39#39' as date)  + s.a,'#39#39'YYYY-MM'#39#39') ' +
        'as mes'
      '      from generate_series(1, cast('#39#39
      '                                %datafinal_p'
      '                                '#39#39' as date) - cast('#39#39
      '                                %datainicial_p'
      '                                '#39#39' as date)) as s(a) order by 1'#39
      ')'
      ''
      'AS'
      ' ( numero integer,'
      '   codigobem bigint,'
      '   codigovisual varchar(30),'
      '   iniciouso date,'
      '   taxadepreciacao numeric(11,2),'
      '   valordepreciar numeric(11,2),'
      '   data_saida date,'
      '   descricaoproduto varchar(50),'
      '   grupo varchar(4),'
      '   descricaogrupo varchar(50),'
      '   m01_ano numeric(11,2),'
      '   m02_ano numeric(11,2),'
      '   m03_ano numeric(11,2),'
      '   m04_ano numeric(11,2),'
      '   m05_ano numeric(11,2),'
