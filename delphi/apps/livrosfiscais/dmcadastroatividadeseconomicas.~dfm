      '     join cidades c on (c.estado, c.codigo) in '
      '     (select c2.estado, c2.codigo '
      '      from cidades c2 '
      '      where c2.codigoibge = ae_m.cidadeibge '
      '      order by c2.codigo desc limit 1)'
      '     '
      'where ae.codigo = :codigo     '
      'order by c.nome, ativo, ae_m.descricao'
      '')
