  Width = 739
  object qryDiarioAuxiliarParcelas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select ct.cliente,'
      '        ct.tipocliente,'
      '       ct.nome,'
      '       parcelas.contrato,'
      '       ct.data,'
      '       parcelas.parcela_inicial,'
      '       parcelas.parcela_final,'
      '       parcelas.vencto_inicial,'
      '       parcelas.valordebito,'
      '       ct.filialvenda,'
      '       f.nome as nomefilialvenda,'
      '       fgf.grupo as grupofilialvenda,'
      '       gf.descricao as nomegrupofilialvenda'
      '        '
      
        'from (contratos ct join (filiais f left join (filiaisgruposfilia' +
        'is fgf left join gruposfiliais gf on fgf.grupo = gf.codigo)'
      
        '                                                                ' +
        '                   on f.codigo = fgf.filial)'
      
        '                                         on ct.filialvenda = f.c' +
        'odigo),'
      '('
      'select p.contrato,'
      '       min(p.numero) as parcela_inicial,'
      '       max(p.numero) as parcela_final,'
      '       min(p.datavencto) as vencto_inicial,'
      '       sum(p.valorvencto) as valordebito'
      'from parcelas p'
      'where (p.datapagto is null or p.datapagto > :datasituacao)'
      'group by p.contrato'
      'order by p.contrato'
      ') as parcelas'
      'where ct.numero = parcelas.contrato and'
      '     ct.faturamento is not null and'
      '     ct.faturamento <= :datasituacao and'
      '     ct.origem is null '
      '/*     and ct.filialvenda in (1,3) */'
      '     and  parcela_inicial is not null'
      'order by UPPER(TO_ASCII(ct.nome,'#39'LATIN1'#39'))')
    RequestLive = False
    Left = 80
    Top = 8
    ParamData = <
      item
        DataType = ftString
        Name = 'datasituacao'
        ParamType = ptUnknown
        Value = #39'13/12/2005'#39
      end>
    object qryDiarioAuxiliarParcelascliente: TIntegerField
