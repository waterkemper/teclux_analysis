    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      
        'select  filialvenda, nomefilialvenda, grupofilialvenda, nomegrup' +
        'ofilialvenda, sum(valordebito) as valordebito'
      'from'
      '('
      
        ' select  case when :AgruparGrupoFilialVenda then fgf.grupo      ' +
        'else cast(null as integer) end as grupofilialvenda,'
      
        '           case when :AgruparGrupoFilialVenda then gf.descricao ' +
        'else cast(null as varchar) end as nomegrupofilialvenda,'
      
        '           case when :AgruparFilialVenda then ct.filialvenda els' +
        'e cast(null as integer) end as filialvenda,'
      
        '           case when :AgruparFilialVenda then f.nome         els' +
        'e cast(null as varchar) end as nomefilialvenda,'
      '           parcelas.valordebito'
      
        ' from (contratos ct join (filiais f left join (filiaisgruposfili' +
        'ais fgf left join gruposfiliais gf on fgf.grupo = gf.codigo)'
      
        '                                                                ' +
        '                   on f.codigo = fgf.filial)'
      
        '                                         on ct.filialvenda = f.c' +
        'odigo),'
      ' ('
      '  select p.contrato,'
      '       min(p.numero) as parcela_inicial,'
      '       sum(p.valorvencto) as valordebito'
      '  from parcelas p  '
      '  where (p.datapagto is null or p.datapagto > :datasituacao)  '
      '  group by p.contrato'
      '  order by p.contrato '
      ' ) as parcelas'
      ' where ct.numero = parcelas.contrato and'
      '     ct.faturamento is not null and'
      '     ct.faturamento <= :datasituacao and'
      '     ct.origem is null '
      '/*     and ct.filialvenda in (1,3)*/'
      '     and  parcela_inicial is not null'
      
        ' order by grupofilialvenda, nomegrupofilialvenda, filialvenda, n' +
        'omefilialvenda '
      ') as parcelas'
      
        'group by grupofilialvenda, nomegrupofilialvenda, filialvenda, no' +
        'mefilialvenda ')
    RequestLive = False
    Left = 80
    Top = 248
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'AgruparGrupoFilialVenda'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'AgruparFilialVenda'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'datasituacao'
        ParamType = ptUnknown
        Value = #39'13/12/2005'#39
      end>
