procedure Tdtmfcont.P_Registro0000;
begin
  with ACBrSPEDFCont.Bloco_0.Registro0000 do
  begin
    DT_INI      := DataInicial; // Data inicial das informações contidas no arquivo
    DT_FIN      := DataFinal; // Data final das informações contidas no arquivo
    NOME        := copy(qryFiliaisrazao.AsString,1,100); //Nome empresarial do empresário ou sociedade empresária.
    CNPJ        := somentenumero(qryFiliaiscnpj.AsString); // Número de inscrição do empresário ou sociedade empresária no CNPJ.
    UF          := qryFiliaisestado.AsString; // Sigla da unidade da federação do empresário ou sociedade empresária.
    IE          := copy(somentenumero(qryFiliaisinscricaoestadual.AsString),1,14); // Inscrição Estadual do empresário ou sociedade empresária.
    COD_MUN     := qryFiliaiscidadeibge.AsString; // Código do município do domicílio fiscal do empresário ou sociedade empresária, conforme tabela do IBGE - Instituto Brasileiro de Geografia e Estatística.
    IM          := qryFiliaisinscricaomunicipal.AsString; // Inscrição Municipal do empresário ou sociedade empresária.

    if (qryfcontsituacao.AsString <> '5') {and (qryfcontsituacao.AsString <> '0')} then
      IND_SIT_ESP := qryfcontsituacao.AsString /// Indicador de situação especial (conforme tabela publicada pelo Sped)
    else
      IND_SIT_ESP :='';

    IND_SIT_INI_PER := qryfcontIND_SIT_INI_PER.AsString;

  end;
end;






