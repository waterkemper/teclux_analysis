procedure Tdtmfcont.dsrfcontDataChange(Sender: TObject; Field: TField);
begin
  inherited;
  if (field = qryfcontexercicio) or
     (field = qryfcontfilial) then
  begin
    if (qryfcont.State = dsinsert) and
       ((qryfcontexercicio.AsString <> '') and
        (qryfcontfilial.AsInteger <> 0)) then
    begin
      DataInicial := strtodate('01/01/'+qryfcontexercicio.asstring);
      DataFinal := strtodate('31/12/'+qryfcontexercicio.asstring);
    end;
    qryfcontnomearquivo.AsString := 'FCONT_'+
      qryfcontfilial.AsString+'_'+
      qryfcontexercicio.AsString+'.TXT';
  end;
end;

