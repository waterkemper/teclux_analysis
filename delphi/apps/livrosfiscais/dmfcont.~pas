function Tdtmfcont.GerarArquivo(pArquivo: String): Boolean;
var
  NRegistrosDeclaracao,
  NRegistrosTotal : integer;
  Arq: TextFile;
  vPath,
  Barra,
  formato : String;
begin

  result := false;

  {$IFDEF LINUX}
    Barra := '/';
  {$ELSE}
    Barra := '\';
  {$ENDIF}

  vPath := SpedContabilDir+Barra;

  result := true;

  if SetarIntervalodeDatas then
  begin

    Bloco_0;
    Bloco_I;
    Bloco_J;
    Bloco_M;
    Bloco_9;

    try
      with ACBrSPEDFCont do
      begin
        DT_INI := DataInicial;
        DT_FIN := DataFinal;
        Path := vPath;
        SaveFileTXT(pArquivo);
      end;

    finally
      with ACBrSPEDFCont do
      begin
        Bloco_0.LimpaRegistros;
        Bloco_I.LimpaRegistros;
        Bloco_J.LimpaRegistros;
        Bloco_9.LimpaRegistros;
      end;
    end;

    qryfcont.Edit;
    qryfcontdata.AsDateTime := now();
    qryfcont.post;
  end
  else
    MensagemAviso('Esta filial não possui lançamentos contábeis no período');

end;


