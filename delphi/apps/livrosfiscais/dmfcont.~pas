end;

function Tdtmfcont.Gravarfcont: Boolean;
var
  ValorTotalDebito: Currency;
begin
  result := qryfcont.CheckRequiredFields;
  if result then
  begin
    qryfcont.Post;
    result := Perpetrar([qryfcont]);
  end;
end;

