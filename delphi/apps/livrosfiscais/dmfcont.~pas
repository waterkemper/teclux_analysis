      COD_CTA    :=  qryRegistroI050.fieldbyname('COD_CTA')    .asString;         // Código da conta analítica/grupo de contas.
      COD_CTA_SUP:=  qryRegistroI050.fieldbyname('COD_CTA_SUP').asString;         // Código da conta sintética /grupo de contas de nível imediatamente superior.
      CTA        :=  qryRegistroI050.fieldbyname('CTA')        .asString;         // Nome da conta analítica/grupo de contas.
    end;
    P_RegistroI051;
    qryRegistroI050.Next;
  end;
end;

