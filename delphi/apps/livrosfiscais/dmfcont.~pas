procedure Tdtmfcont.P_RegistroM025;
begin

  RefazConsultaPorNome(qryRegistroM025,['filial','datainicial','exercicio'],
    [qryfcontfilial.AsVariant, datainicial, qryfcontexercicio.AsVariant]);

  while not qryRegistroM025.Eof do
  begin
    with ACBrSpedFCont.Bloco_M.RegistroM025.New do
    begin
      COD_CTA        := qryRegistroM025cod_cta.AsString;          // Código da conta analítica.
      COD_CCUS       := '';                                       // Código do centro de custos.
      COD_CTA_REF    := qryRegistroM025cod_cta_ref.AsString;      // Código da conta no plano de contas referencial, conforme tabela publicada pelos órgãos indicados no campo COD_ENT_REF
      VL_SLD_FIN_FC  := abs(qryRegistroM025vl_sld_fin_fc.AsCurrency);  // Valor do saldo final fiscal recuperado do período anterior.
      IND_DC_FIN_FC  := qryRegistroM025ind_dc_fin_fc.AsString;    // Indicador da situação do saldo fiscal final: D - Devedor; C - Credor.
      VL_SLD_FIN_SOC := abs(qryRegistroM025vl_sld_fin_soc.AsCurrency); // Valor do saldo final societário recuperado do período anterior.
      IND_DC_FIN_SOC := qryRegistroM025ind_dc_fin_soc.AsString;   // Indicador da situação do saldo Societário final: D - Devedor; C - Credor.
    end;
    qryRegistroM025.Next;
  end;
end;

procedure Tdtmfcont.P_RegistroM030;
begin

  RefazConsultaPorNome(qryRegistroM030,['filial','datafinal','exercicio'],
    [qryfcontfilial.AsVariant, datafinal, qryfcontexercicio.AsVariant]);

  with ACBrSpedFCont.Bloco_M.RegistroM030.New do
  begin
    IND_PER     := 'A00'; { Tabela de períodos:
                            A00- Anual;
                            T01- Primeiro trimestre;
                            T02- Segundo trimestre;
                            T03- Terceiro trimestre;
                            T04- Quarto trimestre;
                          }
    VL_LUC_LIQ  := qryRegistroM030vl_luc_liq.AsCurrency;  //Valor do lucro líquido (ou do prejuízo) societário do período.
    IND_LUC_LIQ := qryRegistroM030ind_luc_liq.AsString;
  end;

end;

