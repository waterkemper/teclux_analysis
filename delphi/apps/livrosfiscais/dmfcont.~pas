  begin
    with ACBrSpedFCont.Bloco_I.RegistroI050.New do
    begin
      DT_ALT     :=  datainicial; // Data da inclusão/alteração.
      COD_NAT    :=  qryRegistroI050.fieldbyname('COD_NAT')    .asString;     // Código da natureza da conta/grupo de contas, conforme tabela publicada pelo Sped.
