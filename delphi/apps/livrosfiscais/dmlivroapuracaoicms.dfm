  object qryResumoSinteticoSaidas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';SELECT * FROM'
      '('
      'select temp.*,'
      '              CAST(titulo.codigo AS INTEGER) as titulo,'
      
        '              CAST(titulo.descricao AS VARCHAR) as descricaotitu' +
        'lo,'
      '              CAST( (select subtitulo.codigo'
      #9'            from codigosfiscais subtitulo'
      #9#9#9' where subtitulo.codigo<temp.codigofiscal'
      
        #9#9#9'   and tipo='#39'S'#39' order by subtitulo.codigo desc limit 1) AS IN' +
        'TEGER) as subtitulo,'
      '              CAST( (select subtitulo.descricao'
      #9'            from codigosfiscais subtitulo'
      #9#9#9' where subtitulo.codigo<temp.codigofiscal'
      
        #9#9#9'   and tipo='#39'S'#39' order by subtitulo.codigo desc limit 1) AS VA' +
        'RCHAR) as descricaosubtitulo'
      'from'
      '('
      ' SELECT       CAST(SUM(valortotal) AS NUMERIC) as valortotal,'
      '              CAST(SUM(base) AS NUMERIC) as base,'
      '              CAST(SUM(valor) AS NUMERIC) as valor,'
      '              CAST(SUM(isentas) AS NUMERIC) as isentas,'
      '              CAST(SUM(outras) AS NUMERIC) as outras,'
      '              CAST(codigofiscal AS INTEGER) as codigofiscal,'
      '              CAST(cf.descricao AS VARCHAR) as descricao'
      'FROM'
      ' ('
      '  ('
      ''
      '  SELECT codigofiscal,'
      '         sum(base+isentas+outras) as valortotal,'
      '         sum(base) as base,'
      '         sum(valor) as valor,'
      '         sum(isentas) as isentas,'
      '         sum(outras) as outras'
      ''
      '  FROM'
      '  ('
      '    ('
      '     SELECT  '
      
        '      case When df.CodigoFiscal in (5929,6929) then df.codigofis' +
        'cal else cdf.CodigoFiscal end as CodigoFiscal,'
      
        '      case When df.CodigoFiscal in (5929,6929) then 0 else (case' +
        ' When df.situacao='#39'N'#39' then cdf.base else 0 end) end as base,'
      
        '      case When df.CodigoFiscal in (5929,6929) then 0 else (case' +
        ' When df.situacao='#39'N'#39' then cdf.valor else 0 end) end as valor,'
      
        '      case When df.CodigoFiscal in (5929,6929) then 0 else (case' +
        ' When df.situacao='#39'N'#39' then cdf.isentas else 0 end) end as isenta' +
        's,'
      '      case When df.situacao='#39'N'#39' then'
      '       (case When df.CodigoFiscal in (5929,6929) then'
      '         (cdf.base+cdf.isentas+cdf.outras)'
      '        else cdf.outras end) else 0 end as outras'
      ''
      
        '    FROM ((dadosfiscais df join notas n on df.numero = n.dadofis' +
        'cal)'
      
        '                                       join (select * from calcu' +
        'losdadosfiscais_(:MesAno)) cdf on df.numero=cdf.dadofiscal)'
      '                                                             '
      ''
      '    Where cdf.tipo='#39'M'#39
      '      and cdf.codigofiscal not in (5933,6933,7933)'
      '      and (to_char(df.data, '#39'mm/yyyy'#39') = :MesAno)'
      #9'    and df.filialemissao = :filialemissao'
      ''
      '    )'
      ''
      '    union all'
      ''
      '    ('
      '    SELECT'
      
        '      cast(substring(cast(cdf.codigofiscal as varchar),1,1)||'#39'93' +
        '3'#39' as integer) as codigofiscal,'
      '      0.00 as base,'
      '      0.00 as valor,'
      '      0.00 as isentas,'
      
        '      case When df.situacao='#39'N'#39' then cdf.base+cdf.isentas+cdf.ou' +
        'tras else 0 end as outras'
      ''
      
        '    FROM ((dadosfiscais df join notas n on df.numero = n.dadofis' +
        'cal)'
      
        '                                       join (select * from calcu' +
        'losdadosfiscais_(:MesAno)) cdf on df.numero=cdf.dadofiscal)'
      '    Where cdf.tipo = '#39'S'#39
      '     and (to_char(df.data, '#39'mm/yyyy'#39') = :MesAno)'
      '  '#9'   and df.filialemissao = :filialemissao'
      ''
      '    )'
      '  ) as notascalculos'
      '    group by codigofiscal'
      ' )'
      'union all'
      ' ('
      
        #9#9'select codigofiscal, sum(valortributado+isentas+naotributadas+' +
        'outras) as valortotal,'
      #9'           sum(valortributado) as base,'
      '               sum(valoricms) as valor,'
      #9#9#9'   sum(isentas + naotributadas) as isentas,'
      #9#9#9'   sum(outras) as outras'
      #9#9'FROM'
      #9#9'('
      #9#9'('
      #9#9'select  cast(5405 as integer) as codigofiscal,'
      '    '#9#9'    0.00 as valortributado,'
      #9#9#9'      0.00 as valoricms,'
      
        #9#9#9'      sum(case when rzd.tipototalizadorparcial='#39'I1'#39' then rzd.' +
        'valoracumulado else 0.00 end) as isentas,'
      
        #9#9#9'      sum(case when rzd.tipototalizadorparcial='#39'N1'#39' then rzd.' +
        'valoracumulado else 0.00 end) as naotributadas,'
      
        #9#9#9'      sum(case when rzd.tipototalizadorparcial='#39'F1'#39' then rzd.' +
        'valoracumulado else 0.00 end) as outras'
      ''
      #9#9'from reducoesz rz'
      #9#9#9' join reducoeszdetalhes rzd'
      #9#9#9' on rz.filial = rzd.filial'
      #9#9#9' and rz.numerousuario = rzd.numerousuario'
      #9#9#9' and rz.cro = rzd.cro'
      #9#9#9' and rz.numerofabricacao = rzd.numerofabricacao'
      #9#9#9' and rz.datamovimento = rzd.datamovimento'
      ''
      
        '                where (to_char(rz.datamovimento, '#39'mm/yyyy'#39') = :M' +
        'esAno)'
      #9#9'  and rzd.tipototalizadorparcial  in ('#39'F1'#39', '#39'N1'#39', '#39'I1'#39')'
      '      and rz.filial = :filialemissao'
      ''
      #9#9')'
      ''
      #9#9'union all'
      ''
      #9#9'('
      #9#9'select cast(5102 as integer) as codigofiscal,'
      #9#9#9'     rzd.valoracumulado as valortributado,'
      '    '#9#9#9' (rzd.valoracumulado * rzd.aliquota)/100 as valoricms,'
      '    '#9#9#9' 0.00 as isentas,'
      #9#9'    '#9' 0.00 as naotributadas,'
      '    '#9#9#9' 0.00 as outras'
      ''
      #9#9'from reducoesz rz'
      #9#9#9' join reducoeszdetalhes rzd'
      #9#9#9' on rz.filial = rzd.filial'
      #9#9#9' and rz.numerousuario = rzd.numerousuario'
      #9#9#9' and rz.cro = rzd.cro'
      #9#9#9' and rz.numerofabricacao = rzd.numerofabricacao'
      #9#9#9' and rz.datamovimento = rzd.datamovimento'
      ''
      #9#9'where (to_char(rz.datamovimento, '#39'mm/yyyy'#39') = :MesAno)'
      '      and rz.filial = :filialemissao'
      #9#9'  and coalesce(rzd.aliquota,0)<>0'
      #9#9'  and rzd.tipototalizadorparcial  not in ('#39'F1'#39', '#39'N1'#39', '#39'I1'#39')'
      #9#9')'
      ''
      #9#9') as detalhes'
      #9#9'group by codigofiscal'
      ''
      ' )'
      
        ') as temp left join CodigosFiscais cf on temp.codigofiscal=cf.co' +
        'digo'
      'group by codigofiscal, cf.descricao'
      ') as temp'
      
        '              left join CodigosFiscais titulo on cast(substring(' +
        'cast(codigofiscal as varchar) from 1 for 1)||'#39'000'#39' as integer)=t' +
        'itulo.codigo'
      ') as rs'
      ''
      'ORDER BY rs.Titulo,'
      
        '         upper(to_ascii(rs.DescricaoTitulo,'#39'latin1'#39')), rs.Subtit' +
        'ulo,'
      
        '         upper(to_ascii(rs.DescricaoSubTitulo,'#39'latin1'#39')), rs.Cod' +
        'igoFiscal,'
      '         upper(to_ascii(rs.Descricao,'#39'latin1'#39'))'
      ''
      '')
    RequestLive = False
    Left = 272
    Top = 280
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'MesAno'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filialemissao'
        ParamType = ptUnknown
      end>
    object qryResumoSinteticoSaidasvalortotal: TFloatField
      FieldName = 'valortotal'
      DisplayFormat = '0.00'
    end
