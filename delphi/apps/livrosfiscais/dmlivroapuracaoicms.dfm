      '          q.numeroguia4,'
      '          q.dataguia4,'
      '          q.valorguia4,'
      '          q.orgaoguia4'
      'from quadrosgia q'
      
        'where q.periodo = :MesAno and ((trim(q.numeroguia1)<>'#39#39') or (q.d' +
        'ataguia1 is not null) or (q.valorguia1<>0) or (trim(q.orgaoguia1' +
        ')<>'#39#39') or'
      
        '                                               (trim(q.numerogui' +
        'a2)<>'#39#39') or (q.dataguia2 is not null) or (q.valorguia2<>0) or (t' +
        'rim(q.orgaoguia2)<>'#39#39') or'
      
        '                                               (trim(q.numerogui' +
        'a3)<>'#39#39') or (q.dataguia3 is not null) or (q.valorguia3<>0) or (t' +
        'rim(q.orgaoguia3)<>'#39#39') or'
      
        '                                               (trim(q.numerogui' +
        'a4)<>'#39#39') or (q.dataguia4 is not null) or (q.valorguia4<>0) or (t' +
        'rim(q.orgaoguia4)<>'#39#39'))'
      '/* Where Filiais */ ')
