  object qryResumoSinteticoEntradas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereFiliais'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';SELECT * FROM'
      '('
      'select entradas.*,'
      '       titulo.codigo as titulo,'
      '       titulo.descricao as descricaotitulo,'
      '       (select subtitulo.codigo'
      #9'from codigosfiscais subtitulo'
      #9'where subtitulo.codigo<entradas.codigofiscal'
      #9'  and tipo='#39'S'#39
      #9'order by subtitulo.codigo desc limit 1) as subtitulo,'
      #9'(select subtitulo.descricao'
      #9' from codigosfiscais subtitulo'
      #9' where subtitulo.codigo<entradas.codigofiscal'
      #9'   and tipo='#39'S'#39
      #9' order by subtitulo.codigo desc limit 1) as descricaosubtitulo'
      'from'
      '('
      '  SELECT np.filial as filial,'
      '         f.nome as nomefilial,'
      '         cnp.codigofiscal,'
      '         cf.descricao, '
      '         sum(cnp.base+cnp.isentas+cnp.outras) as valornota,'
      '         sum(cnp.base) as base,'
      '         sum(cnp.valor) as valor,'
      '         sum(cnp.isentas) as isentas,'
      '         sum(cnp.outras) as outras'
      '  '
      '  FROM ((notaspag np '
      '         join (calculosnotaspag cnp '
      '               join CodigosFiscais cf '
      '               on cnp.codigofiscal=cf.codigo)'
      ''
      '         on np.codigo = cnp.codigonota)'
      ''
      ''
      '         join filiais f '
      '         on np.filial=f.codigo)'
      '  Where cnp.tipo='#39'M'#39
      '    and np.situacao = '#39'N'#39
      '    and cnp.codigofiscal between 1001 and 3948'
      '    and (to_char(np.data, '#39'mm/yyyy'#39') = :MesAno)'
      '  '
      '  %WhereFiliais'
      '  '
      '  group by np.filial, f.nome, cnp.codigofiscal, cf.descricao'
      
        '  order by np.filial, UPPER(TO_ASCII(f.nome,'#39'LATIN1'#39')), cnp.codi' +
        'gofiscal, cf.descricao'
      
        ') as entradas left join CodigosFiscais titulo on cast(substring(' +
        'cast(codigofiscal as varchar) from 1 for 1)||'#39'000'#39' as integer)=titulo.codigo'
      ''
      ') AS rs'
      ''
      
        'ORDER BY UPPER(TO_ASCII(rs.NomeFilial,'#39'LATIN1'#39')), rs.Filial, rs.' +
        'Titulo,'
      
        '         UPPER(TO_ASCII(rs.DescricaoTitulo,'#39'LATIN1'#39')), rs.Subtit' +
        'ulo,'
      
        '         UPPER(TO_ASCII(rs.DescricaoSubTitulo,'#39'LATIN1'#39')), rs.Cod' +
        'igoFiscal,'
      '         UPPER(TO_ASCII(rs.Descricao,'#39'LATIN1'#39'))'
      '')
    RequestLive = False
    Left = 72
    Top = 280
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'MesAno'
        ParamType = ptUnknown
      end>
    object qryResumoSinteticoEntradasfilial: TIntegerField
      FieldName = 'filial'
      DisplayFormat = '0'
    end
    object qryResumoSinteticoEntradasnomefilial: TStringField
      FieldName = 'nomefilial'
      Size = 50
    end
    object qryResumoSinteticoEntradasvalornota: TFloatField
      FieldName = 'valornota'
      DisplayFormat = '0.00'
    end
    object qryResumoSinteticoEntradasbase: TFloatField
      FieldName = 'base'
      DisplayFormat = '0.00'
    end
    object qryResumoSinteticoEntradasvalor: TFloatField
      FieldName = 'valor'
      DisplayFormat = '0.00'
    end
    object qryResumoSinteticoEntradasisentas: TFloatField
      FieldName = 'isentas'
      DisplayFormat = '0.00'
    end
    object qryResumoSinteticoEntradasoutras: TFloatField
      FieldName = 'outras'
      DisplayFormat = '0.00'
    end
    object qryResumoSinteticoEntradastitulo: TIntegerField
      FieldName = 'titulo'
      DisplayFormat = '0'
    end
    object qryResumoSinteticoEntradasdescricaotitulo: TStringField
      FieldName = 'descricaotitulo'
      Size = 80
    end
    object qryResumoSinteticoEntradassubtitulo: TIntegerField
      FieldName = 'subtitulo'
      DisplayFormat = '0'
    end
    object qryResumoSinteticoEntradasdescricaosubtitulo: TStringField
      FieldName = 'descricaosubtitulo'
      Size = 80
    end
    object qryResumoSinteticoEntradascodigofiscal: TIntegerField
      FieldName = 'codigofiscal'
      DisplayFormat = '0'
    end
    object qryResumoSinteticoEntradasdescricao: TStringField
      FieldName = 'descricao'
      Size = 80
    end
  end
