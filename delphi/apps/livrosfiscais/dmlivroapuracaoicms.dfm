    Macros = <>
    Sql.Strings = (
      'select  q.numeroguia1, '
      '          q.dataguia1,'
      '          q.valorguia1,'
      '          q.orgaoguia1,'
      '          q.numeroguia2,'
      '          q.dataguia2,'
      '          q.valorguia2,'
      '          q.orgaoguia2,'
      '          q.numeroguia3,'
