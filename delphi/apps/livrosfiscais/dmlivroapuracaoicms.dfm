  object qryQuadrosGIA: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryQuadrosGIACalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      ' SELECT CAST(grupofilial AS INTEGER),'
      '              CAST(nomegrupofilial AS VARCHAR),'
      '              CAST(filial AS INTEGER), '
      '              CAST(nomefilial AS VARCHAR),'
      '              CAST(periodo AS VARCHAR),'
      
        '              CAST(SUM(debitopelassaidas) AS NUMERIC) as debitop' +
        'elassaidas,'
      
        '              CAST(SUM(debdiferencialaliquota) AS NUMERIC) as de' +
        'bdiferencialaliquota,'
      
        '              CAST(SUM(debtransferencia) AS NUMERIC) as debtrans' +
        'ferencia,'
      
        '              CAST(SUM(debestornocredito) AS NUMERIC) as debesto' +
        'rnocredito,'
      
        '              CAST(SUM(debestornoativoimobilizado) AS NUMERIC) a' +
        's debestornoativoimobilizado,'
      
        '              CAST(SUM(outrosdebitos) AS NUMERIC) as outrosdebit' +
        'os,'
      
        '              CAST(SUM(debestornoativoimobilizado) AS NUMERIC) a' +
        's debestornoativoimobilizado,'
      '              /* subtotaldebitos */'
      
        '              CAST(SUM(debapuracaoconsolidada) AS NUMERIC) as de' +
        'bapuracaoconsolidada,'
      '              /* saldocredorparaperiodoseguinte */'
      '              /* totaldebitos */'
      ''
      '              /* saldoperiodoanterior */'
      
        '              CAST(SUM(subtotaldebitoanterior) AS NUMERIC) as su' +
        'btotaldebitoanterior,'
      
        '              CAST(SUM(subtotalcreditoanterior) AS NUMERIC) as s' +
        'ubtotalcreditoanterior,'
      
        '              CAST(SUM(creditopelasentradas) AS NUMERIC) as cred' +
        'itopelasentradas,'
      
        '              CAST(SUM(creddifaliquotaativoimobil) AS NUMERIC) a' +
        's creddifaliquotaativoimobil,'
      
        '              CAST(SUM(creddifaliquotamaterialconsumo) AS NUMERI' +
        'C) as creddifaliquotamaterialconsumo,'
      
        '              CAST(SUM(credtransferencia) AS NUMERIC) as credtra' +
        'nsferencia,'
      
        '              CAST(SUM(credpresumidos) AS NUMERIC) as credpresum' +
        'idos,'
      
        '              CAST(SUM(credincetivosfiscais) AS NUMERIC) as cred' +
        'incetivosfiscais,'
      
        '              CAST(SUM(credpagtoocasiaofatogerador) AS NUMERIC) ' +
        'as credpagtoocasiaofatogerador,'
      
        '              CAST(SUM(outroscreditos) AS NUMERIC) as outroscred' +
        'itos,'
      '              /* subtotalcreditos */'
      
        '              CAST(SUM(credapuracaoconsolidada) AS NUMERIC) as c' +
        'redapuracaoconsolidada'
      '              /* impostorecolher */'
      '              /* totalcreditos */'
      'FROM '
      '('
      'select'
      
        '  case When :AgruparGrupoFilial then fgf.grupo              else' +
        ' null end as grupofilial,'
      
        '  case When :AgruparGrupoFilial then gf.descricao         else n' +
        'ull end as nomegrupofilial,'
      
        '  case When :AgruparFilial          then q.filial               ' +
        '  else null end as filial,'
      
        '  case When :AgruparFilial          then f.nome                e' +
        'lse null end as nomefilial,'
      '  q.periodo,   '
      '  case When :AgruparGrupoFilial and not :AgruparFilial then'
      '   ('
      
        '    (select sum(valor) from NotasSaidasApuracaoCalculo NSAC wher' +
        'e NSAC.filialemissao in (Select filial From filiaisgruposfiliais' +
        ' Where grupo = fgf.grupo)) +'
      
        '    (select sum(valor) from CuponsSaidasApuracaoCalculo CSAC whe' +
        're CSAC.filialemissao in (Select filial From filiaisgruposfiliai' +
        's Where grupo = fgf.grupo))'
      '    ) else'
      '      ('
      
        '       (select sum(valor) from NotasSaidasApuracaoCalculo NSAC w' +
        'here NSAC.filialemissao = q.Filial) +'
      
        '       (select sum(valor) from CuponsSaidasApuracaoCalculo CSAC ' +
        'where CSAC.filialemissao = q.Filial)'
      '       ) '
      '  end as debitopelassaidas,'
      '  sum(q.debdiferencialaliquota) as debdiferencialaliquota,'
      '  sum(q.debtransferencia) as debtransferencia,'
      '  sum(q.debestornocredito) as debestornocredito,'
      
        '  sum(q.debestornoativoimobilizado) as debestornoativoimobilizad' +
        'o,'
      '  sum(q.outrosdebitos) as outrosdebitos,'
      '  /* subtotaldebitos */'
      '  sum(q.debapuracaoconsolidada) as debapuracaoconsolidada,'
      '  /* saldocredorparaperiodoseguinte */'
      '  /* totaldebitos */'
      ''
      '  /* saldoperiodoanterior */'
      '  case When :AgruparGrupoFilial and not :AgruparFilial then'
      '  ('
      
        '      (select sum(cdf.valor) from dadosfiscais df, calculosdados' +
        'fiscais cdf  where df.numero=cdf.dadofiscal and'
      
        '             df.situacao='#39'N'#39' and cdf.tipo='#39'M'#39' and (to_char(df.da' +
        'ta, '#39'mm/yyyy'#39') < :MesAno) and df.filialemissao in (Select filial' +
        ' From filiaisgruposfiliais Where grupo = fgf.grupo)) +'
      
        '      (select sum(qg.debdiferencialaliquota+qg.debtransferencia+' +
        'qg.debestornocredito+qg.debestornoativoimobilizado+qg.outrosdebi' +
        'tos+qg.debapuracaoconsolidada)'
      
        '                                 from quadrosgia qg where qg.per' +
        'iodo<:MesAno and qg.filial in (Select filial From filiaisgruposf' +
        'iliais Where grupo = fgf.grupo))'
      '   ) else'
      '     ('
      
        '      (select sum(cdf.valor) from dadosfiscais df, calculosdados' +
        'fiscais cdf  where df.numero=cdf.dadofiscal and'
      
        '          df.situacao='#39'N'#39' and cdf.tipo='#39'M'#39' and (to_char(df.data,' +
        ' '#39'mm/yyyy'#39') < :MesAno) and df.filialemissao=q.filial) +'
      
        '      (select sum(qg.debdiferencialaliquota+qg.debtransferencia+' +
        'qg.debestornocredito+qg.debestornoativoimobilizado+qg.outrosdebi' +
        'tos+qg.debapuracaoconsolidada)'
      
        '                               from quadrosgia qg where qg.filia' +
        'l=q.filial and qg.periodo<:MesAno)'
      '      ) '
      '  end as subtotaldebitoanterior,'
      ''
      '  case When :AgruparGrupoFilial and not :AgruparFilial then'
      '  ( '
      
        '   (select sum(valor) from notaspag np,calculosnotaspag cnp Wher' +
        'e np.codigo = cnp.codigonota'
      
        '               and cnp.tipo='#39'M'#39' and (to_char(np.data, '#39'mm/yyyy'#39')' +
        ' < :MesAno) and np.filial in (Select filial From filiaisgruposfi' +
        'liais Where grupo = fgf.grupo)) +'
      
        '   (select sum(qg.creddifaliquotaativoimobil+qg.creddifaliquotam' +
        'aterialconsumo+qg.credtransferencia+qg.credpresumidos+qg.credinc' +
        'etivosfiscais+'
      
        '                        qg.outroscreditos+qg.credapuracaoconsoli' +
        'dada+qg.credpagtoocasiaofatogerador)'
      
        '                                 from quadrosgia qg where qg.per' +
        'iodo<:MesAno and qg.filial in (Select filial From filiaisgruposf' +
        'iliais Where grupo = fgf.grupo))'
      ''
      '   ) else'
      '     ('
      
        '      (select sum(valor) from notaspag np, calculosnotaspag cnp ' +
        'Where np.codigo = cnp.codigonota'
      
        '               and cnp.tipo='#39'M'#39' and (to_char(np.data, '#39'mm/yyyy'#39')' +
        ' < :MesAno) and np.filial=q.filial) +'
      
        '      (select sum(qg.creddifaliquotaativoimobil+qg.creddifaliquo' +
        'tamaterialconsumo+qg.credtransferencia+qg.credpresumidos+qg.cred' +
        'incetivosfiscais+'
      
        '                       qg.outroscreditos+qg.credapuracaoconsolid' +
        'ada+qg.credpagtoocasiaofatogerador)'
      
        '                                 from quadrosgia qg where qg.fil' +
        'ial=q.filial and qg.periodo<:MesAno)'
      '      ) '
      '  end as subtotalcreditoanterior,'
      ''
      '  case When :AgruparGrupoFilial and not :AgruparFilial then'
      '  (  '
      
        '   (select sum(valor) from NotasEntradasApuracaoCalculo NEAC whe' +
        're NEAC.filialemissao in (Select filial From filiaisgruposfiliai' +
        's Where grupo = fgf.grupo))'
      '   ) else'
      '     (    '
      
        '      (select sum(valor) from NotasEntradasApuracaoCalculo NEAC ' +
        'where NEAC.filialemissao = q.Filial)'
      '      )'
      '  end as creditopelasentradas,'
      ''
      
        '  sum(q.creddifaliquotaativoimobil) as creddifaliquotaativoimobi' +
        'l,'
      
        '  sum(q.creddifaliquotamaterialconsumo) as creddifaliquotamateri' +
        'alconsumo,'
      '  sum(q.credtransferencia) as credtransferencia,'
      '  sum(q.credpresumidos) as credpresumidos,'
      '  sum(q.credincetivosfiscais) as credincetivosfiscais,'
      
        '  sum(q.credpagtoocasiaofatogerador) as credpagtoocasiaofatogera' +
        'dor,'
      '  sum(q.outroscreditos) as outroscreditos,'
      '/* subtotalcreditos */'
      '  sum(q.credapuracaoconsolidada) as credapuracaoconsolidada'
      '/* impostorecolher */'
      '/* totalcreditos */'
      ''
      
        '/*  q.faturamento, q.qtdadeempregados, q.acrescimofinanceiro, q.' +
        'despesamensalpessoal, q.substbasecalculo, q.substimpostoretido, ' +
        'q.substcreditos, q.substressarcimentoICMS */'
      ''
      
        'from (quadrosgia q left join (filiais f left join (filiaisgrupos' +
        'filiais fgf left join gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                       on f.codigo=fgf.filial)'
      
        '                                              on q.filial=f.codi' +
        'go)'
      'where q.periodo = :MesAno'
      '/* Where Filiais */         '
      'group by  gf.descricao, fgf.grupo, f.nome, q.filial, q.periodo'
      ') as temp'
      
        'group by nomegrupofilial, grupofilial, nomefilial, filial, perio' +
        'do')
    RequestLive = True
    Left = 658
    Top = 37
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'AgruparGrupoFilial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'AgruparFilial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'MesAno'
        ParamType = ptUnknown
      end>
