    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereFiliais'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';SELECT * FROM'
      '('
      'select temp.*,'
      '              CAST(titulo.codigo AS INTEGER) as titulo,'
      
        '              CAST(titulo.descricao AS VARCHAR) as descricaotitu' +
        'lo,'
      '                 CAST( (select subtitulo.codigo'
      #9'            from codigosfiscais subtitulo'
      #9#9#9' where subtitulo.codigo<temp.codigofiscal'
      
        #9#9#9'   and tipo='#39'S'#39' order by subtitulo.codigo desc limit 1) AS IN' +
        'TEGER) as subtitulo,'
      '              CAST( (select subtitulo.descricao'
      #9'            from codigosfiscais subtitulo'
      #9#9#9' where subtitulo.codigo<temp.codigofiscal'
      
        #9#9#9'   and tipo='#39'S'#39' order by subtitulo.codigo desc limit 1) AS VA' +
        'RCHAR) as descricaosubtitulo'
      'from'
      '('
      ' SELECT       filial,'
      '              nomefilial,'
      '              SUM(valortotal) as valortotal,'
      '              SUM(base) as base,'
      '              SUM(valor) as valor,'
      '              SUM(isentas) as isentas,'
      '              SUM(outras) as outras,'
      '              codigofiscal,'
      '              cf.descricao'
      'FROM'
      '('
      '('
      ' select filial,'
      '        nomefilial,'
      #9'codigofiscal,'
      '        sum(base+isentas+outras) as valortotal,'
      #9'sum(base) as base,'
      #9'sum(valor) as valor,'
      #9'sum(isentas) as isentas,'
      #9'sum(outras) as outras'
      ' from'
      ' ('
      ' ('
      '  SELECT df.filialemissao as filial,'
      '         f.nome as nomefilial,'
      
        '         case When df.CodigoFiscal in (5929,6929) then df.codigo' +
        'fiscal else cdf.CodigoFiscal end as CodigoFiscal,'
      
        '         case When df.CodigoFiscal=5929 then 0 else (case When d' +
        'f.situacao='#39'N'#39' then cdf.base else 0 end) end as base,'
      
        '         case When df.CodigoFiscal=5929 then 0 else (case When d' +
        'f.situacao='#39'N'#39' then cdf.valor else 0 end) end as valor,'
      
        '         case When df.CodigoFiscal=5929 then 0 else (case When d' +
        'f.situacao='#39'N'#39' then cdf.isentas else 0 end) end as isentas,'
      '         case When df.situacao='#39'N'#39' then'
      '          (case When df.CodigoFiscal=5929 then'
      '             (cdf.base+cdf.isentas+cdf.outras)'
      '           else cdf.outras end) else 0 end as outras'
      
        '  FROM (((dadosfiscais df join notas n on df.numero = n.dadofisc' +
        'al)'
      
        '                              join calculosdadosfiscais cdf on d' +
        'f.numero=cdf.dadofiscal)'
      
        '                                   join filiais f on df.filialem' +
        'issao=f.codigo)'
      '  Where cdf.tipo='#39'M'#39
      '    and (to_char(df.data, '#39'mm/yyyy'#39') = :MesAno)'
      '    and cdf.codigofiscal not in (5933,6933,7933)'
      '    and df.codigofiscal not in (5933,6933,7933)'
      '    and cdf.codigofiscal between 5001 and 7999'
      
        '    and (n.filial,n.serie) in (select sf.filial,sf.valor from se' +
        'riesfiliais sf where sf.ativa)'
      ''
      '  %WhereFiliais'
      ' )'
      ' union all'
      ' ('
      '  SELECT df.filialemissao as filial,'
      '         f.nome as nomefilial,'
      
        '         cast(substring(cdf.codigofiscal,1,1)||'#39'933'#39' as integer)' +
        ' as codigofiscal,'
      '         0.00 as base,'
      '         0.00 as valor,'
      '         0.00 as isentas,'
      
        '         case When df.situacao='#39'N'#39' then cdf.base+cdf.isentas-cdf' +
        '.outras else 0 end as outras'
      ''
      
        ' FROM (((dadosfiscais df join notas n on df.numero = n.dadofisca' +
        'l)'
      
        '                              join calculosdadosfiscais cdf on d' +
        'f.numero=cdf.dadofiscal)'
      
        '                                   join filiais f on df.filialem' +
        'issao=f.codigo)'
      'Where cdf.tipo = '#39'S'#39
      '  and (to_char(df.data, '#39'mm/yyyy'#39') = :MesAno)'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      ''
      '  %WhereFiliais'
      ' )'
      ' ) as NotasSaidasCalculo'
      ' group by filial, nomefilial, codigofiscal'
      ')'
      'union all'
      '('
      ' select filial,'
      '        nomefilial,'
      #9'codigofiscal,'
      '        sum(base+isentas+outras) as valortotal,'
      #9'sum(base) as base,'
      #9'sum(valor) as valor,'
      #9'sum(isentas) as isentas,'
      #9'sum(outras) as outras'
      ' from'
      ' ('
      '  SELECT df.filialemissao as filial,'
      '       f.nome as nomefilial,'
      '       cdf.codigofiscal,'
      
        '       case when df.situacao='#39'N'#39' then cdf.base else 0 end as bas' +
        'e,'
      
        '       case when df.situacao='#39'N'#39' then cdf.valor else 0 end as va' +
        'lor,'
      
        '       case when df.situacao='#39'N'#39' then cdf.isentas else 0 end as ' +
        'isentas,'
      
        '       case when df.situacao='#39'N'#39' then cdf.outras else 0 end as o' +
        'utras'
      ''
      
        '  FROM (((dadosfiscais df join cupons c on df.numero = c.dadofis' +
        'cal)'
      
        '                                   join calculosdadosfiscais cdf' +
        ' on df.numero=cdf.dadofiscal)'
      
        '                                   join filiais f on df.filialem' +
        'issao=f.codigo)'
      '  Where cdf.tipo='#39'M'#39
      '    and (to_char(df.data, '#39'mm/yyyy'#39') = :MesAno)'
      ''
      ' %WhereFiliais'
      ' ) as CuponsSaidasCalculo'
      'group by filial, nomefilial, codigofiscal'
      ')'
      
        ') as temp left join CodigosFiscais cf on temp.codigofiscal=cf.co' +
        'digo'
      'group by nomefilial, filial, codigofiscal, cf.descricao'
      ') as temp'
      
        '              left join CodigosFiscais titulo on cast(substring(' +
        'codigofiscal from 1 for 1)||'#39'000'#39' as integer)=titulo.codigo'
      ''
      ') AS rs'
      ''
      
        'ORDER BY UPPER(TO_ASCII(rs.NomeFilial,'#39'LATIN1'#39')), rs.Filial, rs.' +
        'Titulo,'
      
        '         UPPER(TO_ASCII(rs.DescricaoTitulo,'#39'LATIN1'#39')), rs.Subtit' +
        'ulo,'
      
        '         UPPER(TO_ASCII(rs.DescricaoSubTitulo,'#39'LATIN1'#39')), rs.Cod' +
        'igoFiscal,'
      '         UPPER(TO_ASCII(rs.Descricao,'#39'LATIN1'#39'))'
      '')
    RequestLive = False
