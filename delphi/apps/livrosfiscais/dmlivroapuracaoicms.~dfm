        ' null end as grupofilial,'
      
        '  case When :AgruparGrupoFilial then gf.descricao         else n' +
        'ull end as nomegrupofilial,'
      
        '  case When :AgruparFilial          then q.filial               ' +
        '  else null end as filial,'
      
        '  case When :AgruparFilial          then f.nome                e' +
        'lse null end as nomefilial,'
      '  q.periodo,   '
      '  case When :AgruparGrupoFilial and not :AgruparFilial then'
      '   ('
      
        '    (select sum(valor) from NotasSaidasApuracaoCalculo NSAC wher' +
        'e NSAC.filialemissao in (Select filial From filiaisgruposfiliais' +
        ' Where grupo = fgf.grupo)) +'
      
        '    (select sum(valor) from CuponsSaidasApuracaoCalculo CSAC whe' +
        're CSAC.filialemissao in (Select filial From filiaisgruposfiliai' +
        's Where grupo = fgf.grupo))'
      '    ) else'
      '      ('
      
        '       (select sum(valor) from NotasSaidasApuracaoCalculo NSAC w' +
        'here NSAC.filialemissao = q.Filial) +'
      
        '       (select sum(valor) from CuponsSaidasApuracaoCalculo CSAC ' +
        'where CSAC.filialemissao = q.Filial)'
      '       ) '
      '  end as debitopelassaidas,'
      '  sum(q.debdiferencialaliquota) as debdiferencialaliquota,'
      '  sum(q.debtransferencia) as debtransferencia,'
      '  sum(q.debestornocredito) as debestornocredito,'
      
        '  sum(q.debestornoativoimobilizado) as debestornoativoimobilizad' +
        'o,'
      '  sum(q.outrosdebitos) as outrosdebitos,'
      '  /* subtotaldebitos */'
      '  sum(q.debapuracaoconsolidada) as debapuracaoconsolidada,'
      '  /* saldocredorparaperiodoseguinte */'
      '  /* totaldebitos */'
      ''
      '  /* saldoperiodoanterior */'
      '  case When :AgruparGrupoFilial and not :AgruparFilial then'
      '  ('
      
        '      (select sum(cdf.valor) from dadosfiscais df, calculosdados' +
        'fiscais cdf  where df.numero=cdf.dadofiscal and'
      
        '             df.situacao='#39'N'#39' and cdf.tipo='#39'M'#39' and (to_char(df.da' +
