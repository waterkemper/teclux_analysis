      'select estado,'
      '       cidade,'
      '       dadofiscal,'
      '       aliquotaissqn as aliquota,'
      '       sum(valorissqn) as valor,'
      
        '       sum(case when reterissqn then valorissqn else 0 end) as V' +
        'alorRetido,'
      '       sum(quantidade * valorservico) as tributavel'
      'from ('
      '      select df.numero as dadofiscal,'
      '             sdf.estado,'
      '             sdf.cidade,'
