        'umero = sdf.dadofiscal'
      '      where df.situacao = '#39'N'#39
      '        and df.data between :dataInicial and :datafinal'
      '        %FiltroFiliais'
      '     ) as servicos'
      'group by estado,cidade,dadofiscal, aliquota'
      'order by estado,cidade,dadofiscal, aliquota')
