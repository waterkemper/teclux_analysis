  object qryLivroApuracaoISS: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'FiltroFiliais'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select    df.numero as dadofiscal,'
      '          df.data,'
      '          n.serie,'
      '          n.numero,'
      '          df.cliente,'
      '          df.nome,'
      '          df.valortotal,'
      ''
      '          df.valortotal -'
      '          (select sum(cdf.base+cdf.isentas+cdf.outras)'
      '           from calculosdadosfiscais cdf'
      '           where cdf.dadofiscal = df.numero'
      '               and cdf.tipo='#39'S'#39') as materiais,'
      ''
      '          (select count(*)'
      '           from venctosdadosfiscais vdf'
      '           where vdf.dadofiscal = df.numero) as NVenctos'
      ''
      'from (dadosfiscais df join notas n on df.numero = n.dadofiscal)'
      'where exists (select sdf.dadofiscal'
      '              from servicosdadosfiscais sdf'
      '              where sdf.dadofiscal = df.numero)'
      '  and df.situacao = '#39'N'#39
      '  and df.data between :dataInicial and :datafinal'
      ''
      '%FiltroFiliais'
      ''
      'order by df.data, n.serie, n.numero')
    RequestLive = False
    Left = 152
    Top = 8
    ParamData = <
      item
        DataType = ftString
        Name = 'dataInicial'
        ParamType = ptUnknown
        Value = #39'01/01/2000'#39
      end
      item
        DataType = ftString
        Name = 'datafinal'
        ParamType = ptUnknown
        Value = #39'31/12/2007'#39
      end>
    object qryLivroApuracaoISSdadofiscal: TIntegerField
      FieldName = 'dadofiscal'
      DisplayFormat = '0'
    end
    object qryLivroApuracaoISSdata: TDateField
      Alignment = taCenter
      FieldName = 'data'
      EditMask = '99/99/9999;1; '
    end
    object qryLivroApuracaoISSserie: TStringField
      FieldName = 'serie'
      Size = 3
    end
    object qryLivroApuracaoISSnumero: TIntegerField
      FieldName = 'numero'
      DisplayFormat = '0'
    end
    object qryLivroApuracaoISScliente: TIntegerField
      FieldName = 'cliente'
      DisplayFormat = '0'
    end
    object qryLivroApuracaoISSnome: TStringField
      FieldName = 'nome'
      Size = 40
    end
    object qryLivroApuracaoISSvalortotal: TFloatField
      FieldName = 'valortotal'
      DisplayFormat = '0.00'
    end
    object qryLivroApuracaoISSmateriais: TFloatField
      FieldName = 'materiais'
      DisplayFormat = '0.00'
    end
    object qryLivroApuracaoISSnvenctos: TLargeintField
      FieldName = 'nvenctos'
    end
