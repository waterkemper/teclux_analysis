  object qryResumoEstadoCidade: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'FiltroFiliais'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'select estado,'
      '       cidade,'
      '       nomecidade,'
      '       dadofiscal,'
      '       data,'
      '       serie,'
      '       numero,'
      '       cliente,'
      '       nome,'
      
        '       sum(quantidade*valorservico)/valorservicos*valortotal as ' +
        'valortotal,'
      
        '       ((sum(quantidade*valorservico)/valorservicos*valortotal) ' +
        '- sum(quantidade*valorservico)) as materiais,'
      '       (select count(*)'
      '          from venctosdadosfiscais vdf'
      '         where vdf.dadofiscal = dadofiscal) as NVenctos'
      'from ('
      '      select    df.numero as dadofiscal,'
      '                df.data,'
      '                n.serie,'
      '                n.numero,'
      '                df.cliente,'
      '                df.nome,'
      '                df.valortotal,'
      '                df.valorservicos,'
      '                sdf.quantidade,'
      '                sdf.valorservico,'
      '                sdf.estado,'
      '                sdf.cidade,'
      '                c.nome as nomecidade'
      ''
      '      from ((dadosfiscais df'
      '             join notas n on df.numero = n.dadofiscal)'
      '             join (servicosdadosfiscais sdf'
      '                    join cidades c on sdf.estado = c.estado'
      '                                  and sdf.cidade = c.codigo)'
      '                   on df.numero = sdf.dadofiscal)'
      '      where df.situacao = '#39'N'#39
      '        and df.data between :dataInicial and :datafinal'
      '      %FiltroFiliais'
      '     ) as servicos'
      
        'group by estado, cidade, nomecidade, dadofiscal, data, serie, nu' +
        'mero, cliente, nome, valortotal, valorservicos'
      'order by nomecidade, cidade, estado, data, serie, numero')
    RequestLive = False
    Left = 160
    Top = 112
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'dataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
