  object qryAliquotas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'dadofiscal=dadofiscal'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrLivroApuracaoISS
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'FiltroFiliais'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select    cdf.dadofiscal,'
      '          cdf.aliquota,'
      '          cdf.valor,'
      '          (select sum(sdf.valorissqn)'
      '           from ServicosDadosFiscais sdf'
      '           where sdf.dadofiscal = cdf.dadofiscal'
      '             and sdf.aliquotaissqn = cdf.aliquota'
      '             and sdf.reterissqn) as valorretido,'
      '          (cdf.base+cdf.isentas+cdf.outras) as tributavel'
      
        'from CalculosDadosFiscais cdf join dadosfiscais df on cdf.dadofi' +
        'scal = df.numero'
      'where exists (select sdf.dadofiscal'
      '              from servicosdadosfiscais sdf'
      '              where sdf.dadofiscal = df.numero)'
      '  and df.situacao = '#39'N'#39
      '  and df.data between :dataInicial and :datafinal'
      ''
      '%FiltroFiliais'
      ''
      'order by cdf.aliquota')
    RequestLive = False
    Left = 344
    Top = 8
    ParamData = <
      item
        DataType = ftString
        Name = 'dataInicial'
        ParamType = ptUnknown
        Value = #39'01/01/2000'#39
      end
      item
        DataType = ftString
        Name = 'datafinal'
        ParamType = ptUnknown
        Value = #39'31/12/2007'#39
      end>
    object qryAliquotasdadofiscal: TIntegerField
      FieldName = 'dadofiscal'
    end
    object qryAliquotasaliquota: TFloatField
      FieldName = 'aliquota'
    end
    object qryAliquotasvalor: TFloatField
      FieldName = 'valor'
    end
    object qryAliquotasvalorretido: TFloatField
      FieldName = 'valorretido'
    end
    object qryAliquotastributavel: TFloatField
      FieldName = 'tributavel'
    end
  end
