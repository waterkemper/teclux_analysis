procedure TdtmLivroApuracaoISS.ImprimirRelatorio;
var
  Relatorio: TfrReport;
  frmPreview: TfrmPreviewPadrao;
begin
  AtribuirParametrosBaseRelatorio(qryprocurafiliaiscodigo.asstring);
  frVariables['DataExtensoInicial']:= DataExtenso(strtodate(FDataInicial));
  frVariables['DataExtensoFinal']:= DataExtenso(strtodate(FDataFinal));
  frVariables['DataInicial']:= FDataInicial;
  frVariables['DataFinal']:= FDataFinal;

  frVariables['Titulo']  := 'LIVRO DE APURAÇÃO DE I.S.S.Q.N.';
  frVariables['Livro'] := FParametroLivro;
  frVariables['Pagina']:=FParametroPagina;
  frVariables['Maximo']:=FParametroMaximo;
  frVariables['Outras']:=FParametroCabecalho;

  frVariables['SALDO_CREDOR_ANTERIOR'] := FSaldoCredorAnterior;
  frVariables['GUIA']        := FGuia;
  frVariables['DATA']        := FDataRecolhimento;
  frVariables['BANCO']       := FBanco;
  frVariables['AUTENTICACAO']:= FAutenticacao;

//  frpResumoEstadoCidade.DesignReport;
//  frpLivroApuracaoISS.designReport;
  frmPreview := TfrmPreviewPadrao.create(self);
  frmPreview.cmbZoom.ItemIndex := 3; //125
  try
   Relatorio := frmPreview.frCompositeReport;
   frmPreview.frCompositeReport.Reports.Clear;
   frmPreview.cmbZoom.ItemIndex := 3;
   with frmPreview do
   begin
    case FParametroRelatorio of
    0: begin
         case resumo of
         0: begin
             frCompositeReport.Reports.Add(frpLivroApuracaoISS);
             frCompositeReport.Reports.Add(frpResumoEstadoCidade);
            end;
         1: frCompositeReport.Reports.Add(frpLivroApuracaoISS);
         2: frCompositeReport.Reports.Add(frpResumoEstadoCidade);
         end;
       end;
    1: begin
        if not Assigned(ImpressaoTermos) then
          ImpressaoTermos := TdtmImprimeTermos.Create(Self);
        frCompositeReport.Reports.Add(ImpressaoTermos.frpTermos_R);
       end;
    end;
   end;
   Relatorio.Preview := frmPreview.frPreviewPadrao;
   Relatorio.ShowReport;
   frmPreview.ShowModal;
  finally
   frmPreview.Free;
   AtribuirParametrosBaseRelatorio;
  end;

end;


procedure TdtmLivroApuracaoISS.Selecionar(Pesquisa: TtecPesquisa);
begin
  case Pesquisa of
    pesFILIAIS      : RefazConsulta(qryProcuraFiliais,[0],[CodigoFilial]);
  end;
end;



procedure TdtmLivroApuracaoISS.SetDataFinalPeriodo(const Value: String);
begin
  FDataFinalPeriodo := Value;
  qryLivroApuracaoISS.ParamByName('DataInicial').AsString:=FDiaInicial+formatdatetime('/mm/yyyy',strtodate(FDataFinalPeriodo));
  qryLivroApuracaoISS.ParamByName('DataFinal').AsString:=FDataFinalPeriodo;
  qryAliquotas.ParamByName('DataInicial').AsString:=FDiaInicial+formatdatetime('/mm/yyyy',strtodate(FDataFinalPeriodo));
  qryAliquotas.ParamByName('DataFinal').AsString:=FDataFinalPeriodo;

  qryResumoEstadoCidade.ParamByName('DataInicial').AsString:=FDiaInicial+formatdatetime('/mm/yyyy',strtodate(FDataFinalPeriodo));
  qryResumoEstadoCidade.ParamByName('DataFinal').AsString:=FDataFinalPeriodo;
  qryAliquotasResumo.ParamByName('DataInicial').AsString:=FDiaInicial+formatdatetime('/mm/yyyy',strtodate(FDataFinalPeriodo));
  qryAliquotasResumo.ParamByName('DataFinal').AsString:=FDataFinalPeriodo;

  FParametroCabecalho:='PERÍODO DE '+FDiaInicial+' A '+FDataFinalPeriodo;
end;

procedure TdtmLivroApuracaoISS.SetParametroFilial(
  const Value: String);
var
 SQL: String;
begin
 FParametroFilial := Value;
 if Value<>'' then
   SQL:=' and (df.filialemissao = ' + Value + ')'
 else
   SQL:='';
 qryLivroApuracaoISS.MacroByName('FiltroFiliais').asstring := SQL;
 qryAliquotas.MacroByName('FiltroFiliais').asstring := SQL;

 qryResumoEstadoCidade.MacroByName('FiltroFiliais').asstring := SQL;
 qryAliquotasResumo.MacroByName('FiltroFiliais').asstring := SQL;

end;

procedure TdtmLivroApuracaoISS.SetParametroGrupoFilial(
  const Value: String);
var
SQL : String;
begin
 SQL:='';
 if (Value <> '') then
 begin
  SQL:=' and (df.filialemissao in (Select filial From filiaisgruposfiliais Where grupo = ' + Value + '))';
  qryLivroApuracaoISS.MacroByName('FiltroFiliais').AsString := SQL;
  qryAliquotas.MacroByName('FiltroFiliais').AsString := SQL;

  qryResumoEstadoCidade.MacroByName('FiltroFiliais').AsString := SQL;
  qryAliquotasResumo.MacroByName('FiltroFiliais').AsString := SQL;
 end;
end;


function TdtmLivroApuracaoISS.AbrirConsultasRelatorio: Boolean;
begin
  result := true;
  case resumo of
  0: begin
       refazconsulta(qryLivroApuracaoISS,[],[]);
       refazconsulta(qryAliquotas,[],[]);
       refazconsulta(qryResumoEstadoCidade,[],[]);
       refazconsulta(qryAliquotasResumo,[],[]);
     end;
  1: begin
       refazconsulta(qryLivroApuracaoISS,[],[]);
       refazconsulta(qryAliquotas,[],[]);
     end;
  2: begin
       refazconsulta(qryResumoEstadoCidade,[],[]);
       refazconsulta(qryAliquotasResumo,[],[]);
     end;
  end;
end;

