        '                     where f.filialconsolidadoradime = :filialco' +
        'nsolidadora'
      
        '                     and (f.sped_pis_cofins or f.sped_pis_cofins' +
        '_rb or f.sped_pis_cofins_rem)))'
      '/*'
      '    and not exists ('
      '       select pdf.dadofiscal'
      '       from produtosdadosfiscais pdf'
      '       where pdf.dadofiscal = df.numero'
      '         and pdf.produto = cast(dic.cod_item as bigint))'
      '*/'
      ''
      'union all'
      ''
      
        'select filial, dt_oper as data, cast('#39'DEMAIS DOCTOS'#39' as varchar(' +
        '15)) as especie,'
      
        '        cast(null as varchar(3)) as serie, cast(null as integer)' +
        ' as numero,'
      #9#9'vl_oper as valortotal, cast(null as integer) as codigofiscal,'
      
        #9#9'cst_pis as piscst, vl_bc_pis as pisbasecalculo, vl_pis as pisv' +
        'alor, aliq_pis as pisaliquota,'
      
        #9#9'cst_cofins as cofinscst, vl_bc_cofins as cofinsbasecalculo, vl' +
        '_cofins as cofinsvalor, aliq_cofins as cofinsaliquota,'
      '       (select f.COD_INC_TRIB'
      
        '        from filiais f where f.codigo = :filialconsolidadora) as' +
        ' cod_inc_trib,'
      '       cast(null as integer) as dadofiscal'
      ''
      'from piscofins_f100'
      'where periodo = :MesAno'
      '  and documentopag is null  /* n'#227'o gerada pelo contas a pagar */'
      '  and ind_oper  = 1 /* sa'#237'das */'
      ''
      ') as piscofins'
      ') as piscofins'
      '     left join piscofins_t435 t435'
      '     on piscofins.CCS435 = t435.codigo'
      ') as piscofins'
      
        'group by tipocontribuicao, CCS435, descricaot435, especie, data,' +
        ' serie, numero, dadofiscal, filial, codigofiscal,'
      
        '        valortotal, codigofiscal, piscst, pisaliquota, cofinscst' +
        ', aliquotacofins, cod_inc_trib'
      ''
      
        'order by tipocontribuicao, CCS435, descricaot435, especie, data,' +
        ' serie, numero'
      ') as piscofins'
      ''
      '  left join'
      ''
      ''
      '('
      
        'select dadofiscal, sum(ValorTotal) as ValorTotal, sum(cofins) as' +
        ' cofins, sum(pis) as pis'
      'from'
      '('
      ''
      ' SELECT dadofiscal,'
      
        '        sum((TRUNC(ValorVencto,     2) + TRUNC(COFINSProporciona' +
        'l,2) +'
      
        '             TRUNC(CSLLProporcional,2) + TRUNC(INSSProporcional,' +
        '  2) +'
      
        '             TRUNC(IRRFProporcional,2) + TRUNC(ISSProporcional, ' +
        '  2) +'
      
        '                                    TRUNC(PISProporcional,   2))' +
        ') AS ValorTotal,'
      ''
      '        sum(TRUNC(COFINS,2)) AS COFINS,'
      '        sum(TRUNC(PIS, 2)) AS PIS'
      ' FROM'
      ' ('
      '       SELECT df.numero as dadofiscal,'
      '              vdf.ValorVencto,'
      ''
      
        '             (vdf.ValorVencto * COALESCE(df.COFINSRetido, 0)) / ' +
        '(df.ValorTotal -'
      
        '                    (COALESCE(df.COFINSRetido, 0) + COALESCE(df.' +
        'CSLLRetido, 0) +'
      
        '                     COALESCE(df.INSSRetido,   0) + COALESCE(df.' +
        'IRRetido,   0) +'
      
        '                     COALESCE(df.ISSRetido,    0) + COALESCE(df.' +
        'PISRetido,  0)))'
      
        '                                                          AS COF' +
        'INSProporcional,'
      ''
      
        '             (vdf.ValorVencto * COALESCE(df.CSLLRetido, 0)) / (d' +
        'f.ValorTotal -'
      
        '                    (COALESCE(df.COFINSRetido, 0) + COALESCE(df.' +
        'CSLLRetido, 0) +'
      
        '                     COALESCE(df.INSSRetido,   0) + COALESCE(df.' +
        'IRRetido,   0) +'
      
        '                     COALESCE(df.ISSRetido,    0) + COALESCE(df.' +
        'PISRetido,  0)))'
      
        '                                                            AS C' +
        'SLLProporcional,'
      ''
      
        '             (vdf.ValorVencto * COALESCE(df.INSSRetido, 0)) / (d' +
        'f.ValorTotal -'
      
        '                    (COALESCE(df.COFINSRetido, 0) + COALESCE(df.' +
        'CSLLRetido, 0) +'
      
        '                     COALESCE(df.INSSRetido,   0) + COALESCE(df.' +
        'IRRetido,   0) +'
      
        '                     COALESCE(df.ISSRetido,    0) + COALESCE(df.' +
        'PISRetido,  0)))'
      
        '                                                            AS I' +
        'NSSProporcional,'
      ''
      
        '             (vdf.ValorVencto * COALESCE(df.IRRetido, 0)) / (df.' +
        'ValorTotal -'
      
        '                    (COALESCE(df.COFINSRetido, 0) + COALESCE(df.' +
        'CSLLRetido, 0) +'
      
        '                     COALESCE(df.INSSRetido,   0) + COALESCE(df.' +
        'IRRetido,   0) +'
      
        '                     COALESCE(df.ISSRetido,    0) + COALESCE(df.' +
        'PISRetido,  0)))'
      
        '                                                            AS I' +
        'RRFProporcional,'
      ''
      
        '              (vdf.ValorVencto * COALESCE(df.ISSRetido, 0)) / (d' +
        'f.ValorTotal -'
      
        '                    (COALESCE(df.COFINSRetido, 0) + COALESCE(df.' +
        'CSLLRetido, 0) +'
      
        '                     COALESCE(df.INSSRetido,   0) + COALESCE(df.' +
        'IRRetido,   0) +'
      
        '                     COALESCE(df.ISSRetido,    0) + COALESCE(df.' +
        'PISRetido,  0)))'
      
        '                                                             AS ' +
        'ISSProporcional,'
      ''
      
        '              (vdf.ValorVencto * COALESCE(df.PISRetido, 0)) / (d' +
        'f.ValorTotal -'
      
        '                    (COALESCE(df.COFINSRetido, 0) + COALESCE(df.' +
        'CSLLRetido, 0) +'
      
        '                     COALESCE(df.INSSRetido,   0) + COALESCE(df.' +
        'IRRetido,   0) +'
      
        '                     COALESCE(df.ISSRetido,    0) + COALESCE(df.' +
        'PISRetido,  0)))'
      
        '                                                             AS ' +
        'PISProporcional,'
      ''
      '               CASE WHEN (SELECT Regime'
      '                             FROM ImpostosRetidos'
      
        '                             WHERE Descricao = '#39'COFINS'#39') = '#39'CAIX' +
        'A'#39
      
        '                    THEN  (vdf.ValorVencto * COALESCE(df.COFINSR' +
        'etido, 0)) / (df.ValorTotal -'
      
        '                                  (COALESCE(df.COFINSRetido, 0) ' +
        '+ COALESCE(df.CSLLRetido, 0) +'
      
        '                                   COALESCE(df.INSSRetido,   0) ' +
        '+ COALESCE(df.IRRetido,   0) +'
      
        '                                   COALESCE(df.ISSRetido,    0) ' +
        '+ COALESCE(df.PISRetido,  0)))'
      '                    ELSE 0'
      '               END AS COFINS,'
      ''
      '               CASE WHEN (SELECT Regime'
      '                             FROM ImpostosRetidos'
      '                             WHERE Descricao = '#39'PIS'#39') = '#39'CAIXA'#39
      
        '                    THEN (vdf.ValorVencto * COALESCE(df.PISRetid' +
        'o, 0)) / (df.ValorTotal -'
      
        '                             (COALESCE(df.COFINSRetido, 0) + COA' +
        'LESCE(df.CSLLRetido, 0) +'
      
        '                              COALESCE(df.INSSRetido,   0) + COA' +
        'LESCE(df.IRRetido,   0) +'
      
        '                              COALESCE(df.ISSRetido,    0) + COA' +
        'LESCE(df.PISRetido,  0)))'
      '                    ELSE 0'
      '               END AS PIS'
      ''
      '       FROM Parcelas p'
      '            JOIN Contratos ct'
      '                  JOIN DadosFiscais df'
      '                       JOIN vfornecedores vf'
      
        '                       on df.cliente = vf.codigo and df.tipoclie' +
        'nte = vf.tipo'
      '                       JOIN Notas n'
      '                       ON n.DadoFiscal = df.Numero'
      '                  ON df.Contrato = ct.Numero'
      '            ON p.Contrato = ct.Numero,'
      ''
      '            VenctosDadosFiscais vdf'
      ''
      '       WHERE vdf.DadoFiscal = df.Numero'
      '         AND vdf.Numero = p.Numero'
      '         AND to_char(p.Datapagto, '#39'MM/YYYY'#39')=:MesAno'
      '         AND df.Situacao = '#39'N'#39
      '         AND (((COALESCE(df.COFINSRetido, 0) <> 0) AND'
      '               (SELECT Regime'
      '                   FROM ImpostosRetidos'
      '                   WHERE Descricao = '#39'COFINS'#39') = '#39'CAIXA'#39') OR'
      ''
      '              ((COALESCE(df.PISRetido, 0) <> 0) AND'
      '               (SELECT Regime'
