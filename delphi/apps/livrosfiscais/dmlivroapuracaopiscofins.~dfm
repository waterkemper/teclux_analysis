  object qry_CFOP_PisCofins: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qry_CFOP_PisCofinsBeforeOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftString
        Name = 'WhereTEmp'
        ParamType = ptUnknown
        Value = 'where false'
      end>
    Sql.Strings = (
      ';'
      ''
      'select'
      '       sel.*,'
      
        '       case when sequencia = 1 then valortotal else cast(0 as nu' +
        'meric(11,2)) end as valortotal_unico,'
      '       cf.descricao as descricaocodigofiscal,'
      '       t_pc.descricao as descricaopiscofins'
      'from'
      '('
      'select origem, filial, data, especie, serie, numero,'
      ''
      
        '       row_number() OVER (PARTITION by origem, filial, data, esp' +
        'ecie, serie, numero, valortotal) as sequencia,'
      ''
      '       valortotal,'
      
        '       sum(coalesce(valortotalprodutos,0.00)) as valortotalprodu' +
        'tos,'
      ''
      '       codigofiscal,'
      '       cstpiscofins,'
      ''
      ''
      ''
      '       sum(coalesce(pisbasecalculo,0.00)) as pisbasecalculo,'
      '       sum(coalesce(pisvalor,0.00)) as pisvalor,'
      ''
      
        '       sum(coalesce(cofinsbasecalculo,0.00)) as cofinsbasecalcul' +
        'o,'
      '       sum(coalesce(cofinsvalor,0.00)) as cofinsvalor'
      ''
      'from'
      '('
      ''
      '  select cast('#39'Entradas'#39' as varchar(10))  as origem,'
      ''
      '         np.filial,'
      '         np.fornecedor as clifor,'
      '         np.tipofornecedor as tipoclifor,'
      
        '         case when :SelecaoPelaDatadeEmissao then np.emissao els' +
        'e np.data end as data,'
      
        '         cast('#39'NOTAS FISCAIS DE ENTRADA'#39' as varchar(30)) as espe' +
        'cie,'
      ''
      '         np.serie,'
      '         np.numero,'
      '         /*    np.modelodocto,*/'
      '         np.valornota as valortotal,'
      ''
      '         (round((pnp.quantidade * pnp.precounitario),2)'
      '                 - coalesce(pnp.valordescontoitem,0)'
      '                 - coalesce(pnp.desconto,0)'
      '                 + coalesce(pnp.acrescimo,0)'
      '                 + coalesce(pnp.frete,0)'
      '                 + coalesce(pnp.seguro,0)'
      '                 + coalesce(pnp.valoripi,0)'
      '                 + coalesce(pnp.despesasacessorias,0)'
      
        '                 + coalesce(pnp.icmsvalorst,0)) as valortotalpro' +
        'dutos,'
      ''
      '         pnp.codigofiscal,'
      '         pnp.piscst as cstpiscofins,'
      ''
      '         pnp.PISBaseCalculo,'
      '         pnp.pisvalor,'
      '         pnp.pisaliquota,'
      ''
      '         /* pnp.cofinscst, */'
      ''
      '         pnp.cofinsbasecalculo,'
      '         pnp.cofinsvalor,'
      '         pnp.cofinsaliquota'
      ''
      '                            /*'
      '             cast(null as varchar(2)) as nat_bc_cred,'
      '       cast(null as integer) as cod_cred'
      '       */'
      ''
      '  from notaspag np'
      '       join produtosnotaspag pnp'
      '       on np.codigo = pnp.codigonota'
      '  where np.codigo = pnp.codigonota'
      ''
      '    and case when :SelecaoPelaDatadeEmissao then'
      '         to_char(cast(np.emissao as date), '#39'MM/YYYY'#39')= :MesAno'
      '    else to_char(cast(np.data as date), '#39'MM/YYYY'#39')= :MesAno end'
      ''
      '  /* C170 -> '#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39
      '     C396 -> '#39'02'#39','#39'2D'#39','#39'2E'#39','#39'59'#39
      '     C501 -> '#39'06'#39','#39'28'#39', '#39'29'#39
      '     D101 -> '#39'07'#39','#39'08'#39','#39'8B'#39','#39'09'#39','#39'10'#39','#39'11'#39','#39'26'#39','#39'27'#39','#39'57'#39
      '     D501 -> '#39'21'#39','#39'22'#39' */'
      ''
      '    and (np.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39') or'
      '         np.modelodocto in ('#39'02'#39','#39'2D'#39','#39'2E'#39','#39'59'#39') or'
      '         np.modelodocto in ('#39'06'#39','#39'28'#39', '#39'29'#39') or'
      
        '         np.modelodocto in ('#39'07'#39','#39'08'#39','#39'8B'#39','#39'09'#39','#39'10'#39','#39'11'#39','#39'26'#39','#39 +
        '27'#39','#39'57'#39') or'
      '         np.modelodocto in ('#39'21'#39','#39'22'#39'))'
      ''
      '    and np.situacao = '#39'N'#39
      '    and (np.filial = :filialconsolidadora or'
      '         np.filial in (select f.codigo'
      '                       from filiais f'
      
        '                       where f.filialconsolidadoradime = :filial' +
        'consolidadora'
      
        '                       and (f.sped_pis_cofins or f.sped_pis_cofi' +
        'ns_rb or f.sped_pis_cofins_rem)))'
      ''
      '    and'
      
        '    (case when :NotasdeCompra then ehnotafiscalentradacompra(pnp' +
        '.codigofiscal) else not (:NotasdeCompra or :NotasdeDevolucao_e o' +
        'r :NotasdeTransferencia_e) end or'
      
        '     case when :NotasdeDevolucao_e then ehnotafiscalentradadevol' +
        'ucao(pnp.codigofiscal) else not (:NotasdeCompra or :NotasdeDevol' +
        'ucao_e or :NotasdeTransferencia_e) end or'
      
        '     case when :NotasdeTransferencia_e then ehnotafiscalentradat' +
        'ransferencia(pnp.codigofiscal) else not (:NotasdeCompra or :Nota' +
        'sdeDevolucao_e or :NotasdeTransferencia_e) end)'
      ''
      '    and pnp.piscst = pnp.cofinscst'
      ''
      '  union all'
      ''
      '    select cast('#39'Entradas'#39' as varchar(10))  as origem,'
      ''
      '         np.filial,'
      '         np.fornecedor as clifor,'
      '         np.tipofornecedor as tipoclifor,'
      
        '         case when :SelecaoPelaDatadeEmissao then np.emissao els' +
        'e np.data end as data,'
      
        '         cast('#39'NOTAS FISCAIS DE ENTRADA'#39' as varchar(30)) as espe' +
        'cie,'
      '         np.serie,'
      '         np.numero,'
      '         /*    np.modelodocto,*/'
      '         np.valornota as valortotal,'
      ''
      '         (round((pnp.quantidade * pnp.precounitario),2)'
      '                 - coalesce(pnp.valordescontoitem,0)'
      '                 - coalesce(pnp.desconto,0)'
