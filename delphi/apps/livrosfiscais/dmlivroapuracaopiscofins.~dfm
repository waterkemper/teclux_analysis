        'dutos,'
      ''
      '         pnp.codigofiscal,'
      ''
      '         pnp.cofinscst as cstpiscofins,'
      ''
      '         cast(null as numeric(11,2)) as pisbasecalculo,'
      '         cast(null as numeric(11,2)) as pisvalor,'
      '         cast(null as numeric(5,2))  as pisaliquota,'
      ''
      ''
      '         /* pnp.pisaliquota,*/'
      ''
      '         /* pnp.cofinscst, */'
      ''
      '         pnp.cofinsbasecalculo,'
      '         pnp.cofinsvalor,'
      '         pnp.cofinsaliquota'
      ''
      '         /*'
      '             cast(null as varchar(2)) as nat_bc_cred,'
      '       cast(null as integer) as cod_cred'
      '       */'
      ''
      '  from notaspag np'
      '       join produtosnotaspag pnp'
      '       on np.codigo = pnp.codigonota'
      '  where np.codigo = pnp.codigonota'
      ''
      '    and case when :SelecaoPelaDatadeEmissao then'
      '         to_char(cast(np.emissao as date), '#39'MM/YYYY'#39')= :MesAno'
      '    else to_char(cast(np.data as date), '#39'MM/YYYY'#39')= :MesAno end'
      ''
      ''
      '  /* C170 -> '#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39
      '     C396 -> '#39'02'#39','#39'2D'#39','#39'2E'#39','#39'59'#39
      '     C501 -> '#39'06'#39','#39'28'#39', '#39'29'#39
      '     D101 -> '#39'07'#39','#39'08'#39','#39'8B'#39','#39'09'#39','#39'10'#39','#39'11'#39','#39'26'#39','#39'27'#39','#39'57'#39
      '     D501 -> '#39'21'#39','#39'22'#39' */'
      ''
      '    and (np.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39') or'
      '         np.modelodocto in ('#39'02'#39','#39'2D'#39','#39'2E'#39','#39'59'#39') or'
      '         np.modelodocto in ('#39'06'#39','#39'28'#39', '#39'29'#39') or'
      
