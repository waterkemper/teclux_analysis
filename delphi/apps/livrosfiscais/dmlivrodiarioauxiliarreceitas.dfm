      EditMask = '99/99/9999;1; '
    end
    object qryImprimirRecebimentosvalorvencto: TFloatField
      FieldName = 'valorvencto'
      DisplayFormat = '0.00'
    end
    object qryImprimirRecebimentosparcelaorigem: TStringField
      FieldName = 'parcelaorigem'
      Size = 7
    end
    object qryImprimirRecebimentosdatapagto: TDateField
      Alignment = taCenter
      FieldName = 'datapagto'
      EditMask = '99/99/9999;1; '
    end
    object qryImprimirRecebimentosvalorpagto: TFloatField
      FieldName = 'valorpagto'
      DisplayFormat = '0.00'
    end
    object qryImprimirRecebimentosjuros: TFloatField
      FieldName = 'juros'
      DisplayFormat = '0.00'
    end
    object qryImprimirRecebimentosdesconto: TFloatField
      FieldName = 'desconto'
      DisplayFormat = '0.00'
    end
    object qryImprimirRecebimentosnomefilialvenda: TStringField
      FieldName = 'nomefilialvenda'
      Size = 40
    end
    object qryImprimirRecebimentosgrupofilialvenda: TIntegerField
      FieldName = 'grupofilialvenda'
      DisplayFormat = '0'
    end
    object qryImprimirRecebimentosnomegrupofilialvenda: TStringField
      FieldName = 'nomegrupofilialvenda'
      Size = 30
    end
  end
