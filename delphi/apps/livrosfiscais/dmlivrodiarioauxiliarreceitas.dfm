  object qryImprimirRecebimentosResumo: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select grupofilialvenda,'
      '         nomegrupofilialvenda,'
      '         nomefilialvenda,'
      '         filialvenda,'
      '         datapagto,'
      '         sum(valorvencto) as valorvencto,'
      '         sum(valorpagto) as valorpagto,'
      '         sum(juros) as juros,'
      '         sum(desconto) as desconto,'
      '         tipo'
      'from'
      '('
      
        '  select case when :AgruparGrupoFilialVenda then grupofilialvend' +
        'a         else cast(null as integer) end as grupofilialvenda,'
      
        '         case when :AgruparGrupoFilialVenda then nomegrupofilial' +
        'venda  else cast(null as varchar) end as nomegrupofilialvenda,'
      
        '         case when :AgruparFilialVenda          then nomefilialv' +
        'enda          else cast(null as varchar) end as nomefilialvenda,'
      
        '         case When :AgruparFilialVenda         then filialvenda ' +
        '                 else cast(null as integer) end as filialvenda,'
      
        '         case When :AgruparDataPagto           then datapagto   ' +
        '               else cast(null as date) end as datapagto,'
      '         valorvencto,'
      '         valorpagto,'
      '         juros,'
      '         desconto,'
      '         tipo'
      '  from'
      ' ('
      '  select contratosparcelas.*,'
      '           fv.nome as nomefilialvenda,'
      '           fgfv.grupo as grupofilialvenda,'
      '           gfv.descricao as nomegrupofilialvenda'
      '   from'
      '  ('
      '   ('
      '    select  c.filialvenda,'
      '            p.valorvencto,'
      '            p.datapagto,'
      '            p.valorpagto,'
      
        '            case when p.valorpagto>p.valorvencto then p.valorpag' +
        'to-p.valorvencto else cast(null as numeric) end as juros,'
      
        '            case when p.valorpagto<p.valorvencto then p.valorpag' +
        'to-p.valorvencto else cast(null as numeric) end as desconto,'
      '            cast('#39'P'#39' as varchar) as tipo'
      ''
      ''
      ''
      '    from contratos c,'
      '                     ( select contrato,'
      '                              valorvencto,'
      '                              datapagto,'
      '                              valorpagto'
      '                       from parcelas'
      
        '                       where datapagto between (:DataInicial) an' +
        'd (:DataFinal) and (tipopagto is null or tipopagto not in ('#39'E'#39','#39 +
        'J'#39'))'
      ' '#9'               ) as p'
      
        '    where c.numero=p.contrato and (c.origem is null) and (c.fatu' +
        'ramento >= (select coalesce(f.inicioatividades, cast('#39'30/12/1899' +
        #39' as date)) from filiais f where f.codigo = c.filialvenda))'
      '    /* Where filiais                */'
      '    /* Where Agentes            */'
      '   )'
      '    union all'
      '   ('
      '    select  c.filialvenda,'
      '            - p.valorvencto,'
      '            p.devcaixa,'
      '            - p.valorpagto,'
      
        '            - case when p.valorpagto>p.valorvencto then p.valorp' +
        'agto-p.valorvencto else cast(null as numeric) end as juros,'
      
        '            - case when p.valorpagto<p.valorvencto then p.valorp' +
        'agto-p.valorvencto else cast(null as numeric) end as desconto,'
      '            cast('#39'E'#39' as varchar) as tipo'
      ''
      ''
      ''
      '    from contratos c,'
      '                     ( select contrato,'
      '                              valorvencto,'
      '                              devcaixa,'
      '                              valorpagto'
      '                       from parcelas'
      
        '                       where devcaixa between (:DataInicial) and' +
        ' (:DataFinal) and (tipopagto is not null or tipopagto = '#39'X'#39')'
      ' '#9'               ) as p'
      
        '    where c.numero=p.contrato and (c.origem is null) and (c.fatu' +
        'ramento >= (select coalesce(f.inicioatividades, cast('#39'30/12/1899' +
        #39' as date)) from filiais f where f.codigo = c.filialvenda))'
      '    /* Where filiais                */'
      '    /* Where Agentes            */'
      '   )'
      
        '  ) as contratosparcelas join  (filiais fv left join (filiaisgru' +
        'posfiliais fgfv left join gruposfiliais gfv on fgfv.grupo=gfv.co' +
        'digo) on fv.codigo=fgfv.filial)'
      
        '                                                    on fv.codigo' +
        '=contratosparcelas.filialvenda'
      ' ) as parcelas'
      ') as parcelas'
      
        ' group by grupofilialvenda, nomegrupofilialvenda, nomefilialvend' +
        'a, filialvenda, datapagto, tipo'
      
        ' order by grupofilialvenda, UPPER(TO_ASCII(nomegrupofilialvenda,' +
        #39'LATIN1'#39')), UPPER(TO_ASCII(nomefilialvenda,'#39'LATIN1'#39')), filialven' +
        'da, datapagto, tipo')
    RequestLive = False
    Left = 320
    Top = 224
