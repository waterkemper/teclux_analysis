  object qryImprimirRecebimentos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      ' select contratosparcelas.*,'
      '         fv.nome as nomefilialvenda,'
      '         fgfv.grupo as grupofilialvenda,'
      '         gfv.descricao as nomegrupofilialvenda'
      'from'
      ' ('
      '  ('
      '   select  c.filialvenda,'
      '            c.cliente,'
      '            c.nome as nomecliente,'
      '            c.tipocliente,'
      '            p.contrato,'
      '            p.datavencto,'
      '            p.valorvencto,'
      '            p.parcelaorigem,'
      '            p.datapagto,'
      '            p.valorpagto,'
      
        '            case when p.valorpagto>p.valorvencto then p.valorpag' +
        'to-p.valorvencto else cast(null as numeric) end as juros,'
      
        '            case when p.valorpagto<p.valorvencto then p.valorpag' +
        'to-p.valorvencto else cast(null as numeric) end as desconto'
      ''
      ''
      '   from contratos c,'
      #9#9'   ( select contrato,'
      '                                     datavencto,'
      '                                     valorvencto,'
      #9'                         datapagto,'
      '                                     valorpagto,'
      '                                     parcelaorigem'
      '                             from parcelas'
      
        '                             where datapagto between (:DataInici' +
        'al) and (:DataFinal) and (tipopagto is null or tipopagto not in ' +
        '('#39'E'#39','#39'J'#39')) '
      ' '#9'               ) as p'
      
        '   where c.numero=p.contrato and (c.origem is null) and (c.fatur' +
        'amento >= (select coalesce(f.inicioatividades, cast('#39'30/12/1899'#39 +
        ' as date)) from filiais f where f.codigo = c.filialvenda))'
      '    /* Where filiais                */'
      '    /* Where Agentes            */'
      '  )'
      '  union all'
      '  ('
      '   select  c.filialvenda,'
      '           c.cliente,'
      '           c.nome as nomecliente,'
      '           c.tipocliente,'
      '           p.contrato,'
      '           p.datavencto,'
      '           - p.valorvencto,'
      '           p.parcelaorigem,'
      '           p.devcaixa,'
      '           - p.valorpagto,'
      
        '           - case when p.valorpagto>p.valorvencto then p.valorpa' +
        'gto-p.valorvencto else cast(null as numeric) end as juros,'
      
        '           - case when p.valorpagto<p.valorvencto then p.valorpa' +
        'gto-p.valorvencto else cast(null as numeric) end as desconto'
      ''
      ''
      '   from contratos c,'
      #9#9'   ( select contrato,'
      '                            datavencto,'
      '                            valorvencto,'
      '                            devcaixa,'
      '                            valorpagto,'
      '                            parcelaorigem'
      '                     from parcelas'
      
        '                     where devcaixa between (:DataInicial) and (' +
        ':DataFinal) and (tipopagto is not null or tipopagto = '#39'X'#39')'
      '                   ) as p'
      
        '   where c.numero=p.contrato and (c.origem is null) and (c.fatur' +
        'amento >= (select coalesce(f.inicioatividades, cast('#39'30/12/1899'#39 +
        ' as date)) from filiais f where f.codigo = c.filialvenda))'
      '    /* Where filiais                */'
      '    /* Where Agentes            */'
      '  )'
      
        ' ) as contratosparcelas join  (filiais fv left join (filiaisgrup' +
        'osfiliais fgfv left join gruposfiliais gfv on fgfv.grupo=gfv.cod' +
        'igo) on fv.codigo=fgfv.filial)'
      '   on fv.codigo=contratosparcelas.filialvenda'
      
        '   order by datapagto, UPPER(TO_ASCII(nomecliente,'#39'LATIN1'#39')), cl' +
        'iente')
    RequestLive = False
    Left = 320
    Top = 96
    ParamData = <
      item
        DataType = ftString
        Name = 'DataInicial'
        ParamType = ptUnknown
        Value = #39'01/01/2005'#39
      end
      item
        DataType = ftString
        Name = 'DataFinal'
        ParamType = ptUnknown
        Value = #39'05/01/2005'#39
      end>
    object qryImprimirRecebimentosfilialvenda: TIntegerField
      FieldName = 'filialvenda'
      DisplayFormat = '0'
    end
    object qryImprimirRecebimentoscliente: TIntegerField
      FieldName = 'cliente'
      DisplayFormat = '0'
