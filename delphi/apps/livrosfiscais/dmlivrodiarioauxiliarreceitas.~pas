function Tdtmlivrodiarioauxiliarreceitas.GetListaAgentes: TStrings;
begin
  FListaAgentes:= TStringList.Create;
  qryAgentes.Open;
  while not qryAgentes.Eof do
  begin
    FListaAgentes.AddObject(format('%3s',[qryAgentescodigo.AsString])+'.'+qryAgentesdescricao.AsString, Pointer(qryAgentescodigo.AsInteger));
    qryAgentes.Next;
  end;
  qryAgentes.Close;
  Result := FListaAgentes;
end;

procedure Tdtmlivrodiarioauxiliarreceitas.MontarOrdenacao;
var
Ordenacao: String;
begin
  Ordenacao:='';
  if FAgruparGrupoFilial then
    Ordenacao := Ordenacao+', nomegrupofilialvenda, grupofilialvenda ';
  if FAgruparFilial then
     Ordenacao := Ordenacao+', nomefilialvenda, filialvenda ';
  if FAgruparDataPagto then
   Ordenacao:=Ordenacao+', datapagto ';
   
  if length(Ordenacao)<>0 then
    qryImprimirRecebimentosResumo.sql[WhereOrdenacaoResumo] := 'Order by '+copy(Ordenacao,2,length(Ordenacao)-1)
  else qryImprimirRecebimentosResumo.sql[WhereOrdenacaoResumo] := '';

  Ordenacao:=Ordenacao+', datapagto, cliente, tipocliente, nomecliente';
  qryImprimirRecebimentos.sql[WhereOrdenacao]:='Order by '+copy(Ordenacao,2,length(Ordenacao)-1);
end;

procedure Tdtmlivrodiarioauxiliarreceitas.MontarFiltroAgentes(
  Usar: TCheckListBox);
var
  STRAgentes: String;
  TodosAgentes: Boolean;
  cnt: Integer;
begin
  TodosAgentes:=true;
  STRAgentes := '';
  for cnt := 0 to FListaAgentes.Count - 1 do
    if Usar.Checked[cnt] then
      STRAgentes := STRAgentes + '''' + IntToStr(Integer(FListaAgentes.Objects[cnt])) + ''','
    else
      TodosAgentes:=false;

  STRAgentes := Copy(STRAgentes, 0, Length(STRAgentes) - 1);
  Agentes := STRAGentes ;
  if Trim(STRAgentes) <> '' then
   if not TodosAgentes then
     FParametroCabecalho:=FParametroCabecalho+' Agentes: '+STRAgentes
   else
    Agentes := '';
end;

