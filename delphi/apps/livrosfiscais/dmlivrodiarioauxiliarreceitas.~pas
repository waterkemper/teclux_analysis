procedure Tdtmlivrodiarioauxiliarreceitas.SetAgentes(const Value: String);
begin
  if (Value <> '') then
  begin
    qryImprimirRecebimentos.Sql[WhereAgentes]:= Format(FiltroAgente,[Value]);
    qryImprimirRecebimentos.Sql[WhereAgentesdevn]:= Format(FiltroAgente,[Value]);
    qryImprimirRecebimentosResumo.Sql[WhereAgentesResumo]:= Format(FiltroAgente,[Value]);
    qryImprimirRecebimentosResumo.Sql[WhereAgentesResumodevn]:= Format(FiltroAgente,[Value]);
  end
  else
  begin
   qryImprimirRecebimentos.Sql[WhereAgentes]:= '';
   qryImprimirRecebimentos.Sql[WhereAgentesDevn]:= '';
   qryImprimirRecebimentosResumo.Sql[WhereAgentesResumo]:= '';
   qryImprimirRecebimentosResumo.Sql[WhereAgentesResumodevn]:= '';
  end;
end;

procedure Tdtmlivrodiarioauxiliarreceitas.SetDataFinal(const Value: String);
begin
  if not DataEmBranco(Value) then
  begin
    FDataFinal := Value;
    if DataEmBranco(FDataInicial) then
     FDataInicial:=FDataFinal;
  end
  else FDataFinal := FDataInicial;

  FParametroCabecalho:=FParametroCabecalho+' Entre: '+FDataInicial+' e '+FDataFinal;
  qryImprimirRecebimentos.ParamByName('DataInicial').AsString := FDataInicial;
  qryImprimirRecebimentos.ParamByName('DataFinal').AsString := FDataFinal;
  qryImprimirRecebimentosResumo.ParamByName('DataInicial').AsString := FDataInicial;
  qryImprimirRecebimentosResumo.ParamByName('DataFinal').AsString := FDataFinal;
end;

procedure Tdtmlivrodiarioauxiliarreceitas.SetDataInicial(const Value: String);
begin
  if not DataEmBranco(Value) then
     FDataInicial := Value;
end;

procedure Tdtmlivrodiarioauxiliarreceitas.SetParametroFilial(const Value: String);
begin
 if (Value <> '') then
 begin
    qryImprimirRecebimentos.Sql[WhereFiliaisVenda]:= Format(FiltroFilial_Venda,[Value]);
    qryImprimirRecebimentos.Sql[WhereFiliaisVendaDevn]:= Format(FiltroFilial_Venda,[Value]);
    qryImprimirRecebimentosResumo.Sql[WhereFiliaisVendaResumo]:= Format(FiltroFilial_Venda,[Value]);
    qryImprimirRecebimentosResumo.Sql[WhereFiliaisVendaResumoDevn]:= Format(FiltroFilial_Venda,[Value]);
    FParametroCabecalho:=FParametroCabecalho+' Filial: '+Value;
 end
 else
 begin
  qryImprimirRecebimentos.Sql[WhereFiliaisVenda]:= '';
  qryImprimirRecebimentos.Sql[WhereFiliaisVendaDevn]:= '';
  qryImprimirRecebimentosResumo.Sql[WhereFiliaisVendaResumo]:= '';
  qryImprimirRecebimentosResumo.Sql[WhereFiliaisVendaResumoDevn]:= '';
 end;
end;

