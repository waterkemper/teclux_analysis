  object qryNaturezas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select n.codigo, '
      '           n.descricao'
      'From   naturezas n'
      'WHERE tipo='#39'E'#39
      'Order by UPPER(TO_ASCII(n.descricao,'#39'LATIN1'#39'))')
    RequestLive = True
    Left = 131
    Top = 88
    object qryNaturezascodigo: TIntegerField
      FieldName = 'codigo'
    end
    object qryNaturezasdescricao: TStringField
      FieldName = 'descricao'
      Size = 70
    end
  end
  object qryCodigosFiscais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';SELECT (SELECT MIN(Codigo)'
      '           FROM CodigosFiscais'
      '           WHERE Tipo   = '#39'A'#39' AND'
      '                 Codigo > 1001) AS MenorCodigo,'
      ''
      '       (SELECT  MAX(Codigo) FROM CodigosFiscais'
      '           WHERE Tipo   = '#39'A'#39' AND'
      '                 Codigo <= 3949) AS MaiorCodigo;'
      '')
    RequestLive = False
    Left = 128
    Top = 16
    object qryCodigosFiscaismenorcodigo: TIntegerField
      FieldName = 'menorcodigo'
      DisplayFormat = '0'
    end
    object qryCodigosFiscaismaiorcodigo: TIntegerField
      FieldName = 'maiorcodigo'
      DisplayFormat = '0'
    end
  end
  object dsrCodigosFiscais: TtecDataSource
    DataSet = qryCodigosFiscais
    Left = 160
    Top = 40
  end
  object qryNotasPag: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryNotasPagBeforeOpen
    OnCalcFields = qryNotasPagCalcFields
    OnFilterRecord = qryNotasPagFilterRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'NaturezasProdutos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CODIGOSFISCAISPRODUTOS'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NaturezasNotas'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NOSIMPLES'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CODIGOSFISCAISNOTAS'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'SELECT'
      '  np.situacao,'
      '  np.codigo,'
      '  np.estado,'
      ''
      '  case when np.situacao='#39'C'#39' then 0'
      '       when :ExisteFiltroNatureza_ou_Codigo then'
      '          (select case when :ContribICMS then'
      '                            sum(cnp.base+cnp.isentas+cnp.outras)'
      
        '                       else sum(cnp.base+cnp.isentas+cnp.valor+c' +
        'np.outras)'
      '                  end     '
      '           from calculosnotaspag cnp'
      '           Where cnp.codigonota = np.codigo'
      '             and ((cnp.tipo='#39'M'#39' and :ContribICMS) or'
      '                  (cnp.tipo='#39'P'#39' and not :ContribICMS))'
      '             and np.situacao<>'#39'C'#39
      
        '             and cnp.codigofiscal between (:CodigoFiscalInicial)' +
        ' and (:CodigoFiscalFinal)'
      '           %NaturezasProdutos'
      '           %CODIGOSFISCAISPRODUTOS)'
      '       else np.valornota end as valornota,'
      ''
      '  np.serie,'
      '  np.numero,'
      '  np.data,'
      '  np.emissao,'
      '  np.inscricaoestadual,'
      '  np.fornecedor,'
      '  coalesce(vf.razao,vf.nome) as nome,'
      ''
      '  (select sum(cnp.base+cnp.isentas+cnp.outras)'
      '   from calculosnotaspag cnp'
      '   Where cnp.codigonota = np.codigo'
      '        and cnp.tipo='#39'M'#39
      '        and np.situacao<>'#39'C'#39
      '        ) as valortotal_icms,'
      ''
      '  (select sum(cnp.valor+cnp.base+cnp.isentas+cnp.outras)'
      '   from calculosnotaspag cnp'
      '   Where cnp.codigonota = np.codigo'
      '        and cnp.tipo='#39'P'#39
      '        and np.situacao<>'#39'C'#39') as valortotal_ipi,'
      ''
      '  np.ObsLivroEntrada,'
      '  case when (select count(*)'
      '             from duplicatas d'
      '             Where np.documentopag = d.documentopag)=0'
      '       then '#39'OUTRAS'#39
      '       else'
      '       case when (select count(*)'
      '                  from duplicatas d'
      '                  where np.documentopag=d.documentopag'
      '                    and d.datavencto > np.data)=0'
      '            then '#39'A VISTA'#39
      '            else '#39'A PRAZO'#39
      '       end'
      '  end as Operacao,'
      '  '
      
        '  case when np.xmlnfe is null then false else true end as leitur' +
        'aviaxml'
      ''
      'from notaspag np'
      '     join vfornecedores vf'
      '     on np.fornecedor=vf.codigo and'
      '        np.tipofornecedor=vf.tipo'
      ''
      'Where case when :SelecaoPelaDatadeEmissao then'
      '         np.emissao between (:DataInicial) and (:DataFinal)'
      '    else np.data between (:DataInicial) and (:DataFinal) end'
      ''
      '  and np.situacao<>'#39'P'#39
      '  and exists (select cnp.codigofiscal'
      '              from calculosnotaspag cnp'
      '              where cnp.codigonota = np.codigo'
      
        '                and cnp.codigofiscal between (:CodigoFiscalInici' +
        'al) and (:CodigoFiscalFinal) limit 1)'
      '%WhereFiliais'
      '%NaturezasNotas'
      '%NOSIMPLES'
      '%CODIGOSFISCAISNOTAS'
      
        'order by np.data, np.fornecedor, np.tipofornecedor, np.serie, np' +
        '.numero')
    RequestLive = False
    Active = True
    Left = 240
    Top = 16
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'ExisteFiltroNatureza_ou_Codigo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ContribICMS'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CodigoFiscalInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CodigoFiscalFinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SelecaoPelaDatadeEmissao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataFinal'
        ParamType = ptUnknown
      end>
    object qryNotasPagsituacao: TStringField
      FieldName = 'situacao'
      Size = 1
    end
    object qryNotasPagcodigo: TIntegerField
      FieldName = 'codigo'
      DisplayFormat = '0'
    end
    object qryNotasPagestado: TStringField
      FieldName = 'estado'
      Size = 2
    end
    object qryNotasPagvalornota: TFloatField
      FieldName = 'valornota'
      DisplayFormat = '0.00'
    end
    object qryNotasPagserie: TStringField
      FieldName = 'serie'
      Size = 3
    end
    object qryNotasPagdata: TDateField
      Alignment = taCenter
      FieldName = 'data'
      EditMask = '99/99/9999;1; '
    end
    object qryNotasPagvalortotal_icms: TFloatField
      FieldName = 'valortotal_icms'
      DisplayFormat = '0.00'
    end
    object qryNotasPagvalortotal_ipi: TFloatField
      FieldName = 'valortotal_ipi'
      DisplayFormat = '0.00'
    end
    object qryNotasPagobslivroentrada: TStringField
      FieldName = 'obslivroentrada'
      Size = 100
    end
    object qryNotasPagoperacao: TMemoField
      FieldName = 'operacao'
      BlobType = ftMemo
    end
    object qryNotasPagdifvalortotal_icms: TBooleanField
      FieldKind = fkCalculated
      FieldName = 'difvalortotal_icms'
      Calculated = True
    end
    object qryNotasPagdifvalortotal_ipi: TBooleanField
      FieldKind = fkCalculated
      FieldName = 'difvalortotal_ipi'
      Calculated = True
    end
    object qryNotasPaginscricaoestadual: TStringField
      FieldName = 'inscricaoestadual'
    end
    object qryNotasPagnumero: TIntegerField
      FieldName = 'numero'
      DisplayFormat = '0'
    end
    object qryNotasPagemissao: TDateField
      Alignment = taCenter
      FieldName = 'emissao'
      EditMask = '99/99/9999;1; '
    end
    object qryNotasPagfornecedor: TIntegerField
      FieldName = 'fornecedor'
      Required = True
      DisplayFormat = '0'
    end
    object qryNotasPagnome: TStringField
      DisplayWidth = 40
      FieldName = 'nome'
      Size = 50
    end
    object qryNotasPagleituraviaxml: TBooleanField
      FieldName = 'leituraviaxml'
    end
  end
