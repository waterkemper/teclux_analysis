  object qryProcuraFiliais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select'
      '    f.codigo,'
      '    f.nome,'
      '    f.razao,'
      '    f.cnpj,'
      '    f.inscricaoestadual,'
      '    f.rua,'
      '    f.estado,'
      '    c.nome as nomecidade,'
      '    b.nome as nomebairro,'
      '    f.cep,'
      '    f.junta,'
      '    f.juntadata'
      'From filiais f, estados e, cidades c, bairros b'
      'where (f.estado = e.codigo) and'
      '      (f.estado = c.estado) and'
      '      (f.cidade = c.codigo) and'
      '      (f.estado = b.estado) and'
      '      (f.cidade = b.cidade) and'
      '      (f.bairro = b.codigo) and'
      '      (f.codigo = :codigo)')
    RequestLive = False
    Left = 42
    Top = 6
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end>
