      FieldName = 'estado'
      Size = 2
    end
    object qryCodigosEmitentescnpj: TStringField
      FieldName = 'cnpj'
      Size = 18
    end
    object qryCodigosEmitentesinscricaoestadual: TStringField
      FieldName = 'inscricaoestadual'
    end
  end
