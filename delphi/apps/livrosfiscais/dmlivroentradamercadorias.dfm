  object qryCalculos_ICMS_IPI: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NaturezasProdutos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NOSIMPLES'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CODIGOSFISCAISPRODUTOS'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'select cnp.codigonota,'
      '           cnp.tipo,'
      '           cnp.codigofiscal,'
      '           cnp.aliquota,'
      '           sum(cnp.base) as base,'
      '           sum(cnp.valor) as valor,'
      '           sum(cnp.isentas) as isentas,'
      '           sum(cnp.outras) as outras'
      'from'
      '('
      ''
      '  select cnp.codigonota,'
      '         cast(1 as smallint) as tipo,'
      '         cnp.codigofiscal,'
      '         cnp.aliquota,'
      '         cnp.base,'
      '         cnp.valor,'
      '         0.00 as isentas,'
      '         0.00 as outras'
      '  from notaspag np'
      '       join calculosnotaspag cnp'
      '       on np.codigo = cnp.codigonota'
      '       join vfornecedores vf'
      '         on np.fornecedor=vf.codigo and'
      '            np.tipofornecedor=vf.tipo'
      ''
      '  Where '
      '    case when :SelecaoPelaDatadeEmissao then'
      '         np.emissao between (:DataInicial) and (:DataFinal)'
      '    else np.data between (:DataInicial) and (:DataFinal) end'
      ''
      '    and np.situacao<>'#39'P'#39
      '    and cnp.tipo = '#39'M'#39
      
        '    and cnp.codigofiscal between (:CodigoFiscalInicial) and (:Co' +
        'digoFiscalFinal)'
      '    and (cnp.base<>0)'
      '    %WhereFiliais'
      '    %NaturezasProdutos'
      '    %NOSIMPLES'
      '    %CODIGOSFISCAISPRODUTOS'
      ''
      '  union all'
      ''
      '  select cnp.codigonota,'
      '         cast(2 as smallint) as tipo,'
      '         cnp.codigofiscal,'
      '         cast(null as numeric(5,2)) as aliquota,'
      '         cnp.isentas as base,'
      '         cast(null as numeric(11,2)) as valor,'
      '         0.00 as isentas,'
      '         0.00 as outras'
      ''
      '  from notaspag np'
      '       join calculosnotaspag cnp'
      '       on np.codigo = cnp.codigonota'
      ''
      '       join vfornecedores vf'
      '         on np.fornecedor=vf.codigo and'
      '            np.tipofornecedor=vf.tipo'
      ''
      '  Where '
      '    case when :SelecaoPelaDatadeEmissao then'
      '         np.emissao between (:DataInicial) and (:DataFinal)'
      '    else np.data between (:DataInicial) and (:DataFinal) end'
      ''
      '    and np.situacao<>'#39'P'#39
      '    and cnp.tipo = '#39'M'#39
      
        '    and cnp.codigofiscal between (:CodigoFiscalInicial) and (:Co' +
        'digoFiscalFinal)'
      '    and (cnp.isentas<>0)'
      '    %WhereFiliais'
      '    %NaturezasProdutos'
      '    %NOSIMPLES'
      '    %CODIGOSFISCAISPRODUTOS'
      ''
      '  union all'
      ''
      '  select cnp.codigonota,'
      '         cast(3 as smallint) as tipo,'
      '         cnp.codigofiscal,'
      '         cast(null as numeric(5,2)) as aliquota,'
      '         cnp.outras as base,'
      '         cast(null as numeric(11,2)) as valor,'
      '         0.00 as isentas,'
      '         0.00 as outras'
      ''
      '  from notaspag np'
      '       join calculosnotaspag cnp'
      '       on np.codigo = cnp.codigonota'
      ''
      '       join vfornecedores vf'
      '         on np.fornecedor=vf.codigo and'
      '            np.tipofornecedor=vf.tipo'
      ''
      '  Where'
      '    case when :SelecaoPelaDatadeEmissao then'
      '         np.emissao between (:DataInicial) and (:DataFinal)'
      '    else np.data between (:DataInicial) and (:DataFinal) end'
      ''
      '    and np.situacao<>'#39'P'#39
      '    and cnp.tipo = '#39'M'#39
      
        '    and cnp.codigofiscal between (:CodigoFiscalInicial) and (:Co' +
        'digoFiscalFinal)'
      '    and (cnp.outras<>0)'
      '    %WhereFiliais'
      '    %NaturezasProdutos'
      '    %NOSIMPLES'
      '    %CODIGOSFISCAISPRODUTOS'
      ''
      ') as cnp'
      
        'group by cnp.codigonota, cnp.codigofiscal, cnp.tipo, cnp.aliquot' +
        'a'
      
        'order by cnp.codigonota, cnp.codigofiscal, cnp.tipo, cnp.aliquot' +
        'a')
    RequestLive = False
    Left = 80
    Top = 176
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'SelecaoPelaDatadeEmissao'
        ParamType = ptUnknown
      end
