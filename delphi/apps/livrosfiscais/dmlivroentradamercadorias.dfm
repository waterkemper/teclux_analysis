  object qryResumoNotasPag_IPI: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryResumoNotasPag_IPIBeforeOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NaturezasProdutos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NOSIMPLES'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CODIGOSFISCAISPRODUTOS'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'SELECT * FROM('
      'select temp.*,'
      '              CAST(titulo.codigo AS INTEGER) as titulo,'
      
        '              CAST(titulo.descricao AS VARCHAR) as descricaotitu' +
        'lo,'
      '              CAST( (select subtitulo.codigo'
      #9'            from codigosfiscais subtitulo'
      #9#9#9' where subtitulo.codigo<temp.codigofiscal'
      
        #9#9#9'   and tipo='#39'S'#39' order by subtitulo.codigo desc limit 1) AS IN' +
        'TEGER) as subtitulo,'
      '              CAST( (select subtitulo.descricao'
      #9'            from codigosfiscais subtitulo'
      #9#9#9' where subtitulo.codigo<temp.codigofiscal'
      
        #9#9#9'   and tipo='#39'S'#39' order by subtitulo.codigo desc limit 1) AS VA' +
        'RCHAR) as descricaosubtitulo'
      'from'
      '('
      ' SELECT       CAST(SUM(valornota) AS NUMERIC) as valornota,'
      '              CAST(SUM(base) AS NUMERIC) as base,'
      '              CAST(SUM(valor) AS NUMERIC) as valor,'
      '              CAST(SUM(isentas) AS NUMERIC) as isentas,'
      '              CAST(SUM(outras) AS NUMERIC) as outras,'
      '              codigofiscal,'
      '              cf.descricao'
      ' FROM'
      ' ('
      '  ('
      '   select'
      '   cnp.codigofiscal,'
      '   (sum(cnp.base) +'
      '    sum(cnp.valor) +'
      '    sum(cnp.isentas) +'
      '    sum(cnp.outras))  as  valornota,'
      '   sum(cnp.base) as base,'
      '   sum(cnp.valor) as valor,'
      '   sum(cnp.isentas) as isentas,'
      '   sum(cnp.outras) as outras'
      ''
      '   from notaspag np'
      '        join calculosnotaspag cnp'
      '        on np.codigo = cnp.codigonota'
      ''
      '        join vfornecedores vf'
      '          on np.fornecedor=vf.codigo and'
      '             np.tipofornecedor=vf.tipo'
      ''
      '   Where '
      '     case when :SelecaoPelaDatadeEmissao then'
      '         np.emissao between (:DataInicial) and (:DataFinal)'
      '     else np.data between (:DataInicial) and (:DataFinal) end'
      ''
      '     and np.situacao<>'#39'P'#39' and np.situacao<>'#39'C'#39
      '     and cnp.tipo = '#39'P'#39
      
        '     and cnp.codigofiscal between (:CodigoFiscalInicial) and (:C' +
        'odigoFiscalFinal)'
      '     %WhereFiliais'
      '     %NaturezasProdutos'
      '     %NOSIMPLES'
      '     %CODIGOSFISCAISPRODUTOS'
      '   group by cnp.codigofiscal'
      '  )'
      
        ' ) as temp left join CodigosFiscais cf on temp.codigofiscal=cf.c' +
        'odigo'
      ' group by codigofiscal, cf.descricao'
      ') as temp'
      
        '              left join CodigosFiscais titulo on cast(substring(' +
        'cast(codigofiscal as varchar) from 1 for 1)||'#39'000'#39' as integer)=t' +
        'itulo.codigo'
      ') AS rs'
      ''
      'ORDER BY rs.titulo,'
      
        '         upper(to_ascii(rs.DescricaoTitulo,'#39'latin1'#39')), rs.Subtit' +
        'ulo,'
      
        '         upper(to_ascii(rs.DescricaoSubTitulo,'#39'latin1'#39')), rs.Cod' +
        'igoFiscal,'
      '         upper(to_ascii(rs.Descricao,'#39'latin1'#39'))')
    RequestLive = False
    Left = 496
    Top = 104
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'SelecaoPelaDatadeEmissao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataFinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CodigoFiscalInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CodigoFiscalFinal'
        ParamType = ptUnknown
      end>
