  object qryCodigosEmitentes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryCodigosEmitentesBeforeOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NaturezasNotas'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NOSIMPLES'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CODIGOSFISCAISNOTAS'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'SELECT '
      '  np.fornecedor,'
      '  np.tipofornecedor,'
      '  coalesce(vf.razao, vf.nome) as nome,'
      '  np.estado,'
      '  formatar_cpf_cnpj(np.cnpj) as cnpj,'
      '  np.inscricaoestadual'
      ''
      'from notaspag np'
      '     join vfornecedores vf'
      '     on np.fornecedor=vf.codigo and'
      '        np.tipofornecedor=vf.tipo'
      ''
      'Where '
      '    case when :SelecaoPelaDatadeEmissao then'
      '         np.emissao between (:DataInicial) and (:DataFinal)'
      '    else np.data between (:DataInicial) and (:DataFinal) end'
      ''
      '  and np.situacao<>'#39'P'#39' and np.situacao<>'#39'C'#39
      '  and exists (select cnp.codigofiscal'
      '              from calculosnotaspag cnp'
      '              where cnp.codigonota = np.codigo'
      
        '                and cnp.codigofiscal between (:CodigoFiscalInici' +
        'al) and (:CodigoFiscalFinal) limit 1)'
      '%WhereFiliais'
      '%NaturezasNotas'
      '%NOSIMPLES'
      '%CODIGOSFISCAISNOTAS'
      
        'group by np.fornecedor, np.tipofornecedor, vf.razao, vf.nome, np' +
        '.estado, np.cnpj, np.inscricaoestadual'
      
        'ORDER by np.fornecedor, np.tipofornecedor, UPPER(TO_ASCII(coales' +
        'ce(vf.razao, vf.nome),'#39'LATIN1'#39')), np.estado, np.cnpj, np.inscric' +
        'aoestadual')
    RequestLive = False
    Left = 448
    Top = 200
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'SelecaoPelaDatadeEmissao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataFinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CodigoFiscalInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CodigoFiscalFinal'
        ParamType = ptUnknown
      end>
    object qryCodigosEmitentesfornecedor: TIntegerField
      FieldName = 'fornecedor'
      DisplayFormat = '0'
    end
    object qryCodigosEmitentestipofornecedor: TStringField
      FieldName = 'tipofornecedor'
      Size = 1
    end
    object qryCodigosEmitentesnome: TStringField
      FieldName = 'nome'
