  object qryCalculosNotaspag_IPI: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'codigonota=codigonota,codigofiscal=codigofiscal'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrCalculosNotaspag_ICMS
    Constraints = <>
    BeforeOpen = qryCalculosNotaspag_IPIBeforeOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NaturezasProdutos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NOSIMPLES'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CODIGOSFISCAISPRODUTOS'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'select cnp.codigonota,'
      '           cnp.tipo,'
      '           cnp.aliquota,'
      '           cnp.codigofiscal,'
      '           sum(cnp.base) as base,'
      '           sum(cnp.valor) as valor                      '
      'from'
      '('
      '  select cnp.codigonota,'
      '         cast(1 as smallint) as tipo,'
      '         cnp.aliquota,'
      '         cnp.codigofiscal,'
      
        '         case when np.situacao='#39'C'#39' then 0.00 else cnp.base end a' +
        's base,'
      
        '         case when np.situacao='#39'C'#39' then 0.00 else cnp.valor end ' +
        'as valor'
      '  from notaspag np'
      '       join calculosnotaspag cnp'
      '       on np.codigo = cnp.codigonota'
      ''
      '       join vfornecedores vf'
      '         on np.fornecedor=vf.codigo and'
      '            np.tipofornecedor=vf.tipo'
      ''
      '  Where '
      ''
      '    case when :SelecaoPelaDatadeEmissao then'
      '         np.emissao between (:DataInicial) and (:DataFinal)'
      '    else np.data between (:DataInicial) and (:DataFinal) end'
      ''
      '    and np.situacao<>'#39'P'#39
      '    and cnp.tipo = '#39'P'#39
      
        '    and cnp.codigofiscal between (:CodigoFiscalInicial) and (:Co' +
        'digoFiscalFinal)'
      '    and (cnp.base<>0)'
      '    %WhereFiliais'
      '    %NaturezasProdutos'
      '    %NOSIMPLES'
      '    %CODIGOSFISCAISPRODUTOS'
      ''
      '  union all'
      ''
      '  select cnp.codigonota,'
      '         cast(2 as smallint) as tipo,'
      '         cast(null as numeric(5,2)) as aliquota,'
      '         cnp.codigofiscal,'
      
        '         case when np.situacao='#39'C'#39' then 0.00 else cnp.isentas en' +
        'd as base,'
      '         cast(null as numeric(11,2)) as valor'
      '  from notaspag np'
      '       join calculosnotaspag cnp'
      '       on np.codigo = cnp.codigonota'
      ''
      '       join vfornecedores vf'
      '         on np.fornecedor=vf.codigo and'
      '            np.tipofornecedor=vf.tipo'
      ''
      '  Where '
      '    case when :SelecaoPelaDatadeEmissao then'
      '         np.emissao between (:DataInicial) and (:DataFinal)'
      '    else np.data between (:DataInicial) and (:DataFinal) end'
      ''
      '    and np.situacao<>'#39'P'#39
      '    and cnp.tipo = '#39'P'#39
      
        '    and cnp.codigofiscal between (:CodigoFiscalInicial) and (:Co' +
        'digoFiscalFinal)'
      '    and (cnp.isentas<>0)'
      '    %WhereFiliais'
      '    %NaturezasProdutos'
      '    %NOSIMPLES'
      '    %CODIGOSFISCAISPRODUTOS'
      ''
      '  union all'
      ''
      '  select cnp.codigonota,'
      '         cast(3 as smallint) as tipo,'
      '         cast(null as numeric(5,2)) as aliquota,'
      '         cnp.codigofiscal,'
      
        '         case when np.situacao='#39'C'#39' then 0.00 else cnp.outras end' +
        ' as base,'
      '         cast(null as numeric(11,2)) as valor'
      '  from notaspag np'
      '       join calculosnotaspag cnp'
      '       on np.codigo = cnp.codigonota'
      ''
      '       join vfornecedores vf'
      '         on np.fornecedor=vf.codigo and'
      '            np.tipofornecedor=vf.tipo'
      ''
      '  Where '
      '    case when :SelecaoPelaDatadeEmissao then'
      '         np.emissao between (:DataInicial) and (:DataFinal)'
      '    else np.data between (:DataInicial) and (:DataFinal) end'
      ''
      '    and np.situacao<>'#39'P'#39
      '    and cnp.tipo = '#39'P'#39
      
        '    and cnp.codigofiscal between (:CodigoFiscalInicial) and (:Co' +
        'digoFiscalFinal)'
      '    and (cnp.outras<>0)'
      '    %WhereFiliais'
      '    %NaturezasProdutos'
      '    %NOSIMPLES'
      '    %CODIGOSFISCAISPRODUTOS'
      ''
      ') as cnp'
      ''
      
        'group by cnp.codigonota, cnp.codigofiscal, cnp.tipo, cnp.aliquot' +
        'a'
      
        'order by cnp.codigonota, cnp.codigofiscal, cnp.tipo, cnp.aliquot' +
        'a')
