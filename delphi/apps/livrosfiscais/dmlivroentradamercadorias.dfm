  object qryResumoDiario_ICMS: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryResumoDiario_ICMSBeforeOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NaturezasNotas'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NOSIMPLES'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CODIGOSFISCAISNOTAS'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NaturezasProdutos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CODIGOSFISCAISPRODUTOS'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'select data,'
      
        '         sum(case when Operacao='#39'OUTRAS'#39'   then valornota else 0' +
        ' end) as OutrasValorNota,'
      
        '         sum(case when Operacao='#39'OUTRAS'#39'   then base       else ' +
        '0 end) as OutrasBase,'
      
        '         sum(case when Operacao='#39'OUTRAS'#39'   then valor       else' +
        ' 0 end) as OutrasValor,'
      
        '         sum(case when Operacao='#39'A VISTA'#39'   then valornota else ' +
        '0 end) as AVistaValorNota,'
      
        '         sum(case when Operacao='#39'A VISTA'#39'   then base       else' +
        ' 0 end) as AVistaBase,'
      
        '         sum(case when Operacao='#39'A VISTA'#39'   then valor       els' +
        'e 0 end) as AVistaValor,'
      
        '         sum(case when Operacao='#39'A PRAZO'#39' then valornota else 0 ' +
        'end) as APrazoValorNota,'
      
        '         sum(case when Operacao='#39'A PRAZO'#39' then base       else 0' +
        ' end) as APrazoBase,'
      
        '         sum(case when Operacao='#39'A PRAZO'#39' then valor       else ' +
        '0 end) as APrazoValor'
      'from'
      '('
      '('
      ' SELECT operacao,'
      '        data,'
      '        sum(valornota) as valornota,'
      '        0 as base,'
      '        0 as valor'
      ' FROM'
      ' ('
      '  SELECT'
      '    case when (select count(*)'
      '               from duplicatas d'
      '               Where np.documentopag = d.documentopag)=0'
      '         then '#39'OUTRAS'#39
      '         else'
      '         case when (select count(*)'
      '                    from duplicatas d'
      '                    where np.documentopag=d.documentopag'
      
        '                      and d.datavencto > (case when :SelecaoPela' +
        'DatadeEmissao then np.emissao else np.data end) )=0'
      '              then '#39'A VISTA'#39
      '              else '#39'A PRAZO'#39
      '         end'
      '    end as Operacao,'
      
        '    case when :SelecaoPelaDatadeEmissao then np.emissao else np.' +
        'data  end as data,'
      '    np.valornota,'
      '    0 as base,'
      '    0 as valor'
      ''
      '  from notaspag np'
      '       join vfornecedores vf'
      '       on np.fornecedor=vf.codigo and'
      '          np.tipofornecedor=vf.tipo'
      ''
      '  Where'
      '    case when :SelecaoPelaDatadeEmissao then'
      '         np.emissao between (:DataInicial) and (:DataFinal)'
      '    else np.data between (:DataInicial) and (:DataFinal) end'
      ''
      '    and np.situacao<>'#39'P'#39' and np.situacao<>'#39'C'#39
      '    and exists (select cnp.codigofiscal'
      '                from calculosnotaspag cnp'
      '                where cnp.codigonota = np.codigo'
      
        '                  and cnp.codigofiscal between (:CodigoFiscalIni' +
        'cial) and (:CodigoFiscalFinal) limit 1)'
      ''
      '  %WhereFiliais'
      '  %NaturezasNotas'
      '  %NOSIMPLES'
      '  %CODIGOSFISCAISNOTAS'
      ' ) as NotasPag'
      ' group by data, operacao'
      ')'
      'union all'
      '('
      ' SELECT operacao,'
      '        data,'
      '        0 as valornota,'
      '        sum(base) as base,'
      '        sum(valor) as valor'
      ' FROM'
      ' ('
      '  SELECT'
      '    case when (select count(*)'
      '               from duplicatas d'
      '               Where np.documentopag = d.documentopag)=0'
      '         then '#39'OUTRAS'#39
      '         else'
      '         case when (select count(*)'
      '                    from duplicatas d'
      '                    where np.documentopag=d.documentopag'
      
        '                      and d.datavencto > (case when :SelecaoPela' +
        'DatadeEmissao then np.emissao else np.data end) )=0'
      '              then '#39'A VISTA'#39
      '              else '#39'A PRAZO'#39
      '         end'
      '    end as Operacao,'
      '    np.data,'
      '    0 as valornota,'
      '    cnp.base,'
      '    cnp.valor'
      ''
      '  from notaspag np'
      '       join CalculosNotasPag cnp'
      '       on np.codigo = cnp.codigonota'
      '       join vfornecedores vf'
      '       on np.fornecedor=vf.codigo and'
      '          np.tipofornecedor=vf.tipo'
      ''
      '  Where'
      '    case when :SelecaoPelaDatadeEmissao then'
      '         np.emissao between (:DataInicial) and (:DataFinal)'
      '    else np.data between (:DataInicial) and (:DataFinal) end'
      ''
      
        '    and cnp.codigofiscal between (:CodigoFiscalInicial) and (:Co' +
        'digoFiscalFinal)'
      '    and np.situacao<>'#39'P'#39' and np.situacao<>'#39'C'#39
      '    and cnp.tipo = '#39'M'#39
      ''
      '  %WhereFiliais'
      '  %NaturezasProdutos'
      '  %NOSIMPLES'
      '  %CODIGOSFISCAISPRODUTOS'
      ' ) as CalculosNotasPag'
      ' group by data, operacao'
      ')'
      ') as temp'
      'group by data'
      'order by data')
    RequestLive = False
    Left = 712
    Top = 24
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'SelecaoPelaDatadeEmissao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataFinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CodigoFiscalInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CodigoFiscalFinal'
        ParamType = ptUnknown
      end>
