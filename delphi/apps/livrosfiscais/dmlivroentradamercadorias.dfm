  object qryCalculos_ICMS: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NaturezasProdutos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NOSIMPLES'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CODIGOSFISCAISPRODUTOS'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'SELECT cnp.codigonota,'
      '  cast(null as integer) as tipo,'
      '  cnp.codigofiscal,'
      '  cnp.aliquota,'
      '  sum(cnp.base) as base,'
      '  sum(cnp.valor) as valor,'
      '  sum(cnp.isentas) as isentas,'
      '  sum(cnp.outras) as outras'
      ''
      'FROM ((notaspag np'
      '       join calculosnotaspag cnp'
      '       on np.codigo = cnp.codigonota)'
      ''
      '       join vfornecedores vf'
      '         on np.fornecedor=vf.codigo and'
      '            np.tipofornecedor=vf.tipo)'
      ''
      ''
      'Where '
      ''
      '    case when :SelecaoPelaDatadeEmissao then'
      '         np.emissao between (:DataInicial) and (:DataFinal)'
      '    else np.data between (:DataInicial) and (:DataFinal) end'
      ''
      '  and np.situacao<>'#39'P'#39
      '  and cnp.tipo = '#39'M'#39
      
        '  and cnp.codigofiscal between (:CodigoFiscalInicial) and (:Codi' +
        'goFiscalFinal)'
      '  %WhereFiliais'
      '  %NaturezasProdutos'
      '  %NOSIMPLES'
      '  %CODIGOSFISCAISPRODUTOS'
      'group by cnp.codigonota, cnp.codigofiscal, cnp.aliquota'
      'order by cnp.codigonota, cnp.codigofiscal')
    RequestLive = False
    Left = 80
    Top = 224
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'SelecaoPelaDatadeEmissao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataFinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CodigoFiscalInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CodigoFiscalFinal'
        ParamType = ptUnknown
      end>
  end
