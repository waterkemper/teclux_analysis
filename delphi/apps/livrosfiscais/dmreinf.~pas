//  qryepc.Params[0].Clear;
  qryReinf.append;
  Result := True;

end;

procedure TdtmReinf.qryReinfNewRecord(DataSet: TDataSet);
begin
  inherited;
  qryReinftpamb.AsInteger := FReinfAmbiente;
  qryReinfprocemi.asinteger := 1;
  qryReinfverproc.asString := 'TECLUX';
end;

procedure TdtmReinf.qryReinfAfterScroll(DataSet: TDataSet);
begin
  inherited;

  RefazConsultaPorNome(qry1000_Contribuinte,
    ['filial'],[qryReinffilial.asInteger]);

  qry1070_ProcessoJudicialReinf.Close;
  qry1070_ProcessoJudicialReinf.Open;

  RefazConsultaPorNome(qryEnvio_Reinf,
    ['filial','perApur'],
    [qryReinffilial.asInteger, qryReinfperapur.AsString]);

  RefazConsultaPorNome(qryEnvio1000_Contribuinte,
    ['filial','perApur'],
    [qryReinffilial.asInteger, qryReinfperapur.AsString]);

  RefazConsultaPorNome(qryEnvio1070_ProcessoJudicialReinf,
    ['filial','perApur'],
    [qryReinffilial.asInteger, qryReinfperapur.AsString]);

  RefazConsultaPorNome(qryEnvio_SuspensaoExibilidadeTributos,
    ['filial','perApur'],
    [qryReinffilial.asInteger, qryReinfperapur.AsString]);

end;

procedure TdtmReinf.qry1000_ContribuinteBeforeOpen(DataSet: TDataSet);
begin
  inherited;
  qry1000_Contribuinte.parambyname('nmCtt').asString := ParSistema.NomeContador;
  qry1000_Contribuinte.parambyname('cpfCtt').asString := ParSistema.CPFContador;
  qry1000_Contribuinte.parambyname('foneFixo').asString := inttostr(ParSistema.DDDContador) + inttostr(ParSistema.TelefoneContador);
  qry1000_Contribuinte.parambyname('foneCel').asString := inttostr(ParSistema.DDDCelContador) + inttostr(ParSistema.TelefoneCelContador);
  qry1000_Contribuinte.parambyname('email').asString := ParSistema.EmailContador;

end;

procedure TdtmReinf.qry1070_ProcessoJudicialReinfAfterOpen(
  DataSet: TDataSet);
var
  vLista : String;
begin
  inherited;
  vLista := RetornarLista(qry1070_ProcessoJudicialReinf, qry1070_ProcessoJudicialReinfnumero);
  qry1070_SuspensaoExibilidadeTributos.ParamByName('ListaProcessoJudicial').AsString := vLista;
  qry1070_SuspensaoExibilidadeTributos.close;
  qry1070_SuspensaoExibilidadeTributos.open;


end;

