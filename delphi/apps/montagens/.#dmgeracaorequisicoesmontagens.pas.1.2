begin
result:=qryConsultaClientes;
end;

function TdtmGeracaoRequisicoesMontagens.GetConsultaFiliais: TZDataSet;
begin
result:=qryConsultaFiliais;
end;

function TdtmGeracaoRequisicoesMontagens.GetConsultaGrupoFiliais: TZDataSet;
begin
result:=qryConsultaGrupoFiliais;
end;

function TdtmGeracaoRequisicoesMontagens.GetTotalRegistros: Integer;
begin
result := qryItensRequisicoes.RecordCount;
end;

procedure TdtmGeracaoRequisicoesMontagens.Selecionar(
  TipoPesquisa: TipoProcuraRequisicoes);
begin
case TipoPesquisa of
 tpRequisicoesFiliaisdeMontagem      : RefazConsulta(qryFilialMontagem,
                                       [0],[qryConsultaFiliaiscodigo.AsVariant]);
 tpRequisicoesGrupoFiliaisdeMontagem : RefazConsulta(qryGrupoFiliaisMontagem,
                                       [0],[qryConsultaGrupoFiliaiscodigo.AsVariant]);
 tpRequisicoesFiliaisdeVenda         : RefazConsulta(qryFilialVenda,

                                       [0],[qryConsultaFiliaiscodigo.AsVariant]);

 tpRequisicoesGrupoFiliaisdeVenda    : RefazConsulta(qryGrupoFiliaisVenda,

                                       [0],[qryConsultaGrupoFiliaiscodigo.AsVariant]);
 tpRequisicoesClientes               :
 begin

  RefazConsulta(qryCliente,[0,1],[qryConsultaClientescodigo.AsVariant,

                                  qryConsultaClientestipo.AsVariant]);

  qryCliente.Params[1].AsString:=qryConsultaClientestipo.AsString;

 end;

 tpRequisicoesLerDadosMontadores :
 begin

  RefazConsulta(qryMontador,[0,1], [qryConsultaMontadorcodigo.AsVariant,

                                    qryConsultaMontadortipo.AsVariant]);

  qryMontador.Params[1].AsString:=qryConsultaMontadortipo.AsString;

 end;

end

end;

procedure TdtmGeracaoRequisicoesMontagens.SetCliente(const Value: String);
begin
 FCliente := Value;
 if Value <> '' then
   qryItensRequisicoes.MacroByName('WhereCliente').asstring :=
   ' and (df.cliente = ' + Value +
   ') and (df.tipocliente = ' + quotedstr(qryClientetipo.AsString) + ')'
 else
   qryItensRequisicoes.MacroByName('WhereCliente').asstring :='';
end;

procedure TdtmGeracaoRequisicoesMontagens.SetDataFinal(
  const Value: string);
begin
  FDataFinal := Value;

  if value='' then
    FDataFinal:=FDataInicial;

  if FDataInicial='' then
    FDataInicial:=FDataFinal;

  qryItensRequisicoes.ParamByName('datainicial').AsDateTime := strtodate(FDataInicial);
  qryItensRequisicoes.ParamByName('datafinal').AsDateTime := strtodate(FDataFinal);

end;

procedure TdtmGeracaoRequisicoesMontagens.SetDataInicial(
  const Value: string);
begin
  FDataInicial := Value;
end;

procedure TdtmGeracaoRequisicoesMontagens.SetFilialdeMontagem(
  const Value: String);
begin
  FFilialdeMontagem := Value;
  if Value <> '' then
    qryItensRequisicoes.macrobyname('WhereFiliaisMontagem').AsString :=' and (ct.montagemfilial = ' + Value + ')'
  else
    qryItensRequisicoes.macrobyname('WhereFiliaisMontagem').AsString :='';
end;

procedure TdtmGeracaoRequisicoesMontagens.SetFilialdeVenda(
  const Value: String);
begin
  FFilialdeVenda := Value;
  if Value <> '' then
    qryItensRequisicoes.macrobyname('WhereFiliaisVenda').AsString :=' and (ct.filialvenda = ' + Value + ')'
  else
    qryItensRequisicoes.macrobyname('WhereFiliaisVenda').AsString :='';
end;

procedure TdtmGeracaoRequisicoesMontagens.SetGrupoFilialdeMontagem(
  const Value: String);
begin
 FGrupoFilialdeMontagem := Value;
 if (Value <> '') then
   qryItensRequisicoes.macrobyname('WhereFiliaisMontagem').AsString :=
    'and (ct.montagemfilial in (Select filial From filiaisgruposfiliais '+
    'Where grupo = ' + Value + '))';
end;

procedure TdtmGeracaoRequisicoesMontagens.SetGrupoFilialdeVenda(
  const Value: String);
begin
  FgrupoFilialdeVenda := Value;
   if (Value <> '') then
   qryItensRequisicoes.macrobyname('WhereFiliaisVenda').AsString :=
    'and (ct.filialVenda in (Select filial From filiaisgruposfiliais '+
    'Where grupo = ' + Value + '))';
end;

procedure TdtmGeracaoRequisicoesMontagens.qryItensRequisicoesAfterScroll(
  DataSet: TDataSet);
begin
  inherited;
  if not qryItensRequisicoes.ControlsDisabled then
  begin
   RefazConsulta(qryProdutosContratos, [0], [qryItensRequisicoescontrato.AsVariant]);
   RefazConsulta(qryProdutosDadosFiscais, [0], [qryItensRequisicoesdadofiscal.AsVariant]);
   RefazConsulta(qryClientesRequisicoes, [0,1], [qryItensRequisicoescliente.AsVariant,
                                    qryItensRequisicoestipocliente.AsVariant]);
  end;
  if Assigned(FOnScrollLinhaColunaGradeItensRequisicoes) then
   FOnScrollLinhaColunaGradeitensRequisicoes(DataSet);
end;

procedure TdtmGeracaoRequisicoesMontagens.GerarRequisicoes;
var
 NRequisicao: String;
begin
  try
    qryItensRequisicoes.DisableControls;
    SelecionarRequisicoes;
    qryRequisicoes.First;
    while not qryRequisicoes.Eof do
    begin
     spcRequisicoesProximoCodigo.Open;
     NRequisicao:=spcRequisicoesProximoCodigonumero.AsString;
     qryGerarRequisicoes.Close;
     qryGerarRequisicoes.Sql[0]:=
      'insert into requisicoes '+
      '(numero, abertura, dadofiscal, filialmontagem, vendedor, cliente,'+
      ' tipocliente, montador, tipomontador, rua, estado, cidade, bairro, cep, observacoes,'+
      ' foneddd, fonenumero, foneramal, datahora)'+
      ' values ('+
     NRequisicao+', '+
     quotedstr(DateToStr(DataServidor))+', '+
     qryRequisicoesdadofiscal.AsString+', '+
     qryRequisicoesmontagemfilial.AsString+', '+
     qryRequisicoesvendedor.AsString+', '+
     qryRequisicoescliente.AsString+', '+
     quotedstr(qryRequisicoestipocliente.AsString)+', ';

     if CodigoMontador='' then
       qryGerarRequisicoes.Sql[0]:=qryGerarRequisicoes.Sql[0]+'null, null, '
     else
       qryGerarRequisicoes.Sql[0]:=qryGerarRequisicoes.Sql[0]+
       CodigoMontador+', '+quotedstr(TipoMontador)+', ';

     if qryRequisicoesentrua.AsString='' then
       qryGerarRequisicoes.Sql[0]:=qryGerarRequisicoes.Sql[0]+'null, '
     else
       qryGerarRequisicoes.Sql[0]:=qryGerarRequisicoes.Sql[0]+
       quotedstr(qryRequisicoesentrua.AsString)+', ';

     if qryRequisicoesentestado.AsString='' then
       qryGerarRequisicoes.Sql[0]:=qryGerarRequisicoes.Sql[0]+'null, '
     else
      qryGerarRequisicoes.Sql[0]:=qryGerarRequisicoes.Sql[0]+
      quotedstr(qryRequisicoesentestado.AsString)+', ';

     if qryRequisicoesentcidade.AsString='' then
       qryGerarRequisicoes.Sql[0]:=qryGerarRequisicoes.Sql[0]+'null, '
     else
      qryGerarRequisicoes.Sql[0]:=qryGerarRequisicoes.Sql[0]+
      qryRequisicoesentcidade.AsString+', ';

     if qryRequisicoesentbairro.AsString='' then
       qryGerarRequisicoes.Sql[0]:=qryGerarRequisicoes.Sql[0]+'null, '
     else
      qryGerarRequisicoes.Sql[0]:=qryGerarRequisicoes.Sql[0]+
      qryRequisicoesentbairro.AsString+', ';

     if qryRequisicoesentcep.AsString='' then
       qryGerarRequisicoes.Sql[0]:=qryGerarRequisicoes.Sql[0]+'null, '
     else
      qryGerarRequisicoes.Sql[0]:=qryGerarRequisicoes.Sql[0]+
      qryRequisicoesentcep.AsString+', ';

     if qryRequisicoesmontagemobs.AsString='' then
       qryGerarRequisicoes.Sql[0]:=qryGerarRequisicoes.Sql[0]+'null, '
     else
      qryGerarRequisicoes.Sql[0]:=qryGerarRequisicoes.Sql[0]+
      quotedstr(qryRequisicoesmontagemobs.AsString)+', ';

     if qryRequisicoesentfoneddd.AsString='' then
       qryGerarRequisicoes.Sql[0]:=qryGerarRequisicoes.Sql[0]+'null, '
     else
      qryGerarRequisicoes.Sql[0]:=qryGerarRequisicoes.Sql[0]+
      qryRequisicoesentfoneddd.AsString+', ';

     if qryRequisicoesentfonenumero.AsString='' then
       qryGerarRequisicoes.Sql[0]:=qryGerarRequisicoes.Sql[0]+'null, '
     else
      qryGerarRequisicoes.Sql[0]:=qryGerarRequisicoes.Sql[0]+
      qryRequisicoesentfonenumero.AsString+', ';

     if qryRequisicoesentfoneramal.AsString='' then
       qryGerarRequisicoes.Sql[0]:=qryGerarRequisicoes.Sql[0]+'null, '
     else
      qryGerarRequisicoes.Sql[0]:=qryGerarRequisicoes.Sql[0]+
      quotedstr(qryRequisicoesentfoneramal.AsString)+', ';

     qryGerarRequisicoes.Sql[0]:=qryGerarRequisicoes.Sql[0]+
     quotedstr(DateTimeToStr(DataHoraLocal))+')';

     qryGerarRequisicoes.ExecSql;
     spcRequisicoesProximoCodigo.close;

     if ExisteCodigo(qryItensRequisicoes,'dadofiscal',
             qryRequisicoesdadofiscal.AsString) then
     begin
       while (not qryItensRequisicoes.Eof and
              (qryRequisicoesdadofiscal.AsString=
               qryItensRequisicoesdadofiscal.AsString)) do
       begin
         if qryItensRequisicoesmarcar.AsBoolean then
         begin
          qryGerarRequisicoes.Close;
          qryGerarRequisicoes.Sql[0]:=
          'insert into requisicoesitens (requisicao, produto, filial, quantidade) '+
          'values ('+
          NRequisicao+', '+
          qryItensRequisicoesproduto.AsString+', '+
          qryItensRequisicoesfilial.AsString+', '+
          convertevalor(qryItensRequisicoesquantidade.AsString)+')';
          qryGerarRequisicoes.ExecSql;

         end;
         qryItensRequisicoes.Next;
       end;
     end;
     qryRequisicoes.Next;
    end;
    Perpetrar([]);
  finally
    qryItensRequisicoes.EnableControls;
  end;
end;

