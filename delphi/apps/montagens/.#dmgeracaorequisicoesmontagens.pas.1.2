procedure TdtmGeracaoRequisicoesMontagens.SelecionarRequisicoes;
const
  SQLStr = ' Where (%s)';

var
  SQL: String;

begin
 qryItensRequisicoes.First;
 SQL:='';
 while not qryItensRequisicoes.Eof do
 begin
  if qryItensRequisicoesmarcar.AsBoolean then
  begin
   if SQL<>'' then
    SQL:=SQL+' or ';
   SQL:=SQL+'(df.numero = '+quotedstr(qryItensRequisicoesdadofiscal.AsString)+')';
  end;
   qryitensRequisicoes.Next;
 end;
 qryRequisicoes.MacroByName('DADOFISCAL').AsString:=Format(SQLStr, [SQL]);
 qryRequisicoes.Close;
 qryRequisicoes.Open;
end;

