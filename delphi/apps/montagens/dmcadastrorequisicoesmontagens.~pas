function TdtmCadastroRequisicoesMontagens.AtualizaItensRequisicoesNotas(
  FilialEmissao,Serie,NumeroNota:String):boolean;
begin
 Result :=false;
 if (FilialEmissao<>'') and (Serie<>'') and (NumeroNota<>'') then
  RefazConsulta(qryProcuraDadosFiscaisNotas,[0,1,2],[FilialEmissao,Serie,NumeroNota])
 else
  RefazConsulta(qryProcuraDadosFiscaisNotas,[],[]);
 if not qryProcuraDadosFiscaisNotas.IsEmpty then
  begin
  if ValidaNotaRequisicao(qryProcuraDadosFiscaisNotasrequisicao.AsString) then
   if MensagemConfirmacao(ctATUALIZAITENSREQUISICOES)=smbOK then
   begin
     Requisicoesdadofiscal             :=qryProcuraDadosFiscaisNotasdadofiscal.AsInteger;
     Requisicoesvendedor               :=qryProcuraDadosFiscaisNotasvendedor.AsInteger;
     RequisicoesClientes               :=qryProcuraDadosFiscaisNotascliente.AsInteger;
     RequisicoesTipoClientes           :=qryProcuraDadosFiscaisNotastipocliente.AsString;
     RequisicoesFiliaisdeMontagem      :=qryProcuraDadosFiscaisNotasmontagemfilial.AsString;
     RequisicoesNota                   :=qryProcuraDadosFiscaisNotasnumero.AsString;
     RequisicoesSerie                  :=qryProcuraDadosFiscaisNotasserie.AsString;
     Requisicoesmaquina                :=qryProcuraDadosFiscaisNotasmaquina.asstring;
     RequisicoesIntervensao            :=qryProcuraDadosFiscaisNotasintervensao.AsString;
     RequisicoesCupom                  :=qryProcuraDadosFiscaisNotascupomfiscal.AsString;
     qryRequisicoesrua.Value           :=qryProcuraDadosFiscaisNotasentrua.Value;
     qryRequisicoescidade.Value        :=qryProcuraDadosFiscaisNotasentcidade.Value;
     qryRequisicoesnomecidade.Value    :=qryProcuraDadosFiscaisNotasnomecidade.Value;
     qryRequisicoesbairro.Value        :=qryProcuraDadosFiscaisNotasentbairro.Value;
