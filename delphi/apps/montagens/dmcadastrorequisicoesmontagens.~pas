procedure TdtmCadastroRequisicoesMontagens.LerProdutosFiliaisIncluidos(
  Incluindo: Boolean);
const
  SQLStr = ' and (%s)';
var
  SQL: String;
  a: Integer;
begin
  inherited;

  if Incluindo then begin
    qryConsultaFilialProduto.Params[0].Asinteger := 0;
    qryProcuraFilialProduto.Params[1].Asinteger  := 0;
  end else begin
    qryConsultaFilialProduto.Params[0].AsString := qryRequisicoesItensproduto.AsString;
    qryProcuraFilialProduto.Params[1].AsString  := qryRequisicoesItensproduto.AsString;
  end;

  for a:= 0 to ProdutosItensRequisicoes[produtofilial].Count -1 do
  begin
   if incluindo or ((produtositensrequisicoes[produto].Strings[a]<>
                     qryRequisicoesItensproduto.AsString) or
                    (produtositensrequisicoes[filial].Strings[a]<>
                     qryRequisicoesItensfilial.AsString)) then
    SQL := SQL +
    '((e.produto <> ' + produtositensrequisicoes[produto].Strings[a] +') or ' +
    '(e.filial <> ' + produtositensrequisicoes[filial].Strings[a] + ')) and ';
  end;

  if SQL = '' then begin
    qryProcuraProdutos.MacroByName('Produtos').AsString := '';
    qryConsultaProdutos.Sql[14]     := '';
    qryConsultaFilialProduto.Sql[14] := '';
    qryProcuraFilialProduto.Sql[14]  := '';
  end else begin
    Delete(SQL, Length(SQL)-4, 5);
    qryProcuraProdutos.MacroByName('Produtos').AsString := Format(SQLStr, [SQL]);
    qryConsultaProdutos.Sql[14]     := Format(SQLStr, [SQL]);
    qryConsultaFilialProduto.Sql[14] := Format(SQLStr, [SQL]);;
    qryProcuraFilialProduto.Sql[14]  := Format(SQLStr, [SQL]);
  end;


end;

