procedure TdtmCadastroRequisicoesMontagens.qryRequisicoesItensAfterOpen(
  DataSet: TDataSet);
begin
  inherited;

  ProdutosItensRequisicoes[produtofilial].Clear;
  ProdutosItensRequisicoes[produto].Clear;
  ProdutosItensRequisicoes[filial].Clear;
  qryrequisicoesitens.DisableControls;
  qryrequisicoesitens.AfterScroll := nil;
  qryRequisicoesItens.First;
  While not qryRequisicoesItens.Eof do
  begin
    ProdutosItensRequisicoes[produtofilial].Add(
       qryRequisicoesItensproduto.AsString+
       qryRequisicoesItensfilial.AsString);
    ProdutosItensRequisicoes[produto].Add(qryRequisicoesItensproduto.AsString);
    ProdutosItensRequisicoes[filial].Add(qryRequisicoesItensfilial.AsString);
    qryRequisicoesItens.Next;
  end;
  qryRequisicoesItens.AfterScroll := qryRequisicoesItensAfterScroll;
  qryRequisicoesItens.EnableControls;
end;

