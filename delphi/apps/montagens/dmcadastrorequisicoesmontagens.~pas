function TdtmCadastroRequisicoesMontagens.GravarRequisicoes: boolean;
var
SituacaoRequisicao, SituacaoRequisicaoPagto : String;
begin
  if qryRequisicoes.CheckRequiredFields then
  begin
   if qryRequisicoesItens.IsEmpty then
   begin
    result:=false;
    MensagemAviso(format(ctITEMNAOCADASTRADO, ['Requisição']));
    exit;
   end;

   if qryRequisicoes.State = dsinsert then
   begin
     spcRequisicoesProximoCodigo.Open;
     qryRequisicoesnumero.Value:=spcRequisicoesProximoCodigonumero.Value;
     spcRequisicoesProximoCodigo.Close;
   end;

   try
     qryRequisicoesItens.DisableControls;
     SituacaoRequisicao:='';
     qryRequisicoesItens.First;
     while not qryRequisicoesItens.Eof do
     begin
       qryRequisicoesItens.Edit;
       qryRequisicoesItensrequisicao.Value:=qryRequisicoesnumero.Value;
       qryRequisicoesItens.Post;
       if qryRequisicoesItensdatamontagem.AsString='' then
       begin
         if SituacaoRequisicao=ctFechado then
           SituacaoRequisicao:=ctParcial
         else
           SituacaoRequisicao:=ctAberto;
       end
       else
        begin
         if SituacaoRequisicao=ctAberto then
           SituacaoRequisicao:=ctParcial
         else
           SituacaoRequisicao:=ctFechado;
        end;

       if qryRequisicoesItensdatapagto.AsString='' then
       begin
         if SituacaoRequisicaoPagto=ctFechado then
           SituacaoRequisicaoPagto:=ctParcial
         else
           SituacaoRequisicaoPagto:=ctAberto;
       end
       else
        begin
         if SituacaoRequisicaoPagto=ctAberto then
           SituacaoRequisicaoPagto:=ctParcial
         else
           SituacaoRequisicaoPagto:=ctFechado;
        end;
       qryRequisicoesItens.Next;
     end;
   finally
     qryRequisicoesItens.EnableControls;
   end;

   qryRequisicoesdatahora.Value:=DataHoraLocal;
   qryRequisicoesSituacao.Value:=SituacaoRequisicao;
   qryRequisicoessituacaopagto.Value:=SituacaoRequisicaoPagto;
   qryRequisicoes.Post;

   Result:= Perpetrar([qryRequisicoes,qryRequisicoesItens]);
          end
  else
    result:=false;
end;

function TdtmCadastroRequisicoesMontagens.GravarRequisicoesItens: boolean;
begin
  result := false;
  if qryRequisicoesItens.CheckRequiredFields then
  begin
   if (qryRequisicoesItensdatamontagem.AsString='') and
      (DataMontagemAnterior<>'') then
    if MensagemConfirmacao(format(ctCONFIRMECANCELAR,['este item de montagem']))=smbCancel then
     begin
      result:=false;
      exit;
     end
    else
     DataMontagemAnterior:='';

   if not (qryRequisicoes.State in [dsinsert, dsedit]) then
      qryRequisicoes.Edit;

   if qryRequisicoes.State in [dsinsert] then
   begin
     qryRequisicoesItens.Post;
     IncluiListaProdutos;
   end
   else
   begin
    qryRequisicoesItens.Post;
    AlteraListaProdutos;
   end;
   result:=true;
  end;
end;

