procedure TdtmCadastroRequisicoesMontagens.SelecionarProdutosParaMontagem(Incluindo: Boolean);
Var
SQLMontagem: String;
begin
  if RequisicoesDadoFiscal=0 then
  begin
   if not incluindo and((qryRequisicoesItensproduto.AsString<>'') and
                        (qryRequisicoesItensfilial.AsString<>'')) then
     SQLMontagem:='and (c.montagem) or ((e.produto = '+
        qryRequisicoesItensproduto.AsString+' ) and (e.filial = '+
        qryRequisicoesItensfilial.AsString+' ))'
   else
     SQLMontagem:='and (c.montagem)';

   qryProcuraProdutos.MacroByName('Montagem').AsString:=SQLMontagem;
   qryConsultaProdutos.sql[15]:='and (c.montagem)';
   qryProcuraFilialProduto.Sql[15]:=SQLMontagem;
   qryConsultaFilialProduto.Sql[15]:='and (c.montagem)';
  end
  else
  begin
   qryProcuraProdutos.MacroByName('Montagem').AsString:='';
   qryConsultaProdutos.sql[15]:='';
   qryProcuraFilialProduto.Sql[15]:='';
   qryConsultaFilialProduto.Sql[15]:='';
  end;
end;

