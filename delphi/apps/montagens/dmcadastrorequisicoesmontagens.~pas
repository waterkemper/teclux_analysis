procedure TdtmCadastroRequisicoesMontagens.CalcularValorPagto;
begin
 if qryRequisicoesItensmontagem.AsString='' then
 begin
  qryRequisicoesItensdescricaomontagem.asstring:='';
  qryRequisicoesItensvalorpagto.asstring:='';
 end
 else
 begin
  qryRequisicoesItensdescricaomontagem.Value:=qryProcuraTabeladeMontagemdescricao.Value;
  if qryProcuraTabeladeMontagemtipovalor.AsString='V' then
  begin
   if (qryRequisicoesItenstipodemontagem.AsString='') then
   begin
    qryRequisicoesItenstipodemontagem.value:='L';
    qryRequisicoesItensvalorpagto.Value:=
       qryRequisicoesItensquantidade.Value*qryProcuraTabeladeMontagemvalorloja.Value;
   end
   else
   if (qryRequisicoesItenstipodemontagem.AsString='L') then
    qryRequisicoesItensvalorpagto.Value:=
       qryRequisicoesItensquantidade.Value*qryProcuraTabeladeMontagemvalorloja.Value
   else
   if qryRequisicoesItenstipodemontagem.AsString='D' then
    qryRequisicoesItensvalorpagto.Value:=
      qryRequisicoesItensquantidade.Value*qryProcuraTabeladeMontagemvalordentro.Value
   else
    qryRequisicoesItensvalorpagto.Value:=
     qryRequisicoesItensquantidade.Value*qryProcuraTabeladeMontagemvalorfora.Value;
  end
  else
  begin
   if Requisicoesdadofiscal=0 then
   begin
