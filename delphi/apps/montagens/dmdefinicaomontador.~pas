begin
  result := qryRequisicoes.RecordCount;
end;

procedure TdtmDefinicaoMontador.Selecionar(
  TipoPesquisa: TipoProcuraRequisicoes);
begin
case TipoPesquisa of
 tpRequisicoesFiliaisdeMontagem      : RefazConsulta(qryFilialMontagem,
                                       [0],[qryConsultaFiliaiscodigo.AsVariant]);
 tpRequisicoesGrupoFiliaisdeMontagem : RefazConsulta(qryGrupoFiliaisMontagem,
                                       [0],[qryConsultaGrupoFiliaiscodigo.AsVariant]);
 tpRequisicoesFiliaisdeVenda         : RefazConsulta(qryFilialVenda,

                                       [0],[qryConsultaFiliaiscodigo.AsVariant]);

 tpRequisicoesGrupoFiliaisdeVenda    : RefazConsulta(qryGrupoFiliaisVenda,

                                       [0],[qryConsultaGrupoFiliaiscodigo.AsVariant]);
 tpRequisicoesClientes               :

 begin

  RefazConsulta(qryCliente,[0,1],[qryConsultaClientescodigo.AsVariant,

                                  qryConsultaClientestipo.AsVariant]);

  qryCliente.Params[1].AsString:=qryConsultaClientestipo.AsString;

 end;

 tpRequisicoesLerDadosMontadores :

 begin

  RefazConsulta(qryMontadorSelecao,[0,1], [qryConsultaMontadorcodigo.AsVariant,

                                           qryConsultaMontadortipo.AsVariant]);

  qryMontadorSelecao.Params[1].AsString:=qryConsultaMontadortipo.AsString;

 end;

 tpRequisicoesMontadores :

 begin

  RefazConsulta(qryMontador,[0,1], [qryConsultaMontadorcodigo.AsVariant,

                                    qryConsultaMontadortipo.AsVariant]);

  qryMontador.Params[1].AsString:=qryConsultaMontadortipo.AsString;

 end;

end;

end;

procedure TdtmDefinicaoMontador.SetCliente(const Value: String);
begin
 FCliente := Value;
 if Value <> '' then
   qryRequisicoes.Sql[WhereCliente]:=
   ' and (r.cliente = ' + Value +
   ') and (r.tipocliente = ' + quotedstr(qryClientetipo.AsString) +')'
 else
   qryRequisicoes.Sql[WhereCliente]:='';
end;

procedure TdtmDefinicaoMontador.SetDataFinal(const Value: string);
begin
  FDataFinal := Value;

  if value='' then
    FDataFinal:=FDataInicial;

  if FDataInicial='' then
    FDataInicial:=FDataFinal;

  qryRequisicoes.parambyname('DataInicial').asstring:=FDataInicial;
  qryRequisicoes.parambyname('DataFinal').asstring:=FDataFinal;

end;

procedure TdtmDefinicaoMontador.SetDataInicial(const Value: string);
begin
  FDataInicial := Value;
end;

procedure TdtmDefinicaoMontador.SetFilialdeMontagem(const Value: String);
begin
  FFilialdeMontagem := Value;
  if Value <> '' then
    qryRequisicoes.Sql[WhereFiliaisMontagem]:=' and (r.filialMontagem = ' + Value + ')'
  else
    qryRequisicoes.Sql[WhereFiliaisMontagem]:='';
end;

procedure TdtmDefinicaoMontador.SetFilialdeVenda(const Value: String);
begin
  FFilialdeVenda := Value;
  if Value <> '' then
    qryRequisicoes.Sql[WhereFiliaisVenda]:=
    ' and ((select c.filialvenda from contratos c where c.numero='+
    '(select df.contrato from dadosfiscais df where df.numero=r.dadofiscal)'+
    ')= ' + Value + ')'
  else
    qryRequisicoes.Sql[WhereFiliaisVenda]:='';
end;

procedure TdtmDefinicaoMontador.SetGrupoFilialdeMontagem(
  const Value: String);
begin
  FGrupoFilialdeMontagem := Value;
   if (Value <> '') then
   qryRequisicoes.Sql[WhereFiliaisMontagem] :=
    'and (r.filialMontagem in (Select filial From filiaisgruposfiliais '+
    'Where grupo = ' + Value + '))';
end;

procedure TdtmDefinicaoMontador.SetGrupoFilialdeVenda(const Value: String);
begin
  FgrupoFilialdeVenda := Value;
  if (Value <> '') then
   qryRequisicoes.Sql[WhereFiliaisVenda] :=
    ' and ((select c.filialvenda from contratos c where c.numero='+
    '(select df.contrato from dadosfiscais df where df.numero=r.dadofiscal)'+
    ') in (select filial from filiaisgruposfiliais where grupo = ' + Value + '))';
end;

procedure TdtmDefinicaoMontador.SetMontador(const Value: String);
begin
  FMontador := Value;
  if FRequisicaoSemMontador then
    qryRequisicoes.Sql[WhereMontador]:=' and (r.montador is null)'
  else
   if Value <> '' then
    qryRequisicoes.Sql[WhereMontador]:=
    ' and (r.montador = ' + Value +
    ') and (r.tipomontador = ' + quotedstr(qryMontadortipo.AsString) +')'
   else
    qryRequisicoes.Sql[WhereMontador]:='';
end;

procedure TdtmDefinicaoMontador.SetCodigoMontador(const Value: string);
begin
  FCodigoMontador := Value;
  if value<>'' then
   FTipoMontador:=qryMontadorSelecaotipo.AsString
  else
   FTipoMontador:='';
end;

procedure TdtmDefinicaoMontador.qryRequisicoesAfterScroll(
  DataSet: TDataSet);
begin
  inherited;
  if not qryRequisicoes.ControlsDisabled then
  begin
   ReFazConsulta(qryRequisicoesItens, [0], [qryRequisicoesrequisicao.AsVariant]);
   RefazConsulta(qryProdutosContratos, [0], [qryRequisicoescontrato.AsVariant]);
   RefazConsulta(qryProdutosDadosFiscais, [0], [qryRequisicoesdadofiscal.AsVariant]);
   RefazConsulta(qryClientesRequisicoes, [0,1], [qryRequisicoescliente.AsVariant,
                                     qryRequisicoestipocliente.AsVariant]);
  end;
end;

procedure TdtmDefinicaoMontador.GerarDefinicaoMontadorRequisicoes;
begin
  try
   qryRequisicoes.DisableControls;
   qryRequisicoes.First;
   while not qryRequisicoes.Eof do
   begin
    if qryRequisicoesmarcar.AsBoolean then
    begin
     qryRequisicoes.Edit;
     qryRequisicoesmontador.asstring:=CodigoMontador;
     qryRequisicoestipomontador.asstring:=TipoMontador;
     qryRequisicoes.Post;
    end;
    qryRequisicoes.Next;
   end;
   Perpetrar([qryRequisicoes]);
  finally
   qryRequisicoes.EnableControls;
  end;
end;

