procedure TdtmDefinicaoMontador.AbreConsultaCliente;
begin
 ExisteCliente('nome', '0')
end;

procedure TdtmDefinicaoMontador.AbreTabelaPesquisa(
  TipoPesquisa: TipoProcuraRequisicoes);
begin
  case TipoPesquisa of
   tpRequisicoesFiliaisdeMontagem,
   tpRequisicoesFiliaisdeVenda           :abre(ctConsultaFiliaisdeMontagem);
   tpRequisicoesGrupoFiliaisdeMontagem,
   tpRequisicoesGrupoFiliaisdeVenda      :abre(ctConsultaGrupoFiliaisMontagem);
   tpRequisicoesClientes                 :AbreConsultaCliente;

   tpRequisicoesMontadores,

   tpRequisicoesLerDadosMontadores       :Abre(ctConsultaMontadoresMontagem);

  end

end;

constructor TdtmDefinicaoMontador.Create(AOwner: TComponent);
begin
  inherited;
  qryFilialMontagem.Tag        := ctTabelas;
  qryGrupoFiliaisMontagem.Tag  := ctTabelas;
  qryFilialVenda.Tag           := ctTabelas;
  qryGrupoFiliaisVenda.Tag     := ctTabelas;
  qryCliente.Tag               := ctTabelas;
  qryMontador.tag              := ctTabelas;
  qryMontadorSelecao.tag       := ctTabelas;
  qryConsultaFiliais.Tag       := ctConsultaFiliaisdeMontagem;
  qryConsultaGrupoFiliais.Tag  := ctConsultaGrupoFiliaisMontagem;
  qryConsultaClientes.tag      := ctConsultaClientesMontagem;
  qryConsultaMontador.Tag      := ctConsultaMontadoresMontagem;
  qryMontador.Params[1].AsString := 'U';
  qryMontadorSelecao.Params[1].AsString := 'U';
  qryCliente.Params[1].AsString  := 'C';
  qryRequisicoesItensquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosContratosquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosContratoscancelado.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosDadosFiscaisquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
end;

function TdtmDefinicaoMontador.ExisteCliente(NomeCampo: String;
  Value: Variant): Boolean;
const
  SQL = 'AND (to_ascii(%s,''latin1'') ilike to_ascii(''%s%s'',''latin1''))';

begin

  qryConsultaClientes.Sql[9] := Format(SQL, [NomeCampo, ANSIUpperCase(Value), '%']);

  qryConsultaClientes.Open;

  Result := qryConsultaClientes.RecordCount > 0

end;

function TdtmDefinicaoMontador.ExisteFilial(NomeCampo: String;
  Value: Variant): Boolean;
begin
  Result:=ExisteCodigo(qryConsultaFiliais, Nomecampo, Value);
end;

function TdtmDefinicaoMontador.ExisteGrupoFilial(NomeCampo: String;
  Value: Variant): Boolean;
begin
  Result:=ExisteCodigo(qryConsultaGrupoFiliais, Nomecampo, Value);
end;

function TdtmDefinicaoMontador.ExisteMontador(NomeCampo: String;
  Value: Variant): Boolean;
begin
  Result:=ExisteCodigo(qryConsultaMontador, Nomecampo, Value);
end;

procedure TdtmDefinicaoMontador.FechaTabelaPesquisa(
  TipoPesquisa: TipoProcuraRequisicoes);
begin
  case TipoPesquisa of
   tpRequisicoesFiliaisdeMontagem,
   tpRequisicoesFiliaisdeVenda           :fecha(ctConsultaFiliaisdeMontagem);
   tpRequisicoesGrupoFiliaisdeMontagem,
   tpRequisicoesGrupoFiliaisdeVenda      :fecha(ctConsultaGrupoFiliaisMontagem);
   tpRequisicoesClientes                 :Fecha(ctConsultaClientesMontagem);

   tpRequisicoesMontadores,

   tpRequisicoesLerDadosMontadores       :fecha(ctConsultaMontadoresMontagem);

  end

end;

