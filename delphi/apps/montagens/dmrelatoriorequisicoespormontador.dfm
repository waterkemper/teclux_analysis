  object qryRequisicoes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryRequisicoesCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WherePeriodoAbertura'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WherePeriodoFechamento'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WherePeriodoPagamento'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereCliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereMontador'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereSituacaoMontagem'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereSituacaoPagto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereSituacaoMontagemItens'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereSituacaoPagtoItens'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereOrdenacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'select'
      '   r.filialmontagem,'
      '   f.nome as nomefilialmontagem,'
      '   fgf.grupo as grupofilialmontagem,'
      '   gf.descricao as nomegrupofilialmontagem,'
      '   r.montador,'
      
        '   (select vm.nome from vmontadores vm where vm.codigo=r.montado' +
        'r and vm.tipo=r.tipomontador) as nomemontador,'
      '   r.abertura,'
      '   ri.requisicao, '
      '   n.serie,'
      '   n.numero as notafiscal,'
      '   c.maquina,'
      '   c.intervensao,'
      '   c.numero as cupomfiscal,'
      '   coalesce(vf.razao,vf.nome) as nomecliente,'
      '   ri.produto,'
      
        '   cast(p.descricao||'#39' '#39'||coalesce(p.valorgrade1,'#39#39')||'#39' '#39'||coale' +
        'sce(p.valorgrade2,'#39#39') as varchar)  as descricaoproduto,'
      '   ri.filial,'
      '   ri.quantidade,'
      '   ri.datamontagem,'
      '   ri.valorpagto,'
      '   ri.datapagto,'
      ''
      '   case when coalesce(vf.foneddd,0)<>0 then'
      
        '     cast('#39'('#39' as varchar)||cast(vf.foneddd as varchar)||cast('#39')'#39 +
        ' as varchar)||cast(vf.fonenumero as varchar)'
      '   else'
      '     cast(vf.fonenumero as varchar)'
      '   end as fonenumero_1,'
      ''
      '   case when r.tipocliente='#39'C'#39' then'
      '     case when coalesce(cl.fone2ddd,0)<>0 then'
      
        '       cast('#39'('#39' as varchar)||cast(cl.fone2ddd as varchar)||cast(' +
        #39')'#39' as varchar)||cast(cl.fone2numero as varchar)'
      '     else'
      '       cast(cl.fone2numero as varchar)'
      '     end'
      '   else'
      '     case when coalesce(vf.fonedddempresa,0)<>0 then'
      
        '       cast('#39'('#39' as varchar)||cast(vf.fonedddempresa as varchar)|' +
        '|cast('#39')'#39' as varchar)||cast(vf.fonenumeroempresa as varchar)'
      '     else'
      '       cast(vf.fonenumeroempresa as varchar)'
      '     end'
      '   end as fonenumero_2'
      ''
      
        ' from ((requisicoesitens ri join ((((requisicoes r left join ((d' +
        'adosfiscais df  left join notas n on df.numero=n.dadofiscal)'
      
        '                                                                ' +
        '                                 left join cupons c on df.numero' +
        '=c.dadofiscal)'
      
        '                                                                ' +
        '        on r.dadofiscal=df.numero)'
      
        '                                                               j' +
        'oin vfornecedores vf on r.cliente=vf.codigo and r.tipocliente=vf' +
        '.tipo)'
      
        '                                                               l' +
        'eft join clientes cl on r.cliente = cl.codigo and r.tipocliente ' +
        '= '#39'C'#39')'
      
        '                                                               j' +
        'oin (filiais f left join (filiaisgruposfiliais fgf left join gru' +
        'posfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                                                            on f' +
        '.codigo=fgf.filial)'
      
        '                                                                ' +
        '                    on r.filialmontagem=f.codigo)'
      
        '                                         on ri.requisicao=r.nume' +
        'ro)'
      
        '                                    join produtos p on ri.produt' +
        'o = p.codigo)'
      'where true '
      '         %WherePeriodoAbertura'
      '         %WherePeriodoFechamento'
      '         %WherePeriodoPagamento'
      '         %WhereFiliais'
      '         %WhereCliente'
      '         %WhereMontador'
      '         %WhereSituacaoMontagem'
      '         %WhereSituacaoPagto'
      '         %WhereSituacaoMontagemItens'
      '         %WhereSituacaoPagtoItens'
      '%WhereOrdenacao')
    RequestLive = True
    Left = 280
    Top = 152
