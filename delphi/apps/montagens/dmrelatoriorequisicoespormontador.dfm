    Macros = <>
    Sql.Strings = (
      'Select vf.Codigo,'
      '          vf.tipo,'
      '          coalesce(vf.razao,vf.nome) as nome         '
      'From   vfornecedores vf'
      'where (vf.codigo = :codigo)  and'
      '          (vf.tipo     = :tipocliente) '
      'Order By Codigo, tipo')
