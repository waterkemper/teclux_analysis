  begin
    qryRequisicoes.MacroByName('WhereFiliais').AsString:= ' and (r.filialmontagem in (Select filial From filiaisgruposfiliais Where grupo = ' + Value + '))';
    FParametroCabecalho:=FParametroCabecalho+' Grupo de Filial: '+Value;
