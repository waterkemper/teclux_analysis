package montagensk;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$SONAME 'montagens'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  visualclx,
  repositoriok;

contains
  dmcadastrotabelamontagem in 'dmcadastrotabelamontagem.pas' {dtmCadastroTabelaMontagem: TDataModule},
  fmcadastrotabelamontagem in 'fmcadastrotabelamontagem.pas' {frmCadastroTabelaMontagem},
  rgmontagens in 'rgmontagens.pas',
  dmcadastrorequisicoesmontagens in 'dmcadastrorequisicoesmontagens.pas' {dtmCadastroRequisicoesMontagens: TDataModule},
  fmcadastrorequisicoesmontagens in 'fmcadastrorequisicoesmontagens.pas' {frmCadastroRequisicoesMontagens},
  fmcadastrorequisicoesitensmontagens in 'fmcadastrorequisicoesitensmontagens.pas' {frmcadastrorequisicoesitensmontagens},
  dmgeracaorequisicoesmontagens in 'dmgeracaorequisicoesmontagens.pas' {dtmGeracaoRequisicoesMontagens: TDataModule},
  fmgeracaorequisicoesmontagens in 'fmgeracaorequisicoesmontagens.pas' {frmGeracaoRequisicoesMontagens},
  dmfechamentorequisicoesmontagens in 'dmfechamentorequisicoesmontagens.pas' {dtmFechamentoRequisicoesMontagens: TDataModule},
  fmfechamentorequisicoesmontagens in 'fmfechamentorequisicoesmontagens.pas' {frmFechamentoRequisicoesMontagens},
  fmfechamentorequisicoesitensmontagens in 'fmfechamentorequisicoesitensmontagens.pas' {frmFechamentoRequisicoesItensMontagens},
  fmlerdadosfechamento in 'fmlerdadosfechamento.pas' {frmLerDadosFechamento},
  fmlerdadosgeracao in 'fmlerdadosgeracao.pas' {frmLerDadosGeracao},
  dmquitacaorequisicoesmontagens in 'dmquitacaorequisicoesmontagens.pas' {dtmQuitacaoRequisicoesMontagens: TDataModule},
  fmquitacaorequisicoesmontagens in 'fmquitacaorequisicoesmontagens.pas' {frmQuitacaoRequisicoesMontagens},
  fmlerdadosquitacao in 'fmlerdadosquitacao.pas' {frmLerDadosQuitacao},
  dmdefinicaomontador in 'dmdefinicaomontador.pas' {dtmDefinicaoMontador: TDataModule},
  fmdefinicaomontador in 'fmdefinicaomontador.pas' {frmDefinicaoMontador},
  dmrelatoriorequisicoespormontador in 'dmrelatoriorequisicoespormontador.pas' {dtmRelatorioRequisicoesporMontador: TDataModule},
  fmrelatoriorequisicoespormontador in 'fmrelatoriorequisicoespormontador.pas' {frmRelatorioRequisicoesporMontador},
  dmrelatorioreimpressaorequisicoes in 'dmrelatorioreimpressaorequisicoes.pas' {dtmRelatorioReimpressaoRequisicoes: TDataModule},
  fmrelatorioreimpressaorequisicoes in 'fmrelatorioreimpressaorequisicoes.pas' {frmRelatorioReimpressaoRequisicoes},
  fmlerdadosdefinicaomontador in 'fmlerdadosdefinicaomontador.pas' {frmLerDadosDefinicaoMontador};

end.
