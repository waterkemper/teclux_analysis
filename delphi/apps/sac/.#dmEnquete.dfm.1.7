        'alor('#39'QUESTIONARIO ATUAL'#39',:filialbase))'
      '                and q.disponivel'
      
        '                and (q.data_inativo is null or q.data_inativo >=' +
        ' CURRENT_TIMESTAMP)'
      
        '                and (q.data_inicio <= CURRENT_TIMESTAMP and q.da' +
        'ta_fim >= CURRENT_TIMESTAMP)'
      ''
