  object qryClientes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select vf.codigo,'
      '       vf.tipo,'
      '       vf.nome,'
      '       cast(null as varchar(1000)) as texto,'
      '       cast(null as integer) as respostaunica'
      ''
      'from vfornecedores vf'
      'where vf.codigo = :cliente'
      '  and vf.tipo = :tipocliente'
      ''
      '  and case when vf.tipo = '#39'C'#39' then'
      
        '        (select not coalesce(cl.naoresponderquestionarios,false)' +
        ' from clientes cl where cl.codigo = :cliente)'
      '      else'
      '        true'
      '      end'
      ''
      '  and ((:FormaAbertura = 1) or'
      ''
      
        '      case when coalesce((select coalesce(q.respondermaisdeumave' +
        'z,false) from questionarios q where q.codigo = :questionario),fa' +
        'lse) then'
      ''
      '        not exists'
      '                    ('
      '                        select rc.codigo'
      '                        from respostas_clientes rc'
      '                             join respostas r'
      '                                  join perguntas p'
      '                                  on r.pergunta = p.codigo'
      '                             on rc.resposta = r.codigo'
      '                        where p.questionario = :questionario'
      '                          and rc.cliente = :cliente'
      '                          and rc.tipocliente = :tipocliente'
      '                          and (rc.orcamento = :orcamento or'
      '                               rc.contrato = :contrato or'
      
        '                               rc.orcamento = (select o.codigo f' +
        'rom orcamentos o where o.contrato = :contrato))'
      '                        limit 1'
      '                    )'
      ''
      ''
      '      else'
      ''
      '        not exists'
      '                    ('
      '                        select rc.codigo'
      '                        from respostas_clientes rc'
      '                             join respostas r'
      '                                  join perguntas p'
      '                                  on r.pergunta = p.codigo'
      '                             on rc.resposta = r.codigo'
      '                        where p.questionario = :questionario'
      '                          and rc.cliente = :cliente'
      '                          and rc.tipocliente = :tipocliente'
      '                        limit 1'
      '                    )'
      '      end   )')
    RequestLive = True
    Left = 56
    Top = 32
    ParamData = <
