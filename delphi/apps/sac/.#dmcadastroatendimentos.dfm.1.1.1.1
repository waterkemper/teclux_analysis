    Sql.Strings = (
      ';'
      'select CartaAtendimento.*,'
      '       (select semaviso'
      '        from atendimentos'
      
        '        where codigo = CartaAtendimento.atendimento) as semaviso' +
        ','
      ''
      '       (select semspc'
