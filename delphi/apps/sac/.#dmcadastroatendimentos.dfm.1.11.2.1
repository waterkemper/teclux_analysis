      '       coalesce((select true'
      '                 from cartasclientes cc'
      
        '                 where cc.atendimento = a.codigo limit 1),false)' +
        ' as PossuiCartaAtendimento,'
      '       a.datainclusao,'
      '       a.naoligar,'
      '       a.origem,'
      
        '       (select count(*) from atendimentos a2 where a2.origem = a' +
        '.codigo) as Followups,'
      '       a.assunto,'
      '       a.status,'
      '       a.contrato,'
      '       a.produto,'
      '       a.filial,'
      '       a.orcamento,'
      '       (select a2.lembrar'
      '        from atendimentos a2'
      '        where a2.lembrar > current_date'
      
        '          and coalesce(a2.origem,a2.codigo) = coalesce(a.origem,' +
        'a.codigo) order by a2.lembrar limit 1) as ProximoLembrar'
      ''
      'from atendimentos a'
      'Where a.codigo =:codigo')
