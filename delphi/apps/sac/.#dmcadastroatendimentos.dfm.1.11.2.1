      '       a.tipocliente,'
      '       a.data,'
      '/*       a.informes,*/'
      '       a.lembrar,'
      '       a.lembrarhora,'
      '       a.semaviso,'
      '       a.semspc,'
      '       a.concluido,'
      '       a.tipo,'
      '       a.tipoatendimento,'
