    Constraints = <>
    OnCalcFields = qryocorrenciasCalcFields
    OnFilterRecord = qryocorrenciasFilterRecord
    Filtered = True
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select selecao.*,'
      ''
      '       case when origem is null then'
      '         case when (qtAtendimentos > 1) then'
      '           cast('#39'+'#39' as char(1)) '
      '         else'
      '           cast(null as char(1))'
      '         end'
      '       else'
      '         cast('#39'-'#39' as char(1))'
      '       end as Expandir'
      'from'
      '('
      '  Select a.origem,'
      '         a.codigo,'
      '         a.data,'
      ''
      '         case when a.origem is null then'
      
        '           (select max(a2.data) from atendimentos a2 where coale' +
        'sce(a2.origem, a2.codigo) = coalesce(a.origem,a.codigo))'
      '         else'
      '           cast(null as date)'
      '         end as UltimoAtendimento,'
      ''
      
        '         (select max(a2.data) from atendimentos a2 where coalesc' +
        'e(a2.origem, a2.codigo) = coalesce(a.origem,a.codigo)) as Ultimo' +
        'AtendimentoAux,'
      ''
      '         case when a.origem is null then'
      
        '           (select min(a2.lembrar) from atendimentos a2 where co' +
        'alesce(a2.origem,a2.codigo) = coalesce(a.origem,a.codigo) and a2' +
        '.lembrar >= current_date) '
      '         else'
      '           a.lembrar'
      '         end as lembrar,'
      ''
      '         a.informes,'
      '         a.tipo,'
      
        '        (select ta.descricao from tiposatendimentos ta where ta.' +
        'codigo = a.tipoatendimento) as descricaotipo,'
      '         a.assunto,'
      '         a.usuario,'
      
        '         (select u.nome from usuarios u where u.codigo = a.usuar' +
        'io) as nomeusuario,'
      '         a.datainclusao,'
      '         a.lembrarhora,'
      '         case when a.origem is null then'
      
        '           (select count(*) from atendimentos a2 where coalesce(' +
        'a2.origem, a2.codigo) = coalesce(a.origem,a.codigo))'
      '         else'
      '           cast(null as integer)'
      '         end as qtAtendimentos,'
      ''
      
        '         /*case when a.origem is null then a.status else cast(nu' +
        'll as char(1)) end as*/ a.status'
      ''
      '  From   atendimentos a'
      '  Where (a.cliente =:cliente) and'
      '        (a.tipocliente =:tipocliente)'
      
        '  order by coalesce(a.origem, a.codigo+1) desc, a.datainclusao d' +
        'esc'
      ''
      ') as selecao'
      '')
