  object qryConsultaAtendimentos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'CondicaoAtendimentos'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select c.nome,'
      '       a.assunto,'
      '       a.data,'
      ''
      '       case when a.origem is null then'
      
        '         (select max(a2.data) from atendimentos a2 where coalesc' +
        'e(a2.origem, a2.codigo) = coalesce(a.origem,a.codigo))'
      '       else'
      '         cast(null as date)'
      '       end as UltimoAtendimento,'
      ''
      
        '       case when a.status = '#39'A'#39' then cast('#39'A - Aberto'#39' as varcha' +
        'r(11))'
      
        '            when a.status = '#39'F'#39' then cast('#39'F - Fechado'#39' as varch' +
        'ar(11))'
      '       else'
      '        cast(null as varchar(11))'
      '       end as status,'
      ''
      '       a.codigo,'
      '       a.cliente,'
      '       a.tipocliente'
      ''
      'From   atendimentos a'
      '       join vfornecedores c on'
      '       a.cliente = c.codigo  and a.tipocliente = c.tipo'
      ''
      'Where a.cliente = c.codigo'
      '  and a.tipocliente = c.tipo'
      '  and a.origem is null'
      ''
      '%CondicaoAtendimentos'
      ''
      'Order By UPPER(TO_ASCII(c.nome,'#39'LATIN1'#39')), a.data desc, a.tipo')
    RequestLive = False
    Left = 440
    Top = 16
