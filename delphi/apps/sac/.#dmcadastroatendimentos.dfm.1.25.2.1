        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Status'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select a.codigo,'
      '       a.cliente,'
      '       a.tipocliente,'
      '       a.data,'
      '/*       a.informes,*/ '
      '       retirabrancoepipeeascii(a.informes) as informesexcel,'
      '       a.informes,'
      '       a.lembrar,'
      '       a.lembrarhora,'
      '       a.semaviso,'
      '       a.semspc,'
      '       a.concluido,'
      '       a.tipo,'
      ''
      
        '       case when a.tipo = '#39'C'#39' then cast('#39'COBRAN'#199'A'#39' as varchar(10' +
        '))'
      
        '            when a.tipo = '#39'R'#39' then cast('#39'RECLAMA'#199#195'O'#39' as varchar(' +
        '10))'
      
        '            when a.tipo = '#39'V'#39' then cast('#39'CONTATO'#39' as varchar(10)' +
        ')'
      
        '            when a.tipo = '#39'O'#39' then cast('#39'OR'#199'AMENTO'#39' as varchar(1' +
        '0))'
      '       end as descricaotipo,'
      ''
      '       a.tipoatendimento,'
      ''
      '       (select ta.descricao'
      '        from tiposatendimentos ta'
      
        '        where ta.codigo = a.tipoatendimento) as descricaotipoate' +
        'ndimento,'
      ''
      '       a.usuario,'
      
        '       (select u.nome from usuarios u where u.codigo = a.usuario' +
        ') as nomeusuario,'
      '       a.usuariologado,'
      
        '       (select u.nome from usuarios u where u.codigo = a.usuario' +
        'logado) as nomeusuariologado,'
      '       coalesce((select true'
      '                 from cartasclientes cc'
      
        '                 where cc.atendimento = a.codigo limit 1),false)' +
        ' as PossuiCartaAtendimento,'
      '       a.datainclusao,'
      '       a.naoligar,'
      '       coalesce(a.origem,a.codigo) as origem,'
      
        '       (select count(*) from atendimentos a2 where a2.origem = a' +
        '.codigo) as Followups,'
      '       a.assunto,'
      '       a.status,'
      '       a.contrato,'
      '       a.produto,'
      '       a.filial,'
      '       a.orcamento,'
      ''
      '       cast((select case when o.situacao = '#39'A'#39' then '#39'ABERTO'#39
      '                         when o.situacao = '#39'C'#39' then '#39'CANCELADO'#39
      '                         when o.situacao = '#39'P'#39' then '#39'PARCIAL'#39
      '                         when o.situacao = '#39'T'#39' then '#39'CONTRATO'#39
      '                end'
      '        from (select o.situacao'
      '              from orcamentos o'
      '              where o.codigo = a.orcamento) as o'
      '        ) as varchar(20)) as descricaosituacaoorcamento,'
      ''
      
        '       (select m.descricao from motivos m where m.codigo = (sele' +
        'ct o.motivo from orcamentos o where o.codigo = a.orcamento)) as ' +
        'descricaomotivo,'
      ''
      '       cast((select case when c.situacao = '#39'O'#39' then '#39'OR'#199'ADO'#39
      '                        when c.situacao = '#39'R'#39' then '#39'RESERVADO'#39
      '                        when c.situacao = '#39'F'#39' then '#39'FATURADO'#39
      
        '                        when c.situacao = '#39'P'#39' then '#39'NOTA PARCIAL' +
        #39
      '                        when c.situacao = '#39'N'#39' then '#39'NOTA FISCAL'#39
      '                        when c.situacao = '#39'C'#39' then '#39'CANCELADO'#39
      '                end'
      '        from (select c.situacao'
      '              from contratos c'
      '              where c.numero = a.contrato) as c'
      '        ) as varchar(20)) as descricaosituacaocontrato,'
      ''
      '        (select contrato_atual(a.contrato)) as contrato_atual,'
      ''
      
        '       (select a2.data from atendimentos a2 where a2.codigo = co' +
        'alesce(a.origem,a.codigo)) as dataorigem,'
      '       a.status as statusaux,'
      ''
      '       vf.nome as nomecliente'
      ''
      'from atendimentos a'
      '     join vfornecedores vf'
      '     on a.cliente = vf.codigo'
      '     and a.tipocliente = vf.tipo'
      ''
      ''
      'Where coalesce(a.origem,a.codigo) in'
      ''
      '('
      ' select coalesce(a.origem,a.codigo) as atendimento'
      ' from atendimentos a'
      '      join vfornecedores vf'
      '      on a.cliente = vf.codigo'
      '      and a.tipocliente = vf.tipo'
      ' where true'
      '/* and coalesce(a.origem,a.codigo) = 3729*/'
      ' %ListadeClientes'
      ' %ListadeUsuariosCadastrantes'
      ' %IntervaloDataCadastro'
      ' %IntervaloDataLembrar'
      ' %TiposdeAtendimentos'
      ' %Status'
      ')'
      ''
      'order by a.codigo'
      ''
      ''
      '/*'
      ''
      ':DataInicialCadastro'
      ':DataFinalCadastro'
      ':DataInicialLembrar'
      ':DataFinalLembrar'
      ''
      '*/')
    RequestLive = False
    Left = 680
    Top = 136
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'DataInicialCadastro'
        ParamType = ptUnknown
      end
      item
