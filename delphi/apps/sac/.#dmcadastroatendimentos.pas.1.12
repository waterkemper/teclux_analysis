    qryConsultaClientesnome: TStringField;
    qryConsultaClientespessoanumero: TStringField;
    qryConsultaClientescodigo: TIntegerField;
    qryExisteAtendimento: TtecQuery;
    qryExisteAtendimentocodigo: TIntegerField;
    qryUltimaReclamacao: TtecQuery;
    qryUltimaReclamacaoinformes: TStringField;
    dsrUltimaReclamacao: TtecDataSource;
    qryProcuraClientestipo: TStringField;
    qryConsultaClientestipo: TStringField;
    qryConsultaClientestipocliente: TStringField;
    qryConsultaClientesestado: TStringField;
    qryConsultaClientesnomecidade: TStringField;
    qryConsultaAtendimentos: TtecQuery;
    qryConsultaAtendimentoscodigo: TIntegerField;
    qryConsultaAtendimentoscliente: TIntegerField;
    qryConsultaAtendimentosdata: TDateField;
    qryConsultaAtendimentostipo: TStringField;
    qryConsultaAtendimentosnome: TStringField;
    qryConsultaAtendimentostipocliente: TStringField;
    qryAtendimentoscodigo: TIntegerField;
    qryAtendimentoscliente: TIntegerField;
    qryAtendimentostipocliente: TStringField;
    qryAtendimentosdata: TDateField;
    qryAtendimentosinformes: TStringField;
    qryAtendimentoslembrar: TDateField;
    qryAtendimentossemaviso: TDateField;
    qryAtendimentossemspc: TDateField;
