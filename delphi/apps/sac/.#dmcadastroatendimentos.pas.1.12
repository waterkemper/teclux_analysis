    qryocorrenciaslembrar: TDateField;
    qryocorrenciasinformes: TStringField;
    qryocorrenciastipo: TStringField;
    qryocorrenciasdescricaotipo: TStringField;
    dsrOcorrencias: TtecDataSource;
    qryAtendimentosnaoligar: TBooleanField;
    qryAtualzarClientes: TtecQuery;
    qryAtendimentosusuariologado: TIntegerField;
