    function  GravarAtendimentos: Boolean;
    function  IncluirAtendimentos: Boolean; overload;
    function  IncluirAtendimentos(Valores: Array of Variant): Boolean; overload;
    procedure ListarInformes(Inf: TStringList; {Tipo: TtecTipoAtendimento;} MostrarAtendimento: Boolean);
    procedure Selecionar(TipoConsulta: TtecTipoConsultaAtendimento);
    procedure SelecionarAtendimento;
    procedure ValidarTipoAtendimento;
