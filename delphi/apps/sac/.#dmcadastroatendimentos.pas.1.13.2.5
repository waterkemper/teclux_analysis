procedure TdtmCadastroAtendimentos.ListarInformes(Inf: TRichEdit;
  MostrarAtendimento: Boolean);
var
  Pos: TBookmark;
  vFiltroOcorrenciaAnterior : tFiltroOcorrencia;
  vCodigo : integer;
begin
  vFiltroOcorrenciaAnterior := FiltroOcorrencia;

  if qryocorrencias.recordcount<>0 then
  begin
    vcodigo := qryocorrenciascodigo.asinteger;
    if MostrarAtendimento then
      ReFazConsulta(qryAtendimentos,[0],[qryocorrenciascodigo.AsInteger]);

//  qryProcuraClientes.AfterOpen:= Nil;

    FiltroOcorrencia := Atual;
    ListandoInformes := true;
    MontarInformesAtendimentos(Inf, qryocorrencias);

    FiltroOcorrencia := vFiltroOcorrenciaAnterior;
//    PosicionarOcorrencias;
    ListandoInformes := false;

//  qryProcuraClientes.AfterOpen:= qryProcuraClientesAfterOpen;

   qryocorrencias.refresh;
   qryocorrencias.first;
   qryocorrencias.locate('codigo',vcodigo,[]);

  end;
end;

procedure TdtmCadastroAtendimentos.qryocorrenciasFilterRecord(
  DataSet: TDataSet; var Accept: Boolean);
begin
  inherited;
  case FiltroOcorrencia of
    Todos : Accept := qryocorrenciasorigem.isnull or (vListaOcorrenciasSelecionadas.IndexOf(origemocorrencia)<>-1);
    Atual : Accept := origemocorrencia = origem;
  end;
end;

procedure TdtmCadastroAtendimentos.PosicionarOcorrencias;
begin
  qryOcorrencias.first;
  if not qryOcorrencias.locate('codigo',qryatendimentoscodigo.asinteger,[]) then
    qryOcorrencias.locate('codigo',qryatendimentosorigem.asinteger,[])
{
  case FiltroOcorrencia of
    Todos : begin
              if qryatendimentosorigem.isnull then
                qryocorrencias.locate
                Accept := qryocorrenciasorigem.isnull or (qryocorrenciasorigem.asinteger = qryatendimentoscodigo.asinteger)
              else
                Accept := qryocorrenciasorigem.isnull or (qryocorrenciasorigem.asinteger = qryatendimentosorigem.asinteger);
            end;
    Atual:  begin
              if qryatendimentosorigem.isnull then
                Accept := (qryocorrenciascodigo.asinteger = qryatendimentoscodigo.asinteger) or (qryocorrenciasorigem.asinteger = qryatendimentoscodigo.asinteger)
              else
                Accept := (qryocorrenciascodigo.asinteger = qryatendimentosorigem.asinteger) or (qryocorrenciasorigem.asinteger = qryatendimentosorigem.asinteger);
            end;
    SoOrigem : Accept := qryocorrenciasorigem.isnull;
  end;
  }
end;

procedure TdtmCadastroAtendimentos.FiltrarOcorrencias(tecla: String);
var
vCodigo : integer;
begin
   if (tecla = '+') or ((qryOcorrenciasexpandir.AsString='+') and (tecla='')) then
   begin
     vCodigo := qryOcorrenciascodigo.asinteger;
     vListaOcorrenciasSelecionadas.Append(OrigemOcorrencia);
   end
   else
   if (tecla = '-') or ((qryOcorrenciasexpandir.AsString='-') and (tecla='')) then
   begin
     vCodigo := qryOcorrenciasorigem.asinteger;
     vListaOcorrenciasSelecionadas.Delete(vListaOcorrenciasSelecionadas.IndexOf(OrigemOcorrencia));
   end;
   qryocorrencias.refresh;
   qryocorrencias.first;
   qryocorrencias.locate('codigo',vcodigo,[]);

end;


procedure TdtmCadastroAtendimentos.editarAtendimentos;
begin
  if not (qryatendimentos.state in [dsedit, dsinsert]) then
    qryAtendimentos.edit;
end;

function TdtmCadastroAtendimentos.GeteH_Follow_up: boolean;
begin
  result := not qryatendimentosorigem.isnull or (qryAtendimentosfollowups.asinteger <> 0) or not qryAtendimentosorcamento.isnull;
end;

function IncluirAtendimento__(Documento: Variant; TipoAtendimento_: TTecTipoCadastroAtendimento): boolean;
 var
   dtmcadastroatendimentos2 : Tdtmcadastroatendimentos;
begin
  result := false;
  dtmcadastroatendimentos2 := Tdtmcadastroatendimentos.Create(dtmcadastroatendimentos2);
  try
    with dtmcadastroatendimentos2 do
    begin
      case TipoAtendimento_ of
        CancelamentoOrcamento :
        begin
          ReFazConsulta(qryExisteAtendimento,[0,1,2,3,4], [null,null,'O',false,Documento]);
          if not qryExisteAtendimento.isempty then
          begin
            selecionarAtendimento;
            IncluirAtendimentos(true, true);
            result := GravarAtendimentos('Fechamento orçamento '+vartostr(documento));
          end
          else
            result := true;
        end;
        OrcamentoParaContrato :
        begin
          ReFazConsulta(qryExisteAtendimento,[0,1,2,3,4], [null,null,'O',false,Documento]);
          if not qryExisteAtendimento.isempty then
          begin
            selecionarAtendimento;
            IncluirAtendimentos(true, true);
            result := GravarAtendimentos('Orçamento ' + vartostr(documento) + ' fechado para contrato');
          end
          else
            result := true;
        end;
      end;
    end;
  finally
     dtmcadastroatendimentos2.free;
     dtmcadastroatendimentos2 := nil;
  end;
end;

function TdtmCadastroAtendimentos.VerificarDataLembrar: boolean;
begin
  qryExisteAtendimento2.macrobyname('Condicao').asString :=
  '(codigo <> '+inttostr(qryatendimentoscodigo.asinteger) + ' and origem = ' + origem + ' and cast(lembrar||'' ''||lembrarhora as timestamp) > cast('''+ formatDatetime('yyyy-mm-dd',qryAtendimentosLembrar.asDatetime)+' '+formatdatetime('hh:MM:ss',qryAtendimentosLembrarhora.asDateTime)+''' as timestamp))';
  qryExisteAtendimento2.close;
  qryExisteAtendimento2.open;
  result := qryExisteAtendimento2.recordcount>0;
end;

function TdtmCadastroAtendimentos.GetOrigem: String;
begin
  if qryatendimentosorigem.isnull then
    result := inttostr(qryAtendimentosCodigo.asInteger)
  else
    result := inttostr(qryatendimentosorigem.asInteger);
end;

function TdtmCadastroAtendimentos.GetOrigemOcorrencia: String;
begin
  if qryocorrenciasorigem.isnull then
    result := inttoStr(qryocorrenciascodigo.asInteger)
  else
    result := inttostr(qryocorrenciasorigem.asInteger);
end;

initialization
  IncluirAtendimento_ := IncluirAtendimento__;

end.


