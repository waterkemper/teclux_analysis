procedure TdtmCadastroAtendimentos.frxAtendimentos_GetValue(
  const VarName: String; var Value: Variant);
begin
  inherited;
  if VarName = 'TITULO' then
    Value :=  'REGISTRO DE ATENDIMENTOS'
  else if VarName = 'RAZAOFILIALBASE' then
    Value := RazaoFilialBase
  else if VarName = 'ENDERECO_BAIRRO' then
    Value :=  RuaFilialBase+ ' - '+BairroFilialBase
  else if VarName = 'CEP_CIDADE_UF' then
    Value :=  FormatarCEP(CEPFilialBase)+'  '+CidadeFilialBase+ '  '+ EstadoFilialBase
  else if VarName = 'PARAMETROS' then
    Value := ParametrosCabecalho
  else if VarName = 'CordoZebrado' then
    Value :=  strtoint(parsistema.CorZebradoRelatorio)
end;

procedure TdtmCadastroAtendimentos.TrocarUsuarioAtendimento;
var
  UsrAut: TtecUsuarios;
  vRetornoMensagem: TModalResult;
begin
  vRetornoMensagem := MensagemSimNaoOpcaoCancelar('Trocar o usuário responsável pelo atendimento','Seleção Manual',true, 'Todos em Aberto', 'Somente o Atual',
      (qryAtendimentosstatus.asString = 'A'), true, true);

  case vRetornoMensagem of

    mrYes, mrNo :
    begin
      UsrAut := ObterAutorizacao(taLOGIN, 'Atendimentos', 'Troca do usuário responsável', '');
      if Assigned(UsrAut) then
      begin

        if (qryAtendimentosusuario.asinteger <> UsrAut.CodigoUsuario) then
        begin
          qryAtualizarAtendimentosUsuario.parambyname('usuario').asInteger := UsrAut.CodigoUsuario;
          if vRetornoMensagem = mrYes then
            qryAtualizarAtendimentosUsuario.macrobyname('codigo').asString := 'select codigo from atendimentos where status=''A'' and usuario = '+qryAtendimentosusuario.asString
          else
            qryAtualizarAtendimentosUsuario.macrobyname('codigo').asString := 'select codigo from atendimentos where (codigo='+ qryAtendimentoscodigo.asString + ' or origem='+qryAtendimentoscodigo.AsString+') or origem=(select origem from atendimentos where codigo='+qryAtendimentoscodigo.asString+')';

          qryAtualizarAtendimentosUsuario.execSQL;

          perpetrar([]);

          qryAtendimentos.edit;
          qryAtendimentosusuario.asinteger := UsrAut.CodigoUsuario;
          qryAtendimentosnomeusuario.asString := UsrAut.NomeUsuario;
          qryAtendimentos.post;
        end;

      end;
    end;

    mrOk : AbrirJanelaSelecao(false);

  end;

end;


procedure TdtmCadastroAtendimentos.VerificarMensagemAlertaClientes;

  function ExisteOutroAtendimentoParaAssumirLigacao: boolean;
  begin
    RefazConsultaPorNome(qryPesquisaAtendimento, ['cliente','tipocliente', 'AtendimentoAtual', 'origem'],
                          [qryAtendimentoscliente.asInteger,
                           qryAtendimentostipocliente.asString,
                           qryAtendimentoscodigo.asInteger,
                           qryAtendimentosorigem.asInteger]);

    result := qryPesquisaAtendimento.recordcount = 1;
  end;

begin

  if qryAtendimentostipocliente.asString = 'C' then
    qryClientes.sql.text := qryClientes_C.sql.text
  else
  if qryAtendimentostipocliente.asString = 'F' then
    qryClientes.sql.text := qryClientes_F.sql.text
  else
  if qryAtendimentostipocliente.asString = 'L' then
    qryClientes.sql.text := qryClientes_L.sql.text;

  RefazConsultaPorNome(qryClientes, ['codigo'], [qryAtendimentoscliente.asInteger]);

  if qryAtendimentos.State = dsInsert then
  begin

    if qryAtendimentosnaoligar.AsBoolean and (qryAtendimentostipocliente.AsString='C') and (qryClientes.recordcount = 1) then
    begin
      qryClientes.edit;
      qryClientesnaoligar.asboolean := true;
      qryClientesrazaonaoligar.asString := qryAtendimentosTextinformes.AsString;
      qryClientes.post;
    end;
  end;

  (*

  {ligando Atend. Cliente Desligado com atendimento (foi desligado no cadastro de cliente) ou sem atendimento}
  if ((qryAtendimentosfichaalerta.asstring <> '') and (qryatendimentosstatus.asString = 'A')) and
     {não marcado}
     ((qryClientesfichaalerta.asString = '') or
      {marcado mas sem atendimento}
     ((qryClientesfichaalerta.asstring<>'') and qryClientesatendimentogeroufichaalerta.isnull)) then
  begin
    if MensagemConfirmacao('Confirma atualizar a mensagem de alerta no cadastro de clientes atribuido por este atendimento ?') = smbOk then
    begin
      qryClientes.edit;
      qryClientesfichaalerta.asString := qryAtendimentosfichaalerta.asString;
      qryClientesatendimentogeroufichaalerta.asinteger :=  qryAtendimentoscodigo.AsInteger;
      qryClientes.post;
    end;
  end
  else
  {desligando Atend. Cliente ligado e atendimento igual ao selecionado}

  if ((qryAtendimentosfichaalerta.asstring='') or (qryatendimentosstatus.asString = 'F')) and
     (qryClientesfichaalerta.asstring<>'') and
     ((qryClientesatendimentogeroufichaalerta.asinteger = qryAtendimentoscodigo.AsInteger) or
      ((qryClientesorigematendimentogeroufichaalerta.asinteger = qryAtendimentosorigem.AsInteger) AND (qryAtendimentosorigem.asInteger <> 0))) then
  begin
    {deligando Atend. porém existe outro atendimento ligando.... então ligar e relacionar}
    if ExisteOutroAtendimentoParaAssumirLigacao then
    begin

      qryClientes.edit;
      qryClientesfichaalerta.asString := qryPesquisaAtendimentofichaalerta.asString;
      qryClientesatendimentogeroufichaalerta.asinteger := qryPesquisaAtendimentocodigo.asinteger;
      qryClientes.post;

      if (qryClientesfichaalerta.asString <> '') and (qryAtendimentosfichaalerta.asString = '') then {desmarcou}
         MensagemAviso(format('A mesnagem de alerta continuará ativa e será atualizada pelo atendimento %s ?', [qryPesquisaAtendimentocodigo.asString]));
    end
    else
    begin
      qryClientes.edit;
      qryClientesfichaalerta.clear;
      qryClientesatendimentogeroufichaalerta.clear;
      qryClientes.post;
    end;
  end;
  *)

  if qryAtendimentosorigem.asInteger<>0 then
    qryAtualizarAtendimentosVisualizarFicha.parambyname('origem').asInteger := qryAtendimentosorigem.asInteger
  else
    qryAtualizarAtendimentosVisualizarFicha.parambyname('origem').asInteger := qryAtendimentoscodigo.asInteger;

  qryAtualizarAtendimentosVisualizarFicha.parambyname('FichaAlerta').asString := qryAtendimentosfichaalerta.asString;
  qryAtualizarAtendimentosVisualizarFicha.ExecSql;

end;

