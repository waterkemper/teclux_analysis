  DataSet: TDataSet);
begin
  inherited;
  if not qryAtendimentos_contrato.isnull then
    qryAtendimentos_contratodescricao.asString := qryAtendimentos_contrato.asString + ' - ' + qryAtendimentos_descricaosituacaocontrato.asString
  else
    qryAtendimentos_contratodescricao.clear;

  if not qryAtendimentos_orcamento.isnull then
    qryAtendimentos_orcamentodescricao.asString := qryAtendimentos_orcamento.asString + ' - ' + qryAtendimentos_descricaosituacaoorcamento.asString
  else
