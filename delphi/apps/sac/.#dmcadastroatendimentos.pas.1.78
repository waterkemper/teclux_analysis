function TdtmCadastroAtendimentos.GerarMultiplosRegistroAtendimentos(ListaCondicional_Cliente,
                                  ListaCondicional_Usuario,
                                  ListaCondicional_GruposUsuarios,
                                  ListaTiposAtendimentos: String;
                                  Cobranca, Contato, Orcamento, Reclamacao : boolean;
                                  Aberto, Fechado : boolean;
                                  DataInicialCadastro, DataFinalCadastro,
                                  DataInicialLembrar, DataFinalLembrar: String): boolean;
var
  vTipoAtendimento, vStatus : String;
                                  
begin
  ParametrosCabecalho := '';

  if ListaCondicional_Cliente<>'' then
  begin
    qryAtendimentos_.macrobyName('ListadeClientes').asString := 'and ('+ListaCondicional_Cliente+')';
    ParametrosCabecalho := ParametrosCabecalho + ' Clientes :'+ListaCondicional_Cliente;
  end
  else
    qryAtendimentos_.macrobyName('ListadeClientes').asString := '';


  if ListaCondicional_Usuario<>'' then
  begin
    qryAtendimentos_.macrobyName('ListadeUsuariosCadastrantes').asString := 'and ('+ListaCondicional_Usuario+')';
    ParametrosCabecalho := ParametrosCabecalho + ' Atendentes :'+ListaCondicional_Usuario;
  end
  else
    qryAtendimentos_.macrobyName('ListadeUsuariosCadastrantes').asString := '';

  if ListaCondicional_GruposUsuarios<>'' then
  begin
    qryAtendimentos_.macrobyName('ListadeGruposUsuariosCadastrantes').asString := 'and ('+ListaCondicional_GruposUsuarios+')';
    ParametrosCabecalho := ParametrosCabecalho + ' Grupos Atendentes :'+ListaCondicional_GruposUsuarios;
  end
  else
    qryAtendimentos_.macrobyName('ListadeGruposUsuariosCadastrantes').asString := '';


  if ListaTiposAtendimentos<>'' then
  begin
    qryAtendimentos_.macrobyName('ListaTiposAtendimentos').asString := 'and a.tipoatendimento in ('+ListaTiposAtendimentos+')';
    ParametrosCabecalho := ParametrosCabecalho + ' Tipo de Atendimento :'+ListaTiposAtendimentos;
  end
  else
    qryAtendimentos_.macrobyName('ListaTiposAtendimentos').asString := '';


  vTipoAtendimento := '';
  if Cobranca then
    vTipoAtendimento := '''C''';

  if Contato then
  begin
    if vTipoAtendimento <> '' then
      vTipoAtendimento := vTipoAtendimento + ',';

    vTipoAtendimento := vTipoAtendimento + '''V''';
  end;

  if Orcamento then
  begin
    if vTipoAtendimento <> '' then
      vTipoAtendimento := vTipoAtendimento + ',';

    vTipoAtendimento := vTipoAtendimento + '''O''';
  end;

  if Reclamacao then
  begin
    if vTipoAtendimento <> '' then
      vTipoAtendimento := vTipoAtendimento + ',';

    vTipoAtendimento := vTipoAtendimento + '''R''';
  end;

  if vTipoAtendimento<>'' then
  begin
    qryAtendimentos_.macrobyName('TiposdeAtendimentos').asString := 'and a.tipo in ('+vTipoAtendimento+')';
    ParametrosCabecalho := ParametrosCabecalho + ' Tipo Atendimento :'+vTipoAtendimento;
  end
  else
    qryAtendimentos_.macrobyName('TiposdeAtendimentos').asString := '';


  vStatus := '';
  if Aberto then
    vStatus := '''A''';

  if Fechado then
  begin
    if vstatus<>'' then
      vStatus := vStatus + ',';

    vStatus := vStatus + '''F''';
  end;

  if vStatus<>'' then
  begin
    qryAtendimentos_.macrobyName('Status').asString := 'and a.status in ('+vStatus+')';
    ParametrosCabecalho := ParametrosCabecalho + ' Status :'+vStatus;
  end
  else
    qryAtendimentos_.macrobyName('Status').asString := '';

  if (trim(DataInicialCadastro) <> '/  /') and (trim(DataFinalCadastro) <> '/  /') then
  begin
    qryAtendimentos_.parambyname('DataInicialCadastro').asDateTime := strtodatetime(DataInicialCadastro);
    qryAtendimentos_.parambyname('DataFinalCadastro').asDateTime := strtodatetime(DataFinalCadastro);
    qryAtendimentos_.macrobyName('IntervaloDataCadastro').asString :=  ' and a.data between :DataInicialCadastro and :DataFinalCadastro ';
    ParametrosCabecalho := ParametrosCabecalho + ' Data do Cadastro entre '+DataInicialCadastro+' e '+DataFinalCadastro;
  end
  else
  if (trim(DataInicialCadastro) <> '/  /') and (trim(DataFinalCadastro) = '/  /') then
  begin
    qryAtendimentos_.parambyname('DataInicialCadastro').asDateTime := strtodatetime(DataInicialCadastro);
    qryAtendimentos_.macrobyName('IntervaloDataCadastro').asString :=  ' and a.data >= :DataInicialCadastro ';
    ParametrosCabecalho := ParametrosCabecalho + ' Data do Cadastro maior ou igual a '+DataInicialCadastro;
  end
  else
  if (trim(DataInicialCadastro) = '/  /') and (trim(DataFinalCadastro) <> '/  /') then
  begin
    qryAtendimentos_.parambyname('DataFinalCadastro').asDateTime := strtodatetime(DataFinalCadastro);
    qryAtendimentos_.macrobyName('IntervaloDataCadastro').asString :=  ' and a.data <= :DataFinalCadastro ';
    ParametrosCabecalho := ParametrosCabecalho + ' Data do Cadastro menor ou igual a '+DataFinalCadastro;
  end
  else
    qryAtendimentos_.macrobyName('IntervaloDataCadastro').asString := '';


  if (trim(DataInicialLembrar) <> '/  /') and (trim(DataFinalLembrar) <> '/  /') then
  begin
    qryAtendimentos_.parambyname('DataInicialLembrar').asDateTime := strtodatetime(DataInicialLembrar);
    qryAtendimentos_.parambyname('DataFinalLembrar').asDateTime := strtodatetime(DataFinalLembrar);
    qryAtendimentos_.macrobyName('IntervaloDataLembrar').asString :=  ' and a.lembrar between :DataInicialLembrar and :DataFinalLembrar ';
    ParametrosCabecalho := ParametrosCabecalho + ' Data do Lembrar entre '+DataInicialLembrar+' e '+DataFinalLembrar;
  end
  else
  if (trim(DataInicialLembrar) <> '/  /') and (trim(DataFinalLembrar) = '/  /') then
  begin
    qryAtendimentos_.parambyname('DataInicialLembrar').asDateTime := strtodatetime(DataInicialLembrar);
    qryAtendimentos_.macrobyName('IntervaloDataLembrar').asString :=  ' and a.lembrar >= :DataInicialLembrar ';
    ParametrosCabecalho := ParametrosCabecalho + ' Data do Lembrar maior ou igual a '+DataInicialLembrar;
  end
  else
  if (trim(DataInicialLembrar) = '/  /') and (trim(DataFinalLembrar) <> '/  /') then
  begin
    qryAtendimentos_.parambyname('DataFinalLembrar').asDateTime := strtodatetime(DataFinalLembrar);
    qryAtendimentos_.macrobyName('IntervaloDataLembrar').asString :=  ' and a.lembrar <= :DataFinalLembrar ';
    ParametrosCabecalho := ParametrosCabecalho + ' Data do Lembrar menor ou igual a '+DataFinalLembrar;
  end
  else
    qryAtendimentos_.macrobyName('IntervaloDataLembrar').asString := '';


  qryAtendimentos_.close;
  qryAtendimentos_.open;

  result := qryAtendimentos_.recordcount <> 0;

  if not result then
    MensagemAviso('A consulta não retornou nenhum registro.')

end;

