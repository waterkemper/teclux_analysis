function TdtmCadastroAtendimentos.TrocarUsuarioManualmente(usuario, nomeusuario: String): boolean;
var
  UsrAut: TtecUsuarios;
  vRetornoMensagem: TMessageButton;
  vListaAtendimentos : String;
begin
  result := false;
  vRetornoMensagem := Mensagemselecionaopcao(format('Trocar os atendimentos selecionados para o usuário %s?',[usuario + ' - ' + nomeusuario]));

  case vRetornoMensagem of

    smbYes:
    begin

      UsrAut := ObterAutorizacao(taLOGIN, 'Gerente de Vendas', 'Troca do usuário responsável', '');
      if Assigned(UsrAut) then
      begin

        if usrAut.gerentevendas then
        begin
          vLIstaAtendimentos := RetornarLista(qryAtendimentos_, qryAtendimentos_codigo);
          qryAtualizarAtendimentosUsuario.parambyname('usuario').asString := usuario;
          qryAtualizarAtendimentosUsuario.macrobyname('codigo').asString := vLIstaAtendimentos;
          qryAtualizarAtendimentosUsuario.execSQL;
          result := perpetrar([]);
        end
        else
        begin
          result := false;
          mensagemaviso('Usuário não possui autorização de ''Gerente de Vendas''');
        end;

      end;
    end;

  end;

end;

initialization
  IncluirAtendimento_ := IncluirAtendimento__;
  EncerrarDataModule2_ := EncerrarDataModule2__;

end.


