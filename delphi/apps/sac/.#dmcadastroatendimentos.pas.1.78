      PV := frxAtendimentos_.FindObject('fpvLogo');
      if (PV is TfrxPictureView) then
        TfrxPictureView(PV).picture.LoadFromFile(LogotipoFilialBase);
    end;
//    frxAtendimentos_.designreport;
    frxAtendimentos_.ShowReport(true);
  end;

