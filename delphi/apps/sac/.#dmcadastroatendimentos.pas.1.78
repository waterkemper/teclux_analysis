  else
  if Valores[0] = 'IncluirAtendimentoAvisosCartas' then
  {Origem: ligar para clientes tipo: Avisos}
  begin
    Valores_CodigoCliente        := Valores[1];
    Valores_TipoCliente          := Valores[2];
    Valores_Atendimentode        := Valores[3];
    Valores_carta                := Valores[4];
    Valores_CartaNumero          := Valores[5];
    Valores_TipodeCarta          := Valores[6];
    Valores_EmissaoCarta         := Valores[7];
    Valores_StreAvalista         := Valores[8];
    Valores_dataAtraso           := Valores[9];
    Valores_ValorAtraso          := Valores[10];
    Valores_tipoAtendimentoCarta := Valores[11];
    Valores_eAvalista            := Valores[12];

    ReFazConsulta(qryExisteAtendimento,[0,1,2,3],
                  [Valores_CodigoCliente,Valores_TipoCliente,Valores_Atendimentode,true]);

    if (qryExisteAtendimento.RecordCount > 0) then
    begin
      RefazConsultaPorNome(qryCartasClientes,
                           ['carta','numero'],
                           [Valores_Carta, Valores_CartaNumero]);

      SelecionarAtendimento;
      if qryCartasClientesatendimento.AsInteger <> qryExisteAtendimentocodigo.AsInteger then
        if MensagemSelecionaOpcao(Format(ctCLIENTEJAPOSSUIATENDIMENTO,
                                   [DescricaoAtendimento,
                                    qryProcuraClientesnome.AsString])+#10#13+
                                    'Desejas vincular a este atendimento?') = smbYes then
        begin
          qryAtendimentos.Edit;
          AtribuirInformes;
        end
        else
          Result:= False;
    end
    else
    begin

      qryAtendimentos.Insert;
      qryAtendimentoscliente.AsInteger    := Valores_CodigoCliente;
      qryAtendimentostipocliente.AsString := Valores_TipoCliente;
      qryAtendimentostipo.AsString        := Valores_Atendimentode;

      qryAtendimentosdata.AsDateTime      := DataServidor;

      qryAtendimentosusuario.AsInteger    := CodigoUsuario;
      qryAtendimentosnomeusuario.AsString := NomeUsuario;

      qryAtendimentosusuariologado.AsInteger    := CodigoUsuario;
      qryAtendimentosnomeusuariologado.AsString := NomeUsuario;

      qryAtendimentosconcluido.AsBoolean  := False;
      qryAtendimentoslembrar.AsDateTime := DataServidor;
      qryAtendimentostipoatendimento.AsInteger := Valores_tipoAtendimentoCarta;
      AtribuirInformes;
    end;

    if qryAtendimentos.State in [dsedit, dsinsert] then
      if GravarAtendimentos then
      begin
          qryAtualizaCartasCartas.Params[0].AsInteger := qryAtendimentoscodigo.AsInteger;
          qryAtualizaCartasCartas.Params[1].AsInteger := Valores_carta;
          qryAtualizaCartasCartas.Params[2].AsInteger := Valores_CartaNumero;
          qryAtualizaCartasCartas.ExecSql;
          Perpetrar([qryatualizaCartasCartas]);
          qryAtualizaCartasCartas.Close;
      end;

    qryAtendimentostipo.ReadOnly := true;
    Result:= True;
  end
  else
  if Valores[0] = 'AbrirUltimoAtendimento' then
  begin

    Valores_CodigoCliente        := Valores[1];
    Valores_TipoCliente          := Valores[2];

    ReFazConsulta(qryUltimoAtendimento,[0,1],
                  [Valores_CodigoCliente,Valores_TipoCliente]);

    if qryultimoAtendimento.recordcount = 1 then
    begin
      ReFazConsulta(qryAtendimentos,[0],[qryUltimoAtendimentocodigo.AsInteger]);
      ReFazTabelasAtendimentos;
    end;

  end;
end;


procedure TdtmCadastroAtendimentos.qryProcuraClientesAfterOpen(DataSet: TDataSet);
begin
  inherited;
  vListaOcorrenciasSelecionadas.Clear;
  ReFazTabelasAtendimentos;
  if (qryAtendimentos.State in [dsEdit, dsInsert]) then
    qryAtendimentostipocliente.AsString := qryProcuraClientestipo.AsString;

  if not eh_follow_up then
    if (qryAtendimentos.State = dsInsert) then
    begin
      ReFazConsulta(qryExisteAtendimento,[0,1,2,3],[qryProcuraClientescodigo.AsInteger,
                                                  qryProcuraClientestipo.AsString,
                                                  qryAtendimentostipo.AsString, true]);
      if not qryExisteAtendimento.IsEmpty then
      begin
        if MensagemSelecionaOpcao(Format(ctCLIENTEJAPOSSUIATENDIMENTO,
                                   [DescricaoAtendimento,
                                    qryProcuraClientesnome.AsString])+#10#13+
                                    'Deseja selecionar este atendimento?') = smbYes then
          SelecionarAtendimento;
      end;
    end;

  if Assigned(FProcuraClienteAfterOpen) then
    FProcuraClienteAfterOpen(qryProcuraClientes);
end;

procedure TdtmCadastroAtendimentos.qryProcuraTiposAtendimentosBeforeOpen(DataSet: TDataSet);
begin
  inherited;
  qryProcuraTiposAtendimentos.Params[1].AsString:= qryAtendimentostipo.AsString;
end;

procedure TdtmCadastroAtendimentos.ReFazTabelasAtendimentos;
begin
  ReFazConsulta(qryocorrencias,[0,1],[qryProcuraClientescodigo.AsInteger,
                                    qryProcuraClientestipo.AsString]);
  ReFazConsulta(qryUltimaReclamacao,[0,1],[qryProcuraClientescodigo.AsInteger,
                                           qryProcuraClientestipo.AsString]);

  RefazConsultaPorNome(qryAtendimentosText, ['codigo'], [qryAtendimentoscodigo.asinteger]);
  {f qryAtendimentos.state = dsinsert then
    qryAtendimentosText.append;}

  PosicionarOcorrencias;
end;

procedure TdtmCadastroAtendimentos.Selecionar(TipoConsulta: TtecTipoConsultaAtendimento);
begin
  case TipoConsulta of
    tcaATENDIMENTO    : begin
                          qryProcuraClientes.Params[1].AsString := qryConsultaAtendimentostipocliente.AsString;
                          ReFazConsulta(qryAtendimentos,[0],[qryConsultaAtendimentoscodigo.AsInteger]);
                        end;
    tcaCLIENTE        : begin
                          qryProcuraClientes.BeforeOpen := nil;
                          qryProcuraClientes.Params[1].AsString := qryConsultaClientestipo.AsString;

                          qryAtendimentos.Edit;
                          qryAtendimentostipocliente.AsString := qryConsultaClientestipo.AsString;
                          qryAtendimentoscliente.AsInteger    := qryConsultaClientescodigo.AsInteger;

                          qryProcuraClientes.BeforeOpen := qryProcuraClientesBeforeOpen;


                        end;
    tcaTIPOATENDIMENTO: begin
                          qryAtendimentos.Edit;
                          qryAtendimentostipoatendimento.AsInteger:= qryConsultaTiposAtendimentoscodigo.AsInteger;
                        end;
  end;
end;

procedure TdtmCadastroAtendimentos.SelecionarAtendimento;
begin
  ReFazConsulta(qryAtendimentos,[0],[qryExisteAtendimentocodigo.AsInteger]);
end;

procedure TdtmCadastroAtendimentos.ValidarTipoAtendimento;
begin
  qryAtendimentostipoatendimento.Clear;
  if (qryAtendimentos.State = dsEdit) then begin
    ReFazConsulta(qryExisteAtendimento,[0,1,2,3],[qryProcuraClientescodigo.AsInteger,
                                                qryProcuraClientestipo.AsString,
                                                qryAtendimentostipo.AsString, true]);

    if (qryExisteAtendimento.RecordCount > 0) and
       (qryExisteAtendimentocodigo.AsInteger <> qryAtendimentoscodigo.AsInteger) then begin
       MensagemAviso(Format(ctCLIENTEJAPOSSUIATENDIMENTO + #10#13 +
                            ctCANCELARALTERACOES,[DescricaoAtendimento,qryProcuraClientesnome.AsString]));
       qryAtendimentos.Cancel;
    end;
  end;
end;

procedure TdtmCadastroAtendimentos.qryAtendimentosAfterScroll(
  DataSet: TDataSet);
 procedure ControlarAtendimento(Valor, ControlarDatas: Boolean);
 var
 i : integer;
 begin
   for i := 0 to qryAtendimentos.FieldCount -1 do
   begin
    if ControlarDatas then
    begin
       if (qryAtendimentos.Fields[i].fieldname = 'semaviso') or
          (qryAtendimentos.Fields[i].fieldname = 'semspc') then
       begin
         qryAtendimentos.Fields[i].ReadOnly := qryatendimentos.Fields[i].AsDateTime < DataServidor;
         if qryAtendimentosdata.AsDateTime = DataServidor then
           qryAtendimentos.Fields[i].Required := false
         else
           qryAtendimentos.Fields[i].Required := qryAtendimentos.Fields[i].AsString <> '';
       end
       else
         qryAtendimentos.Fields[i].ReadOnly := valor;
    end
    else
     qryAtendimentos.Fields[i].ReadOnly := Valor;
   end;
 end;
begin
  inherited;
//  ReFazTabelasAtendimentos;
  RefazConsultaPorNome(qryAtendimentosText, ['codigo'], [qryAtendimentoscodigo.asinteger]);

  if ((qryAtendimentosdata.AsDateTime = DataServidor) or
      (qryAtendimentos.State in [dsinsert])) and
      not qryAtendimentospossuicartaatendimento.AsBoolean then  //normal mesmo dia
    ControlarAtendimento(false,false)
  else
  if qryAtendimentostipo.AsString <> 'C' then
    ControlarAtendimento(true,false)   //normal dia anterior
  else
    ControlarAtendimento(true,true);  //Cobranca via atendimento

  if (qryAtendimentostipo.AsString = 'R') or  //Reclamação
     (qryAtendimentostipo.AsString = 'V')  then      //Contato
  begin
    qryAtendimentosTextinformes.ReadOnly := false;
    ControlarAtendimento(false,false);

  end;

  SetarExtrasSomenteLeitura;

  qryAtendimentoslembrar.ReadOnly := false;
  qryAtendimentoslembrarhora.ReadOnly := false;


  qryAtendimentosstatus.readonly := false;
  qryAtendimentosfichaalerta.readonly := false;

  if assigned(AtendimentosAfterScroll) then
    AtendimentosAfterScroll(qryAtendimentos);

//  qryProcuraClientes.ParamByName('tipocliente').AsString := qryAtendimentostipocliente.AsString

end;

function TdtmCadastroAtendimentos.CartaDevolvida(FormOrigem: String): Boolean;
begin
  Result := ClienteCartaDevolvida(qryProcuraClientescodigo.asInteger, qryProcuraClientestipo.asString,
                                  qryProcuraClientesnome.AsString, FormOrigem);
end;

procedure TdtmCadastroAtendimentos.qryAtendimentosAfterClose(
  DataSet: TDataSet);
begin
  inherited;
  if qryAtendimentos.IsEmpty then
    ReFazTabelasAtendimentos;
end;

procedure TdtmCadastroAtendimentos.qryAtendimentosNewRecord(
  DataSet: TDataSet);
begin
  inherited;
  qryAtendimentostipo.AsString := 'V';
//  qryProcuraClientes.ParamByName('tipocliente').AsString := 'C';
  qryAtendimentosdatainclusao.AsDateTime := DataHoraServidor;
  qryAtendimentosnaoligar.AsBoolean := false;
  qryAtendimentosStatus.AsString := 'A';
//  qryAtendimentoslembrarhora.clear;
//  qryAtendimentoslembrarhora.asdatetime := now();
  qryAtendimentoslembrarhora.asString := '00:00:00';

  qryAtendimentosFilial.asInteger := FilialBase;

end;

procedure TdtmCadastroAtendimentos.dsrAtendimentoDataChange(
  Sender: TObject; Field: TField);
begin
  inherited;
  if field = qryAtendimentoslembrar then
  begin
    if not field.IsNull then
    begin
      if field.value < qryAtendimentosdata.value then
      begin
        MensagemErro('Data do "lembrar em" não pode ser inferior a data do atendimento');
        field.value := null;
        {
      end
      else
      if (field.Value > (DataServidor + 90))  then
      begin
        MensagemErro('Data do "lembrar em" não pode ultrapassar a 90 dias');
        field.value := null;
        }
      end;
    end;
  end
  else
  if field = qryAtendimentostipo then
  begin
    if (qryAtendimentos.State in [dsinsert, dsedit]) or
       (qryAtendimentostipo.OldValue <> qryAtendimentostipo.Value) then
      ValidarTipoAtendimento;
  end
  else
  if field = qryAtendimentoscliente then
   qryAtendimentosnomecliente.asString := qryProcuraClientesnome.asString; 

  (*
  else
  if (Field = qryAtendimentosstatus) and  (vControlarStatus = ClicadoStatus) then
  begin
    vControlarStatus := BloqueadoStatus;
    if (qryAtendimentosStatusaux.asString = 'A') and
       (qryAtendimentosStatusaux.asString <> qryAtendimentosStatus.asString) and
        AtendimentosStatusRead then
    begin
//      dsrAtendimento.onDataChange := nil;
      vControlarStatus := BloqueadoStatus;
      mensagemaviso('Este atendimento refere-se a um orçamento. O fechamento deve ocorrer pelo cancelamento ou mudança do status do orçamento.');
      qryAtendimentos.edit;
      qryAtendimentosStatus.asString := qryAtendimentosStatusaux.asString;
//      dsrAtendimento.onDataChange := dsrAtendimentoDataChange;
      vControlarStatus := AbertoStatus;
    end
    else
    if (qryAtendimentosStatusaux.asString = 'F') and
       (qryAtendimentosStatusaux.asString <> qryAtendimentosStatus.asString) and
       AtendimentosStatusRead then
    begin
      vControlarStatus := BloqueadoStatus;
//      dsrAtendimento.onDataChange := nil;
      mensagemaviso('Este atendimento refere-se a um orçamento. A mudança do status deve ocorrer pelo orçamento.');
      qryAtendimentos.edit;
      qryAtendimentosStatus.asString := qryAtendimentosStatusaux.asString;
//      dsrAtendimento.onDataChange := dsrAtendimentoDataChange;
      vControlarStatus := AbertoStatus;
    end;
  end;

  else
  if field = qryAtendimentosOrcamento then
    qryAtendimentosstatus.readonly := AtendimentosStatusRead;
*)
end;

procedure TdtmCadastroAtendimentos.qryocorrenciasCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  if qryocorrenciastipo.AsString = 'C' then
    qryocorrenciasdescricaotipo.AsString := 'COBRANÇA'
  else
  if qryocorrenciastipo.AsString = 'R' then
    qryocorrenciasdescricaotipo.AsString := 'RECLAMAÇÃO'
  else
  if qryocorrenciastipo.AsString = 'V' then
    qryocorrenciasdescricaotipo.AsString := 'CONTATO'
  else
  if qryocorrenciastipo.AsString = 'O' then
    qryocorrenciasdescricaotipo.AsString := 'ORÇAMENTO';

end;

procedure TdtmCadastroAtendimentos.frxAtendimentosGetValue(
  const VarName: String; var Value: Variant);
begin
  inherited;
  if VarName = 'TITULO' then
    Value :=  'REGISTRO DE ATENDIMENTOS'
  else if VarName = 'RAZAOFILIALBASE' then
    Value := RazaoFilialBase
  else if VarName = 'ENDERECO_BAIRRO' then
    Value :=  RuaFilialBase+ ' - '+BairroFilialBase
  else if VarName = 'CEP_CIDADE_UF' then
    Value :=  FormatarCEP(CEPFilialBase)+'  '+CidadeFilialBase+ '  '+ EstadoFilialBase;
end;

procedure TdtmCadastroAtendimentos.imprimirRegistroAtendimentos;
var
  vFiltroOcorrenciaAnterior : tFiltroOcorrencia;
begin
  vFiltroOcorrenciaAnterior := FiltroOcorrencia;
  GuardarRegistroAtual(qryocorrencias, true);
  try
    FiltroOcorrencia := Atual;

    ExibirImpressaoAtendimento;

  finally
    FiltroOcorrencia := vFiltroOcorrenciaAnterior;
    VoltarRegistroAtual(qryocorrencias);
  end;
end;

procedure TdtmCadastroAtendimentos.qryProcuraClientesBeforeOpen(
  DataSet: TDataSet);
begin
  inherited;
  if qryAtendimentostipocliente.asString<>'' then
    qryProcuraClientes.ParamByName('tipocliente').AsString := qryAtendimentostipocliente.AsString;
end;

procedure TdtmCadastroAtendimentos.qryAtendimentosBeforePost(
  DataSet: TDataSet);
begin
  inherited;
  if qryAtendimentoslembrarhora.isnull then
    qryAtendimentoslembrarhora.asString := '00:00:00';

  if qryAtendimentostipoatendimento.asinteger = 0 then
  begin
    if qryAtendimentosorcamento.asinteger <> 0 then
    begin
      qryConsultaTiposAtendimentos.Params[0].AsString:= 'O';
      qryConsultaTiposAtendimentos.close;
      qryConsultaTiposAtendimentos.open;

      if qryConsultaTiposAtendimentos.recordcount > 0 then
        qryAtendimentostipoatendimento.asinteger := qryConsultaTiposAtendimentoscodigo.asinteger
      else
      begin
        MensagemErro('Tipo de Atendimento [''O''] não cadastrado para o Orçamento!');
        exit;
      end;
    end;
  end;

end;

procedure TdtmCadastroAtendimentos.ListarInformes(Inf: TRichEdit;
  MostrarAtendimento: Boolean);
var
  Pos: TBookmark;
  vFiltroOcorrenciaAnterior : tFiltroOcorrencia;
  vCodigo : integer;
begin
  vFiltroOcorrenciaAnterior := FiltroOcorrencia;

  if qryocorrencias.recordcount<>0 then
  begin
    vcodigo := qryocorrenciascodigo.asinteger;
    if MostrarAtendimento then
      ReFazConsulta(qryAtendimentos,[0],[qryocorrenciascodigo.AsInteger]);

//  qryProcuraClientes.AfterOpen:= Nil;

    FiltroOcorrencia := Atual;
    ListandoInformes := true;
    MontarInformesAtendimentos(Inf, qryocorrencias);

    FiltroOcorrencia := vFiltroOcorrenciaAnterior;
//    PosicionarOcorrencias;
    ListandoInformes := false;

//  qryProcuraClientes.AfterOpen:= qryProcuraClientesAfterOpen;

   qryocorrencias.refresh;
   qryocorrencias.first;
   qryocorrencias.locate('codigo',vcodigo,[]);

  end;
end;

procedure TdtmCadastroAtendimentos.qryocorrenciasFilterRecord(
  DataSet: TDataSet; var Accept: Boolean);
begin
  inherited;
  case FiltroOcorrencia of
    Todos : Accept := qryocorrenciasorigem.isnull or (vListaOcorrenciasSelecionadas.IndexOf(origemocorrencia)<>-1);
    Atual : Accept := origemocorrencia = origem;
  end;
end;

procedure TdtmCadastroAtendimentos.PosicionarOcorrencias;
begin
  qryOcorrencias.first;
  if not qryOcorrencias.locate('codigo',qryatendimentoscodigo.asinteger,[]) then
    qryOcorrencias.locate('codigo',qryatendimentosorigem.asinteger,[])
{
  case FiltroOcorrencia of
    Todos : begin
              if qryatendimentosorigem.isnull then
                qryocorrencias.locate
                Accept := qryocorrenciasorigem.isnull or (qryocorrenciasorigem.asinteger = qryatendimentoscodigo.asinteger)
              else
                Accept := qryocorrenciasorigem.isnull or (qryocorrenciasorigem.asinteger = qryatendimentosorigem.asinteger);
            end;
    Atual:  begin
              if qryatendimentosorigem.isnull then
                Accept := (qryocorrenciascodigo.asinteger = qryatendimentoscodigo.asinteger) or (qryocorrenciasorigem.asinteger = qryatendimentoscodigo.asinteger)
              else
                Accept := (qryocorrenciascodigo.asinteger = qryatendimentosorigem.asinteger) or (qryocorrenciasorigem.asinteger = qryatendimentosorigem.asinteger);
            end;
    SoOrigem : Accept := qryocorrenciasorigem.isnull;
  end;
  }
end;

procedure TdtmCadastroAtendimentos.FiltrarOcorrencias(tecla: String);
var
vCodigo : integer;
begin
   if (tecla = '+') or ((qryOcorrenciasexpandir.AsString='+') and (tecla='')) then
   begin
     vCodigo := qryOcorrenciascodigo.asinteger;
     vListaOcorrenciasSelecionadas.Append(OrigemOcorrencia);
   end
   else
   if (tecla = '-') or ((qryOcorrenciasexpandir.AsString='-') and (tecla='')) then
   begin
     vCodigo := qryOcorrenciasorigem.asinteger;
     vListaOcorrenciasSelecionadas.Delete(vListaOcorrenciasSelecionadas.IndexOf(OrigemOcorrencia));
   end;
   qryocorrencias.refresh;
   qryocorrencias.first;
   qryocorrencias.locate('codigo',vcodigo,[]);

end;


procedure TdtmCadastroAtendimentos.editarAtendimentos;
begin
  if not (qryatendimentos.state in [dsedit, dsinsert]) then
    qryAtendimentos.edit;
end;

function TdtmCadastroAtendimentos.GeteH_Follow_up: boolean;
begin
  result := not qryatendimentosorigem.isnull or (qryAtendimentosfollowups.asinteger <> 0)
                                             or not qryAtendimentosorcamento.isnull
                                             or not qryAtendimentoscontrato.isnull;
end;

function IncluirAtendimento__(Documento: Variant;
                              Cliente: Integer;
                              TipoCliente: String;
                              TipoAtendimento_: TTecTipoCadastroAtendimento;
                              Texto: String;
                              Tabela: TTecQuery;
                              DescricaoSituacao: String;
                              Documento_Atual: String): boolean;

 var
   vTexto, vProdutos, vDescDocto : String;
   vDias : integer;

begin
  result := false;
  if assigned(dtmcadastroatendimentos2) then
    freeandnil(dtmcadastroatendimentos2);

  dtmcadastroatendimentos2 := Tdtmcadastroatendimentos.Create(dtmcadastroatendimentos2);
    with dtmcadastroatendimentos2 do
    begin
      case TipoAtendimento_ of

        CancelamentoOrcamento,
        CancelamentoContrato,
        CancelamentoOrcamentoConsulta :
        begin
          if TipoAtendimento_ = CancelamentoContrato then
            ReFazConsulta(qryExisteAtendimento,[0,1,2,3,4,5], [null,null,'C',false,null,Documento])
          else
            ReFazConsulta(qryExisteAtendimento,[0,1,2,3,4,5], [null,null,'O',false,Documento,null]);

          if TipoAtendimento_ = CancelamentoContrato then
            vDescDocto := 'contrato'
          else
            vDescDocto := 'orçamento';

          if not qryExisteAtendimento.isempty then
          begin
            selecionarAtendimento;
            IncluirAtendimentos(true, true);


            result := GravarAtendimentos('Fechado, '+vDescDocto+' '+vartostr(documento) + ' cancelado ' +chr(13) + Texto,
                                         (TipoAtendimento_ = CancelamentoOrcamentoConsulta), false);

            if result then
              if TipoAtendimento_ = CancelamentoOrcamento then
              begin
                {Cancelar outros atendimentos que venham a existir por simultaneidade }
                qryAtualizarAtendimentosOrcamentos.parambyname('orcamento').asInteger := strtoint(vartostr(Documento));
                qryAtualizarAtendimentosOrcamentos.parambyname('informes').asString :=  'Fechado, orçamento '+vartostr(documento) + ' cancelado ' +chr(13) + Texto;
                qryAtualizarAtendimentosOrcamentos.execSQL;
              end
              else
              if TipoAtendimento_ = CancelamentoContrato then
              begin
                qryAtualizarAtendimentosContratos.parambyname('contrato').asString := vartostr(Documento);
                qryAtualizarAtendimentosContratos.parambyname('informes').asString :=  'Fechado, contrato '+vartostr(documento) + ' cancelado ' +chr(13) + Texto;
                qryAtualizarAtendimentosContratos.execSQL;
              end;
          end
          else
          begin

            Abre(ctCadastroAtendimentos);
            if TipoAtendimento_ = CancelamentoContrato then
              IncluirAtendimentos(['IncluirCancelamentoDiretoContrato', Cliente, TipoCliente, 'O', Documento, Texto, DescricaoSituacao])
            else
              IncluirAtendimentos(['IncluirCancelamentoDiretoOrcamento', Cliente, TipoCliente, 'O', Documento, Texto, DescricaoSituacao]);

            result := GravarAtendimentos('Fechado, ' + vDescDocto + ' ' + vartostr(documento) + ' cancelado ' +chr(13) + Texto,
                                         (TipoAtendimento_ = CancelamentoOrcamentoConsulta), false);
//            EncerrarDataModule2__;
//            result := true;
          end;
        end;

        OrcamentoParaContrato :
        begin


          qryExisteAtendimento.MacroByName('CondicaoOrcamentoParaContrato').AsString := 'and origem is null order by codigo';
          ReFazConsulta(qryExisteAtendimento,[0,1,2,3,4], [null,null,'O',false,Documento]);
          qryExisteAtendimento.MacroByName('CondicaoOrcamentoParaContrato').AsString := '';

          if not qryExisteAtendimento.isempty then
          begin
            qryExisteAtendimento.First;
            while not qryExisteAtendimento.eof do
            begin
              selecionarAtendimento;
              IncluirAtendimentos(true, true);
              result := GravarAtendimentos('Orçamento ' + vartostr(documento) + ' fechado, gerou contrato', (qryExisteAtendimento.recno > 1), false);
              qryExisteAtendimento.next;
            end;
          end
          else
          begin
            EncerrarDataModule2__;
            result := true;
          end;
        end;

        OrdemServicoPrevisaoEntrega :
        begin
          Abre(ctCadastroAtendimentos);
          result := IncluirAtendimentos(['OrdemServicoPrevisaoEntrega', Cliente, TipoCliente, 'O', Documento, Texto, DescricaoSituacao, Documento_Atual]);
          if result then
          begin
            qryAtendimentoslembrar.asDateTime := Tabela.fieldbyname('previsao').asDateTime;
            result := GravarAtendimentos(Texto);
          end;

          EncerrarDataModule2__;
        end;

        EmailEnviado :
        begin
          Abre(ctCadastroAtendimentos);
          IncluirAtendimentos(['IncluirFollowupOrcamento', Cliente, TipoCliente, 'O', Documento, Texto, DescricaoSituacao,'']);
          result := GravarAtendimentos(Texto);
          EncerrarDataModule2__;
        end;

        AgendamentoProduto :
        begin
          Abre(ctCadastroAtendimentos);
          qryAtendimentosProdutos.close;
          qryAtendimentosProdutos.open;

          Tabela.SortByField('dias');
          Tabela.first;
          vDias := 0;
          vTexto := '';
          vProdutos := '';
          while true do
          begin

            if tabela.fieldbyname('marcar').asBoolean then
            begin

              if (vDias <> 0) and ((vDias <> Tabela.FieldbyName('dias').asInteger) or Tabela.eof) then
              begin
                if GravarAtendimentos(vTexto, true) then
                begin
                  AtribuirChave(qryAtendimentosProdutos, [qryAtendimentosProdutosatendimento], [qryAtendimentosCodigo]);
                  result := perpetrar([qryAtendimentosProdutos]);
                  qryAtendimentosProdutos.close;
                  qryAtendimentosProdutos.open;

                end
                else
                begin
                  result := false;
                  break;
                end;

                vTexto := '';
                vProdutos := '';
                vDias := 0;

                if tabela.eof then
                  break;
              end;


              vTexto := vTexto + 'Produto ' + Tabela.FieldbyName('codigovisual').asString + ' ' +
                                              Tabela.FieldbyName('descricao').asString + ' ' + chr(13) +
                                              Tabela.FieldbyName('observacoes').asString + chr(13) +
                                              Tabela.fieldbyname('complemento').asString + chr(13);

              vProdutos := vProdutos + Tabela.FieldbyName('codigovisual').asString + ' ';


              vDias := Tabela.FieldbyName('dias').asInteger;

              if (qryAtendimentos.state <> dsinsert) then
              begin
                IncluirAtendimentos(['IncluirAgendamentoProduto', Cliente, TipoCliente, 'O', Documento, 'AGENDAMENTO PRODUTOS '+vProdutos, DescricaoSituacao, Documento_Atual]);
                qryAtendimentoslembrar.asDateTime := Tabela.fieldbyname('agendamento').asDateTime;
              end;

              qryAtendimentosProdutos.append;
              qryAtendimentosProdutosproduto.asString := Tabela.FieldbyName('produto').asString;
              qryAtendimentosProdutosdias.asinteger := vDias;
              qryAtendimentosProdutos.post;

            end;

            if tabela.eof then
              break;

            tabela.next;

          end;
          EncerrarDataModule2__;
        end;

        AgendamentoProdutoOrcamento :
        begin

          qryApagarAgendamentoProdutosOrcamento.parambyname('orcamento').asstring := Documento;
          qryApagarAgendamentoProdutosOrcamento.execsql;
          perpetrar([qryApagarAgendamentoProdutosOrcamento]);

          Abre(ctCadastroAtendimentos);
          qryAtendimentosProdutos.close;
          qryAtendimentosProdutos.open;

          Tabela.SortByField('dias');
          Tabela.first;
          vDias := 0;
          vTexto := '';
          vProdutos := '';
          while true do
          begin

            if tabela.fieldbyname('marcar').asBoolean then
            begin

              if (vDias <> 0) and ((vDias <> Tabela.FieldbyName('dias').asInteger) or Tabela.eof) then
              begin
                if GravarAtendimentos(vTexto, true) then
                begin
                  AtribuirChave(qryAtendimentosProdutos, [qryAtendimentosProdutosatendimento], [qryAtendimentosCodigo]);
                  result := perpetrar([qryAtendimentosProdutos]);
                  qryAtendimentosProdutos.close;
                  qryAtendimentosProdutos.open;

                end
                else
                begin
                  result := false;
                  break;
                end;

                vTexto := '';
                vProdutos := '';
                vDias := 0;

                if tabela.eof then
                  break;
              end;


              vTexto := vTexto + 'Produto ' + Tabela.FieldbyName('codigovisual').asString + ' ' +
                                              Tabela.FieldbyName('descricao').asString + ' ' + chr(13) +
                                              Tabela.FieldbyName('observacoes').asString + chr(13) +
                                              Tabela.fieldbyname('complemento').asString + chr(13);

              vProdutos := vProdutos + Tabela.FieldbyName('codigovisual').asString + ' ';


              vDias := Tabela.FieldbyName('dias').asInteger;

              if (qryAtendimentos.state <> dsinsert) then
              begin
                IncluirAtendimentos(['IncluirAgendamentoProdutoOrcamento', Cliente, TipoCliente, 'O', Documento, 'AGENDAMENTO PRODUTOS '+vProdutos, DescricaoSituacao, Documento_Atual]);
                qryAtendimentoslembrar.asDateTime := Tabela.fieldbyname('agendamento').asDateTime;
              end;

              qryAtendimentosProdutos.append;
              qryAtendimentosProdutosproduto.asString := Tabela.FieldbyName('produto').asString;
              qryAtendimentosProdutosdias.asinteger := vDias;
              qryAtendimentosProdutos.post;

            end;

            if tabela.eof then
              break;

            tabela.next;

          end;
          EncerrarDataModule2__;
        end;




      end;
    end;
end;


procedure EncerrarDataModule2__;
begin
  if assigned(dtmcadastroatendimentos2) then
  begin
    dtmcadastroatendimentos2.qryAtendimentos.AfterScroll := nil;
    dtmcadastroatendimentos2.qryAtendimentos.AfterClose := nil;
    dtmcadastroatendimentos2.free;
    dtmcadastroatendimentos2 := nil;
  end;  
end;


function TdtmCadastroAtendimentos.VerificarDataLembrar: boolean;
begin
  qryExisteAtendimento2.macrobyname('Condicao').asString :=
  '(codigo <> '+inttostr(qryatendimentoscodigo.asinteger) + ' and origem = ' + origem + ' and cast(lembrar||'' ''||lembrarhora as timestamp) > cast('''+ formatDatetime('yyyy-mm-dd',qryAtendimentosLembrar.asDatetime)+' '+formatdatetime('hh:MM:ss',qryAtendimentosLembrarhora.asDateTime)+''' as timestamp))';
  qryExisteAtendimento2.close;
  qryExisteAtendimento2.open;
  result := qryExisteAtendimento2.recordcount>0;
end;

function TdtmCadastroAtendimentos.GetOrigem: String;
begin
  if qryatendimentosorigem.isnull then
    result := inttostr(qryAtendimentosCodigo.asInteger)
  else
    result := inttostr(qryatendimentosorigem.asInteger);
end;

function TdtmCadastroAtendimentos.GetOrigemOcorrencia: String;
begin
  if qryocorrenciasorigem.isnull then
