implementation

{$R *.dfm}

{ TdtmCadastroAtendimentos }

procedure TdtmCadastroAtendimentos.AbreTabelasConsulta(TipoConsulta: TtecTipoConsultaAtendimento);
begin
  case TipoConsulta of
    tcaATENDIMENTO    : begin
                          qryConsultaAtendimentos.MacroByName('CondicaoAtendimentos').asString := 'and (a.codigo = 0)';
                          qryConsultaAtendimentos.close;
                          qryConsultaAtendimentos.Open;
                        end;
    tcaCLIENTE        : begin
                          qryConsultaClientes.Sql[08] := 'where (v.codigo = 0)';
                          qryConsultaClientes.Open;
                        end;
    tcaTIPOATENDIMENTO: begin
                          qryConsultaTiposAtendimentos.Params[0].AsString:= qryAtendimentostipo.AsString;
                          qryConsultaTiposAtendimentos.Open;
                        end;
  end;
end;

constructor TdtmCadastroAtendimentos.Create(AOwner: TComponent);
begin
  inherited;
  vControlarStatus := AbertoStatus;
  FiltroOcorrencia := Todos;
  qryAtendimentos.Tag                   := ctCadastroAtendimentos;
  qryAtendimentosText.Tag                   := ctCadastroAtendimentos;
  qryConsultaClientes.Tag               := ctTabelasConsultaClientes;
  qryConsultaTiposAtendimentos.Tag      := ctAtendConsultaTiposAtendimentos;
  qryProcuraClientes.Params[1].AsString := 'C';
  vListaOcorrenciasSelecionadas := tStringList.create;
  vListaOcorrenciasSelecionadas.Duplicates := dupIgnore;

end;

function TdtmCadastroAtendimentos.ExcluirAtendimentos: Boolean;
begin
  Result:= False;
  if (qryAtendimentosdata.AsDateTime = DataServidor) then begin
    if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o ATENDIMENTO'])) = smbOk then
    begin
      qryAtendimentos.Delete;
      Perpetrar([qryatendimentos]);
      ReFazTabelasAtendimentos;

      if Assigned(FProcuraClienteAfterOpen) then
        FProcuraClienteAfterOpen(qryProcuraClientes);

      Result:= True;
    end;
  end
  else MensagemAviso(ctATENDIMENTONAOPODEEXCLUIR);
end;

function TdtmCadastroAtendimentos.ExisteAtendimentos(Parametro: Integer;
  NomeCampo: String; Value: Variant): Boolean;

var
  vCondicao : String;
  vCondicaoUltimoAtendimento : String;
begin

  vCondicao := '';
  vCondicaoUltimoAtendimento := '';

  if NomeCampo = 'nome' then
    NomeCampo := 'c.nome'
  else
  if NomeCampo = 'UltimoAtendimento' then
{    vCondicao := 'and (select to_ascii(a2.data, ''latin1'') from atendimentos a2 where coalesce(a2.origem,a2.codigo) = coalesce(a.origem,a.codigo) order by a2.codigo desc limit 1) ilike to_ascii(''' + Value + '%'',''latin1'')'}
    vCondicaoUltimoAtendimento := 'and (to_ascii(' + NomeCampo + ',''latin1'') ilike to_ascii(''' + Value + '%'',''latin1''))'
  else
    NomeCampo:= 'a.' + NomeCampo;

  if vCondicao = '' then
    vCondicao := 'and (to_ascii(' + NomeCampo + ',''latin1'') ilike to_ascii(''' + Value + '%'',''latin1''))';

  qryConsultaAtendimentos.MacroByName('CondicaoAtendimentos').asString := vCondicao;

  qryConsultaAtendimentos.MacroByName('CondicaoUltimoAtendimento').asString := vCondicaoUltimoAtendimento;

  qryConsultaAtendimentos.Close;
  qryConsultaAtendimentos.Open;

  Result := Not qryConsultaAtendimentos.IsEmpty
end;

function TdtmCadastroAtendimentos.ExisteClientes(Parametro: Integer; NomeCampo: String; Value: Variant): Boolean;
begin
  if NomeCampo = 'nomecidade' then
    NomeCampo:= 'c.nome'
  else if NomeCampo = 'tipocliente' then
    NomeCampo:= 'v.tipo'
  else
    NomeCampo:= 'v.' + NomeCampo;
  qryConsultaClientes.Sql[08] := 'Where to_ascii(' + NomeCampo + ',''latin1'') ilike to_ascii(''' + Value + '%'',''latin1'')';
  qryConsultaClientes.Open;
  Result := Not qryConsultaClientes.IsEmpty
end;

function TdtmCadastroAtendimentos.ExisteTiposAtendimentos(campo, codigo: string): boolean;
begin
  Result := ExisteCodigo(qryConsultaTiposAtendimentos, campo, codigo);
end;

procedure TdtmCadastroAtendimentos.FecharTabelasAtendimentos;
begin
  Fecha(ctCadastroAtendimentos);
  Abre(ctCadastroAtendimentos);
  qryocorrencias.Close;
  qryUltimaReclamacao.Close;
end;

procedure TdtmCadastroAtendimentos.FechaTabelasConsulta(TipoConsulta: TtecTipoConsultaAtendimento);
begin
  case TipoConsulta of
    tcaATENDIMENTO    : qryConsultaAtendimentos.Close;
    tcaCLIENTE        : Fecha(ctTabelasConsultaClientes);
    tcaTIPOATENDIMENTO: Fecha(ctAtendConsultaTiposAtendimentos);
  end;
end;

function TdtmCadastroAtendimentos.GetAtendimento: String;
begin
  Result:= qryAtendimentostipo.AsString;
end;

function TdtmCadastroAtendimentos.GetConsultaTiposAtendimentos: TtecQuery;
begin
  Result:= qryConsultaTiposAtendimentos;
end;

function TdtmCadastroAtendimentos.GetDataAtendimento: TDateTime;
begin
  result := qryatendimentosdata.AsDateTime;
end;

function TdtmCadastroAtendimentos.GetDescricaoAtendimento: String;
begin
  if qryAtendimentostipo.AsString = 'C' then
    Result:= 'Cobrança'
  else
  if qryAtendimentostipo.AsString = 'R' then
    Result:= 'Reclamação'
  else
  if qryAtendimentostipo.AsString = 'V' then
    Result:= 'Contato'
  else
  if qryAtendimentostipo.AsString = 'O' then
    Result:= 'Orçamento';
end;

function TdtmCadastroAtendimentos.GetExisteReclamacao: Boolean;
begin
  Result:= not qryUltimaReclamacao.IsEmpty;
end;

function TdtmCadastroAtendimentos.GetIncluindoAtendimentos: boolean;
begin
  result := qryAtendimentos.State in [dsinsert];
end;


function TdtmCadastroAtendimentos.GetTabelaAtendimento: TtecQuery;
begin
   Result := qryatendimentos;
end;

function TdtmCadastroAtendimentos.GetTabelaConsultaAtendimentos: TtecQuery;
begin
  Result:= qryConsultaAtendimentos;
end;

function TdtmCadastroAtendimentos.GetTabelaConsultaCliente: TtecQuery;
begin
  Result := qryConsultaClientes;
end;

function TdtmCadastroAtendimentos.GravarAtendimentos(informe: String; UsuarioJaVerificado: Boolean; FecharTransacao: boolean): Boolean;
var
  OldInformes: String;
  UsrAut: TtecUsuarios;
  vRetornoMensagem : TMessageButton;

begin
  Result:= False;
  qryProcuraClientes.AfterOpen:= Nil;

  if qryAtendimentos.CheckRequiredFields and ((informe<>'') or (assigned(VerificarDescricaodosInformes) and VerificarDescricaodosInformes)) then
  begin
    {
    if not eH_Follow_up and (qryAtendimentos.State = dsInsert) then
    begin
      ReFazConsulta(qryExisteAtendimento,[0,1,2,3],[qryAtendimentoscliente.AsInteger,
                                                    qryAtendimentostipocliente.AsString,
                                                    qryAtendimentostipo.AsString,
                                                    true]);


      Result:= ((qryExisteAtendimento.RecordCount = 0) or
              ((qryExisteAtendimento.RecordCount > 0) and
               (qryExisteAtendimentocodigo.AsInteger = qryAtendimentoscodigo.AsInteger)));
      if not Result then
      begin
        vRetornoMensagem := MensagemSelecionaOpcao(Format(ctCLIENTEJAPOSSUIATENDIMENTO + #10#13 + ctINCLUIRINFORMES,[DescricaoAtendimento, qryProcuraClientesnome.AsString]));

        if vRetornoMensagem = smbYes then
        begin
          if (informe <> '') then
            OldInformes:= informe
          else
            OldInformes:= DescricaodosInformes;

          SelecionarAtendimento;
          qryAtendimentosText.Edit;
          qryAtendimentosTextinformes.AsString:= qryAtendimentosTextinformes.AsString + #10 + OldInformes;
          Result:= True;
        end
        else
        if vRetornoMensagem = smbNO then
          Result:= true
        else
        if vRetornoMensagem = smbCancel then
        begin
          Result:= False;
          exit;
        end;
      end;
    end
    else
    }
      result := true;

    if result then
    begin
      if (parsistema.Solicitarusuarionocadastrodeatendimentos) then
      begin
        if UsuarioJaVerificado and (UsuarioAutAux <> nil) then
          UsrAut := UsuarioAutAux
        else
          UsrAut := ObterAutorizacao(taLOGIN, 'Atendimentos', 'responsável pelo cadastro', '');

        if Assigned(UsrAut) then
        begin
          if {UsuarioJaVerificado and} (UsuarioAutAux = nil) then
            UsuarioAutAux := UsrAut;

          if (qryAtendimentos.State = dsInsert) then
          begin
            qryAtendimentosusuario.AsInteger := usrAut.CodigoUsuario;
            qryAtendimentosnomeusuario.AsString := usrAut.NomeUsuario;
          end;
        end
        else
          result := False;
      end;
    end;


    if Result then
    begin

      if vFecharAtendimento then
        qryAtendimentosStatus.asString := 'F';


      if qryAtendimentos.State = dsInsert then
      begin
        spcAtendimentosProximoCodigo.Open;
        qryAtendimentoscodigo.AsInteger := spcAtendimentosProximoCodigocodigo.AsInteger;
        spcAtendimentosProximoCodigo.Close;
      end;

      if qryAtendimentostipocliente.AsString = '' then
        qryAtendimentostipocliente.AsString:= qryProcuraClientestipo.AsString;
      if (qryAtendimentostipo.AsString <> 'C') then begin
        qryAtendimentossemspc.Clear;
        qryAtendimentossemaviso.Clear;
      end;

      VerificarMensagemAlertaClientes;

      if qryAtendimentosorigem.asInteger<>0 then
        qryAtualizarAtendimentosStatus.parambyname('origem').asInteger := qryAtendimentosorigem.asInteger
      else
        qryAtualizarAtendimentosstatus.parambyname('origem').asInteger := qryAtendimentoscodigo.asInteger;

      qryAtualizarAtendimentosStatus.parambyname('status').asString := qryAtendimentosStatus.asString;
      qryAtualizarAtendimentosStatus.ExecSql;

      qryatendimentos.Post;

      if FecharTransacao then
        result := Perpetrar([qryatendimentos, qryAtualizarAtendimentosStatus, qryAtualizarAtendimentosVisualizarFicha, qryClientes])
      else
        result := Perpetrar([qryatendimentos, qryAtualizarAtendimentosStatus, qryAtualizarAtendimentosVisualizarFicha, qryClientes], AguardareTerminaremOutroDm);


      if result then
      begin
        RefazConsultaPorNome(qryAtendimentosText, ['codigo'], [qryAtendimentoscodigo.asinteger]);
        qryAtendimentosText.edit;
        if informe <> '' then
          qryAtendimentosTextinformes.asstring := informe
        else
          qryAtendimentosTextinformes.asstring := DescricaodosInformes;
        qryAtendimentosText.post;

        if FecharTransacao then
          result := perpetrar([qryAtendimentosText])
        else
          result := perpetrar([qryAtendimentosText], AguardareTerminaremOutroDm)

      end;
      if FecharTransacao then
        ReFazTabelasAtendimentos;
    end;
  end;

  if Assigned(FProcuraClienteAfterOpen) then
    FProcuraClienteAfterOpen(qryProcuraClientes);

  qryProcuraClientes.AfterOpen:= qryProcuraClientesAfterOpen;
end;

function TdtmCadastroAtendimentos.IncluirAtendimentos(Followup: boolean; Fechar: boolean): Boolean;
var
  vNumeroAtendimentoOrigem, vTipoAtendimento, vCliente: integer;
  vTipo, vTipoCliente, vAssunto, vHora, vOrcamento, vContrato, vDataOrigem: String;

begin
  if qryAtendimentosOrigem.isnull then
    vNumeroAtendimentoOrigem := qryAtendimentosCodigo.asInteger
  else
    vNumeroAtendimentoOrigem := qryAtendimentosOrigem.asInteger;

  vTipo := qryAtendimentostipo.asString;
  vTipoAtendimento := qryAtendimentostipoatendimento.asinteger;
  vCliente := qryAtendimentosCliente.asInteger;
  vTipoCliente := qryAtendimentosTipoCliente.asString;
  vAssunto := qryAtendimentosAssunto.asString;
  vHora := qryAtendimentoslembrarhora.asString;
  vOrcamento := qryAtendimentosOrcamento.asString;
  vContrato := qryAtendimentosContrato.asString;
  vDataOrigem := qryAtendimentosdataOrigem.asString;

  FecharTabelasAtendimentos;

  ReFazConsultapornome(qryAtendimentos,['codigo'],[0]);

  qryAtendimentos.append;
//  qryAtendimentostipo.AsString       := 'C';
  qryAtendimentosdata.AsDateTime     := DataServidor;

  qryAtendimentosusuario.AsInteger   := CodigoUsuario;
  qryAtendimentosnomeusuario.AsString:= NomeUsuario;

  qryAtendimentosusuariologado.AsInteger   := CodigoUsuario;
  qryAtendimentosnomeusuariologado.AsString:= NomeUsuario;

  qryAtendimentosconcluido.AsBoolean := False;

  if followup then
  begin
    qryAtendimentosorigem.asinteger          := vNumeroAtendimentoOrigem;
    qryAtendimentosDataOrigem.asString       := vDataOrigem;
    qryAtendimentostipo.asString             := vTipo           ;
    qryAtendimentostipoatendimento.asinteger := vTipoAtendimento;
    qryAtendimentosCliente.asInteger         := vCliente        ;
    qryAtendimentosTipoCliente.asString      := vTipoCliente    ;
    qryAtendimentosAssunto.asString          := vAssunto        ;
    qryAtendimentoslembrarhora.asString      := vHora           ;
    qryAtendimentosOrcamento.asString        := vOrcamento      ;
    qryAtendimentosContrato.asString        := vContrato      ;


    qryExisteAtendimento2.macrobyname('Condicao').asString :=
    'coalesce(origem,codigo) = '+inttostr(vNumeroAtendimentoOrigem) + ' order by data desc, codigo desc limit 1';

    qryExisteAtendimento2.close;
    qryExisteAtendimento2.open;

    if not qryExisteAtendimento2Lembrar.isnull and (qryExisteAtendimento2Lembrar.asDateTime >= qryAtendimentosdata.AsDateTime)  then
    begin
      qryAtendimentoslembrar.asDateTime := qryExisteAtendimento2Lembrar.asDateTime;
      if not qryExisteAtendimento2LembrarHora.isnull then
        qryAtendimentoslembrarHora.asDateTime := qryExisteAtendimento2LembrarHora.asDateTime
      else
        qryAtendimentoslembrarHora.clear;
    end
    else
    begin
      qryAtendimentoslembrar.clear;
      qryAtendimentoslembrarHora.clear;
    end;

    qryAtendimentosfichaalerta.asString := qryExisteAtendimento2fichaalerta.asString;

  end;

  if fechar then
    qryAtendimentosstatus.asstring := 'F';

  Result:= True;

  SetarExtrasSomenteLeitura;

end;

function TdtmCadastroAtendimentos.IncluirAtendimentos(Valores: Array of Variant): Boolean;
var
  Valores_CodigoCliente        : integer;   {1}
  Valores_TipoCliente          : String;      {2}
  Valores_Atendimentode        : String;      {3}
  Valores_carta                : integer;   {4}
  Valores_CartaNumero          : integer;   {5}
  Valores_TipodeCarta          : integer;   {6}
  Valores_EmissaoCarta         : String;    {7}
  Valores_StreAvalista         : String;    {8}
  Valores_dataAtraso           : String;    {9}
  Valores_ValorAtraso          : String;    {10}
  Valores_tipoAtendimentoCarta : integer;   {11}
  Valores_eAvalista            : boolean;   {12}
  Valores_Orcamento            : integer;
  Valores_Romaneio             : integer;
  Valores_RomaneioDadofiscal   : integer;

  Valores_Contrato             : String;
  Valores_Renegociado          : String;
  vfichaalerta : string;

  Valores_Assunto : String;
  Valores_DescricaoSituacao    : String;
  Valores_DataValidade   : String;
  vIncluir : boolean;
  vOrigem : String;
  vDataOrigem : String;
  vLembrar : String;
  vLembrarHora : String;

  procedure AtribuirInformes;
  var
    InformeExistente: String;
  begin
    InformeExistente := qryAtendimentosTextinformes.AsString;
    qryAtendimentosTextinformes.AsString :=
        'Carta: '+inttostr(Valores_carta)+'.'+inttostr(Valores_cartanumero)+
        '  Tipo de Carta: '+inttostr(Valores_tipodecarta)+' Emissao: '+Valores_EmissaoCarta+#13#10+
        'Avalista: '+Valores_StreAvalista+#13#10+'Atraso desde: '+Valores_dataatraso+' Valor: '+Valores_valoratraso;

    if InformeExistente<>'' then
      qryAtendimentosTextinformes.AsString := qryAtendimentosTextinformes.AsString+#13#10+#13#10+
                                          InformeExistente;
  end;

begin
  result := true;
  vIncluir := false;
  FecharTabelasAtendimentos;

  {Origem: ligar para clientes tipo: atraso/lembrete}
  if Valores[0] = 'IncluirAtendimento' then
  begin

    Valores_CodigoCliente        := Valores[1];
    Valores_TipoCliente          := Valores[2];
    Valores_Atendimentode        := Valores[3];

    ReFazConsulta(qryExisteAtendimento,[0,1,2,3],
                  [Valores_CodigoCliente,Valores_TipoCliente,Valores_Atendimentode,true]);

    if (qryExisteAtendimento.RecordCount > 0) then
    begin
      SelecionarAtendimento;
{      MensagemAviso(Format(ctCLIENTEJAPOSSUIATENDIMENTO,
                                [DescricaoAtendimento,
                                 qryProcuraClientesnome.AsString]));}

      if MensagemSelecionaOpcao(Format(ctCLIENTEJAPOSSUIATENDIMENTO,
                                 [DescricaoAtendimento,
                                  qryProcuraClientesnome.AsString])+#10#13+
                                  'Deseja editar este atendimento?') = smbNO then
         vIncluir := true;
    end;

    if vIncluir or (qryExisteAtendimento.RecordCount = 0) then
    begin
      qryAtendimentos.Insert;
      qryProcuraClientes.ParamByName('tipocliente').AsString := Valores_TipoCliente;
      qryAtendimentoscliente.AsInteger    := Valores_CodigoCliente;
      qryAtendimentostipocliente.AsString := Valores_TipoCliente;
      qryAtendimentostipo.AsString        := Valores_Atendimentode;

      qryAtendimentosdata.AsDateTime      := DataServidor;

      qryAtendimentosusuario.AsInteger    := CodigoUsuario;
      qryAtendimentosnomeusuario.AsString := NomeUsuario;

      qryAtendimentosusuariologado.AsInteger    := CodigoUsuario;
      qryAtendimentosnomeusuariologado.AsString := NomeUsuario;

      qryAtendimentosconcluido.AsBoolean  := False;
    end;

  end
  else
  if Valores[0] = 'IncluirCancelamentoDiretoOrcamento' then
  begin

    Valores_CodigoCliente        := Valores[1];
    Valores_TipoCliente          := Valores[2];
    Valores_Atendimentode        := Valores[3];
    Valores_Orcamento            := Valores[4];
    Valores_Assunto              := Valores[5];
    Valores_DescricaoSituacao    := Valores[6];

    qryConsultaTiposAtendimentos.Params[0].AsString:= Valores_Atendimentode;
    qryConsultaTiposAtendimentos.close;
    qryConsultaTiposAtendimentos.open;

    qryAtendimentos.append;
    qryAtendimentosorcamento.asString := inttostr(Valores_Orcamento);
    qryAtendimentosdescricaosituacaoorcamento.asString := Valores_DescricaoSituacao;

    qryProcuraClientes.ParamByName('tipocliente').AsString := Valores_TipoCliente;

    qryAtendimentoscliente.AsInteger    := Valores_CodigoCliente;
    qryAtendimentostipocliente.AsString := Valores_TipoCliente;
    qryAtendimentostipo.AsString        := Valores_Atendimentode;

    qryAtendimentosdata.AsDateTime      := DataServidor;

    qryAtendimentosusuario.AsInteger    := CodigoUsuario;
    qryAtendimentosnomeusuario.AsString := NomeUsuario;

    qryAtendimentosusuariologado.AsInteger    := CodigoUsuario;
    qryAtendimentosnomeusuariologado.AsString := NomeUsuario;

    qryAtendimentosAssunto.asString := 'ORÇAMENTO Nº '+inttostr(Valores_Orcamento);
    qryAtendimentosstatus.asstring := 'F';


    qryAtendimentosorigem.clear;
    qryAtendimentosDataOrigem.clear;

    qryAtendimentosconcluido.AsBoolean  := true;

    if qryConsultaTiposAtendimentos.recordcount > 0 then
      qryAtendimentostipoatendimento.asinteger := qryConsultaTiposAtendimentoscodigo.asinteger;

    qryAtendimentoslembrar.clear;
    qryAtendimentoslembrarHora.clear;

  end
  else
  if Valores[0] = 'IncluirCancelamentoDiretoContrato' then
  begin

    Valores_CodigoCliente        := Valores[1];
    Valores_TipoCliente          := Valores[2];
    Valores_Atendimentode        := Valores[3];
    Valores_Contrato             := Valores[4];
    Valores_Assunto              := Valores[5];
    Valores_DescricaoSituacao    := Valores[6];

    qryConsultaTiposAtendimentos.Params[0].AsString:= Valores_Atendimentode;
    qryConsultaTiposAtendimentos.close;
    qryConsultaTiposAtendimentos.open;

    qryAtendimentos.append;
    qryAtendimentoscontrato.asString := Valores_contrato;
    qryAtendimentosdescricaosituacaocontrato.asString := Valores_DescricaoSituacao;

    qryProcuraClientes.ParamByName('tipocliente').AsString := Valores_TipoCliente;

    qryAtendimentoscliente.AsInteger    := Valores_CodigoCliente;
    qryAtendimentostipocliente.AsString := Valores_TipoCliente;
    qryAtendimentostipo.AsString        := Valores_Atendimentode;

    qryAtendimentosdata.AsDateTime      := DataServidor;

    qryAtendimentosusuario.AsInteger    := CodigoUsuario;
    qryAtendimentosnomeusuario.AsString := NomeUsuario;

    qryAtendimentosusuariologado.AsInteger    := CodigoUsuario;
    qryAtendimentosnomeusuariologado.AsString := NomeUsuario;

    qryAtendimentosAssunto.asString := 'CONTRATO Nº '+Valores_contrato;
    qryAtendimentosstatus.asstring := 'F';


    qryAtendimentosorigem.clear;
    qryAtendimentosDataOrigem.clear;

    qryAtendimentosconcluido.AsBoolean  := true;

    if qryConsultaTiposAtendimentos.recordcount > 0 then
      qryAtendimentostipoatendimento.asinteger := qryConsultaTiposAtendimentoscodigo.asinteger;

    qryAtendimentoslembrar.clear;
    qryAtendimentoslembrarHora.clear;

  end
  else
  if Valores[0] = 'IncluirFollowupOrcamento' then
  begin
    Valores_CodigoCliente        := Valores[1];
    Valores_TipoCliente          := Valores[2];
    Valores_Atendimentode        := Valores[3];
    Valores_Orcamento            := Valores[4];
    Valores_Assunto := Valores[5];
    Valores_DescricaoSituacao := Valores[6];
    Valores_DataValidade := Valores[7];

    qryExisteAtendimento2.macrobyname('Condicao').asString :=
   'orcamento = '+inttostr(Valores_Orcamento) + ' order by data desc, codigo desc limit 1';

    qryExisteAtendimento2.close;
    qryExisteAtendimento2.open;

    vOrigem := '';

    if Valores_DataValidade <> '' then
      if strtodate(Valores_DataValidade) >= DataServidor then
        vLembrar := Valores_DataValidade;

    if (qryExisteAtendimento2.RecordCount > 0) then
    begin
      if qryExisteAtendimento2origem.isnull then
        vOrigem := qryExisteAtendimento2codigo.asString
      else
        vOrigem := qryExisteAtendimento2origem.asString;

      if qryExisteAtendimento2lembrar.asDateTime >= DataServidor then
      begin
        vLembrar := qryExisteAtendimento2lembrar.asString;
        vLembrarHora := qryExisteAtendimento2lembrarHora.asString;
      end;

      vfichaalerta := qryExisteAtendimento2fichaalerta.asString;
    end;

    qryConsultaTiposAtendimentos.Params[0].AsString:= Valores_Atendimentode;
    qryConsultaTiposAtendimentos.close;
    qryConsultaTiposAtendimentos.open;

    qryAtendimentos.append;

    qryAtendimentosorcamento.asString := inttostr(Valores_Orcamento);
    qryAtendimentosdescricaosituacaoorcamento.asString := Valores_DescricaoSituacao;

    qryProcuraClientes.ParamByName('tipocliente').AsString := Valores_TipoCliente;

    qryAtendimentoscliente.AsInteger    := Valores_CodigoCliente;
    qryAtendimentostipocliente.AsString := Valores_TipoCliente;
    qryAtendimentostipo.AsString        := Valores_Atendimentode;

    qryAtendimentosdata.AsDateTime      := DataServidor;

    qryAtendimentosusuario.AsInteger    := CodigoUsuario;
    qryAtendimentosnomeusuario.AsString := NomeUsuario;

    qryAtendimentosusuariologado.AsInteger    := CodigoUsuario;
    qryAtendimentosnomeusuariologado.AsString := NomeUsuario;

{    if Valores_Assunto <> '' then
      qryAtendimentosAssunto.asString := Valores_Assunto
    else}
      qryAtendimentosAssunto.asString := 'ORÇAMENTO Nº '+inttostr(Valores_Orcamento);

    qryAtendimentosorigem.asstring := vorigem;
    qryAtendimentosDataOrigem.asString := vDataOrigem;

    qryAtendimentosconcluido.AsBoolean  := False;

    qryAtendimentosfichaalerta.asString := vfichaalerta;

    if qryConsultaTiposAtendimentos.recordcount > 0 then
      qryAtendimentostipoatendimento.asinteger := qryConsultaTiposAtendimentoscodigo.asinteger;

    if vLembrar <> '' then
      qryAtendimentoslembrar.asString := vLembrar;
{    else
      qryAtendimentoslembrar.asDatetime := DataServidor; }

    if vLembrarHora <> '' then
      qryAtendimentoslembrarHora.asString := vLembrarHora
    else
      qryAtendimentoslembrarHora.clear;
  end
  else
  if Valores[0] = 'IncluirFollowupRomaneio' then
  begin
    Valores_CodigoCliente        := Valores[1];
    Valores_TipoCliente          := Valores[2];
    Valores_Atendimentode        := Valores[3];
    Valores_Romaneio             := Valores[4];
    Valores_RomaneioDadoFiscal   := Valores[5];
    Valores_Assunto              := Valores[6];
{   Valores_DescricaoSituacao    := Valores[6];
    Valores_DataValidade         := Valores[7];
 }

    qryExisteAtendimento2.macrobyname('Condicao').asString :=
   'romaneio = '+inttostr(Valores_romaneio) +  ' and dadofiscalromaneio = ' + inttostr(Valores_RomaneioDadoFiscal) +  ' order by data desc, codigo desc limit 1';

    qryExisteAtendimento2.close;
    qryExisteAtendimento2.open;

    vOrigem := '';

    if Valores_DataValidade <> '' then
      if strtodate(Valores_DataValidade) >= DataServidor then
        vLembrar := Valores_DataValidade;

    if (qryExisteAtendimento2.RecordCount > 0) then
    begin
      if qryExisteAtendimento2origem.isnull then
        vOrigem := qryExisteAtendimento2codigo.asString
      else
        vOrigem := qryExisteAtendimento2origem.asString;

      if qryExisteAtendimento2lembrar.asDateTime >= DataServidor then
      begin
        vLembrar := qryExisteAtendimento2lembrar.asString;
        vLembrarHora := qryExisteAtendimento2lembrarHora.asString;
      end;

      vfichaalerta := qryExisteAtendimento2fichaalerta.asString;
    end;

    qryConsultaTiposAtendimentos.Params[0].AsString:= Valores_Atendimentode;
    qryConsultaTiposAtendimentos.close;
    qryConsultaTiposAtendimentos.open;

    qryAtendimentos.append;

    qryAtendimentosromaneio.asString := inttostr(Valores_romaneio);
