  object qryParcelasAvisos_Clientes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select  p.contrato,'
      '            p.numero,'
      '            p.datavencto,'
      '            p.valorvencto,'
      '            t1.data,'
      '            abs(p.datavencto - current_date) as diasatraso,'
      '            cast(c.nome as varchar) as nomeAvalista,'
      '            False as eAvalista            '
      
        'From   parcelas p, (contratos t1 left join clientes c on t1.aval' +
        'ista = c.codigo)'
      'Where  (p.contrato = t1.numero)  '
      '     and (t1.cliente =:cliente) '
      '     and (t1.tipocliente =:tipo)'
      '     and (coalesce(t1.avalista,0) = coalesce(:avalista,0))'
      
        '     and p.cartacliente is not null and p.cartanumerocliente is ' +
        'not null    '
      'Order By p.contrato, p.numero')
    RequestLive = False
    Left = 462
    Top = 142
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'tipo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'avalista'
        ParamType = ptUnknown
      end>
  end
