  object qryDadosClientes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select cast(coalesce(vf.razao,vf.nome) as varchar(100)) as nome,'
      '       formatar_cpf_cnpj(vf.pessoanumero) as cpf_cnpj,'
      '       c.iddocumento,'
      
        '       cast(formatar_fone_fax(vf.foneddd,vf.fonenumero,vf.fonera' +
        'mal) as varchar(40))as fone,'
      
        '       cast(formatar_fone_fax(c.fone2ddd,c.fone2numero,c.fone2ra' +
        'mal) as varchar(40))as fone2,'
      
        '       cast(formatar_fone_fax(vf.fonedddempresa,vf.fonenumeroemp' +
        'resa,vf.foneramalempresa)as varchar(40)) as foneempresa,'
      
        '       cast(formatar_fone_fax(c2.foneddd, c2.fonenumero, c2.fone' +
        'ramal)as varchar(40)) as foneconjuge,'
      
        '       cast(formatar_fone_fax(c.reffoneddd,c.reffonenumero,c.ref' +
        'foneramal)as varchar(40)) as fonereferencia,'
      
        '       cast(formatar_fone_fax(c.reffone2ddd,c.reffone2numero,c.r' +
        'effone2ramal) as varchar(40)) as fonereferencia2,'
      '       vf.rua,'
      '       vf.numero,'
      '       vf.complemento,'
      '       vf.estado,'
      '       vf.empresa,'
      '       (select cl.nome from clientes cl'
      
        '                                Where cl.codigo = vf.conjuge) as' +
        ' nomeconjuge,'
      
        '       cast(substr(vf.cep,1,2) || '#39'.'#39' || substr(vf.cep,3,3) || '#39 +
        '-'#39' || substr(vf.cep,6,3) as varchar) as cep,'
      '       (Select b.nome From bairros b'
      '                                Where (b.estado = vf.estado) and'
      
        '                                      (b.cidade = vf.cidade) and' +
        ' '
      
        '                                      (b.codigo = vf.bairro)) as' +
        ' nomebairro,'
      '       (Select c.nome From cidades c'
      '                                Where (c.estado = vf.estado) and'
      
        '                                      (c.codigo = vf.cidade)) as' +
        ' nomecidade'
      
        'From     vfornecedores vf left join clientes c on ((vf.codigo = ' +
        'c.codigo) and (vf.tipo = '#39'C'#39'))'
      
        '                                        left join clientes c2 on' +
        ' c2.codigo = vf.conjuge'
      'Where   (vf.codigo  =:cliente) and'
      '             (vf.tipo =:tipo)')
    RequestLive = False
    Left = 454
    Top = 13
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'tipo'
        ParamType = ptUnknown
      end>
    object qryDadosClientesnome: TStringField
      FieldName = 'nome'
      Size = 100
    end
    object qryDadosClientescpf_cnpj: TStringField
      FieldName = 'cpf_cnpj'
      Size = 50
    end
    object qryDadosClientesiddocumento: TStringField
      FieldName = 'iddocumento'
    end
    object qryDadosClientesfone: TStringField
      FieldName = 'fone'
      Size = 40
    end
    object qryDadosClientesfone2: TStringField
      FieldName = 'fone2'
      Size = 40
    end
    object qryDadosClientesfoneempresa: TStringField
      FieldName = 'foneempresa'
      Size = 40
    end
    object qryDadosClientesfoneconjuge: TStringField
      FieldName = 'foneconjuge'
      Size = 40
    end
    object qryDadosClientesfonereferencia: TStringField
      FieldName = 'fonereferencia'
      Size = 40
    end
    object qryDadosClientesfonereferencia2: TStringField
      FieldName = 'fonereferencia2'
      Size = 40
    end
    object qryDadosClientesrua: TStringField
      FieldName = 'rua'
      Size = 100
    end
    object qryDadosClientesnumero: TIntegerField
      FieldName = 'numero'
    end
    object qryDadosClientescomplemento: TStringField
      FieldName = 'complemento'
      Size = 100
    end
    object qryDadosClientesestado: TStringField
      FieldName = 'estado'
      Size = 2
    end
    object qryDadosClientesempresa: TStringField
      FieldName = 'empresa'
      Size = 50
    end
    object qryDadosClientesnomeconjuge: TStringField
      FieldName = 'nomeconjuge'
      Size = 50
    end
    object qryDadosClientescep: TStringField
      FieldName = 'cep'
      Size = 50
    end
    object qryDadosClientesnomebairro: TStringField
      FieldName = 'nomebairro'
      Size = 50
    end
    object qryDadosClientesnomecidade: TStringField
      FieldName = 'nomecidade'
      Size = 50
    end
  end
