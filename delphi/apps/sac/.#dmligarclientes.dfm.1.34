    DataSet = qryParcelas
    Left = 573
    Top = 78
  end
  object qryLigarClientes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnProgress = ShowProgress
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Grupo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Agente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Conceito'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Regiao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Data_Vencto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Data_Venda'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Data_Pagto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Ocorrencia'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Marcadosparanaoligar'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Telefone'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'PosOcorrencia'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Com_ou_Sem_Cobrador'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Ordenacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'Select  ct.cliente,'
      '        ct.tipocliente as clientetipo,'
      '        vf.nome,'
      ''
      '        (Select a1.informes'
      '         From atendimentos a1'
      '         Where a1.cliente = ct.cliente'
      '          and a1.tipocliente = ct.tipocliente'
      '          and a1.tipo = '#39'C'#39
      '         Order By a1.data desc'
      '         limit 1) as informescobranca,'
      ''
      '         (Select a2.informes'
      '          From atendimentos a2'
      '          Where a2.cliente = ct.cliente'
      '            and a2.tipocliente = ct.tipocliente'
      '            and a2.tipo = '#39'R'#39
      '          Order By a2.data desc'
      '          limit 1) as informesreclamacao,'
      ''
      '          Min(ct.data) as data,'
      '          cast(Min(ct.numero) as varchar) as contrato,'
      
        '          (select ct2.os from contratos ct2 where ct2.numero = c' +
        'ast(Min(ct.numero) as varchar(20)))  as os,'
      ''
      
        '          notas_notasdocontrato(CAST(Min(ct.numero) as varchar))' +
        ' AS notasdocontrato,'
      '          Count(p.numero) as qtde,'
      '          Min(p.datavencto) as datavencto,'
      '          Sum(p.valorvencto) as atrasado,'
      
        '          coalesce((select c.naoligar from clientes c where c.co' +
        'digo = ct.cliente and ct.tipocliente = '#39'C'#39'),false) as naoligar,'
      
        '          (select c.razaonaoligar from clientes c where c.codigo' +
        ' = ct.cliente and ct.tipocliente = '#39'C'#39') as razaonaoligar,'
      '          false as comcontato'
      ''
      'From parcelas p'
      '     join  contratos ct'
      '           join vfornecedores vf'
      '           on ct.cliente = vf.codigo'
      '           and ct.tipocliente = vf.tipo'
      '     on p.contrato = ct.numero'
      ''
      'Where p.contrato = ct.numero'
      '  AND ct.cliente = vf.codigo'
      '  AND ct.tipocliente = vf.tipo'
      '  AND ct.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39')'
      
        '  and ct.numero not in (select ct.origem from contratos ct where' +
        ' ct.origem = ct.numero)'
      '  and p.datavencto < current_date'
      '  and p.datapagto is null  '
      ''
      '%Filial'
      '%Grupo'
      ''
      '%Agente'
      '%Conceito'
      '%Regiao'
      '%Data_Vencto'
      '%Data_Venda'
      '%Data_Pagto'
      '%Ocorrencia'
      '%Marcadosparanaoligar'
      '%Telefone'
      '%PosOcorrencia'
      '%Com_ou_Sem_Cobrador'
      ''
      'Group By ct.cliente, ct.tipocliente, vf.nome, ct.nome'
      '%Ordenacao')
    RequestLive = True
    Left = 296
    Top = 407
    object qryLigarClientesqtde: TLargeintField
      FieldName = 'qtde'
    end
