  object qryLigarClientesAvisos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Filiais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Grupos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Agentes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Conceito'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Regiao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Telefones'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Com_ou_Sem_Cobrador'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Marcadosparanaoligar_Clientes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Marcadosparanaoligar_Avalistas'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Ordenacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '; select Atrasados.*,'
      '         (Select a1.informes From atendimentos a1'
      
        '                                         Where (a1.cliente = atr' +
        'asados.cliente) and'
      
        '                                                     (a1.tipocli' +
        'ente = atrasados.clientetipo) and'
      
        '                                                     (a1.tipo = ' +
        #39'C'#39')'
      '                                         Order By a1.data desc'
      
        '                                         limit 1) as informescob' +
        'ranca,'
      ''
      '         (Select a2.informes From atendimentos a2'
      
        '                                         Where (a2.cliente = atr' +
        'asados.cliente) and'
      
        '                                                     (a2.tipocli' +
        'ente = atrasados.clientetipo) and'
      
        '                                                     (a2.tipo = ' +
        #39'R'#39')'
      '                                         Order By a2.data desc'
      
        '                                         limit 1) as informesrec' +
        'lamacao,'
      ''
      '         false as comcontato,'
      '         cast((select textcat_all(distinct n.numero || '#39', '#39')'
      '          from notas n'
      '               join dadosfiscais df'
      '               on n.dadofiscal = df.numero'
      
        '          where df.contrato in (select p.contrato from parcelas ' +
        'p where p.cartacliente = atrasados.carta and p.cartanumeroclient' +
        'e = atrasados.cartanumero)) as varchar(50))as NotasdoContrato'
      'from'
      '('
      '('
      ''
      'select ct.cliente,'
      '       ct.tipocliente as clientetipo,'
      '       ct.avalista,'
      '       ct.nome,'
      '       p.cartacliente as carta,'
      '       p.cartanumerocliente as cartanumero,'
      
        '       cast((p.cartacliente||'#39'.'#39'||p.cartanumerocliente) as varch' +
        'ar) as numerocarta,'
      '       false as eAvalista,'
      '       cr.tipocarta,'
      '       tc.tipoatendimento,'
      '       cast(cc.data as date) as data,'
      
        '       coalesce((select c.naoligar from clientes c where c.codig' +
        'o = ct.cliente and ct.tipocliente = '#39'C'#39'),false) as naoligar,'
      
        '      (select c.razaonaoligar from clientes c where c.codigo = c' +
        't.cliente and ct.tipocliente = '#39'C'#39') as razaonaoligar,'
      ''
      '       count(*) as Qtde,'
      '       min(p.datavencto) as datavencto,'
      '       sum(p.valorvencto) as atrasado,'
      ''
      '       cast(Min(ct.numero) as varchar) as contrato,'
      
        '       (select ct2.os from contratos ct2 where ct2.numero = cast' +
        '(Min(ct.numero) as varchar(20)))  as os'
      ''
      ''
      ''
      'from ((contratos ct'
      '       join (parcelas p'
      '             join (cartasclientes cc'
      '                   join (cartas cr'
      '                         join tiposcartas tc'
      '                         on cr.tipocarta = tc.codigo)'
      '                   on cc.carta = cr.numero)'
      '             on p.cartacliente = cc.carta and'
      '                p.cartanumerocliente = cc.numero)'
      '       on ct.numero = p.contrato)'
      ''
      '       join vfornecedores vf'
      '       on ct.cliente = vf.codigo'
      '       and ct.tipocliente = vf.tipo)'
      ''
      'where cc.enviada is null'
      ' and tc.tipo = '#39'A'#39
      ''
      ' and ((coalesce(cc.bloqueada,'#39#39')='#39#39')'
      ' or ((position('#39'3'#39' in coalesce(cc.bloqueada,'#39#39'))<>0) and'
      ' (SELECT (/*atendimentos.data = current_date or*/'
      '          atendimentos.semaviso is null or'
      '         (atendimentos.semaviso is not null and'
      '          atendimentos.semaviso < current_date)) as permitir'
      ' FROM atendimentos'
      ' WHERE atendimentos.tipo = '#39'C'#39
      ' AND NOT concluido'
      ' AND (atendimentos.cliente = cr.cliente'
      ' AND atendimentos.tipocliente = cr.tipocliente)'
      
        ' ORDER BY atendimentos.data DESC, atendimentos.codigo desc LIMIT' +
        ' 1) ))'
      ''
      ''
      '%Filiais'
      '%Grupos'
      '%Agentes'
      '%Conceito'
      '%Regiao'
      '%Telefones'
      '%Com_ou_sem_cobrador'
      '%Marcadosparanaoligar_Clientes'
      ''
      'group by ct.cliente,'
      '         ct.tipocliente,'
      '         ct.avalista,'
      '         ct.nome,'
      '         p.cartacliente,'
      '         p.cartanumerocliente,'
      '         cr.tipocarta,'
      '         tc.tipoatendimento,'
      '         cc.data,'
      '         naoligar,razaonaoligar'
      ''
      ')'
      'union all'
      '('
      'select ct.avalista,'
      '       ct.tipocliente as clientetipo,'
      '       ct.cliente,'
      '       c.nome,'
      '       p.cartaavalista as carta,'
      '       p.cartanumeroavalista as cartanumero,'
      
        '       cast((p.cartaavalista||'#39'.'#39'||p.cartanumeroavalista) as var' +
        'char) as numerocarta,'
      '       true as eAvalista,'
      '       cr.tipocarta,'
      '       tc.tipoatendimento,'
      '       cast(cc.data as date) as data,'
      '       c.naoligar,'
      '       c.razaonaoligar,'
      '       count(*) as Qtde,'
      '       min(p.datavencto) as datavencto,'
      '       sum(p.valorvencto) as atrasado,'
      ''
      '       cast(Min(ct.numero) as varchar) as contrato,'
      
        '       (select ct2.os from contratos ct2 where ct2.numero = cast' +
        '(Min(ct.numero) as varchar(20)))  as os'
      '       '
      ''
      'from ((contratos ct'
      '       join (parcelas p'
      '             join (cartasclientes cc'
      '                   join (cartas cr'
      '                         join tiposcartas tc'
      '                         on cr.tipocarta = tc.codigo)'
      '                   on cc.carta = cr.numero)'
      '             on p.cartaavalista = cc.carta and'
      '                p.cartanumeroavalista = cc.numero)'
      '       on ct.numero = p.contrato)'
      ''
      '       join clientes c'
      '       on ct.avalista = c.codigo)'
      ''
      'where cc.enviada is null'
      ' and tc.tipo = '#39'A'#39
      ' and ( (coalesce(cc.bloqueada,'#39#39')='#39#39') or'
      '       ((position('#39'3'#39' in coalesce(cc.bloqueada,'#39#39'))<>0) and'
      ''
      
        '        /*Falso p/ Avalista e Verdadeiro p/ Titular  = Verdadeir' +
        'o*/'
      
        '        (case when (not coalesce((SELECT (/*atendimentos.data = ' +
        'current_date or */'
      
        '                                    atendimentos.semaviso is nul' +
        'l or'
      
        '                                   (atendimentos.semaviso is not' +
        ' null and'
      
        '                                    atendimentos.semaviso < curr' +
        'ent_date))'
      '                            FROM atendimentos'
      '                            WHERE atendimentos.tipo = '#39'C'#39
      '                              AND NOT concluido'
      
        '                              AND (atendimentos.cliente = cr.ava' +
        'lista'
      
        '                              AND atendimentos.tipocliente = '#39'C'#39 +
        ')'
      
        '                            ORDER BY atendimentos.data DESC, ate' +
        'ndimentos.codigo DESC LIMIT 1), true) and'
      ''
      
        '                    coalesce((SELECT (/*atendimentos.data = curr' +
        'ent_date or*/'
      '                              atendimentos.semaviso is null or'
      
        '                             (atendimentos.semaviso is not null ' +
        'and'
      
        '                              atendimentos.semaviso < current_da' +
        'te))'
      '                              FROM atendimentos'
      '                              WHERE atendimentos.tipo = '#39'C'#39
      '                                AND NOT concluido'
      
        '                                AND (atendimentos.cliente = cr.c' +
        'liente'
      
        '                                AND atendimentos.tipocliente = c' +
        'r.tipocliente)'
      
        '                              ORDER BY atendimentos.data DESC, a' +
        'tendimentos.codigo desc LIMIT 1),true)) then true'
      '         else'
      ''
      
        '         /* Verdadeiro p/ Avalista e Verdadeiro p/ Titular  = Ve' +
        'rdadeiro'
      '            Verdadeiro p/ Avalista e Falsoe p/ Titular  = Falso'
      '            Falso p/ Avalista e Falso p/ Titular  = Falso */'
      ''
      
        '                 coalesce((SELECT (/*atendimentos.data = current' +
        '_date or*/'
      
        '                                    atendimentos.semaviso is nul' +
        'l or'
      
        '                                   (atendimentos.semaviso is not' +
        ' null and'
      
        '                                    atendimentos.semaviso < curr' +
        'ent_date))'
      '                            FROM atendimentos'
      '                            WHERE atendimentos.tipo = '#39'C'#39
      '                              AND NOT concluido'
      
        '                              AND (atendimentos.cliente = cr.ava' +
        'lista'
      
        '                              AND atendimentos.tipocliente = '#39'C'#39 +
        ')'
      
        '                            ORDER BY atendimentos.data DESC, ate' +
        'ndimentos.codigo desc LIMIT 1), true) and'
      ''
      
        '                  coalesce((SELECT (/*atendimentos.data = curren' +
        't_date or*/'
      
        '                                  atendimentos.semaviso is null ' +
        'or'
      
        '                                 (atendimentos.semaviso is not n' +
        'ull and'
      
        '                                  atendimentos.semaviso < curren' +
        't_date))'
      '                                  FROM atendimentos'
      '                                  WHERE atendimentos.tipo = '#39'C'#39
      '                                    AND NOT concluido'
      
        '                                    AND (atendimentos.cliente = ' +
        'cr.cliente'
      
        '                                    AND atendimentos.tipocliente' +
        ' = cr.tipocliente)'
      
        '                                  ORDER BY atendimentos.data DES' +
        'C, atendimentos.codigo desc LIMIT 1),true)'
      '        end)))'
      ''
      '%Filiais'
      '%Grupos'
      '%Agentes'
      '%Conceito'
      '%Regiao'
      '%Telefones'
      '%Com_ou_sem_cobrador'
      '%Marcadosparanaoligar_Avalistas'
      ''
      'group by ct.avalista,'
      '         ct.cliente,'
      '         ct.tipocliente,'
      '         c.nome,'
      '         p.cartaavalista,'
      '         p.cartanumeroavalista,'
      '         cr.tipocarta,'
      '         tc.tipoatendimento,'
      '         cc.data,'
      '         c.naoligar,c.razaonaoligar'
      ')'
      ') as Atrasados'
      ''
      '%Ordenacao')
    RequestLive = True
    Left = 432
    Top = 368
