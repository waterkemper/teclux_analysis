  object qryParcelasAtrasosLembretes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select  p.contrato,'
      '            p.numero,'
      '            p.datavencto,'
      '            p.valorvencto,'
      '            t1.data,'
      '            abs(p.datavencto - current_date) as diasatraso,'
      '            false as eAvalista,'
      '            cast(c.nome as varchar) as nomeavalista'
      
        'From   parcelas p, (contratos t1 left join clientes c on t1.aval' +
        'ista = c.codigo)'
      'Where  (p.contrato = t1.numero) '
      '     and (p.datavencto < current_date)'
      '     and (p.datapagto is null)         '
      '     and (t1.cliente =:cliente) '
      '     and (t1.tipocliente =:tipo)'
      '     and (t1.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39') '
      '     and (t1.origem is null))'
      'Order By p.contrato, p.numero')
    RequestLive = False
    Left = 462
    Top = 246
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'tipo'
        ParamType = ptUnknown
      end>
  end
  object qryLigarClientesLembretes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryLigarClientesLembretesBeforeOpen
    OnCalcFields = qryLigarClientesLembretesCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Filiais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Regiao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Cobradores'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'GrupoCobradores'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Vendedores'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'GrupoVendedores'
        ParamType = ptUnknown
      end
