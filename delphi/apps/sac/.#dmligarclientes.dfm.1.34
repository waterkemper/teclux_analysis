        Name = 'Conceito'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Data_Vencto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Lembrar'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'LembrarHora'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Ocorrencia'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Marcadosparanaoligar'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Regiao2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Cobradores2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'GrupoCobradores2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Vendedores2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'GrupoVendedores2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Conceito2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Data_Vencto2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Ocorrencia2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Marcadosparanaoligar2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Ordenacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'WITH atendimentos_ as'
      ''
      '('
      ''
      ''
      
        'select a.cliente, a.tipocliente as clientetipo, vf.nome, a.data,' +
        ' a.lembrar, a.codigo, coalesce(a.origem, a.codigo) as origem,  a' +
        '.tipo, a.assunto,'
      
        '       a.tipoatendimento, ta.descricao as descricaotipoatendimen' +
        'to,'
      ''
      
        '       cast(cast(a.lembrar as varchar)||'#39' '#39'||cast(a.lembrarhora ' +
        'as varchar) as timestamp) as lembrardatahora, a.orcamento, a.con' +
        'trato, ct.os,'
      #9'   a.datainclusao,'
      ''
      '       (Select a1.informes'
      '        From atendimentos a1'
      '        Where (a1.cliente = a.cliente) and'
      '              (a1.tipocliente = a.tipocliente) and'
      '              (a1.tipo = '#39'C'#39')'
      '        Order By a1.data desc'
      '        limit 1) as informescobranca,'
      ''
      '       (Select a2.informes'
      '        From atendimentos a2'
      '        Where (a2.cliente = a.cliente) and'
      '              (a2.tipocliente = a.tipocliente) and'
      '              (a2.tipo = '#39'R'#39')'
      '        Order By a2.data desc'
      '        limit 1) as informesreclamacao,'
      ''
      
        '        coalesce((select c.naoligar from clientes c where c.codi' +
        'go = a.cliente and a.tipocliente = '#39'C'#39'),false) as naoligar,'
      
        '        (select c.razaonaoligar from clientes c where c.codigo =' +
        ' a.cliente and a.tipocliente = '#39'C'#39') as razaonaoligar,'
      ''
      ''
      '   case when a.tipocliente = '#39'C'#39' then'
      ''
      '   coalesce('
      '             ('
      '                select'
      '                   c.naoligar'
      '                from'
      '                   clientes c'
      '                where'
      '                   c.codigo          = a.cliente'
      '                   and a.tipocliente = '#39'C'#39
      '            )'
      '            ,false)'
      ''
      '            else false end as naoligar,'
      ''
      ''
      ''
      '   case when a.tipocliente = '#39'C'#39' then'
      '            '
      '   ('
      '      select'
      '         c.razaonaoligar'
      '      from'
      '         clientes c'
      '      where'
      '         c.codigo          = a.cliente'
      '         and a.tipocliente = '#39'C'#39
      '   ) else cast(null as varchar(760)) end as razaonaoligar ,'
      ''
      ''
      ''
      ''
      '        false as comcontato,'
      ''
      '      case when a.origem is null then a.data else'
      '      (select a2.data'
      '      from atendimentos a2'
      '      where a2.codigo = a.origem) end as datainicio,'
      ''
      
        '      /*  (select a2.data from atendimentos a2 where a2.codigo =' +
        ' coalesce(a.origem, a.codigo)) as datainicio,*/'
      ''
      ''
      '   case when a.origem is null then a.informes else'
      '      (select'
      '         a2.informes'
      '      from'
      '         atendimentos a2'
      '      where'
      '         a2.origem = a.origem'
      '      order by'
      '         a2.data desc'
      '       , a2.codigo desc limit 1) end as informeultimocontato,'
      ''
      
        '/*        (select a2.informes from atendimentos a2 where coalesc' +
        'e(a2.origem, a2.codigo) = coalesce(a.origem,a.codigo) order by a' +
        '2.data desc, a2.codigo desc limit 1) as informeultimocontato,*/'
      ''
      '        a.usuario as vendedor,'
      '        uc.nome as nomevendedor,'
      ''
      
        '/*        (select u.nome from usuarios u where u.codigo = a.usua' +
        'rio) as nomevendedor, */'
      ''
      
        '        coalesce(o.filial,ct.filialvenda,a.filial) as filialvend' +
        'a,'
      ''
      '        /*'
      
        '        coalesce((select o.filial from orcamentos o where o.codi' +
        'go = a.orcamento),'
      
        '                 (select ct.filialvenda from contratos ct where ' +
        'ct.numero = a.contrato), a.filial) as filialvenda,'
      '                 */'
      ''
      '        case when a.contrato is not null '
      
        '        and ct.situacao in ('#39'N'#39','#39'P'#39') then notas_notasdocontrato(' +
        'a.contrato) else cast(null as varchar) end as notasdocontrato,'
      ''
      
        '/*        notas_notasdocontrato(a.contrato) as notasdocontrato, ' +
        '*/'
      ''
      '        a.status'
      ''
      'from (((((atendimentos a'
      '        join vfornecedores vf'
      '        on a.cliente = vf.codigo'
      '        and a.tipocliente = vf.tipo)'
      ''
      '        left join tiposatendimentos ta'
      '        on a.tipoatendimento = ta.codigo)'
      ''
      '        join (usuarios uc'
      '                  left join GruposUsuarios guc'
      '                  on uc.grupo = guc.codigo)'
      '        on a.usuario = uc.codigo)'
      ''
      ''
      '        left join (contratos ct'
      '                   join (usuarios uvc'
      '                             left join GruposUsuarios guvc'
      '                             on uvc.grupo = guvc.codigo)'
      '                   on ct.vendedor = uvc.codigo)'
      '        on a.contrato = ct.numero)'
      ''
      ''
      '        left join (orcamentos o'
      '                   join (usuarios uvo'
      '                             left join GruposUsuarios guvo'
      '                             on uvo.grupo = guvo.codigo)'
      '                   on o.vendedor = uvo.codigo)'
      '        on a.orcamento = o.codigo)'
      ''
      ''
      'where a.status = '#39'A'#39
      
        ' and case when a.origem is not null then a.codigo = atendimento_' +
        'origem(a.codigo) else true end'
      ''
      '%Filiais'
      '%Regiao'
      ''
      '%Cobradores'
      '%GrupoCobradores'
      ''
      '%Vendedores'
      '%GrupoVendedores'
      ''
      '%Conceito'
      '%Data_Vencto'
      '%Lembrar'
      '%LembrarHora'
      '%Ocorrencia'
      '%Marcadosparanaoligar'
      ''
      ')'
      ''
      'select a.* from atendimentos_ a'
      '   '
      '   where'
      ''
      '   not exists (select a2.codigo'
      '                from /*((((*/ atendimentos a2'
      ''
      '/*'
      '                     join vfornecedores vf2'
      '                     on a2.cliente = vf2.codigo'
      '                     and a2.tipocliente = vf2.tipo)'
      ''
      ''
      '                      join (usuarios uc2'
      '                                left join GruposUsuarios guc2'
      '                                on uc2.grupo = guc2.codigo)'
      '                      on a2.usuario = uc2.codigo)'
      ''
      ''
      '                      left join (contratos ct2'
      '                                 join (usuarios uvc2'
      
        '                                           left join GruposUsuar' +
        'ios guvc2'
      
        '                                           on uvc2.grupo = guvc2' +
        '.codigo)'
      '                                 on ct2.vendedor = uvc2.codigo)'
      '                      on a2.contrato = ct2.numero)'
      ''
      ''
      '                      left join (orcamentos o2'
      '                                 join (usuarios uvo2'
      
        '                                           left join GruposUsuar' +
        'ios guvo2'
      
        '                                           on uvo2.grupo = guvo2' +
        '.codigo)'
      '                                 on o2.vendedor = uvo2.codigo)'
      '                      on a2.orcamento = o2.numero)'
      #9#9#9#9#9'  '
      #9#9#9#9#9'  */'
      ''
      ''
      '                where a2.status = '#39'A'#39
      '/*'#9#9#9#9'  and a2.origem is not null */'
      #9#9#9#9'  and a.origem = coalesce(a2.origem,a2.codigo)'
      ''
      '/*'
      '                %Regiao2'
      ''
      '                %Cobradores2'
      '                %GrupoCobradores2'
      ''
      '                %Vendedores2'
      '                %GrupoVendedores2'
      ''
      '                %Conceito2'
      '                %Data_Vencto2'
      ''
      '                %Ocorrencia2'
      '                %Marcadosparanaoligar2'
      ''
      #9#9#9#9'*/'
      ''
      '/*'
      
        '                and coalesce(a.origem, a.codigo) = coalesce(a2.o' +
        'rigem, a2.codigo)'
      #9#9#9#9'*/'
      '                and a.codigo <> a2.codigo'
      ''
      
        '                and ((cast(cast(a2.lembrar as varchar)||'#39' '#39'||cas' +
        't(a2.lembrarhora as varchar) as timestamp) >= a.lembrardatahora)'
      '                      and a2.datainclusao > a.datainclusao)'
      ''
      '                      '
      '                limit 1'
      '                '
      '                )'
      ''
      '%Ordenacao'
      ''
      '/*'
      ''
      ':LembrarHora'
      ''
      '*/')
    RequestLive = True
    Left = 528
    Top = 416
    ParamData = <
      item
        DataType = ftTime
        Name = 'LembrarHora'
        ParamType = ptUnknown
      end>
