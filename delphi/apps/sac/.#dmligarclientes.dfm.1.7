      '         Order By a1.data desc'
      '         limit 1) as informescobranca,'
      ''
      '         (Select a2.informes'
      '          From atendimentos a2'
      '          Where a2.cliente = ct.cliente'
      '            and a2.tipocliente = ct.tipocliente'
      '            and a2.tipo = '#39'R'#39
      '          Order By a2.data desc'
      '          limit 1) as informesreclamacao,'
      ''
      '          Min(ct.data) as data,'
      '          cast(Min(ct.numero) as varchar) as contrato,'
      '          Count(p.numero) as qtde,'
      '          Min(p.datavencto) as datavencto,'
      '          Sum(p.valorvencto) as atrasado,'
      
        '          coalesce((select c.naoligar from clientes c where c.co' +
        'digo = ct.cliente and ct.tipocliente = '#39'C'#39'),false) as naoligar,'
      
        '          (select c.razaonaoligar from clientes c where c.codigo' +
