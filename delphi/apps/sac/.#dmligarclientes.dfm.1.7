      '             on p.cartaavalista = cc.carta and'
      '                p.cartanumeroavalista = cc.numero)'
      '       on ct.numero = p.contrato)'
      ''
      '       join clientes c'
      '       on ct.avalista = c.codigo)'
      ''
      'where cc.enviada is null'
      ' and tc.tipo = '#39'A'#39
      ' and ( (coalesce(cc.bloqueada,'#39#39')='#39#39') or'
      '       ((position('#39'3'#39' in coalesce(cc.bloqueada,'#39#39'))<>0) and'
      ''
      
        '        /*Falso p/ Avalista e Verdadeiro p/ Titular  = Verdadeir' +
        'o*/'
      
        '        (case when (not coalesce((SELECT (/*atendimentos.data = ' +
        'current_date or */'
      
        '                                    atendimentos.semaviso is nul' +
        'l or'
      
        '                                   (atendimentos.semaviso is not' +
        ' null and'
      
        '                                    atendimentos.semaviso < curr' +
        'ent_date))'
      '                            FROM atendimentos'
      '                            WHERE atendimentos.tipo = '#39'C'#39
      '                              AND NOT concluido'
      
        '                              AND (atendimentos.cliente = cr.ava' +
        'lista'
      
        '                              AND atendimentos.tipocliente = '#39'C'#39 +
        ')'
      
        '                            ORDER BY atendimentos.data DESC, ate' +
        'ndimentos.codigo DESC LIMIT 1), true) and'
      ''
      
        '                    coalesce((SELECT (/*atendimentos.data = curr' +
        'ent_date or*/'
      '                              atendimentos.semaviso is null or'
      
        '                             (atendimentos.semaviso is not null ' +
        'and'
      
        '                              atendimentos.semaviso < current_da' +
        'te))'
      '                              FROM atendimentos'
      '                              WHERE atendimentos.tipo = '#39'C'#39
      '                                AND NOT concluido'
      
        '                                AND (atendimentos.cliente = cr.c' +
        'liente'
      
        '                                AND atendimentos.tipocliente = c' +
        'r.tipocliente)'
      
        '                              ORDER BY atendimentos.data DESC, a' +
        'tendimentos.codigo desc LIMIT 1),true)) then true'
      '         else'
      ''
      
        '         /* Verdadeiro p/ Avalista e Verdadeiro p/ Titular  = Ve' +
        'rdadeiro'
      '            Verdadeiro p/ Avalista e Falsoe p/ Titular  = Falso'
      '            Falso p/ Avalista e Falso p/ Titular  = Falso */'
      ''
      
        '                 coalesce((SELECT (/*atendimentos.data = current' +
        '_date or*/'
      
        '                                    atendimentos.semaviso is nul' +
        'l or'
      
        '                                   (atendimentos.semaviso is not' +
        ' null and'
      
        '                                    atendimentos.semaviso < curr' +
        'ent_date))'
      '                            FROM atendimentos'
      '                            WHERE atendimentos.tipo = '#39'C'#39
      '                              AND NOT concluido'
      
        '                              AND (atendimentos.cliente = cr.ava' +
        'lista'
      
        '                              AND atendimentos.tipocliente = '#39'C'#39 +
        ')'
      
        '                            ORDER BY atendimentos.data DESC, ate' +
        'ndimentos.codigo desc LIMIT 1), true) and'
      ''
      
        '                  coalesce((SELECT (/*atendimentos.data = curren' +
        't_date or*/'
      
        '                                  atendimentos.semaviso is null ' +
        'or'
      
        '                                 (atendimentos.semaviso is not n' +
        'ull and'
      
        '                                  atendimentos.semaviso < curren' +
        't_date))'
      '                                  FROM atendimentos'
      '                                  WHERE atendimentos.tipo = '#39'C'#39
      '                                    AND NOT concluido'
      
        '                                    AND (atendimentos.cliente = ' +
        'cr.cliente'
      
        '                                    AND atendimentos.tipocliente' +
        ' = cr.tipocliente)'
      
        '                                  ORDER BY atendimentos.data DES' +
        'C, atendimentos.codigo desc LIMIT 1),true)'
      '        end)))'
      ''
      '%Filiais'
      '%Grupos'
      '%Agentes'
      '%Conceito'
      '%Regiao'
      '%Telefones'
      '%Com_ou_sem_cobrador'
      '%Marcadosparanaoligar_Avalistas'
      ''
      'group by ct.avalista,'
      '         ct.cliente,'
      '         ct.tipocliente,'
      '         c.nome,'
      '         p.cartaavalista,'
      '         p.cartanumeroavalista,'
      '         cr.tipocarta,'
      '         tc.tipoatendimento,'
      '         cc.data,'
      '         c.naoligar,c.razaonaoligar'
      ')'
      ') as Atrasados'
      ''
      '%Ordenacao')
