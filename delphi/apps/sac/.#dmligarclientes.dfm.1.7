    Sql.Strings = (
      '; select Atrasados.*,'
      
        '             cast((Select substr(a1.informes,0,760) From atendim' +
        'entos a1'
      
        '                                             Where (a1.cliente =' +
        ' atrasados.cliente) and'
      
        '                                                         (a1.tip' +
        'ocliente = atrasados.clientetipo) and'
      
        '                                                         (a1.tip' +
        'o = '#39'C'#39')'
      
        '                                             Order By a1.data de' +
        'sc'
      
        '                                             limit 1) as varchar' +
        '(760)) as informescobranca,'
      
        '             cast((Select substr(a2.informes,0,760) From atendim' +
        'entos a2'
      
        '                                             Where (a2.cliente =' +
        ' atrasados.cliente) and'
      
        '                                                         (a2.tip' +
        'ocliente = atrasados.clientetipo) and'
      
        '                                                         (a2.tip' +
        'o = '#39'R'#39')'
      
        '                                             Order By a2.data de' +
        'sc'
      
        '                                             limit 1) as varchar' +
        '(760)) as informesreclamacao,'
      '             false as comcontato'
      'from'
      '('
      '('
      ''
      'select ct.cliente,'
      '       ct.tipocliente as clientetipo,'
      '       ct.avalista,'
      '       ct.nome,'
      '       p.cartacliente as carta,'
      '       p.cartanumerocliente as cartanumero,'
      
        '       cast((p.cartacliente||'#39'.'#39'||p.cartanumerocliente) as varch' +
        'ar) as numerocarta,'
      '       false as eAvalista,'
      '       cr.tipocarta,'
      '       tc.tipoatendimento,'
      '       cast(cc.data as date) as data,'
      
        '       coalesce((select c.naoligar from clientes c where c.codig' +
        'o = ct.cliente and ct.tipocliente = '#39'C'#39'),false) as naoligar,'
      
        '      (select c.razaonaoligar from clientes c where c.codigo = c' +
        't.cliente and ct.tipocliente = '#39'C'#39') as razaonaoligar,'
      ''
      '       count(*) as Qtde,'
      '       min(p.datavencto) as datavencto,'
      '       sum(p.valorvencto) as atrasado'
      ''
      'from ((contratos ct'
      '       join (parcelas p'
      '             join (cartasclientes cc'
      '                   join (cartas cr'
      '                         join tiposcartas tc'
      '                         on cr.tipocarta = tc.codigo)'
