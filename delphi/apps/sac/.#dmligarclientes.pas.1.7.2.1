begin
  case TipoPesquisa of
         tlcFILIAIS: ReFazConsulta(qryFiliais,[0],[qryConsultaFiliaiscodigo.AsInteger]);
   tlcGRUPOSFILIAIS: ReFazConsulta(qryGrupoFiliais,[0],[qryConsultaGruposFiliaiscodigo.AsInteger]);
      tlcCOBRADORES: ReFazConsulta(qryUsuarios,[0],[qryConsultaUsuarioscodigo.AsInteger]);
