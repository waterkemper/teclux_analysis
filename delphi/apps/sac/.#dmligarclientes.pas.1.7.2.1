procedure TdtmLigarClientes.ZMonitor1MonitorEvent(Sql, Result: String);
var
 Listar : TStringList;
 arquivo: String;
begin
  inherited;
  arquivo:='c:\dmligarclientes.sql';
  Listar := tStringlist.create;
  if fileexists(arquivo) then
    Listar.loadfromfile(arquivo);
  Listar.add('');
  Listar.add(sql);
  Listar.add(result);
  listar.savetofile(arquivo);
  listar.free;
end;

procedure TdtmLigarClientes.SetMarcadosparanaoligar(const Value: Byte);
const
  Marcadosparanaoligar = 'and coalesce((Select c.naoligar From clientes c ' +
                                'Where (c.codigo = ct.cliente) and '     +
                                '      (ct.tipocliente = ''C'')),false)';

  NaoMarcadosparanaoligar = 'and coalesce((Select not c.naoligar From clientes c ' +
                                'Where (c.codigo = ct.cliente) and '     +
                                '      (ct.tipocliente = ''C'')),true)';

  Marcadosparanaoligar_Clientes = 'and coalesce((Select c.naoligar From clientes c ' +
                                  ' Where (c.codigo = ct.cliente) and '     +
                                  '      (ct.tipocliente = ''C'')),false)';

  NaoMarcadosparanaoligar_Clientes = 'and coalesce((Select not c.naoligar From clientes c ' +
                                ' Where (c.codigo = ct.cliente) and '     +
                                '      (ct.tipocliente = ''C'')),true)';

  Marcadosparanaoligar_Avalistas = 'and c.naoligar ';

  NaoMarcadosparanaoligar_Avalistas = 'and not c.naoligar ';


begin
  case value of
  0: begin
       qryLigarClientes.MacrobyName('Marcadosparanaoligar').asstring := Marcadosparanaoligar;
       qryLigarClientesLembretes.MacrobyName('Marcadosparanaoligar').asstring := Marcadosparanaoligar;

       qryLigarClientesAvisos.MacrobyName('Marcadosparanaoligar_Clientes').asstring := Marcadosparanaoligar_Clientes;
       qryLigarClientesAvisos.MacrobyName('Marcadosparanaoligar_Avalistas').asstring := Marcadosparanaoligar_Avalistas;
     end;
  1: begin
       qryLigarClientes.MacrobyName('Marcadosparanaoligar').asstring:= NaoMarcadosparanaoligar;
       qryLigarClientesLembretes.MacrobyName('Marcadosparanaoligar').asstring:= NaoMarcadosparanaoligar;

       qryLigarClientesAvisos.MacrobyName('Marcadosparanaoligar_Clientes').asstring := NaoMarcadosparanaoligar_Clientes;
       qryLigarClientesAvisos.MacrobyName('Marcadosparanaoligar_Avalistas').asstring := NaoMarcadosparanaoligar_Avalistas;
     end;
  2: begin
       qryLigarClientes.MacrobyName('Marcadosparanaoligar').asstring:= '';
       qryLigarClientesLembretes.MacrobyName('Marcadosparanaoligar').asstring:= '';

       qryLigarClientesAvisos.MacrobyName('Marcadosparanaoligar_Clientes').asstring:= '';
       qryLigarClientesAvisos.MacrobyName('Marcadosparanaoligar_Avalistas').asstring := '';
     end;
  end;
end;


