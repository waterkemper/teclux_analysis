procedure TdtmLigarClientes.SetOcorrencia(const Value: Byte);
const
  Ocorrencia_ct = '(Select count(*) From atendimentos a ' +
                                'Where (a.lembrar >= current_date) and '     +
                                '      (a.cliente   = ct.cliente)  and '     +
                                '      (a.tipocliente = ct.tipocliente) and' +
                                '      (a.tipo      = ''C''))';


  Ocorrencia_at = '(Select count(*) From atendimentos a1 ' +
                                'Where (a1.lembrar >= current_date) and '     +
                                '      (a1.cliente   = a.cliente)  and '     +
                                '      (a1.tipocliente = a.tipocliente) and' +
                                '      (a1.tipo      = ''C''))';

begin
  if (FTipoSelecao = 0) or
     (FTipoSelecao = 1) then begin
    case Value of
      0: begin
           qryLigarClientes.MacrobyName('Ocorrencia').asstring:= 'and (' + Ocorrencia_ct + ' = 0)';
           qryLigarClientesLembretes.MacrobyName('Ocorrencia').asstring:= 'and (' + Ocorrencia_at + ' = 0)';
         end;
      1: begin
           qryLigarClientes.MacrobyName('Ocorrencia').asstring:= '';
           qryLigarClientesLembretes.MacrobyName('Ocorrencia').asstring:= '';
         end;
    end;
  end
  else
  begin
    qryLigarClientes.MacrobyName('Ocorrencia').asstring:= '';
    qryLigarClientesLembretes.MacrobyName('Ocorrencia').asstring:= '';
  end;
end;

procedure TdtmLigarClientes.SetOrdenacao(const Value: Byte);
begin
  case value of
    0: begin
        qryLigarClientes.MacrobyName('Ordenacao').asstring:= 'ORDER BY UPPER(TO_ASCII(ct.nome,''LATIN1''))';
        qryLigarClientesLembretes.MacrobyName('Ordenacao').asstring:= 'ORDER BY UPPER(TO_ASCII(vf.nome,''LATIN1''))';
        qryLigarClientesAvisos.MacrobyName('Ordenacao').asstring:= 'Order By UPPER(TO_ASCII(nome,''LATIN1''))';
       end;
    1: begin
        qryLigarClientes.MacrobyName('Ordenacao').asstring:= 'Order By cliente';
        qryLigarClientesLembretes.MacrobyName('Ordenacao').asstring:= 'ORDER BY cliente';
        qryLigarClientesAvisos.MacrobyName('Ordenacao').asstring:= 'Order By cliente';
       end;
    2: begin
        qryLigarClientes.MacrobyName('Ordenacao').asstring:= 'Order By atrasado';
        qryLigarClientesAvisos.MacrobyName('Ordenacao').asstring:= 'Order By atrasado';
       end;
    3: begin
        qryLigarClientes.MacrobyName('Ordenacao').asstring:= 'Order By data';
        qryLigarClientesAvisos.MacrobyName('Ordenacao').asstring:= 'Order By data';
       end;
  end;
end;

procedure TdtmLigarClientes.SetPagamento(const Value: Byte);
begin
  if FTipoSelecao = 0 then begin
    case Value of
      0: begin
           qryLigarClientes.MacrobyName('Data_Pagto').asstring:= 'and (p.datavencto < current_date)';
           qryLigarClientes.MacrobyName('Data_Vencto').asstring:= '';
         end;
      1: qryLigarClientes.MacrobyName('Data_Pagto').asstring:= '';
      2: qryLigarClientes.MacrobyName('Data_Pagto').asstring:= 'and (0 = (Select Count(contrato) ' +
                                                          'From parcelas ' +
                                                          'Where (contrato = ct.numero)  and ' +
                                                          '      (datapagto is not null) and ' +
                                                          '      ((tipopagto is null) or not (tipopagto in (''X'',''P'')))))';
    end;
  end
  else qryLigarClientes.MacrobyName('Data_Pagto').asstring:= '';
end;

procedure TdtmLigarClientes.SetPosOcorrencia(const Value: Byte);
begin
  if FTipoSelecao = 1 then
  begin
    case Value of
      0: qryLigarClientes.MacrobyName('PosOcorrencia').asstring := 'and (a.data > (Select Max(coalesce(p2.datapagto,''01/01/1899''))' +
                                                     '               From parcelas p2, contratos t2'          +
                                                     '               Where (p2.contrato = t2.numero)'         +
                                                     '                 and (t2.cliente  = c1.codigo)'         +
                                                     '                 and (t2.tipocliente = c1.tipo)' +
                                                     '                 and (t2.situacao in (''F'',''N'',''P''))'    +
                                                     '                 and (t2.numero not in (select contratos.origem from contratos where contratos.origem = t2.numero))))';
    end;
  end
  else
    qryLigarClientes.MacrobyName('PosOcorrencia').asstring := '';
end;

