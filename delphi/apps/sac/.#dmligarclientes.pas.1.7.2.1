function TdtmLigarClientes.GetTotalRegistros: Real;
Var
 Valor : Currency;
begin
  Valor := 0;
  case TipoSelecao of
   0,1 : Valor := TotalizarValores[qryLigarClientes, qryLigarClientesatrasado, nil];
     2 : Valor := TotalizarValores[qryLigarClientesAvisos, qryLigarClientesAvisosatrasado, nil];
  end;
  Result := Valor;
end;

procedure TdtmLigarClientes.InformacoesCliente;
begin
 case TipoSelecao of
   0 : begin
         qryParcelas.Sql.Text := qryParcelasAtrasosLembretes.Sql.Text;
         ReFazConsulta(qryDadosClientes,[0,1],
            [qryLigarClientescliente.AsVariant,
             qryLigarClientesclientetipo.AsVariant]);
         ReFazConsulta(qryParcelas,[0,1],
            [qryLigarClientescliente.AsVariant,
             qryLigarClientesclientetipo.AsVariant]);
       end;

   1 : begin
         qryParcelas.Sql.Text := qryParcelasAtrasosLembretes.Sql.Text;

         ReFazConsulta(qryDadosClientes,[0,1],
            [qryLigarClientesLembretescliente.AsVariant,
             qryLigarClientesLembretestipocliente.AsVariant]);

         ReFazConsulta(qryParcelas,[0,1],
            [qryLigarClientesLembretescliente.AsVariant,
             qryLigarClientesLembretestipocliente.AsVariant]);
       end;

   2 : if qryLigarClientesAvisoseavalista.AsBoolean then
       begin
        qryParcelas.Sql.Text := qryParcelasAvisos_Avalistas.Sql.Text;
         ReFazConsulta(qryDadosClientes,[0,1],
            [qryLigarClientesAvisoscliente.AsVariant,'C']);
         ReFazConsulta(qryParcelas,[0,1,2],
            [qryLigarClientesAvisosavalista.AsVariant,
             qryLigarClientesAvisosclientetipo.AsVariant,
             qryLigarClientesAvisoscliente.AsVariant]);
       end
       else
       begin
        qryParcelas.Sql.Text := qryParcelasAvisos_Clientes.Sql.Text;
         ReFazConsulta(qryDadosClientes,[0,1],
            [qryLigarClientesAvisoscliente.AsVariant,
             qryLigarClientesAvisosclientetipo.AsVariant]);
         ReFazConsulta(qryParcelas,[0,1,2],
            [qryLigarClientesAvisoscliente.AsVariant,
             qryLigarClientesAvisosclientetipo.AsVariant,
             qryLigarClientesAvisosavalista.AsVariant]);
       end;
 end;

end;

procedure TdtmLigarClientes.MontarDataLembrar;
const
  Data_1: String = 'and (a.lembrar = ';
  Data_2: String = 'and (a.lembrar between (';
begin
  if not DataEmBranco(FLembrarInicial) then begin
    if DataEmBranco(FLembrarFinal) then
      qryLigarClientesLembretes.MacrobyName('Lembrar').asstring:= Data_1 + '''' + FLembrarInicial + ''')'
    else
      qryLigarClientesLembretes.MacrobyName('Lembrar').asstring:= Data_2 + '''' + FLembrarInicial + ''') and (''' + FLembrarFinal + '''))';
  end
  else
  begin
    if not DataEmBranco(FLembrarFinal) then
      qryLigarClientesLembretes.MacrobyName('Lembrar').asstring:= Data_1 + '''' + FLembrarFinal + ''')'
    else
      qryLigarClientesLembretes.MacrobyName('Lembrar').asstring:= '';
  end;
end;

procedure TdtmLigarClientes.MontarDataVencimento;
var
  Data_1: String;
  Data_2: String;
begin
  case FTipoSelecao of
  0: begin
      Data_1:= 'and (p.datavencto = ';
      Data_2:= 'and (p.datavencto between (';
     end;
  1: begin
      Data_1:= 'and (a.data = ';
      Data_2:= 'and (a.data between (';
     end;
  end;

  if not DataEmBranco(FVenctoInicial) then begin
    if DataEmBranco(FVenctoFinal) then
    begin
      qryLigarClientes.MacrobyName('Data_Vencto').asstring:= Data_1 + '''' + FVenctoInicial + ''')';
      qryLigarClientesLembretes.MacrobyName('Data_Vencto').asstring:= Data_1 + '''' + FVenctoInicial + ''')';
    end
    else
    begin
      qryLigarClientes.MacrobyName('Data_Vencto').asstring:= Data_2 + '''' + FVenctoInicial + ''') and (''' + FVenctoFinal + '''))';
      qryLigarClientesLembretes.MacrobyName('Data_Vencto').asstring:= Data_2 + '''' + FVenctoInicial + ''') and (''' + FVenctoFinal + '''))';
    end;
  end
  else begin
    if not DataEmBranco(FVenctoFinal) then
    begin
      qryLigarClientes.MacrobyName('Data_Vencto').asstring:= Data_1 + '''' + FVenctoFinal + ''')';
      qryLigarClientesLembretes.MacrobyName('Data_Vencto').asstring:= Data_1 + '''' + FVenctoFinal + ''')'
    end
    else
    begin
      qryLigarClientes.MacrobyName('Data_Vencto').asstring:= '';
      qryLigarClientesLembretes.MacrobyName('Data_Vencto').asstring:= '';
    end;
  end;

end;

