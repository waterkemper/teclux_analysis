    Sql.Strings = (
      ';select sel.*,'
      '        case when coalesce(sel.numero,0) <> 0 then'
      
        '           cast(sel.rua || '#39', '#39'|| cast(sel.numero as varchar) as' +
        ' varchar(120))'
      '         else'
      '           cast(sel.rua as varchar(120))'
      '         end as rua_e_numero'
      ' from'
      '('
      'Select cl.*,'
      '         formatar_cpf_cnpj(cl.pessoanumero) as cpfcnpjformatado,'
      
        '         formatar_fone_fax(cl.foneddd,cl.fonenumero,cl.foneramal' +
        ') as foneformatado,'
      
        '         formatar_fone_fax(cl.fone2ddd,cl.fone2numero,cl.fone2ra' +
        'mal) as foneformatado2,'
      '         ct.faturamento as ultimacompra,'
      '         ct.vendedor,'
      '         ct.valorprazo,'
      
        #9' (Select cd.nome From cidades cd Where (cd.estado = cl.estado) ' +
        'and (cd.codigo = cl.cidade)) as nomecidadecliente,'
      
        '         (Select ba.nome From bairros ba Where (ba.estado = cl.e' +
        'stado) and (ba.cidade = cl.cidade) and (ba.codigo = cl.bairro)) ' +
        'as nomebairrocliente,'
      
        '         (Select cd.nome From cidades cd Where (cd.estado = cl.e' +
        'mpestado) and (cd.codigo = cl.empcidade)) as nomecidadeempresa,'
      
        '         (Select ba.nome From bairros ba Where (ba.estado = cl.e' +
        'mpestado) and (ba.cidade = cl.empcidade) and (ba.codigo = cl.emp' +
        'bairro)) as nomebairroempresa,'
      
        '         (Select cd.nome From cidades cd Where (cd.estado = cl.c' +
        'onestado) and (cd.codigo = cl.concidade)) as nomecidadeconjuge,'
      
        '         (Select ba.nome From bairros ba Where (ba.estado = cl.c' +
        'onestado) and (ba.cidade = cl.concidade) and (ba.codigo = cl.con' +
        'bairro)) as nomebairroconjuge,'
      
        '         (Select cd.nome From cidades cd Where (cd.estado = cl.r' +
        'efestado) and (cd.codigo = cl.refcidade)) as nomecidadereferenci' +
        'a,'
      
        '         (Select ba.nome From bairros ba Where (ba.estado = cl.r' +
        'efestado) and (ba.cidade = cl.refcidade) and (ba.codigo = cl.ref' +
        'bairro)) as nomebairroreferencia,'
      
        '         (Select cd.nome From cidades cd Where (cd.estado = cl.n' +
        'aturalestado) and (cd.codigo = cl.naturalcidade)) as nomecidaden' +
        'aturalidade,'
      '         cl.datacadastro as DataCadastro,'
      
        '         (select count(*) FROM contratos WHERE situacao IN ('#39'N'#39',' +
        #39'P'#39','#39'F'#39') %CONTRATOSQUITADOS and cliente=cl.codigo AND tipoclient' +
        'e='#39'C'#39') as quantidade_compras,'
      
        '         (select sum(valorprazo) FROM contratos WHERE situacao I' +
        'N ('#39'N'#39','#39'P'#39','#39'F'#39') %CONTRATOSQUITADOS and cliente=cl.codigo AND tip' +
        'ocliente='#39'C'#39') as valor_compras'
      ''
      '         %Camposcontatosvfornecedores'
      ''
      'From clientes cl'
      
        '      left join contratos ct on (ct.numero=(select distinct ct1.' +
        'numero'
      #9#9#9#9#9#9#9#9#9#9#9'                      from contratos ct1'
      
        '                                                 join produtosco' +
        'ntratos pc'
      
        '                                                      join ((pro' +
        'dutos p left join promocoes pro on p.promocao = pro.codigo)'
      
        '                                                            join' +
        ' (((caracteristicas c'
      
        '                                                                ' +
        '    join classes cl'
      
        '                                                                ' +
        '    on c.classe=cl.codigo)'
      
        '                                                                ' +
        '    join grupos g'
      
        '                                                                ' +
        '    on g.codigo=c.grupo)'
      
        '                                                                ' +
        '    join marcas m'
      
        '                                                                ' +
        '    on c.marca = m.codigo)'
      
        '                                                            on p' +
        '.caracteristica=c.codigo)'
      ''
      
        '                                                      on pc.prod' +
        'uto = p.codigo'
      
        '                                                 on ct1.numero =' +
        ' pc.contrato'
      '                      '#9#9#9#9#9#9#9#9#9#9#9'where ct1.cliente=cl.codigo'
      #9#9#9#9#9#9#9#9#9#9#9'                      and ct1.tipocliente='#39'C'#39
      
        '                      '#9#9#9#9#9#9#9#9#9#9#9'and ct1.situacao IN ('#39'F'#39','#39'P'#39','#39'N' +
        #39')'
      #9#9#9#9#9#9#9#9#9#9#9'                      and faturamento is not null'
      ''
      '                                            %ListaItemProdutos'
      '                                            %ListaProdutos'
      '                                            %ListaGrupos'
      '                                            %ListaClasses'
      '                                            %ListaMarcas'
      
        '                                            %ListaCondicionalPro' +
        'mocoes'
      ''
      ''
      
        '                      '#9#9#9#9#9#9#9#9#9#9#9'ORDER BY faturamento desc LIMIT' +
        ' 1))'
      
        '      left join usuarios_site on (usuarios_site.cliente=cl.codig' +
        'o)'
      ''
      '      %sqlcontatosvfornecedores'
      
        '      left join contatosvfornecedores cvf on cl.codigo = cvf.cod' +
        'igovfornecedores and cvf.tipovfornecedores = '#39'C'#39
      ''
      'Where true'
      ''
      '%CONCEITOS'
      '%DATACADASTRO  /* n'#227'o presente em dependentes */'
      '%FILIAIS'
      '%ANIVERSARIANTES'
      '%NASCIMENTO'
      '%SEXO'
      '%CIVIL'
      '%CIDADE'
      '%REGIAO'
      '%SALARIO'
      '%CARGO'
      '%ULTIMACOMPRA'
      '%FILIALVENDA'
      '%VENDEDOR'
      '%EMATRASO'
      '%SEMTELEFONES'
      ''
      ' %CLIENTES_SITE         /* n'#227'o presente em dependentes */'
      ''
      ' %CLIENTES_PRODUTOS     /* n'#227'o presente em dependentes */'
      ''
      ''
      '%ORDERBY'
      ''
      ') as sel'
      'WHERE true'
      '%VALOR_COMPRAS'
      '')
