procedure TfrmEnquete.btnProximoClick(Sender: TObject);
begin
  inherited;
  if btnProximo.Caption = 'Concluir' then
  begin
    if ValidarRegistros then
      if dtmEnquete.SalvarEnquete(ckbMultipla, rgpUnica.Items[rgpUnica.itemindex], mmoTexto.text) then
      begin
         dtmEnquete.vCanClose := true;
         close;
      end
      else
        dtmEnquete.vCanClose := false;

  end
  else
    dtmEnquete.qryPerguntas.Next;

end;

function TfrmEnquete.ValidarRegistros: Boolean;
var
 i: integer;
begin

   result := false;

   with dtmEnquete do
   begin
     qryPerguntas.First;
     while not qryPerguntas.eof do
     begin

       if qryPerguntastipo.asString = 'múltipla' then
       begin
         for i:=0 to ckbMultipla.Count -1 do
           if ckbMultipla.Checked[i] then
           begin
             result := true;
             break;
           end;
       end
       else
       if qryPerguntastipo.asString = 'única' then
         result := rgpUnica.ItemIndex <> -1
       else
       if qryPerguntastipo.asString = 'texto' then
         result := mmoTexto.Text <> '';

       if not result then
       begin
         MensagemAviso('Preencha as opções solicitadas.');
         break;
       end
       else
         qryPerguntas.next;
     end;
  end;
end;

procedure TfrmEnquete.OperacaoPadrao(Value: array of Variant);
begin
  inherited;

  if dtmEnquete.qryQuestionario.RecordCount <> 0 then
  begin
    dtmEnquete.qryClientes.ParamByName('cliente').AsInteger := Value[0];
    dtmEnquete.qryClientes.ParamByName('tipocliente').AsString := Value[1];

    dtmEnquete.qryClientes.ParamByName('questionario').AsInteger := dtmEnquete.qryQuestionariocodigo.AsInteger;

    dtmEnquete.qryClientes.Close;
    dtmEnquete.qryClientes.open;

    if dtmEnquete.qryClientes.recordcount = 0 then
    begin
      dtmEnquete.vCanClose := true;
      close;
    end
    else
      showmodal;

  end
  else
  begin
    dtmEnquete.vCanClose := true;
    close;
  end;

end;

procedure TfrmEnquete.FormCloseQuery(Sender: TObject;
  var CanClose: Boolean);
begin
  inherited;

  CanClose := dtmEnquete.vCanClose;

end;


procedure AcionarTelaEnquete_(Cliente: integer; TipoCliente: String);
begin
  if not assigned(frmEnquete) then
    frmEnquete := TfrmEnquete.create(frmEnquete);

   frmEnquete.ckbMultipla.items.Clear;
   frmEnquete.rgpUnica.Items.Clear;
   frmEnquete.mmoTexto.Clear;
   dtmEnquete.vCanClose := false;


  if dtmEnquete.qryQuestionario.RecordCount <> 0 then
  begin
    dtmEnquete.qryClientes.ParamByName('cliente').AsInteger := Cliente;
    dtmEnquete.qryClientes.ParamByName('tipocliente').AsString := TipoCliente;

    dtmEnquete.qryClientes.ParamByName('questionario').AsInteger := dtmEnquete.qryQuestionariocodigo.AsInteger;

    dtmEnquete.qryClientes.Close;
    dtmEnquete.qryClientes.open;

    if dtmEnquete.qryClientes.recordcount = 0 then
    begin
      dtmEnquete.vCanClose := true;
      frmEnquete.close;
    end
    else
    begin
      frmEnquete.showmodal;
    end;

  end
  else
  begin
    dtmEnquete.vCanClose := true;
    frmEnquete.close;
  end;



end;

initialization
   AcionarTelaEnquete :=  AcionarTelaEnquete_;


end.
