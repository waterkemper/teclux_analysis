var
  frmEnquete: TfrmEnquete;
  AcionarTelaEnquete: procedure (cliente: integer; tipocliente: String);

implementation

{$R *.dfm}

{ TfrmEnquete }

constructor TfrmEnquete.Create(AOwner: TComponent);
begin
  dtmEnquete:= TdtmEnquete.Create(Self);
  inherited;
  DataSet := dtmEnquete.qryrespostas_clientes;
  dtmEnquete.PerguntasAfterScroll := PerguntasAfterScroll;
  ckbMultipla.items.Clear;
  rgpUnica.Items.Clear;
  mmoTexto.Clear;

  

end;

destructor TfrmEnquete.Destroy;
begin
  inherited;
  frmEnquete := nil;
end;

procedure TfrmEnquete.PerguntasAfterScroll(Sender: TObject);
begin
  if dtmEnquete.qryPerguntastipo.AsString = 'múltipla' then
  begin
    if ckbMultipla.Items.count = 0 then
      ckbMultipla.Items :=
         RetornarListaTString(dtmEnquete.qryRespostas,
                              dtmEnquete.qryRespostasresposta);

    pnlUnico.visible := false;
    gbxrespostas_clientestexto.visible := false;

    gbxMultiplos.visible := true;
//    DBAdvOfficeCheckGroup1.top := 56;

    gbxMultiplos.Height := dtmEnquete.qryRespostas.RecordCount * 30;
//    gbxMultiplos.BringToFront;

    ckbMultipla.SetFocus;

  end
  else
  if dtmEnquete.qryPerguntastipo.AsString = 'única' then
  begin

    if rgpUnica.Items.Count = 0 then
    begin
      rgpUnica.Items :=
         RetornarListaTString(dtmEnquete.qryRespostas,
                              dtmEnquete.qryRespostasresposta);

      rgpUnica.ItemIndex := 0;
    end;

    gbxMultiplos.visible := false;
    gbxrespostas_clientestexto.visible := false;

    pnlUnico.visible := true;
//    DBAdvOfficeRadioGroup1.top := 56;
    pnlUnico.Height := dtmEnquete.qryRespostas.RecordCount * 30;
//    DBAdvOfficeRadioGroup1.BringToFront;
    rgpUnica.setfocus;

  end
  else
  if dtmEnquete.qryPerguntastipo.AsString = 'texto' then
  begin

    gbxMultiplos.visible := false;
    pnlUnico.visible := false;
    gbxrespostas_clientestexto.visible := true;
//    gbxrespostas_clientestexto.top := 56;
//    DBAdvMemo2.BringToFront;
    mmoTexto.SetFocus;

  end;

  if (dtmEnquete.qryPerguntas.RecordCount = dtmEnquete.qryPerguntas.Recno) then
    btnProximo.Caption := 'Concluir'
  else
    btnProximo.Caption := 'Próximo';


end;

