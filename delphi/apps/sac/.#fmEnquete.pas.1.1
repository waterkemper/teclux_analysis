    dtxNomeCliente: TtecDBText;
    pnlQuestionario: TPanel;
    gbxEnquete: TGroupBox;
    DBAdvMemo1: TDBAdvMemo;
    DBTabControl1: TDBTabControl;
    rgpUnica: TRadioGroup;
    DBAdvMemo3: TDBAdvMemo;
    gbxrespostas_clientestexto: TGroupBox;
    ckbMultipla: TCheckListBox;
    gbxMultiplos: TGroupBox;
    mmoTexto: TtecMemo;
    pnlUnico: TPanel;
    btnProximo: TButton;
    procedure DBAdvOfficeCheckGroup1_Click(Sender: TObject);
    procedure rgpUnicaClick(Sender: TObject);
    procedure ckbMultiplaClick(Sender: TObject);
    procedure FormShow(Sender: TObject);
    procedure DBAdvOfficeCheckGroup1KeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure DBAdvMemo3Enter(Sender: TObject);
    procedure DBAdvMemo2KeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure mmoTextoChange(Sender: TObject);
    procedure btnProximoClick(Sender: TObject);
    procedure FormCloseQuery(Sender: TObject; var CanClose: Boolean);
  private
    { Private declarations }
    vkey : byte;
    procedure PerguntasAfterScroll(Sender: TObject);
  protected
    function InternoGravar: Boolean; Override;
    function ValidarRegistros: Boolean;
  public
    { Public declarations }
    constructor Create(AOwner: TComponent); override;
    destructor Destroy; override;
    procedure KeyDown(var Key: Word; Shift: TShiftState); override;
    procedure OperacaoPadrao(Value: Array of Variant); override;
