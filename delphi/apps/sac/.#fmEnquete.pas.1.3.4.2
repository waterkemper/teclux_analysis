function TfrmEnquete.ValidarRegistros: Boolean;
var
 i: integer;
begin

   result := false;

   with dtmEnquete do
   begin
     try

       qryPerguntas.AfterScroll := nil;
       qryPerguntas.BeforeScroll := nil;

       qryPerguntas.First;
       while not qryPerguntas.eof do
       begin

         qryRespostas.first;
         while not qryrespostas.Eof do
         begin

           if (qryPerguntastipo.asString = 'múltipla') then
           begin
             if qryrespostas_clientes.locate('resposta', qryRespostascodigo.asinteger, []) then
             begin
               result := true;
               break;
             end
             else
              result := false;
           end
           else
           if qryPerguntastipo.asString = 'única' then
           begin
             if qryrespostas_clientes.locate('resposta', qryRespostascodigo.asinteger, []) then
             begin
               result := true;
               break;
             end
             else
               result := false;
           end
           else
           if qryPerguntastipo.asString = 'texto' then
           begin
             if qryrespostas_clientes.locate('resposta', qryRespostascodigo.asinteger, []) then
             begin
               if qryrespostas_clientestexto.asstring <> '' then
               begin
                 result := true;
                 break;
               end
               else
                 result := false;
             end
             else
              result := false;
           end;

           qryRespostas.next;
         end;

         if not result then
         begin
           MensagemAviso('Preencha as opções solicitadas.');

           break;
         end
         else
           qryPerguntas.next;
       end;

     finally

       qryPerguntas.AfterScroll := qryPerguntasAfterScroll;
       qryPerguntas.BeforeScroll := qryPerguntasBeforeScroll;

       PerguntasAfterScroll(nil);


     end;

   end;
end;

procedure TfrmEnquete.OperacaoPadrao(Value: array of Variant);
begin
  inherited;

  if dtmEnquete.qryQuestionario.RecordCount <> 0 then
  begin
    dtmEnquete.qryClientes.ParamByName('cliente').AsInteger := Value[0];
    dtmEnquete.qryClientes.ParamByName('tipocliente').AsString := Value[1];

    dtmEnquete.qryClientes.ParamByName('questionario').AsInteger := dtmEnquete.qryQuestionariocodigo.AsInteger;

    dtmEnquete.qryClientes.Close;
    dtmEnquete.qryClientes.open;

    if dtmEnquete.qryClientes.recordcount = 0 then
    begin
      dtmEnquete.vCanClose := true;
      close;
    end
    else
      showmodal;

  end
  else
  begin
    dtmEnquete.vCanClose := true;
    close;
  end;

end;

procedure TfrmEnquete.FormCloseQuery(Sender: TObject;
  var CanClose: Boolean);
begin
  inherited;

  CanClose := dtmEnquete.vCanClose;

end;


procedure AcionarTelaEnquete_(Cliente: integer;
                              TipoCliente: String;
                              Orcamento: integer;
                              Contrato: string);
begin
  if not assigned(frmEnquete) then
    frmEnquete := TfrmEnquete.create(frmEnquete);

   frmEnquete.ckbMultipla.items.Clear;
   frmEnquete.rgpUnica.Items.Clear;
   frmEnquete.mmoTexto.Clear;
   dtmEnquete.vCanClose := false;


  if dtmEnquete.qryQuestionario.RecordCount <> 0 then
  begin
    dtmEnquete.qryClientes.ParamByName('cliente').AsInteger := Cliente;
    dtmEnquete.qryClientes.ParamByName('tipocliente').AsString := TipoCliente;
    dtmEnquete.qryClientes.ParamByName('orcamento').Asinteger := Orcamento;
    dtmEnquete.qryClientes.ParamByName('contrato').AsString := Contrato;
    dtmEnquete.qryClientes.ParamByName('questionario').AsInteger := dtmEnquete.qryQuestionariocodigo.AsInteger;

    dtmEnquete.qryClientes.Close;
    dtmEnquete.qryClientes.open;

    if dtmEnquete.qryClientes.recordcount = 0 then
    begin
      dtmEnquete.vCanClose := true;
      frmEnquete.close;
    end
    else
    begin
      frmEnquete.showmodal;
    end;

  end
  else
  begin
    dtmEnquete.vCanClose := true;
    frmEnquete.close;
  end;

end;

procedure TfrmEnquete.PerguntasBeforeScroll(Sender: TObject);
begin
  SalvarEnquete;
end;

procedure TfrmEnquete.SalvarEnquete;
var
 vUnica : String;

begin
  if rgpUnica.itemindex = -1 then
    vUnica := ''
  else
    vUnica := rgpUnica.Items[rgpUnica.itemindex];

  dtmEnquete.SalvarEnquete(ckbMultipla, rgpUnica, mmoTexto.text, (btnProximo.Caption = 'Concluir'));
end;

initialization
   AcionarTelaEnquete :=  AcionarTelaEnquete_;


end.
