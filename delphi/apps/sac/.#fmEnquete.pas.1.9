unit fmEnquete;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, fmcadastropadrao, ComCtrls, Buttons, ToolWin, ExtCtrls,
  StdCtrls, Mask, DBCtrls, cpdbtext, dmEnquete, AdvMemo, DBAdvMemo,
  AdvEdit, DBAdvEd, dbcgrids, DBTabControl, AdvOfficeButtons,
  DBAdvOfficeButtons, AdvGroupBox, biblio, CheckLst, cpdbmemo, cpmemo;

type
  TfrmEnquete = class(TFrmCadastroPadrao)
    pnlIdentificacaoCliente: TPanel;
    lblCliente: TStaticText;
    dtxCliente: TtecDBText;
    dtxNomeCliente: TtecDBText;
    pnlQuestionario: TPanel;
    gbxEnquete: TGroupBox;
    DBAdvMemo1: TDBAdvMemo;
    DBTabControl1: TDBTabControl;
    rgpUnica: TRadioGroup;
    DBAdvMemo3: TDBAdvMemo;
    gbxrespostas_clientestexto: TGroupBox;
    ckbMultipla: TCheckListBox;
    gbxMultiplos: TGroupBox;
    mmoTexto: TtecMemo;
    pnlUnico: TPanel;
    btnProximo: TButton;
    pnlEquipaentoOS: TPanel;
    StaticText1: TStaticText;
    dtxClienteOS: TtecDBText;
    dtxNomeClienteOS: TtecDBText;
    StaticText2: TStaticText;
    StaticText3: TStaticText;
    dtxEquipamentoOS: TtecDBText;
    dtxDescricaoEquipamentoOS: TtecDBText;
    dtxOrdemdeServico: TtecDBText;
    pnlBottom: TPanel;
    procedure FormShow(Sender: TObject);
    procedure DBAdvMemo2KeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure btnProximoClick(Sender: TObject);
    procedure FormCloseQuery(Sender: TObject; var CanClose: Boolean);
  private
    { Private declarations }
    vkey : byte;
    procedure PerguntasAfterScroll(Sender: TObject);
    procedure PerguntasBeforeScroll(Sender: TObject);
    procedure SalvarEnquete;

  protected
    function ValidarRegistros: Boolean;
  public
    { Public declarations }
    constructor Create(AOwner: TComponent); override;
    destructor Destroy; override;
    procedure KeyDown(var Key: Word; Shift: TShiftState); override;
{    procedure OperacaoPadrao(Value: Array of Variant); override;}
  end;

var
  frmEnquete: TfrmEnquete;

  AcionarTelaEnquete: procedure (Cliente: integer;
                              TipoCliente: String;
                              Orcamento: integer;
                              Contrato: string;
                              Equipamento: string = '';
                              CheckList: integer = 0;
                              FormaAbertura: integer = 0;
                              PermitirAlteracao: Boolean = true); {0: cadastrar enquete cliente, 1: Visualizar Somente Leitura 2: Visualizar/Cadastrar Checklist}


implementation

uses dmbasico;

{$R *.dfm}

{ TfrmEnquete }

constructor TfrmEnquete.Create(AOwner: TComponent);
begin
  dtmEnquete:= TdtmEnquete.Create(Self);
  inherited;
  DataSet := dtmEnquete.qryrespostas_clientes;

  ckbMultipla.items.Clear;
  rgpUnica.Items.Clear;
  mmoTexto.Clear;

  

end;

destructor TfrmEnquete.Destroy;
begin
  inherited;
  frmEnquete := nil;
end;

procedure TfrmEnquete.PerguntasAfterScroll(Sender: TObject);
var
 i, vHeight: integer;

 procedure AdicionarListaRespostasMultiplas;
 var
   i: integer;
   IO: TIntObj;
 begin
   with dtmEnquete do
   begin
     qryRespostas.first;
     for i:=0 to qryRespostas.recordcount -1 do
     begin
       ckbMultipla.Items.Insert(i, qryRespostasresposta.AsString);
       IO := TIntObj.Create(qryRespostasCodigo.Asinteger);
       ckbMultipla.Items.Objects[i] := IO;

       case dtmEnquete.qryQuestionario.ParamByName('formaAbertura').asInteger of
       0,1 : begin
               if qryrespostas_clientes.Locate('resposta',qryRespostascodigo.asinteger, []) then
                 ckbMultipla.Checked[i] := true
               else
                 ckbMultipla.Checked[i] := false;
             end;

       2 :   begin
               if qryrespostas_os.Locate('resposta',qryRespostascodigo.asinteger, []) then
                 ckbMultipla.Checked[i] := true
               else
                 ckbMultipla.Checked[i] := false;
             end;
       end;
       
       qryRespostas.next;
     end;
   end;

 end;

 procedure AdicionarListaRespostaUnica;
 var
   i: integer;
   IO: TIntObj;
 begin
   with dtmEnquete do
   begin
     qryRespostas.first;
     for i:=0 to qryRespostas.recordcount -1 do
     begin
       rgpUnica.Items.Insert(i, qryRespostasresposta.AsString);
       IO := TIntObj.Create(qryRespostasCodigo.Asinteger);
       rgpUnica.Items.Objects[i] := IO;


       case dtmEnquete.qryQuestionario.ParamByName('formaAbertura').asInteger of
       0,1 : begin
               if qryrespostas_clientes.Locate('resposta',qryRespostascodigo.asinteger, []) then
                 rgpUnica.ItemIndex := i;
             end;

       2   : begin
               if qryrespostas_os.Locate('resposta',qryRespostascodigo.asinteger, []) then
                 rgpUnica.ItemIndex := i;
             end;

       end;

       qryRespostas.next;
     end;
   end;

 end;

 procedure AdicionarMemo;
 var
   i: integer;
   IO: TIntObj;
 begin
   with dtmEnquete do
   begin
     qryRespostas.first;
     for i:=0 to qryRespostas.recordcount -1 do
     begin

       case dtmEnquete.qryQuestionario.ParamByName('formaAbertura').asInteger of
       0,1 : begin
               if qryrespostas_clientes.Locate('resposta',qryRespostascodigo.asinteger, []) then
                 mmoTexto.text := qryrespostas_clientestexto.asstring;
             end;

         2 : begin
               if qryrespostas_os.Locate('resposta',qryRespostascodigo.asinteger, []) then
                 mmoTexto.text := qryrespostas_ostexto.asstring;
             end;
       end;

       qryRespostas.next;
     end;
   end;

 end;



begin
  if dtmEnquete.qryPerguntastipo.AsString = 'múltipla' then
  begin

    ckbMultipla.Items.clear;
    AdicionarListaRespostasMultiplas;

    pnlUnico.visible := false;
    gbxMultiplos.visible := true;
    gbxrespostas_clientestexto.visible := dtmEnquete.qryPerguntasjustificativa.asBoolean;
    gbxMultiplos.Height := (dtmEnquete.qryRespostas.RecordCount * 20);

    if gbxrespostas_clientestexto.visible then
    begin
      mmoTexto.clear;
      AdicionarMemo;

      vHeight := DBTabControl1.height  - DBAdvMemo3.height - pnlBottom.height - gbxMultiplos.Height;

      if vHeight > 65 then
      begin
        pnlBottom.Align := alBottom;
        gbxrespostas_clientestexto.Align := alClient;
//        gbxrespostas_clientestexto.height := 65;
      end
      else
      begin
        gbxMultiplos.Height := DBTabControl1.height  - DBAdvMemo3.height - pnlBottom.height - 65;
        gbxrespostas_clientestexto.Align := alTop;
        pnlBottom.Align := alBottom;
        gbxrespostas_clientestexto.height := 65;
      end;

    end;

    if ckbMultipla.CanFocus then
      ckbMultipla.SetFocus;

  end
  else
  if dtmEnquete.qryPerguntastipo.AsString = 'única' then
  begin
    rgpUnica.Items.clear;
    AdicionarListaRespostaUnica;

    pnlUnico.visible := true;
    gbxMultiplos.visible := false;
    gbxrespostas_clientestexto.visible := dtmEnquete.qryPerguntasjustificativa.asBoolean;

    pnlUnico.Height := (dtmEnquete.qryRespostas.RecordCount * 22);

    rgpUnica.Columns := rgpunica.items.Count div 18;

    if rgpunica.items.Count > 18 then
      if (rgpunica.items.Count mod 18) > 0 then
        rgpUnica.Columns := rgpUnica.Columns + 1;

    pnlUnico.Height := pnlUnico.Height div rgpUnica.Columns;


    if gbxrespostas_clientestexto.visible then
    begin
      mmoTexto.clear;
      AdicionarMemo;

      vHeight := DBTabControl1.height  - DBAdvMemo3.height - pnlBottom.height - pnlUnico.Height;

      if vHeight > 65 then
      begin
        gbxrespostas_clientestexto.Align := alClient;
//        gbxrespostas_clientestexto.height := 65;
      end
      else
      begin

        pnlUnico.Height := (DBTabControl1.height  - DBAdvMemo3.height - pnlBottom.height - 65)  div rgpUnica.Columns;
        gbxrespostas_clientestexto.Align := alTop;
        pnlBottom.Align := alBottom;
        gbxrespostas_clientestexto.height := 65;

      end;
    end;

//    pnlUnico.Align := alClient;


    if rgpUnica.CanFocus then
      rgpUnica.setfocus;

    if rgpunica.ItemIndex = -1 then
    begin

      rgpUnica.itemindex := -1;

      if rgpUnica.CanFocus then
        rgpUnica.setfocus;
      
      if TRadioButton(rgpUnica.controls[0]).CanFocus then
        TRadioButton(rgpUnica.controls[0]).Setfocus;

    end
    else
    begin
      if TRadioButton(rgpUnica.controls[rgpUnica.itemindex]).CanFocus then
        TRadioButton(rgpUnica.controls[rgpUnica.itemindex]).Setfocus;
    end;

  end
  else
  if dtmEnquete.qryPerguntastipo.AsString = 'texto' then
  begin

    gbxMultiplos.visible := false;
    pnlUnico.visible := false;

    gbxrespostas_clientestexto.visible := true;
    gbxrespostas_clientestexto.Align := alClient;
//    gbxrespostas_clientestexto.top := 56;
//    DBAdvMemo2.BringToFront;
    mmoTexto.clear;
    AdicionarMemo;

    if mmoTexto.CanFocus then
      mmoTexto.SetFocus;

  end;

  if (dtmEnquete.qryPerguntas.RecordCount = dtmEnquete.qryPerguntas.Recno) then
    btnProximo.Caption := 'Concluir'
  else
    btnProximo.Caption := 'Próximo';


end;


procedure TfrmEnquete.FormShow(Sender: TObject);
begin
  inherited;
  dtmEnquete.qryPerguntas.First;
  PerguntasAfterScroll(nil);
end;

procedure TfrmEnquete.KeyDown(var Key: Word; Shift: TShiftState);
begin
  inherited;
  vkey := key;
end;

procedure TfrmEnquete.DBAdvMemo2KeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  inherited;
  if vkey = vk_return then
  begin
    DBTabControl1.DataSource.DataSet.Next;
    if DBTabControl1.DataSource.DataSet.eof then
       DBTabControl1.DataSource.DataSet.first;
    vkey := 0;
  end;

end;


procedure TfrmEnquete.btnProximoClick(Sender: TObject);
begin
  inherited;

  if btnProximo.Caption = 'Concluir' then
  begin
    SalvarEnquete;
    if ValidarRegistros then
    begin

      {
      if dtmEnquete.SalvarEnquete(ckbMultipla, vUnica, mmoTexto.text) then
      begin
      }
         dtmEnquete.vCanClose := true;
         close;
      {
      end
      else
        dtmEnquete.vCanClose := false;
        }

    end;
  end
  else
    dtmEnquete.qryPerguntas.Next;

end;

function TfrmEnquete.ValidarRegistros: Boolean;
var
 i: integer;
begin

   result := false;

   with dtmEnquete do
   begin
     try

       qryPerguntas.AfterScroll := nil;
       qryPerguntas.BeforeScroll := nil;

       qryPerguntas.First;
       while not qryPerguntas.eof do
       begin

         qryRespostas.first;
         while not qryrespostas.Eof do
         begin

           if (qryPerguntastipo.asString = 'múltipla') then
           begin
             case qryQuestionario.ParamByName('formaAbertura').asInteger of
               0,1 :
               begin
                 if qryrespostas_clientes.locate('resposta', qryRespostascodigo.asinteger, []) then
                 begin
                   result := true;
                   break;
                 end
                 else
                  result := false;
               end;
                 2 :
               begin
                 if qryrespostas_os.locate('resposta', qryRespostascodigo.asinteger, []) then
                 begin
                   result := true;
                   break;
                 end
                 else
                  result := false;
               end;
             end;
           end
           else
           if qryPerguntastipo.asString = 'única' then
           begin
             case qryQuestionario.ParamByName('formaAbertura').asInteger of
               0,1 :
               begin
                 if qryrespostas_clientes.locate('resposta', qryRespostascodigo.asinteger, []) then
                 begin
                   result := true;
                   break;
                 end
                 else
                   result := false;
               end;

                 2 :
               begin
                 if qryrespostas_os.locate('resposta', qryRespostascodigo.asinteger, []) then
                 begin
                   result := true;
                   break;
                 end
                 else
                   result := false;
               end;
             end;

           end
           else
           if qryPerguntastipo.asString = 'texto' then
           begin
             case qryQuestionario.ParamByName('formaAbertura').asInteger of
               0,1 :
               begin
                 if qryrespostas_clientes.locate('resposta', qryRespostascodigo.asinteger, []) then
                 begin
                   if qryrespostas_clientestexto.asstring <> '' then
                   begin
                     result := true;
                     break;
                   end
                   else
                     result := false;
                 end
                 else
                  result := false;
               end;

                 2 :
               begin
                 if qryrespostas_os.locate('resposta', qryRespostascodigo.asinteger, []) then
                 begin
                   if qryrespostas_ostexto.asstring <> '' then
                   begin
                     result := true;
                     break;
                   end
                   else
                     result := false;
                 end
                 else
                  result := false;
               end;
             end;

           end;

           qryRespostas.next;
         end;

         if not result then
         begin
           MensagemAviso('Preencha as opções solicitadas.');

           break;
         end
         else
           qryPerguntas.next;
       end;

     finally

       qryPerguntas.AfterScroll := qryPerguntasAfterScroll;
       qryPerguntas.BeforeScroll := qryPerguntasBeforeScroll;

       PerguntasAfterScroll(nil);


     end;

   end;
end;

{
procedure TfrmEnquete.OperacaoPadrao(Value: array of Variant);
begin
  inherited;

  if dtmEnquete.qryQuestionario.RecordCount <> 0 then
  begin
    dtmEnquete.qryClientes.ParamByName('cliente').AsInteger := Value[0];
    dtmEnquete.qryClientes.ParamByName('tipocliente').AsString := Value[1];

    dtmEnquete.qryClientes.ParamByName('questionario').AsInteger := dtmEnquete.qryQuestionariocodigo.AsInteger;

    dtmEnquete.qryClientes.Close;
    dtmEnquete.qryClientes.open;

    if dtmEnquete.qryClientes.recordcount = 0 then
    begin
      dtmEnquete.vCanClose := true;
      close;
    end
    else
      showmodal;

  end
  else
  begin
    dtmEnquete.vCanClose := true;
    close;
  end;
end;
}


procedure TfrmEnquete.FormCloseQuery(Sender: TObject;
  var CanClose: Boolean);
begin
  inherited;

  CanClose := dtmEnquete.vCanClose;

end;


procedure AcionarTelaEnquete_(Cliente: integer;
                              TipoCliente: String;
                              Orcamento: integer;
                              Contrato: string;
                              Equipamento: string = '';
                              CheckList: integer = 0;
                              FormaAbertura: integer = 0;
                              PermitirAlteracao: Boolean = true);
begin

  if not assigned(frmEnquete) then
    frmEnquete := TfrmEnquete.create(frmEnquete);

  frmEnquete.ckbMultipla.items.Clear;
  frmEnquete.rgpUnica.Items.Clear;
  frmEnquete.mmoTexto.Clear;
  dtmEnquete.vCanClose := false;

  dtmEnquete.PerguntasAfterScroll := nil;
  dtmEnquete.PerguntasBeforeScroll := nil;


  case FormaAbertura of

  0:begin   {Cadastro Questionario cliente}
      frmEnquete.pnlIdentificacaoCliente.visible := true;
      frmEnquete.pnlEquipaentoOS.visible := False;

      frmEnquete.gbxMultiplos.enabled := true;
      frmEnquete.pnlUnico.enabled := true;
      frmEnquete.gbxrespostas_clientestexto.enabled := true;

      with dtmEnquete do
      begin
        RefazConsultaPorNome(qryQuestionario, ['formaabertura', 'questionario', 'filialbase' ],
             [0,0,dtmEnquete.FilialBase], true);
             {
        dtmEnquete.qryQuestionario.close;
        dtmEnquete.qryQuestionario.parambyname('formaabertura').Asinteger := 0;
        dtmEnquete.qryQuestionario.parambyname('questionario').Asinteger := 0;
        dtmEnquete.qryQuestionario.ParamByName('filialbase').AsString:=IntToStr(dtmEnquete.FilialBase);
        dtmEnquete.qryQuestionario.open;
             }
      end;

      if dtmEnquete.qryQuestionario.RecordCount <> 0 then
      begin
        dtmEnquete.qryClientes.ParamByName('cliente').AsInteger := Cliente;
        dtmEnquete.qryClientes.ParamByName('tipocliente').AsString := TipoCliente;
        dtmEnquete.qryClientes.parambyname('formaabertura').Asinteger := 0;
        dtmEnquete.qryClientes.ParamByName('orcamento').Asinteger := Orcamento;
        dtmEnquete.qryClientes.ParamByName('contrato').AsString := Contrato;
        dtmEnquete.qryClientes.ParamByName('questionario').AsInteger := dtmEnquete.qryQuestionariocodigo.AsInteger;

        dtmEnquete.qryClientes.Close;
        dtmEnquete.qryClientes.open;

        if dtmEnquete.qryClientes.recordcount = 0 then
        begin
          dtmEnquete.vCanClose := true;
          frmEnquete.close;
        end
        else
        begin
          with dtmEnquete do
            RefazConsultaPorNome(qryrespostas_clientes, ['questionario','cliente','tipocliente', 'orcamento', 'contrato',  'respondermaisdeumavez' ],
                      [qryQuestionariocodigo.asinteger, qryClientescodigo.asinteger, qryClientestipo.AsString, Orcamento, Contrato, qryQuestionariorespondermaisdeumavez.asBoolean]);

          dtmEnquete.PerguntasAfterScroll := frmEnquete.PerguntasAfterScroll;
          dtmEnquete.PerguntasBeforeScroll := frmEnquete.PerguntasBeforeScroll;

          frmEnquete.showmodal;
        end;

      end
      else
      begin
        dtmEnquete.vCanClose := true;
        frmEnquete.close;
      end;
    end;

    1:begin {Visualização Questionario cliente}

        frmEnquete.pnlIdentificacaoCliente.visible := true;
        frmEnquete.pnlEquipaentoOS.visible := False;

        dtmEnquete.qryQuestionario.AfterScroll := dtmEnquete.qryQuestionarioAfterScroll;

        RefazConsultaPorNome(dtmEnquete.qryrespostas_clientes, ['questionario','cliente','tipocliente', 'orcamento', 'contrato',  'respondermaisdeumavez' ],
                [null, cliente, tipocliente, Orcamento, Contrato, true]);


        if dtmEnquete.qryrespostas_clientes.recordcount <> 0 then
        begin
          with dtmEnquete do
          begin

            frmEnquete.gbxMultiplos.enabled := PermitirAlteracao;
            frmEnquete.pnlUnico.enabled := PermitirAlteracao;
            frmEnquete.gbxrespostas_clientestexto.enabled := PermitirAlteracao;

            qryQuestionario.close;
            qryQuestionario.parambyname('formaabertura').Asinteger := 1;
            qryQuestionario.parambyname('questionario').AsInteger := qryrespostas_clientesquestionario.AsInteger;
            qryQuestionario.ParamByName('filialbase').AsString:= IntToStr(FilialBase);
            qryQuestionario.open;

            qryClientes.ParamByName('cliente').AsInteger := Cliente;
            qryClientes.ParamByName('tipocliente').AsString := TipoCliente;
            qryClientes.parambyname('formaabertura').Asinteger := 1;
            qryClientes.ParamByName('orcamento').Asinteger := Orcamento;
            qryClientes.ParamByName('contrato').AsString := Contrato;
            qryClientes.ParamByName('questionario').AsInteger := qryQuestionariocodigo.AsInteger;

            qryClientes.Close;
            qryClientes.open;

            PerguntasAfterScroll := frmEnquete.PerguntasAfterScroll;
            PerguntasBeforeScroll := frmEnquete.PerguntasBeforeScroll;

            frmEnquete.showmodal;

          end;
        end
        else
        begin
          dtmEnquete.vCanClose := true;
          frmEnquete.close;
        end;
      end;

    2:begin {Cadastro Checklist Equipamento}

        frmEnquete.pnlIdentificacaoCliente.visible := false;
        frmEnquete.pnlEquipaentoOS.visible := true;

        dtmEnquete.qryQuestionario.AfterScroll := dtmEnquete.qryQuestionarioAfterScroll;

        RefazConsultaPorNome(dtmEnquete.qryrespostas_os, ['questionario', 'contrato', 'equipamento'],
                [checklist, contrato, equipamento]);

{        if dtmEnquete.qryrespostas_os.recordcount <> 0 then
        begin}

          with dtmEnquete do
          begin

            frmEnquete.gbxMultiplos.enabled := true;
            frmEnquete.pnlUnico.enabled := true;
            frmEnquete.gbxrespostas_clientestexto.enabled := true;

            qryQuestionario.close;
            qryQuestionario.parambyname('formaabertura').Asinteger := FormaAbertura;
            qryQuestionario.parambyname('questionario').AsInteger := checklist;
            qryQuestionario.open;

            dtmEnquete.qryEquipamentoOS.ParamByName('contrato').AsString := Contrato;

            dtmEnquete.qryEquipamentoOS.Close;
            dtmEnquete.qryEquipamentoOS.open;

            dtmEnquete.PerguntasAfterScroll := frmEnquete.PerguntasAfterScroll;
            dtmEnquete.PerguntasBeforeScroll := frmEnquete.PerguntasBeforeScroll;

            frmEnquete.showmodal;

          end;
{
        end
        else
        begin
          dtmEnquete.vCanClose := true;
          frmEnquete.close;
        end;}
      end;
  end;
end;

procedure TfrmEnquete.PerguntasBeforeScroll(Sender: TObject);
begin
  SalvarEnquete;
end;

procedure TfrmEnquete.SalvarEnquete;
var
 vUnica : String;

begin
  if rgpUnica.itemindex = -1 then
    vUnica := ''
  else
    vUnica := rgpUnica.Items[rgpUnica.itemindex];

  dtmEnquete.SalvarEnquete(ckbMultipla, rgpUnica, mmoTexto.text, ((btnProximo.Caption = 'Concluir') and gbxMultiplos.enabled) );
end;

initialization
   AcionarTelaEnquete :=  AcionarTelaEnquete_;


end.
