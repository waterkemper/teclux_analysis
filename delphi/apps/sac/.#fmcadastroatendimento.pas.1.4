  with dtmCadastroAtendimentos do begin
    case TipoConsulta of
          tcaATENDIMENTO: Result:= TabelaConsultaAtendimentos;
              tcaCLIENTE: Result:= TabelaConsultaCliente;
      tcaTIPOATENDIMENTO: Result:= ConsultaTiposAtendimentos
      else                Result:= nil;
    end;
