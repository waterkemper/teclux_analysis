begin
  inherited;
  rgpDependentes.Enabled := ((edtNasctoInicial.Text <> '') and (edtNasctoFinal.Text   <> '')) or
                            ((edfAniversarioInicial.Text <> '  /  ') and (edfAniversarioFinal.Text   <> '  /  '));
