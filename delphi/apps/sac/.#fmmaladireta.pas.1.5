procedure TfrmMalaDireta.KeyDown(var Key: Word; Shift: TShiftState);
begin
  case Key of
       VK_F6: if not CtrlOn and sbngerar.Enabled then
                  sbngerar.click;
  end;
  inherited;
end;

procedure TfrmMalaDireta.sbnArquivoClick(Sender: TObject);
begin
  inherited;
  if dlgArquivoaExportar.Execute then
  begin
   edtArquivoaExportar.Text:=trim(dlgArquivoaExportar.FileName);
   edtEtiqueta.Text:=Copy(edtArquivoaExportar.Text,0,length(edtArquivoaExportar.Text)-3) + 'etq.txt';
  end;
end;

procedure TfrmMalaDireta.sbnGerarClick(Sender: TObject);
begin
  inherited;
  if edtArquivoaExportar.Text <> '' then
    GerarArquivo(False)
  else
    MensagemAviso('Indique o arquivo para exportação dos dados!');
end;

procedure TfrmMalaDireta.GerarArquivo(Relatorio: Boolean);
begin
  with dtmMalaDireta do begin
       NascimentoInicial   := edtNasctoInicial.Text;
       NascimentoFinal     := edtNasctoFinal.Text;
       AniversarioInicial  := edfAniversarioInicial.Text;
       AniversarioFinal    := edfAniversarioFinal.Text;
       Sexo                := IntToStr(cmbSexo.ItemIndex);
       EstadoCivil         := IntToStr(cmbEstadoCivil.ItemIndex);
       SalarioInicial      := edtSalarioInicial.ValorSemFormatacao;
       SalarioFinal        := edtSalarioFinal.ValorSemFormatacao;
       ValorComprasInicial := edtValorComprasInicial.ValorSemFormatacao;
       ValorComprasFinal   := edtValorComprasFinal.ValorSemFormatacao;
       UltimaCompraInicial := edtUltimaCompraInicial.Text;
       UltimaCompraFinal   := edtUltimaCompraFinal.Text;
       SPC                 := IntToStr(cmbSPC.ItemIndex);
       EnviarDevolvidas    := IntToStr(cmbEnviarDevolvidas.ItemIndex);
       camposmarcados      := VerificaCamposMarcados;
       Ordenacao           := IntToStr(rgpOrdenacao.ItemIndex);
       VendaInicial        := edtVendaInicial.Text;
       VendaFinal          := edtVendaFinal.Text;
       VenctoInicial       := edtVenctoInicial.Text;
       VenctoFinal         := edtVenctoFinal.Text;
       DataCadastroInicial := edtDataCadastroInicial.Text;
       DataCadastroFinal   := edtDataCadastroFinal.Text;
       if rgpDependentes.Enabled and rgpDependentes.Visible then
         Dependentes       := rgpDependentes.ItemIndex
       else
         Dependentes       := 0;
       EmAtraso            := ckbEmAtraso.Checked;
       SemTelefones        := ckbSemTelefones.Checked;
       ContratosQuitados   := ckbContratosQuitados.Checked;

       if GerarClientes(relatorio) then begin
          if not Relatorio then begin
             GerarArquivo(edtArquivoaExportar.Text,edtEtiqueta.Text);
             MensagemAviso(format(ctARQUIVOGERADOSUCESSO,[edtArquivoaExportar.Text]));
          end else
             ImprimirRelatorioClientes;
       end
       else
          MensagemAviso(ctCONSULTAVAZIA);
  end;
end;

function TfrmMalaDireta.VerificaCamposMarcados: TStringList;
var
 i: integer;
 lista : tstringlist;
begin
 lista := tstringlist.Create;
 for i:=0 to clbCampos.Items.Count -1 do
   if clbCampos.Checked[i] then
    lista.Add(inttostr(i));
 result := lista;
end; 

procedure TfrmMalaDireta.InternoImpressao;
begin
  inherited;
  GerarArquivo(True);
end;

