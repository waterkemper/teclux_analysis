implementation

{$R *.dfm}

constructor TfrmMalaDireta.Create(AOwner: TComponent);
begin
  dtmMalaDireta:= TdtmMalaDireta.Create(Self);
  inherited;
  cmbSPC.ItemIndex:=0;
  cmbEnviarDevolvidas.ItemIndex:=1;
  cmbSexo.ItemIndex:=0;
  cmbEstadoCivil.ItemIndex:=0;
  rgpOrdenacao.ItemIndex:=0;
  clbCampos.Items := dtmMalaDireta.campos;
//  clbCampos.Rows :=25;
  rgpDependentes.Visible := ParSistema.ClienteComDependentes;
  lblDependentes.Visible := ParSistema.ClienteComDependentes;
  edfConceito.SetFocus;
  
end;

destructor TfrmMalaDireta.Destroy;
begin
  inherited;
  frmMalaDireta:= nil;
end;

function TfrmMalaDireta.InternoPesquisar(Titulo: String): Integer;
begin
  Result:= mrNone;
  if PermitirPesquisa then
  begin
    dtmMalaDireta.AbreTabelaConsulta(TipoPesquisa);
    Result := inherited InternoPesquisar(TituloPesquisa);
    if Result = mrOK then
      dtmMalaDireta.Selecionar(TipoPesquisa);
    dtmMalaDireta.FechaTabelaConsulta(TipoPesquisa);
  end;
end;

function TfrmMalaDireta.ExisteInformacao(Parametro: Integer; NomeCampo: String; Value: Variant): Boolean;
begin
  case TipoPesquisa of
    pesCONCEITOS       : Result := dtmMalaDireta.ExisteConceito(NomeCampo,Value);
    pesCARGOS           : Result := dtmMalaDireta.ExisteCargo(NomeCampo,Value);
    pesCIDADES          : Result := dtmMalaDireta.ExisteCidade(NomeCampo,Value);
    pesREGIOES          : Result := dtmMalaDireta.ExisteRegiao(NomeCampo,Value);
    pesFILIAIS,
    pesNENHUMA          : Result := dtmMalaDireta.ExisteFilial(NomeCampo,Value);
    pesVENDEDORES       : Result := dtmMalaDireta.ExisteVendedor(NomeCampo, Value);
    else              Result := False;
  end;
end;

function TfrmMalaDireta.TabelaDePesquisa: TZdataSet;
begin
  case TipoPesquisa of
    pesCONCEITOS        : Result := dtmMalaDireta.ConsultarConceito;
    pesCARGOS           : Result := dtmMalaDireta.ConsultarCargo;
    pesCIDADES          : Result := dtmMalaDireta.ConsultarCidade;
    pesREGIOES          : Result := dtmMalaDireta.ConsultarRegiao;
    pesFILIAIS,
    pesNENHUMA          : Result := dtmMalaDireta.ConsultarFilial;
    pesVENDEDORES       : Result := dtmMalaDireta.ConsultarVendedor;
    else              Result := nil;
  end;
end;

function TfrmMalaDireta.PermitirPesquisa: Boolean;
begin
  Result := False;
  if CtrlOn then
  begin
    if ActiveControl is TtecFindCustom then
    begin
      if edfConceito.Focused  then
        TipoPesquisa:= pesCONCEITOS
      else if edfCargo.Focused then
        TipoPesquisa:= pesCARGOS
      else if edfCidade.Focused then
        TipoPesquisa:= pesCIDADES
      else if edfRegiao.Focused then
        TipoPesquisa:= pesREGIOES
      else if edfFilialCadastro.Focused then
        TipoPesquisa := pesFILIAIS
      else if edfFilialVenda.Focused then
        TipoPesquisa := pesNENHUMA
      else if edfVendedor.Focused then
        TipoPesquisa := pesVENDEDORES;
      Result:= True;
    end;
  end;
end;

function TfrmMalaDireta.TituloPesquisa: string;
begin
  case TipoPesquisa of
    pesCONCEITOS        : Result := 'Conceitos';
    pesCARGOS           : Result := 'Cargos';
    pesCIDADES          : Result := 'Cidades';
    pesREGIOES          : Result := 'Regiões';
    pesFILIAIS,
    pesNENHUMA          : Result := 'Filiais';
    pesVENDEDORES       : Result := 'Vendedores';
  end;
end;

function TfrmMalaDireta.JanelaPesquisa;
begin
  Result:= TfrmConsultaPorCampo.Create(nil);
  TfrmConsultaPorCampo(result).ConsultaInterativa := True;
end;

