function TdtmManutencaoAgendamento.SalvarAgendamentoManutencao: Boolean;
begin

  try
    qryGravarProdutosAgendamentos.Sql.clear;

    qryProdutosAgendamentos.DisableControls;

    qryProdutosAgendamentos.first;
    while not qryProdutosAgendamentos.eof do
    begin

      if qryProdutosAgendamentosorigem.asString = 'PRODUTOS' then
      begin
        if qryProdutosAgendamentosincluido.asBoolean then
        begin
          if qryProdutosAgendamentoscodigoagendamento.isnull then

            qryGravarProdutosAgendamentos.Sql.Append('insert into produtosagendamentos (produto, dias, observacoes) '+
             ' values (' + qryProdutosAgendamentosproduto.asString + ', '
                         + qryProdutosAgendamentosdias.AsString + ', '
                         + quotedstr(qryProdutosAgendamentosobservacoes.asString) +');' )

          else

            qryGravarProdutosAgendamentos.Sql.Append('insert into produtosagendamentos (codigo, produto, dias, observacoes) '+
             ' values (' + qryProdutosAgendamentoscodigoagendamento.asString + ', '
                         + qryProdutosAgendamentosproduto.asString + ', '
                         + qryProdutosAgendamentosdias.AsString + ', '
                         + quotedstr(qryProdutosAgendamentosobservacoes.asString) +');' );

        end
        else
        if qryProdutosAgendamentosalterado.asBoolean then
        begin
          if qryProdutosAgendamentoscodigoagendamento.isnull then

            qryGravarProdutosAgendamentos.Sql.Append('insert into produtosagendamentos (produto, dias, observacoes) '+
             ' values (' + qryProdutosAgendamentosproduto.asString + ', '
                         + qryProdutosAgendamentosdias.AsString + ', '
                         + quotedstr(qryProdutosAgendamentosobservacoes.asString) +');' )

          else
            qryGravarProdutosAgendamentos.Sql.Append('update produtosagendamentos set dias = '+qryProdutosAgendamentosdias.AsString +
                                                     ', observacoes = ' + quotedstr(qryProdutosAgendamentosobservacoes.asString) +
                                                     ', produto = ' + qryProdutosAgendamentosproduto.asString +
                                                     ' where codigo = ' +qryProdutosAgendamentoscodigoagendamento.asString + ';');
        end;
      end;

      qryProdutosAgendamentos.next;
    end;

    qryProdutosAgendamentos.ShowRecordTypes := [ztDeleted];

    qryProdutosAgendamentos.first;
    while not qryProdutosAgendamentos.eof do
    begin
      if qryProdutosAgendamentosorigem.asString = 'PRODUTOS' then
        qryGravarProdutosAgendamentos.Sql.Append('delete from produtosagendamentos where codigo = '+ qryProdutosAgendamentoscodigoagendamento.asString + ';');

      qryProdutosAgendamentos.next;
    end;

  finally

    qryProdutosAgendamentos.ShowRecordTypes := [ztModified,ztInserted,ztUnmodified];
    qryProdutosAgendamentos.enablecontrols;
  end;

  if qryGravarProdutosAgendamentos.Sql.Count <> 0 then
    qryGravarProdutosAgendamentos.ExecSql;

  result := perpetrar([qryMarcasAgendamentos, qryClassesAgendamentos, qryGruposAgendamentos, qryGravarProdutosAgendamentos]);

end;

