  ListaCondicaoClasse, ListaCondicaoMarca,
  ListaCondicaoPromocoes: String): Boolean;
var
 i: integer;
begin
  qryProdutosAgendamentos.close;
  qryGruposAgendamentos.close;

  for i:=0 to  qryProdutosAgendamentos.Macros.count-1 do
    qryProdutosAgendamentos.Macros[i].Clear;

  for i:=0 to  qryGruposAgendamentos.Macros.count-1 do
    qryGruposAgendamentos.Macros[i].Clear;

  for i:=0 to  qryClassesAgendamentos.Macros.count-1 do
    qryClassesAgendamentos.Macros[i].Clear;

  for i:=0 to  qryMarcasAgendamentos.Macros.count-1 do
    qryMarcasAgendamentos.Macros[i].Clear;

  result := true;
          {
  if not SelecionarSomenteProdutosComAgendamento and
     (ListaCondicaoItemdeproduto='') and
     (ListaCondicaoProduto='') and
     (ListaCondicaoGrupo='') and
     (ListaCondicaoClasse='') and
     (ListaCondicaoMarca='') and
     (ListaCondicaoPromocoes='') then
  begin
    result := false;
    MensagemAviso('Informe algum parâmetro para a consulta dos produtos.'+chr(13)+'Somente a consulta de grupos será realizada.');
  end;


  if result then
  begin
  }

    if SelecionarSomenteProdutosComAgendamento then
      qryProdutosAgendamentos.macrobyname('SelecionarSomenteProdutosComAgendamento').asString := 'inner'
    else
      qryProdutosAgendamentos.macrobyname('SelecionarSomenteProdutosComAgendamento').asString := 'left';

    if ListaCondicaoItemdeproduto<>'' then
      qryProdutosAgendamentos.macrobyname('ListaCondicaoItemdeproduto').asString := ' and ('+ ListaCondicaoItemdeproduto + ')';

    if ListaCondicaoProduto<>'' then
      qryProdutosAgendamentos.macrobyname('ListaCondicaoProduto').asString := ' and (' +ListaCondicaoProduto + ')';

    if ListaCondicaoGrupo<>'' then
      qryProdutosAgendamentos.macrobyname('ListaCondicaoGrupo').asString := ' and ('+ ListaCondicaoGrupo + ')';

    if ListaCondicaoClasse<>'' then
      qryProdutosAgendamentos.macrobyname('ListaCondicaoClasse').asString := ' and ('+ ListaCondicaoClasse + ')';

    if ListaCondicaoMarca<>'' then
      qryProdutosAgendamentos.macrobyname('ListaCondicaoMarca').asString := ' and ('+ ListaCondicaoMarca + ')';

    if ListaCondicaoPromocoes<>'' then
      qryProdutosAgendamentos.macrobyname('ListaCondicaoPromocoes').asString := ' and ('+ ListaCondicaoPromocoes + ')';

    qryProdutosAgendamentos.open;

  //end;

  if SelecionarSomenteGruposComAgendamento then
    qryGruposAgendamentos.macrobyname('SelecionarSomenteGruposComAgendamento').asString := 'inner'
  else
    qryGruposAgendamentos.macrobyname('SelecionarSomenteGruposComAgendamento').asString := 'left';
  if ListaCondicaoGrupo<>'' then
    qryGruposAgendamentos.macrobyname('ListaCondicaoGrupo').asString := ' and ('+ ListaCondicaoGrupo + ')';
  qryGruposAgendamentos.open;


  if SelecionarSomenteClassesComAgendamento then
    qryClassesAgendamentos.macrobyname('SelecionarSomenteClassesComAgendamento').asString := 'inner'
  else
    qryClassesAgendamentos.macrobyname('SelecionarSomenteClassesComAgendamento').asString := 'left';
  if ListaCondicaoClasse<>'' then
    qryClassesAgendamentos.macrobyname('ListaCondicaoClasse').asString := ' and ('+ ListaCondicaoClasse + ')';
  qryClassesAgendamentos.open;


  if SelecionarSomenteMarcasComAgendamento then
    qryMarcasAgendamentos.macrobyname('SelecionarSomenteMarcasComAgendamento').asString := 'inner'
  else
    qryMarcasAgendamentos.macrobyname('SelecionarSomenteMarcasComAgendamento').asString := 'left';
  if ListaCondicaoMarca<>'' then
    qryMarcasAgendamentos.macrobyname('ListaCondicaoMarca').asString := ' and ('+ ListaCondicaoMarca + ')';
  qryMarcasAgendamentos.open;

  if (qryProdutosAgendamentos.recordcount <> 0) or
     (qryGruposAgendamentos.recordcount <> 0) or
     (qryClassesAgendamentos.recordcount <> 0) or
     (qryMarcasAgendamentos.recordcount <> 0) then
    result := true
  else
  begin
    result := false;
    MensagemAviso(format(ctNENHUMREGISTROENCONTRADO,['registro']));
  end;

end;

