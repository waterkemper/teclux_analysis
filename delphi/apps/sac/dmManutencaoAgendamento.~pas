procedure TdtmManutencaoAgendamento.GravarProdutosAgendamentos;
var
 vDias, vObservacoes : String;
begin

  try

    qryProdutosAgendamentos.AfterPost := nil;
    qryGruposAgendamentos.AfterPost := nil;
    qryClassesAgendamentos.AfterPost := nil;
    qryMarcasAgendamentos.AfterPost := nil;

    qryProdutosAgendamentos.DesativarOrdenacao;
    GuardarRegistroAtual(qryProdutosAgendamentos, true);

    vDias := qryProdutosAgendamentosdias.asString;
    vObservacoes := qryProdutosAgendamentosobservacoes.asString;

    if qryProdutosAgendamentosorigem.asString = 'GRUPO' then
    begin

      if qryGruposAgendamentos.locate('codigoagendamento', qryProdutosAgendamentoscodigoagendamento.asInteger, []) then
      begin


        if (vDias <> qryGruposAgendamentosdias.asString) or
           (vObservacoes <> qryGruposAgendamentosobservacoes.asString) then
        begin
          qryGruposAgendamentos.edit;

          qryGruposAgendamentosdias.asString := vDias;
          qryGruposAgendamentosobservacoes.asString :=  vObservacoes;

          qryGruposAgendamentos.post;
        end;

        {
        qryProdutosAgendamentos.first;
        while not qryProdutosAgendamentos.eof do
        begin
          if (qryGruposAgendamentoscodigoagendamento.asinteger =
              qryProdutosAgendamentoscodigoagendamento.asinteger) and
             (qryProdutosAgendamentosorigem.asString = 'GRUPO') then

          begin
            if (vDias <> qryProdutosAgendamentosdias.asString) or
               (vObservacoes <> qryProdutosAgendamentosobservacoes.asString) then
            begin
              qryProdutosAgendamentos.edit;
              qryProdutosAgendamentosdias.asString := vDias;
              qryProdutosAgendamentosobservacoes.asString := vObservacoes;
              qryProdutosAgendamentos.post;
            end;
          end;
          qryProdutosAgendamentos.Next;
        end;

        ou usar a função abaixo:

        }

        AtribuirDados(qryProdutosAgendamentos,

                      [qryProdutosAgendamentosdias,
                       qryProdutosAgendamentosobservacoes],

                      [vDias, vObservacoes],

                      [qryProdutosAgendamentoscodigoagendamento,
                       qryProdutosAgendamentosorigem,
                       qryProdutosAgendamentosdias,
                       qryProdutosAgendamentosobservacoes],

                      [qryGruposAgendamentoscodigo.asinteger,
                       'GRUPO', vDias, vObservacoes],

                      ['=','=','<>','<>']);

      end;
    end
    else
    if qryProdutosAgendamentosorigem.asString = 'CLASSE' then
    begin
      if qryClassesAgendamentos.locate('codigoagendamento', qryProdutosAgendamentoscodigoagendamento.asInteger, []) then
      begin

        if (vDias <> qryclassesAgendamentosdias.asString) or
           (vObservacoes <> qryclassesAgendamentosobservacoes.asString) then
        begin
          qryclassesAgendamentos.edit;

          qryclassesAgendamentosdias.asString := vDias;
          qryclassesAgendamentosobservacoes.asString :=  vObservacoes;

          qryclassesAgendamentos.post;
        end;

        AtribuirDados(qryProdutosAgendamentos,

                      [qryProdutosAgendamentosdias,
                       qryProdutosAgendamentosobservacoes],

                      [vDias, vObservacoes],

                      [qryProdutosAgendamentoscodigoagendamento,
                       qryProdutosAgendamentosorigem,
                       qryProdutosAgendamentosdias,
                       qryProdutosAgendamentosobservacoes],

                      [qryclassesAgendamentoscodigo.asinteger,
                       'CLASSE', vDias, vObservacoes],

                      ['=','=','<>','<>']);

      end;
    end
    else
    if qryProdutosAgendamentosorigem.asString = 'MARCA' then
    begin
      if qryMarcasAgendamentos.locate('codigoagendamento', qryProdutosAgendamentoscodigoagendamento.asInteger, []) then
      begin

        if (vDias <> qryMarcasAgendamentosdias.asString) or
           (vObservacoes <> qryMarcasAgendamentosobservacoes.asString) then
        begin
          qryMarcasAgendamentos.edit;
          qryMarcasAgendamentosdias.asString := vDias;
          qryMarcasAgendamentosobservacoes.asString :=  vObservacoes;
          qryMarcasAgendamentos.post;
        end;

        AtribuirDados(qryProdutosAgendamentos,

                      [qryProdutosAgendamentosdias,
                       qryProdutosAgendamentosobservacoes],

                      [vDias, vObservacoes],

                      [qryProdutosAgendamentoscodigoagendamento,
                       qryProdutosAgendamentosorigem,
                       qryProdutosAgendamentosdias,
                       qryProdutosAgendamentosobservacoes],

                      [qryMarcasAgendamentoscodigo.asinteger,
                       'CLASSE', vDias, vObservacoes],

                      ['=','=','<>','<>']);

      end;
    end;

  finally
    qryProdutosAgendamentos.AfterPost := qryProdutosAgendamentosAfterPost;
    qryGruposAgendamentos.AfterPost := qryGruposAgendamentosAfterPost;
    qryClassesAgendamentos.AfterPost := qryClassesAgendamentosAfterPost;
    qryMarcasAgendamentos.AfterPost := qryMarcasAgendamentosAfterPost;

    VoltarRegistroAtual(qryProdutosAgendamentos);
    qryProdutosAgendamentos.ativarOrdenacao;
  end;

end;

procedure TdtmManutencaoAgendamento.GravarGruposAgendamentos;
var
 vDias, vObservacoes : String;
 i: integer;
begin

  try

    qryProdutosAgendamentos.AfterPost := nil;
    qryProdutosAgendamentos.AfterScroll := nil;

    qryGruposAgendamentos.AfterPost := nil;
    GuardarRegistroAtual(qryProdutosAgendamentos, true);

    if qryGruposAgendamentoscodigo.isnull then
    begin
      try
        qryProdutosAgendamentos.DesativarOrdenacao;

        qryProdutosAgendamentosAux.close;
        qryProdutosAgendamentosAux.Open;

        spcProximoGruposAgendamentos.Close;
        spcProximoGruposAgendamentos.open;
        qryGruposAgendamentos.Edit;
        qryGruposAgendamentoscodigo.asinteger := spcProximoGruposAgendamentoscodigo.asinteger;
        qryGruposAgendamentos.Post;

        qryProdutosAgendamentos.First;
        for i:=1 to qryProdutosAgendamentos.recordcount do
//        while not qryProdutosAgendamentos.eof do
        begin

          if (qryProdutosAgendamentosorigem.asString = 'GRUPO') and
             (qryProdutosAgendamentosgrupo.asstring = qryGruposAgendamentosgrupo.AsString) and
             (qryProdutosAgendamentoscodigoagendamento.isNull) then
          begin
            if not qryProdutosAgendamentosAux.locate('produto', qryProdutosAgendamentosproduto.asstring, []) then
            begin
              CopiarRegistros(qryProdutosAgendamentos, qryProdutosAgendamentosAux, false);
              qryProdutosAgendamentos.Insert;
              CopiarRegistros(qryProdutosAgendamentosaux, qryProdutosAgendamentos, false, true, true, true, true);

              qryProdutosAgendamentos.edit;
              qryProdutosAgendamentoscodigoagendamento.AsInteger := qryGruposAgendamentoscodigo.asinteger;
              qryProdutosAgendamentosdias.asString := qryGruposAgendamentosdias.AsString;
              qryProdutosAgendamentosobservacoes.asString := qryGruposAgendamentosobservacoes.AsString;
              qryProdutosAgendamentos.Post;

//              qryProdutosAgendamentos.next;
              qryProdutosAgendamentos.RecNo := i+1;
            end;
          end;

//          qryProdutosAgendamentos.next;
          qryProdutosAgendamentos.RecNo := i+1;
        end;

      finally
        qryProdutosAgendamentos.AtivarOrdenacao;
      end;
    end
    else
    begin

      vDias := qryGruposAgendamentosdias.asString;
      vObservacoes := qryGruposAgendamentosobservacoes.asString;

      try

        qryProdutosAgendamentos.DesativarOrdenacao;

        qryProdutosAgendamentos.first;
//        while not qryProdutosAgendamentos.eof do

        for i:=1 to qryProdutosAgendamentos.recordcount do
        begin
          if (qryGruposAgendamentoscodigo.asinteger = qryProdutosAgendamentoscodigoagendamento.asinteger) and
             (qryProdutosAgendamentosorigem.asString = 'GRUPO') then
          begin
            if (vDias <> qryProdutosAgendamentosdias.asString) or
               (vObservacoes <> qryProdutosAgendamentosobservacoes.asString) then
            begin
              qryProdutosAgendamentos.edit;
              qryProdutosAgendamentosdias.asString := vDias;
              qryProdutosAgendamentosobservacoes.asString := vObservacoes;
              qryProdutosAgendamentos.post;
            end;
          end;

          qryProdutosAgendamentos.RecNo := i+1;

        end;

      finally
        qryProdutosAgendamentos.AtivarOrdenacao;
      end;

    end;

  finally
    qryProdutosAgendamentos.AfterPost := qryProdutosAgendamentosAfterPost;
    qryProdutosAgendamentos.AfterScroll := qryProdutosAgendamentosAfterScroll;

    qryGruposAgendamentos.AfterPost := qryGruposAgendamentosAfterPost;

    VoltarRegistroAtual(qryProdutosAgendamentos);

  end;

end;

function TdtmManutencaoAgendamento.ExcluirProdutoAgendamento: Boolean;
begin
  result := false;

  try

    qryProdutosAgendamentos.disablecontrols;
    qryGruposAgendamentos.disablecontrols;

    if qryProdutosAgendamentosorigem.asString = 'GRUPO' then
    begin
      result := MensagemConfirmacao('Este agendamento esta vinculado a um grupo.'+ chr(13) +
                                    'Confirma a exclusão do agendamento deste grupo?') = smbOK;
      if result then
      begin
        if qryGruposAgendamentos.locate('codigoagendamento', qryProdutosAgendamentoscodigoagendamento.asInteger, []) then
        begin

          qryProdutosAgendamentos.First;
          while not qryProdutosAgendamentos.eof do
          begin
            if (qryProdutosAgendamentoscodigoagendamento.asinteger =
                qryGruposAgendamentoscodigo.asInteger) and
               (qryProdutosAgendamentosorigem.asString = 'GRUPO') then
              qryProdutosAgendamentos.delete
            else
              qryProdutosAgendamentos.Next;
          end;

          qryGruposAgendamentos.delete;
        end;

      end;
    end
