procedure TdtmMalaDireta.MontarSQL(query: TtecQuery);
var
  q: String;{  procedure LimpaSQL;
  var
    i:integer;
  begin
    for i:=qryClientes.Sql.Count-1 downto WhereBase+1 do
    begin
      qryClientes.Sql.Delete(i);
    end;
  end;}
begin
//   LimpaSQL;
  q := '';
  if query = qryClientes then
    q := 'cl'
  else if query = qryDependentes then
    q := 'd';

  //infcontatosvfornecedores
  if q = 'cl' then
  begin
    case emailmarketing of
      NAO: begin
             qryClientes.macrobyname('Camposcontatosvfornecedores').asString := ', cast(null as varchar(40)) as contato, cast(null as varchar(128)) as emailcontato';
             qryClientes.sql[Numerodalinhanotexto(qryClientes.sql, '%sqlcontatosvfornecedores')+1] := '';
           end;

      SIM: begin
             qryClientes.macrobyname('Camposcontatosvfornecedores').asString := ', cvf.contato, cvf.email as emailcontato';
             qryClientes.sql[Numerodalinhanotexto(qryClientes.sql, '%sqlcontatosvfornecedores')+1] := 'left join contatosvfornecedores cvf on cl.codigo = cvf.codigovfornecedores and cvf.tipovfornecedores = ''C'' and coalesce(cvf.receberemailmarketing,false) '
           end;

      SOMENTE:
           begin
             qryClientes.macrobyname('Camposcontatosvfornecedores').asString := ', cvf.contato, cvf.email as emailcontato';
             qryClientes.sql[Numerodalinhanotexto(qryClientes.sql, '%sqlcontatosvfornecedores')+1] := 'join contatosvfornecedores cvf on cl.codigo = cvf.codigovfornecedores and cvf.tipovfornecedores = ''C'' and coalesce(cvf.receberemailmarketing,false) '
           end;
    end;

  end;


  //CONCEITOS
  if (not qryConceitoscodigo.IsNull) then
    query.MacroByName('CONCEITOS').AsString := 'AND (cl.conceito='+qryConceitoscodigo.AsString+')'
  else
    query.MacroByName('CONCEITOS').AsString := '';

  //FILIAIS
  if (not qryFiliaiscodigo.IsNull) then
    query.MacroByName('FILIAIS').AsString := 'AND (cl.filialcadastro='+qryFiliaiscodigo.AsString+')'
  else
    query.MacroByName('FILIAIS').AsString := '';

  //ANIVERSARIANTES
  if ((length(trim(FAniversarioInicial))=5) AND (length(trim(FAniversarioFinal))=5)) then
  begin
    FAniversarioInicial:=FAniversarioInicial+'/2001';
    FAniversarioFinal:=FAniversarioFinal+'/2001';
    query.MacroByName('ANIVERSARIANTES').AsString:= 'AND COALESCE(TO_CHAR(' + q + '.ANIVERSARIO,''MMDD''),TO_CHAR(' + q + '.NASCTO,''MMDD'')) BETWEEN TO_CHAR(cast ('''+FAniversarioInicial+''' as timestamp),''MMDD'') AND TO_CHAR(cast('''+FAniversarioFinal+''' as timestamp),''MMDD'')';
  end
  else
    query.MacroByName('ANIVERSARIANTES').AsString:= '';

  //DATA DE NASCIMENTO
  if ((FNascimentotoInicial <> '') and (FNascimentotoFinal <> '')) THEN
    query.MacroByName('NASCIMENTO').AsString := 'AND (' + q + '.nascto >= '''+FNascimentotoInicial+''') AND (' + q + '.nascto <= '''+FNascimentotoFinal+''')'
  else
    query.MacroByName('NASCIMENTO').AsString := '';

  //SEXO
  if (FSexo='MF') then
    query.MacroByName('SEXO').AsString := 'AND (sexo=''M'' OR sexo=''F'')'
  else if (FSexo<>'T') then
    query.MacroByName('SEXO').AsString := 'AND (sexo='''+FSexo+''')'
  else
    query.MacroByName('SEXO').AsString := '';

  //ESTADO CIVIL
  if (FEstadoCivil<>'T') then
    query.MacroByName('CIVIL').AsString := 'AND (cl.civil='''+FEstadoCivil+''')'
  else
    query.MacroByName('CIVIL').AsString := '';

  //CIDADE
  if (not qryCidadescodigo.IsNull) then
    query.MacroByName('CIDADE').AsString := 'AND (cl.cidade='+qryCidadescodigo.AsString+')'
  else
    query.MacroByName('CIDADE').AsString := '';

  //REGIAO
  if (not qryRegiaocodigo.IsNull) then
