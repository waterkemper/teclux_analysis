    pesCONCEITOS        : RefazConsulta(qryConceitos,[0],[qryConsultaConceitoscodigo.AsString]);
    pesCARGOS           : RefazConsulta(qryCargos,[0],[qryConsultaCargoscodigo.AsString]);
    pesCIDADES          : Refazconsulta(qryCidades,[0],[qryConsultaCidadescodigo.AsString]);
    pesREGIOES          : Refazconsulta(qryRegiao,[0],[qryConsultaRegiaocodigo.AsString]);
    pesFILIAIS          : Refazconsulta(qryFiliais,[0],[qryConsultaFiliaiscodigo.AsString]);
    pesNENHUMA          : ReFazConsulta(qryFiliaisVenda,[0], [qryConsultaFiliaiscodigo.AsString]);
    pesVENDEDORES       : RefazConsulta(qryVendedor,[0],[qryConsultaVendedorcodigo.AsString]);
  end;
end;

