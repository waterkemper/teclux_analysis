function TdtmMalaDireta.GerarClientes(Relatorio: Boolean): Boolean;
begin
  qryClientes.Close;
  qryDependentes.Close;
  if (dtmMalaDireta.Dependentes <> 2) or Relatorio then //diferente de somente dependentes
  begin
    MontarSql(qryClientes);
    qryClientes.Open;
  end;

  if (dtmMalaDireta.Dependentes <> 0) and not Relatorio then //diferente de nao dependentes
  begin
    MontarSql(qryDependentes);
    qryDependentes.Open;
  end;


  Result:= not qryClientes.IsEmpty or not qryDependentes.IsEmpty;
end;

