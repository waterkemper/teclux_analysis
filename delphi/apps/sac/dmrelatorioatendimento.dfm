    Macros = <>
    Sql.Strings = (
      'select atendimentos.cliente,'
      '         clientes.nome,'
      '         Case when atendimentos.tipo = '#39'R'#39' then '#39'Reclama'#231#227'o'#39
      '                 when atendimentos.tipo = '#39'V'#39' then '#39'Visita'#39
      
        '                 when atendimentos.tipo = '#39'C'#39' then '#39'Cobran'#231'a'#39' en' +
        'd as tipo,'
      '         atendimentos.data,'
      '         atendimentos.lembrar,'
      '         atendimentos.semspc,'
      '         atendimentos.semaviso,'
      '         atendimentos.informes'
      'from atendimentos,clientes'
      'where atendimentos.tipo = :tipo'
      
        '         and ((data >= :periodoinicial) and (data <= :periodofin' +
        'al))'
      '         and atendimentos.cliente = clientes.codigo'
      'order by data, UPPER(TO_ASCII(nome,'#39'LATIN1'#39'))')
    RequestLive = False
