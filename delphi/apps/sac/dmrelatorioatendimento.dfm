  object qryAtendimentoTipo: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select atendimentos.cliente,'
      '         clientes.nome,'
      '         Case when atendimentos.tipo = '#39'R'#39' then '#39'Reclama'#231#227'o'#39
      '                 when atendimentos.tipo = '#39'V'#39' then '#39'Visita'#39
      
        '                 when atendimentos.tipo = '#39'C'#39' then '#39'Cobran'#231'a'#39' en' +
        'd as tipo,'
      '         atendimentos.data,'
      '         atendimentos.lembrar,'
      '         atendimentos.semspc,'
      '         atendimentos.semaviso,'
      '         atendimentos.informes,'
      '         tiposatendimentos.codigo,'
      '         tiposatendimentos.descricao'
      'from atendimentos,clientes,tiposatendimentos'
      'where atendimentos.tipo = :tipo'
      
        '         and (data between (:periodoinicial) and (:periodofinal)' +
        ')'
      '         and tiposatendimentos.codigo = :codigo'
      '         and atendimentos.cliente = clientes.codigo'
      
        '         and tiposatendimentos.codigo = atendimentos.tipoatendim' +
        'ento'
      '         and tiposatendimentos.tipo = atendimentos.tipo'
      'order by data, UPPER(TO_ASCII(nome,'#39'LATIN1'#39'))')
    RequestLive = False
    Left = 371
    Top = 13
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'tipo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'periodoinicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'periodofinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end>
    object qryAtendimentoTipocliente: TIntegerField
      FieldName = 'cliente'
    end
    object qryAtendimentoTiponome: TStringField
      FieldName = 'nome'
      Size = 40
    end
    object qryAtendimentoTipotipo: TMemoField
      FieldName = 'tipo'
      BlobType = ftMemo
    end
    object qryAtendimentoTipodata: TDateField
      FieldName = 'data'
    end
    object qryAtendimentoTipolembrar: TDateField
      FieldName = 'lembrar'
    end
    object qryAtendimentoTiposemspc: TDateField
      FieldName = 'semspc'
    end
    object qryAtendimentoTiposemaviso: TDateField
      FieldName = 'semaviso'
    end
    object qryAtendimentoTipoinformes: TStringField
      FieldName = 'informes'
      Size = 512
    end
    object qryAtendimentoTipocodigo: TIntegerField
      FieldName = 'codigo'
    end
    object qryAtendimentoTipodescricao: TStringField
      FieldName = 'descricao'
      Size = 30
    end
  end
