  object qryEstatisticoAnalitco: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      
        'SELECT questionarios.descricao, questionarios.codigo as codquest' +
        'ionario,'
      
        '       perguntas.enunciado, perguntas.complementos,  perguntas.c' +
        'odigo as codpergunta,'
      
        '       cast(translate(opcoesperguntas.opcao,'#39'&'#39','#39#39') as varchar) ' +
        'as opcao, opcoesperguntas.codigo as codopcao,'
      '       clientes.codigo, clientes.nome'
      
        'FROM questionarios, perguntas, questionariosperguntas,Opcoesperg' +
        'untas,objetivas,contatos,clientes'
      'WHERE (questionarios.codigo = :questionario) and'
      '      (perguntas.codigo = :pergunta) and'
      '      (opcoesperguntas.codigo = :opcao) and'
      '      (contatos.data between :DataInicio and :DataTermio)'
      
        '  and (questionarios.codigo = questionariosperguntas.questionari' +
        'o)'
      '  and (questionariosperguntas.pergunta = perguntas.codigo)'
      '  and (opcoesperguntas.pergunta = perguntas.codigo)'
      '  and (objetivas.questionario = questionarios.codigo)'
      '  and (objetivas.pergunta = perguntas.codigo)'
      '  and (objetivas.opcao = opcoesperguntas.codigo)'
      '  and (contatos.numero = objetivas.contato)'
      '  and (clientes.codigo = contatos.cliente)')
    RequestLive = True
    Left = 63
    Top = 12
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'questionario'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'pergunta'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'opcao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataInicio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataTermio'
        ParamType = ptUnknown
      end>
