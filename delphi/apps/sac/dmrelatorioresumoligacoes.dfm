  object qryResumoLigacoesTotais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select '
      
        '   int4(sum(case  when (situacao = '#39'A'#39') then 1 else 0 end)) as s' +
        'omatotal_A,'
      
        '   int4(sum(case  when (situacao = '#39'R'#39') then 1 else 0 end)) as s' +
        'omatotal_R,'
      
        '   int4(sum(case  when (situacao = '#39'C'#39') then 1 else 0 end)) as s' +
        'omatotal_C,'
      
        '   int4(sum(case  when (situacao = '#39'D'#39') then 1 else 0 end)) as s' +
        'omatotal_D,'
      
        '   int4(sum(case  when (situacao <> '#39'0'#39' and situacao <> '#39'C'#39') the' +
        'n 1 else 0 end)) as total'
      'from ligacoes'
      'where situacao in ('#39'A'#39','#39'C'#39','#39'D'#39','#39'R'#39')'
      ''
      ''
      ''
      '')
