  object qryResumoLigacoes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select usuarios.codigo as operador,nome,'
      
        '   int4(sum(case  when (situacao = '#39'A'#39') then 1 else 0 end)) as s' +
        'oma_A,'
      
        '   int4(sum(case  when (situacao = '#39'R'#39') then 1 else 0 end)) as s' +
        'oma_R,'
      
        '   int4(sum(case  when (situacao = '#39'C'#39') then 1 else 0 end)) as s' +
        'oma_C,'
      
        '   int4(sum(case  when (situacao = '#39'D'#39') then 1 else 0 end)) as s' +
        'oma_D,'
      
        '   int4(sum(case  when (situacao <>'#39'0'#39' and situacao <> '#39'C'#39') then' +
        ' 1 else 0 end)) as total'
      'from ligacoes,usuarios'
      'where situacao in ('#39'A'#39','#39'C'#39','#39'D'#39','#39'R'#39')'
      '      and usuarios.codigo = ligacoes.usuario'
      ''
      ''
      'group by usuarios.codigo, nome')
    RequestLive = False
    Left = 59
    Top = 20
