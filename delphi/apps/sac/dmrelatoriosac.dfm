  object qryRelSacDetail: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterScroll = qryRelSacDetailAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SET datestyle = iso, european;'
      
        'SELECT distinct questionarios.codigo,questionarios.descricao,usu' +
        'arios.codigo as usuario, usuarios.nome as nome'
      'FROM    contatos,objetivas,questionarios,usuarios'
      'WHERE (contatos.numero = objetivas.contato)'
      '      and (usuarios.codigo = contatos.usuario)'
      ''
      '      and  (contatos.data between :Datainicial and :DataFinal)'
      '      and (contatos.questionario = questionarios.codigo)'
      'ORDER BY questionarios.codigo,usuarios.codigo;')
    RequestLive = False
    Left = 219
    Top = 8
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'Datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataFinal'
        ParamType = ptUnknown
      end>
  end
