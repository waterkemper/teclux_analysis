  object qryRelSacMaster: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'set datestyle = iso,european;'
      
        'select op.pergunta,op.enunciado, translate(op.opcao,'#39'&'#39','#39#39')as op' +
        'cao, op.codigo ,int4(count(o.opcao)) as Parcial, t.Total'
      'from (select int4(count(distinct (contato))) as total,pergunta'
      '      from contatos, objetivas'
      '      where (contatos.questionario = :questionario) and'
      
        '                (contatos.data  between :DataInicial and :DataFi' +
        'nal) and            '
      '            '
      '            (contatos.numero =objetivas.contato )'
      '      group by pergunta order by pergunta) t,'
      
        '     (select p.enunciado, o.* from questionariosperguntas q,opco' +
        'esperguntas o, perguntas p'
      
        '      where q.pergunta = o.pergunta and p.codigo = o.pergunta an' +
        'd q.questionario = :questionario) op'
      '      left join (select opcao, pergunta'
      '                 from contatos,objetivas'
      '                 where contatos.numero = objetivas.contato and'
      
        '                 contatos.data between :DataInicial and :DataFin' +
        'al and '
      ''
      '                 objetivas.questionario = :questionario) o'
      '      on (o.opcao = op.codigo and o.pergunta = op.pergunta)'
      'where t.pergunta = op.pergunta'
      'group by op.pergunta, op.opcao, op.codigo, op.enunciado, t.Total'
      'order by pergunta, codigo;')
    RequestLive = False
    Left = 350
    Top = 8
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'questionario'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataFinal'
        ParamType = ptUnknown
      end>
