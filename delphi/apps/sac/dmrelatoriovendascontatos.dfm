  object qryPagamentoContatoTotal: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      
        'SELECT int4(count(*)) as count, sum(valorvencto) as sumvencto,su' +
        'm(valorpagto) as sumpagto'
      'FROM  filtrossac,ligacoes,contratos,parcelas'
      'WHERE filtrossac.numero = ligacoes.filtrosac'
      '      and filtrossac.tipo = '#39'L'#39
      
        '      and ligacoes.datahora between (:dataInicio) and (:dataTerm' +
        'io)'
      '      and contratos.cliente = ligacoes.cliente'
      '      and contratos.origem is null'
      '      and parcelas.contrato = contratos.numero'
      '      and parcelas.tipopagto is null'
      
        '      and (parcelas.datapagto between date(date_Trunc('#39'day'#39', lig' +
        'acoes.datahora)) and date(date_Trunc('#39'day'#39',Ligacoes.datahora)+:c' +
        'arencia))')
    RequestLive = False
    Left = 496
    Top = 24
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'dataInicio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'dataTermio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'carencia'
        ParamType = ptUnknown
      end>
    object qryPagamentoContatoTotalcount: TIntegerField
      FieldName = 'count'
    end
    object qryPagamentoContatoTotalsumvencto: TFloatField
      FieldName = 'sumvencto'
    end
    object qryPagamentoContatoTotalsumpagto: TFloatField
      FieldName = 'sumpagto'
    end
  end
  object qryPagamentoContato: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      
        'SELECT ligacoes.cliente, ligacoes.datahora, parcelas.datapagto a' +
        's data,contratos.numero,contratos.nome,valorvencto,valorpagto'
      'FROM  filtrossac,ligacoes,contratos,parcelas'
      'WHERE filtrossac.numero = ligacoes.filtrosac'
      '      and filtrossac.tipo = '#39'L'#39
      
        '      and ligacoes.datahora between (:dataInicio) and (:dataTerm' +
        'io)'
      '      and contratos.cliente = ligacoes.cliente'
      '      and contratos.origem is null'
      '      and parcelas.contrato = contratos.numero'
      '      and parcelas.tipopagto is null'
      
        '      and (parcelas.datapagto between date(date_Trunc('#39'day'#39', lig' +
        'acoes.datahora)) and date(date_Trunc('#39'day'#39',Ligacoes.datahora)+:c' +
        'arencia))'
      'ORDER BY UPPER(TO_ASCII(contratos.nome,''LATIN1''))')
    RequestLive = False
    Left = 344
    Top = 24
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'dataInicio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'dataTermio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'carencia'
        ParamType = ptUnknown
      end>
