  object qryRelatorioVendas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      
        'SELECT ligacoes.cliente, ligacoes.datahora, contratos.data,contr' +
        'atos.numero,contratos.nome,contratos.valorprazo'
      'FROM  filtrossac,ligacoes,contratos'
      'WHERE filtrossac.numero = ligacoes.filtrosac'
      '      and filtrossac.tipo = '#39'I'#39
      
        '      and ligacoes.datahora between (:dataInicio) and (:dataTerm' +
        'io)'
      '      and contratos.cliente = ligacoes.cliente'
      '      and contratos.origem is null'
      
        '      and (contratos.data between date(date_Trunc('#39'day'#39', ligacoe' +
        's.datahora)) and date(date_Trunc('#39'day'#39',Ligacoes.datahora)+:caren' +
        'cia))'
      'ORDER BY UPPER(TO_ASCII(contratos.nome,''LATIN1''))')
    RequestLive = True
    Left = 48
    Top = 24
    ParamData = <
      item
        DataType = ftTimeStamp
        Name = 'dataInicio'
        ParamType = ptUnknown
      end
      item
        DataType = ftTimeStamp
        Name = 'dataTermio'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'carencia'
        ParamType = ptUnknown
        Value = 0
      end>
