package sac;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  repositorio,
  TMSD7,
  tmsxlsd7;

contains
  rgsac in 'rgsac.pas',
  dmcadastrotiposatendimentos in 'dmcadastrotiposatendimentos.pas' {dtmCadastroTiposAtendimentos: TDataModule},
  fmcadastrotiposatendimentos in 'fmcadastrotiposatendimentos.pas' {frmCadastroTiposAtendimentos},
  dmcadastroatendimentos in 'dmcadastroatendimentos.pas' {dtmCadastroAtendimentos: TDataModule},
  fmcadastroatendimento in 'fmcadastroatendimento.pas' {frmCadastroAtendimento},
  dmligarclientes in 'dmligarclientes.pas' {dtmLigarClientes: TDataModule},
  fmligarclientes in 'fmligarclientes.pas' {frmLigarClientes},
  fmligarclientesdadoscliente in 'fmligarclientesdadoscliente.pas' {frmLigarClientesDadosCliente},
  dmmaladireta in 'dmmaladireta.pas' {dtmMalaDireta: TDataModule},
  fmmaladireta in 'fmmaladireta.pas' {frmMalaDireta},
  fmSelecaoImpressaoAtendimentos in 'fmSelecaoImpressaoAtendimentos.pas' {frmSelecaoImpressaoAtendimentos},
  dmManutencaoAgendamento in 'dmManutencaoAgendamento.pas' {dtmManutencaoAgendamento: TDataModule},
  fmManutencaoAgendamento in 'fmManutencaoAgendamento.pas' {frmManutencaoAgendamento};

end.
