#------------------------------------------------------------------------------
VERSION = BWS.01
#------------------------------------------------------------------------------
!ifndef ROOT
ROOT = $(MAKEDIR)\..
!endif
#------------------------------------------------------------------------------
MAKE = $(ROOT)\bin\make.exe -$(MAKEFLAGS) -f$**
DCC = $(ROOT)\bin\dcc32.exe $**
BRCC = $(ROOT)\bin\brcc32.exe $**
#------------------------------------------------------------------------------
PROJECTS = tecsoft6.bpl automacao.bpl repositorio.bpl teclux.exe \
  contasareceber.bpl interlojas.bpl estoque.bpl vendas.bpl imoveis.bpl caixa.bpl \
  cobranca.bpl adminsistema.bpl entrega.bpl montagens.bpl contaspagar.bpl \
  livrosfiscais.bpl financeiro.bpl sac.bpl cadastrofornecedores.bpl \
  cadastroclientes.bpl fichafinanceira.bpl consultanotasfiscaissaida.bpl \
  consultaestoque.bpl bancos.bpl contabil.bpl producao.bpl cadastrocontratos.bpl \
  pmonitornfe.exe teclux_conferencia.exe
#------------------------------------------------------------------------------
default: $(PROJECTS)
#------------------------------------------------------------------------------

teclux.exe: tecsoft\teclux.dpr
  $(DCC)

tecsoft6.bpl: ..\biblio\componentes\tecsoft6.dpk
