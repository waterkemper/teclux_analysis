function FecharJanelaPercaConexao_: Boolean;
var
  KeyResult, KeyLoop : word;
  i,j: integer;
  vComponent : Tcomponent;
  ArquivoCFG: TIniFile;
  vTempoInicial : DWORD;


begin
  result := true;

  try

    ArquivoCFG := TIniFile.Create(NomeArquivoCFG);

    ArquivoCFG.WriteString(LoginSection, 'UsuarioPadraoSefaz', dtmTecSoft.dbaTecSoft.Login);
    ArquivoCFG.WriteString(LoginSection, 'SenhaPadraoSefaz', criptografar(dtmTecSoft.dbaTecSoft.password));
//    sleep(5000);


    if ParamCount >= 1 then
      ExecutarProcesso(ExtractFilePath(Application.ExeName)+'teclux.exe', ParamStr(1),
                       ExtractFilePath(Application.ExeName), SW_NORMAL)
    else
      ExecutarProcesso(ExtractFilePath(Application.ExeName)+'teclux.exe', '',
                       ExtractFilePath(Application.ExeName), SW_NORMAL);

//    sleep(5000);

    IniciarTempo(vTempoInicial);
    repeat
    until TempoEsgotado(vTempoInicial, 60000) or ProcessoExiste('teclux.exe');

    halt(0);

  except
    result := false;
  end;


     (*
  try
      if fsModal in Screen.ActiveForm.FormState  then
        keybd_event(VK_ESCAPE,0,0,0)
      else
      begin

        for i := TfrmPrincipalBasico(Application.MainForm).ComponentCount-1 downto 0 do
         if (TfrmPrincipalBasico(Application.MainForm).Components[i] is TForm) then
           if TForm(TfrmPrincipalBasico(Application.MainForm).Components[i]).name <> 'frmTecsoft' then
           begin
             vComponent := Application.MainForm.Components[i];
             freeandnil(TForm(vComponent));
           end;

        result := true;

        try
          frmTecsoft.mitLoginClick(nil)
        except
          result := false;
        end;

      end;
  except
    result := false;
  end;

  *)

end;


initialization
  FecharJanelaPercaConexao := FecharJanelaPercaConexao_;



end.
