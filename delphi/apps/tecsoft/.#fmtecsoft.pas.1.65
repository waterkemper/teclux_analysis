procedure TfrmTecsoft.MostrarFormRegistrado(Value: Array of Variant; NomeForm: String; Modal: Boolean; Origem: String = '');
var
  frmAjuda: TfrmAjuda;
  frmAjudaClass: TfrmAjudaClass;
  vProsseguir: Boolean;

begin
  inherited;
  vProsseguir := True;
  if NomeForm = 'TfrmLancamentoContas' then
  begin
    if (vOrigemLancamento <> Origem) and
       (FormExists(NomeForm)<>nil) then
    begin
      MensagemAviso('O formulário de lançamento contábil já esta aberto pelo formulário '' '+vOrigemLancamento+'''');
      vProsseguir := false;
    end
    else
    begin
      vOrigemLancamento := Origem;
      vProsseguir := true;
    end;
  end;

  if vprosseguir then
  begin
    frmAjuda := TfrmAjuda(FormExists(NomeForm));
    if Assigned(frmAjuda) then
      frmAjuda.OperacaoPadrao(Value)
    else begin
      frmAjudaClass := FormRegistrado(NomeForm);
      if Assigned(frmAjudaClass) then begin
        frmAjuda := frmAjudaClass.Create(Self);
        if Assigned(frmAjuda) then begin
          frmAjuda.OperacaoPadrao(Value);
          frmAjuda.SetFocus;
          if frmAjuda.WindowState = wsMinimized then
            frmAjuda.WindowState := wsNormal
        end
      end else
        MensagemErro(Format(ctCLASSENAOREGISTRADA, [NomeForm]))
    end;
  end;

end;

procedure TfrmTecsoft.MostrarSituacaoCaixa;
var
  Str, SituacaoUsuario: String;
begin
  stbPrincipal.Panels[2].Text := ctfilialbase+': '+TdtmBasico.DescricaoFilial;
  if UsuarioLogin.Caixa then begin
    if UsuarioLogin.CaixaAberto then
      Str := ctAberto + ' (' + DateTimeToStr(UsuarioLogin.DataAberturaCaixa) + ')'
    else
      Str := ctFechado;
    SituacaoUsuario := NomeUsuario + ' - ' + ctCAIXA + ' %s';
    stbPrincipal.Panels[2].Text := Format(SituacaoUsuario, [Str]) + ' - '+stbPrincipal.Panels[2].Text;
  end else
    stbPrincipal.Panels[2].Text := NomeUsuario + ' - ' + stbPrincipal.Panels[2].Text
end;

function TfrmTecsoft.NomeForm(MenuItem: TMenuItem): String;
begin
  Result := 'Tfrm' + Copy(MenuItem.Name, 4, Length(MenuItem.Name));
end;

procedure TfrmTecsoft.OperacaoPadrao(Value: Array of Variant);
begin
  if Assigned(Menu) then
    Menu := nil
  else
    Menu := mmuTecsoft
end;

procedure TfrmTecsoft.VerificarMenu;

  procedure HabilitarTodosMenus;
  var
    a: Integer;

    procedure HabilitarTodosSubMenus(ItemMenu: TMenuItem);
    var
      a: Integer;
    begin
      for a := 0 to ItemMenu.Count - 1 do
        HabilitarTodosSubMenus(ItemMenu[a]);
      ItemMenu.Visible := true;
    end;

  begin
    for a := 0 to mmuTecsoft.Items.Count - 1 do
      HabilitarTodosSubMenus(mmuTecsoft.Items[a]);
  end;

  function EsconderItemsMenu(ItemMenu: TMenuItem): Boolean;
  var
    a: Integer;
    Esconder: Boolean;
  begin
    Esconder := True;
    for a := 0 to ItemMenu.Count - 1 do
      if Not EsconderItemsMenu(ItemMenu[a]) then
        Esconder := False;
    if ItemMenu.Count = 0 then
      Result := Not ItemMenu.Visible
    else
    begin
      ItemMenu.Visible := Not Esconder and ItemMenu.visible;
      Result := Not ItemMenu.visible;
    end
  end;

  procedure VerificarTodosMenus;
  var
    a: Integer;

    procedure VerificarTodosSubMenus(ItemMenu: TMenuItem);
    var
      b,index: Integer;
      visivel: boolean;
    begin
      for b := 0 to ItemMenu.Count - 1 do
        VerificarTodosSubMenus(ItemMenu[b]);

      if ItemMenu.name = 'mitConsultaVendas' then
        visivel := true;

      if ItemMenu.name = 'mitConsultaOrcamentos' then
        visivel := true;

        
      visivel :=(Assigned(FormRegistrado(ItemMenu)) and
                                       (UsuarioLogin.Suporte or
                                        UsuarioLogin.Administrador or
             (usuariologin.AcessosUsuarios.Find(ItemMenu.name,index)))
                             or (ItemMenu.Tag = 1));

                   {
       if vBloquearSistemaReducaoZPendente then
          ItemMenu.Enabled := false
       else
       }
       if itemMenu.Visible <> visivel then
          ItemMenu.Enabled := visivel;
    end;

  begin
    for a := 0 to mmuTecsoft.Items.Count - 1 do
      VerificarTodosSubMenus(mmuTecsoft.Items[a]);
  end;

  procedure ApagarTodosMenusDesligados;
  var
    a: Integer;
    temsubmenu : boolean;
    procedure ApagarTodosSubMenusDesligados(ItemMenu: TMenuItem);
    var
      i: Integer;
    begin
      for i := ItemMenu.count -1 downto 0 do
      begin
        if (itemMenu[i].Count > 0) and not temsubmenu then
         temsubmenu := true;
        ApagarTodosSubMenusDesligados(ItemMenu[i]);
        if (temsubmenu) and (itemmenu.count = 0) then
          itemMenu.Enabled := false;
      end;
      if (not itemMenu.Enabled) then
        ItemMenu.Free;
    end;
  begin
    for a := mmuTecsoft.Items.Count - 1 downto 0 do
    begin
      temsubmenu := false;
      ApagarTodosSubMenusDesligados(mmuTecsoft.Items[a]);
      if (mmutecsoft.Items[a].Count = 0) and
         (mmutecsoft.Items[a] <> mitMenuFiscal) then
        mmutecsoft.Items[a].free;
    end;
  end;

  function PermitirConfiguracoes: boolean;
  var i: Integer;
  begin
    for i:=0 to UsuarioLogin.AcessosUsuarios.Count-1 do
    begin
      if UsuarioLogin.AcessosUsuarios[i] = 'mitConfiguracoesSistema' then
      begin
        Result:= True;
        break;
      end
      else
        Result:= False;
    end;
  end;

var indice: integer;
begin
  OpcaoMenuLiberada := false;
  Notificar(NotificacaoSplash, ctDEFININDOACESSOS);
  VerificarTodosMenus;
//  mitFrenteCaixa.enabled          := ModuloEmUSo('caixa') and (usuariologin.Caixa or usuariologin.Suporte or UsuarioLogin.Administrador);

  if not (UsuarioLogin.Suporte or UsuarioLogin.Administrador) then
    if UsuarioLogin.AcessosUsuarios.Count > 0 then
    begin
      if ParSistema.AcessoConfiguracoesLocais and (PermitirConfiguracoes) then
      begin
        mitConfiguracoesSistema.enabled := True;
        mitLerParametroSistema.Enabled  := False;
        mitCarregarModulos.Enabled      := False;
        mitExportacaoDados.Enabled      := False;
      end
      else
        mitConfiguracoesSistema.enabled := False;
    end;

  mitParametrosSistema.enabled    := UsuarioLogin.Suporte or UsuarioLogin.Administrador or
                                     mitParametrosSistema.enabled;

  mitConfiguracoesSistema.enabled := UsuarioLogin.Suporte or UsuarioLogin.Administrador or
                                     mitConfiguracoesSistema.enabled;

  mitComandosECF.Enabled := False;
  if (Assigned(ECFPadrao)) and ((UsuarioLogin.GerenteCaixa) or (UsuarioLogin.Caixa)) then
//  begin
    mitComandosECF.Enabled := True;
//    mitLeituraMemriaFiscal.Enabled := True;
//    mitLeituraMemoriaFiscalData.Enabled := True;
//  end;

//  mitMenuFiscal.Enabled  := Assigned(ECFPadrao);
//  mitFrenteCaixa.Enabled := Assigned(ECFPadrao);

  Application.ProcessMessages;

  //Formulários que foram carregados pelo Repositório
  //e estão disponíveis em dois menus
  //Eventos de chamadas devem ser feitos fora do ExecutarItemMenu
  mitFichaFinanceira.Enabled  := (ModuloDisponivel('vendas') and
                                 (UsuarioLogin.Suporte or
                                  UsuarioLogin.Administrador or
                                 (usuariologin.AcessosUsuarios.Find('mitFichaFinanceira',indice)))or
                                 (mitFichaFinanceira.Tag = 1));
  mitFichaFinanceira1.Enabled :=  (ModuloDisponivel('contasareceber') and
                                  (UsuarioLogin.Suporte or
                                   UsuarioLogin.Administrador or
                                  (usuariologin.AcessosUsuarios.Find('mitFichaFinanceira1',indice)))or
                                  (mitFichaFinanceira1.Tag = 1));

  mitEstornoRecebimentos1.Enabled:= (ModuloDisponivel('caixa')  and
                                    (UsuarioLogin.Suporte or
                                     UsuarioLogin.Administrador or
                                    (usuariologin.AcessosUsuarios.Find('mitEstornoRecebimentos1',indice)))or
                                    (mitEstornoRecebimentos1.Tag = 1));
  mitEstornoRecebimentos.Enabled := (ModuloDisponivel('contasareceber') and
                                    (UsuarioLogin.Suporte or
                                     UsuarioLogin.Administrador or
                                    (usuariologin.AcessosUsuarios.Find('mitEstornoRecebimentos',indice)))or
                                    (mitEstornoRecebimentos.Tag = 1));

  mitQuitacaoLote1.Enabled       := (ModuloDisponivel('caixa') and
                                    (UsuarioLogin.Suporte or
                                     UsuarioLogin.Administrador or
                                    (usuariologin.AcessosUsuarios.Find('mitQuitacaoLote1',indice)))or
                                    (mitQuitacaoLote1.Tag = 1));
  mitQuitacaoLote.Enabled        := (ModuloDisponivel('contasareceber') and
                                    (UsuarioLogin.Suporte or
                                     UsuarioLogin.Administrador or
                                    (usuariologin.AcessosUsuarios.Find('mitQuitacaoLote',indice)))or
                                    (mitQuitacaoLote.Tag = 1));

  mitrelatoriofluxodecaixa1.Enabled := (ModuloDisponivel('contaspagar') and
                                       (UsuarioLogin.Suporte or
                                        UsuarioLogin.Administrador or
                                       (usuariologin.AcessosUsuarios.Find('mitrelatoriofluxodecaixa1',indice)))or
                                       (mitrelatoriofluxodecaixa1.Tag = 1));

  mitrelatoriofluxodecaixa.Enabled:= (ModuloDisponivel('contasareceber') and
                                     (UsuarioLogin.Suporte or
                                      UsuarioLogin.Administrador or
                                     (usuariologin.AcessosUsuarios.Find('mitrelatoriofluxodecaixa',indice)))or
                                     (mitrelatoriofluxodecaixa.Tag = 1));

  mitConsultaVendas.Enabled:=        (UsuarioLogin.Suporte or
                                      UsuarioLogin.Administrador or
                                     (usuariologin.AcessosUsuarios.Find('mitConsultaVendas',indice)))or
                                     (mitrelatoriofluxodecaixa.Tag = 1);

  mitConsultaOrcamentos.Enabled:=        (UsuarioLogin.Suporte or
                                      UsuarioLogin.Administrador or
                                     (usuariologin.AcessosUsuarios.Find('mitConsultaOrcamentos',indice)))or
                                     (mitrelatoriofluxodecaixa.Tag = 1);

 mitMonitoraBancoDados.Enabled := UsuarioLogin.Suporte or UsuarioLogin.Administrador;




 {Atenção as verificações acima  (Vendas e Orcamentos) .enabled não seriam necessárias se o pacote repostiorio estiver na lista em tecsoft.ini.
  Gedovar 2017-09-15. }

  if assigned(mitAdministracaoTEF) then
    mitAdministracaoTEF.Enabled := (ParSistema.TipoTEF <> tsSEMTEF) and UsuarioLogin.Caixa;

  MostrarSituacaoCaixa;
  if ehFrenteCaixa and UsuarioLogin.Caixa then
  begin
    Menu := nil;
    AbrirCaixa;
    if UsuarioLogin.CaixaAberto then
      ExecutarItemMenuMax(mitFrenteCaixa, True);
//    mitFrenteCaixaClick(mitFrenteCaixa);
  end;
  mitFrenteCaixa.Enabled := Assigned(ECFPadrao) or parsistema.Emissor_de_NFC_e
                            or (fnaturezajuridica='2135'); {empresário individual}
  if mitFrenteCaixa.Enabled then
    if vBloquearSistemaReducaoZPendente or vBloquearSistemaEstoqueFisco then
      mitFrenteCaixa.Enabled := false;

  OpcaoMenuLiberada := true;
  ApagarTodosMenusDesligados;



end;

