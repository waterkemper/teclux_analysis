procedure TfrmTecsoft.mitAdministracaoTEFClick(Sender: TObject);
{$IFDEF LINUX}
begin

{$ELSE}
var
//  tecTEFDiscado: TtecTEFDiscado;

  CupomEmitido: Boolean;
begin
  inherited;
  if Assigned(ECFPadrao) and ECFPadrao.CupomAberto then begin
    SetFocus;
    MensagemAviso(ctCUPOMFISCALABERTO);
    SetFocus;
  end else if ParSistema.TipoTEF = tsDISCADO then
  begin
    //tecTEFDiscado := TtecTEFDiscado.Create(tecTEFDiscado);
    try
//      if tecTEFDiscado.GerenciadorAtivo(False) then begin
      if assigned(tefpadrao) then
        if TEFPadrao.Inicializado(gpTefDial) then
        begin
          CupomEmitido := False;
//          if tecTEFDiscado.ExecutarOperacao(sopADMIN, 0) then
          if tefpadrao.ADM(gpTefDial) then
//            tecTEFDiscado.ImprimirCupom(CupomEmitido, 0, '', '', 0)
             TEFPadrao.ImprimirCupom(CupomEmitido, 0, '', '', 0)
        end else begin
          SetFocus;
          MensagemErro(ctTEFTEGERENCIADORINATIVO);
          SetFocus;
        end
    finally
//      tecTEFDiscado.Free
    end;
  end else if ParSistema.TipoTEF = tsDEDICADO then
    ExecutarItemMenu(mitAdministracaoTEF);
{$ENDIF}
end;

