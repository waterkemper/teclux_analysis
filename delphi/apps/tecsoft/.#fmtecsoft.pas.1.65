procedure TfrmTecsoft.FormShow(Sender: TObject);
begin
  inherited;
  if FileExists(ExtractFilePath(Application.ExeName)+'Anexo_X.txt') then
    if assigned(ecfpadrao) then
    begin
      frmMsg := TfrmMensagemTemporizada.Create(Screen.ActiveForm,
                        'O arquivo do Anexo X do PAF ECF foi gerado em: '+CHR(13)+
                        ExtractFilePath(Application.ExeName)+'Anexo_X.txt');
      frmMsg.Show;
      Application.ProcessMessages;
      Sleep(4000);
      FreeAndNil(frmMsg);
    end;

    {
  if not InsertLigado then
    keybd_event(VK_INSERT,0,0,0);
    }


 if vPendenciaVisualizacaoControleNFE then
 begin
   if MensagemAviso('Existem pendências de envio nas Notas Fiscais Eletrônicas. '+chr(13)+
                    'Verifique em Estoque - Controle de Notas Eletrônicas!') = smbOK then
   begin
     MostrarFormRegistrado([Formatdatetime('dd/mm/yyyy', incday(DataLocal, -30)),
                      formatDateTime('dd/mm/yyyy', DataLocal)], 'TfrmControleNotasFiscaisEletronicas', false, self.Name);
   end;
 end;


end;


procedure TfrmTecsoft.KeyDown(var Key: Word; Shift: TShiftState);
begin
  inherited;
 {
    VK_INSERT :
    begin
      if InsertLigado then
        stbPrincipal.Panels[0].Text := 'INS'
      else
        stbPrincipal.Panels[0].Text := 'OVR';
    end;
  end;    }

end;


