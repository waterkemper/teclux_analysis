procedure TfrmTecsoft.mitFrenteCaixaClick(Sender: TObject);
begin
  inherited;
  OpcaomitFrenteCaixaPressionada := True;
  if OpcaoMenuLiberada then
  begin
    OpcaomitFrenteCaixaPressionada := False;
    AbrirCaixa;
    if assigned(ECFPadrao) then
    begin
      frmMsg := TfrmMensagemTemporizada.Create(Screen.ActiveForm, 'Ativando ECF - Baud '+FVelocidadePorta);
      frmMsg.Show;
      if ECFPadrao.AtivarECF(NomeArquivoECFs, ECFPadrao.PortaSerial, ECFPadrao.Codigo) and
         ECFPadrao.VerificarGT(NomeArquivoECFs) then
        if UsuarioLogin.CaixaAberto then
          ExecutarItemMenu(mitFrenteCaixa);
      FreeAndNil(frmMsg);
    end
    else
    if UsuarioLogin.CaixaAberto then
      ExecutarItemMenu(mitFrenteCaixa);

  end;
end;

