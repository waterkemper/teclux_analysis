procedure TfrmTecsoft.mitCancelarCupomClick(Sender: TObject);
var
  UsuarioAut: TtecUsuarios;
  OK: Boolean;
  Cupom: Integer;
begin
  inherited;
  if UsuarioLogin.GerenteCaixa then
    UsuarioAut := TdtmBasico.ObterAutorizacao(taSENHA, ctCANCELAMENTOCUPOM, ctGERENTECAIXA, '')
  else
    UsuarioAut := TdtmBasico.ObterAutorizacao(taLOGIN, ctCANCELAMENTOCUPOM, ctGERENTECAIXA, '');
  if Assigned(UsuarioAut) then begin
    OK := UsuarioAut.GerenteCaixa;
    if Not OK then
      MensagemAviso(ctUSUARIOSEMPERMISSAO);
  end else
    OK := False;
  if OK then begin
    ECFPadrao.CancelarCupom;

    if ECFPadrao.Erro then
      MensagemErro(ECFPadrao.Mensagem)
  end;
end;

