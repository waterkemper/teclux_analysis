procedure TfrmTecsoft.mitGerarRemessasSoacredClick(Sender: TObject);
begin
  inherited;
{$IFDEF MSWINDOWS}
  ExecutarItemMenu(Sender);
{$ELSE}
  MensagemAviso('Módulo disponível somente para a versão Windows do sistema tecLUX');
