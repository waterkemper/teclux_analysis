procedure TfrmTecsoft.TeclInsClick(Sender: TObject);
begin
  inherited;
  if not InsertLigado then
  begin
    stbPrincipal.Panels[0].Text := 'INS';
    InsertLigado := true;
  end
  else
  begin
    stbPrincipal.Panels[0].Text := 'OVR';
    InsertLigado := false;
  end;
end;

