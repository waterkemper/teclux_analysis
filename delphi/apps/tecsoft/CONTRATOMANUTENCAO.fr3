      <TfrxMemoView Name="Memo42" Left="132,28355" Top="438,42548" Width="619,84292" Height="18,89765" DisplayFormat.DecimalSeparator="," Font.Charset="1" Font.Color="0" Font.Height="-13" Font.Name="Arial" Font.Style="0" ParentFont="False" Text="A LOCATÁRIA concorda desde já, em entregar à título de fiança, o caução no valor de R$                     ,"/>
