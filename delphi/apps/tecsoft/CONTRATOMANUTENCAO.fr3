      <TfrxMemoView Name="Memo38" Left="34,01577" Top="404,40971" Width="128,50402" Height="18,89765" DisplayFormat.DecimalSeparator="," Font.Charset="1" Font.Color="0" Font.Height="-13" Font.Name="Arial" Font.Style="0" ParentFont="False" Text="para as renovações."/>
