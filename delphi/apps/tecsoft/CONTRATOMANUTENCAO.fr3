      <TfrxMemoView Name="Memo33" Left="181,41744" Top="325,03958" Width="574,48856" Height="18,89765" DisplayFormat.DecimalSeparator="," Font.Charset="1" Font.Color="0" Font.Height="-13" Font.Name="Arial" Font.Style="0" ParentFont="False" Text="Após o vencimento da última diária locada, caso não ocorra devolução do equipamento, o"/>
