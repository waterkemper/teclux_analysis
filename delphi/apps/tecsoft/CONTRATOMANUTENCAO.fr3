      <TfrxMemoView Name="Memo35" Left="34,01577" Top="374,17347" Width="102,04731" Height="18,89765" DisplayFormat.DecimalSeparator="," Font.Charset="1" Font.Color="0" Font.Height="-13" Font.Name="Arial" Font.Style="1" ParentFont="False" Text="CLÁUSULA IV -"/>
      <TfrxMemoView Name="Memo36" Left="136,06308" Top="374,17347" Width="619,84292" Height="18,89765" DisplayFormat.DecimalSeparator="," Font.Charset="1" Font.Color="0" Font.Height="-13" Font.Name="Arial" Font.Style="0" ParentFont="False" Text="Fica a LOCATÁRIA ciente que o prazo mínimo para locação do equipamento é de 7 dias (    ) ou "/>
