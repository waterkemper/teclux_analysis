<TfrxReport Version="4.0.11" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39951,4249289236" ReportOptions.Description.Text="" ReportOptions.LastChange="45553,4138550463" ScriptLanguage="PascalScript" ScriptText.Text="procedure OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with , Engine do&#13;&#10;  begin&#13;&#10;  if [TabelaProdutosVazia] then&#13;&#10;   CabecalhoProdutos.visible:=False&#13;&#10; else&#13;&#10;   CabecalhoProdutos.visible:=True;&#13;&#10;&#13;&#10; if [TabelaServicosVazia] then&#13;&#10;   CabecalhoServicos.visible:=False&#13;&#10; else&#13;&#10;   CabecalhoServicos.visible:=True;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure CabecalhoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Cabecalho, Engine do&#13;&#10;  begin&#13;&#10;  NPRODPAGINA := 0;&#13;&#10;  Continua := 1;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure CorpoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Corpo, Engine do&#13;&#10;  begin&#13;&#10;  Filha2.visible := ([qryContratos.&#34;montagemobs&#34;]&#60;&#62;'') or ([qryContratos.&#34;consideracoes&#34;]&#60;&#62;'');&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DadosProdutosOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with DadosProdutos, Engine do&#13;&#10;  begin&#13;&#10;  NPRODPAGINA := NPRODPAGINA + 1;&#13;&#10;&#13;&#10;  if [qryProdutosContratos.&#34;complemento&#34;] &#60;&#62; '' then&#13;&#10;    Filha1.visible := true&#13;&#10;  else&#13;&#10;    Filha1.visible := false;&#13;&#10;&#13;&#10;&#13;&#10;  if [qryProdutosContratos.&#34;compostovisual&#34;]&#60;&#62;[qryProdutosContratos.&#34;produtovisual&#34;] then&#13;&#10;  begin&#13;&#10;    memoproduto.Font.Style := fsBold;&#13;&#10;    memocomposto.Font.Style := fsBold;&#13;&#10;    memomercadorias.Font.Style := fsBold;&#13;&#10;    memolocalizacao.Font.Style := fsBold;&#13;&#10;    memoreferencia.Font.Style := fsBold;&#13;&#10;    memofilial.Font.Style := fsBold;&#13;&#10;    memovendedor.Font.Style := fsBold;&#13;&#10;    memoqtde.Font.Style := fsBold;&#13;&#10;    memoprecounitario.Font.Style := fsBold;&#13;&#10;    memototal.Font.Style := fsBold;&#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    memoproduto.Font.Style := 0;&#13;&#10;    memocomposto.Font.Style := 0;&#13;&#10;    memomercadorias.Font.Style := 0;&#13;&#10;    memolocalizacao.Font.Style := 0;&#13;&#10;    memoreferencia.Font.Style := 0;&#13;&#10;    memofilial.Font.Style := 0;&#13;&#10;    memovendedor.Font.Style := 0;&#13;&#10;    memoqtde.Font.Style := 0;&#13;&#10;    memoprecounitario.Font.Style := 0;&#13;&#10;    memototal.Font.Style := 0;&#13;&#10;  end;&#13;&#10;&#13;&#10;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure RodapeOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Rodape, Engine do&#13;&#10;  begin&#13;&#10;  if continua &#60;&#62; 0 then&#13;&#10;  begin&#13;&#10;    Memo195.visible := true;&#13;&#10;    Line2.visible := true;&#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    memo195.visible := false;&#13;&#10;    Line2.visible := false;&#13;&#10;  end;&#13;&#10;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo49OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo49, Engine do&#13;&#10;  begin&#13;&#10;  if (([qryContratos.&#34;endnumero&#34;] &#62; 0) and ([qryContratos.&#34;endcomplemento&#34;]&#60;&#62;'')) then&#13;&#10;    Memo:=[qryContratos.&#34;rua&#34;]+','+[str(qryContratos.&#34;endnumero&#34;)]+' - '+[qryContratos.&#34;endcomplemento&#34;]&#13;&#10;  else if ([qryContratos.&#34;endnumero&#34;] &#62; 0) then&#13;&#10;    Memo:=[qryContratos.&#34;rua&#34;]+','+[str(qryContratos.&#34;endnumero&#34;)]&#13;&#10;  else&#13;&#10;    Memo:=[qryContratos.&#34;rua&#34;]&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure memoqtdeOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with memoqtde, Engine do&#13;&#10;  begin&#13;&#10;  if [qryProdutosContratos.&#34;quantidade&#34;]&#60;&#62;0 then&#13;&#10;     memo := [FormatFloat([MascaraQuantidade],[qryProdutosContratos.&#34;quantidade&#34;])]&#13;&#10;  else&#13;&#10;     memo := '';&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo5OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo5, Engine do&#13;&#10;  begin&#13;&#10;begin&#13;&#10;    if [qryContratos.&#34;pessoatipo&#34; ] = 'J' then&#13;&#10;      Memo:= ''&#13;&#10;    else&#13;&#10;      Memo:= 'Pai:'&#13;&#10;end&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo6OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo6, Engine do&#13;&#10;  begin&#13;&#10;begin&#13;&#10;    if [qryContratos.&#34;pessoatipo&#34; ] = 'J' then&#13;&#10;      Memo:= ''&#13;&#10;    else&#13;&#10;      Memo:= 'M�e:'&#13;&#10;end&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo10OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo10, Engine do&#13;&#10;  begin&#13;&#10;  if [qryContratos.&#34;pessoanumero&#34; ] &#60;&#62; '' then begin&#13;&#10;    if [qryContratos.&#34;pessoatipo&#34; ] = 'F' then&#13;&#10;      Memo:= [FORMATTEXT('###.###.###-##',[qryContratos.&#34;pessoanumero&#34;])]&#13;&#10;    else&#13;&#10;      Memo:= [FORMATTEXT('##.###.###/####-##',[qryContratos.&#34;pessoanumero&#34;])]&#13;&#10;  end&#13;&#10;  else&#13;&#10;    Memo:= '';&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo14OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo14, Engine do&#13;&#10;  begin&#13;&#10;  if [qryContratos.&#34;nascto&#34;] &#60;&#62; 0 then&#13;&#10;       Memo:= FormatDateTime('dd/mm/yyyy',[qryContratos.&#34;nascto&#34;])&#13;&#10;  else Memo:= '';&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo18OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo18, Engine do&#13;&#10;  begin&#13;&#10;  if [qryContratos.&#34;sexo&#34;] = 'M' then&#13;&#10;    Memo:= 'Masculino'&#13;&#10;  else if [qryContratos.&#34;sexo&#34;] = 'F' then&#13;&#10;    Memo:= 'Feminino'&#13;&#10;  else if [qryContratos.&#34;sexo&#34;] = 'E' then&#13;&#10;    Memo:= 'Empresa';&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo19OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo19, Engine do&#13;&#10;  begin&#13;&#10;  if [qryContratos.&#34;civil&#34;] = 'C' then&#13;&#10;    Memo:= 'Casado'&#13;&#10;  else if [qryContratos.&#34;civil&#34;] = 'S' then&#13;&#10;    Memo:= 'Solteiro'&#13;&#10;  else if [qryContratos.&#34;civil&#34;] = 'D' then&#13;&#10;    Memo:= 'Divorciado'&#13;&#10;  else if [qryContratos.&#34;civil&#34;] = 'V' then&#13;&#10;    Memo:= 'Vi�vo'&#13;&#10;  else&#13;&#10;    Memo:= 'Outros';&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo20OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo20, Engine do&#13;&#10;  begin&#13;&#10;begin&#13;&#10;    if [qryContratos.&#34;pessoatipo&#34; ] = 'J' then&#13;&#10;      Memo:= 'I.E.'&#13;&#10;    else&#13;&#10;      Memo:= 'Identidade'&#13;&#10;end&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo26OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo26, Engine do&#13;&#10;  begin&#13;&#10;  if [qryContratos.&#34;iddata&#34;] &#60;&#62; 0 then&#13;&#10;       Memo:= FormatDateTime('dd/mm/yyyy',[qryContratos.&#34;iddata&#34;])&#13;&#10;  else Memo:= '';&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo28OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo28, Engine do&#13;&#10;  begin&#13;&#10;  if [qryContratos.&#34;cliente&#34;] &#60;&#62; 0 then&#13;&#10;       Memo:= [qryContratos.&#34;cliente&#34;]&#13;&#10;  else Memo:= '';&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo50OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo50, Engine do&#13;&#10;  begin&#13;&#10;  if [qryContratos.&#34;cep&#34;] &#62; 0 then&#13;&#10;    Memo:= Copy([qryContratos.&#34;cep&#34;],1,2) + '.' +&#13;&#10;           Copy([qryContratos.&#34;cep&#34;],3,3) + '-' +&#13;&#10;           Copy([qryContratos.&#34;cep&#34;],6,3)&#13;&#10;  else&#13;&#10;    Memo:= '';&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo55OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo55, Engine do&#13;&#10;  begin&#13;&#10;  if [qryContratos.&#34;restipo&#34;] = 'P' then&#13;&#10;    Memo:= 'Pr�pria'&#13;&#10;  else if [qryContratos.&#34;restipo&#34;] = 'A' then&#13;&#10;    Memo:= 'Alugada'&#13;&#10;  else if [qryContratos.&#34;restipo&#34;] = 'F' then&#13;&#10;    Memo:= 'Financiada'&#13;&#10;  else if [qryContratos.&#34;restipo&#34;] = 'R' then&#13;&#10;    Memo:= 'Parente'&#13;&#10;  else if [qryContratos.&#34;restipo&#34;] = 'T' then&#13;&#10;    Memo:= 'Trabalho'&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo51OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo51, Engine do&#13;&#10;  begin&#13;&#10;  if [qryContratos.&#34;restempo&#34;] &#60;&#62; 0 then&#13;&#10;       Memo:= FormatDateTime('dd/mm/yyyy',[qryContratos.&#34;restempo&#34;])&#13;&#10;  else Memo:= '';&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo45OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo45, Engine do&#13;&#10;  begin&#13;&#10;  if [qryContratos.&#34;fonenumero&#34;] &#62; 0 then begin&#13;&#10;    if [qryContratos.&#34;foneddd&#34;] = 0 then&#13;&#10;         Text:= '(  ) '&#13;&#10;    else Text:= '(' + Str([qryContratos.&#34;foneddd&#34;]) + ') ';&#13;&#10;    if Length([qryContratos.&#34;fonenumero&#34;]) = 7 then&#13;&#10;      Memo:= Text + Copy([qryContratos.&#34;fonenumero&#34;],1,3) + '-' +&#13;&#10;                    Copy([qryContratos.&#34;fonenumero&#34;],4,4)&#13;&#10;    else if Length([qryContratos.&#34;fonenumero&#34;]) = 8 then&#13;&#10;      Memo:= Text + Copy([qryContratos.&#34;fonenumero&#34;],1,4) + '-' +&#13;&#10;                    Copy([qryContratos.&#34;fonenumero&#34;],5,4)&#13;&#10;    else&#13;&#10;      Memo:= Text + Copy([qryContratos.&#34;fonenumero&#34;],1,4) + '-' +&#13;&#10;                    Copy([qryContratos.&#34;fonenumero&#34;],5,Length([qryContratos.&#34;fonenumero&#34;]))&#13;&#10;  end;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo57OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo57, Engine do&#13;&#10;  begin&#13;&#10;  if [qryContratos.&#34;fone2numero&#34;] &#62; 0 then begin&#13;&#10;    if [qryContratos.&#34;fone2ddd&#34;] = 0 then&#13;&#10;         Text:= '(  ) '&#13;&#10;    else Text:= '(' + Str([qryContratos.&#34;fone2ddd&#34;]) + ') ';&#13;&#10;    if Length([qryContratos.&#34;fone2numero&#34;]) = 7 then&#13;&#10;      Memo:= Text + Copy([qryContratos.&#34;fone2numero&#34;],1,3) + '-' +&#13;&#10;                    Copy([qryContratos.&#34;fone2numero&#34;],4,4)&#13;&#10;    else if Length([qryContratos.&#34;fone2numero&#34;]) = 8 then&#13;&#10;      Memo:= Text + Copy([qryContratos.&#34;fone2numero&#34;],1,4) + '-' +&#13;&#10;                    Copy([qryContratos.&#34;fone2numero&#34;],5,4)&#13;&#10;    else&#13;&#10;      Memo:= Text + Copy([qryContratos.&#34;fone2numero&#34;],1,4) + '-' +&#13;&#10;                    Copy([qryContratos.&#34;fone2numero&#34;],5,Length([qryContratos.&#34;fone2numero&#34;]))&#13;&#10;  end;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure memototalOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with memototal, Engine do&#13;&#10;  begin&#13;&#10;    if [[qryProdutosContratos.&#34;quantidade&#34;] * [qryProdutosContratos.&#34;precovenda&#34;]] &#62; 0 then&#13;&#10;       Memo:= FormatFloat('###,###,##0.00',[[qryProdutosContratos.&#34;quantidade&#34;] * [qryProdutosContratos.&#34;precovenda&#34;]])&#13;&#10;  else Memo:= '';&#13;&#10;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure memoprecounitarioOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with memoprecounitario, Engine do&#13;&#10;  begin&#13;&#10;  if [qryProdutosContratos.&#34;precovenda&#34;] &#62; 0 then&#13;&#10;       Memo:= FormatFloat('###,###,##0.00',[qryProdutosContratos.&#34;precovenda&#34;])&#13;&#10;  else Memo:= '';&#13;&#10;&#13;&#10;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." PropData="">
