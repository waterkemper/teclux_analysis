#------------------------------------------------------------------------------
VERSION = BWS.01
#------------------------------------------------------------------------------
!ifndef ROOT
ROOT = $(MAKEDIR)\..
!endif
#------------------------------------------------------------------------------
MAKE = $(ROOT)\bin\make.exe -$(MAKEFLAGS) -f$**
DCC = $(ROOT)\bin\dcc32.exe $**
BRCC = $(ROOT)\bin\brcc32.exe $**
#------------------------------------------------------------------------------
PROJECTS = tecsoft6.bpl automacao.bpl repositorio.bpl teclux_conferencia.exe
#------------------------------------------------------------------------------
default: $(PROJECTS)
#------------------------------------------------------------------------------

repositorio.bpl: ..\..\repositorio\repositorio.dpk
  $(DCC)

tecsoft6.bpl: ..\..\biblio\componentes\tecsoft6.dpk
  $(DCC)

automacao.bpl: ..\..\biblio\automacao\automacao.dpk
  $(DCC)

teclux_conferencia.exe: teclux_conferencia.dpr
  $(DCC)


