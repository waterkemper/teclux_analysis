<?xml version="1.0" encoding="utf-8"?>
<TfrxReport Version="4.0.11" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="39962,6194578241" ReportOptions.Description.Text="" ReportOptions.LastChange="45918,5952615046" ScriptLanguage="PascalScript" ScriptText.Text="procedure Dados_MestreOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Dados_Mestre, Engine do&#13;&#10;  begin&#13;&#10; if ([qryEventos.&#34;tipo&#34;] = 'S') then&#13;&#10; begin&#13;&#10;   Memo1.FillColor:= clSilver;&#13;&#10;   Memo3.FillColor:= clSilver;&#13;&#10;   Memo8.FillColor:= clSilver;&#13;&#10; end&#13;&#10; else&#13;&#10; begin&#13;&#10;   Memo1.FillColor:= clTransparent;&#13;&#10;   Memo3.FillColor:= clTransparent;&#13;&#10;   Memo8.FillColor:= clTransparent;&#13;&#10; end;&#13;&#10;&#13;&#10; if [OutraPagina] then&#13;&#10;   if ([qryEventos.&#34;tipo&#34;] = 'S') then&#13;&#10;     if ([qryEventos.&#34;classificacao&#34;]='2') then&#13;&#10;   NewPage;&#13;&#10;&#13;&#10; if [qryEventosTotal.&#34;tipo&#34;] = 'S' then&#13;&#10;   Soma:= Soma + [qryEventosTotal.&#34;saldomes&#34;];&#13;&#10;&#13;&#10; IF [PULAR_LINHA] = true then&#13;&#10;   if ([qryEventosTotal.&#34;tipo&#34;] = 'S') then&#13;&#10;   begin&#13;&#10;     Memo1.Heigth:= 80;&#13;&#10;     Memo3.Heigth:= 80;&#13;&#10;     Memo8.Heigth:= 80;&#13;&#10;     DadosMestre.Heigth:= 80;&#13;&#10;   end&#13;&#10;   else&#13;&#10;   begin&#13;&#10;     Memo1.Heigth:= 6;&#13;&#10;     Memo3.Heigth:= 6;&#13;&#10;     Memo8.Heigth:= 6;&#13;&#10;     DadosMestre.Heigth:= 6;&#13;&#10;   end;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo1, Engine do&#13;&#10;  begin&#13;&#10;  Memo:= [formatfloat('###,###,##0.00',[qryEventosTotal.&#34;saldomes&#34;])]&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo2, Engine do&#13;&#10;  begin&#13;&#10;  TotalGeral:= Totalgeral + [SUM(IF(([qryEventosTotal.&#34;tipo&#34;]='S') and ([LENGTH(qryEventosTotal.&#34;classificacao&#34;)=1]),[qryEventosTotal.&#34;saldomesnormal&#34;], 0), Dados Mestre,1)];&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo3OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo3, Engine do&#13;&#10;  begin&#13;&#10;   Memo:= [formatfloat('###,###,##0.00',[SUM([qryEventosTotal.&#34;saldomes&#34;], Band6, 1)])]&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo9OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo9, Engine do&#13;&#10;  begin&#13;&#10;       if [COPY([qryEventosTotal.&#34;mes&#34;], 6, 2)] = '01' then Memo:= 'JAN/' + str([qryEventosTotal.&#34;exercicio&#34;])&#13;&#10;  else if [COPY([qryEventosTotal.&#34;mes&#34;], 6, 2)] = '02' then Memo:= 'FEV/' + str([qryEventosTotal.&#34;exercicio&#34;])&#13;&#10;  else if [COPY([qryEventosTotal.&#34;mes&#34;], 6, 2)] = '03' then Memo:= 'MAR/' + str([qryEventosTotal.&#34;exercicio&#34;])&#13;&#10;  else if [COPY([qryEventosTotal.&#34;mes&#34;], 6, 2)] = '04' then Memo:= 'ABR/' + str([qryEventosTotal.&#34;exercicio&#34;])&#13;&#10;  else if [COPY([qryEventosTotal.&#34;mes&#34;], 6, 2)] = '05' then Memo:= 'MAI/' + str([qryEventosTotal.&#34;exercicio&#34;])&#13;&#10;  else if [COPY([qryEventosTotal.&#34;mes&#34;], 6, 2)] = '06' then Memo:= 'JUN/' + str([qryEventosTotal.&#34;exercicio&#34;])&#13;&#10;  else if [COPY([qryEventosTotal.&#34;mes&#34;], 6, 2)] = '07' then Memo:= 'JUL/' + str([qryEventosTotal.&#34;exercicio&#34;])&#13;&#10;  else if [COPY([qryEventosTotal.&#34;mes&#34;], 6, 2)] = '08' then Memo:= 'AGO/' + str([qryEventosTotal.&#34;exercicio&#34;])&#13;&#10;  else if [COPY([qryEventosTotal.&#34;mes&#34;], 6, 2)] = '09' then Memo:= 'SET/' + str([qryEventosTotal.&#34;exercicio&#34;])&#13;&#10;  else if [COPY([qryEventosTotal.&#34;mes&#34;], 6, 2)] = '10' then Memo:= 'OUT/' + str([qryEventosTotal.&#34;exercicio&#34;])&#13;&#10;  else if [COPY([qryEventosTotal.&#34;mes&#34;], 6, 2)] = '11' then Memo:= 'NOV/' + str([qryEventosTotal.&#34;exercicio&#34;])&#13;&#10;  else if [COPY([qryEventosTotal.&#34;mes&#34;], 6, 2)] = '12' then Memo:= 'DEZ/' + str([qryEventosTotal.&#34;exercicio&#34;]);&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." PropData="">
