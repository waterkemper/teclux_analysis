      <TfrxMemoView Name="Memo38" Left="34,01577" Top="464,88219" Width="226,7718" Height="18,89765" DisplayFormat.DecimalSeparator="," Font.Charset="1" Font.Color="0" Font.Height="-13" Font.Name="Arial" Font.Style="0" ParentFont="False" Text="Válido também para as renovações."/>
