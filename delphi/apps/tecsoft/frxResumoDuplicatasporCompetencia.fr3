13;&#10;//    CabecalhoFilial.OutLineText := '';&#13;&#10;    CabecalhoFilial.visible:=false;&#13;&#10;    RodapeFilial.visible:=false;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if &#60;AgruparFornecedor&#62; then&#13;&#10;  begin&#13;&#10;   CabecalhoFornecedor.visible:=true;&#13;&#10;   RodapeFornecedor.visible:=true;&#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    CabecalhoFornecedor.visible:=false;&#13;&#10;    RodapeFornecedor.visible:=false;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if &#60;AgruparData&#62; then&#13;&#10;  begin&#13;&#10;   CabecalhoDataLancto.visible:=true;&#13;&#10;   RodapeDataLancto.visible:=true;&#13;&#10;   CabecalhoMesAno.visible:=true;&#13;&#10;   RodapeMesAno.visible:=true;&#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    CabecalhoDataLancto.visible:=false;&#13;&#10;    RodapeDataLancto.visible:=false;&#13;&#10;    CabecalhoMesAno.visible:=false;&#13;&#10;    RodapeMesAno.visible:=false;&#13;&#10;  end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo47OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  mmoTotalValorPagto.text := floattostr(SUM(&#60;frxDBDataset.&#34;valorpagto&#34;&#62;,MasterData1,1));&#13;&#10;end;&#13;&#10;&#13;&#10;procedure CabecalhoDocumentopagOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if vZebrar2 then&#13;&#10;  begin&#13;&#10;    mmoZebrado2.color := &#60;CordoZebrado&#62;;&#13;&#10;    vZebrar2 := false;&#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    mmoZebrado2.color := clwhite;&#13;&#10;    vZebrar2 := true;&#13;&#10;  end;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if vZebrar then&#13;&#10;  begin&#13;&#10;    mmoZebrado.color := &#60;CordoZebrado&#62;;&#13;&#10;    vZebrar := false;&#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    mmoZebrado.color := clwhite;&#13;&#10;    vZebrar := true;&#13;&#10;  end;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure CabecalhoFilialOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10; if &#60;AgruparFilial&#62; then&#13;&#10; begin&#13;&#10;   Outline.LevelRoot;&#13;&#10;   Outline.AddItem(inttostr(&#60;frxDBDataset.&#34;filialemissao&#34;&#62;)+' - '+&#60;frxDBDataset.&#34;nomefilialemissao&#34;&#62;);&#13;&#10; end;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure CabecalhoGrupoFilialOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10; if &#60;AgruparGrupoFilial&#62; then&#13;&#10; begin&#13;&#10;   Outline.LevelRoot;&#13;&#10;   Outline.AddItem(inttostr(&#60;frxDBDataset.&#34;grupofilialemissao&#34;&#62;)+' - '+&#60;frxDBDataset.&#34;nomegrupofilialemissao&#34;&#62;);&#13;&#10; end;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." PropData="">
