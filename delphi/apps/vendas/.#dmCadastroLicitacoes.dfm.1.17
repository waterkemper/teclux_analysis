  object qryContratosNotaseCuponsdaLicitacao: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select notasecupons.* from'
      '('
      ''
      '  Select  ct.numero as contrato,'
      '          ct.data as datacontrato,'
      '          '
      '          cast (case when ct.situacao = '#39'O'#39' then '#39'OR'#199'ADO'#39
      '                     when ct.situacao = '#39'R'#39' then '#39'RESERVADO'#39
      '                     when ct.situacao = '#39'F'#39' then'
      '                             case when'
      ''
      '                                 coalesce((select true'
      '                                           from dadosfiscais df'
      
        '                                           where df.contrato = c' +
        'oalesce(ct.primogenito,ct.numero)'
      
        '                                             and df.situacao = '#39 +
        'N'#39
      
        '                                             and mod(df.codigofi' +
        'scal,1000) = 922 limit 1), false)'
      
        '                             then '#39'SIMPLES FATURAMENTO'#39' else '#39'FA' +
        'TURADO'#39' end'
      '                     when ct.situacao = '#39'P'#39' then '#39'NOTA PARCIAL'#39
      '                     when ct.situacao = '#39'N'#39' then '#39'NOTA FISCAL'#39
      '                     when ct.situacao = '#39'C'#39' then '#39'CANCELADO'#39
      '             end as varchar(20)) as NomeSituacaoContrato,'
      '          '
      '          n.filial,'
      '          n.serie,'
      '          cast(null as integer) as maquina,'
      '          cast(null as integer) as intervensao,'
      '          n.numero,'
      '          df.datasaida,'
      '          df.situacao,'
      '          cast('
      '          case when df.situacao = '#39'C'#39' then '#39'CANCELADA'#39
      '               when df.situacao = '#39'N'#39' then '#39'NORMAL'#39
      '               when df.situacao = '#39'D'#39' then '#39'DENEGADA'#39
      '          end as varchar(9)) as descricaosituacaoDoctoFiscal,'
      '          df.natureza,'
      '          df.cliente,'
      '          df.tipocliente,'
      '          df.nome as nomecliente,'
      '          df.valortotal,'
      '          df.numero as dadofiscal,'
      '          df.chv_nfe'
      ''
      '  From    contratos ct'
      '          join (dadosfiscais df'
      '                     join notas n'
      '                     on df.numero = n.dadofiscal)'
      '          on ct.numero = df.contrato'
      ''
      '  Where ct.licitacao = :licitacao'
      ''
      '       union all'
      ''
      ''
      '  Select  ct.numero as contrato,'
      '          ct.data as datacontrato,'
      ''
      '          cast (case when ct.situacao = '#39'O'#39' then '#39'OR'#199'ADO'#39
      '                     when ct.situacao = '#39'R'#39' then '#39'RESERVADO'#39
      '                     when ct.situacao = '#39'F'#39' then'
      '                             case when'
      ''
      '                                 coalesce((select true'
      '                                           from dadosfiscais df'
      
        '                                           where df.contrato = c' +
        'oalesce(ct.primogenito,ct.numero)'
      
        '                                             and df.situacao = '#39 +
        'N'#39
      
        '                                             and mod(df.codigofi' +
        'scal,1000) = 922 limit 1), false)'
      
        '                             then '#39'SIMPLES FATURAMENTO'#39' else '#39'FA' +
        'TURADO'#39' end'
      '                     when ct.situacao = '#39'P'#39' then '#39'NOTA PARCIAL'#39
      '                     when ct.situacao = '#39'N'#39' then '#39'NOTA FISCAL'#39
      '                     when ct.situacao = '#39'C'#39' then '#39'CANCELADO'#39
      '             end as varchar(20)) as NomeSituacaoContrato,'
      ''
      ''
      '          c.filial,'
      '          c.numeroserie as serie,'
      '          c.maquina,'
      '          c.intervensao,'
      '          c.numero,'
      '          df.datasaida,'
      '          df.situacao,'
      '          cast('
      '          case when df.situacao = '#39'C'#39' then '#39'CANCELADA'#39
      '               when df.situacao = '#39'N'#39' then '#39'NORMAL'#39
      '               when df.situacao = '#39'D'#39' then '#39'DENEGADA'#39
      '          end as varchar(9)) as descricaosituacaoDoctoFiscal,'
      '          df.natureza,'
      '          df.cliente,'
      '          df.tipocliente,'
      '          df.nome as nomecliente,'
      '          df.valortotal,'
      '          df.numero as dadofiscal,'
      '          df.chv_nfe'
      ''
      '  From    contratos ct'
      '          join (dadosfiscais df'
      '                     join cupons c'
      '                     on df.numero = c.dadofiscal)'
      '          on ct.numero = df.contrato'
      ''
      '  Where ct.licitacao = :licitacao'
      ''
      '  union'
      ''
      '    Select  ct.numero as contrato,'
      '          ct.data as datacontrato,'
      ''
      '          cast (case when ct.situacao = '#39'O'#39' then '#39'OR'#199'ADO'#39
      '                     when ct.situacao = '#39'R'#39' then '#39'RESERVADO'#39
      '                     when ct.situacao = '#39'F'#39' then'
      '                             case when'
      ''
      '                                 coalesce((select true'
      '                                           from dadosfiscais df'
      
        '                                           where df.contrato = c' +
        'oalesce(ct.primogenito,ct.numero)'
      
        '                                             and df.situacao = '#39 +
        'N'#39
      
        '                                             and mod(df.codigofi' +
        'scal,1000) = 922 limit 1), false)'
      
        '                             then '#39'SIMPLES FATURAMENTO'#39' else '#39'FA' +
        'TURADO'#39' end'
      '                     when ct.situacao = '#39'P'#39' then '#39'NOTA PARCIAL'#39
      '                     when ct.situacao = '#39'N'#39' then '#39'NOTA FISCAL'#39
      '                     when ct.situacao = '#39'C'#39' then '#39'CANCELADO'#39
      '             end as varchar(20)) as NomeSituacaoContrato,'
      ''
      ''
      '          ct.filialvenda as filial,'
      '          c.numeroserie as serie,'
      '          c.maquina,'
      '          c.intervensao,'
      '          c.numero,'
      '          df.datasaida,'
      '          df.situacao,'
      '          cast('
      '          case when df.situacao = '#39'C'#39' then '#39'CANCELADA'#39
      '               when df.situacao = '#39'N'#39' then '#39'NORMAL'#39
      '               when df.situacao = '#39'D'#39' then '#39'DENEGADA'#39
      '          end as varchar(9)) as descricaosituacaoDoctoFiscal,'
      '          df.natureza,'
      '          ct.cliente,'
      '          ct.tipocliente,'
      '          ct.nome as nomecliente,'
      '          ct.valorprazo as valortotal,'
      '          df.numero as dadofiscal,'
      '          df.chv_nfe'
      ''
      '  From    contratos ct'
      '          left join (dadosfiscais df'
      '                     join cupons c'
      '                     on df.numero = c.dadofiscal)'
      '          on ct.numero = df.contrato'
      ''
      '  Where ct.licitacao = :licitacao'
      '    and df.numero is null'
      '    and c.dadofiscal is null'
      '    and ct.situacao in ('#39'O'#39','#39'R'#39','#39'F'#39','#39'C'#39')'
      ''
      ''
      ') as notasecupons'
      'order by contrato, datasaida, numero')
    RequestLive = False
    Left = 224
    Top = 92
    ParamData = <
      item
        DataType = ftString
        Name = 'licitacao'
        ParamType = ptUnknown
        Value = '24'
      end>
