  object qryProdutosLicitacoes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryProdutosLicitacoesBeforeOpen
    AfterEdit = qryProdutosLicitacoesAfterEdit
    BeforePost = qryProdutosLicitacoesBeforePost
    AfterPost = qryProdutosLicitacoesAfterPost
    AfterCancel = qryProdutosLicitacoesAfterCancel
    AfterDelete = qryProdutosLicitacoesAfterDelete
    OnCalcFields = qryProdutosLicitacoesCalcFields
    OnNewRecord = qryProdutosLicitacoesNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select lc.*,'
      '       lc.produto as produtoantesalterar,'
      '       p.codigovisual as produtovisual,'
      '       p.descricao as descricaoproduto,'
      '      (lc.quantidade * lc.preco) as TotalProduto,'
      ''
      
        '       Nullif(produtos_licitacoes_orcados(lc.licitacao, lc.produ' +
        'to, lc.numero),0) as orcados,'
      
        '       Nullif(produtos_licitacoes_reservados(lc.licitacao, lc.pr' +
        'oduto, lc.numero),0) as reservados,'
      
        '       Nullif(produtos_licitacoes_faturados(lc.licitacao, lc.pro' +
        'duto, lc.numero),0) as Faturados,'
      ''
      
        '       Nullif(produtos_licitacoes_entregues(lc.licitacao, lc.pro' +
        'duto, lc.numero),0) as NotaFiscal,'
      
        '       Nullif(produtos_licitacoes_devolvidos(lc.licitacao, lc.pr' +
        'oduto, lc.numero),0) as Devolvidos,'
      ''
      
        '       (produtos_licitacoes_orcados(lc.licitacao, lc.produto, lc' +
        '.numero) * lc.preco) as TotalOrcado,'
      
        '       (produtos_licitacoes_reservados(lc.licitacao, lc.produto,' +
        ' lc.numero) * lc.preco) as TotalReservado,'
      
        '       (produtos_licitacoes_faturados(lc.licitacao, lc.produto, ' +
        'lc.numero) * lc.preco) as TotalFaturado,'
      
        '       (produtos_licitacoes_entregues(lc.licitacao, lc.produto, ' +
        'lc.numero) * lc.preco) as TotalEntregue,'
      
        '       (produtos_licitacoes_devolvidos(lc.licitacao, lc.produto,' +
        ' lc.numero) * lc.preco) as TotalDevolvido,'
      ''
      '       (lc.entregar * lc.preco) as TotalEntregar,'
      ''
      '       cast(null as numeric(11,3)) as Pendente,'
      ''
      '       0.00 as TotalPendente,'
      ''
      '       cast(null as numeric(11,3)) as PendenteAtual,'
      '       c.marca,'
      '       m.descricao as descricaomarca,'
      '       c.unidade,'
      '       u.descricao as descricaounidade,'
      '       p.caracteristica,'
      '       lc.referencialicitacao,'
      ''
      '       (select e.valorultimacompra'
      '        from estoques e'
      '        where e.produto = p.codigo'
      '          and e.filial = :filialvenda) as valorultimacompra,'
      ''
      '       cast('
      '          coalesce('
      '          ('
      '          select sum(e.financeiro) /'
      '                 sum(e.emestoque +'
      '                     e.reservado +'
      '                     e.reservaprevia +'
      '                     e.transito +'
      '                     e.demonstracao +'
      '                     e.conserto +'
      '                     e.danificada)'
      ''
      '          from estoques e'
      '          where e.produto = p.codigo'
      
        '            and (e.emestoque+e.reservado+e.reservaprevia+e.trans' +
        'ito+e.demonstracao+e.conserto+e.danificada) <> 0'
      '            and  e.financeiro<>0'
      '            and e.filial = :filialvenda'
      '       ),0.00) as numeric(11,2)) as customedio'
      ''
      'from licitacoesprodutos lc'
      '     join (produtos p'
      '           join ((caracteristicas c'
      '                 join marcas m'
      '                 on c.marca = m.codigo)'
      '                 join unidades u'
      '                 on c.unidade = u.codigo)'
      '           on p.caracteristica = c.codigo)'
      ''
      '     on lc.produto = p.codigo'
      'where lc.licitacao = :licitacao'
      ''
      'order by lc.numero')
    RequestLive = True
    Left = 32
    Top = 128
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'filialvenda'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'licitacao'
        ParamType = ptUnknown
      end>
