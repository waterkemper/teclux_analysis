  object qryContratosdaLicitacao: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '  Select  ct.numero as contrato,'
      '          ct.data as datacontrato,'
      ''
      '          cast (case when ct.situacao = '#39'O'#39' then '#39'OR'#199'ADO'#39
      '                     when ct.situacao = '#39'R'#39' then '#39'RESERVADO'#39
      '                     when ct.situacao = '#39'F'#39' then'
      '                             case when'
      ''
      '                                 coalesce((select true'
      '                                           from dadosfiscais df'
      
        '                                           where df.contrato = c' +
        'oalesce(ct.primogenito,ct.numero)'
      
        '                                             and df.situacao = '#39 +
        'N'#39
      
        '                                             and mod(df.codigofi' +
        'scal,1000) = 922 limit 1), false)'
      
        '                             then '#39'SIMPLES FATURAMENTO'#39' else '#39'FA' +
        'TURADO'#39' end'
      '                     when ct.situacao = '#39'P'#39' then '#39'NOTA PARCIAL'#39
      '                     when ct.situacao = '#39'N'#39' then '#39'NOTA FISCAL'#39
      '                     when ct.situacao = '#39'C'#39' then '#39'CANCELADO'#39
      '             end as varchar(20)) as NomeSituacaoContrato,'
      ''
      '          ct.cliente,'
      '          ct.tipocliente,'
      '          ct.nome as nomecliente,'
      '          ct.valorprazo'
      ''
      '  From    contratos ct'
      ''
      '  Where ct.licitacao = :licitacao'
      ''
      '  order by ct.data, ct.numero'
      '')
    RequestLive = False
    Left = 208
    Top = 276
    ParamData = <
      item
        DataType = ftString
        Name = 'licitacao'
        ParamType = ptUnknown
        Value = '24'
      end>
    object qryContratosdaLicitacaocontrato: TStringField
      FieldName = 'contrato'
    end
    object qryContratosdaLicitacaodatacontrato: TDateField
      Alignment = taCenter
      FieldName = 'datacontrato'
      EditMask = '99/99/9999;1; '
    end
    object qryContratosdaLicitacaonomesituacaocontrato: TStringField
      FieldName = 'nomesituacaocontrato'
    end
    object qryContratosdaLicitacaocliente: TIntegerField
      FieldName = 'cliente'
    end
    object qryContratosdaLicitacaotipocliente: TStringField
      FieldName = 'tipocliente'
      Size = 1
    end
    object qryContratosdaLicitacaonomecliente: TStringField
      FieldName = 'nomecliente'
      Size = 60
    end
    object qryContratosdaLicitacaovalorprazo: TFloatField
      FieldName = 'valorprazo'
      DisplayFormat = '0.00'
    end
  end
  object qryProdutosContratosLicitacoes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkFields = 'contrato = contrato'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrContratosdaLicitacao
    Constraints = <>
    OnCalcFields = qryProdutosContratosLicitacoesCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select pc.contrato,'
      '       pc.produto,'
      '       pc.numeroprodutolicitacao,'
      '       pc.precovenda,'
      '       Pc.quantidade,'
      ''
      '       p.codigovisual as produtovisual,'
      '       p.descricao as descricaoproduto,'
      ''
      '      (pc.quantidade * pc.precovenda) as TotalProduto,'
      ''
      
        '       Nullif(produtos_licitacoes_orcados(ct.licitacao, pc.contr' +
        'ato, pc.produto),0) as orcados,'
      
        '       Nullif(produtos_licitacoes_reservados(ct.licitacao, pc.co' +
        'ntrato, pc.produto),0) as reservados,'
      
        '       Nullif(produtos_licitacoes_faturados(ct.licitacao, pc.con' +
        'trato, pc.produto),0) as Faturados,'
      
        '       Nullif(produtos_licitacoes_entregues(ct.licitacao, pc.con' +
        'trato, pc.produto),0) as NotaFiscal,'
      
        '       Nullif(produtos_licitacoes_devolvidos(ct.licitacao, pc.co' +
        'ntrato, pc.produto),0) as Devolvidos,'
      ''
      ''
      '       cast(null as numeric(11,3)) as Pendente,'
      ''
      '       c.marca,'
      '       m.descricao as descricaomarca,'
      '       c.unidade,'
      '       u.descricao as descricaounidade,'
      '       p.caracteristica,'
      ''
      '       (select lp.referencialicitacao'
      '        from licitacoesprodutos lp'
      '        where lp.licitacao = ct.licitacao'
      
        '          and lp.produto = pc.produto limit 1) as referencialici' +
        'tacao'
      ''
      'from produtoscontratos pc'
      '     join contratos ct'
      '     on pc.contrato = ct.numero'
      ''
      '     join (produtos p'
      '           join ((caracteristicas c'
      '                 join marcas m'
      '                 on c.marca = m.codigo)'
      '                 join unidades u'
      '                 on c.unidade = u.codigo)'
      '           on p.caracteristica = c.codigo)'
      ''
      '     on pc.produto = p.codigo'
      ''
      ''
      ''
      'where ct.licitacao = :licitacao'
      ''
      'order by pc.contrato, pc.numero')
    RequestLive = True
    Left = 216
    Top = 344
    ParamData = <
      item
        DataType = ftString
        Name = 'licitacao'
        ParamType = ptUnknown
      end>
