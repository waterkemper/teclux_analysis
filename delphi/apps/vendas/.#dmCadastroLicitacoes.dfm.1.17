  object qryContratosNotasDevolucoesdaLicitacao: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select distinct'
      ''
      '       ct.numero as contrato,'
      '       ct.data as datacontrato,'
      '          '
      '          cast (case when ct.situacao = '#39'O'#39' then '#39'OR'#199'ADO'#39
      '                     when ct.situacao = '#39'R'#39' then '#39'RESERVADO'#39
      '                     when ct.situacao = '#39'F'#39' then'
      '                             case when'
      ''
      '                                 coalesce((select true'
      '                                           from dadosfiscais dfd'
      
        '                                           where dfd.contrato = ' +
        'coalesce(ct.primogenito,ct.numero)'
      
        '                                             and dfd.situacao = ' +
        #39'N'#39
      
        '                                             and mod(dfd.codigof' +
        'iscal,1000) = 922 limit 1), false)'
      
        '                             then '#39'SIMPLES FATURAMENTO'#39' else '#39'FA' +
        'TURADO'#39' end'
      '                     when ct.situacao = '#39'P'#39' then '#39'NOTA PARCIAL'#39
      '                     when ct.situacao = '#39'N'#39' then '#39'NOTA FISCAL'#39
      '                     when ct.situacao = '#39'C'#39' then '#39'CANCELADO'#39
      '             end as varchar(20)) as NomeSituacaoContrato,'
      ''
      '       np.fornecedor,'
      '       np.tipofornecedor,'
      '       vf.nome as nomefornecedor,'
      '       np.serie,'
      '       np.numero,'
      '       np.data,'
      '       np.situacao,'
      '       cast(case when np.situacao = '#39'C'#39' then '#39'CANCELADA'#39
      '                 when np.situacao = '#39'N'#39' then '#39'NORMAL'#39
      '                 when np.situacao = '#39'D'#39' then '#39'DENEGADA'#39
      '       end as varchar(9)) as descricaosituacao,'
      '       np.valornota,'
      ''
      '       coalesce(c.filial,n.filial) as filialsaida,'
      
        '       cast(case when c.filial is not null then c.numeroserie el' +
        'se n.serie end as varchar(20)) as seriesaida,'
      '       coalesce(c.numero,n.numero) as numerosaida,'
      '       c.maquina,'
      '       c.intervensao,'
      '       df.data as datasaida,'
      '       pnp.dadofiscal,'
      '       np.chv_nfe'
      ''
      ''
      '/*'
      '      (select textcat_all(distinct pnp.dadofiscal || '#39', '#39')'
      '       from produtosnotaspag pnp'
      '       where pnp.dadofiscal is not NULL'
      '         and pnp.codigonota = np.codigo) as lista_dadosfiscais'
      '*/'
      ''
      'from notaspag np'
      '     join vfornecedores vf'
      '     on np.fornecedor = vf.codigo'
      '     and np.tipofornecedor = vf.tipo'
      ''
      '     join produtosnotaspag pnp'
      '          join (dadosfiscais df'
      '                join contratos ct on df.contrato = ct.numero'
      '                left join notas n on df.numero = n.dadofiscal'
      '                left join cupons c on df.numero = c.dadofiscal)'
      '          on pnp.dadofiscal = df.numero'
      '     on np.codigo = pnp.codigonota'
      ''
      'where ct.licitacao = :licitacao'
      ''
      '/*'
      'where np.codigo in (select distinct pnp.codigonota'
      '                    from produtosnotaspag pnp'
      '                    where pnp.dadofiscal in (select df.numero'
      '                                            from dadosfiscais df'
      
        '                                            where df.contrato = ' +
        ':contrato))'
      '*/'
      ''
      'ORDER by np.data, np.numero'
      '')
    RequestLive = False
    Left = 216
    Top = 192
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'licitacao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'contrato'
        ParamType = ptUnknown
      end>
    object qryContratosNotasDevolucoesdaLicitacaocontrato: TStringField
      FieldName = 'contrato'
    end
