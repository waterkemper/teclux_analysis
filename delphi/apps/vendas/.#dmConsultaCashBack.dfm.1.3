    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftString
        Name = 'json_Prod'
        ParamType = ptUnknown
        Value = 
          #39'[{"codigo_saldo":40,"codigo_saldo_origem":40,"cashback":9,"vali' +
          'dade":"2022-07-07T00:00:00","produto":1951700,"quantidade":1.000' +
          ',"valor":4.72}]'#39
      end
      item
        DataType = ftString
        Name = 'json_saldos'
        ParamType = ptUnknown
        Value = 
          #39'[{"codigo":40,"data_hora":"2021-09-10T17:39:07.098866","cliente' +
          '":52851,"tipo_cliente":"C","status":"V'#193'LIDO","contrato":"923971"' +
          ',"parcela":1,"cancelamento":0,"codigo_apropriacao_devolvida":nul' +
          'l}]'#39
      end>
    Sql.Strings = (
      ';'
      'select cb_sp.*,'
      '       cb.descricao as descricaocashback, '
      '       p.descricao as descricaoproduto,'
      '       cb_s.*,'
      '       vf.nome as nomecliente'
      '       '
      'from'
      '('
      
        '   select codigo_saldo, cashback,  validade, produto, quantidade' +
        ', valor from json_to_recordset('
      ''
      '  %json_prod'
      ''
      
        '  ) as (codigo_saldo integer, cashback integer, validade timesta' +
        'mp, produto bigint, quantidade numeric, valor NUMERIC)'
      ') as cb_sp'
      ''
      'left join cashback cb'
      'on cb.codigo = cb_sp.cashback'
      ''
      'join produtos p'
      'on cb_sp.produto = p.codigo'
      ''
      'join'
      ''
      '('
      ''
      '   select distinct * from json_to_recordset('
      ''
      '  %json_saldos'
      ''
      '  ) as ('
      '  '
      '  '
      '  '
      '  codigo INTEGER,'
      '  data_hora TIMESTAMP,'
      '  cliente INTEGER,'
      '  tipo_cliente CHAR(1),'
      '  status VARCHAR(25),'
      '  contrato VARCHAR(20),'
      '  parcela INTEGER,'
      '  cancelamento INTEGER,'
      '  codigo_apropriacao_devolvida integer  '
      '  '
      '  )'
      ''
      ''
      ''
      ') as cb_s'
      'on cb_sp.codigo_saldo = cb_s.codigo'
      ''
      'join vfornecedores vf'
      'on cb_s.cliente = vf.codigo'
      'and cb_s.tipo_cliente = vf.tipo'
      ''
      'order by cb_s.codigo'
      '  '
      '  '
      ''
      '')
