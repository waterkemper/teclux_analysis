        Name = 'Cliente'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      
        'select row_number() over (order by data_hora, cliente, tipo_clie' +
        'nte, contrato) as Reg,'
      '       sel.*,'
      ''
      '       ValorCB +'
      '       ValorCB_dev +'
      '       ValorCB_apro +'
      '       ValorCB_apro_canc +'
      '       ValorCB_Acertos +'
      '       ValorCB_Vencidos as Total'
      '       '
      'from'
      '('
      'select  min(cb_s.data_hora)  as data_hora, '
      '        cb_s.cliente,'
      '        cb_s.tipo_cliente,'
      '        vf.nome as nomecliente,'
      '        cb_s.contrato,'
      '        /*cb_so.parcela,*/'
      '        ct.filialvenda,'
      '        cb_sp.cashback,        '
      '        cb.descricao as descricaocashback,'
      '        cb_sp.validade,'
      '        '
      '        json_agg(cb_sp.*) as json_prod,'
      '           '
      
        '        sum(case when cb_s.status in ('#39'V'#193'LIDO'#39') then cb_sp.valor' +
        ' else cast(0 as numeric(11,3)) end) as ValorCB,'
      
        '        sum(case when cb_s.status in ('#39'V'#193'LIDOS DEVOLVIDOS'#39', '#39'V'#193'L' +
        'IDOS TROCADOS'#39') then cb_sp.valor else cast(0 as numeric(11,3)) e' +
        'nd) as ValorCB_Dev,'
      
        '        sum(case when cb_s.status in ('#39'APROPRIA'#199#195'O'#39') then cb_sp.' +
        'valor else cast(0 as numeric(11,3)) end) as ValorCB_Apro,'
      
        '        sum(case when cb_s.status in ('#39'APROPRIA'#199#195'O DEVOLVIDA'#39', '#39 +
        'APROPRIA'#199#195'O TROCADA'#39') then cb_sp.valor else cast(0 as numeric(11' +
        ',3)) end) as ValorCB_Apro_Canc,'
      
        '        sum(case when cb_s.status in ('#39'ENTRADA MANUAL'#39','#39'SA'#205'DA MA' +
        'NUAL'#39') then cb_sp.valor else cast(0 as numeric(11,3)) end) as Va' +
        'lorCB_Acertos,'
      
        '        sum(case when cb_s.status in ('#39'V'#193'LIDOS VENCIDOS'#39') then c' +
        'b_sp.valor else cast(0 as numeric(11,3)) end) as ValorCB_Vencido' +
        's'
      ''
      'from cashback_saldos cb_s'
      '     join  cashback_saldos_produtos cb_sp     '
      '           '
      '           join produtos p'
      '           on cb_sp.produto = p.codigo'
      '           '
      '           left join cashback cb'
      '           on cb_sp.cashback = cb.codigo'
      '             '
      '     on cb_s.codigo = cb_sp.codigo_saldo '
      '     '
      '     join vfornecedores vf'
      '     on cb_s.cliente = vf.codigo'
      '     and cb_s.tipo_cliente = vf.tipo'
      '     '
      '     left join contratos ct'
      '     on cb_s.contrato = ct.numero'
      '     '
      
        'where case when cb_s.status in ('#39'V'#193'LIDO'#39', '#39'APROPRIA'#199#195'O'#39') then cb' +
        '_s.cancelamento = 0 else true end'
      
        '  and cb_s.status NOT IN ('#39'V'#193'LIDO CANCELADO'#39', '#39'APROPRIA'#199#195'O CANCE' +
        'LADA'#39')'
      ''
      '%ListaFiliais'
      '%IntervaloDatas'
      '%Cliente'
      ''
      '     '
      
        'group by /*cb_s.data_hora,*/ cb_s.cliente, vf.nome, cb_s.tipo_cl' +
        'iente, cb_sp.validade, cb_sp.cashback, cb.descricao, cb_s.contra' +
        'to, /*cb_s.parcela,*/ ct.filialvenda  /*, cashback, descricao_ca' +
        'shback,  produtovisual, descricaoproduto*/'
      
        'order by /*cb_s.data_hora,*/ cb_s.cliente, vf.nome, cb_s.tipo_cl' +
        'iente, cb_sp.validade,cb_sp.cashback, cb.descricao, cb_s.contrat' +
        'o, /*cb_s.parcela,*/ ct.filialvenda  /*, cashback, descricao_cas' +
        'hback,  produtovisual, descricaoproduto*/'
      ''
      ')  as sel order by data_hora, cliente, tipo_cliente, contrato'
      '')
