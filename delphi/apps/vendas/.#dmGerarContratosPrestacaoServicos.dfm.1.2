  object qryContratosManutencao: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryContratosManutencaoCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'SQLListaClientes'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select cm.*,'
      '       vf.nome as nomecliente,'
      ''
      
        '       cast(cast(to_char(cast(:datafinal as date), '#39'yyyy-mm-'#39') a' +
        's varchar(8))||cast(cm.diavencimento as varchar) as date) as Dat' +
        'aVencimento,'
      '       p.datavencto,'
      
        '       case when ct.situacao = '#39'N'#39' then cast('#39'NOTA FISCAL'#39' as va' +
        'rchar(20))'
      
        '            when ct.situacao = '#39'F'#39' then cast('#39'FATURADO'#39' as varch' +
        'ar(20))'
      
        '       else cast('#39'A FATURAR'#39' as varchar(20)) end as situacaocont' +
        'rato,'
      ''
      '       ct.numero as contrato,'
      
        '       case when ct.situacao is null or ct.situacao = '#39'F'#39' then t' +
        'rue else false end as marcar'
      ''
      'from contratosmanutencao cm'
      '      left join (contratos ct'
      '                join parcelas p'
      '                on ct.numero = p.contrato'
      '                )'
      '      on cm.numero = ct.contratomanutencao'
      ''
      '      join vfornecedores vf'
      '      on cm.cliente = vf.codigo'
      '      and cm.tipocliente = vf.tipo'
      ''
      'where  cm.diavencimento between :diainicial and :diafinal'
      '  and cm.vigencia >= current_date'
      '  and cm.assinatura <= current_date'
      '  and (ct.situacao is null or ct.situacao in ('#39'N'#39','#39'F'#39'))'
      
        '  and (p.datavencto is null or p.datavencto between :DataInicial' +
        ' and :datafinal)'
      ''
      '  %SQLListaClientes'
      ''
      'order by cm.diavencimento, cm.cliente, cm.tipocliente'
      '')
    RequestLive = True
    Left = 64
    Top = 80
    ParamData = <
      item
        DataType = ftDate
        Name = 'dataFinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'diaInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'diafinal'
        ParamType = ptUnknown
      end
      item
