      '       c.numero as NumeroCupom,'
      '       c.maquina,'
      '       c.intervensao,'
      ''
      '       pdf.quantidade as QtdadeNota'
      ''
      'from listascasamento lc'
      '     join produtoslistacasamento plc on lc.codigo = plc.lista'
      '          join produtoscontratos pc'
      '               join contratos ct on pc.contrato = ct.numero'
      '                    join dadosfiscais df'
      
        '                              left join notas n on n.dadofiscal ' +
        '= df.numero'
      
        '                              left join cupons c on c.dadofiscal' +
        ' = df.numero'
      '                    on df.contrato = ct.numero'
      '                    and ct.situacao in ('#39'N'#39','#39'P'#39')'
      ''
      '                    join produtosdadosfiscais pdf'
      '                    on df.numero = pdf.dadofiscal'
      '                    and pc.produto = pdf.produto'
      ''
      ''
      '          on plc.lista = pc.listacasamento'
      '          and plc.produto = pc.produto'
      ''
      '          join produtos p'
      '          on plc.produto = p.codigo'
      ''
      'where lc.data between :datainicial and :datafinal '
      '  and (pc.quantidade - coalesce(pc.cancelado,0)) > 0'
      '%SQL  '
      ''
      'order by lc.data, lc.codigo, p.descricao, p.codigo'
      '')
