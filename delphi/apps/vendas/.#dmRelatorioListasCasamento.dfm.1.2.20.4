        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select lc.codigo as NumeroLista,'
      '       plc.produto,'
      ''
      '       df.situacao as SituacaoDadoFiscal,'
      '       n.numero as NumeroNota,'
      '       n.serie as Serie,'
      '       n.filial as filialnota,'
      ''
      '       pc.contrato,'
