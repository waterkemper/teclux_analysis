      end
      item
        DataType = ftString
        Name = 'Condicao_Listacasamento'
        ParamType = ptUnknown
        Value = 
          'left join listascasamento lc on selecao.listacasamento = lc.codi' +
          'go'
      end
      item
        DataType = ftUnknown
        Name = 'Condicao_Setores'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
