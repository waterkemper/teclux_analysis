      end
      item
        DataType = ftUnknown
        Name = 's_Condicao_marcas'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 's_ListaCondicionalPromocoes'
        ParamType = ptUnknown
      end
