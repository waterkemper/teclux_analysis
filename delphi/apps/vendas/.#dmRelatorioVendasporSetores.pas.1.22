implementation
uses dmtecsoft;

{$R *.dfm}

{ TdtmRelatorioVendasporSetores }

procedure TdtmRelatorioVendasporSetores.ImprimirRelatorio(DataInicial, DataFinal,
              ListadeFiliais, ListadeSetores, ListadeVendedores,
              ListadeGrupos, ListadeClasses, ListadeMarcas, ListadeClientes, ListaCondicionalPromocoes: String;
              ListadeCasamento: integer);
var
  Relatorio: TfrReport;
  frmPreview: TfrmPreviewPadrao;
  FParametroCabecalho: String;
  vOrdenacao: String;

begin
  qryLista.DisableControls;

  FParametroCabecalho := 'Entre ' + DataInicial + ' e ' + DataFinal;

  with qryRelatorioVendasporSetores do
  begin
    if ListadeFiliais<>'' then
    begin
      MacroByName('np_Condicao_filiais').AsString := 'and np.filial in ('+ListadeFiliais+')';
      MacroByName('df_Condicao_filiais').AsString := 'and df.filialvenda in ('+ListadeFiliais+')';
      MacroByName('ct_Condicao_filiais').AsString := 'and ct.filialvenda in ('+ListadeFiliais+')';
    end
    else
    begin
      MacroByName('np_Condicao_filiais').AsString := '';
      MacroByName('df_Condicao_filiais').AsString := '';
      MacroByName('ct_Condicao_filiais').AsString := '';
    end;

    if ListadeSetores<>'' then
      MacroByName('Condicao_Setores').AsString := 'and setorvenda in ('+ListadeSetores+')'
    else
      MacroByName('Condicao_Setores').AsString := '';

    if ListadeVendedores<>'' then
    begin
      MacroByName('pc_Condicao_Vendedores').AsString := 'and coalesce(pc.vendedor, ct.vendedor) in ('+ListadeVendedores+')';
      MacroByName('pdf_Condicao_Vendedores').AsString := 'and coalesce(pdf.vendedor, df.vendedor) in ('+ListadeVendedores+')';
      MacroByName('sc_Condicao_Vendedores').AsString := 'and coalesce(sc.vendedor, ct.vendedor) in ('+ListadeVendedores+')';
      MacroByName('pnp_Condicao_Vendedores').AsString := {'and pnp.vendedor in ('+ListadeVendedores+')';} ' and false ';
    end
    else
    begin
      MacroByName('pc_Condicao_Vendedores').AsString := '';
      MacroByName('pdf_Condicao_Vendedores').AsString := '';
      MacroByName('sc_Condicao_Vendedores').AsString := '';
      MacroByName('pnp_Condicao_Vendedores').AsString := '';
    end;

    if ListadeGrupos<>'' then
    begin
      MacroByName('Condicao_grupos').AsString :=  'and ('+ListadeGrupos+')';
      MacroByName('s_Condicao_grupos').AsString := ' and false ';
    end
    else
    begin
      MacroByName('Condicao_grupos').AsString := '';
      MacroByName('s_Condicao_grupos').AsString := '';
    end;

    if ListadeClasses<>'' then
    begin
      MacroByName('Condicao_classes').AsString := 'and ('+ListadeClasses+')';
      MacroByName('s_Condicao_classes').AsString := 'and false';
    end
    else
    begin
      MacroByName('Condicao_classes').AsString := '';
      MacroByName('s_Condicao_classes').AsString := '';
    end;

    if ListadeMarcas<>'' then
    begin
      MacroByName('Condicao_marcas').AsString := 'and ('+ListadeMarcas+')';
      MacroByName('s_Condicao_marcas').AsString := 'and false';
    end
    else
    begin
      MacroByName('Condicao_marcas').AsString := '';
      MacroByName('s_Condicao_marcas').AsString := '';
    end;

    if ListaCondicionalPromocoes<>'' then
    begin
      MacroByName('ListaCondicionalPromocoes').AsString := 'and ('+ListaCondicionalPromocoes+')';
      MacroByName('s_ListaCondicionalPromocoes').AsString := 'and false';
    end
    else
    begin
      MacroByName('ListaCondicionalPromocoes').AsString := '';
      MacroByName('s_ListaCondicionalPromocoes').AsString := '';
    end;


    if ListadeClientes<>'' then
      MacroByName('Condicao_clientes').AsString := 'and ('+ListadeClientes+')'
    else
      MacroByName('Condicao_clientes').AsString := '';


    case ListadeCasamento of
    0 : begin
          MacroByName('Condicao_Listacasamento').AsString := 'left join listascasamento lc on selecao.listacasamento = lc.codigo';
          MacroByName('Condicao_Listacasamento_semlista').AsString := '';
          ParamByName('comListadeCasamento').asboolean := true;
        end;
    1 : begin
          MacroByName('Condicao_Listacasamento').AsString := 'left join listascasamento lc on selecao.listacasamento = lc.codigo';
          MacroByName('Condicao_Listacasamento_semlista').AsString := 'and listacasamento is null';
          ParamByName('comListadeCasamento').asboolean := false;
        end;
    2 : begin
          MacroByName('Condicao_Listacasamento').AsString := 'join listascasamento lc on selecao.listacasamento = lc.codigo';
          MacroByName('Condicao_Listacasamento_semlista').AsString := '';
          ParamByName('comListadeCasamento').asboolean := true;
        end;
    end;

    qryLista.First;
    while not qrylista.eof do
    begin
      if qrylista.fieldbyname('cabecalho').Asboolean or qrylista.fieldbyname('rodape').Asboolean then
          vOrdenacao := vOrdenacao + qrylista.fieldbyname('campo').AsString + ' ' + qrylista.fieldbyname('tipo').AsString +', ';
      qryLista.next;
    end;

    if vOrdenacao<>'' then
      vOrdenacao := copy(vOrdenacao, 1, length(vordenacao)-2);


    if vordenacao<>'' then
      qryRelatorioVendasporSetores.MacroByName('ordenacao').asstring := 'order by '+vordenacao;

    refazconsultapornome(qryRelatorioVendasporSetores,
                       ['datainicial','datafinal'],
                       [FormatDateTime('YYYY-MM-DD',strtodate(DataInicial)),
                        FormatDateTime('YYYY-MM-DD',strtodate(DataFinal))]);


    with frpRelatorioVendasporSetores_ do
    begin
      Variables['RAZAOFILIALBASE'] := quotedstr(RazaoFilialBase);
      Variables['ENDERECO_BAIRRO'] := quotedstr(RuaFilialBase+ ' - '+BairroFilialBase);
      Variables['CEP_CIDADE_UF'] := quotedstr(FormatarCEP(CEPFilialBase)+'  '+CidadeFilialBase+ '  '+ EstadoFilialBase);
      Variables['titulo']:= quotedstr('VENDAS POR SETORES');
      Variables['Outras']:= quotedstr(FParametroCabecalho);
//      frpRelatorioVendasporSetores_.DesignReport;
      
      showreport;
    end;


{
    frmPreview := TfrmPreviewPadrao.create(self);
    try
     Relatorio := frmPreview.frCompositeReport;
     with frmPreview do
     begin
      frCompositeReport.Reports.Clear;
      frCompositeReport.Reports.Add(frpRelatorioVendasporSetores);
     end;
     Relatorio.Preview := frmPreview.frPreviewPadrao;
     Relatorio.ShowReport;
     frmPreview.ShowModal;

    finally

     frmPreview.Free

    end;
    }
  end;

  qryLista.enableControls;


end;

procedure TdtmRelatorioVendasporSetores.frpRelatorioVendasporSetoresBeforePrint(
  Memo: TStringList; View: TfrView);
begin
  inherited;
  ZebrarLinhaRelatorio(frpRelatorioVendasporSetores, View);
end;

procedure TdtmRelatorioVendasporSetores.qryRelatorioVendasporSetoresCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  qryRelatorioVendasporSetoresTotal.ascurrency := (qryRelatorioVendasporSetoresquantidade.asfloat *
                                                   qryRelatorioVendasporSetoresprecovenda.asfloat) +
                                                   qryRelatorioVendasporSetoresdesconto.asFloat +
                                                   qryRelatorioVendasporSetoresacrescimo.asFloat;

  qryRelatorioVendasporSetoresTotalPauta.asCurrency := (qryRelatorioVendasporSetoresquantidade.asfloat *
                                                   qryRelatorioVendasporSetoresprecotabela.asfloat) {-
                                                   qryRelatorioVendasporSetoresdesconto.asFloat +
                                                   qryRelatorioVendasporSetoresacrescimo.asFloat};

  qryRelatorioVendasporSetoresDiferenca.asCurrency := qryRelatorioVendasporSetoresTotal.ascurrency -
                                                      qryRelatorioVendasporSetoresTotalPauta.asCurrency; 

end;


function TdtmRelatorioVendasporSetores.GetListaSetores: TLista;
Var
  Ind: Integer;
begin
  FillChar(FListaSetores,SizeOf(FListaSetores),0);
  qrySetoresVenda.Open;
  SetLength(FListaSetores, qrySetoresVenda.RecordCount);
  Ind:= 0;
  while not qrySetoresVenda.Eof do begin
    FListaSetores[Ind].codigo   := qrySetoresVendacodigo.AsString;
    FListaSetores[Ind].descricao:= qrySetoresVendanome.AsString;
    Inc(Ind);
    qrySetoresVenda.Next;
  end;
  qrySetoresVenda.Close;
  Result := FListaSetores;
end;

function TdtmRelatorioVendasporSetores.GetListaClasses: TLista;
Var
  Ind: Integer;
begin
  FillChar(FListaClasses,SizeOf(FListaClasses),0);
  qryClasses.Open;
  SetLength(FListaClasses, qryClasses.RecordCount);
  Ind:= 0;
  while not qryClasses.Eof do begin
    FListaClasses[Ind].codigo   := qryClassescodigo.AsString;
    FListaClasses[Ind].descricao:= qryClassesdescricao.AsString;
    Inc(Ind);
    qryClasses.Next;
  end;
  qryClasses.Close;
  Result := FListaClasses;
end;

function TdtmRelatorioVendasporSetores.GetListaGrupos: TLista;
Var
  Ind: Integer;
begin
  FillChar(FListaGrupos,SizeOf(FListaGrupos),0);
  qryGrupos.Open;
  SetLength(FListaGrupos, qryGrupos.RecordCount);
  Ind:= 0;
  while not qryGrupos.Eof do begin
    FListaGrupos[Ind].codigo   := qryGruposcodigo.AsString;
    FListaGrupos[Ind].descricao:= qryGruposdescricao.AsString;
    Inc(Ind);
    qryGrupos.Next;
  end;
  qryGrupos.Close;
  Result := FListaGrupos;
end;


function TdtmRelatorioVendasporSetores.MontarListaGrupos(Grupo: TCheckListBox): String;
var
  STRGrupos: String;
  Ind: Integer;
begin
  STRGrupos := '';
  for Ind:= 0 to (Length(FListaGrupos) - 1) do
    if Grupo.Checked[Ind] then
      STRGrupos := STRGrupos + QuotedStr(FListaGrupos[Ind].codigo) + ',';
  STRGrupos := Copy(STRGrupos, 0, Length(STRGrupos) - 1);
  result := STRGrupos;
end;

function TdtmRelatorioVendasporSetores.MontarListaClasses(Lista: TCheckListBox): String;
var
  STR: String;
  Ind: Integer;
begin
  STR := '';
  for Ind:= 0 to (Length(FListaClasses) - 1) do
    if Lista.Checked[Ind] then
      STR := STR + QuotedStr(FListaClasses[Ind].codigo) + ',';
  STR := Copy(STR, 0, Length(STR) - 1);
  result := STR;
end;

function TdtmRelatorioVendasporSetores.MontarListaSetores(Lista: TCheckListBox): String;
var
  STR: String;
  Ind: Integer;
begin
  STR := '';
  for Ind:= 0 to (Length(FListaSetores) - 1) do
    if Lista.Checked[Ind] then
      STR := STR + QuotedStr(FListaSetores[Ind].codigo) + ',';
  STR := Copy(STR, 0, Length(STR) - 1);
  result := STR;
end;

constructor TdtmRelatorioVendasporSetores.Create(AOwner: TComponent);
begin
  inherited;

end;

procedure TdtmRelatorioVendasporSetores.frpRelatorioVendasporSetoresGetValue(
  const ParName: String; var ParValue: Variant);

  procedure Posicionar(vrecno: integer);
  begin
    qryLista.First;
    while not qrylista.Eof do
    begin
      if qrylista.RecNo = vrecno then
        break
      else
        qrylista.next;
    end;
  end;

  procedure AtribuirparametroAgrupamento;
  begin
    posicionar(strtoint(somentenumero(ParName)));
    if not qrylista.fieldbyname('cabecalho').asboolean and
       not qrylista.fieldbyname('rodape').asboolean then
      ParValue := null
    else
      ParValue := qryRelatorioVendasporSetores.fieldbyname(qrylista.fieldbyname('campo').asstring).AsVariant;
  end;

  procedure AtribuirparametroAgrupamentoaux;
  begin
    posicionar(strtoint(somentenumero(ParName)));
    if not qrylista.fieldbyname('cabecalho').asboolean and
       not qrylista.fieldbyname('rodape').asboolean then
      ParValue := null
    else
    if qrylista.fieldbyname('campo').asstring = 'vendedor' then
      ParValue := qryRelatorioVendasporSetoresnomevendedor.AsVariant
    else
    if qrylista.fieldbyname('campo').asstring = 'listacasamento' then
      ParValue := 'NOIVA: '+qryRelatorioVendasporSetoresnome_noiva.AsVariant + ' NOIVO: '+qryRelatorioVendasporSetoresnome_noivo.AsVariant
    else
    if qrylista.fieldbyname('campo').asstring = 'filialvenda' then
      ParValue := qryRelatorioVendasporSetoresnomefilialvenda.AsVariant
    else
    if qrylista.fieldbyname('campo').asstring = 'setorvenda' then
      ParValue := qryRelatorioVendasporSetoresnomesetorvenda.AsVariant
    else
    if qrylista.fieldbyname('campo').asstring = 'marca' then
      ParValue := qryRelatorioVendasporSetoresdescricaomarca.AsVariant
    else
    if qrylista.fieldbyname('campo').asstring = 'classe' then
      ParValue := qryRelatorioVendasporSetoresdescricaoclasse.AsVariant
    else
    if qrylista.fieldbyname('campo').asstring = 'grupo' then
      ParValue := qryRelatorioVendasporSetoresdescricaogrupo.AsVariant;
  end;

  procedure AtribuirparametroRotulos;
  begin
    posicionar(strtoint(somentenumero(ParName)));
    if not qrylista.fieldbyname('cabecalho').asboolean and
       not qrylista.fieldbyname('rodape').asboolean then
      ParValue := null
    else
    ParValue := qrylista.fieldbyname('campodescricao').asstring;
  end;

  procedure AtribuirparametroCabecalho;
  begin
    posicionar(strtoint(somentenumero(ParName)));
    ParValue := qrylista.fieldbyname('cabecalho').asboolean;
  end;

  procedure AtribuirparametroRodape;
  begin
    posicionar(strtoint(somentenumero(ParName)));
    ParValue := qrylista.fieldbyname('rodape').asboolean;
  end;


begin
  inherited;
  if copy(ParName,1,2)='ag' then
    AtribuirParametroAgrupamento
  else
  if copy(ParName,1,5)='auxag' then
    AtribuirParametroAgrupamentoaux
  else
  if copy(ParName,1,7)='labelag' then
    AtribuirParametroRotulos
  else
  if copy(ParName,1,10)='cabvisible' then
    AtribuirParametroCabecalho
  else
  if copy(ParName,1,10)='rodvisible' then
    AtribuirParametroRodape;
end;

procedure TdtmRelatorioVendasporSetores.frpRelatorioVendasporSetores_GetValue(
  const VarName: String; var Value: Variant);
  
  procedure Posicionar(vrecno: integer);
  begin
    qryLista.First;
    while not qrylista.Eof do
    begin
      if qrylista.RecNo = vrecno then
        break
      else
        qrylista.next;
    end;
  end;

  procedure AtribuirparametroAgrupamento;
  begin
    posicionar(strtoint(somentenumero(VarName)));
    if not qrylista.fieldbyname('cabecalho').asboolean and
       not qrylista.fieldbyname('rodape').asboolean then
      Value := null
    else
      Value := qryRelatorioVendasporSetores.fieldbyname(qrylista.fieldbyname('campo').asstring).AsVariant;
  end;

  procedure AtribuirparametroAgrupamentoaux;
  begin
    posicionar(strtoint(somentenumero(VarName)));
    if not qrylista.fieldbyname('cabecalho').asboolean and
       not qrylista.fieldbyname('rodape').asboolean then
      Value := null
    else
    if qrylista.fieldbyname('campo').asstring = 'vendedor' then
      Value := qryRelatorioVendasporSetoresnomevendedor.AsVariant
    else
    if qrylista.fieldbyname('campo').asstring = 'listacasamento' then
      Value := 'NOIVA: '+qryRelatorioVendasporSetoresnome_noiva.AsVariant + ' NOIVO: '+qryRelatorioVendasporSetoresnome_noivo.AsVariant
    else
    if qrylista.fieldbyname('campo').asstring = 'filialvenda' then
      Value := qryRelatorioVendasporSetoresnomefilialvenda.AsVariant
    else
    if qrylista.fieldbyname('campo').asstring = 'setorvenda' then
      Value := qryRelatorioVendasporSetoresnomesetorvenda.AsVariant
    else
    if qrylista.fieldbyname('campo').asstring = 'marca' then
      Value := qryRelatorioVendasporSetoresdescricaomarca.AsVariant
    else
    if qrylista.fieldbyname('campo').asstring = 'classe' then
      Value := qryRelatorioVendasporSetoresdescricaoclasse.AsVariant
    else
    if qrylista.fieldbyname('campo').asstring = 'grupo' then
      Value := qryRelatorioVendasporSetoresdescricaogrupo.AsVariant;
  end;

  procedure AtribuirparametroRotulos;
  begin
    posicionar(strtoint(somentenumero(VarName)));
    if not qrylista.fieldbyname('cabecalho').asboolean and
       not qrylista.fieldbyname('rodape').asboolean then
      Value := null
    else
    Value := qrylista.fieldbyname('campodescricao').asstring;
  end;

  procedure AtribuirparametroCabecalho;
  begin
    posicionar(strtoint(somentenumero(VarName)));
    Value := qrylista.fieldbyname('cabecalho').asboolean;
  end;

  procedure AtribuirparametroRodape;
  begin
    posicionar(strtoint(somentenumero(VarName)));
    Value := qrylista.fieldbyname('rodape').asboolean;
  end;

begin
  inherited;
  if copy(VarName,1,2)='ag' then
    AtribuirParametroAgrupamento
  else
  if copy(VarName,1,5)='auxag' then
    AtribuirParametroAgrupamentoaux
  else
  if copy(VarName,1,7)='labelag' then
    AtribuirParametroRotulos
  else
  if copy(VarName,1,10)='cabvisible' then
    AtribuirParametroCabecalho
  else
  if copy(VarName,1,10)='rodvisible' then
    AtribuirParametroRodape
  else  
  if VarName = 'MascaraQuantidade' then
    Value := ParSistema.MascaraQuantidadeGrade
  else if VarName = 'CordoZebrado' then
    Value :=  strtoint(parsistema.CorZebradoRelatorio)
  else if VarName = 'RAZAOFILIALBASE' then
    Value := RazaoFilialBase
  else if VarName = 'ENDERECO_BAIRRO' then
    Value :=  RuaFilialBase+ ' - '+BairroFilialBase
  else if VarName = 'CEP_CIDADE_UF' then
    Value :=  FormatarCEP(CEPFilialBase)+'  '+CidadeFilialBase+ '  '+ EstadoFilialBase

end;

end.
