{ TdtmRelatorioVendasporSetores }

procedure TdtmRelatorioVendasporSetores.ImprimirRelatorio(DataInicial, DataFinal,
              ListadeFiliais, ListadeSetores, ListadeVendedores,
              ListadeGrupos, ListadeClasses, ListadeMarcas: String;
              ListadeCasamento: integer);
var
  Relatorio: TfrReport;
  frmPreview: TfrmPreviewPadrao;
  FParametroCabecalho: String;
  vOrdenacao: String;

begin
  qryLista.DisableControls;

  FParametroCabecalho := 'Entre ' + DataInicial + ' e ' + DataFinal;

  with qryRelatorioVendasporSetores do
  begin
    if ListadeFiliais<>'' then
      MacroByName('Condicao_filiais').AsString := 'and ct.filialvenda in ('+ListadeFiliais+')'
    else

    if ListadeSetores<>'' then
      MacroByName('Condicao_Setores').AsString := 'and setorvenda in ('+ListadeSetores+')'
    else
      MacroByName('Condicao_Setores').AsString := '';

    if ListadeVendedores<>'' then
      MacroByName('Condicao_Vendedores').AsString := 'and coalesce(pc.vendedor, ct.vendedor) in ('+ListadeVendedores+')'
    else
      MacroByName('Condicao_Vendedores').AsString := '';

    if ListadeGrupos<>'' then
      MacroByName('Condicao_grupos').AsString :=  'and ('+ListadeGrupos+')'
    else
      MacroByName('Condicao_grupos').AsString := '';

    if ListadeClasses<>'' then
      MacroByName('Condicao_classes').AsString := 'and ('+ListadeClasses+')'
    else
      MacroByName('Condicao_classes').AsString := '';

    if ListadeMarcas<>'' then
      MacroByName('Condicao_marcas').AsString := 'and ('+ListadeMarcas+')'
    else
      MacroByName('Condicao_marcas').AsString := '';

    case ListadeCasamento of
    0 : begin
          MacroByName('Condicao_Listacasamento').AsString := 'left join listascasamento lc on selecao.listacasamento = lc.codigo';
          MacroByName('Condicao_Listacasamento_semlista').AsString := '';
          ParamByName('comListadeCasamento').asboolean := true;
        end;
    1 : begin
          MacroByName('Condicao_Listacasamento').AsString := 'left join listascasamento lc on selecao.listacasamento = lc.codigo';
          MacroByName('Condicao_Listacasamento_semlista').AsString := 'and listacasamento is null';
          ParamByName('comListadeCasamento').asboolean := false;
        end;
    2 : begin
          MacroByName('Condicao_Listacasamento').AsString := 'join listascasamento lc on selecao.listacasamento = lc.codigo';
          MacroByName('Condicao_Listacasamento_semlista').AsString := '';
          ParamByName('comListadeCasamento').asboolean := true;
        end;
    end;

    qryLista.First;
    while not qrylista.eof do
    begin
      if qrylista.fieldbyname('cabecalho').Asboolean or qrylista.fieldbyname('rodape').Asboolean then
          vOrdenacao := vOrdenacao + qrylista.fieldbyname('campo').AsString + ' ' + qrylista.fieldbyname('tipo').AsString +', ';
      qryLista.next;
    end;

    if vOrdenacao<>'' then
      vOrdenacao := copy(vOrdenacao, 1, length(vordenacao)-2);

    qryRelatorioVendasporSetores.MacroByName('ordenacao').asstring := 'order by '+vordenacao;

    refazconsultapornome(qryRelatorioVendasporSetores,
                       ['datainicial','datafinal'],
                       [FormatDateTime('YYYY-MM-DD',strtodate(DataInicial)),
                        FormatDateTime('YYYY-MM-DD',strtodate(DataFinal))]);


    frVariables['RAZAOFILIALBASE']  := RazaoFilialBase;
    frVariables['ENDERECO_BAIRRO']   := RuaFilialBase+ ' - '+BairroFilialBase;
    frVariables['CEP_CIDADE_UF']:= FormatarCEP(CEPFilialBase)+'  '+CidadeFilialBase+ '  '+ EstadoFilialBase;
    frVariables['Outras']:= FParametroCabecalho;
//  frpRelatorioVendasporSetores.DesignReport;
    frmPreview := TfrmPreviewPadrao.create(self);
    try
     Relatorio := frmPreview.frCompositeReport;
     with frmPreview do
     begin
      frCompositeReport.Reports.Clear;
      frCompositeReport.Reports.Add(frpRelatorioVendasporSetores);
     end;
     Relatorio.Preview := frmPreview.frPreviewPadrao;
     Relatorio.ShowReport;
     frmPreview.ShowModal;

    finally

     frmPreview.Free

    end;
  end;

  qryLista.enableControls;


end;

procedure TdtmRelatorioVendasporSetores.frpRelatorioVendasporSetoresBeforePrint(
  Memo: TStringList; View: TfrView);
begin
  inherited;
  ZebrarLinhaRelatorio(frpRelatorioVendasporSetores, View);
end;

procedure TdtmRelatorioVendasporSetores.qryRelatorioVendasporSetoresCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  qryRelatorioVendasporSetoresTotal.ascurrency := qryRelatorioVendasporSetoresquantidade.asfloat * qryRelatorioVendasporSetoresprecovenda.asfloat;
end;


function TdtmRelatorioVendasporSetores.GetListaSetores: TLista;
Var
  Ind: Integer;
begin
  FillChar(FListaSetores,SizeOf(FListaSetores),0);
  qrySetoresVenda.Open;
  SetLength(FListaSetores, qrySetoresVenda.RecordCount);
  Ind:= 0;
  while not qrySetoresVenda.Eof do begin
    FListaSetores[Ind].codigo   := qrySetoresVendacodigo.AsString;
    FListaSetores[Ind].descricao:= qrySetoresVendanome.AsString;
    Inc(Ind);
    qrySetoresVenda.Next;
  end;
  qrySetoresVenda.Close;
  Result := FListaSetores;
end;

