    Sql.Strings = (
      'select formatar_cpf_cnpj(c.pessoanumero) as pessoanumero,'
      '       c.codigo,'
      '       c.nome,'
      '       c.apelido,'
      '       cast(null as integer) as codigoselecionado,'
      '       c.rua,'
      '       c.numero,'
      '       c.complemento,'
      '       (Select ba.nome'
      '        From bairros ba'
      '        Where (ba.estado = c.estado)'
      '          and (ba.cidade = c.cidade)'
      '          and (ba.codigo = c.bairro)) as nomebairrocliente,'
      ''
      '       (Select cd.nome'
      '        From cidades cd'
      '        Where (cd.estado = c.estado)'
      '          and (cd.codigo = c.cidade)) as nomecidadecliente,'
      ''
      '       c.cep,'
      '       c.estado,'
      ''
      '       false as selecionar,'
      '       c.ultimaalteracao,'
      '       c.datacadastro,'
      ''
      '       us.nome as nomeusariosite,'
      '       us.datacadastro as datacadastrousuariosite'
      ''
      'from clientes c'
      '     left join usuarios_site us'
      '     on c.codigo = us.cliente'
      '     and us.tipocliente = '#39'C'#39
      'where c.pessoanumero in (select c2.pessoanumero'
      '                         from clientes c2'
      
        '                         where trim(coalesce(c2.pessoanumero,'#39#39')' +
        ')<>'#39#39
      '                         group by c2.pessoanumero'
      '                         having count(*)>1)'
      'order by c.pessoanumero')
