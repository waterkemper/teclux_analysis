      end
      item
        DataType = ftUnknown
        Name = 'FiltroCurvaABC'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroFilialDadosFiscais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroFilialNotasPag'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroFornecedores'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroGrupoFornecedores'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      ' select vendas.*,'
      
        '       (vendas.quantidade *  vendas.valorultimacompra) as precoc' +
        'ompratotal'
      ' from'
      '( '
      ' '
      '   select vendas.*,'
      '   '
      '   '
      '          coalesce(NULLIF'
      '                     ((SELECT e.valorultimacompra'
      '                      FROM estoques e'
      '                      WHERE e.filial = 1'
      
        '                        AND e.produto = vendas.produto), 0), fp.' +
        'preco) AS valorultimacompra,'
      ''
      '          '
      '          '
      '          fp.fornecedor,'
      '          coalesce(vf.nome,vf.razao) as nomefornecedor'
      '          '
      '          '
      '  from'
      '  ('
      ''
      '   select vendas.*,'
      ''
      
        '          estoques_preconormal(vendas.produto, :FilialBase) as p' +
        'reconormal_venda,'
      ''
      ''
      '          (select sum('
      ''
      '            %quantidadeemestoque'
      ''
      '            )'
      '           from estoques e'
      '           where e.produto = vendas.produto'
      '             %FiltroFiliaisEstoque) as quantidadeemestoque'
      ''
      '   from'
      ''
      '   ('
      
        '     select produto, produtovisual, caracteristica, descricao, v' +
        'alorgrade1, valorgrade2, sum(quantidade) as quantidade'
      '     from'
      '     ('
      '    '
      '     '
      '        ('
      ''
      '         select pc.produto,'
      '                p.codigovisual as produtovisual,'
      '                p.caracteristica,'
      
        '                cast(btrim(p.descricao ||'#39' '#39'||coalesce(p.valorgr' +
        'ade1,'#39#39')||'#39' '#39'||coalesce(p.valorgrade2,'#39#39')) as varchar(162)) as d' +
        'escricao,'
      '                p.valorgrade1,'
      '                p.valorgrade2,'
      '                pc.quantidade'
      ''
      '         from (contratos ct'
      '               join (produtoscontratos pc'
      '                     join ((produtos p'
      '                           join (((caracteristicas c'
      '                                join grupos g'
      '                                on c.grupo = g.codigo)'
      ''
      '                                join classes cl'
      '                                on c.classe = cl.codigo)'
      ''
      '                                join marcas m'
      '                                on c.marca = m.codigo)'
      ''
      '                           on c.codigo = p.caracteristica)'
      ''
      '                           left join promocoes pro'
      '                           on p.promocao = pro.codigo)'
      ''
      '                     on p.codigo = pc.produto)'
      '               on pc.contrato = ct.numero)'
      
        '         where ct.faturamento between (:DataInicial) and (:Dataf' +
        'inal)'
      '               /* AND ct.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39') */'
      
        '               and case when ct.os then ct.tipoequipamento in (1' +
        ',2) and not (coalesce(ct.os_garantia,false) and ct.os_garantia_s' +
        'tatus='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      ''
      '               %FiltroFilial'
      '               %FiltroProdutos'
      '               %FiltroCurvaABC'
      ''
      '                  '
      '        )          '
      '                      '
      '         union all'
      '        '
      '        ('
      '        '
      '         select pdf.produto,'
      '                p.codigovisual as produtovisual,'
      '                p.caracteristica,'
      
        '                cast(btrim(p.descricao ||'#39' '#39'||coalesce(p.valorgr' +
        'ade1,'#39#39')||'#39' '#39'||coalesce(p.valorgrade2,'#39#39')) as varchar(162)) as d' +
        'escricao,'
      '                p.valorgrade1,'
      '                p.valorgrade2,'
      '                pdf.quantidade'
      ''
      '         from (dadosfiscais df'
      '               join (produtosdadosfiscais pdf'
      '                     join ((produtos p'
      '                           join (((caracteristicas c'
      '                                join grupos g'
      '                                on c.grupo = g.codigo)'
      ''
      '                                join classes cl'
      '                                on c.classe = cl.codigo)'
      ''
      '                                join marcas m'
      '                                on c.marca = m.codigo)'
      ''
      '                           on c.codigo = p.caracteristica)'
      ''
      '                           left join promocoes pro'
      '                           on p.promocao = pro.codigo)'
      ''
      '                     on p.codigo = pdf.produto)'
      '               on pdf.dadofiscal = df.numero)'
      '               '
      '         where df.data between (:DataInicial) and (:Datafinal) '
      '           and df.situacao in ('#39'N'#39')  '
      
        '           and (eHNotaFiscalSaidaVenda(df.codigofiscal) or mod(d' +
        'f.codigofiscal,1000) in (929))'
      '                and not coalesce(df.notavinculada,false)'
      '                '
      '           and df.contrato is null     '
      '               '
      ''
      '               %FiltroFilialDadosFiscais'
      '               %FiltroProdutos'
      '               %FiltroCurvaABC'
      ''
      '        '
      '        )'
      '        '
      '        union all'
      '        '
      '        ('
      '        '
      '        '
      '         select cd.produto,'
      '                p.codigovisual as produtovisual,'
      '                p.caracteristica,'
      
        '                cast(btrim(p.descricao ||'#39' '#39'||coalesce(p.valorgr' +
        'ade1,'#39#39')||'#39' '#39'||coalesce(p.valorgrade2,'#39#39')) as varchar(162)) as d' +
        'escricao,'
      '                p.valorgrade1,'
      '                p.valorgrade2,'
      '                cd.quantidade'
      '                '
      '         from ((contratosdevolvidos cd '
      '               join contratos ct  '
      '               on cd.contrato=ct.numero)'
      '                     '
      '               join (produtos p '
      '                     join (caracteristicas c '
      '                           join classes cl '
      '                           on c.classe=cl.codigo)'
      '                     on p.caracteristica=c.codigo)'
      '              on cd.produto=p.codigo)'
      ''
      
        '         where cd.devolucao between(:DataInicial) and (:DataFina' +
        'l)   '
      '           and cd.tipo = '#39'D'#39
      
        '           and case when ct.os then ct.tipoequipamento in (1,2) ' +
        'and not (coalesce(ct.os_garantia,false) and ct.os_garantia_statu' +
        's='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      ''
      '               %FiltroFilial'
      '               %FiltroProdutos'
      '               %FiltroCurvaABC'
      '        '
      '            '
      '        )'
      '        '
      '        union all'
      '        '
      '        ('
      '        '
      '         select pc.produto,'
      '                p.codigovisual as produtovisual,'
      '                p.caracteristica,'
      
        '                cast(btrim(p.descricao ||'#39' '#39'||coalesce(p.valorgr' +
        'ade1,'#39#39')||'#39' '#39'||coalesce(p.valorgrade2,'#39#39')) as varchar(162)) as d' +
        'escricao,'
      '                p.valorgrade1,'
      '                p.valorgrade2,'
      '                pc.quantidade'
      ''
      '        from (select distinct ct.numero, p.datapagto'
      '              from contratos ct, parcelas p'
      '              where ct.numero=p.contrato '
      '                and ct.situacao='#39'C'#39' '
      '                and not exists (select p2.numero'
      '                                from parcelas p2'
      '                                where p2.contrato = ct.numero '
      '                                  and p2.tipopagto<>'#39'E'#39')'
      
        '                and p.datapagto between :datainicial and :datafi' +
        'nal '
      '                and not exists (select cd.contrato'
      '                                from contratosdevolvidos cd'
      '                                where cd.contrato = ct.numero '
      '                                  and cd.tipo='#39'D'#39')'
      '                                '
      
        '                and case when ct.os then ct.tipoequipamento in (' +
        '1,2) and not (coalesce(ct.os_garantia,false) and ct.os_garantia_' +
        'status='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '                '
      '            ) as cancelados, (contratos ct join'
      '                               (produtoscontratos pc'
      '                                join (produtos p'
      '                                      join (caracteristicas c'
      '                                           join classes cl'
      
        '                                             on c.classe = cl.co' +
        'digo)'
      
        '                                      on p.caracteristica = c.co' +
        'digo)'
      '                                on pc.produto=p.codigo)'
      '                               on pc.contrato = ct.numero)'
      ''
      '         where cancelados.numero = ct.numero'
      ''
      '               %FiltroFilial'
      '               %FiltroProdutos'
      '               %FiltroCurvaABC'
      ''
      '        '
      '        '
      '        )'
      '        '
      '        union all'
      '        '
      '        ('
      '          select pnp.produto,'
      '                 p.codigovisual as produtovisual,'
      '                 p.caracteristica,'
      
        '                 cast(btrim(p.descricao ||'#39' '#39'||coalesce(p.valorg' +
        'rade1,'#39#39')||'#39' '#39'||coalesce(p.valorgrade2,'#39#39')) as varchar(162)) as ' +
        'descricao,'
      '                 p.valorgrade1,'
      '                 p.valorgrade2,'
      '                 pnp.quantidade'
      ''
      '         from (notaspag np join'
      '                   (produtosnotaspag pnp'
      '                    join (produtos p'
      '                        join (caracteristicas c'
      '                              join classes cl'
      '                              on c.classe = cl.codigo)'
      '                        on p.caracteristica = c.codigo)'
      '                    on pnp.produto=p.codigo)'
      ''
      '                on pnp.codigonota = np.codigo)'
      ''
      ''
      
        '         Where (np.data between (:DataInicial) and (:DataFinal) ' +
        'and situacao='#39'N'#39')'
      '           and np.contrato is null'
      '           and ehnotafiscalentradadevolucao(np.codigofiscal)'
      '           '
      '               %FiltroFilialNotasPag'
      '               %FiltroProdutos'
      '               %FiltroCurvaABC'
      '             '
      '        '
      '        )'
      '        '
      '    ) as vendas'
      '    '
      
        '    group by produto, produtovisual, caracteristica, descricao, ' +
        'valorgrade1, valorgrade2'
      '    '
      '    '
      '    '
      '   ) as vendas'
      ''
      '   '
      ''
      ''
      '  ) as vendas'
      ''
      '        left join (fornecedoresprodutos fp'
      '                   join vfornecedores vf'
      '                   on fp.fornecedor = vf.codigo'
      '                    and vf.tipo='#39'F'#39')'
      '        on vendas.caracteristica = fp.caracteristica'
      ''
      ''
      '  where true'
      '  %FiltroFornecedores'
      '  %FiltroGrupoFornecedores'
      ''
      
        '  ORDER BY UPPER(pg_catalog.TO_ASCII(cast(COALESCE(vf.nome,vf.ra' +
        'zao) as varchar),'#39'LATIN1'#39')), produtovisual'
      '  '
      ')  as vendas  '
      ''
      '')
    RequestLive = False
    Left = 256
    Top = 152
    ParamData = <
      item
        DataType = ftString
        Name = 'FilialBase'
        ParamType = ptUnknown
      end
