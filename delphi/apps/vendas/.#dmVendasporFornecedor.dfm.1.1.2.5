        ParamType = ptUnknown
      end>
    Sql.Strings = (
      
        '/*  n'#227'o apague ... simplesmente para poder copiar params e macro' +
        's'
      '            :FilialBase'
      '            %quantidadeemestoque'
      '            %FiltroFiliaisEstoque'
      '*/'
      ''
      ''
      ';'
      '  select fp.fornecedor,'
      '          coalesce(vf.nome,vf.razao) as nomefornecedor'
      '  from'
      '  ('
      '          '
      '     select p.caracteristica'
      ''
      '     from (contratos ct'
      '           join (produtoscontratos pc'
      '                 join ((produtos p'
      '                       join (((caracteristicas c'
      '                            join grupos g'
      '                            on c.grupo = g.codigo)'
      ''
      '                            join classes cl'
      '                            on c.classe = cl.codigo)'
      ''
      '                            join marcas m'
      '                            on c.marca = m.codigo)'
      ''
      '                       on c.codigo = p.caracteristica)'
      ''
      '                       left join promocoes pro'
      '                       on p.promocao = pro.codigo)'
      ''
      '                 on p.codigo = pc.produto)'
      '           on pc.contrato = ct.numero)'
      
        '     where ct.faturamento between (:DataInicial) and (:Datafinal' +
        ') and'
      '           ct.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39')'
      
        '           and case when ct.os then ct.tipoequipamento in (1,2) ' +
        'and not (coalesce(ct.os_garantia,false) and ct.os_garantia_statu' +
        's='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      ''
      '           %FiltroFilial'
      '           %FiltroProdutos'
      '           %FiltroCurvaABC'
      ''
      '     group by p.caracteristica'
      ''
      '  ) as vendas'
      ''
      '        left join (fornecedoresprodutos fp'
      '                   join vfornecedores vf'
      '                   on fp.fornecedor = vf.codigo'
      '                   and vf.tipo = '#39'F'#39')'
      '        on vendas.caracteristica = fp.caracteristica'
      ''
      '  where true'
      '  %FiltroFornecedores'
      '  %FiltroGrupoFornecedores'
      ''
      
        '  GROUP BY UPPER(pg_catalog.TO_ASCII(COALESCE(vf.nome,vf.razao) ' +
        ','#39'LATIN1'#39')), vf.nome, vf.razao, fornecedor'
      
        '  ORDER BY UPPER(pg_catalog.TO_ASCII(COALESCE(vf.nome,vf.razao) ' +
        ','#39'LATIN1'#39')), fornecedor')
    RequestLive = False
