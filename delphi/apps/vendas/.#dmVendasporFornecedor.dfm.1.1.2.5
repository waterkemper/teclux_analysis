        DataType = ftUnknown
        Name = 'FiltroFornecedores'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroGrupoFornecedores'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      '   select vendas.*,'
      
        '          (vendas.quantidade *  vendas.valorultimacompra) as pre' +
        'cocompratotal,'
      '          fp.fornecedor,'
      '          coalesce(vf.nome,vf.razao) as nomefornecedor'
      '  from'
      '  ('
      ''
      '   select vendas.*,'
      ''
      
        '          estoques_preconormal(vendas.produto, :FilialBase) as p' +
        'reconormal_venda,'
      ''
      '          (select e.valorultimacompra'
      '           from estoques e'
      '           where e.filial = :FilialBase'
      
        '             and e.produto = vendas.produto) as valorultimacompr' +
        'a,'
      ''
      '          (select sum('
      ''
      '            %quantidadeemestoque'
      ''
      '            )'
      '           from estoques e'
      '           where e.produto = vendas.produto'
      '             %FiltroFiliaisEstoque) as quantidadeemestoque'
      ''
      '   from'
      ''
      '   ('
      ''
      '     select pc.produto,'
      '            p.codigovisual as produtovisual,'
      '            p.caracteristica,'
      
        '            cast(btrim(p.descricao ||'#39' '#39'||coalesce(p.valorgrade1' +
        ','#39#39')||'#39' '#39'||coalesce(p.valorgrade2,'#39#39')) as varchar(162)) as descr' +
        'icao,'
      '            p.valorgrade1,'
      '            p.valorgrade2,'
      '            sum(pc.quantidade) as quantidade'
      ''
      '     from (contratos ct'
      '           join (produtoscontratos pc'
      '                 join ((produtos p'
      '                       join (((caracteristicas c'
      '                            join grupos g'
      '                            on c.grupo = g.codigo)'
      ''
      '                            join classes cl'
      '                            on c.classe = cl.codigo)'
      ''
      '                            join marcas m'
      '                            on c.marca = m.codigo)'
      ''
      '                       on c.codigo = p.caracteristica)'
      ''
      '                       left join promocoes pro'
      '                       on p.promocao = pro.codigo)'
      ''
      '                 on p.codigo = pc.produto)'
      '           on pc.contrato = ct.numero)'
      
        '     where ct.faturamento between (:DataInicial) and (:Datafinal' +
        ') and'
      '           ct.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39')'
      
        '           and case when ct.os then ct.tipoequipamento in (1,2) ' +
        'and not (coalesce(ct.os_garantia,false) and ct.os_garantia_statu' +
        's='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      ''
      '           %FiltroFilial'
      '           %FiltroProdutos'
      '           %FiltroCurvaABC'
      ''
      '     group by pc.produto,'
      '              p.codigovisual,'
      '              p.caracteristica,'
      
        '              cast(btrim(p.descricao ||'#39' '#39'||coalesce(p.valorgrad' +
        'e1,'#39#39')||'#39' '#39'||coalesce(p.valorgrade2,'#39#39')) as varchar(162)),'
      '              p.valorgrade1,'
      '              p.valorgrade2'
      ''
      '   ) as vendas'
      ''
      ''
      '  ) as vendas'
      ''
      '        left join (fornecedoresprodutos fp'
      '                   join vfornecedores vf'
      '                   on fp.fornecedor = vf.codigo'
      '                    and vf.tipo='#39'F'#39')'
      '        on vendas.caracteristica = fp.caracteristica'
      ''
      ''
      '  where true'
      '  %FiltroFornecedores'
      '  %FiltroGrupoFornecedores'
      ''
      
        'ORDER BY UPPER(pg_catalog.TO_ASCII(cast(COALESCE(vf.nome,vf.raza' +
        'o) as varchar),'#39'LATIN1'#39')), produtovisual')
    RequestLive = False
