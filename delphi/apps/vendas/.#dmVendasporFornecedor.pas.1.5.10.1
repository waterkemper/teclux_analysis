function Tdtmvendasporfornecedor.GetPeriodo: String;
begin
  if daysbetween(strtodate(FParametroDataFinal),
                 strtodate(FParametroDataInicial)) > 0 then
    Result := inttostr(daysbetween(strtodate(FParametroDataFinal),
                                   strtodate(FParametroDataInicial)))
  else
    Result := inttostr(1);
end;


procedure Tdtmvendasporfornecedor.Abrevendasporfornecedor;



const

 FiltroFilial      = ' ( ct.filialvenda IN (%s)) ';
 FiltroFilialDadosFiscais = ' df.filial in (%s) ';
 FiltroFilialNotasPag = ' np.filial in (%s) ';

 FiltroFilialEstoque = ' e.filial in (%s) ';

 FiltroGrupoFilial = ' ( ct.filialvenda IN (SELECT filial ' +
                                    'FROM filiaisgruposfiliais fgf '+
                                    'WHERE fgf.grupo IN (%s))) ';

 FiltroGrupoFilialDadosFiscais = ' ( df.filial IN (SELECT filial ' +
                                    'FROM filiaisgruposfiliais fgf '+
                                    'WHERE fgf.grupo IN (%s))) ';

 FiltroGrupoFilialNotasPag = ' ( np.filial IN (SELECT filial ' +
                                    'FROM filiaisgruposfiliais fgf '+
                                    'WHERE fgf.grupo IN (%s))) ';


var
  SQLFilial, SQLFilialEstoque, SQLFilialDadosFiscais, SQLFilialNotasPag,
  SQLProdutos, SQLSituacaoProdutos, SQLCurvaABC : String;

  i: integer;

begin
  SQLFilial := '';
  SQLFilialDadosFiscais := '';
  SQLFilialNotasPag := '';

  SQLProdutos := '';
  SQLSituacaoProdutos := '';

  if (FFilial<>'') then
  begin
    SQLFilial := ' and '+ format(FiltroFilial,[FFilial]);
    SQLFilialDadosFiscais := ' and '+ format(FiltroFilialDadosFiscais,[FFilial]);
    SQLFilialNotasPag := ' and '+ format(FiltroFilialNotasPag,[FFilial]);
  end;

  if (FGrupoFilial<>'') then
  begin
    SQLFilial := SQLFilial + ' and ' + format(FiltroGrupoFilial,[FGrupoFilial]);
    SQLFilialDadosFiscais := SQLFilialDadosFiscais + ' and '+ format(FiltroGrupoFilialDadosFiscais,[FGrupoFilial]);
    SQLFilialNotasPag := SQLFilialNotasPag + ' and ' + format(FiltroGrupoFilialNotasPag,[FGrupoFilial]);
  end;

  if (FFilialEstoque<>'') then
    SQLFilialEstoque := ' and '+ format(FiltroFilialEstoque,[FFilialEstoque]);

  if SQLFilial<>'' then
    qryVendasporFornecedores.Macrobyname('FiltroFilial').asstring := SQLFilial
  else
    qryVendasporFornecedores.Macrobyname('FiltroFilial').asstring := '';

  if SQLFilialDadosFiscais<>'' then
    qryVendasporFornecedores.Macrobyname('FiltroFilialDadosFiscais').asstring := SQLFilialDadosFiscais
  else
    qryVendasporFornecedores.Macrobyname('FiltroFilialDadosFiscais').asstring := '';

  if SQLFilialNotasPag<>'' then
    qryVendasporFornecedores.Macrobyname('FiltroFilialNotasPag').asstring := SQLFilialNotasPag
  else
    qryVendasporFornecedores.Macrobyname('FiltroFilialNotasPag').asstring := '';

  if length(SQLFilialEstoque)<>0 then
    qryVendasporFornecedores.Macrobyname('FiltroFiliaisEstoque').asstring := SQLFilialEstoque
  else
    qryVendasporFornecedores.Macrobyname('FiltroFiliaisEstoque').asstring := '';

  if ListaCondicaoItemProduto<>'' then
  begin
    SQLSituacaoProdutos := SQLSituacaoProdutos + ' and (' + ListaCondicaoItemProduto + ')';
    FParametroCabecalho := FParametroCabecalho + ' Item de Produto: '+ListaCondicaoItemProduto;
  end;

  if ListaCondicaoProduto<>'' then
  begin
    SQLSituacaoProdutos := SQLSituacaoProdutos + ' and (' + ListaCondicaoProduto + ')';
    FParametroCabecalho := FParametroCabecalho + ' Produto: '+ListaCondicaoProduto;
  end;

  if ListaCondicaoGrupoProduto<>'' then
  begin
    SQLSituacaoProdutos := SQLSituacaoProdutos + ' and (' + ListaCondicaoGrupoProduto + ')';
    FParametroCabecalho := FParametroCabecalho + ' Grupo de Produto: '+ListaCondicaoGrupoProduto;
  end;

  if ListaCondicaoClasseProduto<>'' then
  begin
    SQLSituacaoProdutos := SQLSituacaoProdutos + ' and (' + ListaCondicaoClasseProduto + ')';
    FParametroCabecalho := FParametroCabecalho + ' Classe de Produto: '+ListaCondicaoClasseProduto;
  end;

  if ListaCondicaoMarcaProduto<>'' then
  begin
    SQLSituacaoProdutos := SQLSituacaoProdutos + ' and (' + ListaCondicaoMarcaProduto + ')';
    FParametroCabecalho := FParametroCabecalho + ' Classe de Produto: '+ListaCondicaoMarcaProduto;
  end;

  if ListaCondicaoPromocoesProduto<>'' then
  begin
    SQLSituacaoProdutos := SQLSituacaoProdutos + ' and (' + ListaCondicaoPromocoesProduto + ')';
    FParametroCabecalho := FParametroCabecalho + ' Promoções do Produto: '+ListaCondicaoPromocoesProduto;
  end;

  if (ListaFornecedores<>'') then
    qryVendasporFornecedores.Macrobyname('FiltroFornecedores').asstring := ' and ('+ListaFornecedores+')'
  else
    qryVendasporFornecedores.Macrobyname('FiltroFornecedores').asstring := '';

  if ListaGruposFornecedores<>'' then
    qryVendasporFornecedores.Macrobyname('FiltroGrupoFornecedores').asstring := ' and ('+StringReplace(ListaGruposFornecedores,'gf.codigo','vf.grupofornecedor', [rfReplaceAll])+')'
  else
    qryVendasporFornecedores.Macrobyname('FiltroGrupoFornecedores').asstring := '';

  if FProdutoEmLinha and not FprodutoForadeLinha then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and (p.foralinha is null) and (c.foralinha is null)'
  else
  if FprodutoForadeLinha and not Fprodutoemlinha then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and  (p.foralinha is not null or c.foralinha is not null)';

  if FProdutoAtivo and not FprodutoInativo then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and  (p.inativo is null) and (c.inativo is null)'
  else
  if FprodutoInativo and not FprodutoAtivo then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and  (p.inativo is not null or c.inativo is not null)';

  if FProdutoComMontagem and not FProdutoSemMontagem then
    SQLSituacaoProdutos := SQLSituacaoProdutos + ' and (c.montagem)'
  else
  if FProdutoSemMontagem and not FProdutoComMontagem then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and not (c.montagem)';

  if FProdutoBrinde and not FProdutoNaoBrinde then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and (c.brinde)'
  else
  if FProdutoNaoBrinde and not FProdutoBrinde then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and not (c.brinde)';

  if FProdutoComposto and not FProdutoNaoComposto then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and coalesce(c.composto,false)'
  else
  if FProdutoNaoComposto and not FProdutoComposto then
     SQLSituacaoProdutos := SQLSituacaoProdutos + ' and not coalesce(c.composto,false)';

  if (length(SQLSituacaoProdutos)<>0) then
   SQLProdutos := SQLSituacaoProdutos;

  if (length(SQLProdutos)<>0) then
    qryVendasporFornecedores.MacroByName('FiltroProdutos').AsString := SQLProdutos
  else
    qryVendasporFornecedores.MacroByName('FiltroProdutos').AsString := '';

  SQLCurvaABC := '';
  if CurvaABC_A then
     SQLCurvaABC := SQLCurvaABC + ' p.resultadocurvaabc = ''A''';

  if CurvaABC_B then
    if (length(SQLCurvaABC)<>0) then
      SQLCurvaABC := SQLCurvaABC + ' or  p.resultadocurvaabc = ''B'''
    else
      SQLCurvaABC := ' p.resultadocurvaabc = ''B''';

  if CurvaABC_C then
    if (length(SQLCurvaABC)<>0) then
      SQLCurvaABC := SQLCurvaABC + ' or p.resultadocurvaabc = ''C'''
    else
      SQLCurvaABC := ' p.resultadocurvaabc = ''C''';

  if CurvaABC_NaoDefinido then
    if (length(SQLCurvaABC)<>0) then
      SQLCurvaABC := SQLCurvaABC + ' or  coalesce(p.resultadocurvaabc,'''') = '''''
    else
      SQLCurvaABC := ' coalesce(p.resultadocurvaabc,'''') = ''''';

  if (length(SQLCurvaABC)<>0) then
  begin
    SQLCurvaABC := SQLCurvaABC + ')';
    Insert(' and (', SQLCurvaABC, 0)
  end;

  if (length(SQLCurvaABC)<>0) then
    qryVendasporFornecedores.MacroByName('FiltroCurvaABC').AsString := SQLCurvaABC
  else
    qryVendasporFornecedores.MacroByName('FiltroCurvaABC').AsString := '';


  qryVendasporFornecedores.MacroByName('quantidadeemestoque').AsString := FParametroEstoque;

  RefazConsultaPorNome(qryVendasporFornecedores,['FilialBase', 'DataInicial','Datafinal'],
                                       [FilialBase,
                                        FParametroDataInicial,
                                        FParametroDataFinal]);

{  qryFornecedores.Macros := qryVendasporFornecedores.macros;
  qryFornecedores.params := qryVendasporFornecedores.params;

  qryFornecedores.close;
  qryFornecedores.open;}



end;


procedure Tdtmvendasporfornecedor.ImprimirRelatorio;
var
  vRel: TfrxReport;
  PV: TfrxComponent;
  vStreamRel, vStreamRelResumo: TMemoryStream;
begin
  try

//    qryVendasporFornecedores.MasterSource := nil;

    if FileExists(LogotipoFilialBase) then
    begin
      PV := frpVendasporFornecedor.FindObject('fpvLogo');
      if (PV is TfrxPictureView) then
        TfrxPictureView(PV).picture.LoadFromFile(LogotipoFilialBase);
    end;

    with frpVendasporFornecedor do
    begin
      Variables['RAZAOFILIALBASE']  := quotedstr(RazaoFilialBase);
      Variables['ENDERECO_BAIRRO']   := quotedstr(RuaFilialBase+ ' - '+BairroFilialBase);
      Variables['CEP_CIDADE_UF']:= quotedstr(FormatarCEP(CEPFilialBase)+'  '+CidadeFilialBase+ '  '+ EstadoFilialBase);
      Variables['subtitulo']:= quotedstr(FParametroCabecalho);
      Variables['Titulo']:= QUOTEDSTR('PRODUTOS POR FORNECEDOR');

      Variables['EmLinha']:=FprodutoEmLinha;
      Variables['ForadeLinha']:=FprodutoForadeLinha;

      Variables['Ativo']:=FprodutoAtivo;
      Variables['Inativo']:=FprodutoInativo;

      Variables['ComMontagem']:=FProdutoComMontagem;
      Variables['SemMontagem']:=FProdutoSemMontagem;

      Variables['Brinde']:=FProdutoBrinde;
      Variables['NaoBrinde']:=FProdutoNaoBrinde;

      Variables['Composto']:=FProdutoComposto;
      Variables['NaoComposto']:=FProdutoNaoComposto;

//      designreport;
      showreport;


  //  designreport;
  //    showreport;
    end;
  finally
//    qryVendasporFornecedores.MasterSource := dsrFornecedores;
  end;

end;

function Tdtmvendasporfornecedor.GetListaFiliais: TStrings;
begin
  FListaFiliais:= TStringList.Create;
  qryFiliais.Open;
  while not qryFiliais.Eof do
  begin
