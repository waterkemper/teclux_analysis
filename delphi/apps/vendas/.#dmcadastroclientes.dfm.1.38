      '       ro.perto_dnp_oe,'
      '       ro.lente,'
      '       ro.cor,'
      '       ro.tipo,'
      '       ro.adicao,'
      '       ro.medida,'
      '       ro.ajuste,'
      '       ro.entrega,'
      '       ro.medico,'
      '       cast(case when c.situacao = '#39'O'#39' then '#39'O - Or'#231'ado'#39
      '                 when c.situacao = '#39'R'#39' then '#39'R - Reservado'#39
      '                 when c.situacao = '#39'F'#39' then '#39'F - Faturado'#39
      '                 when c.situacao = '#39'P'#39' then '#39'P - Nota Parcial'#39
      '                 when c.situacao = '#39'N'#39' then '#39'N - Nota Fiscal'#39
      '                 when c.situacao = '#39'C'#39' then '#39'C - Cancelado'#39
      '            end as varchar) as situacao'
      'from receitaoculos ro join contratos c on ro.contrato = c.numero'
      'where c.cliente = :cliente')
