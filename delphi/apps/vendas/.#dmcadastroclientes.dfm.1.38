    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select ro.contrato,'
      '       ro.esferico_od,'
      '       ro.cilindro_od,'
      '       ro.eixo_od,'
      '       ro.longe_dnp_od,'
      '       ro.perto_dnp_od,'
      '       ro.esferico_oe,'
