  object qryConjuge: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select  codigo,'
      '         nome,'
      '         nascto,'
      '         civildata,'
      '         civil,'
      '         sexo,'
      '         conjuge,'
      '         rua,'
      '         bairro,'
      '         cidade,'
      '         estado,'
      '         cep,'
      '         emprua,'
      '         empbairro,'
      '         empcidade,'
      '         empcep,'
      '         empestado,'
      '         empfoneddd, '
      '         empfonenumero,'
      '         empfoneramal,'
      '         empresa,'
      '         empadmissao,'
      '         empcargo,'
      '         emprendavalor,'
      '         emprendafaixa,'
      '         filialcadastro,'
      '         (Select d.nome '
      '           From cidades d'
      '           Where d.estado = c.empestado and'
      
        '                     d.codigo = c.empcidade) as nomecidadeempres' +
        'a,'
      '         (Select b.nome From bairros b'
      '                Where b.estado = c.empestado and'
      '                          b.cidade = c.empcidade and'
      '             b.codigo = c.empbairro) as nomebairroempresa,'
      
        '         (Select g.descricao From cargos g Where g.codigo = c.em' +
        'pcargo) as descricacaocargo'
      'from clientes c'
      'where codigo = :codigo'
      '/*     NAO ALTERAR A ORDEM DOS CAMPOS     */')
    RequestLive = True
    Active = True
    Left = 544
    Top = 256
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end>
