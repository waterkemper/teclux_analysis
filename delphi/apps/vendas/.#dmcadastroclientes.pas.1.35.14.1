  inherited;
  AtualizaSerie;
end;

procedure TdtmCadastroClientes.dsrSeriesClientesDataChange(Sender: TObject;
  Field: TField);
begin
  inherited;
  if Field=qrySeriesClientesserie then
   if VerificaSerie then
    begin
     mensagemaviso(ctSERIESJACADASTRADA);
     qrySeriesClientes.Cancel;
    end;
end;

function TdtmCadastroClientes.VerificaSerie: Boolean;
var
i: integer;
begin
  result := false;
  for i := 0 to High(aseries) do
  begin
   if (qrySeriesClientesserie.AsString = aSeries[i].Serie) then
    if (qrySeriesClientes.State = dsEdit) and
       (qrySeriesClientesserie.AsString = SerieAntesEdicao) then
      result := false
    else  result := true ;
  end;
end;

procedure TdtmCadastroClientes.AtualizaSerie;
var
i: integer;
RegistroAtual : TBookMark;
begin
  i := 0;
  aSeries := nil;
  RegistroAtual := qrySeriesClientes.GetBookmark;
  qrySeriesClientes.First;
  while Not qrySeriesClientes.Eof do begin
   SetLength(aseries, i + 1);
   aSeries[i].Serie := qrySeriesClientesserie.AsString;
   Inc(i);
   qrySeriesClientes.next;
  end;
  qrySeriesClientes.GotoBookmark(RegistroAtual);
  qrySeriesClientes.FreeBookmark(RegistroAtual);
end;

