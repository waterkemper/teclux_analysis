function TdtmCadastroClientes.PosicionarRegistro(tipoProcura: TtecProcuraClientesCrediario; Parametro: Integer): Boolean;
begin
  case TipoProcura of
    tpCLIENTES             : Result := ExisteCliente(qryClientescodigo.FieldName, qryClientescodigo.AsString);
    tpCONJUGECLIENTES      : Result := ExisteCliente(qryClientescodigo.FieldName, qryClientesconjuge.AsString);
    tpNATURALCIDADECLIENTES: begin
                               case Parametro of
                                 0: Result := ExisteEstadoCidade(qryConsultaEstadosCidadescodigo.FieldName,qryClientesnaturalestado.AsString);
                                -1: Result := ExisteCidade(qryConsultaCidadescodigo.FieldName, qryClientesnaturalcidade.AsString)
                                 else
                                   Result := False;
                               end;
                             end;
    else                     Result := False;
  end;
end;

procedure TdtmCadastroClientes.Selecionar(TipoProcura: TtecProcuraClientesCrediario);
begin
  case TipoProcura of
    tpCLIENTES             : begin
                               ReFazConsulta(qryClientes,[0],[qryConsultaClientescodigo.AsInteger]);
                             end;
    tpCONCEITOSCLIENTES    : begin
                               qryClientes.Edit;
                               qryClientesconceito.AsInteger := qryConsultaConceitoscodigo.AsInteger;
                             end;
    tpESTADOSCLIENTES      : begin
                               qryClientes.Edit;
                               qryClientesidestado.asString := qryConsultaEstadoscodigo.AsString;
                             end;
    tpNATURALCIDADECLIENTES: begin
                               // as linhas a seguir,
                               // acrescentadas por Daniel,
                               // foram colocadas para corrigir
                               // a seguinte situação:
                               // ao escolher a cidade, estava sempre selecionando
                               // a primeira cidade do estado, tendo o usuário
                               // de digitar o código da cidade na tela de cadastro de clientes,
                               // para setar a cidade corretamente
                               // acrescentado por Daniel
                               qryProcuraCidades.Close;
                               qryProcuraCidades.Params[0].AsString := qryConsultaCidadesestado.AsString;
                               // acrescentado por Daniel
                               qryProcuraCidades.Params[1].AsString := qryConsultaCidadescodigo.AsString;
                               // acrescentador por Daniel
                               qryProcuraCidades.Open;
                               qryClientes.Edit;
                               qryClientesnaturalestado.asString    := qryConsultaCidadesestado.AsString;
                               qryClientesnaturalcidade.asInteger   := qryConsultaCidadescodigo.AsInteger;
                             end;
    tpCARGOSCLIENTES       : begin
                               qryClientes.Edit;
                               qryClientesempcargo.asInteger:= qryConsultaCargoscodigo.AsInteger;
                             end;
    tpCARGOSCONJUGECLIENTES: begin
                               qryClientes.Edit;
                               qryClientesconcargo.asInteger:= qryConsultaCargoscodigo.AsInteger;
                             end;
          tpCONJUGECLIENTES: begin
                               qryClientes.Edit;
                               qryClientesconjuge.AsInteger:= qryConsultaClientescodigo.AsInteger;
                             end;
             tpCONTADEBITO: begin
                              if qryConsultaContaContabiltipo.AsString<>'S' then
                              begin
                                if not (qryClientes.state in [dsinsert, dsedit]) then
                                  qryClientes.Edit;
                                qryClientesdebito.AsInteger := qryConsultaContaContabilcodigo.AsInteger
                              end
                              else
                              begin
                                if not qryClientesdebito.IsNull then
                                begin
                                  if not (qryClientes.state in [dsinsert, dsedit]) then
                                    qryClientes.Edit;
                                  qryClientesdebito.Clear;
                                end;
                              end;
                            end;
      tpCONTACREDITO       : begin
                              if qryConsultaContaContabiltipo.AsString<>'S' then
                              begin
                                if not (qryClientes.state in [dsinsert, dsedit]) then
                                  qryClientes.Edit;
                                qryClientescredito.AsInteger := qryConsultaContaContabilcodigo.AsInteger
                              end
                              else
                              begin
                                if not qryClientescredito.IsNull then
                                begin
                                  if not (qryClientes.state in [dsinsert, dsedit]) then
                                    qryClientes.Edit;
                                  qryClientescredito.Clear;
                                end;
                              end
                            end;
      tpPLANOPADRAO        : begin
                               qryClientes.Edit;
                               qryClientesplanopadrao.AsInteger := qryConsultaPlanocodigo.AsInteger;
                             end;
  end;
end;

