function TdtmCadastroClientes.GravarCliente: Boolean;
var C: integer;
  function ValidarCampoIdDocumento: boolean;
  begin
    if (qryClientespessoatipo.AsString = 'J') then
    begin
      if not PossuiSomenteNumero(qryClientesiddocumento.AsString) and (trim(qryClientesiddocumento.AsString)<>'') then
      begin
        result := false;
        MensagemErro('O campo Inscricão Estadual só pode conter caracteres numéricos');
      end
      else
       result := true;
    end
    else
      result := true;
  end;

begin

  qryClientespessoanumero.Required := ParSistema.CPF_CNPJObrigatorio and not ClienteHedoExterior;
  qryClientesemail.Required := Parsistema.EmailObrigatorio;
  qryClientesiddocumento.Required := qryclientescontribicms.AsBoolean;

  result := qryClientes.CheckRequiredFields;


  if result then
    result := qryObras_Fornecedores.CheckRequiredFields(true);

  if result then
    result := qryfornecedor_infoProcRetPr.CheckRequiredFields(true);

  if result then
    result := qryfornecedor_infoProcRetAd.CheckRequiredFields(true);


  if result then
    result := ValidarCampoIdDocumento;


  if result then
  begin

    Result:= True;

    if ExisteConjuge then
    begin
     if (qryClientespessoatipo.AsString = 'J') then
       ZerarDadosConjuge
     else
      if (qryClientescivil.AsString <> 'C') and (qryClientescivil.AsString <> 'O') then begin
        Result:= MensagemConfirmacao(ctINFORMACOESCONJUGE) = smbOk;
        if Result then
          ZerarDadosConjuge;
      end;
    end;

    if Result then
      if ((qryClientespessoatipo.AsString = 'F') and (qryClientessexo.AsString = 'E'))  or
         ((qryClientespessoatipo.AsString = 'J') and (qryClientessexo.AsString <> 'E')) then begin
        MensagemAviso('O sexo informado não corresponde ao Tipo de Pessoa.');
        Result:= False;
      end;

    if Result then
    begin
      if qryClientesconjuge.AsInteger <> 0 then
      begin
        ReFazConsulta(qryConjugeValido,[0],[qryClientesconjuge.AsInteger]);

        if (not qryConjugeValido.IsEmpty and
           (qryClientescodigo.AsInteger <> qryConjugeValidocodigo.AsInteger)) then begin
           MensagemAviso(Format(ctCONJUGEJACASADO,[qryConjugeValidonome.AsString]));
           Result:= False;
        end;
      end;

      if Result then
        if ((qryClientesconjuge.AsInteger <> 0) and
            (qryClientescodigo.AsInteger  = qryClientesconjuge.AsInteger)) then begin
          MensagemAviso(ctCLIENTEIGUALCONJUGE);
          Result:= False;
        end;

      if Result then
      begin
        Result:= not ClienteJaCadastrado(qryClientespessoanumero.AsString);

        if Result then
          if (qryClientespessoatipo.AsString = 'F') and
          ((qryClientescivil.AsString = 'C')  or
           ((qryClientescivil.AsString = 'O') and
            (qryClientesconnome.Asstring<>'')
            )
           ) and
           (ParSistema.InformarConjugeClienteCasado or
            (qryClientesconjuge.AsInteger<>0)
            ) then
          begin
            AtribuirClientenoConjuge;
            Result := qryConjuge.CheckRequiredFields;
          end;
         // else
         //   qryconjuge.Close;

        if Result then
        begin
          if qryClientes.State = dsInsert then begin
            spcClientesProximoCodigo.Open;
            qryClientescodigo.AsInteger := spcClientesProximoCodigocodigo.AsInteger;
            spcClientesProximoCodigo.Close;
            qryClientesdatacadastro.AsDateTime := now;
{            if (qryClientespessoatipo.AsString = 'F') and ((qryClientescivil.AsString = 'C')  or
                                                           ((qryClientescivil.AsString = 'O') and(qryClientesconjuge.AsInteger<>0))) and
                (ParSistema.InformarConjugeClienteCasado or (qryClientesconjuge.AsInteger<>0)) then
               AtribuirClientenoConjuge;
}
          end;

          if not qrySeriesClientes.IsEmpty then begin
            qrySeriesClientes.First;
            while not qrySeriesClientes.Eof do begin
              qrySeriesClientes.Edit;
              qrySeriesClientescliente.AsInteger:= qryClientesCodigo.AsInteger;
              qrySeriesClientes.Post;
              qrySeriesClientes.Next;
            end;
          end;

          qryContatosClientes.First;
          for C:= 1 to qryContatosClientes.RecordCount do
           begin
            if qryContatosClientescodigovfornecedores.IsNull then
             begin
              qryContatosClientes.Edit;
              qryContatosClientescodigovfornecedores.AsInteger := qryClientescodigo.asInteger;
              qryContatosClientes.Post;
             end;
            qryContatosClientes.next;
           end;

          if not qryDependentesClientes.IsEmpty then
          begin
             qryDependentesClientes.First;
             while not qryDependentesClientes.Eof do
             begin
               qryDependentesClientes.Edit;
               qryDependentesClientescliente.AsInteger:=qryClientesCodigo.AsInteger;
               qryDependentesClientes.Post;
               qryDependentesClientes.Next;
             end;
          end;

          if ParSistema.ANEXOCONTRATORECEITAOCULOS then
          begin

          end;

          if qryClientescivil.AsString <> 'C' then
            qryClientescivildata.Clear;

          if Atualizavel(qryClientes) then
            qryClientesultimaalteracao.AsDateTime := DataServidor;

           if (qryClientesnosimples.IsNull) then
                qryClientesnosimples.AsBoolean:=false;

          AtribuirChave(qryObras_Fornecedores, [qryObras_Fornecedorescliente], [qryClientescodigo]);
          AtribuirChave(qryfornecedor_infoProcRetPr, [qryfornecedor_infoProcRetPrfornecedor], [qryClientescodigo]);
          AtribuirChave(qryfornecedor_infoProcRetAd, [qryfornecedor_infoProcRetAdfornecedor], [qryClientescodigo]);

          qryClientes.Post;

          result := Perpetrar([qryconjuge, qryClientes, qrySeriesClientes,
                     qryDependentesClientes, qryContatosClientes, qryReceitaOculos, qryUsuarios_Site,
                     qryObras_Fornecedores, qryfornecedor_infoProcRetPr, qryfornecedor_infoProcRetAd] );

          if (qryClientesconjugeoriginal.AsInteger <> qryClientesconjuge.AsInteger) and
             (qryClientesconjugeoriginal.AsInteger <> 0) then
          begin
            RefazConsultaPorNome(qryConjuge,['codigo'],[qryClientesconjugeoriginal.AsInteger]);
            qryconjuge.Edit;
            qryConjugeconjuge.clear;
            qryconjuge.Post;
            result := Perpetrar([qryConjuge]);
            RefazConsultaPorNome(qryConjuge,['codigo'],[qryClientesconjuge.AsInteger]);
            qryClientesconjugeoriginal.AsInteger := qryClientesconjuge.AsInteger;
          end;

          if result then
//            AcionarTelaEnquete(qryClientescodigo.asinteger, 'C');
//            TfrmPrincipalBasico(Application.MainForm).MostrarFormRegistrado([qryClientescodigo.asinteger, 'C'], 'TfrmEnquete', True);

        end;
      end;
    end;
  end
  else
    Result:= False;
end;

function TdtmCadastroClientes.GravarDependentesClientes: Boolean;
begin
  Result:=True;
  if qryDependentesClientes.CheckRequiredFields then begin
     if qryDependentesClientes.State = dsInsert then begin
        spcDependentesClientesProximoCodigo.Close;
        spcDependentesClientesProximoCodigo.Open;
        qryDependentesClientescodigo.AsInteger:=spcDependentesClientesProximoCodigocodigo.AsInteger;
      end;
      qryDependentesClientes.Post;
      if not (qryClientes.State in [dsinsert, dsedit]) then
         qryClientes.Edit;
  end;
end;


