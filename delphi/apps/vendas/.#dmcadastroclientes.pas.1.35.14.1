constructor TdtmCadastroClientes.Create(AOwner: TComponent);
begin
  inherited;
  qryClientes.Tag               := ctTabelas;
  qryConsultaClientes.Tag       := ctCrediarioClienteConsulta;
  qryConsultaConceitos.Tag      := ctCrediarioClienteConceito;
  qryConsultaEstados.Tag        := ctCrediarioClienteEstado;
  qryConsultaCargos.Tag         := ctCrediarioClienteCargo;
  qryConsultaCidades.Tag        := ctCrediarioClienteCidade;
  qryConsultaEstadosCidades.Tag := ctCrediarioClienteCidade;
  qryProcuraCidades.Params[0].AsString := EstadoFilialBase;
  qryConsultaContaContabil.Tag  := ctConsultaContaContabil;
  qryConsultaPlano.Tag          := ctTabelasConsultaPlanos;
  qryProcuraDebitar.Params[1].AsInteger := 0;
  qryProcuraCreditar.Params[1].AsInteger := 0;

  qryClientesempcargo.Required := parsistema.PrecosporCargo;


end;

function TdtmCadastroClientes.ClienteJaCadastrado(Numero: String): Boolean;
begin
  Result:= False;
  if (ParSistema.CPF_CNPJObrigatorio and not ClienteHedoExterior or (qryClientespessoanumero.AsString <> '')) then
    if qryClientes.State in [dsEdit, dsInsert] then begin
      qryClienteCadastrado.Sql[02]:= 'Where (pessoanumero = ' + '''' + Numero + '''' + ')';
      if qryClientes.State in [dsInsert] then
        qryClienteCadastrado.Sql[03]:= ''
      else if qryClientes.State in [dsEdit] then
        qryClienteCadastrado.Sql[03]:= 'and (codigo <> ' + qryClientescodigo.AsString + ')';
      qryClienteCadastrado.Open;
      Result:= not qryClienteCadastrado.IsEmpty;
      if Result then begin
        if MensagemConfirmacao(format(ctCLIENTEJACADASTRADO,['cliente',qryClienteCadastradoNome.AsString])) = smbOk then
          ReFazConsulta(qryClientes,[0],[qryClienteCadastradoCodigo.AsInteger])
        else
          qryClientespessoanumero.Clear;
      end;
    end;
end;

procedure TdtmCadastroClientes.abreTabelasConsulta(TipoProcura: TtecProcuraClientesCrediario);
begin
  case TipoProcura of
    tpCLIENTES,
    tpCONJUGECLIENTES      : begin
                               qryConsultaClientes.sql[07] := 'where (c.codigo = 0)';
                               if tipoProcura = tpCONJUGECLIENTES then
                                    qryConsultaClientes.sql[08] := 'and (c.pessoatipo = ''F'') and not (c.sexo in (''E'',' + QuotedStr(qryClientessexo.AsString) + '))'
                               else qryConsultaClientes.sql[08] := '';
                               Abre(ctCrediarioClienteConsulta);
                             end;
    tpCONCEITOSCLIENTES    : Abre(ctCrediarioClienteConceito);
    tpESTADOSCLIENTES      : Abre(ctCrediarioClienteEstado);
    tpNATURALCIDADECLIENTES: Abre(ctCrediarioClienteCidade);
    tpCARGOSCLIENTES,
    tpCARGOSCONJUGECLIENTES: {begin
                              if ParSistema.UsarConsultaInterativa then
                                qryConsultaCargos.sql[2] := ''
                              else qryConsultaCargos.sql[2] := 'where (codigo = 0)';
                              Abre(ctCrediarioClienteCargo);
                             end;                                                   }
                             Abre(ctCrediarioClienteCargo);
    tpCONTADEBITO         : begin
                              if qryClientescredito.AsInteger<>0 then
                                qryConsultaContaContabil.MacroByName('consulta').AsString :=
                                  'and codigo <> '+qryClientescredito.AsString;
                              Abre(ctConsultaContaContabil);
                             end;
    tpCONTACREDITO        : begin
                              if qryClientesdebito.AsInteger<>0 then
                                qryConsultaContaContabil.MacroByName('consulta').AsString :=
                                  'and codigo <> '+qryClientesdebito.AsString;
                              Abre(ctConsultaContaContabil);
                             end;
    tpPLANOPADRAO         : Abre(ctTabelasConsultaPlanos);
  end;
end;

function TdtmCadastroClientes.CalcularFaixa(Valor:Real): Integer;
begin
  try
    Result := Round(Valor / ParSistema.SalarioReferencia);
  except
    Result := 0;
  end;
end;

function TdtmCadastroClientes.ExcluirCliente: Boolean;
begin
  result := false;
  if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o CLIENTE'])) = smbOk then
  begin
    if not qryClientes.IsEmpty then
         qryClientes.Delete
    else qryClientes.Cancel;

    result := Perpetrar([qryClientes, qrySeriesClientes]);

