function TdtmCadastroClientes.ExisteCargo(Campo, Codigo: String): Boolean;
const
  SQL = 'and (upper(to_ascii(%s,''latin1'')) ilike upper(to_ascii(''%s%s'',''latin1'')))';
begin
  qryConsultaCargos.Sql[03]:= Format(SQL, [Campo, Codigo, '%']);
  qryConsultaCargos.Open;
  Result := qryConsultaCargos.RecordCount > 0
end;

function TdtmCadastroClientes.ExisteCidade(Campo, Codigo: String): Boolean;
begin
  Result := ExisteCodigo(qryConsultaCidades, Campo, Codigo);
end;

function TdtmCadastroClientes.ExisteCliente(Campo, Codigo: String): Boolean;
begin
  if Campo = 'nomecidade' then
       Campo:= 'd.nome'
  else Campo:= 'c.' + Campo;
  qryConsultaClientes.sql[07] := 'where upper(to_ascii(' + Campo + ',''latin1'')) ilike upper(to_ascii(''' + ansiuppercase(Codigo) + '%'',''latin1''))';
  Abre(ctCrediarioClienteConsulta);
  Result:= not qryConsultaClientes.IsEmpty;
end;

