procedure TdtmCadastroClientes.dsrClientesDataChange(Sender: TObject; Field: TField);
var
  UsrAut: TtecUsuarios;

begin
  inherited;
  if field = qryClientesPessoaTipo then
  begin
    if field.Value = 'F' then
      qryclientessexo.asString := 'M'
    else
    if field.Value = 'J' then
      qryclientessexo.asString := 'E';

  end
  else
  if field = qryClientesconjuge then
  begin
    ReFazConsulta(qryConjuge, [0], [qryClientesconjuge.AsInteger]);
    AtribuirConjugenoCliente;
  end
  else if field = qryClientesdebito then
    qryProcuraCreditar.Params[1].AsInteger := qryClientesdebito.AsInteger
  else if field = qryClientescredito then
    qryProcuraDebitar.Params[1].AsInteger := qryClientescredito.AsInteger
  else if field = qryClientesnaoligar then
    qryClientesrazaonaoligar.Required := qryClientesnaoligar.AsBoolean
  else
  if field = qryClientesvendedor then
  begin
    if (VendedorAntesdaAlteracao <> qryClientesvendedor.AsString) and not AlterandoClientesvendedor and not (qryClientes.state = dsinsert) then
    begin

      UsrAut := ObterAutorizacao(taLOGIN, 'Gerente de Vendas', 'Alteração do Vendedor no cliente', '');

      if not assigned(UsrAut) or not usrAut.gerentevendas then
      begin
        mensagemaviso('Usuário não possui autorização de ''Gerente de Vendas''');
        AlterandoClientesvendedor := true;

        if VendedorAntesdaAlteracao <> '' then
          qryClientesvendedor.AsString := VendedorAntesdaAlteracao
        else
          qryClientesvendedor.asinteger := 0;


        qryClientes.DataEvent(deLayoutChange, LongInt(Field));

        AlterandoClientesvendedor := false;

      end
      else
      begin
        qryClientesdata_atualizacao_vendedor.AsDateTime := DataHoraServidor;
        qryClientesusuario_atualizacao_vendedor.AsInteger := usrAut.CodigoUsuario;
        qryClientesnomeusuario_atualizacao_vendedor.AsString := usraut.NomeUsuario;
      end;

    end;
  end;


  if qryclientes.State = dsEdit then
  begin
   if (field = qryClientesrua) or
      (field = qryClientesbairro) or
      (field = qryClientescidade) or
      (field = qryClientesestado) or
      (field = qryClientescep) then
    if (qryclientesRua.AsString <> qryClientesrua.OldValue) or
       (qryclientesbairro.AsInteger <> qryClientesbairro.OldValue) or
       (qryclientescidade.AsInteger <> qryClientescidade.OldValue) or
       (qryClientesestado.AsString <> qryClientesestado.OldValue) or
       (qryClientescep.AsInteger <> qryClientescep.OldValue) then
     qryClientesenderecoalterado.AsDateTime := DataHoraLocal
    else if qryClientesenderecoalterado.OldValue <> null then
          qryClientesenderecoalterado.AsDateTime := qryClientesenderecoalterado.OldValue
    else qryClientesenderecoalterado.clear
  end;
end;

