       not qrySeriesClientes.IsEmpty) then
       ReFazConsulta(qrySeriesClientes,     [0],[qryClientesCodigo.AsInteger]);
  if not qryClientescodigo.IsNull then
  begin
    ReFazConsulta(qryConjuge,            [0],[qryClientesconjuge.AsInteger]);
    AtribuirConjugenoCliente;
  end;
  if not qryClientescodigo.IsNull then
       RefazConsulta(qryDependentesClientes,[0],[qryClientesCodigo.AsInteger]);
  if ParSistema.ANEXOCONTRATORECEITAOCULOS then
