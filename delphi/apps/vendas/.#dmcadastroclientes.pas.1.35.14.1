procedure TdtmCadastroClientes.AtribuirConjugenoCliente;
begin
  if qryConjugecodigo.AsInteger <> 0 then
  begin
    qryClientesconnome.AsString         := qryConjugenome.AsString;
    if qryConjugenascto.isnull then
      qryClientesconnascto.Clear
    else
      qryClientesconnascto.AsDateTime     := qryConjugenascto.AsDateTime;

    qryClientesconempresa.AsString      := qryConjugeempresa.AsString;
    if qryConjugeempadmissao.IsNull then
      qryClientesconadmissao.Clear
    else
      qryClientesconadmissao.AsDateTime   := qryConjugeempadmissao.AsDateTime;

    if not qryConjugeempcargo.isnull then
      qryClientesconcargo.AsInteger       := qryConjugeempcargo.AsInteger
    else qryClientesconcargo.clear;

    qryClientesconrendavalor.AsCurrency := qryConjugeemprendavalor.AsCurrency;
    qryClientesconrendafaixa.AsCurrency := qryConjugeemprendafaixa.AsCurrency;
    qryClientesconrua.AsString          := qryConjugeemprua.AsString;
    if not qryConjugeempbairro.IsNull then
      qryClientesconbairro.AsInteger      := qryConjugeempbairro.AsInteger
    else qryClientesconbairro.clear;

    qryClientesconbairronome.AsString   := qryConjugenomebairroempresa.AsString;
    if not qryConjugeempcidade.IsNull then
      qryClientesconcidade.AsInteger      := qryConjugeempcidade.AsInteger
    else qryClientesconcidade.clear;

    if qryConjugeempcep.AsInteger <> 0 then
      qryClientesconcep.AsInteger := qryConjugeempcep.AsInteger
    else qryClientesconcep.Clear;

    if qryConjugeempestado.AsString <> '' then
      qryClientesconEstado.AsString := qryConjugeempestado.AsString
    else qryClientesconEstado.Clear;

    qryClientesconcidadenome.AsString   := qryConjugenomecidadeempresa.AsString;
    qryClientesconfoneddd.AsInteger     := qryConjugeempfoneddd.AsInteger;
    qryClientesconfonenumero.AsInteger  := qryConjugeempfonenumero.AsInteger;
    qryClientesconfoneramal.AsString    := qryConjugeempfoneramal.AsString;
  end
  else
  begin
    if ParSistema.InformarConjugeClienteCasado then
    begin
      qryClientesconnome.clear;
      qryClientesconnascto.clear;
      qryClientesconempresa.clear;
      qryClientesconadmissao.clear;
      qryClientesconcargo.clear;
      qryClientesconrendavalor.clear;
      qryClientesconrendafaixa.clear;
      qryClientesconrua.clear;
      qryClientesconbairro.clear;
      qryClientesconbairronome.clear;
      qryClientesconcidade.clear;
      qryClientesconcidadenome.clear;
      qryClientesconfoneddd.clear;
      qryClientesconfonenumero.clear;
      qryClientesconfoneramal.clear;
    end;
  end;
end;

procedure TdtmCadastroClientes.AtribuirClientenoConjuge;
begin
  if not (qryconjuge.State in [dsedit, dsinsert]) then
    qryConjuge.Edit;

  if qryConjugecodigo.AsInteger = 0 then begin
    qryconjuge.Cancel;
    qryconjuge.insert;
    spcClientesProximoCodigo.Open;
    qryConjugecodigo.AsInteger     := spcClientesProximoCodigocodigo.AsInteger;
    spcClientesProximoCodigo.Close;
    dsrClientes.OnDataChange := nil;
    qryClientesconjuge.AsInteger := qryConjugecodigo.AsInteger;
    dsrClientes.OnDataChange := dsrClientesDataChange;
  end;
  qryConjugerua.AsString         := qryClientesrua.AsString;
  qryConjugeestado.AsString      := qryClientesestado.AsString;
  qryConjugecidade.AsInteger     := qryClientescidade.AsInteger;
  qryConjugebairro.AsInteger     := qryClientesbairro.AsInteger;
  qryConjugecep.AsInteger        := qryClientescep.AsInteger;
  qryConjugecivil.AsString       := qryClientescivil.AsString;

  if Not qryClientescivildata.IsNull then
    qryConjugecivildata.AsDateTime := qryClientescivildata.AsDateTime
  else qryConjugecivildata.clear;

  if qryClientessexo.AsString = 'M' then
    qryConjugesexo.AsString := 'F'
  else
    qryConjugesexo.AsString := 'M';

  qryConjugefilialcadastro.AsInteger := FilialBase;
  if (qryclientes.State <> dsinsert) then
    qryConjugeconjuge.AsInteger          := qryClientescodigo.AsInteger;
  qryConjugenome.AsString              := qryClientesconnome.AsString;
  if not qryClientesconnascto.IsNull then
    qryConjugenascto.AsDateTime          := qryClientesconnascto.AsDateTime
  else qryConjugenascto.clear;

  qryConjugeempresa.AsString            := qryClientesconempresa.AsString;
  if not qryClientesconadmissao.IsNull then
    qryConjugeempadmissao.AsDateTime     := qryClientesconadmissao.AsDateTime
  else qryConjugeempadmissao.clear;

  if not qryClientesconcargo.IsNull then
    qryConjugeempcargo.AsInteger         := qryClientesconcargo.AsInteger
  else qryConjugeempcargo.clear;

  qryConjugeemprendavalor.AsCurrency   := qryClientesconrendavalor.AsCurrency;
  qryConjugeemprendafaixa.AsCurrency   := qryClientesconrendafaixa.AsCurrency;
  qryConjugeemprua.AsString            := qryClientesconrua.AsString;

  if not qryClientesconbairro.IsNull then
    qryConjugeempbairro.AsInteger        := qryClientesconbairro.AsInteger
  else qryConjugeempbairro.clear;

  if not qryClientesconcidade.IsNull then
    qryConjugeempcidade.AsInteger        := qryClientesconcidade.AsInteger
  else qryConjugeempcidade.clear;

  if qryClientesconcep.AsInteger <> 0 then
    qryConjugeempcep.AsInteger := qryClientesconcep.AsInteger
  else qryConjugeempcep.clear;

  if qryClientesconEstado.AsString <> '' then
    qryConjugeempestado.AsString := qryClientesconEstado.AsString
  else qryConjugeempestado.Clear;

  qryConjugeempfoneddd.AsInteger       := qryClientesconfoneddd.AsInteger;
  qryConjugeempfonenumero.AsInteger    := qryClientesconfonenumero.AsInteger;
  qryConjugeempfoneramal.AsString      := qryClientesconfoneramal.AsString;
  qryConjuge.Post;
end;

