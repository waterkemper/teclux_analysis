      qryClientes.Edit;
      qrySeriesClientes.Delete;
    end;
  end;
end;

function TdtmCadastroClientes.ExcluirDependentesClientes: Boolean;
begin
  Result:= False;
  if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR,['o DEPENDENTE DO CLIENTE'])) = smbOk then begin
    if not qryDependentesClientes.IsEmpty then
      qryDependentesClientes.Delete
    else
      qryDependentesClientes.Cancel;
    if qryDependentesClientes.State = dsBrowse then
      qryClientes.Edit;
    Result:=True;
  end;
