      '       cast(null as NUMERIC(7,4)) as pst,'
      ''
      '       cast(null as NUMERIC(15,2)) as vICMSUFDest,'
      '       cast(null as NUMERIC(15,2)) as vICMSUFRemet,'
      ''
      '       (select ncm.nacionalfederal'
