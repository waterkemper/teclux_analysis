    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select f.codigo,'
      '       f.razao,'
      '       f.pessoanumero,'
      '       f.inscricaoestadual,'
      '       f.rua,'
      '       f.numero,'
      '       f.complemento,'
      '       f.bairro,'
      '       f.cidade,'
      '       f.estado,'
      '       f.rntc,'
      
        '       (select b.nome from bairros b where b.estado = f.estado a' +
        'nd b.cidade = f.cidade and b.codigo = f.bairro) as nomebairro,'
      
        '       (select c.nome from cidades c where c.estado = f.estado a' +
        'nd c.codigo = f.cidade ) as nomecidade,'
      
        '       (select c.codigoibge from cidades c where c.estado = f.es' +
        'tado and c.codigo = f.cidade ) as codigoibge'
      'from fornecedores f'
      'where (f.codigo = :codigo) and'
      '          (f.tipofornecimento[1] = '#39'T'#39')')
