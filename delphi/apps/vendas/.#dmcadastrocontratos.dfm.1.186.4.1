  object qryProdutosDadosFiscais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforePost = qryProdutosDadosFiscaisBeforePost
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select *,'
      
        '       (select cast(p.descricao||'#39' '#39'||coalesce(p.valorgrade1,'#39#39')' +
        '||'#39' '#39'||coalesce(p.valorgrade2,'#39#39') as varchar) from produtos p wh' +
        'ere p.codigo = pdf.produto) as produtodescricao,'
      '       pdf.precovenda * pdf.quantidade as precototal,'
      '       cast('#39#39' as varchar) as obslegal,'
      '       false as destacarIPI,'
      
        '       (select p.codigovisual from produtos p where p.codigo = p' +
        'df.produto) as produtovisual,'
      
        '       (select c.peso from caracteristicas c where c.codigo = (s' +
        'elect p.caracteristica from produtos p where p.codigo = pdf.prod' +
        'uto)) as peso,'
      
        '       (select c.volumes from caracteristicas c where c.codigo =' +
        ' (select p.caracteristica from produtos p where p.codigo = pdf.p' +
        'roduto)) as volumes'
      ''
      'from produtosdadosfiscais pdf'
      'where pdf.dadofiscal = :dadofiscal'
      'order by pdf.numero')
    RequestLive = True
    Left = 144
    Top = 384
