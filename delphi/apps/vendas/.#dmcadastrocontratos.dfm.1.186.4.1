    Constraints = <>
    BeforeOpen = qryProcuraClienteBeforeOpen
    AfterOpen = qryProcuraClienteAfterOpen
    AfterClose = qryProcuraClienteAfterClose
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select cast(coalesce(razao,nome) as varchar(60)) as nome,'
      '       codigo,'
      '       tipo,'
      
        '       case when tipo = '#39'C'#39' then (select c.naoexibirfichafinance' +
        'ira from clientes c where c.codigo = :codigo)'
      '            else false'
      '       end as naoexibirfichafinanceira,'
      '       case when conceito is not null then (select c.restricoes'
      #9#9#9#9#9'    from conceitos c'
      #9#9#9#9'            where c.codigo = vfornecedores.conceito)'
      #9'    else true'
      '       end as restricoesconceito,'
      '       debito,'
      '       credito,'
      
        '       (select c.empcargo from clientes c where c.codigo = :codi' +
        'go) as cargocliente, '
      '       markup,'
      '       (select b.nome'
      '       from bairros b'
      '       where b.estado = vfornecedores.estado'
      '         and b.cidade = vfornecedores.cidade'
      '         and b.codigo = vfornecedores.bairro) as NomeBairro,'
      '       (select c.nome'
      '       from cidades c'
      '       where c.estado = vfornecedores.estado'
      '         and c.codigo = vfornecedores.cidade) as NomeCidade,'
      '      (select c.CodigoIBGE'
      '       from cidades c'
      '       where c.estado = vfornecedores.estado'
      '         and c.codigo = vfornecedores.cidade) as CidadeIBGE,'
      '      vfornecedores.nosimples,'
      
        '       case when tipo = '#39'C'#39' then (select c.vendedor from cliente' +
        's c where c.codigo = :codigo)'
      '            else cast(null as integer)'
      '       end as vendedor,'
      ''
      '       (select count(*)'
      '        from orcamentos o2'
      '        where o2.cliente = vfornecedores.codigo'
      '          and o2.tipocliente = vfornecedores.tipo'
      '          and o2.situacao = '#39'A'#39') as qtOrcamentoemAberto,'
      ''
      ''
      '       (select count(*)'
      '        from orcamentos o2'
      '        where o2.cliente = vfornecedores.codigo'
      '          and o2.tipocliente = vfornecedores.tipo'
      '          and o2.situacao = '#39'C'#39') as qtOrcamentoCancelado,'
      ''
      '       (select count(*)'
      '        from orcamentos o2'
      '        where o2.cliente = vfornecedores.codigo'
      '          and o2.tipocliente = vfornecedores.tipo'
      '          and o2.situacao = '#39'T'#39') as qtOrcamentoContrato,'
      ''
      '       (select e.responsaveldifal'
      '        from estados e'
      
        '        where e.codigo = vfornecedores.estado) as responsaveldif' +
        'al,'
      ''
      '       (select e.basedupla'
      '        from estados e'
      '        where e.codigo = vfornecedores.estado) as basedupla'
      ''
      'From   vfornecedores'
      'Where codigo = :codigo'
      '  and tipo   = :tipocliente'
      'Order By UPPER(TO_ASCII(nome,'#39'LATIN1'#39'))')
    RequestLive = False
    Left = 484
    Top = 127
    ParamData = <
      item
        DataType = ftString
        Name = 'codigo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'tipocliente'
        ParamType = ptUnknown
      end>
