      '              (b.cidade = c.cidade) and'
      '              (b.codigo = c.bairro)'
      '       ) as nomebairro,'
      '       (select nome'
      '        from cidades d'
      '        where (d.estado = c.empestado) and'
      '              (d.codigo = c.empcidade)'
      '       ) as nomecidadeempresa,'
