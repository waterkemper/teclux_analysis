        '       (select ipi.classificacaofiscal from ipi where ipi.codigo' +
        ' = c.ipi) as classificacaofiscal,'
      '       cast(null as numeric) as fatorsubstituicao,'
      '       '
      '       0.00 as pCredSN,'
      '       0.00 as vCredICMSSN,'
      '       c.predbcst,'
      '       0.00 as reducaobasest,'
      '       0.00 as vBCSTRet,'
