      end>
    Sql.Strings = (
      'select p.codigo,'
      '       c.ipi,'
      '       ipi.aliquota,'
      '       ipi.classificacaofiscal,'
      ''
      '      (select ncm.nacionalfederal'
      '       from ncmtabela ncm'
      '       where (ncm.codigotipi, coalesce(ncm.extipi,'#39#39')) in'
      
        '                                         (select ipi.classificac' +
        'aofiscal, coalesce(ipi.extipi,'#39#39')'
      '                                          from ipi'
      
        '                                          where ipi.codigo = c.i' +
        'pi)) as nacionalfederal,'
      ''
      '      (select ncm.importadosfederal'
      '       from ncmtabela ncm'
      '       where (ncm.codigotipi, coalesce(ncm.extipi,'#39#39')) in'
      
        '                                                (select ipi.clas' +
        'sificacaofiscal, coalesce(ipi.extipi,'#39#39')'
      '                                                 from ipi'
      
        '                                                 where ipi.codig' +
        'o = c.ipi)) as importadosfederal,'
      '      (select ncm.cargaestadual'
      '       from ncmtabela ncm'
      '       where (ncm.codigotipi, coalesce(ncm.extipi,'#39#39')) in'
      
        '                                                (select ipi.clas' +
        'sificacaofiscal, coalesce(ipi.extipi,'#39#39')'
      '                                                 from ipi'
      
        '                                                 where ipi.codig' +
        'o = c.ipi)) as cargaestadual,'
      ''
      '      (select ncm.chaveibpt'
      '       from ncmtabela ncm'
      '       where (ncm.codigotipi, coalesce(ncm.extipi,'#39#39')) in'
      
        '                                                (select ipi.clas' +
        'sificacaofiscal, coalesce(ipi.extipi,'#39#39')'
      '                                                 from ipi'
      
        '                                                 where ipi.codig' +
        'o = c.ipi)) as chaveibtp'
      ''
      
        'from (produtos p join (caracteristicas c join ipi on c.ipi = ipi' +
        '.codigo)'
      '           on p.caracteristica = c.codigo)'
      ''
      '%ListaProdutos')
