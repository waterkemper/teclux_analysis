      'select pc.contrato,'
      '       pc.produto,'
      '       p.codigovisual as produtovisual,'
      '       pc.produtodigitado,'
      '       pc.filial,'
      '       pc.numero,'
      
        '       (select descricao from produtos where codigo = pc.produto' +
        ') as descricaoproduto,'
      
        '       (select valorgrade1 from produtos where codigo = pc.produ' +
        'to) as valorgrade1,'
      
        '       (select valorgrade2 from produtos where codigo = pc.produ' +
        'to) as valorgrade2,'
      
        '       (select cast(descricao||'#39' '#39'||coalesce(valorgrade1,'#39#39')||'#39' ' +
        #39'||coalesce(valorgrade2,'#39#39') as varchar) from produtos where codi' +
        'go = pc.produto) as descricaolc,'
      '       pc.quantidade,'
      '       pc.precovenda,'
      '       pc.precotabela,'
      '       pc.descricaoprecovenda,'
      '       pc.montagem,'
