      '        where (ncm.codigotipi, coalesce(ncm.extipi,'#39#39')) in'
      
        '                                              (select ipi.classi' +
        'ficacaofiscal, coalesce(ipi.extipi,'#39#39')'
      '                                               from ipi'
      
        '                                               where ipi.codigo ' +
        '= c.ipi)) as chaveibpt,'
      '       c.cest                                        '
      ''
      
        '/*       Estoques_Preco(pc.Componente, :filial) as precotabela,*' +
