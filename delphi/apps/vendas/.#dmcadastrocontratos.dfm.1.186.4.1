    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '(Select pc.produto,'
      '       pc.filial,'
      
        '       cast(sum(pc.quantidade-coalesce(pc.cancelado,0))-sum(coal' +
        'esce(pd.quantidade,0)) as numeric(9,3)) as qtdade'
      'from produtoscontratos pc left join'
      '                              (select d.contrato,'
      '                                      pd1.produto,'
      '                                      pd1.filial,'
      
        '                                      sum(pd1.quantidade) as qua' +
        'ntidade'
      
        '                               from dadosfiscais d, produtosdado' +
        'sfiscais pd1'
      
        '                               where (d.contrato =:contrato) and' +
        ' (d.numero = pd1.dadofiscal) and (d.situacao='#39'N'#39')'
      
        '                                 and not coalesce(d.notavinculad' +
        'a,false)'
      
        '                               group by d.contrato,pd1.produto,p' +
        'd1.filial) pd'
      '                          using (contrato,produto,filial)'
      'where (pc.contrato = :contrato)'
      'group by pc.produto, pc.filial'
      
        'having sum(pc.quantidade-coalesce(pc.cancelado,0)) > sum(coalesc' +
        'e(pd.quantidade,0)))')
    RequestLive = False
