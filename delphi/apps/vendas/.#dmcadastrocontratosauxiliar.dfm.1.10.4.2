  object qryNotasDevolucoesContrato: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterScroll = qryNotasDevolucoesContratoAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select distinct'
      '       np.fornecedor,'
      '       np.tipofornecedor,'
      '       vf.nome as nomefornecedor,'
      '       np.serie,'
      '       np.numero,'
      '       np.data,'
      '       np.situacao,'
      '       cast(case when np.situacao = '#39'C'#39' then '#39'CANCELADA'#39
      '                 when np.situacao = '#39'N'#39' then '#39'NORMAL'#39
      '                 when np.situacao = '#39'D'#39' then '#39'DENEGADA'#39
      '       end as varchar(9)) as descricaosituacao,'
      '       np.valornota,'
      '       coalesce(c.filial,n.filial) as filialsaida,'
      
        '       cast(case when c.filial is not null then c.numeroserie el' +
        'se n.serie end as varchar(20)) as seriesaida,'
      '       coalesce(c.numero,n.numero) as numerosaida,'
      '       c.maquina,'
      '       c.intervensao,'
      '       df.data as datasaida,'
      '       pnp.dadofiscal'
      ''
      ''
      '/*'
      '      (select textcat_all(distinct pnp.dadofiscal || '#39', '#39')'
      '       from produtosnotaspag pnp'
      '       where pnp.dadofiscal is not NULL'
      '         and pnp.codigonota = np.codigo) as lista_dadosfiscais'
      '*/'
      ''
      'from notaspag np'
      '     join vfornecedores vf'
      '     on np.fornecedor = vf.codigo'
      '     and np.tipofornecedor = vf.tipo'
      ''
      '     join produtosnotaspag pnp'
      '          join (dadosfiscais df'
      '                left join notas n on df.numero = n.dadofiscal'
      '                left join cupons c on df.numero = c.dadofiscal)'
      '          on pnp.dadofiscal = df.numero'
      '     on np.codigo = pnp.codigonota'
      ''
      'where df.contrato = :contrato     '
      ''
      '/*'
      'where np.codigo in (select distinct pnp.codigonota'
      '                    from produtosnotaspag pnp'
      '                    where pnp.dadofiscal in (select df.numero'
      '                                            from dadosfiscais df'
      
        '                                            where df.contrato = ' +
        ':contrato))'
      '*/'
      ''
      'ORDER by np.data, np.numero'
      '')
    RequestLive = False
    Left = 80
    Top = 270
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'contrato'
        ParamType = ptUnknown
      end>
