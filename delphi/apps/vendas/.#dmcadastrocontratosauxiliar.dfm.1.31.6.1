      '       np.serie,'
      '       np.numero,'
      '       np.data,'
      '       np.situacao,'
      '       '
      '       cast(case when np.situacao = '#39'C'#39' then '#39'CANCELADA'#39
      '                 when np.situacao = '#39'N'#39' then '#39'NORMAL'#39
      '                 when np.situacao = '#39'D'#39' then '#39'DENEGADA'#39
