    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select distinct c.codigo,'
      '       e.produto,'
      '       c.descricao,'
      '       estoques_preco(e.produto,e.filial,(Select pc.markup'
      '                                          from produtoscargos pc'
      
        '                                          where pc.cargo = c.cod' +
        'igo'
      
        '                                          and pc.produto = e.pro' +
        'duto)) as valorproduto'
      
        'from (estoques e join (produtoscargos pc join  cargos c on pc.ca' +
        'rgo = c.codigo) '
      
        '                                       on e.produto = pc.produto' +
        ')'
      'where e.produto = :produto and'
      '      e.filial = :FilialBase'
      'order by c.descricao, c.codigo      ')
