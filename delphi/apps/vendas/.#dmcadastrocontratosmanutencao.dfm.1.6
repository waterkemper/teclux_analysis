    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      
        'update parcelascontratosmanutencao set datavencto = sel.datavenc' +
        'to,'
      
        '                                       valorvencto = sel.valorve' +
        'ncto,'
      
        '                                       datahoraatualizacao = CUR' +
        'RENT_TIMESTAMP'
      'from'
      '('
      
        '        select contratomanutencao, numeroparcela as numero, data' +
        'vencto, valorvencto'
      '        from vencimentoscontratomanutencao(current_date,'
      
        '                                           cast(:contratomanuten' +
        'cao as varchar(1000)),'
      
        '                                           cast('#39#39' as varchar(10' +
        '00)),'
      '                                           cast(1 as smallint))'
      ''
      ')as sel'
      
        'where parcelascontratosmanutencao.contratomanutencao = sel.contr' +
        'atomanutencao'
      '  and parcelascontratosmanutencao.numero = sel.numero'
      '  and (parcelascontratosmanutencao.datavencto <> sel.datavencto'
      
        '      OR parcelascontratosmanutencao.valorvencto <> sel.valorven' +
        'cto);'
      ''
      ''
      ''
      'insert into parcelascontratosmanutencao'
      
        '  (contratomanutencao, numero, datavencto, valorvencto, datahora' +
        'atualizacao)'
      ''
      '('
      
        '        select contratomanutencao, numeroparcela as numero, data' +
        'vencto, valorvencto, CURRENT_TIMESTAMP'
      '        from vencimentoscontratomanutencao(current_date,'
      
        '                                           cast(:contratomanuten' +
        'cao as varchar(1000)),'
      
        '                                           cast('#39#39' as varchar(10' +
        '00)),'
      '                                           cast(2 as smallint))'
      ');'
      ''
      'delete from parcelascontratosmanutencao'
      'where (contratomanutencao, numero) not in'
      ''
      '('
      '        select contratomanutencao, numeroparcela as numero'
      '        from vencimentoscontratomanutencao(current_date,'
      
        '                                           cast(:contratomanuten' +
        'cao as varchar(1000)),'
      
        '                                           cast('#39#39' as varchar(10' +
        '00)),'
      '                                           cast(3 as smallint))'
      ')'
      'and contratomanutencao = :contratomanutencao;'
      '')
    RequestLive = True
    Left = 784
    Top = 96
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'contratomanutencao'
        ParamType = ptUnknown
