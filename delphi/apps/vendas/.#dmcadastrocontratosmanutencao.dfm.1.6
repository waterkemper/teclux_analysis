    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select cm.*,'
      '       vf.nome,'
      '       vf.pessoanumero,'
      
        '       (select e.descricao from equipamentos e where e.codigo = ' +
        'cm.equipamento) as descricaoequipamento,'
      ''
      '       (select count(*)'
      '        from parcelas p'
      
        '        where p.contrato in (select ct.numero from contratos ct ' +
        'where ct.contratomanutencao = cm.numero)) as QtParcelas,'
      ''
      '       cast (case when cm.situacao = '#39'O'#39' then '#39'OR'#199'ADO'#39
      '                  when cm.situacao = '#39'A'#39' then '#39'ASSINADO'#39
      '                  when cm.situacao = '#39'F'#39' then '#39'FECHADO'#39
      '                  when cm.situacao = '#39'C'#39' then '#39'CANCELADO'#39
      '             end as varchar(20)) as NomeSituacao,'
      ''
      '       (select m.descricao'
      '        from motivos m'
      '        where m.codigo = cm.motivo'
      '       ) as descricaomotivo,'
      ''
      '       case when cm.situacao = '#39'O'#39' then'
      ''
      '       coalesce(('
      '        select true'
      '        from parcelascontratosmanutencao pcm'
      '        where pcm.contratomanutencao = cm.numero'
      
        '          and ( /*pcm.valorvencto <> coalesce((select ct.valorpr' +
        'azo'
      '                                            from contratos ct'
      
        '                                            where ct.contratoman' +
        'utencao = pcm.contratomanutencao'
      
        '                                              and ct.parcelacont' +
        'ratomanutencao = pcm.numero),'
      '                                pcm.valorvencto)  OR'
      ''
      
        '                pcm.valorvencto <> coalesce((select case when p.' +
        'valorpagto is null then p.valorvencto else 0.00 end as valorvenc' +
        'to'
      '                                            from (contratos ct'
      '                                                 join parcelas p'
      
        '                                                 on ct.numero = ' +
        'p.contrato'
      
        '                                                 and p.numero = ' +
        '1)'
      
        '                                            where ct.contratoman' +
        'utencao = pcm.contratomanutencao'
      
        '                                             and ct.parcelacontr' +
        'atomanutencao = pcm.numero),'
      '                                pcm.valorvencto) OR */'
      ''
      '                (select true'
      '                  from contratos ct'
      
        '                 where ct.contratomanutencao = pcm.contratomanut' +
        'encao'
      '                   and ct.parcelacontratomanutencao = pcm.numero'
      '                   and ct.situacao in ('#39'N'#39','#39'P'#39','#39'F'#39') limit 1)'
      ''
      '                                ) limit 1'
      ''
      '       ), False)'
      ''
      '       else false end as NaoPermiteAlterar'
      ''
      ''
      ''
      'from contratosmanutencao cm'
      '     join vfornecedores vf'
      '     on cm.cliente = vf.codigo'
      '     and cm.tipocliente = vf.tipo'
      ''
      ''
      'where cm.numero = :numero')
    RequestLive = True
    Left = 72
    Top = 24
    ParamData = <
      item
        DataType = ftString
        Name = 'numero'
        ParamType = ptUnknown
        Value = '0'
      end>
