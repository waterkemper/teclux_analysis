begin
  result := true;

  qryContratosManutencao.readonly := false;
  qryServicosContratosManutencao.readonly := false;
  
{  try}
    qryContratosManutencao.append;
{  except
    result := false
  end;
}

//  qryContratosManutencaocliente.FocusControl;
end;

function TdtmCadastroContratosManutencao.IncluirEditarServicosContrato(
  Editar: Boolean): Boolean;
begin
  result := true;
  try
    if not editar or qryServicosContratosManutencao.IsEmpty then
    begin
      qryServicosContratosManutencao.append;
      qryServicosContratosManutencaoservico.FocusControl;
    end
    else
      qryServicosContratosManutencao.edit;
  except
    result := false
  end;
end;

