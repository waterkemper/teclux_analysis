  inherited;
  RefazConsultaPorNome(qryPossuiAlteracao,
      ['contratomanutencao'], [qryContratosManutencaonumero.asinteger]);

  if (qryPossuiAlteracaoquantidade.asinteger <> 0 ) and (qryContratosManutencaosituacao.asstring<>'C') and  (qryContratosManutencaosituacao.asstring<>'F') then
  begin
    qryAtualizarParcelasContratosManutencao.paramByName('contratomanutencao').asinteger :=
      qryContratosManutencaonumero.asinteger;
    qryAtualizarParcelasContratosManutencao.ExecSql;

    if not qryContratosManutencao.readonly then
      qryContratosManutencao.edit;
  end;


end;

