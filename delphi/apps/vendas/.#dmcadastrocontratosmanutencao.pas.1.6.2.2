procedure TdtmCadastroContratosManutencao.CalcularValorTotalContrato;
begin

  qryServicosContratosManutencao.GuardarRegistroAtual(false);
  cdsServicosContratosManutencao.close;
  cdsServicosContratosManutencao.open;
  qryServicosContratosManutencao.VoltarRegistro;

  if cdsServicosContratosManutencaoSomaTotal.asvariant <> qryContratosManutencaovalor.asvariant then
  begin
    qryContratosManutencao.edit;
    qryContratosManutencaovalor.asvariant := cdsServicosContratosManutencaoSomaTotal.asvariant;
  end;

//  qryContratosManutencaovalor.AsCurrency := TotalizarValores[qryServicosContratosManutencao, qryServicosContratosManutencaovalor, qryServicosContratosManutencaoquantidade];
end;

procedure TdtmCadastroContratosManutencao.dsrContratosManutencaoDataChange(
  Sender: TObject; Field: TField);
begin
  inherited;
  if field = qryContratosManutencaodiavencimento then
  begin
    if field.AsInteger > 28 then
      field.asinteger := 0;
  end
  else
  if field = qryContratosManutencaoformadoaluguel then
  begin
    if field.asString = 'M' then
      qryContratosManutencaodiaslocados.asinteger := 30;
  end;
end;

function TdtmCadastroContratosManutencao.GravarContrato(FecharTransacao: Boolean = true): boolean;
var
  vEtadoTabelaContratosManutencao: TDataSetState;

begin
  if (qryServicosContratosManutencao.state in [dsedit, dsinsert]) then
    qryServicosContratosManutencao.post;

  result := qryServicosContratosManutencao.recordcount <> 0;

  if not result then
    MensagemAviso('Nenhum serviço cadastrado')
  else
  begin

    qryContratosManutencaodiavencimento.required := (qryContratosManutencaoformacontrato.AsInteger = 0);
    
    qryContratosManutencaovigencia.required := (qryContratosManutencaoformacontrato.AsInteger = 0) and
                                               (qryContratosManutencaosituacao.asString = 'A');

    qryContratosManutencaodataentrega.required := (qryContratosManutencaoformacontrato.AsInteger = 1);
    qryContratosManutencaodiaslocados.required := (qryContratosManutencaoformacontrato.AsInteger = 1);
    qryContratosManutencaoformadoaluguel.required       := (qryContratosManutencaoformacontrato.AsInteger = 1);
    qryContratosManutencaovalortaxaentrega.required     := (qryContratosManutencaoformacontrato.AsInteger = 1);
    qryContratosManutencaovalorcaucao.required          := (qryContratosManutencaoformacontrato.AsInteger = 1);
    qryContratosManutencaonometitularidadecaucao.required := (qryContratosManutencaoformacontrato.AsInteger = 1);



    qryServicosContratosManutencao.first;
    while not qryServicosContratosManutencao.eof do
    begin
      result := qryServicosContratosManutencao.CheckRequiredFields;
      if result then
        qryServicosContratosManutencao.next
      else
        break;
    end;

    if result then
    begin
      result := qryContratosManutencao.CheckRequiredFields;

      if result then
      begin
        if qryContratosManutencao.State = dsinsert then
        begin
          spcContratosManutencao_ProximoNumero.Close;
          spcContratosManutencao_ProximoNumero.Open;
          qryContratosManutencaonumero.AsInteger := spcContratosManutencao_ProximoNumeronumero.AsInteger;
        end;

        vEtadoTabelaContratosManutencao := qryContratosManutencao.state;

        if (qryContratosManutencao.state in [dsedit, dsinsert]) then
          qryContratosManutencao.Post;

        try
          Desligar_Ligar_EventosServicosContratosManutencao(false);
          AtribuirChave(qryServicosContratosManutencao, [qryServicosContratosManutencaocontrato], [qryContratosManutencaonumero]);
        finally
          Desligar_Ligar_EventosServicosContratosManutencao(true);
        end;

        if FecharTransacao then
          result := perpetrar([qryContratosManutencao, qryServicosContratosManutencao])
        else
          result := perpetrar([qryContratosManutencao, qryServicosContratosManutencao], AguardareTerminarDentroDm);


        if result then
        begin
//          qryGerarContratoporContratodeManutencao.parambyname('contratomanutencao').asinteger := qryContratosManutencaonumero.asinteger;
//          qryGerarContratoporContratodeManutencao.ExecSql;

          if FecharTransacao then
            perpetrar([])
          else
          begin
            AbrirVencimentos;
            perpetrar([], AguardareTerminarDentroDm);
            if vEtadoTabelaContratosManutencao in [dsedit, dsinsert] then
              qryContratosManutencao.edit;
          end;


        end;

      end;
    end;
  end;

end;

