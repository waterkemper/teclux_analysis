  DataSet: TDataSet);
begin
  inherited;
  qryServicosContratosManutencao.close;
  qryParcelasContratosManutencao.close;
end;

procedure TdtmCadastroContratosManutencao.qryContratosManutencaoBeforeEdit(
  DataSet: TDataSet);
begin
  inherited;
;
end;

function TdtmCadastroContratosManutencao.GetSituacaoContrato: TtecSituacaoContratoManutencao;
begin
  if qryContratosManutencaosituacao.AsString = 'A' then
    Result := scmASSINADO
  else if qryContratosManutencaosituacao.AsString = 'C' then
    Result := scmCANCELADO
  else if qryContratosManutencaosituacao.AsString = 'O' then
    Result := scmORCADO
  else if qryContratosManutencaosituacao.AsString = 'F' then
    Result := scmFECHADO
  else
    Result := scmNENHUM

end;

procedure TdtmCadastroContratosManutencao.SetSituacaoContrato(
  const Value: TtecSituacaoContratoManutencao);
begin

  if SituacaoContrato <> Value then
  begin
    if qryContratosManutencao.State = dsBrowse then
      qryContratosManutencao.Edit;

    case Value of
      scmASSINADO : qryContratosManutencaosituacao.AsString := 'A';
      scmCANCELADO: qryContratosManutencaosituacao.AsString := 'C';
      scmORCADO   : qryContratosManutencaosituacao.AsString := 'O';
      scmFECHADO  : qryContratosManutencaosituacao.AsString := 'F';
    end;
    qryContratosManutencaonomesituacao.AsString := vstrSituacaoContratoManutencao[SituacaoContrato];

  end

end;

function TdtmCadastroContratosManutencao.AssinarContrato: boolean;
var
 vRetorno : TModalResult;
begin

  result := MensagemConfirmacao('Confirma a assinatura do contrato de manutenção?') = smbOK;
  if result then
  begin

    if qryContratosManutencaovigencia.isnull and
       (qryContratosManutencaoformacontrato.AsInteger = 0)
    then
    begin
      qryContratosManutencaovigencia.Required := true;
      vRetorno := MensagemSimNaoOpcaoCancelar('A data de vigência é a mesma da assinatura?','',true);
      case vRetorno of
        mrYES : result := true;
        mrNO  : begin
                  qryContratosManutencao.CheckRequiredFields(false, false, false);
                  result := false;
                end;
        mrCancel : result := false;
      end;

    end
    else
    if (qryContratosManutencaovigencia.asDateTime < dataservidor) and
       (qryContratosManutencaoformacontrato.AsInteger = 0) then
    begin

      qryContratosManutencaovigencia.Required := true;
      vRetorno := MensagemSimNaoOpcaoCancelar('A data de vigência ficará inferior a assinatura. A data de vigência é a mesma da assinatura?','',true);
      case vRetorno of
        mrYES : result := true;
        mrNO  : begin
                  result := false;
                  qryContratosManutencaovigencia.FocusControl;
                end;
        mrCancel : result := False;
      end;

    end;


    if result then
    begin
      qryContratosManutencao.readonly := false;
      qryContratosManutencao.edit;
      qryContratosManutencaoassinatura.AsDateTime := DataServidor;

      if (qryContratosManutencaovigencia.isnull or
         (qryContratosManutencaovigencia.asDateTime < dataservidor)) and

         (qryContratosManutencaoformacontrato.AsInteger = 0) then
        qryContratosManutencaovigencia.AsDateTime := DataServidor;

      SituacaoContrato := scmASSINADO;
      qryContratosManutencao.post;


      AbrirVencimentos;
      GravarContrato(true);

      qryGerarContratoporContratodeManutencao.parambyname('contratomanutencao').asinteger := qryContratosManutencaonumero.asinteger;
      qryGerarContratoporContratodeManutencao.ExecSql;
      GravarContrato(true);
      AbrirVencimentos;

      VerificarSomenteLeitura;
    end;

  end;
end;

procedure TdtmCadastroContratosManutencao.VerificarSomenteLeitura;
begin
  case SituacaoContrato of
    scmASSINADO : begin
                    qryContratosManutencao.ReadOnly := True;
                    qryServicosContratosManutencao.readonly := true;
                  end;
    scmCANCELADO: begin
                    qryContratosManutencao.readonly := True;
                    qryServicosContratosManutencao.readonly := true;
                  end;
    scmORCADO   : begin
                    qryContratosManutencao.readonly := False or qryContratosManutencaoNaoPermiteAlterar.asBoolean;
                    qryServicosContratosManutencao.readonly := False or qryContratosManutencaoNaoPermiteAlterar.asBoolean;
                  end;
    scmFECHADO  : begin
                    qryContratosManutencao.readonly := True;
                    qryServicosContratosManutencao.readonly := true;
                  end;

  end;
end;

function TdtmCadastroContratosManutencao.OrcarContrato: boolean;
begin
  qryContratosManutencao.readonly := false;
  qryContratosManutencao.edit;
  SituacaoContrato := scmORCADO;
  qryContratosManutencao.post;
  GravarContrato(true);
  VerificarSomenteLeitura;
end;

function TdtmCadastroContratosManutencao.FecharContrato: Boolean;
begin
  result := MensagemConfirmacao('Confirma o fechamento do contrato de manutenção?') = smbOK;
  if result then
  begin
    qryContratosManutencao.readonly := false;

    AbrirVencimentos;
    GravarContrato(true);

    qryGerarContratoporContratodeManutencao.parambyname('contratomanutencao').asinteger := qryContratosManutencaonumero.asinteger;
    qryGerarContratoporContratodeManutencao.ExecSql;
    GravarContrato(true);

    qryContratosManutencao.edit;
    qryContratosManutencaoconclusao.AsDateTime := DataServidor;
    SituacaoContrato := scmFECHADO;
    qryContratosManutencao.post;
    GravarContrato(true);

    VerificarSomenteLeitura;


  end;

end;

function TdtmCadastroContratosManutencao.CancelarContrato: Boolean;
var
 vTextoCancelamento : String;
begin
  qryContratosManutencao.readonly := false;

  vTextoCancelamento := '';
  qryConsultaMotivos.close;
  qryConsultaMotivos.open;
  frmMotivos := TfrmMotivos.Create(frmMotivos, 'Cancelamentos de Contratos de Manutenção/Locação', qryConsultaMotivos, true, parsistema.ObrigarDigitacaoaoExcluir);
  Result:= frmMotivos.ShowModal = mrOK;
  if result then
  begin
    vTextoCancelamento := frmMotivos.mmoTexto.text;

    qryContratosManutencao.edit;
    SituacaoContrato := scmCANCELADO;
    qryContratosManutencaomotivo.asinteger := qryConsultaMotivoscodigo.asinteger;
    qryContratosManutencaodescricaocancelamento.asString := vTextoCancelamento;
    qryContratosManutencaoCan_data.asDateTime := DataServidor;
    qryContratosManutencao.post;
    VerificarSomenteLeitura;

    qryAtualizarSituacaoContratoCancelado.parambyname('motivo').asinteger := qryContratosManutencaomotivo.asinteger;
    qryAtualizarSituacaoContratoCancelado.parambyname('contratomanutencao').asinteger := qryContratosManutencaonumero.asinteger;
    qryAtualizarSituacaoContratoCancelado.ExecSQL;

    GravarContrato(true);
  end;  

end;

procedure TdtmCadastroContratosManutencao.RefazConsultaContrato(
  Numero: String);
begin
  qryContratosManutencao.params[0].value := null;
  ReFazConsulta(qryContratosManutencao,[0],[Numero]);
end;

procedure TdtmCadastroContratosManutencao.frxReportContratosManutencaoGetValue(
  const VarName: String; var Value: Variant);
begin
  inherited;
  if VarName = 'titulo' then
    Value := 'CONTRATO DE LOCAÇÃO DE EQUIPAMENTOS'
  else  
  if VarName = 'CordoZebrado' then
    Value :=  strtoint(parsistema.CorZebradoRelatorio)
  else if VarName = 'RAZAOFILIALBASE' then
    Value := RazaoFilialBase
  else if VarName = 'ENDERECO_BAIRRO' then
    Value :=  RuaFilialBase+ ' - '+BairroFilialBase
  else if VarName = 'CEP_CIDADE_UF' then
    Value :=  FormatarCEP(CEPFilialBase)+'  '+CidadeFilialBase+ '  '+ EstadoFilialBase
  else if VarName = 'FONE' then
    Value := DDDFilialBase+FoneFilialBase





end;

