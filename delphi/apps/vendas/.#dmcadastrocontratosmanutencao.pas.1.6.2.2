procedure TdtmCadastroContratosManutencao.ImprimirContrato;
var
  arquivofast :string;
begin
//  frxReportContratosManutencao.DesignReport;


  arquivofast := ExtractFilePath(Application.ExeName) + 'frxReportContratosManutencao.fr3';
  if not FileExists(arquivofast) then
  begin
    mensagemErro('Arquivo '+arquivofast+ ' não encontrado!');
    exit;
  end
  else
    frxReportContratosManutencao.LoadFromFile(arquivofast);

  RefazConsultaPorNome(qryVFornecedores,['cliente','tipocliente'],
  [qryContratosManutencaocliente.asInteger, qryContratosManutencaotipocliente.asString]);

//  frxReportContratosManutencao.designreport;

  frxReportContratosManutencao.ShowReport(true);
end;

function TdtmCadastroContratosManutencao.getListaServicosIncluidos: String;
begin
  fListaServicosIncluidos := '';
  if (qryContratosManutencao.state in [dsedit, dsinsert]) or
      (qryContratosManutencao.recordcount<>0) then
  begin

//    cdsServicosContratosManutencao.Active := false;
//    cdsServicosContratosManutencao.Active := true;
    cdsServicosContratosManutencao.first;
    while not cdsServicosContratosManutencao.Eof do
    begin
      if cdsServicosContratosManutencaoservico.asString <> qryServicosContratosManutencaoservico.asString then
        fListaServicosIncluidos := fListaServicosIncluidos + cdsServicosContratosManutencaoservico.asString + ', ';

      cdsServicosContratosManutencao.next;
    end;

    if length(fListaServicosIncluidos)<>0 then
      delete(fListaServicosIncluidos, length(fListaServicosIncluidos)-1, 2);
  end;    

  if fListaServicosIncluidos='' then
    fListaServicosIncluidos := '0';  

  result := fListaServicosIncluidos
end;


