procedure TdtmCadastroContratosManutencao.ExcluirServicosContrato;
begin
  if not qryServicosContratosManutencao.readonly then
    if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o SERVIÇO DO CONTRATO'])) = smbOk then
      qryServicosContratosManutencao.delete;
end;

function TdtmCadastroContratosManutencao.ExcluirContrato: Boolean;
var
  RetornoRespostaCtFaturado : TModalResult;

begin

  result := true;

  if qryContratosManutencaosituacao.asString = 'A' then
  begin
    RetornoRespostaCtFaturado := MensagemSimNaoOpcaoCancelar('Este contrato esta Assinado.'+chr(13)+'Deseja voltar para Orçado ou Cancelar?', 'Sair', false, 'Voltar', 'Cancelar');

    case RetornoRespostaCtFaturado of
    mrYes : begin
              RefazConsultaPorNome(qryPermitirAlterar,['contratomanutencao'], [qryContratosManutencaonumero.asinteger]);
              if qryPermitirAlterarnaopermite.asBoolean then
              begin
                result := false;
                MensagemAviso('O contrato não pode voltar de ASSINADO para ORÇADO pois existem parcelas pagas ou algum contrato de cobrança já foi faturado.');
                exit;
              end
              else
                OrcarContrato;
            end;

    mrNO : begin
             RefazConsultaPorNome(qryPermitirAlterar,['contratomanutencao'], [qryContratosManutencaonumero.asinteger]);
             if qryPermitirAlterarnaopermite.asBoolean then
             begin
               result := false;
               MensagemAviso('O contrato não pode ser CANCELADO pois existem parcelas pagas ou algum contrato de cobrança já foi faturado.');
               exit;
             end
             else
               CancelarContrato;
           end;

    mrCancel, mrOK : begin
                 result := false;
                 exit;
               end;
    end;


  end
  else
  if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o CONTRATO'])) = smbOk then
  begin

    qryApagarContratosVinculados.parambyname('contratomanutencao').asinteger := qryContratosManutencaonumero.asinteger;
    qryApagarContratosVinculados.execSql;
    LimparTabela(qryServicosContratosManutencao);
    qryContratosManutencao.delete;
    perpetrar([qryContratosManutencao, qryServicosContratosManutencao]);
  end;

end;

