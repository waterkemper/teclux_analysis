    Sql.Strings = (
      'select pps.pedidosaida,'
      '       pps.produto,'
      '       p.codigovisual as produtovisual,'
      '       p.descricao,'
      '       c.unidade,'
      '       pps.osp,'
      '       pps.numero,'
      '       pps.quantidade,'
      '       pps.preco,'
      '       (select sum(pdf.quantidade)'
      
        '        from DadosFiscais df join produtosdadosfiscais pdf on df' +
        '.numero = pdf.dadofiscal'
      '        where (df.situacao='#39'N'#39')'
      '          and pdf.pedidosaida = pps.pedidosaida'
      '          and pdf.numeroprodutopedido = pps.numero'
      '          and pdf.produto = pps.produto) as qtdeentregue,'
      '       true as ProdutoValidado'
      'from produtospedidossaida pps'
      
        '     join (produtos p join caracteristicas c on p.caracteristica' +
        ' = c.codigo)'
      '                      on pps.produto = p.codigo'
      'where (pps.pedidosaida = :pedidosaida)'
      'order by pps.numero')
