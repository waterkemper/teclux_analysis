procedure TdtmCadastroReservas.AbrirTabelaPesquisa(Pesquisa: TtecPesquisa);
begin
  case Pesquisa of
    pesPRODUTOS: begin
                   qryConsultaProdutos.Sql[16]:= 'and (p.codigo = 0)';
                   qryConsultaProdutos.Open;
                 end;
    pesFILIAIS : Abre(ctPesquisaFilial);
  end;
end;

procedure TdtmCadastroReservas.FecharTabelaPesquisa(Pesquisa: TtecPesquisa);
begin
  case Pesquisa of
    pesPRODUTOS: Fecha(ctPesquisaProdutos);
    pesFILIAIS : Fecha(ctPesquisaFilial);
  end;
end;

procedure TdtmCadastroReservas.Selecionar(Pesquisa: TtecPesquisa);
begin
  case Pesquisa of
    pesPRODUTOS: begin
                   RefazConsultaPorNome(qryProcuraProdutos,['codigo','filial'],
                             [inttostr(qryConsultaProdutoscodigo.AsLargeInt), qryconsultaprodutosfilial.asinteger]);
                   if not (qryProdutosReservas.State in [dsedit, dsinsert]) then
                     qryProdutosReservas.Edit;
                   qryProdutosReservasfilial.AsInteger    := qryConsultaProdutosfilial.AsInteger;
                   qryProdutosReservasproduto.AsLargeInt  := qryConsultaProdutoscodigo.AsLargeInt;
                 end;
    pesFILIAIS : begin
                   if not (qryProdutosReservas.State in [dsedit, dsinsert]) then
                     qryProdutosReservas.Edit;
                   qryProdutosReservasfilial.AsInteger:= qryConsultaFiliaiscodigo.AsInteger;
                 end;
  end;
end;

function TdtmCadastroReservas.ConfirmaCancelamento: Boolean;
begin
  if MensagemConfirmacao(Format(ctCONFIRMECANCELAR, ['a RESERVA'])) = smbCancel then
    Result:= False
  else
  begin
    if qryReservasusuario.AsInteger = CodigoUsuario then
         qryReservas.ReadOnly:= False
    else
      qryReservas.ReadOnly:= True;
    Result := True;
  end
end;

function TdtmCadastroReservas.GetCancelamentoPermitido: Boolean;
begin
  Result := (qryReservas.State = dsInsert) or
            (((CodigoUsuario = qryReservasusuario.AsInteger) or (UsuarioLogin.PermiteExcluirReserva))
              and (QuantidadeDevolvida = 0));
end;

function TdtmCadastroReservas.EfetuarCancelamento(Numero: Integer): Boolean;
var
  SituacaoProduto : TtecComposicao;
begin
  Result := True;
  try
    qryCancelarProdutosReserva.MacroByName('produto').AsString := '';
    qryCancelarProdutosReserva.Close;
    qryCancelarProdutosReserva.Params[0].AsInteger := Numero;
    qryCancelarProdutosReserva.Open;
    for SituacaoProduto := stNAOCOMPOSTO to stCOMPOSTO do
    begin
      qryCancelarProdutosReserva.First;
      while not qryCancelarProdutosReserva.Eof do
      begin
        if FiltrarComposto(qryCancelarProdutosReservacomposto.AsBoolean, SituacaoProduto) then
        begin
          RefazConsulta(qryBloquearEstoques, [0,1], [qryCancelarProdutosReservaproduto.AsLargeInt,
                                                     qryCancelarProdutosReservafilial.AsInteger]);
          RefazConsulta(spcMovimentosProximo, [0,1], [qryCancelarProdutosReservaproduto.AsLargeInt,
                                                      qryCancelarProdutosReservafilial.AsInteger]);
          GerarMovimento('TPE',
                         spcMovimentosProximonumero.Value,
                         qryCancelarProdutosReservaproduto.AsLargeInt,
                         qryCancelarProdutosReservafilial.AsInteger,
                         Numero,
                         qryCancelarProdutosReservaquantidade.AsCurrency,
                         qryCancelarProdutosReservabaixado.AsCurrency);
        end;
        qryCancelarProdutosReserva.Next;
      end;
    end;

    spcCancelarReserva.ParamByName('cancelado').Value := DataHoraLocal;
    spcCancelarReserva.ParamByName('numero').Value := Numero;
    spcCancelarReserva.ExecSql;
    spcCancelarReserva.Close;
    Perpetrar([spcCancelarReserva, qryMovimentos]);

  except
    Result := False;
  end;
end;

procedure TdtmCadastroReservas.dsrProdutosReservasDataChange(Sender: TObject; Field: TField);
begin
  inherited;
  if Field = qryProdutosReservasproduto then
  begin
    if not qryProcuraProdutos.IsEmpty then
    begin
      dsrProdutosReservas.OnDataChange := nil;
      qryProcuraFiliais.Params[0].AsInteger   := qryProcuraProdutosfilial.AsInteger;
      qryProcuraFiliais.Params[1].AsString  := inttostr(qryProcuraProdutoscodigo.AsLargeInt);
      qryConsultaFiliais.Params[0].AsString := inttostr(qryProcuraProdutoscodigo.AsLargeInt);

      qryProdutosReservasfilial.AsInteger    := qryProcuraProdutosfilial.AsInteger;
      qryProdutosReservasnomeproduto.AsString:= qryProcuraProdutosdescricao.AsString;
      qryProdutosReservascomposto.AsBoolean  := qryProcuraProdutoscomposto.AsBoolean;
      qryProdutosReservaslinha.AsString := qryProcuraProdutoslinha.AsString;
      qryProdutosReservascoluna.AsString := qryProcuraProdutoscoluna.AsString;
      qryProdutosReservasvalorgrade1.AsString := qryProcuraProdutosvalorgrade1.AsString;
      qryProdutosReservasvalorgrade2.AsString := qryProcuraProdutosvalorgrade2.AsString;
      dsrProdutosReservas.OnDataChange :=  dsrProdutosReservasDataChange;
    end;
  end
  else
  if Field = qryProdutosReservasfilial then
  begin
    if qryProdutosReservasfilial.asinteger<>0 then
      RefazConsultaPorNome(qryProcuraProdutos,['filial'], [qryProdutosReservasfilial.asinteger]);
  end;



end;

function TdtmCadastroReservas.ValidarQuantidade(Qtde: Currency): Boolean;
begin
  Result:= (Qtde > 0);
  if not Result then
    MensagemAviso('A quantidade deve ser maior que zero.')
  else begin
    Result:=  (Qtde <= qryProcuraProdutosemestoque.AsCurrency);
    if not Result then
      MensagemAviso(Format(ctQUANTIDADEINDISPONIVEL, [qryProcuraProdutosemestoque.AsString]));
  end;
end;

