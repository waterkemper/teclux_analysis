  qryMovimentos.Tag           := ctTabelasAuxiliaresCadastroReservas;
  qryConsultaReservas.Tag     := ctPesquisaReservas;
  qryConsultaProdutos.Tag     := ctPesquisaProdutos;
  qryConsultaFiliais.Tag      := ctPesquisaFilial;
  qryProdutosReservasquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosReservasbaixado.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProcuraProdutos.ParamByname('Filial').AsInteger := FilialBase;
end;

procedure TdtmCadastroReservas.qryReservasAfterInsert(DataSet: TDataSet);
begin
  qryReservasusuario.Value := CodigoUsuario;
  qryReservasvendedor.Value := NomeUsuario;
  qryReservasdata.Value := DataHoraLocal;
  qryReservasfilial.AsInteger:= Filialbase;
end;

procedure TdtmCadastroReservas.qryReservasAfterScroll(DataSet: TDataSet);
begin
  RefazConsulta(qryProdutosReservas,[0],[qryReservasnumero.AsInteger]);
end;

function TdtmCadastroReservas.CancelarReserva: Boolean;
begin
  if qryReservas.State in [dsInsert] then
    qryReservas.Delete
  else begin
    if ((qryReservasusuario.AsInteger = CodigoUsuario) or (UsuarioLogin.PermiteExcluirReserva)) then
    begin
      if EfetuarCancelamento(qryReservasnumero.AsInteger) then
           RefazConsulta(qryReservas,[0],[qryReservasnumero.AsInteger])
      else MensagemAviso('Erro ao cancelar reserva.');
    end
    else
      MensagemAviso(Format(ctSEMPERMISSAOALTERAR, ['nesta reserva']));
  end;
  Result:= True;
end;

function TdtmCadastroReservas.ExcluirProdutoReserva: Boolean;
begin
  Result:= False;
  if not qryProdutosReservas.IsEmpty then
  begin
    if qryReservas.State <> dsBrowse then
    begin
      if MensagemConfirmacao(Format(ctCONFIRMEEXCLUIR, ['o PRODUTO'])) = smbOk then
           qryProdutosReservas.Delete
      else qryProdutosReservas.Cancel;
    end
    else
    begin
      if MensagemConfirmacao(Format(ctCONFIRMECANCELAR, ['o PRODUTO'])) = smbOk then
           CancelarProdutoMovimento
      else qryProdutosReservas.Cancel;
    end;
    Result:= True;
  end;
end;

function TdtmCadastroReservas.CancelarProdutoMovimento: Boolean;
var
  count: Integer;
begin
  Result := True;
  count := 0;
  try
    qryReservas.ReadOnly := False;
    qryCancelarProdutosReserva.MacroByName('produto').AsString := 'and pr.produto = ' +
                                               qryProdutosReservasproduto.AsString;
    qryCancelarProdutosReserva.Close;
    qryCancelarProdutosReserva.Params[0].AsInteger := qryReservasnumero.AsInteger;
    qryCancelarProdutosReserva.Open;

    RefazConsulta(qryBloquearEstoques, [0,1], [qryCancelarProdutosReservaproduto.AsLargeInt,
                                               qryCancelarProdutosReservafilial.AsInteger]);
    RefazConsulta(spcMovimentosProximo, [0,1], [qryCancelarProdutosReservaproduto.AsLargeInt,
                                                qryCancelarProdutosReservafilial.AsInteger]);
    GerarMovimento('TPE',
                   spcMovimentosProximonumero.Value,
                   qryCancelarProdutosReservaproduto.AsLargeInt,
                   qryCancelarProdutosReservafilial.AsInteger,
                   qryReservasnumero.AsInteger,
                   qryCancelarProdutosReservaquantidade.AsCurrency,
                   qryCancelarProdutosReservabaixado.AsCurrency);

    qryProdutosReservas.Edit;
    qryProdutosReservasmovimento.AsInteger := spcMovimentosProximonumero.Value;
    qryProdutosReservascancelado.AsBoolean := True;
    Perpetrar([qryMovimentos, qryProdutosReservas]);

    qryProdutosReservas.First;
    while not qryProdutosReservas.Eof do
    begin
      if qryProdutosReservascancelado.AsBoolean then
        count := count + 1;
      qryProdutosReservas.Next;
    end;

    if qryProdutosReservas.RecordCount = count then
    begin
      spcCancelarReserva.ParamByName('cancelado').Value := DataHoraLocal;
      spcCancelarReserva.ParamByName('numero').Value := qryReservasnumero.AsInteger;
      spcCancelarReserva.ExecSql;
      spcCancelarReserva.Close;
    end;
    Perpetrar([spcCancelarReserva]);
    ReFazConsulta(qryReservas, [0], [qryReservasnumero.AsInteger]);
  except
    Result := False;
  end;
end;

function TdtmCadastroReservas.GravarProdutoReserva: Boolean;
begin
  Result:= False;
  if qryProdutosReservas.CheckRequiredFields then begin
    qryProdutosReservas.Post;
    qryReservas.Edit;
    Result:= True;
  end
end;

function TdtmCadastroReservas.IncluirReserva: Boolean;
begin
  qryReservas.Insert;
  Result:= True;
end;

function TdtmCadastroReservas.IncluirProdutoReserva(Editar: Boolean): Boolean;

  procedure ProdutosUtilizados;
  var
    Pos: TBookmark;
    SQLF,SQLP: String;
    Filial : Integer;
    Produto: Int64;
  begin
    SQLP:= ''; SQLF:= '';
    if not qryProdutosReservas.IsEmpty then begin
      Filial := qryProdutosReservasfilial.AsInteger;
      Produto:= qryProdutosReservasproduto.AsLargeInt;
      Pos:= qryProdutosReservas.GetBookmark;
      qryProdutosReservas.DisableControls;
      try
        qryProdutosReservas.First;
        while not qryProdutosReservas.Eof do begin
          if not Editar or (Editar and (Filial  <> qryProdutosReservasfilial.AsInteger) or
                                       (Produto <> qryProdutosReservasproduto.AsLargeInt)) then
            SQLP:= SQLP + 'and ((e.produto <> ' + IntToStr(qryProdutosReservasproduto.AsLargeInt) + ') or ' +
                               '(e.filial  <> ' + IntToStr(qryProdutosReservasfilial.AsInteger)  + '))';
          qryProdutosReservas.Next;
        end;
      finally
        qryProdutosReservas.GotoBookmark(Pos);
        qryProdutosReservas.FreeBookmark(Pos);
        qryProdutosReservas.EnableControls;
      end;
    end;
    qryProcuraProdutos.Sql[19] := SQLP;
    qryConsultaProdutos.Sql[17]:= SQLP;

    qryProcuraFiliais.Sql[7]   := SQLP;
    qryConsultaFiliais.Sql[6]  := SQLP;
    qryProcuraFiliais.Params[1].AsInteger  := qryProdutosReservasproduto.AsLargeInt;
    qryConsultaFiliais.Params[0].AsInteger := qryProdutosReservasproduto.AsLargeInt;
  end;

begin
  ProdutosUtilizados;
  if qryProdutosReservas.State in [dsInsert, dsEdit] then
    qryProdutosReservas.Cancel;
  if Editar and not qryProdutosReservas.IsEmpty then begin
    qryProcuraProdutos.Params[0].AsInteger:= qryProdutosReservasproduto.AsLargeInt;
    qryProcuraProdutos.Params[1].AsInteger:= qryProdutosReservasfilial.AsInteger;

    qryProcuraFiliais.Params [0].AsInteger:= qryProdutosReservasfilial.AsInteger;
    qryProcuraFiliais.Params [1].AsInteger:= qryProdutosReservasproduto.AsLargeInt;
    qryProdutosReservas.Edit;
    qryProdutosReservas.Cancel;
  end
  else
  begin
    qryProcuraProdutos.Params[0].Clear;
  //  qryProcuraProdutos.Params[1].Clear;

  //  qryProcuraFiliais.Params [0].Clear;
    qryProcuraFiliais.Params [1].Clear;

    qryProcuraProdutos.Params[1].AsInteger := filialbase;
    qryProcuraFiliais.Params [0].AsInteger := filialbase;

    qryProdutosReservas.Append;
    qryProdutosReservasquantidade.AsCurrency := ParSistema.ValordaQuantidade;
    qryProdutosReservasbaixado.AsCurrency := 0;
  end;
  Result := True;
end;

function TdtmCadastroReservas.QuantidadeNoPedido(Produto: int64; Filial: Integer): Currency;
begin
  Result := 0;
  qryProdutosReservas.DisableControls;
  qryProdutosReservas.First;
  while not qryProdutosReservas.EOF do begin
    if (qryProdutosReservasproduto.AsLargeInt = Produto) and (qryProdutosReservasfilial.AsInteger = Filial) then
      Result := Result + qryProdutosReservasquantidade.AsCurrency;
    qryProdutosReservas.Next;
  end;
  qryProdutosReservas.EnableControls;
  qryProdutosReservas.Edit;
end;

function TdtmCadastroReservas.GravarReserva: Boolean;
var
  SituacaoProduto : TtecComposicao;
  cnt: Integer;
  ProdutoComProblema, vp: String;
  AbortarGravacao: Boolean;
begin
  Result := False;
  AbortarGravacao := False;
  if not(qryReservas.State in [dsInsert]) then
    MensagemAviso(Format(ctSEMPERMISSAOALTERAR,['nesta reserva']))
  else begin
    if qryProdutosReservas.IsEmpty then
      MensagemAviso(Format(ctDEPENDENCIA, ['a reserva', 'incluir um produto']))
    else
    if Trim(qryReservascliente.AsString) = '' then
      MensagemAviso(Format(ctDEPENDENCIA, ['a reserva', 'incluir o cliente']))
    else
    begin
      qryProdutosReservas.DisableControls;
      qryProdutosReservas.First;
      while not qryProdutosReservas.EOF do begin
         vp := inttostr(produto);
         RefazConsulta(qryBloquearEstoques,[0, 1],[Produto, Filial]);
         qryProdutosReservas.Next;
      end;
      qryProdutosReservas.First;
      while not qryProdutosReservas.EOF do begin
        RefazConsulta(qryInfoProdutosReservas, [0, 1],[Produto, Filial]);
        if qryInfoProdutosReservasemestoque.AsCurrency < QuantidadeNoPedido(Produto,Filial) then
        begin
          ProdutocomProblema := qryProdutosReservasproduto.AsString;
          AbortarGravacao := True;
          Break;
        end;
        qryProdutosReservas.Next;
      end;

      if not AbortarGravacao then
      begin
        spcReservasProximo.Open;
        qryReservasnumero.AsInteger:= spcReservasProximonumero.AsInteger;
        spcReservasProximo.Close;
        qryReservasvalidade.Value := IncHour(qryReservasdata.Value, ParSistema.ValidadeReserva);

        for SituacaoProduto := stNAOCOMPOSTO to stCOMPOSTO do
        begin
          qryProdutosReservas.First;
          for cnt := 1 to qryProdutosReservas.RecordCount do begin
            if FiltrarComposto(qryprodutosReservascomposto.asboolean, SituacaoProduto) then
            begin
              if qryProdutosReservasreserva.AsInteger = 0 then begin
                RefazConsulta(spcMovimentosProximo,[0, 1],
                             [qryProdutosReservasproduto.Value,
                              qryProdutosReservasfilial.Value]);
                Movimento := spcMovimentosProximonumero.Value;
                Reserva   := qryReservasnumero.Value;
                qryProdutosReservas.Edit;
                qryProdutosReservasnumero.AsInteger := cnt;
                qryProdutosReservasreserva.AsInteger:= Reserva;
                qryProdutosReservasmovimento.Value  := Movimento;
                GerarMovimento('TEP',
                               Movimento,
                               qryProdutosReservasproduto.AsLargeInt,
                               qryProdutosReservasfilial.AsInteger,
                               Reserva,
                               qryProdutosReservasquantidade.AsCurrency,
                               qryProdutosReservasbaixado.AsCurrency);
                qryProdutosReservas.Post;
              end;
            end;
            qryProdutosReservas.Next;
          end;
        end;

        qryReservas.Post;
        Perpetrar([qryReservas, qryMovimentos, qryProdutosReservas]);
        RefazConsulta(qryReservas,[0],[qryReservasnumero.AsInteger]);
//        RefazConsulta(qryProdutosReservas,[0],[qryReservasnumero.AsInteger]);
        Result:=True;
      end;
      qryProdutosReservas.EnableControls;
    end;
  end;
  if AbortarGravacao then begin
    dtmTecsoft.TerminarTransacao;
    MensagemAviso(Format(ctPROBLEMAESTOQUEPRODUTO,[ProdutoComProblema]));
  end;
end;

procedure TdtmCadastroReservas.GerarMovimento(pTipo: String; pMovimento, pProduto: Int64;
pFilial, pReserva: Integer; pQuantidade, pBaixado: Currency);
begin
  qryMovimentos.Open;
  qryMovimentos.Insert;
  qryMovimentosnumero.AsInteger := pMovimento;
  qryMovimentosproduto.AsLargeInt:= pProduto;
  qryMovimentosfilial.AsInteger := pFilial;
  qryMovimentosdata.Value       := DataLocal;
  if pTipo = 'TEP' then
    qryMovimentosquantidade.AsCurrency:= pQuantidade
  else
    qryMovimentosquantidade.AsCurrency:= pQuantidade - pBaixado;
  qryMovimentosreferencia.AsString:= 'RS ' + IntToStr(pReserva);
  qryMovimentostipomovimento.AsString:= pTipo;
  qryMovimentos.Post;
end;

