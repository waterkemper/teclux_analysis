function TdtmCadastroReservas.ExisteProduto(Campo, Codigo: string): Boolean;
const
  SQL = 'and (upper(to_ascii(p.%s,''latin1'')) ilike upper(to_ascii(''%s%s'',''latin1'')))';
begin
  qryConsultaProdutos.Sql[16]:= Format(SQL, [Campo, Codigo, '%']);
  qryConsultaProdutos.Open;
  Result := (qryConsultaProdutos.RecordCount > 0);
end;

