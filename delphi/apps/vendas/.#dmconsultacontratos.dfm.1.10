    Sql.Strings = (
      'SELECT p.descricao,'
      '       p.valorgrade1,'
      '       p.valorgrade2,'
      '       p.referencia,'
      '       p.codigo,'
      '       p.codigovisual,'
      
        '       (select pdc.codigobarras from produtoscodigobarras pdc wh' +
        'ere pdc.produto = p.codigo limit 1) as codigobarras'
      'FROM produtos p'
      'WHERE false'
      
        'ORDER BY UPPER(TO_ASCII(p.descricao,'#39'latin1'#39')), p.valorgrade1, p' +
        '.valorgrade2')
