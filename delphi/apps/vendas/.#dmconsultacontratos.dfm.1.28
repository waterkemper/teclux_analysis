      FieldName = 'brinde'
    end
    object qryProdutosSimilaresvalorproduto: TFloatField
      FieldName = 'valorproduto'
      DisplayFormat = '0.00'
    end
    object qryProdutosSimilareslinha: TStringField
      FieldName = 'linha'
      Size = 50
    end
