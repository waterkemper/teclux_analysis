    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select  n.filial, '
      '        n.serie,'
      '        n.numero,'
      '        df.datasaida'
      'From    notas n, dadosfiscais df'
      'Where (n.dadofiscal = df.numero) '
      '     and (df.contrato =: contrato)'
      '     and df.situacao='#39'N'#39
      '')
    RequestLive = False
    Left = 520
    Top = 208
