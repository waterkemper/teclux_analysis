  object qryServicosContratos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'numero=contrato'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrImprimirContratos
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'contrato'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select sc.contrato,'
      '          sc.servico,'
      '          sc.quantidade,'
      '          sc.valorservico,'
      '          s.descricao'
      'from servicoscontratos sc, servicos s'
      'where s.codigo = sc.servico and'
      '%contrato')
    RequestLive = False
    Left = 40
    Top = 312
    object qryServicosContratoscontrato: TStringField
      FieldName = 'contrato'
    end
