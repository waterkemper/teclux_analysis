    Macros = <
      item
        DataType = ftUnknown
        Name = 'where'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select numero,'
      '          contrato,'
      '          datavencto,'
      '          valorvencto,'
      '          datapagto,'
      '          valorpagto,'
      
        '          (select banco from contas where conta = contaboleto li' +
        'mit 1) as banco'
      'from parcelas'
      '%where'
      'order by numero, datavencto')
    RequestLive = False
