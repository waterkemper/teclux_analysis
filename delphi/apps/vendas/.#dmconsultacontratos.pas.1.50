  Sql = 'and (upper(to_ascii(ct.pedidocliente,''latin1'')) ilike upper(to_ascii(''%s%s%s'',''latin1'')))';
begin
  FPedidoCliente := Value;
  if FPedidoCliente<>'' then
    qryContratos.MacroByName('PedidoCliente').AsString := Format(SQL, ['%', ansiuppercase(FpedidoCliente), '%'])
