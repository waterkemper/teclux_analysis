  Result := fdtmCadastroContratosAuxiliar;

end;

function TdtmConsultaContratos.RegistrarEntregaNaLoja: Boolean;
begin

  result := false;

  try

    if qryNotasContrato.Locate('situacao', 'N',[]) then
    begin

      UsuarioAutAux := ObterAutorizacao(taLOGIN, 'Entrega na loja', 'responsável pela entrega', '');

      if Assigned(UsuarioAutAux) then
      begin

        dtmCadastroContratosAuxiliar.qryEntregasProximo.close;
        dtmCadastroContratosAuxiliar.qryEntregasProximo.open;

        dtmCadastroContratosAuxiliar.qryEntregas.Append;
        dtmCadastroContratosAuxiliar.qryEntregascodigo.asinteger := dtmCadastroContratosAuxiliar.qryEntregasProximocodgo.asinteger;
        dtmCadastroContratosAuxiliar.qryEntregasdata_hora.asDatetime := DataHoraServidor;
        dtmCadastroContratosAuxiliar.qryEntregassituacao.asString := 'Objeto entregue ao cliente na loja '+inttostr(parsistema.Filial);
        dtmCadastroContratosAuxiliar.qryEntregascontrato.AsString := qryContratosnumero.asString;
        dtmCadastroContratosAuxiliar.qryEntregasnotafilial.AsString := qryNotasContratofilial.AsString;
        dtmCadastroContratosAuxiliar.qryEntregasnotaserie.AsString := qryNotasContratoserie.AsString;
        dtmCadastroContratosAuxiliar.qryEntregasnotanumero.AsString := qryNotasContratonumero.AsString;
        dtmCadastroContratosAuxiliar.qryEntregas.post;


        qryContratosAlteracao.Edit;
        qryContratosAlteracaousuarioentregaloja.AsInteger :=  UsuarioAutAux.CodigoUsuario;
        qryContratosAlteracaonomeusuarioentregaloja.AsString :=  UsuarioAutAux.NomeUsuario;
        qryContratosAlteracao.post;

        result := perpetrar([qryContratosAlteracao, dtmCadastroContratosAuxiliar.qryEntregas]);
      end;
    end
    else
    begin
      result := false;
      MensagemErro('Não foi encontrado uma nota fiscal válida vinculada a este contrato');
    end;

  finally

  end;

end;

