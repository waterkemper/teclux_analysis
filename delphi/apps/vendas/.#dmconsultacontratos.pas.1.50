procedure TdtmConsultaContratos.MontarFiltroEntreganaLoja;
begin
  if EntreganaLojaRealizada and EntreganaLojaPendente then
    qryContratos.MacroByName('EntreganaLoja').asString := ' and EntreganaLoja(ct.numero) in (''Pendente'',''Entregue'')'
  else
  if EntreganaLojaPendente then
    qryContratos.MacroByName('EntreganaLoja').asString := ' and EntreganaLoja(ct.numero) in (''Pendente'')'
  else
  if EntreganaLojaRealizada then
    qryContratos.MacroByName('EntreganaLoja').asString := ' and EntreganaLoja(ct.numero) in (''Entregue'')'
  else
    qryContratos.MacroByName('EntreganaLoja').asString := '';
end;

procedure TdtmConsultaContratos.dsrProdutosContratosDataChange(
  Sender: TObject; Field: TField);


  procedure DefinirDados_DataEntrega;
  begin

    if not qryProdutosContratosdataentrega.isnull then
    begin
      qryProdutosContratosDias.AsInteger := DaysBetween(qryContratosdata.asDateTime, qryProdutosContratosdataentrega.asdateTime);
      qryProdutosContratosentrega.asString := 'S';

      qryProdutosContratosperiodoentrega.asinteger := qryPeriodosEntregacodigo.asinteger;
      qryProdutosContratoshoraentrega.asDateTime := qryPeriodosEntregahorapadrao.asDateTime;

    end
    else
    begin
      qryProdutosContratosDias.clear;
      qryProdutosContratosentrega.asString := 'N';
      qryProdutosContratosperiodoentrega.clear;
      qryProdutosContratoshoraentrega.clear;
    end;
    VerificarCamposEntregaRequeridos;
  end;

  procedure DefinirDados_Entrega;
  begin
    if qryProdutosContratosentrega.asString = 'S' then
    begin
   (* *)

      if qryProdutosContratosdataentrega.isnull then
        qryProdutosContratosdataentrega.AsDateTime := DataServidor;

      qryProdutosContratosDias.AsInteger := DaysBetween(qryContratosAlteracaodata.asDateTime, qryProdutosContratosdataentrega.asdateTime);

      if qryProdutosContratosperiodoentrega.isnull then
        qryProdutosContratosperiodoentrega.asInteger := qryPeriodosEntregacodigo.asinteger;

      if qryProdutosContratoshoraentrega.isnull then
        qryProdutosContratoshoraentrega.asDateTime := qryPeriodosEntregahorapadrao.asDateTime;

   (*  *)

    end
    else
    begin
      qryProdutosContratosDias.clear;
      qryProdutosContratosperiodoentrega.clear;
      qryProdutosContratosdataentrega.clear;
      qryProdutosContratoshoraentrega.clear;
    end;
    VerificarCamposEntregaRequeridos;
  end;

  procedure DefinirDados_PeriodoEntrega;
  begin
    qryProdutosContratosentrega.asString := 'S';
    DefinirDados_Entrega;
  end;
  
begin
  inherited;
  if field = qryProdutosContratosDias then
  begin
    dsrProdutosContratos.OnDataChange:= nil;
    if qryProdutosContratosDias.asInteger <> 0 then
      qryProdutosContratosdataentrega.asDateTime := qryContratosdata.asDateTime + qryProdutosContratosDias.asInteger
    else
      qryProdutosContratosdataentrega.clear;

    DefinirDados_DataEntrega;

    dsrProdutosContratos.OnDataChange:= dsrProdutosContratosDataChange;
  end
  else
  if (field = qryProdutosContratosEntrega) then
  begin
    dsrProdutosContratos.OnDataChange:= nil;

    DefinirDados_Entrega;
//    RefazConsulta_limites_entregas_regioes;

    dsrProdutosContratos.OnDataChange:= dsrProdutosContratosDataChange;
  end
  else
  if (field = qryProdutosContratosperiodoentrega) then
  begin
    dsrProdutosContratos.OnDataChange:= nil;

    if not field.isnull then
    begin

      DefinirDados_PeriodoEntrega;

      if not ((qryProdutosContratoshoraentrega.Value >= qryPeriodosEntregainicio.value) and
              (qryProdutosContratoshoraentrega.Value <= qryPeriodosEntregafim.value)) then
        qryProdutosContratoshoraentrega.value := qryPeriodosEntregahorapadrao.value;
    end;
//    RefazConsulta_limites_entregas_regioes;
    
    dsrProdutosContratos.OnDataChange:= dsrProdutosContratosDataChange;
  end
  else
  if (field = qryProdutosContratosDataentrega) then
  begin
    dsrProdutosContratos.OnDataChange:= nil;
    DefinirDados_DataEntrega;
//    RefazConsulta_limites_entregas_regioes;
    dsrProdutosContratos.OnDataChange:= dsrProdutosContratosDataChange;
  end
  else
  if (field = qryProdutosContratoshoraentrega) then
  begin
    try
      qryPeriodosEntrega.GuardarRegistroAtual(true);

      qryPeriodosEntrega.first;
      while not qryPeriodosEntrega.eof do
      begin
        if (qryProdutosContratoshoraentrega.Value >= qryPeriodosEntregainicio.value) and
           (qryProdutosContratoshoraentrega.Value <= qryPeriodosEntregafim.value) then
        begin
          dsrProdutosContratos.OnDataChange:= nil;
          qryProdutosContratosperiodoentrega.AsInteger := qryPeriodosEntregacodigo.asinteger;
          dsrProdutosContratos.OnDataChange:= dsrProdutosContratosDataChange;
          break;
        end;
        qryPeriodosEntrega.next;
      end;
    finally
       qryPeriodosEntrega.VoltarRegistro;
    end;

  end;

end;

procedure TdtmConsultaContratos.GravarDadosEntrega;
var
  vContrato: String;
//  vDadoFiscal: variant;
  vEntrega: String;
  vDias: String;
  vDataEntrega: TDateTime;
  vHoraEntrega: TDatetime;
  vPeriodoEntrega: integer;
  vDescricaoPeriodoEntrega: String;
begin

  try

    qryProdutosContratos.GuardarRegistroAtual(true);

    vContrato := qryProdutosContratoscontrato.asString;
//    vDadoFiscal := qryProdutosContratosdadofiscal.asvariant;
    vEntrega := qryProdutosContratosentrega.asString;
    vDias := qryProdutosContratosdias.asstring;
    vDataEntrega := qryProdutosContratosdataentrega.asDateTime;
    vHoraEntrega := qryProdutosContratoshoraentrega.asDateTime;
    vPeriodoEntrega := qryProdutosContratosperiodoentrega.asinteger;
    vDescricaoPeriodoEntrega := qryProdutosContratosdescricaoperiodoentrega.asString;

    if qryContratosAlteracaodefinirdadosentregaparatodos.asBoolean then
    begin

      AtribuirDados(qryContratosAlteracao, [
        qryContratosAlteracaoentrega,
         qryContratosAlteracaodataentrega,
         qryContratosAlteracaohoraentrega,
         qryContratosAlteracaoperiodoentrega],

        [vEntrega,
         vDataEntrega,
         vHoraEntrega,
         vPeriodoEntrega], [], [], [], false, true);

      qryContratosAlteracao.edit;

      qryProdutosContratos.first;
    end;


    while not qryProdutosContratos.eof do
    begin
      if (vContrato = qryProdutosContratoscontrato.asString) {and
         (vDadoFiscal = qryProdutosContratosdadofiscal.asvariant)} then
      begin
         qryProdutosContratos.edit;
         if vEntrega='S' then
         begin
           qryProdutosContratosdias.asstring := vDias;
           qryProdutosContratosentrega.asString := vEntrega;
           qryProdutosContratosdataentrega.asDateTime := vDataEntrega;
           qryProdutosContratoshoraentrega.asDateTime := vHoraEntrega;
           qryProdutosContratosperiodoentrega.asinteger := vPeriodoEntrega;
           qryProdutosContratosdescricaoperiodoentrega.asString := vDescricaoPeriodoEntrega;
         end
         else
         begin
           qryProdutosContratosentrega.asString := vEntrega;
           qryProdutosContratosdias.clear;
           qryProdutosContratosdataentrega.clear;
           qryProdutosContratoshoraentrega.clear;
           qryProdutosContratosperiodoentrega.clear;
           qryProdutosContratosdescricaoperiodoentrega.clear;
         end;
         qryProdutosContratosdadosentregaalterados.asBoolean := True;
         qryProdutosContratos.post;

      end;

      if qryContratosAlteracaodefinirdadosentregaparatodos.asBoolean then
        qryProdutosContratos.next
      else
        break;
    end;

  finally
    qryProdutosContratos.VoltarRegistro;
  end;

end;

procedure TdtmConsultaContratos.VerificarCamposEntregaRequeridos;
begin
  qryProdutosContratosperiodoentrega.required := qryProdutosContratosentrega.asString = 'S';
  qryProdutosContratosdataentrega.required := qryProdutosContratosentrega.asString = 'S';
  qryProdutosContratoshoraentrega.required := qryProdutosContratosentrega.asString = 'S';

end;

end.
