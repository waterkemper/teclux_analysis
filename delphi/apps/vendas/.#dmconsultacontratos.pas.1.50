procedure TdtmConsultaContratos.ImprimirListaProdutosporLocalizacao;
var
  vLista: String;
begin
  if not Assigned(ImpressaoContrato) then
    ImpressaoContrato := TdtmImprimeContratos.Create(Self);
  try
    qryContratos.AfterScroll := nil;

    vLista := RetornarLista(qryContratos, qryContratosNumero, qryContratosselecionar, false);

    ImpressaoContrato.ImprimirListaProdutosporLocalizacao(vLista, 0, nil);

  finally
    ImpressaoContrato.Free;
    ImpressaoContrato := nil;

    qryContratos.AfterScroll := qryContratosAfterScroll;
  end;
end;


procedure TdtmConsultaContratos.SetDataCompraProdutoFinal(
  const Value: String);

Const
  SQLIntervaloComprasProdutos = ' and pc.produto in (select distinct pnp.produto '+
                                '                    from produtosnotaspag pnp '+
                                '                         join notaspag np '+
                                '                         on pnp.codigonota = np.codigo '+
                                '                    where np.data between :DataCompraProdutoInicial and '+
                                '                                          :DataCompraProdutoFinal '+
                                '                      and ehnotafiscalentradacompra(np.codigofiscal)) ';


begin
  fDataCompraProdutoFinal := Value;

  if (fDataCompraProdutoInicial <> '') and
     (fDataCompraProdutoFinal <> '') then
  begin
    qryContratos.MacroByName('SQLIntervaloComprasProdutos').asString := SQLIntervaloComprasProdutos;
    qryContratos.parambyname('DataCompraProdutoInicial').asString := FormatDateTime('yyyy-mm-dd',strtodate(fDataCompraProdutoInicial));
    qryContratos.parambyname('DataCompraProdutoFinal').asString := FormatDateTime('yyyy-mm-dd',strtodate(fDataCompraProdutoFinal));
  end
  else
    qryContratos.MacroByName('SQLIntervaloComprasProdutos').asString := '';

end;

procedure TdtmConsultaContratos.Setcodigo_pedido_marketplace(
  const Value: String);

const
  SQL= 'and EXISTS (Select ps.codigo_pedido_marketplace From pedidos_site ps '+
            'Where ps.contrato = ct.numero and '+
            'ps.codigo_pedido_marketplace = %s)';

begin
  fcodigo_pedido_marketplace := Value;

  if Value <> '' then qryContratos.MacroByName('codigo_pedido_marketplace').Value := Format(SQL, [quotedstr(Value)])
  else                qryContratos.MacroByName('codigo_pedido_marketplace').Value := ''
end;


procedure TdtmConsultaContratos.qryContratosAfterOpen(DataSet: TDataSet);
begin
  inherited;


  try

    qryContratos.AfterScroll:= nil;
    qryContratos.GuardarRegistroAtual(true);
    FRelatorioAtivo := True;

    QtdeMarcados := 0;
    TotalMarcados := 0;

    qryTotais_.open;
    qryTotais_.delete;

    qryTotais_.edit;
    qryTotais_registrosselecionados.asinteger := qryContratos.recordcount;
    qryTotais_totalregistrosselecionados.asCurrency := SomarValores(qrycontratos, [qrycontratosvalorprazo], [], [], []);
    qryTotais_.post;



//    ClientDataSetContratosSelecionados.close;
//    ClientDataSetContratosSelecionados.open;

//    ClientDataSetContratosMarcados.close;
//    ClientDataSetContratosMarcados.Open;

  finally

    FRelatorioAtivo := False;
    qrycontratos.VoltarRegistro;
    qryContratos.AfterScroll := qryContratosAfterScroll;

  end;


end;

procedure TdtmConsultaContratos.SetListaTiposAtendimentos(
  const Value: String);
begin
  fListaTiposAtendimentos := Value;
                {
  if IncluirRegistrosSemAtendimentos and TodosListaTiposAtendimentosMarcados then
    qryContratos.macrobyname('Atendimentos').asString := ''
  else
  if IncluirRegistrosSemAtendimentos and not TodosListaTiposAtendimentosMarcados then
    qryContratos.macrobyname('Atendimentos').asString := ' and (tipoatendimentocontrato(ct.numero) is null or tipoatendimentocontrato(ct.numero) in ('+ fListaTiposAtendimentos +'))'
  else
  if not IncluirRegistrosSemAtendimentos and TodosListaTiposAtendimentosMarcados then
    qryContratos.macrobyname('Atendimentos').asString := ' and tipoatendimentocontrato(ct.numero) is not null'
  else
  if not IncluirRegistrosSemAtendimentos and not TodosListaTiposAtendimentosMarcados then
    qryContratos.macrobyname('Atendimentos').asString := ' and tipoatendimentocontrato(ct.numero) in ('+ fListaTiposAtendimentos +')';
    }

  if ComAtendimento and not SemAtendimento then
  begin
    if not TodosListaTiposAtendimentosMarcados then
      qryContratos.macrobyname('Atendimentos').asString := ' and tipoatendimentocontrato(ct.numero) in ('+ fListaTiposAtendimentos +')'
    else
      qryContratos.macrobyname('Atendimentos').asString := 'and coalesce((select true from atendimentos a where a.contrato = ct.numero limit 1),false) '
  end
  else
  if not ComAtendimento and SemAtendimento then
    qryContratos.macrobyname('Atendimentos').asString := 'and coalesce((select false from atendimentos a where a.contrato = ct.numero limit 1),true)'
  else
    qryContratos.macrobyname('Atendimentos').asString := '';

end;

