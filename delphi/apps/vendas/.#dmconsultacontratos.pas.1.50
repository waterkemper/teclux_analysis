    property  DataCompraProdutoFinal: String read fDataCompraProdutoFinal write SetDataCompraProdutoFinal;

    property  FechamentoInicial: String read FFechamentoInicial write SetFechamentoInicial;
    property  FechamentoFinal: String read FFechamentoFinal write SetFechamentoFinal;
    property  ReservadoInicial: String read FReservadoInicial write SetReservadoInicial;
    property  ReservadoFinal: String read FReservadoFinal write SetReservadoFinal;
    property  Pedidocliente: String read FPedidoCliente write SetPedidoCliente;
    property  Xped: String read fXped write SetXped;

    property  codigo_pedido_marketplace: String read fcodigo_pedido_marketplace write Setcodigo_pedido_marketplace;

    property  Contrato: String read FContrato write SetContrato;
    property  Ordenacao:       Integer write SetOrdenacao;
    property  ContratoEmAberto: Boolean read GetContratoEmAberto;
    property  ContratoQuitado : Boolean read GetContratoQuitado;
    property  ContratoEstornado: Boolean read GetContratoEstornado;
    property  ContratoEmAtraso: Boolean read GetContratoEmAtraso;
    property  ContratoRenegociado: Boolean read GetContratoRenegociado;
    property  SituacaoContrato: String read GetSituacaoContrato;
    property  OnScrollLinhaColunaGrade    : TNotifyEvent read FOnScrollLinhaColunaGrade write FOnScrollLinhaColunaGrade;
    property  AfterPostProdutosContratos  : TNotifyEvent read fAfterPostProdutosContratos write fAfterPostProdutosContratos;
    property  LinhadaGrade: String read GetLinhadaGrade;
    property  ColunadaGrade: String read GetColunadaGrade;
    property  OnScrollLinhaColunaGradeSimilares: TNotifyEvent read FOnScrollLinhaColunaGradeSimilares write FOnScrollLinhaColunaGradeSimilares;
    property  LinhadaGradeSimilares: String read GetLinhadaGradeSimilares;
    property  ColunadaGradeSimilares: String read GetColunadaGradeSimilares;
    property  RelatorioAtivo: Boolean read FRelatorioAtivo write FRelatorioAtivo;
    procedure EditarProdutosContratos;
    procedure EditarServicosContratos;

    function GravarDados: Boolean;
    property tipoContrato: boolean read fTipoContrato write SetTipoContrato;
    property tipoOrdemServico: boolean read fTipoOrdemServico write fTipoOrdemServico;
    property OrdemServicoemGarantia: boolean read fOrdemServicoemGarantia write fOrdemServicoemGarantia;
    property OrdemServicoemCortesia: boolean read fOrdemServicoemCortesia write fOrdemServicoemCortesia;
    property GarantiaAprovada: boolean read fGarantiaAprovada write fGarantiaAprovada;
    property GarantiaReprovada: boolean read fGarantiaReprovada write fGarantiaReprovada;
    property GarantiaNaoDefinida: boolean read fGarantiaNaoDefinida write fGarantiaNaoDefinida;
    property LogicaGarantia: String read fLogicaGarantia write fLogicaGarantia;

    property ListaItemProdutos: String read FListaItemProdutos write SetListaItemProdutos;
    property ListaProdutos: String read FListaProdutos write SetListaProdutos;
    property ListaGrupos: String read fListaGrupos write SetListaGrupos;
    property ListaClasses: String read fListaClasses write SetListaClasses;
    property ListaMarcas: String read fListaMarcas write SetListaMarcas;

    property ListaCondicionalPromocoes: String read fListaCondicionalPromocoes write SetListaCondicionalPromocoes;

    property Equipamento: String read fEquipamento write SetEquipamento;

    property ComAtendimento: Boolean read fComAtendimento write fComAtendimento;
    property SemAtendimento: Boolean read fSemAtendimento write fSemAtendimento;

    property TodosListaTiposAtendimentosMarcados: Boolean read fTodosListaTiposAtendimentosMarcados write fTodosListaTiposAtendimentosMarcados;
    property ListaTiposAtendimentos: String read fListaTiposAtendimentos write SetListaTiposAtendimentos;


    function GetContrato: String;
    function GetTipoDocumento: String;

    procedure ImprimirListaProdutosporLocalizacao;

    property dtmCadastroContratosAuxiliar: TdtmCadastroContratosAuxiliar read GetdtmCadastroContratosAuxiliar write fdtmCadastroContratosAuxiliar;
    function RegistrarEntregaNaLoja: Boolean;

    property EntreganaLojaRealizada :Boolean read fEntreganaLojaRealizada write fEntreganaLojaRealizada;
    property EntreganaLojaPendente :Boolean read fEntreganaLojaPendente write fEntreganaLojaPendente;

    procedure GravarDadosEntrega;





   end;

const
  WhereBase = 21;
  WhereSituacao         = WhereBase + 1;
  WhereFilial           = WhereBase + 2;
  WhereVendedor         = WhereBase + 3;
  WhereCliente          = WhereBase + 4;
  WherePlano            = WhereBase + 5;
  WhereProduto          = WhereBase + 6;
  WhereCaracteristica   = WhereBase + 7;
  WhereGrupo            = WhereBase + 8;
  WhereClasse           = WhereBase + 9;
  WhereFornecedor       = WhereBase + 10;
  WhereAbertura         = WhereBase + 11;
  WhereFechamento       = WhereBase + 12;
  WhereOrdenacao        = WhereBase + 13;

var
  dtmConsultaContratos: TdtmConsultaContratos;

implementation

{$R *.dfm}

constructor TdtmConsultaContratos.Create(AOwner: TComponent);
begin
  inherited;
  qryFiliais.Tag                := ctTabelas;
  qryVendedores.Tag             := ctTabelas;
  qryClientes.Tag               := ctTabelas;
  qryFornecedores.Tag           := ctTabelas;

  qryConsultaFiliais.Tag        := ctTabelasConsultaFiliais;
  qryConsultaVendedores.Tag     := ctTabelasConsultaVendedores;
  qryConsultaClientes.Tag       := ctTabelasConsultaClientes;
  qryConsultaFornecedores.Tag   := ctTabelasConsultaFornecedores;
  qryClientes.Params[0].AsString:= 'C';
  qryProdutosContratosquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosContratosemestoque.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosContratosreservado.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosContratosfuturo.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosContratospedido.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosSimilaresemestoque.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosSimilaresreservado.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosSimilaresfuturo.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosSimilarespedido.DisplayFormat := ParSistema.MascaraQuantidadeGrade;

end;

procedure TdtmConsultaContratos.AbreTabelaConsulta(TipoConsulta: TtecConsultaContratos);
begin
  case TipoConsulta of
    cocFILIAIS          : Abre(ctTabelasConsultaFiliais);
    cocVENDEDORES       : Abre(ctTabelasConsultaVendedores);
    cocPLANOS           : Abre(ctTabelasConsultaPlanos);
    cocCLIENTES         : begin
                            qryConsultaClientes.Sql[11]:= 'Where (v.codigo = 0)';
                            Abre(ctTabelasConsultaClientes);
                          end;
    cocFORNECEDORES     : begin
                            qryConsultaFornecedores.Sql[06]:= 'Where (f.codigo = 0)';
                            Abre(ctTabelasConsultaFornecedores);
                          end;
  end;
end;


function TdtmConsultaContratos.ExisteFilial(campo, codigo: String): Boolean;
begin
  Result := ExisteCodigo(qryConsultaFiliais, campo, codigo);
end;


function TdtmConsultaContratos.ExisteVendedor(campo, codigo: String): Boolean;
begin
  Result := ExisteCodigo(qryConsultaVendedores, campo, codigo);
end;


function TdtmConsultaContratos.ExisteFornecedor(campo, codigo: String): Boolean;
const
  SQL = 'where (upper(to_ascii(%s,''latin1'')) ilike upper(to_ascii(''%s%s'',''latin1'')))';
begin
  if Campo = 'nomecidade' then
    Campo:= 'ct.nome';
  if Campo = 'nome' then
    Campo:= 'f.nome';
  qryConsultaFornecedores.Sql[06] := Format(SQL, [Campo, Codigo, '%']);
  qryConsultaFornecedores.Open;
  Result := qryConsultaFornecedores.RecordCount > 0
end;

function TdtmConsultaContratos.ExisteCliente(Campo, Codigo: String): Boolean;
const
  SQL = 'where (upper(to_ascii(%s,''latin1'')) ilike upper(to_ascii(''%s%s'',''latin1'')))';
begin
  if Campo = 'nomecidade' then
    Campo:= 'ct.nome'
  else if Campo = 'tipopessoa' then
    Campo:= 'v.tipo'
  else Campo:= 'v.' + Campo;
  qryConsultaClientes.Sql[11] := Format(SQL, [Campo, Codigo, '%']);
  qryConsultaClientes.Open;
  Result := qryConsultaClientes.RecordCount > 0
end;

procedure TdtmConsultaContratos.Selecionar(TipoConsulta: TtecConsultaContratos);
begin
  case TipoConsulta of
    cocFILIAIS          : ReFazConsulta(qryFiliais,[0],[qryConsultaFiliaiscodigo.AsInteger]);
    cocVENDEDORES       : ReFazConsulta(qryVendedores,[0],[qryConsultaVendedorescodigo.AsInteger]);
    cocCLIENTES         : begin
                            ReFazConsulta(qryClientes,[0,1],[qryConsultaClientestipo.AsString,
                                                             qryConsultaClientescodigo.AsInteger]);
                          end;
    cocFORNECEDORES     : ReFazConsulta(qryFornecedores,[0], [qryConsultaFornecedorescodigo.AsString]);
  end;
end;

procedure TdtmConsultaContratos.FechaTabelaConsulta(TipoConsulta: TtecConsultaContratos);
begin
  case TipoConsulta of
    cocFILIAIS          : Fecha(ctTabelasConsultaFiliais);
    cocVENDEDORES       : Fecha(ctTabelasConsultaVendedores);
    cocPLANOS           : Fecha(ctTabelasConsultaPlanos);
    cocCLIENTES         : Fecha(ctTabelasConsultaClientes);
    cocPRODUTOS         : Fecha(ctTabelasConsultaProdutos);
    cocCARACTERISTICAS  : Fecha(ctTabelasConsultaCaracteristicas);
    cocGRUPOS           : Fecha(ctTabelasConsultaGrupos);
    cocCLASSES          : Fecha(ctTabelasConsultaClasses);
    cocFORNECEDORES     : Fecha(ctTabelasConsultaFornecedores);
  end;
end;

procedure TdtmConsultaContratos.RefazConsultaTabelas;
begin
  if not qryFornecedores.IsEmpty then
    ReFazConsulta(qryFornecedores,[0],[0]);
end;

procedure TdtmConsultaContratos.LimpaFiltros;
begin
  qryContratos.Close;
  qryProdutosContratos.Close;
  ReFazConsulta(qryFiliais,[0],[0]);
  ReFazConsulta(qryVendedores,[0],[0]);
  ReFazConsulta(qryClientes,[0,1],['C',0]);
  RefazConsultaTabelas;
  QtdeMarcados := 0;
end;

function TdtmConsultaContratos.AbrirConsultaContratos: Boolean;
begin
  if qryContratos.Active then
    qryContratos.Close;
  QtdeMarcados := 0;

  qryContratos.AfterOpen := qryContratosAfterOpen;  {manter desligado em design-time}

  qryContratos.Open;
  Result := qryContratos.IsEmpty;
end;

function TdtmConsultaContratos.GetConsultarFilial: TtecQuery;
begin
  Result := qryConsultaFiliais;
end;


function TdtmConsultaContratos.GetConsultarCliente: TtecQuery;
begin
  Result := qryConsultaClientes;
end;


function TdtmConsultaContratos.GetConsultarVendedor: TtecQuery;
begin
  Result := qryConsultaVendedores;
end;


function TdtmConsultaContratos.GetConsultarFornecedor: TtecQuery;
begin
  Result := qryConsultaFornecedores;
end;

function TdtmConsultaContratos.GetContratoEmAberto: Boolean;
begin
  Result:= qryContratosaberto.AsBoolean;
end;

function TdtmConsultaContratos.GetContratoEstornado: Boolean;
begin
  Result := qryContratossituacaocontrato.AsString='ESTORNADO';
end;

function TdtmConsultaContratos.GetContratoEmAtraso: Boolean;
begin
  Result:=Pos('/',qryContratossituacaocontrato.AsString)>0;
end;

function TdtmConsultaContratos.GetContratoRenegociado: Boolean;
begin
  Result:= qryContratosrenegociado.AsString <> '';
end;

function TdtmConsultaContratos.GetSituacaoContrato: String;
begin
  Result:= qryContratossituacao.AsString;
end;


procedure TdtmConsultaContratos.SetCliente(const Value: String);
begin
  if Value <> '' then qryContratos.MacroByName('Cliente').Value := 'and (ct.cliente = ' + Value + ')'
  else                qryContratos.MacroByName('Cliente').Value := ''
end;

procedure TdtmConsultaContratos.SetAberturaInicial(const Value: String);
begin
  FAberturaInicial:= Value;
//  qryContratos.MacroByName('Abertura').Value := MontarIntervaloData('c.data',FAberturaInicial,FAberturaFinal);
end;

procedure TdtmConsultaContratos.SetAberturaFinal(const Value: String);
begin
  FAberturaFinal:= Value;
  qryContratos.MacroByName('Abertura').Value := MontarIntervaloData('ct.data',FAberturaInicial,FAberturaFinal);
end;

procedure TdtmConsultaContratos.SetFilial(const Value: String);
begin
  if Value <> '' then qryContratos.MacroByName('Filial').Value := 'and (ct.filialvenda = ' + Value + ')'
  else                qryContratos.MacroByName('Filial').Value := ''
end;

procedure TdtmConsultaContratos.SetFornecedor(const Value: String);
const
  SQL = 'and (Select count(*) '+
              'From produtoscontratos pc '+
              'Where ct.numero = pc.contrato and '+
                  '(Select count(*) '+
                    'From produtos pr '+
                    'Where pr.codigo = pc.produto and '+
                     '(Select count(*) '+
                       'From caracteristicas ca '+
                       'Where ca.codigo = pr.caracteristica and '+
                           '(Select count(*) '+
                             'From fornecedoresprodutos fp '+
                             'Where ca.codigo = fp.caracteristica and '+
                             'fp.fornecedor = %s) > 0) > 0) > 0) > 0';
begin
  if Value <> '' then qryContratos.MacroByName('Fornecedor').Value := format(SQL, [Value])
  else                qryContratos.MacroByName('Fornecedor').Value := ''
end;


procedure TdtmConsultaContratos.SetOrdenacao(const Value: Integer);
begin
  case Value of
    0: qryContratos.MacroByName('Ordenacao').Value := 'Order By upper(to_ascii(ct.nome,''latin1'')), ct.data';
    1: qryContratos.MacroByName('Ordenacao').Value := 'Order By ct.data, upper(to_ascii(ct.nome,''latin1''))';
    2: qryContratos.MacroByName('Ordenacao').Value := 'Order By ct.datareservado, upper(to_ascii(ct.nome,''latin1''))';
    3: qryContratos.MacroByName('Ordenacao').Value := 'Order By ct.faturamento, upper(to_ascii(ct.nome,''latin1''))';
    4: qryContratos.MacroByName('Ordenacao').Value := 'Order By cast(ct.numero as bigint), ct.data';
    5: qryContratos.MacroByName('Ordenacao').Value := 'Order By pl.descricao, ct.Plano, upper(to_ascii(ct.nome,''latin1''))';
  end;
end;

procedure TdtmConsultaContratos.SetPlano(const Value: String);
begin

  if Value <> '' then
  begin
    if ExcetoPlano then
      qryContratos.MacroByName('Plano').Value := 'and (ct.plano not in (' + Value + '))'
    else
      qryContratos.MacroByName('Plano').Value := 'and (ct.plano in (' + Value + '))';
  end
  else                qryContratos.MacroByName('Plano').Value := ''
end;


procedure TdtmConsultaContratos.SetSituacao(const Value: String);
var
  SQLSituacao: String;
begin
  SQLSituacao := 'Where situacao in (' + Value;
  if Copy(SQLSituacao,length(SQLSituacao),1) = ',' then
    SQLSituacao := Copy(SQLSituacao,1,length(SQLSituacao)-1) + ') ';
  qryContratos.MacroByName('Situacao').Value := SQLSituacao;
end;

procedure TdtmConsultaContratos.SetFechamentoInicial(const Value: String);
begin
  FFechamentoInicial:= Value;
//  qryContratos.MacroByName('Fechamento').Value := MontarIntervaloData('c.faturamento',FFechamentoInicial,FFechamentoFinal);
end;

procedure TdtmConsultaContratos.SetFechamentoFinal(const Value: String);
begin
  FFechamentoFinal:= Value;
  qryContratos.MacroByName('Fechamento').Value := MontarIntervaloData('ct.faturamento',FFechamentoInicial,FFechamentoFinal);
end;

procedure TdtmConsultaContratos.SetVendedor(const Value: String);
begin
  if Value <> '' then qryContratos.MacroByName('Vendedor').Value := 'and (' + Value + ')'
  else                qryContratos.MacroByName('Vendedor').Value := '';
end;

procedure TdtmConsultaContratos.qryContratosAfterScroll(DataSet: TDataSet);
begin
  inherited;
  if not FRelatorioAtivo then
  begin
    qryProdutosContratos.Close;
    qryProdutosContratos.MacroByName('contrato').AsString := ' AND pc.contrato = ''' + qryContratosnumero.AsString+'''';
    qryProdutosContratos.MacroByName('cliente').AsString := ' AND c.cliente = ''' + inttostr(qryContratoscliente.Asinteger)+''' AND c.tipocliente='''+qryContratostipocliente.AsString+'''';
    qryProdutosContratos.Open;

    qryServicosContratos.Close;
    qryServicosContratos.MacroByName('contrato').AsString := ' AND sc.contrato = ''' + qryContratosnumero.AsString+'''';
    qryServicosContratos.Open;

    RefazConsultaPorNome(qryContratosAlteracao,['numero'],[qryContratosnumero.AsVariant]);
    RefazConsultaPorNome(qryContratosVendedores,['contrato'],[qryContratosnumero.AsVariant]);

    if assigned(AfterPostProdutosContratos) then
      AfterPostProdutosContratos(qryProdutosContratos);

    qryNOtasContrato.Close;
    qryNotasContrato.ParamByName('contrato').AsString:= qryContratosnumero.AsString;
    qryNotasContrato.Open;


    RefazConsultaPorNome(dtmCadastroContratosAuxiliar.qryEntregas, ['contrato'],[qryContratosnumero.asString]);

  end;
end;
function TdtmConsultaContratos.GetColunadaGradeSimilares: String;
begin
  result := PrimeiraLetraEmMaiuscula(qryProdutosSimilarescoluna.AsString)
end;

function TdtmConsultaContratos.GetLinhadaGradeSimilares: String;
begin
  result := PrimeiraLetraEmMaiuscula(qryProdutosSimilareslinha.AsString)
end;

function TdtmConsultaContratos.GetColunadaGrade: String;
begin
  result := PrimeiraLetraEmMaiuscula(qryProdutosContratoscoluna.AsString)
end;

function TdtmConsultaContratos.GetLinhadaGrade: String;
begin
  result := PrimeiraLetraEmMaiuscula(qryProdutosContratoslinha.AsString)
end;

procedure TdtmConsultaContratos.qryProdutosContratosAfterScroll(
  DataSet: TDataSet);
begin
  inherited;
  if not FRelatorioAtivo then
  begin
    if Assigned(OnScrollLinhaColunaGrade) then
      OnScrollLinhaColunaGrade(qryProdutosContratos);

    if ParSistema.MostrarSimilaresContrato then
      ReFazConsulta(qryProdutosSimilares,[0,1],[qryProdutosContratosproduto.AsVariant,qryProdutosContratosfilial.AsVariant]);

  end
  else
        RefazConsultaPorNome(qryProdutosPedidosPrevisao,
              ['produto'],
              [qryProdutosContratosproduto.AsVariant]);


end;

procedure TdtmConsultaContratos.qryProdutosSimilaresAfterScroll(
  DataSet: TDataSet);
begin
  inherited;
  if Assigned(OnScrollLinhaColunaGradeSimilares) then
    OnScrollLinhaColunaGradeSimilares(qryProdutosSimilares);
end;

procedure TdtmConsultaContratos.MarcarSelecionados(Marcando,
  Todos: Boolean);
var
  vRecno : integer;
begin
  try

    qryContratos.AfterScroll:= nil;
//    qryContratos.GuardarRegistroAtual(true);
    qryContratos.disablecontrols;

    vRecno := qryContratos.recno;
    FRelatorioAtivo := True;

    MarcarRegistros(qryContratos,
                    qrycontratosselecionar,
                    qryContratosvalorprazo,
                    Marcando,
                    Todos);

//    ClientDataSetContratosMarcados.close;
//    ClientDataSetContratosMarcados.Open;


  finally

    FRelatorioAtivo := False;
//    qrycontratos.VoltarRegistro;
    qryContratos.recno := vRecno;
    qryContratos.enablecontrols;
    qryContratos.AfterScroll := qryContratosAfterScroll;


    qryTotais_.edit;
    qryTotais_registrosmarcados.asinteger := QtdeMarcados;
    qryTotais_totalregistrosmarcados.asCurrency := TotalMarcados;
    qryTotais_.post;



  end;

end;

procedure TdtmConsultaContratos.ImprimirRelatorio;
var
  Pos: TBookmark;
  Contratos: String;
  Cont: Integer;
begin
  FRelatorioAtivo := True;
  Pos := qryContratos.GetBookmark;
  qryContratos.First;
  Cont := 0;
  while Cont < QtdeMarcados do begin
    if qryContratosselecionar.AsBoolean then
    begin
      Contratos:= Contratos + quotedstr(qryContratosnumero.AsString) + ',';
      Inc(Cont);
    end;
    qryContratos.Next;
  end;
  Delete(Contratos,Length(Contratos),1);

  qryContratos.GotoBookmark(Pos);
  qryContratos.FreeBookmark(Pos);

  if Contratos <> '' then
    ImprimirRelatorio(Contratos);
end;

procedure TdtmConsultaContratos.ImprimirRelatorio(Contratos: String);
var
  Relatorio: TfrReport;
  frmPreview: TfrmPreviewPadrao;
begin
  If (FQuebraPorCliente) then
  begin
        qryImprimirContratos.Close;
        qryProdutosContratos.Close;
        qryServicosContratos.Close;
        qryParcelas.Close;
        qryTotais.Close;
        qryImprimirContratos.MacroByName('where').AsString := 'where numero in ('+ Contratos + ')';
        qryProdutosContratos.MacroByName('contrato').AsString := 'pc.contrato in ('+ Contratos + ')';
        qryServicosContratos.MacroByName('contrato').AsString := 'sc.contrato in ('+ Contratos + ')';
        qryParcelas.MacroByName('where').AsString := 'where contrato in (' + Contratos + ')';
        qryTotais.MacroByName('where').AsString := 'where c.numero in ('+ Contratos + ')';
        qryProdutosContratos.MasterSource := dsrImprimirContratos;
        qryImprimirContratos.Open;
        qryProdutosContratos.DisableControls;
  end
  else
  begin
{
    qryImprimirContratos_Lista.Close;
    qryImprimirContratos_Lista.MacroByName('where').AsString := 'where cast(numero as bigint) in ('+Contratos+')';
    qryImprimirContratos_Lista.MacroByName('order').AsString := qryContratos.MacrobyName('Ordenacao').AsString;
    qryImprimirContratos_Lista.Open;
}


    qryImprimirContratos_Lista.Close;
    qryProdutosContratos.Close;
//    qryServicosContratos.Close;
//    qryParcelas.Close;
//    qryTotais.Close;
    qryImprimirContratos_Lista.MacroByName('where').AsString := 'where numero in ('+ Contratos + ')';
    qryImprimirContratos_Lista.MacroByName('order').AsString := qryContratos.MacrobyName('Ordenacao').AsString;

    qryProdutosContratos.MacroByName('contrato').AsString := 'and pc.contrato in ('+ Contratos + ')';
//    qryServicosContratos.MacroByName('contrato').AsString := 'sc.contrato in ('+ Contratos + ')';
//    qryParcelas.MacroByName('where').AsString := 'where contrato in (' + Contratos + ')';
//    qryTotais.MacroByName('where').AsString := 'where c.numero in ('+ Contratos + ')';
    qryProdutosContratos.MasterSource := dsrImprimirContratos_Lista;
    qryImprimirContratos_Lista.Open;
  ///  qryProdutosContratos.DisableControls;



  end;
  frVariables['Titulo']:= 'RELAÇÃO DE CONTRATOS';
//frpImprimirContratos_Lista.DesignReport;
  frmPreview := TfrmPreviewPadrao.create(self);
  try

//    frpImprimirContratos_Lista_Produtos.DesignReport;

    Relatorio := frmPreview.frCompositeReport;
    frmPreview.frCompositeReport.Reports.Clear;
    if (FQuebraPorCliente) then
        frmPreview.frCompositeReport.Reports.Add(frpImprimirContratos)
    else
        frmPreview.frCompositeReport.Reports.Add(frpImprimirContratos_Lista_Produtos);
    Relatorio.Preview := frmPreview.frPreviewPadrao;
    Relatorio.ShowReport;
    frmPreview.ShowModal;
  finally
//    frmPreview.Free;
//    if(FQuebraPorCliente) then
    begin
        qryProdutosContratos.MasterSource := nil;
//        qryProdutosContratos.EnableControls;
    end;
    FRelatorioAtivo := False;
  end;
end;

procedure TdtmConsultaContratos.frpImprimirContratosBeforePrint(
  Memo: TStringList; View: TfrView);
begin
  inherited;
  Zebrado_Detalhe := (qryProdutosContratos.RecNo mod 2) <> 0;
  Zebrado_SubDetalhe_1 := (qryservicoscontratos.RecNo mod 2) <> 0;
  Zebrado_SubDetalhe_2 := (qryparcelas.RecNo mod 2) <>0;
  ZebrarLinhaRelatorio(frpImprimirContratos,View);
end;

