  if Value = True then
  begin
    SQLQuitado:= 'and (((contratos_quitado(ct.numero)) = True ) and not (ct.situacao in (''C'',''O'',''R'')) and (vficha_situacaocontrato(ct.numero) <> ''ESTORNADO''))';
    qryContratos.MacroByName('Quitado').AsString:= SQLQuitado;
  end
  else
    qryContratos.MacroByName('Quitado').AsString:= '';
end;

procedure TdtmConsultaContratos.SetEmAtraso(const Value: Boolean);
var SQLEmAtraso: String;
begin
  if Value = True then
  begin
    SQLEmAtraso:= 'and ((Position(''/'' in (vficha_situacaocontrato(ct.numero)))>0) and ((ct.situacao not in (''C'',''O'',''R''))))';
    qryContratos.MacroByName('EmAtraso').AsString:= SQLEmAtraso;
  end
  else
    qryContratos.MacroByName('EmAtraso').AsString:= '';
end;

procedure TdtmConsultaContratos.SetRenegociado(const Value: Boolean);
