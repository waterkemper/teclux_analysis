procedure TdtmConsultaContratos.SetEmAberto(const Value: Boolean);
var SQLEmAberto: String;
begin
  if Value = True then
  begin
{
    SQLEmAberto:= 'and (((contratos_emaberto(c.numero)) = True) and ((c.situacao not in (''C'',''O'',''R'')))'+
                  ' and ((Position(''/'' in (vficha_situacaocontrato(c.numero)))<=0)))';
}

    SQLEmAberto:= 'and ((contratos_emaberto(ct.numero)) = True) and ((ct.situacao not in (''C'',''O'',''R'')))';


    qryContratos.MacroByName('Emaberto').AsString:= SQLEmAberto;
  end
  else
    qryContratos.MacroByName('Emaberto').AsString:= '';
end;

