  if not (qryProdutosContratos.State in [dsedit, dsinsert]) then
    qryProdutoscontratos.Edit;
end;

procedure TdtmConsultaContratos.qryProdutosContratosAfterPost(
  DataSet: TDataSet);
begin
  inherited;
  qryContratosAlteracao.edit;
  if assigned(AfterPostProdutosContratos) then
    AfterPostProdutosContratos(qryProdutosContratos);
end;

function TdtmConsultaContratos.GravarDados: Boolean;
var
 vDataHoraAlteracao : TDateTime;
 UsuarioAut: TtecUsuarios;
 vListaProdutoseFiliais: String;

begin
  vListaProdutoseFiliais := '';

  result := qryContratosAlteracao.CheckRequiredFields;

  if result then
    result := qryContratosVendedores.CheckRequiredFields(true, false, true,
                self.Owner, true);

  if result then
  begin

   UsuarioAut := ObterAutorizacao(taLOGIN, 'Para alteração da filial ou vendedor', ctANALISTACREDITO, '');

   if not Assigned(UsuarioAut) then
   begin
     Result:=false;
     MensagemAviso('Não ocorreu a validação do usuário para gravar a ALTERAÇÃO DO CONTRATO');
   end
   else
   if not UsuarioAut.AnalistaCredito then
   begin
     Result:=false;
     MensagemAviso(format(ctUSUARIONAOAUTORIZADO,['gravar a ALTERAÇÃO DO CONTRATO.']));
   end;

   if result then
   begin

     vDataHoraAlteracao := now;
     GuardarRegistroAtual(qryProdutosContratos, true);
     qryprodutoscontratos.First;
     while not qryprodutoscontratos.Eof do
     begin
       if qryProdutosContratosvendedoralterado.AsBoolean then
       begin
         result := qryprodutoscontratos.CheckRequiredFields;
         if result then
         begin
           qryprodutoscontratos.Edit;
           qryProdutosContratosusuariologadoalteracao.AsInteger := CodigoUsuario;
           qryProdutosContratosusuarioalteracao.AsInteger := UsuarioAut.CodigoUsuario;
           qryProdutosContratosdatahoraalteracaousuario.AsDateTime := vDataHoraAlteracao;
           qryprodutoscontratos.Post;

           vListaProdutoseFiliais := vListaProdutoseFiliais + '(' + qryProdutosContratosproduto.AsString + ','+
                                                                    qryProdutosContratosfilial.AsString  + '),'

         end
         else
           break;
       end
       else
       if qryProdutosContratosdadosentregaalterados.asBoolean then
       begin

         qryUpdateProdutosDadosFiscais.ParamByName('contrato').asString := qryProdutosContratosContrato.asString;
         qryUpdateProdutosDadosFiscais.Macrobyname('ListaProdutos').asString := '('+
           qryProdutoscontratosproduto.asString+', '+
           qryProdutosContratosfilial.asString + ')';

         qryUpdateProdutosDadosFiscais.ParamByName('usuariologadoalteracao').asInteger := CodigoUsuario;
         qryUpdateProdutosDadosFiscais.ParamByName('usuarioalteracao').asInteger := UsuarioAut.CodigoUsuario;
         qryUpdateProdutosDadosFiscais.ParamByName('datahoraalteracaousuario').AsDateTime := vDataHoraAlteracao;
         qryUpdateProdutosDadosFiscais.ParamByName('entrega').asString := qryProdutosContratosentrega.asString;
         
         if qryProdutosContratosentrega.asString = 'S' then
           qryUpdateProdutosDadosFiscais.ParamByName('entregar').asBoolean := True
         else
           qryUpdateProdutosDadosFiscais.ParamByName('entregar').asBoolean := False;

         if qryProdutosContratosperiodoentrega.asinteger<>0 then
           qryUpdateProdutosDadosFiscais.ParamByName('periodoentrega').asinteger := qryProdutosContratosperiodoentrega.asinteger
         else
           qryUpdateProdutosDadosFiscais.ParamByName('periodoentrega').value := Null;

         if qryProdutosContratosdataentrega.asDateTime<>0 then
           qryUpdateProdutosDadosFiscais.ParamByName('dataentrega').asDateTime :=  qryProdutosContratosdataentrega.asDateTime
         else
           qryUpdateProdutosDadosFiscais.ParamByName('dataentrega').value := Null;

         if qryProdutosContratosdataentrega.asDateTime<>0 then
           qryUpdateProdutosDadosFiscais.ParamByName('horaentrega').asString :=  formatdatetime('hh:mm:ss', qryProdutosContratoshoraentrega.asDateTime)
         else
           qryUpdateProdutosDadosFiscais.ParamByName('horaentrega').value := Null;

         qryUpdateProdutosDadosFiscais.ExecSQL;

       end;
       qryprodutoscontratos.Next;
     end;
     VoltarRegistroAtual(qryProdutoscontratos);

     if result then
     begin

       if qryContratosAlteracaovendedor.AsInteger <>
          qryContratosvendedor.AsInteger then
       begin

         qryContratosAlteracao.Edit;
         qryContratosAlteracaousuariologadoalteracao.AsInteger := CodigoUsuario;
         qryContratosAlteracaousuarioalteracao.AsInteger := UsuarioAut.CodigoUsuario;
         qryContratosAlteracaodatahoraalteracaousuario.AsDateTime := vDataHoraAlteracao;
         qrycontratosAlteracao.Post;

         if (qryContratossituacao.AsString = 'P') or
            (qryContratossituacao.AsString = 'N') then
         begin
           RefazConsultaPorNome(qryDadosFiscaisAlteracao,['contrato'],[qryContratosAlteracaonumero.AsVariant]);

           qryDadosFiscaisAlteracao.first;
           while not qryDadosFiscaisAlteracao.Eof do
           begin
             qryDadosFiscaisAlteracao.edit;
             qryDadosFiscaisAlteracaovendedor.AsInteger := qryContratosAlteracaovendedor.AsInteger;
             qryDadosFiscaisAlteracaousuariologadoalteracao.AsInteger := CodigoUsuario;
             qryDadosFiscaisAlteracaousuarioalteracao.AsInteger := UsuarioAut.CodigoUsuario;
             qryDadosFiscaisAlteracaodatahoraalteracaousuario.AsDateTime := vDataHoraAlteracao;
             qryDadosFiscaisAlteracao.Post;

             qryDadosFiscaisAlteracao.next;
           end;
         end;

       end;

       if (vListaProdutoseFiliais<>'') and
          ((qryContratossituacao.AsString = 'P') or
           (qryContratossituacao.AsString = 'N')) then
       begin
         Delete(vListaProdutoseFiliais,length(vListaProdutoseFiliais),1);
         qryProdutosDadosFiscaisAlteracao.MacroByName('ListaProdutos').AsString := vListaProdutoseFiliais;

         RefazConsultaPorNome(qryProdutosDadosFiscaisAlteracao,['contrato'],[qryContratosAlteracaonumero.AsVariant]);
         GuardarRegistroAtual(qryProdutosContratos, true);

         qryProdutosDadosFiscaisAlteracao.First;
         while not qryProdutosDadosFiscaisAlteracao.Eof do
         begin
           if qryProdutosContratos.Locate('produto;filial',
                  VarArrayOf([qryProdutosDadosFiscaisAlteracaoproduto.AsString,
                              qryProdutosDadosFiscaisAlteracaofilial.AsInteger]),[]) then
           begin
             qryProdutosDadosFiscaisAlteracao.Edit;
             qryProdutosDadosFiscaisAlteracaovendedor.AsInteger := qryProdutosContratosvendedor.AsInteger;
             qryProdutosDadosFiscaisAlteracaousuariologadoalteracao.AsInteger := CodigoUsuario;
             qryProdutosDadosFiscaisAlteracaousuarioalteracao.AsInteger := UsuarioAut.CodigoUsuario;
             qryProdutosDadosFiscaisAlteracaodatahoraalteracaousuario.AsDateTime := vDataHoraAlteracao;
           end;
           qryProdutosDadosFiscaisAlteracao.next;
         end;
         VoltarRegistroAtual(qryProdutosContratos);
       end;


       if qryContratosAlteracao.state = dsedit then
         qryContratosAlteracao.post;

       perpetrar([qryContratosAlteracao,qryProdutosContratos,qryServicosContratos,qryDadosFiscaisAlteracao,qryProdutosDadosFiscaisAlteracao,
                  qryContratosVendedores]);

       AfterPostProdutosContratos(nil);
     end;
   end;

  end;
end;

procedure TdtmConsultaContratos.dsrContratosAlteracaoDataChange(
  Sender: TObject; Field: TField);
begin
  inherited;
  if (Field = qryContratosAlteracaovendedor) or
     (Field = qryContratosAlteracaofilialvenda) or
     (Field = qryContratosAlteracaofrete_pago) or
     (Field = qryContratosAlteracaoconsideracoes) or
     (Field = qryContratosAlteracaomontagemobs) or
     (Field = qryContratosAlteracaolocalizacao) then
  begin
    if assigned(AfterPostProdutosContratos) then
      AfterPostProdutosContratos(qrycontratosAlteracao);
  end;
end;

procedure TdtmConsultaContratos.SetXped(const Value: String);
const
  SQL= 'and (Select count(*) From produtoscontratos pc '+
            'Where ct.numero = pc.contrato and '+
            'pc.xped = %s) > 0';

begin
  fXped := Value;
  if Value <> '' then qryContratos.MacroByName('XPed').Value := Format(SQL, [quotedstr(Value)])
  else                qryContratos.MacroByName('XPed').Value := ''
end;

