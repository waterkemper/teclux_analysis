function TdtmConsultaContratos.GravarDados: Boolean;
var
 vDataHoraAlteracao : TDateTime;
 UsuarioAut: TtecUsuarios;
 vListaProdutoseFiliais: String;

begin
 vListaProdutoseFiliais := '';

 result := qryContratosAlteracao.CheckRequiredFields;
 if result then
 begin
   UsuarioAut := ObterAutorizacao(taLOGIN, 'Para alteração da filial ou vendedor', ctANALISTACREDITO, '');
   if not Assigned(UsuarioAut) then
     Result:=false
   else if not UsuarioAut.AnalistaCredito then
     Result:=false;

   if result then
   begin

     vDataHoraAlteracao := now;
     GuardarRegistroAtual(qryProdutosContratos, true);
     qryprodutoscontratos.First;
     while not qryprodutoscontratos.Eof do
     begin
       if qryProdutosContratosvendedoralterado.AsBoolean then
       begin
         result := qryprodutoscontratos.CheckRequiredFields;
         if result then
         begin
           qryprodutoscontratos.Edit;
           qryProdutosContratosusuariologadoalteracao.AsInteger := CodigoUsuario;
           qryProdutosContratosusuarioalteracao.AsInteger := UsuarioAut.CodigoUsuario;
           qryProdutosContratosdatahoraalteracaousuario.AsDateTime := vDataHoraAlteracao;
           qryprodutoscontratos.Post;

           vListaProdutoseFiliais := vListaProdutoseFiliais + '(' + qryProdutosContratosproduto.AsString + ','+
                                                                    qryProdutosContratosfilial.AsString  + '),'

         end
         else
           break;
       end;
       qryprodutoscontratos.Next;
     end;
     VoltarRegistroAtual(qryProdutoscontratos);

     if result then
     begin

       if qryContratosAlteracaovendedor.AsInteger <>
          qryContratosvendedor.AsInteger then
       begin
         qryContratosAlteracao.Edit;
         qryContratosAlteracaousuariologadoalteracao.AsInteger := CodigoUsuario;
         qryContratosAlteracaousuarioalteracao.AsInteger := UsuarioAut.CodigoUsuario;
         qryContratosAlteracaodatahoraalteracaousuario.AsDateTime := vDataHoraAlteracao;
         qrycontratosAlteracao.Post;

         if (qryContratossituacao.AsString = 'P') or
            (qryContratossituacao.AsString = 'N') then
         begin
           RefazConsultaPorNome(qryDadosFiscaisAlteracao,['contrato'],[qryContratosAlteracaonumero.AsVariant]);

           qryDadosFiscaisAlteracao.first;
           while not qryDadosFiscaisAlteracao.Eof do
           begin
             qryDadosFiscaisAlteracao.edit;
             qryDadosFiscaisAlteracaovendedor.AsInteger := qryContratosAlteracaovendedor.AsInteger;
             qryDadosFiscaisAlteracaousuariologadoalteracao.AsInteger := CodigoUsuario;
             qryDadosFiscaisAlteracaousuarioalteracao.AsInteger := UsuarioAut.CodigoUsuario;
             qryDadosFiscaisAlteracaodatahoraalteracaousuario.AsDateTime := vDataHoraAlteracao;
             qryDadosFiscaisAlteracao.Post;

             qryDadosFiscaisAlteracao.next;
           end;
         end;
       end;

       if (vListaProdutoseFiliais<>'') and
          ((qryContratossituacao.AsString = 'P') or
           (qryContratossituacao.AsString = 'N')) then
       begin
         Delete(vListaProdutoseFiliais,length(vListaProdutoseFiliais),1);
         qryProdutosDadosFiscaisAlteracao.MacroByName('ListaProdutos').AsString := vListaProdutoseFiliais;

         RefazConsultaPorNome(qryProdutosDadosFiscaisAlteracao,['contrato'],[qryContratosAlteracaonumero.AsVariant]);
         GuardarRegistroAtual(qryProdutosContratos, true);

         qryProdutosDadosFiscaisAlteracao.First;
         while not qryProdutosDadosFiscaisAlteracao.Eof do
         begin
           if qryProdutosContratos.Locate('produto;filial',
                  VarArrayOf([qryProdutosDadosFiscaisAlteracaoproduto.AsString,
                              qryProdutosDadosFiscaisAlteracaofilial.AsInteger]),[]) then
           begin
             qryProdutosDadosFiscaisAlteracao.Edit;
             qryProdutosDadosFiscaisAlteracaovendedor.AsInteger := qryProdutosContratosvendedor.AsInteger;
             qryProdutosDadosFiscaisAlteracaousuariologadoalteracao.AsInteger := CodigoUsuario;
             qryProdutosDadosFiscaisAlteracaousuarioalteracao.AsInteger := UsuarioAut.CodigoUsuario;
             qryProdutosDadosFiscaisAlteracaodatahoraalteracaousuario.AsDateTime := vDataHoraAlteracao;
           end;
           qryProdutosDadosFiscaisAlteracao.next;
         end;
         VoltarRegistroAtual(qryProdutosContratos);
       end;

       perpetrar([qryContratosAlteracao,qryProdutosContratos,qryDadosFiscaisAlteracao,qryProdutosDadosFiscaisAlteracao]);
     end;
   end;
 end;
end;

