function TdtmConsultaContratos.ExisteItemProduto(Campo, codigo: String): Boolean;
const
  SQL = 'where (upper(to_ascii(%s,''latin1'')) ilike upper(to_ascii(''%s%s'',''latin1'')))';
  SQLNoCliente =
        ' Where (upper(to_ascii(%s,''latin1'')) ilike upper(to_ascii(''%s%s'',''latin1''))) or '+
       '(p.codigo in (select cp.produto '+
                     'from clientesprodutos cp '+
                     'where (upper(to_ascii(cp.produto_cliente,''latin1'')) '+
                     'ilike upper(to_ascii(''%s%s'',''latin1''))) ) )';
  SQLCodigoBarras = 'Where p.codigo in (select pcb.produto from produtoscodigobarras pcb where pcb.codigobarras = %s)';
begin
  if (campo = 'codigovisual') and ParSistema.PesquisarProdutonoCliente then
    qryConsultaProdutos.sql[8] :=  Format(SQLNoCliente, [Campo, Codigo, '%', Codigo, '%'])
  else
  if campo = 'codigobarras' then
      qryConsultaProdutos.sql[8] :=  Format(SQLCodigoBarras, [quotedstr(Codigo)])
  else
    qryConsultaProdutos.sql[8] := Format(SQL, [Campo, Codigo,'%']);

  qryConsultaProdutos.Open;
  Result := (qryConsultaprodutos.RecordCount > 0);
end;



