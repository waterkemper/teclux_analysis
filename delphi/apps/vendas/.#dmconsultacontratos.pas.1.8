procedure TdtmConsultaContratos.SetCaracteristica(const Value: String);
const
  SQL = 'and (Select count(*) '+
              'From produtoscontratos pc '+
              'Where pc.contrato = c.numero and '+
                  '(Select count(*) '+
                    'From produtos pr '+
                    'Where pr.codigo = pc.produto and '+
                         'pr.caracteristica = %s) > 0) > 0';
begin
  if Value <> '' then qryContratos.MacroByName('Caracteristica').Value := format(SQL, [Value])
  else                qryContratos.MacroByName('Caracteristica').Value := ''
end;

