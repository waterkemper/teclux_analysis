  object qryRecebimentos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select distinct r.tiporecebimento, tr.descricao, r.valortotal'
      'from recebimentos r'
      '     join tiposrecebimentos tr on r.tiporecebimento = tr.codigo'
      'where r.transacao in'
      '('
      'select distinct a.transacao'
      'from autenticacoes  a join cupons c'
      'on a.filial = c.filial'
      'and a.num_usu = c.maquina'
      'and a.num_fab = c.numeroserie'
      'and a.cro = c.intervensao'
      'and a.coo = c.numero'
      'where c.dadofiscal = :dadofiscal'
      ')'
      ''
      'order by  r.tiporecebimento, tr.descricao, r.valortotal')
    RequestLive = False
    Left = 816
    Top = 360
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'dadofiscal'
        ParamType = ptUnknown
      end>
    object qryRecebimentostiporecebimento: TIntegerField
      FieldName = 'tiporecebimento'
    end
    object qryRecebimentosdescricao: TStringField
      FieldName = 'descricao'
      Size = 100
    end
    object qryRecebimentosvalortotal: TFloatField
      FieldName = 'valortotal'
    end
  end
