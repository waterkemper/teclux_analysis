  object qryCupons: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnProgress = ShowProgress
    AfterOpen = qryCuponsAfterOpen
    AfterScroll = qryCuponsAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ECF'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Numero'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Intervencao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Emissao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Cliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cfop'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NumeroDadoFiscal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListaItemProdutos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListaProdutos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListaLotes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListaGrupos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListaClasses'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListaMarcas'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListaCondicionalPromocoes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListaCondicionalVendedores'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListaCondicionalContratos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'PesquisaporDescricao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'Select  distinct'
      '       cp.dadofiscal,'
      '       d.codigofiscal,'
      ''
      '       cp.filial,'
      '       cp.maquina,'
      '       cp.intervensao,'
      '       cp.numero,'
      ''
      '       n.serie,'
      '       n.numero as nrnota,'
      ''
      '       d.cliente,'
      '       d.tipocliente,'
      '       d.numprotocolonfe,'
      '       d.numprotocolonfse,'
      ''
      '       d.data,'
      '       d.valortotal,'
      '       false as marcar'
      ''
      ''
      'From   ((cupons cp'
      '         join ((((dadosfiscais d'
      ''
      '             left  join ((produtosdadosfiscais pdf'
      
        '                    join (produtos p left join promocoes pro on ' +
        'p.promocao = pro.codigo)'
      '                         join (((caracteristicas c'
      '                              join grupos g'
      '                              on g.codigo = c.grupo)'
      '                              join classes cl'
      '                              on cl.codigo = c.classe)'
      '                              join marcas m'
      '                              on m.codigo = c.marca)'
      '                         on p.caracteristica = c.codigo'
      '                    on pdf.produto = p.codigo)'
      '                    left join lotes l'
      '                    on pdf.lote = l.lote)'
      ''
      '               on d.numero = pdf.dadofiscal)'
      ''
      ''
      '               left join vfornecedores vf'
      '               on d.cliente = vf.codigo'
      '               and d.tipocliente = vf.tipo)'
      ''
      ''
      '              left join usuarios u'
      '              on d.vendedor = u.codigo)'
      '               '
      ''
      '              join filiais f'
      '              on d.filialemissao = f.codigo)'
      '         on cp.dadofiscal = d.numero)'
      ''
      '         left join (notas n'
      '                    join dadosfiscais df'
      '                     on n.dadofiscal = df.numero'
      
        '                        and (df.situacao is null or df.situacao ' +
        '= '#39'N'#39'))'
      ''
      '         on n.dadofiscalvinculado = cp.dadofiscal)'
      ''
      ''
      'Where (cp.dadofiscal = d.numero)'
      '  /*and (d.situacao = '#39'N'#39') */'
      ''
      '%Filial'
      '%ECF'
      '%Numero'
      '%Intervencao'
      '%Emissao'
      '%Cliente'
      '%cfop'
      '%NumeroDadoFiscal'
      ''
      '%ListaItemProdutos'
      '%ListaProdutos'
      '%ListaLotes'
      '%ListaGrupos'
      '%ListaClasses'
      '%ListaMarcas'
      '%ListaCondicionalPromocoes'
      ''
      '%ListaCondicionalVendedores'
      ''
      '%ListaCondicionalContratos'
      ''
      '%PesquisaporDescricao'
      ''
      ''
      'Order By cp.filial, cp.maquina, cp.intervensao , cp.numero desc')
    RequestLive = True
    Left = 475
    Top = 364
    object qryCuponsdadofiscal: TIntegerField
      FieldName = 'dadofiscal'
      Required = True
      DisplayFormat = '0'
    end
