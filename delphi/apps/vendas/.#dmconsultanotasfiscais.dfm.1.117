      item
        DataType = ftUnknown
        Name = 'ListaCondicionalContratos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'PesquisaporDescricao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select distinct'
      '       n.dadofiscal,'
      '       d.codigofiscal,'
      ''
      '       n.dadofiscalvinculado,'
      '       n.filial,'
      '       n.serie,'
      '       n.numero,'
      '       cp.maquina,'
      '       cp.intervensao,'
      '       cp.numero as nrcupom,'
      ''
      '       d.numprotocolonfe,'
      '       d.numcancelamentonfe,'
      '       d.numinutilizacaonfe,'
      '       d.numlotenfe,'
      '       d.numrecibonfe,'
      '       d.data,'
      '       d.email,'
      '       d.cliente,'
      '       d.tipocliente,'
      '       d.situacao,'
      '       d.valortotal,'
      '       cast(null as varchar(5)) as serievinculada,'
      '       cast(null as integer) as numerovinculada,'
      '       cast(null as date) as datavinculada,'
      ''
      '                                           /*'
      '                           MUITO LENTO NA SANTA APOLONIA'
      '      (select nv.serie'
      '       from notas nv'
      '       where  nv.dadofiscalvinculado = d.numero'
      '          or nv.dadofiscal = (select nv2.dadofiscalvinculado'
      '                              from notas nv2'
      
        '                              where nv2.dadofiscal  = d.numero))' +
        ' as serievinculada,'
      ''
      '      (select nv.numero'
      '       from notas nv'
      '       where  nv.dadofiscalvinculado = d.numero'
      '          or nv.dadofiscal = (select nv2.dadofiscalvinculado'
      '                              from notas nv2'
      
        '                              where nv2.dadofiscal  = d.numero))' +
        ' as numerovinculada,'
      ''
      '       (select dfv.data'
      '        from notas nv'
      '             join dadosfiscais dfv'
      '             on nv.dadofiscal = dfv.numero'
      '        where nv.dadofiscalvinculado = d.numero'
      '          or nv.dadofiscal = (select nv2.dadofiscalvinculado'
      '                              from notas nv2'
      
        '                              where nv2.dadofiscal  = d.numero))' +
        ' as datavinculada,'
      ''
      '                              */'
      ''
      
        '       cast(d.chv_nfe|| cast(d.digchaveacesso as varchar) as cha' +
        'r(44)) as chave_nfe,'
      ''
      '       d.numprotocolonfse,'
      '       d.statusnfse,'
      ''
      ''
      '      (select cf.codigoibge'
      '       from cidades cF'
      '       where cf.estado = f.estado'
      '         and cf.codigo = f.cidade) as CodigoCidadeIBGEFilial,'
      ''
      '       f.cnpj as CNPJFilial,'
      ''
      '       d.ambientenfs,'
      '       d.ambiente,'
      '       false as marcar'
      ''
      ''
      ''
      ''
      'From   ((notas n'
      '         join ((((dadosfiscais d'
      ''
      '             left join ((produtosdadosfiscais pdf'
      
        '                        join (produtos p left join promocoes pro' +
        ' on p.promocao = pro.codigo)'
      '                         join (((caracteristicas c'
      '                              join grupos g'
      '                              on g.codigo = c.grupo)'
      '                              join classes cl'
      '                              on cl.codigo = c.classe)'
      '                              join marcas m'
      '                              on m.codigo = c.marca)'
      '                         on p.caracteristica = c.codigo'
      '                        on pdf.produto = p.codigo)'
      ''
      '                        left join lotes l'
      '                        on pdf.lote = l.lote)'
      ''
      ''
      ''
      '               on d.numero = pdf.dadofiscal)'
      ''
      '               left join vfornecedores vf'
      '               on d.cliente = vf.codigo'
      '               and d.tipocliente = vf.tipo)'
      ''
      ''
      '              left join usuarios u'
      '              on d.vendedor = u.codigo)'
      ''
      '              join filiais f'
      '              on d.filialemissao = f.codigo)'
      '         on n.dadofiscal = d.numero)'
      ''
      '         left join cupons cp'
      '         on n.dadofiscalvinculado = cp.dadofiscal)'
      ''
      'Where (n.dadofiscal = d.numero)'
      ''
      '%Filial'
      '%Serie'
      '%Numero'
      '%ListaDadosFiscais'
      ''
      '%Emissao'
      '%Cliente'
      '%cfop'
      '%NumeroDadoFiscal'
      ''
      '%TiposdeNotas'
      '%SituacaodasNotas'
      ''
      '%ListaItemProdutos'
      '%ListaProdutos'
      '%ListaLotes'
      '%ListaGrupos'
      '%ListaClasses'
      '%ListaMarcas'
      '%ListaCondicionalPromocoes'
      ''
      '%ListaCondicionalVendedores'
      ''
      '%ListaCondicionalContratos'
      ''
      '%PesquisaporDescricao'
      ''
      ''
      'Order By n.filial, n.serie, n.numero desc')
    RequestLive = True
    Left = 112
    Top = 376
