    Constraints = <>
    BeforeOpen = qryCalculosProdutosBeforeOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select * from'
      '('
      'select cast('#39'ICMS'#39' as varchar(10)) as tipo,'
      '        incidencia, codigofiscal, base as basecalculo,'
      '        aliquota, valor, icmsvalorst as valorst, isentas,'
      '        outras, (base + isentas + outras) as total'
      'from calculosdadosfiscais_(:dadofiscal)'
      'where tipo = '#39'M'#39
      ''
      'union all'
      ''
      'select cast('#39'ICMS'#39' as varchar(10)) as tipo,'
      
        '        incidencia, codigofiscal, cast(null as numeric(11,2)) as' +
        ' basecalculo,'
      
        '        cast(null as numeric(5,2)) as aliquota, cast(null as num' +
        'eric(11,2)) as valor,'
      
        '        cast(null as numeric(11,2)) as valorst, cast(null as num' +
        'eric(11,2)) as isentas,'
      
        '        (base + isentas + outras) as outras, (base + isentas + o' +
        'utras) as total'
      'from calculosdadosfiscais_(:dadofiscal)'
      'where tipo = '#39'S'#39
      ''
      'union all'
      ''
      'select cast('#39'TOTAL ICMS'#39' as varchar(10)) as tipo,'
      '        cast(null as varchar(4)) as incidencia,'
      #9#9'cast(null as integer) as codigofiscal,'
      '        sum(base) as basecalculo,'
      '        cast(null as numeric(5,2)) as aliquota,'
      #9#9'sum(valor) as valor,'
      #9#9'sum(icmsvalorst) as valorst,'
      '        sum(isentas) as isentas,'
      ''
      '        sum(outras) +'
      '           coalesce((select sum(base+isentas+outras)'
      '            from calculosdadosfiscais_(:dadofiscal)'
      '            where tipo = '#39'S'#39'),0) as outras,'
      ''
      '        sum(base + isentas + outras) +'
      '           coalesce((select sum(base+isentas+outras)'
      '            from calculosdadosfiscais_(:dadofiscal)'
      '            where tipo = '#39'S'#39'),0)'
      ''
      '         as total'
      ''
      'from calculosdadosfiscais_(:dadofiscal)'
      'where tipo = '#39'M'#39
      ''
      'union all'
      ''
      'select cast('#39'IPI'#39' as varchar(10)) as tipo,'
      '        incidencia, codigofiscal, base as basecalculo,'
      '        aliquota, valor, icmsvalorst as valorst, isentas,'
      '        outras, (base + isentas + outras + valor) as total'
      'from calculosdadosfiscais_(:dadofiscal)'
      'where tipo = '#39'P'#39
      ''
      'union all'
      ''
      'select cast('#39'TOTAL IPI'#39' as varchar(10)) as tipo,'
      '        cast(null as varchar(4)) as incidencia,'
      #9#9'cast(null as integer) as codigofiscal,'
      '        sum(base) as basecalculo,'
      '        cast(null as numeric(5,2)) as aliquota,'
      #9#9'sum(valor) as valor,'
      #9#9'cast(null as numeric(11,2)) as valorst,'
      '        sum(isentas) as isentas,'
      '        sum(outras) as outras,'
      '        sum(base + isentas + outras + valor) as total'
      ''
      'from calculosdadosfiscais_(:dadofiscal)'
      'where tipo = '#39'P'#39
      ''
      'union all'
      ''
      'select cast('#39'ISS'#39' as varchar(10)) as tipo,'
      '        incidencia, codigofiscal, base as basecalculo,'
      '        aliquota, valor, icmsvalorst as valorst, isentas,'
      '        outras, (base + isentas + outras) as total'
      'from calculosdadosfiscais_(:dadofiscal)'
      'where tipo = '#39'S'#39
      ''
      'union all'
      ''
      'select cast('#39'ISS'#39' as varchar(10)) as tipo,'
      
        '        incidencia, codigofiscal, cast(null as numeric(11,2)) as' +
        ' basecalculo,'
      
        '        cast(null as numeric(5,2)) as aliquota, cast(null as num' +
        'eric(11,2)) as valor,'
      
        '        cast(null as numeric(11,2)) as valorst, cast(null as num' +
        'eric(11,2)) as isentas,'
      
        '        (base + isentas + outras) as outras, (base + isentas + o' +
        'utras) as total'
      'from calculosdadosfiscais_(:dadofiscal)'
      'where tipo = '#39'M'#39
      ' and :contribiss '
      ''
      'union all'
      ''
      'select cast('#39'TOTAL ISS'#39' as varchar(10)) as tipo,'
      '        cast(null as varchar(4)) as incidencia,'
      #9#9'cast(null as integer) as codigofiscal,'
      '        sum(base) as basecalculo,'
      '        cast(null as numeric(5,2)) as aliquota,'
      #9#9'sum(valor) as valor,'
      #9#9'sum(icmsvalorst) as valorst,'
      '        sum(isentas) as isentas,'
      ''
      '        sum(outras) +'
      '           (select sum(base+isentas+outras)'
      '            from calculosdadosfiscais_(:dadofiscal)'
      '            where tipo = '#39'M'#39') as outras,'
      ''
      '        sum(base + isentas + outras) +'
      '           (select sum(base+isentas+outras)'
      '            from calculosdadosfiscais_(:dadofiscal)'
      '            where tipo = '#39'M'#39')'
      ''
      '         as total'
      ''
      'from calculosdadosfiscais_(:dadofiscal)'
      'where tipo = '#39'S'#39
      ') as selecao where coalesce(total,0)<>0')
    RequestLive = True
    Left = 480
    Top = 584
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'dadofiscal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'contribiss'
        ParamType = ptUnknown
      end>
