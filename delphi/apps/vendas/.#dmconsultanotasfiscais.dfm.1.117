  object qryProdutosDadosFiscais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryProdutosDadosFiscaisAfterOpen
    AfterClose = qryProdutosDadosFiscaisAfterScroll
    AfterInsert = qryProdutosDadosFiscaisAfterInsert
    AfterScroll = qryProdutosDadosFiscaisAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select  pf.*,'
      '        trunc(pf.quantidade * pf.precovenda,2) as precototal,'
      '        p.preco,'
      '        p.descricao as produtodescricao,'
      '        p.referencia,'
      
        '        (select g.descricao from grades g where g.codigo = c.gra' +
        'de1) as linha,'
      
        '        (select g.descricao from grades g where g.codigo = c.gra' +
        'de2) as coluna,'
      '        p.valorgrade1,'
      '        p.valorgrade2,'
      '        m.descricao as marcadescricao,'
      '        p.codigovisual,'
      
        '        (select u.nome from usuarios u where u.codigo = pf.vende' +
        'dor) as nomevendedor,'
      ''
      '        (select cp.produto_cliente'
      '         from clientesprodutos cp'
      '         where pf.produto = cp.produto'
      '           and cp.cliente = df.cliente'
      
        '           and cp.tipocliente = df.tipocliente) as produto_clien' +
        'te,'
      ''
      ''
      '    /*'
      '        np.fornecedor,'
      '        np.tipofornecedor,'
      '        np.serie,'
      '        np.numero as numeroentrada,'
      '        np.data,'
      '        np.chv_nfe,'
      '        */'
      ''
      ''
      
        '       (select np.fornecedor from notaspag np where np.codigo = ' +
        'pf.codigonota) as fornecedor,'
      
        '       (select np.tipofornecedor from notaspag np where np.codig' +
        'o = pf.codigonota) as tipofornecedor,'
      
        '       (select np.serie from notaspag np where np.codigo = pf.co' +
        'digonota) as serie,'
      
        '       (select np.numero from notaspag np where np.codigo = pf.c' +
        'odigonota) as numeroentrada,'
      
        '       (select np.data from notaspag np where np.codigo = pf.cod' +
        'igonota) as data,'
      
        '       (select np.chv_nfe from notaspag np where np.codigo = pf.' +
        'codigonota) as chv_nfe,'
      ''
      ''
      '          /*'
      '        cast((select string_agg(pdfs.numeroserie, '#39', '#39')'
      '         from produtosdadosfiscaisseries pdfs'
      '         where pdfs.dadofiscal = pf.dadofiscal'
      '           and pdfs.numero = pf.numero'
      '           and pdfs.produto = pf.produto'
      
        '         order by pf.numero) as varchar(1000)) as ListaNumeroSer' +
        'ies,'
      '         */'
      ''
      '        cast(rtrim((select textcat_all(pdfs.numeroserie||'#39', '#39')'
      '        from produtosdadosfiscaisseries pdfs'
      '        where pdfs.dadofiscal = pf.dadofiscal'
      '          and pdfs.numero = pf.numero'
      '          and pdfs.produto = pf.produto'
      
        '        order by pf.numero),'#39', '#39') as varchar(1000)) as ListaNume' +
        'roSeries,'
      ''
      '        l.nrlote,'
      '        l.fabricacao,'
      '        l.validade'
      ''
      ''
      ''
      ''
      'From  produtosdadosfiscais pf'
      '       join (produtos p'
      '            join (caracteristicas c'
      '                  left join  marcas m'
      '                  on  c.marca = m.codigo)'
      '            on  p.caracteristica = c.codigo)'
      '       on  pf.produto = p.codigo'
      ''
      '       join dadosfiscais df'
      '       on pf.dadofiscal = df.numero'
      ''
      '       left join lotes l'
      '       on pf.lote = l.lote'
      ''
      '       /*'
      '       left join notaspag np'
      '       on pf.codigonota = np.codigo)'
      '       */'
      ''
      'Where  pf.dadofiscal = :dadofiscal'
      'order by pf.numero'
      ''
      ''
      '')
    RequestLive = True
    Left = 483
    Top = 254
    ParamData = <
      item
        DataType = ftString
        Name = 'dadofiscal'
        ParamType = ptUnknown
        Value = '0'
      end>
