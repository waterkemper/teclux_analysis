  object qryCuponsNotaVinculada: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnProgress = ShowProgress
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'Select c.dadofiscal,'
      '       d.codigofiscal,'
      ''
      '       c.filial,'
      '       c.maquina,'
      '       c.intervensao,'
      '       c.numero,'
      ''
      '       n.serie,'
      '       n.numero as nrnota'
      '       '
      'From   ((cupons c'
      '         join dadosfiscais d'
      '         on c.dadofiscal = d.numero)'
      '         left join (notas n'
      '                    join dadosfiscais df'
      '                    on n.dadofiscal = df.numero'
      
        '                       and (df.situacao is null or df.situacao =' +
        ' '#39'N'#39'))'
      '         on c.dadofiscal = n.dadofiscalvinculado)'
      ''
      'where c.dadofiscal = :dadofiscal'
      ''
      ''
      '')
    RequestLive = False
    Left = 819
    Top = 572
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'dadofiscal'
        ParamType = ptUnknown
      end>
