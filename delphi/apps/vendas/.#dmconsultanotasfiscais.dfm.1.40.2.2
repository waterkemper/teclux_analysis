    AfterScroll = qryDadosFiscaisAfterScroll
    OnCalcFields = qryDadosFiscaisCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select df.*,'
      '       c.nome as cidadenome,'
      '       b.nome as bairronome,'
      '       p.descricao as planodescricao,'
      '       u.nome as nomevendedor,'
      '       f.razao as razaofornecedortransporte,'
      '       filiais.nome as nomefilialvenda,'
      '       (df.valortotal - df.valorvista) as acrescimo,'
      ''
      '       coalesce(df.valorprodutos,0)+'
      '       (coalesce(df.valortotal,0) -'
      '        coalesce(df.valorvista,0)) -'
      '       coalesce(df.desconto,0) as totalprodutos,'
      ''
      '       df.valorservicos as TotalServico,'
      ''
      '       coalesce(v.razao,v.nome) as nomecliente,'
      '      df.BaseICMS,'
      '      df.ValorICMS,'
      '      0.00 as ImpRetidos,'
      '      ct.situacao as situacaocontrato,'
      '      cast (case when ct.situacao = '#39'O'#39' then '#39'OR'#199'ADO'#39
      '                        when ct.situacao = '#39'R'#39' then '#39'RESERVADO'#39
      '                        when ct.situacao = '#39'F'#39' then '#39'FATURADO'#39
      
        '                        when ct.situacao = '#39'P'#39' then '#39'NOTA PARCIA' +
        'L'#39
      
        '                        when ct.situacao = '#39'N'#39' then '#39'NOTA FISCAL' +
        #39
      '                        when ct.situacao = '#39'C'#39' then '#39'CANCELADO'#39
      '             end as varchar) as NomeSituacaoContrato,'
      
        '      cast(df.chv_nfe||cast(df.digchaveacesso as varchar) as cha' +
        'r(44)) as chave_nfe,'
      ''
      '      (select cf.codigoibge'
      '       from cidades cF'
      '       where cf.estado = filiais.estado'
      
        '         and cf.codigo = filiais.cidade) as CodigoCidadeIBGEFili' +
        'al,'
      ''
      '       filiais.cnpj as CNPJFilial,'
      ''
      
        '       (select sum(pdf.vBCSTRet) from produtosdadosfiscais pdf w' +
        'here pdf.dadofiscal = df.numero) as vBCSTRet,'
      
        '       (select sum(pdf.vICMSSTRet) from produtosdadosfiscais pdf' +
        ' where pdf.dadofiscal = df.numero) as vICMSSTRet'
      ''
      ''
      
        'From dadosfiscais df join filiais on df.filialvenda = filiais.co' +
        'digo'
      '     left join usuarios u on ( df.vendedor = u.codigo )'
      '     left join planos p on ( df.plano = p.codigo )'
      
        '     left join fornecedores f on ( df.fornecedortransporte = f.c' +
        'odigo )'
      
        '     left join vfornecedores v on ((df.cliente = v.codigo) and (' +
        'df.tipocliente = v.tipo))'
      '     left join cidades c on ( (df.estado = c.estado) and'
      
        '                                             (df.cidade = c.codi' +
        'go) )'
      '     left join bairros b on ( (df.estado = b.estado) and'
      
        '                                            (df.cidade = b.cidad' +
        'e) and'
      
        '                                            (df.bairro = b.codig' +
        'o) )'
      '     left join contratos ct on df.contrato = ct.numero'
      'Where'
      '           df.numero = :numero')
    RequestLive = True
    Left = 111
    Top = 254
    ParamData = <
      item
        DataType = ftInteger
        Name = 'numero'
        ParamType = ptUnknown
      end>
