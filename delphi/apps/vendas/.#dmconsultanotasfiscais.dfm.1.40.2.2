    Macros = <>
    Sql.Strings = (
      'select /*coalesce(pdf.piscst,(select c.piscst'
      '                            from caracteristicas c'
      '                                 join produtos p'
      '                                 on c.codigo = p.caracteristica'
      
        '                            where p.codigo = pdf.produto)) as pi' +
