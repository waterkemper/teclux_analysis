procedure TdtmConsultaNotasFiscais.dsrDadosFiscaisDataChange(
  Sender: TObject; Field: TField);
var
 vDataHoraAlteracao : TDateTime;
 UsuarioAut: TtecUsuarios;
begin
  inherited;
  if field = qryDadosFiscaiscliente then
  begin

    qryDadosFiscaistipocliente.AsString  := qryProcurarClientesDadosFiscaistipo.AsString;
    qryDadosFiscaispessoanumero.AsString := qryProcurarClientesDadosFiscaispessoanumero.AsString;
    qryDadosFiscaisdocumento.AsString    := qryProcurarClientesDadosFiscaisinscricaoestadual.AsString;
    qryDadosFiscaisestadocfo.AsString    := qryProcurarClientesDadosFiscaisestado.AsString;
    qryDadosFiscaisnome.AsString         := qryProcurarClientesDadosFiscaisnome.AsString;

    qryDadosFiscaisrua.AsString          := qryProcurarClientesDadosFiscaisrua.AsString;
    qryDadosFiscaisendnumero.AsString          := qryProcurarClientesDadosFiscaisnumero.AsString;
    qryDadosFiscaisendcomplemento.AsString          := qryProcurarClientesDadosFiscaiscomplemento.AsString;

    qryDadosFiscaisbairro.AsString := qryProcurarClientesDadosFiscaisbairro.AsString;
    qryDadosFiscaisbairronome.AsString := qryProcurarClientesDadosFiscaisnomebairro.AsString;

    qryDadosFiscaiscidade.AsString := qryProcurarClientesDadosFiscaiscidade.AsString;
    qryDadosFiscaiscidadenome.AsString := qryProcurarClientesDadosFiscaisnomecidade.AsString;

    qryDadosFiscaisestado.AsString := qryProcurarClientesDadosFiscaisestado.AsString;

    qryDadosFiscaiscep.AsString    := qryProcurarClientesDadosFiscaiscep.AsString;

    qryDadosFiscaispessoatipo.AsString := qryProcurarClientesDadosFiscaispessoatipo.AsString;

    qryDadosFiscaisfonenumero.AsString := qryProcurarClientesDadosFiscaisfonenumero.AsString;

    qryDadosFiscaisfoneddd.AsString    := qryProcurarClientesDadosFiscaisfoneddd.AsString;

    VerificarDadosCliente;

  end
  else
  if field = qryDadosFiscaisVendedor then
  begin
    if qryDadosFiscaisVendedor.asinteger <> qryDadosFiscaisVendedor_original.asInteger then
    begin
      UsuarioAut := ObterAutorizacao(taLOGIN, 'Para alteração do vendedor', ctANALISTACREDITO, '');
      if Assigned(UsuarioAut) and
         UsuarioAut.AnalistaCredito then
      begin
        vDataHoraAlteracao := now;

        qryDadosFiscaisVendedor_original.asInteger := qryDadosFiscaisVendedor.asinteger;
        qryDadosFiscaisusuariologadoalteracao.AsInteger := CodigoUsuario;
        qryDadosFiscaisusuarioalteracao.AsInteger := UsuarioAut.CodigoUsuario;
        qryDadosFiscaisdatahoraalteracaousuario.AsDateTime := vDataHoraAlteracao;

        AtribuirDados(qryProdutosDadosFiscais,
                      [qryProdutosDadosFiscaisvendedor, qryProdutosDadosFiscaisNomeVendedor,
                       qryProdutosDadosFiscaisusuariologadoalteracao,
                       qryProdutosDadosFiscaisusuarioalteracao,
                       qryProdutosDadosFiscaisdatahoraalteracaousuario],

                      [qryDadosFiscaisvendedor.AsInteger,
                       qryProcuraVendedorContrato.fieldbyname('nome').asString,
                       CodigoUsuario, UsuarioAut.CodigoUsuario, vDataHoraAlteracao]);

      end
      else
      begin
        if qryDadosFiscaisVendedor.asinteger <> qryDadosFiscaisVendedor_original.asInteger then
        begin
          dsrDadosFiscais.onDataChange := nil;
          qryProcuraVendedorContrato.parambyname('codigo').asinteger := qryDadosFiscaisVendedor_original.asInteger;
          qryDadosFiscaisVendedor.asinteger := qryDadosFiscaisVendedor_original.asInteger;
          qryProcuraVendedorContrato.close;
          qryProcuraVendedorContrato.open;
          dsrDadosFiscais.onDataChange := dsrDadosFiscaisDataChange;
        end;
      end;
    end;
  end;
end;

procedure TdtmConsultaNotasFiscais.AcertarCasasDecimais;
begin
  case ParSistema.PrecoUnitarioCasasDecimais of
    2: qryProdutosDadosFiscaisprecovenda.DisplayFormat:= '###,###,##0.00';
    3: qryProdutosDadosFiscaisprecovenda.DisplayFormat:= '###,###,##0.000';
    4: qryProdutosDadosFiscaisprecovenda.DisplayFormat:= '###,###,##0.0000';
    5: qryProdutosDadosFiscaisprecovenda.DisplayFormat:= '###,###,##0.00000';
    6: qryProdutosDadosFiscaisprecovenda.DisplayFormat:= '###,###,##0.000000';
    7: qryProdutosDadosFiscaisprecovenda.DisplayFormat:= '###,###,##0.0000000';
    8: qryProdutosDadosFiscaisprecovenda.DisplayFormat:= '###,###,##0.00000000';
  end;
end;

procedure TdtmConsultaNotasFiscais.ZMonitor1MonitorEvent(Sql,
  Result: String);
var
 Listar : TStringList;
begin
  inherited;
  Listar := tStringlist.create;
  if fileexists('c:\lognota150109.sql') then
    Listar.loadfromfile('c:\lognota150109.sql');
  Listar.add('');
  Listar.add(sql);
  Listar.add(result);
  listar.savetofile('c:\lognota150109.sql');
  listar.free;
end;

procedure TdtmConsultaNotasFiscais.ImprimirNFe(Impressora: String);
var
//  NFe : TTecNotaFiscalEletronica;
//  vProdutosDadosFiscais : TtecQuery;
  ControleNFe: TdtmControleNotasFiscaisEletronicas;

begin
//  NFe                  := TTecNotaFiscalEletronica.Create;
//  NFe.DiretorioCompartilha := NFeDirCompartilha;
//  NFe.DiretorioEnviado := NFeDirEnviados;
//  try

{
    if consultar='C' then
    begin
      RefazConsultaPorNome(qryProdutosDadosFiscaisNotaVinculada, ['dadofiscal'], [qrydadosfiscaisnumero.asinteger]);
      vProdutosDadosFiscais := qryProdutosDadosFiscaisNotaVinculada;
    end
    else
      vProdutosDadosFiscais := qryProdutosDadosFiscais;
}

    try
      ControleNFe := TdtmControleNotasFiscaisEletronicas.Create(nil);
      ControleNFE.ImpressoraDanfe := Impressora;
      if ControleNFe.SelecionarNotas(1,3,qryDadosFiscaisnumero.asInteger, (Consultar='C')) then
        if ControleNFe.EnviarNotasFiscais(qryNotasNFE_Calculada.asstring) then
        begin

          if ControleNFe.qryDadosFiscais.fieldbyname('nfpse').asBoolean then
          begin

            if ((qryDadosFiscaisnumprotocolonfse.AsString = '') and
                (ControleNFe.qrydadosfiscais.FieldByName('numprotocolonfse').asString<>'')) or
                (qryDadosFiscaisstatusnfse.asString <> ControleNFe.qrydadosfiscais.FieldByName('statusnfse').asString) then
            begin

              qryDadosFiscais.ReadOnly := False;
              qrydadosfiscais.Edit;
              qryDadosFiscaisnumprotocolonfse.AsString := ControleNFe.qrydadosfiscais.FieldByName('numprotocolonfse').asString;
              qryDadosFiscaisstatusnfse.AsString := ControleNFe.qrydadosfiscais.FieldByName('statusnfse').asString;
              qryDadosFiscaissituacao.AsString := ControleNFe.qrydadosfiscais.FieldByName('situacao').asString;

              qrydadosfiscais.post;
            end;

            if ((qryNotasnumprotocolonfse.AsString = '') and
                (ControleNFe.qrydadosfiscais.FieldByName('numprotocolonfse').asString<>'')) or
                (qryNotasstatusnfse.asString <> ControleNFe.qrydadosfiscais.FieldByName('statusnfse').asString) then
            begin

              qrynotas.Edit;
              qryNotasnumprotocolonfse.AsString := ControleNFe.qrydadosfiscais.FieldByName('numprotocolonfse').asString;
              qryNotasstatusnfse.AsString := ControleNFe.qrydadosfiscais.FieldByName('statusnfse').asString;
              qryNotassituacao.AsString := ControleNFe.qrydadosfiscais.FieldByName('situacao').asString;

              qrynotas.post;

              qryDadosFiscais.ReadOnly := true
            end;

          end
          else
          begin
            if (qryDadosFiscaisnumprotocolonfe.AsString = '') and (ControleNFe.Protocolo<>'') then
            begin

              qryDadosFiscais.ReadOnly := False;
              qrydadosfiscais.Edit;
              qryDadosFiscaisnumprotocolonfe.AsString := ControleNFe.Protocolo;
              qryDadosFiscaisnumcancelamentonfe.AsString := ControleNFe.ProtocoloCancelamento;

              qryDadosFiscaisstatusnfe.AsString := ControleNFe.status;
              if (qryDadosFiscaisstatusnfe.AsString = '301') or    //denegada emitente
                 (qryDadosFiscaisstatusnfe.AsString = '302') then  //denegada destinatario
                qryDadosFiscaissituacao.AsString := 'D';

              if (qryDadosFiscaischave_nfe.AsString = '') then
                qryDadosFiscaischave_nfe.AsString := ControleNFe.vchave_nfe;

              qrydadosfiscais.post;

              qrynotas.Edit;
              qryNotasnumprotocolonfe.AsString := ControleNFe.Protocolo;
              qryNotasnumcancelamentonfe.AsString := ControleNFe.ProtocoloCancelamento;
              if (qryNotaschave_nfe.AsString = '') then
                qryNotaschave_nfe.AsString := ControleNFe.vchave_nfe;
              qrynotas.post;

              qryDadosFiscais.ReadOnly := true
            end;

          end;
        end;
    finally
      FreeAndNil(ControleNFe);
    end;

//  finally
//    FreeAndNil(NFe);
//  end;
end;

procedure TdtmConsultaNotasFiscais.ImprimirEspelhoNota;
begin
  dtmImprimeFiscalGrafica := TdtmImprimeFiscalGrafica.Create(self);
  try
    with dtmImprimeFiscalGrafica.Nota do
    begin
      Tipo              := nfSAIDA;
      Filial            := qryNotasfilial.AsInteger;
      Serie             := qryNotasserie.AsString;
      Numero            := qryNotasnumero.AsInteger;
      NaturezaDescricao := qryDadosFiscaisnatureza.AsString;
      CodigoFiscal      := qryDadosFiscaiscodigofiscal.AsInteger;
      CNPJ              := CNPJFilialBase;
      IE                := InscricaoEstadualFilialBase;
      IEST              := qryDadosFiscaisiesubsttributario.AsString;
      Data              := qryDadosFiscaisdata.AsDateTime;
      DataSaida         := qryDadosFiscaisdatasaida.AsDateTime;
      InfComplementares := qryDadosFiscaisobservacoes.AsString;
      codigovendedor    := qryDadosFiscaisvendedor.AsString;
      nomevendedor      := qryDadosFiscaisnomevendedor.asstring;

      if qryDadosFiscaisfrete.AsString = '1' then
        TipoFrete       := tfEmitente
      else
        TipoFrete       := tfDestinatario;

      with Cliente do
      begin
        CNPJ := qryDadosFiscaispessoanumero.AsString;
        IE   := qryDadosFiscaisdocumento.AsString;
        Nome := qryDadosFiscaisnome.AsString;
        Rua  := qryDadosFiscaisrua.AsString;
        Numero := qryDadosFiscaisendnumero.AsInteger;
        Complemento := qryDadosFiscaisendcomplemento.AsString;
        CEP := qryDadosFiscaiscep.AsInteger;
        NomeBairro := qryDadosFiscaisbairronome.AsString;
        NomeCidade := qryDadosFiscaiscidadenome.AsString;
        Estado := qryDadosFiscaisestado.AsString;
        FoneDDD := qryDadosFiscaisfoneddd.AsInteger;
        FoneNumero := qryDadosFiscaisfonenumero.AsInteger;
        codigo     := qryDadosFiscaiscliente.AsInteger;
        tipo := qryDadosFiscaistipocliente.AsString;
      end;

      with Totais do
      begin
        IPI        := qryDadosFiscaisvaloripi.AsFloat;
        ICMSBase   := qryDadosFiscaisbaseicms.AsFloat;
        ICMS       := qryDadosFiscaisvaloricms.AsFloat;
        ICMSSTBase := qryDadosFiscaistotalbaseicmssubstituicao.AsFloat;
        ICMSST     := qryDadosFiscaistotalvaloricmssubstituicao.AsFloat;
        Frete      := qryDadosFiscaisvalorfrete.AsFloat;
        Seguro     := qryDadosFiscaisseguro.AsFloat;
        Desconto   := qryDadosFiscaisdesconto.AsFloat;
        Produtos   := qryDadosFiscaisvalorprodutos.AsFloat + qryDadosFiscaistotalservico.AsFloat;
        Prazo      := qryDadosFiscaisvalortotal.AsFloat;
        DespesasAcessorias := qryDadosFiscaisdespesasacessorias.AsFloat;
      end;

      with Transporte do
      begin
        CNPJ        := qryDadosFiscaistransportadora_cnpj.AsString;
        IE          := qryDadosFiscaistransportadora_ie.AsString;
        Nome        := qryDadosFiscaistransportadora_nome.AsString;
        Rua         := qryDadosFiscaistransportadora_rua.AsString;
        NomeCidade  := qryDadosFiscaistransportadora_nomecidade.AsString;
        Estado      := qryDadosFiscaistransportadora_estado.AsString;
        Placa       := qryDadosFiscaisplaca.AsString;
        EstadoPlaca := qryDadosFiscaisestadoplaca.AsString;
        Quantidade  := qryVolumesDadosFiscaisvolumes.AsInteger;
        Especie     := qryVolumesDadosFiscaisespecietransporte.AsString;
        Marca       := qryVolumesDadosFiscaismarca.AsString;
        Numero      := qryVolumesDadosFiscaisnumeracao.AsString;
        PesoBruto   := qryVolumesDadosFiscaispesobruto.AsFloat;
        PesoLiquido := qryVolumesDadosFiscaispesoliquido.AsFloat;
      end;

      //VENCTOS
//      i := 0;
      GuardarRegistroAtual(qryVenctosDadosFiscais,true);
      try
        qryVenctosDadosFiscais.First;
        while not qryVenctosDadosFiscais.Eof do
        begin
          with Venctos.Add do
          begin;
            Numero := qryVenctosDadosFiscaisnumero.AsInteger;
            Data   := qryVenctosDadosFiscaisdatavencto.AsDateTime;
            Valor  := qryVenctosDadosFiscaisvalorvencto.AsFloat;
//            Inc(i);
          end;
          qryVenctosDadosFiscais.Next;
        end;
      finally
        VoltarRegistroAtual(qryVenctosDadosFiscais);
      end;

      //PRODUTOS
//      i := 0;
      GuardarRegistroAtual(qryProdutosDadosFiscais,true);
      try
        qryProdutosDadosFiscais.First;
        while not qryProdutosDadosFiscais.Eof do
        begin
          with Produtos.Add do
          begin
            CodigoVisual        := qryProdutosDadosFiscaiscodigovisual.AsString;
            Descricao           := qryProdutosDadosFiscaisprodutodescricao.AsString;
            Referencia          := qryProdutosDadosFiscaisreferencia.AsString;
            ClassificacaoFiscal := qryProdutosDadosFiscaisclassificacaofiscal.AsString;
            Origem              := qryProdutosDadosFiscaisorigem.AsString;
            Incidencia          := qryProdutosDadosFiscaisincidencia.AsString;
            CodigoFiscal        := qryProdutosDadosFiscaiscodigofiscal.AsInteger;
            Unidade             := qryProdutosDadosFiscaisunidade.AsString;
            Quantidade          := qryProdutosDadosFiscaisquantidade.AsFloat;
            PrecoUnitario       := qryProdutosDadosFiscaisprecovenda.AsFloat;
            PrecoTotal          := qryProdutosDadosFiscaisprecototal.AsFloat;
            BaseCalculoICMS     := qryProdutosDadosFiscaisicmsbasecalculo.AsFloat;
            ValorICMS           := qryProdutosDadosFiscaisicmsvalor.AsFloat;
            ValorIPI            := qryProdutosDadosFiscaisvaloripi.AsFloat;
            AliquotaICMS        := qryProdutosDadosFiscaisaliquotaicms.AsFloat;
            AliquotaIPI         := qryProdutosDadosFiscaisaliquotaipi.AsFloat;
//            Inc(i);
          end;
          qryProdutosDadosFiscais.Next;
        end;
      finally
        VoltarRegistroAtual(qryProdutosDadosFiscais);
      end;
    end;
    dtmImprimeFiscalGrafica.ImprimirNota;
  finally
    dtmImprimeFiscalGrafica.Free;
  end;
end;

function TdtmConsultaNotasFiscais.VerificarSerieFilial: Boolean;
begin
  ReFazConsulta(qrySeriesFiliais, [0, 1], [FilialBase, SerieSugestao]);
  if qrySeriesFiliais.RecordCount = 0 then begin
    MensagemAviso(format(ctFILIALSEMSERIE, [FilialBase, 'mercadorias']));
    Result := False;
  end else if not ParSistema.EmissorNfe and qrySeriesFiliaismodelonota.IsNull then begin
    MensagemAviso(ctSERIESUGESTAOSEMMODELO);
    Result := False;
  end else
    Result := True;
end;

function TdtmConsultaNotasFiscais.GerarNFe(Impressora: String): boolean;
begin
  result := GravarNotaVinculada;
end;


function TdtmConsultaNotasFiscais.EmitirNFe(Validando: Boolean): Boolean;
var
//  NFe : TTecNotaFiscalEletronica;
  LoteNFe, ReciboNFe, ProtocoloNFe, status, DataHoraProcessamento, ChaveAcesso: String;


begin
  if not (qryDadosFiscaisNotaVinculada.state in [dsedit]) then
    qryDadosFiscaisNotaVinculada.Edit;

  qryDadosFiscaisNotaVinculadaversaolayout.AsCurrency := 3.10;
  if qryDadosFiscaisNotaVinculadamodelodocto.IsNull then
    qryDadosFiscaisNotavinculadamodelodocto.AsString  := '55';

  qryDadosFiscaisNotaVinculadanrdocumento.AsInteger := qryNotaVinculadanumero.AsInteger;
 {1-Normal/ 2-Contingência}
  qryDadosFiscaisNotaVinculadaformaemissao.AsInteger    := NFeTipoEmissao;

  { 1-Retrato/ 2-Paisagem }
  qryDadosFiscaisNotaVinculadaformatodanfe.AsInteger    := 1;

  { 0 – pagamento à vista   1 – pagamento à prazo     2 - outros }
  qryDadosFiscaisNotaVinculadaformapagto.AsInteger      := 2;

  qryDadosFiscaisNotaVinculadacodaleatorio.AsInteger    := Aleatorio(qryDadosFiscaisNotaVinculadadata.AsDateTime, qryDadosFiscaisNotaVinculadanrdocumento.asString);


  ChaveAcesso :=
           copy(CodigoCidadeIBGEFilialBase,1,2)+                       // 2
           FormatDateTime('YYMM',qryDadosFiscaisNotaVinculadadata.AsDateTime)+      // 4
           preencheString(CNPJFilialBase,'0',14,false) +
           preencheString(qryDadosFiscaisNotaVinculadamodelodocto.AsString,'0',2,false)+ // 2
           preencheString(SerieSugestao,'0',3,false)+                  // 3
           preencheString(qryDadosFiscaisNotaVinculadanrdocumento.Asstring,'0',9,false) + // 9
           qryDadosFiscaisNotaVinculadaformaemissao.AsString + //1
           preencheString(qryDadosFiscaisNotaVinculadacodaleatorio.Asstring,'0',8,false);  // 8


  qryDadosFiscaisNotaVinculadadigchaveacesso.AsString   := Modulo11(ChaveAcesso);
  qryDadosFiscaisNotaVinculadachv_nfe.AsString := ChaveAcesso + qryDadosFiscaisNotaVinculadadigchaveacesso.AsString;

  {1 - PRODUÇÃO 2 - HOMOLOGAÇÃO}
  qryDadosFiscaisNotaVinculadaambiente.AsInteger         := NFeAmbiente;// '2';

  {1 - normal 2 - compelementar}
  qryDadosFiscaisNotaVinculadafinalidadenf.AsInteger  := 1;

  qryDadosFiscaisNotaVinculadatipodescsubtotal.AsString:='V';
  qryDadosFiscaisNotaVinculadatipoacrescsubtotal.AsString:='V';
  qryDadosFiscaisNotaVinculadacancacrescsubtotal.AsCurrency:=0.00;
  qryDadosFiscaisNotaVinculadaordemaplicdesc_e_acresc.AsString:='D';


  qryDadosFiscaisNotaVinculadaprocemissao.AsString      := '0';
  qryDadosFiscaisNotaVinculadaversaoteclux.AsString     := VersaoTecLUX;

  qryDadosFiscaisNotaVinculadainfcomplementar.AsString := 'MD5: '+ ParSistema.codigomd5 + ' ' + sLineBreak +
                                                          ctREFERENTECUPOMFISCAL + ' ' + qrycuponsnumero.asstring+ ' ' +  sLineBreak +
                                                          qryDadosFiscaisNotaVinculadaobservacoes.AsString + ' ' + sLineBreak +
                                                          qryDadosFiscaisNotaVinculadaobservacoesicmssubstituido.AsString;




//  if qryProcurarClientesDadosFiscaisnosimples.AsBoolean then
    if (regimetributario = 1) and //simples
       (parsistema.obsnfeClientesnoSimples <> '') then
    qryDadosFiscaisNotaVinculadainfcomplementar.AsString := qryDadosFiscaisNotaVinculadainfcomplementar.AsString + ' ' +  sLineBreak +
                                               parsistema.obsnfeClientesnoSimples;

  if qrydadosfiscaisNotaVinculada.state in [dsinsert, dsedit] then
    qryDadosFiscaisNotaVinculada.Post;

  if not validando then
    NFe := TTecNotaFiscalEletronica.Create
  else
    NFe := TTecNotaFiscalEletronica.Create(dtmTecSoft.Database);

    {
  NFe.DiretorioEnvio       := NFeDirEnvio;
  NFe.DiretorioEnviado     := NFeDirEnviados;
  NFe.DiretorioRetorno     := NFeDirRetorno;
  NFe.DiretorioCompartilha := NfeDirCompartilha;
  NFe.Executavel           := NFeExecNFe;
  }

  try
    try
      if not Validando then
      begin
        ShowProcessando('Gerando o arquivo da NF-e!');
        Sleep(500);
      end;
      // EMITENTE
      NFe.Emit_Documento := CNPJFilialBase;
      NFe.Emit_Nome      := RazaoFilialBase;
      NFe.Emit_Rua       := RuaSemNumeroFilialBase;
      NFe.Emit_Nro       := NumeroFilialBase;
      NFe.Emit_Compl     := ComplementoFilialBase;
      NFe.Emit_Bairro    := BairroFilialBase;
      NFe.Emit_CodMun    := CodigoCidadeIBGEFilialBase;
      NFe.Emit_Mun       := CidadeFilialBase;
      NFe.Emit_UF        := EstadoFilialBase;
      NFe.Emit_CEP       := CEPFilialBase;
  //    NFe.Emit_CodPais   := 1058;
  //    NFe.Emit_Pais      := 'Brasil';
      NFe.Emit_Fone      := DDDFilialBase+FoneFilialBase;
      NFe.Emit_IE        := InscricaoEstadualFilialBase;
  //    NFe.Emit_IEST      := '';
      NFe.Emit_IM        := InscricaoMunicipalFilialBase;
      NFe.Emit_CNAE      := CNAEFiscalFilialBase;
      NFe.Emit_CRT       := RegimeTributario;

      NFe.Dest_TipoPessoa := qryDadosFiscaisNotaVinculadapessoatipo.AsString;
      NFe.Dest_Documento := qryDadosFiscaisNotaVinculadapessoanumero.AsString;
      NFe.Dest_Nome      := qryDadosFiscaisNotaVinculadanome.AsString;
      NFe.Dest_Rua       := qryDadosFiscaisNotaVinculadarua.AsString;
      NFe.Dest_Nro       := qryDadosFiscaisNotaVinculadaendnumero.AsString;
      NFe.Dest_Compl     := qryDadosFiscaisNotaVinculadaendcomplemento.AsString;
      NFe.Dest_Bairro    := qryDadosFiscaisNotaVinculadanomebairro.AsString;
      NFe.Dest_CodMun    := qryDadosFiscaisNotaVinculadacidadeibge.AsString;
      NFe.Dest_Mun       := qryDadosFiscaisNotaVinculadanomecidade.AsString;
      NFe.Dest_UF        := qryDadosFiscaisNotaVinculadaestado.AsString;
      NFe.Dest_CEP       := qryDadosFiscaisNotaVinculadacep.AsString;
      NFe.Dest_CodPais   := qryDadosFiscaisNotaVinculadapais.AsInteger;
      NFe.Dest_Pais      := qryDadosFiscaisNotaVinculadanomepais.AsString;

      if (qryDadosFiscaisNotaVinculadafoneddd.AsString <> '') and
         (qryDadosFiscaisNotaVinculadafonenumero.AsString <> '') then
        NFe.Dest_Fone      := qryDadosFiscaisNotaVinculadafoneddd.AsString+qryDadosFiscaisNotaVinculadafonenumero.AsString
      else
        NFe.Dest_Fone      := '';

      NFe.Dest_IE        := qryDadosFiscaisNotaVinculadadocumento.AsString;
      NFe.Dest_ISUF      := qryDadosFiscaisNotaVinculadaiesubsttributario.AsString;

      // ENTREGA
      NFe.Entrega_Documento := qryDadosFiscaisNotaVinculadalocalentrega_cnpj.AsString;
      NFe.Entrega_Rua       := qryDadosFiscaisNotaVinculadalocalentrega_rua.AsString;
      NFe.Entrega_Nro       := qryDadosFiscaisNotaVinculadalocalentrega_numero.AsString;
      NFe.Entrega_Compl     := qryDadosFiscaisNotaVinculadalocalentrega_complemento.AsString;
      NFe.Entrega_Bairro    := qryDadosFiscaisNotaVinculadalocalentrega_nomebairro.AsString;
      NFe.Entrega_CodMun    := qryDadosFiscaisNotaVinculadalocalentrega_cidadeibge.AsString;
      NFe.Entrega_Mun       := qryDadosFiscaisNotaVinculadalocalentrega_nomecidade.AsString;
      NFe.Entrega_UF        := qryDadosFiscaisNotaVinculadalocalentrega_estado.AsString;

      nfe.Validando := Validando;

      RefazConsultaPorNome(qryTotaisRecebimentos,['dadofiscal'], [qryDadosFiscaisNotaVinculadanumero.asInteger]);

      Result := NFe.GerarNFe(qryDadosFiscaisNotaVinculada,  nil, qryProdutosDadosFiscaisNotaVinculada, qryProdutosDadosFiscaisCompostosNotaVinculada,
                   qryServicosDadosFiscaisNotaVinculada, qryVenctosDadosFiscaisNotaVinculada,qryVolumesDadosFiscaisNotaVinculada,
                   nil,nil,nil,SerieSugestao,'S', qryCuponsNotaVinculada, false, nil, qryTotaisRecebimentos );

      if Result and not Validando then
      begin
        if NFeTipoEmissao in [1,3] then
        begin
          ShowProcessando;
          ShowProcessando('Verificando status do serviço NF-e!');
          Sleep(500);
          Result := NFe.VerificarStatusServico(IntToStr(NFeAmbiente));
          if Result then
          begin
            ShowProcessando;
            ShowProcessando('Processando o arquivo de envio da NF-e!');
            Sleep(500);
            Result := NFe.EnviarNFe(ChaveAcesso+qryDadosFiscaisNotaVinculadadigchaveacesso.AsString, LoteNFe, ReciboNFe);
            if Result then
            begin
              qryDadosFiscaisNotaVinculada.Edit;
              qryDadosFiscaisNotaVinculadanumlotenfe.AsString   := LoteNFe;
              qryDadosFiscaisNotaVinculadanumrecibonfe.AsString := ReciboNFe;
              qryDadosFiscaisNotaVinculada.Post;
              Result := perpetrar([qryDadosFiscaisNotaVinculada]);
              if Result then
              begin
                ShowProcessando;
                ShowProcessando('Consultando o arquivo de retorno da NF-e!');
                Sleep(500);
                Result := NFe.ConsultarSituacaoLote(ReciboNFe, ProtocoloNFe, status, DataHoraProcessamento, IntToStr(NFeAmbiente));
                if Result then
                begin
                  qryDadosFiscaisNotaVinculada.Edit;
                  qryDadosFiscaisNotaVinculadanumprotocolonfe.AsString := ProtocoloNFe;
                  qryDadosFiscaisNotaVinculadadhprocnfe.Asdatetime := FormatarTimeStamp(DataHoraProcessamento);

                  qryDadosFiscaisNotaVinculada.Post;
                  Result := Perpetrar([qryDadosFiscaisNotaVinculada]);
                  if Result then
                  begin
                    ShowProcessando;
                    ShowProcessando('Gerando o arquivo de compartilhamento da NF-e!');
                    Sleep(500);
                    result := NFe.CompartilharXML(ChaveAcesso+qryDadosFiscaisNotaVinculadadigchaveacesso.AsString,
                                        ReciboNFe, qryDadosFiscaisNotaVinculadafilialemissao.AsString,
                                        SerieSugestao, qryDadosFiscaisNotaVinculadanrdocumento.AsString,
                                        qryDadosFiscaisNotaVinculadadata.AsDateTime);
                    if result then
                      SalvarConteudoxml('S', qryDadosFiscaisnumero.asString);

                    ShowProcessando;
//                    Result := Perpetrar([qryDadosFiscaisNotaVinculada]);
//                    if Result then
//                    begin
                      {if not NFeVisualizarDANFE then
                        MensagemAviso('Impressão da Nota Fiscal será iniciada.')
                      else
                      begin
                      }
//                    end
//                    else
//                      ShowProcessando;
                  end
                  else
                    ShowProcessando;
                end
                else
                  ShowProcessando;
              end
              else
                showProcessando;
            end
            else
              ShowProcessando;
          end
          else
            ShowProcessando;
        end
        else
        begin
          if not NFeVisualizarDANFE then
            MensagemAviso('Impressão da Nota Fiscal será iniciada.');
          NFe.ImprimirDanfe({ChaveAcesso+qryDadosFiscaisNotaVinculadadigchaveacesso.AsString,}
                            qryDadosFiscaisNotaVinculadafilialemissao.AsString,
                            SerieSugestao,
                            qryDadosFiscaisNotaVinculadanrdocumento.AsString,
                            qryDadosFiscaisNotaVinculadalocalentrega_cep.AsString,
                            qryDadosFiscaisNotaVinculadaemail.AsString,
                            IntToStr(NFeNVias), NFeLogotipoDANFE,
                            ParSistema.NomeImpressoraNotaMercadorias, NFeVisualizarDANFE,
                            qryDadosFiscaisNotaVinculadadata.AsDateTime,
                            qryProdutosDadosFiscaisNotaVinculada,
                            NFeExecDANFE, Enviar, 'S');
        end;
      end;
    except
      Result := False;
    end;
  finally
    FreeAndNil(NFe); //NFe.Free;
  end;
end;

procedure TdtmConsultaNotasFiscais.ImprimirDanfe;
var
  NFe : TTecNotaFiscalEletronica;
  vListaNFeEmailValidos : String;
begin
  NFe := TTecNotaFiscalEletronica.Create;
  try
    ShowProcessando('Imprimindo o DANFE!');
    NFe.ImprimirDanfe({ChaveAcesso+qryDadosFiscaisNotaVinculadadigchaveacesso.AsString,}
                      qryDadosFiscaisNotaVinculadafilialemissao.AsString,
                      SerieSugestao,
                      qryDadosFiscaisNotaVinculadanrdocumento.AsString,
                      qryDadosFiscaisNotaVinculadalocalentrega_cep.AsString,
                      qryDadosFiscaisNotaVinculadaemail.AsString,
                      IntToStr(NFeNVias), NFeLogotipoDANFE,
                      ParSistema.NomeImpressoraNotaMercadorias, NFeVisualizarDANFE,
                      qryDadosFiscaisNotaVinculadadata.AsDateTime,
                      qryProdutosDadosFiscaisNotaVinculada,
                      NFeExecDANFE, Enviar, 'S');

    vListaNFeEmailValidos := '';
    ListaStringEmailValido(ListadeEmails('DF', qryDadosFiscaisNotaVinculada.fieldbyname('numero').AsInteger), vListaNFeEmailValidos, true);

    ShowProcessando;
    if (vListaNFeEmailValidos <> '')      and
       (UsuarioLogin.PortaSmpt        <> '')      and
       (UsuarioLogin.HostSmtp         <> '')      and
       (UsuarioLogin.Email            <> '')      and
       (UsuarioLogin.SenhaEmail       <> '')      then
    begin
      ShowProcessando('Enviando email para o cliente');

    try
	    if not NFe.EnviarEmail(UsuarioLogin.Email, vListaNFeEmailValidos,
				qryDadosFiscaisNotaVinculadanrdocumento.AsString, SerieSugestao, IntToStr(FilialBase),
				NomeFilialBase, RazaoFilialBase, CNPJFilialBase, DDDFilialBase, FoneFilialBase,
				DDDFaxFilialBase, FaxFilialBase, UsuarioLogin.NomeUsuario, UsuarioLogin.PortaSMPT,
				UsuarioLogin.HostSMTP, UsuarioLogin.UsuarioEmail, UsuarioLogin.SenhaEmail,
				qryDadosFiscaisNotaVinculadadata.AsDateTime, qryDadosFiscaisNotaVinculadavalortotal.AsCurrency,
				UsuarioLogin.AutenticarSMTP, qryDadosFiscaisNotaVinculadadata.AsDateTime, nil, false, false, CondicaoEmissorNFPSe) then
		MensagemAviso('Ocorreu um erro inesperado no envio do email')
	  finally
	    ShowProcessando;
	  end;
    end;
  finally
    FreeAndNil(Nfe);
  end;
end;

procedure TdtmConsultaNotasFiscais.qryDadosFiscaisCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  if (qryDadosFiscaissituacao.AsString = 'N') or
     (trim(qryDadosFiscaissituacao.AsString) = '') then
    qryDadosFiscaisdescricaosituacao.asvariant := null
  else
  if qryDadosFiscaissituacao.AsString = 'C' then
    qryDadosFiscaisdescricaosituacao.AsString := ANSIUpperCase(ctCANCELADA)
  else
  if qryDadosFiscaissituacao.AsString = 'D' then
    qryDadosFiscaisdescricaosituacao.AsString := 'DENEGADA'
  else
  if qryDadosFiscaissituacao.AsString = 'P' then
    qryDadosFiscaisdescricaosituacao.AsString := ANSIUpperCase(ctParcial);

  qryDadosFiscaisdescontototal.asCurrency := qryDadosFiscaisdesconto.asCurrency + qryDadosFiscaisDescontoitem.asCurrency;  

end;


procedure TdtmConsultaNotasFiscais.qryNotasCalcFields(DataSet: TDataSet);
begin
  inherited;
  if ((qryDadosFiscaismodelodocto.AsString='55') or
      (qryDadosFiscaismodelodocto.AsString='65')) and
     PossuiSomenteNumero(qryNotasserie.AsString) then
  begin
    qryNotasNFE_Calculada.AsString :=
       copy(qryNotasCodigoCidadeIBGEFilial.AsString,1,2) +       // 2
       FormatDateTime('YYMM',qryDadosFiscaisdata.AsDateTime)+      // 4
       preencheString(qryNotascnpjfilial.AsString,'0',14,false) +
       preencheString(qryDadosFiscaismodelodocto.AsString,'0',2,false)+ // 2
       preencheString(qryNotasserie.AsString,'0',3,false)+                  // 3
       preencheString(qrynotasnumero.Asstring,'0',9,false) + // 9
       ifthen(qryDadosFiscaisformaemissao.AsInteger<>0, qryDadosFiscaisformaemissao.AsString, inttostr(NFeTipoEmissao)) + //1
       preencheString(inttostr(Aleatorio(qryDadosFiscaisdata.AsDateTime, qrynotasnumero.Asstring)),'0',8,false);

    qryNotasNFE_Calculada.AsString := qryNotasNFE_Calculada.AsString +
                                             Modulo11(qryNotasNFE_Calculada.AsString);
  end;
end;


