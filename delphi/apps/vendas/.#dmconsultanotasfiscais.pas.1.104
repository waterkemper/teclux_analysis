var
    dtmConsultaNotasFiscais: TdtmConsultaNotasFiscais;

  
implementation

uses
  //Repositorio
  dmtecsoft, dmimprimefiscal,
  //Biblio
  clnfe;

{$R *.dfm}

function TdtmConsultaNotasFiscais.AlterarNota: Boolean;
var
  Usuario           : TtecUsuarios;
begin
  Result:= False;
  Usuario:= TtecUsuarios.Create(dtmTecSoft.Database);
  try
    if UsuarioLogin.AlterarDadosContabeis then
         Usuario:= ObterAutorizacao(taSENHA)
    else Usuario:= ObterAutorizacao(taLOGIN, ctALTERARDADOSCONTABEIS, ctAUTORIZADO);

    if Assigned(Usuario) then
    begin
      if Usuario.AlterarDadosContabeis then
      begin
        Result:= True;
        qryDadosFiscais.ReadOnly:= False;
        qryProdutosDadosFiscais.ReadOnly:= False;
        qryDadosFiscais.Edit;
        qryDadosFiscaispessoanumero.AsString := qryProcurarClientesDadosFiscaispessoanumero.AsString;
        qryDadosFiscaisdocumento.AsString    := qryProcurarClientesDadosFiscaisinscricaoestadual.AsString;
        qryDadosFiscaisestadocfo.AsString    := qryProcurarClientesDadosFiscaisestado.AsString;
        qryDadosFiscaisnome.AsString         := qryProcurarClientesDadosFiscaisnome.AsString;
        qryDadosFiscaisrua.AsString          := qryProcurarClientesDadosFiscaisrua.AsString;

        qryDadosFiscaisendnumero.AsString          := qryProcurarClientesDadosFiscaisnumero.AsString;
        qryDadosFiscaisendcomplemento.AsString          := qryProcurarClientesDadosFiscaiscomplemento.AsString;


        qryDadosFiscaisbairro.AsString := qryProcurarClientesDadosFiscaisbairro.AsString;

        qryDadosFiscaisbairronome.AsString := qryProcurarClientesDadosFiscaisnomebairro.AsString;

        qryDadosFiscaiscidade.AsString := qryProcurarClientesDadosFiscaiscidade.AsString;

        qryDadosFiscaiscidadenome.AsString := qryProcurarClientesDadosFiscaisnomecidade.AsString;

        qryDadosFiscaisestado.AsString := qryProcurarClientesDadosFiscaisestado.AsString;

        qryDadosFiscaiscep.AsString    := qryProcurarClientesDadosFiscaiscep.AsString;

        qryDadosFiscaispessoatipo.AsString := qryProcurarClientesDadosFiscaispessoatipo.AsString;

        qryDadosFiscaisfonenumero.AsString := qryProcurarClientesDadosFiscaisfonenumero.AsString;

        qryDadosFiscaisfoneddd.AsString    := qryProcurarClientesDadosFiscaisfoneddd.AsString;

        VerificarDadosCliente;


      end
      else
        MensagemAviso(ctUSUARIOSEMPERMISSAO);
    end;
  finally
    Usuario.Free;
  end;
end;


function TdtmConsultaNotasFiscais.GetConsultarFiliais: TZDataSet;
begin
  Result:= qryConsultaFiliais;
end;

function TdtmConsultaNotasFiscais.ExisteFilial(campo, codigo: string): Boolean;
begin
  Result:= ExisteCodigo(qryConsultaFiliais, campo, codigo);
end;

constructor TdtmConsultaNotasFiscais.Create(AOwner: TComponent);
begin
  inherited;
  qryProcurarFiliais.Tag              := ctTabelas;
  qryProcurarCFOP.Tag                 := ctTabelas;
  qryProcurarCFOPPesquisa.Tag         := ctTabelas;
  qryProcurarFornecedorTransporte.Tag := ctTabelas;
  qryProcurarClientes.Tag             := ctTabelas;
  qryProcurarClientesDadosFiscais.Tag := ctTabelas;
  qryConsultaFiliais.Tag              := ctPesquisaFilial;
  qryConsultaCFOP.Tag                 := ctPesquisaCodigoFiscal;
  qryConsultaFornecedorTransporte.Tag := ctTabelasConsultaFornecedores;
  qryConsultaClientes.Tag := ctPesquisaClientes;
  qryProcurarClientes.Params[0].AsString := 'C';
  qryProcurarClientesDadosFiscais.Params[0].AsString := 'C';
  qryProdutosDadosFiscaisquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
end;

procedure TdtmConsultaNotasFiscais.Selecionar(Pesquisa: TtecConsultaNotasCupons);
begin
  case Pesquisa of
         cncFILIAL: ReFazConsulta(qryProcurarFiliais,[0],[qryConsultaFiliaiscodigo.AsInteger]);
         cncCLIENTE: ReFazConsulta(qryProcurarClientes,[0,1],[qryConsultaClientestipo.AsString,
                                                              qryConsultaClientescodigo.AsInteger]);
         cncCLIENTEDADOFISCAL: begin
                                ReFazConsulta(qryProcurarClientesDadosFiscais,[0,1],[qryConsultaClientestipo.AsString,
                                                              qryConsultaClientescodigo.AsInteger]);
                                qryDadosFiscaiscliente.AsInteger := qryConsultaClientescodigo.AsInteger;
                                qryDadosFiscaistipocliente.AsString := qryConsultaClientestipo.AsString;
                               end;
         cncCFOP: qryDadosFiscaiscodigofiscal.AsInteger := qryConsultaCFOPcodigo.AsInteger;
         cncCFOPSELECAO: ReFazConsulta(qryProcurarCFOPPesquisa,[0],[qryConsultaCFOPcodigo.AsInteger]);
         cncFORNECEDORTRANSPORTE: qryDadosFiscaisfornecedortransporte.AsInteger:= qryConsultaFornecedorTransportecodigo.AsInteger;
  end;
end;

procedure TdtmConsultaNotasFiscais.AlterarSituacaoEntrega;
begin
  if not qryProdutosDadosFiscais.ReadOnly then begin
    qryProdutosDadosFiscais.Edit;
    qryProdutosDadosFiscaisentregar.AsBoolean:= not qryProdutosDadosFiscaisentregar.AsBoolean;
    qryProdutosDadosFiscais.Post;
  end;  
end;

procedure TdtmConsultaNotasFiscais.AbreTabelaPesquisa(TipoPesquisa: TtecConsultaNotasCupons);
begin
  case TipoPesquisa of
         cncFILIAL: Abre(ctPesquisaFilial);
        cncCLIENTE, cncCLIENTEDADOFISCAL: Abre(ctPesquisaClientes); // qryConsultaClientes.Open;
           cncCFOP, cncCFOPSELECAO: Abre(ctPesquisaCodigoFiscal);
  cncFORNECEDORTRANSPORTE: Abre(ctTabelasConsultaFornecedores);
  end;
end;

procedure TdtmConsultaNotasFiscais.FechaTabelaPesquisa(TipoPesquisa: TtecConsultaNotasCupons);
begin
  case TipoPesquisa of
         cncFILIAL: Fecha(ctPesquisaFilial);
        cncCLIENTE, cncCLIENTEDADOFISCAL: Fecha(ctPesquisaClientes);
           cncCFOP, cncCFOPSELECAO: Fecha(ctPesquisaCodigoFiscal);
  cncFORNECEDORTRANSPORTE: Fecha(ctTabelasConsultaFornecedores);
  end;
end;

function TdtmConsultaNotasFiscais.GravarAlteracoesNota: Boolean;
var
  ValorNota,
  ImpostoICMS,
  ImpostoISS: Currency;
  ICMS,
  ISS: Boolean;
begin
  Result:= True;
  ImpostoICMS := 0;
  ImpostoISS  := 0;
  ICMS        := False;
  ISS         := False;
  if qryDadosFiscais.State = dsEdit then
  begin
        qryDadosFiscais.Post;
        Perpetrar([qryDadosFiscais, qryProdutosDadosFiscais]);
        qryDadosFiscais.ReadOnly:= True;
        qryProdutosDadosFiscais.ReadOnly:= True;
  end
end;



function TdtmConsultaNotasFiscais.ExisteCFOP(campo, codigo: string): Boolean;
