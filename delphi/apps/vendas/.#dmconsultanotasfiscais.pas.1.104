procedure TdtmConsultaNotasFiscais.SetCliente(const Value: String);
begin
  if FConsultar = 'N' then begin
    if Value <> '' then
         qryNotas.macrobyname('Cliente').asstring :=  'and (d.cliente = ' + Value + ') and (d.tipocliente = ' +
                                      '''' + qryProcurarClientestipo.AsString + '''' + ')'
    else qryNotas.macrobyname('Cliente').asstring := '';
  end
  else
  begin
    if Value <> '' then
         qryCupons.macrobyname('Cliente').asstring := 'and (d.cliente = ' + Value + ') and (d.tipocliente = ' +
                                       '''' + qryProcurarClientestipo.AsString + '''' + ')'

    else qryCupons.macrobyname('Cliente').asstring := '';
  end;
end;

procedure TdtmConsultaNotasFiscais.SetECF(const Value: String);
begin
  if Value <> '' then
       qryCupons.macrobyname('ECF').asstring := 'and (cp.maquina = ' + Value + ')'
  else qryCupons.macrobyname('ECF').asstring := '';
end;

procedure TdtmConsultaNotasFiscais.SetEmissaoFinal(const Value: String);
begin
  if not DataEmBranco(Value) then
       FEmissaoFinal:= Value
  else FEmissaoFinal:= '';
  MontaDataEmissao;
end;

procedure TdtmConsultaNotasFiscais.SetEmissaoInicial(const Value: String);
begin
  if not DataEmBranco(Value) then
       FEmissaoInicial:= Value
  else FEmissaoInicial:= '';
  MontaDataEmissao;
end;

