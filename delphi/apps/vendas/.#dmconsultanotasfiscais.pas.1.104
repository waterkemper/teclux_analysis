  Result:= ExisteCodigo(qryConsultaFornecedorTransporte, campo, codigo);
end;

function TdtmConsultaNotasFiscais.ExisteCliente(Campo, codigo: string): Boolean;
const
  SQL = 'where (upper(to_ascii(%s,''latin1'')) ilike upper(to_ascii(''%s%s'',''latin1'')))';
begin
  if Campo = 'nomecidade' then
    Campo:= 'c.nome'
  else if Campo = 'tipopessoa' then
    Campo:= 'v.tipo'
  else Campo:= 'v.' + Campo;
  qryConsultaClientes.Sql[11] := Format(SQL, [Campo, Codigo, '%']);
  qryConsultaClientes.Open;
  Result := qryConsultaClientes.RecordCount > 0
end;

