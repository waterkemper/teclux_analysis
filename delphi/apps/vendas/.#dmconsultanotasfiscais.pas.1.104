procedure TdtmConsultaNotasFiscais.MontaDataEmissao;
const
  Data_1: String = 'and (d.data = ';
  Data_2: String = 'and (d.data between (';
begin
  if (FEmissaoInicial <> '') then begin
    if (FEmissaoFinal = '') then
    begin
      if consultar='N' then
        qryNotas.macrobyname('Emissao').asstring := Data_1 + '''' + FEmissaoInicial + ''')'
      else
        qryNotas.macrobyname('Emissao').asstring := '';

      if consultar='C' then
         qryCupons.macrobyname('Emissao').asstring := Data_1 + '''' + FEmissaoInicial + ''')'
      else
        qryCupons.macrobyname('Emissao').asstring := '';

    end
    else begin
      if consultar='N' then
        qryNotas.macrobyname('Emissao').asstring := Data_2 + '''' + FEmissaoInicial + ''') and (''' + FEmissaoFinal + '''))'
      else
        qryNotas.macrobyname('Emissao').asstring := '';


      if consultar='C' then
        qryCupons.macrobyname('Emissao').asstring := Data_2 + '''' + FEmissaoInicial + ''') and (''' + FEmissaoFinal + '''))'
      else
        qryCupons.macrobyname('Emissao').asstring := '';

    end;
  end
  else begin
    if (FEmissaoFinal <> '') then begin

      if consultar='N' then
        qryNotas.macrobyname('Emissao').asstring := Data_1 + '''' + FEmissaoFinal + ''')'
      else
        qryNotas.macrobyname('Emissao').asstring := '';


      if consultar='C' then
        qryCupons.macrobyname('Emissao').asstring := Data_1 + '''' + FEmissaoFinal + ''')'
      else
        qryCupons.macrobyname('Emissao').asstring := '';

    end
    else begin
      qryNotas.macrobyname('Emissao').asstring := '';
      qryCupons.macrobyname('Emissao').asstring := '';
    end;
  end;
end;

function TdtmConsultaNotasFiscais.GerarConsulta: Boolean;
begin
  if FConsultar = 'N' then
  begin
    qrynotas.MacroByName('NumeroDadoFiscal').AsString := '';
    qryNotas.Close;
    qryNotas.Open;
    Result:= qryNotas.IsEmpty;
  end
  else begin
    qryCupons.MacroByName('NumeroDadoFiscal').AsString := '';
    qryCupons.close;
    qryCupons.Open;
    Result:= qryCupons.IsEmpty;
  end;
  If Result then LimparTabelas;
end;

procedure TdtmConsultaNotasFiscais.ReFazConsultaTabelas(Codigo: Integer);
begin
  ReFazConsulta(qryDadosFiscais,        [0],[Codigo]);
  ReFazConsulta(qryProdutosDadosFiscais,[0],[codigo]);
  ReFazConsulta(qryServicosDadosFiscais,[0],[codigo]);
  ReFazConsulta(qryVenctosDadosFiscais, [0],[Codigo]);
  ReFazConsulta(qryRecebimentos,        [0],[Codigo]);
  ReFazConsulta(qryCalculosProdutos,    [0],[codigo]);
  ReFazConsulta(qryECFsDadosFiscais,    [0],[Codigo]);
  RefazConsulta(qryVolumesDadosFiscais, [0],[Codigo]);
  ReFazConsulta(qryLacresDadosFiscais,  [0],[codigo]);
end;

procedure TdtmConsultaNotasFiscais.qryNotasAfterScroll(DataSet: TDataSet);
begin
  inherited;
  if Consultar = 'N' then
  begin
    ReFazConsultaTabelas(qryNotasdadofiscal.AsInteger);
    qryCupons.close;
    qryCupons.MacroByName('NumeroDadoFiscal').AsString := ' and d.numero = '+inttostr(qryNotasdadofiscalvinculado.Asinteger);
    qryCupons.Open;
  end;
end;

procedure TdtmConsultaNotasFiscais.qryCuponsAfterScroll(DataSet: TDataSet);
begin
  inherited;
  if consultar='C' then
  begin

    if DataSet <> nil then
      ReFazConsultaTabelas(qryCuponsdadofiscal.AsInteger);

    qrynotas.close;
    qrynotas.MacroByName('NumeroDadoFiscal').AsString := ' and n.dadofiscalvinculado = '+inttostr(qryCuponsdadofiscal.Asinteger) +
                                                         ' and d.situacao=''N''';
    qrynotas.Open;
  end;
end;

procedure TdtmConsultaNotasFiscais.qryDadosFiscaisAfterScroll(DataSet: TDataSet);
begin
  inherited;
  refazconsulta(qryProcurarClientesDadosFiscais,[0,1],
       [qryDadosFiscaistipocliente.AsVariant, qryDadosFiscaiscliente.AsVariant]);

  if Assigned(OnScrollTipoPessoa) then
    OnScrollTipoPessoa(qryDadosFiscais);
  qryDadosFiscais.ReadOnly:= True;
  qryProdutosDadosFiscais.ReadOnly:= True;

  qryNotasCalcFields(nil);  

  
end;

procedure TdtmConsultaNotasFiscais.qryProcurarClientesAfterOpen(DataSet: TDataSet);
begin
  inherited;
  if qryProcurarClientes.Params[0].AsString = '' then
    qryProcurarClientes.Params[0].AsString:= 'F';
end;

function TdtmConsultaNotasFiscais.GetTipoPessoa: String;
begin
  Result:= '';
  if Assigned(qryDadosFiscais) then begin
    if qryDadosFiscaispessoatipo.AsSTring <> '' then
         Result:= qryDadosFiscaispessoatipo.AsSTring
    else Result:= '';
  end;
end;

procedure TdtmConsultaNotasFiscais.LimparTabelas;
begin
  ReFazConsulta(qryDadosFiscais,        [0],['0']);
  ReFazConsulta(qryProdutosDadosFiscais,[0],['0']);
  ReFazConsulta(qryVenctosDadosFiscais, [0],[0]);
  ReFazConsulta(qryRecebimentos,        [0],[0]);
  ReFazConsulta(qryCalculosProdutos,    [0],[0]);
  ReFazConsulta(qryServicosDadosFiscais,[0],[0]);
  ReFazConsulta(qryECFsDadosFiscais,    [0],[0]);
end;

function TdtmConsultaNotasFiscais.GravarNotaVinculada: Boolean;

var
  dtmConsultaNotasFiscaisNotaVinculada: TdtmConsultaNotasFiscais;
  Usuario           : TtecUsuarios;
  ChaveAcesso : String;
  SomenteLeituraDadosFiscais : Boolean;

  procedure SelecionarCodigoNatureza(descricao: String);
  begin
    qryNaturezasPadrao.Open;
    if qryNaturezasPadrao.Locate('descricao',descricao,[]) then
    begin
      qryDadosFiscaiscodigonatureza.asinteger := qryNaturezasPadraonatureza.AsInteger;
      qryDadosFiscaiscodigofiscal.AsInteger   := qryNaturezasPadraocodigofiscal.AsInteger;
      if qryDadosFiscaiscodigofiscal.AsInteger <> 8000 then
        if not (qryDadosFiscaisestado.AsString = EstadoFilialBase) then
          if HeUnidadeFederacao(qryDadosFiscaisestado.AsString) then
          begin
            if  qryDadosFiscaiscodigofiscal.AsInteger = ctVENDASUBSTITUIDODENTROESTADO then
              qryDadosFiscaiscodigofiscal.AsInteger := qryDadosFiscaiscodigofiscal.AsInteger+999
            else
              qryDadosFiscaiscodigofiscal.AsInteger := qryDadosFiscaiscodigofiscal.AsInteger+1000;
          end
          else
            qryDadosFiscaiscodigofiscal.AsInteger := qryDadosFiscaiscodigofiscal.AsInteger+2000;
    end;
  end;

begin
   result := true;
  {qdo nota fiscal não for vinculada, criar o vinculo inserindo a nf
   e trocando o codigofiscal para 5929}
  if (qryDadosFiscaiscodigofiscal.AsInteger mod 1000) <> 929 then
  begin
    //colcado em comentario por jr 23/01/2019 - solicitacao mari.
    if false {MonthOf(qryDadosFiscaisdata.AsDateTime) <> MonthOf(date())} then
    begin
      MensagemAviso('A nota vinculada não pode ser gerada pois o mês do cupom é diferente do mês atual.');
      result := false;
    end
    else
    if qryDadosFiscaisfilialemissao.AsInteger <> FilialBase then
    begin
      MensagemAviso('A nota vinculada não pode ser gerada pois a filial de emissão do cupom é diferente desta filial.');
      result := false;
    end
    else
    if VerificarDadosCliente then
    begin
      Usuario := TtecUsuarios.Create(dtmTecSoft.Database);
      try
        if UsuarioLogin.EmissorNotaFiscal then
          Usuario:= ObterAutorizacao(taSENHA)
        else
          Usuario:= ObterAutorizacao(taLOGIN, ctEMITIRNOTAFISCALVINCULADA, ctAUTORIZADO);

        if Assigned(Usuario) then
        begin
          if Usuario.EmissorNotaFiscal then
          begin
            result := VerificarSerieFilial;
            if result then
            begin

              SomenteLeituraDadosFiscais := qrydadosfiscais.readonly;

              qrydadosfiscais.readonly := false;
              qrydadosfiscais.Edit;
              SelecionarCodigoNatureza('VENDAS CUPOM FISCAL');
              qrydadosfiscais.Post;

              RefazConsultaPorNome(qryDadosFiscaisNotaVinculada,['numero'],[qrydadosfiscaisnumero.asinteger]);

              qryDadosFiscaisNotaVinculada.edit;
              qryDadosFiscaisNotaVinculadanatureza.AsString := 'EMISSAO CUPOM FISCAL-ECF';
              qryDadosFiscaisNotaVinculadacodigofiscal.AsInteger := qryDadosFiscaiscodigofiscal.asinteger;
              qryDadosFiscaisNotaVinculadacodigonatureza.AsInteger := qryDadosFiscaiscodigonatureza.AsInteger;
//              qryDadosFiscaisNotaVinculadanatureza.asstring := qryDadosFiscaisnatureza.AsString;
              qryDadosFiscaisNotaVinculada.post;

              RefazConsultaPorNome(qryProdutosDadosFiscaisNotaVinculada,['dadofiscal'],[qrydadosfiscaisnumero.asinteger]);
              RefazConsultaPorNome(qryProdutosDadosFiscaisCompostosNotaVinculada,['dadofiscal'],[qrydadosfiscaisnumero.asinteger]);
              RefazConsultaPorNome(qryServicosDadosFiscaisNotaVinculada,['dadofiscal'],[qrydadosfiscaisnumero.asinteger]);
              RefazConsultaPorNome(qryVenctosDadosFiscaisNotaVinculada,['dadofiscal'],[qrydadosfiscaisnumero.asinteger]);

              RefazConsultaPorNome(qryVolumesDadosFiscaisNotaVinculada,['dadofiscal'],[qrydadosfiscaisnumero.asinteger]);
              RefazConsultaPorNome(qryCuponsNotaVinculada,['dadofiscal'],[qrydadosfiscaisnumero.asinteger]);

              dtmConsultaNotasFiscaisNotaVinculada := TdtmConsultaNotasFiscais.Create(nil);

              RefazConsultaPorNome(dtmConsultaNotasFiscaisNotaVinculada.qryDadosFiscaisNotaVinculada,['numero'],[0]);
              RefazConsultaPorNome(dtmConsultaNotasFiscaisNotaVinculada.qryProdutosDadosFiscaisNotaVinculada,['dadofiscal'],[0]);
              RefazConsultaPorNome(dtmConsultaNotasFiscaisNotaVinculada.qryProdutosDadosFiscaisCompostosNotaVinculada,['dadofiscal'],[0]);
              RefazConsultaPorNome(dtmConsultaNotasFiscaisNotaVinculada.qryServicosDadosFiscaisNotaVinculada,['dadofiscal'],[0]);
              RefazConsultaPorNome(dtmConsultaNotasFiscaisNotaVinculada.qryVenctosDadosFiscaisNotaVinculada,['dadofiscal'],[0]);
              RefazConsultaPorNome(dtmConsultaNotasFiscaisNotaVinculada.qryVolumesDadosFiscaisNotaVinculada,['dadofiscal'],[0]);

              CopiarRegistros(qryDadosFiscaisNotaVinculada, dtmConsultaNotasFiscaisNotaVinculada.qryDadosFiscaisNotaVinculada);
              CopiarRegistros(qryProdutosDadosFiscaisNotaVinculada, dtmConsultaNotasFiscaisNotaVinculada.qryProdutosDadosFiscaisNotaVinculada);
              CopiarRegistros(qryProdutosDadosFiscaisCompostosNotaVinculada, dtmConsultaNotasFiscaisNotaVinculada.qryProdutosDadosFiscaisCompostosNotaVinculada);
              CopiarRegistros(qryServicosDadosFiscaisNotaVinculada, dtmConsultaNotasFiscaisNotaVinculada.qryServicosDadosFiscaisNotaVinculada);

              {Os Vencimentos só podem ir para a nota eletronica na codição abaixo}
              if qryDadosFiscaisdata.AsDatetime = dataservidor then
                 CopiarRegistros(qryVenctosDadosFiscaisNotaVinculada, dtmConsultaNotasFiscaisNotaVinculada.qryVenctosDadosFiscaisNotaVinculada);

              CopiarRegistros(qryVolumesDadosFiscaisNotaVinculada, dtmConsultaNotasFiscaisNotaVinculada.qryVolumesDadosFiscaisNotaVinculada);

              dtmConsultaNotasFiscaisNotaVinculada.spcDadosFiscaisProximo.Open;
              dtmConsultaNotasFiscaisNotaVinculada.qryDadosFiscaisNotaVinculada.edit;
              dtmConsultaNotasFiscaisNotaVinculada.qryDadosFiscaisNotaVinculadanumero.AsInteger := dtmConsultaNotasFiscaisNotaVinculada.spcDadosFiscaisProximonumero.AsInteger;
              dtmConsultaNotasFiscaisNotaVinculada.qryDadosFiscaisNotaVinculadanotavinculada.AsBoolean := True;
              dtmConsultaNotasFiscaisNotaVinculada.qryDadosFiscaisNotaVinculada.post;
              dtmConsultaNotasFiscaisNotaVinculada.spcDadosFiscaisProximo.Close;

              AtribuirChave(dtmConsultaNotasFiscaisNotaVinculada.qryProdutosDadosFiscaisNotaVinculada,
                                    [dtmConsultaNotasFiscaisNotaVinculada.qryProdutosDadosFiscaisNotaVinculadadadofiscal,
                                     dtmConsultaNotasFiscaisNotaVinculada.qryProdutosDadosFiscaisNotaVinculadacodigofiscal,
                                     dtmConsultaNotasFiscaisNotaVinculada.qryProdutosDadosFiscaisNotaVinculadanatureza],
                                    [dtmConsultaNotasFiscaisNotaVinculada.qryDadosFiscaisNotaVinculadanumero,
                                     dtmConsultaNotasFiscaisNotaVinculada.qryDadosFiscaisNotaVinculadacodigofiscal,
                                     dtmConsultaNotasFiscaisNotaVinculada.qryDadosFiscaisNotaVinculadacodigonatureza]);

              AtribuirDados(dtmConsultaNotasFiscaisNotaVinculada.qryProdutosDadosFiscaisNotaVinculada,
                            [dtmConsultaNotasFiscaisNotaVinculada.qryProdutosDadosFiscaisNotaVinculadaincidencia,
                             dtmConsultaNotasFiscaisNotaVinculada.qryProdutosDadosFiscaisNotaVinculadaaliquotaicms],
                            [ifthen(regimetributario=1,ctSNOutrosS,ctOUTROS), 0.00]);

              LimparCampos(dtmConsultaNotasFiscaisNotaVinculada.qryProdutosDadosFiscaisNotaVinculada,
                           [dtmConsultaNotasFiscaisNotaVinculada.qryProdutosDadosFiscaisNotaVinculadamovimento]);

              AtribuirChave(dtmConsultaNotasFiscaisNotaVinculada.qryProdutosDadosFiscaisCompostosNotaVinculada,
                            [dtmConsultaNotasFiscaisNotaVinculada.qryProdutosDadosFiscaisCompostosNotaVinculadadadofiscal],
                            [dtmConsultaNotasFiscaisNotaVinculada.qryDadosFiscaisNotaVinculadanumero]);

              AtribuirChave(dtmConsultaNotasFiscaisNotaVinculada.qryVenctosDadosFiscaisNotaVinculada,
                            [dtmConsultaNotasFiscaisNotaVinculada.qryVenctosDadosFiscaisNotaVinculadadadofiscal],
                            [dtmConsultaNotasFiscaisNotaVinculada.qryDadosFiscaisNotaVinculadanumero]);

              AtribuirChave(dtmConsultaNotasFiscaisNotaVinculada.qryServicosDadosFiscaisNotaVinculada,
                            [dtmConsultaNotasFiscaisNotaVinculada.qryServicosDadosFiscaisNotaVinculadadadofiscal],
                            [dtmConsultaNotasFiscaisNotaVinculada.qryDadosFiscaisNotaVinculadanumero]);

              AtribuirChave(dtmConsultaNotasFiscaisNotaVinculada.qryVolumesDadosFiscaisNotaVinculada,
                            [dtmConsultaNotasFiscaisNotaVinculada.qryVolumesDadosFiscaisNotaVinculadadadofiscal],
                            [dtmConsultaNotasFiscaisNotaVinculada.qryDadosFiscaisNotaVinculadanumero]);

              dtmConsultaNotasFiscaisNotaVinculada.qryProdutosDadosFiscaisNotaVinculada.First;
              while not dtmConsultaNotasFiscaisNotaVinculada.qryProdutosDadosFiscaisNotaVinculada.Eof do
              begin
                AtribuirDadosProdutos(dtmConsultaNotasFiscaisNotaVinculada.qryProdutosDadosFiscaisNotaVinculada,
                                      dtmConsultaNotasFiscaisNotaVinculada.qryDadosFiscaisNotaVinculada, nil, false, NotaVinculada );
                dtmConsultaNotasFiscaisNotaVinculada.qryProdutosDadosFiscaisNotaVinculada.Next;
              end;

              if CalcularImpostos(dtmConsultaNotasFiscaisNotaVinculada.qryProdutosDadosFiscaisNotaVinculada,
                                 dtmConsultaNotasFiscaisNotaVinculada.qryDadosFiscaisNotaVinculada, ContribIPI, true, true, nil,
                                 dtmConsultaNotasFiscaisNotaVinculada.qryProdutosDadosFiscaisCompostosNotaVinculada, false, NotaContrato,
                                 false, true,
                                 dtmConsultaNotasFiscaisNotaVinculada.qryServicosDadosFiscaisNotaVinculada,true ) then
              begin
                result := true;

                RefazConsultaPorNome(qryDadosFiscaisNotaVinculada,['numero'],[0]);
                RefazConsultaPorNome(qryProdutosDadosFiscaisNotaVinculada,['dadofiscal'],[0]);
                RefazConsultaPorNome(qryProdutosDadosFiscaisCompostosNotaVinculada,['dadofiscal'],[0]);
                RefazConsultaPorNome(qryServicosDadosFiscaisNotaVinculada,['dadofiscal'],[0]);
                RefazConsultaPorNome(qryVenctosDadosFiscaisNotaVinculada,['dadofiscal'],[0]);
                RefazConsultaPorNome(qryVolumesDadosFiscaisNotaVinculada,['dadofiscal'],[0]);

                CopiarRegistros(dtmConsultaNotasFiscaisNotaVinculada.qryDadosFiscaisNotaVinculada, qryDadosFiscaisNotaVinculada);
                CopiarRegistros(dtmConsultaNotasFiscaisNotaVinculada.qryProdutosDadosFiscaisNotaVinculada, qryProdutosDadosFiscaisNotaVinculada);
                CopiarRegistros(dtmConsultaNotasFiscaisNotaVinculada.qryProdutosDadosFiscaisCompostosNotaVinculada, qryProdutosDadosFiscaisCompostosNotaVinculada);
                CopiarRegistros(dtmConsultaNotasFiscaisNotaVinculada.qryVenctosDadosFiscaisNotaVinculada, qryVenctosDadosFiscaisNotaVinculada);
                CopiarRegistros(dtmConsultaNotasFiscaisNotaVinculada.qryServicosDadosFiscaisNotaVinculada, qryServicosDadosFiscaisNotaVinculada);
                CopiarRegistros(dtmConsultaNotasFiscaisNotaVinculada.qryVolumesDadosFiscaisNotaVinculada, qryVolumesDadosFiscaisNotaVinculada);

                qryNotaVinculada.Open;
                qryNotaVinculada.Append;
                qryNotaVinculadafilial.AsInteger     := FilialBase;
                qryNotaVinculadaserie.AsString       := SerieSugestao;
                qryNotaVinculadanumero.AsInteger     := qrySeriesFiliaisnumeroinicial.AsInteger;
                qryNotaVinculadadadofiscal.AsInteger := qryDadosFiscaisNotaVinculadanumero.AsInteger;
                qryNotaVinculadadadofiscalvinculado.AsInteger := qrydadosfiscaisnumero.asinteger;
                qryNotaVinculada.Post;

                qrySeriesFiliais.Edit;
                qrySeriesFiliaisnumeroinicial.AsInteger := qrySeriesFiliaisnumeroinicial.AsInteger + 1;
                qrySeriesFiliais.Post;

                dtmConsultaNotasFiscaisNotaVinculada.Free;
                dtmConsultaNotasFiscaisNotaVinculada := nil;

                qryDadosFiscaisNotaVinculada.Edit;
                qryDadosFiscaisNotaVinculadamodelodocto.AsString := qrySeriesFiliaismodelodoctofiscal.AsString;
                //descomentado por JR em 23/01/2019
                qryDadosFiscaisNotaVinculadadata.AsDateTime := now();
                qryDadosFiscaisNotaVinculadadatasaida.Clear;//nao faz diferenca, preenche no controle e não sei se deveria.

                //qryDadosFiscaisNotaVinculadadata.AsDateTime := now();
                //qryDadosFiscaisNotaVinculadadatasaida.asdatetime := now();


                if parsistema.EmissorNfe then
                  result := EmitirNFe(true);

                if qrydadosfiscaisNotaVinculada.state in [dsinsert, dsedit] then
                  qrydadosfiscaisNotaVinculada.Post;

              end
              else
                result := false;

              if result then
                result :=  Perpetrar([qryDadosFiscais, qryDadosFiscaisNotaVinculada, qryProdutosDadosFiscaisNotaVinculada,
                                    qryProdutosDadosFiscaisCompostosNotaVinculada, qryServicosDadosFiscaisNotaVinculada,
                                    qryVolumesDadosFiscaisNotaVinculada, qryVenctosDadosFiscaisNotaVinculada, qryNotaVinculada,
                                    qrySeriesFiliais]);

              if Result then
              begin

                if ParSistema.EmissorNfe {and
                   (((qryDadosFiscaiscodigofiscal.AsInteger mod 1000) = 910) or NotaFiscalVinculada or Not Assigned(ECFPadrao))} then
                begin
                  Result := EmitirNFe;
                  if Result then
                    ImprimirDanfe;
                end;
              end;

              qryDadosFiscaisNotaVinculada.Close;
              qryProdutosDadosFiscaisNotaVinculada.Close;
              qryProdutosDadosFiscaisCompostosNotaVinculada.Close;
              qryServicosDadosFiscaisNotaVinculada.Close;
              qryVolumesDadosFiscaisNotaVinculada.Close;
              qryVenctosDadosFiscaisNotaVinculada.Close;
              qryNotaVinculada.Close;
              qrySeriesFiliais.Close;

              qrydadosfiscais.readonly := SomenteLeituraDadosFiscais;

            end;
          end
          else
            MensagemAviso(ctUSUARIOSEMPERMISSAO);
        end;
      finally
        Usuario.Free;
      end;
    end;
  end;
end;


function TdtmConsultaNotasFiscais.ImprimirNota(Impressora: String): boolean;
begin
  result := true;


  if Consultar = 'C' then  {se estiver consultando um cupom fiscal}
    result := GravarNotaVinculada;
  if result then
  begin
    dtmImprimeFiscal := TdtmImprimeFiscal.Create(Self);
    try
      if qryServicosDadosFiscais.RecordCount <> 0 then
        dtmImprimeFiscal.ImprimirNota(qryDadosFiscaisnumero.AsInteger, ModeloNotaServicos, Impressora)
      else
        dtmImprimeFiscal.ImprimirNota(qryDadosFiscaisnumero.AsInteger, ModeloNota, Impressora);
    finally
      dtmImprimeFiscal.Free;
      dtmImprimeFiscal := nil;
    end;
  end;

end;


