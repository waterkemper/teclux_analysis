function TdtmConsultaNotasFiscais.GetCondicaoEmissorNFPSe: Boolean;
begin

  if qryDadosFiscais.recordcount <> 0 then

    fCondicaoEmissorNFPSe := (parsistema.EmissorNfPSe and
                              (qryDadosFiscaismodelodocto.AsString = '99') and
                              (qryServicosDadosFiscais.recordcount <> 0) and
                              (ftipoemissaonfeservico in [Florianopolis_SoftPlan, Palhoca_IPM]))

  else
    fCondicaoEmissorNFPSe := (parsistema.EmissorNfPSe and
                              (ModeloDoctoFiscalServico = '99') and
                              (qryServicosDadosFiscais.recordcount <> 0) and
                              (ftipoemissaonfeservico in [Florianopolis_SoftPlan, Palhoca_IPM]));

  Result := fCondicaoEmissorNFPSe;

end;

function TdtmConsultaNotasFiscais.VerificarDadosCliente: boolean;
begin

  result := true;
  
  if qryDadosFiscaisbairro.isnull or
     qryDadosFiscaiscidade.isnull or
     qryDadosFiscaisestado.isnull or
     qryDadosFiscaiscep.isnull or
     qryDadosFiscaisfonenumero.isnull then
  begin
    Result := False;
    MensagemAviso('Os dados do endereço ou telefone do cliente estão incompletos!');
  end;

end;

end.

