function TdtmConsultaNotasFiscais.GetCondicaoCartaCorrecao: Boolean;
begin
  result := (qryDadosFiscaissituacao.AsString = 'N') and
            (qryDadosFiscaismodelodocto.AsString = '55') and
           {ryNotasnumlotenfe.AsString <> '') and
            (qryNotasnumrecibonfe.AsString <> '') and}
            (qryNotasnumprotocolonfe.AsString <> '') and
            (qryNotaschave_nfe.AsString <> '')
end;

procedure TdtmConsultaNotasFiscais.qryCalculosProdutosBeforeOpen(
  DataSet: TDataSet);
begin
  inherited;
  qryCalculosProdutos.parambyname('contribiss').AsBoolean := contribiss;
end;

function TdtmConsultaNotasFiscais.GetCondicaoEmissorNFE: Boolean;
begin

  if qryDadosFiscais.recordcount <> 0 then

    fCondicaoEmissorNFE := (parsistema.EmissorNfe and
                            ((qryDadosFiscaismodelodocto.AsString = '55') or
                             (qryDadosFiscaismodelodocto.AsString = '57'))) or

                            (parsistema.Emissor_de_NFC_e and
                             (qryDadosFiscaismodelodocto.AsString = '65')) or

                            (parsistema.EmissorNfPSe and
                             (qryDadosFiscaismodelodocto.AsString = '99') and
                             (qryServicosDadosFiscais.recordcount <> 0) and
                             (ftipoemissaonfeservico in [Florianopolis_SoftPlan, Palhoca_IPM]))

  else
    fCondicaoEmissorNFE := (parsistema.EmissorNfe and
                            ((ModeloDoctoFiscal = '55') or
                             (ModeloDoctoFiscal = '57'))) or

                           (parsistema.Emissor_de_NFC_e and
                            (ModeloDoctoFiscalNFCe = '65')) or

                           (parsistema.EmissorNfPSe and
                            (ModeloDoctoFiscalServico = '99') and
                            (qryServicosDadosFiscais.recordcount <> 0) and
                            (ftipoemissaonfeservico in [Florianopolis_SoftPlan, Palhoca_IPM]));

  Result := fCondicaoEmissorNFE;
end;

procedure TdtmConsultaNotasFiscais.ImprimirNotaPromissoriaCupom;
begin
    dtmImprimeFiscal := TdtmImprimeFiscal.Create(Self);
    try
        dtmImprimeFiscal.ImprimirNotaPromissoria(qryDadosFiscaisnumero.AsInteger,true);
    finally
      dtmImprimeFiscal.Free;
      dtmImprimeFiscal := nil;
    end;

end;


procedure TdtmConsultaNotasFiscais.SetNotaSaidaTransferencia(
  const Value: boolean);
begin
  fNotaSaidaTransferencia := Value;

  qryNotas.macrobyname('TiposdeNotas').asString := '';

  if NotaSaidaVenda then
    qryNotas.macrobyname('TiposdeNotas').asString := ' and ( ehnotafiscalsaidavenda(d.codigofiscal) ';

  if NotaSaidaDevolucao then
  begin
    if qryNotas.macrobyname('TiposdeNotas').asString <> '' then
      qryNotas.macrobyname('TiposdeNotas').asString := qryNotas.macrobyname('TiposdeNotas').asString + ' or ehnotafiscalsaidaDevolucao(d.codigofiscal) '
    else
      qryNotas.macrobyname('TiposdeNotas').asString := qryNotas.macrobyname('TiposdeNotas').asString + ' and ( ehnotafiscalsaidaDevolucao(d.codigofiscal) '

  end;

  if NotaSaidaTransferencia then
  begin
    if qryNotas.macrobyname('TiposdeNotas').asString <> '' then
      qryNotas.macrobyname('TiposdeNotas').asString := qryNotas.macrobyname('TiposdeNotas').asString + ' or ehnotafiscalsaidatransferencia(d.codigofiscal) '
    else
      qryNotas.macrobyname('TiposdeNotas').asString := qryNotas.macrobyname('TiposdeNotas').asString + ' and ( ehnotafiscalsaidatransferencia(d.codigofiscal) '
  end;

  if qryNotas.macrobyname('TiposdeNotas').asString<>'' then
    qryNotas.macrobyname('TiposdeNotas').asString := qryNotas.macrobyname('TiposdeNotas').asString + ')';

end;


function TdtmConsultaNotasFiscais.EnviarEmailNfe(email: String): boolean;
begin

  try

    NFe := TTecNotaFiscalEletronica.Create;

    if (email <> '')      and
       (UsuarioLogin.PortaSmpt               <> '')      and
       (UsuarioLogin.HostSmtp                <> '')      and
       (UsuarioLogin.Email                   <> '')      and
       (UsuarioLogin.SenhaEmail              <> '')      then
    begin
      ShowProcessando('Enviando email para o cliente');
      sleep(500);
      try
        VerificarDadosFilial(qryNotasfilial.AsString);

        if not NFe.EnviarEmail(UsuarioLogin.Email,
        email,
        qryNotasnumero.AsString,
        qryNotasserie.AsString,
        qryNotasfilial.AsString,

        qryDadosFilial_.fieldbyname('nome').AsString,
        qryDadosFilial_.fieldbyname('razao').asString,
        qryDadosFilial_.fieldbyname('cnpj').asString,
        qryDadosFilial_.fieldbyname('foneddd').asString,
        qryDadosFilial_.fieldbyname('fonenumero').asString,
        qryDadosFilial_.fieldbyname('faxddd').asString,
        qryDadosFilial_.fieldbyname('faxnumero').asString,

        UsuarioLogin.NomeUsuario, UsuarioLogin.PortaSMPT,
        UsuarioLogin.HostSMTP, UsuarioLogin.UsuarioEmail, UsuarioLogin.SenhaEmail,
        qryDadosFiscaisData.AsDateTime, qryDadosFiscaisvalortotal.AsCurrency,
        UsuarioLogin.AutenticarSMTP, qryDadosFiscaisData.AsDateTime, nil, false, false, CondicaoEmissorNFPSe ) then
          MensagemAviso('Ocorreu um erro inesperado no envio do email')

      finally
        ShowProcessando;
      end;

    end;

  finally

    NFe.free;

  end;

end;

procedure TdtmConsultaNotasFiscais.SetListaClasses(const Value: String);
begin
  fListaClasses := Value;
  if Value <> '' then
  begin
    qryNotas.macrobyname('ListaClasses').asString := ' and (' + FListaClasses +')';
    qryCupons.macrobyname('ListaClasses').asString := ' and (' + FListaClasses +')';
  end
  else
  begin
    qryNotas.macrobyname('ListaClasses').asString := '';
    qryCupons.macrobyname('ListaClasses').asString := '';
