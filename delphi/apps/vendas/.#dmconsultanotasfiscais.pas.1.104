procedure TdtmConsultaNotasFiscais.SetPesquisaporDescricao(
  const Value: String);
begin
  fPesquisaporDescricao := Value;

  if (fPesquisaporDescricao <> '') then
    qryNotas.macrobyname('PesquisaporDescricao').asString :=
      format(' and (upper(to_ascii(%s,''latin1'')) ilike upper(to_ascii(''%s'',''latin1'')))',
             ['d.observacoes||d.infcomplementar', '%'+fPesquisaporDescricao+'%'])
  else
    qryNotas.macrobyname('PesquisaporDescricao').asString := '';

  qryCupons.macrobyname('PesquisaporDescricao').asString := qryNotas.macrobyname('PesquisaporDescricao').asString;
end;

