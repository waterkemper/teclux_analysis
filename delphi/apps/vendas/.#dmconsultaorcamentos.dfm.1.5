    Sql.Strings = (
      'Select o.codigo,'
      '           o.cliente, o.tipocliente, '
      '           o.nome,'
      '           o.emissao,'
      '           o.validade,'
      '           (Select sum(po.quantidade * po.precovenda) '
      '            From produtosorcamentos po '
      '            Where po.orcamento = o.codigo) as totalprodutos,'
      '           o.situacao,'
      '           o.vendedor,'
      '           o.contrato, o.cancelamento, o.motivo,'
      '           false as selecionar'
      'From   orcamentos o'
      '/*          Situacao          */'
      '/*          Filial                */'
      '/*          Vendedor        */'
      '/*          Cliente             */'
      '/*          Contem            */'
      '/*          Plano               */'
