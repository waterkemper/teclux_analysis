    procedure qryProdutosOrcamentosBeforeOpen(DataSet: TDataSet);
    procedure qryProdutosOrcamentosCalcFields(DataSet: TDataSet);
  private
    fListaClasses: String;
    fListaMarcas: String;
    fListaGrupos: String;
    FListaItemProdutos: String;
    FListaProdutos: String;
    FDataContatoInicial: String;
    FDataContatoFinal: String;
    FDataLembraremInicial: String;
    FDataLembraremFinal: String;
    fValorTotalOrcamentoInicial: String;
    fValorTotalOrcamentoFinal: STring;
    function GetPodeCancelar: Boolean;
    procedure SetListaClasses(const Value: String);
    procedure SetListaGrupos(const Value: String);
    procedure SetListaItemProdutos(const Value: String);
    procedure SetListaMarcas(const Value: String);
    procedure SetListaProdutos(const Value: String);
    procedure SetMarcadosparanaoligar(const Value: Byte);
    procedure SetQtAtendimentos(const Value: String);
    procedure SetDataContatoFinal(const Value: String);
    procedure SetDataContatoInicial(const Value: String);

    procedure SetDataLembraremFinal(const Value: String);
    procedure SetDataLembraremInicial(const Value: String);

    procedure SetValorTotalOrcamentoFinal(const Value: String);
    procedure SetValorTotalOrcamentoInicial(const Value: String);
  protected
    FEmissaoInicial: String;
    FValidadeInicial: String;
    FValidadeFinal: String;
    FEmissaoFinal: String;
    FContem: String;

    function GetConsultarMotivos: TtecQuery;
    function GetQtdeContratos: Integer;
    function GetTotalContratos: Real;

    procedure SetCliente(const Value: String);
    procedure SetOrdenacao(const Value: Integer);
    procedure SetProduto(const Value: String);
    procedure SetPlano(const Value: String);
    procedure SetFilial(const Value: String);
    procedure SetSituacao(const Value: Integer);
    procedure SetVendedor(const Value: String);
    procedure SetEmissaoInicial(const Value: String);
    procedure SetEmissaoFinal(const Value: String);
    procedure SetValidadeFinal(const Value: String);
