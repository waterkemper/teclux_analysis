  WhereBase = 12;
  WhereSituacao  = WhereBase + 1;
  WhereFilial    = WhereBase + 2;
  WhereVendedor  = WhereBase + 3;
  WhereCliente   = WhereBase + 4;
  WhereContem    = WhereBase + 5;
  WherePlano     = WhereBase + 6;
  WhereProduto   = WhereBase + 7;
  WhereEmissao   = WhereBase + 8;
  WhereValidade  = WhereBase + 9;
  WhereOrdenacao = WhereBase + 10;

implementation

{$R *.dfm}

procedure TdtmConsultaOrcamentos.AbreTabelaConsulta(TipoConsulta: TtecConsultaOrcamentos);
begin
  case TipoConsulta of
    ccoFILIAIS   : Abre(ctTabelasConsultaFiliais);
    ccoVENDEDORES: Abre(ctTabelasConsultaVendedores);
    ccoCLIENTES  : begin
                     qryConsultaClientes.Sql[11]:= 'Where (v.codigo = 0)';
                     Abre(ctTabelasConsultaClientes);
                   end;
    ccoPRODUTOS  : begin
                     qryConsultaProdutos.Sql[03] := 'Where (codigo = 0)';
                     Abre(ctTabelasConsultaProdutos);
                   end;
    ccoPLANOS    : Abre(ctTabelasConsultaPlanos);
  end;
end;

function TdtmConsultaOrcamentos.AbrirConsultaOrcamento: Boolean;
begin
  QtdeMarcados := 0;
  TotalMarcados:= 0;
  if qryOrcamentos.Active then
    qryOrcamentos.Close;
  qryOrcamentos.Open;
  Result:= qryOrcamentos.IsEmpty;
end;

function TdtmConsultaOrcamentos.CancelarOrcamentos(Cancelar: Boolean): boolean;
var
  Codigos, SQL: String;
begin
  result := true;
  if Cancelar and qryConsultaMotivoscodigo.IsNull then
    MensagemAviso(ctORCAMENTO_MOTIVO)
  else
  begin
    {Codigos:= '';}
    qryOrcamentos.First;
    while not qryOrcamentos.Eof do
    begin
      if qryOrcamentosselecionar.AsBoolean and ((qryOrcamentossituacao.AsString = 'A')  or
                                                (qryOrcamentossituacao.AsString = 'P')) then
      begin
        Codigos:= Codigos + qryOrcamentoscodigo.AsString + ',';

        if Cancelar then
        begin
          if IncluirAtendimento_(qryOrcamentoscodigo.AsInteger, qryOrcamentoscliente.AsInteger, qryOrcamentostipocliente.AsString, CancelamentoOrcamentoConsulta, TextoCancelamento) then
          begin
            qryOrcamentos.Edit;
            qryOrcamentoscancelamento.AsDateTime:= DataServidor;
            qryOrcamentosmotivo.AsInteger       := qryConsultaMotivoscodigo.AsInteger;
            qryOrcamentossituacao.AsString      := 'C';
            qryOrcamentos.Post;
            result := Perpetrar([qryOrcamentos]);
            if not result then
              Rollback([]);
            EncerrarDataModule2_;
          end;
        end;
      end;
      qryOrcamentos.Next;
    end;


    if (Codigos <> '') and not cancelar then
    begin
      Delete(Codigos,Length(Codigos),1);

      qryOperacoesOrcamentos.Sql.Clear;
      {
      if Cancelar then
        SQL:= 'UPDATE orcamentos SET cancelamento = ' + QuotedStr(DateToStr(DataServidor)) + ', ' +
                                    'situacao = ' + QuotedStr('C') + ', ' +
                                    'motivo = ' + qryConsultaMotivoscodigo.AsString +
              ' WHERE (codigo in (' + Codigos + '))'
      else
      }
        SQL:= 'DELETE FROM orcamentos WHERE (codigo in (' + Codigos + '))';

      qryOperacoesOrcamentos.Sql.Text:= SQL;
      qryOperacoesOrcamentos.ExecSql;
      result := Perpetrar([qryOperacoesOrcamentos]);
    end;
    AbrirConsultaOrcamento;
  end;
end;

constructor TdtmConsultaOrcamentos.Create(AOwner: TComponent);
begin
  inherited;
  qryFiliais.Tag            := ctTabelas;
  qryVendedores.Tag         := ctTabelas;
  qryClientes.Tag           := ctTabelas;
  qryProdutos.Tag           := ctTabelas;
  qryPlanos.Tag             := ctTabelas;

  qryConsultaFilial.Tag     := ctTabelasConsultaFiliais;
  qryConsultaVendedores.Tag := ctTabelasConsultaVendedores;
  qryConsultaClientes.Tag   := ctTabelasConsultaClientes;
  qryConsultaProdutos.Tag   := ctTabelasConsultaProdutos;
  qryConsultaPlanos.Tag     := ctTabelasConsultaPlanos;
  qryConsultaMotivos.Tag    := ctTabelasConsultaMotivos;
end;

function TdtmConsultaOrcamentos.ExisteCliente(Campo, Codigo: String): Boolean;
const
  SQL = 'where (upper(to_ascii(%s,''latin1'')) ilike upper(to_ascii(''%s%s'',''latin1'')))';
begin
  if Campo = 'nomecidade' then
    Campo:= 'c.nome'
  else if Campo = 'tipopessoa' then
    Campo:= 'v.tipo'
  else Campo:= 'v.' + Campo;
  qryConsultaClientes.Sql[11] := Format(SQL, [Campo, Codigo, '%']);
  qryConsultaClientes.Open;
  Result := qryConsultaClientes.RecordCount > 0
end;

function TdtmConsultaOrcamentos.ExisteFilial(Campo, Codigo: string): Boolean;
begin
  Result := ExisteCodigo(qryConsultaFilial,Campo,Codigo);
end;

function TdtmConsultaOrcamentos.ExistePlano(Campo, Codigo: String): Boolean;
begin
  Result := ExisteCodigo(qryConsultaPlanos,Campo,Codigo);
end;

function TdtmConsultaOrcamentos.ExisteProduto(Campo, Codigo: String): Boolean;
const
  SQL = 'where (upper(to_ascii(%s,''latin1'')) ilike upper(to_ascii(''%s%s'',''latin1'')))';
begin
  qryConsultaProdutos.Sql[03] := Format(SQL, [Campo, Codigo, '%']);
  qryConsultaProdutos.Open;
  Result := qryConsultaProdutos.RecordCount > 0
end;

function TdtmConsultaOrcamentos.ExisteVendedor(Campo, Codigo: string): Boolean;
begin
  Result := ExisteCodigo(qryConsultaVendedores,Campo,Codigo);
end;

procedure TdtmConsultaOrcamentos.FecharConsultaOrcamentos;
begin
  qryOrcamentos.Close;
  QtdeMarcados := 0;
  TotalMarcados:= 0;
end;

procedure TdtmConsultaOrcamentos.FechaTabelaConsulta(TipoConsulta: TtecConsultaOrcamentos);
begin
  case TipoConsulta of
    ccoFILIAIS   : Fecha(ctTabelasConsultaFiliais);
    ccoVENDEDORES: Fecha(ctTabelasConsultaVendedores);
    ccoCLIENTES  : Fecha(ctTabelasConsultaClientes);
    ccoPRODUTOS  : Fecha(ctTabelasConsultaProdutos);
    ccoPLANOS    : Fecha(ctTabelasConsultaPlanos);
  end;
