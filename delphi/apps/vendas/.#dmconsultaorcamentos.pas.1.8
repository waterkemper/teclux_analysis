procedure TdtmConsultaOrcamentos.MarcarSelecionados(Marcando, Todos: Boolean);
begin
  MarcarRegistros(qryOrcamentos,
                  qryOrcamentosselecionar,
                  qryOrcamentostotalprodutos,
                  Marcando,
                  Todos);
end;

procedure TdtmConsultaOrcamentos.Selecionar(TipoConsulta: TtecConsultaOrcamentos);
begin
  case TipoConsulta of
    ccoFILIAIS   : ReFazConsulta(qryFiliais,[0],[qryConsultaFilialcodigo.AsInteger]);
    ccoVENDEDORES: ReFazConsulta(qryVendedores,[0],[qryConsultaVendedorescodigo.AsInteger]);
    ccoCLIENTES  : begin
                     ReFazConsulta(qryClientes,[0,1],[qryConsultaClientestipo.AsString,
                                                      qryConsultaClientescodigo.AsInteger]);
                   end;
    ccoPRODUTOS  : ReFazConsulta(qryProdutos,[0],[qryConsultaProdutoscodigo.AsString]);
    ccoPLANOS    : ReFazConsulta(qryPlanos,[0],[qryConsultaPlanoscodigo.AsInteger]);
  end;
end;

procedure TdtmConsultaOrcamentos.SetCliente(const Value: String);
begin
  if Value <> '' then qryOrcamentos.Sql[WhereCliente] := 'and (o.cliente = ' + Value + ')'
  else                qryOrcamentos.Sql[WhereCliente] := '';
end;

procedure TdtmConsultaOrcamentos.SetContem(const Value: String);
begin
  if FContem <> Value then qryOrcamentos.Sql[WhereContem] := 'and (upper(to_ascii(o.nome,''latin1'')) ilike upper(to_ascii(' + QuotedStr('%' + ansiuppercase(Value) + '%') + ',''latin1''))'
  else                     qryOrcamentos.Sql[WhereContem] := '';
end;

procedure TdtmConsultaOrcamentos.SetEmissaoFinal(const Value: String);
begin
  FEmissaoFinal := Value;
  qryOrcamentos.Sql[WhereEmissao] := MontarIntervaloData('o.emissao',FEmissaoInicial,FEmissaoFinal);
end;

procedure TdtmConsultaOrcamentos.SetEmissaoInicial(const Value: String);
begin
  FEmissaoInicial := Value;
  qryOrcamentos.Sql[WhereEmissao] := MontarIntervaloData('o.emissao',FEmissaoInicial,FEmissaoFinal);
end;

procedure TdtmConsultaOrcamentos.SetFilial(const Value: String);
begin
  if Value <> '' then qryOrcamentos.Sql[WhereFilial] := 'and (o.filial = ' + Value + ')'
  else                qryOrcamentos.Sql[WhereFilial] := ''
end;

procedure TdtmConsultaOrcamentos.SetOrdenacao(const Value: Integer);
begin
  Case Value of
    0: qryOrcamentos.Sql[WhereOrdenacao]:= 'Order by upper(to_ascii(o.nome,''latin1'')), o.emissao';
    1: qryOrcamentos.Sql[WhereOrdenacao]:= 'Order By o.emissao, upper(to_ascii(o.nome,''latin1''))';
    2: qryOrcamentos.Sql[WhereOrdenacao]:= 'Order By o.validade, upper(to_ascii(o.nome,''latin1''))';
  end;
end;

procedure TdtmConsultaOrcamentos.SetPlano(const Value: String);
begin
  if Value <> '' then qryOrcamentos.Sql[WherePlano] := 'and ((Select count(*) ' +
                                                               'From planosorcamentos po ' +
                                                               'Where (po.orcamento = o.codigo) and ' +
                                                                     '(po.plano = ' + Value + ')) > 0)'
  else                qryOrcamentos.Sql[WherePlano] := ''
end;

procedure TdtmConsultaOrcamentos.SetProduto(const Value: String);
begin
  if Value <> '' then qryOrcamentos.Sql[WhereProduto] := 'and ((Select count(*) ' +
                                                               'From produtosorcamentos po ' +
                                                               'Where (po.orcamento = o.codigo) and ' +
                                                                     '(po.produto = ' + Value + ')) > 0)'
  else                qryOrcamentos.Sql[WhereProduto] := ''
end;

procedure TdtmConsultaOrcamentos.SetSituacao(const Value: Integer);
begin
  Case Value of
    0: qryOrcamentos.Sql[WhereSituacao]:= 'Where (o.situacao = ''A'')';
    1: qryOrcamentos.Sql[WhereSituacao]:= 'Where (o.situacao = ''C'')';
    2: qryOrcamentos.Sql[WhereSituacao]:= 'Where (o.situacao = ''T'')';
    3: qryOrcamentos.Sql[WhereSituacao]:= 'Where (o.situacao = ''P'')';
    4: qryOrcamentos.Sql[WhereSituacao]:= 'Where (o.situacao <> ''X'')'; //Quanquer situacao
  end;
end;

procedure TdtmConsultaOrcamentos.SetValidadeFinal(const Value: String);
begin
  FValidadeFinal:= Value;
  qryOrcamentos.Sql[WhereValidade] := MontarIntervaloData('o.validade',FValidadeInicial,FValidadeFinal);
end;

procedure TdtmConsultaOrcamentos.SetValidadeInicial(const Value: String);
begin
  FValidadeInicial:= Value;
  qryOrcamentos.Sql[WhereValidade] := MontarIntervaloData('o.validade',FValidadeInicial,FValidadeFinal);
end;

procedure TdtmConsultaOrcamentos.SetVendedor(const Value: String);
begin
  if Value <> '' then qryOrcamentos.Sql[WhereVendedor] := 'and (o.vendedor = ' + Value + ')'
  else                qryOrcamentos.Sql[WhereVendedor] := '';
end;

procedure TdtmConsultaOrcamentos.ImprimirOrcamento;
var
  dtmImprimir: TdtmImprimeOrcamento;
  Contratos: String;
begin
  Contratos:= '';
  qryOrcamentos.First;
  while not qryOrcamentos.Eof do begin
    if qryOrcamentosselecionar.AsBoolean then
      Contratos:= Contratos + qryOrcamentoscodigo.AsString + ',';
    qryOrcamentos.Next;
  end;
  Delete(Contratos,Length(Contratos),1);

  if Contratos <> '' then begin
    dtmImprimir := TdtmImprimeOrcamento.Create(Self);
    try
      dtmImprimir.ImprimirOrcamento(Contratos);
    finally
      dtmImprimir.Free;
//      dtmImprimir := nil;
    end;
  end;
end;

function TdtmConsultaOrcamentos.GetPodeCancelar: Boolean;
begin
  Result:= (qryOrcamentossituacao.AsString = 'A');
end;


end.
