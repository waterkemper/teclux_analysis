    Macros = <>
    Sql.Strings = (
      'Select   contrato,'
      '             numero,'
      '             parcelaorigem,'
      '             datavencto,'
      '             valorvencto,'
      '             datapagto,'
      '             valorpagto,'
      '             filialpagto,'
      '             tipopagto,'
      '             formapagamento,  '
      '             deventrada,'
      '             devcaixa,'
      '             parcelaadicional,'
      '             (case when coalesce(valorpagto,0.00) > 0 then'
      '                                (valorpagto - valorvencto)'
      '                       else   0'
      '              end) as juros,'
      '             false as podeexcluir'
      'From     parcelas'
      'Where  contrato =:numero'
      '/* -- for update */'
      'Order By datavencto, parcelaorigem, datapagto')
    RequestLive = True
    Left = 64
