  object qryProdutosContratos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryProdutosContratosBeforeOpen
    AfterOpen = qryProdutosContratosAfterOpen
    AfterInsert = qryProdutosContratosAfterInsert
    AfterScroll = qryProdutosContratosAfterScroll
    OnCalcFields = qryProdutosContratosCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select pc.contrato,'
      '           pc.produto, p.codigovisual as produtovisual,'
      '           pc.quantidade,'
      '           pc.precovenda,'
      '           pc.precovenda as precovendaaux,'
      '           pc.filial,'
      
        '           cast(:filialdevolucao as integer) as filialMovimentac' +
        'ao,'
      '           pc.cancelado,'
      ''
      '           /*'
      
        '           (select sum(ctd.quantidade) from contratosdevolvidos ' +
        'ctd where ctd.contrato = pc.contrato and ctd.produto = pc.produt' +
        'o and ctd.tipo = '#39'D'#39') as devolvidos,'
      
        '           (select sum(ctd.quantidade) from contratosdevolvidos ' +
        'ctd where ctd.contrato = pc.contrato and ctd.produto = pc.produt' +
        'o and ctd.tipo = '#39'T'#39') as trocados,'
      '           */'
      ''
      '           pc.brinde,'
      '           pc.produtolista,'
      '           pc.frete,'
      '           pc.seguro,'
      '           pc.acrescimo,'
      '           pc.desconto,'
      ''
      ''
      
        '/*        ERROU -> n'#227'o necessario a funcao ja existe o campo val' +
        'ordescontoitemcupomdesconto'
      
        '          coalesce(pc.valordescontoitem,0) + ratearcupom_valor_d' +
        'esconto(pc.contrato, pc.produto) as valordescontoitem,'
      '          */'
      ''
      
        '           coalesce(pc.valordescontoitem,0) + coalesce(pc.valord' +
        'escontoitemcupomdesconto,0) as valordescontoitem,'
      '           '
      ''
      '           p.caracteristica,'
      '           p.descricao,'
      
        '           (select gr.descricao from grades gr where gr.codigo =' +
        ' c.grade1) as linha,'
      
        '           (select gr.descricao from grades gr where gr.codigo =' +
        ' c.grade2) as coluna,'
      '           p.valorgrade1,'
      '           p.valorgrade2,'
      '           c.unidade,'
      '           t.valor as incidencia,'
      '           c.csosn,'
      '           c.origem,'
      '           c.icms,'
      '           c.percreducaobase,'
      
        '           (Select e.futuro From estoques e where e.produto = pc' +
        '.produto and e.filial = case when :filialvirtual then pc.filial ' +
        'else :filialdevolucao end) as futuro,'
      
        '           (Select valor From estadosicms Where (estado =:estado' +
        ') and (icms =c.icms)) as aliquotaicms,'
      ''
      
        '           (case when (pc.filial <> case when :filialvirtual the' +
        'n pc.filial else :filialdevolucao end) then'
      
        '                               (Select produtoscontratos_qtdeent' +
        'regue(:primogenito  , pc.produto, pc.filial) -'
      
        '                                           produtoscontratos_qtd' +
        'edevolvida(:primogenito, pc.produto, case when :filialvirtual th' +
        'en pc.filial else :filialdevolucao end))'
      
        '                     else   (Select  produtoscontratos_qtdeentre' +
        'gue(:primogenito  , pc.produto, pc.filial) -'
      
        '                                           produtoscontratos_qtd' +
        'edevolvida(:primogenito, pc.produto, pc.filial))'
      '            end) as qtdeentregue,'
      ''
      '           0.00 as devolver,'
      '           0.00 as qtdeentregueparadevolver,'
      '/*           0.00 as ValorReducaoBaseUnitaria,*/'
      '           false as defeito,'
      '           c.composto,'
      '          pc.icmsvalorst,'
      '          pc.valoripi,'
      '         (select df.filialemissao'
      '           from dadosfiscais df'
      '                join produtosdadosfiscais pdf'
      '                on df.numero = pdf.dadofiscal'
      '           where df.numero = pdf.dadofiscal'
      '             and df.contrato = pc.contrato'
      '             and pdf.produto = pc.produto'
      '             and df.situacao = '#39'N'#39' limit 1'
      '             ) as FilialEmissaoNota'
      ''
      
        'From    produtoscontratos pc, produtos p, caracteristicas c, tri' +
        'butosicms t'
      'Where (pc.contrato=:contrato )      and'
      '      (pc.produto = p.codigo)       and'
      '      (p.caracteristica = c.codigo) and'
      '      (t.codigo = c.incidencia) '
      'Order by pc.numero')
    RequestLive = True
    Left = 64
    Top = 240
    ParamData = <
      item
        DataType = ftInteger
        Name = 'filialdevolucao'
        ParamType = ptUnknown
        Value = 0
      end
      item
        DataType = ftUnknown
        Name = 'filialvirtual'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'estado'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'primogenito'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'contrato'
        ParamType = ptUnknown
      end>
