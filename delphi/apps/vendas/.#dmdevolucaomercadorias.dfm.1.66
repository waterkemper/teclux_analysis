  object qrySaldosProdutosDadosFiscais_NAO_UTILIZADO: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select saldos.*'
      'from'
      '('
      'select pdf.dadofiscal,'
      '       pdf.produto,'
      '       pdf.numero,'
      '       '
      '       pdf.quantidade -'
      '       coalesce((select SUM(pnp.quantidade)'
      '                 from notaspag np'
      '                      join produtosnotaspag pnp'
      '                      on np.codigo = pnp.codigonota'
      '                 where pnp.dadofiscal = df.numero'
      '                   and pnp.produto = pdf.produto'
      '                   and pnp.numeroprodutotabela = pdf.numero'
      
        '                   and np.situacao = '#39'N'#39'),0) as SaldoQuantidadeN' +
        'otaSaida,'
      ''
      
        '      coalesce((select n.numero from notas n where n.dadofiscal ' +
        '= df.numero limit 1), (select c.numero from cupons c where c.dad' +
        'ofiscal = df.numero limit 1)) as NumeroNotaFiscalSaida'
      '          '
      'from dadosfiscais df'
      '     left join notas n on df.numero = n.dadofiscal'
      '     join produtosdadosfiscais pdf'
      '     on df.numero = pdf.dadofiscal'
      'where df.situacao = '#39'N'#39
      '  and n.dadofiscalvinculado is null'
      '  and df.contrato = :contrato'
      '  and pdf.produto = :produto'
      ') as Saldos'
      'where SaldoQuantidadeNotaSaida <> 0')
    RequestLive = False
    Left = 400
    Top = 472
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'contrato'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'produto'
        ParamType = ptUnknown
      end>
    object qrySaldosProdutosDadosFiscais_NAO_UTILIZADOdadofiscal: TIntegerField
      FieldName = 'dadofiscal'
    end
    object qrySaldosProdutosDadosFiscais_NAO_UTILIZADOproduto: TLargeintField
      FieldName = 'produto'
    end
    object qrySaldosProdutosDadosFiscais_NAO_UTILIZADOnumero: TIntegerField
      FieldName = 'numero'
    end
    object qrySaldosProdutosDadosFiscais_NAO_UTILIZADOsaldoquantidadenotasaida: TFloatField
      FieldName = 'saldoquantidadenotasaida'
    end
    object qrySaldosProdutosDadosFiscais_NAO_UTILIZADOnumeronotafiscalsaida: TIntegerField
      FieldName = 'numeronotafiscalsaida'
    end
  end
  object qryDadosFiscaisRef: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select n.filial,'
      '       df.chv_nfe as NumeroNFe,'
      '       df.numprotocolonfe,'
      '       df.digchaveacesso,'
      '       f.estado as CodigoUF,'
      '       df.data,'
      '       f.cnpj as pessoanumero,'
      '       df.modelodocto,'
      '       n.serie,'
      '       n.numero as numeronf,'
      '       cast(null as integer) as maquina,'
      '       cast(null as integer) as numerocupom,'
      '       n.dadofiscal,'
      ''
      '      (select c.CodigoIBGE'
      '                   from cidades c'
      '                   where c.estado = df.estado'
      '                     and c.codigo = df.cidade) as CidadeIBGE'
      ''
      ''
      ''
      ''
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      ''
      '     join filiais f'
      '     on df.filialemissao = f.codigo'
      
        'where case when :ListaDadosfiscais<> '#39#39' THEN df.numero in (selec' +
        't * from lista_int(cast(string_to_array(:ListaDadosFiscais,'#39','#39') ' +
        'as integer[]))) ELSE false END'
      ''
      ''
      'union all'
      ''
      'select c.filial,'
      '       df.chv_nfe as NumeroNFe,'
      '       df.numprotocolonfe,'
      '       df.digchaveacesso,'
      '       f.estado as CodigoUF,'
      '       df.data,'
      '       f.cnpj as pessoanumero,'
      '       df.modelodocto,'
      '       cast(null as char(3)) as serie,'
      '       cast(null as integer) as numeronf,'
      '       c.maquina,'
      '       c.numero as numerocupom,'
      '       c.dadofiscal,'
      '      (select c.CodigoIBGE'
      '                   from cidades c'
      '                   where c.estado = df.estado'
      '                     and c.codigo = df.cidade) as CidadeIBGE'
      '       '
      'from dadosfiscais df'
      '     join cupons c'
      '     on df.numero = c.dadofiscal'
      ''
      '     join filiais f'
      '     on df.filialemissao = f.codigo'
      
        'where case when :ListaDadosfiscais<> '#39#39' THEN df.numero in (selec' +
        't * from lista_int(cast(string_to_array(:ListaDadosFiscais,'#39','#39') ' +
        'as integer[]))) ELSE false END')
    RequestLive = True
    Left = 520
    Top = 488
    ParamData = <
      item
        DataType = ftString
        Name = 'ListaDadosFiscais'
        ParamType = ptUnknown
        Value = '0'
      end>
