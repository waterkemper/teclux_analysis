  object qryValoresDevolvidos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select Sum(valorvista_p) as valorvista_p,'
      '       Sum(valorprazo_p) as valorprazo_p,'
      '       Sum(desconto_p) as desconto_p,'
      '       sum(valordescontoitem_p) as valordescontoitem_p,'
      '       Sum(creditotroca_p) as creditotroca_p,'
      '       Sum(seguro_p) as seguro_p,'
      '       Sum(frete_p) as frete_p,'
      '       sum(valoripi_p) as valoripi_p,'
      '       sum(valoricmssubstituicao_p) as valoricmssubstituicao_p,'
      ''
      '       Sum(valorvista_s) as valorvista_s,'
      '       Sum(valorprazo_s) as valorprazo_s,'
      ''
      '       /*Sum(desconto_s) as desconto_s, */'
      '       Sum(creditotroca_s) as creditotroca_s, /*,'
      '       Sum(seguro_s) as seguro_s,'
      '       Sum(frete_s) as frete_s */'
      '       Sum(impostoretido_s) as impostoretido_s'
      ''
      'from'
      '('
      ''
      'Select Sum(valorvista) as valorvista_p,'
      '       Sum(valorprazo) as valorprazo_p,'
      '       Sum(desconto) as desconto_p,'
      '       Sum(valordescontoitem) as valordescontoitem_p,'
      '       Sum(creditotroca) as creditotroca_p,'
      '       Sum(seguro) as seguro_p,'
      '       Sum(frete) as frete_p,'
      '       sum(valoripi) as valoripi_p,'
      '       sum(valoricmssubstituicao) as valoricmssubstituicao_p,'
      ''
      '       0.00 as valorvista_s,'
      '       0.00 as valorprazo_s,'
      '       /*0.00 as desconto_s,*/'
      '       0.00 as creditotroca_s,'
      '       /*0.00 as seguro_s,*/'
      '       /*0.00 as frete_s,*/'
      '       0.00 as impostoretido_s'
      ''
      '       '
      'From   contratosdevolvidos '
      
        'Where contrato = :contrato and tipo = '#39'D'#39' and produto is not nul' +
        'l'
      ''
      'union all'
      ''
      'Select 0.00 as valorvista_p,'
      '       0.00 as valorprazo_p,'
      '       0.00 as desconto_p,'
      '       0.00 as valordescontoitem_p,'
      '       0.00 as creditotroca_p,'
      '       0.00 as seguro_p,'
      '       0.00 as frete_p,'
      '       0.00 as valoripi_p,'
      '       0.00 as valoricmssubstituicao_p,'
      ''
      ''
      '       Sum(valorvista) as valorvista_s,'
      '       Sum(valorprazo) as valorprazo_s,'
      '       /*Sum(desconto) as desconto_s,*/'
      '       Sum(creditotroca) as creditotroca_s,'
      '       /*Sum(seguro) as seguro_s,*/'
      '       /*Sum(frete) as frete_s*/'
      '       Sum(impostoretido) as impostoretido_s'
      ''
      'From   contratosdevolvidos'
      
        'Where contrato = :contrato and tipo = '#39'D'#39' and servico is not nul' +
        'l'
      ') as seleco')
    RequestLive = False
    Left = 793
    Top = 171
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'contrato'
        ParamType = ptUnknown
      end>
