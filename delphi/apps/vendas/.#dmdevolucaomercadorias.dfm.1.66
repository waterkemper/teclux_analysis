  object qryConsultaClientes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'SQLCliente'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select  v.nome,'
      '            v.codigo,'
      '            v.tipo,'
      '            v.estado,'
      '            c.nome as nomecidade,'
      '            cast(case when v.tipo = '#39'C'#39' then '#39'Cliente'#39
      '                            when v.tipo = '#39'F'#39' then '#39'Fornecedor'#39
      
        '                            else                            '#39'Fil' +
        'ial'#39
      '            end as varchar) as descricaotipo,'
      '            formatar_cpf_cnpj(v.pessoanumero) as pessoanumero'
      'From    vfornecedores v join cidades c'
      '        on v.estado = c.estado'
      '        and v.cidade = c.codigo'
      'Where %SQLCliente'
      'Order By UPPER(TO_ASCII(v.nome,'#39'LATIN1'#39'))'
      ''
      '')
    RequestLive = False
    Left = 359
    Top = 7
