      '        localentrega_nomecidade,'
      '        localentrega_cidadeibge,'
      '        localentrega_estado,'
      '        fornecedortransporte,'
      '        transportadora_cnpj,'
      '        transportadora_ie,'
      '        transportadora_nome,'
      '        transportadora_rua,'
      '        transportadora_bairro,'
      '        transportadora_nomebairro,'
      '        transportadora_cidade,'
      '        transportadora_nomecidade,'
      '        transportadora_cidadeibge,'
      '        transportadora_estado,'
      '        transportadora_rntc,'
      '        endnumero,'
      '        endcomplemento,'
      '        infcomplementar,'
      '        numlotenfe,'
      '        numrecibonfe,'
      '        numprotocolonfe,'
      '        chv_nfe,'
      '        nome,'
      '        rua,'
      '        bairro,'
      '        cidade,'
      '        cep,'
      '        fonenumero,'
      '        foneddd,'
      '        fornecedorparaiss,'
      '        piscofinscsllretido,'
      '        modelodocto,'
      '        valorservicos_nt,'
      '        valorservicos,'
      '        valorterceiros,'
      '        valoripi,'
      '        despesasacessorias,'
      '        '#39#39' as iesubsttributario,'
      '        '#39#39' as suframa,'
      '        valorprodutos,'
      '       (select sum(pn.quantidade * pn.precounitario)'
      '        from produtosnotaspag pn'
      
        '        where pn.codigonota = notaspag.codigo) - coalesce(notasp' +
        'ag.desconto,0.00) + coalesce(notaspag.acrescimo,0.00) as totalpr' +
        'odutos,'
      '        baseicms,'
      '        valoricms,'
      '        0.00 as irretido,'
      '        0.00 as cofinsretido,'
      '        0.00 as pisretido,'
      '        0.00 as csllretido,'
      '        0.00 as valorvista,'
      '        datahoraemissao,'
      '        regimetributario,'
      
        '       (select sum(pnp.vCredICMSSN) from produtosnotaspag pnp wh' +
        'ere pnp.codigonota = notaspag.codigo) as vCredICMSSN,'
      
        '       (select sum(pnp.vICMSSTRet) from produtosnotaspag pnp whe' +
        're pnp.codigonota = notaspag.codigo) as vICMSSTRet,'
      '       dhprocnfe,'
      '       hSaiEnt,'
      '       statusnfe,'
      '       clientecontribicms,'
      '       dadofiscalreferenciado,'
      '       naoutilizarobsautomaticas,'
      '       vICMSSTRetDesp,'
      '       icmsbasecalculo_dev,'
      '       icmsvalor_dev,'
      '       vBCSTRetDesp,'
      '       requernfsaida,'
      '       cast(null as varchar(1000)) as ItensNumeroSeries,'
      ''
      '       vfcp,'
      '       vfcpst,'
      '       vfcpstret'
      ''
      'From    notaspag'
      'Where (fornecedor = 0)')
    RequestLive = True
    Left = 360
    Top = 356
