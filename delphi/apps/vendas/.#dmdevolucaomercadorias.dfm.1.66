    Sql.Strings = (
      'Select  pn.*,'
      '        p.codigovisual as produtovisual,'
      '        0.00 as precovenda,'
      '        '#39#39' as descricaoproduto,'
      '        cast(null as varchar) as contrato,'
      '        cast(null as integer) as filialsaida,'
      '        false as exigenotareferenciada,'
      '        false as naoutilizarobsautomaticas,'
      
        '        (select n.numero from notas n where n.dadofiscal = pn.da' +
        'dofiscal) as numeronotafiscalsaida '
      'From   produtosnotaspag pn, produtos p'
      'where false'
      '  and pn.produto = p.codigo')
