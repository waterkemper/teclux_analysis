  object qryDadosFiscais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'produto=produto;filial=filial'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrProdutosContratos
    Constraints = <>
    AfterInsert = qryDadosFiscaisAfterInsert
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'FiltroNotas'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroCupons'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      '/*'
      'Select  max(notascupons.filialnota) as filialnota,'
      '         cast(max(notascupons.serie) as varchar) as serie,'
      '         max(notascupons.nota) as nota,'
      '         max(notascupons.filialcupom) as filialcupom,'
      '         max(notascupons.maquina) as maquina,'
      '         max(notascupons.intervensao) as intervensao,'
      '         max(notascupons.cupom) as cupom,'
      '         max(notascupons.dadofiscal) as dadofiscal,'
      
        '         max(notascupons.valorreducaobaseunitaria) as valorreduc' +
        'aobaseunitaria,'
      '         max(notascupons.quantidade) as quantidade,'
      '         max(notascupons.icmsbasecalculo) as icmsbasecalculo,'
      '         max(notascupons.icmsvalor) as icmsvalor,'
      '         cast(max(notascupons.ipicst) as varchar(2)) as ipicst,'
      '         max(notascupons.ipibasecalculo) as ipibasecalculo,'
      '         max(notascupons.valoripi) as ipivalor,'
      '         max(notascupons.iibasecalculo) as iibasecalculo,'
      '         max(notascupons.iidespaduaneira) as iidespaduaneira,'
      '         max(notascupons.iivalor) as iivalor,'
      '         max(notascupons.iiiof) as iiiof,'
      '         cast(max(notascupons.piscst) as varchar(2)) as piscst,'
      '         max(notascupons.pisbasecalculo) as pisbasecalculo,'
      '         max(notascupons.pisaliquota) as pisaliquota,'
      '         max(notascupons.pisvalor) as pisvalor,'
      
        '         cast(max(notascupons.cofinscst) as varchar(2)) as cofin' +
        'scst,'
      
        '         max(notascupons.cofinsbasecalculo) as cofinsbasecalculo' +
        ','
      '         max(notascupons.cofinsaliquota) as cofinsaliquota,'
      '         max(notascupons.cofinsvalor) as cofinsvalor,'
      
        '         cast(max(notascupons.classificacaofiscal) as varchar(8)' +
        ') as classificacaofiscal,'
      '         cast(max(notascupons.extipi) as varchar(3)) as extipi,'
      '         max(notascupons.genero) as genero,'
      '         max(notascupons.ICMSModalidade) as icmsmodalidade,'
      '         max(notascupons.ICMSModSubst) as icmsmodsubst,'
      
        '         cast(max(notascupons.TribCodigoEAN) as varchar(14)) as ' +
        'tribcodigoean,'
      
        '         cast(max(notascupons.TribUnidade) as varchar(6)) as tri' +
        'bunidade,'
      '         max(notascupons.TribQuantidade) as tribquantidade,'
      '         max(notascupons.TribUnitario) as tribunitario,'
      '         max(notascupons.Enquadramento) as enquadramento,'
      
        '         cast(max(notascupons.unidade) as varchar(6)) as unidade' +
        ','
      '         max(notascupons.frete) as frete,'
      '         max(notascupons.seguro) as seguro,'
      '         cast(max(notascupons.origem) as varchar(1)) as origem,'
      
        '         max(notascupons.despesasacessorias) as despesasacessori' +
        'as,'
      '         max(notascupons.aliquotaicmsst) as aliquotaicmsst,'
      
        '         max(notascupons.icmsbasecalculost) as icmsbasecalculost' +
        ','
      '         max(notascupons.icmsvalorst) as icmsvalorst,'
      '         max(notascupons.qtdeoriginal) as qtdeoriginal,'
      '         0.00 as devolver'
      ''
      'From'
      ''
      '*/ Select      pdf.numero as numeroproduto,'
      '               pdf.produto, p.codigovisual as produtovisual,'
      '               pdf.filial,'
      '               n.filial as filialnota,'
      '               n.serie,'
      '               n.numero as nota,'
      '               0 as filialcupom,'
      '               0 as maquina,'
      '               0 as intervensao,'
      '               0 as cupom,'
      '               n.dadofiscal as dadofiscal,'
      
        '               pdf.reducaobase/pdf.quantidade as valorreducaobas' +
        'eunitaria,'
      '               /*'
      
        '               (pdf.quantidade - (Select coalesce(sum(npd.quanti' +
        'dade),0.00)'
      '                                 From notaspagdadosfiscais npd'
      
        '                                 Where (npd.dadofiscal = df.nume' +
        'ro)'
      '                                   and (npd.produto = :produto)'
      
        '                                   and (npd.filial = :filial))) ' +
        'as quantidade,'
      '                                   */  '
      ''
      
        '               (pdf.quantidade - (Select coalesce(sum(pnp.quanti' +
        'dade),0.00)'
      
        '                                 From produtosnotaspag pnp join ' +
        'notaspag np on pnp.codigonota = np.codigo'
      
        '                                 Where pnp.dadofiscal = df.numer' +
        'o'
      '                                   and pnp.produto    = :produto'
      '                                   and pnp.filial     = :filial'
      
        '                                   and pnp.numeroprodutotabela =' +
        ' pdf.numero'
      '                                   and np.situacao = '#39'N'#39
      '                                   )) as quantidade,'
      ''
      '               pdf.quantidade as qtdeoriginal,'
      '               pdf.icmsbasecalculo,'
      '               pdf.icmsvalor,'
      '               pdf.ipicst,'
      '               pdf.ipibasecalculo,'
      '               pdf.valoripi,'
      '               pdf.iibasecalculo,'
      '               pdf.iidespaduaneira,'
      '               pdf.iivalor,'
      '               pdf.iiiof,'
      '               pdf.piscst,'
      '               pdf.pisbasecalculo,'
      '               pdf.pisaliquota,'
      '               pdf.pisvalor,'
      '               pdf.cofinscst,'
      '               pdf.cofinsbasecalculo,'
      '               pdf.cofinsaliquota,'
      '               pdf.cofinsvalor,'
      '               pdf.classificacaofiscal,'
      '               pdf.extipi,'
      '               pdf.genero,'
      '               pdf.ICMSModalidade,'
      '               pdf.ICMSModSubst,'
      '               pdf.TribCodigoEAN,'
      '               pdf.TribUnidade,'
      '               pdf.TribQuantidade,'
      '               pdf.TribUnitario,'
      '               pdf.Enquadramento,'
      '               pdf.unidade,'
      '               pdf.frete,'
      '               pdf.Acrescimo,'
      '               pdf.valordescontoitem,'
      '               pdf.desconto,'
      '               pdf.seguro,'
      '               cast(pdf.origem as varchar(1)) as origem,'
      '               pdf.despesasacessorias,'
      '               pdf.aliquotaicmsst,'
      '               pdf.icmsbasecalculost,'
      '               pdf.icmsvalorst,'
      '               df.modelodocto,'
      '               df.numprotocolonfe,'
      '               0.00 as devolver'
      #9#9'   '
      #9#9'   from ((dadosfiscais df'
      '              join produtosdadosfiscais pdf'
      '                    join produtos p'
      '                    on pdf.produto = p.codigo'
      '              on df.numero = pdf.dadofiscal)'
      '              join notas n'
      '              on df.numero = n.dadofiscal)'
      #9#9'   '
      '           Where (df.contrato = :contrato)'
      '             and (df.situacao <> '#39'C'#39')'
      '             and (df.numero  = pdf.dadofiscal)'
      '             and (pdf.produto = :produto)'
      '             and (pdf.filial  = :filial)'
      '             and n.dadofiscalvinculado is null'
      '          %FiltroNotas'
      ''
      ''
      '           union all'
      ''
      ''
      '           Select pdf.numero as numeroproduto,'
      '                  pdf.produto, p.codigovisual as produtovisual,'
      '                  pdf.filial,'
      '                  0 as filialnota,'
      '                  '#39#39' as serie,'
      '                  0 as nota,'
      '                  c.filial as filialcupom,'
      '                  c.maquina,'
      '                  c.intervensao,'
      '                  c.numero as cupom,'
      '                  c.dadofiscal as dadofiscal,'
      
        '                  pdf.reducaobase/pdf.quantidade as valorreducao' +
        'baseunitaria,'
      '                  /*'
      
        '                   (pdf.quantidade - (Select coalesce(sum(npd.qu' +
        'antidade),0.00)'
      
        '                                     From notaspagdadosfiscais n' +
        'pd'
      
        '                                     Where (npd.dadofiscal = df.' +
        'numero)'
      
        '                                       and (npd.produto = :produ' +
        'to)'
      
        '                                       and (npd.filial = :filial' +
        '))) as quantidade,'
      '                  */'
      ''
      
        '               (pdf.quantidade - (Select coalesce(sum(pnp.quanti' +
        'dade),0.00)'
      
        '                                 From produtosnotaspag pnp join ' +
        'notaspag np on pnp.codigonota = np.codigo'
      
        '                                 Where pnp.dadofiscal = df.numer' +
        'o'
      '                                   and pnp.produto    = :produto'
      '                                   and pnp.filial     = :filial'
      
        '                                   and pnp.numeroprodutotabela =' +
        ' pdf.numero'
      '                                   and np.situacao = '#39'N'#39
      '                                   )) as quantidade,'
      ''
      '                 pdf.quantidade as qtdeoriginal,'
      '                 pdf.icmsbasecalculo,'
      '                 pdf.icmsvalor,'
      '                 pdf.ipicst,'
      '                 pdf.ipibasecalculo,'
      '                 pdf.valoripi,'
      '                 pdf.iibasecalculo,'
      '                 pdf.iidespaduaneira,'
      '                 pdf.iivalor,'
      '                 pdf.iiiof,'
      '                 pdf.piscst,'
      '                 pdf.pisbasecalculo,'
      '                 pdf.pisaliquota,'
      '                 pdf.pisvalor,'
      '                 pdf.cofinscst,'
      '                 pdf.cofinsbasecalculo,'
      '                 pdf.cofinsaliquota,'
      '                 pdf.cofinsvalor,'
      '                 pdf.classificacaofiscal,'
      '                 pdf.extipi,'
      '                 pdf.genero,'
      '                 pdf.ICMSModalidade,'
      '                 pdf.ICMSModSubst,'
      '                 pdf.TribCodigoEAN,'
      '                 pdf.TribUnidade,'
      '                 pdf.TribQuantidade,'
      '                 pdf.TribUnitario,'
      '                 pdf.Enquadramento,'
      '                 pdf.unidade,'
      '                 pdf.frete,'
      '                 pdf.acrescimo,'
      '                 pdf.valordescontoitem,'
      '                 pdf.desconto,'
      '                 pdf.seguro,'
      '                 cast(pdf.origem as varchar(1)) as origem,'
      '                 pdf.despesasacessorias,'
      '                 pdf.aliquotaicmsst,'
      '                 pdf.icmsbasecalculost,'
      '                 pdf.icmsvalorst,'
      '                 df.modelodocto,'
      '                 df.numprotocolonfe,'
      '                 0.00 as devolver'
      #9#9'   from ((dadosfiscais df'
      '              join produtosdadosfiscais pdf'
      '                   join produtos p'
      '                   on pdf.produto = p.codigo'
      '              on df.numero = pdf.dadofiscal)'
      '              join cupons c'
      '              on df.numero = c.dadofiscal)'
      '           Where (df.contrato = :contrato)'
      '             and (df.situacao <> '#39'C'#39')'
      '             and (df.numero  = pdf.dadofiscal)'
      '             and (pdf.produto = :produto)'
      '             and (pdf.filial  = :filial)'
      '          %FiltroCupons'
      ''
      '          /*'
      '          ) as notascupons'
      'Group By notascupons.dadofiscal'
      '*/')
    RequestLive = True
    Left = 64
    Top = 376
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'produto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'contrato'
        ParamType = ptUnknown
        Value = '477'
      end>
