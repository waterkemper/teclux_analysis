  object qryContratosPorCliente: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterScroll = qryContratosPorClienteAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select c.numero, c.primogenito, c.filialvenda'
      'From   contratos c'
      
        'Where          (c.cliente =:cliente)  /* and (os IS NULL OR os='#39 +
        'false'#39') */'
      '              and (c.tipocliente =:tipo)'
      '              and (c.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39'))'
      '              and (not contratos_renegociado(c.numero))'
      #9#9#9'  '
      '              and (0 < ((Select count(pc.contrato)'
      '                         From produtoscontratos pc'
      '                         Where pc.contrato = c.numero '
      #9#9#9#9#9#9'   and pc.quantidade > coalesce(pc.cancelado,0.00)) +'
      #9#9#9#9#9#9'  '
      '                        (Select count(sc.contrato)'
      '                         From servicoscontratos sc'
      '                         Where sc.contrato = c.numero '
      #9#9#9#9#9#9'   and sc.quantidade > coalesce(sc.cancelado,0.00))))'
      'Order By cast(trim(c.numero) as bigint) desc')
    RequestLive = False
    Left = 65280
    Top = 65486
    ParamData = <
      item
        DataType = ftInteger
        Name = 'cliente'
        ParamType = ptUnknown
        Value = 0
      end
      item
        DataType = ftString
        Name = 'tipo'
        ParamType = ptUnknown
      end>
    object qryContratosPorClientenumero: TStringField
      FieldName = 'numero'
      Required = True
    end
    object qryContratosPorClienteprimogenito: TStringField
      FieldName = 'primogenito'
    end
    object qryContratosPorClientefilialvenda: TIntegerField
      FieldName = 'filialvenda'
    end
  end
  object dsrContratosPorCliente: TtecDataSource
    DataSet = qryContratosPorCliente
    Left = 101
    Top = 70
  end
  object qryContratos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryContratosCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select c.numero,'
      '       c.cliente,'
      '       c.tipocliente,'
      '       c.filialvenda,'
      
        '       (Select f.nome From filiais f Where c.filialvenda = f.cod' +
        'igo) as NomeFilial,'
      '       c.agente,'
      
        '       (Select a.descricao From agentes a Where c.agente = a.cod' +
        'igo) as DescricaoAgente,'
      '       c.vendedor,'
      
        '       (Select u.nome From Usuarios u Where c.vendedor = u.codig' +
        'o) as NomeVendedor,'
      '       c.plano,'
      
        '       (Select p.descricao From planos p Where c.plano = p.codig' +
        'o) as DescricaoPlano,'
      '       c.data,'
      '       c.faturamento,'
      '       c.origem,'
      '       c.valorvista,'
      '       c.valorprazo,'
      '       coalesce(c.desconto, 0.00) as desconto,'
      '       coalesce(c.creditotroca, 0.00) as creditotroca,'
      '       c.consideracoes,'
      '       coalesce(c.frete, 0.00) as frete,'
      '       coalesce(c.seguro, 0.00) as seguro,'
      '       c.taxajuros,'
      '       c.situacao,'
      '       c.listacasamento,'
      '       c.primogenito,'
      ''
      '       (select sum(pc.quantidade *'
      
        '                   pc.precovenda - coalesce(pc.valordescontoitem' +
        ',0))'
      '        from produtoscontratos pc'
      
        '        where pc.contrato = c.numero) - coalesce(c.cupom_valor_d' +
        'esconto,0.00) as valorprodutos,'
      ''
      '       (select sum(pc.quantidade * pc.precovenda)'
      '        from produtoscontratos pc'
      
        '        where pc.contrato = c.numero) as valorprodutossemdescont' +
        'o,'
      ''
      '       (select sum(pc.valordescontoitem)'
      '        from produtoscontratos pc'
      
        '        where pc.contrato = c.numero) + coalesce(c.cupom_valor_d' +
        'esconto,0.00) as valordescontoitem,'
      ''
      ''
      '       c.totalservicos,'
      ''
      
        '       (coalesce(c.frete,0.00) + coalesce(c.seguro,0.00)) as fre' +
        'teseguro,'
      '       (c.valorprazo - c.valorvista) as acrescimo,'
      '       cast((case when c.situacao = '#39'F'#39' then '#39'FATURADO'#39
      
        '                        when c.situacao  = '#39'P'#39' then '#39'NOTA PARCIA' +
        'L'#39
      
        '                        when c.situacao  = '#39'N'#39' then '#39'NOTA FISCAL' +
        #39
      '                end) as varchar) as DescricaoSituacao,'
      '       l.data as datacasamento,'
      '       c.can_data,'
      '       c.can_usuariologado,'
      '       c.can_usuarioautorizacao,'
      ''
      '      (select sum(irc.valorimpostoretido)'
      '       from impostosretidoscontratos irc'
      '       where irc.contrato = :contrato) as valorimpostoretido,'
      '      c.valoricmssubstituicao,'
      
        '      (select sum(pc.valoripi) from produtoscontratos pc where p' +
        'c.contrato = c.numero) as totalIPI  '
      ''
      ''
      ''
      'from contratos c'
      '     left join listascasamento l'
      '     on c.listacasamento = l.codigo'
      ''
      
        'where (c.numero = :contrato) /* and (os IS NULL OR os='#39'false'#39') *' +
        '/'
      ''
      '--for update')
    RequestLive = True
    Left = 64
    Top = 119
    ParamData = <
      item
        DataType = ftString
        Name = 'contrato'
        ParamType = ptUnknown
      end>
