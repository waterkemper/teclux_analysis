  object qryProdutosSeries: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkFields = 'produto=produto'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrProdutosContratos
    Constraints = <>
    AfterPost = qryProdutosSeriesAfterPost
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select ct.filialvenda as filialdocumento,'
      '       cast(null as varchar(3)) as serie,'
      '       cast(null as integer) as nota,'
      '       cast(null as integer) as maquina,'
      '       cast(null as integer) as intervensao,'
      '       cast(null as integer) as cupom,'
      '       cast(null as integer) as dadofiscal,'
      '       pcs.produto,'
      '       p.codigovisual,'
      '       p.descricao,'
      '       pcs.filial,'
      '       pcs.numeroserie,'
      '       false as devolvido'
      ''
      'from produtoscontratosseries pcs'
      '     join contratos ct'
      '     on pcs.contrato = ct.numero'
      '     join produtos p'
      '     on pcs.produto = p.codigo'
      ''
      'where pcs.contrato = :contrato'
      '  and (pcs.produto, pcs.filial, pcs.numeroserie) not in'
      '      (select pdf.produto, pdf.filial, pdfs.numeroserie'
      '       from produtosdadosfiscais pdf'
      '            join dadosfiscais df'
      '            on pdf.dadofiscal = df.numero'
      ''
      '            join produtosdadosfiscaisseries pdfs'
      '            on pdf.dadofiscal = pdfs.dadofiscal'
      '            and pdf.produto = pdfs.produto'
      '            and pdf.numero = pdfs.numero'
      ''
      '       where df.contrato = pcs.contrato'
      '         and pdf.produto = pcs.produto'
      '         and df.situacao <> '#39'C'#39
      '      )'
      '  and not pcs.devolvido'
      ''
      ''
      'union all'
      ''
      ''
      'select n.filial as filialdocumento,'
      '       n.serie,'
      '       n.numero as nota,'
      '       cast(null as integer) as maquina,'
      '       cast(null as integer) as intervensao,'
      '       cast(null as integer) as cupom,'
      '       pdf.dadofiscal,'
      '       pdfs.produto,'
      '       p.codigovisual,'
      '       p.descricao,'
      '       pdf.filial,'
      '       pdfs.numeroserie,'
      '       false as devolvido'
      ''
      'from produtosdadosfiscaisseries pdfs'
      '     join produtosdadosfiscais pdf'
      '          join dadosfiscais df'
      '               join notas n on df.numero = n.dadofiscal'
      '          on pdf.dadofiscal = df.numero'
      '     on pdfs.dadofiscal = pdf.dadofiscal'
      '     and pdfs.numero = pdf.numero'
      '     and pdfs.produto = pdf.produto'
      '     join produtos p'
      '     on pdfs.produto = p.codigo'
      ''
      'where df.contrato = :contrato'
      '  and df.situacao <> '#39'C'#39
      
        '  and (pdfs.dadofiscal, pdfs.numero, pdfs.produto, pdfs.numerose' +
        'rie) not in'
      ''
      
        '      (select pnp.dadofiscal, pnp.numeroprodutotabela, pnp.produ' +
        'to, pnps.numeroserie'
      '       from produtosnotaspag pnp'
      '            join produtosnotaspagseries pnps'
      '            on pnp.codigonota = pnps.codigonota'
      '            and pnp.numero = pnps.numero'
      '            and pnp.produto = pnps.produto'
      ''
      '            join notaspag np'
      '            on pnp.codigonota = np.codigo'
      ''
      '       where pnp.dadofiscal = pdf.dadofiscal'
      '         and pnp.numeroprodutotabela = pdf.numero'
      '         and pnp.produto = pdf.produto'
      '         and np.situacao <> '#39'C'#39
      '      )'
      ''
      ''
      'union all'
      ''
      'select c.filial as filialdocumento,'
      '       cast(null as varchar(3)) as serie,'
      '       cast(null as integer) as nota,'
      '       c.maquina,'
      '       c.intervensao,'
      '       c.numero as cupom,'
      '       pdf.dadofiscal,'
      '       pdfs.produto,'
      '       p.codigovisual,'
      '       p.descricao,'
      '       pdf.filial,'
      '       pdfs.numeroserie,'
      '       false as devolvido'
      ''
      'from produtosdadosfiscaisseries pdfs'
      '     join produtosdadosfiscais pdf'
      '          join dadosfiscais df'
      '               join cupons c on df.numero = c.dadofiscal'
      '          on pdf.dadofiscal = df.numero'
      '     on pdfs.dadofiscal = pdf.dadofiscal'
      '     and pdfs.numero = pdf.numero'
      '     and pdfs.produto = pdf.produto'
      '     join produtos p'
      '     on pdfs.produto = p.codigo'
      ''
      'where df.contrato = :contrato'
      '  and df.situacao <> '#39'C'#39
      
        '  and (pdfs.dadofiscal, pdfs.numero, pdfs.produto, pdfs.numerose' +
        'rie) not in'
      ''
      
        '      (select pnp.dadofiscal, pnp.numeroprodutotabela, pnp.produ' +
        'to, pnps.numeroserie'
      '       from produtosnotaspag pnp'
      '            join produtosnotaspagseries pnps'
      '            on pnp.codigonota = pnps.codigonota'
      '            and pnp.numero = pnps.numero'
      '            and pnp.produto = pnps.produto'
      ''
      '            join notaspag np'
      '            on pnp.codigonota = np.codigo'
      ''
      '       where pnp.dadofiscal = pdf.dadofiscal'
      '         and pnp.numeroprodutotabela = pdf.numero'
      '         and pnp.produto = pdf.produto'
      '         and np.situacao <> '#39'C'#39
      '      )')
    RequestLive = True
    Left = 552
    Top = 544
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'contrato'
        ParamType = ptUnknown
      end>
    object qryProdutosSeriesfilialdocumento: TIntegerField
      FieldName = 'filialdocumento'
    end
