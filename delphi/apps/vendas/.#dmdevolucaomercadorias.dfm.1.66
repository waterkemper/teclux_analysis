  object qryServicosContratos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select   sc.contrato,'
      '         sc.servico,'
      '         s.descricao as descricaoservico,'
      '         sc.quantidade,'
      '         sc.cancelado,'
      '         sc.aliquotaissqn,'
      '         sc.valorservico,'
      '         sc.complementoservico,'
      '         sc.equipamento,'
      '         e.descricao as descricaoequipamento,'
      '         e.referencia,'
      '         e.marca,'
      '         e.modelo,'
      '         e.opcionais,'
      '         e.ano,'
      '         m.descricao as descricaomarca,'
      '         sc.estado,'
      '         sc.cidade,'
      '         (select c.nome'
      '          from cidades c'
      '          where c.estado = sc.estado'
      '           and c.codigo = sc.cidade) as nomecidade,'
      '         sc.reterissqn,'
      '         sc.valorissqn,'
      '         True as ValorISSQNDigitado,'
      '         s.piscst,'
      '         s.pisaliquota,'
      '         s.cofinscst,'
      '         s.cofinsaliquota,'
      '         S.codigolcp116,'
      '         s.cnae,'
      '         s.cstissqn,'
      '        (select ae.codigoatividade'
      '         from atividadeseconomicas ae'
      '         where ae.codigo = s.cnae) as codigoatividade,'
      ''
      ''
      '       round( ( coalesce((select sum(irc.valorimpostoretido)'
      '        from impostosretidoscontratos irc'
      '        where irc.contrato = sc.contrato'
      
        '          and irc.impostoretido <> 5),0)  * (sc.quantidade*sc.va' +
        'lorservico) /'
      ''
      '       (select sum(sc1.quantidade*sc1.valorservico)'
      '        from servicoscontratos sc1'
      '        where sc1.contrato = sc.contrato)) +'
      ''
      '       case when sc.reterissqn and'
      '                 coalesce((select irc.valorimpostoretido'
      '                           from impostosretidoscontratos irc'
      '                           where irc.contrato = sc.contrato'
      
        '                             and irc.impostoretido = 5),0)<>0 th' +
        'en'
      '          coalesce(sc.valorissqn)'
      '       else 0.00 end, 2) as ImpostoRetido,'
      ''
      '       0 as devolver'
      ''
      'From     servicoscontratos sc'
      
        '         left join (equipamentos e left join marcas m on (e.marc' +
        'a = m.codigo))'
      
        '                        on  (sc.equipamento = e.codigo), servico' +
        's s'
      'Where  (sc.servico = s.codigo) and'
      '            (sc.contrato =:contrato)')
    RequestLive = True
    Left = 212
    Top = 242
    ParamData = <
      item
        DataType = ftString
        Name = 'contrato'
        ParamType = ptUnknown
      end>
