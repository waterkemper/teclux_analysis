  object qryCalculosProdutos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'SELECT * from'
      '('
      ' ('
      ' select tipo, incidencia, codigofiscal,'
      
        '        sum(basecalculo) as basecalculo, aliquota, sum(valor) as' +
        ' valor, sum(valorst) as valorst, sum(isentas) as isentas, sum(ou' +
        'tras) as outras,'
      '        sum(basecalculo+isentas+outras) as total'
      ' from'
      '  ('
      '   select cast('#39'ICMS'#39' as varchar(10)) as tipo,'
      
        '         cast(cast(pnp.origem as varchar)||pnp.incidencia as var' +
        'char(4)) as incidencia,'
      '         pnp.codigofiscal,'
      ''
      
        '         (coalesce((case when pnp.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39',' +
        #39'70'#39','#39'90'#39') and not pnp.naogerarcreditoicms then pnp.icmsbasecalc' +
        'ulo else 0 end),0)) as basecalculo,'
      
        '         (case when pnp.naogerarcreditoicms then 0.00 else coale' +
        'sce(pnp.aliquotaicms,0) end) as aliquota,'
      
        '         (coalesce((case when pnp.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39',' +
        #39'70'#39','#39'90'#39') and not pnp.naogerarcreditoicms then pnp.icmsvalor el' +
        'se 0 end),0)) as valor,'
      ''
      '         (coalesce(pnp.icmsvalorst,0)) as valorst,'
      '         (coalesce(pnp.icmsisentas,0)) as isentas,'
      ''
      '         (coalesce(pnp.icmsoutras,0) +'
      ''
      '                    (case when'
      
        '                           pnp.codigofiscal - mod(pnp.codigofisc' +
        'al,1000)=3000 then 0'
      
        '                         else (case when not pnp.icmssobreipi th' +
        'en coalesce(pnp.valoripi,0)'
      '                                    else 0'
      '                               end)'
      '                    end) +'
      '                    coalesce(pnp.valorreducaobase,0) +'
      '                    coalesce(pnp.icmsvalorst,0) +'
      '/*                    coalesce(pnp.reducaobasest,0) +*/'
      
        #9#9#9#9#9'(coalesce((case when pnp.incidencia in ('#39'51'#39','#39'60'#39') and not ' +
        'pnp.naogerarcreditoicms then pnp.icmsbasecalculo else 0 end),0))' +
        ' +'
      
        '          (coalesce((case when pnp.incidencia in ('#39'41'#39') and coal' +
        'esce(pnp.icmsoutras,0)=0 then pnp.icmsbasecalculo else 0 end),0)' +
        ') +'
      
        '          (coalesce((case when coalesce(pnp.icmsoutras,0)=0 and ' +
        'pnp.naogerarcreditoicms then pnp.icmsbasecalculo else 0 end),0))'
      '          ) as outras'
      ''
      ''
      '   from produtosnotaspag pnp'
      '   where pnp.codigonota = :Codigonota'
      '     and not exists (select cnp.codigonota'
      '                    from calculosnotaspagnfe2 cnp'
      '                    where cnp.codigonota = :Codigonota limit 1)'
      '     and not :SimplesNacional'
      '  ) as totalicms'
      '  group by tipo, incidencia, codigofiscal, aliquota'
      '  order by tipo, incidencia, codigofiscal, aliquota'
      ' )'
      ' union all'
      ' ('
      ' select tipo, incidencia, codigofiscal,'
      
        '        sum(basecalculo) as basecalculo, aliquota, sum(valor) as' +
        ' valor, sum(valorst) as valorst, sum(isentas) as isentas, sum(ou' +
        'tras) as outras,'
      '        sum(basecalculo+isentas+outras) as total'
      '  from'
      '  ('
      '   select cast('#39'ICMS'#39' as varchar(10)) as tipo,'
      
        '         cast(cast(pnp.origem as varchar)||pnp.csosn as varchar(' +
        '4)) as incidencia,'
      '         pnp.codigofiscal,'
      ''
      #9'     0.00 as basecalculo,'
      ''
      '       0.00 as aliquota,'
      ''
      #9'     0.00 as valor,'
      ''
      '         (coalesce(pnp.icmsvalorst,0)) as valorst,'
      '         (coalesce(pnp.icmsisentas,0)) as isentas,'
      ''
      ''
      '                coalesce(pnp.icmsoutras,0) +'
      
        '                    (case when pnp.codigofiscal - mod(pnp.codigo' +
        'fiscal,1000)=3000 then 0'
      '                          else (case when not pnp.icmssobreipi'
      
        '                                     then coalesce(pnp.valoripi,' +
        '0)'
      '                                     else 0'
      '                                 end)'
      '                          end) +'
      '                    coalesce(pnp.valorreducaobase,0) +'
      '                    coalesce(pnp.icmsvalorst,0) +'
      '/*                    coalesce(pnp.reducaobasest,0) +*/'
      
        '                   (coalesce((case when coalesce(pnp.icmsoutras,' +
        '0)=0 and coalesce(pnp.icmsisentas,0)=0 then pnp.icmsbasecalculo ' +
        'else 0 end),0))'
      '/*'
      #9#9#9#9#9'case when pnp.csosn = '#39'900'#39' and'
      #9#9#9#9#9'          ((coalesce(pnp.csosn_nf,'#39#39') = '#39'900'#39' and'
      
        #9#9#9#9#9#9#9'   case when coalesce(np.permitirimprimir,false) then coa' +
        'lesce(np.regimetributario,3) = 1'
      #9#9#9#9#9#9#9'   else coalesce(np.crt,3) = 1 end) or'
      
        #9#9#9#9#9#9#9'  (case when coalesce(np.permitirimprimir,false) then coa' +
        'lesce(np.regimetributario,3) <> 1'
      #9#9#9#9#9#9#9'   else coalesce(np.crt,3) <> 1 end'
      #9#9#9#9#9#9#9'   and (coalesce(pnp.cst_nf,'#39#39')='#39'00'#39' or'
      #9#9#9#9#9#9#9'        coalesce(pnp.cst_nf,'#39#39')='#39'10'#39' or'
      #9#9#9#9#9#9#9#9#9'coalesce(pnp.cst_nf,'#39#39')='#39'20'#39' or'
      #9#9#9#9#9#9#9#9#9'coalesce(pnp.cst_nf,'#39#39')='#39'51'#39' or'
      #9#9#9#9#9#9#9#9#9'coalesce(pnp.cst_nf,'#39#39')='#39'70'#39' or'
      
        #9#9#9#9#9#9#9#9#9'coalesce(pnp.cst_nf,'#39#39')='#39'90'#39') )) then coalesce(pnp.icms' +
        'basecalculo,0)'
      #9#9#9#9#9'else'
      #9#9#9#9#9'0'
      #9#9#9#9#9'end'
      '*/'
      ''
      '          as outras'
      ''
      ''
      
        '   from produtosnotaspag pnp join notaspag np on pnp.codigonota ' +
        '= np.codigo'
      '   where pnp.codigonota = :Codigonota'
      '     and not exists (select pnp.codigonota'
      '                    from calculosnotaspagnfe2 cnp'
      '                    where cnp.codigonota = :Codigonota limit 1)'
      '     and :SimplesNacional'
      ''
      '  ) as totalicms'
      '  group by tipo, incidencia, codigofiscal, aliquota'
      '  order by tipo, incidencia, codigofiscal, aliquota'
      '  )'
      '  UNION ALL'
      ' ('
      ' select tipo, incidencia, codigofiscal,'
      
        '        sum(basecalculo) as basecalculo, aliquota, sum(valor) as' +
        ' valor, sum(valorst) as valorst, sum(isentas) as isentas, sum(ou' +
        'tras) as outras,'
      '        sum(basecalculo+isentas+outras) as total'
      ' from'
      '  ('
      '   select cast('#39'TOTAL ICMS'#39' as varchar(10)) as tipo,'
      '          cast(null as varchar(4)) as incidencia,'
      '          cast(null as integer) as codigofiscal,'
      ''
      
        '          (coalesce((case when pnp.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39 +
        ','#39'70'#39','#39'90'#39') and not pnp.naogerarcreditoicms then pnp.icmsbasecal' +
        'culo else 0 end),0)) as basecalculo,'
      '          cast(null as numeric(5,2)) as aliquota,'
      
        '          (coalesce((case when pnp.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39 +
        ','#39'70'#39','#39'90'#39') and not pnp.naogerarcreditoicms then pnp.icmsvalor e' +
        'lse 0 end),0)) as valor,'
      ''
      '          (coalesce(pnp.icmsvalorst,0)) as valorst,'
      '          (coalesce(pnp.icmsisentas,0)) as isentas,'
      ''
      '         (coalesce(pnp.icmsoutras,0) +'
      '                    (case when'
      
        '                           pnp.codigofiscal - mod(pnp.codigofisc' +
        'al,1000)=3000 then 0'
      
        '                         else (case when not pnp.icmssobreipi th' +
        'en coalesce(pnp.valoripi,0)'
      '                                    else 0'
      '                               end)'
      '                    end) +'
      '                    coalesce(pnp.valorreducaobase,0) +'
      '                    coalesce(pnp.icmsvalorst,0) +'
      '/*                    coalesce(pnp.reducaobasest,0) +*/'
      
        #9#9#9#9#9'(coalesce((case when pnp.incidencia in ('#39'51'#39','#39'60'#39') and not ' +
        'pnp.naogerarcreditoicms then pnp.icmsbasecalculo else 0 end),0))' +
        ' +'
      
        '          (coalesce((case when pnp.incidencia in ('#39'41'#39') and coal' +
        'esce(pnp.icmsoutras,0)=0 then pnp.icmsbasecalculo else 0 end),0)' +
        ') +'
      
        '          (coalesce((case when coalesce(pnp.icmsoutras,0)=0 and ' +
        'pnp.naogerarcreditoicms then pnp.icmsbasecalculo else 0 end),0))'
      '          ) as outras'
      ''
      ''
      '   from produtosnotaspag pnp'
      '   where pnp.codigonota = :Codigonota'
      '     and not exists (select cnp.codigonota'
      '                     from calculosnotaspagnfe2 cnp'
      '                     where cnp.codigonota = :Codigonota limit 1)'
      '     and not :SimplesNacional'
      '  ) as totalicms'
      '  group by tipo, incidencia, codigofiscal, aliquota'
      '  order by tipo, incidencia, codigofiscal, aliquota'
      ' )'
      '  union all'
      ' ('
      ' select tipo, incidencia, codigofiscal,'
      
        '        sum(basecalculo) as basecalculo, aliquota, sum(valor) as' +
        ' valor, sum(valorst) as valorst, sum(isentas) as isentas, sum(ou' +
        'tras) as outras,'
      '        sum(basecalculo+isentas+outras) as total'
      ' from'
      '  ('
      '   select cast('#39'TOTAL ICMS'#39' as varchar(10)) as tipo,'
      '          cast(null as varchar(4)) as incidencia,'
      '          cast(null as integer) as codigofiscal,'
      ''
      '          0.00 as basecalculo,'
      ''
      ''
      '          0.00 as aliquota,'
      ''
      '         0.00 as valor,'
      ''
      '          (coalesce(pnp.icmsvalorst,0)) as valorst,'
      '          (coalesce(pnp.icmsisentas,0)) as isentas,'
      ''
      '                coalesce(pnp.icmsoutras,0) +'
      
        '                    (case when pnp.codigofiscal - mod(pnp.codigo' +
        'fiscal,1000)=3000 then 0'
      '                          else (case when not pnp.icmssobreipi'
      
        '                                     then coalesce(pnp.valoripi,' +
        '0)'
      '                                     else 0'
      '                                 end) '
      '                          end) +'
      '                    coalesce(pnp.valorreducaobase,0) +'
      '                    coalesce(pnp.icmsvalorst,0) +'
      '/*                    coalesce(pnp.reducaobasest,0) +*/'
      
        '                    (coalesce((case when coalesce(pnp.icmsoutras' +
        ',0)=0 and coalesce(pnp.icmsisentas,0)=0 then pnp.icmsbasecalculo' +
        ' else 0 end),0))'
      '/*'
      #9#9#9#9#9'case when pnp.csosn = '#39'900'#39' and'
      #9#9#9#9#9'          ((coalesce(pnp.csosn_nf,'#39#39') = '#39'900'#39' and'
      
        #9#9#9#9#9#9#9'   case when coalesce(np.permitirimprimir,false) then coa' +
        'lesce(np.regimetributario,3) = 1'
      #9#9#9#9#9#9#9'   else coalesce(np.crt,3) = 1 end) or'
      
        #9#9#9#9#9#9#9'  (case when coalesce(np.permitirimprimir,false) then coa' +
        'lesce(np.regimetributario,3) <> 1'
      #9#9#9#9#9#9#9'   else coalesce(np.crt,3) <> 1 end'
      #9#9#9#9#9#9#9'   and (coalesce(pnp.cst_nf,'#39#39')='#39'00'#39' or'
      #9#9#9#9#9#9#9'        coalesce(pnp.cst_nf,'#39#39')='#39'10'#39' or'
      #9#9#9#9#9#9#9#9#9'coalesce(pnp.cst_nf,'#39#39')='#39'20'#39' or'
      #9#9#9#9#9#9#9#9#9'coalesce(pnp.cst_nf,'#39#39')='#39'51'#39' or'
      #9#9#9#9#9#9#9#9#9'coalesce(pnp.cst_nf,'#39#39')='#39'70'#39' or'
      
        #9#9#9#9#9#9#9#9#9'coalesce(pnp.cst_nf,'#39#39')='#39'90'#39') )) then coalesce(pnp.icms' +
        'basecalculo,0)'
      #9#9#9#9#9'else'
      #9#9#9#9#9'0'
      #9#9#9#9#9'end'
      '*/'
      '          as outras'
      ''
      ''
      
        '   from produtosnotaspag pnp join notaspag np on pnp.codigonota ' +
        '= np.codigo'
      '   where pnp.codigonota = :Codigonota'
      '     and not exists (select pnp.codigonota'
      '                     from calculosnotaspagnfe2 cnp'
      '                     where cnp.codigonota = :Codigonota limit 1)'
      '     and :SimplesNacional'
      '  ) as totalicms'
      ' group by tipo, incidencia, codigofiscal, aliquota'
      ' order by tipo, incidencia, codigofiscal, aliquota'
      ' )'
      ' union all'
      ' ('
      ' select tipo, incidencia, codigofiscal,'
      
        '        sum(basecalculo) as basecalculo, aliquota, sum(valor) as' +
        ' valor, sum(valorst) as valorst, sum(isentas) as isentas, sum(ou' +
        'tras) as outras,'
      '        sum(basecalculo+valor+isentas+outras) as total'
      ' from'
      '  ('
      '   select cast('#39'IPI'#39' as varchar(10)) as tipo,'
      
        '          cast(cast(pnp.origem as varchar)||pnp.ipicst as varcha' +
        'r(4)) as incidencia,'
      '          pnp.codigofiscal,'
      ''
      
        '          (coalesce((case when not pnp.naogerarcreditoipi then p' +
        'np.ipibasecalculo else 0 end),0)) as basecalculo,'
      
        '          (case when pnp.naogerarcreditoipi then 0.00 else coale' +
        'sce(pnp.AliquotaIPI,0) end) as aliquota,'
      
        '          (coalesce((case when not pnp.naogerarcreditoipi then p' +
        'np.valoripi       else 0 end),0)) as valor,'
      ''
      '          0.00 as valorst,'
      ''
      '          (coalesce(pnp.ipiisentas,0)) as isentas,'
      ''
      '          (coalesce(pnp.ipioutras,0) +'
      
        '           case when (pnp.codigofiscal - MOD(pnp.codigofiscal, 1' +
        '000)) <> 3000 then coalesce(pnp.despesasacessorias,0) else 0 end' +
        '  +'
      '           coalesce(pnp.icmsvalorst,0)) as outras'
      ''
      ''
      '   from produtosnotaspag pnp'
      '   where pnp.codigonota = :Codigonota'
      '     and not exists (select cnp.codigonota'
      '                     from calculosnotaspagnfe2 cnp'
      '                     where cnp.codigonota = :Codigonota limit 1)'
      '     and :ContribIPI'
      '  ) as totalipi'
      ' group by tipo, incidencia, codigofiscal, aliquota'
      ' order by tipo, incidencia, codigofiscal, aliquota'
      ' )'
      ' union all'
      ' ('
      ' select tipo, incidencia, codigofiscal,'
      
        '        sum(basecalculo) as basecalculo, aliquota, sum(valor) as' +
        ' valor, sum(valorst) as valorst, sum(isentas) as isentas, sum(ou' +
        'tras) as outras,'
      '        sum(basecalculo+valor+isentas+outras) as total'
      ' from'
      '  ('
      '   select cast('#39'TOTAL IPI'#39' as varchar(10)) as tipo,'
      '          cast(null as varchar(4)) as incidencia,'
      '          cast(null as integer) as codigofiscal,'
      ''
      
        '          (coalesce((case when not pnp.naogerarcreditoipi then p' +
        'np.ipibasecalculo else 0 end),0)) as basecalculo,'
      '          cast(null as numeric(5,2)) as aliquota,'
      
        '          (coalesce((case when not pnp.naogerarcreditoipi then p' +
        'np.valoripi       else 0 end),0)) as valor,'
      ''
      '          0.00 as valorst,'
      ''
      '          (coalesce(pnp.ipiisentas,0)) as isentas,'
      ''
      '          (coalesce(pnp.ipioutras,0) +'
      
        '          case when (pnp.codigofiscal - MOD(pnp.codigofiscal, 10' +
        '00)) <> 3000 then coalesce(pnp.despesasacessorias,0) else 0 end ' +
        ' +'
      '          coalesce(pnp.icmsvalorst,0)) as outras'
      ''
      ''
      '   from produtosnotaspag pnp'
      '   where pnp.codigonota = :Codigonota'
      '     and not exists (select cnp.codigonota'
      '                     from calculosnotaspagnfe2 cnp'
      '                     where cnp.codigonota = :Codigonota limit 1)'
      '     and :ContribIPI'
      '  ) as totalipi'
      ' group by tipo, incidencia, codigofiscal, aliquota'
      ' order by tipo, incidencia, codigofiscal, aliquota'
      ' )'
      'union all'
      ''
      '('
      
        'select cast ((case when tipo = '#39'M'#39' then cast('#39'ICMS'#39' as varchar(1' +
        '0))'
      
        '                   when tipo = '#39'P'#39' then cast('#39'IPI'#39'  as varchar(1' +
        '0))'
      
        '                   when tipo = '#39'S'#39' then cast('#39'ISS'#39'  as varchar(1' +
        '0))'
      '              end) as varchar) as tipo,'
      '       cast(null as varchar(4)) as incidencia,'
      '       codigofiscal,'
      '       base as basecalculo,'
      '       aliquota,'
      '       valor,'
      '       0.00 as valorst,'
      '       isentas,'
      '       outras,'
      
        '       case when tipo in ('#39'M'#39','#39'S'#39') then base+isentas+outras else' +
        ' base+valor+isentas+outras end as Total'
      ''
      'from calculosnotaspagnfe2'
      'where codigonota = :Codigonota'
      '  and tipo = '#39'M'#39
      'order by codigofiscal, aliquota'
      ')'
      ''
      'union all'
      ''
      '('
      'select totalicms.*'
      'from'
      '('
      'select cast('#39'TOTAL ICMS'#39' as varchar(10))  as tipo,'
      '       cast(null as varchar(4)) as incidencia,'
      '       cast(null as integer) as codigofiscal,'
      '       sum(base) as basecalculo,'
      '       cast(null as numeric(5,2)) as aliquota,'
      '       sum(valor) as valor,'
      '       cast(0 as numeric(15,2)) as valorst,'
      '       sum(isentas) as isentas,'
      '       sum(outras) as outras,'
      '       sum(base+isentas+outras) as Total'
      ''
      'from calculosnotaspagnfe2'
      'where codigonota = :Codigonota'
      '  and tipo = '#39'M'#39
      ') as totalicms where total is not null'
      ')'
      ''
      'union all'
      ''
      '('
      
        'select cast ((case when tipo = '#39'M'#39' then cast('#39'ICMS'#39' as varchar(1' +
        '0))'
      
        '                   when tipo = '#39'P'#39' then cast('#39'IPI'#39'  as varchar(1' +
        '0))'
      
        '                   when tipo = '#39'S'#39' then cast('#39'ISS'#39'  as varchar(1' +
        '0))'
      '              end) as varchar) as tipo,'
      '       cast(null as varchar(4)) as incidencia,'
      '       cast(null as integer) as codigofiscal,'
      '       base as basecalculo,'
      '       aliquota,'
      '       valor,'
      '       0.00 as valorst,'
      '       isentas,'
      '       outras,'
      
        '       case when tipo in ('#39'M'#39','#39'S'#39') then base+isentas+outras else' +
        ' base+valor+isentas+outras end as Total'
      ''
      'from calculosnotaspagnfe2'
      'where codigonota = :Codigonota'
      '  and tipo = '#39'S'#39
      'order by codigofiscal, aliquota'
      ')'
      ''
      'union all'
      ''
      '('
      'select totaliss.*'
      'from'
      '('
      'select cast('#39'TOTAL ISS'#39' as varchar(10))  as tipo,'
      '       cast(null as varchar(4)) as incidencia,'
      '       cast(null as integer) as codigofiscal,'
      '       sum(base) as basecalculo,'
      '       cast(null as numeric(5,2)) as aliquota,'
      '       sum(valor) as valor,'
      '       cast(0 as numeric(15,2)) as valorst,'
      '       sum(isentas) as isentas,'
      '       sum(outras) as outras,'
      '       sum(base+isentas+outras) as Total'
      'from calculosnotaspagnfe2'
      'where codigonota = :Codigonota'
      '  and tipo = '#39'S'#39
      ') as totaliss where total is not null'
      ')'
      ''
      'union all'
      ''
      '('
      
        'select cast ((case when tipo = '#39'M'#39' then cast('#39'ICMS'#39' as varchar(1' +
        '0))'
      
        '                   when tipo = '#39'P'#39' then cast('#39'IPI'#39'  as varchar(1' +
        '0))'
      
        '                   when tipo = '#39'S'#39' then cast('#39'ISS'#39'  as varchar(1' +
        '0))'
      '              end) as varchar) as tipo,'
      '       cast(null as varchar(4)) as incidencia,'
      '       codigofiscal,'
      '       base as basecalculo,'
      '       aliquota,'
      '       valor,'
      '       0.00 as valorst,'
      '       isentas,'
      '       outras,'
      
        '       case when tipo in ('#39'M'#39','#39'S'#39') then base+isentas+outras else' +
        ' base+valor+isentas+outras end as Total'
      ''
      'from calculosnotaspagnfe2'
      'where codigonota = :Codigonota'
      '  and tipo = '#39'P'#39
      'order by codigofiscal, aliquota'
      ')'
      ''
      'union all'
      ''
      '('
      'select totalipi.*'
      'from'
      '('
      'select cast('#39'TOTAL IPI'#39' as varchar(10))  as tipo,'
      '       cast(null as varchar(4)) as incidencia,'
      '       cast(null as integer) as codigofiscal,'
      '       sum(base) as basecalculo,'
      '       cast(null as numeric(5,2)) as aliquota,'
      '       sum(valor) as valor,'
      '       cast(0 as numeric(15,2)) as valorst,'
      '       sum(isentas) as isentas,'
      '       sum(outras) as outras,'
      '       sum(base+valor+isentas+outras) as Total'
      'from calculosnotaspagnfe2'
      'where codigonota = :Codigonota'
      '  and tipo = '#39'P'#39
      ') as totalipi where total is not null'
      ')'
      ''
      ') as selecao')
