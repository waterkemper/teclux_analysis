  object qryClientes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryClientesBeforeOpen
    AfterClose = qryClientesAfterClose
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select f.codigo,'
      '          f.nome,'
      '          f.razao,'
      ''
      '          /*'
      '          case when f.tipo = '#39'F'#39' then coalesce(f.razao, f.nome)'
      
        '               when f.tipo in ('#39'C'#39','#39'L'#39') then coalesce(f.nome, f.' +
        'razao)'
      '          end as razao,'
      '          */'
      ''
      '          f.estado,'
      '          f.pessoanumero,'
      '          f.pessoatipo,'
      '          f.inscricaoestadual,'
      '          f.tipo,'
      '          f.markup,'
      '          f.rua,'
      '          f.bairro,'
      '          f.cidade,'
      '          f.cep,'
      '          f.fonenumero,'
      '          f.foneddd,'
      '          f.numero,'
      '          f.complemento,'
      '          (select b.nome'
      '           from bairros b'
      '           where b.estado = f.estado'
      '             and b.cidade = f.cidade'
      '             and b.codigo = f.bairro) as NomeBairro,'
      '          (select c.nome'
      '           from cidades c'
      '           where c.estado = f.estado'
      '             and c.codigo = f.cidade) as NomeCidade,'
      '          (select c.CodigoIBGE'
      '           from cidades c'
      '           where c.estado = f.estado'
      '             and c.codigo = f.cidade) as CidadeIBGE,'
      '          (select d.tipofornecimento[1]='#39'T'#39
      '           from fornecedores d'
      '           where d.codigo = f.codigo'
      '          ) as tipofornecimento_T,'
      '          (select d1.grupofornecedor'
      '           from fornecedores d1'
      '           where d1.codigo = f.codigo'
      '          ) as grupofornecedor,'
      '          f.debito,'
      
        '          (select descricao from planocontas pl where pl.codigo=' +
        'f.debito) as descricaodebitoplanocontas,'
      
        '          (select classificacao from planocontas pl where pl.cod' +
        'igo=f.debito) as classificacaodebitoplanocontas,'
      '          f.credito,'
      
        '          (select descricao from planocontas pl where pl.codigo=' +
        'f.credito) as descricaocreditoplanocontas,'
      
        '          (select classificacao from planocontas pl where pl.cod' +
        'igo=f.credito) as classificacaocreditoplanocontas,'
      
        '          coalesce((select fo.NaoSubstituto from fornecedores fo' +
        ' where fo.codigo = f.codigo and f.tipo='#39'F'#39'),true) as NaoSubstitu' +
        'to,'
      ''
      '          (case when f.tipo='#39'C'#39' then'
      '                    (select cl.contribicms'
      '                     from clientes cl'
      '                     where cl.codigo = f.codigo)'
      '               when f.tipo='#39'F'#39' then'
      '                    (select fo.contribicms'
      '                     from fornecedores fo'
      '                     where fo.codigo = f.codigo)'
      '               when f.tipo='#39'L'#39' then'
      '                    (select fi.contribicms'
      '                     from filiais fi'
      '                     where fi.codigo = f.codigo)'
      '          end) as contribicms,'
      '          f.email'
      ''
      'from vfornecedores f'
      'where (f.codigo = :codigo) and'
      '          (f.tipo = :tipo)'
      'order by UPPER(TO_ASCII(f.nome,'#39'LATIN1'#39'))')
    RequestLive = True
    Left = 64
    Top = 7
    ParamData = <
      item
        DataType = ftInteger
        Name = 'codigo'
        ParamType = ptUnknown
        Value = 0
      end
      item
        DataType = ftString
        Name = 'tipo'
        ParamType = ptUnknown
      end>
