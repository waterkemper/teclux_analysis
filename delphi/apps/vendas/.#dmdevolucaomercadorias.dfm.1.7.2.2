    Constraints = <>
    AfterOpen = qryProdutosContratosAfterOpen
    AfterInsert = qryProdutosContratosAfterInsert
    AfterScroll = qryProdutosContratosAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select pc.contrato, '
      '           pc.produto,'
      '           pc.quantidade,'
      '           pc.precovenda,'
      '           pc.filial,'
      '           pc.cancelado,'
      '           pc.brinde,'
      '           pc.produtolista,'
      '           pc.frete,'
      '           pc.seguro,'
      '           pc.acrescimo,'
      '           pc.desconto,'
      
        '           coalesce(pc.valordescontoitem,0) as valordescontoitem' +
        ','
      '           p.caracteristica,'
      '           p.descricao,'
      
        '           (select gr.descricao from grades gr where gr.codigo =' +
        ' c.grade1) as linha,'
      
        '           (select gr.descricao from grades gr where gr.codigo =' +
        ' c.grade2) as coluna,'
      '           p.valorgrade1,'
      '           p.valorgrade2,'
      '           c.unidade,'
      '           t.valor as incidencia,'
      '           c.csosn,'
      '           c.origem,'
      '           c.icms,'
      '           c.percreducaobase,'
      
        '           (Select e.futuro From estoques e where e.produto = pc' +
        '.produto and e.filial = :filialdevolucao) as futuro,'
      
        '           (Select valor From estadosicms Where (estado =:estado' +
        ') and (icms =c.icms)) as valoricms,'
      '           (case when (pc.filial <> :filialdevolucao) then'
      
        '                               (Select produtoscontratos_qtdeent' +
        'regue(:primogenito  , pc.produto, pc.filial) -'
      
        '                                           produtoscontratos_qtd' +
        'edevolvida(:primogenito, pc.produto, :filialdevolucao))'
      
        '                     else   (Select  produtoscontratos_qtdeentre' +
        'gue(:primogenito  , pc.produto, pc.filial) -'
      
        '                                           produtoscontratos_qtd' +
        'edevolvida(:primogenito, pc.produto, pc.filial))'
      '            end) as qtdeentregue,'
      '           0.00 as devolver,'
      '           0.00 as qtdeentregueparadevolver,'
      '           0.00 as ValorReducaoBaseUnitaria,'
      '           false as defeito,'
      '           c.composto,'
      '          cast(null as numeric) as icmsbasecalculo,'
      '          cast(null as numeric) as icmsvalor,'
      '          cast(null as numeric) as aliquotaicms,'
      '          cast(null as numeric) as aliquotaicmsst,'
      '          cast(null as numeric) as icmsbasecalculost,'
      '          cast(null as numeric) as icmsvalorst,'
      '          cast(null as varchar) as ipicst,'
      '          cast(null as numeric) as ipibasecalculo,'
      '          cast(null as numeric) as valoripi,'
      '          cast(null as numeric) as aliquotaipi,'
      '          cast(null as varchar) as piscst,'
      '          cast(null as numeric) as pisbasecalculo,'
      '          cast(null as numeric) as pisvalor,'
      '          cast(null as numeric) as pisaliquota,'
      '          cast(null as varchar) as cofinscst,'
      '          cast(null as numeric) as cofinsbasecalculo,'
      '          cast(null as numeric) as cofinsaliquota,'
      '          cast(null as numeric) as cofinsvalor,'
      '          cast(null as varchar) as classificacaofiscal,'
      '          cast(null as varchar) as extipi,'
      '          cast(null as integer) as genero,'
      '          cast(null as integer) as icmsmodalidade,'
      '          cast(null as integer) as icmsmodsubst,'
      '          cast(null as varchar) as tribcodigoean,'
      '          cast(null as varchar) as tribunidade,'
      '          cast(null as numeric) as tribquantidade,'
      '          cast(null as numeric) as tribunitario,'
      '          cast(null as integer) as enquadramento,'
      '          cast(null as numeric) as iibasecalculo,'
      '          cast(null as numeric) as iidespaduaneira,'
      '          cast(null as numeric) as iivalor,'
      '          cast(null as numeric) as iiiof,'
      '          cast(null as numeric) as despesasacessorias'
      
        'From    produtoscontratos pc, produtos p, caracteristicas c, tri' +
        'butosicms t'
      'Where (pc.contrato=:contrato )      and'
      '      (pc.produto = p.codigo)       and'
      '      (p.caracteristica = c.codigo) and'
      '      (t.codigo = c.incidencia)'
      'Order by pc.numero')
    RequestLive = True
    Left = 65
    Top = 243
