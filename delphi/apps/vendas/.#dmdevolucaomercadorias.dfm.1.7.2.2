    Sql.Strings = (
      'Select c.numero, c.primogenito'
      'From   contratos c'
      
        'Where          (c.cliente =:cliente)  and (os IS NULL OR os='#39'fal' +
        'se'#39')'
      '              and (c.tipocliente =:tipo)'
      '              and (c.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39')) '
      '              and (not contratos_renegociado(c.numero)) '
      '              and (0 < (Select count(pc.contrato) '
      '                              From produtoscontratos pc'
      
        '                              Where (pc.contrato = c.numero) and' +
        ' (pc.quantidade > coalesce(pc.cancelado,0))))'
      'Order By cast(trim(c.numero) as bigint) desc')
