      end>
    Sql.Strings = (
      'Select  v.nome,'
      '            v.codigo,'
      '            v.tipo,'
      '            v.estado,'
      '            c.nome as nomecidade,'
      '            cast(case when v.tipo = '#39'C'#39' then '#39'Cliente'#39
      '                            when v.tipo = '#39'F'#39' then '#39'Fornecedor'#39
      
        '                            else                            '#39'Fil' +
        'ial'#39
