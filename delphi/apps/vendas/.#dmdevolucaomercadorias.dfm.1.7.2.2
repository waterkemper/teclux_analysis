      '            formatar_cpf_cnpj(v.pessoanumero) as pessoanumero'
      'From    vfornecedores v join cidades c'
      '        on v.estado = c.estado'
      '        and v.cidade = c.codigo'
      'Where %SQLCliente'
      'Order By UPPER(TO_ASCII(v.nome,'#39'LATIN1'#39'))'
      ''
