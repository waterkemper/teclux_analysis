procedure TdtmDevolucaoMercadorias.dsrCalculosNotasPagDataChange(Sender: TObject; Field: TField);
begin
  inherited;
  {
  if (Field = dtmGerarNotaFiscal.qryCalculosNotasPagbase) then
    dtmGerarNotaFiscal.qryCalculosNotasPagvalor.AsCurrency:=  ((dtmGerarNotaFiscal.qryCalculosNotasPagbase.AsCurrency *
                                                   dtmGerarNotaFiscal.qryCalculosNotasPagaliquota.AsFloat) / 100);
  dsrCalculosNotasPag.OnDataChange:= nil;
  if (Field = dtmGerarNotaFiscal.qryCalculosNotasPagbase)    or
     (Field = dtmGerarNotaFiscal.qryCalculosNotasPagisentas) or
     (Field = dtmGerarNotaFiscal.qryCalculosNotasPagoutras)  then
  begin
     if dtmGerarNotaFiscal.qryCalculosNotasPag.State = dsEdit then
       ReCalcularValoresCalculosFiscais;
  end;
  dsrCalculosNotasPag.OnDataChange:= dsrCalculosNotasPagDataChange;
  }
end;

function TdtmDevolucaoMercadorias.ValidarValoresNota: Boolean;
begin
  result := true;
  {
  Result:= (not ClienteTrouxeNota or
           (ClienteTrouxeNota  and
            ((contribicms and (qryNotasPagvaloricms.AsCurrency
                              = qryNotasPagvalornota.AsCurrency)) or
             (contribipi  and (qryNotasPagvaloripi.AsCurrency
                              = qryNotasPagvalornota.AsCurrency)))
            ));
  }             
end;

procedure TdtmDevolucaoMercadorias.ReCalcularValoresNota;
begin
  if qryNotasPag.State = dsEdit then begin
    qryNotasPagvalornota.AsCurrency:= (qryNotasPagacrescimo.AsCurrency     +
                                       qryNotasPagtotalprodutos.AsCurrency +
                                       qryNotasPagfreteinterno.AsCurrency  +
                                       qryNotasPagseguro.AsCurrency        -
                                       qryNotasPagdesconto.AsCurrency);
  end;
end;

procedure TdtmDevolucaoMercadorias.dsrNotasPagDataChange(Sender: TObject; Field: TField);
begin
  inherited;
  dsrNotasPag.OnDataChange:= nil;
  if (Field = qryNotasPagacrescimo)    or
     (Field = qryNotasPagdesconto)     or
     (Field = qryNotasPagseguro)       or
     (Field = qryNotasPagfreteinterno) then
     ReCalcularValoresNota;
  dsrNotasPag.OnDataChange:= dsrNotasPagDataChange;
end;

{
procedure TdtmDevolucaoMercadorias.ReCalcularValoresCalculosFiscais;
var
  Pos: TBookmark;
  TotalICMS, TotalIPI: Currency;
begin
  TotalICMS := 0;
  TotalIPI := 0;
  Pos:= dtmGerarNotaFiscal.qryCalculosNotasPag.GetBookmark;
  dtmGerarNotaFiscal.qryCalculosNotasPag.DisableControls;
  dtmGerarNotaFiscal.qryCalculosNotasPag.First;
  try
    while not dtmGerarNotaFiscal.qryCalculosNotasPag.Eof do
    begin
      if dtmGerarNotaFiscal.qryCalculosNotasPagtipo.AsString = 'M' then
         TotalICMS := TotalICMS + (dtmGerarNotaFiscal.qryCalculosNotasPagbase.AsCurrency    +
                                   dtmGerarNotaFiscal.qryCalculosNotasPagisentas.AsCurrency +
                                   dtmGerarNotaFiscal.qryCalculosNotasPagoutras.AsCurrency);

      if dtmGerarNotaFiscal.qryCalculosNotasPagtipo.AsString = 'P' then
         TotalIPI := TotalIPI + (dtmGerarNotaFiscal.qryCalculosNotasPagbase.AsCurrency    +
                                 dtmGerarNotaFiscal.qryCalculosNotasPagisentas.AsCurrency +
                                 dtmGerarNotaFiscal.qryCalculosNotasPagoutras.AsCurrency);

      dtmGerarNotaFiscal.qryCalculosNotasPag.Next;
    end;

    if not (qryNotasPag.State in [dsEdit, dsInsert]) then
      qryNotasPag.Edit;
    qryNotasPagtotalcalculosicms.AsCurrency:= TotalICMS;
    qryNotasPagtotalcalculosipi.AsCurrency:= TotalIPI;
  finally
    dtmGerarNotaFiscal.qryCalculosNotasPag.EnableControls;
    dtmGerarNotaFiscal.qryCalculosNotasPag.GotoBookmark(Pos);
    dtmGerarNotaFiscal.qryCalculosNotasPag.FreeBookmark(Pos);
  end;
end;
}

procedure TdtmDevolucaoMercadorias.qryCalculosNotasPagAfterInsert(DataSet: TDataSet);
begin
  inherited;
  if not InserindoCalculos then
{    dtmGerarNotaFiscal.qryCalculosNotasPag.Cancel;}
end;

function TdtmDevolucaoMercadorias.GetDataContrato: TDateTime;
begin
  Result:= qryContratosfaturamento.AsDateTime;
end;

function TdtmDevolucaoMercadorias.VerificarSerieFilial: Boolean;
begin
  ReFazConsulta(qryNumeroNota, [0, 1], [FilialBase, SerieSugestao]);
  if qryNumeroNota.RecordCount = 0 then begin
    MensagemAviso(format(ctFILIALSEMSERIE, [FilialBase, 'mercadorias']));
    Result := False;
  end else if qryNumeroNotamodelonota.IsNull then begin
    MensagemAviso(ctSERIESUGESTAOSEMMODELO);
    Result := False;
  end else
    Result := True;
end;

procedure TdtmDevolucaoMercadorias.ExisteProdutoEmitirNota;
begin
  if qryContratossituacao.AsString = 'F' then
    TemProdutoImprimirNota:= False
  else begin
    TemProdutoImprimirNota:=  False;
    qryProdutosContratos.First;
    while not qryProdutosContratos.Eof do begin
      TemProdutoImprimirNota:= ((qryProdutosContratosqtdeentregueparadevolver.AsCurrency > 0) or
                                 TemProdutoImprimirNota);
      qryProdutosContratos.Next;
    end;
  end;
end;


procedure TdtmDevolucaoMercadorias.qryDadosFiscaisAfterInsert(DataSet: TDataSet);
begin
  inherited;
  qryDadosFiscais.Cancel;
end;


procedure TdtmDevolucaoMercadorias.RecalcularParcelaOrigem;
const
 Numero = 1;
 Vencimento = 2;
var
 RegistroAtual: TBookmark;
 ParcelasAuxiliar: array[1..2] of TStringList;
 A,B, QTP, NP, NumeroParcela : integer;
 Vencto : STring;
begin
 RegistroAtual := qryParcelasContratos.GetBookmark;
 ParcelasAuxiliar[Numero] := TStringList.Create;
 ParcelasAuxiliar[Vencimento] := TStringList.Create;

 NumeroParcela := 0;
 qryParcelasContratos.DisableControls;
 qryParcelasContratos.First;
 while not qryParcelasContratos.Eof do begin
  if (qryParcelasContratosnumero.AsInteger > NumeroParcela) then
   NumeroParcela := qryParcelasContratosnumero.AsInteger
  else
   if (qryParcelasContratosnumero.AsInteger = 0) then
   begin
    NumeroParcela := NumeroParcela + 1;
    qryParcelasContratos.Edit;
    qryParcelasContratosnumero.AsInteger := NumeroParcela;
    qryparcelascontratos.Post;
   end;
  ParcelasAuxiliar[Vencimento].Append(qryParcelasContratosdatavencto.AsString);
  ParcelasAuxiliar[Numero].Append(qryParcelasContratosnumero.AsString);
  qryParcelasContratos.Next;
 end;

 for A := 1 to ParcelasAuxiliar[Vencimento].Count - 1 do
 begin
  B := A;
  While strtodatetime(ParcelasAuxiliar[Vencimento].Strings[B])<
        strtodatetime(ParcelasAuxiliar[Vencimento].Strings[B-1]) do
  begin
   ParcelasAuxiliar[Vencimento].Move(B,B-1);
   ParcelasAuxiliar[Numero].Move(B,B-1);
   if B=1 then
     break
   else
     B := B-1;
  end;
 end;

 QTP:= 0;
 Vencto := '';
 for A := 0 to ParcelasAuxiliar[Vencimento].Count - 1 do
 if ParcelasAuxiliar[Vencimento].Strings[A] <> Vencto then
 begin
   QTP := QTP + 1;
   Vencto := ParcelasAuxiliar[Vencimento].Strings[A];
 end;

 NP:= 0;
 Vencto := '';
 for A := 0 to ParcelasAuxiliar[Vencimento].Count - 1 do
 begin
  if ParcelasAuxiliar[Vencimento].Strings[A] <> Vencto then
  begin
   NP := NP + 1;
   Vencto := ParcelasAuxiliar[Vencimento].Strings[A];
  end;
  if qryParcelasContratos.locate('numero;datavencto',
          vararrayof([strtoint(ParcelasAuxiliar[Numero].Strings[A]),
                 strtodatetime(ParcelasAuxiliar[Vencimento].Strings[A])]), []) then
  begin
   qryParcelasContratos.Edit;
   qryParcelasContratosparcelaorigem.AsString := inttostr(NP)+'/'+inttostr(QTP);
   qryParcelasContratos.Post;
  end;
 end;
 ParcelasAuxiliar[Vencimento].free;
 ParcelasAuxiliar[Numero].free;
 qryParcelasContratos.GotoBookmark(RegistroAtual);
 qryParcelasContratos.EnableControls;
end;

procedure TdtmDevolucaoMercadorias.qryProdutosContratosAfterOpen(DataSet: TDataSet);
begin
  inherited;
  qryProdutosContratosvalorgrade1.Visible := ParSistema.UsarGradesProdutos;
  qryProdutosContratosvalorgrade2.Visible := ParSistema.UsarGradesProdutos;
end;

