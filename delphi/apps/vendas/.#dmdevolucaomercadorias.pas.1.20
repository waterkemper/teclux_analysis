function TdtmDevolucaoMercadorias.TodosProdutosEntreguesDevolvidos: Boolean;
var
  Aux: Boolean;
begin
  Aux:= False;
  qryProdutosContratos.First;
  while not qryProdutosContratos.Eof do begin
    Aux:= (((qryProdutosContratosqtdeentregue.AsCurrency = 0) and
            (qryContratossituacao.AsString<>'P')) or
           ((qryProdutosContratosqtdeentregue.AsCurrency > 0) and
            (qryProdutosContratosqtdeentregueparadevolver.AsCurrency = qryProdutosContratosqtdeentregue.AsCurrency)));
    if not Aux then
      Break;
    qryProdutosContratos.Next;
  end;
  Result:= Aux;
end;

function TdtmDevolucaoMercadorias.TodosProdutosDevolvidos: Boolean;
var
  Aux: Boolean;
begin
  Aux:= False;
  qryProdutosContratos.First;
  while not qryProdutosContratos.Eof do begin
    Aux:= (((qryProdutosContratosquantidade.AsCurrency = qryProdutosContratoscancelado.AsCurrency) and
            (qryProdutosContratosdevolver.AsCurrency = 0)) or
           ((qryProdutosContratosdevolver.AsCurrency > 0) and
            ((qryProdutosContratosquantidade.AsCurrency - qryProdutosContratoscancelado.AsCurrency) = qryProdutosContratosdevolver.AsCurrency)));
    if not Aux then
      Break;
    qryProdutosContratos.Next;
  end;
  Result:= Aux;
end;

procedure TdtmDevolucaoMercadorias.ValidarTotaisNotasPag_TotaisDadosFiscais;
var
  VTotal, VFrete, VSeguro, VDesconto, VAcrescimo: Currency;
begin
  VTotal:= 0; VFrete:= 0; VSeguro:= 0; VDesconto:= 0; VAcrescimo:= 0;
  ReFazConsulta(qryTotaisNotasPag,[0],[qryContratosnumero.AsString]);
  ReFazConsulta(qryTotaisDadosFiscais,[0],[qryContratosnumero.AsString]);

  qryNotasPag.First;
  while not qryNotasPag.Eof do begin
    VTotal    := VTotal     + qryNotasPagvalornota.AsCurrency;
    VFrete    := VFrete     + qryNotasPagfreteinterno.AsCurrency;
    VSeguro   := VSeguro    + qryNotasPagseguro.AsCurrency;
    VDesconto := VDesconto  + qryNotasPagdesconto.AsCurrency;
    VAcrescimo:= VAcrescimo + qryNotasPagacrescimo.AsCurrency;
    qryNotasPag.Next;
  end;
  VTotal    := VTotal     + qryTotaisNotasPagtotal_nota.AsCurrency;
  VFrete    := VFrete     + qryTotaisNotasPagtotal_frete.AsCurrency;
  VSeguro   := VSeguro    + qryTotaisNotasPagtotal_seguro.AsCurrency;
  VDesconto := VDesconto  + qryTotaisNotasPagtotal_desconto.AsCurrency;
  VAcrescimo:= VAcrescimo + qryTotaisNotasPagtotal_acrescimo.AsCurrency;

  if truncar(VTotal,2) <> qryTotaisDadosFiscaistotal_nota.AsCurrency then begin
    qryNotasPag.Edit;
    qryNotasPagvalornota.AsCurrency:= qryNotasPagvalornota.AsCurrency +
                                      (qryTotaisDadosFiscaistotal_nota.AsCurrency - VTotal);
    qryNotasPag.Post;
  end;

  if truncar(VFrete,2) <> qryTotaisDadosFiscaistotal_frete.AsCurrency then begin
    qryNotasPag.Edit;
    qryNotasPagfreteinterno.AsCurrency:= qryNotasPagfreteinterno.AsCurrency +
                                      (qryTotaisDadosFiscaistotal_frete.AsCurrency - VFrete);
    qryNotasPag.Post;
  end;

  if truncar(VSeguro,2) <> qryTotaisDadosFiscaistotal_seguro.AsCurrency then begin
    qryNotasPag.Edit;
    qryNotasPagseguro.AsCurrency:= qryNotasPagseguro.AsCurrency +
                                      (qryTotaisDadosFiscaistotal_seguro.AsCurrency - VSeguro);
    qryNotasPag.Post;
  end;

  if truncar(VDesconto,2) <> qryTotaisDadosFiscaistotal_desconto.AsCurrency then begin
    qryNotasPag.Edit;
    qryNotasPagdesconto.AsCurrency:= qryNotasPagdesconto.AsCurrency +
                                      (qryTotaisDadosFiscaistotal_desconto.AsCurrency - VDesconto);
    qryNotasPag.Post;
  end;

  if truncar(VAcrescimo,2) <> (qryTotaisDadosFiscaistotal_nota.AsCurrency -
                    qryTotaisDadosFiscaistotal_vista.AsCurrency) then begin
    qryNotasPag.Edit;
    qryNotasPagacrescimo.AsCurrency:= qryNotasPagacrescimo.AsCurrency +
                                      ((qryTotaisDadosFiscaistotal_nota.AsCurrency -
                                        qryTotaisDadosFiscaistotal_vista.AsCurrency) - VAcrescimo);

    qryNotasPag.Post;
  end;
end;


function TdtmDevolucaoMercadorias.NotasFiscaisDevolucaoContrato: Boolean;
var
//  TipoNota: TtecTipoNota;
  Pos: TBookmark;
  Cont: Integer;
begin
  Result := False;
  if ((qryContratossituacao.AsString = 'N') or (qryContratossituacao.AsString = 'P')) and
       TemProdutoImprimirNota then
  begin
    if ClienteTrouxeNota and ((SerieDevolucao = '') or (NumeroDevolucao = '') or (DataDevolucao = '')) then
    begin
      MensagemAviso(ctDEVOLUCAONAOCONCLUIDA);
      ReFazConsultaTabelas;
    end
    else
    begin
      if qryNotasPag.Active then
        qryNotasPag.Close;
      qryNotasPag.Open;

      if qryProdutosNotasPag.Active then
        qryProdutosNotasPag.Close;
      qryProdutosNotasPag.Open;

{      if dtmGerarNotaFiscal.qryCalculosNotasPag.Active then
        dtmGerarNotaFiscal.qryCalculosNotasPag.Close;
      dtmGerarNotaFiscal.qryCalculosNotasPag.Open;}

      Pos := qryProdutosContratos.GetBookmark;
      qryProdutosContratos.DisableControls;

      ReFazConsulta(qryNaturezasPadrao,[],[]);

      try
        Cont := 0;

        PreencherNotaFiscal(true);

        qryProdutosContratos.First;
        while not qryProdutosContratos.Eof do
        begin
          if (qryProdutosContratosqtdeentregueparadevolver.AsCurrency > 0) then
          begin
            result := PreencherProdutosNotasFiscal(Cont+1);
            if not result then
              break;
            inc(cont);
          end;
          qryProdutosContratos.Next
        end;

        if result then
        begin
          PreencherNotaFiscal(false);
          result := CalcularImpostos(qryProdutosNotasPag, qryNotaspag, contribipi, true, true, qryCalculosProdutos, nil, false, Devolucao);
//        CalcularDadosFiscais;

          if TodosProdutosEntreguesDevolvidos then
            ValidarTotaisNotasPag_TotaisDadosFiscais;
        end
        else
          qrynotaspag.Delete;

      finally
        qryProdutosContratos.GotoBookmark(Pos);
        qryProdutosContratos.FreeBookmark(Pos);
        qryProdutosContratos.EnableControls
      end;
    end
  end
end;

function TdtmDevolucaoMercadorias.GravarDevolucaoMercadoria: Boolean;
var
  Usuario           : TtecUsuarios;
  I, CodigoNota: Integer;
  TemProdutoDevolver, ContratoContinuaParcial: Boolean;
//  TipoNota: TtecTipoNota;
  DF: Integer;
  ObsNotasPag,
  ChaveAcesso: String;

  procedure ObservacaoNotasPag;
  begin
    qryDadosFiscais.Close;
    qryDadosFiscais.MacroByName('FiltroNotas').AsString := 'and (df.numero = ' + qryNotasPagDadosFiscaisdadofiscal.Asstring + ')';
    qryDadosFiscais.MacroByName('FiltroCupons').asstring := 'and (df.numero = ' + qryNotasPagDadosFiscaisdadofiscal.Asstring + ')';
    qryDadosFiscais.Params[0].AsString:= IntToStr(qryNotasPagDadosFiscaisproduto.AsLargeInt);
    qryDadosFiscais.Params[1].AsInteger := qryProdutosContratosfilial.AsInteger;
    qryDadosFiscais.Params[2].AsString := qryContratosnumero.AsString;
    qryDadosFiscais.Open;
    if (qryDadosFiscais.RecordCount > 0) then begin
      if (qryDadosFiscaisnota.AsInteger > 0) then begin
        if Pos(qryDadosFiscaisnota.AsString,ObsNotasPag) = 0 then
          ObsNotasPag:= ObsNotasPag + '[ NF: S' +
                        qryDadosFiscaisserie.AsString + '  N' + qryDadosFiscaisnota.AsString + ' ]' + sLineBreak
      end else if (qryDadosFiscaiscupom.AsInteger > 0) then begin
        if Pos(qryDadosFiscaisnota.AsString,ObsNotasPag) = 0 then
          ObsNotasPag:= ObsNotasPag + '[ CF: M' +
                        qryDadosFiscaismaquina.AsString + '  I' + qryDadosFiscaisintervensao.AsString +
                        '  N' + qryDadosFiscaisCupom.AsString + ' ]' + sLineBreak;
      end;
    end;
  end;

  procedure AtualizarCodigoNotaProdutos;
  begin
    qryProdutosNotasPag.First;
    while not qryProdutosNotasPag.Eof do begin
      if ClienteTrouxeNota or (qryProdutosNotasPagcodigonota.AsInteger = 0{Ord(TipoNota)}) then begin
        qryProdutosNotasPag.Edit;
        qryProdutosNotasPagcodigonota.AsInteger:= CodigoNota;
        qryProdutosNotasPag.Post;

        // Atualiza o CodigoNota na Tabela NotasPagDadosFiscais.
        DF:= 0;
        qryNotasPagDadosFiscais.First;
        while not qryNotasPagDadosFiscais.Eof do begin
          if (qryNotasPagDadosFiscaisproduto.AsLargeInt = qryProdutosNotasPagProduto.AsLargeInt) then begin
            if (DF <> qryNotasPagDadosFiscaisdadofiscal.AsInteger) then
              ObservacaoNotasPag;
            qryNotasPagDadosFiscais.Edit;
            qryNotasPagDadosFiscaiscodigonota.AsInteger:= CodigoNota;
            qryNotasPagDadosFiscais.Post;
            DF:= qryNotasPagDadosFiscaisdadofiscal.AsInteger;
          end;
          qryNotasPagDadosFiscais.Next;
        end;
      end;
      qryProdutosNotasPag.Next;
    end;
  end;

  procedure AtualizarCodigoNotaCalculos;
  begin
  {
    dtmGerarNotaFiscal.qryCalculosNotasPag.First;
    while not dtmGerarNotaFiscal.qryCalculosNotasPag.Eof do begin
      if ClienteTrouxeNota or (dtmGerarNotaFiscal.qryCalculosNotasPagCodigoNota.AsInteger = 0) then begin
        dtmGerarNotaFiscal.qryCalculosNotasPag.Edit;
        dtmGerarNotaFiscal.qryCalculosNotasPagcodigonota.AsInteger := CodigoNota;
        dtmGerarNotaFiscal.qryCalculosNotasPag.Post;
      end;
      dtmGerarNotaFiscal.qryCalculosNotasPag.Next;
    end;
  }
  end;

begin
  result := True;

  if UsuarioLogin.DevolucaoProduto then
  begin
    Usuario:= ObterAutorizacao(taSENHA);
    if Assigned(Usuario) then
      FUsuarioAutorizacao := Usuario.CodigoUsuario;
  end
  else
  begin
    Usuario:= ObterAutorizacao(taLOGIN, ctDEVOLUCAOPRODUTO, ctAUTORIZADO);
    if Assigned(Usuario) then
      FUsuarioAutorizacao := Usuario.CodigoUsuario;
  end;

  try
    if Assigned(Usuario) and Usuario.DevolucaoProduto then begin
       // Atribuir o Numero da Nota Fiscal
      if ClienteTrouxeNota  then begin
        spcNotasPagProximoCodigo.Open;
        CodigoNota := spcNotasPagProximoCodigocodigo.AsInteger;
        spcNotasPagProximoCodigo.close;

        AtualizarCodigoNotaProdutos;
        AtualizarCodigoNotaCalculos;

        qryNotasPag.Edit;
        qryNotasPagcodigo.AsInteger    := CodigoNota;
        qryNotasPagobservacoes.AsString:= qryNotasPagobservacoes.AsString + sLineBreak +
                                          'REF. NOTA(s) SAIDA(s): ' + ObsNotasPag;
        qryNotasPag.Post;
      end
      else if ((qryContratossituacao.AsString = 'N') or (qryContratossituacao.AsString = 'P')) and
                TemProdutoImprimirNota then begin
        if VerificarSerieFilial then
        begin
          if NotasFiscaisDevolucaoContrato then
          begin
//          for TipoNota := tnNORMAL to tnSUBSTTRIB do begin
            qryNotasPag.First;
            while not qryNotasPag.Eof do begin
              if (qryNotasPagnrdocumento.AsInteger = 0{Ord(TipoNota)}) then
              begin
                spcNotasPagProximoCodigo.Open;
                CodigoNota := spcNotasPagProximoCodigocodigo.AsInteger;
                spcNotasPagProximoCodigo.close;
                AtualizarCodigoNotaProdutos;
                AtualizarCodigoNotaCalculos;
                qryNotasPag.Edit;
                qryNotasPagnrdocumento.AsInteger := qryNumeroNotanumeroinicial.AsInteger;
                qryNotasPagcodigo.AsInteger      := CodigoNota;
                qryNotasPagobservacoes.AsString  := qryNotasPagobservacoes.AsString + sLineBreak +
                                                    'REF. NOTA(s) SAIDA(s): ' + ObsNotasPag;
                qryNotasPag.Post;

                qryNumeroNota.Edit;
                qryNumeroNotanumeroinicial.AsInteger := qryNumeroNotanumeroinicial.AsInteger + 1;
                qryNumeroNota.Post;
              end;

              if CondicaoEmissorNFE then
              begin
                // DADOS NF-e
                qryNotasPag.Edit;
                qryNotasPagversaolayout.AsCurrency := 2.00;
                if qryNotasPagmodelodocto.IsNull then
                  qryNotasPagmodelodocto.AsString  := '55';

                qryNotasPagcodaleatorio.AsInteger  := Aleatorio(qryNotasPagdata.AsDateTime, qryNotasPagnrdocumento.Asstring);

                { 0 – pagamento à vista   1 – pagamento à prazo     2 - outros }
                qryNotasPagformapagto.AsInteger    := 2;
                { 1-Retrato/ 2-Paisagem }
                qryNotasPagformatodanfe.AsInteger  := 1;
                {1-Normal/ 2-Contingência}
                qryNotasPagformaemissao.AsInteger  := NFeTipoEmissao;

                ChaveAcesso :=
                           copy(CodigoCidadeIBGEFilialBase,1,2)+                            // 2
                           FormatDateTime('YYMM',qryNotasPagdata.AsDateTime)+             // 4
                           preencheString(CNPJFilialBase,'0',14,false)+                     // 14
                           preencheString(qryNotasPagmodelodocto.AsString,'0',2,false)+   // 2
                           preencheString(SerieSugestao,'0',3,false)+                       // 3
                           preencheString(qryNotasPagnrdocumento.Asstring,'0',9,false) +       // 9
                           qryNotasPagformaemissao.Asstring + //1
                           preencheString(qryNotasPagcodaleatorio.Asstring,'0',8,false);  // 8

                qryNotasPagdigchaveacesso.AsString  := Modulo11(ChaveAcesso);
                qryNotasPagchv_nfe.AsString  := ChaveAcesso+qryNotasPagdigchaveacesso.AsString;


                {1 - PRODUÇÃO 2 - HOMOLOGAÇÃO}
                qryNotasPagambiente.AsInteger       := NFeAmbiente;// '2';

                {1 - normal 2 - compelementar}
                qryNotasPagfinalidadenf.AsInteger   := 1;

                qryNotasPagprocemissao.AsString     := '0';
                qryNotasPagversaoteclux.AsString    := VersaoTecLUX;
                qryNotasPaginfcomplementar.AsString := qryNotasPagobservacoes.AsString;
                qryNotasPag.Post;
              end;

              qryNotasPag.Next;
            end;
          end;
        end;
      end;
      MovimentarProdutosNota;

      TemProdutoDevolver:= False;
      ContratoContinuaParcial := false;

      qryProdutosContratos.DisableControls;
      try
        qryProdutosContratos.First;
        for I:= 0 to (qryProdutosContratos.RecordCount - 1) do begin
          if not qryProdutosContratosbrinde.AsBoolean then begin
            if (qryProdutosContratosdevolver.AsCurrency > 0) then begin
              qryProdutosContratos.Edit;
              qryProdutosContratoscancelado.AsCurrency   := (qryProdutosContratoscancelado.AsCurrency + qryProdutosContratosdevolver.AsCurrency);
              qryProdutosContratosprecovenda.AsCurrency  := Precos[I];
              qryProdutosContratos.Post;
                                               {
              if (qryContratoslistacasamento.AsInteger > 0)            and
                 (qryContratosdatacasamento.AsDateTime >= DataServidor) and
                 qryProdutosContratosprodutolista.AsBoolean then
                 AtualizaProdutosListaCasamento;
                 }
            end;
            TemProdutoDevolver:= (TemProdutoDevolver or
                                 ((qryProdutosContratoscancelado.AsCurrency < qryProdutosContratosQuantidade.AsCurrency) and
                                   not qryProdutosContratosbrinde.AsBoolean));
            ContratoContinuaParcial := ContratoContinuaParcial or
                                 ((qryProdutosContratosquantidade.AsCurrency -
                                   qryProdutosContratosqtdeentregue.AsCurrency -
                                   qryProdutosContratoscancelado.AsCurrency)>0)

          end;

          qryProdutosContratos.Next;
        end;
      finally
        qryProdutosContratos.EnableControls;
      end;

      // Atualiza Situacao Contrato.
      if ({FCancelarTotal or XX-Jander} not TemProdutoDevolver) and (FValorAberto = 0) then
        qryContratossituacao.AsString:= 'C'
      else
        if (qryContratossituacao.asstring = 'P') and not ContratoContinuaParcial then
          qryContratossituacao.AsString := 'N';

      // Verificar Devolucao Total com Parcelas a ser quitada.

      if TemProdutoImprimirNota and not ClienteTrouxeNota then
      begin
        if CondicaoEmissorNFE then
          result := EmitirNFe(True);
      end;

      if result then
      begin
        qryContratos.Post;
        Perpetrar([qryContratos  , qryParcelasContratos, qryProdutosContratos,
                   qryPrecos     , qryProdutos         , qryEstoques         ,
                   qryNotasPag   , qryProdutosNotasPag ,
                   {dtmGerarNotaFiscal.qryCalculosNotasPag ,} qryNumeroNota,
                   qryContratosDevolvidos, qryNotasPagDadosFiscais, {qryProdutosListaCasamento,} qryMovimentos]);

        if TemProdutoImprimirNota and not ClienteTrouxeNota then begin

          if MensagemConfirmacao(ctEMITIRNOTAFISCALDEVOLUCAO) = smbOk then
          begin
            if CondicaoEmissorNFE then
               EmitirNFe
            else
              ImprimirNota;
          end;

        end;

        if MensagemConfirmacao(ctEMITIRCARNEDEVOLUCAO) = smbOk then
          ImprimirCarne;
      end;
      ReFazConsultaContratosPorCliente;

    end
    else begin
      MensagemAviso(ctUSUARIOSEMPERMISSAO);
    end;
    if qryNotasPag.Active then
      qryNotasPag.Close;
    if qryProdutosNotasPag.Active then
      qryProdutosNotasPag.Close;
{
    if dtmGerarNotaFiscal.qryCalculosNotasPag.Active then
      dtmGerarNotaFiscal.qryCalculosNotasPag.Close;
}      
    if qryContratosDevolvidos.Active then
      qryContratosDevolvidos.Close;
    if qryMovimentos.Active then
      qryMovimentos.Close;
    if qryEstoques.Active then
      qryEstoques.Close;
    if qryProdutos.Active then
      qryProdutos.Close;
    if qryPrecos.Active then
      qryPrecos.Close;
    if qryNotasPagDadosFiscais.Active then
      qryNotasPagDadosFiscais.Close;
  finally
    Usuario.Free;
    ReFazConsultaTabelas;
  end;
end;

function TdtmDevolucaoMercadorias.GravarParcelas: Boolean;
begin
  Result:= False;
  if qryParcelasContratos.CheckRequiredFields then begin
    qryParcelasContratosparcelaadicional.AsBoolean := True;
    qryParcelasContratos.Post;
    RecalcularParcelaOrigem;
    Result:= True;
  end;
end;

function TdtmDevolucaoMercadorias.IncluirParcelas(Editar: Boolean): Boolean;
begin
  Result:= False;
  if not Editar then begin
    qryParcelasContratos.Append;
    qryParcelasContratoscontrato.AsString:= qryContratosnumero.AsString;
    Result:= True;
  end;
end;

procedure TdtmDevolucaoMercadorias.IniciarDevolucao;
var
  I: Integer;
begin
  // Seta os valores iniciais das variaveis utilizadas para fazer a devolução.
  CancelarDevolucao;
  NrSelecoes       := 0;
  SetLength(NewParcelas, qryParcelasContratos.RecordCount);
  try
    FNPAberta:= 0;
    FValorAberto:= 0;
    qryParcelasContratos.First;
    for I:= 0 to qryParcelasContratos.RecordCount - 1 do begin
      if qryParcelasContratosdataPagto.AsDateTime = 0 then begin
        FValorAberto:=  FValorAberto + (qryParcelasContratosvalorvencto.AsCurrency);
        Inc(FNPAberta);
      end;
      NewParcelas[I].Registro    := qryParcelasContratosnumero.AsInteger;
      NewParcelas[I].DataVencto  := qryParcelasContratosdatavencto.AsDateTime;
      NewParcelas[I].DataPagto   := qryParcelasContratosdatapagto.AsDateTime;
      NewParcelas[I].ValorVencto := qryParcelasContratosvalorvencto.AsCurrency;
      NewParcelas[I].ValorPagto  := qryParcelasContratosvalorpagto.AsCurrency;
      qryParcelasContratos.Next;
    end;
    qryParcelasContratos.First;
  except
  end;

  SetLength(Defeitos  , qryProdutosContratos.RecordCount);
  SetLength(Precos    , qryProdutosContratos.RecordCount);
  SetLength(Acrescimos, qryProdutosContratos.RecordCount);
  SetLength(Descontos , qryProdutosContratos.RecordCount);
  SetLength(Fretes    , qryProdutosContratos.RecordCount);
  SetLength(Seguros   , qryProdutosContratos.RecordCount);

  try
    qryProdutosContratos.First;
    for I:= 0 to (qryProdutosContratos.RecordCount -1) do
    begin
      Precos[I]     := qryProdutosContratosprecovenda.AsCurrency;
      Acrescimos[I] := qryProdutosContratosacrescimo.AsCurrency;
      Descontos[I]  := qryProdutosContratosdesconto.AsCurrency;
      Fretes[I]     := qryProdutosContratosfrete.AsCurrency;
      Seguros[I]    := qryProdutosContratosseguro.AsCurrency;
      Defeitos[I]:= 0;
      qryProdutosContratos.Next;
    end;
    qryProdutosContratos.First;
  except
  end;

  qryValoresDevolvidos.Sql[08]:= '(contrato = ' + QuotedStr(qryContratosnumero.AsString) + ')';
  qryValoresDevolvidos.Open;

  FOldValorProdutos:= qryContratosvalorprodutos.AsCurrency - (qryValoresDevolvidosvalorvista.AsCurrency   +
                                                              qryValoresDevolvidosdesconto.AsCurrency     +
                                                              qryValoresDevolvidoscreditotroca.AsCurrency -
                                                              qryValoresDevolvidosfrete.AsCurrency        -
                                                              qryValoresDevolvidosseguro.AsCurrency);
  FOldValorFrete        := qryContratosFrete.AsCurrency        - qryValoresDevolvidosfrete.AsCurrency;
  FOldValorSeguro       := qryContratosSeguro.AsCurrency       - qryValoresDevolvidosseguro.AsCurrency;
  FOldValorDesconto     := qryContratosdesconto.AsCurrency     - qryValoresDevolvidosdesconto.AsCurrency;
  FOldValorCreditoTroca := qryContratoscreditotroca.AsCurrency - qryValoresDevolvidoscreditotroca.AsCurrency;
  FOldValorVista        := qryContratosvalorvista.AsCurrency   - qryValoresDevolvidosvalorvista.AsCurrency{ +
                                                                  qryValoresDevolvidosfrete.AsCurrency +
                                                                  qryValoresDevolvidosseguro.AsCurrency)};
  FOldValorPrazo        := qryContratosvalorprazo.AsCurrency   - qryValoresDevolvidosvalorprazo.AsCurrency{ +
                                                                  qryValoresDevolvidosfrete.AsCurrency +
                                                                  qryValoresDevolvidosseguro.AsCurrency)};

  FValorProdutos     := FOldValorProdutos;
  FValorVista        := FOldValorVista;
  FValorFrete        := FOldValorFrete;
  FValorSeguro       := FOldValorSeguro;
  FValorDesconto     := FOldValorDesconto;
  FValorCreditoTroca := FOldValorCreditoTroca;
  FValorPrazo        := FOldValorPrazo;

  FValorDevolvido  := 0;
  RefazConsultaPorNome(qryProdutosContratosDevolvidos,
                       ['contrato'],
                       [qryContratosnumero.AsString]);
  CalcularPrestacoesReais;
end;

procedure TdtmDevolucaoMercadorias.LimparTabelas;
begin
//  CancelarDevolucao;
  ReFazConsulta(qryProdutosContratos,  [0,1,2,3,4],[false, 0,'','','']);
  ReFazConsulta(qryParcelasContratos,        [0],        ['']);
  ReFazConsulta(qryParcelasAbertas,          [0],        ['']);
  ReFazConsulta(qryContratos,                [0],        ['']);
  ReFazConsulta(qryContratosPorCliente,    [0,1],      [0,'']);
end;

(*procedure TdtmDevolucaoMercadorias.MarcarProdutoDevolver; XX-Jander
var
  Pos: TBookmark;
  A  : Integer;
begin
  if not FCancelarTotal then begin
    if not qryProdutosContratosBrinde.AsBoolean then begin
      qryProdutosContratos.Edit;
      if qryProdutosContratosdevolver.AsInteger > 0 then begin
         if qryProdutosContratosdefeito.AsBoolean then
           qryProdutosContratosdefeito.AsBoolean:= False;
         qryProdutosContratosdevolver.AsInteger:= 0;
      end
      else begin
        qryProdutosContratosdevolver.AsInteger:= (qryProdutosContratosquantidade.AsInteger - qryProdutosContratoscancelado.AsInteger);
      end;
      qryProdutosContratos.Post;
      if not (qryProdutosContratosdevolver.AsInteger > 0) then
        AtualizaValores;
    end
    else
      MensagemAviso(ctDEVOLVERBRINDE);
  end
  else begin
    Pos:= qryProdutosContratos.GetBookmark;
    qryProdutosContratos.DisableControls;
    qryProdutosContratos.First;
    try
      for A:= 1 to qryProdutosContratos.RecordCount do begin
        if not qryProdutosContratosbrinde.AsBoolean then
          if (qryProdutosContratoscancelado.AsInteger < qryProdutosContratosquantidade.AsInteger) then begin
            qryProdutosContratos.Edit;
            qryProdutosContratosdevolver.AsInteger:= (qryProdutosContratosquantidade.AsInteger - qryProdutosContratoscancelado.AsInteger);
            qryProdutosContratosqtdeentregueparadevolver.AsInteger:= qryProdutosContratosqtdeentregue.AsInteger;
            qryProdutosContratos.Post;
            Inc(NrSelecoes);
          end;
        qryProdutosContratos.Next;
      end;
    finally
      qryProdutosContratos.GotoBookmark(Pos);
      qryProdutosContratos.FreeBookmark(Pos);
      qryProdutosContratos.EnableControls;
    end;
    AtualizaValores;
  end;
end;  *)

procedure TdtmDevolucaoMercadorias.MovimentarProdutosNota;
var
  SituacaoProduto : TtecComposicao;
  I,
  Preco: integer;
//  QtdeEntregar,
  QtdeMovto: Currency;
  Produto: Int64;
  MovExtra, TRERealizado: Boolean;
  Ref: String;


  procedure BloquearEstoque;
  var
    WhereSQL: String;
  begin
    qryProdutosContratos.DisableControls;
    try
      if qryProdutosContratos.RecordCount = 0 then
        WhereSQL := 'false'
      else begin
        WhereSQL := '';
        qryProdutosContratos.First;
        while not qryProdutosContratos.Eof do begin
          if (qryProdutosContratosdevolver.AsCurrency > 0) then begin
            WhereSQL := WhereSQL +
            '((e.produto = ' + qryProdutosContratosproduto.AsString + ')and' +
            '(e.filial = '   + qryProdutosContratosfilial.AsString  + '))or';
          end;
          qryProdutosContratos.Next
        end;
        Delete(WhereSQL, Length(WhereSQL) - 1, 2);
      end
    finally
      qryProdutosContratos.EnableControls
    end;
    qryEstoqueBloqueio.Sql[07]:= WhereSQL;
    qryEstoqueBloqueio.Open;
  end;

  procedure NovoMovimento(Produto: Int64; Filial: Integer);
  begin
    if not qryMovimentos.Active then
      qryMovimentos.Active:= True;
    qryMovimentos.Append;
    spcMovimentosProximo.Open;
    qryMovimentosnumero.AsInteger    := spcMovimentosProximonumero.AsInteger;
    spcMovimentosProximo.Close;
    qryMovimentosproduto.AsLargeInt  := Produto;
    qryMovimentosfilial.AsInteger    := Filial;
  end;

  procedure InserirProduto;
  begin
    if not qryEstoques.Active then
      qryEstoques.Active:= True;
    qryEstoques.Insert;
    qryEstoquesproduto.AsLargeInt       := Produto;
    qryEstoquesfilial.AsInteger         := ifthen(TipoFilial<>'V', FilialBase, qryProdutosContratosfilial.asinteger);
    qryEstoquesultimaentrada.AsDateTime := DataServidor;
    qryEstoquesemestoque.AsCurrency      := 0;
    qryEstoquesreservado.AsCurrency      := 0;
    qryEstoquestransito.AsCurrency       := 0;
    qryEstoquesdemonstracao.AsCurrency   := 0;
    qryEstoquesconserto.AsCurrency       := 0;
    qryEstoquesfuturo.AsCurrency         := 0;
    qryEstoquesdanificada.AsCurrency     := 0;
    qryEstoquesestoquefisico.AsCurrency  := 0;
    qryEstoques.Post;
  end;

  function DadosFiscais: String;
  var
    Str: String;
  begin
    Str:= '';
    qryNotasPagDadosFiscais.First;
    While not qryNotasPagDadosFiscais.Eof do begin
      if (qryProdutosContratosproduto.AsLargeInt = qryNotasPagDadosFiscaisproduto.AsLargeInt) and
         (qryNotasPagDadosFiscaisfilial.AsInteger = qryProdutosContratosfilial.AsInteger)then
        Str:= Str + IntToStr(qryNotasPagDadosFiscaisdadofiscal.AsInteger) + ',';
      qryNotasPagDadosFiscais.Next;
    end;
    if Str <> '' then begin
      Delete(Str,Length(Str),1);
      Str:= 'and (pd.dadofiscal in (' + Str + '))';
    end;
    Result:= Str;
  end;

begin
    BloquearEstoque;
    qryProdutosContratos.DisableControls;
    try
      for SituacaoProduto:=stNAOCOMPOSTO to stCOMPOSTO do
      begin
        qryProdutosContratos.First;
        for I:= 1 to qryProdutosContratos.RecordCount do
        begin
          if FiltrarComposto(qryProdutosContratoscomposto.AsBoolean, SituacaoProduto) then
          begin
            TRERealizado := False;
            if (qryProdutosContratosdevolver.AsCurrency > 0) then begin
              Produto:= qryProdutosContratosproduto.AsLargeInt;

              if ((qryContratossituacao.AsString = 'N') or (qryContratossituacao.AsString = 'P')) and
                   TemProdutoImprimirNota then begin
                qryCustoProduto.Sql[06]:= DadosFiscais;
                qryCustoProduto.Params[0].AsString := IntToStr(qryProdutosContratosproduto.AsLargeInt);
                qryCustoProduto.Params[1].AsInteger:= qryProdutosContratosfilial.AsInteger;
                qryCustoProduto.Open;
              end;

              if qryProdutosContratosdefeito.AsBoolean then begin
                // Se o produto a ser devolvido for com defeito então será inserido um novo produto.
                // Se já existe um produto avariado então será adicionado a esse produto a qtde devolvida.
                ReFazConsulta(qryProdutoExiste,[0,1],[IntToStr(qryProdutosContratoscaracteristica.AsLargeInt),
                                                      IntToStr(qryProdutosContratosproduto.AsLargeInt)]);
                if qryProdutoExiste.IsEmpty then begin
                  spcProdutoProximo.Params[0].AsString:= IntToStr(qryProdutosContratoscaracteristica.AsLargeInt);
                  spcProdutoProximo.Open;
                  Produto:= spcProdutoProximocodigo.AsLargeInt;
                  spcProdutoProximo.Close;
                end
                else Produto:= qryProdutoExistecodigo.AsLargeInt;

                // Se já existe um preco para produtos avariados então este será usado, senão será
                // criado um novo preço com o atributo avariado = true.
                ReFazConsulta(qryPrecoExiste,[0],[IntToStr(qryProdutosContratoscaracteristica.AsLargeint)]);
                if qryPrecoExiste.IsEmpty then begin
                  spcPrecosProximo.Params[0].AsString:= IntToStr(qryProdutosContratoscaracteristica.AsLargeInt);
                  spcPrecosProximo.Open;
                  Preco:= spcPrecosProximocodigo.AsInteger;
                  spcPrecosProximo.Close;

                  if not qryPrecos.Active then
                    qryPrecos.Active:= True;
                  qryPrecos.Insert;
                  qryPrecoscaracteristica.AsLargeInt := qryProdutosContratoscaracteristica.AsLargeInt;
                  qryPrecoscodigo.AsInteger          := Preco;
                  qryPrecosdescricao.AsString        := 'DEPRECIADO';
                  qryPrecosavariado.AsBoolean        := True;
                  qryPrecos.Post;
                end
                else Preco:= qryPrecoExistecodigo.AsInteger;

                if qryProdutoExiste.IsEmpty then begin
                  // Inserindo o Produto Avariado.
                  if not qryProdutos.Active then
                    qryProdutos.Active:= True;
                  qryProdutos.Insert;
                  qryProdutoscaracteristica.AsLargeInt:= qryProdutosContratoscaracteristica.AsLargeInt;
                  qryProdutoscodigo.AsLargeInt        := Produto;
                  qryProdutosdescricao.AsString       := qryProdutosContratosdescricao.AsString + ' - DEPRECIADO';
                  qryProdutospreco.AsInteger          := Preco;
                  qryProdutoscodigorecolha.AsLargeInt := qryProdutosContratosproduto.AsLargeInt;
                  qryProdutos.Post;

                  // Inserindo o novo Produto Avariado no Estoque.
                  InserirProduto;

                  if qryProdutosNotasPag.Locate('produto',qryProdutosContratosproduto.AsString,[]) then begin
                    qryProdutosNotasPag.Edit;
                    qryProdutosNotasPagProduto.AsLargeInt:= Produto;
                    qryProdutosNotasPag.Post;
                  end;
                end;
              end
              else begin
                ReFazConsulta(qryEstoques,[0,1],[ifthen(TipoFilial<>'V', FilialBase, qryProdutosContratosfilial.AsInteger),IntToStr(Produto)]);
                // Se o produto a ser devolvido não esta contido na filial base,
                // então será inserido nesta filial.
                if qryEstoques.IsEmpty then
                  InserirProduto;
              end;

              // Movimenta o produto que esta sendo devolvido.
               QtdeMovto := 0;
               MovExtra:= False;
      {          QtdeEntregar := qryProdutosContratosquantidade.AsInteger -
                              qryProdutosContratosqtdeentregue.AsInteger -
                              qryProdutosContratoscancelado.AsInteger;
      }       while (QtdeMovto < qryProdutosContratosdevolver.AsCurrency) do
              begin
                if ((qryContratossituacao.AsString = 'F') or
                    (((qryContratossituacao.AsString = 'N') or
                      (qryContratossituacao.AsString = 'P')) and
                       not TemProdutoImprimirNota) ) then
                  NovoMovimento(Produto,qryProdutosContratosfilial.AsInteger)
                else
                  NovoMovimento(Produto, ifthen(TipoFilial<>'V', FilialBase, qryProdutosContratosfilial.AsInteger));

                // ATENÇÃO: EXISTE UM BUG QUANDO A FILIAL FOR DIFERENTE EM RELAÇÃO AO FUTURO.

                qryMovimentosreferencia.AsString  := 'CT ' + qryContratosnumero.AsString + ' DEVOLVIDO';

                if ((qryContratossituacao.AsString = 'N') or (qryContratossituacao.AsString = 'P')) then
                begin
                  // Se produto for com defeito então a qtde a ser devolvida será adicionada em estoque.
                  if (TemProdutoImprimirNota and
                     (qryProdutosContratosqtdeentregueparadevolver.AsCurrency > 0)) then
                  begin
                    if qryProdutosNotasPag.Locate('produto',IntToStr(Produto),[]) then
                    begin
                      if qryNotaspag.Locate('codigo', qryprodutosnotaspagcodigonota.AsInteger,[]) then
                        if ClienteTrouxeNota then
                             Ref:= ' NFE F' + qryContratoscliente.AsString + ' S'     +
                                              qryNotasPagserie.AsString + ' N' +
                                              Format('%6.6d',[qryNotasPagnrdocumento.AsInteger])
                        Else Ref:= ' NFE S' + qryNotasPagserie.AsString + ' N' +
                                            Format('%6.6d',[qryNotasPagnrdocumento.AsInteger]);
                      qryMovimentosreferencia.AsString := qryMovimentosreferencia.AsString + Ref;
                    end;
                  end;

                  if qryProdutosContratosdefeito.AsBoolean then
                  begin
                    qryMovimentosquantidade.AsCurrency := qryProdutosContratosqtdeentregueparadevolver.AsCurrency;
                    qryMovimentosvalor.AsCurrency     := qryCustoProdutocusto.AsCurrency * qryMovimentosquantidade.AsCurrency;
                    qryMovimentostipomovimento.AsString  := 'EFC';
                    QtdeMovto:= QtdeMovto + qryMovimentosquantidade.AsCurrency;
                  end
                  else
                  begin
                     if qryProdutosContratosfuturo.AsCurrency > 0 then
                     begin
                       if MovExtra then
                       begin
                         if qryProdutosContratosqtdeentregueparadevolver.AsCurrency > 0 then
                         begin
                           if qryProdutosContratosfuturo.AsCurrency >
                             (qryProdutosContratosdevolver.AsCurrency -
                              qryProdutosContratosqtdeentregueparadevolver.AsCurrency) then
                           begin
                             if (qryProdutosContratosqtdeentregueparadevolver.AsCurrency <=
                                qryProdutosContratosfuturo.AsCurrency) then
                             begin
                               qryMovimentosquantidade.AsCurrency  := qryProdutosContratosdevolver.AsCurrency - qryProdutosContratosqtdeentregueparadevolver.AsCurrency;
                               qryMovimentostipomovimento.AsString := 'SQU';
                             end
                             else
                             begin
                               qryMovimentosquantidade.AsCurrency  := qryProdutosContratosqtdeentregueparadevolver.AsCurrency - qryProdutosContratosfuturo.AsCurrency;
                               qryMovimentosvalor.AsCurrency      := qryCustoProdutocusto.AsCurrency * qryMovimentosquantidade.AsCurrency;
                               qryMovimentostipomovimento.AsString := 'EFV';
                             end;
                           end
                           else
                           begin
                             if not TRERealizado and (qryProdutosContratosfuturo.AsCurrency <
                                                     (qryProdutosContratosdevolver.AsCurrency -
                                                      qryProdutosContratosqtdeentregueparadevolver.AsCurrency)) then
                             begin
                                qryMovimentosquantidade.AsCurrency   := (qryProdutosContratosdevolver.AsCurrency -
                                                                        qryProdutosContratosqtdeentregueparadevolver.AsCurrency) -
                                                                        qryProdutosContratosfuturo.AsCurrency;
                                qryMovimentostipomovimento.AsString := 'TRE';
                                TRERealizado := True;
                             end
                             else
                             begin
                               if (qryProdutosContratosfuturo.AsCurrency =
                                   (qryProdutosContratosdevolver.AsCurrency -
                                    qryProdutosContratosqtdeentregueparadevolver.AsCurrency)) then
                                qryMovimentosquantidade.AsCurrency   := (qryProdutosContratosdevolver.AsCurrency -
                                                                        qryProdutosContratosqtdeentregueparadevolver.AsCurrency)
                               else
                                qryMovimentosquantidade.AsCurrency   := qryProdutosContratosfuturo.AsCurrency;
                                qryMovimentostipomovimento.AsString := 'SQU';
                             end;
                           end;
                         end
                         else
                         begin
                             qryMovimentosquantidade.AsCurrency  := qryProdutosContratosdevolver.AsCurrency - qryProdutosContratosfuturo.AsCurrency;
                             qryMovimentostipomovimento.AsString:= 'TRE';
                         end;
                       end
                       else
                       if qryProdutosContratosqtdeentregueparadevolver.AsCurrency > 0 then
                       begin
                         if qryProdutosContratosfuturo.AsCurrency >
                           (qryProdutosContratosdevolver.AsCurrency -
                            qryProdutosContratosqtdeentregueparadevolver.AsCurrency) then
                         begin
                           if qryProdutosContratosqtdeentregueparadevolver.AsCurrency <= qryProdutosContratosfuturo.AsCurrency then
                             qryMovimentosquantidade.AsCurrency  := qryProdutosContratosqtdeentregueparadevolver.AsCurrency
                           else
                             qryMovimentosquantidade.AsCurrency  := qryProdutosContratosfuturo.AsCurrency;
                           qryMovimentosvalor.AsCurrency        := qryCustoProdutocusto.AsCurrency * qryMovimentosquantidade.AsCurrency;
                           qryMovimentostipomovimento.AsString  := 'ARV'
                         end
                         else
                         begin
                           qryMovimentosquantidade.AsCurrency   := qryProdutosContratosqtdeentregueparadevolver.AsCurrency;
                           qryMovimentosvalor.AsCurrency       := qryCustoProdutocusto.AsCurrency * qryMovimentosquantidade.AsCurrency;
                           qryMovimentostipomovimento.AsString := 'EFV';
                         end;
                       end
                       else
                       begin
                         if qryProdutosContratosdevolver.AsCurrency <= qryProdutosContratosfuturo.AsCurrency then
                           qryMovimentosquantidade.AsCurrency  := qryProdutosContratosdevolver.AsCurrency
                         else
                           qryMovimentosquantidade.AsCurrency  := qryProdutosContratosfuturo.AsCurrency;

                         qryMovimentostipomovimento.AsString:= 'SQU';
                       end;
                     end
                     else
                     begin
                       if (MovExtra or (qryProdutosContratosdevolver.AsCurrency = qryProdutosContratosqtdeentregueparadevolver.AsCurrency)) then begin
                          qryMovimentosquantidade.AsCurrency   := qryProdutosContratosqtdeentregueparadevolver.AsCurrency;
                          qryMovimentosvalor.AsCurrency   := qryCustoProdutocusto.AsCurrency * qryMovimentosquantidade.AsCurrency;
                          qryMovimentostipomovimento.AsString := 'EFV';
                          qryMovimentoscodigonota.AsInteger  := qryNotasPagcodigo.AsInteger;
                       end else begin
                        // estava em futuro, foi suprido indo para reserva, devolvou: tira da reserva e adiciona estoque.
                         qryMovimentosquantidade.AsCurrency   := qryProdutosContratosdevolver.AsCurrency - qryProdutosContratosqtdeentregueparadevolver.AsCurrency;
                         qryMovimentostipomovimento.AsString := 'TRE'
                       end
                     end;
                  end;
                  QtdeMovto:= QtdeMovto + qryMovimentosquantidade.AsCurrency {+ QtdeRetiradaFuturo};
                end
                else begin
                  if (qryContratossituacao.AsString = 'F') then begin
                    // * Se qtde em futuro for maior que qtde devolver então a qtde devolver será adicionada no futuro.;
                    // * Se qtde em futuro for menor que qtde devolver então será adicionada no futuro a qtde futura e
                    //   a diferenca sera transferida da reserva para o estoque.
                    if qryProdutosContratosdevolver.AsCurrency <= qryProdutosContratosfuturo.AsCurrency then begin
                       qryMovimentosquantidade.AsCurrency := qryProdutosContratosdevolver.AsCurrency;
                       qryMovimentostipomovimento.AsString := 'SQU';
                    end else begin
                      if MovExtra then begin
                        qryMovimentosquantidade.AsCurrency := qryProdutosContratosfuturo.AsCurrency;
                        qryMovimentostipomovimento.AsString := 'SQU'
                      end else begin
                        qryMovimentosquantidade.AsCurrency := qryProdutosContratosdevolver.AsCurrency - qryProdutosContratosfuturo.AsCurrency;
                        qryMovimentostipomovimento.AsString := 'TRE';
                      end;
                    end;
                    QtdeMovto:= QtdeMovto + qryMovimentosquantidade.AsCurrency;
                  end;
                end;
                qryMovimentos.Post;
                MovExtra:= (QtdeMovto < qryProdutosContratosdevolver.AsCurrency);
              end;
            end;
          end;
          qryProdutosContratos.Next;
        end;
      end;
    finally
      qryProdutosContratos.EnableControls;
    end;
end;

procedure TdtmDevolucaoMercadorias.PreencherNotaFiscal(Incluir: Boolean);
var
  Acrescimo,  Desconto,    Seguro,   Frete,
  ValorProd,  ValorNota,   BaseICMS, ValorICMS,
  BaseICMSST, ValorICMSST, ValorII,  ValorIPI,
  ValorPIS,   ValorCOFINS, ValorOutras: Currency;
  ChaveAcesso: String;
begin
  Acrescimo  := 0;  Desconto    := 0;  Seguro      := 0;  Frete     := 0;
  ValorProd  := 0;  ValorNota   := 0;  BaseICMS    := 0;  ValorICMS := 0;
  BaseICMSST := 0;  ValorICMSST := 0;  ValorII     := 0;  ValorIPI  := 0;
  ValorPIS   := 0;  ValorCOFINS := 0;  ValorOutras := 0;
  qryContratosDevolvidos.First;
  while not qryContratosDevolvidos.Eof do begin
    if qryContratosDevolvidossituacao.AsString = 'N' then begin
//      if (((TipoNota = tnNORMAL) and NotaNormal(qryContratosDevolvidosincidencia.AsString)) or
//          ((TipoNota = tnSUBSTTRIB) and NotaSubstituicao(qryContratosDevolvidosincidencia.AsString))) then begin
          Desconto  := Desconto  + qryContratosDevolvidosdesconto.AsCurrency;
          Seguro    := Seguro    + qryContratosDevolvidosseguro.AsCurrency;
          Frete     := Frete     + qryContratosDevolvidosfrete.AsCurrency;
          ValorProd := ValorProd + qryContratosDevolvidosvalorvista.AsCurrency +
                                   qryContratosDevolvidosdesconto.AsCurrency{ -
                                   qryContratosDevolvidosfrete.AsCurrency -
                                   qryContratosDevolvidosseguro.AsCurrency};
          ValorNota := ValorNota + qryContratosDevolvidosvalorprazo.AsCurrency;
          Acrescimo := Acrescimo + (qryContratosDevolvidosvalorprazo.AsCurrency - qryContratosDevolvidosvalorvista.AsCurrency);
//      end;
    end;
    qryContratosDevolvidos.Next;
  end;

  // VALOR VISTA = TOTAL PRODUTOS + FRETE + SEGURO - DESCONTO
  if incluir then
    qryNotasPag.Append
  else
    qryNotasPag.edit;

  qryNotasPagfornecedor.AsInteger       := qryContratoscliente.AsInteger;
  qryNotasPagtipofornecedor.AsString    := TipoCliente;
  if ClienteTrouxeNota then
       qryNotasPagserie.AsString := SerieDevolucao
  else qryNotasPagserie.AsString := SerieSugestao;
  if ClienteTrouxeNota then
       qryNotasPagnrdocumento.AsInteger := StrToInt(NumeroDevolucao)
  else qryNotasPagnrdocumento.AsInteger := 0{Ord(TipoNota)};

  qryProdutosNotasPag.First;
  qryNotasPagcodigonatureza.asinteger := qryProdutosNotasPagnatureza.AsInteger;
  qryNotasPagcodigofiscal.AsInteger   := qryProdutosNotasPagcodigofiscal.AsInteger;

  if qryNaturezasPadrao.Locate('natureza', qryProdutosNotasPagnatureza.AsInteger, []) then
    qryNotasPagnatureza.AsString := qryNaturezasPadraodescricaonatureza.AsString;

  qryNotasPagfilial.AsInteger           := FilialBase;
  qryNotasPagdata.AsDateTime            := DataServidor;
  if ClienteTrouxeNota then
       qryNotasPagemissao.AsDateTime    := StrToDate(DataDevolucao)
  else qryNotasPagemissao.AsDateTime    := DataServidor;
  qryNotasPagestado.AsString            := qryClientesestado.AsString;
  if qryContratosprimogenito.AsString <> '' then
       qryNotasPagcontrato.AsString     := qryContratosprimogenito.AsString
  else qryNotasPagcontrato.AsString     := qryContratosnumero.AsString;
  qryNotasPagcnpj.AsString              := qryClientespessoanumero.AsString;
  qryNotasPagnome.AsString              := qryClientesrazao.AsString;

  qryNotasPagfoneddd.AsString           := qryClientesfoneddd.AsString;
  qryNotasPagfonenumero.AsString        := qryClientesfonenumero.AsString;
  qryNotasPaginscricaoestadual.AsString := qryClientesinscricaoestadual.AsString;

  if qryClientesestado.AsString = '.' then {estrangeiro}
  begin
    qryNotasPagpais.asstring           := qryClientescidadeibge.asstring;
    qryNotasPagnomepais.AsString       := qryClientesnomecidade.AsString;
    qryNotasPagrua.AsString            := qryClientesrua.AsString;
    qryNotasPagendnumero.AsString      := qryClientesnumero.AsString;
    qryNotasPagendcomplemento.AsString := qryClientescomplemento.AsString;
    qryNotasPagcidade.AsString         := qryClientesbairro.AsString;
    qryNotasPagnomecidade.AsString     := qryClientesnomebairro.AsString;
    qryNotasPagestado.AsString         := qryClientesestado.AsString;
  end
  else
  begin
    qryNotasPagpais.AsInteger          := 1058;
    qryNotasPagnomepais.AsString       := 'Brasil';
    qryNotasPagrua.AsString            := qryClientesrua.AsString;
    qryNotasPagendnumero.AsString      := qryClientesnumero.AsString;
    qryNotasPagendcomplemento.AsString := qryClientescomplemento.AsString;
    qryNotasPagbairro.AsString         := qryClientesbairro.AsString;
    qryNotasPagnomebairro.AsString     := qryClientesnomebairro.AsString;
    qryNotasPagcidade.AsString         := qryClientescidade.AsString;
    qryNotasPagnomecidade.AsString     := qryClientesnomecidade.AsString;
    qryNotasPagcidadeibge.AsString     := qryClientescidadeibge.AsString;
    qryNotasPagestado.AsString         := qryClientesestado.AsString;
    qryNotasPagcep.Asstring            := qryClientescep.AsString;
  end;

  qryNotasPaginscricaoestadual.AsString := qryClientesinscricaoestadual.AsString;
  if(ClienteTrouxeNota) then
    qryNotasPagpermitirimprimir.AsBoolean := False
  else
    qryNotasPagpermitirimprimir.AsBoolean := True;
  qryNotasPagsituacao.AsString := 'N';

  try
//    dsrProdutosContratos.OnDataChange := nil;
    GuardarRegistroAtual(qryProdutosContratos,True);
    qryProdutosContratos.First;
    while not qryProdutosContratos.Eof do
    begin
      if qryProdutosContratosqtdeentregueparadevolver.AsCurrency > 0 then
      begin
        BaseICMS    := BaseICMS    + qryProdutosContratosicmsbasecalculo.AsCurrency;
        ValorICMS   := ValorICMS   + qryProdutosContratosicmsvalor.AsCurrency;
        BaseICMSST  := BaseICMSST  + qryProdutosContratosicmsbasecalculost.AsCurrency;
        ValorICMSST := ValorICMSST + qryProdutosContratosicmsvalorst.AsCurrency;
        ValorII     := ValorII     + qryProdutosContratosiivalor.AsCurrency;
        ValorIPI    := ValorIPI    + qryProdutosContratosvaloripi.AsCurrency;
        ValorPIS    := ValorPIS    + qryProdutosContratospisvalor.AsCurrency;
        ValorCOFINS := ValorCOFINS + qryProdutosContratoscofinsvalor.AsCurrency;
        ValorOutras := ValorOutras + qryProdutosContratosdespesasacessorias.AsCurrency;
      end;
      qryProdutosContratos.Next;
    end;
  finally
    VoltarRegistroAtual(qryProdutosContratos);
//    dsrProdutosContratos.OnDataChange := dsrProdutosContratosDataChange;
  end;

  qryNotasPagbaseicms.AsCurrency             := BaseICMS;
  qryNotasPagvaloricms.AsCurrency            := ValorICMS;
  qryNotasPagbaseicmssubstituicao.AsCurrency := BaseICMSST;
  qryNotasPagvaloricmssubstituicao.AsCurrency:= ValorICMSST;
  qryNotasPagtotalimportacao.AsCurrency      := ValorII;
  qryNotasPagvaloripi.AsCurrency             := ValorIPI;
  qryNotasPagtotalvalorpis.AsCurrency        := ValorPIS;
  qryNotasPagtotalvalorcofins.AsCurrency     := ValorCOFINS;
  qryNotasPagdespesasacessorias.AsCurrency   := ValorOutras;

  qryNotasPagdesconto.AsCurrency        := Desconto;
  qryNotasPagfreteinterno.AsCurrency    := Frete;
  qryNotasPagseguro.AsCurrency          := Seguro;
  qryNotasPagvalornota.AsCurrency       := ValorNota;
  qryNotasPagtotalprodutos.AsCurrency   := ValorProd;
  qryNotasPagacrescimo.AsCurrency       := Acrescimo; //(qryNotasPagvalornota.AsCurrency - (ValorProd + Frete + Seguro - Desconto));
  qryNotasPagobservacoes.AsString       := qryContratosconsideracoes.AsString;
  qryNotasPag.Post;
end;

procedure TdtmDevolucaoMercadorias.qryClientesAfterClose(DataSet: TDataSet);
begin
  inherited;
  LimparTabelas;
end;

procedure TdtmDevolucaoMercadorias.qryClientesBeforeOpen(DataSet: TDataSet);
begin
  inherited;
  if (qryClientes.Params[1].AsString = '') then
    qryClientes.Params[1].AsString:= 'C';
end;

procedure TdtmDevolucaoMercadorias.qryContratosPorClienteAfterScroll(DataSet: TDataSet);
begin
  inherited;
  if not qryContratosPorCliente.IsEmpty then
  begin
    if Assigned(FAfterScrollContratosClientes) then
      FAfterScrollContratosClientes(qryContratosPorCliente);
//    CancelarDevolucao;
    ReFazConsultaTabelas;

  end;
end;

procedure TdtmDevolucaoMercadorias.qryParcelasContratosBeforeDelete(DataSet: TDataSet);
begin
  if qryParcelasContratosnumero.AsInteger <> 0 then begin
    MensagemAviso(ctPARCELANAOPODESEREXCLUIDA);
    Abort;
  end;
end;

procedure TdtmDevolucaoMercadorias.qryParcelasContratosNewRecord(DataSet: TDataSet);
begin
  inherited;
  qryParcelasContratoscontrato.AsString     := qryContratosnumero.AsString;
end;

procedure TdtmDevolucaoMercadorias.qryProdutosContratosAfterInsert(DataSet: TDataSet);
begin
  inherited;
  qryProdutosContratos.Cancel;
end;

procedure TdtmDevolucaoMercadorias.qryProdutosContratosAfterScroll(DataSet: TDataSet);
begin
  inherited;
  // Só permite alterar o preço se marcar o produto como avariado.
  qryProdutosContratosprecovenda.ReadOnly := //not ((qryProdutosContratosdevolver.AsInteger = 0) and
                                                   not qryProdutosContratosdefeito.AsBoolean;

  // Se a devolução for total, ou produto igual a brinde ou a quantidade cancelada for iagual
  //a quantidade de produtos vendidos não pernite alterar a quantidade a ser devolvida.
  qryProdutosContratosdevolver.ReadOnly   := //CancelarTotal or XX-Jander
                                             qryProdutosContratosbrinde.AsBoolean or
                                             (qryProdutosContratoscancelado.AsCurrency = qryProdutosContratosquantidade.AsCurrency);
  qryProdutosContratosqtdeentregueparadevolver.ReadOnly:= qryProdutosContratosdevolver.ReadOnly;

  if Assigned(OnScrollLinhaColunaGrade) then
   OnScrollLinhaColunaGrade(qryProdutosContratos);

end;

function TdtmDevolucaoMercadorias.Qtde_Entregue: Currency;
begin
  Result:= qryProdutosContratosqtdeentregue.AsCurrency - qryProdutosContratoscancelado.AsCurrency;
end;

function TdtmDevolucaoMercadorias.Qtde_A_Devolver: Currency;
begin
  Result:= qryProdutosContratosdevolver.AsCurrency;
end;

function TdtmDevolucaoMercadorias.ReFazConsultaContratosPorCliente: Boolean;
begin
  ReFazConsulta(qryContratosPorCliente,[0,1],[qryClientescodigo.AsInteger, qryClientestipo.AsString]);
  Result:= qryContratosPorCliente.IsEmpty;
  if Result then begin
    ReFazConsulta(qryContratos,              [0],        ['']);
    ReFazConsulta(qryProdutosContratos,[0,1,2,3,4],      [false, 0,'','','']);
    ReFazConsulta(qryParcelasContratos,      [0],        ['']);
    ReFazConsulta(qryParcelasAbertas,        [0],        ['']);
  end;
end;

procedure TdtmDevolucaoMercadorias.ReFazConsultaTabelas;
begin
  ReFazConsulta(qryContratos,          [0],[qryContratosPorClientenumero.AsString]);
  ReFazConsultapornome(qryProdutosContratos,['filialvirtual','filialdevolucao','estado','primogenito','contrato'],
                          [(TipoFilial='V'), FilialBase,
                          qryClientesestado.AsString,
                          ifthen(qryContratosPorClienteprimogenito.AsString <> '', qryContratosPorClienteprimogenito.AsString, qryContratosPorClientenumero.AsString),
                          qryContratosPorClientenumero.AsString]);
  ReFazConsulta(qryParcelasContratos,  [0],[qryContratosnumero.AsString]);
  ReFazConsulta(qryParcelasAbertas,    [0],[qryContratosPorClientenumero.AsString]);
end;

procedure TdtmDevolucaoMercadorias.Selecionar;
begin
  qryClientes.Params[1].AsString:= qryConsultaClientestipo.AsString;
  ReFazConsulta(qryClientes,[0],[qryConsultaClientescodigo.AsInteger])
end;

procedure TdtmDevolucaoMercadorias.SetarProdutoComDefeito;
begin
  // Marcar o produto como avariado se a quantidade entregue (nota) menos a quantidade
  // cancelado (devolução) for maior que zero.
  if (qryProdutosContratosqtdeentregueparadevolver.AsCurrency > 0) then begin
    qryProdutosContratos.Edit;
    qryProdutosContratosdefeito.AsBoolean:= not qryProdutosContratosdefeito.AsBoolean;
    if not qryProdutosContratosdefeito.AsBoolean then
      qryProdutosContratosprecovenda.AsCurrency:= Precos[qryProdutosContratos.CurRec];
    qryProdutosContratos.Post;
    qryProdutosContratosAfterScroll(qryProdutosContratos);
  end
  else
    MensagemAviso(ctPRODUTOAINDANAOENTREGUE);
end;

