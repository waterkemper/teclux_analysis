function TdtmDevolucaoMercadorias.GetContratoPodeDevolver: Boolean;
var
  a: Integer;
begin
  Result:= False;
  qryProdutosContratos.First;
  for a:= 1 to qryProdutosContratos.RecordCount do begin
    if qryProdutosContratosdevolver.AsCurrency > 0 then
      Result:= True;
    qryProdutosContratos.Next;
  end;
end;

function TdtmDevolucaoMercadorias.GetPodeCreditarICMS: boolean;
begin
  Result:= ParSistema.CreditarICMSDevolucao and
           (DaysBetween(DataServidor,DataContrato) <= ParSistema.DiasCreditarICMS);
end;

