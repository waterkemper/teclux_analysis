begin
  result := PrimeiraLetraEmMaiuscula(qryProdutosContratoscoluna.AsString)
end;

function TdtmDevolucaoMercadorias.GetLinhadaGrade: String;
begin
  result := PrimeiraLetraEmMaiuscula(qryProdutosContratoslinha.AsString)
end;

function TdtmDevolucaoMercadorias.GetContratoAVista: Boolean;
begin
  Result:= FOldValorVista = FOldValorPrazo;
end;


procedure TdtmDevolucaoMercadorias.qryContratosDevolvidosNewRecord(
  DataSet: TDataSet);
begin
  inherited;
  qryContratosDevolvidostipo.AsString := 'D';
  qryContratosDevolvidoscreditotroca.AsCurrency := 0;
end;

function TdtmDevolucaoMercadorias.GetContratosCreditoTroca: Currency;
begin
  result := qryContratoscreditotroca.AsCurrency;
end;

procedure TdtmDevolucaoMercadorias.dsrContratosDataChange(Sender: TObject;
  Field: TField);
begin
  inherited;
  if field = qryContratossituacao then
    if qryContratossituacao.AsString = 'C' then
    begin
      qryContratoscan_data.AsDateTime := DataServidor;
      qryContratoscan_usuariologado.AsInteger := UsuarioLogin.CodigoUsuario;
      qryContratoscan_usuarioautorizacao.AsInteger := FUsuarioAutorizacao;
    end;
end;


procedure TdtmDevolucaoMercadorias.DevolucaocomCheque;
begin
  if qryParcelasContratostipopagto.AsString = 'D' then
  begin
    qryParcelasContratos.Edit;
    qryParcelasContratostipopagto.AsString := 'C';
    qryParcelasContratosformapagamento.AsString := 'H';
    qryParcelasContratosdeventrada.AsDateTime := DataServidor;
    qryParcelasContratosdevcaixa.AsDateTime := DataServidor;
    qryParcelasContratos.post;
  end
  else
  if qryParcelasContratostipopagto.AsString = 'C' then
  begin
    qryParcelasContratos.Edit;
    qryParcelasContratostipopagto.AsString := 'D';
    qryParcelasContratosformapagamento.AsString := 'D';
    qryParcelasContratosdeventrada.AsDateTime := DataServidor;
    qryParcelasContratosdevcaixa.clear;
    qryParcelasContratos.post;
  end;
end;

function TdtmDevolucaoMercadorias.GetPodeDevolverCheque: Boolean;
begin
  Result := (qryParcelasContratostipopagto.AsString = 'D') or
            (qryParcelasContratostipopagto.AsString = 'C');
end;

procedure TdtmDevolucaoMercadorias.qryNotasPagNewRecord(DataSet: TDataSet);
begin
  inherited;
  qryNotasPagfrete.AsString := '1';
  qryNotasPagmodelodocto.AsString := ModeloDoctoFiscal;
  qryNotasPagregimetributario.AsInteger := RegimeTributario;

end;

procedure TdtmDevolucaoMercadorias.ZMonitor1MonitorEvent(Sql,
  Result: String);
var
 Listar : TStringList;
begin
  inherited;
  Listar := tStringlist.create;
  if fileexists('c:\devolucao.sql') then
    Listar.loadfromfile('c:\devolucao.sql');
  Listar.add('');
  Listar.add(sql);
  Listar.add(result);
  listar.savetofile('c:\devolucao.sql');
  listar.free;
end;

procedure TdtmDevolucaoMercadorias.qryNotasPagBeforePost(
  DataSet: TDataSet);
begin
  inherited;
  qryNotasPagdatahoraemissao.AsDateTime := now;
end;

procedure TdtmDevolucaoMercadorias.qryProdutosNotasPagBeforePost(
  DataSet: TDataSet);
begin
  inherited;
  if qryProdutosNotaspagincidencia.AsString = '' then
     qryProdutosNotaspagincidencia.Clear;

  if qryProdutosNotaspagcsosn.AsString = '' then
     qryProdutosNotaspagcsosn.Clear;

end;

procedure TdtmDevolucaoMercadorias.qryNotasPagAfterOpen(DataSet: TDataSet);
begin
  inherited;
  ReFazConsulta(qryCalculosProdutos, [0], [qryNotasPagcodigo.AsInteger]);

end;

function TdtmDevolucaoMercadorias.GetCondicaoEmissorNFE: Boolean;
begin
  if qryNotasPag.recordcount <> 0 then
    fCondicaoEmissorNFE := parsistema.EmissorNfe and
                           ((qryNotasPagmodelodocto.AsString = '55') or
                            (qryNotasPagmodelodocto.AsString = '57'))
  else
    fCondicaoEmissorNFE := parsistema.EmissorNfe and
                           ((ModeloDoctoFiscal = '55') or
                            (ModeloDoctoFiscal = '57'));

  Result := fCondicaoEmissorNFE;
end;

end.
