procedure TdtmDevolucaoMercadorias.qryProdutosNotasPagFilterRecord(
  DataSet: TDataSet; var Accept: Boolean);
begin
  inherited;
  Accept := qryprodutosnotaspagproduto.asString = qryprodutoscontratosproduto.asstring;
end;

function TdtmDevolucaoMercadorias.DadosFiscaisok: boolean;
begin
    result :=

       not qryDadosFiscaiscupom.isnull or                                                        //é cupom
       (qryDadosFiscaiscupom.isnull and (qryDadosFiscaismodelodocto.asString = '55') and not qryDadosFiscaisnumprotocolonfe.isnull) or  //não e cupom é nfe e esta ok
       (qryDadosFiscaiscupom.isnull and (qryDadosFiscaismodelodocto.asString <> '55'));                                                 //não é cupom e não é nfe

end;

function TdtmDevolucaoMercadorias.DefinirNumeroSerieProdutos: boolean;
begin
  result := true;

  if (qryProdutosSeries.recordcount <> 0) then
  begin
    if not Assigned (frmVisualizarProdutosContratosSeriesaDevolver) then
      frmVisualizarProdutosContratosSeriesaDevolver := TfrmVisualizarProdutosContratosSeriesaDevolver.Create(frmVisualizarProdutosContratosSeriesaDevolver);
    frmVisualizarProdutosContratosSeriesaDevolver.dsrProdutosDevolvidosSeries.dataset := qryProdutosSeries;
    frmVisualizarProdutosContratosSeriesaDevolver.FechamentoSeriesMarcadas := FechamentoSeriesMarcadas;

    frmVisualizarProdutosContratosSeriesaDevolver.ShowModal;

    if frmVisualizarProdutosContratosSeriesaDevolver.ModalResult = mrOk then
      result := true
    else
      result := false;

    frmVisualizarProdutosContratosSeriesaDevolver.Free;
    frmVisualizarProdutosContratosSeriesaDevolver := nil;
  end;

end;

function TdtmDevolucaoMercadorias.FechamentoSeriesMarcadas: boolean;
var
  vQtItensMarcado,
  vQtItensSemNota,
  vQtItensSemNotaMarcado,
  vQtItensComNota,
  vQtItensComNotaMarcado: Currency;
begin
  result := true;

  vQtItensMarcado := SomarValores(qryProdutosSeries,
                                        [nil],
                                        [qryProdutosSeriesdevolvido],
                                        ['True'], ['=']);

  if vQtItensMarcado <> qryprodutosContratosDevolver.asCurrency then
  begin
    result := false;
    MensagemAviso('Itens a devolver: ' + floattostr(qryprodutosContratosDevolver.asCurrency) + chr(13) +
                  'Séries marcadas : ' + floattostr(vQtItensMarcado) + chr(13) +
                  'Marque corretamente os números de séries a serem devolvidas.');
  end;


  if result then
  begin
    vQtItensSemNota := qryprodutosContratosDevolver.asCurrency - qryprodutosContratosqtdeentregueparadevolver.asCurrency;
    if vQtItensSemNota <> 0 then
    begin
      vQtItensSemNotaMarcado := SomarValores(qryProdutosSeries,
                                        [nil],
                                        [qryProdutosSeriesdevolvido, qryProdutosSeriesdadofiscal],
                                        ['True', ''], ['=','=']);

      if vQtItensSemNota <> vQtItensSemNotaMarcado then
      begin
        result := false;
        MensagemAviso('Itens a devolver sem NF: ' + floattostr(vQtItensSemNota) + chr(13) +
                      'Séries marcadas : ' + floattostr(vQtItensSemNotaMarcado) + chr(13) +
                      'Marque corretamente os números de séries a serem devolvidas.');
      end;
    end;
  end;

  if result then
  begin
    if qryprodutosContratosqtdeentregueparadevolver.asCurrency <> 0 then
    begin
      qryDadosFiscais.first;
      while not qryDadosFiscais.eof do
      begin

        if (qryDadosFiscaistipo.asString = 'Notas') or
           (qryDadosFiscaistipo.asString = 'Cupons') then
        begin


          vQtItensComNota := qryDadosFiscaisdevolver.asCurrency;
          if vQtItensSemNota <> 0 then
          begin
            vQtItensComNotaMarcado := SomarValores(qryProdutosSeries,
                                              [nil],
                                              [qryProdutosSeriesdevolvido, qryProdutosSeriesdadofiscal],
                                              ['True', qryDadosFiscaisdadofiscal.asString], ['=','=']);

            if vQtItensComNota <> vQtItensComNotaMarcado then
            begin
              result := false;
              MensagemAviso('Itens a devolver na NF/CUPOM ' + qryDadosFiscaisnota.asstring + qryDadosFiscaiscupom.asString+' : ' +  floattostr(vQtItensComNota) + chr(13) +
                            'Séries marcadas : ' + floattostr(vQtItensComNotaMarcado) + chr(13) +
                            'Marque corretamente os números de séries a serem devolvidas.');
            end;
          end;
        end;

        qryDadosFiscais.next;

      end;
    end;
  end;

end;

procedure TdtmDevolucaoMercadorias.qryProdutosSeriesAfterPost(
  DataSet: TDataSet);
begin
  inherited;
  if qryProdutosSeriesdadofiscal.isnull then
  begin
    qryProdutosContratosSeries.edit;
    qryProdutosContratosSeriesdevolvido.asBoolean := qryProdutosSeriesdevolvido.asBoolean;
    qryProdutosContratosSeries.post;
  end;
end;

procedure TdtmDevolucaoMercadorias.qryProdutosContratosCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  qryProdutosContratosDescontoTotal.AsCurrency :=
    qryProdutosContratosdesconto.AsCurrency +
    qryProdutosContratosvalordescontoitem.AsCurrency;

end;

function TdtmDevolucaoMercadorias.GetValorDescontoItem: Currency;
begin
  Result := FValorDescontoItem;
end;

procedure TdtmDevolucaoMercadorias.qryContratosCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  qryContratosDescontoTotal.asCurrency :=
     qryContratosDesconto.AsCurrency +
     qryContratosvalordescontoitem.AsCurrency;


end;

procedure TdtmDevolucaoMercadorias.qryDadosFiscaisAfterPost(
  DataSet: TDataSet);
begin
  inherited;
  if qryDadosFiscaislote.asInteger <> 0 then
  begin
    if qryProdutosLotes.locate('dadofiscal;numeroproduto;produto;filial;lote',
        VarArrayOf([qryDadosFiscaisdadofiscal.asinteger,
                    qryDadosFiscaisnumeroproduto.asinteger,
                    qryDadosFiscaisproduto.asString,
                    qryDadosFiscaisfilial.asinteger,
                    qryDadosFiscaislote.asString]), []) then
    begin
      qryProdutosLotes.edit;
      qryProdutosLotesdevolver.asFloat := qryDadosFiscaisdevolver.asFloat;
      qryProdutosLotes.post;
    end
    else
    begin
      qryProdutosLotes.append;

      qryProdutosLotesdadofiscal.asInteger := qryDadosFiscaisdadofiscal.asinteger;
      qryProdutosLotesnumeroproduto.asinteger := qryDadosFiscaisnumeroproduto.asinteger;
      qryProdutosLotesproduto.asString := qryDadosFiscaisproduto.asString;
      qryProdutosLotesfilial.asInteger := qryDadosFiscaisfilial.asinteger;
      qryProdutosLoteslote.asString := qryDadosFiscaislote.asString;
      qryProdutosLotesdevolver.asFloat := qryDadosFiscaisdevolver.asFloat;

      qryProdutosLotes.post;

    end;
  end;  
end;

procedure TdtmDevolucaoMercadorias.DesabilitarValoresProdutosContratosViaDadosFiscais(
  produto: int64);
var i: integer;  
begin
  for i := 0 to length(produtoseServicos[produtos])-1 do
  begin
    if produtoseServicos[produtos][i].produto = produto then
      produtoseServicos[produtos][i].RegistroOK := false;
  end;
end;

end.
