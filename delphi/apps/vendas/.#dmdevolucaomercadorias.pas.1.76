procedure TdtmDevolucaoMercadorias.dsrServicosContratosDataChange(
  Sender: TObject; Field: TField);
var
  msg: string;
  Pos: TBookmark;
  Entregar: Currency;
begin
  if Field = qryServicosContratosdevolver then
  begin
    dsrServicosContratos.OnDataChange := nil;
    if Field.AsCurrency = 0 then msg:= 'Mínimo'
    else                         msg:= 'Máximo';

    if not (Field.AsCurrency <= (qryServicosContratosquantidade.AsCurrency -
                                 qryServicosContratoscancelado.AsCurrency)) then
    begin
      MensagemAviso(Format(ctQUANTIDADEADEVOLVER,[msg,FloatToStr(qryServicosContratosquantidade.AsCurrency -
                                                               qryServicosContratoscancelado.AsCurrency)]));
      qryServicosContratos.Cancel;
      Field.FocusControl;
    end
    else
      AtualizaValores;
    dsrServicosContratos.OnDataChange := dsrServicosContratosDataChange;
  end;
end;

function TdtmDevolucaoMercadorias.TodosServicosDevolvidos: Boolean;
var
  Aux: Boolean;
begin
  Aux:= (qryServicosContratos.recordcount=0);
  qryServicosContratos.First;
  while not qryServicosContratos.Eof do
  begin

    Aux:= (((qryServicosContratosquantidade.AsCurrency = qryServicosContratoscancelado.AsCurrency) and (qryServicosContratosdevolver.AsCurrency = 0)) or
           ((qryServicosContratosdevolver.AsCurrency > 0) and ((qryServicosContratosquantidade.AsCurrency - qryServicosContratoscancelado.AsCurrency) = qryServicosContratosdevolver.AsCurrency)));

    if not Aux then
      Break;
    qryServicosContratos.Next;
  end;
  Result:= Aux;
end;

