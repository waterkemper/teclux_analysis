{ TdtmDevolucaoMercadorias }

function TdtmDevolucaoMercadorias.AlterarParcelamento: Boolean;
var
  Pos         : TBookmark;
  A,NR        : Integer;
  Valor,
  Faltam,
  Diferenca,
  TotalAberto,
  vDevolveCreditoTroca : Currency;
  CParcelas   : Array of Variant;
  vFinalArquivo : boolean;

begin
  Result:= False;
  if ContratoPodeDevolver then begin
    qryParcelasContratos.DisableControls;
    try
      TotalAberto := 0;
      for a:= 0 to Length(NewParcelas)-1 do begin
        if NewParcelas[A].DataPagto = 0 then
          TotalAberto:= TotalAberto + NewParcelas[A].ValorVencto;
      end;

//      Diferenca:= FOldValorPrazo - ((FValorAberto + FPagoVencto) - FDevolvePagto);

//      FValorDevolvido := DevolveemAberto + DevolveCreditoTroca + DevolvePagto;

      NR:= qryParcelasContratos.RecordCount;

      vfinalarquivo := false;
      while DevolveemAberto<>0 do
      begin
        if vfinalarquivo then
          break;

        qryParcelasContratos.First;
        while not qryParcelasContratos.Eof do
        begin
          if qryParcelasContratosdatapagto.asdatetime = 0 then
          begin
            if Devolveemaberto >= qryParcelasContratosvalorvencto.ascurrency then
            begin
              qryParcelasContratos.edit;
              qryParcelasContratosfilialpagto.AsInteger    := FilialBase;
              qryParcelasContratosvalorpagto.AsCurrency    := qryParcelasContratosvalorvencto.AsCurrency;
              qryParcelasContratosdatapagto.AsDateTime     := DataServidor;
              qryParcelasContratostipopagto.AsString       := 'E';
              qryParcelasContratosdeventrada.Clear;
              qryParcelasContratosdevcaixa.Clear;
              qryParcelasContratos.Post;
              Devolveemaberto := Devolveemaberto - qryParcelasContratosvalorvencto.AsCurrency;
            end
            else
            begin
              SetLength(CParcelas,qryParcelasContratos.FieldCount);
              for A:= 0 to qryParcelasContratos.FieldCount - 1 do
                CParcelas[A]:= qryParcelasContratos.Fields[A].AsVariant;

              Inc(NR);
              Pos:= qryParcelasContratos.GetBookmark;
              try
                qryParcelasContratos.Insert;
                for A:= 0 to qryParcelasContratos.FieldCount - 1 do
                  qryParcelasContratos.Fields[A].AsVariant:= CParcelas[A];
                qryParcelasContratosnumero.AsInteger           := NR;
                qryParcelasContratosvalorvencto.AsCurrency := Devolveemaberto;
                qryParcelasContratosfilialpagto.AsInteger    := FilialBase;
                qryParcelasContratosvalorpagto.AsCurrency    := qryParcelasContratosvalorvencto.AsCurrency;
                qryParcelasContratosdatapagto.AsDateTime     := DataServidor;
                qryParcelasContratostipopagto.AsString       := 'E';
                qryParcelasContratosdeventrada.Clear;
                qryParcelasContratosdevcaixa.Clear;
                qryParcelasContratos.Post;
              finally
                qryParcelasContratos.GotoBookmark(Pos);
                qryParcelasContratos.FreeBookmark(Pos);
                qryParcelasContratos.edit;
                qryParcelasContratosvalorvencto.AsCurrency := qryParcelasContratosvalorvencto.AsCurrency - Devolveemaberto;
                qryParcelasContratos.Post;
                Devolveemaberto := 0;
              end;
            end;
          end;

          if Devolveemaberto = 0 then
            break;

          qryParcelasContratos.next;

          if qryparcelascontratos.eof then
            vfinalarquivo := true;


        end;
      end;

      while DevolvePagto<>0 do
      begin
        qryParcelasContratos.First;
        while not qryParcelasContratos.Eof do
        begin
          if (qryParcelasContratosdatapagto.asdatetime <> 0) and
             ((qryParcelasContratostipopagto.AsString = '') or
              (qryParcelasContratostipopagto.AsString = 'B')) and
              (qryParcelasContratosformapagamento.AsString <> 'T') then
          begin
            if DevolvePagto >= qryParcelasContratosvalorvencto.ascurrency then
            begin
              qryParcelasContratos.edit;
              qryParcelasContratostipopagto.AsString       := 'D';
              qryParcelasContratosdeventrada.AsDateTime:= DataServidor;
              qryParcelasContratosdevcaixa.Clear;
              qryParcelasContratos.Post;
              DevolvePagto := DevolvePagto - qryParcelasContratosvalorvencto.AsCurrency;
            end
            else
            begin
              SetLength(CParcelas,qryParcelasContratos.FieldCount);
              for A:= 0 to qryParcelasContratos.FieldCount - 1 do
                CParcelas[A]:= qryParcelasContratos.Fields[A].AsVariant;

              qryParcelasContratos.Edit;
              qryParcelasContratosvalorvencto.AsCurrency := DevolvePagto;
              qryParcelasContratosvalorpagto.AsCurrency  := DevolvePagto + qryParcelasContratosJuros.AsCurrency;
              qryParcelasContratostipopagto.AsString     := 'D';
              qryParcelasContratosdeventrada.AsDateTime  := DataServidor;
              qryParcelasContratos.Post;


              Inc(NR);
              Pos:= qryParcelasContratos.GetBookmark;
              try
                qryParcelasContratos.Insert;
                for A:= 0 to qryParcelasContratos.FieldCount - 1 do
                  qryParcelasContratos.Fields[A].AsVariant:= CParcelas[A];
                qryParcelasContratosnumero.AsInteger           := NR;

                qryParcelasContratosvalorvencto.AsCurrency := qryParcelasContratosvalorvencto.AsCurrency - DevolvePagto;
                qryParcelasContratosvalorpagto.AsCurrency  := qryParcelasContratosvalorvencto.AsCurrency;
                qryParcelasContratos.Post;
              finally
                qryParcelasContratos.GotoBookmark(Pos);
                qryParcelasContratos.FreeBookmark(Pos);
                DevolvePagto := 0;
              end;
            end;
          end;

          if DevolvePagto = 0 then
            break;

          qryParcelasContratos.next;
        end;
      end;

      vDevolveCreditoTroca := DevolveCreditoTroca;

      while vDevolveCreditoTroca<>0 do
      begin
        qryParcelasContratos.First;
        while not qryParcelasContratos.Eof do
        begin
          if (qryParcelasContratosdatapagto.asdatetime <> 0) and
             ((qryParcelasContratostipopagto.AsString = '') or
              (qryParcelasContratostipopagto.AsString = 'B')) and
              (qryParcelasContratosformapagamento.AsString = 'T') then
          begin
            if vDevolveCreditoTroca >= qryParcelasContratosvalorvencto.ascurrency then
            begin
              qryParcelasContratos.edit;
              qryParcelasContratostipopagto.AsString       := 'C';
              qryParcelasContratosdeventrada.AsDateTime:= DataServidor;
              qryParcelasContratosdevcaixa.Clear;
              qryParcelasContratos.Post;
              vDevolveCreditoTroca := vDevolveCreditoTroca - qryParcelasContratosvalorvencto.AsCurrency;
            end
            else
            begin
              SetLength(CParcelas,qryParcelasContratos.FieldCount);
              for A:= 0 to qryParcelasContratos.FieldCount - 1 do
                CParcelas[A]:= qryParcelasContratos.Fields[A].AsVariant;

              qryParcelasContratos.Edit;
              qryParcelasContratosvalorvencto.AsCurrency := vDevolveCreditoTroca;
              qryParcelasContratosvalorpagto.AsCurrency  := vDevolveCreditoTroca;
              qryParcelasContratostipopagto.AsString     := 'C';
              qryParcelasContratosdeventrada.AsDateTime  := DataServidor;
              qryParcelasContratos.Post;


              Inc(NR);
              Pos:= qryParcelasContratos.GetBookmark;
              try
                qryParcelasContratos.Insert;
                for A:= 0 to qryParcelasContratos.FieldCount - 1 do
                  qryParcelasContratos.Fields[A].AsVariant:= CParcelas[A];
                qryParcelasContratosnumero.AsInteger           := NR;

                qryParcelasContratosvalorvencto.AsCurrency := qryParcelasContratosvalorvencto.AsCurrency - vDevolveCreditoTroca;
                qryParcelasContratosvalorpagto.AsCurrency  := qryParcelasContratosvalorvencto.AsCurrency;
                qryParcelasContratos.Post;
              finally
                qryParcelasContratos.GotoBookmark(Pos);
                qryParcelasContratos.FreeBookmark(Pos);
                vDevolveCreditoTroca := 0;
              end;
            end;
          end;

          if vDevolveCreditoTroca = 0 then
            break;

          qryParcelasContratos.next;
        end;
      end;

      Result:= True;
    finally
      qryParcelasContratos.EnableControls;
    end;

    AtualizaValoresDevolvidos;
  end
  else
    MensagemAviso(ctPRODUTONAOSELECIONADO);
end;

{
procedure TdtmDevolucaoMercadorias.AtualizaProdutosListaCasamento;
begin
  ReFazConsulta(qryProdutosListaCasamento,[0],[qryContratoslistacasamento.AsInteger]);
  if qryProdutosListaCasamento.Locate('produto',qryProdutosContratosProduto.AsString,[]) then begin
    qryProdutosListaCasamento.Edit;
    qryProdutosListaCasamentoqtdevendida.AsCurrency:= (qryProdutosListaCasamentoqtdevendida.AsCurrency -
                                                      qryProdutosContratosdevolver.AsCurrency);
    qryProdutosListaCasamento.Post;
  end;
end;
}

procedure TdtmDevolucaoMercadorias.ValidarTotaisContratosDevolvidos_TotaisContratos;
var
  VVista, VPrazo, VDescto, vValorDescontoItem, vImpostoRetido, VFrete, VSeguro, VTroca, vIPI, vICMSST: Currency;

  function ProcuraContratoDevolvidocomProduto: boolean;
  begin
    result := false;
    qryContratosDevolvidos.last;
    while not qryContratosDevolvidos.bof do
    begin
      if not qrycontratosdevolvidosproduto.isnull then
      begin
        result := true;
        break;
      end;
      qrycontratosdevolvidos.prior;
    end;
  end;

  function ProcuraContratoDevolvidocomServico: boolean;
  begin
    result := false;
    qryContratosDevolvidos.last;
    while not qryContratosDevolvidos.bof do
    begin
      if not qrycontratosdevolvidosservico.isnull then
      begin
        result := true;
        break;
      end
      else
        qrycontratosdevolvidos.prior;
    end;
  end;

  function CondicaoTodosValores: boolean;
  begin
    result := (
                ( ((qryContratossituacao.AsString = 'F') and TodosProdutosDevolvidos) or
                  (((qryContratossituacao.AsString = 'N') or (qryContratossituacao.AsString = 'P'))  and TodosProdutosEntreguesDevolvidos)
                 )
                 and TodosServicosDevolvidos
               ) ;

  end;

  function CondicaoExisteProdutoDevolvido: boolean;
  begin
    result := (
               ( ((qryContratossituacao.AsString = 'F') and TodosProdutosDevolvidos) or
                 (((qryContratossituacao.AsString = 'N') or (qryContratossituacao.AsString = 'P'))  and TodosProdutosEntreguesDevolvidos)
               )
                 and (DevolveProduto<>0)
              ) ;
  end;

begin
  VVista:= 0; VPrazo:= 0; VDescto:= 0; vValorDescontoItem:=0; vImpostoRetido:=0; VFrete:= 0; VSeguro:= 0; VTroca:= 0; vIPI:=0; vICMSST:=0;
  qryContratosDevolvidos.First;
  while not qryContratosDevolvidos.Eof do
  begin
    VVista  := VVista  + qryContratosDevolvidosvalorvista.AsCurrency;
    VPrazo  := VPrazo  + qryContratosDevolvidosvalorprazo.AsCurrency;
    VDescto := VDescto + qryContratosDevolvidosdesconto.AsCurrency;
    vValorDescontoItem := vValorDescontoItem + qryContratosDevolvidosvalordescontoitem.asCurrency;
    vImpostoRetido := vImpostoRetido + qryContratosDevolvidosimpostoretido.AsCurrency;
    VFrete  := VFrete  + qryContratosDevolvidosfrete.AsCurrency;
    VSeguro := VSeguro + qryContratosDevolvidosseguro.AsCurrency;
    VTroca  := VTroca  + qryContratosDevolvidoscreditotroca.AsCurrency;
    vIPI := vIPI + qryContratosDevolvidosvaloripi.AsCurrency;
    vICMSST := vICMSST + qryContratosDevolvidosvaloricmssubstituicao.AsCurrency;
    qryContratosDevolvidos.Next;
  end;

  VVista  := VVista  + qryValoresDevolvidosvalorvista_p.AsCurrency + qryValoresDevolvidosvalorvista_s.AsCurrency +
                       qryValoresTrocadosvalorvista_p.asCurrency + qryValoresTrocadosvalorvista_s.AsCurrency;

  VPrazo  := VPrazo  + qryValoresDevolvidosvalorprazo_p.AsCurrency + qryValoresDevolvidosvalorprazo_s.AsCurrency +
                       qryValoresTrocadosvalorprazo_p.AsCurrency + qryValoresTrocadosvalorprazo_s.AsCurrency;

  VDescto := VDescto + qryValoresDevolvidosdesconto_p.AsCurrency +
                       qryValoresTrocadosdesconto_p.AsCurrency;

  vValorDescontoItem := vValorDescontoItem + qryValoresDevolvidosvalordescontoitem_p.AsCurrency
                                           + qryValoresTrocadosvalordescontoitem_p.AsCurrency;

  vImpostoRetido := vImpostoRetido + qryValoresDevolvidosimpostoretido_s.AsCurrency +
                                     qryValoresTrocadosimpostoretido_s.AsCurrency;

  VFrete  := VFrete  + qryValoresDevolvidosfrete_p.AsCurrency +
                     + qryValoresTrocadosfrete_p.AsCurrency;

  VSeguro := VSeguro + qryValoresDevolvidosseguro_p.AsCurrency
                     + qryValoresTrocadosseguro_p.AsCurrency;

  VTroca  := VTroca  + qryValoresDevolvidoscreditotroca_p.AsCurrency + qryValoresDevolvidoscreditotroca_s.AsCurrency +
                       qryValoresTrocadoscreditotroca_p.AsCurrency + qryValoresTrocadoscreditotroca_s.AsCurrency;

  vIPI := vIPI + qryValoresDevolvidosvaloripi_p.AsCurrency +
                 qryValoresTrocadosvaloripi_p.AsCurrency;

  vICMSST := vICMSST + qryValoresDevolvidosvaloricmssubstituicao_p.AsCurrency +
                       qryValoresTrocadosvaloricmssubstituicao_p.AsCurrency;

  if ProcuraContratoDevolvidocomProduto or    //dar prioridade para fazer o acerto nos produtos e não nos serviços
     ProcuraContratoDevolvidocomServico then
  begin
    if CondicaoTodosValores then
    begin
      if truncar(VVista,2) <> qryContratosvalorvista.AsCurrency then begin
        qryContratosDevolvidos.Edit;
        qryContratosDevolvidosvalorvista.AsCurrency:= qryContratosDevolvidosvalorvista.AsCurrency +
                                                      (qryContratosvalorvista.AsCurrency - VVista);
        qryContratosDevolvidos.Post;
      end;

      if truncar(VPrazo,2) <> qryContratosvalorprazo.AsCurrency then begin
        qryContratosDevolvidos.Edit;
        qryContratosDevolvidosvalorprazo.AsCurrency:= qryContratosDevolvidosvalorprazo.AsCurrency +
                                                      (qryContratosvalorprazo.AsCurrency - VPrazo);
        qryContratosDevolvidos.Post;
      end;

      if truncar(VTroca,2) <> qryContratoscreditotroca.AsCurrency then
      begin
        qryContratosDevolvidos.Edit;
        qryContratosDevolvidoscreditotroca.AsCurrency:= qryContratosDevolvidoscreditotroca.AsCurrency +
                                                        (qryContratoscreditotroca.AsCurrency - VTroca);
        qryContratosDevolvidos.Post;
      end;

    end;

    if CondicaoExisteProdutoDevolvido { not qryContratosDevolvidosproduto.isnull} then
    begin
      if truncar(VDescto,2) <> qryContratosdesconto.AsCurrency then
      begin
        qryContratosDevolvidos.Edit;
        qryContratosDevolvidosdesconto.AsCurrency:= qryContratosDevolvidosdesconto.AsCurrency +
                                                      (qryContratosdesconto.AsCurrency - VDescto);
        qryContratosDevolvidos.Post;
      end;

      if truncar(vValordescontoitem,2) <> qryContratosvalordescontoitem.AsCurrency then
      begin
        qryContratosDevolvidos.Edit;
        qryContratosDevolvidosvalordescontoitem.AsCurrency:= qryContratosDevolvidosvalordescontoitem.AsCurrency +
                                                      (qryContratosvalordescontoitem.AsCurrency - VValorDescontoItem);
        qryContratosDevolvidos.Post;
      end;


      if truncar(VFrete,2) <> qryContratosfrete.AsCurrency then
      begin
        qryContratosDevolvidos.Edit;
        qryContratosDevolvidosfrete.AsCurrency:= qryContratosDevolvidosfrete.AsCurrency +
                                                      (qryContratosfrete.AsCurrency - VFrete);
        qryContratosDevolvidos.Post;
      end;

      if truncar(VSeguro,2) <> qryContratosseguro.AsCurrency then
      begin
        qryContratosDevolvidos.Edit;
        qryContratosDevolvidosseguro.AsCurrency:= qryContratosDevolvidosseguro.AsCurrency +
                                                      (qryContratosseguro.AsCurrency - VSeguro);
        qryContratosDevolvidos.Post;
      end;

      if truncar(vIPI,2) <> qryContratostotalipi.AsCurrency then
      begin
        qryContratosDevolvidos.Edit;
        qryContratosDevolvidosvaloripi.AsCurrency:= qryContratosDevolvidosvaloripi.AsCurrency +
                                                      (qryContratostotalipi.AsCurrency - vIPI);
        qryContratosDevolvidos.Post;
      end;

      if truncar(vICMSST,2) <> qryContratosvaloricmssubstituicao.AsCurrency then
      begin
        qryContratosDevolvidos.Edit;
        qryContratosDevolvidosvaloricmssubstituicao.AsCurrency:= qryContratosDevolvidosvaloricmssubstituicao.AsCurrency +
                                                      (qryContratosvaloricmssubstituicao.AsCurrency - vICMSST);
        qryContratosDevolvidos.Post;
      end;

    end;

    if ProcuraContratoDevolvidocomServico then   // imposto retido é somente nos serviços
    begin
      if truncar(vImpostoRetido,2) <> qryContratosvalorimpostoretido.AsCurrency then
      begin
        qryContratosDevolvidos.Edit;
        qryContratosDevolvidosimpostoretido.AsCurrency:= qryContratosDevolvidosimpostoretido.AsCurrency +
                                                      (qryContratosvalorimpostoretido.AsCurrency - vImpostoRetido);
        qryContratosDevolvidos.Post;
      end;
    end;
  end;


end;

procedure TdtmDevolucaoMercadorias.AtualizaValoresDevolvidos;
var
  vPos: TBookmark;
 { vA: Integer;}
  vValorPrazo,
  vValorMov,
  vDescontoDevolvido,
  vValorDescontoItemDevolvido,
  vFreteDevolvido,
  vSeguroDevolvido,
  vAcrescimoDevolvido,
  vImpostoRetidoDevolvido,
  vIPIDevolvido,
  vIcmsSubstituicaoDevolvido,
  vQtde, vQtdeMov, vSaldo: Currency;
  vSituacao: Char;
  vMovExtra, vFaltam: Boolean;

begin
  if qryContratosDevolvidos.Active then
    qryContratosDevolvidos.Close;
  qryContratosDevolvidos.Open;

  vValorPrazo := 0;

  qryProdutosContratos.DisableControls;
  vPos:= qryProdutosContratos.GetBookmark;
  try

    qryProdutosContratos.First;
    while not qryProdutosContratos.eof do
//    for vA:= 0 to qryProdutosContratos.RecordCount - 1 do
    begin

        { Sem Lotes }

      vDescontoDevolvido := 0;
      vValorDescontoItemDevolvido := 0;
      vFreteDevolvido    := 0;
      vSeguroDevolvido   := 0;
      vAcrescimoDevolvido:= 0;
      vIPIDevolvido := 0;
      vIcmsSubstituicaoDevolvido := 0;

      vQtde := 0;
      vMovExtra := False;



      if not qryProdutosContratosbrinde.AsBoolean and
             (qryProdutosContratoscancelado.AsCurrency < qryProdutosContratosquantidade.AsCurrency) then
      begin

        if (qryProdutosContratosdevolver.AsCurrency > 0) then
        begin
          { Sem lotes }
          if qryProdutosContratosquantidadelotes.asFloat = 0 then
          begin

            while (vQtde < qryProdutosContratosdevolver.AsCurrency) do
            begin
              if (vMovExtra or (qryProdutosContratosdevolver.AsCurrency = qryProdutosContratosqtdeentregueparadevolver.AsCurrency)) then
              begin
                vQtdeMov  := qryProdutosContratosqtdeentregueparadevolver.AsCurrency;
                vSituacao := 'N';
              end
              else
              begin
                vQtdeMov  := qryProdutosContratosdevolver.AsCurrency - qryProdutosContratosqtdeentregueparadevolver.AsCurrency;
                vSituacao := 'F';
              end;

              vQtde := vQtde + vQtdeMov;
              vMovExtra := (vQtde < qryProdutosContratosdevolver.AsCurrency);

              qryContratosDevolvidos.Append;
              qryContratosDevolvidoscontrato.AsString        := qryContratosnumero.AsString;
              qryContratosDevolvidosproduto.AsLargeInt       := qryProdutosContratosproduto.AsLargeInt;
              qryContratosDevolvidosfilial.AsInteger         := qryProdutosContratosfilial.AsInteger;
              qryContratosDevolvidosdevolucao.AsDateTime     := DataServidor;
              qryContratosDevolvidosquantidade.AsCurrency    := vQtdeMov;

              vFaltam:= (qryProdutosContratosquantidade.AsCurrency -
                        qryProdutosContratoscancelado.AsCurrency  -
                        vQtde )  > 0;

              if not vFaltam then  //GARANTE O FECHAMENTO DOS VALORES NO CASO DE DEVOLUCAO TOTAL DO PRODUTO
              begin

                if not qryProdutosContratosDevolvidos.IsEmpty then
                begin
                  try
                    GuardarRegistroAtual(qryProdutosContratosDevolvidos,true);
                    qryProdutosContratosDevolvidos.First;
                    while not qryProdutosContratosDevolvidos.Eof do
                    begin
                      if qryProdutosContratosproduto.AsString = qryProdutosContratosDevolvidosproduto.AsString then
                      begin
                        vDescontoDevolvido := vDescontoDevolvido + qryProdutosContratosDevolvidosdesconto.AsCurrency;
                        vValorDescontoItemDevolvido := vValorDescontoItemDevolvido + qryprodutoscontratosdevolvidosvalordescontoitem.asCurrency;
                        vFreteDevolvido    := vFreteDevolvido    + qryProdutosContratosDevolvidosfrete.AsCurrency;
                        vSeguroDevolvido   := vSeguroDevolvido   + qryProdutosContratosDevolvidosseguro.AsCurrency;
                        vAcrescimoDevolvido:= vAcrescimoDevolvido+ qryProdutosContratosDevolvidosacrescimo.AsCurrency;
                        vIPIDevolvido    := vIPIDevolvido    + qryProdutosContratosDevolvidosvaloripi.AsCurrency;
                        vIcmsSubstituicaoDevolvido    := vIcmsSubstituicaoDevolvido    + qryProdutosContratosDevolvidosvaloricmssubstituicao.AsCurrency;

                      end;
                      qryProdutosContratosDevolvidos.Next;
                    end;
                  finally
                    VoltarRegistroAtual(qryProdutosContratosDevolvidos);
                  end;
                end;

                if qryProdutosContratosdesconto.AsCurrency > 0 then
                  qryContratosDevolvidosdesconto.AsCurrency   := Truncar(qryProdutosContratosdesconto.AsCurrency - vDescontoDevolvido,2)
                else qryContratosDevolvidosdesconto.AsCurrency := 0;

                if qryProdutosContratosvalordescontoitem.AsCurrency > 0 then
                  qryContratosDevolvidosvalordescontoitem.AsCurrency   := Truncar(qryProdutosContratosvalordescontoitem.AsCurrency - vValorDescontoItemDevolvido,2)
                else qryContratosDevolvidosvalordescontoitem.AsCurrency := 0;

                if DevolverFrete then
                  qryContratosDevolvidosfrete.AsCurrency      := Truncar(qryProdutosContratosfrete.AsCurrency - vFreteDevolvido,2)
                else qryContratosDevolvidosfrete.AsCurrency   := 0;

                if DevolverSeguro then
                  qryContratosDevolvidosseguro.AsCurrency     := Truncar(qryProdutosContratosseguro.AsCurrency - vSeguroDevolvido,2)
                else qryContratosDevolvidosseguro.AsCurrency  := 0;

                if qryProdutosContratosvaloripi.AsCurrency > 0 then
                  qryContratosDevolvidosvaloripi.AsCurrency   := Truncar(qryProdutosContratosvaloripi.AsCurrency - vIPIDevolvido,2)
                else qryContratosDevolvidosvaloripi.AsCurrency := 0;

                if qryProdutosContratosicmsvalorst.AsCurrency > 0 then
                  qryContratosDevolvidosvaloricmssubstituicao.AsCurrency   := Truncar(qryProdutosContratosicmsvalorst.AsCurrency - vIcmsSubstituicaoDevolvido,2)
                else qryContratosDevolvidosvaloricmssubstituicao.AsCurrency := 0;

                vValorMov := ( qryProdutosContratosprecovenda.AsCurrency * vQtdeMov) + qryContratosDevolvidosfrete.AsCurrency
                                                            + qryContratosDevolvidosseguro.AsCurrency
                                                            + qryContratosDevolvidosvaloripi.AsCurrency
                                                            + qryContratosDevolvidosvaloricmssubstituicao.AsCurrency
                                                            - qryContratosDevolvidosdesconto.AsCurrency
                                                            - qryContratosDevolvidosValorDescontoItem.asCurrency;

                qryContratosDevolvidosvalorvista.AsCurrency   := Truncar(vvalorMov,2);
                qryContratosDevolvidosvalorprazo.AsCurrency   := Truncar(vvalorMov + (qryProdutosContratosacrescimo.AsCurrency - vAcrescimoDevolvido),2);

              end
              else
              begin
                if qryProdutosContratosdesconto.AsCurrency > 0 then
                  qryContratosDevolvidosdesconto.AsCurrency    := truncar(RatearValores(qryProdutosContratosdesconto.AsCurrency, qryProdutosContratosquantidade.AsCurrency, vQtdeMov),2)
                else qryContratosDevolvidosdesconto.AsCurrency := 0;

                if qryProdutosContratosvalordescontoitem.AsCurrency > 0 then
                  qryContratosDevolvidosvalordescontoitem.AsCurrency    := truncar(RatearValores(qryProdutosContratosvalordescontoitem.AsCurrency, qryProdutosContratosquantidade.AsCurrency, vQtdeMov),2)
                else qryContratosDevolvidosvalordescontoitem.AsCurrency := 0;

                if DevolverSeguro and (qryProdutosContratosseguro.AsCurrency > 0) then
                  qryContratosDevolvidosseguro.AsCurrency      := truncar(RatearValores(qryProdutosContratosseguro.AsCurrency, qryProdutosContratosquantidade.AsCurrency, vQtdeMov),2)
                else qryContratosDevolvidosseguro.AsCurrency   := 0;

                if DevolverFrete and (qryProdutosContratosfrete.AsCurrency > 0) then
                  qryContratosDevolvidosfrete.AsCurrency       := truncar(RatearValores(qryProdutosContratosfrete.AsCurrency, qryProdutosContratosquantidade.AsCurrency, vQtdeMov),2)
                else qryContratosDevolvidosfrete.AsCurrency    := 0;

                if (qryProdutosContratosvaloripi.AsCurrency > 0) then
                  qryContratosDevolvidosvaloripi.AsCurrency       := truncar(RatearValores(qryProdutosContratosvaloripi.AsCurrency, qryProdutosContratosquantidade.AsCurrency, vQtdeMov),2)
                else qryContratosDevolvidosvaloripi.AsCurrency    := 0;

                if (qryProdutosContratosicmsvalorst.AsCurrency > 0) then
                  qryContratosDevolvidosvaloricmssubstituicao.AsCurrency       := truncar(RatearValores(qryProdutosContratosicmsvalorst.AsCurrency, qryProdutosContratosquantidade.AsCurrency, vQtdeMov),2)
                else qryContratosDevolvidosvaloricmssubstituicao.AsCurrency   := 0;

                vValorMov := (qryProdutosContratosprecovenda.AsCurrency * vQtdeMov) + qryContratosDevolvidosfrete.AsCurrency
                                                            + qryContratosDevolvidosseguro.AsCurrency
                                                            + qryContratosDevolvidosvaloripi.AsCurrency
                                                            + qryContratosDevolvidosvaloricmssubstituicao.AsCurrency
                                                            - qryContratosDevolvidosdesconto.AsCurrency
                                                            - qryContratosDevolvidosValorDescontoItem.asCurrency;

                qryContratosDevolvidosvalorvista.AsCurrency    := Truncar(vvalorMov,2);
                qryContratosDevolvidosvalorprazo.AsCurrency    := Truncar(vvalorMov + RatearValores(qryProdutosContratosacrescimo.AsCurrency, qryProdutosContratosquantidade.AsCurrency, vQtdeMov),2);

              end;

              qryContratosDevolvidossituacao.AsString := vsituacao;
              qryContratosDevolvidos.Post;

              vDescontoDevolvido := vDescontoDevolvido + qryContratosDevolvidosdesconto.AsCurrency;
              vValorDescontoItemDevolvido := vValorDescontoItemDevolvido + qryprodutoscontratosdevolvidosvalordescontoitem.asCurrency;
              vFreteDevolvido    := vFreteDevolvido    + qryContratosDevolvidosfrete.AsCurrency;
              vSeguroDevolvido   := vSeguroDevolvido   + qryContratosDevolvidosseguro.AsCurrency;
              vAcrescimoDevolvido:= vAcrescimoDevolvido + (qryContratosDevolvidosvalorprazo.AsCurrency - qryContratosDevolvidosvalorvista.AsCurrency);
              vIPIDevolvido    := vIPIDevolvido    + qryContratosDevolvidosvaloripi.AsCurrency;
              vIcmsSubstituicaoDevolvido    := vIcmsSubstituicaoDevolvido    + qryContratosDevolvidosvaloricmssubstituicao.AsCurrency;

              vValorPrazo := vValorPrazo + qryContratosDevolvidosvalorprazo.AsCurrency;

            end;
          end
          else
          {Com Lotes}
          begin
            qryProdutosContratos.enableControls;
            qryProdutosLotes.first;

            while not qryProdutosLotes.eof do
            begin
              if qryProdutosLotesdevolver.AsCurrency > 0 then
              begin
                vQtdeMov  := qryProdutosLotesdevolver.AsCurrency;
                if qryProdutosLotesdadofiscal.asinteger <> 0 then
                  vSituacao := 'N'
                else
                  vSituacao := 'F';


                vQtde := vQtde + vQtdeMov;
                vMovExtra := false {(vQtde < qryProdutosContratosdevolver.AsCurrency)};

                qryContratosDevolvidos.Append;
                qryContratosDevolvidoscontrato.AsString  := qryContratosnumero.AsString;
                qryContratosDevolvidosproduto.AsLargeInt := qryProdutosContratosproduto.AsLargeInt;
                qryContratosDevolvidosfilial.AsInteger   := qryProdutosContratosfilial.AsInteger;
                qryContratosDevolvidoslote.asLargeint    := qryProdutosLoteslote.AsLargeInt;

                qryContratosDevolvidosdevolucao.AsDateTime     := DataServidor;
                qryContratosDevolvidosquantidade.AsCurrency    := vQtdeMov;

                vFaltam:= (qryProdutosContratosquantidade.AsCurrency -
                          qryProdutosContratoscancelado.AsCurrency  -
                          vQtde )  > 0;

                if not vFaltam then  //GARANTE O FECHAMENTO DOS VALORES NO CASO DE DEVOLUCAO TOTAL DO PRODUTO
                begin

                  if not qryProdutosContratosDevolvidos.IsEmpty then
                  begin
                    try
                      GuardarRegistroAtual(qryProdutosContratosDevolvidos,true);
                      qryProdutosContratosDevolvidos.First;
                      while not qryProdutosContratosDevolvidos.Eof do
                      begin
                        if qryProdutosContratosproduto.AsString = qryProdutosContratosDevolvidosproduto.AsString then
                        begin
                          vDescontoDevolvido := vDescontoDevolvido + qryProdutosContratosDevolvidosdesconto.AsCurrency;
                          vValorDescontoItemDevolvido := vValorDescontoItemDevolvido + qryprodutoscontratosdevolvidosvalordescontoitem.asCurrency;
                          vFreteDevolvido    := vFreteDevolvido    + qryProdutosContratosDevolvidosfrete.AsCurrency;
                          vSeguroDevolvido   := vSeguroDevolvido   + qryProdutosContratosDevolvidosseguro.AsCurrency;
                          vAcrescimoDevolvido:= vAcrescimoDevolvido+ qryProdutosContratosDevolvidosacrescimo.AsCurrency;
                          vIPIDevolvido    := vIPIDevolvido    + qryProdutosContratosDevolvidosvaloripi.AsCurrency;
                          vIcmsSubstituicaoDevolvido    := vIcmsSubstituicaoDevolvido    + qryProdutosContratosDevolvidosvaloricmssubstituicao.AsCurrency;

                        end;
                        qryProdutosContratosDevolvidos.Next;
                      end;
                    finally
                      VoltarRegistroAtual(qryProdutosContratosDevolvidos);
                    end;
                  end;

                  if qryProdutosContratosdesconto.AsCurrency > 0 then
                    qryContratosDevolvidosdesconto.AsCurrency   := Truncar(qryProdutosContratosdesconto.AsCurrency - vDescontoDevolvido,2)
                  else
                    qryContratosDevolvidosdesconto.AsCurrency := 0;

                  if qryProdutosContratosvalordescontoitem.AsCurrency > 0 then
                    qryContratosDevolvidosvalordescontoitem.AsCurrency   := Truncar(qryProdutosContratosvalordescontoitem.AsCurrency - vValorDescontoItemDevolvido,2)
                  else
                    qryContratosDevolvidosvalordescontoitem.AsCurrency := 0;

                  if DevolverFrete then
                    qryContratosDevolvidosfrete.AsCurrency      := Truncar(qryProdutosContratosfrete.AsCurrency - vFreteDevolvido,2)
                  else
                    qryContratosDevolvidosfrete.AsCurrency   := 0;

                  if DevolverSeguro then
                    qryContratosDevolvidosseguro.AsCurrency     := Truncar(qryProdutosContratosseguro.AsCurrency - vSeguroDevolvido,2)
                  else
                    qryContratosDevolvidosseguro.AsCurrency  := 0;

                  if qryProdutosContratosvaloripi.AsCurrency > 0 then
                    qryContratosDevolvidosvaloripi.AsCurrency   := Truncar(qryProdutosContratosvaloripi.AsCurrency - vIPIDevolvido,2)
                  else
                    qryContratosDevolvidosvaloripi.AsCurrency := 0;

                  if qryProdutosContratosicmsvalorst.AsCurrency > 0 then
                    qryContratosDevolvidosvaloricmssubstituicao.AsCurrency   := Truncar(qryProdutosContratosicmsvalorst.AsCurrency - vIcmsSubstituicaoDevolvido,2)
                  else
                    qryContratosDevolvidosvaloricmssubstituicao.AsCurrency := 0;

                  vValorMov := ( qryProdutosContratosprecovenda.AsCurrency * vQtdeMov) + qryContratosDevolvidosfrete.AsCurrency
                                                              + qryContratosDevolvidosseguro.AsCurrency
                                                              + qryContratosDevolvidosvaloripi.AsCurrency
                                                              + qryContratosDevolvidosvaloricmssubstituicao.AsCurrency
                                                              - qryContratosDevolvidosdesconto.AsCurrency
                                                              - qryContratosDevolvidosValorDescontoItem.asCurrency;

                  qryContratosDevolvidosvalorvista.AsCurrency   := Truncar(vvalorMov,2);
                  qryContratosDevolvidosvalorprazo.AsCurrency   := Truncar(vvalorMov + (qryProdutosContratosacrescimo.AsCurrency - vAcrescimoDevolvido),2);

                end
                else
                begin
                  if qryProdutosContratosdesconto.AsCurrency > 0 then
                    qryContratosDevolvidosdesconto.AsCurrency    := truncar(RatearValores(qryProdutosContratosdesconto.AsCurrency, qryProdutosContratosquantidade.AsCurrency, vQtdeMov),2)
                  else
                    qryContratosDevolvidosdesconto.AsCurrency := 0;

                  if qryProdutosContratosvalordescontoitem.AsCurrency > 0 then
                    qryContratosDevolvidosvalordescontoitem.AsCurrency    := truncar(RatearValores(qryProdutosContratosvalordescontoitem.AsCurrency, qryProdutosContratosquantidade.AsCurrency, vQtdeMov),2)
                  else
                    qryContratosDevolvidosvalordescontoitem.AsCurrency := 0;

                  if DevolverSeguro and (qryProdutosContratosseguro.AsCurrency > 0) then
                    qryContratosDevolvidosseguro.AsCurrency      := truncar(RatearValores(qryProdutosContratosseguro.AsCurrency, qryProdutosContratosquantidade.AsCurrency, vQtdeMov),2)
                  else
                    qryContratosDevolvidosseguro.AsCurrency   := 0;

                  if DevolverFrete and (qryProdutosContratosfrete.AsCurrency > 0) then
                    qryContratosDevolvidosfrete.AsCurrency       := truncar(RatearValores(qryProdutosContratosfrete.AsCurrency, qryProdutosContratosquantidade.AsCurrency, vQtdeMov),2)
                  else
                    qryContratosDevolvidosfrete.AsCurrency    := 0;

                  if (qryProdutosContratosvaloripi.AsCurrency > 0) then
                    qryContratosDevolvidosvaloripi.AsCurrency       := truncar(RatearValores(qryProdutosContratosvaloripi.AsCurrency, qryProdutosContratosquantidade.AsCurrency, vQtdeMov),2)
                  else
                    qryContratosDevolvidosvaloripi.AsCurrency    := 0;

                  if (qryProdutosContratosicmsvalorst.AsCurrency > 0) then
                    qryContratosDevolvidosvaloricmssubstituicao.AsCurrency       := truncar(RatearValores(qryProdutosContratosicmsvalorst.AsCurrency, qryProdutosContratosquantidade.AsCurrency, vQtdeMov),2)
                  else
                    qryContratosDevolvidosvaloricmssubstituicao.AsCurrency   := 0;

                  vValorMov := (qryProdutosContratosprecovenda.AsCurrency * vQtdeMov) + qryContratosDevolvidosfrete.AsCurrency
                                                              + qryContratosDevolvidosseguro.AsCurrency
                                                              + qryContratosDevolvidosvaloripi.AsCurrency
                                                              + qryContratosDevolvidosvaloricmssubstituicao.AsCurrency
                                                              - qryContratosDevolvidosdesconto.AsCurrency
                                                              - qryContratosDevolvidosValorDescontoItem.asCurrency;

                  qryContratosDevolvidosvalorvista.AsCurrency    := Truncar(vvalorMov,2);
                  qryContratosDevolvidosvalorprazo.AsCurrency    := Truncar(vvalorMov + RatearValores(qryProdutosContratosacrescimo.AsCurrency, qryProdutosContratosquantidade.AsCurrency, vQtdeMov),2);

                end;

                qryContratosDevolvidossituacao.AsString := vsituacao;
                qryContratosDevolvidos.Post;

                vDescontoDevolvido := vDescontoDevolvido + qryContratosDevolvidosdesconto.AsCurrency;
                vValorDescontoItemDevolvido := vValorDescontoItemDevolvido + qryprodutoscontratosdevolvidosvalordescontoitem.asCurrency;
                vFreteDevolvido    := vFreteDevolvido    + qryContratosDevolvidosfrete.AsCurrency;
                vSeguroDevolvido   := vSeguroDevolvido   + qryContratosDevolvidosseguro.AsCurrency;
                vAcrescimoDevolvido:= vAcrescimoDevolvido + (qryContratosDevolvidosvalorprazo.AsCurrency - qryContratosDevolvidosvalorvista.AsCurrency);
                vIPIDevolvido    := vIPIDevolvido    + qryContratosDevolvidosvaloripi.AsCurrency;
                vIcmsSubstituicaoDevolvido    := vIcmsSubstituicaoDevolvido    + qryContratosDevolvidosvaloricmssubstituicao.AsCurrency;

                vValorPrazo := vValorPrazo + qryContratosDevolvidosvalorprazo.AsCurrency;

                if qryProdutosContratosLotes.locate('produto;filial;lote',
                    VarArrayOf([qryProdutosLotesproduto.asString,
                                qryProdutosLotesfilial.asinteger,
                                qryProdutosLoteslote.asString]), []) then
                begin
                  qryProdutosContratosLotes.edit;
                  qryProdutosContratosLotescancelado.asFloat := qryProdutosContratosLotescancelado.asFloat + qryProdutosLotesdevolver.asFloat;
                  qryProdutosContratosLotes.post;
                end;
                
              end;
              qryProdutosLotes.next;
            end;
          end;
        end;
      end;

      qryProdutosContratos.Next;

    end;

  finally
    qryProdutosContratos.GotoBookmark(vPos);
    qryProdutosContratos.FreeBookmark(vPos);
    qryProdutosContratos.EnableControls;
  end;

  // SERVIÇOS
  qryServicosContratos.DisableControls;
  vPos:= qryServicosContratos.GetBookmark;
  try
    qryServicosContratos.First;
    while not qryServicosContratos.eof do
//    for vA:= 0 to qryServicosContratos.RecordCount - 1 do
    begin
      if (qryServicosContratoscancelado.AsCurrency < qryServicosContratosquantidade.AsCurrency) then
      begin
        if (qryServicosContratosdevolver.AsCurrency > 0) then
        begin
          vQtdeMov := qryServicosContratosdevolver.AsCurrency;

          qryContratosDevolvidos.Append;
          qryContratosDevolvidoscontrato.AsString        := qryContratosnumero.AsString;
          qryContratosDevolvidosproduto.clear;

          qryContratosDevolvidosservico.asString := qryServicosContratosservico.asString;

          qryContratosDevolvidosfilial.AsInteger         := qryContratosfilialvenda.AsInteger;
          qryContratosDevolvidosdevolucao.AsDateTime     := DataServidor;
          qryContratosDevolvidosquantidade.AsCurrency    := vQtdeMov;

          qryContratosDevolvidosdesconto.AsCurrency := 0;
          qrycontratosDevolvidosValorDescontoItem.asCurrency := 0;
          qryContratosDevolvidosfrete.AsCurrency   := 0;
          qryContratosDevolvidosseguro.AsCurrency  := 0;

          if qryContratossituacao.asString = 'F' then
            qryContratosDevolvidossituacao.AsString := 'F'
          else
            qryContratosDevolvidossituacao.AsString := 'N';

          vFaltam:= (qryServicosContratosquantidade.AsCurrency -
                    qryServicosContratoscancelado.AsCurrency  -
                    qryServicosContratosdevolver.AsCurrency)  > 0;

          if not vFaltam then  //GARANTE O FECHAMENTO DOS VALORES NO CASO DE DEVOLUCAO TOTAL DO PRODUTO
          begin
            vImpostoRetidoDevolvido := 0;

            if not qryServicosContratosDevolvidos.IsEmpty then
            begin
              try
                GuardarRegistroAtual(qryServicosContratosDevolvidos,true);
                qryServicosContratosDevolvidos.First;
                while not qryServicosContratosDevolvidos.Eof do
                begin
                  if qryServicosContratosservico.Asinteger = qryServicosContratosDevolvidosservico.asinteger then
                  begin
                    vImpostoRetidoDevolvido := vImpostoRetidoDevolvido + qryServicosContratosDevolvidosimpostoretido.AsCurrency;
                  end;
                  qryServicosContratosDevolvidos.Next;
                end;
              finally
                VoltarRegistroAtual(qryServicosContratosDevolvidos);
              end;
            end;

            if qryServicosContratosimpostoretido.AsCurrency > 0 then
              qryContratosDevolvidosimpostoretido.AsCurrency   := Truncar(qryServicosContratosimpostoretido.AsCurrency - vImpostoRetidoDevolvido,2)
            else qryContratosDevolvidosimpostoretido.AsCurrency := 0;

          end
          else
          begin
            if qryServicosContratosimpostoretido.AsCurrency > 0 then
              qryContratosDevolvidosimpostoretido.AsCurrency    := truncar(RatearValores(qryServicosContratosimpostoretido.AsCurrency, qryServicosContratosquantidade.AsCurrency, vQtdeMov),2)
            else qryContratosDevolvidosimpostoretido.AsCurrency := 0;
          end;

          vValorMov := (qryServicosContratosvalorservico.AsCurrency * vQtdeMov) - qryContratosDevolvidosimpostoretido.AsCurrency;
          qryContratosDevolvidosvalorvista.AsCurrency    := Truncar(vvalorMov,2);
          qryContratosDevolvidosvalorprazo.AsCurrency    := Truncar(vvalorMov,2);

          qryContratosDevolvidos.Post;

          vValorPrazo := vValorPrazo + qryContratosDevolvidosvalorprazo.AsCurrency;
        end;
      end;
      qryServicosContratos.Next;
    end;

  finally
    qryServicosContratos.GotoBookmark(vPos);
    qryServicosContratos.FreeBookmark(vPos);
    qryServicosContratos.EnableControls;
  end;


  if DevolveCreditoTroca <> 0 then
  begin
    vSaldo := DevolveCreditoTroca;

    qryContratosDevolvidos.First;
    while (vSaldo <> 0) and not qryContratosDevolvidos.eof do
    begin
      if qryContratosDevolvidosvalorprazo.AsCurrency > vSaldo then
      begin
        qrycontratosdevolvidos.edit;
        qryContratosDevolvidoscreditotroca.AsCurrency := vSaldo;
        vSaldo := 0;
        qrycontratosdevolvidos.post;
      end
      else
      begin
        qrycontratosdevolvidos.edit;
        qryContratosDevolvidoscreditotroca.AsCurrency := qryContratosDevolvidosvalorprazo.AsCurrency;
        vSaldo := vSaldo - qryContratosDevolvidosvalorprazo.AsCurrency;
        qrycontratosdevolvidos.post;
      end;
      qryContratosDevolvidos.next;
    end;
  end;

  ValidarTotaisContratosDevolvidos_TotaisContratos;

end;


procedure TdtmDevolucaoMercadorias.AtualizaValores;
var
  Pos, ContratosDevolvidos   : TBookmark;
  Faltam: Boolean;
  A     : Integer;
//  Dif,
  ValAcrescimo,
  ValDescto,
  ValDescontoItem,
  ValImpostoRetido,
  ValFrete,
  ValSeguro,
{  ValProduto,
  ValServico,}
  {Valor,}
  ValIPI,
  ValicmsSubst,

  DescontoDevolvido,
  DescontoItemDevolvido,
  vFreteDevolvido,
  SeguroDevolvido,
  AcrescimoDevolvido,
  CreditoTrocaDevolvido,
  IPIDevolvido,
  IcmsSubstituicaoDevolvido,
  ImpostoRetidoDevolvido, Saldo,
  vValoraDevolver
  {,
  ValorParcelaReal,
  SomaValorParcelaReal}: Currency;
begin
  FValorProdutos  := FOldValorProdutos;
  FValorServicos  := FOldValorServicos;
  FValorImpostoRetido := FOldValorImpostoRetido;
  FValorIPI := FOldValorIPI;
  Fvaloricmssubstituicao := FOldvaloricmssubstituicao;
  FValorVista     := FOldValorVista;
  FValorPrazo     := FOldValorPrazo;
  FValorDesconto  := FOldValorDesconto;
  FValorDescontoItem  := FOldValorDescontoItem;

  FValorSeguro    := FOldValorSeguro;
  FValorFrete     := FOldValorFrete;
  FValorAcrescimo := FOldValorPrazo - FOldValorVista;
  FValorCreditotroca := FOldValorCreditoTroca;

  ValAcrescimo    := 0;
  ValDescto       := 0;
  ValDescontoItem := 0;

  ValImpostoRetido := 0;
  ValIPI := 0;
  ValicmsSubst := 0;
  ValFrete        := 0;
  ValSeguro       := 0;
//  ValProduto      := 0;
//  ValServico      := 0;
  FDevolveProduto := 0;
  FDevolveServicos := 0;
  CreditoTrocaDevolvido := 0;


//  ValorParcelaReal:= 0;
//  SomaValorParcelaReal := 0;


  qryProdutosContratos.DisableControls;
  Pos:= qryProdutosContratos.GetBookmark;
  try
    NrSelecoes:= 0;
    qryProdutosContratos.First;
    for A:= 0 to qryProdutosContratos.RecordCount - 1 do
    begin
      if not qryProdutosContratosbrinde.AsBoolean and
             (qryProdutosContratoscancelado.AsCurrency < qryProdutosContratosquantidade.AsCurrency) then
      begin

        if (qryProdutosContratosdevolver.AsCurrency > 0) then
        begin
          Inc(NrSelecoes);
//          Valor := (qryProdutosContratosdevolver.AsCurrency * ProdutoseServicos[produtos][A].Devolver);
          Faltam:= (qryProdutosContratosquantidade.AsCurrency -
                    qryProdutosContratoscancelado.AsCurrency  -
                    qryProdutosContratosdevolver.AsCurrency)   > 0 ;

          if not Faltam then  //GARANTE O FECHAMENTO DOS VALORES NO CASO DE DEVOLUCAO TOTAL DO PRODUTO
          begin
            DescontoDevolvido := 0;
            DescontoItemDevolvido := 0;
            vFreteDevolvido    := 0;
            SeguroDevolvido   := 0;
            IPIDevolvido := 0;
            IcmsSubstituicaoDevolvido := 0;
            AcrescimoDevolvido:= 0;
{            CreditoTrocaDevolvido := 0;}

            if not qryProdutosContratosDevolvidos.IsEmpty then
            begin
              try
                ContratosDevolvidos := qryProdutosContratosDevolvidos.GetBookmark;
                qryProdutosContratosDevolvidos.disablecontrols;

                qryProdutosContratosDevolvidos.First;
                while not qryProdutosContratosDevolvidos.Eof do
                begin
                  if qryProdutosContratosproduto.AsString = qryProdutosContratosDevolvidosproduto.AsString then
                  begin
                    DescontoDevolvido := DescontoDevolvido + qryProdutosContratosDevolvidosdesconto.AsCurrency;
                    DescontoItemDevolvido := DescontoItemDevolvido + qryProdutosContratosDevolvidosvalordescontoitem.AsCurrency;
                    vFreteDevolvido    := vFreteDevolvido    + qryProdutosContratosDevolvidosfrete.AsCurrency;
                    SeguroDevolvido   := SeguroDevolvido   + qryProdutosContratosDevolvidosseguro.AsCurrency;
                    AcrescimoDevolvido:= AcrescimoDevolvido+ qryProdutosContratosDevolvidosacrescimo.AsCurrency;
                    CreditoTrocaDevolvido := CreditoTrocaDevolvido + qryProdutosContratosDevolvidoscreditotroca.AsCurrency;
                    IPIDevolvido := IPIDevolvido + qryProdutosContratosDevolvidosvaloripi.ascurrency;
                    IcmsSubstituicaoDevolvido := IcmsSubstituicaoDevolvido + qryProdutosContratosDevolvidosvaloricmssubstituicao.AsCurrency;
                  end;
                  qryProdutosContratosDevolvidos.Next;
                end;
              finally
                qryProdutosContratosDevolvidos.GotoBookmark(ContratosDevolvidos);
                qryProdutosContratosDevolvidos.FreeBookmark(ContratosDevolvidos);
                qryProdutosContratosDevolvidos.enablecontrols;
              end;
            end;

            ValAcrescimo := ValAcrescimo + qryProdutosContratosacrescimo.AsCurrency - AcrescimoDevolvido;
            ValDescto    := ValDescto + qryProdutosContratosdesconto.AsCurrency  - DescontoDevolvido;
            ValDescontoItem := ValDescontoItem + qryProdutosContratosvalordescontoitem.AsCurrency  - DescontoItemDevolvido;
            ValIPI := ValIPI + qryProdutosContratosvaloripi.AsCurrency - IPIDevolvido;
            ValicmsSubst := ValicmsSubst + qryProdutosContratosicmsvalorst.AsCurrency - IcmsSubstituicaoDevolvido;

            if DevolverFrete then
              ValFrete   := ValFrete     + qryProdutosContratosfrete.AsCurrency     - vFreteDevolvido;
            if DevolverSeguro then
              ValSeguro  := ValSeguro    + qryProdutosContratosseguro.AsCurrency    - SeguroDevolvido;
          end
          else
          begin
            ValAcrescimo := ValAcrescimo + Truncar(((qryProdutosContratosacrescimo.AsCurrency / qryProdutosContratosquantidade.AsCurrency) * qryProdutosContratosdevolver.AsCurrency),2);
            ValDescto := ValDescto + Truncar(((qryProdutosContratosdesconto.AsCurrency / qryProdutosContratosquantidade.AsCurrency) * qryProdutosContratosdevolver.AsCurrency),2);
            ValDescontoItem := ValDescontoItem + truncar((qryProdutosContratosvalordescontoitem.AsCurrency * qryProdutosContratosdevolver.AsCurrency / qryProdutosContratosquantidade.AsCurrency),2);

            ValIPI := ValIPI + truncar(((qryProdutosContratosvaloripi.AsCurrency / qryProdutosContratosquantidade.AsCurrency) * qryProdutosContratosdevolver.AsCurrency),2);
            ValicmsSubst := ValicmsSubst + Truncar(((qryProdutosContratosicmsvalorst.AsCurrency / qryProdutosContratosquantidade.AsCurrency) * qryProdutosContratosdevolver.AsCurrency),2);

            if DevolverFrete then
              ValFrete := ValFrete + Truncar(((qryProdutosContratosfrete.AsCurrency / qryProdutosContratosquantidade.AsCurrency) * qryProdutosContratosdevolver.AsCurrency),2);

            if DevolverSeguro then
               ValSeguro := ValSeguro + Truncar(((qryProdutosContratosseguro.AsCurrency / qryProdutosContratosquantidade.AsCurrency) * qryProdutosContratosdevolver.AsCurrency),2);

          end;

          {ProdutoseServicos[Produtos][A].ValorDescontoItem := (qryProdutosContratosvalordescontoitem.AsCurrency * qryProdutosContratosdevolver.AsCurrency / qryProdutosContratosquantidade.AsCurrency);}

//          if qryProdutosContratosdefeito.AsBoolean then
            {o preco de venda quando avariado pode ser alterado}
            vValoraDevolver := qryProdutosContratosprecovenda.AsCurrency * qryProdutosContratosdevolver.AsCurrency {- ValDescontoItem};
            {ProdutoseServicos[Produtos][A].Devolver := qryProdutosContratosprecovenda.AsCurrency * qryProdutosContratosdevolver.AsCurrency - ProdutoseServicos[Produtos][A].ValorDescontoItem}
//          else
//            ProdutoseServicos[Produtos][A].Devolver := ProdutoseServicos[Produtos][A].Preco * qryProdutosContratosdevolver.AsCurrency - ProdutoseServicos[Produtos][A].ValorDescontoItem;
        end
        else
          vValoraDevolver := 0;
//          ProdutoseServicos[Produtos][A].Devolver := 0;

{        FDevolveProduto:= FDevolveProduto + ProdutoseServicos[Produtos][A].Devolver;}
         FDevolveProduto:= FDevolveProduto + vValoraDevolver;

      end;
      qryProdutosContratos.Next;
    end;
    FDevolveProduto:= FDevolveProduto - ValDescontoItem;
    FValorProdutos:= FOldValorProdutos - FDevolveProduto;
  finally
    qryProdutosContratos.GotoBookmark(Pos);
    qryProdutosContratos.FreeBookmark(Pos);
    qryProdutosContratos.EnableControls;
  end;

  qryServicosContratos.DisableControls;
  Pos:= qryServicosContratos.GetBookmark;
  try
    //NrSelecoes:= 0;
    qryServicosContratos.First;
    for A:= 0 to qryServicosContratos.RecordCount - 1 do begin
      if (qryServicosContratoscancelado.AsCurrency < qryServicosContratosquantidade.AsCurrency) then
      begin
        if (qryServicosContratosdevolver.AsCurrency > 0) then
        begin
          Inc(NrSelecoes);
//          Valor := (qryServicosContratosdevolver.AsCurrency * ProdutoseServicos[Servicos][A].Preco);
          Faltam:= (qryServicosContratosquantidade.AsCurrency -
                    qryServicosContratoscancelado.AsCurrency  -
                    qryServicosContratosdevolver.AsCurrency)   > 0 ;

          if not Faltam then  //GARANTE O FECHAMENTO DOS VALORES NO CASO DE DEVOLUCAO TOTAL DO PRODUTO
          begin

            {CreditoTrocaDevolvido := 0;}
            ImpostoRetidoDevolvido := 0;

            if not qryServicosContratosDevolvidos.IsEmpty then
            begin
              try
                ContratosDevolvidos := qryServicosContratosDevolvidos.GetBookmark;
                qryServicosContratosDevolvidos.disablecontrols;

                qryServicosContratosDevolvidos.First;
                while not qryServicosContratosDevolvidos.Eof do
                begin
                  if qryServicosContratosservico.AsString = qryServicosContratosDevolvidosservico.AsString then
                  begin
                    CreditoTrocaDevolvido := CreditoTrocaDevolvido + qryServicosContratosDevolvidoscreditotroca.AsCurrency;
                    ImpostoRetidoDevolvido := ImpostoRetidoDevolvido + qryServicosContratosDevolvidosimpostoretido.asCurrency;
                  end;
                  qryServicosContratosDevolvidos.Next;
                end;
              finally
                qryServicosContratosDevolvidos.GotoBookmark(ContratosDevolvidos);
                qryServicosContratosDevolvidos.FreeBookmark(ContratosDevolvidos);
                qryServicosContratosDevolvidos.enablecontrols;
              end;
            end;
            ValImpostoRetido := ValImpostoRetido  + qryServicosContratosimpostoretido.AsCurrency  - ImpostoRetidoDevolvido;
          end
          else
            ValImpostoRetido := ValImpostoRetido + ((qryServicosContratosimpostoretido.AsCurrency / qryServicosContratosquantidade.AsCurrency) * qryServicosContratosdevolver.AsCurrency);

//          Devolver[Servicos][A]:= Precos[Servicos][A] * qryServicosContratosdevolver.AsCurrency;

//          produtoseServicos[Servicos][A].ImpostoRetido := (qryServicosContratosimpostoretido.AsCurrency * qryServicosContratosdevolver.AsCurrency / qryServicosContratosquantidade.AsCurrency);
//          produtoseServicos[Servicos][A].Devolver := ProdutoseServicos[Servicos][A].Preco * qryServicosContratosdevolver.AsCurrency {- produtoseServicos[Servicos][A].ImpostoRetido};
          vValoraDevolver := qryServicosContratosvalorservico.AsCurrency * qryServicosContratosdevolver.AsCurrency;

        end
        else
          vValoraDevolver := 0;
//          produtoseServicos[Servicos][A].Devolver := 0;

//        FDevolveServicos:= FDevolveServicos + ProdutoseServicos[Servicos][A].Devolver;
          FDevolveServicos:= FDevolveServicos + vValoraDevolver;
      end;
      qryServicosContratos.Next;
    end;
    FValorServicos:= FOldValorServicos - FDevolveServicos;
  finally
    qryServicosContratos.GotoBookmark(Pos);
    qryServicosContratos.FreeBookmark(Pos);
    qryServicosContratos.EnableControls;
  end;

  if NrSelecoes > 0 then
  begin

  {
    for A:= 0 to Length(ProdutoseServicos[Produtos])-1 do
    begin
      if (ProdutoseServicos[Produtos][A].devolver > 0) then
        ValProduto := ValProduto + ProdutoseServicos[Produtos][A].devolver;
    end;

    for A:= 0 to Length(ProdutoseServicos[Servicos])-1 do
    begin
      if (ProdutoseServicos[Servicos][A].devolver > 0) then
        ValServico := ValServico + ProdutoseServicos[Servicos][A].devolver;
    end;
  }  

    if ValAcrescimo > FValorAcrescimo then
      ValAcrescimo := FValorAcrescimo;
    FValorAcrescimo := FValorAcrescimo - ValAcrescimo;

    if ValDescto > FValorDesconto then
      ValDescto:= FValorDesconto;
    FValorDesconto:= FValorDesconto - ValDescto;
    if FValorDesconto < 0 then
      FValorDesconto:= 0;

    if ValDescontoItem > FValorDescontoItem then
      ValDescontoItem:= FValorDescontoItem;
    FValorDescontoItem:= FValorDescontoItem - ValDescontoItem;
    if FValorDescontoItem < 0 then
      FValorDescontoItem:= 0;

    if ValFrete > FValorFrete then
      ValFrete:= FValorFrete;
    FValorFrete := FValorFrete - ValFrete;
    if FValorFrete < 0 then
      FValorFrete:= 0;

    if ValSeguro > FValorSeguro then
      ValSeguro:= FValorSeguro;
    FValorSeguro := FValorSeguro - ValSeguro;
    if FValorSeguro < 0 then
      FValorSeguro:= 0;

    if ValImpostoRetido > FValorImpostoRetido then
      ValImpostoRetido := FValorImpostoRetido;
    FValorImpostoRetido := FValorImpostoRetido - ValImpostoRetido;
    if FValorImpostoRetido < 0 then
      FValorImpostoRetido := 0;

    if ValIPI > FValorIPI then
      ValIPI:= FValorIPI;
    FValorIPI := FValorIPI - ValIPI;
    if FValorIPI < 0 then
      FValorIPI:= 0;

    if ValicmsSubst > Fvaloricmssubstituicao then
      ValicmsSubst := Fvaloricmssubstituicao;
    Fvaloricmssubstituicao := Fvaloricmssubstituicao - ValicmsSubst;
    if Fvaloricmssubstituicao < 0 then
      Fvaloricmssubstituicao:= 0;


    FValorCreditoTroca := FValorCreditoTroca - CreditoTrocaDevolvido;

    FValorVista := FValorVista - (FDevolveProduto + FDevolveServicos + ValFrete + ValSeguro + ValIPI + ValicmsSubst - ValDescto - ValImpostoRetido );
    FValorPrazo := FValorPrazo - (FDevolveProduto + FDevolveServicos + ValFrete + ValSeguro + ValIPI + ValicmsSubst - ValDescto - ValImpostoRetido + ValAcrescimo);

    if FValorVista < 0 then
      FValorVista := 0;

    Saldo := fOldvalorprazo - fValorprazo;
    fValorAberto := fOldValorPrazo - fPagoVencto - PagoCreditoTroca;

    {A situação abaixo dá-se pela troca antes de uma devolução}
    if fValorAberto < 0 then
      fValorAberto := 0;

    DevolveCreditoTroca := 0;
    DevolveemAberto := 0;
    fDevolvePagto := 0;

    //Primeiro: Abater dos valores em aberto;
    if Saldo <>  0 then
    begin
      if FValorAberto <> 0 then
      begin
        if Saldo >= FValorAberto then
        begin
          DevolveemAberto := FValorAberto;
          Saldo := Saldo - DevolveemAberto;
          FValorAberto := 0;
        end
        else
        begin
          DevolveemAberto := Saldo;
          Saldo := 0;
          FValorAberto := FValorAberto - DevolveemAberto;
        end;
      end;
    end;

    //Segundo: Abater dos valores de creédito de troca ;
    if Saldo <> 0 then
    begin
      if FValorCreditoTroca <> 0 then
      begin
        if Saldo >= FValorCreditoTroca then
        begin
          DevolveCreditoTroca := FValorCreditoTroca;
          Saldo := Saldo - DevolveCreditoTroca;
          FValorCreditoTroca := 0;
        end
        else
        begin
          DevolveCreditoTroca := Saldo;
          Saldo := 0;
          FValorCreditoTroca := FValorCreditoTroca - DevolveCreditoTroca;
        end;
      end;
    end;

    //Terceiro: Devolver o que foi pago ;
    if Saldo <> 0 then
    begin
      if fPagoVencto <> 0 then
      begin
        if Saldo >= fPagoVencto then
        begin
          Saldo := Saldo - fPagoVencto;
          fDevolvePagto := fPagoVencto;
        end
        else
        begin
          FDevolvePagto := Saldo;
          Saldo := 0;
        end;
      end;
    end;

    (*
    if (fValorPrazo > (fPagoVencto + PagoCreditoTroca)) then
    begin
      fValorAberto := fValorPrazo - fPagoVencto - PagoCreditoTroca;
      DevolveCreditoTroca := 0;
      fDevolvePagto := 0;
    end
    else if (fValorPrazo <= (fPagoVencto + PagoCreditoTroca)) then
    begin
      DevolveCreditoTroca := (fValorPrazo + fpagoVencto) -  PagoCreditoTroca;
      if DevolveCreditoTroca < 0 then
        DevolveCreditoTroca := FValorCreditoTroca;

      FValorCreditoTroca := FValorCreditoTroca - DevolveCreditoTroca;

      if (ValProduto + ValFrete + ValSeguro - ValDescto  +  ValAcrescimo) >  (fValorAberto + DevolveCreditoTroca) then
        fDevolvePagto := fPagoVencto - ((ValProduto + ValFrete + ValSeguro - ValDescto  +  ValAcrescimo) -  (fValorAberto + DevolveCreditoTroca));
      fValorAberto := 0;
    end;
    {
    else
    begin
      fValorAberto := 0;
      fDevolvePagto := 0;
      DevolveCreditoTroca := 0;
    end;
    }
    *)

    ReFazConsulta(qryParcelasContratos,  [0],[qryContratosnumero.AsString]);
  end
  else
  begin

    {
    try
      qryProdutosContratos.First;
      for A:= 0 to (qryProdutosContratos.RecordCount -1) do begin
        ProdutoseServicos[Produtos][A].devolver:= 0;
        qryProdutosContratos.Next;
      end;
      qryProdutosContratos.First;
    except
    end;

    try
      qryServicosContratos.First;
      for A:= 0 to (qryServicosContratos.RecordCount -1) do begin
        ProdutoseServicos[Servicos][A].devolver:= 0;
        qryServicosContratos.Next;
      end;
      qryServicosContratos.First;
    except
    end;
    }

    ReFazConsulta(qryParcelasContratos,[0],[qryContratosnumero.AsString]);
    FValorAberto:= 0;
    for a:= 0 to Length(NewParcelas)-1 do begin
      if NewParcelas[A].DataPagto = 0 then
        FValorAberto:= FValorAberto + NewParcelas[A].ValorVencto;
    end;
    FDevolveReal  := 0;
    FDevolvePagto:= 0;

  end;

  if Assigned(fExibirNovosValores) then
    fExibirNovosValores(Self);


end;

procedure TdtmDevolucaoMercadorias.CalcularNovasParcelas(Devolvido: Currency);
Var
  I,NrVezes : Integer;
  Dif,
  DesctoAtual,
  DesctoUltimo,
  ValorPresente,
  TotalContrato : Currency;
  Prest: Currency;
begin
  if (FValorVista <> 0) then begin
    DesctoAtual := 999999.99;
    ReFazConsulta(qryParcelasContratos,  [0],[qryContratosnumero.AsString]);
    ReFazConsulta(qryPlanosPagamento,[0],[qryContratosplano.AsInteger]);
    repeat
      NrVezes:= 0;
      DesctoUltimo:= Abs(DesctoAtual*100);
      qryParcelasContratos.DisableControls;
      try
        qryParcelasContratos.First;
        ValorPresente := 0;     TotalContrato := 0;
        for I:= 1 to qryParcelasContratos.RecordCount do begin
          if (qryParcelasContratosdatapagto.AsDateTime = 0) then begin
            Inc(NrVezes);
            TotalContrato:= TotalContrato + qryParcelasContratosvalorvencto.AsCurrency;
            ValorPresente:=  (ValorPresente + qryParcelasContratosvalorvencto.AsCurrency /
                                                    Power(tecFinanceira.TaxaDiaria(qryContratostaxajuros.AsCurrency),
                                                    DaysBetween(qryParcelasContratosdatavencto.AsDateTime,qryContratosfaturamento.AsDateTime)));
          end;
          qryParcelasContratos.Next;
        end;
      finally
        qryParcelasContratos.EnableControls;
      end;

      DesctoAtual:= (FValorVista {+ FValorFrete + FValorSeguro} + FDevolveReal) - ValorPresente;

      if (Abs(DesctoAtual*100) > qryPlanosPagamentoquantidadeparcelas.AsInteger) and (Abs(DesctoAtual*100) < DesctoUltimo) then begin
        FValorAberto:= 0;
        qryParcelasContratos.DisableControls;
        try
          qryParcelasContratos.First;
          for I:= 1 to qryParcelasContratos.RecordCount do begin
            if qryParcelasContratosdatapagto.AsDateTime = 0 then begin
              qryParcelasContratos.Edit;
              if TotalContrato <> 0 then
                   Prest:= ( ((DesctoAtual / TotalContrato)) * qryParcelasContratosvalorvencto.AsCurrency) +
                                                                    qryParcelasContratosvalorvencto.AsCurrency
              else Prest:= (qryParcelasContratosvalorvencto.AsCurrency +  ((DesctoAtual / NrVezes)));
              qryParcelasContratosvalorvencto.AsCurrency:= Truncar(Prest,2);
              FValorAberto:= FValorAberto + qryParcelasContratosvalorvencto.AsCurrency;
              qryParcelasContratos.Post;
            end;
            qryParcelasContratos.Next;
          end;
        finally
          qryParcelasContratos.EnableControls;
        end;
      end;
    until (Abs(DesctoAtual*100) <= qryPlanosPagamentoquantidadeparcelas.AsInteger) or (Abs(DesctoAtual*100) >= DesctoUltimo);

    if (qryPlanosPagamentotaxamensaljuros.AsFloat = 0) and ((FValorVista - FValorAberto) <> 0) then begin
      try
        qryParcelasContratos.First;
        while not qryParcelasContratos.Eof do begin
          if qryParcelasContratosDataPagto.AsDateTime = 0 then begin
            qryParcelasContratos.Edit;
            qryParcelasContratosValorVencto.AsCurrency :=  qryParcelasContratosValorVencto.AsCurrency +
                                                           (FValorVista - FValorAberto);
            qryParcelasContratos.Post;
            break;
          end;
          qryParcelasContratos.Next
        end;
      finally
        qryParcelasContratos.EnableControls;
        FValorAberto:= FValorVista;
      end;
    end;

    if ((qryContratosvalorprodutos.AsCurrency - qryContratosvalorprazo.AsCurrency) = 0) then begin
      Dif:= qryContratosvalorprodutos.AsCurrency - (Devolvido + FValorAberto + FPagoVencto);
      if Dif <> 0 then begin
        qryParcelasContratos.First;
        while not qryParcelasContratos.Eof do begin
          if qryParcelasContratosdatapagto.AsDateTime = 0 then begin
            qryParcelasContratos.Edit;
            qryParcelasContratosValorVencto.AsCurrency :=  qryParcelasContratosValorVencto.AsCurrency + Dif;
            qryParcelasContratos.Post;
            FValorAberto:= FValorAberto + Dif;
            Break;
          end;
          qryParcelasContratos.Next
        end;
      end;
    end;
  end;
end;

function TdtmDevolucaoMercadorias.EmitirNFe(Validando: Boolean = False): Boolean;
var
  LoteNFe, ReciboNFe, ProtocoloNFe, status, DataHoraProcessamento: String;
//  NFe: TTecNotaFiscalEletronica;
begin
  Result := False;
  if not validando then
    NFe := TTecNotaFiscalEletronica.Create
  else
    NFe := TTecNotaFiscalEletronica.Create(dtmTecSoft.Database);
                                       {
  NFe.DiretorioEnvio       := NFeDirEnvio;
  NFe.DiretorioEnviado     := NFeDirEnviados;
  NFe.DiretorioRetorno     := NFeDirRetorno;
  NFe.DiretorioCompartilha := NfeDirCompartilha;

  NFe.Executavel           := NFeExecNFe;
  }
  try
    if not Validando then
    begin
      ShowProcessando('Gerando o arquivo da NF-e!');
      Sleep(500);
    end;

    // EMITENTE
    NFe.Emit_Documento := CNPJFilialBase;
    NFe.Emit_Nome      := RazaoFilialBase;
    NFe.Emit_Rua       := RuaSemNumeroFilialBase;
    NFe.Emit_Nro       := NumeroFilialBase;
    NFe.Emit_Compl     := ComplementoFilialBase;
    NFe.Emit_Bairro    := BairroFilialBase;
    NFe.Emit_CodMun    := CodigoCidadeIBGEFilialBase;
    NFe.Emit_Mun       := CidadeFilialBase;
    NFe.Emit_UF        := EstadoFilialBase;
    NFe.Emit_CEP       := CEPFilialBase;
    NFe.Emit_Fone      := DDDFilialBase+FoneFilialBase;
    NFe.Emit_IE        := InscricaoEstadualFilialBase;
    NFe.Emit_IM        := InscricaoMunicipalFilialBase;
    NFe.Emit_CNAE      := CNAEFiscalFilialBase;
    NFe.Emit_CRT       := qryNotasPagregimetributario.AsInteger;

    // DESTINATARIO
    NFe.Dest_TipoPessoa := qryNotasPagpessoatipo.AsString;
    NFe.Dest_Documento := qryNotasPagcnpj.AsString;
    NFe.Dest_Nome      := qryNotasPagnome.AsString;
    NFe.Dest_Rua       := qryNotasPagrua.AsString;
    NFe.Dest_Nro       := qryNotasPagendnumero.AsString;
    NFe.Dest_Compl     := qryNotasPagendcomplemento.AsString;
    NFe.Dest_Bairro    := qryNotasPagnomebairro.AsString;
    NFe.Dest_CodMun    := qryNotasPagcidadeibge.AsString;
    NFe.Dest_Mun       := qryNotasPagnomecidade.AsString;
    NFe.Dest_UF        := qryNotasPagestado.AsString;
    NFe.Dest_CEP       := qryNotasPagcep.AsString;
    NFe.Dest_CodPais   := qryNotasPagpais.AsInteger;
    NFe.Dest_Pais      := qryNotasPagnomepais.AsString;

    if (qryNotasPagfoneddd.AsString<>'') and (qryNotasPagfonenumero.AsString<>'') then
      NFe.Dest_Fone      := qryNotasPagfoneddd.AsString+qryNotasPagfonenumero.AsString
    else
      NFe.Dest_Fone      := '';


    NFe.Dest_IE        := qryNotasPaginscricaoestadual.AsString;
    NFe.Dest_ISUF      := qryNotasPagiesubsttributario.AsString;

    NFe.Validando      := Validando;

    RefazConsultaPorNome(qryDadosFiscaisRef,['ListaDadosFiscais'], [RetornarLista(qryProdutosnotaspag, qryprodutosnotaspagdadofiscal)]);


    Result := NFe.GerarNFe(qryNotasPag, qryDadosFiscaisRef, qryProdutosNotasPag,nil,nil,
                   nil,nil,nil,nil,nil,SerieSugestao,'E');

    if Result and not Validando then
    begin
      if NFeTipoEmissao in [1,3] then
      begin
        ShowProcessando;
        ShowProcessando('Verificando status do serviço NF-e!');
        Sleep(500);
        if NFe.VerificarStatusServico(IntToStr(NFeAmbiente)) then
        begin
          ShowProcessando;
          ShowProcessando('Processando o arquivo de envio da NF-e!');
          Sleep(500);
          Result := NFe.EnviarNFe(qryNotasPagchv_nfe.AsString, LoteNFe, ReciboNFe);
          if Result then
          begin
            qryNotasPag.Edit;
            qryNotasPagnumlotenfe.AsString   := LoteNFe;
            qryNotasPagnumrecibonfe.AsString := ReciboNFe;
            qryNotasPag.Post;
            Result := Perpetrar([qryNotasPag]);
            if Result then
            begin
              ShowProcessando;
              ShowProcessando('Consultando o arquivo de retorno da NF-e!');
              Sleep(500);
              Result := NFe.ConsultarSituacaoLote(ReciboNFe, ProtocoloNFe, status, DataHoraProcessamento, IntToStr(NFeAmbiente));
            end;
            if Result then
            begin
              qryNotasPag.Edit;
              qryNotasPagnumprotocolonfe.AsString := ProtocoloNFe;
              qryNotasPagstatusnfe.AsString := status;
              qryNotasPagdhprocnfe.AsDateTime :=  FormatarTimeStamp(DataHoraProcessamento);
              qryNotasPag.Post;


              if (qryNotasPagstatusnfe.AsString = '301') or
                 (qryNotasPagstatusnfe.AsString = '302') then
              begin
                qryNotasPag.Edit;
                qryNotasPagsituacao.AsString := 'D';
                qryNotasPag.Post;
//                EliminarMovimentos;
//                LimparTabela(qryDuplicatas);
//                Result := Perpetrar([qryNotaFiscal, qryDuplicatas, qryMovimentos]);
                Result := Perpetrar([qryNotasPag]);
              end
              else
              begin
                Result := Perpetrar([qryNotasPag]);

                if Result then
                begin
                  ShowProcessando;
                  ShowProcessando('Gerando o arquivo de compartilhamento da NF-e!');
                  Sleep(500);
                  Result := NFe.CompartilharXML(qryNotasPagchv_nfe.AsString,
                                                ReciboNFe, qryNotasPagfilial.AsString,
                                                SerieSugestao, qryNotasPagnrdocumento.AsString,
                                                qryNotasPagemissao.AsDateTime);
                  if Result then
                  begin
                    SalvarConteudoxml('E', qryNotasPagcodigo.asString);
                    ShowProcessando;
                    ShowProcessando('Imprimindo o DANFE!');
                    try
                      NFe.ImprimirDanfe({ChaveAcesso+qryNotaFiscaldigchaveacesso.AsString,}
                                        qryNotasPagfilial.AsString,
                                        qryNotasPagserie.AsString,
                                        qryNotasPagnrdocumento.AsString,
                                        qryNotasPaglocalentrega_cep.AsString,
                                        '',
                                        IntToStr(NFeNVias), NFeLogotipoDANFE,
                                        ParSistema.NomeImpressoraNotaMercadorias, NFeVisualizarDANFE,
                                        qryNotasPagemissao.AsDateTime,
                                        qryProdutosNotasPag,
                                        NFeExecDANFE, Enviar, 'E');


                      ShowProcessando;

                      if (qryClientesemail.AsString <> '')      and
                         (UsuarioLogin.PortaSmtp        <> '')      and
                         (UsuarioLogin.HostSmtp         <> '')      and
                         (UsuarioLogin.Email            <> '')      and
                         (UsuarioLogin.SenhaEmail       <> '')      and
                         EmailValido(qryClientesemail.AsString, false) then
                      begin
                        ShowProcessando('Enviando email para o cliente');
                        try
                          if not NFe.EnviarEmail(UsuarioLogin.Email,qryClientesemail.AsString,
                                              qryNotasPagnrdocumento.AsString, qryNotasPagserie.AsString, IntToStr(fFilialBase),'',

                                              fNomeFilialBase, fRazaoFilialBase, fCNPJFilialBase, fDDDFilialBase, fFoneFilialBase,
                                              fDDDFaxFilialBase, fFaxFilialBase, UsuarioLogin.NomeUsuario, UsuarioLogin.PortaSMTP,
                                              UsuarioLogin.HostSMTP, UsuarioLogin.UsuarioEmail, UsuarioLogin.SenhaEmail,
                                              qryNotasPagemissao.AsDateTime, qryNotasPagvalornota.AsCurrency,
                                              UsuarioLogin.AutenticarSMTP, qryNotasPagemissao.AsDateTime) then
                                MensagemAviso('Ocorreu um erro inesperado no envio do email')
                        finally
                              ShowProcessando;
                        end;
                      end;

                    finally
                      ShowProcessando;
                    end;
                  end
                  else
                    ShowProcessando;
                end;
              end;
            end
            else
              ShowProcessando;
          end
          else
            ShowProcessando;
        end
        else
          ShowProcessando;
      end
      else
      begin
        if not NFeVisualizarDANFE then
          MensagemAviso('Impressão da Nota Fiscal será iniciada.');
        NFe.ImprimirDanfe({ChaveAcesso+qryNotaFiscaldigchaveacesso.AsString,}
                          qryNotasPagfilial.AsString,
                          qryNotasPagserie.AsString,
                          qryNotasPagnrdocumento.AsString,
                          qryNotasPaglocalentrega_cep.AsString,
                          '',
                          IntToStr(NFeNVias), NFeLogotipoDANFE,
                          ParSistema.NomeImpressoraNotaMercadorias, NFeVisualizarDANFE,
                          qryNotasPagemissao.AsDateTime,qryProdutosNotasPag,
                          NFeExecDANFE, Enviar, 'E');
      end;
    end;
  finally
    FreeAndNil(NFe);
  end;
end;

procedure TdtmDevolucaoMercadorias.DevolverTodosProdutos(Zerar: Boolean);
var
{ Entregar: Currency;}
  RegistroAtual : TBookMark;
begin
  try
    RegistroAtual := qryprodutoscontratos.GetBookmark;
//    qryprodutoscontratos.DisableControls;
    qryProdutosContratos.First;
    while not qryProdutosContratos.Eof do
    begin
      qryProdutosContratos.Edit;
      if Zerar then
        qryProdutosContratosdevolver.AsCurrency := 0
      else
        qryProdutosContratosdevolver.AsCurrency := qryProdutosContratosquantidade.AsCurrency - qryProdutosContratoscancelado.AsCurrency;
{
{      Entregar := qryProdutosContratosquantidade.AsCurrency -
                  qryProdutosContratoscancelado.AsCurrency  -
                  qryProdutosContratosqtdeentregue.AsCurrency;

      if qryProdutosContratosdevolver.AsCurrency > Entregar then
        qryProdutosContratosqtdeentregueparadevolver.AsCurrency := qryProdutosContratosdevolver.AsCurrency - Entregar
      else
        qryProdutosContratosqtdeentregueparadevolver.AsCurrency := 0;

      qryProdutosContratos.Post;
}
      qryProdutosContratos.Next;
    end;
  finally
//    qryprodutoscontratos.EnableControls;
    qryprodutoscontratos.GotoBookmark(RegistroAtual);
    qryprodutoscontratos.FreeBookmark(RegistroAtual);
  end;
end;

procedure TdtmDevolucaoMercadorias.CalcularPrestacoesReais;
var
{  ValorBase: Currency;}
  NP: Integer;
begin
  FPagoVencto    := 0;
  PagoCreditoTroca := 0;

  if (qryParcelasContratos.RecordCount > 0) then begin
{    ValorBase:= 0;}
    qryParcelasContratos.DisableControls;
    try
      qryParcelasContratos.First;
      for NP:= 1 to qryParcelasContratos.RecordCount do
      begin
        if (qryParcelasContratosdatapagto.AsCurrency <> 0) then
          if ((qryParcelasContratostipopagto.AsString = '') or
              (qryParcelasContratostipopagto.AsString = 'B')) then
          begin
            if (qryParcelasContratosformapagamento.AsString<>'T') then
              FPagoVencto:= FPagoVencto + qryParcelasContratosvalorvencto.AsCurrency
            else
              PagoCreditoTroca:= PagoCreditoTroca + qryParcelasContratosvalorvencto.AsCurrency
          end;
        qryParcelasContratos.Next;
      end;
    finally
      qryParcelasContratos.EnableControls;
    end;
    AtualizaValores;
  end;
end;

procedure TdtmDevolucaoMercadorias.ConsultarDadosFiscais;
begin

  dsrDadosFiscais.OnDataChange:= Nil;
  if qryDadosFiscais.Active then
    qryDadosFiscais.Close;
  qryDadosFiscais.macrobyname('FiltroNotas').AsString  := '';
  qryDadosFiscais.MacroByName('FiltroCupons').asstring := '';
  qryDadosFiscais.Parambyname('produto').AsString := qryProdutosContratosproduto.AsString;
  qryDadosFiscais.Parambyname('filial').AsInteger := qryProdutosContratosfilial.AsInteger;

  if qryContratosprimogenito.AsString <> '' then
    qryDadosFiscais.Parambyname('contrato').AsString:= qryContratosprimogenito.AsString
  else qryDadosFiscais.Parambyname('contrato').AsString:= qryContratosnumero.AsString;

  qryDadosFiscais.Open;

  if (qryDadosFiscais.RecordCount = 1) then
  begin
    if ((qryDadosFiscaistipo.asString = 'Notas') or
        (qryDadosFiscaistipo.asString = 'Cupons')) then
    begin
      if DadosFiscaisOK and (qryDadosFiscaisdevolver.AsCurrency <> qryProdutosContratosqtdeentregueparadevolver.AsCurrency) then
      begin
        qryDadosFiscais.Edit;
        qryDadosFiscaisdevolver.AsCurrency := qryProdutosContratosqtdeentregueparadevolver.AsCurrency;
        qryDadosFiscais.Post;
      end
    end
    else
    if (qryDadosFiscaistipo.asString = 'Lotes') and (qryDadosFiscaisdevolver.AsCurrency <> qryProdutosContratosdevolver.AsCurrency) then
    begin
      qryDadosFiscais.Edit;
      qryDadosFiscaisdevolver.AsCurrency := qryProdutosContratosdevolver.AsCurrency;
      qryDadosFiscais.Post;
    end;
  end;

  dsrDadosFiscais.OnDataChange:= dsrDadosFiscaisDataChange;
end;


{
procedure TdtmDevolucaoMercadorias.CalcularDadosFiscais;
 var
   DadoFiscal : integer;
begin
  dsrCalculosNotasPag.OnDataChange:= nil;
  if ClienteTrouxeNota then
    DadoFiscal := StrToInt(NumeroDevolucao)
  else
    DadoFiscal := 0;

  InserindoCalculos:= True;
  dtmGerarNotaFiscal.CalcularDadosFiscais(nfDEVOLUCAO,
                                        DadoFiscal,
                                        qryNotasPagcodigofiscal.AsInteger,
                                        qryNotasPagfreteinterno.AsCurrency, 0.00, DevolverFrete,
                                        qryNotasPagseguro.AsCurrency, 0.00, DevolverSeguro,
                                        0.00,
                                        qryNotasPagdesconto.AsCurrency,
                                        qryNotasPagacrescimo.AsCurrency,
                                        qryNotasPagvalornota.AsCurrency,
                                        qryNotasPagtotalprodutos.AsCurrency,
                                        qryProdutosNotasPag,
                                        nil,
                                        nil,
                                        false,
                                        false,
                                        CreditarICMS,
                                        qryNotasPagestado.AsString,
                                        '',0.00,True,False,qryNotasPagcodigonatureza.AsInteger);


  ReCalcularValoresCalculosFiscais;
  dsrCalculosNotasPag.OnDataChange:= dsrCalculosNotasPagDataChange;

  InserindoCalculos:= False;
end;

}

{
procedure TdtmDevolucaoMercadorias.PreencherCalculosNotaFiscal(TipoNota: TtecTipoNota);
var
  Impostos: array of record
    aliquota,
    base,
    icms,
    isentos,
    outros: Currency
  end;
  Total,
  RateioDesconto,
  RateioFrete,
  RateioSeguro,
  RateioAcrescimo,
  Acrescimo,
  PrecoItem, DescontoItem : Currency;
  Pos, QtdadeAliquotas: Integer;

  // Verifica a existencia da aliquota.
  function ProcuraAliquota(aliquota: Real): Integer;
  var
    a: Integer;
  begin
    Result := -1;
    for a := 0 to Length(Impostos) - 1 do
      if Impostos[a].aliquota = aliquota then begin
        Result := a;
        break;
      end
  end;

begin
  Total           := 0;
  QtdadeAliquotas := 0;
  try
//    qryProdutosContratos.DisableControls;
    qryProdutosNotasPag.First;
    while not qryProdutosNotasPag.Eof do begin
//      if qryProdutosContratosqtdeentregueparadevolver.AsInteger > 0 then begin
//      if qryCalculosNotasPagcodigonota.AsInteger = TipoNota then begin
        if CreditarICMS then
             Pos:= ProcuraAliquota(qryProdutosNotasPagaliquotaicms.AsFloat)
        else Pos:= ProcuraAliquota(0);
        if Pos = -1 then begin
          Pos := QtdadeAliquotas;
          Inc(QtdadeAliquotas);
          SetLength(Impostos, QtdadeAliquotas);
          if CreditarICMS then
               Impostos[Pos].aliquota := qryProdutosNotasPagaliquotaicms.AsFloat
          else Impostos[Pos].aliquota := 0;
        end;

        DescontoItem := 0;
        if (qryNotasPagdesconto.AsCurrency <> 0) then
          DescontoItem :=  (((qryProdutosNotasPagprecounitario.AsCurrency *
                             qryProdutosNotasPagquantidade.AsCurrency)
                           / qryNotasPagvalorprodutos.AsCurrency)
                            * qryNotasPagdesconto.AsCurrency);

        PrecoItem := (qryProdutosNotasPagprecounitario.AsCurrency *
                      qryProdutosNotasPagquantidade.AsCurrency)
                      - DescontoItem;

        if (qryProdutosNotasPagincidencia.AsString = ctTRIBUTADASUBSTITUICAO) or
           (qryProdutosNotasPagincidencia.AsString = ctCOBRADOSUSTITUICAO)
        then
          Impostos[Pos].outros := Impostos[Pos].outros + PrecoItem
        else if qryProdutosNotasPagincidencia.AsString = ctREDUCAOBASE then begin
          if (Impostos[Pos].aliquota > 0) and CreditarICMS then begin
            Impostos[Pos].base    := Impostos[Pos].base + PrecoItem
                                     - qryProdutosNotasPagvalorreducaobase.AsCurrency;
            Impostos[Pos].isentos := Impostos[Pos].isentos
                                     + qryProdutosNotasPagvalorreducaobase.AsCurrency;
          end
          else
            Impostos[Pos].isentos := Impostos[Pos].isentos + PrecoItem;
        end else if (qryProdutosNotasPagincidencia.AsString = ctISENTASUBSTITUICAO) or
                    (qryProdutosNotasPagincidencia.AsString = ctISENTA) or
                    (qryProdutosNotasPagincidencia.AsString = ctNAOTRIBUTADA) or
                    (qryProdutosNotasPagincidencia.AsString = ctSUSPENSAO) or
                    (qryProdutosNotasPagincidencia.AsString = ctDIFERIMENTO)
        then
          Impostos[Pos].isentos := Impostos[Pos].isentos + PrecoItem
        else if qryProdutosNotasPagincidencia.AsString = ctREDUCAOBASESUBSTITUICAO then begin
          Impostos[Pos].isentos := Impostos[Pos].isentos + PrecoItem
                                   - qryProdutosNotasPagvalorreducaobase.AsCurrency;
          Impostos[Pos].outros  := Impostos[Pos].outros
                                   + qryProdutosNotasPagvalorreducaobase.AsCurrency;
        end else if (Impostos[Pos].aliquota > 0) and CreditarICMS then
          Impostos[Pos].base    := Impostos[Pos].base + PrecoItem
        else
          Impostos[Pos].isentos := Impostos[Pos].isentos + PrecoItem;
        Total := Total + PrecoItem;
//      end;
//      end;
      qryProdutosNotasPag.Next
    end;

    // Atribui calculos dos impostos a Nota de Entrada.
    InserindoCalculos:= True;
    Acrescimo:= qryNotasPagacrescimo.AsCurrency;
    SetLength(Impostos, QtdadeAliquotas);
    for Pos := 0 to QtdadeAliquotas - 1 do
    begin

      if (Impostos[Pos].isentos > 0) then
        RateioAcrescimo:=  (Impostos[Pos].isentos * Acrescimo / Total)
      else if (Impostos[Pos].base > 0) then
        RateioAcrescimo:=  (Impostos[Pos].base * Acrescimo / Total)
      else if (Impostos[Pos].outros > 0) then
        RateioAcrescimo:=  (Impostos[Pos].outros * Acrescimo / Total)
      else
        RateioAcrescimo:= 0;

      if (Impostos[Pos].base = 0) then
           RateioDesconto:=  (Impostos[Pos].Isentos * (qryNotasPagdesconto.AsCurrency / Total))
      else RateioDesconto:=  (Impostos[Pos].base * (qryNotasPagdesconto.AsCurrency / Total));

      if DevolverSeguro then
           if (Impostos[Pos].base = 0) then
                RateioSeguro:=  (Impostos[Pos].Isentos * (qryNotasPagseguro.AsCurrency / Total) )
           else RateioSeguro:=  (Impostos[Pos].base * (qryNotasPagseguro.AsCurrency / Total) )
      else RateioSeguro:= 0;

      if DevolverFrete then
           if (Impostos[Pos].base = 0) then
                RateioFrete :=  (Impostos[Pos].Isentos * (qryNotasPagfreteinterno.AsCurrency / Total))
           else RateioFrete :=  (Impostos[Pos].base * (qryNotasPagfreteinterno.AsCurrency / Total))
      else RateioFrete := 0;

      qryCalculosNotasPag.Append;

      if ClienteTrouxeNota then
           qryCalculosNotasPagcodigonota.AsInteger := StrToInt(NumeroDevolucao)
      else qryCalculosNotasPagcodigonota.AsInteger := Ord(TipoNota);

      qryCalculosNotasPagnumero.AsInteger        := Pos + 1;
      qryCalculosNotasPagtipo.AsString           := 'M';
      qryCalculosNotasPagaliquota.AsFloat        := Impostos[Pos].aliquota;
      qryCalculosNotasPagbase.AsCurrency         :=  (Impostos[Pos].base + RateioFrete + RateioSeguro - RateioDesconto);
      qryCalculosNotasPagvalor.AsCurrency        :=  ((qryCalculosNotasPagbase.AsCurrency * Impostos[Pos].aliquota) / 100);
      qryCalculosNotasPagisentas.AsCurrency      :=  (Impostos[Pos].isentos + RateioAcrescimo);
      qryCalculosNotasPagoutras.AsCurrency       :=  (Impostos[Pos].outros);
      qryCalculosNotasPag.Post;

      if not (qryNotasPag.State in [dsEdit, dsInsert]) then
        qryNotasPag.Edit;

      qryNotasPagtotalcalculos.AsCurrency:= qryNotasPagtotalcalculos.AsCurrency   +
                                            qryCalculosNotasPagbase.AsCurrency    +
                                            qryCalculosNotasPagisentas.AsCurrency +
                                            qryCalculosNotasPagoutras.AsCurrency;
      qryNotasPag.Post;
    end;
    InserindoCalculos:= False;
  finally
    Impostos := nil;
    qryProdutosContratos.EnableControls;
  end;

end;
 }


procedure TdtmDevolucaoMercadorias.AtribuirValoresProdutosContratosViaDadosFiscais;
var
  Faltam: Boolean;
  icmsbasecalculo, icmsbasecalculodev,
  icmsvalor, icmsvalordev,
  icmsvalorst, icmsvalorstdev,
  icmsbasecalculost, icmsbasecalculostdev,
  ipibasecalculo, ipibasecalculodev,
  ipivalor, ipivalordev,
  iibasecalculo, iibasecalculodev,
  iidespaduaneira, iidespaduaneiradev,
  iivalor, iivalordev,
  iiiof, iiiofdev,
  pisbasecalculo, pisbasecalculodev,
  pisvalor, pisvalordev,
  cofinsbasecalculo, cofinsbasecalculodev,
  cofinsvalor, cofinsvalordev,
  desconto, descontodev,
  valordescontoitem_, valordescontoitemdev: Currency;
  i,j: integer;

  {Acrescimo, vdesconto, vdescontoitem, vfrete, vseguro: Currency;}
begin
              {
  vAcrescimo := 0;
  vdesconto := 0;
  vdescontoitem := 0;
  vfrete := 0;
  vseguro := 0;
}
  try
//    qryProdutosContratos.Edit;

    for i := 0 to length(produtoseServicos[produtos])-1 do
    begin
      if produtoseServicos[produtos][i].produto = qryDadosFiscaisproduto.asLargeInt then
        produtoseServicos[produtos][i].RegistroOK := false;
    end;

    GuardarRegistroAtual(qryDadosFiscais,true);
    qryDadosFiscais.First;

    while not qryDadosFiscais.Eof do
    begin
      if qryDadosFiscaisdevolver.AsFloat > 0 then
      begin

        if ((qryDadosFiscaistipo.asString = 'Notas') or
           (qryDadosFiscaistipo.asString = 'Cupons')) then
        begin

          icmsbasecalculo   := 0; icmsvalor       := 0; icmsvalorst := 0;
          icmsbasecalculost := 0; ipibasecalculo  := 0; ipivalor    := 0;
          iibasecalculo     := 0; iidespaduaneira := 0; iivalor     := 0;
          iiiof             := 0; pisbasecalculo  := 0; pisvalor    := 0;
          cofinsbasecalculo := 0; cofinsvalor     := 0;
          desconto := 0;
          valordescontoitem_ := 0;

          icmsbasecalculodev   := 0; icmsvalordev       := 0; icmsvalorstdev   := 0;
          icmsbasecalculostdev := 0; ipibasecalculodev  := 0; ipivalordev      := 0;
          iibasecalculodev     := 0; iidespaduaneiradev := 0; iivalordev       := 0;
          iiiofdev             := 0; pisbasecalculodev  := 0; pisvalordev      := 0;
          cofinsbasecalculodev := 0; cofinsvalordev     := 0;
          descontodev := 0; valordescontoitemdev := 0;

          //CAMPOS FIXOS

          i := length(ProdutoseServicos[Produtos]);

          SetLength(ProdutoseServicos[Produtos], i+1);

          ProdutoseServicos[Produtos][i].dadofiscal := qrydadosfiscaisdadofiscal.asinteger;
          ProdutoseServicos[Produtos][i].eHCupomFiscal := qrydadosfiscaiseHCupomFiscal.asBoolean;

          ProdutoseServicos[Produtos][i].numeroprodutotabela := qrydadosfiscaisnumeroproduto.asinteger;
          ProdutoseServicos[Produtos][i].numeronotafiscalsaida := qrydadosfiscaisnota.asinteger;
          ProdutoseServicos[Produtos][i].produto := qryDadosFiscaisproduto.asLargeInt;
          ProdutoseServicos[Produtos][i].produtovisual := qryDadosFiscaisprodutovisual.asString;

          ProdutoseServicos[Produtos][i].lote := qryDadosFiscaislote.asLargeInt;
          ProdutoseServicos[Produtos][i].nrlote := qryDadosFiscaisnrlote.asString;
          ProdutoseServicos[Produtos][i].fabricacao := qryDadosFiscaisfabricacao.AsDateTime;
          ProdutoseServicos[Produtos][i].validade := qryDadosFiscaisvalidade.AsDateTime;

          ProdutoseServicos[Produtos][i].filial := qryDadosFiscaisfilial.asInteger;
          ProdutoseServicos[Produtos][i].descricaoproduto := qryProdutosContratosdescricao.asString;
          ProdutoseServicos[Produtos][i].aliquotaicms := qryprodutoscontratosaliquotaicms.ascurrency;
          ProdutoseServicos[Produtos][i].qtdeentregueparadevolver := qrydadosfiscaisdevolver.ascurrency;
          ProdutoseServicos[Produtos][i].PrecoVenda := qryprodutosContratosPrecoVenda.asCurrency;
          ProdutoseServicos[Produtos][i].valorreducaobaseunitaria := qryDadosFiscaisvalorreducaobaseunitaria.ascurrency;
          ProdutoseServicos[Produtos][i].incidencia := qryprodutosContratosincidencia.asstring;
          ProdutoseServicos[Produtos][i].csosn := qryprodutosContratoscsosn.asstring;

          ProdutoseServicos[Produtos][i].acrescimo := truncar(qrydadosfiscaisAcrescimo.asCurrency / qryDadosFiscaisqtdeoriginal.asCurrency * qrydadosfiscaisdevolver.ascurrency,2);
          ProdutoseServicos[Produtos][i].desconto := truncar(qrydadosfiscaisdesconto.AsCurrency / qryDadosFiscaisqtdeoriginal.asCurrency  * qrydadosfiscaisdevolver.ascurrency,2);
          ProdutoseServicos[Produtos][i].valordescontoitem := truncar(qrydadosfiscaisvalordescontoitem.AsCurrency / qryDadosFiscaisqtdeoriginal.asCurrency  * qrydadosfiscaisdevolver.ascurrency,2);

          if DevolverFrete then
            ProdutoseServicos[Produtos][i].frete   := truncar(qrydadosfiscaisfrete.AsCurrency / qryDadosFiscaisqtdeoriginal.asCurrency  * qrydadosfiscaisdevolver.ascurrency,2);
          if DevolverSeguro then
            ProdutoseServicos[Produtos][i].seguro  := truncar(qrydadosfiscaisseguro.AsCurrency / qryDadosFiscaisqtdeoriginal.asCurrency  * qrydadosfiscaisdevolver.ascurrency,2);


          ProdutoseServicos[Produtos][i].aliquotaicmsst := qryDadosFiscaisaliquotaicmsst.AsFloat;
          ProdutoseServicos[Produtos][i].icmsmodalidade     := qryDadosFiscaisicmsmodalidade.AsInteger;
          ProdutoseServicos[Produtos][i].icmsmodsubst       := qryDadosFiscaisicmsmodsubst.AsInteger;

          ProdutoseServicos[Produtos][i].ipicst              := qryDadosFiscaisipicst.AsString;

          ProdutoseServicos[Produtos][i].piscst             := qryDadosFiscaispiscst.AsString;
          ProdutoseServicos[Produtos][i].pisaliquota          := qryDadosFiscaispisaliquota.AsFloat;

          ProdutoseServicos[Produtos][i].cofinscst          := qryDadosFiscaiscofinscst.AsString;
          ProdutoseServicos[Produtos][i].cofinsaliquota       := qryDadosFiscaiscofinsaliquota.AsFloat;

          ProdutoseServicos[Produtos][i].unidade             := qryDadosFiscaisunidade.AsString;
          ProdutoseServicos[Produtos][i].origem              := qryDadosFiscaisorigem.AsString;
          ProdutoseServicos[Produtos][i].extipi              := qryDadosFiscaisextipi.AsString;
          ProdutoseServicos[Produtos][i].genero             := qryDadosFiscaisgenero.AsInteger;
          ProdutoseServicos[Produtos][i].tribcodigoean       := qryDadosFiscaistribcodigoean.AsString;
          ProdutoseServicos[Produtos][i].tribunidade         := qryDadosFiscaistribunidade.AsString;
          ProdutoseServicos[Produtos][i].tribquantidade       := qrydadosfiscaisdevolver.ascurrency;
          ProdutoseServicos[Produtos][i].tribunitario         := qryprodutosContratosPrecoVenda.asCurrency;
          ProdutoseServicos[Produtos][i].enquadramento      := qryDadosFiscaisenquadramento.AsInteger;
          ProdutoseServicos[Produtos][i].classificacaofiscal:= qryDadosFiscaisclassificacaofiscal.AsString;


          Faltam:= (qryDadosFiscaisquantidade.AsCurrency   -
                    qryDadosFiscaisdevolver.AsCurrency)    > 0;

          if not faltam then
          begin
            if qryDadosFiscaisquantidade.AsCurrency > 0 then
            begin
              // BUSCAR OS VALORES DE NOTASPAG E PRODUTOSNOTASPAG JÁ DEVOLVIDOS PARA OS DADOSFISCAIS SELECIONADOS
              {
              RefazConsultaPorNome(qryProdutosNotasPagDevolvidos, ['dadofiscal','produto','filial'],
                    [qryDadosFiscaisdadofiscal.AsInteger, qryProdutosContratosproduto.AsString,
                     qryDadosFiscaisfilialnota.AsInteger]);
              }

              RefazConsultaPorNome(qryProdutosNotasPagDevolvidos, ['dadofiscal','numeroproduto','produto','filial'],
                    [qryDadosFiscaisdadofiscal.AsInteger,
                     qryDadosFiscaisnumeroproduto.asinteger,
                     qrydadosfiscaisproduto.asString,
                     qryDadosFiscaisfilialnota.AsInteger]);

              qryProdutosNotasPagDevolvidos.first;
              while not qryProdutosNotasPagDevolvidos.Eof do
              begin
                icmsbasecalculodev   := icmsbasecalculodev   + qryProdutosNotasPagDevolvidosicmsbasecalculo.AsCurrency;
                icmsvalordev         := icmsvalordev         + qryProdutosNotasPagDevolvidosicmsvalor.AsCurrency;
                icmsvalorstdev       := icmsvalorstdev       + qryProdutosNotasPagDevolvidosicmsvalorst.AsCurrency;
                icmsbasecalculostdev := icmsbasecalculostdev + qryProdutosNotasPagDevolvidosicmsbasecalculost.AsCurrency;
                ipibasecalculodev    := ipibasecalculodev    + qryProdutosNotasPagDevolvidosipibasecalculo.AsCurrency;
                ipivalordev          := ipivalordev          + qryProdutosNotasPagDevolvidosipivalor.AsCurrency;
                iibasecalculodev     := iibasecalculodev     + qryProdutosNotasPagDevolvidosiibasecalculo.AsCurrency;
                iidespaduaneiradev   := iidespaduaneiradev   + qryProdutosNotasPagDevolvidosiidespaduaneira.AsCurrency;
                iivalordev           := iivalordev           + qryProdutosNotasPagDevolvidosiivalor.AsCurrency;
                iiiofdev             := iiiofdev             + qryProdutosNotasPagDevolvidosiiiof.AsCurrency;
                pisbasecalculodev    := pisbasecalculodev    + qryProdutosNotasPagDevolvidospisbasecalculo.AsCurrency;
                pisvalordev          := pisvalordev          + qryProdutosNotasPagDevolvidospisvalor.AsCurrency;
                cofinsbasecalculodev := cofinsbasecalculodev + qryProdutosNotasPagDevolvidoscofinsbasecalculo.AsCurrency;
                cofinsvalordev       := cofinsvalordev       + qryProdutosNotasPagDevolvidoscofinsvalor.AsCurrency;
                descontodev          := descontodev          + qryProdutosNotasPagDevolvidosdesconto.AsCurrency;
                valordescontoitemdev := valordescontoitemdev + qryProdutosNotasPagDevolvidosvalordescontoitem.AsCurrency;
                qryProdutosNotasPagDevolvidos.Next;
              end;
              qryProdutosNotasPagDevolvidos.Close;

              icmsbasecalculo   := icmsbasecalculo + qryDadosFiscaisicmsbasecalculo.AsCurrency - icmsbasecalculodev;
              icmsvalor         := icmsvalor       + qryDadosFiscaisicmsvalor.AsCurrency       - icmsvalordev;
              icmsvalorst       := icmsvalorst     + qryDadosFiscaisicmsvalorst.AsCurrency     - icmsvalorstdev;
              icmsbasecalculost := icmsbasecalculost + qryDadosFiscaisicmsbasecalculost.AsCurrency - icmsbasecalculostdev;
              ipibasecalculo    := ipibasecalculo  + qryDadosFiscaisipibasecalculo.AsCurrency  - ipibasecalculodev;
              ipivalor          := ipivalor        + qryDadosFiscaisvaloripi.AsCurrency        - ipivalordev;
              iibasecalculo     := iibasecalculo   + qryDadosFiscaisiibasecalculo.AsCurrency   - iibasecalculodev;
              iidespaduaneira   := iidespaduaneira + qryDadosFiscaisiidespaduaneira.AsCurrency - iidespaduaneiradev;
              iivalor           := iivalor         + qryDadosFiscaisiivalor.AsCurrency         - iivalordev;
              iiiof             := iiiof           + qryDadosFiscaisiiiof.AsCurrency           - iiiofdev;
              pisbasecalculo    := pisbasecalculo  + qryDadosFiscaispisbasecalculo.AsCurrency  - pisbasecalculodev;
              pisvalor          := pisvalor        + qryDadosFiscaispisvalor.AsCurrency        - pisvalordev;
              cofinsbasecalculo := cofinsbasecalculo + qryDadosFiscaiscofinsbasecalculo.AsCurrency - cofinsbasecalculodev;
              cofinsvalor       := cofinsvalor     + qryDadosFiscaiscofinsvalor.AsCurrency     - cofinsvalordev;
              desconto          := desconto          + qryDadosFiscaisdesconto.AsCurrency - descontodev;
              valordescontoitem_ := valordescontoitem_ + qryDadosFiscaisvalordescontoitem.AsCurrency - valordescontoitemdev;
            end;
          end
          else
          begin
            icmsbasecalculo   := icmsbasecalculo + Truncar(qryDadosFiscaisicmsbasecalculo.AsCurrency     /
                                                           qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);
            icmsvalor         := icmsvalor       + Truncar(qryDadosFiscaisicmsvalor.AsCurrency           /
                                                           qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);
            icmsvalorst       := icmsvalorst     + Truncar(qryDadosFiscaisicmsvalorst.AsCurrency         /
                                                           qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);
            icmsbasecalculost := icmsbasecalculost + Truncar(qryDadosFiscaisicmsbasecalculost.AsCurrency /
                                                             qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);
            ipibasecalculo    := ipibasecalculo  + Truncar(qryDadosFiscaisipibasecalculo.AsCurrency      /
                                                           qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);
            ipivalor          := ipivalor        + Truncar(qryDadosFiscaisvaloripi.AsCurrency      /
                                                           qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);
            iibasecalculo     := iibasecalculo   + Truncar(qryDadosFiscaisiibasecalculo.AsCurrency       /
                                                           qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);
            iidespaduaneira   := iidespaduaneira + Truncar(qryDadosFiscaisiidespaduaneira.AsCurrency     /
                                                           qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);
            iivalor           := iivalor         + Truncar(qryDadosFiscaisiivalor.AsCurrency             /
                                                           qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);
            iiiof             := iiiof           + Truncar(qryDadosFiscaisiiiof.AsCurrency               /
                                                           qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);
            pisbasecalculo    := pisbasecalculo  + Truncar(qryDadosFiscaispisbasecalculo.AsCurrency      /
                                                           qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);
            pisvalor          := pisvalor        + Truncar(qryDadosFiscaispisvalor.AsCurrency            /
                                                           qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);
            cofinsbasecalculo := cofinsbasecalculo + Truncar(qryDadosFiscaiscofinsbasecalculo.AsCurrency /
                                                             qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);

            cofinsvalor       := cofinsvalor     + Truncar(qryDadosFiscaiscofinsvalor.AsCurrency         /
                                                           qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);

            desconto       := desconto     + Truncar(qryDadosFiscaisdesconto.AsCurrency         /
                                                           qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);

            valordescontoitem_ := valordescontoitem_     + Truncar(qryDadosFiscaisvalordescontoitem.AsCurrency         /
                                                           qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);

          end;

          ProdutoseServicos[Produtos][i].icmsbasecalculo   := icmsbasecalculo;
          ProdutoseServicos[Produtos][i].icmsvalor         := icmsvalor;
          ProdutoseServicos[Produtos][i].icmsvalorst := icmsvalorst;
          ProdutoseServicos[Produtos][i].icmsbasecalculost := icmsbasecalculost;
          ProdutoseServicos[Produtos][i].ipibasecalculo    := ipibasecalculo;
          ProdutoseServicos[Produtos][i].valoripi := ipivalor;
          ProdutoseServicos[Produtos][i].iibasecalculo     := iibasecalculo;
          ProdutoseServicos[Produtos][i].iidespaduaneira   := iidespaduaneira;
          ProdutoseServicos[Produtos][i].iivalor           := iivalor;
          ProdutoseServicos[Produtos][i].iiiof             := iiiof;
          ProdutoseServicos[Produtos][i].pisbasecalculo    := pisbasecalculo;
          ProdutoseServicos[Produtos][i].pisvalor          := pisvalor;
          ProdutoseServicos[Produtos][i].cofinsbasecalculo := cofinsbasecalculo;
          ProdutoseServicos[Produtos][i].cofinsvalor       := cofinsvalor;
          ProdutoseServicos[Produtos][i].desconto       := desconto;
          ProdutoseServicos[Produtos][i].valordescontoitem       := valordescontoitem_;

          qryProdutosSeries.first;
          while not qryProdutosSeries.eof do
          begin
            if (qryprodutosseriesdadofiscal.asinteger = ProdutoseServicos[Produtos][i].dadofiscal) and
               (qryProdutosSeriesproduto.asLargeint =  ProdutoseServicos[Produtos][i].produto) and
               qryprodutosSeriesDevolvido.asBoolean then
            begin
              j := length(ProdutoseServicos[Produtos][i].numeroserie);
              SetLength(ProdutoseServicos[Produtos][i].numeroserie, j+1);
              ProdutoseServicos[Produtos][i].numeroserie[j].numeroserie := qryProdutosSeriesnumeroserie.asString;
            end;
            qryProdutosSeries.next;
          end;

          ProdutoseServicos[Produtos][i].RegistroOK        := true;
        end;
           {
        else
        begin
          qryDadosFiscais.Next;
        end;
        }

      end;


      qryDadosFiscais.Next;
    end;


//    qryProdutosContratos.Post;
  finally
    VoltarRegistroAtual(qryDadosFiscais);
  end;
end;


function TdtmDevolucaoMercadorias.PreencherProdutosNotasFiscal({TipoNota: TtecTipoNota; Numero: Integer}): Boolean;
var
  i, j, QtItemsNota, QtItemsNotaSerie: integer;

begin
  result := false;
  QtItemsNota := length(produtoseServicos[produtos]);
  for i := 0 to QtItemsNota-1 do
  begin
    if ProdutoseServicos[Produtos][i].RegistroOK then
    begin
      qryProdutosNotasPag.Append;
      if ClienteTrouxeNota then
        qryProdutosNotasPagcodigonota.AsInteger   := StrToInt(NumeroDevolucao)
      else
        qryProdutosNotasPagcodigonota.AsInteger   := 0{Ord(TipoNota)};

      qryProdutosNotasPagdadofiscal.asInteger :=  ProdutoseServicos[Produtos][i].dadofiscal;
      qryProdutosNotasPagnumeroprodutotabela.AsInteger := ProdutoseServicos[Produtos][i].numeroprodutotabela;
      qryProdutosNotasPagnumeronotafiscalsaida.asinteger := ProdutoseServicos[Produtos][i].numeronotafiscalsaida;
      if qryProdutosNotasPagnumeronotafiscalsaida.asinteger = 0 then
        qryProdutosNotasPagnumeronotafiscalsaida.clear;
      qryProdutosNotasPagnumero.AsInteger            := {Numero} i+1;
      qryProdutosNotasPagfilial.AsInteger       := ifthen(TipoFilial<>'V', FilialBase, ProdutoseServicos[Produtos][i].filial);
      qryProdutosNotasPagProduto.AsLargeInt     := ProdutoseServicos[Produtos][i].produto;

      if ProdutoseServicos[Produtos][i].lote <> 0 then
      begin
        qryProdutosNotasPaglote.AsLargeInt     := ProdutoseServicos[Produtos][i].lote;
        qryProdutosNotasPagnrlote.AsString     := ProdutoseServicos[Produtos][i].nrlote;
        qryProdutosNotasPagfabricacao.AsDateTime     := ProdutoseServicos[Produtos][i].fabricacao;
        qryProdutosNotasPagvalidade.AsDateTime     := ProdutoseServicos[Produtos][i].validade;
      end;  

      qryProdutosNotasPagProdutovisual.AsString := ProdutoseServicos[Produtos][i].produtovisual;

      qryProdutosNotasPagdescricaoproduto.AsString := ProdutoseServicos[Produtos][i].descricaoproduto;
      if CreditarICMS then
        qryProdutosNotasPagaliquotaicms.AsFloat  := ProdutoseServicos[Produtos][i].aliquotaicms
      else
        qryProdutosNotasPagaliquotaicms.AsFloat  := 0;
      qryProdutosNotasPagquantidade.AsCurrency      := ProdutoseServicos[Produtos][i].qtdeentregueparadevolver;
      qryProdutosNotasPagprecovenda.AsCurrency      := ProdutoseServicos[Produtos][i].PrecoVenda;
      qryProdutosNotasPagvalorreducaobase.AsCurrency := ProdutoseServicos[Produtos][i].valorreducaobaseunitaria *
                                                        qryProdutosNotasPagquantidade.AsCurrency;
      qryProdutosNotasPagincidencia.AsString         := ProdutoseServicos[Produtos][i].incidencia;
      qryProdutosNotasPagcsosn.AsString              := ProdutoseServicos[Produtos][i].csosn;
      qryProdutosNotasPagacrescimo.AsCurrency := ProdutoseServicos[Produtos][i].Acrescimo;
      qryProdutosNotasPagdesconto.AsCurrency  := ProdutoseServicos[Produtos][i].desconto;
      qryProdutosNotasPagvalordescontoitem.AsCurrency := ProdutoseServicos[Produtos][i].valordescontoitem;

      if DevolverFrete then
        qryProdutosNotasPagfrete.AsCurrency   := ProdutoseServicos[Produtos][i].frete;
      if DevolverSeguro then
        qryProdutosNotasPagseguro.AsCurrency  := ProdutoseServicos[Produtos][i].seguro;

      if NotaSubstituicao(ifthen((regimetributario=1),qryProdutosNotasPagcsosn.AsString,qryProdutosNotasPagincidencia.AsString)) then
        SelecionarDadosNaturezaPadrao(noDEVOLUCAOMERCADORIASUBSTTRIB, nil, qryprodutosnotaspag, qryClientes, Devolucao, '',
        not (ProdutoseServicos[Produtos][i].eHCupomFiscal and (estadofilialbase<>qrycontratosestado.asString)) )
      else
        SelecionarDadosNaturezaPadrao(noDEVOLUCAOMERCADORIA, nil, qryprodutosnotaspag, qryClientes, Devolucao, '',
        not (ProdutoseServicos[Produtos][i].eHCupomFiscal and (estadofilialbase<>qrycontratosestado.asString)));

      qryProdutosNotasPagexigenotareferenciada.asboolean := exigenotareferenciada(qryProdutosNotasPagcodigofiscal.AsInteger);

      qryProdutosNotasPagicmsbasecalculo.AsFloat    := ProdutoseServicos[Produtos][i].icmsbasecalculo;
      qryProdutosNotasPagicmsvalor.AsFloat          := ProdutoseServicos[Produtos][i].icmsvalor;
      qryProdutosNotasPagicmsmodalidade.AsInteger   := ProdutoseServicos[Produtos][i].icmsmodalidade;
      qryProdutosNotasPagicmsmodsubst.AsInteger     := ProdutoseServicos[Produtos][i].icmsmodsubst;
      qryProdutosNotasPagaliquotaicmsst.AsFloat     := ProdutoseServicos[Produtos][i].aliquotaicmsst;
      qryProdutosNotasPagicmsvalorst.AsFloat        := ProdutoseServicos[Produtos][i].icmsvalorst;
      qryProdutosNotasPagicmsbasecalculost.AsFloat  := ProdutoseServicos[Produtos][i].icmsbasecalculost;

      qryProdutosNotasPagipibasecalculo.AsFloat     := ProdutoseServicos[Produtos][i].ipibasecalculo;
      qryProdutosNotasPagvaloripi.AsFloat           := ProdutoseServicos[Produtos][i].valoripi;

      qryProdutosNotasPagiibasecalculo.AsFloat      := ProdutoseServicos[Produtos][i].iibasecalculo;
      qryProdutosNotasPagiidespaduaneira.AsFloat    := ProdutoseServicos[Produtos][i].iidespaduaneira;
      qryProdutosNotasPagiivalor.AsFloat            := ProdutoseServicos[Produtos][i].iivalor;
      qryProdutosNotasPagiiiof.AsFloat              := ProdutoseServicos[Produtos][i].iiiof;

      qryProdutosNotasPagpisbasecalculo.AsFloat     := ProdutoseServicos[Produtos][i].pisbasecalculo;
      qryProdutosNotasPagpisaliquota.AsFloat        := ProdutoseServicos[Produtos][i].pisaliquota;
      qryProdutosNotasPagpisvalor.AsFloat           := ProdutoseServicos[Produtos][i].pisvalor;

      qryProdutosNotasPagcofinsbasecalculo.AsFloat  := ProdutoseServicos[Produtos][i].cofinsbasecalculo;
      qryProdutosNotasPagcofinsaliquota.AsFloat     := ProdutoseServicos[Produtos][i].cofinsaliquota;
      qryProdutosNotasPagcofinsvalor.AsFloat        := ProdutoseServicos[Produtos][i].cofinsvalor;

      qryProdutosNotasPagunidade.AsString           := ProdutoseServicos[Produtos][i].unidade;
      qryProdutosNotasPagorigem.AsString            := ProdutoseServicos[Produtos][i].origem;
      qryProdutosNotasPagextipi.AsString            := ProdutoseServicos[Produtos][i].extipi;
      qryProdutosNotasPaggenero.AsInteger           := ProdutoseServicos[Produtos][i].genero;
      qryProdutosNotasPagtribcodigoean.AsString     := ProdutoseServicos[Produtos][i].tribcodigoean;
      qryProdutosNotasPagtribunidade.AsString       := ProdutoseServicos[Produtos][i].tribunidade;
      qryProdutosNotasPagtribquantidade.AsFloat     := ProdutoseServicos[Produtos][i].tribquantidade;
      qryProdutosNotasPagtribunitario.AsFloat       := ProdutoseServicos[Produtos][i].tribunitario;
      qryProdutosNotasPagenquadramento.AsInteger    := ProdutoseServicos[Produtos][i].enquadramento;
      qryProdutosNotasPagclassificacaofiscal.AsString := ProdutoseServicos[Produtos][i].classificacaofiscal;

      result := AtribuirDadosProdutos(qryprodutosNotasPag, qryNotasPag, nil, false, Devolucao);

      if not DevolverFrete then
         qryprodutosNotasPagfrete.asCurrency := 0;

      qryProdutosNotasPagprecounitario.AsCurrency := ProdutoseServicos[Produtos][i].PrecoVenda; { qryProdutosContratosprecovenda.AsCurrency};

      if result then  // Atribuido em SelecionarCodigoNatureza();
        qryProdutosNotasPag.Post
      else
        qryProdutosNotasPag.Cancel;

      if result then
      begin
        QtItemsNotaSerie := length(ProdutoseServicos[Produtos][i].numeroserie);
        for j := 0 to QtItemsNotaSerie-1 do
        begin
          qryProdutosNotasPagSeries.append;
          qryProdutosNotasPagSeriescodigonota.AsInteger := qryProdutosNotasPagcodigonota.AsInteger;
          qryProdutosNotasPagSeriesnumero.asinteger :=  qryProdutosNotasPagnumero.AsInteger;
          qryProdutosNotasPagSeriesproduto.asLargeint :=  qryProdutosNotasPagProduto.AsLargeInt;
          qryProdutosNotasPagSeriescodigovisual.asString := qryprodutosnotaspagprodutovisual.asString;
          qryProdutosNotasPagSeriesnumeroserie.asString :=  ProdutoseServicos[Produtos][i].numeroserie[j].numeroserie;
          qryProdutosNotasPagSeries.post;
        end;
      end;
    end;
  end;

end;

{
procedure TdtmDevolucaoMercadorias.ApagarNotasPagDadosFiscais;
begin
  dsrDadosFiscais.OnDataChange:= nil;
  if qryNotasPagDadosFiscais.Active and (qryNotasPagDadosFiscais.RecordCount > 0) then begin
    qryNotasPagDadosFiscais.First;
    while not qryNotasPagDadosFiscais.Eof do
      qryNotasPagDadosFiscais.Delete;
  end;
  dsrDadosFiscais.OnDataChange:= dsrDadosFiscaisDataChange;
end;
}

{
procedure TdtmDevolucaoMercadorias.PreencherNotasPagDadosFiscais;
begin
  dsrDadosFiscais.OnDataChange:= nil;
  if qryNotasPagDadosFiscais.State = dsInactive then
    qryNotasPagDadosFiscais.Open;

  qryDadosFiscais.First;
  while not qryDadosFiscais.Eof do begin
    if (qryDadosFiscaisdevolver.AsCurrency > 0) then begin
      qryNotasPagDadosFiscais.Insert;
      qryNotasPagDadosFiscaisdadofiscal.AsInteger  := qryDadosFiscaisdadofiscal.AsInteger;
      qryNotasPagDadosFiscaisproduto.AsLargeInt    := qryProdutosContratosproduto.AsLargeInt;
      qryNotasPagDadosFiscaisfilial.AsInteger      := qryProdutosContratosfilial.AsInteger;
      qryNotasPagDadosFiscaisquantidade.AsCurrency := qryDadosFiscaisdevolver.AsCurrency;
      qryNotasPagDadosFiscais.Post;
    end;
    qryDadosFiscais.Next;
  end;
  dsrDadosFiscais.OnDataChange:= dsrDadosFiscaisDataChange;
end;
}

{
procedure TdtmDevolucaoMercadorias.ExcluirNotasPagDadosFiscais;
begin
  if qryNotasPagDadosFiscais.Active then begin
    qryNotasPagDadosFiscais.First;
    while not qryNotasPagDadosFiscais.Eof do begin
      if (qryNotasPagDadosFiscaisproduto.AsLargeInt = qryProdutosContratosproduto.AsLargeInt) and
         (qryNotasPagDadosFiscaisfilial.AsInteger = qryProdutosContratosfilial.AsInteger) then
           qryNotasPagDadosFiscais.Delete
      else qryNotasPagDadosFiscais.Next;
    end;
  end;
end;
}

procedure TdtmDevolucaoMercadorias.CancelarDevolucao;
begin
  CancelarAtualizacoes([qryContratos  , qryParcelasContratos, qryProdutosContratos,
                        qryPrecos     , qryProdutos         , qryEstoques         , qryMovimentos,
                        qryNotasPag   , qryProdutosNotasPag ,
                        {dtmGerarNotaFiscal.qryCalculosNotasPag ,} qryNumeroNota,
                        qryContratosDevolvidos{, qryNotasPagDadosFiscais}]);
end;

constructor TdtmDevolucaoMercadorias.Create(AOwner: TComponent);
begin
  inherited;
  qryClientes.Tag         := ctTabelas;
  qryConsultaClientes.Tag := ctVendaTabelaConsultaClientes;
//  FCancelarTotal   := True; XX-jander
  InserindoCalculos:= False;
  qryProdutosContratosquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosContratoscancelado.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosContratosdevolver.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosContratosfuturo.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosContratosqtdeentregue.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosContratosqtdeentregueparadevolver.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosNotasPagquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryDadosFiscaisdevolver.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryDadosFiscaisquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;

{  if not assigned(dtmGerarNotaFiscal) then
  begin
    dtmGerarNotaFiscal := tdtmGerarNotaFiscal.create(self);
    dsrCalculosNotasPag.DataSet :=  dtmGerarNotaFiscal.qryCalculosNotasPag;
  end;}
  qryCalculosProdutos.ParamByName('SimplesNacional').AsBoolean := (RegimeTributario = 1);
  qryCalculosProdutos.ParamByName('ContribIPI').AsBoolean := contribipi;

  AcertarCasasDecimais(qryProdutosContratosprecovenda);

end;

destructor TdtmDevolucaoMercadorias.Destroy;
begin
  CancelarDevolucao;
  inherited;
end;

procedure TdtmDevolucaoMercadorias.dsrProdutosContratosDataChange(Sender: TObject; Field: TField);
var
  msg: string;
  Pos: TBookmark;
  Entregar: Currency;
begin
  if field = qryProdutosContratosfilialmovimentacao then
  begin
//    msg := 'este';
  end
  else
  if Field = qryProdutosContratosprecovenda then
  begin
    dsrProdutosContratos.OnDataChange := nil;
    if Field.AsCurrency = 0 then msg:= 'maior que zero'
    else                         msg:= 'menor ou igual ' + FloatToStr(qryProdutosContratosprecovendaaux.asCurrency {ProdutoseServicos[Produtos][qryProdutosContratos.CurRec].Preco});
    if (Field.AsCurrency > {ProdutoseServicos[Produtos][qryProdutosContratos.CurRec].Preco} qryProdutosContratosprecovendaaux.ascurrency ) then begin
      MensagemAviso(Format(ctPRECOADEVOLVER,[msg]));
      qryProdutosContratos.Cancel;
      Field.FocusControl;
    end
    else begin
      if qryProdutosContratosproduto.AsLargeInt > 0 then
        if (Field.AsCurrency > 0) then begin
          AtualizaValores;
//          if qryProdutosContratos.State in [dsBrowse] then
//            qryProdutosContratos.Edit;
        end
        else begin
          MensagemAviso(Format(ctPRECOADEVOLVER,[msg]));
          qryProdutosContratos.Cancel;
          Field.FocusControl;
        end;
    end;
    dsrProdutosContratos.OnDataChange := dsrProdutosContratosDataChange;
  end
  else
  if Field = qryProdutosContratosdevolver then
  begin
    dsrProdutosContratos.OnDataChange := nil;

    if (not ClienteTrouxeNota or
       (ClienteTrouxeNota and (qryProdutosContratosqtdeentregue.AsCurrency > 0))) then
    begin
      if Field.AsCurrency <= 0 then msg:= 'Mínimo'
      else                         msg:= 'Máximo';

      if (Field.AsCurrency > 0) and ((Field.AsCurrency <= (qryProdutosContratosquantidade.AsCurrency -
                                                          qryProdutosContratoscancelado.AsCurrency))) then
      begin
        if qryProdutosContratosproduto.AsLargeInt > 0 then
        begin
          //qryProdutosContratos.DisableControls;
          //Pos:= qryProdutosContratos.GetBookmark;
          try
            { Quanto falta para entregar ? }
            Entregar := qryProdutosContratosquantidade.AsCurrency -     { Quantidade vendida }
                        qryProdutosContratoscancelado.AsCurrency  -     { Quantidade já devolvida }
                        qryProdutosContratosqtdeentregue.AsCurrency;    { Saldo NF saida - entrada }

            qryProdutosContratos.edit;
            if qryProdutosContratosdevolver.AsCurrency > Entregar then
              { Qtidade que irá gerar a nota de entrada }
              qryProdutosContratosqtdeentregueparadevolver.AsCurrency := qryProdutosContratosdevolver.AsCurrency - Entregar
            else
              qryProdutosContratosqtdeentregueparadevolver.AsCurrency := 0;

            if (qryProdutosContratosqtdeentregueparadevolver.AsCurrency<>0) and
               ((qryProdutosContratosfilialemissaonota.AsInteger <> 0) and
                (qryProdutosContratosfilialemissaonota.AsInteger <> FilialBase)) and
               not (MensagemConfirmacao(format('A nota fiscal de venda foi gerada na filial %s, deseja gerar a nota fiscal de devolução na filial %s ?',
                                           [qryProdutosContratosfilialemissaonota.AsString, inttostr(FilialBase)])) = smbOK) then
            begin
              Field.FocusControl;
//              qryProdutosContratos.Cancel;
              field.ascurrency := 0;
              qryProdutosContratosqtdeentregueparadevolver.ascurrency := 0;
            end
            else
            begin
              if (Field.AsCurrency = 0) then
              begin
            //    qryProdutosContratos.Edit;
                qryProdutosContratosprecovenda.AsCurrency := {ProdutoseServicos[Produtos][qryProdutosContratos.CurRec].Preco} qryProdutosContratosprecovendaaux.ascurrency;
                qryProdutosContratos.Post;
              end;

              if qryProdutosContratosdefeito.AsBoolean then begin
                qryProdutosContratosdefeito.AsBoolean:= False;
              end;
              AtualizaValores;
//              if qryProdutosContratos.State in [dsBrowse] then
//                qryProdutosContratos.Edit;
            end;

          finally
//            qryProdutosContratos.GotoBookmark(Pos);
//            qryProdutosContratos.FreeBookmark(Pos);
//            qryProdutosContratos.EnableControls;
          end;
        end;

        if not DefinirNotasPagDadosFiscais then
        begin
//          qryProdutosContratos.Cancel;
          Field.FocusControl;
          qryProdutosContratos.edit;
          field.clear;
//          field.ascurrency := 0;
//          qryProdutosContratosqtdeentregueparadevolver.ascurrency := 0;
          qryProdutosContratosqtdeentregueparadevolver.clear;
          qryProdutosContratos.post;

        end;

        Field.FocusControl;
      end
      else begin
        if (Field.AsCurrency > 0) then
          MensagemAviso(Format(ctQUANTIDADEADEVOLVER,[msg,FloatToStr(qryProdutosContratosquantidade.AsCurrency -
                                                                 qryProdutosContratoscancelado.AsCurrency)]));
//      qryProdutosContratos.Cancel;
        qryProdutosContratos.edit;
        Field.FocusControl;
        field.clear;
//        field.ascurrency := 0;
//        qryProdutosContratosqtdeentregueparadevolver.ascurrency := 0;
        qryProdutosContratosqtdeentregueparadevolver.clear;

        qryProdutosContratos.post;


      AtualizaValores;
//      AlterarParcelamento;
      DefinirNotasPagDadosFiscais;

//      ExibirNovosValores(nil);

      end;
    end
    else begin
      MensagemAviso(ctSOMENTEPRODUTOSENTREGUES);
      qryProdutosContratos.Cancel;
      field.ascurrency := 0;
      qryProdutosContratosqtdeentregueparadevolver.ascurrency := 0;
      Field.FocusControl;
    end;

    // a definição da filial deve ser antes da indicação da quantidade a devolver devido a forma como esta implementado
    qryProdutosContratosfilialmovimentacao.readonly := qryProdutosContratosdevolver.asfloat > 0;
    dsrProdutosContratos.OnDataChange := dsrProdutosContratosDataChange;
  end
  else
  if Field = qryProdutosContratosqtdeentregueparadevolver then
  begin
    dsrProdutosContratos.OnDataChange := nil;
    Entregar := qryProdutosContratosquantidade.AsCurrency -
                qryProdutosContratoscancelado.AsCurrency  -
                qryProdutosContratosqtdeentregue.AsCurrency;

    if qryProdutosContratosqtdeentregueparadevolver.AsCurrency > qryProdutosContratosqtdeentregue.AsCurrency then begin
      MensagemAviso(Format(ctQUANTIDADEENTREGUEADEVOLVER, [qryProdutosContratosqtdeentregue.AsCurrency]));
      qryProdutosContratos.Cancel;

      field.ascurrency := 0;
      qryProdutosContratosdevolver.ascurrency := 0;
      Field.FocusControl;
    end else if qryProdutosContratosqtdeentregueparadevolver.AsCurrency > qryProdutosContratosdevolver.AsCurrency then begin
      MensagemAviso(ctENTREGUEMAIORQUEDEVOLVER);
    qryProdutosContratos.Cancel;

      field.ascurrency := 0;
      qryProdutosContratosdevolver.ascurrency := 0;
      Field.FocusControl;
    end else if (qryProdutosContratosdevolver.AsCurrency > Entregar) and
                (qryProdutosContratosqtdeentregueparadevolver.AsCurrency < (qryProdutosContratosdevolver.AsCurrency - Entregar))
    then begin
      MensagemAviso(Format(ctENTREGUEMENORQUEMINIMO, [qryProdutosContratosdevolver.AsCurrency - Entregar]));
    qryProdutosContratos.Cancel;

      field.ascurrency := 0;
      qryProdutosContratosdevolver.ascurrency := 0;
      Field.FocusControl;
    end
    else begin
      if not DefinirNotasPagDadosFiscais then
      begin
        qryProdutosContratos.Cancel;
        field.ascurrency := 0;
        qryProdutosContratosdevolver.ascurrency := 0;

      end;
      Field.FocusControl;
    end;
    dsrProdutosContratos.OnDataChange := dsrProdutosContratosDataChange;
  end;

end;

function TdtmDevolucaoMercadorias.DefinirNotasPagDadosFiscais: boolean;
begin
  result := true;
  if (qryProdutosContratosqtdeentregueparadevolver.AsCurrency > 0) {or
     (qryProdutosContratosquantidadelotes.asCurrency > 0)} then
  begin

    ConsultarDadosFiscais;
    if (qryDadosFiscais.RecordCount > 0) then
    begin
      if qryDadosFiscais.RecordCount > 1 then
      begin
        if not Assigned (frmDadosFiscaisContratos) then
          frmDadosFiscaisContratos:= TfrmDadosFiscaisContratos.Create(frmDadosFiscaisContratos);
        frmDadosFiscaisContratos.ShowModal;
        frmDadosFiscaisContratos.Free;
      end;

      if not DocumentoFiscalNaoVinculado then
      begin

        result := DefinirNumeroSerieProdutos;
        if not result then
        begin
           AtribuirDados(qryProdutosSeries, [qryProdutosSeriesdevolvido], [false]);
           DesabilitarValoresProdutosContratosViaDadosFiscais(qryProdutosContratosproduto.asLargeint);
        end
        else
          AtribuirValoresProdutosContratosViaDadosFiscais;

      end;

    end
    else
      MensagemAviso('Não foi encontrado nenhum Documento Fiscal para este Contrato.');

  end
  else
  begin
    {
    result := DefinirNumeroSerieProdutos;
    if not result then
      AtribuirDados(qryProdutosSeries, [qryProdutosSeriesdevolvido], [false]);
    }
    DesabilitarValoresProdutosContratosViaDadosFiscais(qryProdutosContratosproduto.asLargeint);

  end;

end;

procedure TdtmDevolucaoMercadorias.dsrDadosFiscaisDataChange(Sender: TObject; Field: TField);
begin
  inherited;
  dsrDadosFiscais.OnDataChange:= nil;
  if (Field = qryDadosFiscaisdevolver) then
  begin
    if (Field.AsCurrency > qryDadosFiscaisquantidade.AsCurrency) then begin
      MensagemAviso('A quantidade a devolver informada em Documentos Fiscais/Lotes,' + sLineBreak +
                    'é maior que a quantidade permitida para devolução.');
      Field.AsCurrency:= 0;
      Field.FocusControl;
    end
    else
    if (Field.AsCurrency > qryProdutosContratosqtdeentregueparadevolver.AsCurrency)
       and ((qryDadosFiscaistipo.asString = 'Notas') or
            (qryDadosFiscaistipo.asString = 'Cupons'))
    then
    begin
      MensagemAviso('A quantidade a devolver informada em Documentos Fiscais,' + sLineBreak +
                    'é maior que a quantidade que esta sendo devolvida.');
      Field.AsCurrency:= 0;
      Field.FocusControl;
    end
    {
    else
    if (field
    begin

      MensagemAviso('A quantidade a devolver informada no lote,' + sLineBreak +
                    'é maior que a quantidade que esta sendo devolvida.');
      Field.AsCurrency:= 0;
      Field.FocusControl;
    end
    }


    {
    else
    begin
      qryProdutosContratos.Edit;
      qryProdutosContratosvalorreducaobaseunitaria.AsCurrency := qryDadosFiscaisvalorreducaobaseunitaria.AsCurrency;
      qryprodutoscontratos.Post;
    end};
  end;
  dsrDadosFiscais.OnDataChange:= dsrDadosFiscaisDataChange;
end;

function TdtmDevolucaoMercadorias.DocumentoFiscalNaoVinculado: Boolean;
var
  TotQtdeNF: Currency;
  TotQtdeLotes: Currency;

  vMensagem: boolean;

  procedure ZerarQtDevolver;
  begin
    qryProdutosContratos.Edit;
    qryProdutosContratosdevolver.AsCurrency := 0;
    qryProdutosContratos.Post;
    AtualizaValores;
  end;
begin
  vMensagem := false;
  TotQtdeNF := 0;
  TotQtdeLotes := 0;
  dsrDadosFiscais.OnDataChange:= nil;
  Result:= True;
  GuardarRegistroAtual(qryDadosFiscais,True);
  try
    qryDadosFiscais.First;
    while not qryDadosFiscais.Eof do
    begin

      if ((qryDadosFiscaistipo.asString = 'Notas') or
          (qryDadosFiscaistipo.asString = 'Cupons')) and (qryDadosFiscaisdevolver.AsCurrency > 0) then
      begin

        if not DadosFiscaisOK then
        begin
          MensagemErro('A nota fiscal de venda não foi transmitida para a Receita Federal, ' + chr(13) +
                       'ela deve ser transmitida ou cancelada antes de ser feita a devolução ou troca ');
          result := false;
          vMensagem := true;
          ZerarQtDevolver;
          break;
        end;

        TotQtdeNF:= TotQtdeNF + qryDadosFiscaisdevolver.AsCurrency;
        if (qryDadosFiscaisdevolver.AsCurrency > 0) then
          Result:= False;
      end
      else
      if (qryDadosFiscaistipo.asString = 'Lotes') and (qryDadosFiscaisdevolver.AsCurrency > 0) then
      begin
        TotQtdeLotes := TotQtdeLotes + qryDadosFiscaisdevolver.AsCurrency;
        if (qryDadosFiscaisdevolver.AsCurrency > 0) then
          Result:= False;
      end;

      qryDadosFiscais.Next;
    end;

    if not vMensagem then
    begin
      if {Result or} (TotQtdeNF <> qryProdutosContratosqtdeentregueparadevolver.AsCurrency) then
      begin

        if {Result} (TotQtdeNF=0) then
          MensagemAviso('Nenhum Documento Fiscal foi vinculado ao produto.')
        else
        if (TotQtdeNF <> qryProdutosContratosqtdeentregueparadevolver.AsCurrency) then
          MensagemAviso('A quantidade dos produtos nos Documentos Fiscais,' + sLineBreak +
                        'difere da quantidade que está sendo devolvida');
        ZerarQtDevolver;
      end
      else
      if {Result or} (TotQtdeLotes <> (qryProdutosContratosdevolver.AsCurrency -
                                       qryProdutosContratosqtdeentregueparadevolver.AsCurrency)) then
      begin

        if {Result} (TotQtdeLotes=0) then
          MensagemAviso('Nenhum Lote foi vinculado ao produto.')
        else
        if (TotQtdeLotes <> (qryProdutosContratosdevolver.AsCurrency -
                             qryProdutosContratosqtdeentregueparadevolver.AsCurrency)) then
          MensagemAviso('A quantidade dos produtos nos Lotes,' + sLineBreak +
                        'difere da quantidade que está sendo devolvida');
        ZerarQtDevolver;
      end

    end;
  finally
    VoltarRegistroAtual(qryDadosFiscais);
    dsrDadosFiscais.OnDataChange:= dsrDadosFiscaisDataChange;
  end;
end;

function TdtmDevolucaoMercadorias.ExcluirParcelas: Boolean;
begin
  Result:= False;
  if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['a PARCELA'])) = smbOk then begin
    qryParcelasContratos.Delete;
    Result:= True;
  end;
end;

function TdtmDevolucaoMercadorias.ExisteCliente(NomeCampo, Value: Variant): Boolean;
begin
  if NomeCampo = 'nomecidade' then
       NomeCampo:= 'c.nome'
  else NomeCampo:= 'v.' + NomeCampo;
  qryConsultaClientes.macrobyname('SQLCliente').AsString := ' (upper(to_ascii(' + NomeCampo + ',''latin1'')) ilike upper(to_ascii(''' + ansiuppercase(Value) + '%'',''latin1'')))';

  ReFazConsulta(qryConsultaClientes,[],[]);
  Result := Not qryConsultaClientes.IsEmpty
end;

procedure TdtmDevolucaoMercadorias.AbrirTabelas;
begin
  qryConsultaClientes.macrobyname('SQLCliente').AsString := ' (v.codigo = 0)';
  ReFazConsulta(qryConsultaClientes,[],[]);
end;

procedure TdtmDevolucaoMercadorias.FecharTabelas;
