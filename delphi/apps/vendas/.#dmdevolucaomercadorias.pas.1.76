function TdtmDevolucaoMercadorias.GetCondicaoEmissorNFE: Boolean;
begin
  if qryNotasPag.recordcount <> 0 then
    fCondicaoEmissorNFE := parsistema.EmissorNfe and
                           ((qryNotasPagmodelodocto.AsString = '55') or
                            (qryNotasPagmodelodocto.AsString = '57'))
  else
    fCondicaoEmissorNFE := parsistema.EmissorNfe and
                           ((ModeloDoctoFiscal = '55') or
                            (ModeloDoctoFiscal = '57'));

  Result := fCondicaoEmissorNFE;
end;

function TdtmDevolucaoMercadorias.IncluirSaldoCliente: boolean;
begin
  result := true;
  if DevolveCreditoTroca <> 0 then
  begin
    qryProdutosTrocados.close;
    qryProdutosTrocados.open;

    qryProdutosTrocados.Append;

    spcProdutosTrocadosProximo.Open;
    qryProdutosTrocadosnumero.AsInteger := spcProdutosTrocadosProximonumero.AsInteger;
    spcProdutosTrocadosProximo.close;

    qryProdutosTrocadoscontrato.asstring := qryContratosnumero.AsString;
    qryProdutosTrocadosdata.Value:= DataHoraServidor;
    qryProdutosTrocadostipo.asstring:= 'E';
    qryProdutosTrocadoscliente.Asinteger := qryContratoscliente.AsInteger;
    qryProdutosTrocadostipocliente.AsString := qryContratostipocliente.AsString;
    qryProdutosTrocadosdefeito.AsBoolean := false;
    qryProdutosTrocadosusuario.AsInteger := UsuarioLogin.CodigoUsuario;
    qryProdutosTrocadosvalor.AsCurrency := DevolveCreditoTroca;

    qryProdutosTrocados.post;
  end;
end;

