function TdtmDevolucaoMercadorias.GetContratoPodeDevolver: Boolean;
var
  a: Integer;
begin
  Result:= False;

  qryProdutosContratos.First;
  for a:= 1 to qryProdutosContratos.RecordCount do
  begin
    if qryProdutosContratosdevolver.AsCurrency > 0 then
    begin
      Result:= True;
      break;
    end;
    qryProdutosContratos.Next;
  end;

  if not result then
  begin
    for a:= 1 to qryServicosContratos.RecordCount do
    begin
      if qryServicosContratosdevolver.AsCurrency > 0 then
      begin
        Result:= True;
        break;
      end;
      qryServicosContratos.Next;
    end;
  end;


end;

