{ TdtmExtratoBonus }

constructor TdtmExtratoBonus.Create(AOwner: TComponent);
begin
  inherited;
  qryProcuraClientes.Tag := ctTabelas;
  qryConsultaClientes.Tag := ctCrediarioConsultaClientes;
  qryBonus.Tag := ctCrediarioConsultaContratos;
  qrySaldoAtual.Tag := ctCrediarioConsultaContratos;
  qryProdutosResgate.Tag := ctTabelasConsultaProdutos;
end;

function TdtmExtratoBonus.ExisteClientes(Parametro: Integer;
  NomeCampo: String; Value: Variant): Boolean;
begin
  if NomeCampo = 'nomecidade' then
    NomeCampo:= 'c.nome'
  else
    NomeCampo:= 'cl.' + NomeCampo;
  qryConsultaClientes.Sql[06] := ' Where to_ascii(' + NomeCampo + ',''latin1'') ilike to_ascii(''' + Value + '%'',''latin1'')';

  qryConsultaClientes.Open;
  Result := Not qryConsultaClientes.IsEmpty;
end;

function TdtmExtratoBonus.GerarContrato: Boolean;
begin
  RefazConsulta(qryClientes,[0],[qryProcuraClientescodigo.AsInteger]);
  Result := True;
end;

function TdtmExtratoBonus.GetColunadaGrade: String;
begin
  Result := PrimeiraLetraEmMaiuscula(qryProdutosResgatecoluna.AsString)
end;

function TdtmExtratoBonus.GetLinhadaGrade: String;
begin
  Result := PrimeiraLetraEmMaiuscula(qryProdutosResgatelinha.AsString)
end;

function TdtmExtratoBonus.GetSaldoAtual: Integer;
begin
  Result := qrySaldoAtualsaldoatual.AsInteger;
end;

function TdtmExtratoBonus.GetTabelaConsultaClientes: TtecQuery;
begin
  Result:= qryConsultaClientes;
end;

function TdtmExtratoBonus.GetTotalProdutos: Integer;
begin
  Result := Trunc(TotalizarValores[qryProdutosResgate,qryProdutosResgatebonus, nil]);
end;

procedure TdtmExtratoBonus.MarcarSelecionados(Marcando, Todos: Boolean);
begin
  MarcarRegistros(qryProdutosResgate,
                  qryProdutosResgateselecionar,
                  qryProdutosResgatebonus,
                  Marcando,
                  Todos);
end;

procedure TdtmExtratoBonus.ReFazConsultaBonusCliente(Cliente: Integer; Cancelados: Boolean);
begin
  Fecha(ctCrediarioConsultaContratos);
  Fecha(ctTabelasConsultaProdutos);
  qryBonus.ParamByName('cliente').AsInteger := Cliente;
  qryBonus.ParamByName('data').AsDateTime := DataServidor - ParSistema.ValidadeBonus;

  qrySaldoAtual.ParamByName('cliente').AsInteger := Cliente;

  if Cancelados then
    qryBonus.MacroByName('CANCELADOS').AsString := ''
  else
    qryBonus.MacroByName('CANCELADOS').AsString := 'AND NOT cancelado';
  Abre(ctCrediarioConsultaContratos);
  if qryBonus.RecordCount = 0 then
    MensagemAviso('O cliente não possui registros de bônus.');
end;

function TdtmExtratoBonus.RefazConsultaProdutosResgate: Boolean;
begin
  Result := False;
  if (not qryProdutosResgate.Active) and qryBonus.Active then
  begin
    qryProdutosResgate.ParamByName('SaldoAtual').AsInteger := qrySaldoAtualsaldoatual.AsInteger;
    Abre(ctTabelasConsultaProdutos);
    Result := True;
  end;
end;

procedure TdtmExtratoBonus.Selecionar;
begin
  ReFazConsulta(qryProcuraClientes,[0],[qryConsultaClientesCodigo.AsVariant]);
end;

procedure TdtmExtratoBonus.qryProdutosResgateAfterScroll(
  DataSet: TDataSet);
begin
  inherited;
  if Assigned(OnScrollLinhaColunaGrade) then
    OnScrollLinhaColunaGrade(qryProdutosResgate);
end;

function TdtmExtratoBonus.GravarProdutosSelecionados: Boolean;
var
  Cont: Integer;
  Flag: Boolean;
begin
  Flag := True;
  qryProdutosResgate.DisableControls;
  qryProdutosResgate.First;
  Cont := 0;
  while not qryProdutosResgate.Eof do
  begin
    if qryProdutosResgateselecionar.AsBoolean then
    begin
      dtmCadastroContratos.IncluirProdutosContrato;

      Flag := dtmCadastroContratos.GravarProdutosBonus(qryProdutosResgatecodigo.AsString,
                                                         qryProdutosResgatefilial.AsInteger);

      Inc(Cont);
    end;
    if (Cont < QtdeMarcados) and Flag then
      qryProdutosResgate.Next
    else
      Break;
  end;
  Result := Flag;
end;

function TdtmExtratoBonus.GetQtdeProdutos: Integer;
begin
  Result := qryProdutosResgate.RecordCount;
end;

procedure TdtmExtratoBonus.LimparRegistros;
begin
  QtdeMarcados := 0;
  TotalMarcados:= 0;
end;



procedure TdtmExtratoBonus.ZMonitor1MonitorEvent(Sql, Result: String);
var
 Listar : TStringList;
 arquivo: String;
begin
  inherited;
  Listar := tStringlist.Create;
  arquivo := 'c:\bonus.sql';
  if fileexists(arquivo) then
    Listar.loadfromfile(arquivo);
  Listar.add('');
  Listar.add(sql);
  Listar.add(result);
  listar.savetofile(arquivo);
  listar.free;
end;
end.
