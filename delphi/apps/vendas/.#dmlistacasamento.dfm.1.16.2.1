      '             nome_noivo as nomenoivo,'
      
        '             case when aparecernosite then '#39'Sim'#39' else '#39'N'#227'o'#39' END ' +
        'as Site'
      
        'From     listascasamento l left join clientes c1 ON (l.noiva = c' +
        '1.codigo)'
      
        '                                         left join clientes c2 O' +
