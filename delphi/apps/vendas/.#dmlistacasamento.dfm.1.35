  object qryNaturezasPadrao: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select np.*,'
      '          n.codigofiscal,'
      '          n.tipomovimento,'
      '          n.destacarIPI,'
      '          n.NaoGerarDebitoICMS,'
      '          n.NaoGerarDebitoIPI,'
      '          (select t.operacao'
      '           from tiposmovimentos t'
      '           where t.codigo = n.tipomovimento) as operacao,'
      '          n.piscst,'
      '          n.cofinscst,'
      '          n.ipicst,'
      '          n.icmscst,'
      '          n.csosn'
      
        'from naturezaspadrao np join naturezas n on np.natureza = n.codi' +
        'go'
      'order by descricao')
    RequestLive = False
    Left = 712
    Top = 312
