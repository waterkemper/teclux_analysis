    Sql.Strings = (
      'Select c.nome,'
      '           c.codigo,'
      '           formatar_cpf_cnpj(c.pessoanumero) as pessoanumero,'
      '           c.estado,'
      '           d.nome as nomecidade'
      ''
      'From   clientes c, cidades d'
      '       '
      '/* editada em run time */'
      '/* editada em run time */'
      ''
      '  and (c.estado = d.estado)'
      '  and (c.cidade = d.codigo)'
      'Order By UPPER(TO_ASCII(c.nome,'#39'LATIN1'#39'))')
