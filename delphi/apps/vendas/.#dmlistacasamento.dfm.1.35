    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select   l.codigo, '
      '             l.data,'
      '             nome_noiva as nomenoiva,'
      '             nome_noivo as nomenoivo,'
      
        '             case when aparecernosite then '#39'Sim'#39' else '#39'N'#227'o'#39' END ' +
        'as Site'
      
        'From     listascasamento l left join clientes c1 ON (l.noiva = c' +
        '1.codigo)'
      
        '                                         left join clientes c2 O' +
        'N (l.noivo = c2.codigo)'
      'Order By UPPER(TO_ASCII(l.noiva,'#39'LATIN1'#39'))')
    RequestLive = False
    Left = 468
    Top = 10
