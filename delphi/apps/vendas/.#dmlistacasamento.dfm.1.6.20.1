    Sql.Strings = (
      'Select pl.lista,  '
      '           pl.produto,'
      '           pl.quantidade,'
      '           pl.qtdevendida,'
      '           pl.incluidodepois,'
      '           pl.etiqueta,'
      '           p.descricao,'
      
        '           (select g.descricao from grades g where g.codigo = c.' +
        'grade1) as linha,'
      
        '           (select g.descricao from grades g where g.codigo = c.' +
        'grade2) as coluna,               '
      '           p.valorgrade1,'
      '           p.valorgrade2,'
      '           p.referencia,'
      '           c.grupo,'
      '           g.descricao as descricaogrupo,'
      ''
      '           (select sum(pc.quantidade-coalesce(pc.cancelado,0))'
      
        '            from produtoscontratos pc join contratos ct on pc.co' +
        'ntrato = ct.numero'
      '            where pc.contrato = ct.numero'
      '              and pc.produto = pl.produto'
      '              and pc.listacasamento = pl.lista'
      '              and ct.situacao = '#39'R'#39') as reservado,'
      ''
      '           estoques_preco(pl.produto, :FilialPreco) as preco,'
      
        '            (select aparecernosite from produtos where codigo=pl' +
        '.produto) as aparecernosite,'
      
        '           (select count(*) from fotosprodutos where produto=pl.' +
        'produto) as fotos'
      
        'From   produtoslistacasamento pl , produtos p, caracteristicas c' +
        ', grupos g'
      'Where (pl.lista =:lista) and'
      '           (pl.produto = p.codigo) and'
      '           (p.caracteristica = c.codigo) and'
      '           (c.grupo = g.codigo)'
      'order by pl.produto           ')
    RequestLive = True
