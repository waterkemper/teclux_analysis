      '       join produtoscontratos pc'
      '       on df.contrato = pc.contrato'
      '       and pc.produto = pdf.produto'
      '       and pc.filial = pdf.filial'
      ''
      '  where pc.listacasamento = :listacasamento'
      '    and df.situacao = '#39'N'#39
      ''
      ')'
      'order by pdf.dadofiscal, pdf.numero')
