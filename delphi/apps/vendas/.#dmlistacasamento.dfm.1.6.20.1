      '        pdf.incidencia,'
      '        pdf.unidade,'
      '        pdf.icmsbasecalculo,'
      '        pdf.icmsvalor,'
      '        pdf.dadofiscal'
      'From  produtosdadosfiscais pdf'
      '      join produtos p'
      '           join caracteristicas c'
      '                join  marcas m'
      '                on  c.marca = m.codigo'
      '           on  p.caracteristica = c.codigo'
      '      on  pdf.produto = p.codigo'
      '      '
      'Where  pdf.dadofiscal IN'
      '('
      ''
      '  select distinct pdfsr.dadofiscalsimplesremessa'
      ''
