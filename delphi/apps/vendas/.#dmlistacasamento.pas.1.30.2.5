function TdtmListaCasamento.ProcessarArquivoImportacao(Arquivo: String): boolean;
var
 vArquivo : TStringList;
 vRegistro: TStringList;
 i : integer;
 vCodigoProduto: String;
 vQuantidade : integer;
begin
  result := true;

  vArquivo := tStringlist.create;
  vArquivo.Delimiter := ',';

  vRegistro := tStringlist.create;
  vREgistro.Delimiter := ',';

//  vArquivo.strictdelimiter := true;
//  vArquivo.QuoteChar := '|';


  if fileexists(Arquivo) then
    vArquivo.loadfromfile(Arquivo);

  for i:=0 to vArquivo.Count-1 do
  begin
    vRegistro.clear;
    ExtractStrings([','], [','], pchar(trocar(vArquivo[i],',,',','+quotedstr('')+',')), vRegistro);
    vCodigoProduto := somentenumero(vRegistro[0]);
    if vCodigoProduto='' then
    begin
      MensagemErro('Código do produto inválido');
      result := false;
      break;
    end
    else
    begin
      if somentenumero(vRegistro[1])='' then
      begin
        MensagemErro('Quantidade do produto inválido');
        result := false;
        break;
      end
      else
      begin
        vQuantidade := strtoint(somentenumero(vRegistro[1]));
        if qryProdutosListaCasamento.Locate('produto',vCodigoProduto,[]) then
        begin
          qryProdutosListaCasamento.edit;
          qryProdutosListaCasamentoquantidade.AsFloat := qryProdutosListaCasamentoquantidade.AsFloat +  vQuantidade;
          qryProdutosListaCasamento.post;

          if not (qryListaCasamento.state in [dsedit, dsinsert]) then
            qryListaCasamento.Edit;
        end
        else
        begin
          qryProcuraProdutos.BeforeOpen := nil;
          qryProcuraProdutos.MacroByName('SQLProdutosJaSelecionados').AsString := '';
          RefazConsultaPorNome(qryProcuraProdutos, ['filialpreco', 'codigo'], [filialbase, vCodigoProduto]);
          if qryProcuraProdutos.RecordCount = 0 then
          begin
            MensagemErro(format('Produto %s não cadastrado',[vCodigoProduto]));
            //result := false;
            //break;
          end
          else
          begin
            IncluirProdutosLista(false);
            qryProcuraProdutosAfterOpen(qryProdutosListaCasamento);
            qryProdutosListaCasamentoproduto.AsString := vCodigoProduto;
            qryProdutosListaCasamentoquantidade.AsFloat := vQuantidade;
            qryProdutosListaCasamento.post;
            if not (qryListaCasamento.state in [dsedit, dsinsert]) then
              qryListaCasamento.Edit;

          end;
          qryProcuraProdutos.BeforeOpen := qryProcuraProdutosBeforeOpen;
        end;
      end;
    end;
  end;

  varquivo.free;
  vRegistro.free;

end;




procedure TdtmListaCasamento.AbrirConsultaEtiquetas(filial:integer; serie: string; numeronota: integer; maquina: integer; intervensao: string; numerocupom: integer;
                                                    Contrato: String;
              SelecionarAindanaoImpressas, SelecionarTodososProdutos: boolean; TipoPesquisaEtiquetas: TtecTipoPesquisaEtiquetas);
const
  JOIN_Notas = 'JOIN Notas nc                    ON df.Numero = nc.DadoFiscal';
  SQL_Notas = 'AND  nc.filial = :filial and nc.serie = :serie and nc.numero = :numeronota';

  JOIN_Cupons = 'JOIN Cupons nc                    ON df.Numero = nc.DadoFiscal';
  SQL_Cupons = 'AND  nc.filial = :filial and nc.maquina = :maquina and nc.numero = :numerocupom';
  SQL_Cupons_com_Intervensao = 'AND  nc.filial = :filial and nc.maquina = :maquina and nc.intervensao = :intervensao and nc.numero = :numerocupom';


  OrdenacaoCupomSemIntervensao = 'order by nc.intervensao desc limit 1';


begin
  qryetiquetas.parambyname('SelecionarTodos').asboolean := selecionartodososprodutos;
  if SelecionarAindanaoImpressas then
    qryetiquetas.MacroByName('SelecionarAindanaoImpressas').asstring := 'and not coalesce(plc.Etiqueta,false)'
  else
    qryetiquetas.MacroByName('SelecionarAindanaoImpressas').asstring := '';


  case TipoPesquisaEtiquetas of
  Contratos:
    begin
       qryEtiquetas.Sql.text := qryEtiquetas_CONTRATOS.sql.text;
       qryetiquetas.MacroByName('JOIN_Notas_ou_Cupons_ou_Contratos').AsString := '';
       qryetiquetas.MacroByName('SQL_Notas_ou_Cupons_ou_Contratos').AsString := '';
       qryetiquetas.MacroByName('OrdenacaoCupomSemIntervensao').AsString := '';
       RefazConsultaPorNome(qryetiquetas,['contrato'],[contrato] );
    end;
  notas:
    begin
       qryEtiquetas.Sql.text := qryEtiquetas_NOTAS_OU_CUPONS.sql.text;
       qryetiquetas.MacroByName('JOIN_Notas_ou_Cupons_ou_Contratos').AsString := JOIN_Notas;
       qryetiquetas.MacroByName('SQL_Notas_ou_Cupons_ou_Contratos').AsString := SQL_Notas;
       qryetiquetas.MacroByName('OrdenacaoCupomSemIntervensao').AsString := '';
       RefazConsultaPorNome(qryetiquetas,['filial','serie', 'numeronota', 'eHPorNota'],[filial, Serie, numeronota, true] );
    end;
  Cupons:
    begin
       qryEtiquetas.Sql.text := qryEtiquetas_NOTAS_OU_CUPONS.sql.text;
       qryetiquetas.MacroByName('JOIN_Notas_ou_Cupons_ou_Contratos').AsString := JOIN_Cupons;
       qryetiquetas.MacroByName('OrdenacaoCupomSemIntervensao').AsString := OrdenacaoCupomSemIntervensao;
       if intervensao = '' then
       begin
         qryetiquetas.MacroByName('SQL_Notas_ou_Cupons_ou_Contratos').AsString := SQL_Cupons;
         RefazConsultaPorNome(qryetiquetas,['filial','maquina', 'numerocupom', 'eHPorNota'],[filial, maquina, numerocupom, false]);
       end
       else
       begin
         qryetiquetas.MacroByName('SQL_Notas_ou_Cupons_ou_Contratos').AsString := SQL_Cupons_com_Intervensao;
         RefazConsultaPorNome(qryetiquetas,['filial','maquina', 'intervensao', 'numerocupom', 'eHPorNota'],[filial, maquina, intervensao, numerocupom, false]);
       end;
    end;
  end;



  if qryEtiquetas.IsEmpty then
    MensagemAviso(format(ctNENHUMREGISTROENCONTRADO,['registro']));


  if SelecionarTodososProdutos then
    QtdeMarcados := qryEtiquetas.RecordCount
  else
    QtdeMarcados := 0;

end;

procedure TdtmListaCasamento.MarcarSelecionados(Marcando, Todos: Boolean);
begin
  qryEtiquetas.DisableControls;
  MarcarRegistros(qryEtiquetas,qryEtiquetasMarcar, Marcando, Todos);
  qryEtiquetas.EnableControls;
end;

procedure TdtmListaCasamento.qryListaCasamentoCalcFields(
  DataSet: TDataSet);
begin
  inherited;

  qryListaCasamentorua_nr_compl.AsString := trim(qryListaCasamentorua.AsString) +
              ifthen(qryListaCasamentonumero.AsInteger<>0, ', '+qryListaCasamentonumero.AsString, '') +
              ifthen(trim(qryListaCasamentocomplemento.AsString)<>'', ' - '+qryListaCasamentocomplemento.AsString, '');

end;

procedure TdtmListaCasamento.qryProdutosListaCasamentoImpCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  qryProdutosListaCasamentoImpdescricaolc.AsString :=
    qryProdutosListaCasamentoimpdescricao.AsString+' '+
    qryProdutosListaCasamentoimpvalorgrade1.AsString+' '+
    qryProdutosListaCasamentoimpvalorgrade2.AsString;

  qryProdutosListaCasamentoImpsaldo.asfloat := qryProdutosListaCasamentoImpquantidade.asfloat -
                                               qryProdutosListaCasamentoImpqtdevendida.asfloat;


end;

procedure TdtmListaCasamento.ExcluirContratosLista;
var
  vProduto : String;
begin
  if MensagemConfirmacao(Format(ctCONFIRMEEXCLUIR, ['o CONTRATO deste produto da lista de casamento'])) = smbOk then
  begin
    qryUpdateProdutosContratos.ParamByName('listacasamento').clear;
    qryUpdateProdutosContratos.ParamByName('contrato').asstring := qryContratosListaCasamentocontrato.AsString;
    qryUpdateProdutosContratos.ParamByName('produto').asstring := qryContratosListaCasamentoproduto.AsString;
    qryUpdateProdutosContratos.ExecSql;
    perpetrar([qryUpdateProdutosContratos]);
    vProduto := qryContratosListaCasamentoproduto.AsString;
    qryListaCasamentoAfterScroll(qryListaCasamento);
    qryProdutosListaCasamento.Locate('produto', vproduto, []);
  end;
end;

procedure TdtmListaCasamento.qryContratosListaCasamentoAfterScroll(
  DataSet: TDataSet);
begin
  inherited;
  RefazConsultaPorNome(qryNotasListaCasamento,['contrato'],[qryContratosListaCasamentocontrato.AsString]);
  RefazConsultaPorNome(qryCuponsListaCasamento,['contrato'],[qryContratosListaCasamentocontrato.AsString]);
end;

procedure TdtmListaCasamento.qryListaCasamentoNewRecord(DataSet: TDataSet);
begin
  inherited;
  qryListaCasamentodata_de_criacao.AsDateTime := DataHoraServidor;
  qryListaCasamentoquem_criou.AsInteger := UsuarioLogin.CodigoUsuario;
  qryListaCasamentocriada_onde.AsString := 'TECLUX';
  qryListaCasamentonomeusuario_quem_criou.AsString := UsuarioLogin.NomeUsuario; 

end;

function TdtmListaCasamento.GetCondicaoEmissorNFE: Boolean;
begin
  if qryDadosFiscais.recordcount <> 0 then
    fCondicaoEmissorNFE := parsistema.EmissorNfe and
                           ((qryDadosFiscaismodelodocto.AsString = '55') or
                            (qryDadosFiscaismodelodocto.AsString = '57'))
  else
    fCondicaoEmissorNFE := parsistema.EmissorNfe and
                           ((ModeloDoctoFiscal = '55') or
                            (ModeloDoctoFiscal = '57'));

  Result := fCondicaoEmissorNFE;
end;

end.
