constructor TdtmListaCasamento.Create(AOwner: TComponent);
begin
  inherited;
  qryListaCasamento.Tag         := ctTabelas;
  qryProdutosListaCasamento.Tag := ctTabelas;
  qryListaPadrao.Tag            := ctTabelas;
  qryConsultaListas.Tag         := ctPesquisaListaCasamento;
  qryConsultaClientes.Tag       := ctPesquisaClientes;
  qryConsultaProdutos.Tag       := ctPesquisaProdutos;
  qryProdutosListaCasamento.ParamByName('FilialPreco').AsInteger := FilialBase;
  qryProcuraProdutos.ParamByName('FilialPreco').AsInteger := FilialBase;
  qryProdutosListaPadrao.ParamByName('FilialPreco').AsInteger := FilialBase;
  FItensdeProdutosNaoSalvos := False;
  qryProdutosListaCasamentoquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosListaCasamentoqtdevendida.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosListaCasamentoreservado.DisplayFormat := ParSistema.MascaraQuantidadeGrade;

  qrySaldosProdutosSimplesRemessaquantidadenotafiscalvenda.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qrySaldosProdutosSimplesRemessaquantidadenotafiscalsimplesremessa.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qrySaldosProdutosSimplesRemessaquantidadelistacasamento.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qrySaldosProdutosSimplesRemessaqtdevendida.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qrySaldosProdutosSimplesRemessaquantidadeaentregar.DisplayFormat := ParSistema.MascaraQuantidadeGrade;

  qryProdutosNotaSimplesRemessaquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;

  qryProdutosEtiquetasquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
end;

function TdtmListaCasamento.GetTabelaListasCasamento: TtecQuery;
begin
  Result := qryListaCasamento;
end;

function TdtmListaCasamento.GetConsultarListas: TtecQuery;
begin
  Result := qryConsultaListas;
end;

function TdtmListaCasamento.GetConsultarClientes: TtecQuery;
begin
  Result := qryConsultaClientes;
end;

function TdtmListaCasamento.ExisteLista(Campo, Codigo: string): Boolean;
begin
  Result := ExisteCodigo(qryConsultaListas, Campo, Codigo);
end;

function TdtmListaCasamento.ExisteCliente(Campo, Codigo: string): Boolean;
begin
  if Campo = 'nomecidade' then
       Campo:= 'd.nome'
  else Campo:= 'c.' + Campo;
  qryConsultaClientes.Sql[8] := 'Where Maiusculo(' + Campo + ') ilike Maiusculo(''' + Codigo + '%'') ';
  qryConsultaClientes.Open;
  Result:= not qryConsultaClientes.IsEmpty;
end;

function TdtmListaCasamento.ExisteProduto(Campo, Codigo: string): Boolean;
const
  SQL = 'Where (to_ascii(p.%s,''latin1'') ilike to_ascii(''%s%s'',''latin1''))';
begin
  qryConsultaProdutos.MacroByName('SQLProduto').AsString :=
    Format(SQL, [Campo, Codigo, '%']);
  qryConsultaProdutos.close;
  qryConsultaProdutos.Open;
  Result := (qryConsultaProdutos.RecordCount > 0);
end;

procedure TdtmListaCasamento.AbreTabelaPesquisa(TipoPesquisa: TtecListaCasamento);
begin
  case TipoPesquisa of
 tlcLISTAPADRAO: qryConsultaListasPadrao.Open;
    tlcPRODUTOS: begin
                   qryConsultaProdutos.MacroByName('SQLProduto').AsString:=
                       'Where (p.codigo = 0)';
                   qryConsultaProdutos.close; 
                   qryConsultaProdutos.Open;
                 end;
      tlcLISTAS: Abre(ctPesquisaListaCasamento);
       tlcNOIVA: begin
                   qryConsultaClientes.Sql[8]:= 'Where (c.codigo = 0)';
                   qryConsultaClientes.Sql[9]:= 'and   (c.sexo = ''F'')';
                   qryConsultaClientes.Open;
                 end;
       tlcNOIVO: begin
                   qryConsultaClientes.Sql[8]:= 'Where (c.codigo = 0)';
                   qryConsultaClientes.Sql[9]:= 'and   (c.sexo = ''M'')';
                   qryConsultaClientes.Open;
                 end;
  end;
end;

procedure TdtmListaCasamento.FechaTabelaPesquisa(TipoPesquisa: TtecListaCasamento);
begin
  case TipoPesquisa of
 tlcLISTAPADRAO: qryConsultaListasPadrao.Close;
    tlcPRODUTOS: Fecha(ctPesquisaProdutos);
      tlcLISTAS: Fecha(ctPesquisaListaCasamento);
       tlcNOIVA,
       tlcNOIVO: Fecha(ctPesquisaClientes);
  end;
end;

procedure TdtmListaCasamento.Selecionar(TipoPesquisa: TtecListaCasamento);
begin
  case TipoPesquisa of
 tlcLISTAPADRAO: ReFazConsulta(qryListaPadrao,[0],[qryConsultaListasPadraocodigo.AsInteger]);
    tlcPRODUTOS: begin
                   qryProdutosListaCasamento.Edit;
                   qryProdutosListaCasamentoproduto.AsLargeInt := qryConsultaProdutoscodigo.AsLargeInt;
                 end;
      tlcLISTAS: ReFazConsulta(qryListaCasamento,[0],[qryConsultaListascodigo.AsInteger]);
       tlcNOIVA: begin
                   qryListaCasamento.Edit;
                   qryListaCasamentonoiva.AsInteger    := qryConsultaClientescodigo.AsInteger;
                   if(qryConsultaClientescodigo.AsString<>'') then
                           RefazConsulta(qryUsuarioListaCasamento,[0],[qryConsultaClientescodigo.AsInteger]);
                 end;
       tlcNOIVO: begin
                   qryListaCasamento.Edit;
                   qryListaCasamentonoivo.AsInteger:= qryConsultaClientescodigo.AsInteger;
                   qryListaCasamentonome_noivo.AsString := qryConsultaClientesnome.AsString;
                   qryListaCasamentonomenoivo.AsString := qryConsultaClientesnome.AsString;
                 end;
  end;
end;

function TdtmListaCasamento.IncluirListaCasamento: Boolean;
begin
  Result := True;
  qryListaCasamento.Insert;
  qryListaCasamentoaparecernosite.AsBoolean:=false;
end;

function TdtmListaCasamento.IncluirProdutosLista(Editar: Boolean): Boolean;
begin
  if Editar and not qryProdutosListaCasamento.IsEmpty then begin
    qryProdutosListaCasamento.ParamByName('lista').AsInteger:= qryListaCasamentocodigo.AsInteger;
    qryProdutosListaCasamento.DisableControls;
    qryProdutosListaCasamento.Edit;
    qryProdutosListaCasamento.Cancel;
    qryProdutosListaCasamento.EnableControls;
  end
  else begin
    qryProdutosListaCasamento.ParamByName('lista').clear;
    qryProdutosListaCasamento.Append;
    qryProdutosListaCasamentoquantidade.AsCurrency:= 1;
  end;
  Result := True;
end;

function TdtmListaCasamento.ExcluirListaCasamento: Boolean;
begin
  Result := MensagemConfirmacao(Format(ctCONFIRMEEXCLUIR, ['a LISTA DE CASAMENTO'])) = smbOk;
  if Result then begin
    if not qryListaCasamento.IsEmpty then begin
      qryListaCasamento.Delete;
      Perpetrar([qryListaCasamento]);
    end;
  end;
end;

function TdtmListaCasamento.ExcluirProdutosLista: Boolean;
begin
  Result := MensagemConfirmacao(Format(ctCONFIRMEEXCLUIR, ['o PRODUTO'])) = smbOk;
  if Result then begin
    if not qryProdutosListaCasamento.IsEmpty then
         qryProdutosListaCasamento.Delete
    else qryProdutosListaCasamento.Cancel;
  end;
end;

function TdtmListaCasamento.GravarListaCasamento: Boolean;
begin
  Result := False;
  if qryListaCasamento.CheckRequiredFields then begin
    if qryProdutosListaCasamento.IsEmpty then
      MensagemAviso(Format(ctNENHUMPRODUTONALISTA,['de casamento']))
    else begin
      if qryListaCasamento.State = dsInsert then begin
        spcListaCasamento.Open;
        qryListaCasamentocodigo.AsInteger := spcListaCasamentocodigo.AsInteger;
        spcListaCasamento.Close;
      end;

      qryProdutosListaCasamento.DisableControls;
      try
        qryProdutosListaCasamento.First;
        while not qryProdutosListaCasamento.Eof do begin
          if (qryProdutosListaCasamentolista.AsInteger = 0) then begin
            qryProdutosListaCasamento.Edit;
            qryProdutosListaCasamentolista.Value := qryListaCasamentocodigo.Value;
            qryProdutosListaCasamento.Post;
          end;
          qryProdutosListaCasamento.Next;
        end;
      finally
        qryProdutosListaCasamento.EnableControls;
      end;

//      qryListaCasamentonome_noiva.AsString := qryProcuraNoivanome.AsString;
//      qryListaCasamentonome_noivo.AsString := qryProcuraNoivonome.AsString;
      qryListaCasamento.Post;

      Perpetrar([qryListaCasamento, qryProdutosListaCasamento]);
      ReFazConsulta(qryListaCasamento, [0], [qryListaCasamentocodigo.AsVariant]);
      FItensdeProdutosNaoSalvos := False;
      Result:= True;
    end;
//    ReFazConsulta(qryProdutosListaCasamento,[0],[qryListaCasamentocodigo.Value]);
  end;
end;

function TdtmListaCasamento.GravarProdutosLista: Boolean;
begin
  Result:= False;
  if qryProdutosListaCasamento.CheckRequiredFields then begin
    if qryProdutosListaCasamento.State = dsinsert then
      FItensdeProdutosNaoSalvos := True;

    qryProdutosListaCasamento.Post;
    if not (qryListaCasamento.State in [dsEdit]) then
      qryListaCasamento.Edit;
    Result := True;
  end;
end;

