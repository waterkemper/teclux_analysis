procedure TdtmListaCasamento.SelecionarProdutosListaPadrao;
Var
  Prod: String;
begin
  Prod:= '';
  if qryProdutosListaCasamento.RecordCount > 0 then begin
    qryProdutosListaCasamento.First;
    while not qryProdutosListaCasamento.Eof do begin
      Prod:= Prod + qryProdutosListaCasamentoproduto.AsString + ',';
      qryProdutosListaCasamento.Next;
    end;
    Delete(Prod,Length(Prod),1);
  end;
  if Prod = '' then Prod:= '0';
  qryProdutosListaPadrao.macrobyname('ListaJaCadastrados').AsString := 'and not (pl.produto in (' + Prod + '))';
  qryProdutosListaPadrao.ParamByName('lista').AsInteger:= qryListaPadraocodigo.AsInteger;
  qryProdutosListaPadrao.close;
  qryProdutosListaPadrao.Open;
