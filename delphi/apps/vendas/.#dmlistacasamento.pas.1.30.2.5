procedure TdtmListaCasamento.ImprimirListaCasamento(ImprimirPrecoProduto, SepararProdutosVendidos: Boolean; ordenacao: integer);
var
  Relatorio: TfrReport;
  frmPreview: TfrmPreviewPadrao;
begin

  if SepararProdutosVendidos then
    qryProdutosListaCasamentoImp.sql.text := qryProdutosListaCasamentoImp_SEPARAR_VENDIDOS.sql.text
  else
    qryProdutosListaCasamentoImp.sql.text := qryProdutosListaCasamentoImp_NAOSEPARAR_VENDIDOS.sql.text;


  case ordenacao of
  0: qryProdutosListaCasamentoImp.macrobyname('ordenacao').asstring :=  'order by SituacaoVenda, classe, descricaoclasse, grupo, descricaogrupo, produto, descricao';
  1: qryProdutosListaCasamentoImp.macrobyname('ordenacao').asstring :=  'order by SituacaoVenda, descricao, produto';
  2: qryProdutosListaCasamentoImp.macrobyname('ordenacao').asstring :=  'order by SituacaoVenda, produto, descricao';

  end;

  RefazConsultaPorNome(qryProdutosListaCasamentoimp,['FilialPreco','lista'],[FilialBase, qryListaCasamentocodigo.AsInteger]);

  frVariables['ordenacao']   := ordenacao;

  frVariables['Rua']   := RuaFilialBase;
  frVariables['Bairro']:= BairroFilialBase + ' - CEP: ' + CEPFilialBase;
  frVariables['Cidade']:= CidadeFilialBase + ' - ' + EstadoFilialBase;
  frVariables['Fone']  := FoneFilialBase;
  frVariables['ImprimirPrecoProduto']  := ImprimirPrecoProduto;
  frVariables['SepararProdutosVendidos']  := SepararProdutosVendidos;


//  frpListaCasamento.DesignReport;
  frmPreview := TfrmPreviewPadrao.create(self);

  try
    Relatorio := frmPreview.frCompositeReport;
    with frmPreview do begin
      frCompositeReport.Reports.Clear;
      frCompositeReport.Reports.Add(frpListaCasamento);
    end;
    Relatorio.Preview := frmPreview.frPreviewPadrao;
    Relatorio.ShowReport;
    frmPreview.ShowModal;
  finally
    frmPreview.Free;
  end;
end;

