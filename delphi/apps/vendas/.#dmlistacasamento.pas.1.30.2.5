  qryDadosFiscaisfonenumero.AsInteger       := qryListaCasamentofonenumero.AsInteger;
  qryDadosFiscaisfoneddd.AsInteger          := qryListaCasamentofoneddd.AsInteger;
  qryDadosFiscaisdocumento.AsString         := qryListaCasamentoiddocumento.AsString;
  qryDadosFiscaisviatransporte.AsString     := 'R';
  qryDadosFiscaisobservacoes.AsString       := qryListaCasamentoobservacoes.AsString;

  qrydadosfiscaisnosimples.asboolean        := qryListaCasamentonosimples.asboolean;

  qryDadosFiscaiscliente.AsInteger := qryListaCasamentonoiva.AsInteger;
  qryDadosFiscaisnome.AsString := qryListaCasamentonome_noiva.AsString;

  qryDadosFiscaistipocliente.AsString  := 'C';

  qryDadosFiscaisemail.AsString        := qryListaCasamentoemail.AsString;
  qryDadosFiscaissuframa.AsString      := qryListaCasamentosuframa.AsString;

  qryDadosFiscaisobscliente.AsString  := qryListaCasamentoobsnotafiscal.AsString;
  qryDadosFiscaisobsclienteipisuspenso.AsString:= qryListaCasamentoobsipisuspenso.AsString;

  qryDadosFiscaisdebitar.AsVariant   := qryListaCasamentodebito.AsVariant;

  qryDadosFiscaislocalentrega_rua.AsString         := qryListaCasamentorefrua.AsString;
  qryDadosFiscaislocalentrega_numero.AsString      := qryListaCasamentorefnumero.AsString;
  qryDadosFiscaislocalentrega_complemento.AsString := qryListaCasamentorefcomplemento.AsString;
  qryDadosFiscaislocalentrega_bairro.AsString      := qryListaCasamentorefbairro.AsString;
  qryDadosFiscaislocalentrega_nomebairro.AsString  := qryListaCasamentorefnomebairro.AsString;
  qryDadosFiscaislocalentrega_cidade.AsString      := qryListaCasamentorefcidade.AsString;
  qryDadosFiscaislocalentrega_nomecidade.AsString  := qryListaCasamentorefnomecidade.AsString;
  qryDadosFiscaislocalentrega_estado.AsString      := qryListaCasamentorefestado.AsString;
