  qryDadosFiscaislocalretirada_cnpj.AsString       := qryListaCasamentopessoanumero.AsString;

  if qryListaCasamentoestado.AsString='.' then {estrangeiro}
  begin
    qryDadosFiscaispais.AsInteger                    := qryListaCasamentocidadeibge.AsInteger;
    qryDadosFiscaisnomepais.AsString                 := qryListaCasamentonomecidade.AsString;;

    qryDadosFiscaisrua.AsString                      := qryListaCasamentorua.AsString;
    qryDadosFiscaisendnumero.AsString                := qryListaCasamentonumero.AsString;
    qryDadosFiscaisendcomplemento.AsString           := qryListaCasamentocomplemento.AsString;
    qryDadosFiscaisbairro.AsInteger                  := qryListaCasamentobairro.AsInteger;

    //qryDadosFiscaisnomebairro.AsString               := ConsultaOSP.qryProcuraClientenomebairro.AsString;
    qryDadosFiscaiscidade.AsInteger                  := qryListaCasamentocidade.AsInteger;
    qryDadosFiscaisnomecidade.AsString               := qryListaCasamentonomebairro.AsString;
    //qryDadosFiscaiscidadeibge.AsString             := ConsultaOSP.qryProcuraClientecidadeibge.AsString;
    qryDadosFiscaisestado.AsString                   := qryListaCasamentoestado.AsString;
    //qryDadosFiscaiscep.AsInteger                     := ConsultaOSP.qryProcuraClientecep.AsInteger;
  end
  else
  begin
    qryDadosFiscaispais.AsInteger                    := 1058;
    qryDadosFiscaisnomepais.AsString                 := 'Brasil';
    qryDadosFiscaisrua.AsString                      := qryListaCasamentorua.AsString;
    qryDadosFiscaisendnumero.AsString                := qryListaCasamentonumero.AsString;
    qryDadosFiscaisendcomplemento.AsString           := qryListaCasamentocomplemento.AsString;
    qryDadosFiscaisbairro.AsInteger                  := qryListaCasamentobairro.AsInteger;

    qryDadosFiscaisnomebairro.AsString               := qryListaCasamentonomebairro.AsString;
    qryDadosFiscaiscidade.AsInteger                  := qryListaCasamentocidade.AsInteger;
    qryDadosFiscaisnomecidade.AsString               := qryListaCasamentonomecidade.AsString;;

    qryDadosFiscaiscidadeibge.AsString               := qryListaCasamentocidadeibge.AsString;
    qryDadosFiscaisestado.AsString                   := qryListaCasamentoestado.AsString;
    qryDadosFiscaiscep.AsInteger                     := qryListaCasamentocep.AsInteger;
  end;

  i:= 1;
  qrySaldosProdutosSimplesRemessa.First;
  while not qrySaldosProdutosSimplesRemessa.Eof do
  begin
    if qrySaldosProdutosSimplesRemessaquantidadeaentregar.AsCurrency <> 0 then
    begin
      qryProdutosDadosFiscais.Append;
      qryProdutosDadosFiscais.fieldbyname('dadofiscal').AsInteger   := qryDadosFiscaisnumero.AsInteger;
      qryProdutosDadosFiscais.fieldbyname('numero').AsInteger       := I;
      qryProdutosDadosFiscais.fieldbyname('produto').AsString       := qrySaldosProdutosSimplesRemessaproduto.AsString;
      qryProdutosDadosFiscais.fieldbyname('filial').AsInteger       := filialbase;
      qryProdutosDadosFiscais.fieldbyname('quantidade').AsCurrency  := qrySaldosProdutosSimplesRemessaquantidadeaentregar.AsCurrency;
      qryProdutosDadosFiscais.fieldbyname('precovenda').AsFloat     := qrySaldosProdutosSimplesRemessaprecovenda.AsFloat;
      qryProdutosDadosFiscais.fieldbyname('tribquantidade').AsCurrency := qryProdutosDadosFiscais.fieldbyname('quantidade').AsCurrency;
      qryProdutosDadosFiscais.fieldbyname('tribunitario').AsCurrency := qryProdutosDadosFiscais.fieldbyname('precovenda').AsFloat;
      qryProdutosDadosFiscais.fieldbyname('precotabela').AsFloat    := qrySaldosProdutosSimplesRemessaprecovenda.AsFloat;
      qryProdutosDadosFiscais.fieldbyname('codigofiscal').AsInteger := qryDadosFiscaiscodigofiscal.AsInteger;
      qryProdutosDadosFiscais.fieldbyname('natureza').AsInteger     := qryDadosFiscaiscodigonatureza.AsInteger;
      qryProdutosDadosFiscais.fieldbyname('incidencia').AsString    := qryNaturezasPadraoicmscst.AsString;
      qryProdutosDadosFiscais.fieldbyname('piscst').AsString        := qryNaturezasPadraopiscst.AsString;
      qryProdutosDadosFiscais.fieldbyname('cofinscst').AsString     := qryNaturezasPadraocofinscst.AsString;
      qryProdutosDadosFiscais.fieldbyname('ipicst').AsString        := qryNaturezasPadraoipicst.AsString;
      qryProdutosDadosFiscais.fieldbyname('csosn').AsString         := qryNaturezasPadraocsosn.AsString;




      AtribuirDadosProdutos(qryProdutosDadosFiscais, qryDadosFiscais, nil, false, NotaListaCasamento);
      qryProdutosDadosFiscais.Post;

      vSaldo := qryProdutosDadosFiscais.fieldbyname('quantidade').AsCurrency;


      qryNotasVendas.First;
      while not qryNotasVendas.Eof do
      begin
        qryProdutosDadosFiscaisSimplesRemessa.Append;
        qryProdutosDadosFiscaisSimplesRemessadadofiscalvenda.AsInteger := qryNotasVendasdadofiscal.AsInteger;
        qryProdutosDadosFiscaisSimplesRemessanumeroprodutodadofiscalvenda.AsInteger := qryNotasVendasnumero.AsInteger;
        qryProdutosDadosFiscaisSimplesRemessaprodutodadofiscalvenda.asstring := qryNotasVendasproduto.AsString;

        qryProdutosDadosFiscaisSimplesRemessadadofiscalsimplesremessa.AsInteger := qryProdutosDadosFiscais.fieldbyname('dadofiscal').AsInteger;
        qryProdutosDadosFiscaisSimplesRemessanumeroprodutodadofiscalsimplesremessa.AsInteger := qryProdutosDadosFiscais.fieldbyname('numero').AsInteger;
        qryProdutosDadosFiscaisSimplesRemessaprodutodadofiscalsimplesremessa.asstring := qryProdutosDadosFiscais.fieldbyname('produto').asString;

        if vsaldo >= qryNotasVendassaldoaentregar.AsFloat then
        begin
          qryProdutosDadosFiscaisSimplesRemessaquantidade.AsFloat := qryNotasVendassaldoaentregar.AsFloat;
          vsaldo := vSaldo - qryNotasVendassaldoaentregar.AsFloat;
        end
        else
        begin
         qryProdutosDadosFiscaisSimplesRemessaquantidade.AsFloat := vsaldo;
         vSaldo := 0;
        end;

        if qryNotasVendasnumerocupom.asinteger<>0 then
        begin
          if not qryNotasCuponsRef.Locate('maquina;intervensao;numerocupom',
               VarArrayOf([qryNotasVendasmaquina.asinteger,
                          qryNotasVendasintervensao.AsInteger,
                          qryNotasVendasnumerocupom.AsInteger]),[]) then
          begin
            qryNotasCuponsRef.Append;
            qryNotasCuponsRefmaquina.AsInteger := qryNotasVendasmaquina.AsInteger;
            qryNotasCuponsRefintervensao.asinteger := qryNotasVendasintervensao.AsInteger;
            qryNotasCuponsRefnumerocupom.AsInteger := qryNotasVendasnumerocupom.AsInteger;
            qryNotasCuponsRef.Post;

            vObsCuponsReferenciados := vObsCuponsReferenciados +
                '[ CF: M' + qryNotasVendasmaquina.Asstring +
                '  I' + qryNotasVendasintervensao.AsString +
                '  N' + qryNotasVendasnumerocupom.AsString + ' ]' + sLineBreak;
          end;
        end
        else
        begin
          if not qryNotasCuponsRef.Locate('serie;numeronota',
               VarArrayOf([qryNotasVendasserie.asstring,
                          qryNotasVendasnumeronota.AsInteger]),[]) then
          begin
            qryNotasCuponsRef.Append;
            qryNotasCuponsRefserie.AsString := qryNotasVendasserie.AsString;
            qryNotasCuponsRefnumeronota.AsInteger := qryNotasVendasnumeronota.AsInteger;
            qryNotasCuponsRef.Post;

            vObsNFReferenciadas := vObsNFReferenciadas +
            '[ NF: S' + qryNotasVendasserie.AsString +
            '  N' + qryNotasVendasnumeronota.AsString + ' ]' + sLineBreak;
          end;
        end;

        qryProdutosDadosFiscaisSimplesRemessa.post;

        if vSaldo = 0 then
          break
        else
          qrynotasVendas.Next;
      end;
      inc(I);
    end;
    qrySaldosProdutosSimplesRemessa.Next;
  end;

  qryDadosFiscaisdesconto.AsCurrency := 0;
  result := CalcularImpostos(qryprodutosdadosfiscais, qrydadosfiscais, contribipi, true, true, nil, nil, false, NotaListaCasamento, false, contribicms, nil);

  if result then
  begin

    ReFazConsulta(qrySeriesFiliais, [0,1], [FilialBase, SerieSugestao]);

    if (qrySeriesFiliaisnumeroinicial.AsInteger + 1) > qrySeriesFiliaisnumerofinal.AsInteger then
      Result := MensagemAviso(Format(ctSERIEESGOTADA, [qrySeriesFiliaisnumerofinal.AsString]) + sLineBreak + ctCONFIRMEINPRESSAO) = smbOK;

    if result then
    begin
      result := VerificaNotaFiscalJaCadastrada;

      if result then
      begin

        qryDadosFiscaisobservacoes.AsString := vObsNFReferenciadas + vObsCuponsReferenciados;

        spcDadosFiscaisProximo.Open;
        qryDadosFiscaisnumero.AsInteger           := spcDadosFiscaisProximonumero.AsInteger;
        qryDadosFiscais.Post;
        spcDadosFiscaisProximo.Close;

        qryNotas.close;
        qryNotas.Open;

        qryNotas.Append;
        qryNotasfilial.AsInteger     := FilialBase;
        qryNotasserie.AsString       := SerieSugestao;
        qryNotasnumero.AsInteger     := qrySeriesFiliaisnumeroinicial.AsInteger;
        qryNotasdadofiscal.AsInteger := qryDadosFiscaisnumero.AsInteger;
        qryNotas.Post;

        qrySeriesFiliais.Edit;
        qrySeriesFiliaisnumeroinicial.AsInteger := qrySeriesFiliaisnumeroinicial.AsInteger + 1;
        qrySeriesFiliais.Post;

        AtribuirChave(qryprodutosdadosfiscais,[qryProdutosDadosFiscais.FieldByName('dadofiscal')],[qryDadosFiscaisnumero],true);
        AtribuirChave(qryProdutosDadosFiscaisSimplesRemessa,[qryProdutosDadosFiscaisSimplesRemessadadofiscalsimplesremessa],[qryDadosFiscaisnumero],true);


        if CondicaoEmissorNFE then
            result := EmitirNFE(true);

        if result then
        begin
          result :=  Perpetrar([qryDadosFiscais, qryNotas, qryProdutosDadosFiscais, qrySeriesFiliais,
             qryProdutosDadosFiscaisSimplesRemessa]);

          if result then
          begin
            if not CondicaoEmissorNFE then
            begin
              if MensagemConfirmacao(ctIMPRIMIRNOTASIMPLESREMESSA) = smbOK then
                ImprimirNotaFiscal
            end
            else
              result := EmitirNFE;
          end;
        end;
      end;
    end;
  end;
end;

procedure TdtmListaCasamento.ImprimirNotaFiscal;
begin
  dtmImprimeFiscal := TdtmImprimeFiscal.Create(Self);
  try
    dtmImprimeFiscal.ImprimirNota(qryDadosFiscaisnumero.AsInteger, qrySeriesFiliaismodelonota.AsInteger);
  finally
    dtmImprimeFiscal.Free;
    dtmImprimeFiscal := nil;
  end;
end;

function TdtmListaCasamento.SelecionarProdutosImprimir: Boolean;
begin
  RefazConsultaPorNome(qrySaldosProdutosSimplesRemessa,['filialbase','listacasamento'],
     [filialbase, qryListaCasamentocodigo.AsInteger]);
  Result:= qrySaldosProdutosSimplesRemessa.IsEmpty;
end;

function TdtmListaCasamento.GetPodeImprimir: Boolean;
begin
  Result:= not qryListaCasamento.IsEmpty and not (qryListaCasamento.State in [dsEdit,dsInsert]);
end;

function TdtmListaCasamento.SelecionarEtiquetasImprimir: Boolean;
begin
  ReFazConsulta(qryProdutosEtiquetas,[0],[qryListaCasamentocodigo.AsInteger]);
  Result:= qryProdutosEtiquetas.IsEmpty;
end;



procedure TdtmListaCasamento.ImprimirEtiquetasZebraTLP2844(Tipo: string; Modelo: string; NrColunas: integer;
                                                           TipoPesquisaEtiquetas: TtecTipoPesquisaEtiquetas);
{============= D I C A   I M P O R T A N T E =============}
{                                                         }
{  Nas impressoras ZEBRA,  todas as medidas são em dots,  }
{ sendo que 1 mm = 8 dots.                                }
{=========================================================}

(*
begin
  MensagemAviso('eM DESENVOLVIMENTO');
  // Imprimir as Etiquetas.
*)


var

  Col, NL, NC: byte;
  X, Y, NP:    integer;
  Linhas:      array[1..15,1..1] of string;
  Rua:         string;


begin
   NomeImpressoraEscolhida := ParSistema.NomeImpressoraEtiqueta;

{------------------------------------------- FRETTA HOME CENTER ---------------
N
q800
Q480,24+0
S2
D7
ZT
O
A736,200,1,3,2,1,N,"LISTA DE CASAMENTO"
A696,272,1,3,2,1,N,"Nr 99"
A624,8,1,2,1,1,N,"MARCELA DAIANA VICENTE SANTIAGO2....38"
A592,8,1,2,1,1,N,"R SALDANHA DA GAMA 804..5...30....5.38"
A572,8,1,2,1,1,N,"COMERCIARIO...5...20....5...30....5.38"
A552,8,1,2,1,1,N,"CRICIUMA - SC.5...20....5...30....5.38"
A500,8,1,2,1,1,N,"CONVIDADO:ESTER DE SOUZA DAMAZIO"
A470,8,1,2,1,1,N,"CONTRATO: 413304"
A440,8,1,2,1,1,N,"DATA: 09/10/2013"
A376,8,1,3,2,1,N,"TRAVESSA OXFORD REFRAT FUNDA 41X"
B336,160,1,1,2,2,45,B,"54232110"
A208,8,1,2,1,1,N,"CONTRATO: 413304"
A178,8,1,2,1,1,N,"Nr LISTA:    99"
A140,8,1,3,2,1,N,"TRAVESSA OXFORD REFRAT FUNDA 41X"
B100,160,1,1,2,2,45,B,"54232110"
P1
}
   if Tipo = 'FH' then begin
      case NrColunas of

      1: if Modelo = 'L'           // [L]ista de casamento
         then with TextPrinter do begin     //         60 x 100 mm
            try
               Col := 0;    FillChar(Linhas,SizeOf(Linhas),0);
               qryEtiquetas.First;
               while not qryEtiquetas.EOF do begin
                  if qryEtiquetasMarcar.AsBoolean then begin

                    qryEtiquetas.Edit;
                    qryEtiquetasetiqueta.AsBoolean := true;
                    qryetiquetas.Post;

                     for NP:= 1 to qryEtiquetasQuantidade.AsInteger do begin
                         Inc(Col);
                         case Col of
                            1: Y:= 8;
                         end;

                         Linhas[1, Col]:= 'A736,' + FStr(Y+192,$00) +  ',1,3,2,1,N,"LISTA DE CASAMENTO"';
                         Linhas[2, Col]:= 'A696,' + FStr(Y+264,$00) +  ',1,3,2,1,N,"Nr ' + qryEtiquetasLista.AsString + '"';
                         Linhas[3, Col]:= 'A624,' + FStr(Y,    $00) +  ',1,2,1,1,N,"' + AnsiUpperCase(Copy(qryEtiquetasNomeNoiva.AsString,1,38)) + '"';

                         Rua:= ' ' + qryEtiquetasNumero.AsString;
                         Rua:= Copy(qryEtiquetasRua.AsString,1,38-Length(Rua)) + Rua;
                         Linhas[4, Col]:= 'A592,' + FStr(Y,$00) + ',1,2,1,1,N,"' + Rua + '"';
                         Linhas[5, Col]:= 'A572,' + FStr(Y,$00) + ',1,2,1,1,N,"' + AnsiUpperCase(Copy(qryEtiquetasNomeBairro.AsString,1,38)) + '"';
                         Linhas[6, Col]:= 'A552,' + FStr(Y,$00) + ',1,2,1,1,N,"' + Copy(qryEtiquetasNomeCidade.AsString,1,33) +
                                                                                       ' - ' + qryEtiquetasEstado.AsString +  '"';

                         Linhas[7, Col]:= 'A500,' + FStr(Y,$00) + ',1,2,1,1,N,"CONVIDADO:' + Copy(qryEtiquetasConvidado.AsString,1,30) + '"';
                         case TipoPesquisaEtiquetas of
                            Contratos: Linhas[8, Col]:= 'A470,' + FStr(Y,    $00) + ',1,2,1,1,N,"CONTRATO: ' + qryEtiquetascontrato.AsString + '"';
                            Notas:     Linhas[8, Col]:= 'A470,' + FStr(Y,    $00) + ',1,2,1,1,N,"NOTA FISCAL: '  + Format('%06.0n', [qryEtiquetasNrNota. AsFloat]) + '"';
                            Cupons:    Linhas[8, Col]:= 'A470,' + FStr(Y,    $00) + ',1,2,1,1,N,"CUPOM FISCAL: ' + Format('%06.0n', [qryEtiquetasNrCupom.AsFloat]) + '"';
                         end;
                         Linhas[ 9,Col]:= 'A440,' + FStr(Y,    $00) + ',1,2,1,1,N,"DATA: ' + qryEtiquetasDataEmissao.AsString + '"';
                         Linhas[10,Col]:= 'A376,' + FStr(Y,    $00) + ',1,3,2,1,N,"' + CenDirEsq(Trocar(qryEtiquetasDescricaoProduto.AsString,'"',''''),32,' ','C') + '"';
                         Linhas[11,Col]:= 'B336,' + FStr(Y+152,$00) + ',1,1,2,2,45,B,"' + qryEtiquetasCodigoVisual.AsString + '"';

                         case TipoPesquisaEtiquetas of
                            Contratos: Linhas[12,Col]:= 'A208,' + FStr(Y,$00) + ',1,2,1,1,N,"CONTRATO: ' + qryEtiquetascontrato.AsString + '"';
                            Notas:     Linhas[12,Col]:= 'A208,' + FStr(Y,$00) + ',1,2,1,1,N,"NOTA FISCAL: '  + Format('%06.0n', [qryEtiquetasNrNota. AsFloat]) + '"';
                            Cupons:    Linhas[12,Col]:= 'A208,' + FStr(Y,$00) + ',1,2,1,1,N,"CUPOM FISCAL: ' + Format('%06.0n', [qryEtiquetasNrCupom.AsFloat]) + '"';
                         end;
                         Linhas[13,Col]:= 'A178,' + FStr(Y,    $00) + ',1,2,1,1,N,"Nr LISTA:    ' + qryEtiquetasLista.AsString + '"';
                         Linhas[14,Col]:= 'A140,' + FStr(Y,    $00) + ',1,3,2,1,N,"' + CenDirEsq(Trocar(qryEtiquetasDescricaoProduto.AsString,'"',''''),32,' ','C') + '"';
                         Linhas[15,Col]:= 'B100,' + FStr(Y+152,$00) + ',1,1,2,2,45,B,"' + qryEtiquetasCodigoVisual.AsString + '"';


                         if Col = 1 then begin
                            BeginDoc('', False);
                               WriteTextLn('N',         0);
                               WriteTextLn('q800',      0);
                               WriteTextLn('Q480,24+0', 0);
                               WriteTextLn('S2',        0);
                               WriteTextLn('D' + FStr(ParSistema.IntensidadeImpressaoZebra,$00),0);
                               WriteTextLn('ZT',        0);
                               WriteTextLn('O',         0);

                               for NL:= 1 to 15 do
                                   for NC:= 1 to 1 do
                                       WriteTextLn(Linhas[NL, NC],0);
                               WriteTextLn('P1', 0);
                           EndDoc('TecLUX - Imprimindo Etiqueta ZEBRA TLP 2844');
                           Col := 0;           FillChar(Linhas,SizeOf(Linhas),0);
                         end;
                     end;
                  end;
                  qryEtiquetas.Next;
               end;

               if Col <> 0 then begin
                  BeginDoc('', False);
                     WriteTextLn('N',         0);
                     WriteTextLn('q800',      0);
                     WriteTextLn('Q480,24+0', 0);
                     WriteTextLn('S2',        0);
                     WriteTextLn('D' + FStr(ParSistema.IntensidadeImpressaoZebra,$00),0);
                     WriteTextLn('ZT',        0);
                     WriteTextLn('O',         0);

                     for NL:= 1 to 15 do
                         for NC:= 1 to 3 do
                             WriteTextLn(Linhas[NL, NC],0);
                     WriteTextLn('P1', 0);
                  EndDoc('TecLUX - Imprimindo Etiqueta ZEBRA TLP 2844');
               end;

            finally
               qryEtiquetas.EnableControls;
               perpetrar([qryetiquetas]);
            end;
         end;
      end;
   end;
end;

procedure TdtmListaCasamento.MarcarEtiquetaImprimir;
begin
  if not qryProdutosEtiquetas.IsEmpty then begin
    qryProdutosEtiquetas.Edit;
    qryProdutosEtiquetasimprimir.AsBoolean:= not qryProdutosEtiquetasimprimir.AsBoolean;
    qryProdutosEtiquetas.Post;
  end;
end;

procedure TdtmListaCasamento.MarcarNotasImprimir;
begin
  if not qrySaldosProdutosSimplesRemessa.IsEmpty and
     not qrySaldosProdutosSimplesRemessa.ReadOnly and
     (qrySaldosProdutosSimplesRemessafilial.asinteger = filialbase) then
  begin
    qrySaldosProdutosSimplesRemessa.Edit;
    qrySaldosProdutosSimplesRemessaquantidadeaentregar.AsFloat := qrySaldosProdutosSimplesRemessaquantidadenotafiscalvenda.AsFloat -
                                                                  qrySaldosProdutosSimplesRemessaquantidadenotafiscalsimplesremessa.AsFloat;
    qrySaldosProdutosSimplesRemessa.Post;
  end
end;


procedure TdtmListaCasamento.qryProcuraProdutosAfterOpen(DataSet: TDataSet);
begin
  inherited;
  if qryProdutosListaCasamento.State in [dsInsert, dsedit] then
  begin
    qryProdutosListaCasamentodescricao.AsString:= qryProcuraProdutosdescricao.AsString;
    qryProdutosListaCasamentolinha.AsString:= qryProcuraProdutoslinha.AsString;
    qryProdutosListaCasamentocoluna.AsString:= qryProcuraProdutoscoluna.AsString;
    qryProdutosListaCasamentovalorgrade1.AsString:= qryProcuraProdutosvalorgrade1.AsString;
    qryProdutosListaCasamentovalorgrade2.AsString:= qryProcuraProdutosvalorgrade2.AsString;
    qryProdutosListaCasamentopreco.AsCurrency := qryProcuraProdutospreco.AsCurrency;
    qryProdutosListaCasamentoaparecernosite.AsBoolean:=qryProcuraProdutosaparecernosite.AsBoolean;
    qryProdutosListaCasamentofotos.AsInteger:=qryProcuraProdutosfotos.AsInteger;
  end;
end;

function TdtmListaCasamento.ExisteLista: Boolean;
begin
  qryExisteListaCasamento.Params[0].AsInteger:= qryListaCasamentonoiva.AsInteger;
  qryExisteListaCasamento.Params[1].AsInteger:= qryListaCasamentonoivo.AsInteger;
  qryExisteListaCasamento.Open;
  Result:= not qryExisteListaCasamento.IsEmpty;
  qryExisteListaCasamento.Close;
end;

function TdtmListaCasamento.ExisteListaPadrao(Campo, Codigo: string): Boolean;
begin
  Result:= ExisteCodigo(qryConsultaListasPadrao,Campo,Codigo);
end;

function TdtmListaCasamento.ValidarListaCasamento: Boolean;
begin
  Result:= (ExisteLista and (qryListaCasamento.State = dsInsert));
  if Result then begin
    MensagemAviso(Format(ctLISTACASAMENTOCADASTRADA,[qryListaCasamentonomenoiva.AsString,
                                                     qryListaCasamentonomenoivo.AsString]));
  end;
end;

function TdtmListaCasamento.GetProdutoIncluidoDepois: Boolean;
begin
  Result:= qryProdutosListaCasamentoincluidodepois.AsBoolean;
end;

function TdtmListaCasamento.GetTabelaConsultaListaPadrao: TtecQuery;
begin
