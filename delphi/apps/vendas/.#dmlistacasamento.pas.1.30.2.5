procedure TdtmListaCasamento.SelecionarProdutos(Value,Todos: Boolean);
Var
  pos: TBookmark;
begin
  if Todos then begin
    Pos:= qryProdutosListaPadrao.GetBookmark;
    qryProdutosListaPadrao.DisableControls;
    try
      qryProdutosListaPadrao.First;
      while not qryProdutosListaPadrao.Eof do begin
        qryProdutosListaPadrao.Edit;
        qryProdutosListaPadraoselecionar.AsBoolean:= Value;
        qryProdutosListaPadrao.Post;
        qryProdutosListaPadrao.Next;
      end
    finally
      qryProdutosListaPadrao.GotoBookmark(Pos);
      qryProdutosListaPadrao.FreeBookmark(Pos);
      qryProdutosListaPadrao.EnableControls;
    end;
  end
  else begin
    qryProdutosListaPadrao.Edit;
    qryProdutosListaPadraoselecionar.AsBoolean:= not qryProdutosListaPadraoselecionar.AsBoolean;
    qryProdutosListaPadrao.Post;
  end;
end;

procedure TdtmListaCasamento.AtribuirProdutosNaListaCasamento;
Var
  Pos: TBookmark;
begin
  if MensagemConfirmacao('Inserir os produtos selecionados na Lista de Casamento.') = smbOk then begin
    Pos:= qryProdutosListaPadrao.GetBookmark;
    qryProdutosListaPadrao.DisableControls;
    try
      qryProdutosListaPadrao.First;
      while not qryProdutosListaPadrao.Eof do begin
        if qryProdutosListaPadraoselecionar.AsBoolean then begin
          if not qryProdutosListaCasamento.Locate('produto',qryProdutosListaPadraoproduto.AsLargeInt,[]) then begin
            qryProdutosListaCasamento.Append;
            qryProdutosListaCasamentoproduto.AsLargeInt   := qryProdutosListaPadraoproduto.AsLargeInt;
            qryProdutosListaCasamentodescricao.AsString   := qryProdutosListaPadraodescricao.AsString;
