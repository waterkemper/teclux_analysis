function TdtmListaCasamento.NotaFiscalSimplesRemessa: boolean;
Var
  I: Integer;
  {erroestoque, produto, filial,} ChaveAcesso,
  LoteNFe, ReciboNFe, ProtocoloNFe, status, DataHoraProcessamento, vObsNFReferenciadas,
  vObsCuponsReferenciados : String;
  NFe: TTecNotaFiscalEletronica;
  vSaldo : Currency;


  procedure SelecionarCodigoNatureza(descricao: String);
  begin
    qryNaturezasPadrao.Open;
    if qryNaturezasPadrao.Locate('descricao',descricao,[]) then
    begin
      qrydadosfiscaiscodigonatureza.asinteger := qryNaturezasPadraonatureza.AsInteger;
      qryDadosFiscaisnatureza.AsString := qryNaturezasPadraodescricao.AsString;
      qryDadosFiscaiscodigofiscal.AsInteger   := qryNaturezasPadraocodigofiscal.AsInteger;
      if qryDadosFiscaiscodigofiscal.AsInteger <> 8000 then
        if not (qryDadosFiscaisestadocfo.AsString = EstadoFilialBase) then
          if HeUnidadeFederacao(qryDadosFiscaisestadocfo.AsString) then
          begin
            if  qryDadosFiscaiscodigofiscal.AsInteger = ctVENDASUBSTITUIDODENTROESTADO then
              qryDadosFiscaiscodigofiscal.AsInteger := qryDadosFiscaiscodigofiscal.AsInteger+999
            else
              qryDadosFiscaiscodigofiscal.AsInteger := qryDadosFiscaiscodigofiscal.AsInteger+1000;
          end
          else
            qryDadosFiscaiscodigofiscal.AsInteger := qryDadosFiscaiscodigofiscal.AsInteger+2000;
    end;
  end;



  function EmitirNFe(Validando: Boolean = False): Boolean;
  begin
    if not Validando then
      qryDadosFiscais.edit;

    if qryDadosFiscaisnrdocumento.AsInteger  <> qryNotasnumero.AsInteger then
      qryDadosFiscaisnrdocumento.AsInteger  := qryNotasnumero.AsInteger;

    qryDadosFiscaiscodaleatorio.AsInteger    := Aleatorio(qryDadosFiscaisdata.AsDateTime, qryDadosFiscaisnrdocumento.asString);  

    ChaveAcesso :=
               copy(CodigoCidadeIBGEFilialBase,1,2)+                       // 2
               FormatDateTime('YYMM',qryDadosFiscaisdata.AsDateTime)+      // 4
//                       ifthen(NFeAmbiente=2,'99999999000191',preencheString(CNPJFilialBase,'0',14,false))+  // 14
               preencheString(CNPJFilialBase,'0',14,false) +
               preencheString(qryDadosFiscaismodelodocto.AsString,'0',2,false)+ // 2
               preencheString(SerieSugestao,'0',3,false)+                  // 3
               preencheString(qryDadosFiscaisnrdocumento.Asstring,'0',9,false) + // 9
               qryDadosFiscaisformaemissao.AsString + //1
               preencheString(qryDadosFiscaiscodaleatorio.Asstring,'0',8,false);  // 8

    qryDadosFiscaisdigchaveacesso.AsString   := Modulo11(ChaveAcesso);
    qryDadosFiscaischv_nfe.AsString := ChaveAcesso + qryDadosFiscaisdigchaveacesso.AsString;
//             modulo11(ChaveAcesso,'98765432',false);

    {1 - PRODUÇÃO 2 - HOMOLOGAÇÃO}
    qryDadosFiscaisambiente.AsInteger         := NFeAmbiente;// '2';

    {1 - normal 2 - compelementar}
    if qryDadosFiscaisdadofiscalcomplementar.AsInteger=0 then
       qryDadosFiscaisfinalidadenf.AsInteger  := 1
    else
       qryDadosFiscaisfinalidadenf.AsInteger  := 2;

    qryDadosFiscaisprocemissao.AsString      := '0';
    qryDadosFiscaisversaoteclux.AsString     := VersaoTecLUX;

    qryDadosFiscaisinfcomplementar.AsString:= qryDadosFiscaisinfcomplementar.AsString  + ' ' +  sLineBreak +
                                              qryDadosFiscaisobservacoes.AsString + ' ' + sLineBreak +
                                              qryDadosFiscaisobservacoesicmssubstituido.AsString;

//    if qryDadosFiscaisnosimples.AsBoolean then
    if (regimetributario = 1) and //simples
       (parsistema.obsnfeClientesnoSimples <> '') then

      qryDadosFiscaisinfcomplementar.AsString := qryDadosFiscaisinfcomplementar.AsString + ' ' +  sLineBreak +
                                                 parsistema.obsnfeClientesnoSimples;
    if not Validando then
    begin
      if (qrydadosfiscais.State in [dsedit, dsinsert]) then
      begin
        qryDadosFiscais.Post;
        NFe := TTecNotaFiscalEletronica.Create;
      end
    end
    else
      NFe := TTecNotaFiscalEletronica.Create(dtmTecSoft.Database);

    NFe.DiretorioEnvio       := NFeDirEnvio;
    NFe.DiretorioEnviado     := NFeDirEnviados;
    NFe.DiretorioRetorno     := NFeDirRetorno;
    NFe.DiretorioCompartilha := NfeDirCompartilha;
    {$IFDEF MSWINDOWS}
    NFe.Executavel           := NFeExecNFe;
    {$ENDIF}
    try
      if not validando then
      begin
        ShowProcessando('Gerando o arquivo da NF-e!');
        Sleep(500);
      end;

      // EMITENTE
      NFe.Emit_Documento := CNPJFilialBase;
      NFe.Emit_Nome      := RazaoFilialBase;
      NFe.Emit_Rua       := RuaSemNumeroFilialBase;
      NFe.Emit_Nro       := NumeroFilialBase;
      NFe.Emit_Compl     := ComplementoFilialBase;
      NFe.Emit_Bairro    := BairroFilialBase;
      NFe.Emit_CodMun    := CodigoCidadeIBGEFilialBase;
      NFe.Emit_Mun       := CidadeFilialBase;
      NFe.Emit_UF        := EstadoFilialBase;
      NFe.Emit_CEP       := CEPFilialBase;
  //    NFe.Emit_CodPais   := 1058;
  //    NFe.Emit_Pais      := 'Brasil';
      NFe.Emit_Fone      := DDDFilialBase+FoneFilialBase;
      NFe.Emit_IE        := InscricaoEstadualFilialBase;
  //    NFe.Emit_IEST      := '';
      NFe.Emit_IM        := InscricaoMunicipalFilialBase;
      NFe.Emit_CNAE      := CNAEFiscalFilialBase;
      NFe.Emit_CRT       := qryDadosFiscaisregimetributario.AsInteger;

      // DESTINATARIO
      NFe.Dest_TipoPessoa := qryDadosFiscaispessoatipo.AsString;
      NFe.Dest_Documento := qryDadosFiscaispessoanumero.AsString;
      NFe.Dest_Nome      := qryDadosFiscaisnome.AsString;
      NFe.Dest_Rua       := qryDadosFiscaisrua.AsString;
      NFe.Dest_Nro       := qryDadosFiscaisendnumero.AsString;
      NFe.Dest_Compl     := qryDadosFiscaisendcomplemento.AsString;
      NFe.Dest_Bairro    := qryDadosFiscaisnomebairro.AsString;
      NFe.Dest_CodMun    := qryDadosFiscaiscidadeibge.AsString;
      NFe.Dest_Mun       := qryDadosFiscaisnomecidade.AsString;
      NFe.Dest_UF        := qryDadosFiscaisestado.AsString;
      NFe.Dest_CEP       := qryDadosFiscaiscep.AsString;
      NFe.Dest_CodPais   := qryDadosFiscaispais.AsInteger;
      NFe.Dest_Pais      := qryDadosFiscaisnomepais.AsString;
      NFe.Dest_Fone      := qryDadosFiscaisfoneddd.AsString+qryDadosFiscaisfonenumero.AsString;
      NFe.Dest_IE        := qryDadosFiscaisdocumento.AsString;
      NFe.Dest_ISUF      := qryDadosFiscaisiesubsttributario.AsString;

      // ENTREGA
      NFe.Entrega_Documento := qryDadosFiscaislocalentrega_cnpj.AsString;
      NFe.Entrega_Rua       := qryDadosFiscaislocalentrega_rua.AsString;
      NFe.Entrega_Nro       := qryDadosFiscaislocalentrega_numero.AsString;
      NFe.Entrega_Compl     := qryDadosFiscaislocalentrega_complemento.AsString;
      NFe.Entrega_Bairro    := qryDadosFiscaislocalentrega_nomebairro.AsString;
      NFe.Entrega_CodMun    := qryDadosFiscaislocalentrega_cidadeibge.AsString;
      NFe.Entrega_Mun       := qryDadosFiscaislocalentrega_nomecidade.AsString;
      NFe.Entrega_UF        := qryDadosFiscaislocalentrega_estado.AsString;

      NFe.Validando := Validando;

      Result := NFe.GerarNFe(qryDadosFiscais,nil,qryProdutosDadosFiscais,nil,nil,
                   nil,nil,nil,nil,nil,SerieSugestao,'S');

      if result and not Validando then
      begin
        if (NFeTipoEmissao in [1,3] ) then
        begin
          ShowProcessando;
          ShowProcessando('Verificando status do serviço NF-e!');
          Sleep(500);
          if NFe.VerificarStatusServico(IntToStr(NFeAmbiente)) then
          begin
            ShowProcessando;
            ShowProcessando('Processando o arquivo de envio da NF-e!');
            Sleep(500);
            Result := NFe.EnviarNFe(ChaveAcesso+qryDadosFiscaisdigchaveacesso.AsString, LoteNFe, ReciboNFe);
            if Result then
            begin
              qryDadosFiscais.Edit;
              qryDadosFiscaisnumlotenfe.AsString   := LoteNFe;
              qryDadosFiscaisnumrecibonfe.AsString := ReciboNFe;
              qryDadosFiscais.Post;
              Result := Perpetrar([qryDadosFiscais]);
              if Result then
              begin
                ShowProcessando;
                ShowProcessando('Consultando o arquivo de retorno da NF-e!');
                Sleep(5000);
                Result := NFe.ConsultarSituacaoLote(ReciboNFe, ProtocoloNFe, status, DataHoraProcessamento, IntToStr(NFeAmbiente));
              end;
              if Result then
              begin
                qryDadosFiscais.Edit;
                qryDadosFiscaisnumprotocolonfe.AsString := ProtocoloNFe;
                qryDadosFiscaisstatusnfe.AsString := status;
                qryDadosFiscaisdhprocnfe.AsDateTime :=  FormatarTimeStamp(DataHoraProcessamento);
                qryDadosFiscais.Post;

                if (qryDadosFiscaisstatusnfe.AsString = '301') or
                   (qryDadosFiscaisstatusnfe.AsString = '302') then
                begin
                  qryDadosFiscais.Edit;
                  qryDadosFiscaissituacao.AsString := 'D';
                  qryDadosFiscais.Post;
//                  LimparTabela(qrymovimentos);
//                  Result := Perpetrar([qryMovimentos, qryDadosFiscais]);
                end;
//                else
                  Result := Perpetrar([qryDadosFiscais]);

                if Result then
                begin
                  ShowProcessando;
                  ShowProcessando('Gerando o arquivo de compartilhamento da NF-e!');
                  Sleep(500);
                  Result := NFe.CompartilharXML(ChaveAcesso+qryDadosFiscaisdigchaveacesso.AsString,
                                                ReciboNFe, qryDadosFiscaisfilialemissao.AsString,
                                                SerieSugestao, qryDadosFiscaisnrdocumento.AsString,
                                                qryDadosFiscaisdata.AsDateTime);
                  if Result then
                  begin
                    {if not NFeVisualizarDANFE then
                      MensagemAviso('Impressão da Nota Fiscal será iniciada.')
                    else
                    begin
                    } ShowProcessando;
                      ShowProcessando('Imprimindo o DANFE!');
                    //end;
                    NFe.ImprimirDanfe({ChaveAcesso+qryDadosFiscaisdigchaveacesso.AsString,}
                                      qryDadosFiscaisfilialvenda.AsString,
                                      SerieSugestao,
                                      qryDadosFiscaisnrdocumento.AsString,
                                      qryDadosFiscaislocalentrega_cep.AsString,
                                      qryDadosFiscaisemail.AsString,
                                      IntToStr(NFeNVias), NFeLogotipoDANFE,
                                      ParSistema.NomeImpressoraNotaMercadorias, NFeVisualizarDANFE,
                                      qryDadosFiscaisdata.AsDateTime,
                                      qryProdutosdadosfiscais, NFeExecDANFE);
                    ShowProcessando;
                    if (qryDadosFiscaisemail.AsString <> '')      and
                       (UsuarioLogin.PortaSmpt        <> '')      and
                       (UsuarioLogin.HostSmtp         <> '')      and
                       (UsuarioLogin.Email            <> '')      and
                       (UsuarioLogin.SenhaEmail       <> '')      and
                       EmailValido(qryDadosFiscaisemail.AsString) then
                    begin
                      ShowProcessando('Enviando email para o cliente');
                      {NFe.EnviarEmail(MontarEmailNFe,
                                      'Envio da NFe(xml) - Emitente: ' + NomeFilialBase + ' - ' +
                                                             'N.Doc: ' + FormatarNroNFe(qryDadosFiscaisnrdocumento.AsString) +
                                                          ' - Série: ' + preencheString(SerieSugestao,'0',3,False),
                                      LowerCase(UsuarioLogin.Email), LowerCase(qryDadosFiscaisemail.AsString),
                                      NomeFilialBase, UsuarioLogin.PortaSmpt,UsuarioLogin.HostSmtp,
                                      LowerCase(UsuarioLogin.Email), UsuarioLogin.SenhaEmail,
                                      qryDadosFiscaisfilialvenda.AsString, SerieSugestao,
                                      qryDadosFiscaisnrdocumento.AsString, UsuarioLogin.AutenticarSmtp);}
                      try
                                                        if not NFe.EnviarEmail(UsuarioLogin.Email,qryDadosFiscaisemail.AsString,
                                                                            qryDadosFiscaisnrdocumento.AsString, SerieSugestao, IntToStr(FilialBase),
                                                                            NomeFilialBase, RazaoFilialBase, CNPJFilialBase, DDDFilialBase, FoneFilialBase,
                                                                            DDDFaxFilialBase, FaxFilialBase, UsuarioLogin.NomeUsuario, UsuarioLogin.PortaSMPT,
                                                                            UsuarioLogin.HostSMTP, UsuarioLogin.UsuarioEmail, UsuarioLogin.SenhaEmail,
                                                                            qryDadosFiscaisdata.AsDateTime, qryDadosFiscaisvalortotal.AsCurrency,
                                                                            UsuarioLogin.AutenticarSMTP, qryDadosFiscaisdata.AsDateTime) then
                                                              MensagemAviso('Ocorreu um erro inesperado no envio do email')
                                                      finally
                                                            ShowProcessando;
                                                      end;
                    end;
                  end
                  else
                    ShowProcessando;
                end;
              end
              else
                ShowProcessando;
            end
            else
              ShowProcessando;
          end
          else
            ShowProcessando;
        end
        else
        begin
          if not NFeVisualizarDANFE then
            MensagemAviso('Impressão da Nota Fiscal será iniciada.');

          NFe.ImprimirDanfe({ChaveAcesso+qryDadosFiscaisdigchaveacesso.AsString,}
                            qryDadosFiscaisfilialemissao.AsString,
                            SerieSugestao,
                            qryDadosFiscaisnrdocumento.AsString,
                            qryDadosFiscaislocalentrega_cep.AsString,
                            qryDadosFiscaisemail.AsString,
                            IntToStr(NFeNVias), NFeLogotipoDANFE,
                            ParSistema.NomeImpressoraNotaMercadorias, NFeVisualizarDANFE,
                            qryDadosFiscaisdata.AsDateTime,
                            qryProdutosDadosFiscais, NFeExecDANFE);
        end;
      end;

    finally
      FreeAndNil(NFe); //NFe.Free;
    end;

  end;


begin
  result := True;

  qryDadosFiscais.close;
  qryDadosFiscais.Open;

  qryProdutosDadosFiscais.close;
  qryProdutosDadosFiscais.Open;

