  object qryProdutosSituacao_O: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';select pc.produto,'
      '       pc.filial,'
      '       pc.qtdade,'
      '       e.emestoque,'
      '       e.reservado,'
      '       e.futuro,'
      '       cast(case when (pc.qtdade > (e.emestoque))   then '#39'N'#39
      '            when (pc.qtdade <=  (e.emestoque)) then '#39'A'#39
      '            when ((e.reservado) > 0) and'
      '                 (qtdade > (e.emestoque)) then '#39'P'#39
      '       else '#39'?'#39
      '       end as char(1)) as situacao_produto,'
      
        '       (select u.nome from usuarios u where u.codigo = pc.vended' +
        'or) as nomevendedor,'
      ''
      '       p.valorgrade1,'
      '       p.valorgrade2,'
      ''
      
        '       (select g.descricao from grades g where g.codigo = c.grad' +
        'e1) as linha,'
      
        '       (select g.descricao from grades g where g.codigo = c.grad' +
        'e2) as coluna,'
      ''
      ''
      '       (select t.valor'
      '        from tributosicms t'
      '        where t.codigo = c.incidencia) as incidencia,'
      ''
      '       c.csosn'
      '       '
      'from'
      '('
      ' Select pc.produto,'
      '        pc.filial,'
      '        pc.vendedor,'
      '        sum(pc.quantidade)  as qtdade'
      ' from (contratos ct'
      '        join produtoscontratos pc'
      '        on ct.numero = pc.contrato)'
      ''
      ' where ct.numero = pc.contrato'
      '   and ct.situacao = '#39'O'#39
      '   and (ct.os IS NULL OR not ct.os)'
      ''
      ' group by pc.produto, pc.filial, pc.vendedor'
      ') pc'
      'natural join estoques e'
      ''
      '  join produtos p'
      '       join caracteristicas c'
      '       on p.caracteristica = c.codigo'
      '  on pc.produto = p.codigo')
    RequestLive = False
    Left = 248
    Top = 408
  end
  object qryProdutosEntregar_O_R: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Situacao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Vendedor'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ContratosFuturo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Contrato'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';select pc.*, p.descricao,'
      
        '       (select u.nome from usuarios u where u.codigo = pc.vended' +
        'or) as nomevendedor,'
      '        cast(null as numeric(9,3)) as emEstoque,'
      '        cast(null as numeric(9,3)) as Reservado,'
      '        cast(null as numeric(9,3)) as Futuro,'
      '        cast(null as numeric(9,3)) as Pendente_Geral,'
      '        cast(null as char(1)) as situacao_produto,'
      '       p.valorgrade1,'
      '       p.valorgrade2,'
      ''
      
        '       (select g.descricao from grades g where g.codigo = c.grad' +
        'e1) as linha,'
      
        '       (select g.descricao from grades g where g.codigo = c.grad' +
        'e2) as coluna,'
      ''
      '       (select t.valor'
      '        from tributosicms t'
      '        where t.codigo = c.incidencia) as incidencia,'
      '       c.csosn'
      '        '
      ''
      'from'
      '('
      ''
      '  Select pc.contrato,'
      '         pc.produto,'
      '         pc.vendedor,'
      '         pc.filial,'
      '         pc.entrega,'
      
        '         sum(pc.quantidade-coalesce(pc.cancelado,0))  as pendent' +
        'e_contrato'
      ''
      '  from (contratos ct'
      '        join produtoscontratos pc'
      '        on ct.numero = pc.contrato)'
      ''
      '  where ct.numero = pc.contrato'
      ''
      '    %Situacao'
      '    %Filial'
      '    %Vendedor'
      '    %ContratosFuturo'
      ''
      '    %Contrato'
      ''
      ''
      
        '  group by pc.contrato, pc.produto, pc.vendedor, pc.filial, pc.e' +
        'ntrega'
      ''
      ''
      ') pc join produtos p'
      '          join caracteristicas c'
      '          on p.caracteristica = c.codigo'
      '  on pc.produto = p.codigo'
      ''
      'order by produto,filial')
    RequestLive = False
    Left = 280
    Top = 296
  end
