  object qryProdutosSituacao_R_F_P: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';select pc.produto,'
      '       pc.filial,'
      '       pc.qtdade,'
      '       e.emestoque,'
      '       e.reservado,'
      '       e.futuro,'
      '       pc.vendedor,'
      
        '       (select u.nome from usuarios u where u.codigo = pc.vended' +
        'or) as nomevendedor,'
      ''
      
        '       cast(case when (pc.qtdade > e.reservado and e.reservado=0' +
        ')    then '#39'N'#39
      '            when (pc.qtdade <= e.reservado)  then '#39'A'#39
      '            when (e.reservado > 0) and'
      '                 (qtdade > e.reservado + e.emestoque) then '#39'P'#39
      '       else '#39'?'#39
      '       end as char(1)) as situacao_produto,'
      ''
      '       p.valorgrade1,'
      '       p.valorgrade2,'
      ''
      
        '       (select g.descricao from grades g where g.codigo = c.grad' +
        'e1) as linha,'
      
        '       (select g.descricao from grades g where g.codigo = c.grad' +
        'e2) as coluna,'
      '       '
      ''
      '       (select t.valor'
      '        from tributosicms t'
      '        where t.codigo = c.incidencia) as incidencia,'
      ''
      '       c.csosn'
      ''
      'from'
      '('
      '  select produto ,filial, vendedor, sum(qtdade) as qtdade'
      '  from'
      '  ('
      ''
      '      ('
      
        '       select pc.produto, pc.vendedor, pc.filial, pc.qtdade - co' +
        'alesce(pd.quantidade,0) as qtdade'
      '       from'
      '       ('
      '         Select pc.produto,'
      '                pc.vendedor,'
      '                pc.filial,'
      
        '                sum(pc.quantidade-coalesce(pc.cancelado,0))  as ' +
        'qtdade'
      '         from (contratos ct'
      '                join produtoscontratos pc'
      '                on ct.numero = pc.contrato)'
      ''
      '         where ct.numero = pc.contrato'
      '           and ct.situacao = '#39'P'#39
      
        '           and (ct.os IS NULL OR not ct.os)    and not exists (s' +
        'elect c2.numero from contratos c2 where c2.origem = ct.numero)'
      '           and pc.quantidade > coalesce(pc.cancelado,0)'
      ''
      '         group by pc.produto, pc.filial, pc.vendedor'
      '       ) as pc'
      ''
      '                      left join (select pdf.produto,'
      '                                        pdf.filial,'
      
        '                                        sum(pdf.quantidade) as q' +
        'uantidade'
      '                                 from (contratos ct'
      '                                      join (dadosfiscais df'
      
        '                                            join produtosdadosfi' +
        'scais pdf'
      
        '                                            on df.numero = pdf.d' +
        'adofiscal)'
      
        '                                      on ct.numero = df.contrato' +
        ')'
      '                                 where ct.numero =df.contrato'
      
        '                                   and df.numero = pdf.dadofisca' +
        'l'
      '                                   and ct.situacao = '#39'P'#39
      
        '                                   and (ct.os IS NULL OR not ct.' +
        'os)'
      
        '                                   and not exists (select c2.num' +
        'ero from contratos c2 where c2.origem = ct.numero)'
      '                                   and df.situacao = '#39'N'#39
      '                                 group by pdf.produto,pdf.filial'
      
        '                                ) pd on pc.produto = pd.produto ' +
        'and pc.filial = pd.filial'
      '      where pc.qtdade > coalesce(pd.quantidade,0)'
      ''
      '      )'
      ''
      '      union all'
      ''
      '      ('
      '       Select pc.produto,'
      '              pc.vendedor,'
      '              pc.filial,'
      
        '              sum(pc.quantidade-coalesce(pc.cancelado,0))  as qt' +
        'dade'
      '       from (contratos ct'
      '             join produtoscontratos pc'
      '             on ct.numero = pc.contrato)'
      ''
      '       where ct.numero = pc.contrato'
      '         and ct.situacao in ('#39'R'#39','#39'F'#39')'
      '         and (ct.os IS NULL OR not ct.os)'
      
        '         and not exists (select c2.numero from contratos c2 wher' +
        'e c2.origem = ct.numero)'
      '         and pc.quantidade > coalesce(pc.cancelado,0)'
      ''
      '       group by pc.produto, pc.filial, pc.vendedor'
      '      )'
      '  ) pc'
      '  group by produto, filial, vendedor'
      ') pc natural join estoques e'
      ''
      '  join produtos p'
      '       join caracteristicas c'
      '       on p.caracteristica = c.codigo'
      '  on pc.produto = p.codigo')
    RequestLive = False
    Left = 248
    Top = 360
  end
  object qryProdutosEntregar: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'numero=contrato'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsContratosAprovar
    Constraints = <>
    AfterInsert = qryProdutosEntregarAfterInsert
    AfterScroll = qryProdutosEntregarAfterScroll
    OnCalcFields = qryProdutosEntregarCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Vendedor'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ContratosFuturo'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'select pc.*, p.descricao,'
      
        '        (select u.nome from usuarios u where u.codigo = pc.vende' +
        'dor) as nomevendedor,'
      '        cast(null as numeric(9,3)) as emEstoque,'
      '        cast(null as numeric(9,3)) as Reservado,'
      '        cast(null as numeric(9,3)) as Futuro,'
      '        cast(null as numeric(9,3)) as Pendente_Geral,'
      '        cast(null as char(1)) as situacao_produto'
      'from'
      '('
      
        ' select contrato,produto, filial, vendedor, sum(pendente_contrat' +
        'o) as pendente_contrato'
      ' from'
      ' ('
      '     ('
      '      Select pc.contrato,'
      '             pc.produto,'
      '             pc.filial,'
      '             pc.vendedor,'
      
        '             sum(pc.quantidade-coalesce(pc.cancelado,0))-sum(coa' +
        'lesce(pd.quantidade,0))  as pendente_contrato'
      ''
      '      from contratos ct'
      '            join (produtoscontratos pc'
      '                  left join (select d.contrato,'
      '                                    pd1.produto,'
      '                                    pd1.filial,'
      
        '                                    sum(pd1.quantidade) as quant' +
        'idade'
      ''
      '                             from ((dadosfiscais d'
      
        '                                   join contratos ct on d.contra' +
        'to = ct.numero)'
      '                                   join produtosdadosfiscais pd1'
      '                                   on d.numero = pd1.dadofiscal)'
      ''
      '                             where d.contrato = ct.numero'
      '                               and d.numero = pd1.dadofiscal'
      '                               and d.situacao = '#39'N'#39
      '                               and ct.situacao = '#39'P'#39
      '                               AND (ct.os IS NULL OR not ct.os)'
      
        '                               and not exists (select c2.numero ' +
        'from contratos c2 where c2.origem = ct.numero)'
      ''
      '                               %Filial'
      '                               %Vendedor'
      '                               %ContratosFuturo'
      ''
      
        '                             group by d.contrato, pd1.produto, p' +
        'd1.filial) pd'
      '                  using (contrato,produto,filial))'
      '            on ct.numero = pc.contrato'
      ''
      '      where ct.numero = pc.contrato and'
      '        and ct.situacao = '#39'P'#39
      '        and (ct.os IS NULL OR not ct.os)'
      
        '        and not exists (select c2.numero from contratos c2 where' +
        ' c2.origem = ct.numero)'
      ''
      '        %Filial'
      '        %Vendedor'
      '        %ContratosFuturo'
      ''
      '      group by pc.contrato, pc.produto, pc.vendedor, pc.filial'
      
        '      having sum(pc.quantidade-coalesce(pc.cancelado,0)) > sum(c' +
        'oalesce(pd.quantidade,0))'
      '     )'
      ''
      '      union all'
      ''
      '     ('
      '      Select pc.contrato,'
      '             pc.produto,'
      '             pc.filial,'
      '             pc.vendedor,'
      
        '             sum(pc.quantidade-coalesce(pc.cancelado,0))  as pen' +
        'dente_contrato'
      ''
      '      from (contratos ct'
      '            join produtoscontratos pc'
      '            on ct.numero = pc.contrato)'
      ''
      '      where ct.numero = pc.contrato'
      '        and ct.situacao = '#39'F'#39
      '        and (ct.os IS NULL OR not ct.os)'
      
        '        and not exists (select c2.numero from contratos c2 where' +
        ' c2.origem = ct.numero)'
      ''
      '        %Filial'
      '        %Vendedor'
      '        %ContratosFuturo'
      ''
      '      group by pc.contrato, pc.produto, pc.vendedor, pc.filial'
      ''
      '     )'
      ' ) as pc group by contrato, produto, vendedor, filial'
      ') pc join produtos p on pc.produto = p.codigo'
      'order by produto,filial'
      '')
    RequestLive = True
    Left = 80
    Top = 256
