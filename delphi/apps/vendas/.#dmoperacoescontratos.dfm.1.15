  object qryProdutosEntregar_F_P: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Vendedor'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ContratosFuturo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Contrato'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';select pc.*, p.descricao,'
      
        '        (select u.nome from usuarios u where u.codigo = pc.vende' +
        'dor) as nomevendedor,'
      '        cast(null as numeric(9,3)) as emEstoque,'
      '        cast(null as numeric(9,3)) as Reservado,'
      '        cast(null as numeric(9,3)) as Futuro,'
      '        cast(null as numeric(9,3)) as Pendente_Geral,'
      '        cast(null as char(1)) as situacao_produto,'
      ''
      '       p.valorgrade1,'
      '       p.valorgrade2,'
      ''
      
        '       (select g.descricao from grades g where g.codigo = c.grad' +
        'e1) as linha,'
      
        '       (select g.descricao from grades g where g.codigo = c.grad' +
        'e2) as coluna,'
      ''
      ''
      ''
      '       (select t.valor'
      '        from tributosicms t'
      '        where t.codigo = c.incidencia) as incidencia,'
      ''
      '       c.csosn'
      ''
      'from'
      '('
      
        ' select contrato,produto, vendedor, filial, entrega, sum(pendent' +
        'e_contrato) as pendente_contrato'
      ' from'
      ' ('
      '      ('
      
        '         select pc.contrato,pc.produto, pc.vendedor, pc.filial,p' +
        'c.entrega,'
      
        '                pc.pendente_contrato - coalesce(pd.quantidade,0)' +
        ' as pendente_contrato'
      '         from'
      '        ('
      '          Select pc.contrato,'
      '                 pc.produto,'
      '                 pc.vendedor,'
      '                 pc.filial,'
      '                 pc.entrega,'
      
        '                 sum(pc.quantidade-coalesce(pc.cancelado,0))  as' +
        ' pendente_contrato'
      ''
      '          from (contratos ct'
      '                join produtoscontratos pc'
      '                on ct.numero = pc.contrato)'
      ''
      '          where ct.numero = pc.contrato'
      '            and ct.situacao = '#39'P'#39
      
        '            and (ct.os IS NULL OR not ct.os) and not exists (sel' +
        'ect c2.numero from contratos c2 where c2.origem = ct.numero)'
      '            and pc.quantidade > coalesce(pc.cancelado,0)'
      ''
      '            %Filial'
      '            %Vendedor'
      '            %ContratosFuturo'
      ''
      '            %Contrato'
      ''
      
        '          group by pc.contrato, pc.produto, pc.vendedor, pc.fili' +
        'al, pc.entrega'
      '         ) pc left join (select d.contrato,'
      '                                pd1.produto,'
      '                                pd1.filial,'
      
        '                                sum(pd1.quantidade) as quantidad' +
        'e'
      ''
      '                         from ((dadosfiscais d'
      
        '                                join contratos ct on d.contrato ' +
        '= ct.numero)'
      '                                join produtosdadosfiscais pd1'
      
        '                                     on d.numero = pd1.dadofisca' +
        'l)'
      ''
      '                         where d.contrato = ct.numero'
      '                           and d.numero = pd1.dadofiscal'
      '                           and d.situacao = '#39'N'#39
      '                           and ct.situacao = '#39'P'#39
      
        '                           AND (ct.os IS NULL OR not ct.os)  and' +
        ' not exists (select c2.numero from contratos c2 where c2.origem ' +
        '= ct.numero)'
      ''
      '                                   %Filial'
      '                                   %Vendedor'
      '                                   %ContratosFuturo'
      ''
      
        '                         group by d.contrato, pd1.produto, pd1.f' +
        'ilial) pd'
      '                      using (contrato,produto,filial)'
      '         where pc.pendente_contrato > coalesce(pd.quantidade,0)'
      '     )'
      ''
      '      union all'
      ''
      '     ('
      '      Select pc.contrato,'
      '             pc.produto,'
      '             pc.vendedor,'
      '             pc.filial,'
      '             pc.entrega,'
      
        '             sum(pc.quantidade-coalesce(pc.cancelado,0))  as pen' +
        'dente_contrato'
      ''
      '      from (contratos ct'
      '            join produtoscontratos pc'
      '            on ct.numero = pc.contrato)'
      ''
      '      where ct.numero = pc.contrato'
      '        and ct.situacao = '#39'F'#39
      '        and (ct.os IS NULL OR not ct.os)'
      
        '        and not exists (select c2.numero from contratos c2 where' +
        ' c2.origem = ct.numero)'
      ''
      '        %Filial'
      '        %Vendedor'
      '        %ContratosFuturo'
      ''
      '        %Contrato'
      ''
      ''
      
        '      group by pc.contrato, pc.produto, pc.vendedor, pc.filial, ' +
        'pc.entrega'
      ''
      '     )'
      ' ) as pc group by contrato, produto, vendedor, filial, entrega'
      ') pc join produtos p'
      '          join caracteristicas c'
      '          on p.caracteristica = c.codigo'
      '  on pc.produto = p.codigo'
      ''
      'order by produto,filial')
    RequestLive = False
    Left = 272
    Top = 248
  end
