  object qryContratos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnProgress = ShowProgress
    AfterOpen = qryContratosAfterOpen
    AfterClose = qryContratosAfterClose
    AfterInsert = qryContratosAfterInsert
    AfterScroll = qryContratosAfterScroll
    OnCalcFields = qryContratosCalcFields
    OnFilterRecord = qryContratosFilterRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Situacao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Vendedor'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ContratosFuturo'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select ct.numero, ct.cliente, ct.tipocliente, ct.valorprazo,'
      '       ct.data,'
      '       ct.datareservado,'
      '       ct.faturamento,'
      '       ct.filialvenda,'
      '       ct.situacao,'
      '       ct.analista as analista,'
      '       ct.primogenito,'
      ''
      '       (Select nome'
      '        From usuarios U'
      '        Where U.codigo =  ct.analista) as Nomeanalista,'
      ''
      '       (Select coalesce(razao,nome)'
      '        From vfornecedores f'
      
        '        Where f.codigo = ct.cliente and f.tipo = ct.tipocliente)' +
        ' as NomeCliente,'
      ''
      '        False as Selecionar,'
      '        ct.nrpontos,'
      '        ct.limitecredito,'
      '        ct.limitedisponivel,'
      '        ct.limiteparcela,'
      '        ct.aberto30dias,'
      '        (select restricoes'
      '         from conceitos'
      '         where codigo = ct.conceito) as restricoesconceito,'
      ''
      '        false as semcredito,'
      '        '#39#39' as tiposemcredito,'
      '        cast(null as char(1)) as situacao_produtos,'
      '        ct.plano,'
      '        ct.vendedor,'
      
        '        (select u.nome from usuarios u where u.codigo = ct.vende' +
        'dor) as nomevendedor,'
      ''
      
        '        (select pl.descricao from planos pl where pl.codigo = ct' +
        '.plano) as DescricaoPlano,'
      '        ct.quitado,'
      
        '        (select true from pedidos_site p_s where p_s.contrato = ' +
        'ct.numero) as site,'
      '        '
      '        (select contrato_atual(ct.numero)) as contrato_atual,'
      ''
      '       cast (case when ct.situacao = '#39'O'#39' then '#39'OR'#199'ADO'#39
      '                        when ct.situacao = '#39'R'#39' then '#39'RESERVADO'#39
      '                        when ct.situacao = '#39'F'#39' then '#39'FATURADO'#39
      
        '                        when ct.situacao = '#39'P'#39' then '#39'NOTA PARCIA' +
        'L'#39
      
        '                        when ct.situacao = '#39'N'#39' then '#39'NOTA FISCAL' +
        #39
      '                        when ct.situacao = '#39'C'#39' then '#39'CANCELADO'#39
      '             end as varchar(20)) as NomeSituacao'
      ''
      ''
      'From    contratos ct'
      'Where true'
      ''
      '        %Situacao'
      '        %Filial'
      '        %Vendedor'
      '        %ContratosFuturo'
      ''
      'Order By ct.faturamento,ct.data,cast(ct.numero as bigint)')
    RequestLive = True
    Left = 56
    Top = 24
