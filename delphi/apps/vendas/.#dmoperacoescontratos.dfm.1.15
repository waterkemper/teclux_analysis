  object qryProdutosSituacao: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'produto=produto;filial=filial'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrProdutosEntregar
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select pc.produto,'
      '       pc.filial,'
      '       pc.qtdade,  '
      '       e.emestoque,'
      '       e.reservado,'
      '       e.futuro,'
      
        '       cast(case when (pc.qtdade > (e.reservado + e.emestoque)) ' +
        '  then '#39'N'#39
      
        '            when (pc.qtdade <=  (e.reservado + e.emestoque)) the' +
        'n '#39'A'#39
      '            when ((e.reservado + e.emestoque) > 0) and'
      '                 (qtdade > (e.reservado + e.emestoque)) then '#39'P'#39
      '       else '#39'?'#39
      '       end as varchar(1)) as situacao_produto    '
      'from'
      '( '
      ' Select pc.produto,'
      '        pc.filial,'
      
        '        sum(pc.quantidade-coalesce(pc.cancelado,0))-sum(coalesce' +
        '(pd.quantidade,0))  as qtdade'
      ' from (contratos ct '
      '        join (produtoscontratos pc '
      '              left join (select pdf.produto,'
      '                                pdf.filial,'
      
        '                                sum(pdf.quantidade) as quantidad' +
        'e'
      '                         from (dadosfiscais df '
      '                               join produtosdadosfiscais pdf '
      '                               on df.numero = pdf.dadofiscal)'
      '                         where df.numero = pdf.dadofiscal  '
      '                           and df.contrato in ( '
      '                                               select ct.numero'
      '                                               from contratos ct'
      
        '                                               where ct.situacao' +
        ' in ('#39'R'#39','#39'F'#39','#39'P'#39') '
      
        '                                                 and (ct.os IS N' +
        'ULL OR not ct.os)'
      
        '                                                 and not exists ' +
        '(select c2.numero from contratos c2 where c2.origem = ct.numero)'
      '                                               order by numero'
      '                                               )'
      '                           and df.situacao = '#39'N'#39
      '                         group by pdf.produto,pdf.filial'
      
        '                        ) pd on pc.produto = pd.produto and pc.f' +
        'ilial = pd.filial)'
      '        on ct.numero = pc.contrato)'
      '          '
      ' where ct.numero = pc.contrato'
      '   and ct.situacao in ('#39'R'#39','#39'F'#39','#39'P'#39') '
      
        '   and (ct.os IS NULL OR not ct.os)  and not exists (select c2.n' +
        'umero from contratos c2 where c2.origem = ct.numero)'
      ''
      ' group by pc.produto, pc.filial'
      
        ' having sum(pc.quantidade-coalesce(pc.cancelado,0)) > sum(coales' +
        'ce(pd.quantidade,0))'
      ') pc'
      'natural join estoques e'
      'order by produto, filial')
    RequestLive = False
    Left = 104
    Top = 328
    object qryProdutosSituacaoproduto: TLargeintField
      FieldName = 'produto'
    end
    object qryProdutosSituacaofilial: TIntegerField
      FieldName = 'filial'
    end
