end;

procedure TdtmOperacoesContratos.MarcarRequisitado;
begin

  qrycontratos.edit;
  qryContratosrequisitado.AsBoolean := not qryContratosrequisitado.AsBoolean;
  qrycontratos.Post;

  updContrato.Sql.Clear;
  updContrato.Sql.Add('UPDATE contratos');
  if qryContratosrequisitado.AsBoolean then
    updContrato.Sql.Add('SET requisitado = true')
  else
    updContrato.Sql.Add('SET requisitado = false');

  updContrato.Sql.Add('WHERE numero = '+quotedstr(qryContratosnumero.AsString));
  updContrato.ExecSql;
  perpetrar([]);


end;


procedure TdtmOperacoesContratos.ManterLista_CST_CSOSN_Marcados(
  Valor: String; Adicionar: Boolean);
begin
  if lstckbCST_CSOSN = nil then
    lstckbCST_CSOSN := tStringList.create;

  if Adicionar then
    lstckbCST_CSOSN.append(Valor)
  else
    lstckbCST_CSOSN.Delete(lstckbCST_CSOSN.IndexOf(Valor));

  SetarFiltroContrato;
end;

function TdtmOperacoesContratos.ExistelstckbCST_CSOSN: Boolean;
begin
  if lstckbCST_CSOSN = nil then
    result := false
  else
    result := (lstckbCST_CSOSN.count <> 0)
end;

function TdtmOperacoesContratos.GetProduto: String;
begin
  result := qryProdutosEntregarproduto.asString
end;

