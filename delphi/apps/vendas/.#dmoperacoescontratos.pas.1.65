procedure TdtmOperacoesContratos.ImprimirListaProdutosporLocalizacao;
var
  vLista: String;
begin
  if not Assigned(ImpressaoContrato) then
    ImpressaoContrato := TdtmImprimeContratos.Create(Self);
  try
    vLista := RetornarLista(qryContratos, qryContratosNumero, qryContratosselecionar, false);

    ImpressaoContrato.ImprimirListaProdutosporLocalizacao(vLista, situacao, qryProdutosEntregar);

  finally
    ImpressaoContrato.Free;
    ImpressaoContrato := nil;
  end;
end;

procedure TdtmOperacoesContratos.SetListaExtraContratos(
  const Value: TMemo);
var
  vLista : String;
  i: integer;
begin
  fListaExtraContratos := Value;
  if Value.Lines.Count <> 0 then
  begin
    vLista := '';
    for i:=0 to Value.Lines.Count-1 do
    begin
      vLista := vLista + quotedstr(value.Lines[i]);
      if i <> Value.Lines.Count-1 then
        vLista := vLIsta+', '
    end;


    qryContratos.MacroByName('ListaExtraContratos').asString := 'and ct.numero in ('+vLista+')'
  end
  else
    qryContratos.MacroByName('ListaExtraContratos').asString := '';

end;

