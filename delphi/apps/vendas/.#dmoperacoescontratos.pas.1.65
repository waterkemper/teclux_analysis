procedure TdtmOperacoesContratos.dsContratosAprovarDataChange(
  Sender: TObject; Field: TField);
begin
  inherited;
  if field = qryContratoslocalizacao then
  begin
    updContrato.Sql.Clear;
    updContrato.Sql.Add('UPDATE contratos set localizacao = ');
    updContrato.Sql.Add(quotedstr(qryContratoslocalizacao.asString));
    updContrato.Sql.Add('WHERE numero = '+quotedstr(qryContratosnumero.AsString));
    updContrato.ExecSql;
    perpetrar([]);
  end;
end;

