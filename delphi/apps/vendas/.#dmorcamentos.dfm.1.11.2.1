        'ade1) as linha,'
      
        '         (select g.descricao from grades g where g.codigo = c.gr' +
        'ade2) as coluna,'
      
        '          coalesce(:codigobarras,cast(0 as varchar(60))) as codi' +
        'gobarras,'
      '          e.filial,'
      '          e.emestoque,'
      '          e.reservado,'
      
        '          (select estoques_produtoempromocao(p.codigo,:filialbas' +
        'e)) as promocao,'
      '          c.unidade,'
      '          c.brinde,'
      '          c.montagem,'
      '          c.vendanegativa as vendasemestoque,'
      '          c.composto'
      ''
      ''
      ''
      ''
      ''
      ''
      'from caracteristicas c, produtos p, estoques e'
      'where (p.codigo in ((select :produto)'
      '                    union all'
      '                   (select pcb.produto'
      '                    from produtoscodigobarras pcb'
      
        '                    where pcb.codigobarras=coalesce(:codigobarra' +
        's,cast(0 as varchar(30))))'
