      '           o.fone2numero,'
      '           o.fone2ramal,'
      '           o.motivo,'
      '           o.cancelamento,'
      '           o.contrato,'
      '           (select b.nome from bairros b'
      
        '            where (b.estado = o.estado) and (b.cidade = o.cidade' +
        ') and (b.codigo = o.bairro)'
      '           ) as nomebairro,'
      '           (select d.nome from cidades d'
      
        '            where (d.estado = o.estado) and (d.codigo = o.cidade' +
        ')'
      '           ) as nomecidade,'
      
        '           m.descricao as descricaomotivo , cast(0 as Numeric(9,' +
        '3)) as totalqtdeprodutos'
      
        'From   orcamentos o left join motivos m on (o.motivo  = m.codigo' +
        ')'
      'Where (o.codigo =:codigo)')
