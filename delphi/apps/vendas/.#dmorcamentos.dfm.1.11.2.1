    Sql.Strings = (
      'Select o.codigo,'
      '           o.emissao,'
      '           o.validade,'
      '           o.cliente,'
      '           o.tipocliente,'
      '           o.vendedor,'
      '           o.filial,'
      
        '           (select sum(po.quantidade * po.precovenda) from produ' +
        'tosorcamentos po where po.orcamento = o.codigo) as totalprodutos' +
        ','
      
        '           (select sum(so.quantidade * so.valorservico) from ser' +
        'vicosorcamentos so where so.orcamento = o.codigo) as totalservic' +
        'os,'
      '           o.frete,'
      '           o.seguro,'
      '           o.filialmontagem,'
      '           o.situacao,'
      '           cast (case when o.situacao = '#39'A'#39' then '#39'ABERTO'#39
      
        '                            when o.situacao = '#39'C'#39' then '#39'CANCELAD' +
        'O'#39
      '                            when o.situacao = '#39'P'#39' then '#39'PARCIAL'#39
      
        '                            when o.situacao = '#39'T'#39' then '#39'CONTRATO' +
        #39
      '                    end as varchar) as descricaosituacao,'
      '           o.nome,'
      '           o.pessoatipo,'
      '           o.pessoanumero,'
      '           o.rua,'
      '           o.numero,'
      '           o.complemento,'
