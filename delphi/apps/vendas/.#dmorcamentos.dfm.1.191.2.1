        ')'
      
        '                     and c2.codigo = coalesce(:entcidade,:cidade' +
        '))'
      '                    )'
      '  '
      ''
      '  and  ((pc.quantidade -'
      ''
      '           coalesce((select sum(ctd.quantidade)'
      '                     from contratosdevolvidos ctd'
      '                     where ctd.contrato = pc.contrato'
      '                       and ctd.produto = pc.produto'
