      '           v.rua,'
      '           v.numero,'
      '           v.complemento,'
      '           v.tipo,'
      '           descricao_tipocliente(v.tipo) as tipocliente,'
      '           c.nome as nomecidade, v.email'
      'From   vfornecedores v, cidades c'
      'Where false   /* Alterado em RumTime  */     '
      '    and (v.estado = c.estado)'
      '    and (v.cidade = c.codigo)'
      
        'Order by UPPER(pg_catalog.TO_ASCII(coalesce(v.razao,v.nome),'#39'LAT' +
        'IN1'#39'))')
