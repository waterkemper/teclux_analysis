    AfterScroll = qryProcuraClienteAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select coalesce(v.razao,v.nome) as nome,'
      '       v.pessoatipo,'
      '       v.pessoanumero,'
      '       v.codigo,'
      '       v.civil,'
      '       v.rua,'
      '       v.numero,'
      '       v.complemento,'
      '       v.bairro,'
      '       v.cidade,'
      '       v.estado,'
      ''
      '       v.cep,'
      '       v.foneddd,'
      '       v.fonenumero,'
      '       v.foneramal,'
      ''
      '       case when v.tipo = '#39'C'#39' then (select c.fone2ddd'
      '                                    from clientes c'
      '                                    where c.codigo = v.codigo)'
      
        '                              else  v.fonedddempresa end as fone' +
        '2ddd,'
      ''
      '       case when v.tipo = '#39'C'#39' then (select c.fone2numero'
      '                                    from clientes c'
      '                                    where c.codigo = v.codigo)'
      
        '                              else  v.fonenumeroempresa end as f' +
        'one2numero,'
      ''
      '       case when v.tipo = '#39'C'#39' then (select c.fone2ramal'
      '                                    from clientes c'
      '                                    where c.codigo = v.codigo)'
      
        '                              else  v.foneramalempresa end as fo' +
        'ne2ramal,'
      ''
      '       v.email,'
      '       v.markup,'
      ''
      '       (select c.empcargo'
      '        from clientes c'
      '        where c.codigo = :codigo) as cargocliente,'
      ''
      '       v.tipo as tipoorig,'
      ''
      '       (select b.nome'
      '        from bairros b'
      '        where (b.codigo = v.bairro) and'
      '                  (b.cidade = v.cidade) and'
      '                  (b.estado = v.estado)'
      '       ) as nomebairro,'
      ''
      ''
      ''
      '       (select c.nome'
      '        from cidades c'
      '        where (c.codigo = v.cidade) and'
      '                  (c.estado = v.estado)'
      '       ) as nomecidade,'
      ''
      ''
      '       (select c.empcargo'
      '        from clientes c'
      '        where c.codigo = v.codigo'
      '          and v.tipo = '#39'C'#39') as empcargo,'
      '       v.sexo,'
      ''
      '       coalesce((select c.fonetipo'
      '        from clientes c'
      '        where c.codigo = v.codigo'
      
        '          and v.tipo = '#39'C'#39'), cast('#39'P'#39' as varchar(1))) as fonetip' +
        'o,'
      ''
      '       coalesce((select c.restipo'
      '        from clientes c'
      '        where c.codigo = v.codigo'
      
        '          and v.tipo = '#39'C'#39'), cast('#39'P'#39' as varchar(1))) as restipo' +
        ','
      ''
      '       coalesce((select c.reftipo'
      '        from clientes c'
      '        where c.codigo = v.codigo'
      
        '          and v.tipo = '#39'C'#39'), cast('#39'P'#39' as varchar(1))) as reftipo' +
        ','
      ''
      '       coalesce((select c.empcomprovado'
      '        from clientes c'
      '        where c.codigo = v.codigo'
      
        '          and v.tipo = '#39'C'#39'), cast(false as boolean)) as empcompr' +
        'ovado,'
      ''
      '       coalesce((select c.automovel'
      '        from clientes c'
      '        where c.codigo = v.codigo'
      
        '          and v.tipo = '#39'C'#39'), cast(false as boolean)) as automove' +
        'l,'
      ''
      '       coalesce((select c.cartaocredito'
      '        from clientes c'
      '        where c.codigo = v.codigo'
      
        '          and v.tipo = '#39'C'#39'), cast(false as boolean)) as cartaocr' +
        'edito,'
      ''
      '       coalesce((select c.cartaoloja'
      '        from clientes c'
      '        where c.codigo = v.codigo'
      
        '          and v.tipo = '#39'C'#39'), cast(false as boolean)) as cartaolo' +
        'ja,'
      ''
      '       coalesce((select c.cheque'
      '        from clientes c'
      '        where c.codigo = v.codigo'
      '          and v.tipo = '#39'C'#39'), cast(false as boolean)) as cheque,'
      ''
      '       coalesce((select c.chequeespecial'
      '        from clientes c'
      '        where c.codigo = v.codigo'
      
        '          and v.tipo = '#39'C'#39'), cast(false as boolean)) as chequees' +
        'pecial,'
      ''
      '       v.conceito,'
      '       v.contribicms,'
      '       v.inscricaoestadual,'
      ''
      '       coalesce((select c.consumidorfinal'
      '        from clientes c'
      '        where c.codigo = v.codigo'
      '          and v.tipo = '#39'C'#39'), false) as consumidorfinal,'
      ''
      
        '       case when v.tipo = '#39'C'#39' then (select c.naoexibirfichafinan' +
        'ceira from clientes c where c.codigo = :codigo)'
      '            else false'
      '       end as naoexibirfichafinanceira,'
      ''
      
        '       case when v.tipo = '#39'C'#39' then (select c.vendedor from clien' +
        'tes c where c.codigo = :codigo)'
      '            else cast(null as integer)'
      '       end as vendedor,'
      ''
      '       (select count(*)'
      '        from orcamentos o2'
      '        where o2.cliente = v.codigo'
      '          and o2.tipocliente = v.tipo'
      '          and o2.situacao = '#39'A'#39') as qtOrcamentoemAberto,'
      ''
      '       (select count(*)'
      '        from orcamentos o2'
      '        where o2.cliente = v.codigo'
      '          and o2.tipocliente = v.tipo'
      '          and o2.situacao = '#39'C'#39') as qtOrcamentoCancelado,'
      ''
      '       (select count(*)'
      '        from orcamentos o2'
      '        where o2.cliente = v.codigo'
      '          and o2.tipocliente = v.tipo'
      '          and o2.situacao = '#39'T'#39') as qtOrcamentoContrato'
      ''
      'from   vfornecedores v'
      ''
      
        'where (v.codigo = :codigo and v.tipo = :tipo and :pesquisandovia' +
        'codigo)'
      ''
      '     or (v.pessoanumero = :pessoanumero  and'
      '         coalesce(v.pessoanumero,'#39#39')<>'#39#39' and'
      
        '         v.tipo = :tipo                      and :pesquisandovia' +
        'pessoanumero)'
      ''
      'order by UPPER(pg_catalog.TO_ASCII(nome,'#39'LATIN1'#39'))')
    RequestLive = False
    Left = 68
    Top = 77
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'tipo'
        ParamType = ptUnknown
      end
