      '     and coalesce(ct.entcidade, ct.cidade) = b.cidade'
      '     and coalesce(ct.entbairro, ct.bairro) = b.codigo'
      ''
      '     join cidades c'
      '     on coalesce(ct.entestado, ct.estado) = c.estado'
      '     and coalesce(ct.entcidade, ct.cidade) = c.codigo'
      ''
      '     join regioes r on coalesce(b.regiao, c.regiao) = r.codigo'
      '     '
      ''
      'where coalesce(pc.entrega,'#39'N'#39')='#39'S'#39
      '  and ct.situacao in ('#39'F'#39','#39'P'#39')'
      ''
      '  and pc.dataentrega = :dataentrega'
      '  and pc.periodoentrega = :periodoentrega'
      '  and r.codigo = coalesce('
      ''
      '                 (select b2.regiao'
      '                  from bairros b2'
      
        '                  where b2.estado = coalesce(:entestado, :estado' +
        ')'
      
        '                    and b2.cidade = coalesce(:entcidade, :cidade' +
        ')'
      
        '                    and b2.codigo = coalesce(:entbairro, :bairro' +
