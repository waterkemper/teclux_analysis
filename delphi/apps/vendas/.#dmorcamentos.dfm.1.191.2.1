    Constraints = <>
    BeforeOpen = qryProcuraProdutoBeforeOpen
    AfterOpen = qryProcuraProdutoAfterOpen
    OnCalcFields = qryProcuraProdutoCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'SelecaoPorReferencia'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltrarProdutosEFiliaisContratos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SelecionarProdutosListaCasamento'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select    p.descricao,'
      '          p.codigo as produto,'
      '          p.codigovisual as produtovisual,'
      '          p.caracteristica,'
      '          p.valorgrade1,'
      '          p.valorgrade2,'
      '          c.anvisa,'
      
        '         (select g.descricao from grades g where g.codigo = c.gr' +
        'ade1) as linha,'
      
        '         (select g.descricao from grades g where g.codigo = c.gr' +
        'ade2) as coluna,'
      
        '          coalesce(:codigobarras,cast(0 as varchar(60))) as codi' +
        'gobarras,'
      '          e.filial,'
      '          e.emestoque,'
      '          e.reservado,'
      
        '          (select estoques_produtoempromocao(p.codigo,:filialbas' +
        'e)) as promocao,'
      '          c.unidade,'
      '          c.brinde,'
      '          c.montagem,'
      '          c.vendanegativa as vendasemestoque,'
      '          c.composto,'
      '          c.emitecomplemento,'
      '          c.complemento,'
      
        '          (select ipi.classificacaofiscal from ipi where ipi.cod' +
        'igo = c.ipi) as classificacaofiscal,'
      ''
      ''
      
        '         cast(case when trim(COALESCE(c.observacoesvenda,'#39#39'))<>'#39 +
        #39'  then'
      
        '                         '#39'Obs. Produto: '#39'||c.codigovisual||chr(1' +
        '3)||chr(10)||c.observacoesvenda||chr(13)||chr(10) '
      '                   else '#39#39' '
      '              end||chr(13)||chr(10)||'
      '              '
      
        '              case when trim(COALESCE(g.observacoesvenda,'#39#39'))<>'#39 +
        #39' then'
      
        '                         '#39'Obs. Grupo: '#39'||g.codigo||chr(13)||chr(' +
        '10)||g.observacoesvenda||chr(13)||chr(10)'
      '                   else '#39#39' '
      '              end||chr(13)||chr(10)||'
      '              '
      
        '              case when trim(COALESCE(cl.observacoesvenda,'#39#39'))<>' +
        #39#39' then'
      
        '                         '#39'Obs. Classe: '#39'||cl.codigo||chr(13)||ch' +
        'r(10)||cl.observacoesvenda||chr(13)||chr(10)'
      '                   else '#39#39' '
      '              end||chr(13)||chr(10)||            '
      '         '
      
        '              case when trim(COALESCE(m.observacoesvenda,'#39#39'))<>'#39 +
        #39' then'
      
        '                         '#39'Obs. Marca: '#39'||cast(m.codigo as varcha' +
        'r)||chr(13)||chr(10)||m.observacoesvenda||chr(13)||chr(10)      ' +
        '   '
      '                   else '#39#39' '
      '              end||chr(13)||chr(10)|| '
      '         '
      
        '              case when trim(COALESCE(pro.observacoesvenda,'#39#39'))<' +
        '>'#39#39' then'
      
        '                         '#39'Obs. Promo'#231#227'o: '#39'||cast(pro.codigo as v' +
        'archar)||'#39' - '#39'||pro.descricao||chr(13)||chr(10)||pro.observacoes' +
        'venda||chr(13)||chr(10)'
      '                   else '#39#39' '
      '              end as varchar(8160)) as observacoesvenda,'
      ''
      
        '              coalesce(pro.deny_discount,false) as deny_discount' +
        ','
      ''
      '              p.promocao as codigopromocao,'
      '              pro.descricao as descricaopromocao,'
      '              g.codigo as grupo,'
      '              g.descricao as descricaogrupo'
      ''
      ''
      ''
      
        'from caracteristicas c, (produtos p left join promocoes pro on p' +
        '.promocao = pro.codigo), estoques e, grupos g, classes cl, marca' +
        's m'
      ''
      'where ( p.codigo  in'
      '                  ((select pcb.produto'
      '                    from produtoscodigobarras pcb'
      '                    where pcb.codigobarras = :produtovisual)'
      ''
      '                    union all'
      ''
      '                    (select p2.codigo'
      '                     from produtos p2'
      
        '                     where upper(custom_to_ascii(p2.codigovisual' +
        ')) = upper(custom_to_ascii(:produtovisual)))'
      ''
      '                    %SelecaoPorReferencia'
      '                   ))'
      ''
      '   and (p.inativo is null)'
      '   and (c.codigo = p.caracteristica)'
      '   and (p.codigo = e.produto)'
      '   and (c.grupo=g.codigo)'
      '   and (c.classe=cl.codigo)'
      ''
      '   and (c.marca=m.codigo)'
      '   and (e.filial =:filialsaida)'
      
        '   and (case when :ConsiderarMarkupClientes then(estoques_preco(' +
        'p.codigo, cast(:FilialPreco as integer), cast((coalesce(:markup,' +
        '0)) as numeric) ) > 0)'
      
        '             when :ConsiderarMarkupcargos then (estoques_preco(p' +
        '.codigo, cast(:FilialBase as integer), cast((coalesce(:MarkupCar' +
        'gos,0)) as numeric) ) >0)'
      
        '             else (estoques_preco(p.codigo, :FilialBase) > 0) en' +
        'd)'
      '   and coalesce(c.disponivel_sistema,false)          '
      '%FiltrarProdutosEFiliaisContratos'
      '%SelecionarProdutosListaCasamento'
      ''
      
        'order by UPPER(pg_catalog.TO_ASCII(p.descricao,'#39'LATIN1'#39')), p.val' +
        'orgrade1, p.valorgrade2'
      ''
      ''
      '/*'
      ''
      'par'#226'metro'
      ':produtovisual'
      ''
      '*/'
      '')
    RequestLive = False
    Left = 80
    Top = 118
    ParamData = <
      item
        DataType = ftString
        Name = 'codigobarras'
        ParamType = ptUnknown
      end
      item
