  object qryOrcamentos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryOrcamentosAfterOpen
    AfterClose = qryOrcamentosAfterClose
    BeforeEdit = qryOrcamentosBeforeEdit
    BeforePost = qryOrcamentosBeforePost
    AfterCancel = qryOrcamentosAfterCancel
    AfterScroll = qryOrcamentosAfterScroll
    OnCalcFields = qryOrcamentosCalcFields
    OnNewRecord = qryOrcamentosNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select o.codigo,'
      '           o.emissao,'
      '           o.validade,'
      '           o.cliente,'
      '           o.tipocliente,'
      '           o.vendedor,'
      '           o.filial,'
      ''
      '           /*'
      
        '            ((select sum(po.quantidade * po.precovenda)  from pr' +
        'odutosorcamentos po'
      '             where po.orcamento = o.codigo) -'
      ''
      '             (select sum(po.valordescontoitem)'
      '             from produtosorcamentos po'
      '              where po.orcamento = o.codigo)) as totalprodutos,'
      '              */'
      ''
      
        '           (select sum((po.quantidade * po.precovenda)-coalesce(' +
        'po.valordescontoitem,0))'
      '            from produtosorcamentos po'
      '            where po.orcamento= o.codigo) as totalprodutos,'
      ''
      ''
      
        '           (select sum(so.quantidade * so.valorservico) from ser' +
        'vicosorcamentos so where so.orcamento = o.codigo) as totalservic' +
        'os,'
      '           o.frete,'
      '           o.seguro,'
      '           o.filialmontagem,'
      '           o.situacao,'
      '           cast (case when o.situacao = '#39'A'#39' then '#39'ABERTO'#39
      
        '                            when o.situacao = '#39'C'#39' then '#39'CANCELAD' +
        'O'#39
      '                            when o.situacao = '#39'P'#39' then '#39'PARCIAL'#39
      
        '                            when o.situacao = '#39'T'#39' then '#39'CONTRATO' +
        #39
      '                    end as varchar(10)) as descricaosituacao,'
      '           o.nome,'
      '           o.pessoatipo,'
      '           o.pessoanumero,'
      '           o.rua,'
      '           o.numero,'
      '           o.complemento,'
      '           o.bairro,'
      '           o.cidade,'
      '           o.estado,'
      '           o.cep,'
      '           o.observacao,'
      '           O.montagemobs,'
      '           o.email,'
      '           o.foneddd,'
      '           o.fonenumero,'
      '           o.foneramal,'
      '           o.fone2ddd,'
      '           o.fone2numero,'
      '           o.fone2ramal,'
      '           o.motivo,'
      '           o.cancelamento,'
      '           o.contrato,'
      
        '           (select ct.situacao from contratos ct where ct.numero' +
        ' = o.contrato) as situacaocontrato,'
      '           (select b.nome from bairros b'
      
        '            where (b.estado = o.estado) and (b.cidade = o.cidade' +
        ') and (b.codigo = o.bairro)'
      '           ) as nomebairro,'
      '           (select d.nome from cidades d'
      
        '            where (d.estado = o.estado) and (d.codigo = o.cidade' +
        ')'
      '           ) as nomecidade,'
      
        '           m.descricao as descricaomotivo , cast(0 as Numeric(9,' +
        '3)) as totalqtdeprodutos,'
      ''
      '           o.disponibilizarparavenda,'
      '           o.creditotroca,'
      '           o.empcargo,'
      '           o.descricaocancelamento,'
      '           o.cupom_desconto,'
      '           (select c_p.codigo_cupom'
      '            from cupons_desconto c_p'
      
        '            where c_p.codigo = o.cupom_desconto) as codigo_cupom' +
        ','
      ''
      '           o.cupom_valor_desconto,'
      '           o.aparecernosite,'
      '           o.descontogeral,'
      '           o.percentualdescontogeral,'
      '           o.definirdadosentregaparatodos,'
      '           o.entrega,'
      '           o.dataentrega,'
      '           o.horaentrega,'
      '           o.periodoentrega,'
      '           o.entnomedestinatario,'
      '           o.entrua              ,'
      '           o.entnumero           ,'
      '           o.entcomplemento      ,'
      '           o.entbairro           ,'
      '           o.entcep              ,'
      '           o.entcidade           ,'
      '           o.fornecedorfrete     ,'
      '           o.frete_transportadora,'
      '           o.frete_servico       ,'
      '           o.frete_mensagem      ,'
      '           o.frete_prazo_entrega,'
      '           o.entestado,'
      ''
      '           (select b.nome'
      '            from bairros b'
      '            where (b.estado = o.entestado) and'
      '                  (b.cidade = o.entcidade) and'
      '                  (b.codigo = o.entbairro)'
      '           ) as nomebairroentrega,'
      ''
      '           (select d.nome'
      '            from cidades d'
      '            where (d.estado = o.entestado) and'
      '                  (d.codigo = o.entcidade)'
      '           ) as nomecidadeentrega,'
      ''
      '           o.filial_retirada,'
      
        '           (select f.nome from filiais f where f.codigo =  o.fil' +
        'ial_retirada) as nomefilialretirada,'
      
        '           (select f.contribicms from filiais f where f.codigo =' +
        ' o.filial) as contribicmsemitente,'
      '           o.contribicms,'
      '           o.vendaconsumidorfinal,'
      ''
      ''
      '           o.codigofretes_isencao,'
      '           o.codigotabela_frete,'
      '           o.desconto_cashback,'
      '           o.impostoretido'
      
        '          /* o.desconto  campo existe mas n'#227'o '#233' usado para nada ' +
        '*/'
      ''
      
        'From   orcamentos o left join motivos m on (o.motivo  = m.codigo' +
        ')'
      'Where (o.codigo =:codigo)')
    RequestLive = True
    Left = 112
    Top = 206
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end>
