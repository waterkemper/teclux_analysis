    Sql.Strings = (
      ';'
      ' select estoquepreco2.*,'
      '        cast(null as varchar) as avancado'
      ' from'
      '('
      
        ' select produto, produtovisual, filial, emestoque, reservado, de' +
        'scricao, valorgrade1,  valorgrade2, referencia,caracteristica,  ' +
        'preco, unidade, brinde,'
      
        '          (select count(*) from similares where similares.caract' +
        'eristica = estoquepreco1.caracteristica) as similares,'
      
        '          case when coalesce(estoquepreco1.valorproduto,0)=0 the' +
        'n'
      '               (SELECT valor'
      '                FROM colunasprecos'
      
        '                WHERE (colunasprecos.caracteristica = estoquepre' +
        'co1.caracteristica) AND'
      
        '                              (colunasprecos.preco = estoqueprec' +
        'o1.preco) AND'
      
        '                             (colunasprecos.coluna = estoqueprec' +
        'o1.preconormal))'
      '          else  coalesce(estoquepreco1.valorproduto,0)'
      '          end as valorproduto, comissao_produto, comissao_grupo,'
      
        '          tipocomissao_produto, tipocomissao_grupo, rank_achou, ' +
        'rank, rank_or'
      ' from'
      '('
      ' select estoque.*,'
      
        '       case when :ConsiderarMarkupCliente and ((coalesce(:markup' +
        ',0)) > 0) and (estoque.valorultimacompra > 0) then'
      
        '                  estoques_preco(estoque.produto, cast(:FilialBa' +
        'se as integer), cast(:Markup as numeric))'
      
        '            when :ConsiderarMarkupCargos and ((coalesce((Select ' +
        'pc.markup from produtoscargos pc'
      
        '                                                                ' +
        '       where pc.cargo =:Cargo'
      
        '                                                                ' +
        '       and pc.produto = estoque.produto),0)) > 0) and (estoque.v' +
        'alorultimacompra > 0) then'
      
        '                  estoques_preco(estoque.produto, cast(:FilialBa' +
        'se as integer),(Select pc.markup from produtoscargos pc'
      
        '                                                                ' +
        '       where pc.cargo =:Cargo'
      
        '                                                                ' +
        '       and pc.produto = estoque.produto))'
      '            when estoque.precopromocao is not null then'
      '                (SELECT valor'
      '                 FROM colunasprecos'
      
        '                 WHERE (colunasprecos.caracteristica = estoque.c' +
        'aracteristica) AND'
      '                       (colunasprecos.preco = estoque.preco) AND'
      
        '                       (colunasprecos.coluna = estoque.precoprom' +
        'ocao) AND'
      '                       (colunasprecos.validade >= now())'
      '                )'
      
        '            else estoques_preco(estoque.produto, :FilialBase) en' +
        'd as valorproduto'
      ' from'
      ' ('
      '  select e.produto,'
      '         p.codigovisual as produtovisual,'
      '            e.filial,'
      '            e.emestoque,'
      '            e.reservado,'
      '            e.valorultimacompra,'
      '            p.descricao,'
      '            p.valorgrade1,'
      '            p.valorgrade2,'
      '            p.referencia,'
      '            p.caracteristica,'
      '            p.preco,'
      '            c.unidade,'
      '            c.brinde,'
      '            case when :PrecodaFilialBase then'
      
        '              (select f.preconormal from filiais f where f.codig' +
        'o = :FilialBase)'
      
        '            else (select f.preconormal from filiais f where  f.c' +
        'odigo = e.filial)'
      '            end as preconormal,'
      '            case when :PrecodaFilialBase then'
      
        '              (select f.precopromocao from filiais f where f.cod' +
        'igo = :FilialBase)'
      
        '            else (select f.precopromocao from filiais f where  f' +
        '.codigo = e.filial)'
      '            end as precopromocao,'
      '            c.comissao as comissao_produto,'
      '            g.comissao as comissao_grupo,'
      '            g.tipocomissao as tipocomissao_grupo,'
      '            c.tipocomissao as tipocomissao_produto,'
      ''
      
        '            ts_rank_cd(p.busca,plainto_tsquery(converte_texto(:t' +
        'extopesquisa)), 32)>0 AS rank_achou,'
      
        '            ts_rank_cd(p.busca,plainto_tsquery(converte_texto(:t' +
        'extopesquisa)), 32) AS rank,'
      '            ts_rank_cd(p.busca, query, 32) AS rank_or'
      ''
      ''
      ''
      
        '  from (estoques e  join (produtos p join (caracteristicas c joi' +
        'n grupos g on c.grupo = g.codigo) on p.caracteristica = c.codigo' +
        ')'
      
        '                                                 on e.produto = ' +
        'p.codigo)'
      ''
      
        '      , (select cast(replace(cast(plainto_tsquery(converte_texto' +
        '(:textopesquisa)) as varchar),'#39#39#39#39','#39#39') as tsquery) as query) as ' +
        'query'
      ''
      '  where  ((p.inativo is null ) or  (p.inativo>current_date))'
      '    and coalesce(c.disponivel_sistema,false)'
      ''
      '  %FilialIndependente'
      ''
      '  %ProdutosFiliaisContratos'
      ''
      '  %ProdutosInterno'
      ''
      ' ) as estoque'
      ') as estoquepreco1'
      ') as estoquepreco2'
      'where (valorproduto > 0)'
      ''
      '%Produtos'
      ''
      '%SQLOrdenacao'
      ''
      '')
    RequestLive = False
    Left = 406
