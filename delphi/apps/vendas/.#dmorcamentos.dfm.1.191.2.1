  object qryConsultaOrcamentos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select coalesce(vf.razao,o.nome) as nome,vf.nome as apelido,'
      '       o.codigo,'
      '       o.emissao,'
      '       cast (case when o.situacao = '#39'A'#39' then '#39'A - ABERTO'#39
      '                  when o.situacao = '#39'C'#39' then '#39'C - CANCELADO'#39
      '                  when o.situacao = '#39'P'#39' then '#39'P - PARCIAL'#39
      '                  when o.situacao = '#39'T'#39' then '#39'T - CONTRATO'#39
      '       end as varchar) as situacao,'
      '       o.email'
      ''
      
        'From orcamentos o left join vfornecedores vf on o.cliente = vf.c' +
        'odigo and o.tipocliente = vf.tipo'
      ''
      '/*         Preenchido em RunTime          */'
      ''
      'Order by UPPER(pg_catalog.TO_ASCII(o.nome,'#39'LATIN1'#39'))')
    RequestLive = False
    Left = 407
    Top = 501
