  qryProdutosOrcamentostotal.AsCurrency:= Truncar((qryProdutosOrcamentosquantidade.AsCurrency *
                                           qryProdutosOrcamentosprecovenda.AsCurrency-
                                           qryProdutosOrcamentosvalordescontoitem.AsCurrency),2);

  qryProdutosOrcamentosorcamento.AsVariant := qryOrcamentoscodigo.AsVariant;

end;

