procedure TdtmOrcamentos.AtribuirValorProduto;
var
   Pos: TBookmark;
begin
  if ParSistema.PrecosporCargo or  ParSistema.ConsiderarMarkupClientes then
  begin
    qryAlterarPrecoVenda.ParamByName('ConsiderarCargos').AsBoolean:= ParSistema.PrecosporCargo;
    qryAlterarPrecoVenda.ParamByName('ConsiderarClientes').AsBoolean:= ParSistema.ConsiderarMarkupClientes;
    qryAlterarPrecoVenda.ParamByName('PrecoFilialBase').AsBoolean:= ParSistema.UtilizarPrecoFilialBase;
    qryAlterarPrecoVenda.ParamByName('Filialbase').AsInteger:= ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
    qryAlterarPrecoVenda.ParamByName('Cargo').AsInteger:= {FCargoCliente} qryOrcamentosempcargo.asinteger;
    qryAlterarPrecoVenda.ParamByName('cliente').AsInteger := qryOrcamentoscliente.AsInteger;
    qryAlterarPrecoVenda.ParamByName('tipocliente').AsString := qryOrcamentostipocliente.AsString;


    if ParSistema.PrecosporCargo then
      qryAlterarPrecoVenda.ParamByName('Markup').AsFloat:= qryCargosClientemarkup.AsFloat
    else if ParSistema.ConsiderarMarkupClientes then
      qryAlterarPrecoVenda.ParamByName('Markup').AsFloat:= qryProcuraClientemarkup.AsCurrency;

    qryProdutosOrcamentos.DisableControls;
    Pos:= qryProdutosOrcamentos.GetBookmark;

    qryProdutosOrcamentos.First;
    while not qryProdutosOrcamentos.Eof do
    begin
      RefazConsultaPorNome(qryAlterarPrecoVenda,['Produto'],[qryProdutosOrcamentosproduto.AsLargeInt]);
      if qryProdutosOrcamentosprecovenda.AsFloat <> qryAlterarPrecoVendavalorproduto.ASfloat then
      begin
        qryProdutosOrcamentos.Edit;
        qryProdutosOrcamentosprecovenda.AsFloat:= qryAlterarPrecoVendavalorproduto.ASfloat;
        qryProdutosOrcamentos.Post;
      end;
      qryProdutosOrcamentos.Next;
    end;
    qryProdutosOrcamentos.GotoBookmark(Pos);
    qryProdutosOrcamentos.FreeBookmark(Pos);
    qryProdutosOrcamentos.EnableControls;
    CalcularValorTotalProdutos;
  end;

end;

function TdtmOrcamentos.ValidarDadosOrcamento: boolean;
begin
  result := qryOrcamentos.CheckRequiredFields;

  if result then
  begin
    if (qryProdutosOrcamentos.RecordCount + qryServicosOrcamento.RecordCount = 0) then
    begin
      MensagemAviso(ctORCAMENTOSEMPRODUTOSERVICO);
      result := false;
    end {
    else
    if FExisteEntrega and Not EnderecoCompleto then
    begin
      MensagemAviso(ctENDERECOIMCOMPLETO);
