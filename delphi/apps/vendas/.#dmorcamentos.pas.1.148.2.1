function TdtmOrcamentos.VerificarDadosAntesGravar(ds: array of TZDataSet): TtecVerificarDados;
var
 a: integer;
begin

  if qryOrcamentoscliente.AsInteger <> 0 then
  begin
    qryProcuraCliente.AfterScroll := nil;
    qryProcuraCliente.BeforeOpen := nil;
    qryProcuraCliente.AfterOpen := nil;
    dsrOrcamentos.OnDataChange := nil;

    dsrProcuraCliente.onDataChange := nil;
    RefazConsultaPorNome(qryProcuraCliente,['codigo','tipo', 'pessoanumero'],
     [qryOrcamentoscliente.AsInteger, qryOrcamentostipocliente.AsString, null]);

    if (qryOrcamentosnome.AsString <> qryProcuraClientenome.AsString) or
       (qryOrcamentospessoanumero.AsString <> qryProcuraClientepessoanumero.AsString) or
       (qryOrcamentospessoatipo.AsString <> qryProcuraClientepessoatipo.AsString) then
    begin
      qryOrcamentos.Edit;
      qryOrcamentosnome.AsString := qryProcuraClientenome.AsString;
      qryOrcamentospessoanumero.AsString := qryProcuraClientepessoanumero.AsString;
      qryOrcamentospessoatipo.AsString := qryProcuraClientepessoatipo.AsString;
      qryOrcamentos.Post;
    end;
    qryProcuraCliente.AfterOpen :=  qryProcuraClienteAfterOpen;
    qryProcuraCliente.AfterScroll := qryProcuraClienteAfterScroll;
    qryProcuraCliente.BeforeOpen := qryProcuraClienteBeforeOpen;
    dsrOrcamentos.OnDataChange := dsrOrcamentosDataChange;
    dsrProcuraCliente.onDataChange := dsrProcuraClienteDataChange;
  end
  else
  if (trim(qryOrcamentospessoanumero.AsString) <> '') then
  begin
    qryProcuraCliente.AfterScroll := nil;
    qryProcuraCliente.BeforeOpen := nil;
    qryProcuraCliente.AfterOpen := nil;
    dsrOrcamentos.OnDataChange := nil;

    dsrProcuraCliente.onDataChange := nil;
    RefazConsultaPorNome(qryProcuraCliente,['codigo','tipo', 'pessoanumero'],
     [null, null, trim(qryOrcamentospessoanumero.AsString)]);

    if qryProcuraCliente.recordcount <> 0 then
      if (qryOrcamentosnome.AsString <> qryProcuraClientenome.AsString) or
         (qryOrcamentoscliente.AsInteger <> qryProcuraClientecodigo.asinteger) or
         (qryOrcamentostipocliente.AsString <> qryProcuraClientetipoorig.asString) then
      begin
        qryOrcamentos.Edit;

        qryOrcamentosnome.AsString := qryProcuraClientenome.AsString;
        qryOrcamentoscliente.AsInteger :=  qryProcuraClientecodigo.asinteger;
        qryOrcamentostipocliente.AsString := qryProcuraClientetipoorig.asString;
        qryOrcamentos.Post;
      end;
    qryProcuraCliente.AfterOpen :=  qryProcuraClienteAfterOpen;
    qryProcuraCliente.AfterScroll := qryProcuraClienteAfterScroll;
    qryProcuraCliente.BeforeOpen := qryProcuraClienteBeforeOpen;
    dsrOrcamentos.OnDataChange := dsrOrcamentosDataChange;

    dsrProcuraCliente.onDataChange := dsrProcuraClienteDataChange;
  end;

  result := Prosseguir;

  for a := 0 to High(ds) do
    if ds[a] is TZDataSet then
      if TZDataSet(ds[a]).Name = 'qryOrcamentos' then
      begin
        AtribuirCodigoOrcamento;
        refazconsultapornome(qryOrcamentos_log_Before_Commit,['orcamento'],[qryorcamentoscodigo.AsInteger]);
        if (qryOrcamentos_log_AfterOpen.recordcount=0) or
           (qryOrcamentos_log_Before_Commit.recordcount=0) or
           (qryOrcamentos_log_AfterOpen.fieldbyname('trigger_changed').asDateTime =
            qryOrcamentos_log_Before_Commit.fieldbyname('trigger_changed').asDateTime) then
        begin
          result := Prosseguir_e_ReabrirVerificacao;
          refazconsultapornome(qryOrcamentos_log_AfterOpen,['orcamento'],[qryorcamentoscodigo.AsInteger]);
        end
        else
        begin
          result := NaoPresseguir;
          MensagemAviso(format('Existe uma alteração mais recente deste registro.' + chr(13) +
                               'As alterações serão perdidas e os dados serão recarregados!' + chr(13) +
                               'Alterado por: %s Data/Hora: %s', [qryOrcamentos_log_Before_Commit.fieldbyname('trigger_user').asString,
                                                             qryOrcamentos_log_Before_Commit.fieldbyname('trigger_changed').asString]));
          ReFazConsultaporNome(qryOrcamentos,['codigo'],[qryOrcamentosCodigo.AsInteger]);
        end;

        break;

      end;

end;


