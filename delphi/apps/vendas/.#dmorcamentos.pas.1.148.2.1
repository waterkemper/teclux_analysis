      AtribuirMarkupCargosConsultas;

  end;

  if not qryProdutosOrcamentos.IsEmpty and
     not qryprodutosOrcamentos.ReadOnly then
    AtribuirValorProduto;

  if assigned(OnScrollClientes) then
    OnScrollClientes(qryProcuraCliente);

