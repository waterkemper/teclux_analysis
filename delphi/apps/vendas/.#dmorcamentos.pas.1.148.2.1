        qryOrcamentosCopiabairro.AsInteger         := qryOrcamentosbairro.AsInteger;
      if not qryOrcamentoscidade.IsNull then
        qryOrcamentosCopiacidade.AsInteger         := qryOrcamentoscidade.AsInteger;
      if not qryOrcamentosestado.IsNull then
        qryOrcamentosCopiaestado.AsString          := qryOrcamentosestado.AsString;
