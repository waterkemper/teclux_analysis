procedure TdtmOrcamentos.AtribuirCodigoOrcamento;
var Cont: Integer;
    RegistroAtual : TbookMark;
begin
  if (qryOrcamentoscodigo.AsInteger = 0) and ((qryOrcamentos.State = dsInsert) or
                                              (qryOrcamentos.RecordCount<>0)) then
  begin
    spcOrcamentoProximo.Open;
    qryOrcamentos.edit;
    qryOrcamentoscodigo.AsInteger := spcOrcamentoProximonumero.AsInteger;
    spcOrcamentoProximo.Close;
  end;


  try
    qryProdutosOrcamentos.AfterPost    := nil;
    qryProdutosOrcamentos.AfterScroll  := nil;
    qryProdutosOrcamentos.BeforePost   := nil;
    qryProdutosOrcamentos.disableControls;
    RegistroAtual := qryProdutosOrcamentos.GetBookmark;

    Cont:= 1;
    qryProdutosOrcamentos.First;
    while Not qryProdutosOrcamentos.Eof do
    begin
      if (qryProdutosOrcamentosorcamento.AsInteger <> qryOrcamentoscodigo.AsInteger) or
         (qryProdutosOrcamentosvendedor.IsNull and
          (qryProdutosOrcamentosvendedor.asinteger <> qryOrcamentosvendedor.AsInteger)) or
         (qryProdutosOrcamentosnumero.AsInteger   <> Cont) then

      begin
        qryProdutosOrcamentos.Edit;
        qryProdutosOrcamentosorcamento.AsInteger:= qryOrcamentoscodigo.AsInteger;

        if qryProdutosOrcamentosvendedor.IsNull then
          qryProdutosOrcamentosvendedor.asinteger := qryOrcamentosvendedor.AsInteger;

        qryProdutosOrcamentosnumero.AsInteger   := Cont;
        qryProdutosOrcamentos.Post;

      end;

      Inc(Cont);
      qryProdutosOrcamentos.Next;

    end;
  finally

    qryProdutosOrcamentos.AfterPost    := qryProdutosOrcamentosAfterPost;
    qryProdutosOrcamentos.AfterScroll  := qryProdutosOrcamentosAfterScroll;
    qryProdutosOrcamentos.BeforePost   := qryProdutosOrcamentosBeforePost;

    qryProdutosOrcamentos.GotoBookmark(RegistroAtual);
    qryProdutosOrcamentos.FreeBookmark(RegistroAtual);
    qryProdutosOrcamentos.enableControls;


  end;

  qryServicosOrcamento.First;
  while not qryServicosOrcamento.Eof do
  begin
    if qryServicosOrcamentoorcamento.IsNull then
    begin
      qryServicosOrcamento.Edit;
      qryServicosOrcamentoorcamento.AsInteger := qryOrcamentoscodigo.AsInteger;
      qryServicosOrcamento.Post;
    end;
    qryServicosOrcamento.Next;
  end;

end;

