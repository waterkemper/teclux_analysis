procedure TdtmOrcamentos.CalcularValorTotalProdutos;
var
  Pos: TBookmark;
{  QtdadeTotal,
  Preco,}
  TotProdutoAnt, Produto{, Totcupom_valor_desconto}: Real;
  TotQtdeProdutos: Currency;
begin

  TotProdutoAnt:= qryOrcamentostotalprodutos.AsCurrency - qryOrcamentoscupom_valor_desconto.AsCurrency;

{  CalcularDesconto_cupons_desconto;}
  Produto:= 0;    TotQtdeProdutos:= 0;
  {Totcupom_valor_desconto := 0;}

  if qryProdutosOrcamentos.Active then
  begin
    qryProdutosOrcamentos.AfterScroll := nil;
    Pos := qryProdutosOrcamentos.GetBookmark;
    qryProdutosOrcamentos.DisableControls;
//    AlterarPlanos  := False;
    FExisteMontagem := False;
    FExisteEntrega  := False;
    FPermiteDesconto:= True;
    try
      qryProdutosOrcamentos.First;
      while Not qryProdutosOrcamentos.Eof do
      begin
{        Preco    := qryProdutosOrcamentosprecovenda.AsCurrency;
        QtdadeTotal := qryProdutosOrcamentosquantidade.AsCurrency;}

{        Totcupom_valor_desconto := Totcupom_valor_desconto + qryProdutosOrcamentosvalordescontoitemcupomdesconto.AsCurrency;}

        TotQtdeProdutos := TotQtdeProdutos + qryProdutosOrcamentosquantidade.AsCurrency;
        Produto := Produto + Truncar((qryProdutosOrcamentosquantidade.AsCurrency *
                                      qryProdutosOrcamentosprecovenda.AsCurrency -
                                      qryProdutosOrcamentosvalordescontoitem.AsCurrency),2);

//        Inc(QtdeLinhas);
//        qryProdutosOrcamentos.Edit;
//        qryProdutosOrcamentosNumero.AsInteger := QtdeLinhas;
//        qryProdutosOrcamentos.Post;

        if qryProdutosOrcamentosmontagem.AsString = 'S' then
          FExisteMontagem := True;

        if qryProdutosOrcamentosentrega.AsString = 'S' then
          FExisteEntrega := True;

        if (qryProdutosOrcamentospromocao.AsBoolean and not ParSistema.PermitirDescontoContratoPromocao) or
           qryProdutosOrcamentosdeny_discount.AsBoolean then
          FPermiteDesconto:= False;

        qryProdutosOrcamentos.Next
      end;

//      AlterarPlanos:= AlterarPlanos or  (TotProdutoAnt <> (Produto - Totcupom_valor_desconto));

      if Not FExisteMontagem then
        qryOrcamentosfilialmontagem.Clear;
    finally

      qryOrcamentostotalprodutos.AsCurrency := Produto;
      qryOrcamentosTotalQtdeProdutos.AsCurrency := TotQtdeProdutos;

      if qryOrcamentossituacao.AsString = 'A' then
      begin
        CalcularDesconto_cupons_desconto;

        if vValorRateadoCupomDesconto <> qryOrcamentoscupom_valor_desconto.AsCurrency then
        begin
  //        PrecisaRecalcularParcelas := true;
          MensagemAviso('O ''cálculo do cupom'' ou o ''prazo de validade'' do cupom de desconto foram alterados.'+chr(13)+
                        'O Orçamento precisa ser recalculado.');
          qryOrcamentos.edit;
          qryOrcamentoscupom_valor_desconto.AsCurrency := vValorRateadoCupomDesconto;
          ReCalcularPlanosPagamento;
        end;
      end;

      qryProdutosOrcamentos.GotoBookmark(Pos);
      qryProdutosOrcamentos.FreeBookmark(Pos);
      qryProdutosOrcamentos.EnableControls;
      qryProdutosOrcamentos.AfterScroll := qryProdutosOrcamentosAfterScroll;


      AlterarPlanos:= AlterarPlanos or  (TotProdutoAnt <> (Produto - vValorRateadoCupomDesconto));
    end
  end;
end;

