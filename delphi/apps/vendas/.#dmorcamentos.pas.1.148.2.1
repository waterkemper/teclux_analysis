procedure TdtmOrcamentos.RecalcularPlanoOrcamentoPadrao;
begin
  if (qryPlanosOrcamentos.IsEmpty) and (ParSistema.PlanoOrcamentoPadrao>0) then
  begin
    try

      dsrPlanosOrcamento.OnDataChange := nil;

      ReFazConsulta(qryPlanosOrcamentos,[0],[qryOrcamentosCodigo.AsInteger]);

      if not qryPlanosOrcamentos.locate('plano', ParSistema.PlanoOrcamentoPadrao, []) then
      begin
        qryPlanosOrcamentos.Append;
        qryPlanosOrcamentosorcamento.AsInteger := qryOrcamentoscodigo.AsInteger;
        qryPlanosOrcamentosplano.Asinteger := ParSistema.PlanoOrcamentoPadrao;
        qryPlanosOrcamentos.Post;
      end;

      ReCalcularPlanosPagamento;
      AtribuirCodigoOrcamento;
      Perpetrar([qryOrcamentos, qryprodutosOrcamentos, qryPlanosOrcamentos,qryParcelasPlanosOrcamentos]);

    finally
      dsrPlanosOrcamento.OnDataChange:= dsrPlanosOrcamentoDataChange;
    end;
  end;
end;

