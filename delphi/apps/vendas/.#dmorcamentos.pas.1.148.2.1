      qryProdutosContratosprevisao.AsDateTime          := qryProdutosOrcamentosprevisao.AsDateTime;
      qryProdutosContratosbrinde.AsBoolean             := False;
      qryProdutosContratosvendedor.AsInteger           := qryProdutosOrcamentosvendedor.AsInteger;
      qryProdutosContratosvalordescontoitem.AsCurrency := qryProdutosOrcamentosvalordescontoitem.AsCurrency;
      qryProdutosContratosvalordescontoitemcupomdesconto.AsCurrency := qryProdutosOrcamentosvalordescontoitemcupomdesconto.AsCurrency;

