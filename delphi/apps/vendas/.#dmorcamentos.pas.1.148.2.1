  procedure InserirServicosContratos;
  begin
    if qryServicosContratos.Active then
      qryServicosContratos.Close;
    qryServicosContratos.Open;

    qryServicosOrcamento.First;
    while not qryServicosOrcamento.Eof do
    begin
      qryServicosContratos.Insert;
      qryServicosContratoscontrato.AsString           :=qryContratosnumero.AsString;
      qryServicosContratosservico.AsInteger           :=qryServicosOrcamentoservico.AsInteger;
      qryServicosContratosquantidade.AsInteger        :=qryServicosOrcamentoquantidade.AsInteger;
      qryServicosContratosaliquotaissqn.AsCurrency    :=qryServicosOrcamentoaliquotaissqn.AsCurrency;
      qryServicosContratosvalorservico.AsCurrency     :=qryServicosOrcamentovalorservico.AsCurrency;
      qryServicosContratoscomplementoservico.AsString :=qryServicosOrcamentocomplementoservico.AsString;
      qryServicosContratos.Post;

      qryServicosOrcamento.Next;
    end;
  end;

  procedure InserirParcelas;
  begin
    if qryParcelas.Active then
      qryParcelas.Close;
    qryParcelas.Open;

    Cont:= 1;
    NP:= qryParcelasPlanosOrcamentos.RecordCount;
    qryParcelasPlanosOrcamentos.First;
    while  not qryParcelasPlanosOrcamentos.Eof do begin
      qryParcelas.Insert;
      qryParcelascontrato.AsString             := qryContratosnumero.AsString;
      qryParcelasnumero.AsInteger              := Cont;
      qryParcelasdatavencto.AsDateTime         := qryParcelasPlanosOrcamentosdata.AsDateTime;
      qryParcelasvalorvencto.AsCurrency        := qryParcelasPlanosOrcamentosvalor.AsCurrency;
//      qryParcelasparcelaorigem.AsString        := IntToStr(Cont) + '/' + IntToStr(NP);
      qryParcelasparcelaorigem.AsString        := qryParcelasPlanosOrcamentosparcelaorigem.AsString;
      qryParcelasformapagamento.AsString       := qryParcelasPlanosOrcamentosformapagamento.asString;
      qryParcelastiporecebimento.asinteger     := qryParcelasPlanosOrcamentostiporecebimento.asinteger;
      qryParcelasparcelaadicional.AsBoolean    := False;
      qryParcelaspagamentoextracaixa.AsBoolean := False;
      qryParcelas.Post;
      Inc(Cont);
      qryParcelasPlanosOrcamentos.Next;
    end;
  end;

  function PermiteGerarContrato: boolean;
  var
    vElementosdaLista: String;
  begin
    result := true;
    if parsistema.ProdutosnoOrcamentoComEstoque then
    begin
      vElementosdaLista := RetornarLista(qryProdutosOrcamentos, qryProdutosOrcamentossituacao_produto);
      if (pos('N', vElementosdaLista)<>0) or
         (pos('P', vElementosdaLista)<>0) then
      begin
        result := false;
        mensagemaviso('O contrato não pode ser gerado. Produtos sem saldo em estoque.');
      end
    end;
  end;

begin

  Result := PermiteGerarContrato;

  if result and (MensagemConfirmacao(ctORCAMENTO_GERAR_CONTRATO) = smbOk) then
  begin
    result := AutorizacaoAnalistaCredito;
    if result then
    begin

      Plano:= 0;
      if qryPlanosOrcamentos.RecordCount = 1 then
        Plano:= qryPlanosOrcamentosplano.AsInteger
      else begin
        qryPlanosOrcamentos.AfterScroll:= nil;
        qryPlanosOrcamentos.First;
        while not qryPlanosOrcamentos.Eof do begin
          if qryPlanosOrcamentosselecionar.AsBoolean then begin
            Plano:= qryPlanosOrcamentosplano.AsInteger;
            Break;
          end;
          qryPlanosOrcamentos.Next;
        end;
        qryPlanosOrcamentos.AfterScroll:= qryPlanosOrcamentosAfterScroll;
      end;

      if Plano = 0 then
        MensagemAviso(ctORCAMENTO_PLANO)
      else
      begin

        if qryOrcamentoscliente.AsInteger = 0 then
        begin
          result := CriarNovoCliente(true);
          if result then
            result := AtribuirClientenoOrcamento;
        end
        else
          result := true;

        if Result then
           result := IncluirAtendimento_(qryOrcamentoscodigo.AsInteger, qryOrcamentoscliente.AsInteger, qryOrcamentostipocliente.AsString, OrcamentoParaContrato);

        if result then
          result := CriarNovoContrato;

        if result then
        begin

          qryOrcamentos.Edit;
          qryOrcamentossituacao.AsString:= 'T';
          qryOrcamentoscontrato.AsString:= qryContratosnumero.AsString;

          qryOrcamentos.Post;
          InserirProdutosContratos;
          InserirServicosContratos;
          InserirParcelas;

//          OnPerpetrar := nil;
//          AfterPerpetrar := nil;

          AtribuirCodigoOrcamento;
          result := Perpetrar([qryClientes, qryContratos, qryProdutosContratos, qryServicosContratos,qryParcelas,
                     qryOrcamentos, qryProdutosOrcamentos]);

//          OnPerpetrar := VerificarDadosAntesGravar;
//          AfterPerpetrar := VerificarDadosDepoisGravar;


          if result then
          begin
            {
            qryClienteParaContrato.ParamByName('cliente').AsInteger := qryContratoscliente.asinteger;
            qryClienteParaContrato.ParamByName('contrato').AsString := qrycontratosnumero.asString;
            qryClienteParaContrato.execSQL;
            ATENÇÃO: NAS CHAMADAS DE FUNÇÕES DO BANCO....OBRIGADO A DAR UM COMMIT, CASO CONTRÁRIO OCORRE UM BLOQUEIO AGUARDANDO O FECHAMENTO DA TRANSAÇAÕ
            }
            refazconsultapornome(qryClienteParaContrato,['cliente','contrato'],[qryContratoscliente.asinteger, qrycontratosnumero.asString]);
            result := perpetrar([qryClienteParaContrato]);

            if result then
              AcionarTelaEnquete(qryOrcamentoscliente.Asinteger,      //cliente
                         qryOrcamentostipocliente.asString,           //tipocliente
                         qryorcamentoscodigo.asinteger,               //orcamento
                         qryorcamentoscontrato.asString);             //contrato

          end;

          RefazConsultaOrcamentos;
          EncerrarDataModule2_;
        end
        else
          rollback([]);


        qryAgentePlano.Close;
        qryClientes.Close;
        qryContratos.Close;
        qryProdutosContratos.Close;
        qryServicosContratos.Close;
        qryParcelas.Close;
      end;
    end;

  end
  else
    result := false;
end;

