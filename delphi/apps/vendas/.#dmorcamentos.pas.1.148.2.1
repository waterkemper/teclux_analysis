function TdtmOrcamentos.SugerirCreditoTroca(Perguntar,
  Atribuir: Boolean): Boolean;
var
  msg : String;
begin
  result := false;
  if ParSistema.utilizarcreditotrocacontrato then
  begin
    if SaldoCreditoAtual <> 0 then
    begin
      if saldoCreditoAtual >0 then
        msg:= 'crédito'
     {
      else
        msg:= 'débito'};
      if not Perguntar or
         (MensagemConfirmacao(format(ctCLIENTEPOSSUIDEBITOCREDITO,[msg,saldocreditoatual])) = smbOK) then
      begin

        if not (qryOrcamentos.State in [dsedit,dsinsert]) then
          qryOrcamentos.Edit;

        qryOrcamentoscreditotroca.AsCurrency := 0;
        if Atribuir or not Perguntar then
          if (SaldoCreditoAtual > 0) then
          begin
            if TotalOrcamento >= SaldoCreditoAtual then
              qryOrcamentoscreditotroca.AsCurrency := SaldoCreditoAtual
            else
              qryOrcamentoscreditotroca.AsCurrency := TotalOrcamento;
          end;
        result := true;
      end;
    end;
  end;
end;

