procedure TdtmOrcamentos.SelecionaTabelasOrcamento(TipoConsulta: TtecOrcamentosTipoConsulta);
begin
  case TipoConsulta of
       vocORCAMENTO: ReFazConsulta(qryOrcamentos,[0],[qryConsultaOrcamentoscodigo.AsInteger]);
        vocCLIENTES: begin
                       qryProcuraCliente.Params[1].AsString:= qryConsultaClientestipo.AsString;
                       if qryOrcamentos.State = dsBrowse then
                         qryOrcamentos.Edit;
                       qryOrcamentoscliente.AsInteger := qryConsultaClientescodigo.AsInteger;

                       if dtmOrcamentos.AlterarPlanos then
                         dtmOrcamentos.ReCalcularPlanosPagamento;

                     end;
        vocVENDEDOR: begin
                       if qryOrcamentos.State = dsBrowse then
                         qryOrcamentos.Edit;
                       qryOrcamentosvendedor.AsInteger := qryConsultaVendedorescodigo.AsInteger
                     end;
         vocPRODUTO: begin
//                       if qryProdutosOrcamentos.State = dsBrowse then
                         if ParSistema.FiliaisIndependentes then
                         begin
                           qryProcuraProduto.ParamByName('Filialsaida').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
                           qryProcuraProduto.ParamByName('FilialPreco').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
                         end
                         else
                         begin
                           qryProcuraProduto.ParamByName('Filialsaida').AsInteger   := qryConsultaProdutosfilial.AsInteger;
                           if ParSistema.UtilizarPrecoFilialBase then
                             qryProcuraProduto.ParamByName('FilialPreco').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual)
                           else
                             qryProcuraProduto.ParamByName('FilialPreco').AsInteger   := qryConsultaProdutosfilial.AsInteger;
                         end;
                         if qryProdutosOrcamentos.State = dsBrowse then
                           qryProdutosOrcamentos.Edit;
                         qryProdutosOrcamentosproduto.AsLargeInt := qryConsultaProdutosproduto.AsLargeInt;
                         qryProdutosOrcamentosfilial.AsInteger   := qryConsultaProdutosfilial.AsInteger;
                         qryProdutosOrcamentosprodutovisual.AsString := qryConsultaProdutosprodutovisual.AsString;
                         RefazConsulta(qryEstoque,[0],[IntToStr(qryConsultaProdutosproduto.AsLargeInt)]);
                     end;
         vocSERVICO: begin
                       qryServicosOrcamento.Edit;
                       qryServicosOrcamentoservico.AsInteger:= qryConsultaServicoscodigo.AsInteger;
                     end;
  vocFILIALMONTAGEM: begin
                       if qryProdutosOrcamentos.State = dsBrowse then
                         qryProdutosOrcamentos.Edit;
                       qryOrcamentosfilialmontagem.AsInteger:= qryConsultaFiliaiscodigo.AsInteger;
                     end;
          vocFILIAL: begin
                       if qryProdutosOrcamentos.State = dsBrowse then
                         qryProdutosOrcamentos.Edit;
                         qryProdutosOrcamentosfilial.AsInteger:= qryConsultaFilialProdutocodigo.AsInteger;
                     end;
          vocVENDEDORPRODUTO: begin
                       if qryProdutosOrcamentos.State = dsBrowse then
                         qryProdutosOrcamentos.Edit;
                         qryProdutosOrcamentosvendedor.AsInteger:= qryConsultaVendedorescodigo.AsInteger;
                     end;

  end;
end;

procedure TdtmOrcamentos.SetVendedorDefault(const Value: Integer);
begin
  if FVendedorDefault <> Value then
    FVendedorDefault:= Value;

  if ParSistema.NaoPermitirAlteraroVendedornosProdutosdoContrato then
  begin
    if qryProdutosOrcamentos.active then
    begin
      try
        qryProdutosOrcamentos.AfterScroll := nil;

        GuardarRegistroAtual(qryProdutosOrcamentos,true);
        qryProdutosOrcamentos.First;
        while not qryProdutosOrcamentos.Eof do
        begin
          if qryProdutosOrcamentosvendedor.AsInteger <> FVendedorDefault then
            AtribuirDados(qryProdutosOrcamentos, [qryProdutosOrcamentosvendedor], [fVendedorDefault]);

          qryProdutosOrcamentos.Next;
        end;
      finally
        VoltarRegistroAtual(qryprodutosOrcamentos);
        qryProdutosOrcamentos.AfterScroll := qryProdutosOrcamentosAfterScroll;
      end;
    end;
  end;

end;

