procedure TdtmOrcamentos.AtribuirDadosClienteOrcamentonoCliente;
var
  EndComp: Boolean;

begin

  EndComp:= (not qryOrcamentosrua.IsNull)    and
            (not qryOrcamentosnumero.IsNull)    and
//              (not qryOrcamentoscomplemento.IsNull)    and
            (not qryOrcamentosbairro.IsNull) and
            (not qryOrcamentoscidade.IsNull) and
            (not qryOrcamentosestado.IsNull) and
            (not qryOrcamentoscep.IsNull);

  qryClientes.edit;

  qryClientesnome.AsString            := qryOrcamentosnome.AsString;
  qryClientesempcargo.asvariant := qryorcamentosempcargo.asvariant;
  if EndComp then
  begin
    qryClientesrua.AsString           := qryOrcamentosrua.AsString;

    qryClientesnumero.AsString        := qryOrcamentosnumero.AsString;
    qryClientescomplemento.AsString   := qryOrcamentoscomplemento.AsString;

    qryClientesbairro.AsInteger       := qryOrcamentosbairro.AsInteger;
    qryClientescidade.AsInteger       := qryOrcamentoscidade.AsInteger;
    qryClientesestado.AsString        := qryOrcamentosestado.AsString;
    qryClientescep.AsInteger          := qryOrcamentoscep.AsInteger;
  end
  else
  begin
    ReFazConsulta(qryEnderecoFilial,[0],[FilialBase]);
    qryClientesrua.AsString           := qryEnderecoFilialrua.AsString;
    qryClientesnumero.AsString        := qryEnderecoFilialnumero.AsString;
    qryClientesbairro.AsInteger       := qryEnderecoFilialbairro.AsInteger;
    qryClientescidade.AsInteger       := qryEnderecoFilialcidade.AsInteger;
    qryClientesestado.AsString        := qryEnderecoFilialestado.AsString;
    qryClientescep.AsInteger          := qryEnderecoFilialcep.AsInteger;
  end;

  if qryOrcamentospessoatipo.isnull then
    qryClientespessoatipo.AsString      := 'F'
  else
    qryClientespessoatipo.AsString      := qryOrcamentospessoatipo.AsString;

  if not qryOrcamentospessoanumero.IsNull then
    qryClientespessoanumero.AsString    := qryOrcamentospessoanumero.AsString;

  if not qryOrcamentosfoneddd.IsNull then
    qryClientesfoneddd.AsInteger        := qryOrcamentosfoneddd.AsInteger;
  if not qryOrcamentosfonenumero.IsNull then
    qryClientesfonenumero.AsInteger     := qryOrcamentosfonenumero.AsInteger;
  if not qryOrcamentosfoneramal.IsNull then
    qryClientesfoneramal.AsString       := qryOrcamentosfoneramal.AsString;
  if not qryOrcamentosfone2ddd.IsNull then
    qryClientesfone2ddd.AsInteger       := qryOrcamentosfone2ddd.AsInteger;

  if not qryOrcamentosfone2numero.IsNull then
    qryClientesfone2numero.AsInteger    := qryOrcamentosfone2numero.AsInteger;

  if not qryOrcamentosfone2ramal.IsNull then
    qryClientesfone2ramal.AsString      := qryOrcamentosfone2ramal.AsString;

  if not qryOrcamentosemail.IsNull then
    qryClientesemail.AsString           := qryOrcamentosemail.AsString;

end;

procedure TdtmOrcamentos.TrocaProdutoOrcamentoporProdutoGrade;
var
  a: integer;
  produto, filial : String;
  vprodutoGrade, vprodutovisualgrade : String;

begin
  produto := '';
  filial := '';

  vProdutoGrade := ItemProdutoGrade(qryProdutosOrcamentoscaracteristica.asString,
                             qryGradesProdutos.Fields[0].AsString,
                             NomeCamposelecionadoGrade);

  if vProdutoGrade <> '' then
  begin

    vprodutovisualgrade := qryItemProdutoGrade.fieldbyname('codigovisual').AsString;

    for a := 0 to High(aProdFilial) do
      if (aProdFilial[a].Prod = vProdutoGrade) and
         (aProdFilial[a].Filial = inttostr(filialbase)) then
      begin
        produto := aProdFilial[a].Prod;
        filial := aProdFilial[a].Filial;
        break;
      end;

    if (Produto = vProdutoGrade) and
       (Filial = inttostr(filialbase)) then
    begin
      if (MensagemConfirmacao(format(ctPRODUTOJACADASTRADOEDITAR,[produto,filial, ctORCAMENTO]))=smbOK) then
      begin
        if (qryProdutosOrcamentos.State in [dsinsert, dsedit]) then
           qryProdutosOrcamentos.Cancel;
        qryProdutosOrcamentos.Locate('produto;filial',
                                      VarArrayOf([Produto,
                                                  Filial]),[]);
      end;
    end
    else
    begin
      dsrProdutosOrcamentos.onDataChange := nil;
      if not (qryprodutosorcamentos.State in [dsinsert, dsedit]) then
        qryprodutosorcamentos.Edit;
      qryProdutosOrcamentosfilial.Asinteger := filialbase;
      qryProdutosOrcamentosproduto.AsString := vProdutoGrade;
      qryProdutosOrcamentosprodutovisual.AsString := vprodutovisualgrade;
      qryProdutosOrcamentosprodutodigitado.AsString := vprodutovisualgrade;
      SelecionarProdutoContratoProcura;
      dsrProdutosOrcamentos.onDataChange := dsrProdutosOrcamentosDataChange;
    end;

  end;

end;

procedure TdtmOrcamentos.CalcularDesconto_cupons_desconto;
var
 vListaProdutos : String;
 vValorAtribuido : Currency;
 vTotalProdutosCupomDesconto : Currency;
begin
  if not qryProdutosOrcamentos.readonly and (qryOrcamentossituacao.AsString='A') then
  begin

    vListaProdutos := RetornarLista(qryProdutosOrcamentos, qryProdutosOrcamentosproduto);
    if vListaProdutos = '' then
      vListaProdutos := '0';

    qryCupomDesconto.parambyname('p_CupomDesconto').AsString := lowercase(qryOrcamentoscodigo_cupom.asString);

    qryCupomDesconto.parambyname('p_ListaProdutos').AsString := vListaProdutos;

    qryCupomDesconto.parambyname('p_Valor_Pedido').AsCurrency := qryOrcamentostotalprodutos.asCurrency;
    qryCupomDesconto.parambyname('p_Quantidade_Itens').AsCurrency := qryOrcamentostotalqtdeprodutos.asCurrency;
    qryCupomDesconto.parambyname('p_PessoaNumero').AsString := qryOrcamentospessoanumero.asString;
    qryCupomDesconto.close;
    qryCupomDesconto.open;

    try
      qryProdutosOrcamentos.AfterPost := nil;

      AtribuirDados(qryProdutosOrcamentos, [qryProdutosOrcamentosvalordescontoitemcupomdesconto], [0]);

      vValorAtribuido := 0;
      vValorRateadoCupomDesconto := 0;

      vTotalProdutosCupomDesconto := 0;
      if qryCupomDescontotipo_desconto.asstring <> '1' then
      begin
        qryCupomDesconto.first;
        while not qryCupomDesconto.eof do
        begin
          if qryProdutosOrcamentos.locate('produto', qryCupomDescontoproduto.asString, []) then
            vTotalProdutosCupomDesconto := vTotalProdutosCupomDesconto + qryProdutosOrcamentostotal.AsCurrency;

          qryCupomDesconto.next;
        end;
      end;


      qryCupomDesconto.first;
      while not qryCupomDesconto.eof do
      begin

        if qryProdutosOrcamentos.locate('produto', qryCupomDescontoproduto.asString, []) then
        begin

          qryProdutosOrcamentos.edit;

          if qryCupomDescontotipo_desconto.asstring = '1' then //percentual then
          begin
//            vValorRateadoCupomDesconto := roundto(qryOrcamentostotalprodutos.AsCurrency * qryCupomDescontovalor_desconto.AsCurrency / 100, -2);

            qryProdutosOrcamentosvalordescontoitemcupomdesconto.AsCurrency :=
              roundto(qryProdutosOrcamentostotal.AsCurrency * qryCupomDescontovalor_desconto.AsCurrency / 100, -2);

            vValorRateadoCupomDesconto := vValorRateadoCupomDesconto + qryProdutosOrcamentosvalordescontoitemcupomdesconto.AsCurrency;

          end
          else  //valor
          begin
            vValorRateadoCupomDesconto := qryCupomDescontovalor_desconto.AsCurrency;

//            qryProdutosOrcamentosvalordescontoitemcupomdesconto.AsCurrency :=
//                 RatearValores(qryProdutosOrcamentostotal.AsCurrency, qryOrcamentostotalprodutos.AsCurrency, qryCupomDescontovalor_desconto.AsCurrency, 2)

            qryProdutosOrcamentosvalordescontoitemcupomdesconto.AsCurrency :=
                 RatearValores(qryProdutosOrcamentostotal.AsCurrency, vTotalProdutosCupomDesconto, qryCupomDescontovalor_desconto.AsCurrency, 2)

          end;

          vValorAtribuido := vValorAtribuido + qryProdutosOrcamentosvalordescontoitemcupomdesconto.AsCurrency;

          if qryCupomDesconto.recno = qryCupomDesconto.recordcount then
            if (vValorRateadoCupomDesconto - vValorAtribuido) <> 0 then
               qryProdutosOrcamentosvalordescontoitemcupomdesconto.AsCurrency :=
                 qryProdutosOrcamentosvalordescontoitemcupomdesconto.AsCurrency + (vValorRateadoCupomDesconto - vValorAtribuido);

          qryProdutosOrcamentos.post;
        end;

        qryCupomDesconto.next;

      end;

    finally
      qryProdutosOrcamentos.AfterPost := qryProdutosOrcamentosAfterPost;
    end;
  end;  

end;

procedure TdtmOrcamentos.qryOrcamentosCalcFields(DataSet: TDataSet);
var
 vMd5 : String;
begin
  inherited;
  vMd5 :=  md5_(qryOrcamentoscodigo.asString +
                FormatDateTime('yyyy-mm-dd', qryOrcamentosemissao.AsDateTime));

  qryOrcamentosendereco_cobranca.asString := parSistema.SiteEmpresa+
                                             '/orcamentos/pagamento/?orcamento='+
                                             lowercase(vMd5);
end;

end.
