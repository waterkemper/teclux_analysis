        qryOrcamentosCopiafonenumero.AsInteger     := qryOrcamentosfonenumero.AsInteger;
      if not qryOrcamentosfoneramal.IsNull then
        qryOrcamentosCopiafoneramal.AsString       := qryOrcamentosfoneramal.AsString;
      if not qryOrcamentosfone2ddd.IsNull then
        qryOrcamentosCopiafone2ddd.AsInteger       := qryOrcamentosfone2ddd.AsInteger;
      if not qryOrcamentosfone2numero.IsNull then
        qryOrcamentosCopiafone2numero.AsInteger    := qryOrcamentosfone2numero.AsInteger;
      if not qryOrcamentosfone2ramal.IsNull then
        qryOrcamentosCopiafone2ramal.AsString      := qryOrcamentosfone2ramal.AsString;

      qryOrcamentosCopiacupom_desconto.asVariant := qryOrcamentoscupom_desconto.asVariant;
      qryOrcamentosCopiacodigo_cupom.value := qryOrcamentoscodigo_cupom.value;
      qryOrcamentosCopiacupom_valor_desconto.value := qryOrcamentoscupom_valor_desconto.value;

      qryOrcamentosCopia.Post;

      Produtos:= 0;
      qryProdutosOrcamentos.First;
      while not qryProdutosOrcamentos.Eof do begin
        RefazConsultaProdutoEstoque(IntToStr(qryProdutosOrcamentosproduto.AsLargeInt),
                                             qryProdutosOrcamentosfilial.AsInteger);
        CopiarRegistros(qryProdutosOrcamentos, qryProdutosOrcamentosCopia, false);
        qryProdutosOrcamentosCopia.edit;
        qryProdutosOrcamentosCopiaorcamento.AsInteger          := Codigo;
        qryProdutosOrcamentosCopiavendido.AsCurrency            := 0;
        qryProdutosOrcamentosCopiaprecovenda.AsCurrency        := qryProdutoEstoquepreco.AsCurrency;
        qryProdutosOrcamentosCopiaprecotabela.AsCurrency       := qryProdutoEstoquepreco.AsCurrency;

        qryProdutosOrcamentosCopia.Post;
        Produtos:= Produtos + truncar((qryProdutosOrcamentosCopiaquantidade.AsCurrency * qryProdutosOrcamentosCopiaprecovenda.AsCurrency),2);
        qryProdutosOrcamentos.Next;
      end;

      qryServicosOrcamento.First;
      while not qryServicosOrcamento.Eof do
      begin
        qryServicosOrcamento.Append;
        qryServicosOrcamentoCopiaorcamento.AsInteger         :=Codigo;
        qryServicosOrcamentoCopiaservico.AsInteger           :=qryServicosOrcamentoservico.AsInteger;
        qryServicosOrcamentoCopiaquantidade.AsInteger        :=qryServicosOrcamentoquantidade.AsInteger;
        qryServicosOrcamentoCopiaaliquotaissqn.AsCurrency    :=qryServicosOrcamentoaliquotaissqn.AsCurrency;
        qryServicosOrcamentoCopiavalorservico.AsCurrency     :=qryServicosOrcamentovalorservico.AsCurrency;
        qryServicosOrcamentoCopiacomplementoservico.AsString :=qryServicosOrcamentocomplementoservico.AsString;
        qryServicosOrcamentoCopia.Post;

        qryServicosOrcamento.Next;
      end;

      Perpetrar([qryOrcamentosCopia, qryProdutosOrcamentosCopia, qryServicosOrcamento]);

      qryOrcamentosCopia.Close;
      qryProdutosOrcamentosCopia.Close;
      qryServicosOrcamentoCopia.Close;
      ReFazConsulta(qryOrcamentos,[0],[Codigo]);
    end;
  end;
end;

