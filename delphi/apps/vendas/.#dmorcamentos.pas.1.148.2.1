procedure TdtmOrcamentos.CalcularValorTotalServicos;
var
  Pos: TBookmark;
{  QtdadeTotal,
  Preco,}
  TotServicoAnt, Servico: Real;
begin
  TotServicoAnt:= qryOrcamentostotalservicos.AsCurrency;
  Servico:= 0;
  if qryServicosOrcamento.Active then
  begin
    Pos := qryServicosOrcamento.GetBookmark;
    qryServicosOrcamento.DisableControls;
    try
      qryServicosOrcamento.First;
      while Not qryServicosOrcamento.Eof do
      begin
{        Preco    := qryServicosOrcamentovalorservico.AsCurrency;
        QtdadeTotal := qryServicosOrcamentoquantidade.AsInteger;}
        Servico := Servico + Truncar((qryServicosOrcamentoquantidade.AsInteger *
                                      qryServicosOrcamentovalorservico.AsCurrency),2);
        qryServicosOrcamento.Next
      end;
      AlterarPlanos := AlterarPlanos or (TotServicoAnt <> Servico);
    finally
      qryOrcamentostotalservicos.AsCurrency := Servico;
      qryServicosOrcamento.GotoBookmark(Pos);
      qryServicosOrcamento.FreeBookmark(Pos);
      qryServicosOrcamento.EnableControls;

//      if FAlterarPlanos then
//        ReCalcularPlanosPagamento;
    end
  end;
end;

