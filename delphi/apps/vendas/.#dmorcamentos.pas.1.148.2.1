procedure TdtmOrcamentos.qryOrcamentosAfterOpen(DataSet: TDataSet);
begin
  inherited;
  RefazConsultaPorNome(qryQualidade_Venda,['orcamento'],[inttostr(qryOrcamentoscodigo.asInteger)]);

  ReFazConsultaProdutos;
  RefazConsultaServicos;
  ReFazConsulta(qryPlanosOrcamentos,[0],[qryOrcamentosCodigo.AsInteger]);
  ReFazConsulta(qryParcelasPlanosOrcamentos,[0],[qryOrcamentosCodigo.AsInteger]);

  ReFazConsultaporNome(qryEmail_Orcamento,['orcamento'],[qryOrcamentosCodigo.AsInteger]);

  if ParSistema.utilizarcreditotrocacontrato then
   if qryOrcamentoscliente.AsInteger<>0 then
   begin
     if qryOrcamentossituacao.asString = 'A' then
        ValidarCreditoTroca;
   end;

  TabelasSomenteLeitura(Situacao <> 'A');
   
  if qryProdutosOrcamentos.Active then
    CalcularValorTotalProdutos;

  if qryServicosOrcamento.Active then
    CalcularValorTotalServicos;


  if (Not UsuarioLogin.Vendedor or parsistema.NaoPermitirAlteraroVendedornosProdutosdoContrato) and (Not qryOrcamentosvendedor.IsNull) then
    VendedorDefault := qryOrcamentosvendedor.AsInteger;


  if assigned(OnScrollClientes) then
    OnScrollClientes(qryOrcamentos);

  refazconsultapornome(qryOrcamentos_log_AfterOpen,['orcamento'],[qryorcamentoscodigo.AsInteger]);
end;

