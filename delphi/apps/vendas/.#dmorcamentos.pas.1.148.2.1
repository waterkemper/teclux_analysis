procedure TdtmOrcamentos.RefazConsultaProdutoEstoque(produto: String; filial: integer);
const
  SQL = 'and produto = (%s)';
var
  Markup: Currency;
begin
//  FCargoCliente:= qryProcuraClientecargocliente.AsInteger;

  if ParSistema.ConsiderarMarkupClientes and not qryprocuraCliente.IsEmpty then
    Markup := qryProcuraClientemarkup.AsCurrency
  else
  if ParSistema.PrecosporCargo then
  begin
    if (produto <> '') and (produto <> '0') then
    begin
      qryCargosCliente.MacroByName('Produto').AsString:= Format(SQL,[produto]);
      qryCargosCliente.Close;
      qryCargosCliente.Open;
      RefazConsultaPorNome(qryCargosCliente,['Cargo'],[{FCargoCliente}qryOrcamentosempcargo.asinteger]);
      Markup:= qryCargosClientemarkup.AsInteger;
    end
    else
    Markup := 0;
  end
  else
    Markup := 0;

  qryProdutoEstoque.ParamByName('Cargo').AsInteger:= {FCargoCliente} qryOrcamentosempcargo.asinteger ;
  if ParSistema.UtilizarPrecoFilialBase then
    RefazConsultaPorNome(qryProdutoEstoque,['FilialBase','Markup','Codigo','Filial','Cliente','TipoCliente'],
                                           [FilialBase,Markup,produto,filial,qryOrcamentosCliente.asVariant, qryOrcamentosTipoCliente.asString])
  else
    RefazConsultaPorNome(qryProdutoEstoque,['FilialBase','Markup','Codigo','Filial','Cliente','TipoCliente'],
                                           [filial,Markup,produto,filial,qryOrcamentosCliente.asVariant, qryOrcamentosTipoCliente.asString]);
end;

