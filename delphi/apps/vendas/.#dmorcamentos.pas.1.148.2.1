procedure TdtmOrcamentos.TrocaProdutoOrcamentoporSimilar;
var
a: integer;
produto, filial : String;
begin
  produto := '';
  filial := '';
  for a := 0 to High(aProdFilial) do
   if (aProdFilial[a].Prod = qryProdutosSimilarescodigo.AsString) and
      (aProdFilial[a].Filial = qryProdutosSimilaresfilial.AsString) then
   begin
    produto := aProdFilial[a].Prod;
    filial := aProdFilial[a].Filial;
    break;
   end;

  if (Produto = qryProdutosSimilarescodigo.AsString) and
     (Filial = qryProdutosSimilaresfilial.AsString) then
  begin
    if (MensagemConfirmacao(format(ctPRODUTOJACADASTRADOEDITAR,[produto,filial, ctORCAMENTO]))=smbOK) then
    begin
      if (qryProdutosOrcamentos.State in [dsinsert, dsedit]) then
         qryProdutosOrcamentos.Cancel;
      qryProdutosOrcamentos.Locate('produto;filial',
                                    VarArrayOf([Produto,
                                                Filial]),[]);
//        AbrirDadosProdutos;
    end;
  end
  else
  begin
    dsrProdutosOrcamentos.onDataChange := nil;
    if not (qryprodutosorcamentos.State in [dsinsert, dsedit]) then
      qryprodutosorcamentos.Edit;
    qryProdutosOrcamentosfilial.AsString := qryProdutosSimilaresfilial.AsString;
    qryProdutosOrcamentosproduto.AsString := qryProdutosSimilarescodigo.AsString;
    qryProdutosOrcamentosprodutovisual.AsString := qryProdutosSimilarescodigovisual.AsString;
    qryProdutosOrcamentosprodutodigitado.AsString := qryProdutosSimilarescodigovisual.AsString;
    SelecionarProdutoContratoProcura;
    dsrProdutosOrcamentos.onDataChange := dsrProdutosOrcamentosDataChange;

//    AbrirDadosProdutos;
  end;

  {
  qryProcuraProduto.parambyname('codigobarras').asstring := qryProdutosOrcamentosproduto.AsString;
  qryProcuraProduto.close;
  qryProcuraProduto.open;
  }

end;

