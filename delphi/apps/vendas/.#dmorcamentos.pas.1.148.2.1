procedure TdtmOrcamentos.GravarLinhas;
var Contador: Integer;
begin
  qryProdutosOrcamentos.DisableControls;
  Contador:= 1;
  qryProdutosOrcamentos.First;
  while Not qryProdutosOrcamentos.Eof do begin
    qryProdutosOrcamentos.Edit;
    qryProdutosOrcamentosNumero.AsInteger := Contador;
    qryProdutosOrcamentos.Post;
    Inc(Contador);
    qryProdutosOrcamentos.Next;
  end;
  qryProdutosOrcamentos.EnableControls;
  qryProdutosOrcamentos.First;
end;

procedure TdtmOrcamentos.IncluirCliente(comcpfcnpj: boolean);
var
  i: Integer;
  vTipo, vPessoanumero: String;
begin
  frmClientesContrato := TfrmClientesContrato.Create(frmClientesContrato);
  try
    frmClientesContrato.dtmCadCli := dtmOrcamentos;
    frmClientesContrato.DataSource := dsrClientes;


    vtipo := qryOrcamentospessoatipo.AsString;
    if comcpfcnpj then
      vPessoanumero := qryOrcamentospessoanumero.asString
    else
      vPessoaNumero := '';

//    iCliente := CodigoCliente;
//    dtmOrcamentos.RefazConsultaCliente(0);
//    dtmOrcamentos.RefazConsultaCliente(iCliente);

    qryclientes.ParamByName('codigo').clear;
    qryclientes.close;
    qryclientes.Open;

//    if dtmOrcamentos.qryclientes.isempty then
    qryclientes.append;

    if vtipo <> '' then
      qryClientespessoatipo.AsString := vtipo;

    if comcpfcnpj then
      qryClientespessoanumero.asString := vPessoanumero
    else
      qryClientespessoanumero.clear;

    i := frmClientesContrato.ShowModal;
  finally
    frmClientesContrato.Free;
  end;
  if i = mrAbort then
    RefazConsultaCliente(qryorcamentoscliente.asinteger)
  else if i = mrCancel then
    RefazConsultaCliente(qryorcamentoscliente.asinteger)
//    Fecha(ctVendaTabelaCadastroClientes)
  else if i = mrOk then
  begin
    EditarOrcamentos;
    AtribuirClienteExpress;
  end;

//  flkCodigoCliente.SetFocus;
end;

