procedure TdtmOrcamentos.SelecionarCliente;
begin

  if qryConsultaClientes.RecordCount > 0 then
  begin
    if qryOrcamentos.State = dsBrowse then
      qryOrcamentos.Edit;

    qryOrcamentostipocliente.AsString := qryConsultaClientestipo.AsString;

    qryProcuraCliente.AfterOpen := nil;
    RefazConsultaPorNome(qryProcuraCliente,['codigo','tipocliente'],
     [qryConsultaClientescodigo.AsVariant,qryConsultaClientestipo.AsVariant]);
    qryProcuraCliente.AfterOpen :=  qryProcuraClienteAfterOpen;

    qryOrcamentoscliente.AsInteger := qryConsultaClientescodigo.AsInteger;
    qryProcuraClienteAfterOpen(nil);

    if qryConsultaClientestipo.AsString = 'C' then
      RefazConsulta(qryClientes, [0], [qryConsultaClientescodigo.AsInteger]);
    AtribuirClientenoOrcamento;
  end;

end;

