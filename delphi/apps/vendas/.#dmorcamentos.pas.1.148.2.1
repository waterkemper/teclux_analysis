procedure TdtmOrcamentos.dsrOrcamentosDataChange(Sender: TObject; Field: TField);
begin
  inherited;
  if field = qryOrcamentospessoanumero then
  begin
    case InputFormCustomer of
      cpfcnpj:
      begin
        qryProcuraCliente.parambyname('pessoanumero').asString := qryOrcamentospessoanumero.asString;
        qryProcuraCliente.ParamByName('codigo').Clear;
        qryProcuraCliente.ParamByName('tipo').Clear;
        qryProcuraCliente.close;
        qryProcuraCliente.open;
        if qryProcuraCliente.isempty then
          if qryOrcamentospessoanumero.asString <> '' then
            IncluirCliente(true)
      end;
    end;
  end
  else
  if (//(Field = qryOrcamentosdesconto) or
      (Field = qryOrcamentosseguro)  or
      (Field = qryOrcamentosfrete)   or
      (Field = qryOrcamentoscreditotroca) or
      (Field = qryOrcamentoscliente) or
      (Field = qryOrcamentoscodigo_cupom)) then
  begin
    if (Field = qryOrcamentoscliente) then
    begin

      if qryProcuraCliente.Recordcount > 0 then
      begin
