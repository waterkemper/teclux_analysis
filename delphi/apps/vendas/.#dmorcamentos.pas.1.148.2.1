procedure TdtmOrcamentos.GerarCopiaOrcamento;
var
  Codigo  : Integer;
  Produtos: Currency;
begin
  if ValidarDadosOrcamento then
  begin
    if MensagemConfirmacao(ctORCAMENTO_GERAR_COPIA) = smbOk then begin
      ReFazConsulta(qryOrcamentosCopia,[0],[0]);
      ReFazConsultapornome(qryProdutosOrcamentosCopia,['orcamento'],[0]);
      RefazConsulta(qryServicosOrcamentoCopia,[0],[0]);

      spcOrcamentoProximo.Open;
      Codigo:= spcOrcamentoProximonumero.AsInteger;
      spcOrcamentoProximo.Close;

      qryOrcamentosCopia.Append;
      qryOrcamentosCopiacodigo.AsInteger         := Codigo;
      qryOrcamentosCopiaemissao.AsDateTime       := DataServidor;
      qryOrcamentosCopiavalidade.AsDateTime      := DataServidor + ParSistema.DiasValidadeOrcamento;


      qryOrcamentosCopiavendedor.AsInteger       := qryOrcamentosvendedor.AsInteger;
      qryOrcamentosCopiafilial.AsInteger         := FilialBase;
      qryOrcamentosCopiafrete.AsCurrency         := 0;
      qryOrcamentosCopiaseguro.AsCurrency        := 0;
      if not qryOrcamentosfilialmontagem.IsNull then
        qryOrcamentosCopiafilialmontagem.AsInteger := qryOrcamentosfilialmontagem.AsInteger;
      qryOrcamentosCopiasituacao.AsString        := 'A';

      if not qryOrcamentoscliente.IsNull then
        qryOrcamentosCopiacliente.AsInteger        := qryOrcamentoscliente.AsInteger;
      if not qryOrcamentostipocliente.IsNull then
        qryOrcamentosCopiatipocliente.AsString     := qryOrcamentostipocliente.AsString;

      qryOrcamentosCopianome.AsString            := qryOrcamentosnome.AsString;
      qryOrcamentosCopiapessoatipo.AsString      := qryOrcamentospessoatipo.AsString;
      if not qryOrcamentospessoanumero.IsNull then
