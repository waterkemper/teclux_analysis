function TdtmOrcamentos.ExcluirPlanoOrcamento: Boolean;
begin
  Result:= False;
  if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o PLANO'])) = smbOk then begin
    if not qryPlanosOrcamentos.IsEmpty then begin
      qryParcelasPlanosOrcamentos.First;
      while not qryParcelasPlanosOrcamentos.Eof do
        qryParcelasPlanosOrcamentos.Delete;

      qryPlanosOrcamentos.AfterScroll:= nil;
      qryPlanosOrcamentos.Delete;
      qryPlanosOrcamentos.AfterScroll:= qryPlanosOrcamentosAfterScroll;
      result := Perpetrar([qryorcamentos, qryParcelasPlanosOrcamentos, qryPlanosOrcamentos]);

      ReFazConsulta(qryParcelasPlanosOrcamentos,[0,1],[qryPlanosOrcamentosorcamento.AsInteger,
                                                       qryPlanosOrcamentosplano.AsInteger]);
    end;
  end;
end;

