      if VisualizandoFornecedoresProdutos then
        AbrirFornecedoresProdutos;

      if VisualizandoGradesProdutos then
        AbrirGradesProdutos;

    end;
end;

procedure TdtmOrcamentos.AdiconarProdutosdaLista(Listas: vTtecQuery;  TipoImportacao: tpImportacaoArquivo);
begin
//  qryorcamentos.disablecontrols;
  qryprodutosorcamentos.disablecontrols;

  case TipoImportacao of
    OrcamentosProdDescQtde :
    begin

      if (Listas[0] <> nil) and
         (Listas[1] <> nil) and
         (Listas[2] <> nil) and
         (Listas[3] <> nil) then

      begin
//        IncluindoouEditandoProduto := true;
//        Listas[0].disablecontrols;
//        Listas[1].disablecontrols;


        Listas[0].first;
        while not Listas[0].eof do
        begin
          IncluirOrcamento;
          qryorcamentosvendedor.asinteger := Listas[2].fieldbyname('codigo').asinteger;
          qryorcamentoscliente.asinteger := Listas[3].fieldbyname('codigo').asinteger;
          qryorcamentostipocliente.asString := Listas[3].fieldbyname('tipo').asString;
          if Listas[0].fieldbyname('documento').asString <> '' then
            qryOrcamentosobservacao.asString := 'ORDEM DE COMPRA: '+Listas[0].fieldbyname('documento').asString;

          if Listas[0].fieldbyname('cliente').asString <> '' then
            qryOrcamentosobservacao.asString := trim(qryOrcamentosobservacao.asString +
                                               ' CLIENTE: '+Listas[0].fieldbyname('cliente').asString+chr(13));

          qryOrcamentosobservacao.asString := qryOrcamentosobservacao.asString + Listas[0].FieldByName('observacoes').asString;

          Listas[1].first;
          while not Listas[1].eof do
          begin

            if not Listas[1].fieldbyname('produto').isnull and
               not Listas[1].fieldbyname('produtovisual').isnull then
            begin

              qryProcuraProduto.parambyname('produtovisual').asstring := Listas[1].fieldbyname('produtovisual').asString;
              qryProcuraProduto.close;
              qryProcuraProduto.open;

              {
              if qryProcuraProduto.isempty then
                mensagemAviso('O produto '+Listas[1].fieldbyname('produtovisual').asString+' com codigo no cliente '+
                                          Listas[1].fieldbyname('produtocliente').asString +chr(13)+' não pode ser selecionado para o orçamento')
              else
              begin
}
                if qryProdutosOrcamentos.locate('produto', Listas[1].fieldbyname('produto').asstring, []) then
                  qryProdutosOrcamentos.edit
                else
                  qryProdutosOrcamentos.append;

                qryProdutosOrcamentosfilial.asinteger := FilialBase;
                qryProdutosOrcamentosproduto.asString := Listas[1].fieldbyname('produto').asstring;
