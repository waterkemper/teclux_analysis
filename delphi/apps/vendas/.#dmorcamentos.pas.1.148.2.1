procedure TdtmOrcamentos.ResumoParcelas(var Parcelas: TResumosParcelas);
var
  Pos: TBookmark;
  a: Integer;
begin
{
  if not qryParcelasPlanosOrcamentos.IsEmpty then begin
    SetLength(Parcelas, qryParcelasPlanosOrcamentos.RecordCount);
    qryParcelasPlanosOrcamentos.DisableControls;
    Pos := qryParcelasPlanosOrcamentos.GetBookmark;
    try
      a := 0;
      qryParcelasPlanosOrcamentos.First;
      while Not qryParcelasPlanosOrcamentos.Eof do begin
        Parcelas[a].Parcelas   := 1;
        Parcelas[a].Vencimento := qryParcelasPlanosOrcamentosdata.AsDateTime;
        Parcelas[a].Valor      := qryParcelasPlanosOrcamentosvalor.AsCurrency;
        Parcelas[a].FormaPagamento  := qryParcelasPlanosOrcamentosformapagamento.AsString;
        Parcelas[a].TipoRecebimento := qryParcelasPlanosOrcamentostiporecebimento.AsInteger;
        Parcelas[a].DescricaoTipoRecebimento := qryParcelasPlanosOrcamentosdescricaotiporecebimento.AsString;

        qryParcelasPlanosOrcamentos.Next;
        Inc(a)
      end
    finally
      qryParcelasPlanosOrcamentos.GotoBookmark(Pos);
      qryParcelasPlanosOrcamentos.FreeBookmark(Pos);
      qryParcelasPlanosOrcamentos.EnableControls;
    end;
  end;
}

  qryParcelasPlanosOrcamentos.DisableControls;
  Pos := qryParcelasPlanosOrcamentos.GetBookmark;
  try
    a := 0;
    qryParcelasPlanosOrcamentos.First;
    while Not qryParcelasPlanosOrcamentos.Eof do begin
      if qryParcelasPlanosOrcamentosformapagamento.AsString<>'T' then
      begin
        SetLength(Parcelas, a+1);
        Parcelas[a].Parcelas   := 1; //qryParcelasparcelas.AsInteger;
        Parcelas[a].Vencimento := qryParcelasPlanosOrcamentosdata.AsDateTime;
        Parcelas[a].Valor      := qryParcelasPlanosOrcamentosvalor.AsCurrency;
        Parcelas[a].FormaPagamento := qryParcelasPlanosOrcamentosformapagamento.AsString;
        Parcelas[a].TipoRecebimento:= qryParcelasPlanosOrcamentostiporecebimento.AsInteger;
        Parcelas[a].DescricaoTipoRecebimento := qryParcelasPlanosOrcamentosdescricaotiporecebimento.AsString;
        Parcelas[a].Substituicao := false {qryParcelasvalorvencto.AsCurrency = qryContratosvaloricmssubstituicao.AsCurrency};
        Inc(a);
      end;
      qryParcelasPlanosOrcamentos.Next;
    end
  finally
    qryParcelasPlanosOrcamentos.GotoBookmark(Pos);
    qryParcelasPlanosOrcamentos.FreeBookmark(Pos);
    qryParcelasPlanosOrcamentos.EnableControls;
  end

end;

function TdtmOrcamentos.DefinirParcelas(Parcelas: TResumosParcelas; var ValorPrazo, TaxaJuros, Desconto: Real; var Plano: Integer; PlanoSelecionado: boolean): boolean;
const
(*
{  Numero        = 1;}
  Vencimento    = 1;
  Valor         = 2;
  FormadePagamento = 3;
  tiporecebimento = 4;
  descricaotiporecebimento = 5;
*)

  Numero           = 1;
  Vencimento       = 2;
  Valor            = 3;
  FormaPagamento   = 4;
  TipoRecebimento  = 5;
  DescricaoTipoRecebimento = 6;
  Substituicao     = 7;

var
  A,B,NP, QTP: Integer;
  ParcelasAuxiliar: array [1..7] of TStringList;
  Data: TDateTime;
  Descto: Currency;
  Vencto : String;

  procedure ValidarValoresParcelas;
  var
    Total,
    Dif: Currency;

  begin
    if not qryParcelasPlanosOrcamentos.IsEmpty then
    begin
      Total:= 0;
      qryParcelasPlanosOrcamentos.First;
      while not qryParcelasPlanosOrcamentos.Eof do begin
        Total:= Total + qryParcelasPlanosOrcamentosvalor.AsCurrency;
        qryParcelasPlanosOrcamentos.Next;
      end;
      Dif:= qryPlanosOrcamentosvalorprazo.AsCurrency - (Total + qryOrcamentoscreditotroca.ascurrency);
             {
      if Dif <> 0 then
      begin
        qryParcelasPlanosOrcamentos.First;
        qryParcelasPlanosOrcamentos.Edit;
        qryParcelasPlanosOrcamentosvalor.AsCurrency := qryParcelasPlanosOrcamentosvalor.AsCurrency + Dif;
        qryParcelasPlanosOrcamentos.Post;
      end;
      }

      qryPlanosOrcamentos.edit;
      if Dif > 0 then
      begin
        qryPlanosOrcamentosdesconto.AsCurrency := Dif
      end
      else
      if Dif < 0 then
        qryPlanosOrcamentosvalorprazo.AsCurrency := Total;

      if (qryPlanosOrcamentosvalorvista.AsCurrency > qryPlanosOrcamentosvalorprazo.AsCurrency) then
         qryPlanosOrcamentosvalorvista.AsCurrency := qryPlanosOrcamentosvalorprazo.AsCurrency;

      if qryPlanosOrcamentos.state = dsedit then
        qryPlanosOrcamentos.post;

    end;
    { 21/05/19
    dsrOrcamentos.onDataChange := nil;
    AtribuirCodigoOrcamento;
    result := Perpetrar([qryOrcamentos, qryprodutosOrcamentos, qryPlanosOrcamentos, qryParcelasPlanosOrcamentos]);
    dsrOrcamentos.onDataChange := dsrOrcamentosDataChange;
    }

  end;

begin
  Result := true;

  if Plano > 0 then
  begin
    ReFazConsulta(qryPlanos,[0],[Plano], true);
    TaxaJuros:= qryPlanostaxamensaljuros.AsFloat;

    (*    21/05/19
    ReFazConsulta(qryPlanosOrcamentos,[0],[qryOrcamentosCodigo.AsInteger], true);

    if qryPlanosOrcamentos.Locate('plano',Plano,[]) then
    begin
      qryPlanosOrcamentos.AfterScroll:= nil;

      qryParcelasPlanosOrcamentos.First;
      while not qryParcelasPlanosOrcamentos.Eof do
        qryParcelasPlanosOrcamentos.Delete;

      qryPlanosOrcamentos.Delete;

      dsrOrcamentos.onDataChange := nil;
      AtribuirCodigoOrcamento;
      result := Perpetrar([qryOrcamentos, qryprodutosOrcamentos, qryParcelasPlanosOrcamentos, qryPlanosOrcamentos]);
      dsrOrcamentos.onDataChange := dsrOrcamentosDataChange;

      {Atenção:  afterscroll depois do perpetrar caso contrario perde-se o delete}
      qryPlanosOrcamentos.AfterScroll:= qryPlanosOrcamentosAfterScroll;
    end;
    *)

    if result then
    begin

      try

        dsrPlanosOrcamento.OnDataChange := nil;

        qryplanosorcamentos.first;
        if qryplanosorcamentos.Locate('orcamento;plano', VarArrayOf([qryOrcamentoscodigo.AsInteger,Plano]),[]) then
          qryPlanosOrcamentos.edit
        else
          qryPlanosOrcamentos.Append;


        qryPlanosOrcamentosverificado.AsBoolean := true;
        qryPlanosOrcamentosorcamento.AsInteger  := qryOrcamentoscodigo.AsInteger;
        qryPlanosOrcamentosplano.AsInteger      := Plano;
        qryPlanosOrcamentosdescricao.AsString   := qryPlanosdescricao.AsString;
        qryPlanosOrcamentostaxajuro.AsFloat     := TaxaJuros;
        qryPlanosOrcamentosdesconto.AsCurrency  := Desconto;

        qryPlanosOrcamentosvalorvista.AsCurrency:= ((qryOrcamentostotalprodutos.AsCurrency - qryOrcamentoscupom_valor_desconto.AsCurrency) +
                                                       qryOrcamentostotalservicos.AsCurrency +
                                                       qryOrcamentosFrete.AsCurrency +
                                                       qryOrcamentosseguro.AsCurrency) -
                                                      {qryOrcamentoscreditotroca.AsCurrency - }
                                                       qryPlanosOrcamentosdesconto.AsCurrency;


        if Desconto > qryPlanosOrcamentosvalorvista.AsCurrency then
          qryPlanosOrcamentosvalorvista.AsCurrency:= 0;

        if TaxaJuros = 0 then
             qryPlanosOrcamentosvalorprazo.AsCurrency:= qryPlanosOrcamentosvalorvista.AsCurrency
        else qryPlanosOrcamentosvalorprazo.AsCurrency:= ValorPrazo - Desconto;

        qryPlanosOrcamentosselecionar.AsBoolean      := False;
        qryPlanosOrcamentos.Post;

        {   21/05/19
        if qryOrcamentoscodigo.asinteger <> 0 then
        begin
          dsrOrcamentos.onDataChange := nil;
          AtribuirCodigoOrcamento;
          result := Perpetrar([qryOrcamentos, qryprodutosOrcamentos, qryPlanosOrcamentos]);
          dsrOrcamentos.onDataChange := dsrOrcamentosDataChange;
        end;
        }

      finally
        dsrPlanosOrcamento.OnDataChange:= dsrPlanosOrcamentoDataChange;
      end;

      if result then
      begin
        if planoselecionado then
          SelecionarPlano;

        try

          ParcelasAuxiliar[Numero] := TStringList.Create;
          ParcelasAuxiliar[Vencimento] := TStringList.Create;
          ParcelasAuxiliar[Valor] := TStringList.Create;
          ParcelasAuxiliar[FormaPagamento] := TStringList.Create;
          ParcelasAuxiliar[TipoRecebimento] := TStringList.Create;
          ParcelasAuxiliar[DescricaoTipoRecebimento] := TStringList.Create;
          ParcelasAuxiliar[Substituicao] := TStringList.Create;

          NP := 1;
          if ParSistema.utilizarcreditotrocacontrato  then
            if qryOrcamentoscreditotroca.AsCurrency > 0 then
            begin
              ParcelasAuxiliar[Numero].Append(inttostr(NP));
              ParcelasAuxiliar[Vencimento].Append(datetostr(qryOrcamentosemissao.AsDateTime));
              ParcelasAuxiliar[Valor].Append(floattostr(qryOrcamentoscreditotroca.AsCurrency));
              ParcelasAuxiliar[FormaPagamento].Append('T');
              Parcelasauxiliar[TipoRecebimento].Append(ValorCampodaTabela('tiposrecebimentos', ['descricao'], ['CRÉDITO DE TROCA'], ['codigo'])[0]);    //DINHEIRO...ATENÇÃO A tabela tiposrecebimentos
              Parcelasauxiliar[DescricaoTipoRecebimento].Append('CRÉDITO DE TROCA');
              ParcelasAuxiliar[Substituicao].Append('FALSE');
              NP := NP+1;
            end;

          (*
          ORÇAMENTO AINDA SEM ST

          if (qryContratosvaloricmssubstituicao.AsCurrency > 0) and
             (ParSistema.GerarParcelaSubstituicaoTributaria) then
            for A := 0 to high(Parcelas) do
              if Parcelas[A].Substituicao then
                Parcelas[A].Valor := qryContratosvaloricmssubstituicao.AsCurrency;
          *)

          for A := 0 to high(Parcelas) do
          begin
            B := 0;
            Data := Parcelas[A].Vencimento;
            while B < Parcelas[A].Parcelas do
            begin
              if (Parcelas[A].Valor<>0) then
              begin
                ParcelasAuxiliar[Numero].Append(inttostr(NP));
                if B = 0 then
                  ParcelasAuxiliar[Vencimento].Append(datetimetostr(Data))
                else
                begin
                  if qryPlanosmestrintadias.AsBoolean then
                    ParcelasAuxiliar[Vencimento].Append(datetimetostr(SomarDia(Data,qryPlanosintervaloparcelas.AsInteger*B,'S')))
                  else ParcelasAuxiliar[Vencimento].Append(datetimetostr(SomarDia(Data,qryPlanosintervaloparcelas.AsInteger*B,'N')));
                end;
                ParcelasAuxiliar[Valor].Append(floattostr(Parcelas[A].Valor));
                ParcelasAuxiliar[FormaPagamento].Append(Parcelas[A].FormaPagamento);
                ParcelasAuxiliar[TipoRecebimento].Append(IntToStr(Parcelas[A].TipoRecebimento));
                ParcelasAuxiliar[DescricaoTipoRecebimento].Append(Parcelas[A].DescricaoTipoRecebimento);
                ParcelasAuxiliar[Substituicao].Append(BoolToStr(Parcelas[A].Substituicao,True));
                Inc(NP);
              end;
              Inc(B);
            end;
          end;

          (*
          for A := 0 to Length(Parcelas) - 1 do
          begin
            B := 0;
            Data := Parcelas[A].Vencimento;
            while B < Parcelas[A].Parcelas do begin
              ParcelasAuxiliar[Vencimento].Append(DateTimeToStr(Data));
              ParcelasAuxiliar[Valor].Append(FloatToStr(Parcelas[A].Valor));
              ParcelasAuxiliar[FormadePagamento].Append(Parcelas[A].FormaPagamento);
              ParcelasAuxiliar[tiporecebimento].Append(inttostr(Parcelas[A].TipoRecebimento));
              ParcelasAuxiliar[descricaotiporecebimento].Append(Parcelas[A].DescricaoTipoRecebimento);

              if qryPlanosmestrintadias.AsBoolean then
                   Data:= SomarDia(Data,qryPlanosintervaloparcelas.AsInteger,'S')
              else Data:= SomarDia(Data,qryPlanosintervaloparcelas.AsInteger,'N');
              Inc(B);
            end;
          end;
          *)

          for A := 1 to ParcelasAuxiliar[Vencimento].Count - 1 do begin
            B := A;
            While strtodatetime(ParcelasAuxiliar[Vencimento].Strings[B])<
                  strtodatetime(ParcelasAuxiliar[Vencimento].Strings[B-1]) do
            begin
              ParcelasAuxiliar[Vencimento].Move(B,B-1);
              ParcelasAuxiliar[Numero].Move(B,B-1);
              ParcelasAuxiliar[Valor].Move(B,B-1);
              ParcelasAuxiliar[FormaPagamento].Move(B,B-1);
              ParcelasAuxiliar[TipoRecebimento].Move(B,B-1);
              ParcelasAuxiliar[DescricaoTipoRecebimento].Move(B,B-1);
              ParcelasAuxiliar[Substituicao].Move(B,B-1);
              if B=1 then
                break
              else
                B := B-1;
            end;
          end;

          QTP:= 0;
          Vencto := '';
          for A := 0 to ParcelasAuxiliar[Vencimento].Count - 1 do
            if (ParcelasAuxiliar[Vencimento].Strings[A] <> Vencto) or
               ((ParcelasAuxiliar[Vencimento].Strings[A] = Vencto) and
                (ParSistema.GerarParcelaSubstituicaoTributaria) and
                (qryOrcamentospessoatipo.AsString = 'J')) then
            begin
              QTP := QTP + 1;
              Vencto := ParcelasAuxiliar[Vencimento].Strings[A];
            end;

          (*
          for A := 0 to ParcelasAuxiliar[Vencimento].Count - 1 do
          begin

            if FReCalculandoPlano then begin
              if Desconto > 0 then
                   Descto:= RoundTo((Desconto / ParcelasAuxiliar[Vencimento].Count),-2)
              else Descto:= 0;
            end
            else Descto:= 0;

            qryParcelasPlanosOrcamentos.Append;
            qryParcelasPlanosOrcamentosnumero.AsInteger := A + 1;
            qryParcelasPlanosOrcamentosorcamento.AsInteger:= qryOrcamentoscodigo.AsInteger;
            qryParcelasPlanosOrcamentosplano.AsInteger    := Plano;
            qryParcelasPlanosOrcamentosdata.AsDateTime    := StrToDate(ParcelasAuxiliar[Vencimento].strings[A]);
            qryParcelasPlanosOrcamentosvalor.AsCurrency   := StrToCurr(ParcelasAuxiliar[Valor].strings[A]) - Descto;
            qryParcelasPlanosOrcamentosformapagamento.AsString := ParcelasAuxiliar[FormadePagamento].strings[A];
            qryParcelasPlanosOrcamentostiporecebimento.asinteger := strtoint(ParcelasAuxiliar[tiporecebimento].strings[A]);
            qryParcelasPlanosOrcamentosdescricaotiporecebimento.asString := ParcelasAuxiliar[descricaotiporecebimento].strings[A];

            qryParcelasPlanosOrcamentos.Post;

          end;

          *)

          NP:= 0;
          Vencto := '';
          for A := 0 to ParcelasAuxiliar[Vencimento].Count - 1 do
          begin

            if (ParcelasAuxiliar[Vencimento].Strings[A] <> Vencto) or
               ((ParcelasAuxiliar[Vencimento].Strings[A] = Vencto) and
                (ParSistema.GerarParcelaSubstituicaoTributaria) and
                (qryContratospessoatipo.AsString = 'J')) then
            begin
              NP := NP + 1;
              Vencto := ParcelasAuxiliar[Vencimento].Strings[A];
            end;


            if qryParcelasplanosorcamentos.Locate('orcamento;plano;numero',
               VarArrayOf([qryOrcamentoscodigo.AsInteger,Plano, strtoint(ParcelasAuxiliar[Numero].Strings[A])]),[]) then
              qryParcelasPlanosOrcamentos.edit
            else
              qryParcelasPlanosOrcamentos.Append;

            qryParcelasPlanosOrcamentosverificado.AsBoolean := true;
            qryParcelasPlanosOrcamentosorcamento.AsInteger:= qryOrcamentoscodigo.AsInteger;
            qryParcelasPlanosOrcamentosplano.AsInteger    := Plano;

            qryParcelasPlanosOrcamentosnumero.AsInteger        := strtoint(ParcelasAuxiliar[Numero].Strings[A]);
            qryParcelasPlanosOrcamentosparcelaorigem.AsString  := inttostr(NP)+'/'+inttostr(QTP);
            qryParcelasPlanosOrcamentosdata.AsString     := ParcelasAuxiliar[Vencimento].strings[A];
            qryParcelasPlanosOrcamentosvalor.AsString    := ParcelasAuxiliar[Valor].strings[A];
            if ParcelasAuxiliar[TipoRecebimento].Strings[A] <> '0' then
              qryParcelasPlanosOrcamentostiporecebimento.AsString := ParcelasAuxiliar[TipoRecebimento].Strings[A];
            qryParcelasPlanosOrcamentosdescricaotiporecebimento.asString := ParcelasAuxiliar[DescricaoTipoRecebimento].Strings[A];

            if ParcelasAuxiliar[FormaPagamento].strings[A]='T' then
            begin
              qryParcelasPlanosOrcamentosformapagamento.AsString := ParcelasAuxiliar[FormaPagamento].strings[A];

              {
              if SituacaoContrato > scRESERVADO then
              begin
                qryParcelasdatapagto.AsDateTime := qryParcelasdatavencto.AsDateTime;
                qryParcelasvalorpagto.Ascurrency := qryParcelasvalorvencto.AsCurrency;
                qryParcelasfilialpagto.AsInteger := FilialBase;
                qryParcelasNometipopagto.AsString := 'Quitada';
              end;
              }

            end
            else
              if ParcelasAuxiliar[FormaPagamento].strings[A] <> '' then
                qryParcelasPlanosOrcamentosformapagamento.AsString := ParcelasAuxiliar[FormaPagamento].strings[A]
              else
                qryParcelasPlanosOrcamentosformapagamento.AsString := 'D';

                              (*
             if ParcelasAuxiliar[Substituicao].Strings[A] = 'True' then
               qryParcelassubstituicao.AsBoolean := true
             else
               qryParcelassubstituicao.AsBoolean := false;
                              *)

            qryParcelasPlanosOrcamentos.Post;
          end;
          { 21/05/19
          dsrOrcamentos.onDataChange := nil;
          AtribuirCodigoOrcamento;
          result := Perpetrar([qryOrcamentos, qryprodutosOrcamentos, qryParcelasPlanosOrcamentos]);
          dsrOrcamentos.onDataChange := dsrOrcamentosDataChange;
          }

        finally

          qryParcelasPlanosOrcamentos.First;
        end;

        if result then
          ValidarValoresParcelas;
      end;

    end;

  end;
end;

