function TdtmOrcamentos.SelecionarProdutoContratoConsulta: boolean;

begin
//result := VerificarSaldoEstoque(qryConsultaProdutos);
  result := true;
  if result then
  begin
    if (ParSistema.FiliaisIndependentes) then
    begin
      qryProdutosOrcamentosfilial.AsInteger   := qryConsultaProdutosfilial.AsInteger;
      qryProdutosOrcamentosproduto.AsLargeInt := qryConsultaProdutosproduto.AsLargeInt;
      qryProdutosOrcamentosprodutovisual.AsString := qryConsultaProdutosprodutovisual.AsString;
      qryProdutosOrcamentosprodutodigitado.AsString := qryConsultaProdutosprodutovisual.AsString;

      qryProcuraProduto.ParamByname('FilialSaida').AsInteger     := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
      qryProcuraProduto.ParamByname('FilialPreco').AsInteger     := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
    end
    else
    begin
      qryProdutosOrcamentosfilial.AsInteger   := qryConsultaProdutosfilial.AsInteger;
      qryProdutosOrcamentosproduto.AsLargeInt := qryConsultaProdutosproduto.AsLargeInt;
      qryProdutosOrcamentosprodutovisual.AsString := qryConsultaProdutosprodutovisual.AsString;
      qryProdutosOrcamentosprodutodigitado.AsString := qryConsultaProdutosprodutovisual.AsString;

      qryProcuraProduto.ParamByname('FilialSaida').AsInteger := qryConsultaProdutosfilial.Asinteger; {liberado o comentario em 26/07/12 devido ao facto q n~stva trocando a filial}
      if ParSistema.UtilizarPrecoFilialBase then
        qryProcuraProduto.ParamByname('FilialPreco').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual)
      else
        qryProcuraProduto.ParamByname('FilialPreco').AsInteger := qryConsultaProdutosfilial.AsInteger;
    end;
  end;

end;

function TdtmOrcamentos.ValidarProdutosContratos: Boolean;
begin
  RefazConsulta(qryEstoque,[0],[IntToStr(qryProcuraProdutoProduto.AsLargeInt)]);
  RefazConsultaProdutoEstoque(IntToStr(qryProcuraProdutoProduto.AsLargeInt),qryProcuraProdutofilial.AsInteger);

  if (qryProdutoEstoqueemestoque.AsFloat <= 0) then
  begin
    if(PermitirVendaProdutoSemEstoque) then
    begin
      SelecionarProdutoContratoProcura;
      Result:= True;
      ConsultaExecutada:= True;
    end
    else
    begin
      qryProcuraProduto.Cancel;
      qryProdutosContratos.Cancel;
      Fecha(ctVendaTabelaConsultaProdutos);
      Result:= False;
      ConsultaExecutada:= True;
    end;
  end
  else
  begin
    SelecionarProdutoContratoProcura;
    Result:= True;
  end;

end;

function TdtmOrcamentos.PermitirVendaProdutoSemEstoque: Boolean;
var
  UsrAut: TtecUsuarios;
  Complemento: String;
begin
  if ParSistema.ProdutosnoOrcamentoComEstoque then
  begin
    Complemento := Format(ctSEMESTOQUESEMVENDA, [qryProdutosOrcamentosproduto.AsString, qryProdutosOrcamentosfilial.AsString]);
    UsrAut := ObterAutorizacao(taLOGIN, ctVENDASEMESTOQUE, ctGERENTEESTOQUE, Complemento);
    Result := Assigned(UsrAut) and UsrAut.GerenteEstoque;
    if Assigned(UsrAut) and Not UsrAut.GerenteEstoque then begin
      MensagemAviso(ctUSUARIOSEMPERMISSAO);
      Result := False
    end
  end else
    Result := True
end;


function TdtmOrcamentos.SelecionarProdutoContratoProcura: boolean;
begin
  //ATUALIZACAO PELO CODIGO DO PRODUTO
//  result := VerificarSaldoEstoque(qryProcuraProduto);
  result := true;

  if result then
  begin

    RefazConsultapornome(qryEstoque,['produto'],[IntToStr(qryProcuraProdutoproduto.AsLargeInt)]);
    qryConsultaFilialProduto.Parambyname('produto').AsString := IntToStr(qryProcuraProdutoproduto.AsLargeInt);
    qryProcuraFilialProduto.Parambyname('produto').AsString  := IntToStr(qryProcuraProdutoproduto.AsLargeInt);

    if (qryProdutosOrcamentos.state in [dsedit, dsinsert]) then
    begin

      AtribuirdadosProdutos(qryprodutosOrcamentos, qryorcamentos, nil, false, Orcamento,
                            qryOrcamentosestado.asString);

      qryProdutosOrcamentosmontagemoriginal.AsBoolean := qryProcuraProdutomontagem.AsBoolean;
      qryProdutosOrcamentospromocao.AsBoolean:= qryProcuraProdutopromocao.AsBoolean;
      qryProdutosOrcamentosdeny_discount.AsBoolean := qryProcuraProdutodeny_discount.asBoolean;

      if qryProcuraProdutomontagem.AsBoolean then
         qryProdutosOrcamentosmontagem.AsString := 'S'
      else
         qryProdutosOrcamentosmontagem.AsString := 'N';

      if qryProcuraProdutoemEstoque.asCurrency = 0 then
        qryProdutosOrcamentossituacao_produto.asstring := 'N'
      else
      if qryProcuraProdutoemEstoque.asCurrency < qryProdutosorcamentosquantidade.asCurrency then
        qryProdutosOrcamentossituacao_produto.asstring := 'P'
      else
        qryProdutosOrcamentossituacao_produto.asstring := 'A';

      qryProdutosOrcamentoscodigobarras.AsString   := qryProcuraProdutocodigobarras.AsString;
      qryProdutosOrcamentosdescricao.AsString      := qryProcuraProdutodescricao.AsString;
      qryProdutosOrcamentosclassificacaofiscal.AsString := qryProcuraProdutoclassificacaofiscal.asString;

      qryProdutosOrcamentosvalorgrade1.AsString    := qryProcuraProdutovalorgrade1.AsString;
      qryProdutosOrcamentosvalorgrade2.AsString    := qryProcuraProdutovalorgrade2.AsString;
      qryProdutosOrcamentosanvisa.asString := qryProcuraProdutoanvisa.AsString;
      qryProdutosOrcamentoslinha.AsString          := qryProcuraProdutolinha.AsString;
      qryProdutosOrcamentoscoluna.AsString         := qryProcuraProdutocoluna.AsString;
      qryProdutosOrcamentosvalorgrade2.AsString    := qryProcuraProdutovalorgrade2.AsString;
      qryProdutosOrcamentosunidade.AsString        := qryProcuraProdutounidade.AsString;
      qryProdutosOrcamentosbrinde.AsBoolean        := qryProcuraProdutobrinde.AsBoolean;

      if qryProcuraProdutofilial.AsInteger <> 0 then
        qryProdutosOrcamentosfilial.AsInteger         := qryProcuraProdutofilial.AsInteger;

      qryProdutosOrcamentosvendasemestoque.AsString:= qryProcuraProdutovendasemestoque.AsString;

      qryProdutosOrcamentoscomposto.AsBoolean      := qryProcuraProdutocomposto.AsBoolean;

      RefazConsultaProdutoEstoque(IntToStr(qryProcuraProdutoProduto.AsLargeInt),
                                   qryProdutosOrcamentosfilial.AsInteger);


      qryProdutosOrcamentosemestoque.AsCurrency := qryProdutoEstoqueemestoque.AsCurrency;
      qryProdutosOrcamentosreservado.AsCurrency := qryProdutoEstoquereservado.AsCurrency;
      qryProdutosOrcamentosfuturo.AsCurrency    := qryProdutoEstoquefuturo.AsCurrency;
      qryProdutosOrcamentosprecovenda.AsFloat   := qryProdutoEstoquepreco.AsFloat;
      qryProdutosOrcamentosprecotabela.AsFloat  := qryProdutoEstoquepreco.AsFloat;
    end;

//    if ParSistema.MostrarSimilaresContrato then
      ABrirDadosProdutos;



    //ATUALIZACAO PELO CODIGO DA FILIAL DO PRODUTO
    if (ParSistema.FiliaisIndependentes) then
    begin
      qryProcuraProduto.ParamByname('FilialSaida').AsInteger     := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
      qryProcuraProduto.ParamByname('FilialPreco').AsInteger     := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
    end
    else
    begin
      qryProcuraProduto.ParamByname('FilialSaida').AsInteger      := qryProcuraProdutofilial.Asinteger;
      if ParSistema.UtilizarPrecoFilialBase then
        qryProcuraProduto.ParamByname('FilialPreco').AsInteger    := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual)
      else
        qryProcuraProduto.ParamByname('FilialPreco').AsInteger := qryProcuraProdutofilial.AsInteger;
    end;



    {
    ReFazConsulta(qryProcuraReservaProduto,[2,3],[IntToStr(qryProcuraProdutoProduto.AsLargeInt),
                                                    qryProcuraProdutofilial.asinteger]);
    ReFazConsulta(qryConsultaReservasProduto,[1,2],[IntToStr(qryProcuraProdutoProduto.AsLargeInt),
                                                    qryProcuraFilialProdutocodigo.AsInteger]);

    if (qryProdutosOrcamentos.state in [dsedit, dsinsert]) then
      if qryProcuraReservaProduto.RecordCount = 0 then
        qryProdutosOrcamentosreserva.Clear
  }
  end;
end;

