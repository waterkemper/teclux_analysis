end;

function TdtmOrcamentos.ExcluirProdutoOrcamento: Boolean;
begin
  Result := True;
  if qryProdutosOrcamentos.RecordCount > 0 then
  begin
    if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o PRODUTO DO ORÇAMENTO'])) = smbOk then
    begin
      if qryProdutosOrcamentos.State = dsInsert then
           qryProdutosOrcamentos.Cancel
      else
      begin
        qryProdutosOrcamentos.Delete;
        RefazConsulta(qryEstoque,[0],[IntToStr(qryProdutosOrcamentosproduto.AsLargeInt)]);
        LerProdutosFiliaisIncluidos(False);
        qryProdutosOrcamentos.Edit;
        qryProdutosOrcamentos.Cancel;
        ReCalcularPlanosPagamento;
      end;
      qryOrcamentos.Edit;
    end;
  end;
end;

function TdtmOrcamentos.ExcluirOrcamento(Cancelar:Boolean): Boolean;
begin
  Result := True;
  if Cancelar and qryConsultaMotivoscodigo.IsNull then
    MensagemAviso(ctORCAMENTO_MOTIVO)
  else
  begin
    if not qryOrcamentos.IsEmpty then
    begin
      if Cancelar then
      begin
        if qryOrcamentos.CheckRequiredFields then
        begin
          if IncluirAtendimento_(qryOrcamentoscodigo.AsInteger, qryOrcamentoscliente.AsInteger, qryOrcamentostipocliente.AsString, CancelamentoOrcamento, TextoCancelamento) then
          begin
            TabelasSomenteLeitura(False);
            qryOrcamentos.Edit;
            qryOrcamentoscancelamento.AsDateTime:= DataServidor;
            qryOrcamentosmotivo.AsInteger       := qryConsultaMotivoscodigo.AsInteger;
            qryOrcamentossituacao.AsString      := 'C';
            qryOrcamentos.Post;
            result := Perpetrar([qryOrcamentos]);
            if not result then
              Rollback([]);

            ReFazConsulta(qryOrcamentos,[0],[qryOrcamentoscodigo.AsInteger]);
            EncerrarDataModule2_;
          end;

        end;
      end
      else
      begin

        TabelasSomenteLeitura(False);

        qryProdutosOrcamentos.First;
        while not qryProdutosOrcamentos.Eof do
          qryProdutosOrcamentos.Delete;

        if not qryParcelasPlanosOrcamentos.IsEmpty then begin
          qryParcelasPlanosOrcamentos.First;
          while not qryParcelasPlanosOrcamentos.Eof do
            qryParcelasPlanosOrcamentos.Delete;
        end;

        if not qryPlanosOrcamentos.IsEmpty then begin
          qryPlanosOrcamentos.AfterScroll:= nil;
          qryPlanosOrcamentos.First;
          while not qryPlanosOrcamentos.Eof do
            qryPlanosOrcamentos.Delete;
          qryPlanosOrcamentos.AfterScroll:= qryPlanosOrcamentosAfterScroll;
        end;

        qryOrcamentos.Delete;
        Perpetrar([qryParcelasPlanosOrcamentos, qryPlanosOrcamentos, qryProdutosOrcamentos, qryOrcamentos]);
        Result := True;
      end;
    end;

  end;
end;

function TdtmOrcamentos.ExisteCliente(NomeCampo: String; value: Variant): Boolean;
begin
  if NomeCampo = 'nomecidade' then
    NomeCampo:= 'c.nome'
  else if NomeCampo = 'tipocliente' then
    NomeCampo:= 'v.tipo'
  else
  if NomeCampo = 'nome' then
    NomeCampo := 'v.razao'
  else
  if NomeCampo = 'apelido' then
    NomeCampo := 'v.nome'
  else
    NomeCampo:= 'v.' + NomeCampo;
    
  qryConsultaClientes.Sql[11]:= 'Where (UPPER(TO_ASCII(' + NomeCampo + ',''LATIN1'')) like UPPER(TO_ASCII(''' + value + '%'',''LATIN1''))) ';
  qryConsultaClientes.Open;             
  Result := qryConsultaClientes.RecordCount > 0
end;

