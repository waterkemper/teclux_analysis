procedure TdtmOrcamentos.LerProdutosFiliaisIncluidos(Incluindo: Boolean);
var
  Pos: TBookmark;
  a, Filial: Integer;
  Prod: Int64;
begin
  inherited;
  if Incluindo then begin
    qryConsultaFilialProduto.ParamByName('produto').AsInteger := 0;
    qryProcuraFilialProduto.ParamByName('produto').AsInteger := 0;
  end else begin
    qryConsultaFilialProduto.ParamByName('produto').AsString := IntToStr(qryProdutosOrcamentosproduto.AsLargeInt);
    qryProcuraFilialProduto.ParamByName('produto').AsString  := IntToStr(qryProdutosOrcamentosproduto.AsLargeInt);
  end;
  Pos := qryProdutosOrcamentos.GetBookmark;
  qryProdutosOrcamentos.DisableControls;
  try
    a := 0;
    aProdFilial := nil;
    Prod   := qryProdutosOrcamentosproduto.AsLargeInt;
    Filial := qryProdutosOrcamentosfilial.AsInteger;
    qryProdutosOrcamentos.First;
    while Not qryProdutosOrcamentos.Eof do
    begin
      if Incluindo or ((Prod <> qryProdutosOrcamentosproduto.AsLargeInt) or
                       (Filial <> qryProdutosOrcamentosfilial.AsInteger))
      then begin
        SetLength(aProdFilial, a + 1);
        aProdFilial[a].Prod   := qryProdutosOrcamentosproduto.AsString;
        aProdFilial[a].Filial := qryProdutosOrcamentosfilial.AsString;
        Inc(a);
      end;
      qryProdutosOrcamentos.Next;
    end;
  finally
    qryProdutosOrcamentos.GotoBookmark(Pos);
    qryProdutosOrcamentos.FreeBookmark(Pos);
    qryProdutosOrcamentos.EnableControls;
  end;
  FiltrarProdutosEFiliaisOrcamento;
end;

