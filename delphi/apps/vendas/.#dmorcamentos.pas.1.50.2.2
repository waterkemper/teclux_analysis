function TdtmOrcamentos.CriarNovoCliente(Gravar: boolean = false): boolean;
var
  EndComp: Boolean;
begin
  try
    result := true;
    if qryClientes.Active then
      qryClientes.Close;
    qryClientes.Open;

    EndComp:= (not qryOrcamentosrua.IsNull)    and
              (not qryOrcamentosnumero.IsNull)    and
  //              (not qryOrcamentoscomplemento.IsNull)    and
              (not qryOrcamentosbairro.IsNull) and
              (not qryOrcamentoscidade.IsNull) and
              (not qryOrcamentosestado.IsNull) and
              (not qryOrcamentoscep.IsNull);

    qryClientes.Insert;
    spcClientesProximoCodigo.Open;
    qryClientescodigo.AsInteger         := spcClientesProximoCodigocodigo.AsInteger;
    spcClientesProximoCodigo.Close;
    qryClientesnome.AsString            := qryOrcamentosnome.AsString;
    qryClientesempcargo.asvariant := qryorcamentosempcargo.asvariant;

    if EndComp then
    begin
      qryClientesrua.AsString           := qryOrcamentosrua.AsString;

      qryClientesnumero.AsString        := qryOrcamentosnumero.AsString;
      qryClientescomplemento.AsString   := qryOrcamentoscomplemento.AsString;

      qryClientesbairro.AsInteger       := qryOrcamentosbairro.AsInteger;
      qryClientescidade.AsInteger       := qryOrcamentoscidade.AsInteger;
      qryClientesestado.AsString        := qryOrcamentosestado.AsString;
      qryClientescep.AsInteger          := qryOrcamentoscep.AsInteger;
    end
    else
    begin
      ReFazConsulta(qryEnderecoFilial,[0],[FilialBase]);
      qryClientesrua.AsString           := qryEnderecoFilialrua.AsString;
      qryClientesnumero.AsString        := qryEnderecoFilialnumero.AsString;
      qryClientesbairro.AsInteger       := qryEnderecoFilialbairro.AsInteger;
      qryClientescidade.AsInteger       := qryEnderecoFilialcidade.AsInteger;
      qryClientesestado.AsString        := qryEnderecoFilialestado.AsString;
      qryClientescep.AsInteger          := qryEnderecoFilialcep.AsInteger;
    end;

    qryClientespessoatipo.AsString      := qryOrcamentospessoatipo.AsString;
    if not qryOrcamentospessoanumero.IsNull then
      qryClientespessoanumero.AsString    := qryOrcamentospessoanumero.AsString;
    if not qryOrcamentosfoneddd.IsNull then
      qryClientesfoneddd.AsInteger        := qryOrcamentosfoneddd.AsInteger;
    if not qryOrcamentosfonenumero.IsNull then
      qryClientesfonenumero.AsInteger     := qryOrcamentosfonenumero.AsInteger;
    if not qryOrcamentosfoneramal.IsNull then
      qryClientesfoneramal.AsString       := qryOrcamentosfoneramal.AsString;
    if not qryOrcamentosfone2ddd.IsNull then
      qryClientesfone2ddd.AsInteger       := qryOrcamentosfone2ddd.AsInteger;
    if not qryOrcamentosfone2numero.IsNull then
      qryClientesfone2numero.AsInteger    := qryOrcamentosfone2numero.AsInteger;
    if not qryOrcamentosfone2ramal.IsNull then
      qryClientesfone2ramal.AsString      := qryOrcamentosfone2ramal.AsString;
    if not qryOrcamentosemail.IsNull then
      qryClientesemail.AsString           := qryOrcamentosemail.AsString;
    qryClientessexo.AsString            := 'M';
    qryClientescivil.AsString           := 'S';
    qryClientesfonetipo.AsString        := 'P';
    qryClientesrestipo.AsString         := 'P';
    qryClientesreftipo.AsString         := 'P';
    qryClientesempcomprovado.AsBoolean  := False;
    qryClientesnaturalestado.AsString   := EstadoFilialBase;
    qryClientescartaocredito.AsBoolean  := False;
    qryClientescartaoloja.AsBoolean     := False;
    qryClientescheque.AsBoolean         := False;
    qryClienteschequeespecial.AsBoolean := False;
    qryClientesautomovel.AsBoolean      := False;
    qryClientesenderecoalterado.AsDateTime := DataHoraLocal;
    qryClientesconsumidorfinal.asBoolean := parsistema.vendaconsumidorfinal;
    qryClientes.Post;
  except
    result := false;
  end;

  if Gravar then
    result := Perpetrar([qryClientes]);

end;

function TdtmOrcamentos.AtribuirClientenoOrcamento: boolean;
var
 vEstadoTabelaAnterior : TDataSetState;
begin
  result := true;

  try
    vEstadoTabelaAnterior := qryOrcamentos.state;

    if not (qryOrcamentos.state in [dsinsert, dsedit]) then
      qryOrcamentos.edit;

    if qryOrcamentoscliente.AsInteger = 0 then
    begin
      qryorcamentoscliente.asinteger := qryClientescodigo.AsInteger;
      qryorcamentostipocliente.asString := 'C';
    end;

    if not (vEstadoTabelaAnterior in [dsinsert, dsedit]) then
      qryOrcamentos.post;
  except
    result := false;
  end;

end;

