function TdtmOrcamentos.ValidarCreditoTroca: Boolean;
begin
  result := true;
  if creditotroca > 0 then
  begin
    AbrirDadosCreditoCliente;
    if creditotroca > SaldoCreditoAtual then
    begin
       MensagemErro(format(ctVALORCREDITOFORAINTERVALO,[creditotroca,SaldoCreditoAtual]));
       result := false;
    end
    else
    begin
      if creditotroca > TotalOrcamento then
      begin
        MensagemErro(format(ctVALORCREDITOMAIORPRODUTOS,[creditotroca,TotalOrcamento]));
        result := false;
      end;
    end;
  end;

end;

