procedure TdtmOrcamentos.ReCalcularPlanosPagamento(NaoValidarCreditoTroca: boolean);
type
  T_Planos = Array of Integer;
var
  dtmCalculoFin: TdtmCalculoFinanciamento;
  Parcelas: TResumosParcelas;
  ValorPrazo,
  TaxaJuros,
  Desconto,
  DesctoAnt: Real;
  A, Plano: Integer;
  Planos_Orc: T_Planos;
  vSaldoCobertoPorCredito : Boolean;


begin
  if NaoValidarCreditoTroca or ValidarCreditoTroca then
  begin

    vSaldoCobertoPorCredito := (TotalOrcamento - CreditoTroca) = 0;

    FReCalculandoPlano:= True;
    FillChar(Planos_Orc,SizeOf(Planos_Orc),0);
    SetLength(Planos_Orc,qryPlanosOrcamentos.RecordCount);
    qryPlanosOrcamentos.First;
    for A:= 0 to qryPlanosOrcamentos.RecordCount -1 do
    begin
      Planos_Orc[A]:= qryPlanosOrcamentosplano.AsInteger;
      qryPlanosOrcamentos.Next;
    end;

    if Length(Planos_Orc) > 0 then
    begin
      dtmCalculoFin:= TdtmCalculoFinanciamento.Create(Self);
      for A:= 0 to (Length(Planos_Orc)-1) do
      begin
        qryPlanosOrcamentos.Locate('plano',Planos_Orc[A],[]);

        DesctoAnt:= qryPlanosOrcamentosdesconto.AsCurrency;
        dtmCalculoFin.ValorMercadoria  := TotalProdutos+TotalServicos;
        dtmCalculoFin.ValorFrete       := qryOrcamentosfrete.AsCurrency;
        dtmCalculoFin.ValorSeguro      := qryOrcamentosseguro.AsCurrency;
        dtmCalculoFin.CreditoTroca     := qryOrcamentoscreditotroca.AsCurrency;
        dtmCalculoFin.Desconto         := qryPlanosOrcamentosdesconto.AsCurrency;

        dtmCalculoFin.DataCalculo      := DateToStr(qryOrcamentosemissao.AsDateTime);
        dtmCalculoFin.PermiteDesconto  := True;
        dtmCalculoFin.TipoCalculo:= tcNENHUM;
        dtmCalculoFin.ReFazConsulta(dtmCalculoFin.qryPlanosPagamento,[0],[Planos_Orc[A]]);
        dtmCalculoFin.CalcularValores;
        dtmCalculoFin.ResumosParcelas(Parcelas, ValorPrazo, TaxaJuros, Desconto, Plano);
    //    if Plano = 0 then
          Plano:= Planos_Orc[A];

        if (Desconto = 0) and (DesctoAnt > 0) then
             DefinirParcelas(Parcelas, ValorPrazo, TaxaJuros, DesctoAnt, Plano, qryPlanosOrcamentosselecionar.asboolean)
        else DefinirParcelas(Parcelas, ValorPrazo, TaxaJuros, Desconto, Plano, qryPlanosOrcamentosselecionar.asboolean);

      end;
      dtmCalculoFin := nil;
    end;

    FReCalculandoPlano:= False;
    AlterarPlanos := false;

    if vSaldoCobertoPorCredito and (creditotroca <> 0)then
       MensagemAviso(ctSALDOCOBERTOPORCREDITO)
  end;
end;


procedure TdtmOrcamentos.dsrPlanosOrcamentoDataChange(Sender: TObject; Field: TField);
var
  // desconto máximo para o plano selecionado
  pDescMaximo: double;
  // desconto efetivo
  pDescEfetivo: double;
begin
  inherited;
  dsrPlanosOrcamento.OnDataChange:= nil;
  if (Field = qryPlanosOrcamentosdesconto) then
  begin
    qryPlano.Close;
    qryPlano.Sql.Clear;
    qryPlano.Sql.Add('SELECT * FROM planos');
    qryPlano.Sql.Add('WHERE codigo = ' + qryPlanosOrcamentos.FieldByName('plano').AsString);
    qryPlano.Open;
    if not qryPlano.FieldByName('descontomaximo').IsNull then
      pDescMaximo := qryPlano.FieldByName('descontomaximo').AsFloat
    else
      pDescMaximo := 0.00;
    qryPlano.Close;
    // calculando o desconto efetivo
    if not qryPlanosOrcamentos.FieldByName('desconto').IsNull then
    begin
      pDescEfetivo := qryPlanosOrcamentos.FieldByName('desconto').AsFloat;
      if pDescEfetivo > 0.00 then
        pDescEfetivo := ((qryPlanosOrcamentos.FieldByName('desconto').AsFloat*100.00)/
                         (qryOrcamentos.FieldByName('totalprodutos').AsFloat+
                          qryOrcamentos.FieldByName('totalservicos').AsFloat));
    end
    else
    begin
      pDescEfetivo := 0.0;
    end;
    //if qryPlanosOrcamentosdesconto.AsCurrency > qryPlanosOrcamentosvalorprazo.AsCurrency then
    if pDescEfetivo > pDescMaximo then
    begin
      MensagemAviso(ctDESCONTOMAXIMOEXCEDIDO);
      qryPlanosOrcamentos.Cancel;
    end
    else
    begin
      CalcularValorTotalProdutos;
      CalcularValorTotalServicos;
//      CalcularValorVenda;
      AlterarPlanos:= True;
      ReCalcularPlanosPagamento;
    end;
  end;
  dsrPlanosOrcamento.OnDataChange:= dsrPlanosOrcamentoDataChange;
end;

function TdtmOrcamentos.GerarContrato: Boolean;
var
  NP,Cont,Plano: Integer;


  function CriarNovoContrato: Boolean;
  begin
    if qryContratos.Active then
      qryContratos.Close;
    qryContratos.Open;
    ReFazConsulta(qryAgentePlano,[0],[Plano]);
    qryPlanosOrcamentos.Locate('plano',Plano,[]);

    qryContratos.Insert;
    spcContratoProximo.Open;
    qryContratosnumero.AsString              := spcContratoProximonumero.AsString;
