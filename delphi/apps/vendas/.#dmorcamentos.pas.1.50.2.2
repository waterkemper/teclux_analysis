procedure TdtmOrcamentos.dsrOrcamentosDataChange(Sender: TObject; Field: TField);
begin
  inherited;
  if (//(Field = qryOrcamentosdesconto) or
      (Field = qryOrcamentosseguro)  or
      (Field = qryOrcamentosfrete)   or
      (Field = qryOrcamentoscreditotroca) or
      (Field = qryOrcamentoscliente)) then
  begin
    if (Field = qryOrcamentoscliente) then
    begin

      if qryOrcamentoscliente.IsNull then
        LimparTabela;

      if ParSistema.utilizarcreditotrocacontrato then
         AbrirDadosCreditoCliente;

      AtualizarPrecosProdutosOrcamentos;
    end
    else
    begin
      CalcularValorTotalProdutos;
      CalcularValorTotalServicos;
//      CalcularValorVenda;
      AlterarPlanos:= True;
      if field = qryOrcamentoscreditotroca then
      begin
        if ValidarCreditoTroca then
          ReCalcularPlanosPagamento(true)
        else
        begin
          dsrOrcamentos.OnDataChange := nil;
          qryOrcamentoscreditotroca.AsCurrency := CreditoTrocaAnt;
          dsrOrcamentos.OnDataChange := dsrOrcamentosDataChange;
        end;
      end
      else
        if qryorcamentos.recordcount <> 0 then
          ReCalcularPlanosPagamento;
    end;
  end;
end;

