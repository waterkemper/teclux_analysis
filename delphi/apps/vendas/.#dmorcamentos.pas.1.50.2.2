procedure TdtmOrcamentos.GerarCopiaOrcamento;
var
  Codigo  : Integer;
  Produtos: Currency;
begin
  if ValidarDadosOrcamento then
  begin
    if MensagemConfirmacao(ctORCAMENTO_GERAR_COPIA) = smbOk then begin
      ReFazConsulta(qryOrcamentosCopia,[0],[0]);
      ReFazConsulta(qryProdutosOrcamentosCopia,[0],[0]);
      RefazConsulta(qryServicosOrcamentoCopia,[0],[0]);

      spcOrcamentoProximo.Open;
      Codigo:= spcOrcamentoProximonumero.AsInteger;
      spcOrcamentoProximo.Close;

      qryOrcamentosCopia.Append;
      qryOrcamentosCopiacodigo.AsInteger         := Codigo;
      qryOrcamentosCopiaemissao.AsDateTime       := DataServidor;
      qryOrcamentosCopiavalidade.AsDateTime      := DataServidor + ParSistema.DiasValidadeOrcamento;
      if not qryOrcamentoscliente.IsNull then
        qryOrcamentosCopiacliente.AsInteger        := qryOrcamentoscliente.AsInteger;
      if not qryOrcamentostipocliente.IsNull then
        qryOrcamentosCopiatipocliente.AsString     := qryOrcamentostipocliente.AsString;
      qryOrcamentosCopiavendedor.AsInteger       := qryOrcamentosvendedor.AsInteger;
      qryOrcamentosCopiafilial.AsInteger         := FilialBase;
      qryOrcamentosCopiafrete.AsCurrency         := 0;
      qryOrcamentosCopiaseguro.AsCurrency        := 0;
      if not qryOrcamentosfilialmontagem.IsNull then
        qryOrcamentosCopiafilialmontagem.AsInteger := qryOrcamentosfilialmontagem.AsInteger;
      qryOrcamentosCopiasituacao.AsString        := 'A';
      qryOrcamentosCopianome.AsString            := qryOrcamentosnome.AsString;
      qryOrcamentosCopiapessoatipo.AsString      := qryOrcamentospessoatipo.AsString;
      if not qryOrcamentospessoanumero.IsNull then
        qryOrcamentosCopiapessoanumero.AsString    := qryOrcamentospessoanumero.AsString;

      if not qryOrcamentosrua.IsNull then
        qryOrcamentosCopiarua.AsString             := qryOrcamentosrua.AsString;

      if not qryOrcamentosnumero.IsNull then
        qryOrcamentosCopianumero.AsString          := qryOrcamentosnumero.AsString;
      if not qryOrcamentoscomplemento.IsNull then
        qryOrcamentosCopiacomplemento.AsString             := qryOrcamentoscomplemento.AsString;

      if not qryOrcamentosbairro.IsNull then
        qryOrcamentosCopiabairro.AsInteger         := qryOrcamentosbairro.AsInteger;
      if not qryOrcamentoscidade.IsNull then
        qryOrcamentosCopiacidade.AsInteger         := qryOrcamentoscidade.AsInteger;
      if not qryOrcamentosestado.IsNull then
        qryOrcamentosCopiaestado.AsString          := qryOrcamentosestado.AsString;
      if not qryOrcamentoscep.IsNull then
        qryOrcamentosCopiacep.AsInteger            := qryOrcamentoscep.AsInteger;
      qryOrcamentosCopiaobservacao.AsString        := '';
      if not qryOrcamentosemail.IsNull then
        qryOrcamentosCopiaemail.AsString           := qryOrcamentosemail.AsString;
      if not qryOrcamentosfoneddd.IsNull then
        qryOrcamentosCopiafoneddd.AsInteger        := qryOrcamentosfoneddd.AsInteger;
      if not qryOrcamentosfonenumero.IsNull then
        qryOrcamentosCopiafonenumero.AsInteger     := qryOrcamentosfonenumero.AsInteger;
      if not qryOrcamentosfoneramal.IsNull then
        qryOrcamentosCopiafoneramal.AsString       := qryOrcamentosfoneramal.AsString;
      if not qryOrcamentosfone2ddd.IsNull then
        qryOrcamentosCopiafone2ddd.AsInteger       := qryOrcamentosfone2ddd.AsInteger;
      if not qryOrcamentosfone2numero.IsNull then
        qryOrcamentosCopiafone2numero.AsInteger    := qryOrcamentosfone2numero.AsInteger;
      if not qryOrcamentosfone2ramal.IsNull then
        qryOrcamentosCopiafone2ramal.AsString      := qryOrcamentosfone2ramal.AsString;
      qryOrcamentosCopia.Post;

      Produtos:= 0;
      qryProdutosOrcamentos.First;
      while not qryProdutosOrcamentos.Eof do begin
        RefazConsultaProdutoEstoque(IntToStr(qryProdutosOrcamentosproduto.AsLargeInt),
                                             qryProdutosOrcamentosfilial.AsInteger);
        CopiarRegistros(qryProdutosOrcamentos, qryProdutosOrcamentosCopia, false);
        qryProdutosOrcamentosCopia.edit;
        qryProdutosOrcamentosCopiaorcamento.AsInteger          := Codigo;
        qryProdutosOrcamentosCopiavendido.AsCurrency            := 0;
        qryProdutosOrcamentosCopiaprecovenda.AsCurrency        := qryProdutoEstoquepreco.AsCurrency;
        qryProdutosOrcamentosCopiaprecotabela.AsCurrency       := qryProdutoEstoquepreco.AsCurrency;

        qryProdutosOrcamentosCopia.Post;
        Produtos:= Produtos + truncar((qryProdutosOrcamentosCopiaquantidade.AsCurrency * qryProdutosOrcamentosCopiaprecovenda.AsCurrency),2);
        qryProdutosOrcamentos.Next;
      end;

      qryServicosOrcamento.First;
      while not qryServicosOrcamento.Eof do
      begin
        qryServicosOrcamento.Append;
        qryServicosOrcamentoCopiaorcamento.AsInteger         :=Codigo;
        qryServicosOrcamentoCopiaservico.AsInteger           :=qryServicosOrcamentoservico.AsInteger;
        qryServicosOrcamentoCopiaquantidade.AsInteger        :=qryServicosOrcamentoquantidade.AsInteger;
        qryServicosOrcamentoCopiaaliquotaissqn.AsCurrency    :=qryServicosOrcamentoaliquotaissqn.AsCurrency;
        qryServicosOrcamentoCopiavalorservico.AsCurrency     :=qryServicosOrcamentovalorservico.AsCurrency;
        qryServicosOrcamentoCopiacomplementoservico.AsString :=qryServicosOrcamentocomplementoservico.AsString;
        qryServicosOrcamentoCopia.Post;

        qryServicosOrcamento.Next;
      end;

      Perpetrar([qryOrcamentosCopia, qryProdutosOrcamentosCopia, qryServicosOrcamento]);

      qryOrcamentosCopia.Close;
      qryProdutosOrcamentosCopia.Close;
      qryServicosOrcamentoCopia.Close;
      ReFazConsulta(qryOrcamentos,[0],[Codigo]);
    end;
  end;  
end;

