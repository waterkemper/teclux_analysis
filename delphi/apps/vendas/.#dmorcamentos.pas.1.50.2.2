    if {not qryCargosCliente.IsEmpty} {FCargoCliente} qryorcamentosempcargo.AsInteger <> 0 then
      AtribuirMarkupCargosConsultas;
  end
  else
  begin
    qryorcamentosempcargo.readonly := false;
    AtribuirMarkupClienteConsultas(True);
    qryOrcamentos.edit;
    if parsistema.CargoTabelaPrecoPadrao<>'' then
      qryOrcamentosempcargo.asinteger := strtoint(parsistema.CargoTabelaPrecoPadrao)
      {FCargoCliente:= strtoint(parsistema.CargoTabelaPrecoPadrao)}
