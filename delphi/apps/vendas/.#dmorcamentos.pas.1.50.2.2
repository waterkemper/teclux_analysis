function TdtmOrcamentos.IncluirServicosOrcamento(Editar: Boolean): Boolean;

  procedure Servicos(Editando: Boolean);
  var
    Campos  : String;
    Pos     : TBookmark;
  begin
    Campos:= '0,';
    qryServicosOrcamento.DisableControls;
    Pos:= qryServicosOrcamento.GetBookmark;
    try
      qryServicosOrcamento.First;
      while not qryServicosOrcamento.Eof do begin
        if (qryServicosOrcamentoservico.AsInteger > 0) then begin
          if not Editando then
            Campos := Campos + '' + qryServicosOrcamentoservico.AsString + ','
        end;
        qryServicosOrcamento.Next;
      end;
    finally
      qryServicosOrcamento.GotoBookmark(Pos);
      qryServicosOrcamento.FreeBookmark(Pos);
      qryServicosOrcamento.EnableControls;
      Delete(Campos,Length(Campos),1);
    end;
    qryProcuraServico.Sql[06]  := Format('and not (codigo in (%s))', [Campos]);
    qryConsultaServicos.Sql[03]:= Format('Where not (codigo in (%s))', [Campos]);
  end;

begin
  Servicos(Editar);
  if (not Editar or qryServicosOrcamento.IsEmpty) then begin
    qryServicosOrcamento.Append;
    qryServicosOrcamentoquantidade.AsInteger:= 1;
  end;
  Result:= True;
end;


