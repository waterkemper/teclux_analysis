procedure TdtmOrcamentos.AbreTabelasOrcamento(TipoConsulta: TtecOrcamentosTipoConsulta);
begin
  case TipoConsulta of
       vocORCAMENTO: begin
                       qryConsultaOrcamentos.Sql[09] := 'Where (o.codigo = 0)';
                       Abre(ctVendaTabelaConsultaVendas);
                     end;
        vocCLIENTES: begin
                       qryConsultaClientes.Sql[11]:= 'Where (v.codigo = 0)';
                       Abre(ctVendaTabelaConsultaClientes);
                     end;
        vocVENDEDOR,
        vocVENDEDORPRODUTO : Abre(ctVendaTabelaConsultaVendedores);
         vocPRODUTO: if ParSistema.UsarConsultaInterativa then begin
                       qryConsultaProdutos.MacroByName('Produtos').AsString := '';
                       Abre(ctVendaTabelaConsultaProdutos);
                     end
                     else begin
                       qryConsultaProdutos.MacroByName('Produtos').AsString := 'and (produto = 0)';
                       Abre(ctVendaTabelaConsultaProdutos);
                     end;
         vocSERVICO: Abre(ctVendaTabelaConsultaServicos);
  vocFILIALMONTAGEM: Abre(ctVendaTabelaConsultaFiliais);
          vocFILIAL: Abre(ctVendaTabelaConsultaFilialProduto);
  end;
end;

{
procedure TdtmOrcamentos.CalcularValorVenda;
begin
  qryOrcamentosvalorvista.AsCurrency := qryOrcamentostotalprodutos.AsCurrency +
                                        qryOrcamentosfrete.AsCurrency +
                                        qryOrcamentosseguro.AsCurrency -
                                      qryPlanosOrcamentosdesconto.AsCurrency;
end;
}

procedure TdtmOrcamentos.CalcularValorTotalProdutos;
var
  Pos: TBookmark;
{  QtdadeTotal,
  Preco,}
  TotProdutoAnt, Produto: Real;
  TotQtdeProdutos: Currency;
begin
  TotProdutoAnt:= qryOrcamentostotalprodutos.AsCurrency;
  Produto:= 0;    TotQtdeProdutos:= 0;
  if qryProdutosOrcamentos.Active then begin
    Pos := qryProdutosOrcamentos.GetBookmark;
    qryProdutosOrcamentos.DisableControls;
//    AlterarPlanos  := False;
    FExisteMontagem := False;
    FExisteEntrega  := False;
    FPermiteDesconto:= True;
    try
      qryProdutosOrcamentos.First;
      while Not qryProdutosOrcamentos.Eof do begin
{        Preco    := qryProdutosOrcamentosprecovenda.AsCurrency;
        QtdadeTotal := qryProdutosOrcamentosquantidade.AsCurrency;}
        TotQtdeProdutos := TotQtdeProdutos + qryProdutosOrcamentosquantidade.AsCurrency;
        Produto := Produto + Truncar((qryProdutosOrcamentosquantidade.AsCurrency *
                                      qryProdutosOrcamentosprecovenda.AsCurrency -
                                      qryProdutosOrcamentosvalordescontoitem.AsCurrency),2);

//        Inc(QtdeLinhas);
//        qryProdutosOrcamentos.Edit;
//        qryProdutosOrcamentosNumero.AsInteger := QtdeLinhas;
//        qryProdutosOrcamentos.Post;

        if qryProdutosOrcamentosmontagem.AsString = 'S' then
          FExisteMontagem := True;
        if qryProdutosOrcamentosentrega.AsString = 'S' then
          FExisteEntrega := True;
        if qryProdutosOrcamentospromocao.AsBoolean then
          FPermiteDesconto:= False;
        qryProdutosOrcamentos.Next
      end;
      AlterarPlanos:= AlterarPlanos or  (TotProdutoAnt <> Produto);
      if Not FExisteMontagem then
        qryOrcamentosfilialmontagem.Clear;
    finally
      qryOrcamentostotalprodutos.AsCurrency := Produto;
      qryOrcamentosTotalQtdeProdutos.AsCurrency := TotQtdeProdutos;
      qryProdutosOrcamentos.GotoBookmark(Pos);
      qryProdutosOrcamentos.FreeBookmark(Pos);
      qryProdutosOrcamentos.EnableControls;
    end
  end;
end;

constructor TdtmOrcamentos.Create(AOwner: TComponent);
begin
  inherited;
  FVendedorDefault:= 0;
  qryOrcamentos.Tag                   := ctTabelas;
  qryProdutosOrcamentos.Tag           := ctTabelas;
  qryPlanosOrcamentos.Tag             := ctTabelas;
  qryParcelasPlanosOrcamentos.Tag     := ctTabelas;
  qryConsultaOrcamentos.Tag           := ctVendaTabelaConsultaVendas;
  qryConsultaClientes.Tag             := ctVendaTabelaConsultaClientes;
  qryConsultaVendedores.Tag           := ctVendaTabelaConsultaVendedores;
  qryConsultaProdutos.Tag             := ctVendaTabelaConsultaProdutos;
  qryConsultaServicos.Tag             := ctVendaTabelaConsultaServicos;
  qryConsultaProdutos.ParamByName('ConsiderarMarkupCliente').AsBoolean := ParSistema.ConsiderarMarkupClientes;
  qryConsultaProdutos.ParamByName('PrecodaFilialBase').AsBoolean := ParSistema.UtilizarPrecoFilialBase;
  qryConsultaProdutos.ParamByName('FilialBase').AsInteger := FilialBase;
  qryConsultaProdutos.ParamByName('ConsiderarMarkupCargos').AsBoolean := ParSistema.PrecosporCargo;
  qryConsultaFilialProduto.Tag        := ctVendaTabelaConsultaFilialProduto;
  qryConsultaFiliais.Tag              := ctVendaTabelaConsultaFiliais;
  qryConsultaMotivos.Tag              := ctTabelasConsultaMotivos;
  qryProcuraCliente.Params[1].AsString := 'C';

  qryProcuraProduto.ParamByName('ConsiderarMarkupClientes').AsBoolean   := ParSistema.ConsiderarMarkupClientes;
  qryProcuraProduto.ParamByName('ConsiderarMarkupcargos').AsBoolean   := ParSistema.PrecosporCargo;

  qryProcuraProduto.ParamByname('FilialBase').AsInteger      := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
  qryProcuraProduto.ParamByname('FilialSaida').AsInteger     := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
  qryProcuraProduto.ParamByname('FilialPreco').AsInteger     := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);

  qryProdutoEstoque.ParamByName('FilialBase').Asinteger := FilialBase;
  qryProdutoEstoque.ParamByName('ConsiderarmarkupClientes').AsBoolean := ParSistema.ConsiderarMarkupClientes;
  qryProdutoEstoque.ParamByName('ConsiderarMarkupCargos').AsBoolean := ParSistema.PrecosporCargo;
  qryProdutoEstoque.ParamByName('FilialPreco').Asinteger := FilialBase;

  if ParSistema.FiliaisIndependentes then begin
    qryConsultaProdutos.MacroByName('FilialIndependente').AsString        := 'and (e.filial = ' + IntToStr(FilialBase) + ')';
    qryConsultaFilialProduto.macrobyname('SQLLimiteFiliais').asstring    := 'and (f.codigo = ' + IntToStr(ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual)) + ')';
    qryProcuraFilialProduto.macrobyname('SQLLimiteFiliais').asstring := 'and (f.codigo = ' + IntToStr(ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual)) + ' or f.codigo = :codigo)';
    qryConsultaProdutosfilial.Visible  := Not (ParSistema.FiliaisIndependentes);
    qryProdutosOrcamentosfilial.Visible := Not (ParSistema.FiliaisIndependentes);
  end
  else
  if (ParSistema.PesquisaSomenteEstoqueFilialBasevendas) then
  begin
