procedure TdtmOrcamentos.qryProcuraClienteAfterOpen(DataSet: TDataSet);
begin
  inherited;
  if (qryProcuraClientecodigo.AsInteger > 0) then
  begin
    AtribuirClienteOrcamento;
    if (qryProcuraClientemarkup.AsFloat > 0) and (ParSistema.ConsiderarMarkupClientes) then
      AtribuirMarkupClienteConsultas
    else
      qryProcuraProduto.ParamByName('markup').AsCurrency:= 0;
    FCargoCliente:= qryProcuraClientecargocliente.AsInteger;
    RefazConsultaPorNome(qryCargosClientes,['Cargo'],[FCargoCliente]);
    if not qryCargosClientes.IsEmpty then
      AtribuirMarkupCargosConsultas;
  end
  else
  begin
    AtribuirMarkupClienteConsultas(True);
    if parsistema.CargoTabelaPrecoPadrao<>'' then
      FCargoCliente:= strtoint(parsistema.CargoTabelaPrecoPadrao)
    else
      FCargoCliente:= qryProcuraClientecargocliente.AsInteger;

    RefazConsultaPorNome(qryCargosClientes,['Cargo'],[FCargoCliente]);
    if qryCargosClientes.IsEmpty then
      AtribuirMarkupCargosConsultas(True)
    else
      AtribuirMarkupCargosConsultas;

  end;
end;

