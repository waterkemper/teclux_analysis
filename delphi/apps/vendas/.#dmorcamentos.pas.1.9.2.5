procedure TdtmOrcamentos.RefazConsultaProdutoEstoque(produto: String; filial: integer);
const
  SQL = 'and produto = (%s)';
var
  Markup: Currency;
begin
//  FCargoCliente:= qryProcuraClientecargocliente.AsInteger;

  if ParSistema.ConsiderarMarkupClientes and not qryprocuraCliente.IsEmpty then
    Markup := qryProcuraClientemarkup.AsCurrency
  else
  if ParSistema.PrecosporCargo then
  begin
    if (produto <> '') and (produto <> '0') then
    begin
      qryCargosClientes.MacroByName('Produto').AsString:= Format(SQL,[produto]);
      qryCargosClientes.Close;
      qryCargosClientes.Open;
      RefazConsultaPorNome(qryCargosClientes,['Cargo'],[FCargoCliente]);
      Markup:= qryCargosClientesmarkup.AsInteger;
    end
    else
    Markup := 0;
  end
  else
    Markup := 0;

  qryProdutoEstoque.ParamByName('Cargo').AsInteger:= FCargoCliente;
  if ParSistema.UtilizarPrecoFilialBase then
    RefazConsultaPorNome(qryProdutoEstoque,['FilialBase','Markup','Codigo','Filial'],
                                           [FilialBase,Markup,produto,filial])
  else
    RefazConsultaPorNome(qryProdutoEstoque,['FilialBase','Markup','Codigo','Filial'],
                                           [filial,Markup,produto,filial]);
end;

