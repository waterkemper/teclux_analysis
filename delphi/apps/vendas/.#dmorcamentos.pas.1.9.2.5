function TdtmOrcamentos.GravarProdutoOrcamento: Boolean;
begin
  if qryProdutosOrcamentos.CheckRequiredFields then begin
    if (qryProdutosOrcamentosprecovenda.AsCurrency <= 0) then begin
      MensagemAviso(ctPRECOZERO);
      Result := False
    end
    else
    begin
      qryOrcamentos.Edit;
      if (qryProdutosOrcamentos.state in [dsinsert, dsedit]) then
        qryProdutosOrcamentos.Post;
      Result := True
    end
  end
  else Result:= False;
end;

function TdtmOrcamentos.GravarOrcamento: Boolean;
var Cont: Integer;
begin
  Result := False;
  if qryOrcamentos.CheckRequiredFields then
  begin
    if (qryProdutosOrcamentos.RecordCount + qryServicosOrcamento.RecordCount = 0) then
    begin
      MensagemAviso(ctORCAMENTOSEMPRODUTOSERVICO);
      Result := False
    end
    else if FExisteEntrega and Not EnderecoCompleto then
    begin
      MensagemAviso(ctENDERECOIMCOMPLETO);
      Result := False
    end
    else if FExisteMontagem and qryOrcamentosfilialmontagem.IsNull then
    begin
      MensagemAviso(ctFILIALMONTAGEMNULAVENDAVISTA);
      Result := False
    end
    else
    begin
      Result := True;
      if qryOrcamentos.State = dsInsert then
      begin
        spcOrcamentoProximo.Open;
        qryOrcamentoscodigo.AsInteger := spcOrcamentoProximonumero.AsInteger;
        spcOrcamentoProximo.Close;
      end;

      Cont:= 1;
      qryProdutosOrcamentos.First;
      while Not qryProdutosOrcamentos.Eof do begin
//      if qryProdutosOrcamentosnumero.IsNull then begin
          qryProdutosOrcamentos.Edit;
          qryProdutosOrcamentosorcamento.AsInteger:= qryOrcamentoscodigo.AsInteger;
          qryProdutosOrcamentosnumero.AsInteger   := Cont;
          qryProdutosOrcamentos.Post;
  //   end;
        Inc(Cont);
        qryProdutosOrcamentos.Next;
      end;

      qryServicosOrcamento.First;
      while not qryServicosOrcamento.Eof do
      begin
        if qryServicosOrcamentoorcamento.IsNull then
        begin
          qryServicosOrcamento.Edit;
          qryServicosOrcamentoorcamento.AsInteger:=qryOrcamentoscodigo.AsInteger;
          qryServicosOrcamento.Post;
        end;
        qryServicosOrcamento.Next;
      end;

      qryOrcamentossituacao.AsString := 'A';
      qryOrcamentos.Post;


      Perpetrar([qryOrcamentos, qryProdutosOrcamentos, qryServicosOrcamento, qryPlanosOrcamentos, qryParcelasPlanosOrcamentos]);
      if (qryPlanosOrcamentos.IsEmpty) and (ParSistema.PlanoOrcamentoPadrao>0) then
      begin
        dsrPlanosOrcamento.OnDataChange:= nil;
        qryPlanosOrcamentos.Append;
        qryPlanosOrcamentosorcamento.AsInteger := qryOrcamentoscodigo.AsInteger;
        qryPlanosOrcamentosplano.Asinteger := ParSistema.PlanoOrcamentoPadrao;
        qryPlanosOrcamentos.Post;
        ReCalcularPlanosPagamento;
        Perpetrar([qryPlanosOrcamentos]);
      end;

(*      if FAlterarPlanos and not qryPlanosOrcamentos.IsEmpty then begin
        MensagemAviso('Os valores do orçamento foram alterados.' + #13#10 +
                      'É necessário recalcular os planos.');

        if not qryPlanosOrcamentos.IsEmpty then begin
          qryPlanosOrcamentos.First;
          qryPlanosOrcamentos.AfterScroll:= nil;
          while not qryPlanosOrcamentos.Eof do begin
            if not qryParcelasPlanosOrcamentos.IsEmpty then begin
              qryParcelasPlanosOrcamentos.First;
              while not qryParcelasPlanosOrcamentos.Eof do
                qryParcelasPlanosOrcamentos.Delete;
            end;
            qryPlanosOrcamentos.Delete;
            Perpetrar([qryParcelasPlanosOrcamentos, qryPlanosOrcamentos]);
            ReFazConsulta(qryParcelasPlanosOrcamentos,[0,1],[qryPlanosOrcamentosorcamento.AsInteger,
                                                             qryPlanosOrcamentosplano.AsInteger]);
          end;
          qryPlanosOrcamentos.AfterScroll:= qryPlanosOrcamentosAfterScroll;
        end;
      end; *)
      FAlterarPlanos:= False;
    end;
  end;
end;

function TdtmOrcamentos.IncluirProdutosOrcamento: Boolean;
begin
  LerProdutosFiliaisIncluidos(True);
  qryProdutosOrcamentos.Append;
  if VendedorDefault > 0 then
    qryProdutosOrcamentosvendedor.AsInteger := VendedorDefault;
  Result := True
end;

function TdtmOrcamentos.IncluirOrcamento: Boolean;
begin
  ReFazConsulta(qryProdutosOrcamentos,[0],[0]);
  ReFazConsulta(qryPlanosOrcamentos,  [0],[0]);
  ReFazConsulta(qryParcelasPlanosOrcamentos,[0,1],[0,0]);
  TabelasSomenteLeitura(False);
  qryOrcamentos.Insert;
  qryOrcamentosvendedor.AsInteger         := VendedorDefault;
  if qryOrcamentosvendedor.AsInteger = 0 then
    qryOrcamentosvendedor.clear;

  qryOrcamentostipocliente.AsString       := 'C';
  qryOrcamentossituacao.AsString          := 'A';
  qryOrcamentosdescricaosituacao.AsString := 'ABERTO';
  qryOrcamentospessoatipo.AsString        := 'F';
  qryOrcamentosemissao.AsDateTime         := DataServidor;
  qryOrcamentosvalidade.AsDateTime        := DataServidor + ParSistema.DiasValidadeOrcamento;
  qryOrcamentosfilial.AsInteger           := FilialBase;
  qryOrcamentosfrete.AsCurrency           := 0;
  qryOrcamentosseguro.AsCurrency          := 0;
  FAlterarPlanos                          := False;
  FExisteMontagem                         := False;
  FExisteEntrega                          := False;
  FPermiteDesconto                        := True;
  Result:= True;
//  SomenteLeitura(False);
end;

procedure TdtmOrcamentos.LerProdutosFiliaisIncluidos(Incluindo: Boolean);
var
  Pos: TBookmark;
  a, Filial: Integer;
  Prod: Int64;
begin
  inherited;
  if Incluindo then begin
    qryConsultaFilialProduto.Params[0].AsInteger := 0;
    qryProcuraFilialProduto.Params[1].AsInteger  := 0;
  end else begin
    qryConsultaFilialProduto.Params[0].AsString := IntToStr(qryProdutosOrcamentosproduto.AsLargeInt);
    qryProcuraFilialProduto.Params[1].AsString  := IntToStr(qryProdutosOrcamentosproduto.AsLargeInt);
  end;
  Pos := qryProdutosOrcamentos.GetBookmark;
  qryProdutosOrcamentos.DisableControls;
  try
    a := 0;
    aProdFilial := nil;
    Prod   := qryProdutosOrcamentosproduto.AsLargeInt;
    Filial := qryProdutosOrcamentosfilial.AsInteger;
    qryProdutosOrcamentos.First;
    while Not qryProdutosOrcamentos.Eof do begin
      if Incluindo or ((Prod <> qryProdutosOrcamentosproduto.AsLargeInt) or
                       (Filial <> qryProdutosOrcamentosfilial.AsInteger))
      then begin
        SetLength(aProdFilial, a + 1);
        aProdFilial[a].Prod   := qryProdutosOrcamentosproduto.AsString;
        aProdFilial[a].Filial := qryProdutosOrcamentosfilial.AsString;
        Inc(a);
      end;
      qryProdutosOrcamentos.Next;
    end;
  finally
    qryProdutosOrcamentos.GotoBookmark(Pos);
    qryProdutosOrcamentos.FreeBookmark(Pos);
    qryProdutosOrcamentos.EnableControls;
  end;
  FiltrarProdutosEFiliaisOrcamento;
end;

