procedure TdtmOrcamentos.CalcularValorVenda;
begin
  qryOrcamentosvalorvista.AsCurrency := qryOrcamentostotalprodutos.AsCurrency +
                                        qryOrcamentosfrete.AsCurrency +
                                        qryOrcamentosseguro.AsCurrency -
                                      qryPlanosOrcamentosdesconto.AsCurrency;
end;
}

procedure TdtmOrcamentos.CalcularValorTotalProdutos;
var
  Pos: TBookmark;
{  QtdadeTotal,
  Preco,}
  TotProdutoAnt, Produto: Real;
  TotQtdeProdutos: Currency;
begin
  TotProdutoAnt:= qryOrcamentostotalprodutos.AsCurrency;
  Produto:= 0;    TotQtdeProdutos:= 0;
  if qryProdutosOrcamentos.Active then begin
    Pos := qryProdutosOrcamentos.GetBookmark;
    qryProdutosOrcamentos.DisableControls;
    FAlterarPlanos  := False;
    FExisteMontagem := False;
    FExisteEntrega  := False;
    FPermiteDesconto:= True;
    try
      qryProdutosOrcamentos.First;
      while Not qryProdutosOrcamentos.Eof do begin
{        Preco    := qryProdutosOrcamentosprecovenda.AsCurrency;
        QtdadeTotal := qryProdutosOrcamentosquantidade.AsCurrency;}
        TotQtdeProdutos := TotQtdeProdutos + qryProdutosOrcamentosquantidade.AsCurrency;
        Produto := Produto + Truncar((qryProdutosOrcamentosquantidade.AsCurrency *
                                      qryProdutosOrcamentosprecovenda.AsCurrency -
                                      qryProdutosOrcamentosvalordescontoitem.AsCurrency),2);

//        Inc(QtdeLinhas);
//        qryProdutosOrcamentos.Edit;
//        qryProdutosOrcamentosNumero.AsInteger := QtdeLinhas;
//        qryProdutosOrcamentos.Post;

        if qryProdutosOrcamentosmontagem.AsString = 'S' then
          FExisteMontagem := True;
        if qryProdutosOrcamentosentrega.AsString = 'S' then
          FExisteEntrega := True;
        if qryProdutosOrcamentospromocao.AsBoolean then
          FPermiteDesconto:= False;
        qryProdutosOrcamentos.Next
      end;
      FAlterarPlanos:= {(TotProdutoAnt > 0) and} (TotProdutoAnt <> Produto);
      if Not FExisteMontagem then
        qryOrcamentosfilialmontagem.Clear;
    finally
      qryOrcamentostotalprodutos.AsCurrency := Produto;
      qryOrcamentosTotalQtdeProdutos.AsCurrency := TotQtdeProdutos;
      qryProdutosOrcamentos.GotoBookmark(Pos);
      qryProdutosOrcamentos.FreeBookmark(Pos);
      qryProdutosOrcamentos.EnableControls;
    end
  end;
end;

constructor TdtmOrcamentos.Create(AOwner: TComponent);
begin
  inherited;
  FVendedorDefault:= 0;
  qryOrcamentos.Tag                   := ctTabelas;
  qryProdutosOrcamentos.Tag           := ctTabelas;
  qryPlanosOrcamentos.Tag             := ctTabelas;
  qryParcelasPlanosOrcamentos.Tag     := ctTabelas;
  qryConsultaOrcamentos.Tag           := ctVendaTabelaConsultaVendas;
  qryConsultaClientes.Tag             := ctVendaTabelaConsultaClientes;
  qryConsultaVendedores.Tag           := ctVendaTabelaConsultaVendedores;
  qryConsultaProdutos.Tag             := ctVendaTabelaConsultaProdutos;
  qryConsultaServicos.Tag             := ctVendaTabelaConsultaServicos;
  qryConsultaProdutos.ParamByName('ConsiderarMarkupCliente').AsBoolean := ParSistema.ConsiderarMarkupClientes;
  qryConsultaProdutos.ParamByName('PrecodaFilialBase').AsBoolean := ParSistema.UtilizarPrecoFilialBase;
  qryConsultaProdutos.ParamByName('FilialBase').AsInteger := FilialBase;
  qryConsultaProdutos.ParamByName('ConsiderarMarkupCargos').AsBoolean := ParSistema.PrecosporCargo;
  qryConsultaFilialProduto.Tag        := ctVendaTabelaConsultaFilialProduto;
  qryConsultaFiliais.Tag              := ctVendaTabelaConsultaFiliais;
  qryConsultaMotivos.Tag              := ctTabelasConsultaMotivos;
  qryProcuraCliente.Params[1].AsString := 'C';

  qryProcuraProduto.ParamByName('ConsiderarMarkupClientes').AsBoolean   := ParSistema.ConsiderarMarkupClientes;
  qryProcuraProduto.ParamByName('ConsiderarMarkupcargos').AsBoolean   := ParSistema.PrecosporCargo;

  qryProcuraProduto.ParamByname('FilialBase').AsInteger      := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
  qryProcuraProduto.ParamByname('FilialSaida').AsInteger     := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
  qryProcuraProduto.ParamByname('FilialPreco').AsInteger     := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
  if parsistema.PermitirProdutoAlfanumerico then
    qryProcuraProduto.MacroByName('SelecaoPorProdutoVisual').AsString := 'union all (select p2.codigo from produtos p2 where upper(to_ascii(p2.codigovisual,''latin1'')) = upper(to_ascii(:produtovisual,''latin1'')))'
  else
    qryProcuraProduto.MacroByName('SelecaoPorProdutoVisual').AsString := '';

  qryProdutoEstoque.ParamByName('FilialBase').Asinteger := FilialBase;
  qryProdutoEstoque.ParamByName('ConsiderarmarkupClientes').AsBoolean := ParSistema.ConsiderarMarkupClientes;
  qryProdutoEstoque.ParamByName('ConsiderarMarkupCargos').AsBoolean := ParSistema.PrecosporCargo;
  qryProdutoEstoque.ParamByName('FilialPreco').Asinteger := FilialBase;

  if ParSistema.FiliaisIndependentes then begin
    qryConsultaProdutos.MacroByName('FilialIndependente').AsString        := 'and (e.filial = ' + IntToStr(FilialBase) + ')';
    qryConsultaFilialProduto.macrobyname('SQLLimiteFiliais').asstring    := 'and (f.codigo = ' + IntToStr(ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual)) + ')';
    qryProcuraFilialProduto.macrobyname('SQLLimiteFiliais').asstring := 'and (f.codigo = ' + IntToStr(ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual)) + ' or f.codigo = :codigo)';
    qryConsultaProdutosfilial.Visible  := Not (ParSistema.FiliaisIndependentes);
    qryProdutosOrcamentosfilial.Visible := Not (ParSistema.FiliaisIndependentes);
  end
  else
  if (ParSistema.PesquisaSomenteEstoqueFilialBasevendas) then
  begin
    qryConsultaProdutos.MacroByName('FilialIndependente').AsString := 'and (e.filial in (' + ListaEstoquesFiliais + '))';
    qryConsultaFilialProduto.macrobyname('SQLLimiteFiliais').asstring    := 'and (f.codigo in (' + ListaEstoquesFiliais + '))';
    qryProcuraFilialProduto.macrobyname('SQLLimiteFiliais').asstring   := 'and (f.codigo in (' + ListaEstoquesFiliais + ') or f.codigo = :codigo)';
  end
  else
  begin
    qryConsultaProdutos.MacroByName('FilialIndependente').AsString := '';
    qryConsultaFilialProduto.macrobyname('SQLLimiteFiliais').asstring    := '';
    qryProcuraFilialProduto.macrobyname('SQLLimiteFiliais').asstring    := '';
  end;
  
  if ParSistema.SoVisualizarEstoqueDeposito then
   qryEstoque.Sql[4] := SQLEstoquesDeposito
  else
   qryEstoque.Sql[4] := '';
  FReCalculandoPlano:= False;

  qryProdutosOrcamentosquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosOrcamentosvendido.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosOrcamentosemestoque.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosOrcamentosreservado.DisplayFormat := ParSistema.MascaraQuantidadeGrade;

  qryOrcamentostotalqtdeprodutos.DisplayFormat  := ParSistema.MascaraQuantidadeGrade;

  qryProdutoEstoqueemestoque.DisplayFormat  := ParSistema.MascaraQuantidadeGrade;
  qryProdutoEstoquereservado.DisplayFormat  := ParSistema.MascaraQuantidadeGrade;
  qryProdutoEstoquefuturo.DisplayFormat  := ParSistema.MascaraQuantidadeGrade;

  qryEstoqueemestoque.DisplayFormat  := ParSistema.MascaraQuantidadeGrade;

  qryProdutosSimilaresemestoque.DisplayFormat  := ParSistema.MascaraQuantidadeGrade;
  qryProdutosSimilaresreservado.DisplayFormat  := ParSistema.MascaraQuantidadeGrade;

end;

procedure TdtmOrcamentos.dsrOrcamentosDataChange(Sender: TObject; Field: TField);
begin
  inherited;
  if (//(Field = qryOrcamentosdesconto) or
      (Field = qryOrcamentosseguro)  or
      (Field = qryOrcamentosfrete)   or
      (Field = qryOrcamentoscliente)) then
  begin
    if (Field = qryOrcamentoscliente) then
    begin
      if qryOrcamentoscliente.IsNull then
        LimparTabela;
      AtualizarPrecosProdutosOrcamentos;
    end
    else
    begin
      CalcularValorTotalProdutos;
      CalcularValorTotalServicos;
//      CalcularValorVenda;
      FAlterarPlanos:= True;
      ReCalcularPlanosPagamento;
    end;
  end;
end;

procedure TdtmOrcamentos.dsrProdutosOrcamentosDataChange(Sender: TObject; Field: TField);
begin
  inherited;
  if Field = qryProdutosOrcamentosfilial then
  begin
    if (qryProdutosOrcamentosfilial.AsInteger = 0) or ParSistema.FiliaisIndependentes then
    begin
      qryProcuraProduto.ParamByName('FilialSaida').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
      qryProcuraProduto.ParamByName('FilialPreco').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
    end
    else
    begin
      qryProcuraProduto.ParamByName('FilialSaida').AsInteger := qryProdutosOrcamentosfilial.AsInteger;
      if ParSistema.UtilizarPrecoFilialBase then
        qryProcuraProduto.ParamByName('FilialPreco').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual)
      else
        qryProcuraProduto.ParamByName('FilialPreco').AsInteger := qryProdutosOrcamentosfilial.AsInteger;
    end;
    RefazConsultaProdutoEstoque(IntToStr(qryProdutosOrcamentosproduto.AsLargeInt),
                                         qryProdutosOrcamentosfilial.AsInteger);

    if (qryProdutosOrcamentos.state in [dsinsert, dsedit]) then
    begin
      qryProdutosOrcamentosprecovenda.AsFloat  := qryProdutoEstoquepreco.AsFloat;
      qryProdutosOrcamentosprecotabela.AsFloat := qryProdutoEstoquepreco.AsFloat;
      qryProdutosOrcamentosemestoque.AsCurrency := qryProdutoEstoqueemestoque.AsCurrency;
      qryProdutosOrcamentosreservado.AsCurrency := qryProdutoEstoquereservado.AsCurrency;
    end;

  end
  else
  if (Field = qryProdutosOrcamentosproduto) or
     (Field = qryProdutosOrcamentosprodutovisual) or
     (Field = qryProdutosOrcamentoscodigobarras) then
  begin
    {
    RefazConsulta(qryEstoque,[0],[IntToStr(qryProdutosOrcamentosproduto.AsLargeInt)]);
    qryConsultaFilialProduto.Params[0].AsString := IntToStr(qryProdutosOrcamentosproduto.AsLargeInt);
    qryProcuraFilialProduto.Params[1].AsString  := IntToStr(qryProdutosOrcamentosproduto.AsLargeInt);
    if qryProcuraProdutomontagem.AsBoolean then
         qryProdutosOrcamentosmontagem.AsString := 'S'
    else qryProdutosOrcamentosmontagem.AsString := 'N';
    if UsuarioLogin.Vendedor then
      qryProdutosOrcamentosvendedor.AsInteger:= CodigoUsuario;
    qryProdutosOrcamentosdescricao.AsString  := qryProcuraProdutodescricao.AsString;
    qryProdutosOrcamentosfilial.AsInteger    := qryProcuraProdutofilial.AsInteger;
    RefazConsultaProdutoEstoque(IntToStr(qryProdutosOrcamentosproduto.AsLargeInt),
                                         qryProdutosOrcamentosfilial.AsInteger);

    qryProdutosOrcamentosprecovenda.AsFloat  := qryProdutoEstoquepreco.AsFloat;
    qryProdutosOrcamentosprecotabela.AsFloat := qryProdutoEstoquepreco.AsFloat;
    qryProdutosOrcamentosemestoque.AsCurrency := qryProdutoEstoqueemestoque.AsCurrency;
    qryProdutosOrcamentosreservado.AsCurrency := qryProdutoEstoquereservado.AsCurrency;
    qryProdutosOrcamentospromocao.AsBoolean  := qryProcuraProdutopromocao.AsBoolean;
    ReFazConsulta(qryProdutosSimilares,[0,1],[qryProdutosOrcamentosproduto.AsVariant, FilialBase]);
    }


    dsrProdutosOrcamentos.OnDataChange:= nil;
    //ATUALIZACAO PELO CODIGO DA FILIAL DO PRODUTO
    if (ParSistema.FiliaisIndependentes) then
    begin
      qryProcuraProduto.ParamByname('FilialSaida').AsInteger     := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
      qryProcuraProduto.ParamByname('FilialPreco').AsInteger     := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
    end
    else
    begin
      qryProcuraProduto.ParamByname('FilialSaida').AsInteger      := qryProcuraProdutofilial.Asinteger;
      if ParSistema.UtilizarPrecoFilialBase then
        qryProcuraProduto.ParamByname('FilialPreco').AsInteger    := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual)
      else
        qryProcuraProduto.ParamByname('FilialPreco').AsInteger := qryProcuraProdutofilial.AsInteger;
    end;

    RefazConsultapornome(qryEstoque,['produto'],[IntToStr(qryProcuraProdutoproduto.AsLargeInt)]);

    qryConsultaFilialProduto.Parambyname('produto').AsString := IntToStr(qryProcuraProdutoproduto.AsLargeInt);
    qryProcuraFilialProduto.Parambyname('produto').AsString  := IntToStr(qryProcuraProdutoproduto.AsLargeInt);


    if (qryProdutosOrcamentos.state in [dsinsert, dsedit]) then
    begin

      if (field = qryProdutosOrcamentosprodutovisual) and
         (qryProcuraProdutoproduto.AsLargeInt<>0) and
         (qryProdutosOrcamentosproduto.AsLargeInt  <> qryProcuraProdutoproduto.AsLargeInt) then
        qryProdutosOrcamentosproduto.AsLargeInt   := qryProcuraProdutoproduto.AsLargeInt
      else
      if (field = qryProdutosOrcamentosproduto) and
         (qryProcuraProdutoProduto.AsLargeInt<>0) and
         (qryProdutosOrcamentosprodutovisual.AsString <> qryProcuraProdutoProdutoVisual.AsString) then
        qryProdutosOrcamentosprodutovisual.AsString  := qryProcuraProdutoProdutoVisual.AsString;

      qryProdutosOrcamentoscodigobarras.AsString   := qryProcuraProdutocodigobarras.AsString;
      qryProdutosOrcamentosdescricao.AsString       := qryProcuraProdutodescricao.AsString;
      if qryProcuraProdutofilial.AsInteger <> 0 then
        qryProdutosOrcamentosfilial.AsInteger         := qryProcuraProdutofilial.AsInteger;
      qryProdutosOrcamentosvalorgrade1.AsString     := qryProcuraProdutovalorgrade1.AsString;
      qryProdutosOrcamentosvalorgrade2.AsString     := qryProcuraProdutovalorgrade2.AsString;
      qryProdutosOrcamentoslinha.AsString           := qryProcuraProdutolinha.AsString;
      qryProdutosOrcamentoscoluna.AsString          := qryProcuraProdutocoluna.AsString;
      qryProdutosOrcamentosunidade.AsString         := qryProcuraProdutounidade.AsString;
      qryProdutosOrcamentosbrinde.AsBoolean         := qryProcuraProdutobrinde.AsBoolean;

      if qryProcuraProdutomontagem.AsBoolean then
        qryProdutosOrcamentosmontagem.AsString := 'S'
      else
        qryProdutosOrcamentosmontagem.AsString := 'N';

      qryProdutosOrcamentosfilial.AsInteger         := qryProcuraProdutofilial.AsInteger;
      qryProdutosOrcamentosvendasemestoque.AsString := qryProcuraProdutovendasemestoque.AsString;
      qryProdutosOrcamentoscomposto.AsBoolean       := qryprocuraprodutocomposto.AsBoolean;

      RefazConsultaProdutoEstoque(IntToStr(qryProcuraProdutoproduto.AsLargeInt), qryProdutosOrcamentosfilial.AsInteger);

      qryProdutosOrcamentosprecovenda.AsFloat  := qryProdutoEstoquepreco.AsFloat;
      qryProdutosOrcamentosprecotabela.AsFloat := qryProdutoEstoquepreco.AsFloat;
      qryProdutosOrcamentosemestoque.AsCurrency := qryProdutoEstoqueemestoque.AsCurrency;
      qryProdutosOrcamentosreservado.AsCurrency := qryProdutoEstoquereservado.AsCurrency;
      qryProdutosOrcamentospromocao.AsBoolean  := qryProcuraProdutopromocao.AsBoolean;
    end;  
    ReFazConsultapornome(qryProdutosSimilares,['produto','filialbase'],[qryProdutosOrcamentosproduto.AsVariant, FilialBase]);
    dsrProdutosOrcamentos.OnDataChange:= dsrProdutosOrcamentosDataChange;

  end;
end;

function TdtmOrcamentos.EditarProdutosOrcamento: Boolean;
begin
  if qryProdutosOrcamentos.IsEmpty then begin
    IncluirProdutosOrcamento;
    Result:= True;
  end
  else begin
    RefazConsulta(qryEstoque,[0],[IntToStr(qryProdutosOrcamentosproduto.AsLargeInt)]);
    ReFazConsulta(qryProdutosSimilares,[0,1],[qryProdutosOrcamentosproduto.AsVariant, FilialBase]);
    
    if ParSistema.FiliaisIndependentes then
    begin
      qryProcuraProduto.ParamByName('Filialsaida').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
      qryProcuraProduto.ParamByName('Filialpreco').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
    end
    else
    begin
      qryProcuraProduto.ParamByName('Filialsaida').AsInteger := qryProdutosOrcamentosfilial.AsInteger;
      if ParSistema.UtilizarPrecoFilialBase then
        qryProcuraProduto.ParamByName('FilialPreco').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual)
      else
        qryProcuraProduto.ParamByName('Filialpreco').AsInteger := qryProdutosOrcamentosfilial.AsInteger;
    end;
    if qryProdutosOrcamentos.RecordCount = 0 then begin
      LerProdutosFiliaisIncluidos(True);
      qryProdutosOrcamentos.Append;
    end else begin
      LerProdutosFiliaisIncluidos(False);
      qryProdutosOrcamentos.Edit;
      qryProdutosOrcamentos.Cancel;
    end;
    RefazConsultaProdutoEstoque(IntToStr(qryProdutosOrcamentosproduto.AsLargeInt),
                                           qryProdutosOrcamentosfilial.AsInteger);
    Result := True
  end;
end;

function TdtmOrcamentos.EnderecoCompleto: Boolean;
begin
  Result := Not (qryOrcamentosrua.IsNull or
                 qryOrcamentosnumero.IsNull or
                 qryOrcamentoscomplemento.IsNull or
                 qryOrcamentosbairro.IsNull or
                 qryOrcamentoscidade.IsNull or
                 qryOrcamentosestado.IsNull or
                 qryOrcamentoscep.IsNull)
end;

function TdtmOrcamentos.ExcluirProdutoOrcamento: Boolean;
begin
  Result := True;
  if qryProdutosOrcamentos.RecordCount > 0 then
  begin
    if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o PRODUTO DO ORÇAMENTO'])) = smbOk then
    begin
      if qryProdutosOrcamentos.State = dsInsert then
           qryProdutosOrcamentos.Cancel
      else
      begin
        qryProdutosOrcamentos.Delete;
        RefazConsulta(qryEstoque,[0],[IntToStr(qryProdutosOrcamentosproduto.AsLargeInt)]);
        LerProdutosFiliaisIncluidos(False);
        qryProdutosOrcamentos.Edit;
        qryProdutosOrcamentos.Cancel;
        ReCalcularPlanosPagamento;
      end;
      qryOrcamentos.Edit;
    end;
  end;
end;

function TdtmOrcamentos.ExcluirOrcamento(Cancelar:Boolean): Boolean;
begin
  Result := True;
  if Cancelar and qryConsultaMotivoscodigo.IsNull then
    MensagemAviso(ctORCAMENTO_MOTIVO)
  else begin
    TabelasSomenteLeitura(False);
    if not qryOrcamentos.IsEmpty then begin
      if Cancelar then begin
        qryOrcamentos.Edit;
        qryOrcamentoscancelamento.AsDateTime:= DataServidor;
        qryOrcamentosmotivo.AsInteger       := qryConsultaMotivoscodigo.AsInteger;
        qryOrcamentossituacao.AsString      := 'C';
        qryOrcamentos.Post;
        Perpetrar([qryOrcamentos]);
        ReFazConsulta(qryOrcamentos,[0],[qryOrcamentoscodigo.AsInteger]);
      end
      else begin
        qryProdutosOrcamentos.First;
        while not qryProdutosOrcamentos.Eof do
          qryProdutosOrcamentos.Delete;

        if not qryParcelasPlanosOrcamentos.IsEmpty then begin
          qryParcelasPlanosOrcamentos.First;
          while not qryParcelasPlanosOrcamentos.Eof do
            qryParcelasPlanosOrcamentos.Delete;
        end;

        if not qryPlanosOrcamentos.IsEmpty then begin
          qryPlanosOrcamentos.AfterScroll:= nil;
          qryPlanosOrcamentos.First;
          while not qryPlanosOrcamentos.Eof do
            qryPlanosOrcamentos.Delete;
          qryPlanosOrcamentos.AfterScroll:= qryPlanosOrcamentosAfterScroll;
        end;

        qryOrcamentos.Delete;
        Perpetrar([qryParcelasPlanosOrcamentos, qryPlanosOrcamentos, qryProdutosOrcamentos, qryOrcamentos]);
        Result := True;
      end;
    end;
  end;
end;

function TdtmOrcamentos.ExisteCliente(NomeCampo: String; value: Variant): Boolean;
begin
  if NomeCampo = 'nomecidade' then
    NomeCampo:= 'c.nome'
  else if NomeCampo = 'tipocliente' then
    NomeCampo:= 'v.tipo'
  else
    NomeCampo:= 'v.' + NomeCampo;
  qryConsultaClientes.Sql[11]:= 'Where (UPPER(TO_ASCII(' + NomeCampo + ',''LATIN1'')) like UPPER(TO_ASCII(''' + value + '%'',''LATIN1''))) ';
  qryConsultaClientes.Open;             
  Result := qryConsultaClientes.RecordCount > 0
end;

