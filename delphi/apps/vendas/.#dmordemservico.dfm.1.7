        '       cast(case when (select c.composto from caracteristicas c ' +
        'where c.codigo = p.caracteristica) then '#39'B'#39' else '#39'A'#39' end as varc' +
        'har) as ordem,'
      '       false as selecionado'
      
        'From  produtosequipamentos pe join produtos p on pe.produto = p.' +
        'codigo'
      '                 join estoques e on p.codigo = e.produto'
      'Where pe.equipamento = :equipamento'
      '%PRODUTOS'
      'Order by ordem, pe.numero')
