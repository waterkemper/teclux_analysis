      '                             (e1.produto = p.codigo)'
      '           )      ) and'
      '           (estoques_preco(p.codigo, :FilialPreco) > 0)'
      
        '           AND (0 < (SELECT emestoque FROM estoques where produt' +
        'o=:codigo and filial=:filialbase) OR NOT :inserindo)'
      '/* Preenchido em runtime */'
      '/* Lista de Casamento       */'
      
        'order by UPPER(TO_ASCII(p.descricao,'#39'LATIN1'#39')), p.valorgrade1, p' +
