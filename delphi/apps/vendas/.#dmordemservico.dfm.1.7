    Sql.Strings = (
      ';select * from'
      '('
      
        ' select produto, filial, emestoque, reservado, descricao, valorg' +
        'rade1,  valorgrade2, referencia, caracteristica,  preco, unidade' +
        ', brinde,'
      
        '          (select count(*) from similares where similares.caract' +
        'eristica = estoquepreco1.caracteristica) as similares,'
      
        '          case when coalesce(estoquepreco1.valorproduto,0)=0 the' +
        'n'
      '               (SELECT valor'
      '                FROM colunasprecos'
      
        '                WHERE (colunasprecos.caracteristica = estoquepre' +
        'co1.caracteristica) AND'
      
        '                              (colunasprecos.preco = estoqueprec' +
        'o1.preco) AND'
      
        '                             (colunasprecos.coluna = estoqueprec' +
        'o1.preconormal))'
      '          else  coalesce(estoquepreco1.valorproduto,0)'
      '          end as valorproduto'
      ' from'
      '('
      ' select estoque.*,'
      '       case when estoque.precopromocao is not null then'
      '        (SELECT valor'
      '         FROM colunasprecos'
      
        '         WHERE (colunasprecos.caracteristica = estoque.caracteri' +
        'stica) AND'
      '               (colunasprecos.preco = estoque.preco) AND'
      
        '               (colunasprecos.coluna = estoque.precopromocao) AN' +
        'D'
      '               (colunasprecos.validade >= now()))'
      '       end as valorproduto'
      ' from '
      ' ('
      '  select e.produto,'
      '            e.filial,'
      '            e.emestoque,'
      '            e.reservado,'
      '            p.descricao, '
      '            p.valorgrade1, '
      '            p.valorgrade2,'
      '            p.referencia,'
      '            p.caracteristica,'
      '            p.preco,'
      '            c.unidade,'
      '            c.brinde,'
      '            case when :PrecodaFilialBase then'
      
        '              (select f.preconormal from filiais f where f.codig' +
        'o = :FilialBase)'
      
        '            else (select f.preconormal from filiais f where  f.c' +
        'odigo = e.filial)'
      '            end as preconormal,'
      '            case when :PrecodaFilialBase then'
      
        '              (select f.precopromocao from filiais f where f.cod' +
        'igo = :FilialBase)'
      
        '            else (select f.precopromocao from filiais f where  f' +
        '.codigo = e.filial)'
      '            end as precopromocao'
      
        '  from (estoques e  join (produtos p join caracteristicas c on p' +
        '.caracteristica = c.codigo)'
      
        '                                                 on e.produto = ' +
        'p.codigo)'
      '  where  ((p.inativo is null ) or  (p.inativo>current_date))'
      '  /* editado em runtime filial independente */'
      ''
      '  /* editado em runtime ja cadastrados */'
      ''
      ' ) as estoque'
      ') as estoquepreco1'
      ') as estoquepreco2'
      
        'where (valorproduto > 0) and (emestoque > 0) and (filial = :Fili' +
        'alBase)'
      '  /* editado em runtime */'
      
        'order by UPPER(TO_ASCII(descricao,'#39'LATIN1'#39')), valorgrade1, valor' +
        'grade2')
    RequestLive = False
