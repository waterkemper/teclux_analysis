      '        from cidades d'
      '        where (d.estado = c.naturalestado) and'
      '              (d.codigo = c.naturalcidade)'
      '       ) as nomecidadenaturalidade,'
      '       (select nome'
      '        from cidades d'
      '        where (d.estado = c.estado) and'
      '              (d.codigo = c.cidade)'
      '       ) as nomecidade,'
      '       (select nome'
      '        from bairros b'
      '        where (b.estado = c.estado) and'
      '              (b.cidade = c.cidade) and'
      '              (b.codigo = c.bairro)'
      '       ) as nomebairro,'
      '       (select nome'
