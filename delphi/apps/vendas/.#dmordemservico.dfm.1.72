        Name = 'ListaProdutosJaCadastrados'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SQLLimiteFiliais'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select f.nome,'
      '       f.codigo'
      'from filiais f'
      '/* PRODUTOS QUE EST'#195'O INCLUIDOS NOS ESTOQUES DE FILIAIS */'
      'where f.codigo in (select e.filial'
      '                   from estoques e'
      '                   where (e.produto = :produto)'
      '%ListaProdutosJaCadastrados'
      '                            )'
      
        '/* LIMITA'#199#213'ES DE SELE'#199#195'O DAS FILIAIS -> INDEPENDENTES OU SOMENTE' +
        ' ESTOQUE FILIAL BASE VENDAS */'#9'  '
      '%SQLLimiteFiliais'
      ''
      'order by UPPER(TO_ASCII(f.nome,'#39'LATIN1'#39'))')
    RequestLive = False
    Left = 385
    Top = 115
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'produto'
        ParamType = ptUnknown
      end>
