  object qryProdutosContratoCopia: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterInsert = qryProdutosContratoCopiaAfterInsert
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select pc.contrato,'
      '       pc.produto,'
      '       p.codigovisual as produtovisual,'
      '       pc.produtodigitado,'
      '       pc.filial,'
      '       pc.numero,'
      
        '       (select descricao from produtos where codigo = pc.produto' +
        ') as descricao,'
      
        '       (select valorgrade1 from produtos where codigo = pc.produ' +
        'to) as valorgrade1,'
      
        '       (select valorgrade2 from produtos where codigo = pc.produ' +
        'to) as valorgrade2,'
      
        '       (select cast(descricao||'#39' '#39'||coalesce(valorgrade1,'#39#39')||'#39' ' +
        #39'||coalesce(valorgrade2,'#39#39') as varchar) from produtos where codi' +
        'go = pc.produto) as descricaolc,'
      '       pc.quantidade,'
      '       pc.precovenda,'
      '       pc.precotabela,'
      '       pc.descricaoprecovenda,'
      '       pc.montagem,'
      '       pc.entrega,'
      '       pc.produtolista,'
      '       pc.aliquotaipi,'
      '       pc.reserva,'
      '       pc.brinde,'
      '       pc.vendedor,'
      '       pc.classificacaofiscal,'
      '       pc.ipi,'
      '       pc.fatorsubstituicao,'
      '       pc.percreducaomva,'
      '       pc.precosubsttributaria,'
      '       pc.acrescimo,'
      '       pc.desconto,'
      '       pc.frete,'
      '       pc.seguro,'
      
        '       case when :MarkupClientes and ((coalesce(:Markup,0)) > 0)' +
        ' and (e.valorultimacompra > 0) then'
      '                  estoques_preco(pc.produto, pc.filial, :Markup)'
      
        '            when :MarkupCargos and ((coalesce((Select pcg.markup' +
        ' from produtoscargos pcg'
      
        '                                                        where pc' +
        'g.cargo = :Cargo'
      
        '                                                        and pcg.' +
        'produto = pc.produto),0)) > 0) and (e.valorultimacompra > 0) the' +
        'n'
      
        '                  estoques_preco(pc.produto, pc.filial,(Select p' +
        'cg.markup from produtoscargos pcg'
      
        '                                                                ' +
        '       where pcg.cargo = :Cargo'
      
        '                                                                ' +
        '       and pcg.produto = pc.produto))'
      
        '            else estoques_preco(pc.produto, pc.filial) end as pr' +
        'ecoatual,'
      '       cast (0 as numeric(15,2)) as precosugerido,'
      '       pc.dias,'
      '       pc.xped,'
      '       pc.nItemped,'
      '       false as selecionar'
      'from produtoscontratos pc, estoques e, produtos p'
      'where pc.contrato = :Contrato'
      '      and e.produto = pc.produto'
      '      and e.filial = pc.filial'
      '      and pc.produto = p.codigo'
      'order by pc.numero')
    RequestLive = True
    Left = 432
    Top = 562
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'MarkupClientes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'markup'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'MarkupCargos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Cargo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'contrato'
        ParamType = ptUnknown
      end>
