  object qryServicosOrdemServico: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforePost = qryServicosOrdemServicoBeforePost
    AfterDelete = qryServicosOrdemServicoAfterDelete
    OnCalcFields = qryServicosOrdemServicoCalcFields
    OnNewRecord = qryServicosOrdemServicoNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select   sc.contrato,'
      '         sc.servico,'
      '         s.descricao as descricaoservico,'
      '         s.comissao as comissaoservico,'
      '         s.tipocomissao as tipocomissaoservico,'
      '         sc.quantidade,'
      '         sc.cancelado,'
      '         sc.aliquotaissqn,'
      '         sc.valorservico,'
      '         sc.complementoservico,'
      '         sc.equipamento,'
      '         e.descricao as descricaoequipamento,'
      '         e.referencia,'
      '         e.marca,'
      '         e.modelo,'
      '         e.opcionais,'
      '         e.ano,'
      '         m.descricao as descricaomarca,'
      '         sc.estado,'
      '         sc.cidade,'
      '         (select c.nome'
      '          from cidades c'
      '          where c.estado = sc.estado'
      '           and c.codigo = sc.cidade) as nomecidade,'
      '         sc.reterissqn,'
      '         sc.valorissqn,'
      '         True as ValorISSQNDigitado,'
      '         s.piscst,'
      '         s.pisaliquota,'
      '         s.cofinscst,'
      '         s.cofinsaliquota,'
      '         S.codigolcp116,'
      '         s.cnae,'
      '         s.cstissqn,'
      '         sc.produto,'
      '         sc.filialproduto,'
      '        (select ae.codigoatividade'
      '         from atividadeseconomicas ae'
      '         where ae.codigo = s.cnae) as codigoatividade,'
      ''
      ''
      '         (select saem.codigoatividademunicipio'
      '          from servicosatividadeseconomicasmunicipios saem'
      '          where saem.servico = s.codigo'
      '            and saem.atividade = s.cnae'
      
        '            and saem.codigoatividademunicipio in (select ae_m.co' +
        'digoatividademunicipio'
      
        '                                                  from atividade' +
        'seconomicas_municipios ae_m'
      
        '                                                  where ae_m.cid' +
        'adeibge = (select c.codigoibge'
      
        '                                                                ' +
        '           from cidades c'
      
        '                                                                ' +
        '           where (c.estado,c.codigo) in (select f.estado, f.cida' +
        'de'
      
        '                                                                ' +
        '                                        from filiais f'
      
        '                                                                ' +
        '                                        where f.codigo = ct.fili' +
        'alvenda)))'
      '         ) as codigoatividademunicipio'
      ''
      ''
      ''
      'From     servicoscontratos sc'
      
        '         left join (equipamentos e left join marcas m on (e.marc' +
        'a = m.codigo))'
      
        '                        on  (sc.equipamento = e.codigo), contrat' +
        'os ct, servicos s'
      ''
      'Where  (sc.contrato = ct.numero) and'
      '       (sc.servico = s.codigo) and'
      '       (sc.contrato =:ordemservico)'
      '')
    RequestLive = True
    Left = 59
    Top = 149
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'ordemservico'
        ParamType = ptUnknown
      end>
