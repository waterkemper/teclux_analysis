  object qryProdutoEstoque: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      
        'select  (case when :ConsiderarMarkupClientes then estoques_preco' +
        '(:Codigo, :FilialPreco, :markup)'
      
        '              when :ConsiderarMarkupCargos then estoques_preco(:' +
        'Codigo, :FilialBase, (Select pc.markup from produtoscargos pc'
      
        '                                                                ' +
        '                                         where pc.cargo =:Cargo'
      
        '                                                                ' +
        '                                         and pc.produto = :Codig' +
        'o))'
      
        '              else estoques_preco(:Codigo, :FilialBase, :Cliente' +
        ', :TipoCliente)end) as preco,'
      
        '        estoques_preconormal(e.produto, :FilialPreco) as precono' +
        'rmal,'
      '        e.emestoque,'
      '        e.reservado,'
      '        e.futuro,'
      ''
      
        '        case when quantidadetotaldoestoque(e.produto,e.filial)=0' +
        '  then'
      '          cast (0.00 as numeric)'
      '        else'
      
        '          e.financeiro/quantidadetotaldoestoque(e.produto,e.fili' +
        'al) end as precocusto,'
      ''
      '  (select pr.descricao'
      #9' from precos pr'
      #9' where pr.caracteristica = (select p.caracteristica'
      '                              from produtos p'
      '                              where p.codigo = :codigo)'
      '     and pr.codigo = (select p.preco'
      '          from produtos p'
      '          where p.codigo = :codigo)) as descricaopreco'
      ''
      'from estoques e'
      'where e.produto = :codigo'
      '  and e.filial = :filial'
      ''
      ''
      ''
      '')
    RequestLive = False
    Left = 359
    Top = 325
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'ConsiderarMarkupClientes'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'codigo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FilialPreco'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'markup'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ConsiderarMarkupCargos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FilialBase'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Cargo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Cliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'TipoCliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'filial'
        ParamType = ptUnknown
        Value = '0'
      end>
