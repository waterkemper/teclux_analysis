  object qryProcuraProdutoOS: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryProcuraProdutoOSAfterOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select p.descricao, '
      
        '         (select g.descricao from grades g where g.codigo = c.gr' +
        'ade1) as linha,'
      
        '         (select g.descricao from grades g where g.codigo = c.gr' +
        'ade2) as coluna,'
      '          p.valorgrade1,'
      '          p.valorgrade2,'
      '          p.codigo as produto,'
      '          p.codigovisual as produtovisual,'
      '          e.filial,'
      
        '          (select c.montagem from caracteristicas c where p.cara' +
        'cteristica = c.codigo) as montagem,'
      
        '          (select c.unidade from caracteristicas c where c.codig' +
        'o = p.caracteristica) as unidade,'
      
        '          (select c.brinde from caracteristicas c where c.codigo' +
        ' = p.caracteristica) as brinde,'
      '          (select ei.valor from estadosicms ei'
      '                                  where (ei.estado =:estado) and'
      
        '                                             (ei.icms = (select ' +
        'c2.icms'
      
        '                                                              Fr' +
        'om caracteristicas c2 where c2.codigo = p.caracteristica))) as a' +
        'liquotaicms,'
      
        '          (select c.icms frOm caracteristicas c where c.codigo =' +
        ' p.caracteristica) as icms,'
      '          (select i.aliquota froM ipi i'
      '            where i.codigo = (select c.ipi'
      '                                        FRom caracteristicas c'
      
        '                                        where c.codigo = p.carac' +
        'teristica)) as aliquotaipi,'
      
        '          (select c.vendanegativa FrOm caracteristicas c where c' +
        '.codigo = p.caracteristica) as vendasemestoque,'
      
        '          (select estoques_produtoempromocao(p.codigo,:filialbas' +
        'e)) as promocao'
      ''
      ''
      ''
      'from caracteristicas c, produtos p, estoques e'
      'where (p.codigo in'
      
        '                  ((select p2.codigo from produtos p2 where cast' +
        '(p2.codigo as varchar) = :produtovisual)'
      ''
      '                    union all'
      ''
      '                   (select pcb.produto'
      '                    from produtoscodigobarras pcb'
      '                    where pcb.codigobarras = :produtovisual)'
      ''
      '                    union all'
      ''
      '                    (select p2.codigo'
      '                     from produtos p2'
      
        '                     where upper(to_ascii(p2.codigovisual,'#39'latin' +
        '1'#39')) = upper(to_ascii(:produtovisual,'#39'latin1'#39')))'
      ''
      '                   ))'
      ''
      ''
      ''
      '  and p.inativo is null'
      '  and c.codigo = p.caracteristica'
      '  and p.codigo = e.produto'
      '  and e.filial =:filialsaida'
      '  and'
      '           (0 < (select count(*)'
      '                   fRom estoques e1'
      '                   where (e1.filial = e.filial) and'
      '                             (e1.produto = p.codigo)))'
      ''
      '  and (estoques_preco(p.codigo, :FilialPreco) > 0)'
      ''
      
        '  AND (0 < (SELECT emestoque FROM estoques where produto=p.codig' +
        'o and filial=:filialbase) OR NOT :inserindo)'
      ''
      
        'order by UPPER(TO_ASCII(p.descricao,'#39'LATIN1'#39')), p.valorgrade1, p' +
        '.valorgrade2')
    RequestLive = False
    Left = 226
    Top = 459
    ParamData = <
      item
        DataType = ftString
        Name = 'estado'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filialbase'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'produtovisual'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filialsaida'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FilialPreco'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'inserindo'
        ParamType = ptUnknown
      end>
    object qryProcuraProdutoOSdescricao: TStringField
      DisplayWidth = 50
      FieldName = 'descricao'
      Size = 100
    end
