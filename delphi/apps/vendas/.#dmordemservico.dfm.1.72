    Macros = <>
    Sql.Strings = (
      '/*'
      'select p.contrato,'
      '       p.numero,'
      '       p.parcelaorigem,'
      '       p.datavencto,'
      '       p.valorvencto,'
      '       p.formapagamento,'
      '       cast(case when p.tipopagto = '#39'E'#39' then '#39'Estornado'#39
      '            when tipopagto = '#39'J'#39' then '#39'Perdas judiciais'#39
      '            when tipopagto = '#39'D'#39' then '#39'a Devolver'#39
      '            when tipopagto = '#39'C'#39' then '#39'Devolvido'#39
      '            when tipopagto = '#39'P'#39' then '#39'Pagto estornado'#39
      '            when tipopagto = '#39'X'#39' then '#39'Estorno devolvido'#39
      
        '            else case when p.datapagto is not null then '#39'Quitada' +
        #39' else '#39#39' end'
      '       end as varchar) as tipopagto,'
      '       p.datapagto,'
      '       p.valorpagto,'
      '       cast(False as Boolean) as Selecionado'
      'from parcelas p'
      'where (p.contrato = :ordemservico)'
      'order by p.contrato, datavencto'
      '*/'
      ''
      ''
      ''
      'select p.contrato,'
      '       p.numero,'
      '       p.parcelaorigem,'
      '       p.datavencto,'
      '       p.valorvencto,'
      '       p.formapagamento,'
      '       p.tipopagto,'
      '       cast(case when p.tipopagto = '#39'E'#39' then '#39'Estornado'#39
      '            when tipopagto = '#39'J'#39' then '#39'Perdas judiciais'#39
      '            when tipopagto = '#39'D'#39' then '#39'a Devolver'#39
      '            when tipopagto = '#39'C'#39' then '#39'Devolvido'#39
      '            when tipopagto = '#39'P'#39' then '#39'Pagto estornado'#39
      '            when tipopagto = '#39'X'#39' then '#39'Estorno devolvido'#39
      
        '            else case when p.datapagto is not null then '#39'Quitada' +
        #39' else '#39#39' end'
      '       end as varchar) as Nometipopagto,'
      '       p.datapagto,'
      '       p.valorpagto,'
      '       p.filialpagto,'
      '       p.tiporecebimento,'
      '       tr.descricao,'
      '       cast(False as Boolean) as Selecionado,'
      '       cast(False as Boolean) as substituicao,'
      '       p.transacao,'
      '       p.parcelaoriginal,'
      '       p.pagamentoextracaixa,'
      '       p.contaboleto,'
      '       p.evento'
      
        'from parcelas p left join tiposrecebimentos tr on (p.tiporecebim' +
        'ento=tr.codigo)'
      'where (p.contrato = :ordemservico)'
      'order by p.contrato, datavencto')
    RequestLive = True
