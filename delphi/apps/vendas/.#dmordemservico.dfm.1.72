  object qrySomaCustos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT '
      
        ' ((SELECT COALESCE(cast(SUM((financeiro/quantidadetotaldoestoque' +
        '(pc.produto,pc.filial))*pc.quantidade) as NUMERIC(9,2)),0)'
      '   FROM produtoscontratos pc,estoques e'
      '   WHERE e.produto=pc.produto'
      '   AND  e.filial=pc.filial'
      '   AND pc.contrato=:ordemservico)'
      '  +'
      
        '  (SELECT COALESCE(cast(SUM(valorservico*quantidade) as NUMERIC(' +
        '9,2)),0)'
      '   FROM servicoscontratos sc'
      '   WHERE sc.contrato=:ordemservico)) as custo')
    RequestLive = True
    Left = 677
    Top = 156
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'ordemservico'
        ParamType = ptUnknown
      end>
    object qrySomaCustoscusto: TFloatField
      FieldName = 'custo'
    end
  end
