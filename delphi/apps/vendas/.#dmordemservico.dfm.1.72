    Macros = <
      item
        DataType = ftUnknown
        Name = 'TipoCliente'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select nome,'
      '         formatar_cpf_cnpj(c.pessoanumero) as pessoanumero,'
      '         c.numero,'
      '         c.data,'
      '         c.pedidocliente,'
      '         cast (case when c.situacao = '#39'R'#39' then '#39'A - EM ABERTO'#39
      
        '                    when c.situacao = '#39'P'#39' then '#39'P - NOTA PARCIAL' +
        #39
      '                    when c.situacao = '#39'N'#39' then '#39'N - NOTA FISCAL'#39
      '                    when c.situacao = '#39'C'#39' then '#39'C - CANCELADA'#39
      '                  end as varchar) as situacao'
      'from contratos c'
      'where (cliente = :Cliente)'
      '  %TipoCliente'
      '  and coalesce(os,false)'
      'order by UPPER(TO_ASCII(nome,'#39'LATIN1'#39'))'
      '')
    RequestLive = False
    Left = 72
    Top = 66
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'Cliente'
        ParamType = ptUnknown
      end>
