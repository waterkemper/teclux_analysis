  object qryProcuraReservaProduto: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select r.numero,'
      '       pr.quantidade,'
      '         cast((to_char(r.data, '#39' dd/mm/yyyy - '#39') ||'
      '         '#39' Qtdade '#39' || trim(to_char(pr.quantidade, '#39'999'#39')) ||'
      '         '#39' - '#39' || r.cliente || '#39' - '#39' ||'
      
        '         (select p.descricao||'#39' '#39'||coalesce(p.valorgrade1,'#39#39')||'#39 +
        ' '#39'||coalesce(p.valorgrade2,'#39#39') from produtos p where p.codigo = ' +
        'pr.produto)) as varchar)'
      '       as descricao'
      'from reservas r, produtosreservas pr'
      'where (r.usuario = :usuario) and'
      '      (r.validade > current_timestamp) and'
      '      (r.numero = pr.reserva) and'
      '      (r.cancelado is null) and'
      '      ((pr.quantidade > pr.baixado)'
      '/* Preencher em runtime */       '
      '      ) and'
      '      (r.numero = :numero) and'
      '      (pr.produto = :produto) and'
      '      (pr.filial = :filial)')
    RequestLive = False
    Left = 672
    Top = 312
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'usuario'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'numero'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'produto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
