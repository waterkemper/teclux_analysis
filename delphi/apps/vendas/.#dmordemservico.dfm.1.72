    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select  n.filial, '
      '        n.serie,'
      '        n.numero,'
      '        df.datasaida,'
      '        df.situacao,'
      '        cast('
      '        case when df.situacao = '#39'C'#39' then '#39'CANCELADA'#39
      '             when df.situacao = '#39'N'#39' then '#39'NORMAL'#39
      '             when df.situacao = '#39'D'#39' then '#39'DENEGADA'#39
      '        end as varchar(9)) as descricaosituacao'
      'From    notas n, dadosfiscais df'
      'Where (n.dadofiscal = df.numero) '
      '     and (df.contrato =:contrato)')
    RequestLive = False
    Left = 144
    Top = 600
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'contrato'
        ParamType = ptUnknown
      end>
