    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select cf.codigo,'
      '           cf.contato,'
      '           cf.fonenumero,'
      '           cf.foneddd,'
      '           cf.foneramal,'
      '           cf.email,'
      '           cf.codigovfornecedores,'
      '           cf.tipovfornecedores,'
      '           cf.cargo,'
      '           cf.observacoes, '
      '           c.descricao as descricaocargo'
      
        'from contatosvfornecedores cf left join cargos c  on cf.cargo = ' +
        'c.codigo'
      'where (cf.codigovfornecedores = :cliente)'
      '  and (cf.tipovfornecedores = '#39'C'#39')'
      'order by cf.contato')
