  object qryProdutosEquipamentosOS: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterScroll = qryProdutosEquipamentosOSAfterScroll
    OnFilterRecord = qryProdutosEquipamentosOSFilterRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'PRODUTOS'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      
        'Select (select e.descricao from equipamentos e where e.codigo = ' +
        'pe.equipamento) as descricao_equipamentos,'
      '       pe.produto,'
      '       p.codigovisual as produtovisual,'
      '       pe.quantidade,'
      '       p.descricao,'
      '       (select g.descricao'
      '        from grades g, caracteristicas c'
      
        '        where g.codigo = c.grade1 and c.codigo = p.caracteristic' +
        'a) as linha,'
      '       (select g.descricao'
      '        from grades g, caracteristicas c'
      
        '        where g.codigo = c.grade2 and c.codigo = p.caracteristic' +
        'a) as coluna,'
      '       p.valorgrade1,'
      '       p.valorgrade2,'
      '       e.emestoque,'
      
        '       (select c.composto from caracteristicas c where c.codigo ' +
        '= p.caracteristica) as composto,'
      
        '       cast(case when (select c.composto from caracteristicas c ' +
        'where c.codigo = p.caracteristica) then '#39'B'#39' else '#39'A'#39' end as varc' +
        'har) as ordem,'
      '       false as selecionado'
      
        'From  produtosequipamentos pe join produtos p on pe.produto = p.' +
        'codigo'
      '                 join estoques e on p.codigo = e.produto'
      'Where pe.equipamento = :equipamento'
      '%PRODUTOS'
      'Order by ordem, pe.numero')
    RequestLive = True
    Left = 800
    Top = 64
    ParamData = <
      item
        DataType = ftString
        Name = 'equipamento'
        ParamType = ptUnknown
        Value = '0'
      end>
