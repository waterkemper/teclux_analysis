  end
  object qryProcuraProduto: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryProcuraProdutoAfterOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'SelecaoPorReferencia'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltrarProdutosEFiliaisContratos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SelecionarProdutosListaCasamento'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select p.descricao,'
      
        '         (select g.descricao from grades g where g.codigo = c.gr' +
        'ade1) as linha,'
      
        '         (select g.descricao from grades g where g.codigo = c.gr' +
        'ade2) as coluna,'
      '          p.valorgrade1,'
      '          p.valorgrade2,'
      '          p.codigo as produto,'
      '          p.codigovisual as produtovisual,'
      '          e.filial,'
      '          c.montagem,'
      '          c.unidade,'
      '          c.brinde,'
      '          c.vendanegativa as vendasemestoque,'
      
        '          (select estoques_produtoempromocao(p.codigo,:filialbas' +
        'e)) as promocao,'
      
        '          coalesce((select ipi.aliquota from ipi where ipi.codig' +
        'o = c.ipi),0.00) as aliquotaipi,'
      
        '          (select ipi.classificacaofiscal from ipi where ipi.cod' +
        'igo = c.ipi) as classificacaofiscal,'
      
        '/*          (select coalesce(ipi.fatorsubstituicao,1) from ipi w' +
        'here ipi.codigo = c.ipi) as fatorsubstituicao,*/'
      
        '          (select t.valor from tributosicms t where t.codigo = c' +
        '.incidencia) as incidencia,'
      '          c.csosn,'
      
        '          Selecionar_Aliquotaicms(:estadofilialbase, :Estadocfo,' +
        ' :tipoPessoa, p.codigo) as aliquotaicms,'
      '          (select valor'
      '           from estadosicms'
      '           where estadosicms.estado = :estadocfo'
      '             and estadosicms.icms   = c.icms) as AliquotaICMSST,'
      '          c.icms,'
      '          c.icmsmodalidade,'
      '          c.icmsmodsubst,'
      '          c.piscst,'
      '          c.aliquotapis,'
      '          c.cofinscst,'
      '          c.aliquotacofins,'
      '          c.ipi,'
      '          c.ipicst,'
      
        '          (select ipi.extipi from ipi where ipi.codigo = c.ipi) ' +
        'as extipi,'
      
        '          (select ipi.genero from ipi where ipi.codigo = c.ipi) ' +
        'as genero,'
      '          c.origem,'
      '          c.composto,'
      '          c.discriminarcomposto,'
      '          c.discriminarpreco,'
      ''
      
        '         cast(case when trim(COALESCE(c.observacoesvenda,'#39#39'))<>'#39 +
        #39'  then'
      
        '                         '#39'Obs. Produto: '#39'||c.codigovisual||chr(1' +
        '3)||chr(10)||c.observacoesvenda||chr(13)||chr(10) '
      '                   else '#39#39' '
      '              end||chr(13)||chr(10)||'
      '              '
      
        '              case when trim(COALESCE(g.observacoesvenda,'#39#39'))<>'#39 +
        #39' then'
      
        '                         '#39'Obs. Grupo: '#39'||g.codigo||chr(13)||chr(' +
        '10)||g.observacoesvenda||chr(13)||chr(10)'
      '                   else '#39#39' '
      '              end||chr(13)||chr(10)||'
      '              '
      
        '              case when trim(COALESCE(cl.observacoesvenda,'#39#39'))<>' +
        #39#39' then'
      
        '                         '#39'Obs. Classe: '#39'||cl.codigo||chr(13)||ch' +
        'r(10)||cl.observacoesvenda||chr(13)||chr(10)'
      '                   else '#39#39' '
      '              end||chr(13)||chr(10)||            '
      '         '
      
        '              case when trim(COALESCE(m.observacoesvenda,'#39#39'))<>'#39 +
        #39' then'
      
        '                         '#39'Obs. Marca: '#39'||cast(m.codigo as varcha' +
        'r)||chr(13)||chr(10)||m.observacoesvenda||chr(13)||chr(10)'
      '                   else '#39#39
      '              end||chr(13)||chr(10)||'
      ''
      
        '              case when trim(COALESCE(pro.observacoesvenda,'#39#39'))<' +
        '>'#39#39' then'
      
        '                         '#39'Obs. Promo'#231#227'o: '#39'||cast(pro.codigo as v' +
        'archar)||'#39' - '#39'||pro.descricao||chr(13)||chr(10)||pro.observacoes' +
        'venda||chr(13)||chr(10)'
      '                   else '#39#39
      '              end as varchar(8160)) as observacoesvenda'
      ''
      
        'from caracteristicas c, (produtos p left join promocoes pro on p' +
        '.promocao = pro.codigo), estoques e, grupos g, classes cl, marca' +
        's m'
      'where ( p.codigo  in'
      '                  ((select pcb.produto'
      '                    from produtoscodigobarras pcb'
      '                    where pcb.codigobarras = :produtovisual)'
      ''
      '                    union all'
      ''
      '                    (select p2.codigo'
      '                     from produtos p2'
      
        '                     where upper(pg_catalog.to_ascii(p2.codigovi' +
        'sual,'#39'latin1'#39')) = upper(pg_catalog.to_ascii(:produtovisual,'#39'lati' +
        'n1'#39')))'
      ''
      '                    %SelecaoPorReferencia'
      '                   ))'
      ''
      '   and (p.inativo is null)'
      '   and (c.codigo = p.caracteristica)'
      '   and (p.codigo = e.produto)'
      '   and (c.grupo = g.codigo)'
      '   and (c.classe = cl.codigo)'
      '   and (c.marca = m.codigo)'
      '   and (e.filial =:filialsaida)'
      
        '   and (case when :ConsiderarMarkupClientes then(estoques_preco(' +
        'p.codigo, :FilialPreco, (coalesce(:markup,0.00))) > 0)'
      
        '             when :ConsiderarMarkupcargos then (estoques_preco(p' +
        '.codigo, :FilialBase, (coalesce(:MarkupCargos,0.00))) >0)'
      
        '             else (estoques_preco(p.codigo, :FilialBase) > 0) en' +
        'd)'
      '   and coalesce(c.disponivel_sistema,false)'
      ''
      '%FiltrarProdutosEFiliaisContratos'
      '%SelecionarProdutosListaCasamento'
      
        'order by UPPER(pg_catalog.to_ascii(p.descricao,'#39'LATIN1'#39')), p.val' +
        'orgrade1, p.valorgrade2'
      ''
      '')
    RequestLive = False
    Left = 207
    Top = 66
    ParamData = <
      item
        DataType = ftInteger
        Name = 'filialbase'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'estadofilialbase'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'Estadocfo'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'tipoPessoa'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'produtovisual'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'filialsaida'
        ParamType = ptUnknown
      end
      item
        DataType = ftBoolean
        Name = 'ConsiderarMarkupClientes'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'FilialPreco'
        ParamType = ptUnknown
      end
      item
        DataType = ftFloat
        Name = 'markup'
        ParamType = ptUnknown
      end
      item
        DataType = ftBoolean
        Name = 'ConsiderarMarkupcargos'
        ParamType = ptUnknown
      end
      item
        DataType = ftFloat
        Name = 'MarkupCargos'
        ParamType = ptUnknown
      end>
