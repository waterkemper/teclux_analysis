  object qryConsultaProdutos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryConsultaProdutosBeforeOpen
    AfterOpen = qryConsultaProdutosAfterOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'ProdutosFiliaisContratos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FilialIndependente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListadeCasamento'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Produto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Produto2'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';select * from'
      '('
      
        ' select produto, produtovisual, filial, emestoque, reservado, de' +
        'scricao, valorgrade1,  valorgrade2, caracteristica,  preco, unid' +
        'ade, brinde, codigoBarras,'
      
        '          (select count(*) from similares where similares.caract' +
        'eristica = estoquepreco1.caracteristica) as similares, peso,'
      '          case when ((PrecoParaCliente  = '#39'True'#39') and'
      '                    (coalesce((select cp.precocliente'
      '                     from clientesprodutos cp'
      '                     where cp.cliente = :cliente'
      '                       and cp.tipocliente = :tipocliente'
      
        '                       and cp.produto = estoquepreco1.produto),0' +
        ')<>0)) then'
      '               (select cp.precocliente'
      '                from clientesprodutos cp'
      '                where cp.cliente = :cliente'
      '                  and cp.tipocliente = :tipocliente'
      '                  and cp.produto = estoquepreco1.produto)'
      '          else'
      
        '            case when coalesce(estoquepreco1.valorproduto,0)=0 t' +
        'hen'
      '                 (SELECT valor'
      '                  FROM colunasprecos'
      
        '                  WHERE (colunasprecos.caracteristica = estoquep' +
        'reco1.caracteristica) AND'
      
        '                                (colunasprecos.preco = estoquepr' +
        'eco1.preco) AND'
      
        '                               (colunasprecos.coluna = estoquepr' +
        'eco1.preconormal))'
      '            else  coalesce(estoquepreco1.valorproduto,0)'
      '            end'
      '          end  as valorproduto'
      ' from'
      '('
      ' select estoque.*,'
      
        '       case when :ConsiderarMarkupCliente and ((coalesce(:markup' +
        ',0)) > 0) and (estoque.valorultimacompra > 0) then'
      
        '                  estoques_preco(estoque.produto, :FilialBase, :' +
        'Markup)'
      
        '            when :ConsiderarMarkupCargos and ((coalesce((Select ' +
        'pc.markup from produtoscargos pc'
      
        '                                                                ' +
        '       where pc.cargo =:Cargo'
      
        '                                                                ' +
        '       and pc.produto = estoque.produto),0)) > 0) and (estoque.v' +
        'alorultimacompra > 0) then'
      
        '                  estoques_preco(estoque.produto, :FilialBase,(S' +
        'elect pc.markup from produtoscargos pc'
      
        '                                                                ' +
        '       where pc.cargo =:Cargo'
      
        '                                                                ' +
        '       and pc.produto = estoque.produto))'
      '            when estoque.precopromocao is not null then'
      '                (SELECT valor'
      '                 FROM colunasprecos'
      
        '                 WHERE (colunasprecos.caracteristica = estoque.c' +
        'aracteristica) AND'
      '                       (colunasprecos.preco = estoque.preco) AND'
      
        '                       (colunasprecos.coluna = estoque.precoprom' +
        'ocao) AND'
      '                       (colunasprecos.validade >= now())'
      '                )'
      
        '            else estoques_preco(estoque.produto, :FilialBase) en' +
        'd as valorproduto'
      ' from'
      ' ('
      '  select e.produto,'
      '         p.codigovisual as produtovisual,'
      '            e.filial,'
      '            e.emestoque,'
      '            e.reservado,'
      '            p.descricao,'
      '            p.valorgrade1,'
      '            p.valorgrade2,'
      '            p.caracteristica,'
      '            p.preco,'
      '            codigobarras(p.codigo) as codigobarras,'
      '            c.unidade,'
      '            c.brinde,'
      '            case when :PrecodaFilialBase then'
      
        '              (select f.preconormal from filiais f where f.codig' +
        'o = :FilialBase)'
      
        '            else (select f.preconormal from filiais f where  f.c' +
        'odigo = e.filial)'
      '            end as preconormal,'
      '            case when :PrecodaFilialBase then'
      
        '            (select f.precopromocao from filiais f where f.codig' +
        'o = :FilialBase)'
      
        '            else (select f.precopromocao from filiais f where  f' +
        '.codigo = e.filial)'
      '            end as precopromocao,'
      '            e.valorultimacompra,'
      '            c.peso'
      
        '  from (estoques e  join (produtos p join caracteristicas c on p' +
        '.caracteristica = c.codigo)'
      
        '                                                 on e.produto = ' +
        'p.codigo)'
      '  where e.produto = p.codigo'
      '    and p.caracteristica = c.codigo'
      '    and ((p.inativo is null ) or'
      '         (p.inativo>current_date))'
      '    and coalesce(c.disponivel_sistema,false)     '
      '  %ProdutosFiliaisContratos'
      '  %FilialIndependente'
      '  %ListadeCasamento'
      '  %Produto'
      ' ) as estoque'
      ') as estoquepreco1,'
      
        '  (select parametros_valor('#39'Pre'#231'o para clientes'#39') as PrecoParaCl' +
        'iente) as PrecoParaCliente'
      ') as estoquepreco2'
      'where (valorproduto > 0)'
      '%Produto2'
      'order by Maiusculo(descricao), valorgrade1, valorgrade2')
    RequestLive = False
    Left = 235
    Top = 96
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'tipocliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ConsiderarMarkupCliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'markup'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FilialBase'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ConsiderarMarkupCargos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Cargo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'PrecodaFilialBase'
        ParamType = ptUnknown
      end>
