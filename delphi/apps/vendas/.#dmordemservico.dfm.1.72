  object qryProcuraCliente: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryProcuraClienteBeforeOpen
    AfterOpen = qryProcuraClienteAfterOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select cast(coalesce(razao,nome) as varchar(60)) as nome,'
      '       codigo,'
      '       tipo,'
      
        '       case when tipo = '#39'C'#39' then (select c.naoexibirfichafinance' +
        'ira from clientes c where c.codigo = :codigo)'
      '            else false'
      '       end as naoexibirfichafinanceira,'
      '       case when conceito is not null then (select c.restricoes'
      #9#9#9#9#9'    from conceitos c'
      #9#9#9#9'            where c.codigo = vfornecedores.conceito)'
      #9'    else true'
      '       end as restricoesconceito,'
      '       debito,'
      '       credito,'
      
        '       (select c.empcargo from clientes c where c.codigo = :codi' +
        'go) as cargocliente, '
      '       markup,'
      '       (select b.nome'
      '       from bairros b'
      '       where b.estado = vfornecedores.estado'
      '         and b.cidade = vfornecedores.cidade'
      '         and b.codigo = vfornecedores.bairro) as NomeBairro,'
      '       (select c.nome'
      '       from cidades c'
      '       where c.estado = vfornecedores.estado'
      '         and c.codigo = vfornecedores.cidade) as NomeCidade,'
      '      (select c.CodigoIBGE'
      '       from cidades c'
      '       where c.estado = vfornecedores.estado'
      '         and c.codigo = vfornecedores.cidade) as CidadeIBGE,'
      '      vfornecedores.nosimples    '
      'From   vfornecedores'
      'Where (codigo = :codigo) and'
      '      (tipo     = :tipocliente)'
      'Order By UPPER(TO_ASCII(nome,'#39'LATIN1'#39'))')
    RequestLive = False
    Left = 356
    Top = 248
    ParamData = <
      item
        DataType = ftString
        Name = 'codigo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'tipocliente'
        ParamType = ptUnknown
      end>
