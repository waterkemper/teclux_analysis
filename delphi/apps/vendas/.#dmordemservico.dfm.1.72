  object qryProdutosEntregar: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '(Select pc.produto,'
      '       pc.filial,'
      
        '       sum(pc.quantidade-coalesce(pc.cancelado,0))-sum(coalesce(' +
        'pd.quantidade,0)) as qtdade'
      'from produtoscontratos pc left join'
      '                                    (select d.contrato,'
      '                                            pd1.produto,'
      '                                            pd1.filial,'
      
        '                                            sum(pd1.quantidade) ' +
        'as quantidade'
      
        '                                     from dadosfiscais d, produt' +
        'osdadosfiscais pd1'
      
        '                                     where (d.contrato =:contrat' +
        'o) and (d.numero = pd1.dadofiscal) and (d.situacao='#39'N'#39')'
      
        '                                     group by d.contrato,pd1.pro' +
        'duto,pd1.filial) pd'
      '                          using (contrato,produto,filial)'
      'where (pc.contrato = :contrato)'
      'group by pc.produto, pc.filial'
      
        'having sum(pc.quantidade-coalesce(pc.cancelado,0)) > sum(coalesc' +
        'e(pd.quantidade,0)))'
      '')
    RequestLive = False
    Left = 537
    Top = 156
    ParamData = <
      item
        DataType = ftString
        Name = 'contrato'
        ParamType = ptUnknown
        Value = '0'
      end>
    object qryProdutosEntregarproduto: TLargeintField
      FieldName = 'produto'
      DisplayFormat = '0'
    end
    object qryProdutosEntregarfilial: TIntegerField
      FieldName = 'filial'
      DisplayFormat = '0'
    end
    object qryProdutosEntregarqtdade: TFloatField
      FieldName = 'qtdade'
      DisplayFormat = '0'
    end
  end
