  object qryConsultaProdutosOS: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryConsultaProdutosOSAfterOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'FilialIndependente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ProdutosJaCadastrados'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SQL'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';select * from'
      '('
      
        ' select produto, produtovisual, filial, emestoque, reservado, de' +
        'scricao, valorgrade1,  valorgrade2, caracteristica,  preco, unid' +
        'ade, brinde, codigoBarras,referencia,'
      
        '          (select count(*) from similares where similares.caract' +
        'eristica = estoquepreco1.caracteristica) as similares,'
      
        '          case when coalesce(estoquepreco1.valorproduto,0)=0 the' +
        'n'
      '               (SELECT valor'
      '                FROM colunasprecos'
      
        '                WHERE (colunasprecos.caracteristica = estoquepre' +
        'co1.caracteristica) AND'
      
        '                              (colunasprecos.preco = estoqueprec' +
        'o1.preco) AND'
      
        '                             (colunasprecos.coluna = estoqueprec' +
        'o1.preconormal))'
      '          else  coalesce(estoquepreco1.valorproduto,0)'
      '          end as valorproduto'
      ' from'
      '('
      ' select estoque.*,'
      '       case when estoque.precopromocao is not null then'
      '        (SELECT valor'
      '         FROM colunasprecos'
      
        '         WHERE (colunasprecos.caracteristica = estoque.caracteri' +
        'stica) AND'
      '               (colunasprecos.preco = estoque.preco) AND'
      
        '               (colunasprecos.coluna = estoque.precopromocao) AN' +
        'D'
      '               (colunasprecos.validade >= now()))'
      '       end as valorproduto'
      ' from'
      ' ('
      '  select e.produto,  p.codigovisual as produtovisual,'
      '            e.filial,'
      '            e.emestoque,'
      '            e.reservado,'
      '            p.descricao,'
      '            p.valorgrade1,'
      '            p.valorgrade2,'
      '            p.caracteristica,'
      
        '            p.preco, codigobarras(p.codigo) as codigoBarras,p.re' +
        'ferencia,'
      '            c.unidade,'
      '            c.brinde,'
      '            case when :PrecodaFilialBase then'
      
        '              (select f.preconormal from filiais f where f.codig' +
        'o = :FilialBase)'
      
        '            else (select f.preconormal from filiais f where  f.c' +
        'odigo = e.filial)'
      '            end as preconormal,'
      '            case when :PrecodaFilialBase then'
      
        '              (select f.precopromocao from filiais f where f.cod' +
        'igo = :FilialBase)'
      
        '            else (select f.precopromocao from filiais f where  f' +
        '.codigo = e.filial)'
      '            end as precopromocao'
      
        '  from (estoques e  join (produtos p join caracteristicas c on p' +
        '.caracteristica = c.codigo)'
      
        '                                                 on e.produto = ' +
        'p.codigo)'
      
        '  where  ((p.inativo is null ) or  (p.inativo>current_date)) and' +
        ' e.emestoque > 0'
      '    %FilialIndependente'
      ''
      '    %ProdutosJaCadastrados'
      ''
      ' ) as estoque'
      ') as estoquepreco1'
      ') as estoquepreco2'
      
        'where (valorproduto > 0) and (emestoque>0) and (filial = :Filial' +
        'Base)'
      '  %SQL'
      ''
      
        'order by UPPER(TO_ASCII(descricao,'#39'LATIN1'#39')), valorgrade1, valor' +
        'grade2'
      '')
    RequestLive = False
    Left = 197
    Top = 428
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'PrecodaFilialBase'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FilialBase'
        ParamType = ptUnknown
      end>
