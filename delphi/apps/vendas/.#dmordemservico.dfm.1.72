  object qryServicosDadosFiscais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select  sd.dadofiscal,'
      '        sd.servico,'
      '        s.descricao,'
      '        sd.quantidade,'
      '        sd.aliquotaissqn,'
      '        sd.valorservico,'
      '        sd.complementoservico,'
      '        sd.equipamento,'
      '        sd.estado,'
      '        sd.cidade,'
      '        sd.reterissqn,'
      '        sd.valorissqn,'
      '        sd.codigofiscal,'
      '        sd.natureza,'
      '        false as destacarIPI,'
      ''
      '        sd.pisbasecalculo,'
      '        sd.pisvalor,'
      '        sd.piscst,'
      '        sd.aliquotapis,'
      '        sd.cofinsbasecalculo,'
      '        sd.cofinsvalor,'
      '        sd.cofinscst,'
      '        sd.aliquotacofins,'
      '        s.codigolcp116,'
      '        s.cnae,'
      '        sd.cstissqn,'
      '        (select ae.codigoatividade'
      '         from atividadeseconomicas ae'
      '         where ae.codigo = s.cnae) as codigoatividade'
      ''
      'From   servicosdadosfiscais sd, servicos s'
      'where (s.codigo = sd.servico) and'
      '      (sd.dadofiscal in (select d.numero'
      '                         from dadosfiscais d'
      '                         where d.contrato = :contrato'
      '                           and d.situacao <> '#39'C'#39'))'
      '')
    RequestLive = True
    Left = 680
    Top = 400
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'contrato'
        ParamType = ptUnknown
      end>
    object qryServicosDadosFiscaisdadofiscal: TIntegerField
