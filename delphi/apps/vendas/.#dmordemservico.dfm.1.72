  object qryProcuraServico: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryProcuraServicoBeforeOpen
    AfterOpen = qryProcuraServicoAfterOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'SQLCondicao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select    s.codigo,'
      '          s.descricao,'
      ''
      '          s.aliquotaissqn,'
      '          s.valor,'
      '          s.piscst,'
      '          s.pisaliquota,'
      '          s.cofinscst,'
      '          s.cofinsaliquota,'
      '          s.codigolcp116,'
      '          ae.codigoatividade,'
      '          s.cstissqn,'
      '          s.cnae,'
      ''
      '         (select saem.codigoatividademunicipio'
      '          from servicosatividadeseconomicasmunicipios saem'
      '          where saem.servico = s.codigo'
      '            and saem.atividade = s.cnae'
      
        '            and saem.codigoatividademunicipio in (select ae_m.co' +
        'digoatividademunicipio'
      
        '                                                  from atividade' +
        'seconomicas_municipios ae_m'
      
        '                                                  where ae_m.sub' +
        'classe = ae.codigoatividade'
      
        '                                                    and ae_m.cid' +
        'adeibge = (select c.codigoibge'
      
        '                                                                ' +
        '           from cidades c'
      
        '                                                                ' +
        '           where (c.estado,c.codigo) in (select f.estado, f.cida' +
        'de'
      
        '                                                                ' +
        '                                        from filiais f'
      
        '                                                                ' +
        '                                        where f.codigo = :filial' +
        'emissao)))'
      '         ) as codigoatividademunicipio'
      ''
      ''
      'From servicos s'
      '     join atividadeseconomicas ae on s.cnae = ae.codigo'
      ''
      'Where s.codigo = :codigo'
      '%SQLCondicao'
      '')
    RequestLive = False
    Left = 203
    Top = 217
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'filialemissao'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'codigo'
        ParamType = ptUnknown
      end>
