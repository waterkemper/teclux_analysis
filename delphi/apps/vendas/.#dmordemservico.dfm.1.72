        '       (select p.descricao from produtos p where p.codigo = pr.p' +
        'roduto) as descricao,'
      
        '       (select p.valorgrade1 from produtos p where p.codigo = pr' +
        '.produto) as valorgrade1,'
      
        '       (select p.valorgrade2 from produtos p where p.codigo = pr' +
        '.produto) as valorgrade2,'
      '       pr.quantidade'
