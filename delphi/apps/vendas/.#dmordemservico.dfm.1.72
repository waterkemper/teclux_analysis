      '           e.opcionais,'
      '           e.ano,'
      '           m.descricao as descricaomarca'
      'From   equipamentos e left join marcas m on (e.marca = m.codigo)'
      'Where (e.codigo =:codigo) and'
      '           not (e.codigo in (Select ec.equipamento '
      
        '                                      From equipamentosclientes ' +
        'ec'
      
