      '           dadosfiscais.numeronota,'
      '           c.maquina,'
      '           c.intervensao,'
      '           c.numero as numerocupom          '
      '  from'
      '  ('
      '  select dadosfiscais.*,'
      '            n.serie,'
      '            n.numero as numeronota'
      '  from'
      '   ('
      '    select  df.numero'
      
