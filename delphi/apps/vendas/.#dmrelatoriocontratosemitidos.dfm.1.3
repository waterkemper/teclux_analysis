        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select contratos.*,'
      '       (select sum(p.valorpagto)'
      '        from parcelas p'
      
        #9'where p.contrato=contratos.numero and (p.tipopagto is null or p' +
        '.tipopagto='#39'B'#39')) as totalpago'
      'from'
      '('
      'select contratos.*,'
      '       fv.nome as nomefilialvenda,'
      '       fgf.grupo as grupofilialvenda,'
      '       gf.descricao as nomegrupofilialvenda'
      'from'
      '('
      'select  ct.numero,'
      #9'ct.filialvenda,'
      #9'ct.faturamento,'
      #9'ct.cliente,'
      #9'ct.tipocliente,'
      #9'ct.nome as nomecliente,'
      '              ct.valorprazo as totalvencto '
      'from contratos ct'
      'where ct.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39') and'
      '      ct.origem is null '
      ''
      '      %WherePeriodoFaturamento'
      '      %Wherefiliais'
      '      %WhereAgentes'
      '      %WhereAnalistaCredito'
      '      %WhereTipoContrato'
      '      %WhereContratoNaoEstornado '
      '      %WhereLimitePagamento '
      '      %WhereVendaaVistaouPrazo'
      ''
      
        ') as contratos  join (filiais fv left join (filiaisgruposfiliais' +
        ' fgf left join gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                          on fv.codigo=fgf.filial)'
      
        '                                 on contratos.filialvenda=fv.cod' +
        'igo'
      ''
      ') as contratos'
      '%Ordenacao')
