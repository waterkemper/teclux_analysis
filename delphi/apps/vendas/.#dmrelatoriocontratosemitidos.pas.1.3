implementation

{$R *.dfm}

{ Tdtmrelatoriocontratosemitidos }

const
 // Filtros
  FiltroFilial      = ' AND ( ct.filialvenda IN (%s)) ' +#13#10;
  FiltroGrupoFilial = ' AND ( ct.filialvenda IN (SELECT filial '+#13#10+
                                         'FROM filiaisgruposfiliais fgf '+#13#10+
                                         'WHERE fgf.grupo IN (%s))) ';
  FiltroAgente          = ' AND ( ct.agente IN (%s)) ' +#13#10;
  FiltroAnalistaCredito = ' AND ( ct.analista IN (%s)) ' +#13#10;

constructor Tdtmrelatoriocontratosemitidos.Create(AOwner: TComponent);
begin
  inherited;
  qryAgentes.Tag                :=ctTabelas;
  qryAnalistaCredito.Tag        :=ctTabelas;
end;

procedure Tdtmrelatoriocontratosemitidos.ImprimirRelatorio;
var
  Relatorio: TfrReport;
  frmPreview: TfrmPreviewPadrao;
begin
  frVariables['RAZAOFILIALBASE']  := RazaoFilialBase;
  frVariables['ENDERECO_BAIRRO']   := RuaFilialBase+ ' - '+BairroFilialBase;
  frVariables['CEP_CIDADE_UF']:= FormatarCEP(CEPFilialBase)+'  '+CidadeFilialBase+ '  '+ EstadoFilialBase;
  frVariables['Outras']:= FParametroCabecalho;
  frVariables['AgruparGrupoFilial']:=FAgruparGrupoFilial;
  frVariables['AgruparFilial']:=FAgruparFilial;
  frVariables['ExibirTotalPorContrato']:=FExibirTotalPorContrato;
  case Tipo of
    0 : frVariables['Titulo']:= 'CONTRATOS EMITIDOS - Parcelas Nao Quitadas';
    1 : frVariables['Titulo']:= 'CONTRATOS EMITIDOS - Entrada/Venda a Vista nao Quitada';
    2 : frVariables['Titulo']:= 'CONTRATOS EMITIDOS - Quitados';
    3 : frVariables['Titulo']:= 'CONTRATOS EMITIDOS';
  end;
//  frpImprimirContratosEmitidos.DesignReport;
//  frpImprimirContratosEmitidosSemParcelas.DesignReport;
  frmPreview := TfrmPreviewPadrao.create(self);
  try
   Relatorio := frmPreview.frCompositeReport;
   with frmPreview do
   begin
    frCompositeReport.Reports.Clear;
    case FResumo of
     0: begin
           if NaoListarParcelas then
           begin
             frCompositeReport.Reports.Add(frpImprimirContratosEmitidosSemParcelas);
             frCompositeReport.Reports.Add(frpImprimirContratosEmitidosSemParcelasResumo);
           end
           else
           begin
             frCompositeReport.Reports.Add(frpImprimirContratosEmitidos);
             frCompositeReport.Reports.Add(frpImprimirContratosEmitidosResumo);
           end;
        end;
     1: begin
          if NaoListarParcelas then
            frCompositeReport.Reports.Add(frpImprimirContratosEmitidosSemParcelas)
          else frCompositeReport.Reports.Add(frpImprimirContratosEmitidos);
        end;

     2: begin
          if NaoListarParcelas then
            frCompositeReport.Reports.Add(frpImprimirContratosEmitidosSemParcelasResumo)
          else frCompositeReport.Reports.Add(frpImprimirContratosEmitidosResumo);
        end;
    end;
   end;
   Relatorio.Preview := frmPreview.frPreviewPadrao;
   Relatorio.ShowReport;
   frmPreview.ShowModal;
  finally
   frmPreview.Free
  end;
end;

procedure Tdtmrelatoriocontratosemitidos.MontaDatas;
const
SQL = 'and ct.faturamento between %s and %s';
begin
  if FDataFinal<>'' then
  begin
    qryImprimirContratos.MacroByName('WherePeriodoFaturamento').AsString := format(SQL,[quotedstr(FDataInicial),quotedstr(FDataFinal)]);
    FParametroCabecalho:=FParametroCabecalho+' Entre: '+FDataInicial+' e '+FDataFinal;
  end
  else
    qryImprimirContratos.MacroByName('WherePeriodoFaturamento').AsString := '';
end;

procedure Tdtmrelatoriocontratosemitidos.SetAgentes(const Value: String);
begin
  if (Value <> '') then
   qryImprimirContratos.MacroByName('WhereAgentes').AsString := Format(FiltroAgente,[Value])
  else
   qryImprimirContratos.MacroByName('WhereAgentes').AsString := '';
end;

procedure Tdtmrelatoriocontratosemitidos.SetAnalistaCredito(
  const Value: String);
begin
  if (Value <> '') then
    qryImprimirContratos.MacroByName('WhereAnalistaCredito').AsString := Format(FiltroAnalistaCredito,[Value])
  else
    qryImprimirContratos.MacroByName('WhereAnalistaCredito').AsString := '';
end;

procedure Tdtmrelatoriocontratosemitidos.SetDataFinal(const Value: String);
begin
  if not DataEmBranco(Value) then
  begin
    FDataFinal := Value;
    if FDataInicial='' then
      FDataInicial:=FDataFinal;
  end
  else FDataFinal := FDataInicial;
  MontaDatas;
end;

procedure Tdtmrelatoriocontratosemitidos.SetFiliais(const Value: String);
begin
 FFiliais := Value;
 if (Value <> '') then
   qryImprimirContratos.MacroByName('WhereFiliais').AsString := Format(FiltroFilial,[Value])
 else
   qryImprimirContratos.MacroByName('WhereFiliais').AsString := '';
end;

procedure Tdtmrelatoriocontratosemitidos.SetGrupoFiliais(
  const Value: String);
begin
  FGrupoFiliais := Value;
  if (Value <> '') then
  begin
    if ParSistema.RelatorioSomenteFiliaisAutorizadas then
     qryImprimirContratos.MacroByName('WhereFiliais').AsString :=
       qryImprimirContratos.MacroByName('WhereFiliais').AsString+
       Format(FiltroGrupoFilial,[Value])
    else
     qryImprimirContratos.MacroByName('WhereFiliais').AsString := Format(FiltroGrupoFilial,[Value]);
  end;
end;

procedure Tdtmrelatoriocontratosemitidos.SetTipo(const Value: Integer);
begin
  FTipo := Value;
  case FTipo of
     0 : begin
           qryImprimirContratos.macrobyname('WhereTipoContrato').asstring := ' and (select count(*) from parcelas p where p.contrato=ct.numero and p.datapagto is null) > 0';
           qryImprimirContratosParcelas.macrobyname('WhereTipoParcelas').AsString :=' and p.datapagto is null';
         end;
     1 : begin
           qryImprimirContratos.macrobyname('WhereTipoContrato').asstring :=
          ' and (select count(*)'+
                 ' from parcelas p where p.contrato=ct.numero and'+
                ' p.datavencto <= ct.faturamento and'+
                                     ' p.datapagto is null)>0';
           qryImprimirContratosParcelas.macrobyname('WhereTipoParcelas').AsString :=
           ' and (p.datavencto <= ct.faturamento) and p.datapagto is null';
         end;
     2 : begin
           qryImprimirContratos.macrobyname('WhereTipoContrato').asstring :=
           'and not exists (select p.contrato '+
           '                from parcelas p '+
           '                where p.contrato = ct.numero and '+
           '                      p.datapagto is null) ';
           qryImprimirContratosParcelas.macrobyname('WhereTipoParcelas').AsString := '';
         end;
     3 : begin
           qryImprimirContratos.macrobyname('WhereTipoContrato').asstring := '';
           qryImprimirContratosParcelas.macrobyname('WhereTipoParcelas').AsString := '';
         end;
  end;
  if FDataQuitacaoFinal<>'' then
    qryImprimirContratos.macrobyname('WhereContratonaoestornado').asstring :=
   ' and (coalesce((select count(*) from parcelas p where '+
   '(p.contrato = ct.numero and ((p.tipopagto in (''E'',''J'') and p.datapagto<='+quotedstr(FDataQuitacaoFinal)+')'+
   'or (p.tipopagto in (''D'',''C'',''P'',''X'') and p.deventrada<='+quotedstr(FDataQuitacaoFinal)+'))) ),0)'+
   '<> (select count(*) from parcelas p where p.contrato=ct.numero))'
  else
    qryImprimirContratos.macrobyname('WhereContratonaoestornado').asstring :=
   ' and (coalesce((select count(*) from parcelas p where '+
   '(p.contrato = ct.numero and ((p.tipopagto in (''E'',''J'') and p.datapagto<='+quotedstr(FDatafinal)+')'+
   'or (p.tipopagto in (''D'',''C'',''P'',''X'') and p.deventrada<='+quotedstr(FDatafinal)+'))) ),0)'+
   '<> (select count(*) from parcelas p where p.contrato=ct.numero))';
end;

procedure Tdtmrelatoriocontratosemitidos.qryImprimirContratosAfterScroll(
  DataSet: TDataSet);
begin
  inherited;
  RefazConsulta(qryImprimirContratosDadosFiscais, [0],[qryImprimirContratosnumero.AsVariant]);
  if not NaoListarParcelas then
    RefazConsulta(qryImprimirContratosParcelas, [0],[qryImprimirContratosnumero.AsVariant]);
end;


function Tdtmrelatoriocontratosemitidos.GetListaAgentes: TStrings;
begin
  FListaAgentes:= TStringList.Create;
  qryAgentes.Open;
  while not qryAgentes.Eof do
  begin
    FListaAgentes.AddObject(qryAgentesdescricao.AsString, Pointer(qryAgentescodigo.AsInteger));
    qryAgentes.Next;
  end;
  qryAgentes.Close;
  Result := FListaAgentes;
end;

function Tdtmrelatoriocontratosemitidos.GetListaAnalistaCredito: TStrings;
begin
  FListaAnalistaCredito:= TStringList.Create;
  qryAnalistaCredito.Open;
  while not qryAnalistaCredito.Eof do
  begin
    FListaAnalistaCredito.AddObject(qryAnalistaCreditonome.AsString, Pointer(qryAnalistaCreditocodigo.AsInteger));
    qryAnalistaCredito.Next;
  end;
  qryAnalistaCredito.Close;
  Result := FListaAnalistaCredito;
end;

procedure Tdtmrelatoriocontratosemitidos.MontarFiltroAgentes(
  Usar: TCheckListBox);
var
  STRAgentes: String;
  TodosAgentes: Boolean;
  cnt: Integer;
begin
  TodosAgentes:=true;
  STRAgentes := '';
  for cnt := 0 to FListaAgentes.Count - 1 do
    if Usar.Checked[cnt] then
      STRAgentes := STRAgentes + '''' + IntToStr(Integer(FListaAgentes.Objects[cnt])) + ''','
    else
      TodosAgentes:=false;

  STRAgentes := Copy(STRAgentes, 0, Length(STRAgentes) - 1);
  if Trim(STRAgentes) <> '' then
  begin
    if TodosAgentes then
      FParametroCabecalho:=FParametroCabecalho+' Agentes: Todos'
    else
      FParametroCabecalho:=FParametroCabecalho+' Agentes: '+STRAgentes;
  end;
  Agentes := STRAgentes ;
end;



destructor Tdtmrelatoriocontratosemitidos.Destroy;
begin
  FListaAgentes.Free;
  FListaAnalistaCredito.Free;
  inherited;
end;

procedure Tdtmrelatoriocontratosemitidos.MontarFiltroAnalistaCredito(
  Usar: TCheckListBox);
var
  STRAnalistaCredito: String;
  TodosAnalistas: Boolean;
  cnt: Integer;
begin
  TodosAnalistas:=true;
  STRAnalistaCredito := '';
  for cnt := 0 to FListaAnalistaCredito.Count - 1 do
    if Usar.Checked[cnt] then
      STRAnalistaCredito := STRAnalistaCredito + '''' + IntToStr(Integer(FListaAnalistaCredito.Objects[cnt])) + ''','
    else
      TodosAnalistas:=false;

  STRAnalistaCredito := Copy(STRAnalistaCredito, 0, Length(STRAnalistaCredito) - 1);
  if Trim(STRAnalistaCredito) <> '' then
  begin
    if TodosAnalistas then
      FParametroCabecalho:=FParametroCabecalho+' Analistas de Credito: Todos'
    else
      FParametroCabecalho:=FParametroCabecalho+' Analistas de Credito: '+STRAnalistaCredito;
  end;
  AnalistaCredito := STRAnalistaCredito ;
end;

procedure Tdtmrelatoriocontratosemitidos.MontarOrdenacao;
var
Ordenacao: String;
begin
  Ordenacao:='';
  if FAgruparGrupoFilial then
    Ordenacao:=Ordenacao+', nomegrupofilialvenda, grupofilialvenda ';
  if FAgruparFilial then
    Ordenacao:=Ordenacao+', nomefilialvenda, filialvenda ';
  case FOrdenacao of
  0 : Ordenacao:=Ordenacao+', faturamento, nomecliente, cliente, tipocliente, numero';
  1 : Ordenacao:=Ordenacao+', cliente, tipocliente, numero';
  2 : Ordenacao:=Ordenacao+', nomecliente, cliente, tipocliente, numero';
  end;
  qryImprimirContratos.MacroByName('Ordenacao').AsString := 'Order by '+copy(Ordenacao,2,length(Ordenacao)-1);
end;

procedure Tdtmrelatoriocontratosemitidos.frpImprimirContratosEmitidosBeforePrint(
  Memo: TStringList; View: TfrView);
begin
  inherited;
  ZebrarLinhaRelatorio(frpImprimirContratosEmitidos, View);
end;



procedure Tdtmrelatoriocontratosemitidos.SetDataQuitacaoFinal(
  const Value: String);
const
 SQL = ' and ct.numero in '+
       ' (select distinct p.contrato '+
       '  from parcelas p '+
       '  where p.datapagto between %s and %s '+
       '    and not exists (select p2.contrato '+
       '                    from parcelas p2 '+
       '                    where p2.contrato = p.contrato '+
       '                      and (p2.datapagto > %s '+
       '                           or p2.datapagto is null))) ';

begin
  if not DataEmBranco(Value) then
  begin
    FDataQuitacaoFinal := Value;
    if FDataQuitacaoInicial='' then
      FDataQuitacaoInicial:=FDataQuitacaoFinal;
  end
  else FDataQuitacaoFinal := FDataQuitacaoInicial;

  if FDataQuitacaoFinal<>'' then
  begin
    qryImprimirContratos.MacroByName('WhereLimitePagamento').AsString := format(SQL, [quotedstr(FDataQuitacaoInicial), quotedstr(FDataQuitacaoFinal), quotedstr(FDataQuitacaoFinal)]);
    FParametroCabecalho := FParametroCabecalho+' Quitacao entre: '+FDataQuitacaoInicial+' e '+FDataQuitacaoFinal;
  end
  else
    qryImprimirContratos.MacroByName('WhereLimitePagamento').AsString := '';
end;


function Tdtmrelatoriocontratosemitidos.AbrirConsulta: Boolean;
begin
 ReFazConsulta(qryImprimirContratos,[],[]);
 result := not (qryImprimirContratos.IsEmpty);
end;

procedure Tdtmrelatoriocontratosemitidos.frpImprimirContratosEmitidosSemParcelasBeforePrint(
  Memo: TStringList; View: TfrView);
begin
  inherited;
  ZebrarLinhaRelatorio(frpImprimirContratosEmitidosSemParcelas, View);
end;

procedure Tdtmrelatoriocontratosemitidos.frpImprimirContratosEmitidosSemParcelasBeginDoc;
begin
  inherited;
  Zebrado_Detalhe := True;
  Zebrado_SubDetalhe_1 := True;
  Zebrado_SubDetalhe_2 := True;
end;

procedure Tdtmrelatoriocontratosemitidos.SetVendaaPrazo(
  const Value: Boolean);
const
 VendaaVista =' and ((select count(*) '+
              '       from parcelas p '+
              '       where p.contrato = ct.numero '+
              '         and p.datavencto > ct.faturamento) = 0) ';
 VendaaPrazo =' and ((select count(*) '+
              '       from parcelas p '+
              '       where p.contrato = ct.numero '+
              '         and p.datavencto > ct.faturamento) > 0) ';
begin
  FVendaaPrazo := Value;
if (FVendaaVista and FVendaaPrazo) or
   (not FVendaaVista and not FVendaaPrazo) then
  qryImprimirContratos.MacroByName('WhereVendaaVistaouPrazo').AsString := ''
else
 if FVendaaVista then
 begin
  qryImprimirContratos.MacroByName('WhereVendaaVistaouPrazo').AsString := VendaaVista;
  FParametroCabecalho:=FParametroCabecalho+' Tipo de Venda: a vista';
 end
 else
  if FVendaaPrazo then
  begin
   qryImprimirContratos.MacroByName('WhereVendaaVistaouPrazo').AsString := VendaaPrazo;
   FParametroCabecalho:=FParametroCabecalho+' Tipo de Venda: a Prazo';
  end;
end;

end.
