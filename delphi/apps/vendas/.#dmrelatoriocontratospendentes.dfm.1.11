      '    '#9#9#9#9#9#9'           and df.data <= :DataSituacao limit 1)'
      '                                    ),0)<>0))'
      '       )'
      '     )'
      ''
      ''
      '    ) as selecao'
      '    where'
      
        '        ( ((selecao.situacao in (''N'',''P'')) and ((selecao.quantid' +
        'ade - ((Select coalesce(sum(pdf.quantidade),0)'
      
