        '                                                     from parcel' +
        'as p2'
      
        '                                                     where p2.co' +
        'ntrato = selecao.numero'
      
        '                                                       and p2.da' +
        'tapagto > :DataSituacao)'
      
        '                                         and not exists (select ' +
