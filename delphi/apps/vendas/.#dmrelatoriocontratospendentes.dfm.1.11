  object qryPendentes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereFilial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereGrupoFilial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereItensProdutos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereProdutos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereProdutosFornecedores'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereGrupos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereClasses'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '('
      ' Select cast(''Pendentes'' as varchar) as situacao,'
      '        selecao.numero as contrato,'
      '        selecao.faturamento,'
      '        selecao.cliente,'
      ''
      '        selecao.nome as nomecliente,'
      '        selecao.filialvenda,'
      '        selecao.produto,'
      '        selecao.filial,'
      
        '        cast(selecao.descricao||'' ''||coalesce(selecao.valorgrade' +
        '1,'''')||'' ''||coalesce(selecao.valorgrade2,'''') as varchar) as desc' +
        'ricao,'
      '        selecao.referencia,'
      '        selecao.precovenda,'
      '        selecao.valorvista,'
      '        selecao.valorprazo,'
      '        selecao.desconto,'
      
        '        case when (selecao.quantidade - coalesce(selecao.cancela' +
        'do,0)) = 0 then'
      
        '          cast(''C'' as varchar) else cast(null as varchar) end as' +
        ' situacaoprodutocontrato,'
      ''
      '        case when (selecao.situacao in (''F'',''N'',''P'')) then'
      '                   ((selecao.quantidade - '
      '                     coalesce((select sum(cd.quantidade)'
      '                               from contratosdevolvidos cd'
      
        '                               where cd.contrato = selecao.numer' +
        'o'
      
        '                                 and cd.produto = selecao.produt' +
        'o'
      
        '                                 and cd.devolucao <= :DataSituac' +
        'ao'
      '                                 and cd.tipo = ''D'''
      '                               ) ,0)) -'
      '                     (Select coalesce(sum(pdf1.quantidade),0)'
      
        '                        From produtosdadosfiscais pdf1, dadosfis' +
        'cais df1'
      '                       Where pdf1.produto = selecao.produto'
      '                         and pdf1.dadofiscal = df1.numero'
      '                         and df1.contrato = selecao.numero'
      '                         and pdf1.filial=selecao.filial'
      
        '                         and not coalesce(df1.notavinculada,fals' +
        'e)'
      '                         and df1.data <= :DataSituacao ))'
      '             when (selecao.situacao = ''C'') then'
      '                   ((selecao.quantidade -'
      '                     coalesce((select sum(cd.quantidade)'
      '                               from contratosdevolvidos cd'
      
        '                               where cd.contrato = selecao.numer' +
        'o'
      
        '                                 and cd.produto = selecao.produt' +
        'o'
      
        '                                 and cd.devolucao <= :DataSituac' +
        'ao'
      
        '                                 and cd.tipo = ''D'' and cd.situac' +
        'ao=''N''),0)'
      '                                 -'
      '                     (Select coalesce(sum(pdf1.quantidade),0)'
      
        '                        From produtosdadosfiscais pdf1, dadosfis' +
        'cais df1'
      '                       Where pdf1.produto = selecao.produto'
      '                         and pdf1.dadofiscal = df1.numero'
      '                         and df1.contrato = selecao.numero'
      '                         and pdf1.filial=selecao.filial'
      
        '                         and not coalesce(df1.notavinculada,fals' +
        'e)'
      '                         and df1.data <= :DataSituacao )))'
      '         end as pendente,'
      ''
      '        selecao.nomefilialvenda,'
      '        cast(null as date) as devolucao'
      'from'
      '('
      'select selecao.*'
      'from'
      '('
      'select selecao.*'
      'from'
      '('
      ' Select ct.situacao,'
      '        ct.numero,'
      '        ct.faturamento,'
      '        ct.cliente,'
      '        ct.nome,'
      '        ct.filialvenda,'
      '        pc.produto,'
      '        pc.filial,'
      '        p.descricao,'
      '        p.valorgrade1,'
      '        p.valorgrade2, '
      '        p.referencia,'
      '        pc.precovenda,'
      '        ct.valorvista,'
      '        ct.valorprazo,'
      '        ct.desconto,'
      '        pc.quantidade,'
      '        pc.cancelado,'
      '        f.nome as nomefilialvenda,'
      '        cast(null as date) as devolucao'
      ''
      'From contratos ct '
      '     join produtoscontratos pc'
      '          join produtos p'
      '          on pc.produto = p.codigo'
      '     on ct.numero = pc.contrato'
      '    '
      '     join filiais f'
      '     on ct.filialvenda = f.codigo'
      ''
      'where ct.numero = pc.contrato'
      '  and ct.filialvenda = f.codigo'
      '  and pc.produto = p.codigo'
      ''
      '  and ct.faturamento between :datavenda  and :DataSituacao'
      
        '  and case when ct.os then ct.tipoequipamento in (1,2) and not (' +
        'coalesce(ct.os_garantia,false) and ct.os_garantia_status=''A'') an' +
        'd not coalesce(ct.os_cortesia,false) else true end'
      ''
      '     %WhereFilial'
      '     %WhereGrupoFilial'
      '     %WhereItensProdutos'
      '     %WhereProdutos'
      '     %WhereProdutosFornecedores'
      '     %WhereGrupos'
      '     %WhereClasses'
      ''
      '    ) as selecao'
      '   where'
      
        '    ((selecao.situacao in (''F'',''P''))                            ' +
        '   or'
      '      (selecao.situacao = ''N'' and ( exists (Select df.numero'
      '                                        From dadosfiscais df'
      
        '                                        Where df.data > :DataSit' +
        'uacao'
      
        '                                          and df.contrato = sele' +
        'cao.numero '
      
        '                                          and not coalesce(df.no' +
        'tavinculada,false) limit 1) or'
      '                                exists (select cd.contrato'
      
        '                                        from contratosdevolvidos' +
        ' cd'
      
        '                                        where cd.contrato = sele' +
        'cao.numero'
      
        '                                          and cd.devolucao > :Da' +
        'taSituacao'
      '                                          and cd.situacao = ''F'' '
      
        '                                          and cd.produto=selecao' +
        '.produto'
      
        '                                          /*and cd.tipo=''D''*/ li' +
        'mit 1))  )        or'
      ''
      '     (selecao.situacao = ''C'' and ((( exists (Select cd.contrato'
      
        '                                        From contratosdevolvidos' +
        ' cd'
      
        '                                        Where cd.devolucao >= :D' +
        'ataSituacao'
      
        '                                          and cd.contrato = sele' +
        'cao.numero'
      
        '                                          and cd.produto = selec' +
        'ao.produto'
      
        '                                          and cd.tipo = ''D'' limi' +
        't 1))'
      ''
      
        '                               and coalesce((select sum(pdf.quan' +
        'tidade)'
      
        '                                             From dadosfiscais d' +
        'f'
      
        '                                                  join produtosd' +
        'adosfiscais pdf'
      
        '                                                  on df.numero =' +
        ' pdf.dadofiscal'
      
        '                                             where df.contrato =' +
        ' selecao.numero'
      
        '                                               and pdf.produto =' +
        ' selecao.produto'
      
