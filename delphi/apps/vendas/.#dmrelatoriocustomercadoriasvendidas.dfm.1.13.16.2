  object qryDadosFiscaisProdutosVendaFrenteCaixa: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereRegioes_df'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereProdutos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereCliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereBrinde_ou_NaoBrinde'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereComMontagem_ou_SemMontagem'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereEmLinha_ou_ForadeLinha'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Ordenacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '('
      ' select ProdutosDadosFiscaisMovimentos.*,'
      '        u.nome as nomevendedor,'
      '        p.descricao, '
      '        p.valorgrade1, '
      '        p.valorgrade2,'
      '        c.grupo,'
      '        g.descricao as grupodescricao,'
      '        c.classe,'
      '        cl.descricao as classegrupo,'
      '        f.nome as nomefilialvenda, '
      '        (select f2.nome '
      '         from filiais f2 '
      
        '         where f2.codigo = ProdutosDadosFiscaisMovimentos.filial' +
        'emissao) as nomefilialemissao,'
      '        fgf.grupo as grupofilialvenda,'
      '        gf.descricao as nomegrupofilialvenda,'
      '        pl.descricao as nomeplano,'
      
        '        case when preco_custo<>0 then (((Preco_Prazo/preco_custo' +
        ')-1)*100)           else cast(0 as numeric) end as markup,'
      
        '        case when preco_prazo<>0 then (quantidade*(Preco_Prazo-p' +
        'reco_custo))        else cast(0 as numeric) end as margem, '
      
        '        case when preco_prazo<>0 then (((Preco_Prazo-preco_custo' +
        ')/Preco_Prazo)*100) else cast(0 as numeric) end as pmargem,'
      '        cast('#39'V'#39' as varchar) as Tipo'
      ' from'
      ' ('
      '  select ProdutosDadosFiscaisMovimentosEncontrado.*,'
      
        '  CASE WHEN coalesce(m.quantidade,0)=0 THEN 0.00 ELSE (@(m.valor' +
        '/m.quantidade)) END as preco_custo,'
      
        '  coalesce((m.emestoque+m.reservado+m.transito+m.demonstracao+m.' +
        'conserto+m.danificada),0) as qtemestoque'
      '  from'
      '  ('
      '   select ProdutosDadosFiscais.*,'
      '          coalesce(produtosdadosfiscais.movimento, '
      '         (select m.numero'
      '          from movimentos m'
      '          where m.produto=produtosdadosfiscais.produto '
      '            and m.filial=produtosdadosfiscais.filial '
      '            and m.financeiro<>0 '
      '            and m.data <= produtosdadosfiscais.data'
      
        '          order by m.data desc, m.lancto desc limit 1 )) as nume' +
        'romovimento'
      '   from'
      '   ('
      '    select df.nome,'
      
        '           cast(cast(df.tipocliente as varchar)||cast(df.cliente' +
        ' as varchar) as varchar) as cliente,'
      '           df.vendedor,'
      '           pdf.produto,'
      '           pdf.filial,'
      '           df.numero as dadofiscal,'
      '           n.serie,'
      '           n.numero as notafiscal,'
      '           c.maquina,'
      '           c.intervensao,'
      '           c.numero as cupomfiscal,'
      '           df.data,'
      '           df.filialvenda, '
      '           df.filialemissao,'
      '           pdf.quantidade,'
      '           pdf.precotabela as preco_pauta,'
      '           pdf.precovenda as preco_vista,'
      
        '           (((coalesce(df.desconto,0)*pdf.precovenda)/(df.valorv' +
        'ista+coalesce(df.desconto,0)))) as desconto,'
      
        '           ((((df.valortotal-df.valorvista)*pdf.precovenda)/(df.' +
        'valorvista+coalesce(df.desconto,0)))) as juros,'
      
        '           ((pdf.precovenda-((coalesce(df.desconto,0)*pdf.precov' +
        'enda)/(df.valorvista+coalesce(df.desconto,0)))+(((df.valortotal-' +
        'df.valorvista)*pdf.precovenda)/(df.valorvista+coalesce(df.descon' +
        'to,0)))))  as preco_prazo,'
      '           cast(DF.plano as varchar) as plano, pdf.icmsvalor, '
      '           pdf.movimento'
      '    FROM (((DadosFiscais DF '
      '            JOIN ProdutosDadosFiscais PDF '
      '            ON DF.numero=PDF.dadofiscal) '
      '            '
      '            LEFT JOIN Notas N '
      '            ON DF.numero=N.dadofiscal)'
      ''
      '            LEFT JOIN Cupons C '
      '            ON DF.numero=C.dadofiscal)'
      ''
      '    WHERE df.numero = pdf.dadofiscal'
      '      and df.data BETWEEN :DataInicial AND :DataFinal'
      '      AND df.situacao not in ('#39'C'#39','#39'D'#39')'
      '      AND ((EXISTS (SELECT vdf.dadofiscal '
      '                    FROM venctosdadosfiscais vdf '
      '                    WHERE vdf.dadofiscal=df.numero)) or'
      
        '           (mod(df.codigofiscal,1000) in (101,102,103,104,105,92' +
        '9,401,402,403,404,405))) '
      '      and df.contrato is null'
      ''
      '    %WhereFiliais'
      ''
      '    %WhereRegioes_df'
      ''
      '    %WhereProdutos'
      ''
      '    %WhereCliente'
      ''
      '    %WhereBrinde_ou_NaoBrinde'
      ''
      '   ) as ProdutosDadosFiscais'
      '  ) as ProdutosDadosFiscaisMovimentosEncontrado'
      '       left join movimentos m'
      
        '       on ProdutosDadosFiscaisMovimentosEncontrado.numeromovimen' +
        'to=m.numero'
      ''
      ' ) as ProdutosDadosFiscaisMovimentos'
      '      join (filiais f'
      '            left join (filiaisgruposfiliais fgf'
      '                       join gruposfiliais gf'
      '                       on fgf.grupo=gf.codigo)'
      '            on f.codigo=fgf.filial)'
      '      on ProdutosDadosFiscaisMovimentos.filialvenda=f.codigo'
      ''
      '      left join planos pl'
      
        '      on cast(ProdutosDadosFiscaisMovimentos.plano as integer)=p' +
        'l.codigo'
      ''
      '      left join usuarios u'
      '      on ProdutosDadosFiscaisMovimentos.vendedor=u.codigo'
      ''
      '      join (estoques e'
      '            join (produtos p'
      '                  join ((caracteristicas c'
      '                         join grupos g'
      '                         on c.grupo=g.codigo)'
      ''
      '                         join classes cl'
      '                         on c.classe=cl.codigo)'
      ''
      '                   on p.caracteristica=c.codigo)'
      '            on e.produto=p.codigo)'
      '      on ProdutosDadosFiscaisMovimentos.produto=e.produto and'
      '         ProdutosDadosFiscaisMovimentos.filial=e.filial'
      ''
      '      where true'
      ''
      '      %WhereComMontagem_ou_SemMontagem'
      ''
      '      %WhereEmLinha_ou_ForadeLinha'
      ''
      '      %Ordenacao'
      ''
      ')')
    RequestLive = False
    Left = 479
    Top = 296
    ParamData = <
      item
        DataType = ftString
        Name = 'DataInicial'
        ParamType = ptUnknown
        Value = '01/03/2005'
      end
      item
        DataType = ftString
        Name = 'DataFinal'
        ParamType = ptUnknown
        Value = '01/03/2005'
      end>
  end
  object qryDadosFiscaisProdutosDevolucoesFrenteCaixa: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereRegioes_np'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereDevolucoes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereProdutos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereCliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereBrinde_ou_NaoBrinde'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereComMontagem_ou_SemMontagem'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereEmLinha_ou_ForadeLinha'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '('
      'select (select coalesce(vf.razao,vf.nome)'
      '        from vfornecedores vf'
      '        where vf.codigo = pnm.fornecedor '
      '          and vf.tipo = pnm.tipofornecedor) as nome,'
      
        '        cast(cast(pnm.tipofornecedor as varchar)||cast(pnm.forne' +
        'cedor as varchar) as varchar) as cliente,'
      '        cast(null as integer) as vendedor,'
      '        pnm.produto,'
      '        pnm.filial,'
      '        cast(null as integer) as dadofiscal,'
      '        pnm.serie,'
      '        pnm.numero as notafiscal,'
      '        cast(null as integer) as maquina,'
      '        cast(null as integer) as intervensao,'
      '        cast(null as integer) as cupomfiscal,'
      '        pnm.data,'
      '        pnm.filialvenda,'
      '        cast(0 as integer) as filialemissao,'
      '      - pnm.quantidade as quantidade,'
      '        cast(null as numeric(11,2)) as preco_pauta,'
      '        cast(null as numeric(11,2)) as preco_vista,'
      '        cast(null as numeric(11,2)) as desconto,'
      '        cast(null as numeric(11,2)) as juros,'
      '        cast(null as numeric(11,2)) as preco_prazo,'
      '        cast(null as varchar) as plano,'
      '      - pnm.icmsvalor,'
      '        cast(null as integer) as movimento,'
      '        cast(null as integer) as numeromovimento,'
      '        pnm.preco_custo as preco_custo,'
      '        cast(null as Numeric(9,3)) as qtemestoque,'
      '        cast(null as varchar(40)) as nomevendedor,'
      '        p.descricao,'
      '        p.valorgrade1,'
      '        p.valorgrade2,'
      '        c.grupo,'
      '        g.descricao as grupodescricao,'
      '        c.classe,'
      '        cl.descricao as classegrupo,'
      '        f.nome as nomefilialvenda,'
      '        cast('#39'DEVOLUCOES'#39' as varchar) as nomefilialemissao,'
      '        fgf.grupo as grupofilialvenda,'
      '        gf.descricao as nomegrupofilialvenda,'
      '        cast(null as varchar) as nomeplano,'
      '        cast(0 as numeric) as markup,'
      '        cast(0 as numeric) as margem,'
      '        cast(0 as numeric) as pmargem,'
      '        cast('#39'D'#39' as varchar) as Tipo'
      'from'
      '('
      ' SELECT np.data,'
      '        np.serie,'
      '        np.numero,'
      '        np.filial as filialvenda,'
      '        np.codigo,'
      '        np.fornecedor,'
      '        np.tipofornecedor,'
      '        m.produto,'
      '        m.filial,'
      '        m.quantidade,'
      '        m.valor,'
      
        '       CASE WHEN coalesce(m.quantidade,0)=0 THEN 0.00 ELSE (@(m.' +
        'valor/m.quantidade)) END as preco_custo,'
      '        np.contrato,'
      ''
      '      (select pnp.icmsvalor'
      '       from produtosnotaspag pnp'
      '       where pnp.codigonota = np.codigo'
      '         and pnp.produto = m.produto'
      '         and pnp.filial = m.filial) as icmsvalor'
      ''
      ' FROM notaspag np'
      '      join movimentos m'
      '      on np.codigo = m.codigonota'
      ''
      ' WHERE np.data BETWEEN (:DataInicial) AND (:DataFinal)'
      
        '   and ehnotafiscalentradadevolucao(np.codigofiscal) /*mod(np.co' +
        'digofiscal,1000)=202*/'
      '   and np.contrato is null'
      ''
      '   %WhereFiliais'
      ''
      '   %WhereRegioes_np'
      ''
      ') as pnm'
      '      join (filiais f'
      '            left join (filiaisgruposfiliais fgf'
      '                       join gruposfiliais gf'
      '                       on fgf.grupo=gf.codigo)'
      '            on f.codigo=fgf.filial)'
      '      on pnm.filialvenda = f.codigo'
      ''
      '      join (estoques e'
      '            join (produtos p'
      '                  join ((caracteristicas c'
      '                         join grupos g'
      '                         on c.grupo=g.codigo)'
      ''
      '                         join classes cl'
      '                         on c.classe = cl.codigo)'
      '                  on p.caracteristica=c.codigo)'
      '            on e.produto=p.codigo)'
      '      on pnm.produto = e.produto and'
      '         pnm.filial = e.filial'
      ''
      '    where true'
      ''
      '    %WhereDevolucoes'
      ''
      '    %WhereProdutos'
      ''
      '    %WhereCliente'
      ''
      '    %WhereBrinde_ou_NaoBrinde'
      ''
      '    %WhereComMontagem_ou_SemMontagem'
      ''
      '    %WhereEmLinha_ou_ForadeLinha'
      ''
      ')')
    RequestLive = False
    Left = 479
    Top = 379
    ParamData = <
      item
        DataType = ftDate
        Name = 'DataInicial'
        ParamType = ptUnknown
        Value = '01/01/2000'
      end
      item
        DataType = ftDate
        Name = 'DataFinal'
        ParamType = ptUnknown
        Value = '01/01/2000'
      end>
  end
