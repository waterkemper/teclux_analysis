  object qryDadosFiscaisProdutosVendas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereRegioes_df'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereProdutos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereCliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereComMontagem_ou_SemMontagem'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereBrinde_ou_NaoBrinde'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereEmLinha_ou_ForadeLinha'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Ordenacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '('
      ' select ProdutosDadosFiscaisMovimentos.*,'
      '        u.nome as nomevendedor,'
      '        p.descricao,'
      '        p.valorgrade1,'
      '        p.valorgrade2,'
      '        c.grupo,'
      '        g.descricao as grupodescricao,'
      '        c.classe,'
      '        cl.descricao as classegrupo,'
      '        f.nome as nomefilialvenda,'
      '        (select f2.nome'
      '         from filiais f2'
      
        '         where f2.codigo = ProdutosDadosFiscaisMovimentos.filial' +
        'emissao) as nomefilialemissao,'
      '        fgf.grupo as grupofilialvenda,'
      '        gf.descricao as nomegrupofilialvenda,'
      '        pl.descricao as nomeplano,'
      
        '        case when preco_custo<>0 then (((Preco_Prazo/preco_custo' +
        ')-1)*100)           else cast(0 as numeric) end as markup,'
      
        '        case when preco_prazo<>0 then (quantidade*(Preco_Prazo-p' +
        'reco_custo))        else cast(0 as numeric) end as margem,'
      
        '        case when preco_prazo<>0 then (((Preco_Prazo-preco_custo' +
        ')/Preco_Prazo)*100) else cast(0 as numeric) end as pmargem,'
      '        cast('#39'V'#39' as varchar) as Tipo'
      ' from'
      ' ('
      '  select ProdutosDadosFiscaisMovimentosEncontrado.*,'
      
        '         CASE WHEN coalesce(m.quantidade,0)=0 THEN 0.00 ELSE (@(' +
        'm.valor/m.quantidade)) END as preco_custo,'
      
        '         coalesce((m.emestoque+m.reservado+m.transito+m.demonstr' +
        'acao+m.conserto+m.danificada),0) as qtemestoque'
      '  from'
      '  ('
      '   select ProdutosDadosFiscais.*,'
      '          coalesce(produtosdadosfiscais.movimento,'
      '          (select m.numero'
      '           from movimentos m'
      '           where m.produto=produtosdadosfiscais.produto'
      '             and m.filial=produtosdadosfiscais.filial'
      '             and m.financeiro<>0'
      '             and m.data <= produtosdadosfiscais.data'
      
        '           order by m.data desc, m.lancto desc limit 1 )) as num' +
        'eromovimento'
      '   from'
      '   ('
      '    select df.nome,'
      
        '           cast(cast(df.tipocliente as varchar)||cast(df.cliente' +
        ' as varchar) as varchar) as cliente,'
      '           df.vendedor,'
      '           pdf.produto,'
      '           pdf.filial,'
      '           df.numero as dadofiscal,'
      '           n.serie,'
      '           n.numero as notafiscal,'
      '           c.maquina,'
      '           c.intervensao,'
      '           c.numero as cupomfiscal,'
      '           df.data,'
      '           df.filialvenda, df.filialemissao,'
      '           pdf.quantidade,'
      '           pdf.precotabela as preco_pauta,'
      '           pdf.precovenda as preco_vista,'
      
        '           (((coalesce(df.desconto,0)*pdf.precovenda)/(df.valorv' +
        'ista+coalesce(df.desconto,0)))) as desconto,'
      
        '           ((((df.valortotal-df.valorvista)*pdf.precovenda)/(df.' +
        'valorvista+coalesce(df.desconto,0)))) as juros,'
      
        '           ((pdf.precovenda-((coalesce(df.desconto,0)*pdf.precov' +
        'enda)/(df.valorvista+coalesce(df.desconto,0)))+(((df.valortotal-' +
        'df.valorvista)*pdf.precovenda)/(df.valorvista+coalesce(df.descon' +
        'to,0)))))  as preco_prazo,'
      
        '           cast(DF.plano as varchar) as plano, pdf.icmsvalor, pd' +
        'f.movimento'
      ''
      '    from ((((DadosFiscais DF'
      '             JOIN ProdutosDadosFiscais PDF'
      '             ON DF.numero=PDF.dadofiscal)'
      ''
      '             JOIN contratos ct'
      '             ON ct.numero = df.contrato)'
      ''
      '             LEFT JOIN Notas N'
      '             ON DF.numero=N.dadofiscal)'
      ''
      '             LEFT JOIN Cupons C'
      '             ON DF.numero=C.dadofiscal)'
      ''
      '    WHERE DF.data BETWEEN (:DataInicial) AND (:DataFinal)'
      '      AND df.situacao NOT IN ('#39'C'#39','#39'D'#39')'
      
        '      and case when ct.os then ct.tipoequipamento in (1,2) else ' +
        'true end'
      '      AND ((EXISTS (SELECT vdf.dadofiscal'
      '                    FROM venctosdadosfiscais vdf'
      '                    WHERE vdf.dadofiscal=df.numero)) or'
      
        '                    (mod(df.codigofiscal,1000) in (101,102,103,1' +
        '04,105,929,401,402,403,404,405)))'
      ''
      '    %WhereFiliais'
      ''
      '    %WhereRegioes_df'
      ''
      '    %WhereProdutos'
      ''
      '    %WhereCliente'
      ''
      '    %WhereComMontagem_ou_SemMontagem'
      ''
      '    %WhereBrinde_ou_NaoBrinde'
      ''
      '   ) as ProdutosDadosFiscais'
      '  ) as ProdutosDadosFiscaisMovimentosEncontrado'
      '       left join movimentos m'
      
        '       on ProdutosDadosFiscaisMovimentosEncontrado.numeromovimen' +
        'to=m.numero'
      ' ) as ProdutosDadosFiscaisMovimentos'
      ''
      '      join (filiais f'
      '            left join (filiaisgruposfiliais fgf'
      '                       join gruposfiliais gf'
      '                       on fgf.grupo=gf.codigo)'
      '            on f.codigo=fgf.filial)'
      '      on ProdutosDadosFiscaisMovimentos.filialvenda=f.codigo'
      ''
      '      left join planos pl'
      
        '      on cast(ProdutosDadosFiscaisMovimentos.plano as integer)=p' +
        'l.codigo'
      ''
      '      left join usuarios u'
      '      on ProdutosDadosFiscaisMovimentos.vendedor=u.codigo'
      ''
      '      join (estoques e'
      '            join (produtos p'
      '                  join ((caracteristicas c'
      '                         join grupos g'
      '                         on c.grupo = g.codigo)'
      ''
      '                         join classes cl'
      '                         on c.classe=cl.codigo)'
      ''
      '                  on p.caracteristica = c.codigo)'
      ''
      '           on e.produto = p.codigo)'
      '       on ProdutosDadosFiscaisMovimentos.produto=e.produto and'
      '          ProdutosDadosFiscaisMovimentos.filial=e.filial'
      ''
      '       where true'
      ''
      '       %WhereEmLinha_ou_ForadeLinha'
      ''
      '       %Ordenacao'
      ''
      ')')
    RequestLive = False
    Left = 447
    Top = 280
    ParamData = <
      item
        DataType = ftString
        Name = 'DataInicial'
        ParamType = ptUnknown
        Value = '01/03/2005'
      end
      item
        DataType = ftString
        Name = 'DataFinal'
        ParamType = ptUnknown
        Value = '01/03/2005'
      end>
  end
  object qryDadosFiscaisProdutosDevolucoes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereDevolucoes'
        ParamType = ptUnknown
