  object frprlcustomercvendidas_: TfrxReport
    Version = '4.0.11'
    DataSet = frxDBcustomercvendidas__
    DataSetName = 'frxDBcustomercvendidas_'
    DotMatrixReport = False
    IniFile = '\Software\Fast Reports'
    PreviewOptions.Buttons = [pbPrint, pbLoad, pbSave, pbExport, pbZoom, pbFind, pbOutline, pbPageSetup, pbTools, pbEdit, pbNavigator, pbExportQuick]
    PreviewOptions.Zoom = 1.000000000000000000
    PrintOptions.Printer = 'Default'
    PrintOptions.PrintOnSheet = 0
    ReportOptions.CreateDate = 42460.379363900500000000
    ReportOptions.LastChange = 42468.503757905100000000
    ScriptLanguage = 'PascalScript'
    ScriptText.Strings = (
      'var'
      ' LINHA: INTEGER;'
      
        ' vTGPrecoaPrazo_d, vTGPrecoCusto_d, vTGMarkup_d, vpMargem_d : Cu' +
        'rrency;'
      
        ' vTGPrecoaPrazo_v, vTGPrecoCusto_v, vTGMarkup_v, vpMargem_v : Cu' +
        'rrency;'
      
        ' vTGPrecoaPrazo_g, vTGPrecoCusto_g, vTGMarkup_g, vpMargem_g : Cu' +
        'rrency;'
      '  vZebrar, vZebrar2 : boolean;'
      ''
      'procedure VendasOnBeforePrint(Sender: TfrxComponent);'
      'begin'
      '  LINHA := LINHA+1;'
      ''
      '  if vZebrar then'
      '  begin'
      '    mmoZebrado.color := <CordoZebrado>;'
      '    vZebrar := false;'
      '  end'
      '  else'
      '  begin'
      '    mmoZebrado.color := clwhite;'
      '    vZebrar := true;'
      '  end;'
      ''
      'end;'
      ''
      'procedure Page1OnBeforePrint(Sender: TfrxComponent);'
      'begin'
      '  vTGPrecoaPrazo_d := 0;'
      '  vTGPrecocUSTO_d := 0;'
      '  vTGMarkup_d := 0;'
      '  vpMargem_d := 0;'
      ''
      '  vTGPrecoaPrazo_v := 0;'
      '  vTGPrecocUSTO_v := 0;'
      '  vTGMarkup_v := 0;'
      '  vpMargem_v := 0;'
      ''
      '  vTGPrecoaPrazo_g := 0;'
      '  vTGPrecocUSTO_g := 0;'
      '  vTGMarkup_g := 0;'
      '  vpMargem_g := 0;'
      ''
      '  MasterData.visible:=true;'
      '  if <Totalizacao>=0 then'
      '  begin'
      '    MasterData.visible:=true;'
      '    GroupFooterGrupo.visible := false;'
      '  end'
      '  else'
      '  begin'
      '    MasterData.visible:=false;'
      '    GroupFooterGrupo.visible := true;'
      '  end;'
      ''
      '  if <AgruparGrupoFilial> then'
      '  begin'
      '     CabecalhoGrupoFilial.visible:=true;'
      '     RodapeGrupoFilial.visible:=true;'
      '  end'
      '  else'
      '  begin'
      '    CabecalhoGrupoFilial.visible:=false;'
      '    RodapeGrupoFilial.visible:=false;'
      '  end;'
      ''
      '  if <AgruparFilial> then'
      '  begin'
      '   CabecalhoFilial.visible:=true;'
      '   RodapeFilial.visible:=true;'
      '  end'
      '  else'
      '  begin'
      '    CabecalhoFilial.visible:=false;'
      '    RodapeFilial.visible:=false;'
      '  end;'
      ''
      '  if <AgruparConceito> then'
      '  begin'
      '   CabecalhoConceito.visible:=true;'
      '   RodapeConceito.visible:=true;'
      '  end'
      '  else'
      '  begin'
      '   CabecalhoConceito.visible:=false;'
      '   RodapeConceito.visible:=false;'
      '  end;'
      ''
      '  if <AgruparCliente> then'
      '  begin'
      '   CabecalhoCliente.visible:=true;'
      '   RodapeCliente.visible:=true;'
      '  end'
      '  else'
      '  begin'
      '   CabecalhoCliente.visible:=false;'
      '   RodapeCliente.visible:=false;'
      '  end;'
      ''
      
        '  if (<AgruparFilial>) and (<Ordenacao>=0) and (<Totalizacao>=3)' +
        ' then'
      '  begin'
      '    CabecalhoFilialEmissao.visible := true;'
      '    RodapeFilialEmissao.visible := true;'
      '  end'
      '  else'
      '  begin'
      '    CabecalhoFilialEmissao.visible := false;'
      '    RodapeFilialEmissao.visible := false;'
      '  end;'
      ''
      '  if <Totalizacao>=0 then'
      '  begin'
      '    if (<Ordenacao>=1) or (<Ordenacao>=2) then'
      '    begin'
      '      GroupHeaderGrupo.visible := true;'
      '      GroupFooterGrupo.visible := true;'
      '    end'
      '    else'
      '    begin'
      '      GroupHeaderGrupo.visible := false;'
      '      GroupFooterGrupo.visible := false;'
      '    end;'
      '  end'
      '  else'
      '    GroupHeaderGrupo.visible := false;'
      ''
      'end;'
      ''
      ''
      'procedure Memo54OnAfterData(Sender: TfrxComponent);'
      'begin'
      
        '  vTGPrecoaPrazo_v := SUM(IIF(<frxDBcustomercvendidas_."tipo">='#39 +
        'V'#39',<frxDBcustomercvendidas_."quantidade">*<frxDBcustomercvendida' +
        's_."preco_prazo">,0),MasterData,1);'
      '  if (vTGPrecoaPrazo_v<>0) and (vTGPrecoCusto_v<>0) then'
      '    vTGMarkup_v := ((vTGPrecoaPrazo_v/vTGPrecoCusto_v)-1)*100'
      '  else'
      '    vTGMarkup_v := 0;'
      ''
      '  if (vTGPrecoaPrazo_v<>0) then'
      
        '    vPMargem_v := ((vTGPrecoaPrazo_v-vTGPrecoCusto_v)/vTGPrecoaP' +
        'razo_v)*100'
      '  else'
      '    vPMargem_v := 0;'
      'end;'
      ''
      'procedure Memo42OnAfterData(Sender: TfrxComponent);'
      'begin'
      
        '  vTGPrecoCusto_v := SUM(IIF(<frxDBcustomercvendidas_."tipo">='#39'V' +
        #39',<frxDBcustomercvendidas_."quantidade">*<frxDBcustomercvendidas' +
        '_."preco_custo">,0),MasterData,1);'
      'end;'
      ''
      'procedure mmoTGPrecoCustoOnAfterData(Sender: TfrxComponent);'
      'begin'
      
        '  vTGPrecoCusto_d := SUM(IIF(<frxDBcustomercvendidas_."tipo">='#39'D' +
        #39',<frxDBcustomercvendidas_."quantidade">*<frxDBcustomercvendidas' +
        '_."preco_custo">,0),MasterData,1);'
      'end;'
      ''
      'procedure mmoTGPrecoaPrazoOnAfterData(Sender: TfrxComponent);'
      'begin'
      
        '  vTGPrecoaPrazo_d := SUM(IIF(<frxDBcustomercvendidas_."tipo">='#39 +
        'D'#39',<frxDBcustomercvendidas_."quantidade">*<frxDBcustomercvendida' +
        's_."preco_prazo">,0),MasterData,1);'
      '  if (vTGPrecoaPrazo_d<>0) and (vTGPrecoCusto_d<>0) then'
      '    vTGMarkup_d := ((vTGPrecoaPrazo_d/vTGPrecoCusto_d)-1)*100'
      '  else'
      '    vTGMarkup_d := 0;'
      ''
      '  if (vTGPrecoCusto_d<>0) then'
      
        '    vPMargem_d := ((vTGPrecoaPrazo_d-vTGPrecoCusto_d)/vTGPrecoaP' +
        'razo_d)*100'
      '  else'
      '    vPMargem_d := 0;'
      'end;'
      ''
      'procedure Memo44OnAfterData(Sender: TfrxComponent);'
      'begin'
      
        '  vTGPrecoCusto_g := SUM(<frxDBcustomercvendidas_."quantidade">*' +
        '<frxDBcustomercvendidas_."preco_custo">,MasterData,1);'
      'end;'
      ''
      'procedure GroupFooterGrupoOnBeforePrint(Sender: TfrxComponent);'
      'begin'
      '  if vZebrar2 then'
      '  begin'
      '    mmoZebrado2.color := <CordoZebrado>;'
      '    vZebrar2 := false;'
      '  end'
      '  else'
      '  begin'
      '    mmoZebrado2.color := clwhite;'
      '    vZebrar2 := true;'
      '  end;'
      'end;'
      ''
      'procedure Memo229OnAfterData(Sender: TfrxComponent);'
      'begin'
      
        '  vTGPrecoaPrazo_g := SUM(<frxDBcustomercvendidas_."quantidade">' +
        '*<frxDBcustomercvendidas_."preco_prazo">,MasterData,1);'
      '  if (vTGPrecoaPrazo_g<>0) and (vTGPrecoCusto_g<>0) then'
      '    vTGMarkup_g := ((vTGPrecoaPrazo_g/vTGPrecoCusto_g)-1)*100'
      '  else'
      '    vTGMarkup_g := 0;'
      ''
      '  if(vTGPrecoaPrazo_g<>0) then'
      
        '    vPMargem_g := ((vTGPrecoaPrazo_g-vTGPrecoCusto_g)/vTGPrecoaP' +
        'razo_g)*100'
      '  else'
      '    vPMargem_g := 0;'
      'end;'
      ''
      'begin'
      'end.')
