procedure Tdtmrelatoriocustomercadoriasvendidas.Selecionar(
  TipoPesquisa: TtecRelatorioVendas);
begin
  case TipoPesquisa of
  rvITEMPRODUTOSINICIAL    : RefazConsulta(qryItemProdutosInicial, [0], [qryConsultaItemProdutoscodigo.AsVariant]);
  rvITEMPRODUTOSFINAL      : RefazConsulta(qryItemProdutosFinal,   [0], [qryConsultaItemProdutoscodigo.AsVariant]);
  rvPRODUTOSINICIAL        : RefazConsulta(qryProdutosInicial, [0], [qryConsultaProdutoscodigo.AsVariant]);
  rvPRODUTOSFINAL          : RefazConsulta(qryProdutosFinal, [0], [qryConsultaProdutoscodigo.AsVariant]);
  rvGRUPOPRODUTOSINICIAL   : RefazConsulta(qryGrupoProdutosInicial, [0], [qryConsultaGrupoProdutoscodigo.AsVariant]);
  rvGRUPOPRODUTOSFINAL     : RefazConsulta(qryGrupoProdutosFinal, [0], [qryConsultaGrupoProdutoscodigo.AsVariant]);
  rvCLASSESINICIAL         : RefazConsulta(qryClassesInicial, [0], [qryConsultaClassescodigo.AsVariant]);
  rvCLASSESFINAL           : RefazConsulta(qryClassesFinal, [0], [qryConsultaClassescodigo.AsVariant]);
  rvCLIENTESINICIAL        : RefazConsulta(qryClienteInicial,[0,1],[qryConsultaClientescodigo.AsVariant, qryConsultaClientestipo.AsVariant]);
  rvCLIENTESFINAL          : RefazConsulta(qryClienteFinal,[0,1],[qryConsultaClientescodigo.AsVariant, qryConsultaClientestipo.AsVariant]);
  end;
end;

procedure Tdtmrelatoriocustomercadoriasvendidas.MontarOrdenacao;
var
Ordenacao: String;
begin
  Ordenacao:='';
  if FAgruparGrupoFilial then
    Ordenacao:=Ordenacao+', nomegrupofilialvenda, grupofilialvenda ';
  if FAgruparFilial then
  begin
    Ordenacao:=Ordenacao+', nomefilialvenda, filialvenda ';
    if (FOrdenacao = 0) and (FTotalizacao = 3) then
     Ordenacao := Ordenacao+', filialemissao, nomefilialemissao';
  end;

  if FAgruparConceito then
    Ordenacao:=Ordenacao+', descricaoconceito, conceito ';

  if FAgruparCliente then
    Ordenacao:=Ordenacao+', nome, cliente ';

  case FOrdenacao of
   0: Ordenacao:=Ordenacao+', data, serie, notafiscal, maquina, intervensao, cupomfiscal';
   1: Ordenacao:=Ordenacao+', data, classe, grupo, descricao, valorgrade1, valorgrade2, serie, notafiscal, maquina, intervensao, cupomfiscal';
   2: Ordenacao:=Ordenacao+', classe, grupo, descricao, valorgrade1, valorgrade2, data, serie, notafiscal, maquina, intervensao, cupomfiscal';
   3: Ordenacao:=Ordenacao+', vendedor, data, serie, notafiscal, maquina, intervensao, cupomfiscal';
  end;
//  qryrelatoriocustomercvendidas.sql[WhereOrdenacao] := 'Order by '+copy(Ordenacao,2,length(Ordenacao)-1);
 qryrelatoriocustomercvendidas.sql.Append('Order by '+copy(Ordenacao,2,length(Ordenacao)-1));
end;

