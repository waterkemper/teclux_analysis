procedure Tdtmrelatoriocustomercadoriasvendidas.SetParametroClienteFinal(
  const Value: String);
const
 SQLCliente =
  ' and (lpad(cast(df.cliente as varchar)||cast(df.tipocliente as varchar),11,''0'') '+
        ' in (Select lpad(cast(vf.codigo as varchar)||cast(vf.tipo as varchar),11,''0'')'+
            ' from vfornecedores vf '+
            ' where (%s)))';
 SQLClienteDev =
  ' and (lpad(cast(pnm.fornecedor as varchar)||cast(pnm.tipofornecedor as varchar),11,''0'') '+
        ' in (Select lpad(cast(vf.codigo as varchar)||cast(vf.tipo as varchar),11,''0'')'+
            ' from vfornecedores vf '+
            ' where (%s)))';
begin
 FParametroClienteFinal := Value;
 case FParametroSelecaoClientes of
  0: begin
      if (FParametroClienteInicial<>'') and
       (FParametroClienteFinal<>'') then
      begin
        {com contrato}
        qryDadosFiscaisProdutosVendas.sql[
         NumerodalinhanoTexto(qryDadosFiscaisProdutosVendas.sql, '%WhereCliente')+1]:=
           format(SQLCliente,[
           ' lpad(cast(vf.codigo as varchar)||cast(vf.tipo as varchar),11,''0'') between lpad(' +
           quotedstr(FParametroClienteInicial+qryClienteInicialtipo.AsString)+
           ' ,11, ''0'') and lpad('+quotedstr(FParametroClienteFinal+qryClienteFinaltipo.AsString)+',11,''0'')']);

