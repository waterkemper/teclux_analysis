const


FiltroFilialVenda      = ' AND ( df.filialvenda IN (%s)) ';
FiltroGrupoFilialVenda = ' AND ( df.filialvenda IN (SELECT filial '+
                                         'FROM filiaisgruposfiliais fgf '+
                                         'WHERE fgf.grupo IN (%s))) ';

FiltroFilialDev      = ' AND ( np.filial IN (%s)) ';
FiltroGrupoFilialDev = ' AND ( np.filial IN (SELECT filial '+
                                         'FROM filiaisgruposfiliais fgf '+
                                         'WHERE fgf.grupo IN (%s))) ';


FiltroRegioes_df  =
          'and (((SELECT regiao FROM bairros WHERE (estado,cidade,codigo)=(df.estado,df.cidade,df.bairro)) in (%s)) or '+
               '((SELECT regiao FROM cidades WHERE (estado,codigo)=(df.estado,df.cidade)) in (%s)))';

FiltroRegioes_ct  =
          'and (((SELECT regiao FROM bairros WHERE (estado,cidade,codigo)=(ct.estado,ct.cidade,ct.bairro)) in (%s)) or '+
               '((SELECT regiao FROM cidades WHERE (estado,codigo)=(ct.estado,ct.cidade)) in (%s)))';

FiltroRegioes_np  =
          'and (((SELECT regiao FROM bairros WHERE (estado,cidade,codigo)=(np.estado,np.cidade,np.bairro)) in (%s)) or '+
               '((SELECT regiao FROM cidades WHERE (estado,codigo)=(np.estado,np.cidade)) in (%s)))';

FiltroConceito    = ' AND ( %sconceito IN (%s)) ' +#13#10;



