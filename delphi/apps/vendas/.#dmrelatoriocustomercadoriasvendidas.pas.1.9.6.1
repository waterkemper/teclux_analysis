procedure Tdtmrelatoriocustomercadoriasvendidas.ImprimirRelatorio(
  tipo: String);
var
  Relatorio: TfrReport;
  frmPreview: TfrmPreviewPadrao;
begin
  frVariables['RAZAOFILIALBASE']  := RazaoFilialBase;
  frVariables['ENDERECO_BAIRRO']   := RuaFilialBase+ ' - '+BairroFilialBase;
  frVariables['CEP_CIDADE_UF']:= FormatarCEP(CEPFilialBase)+'  '+CidadeFilialBase+ '  '+ EstadoFilialBase;
  frVariables['Outras']:=FParametroCabecalho;
  frVariables['Titulo']:= tipo;
  frVariables['ImprimirPlano']:=FMostrarPlanos;
  frVariables['TipodeResumo']:=FTipodeResumo;
  frVariables['Ordenacao']:=FOrdenacao;
  frVariables['Totalizacao']:=FTotalizacao;
  frVariables['AgruparGrupoFilial']:=FAgruparGrupoFilial;
  frVariables['AgruparFilial']:=FAgruparFilial;
  frVariables['AgruparConceito']:=FAgruparConceito;
  frVariables['AgruparCliente']:=FAgruparCliente;
  frVariables['EmLinha']:=FprodutoEmLinha;
  frVariables['ForadeLinha']:=FprodutoForadeLinha;
  frVariables['ComMontagem']:=FProdutoComMontagem;
  frVariables['SemMontagem']:=FProdutoSemMontagem;
  frVariables['Brinde']:=FProdutoBrinde;
  frVariables['NaoBrinde']:=FProdutoNaoBrinde;
  frVariables['Vendas']:=FListarVendas;
  frVariables['Devolucoes']:= (FListarDevolucoesdoPeriodo or FListarDevolucoesAnteriores);
//  frprlcustomercvendidas.DesignReport;
  frmPreview := TfrmPreviewPadrao.create(self);
  try
   Relatorio := frmPreview.frCompositeReport;
   with frmPreview do
   begin
    frCompositeReport.Reports.Clear;
    Case FResumo of
     0: begin
         frCompositeReport.Reports.Add(frprlcustomercvendidas);
         frCompositeReport.Reports.Add(frprlcustomercvendidas_res);
        end;
     1: frCompositeReport.Reports.Add(frprlcustomercvendidas);
     2: frCompositeReport.Reports.Add(frprlcustomercvendidas_res);
    end;
   end;
   Relatorio.Preview := frmPreview.frPreviewPadrao;
//  frprlcustomercvendidas.DesignReport;

   Relatorio.ShowReport;

   frmPreview.ShowModal;

  finally

   frmPreview.Free

  end;

end;


procedure Tdtmrelatoriocustomercadoriasvendidas.SetDataFinal(
  const Value: String);
begin
  if value<>'' then
  begin
    FDataFinal := Value;
    if FDataInicial='' then
      FDataInicial:=FDataFinal;
  end
  else
   FDataFinal:=FDataInicial;
end;

procedure Tdtmrelatoriocustomercadoriasvendidas.SetProdutoForadeLinha(
  const Value: Boolean);
begin
  FprodutoForadeLinha := Value;
  if FprodutoEmLinha and FprodutoForadeLinha then
  begin
    {com contrato}
    qryDadosFiscaisProdutosVendas.Sql[
    NumerodalinhanoTexto(qryDadosFiscaisProdutosVendas.Sql,'%WhereEmLinha_ou_ForadeLinha')+1]:='';

    qryDadosFiscaisProdutosDevolucoes.Sql[
    NumerodalinhanoTexto(qryDadosFiscaisProdutosDevolucoes.Sql,'%WhereEmLinha_ou_ForadeLinha')+1]:='';

    {por frente de caixa}
    qryDadosFiscaisProdutosVendaFrenteCaixa.Sql[
    NumerodalinhanoTexto(qryDadosFiscaisProdutosVendaFrenteCaixa.Sql,'%WhereEmLinha_ou_ForadeLinha')+1]:='';

    qryDadosFiscaisProdutosDevolucoesFrenteCaixa.Sql[
    NumerodalinhanoTexto(qryDadosFiscaisProdutosDevolucoesFrenteCaixa.Sql,'%WhereEmLinha_ou_ForadeLinha')+1]:='';

  end
  else
  if FProdutoEmLinha then
  begin
    {com contrato}
    qryDadosFiscaisProdutosVendas.Sql[
    NumerodalinhanoTexto(qryDadosFiscaisProdutosVendas.Sql,'%WhereEmLinha_ou_ForadeLinha')+1]:=
      ' and p.foralinha is null';

    qryDadosFiscaisProdutosDevolucoes.Sql[
    NumerodalinhanoTexto(qryDadosFiscaisProdutosDevolucoes.Sql,'%WhereEmLinha_ou_ForadeLinha')+1]:=
      ' and p.foralinha is null';

    {por frente de caixa}
    qryDadosFiscaisProdutosVendaFrenteCaixa.Sql[
    NumerodalinhanoTexto(qryDadosFiscaisProdutosVendaFrenteCaixa.Sql,'%WhereEmLinha_ou_ForadeLinha')+1]:=
      ' and p.foralinha is null';

    qryDadosFiscaisProdutosDevolucoesFrenteCaixa.Sql[
    NumerodalinhanoTexto(qryDadosFiscaisProdutosDevolucoesFrenteCaixa.Sql,'%WhereEmLinha_ou_ForadeLinha')+1]:=
      ' and p.foralinha is null';
  end
  else
  if FprodutoForadeLinha then
  begin
    {com contrato}
    qryDadosFiscaisProdutosVendas.Sql[
    NumerodalinhanoTexto(qryDadosFiscaisProdutosVendas.Sql,'%WhereEmLinha_ou_ForadeLinha')+1]:=
      ' and p.foralinha is not null';

