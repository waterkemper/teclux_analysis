      '                               Conserto  + Danificada   +'
      '                                ReservaPrevia),0)=0 THEN 0'
      '           ELSE (financeiro/(EmEstoque + Reservado    +'
      '                               Transito  + Demonstracao +'
      '                               Conserto  + Danificada   +'
      
        '                                ReservaPrevia))*devolucoes.quant' +
        'idade'
      '           END)) as custodaclasse'
      ''
      ' from'
      ' ('
      ' select'
      ' ct.filialvenda as filial,'
