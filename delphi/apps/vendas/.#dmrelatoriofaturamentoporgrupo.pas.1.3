function TdtmRelatoriofaturamentoporgrupo.AbrirConsultasRelatorio: boolean;
var
Filtro: String;

begin
 Filtro:='';
 qryRelatorioFaturamentoPorGrupo.ParamByName('DataInicial').AsString:=FParametroDataInicial;
 qryRelatorioFaturamentoPorGrupo.ParamByName('DataFinal').AsString:=FParametroDataFinal;
 FParametroCabecalho:=FParametroCabecalho+'Entre: '+ FParametroDataInicial+' e '+FParametroDataFinal;
 qryRelatorioFaturamentoPorGrupo.ParamByName('AgruparFilial').AsBoolean:=FAgruparFilial;

 //FILIAIS
 if GrupoFiliais<>'' then
 begin
   if ParSistema.RelatorioSomenteFiliaisAutorizadas then
     qryRelatorioFaturamentoporGrupo.MacroByName('WhereFiliais').AsString :=
                Format(FiltroFilial,[Filiais])+ 'and' +
                Format(FiltroGrupoFilial,[GrupoFiliais])
   else
     qryRelatorioFaturamentoporGrupo.MacroByName('WhereFiliais').AsString :=
          Format(FiltroGrupoFilial,[GrupoFiliais])
 end
 else
 if Filiais<>'' then
   qryRelatorioFaturamentoporGrupo.MacroByName('WhereFiliais').AsString :=
        Format(FiltroFilial,[Filiais])
 else
   qryRelatorioFaturamentoporGrupo.MacroByName('WhereFiliais').AsString := '';

 //Produtos
 Filtro:=MontarFiltroProduto;
 qryRelatorioFaturamentoporGrupo.MacroByName('WhereProdutos').asstring := Filtro;

 //GRUPOS
 qryRelatorioFaturamentoporGrupo.MacroByName('WhereGrupos').asstring := FGrupos;

 //CLASSES
 qryRelatorioFaturamentoporGrupo.MacroByName('WhereClasses').asstring := FClasses;

 //VENDEDORES
 if(trim(FParametroVendedor)<>'') then
   Filtro:='AND pc.vendedor ='''+FParametroVendedor+''')'
 else
   Filtro :='';

 qryRelatorioFaturamentoporGrupo.macrobyname('WhereVendedor').asstring := Filtro;


 //FORNECEDORES
 if (trim(FParametroFornecedor)<>'') then
   Filtro:=' AND '''+FParametroFornecedor+''' IN (SELECT fornecedor FROM fornecedoresprodutos fp WHERE fp.caracteristica=c.codigo)'
 else
   Filtro:='';

 qryRelatorioFaturamentoporGrupo.MacroByName('WhereFornecedor').asstring:=Filtro;


// qryRelatorioFaturamentoporGrupo.Sql.SaveToFile('/home/jr/Desktop/teclux.sql');
// qryRelatorioFaturamentoporGrupo.Sql.SaveToFile('c:\teclux.sql');
 qryRelatorioFaturamentoporGrupo.Close;
 qryRelatorioFaturamentoporGrupo.Open;
 result := not qryRelatorioFaturamentoporGrupo.IsEmpty;
end;

