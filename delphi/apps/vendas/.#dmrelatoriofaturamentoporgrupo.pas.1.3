    pesFORNECEDORES : RefazConsulta(qryProcuraFornecedores, [0], [CodigoFornecedor]);
    pesVENDEDORES   : RefazConsulta(qryProcuraVendedores, [0], [Codigovendedor]);
  end;
end;

