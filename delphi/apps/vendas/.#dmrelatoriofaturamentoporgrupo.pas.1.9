function TdtmRelatoriofaturamentoporgrupo.MontarFiltroProduto: String;
var
 SQL : String;
begin
 if (trim(FParametroItem)<>'') then
 begin
        SQL:=' AND p.codigo = '+quotedstr(FParametroItem) ;
        FParametroCabecalho:=FParametroCabecalho+' Item Produto : '+FParametroItem;
 end
 else
   SQL:='';
 result := SQL;
end;

function TdtmRelatoriofaturamentoporgrupo.MontarParametroFornecedor: String;
var
 SQL : String;
begin
 SQL:=' c.codigo in (select fp.caracteristica '+
      '              from fornecedoresprodutos fp '+
      '              where fp.fornecedor = '+quotedstr(FParametroFornecedor)+
      '              order by fp.caracteristica) ';
 FParametroCabecalho:=FParametroCabecalho+' Fornecedor : '+FParametroFornecedor;
 result := SQL;
end;

function TdtmRelatoriofaturamentoporgrupo.GetListaClasses: TLista;
Var
  Ind: Integer;
begin
  FillChar(FListaClasses,SizeOf(FListaClasses),0);
  qryClasses.Open;
  SetLength(FListaClasses, qryClasses.RecordCount);
  Ind:= 0;
  while not qryClasses.Eof do begin
    FListaClasses[Ind].codigo   := qryClassescodigo.AsString;
    FListaClasses[Ind].descricao:= qryClassesdescricao.AsString;
    Inc(Ind);
    qryClasses.Next;
  end;
  qryClasses.Close;
  Result := FListaClasses;
end;

function TdtmRelatoriofaturamentoporgrupo.GetListaGrupos: TLista;
Var
  Ind: Integer;
begin
  FillChar(FListaGrupos,SizeOf(FListaGrupos),0);
  qryGrupos.Open;
  SetLength(FListaGrupos, qryGrupos.RecordCount);
  Ind:= 0;
  while not qryGrupos.Eof do begin
    FListaGrupos[Ind].codigo   := qryGruposcodigo.AsString;
    FListaGrupos[Ind].descricao:= qryGruposdescricao.AsString;
    Inc(Ind);
    qryGrupos.Next;
  end;
  qryGrupos.Close;
  Result := FListaGrupos;
end;

procedure TdtmRelatoriofaturamentoporgrupo.MontarFiltroClasses(
  Classe: TCheckListBox);
var
  STRClasses: String;
  Ind: Integer;
begin
  STRClasses := '';
  for Ind:= 0 to (Length(FListaClasses) - 1) do
    if Classe.Checked[Ind] then
      STRClasses := STRClasses + QuotedStr(FListaClasses[Ind].codigo) + ',';
  STRClasses := Copy(STRClasses, 0, Length(STRClasses) - 1);
  if STRClasses <> '' then
       FClasses:= 'and (c.classe in (' + STRClasses + '))'
  else
       FClasses:= '';
end;

procedure TdtmRelatoriofaturamentoporgrupo.MontarFiltroGrupos(
  Grupo: TCheckListBox);
var
  STRGrupos: String;
  Ind: Integer;
begin
  STRGrupos := '';
  for Ind:= 0 to (Length(FListaGrupos) - 1) do
    if Grupo.Checked[Ind] then
      STRGrupos := STRGrupos + QuotedStr(FListaGrupos[Ind].codigo) + ',';
  STRGrupos := Copy(STRGrupos, 0, Length(STRGrupos) - 1);
  if STRGrupos <> '' then
       FGrupos:= 'and (c.grupo in (' + STRGrupos + '))'
  else
       FGrupos:= '';
end;



procedure TdtmRelatoriofaturamentoporgrupo.SetDevolucoesPeriodoAnterior(const Value: Boolean);
const
 SQLDevolucoesPeriodoAnterior = 'and ct.faturamento < :DataInicial';
 SQLDevolucoesPeriodoSelecionado = 'and ct.faturamento between (:DataInicial) and (:DataFinal)';

 SQLDevolucoesPeriodoAnteriorNotasPag = 'and np.data < :DataInicial';
 SQLDevolucoesPeriodoSelecionadoNotasPag = 'and np.data between (:DataInicial) and (:DataFinal)';


begin
  FDevolucoesPeriodoAnterior := Value;

  qryRelatorioFaturamentoporGrupo.Sql[NumerodalinhanoTexto(qryRelatorioFaturamentoporGrupo.Sql,'/*Inicio Devolucoes*/')]:='/*Inicio Devolucoes*/';
  qryRelatorioFaturamentoporGrupo.Sql[NumerodalinhanoTexto(qryRelatorioFaturamentoporGrupo.Sql,'/*Final Devolucoes*/')]:='/*Final Devolucoes*/';
  qryRelatorioFaturamentoporGrupo.Sql[NumerodalinhanoTexto(qryRelatorioFaturamentoporGrupo.Sql,'/*Inicio Total Devolucoes*/')]:='/*Inicio Total Devolucoes*/';
  qryRelatorioFaturamentoporGrupo.Sql[NumerodalinhanoTexto(qryRelatorioFaturamentoporGrupo.Sql,'/*Final Total Devolucoes*/')]:='/*Final Total Devolucoes*/';

  if FDevolucoesPeriodoAnterior and FDevolucoesPeriodoSelecionado then
  begin
    qryRelatorioFaturamentoporGrupo.MacroByName('WhereDevolucoes').AsString := '';
    qryRelatorioFaturamentoporGrupo.MacroByName('WhereDevolucoesNotasPag').AsString := '';
  end
  else
   if FDevolucoesPeriodoAnterior then
   begin
     qryRelatorioFaturamentoporGrupo.MacroByName('WhereDevolucoes').AsString := SQLDevolucoesPeriodoAnterior;
     qryRelatorioFaturamentoporGrupo.MacroByName('WhereDevolucoesNotasPag').AsString := SQLDevolucoesPeriodoAnteriorNotasPag;
   end
   else
   if FDevolucoesPeriodoSelecionado then
   begin
      qryRelatorioFaturamentoporGrupo.MacroByName('WhereDevolucoes').AsString := SQLDevolucoesPeriodoSelecionado;
      qryRelatorioFaturamentoporGrupo.MacroByName('WhereDevolucoesNotasPag').AsString := SQLDevolucoesPeriodoSelecionadoNotasPag;
   end
   else
   begin
     qryRelatorioFaturamentoporGrupo.Sql[NumerodalinhanoTexto(qryRelatorioFaturamentoporGrupo.Sql,'/*Inicio Devolucoes*/')]:='/*Inicio Devolucoes';
     qryRelatorioFaturamentoporGrupo.Sql[NumerodalinhanoTexto(qryRelatorioFaturamentoporGrupo.Sql,'/*Final Devolucoes*/')]:='Final Devolucoes*/';
     qryRelatorioFaturamentoporGrupo.Sql[NumerodalinhanoTexto(qryRelatorioFaturamentoporGrupo.Sql,'/*Inicio Total Devolucoes*/')]:='/*Inicio Total Devolucoes';
     qryRelatorioFaturamentoporGrupo.Sql[NumerodalinhanoTexto(qryRelatorioFaturamentoporGrupo.Sql,'/*Final Total Devolucoes*/')]:='Final Total Devolucoes*/';
   end;
end;


procedure TdtmRelatoriofaturamentoporgrupo.frpRelatorioFaturamentoporGrupoBeforePrint(
  Memo: TStringList; View: TfrView);
begin
  inherited;
  if View.Name = 'fpvLogo' then
  begin
   if FileExists(LogotipoFilialBase) then
     try TfrPictureView(View).Picture.LoadFromFile(LogotipoFilialBase) except end;
  end
  else
  if TColor(strtoint(parsistema.CorZebradoRelatorio))<>TColor(clnone) then
   if (View.Name = 'mmoZebrado') then
    if (frpRelatorioFaturamentoporGrupo.Dictionary.Variables.Variable['LINHA'] MOD 2)=0 then
      frpRelatorioFaturamentoporGrupo.FindObject('mmoZebrado').FillColor := TColor(strtoint(parsistema.CorZebradoRelatorio))
    else
      frpRelatorioFaturamentoporGrupo.FindObject('mmoZebrado').FillColor := clnone;

end;

procedure TdtmRelatoriofaturamentoporgrupo.SetOrdenacao(
  const Value: Integer);
var
 Ordenacao : String;
begin
  Ordenacao:='';
  if AgruparFilial then
    Ordenacao:=Ordenacao+', filial, nomefilial ';
  if AgruparClasse then
    Ordenacao:=Ordenacao+', codigoclasse';

  case Value of
    0: Ordenacao:= Ordenacao + ', percentualmargem DESC, percentuallucro DESC, codigogrupo';
    1: Ordenacao:= Ordenacao + ', percentuallucro DESC, percentualmargem DESC, codigogrupo';
    2: Ordenacao:= Ordenacao + ', percentual DESC, percentuallucro DESC, percentualmargem DESC, codigogrupo';
    3: Ordenacao:= Ordenacao + ', quantidade DESC, percentuallucro DESC, percentualmargem DESC, codigogrupo';
    4: Ordenacao:= Ordenacao + ', codigogrupo, percentual DESC, percentuallucro DESC, percentualmargem DESC';
  end;
  qryRelatorioFaturamentoporGrupo.MacroByName('Ordenacao').asstring :='Order by '+copy(Ordenacao,2,length(Ordenacao)-1);
end;

