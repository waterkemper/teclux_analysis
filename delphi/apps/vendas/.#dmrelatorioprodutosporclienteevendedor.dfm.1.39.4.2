        ' and not coalesce(ct.os_cortesia,false) else true end'
      ''
      '             %Devolucoes'
      ''
      '             %NCMIsentoPISCOFINS'
      ''
      '             %ProdutosComNFEmitida_Devolvido'
      ''
      
        '   ) as devolucoes left join clientesprodutos cp on devolucoes.c' +
        'liente = cp.cliente'
      
        '                                             and devolucoes.tipo' +
        'cliente = cp.tipocliente'
