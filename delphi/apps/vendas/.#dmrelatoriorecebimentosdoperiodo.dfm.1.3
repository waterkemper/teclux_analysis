    Sql.Strings = (
      ' select resultado.* from'
      ' ('
      '  %Inicio_Recebimentos_por_Contrato'
      '   select contratosparcelas.*,'
      
        '          case when datapagto is not null then valorpagto - (cal' +
        'cularJuros(valorvencto, datavencto, DataPagto)+valorvencto) else' +
        ' cast(null as numeric) end as diferencas'
      '   from'
      '   ('
      '    select contratosparcelas.*,'
      '           fv.nome as nomefilialvenda,'
      '           fgfv.grupo as grupofilialvenda,'
      '           gfv.descricao as nomegrupofilialvenda'
      
        '    from (filiais fv left join (filiaisgruposfiliais fgfv left j' +
        'oin gruposfiliais gfv on fgfv.grupo=gfv.codigo) on fv.codigo=fgf' +
        'v.filial),'
      '    ('
      '     select  c.agente,'
      '          c.filialvenda,'
      '          c.cliente,'
      '          c.nome as nomecliente,'
      '          c.tipocliente,'
      '          case when exists (select p1.numero'
      '                            from parcelas p1'
      '            '#9#9'    where p1.contrato=p.contrato'
      
        #9#9#9'     and (p1.datapagto is null or p1.datapagto>(:DataFinal)))' +
        ' then'
      '            cast(0 as integer)'
      '          else'
      '           (case when p.numero =(select max(p1.numero)'
      '     '#9'                         from parcelas p1'
      #9#9'                 where p1.contrato = p.contrato'
      
        '                                 and p1.datapagto between :DataI' +
        'nicial and :DataFinal'
      
        #9#9#9#9' and (p1.tipopagto is null or p1.tipopagto in ('#39'P'#39','#39'X'#39','#39'D'#39','#39 +
        'C'#39','#39'R'#39')))  then'
      '             cast(1 as integer) else cast(0 as integer) end)'
      '          end as contratoquitado,'
      '          p.contrato,'
      '          p.datavencto,'
      
        '          case when p.datapagto between (:DataInicial) and (:Dat' +
        'aFinal) then p.valorvencto else cast(null as numeric) end as val' +
        'orvencto,'
      '          p.filialpagto,'
      '          p.nomefilialpagto,'
      '          p.grupofilialpagto,'
      '          p.nomegrupofilialpagto,'
      '          p.parcelaorigem,'
      '          p.parcelaadicional,'
      '          p.pagamentoextracaixa,'
      #9'  p.formapagamento,'
      
        '          case when pagamentoextracaixa then cast('#39'B'#39'||coalesce(' +
        'p.tipopagto,'#39#39') as varchar) else cast(coalesce(p.tipopagto,'#39#39') a' +
        's varchar)  end as tipopagtodefinido,'
      
        '          case when p.datapagto between (:DataInicial) and (:Dat' +
        'aFinal) then p.datapagto else cast(null as date) end as datapagt' +
        'o,'
      
        '          case when p.datapagto between (:DataInicial) and (:Dat' +
        'aFinal) then p.valorpagto else cast(null as numeric) end as valo' +
        'rpagto,'
      
        '          case when p.datapagto between (:DataInicial) and (:Dat' +
        'aFinal) and p.valorpagto>p.valorvencto then p.valorpagto-p.valor' +
        'vencto else cast(null as numeric) end as juros,'
      
        '          case when p.datapagto between (:DataInicial) and (:Dat' +
        'aFinal) and p.valorpagto<p.valorvencto then p.valorpagto-p.valor' +
        'vencto else cast(null as numeric) end as desconto,'
      
        '          case when p.devcaixa between (:DataInicial) and (:Data' +
        'Final) then p.devcaixa else'
      
        '          (case when p.deventrada between (:DataInicial) and (:D' +
        'ataFinal) then p.deventrada else cast(null as date) end) end as ' +
        'dev_caixa_entrada,'
      
        '          - case when p.devcaixa between    (:DataInicial) and (' +
        ':DataFinal) and p.tipopagto in ('#39'X'#39','#39'C'#39') then p.valorpagto else ' +
        'cast(null as numeric) end as valorextorno,'
      
        '          - case when p.deventrada between (:DataInicial) and (:' +
        'DataFinal) and p.tipopagto in ('#39'P'#39','#39'D'#39') then p.valorpagto else c' +
        'ast(null as numeric) end as valorpendente,'
      #9'  notas_notasdocontrato(c.numero) as notas'
      '     from contratos c,'
      '                   ('
      #9#9'    select parcelas.*,'
      '                           fp.nome as nomefilialpagto,'
      '                           fgfp.grupo as grupofilialpagto,'
      '                           gfp.descricao as nomegrupofilialpagto'
      
        '                    from (filiais fp left join (filiaisgruposfil' +
        'iais fgfp left join gruposfiliais gfp on fgfp.grupo=gfp.codigo) ' +
        'on fp.codigo=fgfp.filial),'
      #9#9'     ('
      #9#9'      select contrato,'
      #9#9'             numero,'
      '                             datavencto,'
      '                             valorvencto,'
      #9'                     datapagto,'
      '                             valorpagto,'
      '       '#9'                     deventrada,'
      '                             devcaixa,'
      #9'                     tipopagto, formapagamento,'
      '                             filialpagto,'
      '                             parcelaorigem,'
      '                             pagamentoextracaixa,'
      '                             parcelaadicional'
      '                      from parcelas'
      
        '                      where (datapagto between (:DataInicial) an' +
        'd (:DataFinal) or deventrada between (:DataInicial) and (:DataFi' +
        'nal) or devcaixa between (:DataInicial) and (:DataFinal))'
      
        '                       and (tipopagto is null or tipopagto in ('#39 +
        'P'#39','#39'X'#39','#39'D'#39','#39'C'#39','#39'R'#39'))'
      '                         %FilialPagto'
      '                         %SituacaoParcelas'
      '                     ) as parcelas'
      '                    where fp.codigo=parcelas.filialpagto'
      #9'           ) as p'
      '     where c.numero=p.contrato'
      '     %ClienteContrato'
      '     %filiaisContrato'
      '     %Agentes'
      '     %Conceito'
      '     %TipodeContrato'
      '     %TipodeVenda'
      ''
      '    ) as contratosparcelas'
      '      where fv.codigo=contratosparcelas.filialvenda'
      '   ) as contratosparcelas'
      '  %Final_Recebimentos_por_Contrato'
      '  union all'
      '  %Inicio_Recebimentos_por_Frente_de_Caixa'
      '  select  df.agente,'
      '          df.filialvenda,'
      '          df.cliente,'
      
        '          coalesce((select coalesce(vf.razao,vf.nome) from vforn' +
        'ecedores vf where vf.codigo = df.cliente and vf.tipo=df.tipoclie' +
        'nte),cast('#39'FRENTE DE CAIXA'#39' as varchar)) as nomecliente,'
      '          df.tipocliente,'
      #9'  cast(1 as integer) as contratoquitado,'
      '          cast(null as varchar(20)) as contrato,'
      '          df.data as datavencto,'
      
        '          case when df.data between (:DataInicial) and (:DataFin' +
        'al) then df.valortotal else 0.00 end as valorvencto,'
      '          df.filialvenda as filialpagto,'
      '          f.nome as nomefilialpagto,'
      '          fgf.grupo as grupofilialpagto,'
      '          gf.descricao as nomegrupofilialpagto,'
      '          cast(null as varchar(7)) as parcelaorigem,'
      '          false as parcelaadicional,'
      '          false as pagamentoextracaixa,'
      #9'  cast(null as varchar(1)) as formapagamento,'
      '          cast(null as varchar) as tipopagtodefinido,'
      
        '          case when df.data between (:DataInicial) and (:DataFin' +
        'al) then df.data else cast(null as date) end as datapagto,'
      
        '          case when df.data between (:DataInicial) and (:DataFin' +
        'al) then df.valortotal else 0.00 end as valorpagto,'
      
        '          case when df.data between (:DataInicial) and (:DataFin' +
        'al) and df.valortotal>df.valorvista then df.valortotal-df.valorv' +
        'ista else 0.00 end as juros,'
      
        '          case when df.data between (:DataInicial) and (:DataFin' +
        'al) and df.desconto<>0 then df.desconto else 0.00 end as descont' +
        'o,'
      '          cast(null as date) as dev_caixa_entrada,'
      '          0.00 as valorextorno,'
      '          0.00 as valorpendente,'
      '  '#9'  cast(null as varchar) as notas,'
      '          f.nome as nomefilialvenda,'
      '          fgf.grupo as grupofilialvenda,'
      '          gf.descricao as nomegrupofilialvenda,'
      '          0.00 as diferencas'
      
        'From (dadosfiscais df join (filiais f join (filiaisgruposfiliais' +
        ' fgf join gruposfiliais gf on fgf.grupo=gf.codigo) on f.codigo=f' +
        'gf.filial) on df.filialvenda = f.codigo)'
      
        'Where (df.data between (:datainicial) and (:datafinal)) and df.c' +
        'ontrato is null'
      '          and df.situacao='#39'N'#39' and'
      
        '             ((EXISTS (SELECT vdf.dadofiscal FROM venctosdadosfi' +
        'scais vdf WHERE vdf.dadofiscal=df.numero)) or'
      
        '              (mod(df.codigofiscal,1000) in (102,103,104,105,929' +
        ')))'
      '  and not coalesce(df.notavinculada,false)              '
      ''
      '  %ClienteFrenteCaixa'
      '  %FiliaisFrenteCaixa'
      '  %Agentes'
      '  %Conceito'
      ''
      '%Final_Recebimentos_por_Frente_de_Caixa'
      ''
      ') as resultado'
      '%Ordenacao')
    RequestLive = False
    Left = 336
    Top = 32
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'DataFinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataInicial'
        ParamType = ptUnknown
      end>
