        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';SELECT * FROM'
      '('
      'select grupofilialvenda,'
      '       nomegrupofilialvenda,'
      '       filialvenda,'
      '       nomefilialvenda,'
      '       grupofilialpagto,'
      '       nomegrupofilialpagto,'
      '       filialpagto,'
      '       nomefilialpagto,'
      '       datapagto,'
      '       formapagamento,'
      '       sum(valorvencto) as valorvencto,'
      '       sum(valorpagto) as valorpagto,'
      '       sum(juros) as juros,'
      '       sum(desconto) as desconto,'
      '       sum(valorextorno) as valorextorno,'
      '       sum(valorpendente) as valorpendente,'
      '       sum(diferencas) as diferencas,'
      '       sum(contratoquitado) as contratoquitado,'
      '       sum(1) as nparcelas'
      'from'
      '('
      
        'select case when :AgruparGrupoFilial and (:FilialExibicao=1) the' +
        'n grupofilialvenda else cast(null as integer) end as grupofilial' +
        'venda,'
      
        '       case when :AgruparGrupoFilial and (:FilialExibicao=1) the' +
        'n nomegrupofilialvenda else cast(null as varchar) end as nomegru' +
        'pofilialvenda,'
      
        '       case when :AgruparFilial and (:FilialExibicao=1) then fil' +
        'ialvenda else cast(null as integer) end as filialvenda,'
      
        '       case when :AgruparFilial and (:FilialExibicao=1) then nom' +
        'efilialvenda else cast(null as varchar) end as nomefilialvenda,'
      
        '       case when :AgruparGrupoFilial and (:FilialExibicao=0) the' +
        'n grupofilialpagto else cast(null as integer) end as grupofilial' +
        'pagto,'
      
        '       case when :AgruparGrupoFilial and (:FilialExibicao=0) the' +
        'n nomegrupofilialpagto else cast(null as varchar) end as nomegru' +
        'pofilialpagto,'
      
        '       case when :AgruparFilial and (:FilialExibicao=0) then fil' +
        'ialpagto else cast(null as integer) end as filialpagto,'
      
        '       case when :AgruparFilial and (:FilialExibicao=0) then nom' +
        'efilialpagto else cast(null as varchar) end as nomefilialpagto,'
      
        '       case when :AgruparDataPagto then datapagto else cast(null' +
        ' as date) end as datapagto,'
      '       valorvencto,'
      '       valorpagto,'
      '       formapagamento,'
      '       juros,'
      '       desconto,'
      '       valorextorno,'
      '       valorpendente,'
      '       contratoquitado,'
      
        '       case when datapagto is not null then valorpagto - (calcul' +
        'arJuros(valorvencto, datavencto, DataPagto)+valorvencto) else ca' +
        'st(null as numeric) end as diferencas'
      'from'
      '('
      ' %Inicio_Recebimentos_por_Contrato'
      ' select contratosparcelas.*,'
      '        fv.nome as nomefilialvenda,'
      '        fgfv.grupo as grupofilialvenda,'
      '        gfv.descricao as nomegrupofilialvenda'
      
        ' from (filiais fv left join (filiaisgruposfiliais fgfv left join' +
        ' gruposfiliais gfv on fgfv.grupo=gfv.codigo) on fv.codigo=fgfv.f' +
        'ilial),'
      ' ('
      '  select'
      '          c.filialvenda,'
      '          case when exists (select p1.numero'
      '                            from parcelas p1'
      '            '#9#9'    where p1.contrato=p.contrato'
      
        #9#9#9'     and (p1.datapagto is null or p1.datapagto>(:DataFinal)))' +
        ' then'
      '            cast(0 as integer)'
      '          else'
      '           (case when p.numero =(select max(p1.numero)'
      '     '#9'                         from parcelas p1'
      #9#9'                 where p1.contrato = p.contrato'
      
        '                                 and p1.datapagto between :DataI' +
        'nicial and :DataFinal'
      
        #9#9#9#9' and (p1.tipopagto is null or p1.tipopagto in ('#39'P'#39','#39'X'#39','#39'D'#39','#39 +
        'C'#39','#39'R'#39')))  then'
      '             cast(1 as integer) else cast(0 as integer) end)'
      '          end as contratoquitado,'
      
        '          case when p.datapagto between (:DataInicial) and (:Dat' +
        'aFinal) then p.valorvencto else cast(null as numeric) end as val' +
        'orvencto,'
      '          p.datavencto,'
      '          p.filialpagto,'
      '          p.nomefilialpagto,'
      '          p.grupofilialpagto,'
      '          p.nomegrupofilialpagto,'
      
        '          case when p.datapagto between (:DataInicial) and (:Dat' +
        'aFinal) then p.datapagto else cast(null as date) end as datapagt' +
        'o,'
      
        '          case when p.datapagto between (:DataInicial) and (:Dat' +
        'aFinal) then p.valorpagto else cast(null as numeric) end as valo' +
        'rpagto,'
      '          p.formapagamento,'
      
        '          case when p.datapagto between (:DataInicial) and (:Dat' +
        'aFinal) and p.valorpagto>p.valorvencto then p.valorpagto-p.valor' +
        'vencto else cast(null as numeric) end as juros,'
      
        '          case when p.datapagto between (:DataInicial) and (:Dat' +
        'aFinal) and p.valorpagto<p.valorvencto then p.valorpagto-p.valor' +
        'vencto else cast(null as numeric) end as desconto,'
      
        '          - case when p.devcaixa between    (:DataInicial) and (' +
        ':DataFinal) and p.tipopagto in ('#39'X'#39','#39'C'#39') then p.valorpagto else ' +
        'cast(null as numeric) end as valorextorno,'
      
        '          - case when p.deventrada between (:DataInicial) and (:' +
        'DataFinal) and p.tipopagto in ('#39'P'#39','#39'D'#39') then p.valorpagto else c' +
        'ast(null as numeric) end as valorpendente'
      '  from contratos c,'
      '                   ('
      #9#9'    select parcelas.*,'
      '                           fp.nome as nomefilialpagto,'
      '                           fgfp.grupo as grupofilialpagto,'
      '                           gfp.descricao as nomegrupofilialpagto'
      
        '                    from (filiais fp left join (filiaisgruposfil' +
        'iais fgfp left join gruposfiliais gfp on fgfp.grupo=gfp.codigo) ' +
        'on fp.codigo=fgfp.filial),'
      #9#9'     ('
      #9#9'      select contrato,'
      #9#9'             numero,'
      '                             valorvencto,'
      '                             datavencto,'
      #9'                     datapagto,'
      '                             valorpagto,'
      '                             formapagamento,'
      '       '#9'                     deventrada,'
      '                             devcaixa,'
      #9'                     tipopagto,'
      '                             filialpagto'
      '                      from parcelas'
      
        '                      where (datapagto between (:DataInicial) an' +
        'd (:DataFinal) or deventrada between (:DataInicial) and (:DataFi' +
        'nal) or devcaixa between (:DataInicial) and (:DataFinal))'
      
        '                       and (tipopagto is null or tipopagto in ('#39 +
        'P'#39','#39'X'#39','#39'D'#39','#39'C'#39','#39'R'#39'))'
      '                         %FilialPagto'
      #9#9#9' %SituacaoParcelas'
      '                     ) as parcelas'
      '                    where fp.codigo=parcelas.filialpagto'
      #9'           ) as p'
      ' where c.numero=p.contrato'
      
        ' and case when c.os then c.tipoequipamento in (1,2) else true en' +
        'd'
      ''
      '  %ClienteContrato'
      '  %filiaisContrato'
      '  %Agentes'
      '  %Conceito'
      '  %TipodeContrato'
      '  %TipodeVenda'
      ''
      ' ) as contratosparcelas'
      '   where fv.codigo=contratosparcelas.filialvenda'
      '  %Final_Recebimentos_por_Contrato'
      '  union all'
      '  %Inicio_Recebimentos_por_Frente_de_Caixa'
      '  select  df.filialvenda,'
      '          cast(1 as integer) as contratoquitado,'
      
        '          case when df.data between (:DataInicial) and (:DataFin' +
        'al) then df.valortotal else 0.00 end as valorvencto,'
      '          df.data as datavencto,'
      '          df.filialvenda as filialpagto,'
      '          f.nome as nomefilialpagto,'
      '          fgf.grupo as grupofilialpagto,'
      '          gf.descricao as nomegrupofilialpagto,'
      
        '          case when df.data between (:DataInicial) and (:DataFin' +
        'al) then df.data else cast(null as date) end as datapagto,'
      
        '          case when df.data between (:DataInicial) and (:DataFin' +
        'al) then df.valortotal else 0.00 end as valorpagto,'
      '          cast(null as varchar(1)) as formapagamento,'
      
        '          case when df.data between (:DataInicial) and (:DataFin' +
        'al) and df.valortotal>df.valorvista then df.valortotal-df.valorv' +
        'ista else 0.00 end as juros,'
      
        '          case when df.data between (:DataInicial) and (:DataFin' +
        'al) and df.desconto<>0 then df.desconto else 0.00 end as descont' +
        'o,'
      '          0.00 as valorextorno,'
      '          0.00 as valorpendente,'
      '          f.nome as nomefilialvenda,'
      '          fgf.grupo as grupofilialvenda,'
      '          gf.descricao as nomegrupofilialvenda'
      ''
      
        'From (dadosfiscais df join (filiais f join (filiaisgruposfiliais' +
        ' fgf join gruposfiliais gf on fgf.grupo=gf.codigo) on f.codigo=f' +
        'gf.filial) on df.filialvenda = f.codigo)'
      
        'Where (df.data between (:datainicial) and (:datafinal)) and df.c' +
        'ontrato is null'
      '          and df.situacao='#39'N'#39' and'
      
        '             ((EXISTS (SELECT vdf.dadofiscal FROM venctosdadosfi' +
        'scais vdf WHERE vdf.dadofiscal=df.numero)) or'
      
        '              (mod(df.codigofiscal,1000) in (102,103,104,105,929' +
        ')))'
      '  and not coalesce(df.notavinculada,false)'
      ''
      '  %ClienteFrenteCaixa'
      '  %FiliaisFrenteCaixa'
      '  %Agentes'
      '  %Conceito'
      ''
      '%Final_Recebimentos_por_Frente_de_Caixa'
      ''
      ') as parcelas'
      ''
      ') as parcelas'
      
        '  group by nomegrupofilialvenda, grupofilialvenda, nomefilialven' +
        'da, filialvenda,'
      
        '           nomegrupofilialpagto, grupofilialpagto, nomefilialpag' +
        'to, filialpagto,'
      '           datapagto, formapagamento'
      ') as rp'
      ''
      
        'ORDER BY UPPER(TO_ASCII(rp.NomeGrupoFilialVenda,'#39'LATIN1'#39')), rp.G' +
        'rupoFilialVenda,'
      
        '         UPPER(TO_ASCII(rp.NomeFilialVenda,'#39'LATIN1'#39')), rp.Filial' +
        'Venda,'
      
        '         UPPER(TO_ASCII(rp.NomeGrupoFilialPagto,'#39'LATIN1'#39')), rp.G' +
        'rupoFilialPagto,'
      
        '         UPPER(TO_ASCII(rp.NomeFilialPagto,'#39'LATIN1'#39')), rp.Filial' +
        'Pagto,'
      '         rp.DataPagto, rp.FormaPagamento')
    RequestLive = False
    Left = 336
    Top = 160
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'AgruparGrupoFilial'
        ParamType = ptUnknown
      end
      item
