procedure TdtmrelatorioresumodeVendaseRecebimentos.GerarRelatorio;
var
 i:integer;
begin
  if FResumo <> 2 then
    refazconsulta(qryImprimirCaixa,[],[]);

  if FResumo <> 1 then
  begin
    for i:=0 to qryimprimircaixa.MacroCount-1 do
      qryImprimirCaixaAcumulado.Macros[i].AsString := qryImprimirCaixa.Macros[i].AsString;
    refazconsulta(qryImprimirCaixaAcumulado,[],[]);
  end;

  if (((FResumo <> 2) and not (qryImprimirCaixa.IsEmpty)) or
      ((FResumo <> 1) and not (qryImprimirCaixaAcumulado.IsEmpty))) then
    ImprimirRelatorio('VENDAS E RECEBIMENTOS')
  else
    MensagemAviso(Format(ctNENHUMREGISTROENCONTRADO,['Registro']));
end;

