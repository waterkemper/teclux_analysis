begin
  FListaAgentes.Free;
  FListaConceitos.Free;
  inherited;
end;

procedure TdtmrelatorioresumodeVendaseRecebimentos.MontarFiltroAgentes(Usar: TCheckListBox);
var
  STRAgentes: String;
  TodosAgentes: Boolean;
  cnt: Integer;
begin
  TodosAgentes:=true;
  STRAgentes := '';
  for cnt := 0 to FListaAgentes.Count - 1 do
    if Usar.Checked[cnt] then
      STRAgentes := STRAgentes + '''' + IntToStr(Integer(FListaAgentes.Objects[cnt])) + ''','
    else
      TodosAgentes:=false;

  STRAgentes := Copy(STRAgentes, 0, Length(STRAgentes) - 1);
  AtribuirFiltroAgentes('');
  if Trim(STRAgentes) <> '' then
    if not TodosAgentes then
      AtribuirFiltroAgentes(Format(FiltroAgente,[STRAgentes]));
end;

