implementation
 const 

 // Filtros
  FiltroFilial_Pagto      = ' and ( filialpagto in (%s)) ' + #13#10;
  FiltroGrupoFilial_Pagto = ' and ( filialpagto in (Select filial ' + #13#10     +
                                         'From filiaisgruposfiliais fgf ' + #13#10 +
                                         'Where fgf.grupo in (%s))) ';
  FiltroFilial_Dev      = ' and ( coalesce(devfilial,filialpagto) in (%s)) ' + #13#10;
  FiltroGrupoFilial_Dev = ' and ( coalesce(devfilial,filialpagto) in (Select filial ' + #13#10     +
                                         'From filiaisgruposfiliais fgf ' + #13#10 +
                                         'Where fgf.grupo in (%s))) ';

  FiltroFilial_Venda      = ' and ( filialvenda in (%s)) ' + #13#10;
  FiltroGrupoFilial_Venda = ' and ( filialvenda in (Select filial ' + #13#10   +
                                         'From filiaisgruposfiliais fgf '+ #13#10 +
                                         'Where fgf.grupo in (%s))) ';
  FiltroConceito          = ' and ( conceito in (%s)) ' + #13#10;
  FiltroAgente            = ' and ( agente in (%s)) ' + #13#10;
  FiltroCliente          = ' and ( cliente = %s and tipocliente = %s) ' + #13#10;


