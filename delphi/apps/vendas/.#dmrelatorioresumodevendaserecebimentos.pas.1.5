constructor TdtmrelatorioresumodeVendaseRecebimentos.Create(AOwner: TComponent);
begin
  inherited;
  qryAgentes.Tag                :=ctTabelas;
  qryConceitos.Tag              :=ctTabelas;
  qryProcuraCliente.Tag   := ctTabelas;
  qryConsultaClientes.Tag := ctConsultaClientes;
  qryProcuraCliente.Params[1].AsString    := 'C';
end;

procedure TdtmrelatorioresumodeVendaseRecebimentos.ImprimirRelatorio(tipo: String);
begin
  frVariables['Outras']:= FParametroCabecalho;
  frVariables['Titulo']:= tipo;
  case FResumo of
    0: begin
         case FImprimir of
           0: ImprimirRelatoriofast(null, null, MSimples, 0, [frpResumoCaixaAnalitico, frpResumoCaixaSintetico, frpResumoCaixaGeral]);
           1: ImprimirRelatoriofast(null, null, MSimples, 0, [frpResumoCaixaAnalitico, frpResumoCaixaSintetico, frpResumoCaixaPorFilial]);
           2: ImprimirRelatoriofast(null, null, MSimples, 0, [frpResumoCaixaAnalitico, frpResumoCaixaSintetico, frpResumoCaixaPorFilial, frpResumoCaixaGeral]);
         end;
       end;
    1: ImprimirRelatoriofast(null, null, MSimples, 0, [frpResumoCaixaAnalitico, frpResumoCaixaSintetico]);
    2: begin
         case FImprimir of
           0: ImprimirRelatoriofast(null, null, MSimples, 0, [frpResumoCaixaGeral]);
           1: ImprimirRelatoriofast(null, null, MSimples, 0, [frpResumoCaixaPorFilial]);
           2: ImprimirRelatoriofast(null, null, MSimples, 0, [frpResumoCaixaPorFilial,frpResumoCaixaGeral]);
         end;
       end;
  end;
end;

procedure TdtmrelatorioresumodeVendaseRecebimentos.SetDataFinal(const Value: String);
begin
  if Value <> '' then begin
    FDataFinal := Value;
    if FDataInicial = '' then
      FDataInicial:=FDataFinal;
  end
  else FDataFinal:= FDataInicial;

  qryImprimirCaixa.ParamByName('datainicial').AsString    := FDataInicial;
  qryImprimirCaixa.ParamByName('datafinal').AsString      := FDataFinal;
  qryImprimirCaixa.ParamByName('datainicialmes').AsString := '01' + Copy(FDataInicial,3,8);
  FParametroCabecalho:= FParametroCabecalho + ' Entre: ' + FDataInicial + ' e ' + FDataFinal;

  if FResumo <> 1 then begin
    qryImprimirCaixaAcumulado.ParamByName('datainicial').AsString    := FDataInicial;
    qryImprimirCaixaAcumulado.ParamByName('datafinal').AsString      := FDataFinal;
    qryImprimirCaixaAcumulado.ParamByName('datainicialmes').AsString := '01' + Copy(FDataInicial,3,8);
  end;
end;

procedure TdtmrelatorioresumodeVendaseRecebimentos.SetDataInicial(const Value: String);
begin
  FDataInicial := Value;
end;

procedure TdtmrelatorioresumodeVendaseRecebimentos.SetVendasporContrato(const Value: Boolean);
begin
  FVendasporContrato := Value;
  if value then begin
    qryImprimirCaixa.MacroByName('Inicio_das_Vendas_por_Contrato').AsString := '/* inicio das vendas */';
    qryImprimirCaixa.MacroByName('Final_das_Vendas_por_Contrato').AsString := '/* Final das Vendas */';
  end
  else begin
    qryImprimirCaixa.MacroByName('Inicio_das_Vendas_por_Contrato').AsString := '/*';
    qryImprimirCaixa.MacroByName('Final_das_Vendas_por_Contrato').AsString := '*/';
  end;
end;

procedure TdtmrelatorioresumodeVendaseRecebimentos.SetEstornosdoMes(const Value: Boolean);
begin
  FEstornosdoMes := Value;
  if value then begin
    if FVendasporContrato or FVendasFrentedeCaixa then
      qryImprimirCaixa.MacroByName('union_all_Estornos_do_Mes').AsString := 'union all'
    else qryImprimirCaixa.MacroByName('union_all_Estornos_do_Mes').AsString := '';
    qryImprimirCaixa.macroByName('Inicio_Estornos_do_Mes').AsString := '/*   Inicio Estornos do Mes   */';
    qryImprimirCaixa.MacroByName('Final_Estornos_no_Mes').AsString := '/*   Final Estornos no Mes    */';
  end
  else begin
    qryImprimirCaixa.MacroByName('union_all_Estornos_do_Mes').AsString := '';
    qryImprimirCaixa.MacroByName('Inicio_Estornos_do_Mes').AsString := '/*   Inicio Estornos do Mes';
    qryImprimirCaixa.MacroByName('Final_Estornos_no_Mes').AsString := 'Final Estornos no Mes    */';
  end;
end;

procedure TdtmrelatorioresumodeVendaseRecebimentos.SetEstornosForadoMes(const Value: Boolean);
begin
  FEstornosForadoMes := Value;
  if value then begin
    if FVendasporContrato or FVendasFrentedeCaixa or FEstornosdoMes then
      qryImprimirCaixa.MacroByName('union_all_Estornos_Fora_do_Mes').AsString := 'union all'
    else qryImprimirCaixa.MacroByName('union_all_Estornos_Fora_do_Mes').AsString := '';
    qryImprimirCaixa.MacroByName('Inicio_Estornos_Fora_do_Mes').AsString := '/* Inicio Estornos Fora do Mes  */';
    qryImprimirCaixa.MacroByName('Final_Estornos_Fora_do_Mes').AsString := '/* Fim Estornos Fora do Mes     */';
  end
  else begin
    qryImprimirCaixa.MacroByName('union_all_Estornos_Fora_do_Mes').AsString := '';
    qryImprimirCaixa.MacroByName('Inicio_Estornos_Fora_do_Mes').AsString := '/* Inicio Estornos Fora do Mes';
    qryImprimirCaixa.MacroByName('Final_Estornos_Fora_do_Mes').AsString := 'Fim Estornos Fora do Mes     */';
  end
end;

procedure TdtmrelatorioresumodeVendaseRecebimentos.SetRecebimentosporContrato(const Value: Boolean);
begin
  FRecebimentosporContrato := Value;
  if value then begin
    if FVendasporContrato or FVendasFrentedeCaixa or FEstornosdoMes or FEstornosForadoMes then
      qryImprimirCaixa.MacroByName('union_all_Recebimentos_por_Contrato').AsString := 'union all'
    else qryImprimirCaixa.MacroByName('union_all_Recebimentos_por_Contrato').AsString := '';
    qryImprimirCaixa.MacroByName('Inicio_Recebimentos_por_Contrato').AsString := '/* Inicio dos Recebimentos por Contrato */';
    qryImprimirCaixa.MacroByName('Final_Recebimentos_por_Contrato').AsString := '/*  Fim dos Recebimentos por Contrato */';
  end
  else begin
    qryImprimirCaixa.MacroByName('union_all_Recebimentos_por_Contrato').AsString := '';
    qryImprimirCaixa.MacroByName('Inicio_Recebimentos_por_Contrato').AsString := '/* Inicio dos Recebimentos por Contrato';
    qryImprimirCaixa.MacroByName('Final_Recebimentos_por_Contrato').AsString := 'Fim dos Recebimentos por Contrato */';
  end;
end;

procedure TdtmrelatorioresumodeVendaseRecebimentos.SetFiliais(const Value: String);
begin
 FFiliais := Value;
 if (Value <> '') then
 begin
   qryImprimirCaixa.MacroByName('Filial_Venda').AsString := Format(FiltroFilial_Venda,[Value]);
   qryImprimirCaixa.MacroByName('Filial_Pagamento').AsString := Format(FiltroFilial_Pagto,[Value]);
   qryImprimirCaixa.MacroByName('Filial_Devolucao').AsString := Format(FiltroFilial_Dev,[Value]);
 end
 else begin
   qryImprimirCaixa.MacroByName('Filial_Venda').AsString := '';
   qryImprimirCaixa.MacroByName('Filial_Pagamento').AsString := '';
   qryImprimirCaixa.MacroByName('Filial_Devolucao').AsString := '';
 end;
end;

procedure TdtmrelatorioresumodeVendaseRecebimentos.SetGrupoFiliais(const Value: String);
begin
  FGrupoFiliais := Value;
  if (Value <> '') then
  begin
    if ParSistema.RelatorioSomenteFiliaisAutorizadas then
    begin
      qryImprimirCaixa.MacroByName('Filial_Venda').AsString :=
         qryImprimirCaixa.MacroByName('Filial_Venda').AsString +
         Format(FiltroGrupoFilial_Venda,[Value]);

      qryImprimirCaixa.MacroByName('Filial_Pagamento').AsString :=
         qryImprimirCaixa.MacroByName('Filial_Pagamento').AsString +
         Format(FiltroGrupoFilial_Pagto,[Value]);

      qryImprimirCaixa.MacroByName('Filial_Devolucao').AsString :=
         qryImprimirCaixa.MacroByName('Filial_Devolucao').AsString +
         Format(FiltroGrupoFilial_Dev,[Value]);
    end
    else
    begin
      qryImprimirCaixa.MacroByName('Filial_Venda').AsString := Format(FiltroGrupoFilial_Venda,[Value]);
      qryImprimirCaixa.MacroByName('Filial_Pagamento').AsString := Format(FiltroGrupoFilial_Pagto,[Value]);
      qryImprimirCaixa.MacroByName('Filial_Devolucao').AsString := Format(FiltroGrupoFilial_Dev,[Value]);
    end;
  end;
end;


procedure TdtmrelatorioresumodeVendaseRecebimentos.SetVendasEstornosMesmodia(const Value: Boolean);
const
  SQL_1 = 'and (ct.situacao in (''F'',''N'',''P'',''C''))';
  SQL_2 = 'and (ct.situacao in (''F'',''N'',''P'',''C''))';
{
  SQL_2 = 'and ((ct.situacao in (''F'',''N'',''P'')) or ' +
          '(ct.situacao = (''C'') and ((Select sum(p.valorvencto) from parcelas p ' +
          '                             Where  (p.contrato = ct.numero) ' +
          '                                and (p.datapagto = ct.faturamento) '  +
          '                                and (p.tipopagto is not null)) = ct.valorprazo)))';
}
begin
  FVendasEstornosMesmodia := Value;
  if value then begin
    FParametroCabecalho:= FParametroCabecalho + ' Vendas/Estornos mesmo dia';
    qryImprimirCaixa.MacroByName('Vendas_Mesmo_dia_Periodo').AsString := SQL_2;
    qryImprimirCaixa.MacroByName('Estornos_do_Mes_Mesmo_dia_Periodo').AsString := SQL_2;
  end
  else begin
    qryImprimirCaixa.MacroByName('Vendas_Mesmo_dia_Periodo').AsString := SQL_1;
    qryImprimirCaixa.MacroByName('Estornos_do_Mes_Mesmo_dia_Periodo').AsString := SQL_1;
  end;
end;

function TdtmrelatorioresumodeVendaseRecebimentos.GetListaAgentes: TStrings;
begin
  FListaAgentes:= TStringList.Create;
  qryAgentes.Open;
  while not qryAgentes.Eof do begin
    FListaAgentes.AddObject(qryAgentesdescricao.AsString, Pointer(qryAgentescodigo.AsInteger));
    qryAgentes.Next;
  end;
  qryAgentes.Close;
  Result := FListaAgentes;
end;

function TdtmrelatorioresumodeVendaseRecebimentos.GetListaConceitos: TStrings;
begin
  FListaConceitos:= TStringList.Create;
  qryConceitos.Open;
  while not qryConceitos.Eof do begin
    FListaConceitos.AddObject(qryConceitosdescricao.AsString, Pointer(qryConceitoscodigo.AsInteger));
    qryConceitos.Next;
  end;
  qryConceitos.Close;
  Result := FListaConceitos;
end;

