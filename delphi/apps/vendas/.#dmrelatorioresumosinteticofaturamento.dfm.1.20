  object qryRes_SinteticoFiliais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterScroll = qryRes_SinteticoFiliaisAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'inicio_Vendas_Contratos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Filiais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Vendedores'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'GruposVendedores'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Clientes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Final_Vendas_Contratos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Inicio_Vendas_Frente_de_Caixa'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Final_Vendas_Frente_de_Caixa'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Inicio_Devolucoes_Contratos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereGruposFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Final_Devolucoes_Contratos'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '; SELECT * FROM'
      '('
      'select DISTINCT *'
      'from'
      '('
      '%inicio_Vendas_Contratos'
      '('
      'select distinct'
      
        '       case when :AgruparGrupoFilial then fgf.grupo       else n' +
        'ull end as grupofilialvenda,'
      
        '       case when :AgruparGrupoFilial then gf.descricao  else nul' +
        'l end as nomegrupofilialvenda,'
      
        '       case when :AgruparFilial         then  ct.filialvenda els' +
        'e null  end as filialvenda,'
      
        '       case when :AgruparFilial        then   f.nome          el' +
        'se null end as nomefilialvenda,'
      
        '       case when :AgruparVendedor then   ct.vendedor  else null ' +
        'end as vendedor,'
      
        '       case when :AgruparVendedor then   u.nome         else nul' +
        'l end as nomevendedor'
      ''
      ' from ((((contratos ct join planos pl'
      
        '                                                    on ct.plano=' +
        'pl.codigo)'
      ''
      
        '                     join (filiais f left join (filiaisgruposfil' +
        'iais fgf  left join gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                  on f.codigo=fgf.filial)'
      
        '                                          on ct.filialvenda=f.co' +
        'digo)'
      ''
      '                     join (usuarios u'
      '                           left join GruposUsuarios gu'
      '                           on u.grupo = gu.codigo)'
      ''
      '                     on ct.vendedor=u.codigo)'
      
        #9#9#9#9#9' join vfornecedores vf on ct.cliente = vf.codigo and ct.tip' +
        'ocliente = vf.tipo)'
      
        ' where ct.origem is null and ct.faturamento between(:DataInicial' +
        ') and (:DataFinal)'
      
        '   and case when ct.os then ct.tipoequipamento in (1,2) and not ' +
        '(coalesce(ct.os_garantia,false) and ct.os_garantia_status='#39'A'#39') a' +
        'nd not coalesce(ct.os_cortesia,false) else true end'
      ''
      ''
      ''
      '%Filiais'
      '%Vendedores'
      '%GruposVendedores'
      '%Clientes'
      ''
      ')'
      '%Final_Vendas_Contratos'
      'union all'
      '%Inicio_Vendas_Frente_de_Caixa'
      '('
      'select distinct'
      
        '       case when :AgruparGrupoFilial then fgf.grupo       else n' +
        'ull end as grupofilialvenda,'
      
        '       case when :AgruparGrupoFilial then gf.descricao  else nul' +
        'l end as nomegrupofilialvenda,'
      
        '       case when :AgruparFilial         then  df.filialvenda els' +
        'e null  end as filialvenda,'
      
        '       case when :AgruparFilial        then   f.nome          el' +
        'se null end as nomefilialvenda,'
      
        '       case when :AgruparVendedor then   df.vendedor  else null ' +
        'end as vendedor,'
      
        '       case when :AgruparVendedor then   coalesce(u.nome, cast('#39 +
        'FRENTE DE CAIXA'#39' as varchar))  else null end as nomevendedor'
      ''
      
        ' from (((dadosfiscais df join (filiais f left join (filiaisgrupo' +
        'sfiliais fgf  join gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                  on f.codigo=fgf.filial)'
      
        '                                          on df.filialvenda=f.co' +
        'digo)'
      ''
      '                     left join (usuarios u'
      '                                left join GruposUsuarios gu'
      '                                 on u.grupo = gu.codigo)'
      ''
      '                     on df.vendedor=u.codigo)'
      
        #9#9#9#9#9' left join vfornecedores vf on df.cliente = vf.codigo and d' +
        'f.tipocliente = vf.tipo)'
      ''
      
        'Where (df.data between (:datainicial) and (:datafinal)) and df.c' +
        'ontrato is null'
      '          and df.situacao='#39'N'#39
      
        '          and (eHNotaFiscalSaidaVenda(df.codigofiscal) or mod(df' +
        '.codigofiscal,1000) in (929))'
      ''
      '  and not coalesce(df.notavinculada,false)'
      ''
      '%Filiais'
      '%Vendedores'
      '%GruposVendedores'
      '%Clientes'
      ''
      ')'
      '%Final_Vendas_Frente_de_Caixa'
      '%Inicio_Devolucoes_Contratos'
      'union all'
      '('
      'select distinct'
      
        '       case when :AgruparGrupoFilial then fgf.grupo       else n' +
        'ull end as grupofilialvenda,'
      
        '       case when :AgruparGrupoFilial then gf.descricao  else nul' +
        'l end as nomegrupofilialvenda,'
      
        '       case when :AgruparFilial          then ct.filialvenda els' +
        'e null end as filialvenda,'
      
        '       case when :AgruparFilial          then f.nome          el' +
        'se null end as nomefilialvenda,'
      
        '       case when :AgruparVendedor   then ct.vendedor  else null ' +
        'end as vendedor,'
      
        '       case when :AgruparVendedor   then u.nome         else nul' +
        'l end as nomevendedor'
      ''
      ' from ((((contratos ct join planos pl'
      
        '                                                    on ct.plano=' +
        'pl.codigo)'
      
        '                           join (filiais f left join (filiaisgru' +
        'posfiliais fgf  left join gruposfiliais gf on fgf.grupo=gf.codig' +
        'o)'
      
        '                                                                ' +
        '                  on f.codigo=fgf.filial)'
      
        '                                          on ct.filialvenda=f.co' +
        'digo)'
      ''
      '                           join (usuarios u'
      '                                 left join GruposUsuarios gu'
      '                                 on u.grupo = gu.codigo)'
      ''
      '                           on ct.vendedor=u.codigo)'
      
        #9#9#9#9#9#9'   join vfornecedores vf on ct.cliente = vf.codigo and ct.' +
        'tipocliente = vf.tipo)'
      #9#9#9#9#9#9'   '
      ' where  ct.numero in (('
      '                       (select distinct cd.contrato'
      '                        from contratosdevolvidos cd'
      #9#9'        where cd.contrato is not null and'
      
        #9#9'              cd.devolucao between (:DataInicial) and (:DataFi' +
        'nal) and'
      #9#9#9'      cd.tipo = '#39'D'#39
      #9#9'       )'
      '                        UNION ALL'
      ' '#9#9'       (select distinct p.contrato'
      #9#9#9'from contratos ct, parcelas p'
      #9#9#9'where ct.numero=p.contrato and'
      #9#9#9'ct.situacao='#39'C'#39' and'
      #9#9#9'not exists (select p2.numero'
      #9#9#9#9#9'from parcelas p2'
      #9#9#9#9#9'where p2.contrato = ct.numero and'
      #9#9#9#9#9#9'p2.tipopagto<>'#39'E'#39') and'
      #9#9#9'p.datapagto between :datainicial and :datafinal AND'
      
        '                                          not exists (select cd.' +
        'contrato '
      
        '                                                           from ' +
        'contratosdevolvidos cd'
      
        '                                                           where' +
        ' cd.contrato = ct.numero and cd.tipo='#39'D'#39') '
      #9#9'       )'
      #9#9'       order by contrato'
      #9#9'       )'
      '  '#9#9'      )'
      ''
      '%Filiais'
      '%Vendedores'
      '%GruposVendedores'
      '%Clientes'
      ''
      
        'and case when ct.os then ct.tipoequipamento in (1,2) and not (co' +
        'alesce(ct.os_garantia,false) and ct.os_garantia_status='#39'A'#39') and ' +
        'not coalesce(ct.os_cortesia,false) else true end'
      ''
      ')'
      'union all'
      '('
      ''
      '  select distinct'
      
        '       case when :AgruparGrupoFilial then fgf.grupo    else null' +
        ' end as grupofilialvenda,'
      
        '       case when :AgruparGrupoFilial then gf.descricao else null' +
        ' end as nomegrupofilialvenda,'
      
        '       case when :AgruparFilial      then np.filial    else null' +
        ' end as filialvenda,'
      
        '       case when :AgruparFilial      then f.nome       else null' +
        ' end as nomefilialvenda,'
      
        '       case when :AgruparVendedor    then np.vendedor  else null' +
        ' end as vendedor,'
      
        '       case when :AgruparVendedor    then u.nome       else null' +
        ' end as nomevendedor'
      '       '
      '            '
      '     from (((notaspag np'
      
        '            join (filiais f left join (filiaisgruposfiliais fgf ' +
        'join gruposfiliais gf on fgf.grupo=gf.codigo %WhereGruposFiliais' +
        ')'
      
        '                                                                ' +
        '                         on f.codigo=fgf.filial)'
      
        '                                                on np.filial=f.c' +
        'odigo)'
      ''
      '            join (usuarios u'
      '                  left join GruposUsuarios gu'
      '                  on u.grupo = gu.codigo)'
      '            on np.vendedor=u.codigo)'
      ''
      
        '            join vfornecedores vf on np.fornecedor = vf.codigo a' +
        'nd np.tipofornecedor = vf.tipo)'
      '                                                '
      
        '     Where (np.data between (:DataInicial) and (:DataFinal) and ' +
        'situacao='#39'N'#39')'
      '       and np.contrato is null'
      '       and ehnotafiscalentradadevolucao(np.codigofiscal)'
      '       '
      '     %Filiais'
      '     %Vendedores'
      '     %GruposVendedores'
      '     %Clientes'
      '  '
      ')'
      '%Final_Devolucoes_Contratos'
      ') as temp'
      ''
      ') AS rs'
      ''
      
        'ORDER BY UPPER(TO_ASCII(rs.NomeGrupoFilialVenda,'#39'LATIN1'#39')), rs.G' +
        'rupoFilialVenda,'
      
        '         UPPER(TO_ASCII(rs.NomeFilialVenda,'#39'LATIN1'#39')), rs.Filial' +
        'Venda,'
      '         UPPER(TO_ASCII(rs.NomeVendedor,'#39'LATIN1'#39')), rs.Vendedor')
    RequestLive = False
    Left = 69
    Top = 28
    ParamData = <
      item
        DataType = ftString
        Name = 'AgruparGrupoFilial'
        ParamType = ptUnknown
        Value = 'false'
      end
      item
        DataType = ftString
        Name = 'AgruparFilial'
        ParamType = ptUnknown
        Value = 'false'
      end
      item
        DataType = ftString
        Name = 'AgruparVendedor'
        ParamType = ptUnknown
        Value = 'false'
      end
      item
        DataType = ftDate
        Name = 'DataInicial'
        ParamType = ptUnknown
        Value = #39'01/09/2005'#39
      end
      item
        DataType = ftDate
        Name = 'DataFinal'
        ParamType = ptUnknown
        Value = #39'12/09/2005'#39
      end>
