    object qryFiliaisTipodePlanoavista: TFloatField
      FieldName = 'avista'
      DisplayFormat = '0.00'
    end
    object qryFiliaisTipodePlanoentradas: TFloatField
      FieldName = 'entradas'
      DisplayFormat = '0.00'
    end
    object qryFiliaisTipodePlanoparcelas: TFloatField
      FieldName = 'parcelas'
      DisplayFormat = '0.00'
    end
    object qryFiliaisTipodePlanopercentual: TFloatField
      FieldName = 'percentual'
      DisplayFormat = '0.00'
    end
    object qryFiliaisTipodePlanocreditotroca: TFloatField
      FieldName = 'creditotroca'
      DisplayFormat = '0.00'
    end
    object qryFiliaisTipodePlanotipo: TStringField
      FieldName = 'tipo'
    end
  end
