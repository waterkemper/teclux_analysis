      item
        DataType = ftUnknown
        Name = 'Final_Devolucoes_Contratos'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';SELECT * FROM'
      '('
      '%Inicio_VendasContratoseFrenteCaixa'
      ' ('
      '  select vendasPlanosTotal.*,'
      '         totalvendas.*,'
      
        '         round((100*(aVista+entradas+parcelas))/(COALESCE(NULLIF' +
        '(valortotalvendas,0),1)),2) as percentual,'
      '         cast('#39'A_Vendas'#39' as varchar(20)) as Tipo'
      '  from'
      '  ('
      '   select tipoplano,'
      '       nometipoplano,'
      '       sum(fretes) as fretes,'
      '       sum(seguro) as seguro,'
      '       sum(avista) as avista,'
      '       sum(coalesce(entradas,0)) as entradas,'
      '       sum(parcelas) as parcelas,'
      '       sum(creditotroca) as creditotroca'
      '   from'
      ' ('
      ' %Inicio_Vendas_Contratos_1'
      ' ('
      '   select'
      '       ct.plano as tipoplano,'
      '       pl.descricao as nometipoplano,'
      '       coalesce(ct.frete,0) as fretes,'
      '       coalesce(ct.seguro,0) as seguro,'
      '       (case when (select count(*) from parcelas p where'
      '                             p.contrato = ct.numero and'
      
        '                             p.datavencto > ct.faturamento) = 0 ' +
        'then ct.valorprazo'
      
        '                                                        else 0 e' +
        'nd) as avista,'
      ''
      '        (case when (select count(*) from parcelas p where'
      '                   p.contrato = ct.numero and'
      '                   p.datavencto > ct.faturamento) = 0 then 0'
      '                                              else'
      
        '                           (select sum(p.valorvencto) from parce' +
        'las p where'
      '                            p.contrato = ct.numero and'
      '                            p.datavencto <= ct.faturamento'
      '                            )'
      '       end) as entradas,'
      ''
      '       (case when (select count(*) from parcelas p where'
      '                            p.contrato = ct.numero and'
      
        '                            p.datavencto > ct.faturamento) = 0 t' +
        'hen 0'
      '                                              else'
      
        '                           (select sum(p.valorvencto) from parce' +
        'las p where'
      '                            p.contrato = ct.numero and'
      '                            p.datavencto > ct.faturamento)'
      '       end) as parcelas,'
      '       - coalesce(ct.creditotroca,0) as creditotroca'
      ''
      '  from ((((contratos ct join planos pl on ct.plano=pl.codigo)'
      
        '                    join vfornecedores vf on ct.cliente = vf.cod' +
        'igo and ct.tipocliente = vf.tipo)'
      ''
      '                     join (usuarios u'
      '                           left join GruposUsuarios gu'
      '                           on u.grupo = gu.codigo)'
      ''
      '                     on ct.vendedor=u.codigo)'
      ''
      
        '                     join (filiais f left join (filiaisgruposfil' +
        'iais fgf  left join gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                  on f.codigo=fgf.filial)'
      
        '                                          on ct.filialvenda=f.co' +
        'digo)'
      ''
      ''
      '  where  ct.origem is null and'
      '       ct.faturamento between (:DataInicial) and (:DataFinal)'
      
        '    and case when ct.os then ct.tipoequipamento in (1,2) and not' +
        ' (coalesce(ct.os_garantia,false) and ct.os_garantia_status='#39'A'#39') ' +
        'and not coalesce(ct.os_cortesia,false) else true end'
      ''
      '  %Filiais'
      '  %Vendedores'
      '  %GruposVendedores'
      '  %Clientes'
      '  %Agrupamento'
      '  '
      ''
      ' )'
      '  %Final_Vendas_Contratos_1'
      '  union all'
      '  %Inicio_Vendas_Frente_de_Caixa_1'
      ' ('
      '    select'
      '       df.plano as tipoplano,'
      
        '       coalesce(pl.descricao, cast('#39'FRENTE DE CAIXA'#39' as varchar)' +
        ') as nometipoplano,'
      '       coalesce(df.valorfrete,0) as fretes,'
      '       coalesce(df.seguro,0) as seguro,'
      '       df.valortotal as avista,'
      '       0.00 as entradas,'
      '       0.00 as parcelas,'
      '       0.00 as creditotroca'
      ''
      '  from ((((dadosfiscais df'
      '          left join planos pl on df.plano=pl.codigo)'
      
        '         left join vfornecedores vf on df.cliente = vf.codigo an' +
        'd df.tipocliente = vf.tipo)'
      ''
      '         left join (usuarios u'
      '               left join GruposUsuarios gu'
      '               on u.grupo = gu.codigo)'
      ''
      '         on df.vendedor=u.codigo)'
      ''
      
        '         join (filiais f left join (filiaisgruposfiliais fgf  jo' +
        'in gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                  on f.codigo=fgf.filial)'
      
        '                                          on df.filialvenda=f.co' +
        'digo)'
      ''
      
        '  Where (df.data between (:datainicial) and (:datafinal)) and df' +
        '.contrato is null'
      '          and df.situacao='#39'N'#39
      
        '          and (eHNotaFiscalSaidaVenda(df.codigofiscal) or mod(df' +
        '.codigofiscal,1000) in (929))'
      ''
      '    and not coalesce(df.notavinculada,false)'
      ''
      '  %Filiais'
      '  %Vendedores'
      '  %GruposVendedores'
      '  %Clientes'
      '  %Agrupamento'
      '  '
      '  '
      '  )'
      '  %Final_Vendas_Frente_de_Caixa_1'
      ' ) as VendasPlanos'
      ' group by VendasPlanos.tipoplano,'
      '          VendasPlanos.nometipoplano'
      ') as vendasPlanostotal,'
      ''
      ' ('
      '  select sum(valortotalvendas) as valortotalvendas'
      '  from'
      '  ('
      '  %Inicio_Vendas_Contratos_2'
      '   ('
      '    select sum(ct.valorprazo) as valortotalvendas'
      '    from (((contratos ct'
      '          join vfornecedores vf'
      
        '          on ct.cliente = vf.codigo and ct.tipocliente = vf.tipo' +
        ')'
      ''
      '                     join (usuarios u'
      '                           left join GruposUsuarios gu'
      '                           on u.grupo = gu.codigo)'
      ''
      '                     on ct.vendedor=u.codigo)'
      ''
      
        '          join (filiais f left join (filiaisgruposfiliais fgf  j' +
        'oin gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                  on f.codigo=fgf.filial)'
      
        '                                          on ct.filialvenda=f.co' +
        'digo)'
      ''
      ''
      ''
      ''
      '    where ct.origem is null'
      '      and ct.faturamento between (:DataInicial) and (:DataFinal)'
      
        '      and case when ct.os then ct.tipoequipamento in (1,2) and n' +
        'ot (coalesce(ct.os_garantia,false) and ct.os_garantia_status='#39'A'#39 +
        ') and not coalesce(ct.os_cortesia,false) else true end'
      ''
      '   %Filiais'
      '   %Vendedores'
      '   %GruposVendedores'
      '   %Clientes'
      '   %Agrupamento'
      ''
      '   )'
      '  %final_Vendas_Contratos_2'
      '   union all'
      '  %Inicio_Vendas_Frente_de_Caixa_2'
      '   ('
      ''
      '    select sum(df.valortotal) as valortotalvendas'
      ''
      '    from (((dadosfiscais df'
      
        '           left join vfornecedores vf on df.cliente = vf.codigo ' +
        'and df.tipocliente = vf.tipo)'
      ''
      '           left join (usuarios u'
      '               left join GruposUsuarios gu'
      '               on u.grupo = gu.codigo)'
      ''
      '           on df.vendedor=u.codigo)'
      ''
      
        '           join (filiais f left join (filiaisgruposfiliais fgf  ' +
        'join gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                  on f.codigo=fgf.filial)'
      
        '                                          on df.filialvenda=f.co' +
        'digo)'
      ''
      
        '    Where (df.data between (:datainicial) and (:datafinal)) and ' +
        'df.contrato is null'
      '          and df.situacao='#39'N'#39
      
        '          and (eHNotaFiscalSaidaVenda(df.codigofiscal) or mod(df' +
        '.codigofiscal,1000) in (929))'
      '      and not coalesce(df.notavinculada,false)'
      ''
      '   %Filiais'
      '   %Vendedores'
      '   %GruposVendedores'
      '   %Clientes'
      '   %Agrupamento'
      '   '
      '   )'
      '  %Final_Vendas_Frente_de_Caixa_2'
      '  ) as totalvendas'
      ' ) as totalvendas'
      ')'
      '%Final_VendasContratoseFrenteCaixa'
      '%Inicio_Devolucoes_Contratos'
      'union all'
      ''
      ''
      '('
      ' select tipoplano,'
      '        nometipoplano,'
      '        sum(fretes) as fretes,'
      '        sum(seguro) as seguro,'
      '        sum(aVista) as aVista,'
      '        sum(entradas) as entradas,'
      '        sum(parcelas) as parcelas,'
      '        sum(creditotroca) as creditotroca,'
      '        cast(null as numeric) as valortotalvendas,'
      '        cast(null as numeric) as percentual,'
      '        cast('#39'B_Devolucoes'#39' as varchar(20)) as Tipo'
      ' from'
      ' ('
      ''
      ' ('
      '  select tipoplano,'
      '         nometipoplano,'
      #9' -fretes as fretes,'
      #9' -seguro as seguro,'
      
        '         -case when ContratoaVista then valortotal else 0 end as' +
        ' aVista,'
      '         -entradas as entradas,'
      
        '         -case when ContratoaVista then 0 else valortotal-coales' +
        'ce(entradas,0) end as parcelas,'
      #9' creditotroca'
      ' from'
      '  ('
      ''
      '   select contratostipo_d.*,'
      '         case When contratoavista then 0'
      '          else  (select sum(p.valorvencto)'
      '                 from parcelas p'
      #9#9' where p.contrato = ncontrato and'
      
        #9#9'      (p.tipopagto is not null and p.tipopagto in ('#39'D'#39','#39'C'#39','#39'R'#39 +
        ','#39'E'#39','#39'J'#39'))  and'
      '                       p.datavencto <= devolucao)'
      '          end as entradas'
      '   from'
      '    ( select contratos_d.*,'
      '           (case when (select count(*)'
      #9'               from parcelas p'
      #9#9'       where   p.contrato = ncontrato and'
      
        '                               p.datavencto > faturamento) = 0 t' +
        'hen true'
      '            else false end'
      #9'    ) as contratoavista'
      '     from'
      '     ( select'
      '       ct.numero as ncontrato,'
      '       ct.faturamento,'
      '       ct.plano as tipoplano,'
      '       pl.descricao as nometipoplano,'
      '       coalesce(contratosdevolvidos.frete,0) as fretes,'
      '       coalesce(contratosdevolvidos.seguro,0) as seguro,'
      '       contratosdevolvidos.valortotal as valortotal,'
      '       contratosdevolvidos.devolucao as devolucao,'
      '       coalesce(ct.creditotroca,0) as creditotroca'
      '       from ((((contratos ct'
      #9'         join planos pl on ct.plano = pl.codigo)'
      
        #9#9' join vfornecedores vf on ct.cliente = vf.codigo and ct.tipocl' +
        'iente = vf.tipo)'
      ''
      '                 join (usuarios u'
      '                           left join GruposUsuarios gu'
      '                           on u.grupo = gu.codigo)'
      ''
      '                     on ct.vendedor=u.codigo)'
      ''
      
        '                 join (filiais f left join (filiaisgruposfiliais' +
        ' fgf  join gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                  on f.codigo=fgf.filial)'
      
        '                                          on ct.filialvenda=f.co' +
        'digo),'
      ''
      '       ('
      '        ('
      '         select cd.contrato,'
      '                cd.devolucao,'
      #9#9'sum(cd.valorprazo) as valortotal,'
      #9#9'sum(cd.frete) as frete,'
      #9#9'sum(cd.seguro) as seguro'
      #9' from contratosdevolvidos cd'
      '         where cd.contrato is not null and'
      #9'      cd.devolucao between (:DataInicial) and (:DataFinal) and'
      #9'      cd.tipo='#39'D'#39
      '         group by cd.contrato, cd.devolucao'
      #9')'
      #9'union all'
      #9'('
      #9' select distinct ct.numero as contrato,'
      #9' '#9#9'p.datapagto as devolucao,'
      #9#9#9'ct.valorprazo as valortotal,'
      #9#9#9'coalesce(ct.frete,0) as frete,'
      #9#9#9'coalesce(ct.seguro,0) as seguro'
      #9' from contratos ct, parcelas p'
      #9' where ct.numero=p.contrato and'
      #9' '#9'ct.situacao='#39'C'#39' and'
      #9#9'not exists (select p2.numero'
      #9#9#9'from parcelas p2'
      #9#9#9'where p2.contrato = ct.numero and'
      #9#9#9#9'p2.tipopagto<>'#39'E'#39') and'
      #9#9'p.datapagto between :datainicial and :datafinal and'
      
        '                                          not exists (select cd.' +
        'contrato'
      
        '                                                           from ' +
        'contratosdevolvidos cd'
      
        '                                                           where' +
        ' cd.contrato = ct.numero and cd.tipo='#39'D'#39')'
      
        '           and case when ct.os then ct.tipoequipamento in (1,2) ' +
        'and not (coalesce(ct.os_garantia,false) and ct.os_garantia_statu' +
        's='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '        )'
      '       ) as contratosdevolvidos'
      '        where ct.numero=contratosdevolvidos.contrato'
      ''
      '  %Devolucoes'
      '  %Filiais'
      '  %Vendedores'
      '  %GruposVendedores'
      '  %Clientes'
      '  %Agrupamento'
      ''
      '     ) as contratos_d'
      '   ) as contratostipo_d'
      '            '
      '  ) as contratosentradas_d'
      '  ) '
      '  union all'
      '  ('
      '  '
      '     select cast(null as integer) as tipoplano,'
      
        '            cast('#39'DEVOLU'#199#195'O SEM REFERENCIA DE NF'#39' as varchar(30)' +
        ') as nometipoplano,'
      '            -coalesce(np.freteinterno,  0) as fretes,'
      '            -coalesce(np.seguro,0) as seguro,'
      '            -np.valornota as aVista,      '
      '            cast(null as numeric(11,2)) as entradas,'
      '            cast(null as numeric(11,2)) as parcelas,'
      '            cast(null as numeric(11,2)) as creditotroca'
      '           '
      ''
      '         from (((notaspag np'
      
        '                join vfornecedores vf on np.fornecedor = vf.codi' +
        'go and np.tipofornecedor = vf.tipo)'
      ''
      '                join (usuarios u'
      '                      left join GruposUsuarios gu'
      '                      on u.grupo = gu.codigo)'
      '                on np.vendedor=u.codigo)'
      ''
      
        '                join (filiais f left join (filiaisgruposfiliais ' +
        'fgf  join gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                  on f.codigo=fgf.filial)'
      '                                          on np.filial=f.codigo)'
      ''
      ''
      
        '         Where (np.data between (:DataInicial) and (:DataFinal) ' +
        'and situacao='#39'N'#39')'
      '           and np.contrato is null'
      '           and ehnotafiscalentradadevolucao(np.codigofiscal)'
      ''
      '         %Devolucoes_np'
      '         %Filiais'
      '         %Vendedores'
      '         %GruposVendedores'
      '         %Clientes'
      '         %Agrupamento_np'
      ''
      '  )'
      ''
      '  '
      ' ) as devolucaoes'
      ' group by nometipoplano, tipoplano'
      ')'
      ''
      '%Final_Devolucoes_Contratos'
      ''
      ') AS rs'
      ''
      'ORDER BY rs.Tipo, rs.Percentual DESC, rs.TipoPlano,'
      '         UPPER(TO_ASCII(rs.NomeTipoPlano,'#39'LATIN1'#39'))')
    RequestLive = False
    Left = 226
    Top = 28
    ParamData = <
      item
        DataType = ftDate
        Name = 'DataInicial'
        ParamType = ptUnknown
        Value = #39'15/08/2005'#39
      end
      item
        DataType = ftDate
        Name = 'DataFinal'
        ParamType = ptUnknown
        Value = #39'15/08/2005'#39
      end>
