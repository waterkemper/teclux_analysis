    Sql.Strings = (
      ';'
      '%Inicio_VendasContratoseFrenteCaixa'
      '('
      'select Vendas.*,'
      
        '      round((valortotal * 100) / (COALESCE(NULLIF(ValorTotalGera' +
        'l,0),1)),2) as Percentual,'
      '      '#39'A_Vendas'#39' as tipo'
      'from'
      '('
      'select VendasVendedores.*,'
      '       sum(VendasTotal.valorprazo) as ValorTotalGeral'
      'from'
      '('
      'select vendedor,'
      '         nome as nomevendedor,'
      '         sum((valorvista+desconto)) as ValorMercadoria,'
      
        '         (sum(desconto)*100)/(COALESCE(NULLIF((sum(valorvista+de' +
        'sconto)),0),1)) as percdesconto,'
      '         sum(desconto) as desconto,'
      '         sum(valorvista) as ValorLiquidoVendedor,'
      '         sum(ValorPrazo-ValorVista) as eFinanceiro,'
      '         count(*) as Notas,'
      '         sum(produtos) as produtos,'
      '         sum(ValorPrazo) as ValorTotal,'
      
        #9' sum(case when not ContratoeAPrazo then ValorPrazo else 0 end) ' +
        'as ValorVista,'
      
        #9' sum(case when ContratoeAPrazo then valorprazo else 0 end) as V' +
        'alorPrazo,'
      #9' sum(creditotroca) as creditotroca'
      'from'
      '('
      '%Inicio_Vendas_Contratos_1'
      '('
      '  select'
      '       ct.vendedor,'
      '       u.nome,'
      '       ct.valorvista,'
      '       ct.valorprazo,'
      '                         (coalesce(ct.desconto, 0) +'
      
        '                         coalesce((SELECT sum(pc.valordescontoit' +
        'em)'
      '                          FROM produtoscontratos pc'
      
        '                                      WHERE ct.numero=pc.contrat' +
        'o),0)) AS desconto,'
      ''
      '       coalesce(ct.frete,0) as frete,'
      '       coalesce(ct.seguro, 0) as seguro,'
      
        '       (coalesce((select sum(pc.quantidade) from produtoscontrat' +
        'os pc where ct.numero=pc.contrato and not pc.brinde),0)+'
      
        '        coalesce((select sum(sc.quantidade) from servicoscontrat' +
        'os sc where ct.numero=sc.contrato),0)) as Produtos,'
      '       (select exists (select p.contrato'
      '                       from parcelas p'
      '  '#9#9'       where p.contrato = ct.numero and'
      
        #9#9'             p.datavencto > ct.faturamento)) as ContratoeAPraz' +
        'o,'
      '       - coalesce(ct.creditotroca,0) as creditotroca'
      '  from (((contratos ct'
      ''
      
        '                            join (usuarios u left join GruposUsu' +
        'arios gu'
      '                                  on u.grupo = gu.codigo)'
      ''
      '                            on ct.vendedor=u.codigo)'
      #9#9#9#9#9#9#9
      
        #9#9#9'   join vfornecedores vf on ct.cliente = vf.codigo and ct.tip' +
        'ocliente = vf.tipo)'
      ''
      
        '                           join (filiais f left join (filiaisgru' +
        'posfiliais fgf  join gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                  on f.codigo=fgf.filial)'
      
        '                                          on ct.filialvenda=f.co' +
        'digo)'
      ''
      #9#9#9#9#9#9#9
      
        '   where   ct.faturamento between(:DataInicial) and (:DataFinal)' +
        ' and'
      
        '             (coalesce(ct.valorvista,0)<>0) and (coalesce(ct.val' +
        'orprazo,0)<>0)'
      
        '                 and case when ct.os then ct.tipoequipamento in ' +
        '(1,2) and not (coalesce(ct.os_garantia,false) and ct.os_garantia' +
        '_status='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true en' +
        'd'
      '             and ct.origem is null'
      ''
      '%Filiais'
      '%Clientes'
      '%ProdutoseServicosContratos'
      '%Vendedores'
      '%GruposVendedores'
      '%Agrupamento'
      ')'
      '%Final_Vendas_Contratos_1'
      'union all'
      '%Inicio_Vendas_Frente_de_Caixa_1'
      '('
      '  select'
      '       df.vendedor,'
      
        '       coalesce(u.nome, cast('#39'FRENTE DE CAIXA'#39' as varchar)) as n' +
        'ome,'
      '       df.valorvista,'
      '       df.valortotal as valorprazo,'
      
        '       coalesce(df.desconto, 0) + coalesce(df.descontoitem, 0)  ' +
        'as desconto,'
      '       coalesce(df.valorfrete,0) as frete,'
      '       coalesce(df.seguro, 0) as seguro,'
      
        '       (coalesce((select sum(pdf.quantidade) from produtosdadosf' +
        'iscais pdf where df.numero=pdf.dadofiscal),0)+'
      
        '        coalesce((select sum(sdf.quantidade) from servicosdadosf' +
        'iscais sdf where df.numero=sdf.dadofiscal),0)) as Produtos,'
      #9'false as ContratoeAPrazo,'
      #9'0.00 as creditotroca'
      '        '
      
        '  from (((dadosfiscais df left join (usuarios u left join Grupos' +
        'Usuarios gu'
      '                                  on u.grupo = gu.codigo)'
      ''
      '                         on df.vendedor=u.codigo)'
      ''
      
        '                         left join vfornecedores vf on df.client' +
        'e = vf.codigo and df.tipocliente = vf.tipo)'
      ''
      
        '                         join (filiais f left join (filiaisgrupo' +
        'sfiliais fgf  join gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                  on f.codigo=fgf.filial)'
      
        '                                          on df.filialvenda=f.co' +
        'digo)'
      #9#9
      
        '  Where (df.data between (:datainicial) and (:datafinal)) and df' +
        '.contrato is null'
      '          and df.situacao='#39'N'#39' '
      
        '       and (eHNotaFiscalSaidaVenda(df.codigofiscal) or mod(df.co' +
        'digofiscal,1000) in (929))'
      ''
      '    and not coalesce(df.notavinculada,false)              '
      ''
      '%Filiais'
      '%Clientes'
      '%ProdutoseServicosDadosFiscais'
      '%Vendedores'
      '%GruposVendedores'
      '%Agrupamento'
      ''
      ')'
      '%Final_Vendas_Frente_de_Caixa_1'
      ') as contratos'
      'group by vendedor, nome'
      ') as VendasVendedores,'
      '('
      'select sum(valorprazo) as valorprazo from'
      '('
      ' %Inicio_Vendas_Contratos_2'
      ' ('
      '  select ct.valorprazo'
      ''
      '  from (((contratos ct'
      ''
      '        left join (usuarios u'
      '                  left join GruposUsuarios gu'
      '                  on u.grupo = gu.codigo)'
      '        on ct.vendedor = u.codigo)'
      ''
      '        join vfornecedores vf'
      '        on ct.cliente = vf.codigo and'
      '        ct.tipocliente = vf.tipo)'
      ''
      ''
      
        '        join (filiais f left join (filiaisgruposfiliais fgf  joi' +
        'n gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                  on f.codigo=fgf.filial)'
      
        '                                          on ct.filialvenda=f.co' +
        'digo)'
      ''
      
        '  where  ct.faturamento between(:DataInicial) and (:DataFinal) a' +
        'nd'
      
        '             (coalesce(ct.valorvista,0)<>0) and (coalesce(ct.val' +
        'orprazo,0)<>0) and'
      '             ct.origem is null'
      
        '    and case when ct.os then ct.tipoequipamento in (1,2) and not' +
        ' (coalesce(ct.os_garantia,false) and ct.os_garantia_status='#39'A'#39') ' +
        'and not coalesce(ct.os_cortesia,false) else true end'
      ''
      '%Filiais'
      '%Clientes'
      '%ProdutoseServicosContratos'
      '%Vendedores'
      '%GruposVendedores'
      '%Agrupamento'
      ''
      ' )'
      '%Final_Vendas_Contratos_2'
      'union all'
      '%Inicio_Vendas_Frente_de_Caixa_2'
      ' ('
      '  select df.valortotal as valorprazo'
      ''
      '  from (((dadosfiscais df'
      ''
      '       left join vfornecedores vf'
      '       on df.cliente = vf.codigo and'
      '          df.tipocliente = vf.tipo)'
      ''
      '       join (usuarios u'
      '             left join GruposUsuarios gu'
      '             on u.grupo = gu.codigo)'
      '       on df.vendedor=u.codigo)'
      ''
      
        '       join (filiais f left join (filiaisgruposfiliais fgf  join' +
        ' gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                  on f.codigo=fgf.filial)'
      
        '                                          on df.filialvenda=f.co' +
        'digo)'
      ''
      ''
      ''
      
        '  Where (df.data between (:datainicial) and (:datafinal)) and df' +
        '.contrato is null'
      '          and df.situacao='#39'N'#39
      
        '          and (eHNotaFiscalSaidaVenda(df.codigofiscal) or mod(df' +
        '.codigofiscal,1000) in (929))'
      
        '             /* ((EXISTS (SELECT vdf.dadofiscal FROM venctosdado' +
        'sfiscais vdf WHERE vdf.dadofiscal=df.numero)) or'
      
        '               (mod(df.codigofiscal,1000) in (102,103,104,105,92' +
        '9))) */'
      '    and not coalesce(df.notavinculada,false)'
      ''
      '%Filiais'
      '%Clientes'
      '%ProdutoseServicosDadosFiscais'
      '%Vendedores'
      '%GruposVendedores'
      '%Agrupamento'
      ''
      ' )'
      '%Final_Vendas_Frente_de_Caixa_2'
      ') as SomatorioVendas'
      ') as VendasTotal'
      ' group by VendasVendedores.vendedor,'
      '          VendasVendedores.nomevendedor,'
      '          VendasVendedores.ValorMercadoria,'
      '          VendasVendedores.percdesconto,'
      '          VendasVendedores.desconto,'
      '          VendasVendedores.ValorLiquidoVendedor,'
      '          VendasVendedores.eFinanceiro,'
      '          VendasVendedores.Notas,'
      '          VendasVendedores.produtos,'
      '          VendasVendedores.ValorTotal,'
      '          VendasVendedores.ValorVista,'
      '          VendasVendedores.ValorPrazo,'
      #9'  vendasVendedores.creditotroca'
      ''
      ') as vendas'
      ')'
      '%Final_VendasContratoseFrenteCaixa'
      '%Inicio_Devolucoes_Contratos'
      'union all'
      ''
      '('
      'select vendedor,           '
      '         nome as nomevendedor,'
      '         -sum((valorvista+desconto)) as ValorMercadoria,'
      
        '         -(sum(desconto)*100)/(COALESCE(NULLIF((sum(valorvista+d' +
        'esconto)),0),1)) as percdesconto,'
      '         -sum(desconto) as desconto,'
      '         -sum(valorvista) as ValorLiquidoVendedor,'
      '         -sum(ValorPrazo-ValorVista) as eFinanceiro,'
      '         -count(*) as Notas,'
      '         -sum(quantidade) as produtos,'
      '         -sum(ValorPrazo) as ValorTotal,'
      
        #9' -sum(case when not ContratoeAPrazo then ValorPrazo else 0 end)' +
        ' as ValorVista,'
      
        #9' -sum(case when ContratoeAPrazo then valorprazo else 0 end) as ' +
        'ValorPrazo,'
      #9' sum(creditotroca) as creditotroca,'
      #9' cast(null as numeric) as ValorTotalGeral,'
      #9' cast(null as numeric) as Percentual,'
      #9' '#39'B_Devolucoes'#39' as tipo'
      ''
      'from'
      ''
      '  ('
      '    select devolucoes.*'
      '    from'
      '    (  '
      '      ('
      '       select'
      '           u.codigo as vendedor,'
      '           u.nome,'
      '           devolucoes.valorvista,'
      '           devolucoes.valorprazo,'
      '           devolucoes.desconto,'
      '           devolucoes.frete,'
      '           devolucoes.seguro,'
      '           devolucoes.quantidade,'
      '           (select exists (select p.contrato'
      '                           from parcelas p'
      '                   where p.contrato = ct.numero and'
      
        '                         p.datavencto > ct.faturamento)) as Cont' +
        'ratoeAPrazo,'
      '           coalesce(ct.creditotroca,0) as creditotroca'
      '           from'
      '        ('
      '         ('
      '               select'
      '               cd.contrato,'
      '               sum(cd.valorvista) as valorvista,'
      '               sum(cd.valorprazo) as valorprazo,'
      
        '               sum(coalesce(cd.desconto,0)+coalesce(cd.valordesc' +
        'ontoitem,0)) as desconto,'
      '               sum(cd.frete) as frete,'
      '               sum(cd.seguro) as seguro,'
      '               sum(cd.quantidade) as quantidade'
      '               from (contratosdevolvidos cd'
      '                     join (((contratos ct'
      '                             join (usuarios u'
      '                                 left join GruposUsuarios gu'
      '                                 on u.grupo = gu.codigo)'
      '                              on ct.vendedor=u.codigo)'
      ''
      '                              join vfornecedores vf'
      '                              on ct.cliente = vf.codigo and'
      '                                ct.tipocliente = vf.tipo)'
      ''
      
        '                               join (filiais f left join (filiai' +
        'sgruposfiliais fgf  join gruposfiliais gf on fgf.grupo=gf.codigo' +
        ')'
      
        '                                                                ' +
        '                  on f.codigo=fgf.filial)'
      
        '                                          on ct.filialvenda=f.co' +
        'digo)'
      '                    on cd.contrato=ct.numero)'
      ''
      
        '              where cd.devolucao between(:DataInicial) and (:Dat' +
        'aFinal)'
      '                and cd.tipo='#39'D'#39
      
        '                and case when ct.os then ct.tipoequipamento in (' +
        '1,2) and not (coalesce(ct.os_garantia,false) and ct.os_garantia_' +
        'status='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      ''
      '           %Devolucoes'
      '           %Filiais'
      '           %Clientes'
      '           %ProdutosDevolucoes'
      '           %Vendedores'
      '           %GruposVendedores'
      '           %Agrupamento'
      ''
      '              group by cd.contrato'
      '         )'
      '         union all'
      '         ('
      '          select ct.numero as contrato,'
      '             ct.valorvista,'
      '             ct.valorprazo,'
      ''
      '                         (coalesce(ct.desconto, 0) +'
      
        '                         coalesce((SELECT sum(pc.valordescontoit' +
        'em)'
      '                          FROM produtoscontratos pc'
      
        '                                      WHERE ct.numero=pc.contrat' +
        'o),0)) AS desconto,'
      ''
      '             coalesce(ct.frete,0) as frete,'
      '             coalesce(ct.seguro,0) as seguro,'
      
        '                     (coalesce((select sum(pc.quantidade) from p' +
        'rodutoscontratos pc where ct.numero=pc.contrato and not pc.brind' +
        'e),0)+'
      
        '                      coalesce((select sum(sc.quantidade) from s' +
        'ervicoscontratos sc where ct.numero=sc.contrato),0)) as quantida' +
        'de'
      ''
      '          from (select distinct ct.numero'
      '            from contratos ct, parcelas p'
      '            where ct.numero=p.contrato and'
      '            ct.situacao='#39'C'#39' and'
      '            not exists (select p2.numero'
      '                    from parcelas p2'
      '                    where p2.contrato = ct.numero and'
      '                        p2.tipopagto<>'#39'E'#39') and'
      '            p.datapagto between :datainicial and :datafinal and'
      
        '                                              not exists (select' +
        ' cd.contrato '
      
        '                                                               f' +
        'rom contratosdevolvidos cd'
      
        '                                                               w' +
        'here cd.contrato = ct.numero and cd.tipo='#39'D'#39')'
      
        '                    and case when ct.os then ct.tipoequipamento ' +
        'in (1,2) and not (coalesce(ct.os_garantia,false) and ct.os_garan' +
        'tia_status='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true' +
        ' end'
      '            ) as cancelados, (((contratos ct'
      ''
      '                               join (usuarios u'
      '                                     left join GruposUsuarios gu'
      '                                     on u.grupo = gu.codigo)'
      '                               on ct.vendedor=u.codigo)'
      ''
      '                              join vfornecedores vf'
      '                              on ct.cliente = vf.codigo and'
      '                                 ct.tipocliente = vf.tipo)'
      ''
      
        '                              join (filiais f left join (filiais' +
        'gruposfiliais fgf  join gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                  on f.codigo=fgf.filial)'
      
        '                                          on ct.filialvenda=f.co' +
        'digo)'
      ''
      ''
      '          where cancelados.numero = ct.numero'
      ''
      '               %Devolucoes'
      '               %Filiais'
      '               %Clientes'
      '               %ProdutoseServicosContratos'
      '               %Vendedores'
      '               %GruposVendedores'
      '               %Agrupamento'
      ''
      '         )'
      '        ) as devolucoes,'
      '         (contratos ct join usuarios u on ct.vendedor=u.codigo)'
      '         where devolucoes.contrato=ct.numero'
      '      )'
      '      union all'
      '      ('
      '           select '
      '           u.codigo as vendedor,'
      '           u.nome,'
      '           np.valornota as valorvista,'
      '           np.valornota as valorprazo,                     '
      
        '           coalesce(np.desconto,0)+ coalesce(np.descontoitem,0) ' +
        'as desconto,'
      '           coalesce(np.freteinterno,  0) as frete,'
      '           coalesce(np.seguro,0) as seguro,'
      '           '
      
        '           coalesce((select sum(pnp.quantidade) from produtosnot' +
        'aspag pnp where pnp.codigonota=np.codigo),0) as quantidade,'
      '           false as ContratoeAPrazo,'
      '           0.00 as creditotroca'
      '              '
      '               '
      '         from (((notaspag np'
      '                join vfornecedores vf'
      '                on np.fornecedor = vf.codigo and'
      '                   np.tipofornecedor = vf.tipo)'
      ''
      '                left join (usuarios u'
      '                           left join GruposUsuarios gu'
      '                           on u.grupo = gu.codigo)'
      '                on np.vendedor=u.codigo)'
      ''
      
        '                join (filiais f left join (filiaisgruposfiliais ' +
        'fgf  join gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                  on f.codigo=fgf.filial)'
      
        '                                          on np.filial = f.codig' +
        'o)'
      ''
      
        '         Where (np.data between (:DataInicial) and (:DataFinal) ' +
        'and situacao='#39'N'#39')'
      '           and np.contrato is null'
      '           and ehnotafiscalentradadevolucao(np.codigofiscal)'
      ''
      ''
      ''
      '        %Devolucoes_np'
      '        %Filiais'
      '        %Clientes'
      '        %ProdutosNotasPag'
      '        %Vendedores'
      '        %GruposVendedores'
      '        %Agrupamento_np'
      ''
      '      )'
      '    ) as devolucoes'
      '  ) as devolucoes'
      '  group by vendedor, nome'
      ')'
      '%Final_Devolucoes_Contratos'
      'order by tipo,percentual desc')
    RequestLive = False
    Left = 583
    Top = 28
    ParamData = <
      item
        DataType = ftDate
        Name = 'DataInicial'
        ParamType = ptUnknown
        Value = #39'01/09/2005'#39
      end
      item
        DataType = ftDate
        Name = 'DataFinal'
        ParamType = ptUnknown
        Value = #39'01/09/2005'#39
      end>
