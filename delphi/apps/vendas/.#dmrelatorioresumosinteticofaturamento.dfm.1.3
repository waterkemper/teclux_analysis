        '        coalesce((select sum(sdf.quantidade) from servicosdadosf' +
        'iscais sdf where df.numero=sdf.dadofiscal),0)) as Produtos,'
      #9'false as ContratoeAPrazo,'
      #9'0.00 as creditotroca'
      
        '  from (dadosfiscais df left join usuarios u on df.vendedor=u.co' +
