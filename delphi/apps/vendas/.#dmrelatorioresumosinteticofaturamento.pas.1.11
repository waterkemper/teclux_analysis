  FR_Class, FR_DSet, FR_DBSet, ctconstantes, biblio, cpdatasource,
  clparametrossistema, fmpreviewpadrao, FR_Desgn, ZTransact;

type
  Tdtmrelatorioresumosinteticofaturamento = class(TdtmBasico)
    qryFiliaisTipodePlano: TtecQuery;
    fdsFiliaisTipodePlano: TfrDBDataSet;
    frpRes_SinteticoFiliais: TfrReport;
