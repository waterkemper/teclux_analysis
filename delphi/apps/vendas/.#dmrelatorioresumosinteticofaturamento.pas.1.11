    qryFiliaisClasseProdutos.MacroByName('Inicio_Vendas_Contratos_1').AsString := '/* inicio vendas por contrato ';
    qryFiliaisClasseProdutos.MacroByName('Final_Vendas_Contratos_1').AsString := ' final vendas por contrato */';
    qryFiliaisVendedores.MacroByName('Inicio_Vendas_Contratos_1').AsString := '/* inicio vendas por contrato ';
    qryFiliaisVendedores.MacroByName('Final_Vendas_Contratos_1').AsString := ' final vendas por contrato */';
    qryFiliaisTipodePlano.MacroByName('Inicio_Vendas_Contratos_2').AsString := '/* inicio vendas por contrato ';
    qryFiliaisTipodePlano.MacroByName('Final_Vendas_Contratos_2').AsString := ' final vendas por contrato */';
    qryFiliaisClasseProdutos.MacroByName('Inicio_Vendas_Contratos_2').AsString := '/* inicio vendas por contrato ';
    qryFiliaisClasseProdutos.MacroByName('Final_Vendas_Contratos_2').AsString := ' final vendas por contrato */';
    qryFiliaisVendedores.MacroByName('Inicio_Vendas_Contratos_2').AsString := '/* inicio vendas por contrato ';
    qryFiliaisVendedores.MacroByName('Final_Vendas_Contratos_2').AsString := ' final vendas por contrato */';
  end;
end;

procedure Tdtmrelatorioresumosinteticofaturamento.SetRecebimentosporFrenteCaixa(
  const Value: Boolean);
begin
  FRecebimentosporFrenteCaixa := Value;
  if value then
  begin
    if FRecebimentosporContrato then
    begin
      qryRes_SinteticoFiliais.Sql[NumerodalinhanoTexto(qryRes_SinteticoFiliais.Sql,'%Final_Vendas_Contratos')+1] := 'union';
      qryFiliaisTipodePlano.Sql[NumerodalinhanoTexto(qryFiliaisTipodePlano.Sql,'%Final_Vendas_Contratos_1')+1] := 'union all';
      qryFiliaisTipodePlano.Sql[NumerodalinhanoTexto(qryFiliaisTipodePlano.Sql,'%Final_Vendas_Contratos_2')+1] := 'union all';
      qryFiliaisClasseProdutos.Sql[NumerodalinhanoTexto(qryFiliaisClasseProdutos.Sql,'%Final_Vendas_Contratos_1')+1] := 'union all';
      qryFiliaisClasseProdutos.Sql[NumerodalinhanoTexto(qryFiliaisClasseProdutos.Sql,'%Final_Vendas_Contratos_2')+1] := 'union all';
      qryFiliaisVendedores.Sql[NumerodalinhanoTexto(qryFiliaisVendedores.Sql,'%Final_Vendas_Contratos_1')+1] := 'union all';
      qryFiliaisVendedores.Sql[NumerodalinhanoTexto(qryFiliaisVendedores.Sql,'%Final_Vendas_Contratos_2')+1] := 'union all';
    end
    else
    begin
      qryRes_SinteticoFiliais.Sql[NumerodalinhanoTexto(qryRes_SinteticoFiliais.Sql,'%Final_Vendas_Contratos')+1] := '';
      qryFiliaisTipodePlano.Sql[NumerodalinhanoTexto(qryFiliaisTipodePlano.Sql,'%Final_Vendas_Contratos_1')+1] := '';
      qryFiliaisTipodePlano.Sql[NumerodalinhanoTexto(qryFiliaisTipodePlano.Sql,'%Final_Vendas_Contratos_2')+1] := '';
      qryFiliaisClasseProdutos.Sql[NumerodalinhanoTexto(qryFiliaisClasseProdutos.Sql,'%Final_Vendas_Contratos_1')+1] := '';
      qryFiliaisClasseProdutos.Sql[NumerodalinhanoTexto(qryFiliaisClasseProdutos.Sql,'%Final_Vendas_Contratos_2')+1] := '';
      qryFiliaisVendedores.Sql[NumerodalinhanoTexto(qryFiliaisVendedores.Sql,'%Final_Vendas_Contratos_1')+1] := '';
      qryFiliaisVendedores.Sql[NumerodalinhanoTexto(qryFiliaisVendedores.Sql,'%Final_Vendas_Contratos_2')+1] := '';
    end;
    qryRes_SinteticoFiliais.MacroByName('Inicio_Vendas_Frente_de_Caixa').AsString := '/* inicio vendas frente de caixa */';
    qryRes_SinteticoFiliais.MacroByName('Final_Vendas_Frente_de_Caixa').AsString := '/* final vendas frente de caixa */';
    qryFiliaisTipodePlano.MacroByName('Inicio_Vendas_Frente_de_Caixa_1').AsString := '/* inicio vendas frente de caixa */';
    qryFiliaisTipodePlano.MacroByName('Final_Vendas_Frente_de_Caixa_1').AsString := '/* final vendas frente de caixa */';
    qryFiliaisClasseProdutos.MacroByName('Inicio_Vendas_Frente_de_Caixa_1').AsString := '/* inicio vendas frente de caixa */';
    qryFiliaisClasseProdutos.MacroByName('Final_Vendas_Frente_de_Caixa_1').AsString := '/* final vendas frente de caixa */';
    qryFiliaisVendedores.MacroByName('Inicio_Vendas_Frente_de_Caixa_1').AsString := '/* inicio vendas frente de caixa */';
    qryFiliaisVendedores.MacroByName('Final_Vendas_Frente_de_Caixa_1').AsString := '/* final vendas frente de caixa */';
    qryFiliaisTipodePlano.MacroByName('Inicio_Vendas_Frente_de_Caixa_2').AsString := '/* inicio vendas frente de caixa */';
    qryFiliaisTipodePlano.MacroByName('Final_Vendas_Frente_de_Caixa_2').AsString := '/* final vendas frente de caixa */';
    qryFiliaisClasseProdutos.MacroByName('Inicio_Vendas_Frente_de_Caixa_2').AsString := '/* inicio vendas frente de caixa */';
    qryFiliaisClasseProdutos.MacroByName('Final_Vendas_Frente_de_Caixa_2').AsString := '/* final vendas frente de caixa */';
    qryFiliaisVendedores.MacroByName('Inicio_Vendas_Frente_de_Caixa_2').AsString := '/* inicio vendas frente de caixa */';
    qryFiliaisVendedores.MacroByName('Final_Vendas_Frente_de_Caixa_2').AsString := '/* final vendas frente de caixa */';
  end
  else
  begin
    qryRes_SinteticoFiliais.Sql[NumerodalinhanoTexto(qryRes_SinteticoFiliais.Sql,'%Final_Vendas_Contratos')+1] := '';
    qryFiliaisTipodePlano.Sql[NumerodalinhanoTexto(qryFiliaisTipodePlano.Sql,'%Final_Vendas_Contratos_1')+1] := '';
    qryFiliaisTipodePlano.Sql[NumerodalinhanoTexto(qryFiliaisTipodePlano.Sql,'%Final_Vendas_Contratos_2')+1] := '';
    qryFiliaisClasseProdutos.Sql[NumerodalinhanoTexto(qryFiliaisClasseProdutos.Sql,'%Final_Vendas_Contratos_1')+1] := '';
    qryFiliaisClasseProdutos.Sql[NumerodalinhanoTexto(qryFiliaisClasseProdutos.Sql,'%Final_Vendas_Contratos_2')+1] := '';
    qryFiliaisVendedores.Sql[NumerodalinhanoTexto(qryFiliaisVendedores.Sql,'%Final_Vendas_Contratos_1')+1] := '';
    qryFiliaisVendedores.Sql[NumerodalinhanoTexto(qryFiliaisVendedores.Sql,'%Final_Vendas_Contratos_2')+1] := '';

    qryRes_SinteticoFiliais.MacroByName('Inicio_Vendas_Frente_de_Caixa').AsString := '/* inicio vendas frente de caixa ';
    qryRes_SinteticoFiliais.MacroByName('Final_Vendas_Frente_de_Caixa').AsString := ' final vendas frente de caixa */';
    qryFiliaisTipodePlano.MacroByName('Inicio_Vendas_Frente_de_Caixa_1').AsString := '/* inicio vendas frente de caixa ';
    qryFiliaisTipodePlano.MacroByName('Final_Vendas_Frente_de_Caixa_1').AsString := ' final vendas frente de caixa */';
    qryFiliaisClasseProdutos.MacroByName('Inicio_Vendas_Frente_de_Caixa_1').AsString := '/* inicio vendas frente de caixa ';
    qryFiliaisClasseProdutos.MacroByName('Final_Vendas_Frente_de_Caixa_1').AsString := ' final vendas frente de caixa */';
    qryFiliaisVendedores.MacroByName('Inicio_Vendas_Frente_de_Caixa_1').AsString := '/* inicio vendas frente de caixa ';
    qryFiliaisVendedores.MacroByName('Final_Vendas_Frente_de_Caixa_1').AsString := ' final vendas frente de caixa */';
    qryFiliaisTipodePlano.MacroByName('Inicio_Vendas_Frente_de_Caixa_2').AsString := '/* inicio vendas frente de caixa ';
    qryFiliaisTipodePlano.MacroByName('Final_Vendas_Frente_de_Caixa_2').AsString := ' final vendas frente de caixa */';
    qryFiliaisClasseProdutos.MacroByName('Inicio_Vendas_Frente_de_Caixa_2').AsString := '/* inicio vendas frente de caixa ';
    qryFiliaisClasseProdutos.MacroByName('Final_Vendas_Frente_de_Caixa_2').AsString := ' final vendas frente de caixa */';
    qryFiliaisVendedores.MacroByName('Inicio_Vendas_Frente_de_Caixa_2').AsString := '/* inicio vendas frente de caixa ';
    qryFiliaisVendedores.MacroByName('Final_Vendas_Frente_de_Caixa_2').AsString := ' final vendas frente de caixa */';
  end;
end;

function Tdtmrelatorioresumosinteticofaturamento.AbrirRelatorio: Boolean;
begin
  refazconsulta(qryRes_SinteticoFiliais,[],[]);
  result := not qryRes_SinteticoFiliais.isempty;
end;

{procedure Tdtmrelatorioresumosinteticofaturamento.ZMonitor1MonitorEvent(
  Sql, Result: String);
var
 Listar : TStringList;
begin
  inherited;
  Listar := tStringlist.create;
  if fileexists('/tmp/log.txt') then
    Listar.loadfromfile('/tmp/log.txt');
  Listar.add('');
  Listar.add(sql);
  Listar.add(result);
  listar.savetofile('/tmp/log.txt');
  listar.free;
end;}


procedure Tdtmrelatorioresumosinteticofaturamento.SetCondicaoClientes(
  const Value: String);
begin
  fCondicaoClientes := Value;
  if value <> '' then
  begin
    qryRes_SinteticoFiliais.MacroByName('Clientes').AsString := ' and (' + fCondicaoClientes + ')';
    qryFiliaisTipodePlano.MacroByName('Clientes').AsString := ' and (' + fCondicaoClientes + ')';
    qryFiliaisClasseProdutos.MacroByName('Clientes').AsString := ' and (' + fCondicaoClientes + ')';
    qryFiliaisVendedores.MacroByName('Clientes').AsString := ' and (' + fCondicaoClientes + ')';
  end
  else
  begin
    qryRes_SinteticoFiliais.MacroByName('Clientes').AsString := '';
    qryFiliaisTipodePlano.MacroByName('Clientes').AsString := '';
    qryFiliaisClasseProdutos.MacroByName('Clientes').AsString := '';
    qryFiliaisVendedores.MacroByName('Clientes').AsString := '';
  end;
end;

procedure Tdtmrelatorioresumosinteticofaturamento.SetGruposVendedores(
  const Value: String);

  var
    CondicaoGruposVendedores: String;

begin
 if (Value <> '') then
 begin
   CondicaoGruposVendedores := ' and ' + Value;
   FParametroCabecalho:=FParametroCabecalho+' Grupos de Vendedores: '+Value;
 end
 else
   CondicaoGruposVendedores := '';

 qryRes_SinteticoFiliais.MacroByName('GruposVendedores').AsString  := CondicaoGruposVendedores;
 qryFiliaisTipodePlano.MacroByName('GruposVendedores').AsString    := CondicaoGruposVendedores;
 qryFiliaisClasseProdutos.MacroByName('GruposVendedores').AsString := CondicaoGruposVendedores;
 qryFiliaisVendedores.MacroByName('GruposVendedores').AsString     := CondicaoGruposVendedores;
end;

end.
