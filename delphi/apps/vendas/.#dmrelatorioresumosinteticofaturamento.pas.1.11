    qryRes_SinteticoFiliais.MacroByName('Final_Vendas_Contratos').AsString := ' final vendas por contrato */';
    qryFiliaisTipodePlano.MacroByName('Inicio_Vendas_Contratos_1').AsString := '/* inicio vendas por contrato ';
