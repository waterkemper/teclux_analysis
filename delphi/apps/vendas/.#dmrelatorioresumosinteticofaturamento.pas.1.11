    qryRes_SinteticoFiliaisgrupofilialvenda: TIntegerField;
    qryRes_SinteticoFiliaisnomegrupofilialvenda: TStringField;
    qryRes_SinteticoFiliaisvendedor: TIntegerField;
    qryRes_SinteticoFiliaisnomevendedor: TStringField;
    qryFiliaisClasseProdutosclasse: TStringField;
    qryFiliaisClasseProdutosnomeclasse: TStringField;
    qryFiliaisClasseProdutosvalorliquidoproduto: TFloatField;
    qryFiliaisVendedoresvendedor: TIntegerField;
