    Sql.Strings = (
      'Select pt.tipo,'
      ' pt.data,'
      ' pt.cliente,'
      
        ' (select c.nome from clientes c where c.codigo = pt.cliente) as ' +
        'nomecliente,'
      ' pt.produto,'
      
        ' (select p.descricao from produtos p where p.codigo = pt.produto' +
        ') as DescricaoProduto,'
      
        ' (Select grupo from(select * from (Select p.codigo, c.grupo from' +
        ' caracteristicas c, produtos p where c.codigo = p.caracteristica' +
        ')as temp)as temp2 where codigo = pt.produto)as Grupo,'
      
        ' (Select Classe from(select * from (Select p.codigo, c.classe fr' +
        'om caracteristicas c, produtos p where c.codigo = p.caracteristi' +
        'ca)as temp)as temp2 where codigo = pt.produto)as Classe,'
      ' pt.filial,'
      ' pt.contrato,'
      ' pt.valor,'
      ' pt.saldo,'
      ' (select pt2.saldo'
      '    from produtostrocados pt2'
      '      where pt2.cliente = pt.cliente'
      '      order by pt2.data desc limit 1) as SaldoAtualCliente,'
      
        ' (case when pt.tipo = '#39'E'#39' then pt.valor else -pt.valor end) as S' +
        'aldoTotal,'
      ' cast(0 as numeric) as saldofinal,'
      ' pt.referencia,'
      ' pt.usuario,'
      
        ' (Select u.nome from usuarios u where u.codigo = pt.usuario) as ' +
        'usuarios,'
      ' pt.usuarioautorizacao,'
      
        ' (Select u.nome from usuarios u where u.codigo = pt.usuarioautor' +
        'izacao) as NomeUsuariosAutorizacao,'
      ' pt.evento,'
      
        ' (select e.descricao from eventos e where e.codigo = pt.evento) ' +
        'as DescricaoEvento'
      'from produtostrocados pt'
      'WHERE true'
      '%Filtros'
      'order by pt.cliente, pt.data')
