procedure TdtmRelatorioSaldoCredito.SetTipo(const Value: Integer);
begin
  FTipo := Value;
  Case Value of
    0: FParametroCabecalho:= FParametroCabecalho + 'Entrada e Saída ';
    1: FParametroCabecalho:= FParametroCabecalho + 'Entradas ';
    2: FParametroCabecalho:= FParametroCabecalho + 'Saída ';
    3: FParametroCabecalho:= FParametroCabecalho + ' ';
  end;
end;

procedure TdtmRelatorioSaldoCredito.SetUsuario(const Value: String);
begin
  FUsuario := Value;
end;

procedure TdtmRelatorioSaldoCredito.ZMonitor1MonitorEvent(Sql,
  Result: String);
var
 Listar : TStringList;
 arquivo: String;
begin
  inherited;
  Listar := tStringlist.Create;
  arquivo := 'c:\Lixo\Saldocredito.sql';
  if fileexists(arquivo) then
    Listar.loadfromfile(arquivo);
  Listar.add('');
  Listar.add(sql);
  Listar.add(result);
  listar.savetofile(arquivo);
  listar.free;
end;

procedure TdtmRelatorioSaldoCredito.frpSaldoCreditoBeforePrint(
  Memo: TStringList; View: TfrView);
begin
  inherited;
  ZebrarLinhaRelatorio(frpSaldoCredito, View);
end;

procedure TdtmRelatorioSaldoCredito.qrySaldosCreditoCalcFields(DataSet: TDataSet);
begin
  inherited;
  if qrySaldosCreditoreferencia.AsString<>'' then
    qrySaldosCreditoDescricao.AsString := qrySaldosCreditoreferencia.AsString
  else
  if qrySaldosCreditotipo.AsString = 'E' then
  begin
   if qrySaldosCreditoproduto.AsString <> '' then
     qrySaldosCreditoDescricao.AsString := qrySaldosCreditoDescricaoProduto.asstring
   else
     if qrySaldosCreditocontrato.asstring<>'' then
       qrySaldosCreditoDescricao.AsString := 'ENTRADA CANCELAMENTO CONTRATO '+qrySaldosCreditocontrato.asstring;
  end
  else
  begin
   if qrySaldosCreditoproduto.AsString <> '' then
     qrySaldosCreditoDescricao.AsString := qrySaldosCreditoDescricaoProduto.asstring
   else
     if qrySaldosCreditocontrato.asstring<>'' then
       qrySaldosCreditoDescricao.AsString := 'SAIDA NO CONTRATO '+qrySaldosCreditocontrato.asstring;
  end;
end;

procedure TdtmRelatorioSaldoCredito.SetSomenteClientescomSaldo(
  const Value: Boolean);
begin
  FSomenteClientescomSaldo := Value;
  if FSomenteClientescomSaldo then
   ParametroCabecalho:= ParametroCabecalho + 'Somente Clientes com Saldo ';
end;

end.
