implementation

{$R *.dfm}

{ TdtmRelatorioSaldoCredito }

function TdtmRelatorioSaldoCredito.AbrirRelatorio: Boolean;
begin
  qrySaldosCredito.Open;
  Result:= not qrySaldosCredito.IsEmpty;
end;

constructor TdtmRelatorioSaldoCredito.Create(AOwner: TComponent);
begin
  inherited;
end;

destructor TdtmRelatorioSaldoCredito.Destroy;
begin
  inherited;
end;

procedure TdtmRelatorioSaldoCredito.ImprimirRelatorio;
begin
//  frpSaldoCredito.designreport;
  ImprimirRelatoriofast('RELATÓRIO DE SALDOS DE CRÉDITO', FParametroCabecalho, MSimples, 0, [frpSaldoCredito]);
end;

procedure TdtmRelatorioSaldoCredito.MontarSQL;
begin
  FFiltroSQL:= '';

  if FGrupoFiliais <> '' then
    FFiltroSQL:= FFiltroSQL + ' and pt.filial in (Select filial From filiaisgruposfiliais where grupo = '+FGrupoFiliais+')'+slinebreak+'';

  if FFiliais <> '' then
    FFiltroSQL:= FFiltroSQL + ' and ((pt.filial = '+FFiliais+') or (pt.filial is null))'+slinebreak;

  if fCliente <> '' then
    FFiltroSQL:= FFiltroSQL + ' and pt.cliente = '+fCliente + ' and pt.tipocliente = ' + quotedstr(tipocliente) +  slinebreak+'';

  if FItemProduto <> '' then
    FFiltroSQL:= FFiltroSQL + ' and  ((Select p.caracteristica from produtos p where p.codigo = pt.produto) = '+FItemProduto+')'+slinebreak+'';

  if FGrupo <> '' then
    FFiltroSQL:= FFiltroSQL + ' and  (Select grupo from'+
                                        '(select * from '+
                                           '(Select p.codigo, c.grupo '+
                                               'from caracteristicas c, produtos p where c.codigo = p.caracteristica)as temp)as temp2 where codigo = pt.produto) = '+FGrupo+slinebreak+'';

  if FClasse <> '' then
    FFiltroSQL:= FFiltroSQL + ' and  (Select Classe from'+
                                        '(select * from '+
                                            '(Select p.codigo, c.classe from caracteristicas c, produtos p where c.codigo = p.caracteristica)as temp)as temp2 where codigo = pt.produto) = '+quotedstr(FClasse)+slinebreak+'';

  if FEvento <> '' then
    FFiltroSQL:= FFiltroSQL + ' and  pt.evento = '+FEvento+slinebreak+'';

  if FUsuario <> '' then
    FFiltroSQL:= FFiltroSQL + ' and  pt.usuarioautorizacao = '+FUsuario+slinebreak+'';

  case FTipo of
    0 : FFiltroSQL:= FFiltroSQL + '';
    1 : FFiltroSQL:= FFiltroSQL + ' and  pt.tipo = ''E'''+slinebreak+'';
    2 : FFiltroSQL:= FFiltroSQL + ' and  pt.tipo = ''S'''+slinebreak+'';
    3 : FFiltroSQL:= FFiltroSQL + '';
  end;

  FFiltroSQL := FFiltroSQL + MontarIntervaloData('pt.data',FDataInicial,FDataFinal,true) + sLineBreak;

  if FSomenteLancamentosAvulsos then
    FFiltroSQL:= FFiltroSQL + 'and  pt.produto is null '+slinebreak+'';

  if FSomenteClientescomSaldo then
    FFiltroSQL:= FFiltroSQL + 'and coalesce((select pt2.saldo '+
                              'from produtostrocados pt2 '+
                              'where pt2.cliente = pt.cliente '+
                              'order by pt2.data desc limit 1),0)<>0 ';

  //Delete(FFiltroSQL,1,4);
//  FFiltroSQL:= FFiltroSQL;
  If FFiltroSQL = 'Where ' then
    FFiltroSQL := '';
  qrySaldosCredito.Close;
  qrySaldosCredito.MacroByName('Filtros').AsString:= FFiltroSQL;
end;

procedure TdtmRelatorioSaldoCredito.SetAgrupamento(const Value: Boolean);
begin
  FAgrupamento := Value;
end;

procedure TdtmRelatorioSaldoCredito.SetClasse(const Value: String);
begin
  FClasse := Value;
  If FClasse <> '' then
    FParametroCabecalho:= FParametroCabecalho + 'Classe '+Value+' ';
end;

