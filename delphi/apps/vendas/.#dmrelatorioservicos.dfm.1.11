  object qryRelatorioServicos_Vendas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereServicos'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select ct.filialvenda,'
      '       f.nome as nomefilialvenda,'
      '       fgf.grupo as grupofilialvenda,'
      '       gf.descricao as nomegrupofilialvenda,'
      '       ct.faturamento,'
      '       ct.numero as contrato,'
      '       ct.tipocliente,'
      '       ct.cliente,'
      '       ct.nome,'
      '       ct.situacao,'
      '       sc.servico,'
      '       s.descricao as descricaoservico,'
      '       sc.equipamento,'
      '       e.descricao as descricaoequipamento,'
      '       sc.quantidade,'
      '       sc.valorservico,'
      '      (sc.quantidade*sc.valorservico) as totalbruto,'
      
        '      ((sc.quantidade*sc.valorservico)*coalesce(ct.desconto))/(c' +
        't.valorvista+coalesce(ct.desconto,0)-coalesce(ct.frete,0)-coales' +
        'ce(ct.seguro,0)) as desconto,'
      
        '      (sc.quantidade*sc.valorservico)-(((sc.quantidade*sc.valors' +
        'ervico)*coalesce(ct.desconto))/(ct.valorvista+coalesce(ct.descon' +
        'to,0)-coalesce(ct.frete,0)-coalesce(ct.seguro,0))) as totalliqui' +
        'do'
      ''
      
        'from ((contratos ct join ((servicoscontratos sc join servicos s ' +
        'on sc.servico = s.codigo)'
      
        '                                           left join equipamento' +
        's e on sc.equipamento = e.codigo)'
      '                           on ct.numero = sc.contrato)'
      
        '                    join (filiais f left join (filiaisgruposfili' +
        'ais fgf left join gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '        on f.codigo=fgf.filial)'
      
        '                                    on ct.filialvenda = f.codigo' +
        ')'
      'where ct.faturamento between :datainicial and :datafinal'
      'AND ct.situacao in ('#39'F'#39','#39'C'#39','#39'P'#39','#39'N'#39')'
      ''
      '%WhereFiliais'
      '%WhereServicos'
      '')
    RequestLive = False
    Left = 464
    Top = 144
    ParamData = <
      item
        DataType = ftString
        Name = 'datainicial'
        ParamType = ptUnknown
        Value = #39'01/01/2006'#39
      end
      item
        DataType = ftString
        Name = 'datafinal'
        ParamType = ptUnknown
        Value = #39'31/12/2006'#39
      end>
  end
  object qryRelatorioServicos_Devolucoes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereServicos'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select ct.filialvenda,'
      '       f.nome as nomefilialvenda,'
      '       fgf.grupo as grupofilialvenda,'
      '       gf.descricao as nomegrupofilialvenda,'
      '       ct.faturamento,'
      '       ct.numero as contrato,'
      '       ct.tipocliente,'
      '       ct.cliente,'
      '       ct.nome,'
      '       ct.situacao,'
      '       sc.servico,'
      '       s.descricao as descricaoservico,'
      '       sc.equipamento,'
      '       e.descricao as descricaoequipamento,'
      '       sc.quantidade,'
      '       sc.valorservico,'
      '       - (sc.quantidade*sc.valorservico) as totalbruto,'
      
        '       - ((sc.quantidade*sc.valorservico)*coalesce(ct.desconto))' +
        '/(ct.valorvista+coalesce(ct.desconto,0)-coalesce(ct.frete,0)-coa' +
        'lesce(ct.seguro,0)) as desconto,'
      
        '       - ((sc.quantidade*sc.valorservico)-((sc.quantidade*sc.val' +
        'orservico)*coalesce(ct.desconto))/(ct.valorvista+coalesce(ct.des' +
        'conto,0)-coalesce(ct.frete,0)-coalesce(ct.seguro,0))) as totalli' +
        'quido'
      ''
      
        'from ((contratos ct join ((servicoscontratos sc join servicos s ' +
        'on sc.servico = s.codigo)'
      
        '                                           left join equipamento' +
        's e on sc.equipamento = e.codigo)'
      '                           on ct.numero = sc.contrato)'
      
        '                    join (filiais f left join (filiaisgruposfili' +
        'ais fgf left join gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '        on f.codigo=fgf.filial)'
      
        '                                    on ct.filialvenda = f.codigo' +
        ')'
      'where ct.situacao = '#39'C'#39
      '  and ct.numero in ((select distinct cd.contrato'
      '                     from contratosdevolvidos cd'
      ' '#9'  '#9'     where cd.contrato = ct.numero'
      #9#9'       and cd.tipo = '#39'D'#39
      #9#9'       and (select max(cd2.devolucao)'
      #9#9'            from contratosdevolvidos cd2'
      #9#9'            where cd2.contrato = ct.numero'
      
        #9#9#9'      and cd2.tipo = '#39'D'#39') between :datainicial and :datafinal' +
        ')'
      '                    union all'
      #9#9'    (select distinct p.contrato'
      #9#9'     from parcelas p'
      #9#9'     where not exists (select p2.numero'
      #9#9'                       from parcelas p2'
      #9#9#9#9'       where p2.contrato = ct.numero'
      #9#9#9#9'         and p2.tipopagto<>'#39'E'#39')'
      ' '#9#9'       and p.datapagto between :datainicial and :datafinal'
      #9#9'       and not exists (select cd.contrato'
      #9#9'                       from contratosdevolvidos cd'
      #9#9#9#9'       where cd.contrato = ct.numero'
      #9#9#9#9'         and cd.tipo='#39'D'#39'))'
      #9#9'     )'
      '%WhereFiliais'
      '%WhereServicos'
      '')
    RequestLive = False
    Left = 464
    Top = 192
    ParamData = <
      item
        DataType = ftString
        Name = 'datainicial'
        ParamType = ptUnknown
        Value = #39'01/01/2006'#39
      end
      item
        DataType = ftString
        Name = 'datafinal'
        ParamType = ptUnknown
        Value = #39'31/12/2006'#39
      end>
  end
end
