  object qryContratosDevNumerario: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'InicioSomatorio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'tipocliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'nomecliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FimSomatorio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereDevolucoes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereAgentes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereConceito'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereRegioes_ct'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereClientes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'whereTipodeVenda'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereOrdenacao_Cancelamentos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'InicioAgrupamentoSomatorio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereOrdenacao_Total_Vendas'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FimAgrupamentoSomatorio'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '%InicioSomatorio'
      '/*'
      '('
      ' select  cast(ncontrato as varchar) as ncontrato,'
      '          cast(filialvenda as integer) as filialvenda,'
      '          cast(nomefilialvenda as varchar) as nomefilialvenda,'
      '          cast(grupofilialvenda as integer) as grupofilialvenda,'
      
        '          cast(nomegrupofilialvenda as varchar) as nomegrupofili' +
        'alvenda,'
      '          cast(cliente as integer) as cliente,'
      '          cast(tipocliente as varchar) as tipocliente,'
      '          cast(nomecliente as varchar) as nomecliente,'
      '          cast(datavenda as date) as datavenda,'
      '          cast(sum(valorvista) as Numeric) as valorvista,'
      '          cast(sum(valortotal) as numeric) as valortotal,'
      
        '          cast(sum(vendamercadorias) as numeric) as vendamercado' +
        'rias,'
      '          cast(sum(vendaservicos) as numeric) as vendaservicos,'
      '          cast(sum(frete_seguro) as numeric) as frete_seguro,'
      '          cast(sum(desconto) as numeric) as desconto,'
      '          cast(contratoavista as boolean) as contratoavista,'
      '          cast(sum(CreditoTroca) as numeric) as CreditoTroca,'
      
        '          cast(sum(valorICMSSubstituicao) as numeric) as ValorIC' +
        'MSSubstituicao,'
      '          cast(sum(entradas) as numeric) as entradas,'
      '          cast(sum(qtparcelas) as integer) as qtparcelas,'
      '          cast(sum(aVista) as numeric) as aVista,'
      '          cast(sum(aPrazo) as numeric) as aPrazo,'
      '          cast(sum(eFinanceiro) as numeric) as eFinanceiro,'
      '          cast(Tipo as varchar) as tipo,'
      #9'  cast(TipoA as varchar) as tipoA,'
      #9'  cast(sum(valortotalABS) as numeric) as valortotalABS,'
      '          cast(sum(tregistros) as integer) as tregistros'
      ' from'
      ' ('
      '  select *'
      '  from'
      '  ('
      '   select  cast(ncontrato as varchar) as ncontrato,'
      '          cast(filialvenda as integer) as filialvenda,'
      '          cast(nomefilialvenda as varchar) as nomefilialvenda,'
      '          cast(grupofilialvenda as integer) as grupofilialvenda,'
      
        '          cast(nomegrupofilialvenda as varchar) as nomegrupofili' +
        'alvenda,'
      #9'  %cliente'
      '          cast(cliente as integer) as cliente,'
      #9'  %tipocliente'
      '          cast(tipocliente as varchar) as tipocliente,'
      #9'  %nomecliente'
      '          cast(nomecliente as varchar) as nomecliente,'
      '          cast(datavenda as date) as datavenda,'
      '          cast(sum(valorvista) as Numeric) as valorvista,'
      '          cast(sum(valortotal) as numeric) as valortotal,'
      
        '          cast(sum(vendamercadorias) as numeric) as vendamercado' +
        'rias,'
      '          cast(sum(vendaservicos) as numeric) as vendaservicos,'
      '          cast(sum(frete_seguro) as numeric) as frete_seguro,'
      '          cast(sum(desconto) as numeric) as desconto,'
      '          cast(contratoavista as boolean) as contratoavista,'
      '          cast(sum(CreditoTroca) as numeric) as CreditoTroca,'
      
        '          cast(sum(valorICMSSubstituicao) as numeric) as ValorIC' +
        'MSSubstituicao,'
      '          cast(sum(entradas) as numeric) as entradas,'
      '          cast(sum(qtparcelas) as integer) as qtparcelas,'
      '          cast(sum(aVista) as numeric) as aVista,'
      '          cast(sum(aPrazo) as numeric) as aPrazo,'
      '          cast(sum(eFinanceiro) as numeric) as eFinanceiro,'
      '          cast(Tipo as varchar) as tipo,'
      #9'  cast(TipoA as varchar) as tipoA,'
      #9'  cast(sum(valortotalABS) as numeric) as valortotalABS,'
      '          cast(sum(tregistros) as integer) as tregistros'
      '  from'
      ' ('
      '  select  cast(null as varchar) as ncontrato,'
      
        '          cast(case when :AgruparFilial then filialvenda else nu' +
        'll end as integer) as filialvenda,'
      
        '          cast(case when :AgruparFilial then nomefilialvenda els' +
        'e null end as varchar) as nomefilialvenda,'
      
        '          cast(case when :AgruparGrupoFilial then grupofilialven' +
        'da else null end as integer) as grupofilialvenda,'
      
        '          cast(case when :AgruparGrupoFilial then nomegrupofilia' +
        'lvenda else null end as varchar) as nomegrupofilialvenda,'
      
        '          cast(case when :MaioresClientes then cliente else null' +
        ' end as integer) as cliente,'
      
        '          cast(case when :MaioresClientes then tipocliente else ' +
        'null end as varchar) as tipocliente,'
      
        '          cast(case when :MaioresClientes then nomecliente else ' +
        #39'OUTROS'#39' end as varchar) as nomecliente,'
      '          cast('#39'01/01/1900'#39' as date) as datavenda,'
      '          cast(sum(valorvista) as Numeric) as valorvista,'
      '          cast(sum(valortotal) as numeric) as valortotal,'
      
        '          cast(sum(vendamercadorias) as numeric) as vendamercado' +
        'rias,'
      '          cast(sum(vendaservicos) as numeric) as vendaservicos,'
      '          cast(sum(frete_seguro) as numeric) as frete_seguro,'
      '          cast(sum(desconto) as numeric) as desconto,'
      '          cast(null as boolean) as contratoavista,'
      '          cast(sum(CreditoTroca) as numeric) as CreditoTroca,'
      
        '          cast(sum(valorICMSSubstituicao) as numeric) as ValorIC' +
        'MSSubstituicao,'
      '          cast(sum(entradas) as numeric) as entradas,'
      '          cast(sum(qtparcelas) as integer) as qtparcelas,'
      '          cast(sum(aVista) as numeric) as aVista,'
      '          cast(sum(aPrazo) as numeric) as aPrazo,'
      '          cast(sum(eFinanceiro) as numeric) as eFinanceiro,'
      '          cast(Tipo as varchar) as tipo,'
      #9'  cast(null as varchar) as tipoA,'
      #9'  cast(sum(valortotalABS) as numeric) as valortotalABS,'
      '          cast(sum(tregistros) as integer) as tregistros'
      '   from'
      '%FimSomatorio'
      '*/'
      '('
      '   select ncontrato,'
      '            filialvenda,'
      '            f.nome as nomefilialvenda,'
      '            fgf.grupo as grupofilialvenda,'
      '            gf.descricao as nomegrupofilialvenda,'
      '            cliente,'
      '            tipocliente,'
      '            nomecliente,'
      '            datavenda,'
      '            valorvista,'
      '            valortotal,'
      '            vendamercadorias,'
      '            vendaservicos,'
      '            frete_seguro, desconto,'
      '            contratoavista,'
      '            0 as CreditoTroca,'
      '            valoricmssubstituicao,'
      '            entradas,'
      '            qtparcelas,'
      '            aVista,'
      '            0 as aPrazo,'
      '            0 as EFinanceiro,'
      '            Cast('#39'C'#39' as varchar) as Tipo,'
      #9'    case when contratoavista then cast('#39'CT'#39' as varchar)'
      
        #9'         else                     cast('#39'CF'#39' as varchar) end as ' +
        'TipoA,'
      '            abs(ValorTotal) as ValorTotalABS,'
      '            cast(1 as integer) as tregistros'
      
        ' from (filiais f left join (filiaisgruposfiliais fgf join grupos' +
        'filiais gf on fgf.grupo=gf.codigo)'
      
        '                                                     on f.codigo' +
        '=fgf.filial),'
      ' ('
      '  select contratostipo_dn.*,'
      
        '         -case When contratoavista then  valorvencto  else 0 end' +
        ' as avista,'
      
        '         -case When contratoavista then 0 else  valorvencto  end' +
        ' as entradas'
      '   from'
      '   ( select contratos_dn.*,'
      '           (case when (select count(*)'
      #9'               from parcelas p'
      #9#9'       where   p.contrato = ncontrato and'
      
        '                               p.datavencto > faturamento) = 0 t' +
        'hen true'
      '                 else false end) as contratoavista'
      '     from'
      '    ('
      '        select p.contrato as ncontrato,'
      '                 ct.filialvenda,'
      '                 ct.cliente,'
      '                 ct.tipocliente,'
      '                 ct.nome as nomecliente,'
      '                 ct.faturamento,'
      '                 p.devcaixa as datavenda,'
      '                 0 as valorvista,'
      '                 0 as valortotal,'
      ''
      '                 0 as vendamercadorias,'
      
        '                 0 as vendaservicos, 0 as frete_seguro, 0 as des' +
        'conto,'
      '                 sum(valorpagto) as valorpagto,'
      '                 sum(valorvencto) as valorvencto,'
      '                 count(*) as qtparcelas,'
      '                 0.00  as valoricmssubstituicao'
      
        '        from (contratos ct join parcelas p on ct.numero=p.contra' +
        'to)'
      '        where (ct.origem is null)'
      
        '          and case when ct.os then ct.tipoequipamento in (1,2) e' +
        'lse true end'
      #9'  and (p.tipopagto is not null and p.tipopagto = '#39'X'#39')'
      #9'  and p.devcaixa between (:DataInicial) and (:DataFinal)'
      #9'  and (p.datavencto <= ct.faturamento)'
      #9'  and not p.parcelaadicional'
      '        %WhereDevolucoes'
      '        %WhereFiliais'
      '        %WhereAgentes'
      '        %WhereConceito'
      '        %WhereRegioes_ct'
      '        %WhereClientes'
      
        '        group by p.contrato, ct.filialvenda,ct.cliente,ct.tipocl' +
        'iente,ct.nome,ct.faturamento,p.devcaixa'
      '     ) as contratos_dn'
      '    ) as contratostipo_dn'
      '    %whereTipodeVenda'
      '    %WhereOrdenacao_Cancelamentos'
      ''
      '   ) as contratosparcelas_dn'
      '   where f.codigo=contratosparcelas_dn.filialvenda'
      ')'
      '%InicioAgrupamentoSomatorio'
      '/*'
      '  as contratossomados_dn'
      
        '  group by nomegrupofilialvenda, grupofilialvenda, nomefilialven' +
        'da, filialvenda, nomecliente, tipocliente, cliente, tipo'
      ' ) as contratosresomados_dn'
      
        '   group by nomegrupofilialvenda, grupofilialvenda, nomefilialve' +
        'nda, filialvenda, nomecliente, tipocliente, cliente, tipo, ncont' +
        'rato, datavenda, contratoavista, tipoA'
      ' ) as contratosresomados_selecionados_dn'
      '%WhereOrdenacao_Total_Vendas'
      ''
      ' ) as contratosresomados_reselecionados_dn'
      
        '   group by nomegrupofilialvenda, grupofilialvenda, nomefilialve' +
        'nda, filialvenda, nomecliente, tipocliente, cliente, tipo, ncont' +
        'rato, datavenda, contratoavista, tipoA'
      ')'
      '%FimAgrupamentoSomatorio'
      '*/')
    RequestLive = False
    Left = 341
    Top = 397
    ParamData = <
      item
        DataType = ftString
        Name = 'AgruparFilial'
        ParamType = ptUnknown
        Value = 'false'
      end
      item
        DataType = ftString
        Name = 'AgruparGrupoFilial'
        ParamType = ptUnknown
        Value = 'false'
      end
      item
        DataType = ftString
        Name = 'MaioresClientes'
        ParamType = ptUnknown
        Value = 'false'
      end
      item
        DataType = ftString
        Name = 'DataInicial'
        ParamType = ptUnknown
        Value = #39'10/08/2005'#39
      end
      item
        DataType = ftString
        Name = 'DataFinal'
        ParamType = ptUnknown
        Value = #39'10/08/2005'#39
      end>
  end
  object qryTotalizacao: TtecQuery
