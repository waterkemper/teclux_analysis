        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereOrdenacao_Total_Vendas'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FimAgrupamentoSomatorio'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '%InicioSomatorio'
      '/*'
      '('
      ' select  cast(ncontrato as varchar) as ncontrato,'
      '          cast(filialvenda as integer) as filialvenda,'
      '          cast(nomefilialvenda as varchar) as nomefilialvenda,'
      '          cast(grupofilialvenda as integer) as grupofilialvenda,'
      
        '          cast(nomegrupofilialvenda as varchar) as nomegrupofili' +
        'alvenda,'
      '          cast(cliente as integer) as cliente,'
      '          cast(tipocliente as varchar) as tipocliente,'
      '          cast(nomecliente as varchar) as nomecliente,'
      '          cast(datavenda as date) as datavenda,'
      '          cast(sum(valorvista) as Numeric) as valorvista,'
      '          cast(sum(valortotal) as numeric) as valortotal,'
      
        '          cast(sum(vendamercadorias) as numeric) as vendamercado' +
        'rias,'
      '          cast(sum(vendaservicos) as numeric) as vendaservicos,'
      '          cast(sum(frete_seguro) as numeric) as frete_seguro,'
      '          cast(sum(desconto) as numeric) as desconto,'
      '          cast(contratoavista as boolean) as contratoavista,'
      '          cast(sum(creditotroca) as numeric) as creditotroca,'
      
        '          cast(sum(valoricmssubstituicao) as numeric) as valoric' +
        'mssubstituicao,'
      '          cast(sum(entradas) as numeric) as entradas,'
      '          cast(sum(qtparcelas) as integer) as qtparcelas,'
      '          cast(sum(aVista) as numeric) as aVista,'
      '          cast(sum(aPrazo) as numeric) as aPrazo,'
      '          cast(sum(eFinanceiro) as numeric) as eFinanceiro,'
      
        '          cast(Tipo as varchar) as tipo, cast(TipoA as varchar) ' +
        'as tipoA, cast(sum(valortotalABS) as numeric) as valortotalABS,'
      '          cast(sum(tregistros) as numeric) as tregistros'
      ' from'
      ' ('
      '  select *'
      '  from'
      '  ('
      '   select  cast(ncontrato as varchar) as ncontrato,'
      '          cast(filialvenda as integer) as filialvenda,'
      '          cast(nomefilialvenda as varchar) as nomefilialvenda,'
      '          cast(grupofilialvenda as integer) as grupofilialvenda,'
      
        '          cast(nomegrupofilialvenda as varchar) as nomegrupofili' +
        'alvenda,'
      #9'  %cliente'
      '          cast(cliente as integer) as cliente,'
      #9'  %tipocliente'
      '          cast(tipocliente as varchar) as tipocliente,'
      #9'  %nomecliente'
      '          cast(nomecliente as varchar) as nomecliente,'
      '          cast(datavenda as date) as datavenda,'
      '          cast(sum(valorvista) as Numeric) as valorvista,'
      '          cast(sum(valortotal) as numeric) as valortotal,'
      
        '          cast(sum(vendamercadorias) as numeric) as vendamercado' +
        'rias,'
      '          cast(sum(vendaservicos) as numeric) as vendaservicos,'
      '          cast(sum(frete_seguro) as numeric) as frete_seguro,'
      '          cast(sum(desconto) as numeric) as desconto,'
      '          cast(contratoavista as boolean) as contratoavista,'
      '          cast(sum(creditotroca) as numeric) as creditotroca,'
      
        '          cast(sum(valoricmssubstituicao) as numeric) as valoric' +
        'mssubstituicao,'
      '          cast(sum(entradas) as numeric) as entradas,'
      '          cast(sum(qtparcelas) as integer) as qtparcelas,'
      '          cast(sum(aVista) as numeric) as aVista,'
      '          cast(sum(aPrazo) as numeric) as aPrazo,'
      '          cast(sum(eFinanceiro) as numeric) as eFinanceiro,'
      
        '          cast(Tipo as varchar) as tipo, cast(TipoA as varchar) ' +
        'as tipoA, cast(sum(valortotalABS) as numeric) as valortotalABS,'
      '          cast(sum(tregistros) as integer) as tregistros'
      '  from'
      ' ('
      '  select  cast(null as varchar) as ncontrato,'
      
        '          cast(case when :AgruparFilial then filialvenda else nu' +
        'll end as integer) as filialvenda,'
      
        '          cast(case when :AgruparFilial then nomefilialvenda els' +
        'e null end as varchar) as nomefilialvenda,'
      
        '          cast(case when :AgruparGrupoFilial then grupofilialven' +
        'da else null end as integer) as grupofilialvenda,'
      
        '          cast(case when :AgruparGrupoFilial then nomegrupofilia' +
        'lvenda else null end as varchar) as nomegrupofilialvenda,'
      
        '          cast(case when :MaioresClientes then cliente else null' +
        ' end as integer) as cliente,'
      
        '          cast(case when :MaioresClientes then tipocliente else ' +
        'null end as varchar) as tipocliente,'
      
        '          cast(case when :MaioresClientes then nomecliente else ' +
        #39'OUTROS'#39' end as varchar) as nomecliente,'
      '          cast('#39'01/01/1900'#39' as date) as datavenda,'
      '          cast(sum(valorvista) as Numeric) as valorvista,'
      '          cast(sum(valortotal) as numeric) as valortotal,'
      
        '          cast(sum(vendamercadorias) as numeric) as vendamercado' +
        'rias,'
      '          cast(sum(vendaservicos) as numeric) as vendaservicos,'
      '          cast(sum(frete_seguro) as numeric) as frete_seguro,'
      '          cast(sum(desconto) as numeric) as desconto,'
      '          cast(null as boolean) as contratoavista,'
      '          cast(sum(creditotroca) as numeric) as creditotroca,'
      
        '          cast(sum(valoricmssubstituicao) as numeric) as valoric' +
        'mssubstituicao,'
      '          cast(sum(entradas) as numeric) as entradas,'
      '          cast(sum(qtparcelas) as integer) as qtparcelas,'
      '          cast(sum(aVista) as numeric) as aVista,'
      '          cast(sum(aPrazo) as numeric) as aPrazo,'
      '          cast(sum(eFinanceiro) as numeric) as eFinanceiro,'
      
        '          cast(Tipo as varchar) as tipo, cast(null as varchar) a' +
        's tipoA, '
      '          cast(sum(valortotalABS) as numeric) as valortotalABS,'
      '          cast(sum(tregistros) as integer) as tregistros'
      '   from'
      '%FimSomatorio'
      '*/'
      '    ('
      '      select ncontrato,'
      '            filialvenda,'
      '            f.nome as nomefilialvenda,'
      '            fgf.grupo as grupofilialvenda,'
      '            gf.descricao as nomegrupofilialvenda,'
      '            cliente,'
      '            tipocliente,'
      '            nomecliente,'
      '            datavenda,'
      '            valorvista,'
      '            valortotal,'
      
        '            (valorvista-coalesce(vendaservicos,0)-frete-seguro-d' +
        'esconto) as vendamercadorias,'
      '            vendaservicos,'
      '            (frete+seguro) as frete_seguro,  desconto,'
      '            contratoavista,'
      '            - creditotroca as creditotroca,'
      '            - valoricmssubstituicao as valoricmssubstituicao,'
      '            entradas,'
      '            qtparcelas,'
      
        '            case when ContratoaVista then valortotal else 0 end ' +
        'as aVista,'
      
        '            case when ContratoaVista then 0 else valortotal-coal' +
        'esce(entradas,0) end as aPrazo,'
      '            ValorTotal-ValorVista as EFinanceiro,'
      
        '            Cast('#39'V'#39' as varchar) as Tipo, case when contratoavis' +
        'ta then cast('#39'VT'#39' as varchar) else cast('#39'VF'#39' as varchar) end as ' +
        'TipoA, abs(ValorTotal) as ValorTotalABS,'
      '            cast(1 as integer) as tregistros'
      
        '     from (filiais f left join (filiaisgruposfiliais fgf join gr' +
        'uposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                              on' +
        ' f.codigo=fgf.filial),'
      '     ('
      '       select contratostipo_v.*,'
      '          case when contratoavista then 0'
      
        '                                               else (select sum(' +
        'p.valorvencto)'
      
        '                                                       from parc' +
        'elas p where p.contrato = ncontrato and p.datavencto <= datavend' +
        'a)'
      '          end as entradas,'
      
        '          (select sum(quantidade*valorservico) from servicoscont' +
        'ratos sc Where sc.contrato=ncontrato) as vendaservicos,'
      
        '          (select cast(substr(p.parcelaorigem,strpos(p.parcelaor' +
        'igem,'#39'/'#39')+1,length(p.parcelaorigem)-((strpos(p.parcelaorigem,'#39'/'#39 +
        ')-1))) as integer) from parcelas p where p.contrato=ncontrato li' +
        'mit 1) as qtparcelas'
      ''
      '      from'
      '      ('
      '        select contratos_v.*,'
      '         case when (select count(*) from parcelas p where'
      '                   p.contrato = ncontrato and'
      '                   p.datavencto > datavenda) = 0 then true'
      '                                              else false'
      '          end as contratoavista'
      '       from'
      '       ('
      '        select'
      '         ct.numero as ncontrato,'
      '         ct.filialvenda,'
      '         ct.cliente,'
      '         ct.tipocliente,'
      '         ct.nome as nomecliente,'
      '         ct.faturamento as datavenda,'
      
        '         ct.valorvista, coalesce(ct.frete,0) as frete, coalesce(' +
        'ct.seguro,0) as seguro, -coalesce(ct.desconto,0) as desconto,'
      '         ct.valorprazo as valortotal,'
      '         ct.creditotroca,'
      '         ct.valoricmssubstituicao'
      '        from contratos ct'
      
        '        Where ct.origem is null and ct.faturamento between (:Dat' +
        'aInicial) and (:DataFinal)'
      
        '          and case when ct.os then ct.tipoequipamento in (1,2) e' +
        'lse true end'
      '        %WhereFiliais'
      '        %WhereAgentes'
      '        %WhereConceito'
      '        %WhereRegioes_ct'
      '        %WhereClientes'
      '       ) as contratos_v'
      '      ) as contratostipo_v'
      '      %whereTipodeVenda'
      '     ) as contratosparcelas_v'
      '       where f.codigo=contratosparcelas_v.filialvenda'
      '       %WhereOrdenacao_Vendas'
      ''
      '   )'
      ''
      '%InicioAgrupamentoSomatorio'
      '/*'
      '  as contratossomados_v'
      
        '  group by nomegrupofilialvenda, grupofilialvenda, nomefilialven' +
        'da, filialvenda, nomecliente, tipocliente, cliente, tipo'
      ' ) as contratosresomados_v'
      
        '   group by nomegrupofilialvenda, grupofilialvenda, nomefilialve' +
        'nda, filialvenda, nomecliente, tipocliente, cliente, tipo, ncont' +
        'rato, datavenda, contratoavista, tipoA'
      ' ) as contratosresomados_selecionados_v'
      '   %WhereOrdenacao_Total_Vendas'
      ''
      ' ) as contratosresomados_reselecionados_v'
      
        '   group by nomegrupofilialvenda, grupofilialvenda, nomefilialve' +
        'nda, filialvenda, nomecliente, tipocliente, cliente, tipo, ncont' +
        'rato, datavenda, contratoavista, tipoA'
      ')'
      '%FimAgrupamentoSomatorio'
      '*/')
    RequestLive = False
    Left = 340
    Top = 288
    ParamData = <
      item
        DataType = ftBoolean
        Name = 'AgruparFilial'
        ParamType = ptUnknown
        Value = False
      end
      item
        DataType = ftBoolean
        Name = 'AgruparGrupoFilial'
        ParamType = ptUnknown
        Value = 'false'
      end
      item
        DataType = ftBoolean
        Name = 'MaioresClientes'
        ParamType = ptUnknown
        Value = 'False'
      end
      item
        DataType = ftString
        Name = 'DataInicial'
        ParamType = ptUnknown
        Value = '10/08/2005'
      end
      item
        DataType = ftString
        Name = 'DataFinal'
        ParamType = ptUnknown
        Value = '10/08/2005'
      end>
  end
  object qryContratosDevolucoes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'InicioSomatorio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'tipocliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'nomecliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FimSomatorio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereDevolucoes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereAgentes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereConceito'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereRegioes_ct'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereClientes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'whereTipodeVenda'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereOrdenacao_Devolucoes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'InicioAgrupamentoSomatorio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereOrdenacao_Total_Vendas'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FimAgrupamentoSomatorio'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '%InicioSomatorio'
      '/*'
      '('
      ' select  cast(ncontrato as varchar) as ncontrato,'
      '          cast(filialvenda as integer) as filialvenda,'
      '          cast(nomefilialvenda as varchar) as nomefilialvenda,'
      '          cast(grupofilialvenda as integer) as grupofilialvenda,'
      
        '          cast(nomegrupofilialvenda as varchar) as nomegrupofili' +
        'alvenda,'
      '          cast(cliente as integer) as cliente,'
      '          cast(tipocliente as varchar) as tipocliente,'
      '          cast(nomecliente as varchar) as nomecliente,'
      '          cast(datavenda as date) as datavenda,'
      '          cast(sum(valorvista) as Numeric) as valorvista,'
      '          cast(sum(valortotal) as numeric) as valortotal,'
      
        '          cast(sum(vendamercadorias) as numeric) as vendamercado' +
        'rias,'
      '          cast(sum(vendaservicos) as numeric) as vendaservicos,'
      '          cast(sum(frete_seguro) as numeric) as frete_seguro,'
      '          cast(sum(desconto) as numeric) as desconto,'
      '          cast(contratoavista as boolean) as contratoavista,'
      '          cast(sum(creditotroca) as numeric) as creditotroca,'
      
        '          cast(sum(valoricmssubstituicao) as numeric) as valoric' +
        'mssubstituicao,'
      '          cast(sum(entradas) as numeric) as entradas,'
      '          cast(sum(qtparcelas) as integer) as qtparcelas,'
      '          cast(sum(aVista) as numeric) as aVista,'
      '          cast(sum(aPrazo) as numeric) as aPrazo,'
      '          cast(sum(eFinanceiro) as numeric) as eFinanceiro,'
      '          cast(Tipo as varchar) as tipo,'
      #9'  cast(TipoA as varchar) as tipoA,'
      #9'  cast(sum(valortotalABS) as numeric) as valortotalABS,'
      '          cast(sum(tregistros) as integer) as tregistros'
      ' from'
      ' ('
      '  select *'
      '  from'
      '  ('
      '   select  cast(ncontrato as varchar) as ncontrato,'
      '          cast(filialvenda as integer) as filialvenda,'
      '          cast(nomefilialvenda as varchar) as nomefilialvenda,'
      '          cast(grupofilialvenda as integer) as grupofilialvenda,'
      
        '          cast(nomegrupofilialvenda as varchar) as nomegrupofili' +
        'alvenda,'
      #9'  %cliente'
      '          cast(cliente as integer) as cliente,'
      #9'  %tipocliente'
      '          cast(tipocliente as varchar) as tipocliente,'
      #9'  %nomecliente'
      '          cast(nomecliente as varchar) as nomecliente,'
      '          cast(datavenda as date) as datavenda,'
      '          cast(sum(valorvista) as Numeric) as valorvista,'
      '          cast(sum(valortotal) as numeric) as valortotal,'
      
        '          cast(sum(vendamercadorias) as numeric) as vendamercado' +
        'rias,'
      '          cast(sum(vendaservicos) as numeric) as vendaservicos,'
      '          cast(sum(frete_seguro) as numeric) as frete_seguro,'
      '          cast(sum(desconto) as numeric) as desconto,'
      '          cast(contratoavista as boolean) as contratoavista,'
      '          cast(sum(creditotroca) as numeric) as creditotroca,'
      
        '          cast(sum(valoricmssubstituicao) as numeric) as valoric' +
        'mssubstituicao,'
      '          cast(sum(entradas) as numeric) as entradas,'
      '          cast(sum(qtparcelas) as integer) as qtparcelas,'
      '          cast(sum(aVista) as numeric) as aVista,'
      '          cast(sum(aPrazo) as numeric) as aPrazo,'
      '          cast(sum(eFinanceiro) as numeric) as eFinanceiro,'
      '          cast(Tipo as varchar) as tipo,'
      #9'  cast(TipoA as varchar) as tipoA,'
      #9'  cast(sum(valortotalABS) as numeric) as valortotalABS,'
      '          cast(sum(tregistros) as integer) as tregistros'
      '  from'
      ' ('
      '  select  cast(null as varchar) as ncontrato,'
      
        '          cast(case when :AgruparFilial then filialvenda else nu' +
        'll end as integer) as filialvenda,'
      
        '          cast(case when :AgruparFilial then nomefilialvenda els' +
        'e null end as varchar) as nomefilialvenda,'
      
        '          cast(case when :AgruparGrupoFilial then grupofilialven' +
        'da else null end as integer) as grupofilialvenda,'
      
        '          cast(case when :AgruparGrupoFilial then nomegrupofilia' +
        'lvenda else null end as varchar) as nomegrupofilialvenda,'
      
        '          cast(case when :MaioresClientes then cliente else null' +
        ' end as integer) as cliente,'
      
        '          cast(case when :MaioresClientes then tipocliente else ' +
        'null end as varchar) as tipocliente,'
      
        '          cast(case when :MaioresClientes then nomecliente else ' +
        #39'OUTROS'#39' end as varchar) as nomecliente,'
      '          cast('#39'01/01/1900'#39' as date) as datavenda,'
      '          cast(sum(valorvista) as Numeric) as valorvista,'
      '          cast(sum(valortotal) as numeric) as valortotal,'
      
        '          cast(sum(vendamercadorias) as numeric) as vendamercado' +
        'rias,'
      '          cast(sum(vendaservicos) as numeric) as vendaservicos,'
      '          cast(sum(frete_seguro) as numeric) as frete_seguro,'
      '          cast(sum(desconto) as numeric) as desconto,'
      '          cast(null as boolean) as contratoavista,'
      '          cast(sum(creditotroca) as numeric) as creditotroca,'
      
        '          cast(sum(valoricmssubstituicao) as numeric) as valoric' +
        'mssubstituicao,'
      '          cast(sum(entradas) as numeric) as entradas,'
      '          cast(sum(qtparcelas) as integer) as qtparcelas,'
      '          cast(sum(aVista) as numeric) as aVista,'
      '          cast(sum(aPrazo) as numeric) as aPrazo,'
      '          cast(sum(eFinanceiro) as numeric) as eFinanceiro,'
      '          cast(Tipo as varchar) as tipo,'
      #9'  cast(null as varchar) as tipoA,'
      #9'  cast(sum(valortotalABS) as numeric) as valortotalABS,'
      '          cast(sum(tregistros) as integer) as tregistros'
      '   from'
      '%FimSomatorio'
      '*/'
      '('
      '   select ncontrato,'
      '            filialvenda,'
      '            f.nome as nomefilialvenda,'
      '            fgf.grupo as grupofilialvenda,'
      '            gf.descricao as nomegrupofilialvenda,'
      '            cliente,'
      '            tipocliente,'
      '            nomecliente,'
      '            datavenda,'
      '            valorvista,'
      '            valortotal,'
      '            vendamercadorias,'
      '            vendaservicos,'
      '            frete_seguro, desconto,'
      '            contratoavista,'
      '            creditotroca,'
      #9'    0.00 as valoricmssubstituicao,'
      '            entradas,'
      '            qtparcelas,'
      
        '            case when ContratoaVista then valortotal else 0 end ' +
        'as aVista,'
      '            case when ContratoaVista then 0'
      
        #9'                             else valortotal-coalesce(entradas,' +
        '0) end as aPrazo,'
      
        '            ValorTotal-VendaMercadorias-Frete_Seguro-Desconto-ve' +
        'ndaservicos as EFinanceiro,'
      '            Cast('#39'C'#39' as varchar) as Tipo,'
      #9'    case when contratoavista then cast('#39'CT'#39' as varchar)'
      
        #9'                             else cast('#39'CF'#39' as varchar) end as ' +
        'TipoA,'
      '            abs(ValorTotal) as ValorTotalABS,'
      '            cast(1 as integer) as tregistros'
      
        ' from (filiais f left join (filiaisgruposfiliais fgf join grupos' +
        'filiais gf on fgf.grupo=gf.codigo) on f.codigo=fgf.filial),'
      ' ('
      '  select contratostipo_d.*,'
      '         -case When contratoavista then 0'
      
        '                                   else  (select sum(p.valorvenc' +
        'to)'
      '                                          from parcelas p'
      #9#9#9#9#9'  where p.contrato = ncontrato'
      #9#9#9#9#9'    and (p.tipopagto is not null and'
      #9#9#9#9#9'         p.tipopagto in ('#39'D'#39','#39'C'#39','#39'R'#39','#39'E'#39','#39'J'#39'))'
      '   '#9#9#9#9#9'    and p.datavencto <= faturamento) end as entradas,'
      '         cast((select count(*)'
      #9'       from parcelas p'
      #9'       where p.contrato=ncontrato'
      #9'         and (p.tipopagto is not null and'
      
        #9#9'      p.tipopagto in ('#39'D'#39','#39'C'#39','#39'R'#39','#39'E'#39','#39'J'#39'))) as integer) as qt' +
        'parcelas'
      '   from'
      '   ('
      '     select contratos_d.*,'
      '     (case when (select count(*)'
      '                 from parcelas p'
      #9#9' where p.contrato = ncontrato'
      #9#9'   and p.datavencto > faturamento) = 0 then true'
      
        '                                                       else fals' +
        'e end) as contratoavista'
      '     from ( select ct.numero as ncontrato,'
      '                   ct.filialvenda,'
      #9#9'   ct.cliente,'
      #9#9'   ct.tipocliente,'
      #9#9'   ct.nome as nomecliente,'
      '                   ct.faturamento,'
      #9#9'   contratosdevolvidos.devolucao as datavenda,'
      #9#9'   -contratosdevolvidos.valorvista as valorvista,'
      
        '                   -contratosdevolvidos.valortotal as valortotal' +
        ','
      '                   contratosdevolvidos.vendamercadorias,'
      '                   contratosdevolvidos.vendaservicos,'
      
        '                   -(contratosdevolvidos.frete+contratosdevolvid' +
        'os.seguro) as frete_seguro,'
      #9#9'   contratosdevolvidos.desconto as desconto,'
      #9#9'   - contratosdevolvidos.creditotroca as creditotroca'
      '          from contratos ct,'
      '          ('
      '           ('
      '             select contratosdevolvidos.*,'
      
        '  '#9'            -(contratosdevolvidos.valorvista + contratosdevol' +
        'vidos.frete +'
      
        #9#9'     contratosdevolvidos.seguro + contratosdevolvidos.desconto' +
        ') as vendamercadorias,'
      '                    0.00 as vendaservicos'
      '             from'
      '             ('
      #9'       select cd.contrato,'
      #9'              cd.devolucao,'
      #9#9'      sum(cd.valorvista) as valorvista,'
      #9#9'      sum(cd.desconto) as desconto,'
      #9#9'      sum(cd.frete) as frete,'
      #9#9'      sum(cd.seguro) as seguro,'
      #9#9'      sum(cd.valorprazo) as valortotal,'
      #9#9'      sum(-cd.creditotroca) as creditotroca'
      #9'       from contratosdevolvidos cd'
      #9'       where cd.contrato is not null'
      
        #9'         and cd.devolucao between (:DataInicial) and (:DataFina' +
        'l)'
      #9#9' and cd.tipo='#39'D'#39
      '               group by cd.contrato, cd.devolucao'
      #9'     ) as contratosdevolvidos'
      '           )'
      #9'    union all'
      #9'  ('
      #9'   select contrato,'
      #9'          devolucao,'
      #9#9'  valorvista,'
      #9#9'  desconto,'
      #9#9'  frete,'
      #9#9'  seguro,'
      #9#9'  valortotal,'
      #9#9'  creditotroca,'
      '                  -totalprodutos as vendamercadorias,'
      '                  -totalservicos as vendaservicos'
      #9'  from (select contratoscancelados.*,'
      
        #9'               coalesce((select sum(pc.quantidade*pc.precovenda' +
        ')'
      #9#9'                 from produtoscontratos pc'
      #9#9#9'         where pc.contrato = contratoscancelados.contrato'
      #9#9#9#9'   and not pc.brinde),0) as totalprodutos,'
      ' '#9#9'       coalesce((select sum(sc.quantidade * sc.valorservico)'
      #9#9#9#9' from servicoscontratos sc'
      
        #9#9#9#9' where sc.contrato = contratoscancelados.contrato),0) as tot' +
        'alservicos'
      #9#9'from (select distinct ct.numero as contrato,'
      #9#9'                      p.datapagto as devolucao,'
      #9#9#9#9'      ct.valorvista,'
      #9#9#9#9'      coalesce(ct.desconto,0) as desconto,'
      #9#9#9#9'      coalesce(ct.frete,0) as frete,'
      #9#9#9#9'      coalesce(ct.seguro,0) as seguro,'
      #9#9#9#9'      ct.valorprazo as valortotal,'
      #9#9#9#9'      -coalesce(ct.creditotroca,0) as creditotroca'
      '                      from contratos ct, parcelas p'
      '  '#9#9'      where ct.numero=p.contrato and ct.situacao='#39'C'#39
      #9#9'        and not exists (select p2.numero'
      #9#9#9'                from parcelas p2'
      #9#9#9#9#9'where p2.contrato = ct.numero'
      #9#9#9#9#9'  and p2.tipopagto<>'#39'E'#39')'
      ' '#9#9'       and p.datapagto between :datainicial and :datafinal'
      #9#9'       and not exists (select cd.contrato'
      #9#9'                       from contratosdevolvidos cd'
      #9#9#9#9'       where cd.contrato = ct.numero'
      #9#9#9#9'         and cd.tipo='#39'D'#39')) as contratoscancelados'
      '               ) as contratoscancelados'
      #9'  )'
      '        ) as contratosdevolvidos'
      '          where ct.numero=contratosdevolvidos.contrato'
      
        '            and case when ct.os then ct.tipoequipamento in (1,2)' +
        ' else true end'
      '        %WhereDevolucoes'
      '        %WhereFiliais'
      '        %WhereAgentes'
      '        %WhereConceito'
      '        %WhereRegioes_ct'
      '        %WhereClientes'
      '     ) as contratos_d'
      '    ) as contratostipo_d'
      '    %whereTipodeVenda'
      '    %WhereOrdenacao_Devolucoes'
      ''
      ' ) as contratosparcelas_d'
      '   where f.codigo=contratosparcelas_d.filialvenda'
      ')'
      '%InicioAgrupamentoSomatorio'
      '/*'
      '  as contratossomados_d'
      
        '  group by nomegrupofilialvenda, grupofilialvenda, nomefilialven' +
        'da, filialvenda, nomecliente, tipocliente, cliente, tipo'
      ' ) as contratosresomados_d'
      
        '   group by nomegrupofilialvenda, grupofilialvenda, nomefilialve' +
        'nda, filialvenda, nomecliente, tipocliente, cliente, tipo, ncont' +
        'rato, datavenda, contratoavista, tipoA'
      ' ) as contratosresomados_selecionados_d'
      '   %WhereOrdenacao_Total_Vendas'
      ''
      ' ) as contratosresomados_reselecionados_d'
      
        '   group by nomegrupofilialvenda, grupofilialvenda, nomefilialve' +
        'nda, filialvenda, nomecliente, tipocliente, cliente, tipo, ncont' +
        'rato, datavenda, contratoavista, tipoA'
      ')'
      '%FimAgrupamentoSomatorio'
      '*/')
    RequestLive = False
    Left = 341
    Top = 341
    ParamData = <
      item
        DataType = ftString
        Name = 'AgruparFilial'
        ParamType = ptUnknown
        Value = 'False'
      end
      item
        DataType = ftString
        Name = 'AgruparGrupoFilial'
        ParamType = ptUnknown
        Value = 'False'
      end
      item
        DataType = ftString
        Name = 'MaioresClientes'
        ParamType = ptUnknown
        Value = 'False'
      end
      item
        DataType = ftString
        Name = 'DataInicial'
        ParamType = ptUnknown
        Value = #39'10/08/2005'#39
      end
      item
        DataType = ftString
        Name = 'DataFinal'
        ParamType = ptUnknown
        Value = #39'10/08/2005'#39
      end>
  end
  object qryImprimirDadosFiscais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkFields = 'ncontrato=contrato;tipo=tipo'
    LinkOptions = []
    MasterSource = dsrImprimirContratos
    Constraints = <>
    AutoCalcFields = False
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '('
      ' select contratos.contrato,'
      '        np.serie,'
      '        np.numero as numeronf,'
      '        cast(0 as integer) as maquina,'
      '        cast(0 as integer) as intervensao,'
      '        cast(0 as integer) as numerocupom,'
      '        Cast('#39'C'#39' as varchar) as Tipo   '
      ' from  '
      ' ('
      '  select numero as contrato'
      '  from contratos'
      '  where numero in  ('
      '                                 select rcv.ncontrato'
      
        '                                 from   RelatorioContratosVendas' +
        ' rcv '
      '                                 Where rcv.tipo='#39'C'#39'  '
      '                                 order by rcv.ncontrato'
      '                                )'
      
        '  ) as contratos left join notaspag np on contratos.contrato=np.' +
        'contrato'
      ') '
      'union all'
      '('
      '   select contratosdadosfiscais.contrato,'
      '          n.serie,'
      '          n.numero as numeronf,'
      '          c.maquina,'
      '          c.intervensao,'
      '          c.numero as numerocupom,'
      '          Cast('#39'V'#39' as varchar) as Tipo   '
      '   from'
      '   ('
      '   select contratos.*,'
      '          df.numero as dadofiscal   '
      '  from  '
      '  ('
      '   select numero as contrato'
      '   from contratos'
      '   where numero in  ('
      '                                 select rcv.ncontrato'
      
        '                                 from   RelatorioContratosVendas' +
        ' rcv '
      '                                 Where rcv.tipo='#39'V'#39'  '
      '                                 order by rcv.ncontrato'
      '                                )'
      
        '  ) as contratos left join dadosfiscais df on contratos.contrato' +
        '=df.contrato'
      
        ' ) as contratosdadosfiscais left join notas n on contratosdadosf' +
        'iscais.dadofiscal=n.dadofiscal'
      
        '                            left join cupons c on contratosdados' +
        'fiscais.dadofiscal=c.dadofiscal'
      ')'
      'order by contrato, tipo')
    RequestLive = True
    Left = 48
    Top = 344
