  object qryImprimirContratosResumoVendas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      '   SELECT cast(null as varchar) as ncontrato,'
      '                filialvenda,'
      '                nomefilialvenda,'
      '                grupofilialvenda,'
      '                nomegrupofilialvenda,'
      '                cast(null as integer) as cliente,'
      '                cast(null as varchar) as tipocliente,'
      '                cast(null as varchar) as nomecliente,'
      '                datavenda,'
      '                sum(valorvista) as valorvista,'
      '                sum(valortotal) as valortotal, '
      '                sum(vendamercadorias) as vendamercadorias,'
      '                sum(vendaservicos) as vendaservicos,'
      
        '                sum(frete_seguro) as frete_seguro, sum(desconto)' +
        ' as desconto,'
      '                sum(entradas) as entradas,'
      '                cast(null as integer) as qtparcelas,'
      '                sum(aVista) as aVista,'
      '                sum(aPrazo) as aPrazo,'
      '                sum(eFinanceiro) as eFinanceiro,'
      '                tipo, tipoA,'
      '                contratoavista,'
      '                sum(creditotroca) as creditotroca,'
      
        '                sum(ValoricmsSubstituicao) as Valoricmssubstitui' +
        'cao,'
      '                sum(valortotalABS) as valortotalABS,'
      '                false as totalizado,'
      '                cast(sum(tregistros) as integer) as tregistros'
      ''
      '  FROM'
      '('
      
        '   SELECT  cast(case when :AgruparFilial then filialvenda else n' +
        'ull end as integer) as filialvenda,'
      
        '                 cast(case when :AgruparFilial then nomefilialve' +
        'nda else null end as varchar) as nomefilialvenda,'
      
        '                 cast(case when :AgruparGrupoFilial then grupofi' +
        'lialvenda else null end as integer) as grupofilialvenda,'
      
        '                 cast(case when :AgruparGrupoFilial then nomegru' +
        'pofilialvenda else null end as varchar) as nomegrupofilialvenda,'
      
        '                 cast(case when :AgruparDataVenda then datavenda' +
        ' else null end as date) as datavenda,'
      '                valorvista,'
      '                valortotal, '
      '                vendamercadorias,'
      '                vendaservicos,'
      '                frete_seguro, desconto,'
      '                entradas,'
      '                qtparcelas,'
      '                aVista,'
      '                aPrazo,'
      '                eFinanceiro,'
      '                tipo, tipoA,'
      '                contratoavista,'
      '                creditotroca,'
      '                Valoricmssubstituicao,'
      '                valortotalABS,'
      '                tregistros'
      '  FROM RelatorioContratosVendas'
      ') as RelatorioContratosVendas'
      
        'GROUP BY filialvenda, nomefilialvenda, grupofilialvenda, nomegru' +
        'pofilialvenda, datavenda, tipo, contratoavista, tipoA')
    RequestLive = False
    Left = 168
    Top = 320
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'AgruparFilial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'AgruparGrupoFilial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'AgruparDataVenda'
        ParamType = ptUnknown
      end>
  end
