        DataType = ftUnknown
        Name = 'InicioAgrupamentoSomatorio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereOrdenacao_Total_Vendas'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FimAgrupamentoSomatorio'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '%InicioSomatorio'
      '/*'
      '('
      ' select  cast(ncontrato as varchar) as ncontrato,'
      '          cast(filialvenda as integer) as filialvenda,'
      '          cast(nomefilialvenda as varchar) as nomefilialvenda,'
      '          cast(grupofilialvenda as integer) as grupofilialvenda,'
      
        '          cast(nomegrupofilialvenda as varchar) as nomegrupofili' +
        'alvenda,'
      '          cast(cliente as integer) as cliente,'
      '          cast(tipocliente as varchar) as tipocliente,'
      '          cast(nomecliente as varchar) as nomecliente,'
      '          cast(datavenda as date) as datavenda,'
      '          cast(sum(valorvista) as Numeric) as valorvista,'
      '          cast(sum(valortotal) as numeric) as valortotal,'
      
        '          cast(sum(vendamercadorias) as numeric) as vendamercado' +
        'rias,'
      '          cast(sum(vendaservicos) as numeric) as vendaservicos,'
      '          cast(sum(frete_seguro) as numeric) as frete_seguro,'
      '          cast(sum(desconto) as numeric) as desconto,'
      '          cast(contratoavista as boolean) as contratoavista,'
      '          cast(sum(creditotroca) as numeric) as creditotroca,'
      
        '          cast(sum(valoricmssubstituicao) as numeric) as valoric' +
        'mssubstituicao,'
      '          cast(sum(entradas) as numeric) as entradas,'
      '          cast(sum(qtparcelas) as integer) as qtparcelas,'
      '          cast(sum(aVista) as numeric) as aVista,'
      '          cast(sum(aPrazo) as numeric) as aPrazo,'
      '          cast(sum(eFinanceiro) as numeric) as eFinanceiro,'
      '          cast(Tipo as varchar) as tipo,'
      #9'  cast(TipoA as varchar) as tipoA,'
      #9'  cast(sum(valortotalABS) as numeric) as valortotalABS,'
      '          cast(sum(tregistros) as integer) as tregistros'
      ' from'
      ' ('
      '  select *'
      '  from'
      '  ('
      '   select  cast(ncontrato as varchar) as ncontrato,'
      '          cast(filialvenda as integer) as filialvenda,'
      '          cast(nomefilialvenda as varchar) as nomefilialvenda,'
      '          cast(grupofilialvenda as integer) as grupofilialvenda,'
      
        '          cast(nomegrupofilialvenda as varchar) as nomegrupofili' +
        'alvenda,'
      #9'  %cliente'
      '          cast(cliente as integer) as cliente,'
      #9'  %tipocliente'
      '          cast(tipocliente as varchar) as tipocliente,'
      #9'  %nomecliente'
      '          cast(nomecliente as varchar) as nomecliente,'
      '          cast(datavenda as date) as datavenda,'
      '          cast(sum(valorvista) as Numeric) as valorvista,'
      '          cast(sum(valortotal) as numeric) as valortotal,'
      
        '          cast(sum(vendamercadorias) as numeric) as vendamercado' +
        'rias,'
      '          cast(sum(vendaservicos) as numeric) as vendaservicos,'
      '          cast(sum(frete_seguro) as numeric) as frete_seguro,'
      '          cast(sum(desconto) as numeric) as desconto,'
      '          cast(contratoavista as boolean) as contratoavista,'
      '          cast(sum(creditotroca) as numeric) as creditotroca,'
      
        '          cast(sum(valoricmssubstituicao) as numeric) as valoric' +
        'mssubstituicao,'
      '          cast(sum(entradas) as numeric) as entradas,'
      '          cast(sum(qtparcelas) as integer) as qtparcelas,'
      '          cast(sum(aVista) as numeric) as aVista,'
      '          cast(sum(aPrazo) as numeric) as aPrazo,'
      '          cast(sum(eFinanceiro) as numeric) as eFinanceiro,'
      '          cast(Tipo as varchar) as tipo,'
      #9'  cast(TipoA as varchar) as tipoA,'
      #9'  cast(sum(valortotalABS) as numeric) as valortotalABS,'
      '          cast(sum(tregistros) as integer) as tregistros'
      '  from'
      ' ('
      '  select  cast(null as varchar) as ncontrato,'
      
        '          cast(case when :AgruparFilial then filialvenda else nu' +
        'll end as integer) as filialvenda,'
      
        '          cast(case when :AgruparFilial then nomefilialvenda els' +
        'e null end as varchar) as nomefilialvenda,'
      
        '          cast(case when :AgruparGrupoFilial then grupofilialven' +
        'da else null end as integer) as grupofilialvenda,'
      
        '          cast(case when :AgruparGrupoFilial then nomegrupofilia' +
        'lvenda else null end as varchar) as nomegrupofilialvenda,'
      
        '          cast(case when :MaioresClientes then cliente else null' +
        ' end as integer) as cliente,'
      
        '          cast(case when :MaioresClientes then tipocliente else ' +
        'null end as varchar) as tipocliente,'
      
        '          cast(case when :MaioresClientes then nomecliente else ' +
        #39'OUTROS'#39' end as varchar) as nomecliente,'
      '          cast('#39'01/01/1900'#39' as date) as datavenda,'
      '          cast(sum(valorvista) as Numeric) as valorvista,'
      '          cast(sum(valortotal) as numeric) as valortotal,'
      
        '          cast(sum(vendamercadorias) as numeric) as vendamercado' +
        'rias,'
      '          cast(sum(vendaservicos) as numeric) as vendaservicos,'
      '          cast(sum(frete_seguro) as numeric) as frete_seguro,'
      '          cast(sum(desconto) as numeric) as desconto,'
      '          cast(null as boolean) as contratoavista,'
      '          cast(sum(creditotroca) as numeric) as creditotroca,'
      
        '          cast(sum(valoricmssubstituicao) as numeric) as valoric' +
        'mssubstituicao,'
      '          cast(sum(entradas) as numeric) as entradas,'
      '          cast(sum(qtparcelas) as integer) as qtparcelas,'
      '          cast(sum(aVista) as numeric) as aVista,'
      '          cast(sum(aPrazo) as numeric) as aPrazo,'
      '          cast(sum(eFinanceiro) as numeric) as eFinanceiro,'
      '          cast(Tipo as varchar) as tipo,'
      #9'  cast(null as varchar) as tipoA,'
      #9'  cast(sum(valortotalABS) as numeric) as valortotalABS,'
      '          cast(sum(tregistros) as integer) as tregistros'
      '   from'
      '%FimSomatorio'
      '*/'
      '('
      '   select ncontrato,'
      '            filialvenda,'
      '            f.nome as nomefilialvenda,'
      '            fgf.grupo as grupofilialvenda,'
      '            gf.descricao as nomegrupofilialvenda,'
      '            cliente,'
      '            tipocliente,'
      '            nomecliente,'
      '            datavenda,'
      '            valorvista,'
      '            valortotal,'
      '            vendamercadorias,'
      '            vendaservicos,'
      '            frete_seguro, desconto,'
      '            contratoavista,'
      '            creditotroca,'
      #9'    0.00 as valoricmssubstituicao,'
      '            entradas,'
      '            qtparcelas,'
      
        '            case when ContratoaVista then valortotal else 0 end ' +
        'as aVista,'
      '            case when ContratoaVista then 0'
      
        #9'                             else valortotal-coalesce(entradas,' +
        '0) end as aPrazo,'
      
        '            ValorTotal-VendaMercadorias-Frete_Seguro-Desconto-ve' +
        'ndaservicos as EFinanceiro,'
      '            Cast('#39'C'#39' as varchar) as Tipo,'
      #9'    case when contratoavista then cast('#39'CT'#39' as varchar)'
      
        #9'                             else cast('#39'CF'#39' as varchar) end as ' +
        'TipoA,'
      '            abs(ValorTotal) as ValorTotalABS,'
      '            cast(1 as integer) as tregistros'
      
        ' from (filiais f left join (filiaisgruposfiliais fgf join grupos' +
        'filiais gf on fgf.grupo=gf.codigo) on f.codigo=fgf.filial %Where' +
        'GruposFiliais),'
      ' ('
      '  select contratostipo_d.*,'
      '         -case When contratoavista then 0'
      
        '                                   else  (select sum(p.valorvenc' +
        'to)'
      '                                          from parcelas p'
      #9#9#9#9#9'  where p.contrato = ncontrato'
      #9#9#9#9#9'    and (p.tipopagto is not null and'
      #9#9#9#9#9'         p.tipopagto in ('#39'D'#39','#39'C'#39','#39'R'#39','#39'E'#39','#39'J'#39'))'
      '   '#9#9#9#9#9'    and p.datavencto <= faturamento) end as entradas,'
      '         cast((select count(*)'
      #9'       from parcelas p'
      #9'       where p.contrato=ncontrato'
      #9'         and (p.tipopagto is not null and'
      
        #9#9'      p.tipopagto in ('#39'D'#39','#39'C'#39','#39'R'#39','#39'E'#39','#39'J'#39'))) as integer) as qt' +
        'parcelas'
      '   from'
      '   ('
      '     select contratos_d.*,'
      '     (case when (select count(*)'
      '                 from parcelas p'
      #9#9' where p.contrato = ncontrato'
      #9#9'   and p.datavencto > faturamento) = 0 then true'
      
        '                                                       else fals' +
        'e end) as contratoavista'
      '     from ( select ct.numero as ncontrato,'
      '                   ct.filialvenda,'
      #9#9'   ct.cliente,'
      #9#9'   ct.tipocliente,'
      #9#9'   ct.nome as nomecliente,'
      '                   ct.faturamento,'
      #9#9'   contratosdevolvidos.devolucao as datavenda,'
      #9#9'   -contratosdevolvidos.valorvista as valorvista,'
      
        '                   -contratosdevolvidos.valortotal as valortotal' +
        ','
      '                   contratosdevolvidos.vendamercadorias,'
      '                   contratosdevolvidos.vendaservicos,'
      
        '                   -(contratosdevolvidos.frete+contratosdevolvid' +
        'os.seguro) as frete_seguro,'
      #9#9'   contratosdevolvidos.desconto,'
      #9#9'   - contratosdevolvidos.creditotroca as creditotroca'
      
        '          from contratos ct left join usuarios u on ct.vendedor ' +
        '= u.codigo,'
      '          ('
      '           ('
      '             select contratosdevolvidos.*,'
      
        '  '#9'            -(contratosdevolvidos.valorvista + contratosdevol' +
        'vidos.frete +'
      
        #9#9'     contratosdevolvidos.seguro + contratosdevolvidos.desconto' +
        ') as vendamercadorias,'
      '                    0.00 as vendaservicos'
      '             from'
      '             ('
      #9'       select cd.contrato,'
      #9'              cd.devolucao,'
      #9#9'      sum(cd.valorvista) as valorvista,'
      
        #9#9'      sum(coalesce(cd.desconto,0)+coalesce(cd.valordescontoite' +
        'm,0)) as desconto,'
      #9#9'      sum(cd.frete) as frete,'
      #9#9'      sum(cd.seguro) as seguro,'
      #9#9'      sum(cd.valorprazo) as valortotal,'
      #9#9'      sum(-cd.creditotroca) as creditotroca'
      #9'       from contratosdevolvidos cd'
      #9'       where cd.contrato is not null'
      
        #9'         and cd.devolucao between (:DataInicial) and (:DataFina' +
        'l)'
      #9#9' and cd.tipo='#39'D'#39
      '               group by cd.contrato, cd.devolucao'
      #9'     ) as contratosdevolvidos'
      '           )'
      #9'    union all'
      #9'  ('
      #9'   select contrato,'
      #9'          devolucao,'
      #9#9'  valorvista,'
      #9#9'  desconto,'
      #9#9'  frete,'
      #9#9'  seguro,'
      #9#9'  valortotal,'
      #9#9'  creditotroca,'
      '                  -totalprodutos as vendamercadorias,'
      '                  -totalservicos as vendaservicos'
      #9'  from (select contratoscancelados.*,'
      
        #9'               coalesce((select sum(pc.quantidade*pc.precovenda' +
        ')'
      #9#9'                 from produtoscontratos pc'
      #9#9#9'         where pc.contrato = contratoscancelados.contrato'
      #9#9#9#9'   and not pc.brinde),0) as totalprodutos,'
      ' '#9#9'       coalesce((select sum(sc.quantidade * sc.valorservico)'
      #9#9#9#9' from servicoscontratos sc'
      
        #9#9#9#9' where sc.contrato = contratoscancelados.contrato),0) as tot' +
        'alservicos'
      #9#9'from (select distinct ct.numero as contrato,'
      #9#9'                      p.datapagto as devolucao,'
      #9#9#9#9'      ct.valorvista,'
      ''
      '              (coalesce((select sum(pc.valordescontoitem)'
      '                         from produtoscontratos pc'
      
        '                         where pc.contrato = ct.numero),0) + coa' +
        'lesce(ct.desconto,0)) as desconto,'
      ''
      #9#9#9#9'      coalesce(ct.frete,0) as frete,'
      #9#9#9#9'      coalesce(ct.seguro,0) as seguro,'
      #9#9#9#9'      ct.valorprazo as valortotal,'
      #9#9#9#9'      -coalesce(ct.creditotroca,0) as creditotroca'
      '     from contratos ct, parcelas p'
      '  '#9#9'      where ct.numero=p.contrato and ct.situacao='#39'C'#39
      #9#9'        and not exists (select p2.numero'
      #9#9#9'                from parcelas p2'
      #9#9#9#9#9'where p2.contrato = ct.numero'
      #9#9#9#9#9'  and p2.tipopagto<>'#39'E'#39')'
      ' '#9#9'       and p.datapagto between :datainicial and :datafinal'
      #9#9'       and not exists (select cd.contrato'
      #9#9'                       from contratosdevolvidos cd'
      #9#9#9#9'       where cd.contrato = ct.numero'
      #9#9#9#9'         and cd.tipo='#39'D'#39')) as contratoscancelados'
      '               ) as contratoscancelados'
      #9'  )'
      '        ) as contratosdevolvidos'
      '          where ct.numero=contratosdevolvidos.contrato'
      
        '            and case when ct.os then ct.tipoequipamento in (1,2)' +
        ' and not (coalesce(ct.os_garantia,false) and ct.os_garantia_stat' +
        'us='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '        %WhereDevolucoes'
      '        %WhereFiliais'
      '        %WhereAgentes'
      '        %WhereConceito'
      '        %WhereRegioes_ct'
      '        %WhereVendedores_ct'
      '        %WhereClientes'
      '     ) as contratos_d'
      '    ) as contratostipo_d'
      '    %whereTipodeVenda'
      '    %WhereOrdenacao_Devolucoes'
      ''
      ' ) as contratosparcelas_d'
      '   where f.codigo=contratosparcelas_d.filialvenda'
      ')'
      '%InicioAgrupamentoSomatorio'
      '/*'
      '  as contratossomados_d'
      
        '  group by nomegrupofilialvenda, grupofilialvenda, nomefilialven' +
        'da, filialvenda, nomecliente, tipocliente, cliente, tipo'
      ' ) as contratosresomados_d'
      
        '   group by nomegrupofilialvenda, grupofilialvenda, nomefilialve' +
        'nda, filialvenda, nomecliente, tipocliente, cliente, tipo, ncont' +
        'rato, datavenda, contratoavista, tipoA'
      ' ) as contratosresomados_selecionados_d'
      '   %WhereOrdenacao_Total_Vendas'
      ''
      ' ) as contratosresomados_reselecionados_d'
      
        '   group by nomegrupofilialvenda, grupofilialvenda, nomefilialve' +
        'nda, filialvenda, nomecliente, tipocliente, cliente, tipo, ncont' +
        'rato, datavenda, contratoavista, tipoA'
      ')'
