  object qryNotasVendas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'InicioSomatorio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'tipocliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'nomecliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FimSomatorio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereFiliais_notas'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereClientes_notas'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereAgentes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereConceito'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereRegioes_df'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereVendedores_df'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereGrupoVendedores_df'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'whereTipodeVenda'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereGruposFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereOrdenacao_notas'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'InicioAgrupamentoSomatorio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereOrdenacao_Total_Vendas'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FimAgrupamentoSomatorio'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '%InicioSomatorio'
      '/*'
      '('
      '   select cast(numero as integer) as numero,'
      '          cast(ncontrato as varchar) as ncontrato,'
      '          cast(filialvenda as integer) as filialvenda,'
      '          cast(cliente as integer) as cliente,'
      '          cast(tipocliente as varchar) as tipocliente,'
      '          cast(datavenda as date) as datavenda,'
      '          cast(sum(valorvista) as Numeric) as valorvista,'
      '          cast(sum(valorfrete) as Numeric) as valorfrete,'
      '          cast(sum(seguro) as Numeric) as seguro,'
      #9'  cast(sum(desconto) as numeric) as desconto,'
      
        '          cast(sum(despesasacessorias) as Numeric) as despesasac' +
        'essorias,'
      '          cast(sum(valortotal) as numeric) as valortotal,'
      '          cast(sum(outras) as numeric) as outras,'
      '          cast(sum(eFinanceiro) as numeric) as eFinanceiro,'
      #9'  cast(sum(valortotalABS) as Numeric) as valortotalABS,'
      
        '          cast(sum(valoricmssubstituicao) as numeric) as valoric' +
        'mssubstituicao,'
      #9'  cast(contratoavista as boolean) as contratoavista,'
      '          cast(nomecliente as varchar) as nomecliente,'
      '          cast(serie as varchar) as serie,'
      '          cast(notafiscal as integer) as notafiscal,'
      '          cast(maquina as integer) as maquina,'
      '          cast(intervensao as integer) as intervensao,'
      '          cast(cupomfiscal as integer) as cupomfiscal,'
      '          cast(nomefilialvenda as varchar) as nomefilialvenda,'
      '          cast(grupofilialvenda as integer) as grupofilialvenda,'
      
        '          cast(nomegrupofilialvenda as varchar) as nomegrupofili' +
        'alvenda,'
      #9'  cast(sum(tregistros) as integer) as tregistros,'
      #9'  Totalizado,'
      
        '          cast(Tipo as varchar) as tipo, cast(TipoA as varchar) ' +
        'as tipoA,'
      
        '          cast(sum(vendamercadorias) as numeric) as vendamercado' +
        'rias,'
      '          cast(sum(vendaservicos) as numeric) as vendaservicos'
      ' from'
      ' ('
      '  select *'
      '  from'
      '  ('
      '   select cast(numero as integer) as numero,'
      '          cast(ncontrato as varchar) as ncontrato,'
      '          cast(filialvenda as integer) as filialvenda,'
      #9'  %cliente'
      '          cast(cliente as integer) as cliente,'
      #9'  %tipocliente'
      '          cast(tipocliente as varchar) as tipocliente,'
      '          cast(datavenda as date) as datavenda,'
      '          cast(sum(valorvista) as Numeric) as valorvista,'
      '          cast(sum(valorfrete) as Numeric) as valorfrete,'
      '          cast(sum(seguro) as Numeric) as seguro,'
      #9'  cast(sum(desconto) as numeric) as desconto,'
      
        '          cast(sum(despesasacessorias) as Numeric) as despesasac' +
        'essorias,'
      '          cast(sum(valortotal) as numeric) as valortotal,'
      '          cast(sum(outras) as numeric) as outras,'
      '          cast(sum(eFinanceiro) as numeric) as eFinanceiro,'
      '          cast(sum(valortotalABS) as Numeric) as valortotalABS,'
      
        '          cast(sum(valoricmssubstituicao) as numeric) as valoric' +
        'mssubstituicao,'
      #9'  cast(contratoavista as boolean) as contratoavista,'
      #9'  %nomecliente'
      '          cast(nomecliente as varchar) as nomecliente,'
      '          cast(serie as varchar) as serie,'
      '          cast(notafiscal as integer) as notafiscal,'
      '          cast(maquina as integer) as maquina,'
      '          cast(intervensao as integer) as intervensao,'
      '          cast(cupomfiscal as integer) as cupomfiscal,'
      '          cast(nomefilialvenda as varchar) as nomefilialvenda,'
      '          cast(grupofilialvenda as integer) as grupofilialvenda,'
      
        '          cast(nomegrupofilialvenda as varchar) as nomegrupofili' +
        'alvenda,'
      #9'  cast(sum(tregistros) as integer) as tregistros,'
      #9'  Totalizado,'
      
        '          cast(Tipo as varchar) as tipo, cast(TipoA as varchar) ' +
        'as tipoA,'
      
        '          cast(sum(vendamercadorias) as numeric) as vendamercado' +
        'rias,'
      '          cast(sum(vendaservicos) as numeric) as vendaservicos'
      '  from'
      ' ('
      '  select  cast(null as integer) as numero,'
      '          cast(null as varchar) as ncontrato,'
      
        '          cast(case when :AgruparFilial then filialvenda else nu' +
        'll end as integer) as filialvenda,'
      
        '          cast(case when :MaioresClientes then cliente else null' +
        ' end as integer) as cliente,'
      
        '          cast(case when :MaioresClientes then tipocliente else ' +
        'null end as varchar) as tipocliente,'
      '          cast('#39'30/12/1899'#39' as date) as datavenda,'
      '          cast(sum(valorvista) as Numeric) as valorvista,'
      '          cast(sum(valorfrete) as numeric) as valorfrete,'
      '          cast(sum(seguro) as numeric) as seguro,'
      #9'  cast(sum(desconto) as numeric) as desconto,'
      
        '          cast(sum(despesasacessorias) as numeric) as despesasac' +
        'essorias,'
      '          cast(sum(valortotal) as Numeric) as valortotal,'
      '          cast(sum(outras) as numeric) as Outras,'
      '          cast(sum(eFinanceiro) as numeric) as eFinanceiro,'
      #9'  cast(sum(valortotalABS) as Numeric) as valortotalABS,'
      
        '          cast(sum(valoricmssubstituicao) as numeric) as valoric' +
        'mssubstituicao,'
      #9'  cast(null as boolean) as contratoavista,'
      
        '          cast(case when :MaioresClientes then nomecliente else ' +
        #39'OUTROS'#39' end as varchar) as nomecliente,'
      '          cast(null as varchar) as serie,'
      '          cast(null as integer) as notafiscal,'
      '          cast(null as integer) as maquina,'
      '          cast(null as integer) as intervensao,'
      '          cast(null as integer) as cupomfiscal,'
      
        '          cast(case when :AgruparFilial then nomefilialvenda els' +
        'e null end as varchar) as nomefilialvenda,'
      
        '          cast(case when :AgruparGrupoFilial then grupofilialven' +
        'da else null end as integer) as grupofilialvenda,'
      
        '          cast(case when :AgruparGrupoFilial then nomegrupofilia' +
        'lvenda else null end as varchar) as nomegrupofilialvenda,'
      #9'  cast(sum(tregistros) as integer) as tregistros,'
      #9'  Totalizado,'
      
        '          cast(Tipo as varchar) as tipo, cast(null as varchar) a' +
        's tipoA,'
      #9'  cast(sum(vendamercadorias) as numeric) as vendamercadorias,'
      '          cast(sum(vendaservicos) as numeric) as vendaservicos'
      '   from'
      '%FimSomatorio'
      '*/'
      '  ('
      '  select dadosfiscais.*,'
      '       f.nome as nomefilialvenda,'
      '       fgf.grupo as grupofilialvenda,'
      '       gf.descricao as nomegrupofilialvenda,'
      '       cast(1 as integer) as tregistros,'
      '       false as Totalizado,'
      '       cast('#39'Vendas'#39' as varchar) as tipo,'
      '       case when contratoavista then cast('#39'VT'#39' as varchar)'
      
        '                                else cast('#39'VF'#39' as varchar) end a' +
        's tipoA,'
      ''
      '       (select sum(quantidade*precovenda)'
      '        from produtosdadosfiscais pdf'
      #9'where pdf.dadofiscal=dadosfiscais.numero) as vendamercadorias,'
      ''
      '       (select sum(quantidade*valorservico)'
      '        from servicosdadosfiscais sdf'
      #9'Where sdf.dadofiscal=dadosfiscais.numero) as vendaservicos'
      ''
      '  from'
      '  ('
      '    select dadosfiscais.*,'
      '          c.maquina,'
      '          c.intervensao,'
      '          c.numero as cupomfiscal'
      '    from'
      '   ('
      '     select dadosfiscais.*,'
      '            n.serie,'
      '            n.numero as notafiscal'
      '     from'
      '    ('
      '     select dadosfiscais.*,'
      '           coalesce(coalesce(vf.razao,vf.nome),'
      #9'   cast('#39'FRENTE DE CAIXA'#39' as varchar)) as nomecliente'
      '     from'
      '     ('
      
        '      select dadosfiscais.*,  case when (ncontrato is not null) ' +
        'then ((select count(*)'
      
        #9#9#9'                                               from parcelas ' +
        'p'
      
        #9#9#9#9'                                       where p.contrato = ct' +
        '.numero'
      
        #9#9#9#9'                                         and p.datavencto > ' +
        'ct.faturamento)=0)'
      
        #9#9#9'                                        else true end as cont' +
        'ratoavista'
      '      from'
      '      ('
      '       select df.numero, df.contrato as ncontrato,'
      '           df.filialvenda,'
      '           df.cliente, df.tipocliente,'
      '           df.data as datavenda,'
      '           df.valorvista,'
      '           coalesce(df.valorfrete, 0) as valorfrete,'
      '           coalesce(df.seguro,0) as seguro,'
      
        #9'         coalesce(df.descontoitem,0)+coalesce(df.desconto,0) as' +
        ' desconto,'
      
        '           coalesce(df.despesasacessorias,0) as despesasacessori' +
        'as,'
      '           df.valortotal,'
      
        '           coalesce(df.valorfrete,0)+coalesce(df.seguro,0)+coale' +
        'sce(df.despesasacessorias,0) as Outras,'
      
        '           df.valortotal-(df.valorvista+coalesce(df.valorfrete,0' +
        ')+coalesce(df.seguro,0)+coalesce(df.despesasacessorias,0)) as eF' +
        'inanceiro,'
      '           abs(df.valortotal) as valortotalABS,'
      
        '           - df.totalvaloricmssubstituicao as valoricmssubstitui' +
        'cao'
      ''
      '       from dadosfiscais df'
      
        '            left join (usuarios u left join GruposUsuarios gu on' +
        ' u.grupo = gu.codigo)'
      '            on df.vendedor = u.codigo'
      ''
      '       Where (df.data between (:DataInicial) and (:DataFinal))'
      '         and df.situacao='#39'N'#39
      '                                     '
      
        '         and (eHNotaFiscalSaidaVenda(df.codigofiscal) or mod(df.' +
        'codigofiscal,1000) in (929))                            '
      '                             '
      '         and not coalesce(df.notavinculada,false)'
      ''
      '      %WhereFiliais_notas'
      '      %WhereClientes_notas'
      '      %WhereAgentes'
      '      %WhereConceito'
      '      %WhereRegioes_df'
      '      %WhereVendedores_df'
      '      %WhereGrupoVendedores_df'
      ''
      ''
      ''
      
        '      ) as dadosfiscais left join contratos ct on dadosfiscais.n' +
        'contrato = ct.numero'
      '        where dadosfiscais.numero is not null'
      
        '          and case when ct.os then ct.tipoequipamento in (1,2) a' +
        'nd not (coalesce(ct.os_garantia,false) and ct.os_garantia_status' +
        '='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      
        '     ) as dadosfiscais  left join vfornecedores vf on dadosfisca' +
        'is.cliente=vf.codigo and dadosfiscais.tipocliente=vf.tipo'
      '       %whereTipodeVenda'
      
        '    ) as dadosfiscais  left join notas n on dadosfiscais.numero=' +
        'n.dadofiscal'
      
        '   ) as dadosfiscais left join cupons c on dadosfiscais.numero=c' +
        '.dadofiscal'
      
        '  ) as dadosfiscais join (filiais f left join (filiaisgruposfili' +
        'ais fgf join gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                         on f.codigo=fgf.filial %WhereGruposFili' +
        'ais)'
      
        '                                   on dadosfiscais.filialvenda=f' +
        '.codigo'
      '  %WhereOrdenacao_notas'
      ''
      '  )'
      '%InicioAgrupamentoSomatorio'
      '/*'
      '  as notasomadas_v'
      
        '  group by nomegrupofilialvenda, grupofilialvenda, nomefilialven' +
        'da, filialvenda, nomecliente, tipocliente, cliente, tipo,Totaliz' +
        'ado'
      ' ) as notasresomadas_v'
      
        '   group by nomegrupofilialvenda, grupofilialvenda, nomefilialve' +
        'nda, filialvenda, nomecliente, tipocliente, cliente, tipo, contr' +
        'atoavista, tipoA, numero, ncontrato, datavenda, serie, notafisca' +
        'l, maquina, intervensao, cupomfiscal, Totalizado'
      ' ) as notasresomadas_selecionadas_v'
      '   %WhereOrdenacao_Total_Vendas'
      ''
      ' ) as notasresomadas_reselecionadas_v'
      
        '   group by nomegrupofilialvenda, grupofilialvenda, nomefilialve' +
        'nda, filialvenda, nomecliente, tipocliente, cliente, tipo, contr' +
        'atoavista, tipoA, numero, ncontrato, datavenda, serie, notafisca' +
        'l, maquina, intervensao, cupomfiscal,Totalizado'
      ')'
      '%FimAgrupamentoSomatorio'
      '*/')
    RequestLive = False
    Left = 387
    Top = 7
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'AgruparFilial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'MaioresClientes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'AgruparGrupoFilial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataFinal'
        ParamType = ptUnknown
      end>
  end
