        DataType = ftUnknown
        Name = 'WhereClientes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'whereTipodeVenda'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereOrdenacao_Vendas'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'InicioAgrupamentoSomatorio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereOrdenacao_Total_Vendas'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FimAgrupamentoSomatorio'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '/* qryContratosVendas */'
      '%InicioSomatorio'
      '/*'
      '('
      ' select  cast(ncontrato as varchar) as ncontrato,'
      '         cast(dadofiscal as integer) as dadofiscal,'
      '         cast(codigonota as integer) as codigonota,'
      '          cast(filialvenda as integer) as filialvenda,'
      '          cast(nomefilialvenda as varchar) as nomefilialvenda,'
      '          cast(grupofilialvenda as integer) as grupofilialvenda,'
      
        '          cast(nomegrupofilialvenda as varchar) as nomegrupofili' +
        'alvenda,'
      '          cast(cliente as integer) as cliente,'
      '          cast(tipocliente as varchar) as tipocliente,'
      '          cast(nomecliente as varchar) as nomecliente,'
      '          cast(datavenda as date) as datavenda,'
      '          cast(sum(valorvista) as Numeric) as valorvista,'
      '          cast(sum(valortotal) as numeric) as valortotal,'
      
        '          cast(sum(vendamercadorias) as numeric) as vendamercado' +
        'rias,'
      '          cast(sum(vendaservicos) as numeric) as vendaservicos,'
      '          cast(sum(frete_seguro) as numeric) as frete_seguro,'
      '          cast(sum(desconto) as numeric) as desconto,'
      '          cast(contratoavista as boolean) as contratoavista,'
      '          cast(sum(creditotroca) as numeric) as creditotroca,'
      
        '          cast(sum(valoricmssubstituicao) as numeric) as valoric' +
        'mssubstituicao,'
      '          cast(sum(entradas) as numeric) as entradas,'
      '          cast(sum(qtparcelas) as integer) as qtparcelas,'
      '          cast(sum(aVista) as numeric) as aVista,'
      '          cast(sum(aPrazo) as numeric) as aPrazo,'
      '          cast(sum(eFinanceiro) as numeric) as eFinanceiro,'
      
        '          cast(Tipo as varchar) as tipo, cast(TipoA as varchar) ' +
        'as tipoA, cast(sum(valortotalABS) as numeric) as valortotalABS,'
      '          cast(sum(tregistros) as numeric) as tregistros'
      ' from'
      ' ('
      '  select *'
      '  from'
      '  ('
      '   select  cast(ncontrato as varchar) as ncontrato,'
      '          cast(dadofiscal as integer) as dadofiscal,'
      '          cast(codigonota as integer) as codigonota,'
      '          cast(filialvenda as integer) as filialvenda,'
      '          cast(nomefilialvenda as varchar) as nomefilialvenda,'
      '          cast(grupofilialvenda as integer) as grupofilialvenda,'
      
        '          cast(nomegrupofilialvenda as varchar) as nomegrupofili' +
        'alvenda,'
      #9'  %cliente'
      '          cast(cliente as integer) as cliente,'
      #9'  %tipocliente'
      '          cast(tipocliente as varchar) as tipocliente,'
      #9'  %nomecliente'
      '          cast(nomecliente as varchar) as nomecliente,'
      '          cast(datavenda as date) as datavenda,'
      '          cast(sum(valorvista) as Numeric) as valorvista,'
      '          cast(sum(valortotal) as numeric) as valortotal,'
      
        '          cast(sum(vendamercadorias) as numeric) as vendamercado' +
        'rias,'
      '          cast(sum(vendaservicos) as numeric) as vendaservicos,'
      '          cast(sum(frete_seguro) as numeric) as frete_seguro,'
      '          cast(sum(desconto) as numeric) as desconto,'
      '          cast(contratoavista as boolean) as contratoavista,'
      '          cast(sum(creditotroca) as numeric) as creditotroca,'
      
        '          cast(sum(valoricmssubstituicao) as numeric) as valoric' +
        'mssubstituicao,'
      '          cast(sum(entradas) as numeric) as entradas,'
      '          cast(sum(qtparcelas) as integer) as qtparcelas,'
      '          cast(sum(aVista) as numeric) as aVista,'
      '          cast(sum(aPrazo) as numeric) as aPrazo,'
      '          cast(sum(eFinanceiro) as numeric) as eFinanceiro,'
      
        '          cast(Tipo as varchar) as tipo, cast(TipoA as varchar) ' +
        'as tipoA, cast(sum(valortotalABS) as numeric) as valortotalABS,'
      '          cast(sum(tregistros) as integer) as tregistros'
      '  from'
      ' ('
      '  select  cast(null as varchar) as ncontrato,'
      '          cast(null as integer) as dadofiscal,'
      '          cast(null as integer) as codigonota,'
      
        '          cast(case when :AgruparFilial then filialvenda else nu' +
        'll end as integer) as filialvenda,'
      
        '          cast(case when :AgruparFilial then nomefilialvenda els' +
        'e null end as varchar) as nomefilialvenda,'
      
        '          cast(case when :AgruparGrupoFilial then grupofilialven' +
        'da else null end as integer) as grupofilialvenda,'
      
        '          cast(case when :AgruparGrupoFilial then nomegrupofilia' +
        'lvenda else null end as varchar) as nomegrupofilialvenda,'
      
        '          cast(case when :MaioresClientes then cliente else null' +
        ' end as integer) as cliente,'
      
        '          cast(case when :MaioresClientes then tipocliente else ' +
        'null end as varchar) as tipocliente,'
      
        '          cast(case when :MaioresClientes then nomecliente else ' +
        #39'OUTROS'#39' end as varchar) as nomecliente,'
      '          cast('#39'30/12/1899'#39' as date) as datavenda,'
      '          cast(sum(valorvista) as Numeric) as valorvista,'
      '          cast(sum(valortotal) as numeric) as valortotal,'
      
        '          cast(sum(vendamercadorias) as numeric) as vendamercado' +
        'rias,'
      '          cast(sum(vendaservicos) as numeric) as vendaservicos,'
      '          cast(sum(frete_seguro) as numeric) as frete_seguro,'
      '          cast(sum(desconto) as numeric) as desconto,'
      '          cast(null as boolean) as contratoavista,'
      '          cast(sum(creditotroca) as numeric) as creditotroca,'
      
        '          cast(sum(valoricmssubstituicao) as numeric) as valoric' +
        'mssubstituicao,'
      '          cast(sum(entradas) as numeric) as entradas,'
      '          cast(sum(qtparcelas) as integer) as qtparcelas,'
      '          cast(sum(aVista) as numeric) as aVista,'
      '          cast(sum(aPrazo) as numeric) as aPrazo,'
      '          cast(sum(eFinanceiro) as numeric) as eFinanceiro,'
      
        '          cast(Tipo as varchar) as tipo, cast(null as varchar) a' +
        's tipoA, '
      '          cast(sum(valortotalABS) as numeric) as valortotalABS,'
      '          cast(sum(tregistros) as integer) as tregistros'
      '   from'
      '%FimSomatorio'
      '*/'
      '    ('
      '      select ncontrato,'
      '            dadofiscal,'
      '            cast(null as integer) as codigonota,'
      '            filialvenda,'
      '            f.nome as nomefilialvenda,'
      '            fgf.grupo as grupofilialvenda,'
      '            gf.descricao as nomegrupofilialvenda,'
      '            cliente,'
      '            tipocliente,'
      '            nomecliente,'
      '            datavenda,'
      '            valorvista,'
      '            valortotal,'
      
        '            (valorvista-coalesce(vendaservicos,0)-frete-seguro-d' +
        'esconto) as vendamercadorias,'
      '            vendaservicos,'
      '            (frete+seguro) as frete_seguro,  desconto,'
      '            contratoavista,'
      '            - creditotroca as creditotroca,'
      '            - valoricmssubstituicao as valoricmssubstituicao,'
      '            entradas,'
      '            qtparcelas,'
      
        '            case when ContratoaVista then valortotal else 0 end ' +
        'as aVista,'
      
        '            case when ContratoaVista then 0 else valortotal-coal' +
        'esce(entradas,0) end as aPrazo,'
      '            ValorTotal-ValorVista as EFinanceiro,'
      
        '            Cast('#39'V'#39' as varchar) as Tipo, case when contratoavis' +
        'ta then cast('#39'VT'#39' as varchar) else cast('#39'VF'#39' as varchar) end as ' +
        'TipoA, abs(ValorTotal) as ValorTotalABS,'
      '            cast(1 as integer) as tregistros'
      
        '     from (filiais f left join (filiaisgruposfiliais fgf join gr' +
        'uposfiliais gf on fgf.grupo=gf.codigo %WhereGruposFiliais)'
      
        '                                                              on' +
        ' f.codigo=fgf.filial),'
      '     ('
      '       select contratostipo_v.*,'
      '          case when contratoavista then 0'
      
        '                                               else (select sum(' +
        'p.valorvencto)'
      
        '                                                       from parc' +
        'elas p where p.contrato = ncontrato and p.datavencto <= datavend' +
        'a)'
      '          end as entradas,'
      
        '          (select sum(quantidade*valorservico) from servicoscont' +
        'ratos sc Where sc.contrato=ncontrato) as vendaservicos,'
      
        '          (select cast(substr(p.parcelaorigem,strpos(p.parcelaor' +
        'igem,'#39'/'#39')+1,length(p.parcelaorigem)-((strpos(p.parcelaorigem,'#39'/'#39 +
        ')-1))) as integer) from parcelas p where p.contrato=ncontrato li' +
        'mit 1) as qtparcelas'
      ''
      '      from'
      '      ('
      '        select contratos_v.*,'
      '         case when (select count(*) from parcelas p where'
      '                   p.contrato = ncontrato and'
      '                   p.datavencto > datavenda) = 0 then true'
      '                                              else false'
      '          end as contratoavista'
      '       from'
      '       ('
      ''
      '        select'
      '         ct.numero as ncontrato,'
      ''
      '        (select df.numero'
      '          from dadosfiscais df'
      '              where df.contrato = ct.numero'
      '                and df.situacao = '#39'N'#39' limit 1 ) as dadofiscal,'
      ''
      '         ct.filialvenda,'
      '         ct.cliente,'
      '         ct.tipocliente,'
      '         ct.nome as nomecliente,'
      '         ct.faturamento as datavenda,'
      
        '         ct.valorvista, coalesce(ct.frete,0) as frete, coalesce(' +
        'ct.seguro,0) as seguro,'
      ''
      '        - (coalesce((select sum(pc.valordescontoitem)'
      '                     from produtoscontratos pc'
      
        '                     where pc.contrato = ct.numero),0) + coalesc' +
        'e(ct.desconto,0)) as desconto,'
      ''
      '         ct.valorprazo as valortotal,'
      '         ct.creditotroca,'
      '         ct.valoricmssubstituicao'
      '        from contratos ct'
      
        '             left join (usuarios u left join GruposUsuarios gu o' +
        'n u.grupo = gu.codigo)'
      '             on ct.vendedor = u.codigo'
      ''
      
        '        Where ct.origem is null and ct.faturamento between (:Dat' +
        'aInicial) and (:DataFinal)'
      
        '          and case when ct.os then ct.tipoequipamento in (1,2) a' +
        'nd not (coalesce(ct.os_garantia,false) and ct.os_garantia_status' +
        '='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      '        %WhereFiliais'
      '        %WhereAgentes'
      '        %WhereConceito'
      '        %WhereRegioes_ct'
      '        %WhereVendedores_ct'
      '        %WhereGrupoVendedores_ct'
      ''
      '        %WhereClientes'
      ''
      ''
      '      union all'
      ''
      ''
      '      select'
      '         df.contrato as ncontrato'
      '       , df.numero as dadofiscal'
      '       , df.filialvenda'
      '       , df.cliente'
      '       , df.tipocliente'
      '       , df.nome as nomecliente'
      '       , df.data as datavenda'
      '       , df.valorvista'
      '       , coalesce(df.valorfrete,0)  as frete'
      '       , coalesce(df.seguro,0) as seguro'
      ''
      '       , - (coalesce('
      '                      ('
      '                         select'
      '                            sum(pdf.valordescontoitem)'
      '                         from'
      '                            produtosdadosfiscais pdf'
      '                         where'
      '                            pdf.dadofiscal = df.numero'
      '                     )'
      '                     ,0) + coalesce(df.desconto,0)) as desconto'
      ''
      '       , df.valortotal'
      '       , df.creditotroca'
      '       , df.totalvaloricmssubstituicao as valoricmssubstituicao'
      ''
      '      from'
      '         dadosfiscais df'
      '         left join'
      '            (usuarios u'
      '            left join'
      '               GruposUsuarios gu'
      '               on'
      '                  u.grupo = gu.codigo)'
      '            on'
      '               df.vendedor = u.codigo'
      ''
      '      Where df.data between :DataInicial and :DataFinal'
      '        and df.contrato is null'
      '            and df.situacao='#39'N'#39
      
        '            and (eHNotaFiscalSaidaVenda(df.codigofiscal) or mod(' +
        'df.codigofiscal,1000) in (929))'
      '            and not coalesce(df.notavinculada,false)'
      ''
      '        %WhereFiliais'
      '        %WhereAgentes'
      '        %WhereConceito'
      '        %WhereRegioes_ct'
      '        %WhereVendedores_ct'
      '        %WhereGrupoVendedores_ct'
      ''
      '        %WhereClientes'
      ''
      '       ) as contratos_v'
      '      ) as contratostipo_v'
      '      %whereTipodeVenda'
      '     ) as contratosparcelas_v'
      '       where f.codigo=contratosparcelas_v.filialvenda'
      '       %WhereOrdenacao_Vendas'
      #9'   '
      ''
      '   )'
      ''
      '%InicioAgrupamentoSomatorio'
      '/*'
      '  as contratossomados_v'
      
        '  group by nomegrupofilialvenda, grupofilialvenda, nomefilialven' +
        'da, filialvenda, nomecliente, tipocliente, cliente, tipo'
      ' ) as contratosresomados_v'
      
        '   group by nomegrupofilialvenda, grupofilialvenda, nomefilialve' +
        'nda, filialvenda, nomecliente, tipocliente, cliente, tipo, ncont' +
        'rato, dadofiscal, codigonota, datavenda, contratoavista, tipoA'
      ' ) as contratosresomados_selecionados_v'
      '   %WhereOrdenacao_Total_Vendas'
      ''
      ' ) as contratosresomados_reselecionados_v'
      
        '   group by nomegrupofilialvenda, grupofilialvenda, nomefilialve' +
        'nda, filialvenda, nomecliente, tipocliente, cliente, tipo, ncont' +
        'rato, dadofiscal, codigonota, datavenda, contratoavista, tipoA'
      ')'
      '%FimAgrupamentoSomatorio'
      '*/')
    RequestLive = False
    Left = 340
    Top = 336
    ParamData = <
      item
        DataType = ftBoolean
        Name = 'AgruparFilial'
        ParamType = ptUnknown
        Value = False
      end
      item
        DataType = ftBoolean
        Name = 'AgruparGrupoFilial'
        ParamType = ptUnknown
        Value = 'false'
      end
      item
        DataType = ftBoolean
        Name = 'MaioresClientes'
        ParamType = ptUnknown
        Value = 'False'
      end
      item
        DataType = ftString
        Name = 'DataInicial'
        ParamType = ptUnknown
        Value = '10/08/2005'
      end
      item
        DataType = ftString
        Name = 'DataFinal'
        ParamType = ptUnknown
        Value = '10/08/2005'
      end>
  end
  object qryContratosDevolucoes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
