        DataType = ftUnknown
        Name = 'WhereAgentes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereConceito'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereRegioes_ct'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereVendedores_ct'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereGrupoVendedores_ct'
        ParamType = ptUnknown
      end
