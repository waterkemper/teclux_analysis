  object qryImprimirNotasCuponsResumo: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      '   select  cast(null as varchar) as ncontrato,'
      
        '          case when :AgruparFilial then cast(filialvenda as inte' +
        'ger) else cast(null as integer) end as filialvenda,'
      
        '          case when :AgruparFilial then cast(nomefilialvenda as ' +
        'varchar) else cast(null as varchar) end as nomefilialvenda,'
      
        '          case when :AgruparGrupoFilial then cast(grupofilialven' +
        'da as integer) else cast(null as integer) end as grupofilialvend' +
        'a,'
      
        '          case when :AgruparGrupoFilial then cast(nomegrupofilia' +
        'lvenda as varchar) else cast(null as varchar) end as nomegrupofi' +
        'lialvenda,'
      '          cast(null as integer) as cliente,'
      '          cast(null as varchar) as tipocliente,'
      '          cast(null as varchar) as nomecliente,'
      
        '          case when :AgruparDataVenda then cast(datavenda as dat' +
        'e) else cast(null as date) end as datavenda,'
      '          cast(sum(valorvista) as Numeric) as valorvista,'
      '          cast(sum(valorfrete) as Numeric) as valorfrete,'
      '          cast(sum(seguro) as Numeric) as seguro,'
      '          cast(sum(desconto) as Numeric) as desconto,'
      
        '          cast(sum(despesasacessorias) as Numeric) as despesasac' +
        'essorias,'
      '          cast(sum(valortotal) as numeric) as valortotal, '
      
        '          cast(sum(vendamercadorias) as numeric) as vendamercado' +
        'rias,'
      '          cast(sum(vendaservicos) as numeric) as vendaservicos,'
      '          cast(null as varchar) as serie,'
      '          cast(null as integer) as notafiscal,'
      '          cast(null as integer) as maquina,'
      '          cast(null as integer) as intervensao,'
      '          cast(null as integer) as cupomfiscal,         '
      
        '          cast(Tipo as varchar) as tipo, cast(TipoA as varchar) ' +
        'as tipoA, '
      '          cast(sum(outras) as numeric) as outras,'
      '          cast(sum(eFinanceiro) as numeric) as eFinanceiro, '
      '          cast(sum(valortotalABS) as Numeric) as valortotalABS,'
      
        '          cast(sum(valoricmssubstituicao) as Numeric) as valoric' +
        'mssubstituicao,'
      '          cast(contratoavista as boolean) as contratoavista,'
      '          cast(sum(tregistros) as integer) as tregistros,'
      '         Totalizado'
      ' from'
      ' (')
