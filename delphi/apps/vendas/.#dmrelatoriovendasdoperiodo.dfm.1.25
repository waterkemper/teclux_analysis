    Sql.Strings = (
      '%InicioSomatorio'
      '/*'
      '('
      '   select  cast(numero as integer) as numero,'
      '          cast(ncontrato as varchar) as ncontrato,'
      '          cast(filialvenda as integer) as filialvenda,'
      '          cast(cliente as integer) as cliente,'
      '          cast(tipocliente as varchar) as tipocliente,'
      '          cast(datavenda as date) as datavenda,'
      '          cast(sum(valorvista) as Numeric) as valorvista,'
      '          cast(sum(valorfrete) as Numeric) as valorfrete,'
      '          cast(sum(seguro) as Numeric) as seguro,'
      #9'  cast(sum(desconto) as numeric) as desconto,'
      
        '          cast(sum(despesasacessorias) as Numeric) as despesasac' +
        'essorias,'
      '          cast(sum(valortotal) as numeric) as valortotal,'
      '          cast(sum(outras) as numeric) as outras,'
      '          cast(sum(eFinanceiro) as numeric) as eFinanceiro,'
      #9'  cast(sum(valortotalABS) as Numeric) as valortotalABS,'
      
        '          cast(sum(valoricmssubstituicao) as numeric) as valoric' +
        'mssubstituicao,'
      #9'  cast(contratoavista as boolean) as contratoavista,'
      '          cast(nomecliente as varchar) as nomecliente,'
      '          cast(serie as varchar) as serie,'
      '          cast(notafiscal as integer) as notafiscal,'
      '          cast(maquina as integer) as maquina,'
      '          cast(intervensao as integer) as intervensao,'
      '          cast(cupomfiscal as integer) as cupomfiscal,'
      '          cast(nomefilialvenda as varchar) as nomefilialvenda,'
      '          cast(grupofilialvenda as integer) as grupofilialvenda,'
      
        '          cast(nomegrupofilialvenda as varchar) as nomegrupofili' +
        'alvenda,'
      #9'  cast(sum(tregistros) as integer) as tregistros,'
      #9'  Totalizado,'
      
        '          cast(Tipo as varchar) as tipo, cast(TipoA as varchar) ' +
        'as tipoA,'
      
        '          cast(sum(vendamercadorias) as numeric) as vendamercado' +
        'rias,'
      '          cast(sum(vendaservicos) as numeric) as vendaservicos'
      ' from'
      ' ('
      '  select *'
      '  from'
      '  ('
      '   select cast(numero as integer) as numero,'
      '          cast(ncontrato as varchar) as ncontrato,'
      '          cast(filialvenda as integer) as filialvenda,'
      #9'  %cliente'
      '          cast(cliente as integer) as cliente,'
      #9'  %tipocliente'
      '          cast(tipocliente as varchar) as tipocliente,'
      '          cast(datavenda as date) as datavenda,'
      '          cast(sum(valorvista) as Numeric) as valorvista,'
      '          cast(sum(valorfrete) as Numeric) as valorfrete,'
      '          cast(sum(seguro) as Numeric) as seguro,'
      #9'  cast(sum(desconto) as numeric) as desconto,'
      
        '          cast(sum(despesasacessorias) as Numeric) as despesasac' +
        'essorias,'
      '          cast(sum(valortotal) as numeric) as valortotal,'
      '          cast(sum(outras) as numeric) as outras,'
      '          cast(sum(eFinanceiro) as numeric) as eFinanceiro,'
      #9'  cast(sum(valortotalABS) as Numeric) as valortotalABS,'
      
        '          cast(sum(valoricmssubstituicao) as numeric) as valoric' +
        'mssubstituicao,'
      #9'  cast(contratoavista as boolean) as contratoavista,'
      #9'  %nomecliente'
      '          cast(nomecliente as varchar) as nomecliente,'
      '          cast(serie as varchar) as serie,'
      '          cast(notafiscal as integer) as notafiscal,'
      '          cast(maquina as integer) as maquina,'
      '          cast(intervensao as integer) as intervensao,'
      '          cast(cupomfiscal as integer) as cupomfiscal,'
      '          cast(nomefilialvenda as varchar) as nomefilialvenda,'
      '          cast(grupofilialvenda as integer) as grupofilialvenda,'
      
        '          cast(nomegrupofilialvenda as varchar) as nomegrupofili' +
        'alvenda,'
      #9'  cast(sum(tregistros) as integer) as tregistros,'
      #9'  Totalizado,'
      
        '          cast(Tipo as varchar) as tipo, cast(TipoA as varchar) ' +
        'as tipoA,'
      
        '          cast(sum(vendamercadorias) as numeric) as vendamercado' +
        'rias,'
      '          cast(sum(vendaservicos) as numeric) as vendaservicos'
      '  from'
      ' ('
      
        '  select  cast(null as integer) as numero, cast(null as varchar)' +
        ' as ncontrato,'
      
        '          cast(case when :AgruparFilial then filialvenda else nu' +
        'll end as integer) as filialvenda,'
      
        '          cast(case when :MaioresClientes then cliente else null' +
        ' end as integer) as cliente,'
      
        '          cast(case when :MaioresClientes then tipocliente else ' +
        'null end as varchar) as tipocliente,'
      '          cast('#39'30/12/1899'#39' as date) as datavenda,'
      '          cast(sum(valorvista) as Numeric) as valorvista,'
      '          cast(sum(valorfrete) as numeric) as valorfrete,'
      '          cast(sum(seguro) as numeric) as seguro,'
      #9'  cast(sum(desconto) as numeric) as desconto,'
      
        '          cast(sum(despesasacessorias) as numeric) as despesasac' +
        'essorias,'
      '          cast(sum(valortotal) as Numeric) as valortotal,'
      '          cast(sum(outras) as numeric) as Outras,'
      '          cast(sum(eFinanceiro) as numeric) as eFinanceiro,'
      #9'  cast(sum(valortotalABS) as Numeric) as valortotalABS,'
      
        '          cast(sum(valoricmssubstituicao) as numeric) as valoric' +
        'mssubstituicao,'
      #9'  cast(null as boolean) as contratoavista,'
      
        '          cast(case when :MaioresClientes then nomecliente else ' +
        #39'OUTROS'#39' end as varchar) as nomecliente,'
      '          cast(null as varchar) as serie,'
      '          cast(null as integer) as notafiscal,'
      '          cast(null as integer) as maquina,'
      '          cast(null as integer) as intervensao,'
      '          cast(null as integer) as cupomfiscal,'
      
        '          cast(case when :AgruparFilial then nomefilialvenda els' +
        'e null end as varchar) as nomefilialvenda,'
      
        '          cast(case when :AgruparGrupoFilial then grupofilialven' +
        'da else null end as integer) as grupofilialvenda,'
      
        '          cast(case when :AgruparGrupoFilial then nomegrupofilia' +
        'lvenda else null end as varchar) as nomegrupofilialvenda,'
      #9'  cast(sum(tregistros) as integer) as tregistros,'
      #9'  Totalizado,'
      
        '          cast(Tipo as varchar) as tipo, cast(null as varchar) a' +
        's tipoA,'
      
        '          cast(sum(vendamercadorias) as numeric) as vendamercado' +
        'rias,'
      '          cast(sum(vendaservicos) as numeric) as vendaservicos'
      '   from'
      '%FimSomatorio'
      '*/'
      '('
      ' select notaspag.*,'
      '        cast(null as integer) as maquina,'
      '        cast(null as integer) as intervensao,'
      '        cast(null as integer) as cupomfiscal,'
      '        f.nome as nomefilialvenda,'
      '        fgf.grupo as grupofilialvenda,'
      '        gf.descricao as nomegrupofilialvenda,'
      '        cast(1 as integer) as tregistros,'
      '        false as Totalizado,'
      '        cast('#39'Cancelamentos'#39' as varchar) as tipo,'
      #9'case when contratoavista then  cast('#39'CT'#39' as varchar)'
      
        #9'                         else cast('#39'CF'#39' as varchar) end as tipo' +
        'A,'
      '        -(select sum(pnp.quantidade*pnp.precounitario)'
      #9'  from produtosnotaspag pnp'
      
        '          where pnp.codigonota=notaspag.numero ) as vendamercado' +
        'rias,'
      '        0 as vendaservicos'
      ' from'
      ' ('
      '  select notaspag.numero,'
      '         notaspag.ncontrato,'
      #9' notaspag.filialvenda,'
      #9' notaspag.cliente,'
      #9' notaspag.tipocliente,'
      '         notaspag.datavenda,'
      #9' notaspag.valorvista,'
      #9' notaspag.valorfrete,'
      #9' notaspag.seguro,'
      #9' notaspag.desconto,'
      #9' notaspag.despesasacessorias,'
      '         notaspag.valortotal,'
      #9' notaspag.Outras,'
      #9' notaspag.eFinanceiro,'
      #9' notaspag.valortotalABS,'
      '         notaspag.valoricmssubstituicao,'
      #9' notaspag.contratoavista,'
      '         coalesce(vf.razao,vf.nome) as nomecliente,'
      #9' notaspag.serie,'
      #9' notaspag.notafiscal'
      '  from'
      '  ('
      '   select notaspag.*,'
      
        '          notaspag.valorfrete+ notaspag.seguro + notaspag.despes' +
        'asacessorias as Outras,'
      
        '          notaspag.valortotal-(notaspag.valorvista+notaspag.valo' +
        'rfrete+notaspag.seguro+notaspag.despesasacessorias) as eFinancei' +
        'ro,'
      #9'  abs(notaspag.valortotal) as valortotalABS,'
      '          ((select count(*)'
      #9'    from parcelas p'
      #9'    where p.contrato = ct.numero'
      #9'      and p.datavencto > ct.faturamento)=0) as contratoavista'
      '   from'
      '   ('
      '    select notaspag.*'
      '    from'
      '    ('
      '     select np.codigo as numero,'
      '            np.contrato as ncontrato,'
      '            np.filial as filialvenda,'
      '            np.fornecedor as cliente,'
      '            np.tipofornecedor as tipocliente,'
      '            np.data as datavenda,'
      '            -(select sum(pnp.quantidade*pnp.precounitario)'
      #9'           from produtosnotaspag pnp'
      #9'           where pnp.codigonota=np.codigo) as valorvista,'
      ''
      '            -coalesce(np.freteinterno,  0) as valorfrete,'
      '            -coalesce(np.seguro,0) as seguro,'
      
        #9'          -(coalesce(np.descontoitem,0) + coalesce(np.desconto,' +
        '0)) as desconto,'
      
        '            -coalesce(np.despesasacessorias,0) as despesasacesso' +
        'rias,'
      '            -np.valornota as valortotal,'
      '            np.serie,'
      '            np.numero as notafiscal,'
      '            np.valoricmssubstituicao,np.codigofiscal'
      '     from notaspag np'
      
        '     Where (np.data between (:DataInicial) and (:DataFinal) and ' +
        'situacao='#39'N'#39')'
      '  %WhereFiliais_devolucoes'
      '  %WhereClientes_devolucoes'
      '    ) as notaspag'
      '   ) as notaspag'
      '        left join contratos ct'
      
        '                  left join (usuarios u left join GruposUsuarios' +
        ' gu on u.grupo = gu.codigo)'
      '                  on ct.vendedor = u.codigo'
      '        on notaspag.ncontrato=ct.numero'
      
        '        where ehnotafiscalentradadevolucao(notaspag.codigofiscal' +
        ') and case when ct.os then ct.tipoequipamento in (1,2) and not c' +
        'oalesce(ct.os_garantia,false) and not coalesce(ct.os_cortesia,fa' +
        'lse) else true end'
      ''
      '  %WhereAgentes'
      '  %WhereConceito'
      '  %WhereRegioes_ct'
      '  %WhereVendedores_ct'
      '  %WhereGrupoVendedores_ct'
      ''
      '  %WhereDevolucoes'
      
        '  ) as notaspag  left join vfornecedores vf on notaspag.cliente=' +
        'vf.codigo and notaspag.tipocliente=vf.tipo'
      '  %whereTipodeVenda'
      
        ' ) as notaspag left join (filiais f left join (filiaisgruposfili' +
        'ais fgf join gruposfiliais gf on fgf.grupo=gf.codigo %WhereGrupo' +
        'sFiliais)'
      
        '                                                                ' +
        '                         on f.codigo=fgf.filial)'
      
        '                                                on notaspag.fili' +
        'alvenda=f.codigo'
      '%WhereOrdenacao_Devolucoes'
      ''
      ')'
      '%InicioAgrupamentoSomatorio'
      '/*'
      '  as notasomadas_d'
      
        '  group by nomegrupofilialvenda, grupofilialvenda, nomefilialven' +
        'da, filialvenda, nomecliente, tipocliente, cliente, tipo, Totali' +
        'zado'
      ' ) as notasresomadas_d'
      
        '   group by nomegrupofilialvenda, grupofilialvenda, nomefilialve' +
        'nda, filialvenda, nomecliente, tipocliente, cliente, tipo, contr' +
        'atoavista, tipoA, numero, ncontrato, datavenda, serie, notafisca' +
        'l, maquina, intervensao, cupomfiscal, Totalizado'
      ' ) as notasresomadas_selecionadas_d'
      '%WhereOrdenacao_Total_Vendas'
      ''
      ' ) as notasresomadas_reselecionadas_d'
      
        '   group by nomegrupofilialvenda, grupofilialvenda, nomefilialve' +
        'nda, filialvenda, nomecliente, tipocliente, cliente, tipo, contr' +
        'atoavista, tipoA, numero, ncontrato, datavenda, serie, notafisca' +
        'l, maquina, intervensao, cupomfiscal, Totalizado'
      ')'
      '%FimAgrupamentoSomatorio'
      '*/')
    RequestLive = False
    Left = 392
    Top = 64
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'AgruparFilial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'MaioresClientes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'AgruparGrupoFilial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataFinal'
        ParamType = ptUnknown
      end>
  end
  object qryContratosVendas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'InicioSomatorio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'tipocliente'
        ParamType = ptUnknown
