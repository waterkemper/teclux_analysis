  object qryGravarContratosAux: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'CREATE temp TABLE RelatorioContratosVendas AS  '
      '   SELECT  cast(ncontrato as char(20)) as ncontrato,'
      '          cast(dadofiscal as integer) as dadofiscal,'
      '          cast(codigonota as integer) as codigonota,'
      '          cast(filialvenda as integer) as filialvenda,'
      '          cast(nomefilialvenda as varchar) as nomefilialvenda,'
      '          cast(grupofilialvenda as integer) as grupofilialvenda,'
      
        '          cast(nomegrupofilialvenda as varchar) as nomegrupofili' +
        'alvenda,'
      '          cast(cliente as integer) as cliente,'
      '          cast(tipocliente as varchar) as tipocliente,'
      '          cast(nomecliente as varchar) as nomecliente,'
      '          cast(datavenda as date) as datavenda,'
      '          round(cast(valorvista as Numeric),2) as valorvista,'
      '          round(cast(valortotal as numeric),2) as valortotal, '
      
        '          round(cast(vendamercadorias as numeric),2) as vendamer' +
        'cadorias,'
      
        '          round(cast(vendaservicos as numeric),2) as vendaservic' +
        'os,'
      
        '          round(cast(frete_seguro as numeric),2) as frete_seguro' +
        ','
      '          round(cast(desconto as numeric),2) as desconto,'
      '          cast(contratoavista as boolean) as contratoavista,'
      
        '          round(cast(CreditoTroca as numeric),2) as CreditoTroca' +
        ','
      
        '          round(cast(ValoricmsSubstituicao as numeric),2) as Val' +
        'oricmssubstituicao,'
      '          round(cast(entradas as numeric),2) as entradas,'
      '          cast(qtparcelas as integer) as qtparcelas,'
      '          round(cast(aVista as numeric),2) as aVista,'
      '          round(cast(aPrazo as numeric),2) as aPrazo,'
      '          round(cast(eFinanceiro as numeric),2) as eFinanceiro,'
      
        '          cast(Tipo as varchar) as tipo, cast(TipoA as varchar) ' +
        'as tipoA, '
      
        '          round(cast(valortotalABS as numeric),2) as valortotalA' +
        'BS,'
      '          cast(tregistros as integer) as tregistros          '
      '  FROM'
      '(')
    RequestLive = False
    Left = 397
    Top = 173
  end
