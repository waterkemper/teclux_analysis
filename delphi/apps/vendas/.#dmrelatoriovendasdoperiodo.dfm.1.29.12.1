      '('
      '   select ncontrato,'
      '          dadofiscal,'
      '          cast(null as integer) as codigonota,'
      '            filialvenda,'
      '            f.nome as nomefilialvenda,'
      '            fgf.grupo as grupofilialvenda,'
      '            gf.descricao as nomegrupofilialvenda,'
      '            cliente,'
      '            tipocliente,'
      '            nomecliente,'
      '            datavenda,'
      '            datahoraemissao,'
      '            valorvista,'
      '            valortotal,'
      '            vendamercadorias,'
      '            vendaservicos,'
      '            frete_seguro, desconto,'
      '            contratoavista,'
      '            0 as CreditoTroca,'
      '            valoricmssubstituicao,'
      '            entradas,'
      '            qtparcelas,'
      '            aVista,'
      '            0 as aPrazo,'
      '            0 as EFinanceiro,'
      '            Cast('#39'C'#39' as varchar) as Tipo,'
      #9'    case when contratoavista then cast('#39'CT'#39' as varchar)'
      
        #9'         else                     cast('#39'CF'#39' as varchar) end as ' +
        'TipoA,'
      '            abs(ValorTotal) as ValorTotalABS,'
      '            - cast(1 as integer) as tregistros,'
      #9#9#9'codigotabelapreco as tabelapreco,'
      #9#9#9'col.descricao as descricaotabelapreco'
      #9#9#9
      
        ' from (filiais f left join (filiaisgruposfiliais fgf join grupos' +
        'filiais gf on fgf.grupo=gf.codigo %WhereGruposFiliais)'
      
        '                                                     on f.codigo' +
        '=fgf.filial), colunas col,'
      ' ('
      '  select contratostipo_dn.*,'
      
        '         -case When contratoavista then  valorvencto  else 0 end' +
        ' as avista,'
      
        '         -case When contratoavista then 0 else  valorvencto  end' +
        ' as entradas'
      '   from'
      '   ( select contratos_dn.*,'
      '           (case when (select count(*)'
      #9'               from parcelas p'
      #9#9'       where   p.contrato = ncontrato and'
      
        '                               p.datavencto > faturamento) = 0 t' +
        'hen true'
      '                 else false end) as contratoavista'
      '     from'
      '    ('
      '        select p.contrato as ncontrato,'
      ''
      '              (select df.numero'
      '                from dadosfiscais df'
      '                    where df.contrato = p.contrato'
      
        '                      and df.situacao = '#39'N'#39' limit 1 ) as dadofis' +
        'cal,'
      ''
      '                 ct.filialvenda,'
      '                 ct.cliente,'
      '                 ct.tipocliente,'
      '                 ct.nome as nomecliente,'
      '                 ct.faturamento,'
      '                 p.devcaixa as datavenda,'
      ''
      '                 (select max(parcelas_log.trigger_changed)'
      '                  from parcelas_log'
      '                  where parcelas_log.contrato = p.contrato'
      
        '                    and parcelas_log.numero = p.numero) as datah' +
        'oraemissao,'
      ''
      '                 0 as valorvista,'
      '                 0 as valortotal,'
      ''
      '                 0 as vendamercadorias,'
      
        '                 0 as vendaservicos, 0 as frete_seguro, 0 as des' +
        'conto,'
      '                 sum(valorpagto) as valorpagto,'
      '                 sum(valorvencto) as valorvencto,'
      '                 count(*) as qtparcelas,'
      '                 0.00  as valoricmssubstituicao,'
      #9#9#9#9' ct.codigotabelapreco'
      ''
      '        from contratos ct'
      
        '             left join (usuarios u left join GruposUsuarios gu o' +
        'n u.grupo = gu.codigo)'
      '             on ct.vendedor = u.codigo'
      ''
      '             join parcelas p'
      '             on ct.numero=p.contrato'
      #9#9#9' '
      '        where ct.origem is null'
      
        '          and case when ct.os then ct.tipoequipamento in (1,2) a' +
        'nd not (coalesce(ct.os_garantia,false) and ct.os_garantia_status' +
        '='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      #9'  and (p.tipopagto is not null and p.tipopagto = '#39'X'#39')'
      #9'  and p.devcaixa between (:DataInicial) and (:DataFinal)'
      #9'  and (p.datavencto <= ct.faturamento)'
      #9'  and not p.parcelaadicional'
      '        %WhereDevolucoes'
      '        %WhereFiliais'
      '        %WhereAgentes'
      '        %WhereConceito'
      '        %WhereRegioes_ct'
      '        %WhereVendedores_ct'
      '        %WhereGrupoVendedores_ct'
      ''
      ''
      '        %WhereClientes'
      
        '        group by p.contrato, p.numero, ct.filialvenda,ct.cliente' +
        ',ct.tipocliente,ct.nome,ct.faturamento,p.devcaixa, ct.codigotabe' +
        'lapreco'
      '     ) as contratos_dn'
      '    ) as contratostipo_dn'
      '    %whereTipodeVenda'
      '    %WhereOrdenacao_Cancelamentos'
      ''
      '   ) as contratosparcelas_dn'
      '   where f.codigo = contratosparcelas_dn.filialvenda'
      
        '    and col.codigo = coalesce(contratosparcelas_dn.codigotabelap' +
        'reco, f.preconormal)'
      ')'
      '%InicioAgrupamentoSomatorio'
      '/*'
      '  as contratossomados_dn'
      
        '  group by nomegrupofilialvenda, grupofilialvenda, nomefilialven' +
        'da, filialvenda, descricaotabelapreco, tabelapreco, nomecliente,' +
        ' tipocliente, cliente, tipo'
      ' ) as contratosresomados_dn'
      
        '   group by nomegrupofilialvenda, grupofilialvenda, nomefilialve' +
        'nda, filialvenda, descricaotabelapreco, tabelapreco, nomecliente' +
        ', tipocliente, cliente, tipo, ncontrato, dadofiscal, datavenda, ' +
        'datahoraemissao, contratoavista, tipoA'
      ' ) as contratosresomados_selecionados_dn'
      '%WhereOrdenacao_Total_Vendas'
      ''
      ' ) as contratosresomados_reselecionados_dn'
      
        '   group by nomegrupofilialvenda, grupofilialvenda, nomefilialve' +
        'nda, filialvenda, descricaotabelapreco, tabelapreco, nomecliente' +
        ', tipocliente, cliente, tipo, ncontrato, dadofiscal,  datavenda,' +
        ' datahoraemissao, contratoavista, tipoA'
      ')'
      '%FimAgrupamentoSomatorio'
      '*/'
      ''
      ''
      ''
      ''
      '/*'
      
        'N'#227'o retirar apenas para manter compatibilidde entre as macros e ' +
