      '%FimSomatorio'
      '*/'
      '  ('
      '  select dadosfiscais.*,'
      
        '       coalesce(dadosfiscais.codigotabelapreco,f.preconormal) as' +
        ' tabelapreco,'
      '       col.descricao as descricaotabelapreco, '
      '       f.nome as nomefilialvenda,'
