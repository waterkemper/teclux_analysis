          'select df.datahoraemissao, df.valortotal from dadosfiscais df WH' +
          'ERE cast(df.datahoraemissao as date) between '#39'2023-09-01'#39' and '#39'2' +
          '023-10-31'#39
      end>
    Sql.Strings = (
      ';'
      'SELECT'
      '     ano,      '
      '/*     mes_num, */'
      '     mes,     '
      '     hora'
      '     '
      ',sum(case when semana='#39'0'#39' then valor_total end) as "T_Domingo"'
      ',sum(case when semana='#39'0'#39' then Qtde_total end) as "Q_Domingo"'
      ''
      ',sum(case when semana='#39'1'#39' then valor_total end) as "T_Segunda"'
      ',sum(case when semana='#39'1'#39' then Qtde_total end) as "Q_Segunda"'
      ''
      ',sum(case when semana='#39'2'#39' then valor_total end) as "T_Ter'#231'a"'
      ',sum(case when semana='#39'2'#39' then Qtde_total end) as "Q_Ter'#231'a"'
      ''
      ',sum(case when semana='#39'3'#39' then valor_total end) as "T_Quarta"'
      ',sum(case when semana='#39'3'#39' then Qtde_total end) as "Q_Quarta"'
      ''
      ',sum(case when semana='#39'4'#39' then valor_total end) as "T_Quinta"'
      ',sum(case when semana='#39'4'#39' then Qtde_total end) as "Q_Quinta"'
      ''
      ',sum(case when semana='#39'5'#39' then valor_total end) as "T_Sexta"'
      ',sum(case when semana='#39'5'#39' then Qtde_total end) as "Q_Sexta"'
      ''
      ',sum(case when semana='#39'6'#39' then valor_total end) as "T_Sabado"'
      ',sum(case when semana='#39'6'#39' then Qtde_total end) as "Q_Sabado"'
      ''
      ',sum(valor_total) as valor_total'
      ',sum(Qtde_total) as Qtde_total'
      ''
      ''
      'FROM'
      '('
      '  SELECT'
      ''
      '    EXTRACT(YEAR FROM df.datahoraemissao) AS ano,'
      '/*    EXTRACT(MONTH FROM df.datahoraemissao) AS mes_num,  */'
      ''
      
        '    cast(EXTRACT(MONTH FROM df.datahoraemissao)||'#39' - '#39'||to_char(' +
        'df.datahoraemissao, '#39'TMMonth'#39') as varchar(20)) AS mes,'
      '    '
      
        '    cast(cast(LPAD(cast(EXTRACT(HOUR FROM df.datahoraemissao) as' +
        ' VARCHAR), 2, '#39'0'#39') as varchar(2))||'#39':'#39'||   '
      
        '    case when EXTRACT(MINUTE FROM df.datahoraemissao) <= 30 then' +
        ' CAST('#39'30'#39' as varchar(2)) else CAST('#39'00'#39' as varchar(2)) end  as ' +
        'varchar(5)) AS hora, '
      ''
      '    EXTRACT(DOW FROM df.datahoraemissao) as semana,'
      ''
      '    SUM(df.valortotal) AS valor_total,'
      '    cast(count(df.tregistros) as integer) AS Qtde_total'
      ''
      '    from'
      '    ('
      ''
      ''
      '     %ConteudoRelatorio'
      ''
      '/*'
      
        '  FROM  select df.datahoraemissao, df.valortotal from dadosfisca' +
        'is df WHERE cast(df.datahoraemissao as date) between '#39'2023-09-01' +
        #39' and '#39'2023-10-31'#39
      '*/'
      ''
      '    )  as df'
      ''
      '  GROUP BY'
      '    ano, /*mes_num,*/ mes, semana, hora'
      '  ORDER BY'
      '    ano, /*mes_num,*/ semana, hora'
      '    '
      ' '
      ') as _d GROUP BY ano, /*mes_num,*/ mes, hora'
      'order BY  ano, /*mes_num,*/ mes, hora')
