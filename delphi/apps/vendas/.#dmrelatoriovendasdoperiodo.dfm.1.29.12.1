        '          cast(Tipo as varchar) as tipo, cast(TipoA as varchar) ' +
        'as tipoA, cast(sum(valortotalABS) as numeric) as valortotalABS,'
      '          cast(sum(tregistros) as numeric) as tregistros'
      ' from'
      ' ('
      '  select *'
      '  from'
