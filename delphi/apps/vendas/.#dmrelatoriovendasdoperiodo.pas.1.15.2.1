  else if ParName = 'TVLRPRESENTE_C' then
   ParValue := CalcularTotal(qryTotalizacaoTVlrPresente_C)
  else if ParName = 'TFRETE_SEGURO_V' then
   ParValue := CalcularTotal(qryTotalizacaotfrete_seguro_v)
  else if ParName = 'TFRETE_SEGURO_C' then
   ParValue := CalcularTotal(qryTotalizacaotfrete_seguro_c)
  else if ParName = 'TDESCONTO_V' then
   ParValue := CalcularTotal(qryTotalizacaotdesconto_v)
  else if ParName = 'TDESCONTO_C' then
   ParValue := CalcularTotal(qryTotalizacaotdesconto_c)
