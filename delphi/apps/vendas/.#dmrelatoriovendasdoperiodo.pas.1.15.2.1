 // Filtros
 const
  FiltroFilial_contratos      = ' AND ( ct.filialvenda IN (%s)) ' +#13#10;
  FiltroGrupoFilial_contratos = ' AND ( ct.filialvenda IN (SELECT filial '+#13#10+
                                         'FROM filiaisgruposfiliais fgf '+#13#10+
                                         'WHERE fgf.grupo IN (%s))) ';
  FiltroGruposFiliais = ' and gf.codigo in (%s) ';

  FiltroFilial_notas      = ' AND ( df.filialvenda IN (%s)) ' +#13#10;
  FiltroGrupoFilial_notas = ' AND ( df.filialvenda IN (SELECT filial '+#13#10+
                                         'FROM filiaisgruposfiliais fgf '+#13#10+
                                         'WHERE fgf.grupo IN (%s))) ';

  FiltroFilial_devolucoes      = ' AND ( np.filial IN (%s)) ' +#13#10;
  FiltroGrupoFilial_devolucoes = ' AND ( np.filial IN (SELECT filial '+#13#10+
                                         'FROM filiaisgruposfiliais fgf '+#13#10+
                                         'WHERE fgf.grupo IN (%s))) ';

  FiltroConceito    = ' AND ( conceito IN (%s)) ' +#13#10;
  FiltroAgente      = ' AND ( agente IN (%s)) ' +#13#10;

{$R *.dfm}

{ TdtmRelatorioVendasdoPeriodo }

constructor Tdtmrelatoriovendasdoperiodo.Create(AOwner: TComponent);
begin
  inherited;
  qryClienteInicial.Tag   := ctTabelas;
  qryClienteFinal.Tag   := ctTabelas;
  qryConsultaClientes.Tag := ctPesquisaClientes;
  qryClienteInicial.Params[1].AsString := 'C';
  qryClienteFinal.Params[1].AsString := 'C';

end;

procedure Tdtmrelatoriovendasdoperiodo.ImprimirRelatorio;
begin
  frVariables['Outras']:= FParametroCabecalho;
  frVariables['AgruparGrupoFilial']:=FAgruparGrupoFilial;
  frVariables['AgruparFilial']:=FAgruparFilial;
  frVariables['AgruparDataVenda']:=FAgruparDataVenda;
  frVariables['SepararVendas']:=FSepararVendas;
  frVariables['SepararDevolucoes']:=FSepararDevolucoes;
  frVariables['ExibirTotaisVendasDevolucoes']:= FExibirTotaisVendaseDevolucoes;

  frVariables['ContratoComServico']:=ParSistema.ContratoComServico;
  case fOpcaoRelatorio of
   0: begin
       ReFazConsulta(qryTotalizacao, [],[]);
       qryTotalizacao.Delete;
       frVariables['Titulo']:= 'VENDAS DO PERÍODO POR CONTRATOS';
       frVariables['VendaaVista']:=FVendaaVista;
       frVariables['VendaaPrazo']:=FVendaaPrazo;
      end;
   1: begin
       ReFazConsulta(qryTotalizacaoNotas, [],[]);
       qryTotalizacaoNotas.Delete;
       frVariables['Titulo']:= 'VENDAS DO PERÍODO POR NOTAS/CUPONS';
      end;
  end;
//  frpImprimirVendas.designreport;
//  frpImprimirVendas.ShowReport;

  case FOpcaoRelatorio of
    0 : ImprimirRelatoriofast(null, null, MPadrao, FResumo, [frpImprimirVendas, frpImprimirVendasResumo], false, self);
    1 : ImprimirRelatoriofast(null, null, MPadrao, FResumo, [frpImprimirNotasCupons, frpImprimirNotasCuponsResumo], false, self);
  end;

  case FOpcaoRelatorio of

    0 : begin
         qryImprimirDadosFiscais.Close;
         qryImprimirContratos.Close;
         ApagarTabelaTemporaria;
        end;

    1 : qryImprimirNotasCupons.Close;
    end;

end;


procedure Tdtmrelatoriovendasdoperiodo.MontaDatas;
begin
  case FOpcaoRelatorio of
  0 : begin
       qryGravarContratos.ParamByName('DataInicial').AsString := FDataInicial;
       qryGravarContratos.ParamByName('DataFinal').AsString := FDataFinal;
      end;
  1 : begin
       qryImprimirNotasCupons.ParamByName('DataInicial').AsString := FDataInicial;
       qryImprimirNotasCupons.ParamByName('DataFinal').AsString := FDataFinal;
      end;
  end;
  FParametroCabecalho:='Entre: '+FDataInicial+' e '+FDataFinal;
end;

procedure Tdtmrelatoriovendasdoperiodo.SetAgentes(const Value: String);
begin
  if (Value <> '') then
  begin
   case FOpcaoRelatorio of
   0: qryGravarContratos    .MacroByName('WhereAgentes').AsString := Format(FiltroAgente,[Value]);
   1: qryImprimirNotasCupons.MacroByName('WhereAgentes').AsString := Format(FiltroAgente,[Value]);
   end;
  end
  else
  begin
   case FOpcaoRelatorio of
   0: qryGravarContratos    .MacroByName('WhereAgentes').AsString := '';
   1: qryImprimirNotasCupons.MacroByName('WhereAgentes').AsString := '';
   end;
  end;
end;

procedure Tdtmrelatoriovendasdoperiodo.SetConceitos(const Value: String);
begin
  if (Value <> '') then
  begin
   case FOpcaoRelatorio of
   0: qryGravarContratos.MacroByName('WhereConceito').AsString := Format(FiltroConceito,[Value]);
   1: qryImprimirNotasCupons.MacroByName('WhereConceito').AsString := Format(FiltroConceito,[Value]);
   end;
  end
  else
  begin
   case FOpcaoRelatorio of
   0: qryGravarContratos.MacroByName('WhereConceito').AsString := '';
   1: qryImprimirNotasCupons.MacroByName('WhereConceito').AsString := '';
   end;
  end
end;

procedure Tdtmrelatoriovendasdoperiodo.SetDataFinal(const Value: String);
begin
  if not DataEmBranco(Value) then
  begin
    FDataFinal := Value;
    if DataEmBranco(FDataInicial) then
      FDataInicial:=FDataFinal;
  end
  else
   FDataFinal := FDataInicial;
end;

procedure Tdtmrelatoriovendasdoperiodo.SetDataInicial(const Value: String);
begin
  if not DataEmBranco(Value) then
    FDataInicial := Value;
end;

procedure Tdtmrelatoriovendasdoperiodo.SetFiliais(const Value: String);
begin
  FFiliais := Value;
  if (Value <> '') then
  begin
   case FOpcaoRelatorio of
    0: begin
