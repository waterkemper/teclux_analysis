   TRecebido_C    := TRecebido_C + qryTotalizacaoTRecebido_C.AsCurrency;
   TAprazo_C      := TAprazo_C + qryTotalizacaoTAprazo_C.AsCurrency;
   TAvista_C      := TAvista_C + qryTotalizacaoTAvista_C.AsCurrency;
