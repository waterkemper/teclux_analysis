     else ParValue := '';
   end
   else
   begin
     if (qryImprimirContratosValoricmssubstituicao.AsFloat<>0) then
      ParValue := formatarvalor(qryImprimirContratosValoricmssubstituicao.AsFloat,2)
     else ParValue := '';
   end;
  end
  else if ANSIUpperCase(ParName) = 'RODAPEVALORTOTAL_DEBCREDICMS' then
  begin
   if ParSistema.utilizarcreditotrocacontrato then
     ParValue := 'Valor Total - Deb./Cred. do Cliente'
   else
     ParValue := 'Valor Total - ICMS Substituição';
  end
  else if ANSIUpperCase(ParName) = 'VALORVISTA' then
  begin
   if (qryImprimirContratosvalorvista.AsFloat<>0) then
    ParValue := formatarvalor(qryImprimirContratosvalorvista.AsFloat,2)
   else ParValue := '';
  end
  else if ANSIUpperCase(ParName) = 'EFINANCEIRO' then
  begin
   if (qryImprimirContratosefinanceiro.AsFloat<>0) then
    ParValue := formatarvalor(qryImprimirContratosefinanceiro.AsFloat,2)
   else ParValue := ''
  end
  else if ANSIUpperCase(ParName) = 'VALORTOTAL' then
  begin
   if (qryImprimirContratosvalortotal.AsFloat<>0) then
    ParValue := formatarvalor(qryImprimirContratosvalortotal.AsFloat,2)
   else ParValue := ''
  end
  else if ANSIUpperCase(ParName) = 'RECEBIDO' then
  begin
   if ((qryImprimirContratosavista.AsFloat+qryImprimirContratosentradas.AsFloat)<>0) then
    ParValue := formatarvalor((qryImprimirContratosavista.AsFloat+qryImprimirContratosentradas.AsFloat),2)
   else ParValue := ''
  end
  else if ANSIUpperCase(ParName) = 'APRAZO' then
  begin
   if (qryImprimirContratosaprazo.AsFloat<>0) then
    ParValue := formatarvalor(qryImprimirContratosaprazo.AsFloat,2)
   else ParValue := ''
  end
  else if ANSIUpperCase(ParName) = 'QTPARCELAS' then
  begin
   if (qryImprimirContratosqtparcelas.AsInteger<>0) then
    ParValue := qryImprimirContratosqtparcelas.AsString
   else ParValue := ''
  end
  else if ANSIUpperCase(ParName) = 'AVISTA' then
  begin
   if (qryImprimirContratosavista.AsFloat<>0) then
    ParValue := formatarvalor(qryImprimirContratosavista.AsFloat,2)
