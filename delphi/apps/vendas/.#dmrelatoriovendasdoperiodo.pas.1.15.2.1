    FListaConceitos.AddObject(format('%2s',[qryConceitoscodigo.AsString])+'.'+qryConceitosdescricao.AsString, Pointer(qryConceitoscodigo.AsInteger));
    qryConceitos.Next;
  end;
  qryConceitos.Close;
