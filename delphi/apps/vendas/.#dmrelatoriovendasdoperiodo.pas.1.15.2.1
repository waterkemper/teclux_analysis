           qryImprimirNotasCupons.ParamByName('MaioresClientes').AsBoolean := FMaioresClientesdoPeriodo;
          end
          else
          begin
           qryNotasVendas.sql[NumerodalinhanoTexto(qryNotasVendas.sql,'%InicioSomatorio')+1] := '';
           qryNotasVendas.sql[NumerodalinhanoTexto(qryNotasVendas.sql,'%FimSomatorio')+1] := '';
           qryNotasVendas.sql[NumerodalinhanoTexto(qryNotasVendas.sql,'%InicioAgrupamentoSomatorio')+1] := '';
           qryNotasVendas.sql[NumerodalinhanoTexto(qryNotasVendas.sql,'%FimAgrupamentoSomatorio')+1] := '';

           qryImprimirNotasCupons.Sql.Text := qryImprimirNotasCupons.Sql.Text +
                                            qryNotasVendas.Sql.Text;

           qryNotasVendas.sql[NumerodalinhanoTexto(qryNotasVendas.sql,'%InicioSomatorio')+1] := '/*';
           qryNotasVendas.sql[NumerodalinhanoTexto(qryNotasVendas.sql,'%FimSomatorio')+1] := '*/';
           qryNotasVendas.sql[NumerodalinhanoTexto(qryNotasVendas.sql,'%InicioAgrupamentoSomatorio')+1] := '/*';
           qryNotasVendas.sql[NumerodalinhanoTexto(qryNotasVendas.sql,'%FimAgrupamentoSomatorio')+1] := '*/';

           qryNotasDevolucoes.Sql[NumerodalinhanoTexto(qryNotasDevolucoes.sql,'%InicioSomatorio')+1] := '';
           qryNotasDevolucoes.Sql[NumerodalinhanoTexto(qryNotasDevolucoes.sql,'%FimSomatorio')+1] := '';
           qryNotasDevolucoes.Sql[NumerodalinhanoTexto(qryNotasDevolucoes.sql,'%InicioAgrupamentoSomatorio')+1] := '';
           qryNotasDevolucoes.Sql[NumerodalinhanoTexto(qryNotasDevolucoes.sql,'%FimAgrupamentoSomatorio')+1] := '';

           if FDevolucoesPeriodoAnterior or FDevolucoesPeriodoSelecionado then
           begin
            qryImprimirNotasCupons.Sql.Append('union all');
            qryImprimirNotasCupons.Sql.Text := qryImprimirNotasCupons.Sql.Text +
                                               qryNotasDevolucoes.Sql.Text;
           end;
           qryNotasDevolucoes.Sql[NumerodalinhanoTexto(qryNotasDevolucoes.sql,'%InicioSomatorio')+1] := '/*';
           qryNotasDevolucoes.Sql[NumerodalinhanoTexto(qryNotasDevolucoes.sql,'%FimSomatorio')+1] := '*/';
           qryNotasDevolucoes.Sql[NumerodalinhanoTexto(qryNotasDevolucoes.sql,'%InicioAgrupamentoSomatorio')+1] := '/*';
           qryNotasDevolucoes.Sql[NumerodalinhanoTexto(qryNotasDevolucoes.sql,'%FimAgrupamentoSomatorio')+1] := '*/';

           qryImprimirNotasCupons.ParamByName('AgruparFilial').AsBoolean := FAgruparFilial;
           qryImprimirNotasCupons.ParamByName('AgruparGrupoFilial').AsBoolean := FAgruparGrupoFilial;
           qryImprimirNotasCupons.ParamByName('MaioresClientes').AsBoolean := FMaioresClientesdoPeriodo;
//           qryImprimirNotasCupons.Sql.insert(0,';');
          end;
        end
        else
         begin
           qryImprimirNotasCupons.Sql.Text := qryImprimirNotasCupons.Sql.Text+
                                              qryNotasVendas.Sql.Text;
                                              
           if FDevolucoesPeriodoAnterior or FDevolucoesPeriodoSelecionado then
           begin
            qryImprimirNotasCupons.Sql.Append('union all');
            qryImprimirNotasCupons.Sql.Text := qryImprimirNotasCupons.Sql.Text +
                                               qryNotasDevolucoes.Sql.Text;
           end;
         end;
      end;
  end;
  SetDevolucoesPeriodoAnterior(FDevolucoesPeriodoAnterior);
end;

function Tdtmrelatoriovendasdoperiodo.AbrirConsultasRelatorio: boolean;
begin
 case OpcaoRelatorio of
  0: begin
      qryGravarContratos.Open;
      qryImprimirContratos.Open;
      qryImprimirDadosFiscais.Open;
      if qryImprimirDadosFiscais.IsEmpty then
      begin
       qryImprimirDadosFiscais.Insert;
       qryImprimirDadosFiscais.post;
      end;
     end;
  1: qryImprimirNotasCupons.Open;
 end;
 result := not (qryImprimirContratos.IsEmpty and qryImprimirNotasCupons.IsEmpty)
end;

