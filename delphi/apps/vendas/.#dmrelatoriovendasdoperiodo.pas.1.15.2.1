  qryTotalizacaoTAprazo_V.AsCurrency := qryTotalizacaoTAprazo_V.AsCurrency+qryImprimirContratosaprazo.AsCurrency;
  qryTotalizacaoTAvista_V.AsCurrency := qryTotalizacaoTAvista_V.AsCurrency+qryImprimirContratosavista.AsCurrency;
  qryTotalizacaoTEntradas_V.AsCurrency := qryTotalizacaoTEntradas_V.AsCurrency+qryImprimirContratosentradas.AsCurrency;
  qryTotalizacaojatotalizado.AsString := 'N';

  qrytotalizacao.Post;

 end
 else
 begin
  qryTotalizacao.Edit;
  qryTotalizacaogrupofilial.AsInteger := FGrupoFilial;
  qryTotalizacaofilial.AsInteger := FFilial;
  qryTotalizacaodata.Asstring := FData;
  qryTotalizacaovendasdevolucoes.AsString := FVendasDevolucoes;

  qryTotalizacaoTRegistros_C.AsInteger := qryTotalizacaoTRegistros_C.AsInteger-qryImprimirContratostregistros.AsInteger;
  qryTotalizacaoTMercadorias_C.AsCurrency := qryTotalizacaoTMercadorias_C.AsCurrency+qryImprimirContratosvendamercadorias.AsCurrency;
  qryTotalizacaoTservicos_C.AsCurrency := qryTotalizacaoTservicos_C.AsCurrency+qryImprimirContratosvendaservicos.AsCurrency;
  qryTotalizacaotfrete_seguro_c.AsCurrency := qryTotalizacaotfrete_seguro_c.AsCurrency+qryImprimirContratosfrete_seguro.AsCurrency;
  qryTotalizacaotdesconto_c.AsCurrency := qryTotalizacaotdesconto_c.AsCurrency+qryImprimirContratosdesconto.AsCurrency;
  qryTotalizacaotcreditooudebito_c.AsCurrency := qryTotalizacaotcreditooudebito_c.AsCurrency+qryImprimirContratoscreditotroca.AsCurrency;
  qryTotalizacaotvaloricmssubstituicao_c.AsCurrency := qryTotalizacaotvaloricmssubstituicao_c.AsCurrency+qryImprimirContratosValoricmssubstituicao.AsCurrency;
  qryTotalizacaoTVlrPresente_C.AsCurrency := qryTotalizacaoTVlrPresente_C.AsCurrency+qryImprimirContratosvalorvista.AsCurrency;
  qryTotalizacaoTEfinanc_C.AsCurrency := qryTotalizacaoTEfinanc_C.AsCurrency+qryImprimirContratosefinanceiro.AsCurrency;
  qryTotalizacaoTValorTotal_C.AsCurrency := qryTotalizacaoTValorTotal_C.AsCurrency+qryImprimirContratosvalortotal.AsCurrency;
  qryTotalizacaoTRecebido_C.AsCurrency := qryTotalizacaoTRecebido_C.AsCurrency+qryImprimirContratosavista.AsCurrency+qryImprimirContratosentradas.AsCurrency;
  qryTotalizacaoTAprazo_C.AsCurrency := qryTotalizacaoTAprazo_C.AsCurrency+qryImprimirContratosaprazo.AsCurrency;
  qryTotalizacaoTAvista_C.AsCurrency := qryTotalizacaoTAvista_C.AsCurrency+qryImprimirContratosavista.AsCurrency;
  qryTotalizacaoTEntradas_C.AsCurrency := qryTotalizacaoTEntradas_C.AsCurrency+qryImprimirContratosentradas.AsFloat;
