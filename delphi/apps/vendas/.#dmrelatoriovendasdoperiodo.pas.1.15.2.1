  case Pesquisa of
    rvCLIENTESINICIAL : RefazConsulta(qryClienteInicial,[0,1],[qryConsultaClientescodigo.AsVariant, qryConsultaClientestipo.AsVariant]);
    rvCLIENTESFINAL   : RefazConsulta(qryClienteFinal,[0,1],[qryConsultaClientescodigo.AsVariant, qryConsultaClientestipo.AsVariant]);
  end;
end;

function Tdtmrelatoriovendasdoperiodo.ExisteCliente(NomeCampo: String;
  Value: Variant): Boolean;
const
  SQL = 'Where (to_ascii(%s,''latin1'') ilike to_ascii(''%s%s'',''latin1''))';

begin

  qryConsultaClientes.Sql[24] := Format(SQL, [NomeCampo, ANSIUpperCase(Value), '%']);

  qryConsultaClientes.Open;

  Result := qryConsultaClientes.RecordCount > 0

end;

