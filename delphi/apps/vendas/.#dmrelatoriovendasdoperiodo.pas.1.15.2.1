  else if ParName = 'TEFINANC_V' then
   ParValue := CalcularTotal(qryTotalizacaoTEfinanc_V)
  else if ParName = 'TEFINANC_C' then
   ParValue := CalcularTotal(qryTotalizacaoTEfinanc_C)
  else if ParName = 'TVALORTOTAL_V' then
   ParValue := CalcularTotal(qryTotalizacaoTValorTotal_V)
