procedure Tdtmrelatoriovendasdoperiodo.frpImprimirVendasGetValue(
  const ParName: String; var ParValue: Variant);
begin
  inherited;
  if ANSIUpperCase(parname) = 'NOMEGRUPOFILIALVENDA' then
   ParValue := qryImprimirContratosnomegrupofilialvenda.AsString
  else if ANSIUpperCase(parname) = 'GRUPOFILIALVENDA' then
   ParValue := qryImprimirContratosgrupofilialvenda.AsString
  else if ANSIUpperCase(parname) = 'NOMEFILIALVENDA' then
   ParValue := qryImprimirContratosnomefilialvenda.AsString
  else if ANSIUpperCase(parname) = 'FILIALVENDA' then
   ParValue := qryImprimirContratosfilialvenda.AsString
  else if ANSIUpperCase(parname) = 'NOMECLIENTE' then
   ParValue := qryImprimirContratosnomecliente.AsString
  else if ANSIUpperCase(parname) = 'DATAVENDA' then
  begin
   if qryImprimirContratosdatavenda.AsString<>'' then
    if qryImprimirContratosdatavenda.AsDateTime<>strtodate('30/12/1899') then
      ParValue := formatdatetime('dd/mm/yy',qryImprimirContratosdatavenda.AsDateTime)
    else ParValue := ''
   else  ParValue := '';
  end
  else if ANSIUpperCase(ParName) = 'NCONTRATO' then
   ParValue := qryImprimirContratosncontrato.AsString
  else if ANSIUpperCase(ParName) = 'VENDAMERCADORIAS' then
  begin
   if (qryImprimirContratosvendamercadorias.AsFloat<>0) then
     ParValue := formatarvalor(qryImprimirContratosvendamercadorias.AsFloat,2)
   else  ParValue := '';
  end
  else if ANSIUpperCase(ParName) = 'VENDASERVICOS' then
  begin
   if (qryImprimirContratosvendaservicos.AsFloat<>0) then
    ParValue := formatarvalor(qryImprimirContratosvendaservicos.AsFloat,2)
   else ParValue :='';
  end
  else if ANSIUpperCase(ParName) = 'FRETE_SEGURO' then
  begin
   if (qryImprimirContratosfrete_seguro.AsFloat<>0) then
    ParValue := formatarvalor(qryImprimirContratosfrete_seguro.AsFloat,2)
   else ParValue := '';
  end
  else if ANSIUpperCase(ParName) = 'DESCONTO' then
  begin
   if (qryImprimirContratosdesconto.AsFloat<>0) then
    ParValue := formatarvalor(qryImprimirContratosdesconto.AsFloat,2)
   else ParValue := '';
  end
  else if ANSIUpperCase(ParName) = 'CABECALHODEBCREDOUICMS' then
  begin
   if ParSistema.utilizarcreditotrocacontrato then
     ParValue := 'Déb./Créd. do Cliente'
   else
     ParValue := 'ICMS Substituição';
  end
  else if ANSIUpperCase(ParName) = 'CREDITOOUDEBITO' then
  begin
   if ParSistema.utilizarcreditotrocacontrato then
   begin
     if (qryImprimirContratoscreditotroca.AsFloat<>0) then
