  end
  else if ANSIUpperCase(ParName) = 'EFINANCEIRO' then
  begin
   if (qryImprimirNotasCuponsefinanceiro.AsFloat<>0) then
    ParValue := formatarvalor(qryImprimirNotasCuponsefinanceiro.AsFloat,2)
   else ParValue := ''
  end
  else if ANSIUpperCase(ParName) = 'VALORTOTAL' then
  begin
   if (qryImprimirNotasCuponsvalortotal.AsFloat<>0) then
    ParValue := formatarvalor(qryImprimirNotasCuponsvalortotal.AsFloat,2)
