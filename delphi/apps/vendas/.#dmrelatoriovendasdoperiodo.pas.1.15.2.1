function Tdtmrelatoriovendasdoperiodo.CalcularTotal(Campo: TField): Currency;
var
 TRegistros_V, TRegistros_C : Integer;
 Valor,
 TMercadorias_V,Tservicos_V,TVlrPresente_V,TFrete_Seguro_V, TDesconto_V, TCreditoouDebito_V, TEfinanc_V,
 TValorTotal_V,TRecebido_V,TAprazo_V,TAvista_V,TEntradas_V,
 TMercadorias_C,Tservicos_C,TVlrPresente_C, TFrete_Seguro_C, TDesconto_C, TCreditoouDebito_C, TEfinanc_C,
 TValorTotal_C,TRecebido_C,TAprazo_C,TAvista_C,TEntradas_C,
 TValorICMSSubstituicao_V, TValorICMSSubstituicao_C : Currency;

 procedure Adicionar;
 begin
   Valor          := Valor + Campo.AsFloat;

   TRegistros_V   := TRegistros_V + qryTotalizacaoTRegistros_V.AsInteger;
   TMercadorias_V := TMercadorias_V + qryTotalizacaoTMercadorias_V.AsCurrency;
   Tservicos_V    := Tservicos_V + qryTotalizacaoTservicos_V.AsCurrency;
   TVlrPresente_V := TVlrPresente_V + qryTotalizacaoTVlrPresente_V.AsCurrency;
   TFrete_Seguro_V := TFrete_Seguro_V + qryTotalizacaotfrete_seguro_v.AsCurrency;
   TDesconto_V := TDesconto_V + qryTotalizacaotdesconto_v.AsCurrency;
   TCreditoouDebito_V := TCreditoouDebito_V + qryTotalizacaotcreditooudebito_v.AsCurrency;
   TValorICMSSubstituicao_V := TValorICMSSubstituicao_V + qryTotalizacaotvaloricmssubstituicao_v.AsCurrency;

   TEfinanc_V     := TEfinanc_V + qryTotalizacaoTEfinanc_V.AsCurrency;
   TValorTotal_V  := TValorTotal_V + qryTotalizacaoTValorTotal_V.AsCurrency;
   TRecebido_V    := TRecebido_V + qryTotalizacaoTRecebido_V.AsCurrency;
   TAprazo_V      := TAprazo_V + qryTotalizacaoTAprazo_V.AsCurrency;
   TAvista_V      := TAvista_V + qryTotalizacaoTAvista_V.AsCurrency;
   TEntradas_V    := TEntradas_V + qryTotalizacaoTEntradas_V.AsCurrency;

   TRegistros_C   := TRegistros_C + qryTotalizacaoTRegistros_C.AsInteger;
   TMercadorias_C := TMercadorias_C + qryTotalizacaoTMercadorias_C.AsCurrency;
   Tservicos_C    := Tservicos_C + qryTotalizacaoTservicos_C.AsCurrency;
   TVlrPresente_C := TVlrPresente_C + qryTotalizacaoTVlrPresente_C.AsCurrency;
   TFrete_Seguro_C := TFrete_Seguro_C + qryTotalizacaotfrete_seguro_C.AsCurrency;
