 qryImprimirContratos.Edit;
 qryImprimirContratostotalizado.AsBoolean := True;
 qryImprimirContratos.post;

 if not qryTotalizacao.Locate('GrupoFilial;Filial;Data;VendasDevolucoes;JaTotalizado',VarArrayof([FGrupoFilial,FFilial,FData,FVendasdevolucoes,'N']),[]) then
 begin
   qryTotalizacao.Append;
