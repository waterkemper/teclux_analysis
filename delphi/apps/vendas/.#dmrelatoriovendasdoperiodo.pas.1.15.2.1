procedure Tdtmrelatoriovendasdoperiodo.qryImprimirNotasCuponsAfterScroll(
  DataSet: TDataSet);
begin
  inherited;
  if FImprimindoRelatorio and not qryImprimirNotasCupons.Eof then
  begin
   VerificarAgrupamentoNotas;
   if not qryImprimirNotasCuponstotalizado.AsBoolean then
     TotalizarRelatorioNotas;
  end;
end;

procedure Tdtmrelatoriovendasdoperiodo.VerificarAgrupamentoNotas;
begin
  FGrupoFilial := 0;
  FFilial := 0;
  FData := '';
  FVendasDevolucoes := '';
  if AgruparGrupoFilial then
    FGrupoFilial := qryImprimirNotasCuponsgrupofilialvenda.AsInteger;
  if AgruparFilial then
    FFilial := qryImprimirNotasCuponsfilialvenda.AsInteger;
  if AgruparDataVenda then
    FData := qryImprimirNotasCuponsdatavenda.AsString;
  if ExibirTotaisVendaseDevolucoes then
  begin
    if SepararVendas and SepararDevolucoes then
      FVendasDevolucoes := qryImprimirNotasCuponstipo.AsString + qryImprimirNotasCuponscontratoavista.AsString
    else
    if SepararVendas then
      FVendasDevolucoes := qryImprimirNotasCuponscontratoavista.AsString
    else
    if SepararDevolucoes then
      FVendasDevolucoes := qryImprimirNotasCuponstipo.AsString;
  end;
end;

procedure Tdtmrelatoriovendasdoperiodo.TotalizarRelatorioNotas;
begin

 qryImprimirNotasCupons.Edit;
 qryImprimirNotasCuponstotalizado.AsBoolean := True;
 qryImprimirNotasCupons.post;

 if not qryTotalizacaoNotas.Locate('GrupoFilial;Filial;Data;VendasDevolucoes;JaTotalizado',VarArrayof([FGrupoFilial,FFilial,FData,FVendasdevolucoes,'N']),[]) then
 begin
    qryTotalizacaoNotas.Append;
    qryTotalizacaoNotas.Post;
 end;

 if qryImprimirNotasCuponstipo.AsString='Vendas' then
 begin
  qryTotalizacaoNotas.Edit;
  qryTotalizacaoNotasgrupofilial.AsInteger := FGrupoFilial;
  qryTotalizacaoNotasfilial.AsInteger := FFilial;
  qryTotalizacaoNotasdata.Asstring := FData;
  qryTotalizacaoNotasvendasdevolucoes.AsString := FVendasDevolucoes;

  qryTotalizacaoNotasTRegistros_V.AsInteger         := qryTotalizacaoNotastregistros_v.AsInteger+qryImprimirNotasCuponstregistros.AsInteger;
  qryTotalizacaoNotastvendamercadorias_v.AsCurrency := qryTotalizacaoNotastvendamercadorias_v.AsCurrency+qryImprimirNotasCuponsvendamercadorias.AsCurrency;
  qryTotalizacaoNotastdesconto_v.AsCurrency         := qryTotalizacaoNotastdesconto_v.AsCurrency+qryImprimirNotasCuponsdesconto.AsCurrency;
  qryTotalizacaoNotastvendaservicos_v.AsCurrency    := qryTotalizacaoNotastvendaservicos_v.AsCurrency+qryImprimirNotasCuponsvendaservicos.AsCurrency;
  qryTotalizacaoNotastvalorvista_v.AsCurrency       := qryTotalizacaoNotastvalorvista_v.AsCurrency+qryImprimirNotasCuponsvalorvista.AsCurrency;
  qryTotalizacaoNotastoutras_v.AsCurrency           := qryTotalizacaoNotastoutras_v.AsCurrency+qryImprimirNotasCuponsoutras.AsCurrency;
  qryTotalizacaoNotastefinanceiro_v.AsCurrency      := qryTotalizacaoNotastefinanceiro_v.AsCurrency+qryImprimirNotasCuponsefinanceiro.AsCurrency;
  qryTotalizacaoNotastvalortotal_v.AsCurrency       := qryTotalizacaoNotastvalortotal_v.AsCurrency+qryImprimirNotasCuponsvalortotal.AsCurrency;
  qryTotalizacaoNotastvaloricmssubstituicao_v.AsCurrency := qryTotalizacaoNotastvaloricmssubstituicao_v.AsCurrency+qryImprimirNotasCuponsvaloricmssubstituicao.AsCurrency;

  qryTotalizacaoNotasjatotalizado.AsString := 'N';
  qrytotalizacaonotas.Post;

 end
 else
 begin
  qryTotalizacaoNotas.Edit;
  qryTotalizacaoNotasgrupofilial.AsInteger := FGrupoFilial;
  qryTotalizacaoNotasfilial.AsInteger := FFilial;
  qryTotalizacaoNotasdata.Asstring := FData;
  qryTotalizacaoNotasvendasdevolucoes.AsString := FVendasDevolucoes;

  qryTotalizacaoNotasTRegistros_C.AsInteger         := qryTotalizacaoNotastregistros_C.AsInteger-qryImprimirNotasCuponstregistros.AsInteger;
  qryTotalizacaoNotastvendamercadorias_C.AsCurrency := qryTotalizacaoNotastvendamercadorias_C.AsCurrency+qryImprimirNotasCuponsvendamercadorias.AsCurrency;
  qryTotalizacaoNotastdesconto_C.AsCurrency         := qryTotalizacaoNotastdesconto_C.AsCurrency+qryImprimirNotasCuponsdesconto.AsCurrency;
  qryTotalizacaoNotastvendaservicos_C.AsCurrency    := qryTotalizacaoNotastvendaservicos_C.AsCurrency+qryImprimirNotasCuponsvendaservicos.AsCurrency;
  qryTotalizacaoNotastvalorvista_C.AsCurrency       := qryTotalizacaoNotastvalorvista_C.AsCurrency+qryImprimirNotasCuponsvalorvista.AsCurrency;
  qryTotalizacaoNotastoutras_C.AsCurrency           := qryTotalizacaoNotastoutras_C.AsCurrency+qryImprimirNotasCuponsoutras.AsCurrency;
  qryTotalizacaoNotastefinanceiro_C.AsCurrency      := qryTotalizacaoNotastefinanceiro_C.AsCurrency+qryImprimirNotasCuponsefinanceiro.AsCurrency;
  qryTotalizacaoNotastvalortotal_C.AsCurrency       := qryTotalizacaoNotastvalortotal_C.AsCurrency+qryImprimirNotasCuponsvalortotal.AsCurrency;
  qryTotalizacaoNotastvaloricmssubstituicao_c.AsCurrency := qryTotalizacaoNotastvaloricmssubstituicao_c.AsCurrency+qryImprimirNotasCuponsvaloricmssubstituicao.AsCurrency;

  qryTotalizacaoNotasjatotalizado.AsString := 'N';
  qrytotalizacaonotas.Post;

 end;
end;

function Tdtmrelatoriovendasdoperiodo.CalcularTotalNotas(
  Campo: TField): Currency;
var
 TRegistros_V, TRegistros_C : Integer;
 Valor,
 TVendaMercadorias_V, TDesconto_V, TVendaservicos_V,TValorVista_V,TEfinanceiro_V,
 TValorTotal_V,TOutras_V,
 TVendaMercadorias_C, TDesconto_C, TVendaservicos_C,TValorVista_C,TEfinanceiro_C,
 TValorTotal_C,TOutras_C,
 TValorICMSSubstituicao_V,TValorICMSSubstituicao_C : Currency;

 procedure Adicionar;
 begin
   Valor               := Valor + Campo.AsFloat;

   TRegistros_V        := TRegistros_V + qryTotalizacaoNotasTRegistros_V.AsInteger;
   TVendaMercadorias_V := TVendaMercadorias_V + qryTotalizacaoNotastvendamercadorias_v.AsCurrency;
   TDesconto_V         := TDesconto_V + qryTotalizacaoNotastdesconto_v.AsCurrency;
   TVendaservicos_V    := TVendaservicos_V + qryTotalizacaoNotastvendaservicos_v.AsCurrency;
   TValorVista_V       := TValorVista_V + qryTotalizacaoNotastvalorvista_v.AsCurrency;
   TEfinanceiro_V      := TEfinanceiro_V + qryTotalizacaoNotastefinanceiro_v.AsCurrency;
   TValorTotal_V       := TValorTotal_V + qryTotalizacaoNotasTValorTotal_V.AsCurrency;
   TValorICMSSubstituicao_V := TValorICMSSubstituicao_V + qryTotalizacaoNotastvaloricmssubstituicao_v.AsCurrency;
   TOutras_V           := TOutras_V + qryTotalizacaoNotastoutras_v.AsCurrency;

   TRegistros_C        := TRegistros_C + qryTotalizacaoNotasTRegistros_C.AsInteger;
   TVendaMercadorias_C := TVendaMercadorias_C + qryTotalizacaoNotastvendamercadorias_C.AsCurrency;
   TDesconto_C         := TDesconto_C + qryTotalizacaoNotastdesconto_c.AsCurrency;
   TVendaservicos_C    := TVendaservicos_C + qryTotalizacaoNotastvendaservicos_C.AsCurrency;
   TValorVista_C       := TValorVista_C + qryTotalizacaoNotastvalorvista_C.AsCurrency;
   TEfinanceiro_C      := TEfinanceiro_C + qryTotalizacaoNotastefinanceiro_C.AsCurrency;
   TValorTotal_C       := TValorTotal_C + qryTotalizacaoNotasTValorTotal_C.AsCurrency;
   TValorICMSSubstituicao_C := TValorICMSSubstituicao_C + qryTotalizacaoNotastvaloricmssubstituicao_c.AsCurrency;
   TOutras_C           := TOutras_C + qryTotalizacaoNotastoutras_C.AsCurrency;

 end;

 procedure AdicionarJaTotalizado(VGrupoFilial, VFilial: integer; VData: String);
 begin
  qryTotalizacaonotas.Append;
  qryTotalizacaoNotasgrupofilial.AsInteger := VGrupoFilial;
  qryTotalizacaoNotasfilial.AsInteger := VFilial;
  qryTotalizacaoNotasdata.AsString := VData;

  qryTotalizacaoNotasTRegistros_V.AsInteger := TRegistros_V;
  qryTotalizacaoNotastvendamercadorias_v.AsCurrency := TVendaMercadorias_V;
  qryTotalizacaoNotastdesconto_v.AsCurrency := TDesconto_V;
  qryTotalizacaoNotastvendaservicos_v.AsCurrency := TVendaservicos_V;
  qryTotalizacaoNotastvalorvista_v.AsCurrency := TValorVista_V;
  qryTotalizacaoNotastefinanceiro_v.AsCurrency := TEfinanceiro_V;
  qryTotalizacaoNotastvalortotal_v.AsCurrency := TValorTotal_V;
  qryTotalizacaoNotastvaloricmssubstituicao_v.AsCurrency := TValorICMSSubstituicao_V;
  qryTotalizacaoNotastoutras_v.AsCurrency := TOutras_V;

  qryTotalizacaoNotasTRegistros_C.AsInteger := TRegistros_C;
  qryTotalizacaoNotastvendamercadorias_C.AsCurrency := TVendaMercadorias_C;
  qryTotalizacaoNotastdesconto_c.AsCurrency := TDesconto_C;
  qryTotalizacaoNotastvendaservicos_C.AsCurrency := TVendaservicos_C;
  qryTotalizacaoNotastvalorvista_C.AsCurrency := TValorVista_C;
  qryTotalizacaoNotastefinanceiro_C.AsCurrency := TEfinanceiro_C;
  qryTotalizacaoNotastvalortotal_C.AsCurrency := TValorTotal_C;
  qryTotalizacaoNotastvaloricmssubstituicao_c.AsCurrency := TValorICMSSubstituicao_C;
  qryTotalizacaoNotastoutras_C.AsCurrency := TOutras_C;

  qryTotalizacaoNotasjatotalizado.AsString := 'S';

  qryTotalizacaoNotas.Post;
 end;


begin

 Valor               := 0;
 TRegistros_V        := 0;
 TVendaMercadorias_V := 0;
 TDesconto_V         := 0;
 TVendaservicos_V    := 0;
 TValorVista_V       := 0;
 TEfinanceiro_V      := 0;
 TValorTotal_V       := 0;
 TOutras_V           := 0;
 TRegistros_C        := 0;
 TVendaMercadorias_C := 0;
 TDesconto_C         := 0;
 TVendaservicos_C    := 0;
 TValorVista_C       := 0;
 TEfinanceiro_C      := 0;
 TValorTotal_C       := 0;
 TOutras_C           := 0;

 if (BandaImpressa = 'RodapeVendasDevolucoes') and FExibirTotaisVendaseDevolucoes then
 begin
  if qryTotalizacaoNotas.Locate('GrupoFilial;Filial;Data;VendasDevolucoes',VarArrayof([FGrupoFilial,FFilial,FData,FVendasDevolucoes]),[]) then
    Valor := Campo.AsFloat;
 end

 else

 if (BandaImpressa = 'RodapeDataVenda') and FAgruparDataVenda then
 begin
  if qryTotalizacaoNotas.Locate('GrupoFilial;Filial;Data;JaTotalizado',VarArrayof([FGrupoFilial,FFilial,FData,'S']),[]) then
   Valor := valor + Campo.AsFloat
  else
  begin
   if qryTotalizacaoNotas.Locate('GrupoFilial;Filial;Data;JaTotalizado',VarArrayof([FGrupoFilial,FFilial,FData,'N']),[]) then
   begin
    while not qryTotalizacaoNotas.Eof do
    begin
     if (qryTotalizacaoNotasgrupofilial.AsInteger = FGrupoFilial) and
          (qryTotalizacaoNotasfilial.AsInteger = FFilial) and
          (qryTotalizacaoNotasdata.AsString = fdata) and
          (qryTotalizacaoNotasjatotalizado.AsString='N')then
      Adicionar;
     qryTotalizacaoNotas.Next;
    end;
    AdicionarJaTotalizado(FGrupoFilial, FFilial, FData);
   end;
  end;
 end

 else

 if (BandaImpressa = 'RodapeFilial') and FAgruparFilial then
 begin
  if qryTotalizacaoNotas.Locate('GrupoFilial;Filial;Data;JaTotalizado',VarArrayof([FGrupoFilial,FFilial,'','S']),[]) then
   Valor := Valor + Campo.AsFloat
  else
  begin
   if qryTotalizacaoNotas.Locate('GrupoFilial;Filial;JaTotalizado',VarArrayof([FGrupoFilial,FFilial, 'N']),[]) then
   begin
    while not qryTotalizacaoNotas.Eof do
    begin
     if (qryTotalizacaoNotasgrupofilial.AsInteger = FGrupoFilial) and
          (qryTotalizacaoNotasfilial.AsInteger = FFilial) and
          (qryTotalizacaoNotasjatotalizado.AsString='N')then
      Adicionar;
     qryTotalizacaoNotas.Next;
    end;
    AdicionarJaTotalizado(FGrupoFilial, FFilial, '');
   end;
  end;
 end

 else

 if (BandaImpressa = 'RodapeGrupoFilial') and FAgruparGrupoFilial then
 begin
  if qryTotalizacaoNotas.Locate('GrupoFilial;Filial;Data;JaTotalizado',VarArrayof([FGrupoFilial,0,'','S']),[]) then
   Valor := Valor + Campo.AsFloat
  else
   if qryTotalizacaoNotas.Locate('GrupoFilial,JaTotalizado',VarArrayof([FGrupoFilial,'N']),[]) then
   begin
    while not qryTotalizacaoNotas.Eof do
    begin
     if (qryTotalizacaoNotasgrupofilial.AsInteger = FGrupoFilial) and
        (qryTotalizacaoNotasjatotalizado.AsString='N') then
      Adicionar;
     qryTotalizacaoNotas.Next;
    end;
    AdicionarJaTotalizado(FGrupoFilial,0,'');
   end;
 end

 else

 if BandaImpressa = 'SumarioTotal' then
 begin
  if qryTotalizacaoNotas.Locate('GrupoFilial;Filial;Data;JaTotalizado',VarArrayof([0,0,'','S']),[]) then
   Valor := Valor + Campo.AsFloat
  else
    begin
      qryTotalizacaoNotas.First;
      while not qryTotalizacaoNotas.Eof do
      begin
       if(qryTotalizacaoNotasjatotalizado.AsString='N') then
         Adicionar;
       qryTotalizacaoNotas.Next;
      end;
      AdicionarJaTotalizado(0,0,'');
    end;
 end;

 result := valor;

end;

procedure Tdtmrelatoriovendasdoperiodo.SetDevolucoesPeriodoAnterior(
  const Value: Boolean);
const
 SQLDevolucoesPeriodoAnterior = 'and ct.faturamento < :DataInicial';
 SQLDevolucoesPeriodoSelecionado = 'and ct.faturamento between (:DataInicial) and (:DataFinal)';
begin
  FDevolucoesPeriodoAnterior := Value;
  if FDevolucoesPeriodoAnterior and FDevolucoesPeriodoSelecionado then
  begin
    case FOpcaoRelatorio of
    0: qryGravarContratos.MacroByName('WhereDevolucoes').AsString := '';
    1: qryImprimirNotasCupons.MacroByName('WhereDevolucoes').AsString := '';
    end;
  end
  else
   if FDevolucoesPeriodoAnterior then
   begin
    case FOpcaoRelatorio of
    0: qryGravarContratos.MacroByName('WhereDevolucoes').AsString := SQLDevolucoesPeriodoAnterior;
    1: qryImprimirNotasCupons.MacroByName('WhereDevolucoes').AsString := SQLDevolucoesPeriodoAnterior;
    end;
   end
   else
   if FDevolucoesPeriodoSelecionado then
   begin
    case FOpcaoRelatorio of
    0: qryGravarContratos.MacroByName('WhereDevolucoes').AsString := SQLDevolucoesPeriodoSelecionado;
    1: qryImprimirNotasCupons.MacroByName('WhereDevolucoes').AsString := SQLDevolucoesPeriodoSelecionado;
    end;
   end;
end;

procedure Tdtmrelatoriovendasdoperiodo.qryImprimirContratosCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  if ExibirTotaisVendaseDevolucoes then
   if SepararDevolucoes and SepararVendas then
   begin
     if (qryImprimirContratostipo.asstring='C') then
      qryImprimirContratosNVendaDevolucao.AsString := 'Devoluções - '
     else
      qryImprimirContratosNVendaDevolucao.AsString := 'Vendas - ';

     if qryImprimirContratoscontratoavista.asboolean then
       qryImprimirContratosNVendaDevolucao.AsString :=
        qryImprimirContratosNVendaDevolucao.AsString + 'a Vista'
     else
       qryImprimirContratosNVendaDevolucao.AsString :=
        qryImprimirContratosNVendaDevolucao.AsString + 'a Prazo';
   end
   else
   if SepararDevolucoes then
   begin
     if (qryImprimirContratostipo.asstring='C') then
      qryImprimirContratosNVendaDevolucao.AsString := 'Devoluções'
     else
      qryImprimirContratosNVendaDevolucao.AsString := 'Vendas';
   end
   else
   if SepararVendas then
   begin
     if qryImprimirContratoscontratoavista.asboolean then
       qryImprimirContratosNVendaDevolucao.AsString :='a Vista'
     else
       qryImprimirContratosNVendaDevolucao.AsString :='a Prazo';
   end;
end;

procedure Tdtmrelatoriovendasdoperiodo.frpImprimirNotasCuponsBeforePrint(
  Memo: TStringList; View: TfrView);
begin
  inherited;
  if (View.Name = 'fpvLogo') then
  begin
   if FileExists(LogotipoFilialBase) then
    try TfrPictureView(View).Picture.LoadFromFile(LogotipoFilialBase) except end;
  end
  else
  if TColor(strtoint(parsistema.CorZebradoRelatorio))<>TColor(clnone) then
   if (View.Name = 'mmoZebrado') then
    if (frpImprimirNotasCupons.Dictionary.Variables.Variable['LINHA'] MOD 2)=0 then
      frpImprimirNotasCupons.FindObject('mmoZebrado').FillColor := TColor(strtoint(parsistema.CorZebradoRelatorio))
    else
      frpImprimirNotasCupons.FindObject('mmoZebrado').FillColor := clnone;


end;

procedure Tdtmrelatoriovendasdoperiodo.ZMonitor2MonitorEvent(Sql,
  Result: String);
var
 Listar : TStringList;
begin
  inherited;
  Listar := tStringlist.create;
  if fileexists('c:\log.sql') then
    Listar.loadfromfile('c:\log.sql');
  Listar.add('');
  Listar.add(sql);
  Listar.add(result);
  listar.savetofile('c:\log.sql');
  listar.free;
end;

procedure Tdtmrelatoriovendasdoperiodo.SetListadeRegioes(
  const Value: String);
begin

  fListadeRegioes := Value;
  if (Value <> '') then
  begin
   FParametroCabecalho:=FParametroCabecalho+' Regioes: '+Value;
   case FOpcaoRelatorio of

   0: begin
        qryGravarContratos.MacroByName('WhereRegioes_ct').AsString :=
        'and (((SELECT regiao FROM bairros WHERE (estado,cidade,codigo)=(ct.estado,ct.cidade,ct.bairro)) in ('+ListadeRegioes+')) or '+
            '((SELECT regiao FROM cidades WHERE (estado,codigo)=(ct.estado,ct.cidade)) in ('+ListadeRegioes+')))';


        qryGravarContratos.MacroByName('WhereRegioes_df').AsString :=
          'and (((SELECT regiao FROM bairros WHERE (estado,cidade,codigo)=(df.estado,df.cidade,df.bairro)) in ('+ListadeRegioes+')) or '+
               '((SELECT regiao FROM cidades WHERE (estado,codigo)=(df.estado,df.cidade)) in ('+ListadeRegioes+')))';


        if FDevolucoesPeriodoAnterior or FDevolucoesPeriodoSelecionado then
          qryGravarContratos.MacroByName('WhereRegioes_np').AsString :=
          'and (((SELECT regiao FROM bairros WHERE (estado,cidade,codigo)=(np.estado,np.cidade,np.bairro)) in ('+ListadeRegioes+')) or '+
              '((SELECT regiao FROM cidades WHERE (estado,codigo)=(np.estado,np.cidade)) in ('+ListadeRegioes+')))';

      end;


   1: begin

        if FDevolucoesPeriodoAnterior or FDevolucoesPeriodoSelecionado then
          qryImprimirNotasCupons.MacroByName('WhereRegioes_ct').AsString :=
            'and (((SELECT regiao FROM bairros WHERE (estado,cidade,codigo)=(ct.estado,ct.cidade,ct.bairro)) in ('+ListadeRegioes+')) or '+
                 '((SELECT regiao FROM cidades WHERE (estado,codigo)=(ct.estado,ct.cidade)) in ('+ListadeRegioes+')))';

        qryImprimirNotasCupons.MacroByName('WhereRegioes_df').AsString :=
          'and (((SELECT regiao FROM bairros WHERE (estado,cidade,codigo)=(df.estado,df.cidade,df.bairro)) in ('+ListadeRegioes+')) or '+
               '((SELECT regiao FROM cidades WHERE (estado,codigo)=(df.estado,df.cidade)) in ('+ListadeRegioes+')))';


      end;
   end;
  end
  else
  begin
   case FOpcaoRelatorio of
   0: begin
       qryGravarContratos.MacroByName('WhereRegioes_ct').AsString := '';
       qryGravarContratos.MacroByName('WhereRegioes_df').AsString := '';
       qryGravarContratos.MacroByName('WhereRegioes_np').AsString := '';
      end;
   1: begin
        if FDevolucoesPeriodoAnterior or FDevolucoesPeriodoSelecionado then
          qryImprimirNotasCupons.MacroByName('WhereRegioes_ct').AsString := '';

        qryImprimirNotasCupons.MacroByName('WhereRegioes_df').AsString := '';
      end;
   end;
  end;

end;

