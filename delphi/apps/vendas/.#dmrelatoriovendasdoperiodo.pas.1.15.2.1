  else if ANSIUpperCase(ParName) = 'TREGISTROS_V' then
   ParValue := CalcularTotal(qryTotalizacaoTRegistros_V)
  else if ANSIUpperCase(ParName) = 'TREGISTROS_C' then
   ParValue := CalcularTotal(qryTotalizacaoTRegistros_C)
  else if ANSIUpperCase(ParName) = 'TMERCADORIAS_V' then
