 procedure AdicionarJaTotalizado(VGrupoFilial, VFilial: integer; VData: String);
 begin
  qryTotalizacao.Append;
  qryTotalizacaogrupofilial.AsInteger := VGrupoFilial;
  qryTotalizacaofilial.AsInteger := VFilial;
  qryTotalizacaodata.AsString := Vdata;

  qryTotalizacaoTRegistros_V.AsInteger := TRegistros_V;
  qryTotalizacaoTMercadorias_V.AsCurrency := TMercadorias_V;
  qryTotalizacaoTservicos_V.AsCurrency := Tservicos_V;
  qryTotalizacaoTVlrPresente_V.AsCurrency := TVlrPresente_V;
  qryTotalizacaotfrete_seguro_v.AsCurrency := TFrete_Seguro_V;
  qryTotalizacaotdesconto_v.AsCurrency := TDesconto_V;
  qryTotalizacaotcreditooudebito_v.AsCurrency := TCreditoouDebito_V;
  qryTotalizacaotvaloricmssubstituicao_v.AsCurrency := TValorICMSSubstituicao_V;

  qryTotalizacaoTEfinanc_V.AsCurrency := TEfinanc_V;
  qryTotalizacaoTValorTotal_V.AsCurrency := TValorTotal_V;
  qryTotalizacaoTRecebido_V.AsCurrency := TRecebido_V;
  qryTotalizacaoTAprazo_V.AsCurrency := TAprazo_V;
  qryTotalizacaoTAvista_V.AsCurrency := TAvista_V;
  qryTotalizacaoTEntradas_V.AsCurrency := TEntradas_V;

  qryTotalizacaoTRegistros_C.AsInteger := TRegistros_C;
  qryTotalizacaoTMercadorias_C.AsCurrency := TMercadorias_C;
  qryTotalizacaoTservicos_C.AsCurrency := Tservicos_C;
  qryTotalizacaoTVlrPresente_C.AsCurrency := TVlrPresente_C;
  qryTotalizacaotfrete_seguro_c.AsCurrency := TFrete_Seguro_C;
  qryTotalizacaotdesconto_c.AsCurrency := TDesconto_C;
  qryTotalizacaotcreditooudebito_c.AsCurrency := TCreditoouDebito_C;
  qryTotalizacaotvaloricmssubstituicao_c.AsCurrency := TValorICMSSubstituicao_C;

  qryTotalizacaoTEfinanc_C.AsCurrency := TEfinanc_C;
  qryTotalizacaoTValorTotal_C.AsCurrency := TValorTotal_C;
  qryTotalizacaoTRecebido_C.AsCurrency := TRecebido_C;
  qryTotalizacaoTAprazo_C.AsCurrency := TAprazo_C;
  qryTotalizacaoTAvista_C.AsCurrency := TAvista_C;
  qryTotalizacaoTEntradas_C.AsCurrency := TEntradas_C;

  qryTotalizacaojatotalizado.AsString := 'S';

  qrytotalizacao.Post;
 end;


begin

 Valor          := 0;
 TRegistros_V   := 0;
 TMercadorias_V := 0;
 Tservicos_V    := 0;
 TVlrPresente_V := 0;
 TEfinanc_V     := 0;
 TValorTotal_V  := 0;
 TRecebido_V    := 0;
 TAprazo_V      := 0;
 TAvista_V      := 0;
 TEntradas_V    := 0;

 TRegistros_C   := 0;
 TMercadorias_C := 0;
 Tservicos_C    := 0;
 TVlrPresente_C := 0;
 TEfinanc_C     := 0;
 TValorTotal_C  := 0;
 TRecebido_C    := 0;
 TAprazo_C      := 0;
 TAvista_C      := 0;
 TEntradas_C    := 0;

 if (BandaImpressa = 'RodapeVendasDevolucoes') and FExibirTotaisVendaseDevolucoes then
 begin
 {
  if FAgruparDataVenda then
  begin
   if qryTotalizacao.Locate('GrupoFilial;Filial;Data;VendasDevolucoes',VarArrayof([FGrupoFilial,FFilial,FData,FVendasDevolucoes]),[]) then
     Valor := Campo.AsFloat;
  end
  else
  if qryTotalizacao.Locate('GrupoFilial;Filial;VendasDevolucoes',VarArrayof([FGrupoFilial,FFilial,FVendasDevolucoes]),[]) then
    Valor := Campo.AsFloat;
    }
   if qryTotalizacao.Locate('GrupoFilial;Filial;Data;VendasDevolucoes',VarArrayof([FGrupoFilial,FFilial,FData,FVendasDevolucoes]),[]) then
     Valor := Campo.AsFloat;
 end

 else

 if (BandaImpressa = 'RodapeDataVenda') and FAgruparDataVenda then
 begin
  if qryTotalizacao.Locate('GrupoFilial;Filial;Data;JaTotalizado',VarArrayof([FGrupoFilial,FFilial,FData,'S']),[]) then
   Valor := valor + Campo.AsFloat
  else
  begin
   if qryTotalizacao.Locate('GrupoFilial;Filial;Data;JaTotalizado',VarArrayof([FGrupoFilial,FFilial,FData,'N']),[]) then
   begin
    while not qryTotalizacao.Eof do
    begin
     if (qryTotalizacaogrupofilial.AsInteger = FGrupoFilial) and
          (qryTotalizacaofilial.AsInteger = FFilial) and
          (qryTotalizacaodata.AsString = fdata) and
          (qryTotalizacaojatotalizado.AsString='N')then
      Adicionar;
     qryTotalizacao.Next;
    end;
    AdicionarJaTotalizado(FGrupoFilial, FFilial, FData);
   end;
  end;
 end


 else

 if (BandaImpressa = 'RodapeFilial') and FAgruparFilial then
 begin
  if qryTotalizacao.Locate('GrupoFilial;Filial;Data;JaTotalizado',VarArrayof([FGrupoFilial,FFilial,'','S']),[]) then
   Valor := Valor + Campo.AsFloat
  else
  begin
   if qryTotalizacao.Locate('GrupoFilial;Filial;JaTotalizado',VarArrayof([FGrupoFilial,FFilial, 'N']),[]) then
   begin
    while not qryTotalizacao.Eof do
    begin
     if (qryTotalizacaogrupofilial.AsInteger = FGrupoFilial) and
          (qryTotalizacaofilial.AsInteger = FFilial) and
          (qryTotalizacaojatotalizado.AsString='N')then
      Adicionar;
     qryTotalizacao.Next;
    end;
    AdicionarJaTotalizado(FGrupoFilial, FFilial,'');
   end;
  end;
 end

 else

 if (BandaImpressa = 'RodapeGrupoFilial') and FAgruparGrupoFilial then
 begin
  if qryTotalizacao.Locate('GrupoFilial;Filial;Data;JaTotalizado',VarArrayof([FGrupoFilial,0,'','S']),[]) then
   Valor := Valor + Campo.AsFloat
  else
   if qryTotalizacao.Locate('GrupoFilial,JaTotalizado',VarArrayof([FGrupoFilial,'N']),[]) then
   begin
    while not qryTotalizacao.Eof do
    begin
     if (qryTotalizacaogrupofilial.AsInteger = FGrupoFilial) and
        (qryTotalizacaojatotalizado.AsString='N') then
      Adicionar;
     qryTotalizacao.Next;
    end;
    AdicionarJaTotalizado(FGrupoFilial,0,'');
   end;
 end

 else

 if BandaImpressa = 'SumarioTotal' then
 begin
  if qryTotalizacao.Locate('GrupoFilial;Filial;Data;JaTotalizado',VarArrayof([0,0,'','S']),[]) then
   Valor := Valor + Campo.AsFloat
  else
   begin
      qryTotalizacao.First;
      while not qryTotalizacao.Eof do
      begin
       if (qryTotalizacaojatotalizado.AsString='N') then
        Adicionar;
       qryTotalizacao.Next;
      end;
      AdicionarJaTotalizado(0,0,'');
   end;
 end;

 result := valor;

end;

procedure Tdtmrelatoriovendasdoperiodo.VerificarAgrupamentoContratos;
begin
  FGrupoFilial := 0;
  FFilial := 0;
  FData := '';
  FVendasDevolucoes := '';
  if AgruparGrupoFilial then
    FGrupoFilial := qryImprimirContratosgrupofilialvenda.AsInteger;
  if AgruparFilial then
    FFilial := qryImprimirContratosfilialvenda.AsInteger;
  if AgruparDataVenda then
    FData := qryImprimirContratosdatavenda.AsString;
  if ExibirTotaisVendaseDevolucoes then
  begin
    if SepararVendas and SepararDevolucoes then
      FVendasDevolucoes := qryImprimirContratostipo.AsString + qryImprimirContratoscontratoavista.AsString
    else
    if SepararVendas then
      FVendasDevolucoes := qryImprimirContratoscontratoavista.AsString
    else
    if SepararDevolucoes then
      FVendasDevolucoes := qryImprimirContratostipo.AsString;
  end;
end;

procedure Tdtmrelatoriovendasdoperiodo.frpImprimirNotasCuponsGetValue(
  const ParName: String; var ParValue: Variant);
begin
  inherited;
  if ANSIUpperCase(parname) = 'NOMEGRUPOFILIALVENDA' then
   ParValue := qryImprimirNotasCuponsnomegrupofilialvenda.AsString
  else if ANSIUpperCase(parname) = 'GRUPOFILIALVENDA' then
   ParValue := qryImprimirNotasCuponsgrupofilialvenda.AsString
  else if ANSIUpperCase(parname) = 'NOMEFILIALVENDA' then
   ParValue := qryImprimirNotasCuponsnomefilialvenda.AsString
  else if ANSIUpperCase(parname) = 'FILIALVENDA' then
   ParValue := qryImprimirNotasCuponsfilialvenda.AsString
  else if ANSIUpperCase(parname) = 'NOMECLIENTE' then
   ParValue := qryImprimirNotasCuponsnomecliente.AsString
  else if ANSIUpperCase(parname) = 'TIPOCLIENTE' then
   if qryImprimirNotasCuponstipocliente.AsString='F' then
    ParValue := qryImprimirNotasCuponstipocliente.AsString
   else ParValue := ''
  else if ANSIUpperCase(parname) = 'DATAVENDA' then
  begin
   if qryImprimirNotasCuponsdatavenda.AsString<>'' then
    if (qryImprimirNotasCuponsdatavenda.AsDateTime<>strtodate('30/12/1899')) then
      ParValue := formatdatetime('dd/mm/yy',qryImprimirNotasCuponsdatavenda.AsDateTime)
    else
      ParValue := ''
   else
   ParValue := '';
  end
  else if ANSIUpperCase(ParName) = 'NCONTRATO' then
   ParValue := qryImprimirNotasCuponsncontrato.AsString
  else if ANSIUpperCase(ParName) = 'VENDAMERCADORIAS' then
  begin
   if (qryImprimirNotasCuponsvendamercadorias.AsFloat<>0) then
     ParValue := formatarvalor(qryImprimirNotasCuponsvendamercadorias.AsFloat,2)
   else  ParValue := '';
