procedure Tdtmrelatoriovendasdoperiodo.SetVendaaPrazo(
  const Value: Boolean);
const
 VendaaVista =' where contratoavista ';
 VendaaPrazo =' Where not contratoavista ';
{
 VendaaVistaNotas = ' and not exists (select p.numero from parcelas p where '+
                    'p.contrato = ct.numero and '+

                    'p.datavencto > ct.faturamento)';

 VendaaPrazoNotas = ' and exists (select p.numero from parcelas p where '+

                    'p.contrato = ct.numero and '+

                    'p.datavencto > ct.faturamento)';

                    }

begin
  FVendaaPrazo := Value;
if (FVendaaVista and FVendaaPrazo) or
   (not FVendaaVista and not FVendaaPrazo) then
begin
  case FOpcaoRelatorio of
  0: qryGravarContratos    .MacroByName('whereTipodeVenda').AsString := '';
  1: qryImprimirNotasCupons.MacroByName('whereTipodeVenda').AsString  := '';
  end;
end
else
 if FVendaaVista then
 begin
  case FOpcaoRelatorio of
   0: qryGravarContratos    .MacroByName('whereTipodeVenda').AsString := VendaaVista;
   1: qryImprimirNotasCupons.MacroByName('whereTipodeVenda').AsString  := VendaaVista;
  end;
  FParametroCabecalho:=FParametroCabecalho+' Tipo de Venda: a vista';
 end
 else
  if FVendaaPrazo then
  begin
   case FOpcaoRelatorio of
   0: qryGravarContratos    .MacroByName('whereTipodeVenda').AsString := VendaaPrazo;
   1: qryImprimirNotasCupons.MacroByName('whereTipodeVenda').AsString  := VendaaPrazo;
   end;
   FParametroCabecalho:=FParametroCabecalho+' Tipo de Venda: a Prazo';
  end;
end;

procedure Tdtmrelatoriovendasdoperiodo.MontarFiltroAgentes(
  Usar: TCheckListBox);
var
  STRAgentes: String;
  TodosAgentes: Boolean;
  cnt: Integer;
begin
  TodosAgentes := True;
  STRAgentes := '';
  for cnt := 0 to FListaAgentes.Count - 1 do
    if Usar.Checked[cnt] then
      STRAgentes := STRAgentes + '''' + IntToStr(Integer(FListaAgentes.Objects[cnt])) + ''','
    else
      TodosAgentes := False;

  STRAgentes := Copy(STRAgentes, 0, Length(STrAgentes) - 1);
  Agentes:=STRAgentes;
  if Trim(STRAgentes) <> '' then
   if not TodosAgentes then
    FParametroCabecalho:=FParametroCabecalho+' Agentes: '+STRAgentes
   else
    Agentes:='';
end;

procedure Tdtmrelatoriovendasdoperiodo.MontarFiltroConceitos(
  Usar: TCheckListBox);
var
  STRConceitos: String;
  TodosConceitos : Boolean;
  cnt: Integer;
begin
  TodosConceitos := True;
  STRConceitos := '';
  for cnt := 0 to FListaConceitos.Count - 1 do
    if Usar.Checked[cnt] then
      STRConceitos := STRConceitos + '''' + IntToStr(Integer(FListaConceitos.Objects[cnt])) + ''','
    else
      TodosConceitos:=false;
  STRConceitos := Copy(STRConceitos, 0, Length(STRConceitos) - 1);
  Conceitos := STRConceitos ;
  if Trim(STRConceitos) <> '' then
   if not TodosConceitos then
    FParametroCabecalho:=FParametroCabecalho+' Conceitos: '+STRConceitos
   else
    Conceitos := '';
end;

procedure Tdtmrelatoriovendasdoperiodo.MontarOrdenacao;
var
Ordenacao, Ordenacao_contratos, Ordenacao_notascupons: String;
begin
  Ordenacao:='';
  if FAgruparGrupoFilial then
    Ordenacao:=Ordenacao+', nomegrupofilialvenda, grupofilialvenda ';
  if FAgruparFilial then
    Ordenacao:=Ordenacao+', nomefilialvenda, filialvenda ';
  if FAgruparDataVenda then
    Ordenacao:=Ordenacao+', datavenda ';

  if SepararVendas and SepararDevolucoes then
    Ordenacao := Ordenacao+', tipo, contratoavista '
  else
   if SepararVendas then
     Ordenacao := Ordenacao+', contratoavista '
   else
    if SepararDevolucoes then
      Ordenacao := Ordenacao+', tipo ';


  case TipoAgrupamento of
  0: Ordenacao := Ordenacao+', nomecliente, cliente, tipocliente, datavenda ';
  1: Ordenacao := Ordenacao+', datavenda, nomecliente, cliente, tipocliente ';
  2: Ordenacao := Ordenacao+', ncontrato ';
  3: Ordenacao := Ordenacao+', notafiscal, cupomfiscal ';
  4: Ordenacao := Ordenacao+', valortotal desc, nomecliente, cliente ';
  end;

  if FMaioresVendasdoPeriodo or FMaioresClientesdoPeriodo then
  begin
   Ordenacao_contratos:=Ordenacao+', tipo desc, valortotalabs desc, ncontrato ';
   Ordenacao_notascupons:=Ordenacao+', tipo desc, valortotalabs desc, notafiscal, cupomfiscal ';
  end
  else
  begin
   Ordenacao_contratos:=Ordenacao+', ncontrato, Tipo ';
   Ordenacao_notascupons:=Ordenacao+', notafiscal, cupomfiscal, Tipo ';
  end;

  case resumo of
   2 : begin
        qryImprimirContratos.ParamByName('AgruparFilial').AsBoolean := AgruparFilial;
        qryImprimirContratos.ParamByName('AgruparGrupoFilial').AsBoolean := AgruparGrupoFilial;
        qryImprimirContratos.ParamByName('AgruparDataVenda').AsBoolean := AgruparDataVenda;
        qryImprimirNotasCupons.ParamByName('AgruparFilial').AsBoolean := AgruparFilial;
        qryImprimirNotasCupons.ParamByName('AgruparGrupoFilial').AsBoolean := AgruparGrupoFilial;
        qryImprimirNotasCupons.ParamByName('AgruparDataVenda').AsBoolean := AgruparDataVenda;
        qryImprimirNotasCupons.Sql.Append(') as temp');
        qryImprimirNotasCupons.Sql.Append('group by filialvenda, nomefilialvenda, grupofilialvenda, nomegrupofilialvenda, datavenda, tipo, contratoavista, tipoA, totalizado');
       end;
  end;

  qryImprimirContratos.sql.Append('Order by '+copy(Ordenacao_contratos,2,length(Ordenacao_contratos)-1));
  qryImprimirNotasCupons.sql.Append('Order by '+copy(Ordenacao_notascupons,2,length(Ordenacao_notascupons)-1));

end;

procedure Tdtmrelatoriovendasdoperiodo.frpImprimirVendasBeforePrint(
  Memo: TStringList; View: TfrView);
begin
  inherited;
  if (View.Name = 'fpvLogo') then
  begin
   if FileExists(LogotipoFilialBase) then
    try TfrPictureView(View).Picture.LoadFromFile(LogotipoFilialBase) except end;
  end
  else
  if TColor(strtoint(parsistema.CorZebradoRelatorio))<>TColor(clnone) then
   if (View.Name = 'mmoZebrado') then
    if (frpImprimirVendas.Dictionary.Variables.Variable['LINHA'] MOD 2)=0 then
      frpImprimirVendas.FindObject('mmoZebrado').FillColor := TColor(strtoint(parsistema.CorZebradoRelatorio))
    else
      frpImprimirVendas.FindObject('mmoZebrado').FillColor := clnone;

end;

procedure Tdtmrelatoriovendasdoperiodo.qryImprimirNotasCuponsCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  if not (dataset.State in [dsedit]) then
  begin
  qryImprimirNotasCuponsOutras.AsFloat:=
     (qryImprimirNotasCuponsvalorfrete.AsFloat)+
     (qryImprimirNotasCuponsseguro.AsFloat)+
     (qryImprimirNotasCuponsdespesasacessorias.AsFloat);
  qryImprimirNotasCuponseFinanceiro.AsFloat:=
    (qryImprimirNotasCuponsvalortotal.AsFloat)-
    ((qryImprimirNotasCuponsvalorvista.AsFloat)+
     (qryImprimirNotasCuponsOutras.asfloat));

  if ExibirTotaisVendaseDevolucoes then
   if SepararDevolucoes and SepararVendas then
   begin
     if (qryImprimirNotasCuponstipo.asstring='Cancelamentos') then
      qryImprimirNotasCuponsNVendaDevolucao.AsString := 'Devoluções - '
     else
      qryImprimirNotasCuponsNVendaDevolucao.AsString := 'Vendas - ';

     if qryImprimirNotasCuponscontratoavista.asboolean then
       qryImprimirNotasCuponsNVendaDevolucao.AsString :=
        qryImprimirNotasCuponsNVendaDevolucao.AsString + 'a Vista'
     else
       qryImprimirNotasCuponsNVendaDevolucao.AsString :=
        qryImprimirNotasCuponsNVendaDevolucao.AsString + 'a Prazo';
   end
   else
   if SepararDevolucoes then
   begin
     if (qryImprimirNotasCuponstipo.asstring='Cancelamentos') then
      qryImprimirNotasCuponsNVendaDevolucao.AsString := 'Devoluções'
     else
      qryImprimirNotasCuponsNVendaDevolucao.AsString := 'Vendas';
   end
   else
   if SepararVendas then
   begin
     if qryImprimirNotasCuponscontratoavista.asboolean then
       qryImprimirNotasCuponsNVendaDevolucao.AsString :='a Vista'
     else
       qryImprimirNotasCuponsNVendaDevolucao.AsString :='a Prazo';
   end;
  end;
end;


procedure Tdtmrelatoriovendasdoperiodo.qryImprimirContratosAfterScroll(
  DataSet: TDataSet);
begin
  inherited;
  if FImprimindoRelatorio and not qryImprimirContratos.Eof then
  begin
   VerificarAgrupamentoContratos;
   if not qryImprimirContratostotalizado.AsBoolean then
     TotalizarRelatorio;
  end;
end;

procedure Tdtmrelatoriovendasdoperiodo.SetParametroClienteFinal(
  const Value: String);
const
 SQLCliente_Contratos =
  ' and ((ct.cliente '+
  ' in (Select vf.codigo '+
  ' from vfornecedores vf '+
  ' where (%s))) '+
  ' and (lpad(cast(ct.cliente as varchar)||cast(ct.tipocliente as varchar),11,''0'') '+
        ' in (Select lpad(cast(vf.codigo as varchar)||cast(vf.tipo as varchar),11,''0'')'+

            ' from vfornecedores vf '+

            ' where (%s))))';

 SQLCliente_Notas =
  ' and ((df.cliente '+
  ' in (Select vf.codigo '+
  ' from vfornecedores vf '+
  ' where (%s)))'+
  ' and (lpad(cast(df.cliente as varchar)||cast(df.tipocliente as varchar),11,''0'') '+
        ' in (Select lpad(cast(vf.codigo as varchar)||cast(vf.tipo as varchar),11,''0'')'+

            ' from vfornecedores vf '+

            ' where (%s))))';

 SQLCliente_NotasDevolvidas =
  ' and ((np.fornecedor '+
  ' in (Select vf.codigo '+
  ' from vfornecedores vf '+
  ' where (%s)))'+
  ' and (lpad(cast(np.fornecedor as varchar)||cast(np.tipofornecedor as varchar),11,''0'') '+
        ' in (Select lpad(cast(vf.codigo as varchar)||cast(vf.tipo as varchar),11,''0'')'+

            ' from vfornecedores vf '+

            ' where (%s))))';

begin
 FParametroClienteFinal := Value;
 case FParametroSelecao of
  0: begin
      if (FParametroClienteInicial<>'') and
       (FParametroClienteFinal<>'') then
      begin
       case FOpcaoRelatorio of

       0: begin
             qryGravarContratos.MacroByName('WhereClientes').AsString :=
              format(SQLCliente_Contratos,[
                 ' vf.codigo between ('+FParametroClienteInicial+
                 ') and ('+FParametroClienteFinal+')',
                 ' lpad(cast(vf.codigo as varchar)||cast(vf.tipo as varchar),11,''0'') between lpad('+quotedstr(FParametroClienteInicial+qryClienteInicialtipo.AsString)+
                 ' ,11, ''0'') and lpad('+quotedstr(FParametroClienteFinal+qryClienteFinaltipo.AsString)+',11,''0'')']);

             qryGravarContratos.MacroByName('WhereClientes_notas').AsString :=
               format(SQLCliente_Notas,[
                     ' vf.codigo between ('+FParametroClienteInicial+
                     ') and ('+FParametroClienteFinal+')',
                     ' lpad(cast(vf.codigo as varchar)||cast(vf.tipo as varchar),11,''0'') between lpad('+quotedstr(FParametroClienteInicial+qryClienteInicialtipo.AsString)+
                     ' ,11, ''0'') and lpad('+quotedstr(FParametroClienteFinal+qryClienteFinaltipo.AsString)+',11,''0'')']);

            if FDevolucoesPeriodoAnterior or FDevolucoesPeriodoSelecionado then
              qryGravarContratos.MacroByName('WhereClientes_devolucoes').AsString :=
                format(SQLCliente_NotasDevolvidas,[
                     ' vf.codigo between ('+FParametroClienteInicial+
                     ') and ('+FParametroClienteFinal+')',
                     ' lpad(cast(vf.codigo as varchar)||cast(vf.tipo as varchar),11,''0'') between lpad('+quotedstr(FParametroClienteInicial+qryClienteInicialtipo.AsString)+
                     ' ,11, ''0'') and lpad('+quotedstr(FParametroClienteFinal+qryClienteFinaltipo.AsString)+',11,''0'')']);

          end;

       1: begin

             qryImprimirNotasCupons.MacroByName('WhereClientes_notas').AsString :=
               format(SQLCliente_Notas,[
                     ' vf.codigo between ('+FParametroClienteInicial+
                     ') and ('+FParametroClienteFinal+')',
                     ' lpad(cast(vf.codigo as varchar)||cast(vf.tipo as varchar),11,''0'') between lpad('+quotedstr(FParametroClienteInicial+qryClienteInicialtipo.AsString)+
                     ' ,11, ''0'') and lpad('+quotedstr(FParametroClienteFinal+qryClienteFinaltipo.AsString)+',11,''0'')']);

            if FDevolucoesPeriodoAnterior or FDevolucoesPeriodoSelecionado then
              qryImprimirNotasCupons.MacroByName('WhereClientes_devolucoes').AsString :=
                format(SQLCliente_NotasDevolvidas,[
                     ' vf.codigo between ('+FParametroClienteInicial+
                     ') and ('+FParametroClienteFinal+')',
                     ' lpad(cast(vf.codigo as varchar)||cast(vf.tipo as varchar),11,''0'') between lpad('+quotedstr(FParametroClienteInicial+qryClienteInicialtipo.AsString)+
                     ' ,11, ''0'') and lpad('+quotedstr(FParametroClienteFinal+qryClienteFinaltipo.AsString)+',11,''0'')']);
          end;
       end;

       FParametroCabecalho:=FParametroCabecalho+
               ' Cliente Inicial: '+qryClienteInicialtipo.AsString+FParametroClienteInicial+
               ' Final: '+qryClienteFinaltipo.AsString+FParametroClienteFinal;
      end
      else
       if (FParametroClienteInicial<>'') and
         (FParametroClienteFinal='') then
       begin
         case FOpcaoRelatorio of
         0: begin
              qryGravarContratos.MacroByName('WhereClientes').AsString :=
               format(SQLCliente_Contratos,[
                 ' vf.codigo >= '+FParametroClienteInicial,
                 ' lpad(cast(vf.codigo as varchar)||cast(vf.tipo as varchar),11,''0'') >= lpad('+quotedstr(FParametroClienteInicial+qryClienteInicialtipo.AsString)+',11,''0'')']);

              qryGravarContratos.MacroByName('WhereClientes_notas').AsString := format(SQLCliente_Notas,[
                   ' vf.codigo >= '+FParametroClienteInicial,
                   ' lpad(cast(vf.codigo as varchar)||cast(vf.tipo as varchar),11,''0'') >= lpad('+quotedstr(FParametroClienteInicial+qryClienteInicialtipo.AsString)+',11,''0'')']);

              if FDevolucoesPeriodoAnterior or FDevolucoesPeriodoSelecionado then
                qryGravarContratos.MacroByName('WhereClientes_devolucoes').AsString:= format(SQLCliente_NotasDevolvidas,[
                     ' vf.codigo >= '+FParametroClienteInicial,
                     ' lpad(cast(vf.codigo as varchar)||cast(vf.tipo as varchar),11,''0'') >= lpad('+quotedstr(FParametroClienteInicial+qryClienteInicialtipo.AsString)+',11,''0'')']);


            end;

         1: begin
              qryImprimirNotasCupons.MacroByName('WhereClientes_notas').AsString := format(SQLCliente_Notas,[
                   ' vf.codigo >= '+FParametroClienteInicial,
                   ' lpad(cast(vf.codigo as varchar)||cast(vf.tipo as varchar),11,''0'') >= lpad('+quotedstr(FParametroClienteInicial+qryClienteInicialtipo.AsString)+',11,''0'')']);

              if FDevolucoesPeriodoAnterior or FDevolucoesPeriodoSelecionado then
                qryImprimirNotasCupons.MacroByName('WhereClientes_devolucoes').AsString:= format(SQLCliente_NotasDevolvidas,[
                     ' vf.codigo >= '+FParametroClienteInicial,
                     ' lpad(cast(vf.codigo as varchar)||cast(vf.tipo as varchar),11,''0'') >= lpad('+quotedstr(FParametroClienteInicial+qryClienteInicialtipo.AsString)+',11,''0'')']);
            end;
         end;
         FParametroCabecalho:=FParametroCabecalho+
         ' Cliente Inicial: '+qryClienteInicialtipo.AsString+FParametroClienteInicial;
       end
       else
        if (FParametroClienteInicial='') and
           (FParametroClienteFinal<>'') then
        begin
          case FOpcaoRelatorio of
          0: begin
              qryGravarContratos.MacroByName('WhereClientes').AsString :=
               format(SQLCliente_Contratos,[
