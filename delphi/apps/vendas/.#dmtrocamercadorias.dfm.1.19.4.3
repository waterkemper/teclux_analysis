  object qryProcuraCliente: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryProcuraClienteAfterOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select coalesce(v.razao,v.nome) as nome,'
      '       v.codigo,'
      '       v.tipo,'
      
        '       case when v.tipo = '#39'C'#39' then (select c.naoexibirfichafinan' +
        'ceira from clientes c where c.codigo = v.codigo)'
      '            else false'
      '       end as naoexibirfichafinanceira,'
      
        '       (select c.empcargo from clientes c where c.codigo = :codi' +
        'go) as cargocliente, '
      '       markup'
      'From   vfornecedores v'
      'Where (v.codigo = :codigo) and'
