        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroCupons'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '(Select  max(notascupons.filialnota) as filialnota,'
      '             cast(max(notascupons.serie) as varchar) as serie,'
      '             max(notascupons.nota) as nota,'
      '             max(notascupons.filialcupom) as filialcupom,'
      '             max(notascupons.maquina) as maquina,'
      '             max(notascupons.intervensao) as intervensao,'
      '             max(notascupons.cupom) as cupom,'
      '             max(notascupons.dadofiscal) as dadofiscal,'
      
        '             max(notascupons.valorreducaobaseunitaria) as valorr' +
        'educaobaseunitaria,'
      '             max(notascupons.quantidade) as quantidade,'
      '             0.00 as devolver'
      'From   (Select n.filial as filialnota,'
      '               n.serie,'
      '               n.numero as nota,'
      '               0 as filialcupom,'
      '               0 as maquina,'
      '               0 as intervensao,'
      '               0 as cupom,'
      '               n.dadofiscal as dadofiscal,'
      
        '               pn.reducaobase/pn.quantidade as valorreducaobaseu' +
        'nitaria,'
      
        '               (pn.quantidade - (Select coalesce(sum(npd.quantid' +
        'ade),0)'
      '                                 From notaspagdadosfiscais npd'
      
        '                                 Where (npd.dadofiscal = df.nume' +
        'ro)'
      '                                   and (npd.produto = :produto)'
      
        '                                   and (npd.filial = :filial))) ' +
        'as quantidade'
      
        '           From   notas n left join dadosfiscais df on (n.dadofi' +
        'scal = df.numero), produtosdadosfiscais pn'
      '           Where (df.contrato = :contrato)'
      '             and (df.numero = pn.dadofiscal)'
      '             and (pn.produto = :produto)'
      '             and (pn.filial = :filial)'
      '             and df.situacao<>'#39'C'#39
      '             and n.dadofiscalvinculado is null'
      '          %FiltroNotas'
      '           Union'
      '           Select 0 as filialnota,'
      '                  '#39#39' as serie,'
      '                  0 as nota,'
      '                  c.filial as filialcupom,'
      '                  c.maquina,'
      '                  c.intervensao,'
      '                  c.numero as cupom,'
      '                  c.dadofiscal as dadofiscal,'
      
        '                  pn.reducaobase/pn.quantidade as valorreducaoba' +
        'seunitaria,'
      
        '                  (pn.quantidade - (Select coalesce(sum(npd.quan' +
        'tidade),0)'
      
        '                                    From notaspagdadosfiscais np' +
        'd'
      
        '                                    Where (npd.dadofiscal = df.n' +
        'umero)'
      
        '                                      and (npd.produto = :produt' +
        'o)'
      
        '                                      and (npd.filial = :filial)' +
        ')) as quantidade'
      
        '           From   cupons c left join dadosfiscais df on (c.dadof' +
        'iscal = df.numero), produtosdadosfiscais pn'
      '           Where (df.contrato = :contrato)'
      '             and (df.numero = pn.dadofiscal)'
      '             and (pn.produto = :produto)'
      '             and (pn.filial = :filial)'
      '             and df.situacao<>'#39'C'#39
      '          %FiltroCupons'
      '          ) as notascupons'
      'Group By notascupons.dadofiscal)')
    RequestLive = True
    Left = 50
    Top = 267
    ParamData = <
      item
        DataType = ftUnknown
