      '              (d.codigo = c.cidade)'
      '       ) as nomecidade,'
      '      (select d.CodigoIBGE'
      '       from cidades d'
      '       where d.estado = c.estado'
      '         and d.codigo = c.cidade) as CidadeIBGE,'
      '       (select nome'
