        Value = '0'
      end
      item
        DataType = ftUnknown
        Name = 'FiltrarProdutosEFiliaisContratos'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select p.descricao, p.caracteristica,'
      
        '      (select g.descricao from grades g where g.codigo = c.grade' +
        '1) as linha,'
      
        '      (select g.descricao from grades g where g.codigo = c.grade' +
        '2) as coluna,'
      '       p.valorgrade1,'
      '       p.valorgrade2,'
      '       p.codigo as produto,'
      '       p.codigovisual as produtovisual,'
      '       e.filial, e.futuro,'
      '       c.montagem,'
      '       c.unidade,'
      '       c.brinde,'
      
        '      (select ei.valor from estadosicms ei where ei.estado =:est' +
        'ado and ei.icms = c.icms) as aliquotaicms,'
      '       c.icms,'
      
        '      (select i.aliquota from ipi i  where i.codigo = c.ipi) as ' +
        'aliquotaipi,'
      '       c.aliquotapis,'
      '       c.aliquotacofins,'
      
        '      (select t.valor from tributosicms t where t.codigo = c.inc' +
        'idencia) as incidencia,'
      '       c.csosn,'
      '       c.origem,'
      '       c.vendanegativa as vendasemestoque,'
      
        '      (select estoques_produtoempromocao(p.codigo,:filialbase)) ' +
        'as promocao,'
      '       c.percreducaobase,'
      '       e.emestoque,'
      
        '      (select ipi.extipi from ipi where ipi.codigo = c.ipi) as e' +
        'xtipi,'
      
        '      (select ipi.genero from ipi where ipi.codigo = c.ipi) as g' +
        'enero,'
      
        '      (select ipi.classificacaofiscal  from ipi where (ipi.codig' +
        'o = c.ipi)) as classificacaofiscal,'
      '      c.ICMSModalidade,'
      '      c.icmsmodsubst,'
      '      c.composto'
      ''
      ''
      'from caracteristicas c, produtos p, estoques e'
      ''
      'where  ( p.codigo  in'
      '                  ((select pcb.produto'
      '                    from produtoscodigobarras pcb'
      '                    where pcb.codigobarras = :produtovisual)'
      ''
      '                    union all'
      ''
      '                    (select p2.codigo'
      '                     from produtos p2'
      
        '                     where upper(to_ascii(p2.codigovisual,'#39'latin' +
        '1'#39')) = upper(to_ascii(:produtovisual,'#39'latin1'#39')))'
      ''
      '                   )) and'
      ''
      '          (p.inativo is null) and'
      '          (c.codigo = p.caracteristica) and'
      '          (p.codigo = e.produto) and'
      '          (e.filial in (%filialsaida)) and'
      '          (0 < (select count(*)'
      '                   from estoques e1'
      '                   where (e1.filial = e.filial) and'
      '                             (e1.produto = p.codigo)'
      
        '           )      ) and (case when :ConsiderarMarkupClientes the' +
        'n(estoques_preco(p.codigo, :FilialPreco, (coalesce(:markup,0))) ' +
        '> 0)'
      
        '             when :ConsiderarMarkupcargos then (estoques_preco(p' +
        '.codigo, :FilialBase, (coalesce(:MarkupCargos,0))) >0)'
      
        '             else (estoques_preco(p.codigo, :FilialBase) > 0) en' +
        'd)'
      ''
      ' %FiltrarProdutosEFiliaisContratos'
      ''
      
        'order by UPPER(TO_ASCII(p.descricao,'#39'LATIN1'#39')), p.valorgrade1, p' +
        '.valorgrade2'
      ''
      '')
    RequestLive = False
