      '         sc.complementoservico,'
      '         sc.equipamento,'
      '         e.descricao as descricaoequipamento,'
      '         e.referencia,'
      '         e.marca,'
      '         e.modelo,'
      '         e.opcionais,'
      '         e.ano,'
      '         m.descricao as descricaomarca,'
      '         sc.estado,'
      '         sc.cidade,'
      '         (select c.nome'
      '          from cidades c'
      '          where c.estado = sc.estado'
      '           and c.codigo = sc.cidade) as nomecidade,'
      '         sc.reterissqn,'
      '         sc.valorissqn,'
      '         True as ValorISSQNDigitado,'
      '         s.piscst,'
      '         s.pisaliquota,'
      '         s.cofinscst,'
      '         s.cofinsaliquota,'
      '         S.codigolcp116,'
      '         s.cnae,'
      '         s.cstissqn,'
      '        (select ae.codigoatividade'
      '         from atividadeseconomicas ae'
      '         where ae.codigo = s.cnae) as codigoatividade,'
      ''
      ''
      '       round(((select sum(irc.valorimpostoretido)'
      '        from impostosretidoscontratos irc'
      '        where irc.contrato = sc.contrato'
      
        '          and irc.impostoretido <> 5)  * (sc.quantidade*sc.valor' +
        'servico) /'
      '          '
