  object qryProdutosContratosTroca: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryProdutosContratosTrocaAfterOpen
    AfterInsert = qryProdutosContratosTrocaAfterInsert
    AfterScroll = qryProdutosContratosTrocaAfterScroll
    OnNewRecord = qryProdutosContratosTrocaNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select pc.contrato,'
      '           pc.produto,'
      '           p.codigo as produtovisual,'
      '           pc.quantidade,'
      '           pc.precovenda,'
      '           pc.precovenda as precovendaaux,'
      '           pc.desconto,'
      
        '           coalesce(pc.valordescontoitem,0) as valordescontoitem' +
        ','
      '           pc.filial,'
      '           pc.brinde,'
      '           pc.produtolista,'
      '           pc.cancelado,'
      '           p.caracteristica,'
      '           p.descricao,'
      
        '           (select gr.descricao from grades gr where gr.codigo =' +
        ' c.grade1) as linha,'
      
        '           (select gr.descricao from grades gr where gr.codigo =' +
        ' c.grade2) as coluna,'
      '           p.valorgrade1,'
      '           p.valorgrade2,'
      '           c.unidade,'
      '           c.origem,'
      '           t.valor as incidencia,'
      '           c.csosn,'
      '           c.icms,'
      
        '           (select i.aliquota from ipi i where i.codigo = c.ipi)' +
        ' as aliquotaipi,'
      '           c.aliquotapis,'
      '           c.aliquotacofins,'
      '           c.percreducaobase,'
      ''
      
        '           (Select m.futuro From movimentos m where (m.numero = ' +
        '(Select max(m1.numero)'
      '            From movimentos m1'
      '            Where (m1.produto = pc.produto) and'
      
        '                  (m1.filial = case when :filialvirtual then pc.' +
        'filial else :filialdevolucao end)))) as futuro,'
      ''
      '           (Select m.futuro'
      '            From movimentos m'
      '            where m.numero = (Select max(m1.numero)'
      '                              From movimentos m1'
      '                              Where m1.produto = pc.produto and'
      
        '                              m1.filial = pc.filial)) as futurof' +
        'ilialsaida,'
      ''
      
        '           (Select valor From estadosicms Where estado =:estado ' +
        'and icms =c.icms) as aliquotaicms,'
      ''
      
        '           (case when (pc.filial <> case when :filialvirtual the' +
        'n pc.filial else :filialdevolucao end) then'
      
        '                               (Select produtoscontratos_qtdeent' +
        'regue(:primogenito  , pc.produto, pc.filial) -'
      
        '                                           produtoscontratos_qtd' +
        'edevolvida(:primogenito, pc.produto, case when :filialvirtual th' +
        'en pc.filial else :filialdevolucao end))'
      
        '                     else   (Select  produtoscontratos_qtdeentre' +
        'gue(:primogenito  , pc.produto, pc.filial) -'
      
        '                                           produtoscontratos_qtd' +
        'edevolvida(:primogenito, pc.produto, pc.filial))'
      '            end) as qtdeentregue,'
      
        '            /*ATEN'#199#195'O: a quantidade esta ficando negativa no cam' +
        'po qtdeentregue quando a filial for diferente da devolu'#231#227'o */'
      ''
      '           (select sum(pt.quantidade)'
      '             from produtostrocados pt'
      '             where pt.contrato = pc.contrato and'
      '                        pt.produto = pc.produto and '
      '                        pt.filial = pc.filial) as Trocados,   '
      '           0.00 as devolver,'
      '           0.00 as qtdeentregueparadevolver,'
      '           false as defeito, '
      '           pc.precotabela,'
      '           c.composto,'
      '           0.00 as ValorReducaoBaseUnitaria,'
      '           c.ICMSModalidade,'
      '           c.icmsmodsubst,'
      '           c.ipicst,'
      '           c.piscst,'
      '           c.cofinscst,'
      
        '           (select ipi.extipi from ipi where ipi.codigo = c.ipi)' +
        ' as extipi,'
      
        '           (select ipi.genero from ipi where ipi.codigo = c.ipi)' +
        ' as genero,'
      
        '           (select ipi.classificacaofiscal  from ipi where (ipi.' +
        'codigo = c.ipi)) as classificacaofiscal,'
      ''
      '          pc.icmsvalorst,'
      '          pc.valoripi,'
      '          pc.acrescimo,'
      '          pc.frete,'
      '          pc.seguro,'
      '         '
      ''
      '           (select df.filialemissao'
      '             from dadosfiscais df'
      '                  join produtosdadosfiscais pdf'
      '                  on df.numero = pdf.dadofiscal'
      '             where df.numero = pdf.dadofiscal'
      '               and df.contrato = pc.contrato'
      '               and pdf.produto = pc.produto'
