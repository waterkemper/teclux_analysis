  object qryProcuraCliente: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryProcuraClienteAfterOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select coalesce(v.razao,v.nome) as nome,'
      '         v.pessoatipo,'
      '         v.pessoanumero,'
      '         v.codigo,'
      '         v.civil,'
      '         v.rua,'
      '         v.numero,'
      '         v.complemento,'
      '         v.bairro,'
      '         v.cidade,'
      '         v.estado,'
      '         v.cep,'
      '         v.foneddd,'
      '         v.fonenumero,'
      '         v.foneramal,'
      '         v.fonedddempresa,'
      '         v.fonenumeroempresa,'
      '         v.foneramalempresa,'
      '         v.email,'
      '         v.markup,'
      
        '         (select c.empcargo from clientes c where c.codigo = :co' +
        'digo) as cargocliente,'
      '         v.tipo as tipoorig,'
      '         (select b.nome'
      '          from bairros b'
      '          where (b.codigo = v.bairro) and'
      '                    (b.cidade = v.cidade) and'
      '                    (b.estado = v.estado)'
      '         ) as nomebairro, '
      '         (select c.nome'
      '          from cidades c'
      '          where (c.codigo = v.cidade) and'
      '                    (c.estado = v.estado)'
      '         ) as nomecidade,'
      '         (select c.empcargo'
      '          from clientes c'
      '          where c.codigo = v.codigo'
      '            and v.tipo = '#39'C'#39') as empcargo,'
      '         v.sexo,'
      ''
      '         coalesce((select c.fonetipo'
      '          from clientes c'
      '          where c.codigo = v.codigo'
      
        '            and v.tipo = '#39'C'#39'), cast('#39'P'#39' as varchar(1))) as fonet' +
        'ipo,'
      ''
      '         coalesce((select c.restipo'
      '          from clientes c'
      '          where c.codigo = v.codigo'
      
        '            and v.tipo = '#39'C'#39'), cast('#39'P'#39' as varchar(1))) as resti' +
        'po,'
      ''
      '         coalesce((select c.reftipo'
      '          from clientes c'
      '          where c.codigo = v.codigo'
      
        '            and v.tipo = '#39'C'#39'), cast('#39'P'#39' as varchar(1))) as refti' +
        'po,'
      ''
      '         coalesce((select c.empcomprovado'
      '          from clientes c'
      '          where c.codigo = v.codigo'
      
        '            and v.tipo = '#39'C'#39'), cast(false as boolean)) as empcom' +
        'provado,'
      ''
      '         coalesce((select c.automovel'
      '          from clientes c'
      '          where c.codigo = v.codigo'
      
        '            and v.tipo = '#39'C'#39'), cast(false as boolean)) as automo' +
        'vel,'
      ''
      '         coalesce((select c.cartaocredito'
      '          from clientes c'
      '          where c.codigo = v.codigo'
      
        '            and v.tipo = '#39'C'#39'), cast(false as boolean)) as cartao' +
        'credito,'
      ''
      '         coalesce((select c.cartaoloja'
      '          from clientes c'
      '          where c.codigo = v.codigo'
      
        '            and v.tipo = '#39'C'#39'), cast(false as boolean)) as cartao' +
        'loja,'
      ''
      '         coalesce((select c.cheque'
      '          from clientes c'
      '          where c.codigo = v.codigo'
      
        '            and v.tipo = '#39'C'#39'), cast(false as boolean)) as cheque' +
        ','
      ''
      '         coalesce((select c.chequeespecial'
      '          from clientes c'
      '          where c.codigo = v.codigo'
      
        '            and v.tipo = '#39'C'#39'), cast(false as boolean)) as cheque' +
        'especial,'
      ''
      
        '         case when v.tipo = '#39'C'#39' then (select c.naoexibirfichafin' +
        'anceira from clientes c where c.codigo = v.codigo)'
      '              else false'
      '         end as naoexibirfichafinanceira,'
      ''
      '        (select codigoibge'
      '          from cidades c'
      '          where (c.estado = v.estado) and'
      '                (c.codigo = v.cidade)'
      '         ) as codigoibge,'
      ''
      '         v.inscricaoestadual,'
      '         v.contribicms'
      ''
      'from   vfornecedores v'
      'where (v.codigo =:codigo) and'
      '           (v.tipo =:tipo)'
      'order by UPPER(TO_ASCII(nome,'#39'LATIN1'#39'))')
    RequestLive = False
    Left = 358
    Top = 516
    ParamData = <
      item
        DataType = ftString
        Name = 'codigo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'tipo'
        ParamType = ptUnknown
      end>
