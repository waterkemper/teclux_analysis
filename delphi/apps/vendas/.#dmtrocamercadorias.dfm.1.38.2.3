    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '/*'
      'Select c.numero,'
      '       c.cliente,'
      '       c.tipocliente,'
      '       c.filialvenda,'
      
        '       (Select f.nome From filiais f Where c.filialvenda = f.cod' +
        'igo) as NomeFilial,'
      '       c.agente,'
      
        '       (Select a.descricao From agentes a Where c.agente = a.cod' +
        'igo) as DescricaoAgente,'
      '       c.vendedor,'
      
        '       (Select u.nome From Usuarios u Where c.vendedor = u.codig' +
        'o) as NomeVendedor,'
      '       c.plano,'
      
        '       (Select p.descricao From planos p Where c.plano = p.codig' +
        'o) as DescricaoPlano,'
      '       c.data,'
      '       c.faturamento,'
      '       c.origem,'
      '       c.valorvista,'
      '       c.valorprazo,'
      '       c.desconto,'
      '       c.creditotroca,'
      '       c.consideracoes,'
      '       c.frete,'
      '       c.seguro,'
      '       c.taxajuros,'
      '       c.situacao,     '
      '       c.listacasamento,'
      '       c.primogenito,       '
      
        '       (select sum(pc.quantidade * pc.precovenda) from produtosc' +
        'ontratos pc where (pc.contrato = c.numero)) as valorprodutos,'
      
        '       (coalesce(c.frete,0) + coalesce(c.seguro,0)) as fretesegu' +
        'ro,'
      '       (c.valorprazo - c.valorvista) as acrescimo,'
      '       cast((case when c.situacao = '#39'F'#39' then '#39'FATURADO'#39
      
        '                        when c.situacao  = '#39'P'#39' then '#39'NOTA PARCIA' +
        'L'#39
      
        '                        when c.situacao  = '#39'N'#39' then '#39'NOTA FISCAL' +
        #39
      '                end) as varchar) as DescricaoSituacao,'
      
        '       (select l.data from listascasamento l where l.codigo = c.' +
        'listacasamento) as datacasamento'
      'from contratos c '
      'where (c.numero = :contrato)'
      'for update'
      '*/'
      ''
      ''
      'Select c.numero,'
      '       c.cliente,'
      '       c.tipocliente,'
      '       c.filialvenda,'
      
        '       (Select f.nome From filiais f Where c.filialvenda = f.cod' +
        'igo) as NomeFilial,'
      '       c.agente,'
      
        '       (Select a.descricao From agentes a Where c.agente = a.cod' +
        'igo) as DescricaoAgente,'
      '       c.vendedor,'
      
        '       (Select u.nome From Usuarios u Where c.vendedor = u.codig' +
        'o) as NomeVendedor,'
      '       c.plano,'
      
        '       (Select p.descricao From planos p Where c.plano = p.codig' +
        'o) as DescricaoPlano,'
      '       c.data,'
      '       c.faturamento,'
      '       c.origem,'
      '       c.valorvista,'
      '       c.valorprazo,'
      '       coalesce(c.desconto, 0.00) as desconto,'
      '       coalesce(c.creditotroca, 0.00) as creditotroca,'
      '       c.consideracoes,'
      '       coalesce(c.frete, 0.00) as frete,'
      '       coalesce(c.seguro, 0.00) as seguro,'
      '       c.taxajuros,'
      '       c.situacao,     '
      '       c.listacasamento,'
      '       c.primogenito,'
      
        '       (select sum(pc.quantidade * pc.precovenda - coalesce(pc.v' +
        'alordescontoitem,0)) from produtoscontratos pc where (pc.contrat' +
        'o = c.numero)) as valorprodutos,'
      
        '       (select sum(pc.valordescontoitem) from produtoscontratos ' +
        'pc where pc.contrato = c.numero) as valordescontoitem,'
      '       c.totalservicos,'
      ''
      
        '       (coalesce(c.frete,0) + coalesce(c.seguro,0)) as fretesegu' +
        'ro,'
      '       (c.valorprazo - c.valorvista) as acrescimo,'
      '       cast((case when c.situacao = '#39'F'#39' then '#39'FATURADO'#39
      
        '                        when c.situacao  = '#39'P'#39' then '#39'NOTA PARCIA' +
        'L'#39
      
        '                        when c.situacao  = '#39'N'#39' then '#39'NOTA FISCAL' +
        #39
      '                end) as varchar) as DescricaoSituacao,'
      '       l.data as datacasamento,'
      '       c.can_data,'
      '       c.can_usuariologado,'
      '       c.can_usuarioautorizacao,'
      ''
      '      (select sum(irc.valorimpostoretido)'
      '       from impostosretidoscontratos irc'
      '       where irc.contrato = :contrato) as valorimpostoretido,'
      '      c.valoricmssubstituicao,'
      
        '      (select sum(pc.valoripi) from produtoscontratos pc where p' +
        'c.contrato = c.numero) as totalIPI  '
      ''
      ''
      ''
      'from contratos c'
      '     left join listascasamento l'
      '     on c.listacasamento = l.codigo'
      ''
      
        'where (c.numero = :contrato) /* and (os IS NULL OR os='#39'false'#39') *' +
        '/'
      ''
      '--for update')
    RequestLive = True
    Left = 56
    Top = 133
    ParamData = <
      item
        DataType = ftString
        Name = 'contrato'
        ParamType = ptUnknown
      end>
