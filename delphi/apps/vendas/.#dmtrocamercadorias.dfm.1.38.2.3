        '                             (colunasprecos.coluna = estoqueprec' +
        'o1.preconormal))'
      '          else  coalesce(estoquepreco1.valorproduto,0)'
      '          end as valorproduto'
      ' from'
      '('
      ' select estoque.*,'
      
        '       case when :ConsiderarMarkupCliente and ((coalesce(:markup' +
        ',0)) > 0) and (estoque.valorultimacompra > 0) then'
      
        '                 (estoque.valorultimacompra * (cast(:markup as n' +
        'umeric)/100+1))'
      
        '            when :ConsiderarMarkupCargos and ((coalesce((Select ' +
        'pc.markup from produtoscargos pc'
      
        '                                                                ' +
        '       where pc.cargo =:Cargo'
      
        '                                                                ' +
        '       and pc.produto = estoque.produto),0)) > 0) and (estoque.v' +
        'alorultimacompra > 0) then'
      
        '                 (estoque.valorultimacompra * (cast((Select pc.m' +
        'arkup from produtoscargos pc'
      
        '                                                                ' +
        '       where pc.cargo =:Cargo'
      
        '                                                                ' +
        '       and pc.produto = estoque.produto) as numeric)/100+1))'
      '            when estoque.precopromocao is not null then'
      '                (SELECT valor'
      '                 FROM colunasprecos'
      
        '                 WHERE (colunasprecos.caracteristica = estoque.c' +
        'aracteristica) AND'
      '                       (colunasprecos.preco = estoque.preco) AND'
      
        '                       (colunasprecos.coluna = estoque.precoprom' +
        'ocao) AND'
      '                       (colunasprecos.validade >= now())'
      '                )'
      
        '            else estoques_preco(estoque.produto, :FilialBase) en' +
        'd as valorproduto'
      ' from '
      ' ('
      '  select e.produto, p.codigovisual as produtovisual,'
