      '          pt.produto, '
      
        '          (select p.descricao from produtos p where p.codigo = p' +
        't.produto) as descricaproduto,'
      
        '          (select c.unidade from caracteristicas c, produtos p w' +
        'here p.codigo = pt.produto and c.codigo = p.caracteristica) as u' +
        'nidade,'
