  object qryProdutoEstoque: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select (case when t.preco = 0 then t.valorultimacompra'
      '             else t.preco'
      '        end) as preco,'
      '       t.emestoque,'
      '       t.reservado,'
      '       t.futuro'
      'from'
      '('
      
        'select   (case when :ConsiderarMarkupClientes then estoques_prec' +
        'o(:Codigo, :FilialPreco, :markup)'
      
        '              when :ConsiderarMarkupCargos then estoques_preco(:' +
        'Codigo, :Filial, (Select pc.markup from produtoscargos pc'
      
        '                                                                ' +
        '                                         where pc.cargo =:Cargo'
      
