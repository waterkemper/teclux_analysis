      '         cast(null as numeric(9,3)) as futuro,'
      
        '         (select c.composto from caracteristicas c, produtos p w' +
        'here p.codigo = pt.produto and c.codigo = p.caracteristica) as c' +
        'omposto'
      'from produtostrocados pt'
