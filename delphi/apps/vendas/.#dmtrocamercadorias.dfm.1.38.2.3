      '          pt.precotabela,'
      '          pt.precoavaliado,'
      '          pt.usuario,'
      '          pt.valor,'
      '          cast(0 as numeric) as precovenda,'
      
        '         (select g.descricao from grades g, caracteristicas c, p' +
        'rodutos p where p.codigo = pt.produto and c.codigo = p.caracteri' +
        'stica and g.codigo = c.grade1) as linha,'
      
        '         (select g.descricao from grades g, caracteristicas c, p' +
        'rodutos p where p.codigo = pt.produto and c.codigo = p.caracteri' +
        'stica and g.codigo = c.grade2) as coluna,'
      
        '         (select p.valorgrade1 from produtos p where p.codigo = ' +
        'pt.produto) as valorgrade1,'
      
        '         (select p.valorgrade2 from produtos p where p.codigo = ' +
        'pt.produto) as valorgrade2,'
      '         cast(0 as numeric(9,3)) as qtdeentregueparadevolver,'
      '         pt.defeito,'
      '         cast(null as varchar(2))  as incidencia,'
      '         cast(0 as numeric) as valoricms,'
