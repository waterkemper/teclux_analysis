      '          '
      '       case when sc.reterissqn and'
      '                 coalesce((select irc.valorimpostoretido'
      '                           from impostosretidoscontratos irc'
      '                           where irc.contrato = sc.contrato'
      
        '                             and irc.impostoretido = 5),0)<>0 th' +
        'en'
      '          coalesce(sc.valorissqn)'
      '       else 0.00 end, 2) as ImpostoRetido,'
      ''
      ''
      '         0 as devolver'
      ''
      'From     servicoscontratos sc'
      
        '         left join (equipamentos e left join marcas m on (e.marc' +
        'a = m.codigo))'
      
        '                        on  (sc.equipamento = e.codigo), servico' +
        's s'
      'Where  (sc.servico = s.codigo) and'
      '            (sc.contrato =:contrato)')
