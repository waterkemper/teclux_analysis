function TdtmTrocaMercadorias.TodosProdutosEntreguesDevolvidos: Boolean;
var
  Aux: Boolean;
begin
  Aux := (qryProdutosContratosTroca.recordcount=0);

  qryProdutosContratosTroca.First;
  while not qryProdutosContratosTroca.Eof do
  begin
    Aux:= (((qryProdutosContratosTrocaqtdeentregue.AsCurrency = 0) and
            (qryContratosTrocasituacao.AsString<>'P')) or
           ((qryProdutosContratosTrocaqtdeentregue.AsCurrency > 0) and
            (qryProdutosContratosTrocaqtdeentregueparadevolver.AsCurrency = qryProdutosContratosTrocaqtdeentregue.AsCurrency)));
    if not Aux then
      Break;
    qryProdutosContratosTroca.Next;
  end;
  Result:= Aux;
end;

function TdtmTrocaMercadorias.TodosProdutosDevolvidos: Boolean;
var
  Aux: Boolean;
  RegistroAtual: TBookmark;
begin
  Aux := (qryProdutosContratosTroca.recordcount = 0);
  RegistroAtual := qryProdutosContratosTroca.GetBookmark;
  qryProdutosContratosTroca.First;
  while not qryProdutosContratosTroca.Eof do begin
    Aux:= (((qryProdutosContratosTrocaquantidade.AsCurrency = qryProdutosContratosTrocacancelado.AsCurrency) and
            (qryProdutosContratosTrocaDevolver.AsCurrency = 0)) or  // JA FOI TOTALMENTE DEVOLVIDO ANTERIORMENTE

           ((qryProdutosContratosTrocaDevolver.AsCurrency > 0) and  //ESTA SENDO TOTALMENTE DEVOLVIDO AGORA
            ((qryProdutosContratosTrocaquantidade.AsCurrency - qryProdutosContratosTrocacancelado.AsCurrency) = qryProdutosContratosTrocaDevolver.AsCurrency)));
    if not Aux then
      Break;
    qryProdutosContratosTroca.Next;
  end;
  qryProdutosContratosTroca.GotoBookmark(RegistroAtual);
  qryProdutosContratosTroca.FreeBookmark(RegistroAtual);
  Result:= Aux;
end;

procedure TdtmTrocaMercadorias.ValidarTotaisNotasPag_TotaisDadosFiscais(ListaContratos: String);
const
 SQLNP = 'and np.contrato in (select contrato_original(ct.numero) from contratos ct where ct.numero in (%s))';
 SQLDF = 'and df.contrato in (select contrato_original(ct.numero) from contratos ct where ct.numero in (%s))';
var
  VTotal, VFrete, VSeguro, VDesconto, VDescontoItem, VAcrescimo: Currency;
//  RegistroNota : TBookMark;
  tipoNota : TtecTipoNota;

begin
  VTotal:= 0; VFrete:= 0; VSeguro:= 0; VDesconto:= 0; VDescontoItem:= 0; VAcrescimo:= 0;
  if ListaContratos<>'' then
  begin
    qryTotaisNotasPag.macrobyname('CondicaoListaContratos').asSTring := format(SQLNP, [ListaContratos]);
    qryTotaisDadosFiscais.macrobyname('CondicaoListaContratos').asSTring := format(SQLDF, [ListaContratos]);

    ReFazConsulta(qryTotaisNotasPag,[],[]);
    ReFazConsulta(qryTotaisDadosFiscais,[],[]);

    {
    for TipoNota := tnDEVOLUCAO_COMCONTRATO to tnDEVOLUCAO_SEMCONTRATO do
    begin
      qryNotasPag.First;
      while not qryNotasPag.Eof do
      begin
        if qryNotasPagcodigo.Asinteger = ord(TipoNota) then
        begin
    }
          VTotal    := VTotal     + qryNotasPagvalornota.AsCurrency;
          VFrete    := VFrete     + qryNotasPagfreteinterno.AsCurrency;
          VSeguro   := VSeguro    + qryNotasPagseguro.AsCurrency;
          VDesconto := VDesconto  + qryNotasPagdesconto.AsCurrency;
          vDescontoItem := vDescontoItem + qryNotasPagdescontoitem.AsCurrency;
          VAcrescimo:= VAcrescimo + qryNotasPagacrescimo.AsCurrency;
{
          if not qryNotasPag.BookmarkValid(RegistroNota) then
            RegistroNota := qrynotaspag.GetBookmark;

        end;
        qryNotasPag.Next;
      end;
    end;
}

//    qryNotasPag.GotoBookmark(RegistroNota);
//    qryNotasPag.FreeBookmark(RegistroNota);

    VTotal    := VTotal     + qryTotaisNotasPagtotal_nota.AsCurrency;
    VFrete    := VFrete     + qryTotaisNotasPagtotal_frete.AsCurrency;
    VSeguro   := VSeguro    + qryTotaisNotasPagtotal_seguro.AsCurrency;
    VDesconto := VDesconto  + qryTotaisNotasPagtotal_desconto.AsCurrency;
    VAcrescimo:= VAcrescimo + qryTotaisNotasPagtotal_acrescimo.AsCurrency;

    if VTotal <> qryTotaisDadosFiscaistotal_nota.AsCurrency then
    begin
      qryNotasPag.Edit;
      qryNotasPagvalornota.AsCurrency:= qryNotasPagvalornota.AsCurrency +
                                        (qryTotaisDadosFiscaistotal_nota.AsCurrency - VTotal);
      qryNotasPag.Post;
    end;

    if VFrete <> qryTotaisDadosFiscaistotal_frete.AsCurrency then
    begin
      qryNotasPag.Edit;
      qryNotasPagfreteinterno.AsCurrency:= qryNotasPagfreteinterno.AsCurrency +
                                        (qryTotaisDadosFiscaistotal_frete.AsCurrency - VFrete);
      qryNotasPag.Post;
    end;

    if VSeguro <> qryTotaisDadosFiscaistotal_seguro.AsCurrency then
    begin
      qryNotasPag.Edit;
      qryNotasPagseguro.AsCurrency:= qryNotasPagseguro.AsCurrency +
                                        (qryTotaisDadosFiscaistotal_seguro.AsCurrency - VSeguro);
      qryNotasPag.Post;
    end;

    if VDesconto <> qryTotaisDadosFiscaistotal_desconto.AsCurrency then
    begin
      qryNotasPag.Edit;
      qryNotasPagdesconto.AsCurrency:= qryNotasPagdesconto.AsCurrency +
                                        (qryTotaisDadosFiscaistotal_desconto.AsCurrency - VDesconto);
      qryNotasPag.Post;
    end;

    if VDescontoItem <> qryTotaisDadosFiscaistotal_descontoitem.AsCurrency then
    begin
      qryNotasPag.Edit;
      qryNotasPagdescontoitem.AsCurrency:= qryNotasPagdescontoitem.AsCurrency +
                                        (qryTotaisDadosFiscaistotal_descontoitem.AsCurrency - VDescontoItem);
      qryNotasPag.Post;
    end;


    if VAcrescimo <> (qryTotaisDadosFiscaistotal_nota.AsCurrency -
                      qryTotaisDadosFiscaistotal_vista.AsCurrency) then
    begin
      qryNotasPag.Edit;
      qryNotasPagacrescimo.AsCurrency:= qryNotasPagacrescimo.AsCurrency +
                                        ((qryTotaisDadosFiscaistotal_nota.AsCurrency -
                                          qryTotaisDadosFiscaistotal_vista.AsCurrency) - VAcrescimo);

      qryNotasPag.Post;
    end;
  end;
end;


function TdtmTrocaMercadorias.NotasFiscaisDevolucaoContrato: Boolean;
var
  TipoNota: TtecTipoNota;
//  Posicao: TBookmark;
  Cont: Integer;
  listacontratos : String;
  vRecno : Integer;
begin
  listacontratos := '';
  Result:= False;

  FecharNotasPag;

  ReFazConsulta(qryNaturezasPadrao_,[],[]);

  //1. Devolução com contrato.

//  Posicao := qryProdutosTrocados.GetBookmark;
//  qryProdutosTrocados.DisableControls;
  qryProdutosTrocados.GuardarRegistroAtual(true);

  result := true;

  try
    for TipoNota := tnDEVOLUCAO_COMCONTRATO to tnDEVOLUCAO_SEMCONTRATO do
    begin

      Cont := 0;

      qryProdutosTrocados.First;
      while not qryProdutosTrocados.Eof do
      begin
        vRecno := qryProdutosTrocados.recno;
        if (qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency > 0) and ContratoIdentificado and (TipoNota = tnDEVOLUCAO_COMCONTRATO) then
        begin
          PreencherNotaFiscal(TipoNota);
          result := PreencherProdutosNotasFiscal(TipoNota,Cont);
          if result then
          begin
              {
            if (TipoNota = tnDEVOLUCAO_COMCONTRATO) and ContratoIdentificado  then
            begin
              if not qryProdutosTrocadostodosentregues.AsBoolean then
                TodosEntreguesDevolvidos := false;

              if TodosEntreguesDevolvidos then
               }
                if pos(qryProdutosTrocadoscontrato.AsString,listacontratos)=0 then
                  listacontratos := listacontratos+''''+trim(qryProdutosTrocadoscontrato.AsString)+''',';
            //end;
          end;
        end
        else
        begin
          if not ContratoIdentificado and
            (TipoNota = tnDEVOLUCAO_SEMCONTRATO) then
          begin
            PreencherNotaFiscal(TipoNota);
            result := PreencherProdutosNotasFiscal(TipoNota,Cont);
          end;
        end;

        if result then
        begin
          qryProdutosTrocados.recno := vRecno;  //Garantir que não esteja "pulando" algum registro devido a processamentos {erro gravação nota em duplicidade}
          qryProdutosTrocados.Next;
        end
        else
          break;
      end;

      result := ValidarFechamentoQuantidades(True);

      if result then
      begin

        if Cont > 0  then
        begin
          PreencherNotaFiscal(TipoNota);
          if (ListaContratos<>'') and (TipoNota = tnDEVOLUCAO_COMCONTRATO) and TodosProdutosEntreguesDevolvidos then
          begin
             delete(listacontratos,length(listacontratos),1);
             ValidarTotaisNotasPag_TotaisDadosFiscais(listacontratos);
          end;
          result := CalcularImpostos(qryProdutosNotasPag, qrynotaspag, contribipi, true, true, qryCalculosProdutos, nil, false, Troca );
        end;
      end;

    end;

  finally
//    qryProdutosTrocados.GotoBookmark(Posicao);
//    qryProdutosTrocados.FreeBookmark(Posicao);
//    qryProdutosTrocados.EnableControls
    qryProdutosTrocados.VoltarRegistro;
  end;

end;

function TdtmTrocaMercadorias.GravarDevolucaoMercadoria: Boolean;
var
  I, CodigoNota     : Integer;
  TemProdutoDevolver: Boolean;
  TemServicoDevolver: Boolean;
  TipoNota: TtecTipoNota;
  DF: Integer;
  ObsNotasPag, ChaveAcesso: String;

  {
  procedure ObservacaoNotasPag;
  begin
    qryDadosFiscais.Close;
    qryDadosFiscais.MacroByName('FiltroNotas').AsString := 'and (df.numero = ' + qryNotasPagDadosFiscaisdadofiscal.Asstring + ')';
    qryDadosFiscais.MacroByName('FiltroCupons').AsString := 'and (df.numero = ' + qryNotasPagDadosFiscaisdadofiscal.Asstring + ')';
    qryDadosFiscais.Params[0].AsString:= IntToStr(qryNotasPagDadosFiscaisproduto.AsLargeInt);
//    qryDadosFiscais.Params[1].AsInteger := qryProdutosContratosfilial.AsInteger;
    qryDadosFiscais.Params[1].AsInteger := qryNotasPagDadosFiscaisfilial.AsInteger;
    qryDadosFiscais.Params[2].AsString:= qryContratosTrocanumero.AsString;
    qryDadosFiscais.Open;
    if (qryDadosFiscais.RecordCount > 0) then begin
      if (qryDadosFiscaisnota.AsInteger > 0) then begin
        if Pos(qryDadosFiscaisnota.AsString,ObsNotasPag) = 0 then
          ObsNotasPag:= ObsNotasPag + '[ NF: S' +
                        qryDadosFiscaisserie.AsString + '  N' + qryDadosFiscaisnota.AsString + ' ]' + #10
      end else if (qryDadosFiscaiscupom.AsInteger > 0) then begin
        if Pos(qryDadosFiscaisnota.AsString,ObsNotasPag) = 0 then
          ObsNotasPag:= ObsNotasPag + '[ CF: M' +
                        qryDadosFiscaismaquina.AsString + '  I' + qryDadosFiscaisintervensao.AsString +
                        '  N' + qryDadosFiscaisCupom.AsString + ' ]' + #10;
      end;
    end;
  end;
  }

  procedure AtualizarCodigoNotaProdutos;
  var
    vNvezes : integer;
  begin
    qryCalculosProdutos.First;
    while not qryCalculosProdutos.Eof do
    begin
      if (qryCalculosProdutoscodigonota.AsInteger = Ord(TipoNota)) and (qryCalculosProdutoscodigonota.AsString<>'') then
      begin

        DF := qryCalculosProdutos.recno;   {Esta trocando a posição do registro após o post}
        qryCalculosProdutos.Edit;
        qryCalculosProdutoscodigonota.AsInteger:= CodigoNota;
        qryCalculosProdutos.Post;
        qryCalculosProdutos.recno := DF;

      end;
      qryCalculosProdutos.next;
    end;

//    for vNvezes := 1 to 2 do {Bug...troca de posição após o post...devido ao sortbyfield da função ValidarFechamentoQuantidades(true) em produtosnotaspag}
//    begin
      qryProdutosNotasPag.First;
      while not qryProdutosNotasPag.Eof do
      begin
        if (qryProdutosNotasPagcodigonota.AsInteger = Ord(TipoNota)) and (qryProdutosNotasPagcodigonota.AsString<>'') then
        begin
          qryProdutosNotasPag.Edit;
          qryProdutosNotasPagcodigonota.AsInteger:= CodigoNota;
//          qryProdutosNotasPag.Post;
        end;
        qryProdutosNotasPag.Next;
      end;
//    end;

    qryProdutosNotasPagSeries.First;
    while not qryProdutosNotasPagSeries.Eof do
    begin
      if (qryProdutosNotasPagSeriescodigonota.AsInteger = Ord(TipoNota)) and (qryProdutosNotasPagSeriescodigonota.AsString<>'') then
      begin
        DF:= qryProdutosNotasPagSeries.recno;  {Esta trocando a posição do registro após o post}
        qryProdutosNotasPagSeries.Edit;
        qryProdutosNotasPagSeriescodigonota.AsInteger:= CodigoNota;
        qryProdutosNotasPagSeries.Post;
        qryProdutosNotasPagSeries.recno := DF;
      end;
      qryProdutosNotasPagSeries.Next;
    end;

  end;


  function ExisteNotasDuplicadas: boolean;
  var
    vQuantidadeNotasComContrato, vQuantidadeNotasSemContrato : integer;
  begin
    result := false;
    vQuantidadeNotasComContrato := 0;
    vQuantidadeNotasSemContrato := 0;
    if qrynotaspag.state in [dsinsert] then
      qrynotaspag.post;

    if qrynotaspag.RecordCount > 1 then
    begin
      qryNotasPag.First;
      while not qrynotaspag.Eof do
      begin
//        if qryProdutosNotasPagcontrato.AsString = '' then
        if qryNotasPagcontrato.AsString = '' then
          inc(vQuantidadeNotasSemContrato)
        else
//        if qryProdutosNotasPagcontrato.AsString <> '' then
        if qryNotasPagcontrato.AsString <> '' then
          inc(vQuantidadeNotasComContrato);

        qryNotasPag.next;
      end;
      result := (vQuantidadeNotasSemContrato > 1) or (vQuantidadeNotasComContrato > 1);
    end;
  end;

begin
  result := true;
   // Atribuir o Numero da Nota Fiscal
  FecharNotasPag;

  if TemProdutoImprimirNotaDevolucao or
    (TemProdutoImprimirNotaCompra and
      not ProdutoaTrocarIgualTotalProdutos) then
  begin
    if VerificarSerieFilial then
    begin

      result := NotasFiscaisDevolucaoContrato;
      ObsNotasPag := retornarLista(qryProdutosNotasPag, qryProdutosNotasPagnumeronotafiscalsaida, nil, true);

      if result then
      begin
        try

          qryProdutosNotasPag.MasterSource := nil;
          qryProdutosNotasPag.LinkFields := '';

          qryCalculosProdutos.MasterSource := nil;
          qryCalculosProdutos.LinkFields := '';

          for TipoNota := tnDEVOLUCAO_COMCONTRATO to tnDEVOLUCAO_SEMCONTRATO {tnDEVOLUCAOSUBSTTRIB_SEMCONTRATO} do
          begin

            qryNotasPag.First;
            while not qryNotasPag.Eof do
            begin
              if (qryNotasPagcodigo.AsInteger = Ord(TipoNota)) and (qryNotasPagcodigo.AsString<>'') then
              begin

                spcNotasPagProximoCodigo.Open;
                CodigoNota := spcNotasPagProximoCodigocodigo.AsInteger;
                spcNotasPagProximoCodigo.close;

                AtualizarCodigoNotaProdutos;

                qryNotasPag.Edit;
                qryNotasPagnrdocumento.AsInteger    := qryNumeroNotanumeroinicial.AsInteger;
                qryNotasPagcodigo.AsInteger    := CodigoNota;

                if ObsNotasPag<>'' then
                begin
                  qryNotasPagobservacoes.AsString:= qryNotasPagobservacoes.AsString + #10 +
                                                   'REF. NOTA(s) SAIDA(s): ' + ObsNotasPag;
                  {1 - normal 2 - compelementar}
                  qryNotasPagfinalidadenf.AsInteger   := 4;
                end
                else
                  qryNotasPagfinalidadenf.AsInteger   := 1;

                qryNotasPag.Post;

                qryNumeroNota.Edit;
                qryNumeroNotanumeroinicial.AsInteger := qryNumeroNotanumeroinicial.AsInteger + 1;
                qryNumeroNota.Post;

                if CondicaoEmissorNFE then
                begin
                  // DADOS NF-e
                  qryNotasPag.Edit;
                  qryNotasPagversaolayout.AsCurrency := 3.10;
                  if qryNotasPagmodelodocto.IsNull then
                    qryNotasPagmodelodocto.AsString  := '55';

                  qryNotasPagcodaleatorio.AsInteger  := Aleatorio(qryNotasPagdata.AsDateTime, qryNotasPagnrdocumento.Asstring);

                  { 0 – pagamento à vista   1 – pagamento à prazo     2 - outros }
                  qryNotasPagformapagto.AsInteger    := 2;
                  { 1-Retrato/ 2-Paisagem }
                  qryNotasPagformatodanfe.AsInteger  := 1;
                  {1-Normal/ 2-Contingência}
                  qryNotasPagformaemissao.AsInteger  := NFeTipoEmissao;

                  ChaveAcesso :=
                             copy(CodigoCidadeIBGEFilialBase,1,2)+                            // 2
                             FormatDateTime('YYMM',qryNotasPagdata.AsDateTime)+             // 4
                             preencheString(CNPJFilialBase,'0',14,false)+                     // 14
                             preencheString(qryNotasPagmodelodocto.AsString,'0',2,false)+   // 2
                             preencheString(SerieSugestao,'0',3,false)+                       // 3
                             preencheString(qryNotasPagnrdocumento.Asstring,'0',9,false) +       // 9
                             qryNotasPagformaemissao.Asstring + //1
                             preencheString(qryNotasPagcodaleatorio.Asstring,'0',8,false);  // 8

                  qryNotasPagdigchaveacesso.AsString  := Modulo11(ChaveAcesso);
                  qryNotasPagchv_nfe.AsString  := ChaveAcesso+qryNotasPagdigchaveacesso.AsString;


                  {1 - PRODUÇÃO 2 - HOMOLOGAÇÃO}
                  qryNotasPagambiente.AsInteger       := NFeAmbiente;// '2';

                  {1 - normal 2 - compelementar}
                  qryNotasPagfinalidadenf.AsInteger   := 4;

                  qryNotasPagprocemissao.AsString     := '0';
                  qryNotasPagversaoteclux.AsString    := VersaoTecLUX;
                  qryNotasPaginfcomplementar.AsString := qryNotasPagobservacoes.AsString;
                  qryNotasPag.Post;
                end;


              end;
              qryNotasPag.Next;
            end;
          end;

        finally
          qryProdutosNotasPag.LinkFields := 'codigo=codigonota';
          qryProdutosNotasPag.MasterSource := dsrnotaspag;

          qryCalculosProdutos.LinkFields := 'codigo=codigonota';
          qryCalculosProdutos.MasterSource := dsrnotaspag;

          qryProdutosNotasPag.first;
          qryCalculosProdutos.first;


        end;

      end;

    end;
  end;

  if result then
    if ExisteNotasDuplicadas then
    begin
      result := false;
      MensagemErro('Existem notas de entrada duplicadas, entre em contato com o suporte');
    end;

  if result then
  begin
//    qryProdutosNotasPag.LinkOptions := [loAlwaysResync];
{   dtmGerarNotaFiscal.qryCalculosNotasPag.LinkOptions := [loAlwaysResync];}

    MovimentarProdutosNota;

    if qryProdutoscontratostroca.Active then
    begin
      TemProdutoDevolver:= False;
      qryProdutosContratosTroca.DisableControls;
      try
        qryProdutosContratosTroca.First;
        for I:= 0 to (qryProdutosContratosTroca.RecordCount - 1) do begin
          if not qryProdutosContratosTrocabrinde.AsBoolean then begin
            if (qryProdutosContratosTrocaDevolver.AsCurrency > 0) then begin
              if (qryProdutosContratosTrocacancelado.AsCurrency + qryProdutosContratosTrocaDevolver.AsCurrency) >
                 qryProdutosContratosTrocaquantidade.AsCurrency then
              begin
                result := false;
                MensagemErro('Existem notas de entrada duplicadas pois a quantidade cancelada esta ultrapassando a quantidade vendida!'+chr(13)+
                             'Entre em contato com o suporte!');
                break;
              end
              else
              begin
                qryProdutosContratosTroca.Edit;
                qryProdutosContratosTrocacancelado.AsCurrency   := (qryProdutosContratosTrocacancelado.AsCurrency + qryProdutosContratosTrocaDevolver.AsCurrency);
                qryProdutosContratosTrocaprecovenda.AsCurrency := qryProdutosContratosTrocaprecovendaaux.ascurrency - 1{produtoseServicos[produtos][I].preco};
                qryProdutosContratosTroca.Post;

                                                 {
                if (qryContratosTrocalistacasamento.AsInteger > 0)            and
                   (qryContratosTrocadatacasamento.AsDateTime >= DataServidor) and
                   qryProdutosContratosTrocaprodutolista.AsBoolean then
                   AtualizaProdutosListaCasamento;
                   }
              end;
            end;

            TemProdutoDevolver:= (TemProdutoDevolver or
                                 ((qryProdutosContratosTrocacancelado.AsCurrency < qryProdutosContratosTrocaQuantidade.AsCurrency) and
                                   not qryProdutosContratosTrocabrinde.AsBoolean));

          end;
          qryProdutosContratosTroca.Next;
        end;
      finally
        qryProdutosContratosTroca.EnableControls;
      end;
    end;

    if result then
    begin

      TemServicoDevolver:= False;

      if ContratoIdentificado {(qryProdutosTrocadossituacao.asstring<'')} then
      begin
            qryServicosContratos.DisableControls;
            try
              qryServicosContratos.First;
              for I:= 0 to (qryServicosContratos.RecordCount - 1) do
              begin
                if (qryServicosContratosdevolver.AsCurrency > 0) then
                begin
                  qryServicosContratos.Edit;
                  qryServicosContratoscancelado.AsCurrency   := (qryServicosContratoscancelado.AsCurrency + qryServicosContratosdevolver.AsCurrency);
        //          qryServicosContratosvalorservico.AsCurrency  := ProdutoseServicos[Servicos][I].Preco;
                  qryServicosContratos.Post;
                end;
                TemServicoDevolver:= TemServicoDevolver or
                                     (qryServicosContratoscancelado.AsCurrency < qryServicosContratosQuantidade.AsCurrency);

                qryServicosContratos.Next;
              end;
            finally
              qryServicosContratos.EnableControls;
            end;
      end;


      if (qrycontratostroca.State in [dsedit]) {and(NumeroContrato<>'')} then
        qryContratosTroca.Post;

      if (qryNotasPag.recordcount <> 0) then
        result := (qryNotasPagcodigo.asinteger <> 0) and
                  (qryNotasPagnrdocumento.asinteger <> 0);

      if not result then
        MensagemErro('Ocorreu um erro no processamento, entre em contato com o suporte! O número do documento ou a nota fiscal de entrada não estão corretos.')
      else
      begin

        if (TemProdutoImprimirNotaDevolucao or
            (TemProdutoImprimirNotaCompra and
              not ProdutoaTrocarIgualTotalProdutos))
             and CondicaoEmissorNFE then
           Result := EmitirNFe(true);

        if result then
        begin

          if (NumeroContratoouOrcamento<>'') then
          begin
            if (TTecQuery(dsrContratos.dataset).state in [dsedit, dsinsert]) then
              TTecQuery(dsrContratos.dataset).post;

            result := Perpetrar([

                                 qryPrecos,
                                 qryProdutos,
                                 qryEstoques,

                                 qryContratosTroca,
                                 qryProdutosContratosTroca, qryProdutosContratosSeries,
                                 qryServicosContratos,
    //                             qryProdutosListaCasamento,
                                 qryContratosDevolvidos,

                                 TTecQuery(dsrContratos.dataset),
                                 qryParcelas,
                                 TTecQuery(dsrProdutosContratos.DataSet),
                                 qryProdutosTrocados,

                                 qryNotasPag,
                                 qryProdutosNotasPag , qryProdutosNotasPagSeries,
      {                           dtmGerarNotaFiscal.qryCalculosNotasPag ,}
                                 qryNumeroNota,
                                 {qryNotasPagDadosFiscais,}

                                 qryMovimentos
                                 ]);

          end
          else
          begin
            if ProdutoaTrocarIgualTotalProdutos then {sempre retorna false}
            begin
              qrycontratos.Cancel;
              result := Perpetrar([

                                   qryPrecos,
                                   qryProdutos,
                                   qryEstoques,

                                   qryContratosTroca,
                                   qryProdutosContratosTroca, qryProdutosContratosSeries,
                                   qryServicosContratos,
    //                               qryProdutosListaCasamento,
                                   qryContratosDevolvidos,

                                   qryNotasPag,
                                   qryProdutosNotasPag , qryProdutosNotasPagSeries,
      {                             dtmGerarNotaFiscal.qryCalculosNotasPag ,}
                                   qryNumeroNota,
                                   {qryNotasPagDadosFiscais,}

                                   qryMovimentos
                                   ])
            end
            else
              result := Perpetrar([

                                   qryPrecos,
                                   qryProdutos,
                                   qryEstoques,

                                   qryContratosTroca,
                                   qryProdutosContratosTroca, qryProdutosContratosSeries,
                                   qryServicosContratos,
    //                               qryProdutosListaCasamento,
                                   qryContratosDevolvidos,

                                   qryProdutosTrocados,
                                   qryProdutosTrocadosSaida,

                                   qryNotasPag,
                                   qryProdutosNotasPag , qryProdutosNotasPagSeries ,
      {                             dtmGerarNotaFiscal.qryCalculosNotasPag ,}
                                   qryNumeroNota,
                                   {qryNotasPagDadosFiscais,}

                                   qryMovimentos

                                   ]);
          end;


          if TemProdutoImprimirNotaDevolucao or
            (TemProdutoImprimirNotaCompra and
              not ProdutoaTrocarIgualTotalProdutos) then
          begin
            if not CondicaoEmissorNFE then
            begin
              if MensagemConfirmacao(ctEMITIRNOTAFISCALDEVOLUCAO) = smbOk then
                ImprimirNota;
            end
            else  // ROTINAS DE IMPRESSAO DA NF-e
            begin
              result := EmitirNFe;
              if not result then
                result := true; {Não pode voltar false a partir do momento do envio, já esta gravado, se der erro usar o controle de notas eletronicas}
            end

          end;

        end;


      end;
    end;

    ReFazConsultaContratosPorCliente;

    ReFazConsulta(TTecQuery(dsrContratos.dataset),[0],[0]);
    ReFazConsulta(TTecQuery(dsrProdutosContratos.DataSet),[1],[0]);
    qryProdutosContratosSeries.close;
    qryProdutosContratosSeries.open;
    Refazconsulta(qryProdutosTrocados, [0],[0]);

    if qryparcelas.Active then
      qryparcelas.Close;


    if qryNotasPag.Active then
      qryNotasPag.Close;

    if qryProdutosNotasPag.Active then
      qryProdutosNotasPag.Close;

    if qryProdutosNotasPagSeries.Active then
      qryProdutosNotasPagSeries.Close;

    if qryMovimentos.Active then
      qryMovimentos.Close;

    if qryEstoques.Active then
      qryEstoques.Close;

    if qryProdutos.Active then
      qryProdutos.Close;

    if qryPrecos.Active then
      qryPrecos.Close;
  end;
end;



function TdtmTrocaMercadorias.EmitirNFe(Validando: Boolean = False): Boolean;
var
  LoteNFe, ReciboNFe, ProtocoloNFe, status, DataHoraProcessamento: String;
//  NFe: TTecNotaFiscalEletronica;
begin
  Result := False;

  qryNotasPag.First;
  while not qryNotasPag.Eof do
  begin
    if not Validando then
      NFe := TTecNotaFiscalEletronica.Create
    else
      NFe := TTecNotaFiscalEletronica.Create(dtmTecSoft.Database);

      {
    NFe.DiretorioEnvio       := NFeDirEnvio;
    NFe.DiretorioEnviado     := NFeDirEnviados;
    NFe.DiretorioRetorno     := NFeDirRetorno;
    NFe.DiretorioCompartilha := NfeDirCompartilha;
    NFe.Executavel           := NFeExecNFe;
    `}
    try
      if not Validando then
      begin
        ShowProcessando('Gerando o arquivo da NF-e!');
        Sleep(500);
      end;
      // EMITENTE
      NFe.Emit_Documento := CNPJFilialBase;
      NFe.Emit_Nome      := RazaoFilialBase;
      NFe.Emit_Rua       := RuaSemNumeroFilialBase;
      NFe.Emit_Nro       := NumeroFilialBase;
      NFe.Emit_Compl     := ComplementoFilialBase;
      NFe.Emit_Bairro    := BairroFilialBase;
      NFe.Emit_CodMun    := CodigoCidadeIBGEFilialBase;
      NFe.Emit_Mun       := CidadeFilialBase;
      NFe.Emit_UF        := EstadoFilialBase;
      NFe.Emit_CEP       := CEPFilialBase;
      NFe.Emit_Fone      := DDDFilialBase+FoneFilialBase;
      NFe.Emit_IE        := InscricaoEstadualFilialBase;
      NFe.Emit_IM        := InscricaoMunicipalFilialBase;
      NFe.Emit_CNAE      := CNAEFiscalFilialBase;
      NFe.Emit_CRT       := qryNotasPagregimetributario.AsInteger;

      // DESTINATARIO
      NFe.Dest_TipoPessoa := qryNotasPagpessoatipo.AsString;
      NFe.Dest_Documento := qryNotasPagcnpj.AsString;
      NFe.Dest_Nome      := qryNotasPagnome.AsString;
      NFe.Dest_Rua       := qryNotasPagrua.AsString;
      NFe.Dest_Nro       := qryNotasPagendnumero.AsString;
      NFe.Dest_Compl     := qryNotasPagendcomplemento.AsString;
      NFe.Dest_Bairro    := qryNotasPagnomebairro.AsString;
      NFe.Dest_CodMun    := qryNotasPagcidadeibge.AsString;
      NFe.Dest_Mun       := qryNotasPagnomecidade.AsString;
      NFe.Dest_UF        := qryNotasPagestado.AsString;
      NFe.Dest_CEP       := qryNotasPagcep.AsString;
      NFe.Dest_CodPais   := qryNotasPagpais.AsInteger;
      NFe.Dest_Pais      := qryNotasPagnomepais.AsString;

      if (qryNotasPagfoneddd.AsString<>'') and (qryNotasPagfonenumero.AsString<>'') then
        NFe.Dest_Fone      := qryNotasPagfoneddd.AsString+qryNotasPagfonenumero.AsString
      else
        NFe.Dest_Fone      := '';

      NFe.Dest_IE        := qryNotasPaginscricaoestadual.AsString;
      NFe.Dest_ISUF      := qryNotasPagiesubsttributario.AsString;

      nfe.Validando := Validando;

//      RefazConsultaPorNome(qryDadosFiscaisRef,['dadofiscal'], [qryNotasPagdadofiscalreferenciado.AsVariant]);

     // if ContratoIdentificado then
        RefazConsultaPorNome(qryDadosFiscaisRef,['ListaDadosFiscais'], [RetornarLista(qryProdutosnotaspag, qryprodutosnotaspagdadofiscal)]);

      Result := NFe.GerarNFe(qryNotasPag,qryDadosFiscaisRef,qryProdutosNotasPag,nil,nil,
                     nil,nil,nil,nil,nil,SerieSugestao,'E');

      if Result and not Validando then
      begin
        if NFeTipoEmissao in [1,3] then
        begin
          ShowProcessando;
          ShowProcessando('Verificando status do serviço NF-e!');
          Sleep(500);
          if NFe.VerificarStatusServico(IntToStr(NFeAmbiente)) then
          begin
            ShowProcessando;
            ShowProcessando('Processando o arquivo de envio da NF-e!');
            Sleep(500);
            Result := NFe.EnviarNFe(qryNotasPagchv_nfe.AsString, LoteNFe, ReciboNFe);
            if Result then
            begin
              qryNotasPag.Edit;
              qryNotasPagnumlotenfe.AsString   := LoteNFe;
              qryNotasPagnumrecibonfe.AsString := ReciboNFe;
              qryNotasPag.Post;
              Result := Perpetrar([qryNotasPag]);
              if Result then
              begin
                ShowProcessando;
                ShowProcessando('Consultando o arquivo de retorno da NF-e!');
                Sleep(500);
                Result := NFe.ConsultarSituacaoLote(ReciboNFe, ProtocoloNFe, status, DataHoraProcessamento, IntToStr(NFeAmbiente));
              end;
              if Result then
              begin
                qryNotasPag.Edit;
                qryNotasPagnumprotocolonfe.AsString := ProtocoloNFe;
                qryNotasPagdhprocnfe.AsDateTime :=  FormatarTimeStamp(DataHoraProcessamento);
                qryNotasPagstatusnfe.AsString := status;
                qryNotasPag.Post;

                if (qryNotasPagstatusnfe.AsString = '301') or
                   (qryNotasPagstatusnfe.AsString = '302') then
                begin
                  qryNotasPag.Edit;
                  qryNotasPagsituacao.AsString := 'D';
                  qryNotasPag.Post;
//                  EliminarMovimentos;
//                  LimparTabela(qryDuplicatas);
//                  Result := Perpetrar([qryNotasPag, qryDuplicatas, qryMovimentos]);
                  Result := Perpetrar([qryNotasPag]);
                end
                else
                begin
                  Result := Perpetrar([qryNotasPag]);

                  if Result then
                  begin
                    ShowProcessando;
                    ShowProcessando('Gerando o arquivo de compartilhamento da NF-e!');
                    Sleep(500);
                    Result := NFe.CompartilharXML(qryNotasPagchv_nfe.AsString,
                                                  ReciboNFe, qryNotasPagfilial.AsString,
                                                  SerieSugestao, qryNotasPagnrdocumento.AsString,
                                                  qryNotasPagemissao.AsDateTime);
                    if Result then
                    begin
                      SalvarConteudoxml('E', qryNotasPagcodigo.asString);
                      ShowProcessando;
                      ShowProcessando('Imprimindo o DANFE!');
                      try
                        NFe.ImprimirDanfe({ChaveAcesso+qryNotaFiscaldigchaveacesso.AsString,}
                                          qryNotasPagfilial.AsString,
                                          qryNotasPagserie.AsString,
                                          qryNotasPagnrdocumento.AsString,
                                          qryNotasPaglocalentrega_cep.AsString,
                                          '',
                                          IntToStr(NFeNVias), NFeLogotipoDANFE,
                                          ParSistema.NomeImpressoraNotaMercadorias, NFeVisualizarDANFE,
                                          qryNotasPagemissao.AsDateTime,
                                          qryProdutosNotasPag,
                                          NFeExecDANFE, Enviar, 'E');

                        if (qryClientesemail.AsString <> '')      and
                           (UsuarioLogin.PortaSmtp        <> '')      and
                           (UsuarioLogin.HostSmtp         <> '')      and
                           (UsuarioLogin.Email            <> '')      and
                           (UsuarioLogin.SenhaEmail       <> '')      and
                           EmailValido(qryClientesemail.AsString, false) then
                        begin
                          ShowProcessando('Enviando email para o cliente');
                          try
                            if not NFe.EnviarEmail(UsuarioLogin.Email,qryClientesemail.AsString,
                                                qryNotasPagnrdocumento.AsString, qryNotasPagserie.AsString, IntToStr(fFilialBase), '',
                                                fNomeFilialBase, fRazaoFilialBase, fCNPJFilialBase, fDDDFilialBase, fFoneFilialBase,
                                                fDDDFaxFilialBase, fFaxFilialBase, UsuarioLogin.NomeUsuario, UsuarioLogin.PortaSMTP,
                                                UsuarioLogin.HostSMTP, UsuarioLogin.UsuarioEmail, UsuarioLogin.SenhaEmail,
                                                qryNotasPagemissao.AsDateTime, qryNotasPagvalornota.AsCurrency,
                                                UsuarioLogin.AutenticarSMTP, qryNotasPagemissao.AsDateTime) then
                                  MensagemAviso('Ocorreu um erro inesperado no envio do email')
                          finally
                                ShowProcessando;
                          end;
                        end;

                      finally
                        ShowProcessando;
                      end;
                    end
                    else
                      ShowProcessando;
                  end;
                end;
              end
              else
                ShowProcessando;
            end
            else
              ShowProcessando;
          end
          else
            ShowProcessando;
        end
        else
        begin
          if not NFeVisualizarDANFE then
            MensagemAviso('Impressão da Nota Fiscal será iniciada.');
          NFe.ImprimirDanfe({ChaveAcesso+qryNotaFiscaldigchaveacesso.AsString,}
                            qryNotasPagfilial.AsString,
                            qryNotasPagserie.AsString,
                            qryNotasPagnrdocumento.AsString,
                            qryNotasPaglocalentrega_cep.AsString,
                            '',
                            IntToStr(NFeNVias), NFeLogotipoDANFE,
                            ParSistema.NomeImpressoraNotaMercadorias, NFeVisualizarDANFE,
                            qryNotasPagemissao.AsDateTime,qryProdutosNotasPag,
                            NFeExecDANFE, Enviar, 'E');
        end;
      end;

    finally
      FreeAndNil(NFe);
    end;

    if result then
      qryNotasPag.Next
    else
      break;
  end;
end;


function TdtmTrocaMercadorias.GravarParcelas: Boolean;
begin
  Result:= False;
  if qryParcelasContratos.CheckRequiredFields then begin
    qryParcelasContratosparcelaadicional.AsBoolean := True;
    qryParcelasContratos.Post;
    RecalcularParcelaOrigem;
    Result:= True;
  end;
end;

function TdtmTrocaMercadorias.IncluirParcelas(Editar: Boolean): Boolean;
begin
  Result:= False;
  if not Editar then begin
    qryParcelasContratos.Append;
    qryParcelasContratoscontrato.AsString:= qryContratosTrocanumero.AsString;
    Result:= True;
  end;
end;

procedure TdtmTrocaMercadorias.IniciarTroca;
var
  I: Integer;
begin
  // Seta os valores iniciais das variaveis utilizadas para fazer a troca.
  CancelarTroca;
  NrSelecoes       := 0;
  SetLength(NewParcelas, qryParcelasContratos.RecordCount);
  try
    FNPAberta:= 0;
    FValorAberto:= 0;
    qryParcelasContratos.First;
    for I:= 0 to qryParcelasContratos.RecordCount - 1 do begin
      if qryParcelasContratosdataPagto.AsDateTime = 0 then begin
        FValorAberto:=  FValorAberto + (qryParcelasContratosvalorvencto.AsCurrency);
        Inc(FNPAberta);
      end;
      NewParcelas[I].Registro    := qryParcelasContratosnumero.AsInteger;
      NewParcelas[I].DataVencto  := qryParcelasContratosdatavencto.AsDateTime;
      NewParcelas[I].DataPagto   := qryParcelasContratosdatapagto.AsDateTime;
      NewParcelas[I].ValorVencto := qryParcelasContratosvalorvencto.AsCurrency;
      NewParcelas[I].ValorPagto  := qryParcelasContratosvalorpagto.AsCurrency;
      qryParcelasContratos.Next;
    end;
    qryParcelasContratos.First;
  except
  end;

  ProdutoseServicos[Produtos] := nil;
  ProdutoseServicos[Servicos] := nil;

//  SetLength(Defeitos, qryProdutosContratosTroca.RecordCount);
//  SetLength(Precos  , qryProdutosContratosTroca.RecordCount);

(*
  SetLength(ProdutoseServicos[Produtos], qryProdutosContratosTroca.RecordCount);
  SetLength(ProdutoseServicos[Servicos], qryServicosContratos.RecordCount);

  try
    qryProdutosContratosTroca.First;
    for I:= 0 to (qryProdutosContratosTroca.RecordCount -1) do begin
//      Precos[I]  := qryProdutosContratosTrocaprecovenda.AsCurrency;
//      Defeitos[I]:= 0;

      ProdutoseServicos[Produtos][i].Preco := qryProdutosContratostrocaprecovenda.AsCurrency;
      ProdutoseServicos[Produtos][i].Devolver := 0;
      ProdutoseServicos[Produtos][i].icmsvalorst := qryProdutosContratostrocaicmsvalorst.AsCurrency;
      ProdutoseServicos[Produtos][i].valoripi := qryProdutosContratostrocavaloripi.AsCurrency;

      qryProdutosContratosTroca.Next;
    end;
    qryProdutosContratosTroca.First;
  except
  end;

  try
    qryServicosContratos.First;
    for I:= 0 to (qryServicosContratos.RecordCount -1) do
    begin
      ProdutoseServicos[Servicos][i].Preco := qryServicosContratosvalorservico.AsCurrency;
      ProdutoseServicos[Servicos][i].Devolver := 0;
//      Precos[Servicos][I]     := qryServicosContratosvalorservico.AsCurrency;
//      Devolver[Servicos][I]:= 0;
      qryServicosContratos.Next;
    end;
    qryServicosContratos.First;
  except
  end;

*)
//  qryValoresDevolvidos.Sql[08]:= 'contrato = :contrato';
//  RefazConsulta(qryValoresDevolvidos,[0],[qryContratosTrocanumero.AsString]);

  refazConsultapornome(qryValoresDevolvidos, ['contrato'],[qryContratosnumero.AsString]);
  refazConsultapornome(qryValoresTrocados, ['contrato'],[qryContratosnumero.AsString]);

(*
  FOldValorProdutos:= qryContratosTrocavalorprodutos.AsCurrency - qryValoresDevolvidosvalorvista.AsCurrency;
  FOldValorVista   := qryContratosTrocavalorvista.AsCurrency -  (qryValoresDevolvidosvalorvista.AsCurrency +
                                                            qryValoresDevolvidosfrete.AsCurrency      +
                                                            qryValoresDevolvidosseguro.AsCurrency     -
                                                            qryValoresDevolvidosdesconto.AsCurrency);
*)
(*
  FOldValorProdutos:= qryContratosTrocavalorprodutos.AsCurrency - (qryValoresDevolvidosvalorvista.AsCurrency +
                                                                   qryValoresDevolvidosdesconto.AsCurrency   -
                                                                   qryValoresDevolvidosfrete.AsCurrency      -
                                                                   qryValoresDevolvidosseguro.AsCurrency);

  FOldValorServicos:= qryContratostotalservicos.AsCurrency - (qryValoresDevolvidosvalorvista_s.AsCurrency   +
                                                              qryValoresDevolvidosimpostoretido_s.AsCurrency +
                                                              qryValoresDevolvidoscreditotroca_s.AsCurrency)

                                                           - (qryValoresTrocadosvalorvista_s.AsCurrency   +
                                                              qryValoresTrocadosimpostoretido_s.AsCurrency +
                                                              qryValoresTrocadoscreditotroca_s.AsCurrency);

  FOldValorImpostoRetido := qryContratosvalorimpostoretido.AsCurrency - qryValoresDevolvidosimpostoretido_s.ascurrency - qryValoresTrocadosimpostoretido_s.AsCurrency;
  fOldValorIPI :=  qryContratostotalipi.asCurrency - qryValoresDevolvidosvaloripi_p.asCurrency - qryValoresTrocadosvaloripi_p.asCurrency;
  fOldvaloricmssubstituicao := qryContratosvaloricmssubstituicao.asCurrency - qryValoresDevolvidosvaloricmssubstituicao_p.ascurrency - qryValoresTrocadosvaloricmssubstituicao_p.ascurrency;

  FOldValorVista   := qryContratosTrocavalorvista.AsCurrency - qryValoresDevolvidosvalorvista.AsCurrency;

  FOldValorFrete   := qryContratosTrocaFrete.AsCurrency      -  qryValoresDevolvidosfrete.AsCurrency;
  FOldValorSeguro  := qryContratosTrocaSeguro.AsCurrency     -  qryValoresDevolvidosseguro.AsCurrency;
  FOldValorDesconto:= qryContratosTrocadesconto.AsCurrency   -  qryValoresDevolvidosdesconto.AsCurrency;
  fOldValorCreditoTroca:= qryContratosTrocacreditotroca.AsCurrency   -  qryValoresDevolvidoscreditotroca.AsCurrency;
  FOldValorPrazo   := qryContratosTrocavalorprazo.AsCurrency -  qryValoresDevolvidosvalorprazo.AsCurrency;
*)

  FOldValorProdutos:= qryContratosTrocavalorprodutossemdesconto.AsCurrency - (qryValoresDevolvidosvalorvista_p.AsCurrency   +
                                                              qryValoresDevolvidosdesconto_p.AsCurrency     +
                                                              {qryValoresDevolvidoscreditotroca_p.AsCurrency -}
                                                              qryValoresDevolvidosfrete_p.AsCurrency        -
                                                              qryValoresDevolvidosseguro_p.AsCurrency       -
                                                              qryValoresDevolvidosvaloripi_p.AsCurrency     -
                                                              qryValoresDevolvidosvaloricmssubstituicao_p.AsCurrency

                                                              )

                                                            - (qryValoresTrocadosvalorvista_p.AsCurrency   +
                                                              qryValoresTrocadosdesconto_p.AsCurrency     +
                                                              {qryValoresTrocadoscreditotroca_p.AsCurrency -}
                                                              qryValoresTrocadosfrete_p.AsCurrency        -
                                                              qryValoresTrocadosseguro_p.AsCurrency       -
                                                              qryValoresTrocadosvaloripi_p.AsCurrency       -
                                                              qryValoresTrocadosvaloricmssubstituicao_p.AsCurrency

                                                              );

  FOldValorServicos:= qryContratosTrocatotalservicos.AsCurrency - (qryValoresDevolvidosvalorvista_s.AsCurrency   +
                                                              qryValoresDevolvidosimpostoretido_s.AsCurrency {+
                                                              qryValoresDevolvidoscreditotroca_s.AsCurrency})

                                                           - (qryValoresTrocadosvalorvista_s.AsCurrency   +
                                                              qryValoresTrocadosimpostoretido_s.AsCurrency {+
                                                              qryValoresTrocadoscreditotroca_s.AsCurrency});

  FOldValorImpostoRetido := qryContratosTrocavalorimpostoretido.AsCurrency - qryValoresDevolvidosimpostoretido_s.ascurrency - qryValoresTrocadosimpostoretido_s.AsCurrency;
  fOldValorIPI :=  qryContratosTrocatotalipi.asCurrency - qryValoresDevolvidosvaloripi_p.asCurrency - qryValoresTrocadosvaloripi_p.asCurrency;
  fOldvaloricmssubstituicao := qryContratosTrocavaloricmssubstituicao.asCurrency - qryValoresDevolvidosvaloricmssubstituicao_p.ascurrency - qryValoresTrocadosvaloricmssubstituicao_p.ascurrency;

  FOldValorFrete        := qryContratosTrocaFrete.AsCurrency        - qryValoresDevolvidosfrete_p.AsCurrency - qryValoresTrocadosfrete_p.AsCurrency;
  FOldValorSeguro       := qryContratosTrocaSeguro.AsCurrency       - qryValoresDevolvidosseguro_p.AsCurrency - qryValoresTrocadosseguro_p.AsCurrency;
  FOldValorDesconto     := qryContratosTrocadesconto.AsCurrency     - qryValoresDevolvidosdesconto_p.AsCurrency - qryValoresTrocadosdesconto_p.AsCurrency;
  FOldValorDescontoItem := qryContratosTrocavalordescontoitem.AsCurrency - qryValoresDevolvidosvalordescontoitem_p.AsCurrency - qryValoresTrocadosvalordescontoitem_p.AsCurrency;

  FOldValorCreditoTroca := qryContratosTrocacreditotroca.AsCurrency - qryValoresDevolvidoscreditotroca_p.AsCurrency - qryValoresTrocadoscreditotroca_p.AsCurrency
                                                               - qryValoresDevolvidoscreditotroca_s.AsCurrency - qryValoresTrocadoscreditotroca_s.AsCurrency;


  FOldValorVista        := qryContratosTrocavalorvista.AsCurrency   - qryValoresDevolvidosvalorvista_p.AsCurrency - qryValoresTrocadosvalorvista_p.AsCurrency
                                                               - qryValoresDevolvidosvalorvista_s.AsCurrency - qryValoresTrocadosvalorvista_s.AsCurrency;

  FOldValorPrazo        := qryContratosTrocavalorprazo.AsCurrency   - qryValoresDevolvidosvalorprazo_p.AsCurrency - qryValoresTrocadosvalorprazo_p.AsCurrency
                                                               - qryValoresDevolvidosvalorprazo_s.AsCurrency - qryValoresTrocadosvalorprazo_s.AsCurrency;

  FValorProdutos     := FOldValorProdutos;
  FValorServicos     := FOldValorServicos;
  FValorImpostoRetido := FOldValorImpostoRetido;
  FValorIPI := FOldValorIPI;
  Fvaloricmssubstituicao := FOldvaloricmssubstituicao;

  FValorVista        := FOldValorVista;
  FValorFrete        := FOldValorFrete;
  FValorSeguro       := FOldValorSeguro;
  FValorDesconto     := FOldValorDesconto;
  FValorDescontoItem     := FOldValorDescontoItem;

  FValorCreditoTroca := FOldValorCreditoTroca;
  FValorPrazo        := FOldValorPrazo;


//  FValorDevolvido  := 0;


  RefazConsultaPorNome(qryProdutosContratosDevolvidos,
                       ['contrato'],
                       [qryContratosnumero.AsString]);

  RefazConsultaPorNome(qryServicosContratosDevolvidos,
                       ['contrato'],
                       [qryContratosnumero.AsString]);

  CalcularPrestacoesReais;
end;

procedure TdtmTrocaMercadorias.LimparTabelas;
begin
//  CancelarDevolucao;
  ReFazConsulta(qryProdutosContratosTroca,  [0,1,2,3,4],[0,false,'','','']);
  ReFazConsulta(qryParcelasContratos,        [0],        ['']);
  ReFazConsulta(qryParcelasAbertas,          [0],        ['']);
  ReFazConsulta(qryContratosTroca,                [0],        ['']);
  ReFazConsulta(qryContratosPorCliente,    [0,1],      [0,'']);
end;


procedure TdtmTrocaMercadorias.PreencherNotaFiscal(TipoNota: TtecTipoNota);
var
  v_Desconto,
  v_DescontoItem,
  v_Seguro,
  v_Frete,
  v_ValorProd,
  v_ValorNota: Currency;
  i: integer;
  vAchou : Boolean;

begin

  {preferencia em não usar o locate mas varrer toda a tabela (apresentadno probelam de duplicão de entrada de nota e produtos (+ de 1 vez...) )}
  qryNotasPag.first;
  for i := 1 to qrynotaspag.recordcount do
  begin

    if (qryNotasPagnrdocumento.AsInteger = Ord(TipoNota)) and
       (qryNotasPagnrdocumento.asString<>'') then
    begin
      vAchou := True;
      break;
    end
    else
      qrynotaspag.next;
  end;


  if not vAchou then
    qryNotasPag.Append
  else
    qryNotasPag.edit;

  case tiponota of

    tnDEVOLUCAO_COMCONTRATO:
    begin
      dsrClientedaNotadeEntrada.dataset := qryContratosPorCliente;

      if FUnicoContrato<>'' then
      begin
        qryNotasPagcontrato.AsString     := FUnicoContrato;
        qryNotasPagobservacoes.AsString  := qryContratosTrocaconsideracoes.AsString;
      end;
    end;

    tnDEVOLUCAO_SEMCONTRATO:
    begin
      if parsistema.IncluirOrcamentonosItensdaTroca then
        dsrClientedaNotadeEntrada.dataset := qryOrcamentos
      else
        dsrClientedaNotadeEntrada.dataset := qryContratos;
    end;

  end;

  qryNotasPagvendedor.AsVariant := qryProdutosTrocadosvendedordadofiscal.asVariant;

  qryNotasPagserie.AsString := SerieSugestao;
  qryNotasPagnrdocumento.AsInteger := Ord(TipoNota);
  qryNotasPagcodigo.AsInteger := Ord(TipoNota);

  qryNotasPagfornecedor.AsInteger       := dsrClientedaNotadeEntrada.DataSet.FieldByName('cliente').AsInteger;
  qryNotasPagtipofornecedor.AsString    := dsrClientedaNotadeEntrada.DataSet.FieldByName('tipocliente').AsString;


  qryNotasPagestado.AsString            := dsrClientedaNotadeEntrada.DataSet.FieldByName('estado').AsString;
  qryNotasPagcnpj.AsString              := dsrClientedaNotadeEntrada.DataSet.FieldByName('pessoanumero').AsString;
  qryNotasPagEstrangeiro.AsBoolean      := dsrClientedaNotadeEntrada.DataSet.FieldByName('estrangeiro').AsBoolean;

  qryNotasPagpessoatipo.AsString        := dsrClientedaNotadeEntrada.DataSet.FieldByName('pessoatipo').AsString;

  qryNotasPaginscricaoestadual.AsString := dsrClientedaNotadeEntrada.DataSet.FieldByName('iddocumento').AsString;
  qryNotasPagclientecontribicms.AsBoolean := dsrClientedaNotadeEntrada.DataSet.FieldByName('contribicms').AsBoolean;
  qryNotasPagcontribicmsemitente.AsBoolean := Contribicms;
  {dsrClientedaNotadeEntrada.DataSet.FieldByName('contribicmsemitente').AsBoolean;}

  qryNotasPagconsumidorfinal.asBoolean := dsrClientedaNotadeEntrada.DataSet.FieldByName('vendaconsumidorfinal').AsBoolean;

  qryNotasPagfilial.AsInteger           := FilialBase;
  qryNotasPagdata.AsDateTime            := DataServidor;
  qryNotasPagemissao.AsDateTime         := DataServidor;

  qryNotasPagpermitirimprimir.AsBoolean := True;
  qryNotasPagsituacao.AsString := 'N';

  qryNotasPagnome.AsString              := dsrClientedaNotadeEntrada.DataSet.FieldByName('nome').AsString;
  qryNotasPagfoneddd.AsString           := dsrClientedaNotadeEntrada.DataSet.FieldByName('foneddd').AsString;
  qryNotasPagfonenumero.AsString        := dsrClientedaNotadeEntrada.DataSet.FieldByName('fonenumero').AsString;

  if dsrContratos.DataSet.FieldByName('estado').AsString = '.' then {estrangeiro}
  begin
    qryNotasPagpais.asstring           := dsrClientedaNotadeEntrada.DataSet.FieldByName('cidadeibge').asstring;
    qryNotasPagnomepais.AsString       := dsrClientedaNotadeEntrada.DataSet.FieldByName('nomecidade').AsString;
    qryNotasPagrua.AsString            := dsrClientedaNotadeEntrada.DataSet.FieldByName('rua').AsString;

    if parsistema.IncluirOrcamentonosItensdaTroca and (dsrClientedaNotadeEntrada.dataset.name = 'qryOrcamentos') then
    begin
      qryNotasPagendnumero.AsString      := dsrClientedaNotadeEntrada.DataSet.FieldByName('numero').AsString;
      qryNotasPagendcomplemento.AsString := dsrClientedaNotadeEntrada.DataSet.FieldByName('complemento').AsString;
    end
    else
    begin
      qryNotasPagendnumero.AsString      := dsrClientedaNotadeEntrada.DataSet.FieldByName('endnumero').AsString;
      qryNotasPagendcomplemento.AsString := dsrClientedaNotadeEntrada.DataSet.FieldByName('endcomplemento').AsString;
    end;
    qryNotasPagcidade.AsString         := dsrClientedaNotadeEntrada.DataSet.FieldByName('bairro').AsString;
    qryNotasPagnomecidade.AsString     := dsrClientedaNotadeEntrada.DataSet.FieldByName('nomebairro').AsString;
    qryNotasPagestado.AsString         := dsrClientedaNotadeEntrada.DataSet.FieldByName('estado').AsString;
  end
  else
  begin
    qryNotasPagpais.AsInteger          := 1058;
    qryNotasPagnomepais.AsString       := 'Brasil';
    qryNotasPagrua.AsString            := dsrClientedaNotadeEntrada.DataSet.FieldByName('rua').AsString;

    if parsistema.IncluirOrcamentonosItensdaTroca and (dsrClientedaNotadeEntrada.dataset.name = 'qryOrcamentos') then
    begin
      qryNotasPagendnumero.AsString      := dsrClientedaNotadeEntrada.DataSet.FieldByName('numero').AsString;
      qryNotasPagendcomplemento.AsString := dsrClientedaNotadeEntrada.DataSet.FieldByName('complemento').AsString;
    end
    else
    begin
      qryNotasPagendnumero.AsString      := dsrClientedaNotadeEntrada.DataSet.FieldByName('endnumero').AsString;
      qryNotasPagendcomplemento.AsString := dsrClientedaNotadeEntrada.DataSet.FieldByName('endcomplemento').AsString;
    end;
    qryNotasPagbairro.AsString         := dsrClientedaNotadeEntrada.DataSet.FieldByName('bairro').AsString;
    qryNotasPagnomebairro.AsString     := dsrClientedaNotadeEntrada.DataSet.FieldByName('nomebairro').AsString;
    qryNotasPagcidade.AsString         := dsrClientedaNotadeEntrada.DataSet.FieldByName('cidade').AsString;
    qryNotasPagnomecidade.AsString     := dsrClientedaNotadeEntrada.DataSet.FieldByName('nomecidade').AsString;
    qryNotasPagcidadeibge.AsString     := dsrClientedaNotadeEntrada.DataSet.FieldByName('cidadeibge').AsString;
    qryNotasPagestado.AsString         := dsrClientedaNotadeEntrada.DataSet.FieldByName('estado').AsString;
    qryNotasPagcep.Asstring            := dsrClientedaNotadeEntrada.DataSet.FieldByName('cep').AsString;
  end;



  v_Desconto  := 0;
  v_DescontoItem  := 0;
  v_Seguro    := 0;
  v_Frete     := 0;
  v_ValorProd := 0;
  v_ValorNota := 0;

  case TipoNota of

    tnDEVOLUCAO_COMCONTRATO:
    begin
      qryContratosDevolvidos.First;
      while not qryContratosDevolvidos.Eof do
      begin
        if qryContratosDevolvidossituacao.AsString = 'N' then
        begin
{          if (((TipoNota = tnDEVOLUCAO_COMCONTRATO) and NotaNormal(qryContratosDevolvidosincidencia.AsString)) or
              ((TipoNota = tnDEVOLUCAOSUBSTTRIB_COMCONTRATO) and NotaSubstituicao(qryContratosDevolvidosincidencia.AsString))) then} begin
              v_Desconto  := v_Desconto  + qryContratosDevolvidosdesconto.AsCurrency;
              v_DescontoItem  := v_DescontoItem  + qryContratosDevolvidosvalordescontoitem.AsCurrency;
              v_Seguro    := v_Seguro    + qryContratosDevolvidosseguro.AsCurrency;
              v_Frete     := v_Frete     + qryContratosDevolvidosfrete.AsCurrency;
              v_ValorProd := v_ValorProd + qryContratosDevolvidosvalorvista.AsCurrency +
                                       qryContratosDevolvidosdesconto.AsCurrency +
                                       qryContratosDevolvidosvalordescontoitem.AsCurrency -
                                       qryContratosDevolvidosfrete.AsCurrency -
                                       qryContratosDevolvidosseguro.AsCurrency;
              v_ValorNota := v_ValorNota + qryContratosDevolvidosvalorprazo.AsCurrency;
          end;
        end;
        qryContratosDevolvidos.Next;
      end;
    end;

    tnDEVOLUCAO_SEMCONTRATO :
    begin
      qryNotasPag.Post;
      qryProdutosNotasPag.First;
      while not qryProdutosNotasPag.Eof do
      begin
        if (qryProdutosNotasPagcodigonota.AsInteger = ord(tiponota)) and (qryProdutosNotasPagcodigonota.AsString<>'') then
          v_ValorProd := v_ValorProd + (qryProdutosNotasPagquantidade.AsCurrency * qryProdutosNotasPagPrecoVenda.AsCurrency);
        qryProdutosNotasPag.Next;
      end;
      v_ValorNota := v_ValorProd;
    end;

  end;


  // VALOR VISTA = TOTAL PRODUTOS + FRETE + SEGURO - DESCONTO

  qryNotasPag.Edit;
  qryNotasPagdesconto.AsCurrency        := Truncar(v_Desconto,2);
  qryNotasPagdescontoitem.AsCurrency        := Truncar(v_DescontoItem,2);

  qryNotasPagfreteinterno.AsCurrency    := Truncar(v_Frete,2);
  qryNotasPagseguro.AsCurrency          := Truncar(v_Seguro,2);
  qryNotasPagvalornota.AsCurrency       := Truncar(v_ValorNota,2);
  qryNotasPagtotalprodutos.AsCurrency   := Truncar(v_ValorProd,2);
  qryNotasPagacrescimo.AsCurrency       := Truncar(v_ValorNota - (v_ValorProd + v_Frete + v_Seguro - v_Desconto - v_DescontoItem),2);
  qryNotasPag.Post;

  if qryProdutosNotasPag.Locate('codigonota', ord(tiponota), []) then
  begin
    qryNotasPag.Edit;
    qryNotasPagcodigonatureza.asinteger := qryProdutosNotasPagnatureza.AsInteger;
    qryNotasPagcodigofiscal.AsInteger   := qryProdutosNotasPagcodigofiscal.AsInteger;
    qryNotasPagnaoutilizarobsautomaticas.asboolean := qryProdutosNotasPagnaoutilizarobsautomaticas.AsBoolean;

    if qryProdutosNotasPagexigenotareferenciada.AsBoolean and (qryProdutosNotasPagdadofiscal.AsInteger<>0) then
      qryNotasPagdadofiscalreferenciado.AsInteger := qryProdutosNotasPagdadofiscal.AsInteger
    else
      qryNotasPagdadofiscalreferenciado.clear;

    if qryNaturezasPadrao_.Locate('natureza', qryProdutosNotasPagnatureza.AsInteger, []) then
      qryNotasPagnatureza.AsString := qryNaturezasPadrao_.fieldbyname('descricaonatureza').AsString;
    qryNotasPag.Post;
  end;


  vListaNumeroSeries := '';
  qryprodutosnotaspagseries.first;
  while not qryprodutosnotaspagseries.eof do
  begin
    vListaNumeroSeries := vListaNumeroSeries + 'Item: '+qryprodutosnotaspagseriesCodigoVisual.asString + ' Série: '+qryprodutosNotasPagSeriesnumeroserie.asString + ' ';
    qryprodutosnotaspagseries.next;
  end;

  if vListaNumeroSeries <> '' then
    qryNotasPagitensnumeroseries.asString := vListaNumeroSeries
  else
    qryNotasPagitensnumeroseries.clear;


end;

procedure TdtmTrocaMercadorias.qryProcuraClienteSelecaoAfterClose(DataSet: TDataSet);
begin
  inherited;
  LimparTabelas;
end;

procedure TdtmTrocaMercadorias.qryProcuraClienteSelecaoBeforeOpen(DataSet: TDataSet);
begin
  inherited;
  if (qryProcuraClienteSelecao.Params[1].AsString = '') then
    qryProcuraClienteSelecao.Params[1].AsString:= 'C';
end;

procedure TdtmTrocaMercadorias.qryContratosPorClienteAfterScroll(DataSet: TDataSet);
begin
  inherited;
  if not qryContratosPorCliente.IsEmpty then
  begin
    if Assigned(FAfterScrollContratosClientes) then
      FAfterScrollContratosClientes(qryContratosPorCliente);
    ReFazConsultaTabelas;
    IniciarTroca;
    AtribuirTrocaEfetuada(True);
  end;
  DefinicaodeParametrosVerificada := false;
end;

procedure TdtmTrocaMercadorias.qryParcelasContratosBeforeDelete(DataSet: TDataSet);
begin
  if qryParcelasContratosnumero.AsInteger <> 0 then begin
    MensagemAviso(ctPARCELANAOPODESEREXCLUIDA);
    Abort;
  end;
end;

procedure TdtmTrocaMercadorias.qryParcelasContratosNewRecord(DataSet: TDataSet);
begin
  inherited;
  qryParcelasContratoscontrato.AsString     := qryContratosTrocanumero.AsString;
end;

procedure TdtmTrocaMercadorias.qryProdutosContratosTrocaAfterInsert(DataSet: TDataSet);
begin
  inherited;
  qryProdutosContratosTroca.Cancel;
end;

procedure TdtmTrocaMercadorias.qryProdutosContratosTrocaAfterScroll(DataSet: TDataSet);
begin
  inherited;
  // Só permite alterar o preço se marcar o produto como avariado.
  qryProdutosContratosTrocaprecovenda.ReadOnly := //not ((qryProdutosContratosTrocaDevolver.AsInteger = 0) and
                                                   not qryProdutosContratosTrocadefeito.AsBoolean;

  // Se a devolução for total, ou produto igual a brinde ou a quantidade cancelada for iagual
  //a quantidade de produtos vendidos não pernite alterar a quantidade a ser devolvida.
  qryProdutosContratosTrocaDevolver.ReadOnly   := //CancelarTotal or XX-Jander
                                             qryProdutosContratosTrocabrinde.AsBoolean or
                                             (qryProdutosContratosTrocacancelado.AsCurrency = qryProdutosContratosTrocaquantidade.AsCurrency);
  qryProdutosContratosTrocaqtdeentregueParaDevolver.ReadOnly:= qryProdutosContratosTrocaDevolver.ReadOnly;

  // a definição da filial deve ser antes da indicação da quantidade a devolver devido a forma como esta implementado
  qryProdutosContratosTrocafilialmovimentacao.readonly := qryProdutosContratosTrocadevolver.asfloat > 0;

  if Assigned(OnScrollLinhaColunaGrade) then
   OnScrollLinhaColunaGrade(qryProdutosContratosTroca);

end;

function TdtmTrocaMercadorias.Qtde_Entregue: Real;
begin
  Result:= qryProdutosContratosTrocaqtdeentregue.AsCurrency - qryProdutosContratosTrocacancelado.AsCurrency;
end;

function TdtmTrocaMercadorias.Qtde_A_Devolver: Real;
begin
  Result:= qryProdutosContratosTrocaDevolver.AsCurrency;
end;

function TdtmTrocaMercadorias.ReFazConsultaContratosPorCliente: Boolean;
begin
  ReFazConsulta(qryContratosPorCliente,[0,1],[qryProcuraClienteSelecaocodigo.AsInteger, qryProcuraClienteSelecaotipo.AsString]);
  Result:= qryContratosPorCliente.IsEmpty;
  if Result then begin
    ReFazConsulta(qryContratosTroca,              [0],        ['']);
    ReFazConsulta(qryProdutosContratosTroca, [0,1,2,3,4], [0, false,'','','']);
    ReFazConsulta(qryParcelasContratos,      [0],        ['']);
    ReFazConsulta(qryParcelasAbertas,        [0],        ['']);
  end;
end;

procedure TdtmTrocaMercadorias.ReFazConsultaTabelas;
begin
  if (qryContratosPorClientenumero.AsString<>'') then
  begin
    ReFazConsulta(TTecQuery(dsrContratos.dataset), [0],[qryContratosPorClientenumero.AsString]);

    ReFazConsulta(qryContratosTroca,          [0],[qryContratosPorClientenumero.AsString]);
    ReFazConsultapornome(qryProdutosContratosTroca,['filialvirtual','filialdevolucao','estado','primogenito','contrato'],
                            [(TipoFilial='V'), FilialBase,
                            qryProcuraClienteSelecaoestado.AsString,
                            ifthen(qryContratosPorClienteprimogenito.AsString <> '', qryContratosPorClienteprimogenito.AsString, qryContratosPorClientenumero.AsString),
                            qryContratosPorClientenumero.AsString]);

    ReFazConsultapornome(qryServicosContratos,['contrato'],[qryContratosPorClientenumero.AsString]);

    ReFazConsultapornome(qryProdutosSeries, ['contrato'], [qryContratosPorClientenumero.AsString]);
    ReFazConsultapornome(qryProdutosContratosSeries, ['contrato'], [qryContratosPorClientenumero.AsString]);
    

    ReFazConsulta(qryParcelasContratos,  [0],[qryContratosTrocanumero.AsString]);
    ReFazConsulta(qryParcelasAbertas,    [0],[qryContratosPorClientenumero.AsString]);
  end;
  ApagarprodutosTrocados; //Temporaria p/ somente um contrato alto lá João
end;

procedure TdtmTrocaMercadorias.Selecionar(tipoConsulta: TtecContratoTipoConsulta);
begin
  case tipoConsulta of
   ctcCLIENTESTROCA:
    begin
     qryProcuraClienteSelecao.Params[1].AsString:= qryConsultaClientestipoorig.AsString;
     ReFazConsulta(qryProcuraClienteSelecao,[0],[qryConsultaClientescodigo.AsInteger])
    end;
   ctcCLIENTES : SelecionarCliente;
   ctcVENDEDOR : dsrContratos.DataSet.FieldByName('vendedor').AsInteger := qryConsultaVendedorescodigo.AsInteger;
  end;
end;

procedure TdtmTrocaMercadorias.SetarProdutoComDefeito;
begin
  // Marcar o produto como avariado se a quantidade entregue (nota) menos a quantidade
  // cancelado (devolução) for maior que zero.
  if (qryProdutosContratosTrocaqtdeentregueParaDevolver.AsCurrency > 0) then begin
    qryProdutosContratosTroca.Edit;
    qryProdutosContratosTrocadefeito.AsBoolean:= not qryProdutosContratosTrocadefeito.AsBoolean;
    if not qryProdutosContratosTrocadefeito.AsBoolean then
      qryProdutosContratosTrocaprecovenda.AsCurrency := qryProdutosContratosTrocaprecovendaaux.AsCurrency {ProdutoseServicos[Produtos][qryProdutosContratosTroca.CurRec].preco};
    if qryProdutosContratosTroca.State = dsedit then
      qryProdutosContratosTroca.Post;
    qryProdutosContratosTrocaAfterScroll(qryProdutosContratosTroca);
  end
  else
    MensagemAviso(ctPRODUTOAINDANAOENTREGUE);
end;

