   Result:= (qryProdutosContratos.State = dsInsert);
end;

procedure TdtmTrocaMercadorias.SetVendedorDefault(const Value: Integer);
begin
  if FVendedorDefault <> Value then
    FVendedorDefault:= Value;
end;

procedure TdtmTrocaMercadorias.SelecionarCliente;
begin
  if qryConsultaClientes.RecordCount > 0 then
  begin
    RefazConsulta(qryProcuraCliente, [0,1],
       [qryConsultaClientescodigo.AsVariant,
       qryConsultaClientestipoorig.AsVariant]);

    if parsistema.IncluirOrcamentonosItensdaTroca then
    begin
      if qryOrcamentos.State = dsBrowse then
        qryOrcamentos.Edit;

      qryOrcamentostipocliente.AsString := qryConsultaClientestipoorig.AsString;
      qryOrcamentoscliente.AsInteger := qryConsultaClientescodigo.AsInteger;
    end
    else
    begin
      if qryContratos.State = dsBrowse then
        qryContratos.Edit;

      qryContratostipocliente.AsString := qryConsultaClientestipoorig.AsString;
      qryContratoscliente.AsInteger := qryConsultaClientescodigo.AsInteger;
    end;

    if qryConsultaClientestipoorig.AsString = 'C' then
      RefazConsulta(qryClientes, [0], [qryConsultaClientescodigo.AsInteger])
    else if qryConsultaClientestipoorig.AsString = 'F' then
      ReFazConsulta(qryFornecedores, [0], [qryConsultaClientescodigo.AsInteger]);

  end;
end;

procedure TdtmTrocaMercadorias.CalcularValorAVista;
begin
    dsrContratos.dataset.fieldbyname('valorprazo').AsCurrency := dsrContratos.dataset.fieldbyname('totalprodutos').AsCurrency +
                                         dsrContratos.dataset.fieldbyname('frete').AsCurrency +
                                         dsrContratos.dataset.fieldbyname('seguro').AsCurrency -
                                         dsrContratos.dataset.fieldbyname('desconto').AsCurrency;

    dsrContratos.dataset.fieldbyname('valorvista').AsCurrency := dsrContratos.dataset.fieldbyname('valorprazo').AsCurrency;
end;

{
procedure TdtmTrocaMercadorias.MontarListaGrupos(var Grupos: vstring);
var
  Produtos: String;
  Pos: TBookmark;
  a: Integer;
begin
  if qryProdutosContratos.State <> dsInactive then begin
    Pos := qryProdutosContratos.GetBookmark;
    qryProdutosContratos.DisableControls;
    Produtos := '';
    try
      qryProdutosContratos.First;
      while Not qryProdutosContratos.Eof do begin
        Produtos := Produtos + qryProdutosContratosproduto.AsString + ',';
        qryProdutosContratos.Next;
      end;
      if qryProdutosContratos.RecordCount > 0 then
        Produtos := Copy(Produtos, 1, Length(Produtos) - 1);
    finally
      qryProdutosContratos.GotoBookmark(Pos);
      qryProdutosContratos.FreeBookmark(Pos);
      qryProdutosContratos.EnableControls;
    end;
    if Produtos = '' then
      Grupos := nil
    else begin
      qryGruposDeProdutos.Sql[5] := Produtos;
      qryGruposDeProdutos.Open;
      SetLength(Grupos, qryGruposDeProdutos.RecordCount);
      try
        a := 0;
        while Not qryGruposDeProdutos.Eof do begin
          Grupos[a] := qryGruposDeProdutoscodigo.AsString;
          qryGruposDeProdutos.Next;
          Inc(a)
        end
      finally
        qryGruposDeProdutos.Close
      end
    end
  end
end;
}

function TdtmTrocaMercadorias.GetTotalProdutos: Currency;
begin
   Result := qryContratostotalprodutos.AsFloat
end;

procedure TdtmTrocaMercadorias.dsrProdutosContratosDataChange(
  Sender: TObject; Field: TField);
begin
  inherited;
  if Field = dsrProdutosContratos.DataSet.FieldByname('filial') then
  begin
    if (dsrProdutosContratos.DataSet.FieldByname('filial').AsInteger = 0) or ParSistema.FiliaisIndependentes then
    begin
      qryProcuraProduto.MacroByName('filialsaida').AsString := IntToStr(ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual));
      qryProcuraProduto.ParamByName('FilialPreco').AsString := IntToStr(ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual));
    end
    else
    begin
      qryProcuraProduto.MacroByName('filialsaida').AsString := dsrProdutosContratos.DataSet.FieldByname('filial').AsString;
      if ParSistema.UtilizarPrecoFilialBase then
        qryProcuraProduto.ParamByName('FilialPreco').AsString := IntToStr(ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual))
      else
        qryProcuraProduto.ParamByName('FilialPreco').AsString := dsrProdutosContratos.DataSet.FieldByname('filial').AsString;;
    end;

    ReFazConsulta(qryProcuraReservaProduto,[2,3],[IntToStr(TLargeintField(dsrprodutoscontratos.DataSet.FieldByName('produto')).AsLargeInt),
                                                    dsrProdutosContratos.DataSet.FieldByname('filial').AsInteger]);

    ReFazConsulta(qryConsultaReservasProduto,[1,2],[IntToStr(TLargeintField(dsrprodutoscontratos.DataSet.FieldByName('produto')).AsLargeInt),
                                                    dsrProdutosContratos.DataSet.FieldByname('filial').AsInteger]);

    if ParSistema.UtilizarPrecoFilialBase then
      RefazConsulta(qryProdutoEstoque,[2,1,5],[ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual),
                                               IntToStr(TLargeintField(dsrprodutoscontratos.DataSet.FieldByName('produto')).AsLargeInt),
                                                    dsrProdutosContratos.DataSet.FieldByname('filial').AsInteger])
    else
      RefazConsulta(qryProdutoEstoque,[2,1,5],[dsrProdutosContratos.DataSet.FieldByname('filial').AsInteger,
                                               IntToStr(TLargeintField(dsrprodutoscontratos.DataSet.FieldByName('produto')).AsLargeInt),
                                                    dsrProdutosContratos.DataSet.FieldByname('filial').AsInteger]);

//    qryProdutosContratosreservado.AsCurrency := qryProdutoEstoquereservado.AsCurrency;
//    qryProdutosContratosfuturo.AsCurrency    := qryProdutoEstoquefuturo.AsCurrency;
    dsrProdutosContratos.DataSet.FieldByname('precovenda').AsFloat   := qryProdutoEstoquepreco.AsFloat;
    dsrProdutosContratos.DataSet.FieldByname('precotabela').AsFloat  := qryProdutoEstoquepreco.AsFloat;

    if qryProcuraReservaProduto.RecordCount = 0 then
      if dsrProdutosContratos.DataSet.FindField('reserva')<> nil then
         dsrProdutosContratos.DataSet.FieldByName('reserva').Clear

  end else
    if Field = dsrProdutosContratos.DataSet.FieldByname('produto') then
    begin
       RefazConsulta(qryEstoque,[0],[IntToStr(TLargeintField(dsrprodutoscontratos.DataSet.FieldByName('produto')).AsLargeInt)]);
       qryConsultaFilialProduto.Params[0].AsString    := IntToStr(TLargeintField(dsrprodutoscontratos.DataSet.FieldByName('produto')).AsLargeInt);
       qryProcuraFilialProduto.Params[1].AsString     := IntToStr(TLargeintField(dsrprodutoscontratos.DataSet.FieldByName('produto')).AsLargeInt);

       dsrprodutoscontratos.DataSet.FieldByName('montagemoriginal').AsBoolean := qryProcuraProdutomontagem.AsBoolean;
       dsrprodutoscontratos.DataSet.FieldByName('promocao').AsBoolean:= qryProcuraProdutopromocao.AsBoolean;
       dsrprodutoscontratos.DataSet.FieldByName('caracteristica').AsString := qryProcuraProdutocaracteristica.AssTRING;

       if qryProcuraProdutomontagem.AsBoolean then
          dsrprodutoscontratos.DataSet.FieldByName('montagem').AsString := 'S'
      else
          dsrprodutoscontratos.DataSet.FieldByName('montagem').AsString := 'N';

      dsrprodutoscontratos.DataSet.FieldByName('descricao').AsString      := qryProcuraProdutodescricao.AsString;
      dsrprodutoscontratos.DataSet.FieldByName('valorgrade1').AsString    := qryProcuraProdutovalorgrade1.AsString;
      dsrprodutoscontratos.DataSet.FieldByName('valorgrade2').AsString    := qryProcuraProdutovalorgrade2.AsString;
      dsrprodutoscontratos.DataSet.FieldByName('linha').AsString          := qryProcuraProdutolinha.AsString;
      dsrprodutoscontratos.DataSet.FieldByName('coluna').AsString         := qryProcuraProdutocoluna.AsString;
      dsrprodutoscontratos.DataSet.FieldByName('unidade').AsString        := qryProcuraProdutounidade.AsString;
      dsrprodutoscontratos.DataSet.FieldByName('brinde').AsBoolean        := qryProcuraProdutobrinde.AsBoolean;
      dsrprodutoscontratos.DataSet.FieldByName('filial').AsVariant        := qryProcuraProdutofilial.AsVariant;
      dsrprodutoscontratos.DataSet.FieldByName('vendasemestoque').AsString:= qryProcuraProdutovendasemestoque.AsString;
      dsrprodutoscontratos.DataSet.FieldByName('composto').AsBoolean := qryProcuraProdutocomposto.asboolean;

      if ParSistema.UtilizarPrecoFilialBase then
        RefazConsulta(qryProdutoEstoque,[2,1,5],[ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual),
                                                 IntToStr(TLargeintField(dsrprodutoscontratos.DataSet.FieldByName('produto')).AsLargeInt),
                                                 dsrprodutoscontratos.DataSet.FieldByName('filial').AsInteger])
      else
        RefazConsulta(qryProdutoEstoque,[2,1,5],[dsrprodutoscontratos.DataSet.FieldByName('filial').AsInteger,
                                                 IntToStr(TLargeintField(dsrprodutoscontratos.DataSet.FieldByName('produto')).AsLargeInt),
                                                 dsrprodutoscontratos.DataSet.FieldByName('filial').AsInteger]);

//      qryProdutosContratosreservado.AsCurrency  := qryProdutoEstoquereservado.AsCurrency;
//      qryProdutosContratosfuturo.AsCurrency     := qryProdutoEstoquefuturo.AsCurrency;

      dsrProdutosContratos.DataSet.FieldByname('precovenda').AsFloat   := qryProdutoEstoquepreco.AsFloat;
      dsrProdutosContratos.DataSet.FieldByname('precotabela').AsFloat  := qryProdutoEstoquepreco.AsFloat;

      dsrProdutosContratos.DataSet.FieldByname('aliquotaicms').AsFloat  := qryProcuraProdutoaliquotaicms.AsFloat;
      dsrProdutosContratos.DataSet.FieldByname('aliquotaipi').AsFloat   := qryProcuraProdutoaliquotaipi.AsFloat;

      if ParSistema.MostrarSimilaresContrato then
        ReFazConsulta(qryProdutosSimilares,[0,1],[IntToStr(TLargeintField(dsrprodutoscontratos.DataSet.FieldByName('produto')).AsLargeInt), ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual)]);
  end;
end;

