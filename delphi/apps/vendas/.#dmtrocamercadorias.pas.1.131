procedure TdtmTrocaMercadorias.qryProdutosContratosNewRecord(
  DataSet: TDataSet);
begin
  inherited;
  qryEstoque.Close;
  qryProcuraProduto.ParamByName('filialbase').AsString := IntToStr(ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual));
  qryProcuraProduto.MacroByName('filialsaida').AsString := IntToStr(ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual));
  qryProcuraProduto.ParamByName('FilialPreco').AsString := IntToStr(ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual));
  qryProdutosContratosmontagem.AsString  := 'N';
  qryProdutosContratosentrega.AsString   := 'N';
  qryProdutosContratosprodutolista.AsBoolean:= (qryContratoslistacasamento.AsInteger > 0);
  if VendedorDefault > 0 then
    qryProdutosContratosvendedor.AsInteger := VendedorDefault;
  if ParSistema.ValordaQuantidade>0 then
  qryProdutosContratosquantidade.AsCurrency := ParSistema.ValordaQuantidade;

