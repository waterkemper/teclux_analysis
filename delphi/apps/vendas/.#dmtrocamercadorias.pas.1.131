const
   SQLEstoquesDeposito = ' and  (filial in (Select codigo ' +
                                           ' From filiais '+
                                           ' Where (tipofilial = ''D''))) ';
const
  Produtos = 1;
  Servicos = 2;
                                           
var
  dtmTrocaMercadorias: TdtmTrocaMercadorias;
{  Precos       : Array of Currency;}
{  Defeitos     : Array of Currency;}

