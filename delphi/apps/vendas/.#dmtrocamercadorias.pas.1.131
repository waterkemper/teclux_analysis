function TdtmTrocaMercadorias.ExisteProduto(NomeCampo: String;
  Value: Variant): Boolean;
begin
  qryConsultaProdutos.Close;
  if ParSistema.UsarConsultaInterativa then
    Result := ExisteCodigo(qryConsultaProdutos, NomeCampo, Value)
  else begin
    if Value = '' then
      qryConsultaProdutos.MacroByName('Produto').AsString := ''
    else
      qryConsultaProdutos.MacroByName('Produto').AsString := ' and (Maiusculo(' + NomeCampo + ') ilike Maiusculo(''' + Value + '%''))';
    qryConsultaProdutos.Open;
    Result := qryConsultaProdutos.RecordCount > 0;
  end;
end;

function TdtmTrocaMercadorias.ExisteFilialProduto(NomeCampo: String;
  Value: Variant): Boolean;
