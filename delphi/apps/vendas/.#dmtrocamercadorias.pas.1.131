  CadastroContratos: TdtmCadastroContratos;

implementation

uses fmdadosfiscaiscontratos, fmVisualizarProdutosContratosSeriesaDevolver,
     fmdefinirparametrosdevolucao,
     fmclientescontrato, fmenquete;

{$R *.dfm}

{ TdtmTrocaMercadorias }

var
  aProdFilial: array of record
    Prod,
    Filial: String
  end;


function TdtmTrocaMercadorias.AlterarParcelamento: Boolean;
var
  Pos         : TBookmark;
  A,NR        : Integer;
  Valor,
  Faltam,
  Diferenca,
  TotalAberto : Currency;
  CParcelas   : Array of Variant;

begin
  Result:= False;
  if ContratoPodeDevolver then begin
    {
    qryParcelasContratos.DisableControls;
    try
      TotalAberto := 0;
      for a:= 0 to Length(NewParcelas)-1 do begin
        if NewParcelas[A].DataPagto = 0 then
          TotalAberto:= TotalAberto + NewParcelas[A].ValorVencto;
      end;

      if FValorAberto = 0 then
           Diferenca:= FOldValorPrazo - (FPagoVencto - FDevolveVencto)
      else Diferenca:= FOldValorPrazo - ((FValorAberto + FPagoVencto) - FDevolveVencto);
      FValorDevolvido:= Diferenca;

       Devolucao Numerario
      NR:= qryParcelasContratos.RecordCount;
      if (Diferenca > TotalAberto) then begin
        Faltam := Diferenca - TotalAberto;
        qryParcelasContratos.First;
        while not (qryParcelasContratos.Eof) {and (Faltam > 0) and (qryParcelasContratosdatapagto.AsDateTime <> 0)} {do begin
          if (Faltam > 0) and (qryParcelasContratosdatapagto.AsDateTime <> 0) then begin
            if ((qryParcelasContratostipopagto.AsString = '') or (qryParcelasContratostipopagto.AsString = 'B')) then begin
              if (qryParcelasContratosvalorvencto.AsCurrency > Faltam) then begin
                // Desmembrar parcela.

                SetLength(CParcelas,qryParcelasContratos.FieldCount);
                for A:= 0 to qryParcelasContratos.FieldCount - 1 do
                  CParcelas[A]:= qryParcelasContratos.Fields[A].AsVariant;

                qryParcelasContratos.Edit;
                qryParcelasContratosvalorvencto.AsCurrency := Faltam;
                qryParcelasContratosvalorpagto.AsCurrency  := Faltam + qryParcelasContratosJuros.AsCurrency;
                qryParcelasContratostipopagto.AsString     := 'D';
                qryParcelasContratosdeventrada.AsDateTime  := DataServidor;
                qryParcelasContratos.Post;

                Inc(NR);
                Pos:= qryParcelasContratos.GetBookmark;
                try
                  qryParcelasContratos.Insert;
                  for A:= 0 to qryParcelasContratos.FieldCount - 1 do
                    qryParcelasContratos.Fields[A].AsVariant:= CParcelas[A];

                  qryParcelasContratosnumero.AsInteger    := NR;
                  qryParcelasContratosvalorvencto.AsCurrency := qryParcelasContratosvalorvencto.AsCurrency - Faltam;
                  qryParcelasContratosvalorpagto.AsCurrency  := qryParcelasContratosvalorvencto.AsCurrency;
                  qryParcelasContratosjuros.Clear;
                  Faltam:= 0;
                  qryParcelasContratos.Post;
                finally
                  qryParcelasContratos.GotoBookmark(Pos);
                  qryParcelasContratos.FreeBookmark(Pos);
                end;
              end
              else begin
                qryParcelasContratos.Edit;
                Faltam:= Faltam - qryParcelasContratosvalorvencto.AsCurrency;
                qryParcelasContratostipopagto.AsString   := 'D';
                qryParcelasContratosdeventrada.AsDateTime:= Date;
                qryParcelasContratos.Post;
              end;
            end;
          end;
          qryParcelasContratos.Next;
        end;
        Diferenca:= TotalAberto + Faltam;
      end;

      if ((Diferenca > 0) and (Diferenca < TotalAberto)){ or (qryContratosTrocaorigem.AsString <> '') Alterei 29/07/04} {then begin
        qryParcelasContratos.First;
        while not qryParcelasContratos.Eof do begin
          if (qryParcelasContratosdatapagto.AsDateTime = 0) then begin
            SetLength(CParcelas,qryParcelasContratos.FieldCount);
            for A:= 0 to qryParcelasContratos.FieldCount - 1 do
              CParcelas[A]:= qryParcelasContratos.Fields[A].AsVariant;

            Inc(NR);
            Pos:= qryParcelasContratos.GetBookmark;
            try
              qryParcelasContratos.Insert;
              for A:= 0 to qryParcelasContratos.FieldCount - 1 do
                qryParcelasContratos.Fields[A].AsVariant:= CParcelas[A];

              qryParcelasContratosnumero.AsInteger           := NR;
              if (Diferenca < TotalAberto) then
                   qryParcelasContratosvalorvencto.AsCurrency := Diferenca
              else qryParcelasContratosvalorvencto.AsCurrency := TotalAberto;
              qryParcelasContratosfilialpagto.AsInteger    := FilialBase;
              qryParcelasContratosvalorpagto.AsCurrency    := qryParcelasContratosvalorvencto.AsCurrency;
              qryParcelasContratosdatapagto.AsDateTime     := DataServidor;
              qryParcelasContratostipopagto.AsString       := 'E';
              qryParcelasContratosdeventrada.Clear;
              qryParcelasContratosdevcaixa.Clear;
              qryParcelasContratos.Post;
            finally
              qryParcelasContratos.GotoBookmark(Pos);
              qryParcelasContratos.FreeBookmark(Pos);
            end;
            break;
          end;
          qryParcelasContratos.Next;
        end;

        if (Diferenca < TotalAberto) then begin
          //Faltam:= Diferenca;
          for a:= 0 to Length(NewParcelas)-1 do begin
            if qryParcelasContratos.Locate('numero',NewParcelas[a].Registro,[]) then begin
              if NewParcelas[A].DataPagto = 0 then begin
                qryParcelasContratos.Edit;
                Valor:= RoundTo(Diferenca * (NewParcelas[A].ValorVencto / TotalAberto),-2);
                qryParcelasContratosvalorvencto.AsCurrency:= NewParcelas[A].ValorVencto - Valor;
                qryParcelasContratos.Post;
              end;
            end;
          end;
        end;
      end
      else begin
        // Estornos
        for a:= 0 to Length(NewParcelas)-1 do begin
          if (NewParcelas[a].DataPagto = 0) then begin
            if qryParcelasContratos.Locate('numero',NewParcelas[a].Registro,[]) then begin
              qryParcelasContratos.Edit;
              qryParcelasContratosdatapagto.AsDateTime  := DataServidor;
              qryParcelasContratosvalorpagto.AsCurrency    := qryParcelasContratosvalorVencto.AsCurrency;
              qryParcelasContratosjuros.Clear;
              qryParcelasContratosfilialpagto.AsInteger := FilialBase;
              qryParcelasContratostipopagto.AsString    := 'E';
              qryParcelasContratos.Post;
            end;
          end;
        end;
        FValorAberto:= 0;
      end;

      if FValorAberto <> 0 then begin
        Valor:= 0;
        qryParcelasContratos.First;
        while not qryParcelasContratos.Eof do begin
          if (qryParcelasContratosdatapagto.AsDateTime = 0) then
            Valor:= Valor + qryParcelasContratosvalorvencto.AsCurrency;
          qryParcelasContratos.Next;
        end;

        Diferenca:= FValorAberto - Valor;
//          FValorDevolvido:= FValorDevolvido + Diferenca; {Gedovar 03/07/2006}
{
        if Diferenca <> 0 then begin
          qryParcelasContratos.First;
          while not qryParcelasContratos.Eof do begin
            if (qryParcelasContratosdatapagto.AsDateTime = 0) then begin
              qryParcelasContratos.Edit;
              qryParcelasContratosvalorvencto.AsCurrency:= qryParcelasContratosvalorvencto.AsCurrency + Diferenca;
              qryParcelasContratos.Post;
              Break;
            end;
            qryParcelasContratos.Next;
          end;
        end;
      end;

      Result:= True;
    finally
      qryParcelasContratos.EnableControls;
    end;
    }
    AtualizaValoresDevolvidos;
  end;
end;



procedure TdtmTrocaMercadorias.ValidarTotaisContratosDevolvidos_TotaisContratos;
var
  VVista, VPrazo, VDescto, vValorDescontoItem, vImpostoRetido, VFrete, VSeguro, VTroca, vIPI, vICMSST: Currency;

  function ProcuraContratoDevolvidocomProduto: boolean;
  begin
    result := false;
    qryContratosDevolvidos.last;
    while not qryContratosDevolvidos.bof do
    begin
      if not qrycontratosdevolvidosproduto.isnull then
      begin
        result := true;
        break;
      end;
      qrycontratosdevolvidos.prior;
    end;
  end;

  function ProcuraContratoDevolvidocomServico: boolean;
  begin
    result := false;
    qryContratosDevolvidos.last;
    while not qryContratosDevolvidos.bof do
    begin
      if not qrycontratosdevolvidosservico.isnull then
      begin
        result := true;
        break;
      end
      else
        qrycontratosdevolvidos.prior;
    end;
  end;

  function CondicaoTodosValores: boolean;
  begin
    result := (
                ( ((qryContratosTrocasituacao.AsString = 'F') and TodosProdutosDevolvidos) or
                  (((qryContratosTrocasituacao.AsString = 'N') or (qryContratosTrocasituacao.AsString = 'P'))  and TodosProdutosEntreguesDevolvidos)
                 )
                 and TodosServicosDevolvidos
               ) ;

  end;

  function CondicaoExisteProdutoDevolvido: boolean;
  begin
    result := (
               ( ((qryContratosTrocasituacao.AsString = 'F') and TodosProdutosDevolvidos) or
                 (((qryContratosTrocasituacao.AsString = 'N') or (qryContratosTrocasituacao.AsString = 'P'))  and TodosProdutosEntreguesDevolvidos)
               )
                 and (DevolveProduto<>0)
              ) ;
  end;

begin
  VVista:= 0; VPrazo:= 0; VDescto:= 0; vValorDescontoItem:=0; vImpostoRetido:=0; VFrete:= 0; VSeguro:= 0; VTroca:= 0; vIPI:=0; vICMSST:=0;
  qryContratosDevolvidos.First;
  while not qryContratosDevolvidos.Eof do
  begin
    VVista  := VVista  + qryContratosDevolvidosvalorvista.AsCurrency;
    VPrazo  := VPrazo  + qryContratosDevolvidosvalorprazo.AsCurrency;

    VDescto := VDescto + qryContratosDevolvidosdesconto.AsCurrency;

    vValorDescontoItem := vValorDescontoItem + qryContratosDevolvidosvalordescontoitem.asCurrency;
    
    vImpostoRetido := vImpostoRetido + qryContratosDevolvidosimpostoretido.AsCurrency;
    VFrete  := VFrete  + qryContratosDevolvidosfrete.AsCurrency;
    VSeguro := VSeguro + qryContratosDevolvidosseguro.AsCurrency;
    VTroca  := VTroca  + qryContratosDevolvidoscreditotroca.AsCurrency;
    vIPI := vIPI + qryContratosDevolvidosvaloripi.AsCurrency;
    vICMSST := vICMSST + qryContratosDevolvidosvaloricmssubstituicao.AsCurrency;
    qryContratosDevolvidos.Next;
  end;

  VVista  := VVista  + qryValoresDevolvidosvalorvista_p.AsCurrency + qryValoresDevolvidosvalorvista_s.AsCurrency +
                       qryValoresTrocadosvalorvista_p.asCurrency + qryValoresTrocadosvalorvista_s.AsCurrency;

  VPrazo  := VPrazo  + qryValoresDevolvidosvalorprazo_p.AsCurrency + qryValoresDevolvidosvalorprazo_s.AsCurrency +
                       qryValoresTrocadosvalorprazo_p.AsCurrency + qryValoresTrocadosvalorprazo_s.AsCurrency;

  VDescto := VDescto + qryValoresDevolvidosdesconto_p.AsCurrency +
                       qryValoresTrocadosdesconto_p.AsCurrency;

  vValorDescontoItem := vValorDescontoItem + qryValoresDevolvidosvalordescontoitem_p.AsCurrency
                                           + qryValoresTrocadosvalordescontoitem_p.AsCurrency;

  vImpostoRetido := vImpostoRetido + qryValoresDevolvidosimpostoretido_s.AsCurrency +
                                     qryValoresTrocadosimpostoretido_s.AsCurrency;

  VFrete  := VFrete  + qryValoresDevolvidosfrete_p.AsCurrency +
                     + qryValoresTrocadosfrete_p.AsCurrency;

  VSeguro := VSeguro + qryValoresDevolvidosseguro_p.AsCurrency
                     + qryValoresTrocadosseguro_p.AsCurrency;

  VTroca  := VTroca  + qryValoresDevolvidoscreditotroca_p.AsCurrency + qryValoresDevolvidoscreditotroca_s.AsCurrency +
                       qryValoresTrocadoscreditotroca_p.AsCurrency + qryValoresTrocadoscreditotroca_s.AsCurrency;

  vIPI := vIPI + qryValoresDevolvidosvaloripi_p.AsCurrency +
                 qryValoresTrocadosvaloripi_p.AsCurrency;

  vICMSST := vICMSST + qryValoresDevolvidosvaloricmssubstituicao_p.AsCurrency +
                       qryValoresTrocadosvaloricmssubstituicao_p.AsCurrency;

  if ProcuraContratoDevolvidocomProduto or    //dar prioridade para fazer o acerto nos produtos e não nos serviços
     ProcuraContratoDevolvidocomServico then
  begin
    if CondicaoTodosValores then
    begin
      if truncar(VVista,2) <> qryContratosTrocavalorvista.AsCurrency then begin
        qryContratosDevolvidos.Edit;
        qryContratosDevolvidosvalorvista.AsCurrency:= qryContratosDevolvidosvalorvista.AsCurrency +
                                                      (qryContratosTrocavalorvista.AsCurrency - VVista);
        qryContratosDevolvidos.Post;
      end;

      if truncar(VPrazo,2) <> qryContratosTrocavalorprazo.AsCurrency then begin
        qryContratosDevolvidos.Edit;
        qryContratosDevolvidosvalorprazo.AsCurrency:= qryContratosDevolvidosvalorprazo.AsCurrency +
                                                      (qryContratosTrocavalorprazo.AsCurrency - VPrazo);
        qryContratosDevolvidos.Post;
      end;

      if truncar(VTroca,2) <> qryContratoscreditotroca.AsCurrency then
      begin
        qryContratosDevolvidos.Edit;
        qryContratosDevolvidoscreditotroca.AsCurrency:= qryContratosDevolvidoscreditotroca.AsCurrency +
                                                        (qryContratosTrocacreditotroca.AsCurrency - VTroca);
        qryContratosDevolvidos.Post;
      end;

    end;

    if CondicaoExisteProdutoDevolvido { not qryContratosDevolvidosproduto.isnull} then
    begin
      if truncar(VDescto,2) <> qryContratosTrocadesconto.AsCurrency then
      begin
        qryContratosDevolvidos.Edit;
        qryContratosDevolvidosdesconto.AsCurrency:= qryContratosDevolvidosdesconto.AsCurrency +
                                                      (qryContratosTrocadesconto.AsCurrency - VDescto);
        qryContratosDevolvidos.Post;
      end;

      if truncar(vValordescontoitem,2) <> qryContratosTrocavalordescontoitem.AsCurrency then
      begin
        qryContratosDevolvidos.Edit;
        qryContratosDevolvidosvalordescontoitem.AsCurrency:= qryContratosDevolvidosvalordescontoitem.AsCurrency +
                                                      (qryContratosTrocavalordescontoitem.AsCurrency - VValorDescontoItem);
        qryContratosDevolvidos.Post;
      end;


      if truncar(VFrete,2) <> qryContratosTrocafrete.AsCurrency then
      begin
        qryContratosDevolvidos.Edit;
        qryContratosDevolvidosfrete.AsCurrency:= qryContratosDevolvidosfrete.AsCurrency +
                                                      (qryContratosTrocafrete.AsCurrency - VFrete);
        qryContratosDevolvidos.Post;
      end;

      if truncar(VSeguro,2) <> qryContratosTrocaseguro.AsCurrency then
      begin
        qryContratosDevolvidos.Edit;
        qryContratosDevolvidosseguro.AsCurrency:= qryContratosDevolvidosseguro.AsCurrency +
                                                      (qryContratosTrocaseguro.AsCurrency - VSeguro);
        qryContratosDevolvidos.Post;
      end;

      if truncar(vIPI,2) <> qryContratosTrocatotalipi.AsCurrency then
      begin
        qryContratosDevolvidos.Edit;
        qryContratosDevolvidosvaloripi.AsCurrency:= qryContratosDevolvidosvaloripi.AsCurrency +
                                                      (qryContratosTrocatotalipi.AsCurrency - vIPI);
        qryContratosDevolvidos.Post;
      end;

      if truncar(vICMSST,2) <> qryContratosTrocavaloricmssubstituicao.AsCurrency then
      begin
        qryContratosDevolvidos.Edit;
        qryContratosDevolvidosvaloricmssubstituicao.AsCurrency:= qryContratosDevolvidosvaloricmssubstituicao.AsCurrency +
                                                      (qryContratosTrocavaloricmssubstituicao.AsCurrency - vICMSST);
        qryContratosDevolvidos.Post;
      end;

    end;

    if ProcuraContratoDevolvidocomServico then   // imposto retido é somente nos serviços
    begin
      if truncar(vImpostoRetido,2) <> qryContratosTrocavalorimpostoretido.AsCurrency then
      begin
        qryContratosDevolvidos.Edit;
        qryContratosDevolvidosimpostoretido.AsCurrency:= qryContratosDevolvidosimpostoretido.AsCurrency +
                                                      (qryContratosTrocavalorimpostoretido.AsCurrency - vImpostoRetido);
        qryContratosDevolvidos.Post;
      end;
    end;
  end;

end;



procedure TdtmTrocaMercadorias.AtualizaParcelasAbertas(Mostrar: Boolean);
var
  NP,A : Integer;
  Pos  : TBookmark;
  Data : TDateTime;
  Valor: Currency;

  procedure IncluirParcela;
  begin
    qryParcelasAbertas.Insert;
    qryParcelasAbertasnumero.AsInteger      := NP;
    qryParcelasAbertasdatavencto.AsDateTime := Data;
    qryParcelasAbertasvalorvencto.AsCurrency   := Valor;
    qryParcelasAbertas.Post;
    NP:= 0;  Data:= 0;  Valor:= 0;
  end;

begin
//  if not Mostrar and ((FDevolveVencto > 0) or (FValorAberto = 0)) then
  if not Mostrar and (FDevolveVencto <= 0) and (FValorAberto = 0) then
    ReFazConsulta(qryParcelasAbertas,[0],[''])
  else begin
    ReFazConsulta(qryParcelasAbertas,[0],['']);
    NP:= 0; Data:= 0;   Valor:= 0;
    qryParcelasContratos.DisableControls;
    Pos:= qryParcelasContratos.GetBookmark;
    try
      qryParcelasContratos.First;
      for A:= 1 to qryParcelasContratos.RecordCount do begin
        if qryParcelasContratosdatapagto.AsDateTime = 0 then begin
          Inc(NP);
          if (Valor = 0) then begin
            Data := qryParcelasContratosdatavencto.AsDateTime;
            Valor:= qryParcelasContratosvalorvencto.AsCurrency;
          end;
          if (FloatToStr(Valor) <> qryParcelasContratosvalorvencto.AsString) then
            IncluirParcela;
        end;
        qryParcelasContratos.Next;
      end;
      if (Data > 0) and (Valor > 0) then
        IncluirParcela;
    finally
      qryParcelasContratos.GotoBookmark(Pos);
      qryParcelasContratos.FreeBookmark(Pos);
      qryParcelasContratos.EnableControls;
    end;
  end;
end;


procedure TdtmTrocaMercadorias.AtualizaValores;

(*
var
  Pos   : TBookmark;
  Faltam: Boolean;
  A     : Integer;
  Dif,
  ValDescto, ValCreditoTroca,
  ValFrete,
  ValSeguro,
  ValProduto,
  ValServico,
  Valor     : Currency;
begin
  FValorProdutos:= FOldValorProdutos;
  FValorServicos  := FOldValorServicos;
  FValorImpostoRetido := FOldValorImpostoRetido;
  FValorIPI := FOldValorIPI;
  Fvaloricmssubstituicao := FOldvaloricmssubstituicao;
  FValorVista   := FOldValorVista;
  FValorPrazo   := FOldValorPrazo;
  FValorDesconto:= FOldValorDesconto;
  FValorCreditoTroca := fOldValorCreditoTroca;

  FValorSeguro  := FOldValorSeguro;
  FValorFrete   := FOldValorFrete;
  Faltam   := False;
  ValDescto:= 0;
  ValCreditoTroca := 0;
  ValFrete := 0;
  ValSeguro:= 0;
//  Valor    := 0;
  ValProduto      := 0;
  ValServico      := 0;

  FDevolveProduto:= 0;

  qryProdutosContratosTroca.DisableControls;
  Pos:= qryProdutosContratosTroca.GetBookmark;
  try
    NrSelecoes:= 0;
    qryProdutosContratosTroca.First;
    for A:= 0 to qryProdutosContratosTroca.RecordCount - 1 do
    begin
      if not qryProdutosContratosTrocabrinde.AsBoolean and
             (qryProdutosContratosTrocacancelado.AsCurrency < qryProdutosContratosTrocaquantidade.AsCurrency) then
      begin
        Faltam:= Faltam or (((qryProdutosContratosTrocaquantidade.AsCurrency -
                              qryProdutosContratosTrocacancelado.AsCurrency) -
                              qryProdutosContratosTrocaDevolver.AsCurrency) > 0) ;

        if (qryProdutosContratosTrocaDevolver.AsCurrency > 0) then
        begin
          Inc(NrSelecoes);
          Valor  := (qryProdutosContratosTrocaDevolver.AsCurrency * ProdutoseServicos[Produtos][A].Preco);

          Faltam:= (qryProdutosContratosTrocaquantidade.AsCurrency -
                    qryProdutosContratosTrocacancelado.AsCurrency  -
                    qryProdutosContratosTrocadevolver.AsCurrency)   > 0 ;

          if (FOldValorProdutos<=0) then
          begin
            MensagemAviso(ctERRO+' divisão por zero');

            Application.Terminate;
          end
          else
          begin
            ValDescto:= ValDescto + (qryContratosTrocadesconto.AsCurrency * Valor) / (FOldValorProdutos);
            ValCreditoTroca:= ValCreditoTroca + (qryContratosTrocacreditotroca.AsCurrency * Valor) / (FOldValorProdutos);


            if DevolverFrete then
              ValFrete:= ValFrete + (qryContratosTrocafrete.AsCurrency * Valor) / FOldValorProdutos
            else ValFrete := 0;

            if DevolverSeguro then
              ValSeguro:= ValSeguro + (qryContratosTrocaseguro.AsCurrency * Valor) / FOldValorProdutos
            else ValSeguro:= 0;
          end;

          if qryProdutosContratosTrocadefeito.AsBoolean then
               ProdutoseServicos[Produtos][A].Devolver:= (qryProdutosContratosTrocaprecovenda.AsCurrency * qryProdutosContratosTrocaDevolver.AsCurrency)
          else ProdutoseServicos[Produtos][A].Devolver:= (ProdutoseServicos[Produtos][A].Preco * qryProdutosContratosTrocaDevolver.AsCurrency);
        end
        else
          ProdutoseServicos[Produtos][A].Devolver:= 0;
        FDevolveProduto:= FDevolveProduto + ProdutoseServicos[Produtos][A].Devolver;
      end;
      qryProdutosContratosTroca.Next;
    end;
    FValorProdutos:= FOldValorProdutos - FDevolveProduto;
  finally
    qryProdutosContratosTroca.GotoBookmark(Pos);
    qryProdutosContratosTroca.FreeBookmark(Pos);
    qryProdutosContratosTroca.EnableControls;
  end;
*)


var
  Pos, ContratosDevolvidos   : TBookmark;
  Faltam: Boolean;
  A     : Integer;
  Dif,

  ValAcrescimo, valAcrescimoTotal,
  ValDescto, ValDesctoTotal,
  ValDescontoItem, ValDescontoItemTotal,
  ValImpostoRetido, ValImpostoRetidoTotal,
  ValFrete, valFreteTotal,
  ValSeguro, valSeguroTotal,
  ValIPI, valIPITotal,
  ValicmsSubst, ValicmsSubstTotal,

  DescontoDevolvido,
  DescontoItemDevolvido,
  vFreteDevolvido,
  SeguroDevolvido,
  AcrescimoDevolvido,
  CreditoTrocaDevolvido,
  IPIDevolvido,
  IcmsSubstituicaoDevolvido,
  ImpostoRetidoDevolvido, Saldo, Valor,
  vValoraDevolver
  {,
  ValorParcelaReal,
  SomaValorParcelaReal}: Currency;
begin
  FValorProdutos  := FOldValorProdutos;
  FValorServicos  := FOldValorServicos;
  FValorImpostoRetido := FOldValorImpostoRetido;
  FValorIPI := FOldValorIPI;
  Fvaloricmssubstituicao := FOldvaloricmssubstituicao;
  FValorVista     := FOldValorVista;
  FValorPrazo     := FOldValorPrazo;
  FValorDesconto  := FOldValorDesconto;
  FValorDescontoItem  := FOldValorDescontoItem;

  FValorSeguro    := FOldValorSeguro;
  FValorFrete     := FOldValorFrete;
  FValorAcrescimo := FOldValorPrazo - FOldValorVista;
  FValorCreditotroca := FOldValorCreditoTroca;


  FDevolveProduto := 0;
  FDevolveServicos := 0;
  CreditoTrocaDevolvido := 0;

  valAcrescimoTotal     := 0;
  ValDesctoTotal        := 0;
  ValDescontoItemTotal  := 0;
  ValImpostoRetidoTotal := 0;
  valFreteTotal         := 0;
  valSeguroTotal        := 0;
  valIPITotal           := 0;
  ValicmsSubstTotal     := 0;



  qryProdutosContratosTroca.DisableControls;
  Pos:= qryProdutosContratosTroca.GetBookmark;
  try
    NrSelecoes:= 0;
    qryProdutosContratosTroca.First;
    for A:= 0 to qryProdutosContratosTroca.RecordCount - 1 do
    begin


      valAcrescimo     := 0;
      ValDescto        := 0;
      ValDescontoItem  := 0;
      valFrete         := 0;
      valSeguro        := 0;
      valIPI           := 0;
      ValicmsSubst     := 0;


      if not qryProdutosContratosTrocabrinde.AsBoolean and
             (qryProdutosContratosTrocacancelado.AsCurrency < qryProdutosContratosTrocaquantidade.AsCurrency) then
      begin

        if (qryProdutosContratosTrocadevolver.AsCurrency > 0) then
        begin
          Inc(NrSelecoes);
//          Valor := (qryProdutosContratosTrocadevolver.AsCurrency * ProdutoseServicos[produtos][A].Devolver);
          Faltam:= (qryProdutosContratosTrocaquantidade.AsCurrency -
                    qryProdutosContratosTrocacancelado.AsCurrency  -
                    qryProdutosContratosTrocadevolver.AsCurrency)   > 0 ;

          if not Faltam then  //GARANTE O FECHAMENTO DOS VALORES NO CASO DE DEVOLUCAO TOTAL DO PRODUTO
          begin
            DescontoDevolvido := 0;
            DescontoItemDevolvido := 0;
            vFreteDevolvido    := 0;
            SeguroDevolvido   := 0;
            IPIDevolvido := 0;
            IcmsSubstituicaoDevolvido := 0;
            AcrescimoDevolvido:= 0;
{            CreditoTrocaDevolvido := 0;}

            if not qryProdutosContratosDevolvidos.IsEmpty then
            begin
              try
                ContratosDevolvidos := qryProdutosContratosDevolvidos.GetBookmark;
                qryProdutosContratosDevolvidos.disablecontrols;

                qryProdutosContratosDevolvidos.First;
                while not qryProdutosContratosDevolvidos.Eof do
                begin
                  if qryProdutosContratosTrocaproduto.AsString = qryProdutosContratosDevolvidosproduto.AsString then
                  begin
                    DescontoDevolvido := DescontoDevolvido + qryProdutosContratosDevolvidosdesconto.AsCurrency;
                    DescontoItemDevolvido := DescontoItemDevolvido + qryProdutosContratosDevolvidosvalordescontoitem.AsCurrency;
                    vFreteDevolvido    := vFreteDevolvido    + qryProdutosContratosDevolvidosfrete.AsCurrency;
                    SeguroDevolvido   := SeguroDevolvido   + qryProdutosContratosDevolvidosseguro.AsCurrency;
                    AcrescimoDevolvido:= AcrescimoDevolvido+ qryProdutosContratosDevolvidosacrescimo.AsCurrency;
                    CreditoTrocaDevolvido := CreditoTrocaDevolvido + qryProdutosContratosDevolvidoscreditotroca.AsCurrency;
                    IPIDevolvido := IPIDevolvido + qryProdutosContratosDevolvidosvaloripi.ascurrency;
                    IcmsSubstituicaoDevolvido := IcmsSubstituicaoDevolvido + qryProdutosContratosDevolvidosvaloricmssubstituicao.AsCurrency;
                  end;
                  qryProdutosContratosDevolvidos.Next;
                end;
              finally
                qryProdutosContratosDevolvidos.GotoBookmark(ContratosDevolvidos);
                qryProdutosContratosDevolvidos.FreeBookmark(ContratosDevolvidos);
                qryProdutosContratosDevolvidos.enablecontrols;
              end;
            end;

            ValAcrescimo := qryProdutosContratosTrocaacrescimo.AsCurrency - AcrescimoDevolvido;
            ValAcrescimoTotal := ValAcrescimoTotal + ValAcrescimo;

            ValDescto := qryProdutosContratosTrocadesconto.AsCurrency  - DescontoDevolvido;
            valDesctoTotal := valDesctoTotal + ValDescto;

            ValDescontoItem := qryProdutosContratosTrocavalordescontoitem.AsCurrency  - DescontoItemDevolvido;
            ValDescontoItemTotal := ValDescontoItemTotal + ValDescontoItem;

            ValIPI := qryProdutosContratosTrocavaloripi.AsCurrency - IPIDevolvido;
            ValIPITotal := ValIPITotal + ValIPI;

            ValicmsSubst := qryProdutosContratosTrocaicmsvalorst.AsCurrency - IcmsSubstituicaoDevolvido;
            ValicmsSubstTotal := ValicmsSubstTotal + ValicmsSubst;


            if DevolverFrete then
            begin
              ValFrete   := qryProdutosContratosTrocafrete.AsCurrency     - vFreteDevolvido;
              ValFreteTotal := valFreteTotal + valFrete;
            end;

            if DevolverSeguro then
            begin
              ValSeguro  := qryProdutosContratosTrocaseguro.AsCurrency    - SeguroDevolvido;
              ValSeguroTotal := ValSeguroTotal + ValSeguro;
            end;
          end
          else
          begin
            ValAcrescimo := truncar(((qryProdutosContratosTrocaacrescimo.AsCurrency / qryProdutosContratosTrocaquantidade.AsCurrency) * qryProdutosContratosTrocadevolver.AsCurrency),2);
            ValAcrescimoTotal := ValAcrescimoTotal + ValAcrescimo;

            ValDescto := truncar(((qryProdutosContratosTrocadesconto.AsCurrency / qryProdutosContratosTrocaquantidade.AsCurrency) * qryProdutosContratosTrocadevolver.AsCurrency),2);
            valDesctoTotal := valDesctoTotal + ValDescto;

            ValDescontoItem := truncar((qryProdutosContratosTrocavalordescontoitem.AsCurrency * qryProdutosContratosTrocadevolver.AsCurrency / qryProdutosContratosTrocaquantidade.AsCurrency),2);
            ValDescontoItemTotal := ValDescontoItemTotal + ValDescontoItem;

            ValIPI := truncar(((qryProdutosContratosTrocavaloripi.AsCurrency / qryProdutosContratosTrocaquantidade.AsCurrency) * qryProdutosContratosTrocadevolver.AsCurrency),2);
            ValIPITotal := ValIPITotal + ValIPI;

            ValicmsSubst := truncar(((qryProdutosContratosTrocaicmsvalorst.AsCurrency / qryProdutosContratosTrocaquantidade.AsCurrency) * qryProdutosContratosTrocadevolver.AsCurrency),2);
            ValicmsSubstTotal := ValicmsSubstTotal + ValicmsSubst;

            if DevolverFrete then
            begin
              ValFrete := truncar(((qryProdutosContratosTrocafrete.AsCurrency / qryProdutosContratosTrocaquantidade.AsCurrency) * qryProdutosContratosTrocadevolver.AsCurrency),2);
              ValFreteTotal := valFreteTotal + valFrete;
            end;

            if DevolverSeguro then
            begin
               ValSeguro := truncar(((qryProdutosContratosTrocaseguro.AsCurrency / qryProdutosContratosTrocaquantidade.AsCurrency) * qryProdutosContratosTrocadevolver.AsCurrency),2);
               ValSeguroTotal := ValSeguroTotal + ValSeguro;
            end;
          end;

          vValoraDevolver := (qryProdutosContratosTrocaprecovenda.AsCurrency *
                              qryProdutosContratosTrocadevolver.AsCurrency);


          {ProdutoseServicos[Produtos][A].ValorDescontoItem := (qryProdutosContratosTrocavalordescontoitem.AsCurrency * qryProdutosContratosTrocadevolver.AsCurrency / qryProdutosContratosTrocaquantidade.AsCurrency);}
//          if qryProdutosContratosTrocadefeito.AsBoolean then
            {o preco de venda quando avariado pode ser alterado}
//            ProdutoseServicos[Produtos][A].Devolver := qryProdutosContratosTrocaprecovenda.AsCurrency * qryProdutosContratosTrocadevolver.AsCurrency - ProdutoseServicos[Produtos][A].ValorDescontoItem
//          else
//            ProdutoseServicos[Produtos][A].Devolver := ProdutoseServicos[Produtos][A].Preco * qryProdutosContratosTrocadevolver.AsCurrency - ProdutoseServicos[Produtos][A].ValorDescontoItem;


        end
        else
          vValoraDevolver := 0;
//          ProdutoseServicos[Produtos][A].Devolver := 0;

//        FDevolveProduto:= FDevolveProduto + ProdutoseServicos[Produtos][A].Devolver;
        FDevolveProduto:= FDevolveProduto + vValoraDevolver;
      end;

      {Acerto de centavos devido aos rateios}
      if qryProdutosTrocados.locate('produto', qryProdutosContratosTrocaproduto.asstring, []) then
      begin
        qryProdutosTrocados.edit;

        qryprodutostrocadosdesconto.ascurrency := ValDescto;

        qryProdutosTrocadosvalordescontoitem.AsCurrency := ValDescontoItem;

        qryprodutostrocadosfrete.ascurrency := ValFrete;
        qryprodutostrocadosseguro.ascurrency := ValSeguro;
        qryProdutosTrocadosAcrescimo.asCurrency := ValAcrescimo;
        qryProdutosTrocadosvaloripi.asCurrency := ValIPI;
        qryProdutosTrocadosICMSvalorST.asCurrency := ValicmsSubst;

        qryProdutosTrocadosCalcFields(qryProdutosTrocados);

        qryProdutosTrocadosprecoavaliado.AsCurrency :=
              qryProdutosContratosTrocaprecovenda.AsCurrency -
              qryProdutosTrocadosdescontototalunitario.AsCurrency +
              qryProdutosTrocadosfreteunitario.asCurrency +
              qryProdutosTrocadossegurounitario.AsCurrency +
              qryProdutosTrocadosAcrescimoUnitario.asCurrency +
              qryProdutosTrocadosvaloripiUnitario.asCurrency +
              qryProdutosTrocadosDespesasAcessoriasUnitario.asCurrency + {DespesasAcessorias: só para manter o entendimento pois não é usado no contrato...}
              qryProdutosTrocadosICMSvalorSTUnitario.asCurrency;

        qryProdutosTrocados.post;
      end;

      qryProdutosContratosTroca.Next;
    end;
    FDevolveProduto:= FDevolveProduto;
    FValorProdutos:= FOldValorProdutos - FDevolveProduto;
  finally
    qryProdutosContratosTroca.GotoBookmark(Pos);
    qryProdutosContratosTroca.FreeBookmark(Pos);
    qryProdutosContratosTroca.EnableControls;
  end;

  qryServicosContratos.DisableControls;
  Pos:= qryServicosContratos.GetBookmark;
  try
    //NrSelecoes:= 0;
    qryServicosContratos.First;
    for A:= 0 to qryServicosContratos.RecordCount - 1 do
    begin

      ValImpostoRetido := 0;

      if (qryServicosContratoscancelado.AsCurrency < qryServicosContratosquantidade.AsCurrency) then
      begin
        if (qryServicosContratosdevolver.AsCurrency > 0) then
        begin
          Inc(NrSelecoes);
//          Valor := (qryServicosContratosdevolver.AsCurrency * ProdutoseServicos[Servicos][A].Preco);
          Faltam:= (qryServicosContratosquantidade.AsCurrency -
                    qryServicosContratoscancelado.AsCurrency  -
                    qryServicosContratosdevolver.AsCurrency)   > 0 ;

          if not Faltam then  //GARANTE O FECHAMENTO DOS VALORES NO CASO DE DEVOLUCAO TOTAL DO PRODUTO
          begin

            {CreditoTrocaDevolvido := 0;}
            ImpostoRetidoDevolvido := 0;

            if not qryServicosContratosDevolvidos.IsEmpty then
            begin
              try
                ContratosDevolvidos := qryServicosContratosDevolvidos.GetBookmark;
                qryServicosContratosDevolvidos.disablecontrols;

                qryServicosContratosDevolvidos.First;
                while not qryServicosContratosDevolvidos.Eof do
                begin
                  if qryServicosContratosservico.AsString = qryServicosContratosDevolvidosservico.AsString then
                  begin
                    CreditoTrocaDevolvido := CreditoTrocaDevolvido + qryServicosContratosDevolvidoscreditotroca.AsCurrency;
                    ImpostoRetidoDevolvido := ImpostoRetidoDevolvido + qryServicosContratosDevolvidosimpostoretido.asCurrency;
                  end;
                  qryServicosContratosDevolvidos.Next;
                end;
              finally
                qryServicosContratosDevolvidos.GotoBookmark(ContratosDevolvidos);
                qryServicosContratosDevolvidos.FreeBookmark(ContratosDevolvidos);
                qryServicosContratosDevolvidos.enablecontrols;
              end;
            end;
            ValImpostoRetido := qryServicosContratosimpostoretido.AsCurrency  - ImpostoRetidoDevolvido;
            ValImpostoRetidoTotal := ValImpostoRetidoTotal + ValImpostoRetido;

          end
          else
          begin
            ValImpostoRetido := ((qryServicosContratosimpostoretido.AsCurrency / qryServicosContratosquantidade.AsCurrency) * qryServicosContratosdevolver.AsCurrency);
            ValImpostoRetidoTotal := ValImpostoRetidoTotal + ValImpostoRetido;
          end;

//          Devolver[Servicos][A]:= Precos[Servicos][A] * qryServicosContratosdevolver.AsCurrency;

//          produtoseServicos[Servicos][A].ImpostoRetido := (qryServicosContratosimpostoretido.AsCurrency * qryServicosContratosdevolver.AsCurrency / qryServicosContratosquantidade.AsCurrency);
//          produtoseServicos[Servicos][A].Devolver := ProdutoseServicos[Servicos][A].Preco * qryServicosContratosdevolver.AsCurrency {- produtoseServicos[Servicos][A].ImpostoRetido};
          vValoraDevolver := qryServicosContratosvalorservico.AsCurrency * qryServicosContratosdevolver.AsCurrency;

        end
        else
          vValoraDevolver := 0;
//          produtoseServicos[Servicos][A].Devolver := 0;

//        FDevolveServicos:= FDevolveServicos + ProdutoseServicos[Servicos][A].Devolver;
        FDevolveServicos:= FDevolveServicos + vValoraDevolver;
      end;
      qryServicosContratos.Next;
    end;
    FValorServicos:= FOldValorServicos - FDevolveServicos;
  finally
    qryServicosContratos.GotoBookmark(Pos);
    qryServicosContratos.FreeBookmark(Pos);
    qryServicosContratos.EnableControls;
  end;

  if NrSelecoes > 0 then
  begin
          {

    for A:= 0 to Length(ProdutoseServicos[Produtos])-1 do
    begin
      if (ProdutoseServicos[Produtos][A].devolver > 0) then
        ValProduto := ValProduto + ProdutoseServicos[Produtos][A].devolver;
    end;

    for A:= 0 to Length(ProdutoseServicos[Servicos])-1 do
    begin
      if (ProdutoseServicos[Servicos][A].devolver > 0) then
        ValServico := ValServico + ProdutoseServicos[Servicos][A].devolver;
    end;
    }

    if ValAcrescimoTotal > FValorAcrescimo then
      ValAcrescimoTotal := FValorAcrescimo;
    FValorAcrescimo := FValorAcrescimo - ValAcrescimoTotal;

    if ValDesctoTotal > FValorDesconto then
      ValDesctoTotal:= FValorDesconto;
    FValorDesconto:= FValorDesconto - ValDesctoTotal;
    if FValorDesconto < 0 then
      FValorDesconto:= 0;

    if ValDescontoItemTotal > FValorDescontoItem then
      ValDescontoItemTotal:= FValorDescontoItem;
    FValorDescontoItem:= FValorDescontoItem - ValDescontoItemTotal;
    if FValorDescontoItem < 0 then
      FValorDescontoItem:= 0;

    if ValFreteTotal > FValorFrete then
      ValFreteTotal:= FValorFrete;
    FValorFrete := FValorFrete - ValFreteTotal;
    if FValorFrete < 0 then
      FValorFrete:= 0;

    if ValSeguroTotal > FValorSeguro then
      ValSeguroTotal:= FValorSeguro;
    FValorSeguro := FValorSeguro - ValSeguroTotal;
    if FValorSeguro < 0 then
      FValorSeguro:= 0;

    if ValImpostoRetidoTotal > FValorImpostoRetido then
      ValImpostoRetidoTotal := FValorImpostoRetido;
    FValorImpostoRetido := FValorImpostoRetido - ValImpostoRetidoTotal;
    if FValorImpostoRetido < 0 then
      FValorImpostoRetido := 0;

    if ValIPITotal > FValorIPI then
      ValIPITotal:= FValorIPI;
    FValorIPI := FValorIPI - ValIPITotal;
    if FValorIPI < 0 then
      FValorIPI:= 0;

    if ValicmsSubstTotal > Fvaloricmssubstituicao then
      ValicmsSubstTotal := Fvaloricmssubstituicao;
    Fvaloricmssubstituicao := Fvaloricmssubstituicao - ValicmsSubstTotal;
    if Fvaloricmssubstituicao < 0 then
      Fvaloricmssubstituicao:= 0;
{
    if ValCreditoTroca > FValorCreditoTroca then
      ValCreditoTroca:= FValorCreditoTroca;
    FValorCreditoTroca:= FValorCreditoTroca - ValCreditoTroca;
    if FValorCreditoTroca < 0 then
      FValorCreditoTroca:= 0;
}
{    FValorCreditoTroca := FValorCreditoTroca - CreditoTrocaDevolvido;}
{    FValorVista := FValorVista - (ValProduto + ValServico + ValFrete + ValSeguro - ValDescto);}
    FValorVista := FValorVista - (FDevolveProduto + FDevolveServicos + ValFreteTotal + ValSeguroTotal + ValIPITotal + ValicmsSubstTotal - ValDesctoTotal - ValDescontoItemTotal - ValImpostoRetidoTotal );
    FValorPrazo := FValorPrazo - (FDevolveProduto + FDevolveServicos + ValFreteTotal + ValSeguroTotal + ValIPITotal + ValicmsSubstTotal - ValDesctoTotal - ValDescontoItemTotal - ValImpostoRetidoTotal + ValAcrescimoTotal);

    if FValorVista < 0 then
      FValorVista := 0;

    Saldo := fOldvalorprazo - fValorprazo;
    fValorAberto := fOldValorPrazo - fPagoVencto - PagoCreditoTroca;
    DevolveCreditoTroca := 0;
    DevolveemAberto := 0;
    fDevolvePagto := 0;

    //Primeiro: Abater dos valores em aberto;
    if Saldo <>  0 then
    begin
      if FValorAberto <> 0 then
      begin
        if Saldo >= FValorAberto then
        begin
          DevolveemAberto := FValorAberto;
          Saldo := Saldo - DevolveemAberto;
          FValorAberto := 0;
        end
        else
        begin
          DevolveemAberto := Saldo;
          Saldo := 0;
          FValorAberto := FValorAberto - DevolveemAberto;
        end;
      end;
    end;

    //Segundo: Abater dos valores de creédito de troca ;
    if Saldo <> 0 then
    begin
      if FValorCreditoTroca <> 0 then
      begin
        if Saldo >= FValorCreditoTroca then
        begin
          DevolveCreditoTroca := FValorCreditoTroca;
          Saldo := Saldo - DevolveCreditoTroca;
          FValorCreditoTroca := 0;
        end
        else
        begin
          DevolveCreditoTroca := Saldo;
          Saldo := 0;
          FValorCreditoTroca := FValorCreditoTroca - DevolveCreditoTroca;
        end;
      end;
    end;

    //Terceiro: Devolver o que foi pago ;
    if Saldo <> 0 then
    begin
      if fPagoVencto <> 0 then
      begin
        if Saldo >= fPagoVencto then
        begin
          Saldo := Saldo - fPagoVencto;
          fDevolvePagto := fPagoVencto;
        end
        else
        begin
          FDevolvePagto := Saldo;
          Saldo := 0;
        end;
      end;
    end;

    ReFazConsulta(qryParcelasContratos,  [0],[qryContratosTrocanumero.AsString]);

  end
  else
  begin

    {
    try
      qryProdutosContratos.First;
      for A:= 0 to (qryProdutosContratos.RecordCount -1) do begin
        ProdutoseServicos[Produtos][A].devolver:= 0;
        qryProdutosContratos.Next;
      end;
      qryProdutosContratos.First;
    except
    end;

    try
      qryServicosContratos.First;
      for A:= 0 to (qryServicosContratos.RecordCount -1) do begin
        ProdutoseServicos[Servicos][A].devolver:= 0;
        qryServicosContratos.Next;
      end;
      qryServicosContratos.First;
    except
    end;
    }

    ReFazConsulta(qryParcelasContratos,  [0],[qryContratosTrocanumero.AsString]);
    FValorAberto:= 0;
    for a:= 0 to Length(NewParcelas)-1 do begin
      if NewParcelas[A].DataPagto = 0 then
        FValorAberto:= FValorAberto + NewParcelas[A].ValorVencto;
    end;
    FDevolveReal  := 0;
    FDevolvePagto:= 0;

  end;

  if Assigned(fExibirNovosValores) then
    fExibirNovosValores(Self);
    

               {
    FDevolvePagto  := 0;
    FDevolveVencto:= 0;
    if (FValorVista < FPagoReal) then
    begin
      FDevolvePagto   := FPagoReal - FValorVista;
      FDevolveVencto := FDevolvePagto + RoundTo((FPagoVencto - FPagoReal) * (FDevolvePagto / FPagoReal),-2);
    end;
  end
  else
  begin
    if (FValorVista < FPagoReal) then
    begin
      FDevolvePagto   := FPagoReal - FValorVista;
      FDevolveVencto := FDevolvePagto + RoundTo((FPagoVencto - FPagoReal) * (FDevolvePagto / FPagoReal),-2);
    end
    else
    begin
      FDevolvePagto  := 0;
      FDevolveVencto:= 0;
    end;

    try
      qryProdutosContratosTroca.First;
      for A:= 0 to (qryProdutosContratosTroca.RecordCount -1) do begin
        ProdutoseServicos[Produtos][A].Devolver:= 0;
        qryProdutosContratosTroca.Next;
      end;
      qryProdutosContratosTroca.First;
    except
    end;
  end;
  }


  (*

  if (NrSelecoes > 0) then
  begin
    if ((FValorVista - FPagoReal) > 0) then
    begin
      if qryContratosTrocataxajuros.AsFloat <> 0 then
        CalcularNovasParcelas({ValProduto + ValServico}FDevolveProduto + FDevolveServicos)
      else
      begin
        ReFazConsulta(qryParcelasContratos,  [0],[qryContratosTrocanumero.AsString]);
        FValorAberto:= 0;
        Valor:= FPagoVencto * (1 - FValorVista / FOldValorVista);

        if (FNPAberta=0) then
          Valor:=RoundTo(Valor,-2)
        else
          Valor:= RoundTo((Valor / FNPAberta),-2);
        try
          qryParcelasContratos.First;
          while not qryParcelasContratos.Eof do begin
            if qryParcelasContratosdatapagto.AsDateTime = 0 then begin
              qryParcelasContratos.Edit;
              qryParcelasContratosValorVencto.AsCurrency :=  RoundTo(qryParcelasContratosValorVencto.AsCurrency *
                                                                    (FValorVista / FOldValorVista),-2) - Valor;
              qryParcelasContratos.Post;
              FValorAberto:= FValorAberto + qryParcelasContratosValorVencto.AsCurrency;
            end;
            qryParcelasContratos.Next
          end;
        finally
          qryParcelasContratos.EnableControls;
        end;

        if (FOldValorVista = FOldValorPrazo) then begin
          Dif:= FOldValorVista - ({ValProduto + ValServico +}FDevolveProduto + FDevolveServicos + ValFrete + ValSeguro + ValIPI + ValicmsSubst - ValDescto - ValImpostoRetido + FValorAberto + FPagoVencto);
          if Dif <> 0 then begin
            qryParcelasContratos.First;
            while not qryParcelasContratos.Eof do begin
              if qryParcelasContratosdatapagto.AsDateTime = 0 then begin
                qryParcelasContratos.Edit;
                qryParcelasContratosValorVencto.AsCurrency :=  qryParcelasContratosValorVencto.AsCurrency + Dif;
                qryParcelasContratos.Post;
                FValorAberto:= FValorAberto + Dif;
                Break;
              end;
              qryParcelasContratos.Next
            end;
          end;
        end;

      end
    end
    else begin
      FValorAberto:= 0;
      if FValorVista = 0 then begin
        FDevolvePagto  := FPagoReal;
        FDevolveVencto:= FPagoVencto;
      end;
      ReFazConsulta(qryParcelasContratos,  [0],[qryContratosTrocanumero.AsString]);
    end;
  end
  else begin
    ReFazConsulta(qryParcelasContratos,[0],[qryContratosTrocanumero.AsString]);
    FValorAberto:= 0;
    for a:= 0 to Length(NewParcelas)-1 do begin
      if NewParcelas[A].DataPagto = 0 then
        FValorAberto:= FValorAberto + NewParcelas[A].ValorVencto;
    end;
    FDevolvePagto  := 0;
    FDevolveVencto:= 0;
  end;

  *)

end;

procedure TdtmTrocaMercadorias.CalcularNovasParcelas(Devolvido: Currency);
Var
  I,NrVezes : Integer;
  Dif,
  DesctoAtual,
  DesctoUltimo,
  ValorPresente,
  TotalContrato : Currency;
  Prest: Currency;
begin
  if (FValorVista <> 0) then begin
    DesctoAtual := 999999.99;
    ReFazConsulta(qryParcelasContratos,  [0],[qryContratosTrocanumero.AsString]);
    ReFazConsulta(qryPlanosPagamento,[0],[qryContratosTrocaplano.AsInteger]);
    repeat
      NrVezes:= 0;
      DesctoUltimo:= Abs(DesctoAtual*100);
      qryParcelasContratos.DisableControls;
      try
        qryParcelasContratos.First;
        ValorPresente := 0;     TotalContrato := 0;
        for I:= 1 to qryParcelasContratos.RecordCount do begin
          if (qryParcelasContratosdatapagto.AsDateTime = 0) then begin
            Inc(NrVezes);
            TotalContrato:= TotalContrato + qryParcelasContratosvalorvencto.AsCurrency;
            ValorPresente:= ValorPresente + RoundTo(qryParcelasContratosvalorvencto.AsCurrency /
                                                    Power(tecFinanceira.TaxaDiaria(qryContratosTrocataxajuros.AsCurrency),
                                                    DaysBetween(qryParcelasContratosdatavencto.AsDateTime,qryContratosTrocafaturamento.AsDateTime)),-2);
          end;
          qryParcelasContratos.Next;
        end;
      finally
        qryParcelasContratos.EnableControls;
      end;

//      DesctoAtual:= (FValorVista {+ FValorFrete + FValorSeguro} - FPagoReal + FDevolvePagto) - ValorPresente;
      DesctoAtual:= (FValorVista {+ FValorFrete + FValorSeguro} + FDevolveReal) - ValorPresente;

      if (Abs(DesctoAtual*100) > qryPlanosPagamentoquantidadeparcelas.AsInteger) and (Abs(DesctoAtual*100) < DesctoUltimo) then begin
        FValorAberto:= 0;
        qryParcelasContratos.DisableControls;
        try
          qryParcelasContratos.First;
          for I:= 1 to qryParcelasContratos.RecordCount do begin
            if qryParcelasContratosdatapagto.AsDateTime = 0 then begin
              qryParcelasContratos.Edit;
              if TotalContrato <> 0 then
                   Prest:= RoundTo(((DesctoAtual / TotalContrato) * qryParcelasContratosvalorvencto.AsCurrency) +
                                                                    qryParcelasContratosvalorvencto.AsCurrency,-2)
              else Prest:= RoundTo((qryParcelasContratosvalorvencto.AsCurrency + (DesctoAtual / NrVezes)),-2);
              qryParcelasContratosvalorvencto.AsCurrency:= Prest;
              FValorAberto:= FValorAberto + qryParcelasContratosvalorvencto.AsCurrency;
              qryParcelasContratos.Post;
            end;
            qryParcelasContratos.Next;
          end;
        finally
          qryParcelasContratos.EnableControls;
        end;
      end;
    until (Abs(DesctoAtual*100) <= qryPlanosPagamentoquantidadeparcelas.AsInteger) or (Abs(DesctoAtual*100) >= DesctoUltimo);

    if (qryPlanosPagamentotaxamensaljuros.AsFloat = 0) and ((FValorVista - FValorAberto) <> 0) then begin
      try
        qryParcelasContratos.First;
        while not qryParcelasContratos.Eof do begin
          if qryParcelasContratosDataPagto.AsDateTime = 0 then begin
            qryParcelasContratos.Edit;
            qryParcelasContratosValorVencto.AsCurrency :=  qryParcelasContratosValorVencto.AsCurrency +
                                                           (FValorVista - FValorAberto);
            qryParcelasContratos.Post;
            break;
          end;
          qryParcelasContratos.Next
        end;
      finally
        qryParcelasContratos.EnableControls;
        FValorAberto:= FValorVista;
      end;
    end;

    if ((qryContratosTrocavalorprodutos.AsCurrency - qryContratosTrocavalorprazo.AsCurrency) = 0) then begin
      Dif:= qryContratosTrocavalorprodutos.AsCurrency - (Devolvido + FValorAberto + FPagoVencto);
      if Dif <> 0 then begin
        qryParcelasContratos.First;
        while not qryParcelasContratos.Eof do begin
          if qryParcelasContratosdatapagto.AsDateTime = 0 then begin
            qryParcelasContratos.Edit;
            qryParcelasContratosValorVencto.AsCurrency :=  qryParcelasContratosValorVencto.AsCurrency + Dif;
            qryParcelasContratos.Post;
            FValorAberto:= FValorAberto + Dif;
            Break;
          end;
          qryParcelasContratos.Next
        end;
      end;
    end;
  end;
end;

procedure TdtmTrocaMercadorias.CalcularPrestacoesReais;
(*
var
  ValorBase: Currency;
  NP: Integer;
begin
{  if ContratoAVista then
begin
    FPagoVencto    := qryContratosTrocavalorprazo.AsCurrency;
    FPagoReal      := qryContratosTrocavalorprazo.AsCurrency;
    FDevolveVencto := qryContratosTrocavalorprazo.AsCurrency;
    FDevolvePagto   := qryContratosTrocavalorprazo.AsCurrency;
  end
  else begin
    FPagoVencto    := 0;
    FPagoReal      := 0;
    FDevolveVencto := 0;
    FDevolvePagto   := 0;
  end; }
  FPagoVencto    := 0;
  FPagoReal      := 0;
  FDevolveVencto := 0;
  FDevolvePagto   := 0;

  if {not ContratoAVista and} (qryParcelasContratos.RecordCount > 0) then begin
    ValorBase:= 0;
    qryParcelasContratos.DisableControls;
    try
      qryParcelasContratos.First;
      for NP:= 1 to qryParcelasContratos.RecordCount do begin
        if (qryParcelasContratosdatapagto.AsCurrency <> 0) then
          if ((qryParcelasContratostipopagto.AsString = '') or
              (qryParcelasContratostipopagto.AsString = 'B')) {and
             (qryParcelasContratosformapagamento.AsString<>'T')} then
          begin
            FPagoVencto:= FPagoVencto + qryParcelasContratosvalorvencto.AsCurrency;
            if (qryContratosTrocaorigem.AsString = '') then
              FPagoReal := FPagoReal +
                           RoundTo(qryParcelasContratosvalorvencto.AsCurrency /
                                   Power(tecFinanceira.TaxaDiaria(qryContratosTrocataxajuros.AsCurrency),
                                         DaysBetween(qryParcelasContratosdatavencto.AsDateTime,
                                                     qryContratosTrocafaturamento.AsDateTime)),-2)
            else
              FPagoReal := FPagoReal + qryParcelasContratosvalorvencto.AsCurrency;
          end
          else
          begin
            if (qryParcelasContratostipopagto.AsString<>'') then
              if (not (qryParcelasContratostipopagto.AsString[1] in ['P','X'])) then
              ValorBase:= ValorBase + qryParcelasContratosvalorvencto.AsCurrency;
          end;
        qryParcelasContratos.Next;
      end;
      if qryContratosTrocataxajuros.AsFloat = 0 then
        FPagoReal:= RoundTo((FPagoVencto * FOldValorVista) / FValorPrazo,-2);
    finally
      qryParcelasContratos.EnableControls;
    end;
    AtualizaValores;
  end;
end;
*)

var
{  ValorBase: Currency;}
  NP: Integer;
begin
  FPagoVencto    := 0;
  PagoCreditoTroca := 0;

  if (qryParcelasContratos.RecordCount > 0) then begin
{    ValorBase:= 0;}
    qryParcelasContratos.DisableControls;
    try
      qryParcelasContratos.First;
      for NP:= 1 to qryParcelasContratos.RecordCount do
      begin
        if (qryParcelasContratosdatapagto.AsCurrency <> 0) then
          if ((qryParcelasContratostipopagto.AsString = '') or
              (qryParcelasContratostipopagto.AsString = 'B')) then
          begin
            if (qryParcelasContratosformapagamento.AsString<>'T') then
              FPagoVencto:= FPagoVencto + qryParcelasContratosvalorvencto.AsCurrency
            else
              PagoCreditoTroca:= PagoCreditoTroca + qryParcelasContratosvalorvencto.AsCurrency
          end;
        qryParcelasContratos.Next;
      end;
    finally
      qryParcelasContratos.EnableControls;
    end;
    AtualizaValores;
  end;
end;

procedure TdtmTrocaMercadorias.ConsultarDadosFiscais;
begin
  dsrDadosFiscais.OnDataChange:= Nil;
  if qryDadosFiscais.Active then
    qryDadosFiscais.Close;

  qryDadosFiscais.MacroByName('FiltroNotas').asstring  := '';
  qryDadosFiscais.MacroByName('FiltroCupons').asstring := '';
  qryDadosFiscais.Params[0].AsString:= IntToStr(qryProdutosContratosTrocaproduto.AsLargeInt);
  qryDadosFiscais.Params[1].AsInteger := qryProdutosContratosTrocafilial.AsInteger;
  if qryContratosTrocaprimogenito.AsString <> '' then
       qryDadosFiscais.Params[2].AsString:= qryContratosTrocaprimogenito.AsString
  else qryDadosFiscais.Params[2].AsString:= qryContratosTrocanumero.AsString;
  qryDadosFiscais.Open;

  if (qryDadosFiscais.RecordCount = 1) then
  begin
    if dadosfiscaisok then
    begin
      qryDadosFiscais.Edit;
      qryDadosFiscaisdevolver.AsCurrency:= qryProdutosContratosTrocaqtdeentregueparadevolver.AsCurrency;
      qryDadosFiscais.Post;

      qryProdutosContratosTroca.Edit;
      qryProdutosContratosTrocavalorreducaobaseunitaria.AsCurrency := qryDadosFiscaisvalorreducaobaseunitaria.AsCurrency;
      qryprodutosContratosTroca.Post;
    end;
  end;

  dsrDadosFiscais.OnDataChange:= dsrDadosFiscaisDataChange;
end;

function TdtmTrocaMercadorias.PreencherProdutosNotasFiscal(TipoNota: TtecTipoNota; var Numero: Integer): Boolean;
var
  i, j, QtItemsNota, QtItemsNotaSerie: integer;
begin
  result := false;
  case TipoNota of

    tnDEVOLUCAO_COMCONTRATO :
    begin
      QtItemsNota := length(produtoseServicos[produtos]);
      for i := 0 to QtItemsNota-1 do
      begin
        if ProdutoseServicos[Produtos][i].RegistroOK and (ProdutoseServicos[Produtos][i].produto = qryProdutosTrocadosproduto.AsLargeInt) then
        begin
          Numero := Numero + 1;
          qryProdutosNotasPag.Append;

          qryProdutosNotasPagcodigonota.AsInteger       := Ord(TipoNota);

          qryProdutosNotasPagcontrato.asString := ProdutoseServicos[Produtos][i].contrato;
          qryProdutosNotasPagdadofiscal.asInteger := ProdutoseServicos[Produtos][i].dadofiscal;
          qryProdutosNotasPagnumeroprodutotabela.AsInteger := ProdutoseServicos[Produtos][i].numeroprodutotabela;
          qryProdutosNotasPagnumeronotafiscalsaida.asinteger := ProdutoseServicos[Produtos][i].numeronotafiscalsaida;
          if qryProdutosNotasPagnumeronotafiscalsaida.asinteger = 0 then
            qryProdutosNotasPagnumeronotafiscalsaida.clear;

          qryProdutosNotasPagnumero.AsInteger       := Numero;
          qryProdutosNotasPagfilial.AsInteger       := ifthen(TipoFilial<>'V', FilialBase, ProdutoseServicos[Produtos][i].filial);
          qryProdutosNotasPagProduto.AsLargeInt     := ProdutoseServicos[Produtos][i].produto;
          qryProdutosNotasPagProdutovisual.AsString := ProdutoseServicos[Produtos][i].produtovisual;

          qryProdutosNotasPagdescricaoproduto.AsString := ProdutoseServicos[Produtos][i].descricaoproduto;
          if {CreditarICMS} false then
            qryProdutosNotasPagaliquotaicms.AsFloat  := ProdutoseServicos[Produtos][i].aliquotaicms
          else qryProdutosNotasPagaliquotaicms.AsFloat  := 0;
          qryProdutosNotasPagquantidade.AsCurrency      := ProdutoseServicos[Produtos][i].qtdeentregueparadevolver;
          qryProdutosNotasPagprecovenda.AsCurrency      := ProdutoseServicos[Produtos][i].PrecoVenda;
          qryProdutosNotasPagvalorreducaobase.AsCurrency := ProdutoseServicos[Produtos][i].valorreducaobaseunitaria *
                                                            qryProdutosNotasPagquantidade.AsCurrency;
          qryProdutosNotasPagincidencia.AsString         := ProdutoseServicos[Produtos][i].incidencia;
          qryProdutosNotasPagcsosn.AsString              := ProdutoseServicos[Produtos][i].csosn;

          if ProdutoseServicos[Produtos][i].ipicst<>'' then
            if strtoint(ProdutoseServicos[Produtos][i].ipicst)>=50 then
              qryProdutosNotasPagipicst.asstring := Format('%.2d', [(strtoint(ProdutoseServicos[Produtos][i].ipicst) - 50)])
            else
              qryProdutosNotasPagipicst.asstring := ProdutoseServicos[Produtos][i].ipicst;

          qryProdutosNotasPagacrescimo.AsCurrency := ProdutoseServicos[Produtos][i].Acrescimo;
          qryProdutosNotasPagdesconto.AsCurrency  := ProdutoseServicos[Produtos][i].desconto;
          qryProdutosNotasPagvalordescontoitem.AsCurrency := ProdutoseServicos[Produtos][i].valordescontoitem;

          if DevolverFrete then
            qryProdutosNotasPagfrete.AsCurrency   := ProdutoseServicos[Produtos][i].frete;
          if DevolverSeguro then
            qryProdutosNotasPagseguro.AsCurrency  := ProdutoseServicos[Produtos][i].seguro;

          if NotaSubstituicao(ifthen((regimetributario=1),qryProdutosNotasPagcsosn.AsString,qryProdutosNotasPagincidencia.AsString)) then
            SelecionarDadosNaturezaPadrao(noDEVOLUCAOMERCADORIASUBSTTRIB, nil, qryprodutosnotaspag, qryProcuraClienteSelecao, Devolucao, '',
            not ( ((ProdutoseServicos[Produtos][i].eHCupomFiscal) or
                   (ProdutoseServicos[Produtos][i].modelodocto='65'))  and
                 (EstadoFilialBase<>qryProcuraClienteSelecaoestado.AsString))
            and not qryProdutosNotasPagdadofiscal.isnull)
          else
            SelecionarDadosNaturezaPadrao(noDEVOLUCAOMERCADORIA, nil, qryprodutosnotaspag, qryProcuraClienteSelecao, Devolucao, '',
            not ( ((ProdutoseServicos[Produtos][i].eHCupomFiscal) or
                   (ProdutoseServicos[Produtos][i].modelodocto='65'))  and
                 (EstadoFilialBase<>qryProcuraClienteSelecaoestado.AsString))
            and not qryProdutosNotasPagdadofiscal.isnull);

          qryProdutosNotasPagexigenotareferenciada.asboolean := exigenotareferenciada(qryProdutosNotasPagcodigofiscal.AsInteger);

          qryProdutosNotasPagicmsbasecalculo.AsFloat    := ProdutoseServicos[Produtos][i].icmsbasecalculo;
          qryProdutosNotasPagicmsvalor.AsFloat          := ProdutoseServicos[Produtos][i].icmsvalor;
          qryProdutosNotasPagicmsmodalidade.AsInteger   := ProdutoseServicos[Produtos][i].icmsmodalidade;
          qryProdutosNotasPagicmsmodsubst.AsInteger     := ProdutoseServicos[Produtos][i].icmsmodsubst;
          qryProdutosNotasPagaliquotaicmsst.AsFloat     := ProdutoseServicos[Produtos][i].aliquotaicmsst;
          qryProdutosNotasPagicmsvalorst.AsFloat        := ProdutoseServicos[Produtos][i].icmsvalorst;
          qryProdutosNotasPagicmsbasecalculost.AsFloat  := ProdutoseServicos[Produtos][i].icmsbasecalculost;

          qryProdutosNotasPagipibasecalculo.AsFloat     := ProdutoseServicos[Produtos][i].ipibasecalculo;
          qryProdutosNotasPagvaloripi.AsFloat           := ProdutoseServicos[Produtos][i].valoripi;

          qryProdutosNotasPagiibasecalculo.AsFloat      := ProdutoseServicos[Produtos][i].iibasecalculo;
          qryProdutosNotasPagiidespaduaneira.AsFloat    := ProdutoseServicos[Produtos][i].iidespaduaneira;
          qryProdutosNotasPagiivalor.AsFloat            := ProdutoseServicos[Produtos][i].iivalor;
          qryProdutosNotasPagiiiof.AsFloat              := ProdutoseServicos[Produtos][i].iiiof;

          qryProdutosNotasPagpisbasecalculo.AsFloat     := ProdutoseServicos[Produtos][i].pisbasecalculo;
          qryProdutosNotasPagpisaliquota.AsFloat        := ProdutoseServicos[Produtos][i].pisaliquota;
          qryProdutosNotasPagpisvalor.AsFloat           := ProdutoseServicos[Produtos][i].pisvalor;

          qryProdutosNotasPagcofinsbasecalculo.AsFloat  := ProdutoseServicos[Produtos][i].cofinsbasecalculo;
          qryProdutosNotasPagcofinsaliquota.AsFloat     := ProdutoseServicos[Produtos][i].cofinsaliquota;
          qryProdutosNotasPagcofinsvalor.AsFloat        := ProdutoseServicos[Produtos][i].cofinsvalor;

          qryProdutosNotasPagunidade.AsString           := ProdutoseServicos[Produtos][i].unidade;
          qryProdutosNotasPagorigem.AsString            := ProdutoseServicos[Produtos][i].origem;
          qryProdutosNotasPagextipi.AsString            := ProdutoseServicos[Produtos][i].extipi;
          qryProdutosNotasPaggenero.AsInteger           := ProdutoseServicos[Produtos][i].genero;
          qryProdutosNotasPagtribcodigoean.AsString     := ProdutoseServicos[Produtos][i].tribcodigoean;
          qryProdutosNotasPagtribunidade.AsString       := ProdutoseServicos[Produtos][i].tribunidade;
          qryProdutosNotasPagtribquantidade.AsFloat     := ProdutoseServicos[Produtos][i].tribquantidade;
          qryProdutosNotasPagtribunitario.AsFloat       := ProdutoseServicos[Produtos][i].tribunitario;
          qryProdutosNotasPagenquadramento.AsInteger    := ProdutoseServicos[Produtos][i].enquadramento;
          qryProdutosNotasPagclassificacaofiscal.AsString := ProdutoseServicos[Produtos][i].classificacaofiscal;
          qryProdutosNotasPagvendedor.AsVariant           := ProdutoseServicos[Produtos][i].vendedor;
          qryProdutosNotasPagvendedordadofiscal.AsVariant := ProdutoseServicos[Produtos][i].vendedordadofiscal;

          result := AtribuirDadosProdutos(qryprodutosNotasPag, qryNotasPag, nil, false, Devolucao);

          if not DevolverFrete then
            qryprodutosNotasPagfrete.asCurrency := 0;

          qryProdutosNotasPagprecounitario.AsCurrency := ProdutoseServicos[Produtos][i].PrecoVenda; { qryProdutosContratosprecovenda.AsCurrency};

          if result then
          begin
            QtItemsNotaSerie := length(ProdutoseServicos[Produtos][i].numeroserie);
            for j := 0 to QtItemsNotaSerie-1 do
            begin
              qryProdutosNotasPagSeries.append;
              qryProdutosNotasPagSeriescodigonota.AsInteger := qryProdutosNotasPagcodigonota.AsInteger;
              qryProdutosNotasPagSeriesnumero.asinteger :=  qryProdutosNotasPagnumero.AsInteger;
              qryProdutosNotasPagSeriesproduto.asLargeint :=  qryProdutosNotasPagProduto.AsLargeInt;
              qryProdutosNotasPagSeriescodigovisual.asString := qryprodutosnotaspagprodutovisual.asString;
              qryProdutosNotasPagSeriesnumeroserie.asString :=  ProdutoseServicos[Produtos][i].numeroserie[j].numeroserie;
              qryProdutosNotasPagSeries.post;
            end;
          end;

          if result then  // Atribuido em SelecionarCodigoNatureza();
            qryProdutosNotasPag.Post
          else
            qryProdutosNotasPag.Cancel;

        end;
      end;
    end;

    tnDEVOLUCAO_SEMCONTRATO :
    begin
      Numero := Numero + 1;
      qryProdutosNotasPag.Append;

      if qryProdutosTrocadosdadofiscal.AsInteger <> 0 then
        qryProdutosNotasPagdadofiscal.asInteger := qryProdutosTrocadosdadofiscal.AsInteger;

      if qryProdutosTrocadosnumeroprodutotabela.AsInteger <> 0 then
        qryProdutosNotasPagnumeroprodutotabela.asInteger := qryProdutosTrocadosnumeroprodutotabela.AsInteger;

      qryProdutosNotasPagcodigonota.AsInteger       := Ord(TipoNota);
      qryProdutosNotasPagnumero.AsInteger           := Numero;
      qryProdutosNotasPagfilial.AsInteger           := ifthen(TipoFilial<>'V', FilialBase, qryProdutosTrocadosfilial.AsInteger);
      qryProdutosNotasPagproduto.AsLargeInt         := qryProdutosTrocadosproduto.AsLargeInt;
      qryProdutosNotasPagdescricaoproduto.AsString  := qryProdutosTrocadosdescricaproduto.AsString;

      if qryProdutosTrocadosdadofiscal.AsInteger <> 0 then
        qryProdutosNotasPagprecounitario.AsCurrency   := qryProdutosTrocadosprecovenda.AsCurrency
      else
        qryProdutosNotasPagprecounitario.AsCurrency   := qryProdutosTrocadosprecoavaliado.AsCurrency;

      qryProdutosNotasPagPrecoVenda.AsCurrency  := qryProdutosTrocadosprecovenda.AsCurrency;
      qryProdutosNotasPagdesconto.AsCurrency := qryProdutosTrocadosdescontounitario.AsCurrency;
      qryProdutosNotasPagvalordescontoitem.AsCurrency := qryProdutosTrocadosvalordescontoitemunitario.AsCurrency;

      qryProdutosNotasPagquantidade.AsCurrency       := qryProdutosTrocadosquantidade.AsCurrency;
      qryProdutosNotasPagvalorreducaobase.AsCurrency := qryProdutosTrocadosvalorreducaobaseunitaria.AsCurrency *
                                                        qryProdutosNotasPagquantidade.AsCurrency;
      qryProdutosNotasPagincidencia.AsString        := qryProdutosTrocadosincidencia.AsString;
      qryProdutosNotasPagcsosn.AsString        := qryProdutosTrocadoscsosn.AsString;
      qryProdutosNotasPagaliquotaicms.AsFloat       := qryProdutosTrocadosaliquotaicms.AsFloat;
      if NotaSubstituicao(ifthen((regimetributario=1),qryProdutosNotasPagcsosn.AsString,qryProdutosNotasPagincidencia.AsString)) then
        SelecionarDadosNaturezaPadrao(noDEVOLUCAOMERCADORIASUBSTTRIB, nil, qryprodutosnotaspag, TTecQuery(dsrContratos.DataSet), Troca, '',
        not ( ((qryProdutosTrocadosehCupomFiscal.asBoolean) or
               (qryProdutosTrocadosModelodocto.asString = '65')) and
              (EstadoFilialBase <> dsrContratos.DataSet.fieldbyname('estado').asString))
             and not qryProdutosNotasPagdadofiscal.isnull  )
      else
        SelecionarDadosNaturezaPadrao(noDEVOLUCAOMERCADORIA, nil, qryprodutosnotaspag, TTecQuery(dsrContratos.DataSet), Troca, '',

        not ( ((qryProdutosTrocadosehCupomFiscal.asBoolean) or
               (qryProdutosTrocadosModelodocto.asString = '65')) and
             (EstadoFilialBase <> dsrContratos.DataSet.fieldbyname('estado').asString))
            and not qryProdutosNotasPagdadofiscal.isnull);

      qryProdutosNotasPagexigenotareferenciada.asboolean := exigenotareferenciada(qryProdutosNotasPagcodigofiscal.AsInteger);
      qryProdutosNotasPagicmsmodalidade.AsInteger   := qryProdutostrocadosicmsmodalidade.AsInteger;
      qryProdutosNotasPagicmsmodsubst.AsInteger     := qryProdutosTrocadosicmsmodsubst.AsInteger;
      qryProdutosNotasPagaliquotaipi.AsFloat        := qryProdutosTrocadosaliquotaipi.AsFloat;
      qryProdutosNotasPagpisaliquota.AsFloat        := qryProdutosTrocadospisaliquota.AsFloat;
      qryProdutosNotasPagcofinsaliquota.AsFloat     := qryProdutosTrocadoscofinsaliquota.AsFloat;
      qryProdutosNotasPagunidade.AsString           := qryProdutosTrocadosunidade.AsString;
      qryProdutosNotasPagorigem.AsString            := qryProdutosTrocadosorigem.AsString;
      qryProdutosNotasPagextipi.AsString            := qryProdutosTrocadosextipi.AsString;
      qryProdutosNotasPaggenero.AsInteger           := qryProdutosTrocadosgenero.AsInteger;
      qryProdutosNotasPagtribunidade.AsString       := qryProdutosTrocadosunidade.AsString;
      qryProdutosNotasPagtribquantidade.AsFloat     := qryProdutosTrocadosquantidade.AsFloat;
      qryProdutosNotasPagtribunitario.AsFloat       := qryProdutosTrocadosprecovenda.AsFloat;
      qryProdutosNotasPagenquadramento.AsString    := '999';
      qryProdutosNotasPagvendedor.AsVariant           := qryProdutosTrocadosvendedor.AsVariant;
      qryProdutosNotasPagvendedordadofiscal.AsVariant := qryProdutosTrocadosvendedordadofiscal.AsVariant;

      qryProdutosNotasPagclassificacaofiscal.AsString := qryProdutosTrocadosclassificacaofiscal.AsString;
      result := AtribuirDadosProdutos(qryprodutosNotasPag, qryNotasPag, nil, false, Troca);

      //A função acima atribui um valor diferente, visto que não é vinculado... manter a linha abaixo
      if qryProdutosTrocadosdadofiscal.AsInteger <> 0 then
        qryProdutosNotasPagprecounitario.AsCurrency   := qryProdutosTrocadosprecovenda.AsCurrency
      else
        qryProdutosNotasPagprecounitario.AsCurrency   := qryProdutosTrocadosprecoavaliado.AsCurrency;

      qryProdutosNotasPagPrecoVenda.AsCurrency  := qryProdutosTrocadosprecovenda.AsCurrency;
      qryProdutosNotasPagdesconto.AsCurrency := qryProdutosTrocadosdescontounitario.AsCurrency;
      qryProdutosNotasPagvalordescontoitem.AsCurrency := qryProdutosTrocadosvalordescontoitemunitario.AsCurrency;

      if not DevolverFrete then
        qryprodutosNotasPagfrete.asCurrency := 0;



      if result then
        qryProdutosNotasPag.Post
      else
        qryProdutosNotasPag.Cancel;
    end;

  end;
end;

{
procedure TdtmTrocaMercadorias.PreencherNotasPagDadosFiscais;
begin
  dsrDadosFiscais.OnDataChange:= nil;
  if qryNotasPagDadosFiscais.State = dsInactive then
    qryNotasPagDadosFiscais.Open;

  qryDadosFiscais.First;
  while not qryDadosFiscais.Eof do begin
    if (qryDadosFiscaisdevolver.AsCurrency > 0) then begin
      qryNotasPagDadosFiscais.Insert;
      qryNotasPagDadosFiscaisdadofiscal.AsInteger  := qryDadosFiscaisdadofiscal.AsInteger;
      qryNotasPagDadosFiscaisproduto.AsLargeInt    := qryProdutosContratosTrocaproduto.AsLargeInt;
      qryNotasPagDadosFiscaisfilial.AsInteger      := qryProdutosContratosTrocafilial.AsInteger;
      qryNotasPagDadosFiscaisquantidade.AsCurrency := qryDadosFiscaisdevolver.AsCurrency;
      qryNotasPagDadosFiscais.Post;
    end;
    qryDadosFiscais.Next;
  end;
  dsrDadosFiscais.OnDataChange:= dsrDadosFiscaisDataChange;
end;
}


{
procedure TdtmTrocaMercadorias.ExcluirNotasPagDadosFiscais;
begin
  if qryNotasPagDadosFiscais.Active then begin
    qryNotasPagDadosFiscais.First;
    while not qryNotasPagDadosFiscais.Eof do begin
      if (qryNotasPagDadosFiscaisproduto.AsLargeInt = qryProdutosContratosTrocaproduto.AsLargeInt) and
         (qryNotasPagDadosFiscaisfilial.AsInteger = qryProdutosContratosTrocafilial.AsInteger) then
        qryNotasPagDadosFiscais.Delete
      else qryNotasPagDadosFiscais.Next;
    end;
  end;
end;
}

procedure TdtmTrocaMercadorias.CancelarTroca;
begin
  CancelarAtualizacoes([qryContratosTroca        ,
                        qryParcelasContratos     ,
                        qryProdutosContratosTroca,
                        qryPrecos                ,
                        qryProdutos         ,
                        qryEstoques         ,
                        qryMovimentos,
                        qryNotasPag   ,
                        qryProdutosNotasPag ,
{                        dtmGerarNotaFiscal.qryCalculosNotasPag ,}
                        qryNumeroNota,
                        qryContratosDevolvidos,
                        {qryNotasPagDadosFiscais,}
                        qrycontratos,
                        qryprodutoscontratos,
                        qryparcelas,
                        qryprodutostrocados
                        ]);
  TemProdutoImprimirNotaDevolucao := false;
  TemProdutoImprimirNotaCompra := false;
end;

constructor TdtmTrocaMercadorias.Create(AOwner: TComponent);
begin
  try

    inherited;

    if parsistema.IncluirOrcamentonosItensdaTroca then
    begin
     dsrContratos.DataSet := qryOrcamentos;
     dsrProdutosContratos.DataSet := qryProdutosOrcamentos;
    end
    else
    begin
     dsrContratos.DataSet := qryContratos;
     dsrProdutosContratos.DataSet := qryProdutosContratos;
    end;


    qryProcuraClienteSelecao.Tag  := ctTabelas;
    qryProcuraCliente.tag         := ctTabelas;
    qryProdutosTrocados.Tag       := ctTabelas;
    qryProdutosTrocadosSaida.Tag  := ctTabelas;
    qryPlanoPagamento.tag         := ctTabelas;
    qryPlanoPagamento.Params[0].AsInteger := ParSistema.PlanoVendaVista;

    qryProdutosContratosTroca.ParamByName('estado').AsString   := EstadoFilialBase;
    InserindoCalculos:= False;
    FVendedorDefault                    := 0;
    qryContratos.Tag                    := ctVendaTabelaCadastroContrato;
    qryConsultaClientes.Tag             := ctVendaTabelaConsultaClientes;
    qryConsultaProdutos.Tag             := ctVendaTabelaConsultaProdutos;
    qryConsultaProdutos.ParamByName('PrecodaFilialBase').AsBoolean := ParSistema.UtilizarPrecoFilialBase;
    qryConsultaProdutos.ParamByName('FilialBase').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);

    Operacao := 'S';
    DefinirParametrosFiliais;

    qryConsultaFilialProduto.Tag        := ctVendaTabelaConsultaFilialProduto;
    qryConsultaReservasProduto.Tag      := ctVendaTabelaConsultaReservas;
    qryConsultaVendedores.Tag           := ctVendaTabelaConsultaVendedores;

    qryContratospessoanumero.Required   := ParSistema.CPF_CNPJObrigatorio;

    qryProdutosContratos.Params[0].AsString   := EstadoFilialBase;
    qryProcuraCliente.Params[1].AsString    := 'C';
    qryProcuraClienteSelecao.Params[1].AsString := 'C';
    qryProcuraProduto.ParamByName('estado').AsString    := EstadoFilialBase;
    qryProcuraProduto.ParamByName('filialbase').AsString    := IntToStr(ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual));
    qryProcuraProduto.MacrobyName('filialsaida').AsString    := IntToStr(ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual));
    qryProcuraProduto.ParamByName('FilialPreco').AsString    := IntToStr(ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual));
    qryProdutoEstoque.ParamByName('FilialPreco').AsString := IntToStr(ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual));

    if UsuarioLogin.Vendedor then
    begin
      qryProcuraReservaProduto.Params[0].AsInteger   := CodigoUsuario;
      qryConsultaReservasProduto.Params[0].AsInteger := CodigoUsuario;
    end;

    if ParSistema.SoVisualizarEstoqueDeposito then
     qryEstoque.Sql[4] := SQLEstoquesDeposito
    else
     qryEstoque.Sql[4] := '';


    qryProdutoEstoque.ParamByname('ConsiderarmarkupClientes').AsBoolean   := ParSistema.ConsiderarMarkupClientes;
    qryProdutoEstoque.ParamByName('ConsiderarMarkupCargos').AsBoolean   := ParSistema.PrecosporCargo;
    qryProdutoEstoque.ParamByName('Filial').AsInteger   := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);

    qryConsultaProdutos.ParamByName('ConsiderarMarkupCliente').AsBoolean := ParSistema.ConsiderarMarkupClientes;
    qryConsultaProdutos.ParamByName('PrecodaFilialBase').AsBoolean := ParSistema.UtilizarPrecoFilialBase;
    qryConsultaProdutos.ParamByName('FilialBase').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
    qryConsultaProdutos.ParamByName('ConsiderarMarkupCargos').AsBoolean := ParSistema.PrecosporCargo;
    qryProcuraProduto.ParamByName('ConsiderarMarkupClientes').AsBoolean   := ParSistema.ConsiderarMarkupClientes;
    qryProcuraProduto.ParamByName('ConsiderarMarkupcargos').AsBoolean   := ParSistema.PrecosporCargo;

    qryContratostotalqtdeprodutosatrocar.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
    qryOrcamentostotalqtdeprodutosatrocar.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
    qryContratostotalqtdeprodutos.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
    qryProdutoEstoqueemestoque.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
    qryEstoqueBloqueioemestoque.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
    qryProdutosSimilaresemestoque.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
    qryProdutosSimilaresreservado.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
    qryProdutosContratosTrocaquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
    qryProdutosContratosTrocacancelado.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
    
    qryProdutosContratosTrocadevolver.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
    qryProdutosContratosTrocadevolver.EditFormat := ParSistema.MascaraQuantidadeGrade;

    qryProdutosContratosTrocaqtdeentregue.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
    qryProdutosContratosTrocaqtdeentregueparadevolver.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
    qryProdutosContratosquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
    qryProdutosTrocadosquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
    qryProdutosNotasPagquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;

  {  if not assigned(dtmGerarNotaFiscal) then
    begin
      dtmGerarNotaFiscal := tdtmGerarNotaFiscal.create(self);
      dtmGerarNotaFiscal.qryCalculosNotasPag.MasterSource := dsrNotasPag;
      dtmGerarNotaFiscal.qryCalculosNotasPag.LinkFields := 'codigo=codigonota';
      dsrCalculosNotasPag.DataSet :=  dtmGerarNotaFiscal.qryCalculosNotasPag;
    end;
   }
    qryCalculosProdutos.ParamByName('SimplesNacional').AsBoolean := (RegimeTributario = 1);
    qryCalculosProdutos.ParamByName('ContribIPI').AsBoolean := contribipi;

    qryProdutosTrocadosprecoavaliado.readonly:=ParSistema.NaoPermitirAlterarPrecoAvaliadoTroca;


  except
    on E: Exception do ShowMessage(E.Message);
  end;


end;

destructor TdtmTrocaMercadorias.Destroy;
begin
 try
  CancelarTroca;
  dtmVisualizarSaldoTroca.Free;
  inherited;
  dtmTrocaMercadorias := nil;
 except
   on E: Exception do ShowMessage(E.Message);
 end;
end;

procedure TdtmTrocaMercadorias.dsrProdutosContratosTrocaDataChange(Sender: TObject; Field: TField);
var
  msg: string;
  Pos: TBookmark;
  Entregar: Currency;
begin
  if Field = qryProdutosContratosTrocaprecovenda then
  begin
    dsrProdutosContratosTroca.OnDataChange := nil;
    if Field.AsCurrency = 0 then msg:= 'maior que zero'
    else                         msg:= 'menor ou igual ' + FloatToStr(qryProdutosContratosTrocaprecovendaaux.asCurrency {ProdutoseServicos[Produtos][qryProdutosContratosTroca.CurRec].Preco});

    if (Field.AsCurrency > {ProdutoseServicos[Produtos][qryProdutosContratosTroca.CurRec].Preco} qryProdutosContratosTrocaprecovendaaux.ascurrency ) then
    begin
      MensagemAviso(Format(ctPRECOADEVOLVER,[msg]));
      qryProdutosContratosTroca.Cancel;
      Field.FocusControl;
    end
    else begin
      if qryProdutosContratosTrocaproduto.AsLargeInt > 0 then
        if (Field.AsCurrency > 0) then begin
          AtualizaValores;
//          if qryProdutosContratosTroca.State in [dsBrowse] then
//            qryProdutosContratosTroca.Edit;
        end
        else begin
          MensagemAviso(Format(ctPRECOADEVOLVER,[msg]));
          qryProdutosContratosTroca.Cancel;
          Field.FocusControl;
        end;
    end;
    dsrProdutosContratosTroca.OnDataChange := dsrProdutosContratosTrocaDataChange;
  end
  else
  if field = qryProdutosContratosTrocadefeito then
  begin
    dsrProdutosContratosTroca.OnDataChange := nil;
    if not RecuperandoTrocaEfetuada then
      GuardarProdutoaTrocar;
    dsrProdutosContratosTroca.OnDataChange := dsrProdutosContratosTrocaDataChange;
  end
  else
  if Field = qryProdutosContratosTrocadevolver then
  begin
    dsrProdutosContratosTroca.OnDataChange := nil;

    if Field.AsCurrency <= 0 then msg:= 'Mínimo'
    else                         msg:= 'Máximo';

    if (Field.AsCurrency > 0) and ((Field.AsCurrency <= (qryProdutosContratosTrocaquantidade.AsCurrency -
                                                         qryProdutosContratosTrocacancelado.AsCurrency))) then
    begin
      if qryProdutosContratosTrocaproduto.AsLargeInt > 0 then begin
        qryProdutosContratosTroca.DisableControls;
        Pos:= qryProdutosContratosTroca.GetBookmark;
        try
          { Quanto falta para entregar ? }
          Entregar := qryProdutosContratosTrocaquantidade.AsCurrency -     { Quantidade vendida }
                      qryProdutosContratosTrocacancelado.AsCurrency  -     { Quantidade já devolvida }
                      qryProdutosContratosTrocaqtdeentregue.AsCurrency;    { Saldo NF saida - entrada }

          qryProdutosContratosTroca.Edit;
          if qryProdutosContratosTrocadevolver.AsCurrency > Entregar then
          { Qtidade que irá gerar a nota de entrada }
            qryProdutosContratosTrocaqtdeentregueparadevolver.AsCurrency := qryProdutosContratosTrocadevolver.AsCurrency - Entregar
          else
            qryProdutosContratosTrocaqtdeentregueparadevolver.AsCurrency := 0;

          if (qryProdutosContratosTrocaqtdeentregueparadevolver.AsCurrency<>0) and
             ((qryProdutosContratosTrocafilialemissaonota.AsInteger <> 0) and
              (qryProdutosContratosTrocafilialemissaonota.AsInteger <> FilialBase)) and
             not (MensagemConfirmacao(format('A nota fiscal de venda foi gerada na filial %s, deseja gerar a nota fiscal de devolução na filial %s ?',
                                         [qryProdutosContratosTrocafilialemissaonota.AsString, inttostr(filialbase)])) = smbOK) then
          begin
            Field.FocusControl;
//            qryProdutosContratostroca.Cancel;
            field.ascurrency := 0;
            qryProdutosContratosTrocaqtdeentregueparadevolver.ascurrency := 0;
            Field.FocusControl;
          end
          else
          begin
            if (Field.AsCurrency = 0) then
            begin
//              qryProdutosContratosTroca.Edit;
              qryProdutosContratosTrocaprecovenda.AsCurrency := qryProdutosContratostrocaprecovendaaux.ascurrency;
              qryProdutosContratosTroca.Post;
            end;

            if not RecuperandoTrocaEfetuada then
            begin
              if qryProdutosContratosTrocadefeito.AsBoolean then
                qryProdutosContratosTrocadefeito.AsBoolean:= False;
              GuardarProdutoaTrocar;
            end;

            if not DefinicaodeParametrosVerificada then
              AcionaDefinirParametros;

            AtualizaValores;
            AlterarParcelamento;

            ExibirNovosValores(nil);

 //           if qryProdutosContratosTroca.State in [dsedit] then
//              qryProdutosContratosTroca.Edit;
          end;
        finally
          qryProdutosContratosTroca.GotoBookmark(Pos);
          qryProdutosContratosTroca.FreeBookmark(Pos);
          qryProdutosContratosTroca.EnableControls;
        end;
      end;

      if not DefinirNotasPagDadosFiscais then
      begin
         qryProdutosContratosTroca.edit;
         field.ascurrency := 0;
         qryProdutosContratosTrocaqtdeentregueparadevolver.ascurrency := 0;
         qryProdutosContratosTroca.post;
      end;

      Field.FocusControl;
    end
    else
    begin
      if (Field.AsCurrency > 0) then
        MensagemAviso(Format(ctQUANTIDADEADEVOLVER,[msg,CurrToStr(qryProdutosContratosTrocaquantidade.AsCurrency -
                                                                 qryProdutosContratosTrocacancelado.AsCurrency)]));
      qryProdutosContratosTroca.edit;
      Field.FocusControl;
//      qryProdutosContratosTrocadevolver.ascurrency := 0;
//      qryProdutosContratosTrocaqtdeentregueparadevolver.ascurrency := 0;
      field.clear;
      qryProdutosContratosTrocaqtdeentregueparadevolver.clear;
      qryProdutosContratosTroca.post;

      DefinirNotasPagDadosFiscais;

      GuardarProdutoaTrocar;

      AtualizaValores;
      AlterarParcelamento;
      ExibirNovosValores(nil);

    end;

    // a definição da filial deve ser antes da indicação da quantidade a devolver devido a forma como esta implementado
    qryProdutosContratosTrocafilialmovimentacao.readonly := qryProdutosContratosTrocadevolver.asfloat > 0;

    dsrProdutosContratosTroca.OnDataChange := dsrProdutosContratosTrocaDataChange;
  end
  else
  if Field = qryProdutosContratosTrocaqtdeentregueparadevolver then
  begin
    dsrProdutosContratosTroca.OnDataChange := nil;
    if not RecuperandoTrocaEfetuada then
    begin
      Entregar := qryProdutosContratosTrocaquantidade.AsCurrency -
                  qryProdutosContratosTrocacancelado.AsCurrency  -
                  qryProdutosContratosTrocaqtdeentregue.AsInteger;

      if qryProdutosContratosTrocaqtdeentregueparadevolver.AsCurrency > qryProdutosContratosTrocaqtdeentregue.AsCurrency then
      begin
        MensagemAviso(Format(ctQUANTIDADEENTREGUEADEVOLVER, [qryProdutosContratosTrocaqtdeentregue.AsCurrency]));
        qryProdutosContratosTrocadevolver.ascurrency := 0;
        qryProdutosContratosTrocaqtdeentregueparadevolver.ascurrency := 0;
        qryProdutosContratosTroca.Cancel;
        Field.FocusControl;
      end else if qryProdutosContratosTrocaqtdeentregueparadevolver.AsCurrency > qryProdutosContratosTrocadevolver.AsCurrency then begin
        MensagemAviso(ctENTREGUEMAIORQUEDEVOLVER);
        qryProdutosContratosTrocadevolver.ascurrency := 0;
        qryProdutosContratosTrocaqtdeentregueparadevolver.ascurrency := 0;
        qryProdutosContratosTroca.Cancel;
        Field.FocusControl;
      end else if (qryProdutosContratosTrocadevolver.AsCurrency > Entregar) and
                  (qryProdutosContratosTrocaqtdeentregueparadevolver.AsCurrency < (qryProdutosContratosTrocadevolver.AsCurrency - Entregar))
      then begin
        MensagemAviso(Format(ctENTREGUEMENORQUEMINIMO, [qryProdutosContratosTrocadevolver.AsCurrency - Entregar]));
        qryProdutosContratosTrocadevolver.ascurrency := 0;
        qryProdutosContratosTrocaqtdeentregueparadevolver.ascurrency := 0;
        qryProdutosContratosTroca.Cancel;
        Field.FocusControl;
      end
      else
      begin
        if not DefinirNotasPagDadosFiscais then
        begin
          qryProdutosContratosTrocadevolver.ascurrency := 0;
          qryProdutosContratosTrocaqtdeentregueparadevolver.ascurrency := 0;
        end;
        Field.FocusControl;
      end;
      if qryProdutosContratosTroca.State in [dsbrowse] then
        qryProdutosContratosTroca.Edit;
    end;
    dsrProdutosContratosTroca.OnDataChange := dsrProdutosContratosTrocaDataChange;
  end;
end;

function TdtmTrocaMercadorias.DefinirNotasPagDadosFiscais: boolean;
begin
  result := true;
  if (qryProdutosContratosTrocaqtdeentregueparadevolver.AsCurrency > 0) then
  begin
    ConsultarDadosFiscais;
    if (qryDadosFiscais.RecordCount > 0) then
    begin

      if not RecuperandoTrocaEfetuada then
        if qrydadosfiscais.RecordCount > 1 then
        begin
          if not Assigned (frmDadosFiscaisContratos) then
            frmDadosFiscaisContratos:= TfrmDadosFiscaisContratos.Create(frmDadosFiscaisContratos);
          frmDadosFiscaisContratos.dbgDadosFiscais.DataSource := dtmTrocaMercadorias.dsrDadosFiscais;
          frmDadosFiscaisContratos.ShowModal;
          frmDadosFiscaisContratos.Free;
        end;

      if not DocumentoFiscalNaoVinculado then
      begin
        result := DefinirNumeroSerieProdutos;
        if not result then
        begin
           AtribuirDados(qryProdutosSeries, [qryProdutosSeriesdevolvido], [false]);
           DesabilitarValoresProdutosContratosViaDadosFiscais(qryProdutosContratosTrocaproduto.asLargeint);
        end
        else
          AtribuirValoresProdutosContratosViaDadosFiscais;
      end;

    end
    else
      MensagemAviso('Não foi encontrado nenhum Documento Fiscal para este Contrato.');

  end
  else
  begin
  {
    result := DefinirNumeroSerieProdutos;
    if not result then
      AtribuirDados(qryProdutosSeries, [qryProdutosSeriesdevolvido], [false]);
    AtribuirValoresProdutosContratosViaDadosFiscais;
    }
    DesabilitarValoresProdutosContratosViaDadosFiscais(qryProdutosContratosTrocaproduto.asLargeint);
  end;
end;

procedure TdtmTrocaMercadorias.dsrDadosFiscaisDataChange(Sender: TObject; Field: TField);
begin
  inherited;
  dsrDadosFiscais.OnDataChange:= nil;
  if (Field = qryDadosFiscaisdevolver) then
  begin

    if qryProdutosContratosTroca.Locate('contrato;produto;filial',
      VarArrayof([qryDadosFiscaiscontrato.asstring,
                  qryDadosFiscaisproduto.asstring,
                  qryDadosFiscaisfilial.asstring]),[]) then
    begin

      if (Field.AsCurrency > qryDadosFiscaisquantidade.AsCurrency) then
      begin
        MensagemAviso('A quantidade a devolver informada em Documentos Fiscais,' + sLineBreak +
                      'é maior que a quantidade permitida para devolução.');
        Field.AsCurrency := 0;
        Field.FocusControl;
      end
      else
      if (Field.AsCurrency > qryProdutosContratosTrocaqtdeentregueparadevolver.AsCurrency) then
      begin
        MensagemAviso('A quantidade a devolver informada em Documentos Fiscais,' + sLineBreak +
                      'é maior que a quantidade que esta sendo devolvida.');
        Field.AsCurrency := 0;
        Field.FocusControl;
      end {
      else
      begin
        if qryProdutosContratosTrocavalorreducaobaseunitaria.AsCurrency <> qryDadosFiscaisvalorreducaobaseunitaria.AsCurrency then
        begin
          qryProdutosContratosTroca.Edit;
          qryProdutosContratosTrocavalorreducaobaseunitaria.AsCurrency := qryDadosFiscaisvalorreducaobaseunitaria.AsCurrency;
          qryprodutoscontratosTroca.Post;
        end;
      end; }
    end;
  end;
  dsrDadosFiscais.OnDataChange:= dsrDadosFiscaisDataChange;
end;

function TdtmTrocaMercadorias.DocumentoFiscalNaoVinculado: Boolean;
var
  TotQtde: Currency;
  vMensagem: boolean;
  procedure ZerarQtDevolver;
  begin
    qryProdutosContratosTroca.Edit;
    qryProdutosContratosTrocadevolver.AsCurrency := 0;
    if qryProdutosContratosTroca.State = dsedit then
      qryProdutosContratosTroca.Post;
    AtualizaValores;
  end;

begin
  TotQtde:= 0;
  vMensagem := false;
  dsrDadosFiscais.OnDataChange:= nil;
  Result:= True;
  qryDadosFiscais.First;
  while not qryDadosFiscais.Eof do
  begin

    if not DadosFiscaisOK then
    begin
      MensagemErro('A nota fiscal de venda não foi transmitida para a Receita Federal, ' + chr(13) +
                   'ela deve ser transmitida ou cancelada antes de ser feita a devolução ou troca ');
      result := false;
      vMensagem := true;
      ZerarQtDevolver;
      break;
    end;

    TotQtde:= TotQtde + qryDadosFiscaisdevolver.AsCurrency;
    if (qryDadosFiscaisdevolver.AsCurrency > 0) then
    begin
      Result:= False;
//      Break;
    end;
    qryDadosFiscais.Next;
  end;

  if not vMensagem then
  begin
    if Result or (TotQtde <> qryProdutosContratosTrocaqtdeentregueparadevolver.AsCurrency) then
    begin
      if Result then
        MensagemAviso('Nenhum Documento Fiscal foi vinculado ao produto.')
      else
      if (TotQtde < qryProdutosContratosTrocaqtdeentregueparadevolver.AsCurrency) then
        MensagemAviso('A quantidade dos produtos nos Documentos Fiscais,' + #10#13 +
                      'difere da quantidade que está sendo devolvida');

      ZerarQtDevolver;
    end;
  end;
  dsrDadosFiscais.OnDataChange:= dsrDadosFiscaisDataChange;
end;

function TdtmTrocaMercadorias.ExcluirParcelas: Boolean;
begin
  Result:= False;
  if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['a PARCELA'])) = smbOk then begin
    qryParcelasContratos.Delete;
    Result:= True;
  end;
end;

function TdtmTrocaMercadorias.ExisteCliente(NomeCampo, Value: Variant): Boolean;
begin
  if NomeCampo = 'nomecidade' then
       NomeCampo:= 'c.nome'
  else NomeCampo:= 'v.' + NomeCampo;
  qryConsultaClientes.Sql[12]:= 'and (to_ascii(' + NomeCampo + ',''latin1'') ilike to_ascii(''' + Value + '%'',''latin1''))';

  qryConsultaClientes.Open;
  Result := Not qryConsultaClientes.IsEmpty
end;

procedure TdtmTrocaMercadorias.AbrirTabelas(TipoConsulta: TtecContratoTipoConsulta);
begin
  case TipoConsulta of
    ctcCLIENTESTROCA,
    ctcCLIENTES     : begin
//                        qryConsultaClientes.Sql[12]:= 'and (v.codigo = 0)';
                        qryConsultaClientes.Open;
                      end;
    ctcVENDEDOR :  RefazConsulta(qryConsultaVendedores,[],[]);
  end;
end;

procedure TdtmTrocaMercadorias.FecharTabelas(TipoConsulta: TtecContratoTipoConsulta);
begin
  case TipoConsulta of
    ctcCLIENTESTROCA,
    ctcCLIENTES :  Fecha(ctVendaTabelaConsultaClientes);
    ctcVENDEDOR : Fecha(ctVendaTabelaConsultaVendedores);
  end;
end;

