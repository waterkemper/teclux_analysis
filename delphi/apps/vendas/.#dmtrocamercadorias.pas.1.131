  Result := ExisteCodigo(qryConsultaVendedores, NomeCampo, Value)
end;

function TdtmTrocaMercadorias.ExcluirProduto: Boolean;
begin
  Result:= False;

  if dsrProdutosContratos.dataset.RecordCount > 0 then
  begin
    if MensagemConfirmacao(Format(ctCONFIRMEEXCLUIR, ['o PRODUTO'])) = smbOk then
    begin
      if dsrProdutosContratos.dataset.State = dsInsert then
        dsrProdutosContratos.dataset.Cancel
      else
      begin
        dsrProdutosContratos.dataset.Delete;
        RefazConsulta(qryEstoque,[0],[IntToStr(TLargeintField(dsrprodutoscontratos.DataSet.FieldByName('produto')).AsLargeInt)]);
        LerProdutosFiliaisIncluidos(False);
        dsrProdutosContratos.dataset.Edit;
        dsrProdutosContratos.dataset.Cancel;
      end;
      dsrContratos.dataset.Edit;
      Result := True;
    end;
  end;

end;

function TdtmTrocaMercadorias.getEditandoProdutosContratos: Boolean;
begin
   Result:= (dsrProdutosContratos.dataset.State = dsEdit);
end;

function TdtmTrocaMercadorias.GravarProdutoContrato: Boolean;
begin
  if TtecQuery(dsrProdutosContratos.dataset).CheckRequiredFields then
  begin
    if dsrProdutosContratos.dataset.FieldByName('precovenda').AsFloat <= 0 then
    begin
      MensagemAviso(ctPRECOZERO);
      Result := False
    end else if dsrProdutosContratos.dataset.State in [dsInsert,dsEdit] then begin
      dsrContratos.dataset.Edit;
      dsrProdutosContratos.dataset.Post;
      Result := True
    end else
      Result:= False;
  end
  else Result:= False;
end;

procedure TdtmTrocaMercadorias.AbreConsultaProdutos(
  SoLista: Boolean;  tipoConsulta: TtecConsultaProdutosContratos);
begin
  case tipoconsulta of
    cpcPRODUTOS:
    begin
      if ComLista and SoLista then
           qryConsultaProdutos.MacroByName('Produto').AsString := ''
      else
      begin
        if ParSistema.UsarConsultaInterativa then
          qryConsultaProdutos.MacroByName('Produto').AsString := ''
        else
          qryConsultaProdutos.MacroByName('Produto').AsString := ' and (produto = 0)';
      end;
    end;
    cpcPRODUTOSTROCA:
    begin
      if ParSistema.UsarConsultaInterativa then
        qryConsultaProdutos.MacroByName('Produto').AsString  := ''
      else
        qryConsultaProdutos.MacroByName('Produto').AsString := ' and (produto = 0)';
    end;
  end;
  Abre(ctVendaTabelaConsultaProdutos);
end;

procedure TdtmTrocaMercadorias.SelecionarProdutoContrato;
begin
  if dsrProdutosContratos.dataSet.State = dsbrowse then
    dsrProdutosContratos.dataSet.Edit;
    
  if (ParSistema.FiliaisIndependentes) then
  begin
    qryProcuraProduto.MacroByName('filialsaida').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
    qryProcuraProduto.ParamByName('FilialPreco').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
  end
  else
  begin
    qryProcuraProduto.MacroByName('filialsaida').AsString := qryConsultaProdutosfilial.AsString;
    if ParSistema.UtilizarPrecoFilialBase then
      qryProcuraProduto.ParamByName('FilialPreco').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual)
    else
      qryProcuraProduto.ParamByName('FilialPreco').AsString := qryConsultaProdutosfilial.AsString;
  end;
  dsrProdutosContratos.dataSet.FieldByName('filial').AsInteger   := qryConsultaProdutosfilial.AsInteger;
  dsrProdutosContratos.dataSet.FieldByName('produtodigitado').AsString := qryConsultaProdutosprodutovisual.AsString;
  dsrProdutosContratos.dataSet.FieldByName('produtovisual').AsString := qryConsultaProdutosprodutovisual.AsString;
  dsrProdutosContratos.dataSet.FieldByName('produto').AsString := qryConsultaProdutosproduto.AsString;
  dsrProdutosContratos.dataSet.FieldByName('caracteristica').AsString := qryConsultaProdutoscaracteristica.AsString;
  dsrProdutosContratos.dataSet.FieldByName('descricao').AsString := qryConsultaProdutosdescricao.AsString;
  dsrProdutosContratos.dataSet.FieldByName('unidade').AsString   := qryConsultaProdutosunidade.AsString;
  dsrProdutosContratos.dataSet.FieldByName('brinde').AsBoolean   := qryConsultaProdutosbrinde.AsBoolean;
  RefazConsulta(qryEstoque,[0],[IntToStr(qryConsultaProdutosproduto.AsLargeInt)]); // Jander
end;

