  result := qryProdutosTrocados.RecordCount>0; //dsrProdutosContratos.dataset.RecordCount > 0 ;
end;


function TdtmTrocaMercadorias.Faturar: boolean;
var
  ErroCupom, ErroAcrescimo,
  CupomEmitido: Boolean;
  FormaPagamento: Integer;
  ValorPagoDinheiro: Currency;
  UsuarioFat: TtecUsuarios;
  Msg: String;

begin
  inherited;
  result := false;
  CadastroContratos := TdtmCadastroContratos.Create(Self, True);
  try
    if CadastroContratos.SelecionarContrato(NumeroContratoouOrcamento) then
    begin
      if not CadastroContratos.bloqueado then
      begin
        if CadastroContratos.SituacaoContrato <> scRESERVADO then
        begin
           CadastroContratos.SituacaoContrato := scRESERVADO;
           CadastroContratos.GravarContrato(ErroCupom, CupomEmitido, FormaPagamento,
                                               Msg, ValorPagoDinheiro, ErroAcrescimo);

        end;

        if CadastroContratos.SituacaoContrato <> scFATURADO then
        begin
           CadastroContratos.SituacaoContrato := scFATURADO;
           CadastroContratos.GravarContrato(ErroCupom, CupomEmitido, FormaPagamento,
                                               MSg, ValorPagoDinheiro, ErroAcrescimo);
            if ParSistema.ImprimirCarneAoFaturar then
              ImprimirCarne;
        end;
        CadastroContratos.DesbloquearContrato;

        if UsuarioLogin.AnalistaCredito then
        begin
          updContrato.Sql.Clear;
          updContrato.Sql.Add('UPDATE contratos');
          updContrato.Sql.Add('SET analista='+inttostr(UsuarioLogin.CodigoUsuario));
          updContrato.Sql.Add('WHERE numero='+NumeroContratoouOrcamento);
          updContrato.ExecSql;
        end;
        
      end;

    end;
  finally
//    CadastroContratos.DesbloquearContrato;
    CadastroContratos.Free;
  end;
end;

