procedure TdtmTrocaMercadorias.AcionaDefinirParametros;
begin
  if not Assigned (frmDefinirParametrosDevolucao) then
    frmDefinirParametrosDevolucao:= TfrmDefinirParametrosDevolucao.Create(frmDefinirParametrosDevolucao);


  with frmDefinirParametrosDevolucao dO
  begin
    ckbCreditarICMS.Checked:= PodeCreditarICMS and ((qryContratosPorClientesituacao.asString = 'N') or
                                                    (qryContratosPorClientesituacao.asString = 'P'));
    ckbCliente.Enabled   := false; {(ClientePessoaTipo = 'J');}
    edtEmissao.Minimo    := DaysBetween(DataServidor,DataContrato);
    sbnLerXMLNfe.Enabled := false;

    ShowModal;

    if modalresult = mrOK then
    begin
      dtmTrocaMercadorias.DefinicaodeParametrosVerificada := true;
      dtmTrocaMercadorias.DevolverSeguro:= ckbSeguro.Checked;
      dtmTrocaMercadorias.DevolverFrete:= ckbFrete.Checked;
      dtmTrocaMercadorias.DevolverCreditoTroca:= ckbCreditoTroca.Checked;
      dtmTrocaMercadorias.CreditarICMS:= ckbCreditarICMS.Checked;
      dtmTrocaMercadorias.ClienteTrouxeNota:= ckbCliente.Checked;
      dtmTrocaMercadorias.SerieDevolucao:= edtSerie.Text;
      dtmTrocaMercadorias.NumeroDevolucao:= edtNumeroNota.Text;

      if edtEmissao.Text <> '' then
        dtmTrocaMercadorias.DataDevolucao:= edtEmissao.Text;

      dtmTrocaMercadorias.ChaveNfeDevolucao:= edtChaveNfe.Text;
    end
    else
      dtmTrocaMercadorias.DefinicaodeParametrosVerificada := false;

    Free;
  end;

end;

function TdtmTrocaMercadorias.ValidarFechamentoQuantidades(VerificarNotasPag: Boolean = false): Boolean;
var
  vQt_CD_Sit_F : Double;
  vQt_CD_Sit_N : Double;
  vQt_PNP : Double;

  vProduto : String;
  vRecnoContratosDevolvidos : integer;

begin
  result := true;

  if contratoidentificado then
  begin

    try

//      qryContratosDevolvidos.SortByField('contrato;produto');
      if VerificarNotasPag then
      begin
        qryProdutosNotaspag.mastersource := nil;
        qryProdutosNotasPag.LinkFields := '';
//        qryProdutosNotaspag.SortByField('contrato;produto');
      end;

      qryContratosDevolvidos.first;

      while not qryContratosDevolvidos.eof do
      begin

        if qryContratosDevolvidosproduto.asString <> '' then
        begin

          vproduto := qryContratosDevolvidosproduto.asString;
          vQt_CD_Sit_F := 0;
          vQt_CD_Sit_N := 0;
          vRecnoContratosDevolvidos := qryContratosDevolvidos.recno;

          qryContratosDevolvidos.first;
          while not qryContratosDevolvidos.eof do
          begin

            if (vProduto = qryContratosDevolvidosproduto.asString) then
            begin

              if qryContratosDevolvidossituacao.asString = 'F' then
                 vQt_CD_Sit_F := vQt_CD_Sit_F +
                                 qryContratosDevolvidosquantidade.asFloat;

              if qryContratosDevolvidossituacao.asString = 'N' then
                 vQt_CD_Sit_N := vQt_CD_Sit_N +
                                 qryContratosDevolvidosquantidade.asFloat;

              if not qryprodutostrocados.locate('contrato;produto',
                    VarArrayOf([qryContratosDevolvidoscontrato.assTring,
                                qryContratosDevolvidosproduto.asString]), []) then
              begin
                result := false;

                MensagemErro(
                 format('O produto %s da tabela ''ContratosDevolvidos'' não está presente na tabela ''ProdutosTrocados''',
                  [ValorCampodaTabela('produtos', ['codigo'], [qryContratosDevolvidosproduto.AsString], ['codigovisual'])[0]]))

              end
              else
              if VerificarNotasPag and
                (qryContratosDevolvidossituacao.asString = 'N') then
              begin
                if not qryProdutosNotasPag.locate('contrato;produto',
                      VarArrayOf([qryContratosDevolvidoscontrato.assTring,
                                  qryContratosDevolvidosproduto.asString]), []) then
                begin
                  result := false;
                  MensagemErro(
                   format('O produto %s da tabela ''ContratosDevolvidos'' não está presente na tabela ''ProdutosNotasPag''',
                    [ValorCampodaTabela('produtos', ['codigo'], [qryContratosDevolvidosproduto.AsString], ['codigovisual'])[0]]))

                end
                else
                begin
                  vQt_PNP := 0;
                  qryProdutosNotasPag.first;
                  while not qryProdutosNotasPag.eof do
                  begin
                    if (qryProdutosNotasPagcontrato.asString = qrycontratosdevolvidoscontrato.asstring) and
                       (qryProdutosNotasPagproduto.asString = qrycontratosdevolvidosproduto.asstring) then
                      vQt_PNP := vQt_PNP + qryProdutosNotasPagquantidade.asFloat;

                    qryProdutosNotasPag.next;
                  end;

                  if vQt_PNP <> qryContratosDevolvidosquantidade.asFloat then
                  begin
                    result := false;

                    MensagemErro(

                       format('A quantidade do produto devolvido não está fechando'+chr(13)+
                        'Produto: %s'+char(13)+
                        'Quantidade em ''ContratosDevolvidos'': %s'+chr(13)+
                        'Quantidade em ''ProdutosNotasPag'': %s',
                        [ValorCampodaTabela('produtos', ['codigo'], [qryContratosDevolvidosproduto.AsString], ['codigovisual'])[0],
                         qryContratosDevolvidosquantidade.asString, floattostr(vQt_PNP)])

                         );
                  end;
                end;
              end;

              if not result then
                break;

            end;

            qryContratosDevolvidos.next;
          end;

          if result and ((vQt_CD_Sit_F + vQt_CD_Sit_N) <> qryProdutosTrocadosquantidade.aSfloat) then
          begin
            result := false;
            MensagemErro(
               format('A quantidade do produto devolvido não está fechando'+chr(13)+
                'Produto: %s'+char(13)+
                'Quantidade em ''ContratosDevolvidos'': %s'+chr(13)+
                'Quantidade em ''ProdutosTrocados'': %s',
                [ValorCampodaTabela('produtos', ['codigo'], [vproduto], ['codigovisual'])[0],
                 FloattoStr((vQt_CD_Sit_F + vQt_CD_Sit_N)), qryProdutosTrocadosquantidade.aSString]));

          end;

          if not result then
            break;

          qryContratosDevolvidos.recno := vRecnoContratosDevolvidos;
          qryContratosDevolvidos.next;

        end
        else
          qryContratosDevolvidos.next;

      end;

    finally

//      qryContratosDevolvidos.Sortclear;
      if VerificarNotasPag then
      begin
        qryProdutosNotasPag.LinkFields := 'codigo=codigonota';
        qryProdutosNotaspag.mastersource := dsrNotasPag;
      end;

    end;

  end;

end;

procedure TdtmTrocaMercadorias.DesabilitarValoresProdutosContratosViaDadosFiscais(
  produto: int64);
var i: integer;  
begin
  for i := 0 to length(produtoseServicos[produtos])-1 do
  begin
    if produtoseServicos[produtos][i].produto = produto then
      produtoseServicos[produtos][i].RegistroOK := false;
  end;

end;

end.
