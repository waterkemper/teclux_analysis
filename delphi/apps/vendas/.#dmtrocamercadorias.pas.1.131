procedure TdtmTrocaMercadorias.qryProdutosTrocadosCalcFields(
  DataSet: TDataSet);
begin
  inherited;

  if qryProdutosTrocadosquantidadeoriginal.AsCurrency <> 0 then {Este Campo é preenchido quando a inclusão é pela geração atrav´s de um cupom fiscal }
  begin

    qryProdutosTrocadosdescontounitario.AsCurrency := (qryProdutosTrocadosdesconto.AsCurrency /
          ifthen(qryProdutosTrocadosquantidadeoriginal.AsCurrency<>0,qryProdutosTrocadosquantidadeoriginal.AsCurrency,1)) * qryProdutosTrocadosquantidade.AsCurrency;

    qryProdutosTrocadosvalordescontoitemunitario.AsCurrency := (qryProdutosTrocadosvalordescontoitem.AsCurrency /
          ifthen(qryProdutosTrocadosquantidadeoriginal.AsCurrency<>0,qryProdutosTrocadosquantidadeoriginal.AsCurrency,1)) * qryProdutosTrocadosquantidade.AsCurrency;

    qryProdutosTrocadosdescontototal.asCurrency := qryProdutosTrocadosdescontounitario.AsCurrency +
                                                   qryProdutosTrocadosvalordescontoitemunitario.AsCurrency;

    qryProdutosTrocadosdescontototalunitario.AsCurrency :=  (qryProdutosTrocadosdesconto.AsCurrency /
          ifthen(qryProdutosTrocadosquantidadeoriginal.AsCurrency<>0,qryProdutosTrocadosquantidadeoriginal.AsCurrency,1)) +

                                                            (qryProdutosTrocadosvalordescontoitem.AsCurrency /
          ifthen(qryProdutosTrocadosquantidadeoriginal.AsCurrency<>0,qryProdutosTrocadosquantidadeoriginal.AsCurrency,1));


   qryProdutosTrocadosfreteunitario.asCurrency := (qryProdutosTrocadosfrete.AsCurrency /
          ifthen(qryProdutosTrocadosquantidadeoriginal.AsCurrency<>0,qryProdutosTrocadosquantidadeoriginal.AsCurrency,1));

   qryProdutosTrocadossegurounitario.asCurrency := (qryProdutosTrocadosseguro.AsCurrency /
          ifthen(qryProdutosTrocadosquantidadeoriginal.AsCurrency<>0,qryProdutosTrocadosquantidadeoriginal.AsCurrency,1));

   qryProdutosTrocadosValoripiUnitario.asCurrency := (qryProdutosTrocadosValoripi.AsCurrency /
          ifthen(qryProdutosTrocadosquantidadeoriginal.AsCurrency<>0,qryProdutosTrocadosquantidadeoriginal.AsCurrency,1));

   qryProdutosTrocadosDespesasAcessoriasUnitario.asCurrency := (qryProdutosTrocadosDespesasAcessorias.AsCurrency /
          ifthen(qryProdutosTrocadosquantidadeoriginal.AsCurrency<>0,qryProdutosTrocadosquantidadeoriginal.AsCurrency,1));

   qryProdutosTrocadosICMSvalorSTUnitario.asCurrency := (qryProdutosTrocadosICMSvalorST.AsCurrency /
          ifthen(qryProdutosTrocadosquantidadeoriginal.AsCurrency<>0,qryProdutosTrocadosquantidadeoriginal.AsCurrency,1));

  end
  else
  begin
    qryProdutosTrocadosdescontounitario.AsCurrency := qryProdutosTrocadosdesconto.AsCurrency;  {diferente do cupom que permite alterar a quantidade}
    qryProdutosTrocadosvalordescontoitemunitario.AsCurrency := qryProdutosTrocadosvalordescontoitem.AsCurrency;

    qryProdutosTrocadosdescontototal.asCurrency := qryProdutosTrocadosdescontounitario.AsCurrency +
                                                   qryProdutosTrocadosvalordescontoitemunitario.AsCurrency;

    qryProdutosTrocadosdescontototalunitario.AsCurrency :=  (qryProdutosTrocadosdesconto.AsCurrency /
          ifthen(qryProdutosTrocadosquantidade.AsCurrency<>0,qryProdutosTrocadosquantidade.AsCurrency,1)) +

                                                            (qryProdutosTrocadosvalordescontoitem.AsCurrency /
          ifthen(qryProdutosTrocadosquantidade.AsCurrency<>0,qryProdutosTrocadosquantidade.AsCurrency,1));

   qryProdutosTrocadosfreteunitario.asCurrency := (qryProdutosTrocadosfrete.AsCurrency /
          ifthen(qryProdutosTrocadosquantidade.AsCurrency<>0,qryProdutosTrocadosquantidade.AsCurrency,1));

   qryProdutosTrocadossegurounitario.asCurrency := (qryProdutosTrocadosseguro.AsCurrency /
          ifthen(qryProdutosTrocadosquantidade.AsCurrency<>0,qryProdutosTrocadosquantidade.AsCurrency,1));

   qryProdutosTrocadosValoripiUnitario.asCurrency := (qryProdutosTrocadosValoripi.AsCurrency /
          ifthen(qryProdutosTrocadosquantidade.AsCurrency<>0,qryProdutosTrocadosquantidade.AsCurrency,1));

   qryProdutosTrocadosDespesasAcessoriasUnitario.asCurrency := (qryProdutosTrocadosDespesasAcessorias.AsCurrency /
          ifthen(qryProdutosTrocadosquantidade.AsCurrency<>0,qryProdutosTrocadosquantidade.AsCurrency,1));

   qryProdutosTrocadosICMSvalorSTUnitario.asCurrency := (qryProdutosTrocadosICMSvalorST.AsCurrency /
          ifthen(qryProdutosTrocadosquantidade.AsCurrency<>0,qryProdutosTrocadosquantidade.AsCurrency,1));


  end;


  if qryProdutosTrocadoscontrato.isnull then
  begin
    if not qryProdutosTrocadoscupomfiscal.isnull then
      qryProdutosTrocadoscontratoaux.asString := 'CF ' + qryProdutosTrocadoscupomfiscal.asString
    else
    if not qryProdutosTrocadosnotafiscal.isnull then
      qryProdutosTrocadoscontratoaux.asString := 'NF ' + qryProdutosTrocadosnotafiscal.asString;
  end
  else
    qryProdutosTrocadoscontratoaux.value := qryProdutosTrocadoscontrato.value;
end;

procedure TdtmTrocaMercadorias.DefinirParametrosFiliais;
begin
  if (ParSistema.FiliaisIndependentes) then
  begin
    qryConsultaProdutos.MacroByName('FilialIndependente').AsString := 'and (e.filial = ' + IntToStr(ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual)) + ')';
    qryProcuraProduto.MacroByName('filialsaida').AsString := inttostr(ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual));

    qryConsultaFilialProduto.macrobyname('SQLLimiteFiliais').asstring := 'and (f.codigo = ' + IntToStr(ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual)) + ')';
    qryProcuraFilialProduto.macrobyname('SQLLimiteFiliais').asstring := 'and (f.codigo = ' + IntToStr(ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual)) + ' /* or f.codigo = :codigo */)';
    qryConsultaProdutosfilial.Visible  := Not (ParSistema.FiliaisIndependentes);
    qryProdutosContratosfilial.Visible := Not (ParSistema.FiliaisIndependentes);
  end
  else
    if (ParSistema.PesquisaSomenteEstoqueFilialBasevendas) then
    begin
      qryConsultaProdutos.MacroByName('FilialIndependente').AsString := 'and (e.filial in (' + ifthen((Operacao='S') or (TipoFilial='V'), ListaEstoquesFiliais,  inttostr(FilialBase)) + '))';
      qryProcuraProduto.MacroByName('filialsaida').AsString := ifthen((Operacao='S') or (TipoFilial='V'), ListaEstoquesFiliais,  inttostr(FilialBase));

      qryConsultaProdutosfilial.Visible  := (Operacao='S') or (TipoFilial='V');
      qryConsultaFilialProduto.macrobyname('SQLLimiteFiliais').asstring    := 'and (f.codigo in (' + ifthen((Operacao='S') or (TipoFilial='V'), ListaEstoquesFiliais,  inttostr(FilialBase)) + '))';
      qryProcuraFilialProduto.macrobyname('SQLLimiteFiliais').asstring   := 'and (f.codigo in (' + ifthen((Operacao='S') or (TipoFilial='V'), ListaEstoquesFiliais,  inttostr(FilialBase)) + ') /* or f.codigo = :codigo */)';
    end
    else
    begin
      qryConsultaProdutos.MacroByName('FilialIndependente').AsString := '';
      qryConsultaFilialProduto.macrobyname('SQLLimiteFiliais').asstring    := '';
      qryProcuraFilialProduto.macrobyname('SQLLimiteFiliais').asstring    := '';
    end;
end;

procedure TdtmTrocaMercadorias.SelecionarFilialTroca;
begin
  qryProdutosTrocadosfilial.AsInteger := qryConsultaFilialProdutocodigo.AsInteger
end;

