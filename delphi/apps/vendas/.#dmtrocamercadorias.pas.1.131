function TdtmTrocaMercadorias.IncluirCliente(comcpfcnpj: boolean): boolean;
var
  i: Integer;
begin
  result := false;
  frmClientesContrato := TfrmClientesContrato.Create(frmClientesContrato);
  try
    frmClientesContrato.dtmCadCli := dtmTrocaMercadorias;
    frmClientesContrato.DataSource := dsrClientes;

    qryclientes.ParamByName('codigo').clear;
    qryclientes.close;
    qryclientes.Open;
    qryclientes.append;

    i := frmClientesContrato.ShowModal;
  finally
    frmClientesContrato.Free;
  end;

  if (i = mrAbort) or (i = mrCancel) then
    RefazConsulta(qryClientes,[0],[qryContratoscliente.asinteger])
  else
  if i = mrOk then
  begin
    qryContratos.edit;
    AtribuirClienteExpress;
    result := true;
  end;
end;

procedure TdtmTrocaMercadorias.qryClientesNewRecord(DataSet: TDataSet);
begin
  inherited;
  qryClientessexo.AsString            := 'M';
  qryClientescivil.AsString           := 'S';
  qryClientesfonetipo.AsString        := 'P';
  qryClientesrestipo.AsString         := 'P';
  qryClientesreftipo.AsString         := 'P';
  qryClientesempcomprovado.AsBoolean  := False;
  qryClientesnaturalestado.AsString   := EstadoFilialBase;
  qryClientescartaocredito.AsBoolean  := False;
  qryClientescartaoloja.AsBoolean     := False;
  qryClientescheque.AsBoolean         := False;
  qryClienteschequeespecial.AsBoolean := False;
  qryClientesautomovel.AsBoolean      := False;
  qryClientesenderecoalterado.AsDateTime := DataHoraLocal;
  qryClientesconsumidorfinal.asBoolean := parsistema.vendaconsumidorfinal;
  qryClientesfilialcadastro.AsInteger:= FilialBase;
  qryClientespessoatipo.AsString := 'F';
end;

procedure TdtmTrocaMercadorias.AtribuirClienteExpress;
begin
//  InputFormCustomer := Codigo;
  
  qryProcuraCliente.ParamByName('codigo').asInteger := qryClientescodigo.AsInteger;
  qryProcuraCliente.ParamByName('tipo').asstring := 'C';
  qryProcuraCliente.close;
  qryProcuraCliente.open;

  qryContratoscliente.AsInteger := qryClientescodigo.AsInteger;
  qryContratostipocliente.AsString := 'C';
  qryContratospessoatipo.asstring := qryClientespessoatipo.asstring;
  qryContratospessoanumero.asstring := qryClientespessoanumero.asstring;
  qryContratosEstrangeiro.asBoolean := qryClientesEstrangeiro.asBoolean;

  qryContratosnome.asString := qryClientesnome.AsString;

  AtribuirClienteNoContrato;

end;

function TdtmTrocaMercadorias.GetTipoPessoa: String;
begin
  if Assigned(qryContratos) then
  begin
    if qryContratospessoatipo.AsString <> '' then
         Result:= qryContratospessoatipo.AsString
    else Result:= '';
  end;
end;

function TdtmTrocaMercadorias.GravarCliente: Boolean;
begin
  Result := qryClientes.CheckRequiredFields;

  if result then
    if (qryClientes.State in [dsEdit,dsInsert]) then
    begin
      spcClientesProximoCodigo.Open;
      qryClientescodigo.AsInteger:= spcClientesProximoCodigocodigo.AsInteger;
      spcClientesProximoCodigo.Close;

      qryClientesfonetipo.AsString        := 'P';
      qryClientesrestipo.AsString         := 'A';
      qryClientesempcomprovado.AsBoolean := False;
      qryClientesautomovel.AsBoolean     := False;
      qryClientescartaocredito.AsBoolean := False;
      qryClientescartaoloja.AsBoolean    := False;
      qryClientescheque.AsBoolean        := False;
      qryClienteschequeespecial.AsBoolean:= False;
      qryClientesobservacoes.AsString    := 'As informações do cliente, são oriundas do cadastro de contratos';
      qryClientesfilialcadastro.AsInteger:= FilialBase;
      qryClientesultimaalteracao.AsDateTime := DataServidor;
      qryClientes.Post;

      result := Perpetrar([qryClientes{, qryUsuarios_Site}]);

      {
      if result then
      begin
        AcionarTelaEnquete(qryClientescodigo.asinteger, 'C');

        Result:= True;
      end;
      }
    end;

end;

