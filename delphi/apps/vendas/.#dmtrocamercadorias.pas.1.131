function TdtmTrocaMercadorias.TodosServicosDevolvidos: Boolean;
var
  Aux: Boolean;
begin
  Aux:= (qryServicosContratos.recordcount=0);
  qryServicosContratos.First;
  while not qryServicosContratos.Eof do
  begin

    Aux:= (((qryServicosContratosquantidade.AsCurrency = qryServicosContratoscancelado.AsCurrency) and (qryServicosContratosdevolver.AsCurrency = 0)) or
           ((qryServicosContratosdevolver.AsCurrency > 0) and ((qryServicosContratosquantidade.AsCurrency - qryServicosContratoscancelado.AsCurrency) = qryServicosContratosdevolver.AsCurrency)));

    if not Aux then
      Break;
    qryServicosContratos.Next;
  end;
  Result:= Aux;
end;



procedure TdtmTrocaMercadorias.AtualizaValoresDevolvidos;
var
  vPos: TBookmark;
  vA: Integer;
  vValorPrazo,
  vValorMov,
  vDescontoDevolvido,
  vValorDescontoItemDevolvido,
  vFreteDevolvido,
  vSeguroDevolvido,
  vAcrescimoDevolvido,
  vImpostoRetidoDevolvido,
  vIPIDevolvido,
  vIcmsSubstituicaoDevolvido,
  vQtde, vQtdeMov, vSaldo: Currency;
  vSituacao: Char;
  vMovExtra, vFaltam: Boolean;

begin
  if qryContratosDevolvidos.Active then
    qryContratosDevolvidos.Close;
  qryContratosDevolvidos.Open;

  vValorPrazo := 0;

  qryProdutosContratosTroca.DisableControls;
  vPos:= qryProdutosContratosTroca.GetBookmark;



  try
    qryProdutosContratosTroca.First;
    for vA:= 0 to qryProdutosContratosTroca.RecordCount - 1 do
    begin

      vDescontoDevolvido := 0;
      vValorDescontoItemDevolvido := 0;
      vFreteDevolvido    := 0;
      vSeguroDevolvido   := 0;
      vAcrescimoDevolvido:= 0;
      vIPIDevolvido := 0;
      vIcmsSubstituicaoDevolvido := 0;

      if not qryProdutosContratosTrocabrinde.AsBoolean and
             (qryProdutosContratosTrocacancelado.AsCurrency < qryProdutosContratosTrocaquantidade.AsCurrency) then begin

        if (qryProdutosContratosTrocadevolver.AsCurrency > 0) then
        begin
          vQtde:= 0; vMovExtra:= False;
          while (vQtde < qryProdutosContratosTrocadevolver.AsCurrency) do
          begin
            if (vMovExtra or (qryProdutosContratosTrocadevolver.AsCurrency = qryProdutosContratosTrocaqtdeentregueparadevolver.AsCurrency)) then begin
              vQtdeMov  := qryProdutosContratosTrocaqtdeentregueparadevolver.AsCurrency;
              vSituacao := 'N';
            end
            else begin
              vQtdeMov  := qryProdutosContratosTrocadevolver.AsCurrency - qryProdutosContratosTrocaqtdeentregueparadevolver.AsCurrency;
              vSituacao := 'F';
            end;

            vQtde := vQtde + vQtdeMov;
            vMovExtra := (vQtde < qryProdutosContratosTrocadevolver.AsCurrency);

            qryContratosDevolvidos.Append;
            qryContratosDevolvidoscontrato.AsString        := qryContratosTrocanumero.AsString;
            qryContratosDevolvidosproduto.AsLargeInt       := qryProdutosContratosTrocaproduto.AsLargeInt;
            qryContratosDevolvidosfilial.AsInteger         := qryProdutosContratosTrocafilial.AsInteger;
            qryContratosDevolvidosdevolucao.AsDateTime     := DataServidor;
            qryContratosDevolvidosquantidade.AsCurrency    := vQtdeMov;

            vFaltam:= (qryProdutosContratosTrocaquantidade.AsCurrency -
                      qryProdutosContratosTrocacancelado.AsCurrency  -
                       vQtde )  > 0;

            if not vFaltam then  //GARANTE O FECHAMENTO DOS VALORES NO CASO DE DEVOLUCAO TOTAL DO PRODUTO
            begin

              if not qryProdutosContratosDevolvidos.IsEmpty then
              begin
                try
                  GuardarRegistroAtual(qryProdutosContratosDevolvidos,true);
                  qryProdutosContratosDevolvidos.First;
                  while not qryProdutosContratosDevolvidos.Eof do
                  begin
                    if qryProdutosContratosTrocaproduto.AsString = qryProdutosContratosDevolvidosproduto.AsString then
                    begin
                      vDescontoDevolvido := vDescontoDevolvido + qryProdutosContratosDevolvidosdesconto.AsCurrency;
                      vValorDescontoItemDevolvido := vValorDescontoItemDevolvido + qryprodutoscontratosdevolvidosvalordescontoitem.asCurrency;
                      vFreteDevolvido    := vFreteDevolvido    + qryProdutosContratosDevolvidosfrete.AsCurrency;
                      vSeguroDevolvido   := vSeguroDevolvido   + qryProdutosContratosDevolvidosseguro.AsCurrency;
                      vAcrescimoDevolvido:= vAcrescimoDevolvido+ qryProdutosContratosDevolvidosacrescimo.AsCurrency;
                      vIPIDevolvido    := vIPIDevolvido    + qryProdutosContratosDevolvidosvaloripi.AsCurrency;
                      vIcmsSubstituicaoDevolvido    := vIcmsSubstituicaoDevolvido    + qryProdutosContratosDevolvidosvaloricmssubstituicao.AsCurrency;

                    end;
                    qryProdutosContratosDevolvidos.Next;
                  end;
                finally
                  VoltarRegistroAtual(qryProdutosContratosDevolvidos);
                end;
              end;

              if qryProdutosContratosTrocadesconto.AsCurrency > 0 then
                qryContratosDevolvidosdesconto.AsCurrency   := Truncar(qryProdutosContratosTrocadesconto.AsCurrency - vDescontoDevolvido,2)
              else
                qryContratosDevolvidosdesconto.AsCurrency := 0;

              if qryProdutosContratosTrocavalordescontoitem.AsCurrency > 0 then
                qryContratosDevolvidosvalordescontoitem.AsCurrency   := Truncar(qryProdutosContratosTrocavalordescontoitem.AsCurrency - vValorDescontoItemDevolvido,2)
              else qryContratosDevolvidosvalordescontoitem.AsCurrency := 0;

              if DevolverFrete then
                qryContratosDevolvidosfrete.AsCurrency      := Truncar(qryProdutosContratosTrocafrete.AsCurrency - vFreteDevolvido,2)
              else qryContratosDevolvidosfrete.AsCurrency   := 0;

              if DevolverSeguro then
                qryContratosDevolvidosseguro.AsCurrency     := Truncar(qryProdutosContratosTrocaseguro.AsCurrency - vSeguroDevolvido,2)
              else qryContratosDevolvidosseguro.AsCurrency  := 0;

              if qryProdutosContratosTrocavaloripi.AsCurrency > 0 then
                qryContratosDevolvidosvaloripi.AsCurrency   := Truncar(qryProdutosContratosTrocavaloripi.AsCurrency - vIPIDevolvido,2)
              else qryContratosDevolvidosvaloripi.AsCurrency := 0;

              if qryProdutosContratosTrocaicmsvalorst.AsCurrency > 0 then
                qryContratosDevolvidosvaloricmssubstituicao.AsCurrency   := Truncar(qryProdutosContratosTrocaicmsvalorst.AsCurrency - vIcmsSubstituicaoDevolvido,2)
              else qryContratosDevolvidosvaloricmssubstituicao.AsCurrency := 0;

              vValorMov := (qryProdutosContratosTrocaprecovenda.AsCurrency * vQtdeMov) + qryContratosDevolvidosfrete.AsCurrency
                                                          + qryContratosDevolvidosseguro.AsCurrency
                                                          + qryContratosDevolvidosvaloripi.AsCurrency
                                                          + qryContratosDevolvidosvaloricmssubstituicao.AsCurrency
                                                          - qryContratosDevolvidosdesconto.AsCurrency
                                                          - qryContratosDevolvidosValorDescontoItem.asCurrency;

              qryContratosDevolvidosvalorvista.AsCurrency   := Truncar(vvalorMov,2);
              qryContratosDevolvidosvalorprazo.AsCurrency   := Truncar(vvalorMov + (qryProdutosContratosTrocaacrescimo.AsCurrency - vAcrescimoDevolvido),2);

            end
            else
            begin
              if qryProdutosContratosTrocadesconto.AsCurrency > 0 then

                qryContratosDevolvidosdesconto.AsCurrency    := truncar(RatearValores(qryProdutosContratosTrocadesconto.AsCurrency , qryProdutosContratosTrocaquantidade.AsCurrency, vQtdeMov),2)

              else
                qryContratosDevolvidosdesconto.AsCurrency := 0;

              if qryProdutosContratosTrocavalordescontoitem.AsCurrency > 0 then
                qryContratosDevolvidosvalordescontoitem.AsCurrency    :=  truncar(RatearValores(qryProdutosContratosTrocavalordescontoitem.AsCurrency, qryProdutosContratosTrocaquantidade.AsCurrency, vQtdeMov),2)
              else qryContratosDevolvidosvalordescontoitem.AsCurrency := 0;

              if DevolverSeguro and (qryProdutosContratosTrocaseguro.AsCurrency > 0) then
                qryContratosDevolvidosseguro.AsCurrency      :=  truncar(RatearValores(qryProdutosContratosTrocaseguro.AsCurrency, qryProdutosContratosTrocaquantidade.AsCurrency, vQtdeMov),2)
              else qryContratosDevolvidosseguro.AsCurrency   := 0;

              if DevolverFrete and (qryProdutosContratosTrocafrete.AsCurrency > 0) then
                qryContratosDevolvidosfrete.AsCurrency       :=  truncar(RatearValores(qryProdutosContratosTrocafrete.AsCurrency, qryProdutosContratosTrocaquantidade.AsCurrency, vQtdeMov),2)
              else qryContratosDevolvidosfrete.AsCurrency    := 0;

              if (qryProdutosContratosTrocavaloripi.AsCurrency > 0) then
                qryContratosDevolvidosvaloripi.AsCurrency       :=  truncar(RatearValores(qryProdutosContratosTrocavaloripi.AsCurrency, qryProdutosContratosTrocaquantidade.AsCurrency, vQtdeMov),2)
              else qryContratosDevolvidosvaloripi.AsCurrency    := 0;

              if (qryProdutosContratosTrocaicmsvalorst.AsCurrency > 0) then
                qryContratosDevolvidosvaloricmssubstituicao.AsCurrency       :=  truncar(RatearValores(qryProdutosContratosTrocaicmsvalorst.AsCurrency,qryProdutosContratosTrocaquantidade.AsCurrency, vQtdeMov),2)
              else qryContratosDevolvidosvaloricmssubstituicao.AsCurrency   := 0;


              vValorMov := (qryProdutosContratosTrocaprecovenda.AsCurrency * vQtdeMov) + qryContratosDevolvidosfrete.AsCurrency
                                                          + qryContratosDevolvidosseguro.AsCurrency
                                                          + qryContratosDevolvidosvaloripi.AsCurrency
                                                          + qryContratosDevolvidosvaloricmssubstituicao.AsCurrency
                                                          - qryContratosDevolvidosdesconto.AsCurrency
                                                          - qryContratosDevolvidosValorDescontoItem.asCurrency;

              qryContratosDevolvidosvalorvista.AsCurrency    := Truncar(vvalorMov,2);
              qryContratosDevolvidosvalorprazo.AsCurrency    := Truncar(vvalorMov +  RatearValores(qryProdutosContratosTrocaacrescimo.AsCurrency, qryProdutosContratosTrocaquantidade.AsCurrency, vQtdeMov),2);

            end;

            qryContratosDevolvidossituacao.AsString := vsituacao;
            qryContratosDevolvidos.Post;

            vDescontoDevolvido := vDescontoDevolvido + qryContratosDevolvidosdesconto.AsCurrency;
            vValorDescontoItemDevolvido := vValorDescontoItemDevolvido + qryprodutoscontratosdevolvidosvalordescontoitem.asCurrency;
            vFreteDevolvido    := vFreteDevolvido    + qryContratosDevolvidosfrete.AsCurrency;
            vSeguroDevolvido   := vSeguroDevolvido   + qryContratosDevolvidosseguro.AsCurrency;
            vAcrescimoDevolvido:= vAcrescimoDevolvido + (qryContratosDevolvidosvalorprazo.AsCurrency - qryContratosDevolvidosvalorvista.AsCurrency);
            vIPIDevolvido    := vIPIDevolvido    + qryContratosDevolvidosvaloripi.AsCurrency;
            vIcmsSubstituicaoDevolvido    := vIcmsSubstituicaoDevolvido    + qryContratosDevolvidosvaloricmssubstituicao.AsCurrency;

            vValorPrazo := vValorPrazo + qryContratosDevolvidosvalorprazo.AsCurrency;


          end;
        end;
      end;
      qryProdutosContratosTroca.Next;
    end;

  finally
    qryProdutosContratosTroca.GotoBookmark(vPos);
    qryProdutosContratosTroca.FreeBookmark(vPos);
    qryProdutosContratosTroca.EnableControls;
  end;

  // SERVIÇOS
  qryServicosContratos.DisableControls;
  vPos:= qryServicosContratos.GetBookmark;
  try
    qryServicosContratos.First;
    for vA:= 0 to qryServicosContratos.RecordCount - 1 do
    begin
      if (qryServicosContratoscancelado.AsCurrency < qryServicosContratosquantidade.AsCurrency) then
      begin
        if (qryServicosContratosdevolver.AsCurrency > 0) then
        begin
          vQtdeMov := qryServicosContratosdevolver.AsCurrency;

          qryContratosDevolvidos.Append;
          qryContratosDevolvidoscontrato.AsString        := qryContratosTrocanumero.AsString;
          qryContratosDevolvidosproduto.clear;

          qryContratosDevolvidosservico.asString := qryServicosContratosservico.asString;

          qryContratosDevolvidosfilial.AsInteger         := qryContratosTrocafilialvenda.AsInteger;
          qryContratosDevolvidosdevolucao.AsDateTime     := DataServidor;
          qryContratosDevolvidosquantidade.AsCurrency    := vQtdeMov;

          qryContratosDevolvidosdesconto.AsCurrency := 0;
          qrycontratosDevolvidosValorDescontoItem.asCurrency := 0;
          qryContratosDevolvidosfrete.AsCurrency   := 0;
          qryContratosDevolvidosseguro.AsCurrency  := 0;

          if qryContratosTrocasituacao.asString = 'F' then
            qryContratosDevolvidossituacao.AsString := 'F'
          else
            qryContratosDevolvidossituacao.AsString := 'N';

          vFaltam:= (qryServicosContratosquantidade.AsCurrency -
                    qryServicosContratoscancelado.AsCurrency  -
                    qryServicosContratosdevolver.AsCurrency)  > 0;

          if not vFaltam then  //GARANTE O FECHAMENTO DOS VALORES NO CASO DE DEVOLUCAO TOTAL DO PRODUTO
          begin
            vImpostoRetidoDevolvido := 0;

            if not qryServicosContratosDevolvidos.IsEmpty then
            begin
              try
                GuardarRegistroAtual(qryServicosContratosDevolvidos,true);
                qryServicosContratosDevolvidos.First;
                while not qryServicosContratosDevolvidos.Eof do
                begin
                  if qryServicosContratosservico.Asinteger = qryServicosContratosDevolvidosservico.asinteger then
                  begin
                    vImpostoRetidoDevolvido := vImpostoRetidoDevolvido + qryServicosContratosDevolvidosimpostoretido.AsCurrency;
                  end;
                  qryServicosContratosDevolvidos.Next;
                end;
              finally
                VoltarRegistroAtual(qryServicosContratosDevolvidos);
              end;
            end;

            if qryServicosContratosimpostoretido.AsCurrency > 0 then
              qryContratosDevolvidosimpostoretido.AsCurrency   := Truncar(qryServicosContratosimpostoretido.AsCurrency - vImpostoRetidoDevolvido,2)
            else qryContratosDevolvidosimpostoretido.AsCurrency := 0;

          end
          else
          begin
            if qryServicosContratosimpostoretido.AsCurrency > 0 then
              qryContratosDevolvidosimpostoretido.AsCurrency    :=  truncar(RatearValores(qryServicosContratosimpostoretido.AsCurrency, qryServicosContratosquantidade.AsCurrency, vQtdeMov),2)
            else qryContratosDevolvidosimpostoretido.AsCurrency := 0;
          end;

          vValorMov := ( qryServicosContratosvalorservico.AsCurrency * vQtdeMov) - qryContratosDevolvidosimpostoretido.AsCurrency;
          qryContratosDevolvidosvalorvista.AsCurrency    := Truncar(vvalorMov,2);
          qryContratosDevolvidosvalorprazo.AsCurrency    := Truncar(vvalorMov,2);

          qryContratosDevolvidos.Post;

          vValorPrazo := vValorPrazo + qryContratosDevolvidosvalorprazo.AsCurrency;
        end;
      end;
      qryServicosContratos.Next;
    end;

  finally
    qryServicosContratos.GotoBookmark(vPos);
    qryServicosContratos.FreeBookmark(vPos);
    qryServicosContratos.EnableControls;
  end;

  if DevolveCreditoTroca <> 0 then
  begin
    vSaldo := DevolveCreditoTroca;

    qryContratosDevolvidos.First;
    while (vSaldo <> 0) and not qryContratosDevolvidos.eof do
    begin
      if qryContratosDevolvidosvalorprazo.AsCurrency > vSaldo then
      begin
        qrycontratosdevolvidos.edit;
        qryContratosDevolvidoscreditotroca.AsCurrency := vSaldo;
        vSaldo := 0;
        qrycontratosdevolvidos.post;
      end
      else
      begin
        qrycontratosdevolvidos.edit;
        qryContratosDevolvidoscreditotroca.AsCurrency := qryContratosDevolvidosvalorprazo.AsCurrency;
        vSaldo := vSaldo - qryContratosDevolvidosvalorprazo.AsCurrency;
        qrycontratosdevolvidos.post;
      end;
      qryContratosDevolvidos.next;
    end;
  end;

  ValidarTotaisContratosDevolvidos_TotaisContratos;

end;



function TdtmTrocaMercadorias.GetDevolveReal: Currency;
begin
  Result := FDevolveReal;
end;

procedure TdtmTrocaMercadorias.AtribuirValoresProdutosContratosViaDadosFiscais;
var
  Faltam: Boolean;
  icmsbasecalculo, icmsbasecalculodev,
  icmsvalor, icmsvalordev,
  icmsvalorst, icmsvalorstdev,
  icmsbasecalculost, icmsbasecalculostdev,
  ipibasecalculo, ipibasecalculodev,
  ipivalor, ipivalordev,
  iibasecalculo, iibasecalculodev,
  iidespaduaneira, iidespaduaneiradev,
  iivalor, iivalordev,
  iiiof, iiiofdev,
  pisbasecalculo, pisbasecalculodev,
  pisvalor, pisvalordev,
  cofinsbasecalculo, cofinsbasecalculodev,
  cofinsvalor, cofinsvalordev,
  desconto, descontodev,
  valordescontoitem_, valordescontoitemdev: Currency;
  
  i,j: integer;

  {Acrescimo, vdesconto, vdescontoitem, vfrete, vseguro: Currency;}
begin
              {
  vAcrescimo := 0;
  vdesconto := 0;
  vdescontoitem := 0;
  vfrete := 0;
  vseguro := 0;
}
  try
//    qryProdutosContratos.Edit;

    for i := 0 to length(produtoseServicos[produtos])-1 do
    begin
      if produtoseServicos[produtos][i].produto = qryDadosFiscaisproduto.asLargeInt then
        produtoseServicos[produtos][i].RegistroOK := false;
    end;

    GuardarRegistroAtual(qryDadosFiscais,true);
    qryDadosFiscais.First;

    while not qryDadosFiscais.Eof do
    begin

      if qryDadosFiscaisdevolver.AsFloat > 0 then
      begin
        icmsbasecalculo   := 0; icmsvalor       := 0; icmsvalorst := 0;
        icmsbasecalculost := 0; ipibasecalculo  := 0; ipivalor    := 0;
        iibasecalculo     := 0; iidespaduaneira := 0; iivalor     := 0;
        iiiof             := 0; pisbasecalculo  := 0; pisvalor    := 0;
        cofinsbasecalculo := 0; cofinsvalor     := 0;
        desconto := 0;
        valordescontoitem_ := 0;


        icmsbasecalculodev   := 0; icmsvalordev       := 0; icmsvalorstdev   := 0;
        icmsbasecalculostdev := 0; ipibasecalculodev  := 0; ipivalordev      := 0;
        iibasecalculodev     := 0; iidespaduaneiradev := 0; iivalordev       := 0;
        iiiofdev             := 0; pisbasecalculodev  := 0; pisvalordev      := 0;
        cofinsbasecalculodev := 0; cofinsvalordev     := 0;
        descontodev := 0; valordescontoitemdev := 0;


        //CAMPOS FIXOS

        i := length(ProdutoseServicos[Produtos]);

        SetLength(ProdutoseServicos[Produtos], i+1);

        ProdutoseServicos[Produtos][i].contrato := qryProdutosContratosTrocacontrato.asString;
        ProdutoseServicos[Produtos][i].dadofiscal := qrydadosfiscaisdadofiscal.asinteger;
        ProdutoseServicos[Produtos][i].eHCupomFiscal := qryDadosFiscaisehcupomfiscal.asBoolean;
        ProdutoseServicos[Produtos][i].modelodocto := qryDadosFiscaismodelodocto.asString;
        ProdutoseServicos[Produtos][i].numeroprodutotabela := qrydadosfiscaisnumeroproduto.asinteger;
        ProdutoseServicos[Produtos][i].numeronotafiscalsaida := qrydadosfiscaisnota.asinteger;
        ProdutoseServicos[Produtos][i].produto := qryDadosFiscaisproduto.asLargeInt;
        ProdutoseServicos[Produtos][i].produtovisual := qryDadosFiscaisprodutovisual.asString;
        ProdutoseServicos[Produtos][i].filial := qryDadosFiscaisfilial.asInteger;
        ProdutoseServicos[Produtos][i].descricaoproduto := qryProdutosContratosTrocadescricao.asString;
        ProdutoseServicos[Produtos][i].aliquotaicms := qryprodutoscontratosTrocaaliquotaicms.ascurrency;
        ProdutoseServicos[Produtos][i].qtdeentregueparadevolver := qrydadosfiscaisdevolver.ascurrency;
        ProdutoseServicos[Produtos][i].PrecoVenda := qryprodutosContratosTrocaPrecoVenda.asCurrency;
        ProdutoseServicos[Produtos][i].valorreducaobaseunitaria := qryDadosFiscaisvalorreducaobaseunitaria.ascurrency;
        ProdutoseServicos[Produtos][i].incidencia := qryprodutosContratosTrocaincidencia.asstring;
        ProdutoseServicos[Produtos][i].csosn := qryprodutosContratosTrocacsosn.asstring;
        ProdutoseServicos[Produtos][i].vendedor :=  qryDadosFiscaisvendedor.asVariant;
        ProdutoseServicos[Produtos][i].vendedordadofiscal := qryDadosFiscaisvendedordadofiscal.asVariant;

        ProdutoseServicos[Produtos][i].acrescimo := truncar(qrydadosfiscaisAcrescimo.asCurrency / qryDadosFiscaisqtdeoriginal.asCurrency * qrydadosfiscaisdevolver.ascurrency,2);
        ProdutoseServicos[Produtos][i].desconto := truncar(qrydadosfiscaisdesconto.AsCurrency / qryDadosFiscaisqtdeoriginal.asCurrency  * qrydadosfiscaisdevolver.ascurrency,2);
        ProdutoseServicos[Produtos][i].valordescontoitem := truncar(qrydadosfiscaisvalordescontoitem.AsCurrency / qryDadosFiscaisqtdeoriginal.asCurrency  * qrydadosfiscaisdevolver.ascurrency,2);

        if DevolverFrete then
          ProdutoseServicos[Produtos][i].frete   := truncar(qrydadosfiscaisfrete.AsCurrency / qryDadosFiscaisqtdeoriginal.asCurrency  * qrydadosfiscaisdevolver.ascurrency,2);
        if DevolverSeguro then
          ProdutoseServicos[Produtos][i].seguro  := truncar(qrydadosfiscaisseguro.AsCurrency / qryDadosFiscaisqtdeoriginal.asCurrency  * qrydadosfiscaisdevolver.ascurrency,2);


        ProdutoseServicos[Produtos][i].aliquotaicmsst := qryDadosFiscaisaliquotaicmsst.AsFloat;
        ProdutoseServicos[Produtos][i].icmsmodalidade     := qryDadosFiscaisicmsmodalidade.AsInteger;
        ProdutoseServicos[Produtos][i].icmsmodsubst       := qryDadosFiscaisicmsmodsubst.AsInteger;

        ProdutoseServicos[Produtos][i].ipicst              := qryDadosFiscaisipicst.AsString;

        ProdutoseServicos[Produtos][i].piscst             := qryDadosFiscaispiscst.AsString;
        ProdutoseServicos[Produtos][i].pisaliquota          := qryDadosFiscaispisaliquota.AsFloat;

        ProdutoseServicos[Produtos][i].cofinscst          := qryDadosFiscaiscofinscst.AsString;
        ProdutoseServicos[Produtos][i].cofinsaliquota       := qryDadosFiscaiscofinsaliquota.AsFloat;

        ProdutoseServicos[Produtos][i].unidade             := qryDadosFiscaisunidade.AsString;
        ProdutoseServicos[Produtos][i].origem              := qryDadosFiscaisorigem.AsString;
        ProdutoseServicos[Produtos][i].extipi              := qryDadosFiscaisextipi.AsString;
        ProdutoseServicos[Produtos][i].genero             := qryDadosFiscaisgenero.AsInteger;
        ProdutoseServicos[Produtos][i].tribcodigoean       := qryDadosFiscaistribcodigoean.AsString;
        ProdutoseServicos[Produtos][i].tribunidade         := qryDadosFiscaistribunidade.AsString;
        ProdutoseServicos[Produtos][i].tribquantidade       := qrydadosfiscaisdevolver.ascurrency;
// erro abaixo achado em tempo de execução na nova ide embarcadero.... tabela não esta ativa ...e o dado por sinal esta errado
//        ProdutoseServicos[Produtos][i].tribunitario         := qryprodutosContratosPrecoVenda.asCurrency;
        ProdutoseServicos[Produtos][i].tribunitario := qryDadosFiscaistribunitario.asCurrency;

        ProdutoseServicos[Produtos][i].enquadramento      := qryDadosFiscaisenquadramento.AsInteger;
        ProdutoseServicos[Produtos][i].classificacaofiscal:= qryDadosFiscaisclassificacaofiscal.AsString;


        Faltam:= (qryDadosFiscaisquantidade.AsCurrency   -
                  qryDadosFiscaisdevolver.AsCurrency)    > 0;

        if not faltam then
        begin
          if qryDadosFiscaisquantidade.AsCurrency > 0 then
          begin
            // BUSCAR OS VALORES DE NOTASPAG E PRODUTOSNOTASPAG JÁ DEVOLVIDOS PARA OS DADOSFISCAIS SELECIONADOS
            {
            RefazConsultaPorNome(qryProdutosNotasPagDevolvidos, ['dadofiscal','produto','filial'],
                  [qryDadosFiscaisdadofiscal.AsInteger, qryProdutosContratosproduto.AsString,
                   qryDadosFiscaisfilialnota.AsInteger]);
            }

            RefazConsultaPorNome(qryProdutosNotasPagDevolvidos, ['dadofiscal','numeroproduto','produto','filial'],
                  [qryDadosFiscaisdadofiscal.AsInteger,
                   qryDadosFiscaisnumeroproduto.asinteger,
                   qrydadosfiscaisproduto.asString,
                   qryDadosFiscaisfilialnota.AsInteger]);

            qryProdutosNotasPagDevolvidos.first;
            while not qryProdutosNotasPagDevolvidos.Eof do
            begin
              icmsbasecalculodev   := icmsbasecalculodev   + qryProdutosNotasPagDevolvidosicmsbasecalculo.AsCurrency;
              icmsvalordev         := icmsvalordev         + qryProdutosNotasPagDevolvidosicmsvalor.AsCurrency;
              icmsvalorstdev       := icmsvalorstdev       + qryProdutosNotasPagDevolvidosicmsvalorst.AsCurrency;
              icmsbasecalculostdev := icmsbasecalculostdev + qryProdutosNotasPagDevolvidosicmsbasecalculost.AsCurrency;
              ipibasecalculodev    := ipibasecalculodev    + qryProdutosNotasPagDevolvidosipibasecalculo.AsCurrency;
              ipivalordev          := ipivalordev          + qryProdutosNotasPagDevolvidosipivalor.AsCurrency;
              iibasecalculodev     := iibasecalculodev     + qryProdutosNotasPagDevolvidosiibasecalculo.AsCurrency;
              iidespaduaneiradev   := iidespaduaneiradev   + qryProdutosNotasPagDevolvidosiidespaduaneira.AsCurrency;
              iivalordev           := iivalordev           + qryProdutosNotasPagDevolvidosiivalor.AsCurrency;
              iiiofdev             := iiiofdev             + qryProdutosNotasPagDevolvidosiiiof.AsCurrency;
              pisbasecalculodev    := pisbasecalculodev    + qryProdutosNotasPagDevolvidospisbasecalculo.AsCurrency;
              pisvalordev          := pisvalordev          + qryProdutosNotasPagDevolvidospisvalor.AsCurrency;
              cofinsbasecalculodev := cofinsbasecalculodev + qryProdutosNotasPagDevolvidoscofinsbasecalculo.AsCurrency;
              cofinsvalordev       := cofinsvalordev       + qryProdutosNotasPagDevolvidoscofinsvalor.AsCurrency;
              descontodev          := descontodev          + qryProdutosNotasPagDevolvidosdesconto.AsCurrency;
              valordescontoitemdev := valordescontoitemdev + qryProdutosNotasPagDevolvidosvalordescontoitem.AsCurrency;

              qryProdutosNotasPagDevolvidos.Next;
            end;
            qryProdutosNotasPagDevolvidos.Close;

            icmsbasecalculo   := icmsbasecalculo + qryDadosFiscaisicmsbasecalculo.AsCurrency - icmsbasecalculodev;
            icmsvalor         := icmsvalor       + qryDadosFiscaisicmsvalor.AsCurrency       - icmsvalordev;
            icmsvalorst       := icmsvalorst     + qryDadosFiscaisicmsvalorst.AsCurrency     - icmsvalorstdev;
            icmsbasecalculost := icmsbasecalculost + qryDadosFiscaisicmsbasecalculost.AsCurrency - icmsbasecalculostdev;
            ipibasecalculo    := ipibasecalculo  + qryDadosFiscaisipibasecalculo.AsCurrency  - ipibasecalculodev;
            ipivalor          := ipivalor        + qryDadosFiscaisvaloripi.AsCurrency        - ipivalordev;
            iibasecalculo     := iibasecalculo   + qryDadosFiscaisiibasecalculo.AsCurrency   - iibasecalculodev;
            iidespaduaneira   := iidespaduaneira + qryDadosFiscaisiidespaduaneira.AsCurrency - iidespaduaneiradev;
            iivalor           := iivalor         + qryDadosFiscaisiivalor.AsCurrency         - iivalordev;
            iiiof             := iiiof           + qryDadosFiscaisiiiof.AsCurrency           - iiiofdev;
            pisbasecalculo    := pisbasecalculo  + qryDadosFiscaispisbasecalculo.AsCurrency  - pisbasecalculodev;
            pisvalor          := pisvalor        + qryDadosFiscaispisvalor.AsCurrency        - pisvalordev;
            cofinsbasecalculo := cofinsbasecalculo + qryDadosFiscaiscofinsbasecalculo.AsCurrency - cofinsbasecalculodev;
            cofinsvalor       := cofinsvalor     + qryDadosFiscaiscofinsvalor.AsCurrency     - cofinsvalordev;

            desconto          := desconto          + qryDadosFiscaisdesconto.AsCurrency - descontodev;
            valordescontoitem_ := valordescontoitem_ + qryDadosFiscaisvalordescontoitem.AsCurrency - valordescontoitemdev;

          end;
        end
        else
        begin
          icmsbasecalculo   := icmsbasecalculo + Truncar(qryDadosFiscaisicmsbasecalculo.AsCurrency     /
                                                         qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);
          icmsvalor         := icmsvalor       + Truncar(qryDadosFiscaisicmsvalor.AsCurrency           /
                                                         qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);
          icmsvalorst       := icmsvalorst     + Truncar(qryDadosFiscaisicmsvalorst.AsCurrency         /
                                                         qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);
          icmsbasecalculost := icmsbasecalculost + Truncar(qryDadosFiscaisicmsbasecalculost.AsCurrency /
                                                           qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);
          ipibasecalculo    := ipibasecalculo  + Truncar(qryDadosFiscaisipibasecalculo.AsCurrency      /
                                                         qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);
          ipivalor          := ipivalor        + Truncar(qryDadosFiscaisvaloripi.AsCurrency      /
                                                         qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);
          iibasecalculo     := iibasecalculo   + Truncar(qryDadosFiscaisiibasecalculo.AsCurrency       /
                                                         qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);
          iidespaduaneira   := iidespaduaneira + Truncar(qryDadosFiscaisiidespaduaneira.AsCurrency     /
                                                         qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);
          iivalor           := iivalor         + Truncar(qryDadosFiscaisiivalor.AsCurrency             /
                                                         qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);
          iiiof             := iiiof           + Truncar(qryDadosFiscaisiiiof.AsCurrency               /
                                                         qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);
          pisbasecalculo    := pisbasecalculo  + Truncar(qryDadosFiscaispisbasecalculo.AsCurrency      /
                                                         qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);
          pisvalor          := pisvalor        + Truncar(qryDadosFiscaispisvalor.AsCurrency            /
                                                         qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);
          cofinsbasecalculo := cofinsbasecalculo + Truncar(qryDadosFiscaiscofinsbasecalculo.AsCurrency /
                                                           qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);
          cofinsvalor       := cofinsvalor     + Truncar(qryDadosFiscaiscofinsvalor.AsCurrency         /
                                                         qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);

          desconto       := desconto     + Truncar(qryDadosFiscaisdesconto.AsCurrency         /
                                                         qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);

          valordescontoitem_ := valordescontoitem_     + Truncar(qryDadosFiscaisvalordescontoitem.AsCurrency         /
                                                         qryDadosFiscaisqtdeoriginal.AsCurrency * qryDadosFiscaisdevolver.AsCurrency,2);

        end;

        ProdutoseServicos[Produtos][i].icmsbasecalculo   := icmsbasecalculo;
        ProdutoseServicos[Produtos][i].icmsvalor         := icmsvalor;
        ProdutoseServicos[Produtos][i].icmsvalorst := icmsvalorst;
        ProdutoseServicos[Produtos][i].icmsbasecalculost := icmsbasecalculost;
        ProdutoseServicos[Produtos][i].ipibasecalculo    := ipibasecalculo;
        ProdutoseServicos[Produtos][i].valoripi := ipivalor;
        ProdutoseServicos[Produtos][i].iibasecalculo     := iibasecalculo;
        ProdutoseServicos[Produtos][i].iidespaduaneira   := iidespaduaneira;
        ProdutoseServicos[Produtos][i].iivalor           := iivalor;
        ProdutoseServicos[Produtos][i].iiiof             := iiiof;
        ProdutoseServicos[Produtos][i].pisbasecalculo    := pisbasecalculo;
        ProdutoseServicos[Produtos][i].pisvalor          := pisvalor;
        ProdutoseServicos[Produtos][i].cofinsbasecalculo := cofinsbasecalculo;
        ProdutoseServicos[Produtos][i].cofinsvalor       := cofinsvalor;
        ProdutoseServicos[Produtos][i].desconto       := desconto;
        ProdutoseServicos[Produtos][i].valordescontoitem       := valordescontoitem_;

        qryProdutosSeries.first;
        while not qryProdutosSeries.eof do
        begin
          if (qryprodutosseriesdadofiscal.asinteger = ProdutoseServicos[Produtos][i].dadofiscal) and
             (qryProdutosSeriesproduto.asLargeint =  ProdutoseServicos[Produtos][i].produto) and
             qryprodutosSeriesDevolvido.asBoolean then
          begin
            j := length(ProdutoseServicos[Produtos][i].numeroserie);
            SetLength(ProdutoseServicos[Produtos][i].numeroserie, j+1);
            ProdutoseServicos[Produtos][i].numeroserie[j].numeroserie := qryProdutosSeriesnumeroserie.asString;
          end;
          qryProdutosSeries.next;
        end;

        ProdutoseServicos[Produtos][i].RegistroOK        := true;

      end;


      qryDadosFiscais.Next;
    end;


//    qryProdutosContratos.Post;
  finally
    VoltarRegistroAtual(qryDadosFiscais);
  end;
end;

procedure TdtmTrocaMercadorias.MovimentarProdutosNota;
var
  SituacaoProduto : TtecComposicao;
  I,
  Preco: integer;
//  QtdeEntregar,
  QtdeMovto, vSaldo, Custo, fEstoqueBloqueioFuturo: Currency;
  Produto: Int64;
  MovExtra, TRERealizado: Boolean;
  {Ref: String;}



  procedure BloquearEstoque;
  var
    WhereSQL,filial: String;
  begin
    qryProdutosTrocados.DisableControls;
    try
      WhereSQL := '';
      qryProdutosTrocados.First;
      while not qryProdutosTrocados.Eof do
      begin
        if ((qryProdutosTrocadossituacao.AsString = 'F') or
                (((qryProdutosTrocadossituacao.AsString = 'N') or
                  (qryProdutosTrocadossituacao.AsString = 'P')) and
                   not TemProdutoImprimirNotaDevolucao) ) then
              filial := qryProdutosTrocadosfilialsaida.AsString
            else
//              filial := inttostr(ifthen(TipoFilial<>'V', FilialBase, qryProdutosTrocadosfilialsaida.AsInteger));
              filial := inttostr(ifthen(TipoFilial<>'V', qryProdutosTrocadosfilial.AsInteger, qryProdutosTrocadosfilialsaida.AsInteger));


        if (qryProdutosTrocadosquantidade.AsCurrency > 0) then
        begin
          WhereSQL := WhereSQL +
          '((e.produto = ' + qryProdutosTrocadosproduto.AsString + ')and' +
          '(e.filial = '   + filial  + '))or';

          if qryProdutosTrocadosfilial.AsString <> qryProdutosTrocadosfilialsaida.AsString then
          begin
            WhereSQL := WhereSQL +
            '((e.produto = ' + qryProdutosTrocadosproduto.AsString + ')and' +
            '(e.filial = '   + filial  + '))or'
          end;
        end;
        qryProdutosTrocados.Next
      end;

      qryProdutosTrocadosSaida.First;
      while not qryProdutosTrocadosSaida.Eof do begin
        if (qryProdutosTrocadosSaidaquantidade.AsCurrency > 0) then begin
          WhereSQL := WhereSQL +
          '((e.produto = ' + qryProdutosTrocadosSaidaproduto.AsString + ')and' +
          '(e.filial = '   + qryProdutosTrocadosSaidafilial.AsString  + '))or';
        end;
        qryProdutosTrocadosSaida.Next
      end;

      Delete(WhereSQL, Length(WhereSQL) - 1, 2);
    finally
      qryProdutosTrocados.EnableControls
    end;
    qryEstoqueBloqueio.Sql[07]:= WhereSQL;
    qryEstoqueBloqueio.Open;
  end;

  procedure NovoMovimento(Produto: Int64; Filial: Integer);
  begin
    if not qryMovimentos.Active then
      qryMovimentos.Active:= True;
    qryMovimentos.Append;
    spcMovimentosProximo.Open;
    qryMovimentosnumero.AsInteger    := spcMovimentosProximonumero.AsInteger;
    spcMovimentosProximo.Close;
    qryMovimentosproduto.AsLargeInt  := Produto;
    qryMovimentosfilial.AsInteger    := Filial_Estoque_(Filial);
  end;

  procedure InserirProduto;  {falta adicionar o custo}
  begin
    if not qryEstoques.Active then
      qryEstoques.Active:= True;
    qryEstoques.Insert;
    qryEstoquesproduto.AsLargeInt       := Produto;
//    qryEstoquesfilial.AsInteger         := ifthen(TipoFilial<>'V', FilialBase, qryProdutosTrocadosfilial.asinteger);
    qryEstoquesfilial.AsInteger         := Filial_Estoque_(ifthen(TipoFilial<>'V', qryProdutosTrocadosfilial.asinteger, qryProdutosTrocadosfilialsaida.asinteger));
    qryEstoquesultimaentrada.AsDateTime := DataServidor;
    qryEstoquesemestoque.AsCurrency      := 0;
    qryEstoquesreservado.AsCurrency      := 0;
    qryEstoquestransito.AsCurrency       := 0;
    qryEstoquesdemonstracao.AsCurrency   := 0;
    qryEstoquesconserto.AsCurrency       := 0;
    qryEstoquesfuturo.AsCurrency         := 0;
    qryEstoquesdanificada.AsCurrency     := 0;
    qryEstoquesestoquefisico.AsCurrency  := 0;
    qryEstoques.Post;
  end;

  function SQLListaDadosFiscais: String;
  var
    Str: String;
  begin
    Str:= '';

    {
    qryNotasPagDadosFiscais.First;
    While not qryNotasPagDadosFiscais.Eof do begin
      if (qryProdutosTrocadosproduto.AsLargeInt = qryNotasPagDadosFiscaisproduto.AsLargeInt) and
         (qryNotasPagDadosFiscaisfilial.AsInteger = qryProdutosTrocadosfilial.AsInteger)then
        Str:= Str + IntToStr(qryNotasPagDadosFiscaisdadofiscal.AsInteger) + ',';
      qryNotasPagDadosFiscais.Next;
    end;
    }

    qryProdutosNotasPag.First;
    While not qryProdutosNotasPag.Eof do
    begin
      if (qryProdutosTrocadosproduto.AsLargeInt = qryProdutosNotasPagproduto.AsLargeInt) and
         (qryProdutosNotasPagfilial.AsInteger = qryProdutosTrocadosfilial.AsInteger) then
        Str:= Str + IntToStr(qryProdutosNotasPagdadofiscal.AsInteger) + ',';
      qryProdutosNotasPag.Next;
    end;


    if Str <> '' then begin
      Delete(Str,Length(Str),1);
      Str:= 'and (pd.dadofiscal in (' + Str + '))';
    end;

    Result:= Str;
  end;

  procedure IncluirMovimento;
  begin

    if ((qryProdutosTrocadossituacao.AsString = 'F') or
        (((qryProdutosTrocadossituacao.AsString = 'N') or
          (qryProdutosTrocadossituacao.AsString = 'P')) and
           not TemProdutoImprimirNotaDevolucao) ) then
      NovoMovimento(Produto,qryProdutosTrocadosfilialsaida.AsInteger)
    else
//      NovoMovimento(Produto, ifthen(TipoFilial<>'V', FilialBase, qryProdutosTrocadosfilial.AsInteger)); aqui agora
      NovoMovimento(Produto, ifthen(TipoFilial<>'V', qryProdutosTrocadosfilial.AsInteger, qryProdutosTrocadosfilialSaida.AsInteger));


    // ATENÇÃO: EXISTE UM BUG QUANDO A FILIAL FOR DIFERENTE EM RELAÇÃO AO FUTURO.
    if parsistema.IncluirOrcamentonosItensdaTroca then
    begin
      if qryOrcamentosnumero.AsString <>'' then
        qrymovimentosreferencia.asstring := 'ORÇAMENTO ' + qryOrcamentoscodigo.AsString + ' TROCADO'
      else
        qrymovimentosreferencia.asstring := 'ORÇAMENTO NÃO INFORMADO TROCADO';
    end
    else
    begin
      if qryContratosTrocanumero.AsString <> '' then
      begin
        qrymovimentosreferencia.asstring := 'CT ' + qryContratosTrocanumero.AsString + ' TROCADO';
        qryMovimentosContrato.asString := qryContratosTrocanumero.AsString;
      end
      else
        qrymovimentosreferencia.asstring := 'CT NÃO INFORMADO TROCADO';
    end;


  end;

  function ref: String;
  begin
     result := '';
    {
    if (TemProdutoImprimirNota and
       (qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency > 0)) then
    begin
      if qryProdutosNotasPag.Locate('produto',IntToStr(Produto),[]) then
      begin
    }
        if qryNotaspag.Locate('codigo', qryprodutosnotaspagcodigonota.AsInteger,[]) then
          result := ' NFE S' + qryNotasPagserie.AsString + ' N' +
                              Format('%6.6d',[qryNotasPagnrdocumento.AsInteger]);
     {
        qryMovimentosreferencia.AsString := qryMovimentosreferencia.AsString + Ref;
      end;
    end;
    }

  end;

  function EstoqueBloqueioFuturo(filial: integer; produto: String): Currency;
  begin
    result := 0;
    if qryEstoqueBloqueio.Locate('filial;produto', VarArrayof([filial, produto]),[]) then
      result := qryEstoqueBloqueiofuturo.asCurrency
        {
    else
      MensagemErro(format('O produto %s e a filial %s não foi encontrado na tabela EstoquesBloqueio',[produto, inttostr(filial)]));
      }
  end;


begin
    BloquearEstoque;

    qryProdutosTrocados.DisableControls;
    try
      for SituacaoProduto:=stNAOCOMPOSTO to stCOMPOSTO do
      begin
        qryProdutosTrocados.First;
        for I:= 1 to qryProdutosTrocados.RecordCount do
        begin
          if FiltrarComposto(qryProdutosTrocadoscomposto.AsBoolean, SituacaoProduto) then
          begin
            TRERealizado := False;
            if (qryProdutosTrocadosQuantidade.AsCurrency > 0) then begin
              Produto:= qryProdutosTrocadosproduto.AsLargeInt;

              if ((qryProdutosTrocadossituacao.AsString = 'N') or
                  (qryProdutosTrocadossituacao.AsString = 'P')) and
                   TemProdutoImprimirNotaDevolucao then begin
                qryCustoProduto.Sql[06]:= SQLListaDadosFiscais;
                qryCustoProduto.Params[0].AsString := IntToStr(qryProdutosTrocadosproduto.AsLargeInt);
                qryCustoProduto.Params[1].AsInteger:= qryProdutosTrocadosfilialSAIDA.AsInteger;
                qryCustoProduto.Open;
              end;

              if qryProdutosTrocadosdefeito.AsBoolean then
              begin
                // Se o produto a ser devolvido for com defeito então será inserido um novo produto.
                // Se já existe um produto avariado então será adicionado a esse produto a qtde devolvida.
                // Isto verificado o codigorecolha

                ReFazConsulta(qryProdutoExiste,[0,1],[IntToStr(qryProdutosTrocadoscaracteristica.AsLargeInt),
                                                      IntToStr(qryProdutosTrocadosproduto.AsLargeInt)]);
                if qryProdutoExiste.IsEmpty then begin
                  spcProdutoProximo.Params[0].AsString:= IntToStr(qryProdutosTrocadoscaracteristica.AsLargeInt);
                  spcProdutoProximo.Open;
                  Produto:= spcProdutoProximocodigo.AsLargeInt;
                  spcProdutoProximo.Close;
                end
                else Produto:= qryProdutoExistecodigo.AsLargeInt;

                // Se já existe um preco para produtos avariados então este será usado, senão será
                // criado um novo preço com o atributo avariado = true.

                ReFazConsulta(qryPrecoExiste,[0],[IntToStr(qryProdutosTrocadoscaracteristica.AsLargeint)]);
                if qryPrecoExiste.IsEmpty then begin
                  spcPrecosProximo.Params[0].AsString:= IntToStr(qryProdutosTrocadoscaracteristica.AsLargeInt);
                  spcPrecosProximo.Open;
                  Preco:= spcPrecosProximocodigo.AsInteger;
                  spcPrecosProximo.Close;

                  if not qryPrecos.Active then
                    qryPrecos.Active:= True;
                  qryPrecos.Insert;
                  qryPrecoscaracteristica.AsLargeInt := qryProdutosTrocadoscaracteristica.AsLargeInt;
                  qryPrecoscodigo.AsInteger          := Preco;
                  qryPrecosdescricao.AsString        := 'DEPRECIADO';
                  qryPrecosavariado.AsBoolean        := True;
                  qryPrecos.Post;
                end
                else Preco:= qryPrecoExistecodigo.AsInteger;

                if qryProdutoExiste.IsEmpty then
                begin
                  // Inserindo o Produto Avariado.
                  if not qryProdutos.Active then
                    qryProdutos.Active:= True;
                  qryProdutos.Insert;
                  qryProdutoscaracteristica.AsLargeInt:= qryProdutosTrocadoscaracteristica.AsLargeInt;
                  qryProdutoscodigo.AsLargeInt        := Produto;
                  qryProdutosdescricao.AsString       := qryProdutosTrocadosdescricaproduto.AsString + ' - DEPRECIADO';
                  qryProdutospreco.AsInteger          := Preco;
                  qryProdutoscodigorecolha.AsLargeInt := qryProdutosTrocadosproduto.AsLargeInt;
                  qryProdutos.Post;

                  // Inserindo o novo Produto Avariado no Estoque.
                  InserirProduto;
                  {
                  if qryProdutosNotasPag.Locate('produto',qryProdutosTrocadosproduto.AsString,[]) then
                  begin
                    qryProdutosNotasPag.Edit;
                    qryProdutosNotasPagProduto.AsLargeInt:= Produto;
                    qryProdutosNotasPag.Post;
                  end;
                  }
                end
                else
                begin
//                  ReFazConsulta(qryEstoques,[0,1],[ifthen(TipoFilial<>'V', FilialBase, qryProdutosTrocadosfilial.AsInteger),IntToStr(Produto)]);
                  ReFazConsulta(qryEstoques,[0,1],[ifthen(TipoFilial<>'V', qryProdutosTrocadosfilial.AsInteger, qryProdutosTrocadosfilialSaida.AsInteger),IntToStr(Produto)]);

                  // Se o produto a ser devolvido não esta contido na filial base,
                  // então será inserido nesta filial.
                  if qryEstoques.IsEmpty then
                    InserirProduto;
                end;
                AtribuirDados(qryProdutosNotasPag, [qryProdutosNotasPagProduto], [produto]);
              end
              else begin
//                ReFazConsulta(qryEstoques,[0,1],[ifthen(TipoFilial<>'V', FilialBase, qryProdutosTrocadosfilial.AsInteger),IntToStr(Produto)]);
                ReFazConsulta(qryEstoques,[0,1],[ifthen(TipoFilial<>'V', qryProdutosTrocadosfilial.AsInteger, qryProdutosTrocadosfilialSaida.AsInteger),IntToStr(Produto)]);

                // Se o produto a ser devolvido não esta contido na filial base,
                // então será inserido nesta filial.
                if qryEstoques.IsEmpty then
                  InserirProduto;
              end;

              // Movimenta o produto que esta sendo devolvido.
               QtdeMovto := 0;
               MovExtra:= False;
      {          QtdeEntregar := qryProdutosTrocadosquantidade.AsInteger -
                              qryProdutosTrocadosqtdeentregue.AsInteger -
                              qryProdutosTrocadoscancelado.AsInteger;
      }

              qryprodutosnotaspag.mastersource := nil;
              qryProdutosNotasPag.LinkFields := '';
              
              qryprodutosnotaspag.filtered := true;

              while (QtdeMovto < qryProdutosTrocadosQuantidade.AsCurrency) do
              begin
                IncluirMovimento;
                fEstoqueBloqueioFuturo := EstoqueBloqueioFuturo(qryMovimentosfilial.asinteger, qryMovimentosproduto.asString);

                if (qryProdutosTrocadossituacao.AsString = '') then
                begin
                  if qryProdutosTrocadosdefeito.AsBoolean then
                  begin
                    qryprodutosnotaspag.first;
                    while not qryprodutosnotaspag.eof do
                    begin
                      if qrymovimentos.state <> dsinsert then
                        IncluirMovimento;

                      qryMovimentosquantidade.AsCurrency := qryprodutosnotaspagquantidade.ascurrency; {qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency;}
                      qryMovimentosvalor.AsCurrency     := qryEstoquescusto.AsCurrency * qryMovimentosquantidade.AsCurrency;
                      qryMovimentostipomovimento.AsString  := 'EFV'; //ADICIONA NO ESTOQUE, ADICIONA FINANCEIRO, SUBTRAI VENDA
                      qryMovimentosreferencia.AsString := qryMovimentosreferencia.AsString + Ref;
                      qryMovimentoscodigonota.AsInteger  := qryProdutosNotasPagcodigonota.AsInteger;
                      qrymovimentosnumerocontrole.asinteger := qryprodutosnotaspagnumero.asinteger;
                      qrymovimentos.post;

                      QtdeMovto:= QtdeMovto + qryMovimentosquantidade.AsCurrency;

                      qryprodutosnotaspag.next;
                    end;
                  end
                  else
                  begin
                    if qryEstoquescusto.AsCurrency > 0 then
                      Custo := qryEstoquescusto.AsCurrency * qryProdutosTrocadosquantidade.AsCurrency
                    else
                      Custo := qryEstoquesvalorultimacompra.AsCurrency * qryProdutosTrocadosquantidade.AsCurrency;

                    qryprodutosnotaspag.first;
                    while not qryprodutosnotaspag.eof do
                    begin

                      if qrymovimentos.state <> dsinsert then
                        IncluirMovimento;

                      qryMovimentosquantidade.AsCurrency := qryprodutosnotaspagquantidade.ascurrency; {qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency;}
                      qryMovimentosvalor.AsCurrency     := Custo;
                      qryMovimentostipomovimento.AsString  := 'EFV'; //ADICIONA NO ESTOQUE, ADICIONA FINANCEIRO, SUBTRAI VENDA
                      qryMovimentosreferencia.AsString := qryMovimentosreferencia.AsString + Ref;
                      qryMovimentoscodigonota.AsInteger  := qryProdutosNotasPagcodigonota.AsInteger;
                      qrymovimentosnumerocontrole.asinteger := qryprodutosnotaspagnumero.asinteger;
                      qrymovimentos.post;

                      QtdeMovto:= QtdeMovto + qryMovimentosquantidade.AsCurrency;


                      if  fEstoqueBloqueioFuturo <> 0 then
                    { if qryProdutosTrocadosfuturo.AsCurrency <>0 then }
                      begin
//                        if qryProdutosTrocadosquantidade.AsCurrency <= qryProdutosTrocadosfuturo.AsCurrency then
                        if qryProdutosTrocadosquantidade.AsCurrency <= fEstoqueBloqueioFuturo then
                        begin
                          if qrymovimentos.state <> dsinsert then
                            IncluirMovimento;

                          qryMovimentosquantidade.AsCurrency := qryProdutosTrocadosquantidade.AsCurrency; {qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency;}
                          qryMovimentostipomovimento.AsString  := 'TFR'; //ADICIONA NO ESTOQUE, ADICIONA FINANCEIRO, SUBTRAI VENDA
                          qryMovimentosreferencia.AsString := qryMovimentosreferencia.AsString + Ref;
                          qryMovimentoscodigonota.AsInteger  := qryProdutosNotasPagcodigonota.AsInteger;
                          qrymovimentosnumerocontrole.asinteger := qryprodutosnotaspagnumero.asinteger;
                          qrymovimentos.post;
                        end
                        else
                        begin

                          {Aqui e agora a razao do erro}
                          if qrymovimentos.state <> dsinsert then
                            IncluirMovimento;

//                        qryMovimentosquantidade.AsCurrency := qryProdutosTrocadosfuturo.AsCurrency; {qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency;}
                          qryMovimentosquantidade.AsCurrency := fEstoqueBloqueioFuturo; {qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency;}
                          qryMovimentostipomovimento.AsString  := 'TFR'; //ADICIONA NO ESTOQUE, ADICIONA FINANCEIRO, SUBTRAI VENDA
                          qryMovimentosreferencia.AsString := qryMovimentosreferencia.AsString + Ref;
                          qryMovimentoscodigonota.AsInteger  := qryProdutosNotasPagcodigonota.AsInteger;
                          qrymovimentosnumerocontrole.asinteger := qryprodutosnotaspagnumero.asinteger;
                          qrymovimentos.post;
                        end;
                      end;

                      qryprodutosnotaspag.next;
                    end;
                  end;
                end
                else
                if ((qryProdutosTrocadossituacao.AsString = 'N') or (qryProdutosTrocadossituacao.AsString = 'P')) then
                begin
                  // Se produto for com defeito então a qtde a ser devolvida será adicionada em estoque.
                  if qryProdutosTrocadosdefeito.AsBoolean then
                  begin
                    qryprodutosnotaspag.first;
                    while not qryprodutosnotaspag.eof do
                    begin
                      if qrymovimentos.state <> dsinsert then
                        IncluirMovimento;

                      qryMovimentosquantidade.AsCurrency := qryprodutosnotaspagquantidade.ascurrency; {qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency;}
                      qryMovimentosvalor.AsCurrency     := qryCustoProdutocusto.AsCurrency * qryMovimentosquantidade.AsCurrency;
                      qryMovimentostipomovimento.AsString  := 'EFC';
                      qryMovimentosreferencia.AsString := qryMovimentosreferencia.AsString + Ref;
                      qryMovimentoscodigonota.AsInteger  := qryProdutosNotasPagcodigonota.AsInteger;
                      qrymovimentosnumerocontrole.asinteger := qryprodutosnotaspagnumero.asinteger;
                      qrymovimentos.post;

                      QtdeMovto:= QtdeMovto + qryMovimentosquantidade.AsCurrency;

                      qryprodutosnotaspag.next;

                    end;
                  end
                  else
                  begin
                     if fEstoqueBloqueioFuturo <> 0 then
//                     if qryProdutosTrocadosfuturo.AsCurrency > 0 then
                     begin
                       if MovExtra then
                       begin

                         if qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency > 0 then
                         begin

//                           if qryProdutosTrocadosfuturo.AsCurrency >
                           if fEstoqueBloqueioFuturo >
                             (qryProdutosTrocadosQuantidade.AsCurrency -
                              qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency) then
                           begin
                             if (qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency <=
                                fEstoqueBloqueioFuturo) then
//                              qryProdutosTrocadosfuturo.AsCurrency) then
                             begin
                               qryMovimentosquantidade.AsCurrency  := qryProdutosTrocadosQuantidade.AsCurrency - qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency;
                               qryMovimentostipomovimento.AsString := 'SQU';
                             end
                             else
                             begin
                               {
                               qryMovimentosquantidade.AsCurrency  := qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency - qryProdutosTrocadosfuturo.AsCurrency;
                               qryMovimentosvalor.AsCurrency      := qryCustoProdutocusto.AsCurrency * qryMovimentosquantidade.AsCurrency;
                               qryMovimentostipomovimento.AsString := 'EFV';
                               }
//                               vSaldo := qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency - qryProdutosTrocadosfuturo.AsCurrency;
                               vSaldo := qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency - fEstoqueBloqueioFuturo;

                               qryprodutosnotaspag.first;
                               while not qryprodutosnotaspag.eof do
                               begin
                                 if qryprodutosnotaspagquantidade.ascurrency >= vSaldo then
                                 begin
                                  if qrymovimentos.state <> dsinsert then
                                    IncluirMovimento;

                                   qryMovimentosquantidade.AsCurrency  := vSaldo;
                                   qryMovimentosvalor.AsCurrency      := qryCustoProdutocusto.AsCurrency * qryMovimentosquantidade.AsCurrency;
                                   qryMovimentostipomovimento.AsString := 'EFV';
                                   qryMovimentoscodigonota.AsInteger  := qryProdutosNotasPagcodigonota.AsInteger;
                                   qrymovimentosnumerocontrole.asinteger := qryprodutosnotaspagnumero.asinteger;
                                   qryMovimentosreferencia.AsString := qryMovimentosreferencia.AsString + Ref;
                                   QtdeMovto:= QtdeMovto + qryMovimentosquantidade.AsCurrency;
                                   qryMovimentos.post;
                                   break;
                                 end
                                 else
                                 begin
                                  if qrymovimentos.state <> dsinsert then
                                    IncluirMovimento;

                                   qryMovimentosquantidade.AsCurrency  := qryprodutosnotaspagquantidade.ascurrency;
                                   qryMovimentosvalor.AsCurrency      := qryCustoProdutocusto.AsCurrency * qryMovimentosquantidade.AsCurrency;
                                   qryMovimentostipomovimento.AsString := 'EFV';
                                   qryMovimentoscodigonota.AsInteger  := qryProdutosNotasPagcodigonota.AsInteger;
                                   qrymovimentosnumerocontrole.asinteger := qryprodutosnotaspagnumero.asinteger;
                                   qryMovimentosreferencia.AsString := qryMovimentosreferencia.AsString + Ref;
                                   QtdeMovto:= QtdeMovto + qryMovimentosquantidade.AsCurrency;
                                   vSaldo := vSaldo - qryprodutosnotaspagquantidade.ascurrency;
                                   qryMovimentos.post
                                 end;
                                 qryprodutosnotaspag.next;
                               end;

                             end;
                           end
                           else
                           begin
                             if not TRERealizado and (fEstoqueBloqueioFuturo {qryProdutosTrocadosfuturo.AsCurrency} <
                                                     (qryProdutosTrocadosQuantidade.AsCurrency -
                                                      qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency)) then
                             begin
                                qryMovimentosquantidade.AsCurrency   := (qryProdutosTrocadosQuantidade.AsCurrency -
                                                                        qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency) -
                                                                        {qryProdutosTrocadosfuturo.AsCurrency} fEstoqueBloqueioFuturo;
                                qryMovimentostipomovimento.AsString := 'TRE';
                                TRERealizado := True;
                             end
                             else
                             begin
                               if (fEstoqueBloqueioFuturo {qryProdutosTrocadosfuturo.AsCurrency} =
                                   (qryProdutosTrocadosQuantidade.AsCurrency -
                                    qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency)) then
                                qryMovimentosquantidade.AsCurrency   := (qryProdutosTrocadosQuantidade.AsCurrency -
                                                                        qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency)
                               else
                                qryMovimentosquantidade.AsCurrency   := fEstoqueBloqueioFuturo {qryProdutosTrocadosfuturo.AsCurrency};
                                qryMovimentostipomovimento.AsString := 'SQU';
                             end;
                           end;
                         end
                         else
                         begin
                             qryMovimentosquantidade.AsCurrency  := qryProdutosTrocadosQuantidade.AsCurrency - fEstoqueBloqueioFuturo {qryProdutosTrocadosfuturo.AsCurrency};
                             qryMovimentostipomovimento.AsString:= 'TRE';
                         end;
                       end
                       else
                       if qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency > 0 then
                       begin
                         if fEstoqueBloqueioFuturo {qryProdutosTrocadosfuturo.AsCurrency} >
                           (qryProdutosTrocadosQuantidade.AsCurrency -
                            qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency) then
                         begin

                           if qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency <= fEstoqueBloqueioFuturo {qryProdutosTrocadosfuturo.AsCurrency} then
                           begin
                             {qryMovimentosquantidade.AsCurrency  := qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency;}

                              qryprodutosnotaspag.first;
                              while not qryprodutosnotaspag.eof do
                              begin
                                if qrymovimentos.state <> dsinsert then
                                  IncluirMovimento;

                                qryMovimentosquantidade.AsCurrency   := qryprodutosnotaspagquantidade.asCurrency {qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency};
                                qryMovimentosvalor.AsCurrency   := qryCustoProdutocusto.AsCurrency * qryMovimentosquantidade.AsCurrency;
                                qryMovimentostipomovimento.AsString := 'ARV';
                                qryMovimentoscodigonota.AsInteger  := qryProdutosNotasPagcodigonota.AsInteger;
                                qrymovimentosnumerocontrole.asinteger := qryprodutosnotaspagnumero.asinteger;
                                qryMovimentosreferencia.AsString := qryMovimentosreferencia.AsString + Ref;
                                QtdeMovto:= QtdeMovto + qryMovimentosquantidade.AsCurrency;
                                qryMovimentos.post;

                                qryprodutosnotaspag.next;

                              end;
                           end
                           else
                           begin
                             qryMovimentosquantidade.AsCurrency  := fEstoqueBloqueioFuturo {qryProdutosTrocadosfuturo.AsCurrency};
                             qryMovimentosvalor.AsCurrency        := qryCustoProdutocusto.AsCurrency * qryMovimentosquantidade.AsCurrency;
                             qryMovimentostipomovimento.AsString  := 'ARV'
                           end;

                         end
                         else
                         begin
                           {
                           qryMovimentosquantidade.AsCurrency   := qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency;
                           qryMovimentosvalor.AsCurrency       := qryCustoProdutocusto.AsCurrency * qryMovimentosquantidade.AsCurrency;
                           qryMovimentostipomovimento.AsString := 'EFV';
                           }

                            qryprodutosnotaspag.first;
                            while not qryprodutosnotaspag.eof do
                            begin
                              if qrymovimentos.state <> dsinsert then
                                IncluirMovimento;

                              qryMovimentosquantidade.AsCurrency   := qryprodutosnotaspagquantidade.asCurrency {qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency};
                              qryMovimentosvalor.AsCurrency   := qryCustoProdutocusto.AsCurrency * qryMovimentosquantidade.AsCurrency;
                              qryMovimentostipomovimento.AsString := 'EFV';
                              qryMovimentoscodigonota.AsInteger  := qryProdutosNotasPagcodigonota.AsInteger;
                              qrymovimentosnumerocontrole.asinteger := qryprodutosnotaspagnumero.asinteger;
                              qryMovimentosreferencia.AsString := qryMovimentosreferencia.AsString + Ref;
                              QtdeMovto:= QtdeMovto + qryMovimentosquantidade.AsCurrency;
                              qryMovimentos.post;

                              qryprodutosnotaspag.next;

                            end;

                         end;
                       end
                       else
                       begin
                         if qryProdutosTrocadosQuantidade.AsCurrency <= fEstoqueBloqueioFuturo {qryProdutosTrocadosfuturo.AsCurrency} then
                           qryMovimentosquantidade.AsCurrency  := qryProdutosTrocadosQuantidade.AsCurrency
                         else
                           qryMovimentosquantidade.AsCurrency  := fEstoqueBloqueioFuturo {qryProdutosTrocadosfuturo.AsCurrency};

                         qryMovimentostipomovimento.AsString:= 'SQU';
                       end;
                     end
                     else
                     begin
                       if (MovExtra or (qryProdutosTrocadosQuantidade.AsCurrency = qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency)) then
                       begin
                          qryprodutosnotaspag.first;
                          while not qryprodutosnotaspag.eof do
                          begin
                            if qrymovimentos.state <> dsinsert then
                              IncluirMovimento;

                            qryMovimentosquantidade.AsCurrency   := qryprodutosnotaspagquantidade.asCurrency {qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency};
                            qryMovimentosvalor.AsCurrency   := qryCustoProdutocusto.AsCurrency * qryMovimentosquantidade.AsCurrency;
                            qryMovimentostipomovimento.AsString := 'EFV';
                            qryMovimentoscodigonota.AsInteger  := qryProdutosNotasPagcodigonota.AsInteger;
                            qrymovimentosnumerocontrole.asinteger := qryprodutosnotaspagnumero.asinteger;
                            qryMovimentosreferencia.AsString := qryMovimentosreferencia.AsString + Ref;
                            QtdeMovto:= QtdeMovto + qryMovimentosquantidade.AsCurrency;
                            qryMovimentos.post;

                            qryprodutosnotaspag.next;

                          end;

                       end
                       else
                       begin
                        // estava em futuro, foi suprido indo para reserva, devolvou: tira da reserva e adiciona estoque.
                         qryMovimentosquantidade.AsCurrency   := qryProdutosTrocadosQuantidade.AsCurrency - qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency;
                         qryMovimentostipomovimento.AsString := 'TRE'
                       end
                     end;
                  end;
                end
                else
                begin
                  if (qryProdutosTrocadossituacao.AsString = 'F') then
                  begin
                    // * Se qtde em futuro for maior que qtde devolver então a qtde devolver será adicionada no futuro.;
                    // * Se qtde em futuro for menor que qtde devolver então será adicionada no futuro a qtde futura e
                    //   a diferenca sera transferida da reserva para o estoque.
                    if qryProdutosTrocadosQuantidade.AsCurrency <= fEstoqueBloqueioFuturo { qryProdutosTrocadosfuturofilialsaida.AsCurrency} then
                    begin
                       qryMovimentosquantidade.AsCurrency := qryProdutosTrocadosQuantidade.AsCurrency;
                       qryMovimentostipomovimento.AsString := 'SQU';
                    end else begin
                      if MovExtra then begin
                        qryMovimentosquantidade.AsCurrency := fEstoqueBloqueioFuturo {qryProdutosTrocadosfuturofilialsaida.AsCurrency};
                        qryMovimentostipomovimento.AsString := 'SQU'
                      end else begin
                        qryMovimentosquantidade.AsCurrency := qryProdutosTrocadosQuantidade.AsCurrency - fEstoqueBloqueioFuturo {qryProdutosTrocadosfuturofilialsaida.AsCurrency};
                        qryMovimentostipomovimento.AsString := 'TRE';
                      end;
                    end;
                  end;
                end;

                if qrymovimentos.state = dsinsert then
                begin
                  QtdeMovto:= QtdeMovto + qryMovimentosquantidade.AsCurrency;
                  qryMovimentos.Post;
                end;

                MovExtra:= (QtdeMovto < qryProdutosTrocadosQuantidade.AsCurrency);
              end;
            end;
          end;
          qryProdutosTrocados.Next;
        end;
      end;
    finally
      qryProdutosTrocados.EnableControls;
      qryprodutosnotaspag.filtered := false;
      qryProdutosNotasPag.LinkFields := 'codigo=codigonota';
      qryprodutosnotaspag.mastersource := dsrNotasPag;
    end;


end;

procedure TdtmTrocaMercadorias.qryProdutosNotasPagFilterRecord(
  DataSet: TDataSet; var Accept: Boolean);
begin
  inherited;
  Accept := (qryprodutosnotaspagproduto.asString = qryprodutosTrocadosproduto.asstring) and
            (qryProdutosNotasPagcontrato.asString = qryProdutosTrocadoscontrato.asString);
end;

procedure TdtmTrocaMercadorias.DevolverTodosProdutos(Zerar: Boolean);
var
{ Entregar: Currency;}
  RegistroAtual : TBookMark;
begin
  try
    RegistroAtual := qryprodutoscontratosTroca.GetBookmark;
    qryprodutoscontratosTroca.First;
    while not qryprodutoscontratosTroca.Eof do
    begin
      qryprodutoscontratosTroca.Edit;
      if Zerar then
        qryprodutoscontratosTrocadevolver.AsCurrency := 0
      else
        qryprodutoscontratosTrocadevolver.AsCurrency := qryprodutoscontratosTrocaquantidade.AsCurrency - qryprodutoscontratosTrocacancelado.AsCurrency;

      qryprodutoscontratosTroca.Next;
    end;
  finally
    qryprodutoscontratosTroca.GotoBookmark(RegistroAtual);
    qryprodutoscontratosTroca.FreeBookmark(RegistroAtual);
  end;
end;

procedure TdtmTrocaMercadorias.GerarProdutosEntrada(DadoFiscal: integer);

 procedure GuardarProduto;
 begin
//   qryProdutosTrocadoscontrato.AsString := qryProdutosDadosFiscais.Fieldbyname('contrato.AsString;
   qryProdutosTrocadosproduto.AsString  := qryProdutosDadosFiscais.Fieldbyname('produto').AsString;
   qryProdutosTrocadosprodutovisual.AsString := qryProdutosDadosFiscais.Fieldbyname('produtovisual').AsString;
   qryProdutosTrocadosdescricaproduto.AsString := qryProdutosDadosFiscais.Fieldbyname('descricao').AsString;
   qryProdutosTrocadosfilialsaida.AsString := qryProdutosDadosFiscais.Fieldbyname('filial').AsString;
   qryProdutosTrocadosfilial.AsInteger := ifthen(TipoFilial<>'V', FilialBase, qryProdutosDadosFiscais.Fieldbyname('filial').AsInteger);
   qryProdutosTrocadosunidade.AsString := qryProdutosDadosFiscais.Fieldbyname('unidade').AsString;

   qryProdutosTrocadosquantidade.AsCurrency := qryProdutosDadosFiscais.Fieldbyname('quantidade').AsCurrency;
   qryProdutosTrocadosquantidadeoriginal.AsCurrency := qryProdutosDadosFiscais.Fieldbyname('quantidade').AsCurrency;
   qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency := qryProdutosDadosFiscais.Fieldbyname('quantidade').AsCurrency;

   qryProdutosTrocadosprecotabela.AsCurrency := qryProdutosDadosFiscais.Fieldbyname('precotabela').AsCurrency;
   qryProdutosTrocadosprecovenda.AsCurrency := qryProdutosDadosFiscais.Fieldbyname('precovenda').AsCurrency;
   qryProdutosTrocadosdesconto.AsCurrency := qryProdutosDadosFiscais.Fieldbyname('desconto').AsCurrency;
   qryProdutosTrocadosValordescontoItem.AsCurrency := qryProdutosDadosFiscais.Fieldbyname('valordescontoitem').AsCurrency;

   qryProdutosTrocadosprecoavaliado.AsCurrency := qryProdutosDadosFiscais.FieldByName('precovenda').asCurrency -
                                 qryProdutosTrocadosdescontototalunitario.asCurrency;

   qryProdutosTrocadoslinha.AsString := qryProdutosDadosFiscais.Fieldbyname('linha').AsString;
   qryProdutosTrocadoscoluna.AsString := qryProdutosDadosFiscais.Fieldbyname('coluna').AsString;

   qryProdutosTrocadosvalorgrade1.AsString := qryProdutosDadosFiscais.Fieldbyname('valorgrade1').AsString;
   qryProdutosTrocadosvalorgrade2.AsString := qryProdutosDadosFiscais.Fieldbyname('valorgrade2').AsString;
   qryProdutosTrocadosdefeito.AsBoolean := false;

   qryProdutosTrocadosincidencia.AsString := qryProdutosDadosFiscais.Fieldbyname('incidencia').AsString;
   qryProdutosTrocadoscsosn.AsString := qryProdutosDadosFiscais.Fieldbyname('csosn').AsString;

   qryProdutosTrocadospiscst.AsString := qryProdutosDadosFiscais.Fieldbyname('piscst').AsString;
   qryProdutosTrocadoscofinscst.AsString := qryProdutosDadosFiscais.Fieldbyname('cofinscst').AsString;
   qryProdutosTrocadosipicst.AsString := qryProdutosDadosFiscais.Fieldbyname('ipicst').AsString;

   qryProdutosTrocadosaliquotaicms.AsCurrency := qryProdutosDadosFiscais.Fieldbyname('aliquotaicms').AsCurrency;
   qryProdutosTrocadosaliquotaipi.AsCurrency := qryProdutosDadosFiscais.Fieldbyname('aliquotaipi').AsCurrency;
   qryProdutosTrocadospisaliquota.AsCurrency := qryProdutosDadosFiscais.Fieldbyname('pisaliquota').AsCurrency;
   qryProdutosTrocadoscofinsaliquota.AsCurrency := qryProdutosDadosFiscais.Fieldbyname('cofinsaliquota').AsCurrency;
   qryProdutosTrocadosorigem.AsInteger := qryProdutosDadosFiscais.Fieldbyname('origem').Asinteger;
   qryProdutosTrocadosextipi.AsString := qryProdutosDadosFiscais.Fieldbyname('extipi').AsString;
   qryProdutosTrocadosgenero.AsInteger := qryProdutosDadosFiscais.Fieldbyname('genero').Asinteger;
   qryProdutosTrocadosclassificacaofiscal.AsString := qryProdutosDadosFiscais.Fieldbyname('classificacaofiscal').AsString;

//   qryProdutosTrocadoscliente.AsInteger := qryContratosTrocacliente.Asinteger;
//   qryProdutosTrocadostipocliente.AsString := qryContratosTrocatipocliente.AsString;

   qryProdutosTrocadoscliente.AsInteger := dsrContratos.DataSet.FieldByName('cliente').AsInteger;
   qryProdutosTrocadostipocliente.AsString := dsrContratos.DataSet.FieldByName('tipocliente').AsString;

//   qryProdutosTrocadosprimogenito.AsString := qryContratosTrocaprimogenito.AsString;
   qryProdutosTrocadospercreducaobase.AsCurrency := qryProdutosDadosFiscais.Fieldbyname('percentualreducaobase').AsCurrency;
//   if qryContratostrocasituacao.asstring<>'F' then
//     qryProdutosTrocadostodosentregues.AsBoolean := TodosProdutosEntreguesDevolvidos
//   else
//     qryProdutosTrocadostodosentregues.AsBoolean := TodosProdutosDevolvidos;
   qryProdutosTrocadoscaracteristica.AsString := qryProdutosDadosFiscais.Fieldbyname('caracteristica').AsString;

//   qryProdutosTrocadosfuturo.AsCurrency := qryProdutosDadosFiscais.Fieldbyname('futuro').AsCurrency;
//   qryProdutosTrocadosfuturofilialsaida.AsCurrency := qryProdutosDadosFiscais.Fieldbyname('futuro').AsCurrency;

   qryProdutosTrocadossituacao.AsString := '';
   qryProdutosTrocadoscomposto.AsBoolean := qryProdutosDadosFiscais.Fieldbyname('composto').AsBoolean;
{   qryProdutosTrocadosvalorreducaobaseunitaria.AsCurrency := qryProdutosDadosFiscais.Fieldbyname('valorreducaobaseunitaria.AsCurrency;}

   qryProdutosTrocadosicmsmodalidade.AsInteger := qryProdutosDadosFiscais.Fieldbyname('icmsmodalidade').AsInteger;
   qryProdutosTrocadosicmsmodsubst.AsInteger := qryProdutosDadosFiscais.Fieldbyname('icmsmodsubst').AsInteger;

   if qryProdutosDadosFiscais.Fieldbyname('dadofiscal').AsInteger <> 0 then
     qryProdutosTrocadosdadofiscal.asinteger := qryProdutosDadosFiscais.Fieldbyname('dadofiscal').AsInteger;

   if qryProdutosDadosFiscais.Fieldbyname('numero').AsInteger <> 0 then
     qryProdutosTrocadosnumeroprodutotabela.asinteger := qryProdutosDadosFiscais.Fieldbyname('numero').AsInteger;

   if qryProdutosDadosFiscais.Fieldbyname('cupomfiscal').AsInteger <> 0 then
   begin
     qryProdutosTrocadoscupomfiscal.asinteger := qryProdutosDadosFiscais.Fieldbyname('cupomfiscal').AsInteger;
     qryProdutosTrocadoseHCupomFiscal.asBoolean := True;
   end
   else
     qryProdutosTrocadoseHCupomFiscal.asBoolean := false;

   qryProdutosTrocadosmodelodocto.asString := qryProdutosDadosFiscais.Fieldbyname('modelodocto').AsString;

   if qryProdutosDadosFiscais.Fieldbyname('notafiscal').AsInteger <> 0 then
   begin
     qryProdutosTrocadosnotafiscal.asinteger := qryProdutosDadosFiscais.Fieldbyname('notafiscal').AsInteger;
     qryProdutosTrocadoseHNotaFiscal.asBoolean := True;
   end
   else
     qryProdutosTrocadoseHNotaFiscal.asBoolean := false;

   qryProdutosTrocadosvendedor.AsVariant := qryProdutosDadosFiscais.Fieldbyname('vendedor').AsVariant;
   qryProdutosTrocadosvendedordadofiscal.AsVariant := qryProdutosDadosFiscais.Fieldbyname('vendedordadofiscal').AsVariant;

   qryProdutosTrocados.Post;
 end;

begin

  dsrProdutosTrocados.onDataChange := nil;
  RefazConsultaPorNome(qryProdutosDadosFiscais,['dadofiscal'], [DadoFiscal]);

  qryProdutosDadosFiscais.first;
  while not qryProdutosDadosFiscais.eof do
  begin
    qryprodutostrocados.first;
    if qryprodutostrocados.locate('dadofiscal;numeroprodutotabela;produto',
       VarArrayOf([qryProdutosDadosFiscais.Fieldbyname('dadofiscal').AsInteger,
                   qryProdutosDadosFiscais.Fieldbyname('numero').AsInteger,
                   qryProdutosDadosFiscais.Fieldbyname('produto').AsString]),[]) then
      qryProdutosTrocados.edit
     else
      qryProdutosTrocados.append;

    GuardarProduto;
    qryProdutosDadosFiscais.next;
  end;
  
  dsrProdutosTrocados.onDataChange := dsrProdutosTrocadosDataChange;
end;

procedure TdtmTrocaMercadorias.AtribuirCampoVendedor;
begin

  AtribuirDados(TZDataset(dsrProdutosContratos.dataset),[dsrProdutosContratos.dataset.fieldbyname('vendedor')],
                                             [dsrcontratos.dataset.fieldbyname('vendedor').asinteger],
                                             [dsrProdutosContratos.dataset.fieldbyname('vendedor')],
                                             [null],
                                             ['='],
                                             true,
                                             false);
            {
  AtribuirDados(qrynotaspag,[qrynotaspagvendedor],
                           [dsrcontratos.dataset.fieldbyname('vendedor').asinteger],
                           [qrynotaspagvendedor],
                           [null],
                           ['='],
                           true,
                           false);

  AtribuirDados(qryProdutosnotaspag,[qryProdutosnotaspagvendedor],
                           [dsrcontratos.dataset.fieldbyname('vendedor').asinteger],
                           [qryProdutosnotaspagvendedor],
                           [null],
                           ['='],
                           true,
                           false);
                           }

  AtribuirDados(qryProdutosTrocados,[qryProdutosTrocadosvendedor],
                           [dsrcontratos.dataset.fieldbyname('vendedor').asinteger],
                           [qryProdutosTrocadosVendedor],
                           [null],
                           ['='],
                           true,
                           false);

  AtribuirDados(qryProdutosTrocados,[qryProdutosTrocadosvendedordadofiscal],
                           [dsrcontratos.dataset.fieldbyname('vendedor').asinteger],
                           [qryProdutosTrocadosVendedordadofiscal],
                           [null],
                           ['='],
                           true,
                           false);



                         {
    procedure AtribuirDados(ds: TZDataset;
                            Chaves: array of TField;
                            Valores: array of Variant;

                            CamposCondicao: Array of TField;
                            ValoresCamposCondicao: Array of Variant;
                            CondicaoCamposCondicao: Array of String;

                            DesligarControles: Boolean = true;
                            SomenteRegistroAtual: Boolean = false); overload;
                            }

end;

function TdtmTrocaMercadorias.DadosFiscaisok: boolean;
begin
    result :=

       not qryDadosFiscaiscupom.isnull or                   //é cupom

       (qryDadosFiscaiscupom.isnull and
         ((qryDadosFiscaismodelodocto.asString = '55') or
          (qryDadosFiscaismodelodocto.asString = '65'))
         and not qryDadosFiscaisnumprotocolonfe.isnull) or  //não e cupom é nfe e esta ok

       (qryDadosFiscaiscupom.isnull and
        (qryDadosFiscaismodelodocto.asString <> '55') and
        (qryDadosFiscaismodelodocto.asString <> '65')

        );  //não é cupom e não é nfe

end;

function TdtmTrocaMercadorias.DefinirNumeroSerieProdutos: boolean;
begin

  result := true;

  if (qryProdutosSeries.recordcount <> 0) then
  begin
    if not Assigned (frmVisualizarProdutosContratosSeriesaDevolver) then
      frmVisualizarProdutosContratosSeriesaDevolver := TfrmVisualizarProdutosContratosSeriesaDevolver.Create(frmVisualizarProdutosContratosSeriesaDevolver);
    frmVisualizarProdutosContratosSeriesaDevolver.dsrProdutosDevolvidosSeries.dataset := qryProdutosSeries;
    frmVisualizarProdutosContratosSeriesaDevolver.FechamentoSeriesMarcadas := FechamentoSeriesMarcadas;

    frmVisualizarProdutosContratosSeriesaDevolver.ShowModal;

    if frmVisualizarProdutosContratosSeriesaDevolver.ModalResult = mrOk then
      result := true
    else
      result := false;

    frmVisualizarProdutosContratosSeriesaDevolver.Free;
    frmVisualizarProdutosContratosSeriesaDevolver := nil;
  end;

end;

function TdtmTrocaMercadorias.FechamentoSeriesMarcadas: boolean;
var
  vQtItensMarcado,
  vQtItensSemNota,
  vQtItensSemNotaMarcado,
  vQtItensComNota,
  vQtItensComNotaMarcado: Currency;
begin
  result := true;

  vQtItensMarcado := SomarValores(qryProdutosSeries,
                                        [nil],
                                        [qryProdutosSeriesdevolvido],
                                        ['True'], ['=']);

  if vQtItensMarcado <> qryprodutosContratosTrocaDevolver.asCurrency then
  begin
    result := false;
    MensagemAviso('Itens a devolver: ' + floattostr(qryprodutosContratosTrocaDevolver.asCurrency) + chr(13) +
                  'Séries marcadas : ' + floattostr(vQtItensMarcado) + chr(13) +
                  'Marque corretamente os números de séries a serem devolvidas.');
  end;


  if result then
  begin
    vQtItensSemNota := qryprodutosContratosTrocaDevolver.asCurrency - qryprodutosContratosTrocaqtdeentregueparadevolver.asCurrency;
    if vQtItensSemNota <> 0 then
    begin
      vQtItensSemNotaMarcado := SomarValores(qryProdutosSeries,
                                        [nil],
                                        [qryProdutosSeriesdevolvido, qryProdutosSeriesdadofiscal],
                                        ['True', ''], ['=','=']);

      if vQtItensSemNota <> vQtItensSemNotaMarcado then
      begin
        result := false;
        MensagemAviso('Itens a devolver sem NF: ' + floattostr(vQtItensSemNota) + chr(13) +
                      'Séries marcadas : ' + floattostr(vQtItensSemNotaMarcado) + chr(13) +
                      'Marque corretamente os números de séries a serem devolvidas.');
      end;
    end;
  end;

  if result then
  begin
    if qryprodutosContratosTrocaqtdeentregueparadevolver.asCurrency <> 0 then
    begin
      qryDadosFiscais.first;
      while not qryDadosFiscais.eof do
      begin

        vQtItensComNota := qryDadosFiscaisdevolver.asCurrency;
        if vQtItensSemNota <> 0 then
        begin
          vQtItensComNotaMarcado := SomarValores(qryProdutosSeries,
                                            [nil],
                                            [qryProdutosSeriesdevolvido, qryProdutosSeriesdadofiscal],
                                            ['True', qryDadosFiscaisdadofiscal.asString], ['=','=']);

          if vQtItensComNota <> vQtItensComNotaMarcado then
          begin
            result := false;
            MensagemAviso('Itens a devolver na NF/CUPOM ' + qryDadosFiscaisnota.asstring + qryDadosFiscaiscupom.asString+' : ' +  floattostr(vQtItensComNota) + chr(13) +
                          'Séries marcadas : ' + floattostr(vQtItensComNotaMarcado) + chr(13) +
                          'Marque corretamente os números de séries a serem devolvidas.');
          end;
        end;

        qryDadosFiscais.next;

      end;
    end;
  end;

end;

