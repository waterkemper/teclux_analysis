function TdtmTrocaMercadorias.IncluirProdutosaTrocar: Boolean;
begin
  LerProdutosaTrocarIncluidos(True);
  qryProdutosTrocados.Append;
  Result := True
end;

procedure TdtmTrocaMercadorias.LerProdutosaTrocarIncluidos(
  Incluindo: Boolean);
var
  Pos: TBookmark;
  a, Filial: Integer;
  Prod: Int64;
begin
  Pos := qryProdutosTrocados.GetBookmark;
  qryProdutosTrocados.DisableControls;
  try
    a := 0;
    aProdFilial := nil;
    Prod   := qryProdutosTrocadosproduto.AsLargeInt;
    Filial := qryProdutosTrocadosfilial.AsInteger;
    qryProdutosTrocados.First;
    while Not qryProdutosTrocados.Eof do begin
      if Incluindo or ((Prod <> qryProdutosTrocadosproduto.AsLargeInt) or
                       (Filial <> qryProdutosTrocadosfilial.AsInteger))
      then begin
        if qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency = 0 then
        begin
          SetLength(aProdFilial, a + 1);
          aProdFilial[a].Prod   := qryProdutosTrocadosproduto.AsString;
          aProdFilial[a].Filial := qryProdutosTrocadosfilial.AsString;
          Inc(a);
        end;
      end;
      qryProdutosTrocados.Next;
    end;
  finally
    qryProdutosTrocados.GotoBookmark(Pos);
    qryProdutosTrocados.FreeBookmark(Pos);
    qryProdutosTrocados.EnableControls;
  end;
  FiltrarProdutosaTrocar;
end;



function TdtmTrocaMercadorias.EditarProdutosaTrocar: Boolean;
begin
  if qryProdutosTrocados.IsEmpty then begin
    IncluirProdutosaTrocar;
    Result:= True;
  end else
  begin
    if ParSistema.FiliaisIndependentes then begin
      qryProcuraProduto.MacroByName('filialsaida').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
      qryProcuraProduto.ParamByName('FilialPreco').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
    end else begin
      qryProcuraProduto.MacrobyName('filialsaida').AsString := qryProdutosTrocadosfilial.AsString;
      if ParSistema.UtilizarPrecoFilialBase then
        qryProcuraProduto.ParamByName('FilialPreco').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual)
      else
        qryProcuraProduto.ParamByName('FilialPreco').AsString := qryProdutosTrocadosfilial.AsString;

    end;
    if qryProdutosTrocados.RecordCount = 0 then begin
      LerProdutosaTrocarIncluidos(True);
      qryProdutosTrocados.Append;
    end else begin
      LerProdutosaTrocarIncluidos(False);
      qryProdutosTrocados.Edit;
      qryProdutosTrocados.Cancel;
    end;
    Result:= True;
  end;
end;

function TdtmTrocaMercadorias.GetTabelaProdutosaTrocar: TZDataset;
begin
  result := qryProdutosTrocados;
end;

function TdtmTrocaMercadorias.ExcluirProdutoaTrocar: Boolean;
begin
  Result:= False;
  if qryProdutosTrocados.RecordCount > 0 then
  begin
    if MensagemConfirmacao(Format(ctCONFIRMEEXCLUIR, ['o PRODUTO'])) = smbOk then
    begin
      if qryProdutosTrocados.State = dsInsert then
           qryProdutosTrocados.Cancel
      else
      begin
        if not contratoidentificado then
        begin
          qryProdutosTrocados.Delete;
          LerProdutosaTrocarIncluidos(False);
        end
        else
        begin

          if qryProdutosContratosTroca.Locate('contrato;produto;filial',
            VarArrayof([qryProdutosTrocadoscontrato.asstring,
                        qryProdutosTrocadosproduto.asstring,
                        qryProdutosTrocadosfilialsaida.asstring]),[]) then
          begin
            dsrProdutosContratosTroca.onDataChange := nil;
            qryProdutosContratosTroca.Edit;
            qryProdutosContratosTrocadefeito.AsBoolean := false;
            qryProdutosContratosTrocaDevolver.AsCurrency := 0;
            qryProdutosContratosTrocaqtdeentregueparadevolver.AsCurrency := 0;
            if qryprodutoscontratostroca.State in [dsedit, dsinsert] then
              qryProdutosContratosTroca.Post;

            qryProdutosTrocados.Delete;
            LerProdutosaTrocarIncluidos(False);
            dsrProdutosContratosTroca.onDataChange := dsrProdutosContratosTrocaDataChange;

            AtualizaValores;
            AlterarParcelamento;

            ExibirNovosValores(nil);

          end
          else
          if qryContratosDevolvidos.Locate('contrato;produto;filial',
            VarArrayof([qryProdutosTrocadoscontrato.asstring,
                        qryProdutosTrocadosproduto.asstring,
                        qryProdutosTrocadosfilialsaida.asstring]),[]) then
          begin
            if qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency > 0 then
            begin
              qryDadosFiscaisCopia.First;
              while not qryDadosFiscaisCopia.Eof do
              begin
               if (qrydadosfiscaiscopiacontrato.AsString = qryProdutosTrocadoscontrato.asstring) and
                  (qrydadosfiscaiscopiaproduto.AsString = qryProdutosTrocadosproduto.AsString) and
                  (qryDadosFiscaisCopiafilial.AsString = qryProdutosTrocadosfilialsaida.AsString) then
                   qrydadosfiscaiscopia.Delete;
               qrydadosfiscaiscopia.Next;
              end;
              qryProdutosTrocados.Delete;
              qryContratosDevolvidos.Delete;
            end;
          end;

        end;
        CalcularValorTotalProdutosaTrocar;
        qryProdutosTrocados.Edit;
        qryProdutosTrocados.Cancel;
      end;
      Result := True;
    end;
  end;
end;

function TdtmTrocaMercadorias.getEditandoProdutosaTrocar: Boolean;
begin
   Result:= (qryProdutosTrocados.State = dsEdit);
end;

function TdtmTrocaMercadorias.GravarProdutoaTrocar: Boolean;
begin
  if qryProdutosTrocados.CheckRequiredFields then
  begin
    if qryProdutosTrocadosprecoavaliado.AsFloat <= 0 then
    begin
      MensagemAviso(ctPRECOZERO);
      Result := False
    end
    else
    if qryProdutosTrocados.State in [dsInsert,dsEdit] then
    begin
//      qryContratos.Edit;
      qryProdutosTrocados.Post;
      Result := True
    end else
      Result:= False;
  end
  else Result:= False;
end;

procedure TdtmTrocaMercadorias.CalcularValorTotalProdutosaTrocar;
var
  Pos: TBookmark;
  QtdadeTotal,
  Preco,
  Produto, QtdeProdutos: Real;
  cliente: integer;
  tipocliente: String;
begin
  TemProdutoImprimirNotaDevolucao:= False;
  TemProdutoImprimirNotaCompra:= False;
  Pos := qryProdutosTrocados.GetBookmark;
  qryProdutosTrocados.DisableControls;
  Produto := 0;   QtdeProdutos := 0;
  FUnicoCliente := true;
  FUnicoContrato := '';
  cliente := 0;
  tipocliente := '';
  try
    qryProdutosTrocados.First;
    while Not qryProdutosTrocados.Eof do
    begin

      if (qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency > 0) then
      begin
        cliente := qryProdutosTrocadoscliente.AsInteger;
        tipocliente := qryProdutosTrocadostipocliente.AsString;
        if qryProdutosTrocadosprimogenito.AsString<>'' then
          FUnicoContrato := qryProdutosTrocadosprimogenito.AsString
        else
          FUnicoContrato := qryProdutosTrocadoscontrato.AsString
      end;


      Preco    := qryProdutosTrocadosprecoavaliado.AsFloat;
      QtdadeTotal := qryProdutosTrocadosquantidade.AsCurrency;
      Produto := Produto + (QtdadeTotal * Preco);
      QtdeProdutos := QtdeProdutos +  qryProdutosTrocadosquantidade.AsCurrency;
      TemProdutoImprimirNotaDevolucao:= ((qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency > 0) or
                                 TemProdutoImprimirNotaDevolucao);
      TemProdutoImprimirNotaCompra:= ((qryProdutosTrocadossituacao.AsString = '') or
                                 TemProdutoImprimirNotaCompra);
      qryProdutosTrocados.Next;

      if (qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency > 0) then
      begin
        if qryProdutosTrocadosprimogenito.AsString<>'' then
        begin
          if (FUnicoContrato <> qryProdutosTrocadosprimogenito.AsString) and
             (FUnicoContrato<>'') then
            FUnicoContrato := '';
        end
        else
          if (FUnicoContrato <> qryProdutosTrocadoscontrato.AsString) and
             (FUnicoContrato<>'') then
            FUnicoContrato := '';

        if ((cliente <> qryProdutosTrocadoscliente.AsInteger) and
            (tipocliente <> qryProdutosTrocadostipocliente.AsString)) and
            FUnicoCliente then
          FUnicoCliente := false;
      end;
    end;
  finally

    if dsrcontratos.DataSet.State in [dsedit, dsinsert] then
    begin
      if not parsistema.IncluirOrcamentonosItensdaTroca then
      begin
        qryContratostotalprodutoatrocar.AsCurrency := Produto;
        qryContratosTotalQtdeProdutosaTrocar.AsCurrency := QtdeProdutos;
      end
      else
      begin
        qryOrcamentostotalprodutoatrocar.AsCurrency := Produto;
        qryOrcamentosTotalQtdeProdutosaTrocar.AsCurrency := QtdeProdutos;
      end;
    end;

    qryProdutosTrocados.GotoBookmark(Pos);
    qryProdutosTrocados.FreeBookmark(Pos);
    qryProdutosTrocados.EnableControls;
  end
end;

function TdtmTrocaMercadorias.GetTabelaNotasPag: TtecQuery;
begin
  result := qryNotasPag;
end;

procedure TdtmTrocaMercadorias.qryConsultaProdutosAfterOpen(
  DataSet: TDataSet);
begin
  inherited;
  qryConsultaProdutosvalorgrade1.Visible := ParSistema.UsarGradesProdutos;
  qryConsultaProdutosvalorgrade2.Visible := ParSistema.UsarGradesProdutos;
end;

procedure TdtmTrocaMercadorias.SelecionarProdutoaTrocar;
begin
  if qryProdutosTrocados.State = dsbrowse then
    qryProdutosTrocados.Edit;

  if ParSistema.FiliaisIndependentes then
  begin
    qryProcuraProduto.MacroByName('filialsaida').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
    qryProcuraProduto.ParamByName('FilialPreco').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
  end
  else
  begin
    qryProcuraProduto.MacrobyName('filialsaida').AsString := qryConsultaProdutosfilial.AsString;
    if ParSistema.UtilizarPrecoFilialBase then
      qryProcuraProduto.ParamByName('FilialPreco').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual)
    else
      qryProcuraProduto.ParamByName('FilialPreco').AsString := qryConsultaProdutosfilial.AsString;
  end;

  qryProdutosTrocadosfilial.AsInteger       := qryConsultaProdutosfilial.AsInteger;
  qryProdutosTrocadosprodutovisual.AsString := qryConsultaProdutosprodutovisual.AsString;
  qryProdutosTrocadosproduto.AsLargeInt     := qryConsultaProdutosproduto.AsLargeInt;

end;

procedure TdtmTrocaMercadorias.dsrProdutosTrocadosDataChange(
  Sender: TObject; Field: TField);
  const
  SQL = 'and produto = (%d)';
  var Markup: Currency;
begin
  inherited;

  if Field = qryProdutostrocadosproduto then
  begin

    if ParSistema.ConsiderarMarkupClientes then
      Markup := qryProcuraClientemarkup.AsCurrency
    else
      Markup := 0;

    if ParSistema.PrecosporCargo then
    begin
      if qryProdutosTrocadosproduto.AsLargeInt > 0 then
      begin
        qryCargosCliente.MacroByName('Produto').AsString:= Format(SQL,[qryProdutosTrocadosproduto.AsLargeInt]);
        qryCargosCliente.Close;
        qryCargosCliente.Open;
        RefazConsulta(qryCargosCliente,[0],[FCargoCliente]);
        Markup := qryCargosClientemarkup.AsCurrency;
      end
      else
      Markup := 0;
    end;

    qryProdutosTrocadoscaracteristica.AsLargeInt:= qryProcuraProdutocaracteristica.AsLargeInt;
    qryProdutosTrocadosdescricaproduto.AsString := qryProcuraProdutodescricao.AsString;
    qryProdutosTrocadosvalorgrade1.AsString     := qryProcuraProdutovalorgrade1.AsString;
    qryProdutosTrocadosvalorgrade2.AsString     := qryProcuraProdutovalorgrade2.AsString;
    qryProdutosTrocadoslinha.AsString           := qryProcuraProdutolinha.AsString;
    qryProdutosTrocadoscoluna.AsString          := qryProcuraProdutocoluna.AsString;
    qryProdutosTrocadosunidade.AsString         := qryProcuraProdutounidade.AsString;
    qryProdutosTrocadosfilial.AsInteger         := qryProcuraProdutofilial.AsInteger;
//    qryProdutosTrocadosfuturo.AsCurrency        := qryProcuraProdutofuturo.AsCurrency;
//    qryProdutosTrocadosfuturofilialsaida.AsCurrency  := qryProcuraProdutofuturo.AsCurrency;

    if not ContratoIdentificado then
    begin
      qryProdutosTrocadosincidencia.AsString := qryProcuraProdutoincidencia.AsString;
      qryProdutosTrocadoscsosn.AsString := qryProcuraProdutocsosn.AsString;
      qryProdutosTrocadosaliquotaicms.AsFloat := qryProcuraProdutoaliquotaicms.AsFloat;
      qryProdutosTrocadosaliquotaipi.AsCurrency := qryProcuraProdutoaliquotaipi.AsFloat;
      qryProdutosTrocadospisaliquota.AsCurrency := qryProcuraProdutoaliquotapis.AsFloat;
      qryProdutosTrocadoscofinsaliquota.AsCurrency := qryProcuraProdutoaliquotacofins.AsFloat;

      qryProdutosTrocadosorigem.AsInteger := qryProcuraProdutoorigem.AsInteger;
      qryProdutosTrocadospercreducaobase.AsFloat := qryProcuraProdutopercreducaobase.AsFloat;

      qryProdutosTrocadosextipi.AsString := qryProcuraProdutoextipi.AsString;
      qryProdutosTrocadosgenero.AsInteger := qryProcuraProdutogenero.Asinteger;
      qryProdutosTrocadosclassificacaofiscal.AsString := qryProcuraProdutoclassificacaofiscal.AsString;

      qryProdutosTrocadosicmsmodalidade.AsInteger := qryProcuraProdutoicmsmodalidade.AsInteger;
      qryProdutosTrocadosicmsmodsubst.AsInteger := qryProcuraProdutoicmsmodsubst.AsInteger;


    end;

    if ParSistema.UtilizarPrecoFilialBase then
      RefazConsulta(qryProdutoEstoque,[1,2,3,5],[IntToStr(qryProdutosTrocadosproduto.AsLargeInt),
                                                 ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual),
                                                 Markup,
                                                 qryProdutosTrocadosfilial.AsInteger])
    else
      RefazConsulta(qryProdutoEstoque,[1,2,3,5],[IntToStr(qryProdutosTrocadosproduto.AsLargeInt),
                                                 qryProdutosTrocadosfilial.AsInteger,
                                                 Markup,
                                                 qryProdutosTrocadosfilial.AsInteger]);
    qryProdutosTrocadosprecovenda.AsFloat    := qryProdutoEstoquepreco.AsFloat;
    qryProdutosTrocadosprecotabela.AsFloat   := qryProdutoEstoquepreco.AsFloat;
    qryProdutosTrocadosprecoavaliado.AsFloat := qryProdutoEstoquepreco.AsFloat;
  end;
end;

procedure TdtmTrocaMercadorias.qryProdutosTrocadosNewRecord(
  DataSet: TDataSet);
begin
  inherited;
  qryProdutosTrocadosquantidade.AsCurrency := ParSistema.ValordaQuantidade;
  qryProdutosTrocadosdefeito.AsBoolean := false;
  qryProdutosTrocadostipo.AsString := 'E';
  qryProdutosTrocadosusuario.AsInteger := CodigoUsuario;
  qryProdutosTrocadosvendedor.Asvariant := dsrContratos.dataset.fieldbyname('vendedor').AsVariant;
  qryProdutosTrocadosvendedordadofiscal.AsVariant := dsrContratos.dataset.fieldbyname('vendedor').AsVariant;

end;

procedure TdtmTrocaMercadorias.FiltrarProdutosaTrocar;
const
  SQLStr = ' and (%s)';
var
  SQLP: String;
  a: Integer;
begin
  inherited;
  for a := 0 to High(aProdFilial) do begin
    SQLP := SQLP +
    '((p.codigo <> ' + aProdFilial[a].Prod +') or ' +
    '(e.filial <> ' + aProdFilial[a].Filial + ')) and ';
  end;
  if SQLP = '' then begin
    qryProcuraProduto.MacroByName('FiltrarProdutosEFiliaisContratos').AsString       := '';
    qryConsultaProdutos.MAcroByName('FiltrarProdutosaTrocar').AsString  := '';
  end else begin
    Delete(SQLP, Length(SQLP)-4, 5);
    qryProcuraProduto.MacroByName('FiltrarProdutosEFiliaisContratos').AsString      := Format(SQLStr, [SQLP]);
    qryConsultaProdutos.MAcroByName('FiltrarProdutosaTrocar').AsString     := Format(SQLStr, [SQLP]);
  end;

end;

procedure TdtmTrocaMercadorias.qryProdutosTrocadosAfterPost(
  DataSet: TDataSet);
begin
  inherited;
  CalcularValorTotalProdutosaTrocar;
end;

function TdtmTrocaMercadorias.GetProdutosTrocadoscontrato: String;
begin
  result := qryProdutosTrocadoscontrato.AsString;
end;

function TdtmTrocaMercadorias.getIncluindoProdutosaTrocar: Boolean;
begin
   Result:= (qryProdutosTrocados.State = dsInsert);
end;

procedure TdtmTrocaMercadorias.ApagarProdutosTrocados;
begin
 if qryProdutosTrocados.Active then
 begin
   qryProdutosTrocados.First;
   while not qryprodutostrocados.eof do
     qryProdutosTrocados.delete;
 end;
 if qryProdutosContratos.Active then
 begin
   qryProdutosContratos.First;
   while not qryProdutosContratos.eof do
       qryProdutosContratos.delete
 end;
end;

procedure TdtmTrocaMercadorias.qryEstoquesCalcFields(DataSet: TDataSet);
begin
  inherited;
  if  (qryEstoquesemestoque.AsCurrency+
       qryEstoquesreservado.AsCurrency+
       qryEstoquesreservaprevia.AsCurrency+
       qryEstoquestransito.AsCurrency+
       qryEstoquesdemonstracao.AsCurrency+
       qryEstoquesconserto.AsCurrency+
       qryEstoquesdanificada.AsCurrency) = 0  then
     qryEstoquescustomedio.AsCurrency := 0
  else
     qryEstoquescustomedio.AsCurrency :=
      qryEstoquesfinanceiro.AsCurrency /
      (qryEstoquesemestoque.AsCurrency+
       qryEstoquesreservado.AsCurrency+
       qryEstoquesreservaprevia.AsCurrency+
       qryEstoquestransito.AsCurrency+
       qryEstoquesdemonstracao.AsCurrency+
       qryEstoquesconserto.AsCurrency+
       qryEstoquesdanificada.AsCurrency);

   if qryEstoquescustomedio.AsCurrency<>0 then
     qryEstoquescusto.ascurrency := qryEstoquescustomedio.AsCurrency
   else
    if (regimetributario = 1) then //simpes
     qryEstoquescusto.ascurrency := qryEstoquesprecosemicms.AsCurrency
    else
     qryEstoquescusto.ascurrency := qryEstoquesprecocomicms.AsCurrency;

end;

function TdtmTrocaMercadorias.GravarContrato: Boolean;
var
 ValorMensagem : TModalResult;

  Procedure AtribuirNumeroProdutosContratos;
  var
    Cont: Integer;
  begin
    Cont:= 1;
    dsrProdutosContratos.DataSet.First;
    while Not dsrProdutosContratos.DataSet.Eof do begin
      dsrProdutosContratos.DataSet.Edit;
      dsrProdutosContratos.DataSet.FieldByName('numero').AsInteger:= Cont;
      dsrProdutosContratos.DataSet.Post;
      Inc(Cont);
      dsrProdutosContratos.DataSet.Next;
    end;
  end;

  procedure IncluirParcelaContrato;
  begin
    if not assigned(dtmVisualizarSaldoTroca) then
      dtmVisualizarSaldoTroca := TdtmVisualizarSaldoTroca.Create(Self);
    dtmVisualizarSaldoTroca.AbrirDadosCliente(qrycontratoscliente.asinteger,
                                              qrycontratostipocliente.asstring);
    if (qryContratostotalprodutoatrocar.AsCurrency+SaldoCreditoAtual)>=
       qryContratosvalorprazo.AsCurrency then
    begin
      qryParcelas.Insert;
      qryParcelascontrato.AsString             := qryContratosnumero.AsString;
      qryParcelasnumero.AsInteger              := 1;
      qryParcelasdatavencto.AsDateTime         := DataServidor;
      qryParcelasvalorvencto.AsCurrency        := qryContratosvalorprazo.AsCurrency;
      qryParcelasparcelaorigem.AsString        := '1/1';
      qryParcelasparcelaadicional.AsBoolean    := False;
      qryParcelaspagamentoextracaixa.AsBoolean := False;
      qryParcelasformapagamento.AsString:= 'T';
      qryparcelas.Post;
      qryContratoscreditotroca.AsCurrency := qryParcelasvalorvencto.AsCurrency;
   end
   else
   begin
      if (qryContratostotalprodutoatrocar.AsCurrency+SaldoCreditoAtual)<>0 then
      begin
        qryParcelas.Insert;
        qryParcelascontrato.AsString             := qryContratosnumero.AsString;
        qryParcelasnumero.AsInteger              := 1;
        qryParcelasdatavencto.AsDateTime         := DataServidor;
        qryParcelasvalorvencto.AsCurrency        := qryContratostotalprodutoatrocar.AsCurrency+SaldoCreditoAtual;
        qryParcelasparcelaorigem.AsString        := '1/1';
        qryParcelasparcelaadicional.AsBoolean    := False;
        qryParcelaspagamentoextracaixa.AsBoolean := False;
        qryParcelasformapagamento.AsString:= 'T';
        qryparcelas.Post;
        qryContratoscreditotroca.AsCurrency := qryParcelasvalorvencto.AsCurrency;

        qryParcelas.Insert;
        qryParcelascontrato.AsString             := qryContratosnumero.AsString;
        qryParcelasnumero.AsInteger              := 2;
        qryParcelasdatavencto.AsDateTime         := DataServidor;
        qryParcelasvalorvencto.AsCurrency        := qryContratosvalorprazo.AsCurrency -
                                                    (qryContratostotalprodutoatrocar.AsCurrency+
                                                      SaldoCreditoAtual);
        qryParcelasparcelaorigem.AsString        := '1/1';
        qryParcelasparcelaadicional.AsBoolean    := False;
        qryParcelaspagamentoextracaixa.AsBoolean := False;
        qryParcelasformapagamento.AsString:= 'D';
        qryparcelas.Post;
      end
      else
      begin
        qryParcelas.Insert;
        qryParcelascontrato.AsString             := qryContratosnumero.AsString;
        qryParcelasnumero.AsInteger              := 1;
        qryParcelasdatavencto.AsDateTime         := DataServidor;
        qryParcelasvalorvencto.AsCurrency        := qryContratosvalorprazo.AsCurrency;
        qryParcelasparcelaorigem.AsString        := '1/1';
        qryParcelasparcelaadicional.AsBoolean    := False;
        qryParcelaspagamentoextracaixa.AsBoolean := False;
        qryParcelasformapagamento.AsString:= 'D';
        qryparcelas.Post;
      end;
   end;
  end;


  procedure IncluirCreditoTrocanoOrcamento;
  begin
   {
   if not assigned(dtmVisualizarSaldoTroca) then
      dtmVisualizarSaldoTroca := TdtmVisualizarSaldoTroca.Create(Self);
   dtmVisualizarSaldoTroca.AbrirDadosCliente(dsrcontratos.dataset.fieldbyname('cliente').asinteger,
                                              dsrcontratos.dataset.fieldbyname('tipocliente').asstring);
   }

   if (dsrcontratos.dataset.fieldbyname('totalprodutoatrocar').AsCurrency {+ SaldoCreditoAtual}) >= dsrcontratos.dataset.fieldbyname('valorprazo').AsCurrency then
      dsrcontratos.dataset.fieldbyname('creditotroca').AsCurrency := dsrcontratos.dataset.fieldbyname('valorprazo').AsCurrency
   else
   if (dsrcontratos.dataset.fieldbyname('totalprodutoatrocar').AsCurrency {+ SaldoCreditoAtual})<>0 then
      dsrcontratos.dataset.fieldbyname('creditotroca').AsCurrency := dsrcontratos.dataset.fieldbyname('totalprodutoatrocar').AsCurrency {+ SaldoCreditoAtual};
  end;


  procedure GravarContratoTroca;
  begin

    if dsrContratos.DataSet.State = dsInsert then
    begin
      if parsistema.IncluirOrcamentonosItensdaTroca then
      begin
        spcOrcamentoProximo.Open;
        qryOrcamentoscodigo.asinteger := spcOrcamentoProximonumero.asinteger;
        NumeroContratoouOrcamento := qryOrcamentoscodigo.asString;
        spcOrcamentoProximo.Close;
        AtribuirChave(qryProdutosOrcamentos, [qryProdutosOrcamentosorcamento], [qryOrcamentoscodigo]);
        IncluirCreditoTrocanoOrcamento;
      end
      else
      begin
        spcContratosProximo.Open;
        qryContratosnumero.AsString := spcContratosProximonumero.AsString;
        NumeroContratoouOrcamento := qryContratosnumero.AsString;
        spcContratosProximo.Close;
        AtribuirChave(qryProdutosContratos, [qryProdutosContratoscontrato], [qryContratosnumero]);
        IncluirParcelaContrato;

      end;
    end;

    AtribuirNumeroProdutosContratos;

{
    if dsrcontratos.DataSet.State in [dsedit, dsinsert] then
      dsrcontratos.DataSet.Post;
 }
  end;

  function VerificarEquivalenciaProdutosTotal: Boolean;
  var
    caracteristicacontrato : String;
    continuar : Boolean;
//    TotalCaracteristicaContrato, TotalCaracteristicaTrocados: integer;
    RegistroAtual : TBookMark;
  begin
    result := true;
    if ProdutoaTrocarMenorTotalProdutos then
    begin
      MensagemErro(format(ctENTRADACREDITODIFCONTRATO,
                   [qryContratostotalprodutoatrocar.AsCurrency,
                    qryContratostotalprodutos.AsCurrency]));
      result := false;
    end;

    if result then
    begin
      dsrProdutosContratos.DataSet.First;
      while not qryprodutoscontratos.Eof do
      begin
        qryProcuraProduto.MacroByName('FiltrarProdutosEFiliaisContratos').AsString       := '';
        qryProcuraProduto.MacroByName('filialsaida').AsString  := dsrProdutosContratos.DataSet.FieldByName('filial').AsString;

        ReFazConsultapornome(qryProcuraProduto,['estado','filialbase','produtovisual','filialpreco'],[
                      EstadoFilialBase,
                      dsrProdutosContratos.DataSet.FieldByName('filial').AsString,
                      dsrProdutosContratos.DataSet.FieldByName('produto').AsString,
                      dsrProdutosContratos.DataSet.FieldByName('filial').AsString]);

        if qryProcuraProdutoemestoque.AsCurrency <=0 then
        begin
          MensagemErro(format(ctSEMESTOQUESEMVENDA,[
                       dsrProdutosContratos.DataSet.FieldByName('produtovisual').asstring,
                       dsrProdutosContratos.DataSet.FieldByName('filial').asstring]));
             result := false;
             break;
        end;
        dsrProdutosContratos.DataSet.Next;
      end;
    end;

    if result then
      if ProdutoaTrocarMaiorTotalProdutos then
        MensagemAviso(format(ctCLIENTEFICARACOMCREDITO,
                   [(dsrContratos.dataSet.fieldbyname('totalprodutoatrocar').AsCurrency-
                    dsrContratos.dataSet.fieldbyname('totalprodutos').AsCurrency)]));

  end;

  function ValidarProdutosaFaturar: Boolean;
  var
    RegistroAtual : TBookmark;
  begin
    result := true;
    qryprodutoscontratos.First;
    while not qryprodutoscontratos.Eof do
    begin
      if qryProdutosContratosreserva.AsCurrency = 0 then
      begin
        qryProcuraProduto.MacroByName('FiltrarProdutosEFiliaisContratos').AsString       := '';
        qryProcuraProduto.MacroByName('filialsaida').AsString  := qryProdutosContratosfilial.AsString;
        ReFazConsultapornome(qryProcuraProduto,['estado','filialbase','produtovisual','filialpreco'],[
                      EstadoFilialBase,
                      qryProdutosContratosfilial.AsVariant,
                      qryProdutosContratosproduto.AsVariant,
                      qryProdutosContratosfilial.AsVariant]);


        if qryProcuraProdutoemestoque.AsCurrency < qryProdutosContratosquantidade.AsCurrency then
        begin
          if not qryprodutoscontratos.BookmarkValid(RegistroAtual) then
            RegistroAtual := qryProdutosContratos.GetBookmark;

          if ((qryProdutosContratosvendasemestoque.AsString <> 'S') or not parsistema.PermitirVendaSemEstoque) then
          begin
             MensagemAviso(Format(ctSEMESTOQUESEMVENDA, [qryProdutosContratosprodutovisual.AsString, qryProdutosContratosFilial.AsString]));
             Result := False;
             break
          end;
        end;
      end;
      qryProdutosContratos.Next;
    end;

    if result then
      if qryprodutoscontratos.BookmarkValid(RegistroAtual) then
      begin
        qryprodutoscontratos.GotoBookmark(RegistroAtual);
        qryprodutoscontratos.FreeBookmark(RegistroAtual);
        result := PermitirVendaSemEstoque;
      end;
  end;

begin
  result := false;
  FaturarContrato := false;
  NumeroContratoouOrcamento := '';
  result := true;
  if not dsrProdutosContratos.DataSet.IsEmpty then
  begin

    CalcularValorTotalProdutosaTrocar;
      {

      O contrato já esta com o cliente alterado ou não

    if (dsrContratos.DataSet.state in [dsedit, dsinsert]) then
    begin
      if parsistema.IncluirOrcamentonosItensdaTroca then
      begin

        if (qryContratosTrocacliente.AsInteger<>0) and
           (qryContratosTrocatipocliente.AsString<>'') then
        begin
          ReFazConsulta(qryProcuraCliente,[0,1],[qryContratosTrocacliente.AsInteger,qryContratosTrocatipocliente.AsString]);
          qryOrcamentostipocliente.AsString := qryContratosTrocatipocliente.AsString;
          qryOrcamentoscliente.AsInteger := qryContratosTrocacliente.AsInteger;
        end;

      end
      else
      begin

        if (qryContratosTrocacliente.AsInteger<>0) and
           (qryContratosTrocatipocliente.AsString<>'') then
        begin
          ReFazConsulta(qryProcuraCliente,[0,1],[qryContratosTrocacliente.AsInteger,qryContratosTrocatipocliente.AsString]);
          qryContratostipocliente.AsString := qryContratosTrocatipocliente.AsString;
          qryContratoscliente.AsInteger := qryContratosTrocacliente.AsInteger;
        end;

      end;
    end;
    }

    if not ParSistema.IncluirContratoTrocaEquivalente then
    begin
      if ProdutoaTrocarIgualTotalProdutos then {sempre retornando false}
        ValorMensagem := mrNO
      else
      begin
        if parsistema.IncluirOrcamentonosItensdaTroca then
          ValorMensagem := MensagemSimNaoOpcaoCancelar(format(ctORCAMENTOSERAINCLUIDO,[qryOrcamentostotalprodutos.ascurrency]), '')
        else
          ValorMensagem := MensagemSimNaoOpcaoCancelar(format(ctCONTRATOSERAINCLUIDO,[qrycontratostotalprodutos.ascurrency]), ctAVISTAFATURADO);
      end;

      case valorMensagem of
        mrNO: begin
                 NumeroContratoouOrcamento := '';
                 result := VerificarEquivalenciaProdutosTotal;
                 if result then
                   if ProdutoaTrocarIgualTotalProdutos then {sempre retornando false}
                     GravarProdutosTrocados(true)
                   else
                   begin
                     result := ValidarContrato(false);
                     if result then
                       GravarProdutosTrocados(true);
                   end;
               end;
        mrYes: begin
                 result := ValidarContrato(false);
                 if result then
                 begin
                   GravarProdutosTrocados(false);
                   GravarContratoTroca;
                 end;
                end;
        mrOK: begin
                FaturarContrato := true;
                result := ValidarContrato(false);
                if Result then
                begin
                  //result := ValidarProdutosaFaturar;
                  if result then
                  begin
                     GravarProdutosTrocados(false);
                     GravarContratoTroca;
                  end;
                end;
              end;
        mrCancel: result := false;
      end;
    end
    else
    begin
      GravarProdutosTrocados(false); {GRAVA CONTRATO ORÇADO}
      GravarContratoTroca;
    end;
  end
  else
  begin
    NumeroContratoouOrcamento := '';
    GravarProdutosTrocados(false);
  end;
end;

function TdtmTrocaMercadorias.GravarProdutosTrocados(RegistrarSaida:Boolean): Boolean;
var
  DataHora : TDateTime;
begin
  result := true;
  DataHora := now();
  qryProdutosTrocados.First;
  while not qryprodutostrocados.Eof do
  begin
    qryProdutosTrocados.Edit;
    qryProdutosTrocadoscliente.AsInteger := dsrContratos.DataSet.FieldByName('cliente').AsInteger;
    qryProdutosTrocadostipocliente.AsString := dsrContratos.DataSet.FieldByName('tipocliente').AsString;
    qryProdutosTrocadosdata.Asdatetime := DataHora;
    qryProdutosTrocadosvalor.AsCurrency := qryProdutosTrocadosquantidade.AsCurrency * qryProdutosTrocadosprecoavaliado.AsCurrency;
    qryProdutosTrocadosusuarioautorizacao.AsInteger:= CodigoUsuarioAutorizacao;
     if ((not ProdutoaTrocarIgualTotalProdutos) {sempre retornando false}
         or (ProdutoaTrocarIgualTotalProdutos and ParSistema.IncluirContratoTrocaEquivalente)) then
      if qryprodutostrocadosnumero.AsInteger=0 then
      begin
        spcProdutosTrocadosProximo.Open;
        qryProdutosTrocadosnumero.AsInteger := spcProdutosTrocadosProximonumero.AsInteger;
        spcProdutosTrocadosProximo.close;
      end;

    qryprodutostrocados.Next;
  end;

  if qryprodutostrocados.State in [dsedit] then
    qryprodutostrocados.Post;

  if RegistrarSaida then
  begin
    dsrProdutosContratos.DataSet.First;
    while not dsrProdutosContratos.DataSet.Eof do
    begin

      if not ProdutoaTrocarIgualTotalProdutos then {sempre retornando false}
        if dsrProdutosContratos.DataSet.FieldByName('sequenciatroca').AsInteger=0 then
        begin
          spcProdutosTrocadosProximo.Open;
          dsrProdutosContratos.DataSet.Edit;
          dsrProdutosContratos.DataSet.FieldByName('sequenciatroca').AsInteger := spcProdutosTrocadosProximonumero.AsInteger;
          spcProdutosTrocadosProximo.close;
        end;

      qryProdutosTrocadosSaida.append;
      qryProdutosTrocadosSaidaproduto.AsLargeInt := TLargeIntField(dsrProdutosContratos.DataSet.FieldByName('produto')).AsLargeInt;
      qryProdutosTrocadosSaidafilial.AsInteger := dsrProdutosContratos.DataSet.FieldByName('filial').AsInteger;
      qryProdutosTrocadosSaidaquantidade.AsCurrency := dsrProdutosContratos.DataSet.FieldByName('quantidade').AsCurrency;
      qryProdutosTrocadosSaidaprecotabela.AsCurrency := dsrProdutosContratos.DataSet.FieldByName('precotabela').AsCurrency;
      qryProdutosTrocadosSaidaprecoavaliado.AsCurrency := dsrProdutosContratos.DataSet.FieldByName('precovenda').AsCurrency;
      qryProdutosTrocadosSaidaprecovenda.AsCurrency := dsrProdutosContratos.DataSet.FieldByName('precovenda').AsCurrency;
      qryProdutosTrocadosSaidacliente.AsInteger := dsrContratos.DataSet.FieldByName('cliente').AsInteger;
      qryProdutosTrocadosSaidatipocliente.AsString := dsrContratos.DataSet.FieldByName('tipocliente').AsString;
      qryProdutosTrocadosSaidadata.Asdatetime := DataHora;
      qryProdutosTrocadosSaidatipo.AsString := 'S';
      qryProdutosTrocadosSaidavalor.AsCurrency := dsrContratos.DataSet.FieldByName('quantidade').AsCurrency * dsrContratos.DataSet.FieldByName('precovenda').AsCurrency;
      qryProdutosTrocadosSaidanumero.Asinteger := dsrProdutosContratos.DataSet.FieldByName('sequenciatroca').AsInteger;
      qryProdutosTrocadosSaidausuario.AsInteger := CodigoUsuario;
      qryProdutosTrocadosSaidadefeito.AsBoolean := false;
      qryProdutosTrocadosSaidacomposto.AsBoolean := dsrProdutosContratos.DataSet.FieldByName('composto').AsBoolean;
      qryProdutosTrocadosSaida.post;
      dsrProdutosContratos.DataSet.Next;
    end;
  end;
end;

procedure TdtmTrocaMercadorias.SetarProdutoComDefeitoTroca;
 procedure Alterar;
 begin
    qryProdutosTrocados.Edit;
    qryProdutosTrocadosdefeito.AsBoolean := not qryProdutosTrocadosdefeito.AsBoolean;
    qryProdutosTrocados.Post;
 end;
begin
  if contratoidentificado then
  begin
    if (qryProdutosTrocadosqtdeentregueParaDevolver.AsCurrency = 0) then
      MensagemAviso(ctPRODUTOAINDANAOENTREGUE)
    else
     Alterar;
     AtribuirTrocaEfetuada(false);
  end
  else Alterar;
end;

procedure TdtmTrocaMercadorias.qryEstoquesNewRecord(DataSet: TDataSet);
begin
  inherited;
  qryEstoquesreservaprevia.AsCurrency := 0;
end;

(*
