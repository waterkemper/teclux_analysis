function TdtmTrocaMercadorias.GetCondicaoEmissorNFE: Boolean;
begin
  if qryNotasPag.recordcount <> 0 then
    fCondicaoEmissorNFE := parsistema.EmissorNfe and
                           ((qryNotasPagmodelodocto.AsString = '55') or
                            (qryNotasPagmodelodocto.AsString = '57'))
  else
    fCondicaoEmissorNFE := parsistema.EmissorNfe and
                           ((ModeloDoctoFiscal = '55') or
                            (ModeloDoctoFiscal = '57'));

  Result := fCondicaoEmissorNFE;
end;

function TdtmTrocaMercadorias.IncluirOrcamento: Boolean;
begin

  if not qryorcamentos.active then
    qryorcamentos.open;

  if qryorcamentos.state <> dsinsert then
  begin
    qryorcamentos.insert;
    ReFazConsultapornome(qryProdutosOrcamentos, ['orcamento'], [qryorcamentoscodigo.asinteger]);
  end;

  if (qryContratosTrocacliente.AsInteger<>0) and
     (qryContratosTrocatipocliente.AsString<>'') then
  begin
    ReFazConsulta(qryProcuraCliente,[0,1],[qryContratosTrocacliente.AsInteger,qryContratosTrocatipocliente.AsString]);
    qryOrcamentostipocliente.AsString := qryContratosTrocatipocliente.AsString;
    qryOrcamentoscliente.AsInteger := qryContratosTrocacliente.AsInteger;
  end;

  Result := True

end;

procedure TdtmTrocaMercadorias.qryOrcamentosNewRecord(DataSet: TDataSet);
begin
  inherited;
  qryOrcamentosdisponibilizarparavenda.asboolean := true;
  qryOrcamentosfilial.AsInteger := FilialBase;
//  qryOrcamentosnome

  if UsuarioLogin.Vendedor then
  begin
    if FVendedorDefault > 0 then
      qryOrcamentosvendedor.AsInteger  := FVendedorDefault
  end
  else
  if (qryContratosTrocavendedor.AsInteger<>0) then
     qryOrcamentosvendedor.AsInteger := qryContratosTrocavendedor.AsInteger;

  qryOrcamentossituacao.asstring := 'A';
  qryOrcamentosemissao.asDateTime := DataHoraServidor;
  qryOrcamentosvalidade.asDateTime :=  DataServidor + ParSistema.DiasValidadeOrcamento;

  qryOrcamentoscontribicmsemitente.asBoolean := Contribicms;

end;

procedure TdtmTrocaMercadorias.qryOrcamentosvendedorChange(Sender: TField);
begin
  inherited;
  if Not qryOrcamentosvendedor.IsNull then
    VendedorDefault := qryOrcamentosvendedor.AsInteger;
end;

procedure TdtmTrocaMercadorias.qryOrcamentosclienteChange(Sender: TField);
begin
  inherited;
  if qryProcuraCliente.Recordcount > 0 then
  begin
    qryorcamentostipocliente.AsString := qryProcuraClientetipoorig.AsString;
    if qryProcuraClientetipoorig.AsString = 'C' then
      RefazConsulta(qryClientes,[0],[qryProcuraClientecodigo.AsInteger])
    else
      ReFazConsulta(qryFornecedores,[0],[qryProcuraClientecodigo.AsInteger]);
    AtribuirClientenoOrcamento;
  end;
end;

