  DataSet: TDataSet);
begin
  inherited;
  if operacao = 'E' then
    qryProcuraFilialProduto.ParamByName('produto').asstring := ifthen(qryProdutosTrocadosproduto.asstring<>'',qryProdutosTrocadosproduto.asstring,'0')
