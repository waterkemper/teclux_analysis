function TdtmTrocaMercadorias.IncluirProdutosaTrocar: Boolean;
begin
  LerProdutosaTrocarIncluidos(True);
  qryProdutosTrocados.Append;
  Result := True
end;

procedure TdtmTrocaMercadorias.LerProdutosaTrocarIncluidos(
  Incluindo: Boolean);
var
  Pos: TBookmark;
  a, Filial: Integer;
  Prod: Int64;
begin
  Pos := qryProdutosTrocados.GetBookmark;
  qryProdutosTrocados.DisableControls;
  try
    a := 0;
    aProdFilial := nil;
    Prod   := qryProdutosTrocadosproduto.AsLargeInt;
    Filial := qryProdutosTrocadosfilial.AsInteger;
    qryProdutosTrocados.First;
    while Not qryProdutosTrocados.Eof do begin
      if Incluindo or ((Prod <> qryProdutosTrocadosproduto.AsLargeInt) or
                       (Filial <> qryProdutosTrocadosfilial.AsInteger))
      then begin
        if qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency = 0 then
        begin
          SetLength(aProdFilial, a + 1);
          aProdFilial[a].Prod   := qryProdutosTrocadosproduto.AsString;
          aProdFilial[a].Filial := qryProdutosTrocadosfilial.AsString;
          Inc(a);
        end;
      end;
      qryProdutosTrocados.Next;
    end;
  finally
    qryProdutosTrocados.GotoBookmark(Pos);
    qryProdutosTrocados.FreeBookmark(Pos);
    qryProdutosTrocados.EnableControls;
  end;
  FiltrarProdutosaTrocar;
end;



function TdtmTrocaMercadorias.EditarProdutosaTrocar: Boolean;
begin
  if qryProdutosTrocados.IsEmpty then begin
    IncluirProdutosaTrocar;
    Result:= True;
  end else
  begin
    if ParSistema.FiliaisIndependentes then begin
      qryProcuraProduto.MacroByName('filialsaida').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
      qryProcuraProduto.ParamByName('FilialPreco').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
    end else begin
      qryProcuraProduto.MacrobyName('filialsaida').AsString := qryProdutosTrocadosfilial.AsString;
      if ParSistema.UtilizarPrecoFilialBase then
        qryProcuraProduto.ParamByName('FilialPreco').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual)
      else
        qryProcuraProduto.ParamByName('FilialPreco').AsString := qryProdutosTrocadosfilial.AsString;

    end;
    if qryProdutosTrocados.RecordCount = 0 then begin
      LerProdutosaTrocarIncluidos(True);
      qryProdutosTrocados.Append;
    end else begin
      LerProdutosaTrocarIncluidos(False);
      qryProdutosTrocados.Edit;
      qryProdutosTrocados.Cancel;
    end;
    Result:= True;
  end;
end;

function TdtmTrocaMercadorias.GetTabelaProdutosaTrocar: TZDataset;
begin
  result := qryProdutosTrocados;
end;

function TdtmTrocaMercadorias.ExcluirProdutoaTrocar: Boolean;
begin
  Result:= False;
  if qryProdutosTrocados.RecordCount > 0 then begin
    if MensagemConfirmacao(Format(ctCONFIRMEEXCLUIR, ['o PRODUTO'])) = smbOk then begin
      if qryProdutosTrocados.State = dsInsert then
           qryProdutosTrocados.Cancel
      else
      begin
        if not contratoidentificado then
        begin
          qryProdutosTrocados.Delete;
          LerProdutosaTrocarIncluidos(False);
        end
        else
        begin
          if qryProdutosContratosTroca.Locate('contrato;produto;filial',
            VarArrayof([qryProdutosTrocadoscontrato.asstring,
                        qryProdutosTrocadosproduto.asstring,
                        qryProdutosTrocadosfilialsaida.asstring]),[]) then
          begin
            qryProdutosContratosTroca.Edit;
            qryProdutosContratosTrocadefeito.AsBoolean := false;
            qryProdutosContratosTrocaDevolver.AsCurrency := 0;
            qryProdutosContratosTrocaqtdeentregueparadevolver.AsCurrency := 0;
            if qryprodutoscontratostroca.State in [dsedit, dsinsert] then
              qryProdutosContratosTroca.Post;
          end
          else
          if qryContratosDevolvidos.Locate('contrato;produto;filial',
            VarArrayof([qryProdutosTrocadoscontrato.asstring,
                        qryProdutosTrocadosproduto.asstring,
                        qryProdutosTrocadosfilialsaida.asstring]),[]) then
          begin
            if qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency > 0 then
            begin
              qryDadosFiscaisCopia.First;
              while not qryDadosFiscaisCopia.Eof do
              begin
               if (qrydadosfiscaiscopiacontrato.AsString = qryProdutosTrocadoscontrato.asstring) and
                  (qrydadosfiscaiscopiaproduto.AsString = qryProdutosTrocadosproduto.AsString) and
                  (qryDadosFiscaisCopiafilial.AsString = qryProdutosTrocadosfilialsaida.AsString) then
                   qrydadosfiscaiscopia.Delete;
               qrydadosfiscaiscopia.Next;
              end;
              qryProdutosTrocados.Delete;
              qryContratosDevolvidos.Delete;
            end;
          end;
        end;
        CalcularValorTotalProdutosaTrocar;
        qryProdutosTrocados.Edit;
        qryProdutosTrocados.Cancel;
      end;
      Result := True;
    end;
  end;
end;

function TdtmTrocaMercadorias.getEditandoProdutosaTrocar: Boolean;
begin
   Result:= (qryProdutosTrocados.State = dsEdit);
end;

function TdtmTrocaMercadorias.GravarProdutoaTrocar: Boolean;
begin
  if qryProdutosTrocados.CheckRequiredFields then
  begin
    if qryProdutosTrocadosprecoavaliado.AsFloat <= 0 then begin
      MensagemAviso(ctPRECOZERO);
      Result := False
    end else if qryProdutosTrocados.State in [dsInsert,dsEdit] then begin
//      qryContratos.Edit;
      qryProdutosTrocados.Post;
      Result := True
    end else
      Result:= False;
  end
  else Result:= False;
end;

procedure TdtmTrocaMercadorias.CalcularValorTotalProdutosaTrocar;
var
  Pos: TBookmark;
  QtdadeTotal,
  Preco,
  Produto, QtdeProdutos: Real;
  cliente: integer;
  tipocliente: String;
begin
  TemProdutoImprimirNotaDevolucao:= False;
  TemProdutoImprimirNotaCompra:= False;
  Pos := qryProdutosTrocados.GetBookmark;
  qryProdutosTrocados.DisableControls;
  Produto := 0;   QtdeProdutos := 0;
  FUnicoCliente := true;
  FUnicoContrato := '';
  cliente := 0;
  tipocliente := '';
  try
    qryProdutosTrocados.First;
    while Not qryProdutosTrocados.Eof do
    begin
      if (qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency > 0) then
      begin
        cliente := qryProdutosTrocadoscliente.AsInteger;
        tipocliente := qryProdutosTrocadostipocliente.AsString;
        if qryProdutosTrocadosprimogenito.AsString<>'' then
          FUnicoContrato := qryProdutosTrocadosprimogenito.AsString
        else
          FUnicoContrato := qryProdutosTrocadoscontrato.AsString
      end;
      Preco    := qryProdutosTrocadosprecoavaliado.AsFloat;
      QtdadeTotal := qryProdutosTrocadosquantidade.AsCurrency;
      Produto := Produto + (QtdadeTotal * Preco);
      QtdeProdutos := QtdeProdutos +  qryProdutosTrocadosquantidade.AsCurrency;
      TemProdutoImprimirNotaDevolucao:= ((qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency > 0) or
                                 TemProdutoImprimirNotaDevolucao);
      TemProdutoImprimirNotaCompra:= ((qryProdutosTrocadossituacao.AsString = '') or
                                 TemProdutoImprimirNotaCompra);
      qryProdutosTrocados.Next;
      if (qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency > 0) then
      begin
        if qryProdutosTrocadosprimogenito.AsString<>'' then
        begin
          if (FUnicoContrato <> qryProdutosTrocadosprimogenito.AsString) and
             (FUnicoContrato<>'') then
            FUnicoContrato := '';
        end
        else
          if (FUnicoContrato <> qryProdutosTrocadoscontrato.AsString) and
             (FUnicoContrato<>'') then
            FUnicoContrato := '';

        if ((cliente <> qryProdutosTrocadoscliente.AsInteger) and
            (tipocliente <> qryProdutosTrocadostipocliente.AsString)) and
            FUnicoCliente then
          FUnicoCliente := false;
      end;
    end;
  finally
    if qrycontratos.State in [dsedit, dsinsert] then begin
      qryContratostotalprodutoatrocar.AsCurrency := Produto;
      qryContratosTotalQtdeProdutosaTrocar.AsCurrency := QtdeProdutos;
    end;

    qryProdutosTrocados.GotoBookmark(Pos);
    qryProdutosTrocados.FreeBookmark(Pos);
    qryProdutosTrocados.EnableControls;
  end
end;

function TdtmTrocaMercadorias.GetTabelaNotasPag: TtecQuery;
begin
  result := qryNotasPag;
end;

procedure TdtmTrocaMercadorias.qryConsultaProdutosAfterOpen(
  DataSet: TDataSet);
begin
  inherited;
  qryConsultaProdutosvalorgrade1.Visible := ParSistema.UsarGradesProdutos;
  qryConsultaProdutosvalorgrade2.Visible := ParSistema.UsarGradesProdutos;
end;

procedure TdtmTrocaMercadorias.SelecionarProdutoaTrocar;
begin
  if ParSistema.FiliaisIndependentes then
  begin
    qryProcuraProduto.MacroByName('filialsaida').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
    qryProcuraProduto.ParamByName('FilialPreco').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
  end
  else
  begin
    qryProcuraProduto.MacrobyName('filialsaida').AsString := qryConsultaProdutosfilial.AsString;
    if ParSistema.UtilizarPrecoFilialBase then
      qryProcuraProduto.ParamByName('FilialPreco').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual)
    else
      qryProcuraProduto.ParamByName('FilialPreco').AsString := qryConsultaProdutosfilial.AsString;
  end;
  qryProdutosTrocadosproduto.AsLargeInt       := qryConsultaProdutosproduto.AsLargeInt;
  qryProdutosTrocadosfilial.AsInteger         := qryConsultaProdutosfilial.AsInteger;
  if qryProdutosTrocados.State = dsbrowse then
    qryProdutosTrocados.Edit;
end;

procedure TdtmTrocaMercadorias.dsrProdutosTrocadosDataChange(
  Sender: TObject; Field: TField);
  const
  SQL = 'and produto = (%d)';
  var Markup: Currency;
begin
  inherited;
  if ParSistema.ConsiderarMarkupClientes then
    Markup := qryProcuraClientemarkup.AsCurrency
  else
    Markup := 0;

  if ParSistema.PrecosporCargo then
  begin
    if qryProdutosTrocadosproduto.AsLargeInt > 0 then
    begin
      qryCargosCliente.MacroByName('Produto').AsString:= Format(SQL,[qryProdutosTrocadosproduto.AsLargeInt]);
      qryCargosCliente.Close;
      qryCargosCliente.Open;
      RefazConsulta(qryCargosCliente,[0],[FCargoCliente]);
      Markup := qryCargosClientemarkup.AsCurrency;
    end
    else
    Markup := 0;
  end;

  if Field = qryProdutostrocadosproduto then
  begin

    qryProdutosTrocadoscaracteristica.AsLargeInt:= qryProcuraProdutocaracteristica.AsLargeInt;
    qryProdutosTrocadosdescricaproduto.AsString := qryProcuraProdutodescricao.AsString;
    qryProdutosTrocadosvalorgrade1.AsString     := qryProcuraProdutovalorgrade1.AsString;
    qryProdutosTrocadosvalorgrade2.AsString     := qryProcuraProdutovalorgrade2.AsString;
    qryProdutosTrocadoslinha.AsString           := qryProcuraProdutolinha.AsString;
    qryProdutosTrocadoscoluna.AsString          := qryProcuraProdutocoluna.AsString;
    qryProdutosTrocadosunidade.AsString         := qryProcuraProdutounidade.AsString;
    qryProdutosTrocadosfilial.AsInteger         := qryProcuraProdutofilial.AsInteger;
    qryProdutosTrocadosfuturo.AsCurrency        := qryProcuraProdutofuturo.AsCurrency;
    qryProdutosTrocadosfuturofilialsaida.AsCurrency  := qryProcuraProdutofuturo.AsCurrency;

    if not ContratoIdentificado then
    begin
      qryProdutosTrocadosincidencia.AsString := qryProcuraProdutoincidencia.AsString;
      qryProdutosTrocadoscsosn.AsString := qryProcuraProdutocsosn.AsString;
      qryProdutosTrocadosaliquotaicms.AsFloat := qryProcuraProdutoaliquotaicms.AsFloat;
      qryProdutosTrocadosaliquotaipi.AsCurrency := qryProcuraProdutoaliquotaipi.AsFloat;
      qryProdutosTrocadospisaliquota.AsCurrency := qryProcuraProdutoaliquotapis.AsFloat;
      qryProdutosTrocadoscofinsaliquota.AsCurrency := qryProcuraProdutoaliquotacofins.AsFloat;

      qryProdutosTrocadosorigem.AsInteger := qryProcuraProdutoorigem.AsInteger;
      qryProdutosTrocadospercreducaobase.AsFloat := qryProcuraProdutopercreducaobase.AsFloat;

      qryProdutosTrocadosextipi.AsString := qryProcuraProdutoextipi.AsString;
      qryProdutosTrocadosgenero.AsInteger := qryProcuraProdutogenero.Asinteger;
      qryProdutosTrocadosclassificacaofiscal.AsString := qryProcuraProdutoclassificacaofiscal.AsString;

      qryProdutosTrocadosicmsmodalidade.AsInteger := qryProcuraProdutoicmsmodalidade.AsInteger;
      qryProdutosTrocadosicmsmodsubst.AsInteger := qryProcuraProdutoicmsmodsubst.AsInteger;
      

    end;

    if ParSistema.UtilizarPrecoFilialBase then
      RefazConsulta(qryProdutoEstoque,[1,2,3,5],[IntToStr(qryProdutosTrocadosproduto.AsLargeInt),
                                                 ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual),
                                                 Markup,
                                                 qryProdutosTrocadosfilial.AsInteger])
    else
      RefazConsulta(qryProdutoEstoque,[1,2,3,5],[IntToStr(qryProdutosTrocadosproduto.AsLargeInt),
                                                 qryProdutosTrocadosfilial.AsInteger,
                                                 Markup,
                                                 qryProdutosTrocadosfilial.AsInteger]);
    qryProdutosTrocadosprecovenda.AsFloat    := qryProdutoEstoquepreco.AsFloat;
    qryProdutosTrocadosprecotabela.AsFloat   := qryProdutoEstoquepreco.AsFloat;
    qryProdutosTrocadosprecoavaliado.AsFloat := qryProdutoEstoquepreco.AsFloat;
  end;
end;

procedure TdtmTrocaMercadorias.qryProdutosTrocadosNewRecord(
  DataSet: TDataSet);
begin
  inherited;
  qryProdutosTrocadosquantidade.AsCurrency := ParSistema.ValordaQuantidade;
  qryProdutosTrocadostodosentregues.AsBoolean := false;
  qryProdutosTrocadosdefeito.AsBoolean := false;
  qryProdutosTrocadostipo.AsString := 'E';
  qryProdutosTrocadosusuario.AsInteger := CodigoUsuario;
end;

procedure TdtmTrocaMercadorias.FiltrarProdutosaTrocar;
const
  SQLStr = ' and (%s)';
var
  SQLP: String;
  a: Integer;
begin
  inherited;
  for a := 0 to High(aProdFilial) do begin
    SQLP := SQLP +
    '((p.codigo <> ' + aProdFilial[a].Prod +') or ' +
    '(e.filial <> ' + aProdFilial[a].Filial + ')) and ';
  end;
  if SQLP = '' then begin
    qryProcuraProduto.MacroByName('FiltrarProdutosEFiliaisContratos').AsString       := '';
    qryConsultaProdutos.MAcroByName('FiltrarProdutosaTrocar').AsString  := '';
  end else begin
    Delete(SQLP, Length(SQLP)-4, 5);
    qryProcuraProduto.MacroByName('FiltrarProdutosEFiliaisContratos').AsString      := Format(SQLStr, [SQLP]);
    qryConsultaProdutos.MAcroByName('FiltrarProdutosaTrocar').AsString     := Format(SQLStr, [SQLP]);
  end;

end;

procedure TdtmTrocaMercadorias.qryProdutosTrocadosAfterPost(
  DataSet: TDataSet);
begin
  inherited;
  CalcularValorTotalProdutosaTrocar;
end;

function TdtmTrocaMercadorias.GetProdutosTrocadoscontrato: String;
begin
  result := qryProdutosTrocadoscontrato.AsString;
end;

function TdtmTrocaMercadorias.getIncluindoProdutosaTrocar: Boolean;
begin
   Result:= (qryProdutosTrocados.State = dsInsert);
end;

procedure TdtmTrocaMercadorias.qryDadosFiscaisCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  {
  qryDadosFiscaiscontrato.AsString := qryProdutosContratosTrocacontrato.AsString;
  qryDadosFiscaisproduto.AsLargeInt := qryProdutosContratosTrocaproduto.AsLargeInt;
  qryDadosFiscaisfilial.AsInteger := qryProdutosContratosTrocafilial.AsInteger;
  }
end;

procedure TdtmTrocaMercadorias.ApagarProdutosTrocados;
begin
 if qryProdutosTrocados.Active then
 begin
   qryProdutosTrocados.First;
   while not qryprodutostrocados.eof do
     qryProdutosTrocados.delete;
 end;
 if qryProdutosContratos.Active then
 begin
   qryProdutosContratos.First;
   while not qryProdutosContratos.eof do
       qryProdutosContratos.delete
 end;
end;

procedure TdtmTrocaMercadorias.MovimentarProdutos;
var
//  QtdeEntregar,
  SituacaoProduto : TtecComposicao;
  QtdeMovto,
  Custo: Currency;
  Produto: Int64;
  filial,
  I,
  Preco: integer;
{  MovExtra: Boolean;}
  Ref : String;


  procedure InserirProduto;
  begin
    if not qryEstoques.Active then
      qryEstoques.Active:= True;
    qryEstoques.Insert;
    qryEstoquesproduto.AsLargeInt       := Produto;
    qryEstoquesfilial.AsInteger         := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
    qryEstoquesultimaentrada.AsDateTime := DataServidor;
    qryEstoquesemestoque.AsCurrency     := 0;
    qryEstoquesreservado.AsCurrency     := 0;
    qryEstoquestransito.AsCurrency      := 0;
    qryEstoquesdemonstracao.AsCurrency  := 0;
    qryEstoquesconserto.AsCurrency      := 0;
    qryEstoquesfuturo.AsCurrency        := 0;
    qryEstoquesdanificada.AsCurrency    := 0;
    qryEstoquesestoquefisico.AsCurrency := 0;
    qryEstoques.Post;
  end;

  procedure BloquearEstoque;
  var
    WhereSQL,filial: String;
  begin
    qryProdutosTrocados.DisableControls;
    try
      WhereSQL := '';
      qryProdutosTrocados.First;
      while not qryProdutosTrocados.Eof do
      begin
        if ((qryProdutosTrocadossituacao.AsString = 'F') or
                (((qryProdutosTrocadossituacao.AsString = 'N') or
                  (qryProdutosTrocadossituacao.AsString = 'P')) and
                   not TemProdutoImprimirNotaDevolucao) ) then
              filial := qryProdutosTrocadosfilialsaida.AsString
            else
              filial := inttostr(ifthen(TipoFilial<>'V', FilialBase, qryProdutosTrocadosfilialsaida.AsInteger));


        if (qryProdutosTrocadosquantidade.AsCurrency > 0) then
        begin
          WhereSQL := WhereSQL +
          '((e.produto = ' + qryProdutosTrocadosproduto.AsString + ')and' +
          '(e.filial = '   + filial  + '))or';

          if qryProdutosTrocadosfilial.AsString <> qryProdutosTrocadosfilialsaida.AsString then
          begin
            WhereSQL := WhereSQL +
            '((e.produto = ' + qryProdutosTrocadosproduto.AsString + ')and' +
            '(e.filial = '   + filial  + '))or'
          end;
        end;
        qryProdutosTrocados.Next
      end;

      qryProdutosTrocadosSaida.First;
      while not qryProdutosTrocadosSaida.Eof do begin
        if (qryProdutosTrocadosSaidaquantidade.AsCurrency > 0) then begin
          WhereSQL := WhereSQL +
          '((e.produto = ' + qryProdutosTrocadosSaidaproduto.AsString + ')and' +
          '(e.filial = '   + qryProdutosTrocadosSaidafilial.AsString  + '))or';
        end;
        qryProdutosTrocadosSaida.Next
      end;

      Delete(WhereSQL, Length(WhereSQL) - 1, 2);
    finally
      qryProdutosTrocados.EnableControls
    end;
    qryEstoqueBloqueio.Sql[07]:= WhereSQL;
    qryEstoqueBloqueio.Open;
  end;

  function DadosFiscais: String;
  var
    Str: String;
  begin
    Str:= '';
    qryNotasPagDadosFiscais.First;
    While not qryNotasPagDadosFiscais.Eof do begin
      if (qryProdutosTrocadosproduto.AsLargeInt = qryNotasPagDadosFiscaisproduto.AsLargeInt) and
         (qryProdutosTrocadosfilial.AsInteger   = qryNotasPagDadosFiscaisfilial.AsInteger) then
        Str:= Str + IntToStr(qryNotasPagDadosFiscaisdadofiscal.AsInteger) + ',';
      qryNotasPagDadosFiscais.Next;
    end;
    if Str <> '' then begin
      Delete(Str,Length(Str),1);
      Str:= 'and (pd.dadofiscal in (' + Str + '))';
    end;
    Result:= Str;
  end;

  function AtribuirReferencia: String;
  begin

    if (TemProdutoImprimirNotaDevolucao and
       (qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency > 0)) or
       (qryProdutosTrocadossituacao.AsString='') then
    begin
      if qryProdutosNotasPag.Locate('produto',IntToStr(Produto),[]) then
      begin
        if qryNotaspag.Locate('codigo', qryprodutosnotaspagcodigonota.AsInteger,[]) then
          if ClienteTrouxeNota then
            Ref:= ' NFE F' + qryProdutosTrocadoscliente.AsString + ' S'     +
                           qryNotasPagserie.AsString + ' N' +
                           Format('%6.6d',[qryNotasPagNrdocumento.AsInteger])
          Else
            Ref:= ' NFE S' + qryNotasPagserie.AsString + ' N' +
                          Format('%6.6d',[qryNotasPagNrDocumento.AsInteger]);

         result := ref;
//          qryMovimentosreferencia.AsString := qryMovimentosreferencia.AsString + Ref;
      end;
    end;

  end;


  procedure NovoMovimento(Produto: Int64; Filial: Integer);
  begin
    if not qryMovimentos.Active then
      qryMovimentos.Active:= True;
    qryMovimentos.Append;
    spcMovimentosProximo.Open;
    qryMovimentosnumero.AsInteger    := spcMovimentosProximonumero.AsInteger;
    spcMovimentosProximo.Close;
    qryMovimentosproduto.AsLargeInt  := Produto;
    qryMovimentosfilial.AsInteger    := Filial;
    qrymovimentosreferencia.asstring := 'CT ' + qryContratosTrocanumero.AsString + ' TROCADO'+AtribuirReferencia;
    if qryProdutosTrocadosnumero.AsInteger<>0 then
      qryMovimentosnumerotroca.AsInteger := qryProdutosTrocadosnumero.AsInteger;
  end;


begin
  BloquearEstoque;
  qryProdutosTrocados.DisableControls;
  try
    for SituacaoProduto := stNAOCOMPOSTO to stCOMPOSTO do
    begin
      qryProdutosTrocados.First;


      for I:= 1 to qryProdutosTrocados.RecordCount do
      begin

        if FiltrarComposto(qryProdutosTrocadoscomposto.AsBoolean, SituacaoProduto) then
        begin
          Produto := qryProdutosTrocadosproduto.AsLargeInt;

 
          if qryProdutosTrocadosquantidade.AsCurrency > 0 then
          begin

            if ((qryProdutosTrocadossituacao.AsString = 'N') or
                (qryProdutosTrocadossituacao.AsString = 'P')) and
                 TemProdutoImprimirNotaDevolucao then
            begin
              qryCustoProduto.Sql[06]:= DadosFiscais;
              qryCustoProduto.Params[0].AsString := IntToStr(qryProdutosTrocadosproduto.AsLargeInt);
              qryCustoProduto.Params[1].AsInteger:= qryProdutosTrocadosfilialsaida.AsInteger;
              qryCustoProduto.Open;
            end;

            if qryProdutosTrocadosdefeito.AsBoolean then
            begin
              // Se o produto a ser devolvido for com defeito então será inserido um novo produto.
              // Se já existe um produto avariado então será adicionado a esse produto a qtde devolvida.
              ReFazConsulta(qryProdutoExiste,[0,1],[IntToStr(qryProdutosTrocadoscaracteristica.AsLargeInt),
                                                    IntToStr(qryProdutosTrocadosproduto.AsLargeInt)]);
              if qryProdutoExiste.IsEmpty then
              begin
                spcProdutoProximo.Params[0].AsString:= IntToStr(qryProdutosTrocadoscaracteristica.AsLargeInt);
                spcProdutoProximo.Open;
                Produto:= spcProdutoProximocodigo.AsLargeInt;
                spcProdutoProximo.Close;
              end
              else
                Produto:= qryProdutoExistecodigo.AsLargeInt;

              // Se já existe um preco para produtos avariados então este será usado, senão será
              // criado um novo preço com o atributo avariado = true.
              ReFazConsulta(qryPrecoExiste,[0],[IntToStr(qryProdutosTrocadoscaracteristica.AsLargeint)]);
              if qryPrecoExiste.IsEmpty then
              begin
                spcPrecosProximo.Params[0].AsString:= IntToStr(qryProdutosTrocadoscaracteristica.AsLargeInt);
                spcPrecosProximo.Open;
                Preco:= spcPrecosProximocodigo.AsInteger;
                spcPrecosProximo.Close;

                if not qryPrecos.Active then
                  qryPrecos.Active:= True;

                qryPrecos.Insert;
                qryPrecoscaracteristica.AsLargeInt := qryProdutosTrocadoscaracteristica.AsLargeInt;
                qryPrecoscodigo.AsInteger          := Preco;
                qryPrecosdescricao.AsString        := 'DEPRECIADO';
                qryPrecosavariado.AsBoolean        := True;
                qryPrecos.Post;
              end
              else Preco:= qryPrecoExistecodigo.AsInteger;

              if qryProdutoExiste.IsEmpty then
              begin
                // Inserindo o Produto Avariado.
                if not qryProdutos.Active then
                  qryProdutos.Active:= True;
                qryProdutos.Insert;
                qryProdutoscaracteristica.AsLargeInt:= qryProdutosTrocadoscaracteristica.AsLargeInt;
                qryProdutoscodigo.AsLargeInt        := Produto;
                qryProdutosdescricao.AsString       := qryProdutosTrocadosdescricaproduto.AsString + ' - DEPRECIADO';
                qryProdutosvalorgrade1.AsString     := qryProdutosTrocadosvalorgrade1.AsString;
                qryProdutosvalorgrade2.AsString     := qryProdutosTrocadosvalorgrade2.AsString;
                qryProdutospreco.AsInteger          := Preco;
                qryProdutoscodigorecolha.AsLargeInt := qryProdutosTrocadosproduto.AsLargeInt;
                qryProdutos.Post;

                // Inserindo o novo Produto Avariado no Estoque.
                InserirProduto;
                if qryprodutosnotaspag.Active then
                begin
                  if qryProdutosNotasPag.Locate('produto',qryProdutosTrocadosproduto.AsString,[]) then begin
                    qryProdutosNotasPag.Edit;
                    qryProdutosNotasPagproduto.AsLargeInt:= Produto;
                    qryProdutosNotasPag.Post;
                  end;
                end;
              end;
            end
            else
            begin
              ReFazConsulta(qryEstoques,[0,1],[ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual),IntToStr(Produto)]);
              // Se o produto a ser devolvido não esta contido na filial base,
              // então será inserido nesta filial.
              if qryEstoques.IsEmpty then
                InserirProduto;
            end;

            if ((qryProdutosTrocadossituacao.AsString = 'F') or
                (((qryProdutosTrocadossituacao.AsString = 'N') or
                  (qryProdutosTrocadossituacao.AsString = 'P')) and
                   not TemProdutoImprimirNotaDevolucao) ) then
              filial := qryProdutosTrocadosfilialsaida.AsInteger
            else
              filial := ifthen(TipoFilial<>'V', FilialBase, qryProdutosTrocadosfilialsaida.AsInteger);


            if qryProdutosTrocadosdefeito.AsBoolean then
            begin
              if ((qryProdutosTrocadossituacao.AsString = 'N') or
                  (qryProdutosTrocadossituacao.AsString = 'P')) then
              begin
                IncluirMovimento(produto,
                                 filial,
                                 qryProdutosTrocadosnumero.asinteger,
                                 qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency,
                                 'EFV',  //ADICIONA NO ESTOQUE, ADICIONA FINANCEIRO, SUBTRAI VENDA
                                 'CT ' + qryContratosTrocanumero.AsString + ' TROCADO'+AtribuirReferencia,
                                 (qryCustoProdutocusto.AsCurrency * qryMovimentosquantidade.AsCurrency));
                 (*
                {devolvendo produto vendido sem estqoue que esta em futuro}
                if qryProdutosTrocadosquantidade.AsCurrency > qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency then
                begin
                  //verificar FUTURO:  qryProdutosTrocadosquantidade.AsCurrency - qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency
                end;
                *)
              end
              else
              if (qryProdutosTrocadossituacao.AsString = '') then
              begin
                IncluirMovimento(produto,
                                 filial,
                                 qryprodutostrocadosnumero.asinteger,
                                 qryProdutosTrocadosquantidade.AsCurrency,
                                 'EFV', //ADICIONA NO ESTOQUE, ADICIONA FINANCEIRO, SUBTRAI VENDA
                                 AtribuirReferencia,
                                 (qryEstoquescusto.AsCurrency * qryProdutosTrocadosquantidade.AsCurrency))
              end;
            end
            else
            if (qryProdutosTrocadossituacao.AsString='') then
            begin
              if qryEstoquescusto.AsCurrency > 0 then
                Custo := qryEstoquescusto.AsCurrency * qryProdutosTrocadosquantidade.AsCurrency
              else
                Custo := qryEstoquesvalorultimacompra.AsCurrency * qryProdutosTrocadosquantidade.AsCurrency;

              IncluirMovimento(produto,
                               filial,
                               qryprodutostrocadosnumero.asinteger,
                               qryProdutosTrocadosquantidade.AsCurrency,
                               'EFV', //ADICIONA NO ESTOQUE, ADICIONA FINANCEIRO, SUBTRAI VENDA
                               AtribuirReferencia,
                               Custo);

              if qryProdutosTrocadosfuturo.AsCurrency <>0 then
              begin
                if qryProdutosTrocadosquantidade.AsCurrency <= qryProdutosTrocadosfuturo.AsCurrency then
                  IncluirMovimento(produto,
                                   filial,
                                   qryprodutostrocadosnumero.asinteger,
                                   qryProdutosTrocadosquantidade.AsCurrency,
                                   'TFR',   //TRANSFERE FUTURO PARA RESERVA
                                   AtribuirReferencia)
                else
                  IncluirMovimento(produto,
                                   filial,
                                   qryprodutostrocadosnumero.asinteger,
                                   qryProdutosTrocadosfuturo.AsCurrency,
                                   'TFR',  //TRANSFERE FUTURO PARA RESERVA
                                   AtribuirReferencia)
              end;
            end
            else
            if  ((qryProdutosTrocadossituacao.AsString = 'N') or
                 (qryProdutosTrocadossituacao.AsString = 'P')) or

                 (qryProdutosTrocadossituacao.AsString = 'F') then
            begin

              QtdeMovto := qryProdutosTrocadosquantidade.AsCurrency - qryProdutosTrocadosqtdeentregueParaDevolver.AsCurrency;
              // DARA ENTRADA NA FILIAL DE DEVOLUÇAO E NA FILIAL DE SAIDA NO QUE NAO FOI EMITIDO NOTA FISCAL DE SAIDA
              // MOVIMENTANDO A SAIDA DO FUTURO E RESERVA NA FILIAL DE SAIDA

              if QtdeMovto > 0 then
              begin
                if (qryProdutosTrocadosfilialsaida.AsInteger <> qryProdutosTrocadosfilial.AsInteger) then
                begin
                  if (qryProdutosTrocadosfuturofilialsaida.AsCurrency <> 0) then
                  begin
                    NovoMovimento(Produto,qryProdutosTrocadosfilialsaida.AsInteger);
                    if QtdeMovto <= qryProdutosTrocadosfuturofilialsaida.AsCurrency then
                      qryMovimentosquantidade.AsCurrency  := QtdeMovto
                    else
                      qryMovimentosquantidade.AsCurrency  := qryProdutosTrocadosfuturofilialsaida.AsCurrency;
                    qryMovimentostipomovimento.AsString:= 'SQU';  //SUBTRAI QUANTIDADE FUTURA


                    //correto ???
                    if QtdeMovto > qryProdutosTrocadosfuturofilialsaida.AsCurrency then
                    begin
                      NovoMovimento(Produto,qryProdutosTrocadosfilialsaida.AsInteger);
                      qryMovimentosquantidade.AsCurrency  := QtdeMovto - qryProdutosTrocadosfuturofilialsaida.AsCurrency;
                      qryMovimentostipomovimento.AsString := 'TRE'; //TRANSFERE RESERVA PARA ESTOQUE
                    end;
                  end
                  else
                  begin
                    NovoMovimento(Produto,qryProdutosTrocadosfilialsaida.AsInteger);
                    qryMovimentosquantidade.AsCurrency  := QtdeMovto;
                    qryMovimentostipomovimento.AsString := 'TRE'; //TRANSFERE RESERVA PARA ESTOQUE
                  end;
                end
                else
                begin

                  if (qryProdutosTrocadosfuturo.AsCurrency <> 0) then
                  begin
                    NovoMovimento(Produto,filial);
                    if QtdeMovto <= qryProdutosTrocadosfuturo.AsCurrency then
                      qryMovimentosquantidade.AsCurrency  := QtdeMovto
                    else
                      qryMovimentosquantidade.AsCurrency  := qryProdutosTrocadosfuturo.AsCurrency;
                    qryMovimentostipomovimento.AsString:= 'SQU';  //SUBTRAI QUANTIDADE FUTURA

                    //correto ???
                    if QtdeMovto > qryProdutosTrocadosfuturo.AsCurrency then
                    begin
                      NovoMovimento(Produto,filial);
                      qryMovimentosquantidade.AsCurrency  := QtdeMovto - qryProdutosTrocadosfuturo.AsCurrency;
                      qryMovimentostipomovimento.AsString := 'TRE'; //TRANSFERE RESERVA PARA ESTOQUE
                    end;
                  end
                  else
                  begin
                    NovoMovimento(Produto,filial);
                    qryMovimentosquantidade.AsCurrency  := QtdeMovto;
                    qryMovimentostipomovimento.AsString := 'TRE'; //TRANSFERE RESERVA PARA ESTOQUE
                  end;
                end;
              end;


              // DARA ENTRADA NA FILIAL DE DEVOLUÇAO NO QUE FOI EMITIDO NOTA FISCAL DE SAIDA
              if (qryProdutosTrocadossituacao.AsString <> 'F') then //só para garantir
              begin
                if qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency > 0 then
                begin
                  if qryProdutosTrocadosfuturo.AsCurrency > 0 then
                  begin
                    NovoMovimento(Produto,Filial);
                    if qryProdutosTrocadosqtdeentregueParaDevolver.AsCurrency <= qryProdutosTrocadosfuturo.AsCurrency then
                      qryMovimentosquantidade.AsCurrency  := qryProdutosTrocadosqtdeentregueParaDevolver.AsCurrency
                    else
                      qryMovimentosquantidade.AsCurrency := qryProdutosTrocadosfuturo.AsCurrency;
                    qryMovimentosvalor.AsCurrency        := qryCustoProdutocusto.AsCurrency * qryMovimentosquantidade.AsCurrency;
                    qryMovimentostipomovimento.AsString:= 'ARV';  //ADICIONA RESERVA, CUSTO MEDIO FINANCEIRO, SUBTRAI VENDA E FUTURO
                    qryMovimentos.Post;

                    if qryProdutosTrocadosqtdeentregueParaDevolver.AsCurrency > qryProdutosTrocadosfuturo.AsCurrency then
                    begin
                      NovoMovimento(Produto,Filial);
                      qryMovimentosquantidade.AsCurrency  := qryProdutosTrocadosqtdeentregueParaDevolver.AsCurrency - qryProdutosTrocadosfuturo.AsCurrency;
                      qryMovimentosvalor.AsCurrency       := qryCustoProdutocusto.AsCurrency * qryMovimentosquantidade.AsCurrency;
                      qryMovimentostipomovimento.AsString := 'EFV'; //ADICIONA NO ESTOQUE, ADICIONA FINANCEIRO, SUBTRAI VENDA
                      qryMovimentoscodigonota.AsInteger   := qryNotasPagcodigo.AsInteger;
                      qrymovimentos.post;
                    end
                  end
                  else
                  begin
                    NovoMovimento(Produto,Filial);
                    qryMovimentosquantidade.AsCurrency  := qryProdutosTrocadosqtdeentregueParaDevolver.AsCurrency;
                    qryMovimentosvalor.AsCurrency       := qryCustoProdutocusto.AsCurrency * qryMovimentosquantidade.AsCurrency;
                    qryMovimentostipomovimento.AsString := 'EFV'; //ADICIONA NO ESTOQUE, ADICIONA FINANCEIRO, SUBTRAI VENDA
                    qryMovimentoscodigonota.AsInteger   := qryNotasPagcodigo.AsInteger;
                    qrymovimentos.post;
                  end;
                end;
              end;
              (*

              QtdeMovto := 0;
              MovExtra:= False;

              while (QtdeMovto < qryProdutosTrocadosquantidade.AsCurrency) do
              begin

                NovoMovimento(Produto,Filial);
                {
                qrymovimentosreferencia.asstring := 'CT ' + qryContratosTrocanumero.AsString + ' TROCADO'+AtribuirReferencia;
                if qryProdutosTrocadosnumero.AsInteger<>0 then
                  qryMovimentosnumerotroca.AsInteger := qryProdutosTrocadosnumero.AsInteger;
                }

                // Se produto não for devolvido então:
                // * Se qtde em futuro for maior que qtde devolver então a qtde devolver será adicionada na reserva;
                // * Se qtde em futuro for menor que qtde devolver então será adicionada na reserva a qtde futura e
                //   a diferenca sera adicionada no estoque.
                if qryProdutosTrocadosfuturo.AsCurrency > 0 then
                begin

                  if MovExtra then
                  begin
                    if qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency > 0 then
                    begin
                      if qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency <= qryProdutosTrocadosfuturo.AsCurrency then
                      begin
                        qryMovimentosquantidade.AsCurrency  := qryProdutosTrocadosquantidade.AsCurrency - qryProdutosTrocadosqtdeentregueParaDevolver.AsCurrency;
                        qryMovimentostipomovimento.AsString := 'TRE'; //TRANSFERE RESERVA PARA ESTOQUE
                      end
                      else
                      begin
                        if QtdeMovto = qryProdutosTrocadosfuturo.AsCurrency then
                        begin
                          qryMovimentosquantidade.AsCurrency  := qryProdutosTrocadosqtdeentregueParaDevolver.AsCurrency - qryProdutosTrocadosfuturo.AsCurrency;
                          qryMovimentosvalor.AsCurrency       := qryCustoProdutocusto.AsCurrency * qryMovimentosquantidade.AsCurrency;
                          qryMovimentostipomovimento.AsString := 'EFV'; //ADICIONA NO ESTOQUE, ADICIONA FINANCEIRO, SUBTRAI VENDA
                          qryMovimentoscodigonota.AsInteger   := qryNotasPagcodigo.AsInteger;
                        end
                        else
                        begin
                          qryMovimentosquantidade.AsCurrency  := qryProdutosTrocadosquantidade.AsCurrency - qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency;
                          qryMovimentostipomovimento.AsString := 'TRE';  //TRANSFERE RESERVA PARA ESTOQUE
                        end;
                      end;
                    end
                    else
                    begin
                      qryMovimentosquantidade.AsCurrency  := qryProdutosTrocadosquantidade.AsCurrency - qryProdutosTrocadosfuturo.AsCurrency;
                      qryMovimentostipomovimento.AsString := 'TRE'; //TRANSFERE RESERVA PARA ESTOQUE
                    end;
                  end
                  else
                    if qryProdutosTrocadosqtdeentregueParaDevolver.AsCurrency > 0 then
                    begin
                      if qryProdutosTrocadosqtdeentregueParaDevolver.AsCurrency <= qryProdutosTrocadosfuturo.AsCurrency then
                        qryMovimentosquantidade.AsCurrency  := qryProdutosTrocadosqtdeentregueParaDevolver.AsCurrency
                      else
                        qryMovimentosquantidade.AsCurrency := qryProdutosTrocadosfuturo.AsCurrency;
                      qryMovimentosvalor.AsCurrency        := qryCustoProdutocusto.AsCurrency * qryMovimentosquantidade.AsCurrency;
                      qryMovimentostipomovimento.AsString:= 'ARV';  //ADICIONA RESERVA, CUSTO MEDIO FINANCEIRO, SUBTRAI VENDA E FUTURO
                    end
                    else
                    begin
                      if qryProdutosTrocadosquantidade.AsCurrency <= qryProdutosTrocadosfuturo.AsCurrency then
                        qryMovimentosquantidade.AsCurrency  := qryProdutosTrocadosquantidade.AsCurrency
                      else
                        qryMovimentosquantidade.AsCurrency  := qryProdutosTrocadosfuturo.AsCurrency;
                      qryMovimentostipomovimento.AsString:= 'SQU';  //SUBTRAI QUANTIDADE FUTURA
                    end;
                end
                else
                begin
                  if (MovExtra or (qryProdutosTrocadosquantidade.AsCurrency = qryProdutosTrocadosqtdeentregueParaDevolver.AsCurrency)) then
                  begin
                     qryMovimentosquantidade.AsCurrency   := qryProdutosTrocadosqtdeentregueParaDevolver.AsCurrency;
                     qryMovimentosvalor.AsCurrency   := qryCustoProdutocusto.AsCurrency * qryMovimentosquantidade.AsCurrency;
                     qryMovimentostipomovimento.AsString := 'EFV'; //ADICIONA NO ESTOQUE, ADICIONA FINANCEIRO, SUBTRAI VENDA
                     qryMovimentoscodigonota.AsInteger  := qryNotasPagcodigo.AsInteger;
                  end
                  else
                  begin
                    if qryProdutosTrocadosqtdeentregueParaDevolver.AsCurrency <> 0 then
                    begin

                    end;

                    tem futuro filial saida
                    qryProdutosTrocadosquantidade.AsCurrency - qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency



                    qryMovimentosquantidade.AsCurrency  := qryProdutosTrocadosquantidade.AsCurrency - qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency;
                    qryMovimentostipomovimento.AsString := 'TRE'; //TRANSFERE RESERVA PARA ESTOQUE
                  end;
                end;
                QtdeMovto := QtdeMovto + qryMovimentosquantidade.AsCurrency;
                qryMovimentos.Post;

                MovExtra:= (QtdeMovto < qryProdutosTrocadosquantidade.AsCurrency);
              end;

            end

            else
            begin
              if (qryContratosTrocasituacao.AsString = 'F') then
              begin
                QtdeMovto := 0;
                MovExtra:= False;
                while (QtdeMovto < qryProdutosTrocadosquantidade.AsCurrency) do
                begin



                  NovoMovimento(Produto,Filial);
                  {
                  qrymovimentosreferencia.asstring := 'CT ' + qryContratosTrocanumero.AsString + ' TROCADO'+AtribuirReferencia;
                  if qryProdutosTrocadosnumero.AsInteger<>0 then
                    qryMovimentosnumerotroca.AsInteger := qryProdutosTrocadosnumero.AsInteger;
                  }
                  // * Se qtde em futuro for maior que qtde devolver então a qtde devolver será SUBTRAIDA no futuro.;
                  // * Se qtde em futuro for menor que qtde devolver então será adicionada no futuro a qtde futura e
                  //   a diferenca sera transferida da reserva para o estoque.
                  if qryProdutosTrocadosquantidade.AsCurrency <= qryProdutosTrocadosfuturo.AsCurrency then
                  begin
                     qryMovimentosquantidade.AsCurrency := qryProdutosTrocadosquantidade.AsCurrency;
                     qryMovimentostipomovimento.AsString := 'SQU';
                  end
                  else
                  begin
                    if MovExtra then
                    begin
                      qryMovimentosquantidade.AsCurrency  := qryProdutosTrocadosfuturo.AsCurrency;
                      qryMovimentostipomovimento.AsString := 'SQU'
                    end
                    else
                    begin
                      qryMovimentosquantidade.AsCurrency  := qryProdutosTrocadosquantidade.AsCurrency - qryProdutosTrocadosfuturo.AsCurrency;
                      qryMovimentostipomovimento.AsString := 'TRE';
                    end;
                  end;
                  QtdeMovto:= QtdeMovto + qryMovimentosquantidade.AsCurrency;
                  qryMovimentos.Post;
                  MovExtra:= (QtdeMovto < qryProdutosTrocadosquantidade.AsCurrency);

                end;
              end;
              *)
            end;
          end;
        end;
        qryProdutosTrocados.Next;
      end;

    end;

    for SituacaoProduto := stNAOCOMPOSTO to stCOMPOSTO do
    begin
      qryProdutosTrocadosSaida.First;
      for I:= 1 to qryProdutosTrocadosSaida.RecordCount do
      begin
        if FiltrarComposto(qryProdutosTrocadosSaidacomposto.asboolean, SituacaoProduto) then
          IncluirMovimento(qryProdutosTrocadosSaidaproduto.AsLargeInt,
                           qryProdutosTrocadosSaidafilial.AsInteger,
                           qryprodutostrocadosSaidanumero.asinteger,
                           qryprodutostrocadosSaidaquantidade.AsCurrency,
                           'TET',
                           'SAIDA TROCA');
        qryProdutosTrocadosSaida.Next;
      end;
    end;

  finally
    qryProdutosTrocados.EnableControls;
  end;

end;

procedure TdtmTrocaMercadorias.qryEstoquesCalcFields(DataSet: TDataSet);
begin
  inherited;
  if  (qryEstoquesemestoque.AsCurrency+
       qryEstoquesreservado.AsCurrency+
       qryEstoquesreservaprevia.AsCurrency+
       qryEstoquestransito.AsCurrency+
       qryEstoquesdemonstracao.AsCurrency+
       qryEstoquesconserto.AsCurrency+
       qryEstoquesdanificada.AsCurrency) = 0  then
     qryEstoquescustomedio.AsCurrency := 0
  else
     qryEstoquescustomedio.AsCurrency :=
      qryEstoquesfinanceiro.AsCurrency /
      (qryEstoquesemestoque.AsCurrency+
       qryEstoquesreservado.AsCurrency+
       qryEstoquesreservaprevia.AsCurrency+
       qryEstoquestransito.AsCurrency+
       qryEstoquesdemonstracao.AsCurrency+
       qryEstoquesconserto.AsCurrency+
       qryEstoquesdanificada.AsCurrency);

   if qryEstoquescustomedio.AsCurrency<>0 then
     qryEstoquescusto.ascurrency := qryEstoquescustomedio.AsCurrency
   else
    if (regimetributario = 1) then //simpes
     qryEstoquescusto.ascurrency := qryEstoquesprecosemicms.AsCurrency
    else
     qryEstoquescusto.ascurrency := qryEstoquesprecocomicms.AsCurrency;

end;

function TdtmTrocaMercadorias.GravarContrato: Boolean;
var
 ValorMensagem : TModalResult;

  Procedure AtribuirNumeroProdutosContratos;
  var
    Cont: Integer;
  begin
    Cont:= 1;
    qryProdutosContratos.First;
    while Not qryProdutosContratos.Eof do begin
      qryProdutosContratos.Edit;
      qryProdutosContratosnumero.AsInteger:= Cont;
      qryProdutosContratos.Post;
      Inc(Cont);
      qryProdutosContratos.Next;
    end;
  end;

  procedure IncluirParcelaContrato;
  begin
    if not assigned(dtmVisualizarSaldoTroca) then
      dtmVisualizarSaldoTroca := TdtmVisualizarSaldoTroca.Create(Self);
    dtmVisualizarSaldoTroca.AbrirDadosCliente(qrycontratoscliente.asinteger,
                                              qrycontratostipocliente.asstring);
    if (qryContratostotalprodutoatrocar.AsCurrency+SaldoCreditoAtual)>=
       qryContratosvalorprazo.AsCurrency then
    begin
      qryParcelas.Insert;
      qryParcelascontrato.AsString             := qryContratosnumero.AsString;
      qryParcelasnumero.AsInteger              := 1;
      qryParcelasdatavencto.AsDateTime         := DataServidor;
      qryParcelasvalorvencto.AsCurrency        := qryContratosvalorprazo.AsCurrency;
      qryParcelasparcelaorigem.AsString        := '1/1';
      qryParcelasparcelaadicional.AsBoolean    := False;
      qryParcelaspagamentoextracaixa.AsBoolean := False;
      qryParcelasformapagamento.AsString:= 'T';
      qryparcelas.Post;
      qryContratoscreditotroca.AsCurrency := qryParcelasvalorvencto.AsCurrency;
   end
   else
   begin
      if (qryContratostotalprodutoatrocar.AsCurrency+SaldoCreditoAtual)<>0 then
      begin
        qryParcelas.Insert;
        qryParcelascontrato.AsString             := qryContratosnumero.AsString;
        qryParcelasnumero.AsInteger              := 1;
        qryParcelasdatavencto.AsDateTime         := DataServidor;
        qryParcelasvalorvencto.AsCurrency        := qryContratostotalprodutoatrocar.AsCurrency+SaldoCreditoAtual;
        qryParcelasparcelaorigem.AsString        := '1/1';
        qryParcelasparcelaadicional.AsBoolean    := False;
        qryParcelaspagamentoextracaixa.AsBoolean := False;
        qryParcelasformapagamento.AsString:= 'T';
        qryparcelas.Post;
        qryContratoscreditotroca.AsCurrency := qryParcelasvalorvencto.AsCurrency;

        qryParcelas.Insert;
        qryParcelascontrato.AsString             := qryContratosnumero.AsString;
        qryParcelasnumero.AsInteger              := 2;
        qryParcelasdatavencto.AsDateTime         := DataServidor;
        qryParcelasvalorvencto.AsCurrency        := qryContratosvalorprazo.AsCurrency -
                                                    (qryContratostotalprodutoatrocar.AsCurrency+
                                                      SaldoCreditoAtual);
        qryParcelasparcelaorigem.AsString        := '1/1';
        qryParcelasparcelaadicional.AsBoolean    := False;
        qryParcelaspagamentoextracaixa.AsBoolean := False;
        qryParcelasformapagamento.AsString:= 'D';
        qryparcelas.Post;
      end
      else
      begin
        qryParcelas.Insert;
        qryParcelascontrato.AsString             := qryContratosnumero.AsString;
        qryParcelasnumero.AsInteger              := 1;
        qryParcelasdatavencto.AsDateTime         := DataServidor;
        qryParcelasvalorvencto.AsCurrency        := qryContratosvalorprazo.AsCurrency;
        qryParcelasparcelaorigem.AsString        := '1/1';
        qryParcelasparcelaadicional.AsBoolean    := False;
        qryParcelaspagamentoextracaixa.AsBoolean := False;
        qryParcelasformapagamento.AsString:= 'D';
        qryparcelas.Post;
      end;
   end;
  end;

  procedure GravarContratoTroca;
  begin

    if qryContratos.State = dsInsert then
    begin
      spcContratosProximo.Open;
      qryContratosnumero.AsString := spcContratosProximonumero.AsString;
      NumeroContrato := qryContratosnumero.AsString;
      spcContratosProximo.Close;
    end;

    qryProdutosContratos.First;
    while Not qryProdutosContratos.Eof do
    begin
      if qryProdutosContratoscontrato.AsString = '' then
      begin
        qryProdutosContratos.Edit;
        qryProdutosContratoscontrato.AsString := qryContratosnumero.AsString;
        qryProdutosContratos.Post;
      end;
      qryProdutosContratos.Next;
    end;

    IncluirParcelaContrato;
    AtribuirNumeroProdutosContratos;

    if qrycontratos.State in [dsedit, dsinsert] then
      qrycontratos.Post;
  end;

  function VerificarEquivalenciaProdutosTotal: Boolean;
  var
    caracteristicacontrato : String;
    continuar : Boolean;
//    TotalCaracteristicaContrato, TotalCaracteristicaTrocados: integer;
    RegistroAtual : TBookMark;
  begin
    result := true;
    if ProdutoaTrocarMenorTotalProdutos then
    begin
      MensagemErro(format(ctENTRADACREDITODIFCONTRATO,
                   [qryContratostotalprodutoatrocar.AsCurrency,
                    qryContratostotalprodutos.AsCurrency]));
      result := false;
    end;

    if result then
    begin
      qryProdutosContratos.First;
      while not qryprodutoscontratos.Eof do
      begin
        qryProcuraProduto.MacroByName('FiltrarProdutosEFiliaisContratos').AsString       := '';
        qryProcuraProduto.MacroByName('filialsaida').AsString  := qryProdutosContratosfilial.AsString;
        ReFazConsultapornome(qryProcuraProduto,['estado','filialbase','produto','filialpreco'],[
                      EstadoFilialBase,
                      qryProdutosContratosfilial.AsVariant,
                      qryProdutosContratosproduto.AsVariant,
                      qryProdutosContratosfilial.AsVariant]);
        if qryProcuraProdutoemestoque.AsCurrency <=0 then
        begin
          MensagemErro(format(ctSEMESTOQUESEMVENDA,[
                       qryprodutoscontratosproduto.asstring,
                       qryprodutoscontratosfilial.asstring]));
             result := false;
             break;
        end;
        qryprodutoscontratos.Next;
      end;
    end;

    if result then
      if ProdutoaTrocarMaiorTotalProdutos then
        MensagemAviso(format(ctCLIENTEFICARACOMCREDITO,
                   [(qryContratostotalprodutoatrocar.AsCurrency-
                    qryContratostotalprodutos.AsCurrency)]));

  end;

  function ValidarProdutosaFaturar: Boolean;
  var
    RegistroAtual : TBookmark;
  begin
    result := true;
    qryprodutoscontratos.First;
    while not qryprodutoscontratos.Eof do
    begin
      if qryProdutosContratosreserva.AsCurrency = 0 then
      begin
        qryProcuraProduto.MacroByName('FiltrarProdutosEFiliaisContratos').AsString       := '';
        qryProcuraProduto.MacroByName('filialsaida').AsString  := qryProdutosContratosfilial.AsString;
        ReFazConsultapornome(qryProcuraProduto,['estado','filialbase','produto','filialpreco'],[
                      EstadoFilialBase,
                      qryProdutosContratosfilial.AsVariant,
                      qryProdutosContratosproduto.AsVariant,
                      qryProdutosContratosfilial.AsVariant]);


        if qryProcuraProdutoemestoque.AsCurrency < qryProdutosContratosquantidade.AsCurrency then
        begin
          if not qryprodutoscontratos.BookmarkValid(RegistroAtual) then
            RegistroAtual := qryProdutosContratos.GetBookmark;
          if qryProdutosContratosvendasemestoque.AsString <> 'S' then
          begin
             MensagemAviso(Format(ctSEMESTOQUESEMVENDA, [qryprodutoscontratosproduto.AsString, qryProdutosContratosFilial.AsString]));
             Result := False;
             break
          end;
        end;
      end;
      qryProdutosContratos.Next;
    end;

    if result then
      if qryprodutoscontratos.BookmarkValid(RegistroAtual) then
      begin
        qryprodutoscontratos.GotoBookmark(RegistroAtual);
        qryprodutoscontratos.FreeBookmark(RegistroAtual);
        result := PermitirVendaSemEstoque;
      end;
  end;

begin
  result := false;
  FaturarContrato := false;
  NumeroContrato := '';
  result := true;
  if not qryProdutosContratos.IsEmpty then
  begin
    if not ParSistema.IncluirContratoTrocaEquivalente then
    begin
      if ProdutoaTrocarIgualTotalProdutos then
        ValorMensagem := mrNO
      else
        ValorMensagem := MensagemSimNaoOpcaoCancelar(format(ctCONTRATOSERAINCLUIDO,[qrycontratostotalprodutos.ascurrency]), ctAVISTAFATURADO);
      case valorMensagem of
        mrNO: begin
                 NumeroContrato := '';
                 result := VerificarEquivalenciaProdutosTotal;
                 if result then
                   if ProdutoaTrocarIgualTotalProdutos then
                     GravarProdutosTrocados(true)
                   else
                   begin
                     result := ValidarContrato(false);
                     if result then
                       GravarProdutosTrocados(true);
                   end;
               end;
        mrYes: begin
                 result := ValidarContrato(false);
                 if result then
                 begin
                   GravarProdutosTrocados(false);
                   GravarContratoTroca;
                 end;
                end;
        mrOK: begin
                FaturarContrato := true;
                result := ValidarContrato(false);
                if Result then
                begin
                  //result := ValidarProdutosaFaturar;
                  if result then
                  begin
                     GravarProdutosTrocados(false);
                     GravarContratoTroca;
                  end;
                end;
              end;
        mrCancel: result := false;
      end;
    end
    else
    begin
      GravarProdutosTrocados(false); {GRAVA CONTRATO ORÇADO}
      GravarContratoTroca;
    end;
  end
  else
  begin
    NumeroContrato := '';
    GravarProdutosTrocados(false);
  end;
end;

function TdtmTrocaMercadorias.GravarProdutosTrocados(RegistrarSaida:Boolean): Boolean;
var
  DataHora : TDateTime;
begin
  result := true;
  DataHora := now();
  qryProdutosTrocados.First;
  while not qryprodutostrocados.Eof do
  begin
    qryProdutosTrocados.Edit;
    qryProdutosTrocadoscliente.AsInteger := qryContratoscliente.AsInteger;
    qryProdutosTrocadostipocliente.AsString := qryContratostipocliente.AsString;
    qryProdutosTrocadosdata.Asdatetime := DataHora;
    qryProdutosTrocadosvalor.AsCurrency := qryProdutosTrocadosquantidade.AsCurrency * qryProdutosTrocadosprecoavaliado.AsCurrency;
    qryProdutosTrocadosusuarioautorizacao.AsInteger:= CodigoUsuarioAutorizacao;
     if ((not ProdutoaTrocarIgualTotalProdutos)
         or (ProdutoaTrocarIgualTotalProdutos and ParSistema.IncluirContratoTrocaEquivalente)) then
      if qryprodutostrocadosnumero.AsInteger=0 then
      begin
        spcProdutosTrocadosProximo.Open;
        qryProdutosTrocadosnumero.AsInteger := spcProdutosTrocadosProximonumero.AsInteger;
        spcProdutosTrocadosProximo.close;
      end;

    qryprodutostrocados.Next;
  end;
  if qryprodutostrocados.State in [dsedit] then
    qryprodutostrocados.Post;

  if RegistrarSaida then
  begin
    qryProdutosContratos.First;
    while not qryprodutoscontratos.Eof do
    begin
      if not ProdutoaTrocarIgualTotalProdutos then
        if qryProdutosContratossequenciatroca.AsInteger=0 then
        begin
          spcProdutosTrocadosProximo.Open;
          qryprodutoscontratos.Edit;
          qryProdutosContratossequenciatroca.AsInteger := spcProdutosTrocadosProximonumero.AsInteger;
          spcProdutosTrocadosProximo.close;
        end;

      qryProdutosTrocadosSaida.append;
      qryProdutosTrocadosSaidaproduto.AsLargeInt := qryprodutoscontratosproduto.AsLargeInt;
      qryProdutosTrocadosSaidafilial.AsInteger := qryProdutosContratosfilial.AsInteger;
      qryProdutosTrocadosSaidaquantidade.AsCurrency := qryProdutosContratosquantidade.AsCurrency;
      qryProdutosTrocadosSaidaprecotabela.AsCurrency := qryProdutosContratosprecotabela.AsCurrency;
      qryProdutosTrocadosSaidaprecoavaliado.AsCurrency := qryProdutosContratosprecovenda.AsCurrency;
      qryProdutosTrocadosSaidaprecovenda.AsCurrency := qryProdutosContratosprecovenda.AsCurrency;
      qryProdutosTrocadosSaidacliente.AsInteger := qryContratoscliente.AsInteger;
      qryProdutosTrocadosSaidatipocliente.AsString := qryContratostipocliente.AsString;
      qryProdutosTrocadosSaidadata.Asdatetime := DataHora;
      qryProdutosTrocadosSaidatipo.AsString := 'S';
      qryProdutosTrocadosSaidavalor.AsCurrency := qryProdutosContratosquantidade.AsCurrency * qryProdutosContratosprecovenda.AsCurrency;
      qryProdutosTrocadosSaidanumero.Asinteger := qryProdutosContratossequenciatroca.AsInteger;
      qryProdutosTrocadosSaidausuario.AsInteger := CodigoUsuario;
      qryProdutosTrocadosSaidadefeito.AsBoolean := false;
      qryProdutosTrocadosSaidacomposto.AsBoolean := qryProdutosContratoscomposto.AsBoolean;
      qryProdutosTrocadosSaida.post;
      qryprodutoscontratos.Next;
    end;
  end;
end;

procedure TdtmTrocaMercadorias.SetarProdutoComDefeitoTroca;
 procedure Alterar;
 begin
    qryProdutosTrocados.Edit;
    qryProdutosTrocadosdefeito.AsBoolean := not qryProdutosTrocadosdefeito.AsBoolean;
    qryProdutosTrocados.Post;
 end;
begin
  if contratoidentificado then
  begin
    if (qryProdutosTrocadosqtdeentregueParaDevolver.AsCurrency = 0) then
      MensagemAviso(ctPRODUTOAINDANAOENTREGUE)
    else
     Alterar;
     AtribuirTrocaEfetuada(false);
  end
  else Alterar;
end;

procedure TdtmTrocaMercadorias.qryEstoquesNewRecord(DataSet: TDataSet);
begin
  inherited;
  qryEstoquesreservaprevia.AsCurrency := 0;
end;

procedure TdtmTrocaMercadorias.IncluirMovimento(produto: largeint; filial,NumeroTroca: Integer; Qtdade: Real; Tipo,
  Referencia: String; Custo: Real);
var
  MovProxNumero: Integer;
begin
  spcMovimentosProximo.Open;
  MovProxNumero := spcMovimentosProximonumero.AsInteger;
  spcMovimentosProximo.Close;
  if not qryMovimentos.Active then
    qryMovimentos.Active:= True;
  qryMovimentos.Append;
  qryMovimentosnumero.AsInteger        := MovProxNumero;
  qryMovimentosproduto.AsLargeInt      := produto;
  qryMovimentosfilial.AsInteger        := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
  qryMovimentosquantidade.AsCurrency   := Qtdade;
  if Numerotroca<>0 then
    qryMovimentosnumerotroca.AsInteger := NumeroTroca;
  qryMovimentostipomovimento.AsString  := Tipo;
  qryMovimentosvalor.AsCurrency        := Custo;
//  qryMovimentosprecocomicms.AsFloat    := qryProdutosNotaFiscalprecounitario.AsFloat;
//  qryMovimentosprecosemicms.AsFloat    := qryProdutosNotaFiscalprecounitario.AsFloat - (qryProdutosNotaFiscalprecounitario.AsFloat * qryProdutosNotaFiscalaliquotaicms.AsFloat / 100);
//  qryMovimentosaliquotaipi.AsFloat     := qryProdutosNotaFiscalaliquotaipi.AsFloat;
  qryMovimentosreferencia.AsString     := Referencia;
//  qryMovimentoscodigonota.AsInteger    := qryNotaFiscalcodigo.AsInteger;
  qryMovimentos.Post;
end;

procedure TdtmTrocaMercadorias.IncluirMovimento(produto: largeint; filial,
  NumeroTroca: Integer; Qtdade: Real; Tipo, Referencia: String);
var
  MovProxNumero: Integer;
begin
  spcMovimentosProximo.Open;
  MovProxNumero := spcMovimentosProximonumero.AsInteger;
  spcMovimentosProximo.Close;
  if not qryMovimentos.Active then
    qryMovimentos.Active:= True;
  qryMovimentos.Append;
  qryMovimentosnumero.AsInteger        := MovProxNumero;
  qryMovimentosproduto.AsLargeInt      := produto;
  qryMovimentosfilial.AsInteger        := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
  qryMovimentosquantidade.AsCurrency   := Qtdade;
  if Numerotroca<>0 then
    qryMovimentosnumerotroca.AsInteger := NumeroTroca;
  qryMovimentostipomovimento.AsString  := Tipo;
  qryMovimentosreferencia.AsString     := Referencia;
  qryMovimentos.Post;
end;

