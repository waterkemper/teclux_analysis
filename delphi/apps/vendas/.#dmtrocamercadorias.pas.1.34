function TdtmTrocaMercadorias.ValidarContrato(ValidarTotal:Boolean): Boolean;
begin
  result := false;
  if ValidarTotal then
    result := ProdutoaTrocarIgualTotalProdutos;

  if (not result) or ParSistema.IncluirContratoTrocaEquivalente or CondicaoEmissorNFE then
  begin
    qryContratospessoanumero.Required := not ClientedoExterior and ParSistema.CPF_CNPJObrigatorio;
    qryContratosendnumero.Required    := CondicaoEmissorNFE;
    qryContratosrua.Required        := CondicaoEmissorNFE;
    qryContratosnomebairro.Required := CondicaoEmissorNFE;
    qryContratoscidadeibge.Required := CondicaoEmissorNFE;
    qryContratosnomecidade.Required := CondicaoEmissorNFE;
    qryContratosestado.Required := CondicaoEmissorNFE;
    qryContratoscep.Required := CondicaoEmissorNFE;

    qryContratosfoneddd.Required := CondicaoEmissorNFE and not qryContratosfonenumero.IsNull;
    qryContratosfonenumero.Required := CondicaoEmissorNFE and not qryContratosfoneddd.IsNull;

    qryContratosentnumero.Required  := CondicaoEmissorNFE and ExisteDadosEntrega;
    qryContratosentrua.Required     := CondicaoEmissorNFE and ExisteDadosEntrega;
    qryContratosentbairro.Required  := CondicaoEmissorNFE and ExisteDadosEntrega;
    qryContratosentcep.Required     := CondicaoEmissorNFE and ExisteDadosEntrega;
    qryContratosentcidade.Required  := CondicaoEmissorNFE and ExisteDadosEntrega;

    result := qryContratos.CheckRequiredFields;
  end;
end;

