procedure TdtmTrocaMercadorias.SetVendedorDefault(const Value: Integer);
begin
  if FVendedorDefault <> Value then
    FVendedorDefault:= Value;
end;

procedure TdtmTrocaMercadorias.SelecionarCliente;
begin
  if qryConsultaClientes.RecordCount > 0 then
  begin
    RefazConsulta(qryProcuraCliente, [0,1],
       [qryConsultaClientescodigo.AsVariant,
       qryConsultaClientestipoorig.AsVariant]);
    if qryContratos.State = dsBrowse then
      qryContratos.Edit;

    qryContratostipocliente.AsString := qryConsultaClientestipoorig.AsString;
    qryContratoscliente.AsInteger := qryConsultaClientescodigo.AsInteger;
      if qryConsultaClientestipoorig.AsString = 'C' then
        RefazConsulta(qryClientes, [0], [qryConsultaClientescodigo.AsInteger])
      else if qryConsultaClientestipoorig.AsString = 'F' then
        ReFazConsulta(qryFornecedores, [0], [qryConsultaClientescodigo.AsInteger]);
  end;
end;

procedure TdtmTrocaMercadorias.CalcularValorAVista;
begin
  qryContratosvalorprazo.AsCurrency := qryContratostotalprodutos.AsCurrency +
                                       qryContratosfrete.AsCurrency +
                                       qryContratosseguro.AsCurrency -
                                       qryContratosdesconto.AsCurrency;

  qryContratosvalorvista.AsCurrency := qryContratosvalorprazo.AsCurrency;
end;

{
procedure TdtmTrocaMercadorias.MontarListaGrupos(var Grupos: vstring);
var
  Produtos: String;
  Pos: TBookmark;
  a: Integer;
begin
  if qryProdutosContratos.State <> dsInactive then begin
    Pos := qryProdutosContratos.GetBookmark;
    qryProdutosContratos.DisableControls;
    Produtos := '';
    try
      qryProdutosContratos.First;
      while Not qryProdutosContratos.Eof do begin
        Produtos := Produtos + qryProdutosContratosproduto.AsString + ',';
        qryProdutosContratos.Next;
      end;
      if qryProdutosContratos.RecordCount > 0 then
        Produtos := Copy(Produtos, 1, Length(Produtos) - 1);
    finally
      qryProdutosContratos.GotoBookmark(Pos);
      qryProdutosContratos.FreeBookmark(Pos);
      qryProdutosContratos.EnableControls;
    end;
    if Produtos = '' then
      Grupos := nil
    else begin
      qryGruposDeProdutos.Sql[5] := Produtos;
      qryGruposDeProdutos.Open;
      SetLength(Grupos, qryGruposDeProdutos.RecordCount);
      try
        a := 0;
        while Not qryGruposDeProdutos.Eof do begin
          Grupos[a] := qryGruposDeProdutoscodigo.AsString;
          qryGruposDeProdutos.Next;
          Inc(a)
        end
      finally
        qryGruposDeProdutos.Close
      end
    end
  end
end;
}

function TdtmTrocaMercadorias.GetTotalProdutos: Currency;
begin
   Result := qryContratostotalprodutos.AsFloat
end;

procedure TdtmTrocaMercadorias.dsrProdutosContratosDataChange(
  Sender: TObject; Field: TField);
begin
  inherited;
  if Field = qryProdutosContratosfilial then begin
    if (qryProdutosContratosfilial.AsInteger = 0) or ParSistema.FiliaisIndependentes then
    begin
      qryProcuraProduto.MacroByName('filialsaida').AsString := IntToStr(ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual));
      qryProcuraProduto.ParamByName('FilialPreco').AsString := IntToStr(ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual));
    end
    else
    begin
      qryProcuraProduto.MacroByName('filialsaida').AsString := qryProdutosContratosfilial.AsString;
      if ParSistema.UtilizarPrecoFilialBase then
        qryProcuraProduto.ParamByName('FilialPreco').AsString := IntToStr(ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual))
      else
        qryProcuraProduto.ParamByName('FilialPreco').AsString := qryProdutosContratosfilial.AsString;;
    end;

    ReFazConsulta(qryProcuraReservaProduto,[2,3],[IntToStr(qryProdutosContratosproduto.AsLargeint),
                                                    qryProdutosContratosfilial.AsInteger]);
    ReFazConsulta(qryConsultaReservasProduto,[1,2],[IntToStr(qryProdutosContratosproduto.AsLargeint),
                                                    qryProdutosContratosfilial.AsInteger]);

    if ParSistema.UtilizarPrecoFilialBase then
      RefazConsulta(qryProdutoEstoque,[2,1,5],[ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual),
                                               IntToStr(qryProdutosContratosproduto.AsLargeInt),
                                               qryProdutosContratosfilial.AsInteger])
    else
      RefazConsulta(qryProdutoEstoque,[2,1,5],[qryProdutosContratosfilial.AsInteger,
                                               IntToStr(qryProdutosContratosproduto.AsLargeInt),
                                               qryProdutosContratosfilial.AsInteger]);

    qryProdutosContratosreservado.AsCurrency := qryProdutoEstoquereservado.AsCurrency;
    qryProdutosContratosfuturo.AsCurrency    := qryProdutoEstoquefuturo.AsCurrency;
    qryProdutosContratosprecovenda.AsFloat   := qryProdutoEstoquepreco.AsFloat;
    qryProdutosContratosprecotabela.AsFloat  := qryProdutoEstoquepreco.AsFloat;

    if qryProcuraReservaProduto.RecordCount = 0 then
      qryProdutosContratosreserva.Clear
  end else
    if Field = qryProdutosContratosproduto then
    begin
       RefazConsulta(qryEstoque,[0],[IntToStr(qryProdutosContratosproduto.AsLargeInt)]);
       qryConsultaFilialProduto.Params[0].AsString    := IntToStr(qryProdutosContratosproduto.AsLargeInt);
       qryProcuraFilialProduto.Params[1].AsString     := IntToStr(qryProdutosContratosproduto.AsLargeInt);
       qryProdutosContratosmontagemoriginal.AsBoolean := qryProcuraProdutomontagem.AsBoolean;
       qryProdutosContratospromocao.AsBoolean:= qryProcuraProdutopromocao.AsBoolean;
       qryProdutosContratoscaracteristica.AsLargeInt := qryProcuraProdutocaracteristica.AsLargeInt;

       if qryProcuraProdutomontagem.AsBoolean then
          qryProdutosContratosmontagem.AsString := 'S'
      else
          qryProdutosContratosmontagem.AsString := 'N';

      qryProdutosContratosdescricao.AsString      := qryProcuraProdutodescricao.AsString;
      qryProdutosContratosvalorgrade1.AsString    := qryProcuraProdutovalorgrade1.AsString;
      qryProdutosContratosvalorgrade2.AsString    := qryProcuraProdutovalorgrade2.AsString;
      qryProdutosContratoslinha.AsString          := qryProcuraProdutolinha.AsString;
      qryProdutosContratoscoluna.AsString         := qryProcuraProdutocoluna.AsString;
      qryProdutosContratosunidade.AsString        := qryProcuraProdutounidade.AsString;
      qryProdutosContratosbrinde.AsBoolean        := qryProcuraProdutobrinde.AsBoolean;
      qryProdutosContratosfilial.AsInteger        := qryProcuraProdutofilial.AsInteger;
      qryProdutosContratosvendasemestoque.AsString:= qryProcuraProdutovendasemestoque.AsString;

      if ParSistema.UtilizarPrecoFilialBase then
        RefazConsulta(qryProdutoEstoque,[2,1,5],[ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual),
                                                 IntToStr(qryProdutosContratosproduto.AsLargeInt),
                                                 qryProdutosContratosfilial.AsInteger])
      else
        RefazConsulta(qryProdutoEstoque,[2,1,5],[qryProdutosContratosfilial.AsInteger,
                                                 IntToStr(qryProdutosContratosproduto.AsLargeInt),
                                                 qryProdutosContratosfilial.AsInteger]);

      qryProdutosContratosreservado.AsCurrency  := qryProdutoEstoquereservado.AsCurrency;
      qryProdutosContratosfuturo.AsCurrency     := qryProdutoEstoquefuturo.AsCurrency;
      qryProdutosContratosprecovenda.AsFloat    := qryProdutoEstoquepreco.AsFloat;
      qryProdutosContratosprecotabela.AsFloat   := qryProdutoEstoquepreco.AsFloat;
      qryProdutosContratosaliquotaicms.AsFloat  := qryProcuraProdutoaliquotaicms.AsFloat;
      qryProdutosContratosaliquotaipi.AsFloat   := qryProcuraProdutoaliquotaipi.AsFloat;
      if ParSistema.MostrarSimilaresContrato then
        ReFazConsulta(qryProdutosSimilares,[0,1],[qryProdutosContratosproduto.AsVariant, ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual)]);
  end;
end;

