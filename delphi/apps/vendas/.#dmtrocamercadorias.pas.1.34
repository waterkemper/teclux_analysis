function TdtmTrocaMercadorias.TodosProdutosEntreguesDevolvidos: Boolean;
var
  Aux: Boolean;
  RegistroAtual : TBookMark;
begin
  Aux:= true;
  RegistroAtual := qryprodutoscontratostroca.GetBookmark;
  qryProdutosContratosTroca.First;
  while not qryProdutosContratosTroca.Eof do
  begin

  {
    Aux:= (((qryProdutosContratosTrocaqtdeentregue.AsCurrency = 0) and
            (qryContratossituacao.AsString<>'P'))  or

           ((qryProdutosContratosTrocaqtdeentregue.AsCurrency > 0) and
            (qryProdutosContratosTrocaqtdeentregueparadevolver.AsCurrency = qryProdutosContratosTrocaqtdeentregue.AsCurrency)));

  }

    if qryProdutosContratosTrocaqtdeentregue.AsCurrency > 0 then
    begin
      Aux := (qryProdutosContratosTrocaqtdeentregueparadevolver.AsCurrency = qryProdutosContratosTrocaqtdeentregue.AsCurrency);

      if not Aux then
        Break;
    end;

    qryProdutosContratosTroca.Next;
  end;
  qryprodutoscontratostroca.GotoBookmark(RegistroAtual);
  qryprodutoscontratostroca.FreeBookmark(RegistroAtual);
  Result:= Aux;

end;

function TdtmTrocaMercadorias.TodosProdutosDevolvidos: Boolean;
var
  Aux: Boolean;
  RegistroAtual: TBookmark;
begin
  Aux:= False;
  RegistroAtual := qryProdutosContratosTroca.GetBookmark;
  qryProdutosContratosTroca.First;
  while not qryProdutosContratosTroca.Eof do begin
    Aux:= (((qryProdutosContratosTrocaquantidade.AsCurrency = qryProdutosContratosTrocacancelado.AsCurrency) and
            (qryProdutosContratosTrocaDevolver.AsCurrency = 0)) or

           ((qryProdutosContratosTrocaDevolver.AsCurrency > 0) and
            ((qryProdutosContratosTrocaquantidade.AsCurrency - qryProdutosContratosTrocacancelado.AsCurrency) = qryProdutosContratosTrocaDevolver.AsCurrency)));
    if not Aux then
      Break;
    qryProdutosContratosTroca.Next;
  end;
  qryProdutosContratosTroca.GotoBookmark(RegistroAtual);
  qryProdutosContratosTroca.FreeBookmark(RegistroAtual);
  Result:= Aux;
end;

procedure TdtmTrocaMercadorias.ValidarTotaisNotasPag_TotaisDadosFiscais(ListaContratos: String);
const
 SQL = 'where contrato in (%s)';
var
  VTotal, VFrete, VSeguro, VDesconto, VAcrescimo: Currency;
  RegistroNota : TBookMark;
  tipoNota : TtecTipoNota;

begin
  VTotal:= 0; VFrete:= 0; VSeguro:= 0; VDesconto:= 0; VAcrescimo:= 0;
  if ListaContratos<>'' then
  begin
    qryTotaisNotasPag.sql[6] := format(SQL, [ListaContratos]);
    qryTotaisDadosFiscais.sql[6] := format(SQL, [ListaContratos]);

    ReFazConsulta(qryTotaisNotasPag,[],[]);
    ReFazConsulta(qryTotaisDadosFiscais,[],[]);

    for TipoNota := tnDEVOLUCAO_COMCONTRATO to tnDEVOLUCAO_SEMCONTRATO do
    begin
      qryNotasPag.First;
      while not qryNotasPag.Eof do
      begin
        if qryNotasPagcodigo.Asinteger = ord(TipoNota) then
        begin
          VTotal    := VTotal     + qryNotasPagvalornota.AsCurrency;
          VFrete    := VFrete     + qryNotasPagfreteinterno.AsCurrency;
          VSeguro   := VSeguro    + qryNotasPagseguro.AsCurrency;
          VDesconto := VDesconto  + qryNotasPagdesconto.AsCurrency;
          VAcrescimo:= VAcrescimo + qryNotasPagacrescimo.AsCurrency;
          if not qryNotasPag.BookmarkValid(RegistroNota) then
            RegistroNota := qrynotaspag.GetBookmark;
        end;
        qryNotasPag.Next;
      end;
    end;

    qryNotasPag.GotoBookmark(RegistroNota);
    qryNotasPag.FreeBookmark(RegistroNota);

    VTotal    := VTotal     + qryTotaisNotasPagtotal_nota.AsCurrency;
    VFrete    := VFrete     + qryTotaisNotasPagtotal_frete.AsCurrency;
    VSeguro   := VSeguro    + qryTotaisNotasPagtotal_seguro.AsCurrency;
    VDesconto := VDesconto  + qryTotaisNotasPagtotal_desconto.AsCurrency;
    VAcrescimo:= VAcrescimo + qryTotaisNotasPagtotal_acrescimo.AsCurrency;

    if VTotal <> qryTotaisDadosFiscaistotal_nota.AsCurrency then
    begin
      qryNotasPag.Edit;
      qryNotasPagvalornota.AsCurrency:= qryNotasPagvalornota.AsCurrency +
                                        (qryTotaisDadosFiscaistotal_nota.AsCurrency - VTotal);
      qryNotasPag.Post;
    end;

    if VFrete <> qryTotaisDadosFiscaistotal_frete.AsCurrency then
    begin
      qryNotasPag.Edit;
      qryNotasPagfreteinterno.AsCurrency:= qryNotasPagfreteinterno.AsCurrency +
                                        (qryTotaisDadosFiscaistotal_frete.AsCurrency - VFrete);
      qryNotasPag.Post;
    end;

    if VSeguro <> qryTotaisDadosFiscaistotal_seguro.AsCurrency then
    begin
      qryNotasPag.Edit;
      qryNotasPagseguro.AsCurrency:= qryNotasPagseguro.AsCurrency +
                                        (qryTotaisDadosFiscaistotal_seguro.AsCurrency - VSeguro);
      qryNotasPag.Post;
    end;

    if VDesconto <> qryTotaisDadosFiscaistotal_desconto.AsCurrency then
    begin
      qryNotasPag.Edit;
      qryNotasPagdesconto.AsCurrency:= qryNotasPagdesconto.AsCurrency +
                                        (qryTotaisDadosFiscaistotal_desconto.AsCurrency - VDesconto);
      qryNotasPag.Post;
    end;

    if VAcrescimo <> (qryTotaisDadosFiscaistotal_nota.AsCurrency -
                      qryTotaisDadosFiscaistotal_vista.AsCurrency) then
    begin
      qryNotasPag.Edit;
      qryNotasPagacrescimo.AsCurrency:= qryNotasPagacrescimo.AsCurrency +
                                        ((qryTotaisDadosFiscaistotal_nota.AsCurrency -
                                          qryTotaisDadosFiscaistotal_vista.AsCurrency) - VAcrescimo);

      qryNotasPag.Post;
    end;
  end;
end;


function TdtmTrocaMercadorias.NotasFiscaisDevolucaoContrato: Boolean;
var
  TipoNota: TtecTipoNota;
  Posicao: TBookmark;
  Cont: Integer;
  TodosEntreguesDevolvidos: Boolean;
  listacontratos : String;
  retorno: boolean;
begin
  listacontratos := '';
  Result:= False;
  retorno:=false;
  TodosEntreguesDevolvidos := true;

  FecharNotasPag;

  ReFazConsulta(qryNaturezasPadrao,[],[]);

  Posicao := qryProdutosTrocados.GetBookmark;
  qryProdutosTrocados.DisableControls;
  result := true;
  try
    for TipoNota := tnDEVOLUCAO_COMCONTRATO to tnDEVOLUCAO_SEMCONTRATO do
    begin
      Cont := 0;

      qryProdutosTrocados.First;
      while not qryProdutosTrocados.Eof do
      begin
        if (qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency > 0) and ContratoIdentificado and (TipoNota = tnDEVOLUCAO_COMCONTRATO) then
        begin
          result := PreencherProdutosNotasFiscal(TipoNota,Cont+1);
          if result then
          begin
            Inc(Cont);
            if (TipoNota = tnDEVOLUCAO_COMCONTRATO) and ContratoIdentificado  then
            begin
              if not qryProdutosTrocadostodosentregues.AsBoolean then
                TodosEntreguesDevolvidos := false;

              if TodosEntreguesDevolvidos then
                if pos(qryProdutosTrocadoscontrato.AsString,listacontratos)=0 then
                  listacontratos := listacontratos+''''+trim(qryProdutosTrocadoscontrato.AsString)+''',';
            end;
          end;
        end
        else
        begin
          if not ContratoIdentificado and
            (TipoNota = tnDEVOLUCAO_SEMCONTRATO) then
          begin
            result := PreencherProdutosNotasFiscal(TipoNota,Cont+1);
            if result then
              Inc(Cont);
          end;
        end;

        if result then
          qryProdutosTrocados.Next
        else
          break;

      end;

      if Cont > 0  then
      begin
        PreencherNotaFiscal(TipoNota);
        result := CalcularImpostos(qryProdutosNotasPag, qrynotaspag, contribipi, true, true, qryCalculosProdutos, nil, false, Troca );
        retorno:=result;
        //CalcularDadosFiscais(TipoNota);
      end;

    end;

    result:=retorno;
    if result then
    begin
      delete(listacontratos,length(listacontratos),1);
      if TodosEntreguesDevolvidos then
        ValidarTotaisNotasPag_TotaisDadosFiscais(listacontratos);
    end;
  finally
    qryProdutosTrocados.GotoBookmark(Posicao);
    qryProdutosTrocados.FreeBookmark(Posicao);
    qryProdutosTrocados.EnableControls
  end;
end;

function TdtmTrocaMercadorias.GravarDevolucaoMercadoria: Boolean;
var
  I, CodigoNota     : Integer;
  TemProdutoDevolver: Boolean;
  TipoNota: TtecTipoNota;
  DF: Integer;
  ObsNotasPag, ChaveAcesso: String;

  procedure ObservacaoNotasPag;
  begin
    qryDadosFiscais.Close;
    qryDadosFiscais.MacroByName('FiltroNotas').AsString := 'and (df.numero = ' + qryNotasPagDadosFiscaisdadofiscal.Asstring + ')';
    qryDadosFiscais.MacroByName('FiltroCupons').AsString := 'and (df.numero = ' + qryNotasPagDadosFiscaisdadofiscal.Asstring + ')';
    qryDadosFiscais.Params[0].AsString:= IntToStr(qryNotasPagDadosFiscaisproduto.AsLargeInt);
//    qryDadosFiscais.Params[1].AsInteger := qryProdutosContratosfilial.AsInteger;
    qryDadosFiscais.Params[1].AsInteger := qryNotasPagDadosFiscaisfilial.AsInteger;
    qryDadosFiscais.Params[2].AsString:= qryContratosTrocanumero.AsString;
    qryDadosFiscais.Open;
    if (qryDadosFiscais.RecordCount > 0) then begin
      if (qryDadosFiscaisnota.AsInteger > 0) then begin
        if Pos(qryDadosFiscaisnota.AsString,ObsNotasPag) = 0 then
          ObsNotasPag:= ObsNotasPag + '[ NF: S' +
                        qryDadosFiscaisserie.AsString + '  N' + qryDadosFiscaisnota.AsString + ' ]' + #10
      end else if (qryDadosFiscaiscupom.AsInteger > 0) then begin
        if Pos(qryDadosFiscaisnota.AsString,ObsNotasPag) = 0 then
          ObsNotasPag:= ObsNotasPag + '[ CF: M' +
                        qryDadosFiscaismaquina.AsString + '  I' + qryDadosFiscaisintervensao.AsString +
                        '  N' + qryDadosFiscaisCupom.AsString + ' ]' + #10;
      end;
    end;
  end;

  procedure AtualizarCodigoNotaProdutos;
  begin
    qryCalculosProdutos.First;
    while not qryCalculosProdutos.Eof do
    begin
      if (qryCalculosProdutoscodigonota.AsInteger = Ord(TipoNota)) then
      begin
        qryCalculosProdutos.Edit;
        qryCalculosProdutoscodigonota.AsInteger:= CodigoNota;
        qryCalculosProdutos.Post;
      end;
      qryCalculosProdutos.next;
    end;

    qryProdutosNotasPag.First;
    while not qryProdutosNotasPag.Eof do
    begin
      if ClienteTrouxeNota  or (qryProdutosNotasPagcodigonota.AsInteger = Ord(TipoNota)) then
      begin
        qryProdutosNotasPag.Edit;
        qryProdutosNotasPagcodigonota.AsInteger:= CodigoNota;
        qryProdutosNotasPag.Post;

        // Atualiza o CodigoNota na Tabela NotasPagDadosFiscais.
        DF:= 0;

       {
        qryNotasPagDadosFiscais.First;
        while not qrynotaspagdadosfiscais.Eof do
          if qryNotasPagDadosFiscaisproduto.AsString = qryProdutosNotasPagproduto.AsString then
            qrynotaspagdadosfiscais.Delete;

        qryDadosFiscaisCopia.First;
        while not qrydadosfiscaiscopia.Eof do
        begin
          if qryDadosFiscaisCopiadevolver.AsInteger >0 then
          begin
            qryNotasPagDadosFiscais.Insert;
            qryNotasPagDadosFiscaisdadofiscal.AsInteger := qryDadosFiscaisCopiadadofiscal.AsInteger;
            qryNotasPagDadosFiscaisproduto.AsLargeInt := qryDadosFiscaisCopiaproduto.AsLargeInt;
            qryNotasPagDadosFiscaisquantidade.AsInteger := qryDadosFiscaisCopiadevolver.AsInteger;
            qrynotaspagdadosfiscais.Post;
          end;
          qrydadosfiscaiscopia.next;
        end;
        }

        case TipoNota of
        tnDEVOLUCAO_COMCONTRATO:
          begin
            qryNotasPagDadosFiscais.First;
            while not qryNotasPagDadosFiscais.Eof do
            begin
              if (qryNotasPagDadosFiscaisproduto.AsLargeInt = qryProdutosNotasPagproduto.AsLargeInt) then
              begin
                if (DF <> qryNotasPagDadosFiscaisdadofiscal.AsInteger) then
                  ObservacaoNotasPag;
                qryNotasPagDadosFiscais.Edit;
                qryNotasPagDadosFiscaiscodigonota.AsInteger:= CodigoNota;
                qryNotasPagDadosFiscais.Post;
                DF:= qryNotasPagDadosFiscaisdadofiscal.AsInteger;
              end;
              qryNotasPagDadosFiscais.Next;
            end;
          end;
        end;
      end;
      qryProdutosNotasPag.Next;
    end;
  end;

  {
  procedure AtualizarCodigoNotaCalculos;
  begin
    dtmGerarNotaFiscal.qryCalculosNotasPag.First;
    while not dtmGerarNotaFiscal.qryCalculosNotasPag.Eof do begin
      if ClienteTrouxeNota or (dtmGerarNotaFiscal.qryCalculosNotasPagCodigoNota.AsInteger = Ord(TipoNota)) then begin
        dtmGerarNotaFiscal.qryCalculosNotasPag.Edit;
        dtmGerarNotaFiscal.qryCalculosNotasPagcodigonota.AsInteger := CodigoNota;
        dtmGerarNotaFiscal.qryCalculosNotasPag.Post;
      end;
      dtmGerarNotaFiscal.qryCalculosNotasPag.Next;
    end;
  end;
  }

  function ExisteNotasDuplicadas: boolean;
  var
    vQuantidadeNotasComContrato, vQuantidadeNotasSemContrato : integer;
  begin
    result := false;
    vQuantidadeNotasComContrato := 0;
    vQuantidadeNotasSemContrato := 0;
    if qrynotaspag.RecordCount > 1 then
    begin
      qryNotasPag.First;
      while not qrynotaspag.Eof do
      begin
        if qryProdutosNotasPagcontrato.AsString = '' then
          inc(vQuantidadeNotasSemContrato)
        else
        if qryProdutosNotasPagcontrato.AsString <> '' then
          inc(vQuantidadeNotasComContrato);

        qryNotasPag.next;
      end;
      result := (vQuantidadeNotasSemContrato > 1) or (vQuantidadeNotasComContrato > 1);
    end;
  end;
begin
  result := true;
   // Atribuir o Numero da Nota Fiscal
  FecharNotasPag;
  if ClienteTrouxeNota  then
  begin
    spcNotasPagProximoCodigo.Open;
    CodigoNota := spcNotasPagProximoCodigocodigo.AsInteger;
    spcNotasPagProximoCodigo.close;

    AtualizarCodigoNotaProdutos;
{    AtualizarCodigoNotaCalculos;}

    qryNotasPag.Edit;
    qryNotasPagcodigo.AsInteger    := CodigoNota;
    qryNotasPagobservacoes.AsString:= qryNotasPagobservacoes.AsString + #10 +
                                      'REF. NOTA(s) SAIDA(s): ' + ObsNotasPag;
    qryNotasPag.Post;
  end
  else
  if TemProdutoImprimirNotaDevolucao or
    (TemProdutoImprimirNotaCompra and
      not ProdutoaTrocarIgualTotalProdutos) then
  begin
    if VerificarSerieFilial then
    begin
      result :=  NotasFiscaisDevolucaoContrato;

      if result then
        for TipoNota := tnDEVOLUCAO_COMCONTRATO to tnDEVOLUCAO_SEMCONTRATO {tnDEVOLUCAOSUBSTTRIB_SEMCONTRATO} do
        begin
          qryNotasPag.First;
          while not qryNotasPag.Eof do
          begin
            if (qryNotasPagcodigo.AsInteger = Ord(TipoNota)) then
            begin
              spcNotasPagProximoCodigo.Open;
              CodigoNota := spcNotasPagProximoCodigocodigo.AsInteger;
              spcNotasPagProximoCodigo.close;
              qryProdutosNotasPag.MasterSource := nil;
{              dtmGerarNotaFiscal.qryCalculosNotasPag.MasterSource := nil;}

              AtualizarCodigoNotaProdutos;
{              AtualizarCodigoNotaCalculos;}
              qryNotasPag.Edit;
              qryNotasPagnrdocumento.AsInteger    := qryNumeroNotanumeroinicial.AsInteger;
              qryNotasPagcodigo.AsInteger    := CodigoNota;

              case TipoNota of
                tnDEVOLUCAO_COMCONTRATO:
                  qryNotasPagobservacoes.AsString:= qryNotasPagobservacoes.AsString + #10 +
                                                  'REF. NOTA(s) SAIDA(s): ' + ObsNotasPag;
              end;

              qryNotasPag.Post;

              qryNumeroNota.Edit;
              qryNumeroNotanumeroinicial.AsInteger := qryNumeroNotanumeroinicial.AsInteger + 1;
              qryNumeroNota.Post;

              if CondicaoEmissorNFE then
              begin
                // DADOS NF-e
                qryNotasPag.Edit;
                qryNotasPagversaolayout.AsCurrency := 3.10;
                if qryNotasPagmodelodocto.IsNull then
                  qryNotasPagmodelodocto.AsString  := '55';

                qryNotasPagcodaleatorio.AsInteger  := Aleatorio(qryNotasPagdata.AsDateTime, qryNotasPagnrdocumento.Asstring);

                { 0 – pagamento à vista   1 – pagamento à prazo     2 - outros }
                qryNotasPagformapagto.AsInteger    := 2;
                { 1-Retrato/ 2-Paisagem }
                qryNotasPagformatodanfe.AsInteger  := 1;
                {1-Normal/ 2-Contingência}
                qryNotasPagformaemissao.AsInteger  := NFeTipoEmissao;

                ChaveAcesso :=
                           copy(CodigoCidadeIBGEFilialBase,1,2)+                            // 2
                           FormatDateTime('YYMM',qryNotasPagdata.AsDateTime)+             // 4
                           preencheString(CNPJFilialBase,'0',14,false)+                     // 14
                           preencheString(qryNotasPagmodelodocto.AsString,'0',2,false)+   // 2
                           preencheString(SerieSugestao,'0',3,false)+                       // 3
                           preencheString(qryNotasPagnrdocumento.Asstring,'0',9,false) +       // 9
                           qryNotasPagformaemissao.Asstring + //1
                           preencheString(qryNotasPagcodaleatorio.Asstring,'0',8,false);  // 8

                qryNotasPagdigchaveacesso.AsString  := Modulo11(ChaveAcesso);
                qryNotasPagchv_nfe.AsString  := ChaveAcesso+qryNotasPagdigchaveacesso.AsString;


                {1 - PRODUÇÃO 2 - HOMOLOGAÇÃO}
                qryNotasPagambiente.AsInteger       := NFeAmbiente;// '2';

                {1 - normal 2 - compelementar}
                qryNotasPagfinalidadenf.AsInteger   := 4;

                qryNotasPagprocemissao.AsString     := '0';
                qryNotasPagversaoteclux.AsString    := VersaoTecLUX;
                qryNotasPaginfcomplementar.AsString := qryNotasPagobservacoes.AsString;
                qryNotasPag.Post;
              end;


            end;
            qryNotasPag.Next;
          end;
        end;
        qryProdutosNotasPag.MasterSource := dsrnotaspag;

    end;
  end;

  if result then
    if ExisteNotasDuplicadas then
    begin
      result := false;
      MensagemErro('Existem notas de entrada duplicadas, entre em contato com o suporte');
    end;

  if result then
  begin
//    qryProdutosNotasPag.LinkOptions := [loAlwaysResync];
{   dtmGerarNotaFiscal.qryCalculosNotasPag.LinkOptions := [loAlwaysResync];}

    MovimentarProdutos;

    if qryProdutoscontratostroca.Active then
    begin
      TemProdutoDevolver:= False;
      qryProdutosContratosTroca.DisableControls;
      try
        qryProdutosContratosTroca.First;
        for I:= 0 to (qryProdutosContratosTroca.RecordCount - 1) do begin
          if not qryProdutosContratosTrocabrinde.AsBoolean then begin
            if (qryProdutosContratosTrocaDevolver.AsCurrency > 0) then begin
              qryProdutosContratosTroca.Edit;
              qryProdutosContratosTrocacancelado.AsCurrency   := (qryProdutosContratosTrocacancelado.AsCurrency + qryProdutosContratosTrocaDevolver.AsCurrency);
              qryProdutosContratosTrocaprecovenda.AsCurrency := Precos[I];
              qryProdutosContratosTroca.Post;

                                               {
              if (qryContratosTrocalistacasamento.AsInteger > 0)            and
                 (qryContratosTrocadatacasamento.AsDateTime >= DataServidor) and
                 qryProdutosContratosTrocaprodutolista.AsBoolean then
                 AtualizaProdutosListaCasamento;
                 }
            end;
            TemProdutoDevolver:= (TemProdutoDevolver or
                                 ((qryProdutosContratosTrocacancelado.AsCurrency < qryProdutosContratosTrocaQuantidade.AsCurrency) and
                                   not qryProdutosContratosTrocabrinde.AsBoolean));

          end;
          qryProdutosContratosTroca.Next;
        end;
      finally
        qryProdutosContratosTroca.EnableControls;
      end;
    end;

    if (qrycontratostroca.State in [dsedit]) {and(NumeroContrato<>'')} then
      qryContratosTroca.Post;

    if (TemProdutoImprimirNotaDevolucao or
        (TemProdutoImprimirNotaCompra and
          not ProdutoaTrocarIgualTotalProdutos)
          and not ClienteTrouxeNota)
         and CondicaoEmissorNFE then
       Result := EmitirNFe(true);

    if result then
    begin


      if (NumeroContrato<>'') then
        result := Perpetrar([

                             qryPrecos,
                             qryProdutos,
                             qryEstoques,

                             qryContratosTroca,
                             qryProdutosContratosTroca,
//                             qryProdutosListaCasamento,
                             qryContratosDevolvidos,

                             qryContratos,
                             qryParcelas,
                             qryProdutosContratos,
                             qryProdutosTrocados,

                             qryNotasPag,
                             qryProdutosNotasPag ,
  {                           dtmGerarNotaFiscal.qryCalculosNotasPag ,}
                             qryNumeroNota,
                             qryNotasPagDadosFiscais,

                             qryMovimentos
                             ])
      else
      begin
        if ProdutoaTrocarIgualTotalProdutos then
        begin
          qrycontratos.Cancel;
          result := Perpetrar([

                               qryPrecos,
                               qryProdutos,
                               qryEstoques,

                               qryContratosTroca,
                               qryProdutosContratosTroca,
//                               qryProdutosListaCasamento,
                               qryContratosDevolvidos,

                               qryNotasPag,
                               qryProdutosNotasPag ,
  {                             dtmGerarNotaFiscal.qryCalculosNotasPag ,}
                               qryNumeroNota,
                               qryNotasPagDadosFiscais,

                               qryMovimentos
                               ])
        end
        else
          result := Perpetrar([

                               qryPrecos,
                               qryProdutos,
                               qryEstoques,

                               qryContratosTroca,
                               qryProdutosContratosTroca,
//                               qryProdutosListaCasamento,
                               qryContratosDevolvidos,

                               qryProdutosTrocados,
                               qryProdutosTrocadosSaida,

                               qryNotasPag,
                               qryProdutosNotasPag ,
  {                             dtmGerarNotaFiscal.qryCalculosNotasPag ,}
                               qryNumeroNota,
                               qryNotasPagDadosFiscais,

                               qryMovimentos

                               ]);
      end;
    end;

    if result then
    begin
      if TemProdutoImprimirNotaDevolucao or
        (TemProdutoImprimirNotaCompra and
          not ProdutoaTrocarIgualTotalProdutos)
           and not ClienteTrouxeNota then
      begin
        if not CondicaoEmissorNFE then
        begin
          if MensagemConfirmacao(ctEMITIRNOTAFISCALDEVOLUCAO) = smbOk then
            ImprimirNota;
        end
        else  // ROTINAS DE IMPRESSAO DA NF-e
          Result := EmitirNFe;

      end;
      ReFazConsultaContratosPorCliente;
      ReFazConsulta(qrycontratos,[0],[0]);
      Refazconsulta(qryProdutosTrocados, [0],[0]);

      if qryparcelas.Active then
        qryparcelas.Close;
      if qryProdutosContratos.Active then
        qryprodutoscontratos.Close;
    end;

    if qryNotasPag.Active then
      qryNotasPag.Close;

    if qryProdutosNotasPag.Active then
      qryProdutosNotasPag.Close;

{    if dtmGerarNotaFiscal.qryCalculosNotasPag.Active then
      dtmGerarNotaFiscal.qryCalculosNotasPag.Close;
}
    if qryContratosDevolvidos.Active then
      qryContratosDevolvidos.Close;

    if qryMovimentos.Active then
      qryMovimentos.Close;

    if qryEstoques.Active then
      qryEstoques.Close;

    if qryProdutos.Active then
      qryProdutos.Close;

    if qryPrecos.Active then
      qryPrecos.Close;

    if qryNotasPagDadosFiscais.Active then
      qryNotasPagDadosFiscais.Close;

//    qryProdutosNotasPag.MasterSource := dsrnotaspag;
{    dtmGerarNotaFiscal.qryCalculosNotasPag.MasterSource := dsrNotasPag;}
  end;
end;



function TdtmTrocaMercadorias.EmitirNFe(Validando: Boolean = False): Boolean;
var
  LoteNFe, ReciboNFe, ProtocoloNFe, status, DataHoraProcessamento: String;
  NFe: TTecNotaFiscalEletronica;
begin
  Result := False;

  qryNotasPag.First;
  while not qryNotasPag.Eof do
  begin
    if not Validando then
      NFe := TTecNotaFiscalEletronica.Create
    else
      NFe := TTecNotaFiscalEletronica.Create(dtmTecSoft.Database);

    NFe.DiretorioEnvio       := NFeDirEnvio;
    NFe.DiretorioEnviado     := NFeDirEnviados;
    NFe.DiretorioRetorno     := NFeDirRetorno;
    NFe.DiretorioCompartilha := NfeDirCompartilha;
    {$IFDEF MSWINDOWS}
    NFe.Executavel           := NFeExecNFe;
    {$ENDIF}
    try
      if not Validando then
      begin
        ShowProcessando('Gerando o arquivo da NF-e!');
        Sleep(500);
      end;
      // EMITENTE
      NFe.Emit_Documento := CNPJFilialBase;
      NFe.Emit_Nome      := RazaoFilialBase;
      NFe.Emit_Rua       := RuaSemNumeroFilialBase;
      NFe.Emit_Nro       := NumeroFilialBase;
      NFe.Emit_Compl     := ComplementoFilialBase;
      NFe.Emit_Bairro    := BairroFilialBase;
      NFe.Emit_CodMun    := CodigoCidadeIBGEFilialBase;
      NFe.Emit_Mun       := CidadeFilialBase;
      NFe.Emit_UF        := EstadoFilialBase;
      NFe.Emit_CEP       := CEPFilialBase;
      NFe.Emit_Fone      := DDDFilialBase+FoneFilialBase;
      NFe.Emit_IE        := InscricaoEstadualFilialBase;
      NFe.Emit_IM        := InscricaoMunicipalFilialBase;
      NFe.Emit_CNAE      := CNAEFiscalFilialBase;
      NFe.Emit_CRT       := qryNotasPagregimetributario.AsInteger;

      // DESTINATARIO
      NFe.Dest_TipoPessoa := qryClientespessoatipo.AsString;
      NFe.Dest_Documento := qryNotasPagcnpj.AsString;
      NFe.Dest_Nome      := qryNotasPagnome.AsString;
      NFe.Dest_Rua       := qryNotasPagrua.AsString;
      NFe.Dest_Nro       := qryNotasPagendnumero.AsString;
      NFe.Dest_Compl     := qryNotasPagendcomplemento.AsString;
      NFe.Dest_Bairro    := qryNotasPagnomebairro.AsString;
      NFe.Dest_CodMun    := qryNotasPagcidadeibge.AsString;
      NFe.Dest_Mun       := qryNotasPagnomecidade.AsString;
      NFe.Dest_UF        := qryNotasPagestado.AsString;
      NFe.Dest_CEP       := qryNotasPagcep.AsString;
      NFe.Dest_CodPais   := qryNotasPagpais.AsInteger;
      NFe.Dest_Pais      := qryNotasPagnomepais.AsString;
      NFe.Dest_Fone      := qryNotasPagfoneddd.AsString+qryNotasPagfonenumero.AsString;
      NFe.Dest_IE        := qryNotasPaginscricaoestadual.AsString;
      NFe.Dest_ISUF      := qryNotasPagiesubsttributario.AsString;

      nfe.Validando := Validando;

      Result := NFe.GerarNFe(qryNotasPag,nil,qryProdutosNotasPag,nil,nil,
                     nil,nil,nil,nil,nil,SerieSugestao,'E');

      if Result and not Validando then
      begin
        if NFeTipoEmissao in [1,3] then
        begin
          ShowProcessando;
          ShowProcessando('Verificando status do serviço NF-e!');
          Sleep(500);
          if NFe.VerificarStatusServico(IntToStr(NFeAmbiente)) then
          begin
            ShowProcessando;
            ShowProcessando('Processando o arquivo de envio da NF-e!');
            Sleep(500);
            Result := NFe.EnviarNFe(qryNotasPagchv_nfe.AsString, LoteNFe, ReciboNFe);
            if Result then
            begin
              qryNotasPag.Edit;
              qryNotasPagnumlotenfe.AsString   := LoteNFe;
              qryNotasPagnumrecibonfe.AsString := ReciboNFe;
              qryNotasPag.Post;
              Result := Perpetrar([qryNotasPag]);
              if Result then
              begin
                ShowProcessando;
                ShowProcessando('Consultando o arquivo de retorno da NF-e!');
                Sleep(500);
                Result := NFe.ConsultarSituacaoLote(ReciboNFe, ProtocoloNFe, status, DataHoraProcessamento, IntToStr(NFeAmbiente));
              end;
              if Result then
              begin
                qryNotasPag.Edit;
                qryNotasPagnumprotocolonfe.AsString := ProtocoloNFe;
                qryNotasPagdhprocnfe.AsDateTime :=  FormatarTimeStamp(DataHoraProcessamento);
                qryNotasPagstatusnfe.AsString := status;
                qryNotasPag.Post;

                if (qryNotasPagstatusnfe.AsString = '301') or
                   (qryNotasPagstatusnfe.AsString = '302') then
                begin
                  qryNotasPag.Edit;
                  qryNotasPagsituacao.AsString := 'D';
                  qryNotasPag.Post;
//                  EliminarMovimentos;
//                  LimparTabela(qryDuplicatas);
//                  Result := Perpetrar([qryNotasPag, qryDuplicatas, qryMovimentos]);
                end;
//                else
                  Result := Perpetrar([qryNotasPag]);

                if Result then
                begin
                  ShowProcessando;
                  ShowProcessando('Gerando o arquivo de compartilhamento da NF-e!');
                  Sleep(500);
                  Result := NFe.CompartilharXML(qryNotasPagchv_nfe.AsString,
                                                ReciboNFe, qryNotasPagfilial.AsString,
                                                SerieSugestao, qryNotasPagnrdocumento.AsString,
                                                qryNotasPagemissao.AsDateTime);
                  if Result then
                  begin
                    ShowProcessando;
                    ShowProcessando('Imprimindo o DANFE!');
                    try
                      NFe.ImprimirDanfe({ChaveAcesso+qryNotaFiscaldigchaveacesso.AsString,}
                                        qryNotasPagfilial.AsString,
                                        qryNotasPagserie.AsString,
                                        qryNotasPagnrdocumento.AsString,
                                        qryNotasPaglocalentrega_cep.AsString,
                                        '',
                                        IntToStr(NFeNVias), NFeLogotipoDANFE,
                                        ParSistema.NomeImpressoraNotaMercadorias, NFeVisualizarDANFE,
                                        qryNotasPagemissao.AsDateTime,
                                        qryProdutosNotasPag,
                                        NFeExecDANFE);
                    finally
                      ShowProcessando;
                    end;
                  end
                  else
                    ShowProcessando;
                end;
              end
              else
                ShowProcessando;
            end
            else
              ShowProcessando;
          end
          else
            ShowProcessando;
        end
        else
        begin
          if not NFeVisualizarDANFE then
            MensagemAviso('Impressão da Nota Fiscal será iniciada.');
          NFe.ImprimirDanfe({ChaveAcesso+qryNotaFiscaldigchaveacesso.AsString,}
                            qryNotasPagfilial.AsString,
                            qryNotasPagserie.AsString,
                            qryNotasPagnrdocumento.AsString,
                            qryNotasPaglocalentrega_cep.AsString,
                            '',
                            IntToStr(NFeNVias), NFeLogotipoDANFE,
                            ParSistema.NomeImpressoraNotaMercadorias, NFeVisualizarDANFE,
                            qryNotasPagemissao.AsDateTime,qryProdutosNotasPag,
                            NFeExecDANFE);
        end;
      end;

    finally
      FreeAndNil(NFe);
    end;

    if result then
      qryNotasPag.Next
    else
      break;
  end;
end;


function TdtmTrocaMercadorias.GravarParcelas: Boolean;
begin
  Result:= False;
  if qryParcelasContratos.CheckRequiredFields then begin
    qryParcelasContratosparcelaadicional.AsBoolean := True;
    qryParcelasContratos.Post;
    RecalcularParcelaOrigem;
    Result:= True;
  end;
end;

function TdtmTrocaMercadorias.IncluirParcelas(Editar: Boolean): Boolean;
begin
  Result:= False;
  if not Editar then begin
    qryParcelasContratos.Append;
    qryParcelasContratoscontrato.AsString:= qryContratosTrocanumero.AsString;
    Result:= True;
  end;
end;

procedure TdtmTrocaMercadorias.IniciarTroca;
var
  I: Integer;
begin
  // Seta os valores iniciais das variaveis utilizadas para fazer a troca.
  CancelarTroca;
  NrSelecoes       := 0;
  SetLength(NewParcelas, qryParcelasContratos.RecordCount);
  try
    FNPAberta:= 0;
    FValorAberto:= 0;
    qryParcelasContratos.First;
    for I:= 0 to qryParcelasContratos.RecordCount - 1 do begin
      if qryParcelasContratosdataPagto.AsDateTime = 0 then begin
        FValorAberto:=  FValorAberto + (qryParcelasContratosvalorvencto.AsCurrency);
        Inc(FNPAberta);
      end;
      NewParcelas[I].Registro    := qryParcelasContratosnumero.AsInteger;
      NewParcelas[I].DataVencto  := qryParcelasContratosdatavencto.AsDateTime;
      NewParcelas[I].DataPagto   := qryParcelasContratosdatapagto.AsDateTime;
      NewParcelas[I].ValorVencto := qryParcelasContratosvalorvencto.AsCurrency;
      NewParcelas[I].ValorPagto  := qryParcelasContratosvalorpagto.AsCurrency;
      qryParcelasContratos.Next;
    end;
    qryParcelasContratos.First;
  except
  end;
  SetLength(Defeitos, qryProdutosContratosTroca.RecordCount);
  SetLength(Precos  , qryProdutosContratosTroca.RecordCount);
  try
    qryProdutosContratosTroca.First;
    for I:= 0 to (qryProdutosContratosTroca.RecordCount -1) do begin
      Precos[I]  := qryProdutosContratosTrocaprecovenda.AsCurrency;
      Defeitos[I]:= 0;
      qryProdutosContratosTroca.Next;
    end;
    qryProdutosContratosTroca.First;
  except
  end;

  qryValoresDevolvidos.Sql[08]:= 'contrato = :contrato';
  RefazConsulta(qryValoresDevolvidos,[0],[qryContratosTrocanumero.AsString]);

(*
  FOldValorProdutos:= qryContratosTrocavalorprodutos.AsCurrency - qryValoresDevolvidosvalorvista.AsCurrency;
  FOldValorVista   := qryContratosTrocavalorvista.AsCurrency -  (qryValoresDevolvidosvalorvista.AsCurrency +
                                                            qryValoresDevolvidosfrete.AsCurrency      +
                                                            qryValoresDevolvidosseguro.AsCurrency     -
                                                            qryValoresDevolvidosdesconto.AsCurrency);
*)
  FOldValorProdutos:= qryContratosTrocavalorprodutos.AsCurrency - (qryValoresDevolvidosvalorvista.AsCurrency +
                                                                   qryValoresDevolvidosdesconto.AsCurrency   -
                                                                   qryValoresDevolvidosfrete.AsCurrency      -
                                                                   qryValoresDevolvidosseguro.AsCurrency);
  FOldValorVista   := qryContratosTrocavalorvista.AsCurrency - qryValoresDevolvidosvalorvista.AsCurrency;

  FOldValorFrete   := qryContratosTrocaFrete.AsCurrency      -  qryValoresDevolvidosfrete.AsCurrency;
  FOldValorSeguro  := qryContratosTrocaSeguro.AsCurrency     -  qryValoresDevolvidosseguro.AsCurrency;
  FOldValorDesconto:= qryContratosTrocadesconto.AsCurrency   -  qryValoresDevolvidosdesconto.AsCurrency;
  fOldValorCreditoTroca:= qryContratosTrocacreditotroca.AsCurrency   -  qryValoresDevolvidoscreditotroca.AsCurrency;
  FOldValorPrazo   := qryContratosTrocavalorprazo.AsCurrency -  qryValoresDevolvidosvalorprazo.AsCurrency;

  FValorProdutos   := FOldValorProdutos;
  FValorVista      := FOldValorVista;
  FValorFrete      := FOldValorFrete;
  FValorSeguro     := FOldValorSeguro;
  FValorDesconto   := FOldValorDesconto;
  fValorCreditoTroca := fOldValorCreditoTroca;
  FValorPrazo      := FOldValorPrazo;
//  FValorDevolvido  := 0;
  CalcularPrestacoesReais;
end;

procedure TdtmTrocaMercadorias.LimparTabelas;
begin
//  CancelarDevolucao;
  ReFazConsulta(qryProdutosContratosTroca,  [0,1,2,3,4],[false, 0,'','','']);
  ReFazConsulta(qryParcelasContratos,        [0],        ['']);
  ReFazConsulta(qryParcelasAbertas,          [0],        ['']);
  ReFazConsulta(qryContratosTroca,                [0],        ['']);
  ReFazConsulta(qryContratosPorCliente,    [0,1],      [0,'']);
end;


procedure TdtmTrocaMercadorias.PreencherNotaFiscal(TipoNota: TtecTipoNota);
var
  Desconto,
  Seguro,
  Frete,
  ValorProd,
  ValorNota: Currency;

begin
  qryNotasPag.Append;
  qryNotasPagserie.AsString := SerieSugestao;
  qryNotasPagnrdocumento.AsInteger := Ord(TipoNota);
  qryNotasPagcodigo.AsInteger := Ord(TipoNota);

  qryNotasPagfornecedor.AsInteger       := qryContratoscliente.AsInteger;
  qryNotasPagtipofornecedor.AsString    := qryContratostipocliente.AsString;

  case tiponota of
    tnDEVOLUCAO_COMCONTRATO:
    begin
      if FUnicoContrato<>'' then
      begin
        qryNotasPagcontrato.AsString     := FUnicoContrato;
        qryNotasPagobservacoes.AsString  := qryContratosTrocaconsideracoes.AsString;
      end;
    end;
  end;

  qryNotasPagestado.AsString            := qryContratosestado.AsString;
  qryNotasPagcnpj.AsString              := qryContratospessoanumero.AsString;
  qryNotasPaginscricaoestadual.AsString := qryContratosiddocumento.AsString;
  qryNotasPagclientecontribicms.AsBoolean := qryContratoscontribicms.AsBoolean;


  qryNotasPagfilial.AsInteger           := FilialBase;
  qryNotasPagdata.AsDateTime            := DataServidor;
  qryNotasPagemissao.AsDateTime         := DataServidor;

  qryNotasPagpermitirimprimir.AsBoolean := True;
  qryNotasPagsituacao.AsString := 'N';

  qryNotasPagnome.AsString              := qryContratosnome.AsString;
  qryNotasPagfoneddd.AsString           := qryContratosfoneddd.AsString;
  qryNotasPagfonenumero.AsString        := qryContratosfonenumero.AsString;

  if qryContratosestado.AsString = '.' then {estrangeiro}
  begin
    qryNotasPagpais.asstring           := qryContratoscidadeibge.asstring;
    qryNotasPagnomepais.AsString       := qryContratosnomecidade.AsString;
    qryNotasPagrua.AsString            := qryContratosrua.AsString;
    qryNotasPagendnumero.AsString      := qryContratosendnumero.AsString;
    qryNotasPagendcomplemento.AsString := qryContratosendcomplemento.AsString;
    qryNotasPagcidade.AsString         := qryContratosbairro.AsString;
    qryNotasPagnomecidade.AsString     := qryContratosnomebairro.AsString;
    qryNotasPagestado.AsString         := qryContratosestado.AsString;
  end
  else
  begin
    qryNotasPagpais.AsInteger          := 1058;
    qryNotasPagnomepais.AsString       := 'Brasil';
    qryNotasPagrua.AsString            := qryContratosrua.AsString;
    qryNotasPagendnumero.AsString      := qryContratosendnumero.AsString;
    qryNotasPagendcomplemento.AsString := qryContratosendcomplemento.AsString;
    qryNotasPagbairro.AsString         := qryContratosbairro.AsString;
    qryNotasPagnomebairro.AsString     := qryContratosnomebairro.AsString;
    qryNotasPagcidade.AsString         := qryContratoscidade.AsString;
    qryNotasPagnomecidade.AsString     := qryContratosnomecidade.AsString;
    qryNotasPagcidadeibge.AsString     := qryContratoscidadeibge.AsString;
    qryNotasPagestado.AsString         := qryContratosestado.AsString;
    qryNotasPagcep.Asstring            := qryContratoscep.AsString;
  end;

  Desconto  := 0;
  Seguro    := 0;
  Frete     := 0;
  ValorProd := 0;
  ValorNota := 0;

  case TipoNota of

    tnDEVOLUCAO_COMCONTRATO:
    begin
      qryContratosDevolvidos.First;
      while not qryContratosDevolvidos.Eof do
      begin
        if qryContratosDevolvidossituacao.AsString = 'N' then
        begin
{          if (((TipoNota = tnDEVOLUCAO_COMCONTRATO) and NotaNormal(qryContratosDevolvidosincidencia.AsString)) or
              ((TipoNota = tnDEVOLUCAOSUBSTTRIB_COMCONTRATO) and NotaSubstituicao(qryContratosDevolvidosincidencia.AsString))) then} begin
              Desconto  := Desconto  + qryContratosDevolvidosdesconto.AsCurrency;
              Seguro    := Seguro    + qryContratosDevolvidosseguro.AsCurrency;
              Frete     := Frete     + qryContratosDevolvidosfrete.AsCurrency;
              ValorProd := ValorProd + qryContratosDevolvidosvalorvista.AsCurrency +
                                       qryContratosDevolvidosdesconto.AsCurrency -
                                       qryContratosDevolvidosfrete.AsCurrency -
                                       qryContratosDevolvidosseguro.AsCurrency;
              ValorNota := ValorNota + qryContratosDevolvidosvalorprazo.AsCurrency;
          end;
        end;
        qryContratosDevolvidos.Next;
      end;
    end;

    tnDEVOLUCAO_SEMCONTRATO {, tnDEVOLUCAOSUBSTTRIB_SEMCONTRATO}:
    begin
      qryNotasPag.Post;
      qryProdutosNotasPag.First;
      while not qryProdutosNotasPag.Eof do
      begin
        if qryProdutosNotasPagcodigonota.AsInteger = ord(tiponota) then
          ValorProd := ValorProd + (qryProdutosNotasPagquantidade.AsCurrency * qryProdutosNotasPagPrecoVenda.AsCurrency);
        qryProdutosNotasPag.Next;
      end;
      ValorNota := ValorProd;
    end;

  end;


  // VALOR VISTA = TOTAL PRODUTOS + FRETE + SEGURO - DESCONTO

  qryNotasPag.Edit;
  qryNotasPagdesconto.AsCurrency        := Truncar(Desconto,2);
  qryNotasPagfreteinterno.AsCurrency    := Truncar(Frete,2);
  qryNotasPagseguro.AsCurrency          := Truncar(Seguro,2);
  qryNotasPagvalornota.AsCurrency       := Truncar(ValorNota,2);
  qryNotasPagtotalprodutos.AsCurrency   := Truncar(ValorProd,2);
  qryNotasPagacrescimo.AsCurrency       := Truncar(ValorNota - (ValorProd + Frete + Seguro - Desconto),2);
  qryNotasPag.Post;

  if qryProdutosNotasPag.Locate('codigonota', ord(tiponota), []) then
  begin
    qryNotasPag.Edit;
    qryNotasPagcodigonatureza.asinteger := qryProdutosNotasPagnatureza.AsInteger;
    qryNotasPagcodigofiscal.AsInteger   := qryProdutosNotasPagcodigofiscal.AsInteger;
    if qryNaturezasPadrao.Locate('natureza', qryProdutosNotasPagnatureza.AsInteger, []) then
      qryNotasPagnatureza.AsString := qryNaturezasPadrao.fieldbyname('descricaonatureza').AsString;
    qryNotasPag.Post;
  end;

end;

procedure TdtmTrocaMercadorias.qryProcuraClienteSelecaoAfterClose(DataSet: TDataSet);
begin
  inherited;
  LimparTabelas;
end;

procedure TdtmTrocaMercadorias.qryProcuraClienteSelecaoBeforeOpen(DataSet: TDataSet);
begin
  inherited;
  if (qryProcuraClienteSelecao.Params[1].AsString = '') then
    qryProcuraClienteSelecao.Params[1].AsString:= 'C';
end;

procedure TdtmTrocaMercadorias.qryContratosPorClienteAfterScroll(DataSet: TDataSet);
begin
  inherited;
  if not qryContratosPorCliente.IsEmpty then begin
    if Assigned(FAfterScrollContratosClientes) then
      FAfterScrollContratosClientes(qryContratosPorCliente);
    ReFazConsultaTabelas;
    IniciarTroca;
    AtribuirTrocaEfetuada(True);
  end;
end;

procedure TdtmTrocaMercadorias.qryParcelasContratosBeforeDelete(DataSet: TDataSet);
begin
  if qryParcelasContratosnumero.AsInteger <> 0 then begin
    MensagemAviso(ctPARCELANAOPODESEREXCLUIDA);
    Abort;
  end;
end;

procedure TdtmTrocaMercadorias.qryParcelasContratosNewRecord(DataSet: TDataSet);
begin
  inherited;
  qryParcelasContratoscontrato.AsString     := qryContratosTrocanumero.AsString;
end;

procedure TdtmTrocaMercadorias.qryProdutosContratosTrocaAfterInsert(DataSet: TDataSet);
begin
  inherited;
  qryProdutosContratosTroca.Cancel;
end;

procedure TdtmTrocaMercadorias.qryProdutosContratosTrocaAfterScroll(DataSet: TDataSet);
begin
  inherited;
  // Só permite alterar o preço se marcar o produto como avariado.
  qryProdutosContratosTrocaprecovenda.ReadOnly := //not ((qryProdutosContratosTrocaDevolver.AsInteger = 0) and
                                                   not qryProdutosContratosTrocadefeito.AsBoolean;

  // Se a devolução for total, ou produto igual a brinde ou a quantidade cancelada for iagual
  //a quantidade de produtos vendidos não pernite alterar a quantidade a ser devolvida.
  qryProdutosContratosTrocaDevolver.ReadOnly   := //CancelarTotal or XX-Jander
                                             qryProdutosContratosTrocabrinde.AsBoolean or
                                             (qryProdutosContratosTrocacancelado.AsCurrency = qryProdutosContratosTrocaquantidade.AsCurrency);
  qryProdutosContratosTrocaqtdeentregueParaDevolver.ReadOnly:= qryProdutosContratosTrocaDevolver.ReadOnly;

  if Assigned(OnScrollLinhaColunaGrade) then
   OnScrollLinhaColunaGrade(qryProdutosContratosTroca);

end;

function TdtmTrocaMercadorias.Qtde_Entregue: Real;
begin
  Result:= qryProdutosContratosTrocaqtdeentregue.AsCurrency - qryProdutosContratosTrocacancelado.AsCurrency;
end;

function TdtmTrocaMercadorias.Qtde_A_Devolver: Real;
begin
  Result:= qryProdutosContratosTrocaDevolver.AsCurrency;
end;

function TdtmTrocaMercadorias.ReFazConsultaContratosPorCliente: Boolean;
begin
  ReFazConsulta(qryContratosPorCliente,[0,1],[qryProcuraClienteSelecaocodigo.AsInteger, qryProcuraClienteSelecaotipo.AsString]);
  Result:= qryContratosPorCliente.IsEmpty;
  if Result then begin
    ReFazConsulta(qryContratosTroca,              [0],        ['']);
    ReFazConsulta(qryProdutosContratosTroca, [0,1,2,3,4], [false, 0,'','','']);
    ReFazConsulta(qryParcelasContratos,      [0],        ['']);
    ReFazConsulta(qryParcelasAbertas,        [0],        ['']);
  end;
end;

procedure TdtmTrocaMercadorias.ReFazConsultaTabelas;
begin
  if (qryContratosPorClientenumero.AsString<>'') then
  begin
    ReFazConsulta(qryContratos,          [0],[qryContratosPorClientenumero.AsString]);
    ReFazConsulta(qryContratosTroca,          [0],[qryContratosPorClientenumero.AsString]);
    ReFazConsultapornome(qryProdutosContratosTroca,['filialvirtual','filialdevolucao','estado','primogenito','contrato'],
                            [(TipoFilial='V'), FilialBase,
                            qryProcuraClienteSelecaoestado.AsString,
                            ifthen(qryContratosPorClienteprimogenito.AsString <> '', qryContratosPorClienteprimogenito.AsString, qryContratosPorClientenumero.AsString),
                            qryContratosPorClientenumero.AsString]);


    ReFazConsulta(qryParcelasContratos,  [0],[qryContratosTrocanumero.AsString]);
    ReFazConsulta(qryParcelasAbertas,    [0],[qryContratosPorClientenumero.AsString]);
  end;
  ApagarprodutosTrocados; //Temporaria p/ somente um contrato alto lá João
end;

procedure TdtmTrocaMercadorias.Selecionar(tipoConsulta: TtecContratoTipoConsulta);
begin
  case tipoConsulta of
   ctcCLIENTESTROCA:
    begin
     qryProcuraClienteSelecao.Params[1].AsString:= qryConsultaClientestipoorig.AsString;
     ReFazConsulta(qryProcuraClienteSelecao,[0],[qryConsultaClientescodigo.AsInteger])
    end;
   ctcCLIENTES : SelecionarCliente;
   ctcVENDEDOR : qryContratosvendedor.AsInteger := qryConsultaVendedorescodigo.AsInteger;
  end;
end;

procedure TdtmTrocaMercadorias.SetarProdutoComDefeito;
begin
  // Marcar o produto como avariado se a quantidade entregue (nota) menos a quantidade
  // cancelado (devolução) for maior que zero.
  if (qryProdutosContratosTrocaqtdeentregueParaDevolver.AsCurrency > 0) then begin
    qryProdutosContratosTroca.Edit;
    qryProdutosContratosTrocadefeito.AsBoolean:= not qryProdutosContratosTrocadefeito.AsBoolean;
    if not qryProdutosContratosTrocadefeito.AsBoolean then
      qryProdutosContratosTrocaprecovenda.AsCurrency:= Precos[qryProdutosContratosTroca.CurRec];
    if qryProdutosContratosTroca.State = dsedit then
      qryProdutosContratosTroca.Post;
    qryProdutosContratosTrocaAfterScroll(qryProdutosContratosTroca);
  end
  else
    MensagemAviso(ctPRODUTOAINDANAOENTREGUE);
end;

procedure TdtmTrocaMercadorias.SetEditarContrato(const Value: Boolean);
begin
  qryContratosTroca.Edit;
end;

function TdtmTrocaMercadorias.GetTabelaParcela: TtecQuery;
begin
  Result:= qryParcelasContratos;
end;

function TdtmTrocaMercadorias.GetPodeAlterarParcela: Boolean;
begin
  Result:= (qryParcelasContratosnumero.AsInteger = 0);
end;

function TdtmTrocaMercadorias.GetPodeReterValor: Boolean;
begin
  Result:= (qryParcelasContratostipopagto.AsString = 'D') or
           (qryParcelasContratostipopagto.AsString = 'R');
end;

procedure TdtmTrocaMercadorias.ImprimirNota;
begin
  dtmImprimeNotaEntrada := TdtmImprimeNotaEntrada.Create(Self);
  try
    if not qryNotasPag.IsEmpty then
    begin
      qryNotasPag.First;
      while not qryNotasPag.Eof do
      begin
        dtmImprimeNotaEntrada.ImprimirNotasPag(qryNotasPagcodigo.AsInteger);
        qryNotasPag.Next;
      end;
    end;
  finally
    dtmImprimeNotaEntrada.Free;
    dtmImprimeNotaEntrada := nil;
  end;
end;

procedure TdtmTrocaMercadorias.ImprimirCarne;
begin
  dtmImprimeCarne := TdtmImprimeCarne.Create(Self);
  try
    if not qryNotasPag.IsEmpty then
      dtmImprimeCarne.ImprimirCarnesContrato(numerocontrato, False);
  finally
    dtmImprimeCarne.Free;
    dtmImprimeCarne := nil;
  end;
end;

procedure TdtmTrocaMercadorias.ReterValorDevolucao;
begin
  qryParcelasContratos.Edit;
  if (qryParcelasContratostipopagto.AsString = 'R') then
    qryParcelasContratostipopagto.AsString:= 'D'
  else if (qryParcelasContratostipopagto.AsString = 'D') then
    qryParcelasContratostipopagto.AsString:= 'R';
  qryParcelasContratos.Post;
end;

function TdtmTrocaMercadorias.GetTipoCliente: String;
begin
  Result:= qryProcuraClientetipo.AsString
end;

function TdtmTrocaMercadorias.GravarProdutos: Boolean;
begin
  if qryprodutoscontratostroca.State in [dsinsert, dsedit] then
    qryProdutosContratosTroca.Post;
  Result:= True;
end;

