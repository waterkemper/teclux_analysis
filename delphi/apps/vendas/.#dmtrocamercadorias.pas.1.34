procedure TdtmTrocaMercadorias.GuardarProdutoaTrocar;

 procedure GuardarProduto;
 begin
   qryProdutosTrocadoscontrato.AsString := qryProdutosContratosTrocacontrato.AsString;
   qryProdutosTrocadosproduto.AsString  := qryProdutosContratosTrocaproduto.AsString;
   qryProdutosTrocadosdescricaproduto.AsString := qryProdutosContratosTrocadescricao.AsString;
   qryProdutosTrocadosfilialsaida.AsString := qryProdutosContratosTrocafilial.AsString;
   qryProdutosTrocadosfilial.AsInteger := ifthen(TipoFilial<>'V', FilialBase, qryProdutosContratosTrocafilial.AsInteger);
   qryProdutosTrocadosunidade.AsString := qryProdutosContratosTrocaunidade.AsString;
   qryProdutosTrocadosquantidade.AsCurrency := qryProdutosContratosTrocaDevolver.AsCurrency;
   qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency := qryProdutosContratosTrocaqtdeentregueparadevolver.AsCurrency;
   qryProdutosTrocadosprecotabela.AsCurrency := qryProdutosContratosTrocaprecotabela.AsCurrency;
   if qryProdutosContratosTrocaquantidade.AsCurrency = qryProdutosTrocadosquantidade.AsCurrency then
     qryProdutosTrocadosdesconto.AsCurrency := qryProdutosContratosTrocadesconto.AsCurrency
   else
     qryProdutosTrocadosdesconto.AsCurrency := Truncar((qryProdutosContratosTrocadesconto.AsCurrency/qryProdutosContratosTrocaquantidade.AsCurrency) * qryProdutosTrocadosquantidade.AsCurrency,2);

//   qryProdutosTrocadosprecovenda.AsCurrency := qryProdutosContratosTrocaprecovenda.AsCurrency-(qryProdutosTrocadosdesconto.AsCurrency/qryProdutosTrocadosquantidade.AsCurrency);  {aqui}
   qryProdutosTrocadosprecovenda.AsCurrency := qryProdutosContratosTrocaprecovenda.AsCurrency;
//   qryProdutosTrocadosprecoavaliado.AsCurrency := qryProdutosTrocadosprecovenda.AsCurrency;

   qryProdutosTrocadosprecoavaliado.AsCurrency := qryProdutosContratosTrocaprecovenda.AsCurrency -
               Truncar((qryProdutosTrocadosdesconto.AsCurrency/ifthen(qryProdutosTrocadosquantidade.AsCurrency<>0,qryProdutosTrocadosquantidade.AsCurrency,1)),2);

   qryProdutosTrocadoslinha.AsString := qryProdutosContratosTrocalinha.AsString;
   qryProdutosTrocadoscoluna.AsString := qryProdutosContratosTrocacoluna.AsString;
   qryProdutosTrocadosvalorgrade1.AsString := qryProdutosContratosTrocavalorgrade1.AsString;
   qryProdutosTrocadosvalorgrade2.AsString := qryProdutosContratosTrocavalorgrade2.AsString;
   qryProdutosTrocadosdefeito.AsBoolean := qryProdutosContratosTrocadefeito.AsBoolean;

   qryProdutosTrocadosincidencia.AsString := qryProdutosContratosTrocaincidencia.AsString;
   qryProdutosTrocadoscsosn.AsString := qryProdutosContratosTrocacsosn.AsString;

   qryProdutosTrocadospiscst.AsString := qryProdutosContratosTrocapiscst.AsString;
   qryProdutosTrocadoscofinscst.AsString := qryProdutosContratosTrocacofinscst.AsString;
   qryProdutosTrocadosipicst.AsString := qryProdutosContratosTrocaipicst.AsString;

   qryProdutosTrocadosaliquotaicms.AsCurrency := qryProdutosContratosTrocaaliquotaicms.AsCurrency;
   qryProdutosTrocadosaliquotaipi.AsCurrency := qryProdutosContratosTrocaaliquotaipi.AsCurrency;
   qryProdutosTrocadospisaliquota.AsCurrency := qryProdutosContratosTrocaaliquotapis.AsCurrency;
   qryProdutosTrocadoscofinsaliquota.AsCurrency := qryProdutosContratosTrocaaliquotacofins.AsCurrency;
   qryProdutosTrocadosorigem.AsInteger := qryProdutosContratosTrocaorigem.Asinteger;
   qryProdutosTrocadosextipi.AsString := qryProdutosContratosTrocaextipi.AsString;
   qryProdutosTrocadosgenero.AsInteger := qryProdutosContratosTrocagenero.Asinteger;
   qryProdutosTrocadosclassificacaofiscal.AsString := qryProdutosContratosTrocaclassificacaofiscal.AsString;

   qryProdutosTrocadoscliente.AsInteger := qryContratosTrocacliente.Asinteger;
   qryProdutosTrocadostipocliente.AsString := qryContratosTrocatipocliente.AsString;
   qryProdutosTrocadosprimogenito.AsString := qryContratosTrocaprimogenito.AsString;
   qryProdutosTrocadospercreducaobase.AsCurrency := qryProdutosContratosTrocapercreducaobase.AsCurrency;
   if qryContratostrocasituacao.asstring<>'F' then
     qryProdutosTrocadostodosentregues.AsBoolean := TodosProdutosEntreguesDevolvidos
   else
     qryProdutosTrocadostodosentregues.AsBoolean := TodosProdutosDevolvidos;
   qryProdutosTrocadoscaracteristica.AsLargeInt := qryProdutosContratosTrocacaracteristica.AsLargeInt;
   qryProdutosTrocadosfuturo.AsCurrency := qryProdutosContratosTrocafuturo.AsCurrency;
   qryProdutosTrocadosfuturofilialsaida.AsCurrency := qryProdutosContratosTrocafuturofilialsaida.AsCurrency;

   qryProdutosTrocadossituacao.AsString := qryContratosTrocasituacao.AsString;
   qryProdutosTrocadoscomposto.AsBoolean := qryProdutosContratosTrocacomposto.AsBoolean;
   qryProdutosTrocadosvalorreducaobaseunitaria.AsCurrency := qryProdutosContratosTrocavalorreducaobaseunitaria.AsCurrency;

   qryProdutosTrocadosicmsmodalidade.AsInteger := qryProdutosContratosTrocaicmsmodalidade.AsInteger;
   qryProdutosTrocadosicmsmodsubst.AsInteger := qryProdutosContratosTrocaicmsmodsubst.AsInteger;

   qryProdutosTrocados.Post;
 end;

begin
 if qryProdutosTrocados.Locate('contrato;produto;filialsaida',
   Vararrayof([qryProdutosContratosTrocacontrato.AsString,
               qryProdutosContratosTrocaproduto.AsString,
               qryProdutosContratosTrocafilial.AsString]),[]) then
 begin
   if qryProdutosContratosTrocaDevolver.AsCurrency = 0 then
     qryProdutosTrocados.Delete
   else
   begin
     qryProdutosTrocados.Edit;
     GuardarProduto;
   end;
 end
 else
   if qryProdutosContratosTrocaDevolver.AsCurrency <> 0 then
   begin
     qryProdutosTrocados.Append;
     GuardarProduto;
   end;
end;

procedure TdtmTrocaMercadorias.AtribuirTrocaEfetuada(Todos: Boolean);
  procedure Alterar;
  begin
    if qryProdutosContratosTroca.Locate('contrato;produto;filial',
      VarArrayof([qryProdutosTrocadoscontrato.asstring,
                  qryProdutosTrocadosproduto.asstring,
                  qryProdutosTrocadosfilialsaida.asstring]),[]) then
    begin
      qryProdutosContratosTroca.Edit;
      qryProdutosContratosTrocadefeito.AsBoolean := qryProdutosTrocadosdefeito.AsBoolean;
      qryProdutosContratosTrocaDevolver.AsCurrency := qryProdutosTrocadosquantidade.AsCurrency;
      qryProdutosContratosTrocaqtdeentregueparadevolver.AsCurrency := qryProdutosTrocadosqtdeentregueparadevolver.AsCurrency;
    end;
  end;
begin
  RecuperandoTrocaEfetuada := true;
  if Todos then
  begin
    qryProdutosTrocados.First;
    while not qryProdutosTrocados.Eof do
    begin
      if ContratoIdentificado then
         Alterar;
      qryProdutosTrocados.Next;
    end;
  end
  else Alterar;

  if qryProdutosContratosTroca.State in [dsedit] then
    qryProdutosContratosTroca.Post;

  RecuperandoTrocaEfetuada := false;
end;

procedure TdtmTrocaMercadorias.qryProcuraClienteBeforeOpen(
  DataSet: TDataSet);
begin
  inherited;
  if (qryProcuraCliente.Params[0].AsString = '') then
    qryProcuraCliente.Params[0].AsString:= 'C';
end;

procedure TdtmTrocaMercadorias.qryDadosFiscaisBeforeClose(
  DataSet: TDataSet);
begin
  inherited;
  SalvarDadosFiscais;
end;

procedure TdtmTrocaMercadorias.SalvarDadosFiscais;
var
 i: integer;
begin
  if not qryDadosFiscaisCopia.Active then
    ReFazConsulta(qryDadosFiscaisCopia,[],[]);
  if qrydadosfiscais.Active then
  begin
    qrydadosfiscais.First;
    while not qrydadosfiscais.Eof do
    begin
      if qryDadosFiscaisCopia.Locate('filialnota;nota;filialcupom;maquina;intervensao;cupom;dadofiscal;serie;contrato;produto;filial',
      VarArrayOf([qryDadosFiscaisfilialnota.asstring,
                  qryDadosFiscaisnota.asstring,
                  qryDadosFiscaisfilialcupom.asString,
                  qryDadosFiscaismaquina.AsString,
                  qryDadosFiscaisintervensao.AsString,
                  qryDadosFiscaiscupom.AsString,
                  qryDadosFiscaisdadofiscal.AsString,
                  qryDadosFiscaisserie.AsString,
                  qryDadosFiscaiscontrato.asString,
                  qryDadosFiscaisproduto.asstring,
                  qryDadosFiscaisfilial.asstring]),[]) then
      begin
       qryDadosFiscaisCopia.Edit;
       qryDadosFiscaisCopiadevolver.AsCurrency := qryDadosFiscaisdevolver.AsCurrency;
       qryDadosFiscaisCopia.Post;
      end
      else
      begin
        qryDadosFiscaisCopia.Append;
        for i:=0 to qrydadosfiscais.FieldCount -1 do
          if qryDadosFiscaisCopia.Fields[i].FieldName = 'produto' then
           qrydadosfiscaiscopia.Fields[i].asString := qrydadosfiscais.Fields[i].asString
          else
           qrydadosfiscaiscopia.Fields[i].asVariant := qrydadosfiscais.Fields[i].asVariant;
        qrydadosfiscaisCopia.Post;
      end;
      qrydadosfiscais.Next;
    end;
  end;
end;

procedure TdtmTrocaMercadorias.qryDadosFiscaisAfterOpen(DataSet: TDataSet);
begin
  inherited;
  RecuperarDadosFiscais;
end;

procedure TdtmTrocaMercadorias.RecuperarDadosFiscais;
begin
  if not qryDadosFiscaisCopia.Active then
    ReFazConsulta(qryDadosFiscaisCopia,[],[]);
  qrydadosfiscais.First;
  while not qrydadosfiscais.Eof do
  begin
    if qryDadosFiscaisCopia.Locate('filialnota;nota;filialcupom;maquina;intervensao;cupom;dadofiscal;serie;contrato;produto;filial',
    VarArrayOf([qryDadosFiscaisfilialnota.asstring,
                qryDadosFiscaisnota.asstring,
                qryDadosFiscaisfilialcupom.asString,
                qryDadosFiscaismaquina.AsString,
                qryDadosFiscaisintervensao.AsString,
                qryDadosFiscaiscupom.AsString,
                qryDadosFiscaisdadofiscal.AsString,
                qryDadosFiscaisserie.AsString,
                qryDadosFiscaiscontrato.asString,
                qryDadosFiscaisproduto.asstring,
                qryDadosFiscaisfilial.asstring]),[]) then
    begin
     if (qryDadosFiscaisdevolver.AsCurrency <>
         qryDadosFiscaisCopiadevolver.AsCurrency) then
     begin
       qryDadosFiscais.Edit;
       qryDadosFiscaisdevolver.AsCurrency := qryDadosFiscaisCopiadevolver.AsCurrency;
       qryDadosFiscais.Post;
     end;
    end;
    qrydadosfiscais.Next;
  end;
end;



procedure TdtmTrocaMercadorias.qryContratosNewRecord(
  DataSet: TDataSet);
begin
  inherited;
  qryProcuraCliente.Params[1].AsString := 'C';
  qryContratosdata.AsDateTime       := DataServidor;
  qryContratosfilialvenda.AsInteger := FilialBase;
  qryContratosvalorvista.AsFloat    := 0;
  qryContratosvalorprazo.AsFloat    := 0;
  qryContratostaxajuros.AsFloat     := 0;
  SituacaoContrato                  := scORCADO;
  qryContratospessoatipo.AsString   := 'F';
  qryContratossexo.AsString         := 'M';
  qryContratoscivil.AsString        := 'S';
  qryContratosfonetipo.AsString     := 'P';
  qryContratosrestipo.AsString      := 'P';
  qryContratosreftipo.AsString      := 'P';
  qryContratosplano.AsInteger       := ParSistema.PlanoVendaVista;
  qryContratosagente.AsInteger      := qryPlanoPagamentoagente.AsInteger;

  FExisteMontagem                   := False;
  FExisteEntrega                    := False;
  FPermiteDesconto                  := True;
  if UsuarioLogin.Vendedor then
  begin
    if FVendedorDefault > 0 then
      qryContratosvendedor.AsInteger  := FVendedorDefault
  end
  else
  if (qryContratosTrocavendedor.AsInteger<>0) then
     qryContratosvendedor.AsInteger := qryContratosTrocavendedor.AsInteger;

  if Not UsuarioLogin.AlterarFilialVenda then
    qryContratosfilialvenda.AsInteger := FilialBase;
end;

function TdtmTrocaMercadorias.GetTabelaContratoTroca: TtecQuery;
begin
  Result:= qryContratosTroca;
end;

function TdtmTrocaMercadorias.IncluirContrato: Boolean;
begin
  SalvarDadosFiscais;
  qryContratos.Insert;
  if (qryContratosTrocacliente.AsInteger<>0) and
     (qryContratosTrocatipocliente.AsString<>'') then
  begin
    ReFazConsulta(qryProcuraCliente,[0,1],[qryContratosTrocacliente.AsInteger,qryContratosTrocatipocliente.AsString]);
    qryContratostipocliente.AsString := qryContratosTrocatipocliente.AsString;
    qryContratoscliente.AsInteger := qryContratosTrocacliente.AsInteger;
  end;
  ReFazConsulta(qryParcelas, [0], [qryContratosnumero.AsString]);
  ReFazConsulta(qryProdutosContratos, [0,1], [EstadoIcms, qryContratosnumero.AsString]);
  Result := True
end;

function TdtmTrocaMercadorias.GetEstadoIcms: String;
begin
  if qryContratosPESSOATIPO.AsString = 'J' then
     result := qryContratosEstado.AsString
  else
     result := EstadoFilialBase;
end;

procedure TdtmTrocaMercadorias.dsrContratosDataChange(Sender: TObject;
  Field: TField);
begin
  inherited;

  if Field = qryContratoscliente then begin
    if qryContratospessoatipo.AsString = 'J' then begin
      if not qryContratosrefrua.IsNull then
        qryContratosentrua.AsString       := qryContratosrefrua.AsString;
      if not qryContratosrefnumero.IsNull then
        qryContratosentnumero.AsString       := qryContratosrefnumero.AsString;
      if not qryContratosrefcomplemento.IsNull then
        qryContratosentcomplemento.AsString  := qryContratosrefcomplemento.AsString;
      if not qryContratosrefestado.IsNull then
        qryContratosentestado.AsString    := qryContratosrefestado.AsString;
      if not qryContratosrefcidade.IsNull then
        qryContratosentcidade.AsInteger        := qryContratosrefcidade.AsInteger;
      if not qryContratosrefbairro.IsNull then
        qryContratosentbairro.AsInteger        := qryContratosrefbairro.AsInteger;
      if not qryContratosrefcep.IsNull then
        qryContratosentcep.AsInteger           := qryContratosrefcep.AsInteger;
      if not qryContratosnomecidadereferencia.IsNull then
        qryContratosnomecidadeentrega.AsString := qryContratosnomecidadereferencia.AsString;
      if not qryContratosnomebairroreferencia.IsNull then
        qryContratosnomebairroentrega.AsString := qryContratosnomebairroreferencia.AsString;
    end else begin
      qryContratosentrua.Clear;
      qryContratosentnumero.Clear;
      qryContratosentcomplemento.Clear;
      qryContratosentestado.Clear;
      qryContratosentcidade.Clear;
      qryContratosentbairro.Clear;
      qryContratosentcep.Clear;
      qryContratosnomecidadeentrega.Clear;
      qryContratosnomebairroentrega.Clear;
    end;
  end;

end;

procedure TdtmTrocaMercadorias.qryContratosclienteChange(
  Sender: TField);
begin
  inherited;
  if qryProcuraCliente.Recordcount > 0 then begin
    qryContratostipocliente.AsString := qryProcuraClientetipo.AsString;
    if qryProcuraClientetipo.AsString = 'C' then
      RefazConsulta(qryClientes,[0],[qryProcuraClientecodigo.AsInteger])
    else
      ReFazConsulta(qryFornecedores,[0],[qryProcuraClientecodigo.AsInteger]);
    AtribuirClienteNoContrato;
  end;
end;

procedure TdtmTrocaMercadorias.AtribuirClienteNoContrato;
begin
  if qryProcuraClientetipo.AsString = 'C' then
     AtribuirQuery(qryContratos, qryClientes)
  else
    if qryProcuraClientetipo.AsString = 'F' then
       AtribuirFornecedorNoContrato
end;

procedure TdtmTrocaMercadorias.AtribuirQuery(qr1, qr2: TtecQuery);
var
  a: Integer;
begin
  if (qr1 = qryContratos) and (qr2 = qryClientes) then
  begin
    for a := 1 to qr2.Fields.Count - 1 do
      qr1.Fields[a + 40].Value := qr2.Fields[a].Value
  end;
end;

procedure TdtmTrocaMercadorias.AtribuirFornecedorNoContrato;
begin
  qryContratosnome.AsString         := qryFornecedoresnome.AsString;
  qryContratospessoatipo.AsString   := qryFornecedorespessoatipo.AsString;
  qryContratospessoanumero.AsString := qryFornecedorespessoanumero.AsString;
  qryContratosendnumero.AsString    := qryFornecedoresnumero.AsString;
  qryContratosendcomplemento.AsString := qryFornecedorescomplemento.AsString;
  qryContratosrua.AsString          := qryFornecedoresrua.AsString;
  qryContratosestado.AsString       := qryFornecedoresestado.AsString;
  qryContratoscidade.AsInteger      := qryFornecedorescidade.AsInteger;
  qryContratoscidadeibge.AsString   := qryFornecedorescodigoibge.AsString;
  qryContratosbairro.AsInteger      := qryFornecedoresbairro.AsInteger;
  qryContratoscep.AsInteger         := qryFornecedorescep.AsInteger;
  qryContratosfoneddd.AsVariant     := qryFornecedoresfoneddd.AsVariant;
  qryContratosfonenumero.AsVariant  := qryFornecedoresfonenumero.AsVariant;
  if Not qryContratosfonenumero.IsNull then
    qryContratosfonetipo.AsString   := 'P';
  qryContratosobservacoes.AsString  := qryFornecedoresobservacoes.AsString;
  qryContratosemail.AsString        := qryFornecedoresemail.AsString;
  qryContratosnomecidade.AsString   := qryFornecedoresnomecidade.AsString;
  qryContratosnomebairro.AsString   := qryFornecedoresnomebairro.AsString;


  qryContratossexo.AsString           := 'E';
  qryContratoscivil.AsString          := 'O';
  qryContratosrestipo.AsString        := 'P';
  qryContratosreftipo.AsString        := 'P';
  qryContratosempcomprovado.AsBoolean := False;
  qryContratoscartaocredito.AsBoolean := False;
  qryContratoscartaoloja.AsBoolean    := False;
  qryContratoscheque.AsBoolean        := False;
  qryContratoschequeespecial.AsBoolean:= False;
  qryContratosautomovel.AsBoolean     := False;

end;

function TdtmTrocaMercadorias.EditarProdutosContrato: Boolean;
begin
  if qryProdutosContratos.IsEmpty then begin
    IncluirProdutosContrato;
    Result:= True;
  end else begin
    RefazConsulta(qryEstoque,[0],[IntToStr(qryProdutosContratosproduto.AsLargeInt)]);
    if Parsistema.MostrarSimilaresContrato then
      ReFazConsulta(qryProdutosSimilares,[0,1],[qryProdutosContratosproduto.AsVariant, ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual)]);
    if (ParSistema.FiliaisIndependentes) then begin
      qryProcuraProduto.MacroByName('filialsaida').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
      qryProcuraProduto.ParamByName('FilialPreco').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual);
    end else begin
      qryProcuraProduto.MacroByName('filialsaida').AsString := qryProdutosContratosfilial.AsString;
      if ParSistema.UtilizarPrecoFilialBase then
        qryProcuraProduto.ParamByName('FilialPreco').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual)
      else
        qryProcuraProduto.ParamByName('FilialPreco').AsString := qryProdutosContratosfilial.AsString;
    end;
    if qryProdutosContratos.RecordCount = 0 then begin
      LerProdutosFiliaisIncluidos(True);
      qryProdutosContratos.Append;
    end else begin
      LerProdutosFiliaisIncluidos(False);
      qryProdutosContratos.Edit;
      qryProdutosContratos.Cancel;
    end;
    if ParSistema.UtilizarPrecoFilialBase then
      RefazConsulta(qryProdutoEstoque,[2,1,5],[ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual),
                                               IntToStr(qryProdutosContratosproduto.AsLargeInt),
                                               qryProdutosContratosfilial.AsInteger])
    else
      RefazConsulta(qryProdutoEstoque,[2,1,5],[qryProdutosContratosfilial.AsInteger,
                                               IntToStr(qryProdutosContratosproduto.AsLargeInt),
                                               qryProdutosContratosfilial.AsInteger]);
    Result:= True;
  end;
end;

function TdtmTrocaMercadorias.IncluirProdutosContrato: Boolean;
begin
  LerProdutosFiliaisIncluidos(True);
  qryProdutosContratos.Append;
  FInseriuProduto   := True;
  FRegistrosMarcados:= 0;
  Result := True
end;

procedure TdtmTrocaMercadorias.LerProdutosFiliaisIncluidos(
  Incluindo: Boolean);
var
  Pos: TBookmark;
  a, Filial: Integer;
  Prod: Int64;
begin
  if Not UsuarioLogin.Vendedor then begin
    qryProcuraReservaProduto.Params[0].AsInteger   := qryProcuraVendedorcodigo.AsInteger;
    qryConsultaReservasProduto.Params[0].AsInteger := qryProcuraVendedorcodigo.AsInteger;
  end;
  if Incluindo then begin
    qryConsultaFilialProduto.Params[0].AsString := '0';
    qryProcuraFilialProduto.Params[1].AsString  := '0';
  end else begin
    qryConsultaFilialProduto.Params[0].AsString := inttostr(qryProdutosContratosproduto.AsLargeInt);
    qryProcuraFilialProduto.Params[1].AsString  := inttostr(qryProdutosContratosproduto.AsLargeInt);
  end;
  if Incluindo or qryProdutosContratosreserva.IsNull then begin
    qryProcuraReservaProduto.Sql[13]   := '';
    qryConsultaReservasProduto.Sql[13] := '';
  end else begin
    qryProcuraReservaProduto.Sql[13]   := 'or (r.numero = '+ qryProdutosContratosreserva.AsString + ')';
    qryConsultaReservasProduto.Sql[13] := 'or (r.numero = '+ qryProdutosContratosreserva.AsString + ')';
    qryProcuraReservaProduto.Params[2].AsString    := inttostr(qryProdutosContratosproduto.AsLargeInt);
    qryProcuraReservaProduto.Params[3].AsInteger   := qryProdutosContratosfilial.AsInteger;
    qryConsultaReservasProduto.Params[2].AsInteger := qryProdutosContratosfilial.AsInteger;
    qryConsultaReservasProduto.Params[1].AsString  := inttostr(qryProdutosContratosproduto.AsLargeInt);
  end;
  Pos := qryProdutosContratos.GetBookmark;
  qryProdutosContratos.DisableControls;
  try
    a := 0;
    aProdFilial := nil;
    Prod   := qryProdutosContratosproduto.AsLargeInt;
    Filial := qryProdutosContratosfilial.AsInteger;
    qryProdutosContratos.First;
    while Not qryProdutosContratos.Eof do begin
      if Incluindo or ((Prod <> qryProdutosContratosproduto.AsLargeInt) or
                       (Filial <> qryProdutosContratosfilial.AsInteger))
      then begin
        SetLength(aProdFilial, a + 1);
        aProdFilial[a].Prod   := qryProdutosContratosproduto.AsString;
        aProdFilial[a].Filial := qryProdutosContratosfilial.AsString;
        Inc(a);
      end;
      qryProdutosContratos.Next;
    end;
  finally
    qryProdutosContratos.GotoBookmark(Pos);
    qryProdutosContratos.FreeBookmark(Pos);
    qryProdutosContratos.EnableControls;
  end;
  FiltrarProdutosEFiliaisContratos;

end;

procedure TdtmTrocaMercadorias.FiltrarProdutosEFiliaisContratos;
const
  SQLStr = ' and (%s)';
var
  SQLP, SQLF: String;
  a: Integer;
begin
  inherited;
  for a := 0 to High(aProdFilial) do begin
    SQLP := SQLP +
    '((p.codigo <> ' + aProdFilial[a].Prod +') or ' +
    '(e.filial <> ' + aProdFilial[a].Filial + ')) and ';
    SQLF := SQLF +
    '((e.produto <> ' + aProdFilial[a].Prod +') or ' +
    '(e.filial <> ' + aProdFilial[a].Filial + ')) and ';
  end;
  if SQLP = '' then begin
    qryProcuraProduto.MacroByName('FiltrarProdutosEFiliaisContratos').AsString       := '';
    qryConsultaProdutos.MacroByName('filialeContratos').AsString     := '';
  end else begin
    Delete(SQLP, Length(SQLP)-4, 5);
    qryProcuraProduto.MacroByName('FiltrarProdutosEFiliaisContratos').AsString := Format(SQLStr, [SQLP]);
    qryConsultaProdutos.MacroByName('filialeContratos').AsString := Format(SQLStr, [SQLP]);
  end;
  if SQLF = '' then begin
    qryConsultaFilialProduto.MacroByName('ListaProdutosJaCadastrados').asstring := '';
    qryProcuraFilialProduto.MacroByName('ListaProdutosJaCadastrados').asstring := '';
  end else begin
    Delete(SQLF, Length(SQLF)-4, 5);
    qryConsultaFilialProduto.MacroByName('ListaProdutosJaCadastrados').asstring := Format(SQLStr, [SQLF]);;
    qryProcuraFilialProduto.MacroByName('ListaProdutosJaCadastrados').asstring := Format(SQLStr, [SQLF]);
  end;
end;

procedure TdtmTrocaMercadorias.CalcularValorTotalProdutos;
var
  Pos: TBookmark;
  QtdadeTotal,
  Preco,
  Produto,
  QTdeProdutos: Real;
begin
  Pos := qryProdutosContratos.GetBookmark;
  qryProdutosContratos.DisableControls;
  Produto         := 0;   QtdeProdutos := 0;
  FPermiteDesconto:= True;
  FExisteMontagem := False;
  FExisteEntrega  := False;
  try
    qryProdutosContratos.First;
    while Not qryProdutosContratos.Eof do begin
      if Not qryProdutosContratosbrinde.AsBoolean then begin
        Preco    := qryProdutosContratosprecovenda.AsFloat;
        QtdadeTotal := qryProdutosContratosquantidade.AsCurrency;
        QtdeProdutos:= QtdeProdutos + qryProdutosContratosquantidade.AsCurrency;
        Produto := Produto + (QtdadeTotal * Preco);
      end;
      if qryProdutosContratosmontagem.AsString = 'S' then
        FExisteMontagem := True;
      if qryProdutosContratosentrega.AsString = 'S' then
        FExisteEntrega := True;
      if qryProdutosContratospromocao.AsBoolean then
        FPermiteDesconto:= False;
      qryProdutosContratos.Next
    end;
    if Not FExisteMontagem then
      qryContratosmontagemfilial.Clear;
  finally
    qryContratostotalprodutos.AsFloat := Produto;
    qryContratosTotalQtdeProdutos.AsCurrency := QtdeProdutos;
    qryProdutosContratos.GotoBookmark(Pos);
    qryProdutosContratos.FreeBookmark(Pos);
    qryProdutosContratos.EnableControls;
  end
end;

