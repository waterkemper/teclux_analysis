function TdtmTrocaMercadorias.VerificarSerieFilial: Boolean;
begin
  ReFazConsulta(qryNumeroNota, [0, 1], [FilialBase, SerieSugestao]);
  if qryNumeroNota.RecordCount = 0 then begin
    MensagemAviso(format(ctFILIALSEMSERIE, [FilialBase, 'mercadorias']));
    Result := False;
  end else if qryNumeroNotamodelonota.IsNull then begin
    MensagemAviso(ctSERIESUGESTAOSEMMODELO);
    Result := False;
  end else
    Result := True;
end;

{
procedure TdtmTrocaMercadorias.ExisteProdutoEmitirNota;
begin
  if qryContratosTrocasituacao.AsString = 'F' then
    TemProdutoImprimirNota:= False
  else begin
    TemProdutoImprimirNota:=  False;
    qryProdutosContratosTroca.First;
    while not qryProdutosContratosTroca.Eof do begin
      TemProdutoImprimirNota:= ((qryProdutosContratosTrocaqtdeentregueParaDevolver.AsInteger > 0) or
                                 TemProdutoImprimirNota);
      qryProdutosContratosTroca.Next;
    end;
  end;
end;
}


