function TdtmTrocaMercadorias.PermitirVendaSemEstoque: Boolean;
var
  UsrAut: TtecUsuarios;
  Complemento: String;
begin
  if ParSistema.SolicitarAutorizacaoVendaFutura or Not UsuarioLogin.GerenteEstoque then begin
    Complemento := Format(ctSEMESTOQUESEMVENDA, [qryProdutosContratosproduto.AsString, qryProdutosContratosfilial.AsString]);
    UsrAut := ObterAutorizacao(taLOGIN, ctVENDASEMESTOQUE, ctGERENTEESTOQUE, Complemento);
    Result := Assigned(UsrAut) and UsrAut.GerenteEstoque;
    if Assigned(UsrAut) and Not UsrAut.GerenteEstoque then begin
      MensagemAviso(ctUSUARIOSEMPERMISSAO);
      Result := False
    end
  end else
    Result := True
end;

