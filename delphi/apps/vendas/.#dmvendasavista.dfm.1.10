  object qryProdutosSimilares: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select  p.codigo,'
      '           e.filial'
      'from produtos p, estoques e'
      'where (p.caracteristica in (select similares.similar'
      '                                          from similares'
      
        '                                          where similares.caract' +
        'eristica = (Select p1.caracteristica '
      
        '                                                                ' +
        '                              From produtos p1 '
      
        '                                                                ' +
        '                              Where p1.codigo =:produto))) and'
      '          (p.inativo is null)          and'
      '          (p.codigo = e.produto) and'
      '          /*             Produtos      */'
      '          (estoques_preco(p.codigo, e.filial) > 0) and'
      '          (e.emestoque > 0)'
      'order by UPPER(TO_ASCII(p.descricao,'#39'LATIN1'#39'))'
      '')
    RequestLive = False
