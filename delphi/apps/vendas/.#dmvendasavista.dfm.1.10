  object qryProcuraCliente: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryProcuraClienteAfterOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '; SELECT * FROM ('
      'select coalesce(v.razao,v.nome) as nome,'
      '         v.pessoatipo,'
      '         v.pessoanumero,v.inscricaoestadual,'
      '         v.codigo,'
      '         v.civil,'
      '         v.rua,'
      '         v.numero,'
      '         v.complemento,'
      '         v.bairro,'
      '         v.cidade,'
      '         v.estado,'
      '         v.cep,'
      '         v.foneddd,'
      '         v.fonenumero,'
      '         v.foneramal,'
      
        '         (select c.fone2ddd    from clientes c where c.codigo = ' +
        'v.codigo and '#39'C'#39' = v.tipo) as fone2ddd,'
      
        '         (select c.fone2numero from clientes c where c.codigo = ' +
        'v.codigo and '#39'C'#39' = v.tipo) as fone2numero,'
      
        '         (select c.fone2ramal  from clientes c where c.codigo = ' +
        'v.codigo and '#39'C'#39' = v.tipo) as fone2ramal,'
      '         v.tipo as tipoorig,'
      '         (select b.nome'
      '          from bairros b'
      '          where (b.codigo = v.bairro) and'
      '                    (b.cidade = v.cidade) and'
      '                    (b.estado = v.estado)'
      '         ) as nomebairro,'
      '         (select c.nome'
      '          from cidades c'
      '          where (c.codigo = v.cidade) and'
      '                    (c.estado = v.estado)'
      '         ) as nomecidade,'
      '         (select c.descricao'
      '          from conceitos c'
      '          where c.codigo = v.conceito) as descricaoconceito,'
      '         (select c.restricoes'
      '          from conceitos c'
      '          where c.codigo = v.conceito) as restricoesconceito,'
      
        '         case when v.tipo = '#39'C'#39' then (select c.sexo from cliente' +
        's c where c.codigo = :codigo)'
      '              else '#39'E'#39
      '         end as sexo,'
      
        '         case when v.tipo = '#39'C'#39' then (select c.naoexibirfichafin' +
        'anceira from clientes c where c.codigo = :codigo)'
      '              else false'
      '         end as naoexibirfichafinanceira'
      'from   vfornecedores v'
      'where (v.codigo =:codigo) and'
      '           (v.tipo =:tipo)'
      ') AS Procura           '
      'order by UPPER(TO_ASCII(nome,'#39'LATIN1'#39'))')
    RequestLive = False
    Left = 406
    Top = 66
    ParamData = <
      item
        DataType = ftString
        Name = 'codigo'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'tipo'
        ParamType = ptUnknown
      end>
