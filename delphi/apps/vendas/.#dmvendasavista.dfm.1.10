    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';SELECT * FROM (Select coalesce(v.razao,v.nome) as nome,'
      '           formatar_cpf_cnpj(v.pessoanumero) as pessoanumero,'
      '           v.codigo,'
      '           v.estado,'
      '           v.rua, v.numero, v.complemento,'
      '           v.tipo,'
      '           descricao_tipocliente(v.tipo) as tipocliente,'
      '           c.nome as nomecidade'
      'From   vfornecedores v, cidades c'
      '/*  Preenchida em RunTime  */ Where false'
      '    and (v.tipo <> '#39'L'#39') '
      '    and (v.estado = c.estado)'
      '    and (v.cidade = c.codigo)'
      ') AS Consulta    '
      'Order by UPPER(TO_ASCII(nome,'#39'LATIN1'#39'))')
    RequestLive = False
    Left = 710
    Top = 69
