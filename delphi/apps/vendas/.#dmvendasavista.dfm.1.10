  object qryConsultaReservasProduto: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select r.numero,'
      '          r.data,'
      '          r.cliente,'
      
        '          (select p.descricao from produtos p where p.codigo = p' +
        'r.produto) as descricao,'
      
        '          (select p.valorgrade1 from produtos p where p.codigo =' +
        ' pr.produto) as valorgrade1,'
      
