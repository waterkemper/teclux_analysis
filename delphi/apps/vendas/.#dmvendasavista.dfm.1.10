    Macros = <>
    Sql.Strings = (
      'select u.nome,'
      '       u.codigo'
      'from usuarios u'
      'where u.venda or'
      '     (select gu.vendedor'
      '      from gruposusuarios gu'
      '      where gu.codigo = u.grupo)'
      'order by UPPER(TO_ASCII(u.nome,'#39'LATIN1'#39'))')
