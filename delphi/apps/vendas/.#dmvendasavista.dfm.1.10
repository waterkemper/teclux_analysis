  object qryContratos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryContratosBeforeOpen
    AfterOpen = qryContratosAfterOpen
    BeforeClose = qryContratosBeforeClose
    AfterClose = qryContratosAfterClose
    AfterCancel = qryContratosAfterCancel
    OnNewRecord = qryContratosNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select c.numero,'
      '           c.data, c.iddocumento,'
      '           c.faturamento,'
      '           c.cliente,'
      '           c.tipocliente,'
      '           c.vendedor,'
      '           c.filialvenda,'
      '           c.valorvista,'
      '           c.valorprazo,'
      '           0.00 as totalprodutos,'
      
        '           c.desconto, case when c.valorprazo<>0 then ((c.descon' +
        'to*100)/c.valorprazo) end as percentualdesconto,'
      '           c.frete,'
      '           c.seguro,'
      '           c.montagemfilial,'
      '           c.situacao,'
      '           c.nome,'
      '           c.pessoatipo,'
      '           c.pessoanumero,'
      '           c.sexo,'
      '           c.rua,'
      '           c.endnumero,'
      '           c.endcomplemento,'
      '           c.bairro,'
      '           c.cidade,'
      '           c.estado,'
      '           c.cep,'
      '           c.civil,'
      '           c.fonetipo,'
      '           c.restipo,'
      '           c.reftipo,'
      '           c.agente,'
      '           c.plano,'
      '           c.empcomprovado,'
      '           c.automovel,'
      '           c.cartaocredito,'
      '           c.cartaoloja,'
      '           c.cheque,'
      '           c.chequeespecial,'
      '           c.listacasamento,'
      '           c.observacoes,'
      '           c.consideracoes,'
      '           c.montagemobs,'
      '           c.taxajuros,'
      '           c.foneddd,'
      '           c.fonenumero,'
      '           c.foneramal,'
      '           c.fone2ddd,'
      '           c.fone2numero,'
      '           c.fone2ramal,'
      '           (select b.nome from bairros b'
      
        '            where (b.estado = c.estado) and (b.cidade = c.cidade' +
        ') and (b.codigo = c.bairro)'
      '           ) as nomebairro,'
      '           (select c.nome from cidades d'
      
        '            where (d.estado = c.estado) and (d.codigo = c.cidade' +
        ')'
      
        '           ) as nomecidade, c.creditotroca, cast(0.00 as numeric' +
        '(9,3)) as totalqtdeprodutos,'
      
        '           c.nrpontos, c.limitecredito, c.limitedisponivel, c.li' +
        'miteparcela, c.aberto30dias'
      'From   contratos c'
      'Where '
      '/*            Preenchido em RunTime    */'
      '/*            Preenchido em Run Time   */'
      
        '            ((Select count(s.contrato) From servicoscontratos s ' +
        'Where s.contrato = c.numero) = 0) and '
      
        '             not exists (select pc.contrato from produtoscontrat' +
        'os pc where pc.contrato = c.numero and coalesce(pc.cancelado,0)<' +
        '>0) and'
      '             contratos_nenhumpagamento(c.numero) and'
      '            (c.numero =:numero)')
    RequestLive = True
    Left = 558
    Top = 187
    ParamData = <
      item
        DataType = ftString
        Name = 'numero'
        ParamType = ptUnknown
      end>
