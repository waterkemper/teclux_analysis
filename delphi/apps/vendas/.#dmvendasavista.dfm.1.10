  object qryEstoqueBloqueio: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select e.produto,'
      '         e.filial,'
      '         (select m.emestoque'
      '          from movimentos m'
      '          where m.numero = (select m2.numero'
      '                            from movimentos m2,'
      '                            ('
      '                             (select Max(m1.data) as data'
      '                              from movimentos m1'
      '                              where (m1.produto = e.Produto) and'
      '                                    (m1.filial  = e.Filial))'
      '                             ) as m1'
      '                             where m2.produto = e.produto'
      '                               and m2.filial = e.filial'
      '                               and m2.data = m1.data'
      '                             order by m2.lancto desc limit 1)'
      '         ) as emestoque,'
      ''
      '         (select m.reservado'
      '          from movimentos m'
      '          where m.numero = (select m2.numero'
      '                            from movimentos m2,'
      '                            ('
      '                             (select Max(m1.data) as data'
      '                              from movimentos m1'
      '                              where (m1.produto = e.Produto) and'
      '                                    (m1.filial  = e.Filial))'
      '                             ) as m1'
      '                             where m2.produto = e.produto'
      '                               and m2.filial = e.filial'
      '                               and m2.data = m1.data'
      '                             order by m2.lancto desc limit 1)'
      '         ) as reservado,'
      ''
      '         (select m.futuro'
      '          from movimentos m'
      '          where m.numero = (select m2.numero'
      '                            from movimentos m2,'
      '                            ('
      '                             (select Max(m1.data) as data'
      '                              from movimentos m1'
      '                              where (m1.produto = e.Produto) and'
      '                                    (m1.filial  = e.Filial))'
      '                             ) as m1'
      '                             where m2.produto = e.produto'
      '                               and m2.filial = e.filial'
      '                               and m2.data = m1.data'
      '                             order by m2.lancto desc limit 1)'
      '         ) as futuro,'
      ''
      
        '         (select case when (m.financeiro = 0) or (m.financeiro i' +
        's null)'
      '                             then 0'
      '                     else'
      
        '                        m.financeiro/(m.emestoque+m.reservado+m.' +
        'transito+m.demonstracao+m.conserto+m.danificada)'
      '                     end'
      '          from movimentos m'
      '          where m.numero = (select m2.numero'
      '                            from movimentos m2,'
      '                            ('
      '                             (select Max(m1.data) as data'
      '                              from movimentos m1'
      '                              where (m1.produto = e.Produto) and'
      '                                    (m1.filial  = e.Filial))'
      '                             ) as m1'
      '                             where m2.produto = e.produto'
      '                               and m2.filial = e.filial'
      '                               and m2.data = m1.data'
      '                             order by m2.lancto desc limit 1)'
      '         ) as customedio'
      ''
      'from estoques e'
      'where'
      ''
      'for update')
    RequestLive = False
    Left = 65
    Top = 354
    object qryEstoqueBloqueioproduto: TLargeintField
      FieldName = 'produto'
      DisplayFormat = '0'
    end
    object qryEstoqueBloqueiofilial: TIntegerField
      FieldName = 'filial'
      DisplayFormat = '0'
    end
    object qryEstoqueBloqueioemestoque: TFloatField
      FieldName = 'emestoque'
      DisplayFormat = '0'
    end
    object qryEstoqueBloqueioreservado: TFloatField
      FieldName = 'reservado'
      DisplayFormat = '0'
