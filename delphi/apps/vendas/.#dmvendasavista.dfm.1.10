    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select l.*'
      'from'
      
        '(Select (Select c1.nome From clientes c1 Where (c1.codigo = noiv' +
        'a)) as nomenoiva,'
      
        '           (Select c2.nome From clientes c2 Where (c2.codigo = n' +
        'oivo)) as nomenoivo,'
      '           cast(to_char(data,'#39'dd/mm/yyyy'#39') as varchar) as data,'
      '           codigo'
      'From   listascasamento'
      'Where (data > current_date)'
      ') as l'
      'Order By UPPER(TO_ASCII(l.nomenoiva,'#39'LATIN1'#39'))')
    RequestLive = False
    Left = 711
    Top = 117
