  object qryConsultaVendas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select c.nome,'
      '           formatar_cpf_cnpj(c.pessoanumero) as pessoanumero,'
      '           c.numero,'
      '           c.data,'
      '           cast (case when c.situacao = '#39'F'#39' then '#39'F - FATURADO'#39
      
        '                            when c.situacao = '#39'N'#39' then '#39'N - NOTA' +
        ' FISCAL'#39
      
        '                            when c.situacao = '#39'P'#39' then '#39'P - NOTA' +
        ' PARCIAL'#39
      '                    end as varchar) as situacao'
      'From contratos c'
      'Where (c.cliente = :cliente)  '
      '           /*  Preenchida em RunTime   */'
      '           /*  Treenchido em Run Time  */'
      '           /*  Preenchida em RunTime   */'
      
        '          and ((Select count(s.contrato) From servicoscontratos ' +
        's Where s.contrato = c.numero) = 0)'
      
        '          and not exists (select pc.contrato from produtoscontra' +
        'tos pc where pc.contrato = c.numero and coalesce(pc.cancelado,0)' +
        '<>0)'
      '          and contratos_nenhumpagamento(c.numero)'
      'Order by UPPER(TO_ASCII(c.nome,'#39'LATIN1'#39'))')
    RequestLive = False
    Left = 710
    Top = 173
    ParamData = <
      item
        DataType = ftInteger
        Name = 'Cliente'
        ParamType = ptUnknown
      end>
    object qryConsultaVendasnome: TStringField
      DisplayLabel = 'Nome'
      FieldName = 'nome'
      Size = 40
    end
    object qryConsultaVendaspessoanumero: TStringField
      DisplayLabel = 'CPF/CNPJ'
      FieldName = 'pessoanumero'
      Size = 18
    end
    object qryConsultaVendasnumero: TStringField
      DisplayLabel = 'Contrato'
      FieldName = 'numero'
      Required = True
      Size = 18
    end
    object qryConsultaVendasdata: TDateField
      DisplayLabel = 'Data'
      FieldName = 'data'
      Required = True
    end
  end
  object qryConsultaProdutos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryConsultaProdutosAfterOpen
    AfterClose = qryConsultaProdutosAfterOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select produtos.*'
      'from'
      '('
      'select descricao, valorgrade1, valorgrade2,'
      '       codigo,'
      '       filial,'
      '       emestoque,'
      '       reservado,'
      '       unidade,'
      '       brinde,'
      '       case when coalesce(valorproduto,0)=0 then'
      '        (SELECT valor'
      '         FROM colunasprecos'
      
        '         WHERE (colunasprecos.caracteristica = temp.caracteristi' +
        'ca) AND'
      '               (colunasprecos.preco = temp.preco) AND'
      '               (colunasprecos.coluna = temp.preconormal))'
      '       else'
      '         coalesce(temp.valorproduto,0)'
      '       end as valorproduto'
      'from'
      ' ('
      ' select p.descricao, p.valorgrade1, p.valorgrade2,'
      '       p.codigo,'
      '       p.caracteristica,'
      '       p.preco,'
      '       e.filial,'
      '       e.emestoque,'
      '       e.reservado,'
      '       c.unidade,'
      '       c.brinde,'
      '       f.preconormal,'
      '       case when f.precopromocao is not null then'
      '        (SELECT valor'
      '         FROM colunasprecos'
      
        '         WHERE (colunasprecos.caracteristica = p.caracteristica)' +
        ' AND'
      '               (colunasprecos.preco = p.preco) AND'
      '               (colunasprecos.coluna = f.precopromocao) AND'
      '               (colunasprecos.validade >= now()))'
      '       end as valorproduto'
      'from estoques e, produtos p, caracteristicas c, filiais f'
      'where (e.produto = p.codigo) and'
      '      (p.caracteristica = c.codigo) and'
      '      (e.filial = f.codigo) and'
      '      ((p.inativo is null ) or (p.inativo>current_date))'
      '/* Editado em Runtime */'
      '/* Editado em Runtime */'
      '/* Lista de Casamentos */'
      ''
      ' ) as temp'
      ') as produtos'
      'where (valorproduto > 0) '
      'and false'
      
        'order by UPPER(TO_ASCII(descricao,'#39'LATIN1'#39')), valorgrade1, valor' +
        'grade2')
    RequestLive = False
    Left = 65
    Top = 126
    object qryConsultaProdutosdescricao: TStringField
      DisplayLabel = 'Descri'#231#227'o'
      FieldName = 'descricao'
      Size = 40
    end
