end;

procedure TdtmVendasAVista.LerProdutosFiliaisIncluidos(Incluindo: Boolean);
var
  Pos: TBookmark;
  a, Filial: Integer;
  Prod: Int64;
begin
  inherited;
  SelecionarProdutosListaCasamento(Incluindo, qryProdutosContratosprodutolista.AsBoolean);
  if Not UsuarioLogin.Vendedor then begin
    qryProcuraReservaProduto.Params[0].AsInteger   := qryProcuraVendedorcodigo.AsInteger;
    qryConsultaReservasProduto.Params[0].AsInteger := qryProcuraVendedorcodigo.AsInteger;
  end;
  if Incluindo then begin
    qryConsultaFilialProduto.Params[0].AsInteger := 0;
    qryProcuraFilialProduto.Params[1].AsInteger  := 0;
  end else begin
    qryConsultaFilialProduto.Params[0].AsString := inttostr(qryProdutosContratosproduto.AsLargeInt);
    qryProcuraFilialProduto.Params[1].AsString  := inttostr(qryProdutosContratosproduto.AsLargeInt);
  end;
  if Incluindo or qryProdutosContratosreserva.IsNull then begin
    qryProcuraReservaProduto.Sql[13]   := '';
    qryConsultaReservasProduto.Sql[13] := '';
  end else begin
    qryProcuraReservaProduto.Sql[13]   := 'or (r.numero = '+ qryProdutosContratosreserva.AsString + ')';
    qryConsultaReservasProduto.Sql[13] := 'or (r.numero = '+ qryProdutosContratosreserva.AsString + ')';
    qryProcuraReservaProduto.Params[2].AsString    := IntToStr(qryProdutosContratosproduto.AsLargeInt);
    qryProcuraReservaProduto.Params[3].AsInteger   := qryProdutosContratosfilial.AsInteger;
    qryConsultaReservasProduto.Params[1].AsString  := IntToStr(qryProdutosContratosproduto.AsLargeInt);
    qryConsultaReservasProduto.Params[2].AsInteger := qryProdutosContratosfilial.AsInteger;
  end;
  Pos := qryProdutosContratos.GetBookmark;
  qryProdutosContratos.DisableControls;
  try
    a := 0;
    aProdFilial := nil;
    Prod   := qryProdutosContratosproduto.AsLargeInt;
    Filial := qryProdutosContratosfilial.AsInteger;
    qryProdutosContratos.First;
    while Not qryProdutosContratos.Eof do begin
      if Incluindo or ((Prod <> qryProdutosContratosproduto.AsLargeInt) or
                       (Filial <> qryProdutosContratosfilial.AsInteger))
      then begin
        SetLength(aProdFilial, a + 1);
        aProdFilial[a].Prod   := qryProdutosContratosproduto.AsString;
        aProdFilial[a].Filial := qryProdutosContratosfilial.AsString;
        Inc(a);
      end;
      qryProdutosContratos.Next;
    end;
  finally
    qryProdutosContratos.GotoBookmark(Pos);
    qryProdutosContratos.FreeBookmark(Pos);
    qryProdutosContratos.EnableControls;
  end;
  FiltrarProdutosEFiliaisContratos;
end;

function TdtmVendasAVista.LerProdutosSimilares: Boolean;
const
  SQLStr = ' and (%s)';
var
  WhereSQL,
  SQLP{, SQLF}: String;
  a, Fil: Integer;
  Prod: Int64;
  Pos: TBookmark;
begin
  Pos:= qryProdutosContratos.GetBookmark;
  qryProdutosContratos.DisableControls;
  try
    WhereSQL:= '';
    qryProdutosContratos.First;
    while not qryProdutosContratos.Eof do begin
      WhereSQL := WhereSQL +
                 '((e.produto <> ' + qryProdutosContratosproduto.AsString + ')or' +
                 '(e.filial <> '  + qryProdutosContratosfilial.AsString  + '))and';
      qryProdutosContratos.Next
    end;
  finally
    qryProdutosContratos.GotoBookmark(Pos);
    qryProdutosContratos.FreeBookmark(Pos);
    qryProdutosContratos.EnableControls;
  end;
  Delete(WhereSQL,Length(WhereSQL)-2,3);
  qryProdutosSimilares.Sql[10]:= WhereSQL + ' and';

  a := 0;
  ReFazConsulta(qryProdutosSimilares,[0],[IntToStr(qryProdutosContratosproduto.AsLargeInt)]);
  if qryProdutosSimilares.RecordCount = 0 then
    Result := False
  else begin
    SetLength(aProdFilial, qryProdutosSimilares.RecordCount);
    qryProdutosSimilares.First;
    Prod := qryProdutosSimilarescodigo.AsLargeInt;
    fil  := qryProdutosSimilaresfilial.AsInteger;
    while Not qryProdutosSimilares.Eof do begin
      aProdFilial[a].Prod   := qryProdutosSimilarescodigo.AsString;
      aProdFilial[a].Filial := qryProdutosSimilaresfilial.AsString;
      qryProdutosSimilares.Next;
      Inc(a);
    end;
    if qryProdutosSimilares.Locate('filial',FilialBase,[]) or (ParSistema.FiliaisIndependentes) then begin
      qryProcuraProduto.Params[4].AsString := IntToStr(FilialBase);
      Fil:= FilialBase;
    end else
      qryProcuraProduto.Params[4].AsString := IntToStr(Fil);
    qryProdutosSimilares.Close;

    for a := 0 to High(aProdFilial) do
      SQLP := SQLP + '((e.produto = ' + aProdFilial[a].Prod +') and (e.filial = ' + aProdFilial[a].Filial + ')) or ';
    if SQLP = '' then begin
      qryProcuraProduto.MacroByName('FiltrarProdutosEFiliaisContratos').AsString := 'and False';
      qryConsultaProdutos.MacroByName('ProdutosFiliaisContratos').AsString     := 'and False';
    end else begin
      Delete(SQLP, Length(SQLP) - 3, 4);
      qryProcuraProduto.MacroByName('FiltrarProdutosEFiliaisContratos').AsString := Format(SQLStr, [SQLP]);
      qryConsultaProdutos.MacroByName('ProdutosFiliaisContratos').AsString       := Format(SQLStr, [SQLP]);
    end;
    qryProdutosContratos.Edit;
