procedure TdtmVendasAVista.BloquearEstoque;
var
  WhereSQL: String;
begin
  qryProdutosContratos.DisableControls;
  try
    if qryProdutosContratos.RecordCount = 0 then
      WhereSQL := 'false'
    else begin
      WhereSQL := '';
      qryProdutosContratos.First;
      while Not qryProdutosContratos.Eof do begin
        WhereSQL := WhereSQL +
        '((e.produto = ' + qryProdutosContratosproduto.AsString + ')and' +
        '(e.filial = '   + qryProdutosContratosfilial.AsString  + '))or';
        if (qryProdutosContratosproduto.AsLargeInt <> qryProdutosContratosproduto.OldValue) or
           (qryProdutosContratosfilial.AsInteger   <> qryProdutosContratosfilial.OldValue) then
          WhereSQL := WhereSQL +
          '((e.produto = ' + VarToStr(qryProdutosContratosproduto.OldValue) + ')and' +
          '(e.filial = '   + VarToStr(qryProdutosContratosfilial.OldValue)  + '))or';
        qryProdutosContratos.Next
      end;
      Delete(WhereSQL, Length(WhereSQL) - 1, 2);
    end
  finally
    qryProdutosContratos.EnableControls
  end;
  qryEstoqueBloqueio.Sql[72] := WhereSQL;
  qryEstoqueBloqueio.Open;
end;

procedure TdtmVendasAVista.CalcularValorVenda;
begin
  qryContratosvalorprazo.AsFloat := qryContratostotalprodutos.AsFloat +
                                    qryContratosfrete.AsFloat +
                                    qryContratosseguro.AsFloat -
                                    qryContratosdesconto.AsFloat;

{
  if ParSistema.utilizarcreditotrocacontrato then
   if qryContratoscreditotroca.AsCurrency < 0 then
    qryContratosvalorprazo.AsFloat := qryContratosvalorprazo.AsFloat -
                                    qryContratoscreditotroca.AsFloat;
}
  qryContratosvalorvista.AsCurrency := qryContratosvalorprazo.AsCurrency;


end;

procedure TdtmVendasAVista.CalcularValorTotalProdutos;
var
  Pos: TBookmark;
  QtdadeTotal,
  Preco,
  Produto,
  TotQtdeProdutos : Real;
begin
  Produto:= 0;  TotQtdeProdutos := 0;
  if qryProdutosContratos.Active then begin
    Pos := qryProdutosContratos.GetBookmark;
    qryProdutosContratos.DisableControls;
    FExisteMontagem := False;
    FExisteEntrega  := False;
    FExistePromocao := False;
    try
      qryProdutosContratos.First;
      while Not qryProdutosContratos.Eof do begin
        if Not qryProdutosContratosbrinde.AsBoolean then begin
          Preco    := qryProdutosContratosprecovenda.AsCurrency;
          QtdadeTotal := qryProdutosContratosquantidade.AsCurrency;
          TotQtdeProdutos := TotQtdeProdutos + qryProdutosContratosquantidade.AsCurrency;
          Produto := Produto + (QtdadeTotal * Preco);
        end;
        if qryProdutosContratosmontagem.AsString = 'S' then
          FExisteMontagem := True;
        if qryProdutosContratosentrega.AsString = 'S' then
          FExisteEntrega := True;
        if qryProdutosContratospromocao.AsBoolean then
          FExistePromocao := true;
        qryProdutosContratos.Next
      end;
      if Not FExisteMontagem then
        qryContratosmontagemfilial.Clear;
    finally
      qryContratostotalprodutos.AsCurrency := Produto;
      qryContratosTotalQtdeProdutos.AsCurrency := TotQtdeProdutos;
      if (qryContratosdesconto.AsString<>'') then
        CalcularPercentualDesconto(qryContratosdesconto.AsFloat);
      qryProdutosContratos.GotoBookmark(Pos);
      qryProdutosContratos.FreeBookmark(Pos);
      qryProdutosContratos.EnableControls;
    end;
  end;
end;

procedure TdtmVendasAVista.CancelarContratoReservado;
var
  Pos: TBookmark;
  SituacaoProduto : TtecComposicao;
begin
  BloquearEstoque;
  if qryMovimentos.State = dsInactive then
    qryMovimentos.Open;
  qryProdutosContratos.DisableControls;
  Pos := qryProdutosContratos.GetBookmark;
  try
    for SituacaoProduto:=stNAOCOMPOSTO to stCOMPOSTO do
    begin
      qryProdutosContratos.First;
      while Not qryProdutosContratos.Eof do begin
        if FiltrarComposto(qryProdutosContratoscomposto.AsBoolean, SituacaoProduto) then
        begin
          NovoMovimento(qryProdutosContratosproduto.AsLargeInt, qryProdutosContratosfilial.AsInteger);
          qryMovimentosquantidade.AsCurrency := qryProdutosContratosquantidade.AsCurrency;
          qryMovimentostipomovimento.AsString := 'TRE';
          qryMovimentosreferencia.AsString    := 'CT ' + qryContratosnumero.AsString + ' CANCELADO - VV';
          qryMovimentos.Post;
        end;
        qryProdutosContratos.Next;
      end
    end;
  finally
    qryProdutosContratos.GotoBookmark(Pos);
    qryProdutosContratos.FreeBookmark(Pos);
    qryProdutosContratos.EnableControls
  end;
end;

