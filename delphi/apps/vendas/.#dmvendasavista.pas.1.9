Function TdtmVendasAVista.ExcluirProdutoVendaVista: Boolean;
begin
  Result := True;
  if qryProdutosContratos.RecordCount > 0 then begin
    if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o PRODUTO DA VENDA VISTA'])) = smbOk then begin
      if qryProdutosContratos.State = dsInsert then
           qryProdutosContratos.Cancel
      else begin
        qryProdutosContratos.Delete;
        {
        RefazConsulta(qryEstoqueDepositos,[0],[IntToStr(qryProdutosContratosproduto.AsLargeInt)]);
        LerProdutosFiliaisIncluidos(False);
        qryProdutosContratos.Edit;
