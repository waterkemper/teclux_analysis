function TdtmVendasAVista.SugerirCreditoTroca(Perguntar, Atribuir: Boolean): Boolean;
var
  msg : String;
begin
  result := false;
  if ParSistema.utilizarcreditotrocacontrato then
  begin
    if SaldoCreditoAtual <> 0 then
    begin
      if saldoCreditoAtual >0 then
        msg:= 'crédito'
      {else
        msg:= 'débito'};
      if not Perguntar or
         (MensagemConfirmacao(format(ctCLIENTEPOSSUIDEBITOCREDITO,[msg,saldocreditoatual])) = smbOK) then
      begin
        qryContratoscreditotroca.AsCurrency := 0;
        if Atribuir or not Perguntar then
          if SaldoCreditoAtual > 0 then
          begin
            if (qryContratostotalprodutos.AsCurrency - qryContratosdesconto.ascurrency) >= SaldoCreditoAtual then
              qryContratoscreditotroca.AsCurrency := SaldoCreditoAtual
            else
              qryContratoscreditotroca.AsCurrency := qryContratostotalprodutos.AsCurrency - qryContratosdesconto.ascurrency;
          end
{       else
        if SaldoCreditoAtual < 0 then
          qryContratoscreditotroca.AsCurrency := SaldoCreditoAtual};
        if not (qryContratos.State in [dsedit,dsinsert]) then
          qrycontratos.Edit;
        result := true;
      end;
    end;
  end;
end;

