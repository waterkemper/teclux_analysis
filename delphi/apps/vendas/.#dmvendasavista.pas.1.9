function TdtmVendasAVista.GravarProdutoVendaVista: Boolean;
var
  quantidade : Currency;
begin
  quantidade := 0.00;
  if qryProdutosContratos.CheckRequiredFields then begin
    {
    if (qryContratoslistacasamento.AsInteger > 0)                                    and
      qryProdutosListaCasamento.Locate('produto',qryProdutosContratosproduto.AsString,[])      and
      qryProdutosContratosprodutolista.AsBoolean                                               and
      (qryProdutosContratosquantidade.AsCurrency > qryProdutosListaCasamentomaxqtde.AsCurrency)  then begin
         MensagemAviso(ctQTDEMAIORLISTACASAMENTO);
         Result:= False;
    end else} if (qryProdutosContratosquantidade.AsCurrency > qryProdutoEstoqueemestoque.AsCurrency) then begin
      if (qryprodutoscontratosquantidade.OldValue = null) or
         ((qryProdutosContratos.State = dsedit) and
          (qryProdutosContratosproduto.OldValue <> qryProdutosContratosproduto.AsString)) then
        quantidade := qryProdutoEstoqueemestoque.AsCurrency
      else
        quantidade := qryProdutoEstoqueemestoque.AsCurrency + qryprodutoscontratosquantidade.OldValue;
      if (qryProdutosContratosquantidade.AsCurrency > quantidade) then
      begin
        MensagemAviso('Quantidade informada é maior que quantidade em estoque.');
        Result:= False;
      end;
    end
    else if (qryProdutosContratosprecovenda.AsCurrency <= 0) then begin
      MensagemAviso(ctPRECOZERO);
      Result := False
    end else begin
      qryContratos.Edit;
      qryProdutosContratos.Post;
      Result := True
    end
  end
  else Result:= False;

  if result then
    VerificarSaldoProdutoListaCasamento;

end;

function TdtmVendasAVista.GravarVendaVista: Boolean;

  procedure FecharQuerys;
  begin
    if qryMovimentos.State <> dsInactive then
      qryMovimentos.Close;
    if qryEstoqueBloqueio.State <> dsInactive then
      qryEstoqueBloqueio.Close;
    if qryProdutosReservas.State <> dsInactive then
      qryProdutosReservas.Close;
    if qryClientes.State <> dsInactive then
      qryClientes.Close;
    if qryProdutosListaCasamento.State <> dsInactive then
      qryProdutosListaCasamento.Close;
    if qryReservasListaCasamento.State <> dsInactive then
      qryReservasListaCasamento.Close;
    if qryProdutosTrocados.State <> dsinactive then
      qryProdutosTrocados.Close;
  end;

  Procedure AtribuirNumeroProdutosVendaVista;
  var
    Cont: Integer;
  begin
    Cont:= 1;
    qryProdutosContratos.First;
    while Not qryProdutosContratos.Eof do begin
      qryProdutosContratos.Edit;
      qryProdutosContratoscontrato.AsString:= qryContratosnumero.AsString;
      qryProdutosContratosnumero.AsInteger := Cont;
      qryProdutosContratos.Post;
      Inc(Cont);
      qryProdutosContratos.Next;
    end;
  end;

  procedure RatearValoresProdutosContratos;
  var
    i, t: Integer;
    FreteRateado,
    DescontoRateado,
    SeguroRateado,
    AcrescimoRateado,
    Total: Currency;
  begin
    if (qryContratosfrete.AsCurrency > 0) or
       (qryContratosdesconto.AsCurrency > 0) or
       (qryContratosseguro.AsCurrency > 0) or
       (qryContratosvalorprazo.AsCurrency > qryContratosvalorvista.AsCurrency) then
    begin
      FreteRateado     := qryContratosfrete.AsCurrency;
      DescontoRateado  := qryContratosdesconto.AsCurrency;
      SeguroRateado    := qryContratosseguro.AsCurrency;
      AcrescimoRateado := qryContratosvalorprazo.AsCurrency - qryContratosvalorvista.AsCurrency;
      Total            := qryContratostotalprodutos.AsCurrency;
      try
        GuardarRegistroAtual(qryProdutosContratos,true);
        t:= qryProdutosContratos.RecordCount;
        qryProdutosContratos.First;
        for i := 1 to T do
        begin
          if not qryProdutosContratosbrinde.AsBoolean then
          begin
            qryProdutosContratos.Edit;
            if FreteRateado > 0 then
            begin
              if i = t then
                qryProdutosContratosfrete.AsCurrency := FreteRateado
              else
              begin
                qryProdutosContratosfrete.AsCurrency := Truncar(qryProdutosContratosprecovenda.AsCurrency * qryProdutosContratosquantidade.AsCurrency * qryContratosfrete.AsCurrency / Total,2);
                FreteRateado := FreteRateado - qryProdutosContratosfrete.AsCurrency;
              end;
            end;
            if SeguroRateado > 0 then
            begin
              if i = t then
                qryProdutosContratosseguro.AsCurrency := SeguroRateado
              else
              begin
                qryProdutosContratosseguro.AsCurrency := Truncar(qryProdutosContratosprecovenda.AsCurrency * qryProdutosContratosquantidade.AsCurrency * qryContratosseguro.AsCurrency / Total,2);
                SeguroRateado := SeguroRateado - qryProdutosContratosseguro.AsCurrency;
              end;
            end;
            if AcrescimoRateado > 0 then
            begin
              if i = t then
                qryProdutosContratosacrescimo.AsCurrency := AcrescimoRateado
              else
              begin
                qryProdutosContratosacrescimo.AsCurrency := Truncar(qryProdutosContratosprecovenda.AsCurrency * qryProdutosContratosquantidade.AsCurrency * (qryContratosvalorprazo.AsCurrency - qryContratosvalorvista.AsCurrency) / Total,2);
                AcrescimoRateado := AcrescimoRateado - qryProdutosContratosacrescimo.AsCurrency;
              end;
            end;
            if DescontoRateado > 0 then
            begin
              if i = t then
                qryProdutosContratosdesconto.AsCurrency := DescontoRateado
              else
              begin
                qryProdutosContratosdesconto.AsCurrency := Truncar((qryProdutosContratosprecovenda.AsCurrency +
                                                                    qryProdutosContratosfrete.AsCurrency +
                                                                    qryProdutosContratosseguro.AsCurrency) *
                                                                    qryProdutosContratosquantidade.AsCurrency *
                                                                    qryContratosdesconto.AsCurrency / Total,2);
                DescontoRateado := DescontoRateado - qryProdutosContratosdesconto.AsCurrency;
              end;
            end;
            qryProdutosContratos.Post;
          end;
          qryProdutosContratos.Next;
        end;
      finally
        VoltarRegistroAtual(qryProdutosContratos);
      end;
    end;
  end;

  procedure GerarVencimentos;
  begin
    if not qryParcelas.IsEmpty then begin
      qryParcelas.First;
      while not qryParcelas.Eof do
        qryParcelas.Delete;
    end;
    if qryContratoscreditotroca.AsCurrency>0 then
    begin
      qryParcelas.Insert;
      qryParcelascontrato.AsString             := qryContratosnumero.AsString;
      qryParcelasnumero.AsInteger              := 01;
      qryParcelasdatavencto.AsDateTime         := DataServidor;
      qryParcelasvalorvencto.AsCurrency        := qryContratoscreditotroca.AsCurrency;
      qryParcelasparcelaorigem.AsString        := '1/1';
      qryParcelasparcelaadicional.AsBoolean    := False;
      qryParcelaspagamentoextracaixa.AsBoolean := False;
      qryParcelasformapagamento.AsString:= 'T';
      if situacaocontrato > scRESERVADO then
      begin
        qryParcelasdatapagto.AsDateTime := qryParcelasdatavencto.AsDateTime;
        qryParcelasvalorpagto.Ascurrency := qryParcelasvalorvencto.AsCurrency;
        qryParcelasfilialpagto.AsInteger := FilialBase;
      end;
      qryparcelas.Post;

      if qryContratoscreditotroca.AsCurrency<>qryContratosvalorprazo.AsCurrency then
      begin
        qryParcelas.Insert;
        qryParcelascontrato.AsString             := qryContratosnumero.AsString;
        qryParcelasnumero.AsInteger              := 02;
        qryParcelasdatavencto.AsDateTime         := DataServidor;
        qryParcelasvalorvencto.AsCurrency        := qryContratosvalorprazo.AsCurrency - qryContratoscreditotroca.AsCurrency;
        qryParcelasparcelaorigem.AsString        := '1/1';
        qryParcelasparcelaadicional.AsBoolean    := False;
        qryParcelaspagamentoextracaixa.AsBoolean := False;
        case FFormaPagamento of
          0: qryParcelasformapagamento.AsString:= 'D';
          1: qryParcelasformapagamento.AsString:= 'C';
          2: qryParcelasformapagamento.AsString:= 'B';
        end;
        qryParcelas.Post;
      end;

    end
    else
    begin
      qryParcelas.Insert;
      qryParcelascontrato.AsString             := qryContratosnumero.AsString;
      qryParcelasnumero.AsInteger              := 01;
      qryParcelasdatavencto.AsDateTime         := DataServidor;
      qryParcelasvalorvencto.AsCurrency        := qryContratosvalorprazo.AsCurrency;
      qryParcelasparcelaorigem.AsString        := '1/1';
      qryParcelasparcelaadicional.AsBoolean    := False;
      qryParcelaspagamentoextracaixa.AsBoolean := False;
      case FFormaPagamento of
        0: qryParcelasformapagamento.AsString:= 'D';
        1: qryParcelasformapagamento.AsString:= 'C';
        2: qryParcelasformapagamento.AsString:= 'B';
      end;
      qryParcelas.Post;
    end;
  end;

  procedure ImprimirCarne;
  var
    dtmImprimeCarne: TdtmImprimeCarne;
  begin
    dtmImprimeCarne := TdtmImprimeCarne.Create(Self);
    try
      dtmImprimeCarne.ImprimirCarnesContrato(qryContratosnumero.AsString, false)
    finally
      dtmImprimeCarne.Free
    end
  end;

  procedure AtualizarDadosCliente;
  var
    a: Integer;
  begin
    if qryContratostipocliente.AsString = 'C' then
    begin
      if not qryClientes.Active then
        ReFazConsulta(qryClientes,[0],[qryProcuraClientecodigo.AsInteger]);
      qryClientes.Edit;
      for a := 1 to qryClientes.Fields.Count - 6 do
        if qryClientes.Fields[a].Value <> qryContratos.Fields[a + 12].Value then
          qryClientes.Fields[a].Value := qryContratos.Fields[a + 12].Value;

      if (qryclientesRua.AsString <> qryClientesrua.OldValue) or

         (qryClientesnumero.AsString <> qryClientesnumero.OldValue) or
         (qryClientescomplemento.AsString <> qryClientescomplemento.OldValue) or

         (qryclientesbairro.AsInteger <> qryClientesbairro.OldValue) or
         (qryclientescidade.AsInteger <> qryClientescidade.OldValue) or
         (qryClientesestado.AsString <> qryClientesestado.OldValue) or
         (qryClientescep.AsInteger <> qryClientescep.OldValue)
      then
        qryClientesenderecoalterado.AsDateTime := DataHoraLocal;
      qryClientes.Post;
    end
    else
    begin
      if not qryFornecedores.Active then
        RefazConsulta(qryFornecedores,[0],[qryProcuraClientecodigo.asInteger]);
      qryFornecedores.Edit;
      qryFornecedoresnome.AsString := qryContratosnome.AsString;
      qryFornecedorespessoatipo.AsString := qryContratospessoatipo.AsString;
      qryFornecedorespessoanumero.AsString := qryContratospessoanumero.AsString;
      qryFornecedoresrua.AsString := qryContratosrua.AsString;

      qryFornecedoresnumero.AsString := qryContratosendnumero.AsString;
      qryFornecedorescomplemento.AsString := qryContratosendcomplemento.AsString;

      qryFornecedoresbairro.AsInteger := qryContratosbairro.AsInteger;
      qryFornecedorescidade.AsInteger := qryContratoscidade.AsInteger;
      qryFornecedoresestado.AsString := qryContratosestado.AsString;
      qryFornecedorescep.AsInteger := qryContratoscep.AsInteger;
      qryFornecedoresfoneddd.AsInteger := qryContratosfoneddd.AsInteger;
      qryFornecedoresfonenumero.AsInteger := qryContratosfonenumero.AsInteger;
      qryFornecedoresinscricaoestadual.AsString := qryContratosiddocumento.AsString;
      if ((qryFornecedoresrua.AsString <> qryFornecedoresrua.OldValue) or

          (qryFornecedoresnumero.AsString <> qryFornecedoresnumero.OldValue) or
          (qryFornecedorescomplemento.AsString <> qryFornecedorescomplemento.OldValue) or

          (qryFornecedoresbairro.AsInteger <> qryFornecedoresbairro.OldValue) or
          (qryFornecedorescidade.AsInteger <> qryFornecedorescidade.OldValue) or
          (qryFornecedoresestado.AsString <> qryFornecedoresestado.OldValue) or
          (qryFornecedorescep.AsInteger <> qryFornecedorescep.OldValue)) then
        qryFornecedoresenderecoalterado.AsDateTime := DataHoraLocal;
      qryFornecedores.Post;
    end;
  end;

begin
  Result := False;
  if qryContratos.CheckRequiredFields then begin
    if (qryProdutosContratos.RecordCount = 0) then begin
      MensagemAviso(ctVENDAVISTASEMPRODUTO);
      Result := False
    end else if SomenteBrindes then begin
      MensagemAviso(ctSOMENTEBRINDENAVENDAVISTA);
      Result := False
    end else if FExisteEntrega and Not EnderecoCompleto then begin
      MensagemAviso(ctENDERECOIMCOMPLETO);
      Result := False
    end else if FExisteMontagem and qryContratosmontagemfilial.IsNull then begin
      MensagemAviso(ctFILIALMONTAGEMNULAVENDAVISTA);
      Result := False
    end else begin
      Result := True;
      if (qryContratoscliente.AsInteger = 0) then begin
        FAtribuindoCliente:= True;
        Result:= IncluirCliente;
        if Result then
          qryContratoscliente.AsInteger := qryClientescodigo.AsInteger;
        FAtribuindoCliente:= False;
      end;

      if Result then begin
        if qryContratos.State = dsInsert then begin
          spcContratoProximo.Open;
          qryContratosnumero.AsString := spcContratoProximonumero.AsString;
          spcContratoProximo.Close;
        end;

        if (qryContratospessoatipo.AsString = 'J') then begin
          qryContratossexo.AsString := 'E';
          qryContratoscivil.AsString:= 'O';
        end;

        if (qryContratossituacao.AsString = 'O') then
          if ParSistema.FaturarVendaVista then
             qryContratossituacao.AsString := 'F'
          else
            qryContratossituacao.AsString := 'R';

        if qryContratossituacao.AsString = 'F' then
        begin
          if ParSistema.utilizarcreditotrocacontrato then
            result := AtualizarSaldoCreditoCliente('S');
          AtualizarDadosCliente;
        end;

        if result then
        begin
          try
            GerarVencimentos;
            ReservarVendaVista;
            AtribuirNumeroProdutosVendaVista;
            RatearValoresProdutosContratos;
            //if (qryContratoslistacasamento.AsInteger > 0) then
            //begin
              IncluirProdutosListaCasamento;
//              AtualizarQtdePresentesListas(False);
            //end;
            qryContratos.Post;
            Perpetrar([qryClientes, qryFornecedores, qryContratos, qryProdutosContratos, qryParcelas,
                       qryMovimentos, qryProdutosListaCasamento, qryReservasListaCasamento,
                       qryProdutosTrocados]);
            if ParSistema.utilizarcreditotrocacontrato then
              AbrirDadosCreditoCliente;
          finally
            if ((ParSistema.FaturarVendaVista) and (ParSistema.ImprimirCarneAoFaturar)
                 and (ParSistema.ImpCarneVendaVista)) then
                 ImprimirCarne;

            FecharQuerys;
          end
        end;

      end;
    end;
  end;
end;

