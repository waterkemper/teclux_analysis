    vNomeCampo := 'v.razao'
  else
    NomeCampo:= 'v.' + NomeCampo;
  //qryConsultaClientes.Sql[09]:= 'Where (Maiusculo(' + NomeCampo + ') ilike Maiusculo(''' + Inf + '%'')) ';
   qryConsultaClientes.Sql[09]:= Format(SQL, [vNomeCampo, ANSIUpperCase(Inf), '%']);
