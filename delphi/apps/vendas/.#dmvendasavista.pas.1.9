        CalcularValorTotalProdutos;
        CalcularValorVenda;
   }
      end;
   //  qryContratos.Edit;
    end;
  end;
end;

function TdtmVendasAVista.ExcluirVendaVista: Boolean;
begin
  Result := True;
  if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['a VENDA VISTA'])) = smbOk then begin
    if not qryContratos.IsEmpty then begin
      if not (qrycontratos.State in [dsinsert]) then
      begin
        qrycontratos.Edit;
        qryContratoscreditotroca.AsCurrency:=0;
        qrycontratos.Post;
        AtualizarSaldoCreditoCliente('S');
      end;
//      AtualizarQtdePresentesListas(True);
      CancelarContratoReservado;

      qryProdutosContratos.First;
      while qryProdutosContratos.RecordCount > 0 do
        qryProdutosContratos.Delete;

      qryParcelas.First;
      while qryParcelas.RecordCount > 0 do
        qryParcelas.Delete;

      qryContratos.Delete;
      Perpetrar([qryParcelas, qryProdutosContratos, qryprodutostrocados, qryContratos,
                 qryMovimentos, {qryProdutosListaCasamento,} qryReservasListaCasamento]);
      Result := True;
    end;
  end;
end;

function TdtmVendasAVista.ExisteCliente(NomeCampo: String; Inf: Variant): Boolean;
const
  SQL = ' Where (upper(to_ascii(%s,''latin1'')) ilike upper(to_ascii(''%s%s'',''latin1'')))';

var
  vNomeCampo : String;

begin
 vNomeCampo := NomeCampo;

  if NomeCampo = 'nomecidade' then
    vNomeCampo:= 'c.nome'
  else
  if NomeCampo = 'tipocliente' then
    vNomeCampo:= 'v.tipo'
  else  
