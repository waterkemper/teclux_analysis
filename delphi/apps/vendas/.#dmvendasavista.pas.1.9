function TdtmVendasAVista.ReservarVendaVista: Boolean;
var
  SituacaoProduto : TtecComposicao;
  Referencia: String;
  EmEstoque,
  Qtdade: Real;
  PosProd: TBookmark;
  Existe: Boolean;
  RecordTypesAnt: TZUpdateRecordTypes;
  Prod: int64;
  Fil: Integer;
  Movimentar: Boolean;

begin
  Result := True;
  if qryMovimentos.State = dsInactive then
    qryMovimentos.Open;
  PosProd := qryProdutosContratos.GetBookmark;
//O método UpdateStatus não funciona após a execução do método DisableControls

  RecordTypesAnt := qryProdutosContratos.ShowRecordTypes;
  try
    if qryContratossituacao.AsString = qryContratossituacao.OldValue then
         qryProdutosContratos.ShowRecordTypes := [ztModified, ztInserted, ztDeleted]
    else qryProdutosContratos.ShowRecordTypes := [ztModified, ztInserted, ztUnmodified];
    BloquearEstoque;
    MontarProdutosReservas;
    for SituacaoProduto := stNAOCOMPOSTO to stCOMPOSTO do
    begin
      qryProdutosContratos.First;
      while Not qryProdutosContratos.eof do begin
        if FiltrarComposto(qryprodutoscontratoscomposto.asboolean, SituacaoProduto) then
        begin
          Existe := qryMovimentos.Locate('produto;filial', VarArrayOf([
                                          qryProdutosContratosproduto.AsString,
                                          qryProdutosContratosfilial.AsInteger]), []);
          if Not Existe then
               NovoMovimento(qryProdutosContratosproduto.AsLargeInt, qryProdutosContratosfilial.AsInteger)
          else qryMovimentos.Edit;
          if qryProdutosContratos.UpdateStatus = usDeleted then
            qryMovimentosquantidade.AsCurrency := qryMovimentosquantidade.AsCurrency - qryProdutosContratosquantidade.AsCurrency
          else if qryProdutosContratos.UpdateStatus = usInserted then
            qryMovimentosquantidade.AsCurrency := qryMovimentosquantidade.AsCurrency + qryProdutosContratosquantidade.AsCurrency
          else if qryProdutosContratos.UpdateStatus = usModified then begin
            if (qryProdutosContratosproduto.AsLargeInt <> qryProdutosContratosproduto.OldValue) or
               (qryProdutosContratosfilial.AsInteger <> qryProdutosContratosfilial.OldValue)
            then begin
              qryMovimentosquantidade.AsCurrency := qryMovimentosquantidade.AsCurrency +
                                                   qryProdutosContratosquantidade.AsCurrency;
              if qryContratossituacao.AsString = qryContratossituacao.OldValue then begin
                qryMovimentos.Post;
                if qryProdutosContratosquantidade.AsCurrency = qryProdutosContratosquantidade.OldValue then
                  Qtdade := qryProdutosContratosquantidade.AsCurrency
                else
                  Qtdade := qryProdutosContratosquantidade.OldValue;
                if qryProdutosContratosproduto.AsLargeInt = qryProdutosContratosproduto.OldValue then
                  Prod := qryProdutosContratosproduto.AsLargeInt
                else
                  Prod := qryProdutosContratosproduto.OldValue;
                if qryProdutosContratosfilial.AsInteger = qryProdutosContratosfilial.OldValue then
                  Fil := qryProdutosContratosfilial.AsInteger
                else
                  Fil := qryProdutosContratosfilial.OldValue;
                Existe := qryMovimentos.Locate('produto;filial', VarArrayOf([IntToStr(Prod), Fil]), []);
                if not Existe then
                  NovoMovimento(Prod, Fil);
                qryMovimentosquantidade.AsCurrency := qryMovimentosquantidade.AsCurrency - Qtdade;
              end
            end else if qryProdutosContratosquantidade.AsCurrency <> qryProdutosContratosquantidade.OldValue then begin
              if qryContratossituacao.AsString = qryContratossituacao.OldValue then
                Qtdade := qryProdutosContratosquantidade.AsCurrency - qryProdutosContratosquantidade.OldValue
              else
                Qtdade := qryProdutosContratosquantidade.AsCurrency;
              qryMovimentosquantidade.AsCurrency := qryMovimentosquantidade.AsCurrency + Qtdade
            end
          end else
            qryMovimentosquantidade.AsCurrency := qryMovimentosquantidade.AsCurrency +
                                                 qryProdutosContratosquantidade.AsCurrency;
          if qryMovimentos.State in [dsEdit, dsInsert] then
            qryMovimentos.Post;
        end;
        qryProdutosContratos.next;
      end;
    end;

    qryMovimentos.First;
    while Not qryMovimentos.Eof do begin
      if qryMovimentosquantidade.AsCurrency = 0 then
        qryMovimentos.Delete
      else begin
        Movimentar:= True;
        if qryEstoqueBloqueio.Locate('produto;filial', VarArrayOf([qryMovimentosproduto.AsString,
                                                                   qryMovimentosfilial.AsInteger]), []) then
             EmEstoque := qryEstoqueBloqueioemestoque.AsCurrency
        else EmEstoque := 0;
        if (EmEstoque < qryMovimentosquantidade.AsCurrency) then begin
          MensagemAviso(Format(ctSEMESTOQUESEMVENDA, [qryMovimentosproduto.AsString, qryMovimentosfilial.AsString]));
          Result := False;
          break
        end
        else begin
          qryProdutosContratos.Locate('produto;filial', VarArrayOf([
                                      qryMovimentosproduto.AsString,
                                      qryMovimentosfilial.AsInteger]), []);
          qryProdutosReservas.Locate('produto;reserva;filial', VarArrayOf([
                                      qryProdutosContratosproduto.AsString,
                                      qryProdutosContratosreserva.AsInteger,
                                      qryProdutosContratosfilial.AsInteger]), []);
          Referencia := 'CT ' + qryContratosnumero.AsString + ' VV';
          qryMovimentos.Edit;
          if qryProdutosContratosreserva.AsInteger <> 0 then
            Referencia := Referencia + ' RS ' + qryProdutosContratosreserva.AsString;
          qryMovimentosreferencia.AsString := Referencia;
          if qryMovimentosquantidade.AsCurrency < 0 then begin
            qryMovimentosquantidade.AsCurrency := qryMovimentosquantidade.AsCurrency * -1;
            qryMovimentostipomovimento.AsString := 'TRE';
          end else begin
            if qryProdutosContratosreserva.AsInteger = 0 then
              qryMovimentostipomovimento.AsString := 'TER'
            else begin
              if qryMovimentosquantidade.AsCurrency = qryProdutosReservasquantidade.AsCurrency then begin
                Movimentar:= False;
                Qtdade := qryMovimentosquantidade.AsCurrency;
                qryMovimentos.Delete;
              end else if qryMovimentosquantidade.AsCurrency < qryProdutosReservasquantidade.AsCurrency then begin
                qryMovimentostipomovimento.AsString := 'TRE';
                qryMovimentosquantidade.AsCurrency   := qryProdutosReservasquantidade.AsCurrency - qryMovimentosquantidade.AsCurrency;
                Qtdade := qryProdutosReservasquantidade.AsCurrency
              end else begin
                Qtdade := qryMovimentosquantidade.AsCurrency - qryProdutosReservasquantidade.AsCurrency;
                qryMovimentostipomovimento.AsString  := 'TER';
                qryMovimentosquantidade.AsCurrency   := Qtdade;
                Qtdade := qryProdutosReservasquantidade.AsCurrency
              end;
              if qryProdutosReservasquantidade.AsCurrency > 0 then begin
                qryProdutosReservas.Edit;
                qryProdutosReservasbaixado.AsCurrency := Qtdade;
                qryProdutosReservas.Post
              end
            end
          end;
        end;
        if qryMovimentos.State = dsEdit then
          qryMovimentos.Post;
        if Movimentar then
          qryMovimentos.Next;
      end
    end;
  finally
    qryProdutosContratos.ShowRecordTypes := RecordTypesAnt;
    qryProdutosContratos.GotoBookmark(PosProd);
    qryProdutosContratos.FreeBookmark(PosProd);
  end
end;

