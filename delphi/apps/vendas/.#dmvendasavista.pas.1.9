//  qryProcuraProduto.Tag               := ctTabelas;
//  qryProcuraReservaProduto.Tag        := ctTabelas;
//  qryProcuraFilialProduto.Tag         := ctTabelas;
//  qryProcuraFilialMontagem.Tag        := ctTabelas;
//  qryProcuraVendedorProduto.Tag       := ctTabelas;
  qryConsultaVendas.Tag               := ctVendaTabelaConsultaVendas;
  qryConsultaClientes.Tag             := ctVendaTabelaConsultaClientes;
  qryConsultaVendedores.Tag           := ctVendaTabelaConsultaVendedores;
  qryConsultaListaCasamento.Tag       := ctVendaTabelaConsultaListaCasamento;
  qryConsultaProdutos.Tag             := ctVendaTabelaConsultaProdutos;
  qryConsultaFilialProduto.Tag        := ctVendaTabelaConsultaFilialProduto;
  qryConsultaFiliais.Tag              := ctVendaTabelaConsultaFiliais;
  qryConsultaReservasProduto.Tag      := ctVendaTabelaConsultaReservas;
  qryContratos.Sql[58]           := '(c.plano = ' + IntToStr(ParSistema.PlanoVendaVista) + ') and ';

  if ParSistema.FaturarVendaVista then
     qryContratos.Sql[59]      := '(c.situacao = ''F'') and'
  else
     qryContratos.Sql[59]      := '(c.situacao = ''R'') and';

  qryConsultaVendas.Sql[11]      := 'and (c.plano = ' + IntToStr(ParSistema.PlanoVendaVista) + ')';
  
  if ParSistema.FaturarVendaVista then
     qryConsultaVendas.Sql[12] := 'and (c.situacao = ''F'')'

  else qryConsultaVendas.Sql[12] := 'and (c.situacao = ''R'')';
  qryProcuraCliente.Params[1].AsString := 'C';
  qryProcuraProduto.Params[1].AsString := EstadoFilialBase;
  qryProcuraProduto.Params[2].AsString := IntToStr(FilialBase);
  if UsuarioLogin.Vendedor then begin
    qryProcuraReservaProduto.Params[0].AsInteger   := CodigoUsuario;
    qryConsultaReservasProduto.Params[0].AsInteger := CodigoUsuario;
  end;
  FOpeningQuery:= True;

  if (ParSistema.FiliaisIndependentes) then
  begin
    qryConsultaProdutos.MacroByName('FilialIndependente').AsString := 'and (e.filial = ' + IntToStr(FilialBase) + ')';
    qryConsultaFilialProduto.Sql[8]    := 'and (f.codigo = ' + IntToStr(FilialBase) + ')';
    qryProcuraFilialProduto.Sql[10]    := 'and (f.codigo = ' + IntToStr(FilialBase) + ')';
    qryConsultaProdutosfilial.Visible  := Not (ParSistema.FiliaisIndependentes);
    qryProdutosContratosfilial.Visible := Not (ParSistema.FiliaisIndependentes);
  end
  else
    if (ParSistema.PesquisaSomenteEstoqueFilialBasevendas) then
    begin
      qryConsultaProdutos.MacroByName('FilialIndependente').AsString := 'and (e.filial in (' + ListaEstoquesFiliais + '))';
      qryConsultaFilialProduto.Sql[8]    := 'and (f.codigo in (' + ListaEstoquesFiliais + '))';
      qryProcuraFilialProduto.Sql[10]    := 'and (f.codigo in (' + ListaEstoquesFiliais + '))';
    end
    else
    begin
      qryConsultaProdutos.MacroByName('FilialIndependente').AsString := '';
      qryConsultaFilialProduto.Sql[8]    := '';
      qryProcuraFilialProduto.Sql[10]    := '';
    end;

  qryContratostotalqtdeprodutos.DisplayFormat  := ParSistema.MascaraQuantidadeGrade;
  qryProdutosContratosquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosContratoscancelado.DisplayFormat  := ParSistema.MascaraQuantidadeGrade;
  qryProdutoEstoqueemestoque.DisplayFormat     := ParSistema.MascaraQuantidadeGrade;
  qryEstoqueDepositosemestoque.DisplayFormat   := ParSistema.MascaraQuantidadeGrade;
end;

