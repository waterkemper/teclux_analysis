procedure TfrmCadastroClientes.aclHabilitarUpdate(Action: TBasicAction; var Handled: Boolean);
begin
  inherited;
  gbxTempo.Enabled      := rbnCasado.Checked;
  tstConjuge.TabVisible := (fracgcoucpf1.rbnFisica.Checked and (rbnCasado.Checked or rbnOutros.Checked));


  if (rbnResPropria.Checked) then
  begin
    if ((edtClientesResOnus.Text<>'') and
        (edtClientesResOnus.Enabled)) then
    begin
      edtClientesResOnus.Clear;
      edtClientesResOnus.Enabled := False;
    end;
  end
  else
  begin
   if not edtClientesResOnus.Enabled then
     edtClientesResOnus.Enabled := True;
  end;

  if fracgcoucpf1.rbnFisica.Checked then lblDocumento.Caption:= 'Documento'
  else                                   lblDocumento.Caption:= 'Insc. Estadual';
  gbxSerie.Visible:= dtmCadastroClientes.TipoPessoa = 'J';
  tstReceitasOculos.TabVisible := dtmCadastroClientes.ReceitasOculos;

  if fracgcoucpf1.rbnJuridica.checked then
    lblApelido.caption := 'Nome de Fantasia'
  else
    lblApelido.caption := 'Apelido';
end;

