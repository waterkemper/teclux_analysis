var
 i: integer;
begin
  ReCalcularTempoCivil  := False;
  ReCalcularTempoMoradia:= False;
  if(ParSistema.ContratoComServico) then
    AtualizaEquipamentosCliente;
  fraDadosLoginSite1.AbrirTabelaCliente_Site(true);

  {
  if dtmCadastroClientes.qryClientes.recordcount <> 0 then
    for I := 1 to tarrayfield(dtmCadastroClientes.qryClientesatendimentoforcouexibicaodafichafinanceira).Size  do
      if not tarrayfield(dtmCadastroClientes.qryClientesatendimentoforcouexibicaodafichafinanceira).Fields[I].IsNull then
//        lsbAtendimentos.Items.Add(tarrayfield(dtmCadastroClientes.qryClientesatendimentoforcouexibicaodafichafinanceira).FieldValues[I]);
   }
end;

