  edtClientesaniversario.Text:= Copy(edtClientesNascto.Text,0,5);
end;

procedure TfrmCadastroClientes.AlteraTituloGrid;
var a: Integer;
begin
  for a:= 0 to dbgEquipamentos.Columns.Count -1 do
    dbgEquipamentos.Columns[a].Title.Font.Style:= [];
  if (dbgEquipamentos.Columns.Count > 0) then
  begin
    if FDbgColumnsIndex >= dbgEquipamentos.Columns.Count then
      FDbgColumnsIndex := dbgEquipamentos.Columns.Count - 1;
    dbgEquipamentos.Columns[FDbgColumnsIndex].Title.Font.Style:= [fsBold];
    dbgEquipamentos.Columns[FDbgColumnsIndex].Title.Alignment := taCenter;
    if Assigned(Lbo) then
      Lbo.Caption:= dbgEquipamentos.Columns[FDbgColumnsIndex].Title.Caption;
  end;
end;

procedure TfrmCadastroClientes.OrdenePor(NomeCampo: String);
begin
  with dtmCadastroEquipamentoslocal do
  begin
    qryEquipamentosCliente.Close;
    if (NomeCampo = 'equipamento') or (NomeCampo = 'codigo') then
      qryEquipamentosCliente.MacroByName('OrderBy').AsString  := 'order by (ec.' +(NomeCampo)+')'
    else if NomeCampo = 'descricaomarca' then
      qryEquipamentosCliente.MacroByName('OrderBy').AsString  := 'order by (m.descricao)'
    else if (NomeCampo = 'descricao') or (NomeCampo = 'referencia') or (NomeCampo = 'modelo')
         or (NomeCampo = 'ano') or (NomeCampo = 'opcionais') then
        qryEquipamentosCliente.MacroByName('OrderBy').AsString  := 'order by (e.'+(NomeCampo)+')';

    qryEquipamentosCliente.Params[0].AsString:= dtmCadastroClientes.qryClientescodigo.AsString;
    qryEquipamentosCliente.Open;
  end;
end;

procedure TfrmCadastroClientes.dbgSerieKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if CtrlOn then
  begin
    case Key of
      VK_F9 : AcionaPesquisaGrade
    end;
  end
  else
  begin
    case key of
      VK_Return :
      begin
        case dbgSerie.SelectedIndex of
        1 : begin
              if not fraConsultaModeloDocto.edfCodigo.Exist then
                dbgSerie.DataSource.DataSet.FieldByName('modelodoctofiscal').Clear;
              dbgSerie.SelectedIndex := 1;
              dbgSerie.SetFocus;
            end;
        end;
        if dtmCadastroClientes.qrySeriesClientes.State in [dsedit, dsinsert] then
           dtmCadastroClientes.qrySeriesClientes.Post;
      end;
    end;
  end;
end;

procedure TfrmCadastroClientes.AcionaPesquisaGrade;
begin
  fraConsultaModeloDocto.CtrlOn := True;
  dbgSerie.SetFocus;
  fraConsultaModeloDocto.InternoPesquisar('Modelo do Documento Fiscal');
  dbgSerie.SelectedIndex :=  0;
end;

procedure TfrmCadastroClientes.FormShow(Sender: TObject);
begin
  inherited;
  edfCodigoCliente.SetFocus;
end;

end.
