implementation

uses fmcadastrodependentesclientes, fmcadastrocontatos,
     fmnavcontroles;

{$R *.dfm}

{ TfrmCadastroClientes }

constructor TfrmCadastroClientes.Create(AOwner: TComponent);
begin


  FormOrigem := '';
  FDbgColumnsIndex := 0;
  dtmCadastroClientes := TdtmCadastroClientes.Create(Self);
  if(ParSistema.ContratoComServico) then
    dtmCadastroEquipamentoslocal:= TdtmCadastroEquipamentos.Create(Self);

  inherited  Create(AOwner);

  if(ParSistema.ContratoComServico) then
    dbgEquipamentos.DataSource := dtmCadastroEquipamentoslocal.dsrEquipamentosClientes; 

//  dtmCadastroClientes.Abre(ctCrediarioClienteCadastro);
  DataSet := dtmCadastroClientes.TabelaClientes;
  dtmCadastroClientes.OnScrollClientes:= ClientesOnScroll;
  dtmCadastroClientes.AfterPostClientes:= ClientesAfterPost;
  dtmCadastroClientes.AfterCloseClientes:=ClientesAfterClose;
  ReCalcularTempoCivil  := False;
  ReCalcularTempoMoradia:= False;
  JaTestouEmail:= False;
  if ParSistema.ClientePessoaJuridica then
  begin
     tstResidencia.Caption     := ' &2. Endereço';
     tstDadosComerciais.Caption:= ' &3. Praça Pagto.';
     tstReferencia.Caption     := ' &5. Entrega';
  end
  else
  begin
     tstResidencia.Caption     := ' &2. Residência';
     tstDadosComerciais.Caption:= ' &3. Comercial';
     tstReferencia.Caption     := ' &5. Referência';
  end;
  tstDependentes.TabVisible := ParSistema.ClienteComDependentes;

  if(tstDependentes.TabVisible and not ParSistema.ContratoComServico) then
    tstDependentes.PageIndex:=7
  else
    tstDependentes.PageIndex:=6;

  tstEquipamentos.TabVisible := ParSistema.ContratoComServico;
  pgcCadastroClientes.ActivePageIndex:= 0;
  if ParSistema.GerarContabilidade then
  begin
    gbxContabilidade.Visible := true;
    gbxObservacao.Height := 88;
    mmoClientesObservacoes.Height := 57;
    pnlOcultarObservacoesClienteVendedor.Height := 57;
  end
  else
  begin
    gbxContabilidade.Visible := false;
    gbxObservacao.Height := 88 + gbxContabilidade.Height;
    mmoClientesObservacoes.Height := 57 + gbxContabilidade.Height;
    pnlOcultarObservacoesClienteVendedor.Height := 57 + gbxContabilidade.Height;
  end;
  gbxPlanoPadrao.Visible := ParSistema.ClientesComPlanoPadrao;
  pnlOcultarObservacoesClienteVendedor.Visible := ParSistema.OcultarObservacoesClienteVendedor and
                                                  not (UsuarioLogin.AnalistaCredito or UsuarioLogin.Administrador or
                                                       UsuarioLogin.Suporte or UsuarioLogin.GerenteCaixa);
  if pnlOcultarObservacoesClienteVendedor.Visible then
  begin
    mmoClientesObservacoes.ReadOnly := true;
    mmoClientesObservacoes.TabStop  := false;
  end;

  fraConsultaModeloDocto := TfraConsultaCodigoContabil.Create(self);
  fraConsultaModeloDocto.Name := 'ConsultaModeloDocto';
  fraConsultaModeloDocto.edfCodigo.MaxLength := 2;
  fraConsultaModeloDocto.edfCodigo.DataSource := dtmCadastroClientes.dsrSeriesClientes;
  fraConsultaModeloDocto.edfCodigo.DataField := 'modelodoctofiscal';
  fraConsultaModeloDocto.edfCodigo.Operacao := opATRIBUICAO;
  fraConsultaModeloDocto.edfCodigo.LookupSource := fraConsultaModeloDocto.dsrProcuraModeloDoctosFiscais;
  fraConsultaModeloDocto.edfCodigo.LookupField := 'codigo';
  fraConsultaModeloDocto.edfCodigo.LookupQueryParameter := 'codigo';
  fraConsultaModeloDocto.AbrirTabelaProcura := false;
  fraConsultaModeloDocto.TipoPesquisa := pesMODELODOCTOSFISCAIS;
  dbgSerie.OnDelete := dtmCadastroClientes.ExcluirSeriesClientes;
  fraConsultaHistorico.TipoPesquisa:= pesHISTORICOCONTABIL;
  fraConsultaHistoricoPagtoDuplicata.TipoPesquisa:= pesHISTORICOCONTABIL;

  fraDadosLoginSite1.ClienteSite := dtmCadastroClientes.GetCodigoCliente;
  fraDadosLoginSite1.TipoClienteSite := dtmCadastroClientes.GetTipoCliente;

  fraDadosLoginSite1.NomeClienteSite        := dtmCadastroClientes.GetNomeCliente;
  fraDadosLoginSite1.EmailClienteSite       := dtmCadastroClientes.GetEmailCliente;
  fraDadosLoginSite1.TipoPessoaClienteSite  := dtmCadastroClientes.GetTipoPessoa;
  fraDadosLoginSite1.PessoaNumeroClienteSite:= dtmCadastroClientes.GetPessoaNumero;

  fraDadosLoginSite1.EditarFormulario := dtmCadastroClientes.editarClientes;
  dtmCadastroClientes.qryUsuarios_Site := fraDadosLoginSite1.qryUsuarios_Site;
  fraConsultaVendedor.TipoPesquisa := pesVENDEDORES;

  ckbNaoExibirFichaFinanceira.visible := UsuarioLogin.AnalistaCredito or UsuarioLogin.Administrador or UsuarioLogin.Suporte;

  gbxFichaFinanceira.visible := ckbNaoExibirFichaFinanceira.visible;
end;

destructor TfrmCadastroClientes.Destroy;
begin
//  dtmCadastroClientes.Fecha(ctCrediarioClienteCadastro);
//  dtmCadastroClientes.Free;
 // dtmCadastroClientes:=nil;

  if ParSistema.ContratoComServico then
    dtmCadastroEquipamentoslocal:=nil;

  dtmcadastroclientes := nil;
  inherited;
  frmCadastroClientes := nil;


end;

function TfrmCadastroClientes.InternoPesquisar(Titulo:String): Integer;
begin
  Result:= mrCancel;
  with dtmCadastroClientes do begin
    if PermitirProcura then begin
      AbreTabelasConsulta(TipoProcura);
      Result := inherited InternoPesquisar(GetTitulo);
      if Result = mrOK then
        Selecionar(TipoProcura);
      FechaTabelasConsulta(TipoProcura);
    end
  end;
end;

function TfrmCadastroClientes.ExisteInformacao(Parametro: Integer; NomeCampo: String; Value: Variant): Boolean;
begin
  with dtmCadastroClientes do begin
    case TipoProcura of
      tpCLIENTES             : Result := ExisteCliente(NomeCampo, Value);
      tpCONCEITOSCLIENTES    : Result := ExisteConceito(NomeCampo, Value);
      tpESTADOSCLIENTES      : Result := ExisteEstado(NomeCampo, Value);
      tpNATURALCIDADECLIENTES: begin
                                 case Parametro of
                                   0: Result := ExisteEstadoCidade(NomeCampo, Value);
                                  -1: Result := ExisteCidade(NomeCampo, Value);
                                   else  Result := False;
                                 end;
                               end;
      tpCONJUGECLIENTES      : Result := ExisteCliente(NomeCampo, Value);
      tpCARGOSCLIENTES       : Result := ExisteCargo(NomeCampo, Value);
      tpCARGOSCONJUGECLIENTES: Result := ExisteCargo(NomeCampo, Value);
      tpCONTADEBITO,
      tpCONTACREDITO         : Result := ExisteContaContabil(NomeCampo, Value);
      tpPLANOPADRAO          : Result := ExistePlano(NomeCampo, Value)
      else                     Result := False;
    end;
  end;
end;

function TfrmCadastroClientes.GetTitulo: String;
begin
  case TipoProcura of
    tpCLIENTES,
    tpCONJUGECLIENTES      : Result := 'Clientes';
    tpCONCEITOSCLIENTES    : Result := 'Conceitos';
    tpESTADOSCLIENTES      : Result := 'Estados';
    tpNATURALCIDADECLIENTES: Result := 'Cidades';
    tpCARGOSCLIENTES,
    tpCARGOSCONJUGECLIENTES: Result := 'Cargos';
    tpPLANOPADRAO          : Result := 'Planos de Pagamento'
    else                     Result := '';
  end;
end;

function TfrmCadastroClientes.InternoExcluir: Boolean;
begin
  Result:= False;
  if not CtrlOn then begin
    Result:= inherited InternoExcluir;
    if Result then begin
      dtmCadastroClientes.ExcluirCliente;
      pgcCadastroClientes.ActivePage := tstGeral;
      LimparEditDeTempo;
    end;
  end;
end;

function TfrmCadastroClientes.InternoGravar: Boolean;
begin
  Result:= inherited InternoGravar;

  if Result then
    with dtmCadastroClientes do begin
      if ReCalcularTempoMoradia then
        CalcularTempoResidencia(edtResAno.Text,edtResMes.Text);

      if ReCalcularTempoCivil then
        CalcularTempoCivil(edtCivilAno.Text,edtCivilMes.Text);

      if JaTestouEmail or EmailValido(edtClientesEMail.Text) then begin
        if (rbnCasado.Checked {or rbnOutros.Checked}) and
            fracgcoucpf1.rbnFisica.Checked and (not ExisteConjuge and ParSistema.InformarConjugeClienteCasado) then begin
          MensagemAviso(ctCONJUGENAOINFORMADO);
          if not (pgcCadastroClientes.ActivePage = tstConjuge) then
            pgcCadastroClientes.ActivePage := tstConjuge;
          flkConjuge.SetFocus;
        end
        else begin
          if fracgcoucpf1.edtCPFCNPJ.Criticar(ActiveControl <> fracgcoucpf1.edtCPFCNPJ) then begin
            if GravarCliente then
            begin;
              LimparEditDeTempo;
              ReCalcularTempoCivil   := False;
              ReCalcularTempoMoradia := False;
              tstDependentes.TabVisible := ParSistema.ClienteComDependentes;
            end;
          end
          else
            if fracgcoucpf1.edtCPFCNPJ.CanFocus then
               fracgcoucpf1.edtCPFCNPJ.SetFocus;
        end;
      end
      else begin
        if not (pgcCadastroClientes.ActivePage = tstOutrosDados) then
          pgcCadastroClientes.ActivePage := tstOutrosDados;

        edtClientesEMail.SetFocus;
        JaTestouEmail:= False;
      end;
    end;
end;

function TfrmCadastroClientes.InternoIncluir: Boolean;
begin
  Result:= False;
  if not CtrlOn then begin
    Result:= inherited InternoIncluir;
    if Result then begin
       if ParSistema.ContratoComServico then
         dtmCadastroEquipamentoslocal.ReFazConsulta(dtmCadastroEquipamentoslocal.qryEquipamentosCliente,[0],[0]);
       dtmCadastroClientes.IncluirCliente;
       pgcCadastroClientes.ActivePage := tstGeral;
       edtClientesNome.SetFocus;
       LimparEditDeTempo;
       tstDependentes.TabVisible := False;
    end;
  end;
end;

function TfrmCadastroClientes.JanelaPesquisa: TfrmConsultaBasica;
begin
  Result := TfrmConsultaPorCampo.Create(nil);
  case TipoProcura of
    tpCLIENTES,
    tpCONJUGECLIENTES,
    tpCARGOSCLIENTES,
    tpCARGOSCONJUGECLIENTES :
    begin
{     TfrmConsultaPorCampo(Result).ConsultaInterativa := (((TipoProcura = tpCARGOSCLIENTES) or (TipoProcura = tpCARGOSCONJUGECLIENTES))
                                                          and  ParSistema.UsarConsultaInterativa);
//}     TfrmConsultaPorCampo(Result).ConsultaInterativa := False;
     TfrmConsultaPorCampo(Result).UsarParametrosDaTabela := False;
    end;
  else
  begin
    TfrmConsultaPorCampo(Result).ConsultaInterativa     := True;
    TfrmConsultaPorCampo(Result).UsarParametrosDaTabela := True;
  end;
  end;
end;

procedure TfrmCadastroClientes.PosicionarTabelaNoParametro(Ind: Integer; var Continuar: Boolean);
begin
  with dtmCadastroClientes do begin
    if (TipoProcura = tpNATURALCIDADECLIENTES) and (Ind = 0) then
         PosicionarEstado(dtxClientesNaturalEstado.Text)
    else Continuar := PosicionarRegistro(TipoProcura, Ind);
  end;
end;

function TfrmCadastroClientes.TabelaDePesquisa: TZDataSet;
begin
  with dtmCadastroClientes do begin
    case TipoProcura of
      tpCLIENTES,
      tpCONJUGECLIENTES       : Result:= ConsultarCliente;
      tpCONCEITOSCLIENTES     : Result:= ConsultarConceito;
      tpESTADOSCLIENTES       : Result:= ConsultarEstado;
      tpNATURALCIDADECLIENTES : Result:= ConsultarCidade;
      tpCARGOSCLIENTES,
      tpCARGOSCONJUGECLIENTES : Result:= ConsultarCargo;
      tpCONTADEBITO,
      tpCONTACREDITO          : Result := qryConsultaContaContabil;
      tpPLANOPADRAO           : Result := ConsultarPlanoPadrao
      else                      Result:= nil;
    end;
  end;
end;

function TfrmCadastroClientes.TabelaDoParametro(Parametro: Integer): TZDataSet;
begin
  Result := nil;

  with dtmCadastroClientes do begin
    case TipoProcura of
     tpNATURALCIDADECLIENTES:
     begin
        case Parametro of
         0: Result := ConsultarEstadoCidade;
        -1: Result := ConsultarCidade;
         else Result := nil;
        end;
     end;
     tpCLIENTES, tpCONJUGECLIENTES: Result := ConsultarCliente;
     //tpCARGOSCLIENTES, tpCARGOSCONJUGECLIENTES: Result := ConsultarCargo;
    end;
  end;
end;

procedure TfrmCadastroClientes.KeyDown(var Key: Word; Shift: TShiftState);
var
  frmAjuda: TfrmAjuda;
begin
  case key of
    VK_ESCAPE: begin
                  if FormOrigem='' then
                  begin
                    pgcCadastroClientes.ActivePage := tstGeral;
                    LimparEditDeTempo;
                  end
                  else
                  begin
                    frmAjuda := TfrmAjuda(FormExists(FormOrigem));
                    if Assigned(frmAjuda) then
                      frmajuda.BringToFront;
                  end;
               end;
    VK_Return: begin
                  if Shift = [] then begin
                    if ActiveControl = edtClientesPai then begin
                      pgcCadastroClientes.ActivePage:= tstResidencia;
                      fraEnderecoResidencia.mmoRua.SetFocus;
                      Key:= MAXWORD;
                    end
                    else if ActiveControl = edtClientesResTempo then begin
                      pgcCadastroClientes.ActivePage:= tstDadosComerciais;
                      edtClientesEmpresa.SetFocus;
                      Key:= MAXWORD;
                    end
                    else if ActiveControl = fraFoneRamalComercial.edtFoneRamal then begin
                      if tstConjuge.TabVisible then begin
                        pgcCadastroClientes.ActivePage:= tstConjuge;
                        flkConjuge.SetFocus;
                        Key:= MAXWORD;
                      end
                      else begin
                        pgcCadastroClientes.ActivePage:= tstReferencia;
                        edtClientesReferencia.SetFocus;
                        Key:= MAXWORD;
                      end;
                    end
                    else if (ActiveControl = fraFoneRamalConjuge.edtFoneRamal) then begin
                      pgcCadastroClientes.ActivePage:= tstReferencia;
                      edtClientesReferencia.SetFocus;
                      Key:= MAXWORD;
                    end
                    else if ActiveControl = fraFoneRamalReferencia_2.edtFoneRamal then begin
                      pgcCadastroClientes.ActivePage:= tstOutrosDados;
                      edtClientesDependentes.SetFocus;
                      Key:= MAXWORD;
                    end

                    else if ActiveControl = mmoClientesObservacoes then begin
                      pgcCadastroClientes.ActivePage:= tstDependentes;
                      dbgDependentes.SetFocus;
                      Key:= MAXWORD;
                    end
                    else if (ActiveControl = dbgDependentes) then begin
                      pgcCadastroClientes.ActivePage:= tstEquipamentos;
                      dbgEquipamentos.SetFocus;
                      Key:= MAXWORD;
                    end
                    else if (ActiveControl = dbgEquipamentos) then begin
                      pgcCadastroClientes.ActivePage:= tstGeral;
                      fracgcoucpf1.edtCPFCNPJ.SetFocus;
                      Key:= MAXWORD;
                    end;
                  end
                end;
  else
  if alton or (Shift = [ssAlt]) then
    begin
      case key of
      vk_1 : begin
               if tstGeral.TabVisible then
               begin
                 pgcCadastroClientes.ActivePage := tstGeral;
                 fracgcoucpf1.edtCPFCNPJ.SetFocus;
               end;
             end;
      vk_2 : begin
               if tstResidencia.TabVisible then
               begin
                 pgcCadastroClientes.ActivePage := tstResidencia;
                 fraEnderecoResidencia.mmoRua.SetFocus;
               end;
             end;
      vk_3 : begin
               if tstDadosComerciais.TabVisible then
               begin
                 pgcCadastroClientes.ActivePage := tstDadosComerciais;
                 edtClientesEmpresa.SetFocus;
               end;
             end;
      vk_4 : begin
              if tstConjuge.TabVisible then
              begin
                pgcCadastroClientes.ActivePage := tstConjuge;
                flkConjuge.SetFocus;
              end;
             end;
      vk_5 : begin
               if tstReferencia.TabVisible then
               begin
                pgcCadastroClientes.ActivePage := tstReferencia;
                edtClientesReferencia.SetFocus;
               end;
             end;
      vk_6 : begin
               if tstOutrosDados.TabVisible then
               begin
                pgcCadastroClientes.ActivePage := tstOutrosDados;
                edtClientesDependentes.SetFocus;
               end;
             end;
      vk_7 : begin
              if tstDependentes.TabVisible then
              begin
               pgcCadastroClientes.ActivePage := tstDependentes;
               dbgDependentes.SetFocus;
              end;
             end;
      vk_8 : begin
              if tstEquipamentos.TabVisible then
              begin
               pgcCadastroClientes.ActivePage := tstEquipamentos;
               dbgEquipamentos.SetFocus;
              end;
             end;
      vk_9 : begin
              if tstReceitasOculos.TabVisible then
               pgcCadastroClientes.ActivePage := tstReceitasOculos;
             end;

      end;
    end;
  end;

  if (Key = VK_F11) and (pgcCadastroClientes.ActivePage = tstEquipamentos) and (dbgEquipamentos.Columns.Count > 0) then
  begin
    if (Shift = [ssShift]) then Dec(FDbgColumnsIndex)
    else                        Inc(FDbgColumnsIndex);
    if (FDbgColumnsIndex > (dbgEquipamentos.Columns.Count - 1)) then
      FDbgColumnsIndex:= 0
    else if (FDbgColumnsIndex < 0) then
      FDbgColumnsIndex:= (dbgEquipamentos.Columns.Count - 1);
    OrdenePor(dbgEquipamentos.Columns.Items[FDbgColumnsIndex].Field.FieldName);
    AlteraTituloGrid;
  end;
  if not((Key = VK_ESCAPE) and (FormOrigem <> '')) then
   inherited;

end;

procedure TfrmCadastroClientes.edtClientesResTempoEnter(Sender: TObject);
begin
  edtClientesResTempo.ReadOnly:= (edtResMes.Text <> '') or (edtResAno.Text <> '');
  if RecalcularTempoMoradia then begin
    dtmCadastroClientes.CalcularTempoResidencia(edtResAno.Text,edtResMes.Text);
    RecalcularTempoMoradia := False;
  end;
end;

procedure TfrmCadastroClientes.edtClientesCivilDataEnter(Sender: TObject);
begin
  edtClientesCivilData.ReadOnly:= (edtCivilMes.Text <> '') or (edtCivilAno.Text <> '');
  if RecalcularTempoCivil then
  begin
    dtmCadastroClientes.CalcularTempoCivil(edtCivilAno.Text,edtCivilMes.Text);
    ReCalcularTempoCivil := False;
  end;
end;

procedure TfrmCadastroClientes.edtClientesCivilDataExit(Sender: TObject);
begin
  if dtmCadastroClientes.DataCivilInvalida then
  begin
    MensagemAviso(Format(ctDATAINCOMPATIVELDATANASCTO,['civil']));
    edtClientesCivilData.SetFocus;
  end;
end;

