procedure TfrmCadastroClientes.dbgContatosKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if Key = VK_Space then
      dtmCadastroClientes.TurnMailMarketing;

  if Shift = [ssCtrl] then
    case Key of
      TeclaInserirRegistro: AcionaCadastroContatos(False);
      TeclaEditarRegistro : AcionaCadastroContatos(True);
    end;
end;

