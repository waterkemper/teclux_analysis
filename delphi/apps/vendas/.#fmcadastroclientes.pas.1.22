//-------- Dependentes ---------------------------------------------------------
procedure TfrmCadastroClientes.AcionaCadastroDependentesClientes(Editar:Boolean);
begin
  if not (dtmCadastroClientes.qryClientes.State = dsinsert) then
  begin
    frmCadastroDependentesClientes:=TfrmCadastroDependentesClientes.Create(frmCadastroDependentesClientes);
    with frmCadastroDependentesClientes do
    begin
     DataSet := dtmCadastroClientes.TabelaDependentesClientes;
     SetDataModulo(dtmCadastroClientes);
     dtmCadastroClientes.IncluirDependentesClientes(Editar);
     ShowModal;
     frmCadastroDependentesClientes.free;
     Application.BringToFront;
     Self.SetFocus;
    end;
  end
  else
  begin
    MensagemAviso('O cliente deve ser cadastrado antes!');
    pgcCadastroClientes.ActivePage := tstGeral;
  end;
end;
//-------------- Equipamentos ----------------------------------------------------              
procedure TfrmCadastroClientes.AcionaCadastroEquipamentosClientes(Editar: Boolean);
begin
  OrigemEquipamento := 'Cadastro de Clientes';
  if not (dtmCadastroClientes.qryClientes.State = dsinsert) then
  begin
    FormOrigemBloqueio := self.name;
    if assigned(frmCadastroEquipamentoslocal) then
      frmCadastroEquipamentoslocal := nil;

    frmCadastroEquipamentoslocal:= TfrmCadastroEquipamentos.Create(self);


    with frmCadastroEquipamentoslocal do
    begin
     //dtmCadastroEquipamentos := dtmCadastroEquipamentoslocal;
     DataSet:= dtmCadastroEquipamentoslocal.qryEquipamentos;
     SetDataModulo(dtmCadastroEquipamentoslocal);
     dtmCadastroEquipamentoslocal.IncluirEquipamento(Editar);
     //edfCodigo.exist;
    end;
    BloquearFormularios(frmCadastroEquipamentoslocal.name);
  end
  else
  begin
    MensagemAviso('O cliente deve ser cadastrado antes!');
    pgcCadastroClientes.ActivePage := tstGeral;
  end;



end;

procedure TfrmCadastroClientes.dbgEquipamentosKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  case Key of
    TeclaInserirRegistro: if (Shift=[ssCtrl]) then AcionaCadastroEquipamentosClientes(False);
    TeclaEditarRegistro : if (Shift=[ssCtrl]) then AcionaCadastroEquipamentosClientes(True);
  end;
end;

procedure TfrmCadastroClientes.dbgEquipamentosDblClick(Sender: TObject);
begin
  inherited;
  AcionaCadastroEquipamentosClientes(True);
end;

procedure TfrmCadastroClientes.flkConjugeMessage(var Msg: String);
begin
  inherited;
  Msg:= 'O código ' + flkConjuge.Text + ' não está cadastrado, está inativo, ou' + #10#13 +
        'ou possui o mesmo sexo.';
end;

procedure TfrmCadastroClientes.edfCodigoClienteFound(Found: Boolean);
begin
  inherited;
  if not rbnCasado.Checked and not rbnOutros.Checked then
    if (pgcCadastroClientes.ActivePage = tstConjuge) then begin
      pgcCadastroClientes.ActivePage := tstGeral;
      edtClientesNome.SetFocus;
    end;
  if FormOrigem <> '' then
    lblEnderecoDesatualizado.Visible := True
  else
  if dtmCadastroClientes.CartaDevolvida(ClassName) then
    lblEnderecoDesatualizado.Visible := True;

  tstDependentes.TabVisible := ParSistema.ClienteComDependentes;

  pgcCadastroClientes.ActivePage := tstGeral;
end;

procedure TfrmCadastroClientes.fraEnderecoResidenciasbnRuaClick(
  Sender: TObject);
begin
  inherited;
  fraEnderecoResidencia.sbnRuaClick(Sender);

end;

procedure TfrmCadastroClientes.OperacaoPadrao(Value: array of Variant);
begin
  inherited;

  edfCodigoCliente.SetFocus;
  edfCodigoCliente.Text := Value[0];
  dtmCadastroClientes.ReFazConsultaCliente(Value[0]);
  edfCodigoClienteFound(True);

  if (high(Value)=2) then
  begin
    application.ProcessMessages;
    close;
  end;  
end;

