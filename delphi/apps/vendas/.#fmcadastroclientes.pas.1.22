procedure TfrmCadastroClientes.AcionaCadastroContatos(Editando: Boolean);
begin
  if not assigned(frmcadastrocontatos) then
  begin
    frmcadastrocontatos := Tfrmcadastrocontatos.Create(frmcadastrocontatos);
    frmcadastrocontatos.DataSet := dtmCadastroClientes.qryContatosClientes;
    frmcadastrocontatos.dsrContatos.DataSet := dtmCadastroClientes.qryContatosClientes;
  end;

  if not Editando then
    frmcadastrocontatos.dsrContatos.DataSet.Append;

  frmcadastrocontatos.ShowModal;

  frmcadastrocontatos.free;

end;

