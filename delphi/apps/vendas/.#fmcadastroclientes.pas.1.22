procedure TfrmCadastroClientes.ClientesAfterPost(Sender: TObject);
begin
  if(ParSistema.ContratoComServico) then
    AtualizaEquipamentosCliente;
end;

procedure TfrmCadastroClientes.AtualizaEquipamentosCliente;
var
  cliente: integer;
begin
  if ParSistema.ContratoComServico then
  begin
    if dtmCadastroClientes.qryClientescodigo.AsInteger > 0 then
      cliente:=dtmCadastroClientes.qryClientescodigo.AsInteger
    else
      cliente:=0;
    dtmCadastroEquipamentoslocal.RefazConsultaEquipamentosClientes(cliente);
    dtmCadastroEquipamentoslocal.Cliente:=dtmCadastroClientes.qryClientescodigo.AsInteger;
    dtmCadastroEquipamentoslocal.TabelaClientes:=dtmCadastroClientes.qryClientes;
  end;
end;

procedure TfrmCadastroClientes.ClientesAfterClose(Sender: TObject);
begin
  if (ParSistema.ContratoComServico) then
    dtmCadastroEquipamentoslocal.FechaEquipamentosCliente;
end;

