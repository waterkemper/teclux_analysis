procedure TfrmCadastroContratos.dbgServicosKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if (Shift = [ssCtrl]) then
    if dbgServicos.Focused then
      case Key of
        TeclaInserirRegistro: IncluirEditarServicosContrato(False);
        TeclaEditarRegistro : IncluirEditarServicosContrato(True);
        VK_Space           : dtmCadastroContratos.MarcarServicoRetencaoISSQN;
      end;

end;

