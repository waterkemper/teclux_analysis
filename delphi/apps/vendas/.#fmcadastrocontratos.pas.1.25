procedure TfrmCadastroContratos.SelecionarContrato(Contratos: Array of String);
var
  a: Integer;
begin
  for a := 0 to High(Contratos) do
    if Contratos[a] = dtmCadastroContratos.NumeroContrato then
    begin
      try
        dtmCadastroContratos.RefazConsultaContrato;
        break;
      except
      end;  
    end
end;

procedure TfrmCadastroContratos.SelecionarContrato(
  Contrato: String);
begin
  dtmCadastroContratos.RefazConsultaContrato(Contrato);
end;

