end;

procedure PreencherFindsLookup(Frm: TfrmCadastroContratos);
begin
  SetLength(FindsLookup, 16);
  FindsLookup[00] := Frm.flkCodigoCliente;
  FindsLookup[01] := Frm.flkEstadoID;
  FindsLookup[02] := Frm.flkNaturalCidadeCliente;
  FindsLookup[03] := Frm.flkCargoClientes;
  FindsLookup[04] := Frm.flkConjuge;
  FindsLookup[05] := Frm.flkCargoConjuge;
  FindsLookup[06] := Frm.flkConceitoClientes;
  FindsLookup[07] := Frm.flkAvalista;
  FindsLookup[08] := Frm.flkVendedor;
  FindsLookup[09] := Frm.flkAgentes;
  FindsLookup[10] := Frm.flkFilialVenda;
  FindsLookup[11] := Frm.flkFilialMontagem;
  FindsLookup[12] := Frm.flkCodigoDependente;
  FindsLookup[13] := Frm.flkCFPS;
  FindsLookup[14] := Frm.flkCodigoClienteBonus;

end;

procedure TfrmCadastroContratos.ProximoControle(Ind: Integer);
begin
  inherited;
  if CtrlOn then begin
    if Ind = 0 then
      dtmCadastroContratos.PosicionarCidade
  end
  else
  if Ind = 0 then
  begin
    Jan.ConsultaInterativa := True;
    dtmCadastroContratos.AbreConsultaContrato;
  end;
{  else
    Jan.ConsultaInterativa := False;}
end;

procedure TfrmCadastroContratos.ReservarContrato;
begin
  if MensagemConfirmacao(ctCONFIRMERESERVA) = smbOK then begin
    dtmCadastroContratos.SituacaoContrato := scRESERVADO;
    if Not InternoGravar then begin
      CancelarAlteracoes;
      SetFocus
    end
  end
end;

procedure TfrmCadastroContratos.sbnAlterarSituacaoClick(Sender: TObject);
begin
  inherited;
  case dtmCadastroContratos.SituacaoContrato of
    scORCADO:    ReservarContrato;
    scRESERVADO: FaturarContrato;
    scFATURADO,
    scNOTAPARCIAL: DocumentoFiscaisContrato;
  end;
  dtxNomeSituacao.Refresh;
  dbgProdutos.Refresh;
end;

procedure TfrmCadastroContratos.sbnCopiarContratoClick(Sender: TObject);
begin
  inherited;
  if dtmCadastroContratos.qryContratos.Active then
    if dtmCadastroContratos.CopiarContrato then
    begin
      dtmCadastroContratos.CalcularValorTotalProdutos;
      PrecisaReCalcularParcelas := True
    end;
end;

procedure TfrmCadastroContratos.sbnEnviarOrcamentoClick(Sender: TObject);
begin
  inherited;
    EmailContato:= dtmCadastroContratos.qryContatosemail.AsString;
    Contato:= dtmCadastroContratos.qryContatoscontato.AsString;
    frmEnviarEmail:= TfrmEnviarEmail.Create(frmEnviarEmail,UsuarioLogin.HostSmtp, EmailContato, Contato,UsuarioLogin.Assunto);
    try
      with frmEnviarEmail do
      begin
        Data        := dtmCadastroContratos.DataServidor;
        Empresa     := PrimeiraLetraEmMaiuscula(dtmCadastroContratos.NomeFilialBase);
        Msg         := dtmCadastroContratos.MontarOrcamento;
        ShowModal;
      end;
    finally
      frmEnviarEmail.Free;
    end;
    edfNumeroContrato.SetFocus;
end;


