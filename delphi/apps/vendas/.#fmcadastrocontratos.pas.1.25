procedure TfrmCadastroContratos.IncluirCliente;
var
  i, iCliente: Integer;
begin
  frmClientesContrato := TfrmClientesContrato.Create(frmClientesContrato);
  try
    iCliente := dtmCadastroContratos.CodigoCliente;
    dtmCadastroContratos.RefazConsultaCliente(0);
    i := frmClientesContrato.ShowModal;
  finally
    frmClientesContrato.Free;
  end;
  if i = mrAbort then
    dtmCadastroContratos.RefazConsultaCliente(iCliente)
  else if i = mrCancel then
    dtmCadastroContratos.Fecha(ctVendaTabelaCadastroClientes)
  else if i = mrOk then
    dtmCadastroContratos.AtribuirClienteExpress;
  flkCodigoCliente.SetFocus;
end;

