procedure TfrmCadastroContratos.sbnExibirColunasClick(Sender: TObject);
begin
  inherited;
  // Montagem
  dbgProdutos.ColumnByName('montagem').Visible    := not dbgProdutos.ColumnByName('montagem').Visible;
  // Entrega
  dbgProdutos.ColumnByName('entrega').Visible    := not dbgProdutos.ColumnByName('entrega').Visible;
  // Brinde
  dbgProdutos.ColumnByName('brinde').Visible     := not dbgProdutos.ColumnByName('brinde').Visible;

  // Quantidade em Estoque.
  dbgProdutos.ColumnByName('emestoque').Visible    := not dbgProdutos.ColumnByName('emestoque').Visible;
  if ParSistema.TamanhoMascaraQuantidade > 30 then
    dbgProdutos.ColumnByName('emestoque').Width    := ParSistema.TamanhoMascaraQuantidade
  else dbgProdutos.ColumnByName('emestoque').Width := 30;

  // Quantidade em Reserva.
  dbgProdutos.ColumnByName('reservado').Visible    := not dbgProdutos.ColumnByName('reservado').Visible;
  if ParSistema.TamanhoMascaraQuantidade > 30 then
    dbgProdutos.ColumnByName('reservado').Width    := ParSistema.TamanhoMascaraQuantidade
  else dbgProdutos.ColumnByName('reservado').Width := 30;

  // Quantidade em Futuro.
  dbgProdutos.ColumnByName('futuro').Visible    := not dbgProdutos.ColumnByName('futuro').Visible;
  if ParSistema.TamanhoMascaraQuantidade > 30 then
    dbgProdutos.ColumnByName('futuro').Width    := ParSistema.TamanhoMascaraQuantidade
  else dbgProdutos.ColumnByName('futuro').Width := 30;

  // Quantidade a ser Copiada.
  dbgProdutos.ColumnByName('qtdecopiar').Visible    := not dbgProdutos.ColumnByName('qtdecopiar').Visible;
  if ParSistema.TamanhoMascaraQuantidade > 30 then
    dbgProdutos.ColumnByName('qtdecopiar').Width    := ParSistema.TamanhoMascaraQuantidade
  else dbgProdutos.ColumnByName('qtdecopiar').Width := 30;

end;

