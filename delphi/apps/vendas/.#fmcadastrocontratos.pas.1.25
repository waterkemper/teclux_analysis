type
  TtecTabelasConsulta = array[TtecContratoTipoConsulta] of record
    TipoConsulta: integer;
    Titulo: String;
  end;

const
  ctTabelasConsulta: TtecTabelasConsulta =
    ((TipoConsulta: ctVendaTabelaConsultaContratos;      Titulo:'Contratos'),
     (TipoConsulta: ctVendaTabelaConsultaClientes;       Titulo:'Clientes'),
     (TipoConsulta: ctVendaTabelaConsultaEstados;        Titulo:'Estados'),
     (TipoConsulta: ctVendaTabelaConsultaCidades;        Titulo:'Naturalidades'),
     (TipoConsulta: ctVendaTabelaConsultaCargos;         Titulo:'Cargos'),
     (TipoConsulta: ctVendaTabelaConsultaConjuge;        Titulo:'Conjuges'),
     (TipoConsulta: ctVendaTabelaConsultaCargos;         Titulo:'Cargos do conjuge'),
     (TipoConsulta: ctVendaTabelaConsultaConceitos;      Titulo:'Conceitos'),
     (TipoConsulta: ctVendaTabelaConsultaClientes;       Titulo:'Avalistas'),
     (TipoConsulta: ctVendaTabelaConsultaVendedores;     Titulo:'Vendedores'),
     (TipoConsulta: ctvendatabelaconsultaAgentes;        Titulo:'Agentes'),
     (TipoConsulta: ctVendaTabelaConsultaFiliais;        Titulo:'Filiais de Venda'),
     (TipoConsulta: ctVendaTabelaConsultaFiliais;        Titulo:'Filiais de montagens'),
     (TipoConsulta: ctVendaTabelaConsultaDependentes;    Titulo:'Dependentes'),
     (TipoConsulta: ctVendaTabelaConsultaCFPS;           Titulo:'C.F.P.S.'),
     (TipoConsulta: ctVendaTabelaConsultaClientes;       Titulo:'Cliente Bônus'),
     (TipoConsulta: ctVendaTabelaConsultaClientesTroca;  Titulo:'Cliente Troca'),
     (TipoConsulta: ctVendaTabelaConsultaListaCasamento; Titulo:'Listas de casamento'));
var
  sbnExcluirCaption: String;
  FindsLookup: array of TtecDBFindLookup;

procedure PreencherFindsLookup(Frm: TfrmCadastroContratos); forward;

procedure TfrmCadastroContratos.aclHabilitarUpdate(Action: TBasicAction; var Handled: Boolean);
begin
  sbnImportarPedidoDaico.Visible := TtecImportacaoProdContratosePedidos(ParSistema.ImportacaoProdContratosePedidos) <> ipcpNENHUMA;

  gbxTempo.Enabled      := rbnEstadoCivilCasado.Checked and Not dtmCadastroContratos.ReadOnly;
  tstConjuge.TabVisible := (fracgcoucpf.rbnFisica.Checked and (rbnEstadoCivilCasado.Checked or
                                                               rbnEstadoCivilOutros.Checked));
  if rbnTipoResPropria.Checked then
  begin
    if ((edtClientesResOnus.Text<>'') and
        (edtClientesResOnus.Enabled)) then
    begin
      edtClientesResOnus.Clear;
      edtClientesResOnus.Enabled := False;
    end;
  end
  else
  begin
   if not edtClientesResOnus.Enabled then
     edtClientesResOnus.Enabled := Not dtmCadastroContratos.ReadOnly;
  end;

  if fracgcoucpf.rbnFisica.Checked then
    lblDocumentoID.Caption:= 'Documento'
  else
    lblDocumentoID.Caption:= 'Insc. Estadual';
  sbnResgatarBonus.Visible := (dtmCadastroContratos.CodigoClienteBonus <> 0) and
                              (dtmCadastroContratos.SituacaoContrato < scFATURADO);


end;

procedure TfrmCadastroContratos.Activate;
begin
  inherited;
//  LerValoresCalculoFinanciamento
end;

procedure TfrmCadastroContratos.AlterarEstadoBotoes;
begin
  inherited;
//  dtmCadastroContratos.RefazConsultaProdutosEntregar;
  sbnAlterarSituacao.Caption  := vstrAlterarSituacaoContrato[dtmCadastroContratos.SituacaoContrato] + ' F11';
  if dtmCadastroContratos.Bloqueado then
    sbnAlterarSituacao.Enabled := False
  else if dtmCadastroContratos.Alterado then
    sbnAlterarSituacao.Enabled  := false
  else if (dtmCadastroContratos.SituacaoContrato = scFATURADO) and dtmCadastroContratos.PermitiEmitirNota then
    sbnAlterarSituacao.Enabled  := True
  else if dtmCadastroContratos.SituacaoContrato = scNOTAPARCIAL then
    sbnAlterarSituacao.Enabled  := True
  else if dtmCadastroContratos.SituacaoContrato < scFATURADO then
    sbnAlterarSituacao.Enabled  := True
  else
    sbnAlterarSituacao.Enabled  := False;
  sbnDevolverprodutos.Visible:= (dtmCadastroContratos.SituacaoContrato < scFATURADO);
  sbnAlterarSituacao.Hint     := vstrHintSituacaoContrato[dtmCadastroContratos.SituacaoContrato];
  sbnExcluir.Enabled          := (dtmCadastroContratos.SituacaoContrato <= scFATURADO) and
                                 Not (dtmCadastroContratos.Bloqueado or dtmCadastroContratos.Alterado);
  sbnImprimirContrato.Enabled := (dtmCadastroContratos.SituacaoContrato < scCANCELADO) and not sbnSalvar.Enabled;
  sbnCopiarContrato.Enabled   := (dtmCadastroContratos.SituacaoContrato <= scRESERVADO) and
                                 not dtmCadastroContratos.ContratoInserindo and
                                 not dtmCadastroContratos.InseriuProduto and (dtmCadastroContratos.ContratosRecordCount > 0);
  sbnEnviarOrcamento.Enabled  := (dtmCadastroContratos.SituacaoContrato <= scFATURADO) and not sbnSalvar.Enabled and
                                 (dtmCadastroContratos.ContratosRecordCount > 0);
  sbnExibirColunas.Visible    := (dtmCadastroContratos.SituacaoContrato <= scRESERVADO);
  sbnSelecionarTodosProdutosImpressao.Visible:= (dtmCadastroContratos.SituacaoContrato = scFATURADO);
  if (dtmCadastroContratos.SituacaoContrato = scORCADO) or
     (dtmCadastroContratos.SituacaoContrato = scNENHUM)
  then
    sbnExcluir.Caption := sbnExcluirCaption
  else
    sbnExcluir.Caption := 'Cancelar F6';
  if dtmCadastroContratos.SituacaoContrato = scCANCELADO then begin
    dtxNomeSituacao.Font.Color    := clRed;
    dtxMotivoCancelamento.Visible := True;
  end else begin
    dtxNomeSituacao.Font.Color := Font.Color;
    dtxMotivoCancelamento.Visible := False;
  end;
  if dtmCadastroContratos.Bloqueado then
    HabilitarBotoesFormaPagamento(False)
  else if dtmCadastroContratos.SituacaoContrato > scFATURADO then
    HabilitarBotoesFormaPagamento(False)
  else
    HabilitarBotoesFormaPagamento(True);
  sbnCopiarProdutos.Visible := (dtmCadastroContratos.SituacaoContrato < scFATURADO) or
                               (dtmCadastroContratos.SituacaoContrato = scNENHUM);
  sbnGravarReceitaOculos.Enabled := (dtmCadastroContratos.SituacaoContrato >= scFATURADO) and
                                    (dtmcadastrocontratos.SituacaoContrato <> scNENHUM);
end;

procedure TfrmCadastroContratos.CalcularFinanciamento;
var
  Parcelas: TResumosParcelas;
  TotalCalcular: Currency;
  ValorPrazo,
  TaxaJuros,
  Desconto: Real;
  plano : integer;
  mensagem: String;
begin
  inherited;
  mensagem := '';
  Parcelas := nil;
  if (dtmCadastroContratos.SituacaoContrato < scFATURADO) and (not dtmCadastroContratos.ReadOnly) then
  begin
    frmCalculoFinanciamento := TfrmCalculoFinanciamento(TfrmCalculoFinanciamento.Referencia);
    if Assigned(frmCalculoFinanciamento) then
      frmCalculoFinanciamento.SetFocus
    else
    begin
      dtmCadastroContratos.EditarContrato;
      if ParSistema.GerarParcelaSubstituicaoTributaria then
        TotalCalcular:= dtmCadastroContratos.TotalProdutos +
                        dtmCadastroContratos.TotalIPI +
                        (dtmCadastroContratos.TotalServicos -
                         dtmCadastroContratos.ImpostoRetido)
      else
        TotalCalcular:= dtmCadastroContratos.TotalProdutos +
                        dtmCadastroContratos.TotalIPI +
                        dtmCadastroContratos.ValorICMSSubstTributaria +
                        (dtmCadastroContratos.TotalServicos -
                         dtmCadastroContratos.ImpostoRetido);

      if ((dtmCadastroContratos.TotalContrato - dtmcadastrocontratos.CreditoTroca)<>0) then 
      begin
        dtmCadastroContratos.ResumoParcelas(Parcelas);
        frmCalculoFinanciamento := TfrmCalculoFinanciamento.Create(Owner, True);
        frmCalculoFinanciamento.OntecClose    := OnCloseCalculoFinanciamento;


        frmCalculoFinanciamento.DefinirValoresCalculo(PrecisaReCalcularParcelas,
                                                      TotalCalcular,
                                                      dtmCadastroContratos.Frete,
                                                      dtmCadastroContratos.Seguro,
                                                      dtmCadastroContratos.DescontoContrato,
                                                      dtmCadastroContratos.CreditoTroca,
                                                      dtmCadastroContratos.ValorICMSSubstTributaria,
                                                      dtmCadastroContratos.PlanoUtilizado,
                                                      dtmCadastroContratos.DataAbertura,
                                                      dtmCadastroContratos.EstadoCliente,
                                                      Parcelas,
                                                      Grupos,
                                                      Classes,
                                                      dtmCadastroContratos.PermiteDesconto,
                                                      dtmCadastroContratos.TotalDesconto);

        Parcelas := nil;
      end
      else
      begin
        if (ParSistema.PlanoVendaVista = 0) then
          MensagemAviso(ctNENHUMPLANOVENDAAVISTA)
        else
        begin
          PrecisaReCalcularParcelas := false;
          valorprazo := 0;
          taxajuros := 0;
          desconto := 0;
          plano := ParSistema.PlanoVendaVista;
          dtmCadastroContratos.DefinirParcelas(Parcelas, valorprazo, taxajuros, desconto, plano);

          if ParSistema.PermitirAlterarBrindenoContrato then
            if dtmCadastroContratos.FSomenteBrindes and (dtmCadastroContratos.ValorICMSSubstTributaria = 0) then
              mensagem := ctPRODUTOCONTRATOBRINDE;

          if mensagem='' then
            Mensagem := ctSALDOCOBERTOPORCREDITO;

          MensagemAviso(mensagem)

        end;
      end;
    end;
  end;
end;

procedure TfrmCadastroContratos.CancelarAlteracoes;
begin
  if ValidouDados then
  begin
    dtmCadastroContratos.CancelarAlteracoesContrato;
//    dtmCadastroContratos.RefazConsultaProdutosEntregar;
    PrecisaReCalcularParcelas := False;
    flkNaturalCidadeCliente.Exist;
  end
  else
    if dtmCadastroContratos.SituacaoContrato <> dtmCadastroContratos.situacaoant then
    begin
      dtmCadastroContratos.SituacaoContrato := dtmCadastroContratos.situacaoant;
      dtmcadastrocontratos.cancelaredicaocontrato;
      dtxNomeSituacao.Refresh;
    end;

  if (dtmCadastroContratos.SituacaoContrato in [scORCADO, scRESERVADO, scNENHUM]) then
    sbnExcluir.Caption := sbnExcluirCaption
  else
    sbnExcluir.Caption := 'Cancelar F6';
  sbnAlterarSituacao.Caption  := vstrAlterarSituacaoContrato[dtmCadastroContratos.SituacaoContrato] + ' F11';
  if dtmCadastroContratos.Bloqueado then
    sbnAlterarSituacao.Enabled := False
  else if dtmCadastroContratos.Alterado then
    sbnAlterarSituacao.Enabled  := false
  else if (dtmCadastroContratos.SituacaoContrato = scFATURADO) and dtmCadastroContratos.PermitiEmitirNota then
    sbnAlterarSituacao.Enabled  := True
  else if dtmCadastroContratos.SituacaoContrato = scNOTAPARCIAL then
    sbnAlterarSituacao.Enabled  := True
  else if dtmCadastroContratos.SituacaoContrato < scFATURADO then
    sbnAlterarSituacao.Enabled  := True
  else
    sbnAlterarSituacao.Enabled  := False;
  sbnAlterarSituacao.Hint     := vstrHintSituacaoContrato[dtmCadastroContratos.SituacaoContrato];
  sbnExcluir.Enabled          := (dtmCadastroContratos.SituacaoContrato <= scFATURADO) and
                                 Not dtmCadastroContratos.Bloqueado;
  sbnImprimirContrato.Enabled := dtmCadastroContratos.SituacaoContrato < scCANCELADO;
  if dtmCadastroContratos.Bloqueado then
    HabilitarBotoesFormaPagamento(False)
  else if dtmCadastroContratos.SituacaoContrato > scFATURADO then
    HabilitarBotoesFormaPagamento(False)
  else
    HabilitarBotoesFormaPagamento(True);
  LimparTempos;
  dtmCadastroContratos.MontarListaGruposClasses(Grupos, Classes);
end;

function TfrmCadastroContratos.ComplementarNota: Boolean;
begin
  frmComplementarNotaFiscalSaida := TfrmComplementarNotaFiscalSaida.Create(frmComplementarNotaFiscalSaida);
  try
    dtmCadastroContratos.AtribuirTotais_Peso_e_Volumes;
    frmComplementarNotaFiscalSaida.dtmContratos := dtmCadastroContratos;
    Result := frmComplementarNotaFiscalSaida.ShowModal = mrOk;
  finally
    frmComplementarNotaFiscalSaida.Free
  end
end;

constructor TfrmCadastroContratos.Create(AOwner: TComponent);
var
  CollItem: TtecControlItem;
begin
try
  dtmCadastroContratos := TdtmCadastroContratos.Create(Self, False);
  inherited;
  sbnExcluirCaption    := sbnExcluir.Caption;
  dtmCadastroContratos.OnComplementarNota := ComplementarNota;
//  dtmCadastroContratos.Abre(ctVendaTabelaCadastroContrato);
  DataSet := dtmCadastroContratos.TabelaContratos;
  pgcContratos.ActivePage:= tstCliente;
  pgcCadastroClientes.ActivePage := tstClienteGeral;
  pnlAvalista.Visible := ParSistema.PermiteAvalista;
  pnlAnalista.Visible := dtmCadastroContratos.ExigeAnalistaCredito;
  ReCalcularTempoCivil  := False;
  ReCalcularTempoMoradia:= False;

  JaTestouEmail := False;
  
  PreencherFindsLookup(Self);
  flkVendedor.Enabled := Not UsuarioLogin.Vendedor;
  if UsuarioLogin.Vendedor then
  begin
    CollItem := TtecControlItem(edfNumeroContrato.NoSetControls.Add);
    CollItem.Control := flkVendedor;
    dtmCadastroContratos.VendedorDefault := UsuarioLogin.CodigoUsuario;
    dtxNomeVendedor.Width := dtxNomeVendedor.Width + dtxNomeVendedor.Left - flkVendedor.Left;
    dtxNomeVendedor.Left := flkVendedor.Left;
    dtxNomeVendedor.BringToFront;
  end;
  flkFilialVenda.Enabled := UsuarioLogin.AlterarFilialVenda;
  if Not UsuarioLogin.AlterarFilialVenda then
  begin
    dtxFilialVenda.Left  := flkFilialVenda.Left;
    dtxFilialVenda.Width := dtxFilialVenda.Width + dtxFilialVenda.Left - flkFilialVenda.Left;
    dtxFilialVenda.BringToFront;
  end;
  if ParSistema.ClientePessoaJuridica then
  begin
    tstResidencia.Caption     := '  &2. Endereço';
    tstDadosComerciais.Caption:= '  &3. Praça Pagto.';
    tstReferencia.Caption     := '  &5. Entrega';
  end
  else
  begin
    tstResidencia.Caption     := '  &2. Residência';
    tstDadosComerciais.Caption:= '  &3. Comercial';
    tstReferencia.Caption     := '  &5. Referência';
  end;

  tstReceitaOculos.TabVisible  := ParSistema.ANEXOCONTRATORECEITAOCULOS;
  tstEquipamentos.TabVisible   := ParSistema.ContratoComServico or parsistema.NotaFiscalConjugada;
  tstServico.TabVisible        := ParSistema.ContratoComServico or parsistema.NotaFiscalConjugada;

  pnlServicos.Visible   := ParSistema.ContratoComServico or parsistema.NotaFiscalConjugada;
  pnlIPI.Visible        := dtmCadastroContratos.ContribIPI;
  pnlSaldoTroca.Visible := ParSistema.utilizarcreditotrocacontrato;

  lblCodigoDependente.Visible  := ParSistema.ClienteComDependentes;
  flkCodigoDependente.Visible  := ParSistema.ClienteComDependentes;
  sbnProcuraDependente.Visible := ParSistema.ClienteComDependentes;
  dtxDependentesNome.Visible   := ParSistema.ClienteComDependentes;

  {
  if not lblCodigoDependente.Visible then
    gbxNomeCliente.Height := 110
  else gbxNomeCliente.Height := 127;
  }


  lblClienteBonus.Visible          := ParSistema.UtilizarFidelidade;
  flkCodigoClienteBonus.Visible    := lblClienteBonus.Visible;
  sbnProcurarClientesBonus.Visible := lblClienteBonus.Visible;
  dtxNomeClienteBonus.Visible     := lblClienteBonus.Visible;

  if lblCodigoDependente.Visible and not lblClienteBonus.Visible then
  begin
    lblCodigoDependente.Top  := lblClienteBonus.Top;
    flkCodigoDependente.Top  := flkCodigoClienteBonus.Top;
    sbnProcuraDependente.Top := sbnProcurarClientesBonus.Top;
    dtxDependentesNome.Top   := dtxNomeClienteBonus.Top;
  end;


//  sbnFormaPagCheque.Visible   := ParSistema.TipoTEF <> tsSEMTEF;
(*  sbnFormaPagCredito.Visible  := ParSistema.TipoTEF <> tsSEMTEF;
  sbnFormaPagDebito.Visible   := ParSistema.TipoTEF <> tsSEMTEF;
  sbnFormaPagDinheiro.Visible := ParSistema.TipoTEF <> tsSEMTEF;
  sbnFormaPagCDC.Visible      := ParSistema.TipoTEF <> tsSEMTEF;
*)
//  sbnFormaPagCheque.Enabled   := ParSistema.TipoTEF <> tsSEMTEF;
(*  sbnFormaPagCredito.Enabled  := ParSistema.TipoTEF <> tsSEMTEF;
  sbnFormaPagDebito.Enabled   := ParSistema.TipoTEF <> tsSEMTEF;
  sbnFormaPagDinheiro.Enabled := ParSistema.TipoTEF <> tsSEMTEF;
  sbnFormaPagCDC.Enabled      := ParSistema.TipoTEF <> tsSEMTEF;
*)
//  dbgProdutos.Columns[1].Visible := Not ParSistema.FiliaisIndependentes;
  dbgProdutos.ColumnByName('filial').Visible := Not ParSistema.FiliaisIndependentes;

  dbgProdutos.ColumnByName('valorgrade1').Visible := ParSistema.UsarGradesProdutos;
  dbgProdutos.ColumnByName('valorgrade2').Visible := ParSistema.UsarGradesProdutos;

  dbgProdutos.ColumnByName('situacao_produto').Visible := ParSistema.VisualizarSituacaoProdutos;

  if dbgProdutos.ColumnByName('quantidade').Width < Parsistema.TamanhoMascaraQuantidade then
     dbgProdutos.ColumnByName('quantidade').Width := ParSistema.TamanhoMascaraQuantidade;

  if dbgProdutos.ColumnByName('cancelado').Width < Parsistema.TamanhoMascaraQuantidade then
     dbgProdutos.ColumnByName('cancelado').Width := ParSistema.TamanhoMascaraQuantidade;

  if dbgProdutos.ColumnByName('emestoque').Width < Parsistema.TamanhoMascaraQuantidade then
     dbgProdutos.ColumnByName('emestoque').Width := ParSistema.TamanhoMascaraQuantidade;

  if dbgProdutos.ColumnByName('reservado').Width < Parsistema.TamanhoMascaraQuantidade then
     dbgProdutos.ColumnByName('reservado').Width := ParSistema.TamanhoMascaraQuantidade;

  if dbgProdutos.ColumnByName('futuro').Width < Parsistema.TamanhoMascaraQuantidade then
     dbgProdutos.ColumnByName('futuro').Width := ParSistema.TamanhoMascaraQuantidade;

  if dbgProdutos.ColumnByName('qtdecopiar').Width < Parsistema.TamanhoMascaraQuantidade then
     dbgProdutos.ColumnByName('qtdecopiar').Width := ParSistema.TamanhoMascaraQuantidade;

  dtmCadastroContratos.OnScrollLinhaColunaGrade := AfterScrollLinhaColunaGrade;

  dtmCadastroContratos.OnScrollBloquearContrato := OnScrollBloquearContrato;


  dtmCadastroContratos.PrecisaRecalcularParcelas := AtualizaRecalculoParcelas;

  pnlOcultarObservacoesClienteVendedor.Visible := ParSistema.OcultarObservacoesClienteVendedor and
                                                  not (UsuarioLogin.AnalistaCredito or UsuarioLogin.Administrador or
                                                       UsuarioLogin.Suporte or UsuarioLogin.GerenteCaixa);
  pnlOcultarObservacoesClienteVendedor2.Visible := pnlOcultarObservacoesClienteVendedor.Visible;
  if pnlOcultarObservacoesClienteVendedor.Visible then
  begin
    mmoClientesObservacoesCliente.ReadOnly := true;
    mmoClienteObservacoesCliente1.ReadOnly := true;
    mmoClientesObservacoesCliente.TabStop  := false;
    mmoClienteObservacoesCliente1.TabStop  := false;
  end;
  //rgpTipoLente.TabStop := true;
  sbnMarcarDesmarcarBrinde.Visible := ParSistema.PermitirAlterarBrindenoContrato;

  dbgProdutos.CampoSequencial := 'numero';
  dtmCadastroContratos.qryProdutosContratos.After_Open := dbgProdutos.RefazerOrdenacaoSequencial;

  dbgProdutos.OnDelete := ExcluirProdutoContrato;


  gbxSituacaoProdutos.Visible := ParSistema.VisualizarSituacaoProdutos;
  fraEnderecoEntrega.CampoCidadeIBGE := dtmCadastroContratos.qryContratoscodigoibgecidadeentrega;
  fraEnderecoResidencia.CampoCidadeIBGE := dtmCadastroContratos.qryContratoscodigoibgecidadedest;
  if ParSistema.PermitirProdutoAlfanumerico then
    dbgProdutos.Columns[3].FieldName := dtmCadastroContratos.qryProdutosContratosprodutovisual.FieldName
  else
    dbgProdutos.Columns[3].FieldName := dtmCadastroContratos.qryProdutosContratosproduto.FieldName;

except
     on E: Exception do ShowMessage(E.Message);
end;
end;

procedure TfrmCadastroContratos.dbgParcelasDrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  inherited;
  if dtmCadastroContratos.ParcelaSelecionada then
  begin
    TDBGrid(Sender).Canvas.Brush.Color := clYellow;
    TDBGrid(Sender).Canvas.Font.Color  := clBlack;
  end;
  if dtmCadastroContratos.FormaPagamentoParcela = 'C' then
    TDBGrid(Sender).Canvas.Font.Color := sbnFormaPagCredito.Font.Color
  else if dtmCadastroContratos.FormaPagamentoParcela = 'B' then
    TDBGrid(Sender).Canvas.Font.Color := sbnFormaPagDebito.Font.Color
  else if dtmCadastroContratos.FormaPagamentoParcela = 'H' then
    TDBGrid(Sender).Canvas.Font.Color := sbnFormaPagCheque.Font.Color
  else if dtmCadastroContratos.FormaPagamentoParcela = 'X' then
    TDBGrid(Sender).Canvas.Font.Color := sbnFormaPagCDC.Font.Color;
  TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
end;

procedure TfrmCadastroContratos.dbgParcelasKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if Shift = [ssCtrl] then
    case Key of
      VK_C: if sbnFormaPagCredito.Enabled then
               sbnFormaPagCreditoClick(nil);
      VK_D: if sbnFormaPagDinheiro.Enabled then
               sbnFormaPagDinheiroClick(nil);
      VK_B: if sbnFormaPagDebito.Enabled then
               sbnFormaPagDebitoClick(nil);
      VK_H: if sbnFormaPagCheque.Enabled then
               sbnFormaPagChequeClick(nil);
      VK_X: if sbnFormaPagCDC.Enabled then
               sbnFormaPagCDCClick(nil);
    end
  else if Key = VK_SPACE then
    dtmCadastroContratos.SelecionarParcela
end;

procedure TfrmCadastroContratos.dbgProdutosDblClick(Sender: TObject);
begin
  inherited;
  IncluirEditarProdutosContrato(True)
end;

procedure TfrmCadastroContratos.dbgProdutosDrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TColumn; State: TGridDrawState);
begin
  inherited;
  if datacol <> 1 then
  begin
    if (dtmCadastroContratos.QtdadeProdutos > 0) and (dtmCadastroContratos.SituacaoContrato > scRESERVADO) then begin
      if dtmCadastroContratos.ProdutoCancelado then
      begin
        TDBGrid(Sender).Canvas.Brush.Color := clYellow;
        TDBGrid(Sender).Canvas.Font.Color := clBlack;
      end else if dtmCadastroContratos.ProdutoNotaEmitida then
      begin
        TDBGrid(Sender).Canvas.Brush.Color := $007FAA55;
        TDBGrid(Sender).Canvas.Font.Color := clBlack;
      end else if dtmCadastroContratos.IncluirNaNotaFiscal then
      begin
        TDBGrid(Sender).Canvas.Brush.Color := $00FFAA00;
        TDBGrid(Sender).Canvas.Font.Color := clBlack;
      end
    end;
    if (dtmCadastroContratos.QtdadeProdutos > 0) and (dtmCadastroContratos.SituacaoContrato <= scRESERVADO) then begin
      if dtmCadastroContratos.MarcarProdutoCopiar then
      begin
        TDBGrid(Sender).Canvas.Brush.Color := $000055FF;
        TDBGrid(Sender).Canvas.Font.Color := clBlack;
      end;
    end;
    TDBGrid(Sender).Canvas.Font.Style := [];
    TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
  end
  else
  begin
    if dbgProdutos.DataSource.DataSet.FieldByName('situacao_produto').AsString = 'A' then
      TDBGrid(Sender).Canvas.Font.Color := clGreen
    else
    if dbgProdutos.DataSource.DataSet.FieldByName('situacao_produto').AsString = 'P' then
      TDBGrid(Sender).Canvas.Font.Color := $000080FF
    else
    if dbgProdutos.DataSource.DataSet.FieldByName('situacao_produto').AsString = 'N' then
      TDBGrid(Sender).Canvas.Font.Color := clRed;

    TDBGrid(Sender).Canvas.Font.Style := [fsBold];
   TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
  end;

end;

procedure TfrmCadastroContratos.dbgProdutosEnter(Sender: TObject);
begin
  inherited;
  TotalProdutosAnt     := dtmCadastroContratos.TotalProdutos;
  TotalIPIAnt          := dtmCadastroContratos.TotalIPI;
end;

procedure TfrmCadastroContratos.dbgServicosEnter(Sender: TObject);
begin
  inherited;
  TotalServicosAnt:= dtmCadastroContratos.TotalServicos;
end;

procedure TfrmCadastroContratos.dbgProdutosKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;
  if (Shift = [ssCtrl]) and (Key = VK_Space) then begin
    if dbgProdutos.SelectedIndex = dbgProdutos.ColumnByName('brinde').Index then
      dtmCadastroContratos.MarcarProdutosBrinde(false,false)
    else
    begin
      if (dtmCadastroContratos.SituacaoContrato > scRESERVADO) and
        Not (dtmCadastroContratos.ProdutoNotaEmitida
         or dtmCadastroContratos.ProdutoCancelado)
      then begin
        dtmCadastroContratos.IncluirNaNotaFiscal := Not dtmCadastroContratos.IncluirNaNotaFiscal;
        dbgProdutos.Invalidate
      end else begin
        if dtmCadastroContratos.SituacaoContrato = scORCADO then
          dtmCadastroContratos.MarcarProdutoCopiar:= not dtmCadastroContratos.MarcarProdutoCopiar
        else if dtmCadastroContratos.SituacaoContrato = scRESERVADO then
          if not dtmCadastroContratos.Alterado or (dtmCadastroContratos.RegistrosMarcados > 0) then
            dtmCadastroContratos.MarcarProdutoCopiar:= not dtmCadastroContratos.MarcarProdutoCopiar
          else
            MensagemAviso('O Produto não pode ser selecionado para cópia,' + #10#13 + 'estando o Contrato em edição.');
      end
    end;
  end else if (Key = VK_F2) then
    if (Shift = [ssCtrl]) then
      IncluirEditarProdutosContrato(True)
    else if (Shift = [ssCtrl, ssAlt]) then
      IncluirEditarProdutosContrato(True)
end;

