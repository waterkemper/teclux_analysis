function TfrmCadastroContratos.TabelaDePesquisa: TZDataSet;
begin
  case TipoConsulta of
    ctcCONTRATO: Result := dtmCadastroContratos.TabelaConsultaContratos;
    ctcAVALISTA,
    ctcCLIENTES,
    ctcCLIENTESBONUS: Result := dtmCadastroContratos.TabelaConsultaClientes;
    ctcCONJUGE : Result := dtmCadastroContratos.TabelaConsultaConjuges;
    ctcESTADOID: Result := dtmCadastroContratos.TabelaConsultaEstados;
    ctcCONCEITO: Result := dtmCadastroContratos.TabelaConsultaConceitos;
    ctcNATURALIDADE: Result := dtmCadastroContratos.TabelaConsultaCidades;
    ctcCARGOCONJUGE,
    ctcCARGO:    Result := dtmCadastroContratos.TabelaConsultaCargos;
    ctcVENDEDOR: Result := dtmCadastroContratos.TabelaConsultaVendedores;
    ctcAGENTES:  Result := dtmCadastroContratos.TabelaConsultaAgentes;
    ctcFILIAISVENDA,
    ctcFILIAISMONTAGEM: Result := dtmCadastroContratos.TabelaConsultaFiliais;
    ctcLISTACASAMENTO: Result := dtmCadastroContratos.TabelaConsultaListaCasamento;
    ctcDEPENDENTE: Result := dtmCadastroContratos.TabelaConsultaDependentes;
    ctcCFPS: Result := dtmCadastroContratos.TabelaConsultaCFPS;
  else
    Result := Nil
  end
end;

function TfrmCadastroContratos.TabelaDoParametro(Parametro: Integer): TZDataSet;
begin
  if CtrlOn then
    Result := dtmCadastroContratos.TabelaConsultaEstados
  else
    Result := dtmCadastroContratos.TabelaConsultaClientes
end;

function TfrmCadastroContratos.ValidaUsuarioAutorizacao: Boolean;
var
  UsuarioAut: TtecUsuarios;
  AnalistaValido: Boolean;
  CodigoUsuario: Integer;
  NomeUsuario: String;
begin
  Result := False;
  if MensagemConfirmacao(ctCONFIRMEFATURAMENTO) = smbOK then begin
    NomeUsuario   := '';
    CodigoUsuario := 0;
    if dtmCadastroContratos.ExigeAnalistaCredito then begin
      if UsuarioLogin.AnalistaCredito then begin
        AnalistaValido := True;
        CodigoUsuario  := UsuarioLogin.CodigoUsuario;
        NomeUsuario    := UsuarioLogin.NomeUsuario;
      end else begin
        UsuarioAut := dtmCadastroContratos.ObterAutorizacao(taLOGIN, ctFATURARCONTRATO, ctANALISTACREDITO);
        if Assigned(ActiveControl) then
          ActiveControl.SetFocus;
        try
          if Assigned(UsuarioAut) then
            if UsuarioAut.CodigoUsuario = 0 then begin
              AnalistaValido := False;
              MensagemAviso(Format(ctUSUARIOSEMCADASTRO, ['']))
            end else if Not UsuarioAut.AnalistaCredito then begin
              AnalistaValido := False;
              MensagemAviso(Format(ctUSUARIONAOAUTORIZADO, [ctAPROVARCONTRATOS]));
            end else begin
              AnalistaValido := True;
              CodigoUsuario  := UsuarioAut.CodigoUsuario;
              NomeUsuario    := UsuarioAut.NomeUsuario;
            end
          else
            AnalistaValido := False
        finally
          UsuarioAut.Free
        end
      end
    end else
      AnalistaValido := True;
    if AnalistaValido then begin
      if NomeUsuario <> '' then
        dtmCadastroContratos.SelecionarAnalista(CodigoUsuario, NomeUsuario);

      dtmCadastroContratos.SituacaoContrato := scFATURADO;
      Result := True;
      sbnAlterarSituacao.Caption := vstrAlterarSituacaoContrato[dtmCadastroContratos.SituacaoContrato] + ' F11';
      sbnAlterarSituacao.Hint    := vstrHintSituacaoContrato[dtmCadastroContratos.SituacaoContrato];

      if ParSistema.ImprimirCarneAoFaturar then
         dtmCadastroContratos.ImprimirCarne(false);

//      if ParSistema.ImprimirBoleto then
//         dtmCadastroContratos.ImprimirBoleto;
    end
  end
end;

