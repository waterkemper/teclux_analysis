procedure TfrmCadastroContratos.DocumentoFiscaisContrato;
var
  UsuarioAut: TtecUsuarios;
  PodeImprimirNota,
  ErroCupom,CupomEmitido,ErroAcrescimo,
  NotaFiscalVinculada: Boolean;
  FormaPagamento: Integer;
  ValorPagoDinheiro: Currency;
  DadosFornec: String;
  Frm: TForm;
  SituacaoAtual : TtecSituacaoContrato;
  RetornoBotao : TMessageButton;
begin
  if dtmCadastroContratos.DocumentoFiscaisContrato then
  begin
    Frm := TfrmVendasaVista.Referencia;
    if Assigned(Frm) then
      TfrmVendasaVista(Frm).ReFazVendaVista([dtmCadastroContratos.NumeroContrato]);
    Frm := TfrmDevolucaoMercadorias.Referencia;
    if Assigned(Frm) then
      TfrmDevolucaoMercadorias(Frm).ReFazConsultaCliente([dtmCadastroContratos.NumeroContrato]);
    Frm := TfrmOperacoesContratos.Referencia;
    if Assigned(Frm)  then
      TfrmOperacoesContratos(Frm).RefazConsulta;

    AlterarEstadoBotoes;

  end;


  {
  =================   ANTERIOR ===============

  result := true;

  if dtmCadastroContratos.NinguemBloqueouoContrato then
  begin
    if not dtmCadastroContratos.ExisteDiferencaIPI then
    begin
      PodeImprimirNota:= False;
      if UsuarioLogin.EmissorNotaFiscal then
        PodeImprimirNota:= True
      else begin
        UsuarioAut := dtmCadastroContratos.ObterAutorizacao(taLOGIN, ctIMPRIMIRNOTAFISCAL, ctEMISSORNOTAFISCAL);
        try
          if Assigned(UsuarioAut) then begin
            if not UsuarioAut.EmissorNotaFiscal then begin
              PodeImprimirNota := False;
              MensagemAviso(Format(ctUSUARIONAOAUTORIZADO, ['imprimir nota fiscal.']));
            end
            else PodeImprimirNota:= True;
          end;
        finally
          UsuarioAut.Free
        end
      end;

      if PodeImprimirNota then
      begin

        if dtmcadastrocontratos.abrindoOS then
          dtmCadastroContratos.MarcarProdutos(true)
        else
        begin
          if tstProdutos.TabVisible then
          begin
            pgcContratos.ActivePage := tstProdutos;
            ckbMarcarTodos.Checked := true;
            ckbMarcarTodosClick(self);
          end
          else
          if tstServico.TabVisible then
            pgcContratos.ActivePage := tstServico;
        end;

        RetornoBotao := smbYes;

        if MensagemConfirmacao(ctCONFIRMEIMPRESSAODOCUMENTOSFISCAIS) = smbok then
        begin
          if parsistema.Possuivendasemtransitopeloestabelecimento then
            RetornoBotao := MensagemSelecionaOpcao('Os produtos estão saindo da empresa?');

          if RetornoBotao <> smbCancel then
          begin
            dtmCadastroContratos.ProdutosSaindodaEmpresa := RetornoBotao = smbyes;

            if Assigned(ECFPadrao) then
              NotaFiscalVinculada := (ParSistema.NotaFiscalVinculada = tnfOBRIGATORIA) or
                                     ((ParSistema.NotaFiscalVinculada = tnfOPCIONAL) and
                                     (MensagemConfirmacao(ctCONFIRMAEMISSAONOTASCONTRATO) = smbOK))
            else
              NotaFiscalVinculada := False;
            SituacaoAtual := dtmCadastroContratos.SituacaoContrato;

            dtmCadastroContratos.SituacaoContrato := scNOTAFISCAL;
            try
              if Not dtmCadastroContratos.GravarContrato(ErroCupom,CupomEmitido,FormaPagamento,DadosFornec,
                                                         ValorPagoDinheiro, ErroAcrescimo, NotaFiscalVinculada, False)
              then
              begin
                result := false;
                dtmCadastroContratos.VoltarSituacaoContrato(SituacaoAtual, ErroAcrescimo);
                dtmCadastroContratos.CancelarAlteracoesContrato;
              end
              else
              begin
                Frm := TfrmVendasaVista.Referencia;
                if Assigned(Frm) then
                  TfrmVendasaVista(Frm).ReFazVendaVista([dtmCadastroContratos.NumeroContrato]);
                Frm := TfrmDevolucaoMercadorias.Referencia;
                if Assigned(Frm) then
                  TfrmDevolucaoMercadorias(Frm).ReFazConsultaCliente([dtmCadastroContratos.NumeroContrato]);
                Frm := TfrmOperacoesContratos.Referencia;
                if Assigned(Frm)  then
                  TfrmOperacoesContratos(Frm).RefazConsulta;
              end;
              if not dtmcadastrocontratos.abrindoOS then
              AlterarEstadoBotoes;
            except
              dtmCadastroContratos.RefazConsultaContrato;
              if not dtmcadastrocontratos.abrindoOS then
                AlterarEstadoBotoes;
              raise

            end;
          end;
        end
      end;

    end;
  end;
  }
end;

procedure TfrmCadastroContratos.edfNumeroContratoFound(Found: Boolean);
begin
  inherited;
  if Found then begin
//    dtmCadastroContratos.RefazConsultaProdutosEntregar;
      if dtmCadastroContratos.SituacaoContrato = scNOTAPARCIAL then
        AlterarEstadoBotoes;
    flkNaturalCidadeCliente.Exist;
    flkCodigoCliente.Exist;
    if ParSistema.ClienteComDependentes then
      if not flkCodigoDependente.Exist then
        flkCodigoDependente.Text := '';
    fraEnderecoEntrega.ReadOnly     := Not dtmCadastroContratos.ExisteEntrega;
    flkFilialMontagem.ReadOnly      := Not dtmCadastroContratos.ExisteMontagem;
  end;
  if Assigned(dtmCadastroContratos) then begin
    dtmCadastroContratos.MontarListaGruposClasses(Grupos, Classes);
  end
end;

