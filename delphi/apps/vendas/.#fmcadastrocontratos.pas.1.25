procedure TfrmCadastroContratos.flkCodigoClienteExit(Sender: TObject);
begin
  inherited;
  if Not Gravando then
  begin
    if not lblCodigoDependente.Visible and not lblClienteBonus.Visible then
    begin
      if (pgcCadastroClientes.ActivePage <> tstClienteGeral) then
        pgcCadastroClientes.ActivePage:=  tstClienteGeral;
      if fracgcoucpf.edtCPFCNPJ.CanFocus then
        fracgcoucpf.edtCPFCNPJ.SetFocus;
    end;
  end;

  if ((CodClienteAnt <> dtmCadastroContratos.CodigoCliente) or
      (TipoClienteAnt <> dtmCadastroContratos.TipoCliente)) or
      ((CodClienteAnt=0) and (TipoclienteAnt='') and
       (dtmCadastroContratos.CodigoCliente<>0) and
       (dtmCadastroContratos.TipoCliente<>'')) then begin
    if dtmCadastroContratos.CartaDevolvida(ClassName) then
      pgcCadastroClientes.ActivePageIndex:=1;
    dtmCadastroContratos.ExibirFicha(ClassName);
  end;

   if (dtmCadastroContratos.TotalContrato<>0) and
       (dtmCadastroContratos.SituacaoContrato < scFATURADO) then
     if not VerificarCreditoTroca(true,true) then
       PrecisaReCalcularParcelas := true;

  flkNaturalCidadeCliente.Exist;

  if lblClienteBonus.Visible and (dtmCadastroContratos.CodigoClienteBonus = 0) then
  begin
    dtmCadastroContratos.AtribuirClienteBonus;
  end;
end;

procedure TfrmCadastroContratos.flkCodigoClienteFound(Found: Boolean);
begin
  inherited;
  LimparTempos;
end;

procedure TfrmCadastroContratos.flkConjugeExit(Sender: TObject);
begin
  inherited;
//  dtmCadastroContratos.ReFazConsultaConjuge
end;

