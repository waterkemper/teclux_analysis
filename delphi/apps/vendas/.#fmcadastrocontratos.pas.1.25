function TfrmCadastroContratos.ExcluirProduto: Boolean;
begin
  if (dtmCadastroContratos.SituacaoContrato < scFATURADO ) and (not dtmCadastroContratos.ReadOnly) then begin
//    Result := MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, [ctOPRODUTO])) = smbOK;
//    if Result then begin
      Result := dtmCadastroContratos.ExcluirProduto;
      if Result then begin
        dtmCadastroContratos.CalcularValorTotalProdutos;
        PrecisaReCalcularParcelas := True
      end
//    end
  end else
    Result := False
end;

function TfrmCadastroContratos.ExcluirServico: Boolean;
begin
  if (dtmCadastroContratos.SituacaoContrato < scFATURADO) and (not dtmCadastroContratos.ReadOnly) then begin
    Result := MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o SERVIÇO'])) = smbOK;
    if Result then begin
      Result := dtmCadastroContratos.ExcluirServicoContrato;
      if Result then begin
        dtmCadastroContratos.CalcularValorTotalServicos;
        dtmCadastroContratos.CalcularValorAVista;
        PrecisaReCalcularParcelas := True
      end
    end
  end else
    Result := False
end;

function TfrmCadastroContratos.ExisteInformacao(Parametro: Integer; NomeCampo: String; Value: Variant): Boolean;
begin
  if CtrlOn then
    case TipoConsulta of
      ctcAVALISTA,
      ctcCLIENTES,
      ctcCLIENTESBONUS : Result := dtmCadastroContratos.ExisteCliente(NomeCampo, Value);
      ctcCONJUGE       : Result := dtmCadastroContratos.ExisteConjuge(NomeCampo,Value);
      ctcESTADOID      : Result := dtmCadastroContratos.ExisteEstado(NomeCampo, Value);
      ctcCONCEITO      : Result := dtmCadastroContratos.ExisteConceito(NomeCampo, Value);
      ctcCARGOCONJUGE,
      ctcCARGO         : Result := dtmCadastroContratos.ExisteCargo(NomeCampo, Value);
      ctcNATURALIDADE  : begin if Parametro = 0 then
                              Result := dtmCadastroContratos.ExisteEstado(NomeCampo, Value)
                         else Result := dtmCadastroContratos.ExisteCidade(NomeCampo, Value)
      end;
      ctcVENDEDOR      : Result := dtmCadastroContratos.ExisteVendedores(NomeCampo, Value);
      ctcAGENTES       : Result := dtmCadastroContratos.ExisteAgente(NomeCampo, Value);
      ctcFILIAISMONTAGEM,
      ctcFILIAISVENDA  : Result := dtmCadastroContratos.ExisteFilial(NomeCampo, Value);
      ctcLISTACASAMENTO: Result := dtmCadastroContratos.ExisteListaCasamento(NomeCampo, Value);
      ctcDEPENDENTE    : Result := dtmcadastrocontratos.ExisteDependentes(NomeCampo, Value);
      ctcCFPS          : Result := dtmCadastroContratos.ExisteCFPS(NomeCampo, Value);
    else
      Result := False
    end
  else if Parametro = 0 then
    Result := dtmCadastroContratos.ExisteCliente(NomeCampo, Value)
  else
    Result:= dtmCadastroContratos.ExisteContrato(NomeCampo, Value);
end;

procedure TfrmCadastroContratos.FaturarContrato;
var
  Msg: String;
begin
  if ParSistema.VerificarLimiteCreditoPontuacao then
  begin
    if dtmCadastroContratos.VerificarLimitesCredito(Msg) then
      Faturar
    else
    begin
      if MensagemConfirmacao(msg) = smbOK then
      begin
{        dtmCadastroContratos.SenhaCredito := AnalistaLiberou;}
        TfrmPrincipalBasico(Application.MainForm).MostrarFormRegistrado([dtmCadastroContratos.CodigoCliente,
                                                                         dtmCadastroContratos.TipoCliente,
                                                                         ClassName, True],
                                                                         'TfrmFichaFinanceira', True)
      end
      else
        AnalistaLiberou;
    end;
  end
  else
    Faturar;
end;

