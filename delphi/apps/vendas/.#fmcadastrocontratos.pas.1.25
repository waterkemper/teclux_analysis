function TfrmCadastroContratos.getNumeroContrato: String;
begin
  Result := dtmCadastroContratos.NumeroContrato
end;

procedure TfrmCadastroContratos.HabilitarBotoesFormaPagamento(Valor: Boolean);
begin
  sbnFormaPagDebito.Enabled   := Valor;
  sbnFormaPagDinheiro.Enabled := Valor;
  sbnFormaPagCheque.Enabled   := Valor;
  sbnFormaPagCredito.Enabled  := Valor;
  sbnFormaPagCDC.Enabled      := Valor;
end;

procedure TfrmCadastroContratos.ImprimirContrato;
var
  CarnesAbertas, ImprimirContrato: Boolean;
begin
  if ((dtmCadastroContratos.SituacaoContrato > scRESERVADO) and (Length(dtmCadastroContratos.IntervaloCarnesAbertas)>0)) then
    CarnesAbertas:= True
  else
    CarnesAbertas:= False;

  if (ParSistema.SoImprimirFaturados) then
    if (dtmCadastroContratos.SituacaoContrato > scRESERVADO) then
      ImprimirContrato:= True
    else
      ImprimirContrato:= False
  else
    ImprimirContrato:= True;

  frmConfirmarImpressaoNoContrato := TfrmConfirmarImpressaoNoContrato.Create(frmConfirmarImpressaoNoContrato, ImprimirContrato, True, (dtmCadastroContratos.SituacaoContrato > scRESERVADO),
                                                         (CarnesAbertas), True,1);

  frmConfirmarImpressaoNoContrato.IntervaloCarnes:= dtmCadastroContratos.IntervaloCarnes;
  frmConfirmarImpressaoNoContrato.IntervaloCarnesAbertas:= dtmCadastroContratos.IntervaloCarnesAbertas;
  frmConfirmarImpressaoNoContrato.ckbImprimirCarneAbertas.Enabled := frmConfirmarImpressaoNoContrato.IntervaloCarnesAbertas<>nil;

  try
    frmConfirmarImpressaoNoContrato.ShowModal;
    if frmConfirmarImpressaoNoContrato.ModalResult = mrOK then
    begin
      if frmConfirmarImpressaoNoContrato.Contrato then
        dtmCadastroContratos.ImprimirContrato(dbgProdutos.Ordenacao)
      else
      if frmConfirmarImpressaoNoContrato.ContratoMeiaPagina then
        dtmCadastroContratos.ImprimirContrato(dbgProdutos.Ordenacao, true);

      if frmConfirmarImpressaoNoContrato.Carne then
        dtmCadastroContratos.ImprimirCarne(frmConfirmarImpressaoNoContrato.Sequencia)
      else
      if frmConfirmarImpressaoNoContrato.CarneAbertas then
        dtmCadastroContratos.ImprimirCarne(frmConfirmarImpressaoNoContrato.Sequencia);

      if frmConfirmarImpressaoNoContrato.Boleto then
        dtmCadastroContratos.ImprimirBoleto(frmConfirmarImpressaoNoContrato.Sequencia);

      if frmConfirmarImpressaoNoContrato.Saldo then
        dtmCadastroContratos.ImprimirSaldo;
    end
  finally
    frmConfirmarImpressaoNoContrato.Free;
  end
end;

function TfrmCadastroContratos.IncluirEditarProdutosContrato(Editar: Boolean): Boolean;
begin
  if (dtmCadastroContratos.SituacaoContrato < scFATURADO) and (not dtmCadastroContratos.ReadOnly) then
  begin
    frmCadastroProdutosContrato := TfrmCadastroProdutosContrato.Create(frmCadastroProdutosContrato);
    if Editar then
      Result := dtmCadastroContratos.EditarProdutosContrato
    else
      Result := dtmCadastroContratos.IncluirProdutosContrato;

    if Result then
      Result := frmCadastroProdutosContrato.ShowModal = mrOK;

    frmCadastroProdutosContrato.Free;
    dbgProdutos.RefazerOrdenacaoSequencial(nil);

    dtmCadastroContratos.CalcularValorTotalProdutos;
    fraEnderecoEntrega.ReadOnly     := Not dtmCadastroContratos.ExisteEntrega;
    flkFilialMontagem.ReadOnly      := Not dtmCadastroContratos.ExisteMontagem;
    PrecisaReCalcularParcelas := (TotalProdutosAnt <> dtmCadastroContratos.TotalProdutos) or
                                 (TotalIPIAnt      <> dtmCadastroContratos.TotalIPI) or
                                 PrecisaReCalcularParcelas;

    dtmCadastroContratos.MontarListaGruposClasses(Grupos, Classes);
    SetFocus;
  end else
    Result := False
end;

procedure TfrmCadastroContratos.IncluirEditarServicosContrato(Editar: Boolean);
begin
  if Not dtmCadastroContratos.ReadOnly then
  begin
    dtmCadastroContratos.IncluirServicosContrato(Editar);
    frmCadastroServicosContrato := TfrmCadastroServicosContrato.Create(frmCadastroServicosContrato);
    frmCadastroServicosContrato.flkServico.Exist;
    frmCadastroServicosContrato.flkEquipamento.Exist;
    frmCadastroServicosContrato.ShowModal;
    frmCadastroServicosContrato.Free;
    PrecisaReCalcularParcelas := (TotalServicosAnt <> dtmCadastroContratos.TotalServicos) or
                                 (TotalRetencaoAnt <> dtmCadastroContratos.ImpostoRetido) or
                                 PrecisaReCalcularParcelas;
  end
end;

function TfrmCadastroContratos.InternoCancelar: Boolean;
begin
  Result := inherited InternoCancelar;
  if Result then begin
    ValidouDados := true;
    CancelarAlteracoes;
    fraEnderecoEntrega.ReadOnly     := Not dtmCadastroContratos.ExisteEntrega;
    flkFilialMontagem.ReadOnly      := Not dtmCadastroContratos.ExisteMontagem;
  end
end;

function TfrmCadastroContratos.InternoExcluir: Boolean;
var
  Msg: String;
  CancelarCtrOrcado: Boolean;
  Usuario           : TtecUsuarios;
begin
  if CtrlOn then begin
    if dbgProdutos.Focused then
      Result := ExcluirProduto
    else if dbgServicos.Focused then
      Result := ExcluirServico
    else
      Result := False;
  end
  else
  if ((dtmCadastroContratos.SituacaoContrato < scFATURADO) and
      (not dtmCadastroContratos.ReadOnly)) or
     (dtmCadastroContratos.SituacaoContrato = scFATURADO) then
  begin
    Result := True;
    if dtmCadastroContratos.SituacaoContrato = scORCADO then
    begin
      if ParSistema.ExclusaoContrato = excCANCELAR then
        CancelarCtrOrcado := True
      else
      begin
        if ParSistema.ExclusaoContrato = excPERGUNTAR then
        begin
          CancelarCtrOrcado := MensagemConfirmacao(ctCANCELARCONTRATOORCADO) = smbCANCEL;
          if Not CancelarCtrOrcado then
          begin
            Msg := Format(ctCONFIRMEEXCLUIR, [ctstrOCONTRATO]);
            Result := MensagemConfirmacao(Msg) = smbOk;
          end
        end
        else
        begin
          CancelarCtrOrcado := False;
          Msg := Format(ctCONFIRMEEXCLUIR, [ctstrOCONTRATO]);
          Result := MensagemConfirmacao(Msg) = smbOk;
        end
      end;
    end else
      CancelarCtrOrcado := False;

    if (dtmCadastroContratos.SituacaoContrato in [scRESERVADO, scFATURADO]) or CancelarCtrOrcado then
    begin
      Usuario := nil;
      dtmCadastroContratos.CancelamentoUsuarioAutorizacao := 0;
      if ((dtmCadastroContratos.SituacaoContrato <> scORCADO)
	  and not((dtmCadastroContratos.SituacaoContrato = scRESERVADO) 
		   and (ParSistema.AutorizacaoCancelarContratoFaturado))) then
      begin
        if UsuarioLogin.DevolucaoProduto then
        begin
          Usuario:= dtmCadastroContratos.ObterAutorizacao(taSENHA);
          dtmCadastroContratos.CancelamentoUsuarioAutorizacao := Usuario.CodigoUsuario;
        end
        else
        begin
          Usuario:= dtmCadastroContratos.ObterAutorizacao(taLOGIN, ctDEVOLUCAOPRODUTO, ctAUTORIZADO);
          dtmCadastroContratos.CancelamentoUsuarioAutorizacao := Usuario.CodigoUsuario;
        end;
      end
      else if (UsuarioLogin.DevolucaoProduto)
              and not ((dtmCadastroContratos.SituacaoContrato= scRESERVADO)
                        and (ParSistema.AutorizacaoCancelarContratoFaturado)) then
      begin
        Usuario:=UsuarioLogin;
        dtmCadastroContratos.CancelamentoUsuarioAutorizacao:=UsuarioLogin.CodigoUsuario;
      end
      else if not ((dtmCadastroContratos.SituacaoContrato= scRESERVADO)
	           and (ParSistema.AutorizacaoCancelarContratoFaturado))  then
      begin
	  Usuario:= dtmCadastroContratos.ObterAutorizacao(taLOGIN, ctDEVOLUCAOPRODUTO, ctAUTORIZADO);
          dtmCadastroContratos.CancelamentoUsuarioAutorizacao := Usuario.CodigoUsuario;
      end;


      if (Assigned(Usuario) and Usuario.DevolucaoProduto) or
         (dtmCadastroContratos.SituacaoContrato = scORCADO) or
	 ((dtmCadastroContratos.SituacaoContrato= scRESERVADO) 
	   and (ParSistema.AutorizacaoCancelarContratoFaturado))then
      begin
        dtmCadastroContratos.Abre(ctVendaTabelaConsultaMotivos);
        frmMotivos := TfrmMotivos.Create(frmMotivos, 'Cancelamentos de Contratos', dtmCadastroContratos.TabelaConsultaMotivos);
        Result := frmMotivos.ShowModal = mrOK;
      end
      else
      begin
        Result := false;
        MensagemAviso(ctUSUARIOSEMPERMISSAO);
      end;
    end;
    try
      if Result then
      begin
        Result := dtmCadastroContratos.ExcluirContrato(CancelarCtrOrcado);
        if Result then
        begin
          Result := inherited InternoExcluir;
          PrecisaReCalcularParcelas := False
        end;
      end
    finally
      if (dtmCadastroContratos.SituacaoContrato in [scRESERVADO, scFATURADO]) or CancelarCtrOrcado then
      begin
        frmMotivos.Free;
        SetFocus;
        dtmCadastroContratos.Fecha(ctVendaTabelaConsultaMotivos)
      end
    end
  end else
    Result := False;

  CtrlOn:= False;
end;

function TfrmCadastroContratos.InternoGravar: Boolean;
var
  CupomEmitido, ErroAcrescimo,
  ErroCupom: Boolean;
  FormaPagamento: Integer;
  ValorPagoDinheiro: Currency;
  Frm: TForm;
  Msg: String;
begin
  if inherited InternoGravar then
  begin
    if dtmCadastroContratos.NinguemBloqueouoContrato then
    begin

      ValidouDados := false;
      Gravando := True;
      try
        if ParSistema.ObservacoesAoGravarContrato then
          if dtmCadastroContratos.VerificaObservacoesContrato then
            AbreJanelaObservacoes;

        if ActiveControl = dbgProdutos then
          PrecisaReCalcularParcelas := (TotalProdutosAnt <> dtmCadastroContratos.TotalProdutos) or
                                       (TotalIPIAnt      <> dtmCadastroContratos.TotalIPI) or
                                        PrecisaReCalcularParcelas;

        if ActiveControl = dbgServicos then
          PrecisaReCalcularParcelas := (TotalServicosAnt <> dtmCadastroContratos.TotalServicos) or
                                        PrecisaReCalcularParcelas;

        if ActiveControl = dbgImpostosRetidos then
          PrecisaReCalcularParcelas := (TotalRetencaoAnt <> dtmCadastroContratos.ImpostoRetido) or
                                        PrecisaReCalcularParcelas;

        if PrecisaReCalcularParcelas then
        begin
          if ParSistema.PermitirAlterarBrindenoContrato then
            if dtmCadastroContratos.SomenteBrindes and (dtmCadastroContratos.ValorICMSSubstTributaria = 0) then
            begin
              ContornaChuncho := false;
              Result := GerarParcelasVendaaVista;
              PrecisaReCalcularParcelas := False;
              ContornaChuncho:=true;
            end;

          if dtmCadastroContratos.PlanoPadraoClienteSemParcelas then
          begin
            ContornaChuncho := false;
            Result := GerarParcelasPlanoPadrao;
            PrecisaReCalcularParcelas := False;
            ContornaChuncho:=true;
          end;

        end;

        if PrecisaReCalcularParcelas then
        begin
          MensagemAviso(ctRECALCULARPARCELAS);
          Result := False;
        end
        else
        begin
          if ReCalcularTempoMoradia then
            dtmCadastroContratos.CalcularTempoResidencia(edtResAno.Text,edtResMes.Text);
          if ReCalcularTempoCivil then
            dtmCadastroContratos.CalcularTempoCivil(edtCivilAno.Text,edtCivilMes.Text);
          if JaTestouEmail or EmailValido(edtClientesEMail.Text) then begin
            if (rbnEstadoCivilCasado.Checked {or rbnEstadoCivilOutros.Checked}) and
                fracgcoucpf.rbnFisica.Checked and
                Not rbnEmpresa.Checked and
                (not dtmCadastroContratos.ExisteConjuge and ParSistema.InformarConjugeClienteCasado)
            then begin
                MensagemAviso(ctCONJUGENAOINFORMADO);
                if not (pgcCadastroClientes.ActivePage = tstConjuge) then
                  pgcCadastroClientes.ActivePage := tstConjuge;
                flkConjuge.SetFocus;
                Result := False
            end else if (dtmCadastroContratos.ClientedoExterior or
                         (fracgcoucpf.edtCPFCNPJ.Criticar(not dtmCadastroContratos.ClientedoExterior))
                         ) and
                        not dtmCadastroContratos.ExisteDiferencaIPI then
            begin
              validoudados := true;

              Result := dtmCadastroContratos.GravarContrato(ErroCupom, CupomEmitido,
                                                            FormaPagamento, Msg,
                                                            ValorPagoDinheiro, ErroAcrescimo);

              if Result  then begin
                Frm := TfrmDevolucaoMercadorias.Referencia;
                if Assigned(Frm) then
                  TfrmDevolucaoMercadorias(Frm).ReFazConsultaCliente([dtmCadastroContratos.NumeroContrato]);
                Frm := TfrmCancelamentoContratos.Referencia;
                if Assigned(Frm) then
                  TfrmCancelamentoContratos(Frm).RefazConsulta;
                Frm := TfrmOperacoesContratos.Referencia;
                if Assigned(Frm)  then
                  TfrmOperacoesContratos(Frm).RefazConsulta;
                LimparTempos;
                ReCalcularTempoCivil      := False;
                ReCalcularTempoMoradia    := False;
                PrecisaReCalcularParcelas := False;
              end else
                validoudados := false;

            end else
              Result := False
          end else begin
            if not (pgcCadastroClientes.ActivePage = tstOutrosDados) then
              pgcCadastroClientes.ActivePage := tstOutrosDados;
            edtClientesEMail.SetFocus;
            JaTestouEmail := False;
            Result := False
          end;
        end
      finally
        Gravando := False;
      end
    end;
  end else
    Result := False
end;

function TfrmCadastroContratos.InternoIncluir: Boolean;
begin
  Result := inherited InternoIncluir;
  if CtrlOn then begin
    if dbgProdutos.Focused then
      Result := IncluirEditarProdutosContrato(False)
  end else begin
    Result := dtmCadastroContratos.IncluirContrato;
    if Result then begin
      if flkVendedor.Enabled then
        flkVendedor.SetFocus
      else
        flkCodigoCliente.SetFocus;
      if pgcContratos.ActivePageIndex > 0 then
        pgcContratos.ActivePageIndex:= 0;
      if pgcCadastroClientes.ActivePageIndex > 0 then
        pgcCadastroClientes.ActivePageIndex:= 0;
    end
  end
end;

function TfrmCadastroContratos.InternoPesquisar(Titulo: String): Integer;
var
  OK: Boolean;
  Tabela: Integer;
  TeclaEnter : word;

  procedure ProcuraTipoConsulta;
  var
    a: Integer;
  begin
   if (ActiveControl is TtecDBFindLookup) and CtrlOn then begin
     for a := 0 to High(FindsLookup) do
       if FindsLookup[a] = ActiveControl then
         break;
       if a <= High(FindsLookup) then
         TipoConsulta := TtecContratoTipoConsulta(a+1)
       else
         TipoConsulta := ctcCONTRATO;
   end else
     TipoConsulta := ctcCONTRATO;
  end;

begin
  OK := True;
  ProcuraTipoConsulta;
  if CtrlOn then begin
    Tabela := ctTabelasConsulta[TipoConsulta].TipoConsulta;
    Titulo := cttabelasConsulta[TipoConsulta].Titulo;
    if (TipoConsulta = ctcCONTRATO) or (dtmCadastroContratos.SituacaoContrato > scRESERVADO) or dtmCadastroContratos.ReadOnly then
      ok := False
    else if TipoConsulta = ctcNATURALIDADE then
      dtmCadastroContratos.AbreConsultaNaturalidade
    else if TipoConsulta in [ctcAVALISTA, ctcCLIENTES, ctcCLIENTESBONUS] then begin
      Tabela := ctVendaTabelaConsultaClientes;
      dtmCadastroContratos.AbreConsultaClientes;
    end else if (TipoConsulta = ctcCONJUGE) then begin
      Tabela:= ctVendaTabelaConsultaConjuge;
      dtmCadastroContratos.AbreConsultaConjuge;
    end
    else if (TipoConsulta = ctcFILIAISMONTAGEM) and flkFilialMontagem.ReadOnly then
      ok := False
    else
      dtmCadastroContratos.Abre(Tabela);
  end else begin
    Tabela := ctVendaTabelaConsultaContratos;
    dtmCadastroContratos.AbreConsultaClientes;
    Titulo := ctstrCONTRATOS;
  end;
  if OK then begin
    Result := inherited InternoPesquisar(Titulo);
    if Result = mrOK then
      case TipoConsulta of
        ctcCONTRATO: begin
                       edfNumeroContrato.OnFound := nil;
                       dtmCadastroContratos.SelecionarContrato;
                       dtmCadastroContratos.MontarListaGruposClasses(Grupos, Classes);
                       flkCodigoCliente.Exist;
                       flkNaturalCidadeCliente.Exist;
                       fraEnderecoEntrega.ReadOnly     := Not dtmCadastroContratos.ExisteEntrega;
                       flkFilialMontagem.ReadOnly      := Not dtmCadastroContratos.ExisteMontagem;
                       edfNumeroContrato.OnFound := edfNumeroContratoFound;
                       edfNumeroContratoFound(true);
                       AlterarEstadoBotoes;
                     end;
        ctcCLIENTES: begin
                       dtmCadastroContratos.SelecionarCliente;
                       flkNaturalCidadeCliente.Exist;
                       TeclaEnter := VK_Return;
                       KeyDown(TeclaEnter,[]);
                       LimparTempos;
                     end;
        ctcCONJUGE:  dtmCadastroContratos.SelecionarConjuge;
        ctcESTADOID: dtmCadastroContratos.SelecionarEstadoIdentificacao;
        ctcCONCEITO: dtmCadastroContratos.SelecionarConceito;
        ctcNATURALIDADE: dtmCadastroContratos.SelecionarNaturalidade;
        ctcCARGO: dtmCadastroContratos.SelecionarCargo;
        ctcCARGOCONJUGE: dtmCadastroContratos.SelecionarCargoConjuge;
        ctcAVALISTA: dtmCadastroContratos.SelecionarAvalista;
        ctcVENDEDOR: dtmCadastroContratos.SelecionarVendedores;
        ctcAGENTES:  dtmCadastroContratos.SelecionarAgente;
        ctcFILIAISMONTAGEM: dtmCadastroContratos.SelecionarFilialMontagem;
        ctcFILIAISVENDA: dtmCadastroContratos.SelecionarFilialVenda;
        ctcLISTACASAMENTO: dtmCadastroContratos.SelecionarListaCasamento;
        ctcDEPENDENTE: dtmcadastrocontratos.SelecionarDependente;
        ctcCFPS:       dtmCadastroContratos.SelecionarCFPS;
        ctcCLIENTESBONUS :dtmCadastroContratos.SelecionarClienteBonus;
      end;
   dtmCadastroContratos.Fecha(Tabela);
   //  jan.Free;
   //  jan:= nil;
  end else
    Result := mrNone;
end;

function TfrmCadastroContratos.JanelaPesquisa: TfrmConsultaBasica;
begin
  Jan := TfrmConsultaPorCampo.Create(nil);
  Jan.ConsultaInterativa := Not (TipoConsulta in [ctcCONTRATO, ctcCLIENTES,
                                                  ctcAVALISTA, ctcCLIENTESBONUS,
                                                  ctcCARGO, ctcCARGOCONJUGE]) and CtrlOn;
  Jan.UsarParametrosDaTabela := not (TipoConsulta = ctcDEPENDENTE);
  Result := Jan
end;

procedure TfrmCadastroContratos.KeyDown(var Key: Word; Shift: TShiftState);
begin
  if Shift = [] then begin
    case Key of
      VK_Escape: AlterarEstadoBotoes;
      VK_Return: begin
                   if ActiveControl = edtClientesPai then begin
                      pgcCadastroClientes.ActivePage:= tstResidencia;
                      fraEnderecoResidencia.mmoRua.SetFocus;
                      Key:= 0;
                    end
                    else if ActiveControl = edtClientesResTempo then begin
                      pgcCadastroClientes.ActivePage:= tstDadosComerciais;
                      edtClientesEmpresa.SetFocus;
                      Key:= 0;
                    end
                    else if ActiveControl = fraFoneRamalComercial.edtFoneRamal then begin
                      if tstConjuge.TabVisible then begin
                        pgcCadastroClientes.ActivePage:= tstConjuge;
                        flkConjuge.SetFocus;
                        Key:= 0;
                      end
                      else begin
                        pgcCadastroClientes.ActivePage:= tstReferencia;
                        edtClientesReferencia.SetFocus;
                        Key:= 0;
                      end;
                    end
                    else if (ActiveControl = fraFoneRamalConjuge.edtFoneRamal) then begin
                      pgcCadastroClientes.ActivePage:= tstReferencia;
                      edtClientesReferencia.SetFocus;
                      Key:= 0;
                    end
                    else if ActiveControl = fraFoneRamalReferencia_2.edtFoneRamal then begin
                      pgcCadastroClientes.ActivePage:= tstOutrosDados;
                      edtClientesDependentes.SetFocus;
                      Key:= 0;
                    end
                    else if (ActiveControl = mmoClientesObservacoesCliente) then begin
                      pgcCadastroClientes.ActivePage:= tstClienteGeral;
                      fracgcoucpf.edtCPFCNPJ.SetFocus;
                      Key:= 0;
                    end
                    else if (ActiveControl = edtSaldoTroca) then begin
                      with dtmCadastroContratos do
                      begin
                        if (edtSaldoTroca.ValorSemFormatacao>CreditoTrocaAnt) or
                           (edtSaldoTroca.ValorSemFormatacao>TotalContrato) then
                        begin
                          CreditoTroca := edtSaldoTroca.ValorSemFormatacao;
                          if not ValidarCreditoTroca then
                          begin
                            Key:= 0;
                            creditotroca := CreditoTrocaAnt;
                            edtSaldoTroca.SetFocus;
                            edtsaldotroca.SelectAll;
                          end;
                        end;
                      end;
                    end;
                  end;
      VK_F7: if sbnImprimirContrato.Enabled then
                sbnImprimirContratoClick(nil);
      VK_F8: if sbnCopiarContrato.Enabled then
                sbnCopiarContratoClick(nil);
      VK_F11: if sbnAlterarSituacao.Enabled then begin
                 sbnAlterarSituacaoClick(nil);
                 if dtmCadastroContratos.SituacaoContrato = scFATURADO then begin
                   if pgcContratos.ActivePageIndex <> 1 then
                     pgcContratos.ActivePageIndex:= 1;
                   if dbgProdutos.CanFocus then
                     dbgProdutos.SetFocus;
                 end;
               end;
      VK_F12: if sbnEnviarOrcamento.Enabled then
                 sbnEnviarOrcamentoClick(nil);
      VK_F5: if (pgcContratos.ActivePage = tstReceitaOculos) and
                 (sbnGravarReceitaOculos.Enabled) then
                gravarReceitaOculos;
    end;
  end
  else
  if Shift = [ssCtrl] then
  begin
    if (Key = VK_E) and sbnExibirColunas.Visible then
      sbnExibirColunasClick(nil)
    else if (Key = VK_I) and sbnSelecionarTodosProdutosImpressao.Visible then
      sbnSelecionarTodosProdutosImpressaoClick(nil)
    else if (Key = VK_B) and sbnMarcarDesmarcarBrinde.Visible then
      sbnMarcarDesmarcarBrindeClick(nil)
    else if Key = VK_P then
      sbnParcelasClick(nil)
    else if Key = VK_T then
      sbnVisualizarSaldoTrocaClick(nil)
    else if Key = VK_O then
    begin
      pgcContratos.ActivePage:=tstProdutos;
      if(dbgProdutos.Enabled) then
      begin
        dbgProdutos.SetFocus;
        IncluirEditarProdutosContrato(False);
      end;
    end
    else if Key = VK_R then
      if sbnResgatarBonus.Visible then
        sbnResgatarBonusClick(nil);
  end;
  inherited;
end;

procedure TfrmCadastroContratos.LerValoresCalculoFinanciamento;
var
  Parcelas, ParcContr: TResumosParcelas;
  ValorPrazo,
  TaxaJuros,
  Desconto: Real;
  Plano: Integer;
begin
  inherited;
  if Not ContornaChuncho then begin
    frmCalculoFinanciamento := TfrmCalculoFinanciamento(TfrmCalculoFinanciamento.Referencia);
    Parcelas := nil;  ParcContr := nil;
    if Gravando and dtmCadastroContratos.PlanoPadraoClienteSemParcelas then
      plano := dtmCadastroContratos.ClientePlanoPadrao
    else
      plano := 0;
    if Assigned(frmCalculoFinanciamento) and
       frmCalculoFinanciamento.ResumosParcelas(Parcelas, ValorPrazo, TaxaJuros, Desconto, Plano)
    then begin
      dtmCadastroContratos.ResumoParcelas(ParcContr);
      if Not ParcelasIdenticas(Parcelas, ParcContr) or
        (Desconto <> dtmCadastroContratos.DescontoContrato) or
        (dtmCadastroContratos.CreditoTroca > 0) or
        PrecisaReCalcularParcelas  then
      begin
//      and (MensagemConfirmacao('Deseja alterar as parcelas do contrato?') = smbOK)
//      then begin
        dtmCadastroContratos.DefinirParcelas(Parcelas, ValorPrazo, TaxaJuros, Desconto, Plano);
        PrecisaReCalcularParcelas := Plano = 0;
      end
      else
        PrecisaReCalcularParcelas := false;
      Parcelas  := nil;
      ParcContr := nil;
    end
  end
end;

procedure TfrmCadastroContratos.LimparTempos;
begin
  ReCalcularTempoCivil   := False;
  ReCalcularTempoMoradia := False;
  edtResAno.Text         := '';
  edtResMes.Text         := '';
  edtCivilAno.Text       := '';
  edtCivilMes.Text       := '';
end;

procedure TfrmCadastroContratos.OnActivateCalculoFinanciamento(var Calcular: Boolean;
  var Mercadoria, Frete, Seguro, DescontoContrato: Currency; var Plano: Integer;
  var Parcelas: TResumosParcelas; var Grupos: vstring; var Classes: vString);
begin
  Calcular         := PrecisaReCalcularParcelas;
  Mercadoria       := dtmCadastroContratos.TotalProdutos + dtmCadastroContratos.TotalServicos;
  Frete            := dtmCadastroContratos.Frete;
  Seguro           := dtmCadastroContratos.Seguro;
  DescontoContrato := dtmCadastroContratos.DescontoContrato;
  Plano            := dtmCadastroContratos.PlanoUtilizado;
  Grupos           := Self.Grupos;
  Classes          := Self.Classes;
  dtmCadastroContratos.ResumoParcelas(Parcelas);
end;

procedure TfrmCadastroContratos.OnCloseCalculoFinanciamento;
begin
  LerValoresCalculoFinanciamento;
{  SetFocus;}
end;

procedure TfrmCadastroContratos.OperacaoPadrao(Value: array of Variant);
begin
  inherited;
  if Length(Value) > 0 then
       dtmCadastroContratos.RefazConsultaContrato(Value[0])
  else dtmCadastroContratos.RefazConsultaContrato;
  edfNumeroContrato.SetFocus;
  
  if (high(Value)=2) then
  begin
    application.ProcessMessages;
    close;
  end;

end;

