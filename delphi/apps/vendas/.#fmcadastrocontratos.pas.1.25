procedure TfrmCadastroContratos.sbnParcelasClick(Sender: TObject);
begin
  inherited;
  if dtmCadastroContratos.FSomenteBrindes and
     parsistema.PermitirAlterarBrindenoContrato then
  begin
    ContornaChuncho := True;
    try
      CalcularFinanciamento;
    finally
      ContornaChuncho := False;
    end
  end
  else
  begin
    if (dtmCadastroContratos.TotalProdutos = 0) and
       (dtmCadastroContratos.TotalServicos = 0) then
      if ParSistema.ContratoComServico or parsistema.NotaFiscalConjugada then
        MensagemAviso('Faz-se necessário a inclusão de um produto ou serviço antes de calcular as parcelas.')
      else
        MensagemAviso('Faz-se necessário a inclusão de um produto antes de calcular as parcelas.')
    else
    if (dtmCadastroContratos.SituacaoContrato < scFATURADO) and (Not dtmCadastroContratos.ReadOnly) then
    begin
      if VerificarCreditoTroca(false,true) then
      begin
        if dbgParcelas.CanFocus then
          dbgParcelas.SetFocus;
        ContornaChuncho := True;
        try
          CalcularFinanciamento;
        finally
          ContornaChuncho := False;
        end
      end;
    end
  end;
end;

