function TfrmCadastroContratos.AnalistaLiberou: TTecUsuarios;
begin
  if UsuarioLogin.AnalistaCredito then
  begin
    Result := dtmCadastroContratos.ObterAutorizacao(taSENHA);
  end
  else
  begin
    Result := dtmCadastroContratos.ObterAutorizacao(taLOGIN, ctLIBERACAOCREDITO, ctANALISTACREDITO);
  end;

  if result <> nil then
    if not Result.AnalistaCredito then
    begin
      MensagemAviso(Format(ctUSUARIONAOAUTORIZADO,['LIBERAÇÃO DE CRÉDITO']));
      Result := nil;
    end;

  if result <> nil then
    Faturar;
end;

procedure TfrmCadastroContratos.Faturar;
begin
  if VerificarCreditoTroca(true,true) then
   if ValidaUsuarioAutorizacao then
    if not InternoGravar then
      CancelarAlteracoes;

end;

procedure TfrmCadastroContratos.sbnCopiarProdutosClick(Sender: TObject);
begin
  inherited;
  CopiarProdutosContratos;
end;

procedure TfrmCadastroContratos.CopiarProdutosContratos;
begin
  frmCopiarProdutosContratos := TfrmCopiarProdutosContratos.Create(frmCopiarProdutosContratos,UsuarioLogin.AlterarPrecoContrato);
  try
    if frmCopiarProdutosContratos.ShowModal = mrOK then
      dtmCadastroContratos.IncluirProdutosContratoCopia;
  finally
    frmCopiarProdutosContratos.Free;
    dtmCadastroContratos.CalcularValorTotalProdutos;
    fraEnderecoEntrega.ReadOnly := Not dtmCadastroContratos.ExisteEntrega;
    flkFilialMontagem.ReadOnly  := Not dtmCadastroContratos.ExisteMontagem;
    PrecisaReCalcularParcelas   := (TotalProdutosAnt <> dtmCadastroContratos.TotalProdutos) or
                                   (TotalIPIAnt      <> dtmCadastroContratos.TotalIPI) or
                                   PrecisaReCalcularParcelas;

    dtmCadastroContratos.MontarListaGruposClasses(Grupos, Classes);
    SetFocus;
  end;
end;

