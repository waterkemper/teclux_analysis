procedure TfrmCadastroContratos.SelecionarProdutosadevolver;
begin
  if (dtmCadastroContratos.SituacaoContrato < scFaturado) then
  begin
    frmprodutosadevolver := Tfrmprodutosadevolver.Create(frmprodutosadevolver);
    frmprodutosadevolver.DataSet:= dtmCadastroContratos.qryProdutosContratos;
    try
      with dtmCadastroContratos do
      begin
        dsrProdutosContratos.OnDataChange:= nil;
        qryProdutosContratos.First;
        while not qryProdutosContratos.Eof do
        begin
          if not (qryProdutosContratos.State = dsedit) then
            qryProdutosContratos.Edit;
          qryProdutosContratosadevolver.AsFloat:= 0;
          qryProdutosContratosSelecionar.asboolean:= False;
          qryProdutosContratos.Post;
          qryProdutosContratos.Next;
        end;
        dsrProdutosContratos.OnDataChange:= dsrProdutosContratosDataChange;
      end;
      frmprodutosadevolver.ShowModal;
  finally
      frmprodutosadevolver.Free;
      dtmCadastroContratos.CalcularValorTotalProdutos;
      SetFocus;
    end;
  end;
end;

procedure TfrmCadastroContratos.sbnDevolverprodutosClick(Sender: TObject);
begin
