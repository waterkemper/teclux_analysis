end;

procedure TfrmCadastroContratos.fracgcoucpfrgbTipoPessoaChange(Sender: TObject);
begin
  inherited;
  if Assigned(fracgcoucpf) and Assigned(dtmCadastroContratos) then
    fracgcoucpf.edtCPFCNPJ.Tipo:= dtmCadastroContratos.TipoPessoa;
