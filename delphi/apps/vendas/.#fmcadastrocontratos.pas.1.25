procedure TfrmCadastroContratos.sbnVisualizarSaldoTrocaClick(
  Sender: TObject);
begin
  inherited;
  edtSaldoTrocaEnter(self);
  if ParSistema.utilizarcreditotrocacontrato then
  begin
    frmVisualizarSaldoTroca := TfrmVisualizarSaldoTroca.Create(frmVisualizarSaldoTroca,
                               dtmCadastroContratos.TabelaSaldoCredito,
                               dtmCadastroContratos.TabelaSaldoCreditoAtual);
    frmVisualizarSaldoTroca.ShowModal;
    if frmVisualizarSaldoTroca.ModalResult = mrOK then
    begin
      if (dtmCadastroContratos.SituacaoContrato < scFATURADO) then
      begin
        if dtmCadastroContratos.CreditoTroca <> dtmCadastroContratos.SaldoCreditoAtual then
        begin
          dtmCadastroContratos.SugerirCreditoTroca(false,true);
          dtmCadastroContratos.CalcularValorAVista;
          PrecisaReCalcularParcelas := true;
        end;
      end;
    end;
    frmVisualizarSaldoTroca.Free;
    Application.BringToFront;
  end;
end;

procedure TfrmCadastroContratos.pgcContratosChange(Sender: TObject);
begin
  inherited;
  if pgcContratos.ActivePage = tstGeral then
   pnlSaldoTroca.Enabled := ParSistema.utilizarcreditotrocacontrato;
end;

procedure TfrmCadastroContratos.edtSaldoTrocaEnter(Sender: TObject);
begin
  inherited;
  dtmCadastroContratos.CreditoTrocaAnt := dtmCadastroContratos.CreditoTroca;
end;

procedure TfrmCadastroContratos.edtSaldoTrocaExit(Sender: TObject);
begin
  inherited;
  if dtmCadastroContratos.CreditoTroca <> dtmCadastroContratos.CreditoTrocaAnt then
  begin
    dtmCadastroContratos.CalcularValorAVista;
    PrecisaReCalcularParcelas := true;
  end;
end;


function TfrmCadastroContratos.VerificarCreditoTroca(Zerar,Atribuir: Boolean): Boolean;
begin
  result := true;
//  pgcContratos.ActivePage := tstGeral;  // CAUSA PERDA DE FOCO EM DIVERSAS SITUAÇÕES
  if ParSistema.utilizarcreditotrocacontrato then
  begin
    dtmCadastroContratos.AbrirDadosCreditoCliente;
    if dtmCadastroContratos.ValidarCreditoTroca then
    begin
      if ((dtmCadastroContratos.SaldoCreditoAtual<>0) and
          (dtmCadastroContratos.CreditoTroca=0)) or
         ((dtmCadastroContratos.SaldoCreditoAtual>0) and
          (dtmCadastroContratos.CreditoTroca<dtmCadastroContratos.SaldoCreditoAtual) and
          (dtmCadastroContratos.CreditoTroca<dtmCadastroContratos.TotalContrato)) {or
         ((dtmCadastroContratos.SaldoCreditoAtual<0) and
          (dtmCadastroContratos.CreditoTroca>dtmCadastroContratos.SaldoCreditoAtual))} then
      begin
        if dtmCadastroContratos.SugerirCreditoTroca(true,atribuir) then
        begin
          dtmCadastroContratos.CalcularValorAVista;
          pgcContratos.ActivePage := tstGeral;
          edtSaldoTroca.SetFocus;
          result := atribuir;
        end
      end;
    end
    else
    begin
     if zerar then
       edtSaldoTroca.text := FormatarValor(0,2);
     pgcContratos.ActivePage := tstGeral;
     edtSaldoTroca.SetFocus;
     result := false;
    end;
  end;
end;

