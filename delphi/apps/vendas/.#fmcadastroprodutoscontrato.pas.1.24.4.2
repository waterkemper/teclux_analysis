procedure TfrmCadastroProdutosContrato.flkCodigoProdutoFound(
  Found: Boolean);
begin
  inherited;
  if found and not dtmCadastroContratos.ConsultaExecutada then
  begin
    if ParSistema.ProdutoVendaFutura then
    begin
      if not dtmCadastroContratos.ValidarProdutosContratos then
        edtQuantidade.SetFocus;
    end
    else
      dtmCadastroContratos.SelecionarProdutoContratoProcura;
    dtmCadastroContratos.RefazConsultaPrecoParaCliente;
  end;

  if parsistema.GravarProdutoContratoAutomaticamente then
  begin
    flkCodigoProduto.setfocus;
    flkCodigoProduto.SelectAll;
  end
  else
  if pnldesconto.Visible then
  begin
    edtdesconto.SetFocus;
    edtdesconto.selectall;
  end;
  
end;

procedure TfrmCadastroProdutosContrato.flkFilialFound(Found: Boolean);
begin
  inherited;
  if found then
    dtmCadastroContratos.SelecionarFilialContratoProcura;
end;

