constructor TfrmCadastroProdutosContrato.Create(AOwner: TComponent);
begin
  inherited;
  if (ParSistema.ValordaQuantidade > 0) then
  begin
    Self.ActiveControl:=flkCodigoProduto;
    flkCodigoProduto.SelectAll;
  end
  else
  begin
    Self.ActiveControl := edtQuantidade;
//    edtQuantidade.SetFocus;
    edtQuantidade.SelectAll;
  end;
//  edtQuantidade.Tamanho := ParSistema.TamanhoMascaraQuantidade + 3;
  DataSet := dtmCadastroContratos.TabelaProdutoContratos;
  sbnAlterarPreco.Visible := ParSistema.PermiteAlterarPreco;
  pnlDesconto.Visible     := false;//sbnAlterarPreco.Visible and UsuarioLogin.AlterarPrecoContrato;
  rgpMontagem.Enabled     := dtmCadastroContratos.ProdutoMontavel;
  flkVendedor.Enabled     := not UsuarioLogin.Vendedor or not ParSistema.NaoPermitirAlteraroVendedornosProdutosdoContrato;
  if UsuarioLogin.Vendedor or ParSistema.NaoPermitirAlteraroVendedornosProdutosdoContrato then
  begin
    dtxNomeVendedor.Width := dtxNomeVendedor.Width + dtxNomeVendedor.Left - flkVendedor.Left;
    dtxNomeVendedor.Left  := flkVendedor.Left;
    dtxNomeVendedor.BringToFront;
  end;

  if ParSistema.SoVisualizarEstoqueDeposito then
    gbxDepositos.Caption := uppercase(ctDEPOSITOS)
  else gbxDepositos.Caption := uppercase(ctFILIAIS);

  gbxDepositos.Visible := Not (ParSistema.FiliaisIndependentes);
  dbgDepositos.Visible      := Not (ParSistema.FiliaisIndependentes);
  gbxFILIAL.Visible    := Not (ParSistema.FiliaisIndependentes);
  flkFilial.Visible         := Not (ParSistema.FiliaisIndependentes);
  sbnConsultaFilial.Visible := Not (ParSistema.FiliaisIndependentes);
  dtxNomeFilial.Visible     := Not (ParSistema.FiliaisIndependentes);
  dbgSimilares.Columns[2].Visible := ParSistema.UsarGradesProdutos;
  dbgSimilares.Columns[3].Visible := ParSistema.UsarGradesProdutos;
  if dbgSimilares.Columns[4].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgSimilares.Columns[4].Width := ParSistema.TamanhoMascaraQuantidade;
  if dbgSimilares.Columns[5].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgSimilares.Columns[5].Width := ParSistema.TamanhoMascaraQuantidade;
  if not ParSistema.UsarGradesProdutos then
    dbgsimilares.Columns[1].Width := dbgsimilares.Columns[1].Width+
                                     dbgsimilares.Columns[2].Width+
                                     dbgsimilares.Columns[3].Width;
  dtmCadastroContratos.OnScrollLinhaColunaGradeSimilares := AfterScrollLinhaColunaGradeSimilares;





  gbxItemProduto.Caption := flkCodigoProduto.FParameterLabel;
  dbgSimilares.Enabled:=ParSistema.MostrarSimilaresContrato;
  rbnBrindeSIM.Enabled := ParSistema.PermitirAlterarBrindenoContrato;
  rbnBrindeNAO.Enabled := ParSistema.PermitirAlterarBrindenoContrato;
  dtmCadastroContratos.ConsultaExecutada:= False;

  gbxExibicaoPrecos.Visible := ParSistema.PrecoParaCliente;
  if not gbxExibicaoPrecos.Visible then
  begin
    gbxFundoJanela.Height := gbxFundoJanela.Height - gbxExibicaoPrecos.Height;
    pgcExtraProdutos.Top      := pgcExtraProdutos.Top - gbxExibicaoPrecos.Height;
    self.Height := self.Height - gbxExibicaoPrecos.Height;

    gbxProdCliente.Visible := false;
    gbxPartNumber.Visible := false;
    gbxFinalidade.Visible := false;
  end;

  flkCodigoProduto.exist;
  
  tstModelodeProdutos.TabVisible := parsistema.LiberarVisualizacaodeModelosProdutos;
  tstObservacoesVenda.TabVisible := trim((dtmCadastroContratos.qryProcuraProdutoobservacoesvenda.asstring))<>'';

  if tstObservacoesVenda.TabVisible then
    pgcExtraProdutos.TabIndex := 0
  else
    pgcExtraProdutos.TabIndex := 1;

  tabObservacoesVendaNaoSetado :=  false;   


  gbxXPed.Visible := ParSistema.ClientePessoaJuridica;
  if gbxXPed.Visible then
  begin
    gbxFILIAL.Width := 246;
    dtxNomeFilial.Width := 178;
  end
  else
  begin
    gbxFILIAL.Width := 381;
    dtxNomeFilial.Width := 314;
  end;

  ckbProdutoLista.Visible := ParSistema.UtilizarListaCasamento;
  flkListaCasamento.ReadOnly := not ParSistema.UtilizarListaCasamento;
  flkListaCasamento.TabStop := ParSistema.UtilizarListaCasamento;
  gbxListaCasamento.Visible := ParSistema.UtilizarListaCasamento;

  rgpMonstruario.visible := Parsistema.Percentualdacomissaoparaprodutosdomonstruario <> 0;
  if not rgpMonstruario.Visible then
    pnlCentral.Height := pnlCentral.Height - 19;

//  Timer1Timer(nil);

  tabObservacoesVendaNaoSetado :=  (dtmCadastroContratos.qryProcuraProdutoobservacoesvenda.asstring)<>'';

  pgcExtraProdutos.OwnerDraw := true;

  tstPrecosCargos.TabVisible := ParSistema.PrecosporCargo;



    
end;

