  rgpMontagem.DataSource := dtmCadastroContratos.dsrProdutosContratos          ;
  rgpMonstruario.DataSource := dtmCadastroContratos.dsrProdutosContratos        ;
  rgbEntrega.DataSource := dtmCadastroContratos.dsrProdutosContratos           ;
  edtDias.DataSource := dtmCadastroContratos.dsrProdutosContratos  ;
//  AdvDBDateTimePicker1.DataSource := dtmCadastroContratos.dsrProdutosContratos;
  edttpDataEntrega.DataSource := dtmCadastroContratos.dsrProdutosContratos;
  edttpHoraEntrega.DataSource := dtmCadastroContratos.dsrProdutosContratos;
  DBLPeriodo.datasource := dtmCadastroContratos.dsrProdutosContratos;
  DBLPeriodo.lookupsource := dtmCadastroContratos.dtmCadastroContratosAuxiliar.dsrPeriodosEntrega;

  ckbDBDefinirEntregaParaTodos.datasource := dtmCadastroContratos.dsrContratos;

  DBAdvGridLotes.datasource := dtmCadastroContratos.dsrProdutosContratosLotes;



end;

