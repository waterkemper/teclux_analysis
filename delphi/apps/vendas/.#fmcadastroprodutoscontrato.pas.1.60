procedure TfrmCadastroProdutosContrato.KeyDown(var Key: Word;
  Shift: TShiftState);
begin
  case key of
    VK_Return: if Shift = [] then
               begin
                 if ((ActiveControl = flkCodigoProduto) and (ParSistema.GravarProdutoContratoAutomaticamente)) then
                 begin
                   dtmCadastroContratos.IncluindoouEditandoProduto := false;
                   inherited;
                   if InternoGravar then
                   begin
//                     flkcodigoproduto.Clear;
                     flkCodigoProduto.setfocus;
                     flkCodigoProduto.selectall;
                   end;
                   dtmCadastroContratos.IncluindoouEditandoProduto := true;
                   dtmCadastroContratos.AbrirDadosprodutos;
                 end
                 else inherited;
               end;
    else inherited;
  end
end;

