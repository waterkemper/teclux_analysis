begin
  if TipoConsulta = cpcPRODUTOS then
    Result := dtmCadastroContratos.TabelaConsultaProdutos
  else if TipoConsulta = cpcFILIAIS then
    Result := dtmCadastroContratos.TabelaConsultaFilialProduto
  else if TipoConsulta = cpcRESERVAS then
    Result := dtmCadastroContratos.TabelaConsultaReservas
  else if TipoConsulta = cpcVENDEDOR then
    Result := dtmCadastroContratos.TabelaConsultaVendedores
  else if TipoConsulta = cpcLISTADECASAMENTO then
