procedure TfrmCadastroProdutosContrato.sbnVisualizarEntregasProdutosClick(
  Sender: TObject);
begin
  inherited;
  AbrirConsultaEntregaProdutos(['Consultar entregas em aberto']);
end;

procedure TfrmCadastroProdutosContrato.DBAdvGridLotesGetEditorType(
  Sender: TObject; ACol, ARow: Integer; var AEditor: TEditorType);
begin
  inherited;
  DBAdvEditFloat.visible := false;
  fraConsulta_.visible := false;

  if (TDBAdvGrid(Sender).Columns[Acol].FieldName = 'nrlote') and (TDBAdvGrid(Sender).Columns[Acol].Field.AsString='') then
  begin
    With fraConsulta_ do
    begin
      TipoConsulta := cpcNENHUM;
      fraConsulta_.Width := TDBAdvGrid(Sender).Columns[Acol].Width - 5;
      fraConsulta_.edfcodigo.Width := fraConsulta_.Width-23;
      fraConsulta_.sbnprocura.left := fraConsulta_.edfcodigo.Width;

      fraConsulta_.edfCodigo.text := dtmCadastroContratos.dsrProdutosContratosLotes.dataset.fieldbyname(TDBAdvGrid(Sender).Columns[Acol].fieldname).asString;
      fraConsulta_.edfCodigo.modified := true;

      fraConsulta_.edfCodigo.Operacao := opATRIBUICAO;
      fraConsulta_.edfCodigo.MaxLength := 20;
      fraConsulta_.edfCodigo.DataSource := dtmCadastroContratos.dsrProdutosContratosLotes;
      fraConsulta_.edfCodigo.DataaFieldInterno := 'lote';
      fraConsulta_.edfCodigo.DataaFieldVisual := TDBAdvGrid(Sender).Columns[Acol].FieldName;
      fraConsulta_.edfCodigo.DataField := TDBAdvGrid(Sender).Columns[Acol].FieldName;

      fraConsulta_.edfCodigo.LookupSource := fraConsulta_.dsrProcuraEstoquesLotesProdutos;
      fraConsulta_.edfCodigo.LookupaFieldinterno := 'lote';
      fraConsulta_.edfCodigo.LookupaFieldvisual := 'nrlote';
      fraConsulta_.edfCodigo.LookupQueryParameter := 'nrlote';
      fraConsulta_.edfCodigo.LookupField := 'nrlote';

      fraConsulta_.CondicoesdaConsulta := CondicoesdaConsultaLotes;
      fraConsulta_.OnFound := AtribuirDadosProdutosContratosLotes;

//      fraConsulta_.OnFound := AtribuirDadostipoproduto;
      TipoPesquisa := pesESTOQUESLOTESPRODUTOS;

//      fraConsulta_.edfCodigo.readonly := (dtmCadastroContratos.dsrProdutosContratosLotes.dataset.state = dsedit)
//      fraConsulta_.edfCodigo.readonly := dtmCadastroContratos.dsrProdutosContratosLotes.dataset.fieldbyname(TDBAdvGrid(Sender).Columns[Acol].fieldname).asString<>'';

    end;
    fraConsulta_.visible := true;
  end
  else
  if (TDBAdvGrid(Sender).Columns[Acol].Field.DataType = ftFloat) or
     (TDBAdvGrid(Sender).Columns[Acol].FieldName = 'quantidade') then
  begin
    DBAdvEditFloat.datasource := dtmCadastroContratos.dsrProdutosContratosLotes;
    DBAdvEditFloat.datafield := TDBAdvGrid(Sender).Columns[Acol].Fieldname;
    DBAdvEditFloat.visible := true;
    DBAdvEditFloat.width :=  TDBAdvGrid(Sender).Columns[Acol].Width -  5;

  end;

end;

procedure TfrmCadastroProdutosContrato.DBAdvGridLotesCheckRequiredFields(
  Sender: TObject; var Allow: Boolean);
begin
  inherited;
  Allow := dtmCadastroContratos.qryProdutosContratosLotes.CheckRequiredFields(false, true, true, self, true);
  AtualizarParametrosGridLoteProdutos;
end;

procedure TfrmCadastroProdutosContrato.DBAdvGridLotesKeyDown(
  Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;
  if Shift = [ssCtrl] then
  begin
    case Key of
      TeclaEditarRegistro :
      begin
        if sbnIncluirLotes.enabled then
        begin
          DBAdvGridLotes.setfocus;
          DBAdvGridLotes.datasource.dataset.edit;
        end;
      end;
      TeclaInserirRegistro:
        begin
           if sbnIncluirLotes.enabled then
             DBAdvGridLotes.datasource.dataset.append;
        end;
      VK_F9:
      begin
        if (TDBAdvGrid(Sender).Columns[TDBAdvGrid(Sender).col].FieldName = 'nrlote') then
        begin
          DBAdvGridLotes.ShowInplaceEdit;
          fraConsulta_.sbnProcuraClick(sender)
        end;
      end;

    end;
  end;

end;

procedure TfrmCadastroProdutosContrato.FormControlEditLink1SetEditorFocus(
  Sender: TObject; Grid: TAdvStringGrid; AControl: TWinControl);
begin
  inherited;
  if (TDBAdvGrid(Grid).Columns[Grid.col].Field.DataType = ftFloat) or
     (TDBAdvGrid(grid).Columns[grid.col].FieldName = 'quantidade') then
    DBAdvEditFloat.setfocus
  else
  if fraconsulta_.visible then
    fraConsulta_.edfcodigo.setfocus;
end;

procedure TfrmCadastroProdutosContrato.sbnIncluirLotesClick(
  Sender: TObject);
begin
  inherited;
  DBAdvGridLotes.datasource.dataset.append;
end;

procedure TfrmCadastroProdutosContrato.sbnExcluirLotesClick(
  Sender: TObject);
begin
  inherited;
  if not DBAdvGridLotes.datasource.dataset.isempty then
    DBAdvGridLotes.datasource.dataset.delete;
end;

procedure TfrmCadastroProdutosContrato.CondicoesdaConsultaLotes;
begin
  fraconsulta_.qryProcuraEstoquesLotesProdutos.parambyname('produto').asString :=
    dtmCadastroContratos.qryProdutosContratosproduto.asstring;

  fraconsulta_.qryProcuraEstoquesLotesProdutos.parambyname('filial').asString :=
    dtmCadastroContratos.qryProdutosContratosfilial.asstring;

  fraconsulta_.qryConsultaEstoquesLotesProdutos.parambyname('produto').asString :=
    dtmCadastroContratos.qryProdutosContratosproduto.asstring;

    {
  DBAdvGridLotes.ColumnDistinct()

  fraconsulta_.qryConsultaEstoquesLotesProdutos.MacroByName('SQLCondicaoJaCadastrados').asString :=
    'and l.nrlote not in ('+
    }


  fraconsulta_.qryConsultaEstoquesLotesProdutos.parambyname('filial').asString :=
    dtmCadastroContratos.qryProdutosContratosfilial.asstring;
end;

procedure TfrmCadastroProdutosContrato.DBAdvGridLotesEnter(
  Sender: TObject);
begin
  inherited;
  tipoconsulta := cpcNENHUM;
end;

procedure TfrmCadastroProdutosContrato.AtualizarParametrosGridLoteProdutos;
begin
  with DBAdvGridLotes do
  begin
  {
    FloatingFooter.ColumnCalc[ColumnByFieldName['quantidade'].Index] := acNONE;
    FloatingFooter.ColumnCalc[ColumnByFieldName['devolvidos'].Index] := acNONE;
    FloatingFooter.ColumnCalc[ColumnByFieldName['trocados'].Index] := acNONE;



    FloatingFooter.Visible := False;
    FloatingFooter.Invalidate;

    FloatingFooter.Visible := True;
    }
    FloatingFooter.ColumnCalc[ColumnByFieldName['quantidade'].Index] := acSum;
    FloatingFooter.ColumnCalc[ColumnByFieldName['devolvidos'].Index] := acSum;
    FloatingFooter.ColumnCalc[ColumnByFieldName['trocados'].Index] := acSum;
                   {
    CalcFooter(ColumnByFieldName['quantidade'].Index);
    CalcFooter(ColumnByFieldName['devolvidos'].Index);
    CalcFooter(ColumnByFieldName['trocados'].Index);
    }

    CalcFooter(-1);

    {
    FloatingFooter.Invalidate;
    Refresh;

    CalcFooter(-1);

    FloatingFooter.Invalidate;
    Refresh;
    }




  end;
end;

procedure TfrmCadastroProdutosContrato.AtribuirDadosProdutosContratosLotes;
begin
  if DBAdvGridLotes.GetDistinctValues(1, DBAdvGridLotes.row, true ).indexof(fraConsulta_.qryProcuraEstoquesLotesProdutosnrlote.asString)<>-1 then
  begin
    MensagemAviso('Número de lote já cadastrado!');
    dtmCadastroContratos.qryProdutosContratosLotes.cancel;
  end;

  

end;

procedure TfrmCadastroProdutosContrato.DBAdvGridLotesCellValidate(
  Sender: TObject; ACol, ARow: Integer; var Value: String;
  var Valid: Boolean);
begin
  inherited;
  DBAdvGridLotes.Refresh;
  DBAdvGridLotes.FloatingFooter.Invalidate;

end;

procedure TfrmCadastroProdutosContrato.FormCloseQuery(Sender: TObject;
  var CanClose: Boolean);
begin
  CanClose := dtmCadastroContratos.ValidarProdutosContratosLotes(self, false);
  
  if canclose then
    inherited;

end;

