{ TfrmCadastroProdutosContrato }

procedure TfrmCadastroProdutosContrato.actHabilitarControlesUpdate(Sender: TObject);
begin
  inherited;
//  ckbProdutoLista.Enabled         := dtmCadastroContratos.ComLista;
//  ckbIncluirListaCasamento.Enabled:= dtmCadastroContratos.ComLista and not ckbProdutoLista.Checked;

  gbxQuantidadeacopiar.Visible    := dtmCadastroContratos.MarcarProdutoCopiar;
  lblQtdeCopiar.Visible           := dtmCadastroContratos.MarcarProdutoCopiar;
  edtQtdeCopiar.Visible           := dtmCadastroContratos.MarcarProdutoCopiar;
  lblPromocao.Visible             := dtmCadastroContratos.ProdutoEmPromocao;
  lblPrecoNormal.Visible          := dtmCadastroContratos.ProdutoEmPromocao;
  dtxPrecoNormal.Visible          := dtmCadastroContratos.ProdutoEmPromocao;

  gbxLotesdoProduto.enabled := dtmCadastroContratos.qryProdutosContratosgerenciarloteevalidade.AsBoolean;

  if not dtmCadastroContratos.PermiteDescontoProduto then
  begin
    {
    if sbnAlterarPreco.visible then
      sbnAlterarPreco.enabled := false;
      }

    edtpercentualvalordescontoitem.readonly := true;
    edtvalordescontoitem.readonly := true;
  end
  else
  begin
  {
    if sbnAlterarPreco.visible then
      sbnAlterarPreco.enabled := true;
      }
      
    edtpercentualvalordescontoitem.readonly := false;
    edtvalordescontoitem.readonly := false;
  end;

end;

constructor TfrmCadastroProdutosContrato.Create(AOwner: TComponent; dtm: TdtmCadastroContratos);
begin
  inherited Create(AOwner);
  SetDataModulo(dtm);
  if (ParSistema.ValordaQuantidade > 0) then
  begin
    Self.ActiveControl:=flkCodigoProduto;
    flkCodigoProduto.SelectAll;
  end
  else
  begin
    Self.ActiveControl := edtQuantidade;
//    edtQuantidade.SetFocus;
    edtQuantidade.SelectAll;
  end;
//  edtQuantidade.Tamanho := ParSistema.TamanhoMascaraQuantidade + 3;
  DataSet := dtmCadastroContratos.TabelaProdutoContratos;
  sbnAlterarPreco.Visible := ParSistema.PermiteAlterarPreco;
  pnlDesconto.Visible     := sbnAlterarPreco.Visible and UsuarioLogin.AlterarPrecoContrato;
  rgpMontagem.Enabled     := dtmCadastroContratos.ProdutoMontavel;
  flkVendedor.Enabled     := not UsuarioLogin.Vendedor or not ParSistema.NaoPermitirAlteraroVendedornosProdutosdoContrato;
  if UsuarioLogin.Vendedor or ParSistema.NaoPermitirAlteraroVendedornosProdutosdoContrato then
  begin
    dtxNomeVendedor.Width := dtxNomeVendedor.Width + dtxNomeVendedor.Left - flkVendedor.Left;
    dtxNomeVendedor.Left  := flkVendedor.Left;
    dtxNomeVendedor.BringToFront;
  end;

  if ParSistema.SoVisualizarEstoqueDeposito then
    gbxDepositos.Caption := uppercase(ctDEPOSITOS)
  else gbxDepositos.Caption := uppercase(ctFILIAIS);

  gbxDepositos.Visible := Not (ParSistema.FiliaisIndependentes);
  dbgDepositos.Visible      := Not (ParSistema.FiliaisIndependentes);
  gbxFILIAL.Visible    := Not (ParSistema.FiliaisIndependentes);
  flkFilial.Visible         := Not (ParSistema.FiliaisIndependentes);
  sbnConsultaFilial.Visible := Not (ParSistema.FiliaisIndependentes);
  dtxNomeFilial.Visible     := Not (ParSistema.FiliaisIndependentes);
  dbgSimilares.Columns[2].Visible := ParSistema.UsarGradesProdutos;
  dbgSimilares.Columns[3].Visible := ParSistema.UsarGradesProdutos;
  if dbgSimilares.Columns[4].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgSimilares.Columns[4].Width := ParSistema.TamanhoMascaraQuantidade;
  if dbgSimilares.Columns[5].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgSimilares.Columns[5].Width := ParSistema.TamanhoMascaraQuantidade;
  if not ParSistema.UsarGradesProdutos then
    dbgsimilares.Columns[1].Width := dbgsimilares.Columns[1].Width+
                                     dbgsimilares.Columns[2].Width+
                                     dbgsimilares.Columns[3].Width;
  dtmCadastroContratosAuxiliar.OnScrollLinhaColunaGradeSimilares := AfterScrollLinhaColunaGradeSimilares;

  gbxItemProduto.Caption := flkCodigoProduto.FParameterLabel;
  dbgSimilares.Enabled:=ParSistema.MostrarSimilaresContrato;
  rbnBrindeSIM.Enabled := ParSistema.PermitirAlterarBrindenoContrato;
  rbnBrindeNAO.Enabled := ParSistema.PermitirAlterarBrindenoContrato;
  dtmCadastroContratos.ConsultaExecutada:= False;

  gbxExibicaoPrecos.Visible := ParSistema.PrecoParaCliente;
  if not gbxExibicaoPrecos.Visible then
  begin
//    gbxFundoJanela.Height := gbxFundoJanela.Height - gbxExibicaoPrecos.Height;
//    pgcExtraProdutos.Top      := pgcExtraProdutos.Top - gbxExibicaoPrecos.Height;
//    self.Height := self.Height - gbxExibicaoPrecos.Height;

    gbxProdCliente.Visible := false;
    gbxPartNumber.Visible := false;
    gbxFinalidade.Visible := false;
  end;

  flkCodigoProduto.exist;

  tstModelodeProdutos.TabVisible := parsistema.LiberarVisualizacaodeModelosProdutos;
  tstObservacoesVenda.TabVisible := trim((dtmCadastroContratos.qryProcuraProdutoobservacoesvenda.asstring))<>'';

  if tstObservacoesVenda.TabVisible then
    pgcExtraProdutos.TabIndex := 0
  else
    pgcExtraProdutos.TabIndex := 1;

  tabObservacoesVendaNaoSetado :=  false;   


  gbxXPed.Visible := ParSistema.ClientePessoaJuridica;
  if gbxXPed.Visible then
  begin
    gbxFILIAL.Width := 246;
    dtxNomeFilial.Width := 178;
  end
  else
  begin
    gbxFILIAL.Width := 381;
    dtxNomeFilial.Width := 314;
  end;

  ckbProdutoLista.Visible := ParSistema.UtilizarListaCasamento;
  flkListaCasamento.ReadOnly := not ParSistema.UtilizarListaCasamento;
  flkListaCasamento.TabStop := ParSistema.UtilizarListaCasamento;
  gbxListadeCasamento.Visible := ParSistema.UtilizarListaCasamento;

  rgpMonstruario.visible := Parsistema.Percentualdacomissaoparaprodutosdomonstruario <> 0;

//  if not rgpMonstruario.Visible then
//    pnlCentral.Height := pnlCentral.Height - 19;

//  Timer1Timer(nil);

  tabObservacoesVendaNaoSetado :=  (dtmCadastroContratos.qryProcuraProdutoobservacoesvenda.asstring)<>'';

  pgcExtraProdutos.OwnerDraw := true;

//  AdvDBDateTimePicker1.MinDate := dtmCadastroContratos.qryContratosdata.AsDateTime;

  dbgEstoque.ColumnByName('customedio').visible := UsuarioLogin.GerenteEstoque;
  dbgEstoque.ColumnByName('precosemicms').visible := UsuarioLogin.GerenteEstoque;
  dbgEstoque.ColumnByName('precocomicms').visible := UsuarioLogin.GerenteEstoque;
  dbgEstoque.ColumnByName('valorultimacompra').visible := UsuarioLogin.GerenteEstoque;
  dbgEstoque.ColumnByName('ultimacompra_com_icms').visible := UsuarioLogin.GerenteEstoque;

{  tstFornecedores.tabvisible := UsuarioLogin.GerenteEstoque;}

  edttpDataEntrega.Calendar.MinDate.Use := true;
  edttpDAtaEntrega.Calendar.MinDate.Date := dtmCadastroContratos.qryContratosdata.asDateTime;

  pnlEdicaoDados.visible := false;

  AtualizarParametrosGridLoteProdutos;

end;

destructor TfrmCadastroProdutosContrato.Destroy;
begin
  inherited;
  frmCadastroProdutosContrato := nil;
end;

procedure TfrmCadastroProdutosContrato.edtDescricaoPrecoVendaExit(Sender: TObject);
begin
  inherited;
  edtDescricaoPrecoVenda.Enabled := False;
end;

procedure TfrmCadastroProdutosContrato.edtPrecoExit(Sender: TObject);
begin
  inherited;
  edtPreco.SendToBack;
end;

function TfrmCadastroProdutosContrato.ExisteInformacao(Parametro: Integer;
  NomeCampo: String; Value: Variant): Boolean;
begin
  if TipoConsulta = cpcPRODUTOS then
    Result := dtmCadastroContratos.ExisteProduto(NomeCampo, Value)
  else if TipoConsulta = cpcFILIAIS then
    Result := dtmCadastroContratos.ExisteFilialProduto(NomeCampo, Value)
  else if TipoConsulta = cpcRESERVAS then
    Result := dtmCadastroContratos.ExisteReserva(NomeCampo, Value)
  else if TipoConsulta = cpcVENDEDOR then
    Result := dtmCadastroContratos.ExisteVendedores(NomeCampo, Value)
  else if TipoConsulta = cpcLISTADECASAMENTO then
    Result := dtmCadastroContratos.ExisteListaCasamento(NomeCampo, Value)
  else
    Result := False
end;

procedure TfrmCadastroProdutosContrato.flkCodigoProdutoEnter(Sender: TObject);
begin
  inherited;
  dtmCadastroContratos.vListaCasamentoAux := flkListaCasamento.text;
  TipoConsulta := cpcPRODUTOS;
end;

procedure TfrmCadastroProdutosContrato.flkCodigoProdutoExit(Sender: TObject);
begin
  inherited;
  rgpMontagem.Enabled := dtmCadastroContratos.ProdutoMontavel;
  {
  if pnldesconto.Visible then
    if not edtpercentualvalordescontoitem.Focused then
      edtpercentualvalordescontoitem.SetFocus;
  }    
end;

procedure TfrmCadastroProdutosContrato.flkCodigoProdutoMessage(var Msg: String);
begin
  inherited;
  Msg := 'Produto não foi encontrado. Verifique se:'        + #13#10 +
         '- está CADASTRADO no ESTOQUE desta filial ou'     + #13#10 +
         '- está com o PREÇO DE VENDA diferente de zero ou' + #13#10 +
         '- o campo ''SISTEMA'' esta marcado no CADASTRO DE PRODUTOS' + #13#10 +
         '- já está INCLUIDO no CONTRATO ou'
end;

procedure TfrmCadastroProdutosContrato.flkExit(Sender: TObject);
begin
  inherited;
  TipoConsulta := cpcNENHUM
end;

procedure TfrmCadastroProdutosContrato.flkFilialEnter(Sender: TObject);
begin
  inherited;
  TipoConsulta := cpcFILIAIS
end;

procedure TfrmCadastroProdutosContrato.flkReservaEnter(Sender: TObject);
begin
  inherited;
  TipoConsulta := cpcRESERVAS
end;

procedure TfrmCadastroProdutosContrato.flkReservaMessage(var Msg: String);
begin
  inherited;
  Msg := 'A reserva não foi encontrada. Verifique se: ' + #13#10 +
         '- a reserva existe ou' + #13#10 +

         '- já foi finalizada ou' + #13#10 +

         '- item/filial pertencem a reserva ou' + #13#10 +

         '- vendedor que fez a reserva é o mesmo que está vendendo.'

end;

procedure TfrmCadastroProdutosContrato.flkVendedorEnter(Sender: TObject);
begin
  inherited;
  TipoConsulta := cpcVENDEDOR;
end;

function TfrmCadastroProdutosContrato.InternoExcluir: Boolean;
begin
  Result := dtmCadastroContratos.ExcluirProduto
end;

function TfrmCadastroProdutosContrato.InternoGravar: Boolean;
var
  Copia,
  Qtdade: Real;
  Editando: Boolean;
begin

  editando := dtmCadastroContratos.EditandoProdutosContratos;

  try
    Qtdade := StrToFloat(edtQuantidade.Text);
  except
    Qtdade := 0;
  end;

  try
    Copia  := StrToFloat(edtQtdeCopiar.Text);
  except
    Copia  := 0;
  end;

  Result := False;
  if Qtdade > 0 then
  begin
    if Copia > Qtdade then begin
      MensagemAviso('A quantidade à ser copiada não pode ser maior' + #10#13 +
                    'que a quantidade do produto.');
      edtQtdeCopiar.SetFocus;
    end
    else
    begin
      dtmCadastroContratos.GravandoItensContratos := true;
      Result := dtmCadastroContratos.GravarProdutoContrato(self);
      dtmCadastroContratos.GravandoItensContratos := true;
      if Result and not Editando then
      begin
        if ParSistema.AbrirConsultaAutomaticamente then
        begin
          InternoIncluir;
          CtrlOn:= True;
          TipoConsulta:= cpcPRODUTOS;
          InternoPesquisar('Produtos');
        end;
      end;
    end;
  end
  else
  begin
    MensagemAviso(ctQUANTIDADEPRODUTOSMAIORZERO);
    edtQuantidade.SetFocus;
  end

end;

function TfrmCadastroProdutosContrato.InternoIncluir: Boolean;
begin

  Result := dtmCadastroContratos.IncluirProdutosContrato;
  //flkCodigoProduto.SetFocus
  flkCodigoProdutoEnter(nil);
  AtualizarParametrosGridLoteProdutos;

  if (ParSistema.ValordaQuantidade > 0) then
    flkCodigoProduto.SetFocus
  else
    edtQuantidade.SetFocus;
end;

function TfrmCadastroProdutosContrato.InternoPesquisar(Titulo: String): Integer;
var
  Tabela: Integer;
//  parametroAnterior, locateanterior: String;
begin

  if CtrlOn and (TipoConsulta <> cpcNENHUM) then
  begin
    if TipoConsulta = cpcFILIAIS then
    begin
      Titulo := ctFILIAL;
      Tabela := ctVendaTabelaConsultaFilialProduto;
    end else if TipoConsulta = cpcRESERVAS then begin
      Titulo := ctRESERVAS;
      Tabela := ctVendaTabelaConsultaReservas;
    end else if Tipoconsulta = cpcVENDEDOR then begin
      Titulo := ctVENDEDORES;
      Tabela := ctVendaTabelaConsultaVendedores;
    end else if Tipoconsulta = cpcLISTADECASAMENTO then begin
      Titulo := ctLISTACASAMENTO;
      Tabela := ctVendaTabelaConsultaListaCasamento;
    end else
      Tabela := 0;

    if TipoConsulta = cpcPRODUTOS then
    begin
      Titulo := ctPRODUTO;
      dtmCadastroContratos.AbreConsultaProdutos(ckbProdutoLista.Checked);
      Tabela := ctVendaTabelaConsultaProdutos;
    end else
      dtmCadastroContratos.Abre(Tabela);

    try
      dtmCadastroContratos.ConsultaExecutada:= False;
      Result := inherited InternoPesquisar(Titulo);
      if Result = mrOK then begin
        if TipoConsulta = cpcPRODUTOS then
        begin
          if ParSistema.GravarProdutoContratoAutomaticamente then
          begin
            {
            parametroAnterior := flkCodigoProduto.LookupQueryParameter;
            locateanterior := flkCodigoProduto.LocateQueryParameter;

            if parsistema.PermitirProdutoAlfanumerico then
            begin
              flkCodigoProduto.LookupQueryParameter := 'produtovisual';
              flkCodigoProduto.LocateQueryParameter := 'produtovisual';
            end
            else
            begin
              flkCodigoProduto.LookupQueryParameter := 'produto';
              flkCodigoProduto.LocateQueryParameter := 'produto';
            end;
            }

            dtmCadastroContratos.SelecionarProdutoContratoConsulta;
            dtmCadastroContratos.IncluindoouEditandoProduto := false;

            flkCodigoProduto.Exist;
            flkcodigoproduto.Modified := true;
            flkCodigoProduto.DoExit;
            dtmCadastroContratos.IncluindoouEditandoProduto := true;
            //flkCodigoProduto.DoExit; {estava trocando a filial}

            {
            flkCodigoProduto.LookupQueryParameter := parametroAnterior;
            flkCodigoProduto.LocateQueryParameter := locateanterior;
            }
          end;
          if not dtmCadastroContratos.ConsultaExecutada then
          begin
            dtmCadastroContratos.SelecionarProdutoContratoConsulta;
            flkCodigoProdutoFound(true);
          end;
        end
        else if TipoConsulta = cpcFILIAIS then
        begin
          dtmCadastroContratos.SelecionarFilial;
          flkFilialFound(true);
        end
        else if TipoConsulta = cpcRESERVAS then
          dtmCadastroContratos.SelecionarReserva
        else if TipoConsulta = cpcVENDEDOR then
          dtmCadastroContratos.SelecionarVendedoresProduto
        else if TipoConsulta = cpcLISTADECASAMENTO then
          dtmCadastroContratos.SelecionarListaCasamento;

        dtmCadastroContratos.Fecha(Tabela);
      end;
    finally
      dtmCadastroContratos.Fecha(Tabela);
    end
  end else
    Result := mrNONE

end;

function TfrmCadastroProdutosContrato.JanelaPesquisa: TfrmConsultaBasica;
begin
  Result := TfrmConsultaPorCampo.Create(nil);
  TfrmConsultaPorCampo(Result).ConsultaInterativa := (TipoConsulta <> cpcPRODUTOS) or
                                                      ((TipoConsulta = cpcPRODUTOS) and
                                                         ((dtmCadastroContratos.ComLista and ckbProdutoLista.Checked) or
                                                          ParSistema.UsarConsultaInterativa));
  TfrmConsultaPorCampo(Result).UsarParametrosDaTabela := False;
end;

procedure TfrmCadastroProdutosContrato.sbnAlterarPrecoClick(Sender: TObject);
var
  UsuarioAut: TtecUsuarios;
  AlterarPreco: Boolean;
begin
  inherited;
  if dtmCadastroContratos.ProdutoComposto then
    AlterarPreco := False
  else
  if UsuarioLogin.AlterarPrecoContrato and dtmCadastroContratos.PermiteDescontoProduto then
    AlterarPreco := True
  else
  begin
    try
      UsuarioAut := dtmCadastroContratos.ObterAutorizacao(taLOGIN, ctALTERARPRECOVENDA,
         ifthen_(not dtmCadastroContratos.PermiteDescontoProduto, ctGERENTEVENDAS, ctAUTORIZADO));
      try
        if Assigned(UsuarioAut) then
        begin
          if not dtmCadastroContratos.PermiteDescontoProduto then
            AlterarPreco := UsuarioAut.GerenteVendas
          else
            AlterarPreco := UsuarioAut.AlterarPrecoContrato
        end
        else
        begin
          AlterarPreco := False;
          MensagemAviso(Format(ctUSUARIOSEMCADASTRO, ['']))
        end;
      finally
        if Assigned(UsuarioAut) then
          UsuarioAut.Free;
      end
    except
      AlterarPreco := False
    end
  end;

  if AlterarPreco then
  begin
    edtPreco.BringToFront;
    edtPreco.SetFocus;
    edtDescricaoPrecoVenda.Enabled := True;
  end else begin
    MensagemAviso(Format(ctUSUARIONAOAUTORIZADO, [ctMODIFICAPRECO]));
    if Assigned(ActiveControl) then
      ActiveControl.SetFocus
    else
      edtQuantidade.SetFocus
  end

end;

