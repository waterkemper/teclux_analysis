procedure TfrmCadastroProdutosContrato.pgcExtraProdutos_Change(
  Sender: TObject);
begin
  inherited;
  if (pgcExtraProdutos_.ActivePage = tstObservacoesVenda_) and tstObservacoesVenda_.tabvisible then
  begin
    dtmCadastroContratos.VisualizandoFornecedoresProdutos := false;
    pgcExtraProdutos_.activecolor := clRed;
  end
  else
  if (pgcExtraProdutos_.ActivePage = tstFornecedores_) and tstFornecedores_.tabvisible then
  begin
    pgcExtraProdutos_.activecolor := clBtnFace;
    dtmCadastroContratos.VisualizandoFornecedoresProdutos := true;
    dtmCadastroContratos.AbrirFornecedoresProdutos;
  end
  else
  if (pgcExtraProdutos_.ActivePage = tstProdutosporCliente_) and tstProdutosporCliente_.tabvisible then
  begin
    pgcExtraProdutos_.activecolor := clBtnFace;
    dtmCadastroContratos.VisualizandoFornecedoresProdutos := false;
    dtmCadastroContratos.AbrirProdutosporCliente;
  end
  else
  begin
    pgcExtraProdutos_.activecolor := clBtnFace;  
    dtmCadastroContratos.VisualizandoFornecedoresProdutos := false;
  end;

end;

procedure TfrmCadastroProdutosContrato.pgcExtraProdutos_Enter(
  Sender: TObject);
begin
  {Evitar travamento do tPageControl...efeito indesejado nos objeto do formulário....
  buffer...teclado...mouse...}
  pnlFundoJanela.enabled := false;
  gbxListadeCasamento.enabled := false;

  inherited;

end;

procedure TfrmCadastroProdutosContrato.pgcExtraProdutos_Exit(
  Sender: TObject);
begin
  {Evitar travamento do tPageControl...efeito indesejado nos objeto do formulário....
  buffer...teclado...mouse...}
  pnlFundoJanela.enabled := true;
  gbxListadeCasamento.enabled := true;

  inherited;

end;

procedure TfrmCadastroProdutosContrato.pgcExtraProdutos_MouseUp(
  Sender: TObject; Button: TMouseButton; Shift: TShiftState; X,
  Y: Integer);
begin
  inherited;
  {Evitar travamento do tPageControl...efeito indesejado nos objeto do formulário....
  buffer...teclado...mouse...}
  pnlFundoJanela.enabled := true;
  gbxListadeCasamento.enabled := true;

end;

end.
