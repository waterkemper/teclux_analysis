procedure TfrmCadastroProdutosContrato.SetDataModulo(
  Dtm: TdtmCadastroContratos);
begin
  dtmCadastroContratos := dtm;
  dtxDataUltimaVenda.DataSource := dtmCadastroContratos.dsrClientesProdutos;
  dtxValorUltimaVenda.DataSource := dtmCadastroContratos.dsrClientesProdutos;
  dtxDataUltimoOrcamento.DataSource := dtmCadastroContratos.dsrClientesProdutos;
  dtxValorUltimoOrcamento.DataSource := dtmCadastroContratos.dsrClientesProdutos;
  dtxPrecoAtualdoCliente.DataSource := dtmCadastroContratos.dsrClientesProdutos ;
  dtxAlteracaoPrecoCliente.DataSource := dtmCadastroContratos.dsrClientesProdutos;
  dtxAlteracao.DataSource := dtmCadastroContratos.dsrProdutoEstoque;
  dtxPrecoNormalCliente.DataSource := dtmCadastroContratos.dsrProdutoEstoque;
  dtxPrecoProduto.DataSource := dtmCadastroContratos.dsrProdutosContratos;
  flkVendedor.DataSource := dtmCadastroContratos.dsrProdutosContratos;
  flkVendedor.LookupSource := dtmCadastroContratos.dsrProcuraVendedorProduto;
  dtxNomeVendedor.DataSource := dtmCadastroContratos.dsrProcuraVendedorProduto;
  flkReserva.DataSource := dtmCadastroContratos.dsrProdutosContratos;
  flkReserva.LookupSource := dtmCadastroContratos.dsrProcuraReservaProduto               ;
  dtxReserva.DataSource := dtmCadastroContratos.dsrProcuraReservaProduto                  ;
  edtPreco.DataSource := dtmCadastroContratos.dsrProdutosContratos                         ;
  dtxDescricaoPreco.DataSource := dtmCadastroContratos.dsrProdutoEstoque                    ;
  edtDescricaoPrecoVenda.DataSource := dtmCadastroContratos.dsrProdutosContratos             ;
  edtvalordescontoitem.DataSource := dtmCadastroContratos.dsrProdutosContratos                         ;
  edtDescontoRateado.DataSource := dtmCadastroContratos.dsrProdutosContratos ;
  edtdescontoCupomDesconto.DataSource := dtmCadastroContratos.dsrProdutosContratos ;
  edtpercentualvalordescontoitem.DataSource := dtmCadastroContratos.dsrProdutosContratos ;
  edtQuantidade.DataSource := dtmCadastroContratos.dsrProdutosContratos ;
  dtxUnidade.DataSource := dtmCadastroContratos.dsrProdutosContratos     ;
  ckbProdutoLista.DataSource := dtmCadastroContratos.dsrProdutosContratos ;
  dbgDepositos.DataSource := dtmCadastroContratos.dsrEstoque               ;
  edtQtdeCopiar.DataSource := dtmCadastroContratos.dsrProdutosContratos     ;
  flkCodigoProduto.DataSource := dtmCadastroContratos.dsrProdutosContratos   ;
  flkCodigoProduto.LookupSource := dtmCadastroContratos.dsrProcuraProduto     ;
  flkCodigoProduto.LookupQueryParameter := 'produtovisual';
