  dmbasico, {dmcadastrocontratosauxiliar,} fmajudabt;

{$R *.dfm}

{ TfrmCadastroProdutosContrato }


constructor TfrmCadastroProdutosContrato.Create(AOwner: TComponent; dtm: TdtmCadastroContratos);
begin
  inherited Create(AOwner);
  SetDataModulo(dtm);
  if (ParSistema.ValordaQuantidade > 0) then
  begin
    Self.ActiveControl:=flkCodigoProduto;
    flkCodigoProduto.SelectAll;
  end
  else
  begin
    Self.ActiveControl := edtQuantidade;
//    edtQuantidade.SetFocus;
    edtQuantidade.SelectAll;
  end;
//  edtQuantidade.Tamanho := ParSistema.TamanhoMascaraQuantidade + 3;
  DataSet := dtmCadastroContratos.TabelaProdutoContratos;
  sbnAlterarPreco.Visible := ParSistema.PermiteAlterarPreco;
  pnlDesconto.Visible     := sbnAlterarPreco.Visible and UsuarioLogin.AlterarPrecoContrato;
  rgpMontagem.Enabled     := dtmCadastroContratos.ProdutoMontavel;
  flkVendedor.Enabled     := not UsuarioLogin.Vendedor or not ParSistema.NaoPermitirAlteraroVendedornosProdutosdoContrato;
  if UsuarioLogin.Vendedor or ParSistema.NaoPermitirAlteraroVendedornosProdutosdoContrato then
  begin
    dtxNomeVendedor.Width := dtxNomeVendedor.Width + dtxNomeVendedor.Left - flkVendedor.Left;
    dtxNomeVendedor.Left  := flkVendedor.Left;
    dtxNomeVendedor.BringToFront;
  end;

  if ParSistema.SoVisualizarEstoqueDeposito then
    gbxDepositos.Caption := uppercase(ctDEPOSITOS)
  else gbxDepositos.Caption := uppercase(ctFILIAIS);

  gbxDepositos.Visible := Not (ParSistema.FiliaisIndependentes);
  dbgDepositos.Visible      := Not (ParSistema.FiliaisIndependentes);
  gbxFILIAL.Visible    := Not (ParSistema.FiliaisIndependentes);
  flkFilial.Visible         := Not (ParSistema.FiliaisIndependentes);
  sbnConsultaFilial.Visible := Not (ParSistema.FiliaisIndependentes);
  dtxNomeFilial.Visible     := Not (ParSistema.FiliaisIndependentes);
  dbgSimilares.Columns[2].Visible := ParSistema.UsarGradesProdutos;
  dbgSimilares.Columns[3].Visible := ParSistema.UsarGradesProdutos;
  if dbgSimilares.Columns[4].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgSimilares.Columns[4].Width := ParSistema.TamanhoMascaraQuantidade;
  if dbgSimilares.Columns[5].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgSimilares.Columns[5].Width := ParSistema.TamanhoMascaraQuantidade;
  if not ParSistema.UsarGradesProdutos then
    dbgsimilares.Columns[1].Width := dbgsimilares.Columns[1].Width+
                                     dbgsimilares.Columns[2].Width+
                                     dbgsimilares.Columns[3].Width;


  gbxItemProduto.Caption := flkCodigoProduto.FParameterLabel;
  dbgSimilares.Enabled:=ParSistema.MostrarSimilaresContrato;
  rbnBrindeSIM.Enabled := ParSistema.PermitirAlterarBrindenoContrato;
  rbnBrindeNAO.Enabled := ParSistema.PermitirAlterarBrindenoContrato;
  dtmCadastroContratos.ConsultaExecutada:= False;

  gbxExibicaoPrecos.Visible := ParSistema.PrecoParaCliente;
  if not gbxExibicaoPrecos.Visible then
  begin
//    gbxFundoJanela.Height := gbxFundoJanela.Height - gbxExibicaoPrecos.Height;
//    pgcExtraProdutos.Top      := pgcExtraProdutos.Top - gbxExibicaoPrecos.Height;
//    self.Height := self.Height - gbxExibicaoPrecos.Height;

    gbxProdCliente.Visible := false;
    gbxPartNumber.Visible := false;
    gbxFinalidade.Visible := false;
  end;

  flkCodigoProduto.exist;

  tstModelodeProdutos_.TabVisible := parsistema.LiberarVisualizacaodeModelosProdutos;
  tstObservacoesVenda_.TabVisible := trim((dtmCadastroContratos.qryProcuraProdutoobservacoesvenda.asstring))<>'';

  if tstObservacoesVenda_.TabVisible then
    pgcExtraProdutos_.ActivePage := tstObservacoesVenda_
  else
    pgcExtraProdutos_.ActivePage := tstProdutosSimilares_;

//  tabObservacoesVendaNaoSetado :=  false;   


  gbxXPed.Visible := ParSistema.ClientePessoaJuridica;
  if gbxXPed.Visible then
  begin
    gbxFILIAL.Width := 246;
    dtxNomeFilial.Width := 178;
  end
  else
  begin
    gbxFILIAL.Width := 381;
    dtxNomeFilial.Width := 314;
  end;

  ckbProdutoLista.Visible := ParSistema.UtilizarListaCasamento;
  flkListaCasamento.ReadOnly := not ParSistema.UtilizarListaCasamento;
  flkListaCasamento.TabStop := ParSistema.UtilizarListaCasamento;
  gbxListadeCasamento.Visible := ParSistema.UtilizarListaCasamento;

  rgpMonstruario.visible := Parsistema.Percentualdacomissaoparaprodutosdomonstruario <> 0;

//  if not rgpMonstruario.Visible then
//    pnlCentral.Height := pnlCentral.Height - 19;

//  Timer1Timer(nil);

//  tabObservacoesVendaNaoSetado :=  (dtmCadastroContratos.qryProcuraProdutoobservacoesvenda.asstring)<>'';

//  pgcExtraProdutos.OwnerDraw := true;

//  AdvDBDateTimePicker1.MinDate := dtmCadastroContratos.qryContratosdata.AsDateTime;

  dbgEstoque.ColumnByName('customedio').visible := UsuarioLogin.GerenteEstoque;
  dbgEstoque.ColumnByName('precosemicms').visible := UsuarioLogin.GerenteEstoque;
  dbgEstoque.ColumnByName('precocomicms').visible := UsuarioLogin.GerenteEstoque;
  dbgEstoque.ColumnByName('valorultimacompra').visible := UsuarioLogin.GerenteEstoque;
  dbgEstoque.ColumnByName('ultimacompra_com_icms').visible := UsuarioLogin.GerenteEstoque;

{  tstFornecedores.tabvisible := UsuarioLogin.GerenteEstoque;}

  edttpDataEntrega.Calendar.MinDate.Use := true;
  edttpDAtaEntrega.Calendar.MinDate.Date := dtmCadastroContratos.qryContratosdata.asDateTime;

  pnlEdicaoDados.visible := false;

//  DBAdvGridLotes.FloatingFooter.Visible := true;
  AtualizarParametrosGridLoteProdutos;

  edtPreco.NrDecimal := ParSistema.PrecoUnitarioCasasDecimais;
end;

destructor TfrmCadastroProdutosContrato.Destroy;
begin
  {
  fraVendasAnteriores1.qryProdutosporCliente.close;
  fraVendasAnteriores1.DBAdvGridProdutosporCliente.Bands.active := false;
  }

  dtmCadastroContratos.dtmCadastroContratosAuxiliar.OnScrollLinhaColunaGradeSimilares := nil;
  dtmCadastroContratos.AfterChangeProdutosContratosLotes := nil;
//  DBAdvGridLotes.FloatingFooter.EnableCalculation := false;
//  DBAdvGridLotes.FloatingFooter.Visible := false;

//  FormControlEditLink1.free;

  inherited;
//  frmCadastroProdutosContrato := nil;
end;

procedure TfrmCadastroProdutosContrato.edtDescricaoPrecoVendaExit(Sender: TObject);
begin
  inherited;
  edtDescricaoPrecoVenda.Enabled := False;
end;

procedure TfrmCadastroProdutosContrato.edtPrecoExit(Sender: TObject);
begin
  inherited;
  edtPreco.SendToBack;
end;

function TfrmCadastroProdutosContrato.ExisteInformacao(Parametro: Integer;
  NomeCampo: String; Value: Variant): Boolean;
begin
  if TipoConsulta = cpcPRODUTOS then
    Result := dtmCadastroContratos.ExisteProduto(NomeCampo, Value)
  else if TipoConsulta = cpcFILIAIS then
    Result := dtmCadastroContratos.ExisteFilialProduto(NomeCampo, Value)
  else if TipoConsulta = cpcRESERVAS then
    Result := dtmCadastroContratos.ExisteReserva(NomeCampo, Value)
  else if TipoConsulta = cpcVENDEDOR then
    Result := dtmCadastroContratos.ExisteVendedores(NomeCampo, Value)
  else if TipoConsulta = cpcLISTADECASAMENTO then
    Result := dtmCadastroContratos.ExisteListaCasamento(NomeCampo, Value)
  else
    Result := False
end;

procedure TfrmCadastroProdutosContrato.flkCodigoProdutoEnter(Sender: TObject);
begin
  inherited;
  dtmCadastroContratos.vListaCasamentoAux := flkListaCasamento.text;
  TipoConsulta := cpcPRODUTOS;
end;

procedure TfrmCadastroProdutosContrato.flkCodigoProdutoExit(Sender: TObject);
begin
  inherited;
  rgpMontagem.Enabled := dtmCadastroContratos.ProdutoMontavel;
  {
  if pnldesconto.Visible then
    if not edtpercentualvalordescontoitem.Focused then
      edtpercentualvalordescontoitem.SetFocus;
  }    
end;

procedure TfrmCadastroProdutosContrato.flkCodigoProdutoMessage(var Msg: String);
begin
  inherited;
  Msg := 'Produto não foi encontrado. Verifique se:'        + #13#10 +
         '- está CADASTRADO no ESTOQUE desta filial ou'     + #13#10 +
         '- está com o PREÇO DE VENDA diferente de zero ou' + #13#10 +
         '- o campo ''SISTEMA'' esta marcado no CADASTRO DE PRODUTOS' + #13#10 +
         '- já está INCLUIDO no CONTRATO ou'
end;

procedure TfrmCadastroProdutosContrato.flkExit(Sender: TObject);
begin
  inherited;
  TipoConsulta := cpcNENHUM
end;

procedure TfrmCadastroProdutosContrato.flkFilialEnter(Sender: TObject);
begin
  inherited;
  TipoConsulta := cpcFILIAIS
end;

procedure TfrmCadastroProdutosContrato.flkReservaEnter(Sender: TObject);
begin
  inherited;
  TipoConsulta := cpcRESERVAS
end;

procedure TfrmCadastroProdutosContrato.flkReservaMessage(var Msg: String);
begin
  inherited;
