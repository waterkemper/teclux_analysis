procedure TfrmCadastroProdutosContrato.KeyDown(var Key: Word;
  Shift: TShiftState);
begin
  case key of
    VK_Return: if Shift = [] then
               begin
                 if ((ActiveControl = flkCodigoProduto) and (ParSistema.GravarProdutoContratoAutomaticamente)) then
                 begin
                   dtmCadastroContratos.IncluindoouEditandoProduto := false;
                   inherited;
                   if InternoGravar then
                   begin
//                     flkcodigoproduto.Clear;
                     flkCodigoProduto.setfocus;
                     flkCodigoProduto.selectall;
                   end;
                   dtmCadastroContratos.IncluindoouEditandoProduto := true;
                   dtmCadastroContratos.AbrirDadosprodutos;
                 end
                 else inherited;
               end;
    else inherited;
  end
end;

procedure TfrmCadastroProdutosContrato.flkCodigoProdutoKeyDown(
  Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;
  gbxItemProduto.Caption := flkCodigoProduto.FParameterLabel;
end;

procedure TfrmCadastroProdutosContrato.edtQuantidadeKeyDown(
  Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;
  case key of
    VK_return :
    {bloqueado a linha abaixo devido ao fato que ao voltar do produto para a
     quantidade, mesmo alterando a quantidade o valor fica 1 pois
     esta editando e não incluindo}
//      if dtmCadastroContratos.IncluindoProdutosContratos then
        flkCodigoProduto.ConfirmarQuantidade := true;
  end;
end;

procedure TfrmCadastroProdutosContrato.flkCodigoProdutoFound(
  Found: Boolean);
begin
  inherited;
  if found {and not dtmCadastroContratos.ConsultaExecutada} then
  begin

    dtmCadastroContratos.ConsultaExecutada := true;

    if ParSistema.ProdutoVendaFutura then
    begin
      if not dtmCadastroContratos.ValidarProdutosContratos then
        edtQuantidade.SetFocus;
    end
    else
      dtmCadastroContratos.SelecionarProdutoContratoProcura;

    Timer1Timer(nil);
    dtmCadastroContratos.RefazConsultaPrecoParaCliente;


    if parsistema.GravarProdutoContratoAutomaticamente then
    begin
      flkCodigoProduto.setfocus;
      flkCodigoProduto.SelectAll;
    end
    else
    if pnldesconto.Visible then
    begin
      edtpercentualvalordescontoitem.SetFocus;
      edtpercentualvalordescontoitem.selectall;
    end;

  end;

end;

procedure TfrmCadastroProdutosContrato.flkFilialFound(Found: Boolean);
begin
  inherited;
  if found then
    dtmCadastroContratos.SelecionarFilialContratoProcura;
end;

