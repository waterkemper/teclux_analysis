{
procedure TfrmCadastroProdutosContrato.pgcExtraProdutosDrawTab(
  Control: TCustomTabControl; TabIndex: Integer; const Rect: TRect;
  Active: Boolean);
begin
  inherited;
  Control.Canvas.Font.Color := clBlack;

  if (pgcExtraProdutos.Pages[TabIndex] = tstObservacoesVenda) and tstObservacoesVenda.tabvisible then
  begin
    if (dtmCadastroContratos.qryProcuraProdutoobservacoesvenda.asstring)<>'' then
    begin
      Control.Canvas.Font.Color := clWhite;
      Control.Canvas.Brush.Color := clRed;
    end;
  end;

  if tstObservacoesVenda.tabvisible then
  begin
    Control.Canvas.TextOut(Rect.left+5,Rect.top+3,pgcExtraProdutos.Pages[tabindex].Caption);
    pgcExtraProdutos.Pages[TabIndex].Font.Color :=  Control.Canvas.Font.Color;
  end
  else
  begin
    Control.Canvas.TextOut(Rect.left+5,Rect.top+3,pgcExtraProdutos.Pages[tabindex + 1].Caption);
    pgcExtraProdutos.Pages[TabIndex + 1].Font.Color := Control.Canvas.Font.Color;
  end;

  tstObservacoesVenda.font.color := clRed;

  SetarTabProduto;

end;
}

