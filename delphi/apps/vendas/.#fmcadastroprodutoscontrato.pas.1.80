procedure TfrmCadastroProdutosContrato.sbnSugerirQuantidadeLotesClick(
  Sender: TObject);
var
  vContinuar: Boolean;
begin
  inherited;

  vContinuar := True;
  if not dtmCadastroContratos.qryProdutosContratosLotes.isempty then
    if MensagemConfirmacao('As quantidades dos lotes serão refeitas considerando a data de validade mais antiga.'+chr(13)+
                           'Confirma?')=smbCancel then
      vContinuar := false;

  if vContinuar then
  begin
    AtribuirParametros(pesESTOQUESLOTESPRODUTOS, 'nrlote');
    SugerirQuantidadeLotes;
  end;  
end;

procedure TfrmCadastroProdutosContrato.AtribuirParametros(
  TipoPesquisa: TtecPesquisa; NomedoCampo: String);
begin
  case TipoPesquisa of
    pesESTOQUESLOTESPRODUTOS:
    begin

      With fraConsulta_ do
      begin
        TipoConsulta := cpcNENHUM;

//        fraConsulta_.Width := TDBAdvGrid(Sender).Columns[Acol].Width - 5;
        fraConsulta_.edfcodigo.Width := fraConsulta_.Width-23;
        fraConsulta_.sbnprocura.left := fraConsulta_.edfcodigo.Width;

//        fraConsulta_.edfCodigo.text := dtmCadastroContratos.dsrProdutosContratosLotes.dataset.fieldbyname(TDBAdvGrid(Sender).Columns[Acol].fieldname).asString;
        fraConsulta_.edfCodigo.text := dtmCadastroContratos.dsrProdutosContratosLotes.dataset.fieldbyname(NomedoCampo).asString;
        fraConsulta_.edfCodigo.modified := true;

        fraConsulta_.edfCodigo.Operacao := opATRIBUICAO;
        fraConsulta_.edfCodigo.MaxLength := 20;
        fraConsulta_.edfCodigo.DataSource := dtmCadastroContratos.dsrProdutosContratosLotes;
        fraConsulta_.edfCodigo.DataaFieldInterno := 'lote';
//        fraConsulta_.edfCodigo.DataaFieldVisual := TDBAdvGrid(Sender).Columns[Acol].FieldName;
        fraConsulta_.edfCodigo.DataaFieldVisual := NomedoCampo;
//        fraConsulta_.edfCodigo.DataField := TDBAdvGrid(Sender).Columns[Acol].FieldName;
        fraConsulta_.edfCodigo.DataField := NomedoCampo;

        fraConsulta_.edfCodigo.LookupSource := fraConsulta_.dsrProcuraEstoquesLotesProdutos;
        fraConsulta_.edfCodigo.LookupaFieldinterno := 'lote';
        fraConsulta_.edfCodigo.LookupaFieldvisual := 'nrlote';
        fraConsulta_.edfCodigo.LookupQueryParameter := 'nrlote';
        fraConsulta_.edfCodigo.LookupField := 'nrlote';

        fraConsulta_.CondicoesdaConsulta := CondicoesdaConsultaLotes;
        fraConsulta_.OnFound := AtribuirDadosProdutosContratosLotes;

        TipoPesquisa := pesESTOQUESLOTESPRODUTOS;

      end;

//      dtmCadastroContratos.fraconsulta_ := self.fraConsulta_;

    end;
  end;


end;

procedure TfrmCadastroProdutosContrato.DBAdvGridLotesColorSelect(
  Sender: TObject; ACol, ARow: Integer; Color: TColor; Value: String);
begin
  inherited;

  if (ACol = TDBAdvGrid(sender).ColumnByFieldName['produtoscontratoslotes_situacao'].Index) then
  begin
    if TDBAdvGrid(sender).cells[Acol, ARow] = 'A' then
      Color := lblAtendidos.font.color
    else
    if TDBAdvGrid(sender).cells[Acol, ARow] = 'P' then
      Color := lblAtendidos.font.color
    else
    if TDBAdvGrid(sender).cells[Acol, ARow] = 'N' then
      Color := lblNaoAtendidos.font.color
    else
      Color := clBlack;

  end;

end;

procedure TfrmCadastroProdutosContrato.DBAdvGridLotesGetCellColor(
  Sender: TObject; ARow, ACol: Integer; AState: TGridDrawState;
  ABrush: TBrush; AFont: TFont);
begin
  inherited;
  if (ACol = TDBAdvGrid(sender).ColumnByFieldName['produtoscontratoslotes_situacao'].Index) then
  begin
    if TDBAdvGrid(sender).cells[Acol, ARow] = 'A' then
      AFont.Color := lblAtendidos.font.color
    else
    if TDBAdvGrid(sender).cells[Acol, ARow] = 'P' then
      AFont.Color := lblAtendidos.font.color
    else
    if TDBAdvGrid(sender).cells[Acol, ARow] = 'N' then
      AFont.Color := lblNaoAtendidos.font.color
    else
      AFont.Color := clBlack;

  end;

end;

procedure TfrmCadastroProdutosContrato.SugerirQuantidadeLotes;
var
  vQuantidade, vQuantidadeLote : Real;
 { v_produtoscontratoslotes_situacao : String;}
begin
  try
  DBAdvGridLotes.EditPostMode := epRow;
  with dtmCadastroContratos do
  begin
    DBAdvGridLotes.datasource.dataset.first;

   {Quando contrato na situação Orçado...sem problemas e recomeçar apagando tudo...não há processamento....
   Mas...quando reservado?}

    while not DBAdvGridLotes.datasource.dataset.eof do
      DBAdvGridLotes.datasource.dataset.delete;

    vQuantidade := qryProdutosContratosquantidade.asFloat;
    vQuantidadeLote := 0;

    with fraConsulta_ do
    begin
      qryConsultaEstoquesLotesProdutos.close;
      qryConsultaEstoquesLotesProdutos.open;
      qryConsultaEstoquesLotesProdutos.first;

      while not qryConsultaEstoquesLotesProdutos.eof and (vQuantidade<>0) do
      begin

        if qryConsultaEstoquesLotesProdutosSaldoEstoque.asFloat <> 0 then
        begin
          if qryConsultaEstoquesLotesProdutosSaldoEstoque.asFloat >= vQuantidade then
          begin
            vQuantidadeLote := vQuantidade;
//            v_produtoscontratoslotes_situacao := 'A';
          end
          else
          begin
//            v_produtoscontratoslotes_situacao := 'A';
            vQuantidadeLote := qryConsultaEstoquesLotesProdutosSaldoEstoque.asFloat;
          end;

          vQuantidade := vQuantidade - vQuantidadeLote;

          if vQuantidadeLote <> 0 then
          begin

            DBAdvGridLotes.datasource.dataset.append;
//            if not (DBAdvGridLotes.datasource.dataset.state = dsinsert) then
//              DBAdvGridLotes.datasource.dataset.edit;


//            qryProdutoscontratoslotes.Append;
            qryProdutosContratosLoteslote.asString := qryConsultaEstoquesLotesProdutoslote.asString;
            qryProdutosContratosLotesloteoriginal.asString := qryProdutosContratosLoteslote.asString;

            qryProdutosContratosLotesnrlote.asString := qryConsultaEstoquesLotesProdutosnrlote.AsString;
            qryProdutosContratosLotesquantidade.asfloat := vQuantidadeLote;
            qryProdutosContratosLotesquantidadeantesalterar.asFloat := qryProdutosContratosLotesquantidade.asFloat;

//            qryProdutosContratosLotesquantidadeoriginal.asfloat := vQuantidadeLote;
            qryProdutosContratosLotesprodutoscontratoslotes_situacao.asString :=  'A';
{              v_produtoscontratoslotes_situacao;}

            DBAdvGridLotes.datasource.dataset.Post;

          end;
        end;
        qryConsultaEstoquesLotesProdutos.next;
      end;
    end;
  end;

  finally
    AtualizarParametrosGridLoteProdutos;
    DBAdvGridLotes.EditPostMode := epCell;
  end;

end;

function TfrmCadastroProdutosContrato.TotalProdutoLotes: Real;
begin
  result := StrToFloatDef(DBAdvGridLotes.cells[DBAdvGridLotes.ColumnByFieldName['quantidade'].Index, DBAdvGridLotes.rowcount-1], 0);
end;

function TfrmCadastroProdutosContrato.TotalPendenteProdutoLotes: Real;
begin
  result := dtmCadastroContratos.qryProdutosContratosquantidade.asFloat -
            TotalProdutoLotes;

end;

