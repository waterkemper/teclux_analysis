  begin
    if dtmConsultaContratos.qryContratosos.asBoolean then
      TfrmPrincipalBasico(Application.MainForm).MostrarFormRegistrado([dtmConsultaContratos.qryContratosnumero.asstring], 'TfrmOrdemServico', True)
    else
      TfrmPrincipalBasico(Application.MainForm).MostrarFormRegistrado([dtmConsultaContratos.qryContratosnumero.asstring], 'TfrmCadastroContratos', True)
  end;

end;

procedure TfrmConsultaContratos.OperacaoPadrao(Value: array of Variant);
begin
  inherited;
  pgcContratos.activePage := tstFiltros;
  if Value[0] <> '' then
  begin
    edfcliente.text := Value[0];
    dtmConsultaContratos.qryClientes.parambyname('codigo').asString := Value[0];
    dtmConsultaContratos.qryClientes.parambyname('tipo').asString := Value[1];
    edfcliente.exist;
    edfcliente.setfocus;
  end

end;

function TfrmConsultaContratos.NomeFrameVendedorServico: String;
begin
  result := self.name+'_'+GetEnumName(TypeInfo(TtecPesquisa), integer(pesVENDEDORES))+'_'+dbgServicos.DataSource.dataset.name+'_vendedor';
end;

procedure TfrmConsultaContratos.AtribuirDadosUsuariosServicos;
begin
  with dtmConsultaContratos do
  begin
    if parsistema.NaoPermitirAlteraroVendedornosProdutosdoContrato then
    begin
      AtribuirDados(qryServicosContratos,
                    [qryServicosContratosvendedor, qryServicosContratosnomevendedor, qryServicosContratosvendedoralterado],
                    [tfraconsultacodigo(self.FindComponent(NomeFrameVendedorServico)).qryProcuraVendedorescodigo.AsInteger,
                     tfraconsultacodigo(self.FindComponent(NomeFrameVendedorServico)).qryProcuraVendedoresnome.AsString,
                     True]);

     qryContratosAlteracao.edit;
     qryContratosAlteracaovendedor.asInteger := tfraconsultacodigo(self.FindComponent(NomeFrameVendedorServico)).qryProcuraVendedorescodigo.AsInteger;
     qryContratosAlteracao.post;

    end
    else
    begin
      EditarServicosContratos;
//      qryServicosContratosvendedor.AsInteger := ConsultaVendedoresProdutosContratos.qryProcuraVendedorescodigo.AsInteger;
      qryServicosContratosnomevendedor.AsString := tfraconsultacodigo(self.FindComponent(NomeFrameVendedorServico)).qryProcuraVendedoresnome.AsString;
      qryServicosContratosvendedoralterado.AsBoolean := true;
    end;
  end;

end;

end.
