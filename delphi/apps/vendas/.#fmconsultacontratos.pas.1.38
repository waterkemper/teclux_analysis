end;

procedure TfrmConsultaContratos.sbnImprimirClick(Sender: TObject);
var
  CarnesAbertas, ImprimirContrato: Boolean;
begin
      (*
  if ({(dtmOperacoesContratos.SituacaoContrato > scRESERVADO) and} (Length(dtmOperacoesContratos.IntervaloCarnesAbertas)>0)) then
    CarnesAbertas:= True
  else
  *)

  frmConfirmarImpressaoNoContrato := TfrmConfirmarImpressaoNoContrato.Create(frmConfirmarImpressaoNoContrato, True, false,
                                     false, false, false, 1, false);

  frmConfirmarImpressaoNoContrato.pnlImprimirListaProdutosporLocalizacoes.visible := True;
  frmConfirmarImpressaoNoContrato.pnlImprimirContratomeiaPagina.visible := False;
  frmConfirmarImpressaoNoContrato.pnlParcelas.visible := False;
  frmConfirmarImpressaoNoContrato.ckbImprimirContrato.caption := 'Relatório de Contratos/Produtos';

  try
    frmConfirmarImpressaoNoContrato.ShowModal;

    if frmConfirmarImpressaoNoContrato.ModalResult = mrOK then
    begin
      try

        dbgProdutosNota.datasource := nil;
        dbgSimilares.datasource := nil;

        if frmConfirmarImpressaoNoContrato.ckbImprimirListaProdutosporLocalizacao.checked then
          dtmConsultaContratos.ImprimirListaProdutosporLocalizacao
        else
        if frmConfirmarImpressaoNoContrato.Contrato then
          dtmConsultaContratos.ImprimirRelatorio;

  {
        if frmConfirmarImpressaoNoContrato.Carne then
          dtmOperacoesContratos.ImprimirCarne(frmConfirmarImpressaoNoContrato.Sequencia)
        else
        if frmConfirmarImpressaoNoContrato.CarneAbertas then
          dtmOperacoesContratos.ImprimirCarne(frmConfirmarImpressaoNoContrato.Sequencia);

        if frmConfirmarImpressaoNoContrato.Boleto then
          dtmOperacoesContratos.ImprimirBoleto(frmConfirmarImpressaoNoContrato.Sequencia);

        if frmConfirmarImpressaoNoContrato.Saldo then
          dtmOperacoesContratos.ImprimirSaldo;

        if frmConfirmarImpressaoNoContrato.etiquetasListacasamento then
          dtmOperacoesContratos.ImprimirEtiquetasListaCasamento;
          }

      finally
        dbgProdutosNota.datasource := dtmConsultaContratos.dsrProdutosContratos;
        dbgSimilares.datasource := dtmConsultaContratos.dsrProdutosSimilares;
      end;
    end
  finally
    frmConfirmarImpressaoNoContrato.Free;
  end
end;


{
begin
  inherited;
  if sbnImprimir.Enabled then
  begin
    dtmConsultaContratos.QuebraPorCliente:=False;
    dtmConsultaContratos.ImprimirRelatorio;
  end;
end;
}

procedure TfrmConsultaContratos.actHabilitarBotoesUpdate(Sender: TObject);
begin
  inherited;
  sbnImprimir.Enabled := dtmConsultaContratos.QtdeMarcados > 0;
  rgpTipoEquipamento.visible := ckbTipoOrdemServico.checked;

  sbnAtendimento.enabled := (dtmConsultaContratos.qryContratos.recordcount <> 0) and
                            (pgcContratos.activepage = tstRegistros);


  tstVendedores.Highlighted := (fraSelecaoAleatoriausuarios.fraSelecaoAleatoriausuarios.qryselecaoaleatoria.recordcount <> 0);
  tstGruposdeVendedores.Highlighted := (fraSelecaoAleatoriagruposusuarios1.fraSelecaoAleatoriagruposusuarios.qryselecaoaleatoria.recordcount <> 0);
  tstPlanos.Highlighted := (fraSelecaoAleatoriaPlanosdePagamento.qryselecaoaleatoria.recordcount <> 0);

end;

procedure TfrmConsultaContratos.ckbSelecionarTodosClick(Sender: TObject);
begin
  inherited;
  dtmConsultaContratos.MarcarSelecionados(ckbSelecionarTodos.Checked, True);
end;

procedure TfrmConsultaContratos.dbgProdutosNotaDblClick(Sender: TObject);
begin
  inherited;
  AcionarPesquisaGrade;
end;

procedure TfrmConsultaContratos.AcionarPesquisaGrade;
begin
  if (dbgProdutosNota.SelectedField = dtmConsultaContratos.qryProdutosContratosvendedor) or
     (dbgProdutosNota.SelectedField = dtmConsultaContratos.qryProdutosContratosnomevendedor) then
//  SelectedIndex in [15..16] then
  begin
    dbgProdutosNota.SetFocus;
    ConsultaVendedoresProdutosContratos.CtrlOn := True;
    ConsultaVendedoresProdutosContratos.InternoPesquisar(ctUSUARIOS);
    dbgProdutosNota.SetFocus;
    dbgProdutosNota.SelectedIndex :=  15;
  end;
end;

procedure TfrmConsultaContratos.AtribuirDadosUsuarios;
begin
  with dtmConsultaContratos do
  begin
    if parsistema.NaoPermitirAlteraroVendedornosProdutosdoContrato then
    begin
      AtribuirDados(qryProdutosContratos,
                    [qryProdutosContratosvendedor, qryProdutosContratosnomevendedor, qryProdutosContratosvendedoralterado],
                    [ConsultaVendedoresProdutosContratos.qryProcuraVendedorescodigo.AsInteger,
                     ConsultaVendedoresProdutosContratos.qryProcuraVendedoresnome.AsString,
                     True]);

     qryContratosAlteracao.edit;
     qryContratosAlteracaovendedor.asInteger := ConsultaVendedoresProdutosContratos.qryProcuraVendedorescodigo.AsInteger;
     qryContratosAlteracao.post;

    end
    else
    begin
      EditarServicosContratos;
      qryProdutosContratosvendedor.AsInteger := ConsultaVendedoresProdutosContratos.qryProcuraVendedorescodigo.AsInteger;
      qryServicosContratosnomevendedor.AsString := ConsultaVendedoresProdutosContratos.qryProcuraVendedoresnome.AsString;
      qryProdutosContratosvendedoralterado.AsBoolean := true;
    end;
  end;
end;

procedure TfrmConsultaContratos.dbgProdutosNotaKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  if CtrlOn then
  begin
    case Key of
      VK_F9     : begin
                     ConsultaVendedoresProdutosContratos.CtrlOn := true;
                     AcionarPesquisaGrade
                   end;
    end;
  end
  else
  begin
   case key of
      VK_Return :
      begin
        if dbgProdutosNota.SelectedField = dbgProdutosNota.DataSource.DataSet.FieldByName('vendedor')  then
        begin
          if not ConsultaVendedoresProdutosContratos.edfCodigo.Exist then
          begin
            dbgProdutosNota.DataSource.DataSet.FieldByName('vendedor').Clear;
            dbgProdutosNota.DataSource.DataSet.FieldByName('nomevendedor').Clear;
          end
          else
            AtribuirDadosUsuarios;

          dbgProdutosNota.SetFocus;
        end;

        if dtmConsultaContratos.qryProdutosContratos.State in [dsedit, dsinsert] then
           dtmConsultaContratos.qryProdutosContratos.Post;
      end;
    end;
  end;
  inherited;
end;

procedure TfrmConsultaContratos.AfterPostProdutosContratos(
  Sender: TObject);
begin
  sbnSalvar.Enabled := dtmConsultaContratos.qryContratosAlteracao.State = dsedit;;
  if pgcDetalhesContrato.activepage = tstAtendimento then
    fraAtendimentosDocumentos1.AbrirTabelaAtendimentosDocumentos(true);
end;

procedure TfrmConsultaContratos.sbnSalvarClick(Sender: TObject);
begin
  inherited;
  dtmConsultaContratos.GravarDados;
end;

procedure TfrmConsultaContratos.Button1Click(Sender: TObject);
begin
  inherited;
  while not dtmConsultaContratos.qryContratos.Eof do
  begin
    application.processmessages;

    TfrmPrincipalBasico(Application.MainForm).MostrarFormRegistrado([dtmConsultaContratos.qryContratosnumero.asstring,
                                                                   ClassName, True], 'TfrmCadastroContratos', True);

    dtmConsultaContratos.qryContratos.Next;                                                               
    application.processmessages;
  end;

end;

procedure TfrmConsultaContratos.fraSelecaoAleatoriaPlanosdePagamentoqrySelecaoAleatoriaAfterOpen(
  DataSet: TDataSet);
var
  nc : integer;  
begin
  inherited;
  with fraSelecaoAleatoriaPlanosdePagamento do
  begin
    qrySelecaoAleatoria.FieldByName('codigo').DisplayLabel := 'CÓDIGO';
    qrySelecaoAleatoria.FieldByName('codigo').ReadOnly := False;

    qrySelecaoAleatoria.FieldByName('descricao').DisplayLabel := 'DESCRIÇÃO DO PLANO';
    qrySelecaoAleatoria.FieldByName('descricao').ReadOnly := true;

    qrySelecaoAleatoria.Append;
    qrySelecaoAleatoria.Post;

    with dbgSelecaoAleatoria do
    for nc:= 0 to 1 do with Columns[nc].Title do
    begin
        Alignment:= taCenter;
        Font.Name:= 'helvetica';
        Font.Height:= -9;
    end;
    qrySelecaoAleatoria.delete;
    
  end;
end;

procedure TfrmConsultaContratos.fraSelecaoAleatoriaPlanosdePagamentodbgSelecaoAleatoriaDblClick(
  Sender: TObject);
begin
  inherited;
  AcionarPesquisaPlanosdePagamento;

end;

procedure TfrmConsultaContratos.fraSelecaoAleatoriaPlanosdePagamentodbgSelecaoAleatoriaKeyDown(
  Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;
  if Shift = [ssCtrl] then
  begin
    case Key of
      VK_F9     : begin
                    fraSelecaoAleatoriaPlanosdePagamento.ConsultaSelecaoAleatoria.CtrlOn := Shift = [ssCtrl];
                    if (Shift = []) or fraSelecaoAleatoriaPlanosdePagamento.ConsultaSelecaoAleatoria.CtrlOn then
                      AcionarPesquisaPlanosdePagamento
                  end;
    end;
  end
  else
  case Key of
    VK_Return: if fraSelecaoAleatoriaPlanosdePagamento.dbgSelecaoAleatoria.SelectedIndex = 0  then
               begin
                 fraSelecaoAleatoriaPlanosdePagamento.ConsultaSelecaoAleatoria.edfCodigo.DoExit;
                 if not fraSelecaoAleatoriaPlanosdePagamento.ConsultaSelecaoAleatoria.qryProcuraPlano.IsEmpty then
                    AtribuirDadosPlanosdePagamento
                 else
                 begin
                   key := 0;
                   fraSelecaoAleatoriaPlanosdePagamento.dbgSelecaoAleatoria.SelectedIndex := 0;
                   fraSelecaoAleatoriaPlanosdePagamento.dbgSelecaoAleatoria.SetFocus;
                 end;
               end;
  end;
  inherited;

end;

procedure TfrmConsultaContratos.AtribuirDadosPlanosdePagamento;
begin
  with fraSelecaoAleatoriaPlanosdePagamento do
  begin
    qrySelecaoAleatoria.Edit;
    qrySelecaoAleatoria.FieldByName('codigo').AsString :=
        ConsultaSelecaoAleatoria.qryProcuraPlanocodigo.AsString;

    qrySelecaoAleatoria.FieldByName('descricao').AsString :=
        ConsultaSelecaoAleatoria.qryProcuraPlanodescricao.AsString;

    qrySelecaoAleatoria.Post;
  end;
end;

procedure TfrmConsultaContratos.AcionarPesquisaPlanosdePagamento;
begin
  with fraSelecaoAleatoriaPlanosdePagamento do
  begin
    dbgSelecaoAleatoria.SetFocus;
    ConsultaSelecaoAleatoria.CtrlOn := True;
    ConsultaSelecaoAleatoria.InternoPesquisar(ctPLANOSPAGAMENTOS);
    dbgSelecaoAleatoria.SetFocus;
    dbgSelecaoAleatoria.SelectedIndex :=  0;
  end;

end;

procedure TfrmConsultaContratos.fraSelecaoAleatoriaPlanosdePagamentosbnProcuraClick(
  Sender: TObject);
begin
  inherited;
  AcionarPesquisaPlanosdePagamento;
end;

