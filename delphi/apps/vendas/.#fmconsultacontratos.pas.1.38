implementation

uses fmnavcontroles, dmbasico;

{$R *.dfm}
constructor TfrmConsultaContratos.Create(AOwner: TComponent);
begin
  dtmConsultaContratos:= TdtmConsultaContratos.Create(Self);
  inherited;
  with dtmConsultaContratos do begin
    edtAberturaInicial.Text     := DateToStr(DataServidor - 60);
    edtAberturaFinal.Text       := DateToStr(DataServidor);
    pgcContratos.ActivePageIndex := 0;
    dbgProdutosNota.Columns[7].Visible := ParSistema.ClientePessoaJuridica;
    dbgProdutosNota.Columns[2].Visible := ParSistema.UsarGradesProdutos;
    dbgProdutosNota.Columns[3].Visible := ParSistema.UsarGradesProdutos;
    dtmConsultaContratos.OnScrollLinhaColunaGrade := AfterScrollLinhaColunaGrade;

    dbgSimilares.Columns[2].Visible := ParSistema.UsarGradesProdutos;
    dbgSimilares.Columns[3].Visible := ParSistema.UsarGradesProdutos;
    if not ParSistema.UsarGradesProdutos then
      dbgsimilares.Columns[1].Width := dbgsimilares.Columns[1].Width+
                                       dbgsimilares.Columns[2].Width+
                                       dbgsimilares.Columns[3].Width;
    dtmConsultaContratos.OnScrollLinhaColunaGradeSimilares := AfterScrollLinhaColunaGradeSimilares;
//    edfFilial.SetFocus;
  end;
  pgcContratos.ActivePageIndex := 0;
  if dbgProdutosNota.Columns[4].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutosNota.Columns[4].Width := ParSistema.TamanhoMascaraQuantidade;
  if dbgProdutosNota.Columns[8].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutosNota.Columns[8].Width := ParSistema.TamanhoMascaraQuantidade;
  if dbgProdutosNota.Columns[9].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutosNota.Columns[9].Width := ParSistema.TamanhoMascaraQuantidade;
  if dbgProdutosNota.Columns[10].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutosNota.Columns[10].Width := ParSistema.TamanhoMascaraQuantidade;

  if dbgSimilares.Columns[4].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgSimilares.Columns[4].Width := ParSistema.TamanhoMascaraQuantidade;
  if dbgSimilares.Columns[5].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgSimilares.Columns[5].Width := ParSistema.TamanhoMascaraQuantidade;
  if dbgSimilares.Columns[7].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgSimilares.Columns[7].Width := ParSistema.TamanhoMascaraQuantidade;

  fraConsultaContrato.TipoPesquisa := pesCONTRATOS;
  fraConsultaVendedorContrato.TipoPesquisa := pesVENDEDORES;

  ConsultaVendedoresProdutosContratos := TfraConsultaCodigo.Create(self);
  ConsultaVendedoresProdutosContratos.Name := 'fraConsultaVendedores';
  ConsultaVendedoresProdutosContratos.edfCodigo.MaxLength := 6;
  ConsultaVendedoresProdutosContratos.edfCodigo.DataSource := dtmConsultaContratos.dsrProdutosContratos;
  ConsultaVendedoresProdutosContratos.edfCodigo.DataField := 'vendedor';
  ConsultaVendedoresProdutosContratos.edfCodigo.Operacao := opATRIBUICAO;
  ConsultaVendedoresProdutosContratos.edfCodigo.LookupSource := ConsultaVendedoresProdutosContratos.dsrProcuraVendedores;
  ConsultaVendedoresProdutosContratos.edfCodigo.LookupQueryParameter := 'Codigo';
  ConsultaVendedoresProdutosContratos.edfCodigo.LookupField := 'Codigo';
  ConsultaVendedoresProdutosContratos.AbrirTabelaProcura := false;
  ConsultaVendedoresProdutosContratos.TipoPesquisa := pesVENDEDORES;
  ConsultaVendedoresProdutosContratos.OnFound := AtribuirDadosUsuarios;

  fraConsultaFilial.TipoPesquisa := pesFILIAIS;

  sbnSalvar.enabled := false;

  dtmConsultaContratos.AfterPostProdutosContratos := AfterPostProdutosContratos;

  fraSelecaoAleatoriaPlanosdePagamento.CampoParaLista := 'codigo';
  fraSelecaoAleatoriaPlanosdePagamento.qrySelecaoAleatoria.Open;
  with fraSelecaoAleatoriaPlanosdePagamento do
  begin
    ConsultaSelecaoAleatoria := TfraConsultaCodigo.Create(self);
    ConsultaSelecaoAleatoria.Name := 'fraConsultaSelecaoAleatoriaPlanosdePagamento';
    ConsultaSelecaoAleatoria.edfCodigo.MaxLength := 3;
    ConsultaSelecaoAleatoria.edfCodigo.DataSource := dsrSelecaoAleatoria;
    ConsultaSelecaoAleatoria.edfCodigo.DataField := 'codigo';
    ConsultaSelecaoAleatoria.edfCodigo.Operacao := opATRIBUICAO;
    ConsultaSelecaoAleatoria.edfCodigo.LookupSource := ConsultaSelecaoAleatoria.dsrProcuraPlano;
    ConsultaSelecaoAleatoria.edfCodigo.LookupQueryParameter := 'Codigo';
    ConsultaSelecaoAleatoria.edfCodigo.LookupField := 'Codigo';
    ConsultaSelecaoAleatoria.AbrirTabelaProcura := false;
    ConsultaSelecaoAleatoria.naofechartabelapesquisa := true;

    ConsultaSelecaoAleatoria.TipoPesquisa := pesPLANO;
    ConsultaSelecaoAleatoria.OnFound := AtribuirDadosPlanosdePagamento;
  end;

  dtmConsultaContratos.qryProcuraVendedorContrato := fraConsultaVendedorContrato.qryProcuraVendedores;

  fraAtendimentosDocumentos1.Documento := dtmConsultaContratos.GetContrato;
  fraAtendimentosDocumentos1.TipoDocumento := dtmConsultaContratos.GetTipoDocumento;

  fraConsultaEquipamento.tipopesquisa := pesEQUIPAMENTO;


  dbgServicos.PesquisaCampo('vendedor', pesVENDEDORES, self);
//  tfraconsultacodigo(self.FindComponent(NomeFrameVendedorServico)).CondicoesdaConsulta := CondicoesFiliaisEntrada;
  tfraconsultacodigo(self.FindComponent(NomeFrameVendedorServico)).onFound := AtribuirDadosUsuariosServicos;


  setarActivePage(self);

end;

function TfrmConsultaContratos.JanelaPesquisa: TfrmConsultaBasica;
begin
  Result := TfrmConsultaPorCampo.Create(nil);
  TfrmConsultaPorCampo(result).ConsultaInterativa := not (TipoPesquisa in [cocPRODUTOS, cocCARACTERISTICAS, cocCLIENTES, cocFORNECEDORES]);
end;

function TfrmConsultaContratos.ExisteInformacao(Parametro: Integer; NomeCampo: String; Value: Variant): Boolean;
begin
  with dtmConsultaContratos do
    case TipoPesquisa of
      cocFILIAIS        : Result := ExisteFilial(NomeCampo, Value);
      cocFORNECEDORES   : Result := ExisteFornecedor(NomeCampo, Value);
      cocCLIENTES       : Result := ExisteCliente(NomeCampo, Value);
      cocVENDEDORES     : Result := ExisteVendedor(NomeCampo, Value);
    else                  Result := False;
    end;
end;

function TfrmConsultaContratos.TabelaDePesquisa: TZDataSet;
begin
  with dtmConsultaContratos do
    case TipoPesquisa of
      cocFORNECEDORES   : Result := ConsultarFornecedor;
      cocFILIAIS        : Result := ConsultarFilial;
      cocCLIENTES       : Result := ConsultarCliente;
      cocVENDEDORES     : Result := ConsultarVendedor;
    else                  Result := nil;
    end;
end;

function TfrmConsultaContratos.InternoPesquisar(Titulo:String): Integer;
begin
  Result:= mrNone;
  if PesquisaHabilitada then
  begin
    with dtmConsultaContratos do begin
      if TipoPesquisa <> cocNENHUM then
      begin
        AbreTabelaConsulta(TipoPesquisa);
        Result := inherited InternoPesquisar(Titulo);
        if Result = mrOK then
          Selecionar(TipoPesquisa);
      FechaTabelaConsulta(TipoPesquisa)
      end;
    end;
  end;
end;

function TfrmConsultaContratos.PesquisaHabilitada: Boolean;
begin
  Result:= False;
  if CtrlOn then begin
    if ActiveControl is TtecDBEditFind then begin
      if edfFilial.Focused then
        TipoPesquisa := cocFILIAIS
      else if edfFornecedor.Focused then
        TipoPesquisa := cocFORNECEDORES
      else if edfCliente.Focused then
        TipoPesquisa := cocCLIENTES
      else
        TipoPesquisa := cocNENHUM;
      Result := True;
    end;
  end;
end;

procedure TfrmConsultaContratos.pgcExclusivosChange(Sender: TObject);
begin
  inherited;
  with dtmConsultaContratos do
  begin
    edfFornecedor.SetFocus;
    AbreTabelaConsulta(cocFORNECEDORES);
    ReFazConsultaTabelas;
  end;
end;

function TfrmConsultaContratos.ValidarCampos: Boolean;
begin
   Result := edtAberturaInicial.Criticar(False)  and
             edtAberturaFinal.Criticar(False)    and
             edtFechamentoInicial.Criticar(False) and
             edtFechamentoFinal.Criticar(False) and
             edtDataCompraProdutoInicial.Criticar(False) and
             edtDataCompraProdutoFinal.Criticar(False);

   if ((edtDataCompraProdutoInicial.text = '') and
       (edtDataCompraProdutoFinal.text <> '')) or
      ((edtDataCompraProdutoInicial.text <> '') and
       (edtDataCompraProdutoFinal.text = '')) then
   begin
     Result := false;
     MensagemAviso('Informe um intervalo completo para as datas de compra!');
     if (edtDataCompraProdutoInicial.text = '') then
       edtDataCompraProdutoInicial.setfocus
     else
       edtDataCompraProdutoFinal.setfocus;
   end;

   if Result then
   begin
     Result := OperadorTernario(Trim(edfFilial.Text) <> '', edfFilial.Exist, True) and
               OperadorTernario(Trim(edfCliente.Text) <> '', edfCliente.Exist, True) and
               OperadorTernario(Trim(edfFornecedor.Text) <> '', edfFornecedor.Exist, True)
   end;
end;

procedure TfrmConsultaContratos.sbnProcuraFilialClick(Sender: TObject);
begin
  InternoPesquisar(edffilial, ctFILIAIS);
end;

procedure TfrmConsultaContratos.sbnClientesClick(Sender: TObject);
begin
  InternoPesquisar(edfCliente, ctCLIENTES);
end;

procedure TfrmConsultaContratos.sbnGerarClick(Sender: TObject);
var
  SQLSituacao, SQLTipoOrdemServico: String;
begin
  inherited;
  if ValidarCampos then
  begin
    with dtmConsultaContratos do
    begin
      Filial             := edfFilial.Text;

      Vendedor           := fraSelecaoAleatoriausuarios.ListaCondicional;
      GruposUsuarios     := fraSelecaoAleatoriagruposusuarios1.ListaCondicional;
      ExcetoPlano        := ckbExceto.Checked;
      Plano              := fraSelecaoAleatoriaPlanosdePagamento.StringSelecionada;
      Cliente            := edfCliente.Text;
      Fornecedor         := edfFornecedor.Text;

      AberturaInicial    := edtAberturaInicial.Text;
      AberturaFinal      := edtAberturaFinal.Text;

      DataCompraProdutoInicial  := edtDataCompraProdutoInicial.Text;
      DataCompraProdutoFinal    := edtDataCompraProdutoFinal.Text;

      AberturaInicial    := edtAberturaInicial.Text;
      AberturaFinal      := edtAberturaFinal.Text;

      FechamentoInicial  := edtFechamentoInicial.Text;
      FechamentoFinal    := edtFechamentoFinal.Text;
      ReservadoInicial   := edtReservadoInicial.Text;
      ReservadoFinal     := edtReservadoFinal.Text;
      Pedidocliente      := edtPedidocliente.Text;
      Contrato           := fraConsultaContrato.edfCodigo.text;
      Xped               := edtXPed.Text;

      codigo_pedido_marketplace := edtPesquisacodigo_pedido_marketplace.text;

      SQLSituacao := '';
      if ckbOrcado.Checked then
        SQLSituacao := SQLSituacao + '''O'',';
      if ckbReservado.Checked then
        SQLSituacao := SQLSituacao + '''R'',';
      if ckbFaturado.Checked then
        SQLSituacao := SQLSituacao + '''F'',';
      if ckbNotaParcial.Checked then
        SQLSituacao := SQLSituacao + '''P'',';
      if ckbNotaFiscal.Checked then
        SQLSituacao := SQLSituacao + '''N'',';
      if ckbCancelado.Checked then
        SQLSituacao := SQLSituacao + '''C'',';
      if SQLSituacao = '' then
        SQLSituacao := SQLSituacao + '''O'',''R'',''F'',''P'','+
                                     '''N'',''C'') ';
      FSituacao         := SQLSituacao;

      SQLTipoOrdemServico := '';
      if ckbTipoOrdemServico.checked then
      begin
        if ckbNovoCliente.checked then
          SQLTipoOrdemServico := SQLTipoOrdemServico + '1,';

        if ckbUsadoCliente.checked then
          SQLTipoOrdemServico := SQLTipoOrdemServico + '2,';

        if ckbAtivoFixo.checked then
          SQLTipoOrdemServico := SQLTipoOrdemServico + '3,';

        if ckbEstoque.checked then
          SQLTipoOrdemServico := SQLTipoOrdemServico + '4,';
      end;

      TipoEqptoOrdemServico := SQLTipoOrdemServico;

      Ordenacao         := rgbOrdenacao.ItemIndex;
      FEmAberto         := ckbemaberto.Checked;
      FQuitado          := ckbquitado.Checked;
      FRenegociado      := ckbrenegociado.Checked;
      FEmAtraso         := ckbematraso.Checked;

      tipoOrdemServico := ckbTipoOrdemServico.Checked;
      OrdemServicoemGarantia := CkbGarantia.checked;
      OrdemServicoemCortesia := CkbCortesia.checked;
      GarantiaAprovada := ckbGarantiaAprovada.checked;
      GarantiaReprovada := ckbGarantiaReprovada.checked;
      GarantiaNaoDefinida := ckbNaoDefinida.checked;
      LogicaGarantia := cmbLogicalGarantia.text;

      tipoContrato := ckbTipoContrato.Checked;


      ListaItemProdutos := fraMultiplaSelecaoAleatoria1.fraSelecaoAleatoriaItemdeProdutos.ListaCondicional;
      ListaProdutos     := fraMultiplaSelecaoAleatoria1.fraSelecaoAleatoriaprodutos.ListaCondicional;
      ListaGrupos       := fraMultiplaSelecaoAleatoria1.fraSelecaoaleatoriagruposprodutos.ListaCondicional;
      ListaClasses      := fraMultiplaSelecaoAleatoria1.fraSelecaoaleatoriaclassesprodutos.ListaCondicional;
      ListaMarcas       := fraMultiplaSelecaoAleatoria1.fraSelecaoAleatoriamarcasProdutos.ListaCondicional;
      ListaCondicionalPromocoes := fraMultiplaSelecaoAleatoria1.fraSelecaoaleatoriapromocoes.ListaCondicional;

      Equipamento       := fraConsultaEquipamento.qryProcuraEquipamento.fieldbyname('codigo').asString;

      ComAtendimento := ckbComAtendimento.checked;
      SemAtendimento := ckbSemAtendimento.checked;
      TodosListaTiposAtendimentosMarcados := fraListatiposatendimentos.TodosMarcados;
      ListaTiposAtendimentos := fraListatiposatendimentos.ListaSelecionada;


      if AbrirConsultaContratos then
      begin
        MensagemAviso(Format(ctNENHUMREGISTROENCONTRADO, [ctCONTRATO]));
        pgcContratos.ActivePageIndex:=0;
        edfFilial.SetFocus;
      end
      else begin
        pgcContratos.ActivePageIndex:=1;
        dbgContratos.SetFocus;
      end;
    end;
  end;
  ckbSelecionarTodos.Checked := False;
end;

procedure TfrmConsultaContratos.sbnFornecedorClick(Sender: TObject);
begin
  inherited;
  InternoPesquisar(edfFornecedor, ctFORNECEDORES);
end;

procedure TfrmConsultaContratos.dbgContratosDrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  inherited;
  TDBGrid(Sender).Canvas.Brush.Color := $007FAA55;
  TDBGrid(Sender).Canvas.Font.Color  := clBlack;
  if (dtmConsultaContratos.ContratoEmAtraso) and
     (dtmConsultaContratos.SituacaoContrato<>'C') and
     (dtmConsultaContratos.SituacaoContrato<>'O') and
     (dtmConsultaContratos.SituacaoContrato<>'R') and not
     (dtmConsultaContratos.ContratoRenegociado) then begin
    TDBGrid(Sender).Canvas.Brush.Color := clWhite;
    TDBGrid(Sender).Canvas.Font.Color  := clRed;
  end
  else if (dtmConsultaContratos.ContratoEmAberto) and
          (dtmConsultaContratos.SituacaoContrato<>'C') and
          (dtmConsultaContratos.SituacaoContrato<>'O') and
          (dtmConsultaContratos.SituacaoContrato<>'R') and not
          (dtmConsultaContratos.ContratoRenegociado) then begin
    TDBGrid(Sender).Canvas.Brush.Color := clWhite;
    TDBGrid(Sender).Canvas.Font.Color  := clBlack;
  end
  else if (dtmConsultaContratos.ContratoRenegociado) and
          (dtmConsultaContratos.SituacaoContrato<>'C') then begin
    TDBGrid(Sender).Canvas.Brush.Color := $7DBEFF;
    TDBGrid(Sender).Canvas.Font.Color  := clBlack;
  end
  else if dtmConsultaContratos.SituacaoContrato = 'O' then begin
    TDBGrid(Sender).Canvas.Brush.Color := clAqua;
    TDBGrid(Sender).Canvas.Font.Color  := clBlack;
  end
  else if dtmConsultaContratos.SituacaoContrato = 'R' then begin
    TDBGrid(Sender).Canvas.Brush.Color := $00FFD9A4;
    TDBGrid(Sender).Canvas.Font.Color  := clBlack;
  end
  else if (dtmConsultaContratos.SituacaoContrato = 'C') or
          (dtmConsultaContratos.ContratoEstornado) then begin
    TDBGrid(Sender).Canvas.Brush.Color := clYellow;
    TDBGrid(Sender).Canvas.Font.Color  := clBlack;
  end;
  if TDBGrid(Sender).DataSource.DataSet.FieldByName('selecionar').AsBoolean then
    TDBGrid(Sender).Canvas.Brush.Color := clInfoBk;
    
  TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
end;

procedure TfrmConsultaContratos.FormKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  inherited;
  case Key of
    VK_Escape: begin
               if pgcContratos.activepage = tstFiltros then
                 begin
                    dtmConsultaContratos.LimpaFiltros;
                    pgcContratos.ActivePageIndex := 0;
                    edfFilial.SetFocus;
                 end;
               end;
    VK_F5 : if sbnSalvar.Enabled then sbnSalvar.Click;
    VK_F6 : sbnGerar.Click;
    VK_F7 : sbnImprimir.Click;
    VK_F8 : sbnContrato.Click;
    VK_F10: begin
          key:=0;
          if sbnAtendimento.Enabled then
            sbnAtendimentoClick(nil);
        end;

  end;
end;

