procedure TfrmConsultaNotaseCupons.sbnGerarClick(Sender: TObject);
begin
  if ValidarCamposSelecao then
    with dtmConsultaNotasFiscais do begin
      if Consultar = 'N' then begin
        Filial         := edfFilialNota.Text;
        Serie          := edtSerie.Text;
        Numero         := edtNumero.Text;
        cfop           := edfCfopPesquisa.Text;
      end
      else begin
        Filial         := edfFilialCupon.Text;
        ECF            := edtECF.Text;
        Intervencao    := edtIntervencao.Text;
        Numero         := edtCupon.Text;
        cfop           := edfCfopPesquisa.Text;
      end;
      EmissaoInicial := edtEmissaoInicial.Text;
      EmissaoFinal   := edtEmissaoFinal.Text;
      Cliente        := edfCliente.Text;

      if GerarConsulta then begin
         MensagemAviso(Format(ctNENHUMREGISTROSELECIONADO,['registro']));
         if Consultar = 'N' then edfFilialNota.SetFocus
                            else edfFilialCupon.SetFocus;
      end
      else begin
        pgcConsultaNotasCupons.ActivePage:= tstRegistrosSelecionados;
        if Consultar = 'N' then begin
          pgcGridNotasCupons.ActivePage:= tstGridNotas;
          dbgNotas.SetFocus;
        end
        else begin
          pgcGridNotasCupons.ActivePage:= tstGridCupons;
          dbgCupons.SetFocus;
         end;
      end;
    end;
end;

procedure TfrmConsultaNotaseCupons.sbnProcurarCFOPClick(Sender: TObject);
begin
  inherited;
  CtrlOn := True;
  flkCFOP.SetFocus;
