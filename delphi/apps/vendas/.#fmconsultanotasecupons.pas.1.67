function TfrmConsultaNotaseCupons.TabelaDePesquisa: TZDataSet;
begin
  with dtmConsultaNotasFiscais do
    case TipoPesquisa of
            cncFILIAL: Result:= ConsultarFiliais;
           cncCLIENTE, cncCLIENTEDADOFISCAL: Result:= ConsultarClientes;
              cncCFOP, cncCFOPSELECAO: Result:= ConsultarCFOP;
     cncFORNECEDORTRANSPORTE: Result:= ConsultarFornecedorTransporte;
    else  Result := nil;
    end;
end;

function TfrmConsultaNotaseCupons.ValidarCamposSelecao: Boolean;
begin
  Result:= ((edtEmissaoInicial.Text <> '') or (edtEmissaoFinal.Text <> ''));
  if Result then
    if dtmConsultaNotasFiscais.Consultar = 'N' then
      Result:= OperadorTernario((Trim(edfFilialNota.Text)  <> '') ,edfFilialNota.Exist , True) {and
               OperadorTernario((Trim(edfCliente.Text)     <> '') ,edfCliente.Exist    , True)}
    else
      Result:= OperadorTernario((Trim(edfFilialCupon.Text) <> '') ,edfFilialCupon.Exist, True) {and
               OperadorTernario((Trim(edfCliente.Text)     <> '') ,edfCliente.Exist    , True)};
end;

procedure TfrmConsultaNotaseCupons.ImprimirNotaOriginal(Imp: String);
begin

  if ( (not dtmConsultaNotasFiscais.CondicaoEmissorNFE) or
       ((dtmConsultaNotasFiscais.qryServicosDadosFiscais.RecordCount<>0) and
        (ftipoemissaonfeservico in [Matricial, Matricial_Conjugada, Outras, Inexistente])) ) then
  begin
        dtmConsultaNotasFiscais.ImprimirNota(Imp);
  end
  else
  begin

    {Imprimir as que já foram geradas}
    if ((dtmConsultaNotasFiscais.qryNotasnumprotocolonfe.AsString <> '') and
        (dtmConsultaNotasFiscais.qryNotasnumcancelamentonfe.AsString = '') and
        (dtmConsultaNotasFiscais.qryNotasnuminutilizacaonfe.AsString = '')) or
        
    {Imprimir as NFPSe que já foram geradas}    
    
       ((dtmConsultaNotasFiscais.qryNotasnumprotocolonfse.AsString <> '') and
        (ftipoemissaonfeservico in [Eletronica_Betha_Sistemas, Florianopolis_SoftPlan, Palhoca_IPM])) then
       dtmConsultaNotasFiscais.ImprimirNFe(Imp)
    else
    {gerar nfe vinculadas com cupom}
    if ((dtmConsultaNotasFiscais.qryNotasnumprotocolonfe.AsString = '') and
       (dtmConsultaNotasFiscais.qryNotasnumcancelamentonfe.AsString = '') and
       (dtmConsultaNotasFiscais.qryNotasnuminutilizacaonfe.AsString = '') and
       (dtmConsultaNotasFiscais.qryCuponsnumero.AsInteger <> 0) and
       ((dtmConsultaNotasFiscais.qryDadosFiscaiscodigofiscal.AsInteger mod 1000) <> 929)) then
      dtmConsultaNotasFiscais.GerarNFe(Imp)
    else
      {capturar no sefaz o xml da nota e imprimir se não estiver no compartilha}
    if ((dtmConsultaNotasFiscais.qryNotasnumprotocolonfe.AsString = '') and
        (dtmConsultaNotasFiscais.qryNotasnumcancelamentonfe.AsString = '') and
        (dtmConsultaNotasFiscais.qryNotasnuminutilizacaonfe.AsString = '') and
        
        ((dtmConsultaNotasFiscais.qryDadosFiscaismodelodocto.AsString = '55') or
         (dtmConsultaNotasFiscais.qryDadosFiscaismodelodocto.AsString = '65') or
         (dtmConsultaNotasFiscais.qryDadosFiscaismodelodocto.AsString = '57')) ) or
       
       {capturar odigoVerificacao se ftipoemissaonfeservico = Florianopolis_SoftPlan}

      ((dtmConsultaNotasFiscais.qryNotasnumprotocolonfse.AsString = '') and
       (dtmConsultaNotasFiscais.qryServicosDadosFiscais.recordcount <> 0) and
       (ftipoemissaonfeservico in [Eletronica_Betha_Sistemas, Florianopolis_SoftPlan, Palhoca_IPM])) then
     dtmConsultaNotasFiscais.ImprimirNFe(Imp)

  end;

end;

procedure TfrmConsultaNotaseCupons.ImprimirNota;
var
  Imp: String;
  vCont: integer;
begin
  Imp := 'selecionar';
  vCont:=0;
  frmSelecionarImpressoras := TfrmSelecionarImpressoras.Create(frmSelecionarImpressoras, ' ');
  if frmSelecionarImpressoras.ShowModal = mrok then
  begin
        Imp:= frmSelecionarImpressoras.NomeImpressora;
        if dtmConsultaNotasFiscais.qryTotais_registrosmarcados.asinteger = 0 then
        begin
           ImprimirNotaOriginal(Imp);
        end
        else
        begin
          if dtmConsultaNotasFiscais.Consultar = 'C' then
          begin
            dtmConsultaNotasFiscais.qryCupons.GuardarRegistroAtual(true);
            dtmConsultaNotasFiscais.qryCupons.first;
            while not dtmConsultaNotasFiscais.qryCupons.eof do
            begin
              if dtmConsultaNotasFiscais.qryCuponsmarcar.asBoolean then
              begin
                ImprimirNotaOriginal(Imp);
                inc(vCont);
              end;
              dtmConsultaNotasFiscais.qryCupons.next;
              if vCont = dtmConsultaNotasFiscais.qryTotais_registrosmarcados.asinteger then
                break;
            end;
            dtmConsultaNotasFiscais.qryCupons.VoltarRegistro;
          end
          else
          begin
            dtmConsultaNotasFiscais.qrynotas.GuardarRegistroAtual(true);
            dtmConsultaNotasFiscais.qrynotas.first;
            while not dtmConsultaNotasFiscais.qryNotas.eof do
            begin
                  if dtmConsultaNotasFiscais.qryNotasmarcar.asBoolean then
                  begin
                          ImprimirNotaOriginal(Imp);
                          inc(vCont);
                  end;
                  dtmConsultaNotasFiscais.qrynotas.next;
                  if vCont = dtmConsultaNotasFiscais.qryTotais_registrosmarcados.asinteger then
                          break;
            end;
            dtmConsultaNotasFiscais.qrynotas.VoltarRegistro;
          end;
        end;
  end;
  frmSelecionarImpressoras.Free;
end;

