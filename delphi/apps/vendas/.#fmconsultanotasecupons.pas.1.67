  FIndex: Byte;

implementation

Uses
  //Biblio
  clparametrossistema, fmprincipalbasico, frselecaoaleatoria;

{$R *.dfm}


constructor TfrmConsultaNotaseCupons.Create(AOwner: TComponent);
begin
try
  dtmConsultaNotasFiscais:= TdtmConsultaNotasFiscais.Create(self);
  inherited;

  pgcConsultaNotasCupons.ActivePage := tstParametros;

  with dtmConsultaNotasFiscais do begin
    DataSet:= TabelaDadosFiscais;
    dtmConsultaNotasFiscais.Consultar:= 'N';
    edtEmissaoInicial.Text:= DateToStr(DataServidor);
    edtEmissaoFinal.Text  := DateToStr(DataServidor);
  end;
  pgcConsultaNotasCupons.ActivePageIndex:= 0;
  pgcSelecionarNotasCupons.ActivePageIndex:= 0;
  pgcNotasCuponsDestinatario.ActivePageIndex:= 0;
  pgcGridNotasCupons.ActivePageIndex:= 0;
  pgcNotasCuponsProdutos.ActivePageIndex:= 0;

  case ParSistema.PrecoUnitarioCasasDecimais of
    2: dbgProdutos.columnByName('precovenda').Width:=  65;
    3: dbgProdutos.columnByName('precovenda').Width:=  75;
    4: dbgProdutos.columnByName('precovenda').Width:=  85;
    5: dbgProdutos.columnByName('precovenda').Width:=  95;
    6: dbgProdutos.columnByName('precovenda').Width:= 105;
    7: dbgProdutos.columnByName('precovenda').Width:= 110;
    8: dbgProdutos.columnByName('precovenda').Width:= 115;
  end;
  dtmConsultaNotasFiscais.AcertarCasasDecimais;


  if ParSistema.PermitirProdutoAlfanumerico then
    dbgProdutos.Columns[1].Width:= 217
  else
    dbgProdutos.Columns[1].Width:= 135;

  if ParSistema.ClientePessoaJuridica then
       gbxInscEstadual.Caption:= 'INSCRIÇÃO ESTADUAL'
  else gbxInscEstadual.Caption:= 'DOC. IDENTIDADE';
  FIndex:= 1;
  dbgprodutos.ColumnbyName('valorgrade1').Visible := ParSistema.UsarGradesProdutos;
  dbgprodutos.ColumnbyName('valorgrade2').Visible := ParSistema.UsarGradesProdutos;
  dtmConsultaNotasFiscais.OnScrollLinhaColunaGrade := AfterScrollLinhaColunaGrade;
  if dbgProdutos.ColumnbyName('quantidade').Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutos.ColumnbyName('quantidade').Width := ParSistema.TamanhoMascaraQuantidade;
  dtmConsultaNotasFiscais.OnScrollTipoPessoa := AfterScrollTipoPessoa;
  fraConsultaEstado.TipoPesquisa := pesESTADOS;

  if ParSistema.ControlesVoltadosparaIndustria then
    pgcVolumes.ActivePage:= tstVolumesDiversos
  else
    pgcVolumes.ActivePage:= tstVolumeUnico;
  tstNFe.TabVisible := dtmConsultaNotasFiscais.CondicaoEmissorNFE;


  pgcConsultaNotasCupons.ActivePage := tstParametros;

  edtEmissaoInicial.SetFocus;

  pnlgbxChaveNFECalculada.Visible := UsuarioLogin.Suporte;


  with fraCartaCorrecaoEletronica1 do
  begin
    chave_nfe  := dtmConsultaNotasFiscais.Getchave_nfe;
    tiponota   := 'S';
    codigonota := dtmConsultaNotasFiscais.GetCodigoNota;
    email      := dtmConsultaNotasFiscais.GetEmail;
    filial     := dtmConsultaNotasFiscais.GetFilialNota;
    NumeroNota := dtmConsultaNotasFiscais.GetNumeroNota;
    DataNota   := dtmConsultaNotasFiscais.getDataNota;
    EmailNotaVinculada :=  dtmConsultaNotasFiscais.GetEmailNotaVinculada;
    SerieNota := dtmConsultaNotasFiscais.GetSerieNota;
    CondicaoCartaDevolucao := dtmConsultaNotasFiscais.GetCondicaoCartaCorrecao;
  end;

  fraConsultaVendedorDadoFiscal.TipoPesquisa := pesVENDEDORES;

  dtmConsultaNotasFiscais.qryProcuraVendedorContrato := fraConsultaVendedorDadoFiscal.qryProcuraVendedores;


  lblRegistrosSelecionados.alignment := taRightJustify;
  lblTotaisRegistrosSelecionados.alignment := taRightJustify;
  lblRegistrosMarcados.alignment := taRightJustify;
  lblTotaisRegistrosMarcados.alignment := taRightJustify;

except
  on E: Exception do ShowMessage(E.Message);
end;

end;

procedure TfrmConsultaNotaseCupons.dbgProdutosTitleClick(Column: TColumn);
begin
  inherited;
  if AltOn then
  begin
    Inc(FIndex);
    if FIndex < 1 then FIndex:= 3;
    if FIndex > 3 then FIndex:= 1;
    case FIndex of
      1: begin
           dbgProdutos.Columns[02].Title.Caption := 'Descrição ...';
           dbgProdutos.Columns[02].FieldName := 'produtodescricao';
         end;
      2: begin
           dbgProdutos.Columns[02].Title.Caption := 'Marca ...';
           dbgProdutos.Columns[02].FieldName := 'marcadescricao';
         end;
      3: begin
           dbgProdutos.Columns[02].Title.Caption := 'Referência ...';
           dbgProdutos.Columns[02].FieldName := 'referencia';
         end;
    end;
  end;
end;

destructor TfrmConsultaNotaseCupons.Destroy;
begin
  dtmConsultaNotasFiscais:=nil;
  inherited;
  frmConsultaNotaseCupons := nil;
end;

procedure TfrmConsultaNotaseCupons.edtEmissaoFinalEnter(Sender: TObject);
begin
  inherited;
  with dtmConsultaNotasFiscais do
    if edtEmissaoInicial.Criticar(false) and (edtEmissaoInicial.Text<>'') then
      edtEmissaoFinal.Minimo:= DaysBetween(DataServidor,StrToDate(edtEmissaoInicial.Text));
end;

function TfrmConsultaNotaseCupons.ExisteInformacao(Parametro: Integer; NomeCampo: String; Value: Variant): Boolean;
begin
  with dtmConsultaNotasFiscais do
    case TipoPesquisa of
         cncFILIAL: Result:= ExisteFilial(NomeCampo, Value);
        cncCLIENTE, cncCLIENTEDADOFISCAL: Result:= ExisteCliente(NomeCampo, Value);
           cncCFOP, cncCFOPSELECAO: Result:= ExisteCFOP(NomeCampo, Value);
  cncFORNECEDORTRANSPORTE: Result:= ExisteFornecedorTransporte(NomeCampo, Value);
    else Result := False;
    end;
end;

function TfrmConsultaNotaseCupons.InternoGravar: Boolean;
begin
  Result:= dtmConsultaNotasFiscais.GravarAlteracoesNota;
end;

function TfrmConsultaNotaseCupons.InternoIncluir: Boolean;
begin
  Result:= dtmConsultaNotasFiscais.AlterarNota;
  flkCliente.SetFocus;
{  if Result then begin
    pgcNotasCuponsDestinatario.ActivePage:= tstDadosFiscais;
//    pgcNotasCuponsProdutos.ActivePage:= tstImpostos;
    flkCFOP.SetFocus;
  end;
  }
end;

function TfrmConsultaNotaseCupons.InternoPesquisar(Titulo: string): Integer;
begin
  Result := mrNone;
  if ActiveControl is TtecFindCustom then begin
    if CtrlOn then begin
      if (ActiveControl = edfFilialNota) or
         (ActiveControl = edfFilialCupon) then begin
        TipoPesquisa := cncFILIAL;
        Titulo       := 'Filiais';
      end
      {
      else if ActiveControl = edfCliente then begin
        TipoPesquisa := cncCLIENTE;
        Titulo       := 'Clientes';
      end
      }
      else if ActiveControl = flkCliente then
        TipoPesquisa := cncCLIENTEDADOFISCAL
      else if (ActiveControl = flkCFOP) and sbnProcurarCFOP.Enabled then begin
        TipoPesquisa := cncCFOP;
        Titulo       := 'CFOP';
      end
      else if (ActiveControl = flkFornecedorTranporte) and sbnProcurarFornecedorTranporte.Enabled then begin
        TipoPesquisa := cncFORNECEDORTRANSPORTE;
        Titulo       := 'Fornecedores (Transporte)';
      end
      else if (ActiveControl = edfCfopPesquisa) then
        TipoPesquisa := cncCFOPSELECAO
      else
        TipoPesquisa:= cncNENHUM;

      if TipoPesquisa <> cncNENHUM then
        with dtmConsultaNotasFiscais do begin
          AbreTabelaPesquisa(TipoPesquisa);
          Result:= inherited InternoPesquisar(Titulo);
          if Result = mrOK then
            Selecionar(TipoPesquisa);

//          if TipoPesquisa = cncCLIENTEDADOFISCAL then
//            flkCliente.Exist;
          FechaTabelaPesquisa(TipoPesquisa);
        end;
    end;
  end;
end;

function TfrmConsultaNotaseCupons.JanelaPesquisa: TfrmConsultaBasica;
begin
  Result := TfrmConsultaPorCampo.Create(nil);
  if TipoPesquisa in [cncCLIENTE, cncCLIENTEDADOFISCAL] then begin
    TfrmConsultaPorCampo(Result).ConsultaInterativa := False;
    TfrmConsultaPorCampo(Result).UsarParametrosDaTabela:= False;
  end
  else TfrmConsultaPorCampo(Result).ConsultaInterativa := True;
end;

procedure TfrmConsultaNotaseCupons.KeyDown(var Key: Word; Shift: TShiftState);
begin
  case Key of
     VK_F3 : if not CtrlOn and sbnIncluir.Enabled then sbnIncluir.Click;
     VK_F6 : if sbnGerar.Enabled then sbnGerar.Click;
     VK_F7 : if sbnImprmirNota.Enabled then
                sbnImprmirNotaClick(nil);
     VK_F8 : if sbnEspelhoNota.Enabled then
                sbnEspelhoNotaClick(nil);
     VK_F11 : if sbnFichaFinanceira.Enabled then
                sbnFichaFinanceiraClick(nil);
     VK_F12 : if sbnEnviarNfe.Enabled then sbnEnviarNfe.Click;

     else       inherited;
  end;
end;

