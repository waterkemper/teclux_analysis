begin
  inherited;
  if dtmConsultaNotasFiscais.qryDadosFiscaiscontrato.asstring <> '' then
  begin
    if dtmConsultaNotasFiscais.qryDadosFiscaisos.asBoolean then
      TfrmPrincipalBasico(Application.MainForm).MostrarFormRegistrado([dtmConsultaNotasFiscais.qryDadosFiscaiscontrato.asstring], 'TfrmOrdemServico', True)
    else
      TfrmPrincipalBasico(Application.MainForm).MostrarFormRegistrado([dtmConsultaNotasFiscais.qryDadosFiscaiscontrato.asstring], 'TfrmCadastroContratos', True)
  end;
end;

procedure TfrmConsultaNotaseCupons.sbnSaveXMLePDFClick(Sender: TObject);
var
  Dir: String;
  vCont: integer;
begin
  inherited;

  vCont := 0;
  if FolderDialog1.Execute then
  begin
    dir := FolderDialog1.Directory;

    with dtmConsultaNotasFiscais do
    begin
      if qryTotais_registrosmarcados.asinteger = 0 then
        SalvarConteudoxmlepdf('S', qryDadosFiscaisnumero.asstring, false, false, dir)
      else
      begin
        if Consultar = 'N' then
        begin
          qrynotas.GuardarRegistroAtual(false);
          qrynotas.first;
          while not qryNotas.eof do
          begin
            if qryNotasmarcar.asBoolean then
            begin
              if not qryDadosFiscaisnumprotocolonfe.isnull or not qryDadosFiscaisnumprotocolonfse.isnull then
                SalvarConteudoxmlepdf('S', qryDadosFiscaisnumero.asstring, false, false, dir);
              inc(vCont);
            end;

            if vCont = qryTotais_registrosmarcados.asinteger then
              break;

            qrynotas.next;


          end;
          qrynotas.VoltarRegistro;
        end
        else
        begin
          qrycupons.GuardarRegistroAtual(false);
          qrycupons.first;
          while not qrycupons.eof do
          begin
            if qryCuponsmarcar.asBoolean then
            begin
              if not qryDadosFiscaisnumprotocolonfe.isnull or not qryDadosFiscaisnumprotocolonfse.isnull then
                 SalvarConteudoxmlepdf('S', qryDadosFiscaisnumero.asstring, false, false, dir);
              inc(vCont);
            end;

            if vCont = qryTotais_registrosmarcados.asinteger then
              break;

            qrycupons.next;
          end;
          qrycupons.VoltarRegistro;
        end;
      end;
    end;
  end;

  OpenDialog1.initialdir := dir;
  OpenDialog1.Execute;



end;

procedure TfrmConsultaNotaseCupons.sbnCadastroNotaClick(Sender: TObject);
begin
  inherited;
  TfrmPrincipalBasico(Application.MainForm).MostrarFormRegistrado(['Abrir',

                                                                   dtmConsultaNotasFiscais.qryNotasdadofiscal.asinteger,
                                                                   dtmConsultaNotasFiscais.qryNotasFilial.asinteger,
                                                                   dtmConsultaNotasFiscais.qryNotasserie.asString,
                                                                   dtmConsultaNotasFiscais.qryNotasNumero.asinteger


                                                                   ], 'TfrmEmissaoNotasSaidaAvulsas', True)

end;

procedure TfrmConsultaNotaseCupons.OperacaoPadrao(Value: array of Variant);
begin
  inherited;

  if Value[0] = 'Reabrir' then
  begin

    if Value[1]<>0 then
    begin

      if pgcGridNotasCupons.TabIndex = 0 then
      begin
        if dtmConsultaNotasFiscais.qryNotas.recordcount <> 0 then
        begin
          try
            dtmConsultaNotasFiscais.qrynotas.GuardarRegistroAtual(true);
            if dtmConsultaNotasFiscais.qryNotas.locate('dadofiscal', Value[1], []) then
              if sbnGerar.enabled then
                sbnGerarClick(nil);

          finally
            dtmConsultaNotasFiscais.qryNotas.VoltarRegistro;
          end;
        end;
      end
      else
      begin
        if dtmConsultaNotasFiscais.qryCupons.recordcount <> 0 then
        begin
          try
            dtmConsultaNotasFiscais.qryCupons.GuardarRegistroAtual(true);
            if dtmConsultaNotasFiscais.qryCupons.locate('dadofiscal', Value[1], []) then
              if sbnGerar.enabled then
                sbnGerarClick(nil);

          finally
            dtmConsultaNotasFiscais.qryCupons.VoltarRegistro;
          end;
        end;
      end;
    end;
  end
  else
    if sbnGerar.enabled then
      sbnGerarClick(nil);


end;

procedure TfrmConsultaNotaseCupons.sbnImprmirNFe_Vinculada_a_NFCeClick(
  Sender: TObject);
var
  Imp: String;
begin
  inherited;
  Imp := 'selecionar';
  frmSelecionarImpressoras := TfrmSelecionarImpressoras.Create(frmSelecionarImpressoras, ' ');
  if frmSelecionarImpressoras.ShowModal = mrok then
  begin
    Imp:= frmSelecionarImpressoras.NomeImpressora;
    dtmConsultaNotasFiscais.GerarNFe(Imp)
  end;
  frmSelecionarImpressoras.Free;
end;

end.


