procedure TfrmConsultaNotaseCupons.Timer1Timer(Sender: TObject);
begin
  inherited;

  with dtmConsultaNotasFiscais do
  begin
    {
    case TipoCliente[1] of
      'F': gbxCliente.Caption:= 'CLIENTE FORNECEDOR';
      'C': gbxCliente.Caption:= 'CLIENTE';
      'L': gbxCliente.Caption:= 'CLIENTE FILIAL';
    end;
    }


    sbnImprmirNota.Enabled := ( ( ( (not dtmConsultaNotasFiscais.CondicaoEmissorNFE) or
                                    ((qryServicosDadosFiscais.RecordCount<>0) and
                                      (ftipoemissaonfeservico in [Matricial, Matricial_Conjugada, Outras, Inexistente]))) and
                                     sbnIncluir.Enabled) or


                              {Imprimir as que já foram geradas}
                              (dtmConsultaNotasFiscais.CondicaoEmissorNFE and
                               (qryNotasnumprotocolonfe.AsString <> '') and
                               (qryNotasnumcancelamentonfe.AsString = '') and
                               (qryNotasnuminutilizacaonfe.AsString = '') ) or

                              {Imprimir as NFPSe que já foram geradas}

                              ((qryNotasnumprotocolonfse.AsString <> '') and
                               (ftipoemissaonfeservico in [Eletronica_Betha_Sistemas, Florianopolis_SoftPlan, Palhoca_IPM])) or

                              {capturar no sefaz o xml da nota e imprimir se não estiver no compartilha}

                              (dtmConsultaNotasFiscais.CondicaoEmissorNFE and
                               (qryNotasnumprotocolonfe.AsString = '') and
                               (qryNotasnumcancelamentonfe.AsString = '') and
                               (qryNotasnuminutilizacaonfe.AsString = '') and
                               ((qryDadosFiscaismodelodocto.AsString = '55') or
                                (qryDadosFiscaismodelodocto.AsString = '65') or
                                (qryDadosFiscaismodelodocto.AsString = '57'))) or

                             {capturar odigoVerificacao se ftipoemissaonfeservico = Florianopolis_SoftPlan}

                             ((qryNotasnumprotocolonfse.AsString = '') and
                              (qryServicosDadosFiscais.recordcount <> 0) and
                              (ftipoemissaonfeservico in [Eletronica_Betha_Sistemas, Florianopolis_SoftPlan, Palhoca_IPM])) or


                              {gerar nfe vinculadas com cupom}
                              (dtmConsultaNotasFiscais.CondicaoEmissorNFE and
                               (qryNotasnumprotocolonfe.AsString = '') and
                               (qryNotasnumcancelamentonfe.AsString = '') and
                               (qryNotasnuminutilizacaonfe.AsString = '') and
                               (qryCuponsnumero.AsInteger <> 0) and
                               (qryDadosFiscaiscodigofiscal.AsInteger<>5929))) and

                               (qryDadosFiscaissituacao.AsString = 'N');



    sbnImprmirNFe_Vinculada_a_NFCe.Enabled :=


                              dtmConsultaNotasFiscais.CondicaoEmissorNFE and
                              dtmConsultaNotasFiscais.CondicaoEmissorNFCe and
                             (dtmConsultaNotasFiscais.qryDadosFiscaismodelodocto.AsString = '65') and
                             (dtmConsultaNotasFiscais.qryDadosFiscaissituacao.AsString = 'N') and
                             (dtmConsultaNotasFiscais.qryNotasnumprotocolonfe.AsString <> '') and
                             (dtmConsultaNotasFiscais.qryNotasnumcancelamentonfe.AsString = '') and
                             (dtmConsultaNotasFiscais.qryNotasnuminutilizacaonfe.AsString = '') and
                             (dtmConsultaNotasFiscais.qryNotasnumerovinculada.asinteger = 0) and {não gerou vinculado ainda...após gerar segue a impressão normal}
                             ((dtmConsultaNotasFiscais.qryDadosFiscaiscodigofiscal.AsInteger mod 1000) <> 929);




  end;

  sbnEspelhoNota.Enabled := sbnImprmirNota.Enabled;
  sbnEnviarNfe.Enabled := sbnImprmirNota.Enabled;

  sbnGerar.Enabled       := pgcConsultaNotasCupons.ActivePage = tstParametros;
  sbnIncluir.Enabled     := (pgcConsultaNotasCupons.ActivePage = tstRegistrosSelecionados) and
                            {(dtmConsultaNotasFiscais.Consultar = 'N') and}
                            (not dtmConsultaNotasFiscais.TabelaDadosFiscais.IsEmpty) and
                            (not sbnSalvar.Enabled);
//  sbnImprmirNota.Enabled := sbnIncluir.Enabled {and (dtmConsultaNotasFiscais.DataNota = dtmConsultaNotasFiscais.DataServidor)};
  sbnProcurarCFOP.Enabled                := sbnSalvar.Enabled;
  sbnProcurarClientes.Enabled            := sbnSalvar.Enabled;
  sbnProcurarFornecedorTranporte.Enabled := sbnSalvar.Enabled;
  dbgProdutos.ReadOnly                   := not sbnSalvar.Enabled;
  sbnFichaFinanceira.Enabled := (pgcConsultaNotasCupons.ActivePage = tstRegistrosSelecionados) and (dtmConsultaNotasFiscais.qryDadosFiscais.RecordCount <> 0);
  sbnNotaPromissoria.Enabled := (pgcConsultaNotasCupons.ActivePage = tstRegistrosSelecionados) and (dtmConsultaNotasFiscais.qryDadosFiscais.RecordCount <> 0);

  gbxTiposdeNota.visible := pgcSelecionarNotasCupons.activepage = tstNotas;

  gbxVendedorContrato.enabled := {dtmConsultaNotasFiscais.qryDadosFiscaisCliente.isnull and}
                                 dtmConsultaNotasFiscais.qryDadosFiscaisContrato.isnull and
                                 (not dtmConsultaNotasFiscais.qryCuponsNumero.isnull or
                                  (dtmConsultaNotasFiscais.qryDadosFiscaismodelodocto.asString = '65')); //NFCe

  fraConsultaVendedorDadofiscal.enabled := gbxVendedorContrato.enabled;


  sbnConferir.enabled :=  not sbnSalvar.Enabled and (dtmConsultaNotasFiscais.qryProdutosDadosFiscais.recordcount <> 0);

  sbnVisualizarAssinatura.enabled := not dtmConsultaNotasFiscais.qryDadosFiscaisdata_hora_recebimento.isnull;

  sbnContrato.enabled := (dtmConsultaNotasFiscais.qryDadosFiscaiscontrato.asstring <> '');

  sbnSaveXMLePDF.Enabled := (dtmConsultaNotasFiscais.qryTotais_registrosmarcados.asinteger <> 0) or
                            sbnImprmirNota.Enabled;

  sbnCadastroNota.enabled := (dtmConsultaNotasFiscais.qrynotas.recordcount <> 0);


  with fraMultiplaSelecaoAleatoria1 do
    tstMultiplosProdutos.Highlighted :=
       tstItemdeProduto.Highlighted or
       tstProduto.Highlighted or
       tstSelecaoAleatoriaGrupoProduto.Highlighted or
       tstSelecaoAleatoriaClasseProduto.Highlighted or
       tstSelecaoAleatoriaMarcaProduto.Highlighted or
       tstSelecaoAleatoriamodelosProduto.Highlighted or
       tstSelecaoAleatoriaPromocoes.Highlighted or
       tstCST.Highlighted or
       tstCSOSN.Highlighted or
       tstListaPadronizada.Highlighted;

    tstVendedores.Highlighted :=
      fraSelecaoAleatoriavendedores1.fraSelecaoAleatoriavendedores.qrySelecaoAleatoria.RecordCount<>0;

    tstContratos.Highlighted :=
      fraSelecaoAleatoriacontratos1.fraSelecaoAleatoriaContrato.qrySelecaoAleatoria.RecordCount<>0;

end;

procedure TfrmConsultaNotaseCupons.sbnEnviarNfeClick(
  Sender: TObject);
begin
  inherited;
  frmEnviarEmail := TfrmEnviarEmail.Create(frmEnviarEmail,UsuarioLogin.HostSmtp,
     dtmConsultaNotasFiscais.ListadeEmails('DF',dtmConsultaNotasFiscais.qryDadosFiscaisnumero.asinteger),
                      {dtmConsultaNotasFiscais.qryDadosFiscaisEmail.asString,}
                     dtmConsultaNotasFiscais.qryDadosFiscaisnome.asString,
                     'NFe em formato pdf', 'NFe em formato pdf', EnvioNFeEmail);
  try
    with frmEnviarEmail do
    begin
      Data        := dtmConsultaNotasFiscais.DataServidor;
      Empresa     := PrimeiraLetraEmMaiuscula(dtmConsultaNotasFiscais.NomeFilialBase);
      ShowModal;
      if frmEnviarEmail.modalresult = mrOk then
        dtmconsultanotasfiscais.EnviarEmailNfe(frmEnviarEmail.vListaEmailValidos);

    end;
  finally
    frmEnviarEmail.Free;
  end;

end;

