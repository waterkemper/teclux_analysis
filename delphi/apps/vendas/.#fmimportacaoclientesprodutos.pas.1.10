function TfrmImportacaoClientesProdutos.GetArqIni: TIniFile;
begin
  if not assigned(fArqIni) then
    farqINI := TIniFile.Create(NomeArquivoCFG);
  Result := fArqIni;
end;

destructor TfrmImportacaoClientesProdutos.destroy;
begin
  if assigned(fArqIni) then
    fArqIni.free;

  inherited;
end;

procedure TfrmImportacaoClientesProdutos.ZMonitor1MonitorEvent(Sql,
  Result: String);
var
 Listar : TStringList;
 FileName: String;
begin
  inherited;
  Listar := tStringlist.create;
  FileName := 'c:\teclux\importacao.sql';

  if fileexists(FileName) then
    Listar.loadfromfile(FileName);
  Listar.add('');
  Listar.add(sql);
  Listar.add(result);
  listar.savetofile(FileName);
  listar.free;
end;
end.
