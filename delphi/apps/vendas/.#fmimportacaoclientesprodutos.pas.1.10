  Sender: TObject);
begin
  inherited;
  OpenDialog1.Title := 'Arquivo para Importação';
  OpenDialog1.DefaultExt := '*.txt';
  OpenDialog1.Filter := 'Arquivos TXT|*.txt|' +
                        'Arquivos SQL|*.sql|' +
                        'Todos os Arquivos|*.*';
  
  OpenDialog1.InitialDir := ExtractFileDir(application.ExeName);
  if OpenDialog1.Execute then
  begin
    lblArquivoProdutos.Caption := OpenDialog1.FileName;
    arqINI.WriteString('Importacao', 'Produtos', OpenDialog1.FileName);
    arqINI.UpdateFile;
  end;
end;

