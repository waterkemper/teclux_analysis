var
  frmListaCasamento: TfrmListaCasamento;
  TipoPesquisa: TtecListaCasamento;

implementation

uses dmlistacasamento, fmprodutoslistacasamento, dmbasico,
     fmreservarprodutoslistacasamento, fmselecionarprodutoslistapadrao,
     fmconfirmarimpressalistacasamento;

{$R *.dfm}


constructor TfrmListaCasamento.Create(AOwner: TComponent);
begin
  dtmListaCasamento := TdtmListaCasamento.Create(Self);
  inherited;
  DataSet:= dtmListaCasamento.TabelaListasCasamento;

  dbgprodutos.Columns[2].Visible := ParSistema.UsarGradesProdutos;
  dbgprodutos.Columns[3].Visible := ParSistema.UsarGradesProdutos;
  dtmListaCasamento.OnScrollLinhaColunaGrade := AfterScrollLinhaColunaGrade;

  dbgSaldosProdutosSimplesRemessa.Columns[3].Visible := ParSistema.UsarGradesProdutos;
  dbgSaldosProdutosSimplesRemessa.Columns[4].Visible := ParSistema.UsarGradesProdutos;
  dtmListaCasamento.OnScrollLinhaColunaGradeNotas := AfterScrollLinhaColunaGradeNotas;

  dbgProdutosEtiquetas.Columns[4].Visible := ParSistema.UsarGradesProdutos;
  dbgProdutosEtiquetas.Columns[5].Visible := ParSistema.UsarGradesProdutos;
  dtmListaCasamento.OnScrollLinhaColunaGradeEtiquetas := AfterScrollLinhaColunaGradeEtiquetas;

  if dbgProdutos.Columns[4].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutos.Columns[4].Width := ParSistema.TamanhoMascaraQuantidade;

  if dbgProdutos.Columns[5].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutos.Columns[5].Width := ParSistema.TamanhoMascaraQuantidade;

  if dbgProdutos.Columns[6].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutos.Columns[6].Width := ParSistema.TamanhoMascaraQuantidade;

  if dbgSaldosProdutosSimplesRemessa.Columns[5].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgSaldosProdutosSimplesRemessa.Columns[5].Width := ParSistema.TamanhoMascaraQuantidade;

  if dbgSaldosProdutosSimplesRemessa.Columns[6].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgSaldosProdutosSimplesRemessa.Columns[6].Width := ParSistema.TamanhoMascaraQuantidade;

  if dbgSaldosProdutosSimplesRemessa.Columns[7].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgSaldosProdutosSimplesRemessa.Columns[7].Width := ParSistema.TamanhoMascaraQuantidade;

  if dbgSaldosProdutosSimplesRemessa.Columns[8].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgSaldosProdutosSimplesRemessa.Columns[8].Width := ParSistema.TamanhoMascaraQuantidade;

  if dbgSaldosProdutosSimplesRemessa.Columns[9].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgSaldosProdutosSimplesRemessa.Columns[9].Width := ParSistema.TamanhoMascaraQuantidade;

  if dbgProdutosEtiquetas.Columns[6].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutosEtiquetas.Columns[6].Width := ParSistema.TamanhoMascaraQuantidade;

  if dbgProdutosNotaSimplesRemessa.Columns[5].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutosNotaSimplesRemessa.Columns[5].Width := ParSistema.TamanhoMascaraQuantidade;

       if ParSistema.TipoImpressoraEtiqueta = ctRABBIT    then lblTipoImpressora.Caption := 'R A B B I T'
  else if ParSistema.TipoImpressoraEtiqueta = ctZEBRA     then lblTipoImpressora.Caption := 'Z E B R A'
  else if ParSistema.TipoImpressoraEtiqueta = ctARGOX     then lblTipoImpressora.Caption := 'A R G O X'
  else if ParSistema.TipoImpressoraEtiqueta = ctMATRICIAL then lblTipoImpressora.Caption := 'M A T R I C I A L'
  else if ParSistema.TipoImpressoraEtiqueta = ctJATO      then lblTipoImpressora.Caption := 'J A T O   T I N T A';

  fraConsultaFilial.TipoPesquisa := pesFILIAIS;
  fraConsultaFilial.edfCodigo.Text := inttostr(dtmListaCasamento.filialbase);
  fraconsultafilial.edfCodigo.Exist;

  fraConsultamodeloetiqueta.CondicoesdaConsulta := CondicoesdaConsultaModeloEtiqueta;
  fraConsultamodeloetiqueta.TipoPesquisa := pesmodeloetiqueta;
//  fraConsultamodeloetiqueta.edfCodigo.Text := ;
//  fraconsultamodeloetiqueta.edfCodigo.Exist;


  pgcCadastroLista.ActivePage := tstListaCasamento;
  pgcListaCasamento.ActivePage := tstlista;

  self.activecontrol := edfLista;

  LerArquivoImportacao;


end;

destructor TfrmListaCasamento.Destroy;
begin
  dtmListaCasamento:=nil;
  inherited;
  frmListaCasamento := nil;
end;

function TfrmListaCasamento.InternoExcluir: Boolean;
begin
  Result := Inherited InternoExcluir;
  if Result and not CtrlOn then
    dtmListaCasamento.ExcluirListaCasamento;
end;

function TfrmListaCasamento.InternoGravar: Boolean;
begin
  Result := Inherited InternoGravar;
  if Result and not CtrlOn then
    if dtmListaCasamento.ValidarListaCasamento then
         flkNoiva.SetFocus
    else dtmListaCasamento.GravarListaCasamento;
end;

function TfrmListaCasamento.InternoIncluir: Boolean;
begin
  Result := inherited InternoIncluir;
  if Result then begin
    if not CtrlOn then 
      dtmListaCasamento.IncluirListaCasamento;
  end;
end;

function TfrmListaCasamento.InternoPesquisar(Titulo: String): Integer;
begin
  Result:= mrNone;
  with dtmListaCasamento do begin
    if CtrlOn then begin
      if ActiveControl = flkNoiva then begin
        TipoPesquisa:= tlcNOIVA;
        Titulo      := 'Nome Noiva';
      end
      else if ActiveControl = flkNoivo then begin
        TipoPesquisa:= tlcNOIVO;
        Titulo      := 'Nome Noivo';
      end
      else
        TipoPesquisa:= tlcNENHUM;
    end
    else begin
      TipoPesquisa:= tlcLISTAS;
      Titulo      := 'Listas de Casamento';
    end;
    if (TipoPesquisa <> tlcNENHUM) then begin
      AbreTabelaPesquisa(TipoPesquisa);
      Result:= inherited InternoPesquisar(Titulo);
      if Result = mrOK then
        Selecionar(TipoPesquisa);
      FechaTabelaPesquisa(TipoPesquisa);
    end
  end;
end;

function TfrmListaCasamento.JanelaPesquisa: TfrmConsultaBasica;
begin
  Result:= TfrmConsultaPorCampo.Create(nil);
  TfrmConsultaPorCampo(Result).ConsultaInterativa    := not (TipoPesquisa in [tlcNOIVA,tlcNOIVO]);
  TfrmConsultaPorCampo(Result).UsarParametrosDaTabela:= not (TipoPesquisa in [tlcNOIVA,tlcNOIVO]);
end;

function TfrmListaCasamento.TabelaDePesquisa: TZDataSet;
begin
  with dtmListaCasamento do
    case TipoPesquisa of
      tlcLISTAS: Result := ConsultarListas;
       tlcNOIVA,
       tlcNOIVO: Result := ConsultarClientes;
      else       Result := nil;
    end;
end;

function TfrmListaCasamento.ExisteInformacao(Parametro: Integer; NomeCampo: String; Value: Variant): Boolean;
begin
  with dtmListaCasamento do
    case TipoPesquisa of
      tlcLISTAS: Result := ExisteLista(NomeCampo, Value);
       tlcNOIVA,
       tlcNOIVO: Result := ExisteCliente(NomeCampo, Value);
       else      Result := False;
     end;
end;

function TfrmListaCasamento.AcionaCadastroProdutosLista(Editar: Boolean): Boolean;
begin
  if not Assigned (frmProdutosListaCasamento ) then
    frmProdutosListaCasamento:= TfrmProdutosListaCasamento.Create(frmProdutosListaCasamento);
  with frmProdutosListaCasamento do begin
    SetDataModulo(dtmListaCasamento);
    DataSet:= dtmListaCasamento.TabelaProdutosLista;
    Result := dtmListaCasamento.IncluirProdutosLista(Editar);
    ShowModal;
    free;
    dbgProdutos.SetFocus;
    CtrlOn:= False;
  end;
end;

procedure TfrmListaCasamento.sbnProcurarNoivaClick(Sender: TObject);
begin
  CtrlOn:= True;
  flkNoiva.SetFocus;
  InternoPesquisar('');
end;

procedure TfrmListaCasamento.sbnProcuraNoivoClick(Sender: TObject);
begin
  CtrlOn:= True;
  flkNoivo.SetFocus;
  InternoPesquisar('');
end;

procedure TfrmListaCasamento.sbnIncluirProdutoClick(Sender: TObject);
begin
  AcionaCadastroProdutosLista(False);
end;

procedure TfrmListaCasamento.sbnExcluirProdutoClick(Sender: TObject);
begin
  dtmListaCasamento.ExcluirProdutosLista;
  dbgProdutos.SetFocus;
end;

procedure TfrmListaCasamento.dbgProdutosDblClick(Sender: TObject);
begin
  AcionaCadastroProdutosLista(True);
end;

procedure TfrmListaCasamento.dbgProdutosKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  if Shift = [ssCtrl] then
    case Key of
      TeclaEditarRegistro : AcionaCadastroProdutosLista(True);
      TeclaInserirRegistro: AcionaCadastroProdutosLista(False);
    end;
end;

procedure TfrmListaCasamento.KeyDown(var Key: Word; Shift: TShiftState);
begin
  inherited;
  case key of
 VK_ESCAPE: if (pgcListaCasamento.ActivePage = tstProdutosNotas) or
                (pgcListaCasamento.ActivePage = tstProdutosEtiquestas) then begin
                 pgcListaCasamento.ActivePage := tstLista;
                 edfLista.SetFocus;
             end;
      VK_S: if (Shift = [ssCtrl]) then
               sbnSelecionarProdutosListaPadrao.Click;
    VK_F6: begin
             if sbnExcluir.visible and
                sbnexcluir.Enabled then sbnExcluir.Click
             else
             if sbnGerar.visible and
                sbnGerar.Enabled then sbnGerar.Click
           end;     

    VK_F7: if sbnImprimir.Enabled then sbnImprimir.Click;

//    VK_F12: if sbnImprimirEtiqueta.Enabled then sbnImprimirEtiqueta.Click;
  end;
end;

procedure TfrmListaCasamento.sbnImprimirClick(Sender: TObject);
begin
   if pgcCadastroLista.ActivePage = tstEtiquetas then
     imprimiretiquetas
   else
   begin
     frmConfirmarImpressaoListaCasamento := TfrmConfirmarImpressaoListaCasamento.Create(frmConfirmarImpressaoListaCasamento, True, True, True);
     try
       if pgcListaCasamento.ActivePage = tstLista then begin
         if frmConfirmarImpressaoListaCasamento.ShowModal = mrOK then begin
          if frmConfirmarImpressaoListaCasamento.ListaCasamento then
            dtmListaCasamento.ImprimirListaCasamento(frmConfirmarImpressaoListaCasamento.ckbImprimirPrecoProdutoListaCasamento.checked);

          if frmConfirmarImpressaoListaCasamento.NotaSimplesRemessa then
            ImprimirNotasSimplesRemessa;
            {
          if frmConfirmarImpressaoListaCasamento.Etiqueta then
            ImprimirEtiquetas;
            }
         end
       end
       else if pgcListaCasamento.ActivePage = tstProdutosNotas then
         ImprimirNotasSimplesRemessa
       else if pgcListaCasamento.ActivePage = tstEtiquetas then
         ImprimirEtiquetas;
     finally
       frmConfirmarImpressaoListaCasamento.Free;
     end
   end;
end;

procedure TfrmListaCasamento.dbgProdutosDrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TColumn; State: TGridDrawState);
begin
  inherited;
  if (dbgProdutos.DataSource.DataSet.RecordCount > 0) then
  begin
    if (dtmListaCasamento.QtdeEntregue >= dtmListaCasamento.QtdeSolicitada) then
    begin
      TDBGrid(Sender).Canvas.Brush.Color := $00FFD9A4;
      TDBGrid(Sender).Canvas.Font.Color  := clBlack;
    end;
    if dtmListaCasamento.ProdutoIncluidoDepois then
    begin
      TDBGrid(Sender).Canvas.Font.Color  := clBlack;
      TDBGrid(Sender).Canvas.Brush.Color := $0000AA00;
    end;
    {if TDBGrid(Sender).SelectedRows.CurrentRowSelected then
      TDBGrid(Sender).Canvas.Font.Color  := clWhite
    else
      TDBGrid(Sender).Canvas.Font.Color  := clBlack;}
  end;
  TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
end;

procedure TfrmListaCasamento.edtCasamentoEnter(Sender: TObject);
begin
  inherited;
  if not DataEmBranco(edtCasamento.Text) and (StrToDate(edtCasamento.Text) < dtmListaCasamento.DataServidor) then
    edtCasamento.Minimo:= DaysBetween(dtmListaCasamento.DataServidor + 1,StrToDate(edtCasamento.Text));
end;

procedure TfrmListaCasamento.dbgSaldosProdutosSimplesRemessaDrawColumnCell(
  Sender: TObject; const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  inherited;
  if dbgSaldosProdutosSimplesRemessa.DataSource.DataSet.FieldByName('quantidadeaentregar').AsCurrency <> 0 then
  begin
    TDBGrid(Sender).Canvas.Brush.Color := clInfoBk;
    TDBGrid(Sender).Canvas.Font.Color := clBlack;
    TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
  end;
end;

procedure TfrmListaCasamento.dbgProdutosEtiquetasDrawColumnCell(
  Sender: TObject; const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  inherited;
  if dbgProdutosEtiquetas.DataSource.DataSet.FieldByName('imprimir').AsBoolean then  begin
    TDBGrid(Sender).Canvas.Brush.Color := clInfoBk;
    TDBGrid(Sender).Canvas.Font.Color := clBlack;
    TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
  end;
end;

procedure TfrmListaCasamento.dbgSaldosProdutosSimplesRemessaKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if Key = VK_SPACE then
    if Shift = [ssCtrl] then
      dtmListaCasamento.MarcarNotasImprimir;
end;

procedure TfrmListaCasamento.dbgSaldosProdutosSimplesRemessaDblClick(Sender: TObject);
begin
  inherited;
  dtmListaCasamento.MarcarNotasImprimir;
end;

procedure TfrmListaCasamento.dbgProdutosEtiquetasKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if Key = VK_SPACE then
    if Shift = [ssCtrl] then
      dtmListaCasamento.MarcarEtiquetaImprimir;
end;

procedure TfrmListaCasamento.dbgProdutosEtiquetasDblClick(Sender: TObject);
begin
  inherited;
  dtmListaCasamento.MarcarEtiquetaImprimir;
end;

procedure TfrmListaCasamento.flkNoivaExit(Sender: TObject);
begin
  inherited;
  if (flkNoivo.Text <> '') then
    dtmListaCasamento.ValidarListaCasamento;
end;

procedure TfrmListaCasamento.flkNoivoExit(Sender: TObject);
begin
  inherited;
  if (flkNoiva.Text <> '') then
    dtmListaCasamento.ValidarListaCasamento;
end;

procedure TfrmListaCasamento.AcionaSelecionarProdutosListaPadrao;
begin
  if not Assigned (frmSelecionarProdutosListaPadrao) then
    frmSelecionarProdutosListaPadrao:= TfrmSelecionarProdutosListaPadrao.Create(frmSelecionarProdutosListaPadrao);
  with frmSelecionarProdutosListaPadrao do begin
    SetDataModulo(dtmListaCasamento);
    ShowModal;
  end;
  frmSelecionarProdutosListaPadrao.Free;
  dtmListaCasamento.FecharTabelasListaPadrao;

  dbgProdutos.SetFocus
end;

procedure TfrmListaCasamento.sbnSelecionarProdutosListaPadraoClick(Sender: TObject);
begin
  inherited;
  AcionaSelecionarProdutosListaPadrao;
end;

procedure TfrmListaCasamento.ImprimirEtiquetas;
begin
   with fraConsultaModeloEtiqueta do begin
      if pgcCadastroLista.ActivePage = tstEtiquetas
      then if MensagemConfirmacao('Confirma a impressão das etiquetas?') = smbOk
           then if ParSistema.TipoImpressoraEtiqueta = ctZEBRA
                then dtmListaCasamento.ImprimirEtiquetasZebraTLP2844(qryProcuraModelosEtiquetasTipo.  AsString,
                                                                     qryProcuraModelosEtiquetasModelo.AsString,
                                                                     qryProcuraModelosEtiquetasColuna.AsInteger);
   end;
end;

procedure TfrmListaCasamento.ImprimirNotasSimplesRemessa;
begin
  if pgcListaCasamento.ActivePage = tstLista then begin
    if dtmListaCasamento.SelecionarProdutosImprimir then begin
      MensagemAviso(format(ctNENHUMREGISTROSELECIONADO,['registro']));
      pgcListaCasamento.ActivePage:= tstLista;
      edfLista.SetFocus;
    end
    else begin
      pgcListaCasamento.ActivePage:= tstProdutosNotas;
      dbgSaldosProdutosSimplesRemessa.SetFocus;
    end;
  end
  else if pgcListaCasamento.ActivePage = tstProdutosNotas then begin
    if MensagemConfirmacao('Confirma a Impressão da Nota de Simples Remessa?') = smbOk then begin
      dtmListaCasamento.NotaFiscalSimplesRemessa;
      pgcListaCasamento.ActivePage:= tstLista;
    end
    else dbgSaldosProdutosSimplesRemessa.SetFocus;
  end;
end;

procedure TfrmListaCasamento.AfterScrollLinhaColunaGrade(Sender: TObject);
begin
 dbgProdutos.Columns[2].Title.Caption := dtmListaCasamento.LinhadaGrade;
 dbgProdutos.Columns[3].Title.Caption := dtmListaCasamento.ColunadaGrade;
end;

procedure TfrmListaCasamento.AfterScrollLinhaColunaGradeNotas(
  Sender: TObject);
begin
 dbgSaldosProdutosSimplesRemessa.Columns[3].Title.Caption := dtmListaCasamento.LinhadaGradeNotas;
 dbgSaldosProdutosSimplesRemessa.Columns[4].Title.Caption := dtmListaCasamento.ColunadaGradeNotas;
end;

procedure TfrmListaCasamento.AfterScrollLinhaColunaGradeEtiquetas(
  Sender: TObject);
begin
 dbgProdutosEtiquetas.Columns[4].Title.Caption := dtmListaCasamento.LinhadaGradeEtiquetas;
 dbgProdutosEtiquetas.Columns[5].Title.Caption := dtmListaCasamento.ColunadaGradeEtiquetas;
end;

procedure TfrmListaCasamento.pgcCadastroListaChange(Sender: TObject);
begin
  inherited;
  if pgcCadastroLista.ActivePage = tstNotasSimplesRemessa then
    dtmListaCasamento.AbrirNotasSimplesRemessa;
end;

procedure TfrmListaCasamento.sbnArquivoClick(Sender: TObject);
var
  vNomeArquivo : String;
begin
  inherited;
  if dlgArquivoaImportar.Execute then
  begin
   lblarquivo.Caption := trim(dlgArquivoaImportar.FileName);
   if dtmListaCasamento.ProcessarArquivoImportacao(lblarquivo.Caption) then
   begin
     SalvarArquivoImportacao;
     MensagemAviso(format(ctARQUIVOIMPORTADOSUCESSO,[lblarquivo.Caption]));
     vNomeArquivo := ChangeFileExt(lblarquivo.Caption,'.old');
     if not (RenameFile(lblarquivo.Caption, vNomeArquivo)) then
       raise Exception.Create('Não foi possível renomear o arquivo para a extensão ''.old''');

   end;
  end;
end;

procedure TfrmListaCasamento.sbnProcessarArquivoImportacaoClick(
  Sender: TObject);
begin
  inherited;
  if FileExists(lblarquivo.Caption) then
  begin
   if dtmListaCasamento.ProcessarArquivoImportacao(lblarquivo.Caption) then
     MensagemAviso(format(ctARQUIVOIMPORTADOSUCESSO,[lblarquivo.Caption]));
  end
  else
    MensagemErro(ctARQUIVOINEXISTENTE);

end;

procedure TfrmListaCasamento.LerArquivoImportacao;
var
  ArquivoCFG: TIniFile;
begin
  if FileExists(NomeArquivoCFG) then
  begin
    ArquivoCFG := TIniFile.Create(NomeArquivoCFG);
    try
      if ArquivoCFG.SectionExists('Outros') then begin
        lblArquivo.Caption := ArquivoCFG.ReadString('Outros', 'CaminhoArquivoImportacao', '');
      end;
    finally
      ArquivoCFG.Free;
    end;
  end;
end;

procedure TfrmListaCasamento.SalvarArquivoImportacao;
var
  ArquivoCFG: TIniFile;
begin
  if FileExists(NomeArquivoCFG) then
  begin
    ArquivoCFG := TIniFile.Create(NomeArquivoCFG);
    try
        ArquivoCFG.WriteString('Outros', 'CaminhoArquivoImportacao',lblArquivo.Caption);
    finally
      ArquivoCFG.UpdateFile;
      ArquivoCFG.Free;
    end;
  end;
end;

procedure TfrmListaCasamento.CondicoesdaConsultaModeloEtiqueta;
begin
  fraConsultamodeloetiqueta.qryProcuraModelosEtiquetas.MacroByName('SQLCondicao').asstring := 'or (modelo = ''L'' and tipo = ''FH'')';
end;

procedure TfrmListaCasamento.actHabilitarBotaoExecute(Sender: TObject);
begin
  inherited;
  if pgcCadastroLista.ActivePage = tstEtiquetas then
  begin
   sbnImprimir.Caption:= 'Imprimir F7';
   sbnImprimir.Hint   := 'Imprimir as etiquetas selecionadas';
   sbnImprimir.Enabled := not dtmListaCasamento.qryEtiquetas.IsEmpty;
  end
  else
  begin
    if pgcListaCasamento.ActivePage = tstLista then
    begin
      sbnImprimir.Caption:= 'Imprimir F7';
      sbnImprimir.Hint   := 'Imprimir a lista de casamento';
    end
    else if pgcListaCasamento.ActivePage = tstProdutosNotas then begin
      sbnImprimir.Caption:= 'Nota F7';
      sbnImprimir.Hint   := 'Imprimir NF de simples remessa';
    end;
     {
     else if pgcListaCasamento.ActivePage = tstProdutosEtiquestas then begin
       sbnImprimir.Caption:= 'Etiqueta F7';
       sbnImprimir.Hint   := 'Imprimir Lista Casamento';
     end;
     }
    sbnImprimir.Enabled := dtmListaCasamento.PodeImprimir;
  end;

  if pgcCadastroLista.ActivePage = tstListaCasamento then
    sbnExcluir.Visible := true
  else
    sbnExcluir.Visible := false;

  if pgcCadastroLista.ActivePage = tstEtiquetas then
    sbnGerar.Visible := true
  else
    sbnGerar.Visible := false;

end;

procedure TfrmListaCasamento.sbnGerarClick(Sender: TObject);
begin
  inherited;
  if pgcSelecionarNotasCupons.ActivePage  = tstNotasFiscais then
       dtmListaCasamento.AbrirConsultaEtiquetas(fraConsultaFilial.qryProcuraFiliaiscodigo.AsInteger,
                                           edtSerie.Text, edfNota.ValorSemFormatacao,
                                           0, '', 0,
                                           chkNaoImpressas.Checked, ckbSelecionarTodos.checked)
  else
       dtmListaCasamento.AbrirConsultaEtiquetas(fraConsultaFilial.qryProcuraFiliaiscodigo.AsInteger,
                                           '', 0,
                                           edtECF.ValorSemFormatacao, edtIntervencao.text, edtCupon.ValorSemFormatacao,
                                           chkNaoImpressas.Checked, ckbSelecionarTodos.checked);
end;

procedure TfrmListaCasamento.dbgEmissaoEtiquetasKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  case Key of
     VK_SPACE: if Shift = [ssCtrl] then
                 dtmListaCasamento.MarcarSelecionados(ckbSelecionarTodos.Checked, False);
  end;

end;

procedure TfrmListaCasamento.ckbSelecionarTodosClick(Sender: TObject);
begin
  inherited;
  dtmListaCasamento.MarcarSelecionados(ckbSelecionarTodos.Checked,True);

end;

end.
