procedure TfrmListaCasamento.CondicoesdaConsultaContrato;
begin
  if dtmListaCasamento.qryContratosListaCasamento.State = dsinsert then
  begin
    fraConsultaContrato.qryProcuraContrato.MacroByName('CondicaodaConsulta').asstring := ' and (c.numero not in '+
                                                                                                ' (select distinct pc.contrato ' +
                                                                                                 ' from produtoscontratos pc ' +
                                                                                                 ' where pc.listacasamento = ' + dtmListaCasamento.qryprodutoslistacasamentolista.asstring +
                                                                                                 ' and pc.produto = ' + dtmlistacasamento.qryProdutosListaCasamentoproduto.AsString + ')) ' +
                                                                                          ' and (c.numero in '+
                                                                                                ' (select distinct pc.contrato ' +
                                                                                                 ' from produtoscontratos pc ' +
                                                                                                 ' where pc.produto = ' + dtmlistacasamento.qryProdutosListaCasamentoproduto.AsString + ')) ' +
                                                                                          ' and c.situacao in (''F'',''N'',''P'')';

    fraConsultaContrato.qryConsultaContrato.MacroByName('CondicaodaConsulta').asstring := ' and (c.numero not in '+
                                                                                                ' (select distinct pc.contrato ' +
                                                                                                 ' from produtoscontratos pc ' +
                                                                                                 ' where pc.listacasamento = ' + dtmListaCasamento.qryprodutoslistacasamentolista.asstring +
                                                                                                 ' and pc.produto = ' + dtmlistacasamento.qryProdutosListaCasamentoproduto.AsString + ')) ' +
                                                                                          ' and (c.numero in '+
                                                                                                ' (select distinct pc.contrato ' +
                                                                                                 ' from produtoscontratos pc ' +
                                                                                                 ' where pc.produto = ' + dtmlistacasamento.qryProdutosListaCasamentoproduto.AsString + ')) ' +
                                                                                          ' and c.situacao in (''F'',''N'',''P'')';

  end
  else
  begin
    fraConsultaContrato.qryProcuraContrato.MacroByName('CondicaodaConsulta').asstring := ' and (c.numero not in '+
                                                                                                ' (select distinct pc.contrato ' +
                                                                                                 ' from produtoscontratos pc ' +
                                                                                                 ' where pc.listacasamento = ' + dtmListaCasamento.qryprodutoslistacasamentolista.asstring +
                                                                                                 ' and pc.produto = ' + dtmlistacasamento.qryProdutosListaCasamentoproduto.AsString +
                                                                                                 ' and pc.contrato <> ' + quotedstr(dtmlistacasamento.qryContratosListaCasamentocontrato.AsString) + ')) ' +
                                                                                          ' and (c.numero in '+
                                                                                                ' (select distinct pc.contrato ' +
                                                                                                 ' from produtoscontratos pc ' +
                                                                                                 ' where pc.produto = ' + dtmlistacasamento.qryProdutosListaCasamentoproduto.AsString + ')) ' +
                                                                                          ' and c.situacao in (''F'',''N'',''P'')';

    fraConsultaContrato.qryConsultaContrato.MacroByName('CondicaodaConsulta').asstring := ' and (c.numero not in '+
                                                                                                ' (select distinct pc.contrato ' +
                                                                                                 ' from produtoscontratos pc ' +
                                                                                                 ' where pc.listacasamento = ' + dtmListaCasamento.qryprodutoslistacasamentolista.asstring +
                                                                                                 ' and pc.produto = ' + dtmlistacasamento.qryProdutosListaCasamentoproduto.AsString +
                                                                                                 ' and pc.contrato <> ' + quotedstr(dtmlistacasamento.qryContratosListaCasamentocontrato.AsString) + ')) ' +
                                                                                          ' and (c.numero in '+
                                                                                                ' (select distinct pc.contrato ' +
                                                                                                 ' from produtoscontratos pc ' +
                                                                                                 ' where pc.produto = ' + dtmlistacasamento.qryProdutosListaCasamentoproduto.AsString + ')) ' +
                                                                                          ' and c.situacao in (''F'',''N'',''P'')';
  end;
end;

