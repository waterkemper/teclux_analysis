procedure TfrmListaCasamento.AtribuirDadosContratos;
var
  vProduto, vContrato : String;
begin
  with dtmListaCasamento do
  begin
    if fraConsultaContrato.qryProcuraContrato.recordcount <> 0 then
    begin
      if qryContratosListaCasamento.state = dsinsert then
      begin
        qryUpdateProdutosContratos.ParamByName('listacasamento').asinteger := qryProdutosListaCasamentolista.AsInteger;
        qryUpdateProdutosContratos.ParamByName('contrato').asstring := fraConsultaContrato.qryProcuraContratonumero.asstring;
        qryUpdateProdutosContratos.ParamByName('produto').asstring := qryProdutosListaCasamentoproduto.AsString;
        qryUpdateProdutosContratos.ExecSql;
        vProduto := qryProdutosListaCasamentoproduto.AsString;
        vcontrato := fraConsultaContrato.qryProcuraContratonumero.asstring;
        perpetrar([qryUpdateProdutosContratos]);
        qryListaCasamentoAfterScroll(qryListaCasamento);
        qryProdutosListaCasamento.Locate('produto', vproduto, []);
        qryContratosListaCasamento.Locate('contrato', vContrato, []);
      end
      else
      begin
        if qryContratosListaCasamentocontratoanterior.asstring <> fraConsultaContrato.qryProcuraContratonumero.asstring then
        begin
          qryUpdateProdutosContratos.ParamByName('listacasamento').clear;
          qryUpdateProdutosContratos.ParamByName('contrato').asstring := qryContratosListaCasamentocontratoanterior.asstring;
          qryUpdateProdutosContratos.ParamByName('produto').asstring := qryProdutosListaCasamentoproduto.AsString;
          qryUpdateProdutosContratos.ExecSql;
          perpetrar([qryUpdateProdutosContratos]);

          qryUpdateProdutosContratos.ParamByName('listacasamento').asinteger := qryProdutosListaCasamentolista.AsInteger;
          qryUpdateProdutosContratos.ParamByName('contrato').asstring := fraConsultaContrato.qryProcuraContratonumero.asstring;
          qryUpdateProdutosContratos.ParamByName('produto').asstring := qryProdutosListaCasamentoproduto.AsString;
          qryUpdateProdutosContratos.ExecSql;
          perpetrar([qryUpdateProdutosContratos]);
          vProduto := qryProdutosListaCasamentoproduto.AsString;
          vcontrato := fraConsultaContrato.qryProcuraContratonumero.asstring;

          qryListaCasamentoAfterScroll(qryListaCasamento);

          qryProdutosListaCasamento.Locate('produto', vproduto, []);
          qryContratosListaCasamento.Locate('contrato', vContrato, []);

        end;
      end;
    end;


    {
    qryContratosListaCasamentocontrato.asstring := fraConsultaContrato.qryProcuraContratonumero.asstring;
    qryContratosListaCasamentocliente.AsInteger := fraConsultaContrato.qryProcuraContratocliente.AsInteger;
    qryContratosListaCasamentonome.AsString          := fraConsultaContrato.qryProcuraContratonome.asstring;;
    qryContratosListaCasamentodata.AsDateTime          := fraConsultaContrato.qryProcuraContratodata.AsDateTime;
    qryContratosListaCasamentodatareservado.asdatetime := fraConsultaContrato.qryProcuraContratodatareservado.asDatetime;
    qryContratosListaCasamentofaturamento.AsDateTime   := fraConsultaContrato.qryProcuraContratofaturamento.AsDateTime;;
    qryContratosListaCasamentonomesituacao.asstring  := fraConsultaContrato.qryProcuraContratonomesituacao.AsString;
    qryContratosListaCasamentotipocliente.AsString   := fraConsultaContrato.qryProcuraContratotipocliente.AsString;
    }
  end;
end;

procedure TfrmListaCasamento.dbgContratosDblClick(Sender: TObject);
var vKey: Word;
begin
  inherited;
  ShiftOn := False;
  CtrlOn := true;
  vKey := VK_F9;
  dbgContratosKeyDown(dbgContratos, vKey, [ssctrl]);
end;

procedure TfrmListaCasamento.dbgContratosKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if (dbgContratos.SelectedField = dtmListaCasamento.qryContratosListaCasamentocontrato) then
  begin
    if (key = VK_F9) and CtrlOn then
      AcionaPesquisaGrade
    else
    if (key = VK_RETURN) then
    begin
       fraConsultaContrato.edfCodigo.Modified := true;
      fraConsultaContrato.edfCodigo.DoExit;
      if not fraConsultaContrato.edfCodigo.Exist then
        dtmListaCasamento.qryContratosListaCasamento.Cancel;
    end;
  end;
end;

procedure TfrmListaCasamento.AcionaPesquisaGrade;
begin
  if dbgContratos.Focused then
  begin
    fraConsultaContrato.CtrlOn := True;
    fraConsultaContrato.InternoPesquisar('CONTRATO');
    dbgContratos.SetFocus;
    dbgContratos.SelectedIndex :=  0;
  end;
end;

