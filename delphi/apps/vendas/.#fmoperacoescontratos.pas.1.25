procedure TfrmOperacoesContratos.ImprimirContrato;
var
  CarnesAbertas, ImprimirContrato: Boolean;
begin
      (*
  if ({(dtmOperacoesContratos.SituacaoContrato > scRESERVADO) and} (Length(dtmOperacoesContratos.IntervaloCarnesAbertas)>0)) then
    CarnesAbertas:= True
  else
  *)
    CarnesAbertas:= False;

  if (ParSistema.SoImprimirFaturados) then
    if (dtmOperacoesContratos.SituacaoContrato > scRESERVADO) then
      ImprimirContrato:= True
    else
      ImprimirContrato:= False
  else
    ImprimirContrato:= True;

  frmConfirmarImpressaoNoContrato := TfrmConfirmarImpressaoNoContrato.Create(frmConfirmarImpressaoNoContrato, ImprimirContrato, false,
                                     {(dtmOperacoesContratos.SituacaoContrato > scRESERVADO)} false, {(CarnesAbertas)} false,
                                     false,1, false);

//  frmConfirmarImpressaoNoContrato.IntervaloCarnes := dtmOperacoesContratos.IntervaloCarnes;
//  frmConfirmarImpressaoNoContrato.IntervaloCarnesAbertas:= dtmOperacoesContratos.IntervaloCarnesAbertas;
//  frmConfirmarImpressaoNoContrato.ckbImprimirCarneAbertas.Enabled := frmConfirmarImpressaoNoContrato.IntervaloCarnesAbertas<>nil;

  try
    frmConfirmarImpressaoNoContrato.ShowModal;
    if frmConfirmarImpressaoNoContrato.ModalResult = mrOK then
    begin
      if frmConfirmarImpressaoNoContrato.Contrato then
        dtmOperacoesContratos.ImprimirContrato(dbgProdutos.Ordenacao)
      else
      if frmConfirmarImpressaoNoContrato.ContratoMeiaPagina then
        dtmOperacoesContratos.ImprimirContrato(dbgProdutos.Ordenacao, true);
{
      if frmConfirmarImpressaoNoContrato.Carne then
        dtmOperacoesContratos.ImprimirCarne(frmConfirmarImpressaoNoContrato.Sequencia)
      else
      if frmConfirmarImpressaoNoContrato.CarneAbertas then
        dtmOperacoesContratos.ImprimirCarne(frmConfirmarImpressaoNoContrato.Sequencia);

      if frmConfirmarImpressaoNoContrato.Boleto then
        dtmOperacoesContratos.ImprimirBoleto(frmConfirmarImpressaoNoContrato.Sequencia);

      if frmConfirmarImpressaoNoContrato.Saldo then
        dtmOperacoesContratos.ImprimirSaldo;

      if frmConfirmarImpressaoNoContrato.etiquetasListacasamento then
        dtmOperacoesContratos.ImprimirEtiquetasListaCasamento;
        }

    end
  finally
    frmConfirmarImpressaoNoContrato.Free;
  end
end;

procedure TfrmOperacoesContratos.sbnImprimirContratoClick(Sender: TObject);
begin
  inherited;
  ImprimirContrato;
end;

procedure TfrmOperacoesContratos.sbnConferirClick(Sender: TObject);
begin
  inherited;
  with dtmOperacoesContratos do
    ConferirProdutos(qryProdutosEntregar, qryProdutosEntregarproduto.fieldname,
     qryProdutosEntregarprodutovisual.FieldName, qryProdutosEntregardescricao.FieldName,
     qryProdutosEntregarpendente_contrato.FieldName, 'CTR',

     ifthen(qryContratosPrimogenito.asstring<>'', qryContratosPrimogenito.asstring,
     qryContratosnumero.asSTring),
     qryProdutosEntregarvalorgrade1.FieldName,
     qryProdutosEntregarvalorgrade2.FieldName,
     qryProdutosEntregarlinha.FieldName,
     qryProdutosEntregarcoluna.FieldName);

end;

procedure TfrmOperacoesContratos.AfterScrollLinhaColunaGrade(
  Sender: TObject);
begin
  dbgProdutos.ColumnByName('valorgrade1').Title.Caption := dtmOperacoesContratos.LinhadaGrade;
  dbgProdutos.ColumnByName('valorgrade2').Title.Caption := dtmOperacoesContratos.colunadaGrade;
end;

procedure TfrmOperacoesContratos.sbnConsultaVendasClick(Sender: TObject);
var
  vListaProdutos : TStringList;
  vRegistroAtual : TBookMark;
begin
  inherited;
  with dtmOperacoesContratos do
  begin

    try

      vListaProdutos := TStringList.create;
      vListaProdutos.Duplicates := dupIgnore;

      vRegistroAtual := qrycontratos.getBookMark;
      qryContratos.First;
      while not qryContratos.Eof do
      begin
        if qrycontratosselecionar.AsBoolean then
        begin
          qryProdutosEntregar.First;
          while not qryProdutosEntregar.eof do
          begin
            if (qryProdutosEntregarsituacao_produto.AsString = 'N') or
               (qryProdutosEntregarsituacao_produto.AsString = 'P') then
              vListaProdutos.Append(qryProdutosEntregarprodutovisual.asString);
            qryProdutosEntregar.next;
          end;
        end;

        qryContratos.next;
      end;

      if vListaProdutos.count <> 0 then
        AcionarTelaConsultaCompras(self, vListaProdutos);

    finally
      vListaProdutos.free;

      qrycontratos.gotobookmark(vRegistroAtual);
      qrycontratos.freebookmark(vRegistroAtual);
    end;
  end;

end;

procedure TfrmOperacoesContratos.Timer2Timer(Sender: TObject);
begin
  inherited;
  if not vgerandoconsulta then
    if sbnGerar.Enabled then
      sbnGerarClick(nil);
    
