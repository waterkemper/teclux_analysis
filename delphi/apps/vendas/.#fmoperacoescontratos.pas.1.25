procedure TfrmOperacoesContratos.AdvSpinEditOPSecChange(Sender: TObject);
begin
  inherited;
  if AdvSpinEditOPSec.Value < 0 then
    AdvSpinEditOPSec.Value := 0;

  Timer2.enabled := AdvSpinEditOPSec.Value <> 0;
  Timer2.Interval := AdvSpinEditOPSec.Value * 1000;
end;

