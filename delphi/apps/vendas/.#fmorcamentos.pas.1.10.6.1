procedure TfrmOrcamentos.KeyDown(var Key: Word; Shift: TShiftState);
begin
  inherited;
  case key of
 VK_SPACE: if (Shift = [ssCtrl]) and dbgPlanos.Focused and
                not dtmOrcamentos.TabelaOrcamentoBloqueada then
                dtmOrcamentos.SelecionarPlano;
    VK_F7: if not CtrlOn and sbnContrato.Enabled then
               sbnContrato.Click;
    VK_F8: if not CtrlOn and sbnCopia.Enabled then
               sbnCopia.Click;
   VK_F11: if not CtrlOn and sbnImprimir.Enabled then
               sbnImprimir.Click;
   VK_F12: if sbnEnviarOrcamento.Enabled then
                    sbnEnviarOrcamentoClick(nil);
  end;
end;

