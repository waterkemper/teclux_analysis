function TfrmOrcamentos.IncluirEditarServicosOrcamento(
  Editar: Boolean): Boolean;
begin
  frmCadastroServicosOrcamento := TfrmCadastroServicosOrcamento.Create(frmCadastroServicosorcamento);
  if Editar then
    Result := dtmOrcamentos.EditarServicosOrcamento
  else
    Result := dtmOrcamentos.IncluirServicosOrcamento(False);
  if Result then
    Result := frmCadastroServicosOrcamento.ShowModal = mrOK;
  frmCadastroServicosOrcamento.Free;
  dtmOrcamentos.CalcularValorTotalServicos;
  if dtmOrcamentos.AlterarPlanos then
    dtmOrcamentos.ReCalcularPlanosPagamento;
  SetFocus;
end;

