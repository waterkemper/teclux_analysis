procedure TfrmOrcamentos.sbnEnviarOrcamentoClick(Sender: TObject);
begin
  inherited;
  frmEnviarEmail:= TfrmEnviarEmail.Create(frmEnviarEmail,ParSistema.Host, ParSistema.EmailEmpresa,'','Orçamento');
  try
    with frmEnviarEmail do
    begin
      Data   := dtmOrcamentos.DataServidor;
      Empresa:= PrimeiraLetraEmMaiuscula(dtmOrcamentos.NomeFilialBase);
      Msg    := dtmOrcamentos.MontarOrcamento;
      ShowModal;
    end;
  finally
    frmEnviarEmail.Free;
  end;
  edfNumeroOrcamento.SetFocus;
end;

procedure TfrmOrcamentos.GravarLinhas;
var Contador: Integer; 
begin
 with dtmOrcamentos do begin
    qryProdutosOrcamentos.DisableControls;
    Contador:= 1;
    qryProdutosOrcamentos.First;
    while Not qryProdutosOrcamentos.Eof do begin
      qryProdutosOrcamentos.Edit;
      qryProdutosOrcamentosNumero.AsInteger := Contador;
      qryProdutosOrcamentos.Post;
      Inc(Contador);
      qryProdutosOrcamentos.Next;
    end;
    qryProdutosOrcamentos.EnableControls;
    qryProdutosOrcamentos.First;
  end;
end;

procedure TfrmOrcamentos.actHabilitarUpdate(Sender: TObject);
begin
  inherited;
  sbnExcluir.Enabled     := (dtmOrcamentos.Situacao = 'A');
  sbnIncluirPlano.Enabled:= dtmOrcamentos.HabilitarPlanos;
  sbnExcluirPlano.Enabled:= dtmOrcamentos.HabilitarPlanos;
  sbnCopia.Enabled       := not sbnSalvar.Enabled and dtmOrcamentos.HabilitarPlanos;
  sbnImprimir.Enabled    := not sbnSalvar.Enabled;
  sbnContrato.Enabled    := not sbnSalvar.Enabled and (dtmOrcamentos.Situacao = 'A');
  sbnEnviarOrcamento.Enabled  := (dtmOrcamentos.Situacao='A') and not sbnSalvar.Enabled;

  dtxCancelamento.Visible:= dtmOrcamentos.OrcamentoCancelado;
  dtxContrato.Visible    := (dtmOrcamentos.Situacao = 'T');
  lblContrato.Visible    := dtxContrato.Visible;
  dtxMotivo.Visible      := dtmOrcamentos.OrcamentoCancelado;
  lblMotivo.Visible      := dtmOrcamentos.OrcamentoCancelado;

end;

