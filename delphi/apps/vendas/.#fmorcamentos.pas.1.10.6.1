    fraCGCCPF.edtCPFCNPJ.Tipo:= dtmOrcamentos.TipoPessoa;
end;

procedure TfrmOrcamentos.sbnIncluirProdutoClick(Sender: TObject);
begin
  inherited;
  if dtmOrcamentos.PodeAlterarCampos then
  begin
    CtrlOn := True;
    dbgProdutos.SetFocus;
    InternoIncluir;
    GravarLinhas;
  end;
end;

function TfrmOrcamentos.IncluirEditarProdutosOrcamento(Editar: Boolean): Boolean;
begin
  frmProdutosOrcamento := TfrmProdutosOrcamento.Create(frmProdutosOrcamento);
  if Editar then Result := dtmOrcamentos.EditarProdutosOrcamento
  else           Result := dtmOrcamentos.IncluirProdutosOrcamento;
  if Result then
    Result := frmProdutosOrcamento.ShowModal = mrOK;

  frmProdutosOrcamento.Free;
  dtmOrcamentos.CalcularValorTotalProdutos;
//  dtmOrcamentos.CalcularValorVenda;
  if dtmOrcamentos.AlterarPlanos then
    dtmOrcamentos.ReCalcularPlanosPagamento;
  flkFilialMontagem.ReadOnly := Not dtmOrcamentos.ExisteMontagem;
  SetFocus;
  if dtmOrcamentos.qryorcamentos.state in [dsedit, dsinsert] then
    InternoGravar;
  dbgProdutos.setfocus;
end;

procedure TfrmOrcamentos.sbnExcluirProdutoClick(Sender: TObject);
begin
  inherited;
  if dtmOrcamentos.PodeAlterarCampos then begin
    dtmOrcamentos.ExcluirProdutoOrcamento;
    GravarLinhas;
  end;
end;

procedure TfrmOrcamentos.dbgProdutosDblClick(Sender: TObject);
begin
  inherited;
  if dtmOrcamentos.PodeAlterarCampos then
    IncluirEditarProdutosOrcamento(True)
end;

procedure TfrmOrcamentos.sbnProcurarFilialMontagemClick(Sender: TObject);
begin
  inherited;
  CtrlOn:= True;
  flkFilialMontagem.SetFocus;
  InternoPesquisar('');
end;

procedure TfrmOrcamentos.dbgProdutosKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;
  case Key of
    TeclaEditarRegistro : if dtmOrcamentos.PodeAlterarCampos then
                            IncluirEditarProdutosOrcamento(True);
  end;
end;

procedure TfrmOrcamentos.edfNumeroContratoFound(Found: Boolean);
begin
  inherited;
  if Found then begin
    edtNomeCliente.SendToBack;
    flkCliente.SetFocus;
  end;
end;

procedure TfrmOrcamentos.sbnIncluirPlanoClick(Sender: TObject);
begin
  inherited;
  if dtmOrcamentos.PodeAlterarCampos then begin
    if (dtmOrcamentos.TotalProdutos + dtmOrcamentos.TotalServicos = 0) then
      MensagemAviso(ctORCAMENTO_PRODUTOSERVICO)
    else begin
      ContornaChuncho:= True;
      try
        CalcularFinanciamento;
      finally
        ContornaChuncho:= False;
      end
    end;
  end  
end;

procedure TfrmOrcamentos.CalcularFinanciamento;
var
  Parcelas: TResumosParcelas;
  TotalCalcular: Currency;
begin
  inherited;
  Parcelas := nil;
  frmCalculoFinanciamento := TfrmCalculoFinanciamento(TfrmCalculoFinanciamento.Referencia);
  if Assigned(frmCalculoFinanciamento) then
    frmCalculoFinanciamento.SetFocus
  else begin
    TotalCalcular:= dtmOrcamentos.TotalProdutos + dtmOrcamentos.TotalServicos;
    dtmOrcamentos.ResumoParcelas(Parcelas);
    frmCalculoFinanciamento := TfrmCalculoFinanciamento.Create(Owner, True);
    frmCalculoFinanciamento.OntecClose    := OnCloseCalculoFinanciamento;
    frmCalculoFinanciamento.DefinirValoresCalculo(PrecisaReCalcularParcelas,
                                                  TotalCalcular,
                                                  dtmOrcamentos.Frete,
                                                  dtmOrcamentos.Seguro,
                                                  dtmOrcamentos.Desconto,
                                                  0,
						  0,
                                                  dtmOrcamentos.PlanoUtilizado,
                                                  dtmOrcamentos.DataEmissao,
                                                  dtmOrcamentos.EstadoFilialBase,
                                                  Parcelas,
                                                  nil, //Grupos,
                                                  nil, //Classes,
                                                  dtmOrcamentos.PermiteDesconto,
                                                  0);
    Parcelas := nil;
  end;
end;

procedure TfrmOrcamentos.OnCloseCalculoFinanciamento;
begin
  LerValoresCalculoFinanciamento;
end;

procedure TfrmOrcamentos.LerValoresCalculoFinanciamento;
var
  Parcelas, ParcContr: TResumosParcelas;
  ValorPrazo,
  TaxaJuros,
  Desconto: Real;
  Plano: Integer;
begin
  inherited;
  Plano:= 0;
  if not ContornaChuncho then begin
    frmCalculoFinanciamento := TfrmCalculoFinanciamento(TfrmCalculoFinanciamento.Referencia);
    if Assigned(frmCalculoFinanciamento) and
       frmCalculoFinanciamento.ResumosParcelas(Parcelas, ValorPrazo, TaxaJuros, Desconto, Plano)
    then begin
      dtmOrcamentos.ResumoParcelas(ParcContr);
      if Not ParcelasIdenticas(Parcelas, ParcContr) then begin
        dtmOrcamentos.DefinirParcelas(Parcelas, ValorPrazo, TaxaJuros, Desconto, Plano);
        PrecisaReCalcularParcelas := Plano = 0;
      end;
      Parcelas  := nil;
      ParcContr := nil;
    end
  end
end;

