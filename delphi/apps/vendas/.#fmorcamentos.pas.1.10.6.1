constructor TfrmOrcamentos.Create(AOwner: TComponent);
begin
try
  dtmOrcamentos := TdtmOrcamentos.Create(Self);
  inherited;
  DataSet         := dtmOrcamentos.TabelaOrcamento;
  flkVendedor.Enabled := Not UsuarioLogin.Vendedor;
  flkVendedor.TabStop := flkVendedor.Enabled;
  if UsuarioLogin.Vendedor then begin
    dtmOrcamentos.VendedorDefault := UsuarioLogin.CodigoUsuario;
    dtxNomeVendedor.Width:= dtxNomeVendedor.Width + dtxNomeVendedor.Left - flkVendedor.Left;
    dtxNomeVendedor.Left := flkVendedor.Left;
    dtxNomeVendedor.BringToFront;
  end;
  pgcOrcamento.Pages[1].Visible:=ParSistema.ContratoComServico;
  TipoConsulta:= vocORCAMENTO;
  dbgProdutos.Columns[1].Visible := Not ParSistema.FiliaisIndependentes;
  pgcOrcamento.Pages[0].Visible:=True;
  pgcOrcamento.ActivePage:= tstServicos;
  pgcOrcamento.ActivePage:= tstProdutos;

  if dbgProdutos.ColumnbyName('descricao').Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutos.ColumnbyName('descricao').width := ParSistema.TamanhoMascaraQuantidade;

  if dbgProdutos.ColumnbyName('previsao').Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutos.ColumnbyName('previsao').Width := ParSistema.TamanhoMascaraQuantidade;

  if dbgProdutos.ColumnbyName('entrega').Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutos.ColumnbyName('entrega').Width := ParSistema.TamanhoMascaraQuantidade;

  if dbgProdutos.ColumnbyName('emestoque').Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutos.ColumnbyName('emestoque').Width := ParSistema.TamanhoMascaraQuantidade;

  if ParSistema.PermitirProdutoAlfanumerico then
    dbgProdutos.ColumnByName('produto').FieldName := 'produtovisual'
  else
    dbgProdutos.ColumnByName('produto').FieldName := 'produto';

except
     on E: Exception do ShowMessage(E.Message);
end;

end;

destructor TfrmOrcamentos.Destroy;
begin
  dtmOrcamentos:=nil;
  inherited;
  frmOrcamentos:= nil;
end;

function TfrmOrcamentos.ExisteInformacao(Parametro: Integer; NomeCampo: String; Value: Variant): Boolean;
begin
  case TipoConsulta of
   vocORCAMENTO:       Result := dtmOrcamentos.ExisteOrcamento(NomeCampo, Value);
    vocCLIENTES:       Result := dtmOrcamentos.ExisteCliente(NomeCampo, Value);
    vocVENDEDOR:       Result := dtmOrcamentos.ExisteVendedor(NomeCampo, Value);
    vocFILIALMONTAGEM: Result := dtmOrcamentos.ExisteFilialMontagem(NomeCampo, Value);
  else                 Result := False;
  end
end;

procedure TfrmOrcamentos.flkClienteExit(Sender: TObject);
begin
  inherited;
  HabilitarControlesCliente(Trim(flkCliente.Text) = '');
  if flkCliente.Text = '' then
    dtmOrcamentos.qryProcuraClienteAfterOpen(dtmOrcamentos.qryProcuraCliente);

  if (dtmOrcamentos.qryOrcamentoscliente.asinteger <> 0) {and dtmOrcamentos.qryProdutosOrcamentos.isEmpty} then
    sbnIncluirProdutoClick(nil);
end;

procedure TfrmOrcamentos.edfNumeroOrcamentoExit(Sender: TObject);
begin
  inherited;
  HabilitarControlesCliente(Trim(flkCliente.Text) = '');
end;

procedure TfrmOrcamentos.HabilitarControlesCliente(Valor: Boolean);
begin
  if Valor then
  begin
    edtNomeCliente.BringToFront;
    edtNomeCliente.tabstop := true;
  end
  else
  begin
    edtNomeCliente.SendToBack;
    edtNomeCliente.tabstop := false;
  end;
  fraCGCCPF.edtCPFCNPJ.Tipo      := dtmOrcamentos.TipoPessoa;

  if ((Valor) and (dtmOrcamentos.qryOrcamentoscodigo.IsNull)) then
  begin
    edtDDD1  .Text := '';
    edtFone1 .Text := '';
    edtRamal1.Text := '';
    edtDDD2  .Text := '';
    edtFone2 .Text := '';
    edtRamal2.Text := '';
  end;
  edtDDD1.ReadOnly   := Not Valor;
  edtFone1.ReadOnly  := Not Valor;
  edtRamal1.ReadOnly := Not Valor;

  edtDDD2.ReadOnly   := Not Valor;
  edtFone2.ReadOnly  := Not Valor;
  edtRamal2.ReadOnly := Not Valor;


//  fraCGCCPF.rbnFisica.Enabled    := Valor;
//  fraCGCCPF.rbnJuridica.Enabled  := Valor;
//  fraCGCCPF.edtCPFCNPJ.ReadOnly  := Not Valor;

end;

function TfrmOrcamentos.InternoExcluir: Boolean;
var
  Cancelar: Boolean;
  Msg: String;
begin
  Result:= inherited InternoExcluir;
  if Result then begin
    if ParSistema.ExclusaoOrcamento = exoCANCELAR then
      Cancelar:= True
    else begin
      if ParSistema.ExclusaoOrcamento = exoPERGUNTAR then begin
        Cancelar:= MensagemConfirmacao(ctCANCELARORCAMENTO) = smbCANCEL;
        if not Cancelar then begin
          Msg    := Format(ctCONFIRMEEXCLUIR, ['o(s) orçamento(s)']);
          Result := MensagemConfirmacao(Msg) = smbOk;
        end
      end else begin
        Cancelar:= False;
        Msg    := Format(ctCONFIRMEEXCLUIR, ['o(s) orçamento(s)']);
        Result := MensagemConfirmacao(Msg) = smbOk;
      end
    end;
    if Result then begin
      if Cancelar then begin
        dtmOrcamentos.Abre(ctTabelasConsultaMotivos);
        frmMotivos := TfrmMotivos.Create(frmMotivos, 'Cancelamentos do orçamento', dtmOrcamentos.TabelaConsultaMotivos);
        Result:= frmMotivos.ShowModal = mrOK;
        frmMotivos.free;
      end;
      if Result then
        Result := dtmOrcamentos.ExcluirOrcamento(Cancelar);
    end;
  end;
  if pgcOrcamento.ActivePageIndex <> 0 then
    pgcOrcamento.ActivePageIndex:= 0;
end;

function TfrmOrcamentos.InternoGravar: Boolean;
begin
  Result:= inherited InternoGravar;
  if Result then begin
    if flkCliente.Text <> '' then
      Result:= flkCliente.Exist;
    if Result then
      Result:= dtmOrcamentos.GravarOrcamento;
    if pgcOrcamento.ActivePageIndex <> 0 then
      pgcOrcamento.ActivePageIndex:= 0;
    if Result then
      edtDesconto.Enabled:= True;
    flkVendedor.setfocus;
//    flkCliente.SetFocus;
  end;
end;

function TfrmOrcamentos.InternoIncluir: Boolean;
begin
  Result := inherited InternoIncluir;
  if CtrlOn then
  begin
    if dbgProdutos.Focused then
    begin
      if dtmOrcamentos.PodeAlterarCampos then
           Result:= IncluirEditarProdutosOrcamento(False)
      else Result:= False;
    end
    else if pgcOrcamento.ActivePageIndex=1 then //dbgServicos.Focused then
    begin
      if dtmOrcamentos.PodeAlterarCampos then
        Result:= IncluirEditarServicosOrcamento(False)
      else
        Result:= False;
    end
  end
  else
  begin
    if pgcOrcamento.ActivePageIndex <> 0 then
      pgcOrcamento.ActivePageIndex:= 0;
    Result:= dtmOrcamentos.IncluirOrcamento;
    if Result then
    begin
      if UsuarioLogin.Vendedor then
           flkCliente.SetFocus
      else flkVendedor.SetFocus;
    end
    else edfNumeroOrcamento.SetFocus;
  end;
  edtDesconto.Enabled:= False;
end;

function TfrmOrcamentos.InternoPesquisar(Titulo: String): Integer;
begin
  Result:= mrNone;
  with dtmOrcamentos do begin
    if CtrlOn then begin
      if (ActiveControl = flkCliente) and dtmOrcamentos.PodeAlterarCampos then begin
        Titulo      := ctCLIENTES;
        TipoConsulta:= vocCLIENTES
      end else if (ActiveControl = flkVendedor) and dtmOrcamentos.PodeAlterarCampos then begin
        Titulo      := ctVENDEDORES;
        TipoConsulta:= vocVENDEDOR
      end
      else if (ActiveControl = flkFilialMontagem) and dtmOrcamentos.PodeAlterarCampos then begin
        Titulo:= ctFILIAIS;
        TipoConsulta:= vocFILIALMONTAGEM;
      end
      else TipoConsulta:= vocNENHUM;
    end else begin
      Titulo      := ctOrcamentos;
      TipoConsulta:= vocORCAMENTO;
    end;

    if TipoConsulta <> vocNENHUM then begin
      AbreTabelasOrcamento(TipoConsulta);
      Result := inherited InternoPesquisar(Titulo);
      if Result = mrOK then
        SelecionaTabelasOrcamento(TipoConsulta);
      FechaTabelasConsulta(TipoConsulta);
    end;
  end;
end;

function TfrmOrcamentos.JanelaPesquisa: TfrmConsultaBasica;
begin
  Jan := TfrmConsultaPorCampo.Create(nil);
  Jan.ConsultaInterativa := not (TipoConsulta in [vocORCAMENTO, vocCLIENTES]);
  Result := Jan;
end;

procedure TfrmOrcamentos.sbnClienteClick(Sender: TObject);
begin
  edtDDD1.Text := '';
  edtFone1.Text := '';
  edtRamal1.Text := '';
  edtDDD2.Text := '';
  edtFone2.Text := '';
  edtRamal2.Text := '';
  inherited;
  TipoConsulta := vocCLIENTES;
  inherited InternoPesquisar(flkCliente, ctCLIENTES);
  EdtDDD1.Text := dtmOrcamentos.qryOrcamentosfoneddd.AsString;
  EdtFone1.Text := dtmOrcamentos.qryOrcamentosfonenumero.AsString;
  EdtRamal1.Text := dtmOrcamentos.qryOrcamentosfoneramal.AsString;
  EdtDDD2.Text := dtmOrcamentos.qryOrcamentosfone2ddd.AsString;
  EdtFone2.Text := dtmOrcamentos.qryOrcamentosfone2numero.AsString;
  EdtRamal2.Text := dtmOrcamentos.qryOrcamentosfone2ramal.AsString;

  edtDDD1.ReadOnly := False;
  edtFone1.ReadOnly := False;
  edtRamal1.ReadOnly := False;
  edtDDD2.ReadOnly := False;
  edtFone2.ReadOnly := False;
  edtRamal2.ReadOnly := False;

end;

procedure TfrmOrcamentos.sbnVendedorClick(Sender: TObject);
begin
  inherited;
  TipoConsulta := vocVENDEDOR;
  InternoPesquisar(flkVendedor, ctVENDEDORES)
end;

function TfrmOrcamentos.TabelaDePesquisa: TZDataSet;
begin
  case TipoConsulta of
    vocORCAMENTO:      Result:= dtmOrcamentos.TabelaConsultaOrcamentos;
    vocCLIENTES:       Result:= dtmOrcamentos.TabelaConsultaClientes;
    vocVENDEDOR:       Result:= dtmOrcamentos.TabelaConsultaVendedores;
    vocFILIALMONTAGEM: Result:= dtmOrcamentos.TabelaConsultaFilialMontagem;
    else               Result:= nil;
  end
end;

procedure TfrmOrcamentos.fraCGCCPFrgbTipoPessoaChange(Sender: TObject);
