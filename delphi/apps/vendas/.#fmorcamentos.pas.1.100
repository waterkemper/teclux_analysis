    begin
      if PodeIncluirProduto then
      begin
        sbnIncluirProduto.enabled := false;
        CtrlOn := True;
        dbgProdutos.SetFocus;
        InternoIncluir;
        GravarLinhas;
        sbnIncluirProduto.enabled := true;
      end;
    end;
  end;
end;


function TfrmOrcamentos.IncluirEditarProdutosOrcamento(Editar: Boolean): Boolean;
begin

  try
    dtmOrcamentos.OnScrollLinhaColunaGrade := nil;

    if PodeIncluirProduto then
    begin

      frmProdutosOrcamento := TfrmProdutosOrcamento.Create(frmProdutosOrcamento);

      if Editar then Result := dtmOrcamentos.EditarProdutosOrcamento
      else           Result := dtmOrcamentos.IncluirProdutosOrcamento;

      dtmOrcamentos.IncluindoouEditandoProduto := true;
      dtmOrcamentos.qryProdutosOrcamentosAfterScroll(nil);

      if Result then
        Result := frmProdutosOrcamento.ShowModal = mrOK;

      frmProdutosOrcamento.Free;
      dtmOrcamentos.IncluindoouEditandoProduto := false;
      dtmOrcamentos.CalcularValorTotalProdutos;
      dtmOrcamentos.VisualizandoFornecedoresProdutos := false;

      if dtmOrcamentos.AlterarPlanos then
      begin
        {  21/05/19
        result := InternoGravar;
        if result then
        }
          result := dtmOrcamentos.ReCalcularPlanosPagamento;
      end;

      flkFilialMontagem.ReadOnly := Not dtmOrcamentos.ExisteMontagem;
//      if dtmOrcamentos.qryorcamentos.state in [dsedit, dsinsert] then
      if result then
        result := InternoGravar;
      dbgProdutos.setfocus;
    end;
  finally
//    dbgPlanosParcelas.Refresh;
    dtmOrcamentos.OnScrollLinhaColunaGrade := AfterScrollLinhaColunaGrade;
    AfterScrollLinhaColunaGrade(nil);
    dbgPlanos.DataSource.DataSet.Prior;
    dbgPlanos.DataSource.DataSet.next;

  end;

end;

