procedure TfrmOrcamentos.sbnEnviarOrcamentoClick(Sender: TObject);
var
EmailContato:string;
begin
  inherited;
  if dtmOrcamentos.AutorizacaoAnalistaCredito then
  begin

  if (ParSistema.UsaitecLUX) then
    EmailContato:= dtmOrcamentos.qryOrcamentosemail.AsString
  else
     EmailContato:= UsuarioLogin.Email;

  frmEnviarEmail:= TfrmEnviarEmail.Create(frmEnviarEmail, usuariologin.HostSmtp, EmailContato,'','Orçamento');

    try
      with frmEnviarEmail do
      begin
        Data   := dtmOrcamentos.DataServidor;
        Empresa:= PrimeiraLetraEmMaiuscula(dtmOrcamentos.NomeFilialBase);
        Msg    := dtmOrcamentos.MontarOrcamento;
        ObterAutorizacao := dtmOrcamentos.obterautorizacao_;
        vGerarAtendimento := true;
        OrigemEmail := Orcamento;
        ShowModal;

        if enviou then
        begin
          if parsistema.usaiteclux then
            dtmOrcamentos.GravarEmailOrcamento(mmoIntroducao.text, mmoConclusao.text, vListaEmailValidos);

          with dtmOrcamentos do
          begin
            IncluirAtendimento_(

              qryOrcamentoscodigo.AsInteger,
              qryOrcamentoscliente.AsInteger,
              qryOrcamentostipocliente.AsString,
              EmailEnviado,
              'Orçamento '+ qryOrcamentoscodigo.AsString + ifthen(parsistema.usaiteclux,' envio de email agendado ', ' enviado para o email '+vListaEmailValidos) + chr(13) +
                            mmoIntroducao.text + char(13) +
                            mmotexto.text + char(13) +
                            mmoConclusao.text,
               nil,
              qryOrcamentosdescricaosituacao.asString

            );
          end;
        end;
      end;
    finally
      frmEnviarEmail.Free;
      fraAtendimentosDocumentos1.AbrirTabelaAtendimentosDocumentos(true);
    end;
    edfNumeroOrcamento.SetFocus;
  end;  
end;


