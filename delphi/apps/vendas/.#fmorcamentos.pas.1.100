procedure TfrmOrcamentos.Timer1Timer(Sender: TObject);
begin
  inherited;
  sbnExcluir.Enabled     := (dtmOrcamentos.Situacao = 'A');
  sbnIncluirPlano.Enabled:= dtmOrcamentos.HabilitarPlanos;
  sbnExcluirPlano.Enabled:= dtmOrcamentos.HabilitarPlanos;
  sbnCopia.Enabled       := not sbnSalvar.Enabled and dtmOrcamentos.HabilitarPlanos;
  sbnImprimir.Enabled    := not sbnSalvar.Enabled;
  sbnContrato.Enabled    := not sbnSalvar.Enabled and (dtmOrcamentos.Situacao = 'A');
  sbnEnviarOrcamento.Enabled  := (dtmOrcamentos.Situacao='A') and not sbnSalvar.Enabled;

  dtxCancelamento.Visible:= dtmOrcamentos.OrcamentoCancelado;
  dtxContrato.Visible    := not dtmOrcamentos.qryorcamentoscontrato.isnull;
  lblContrato.Visible    := dtxContrato.Visible;
  dtxMotivo.Visible      := dtmOrcamentos.OrcamentoCancelado;
  lblMotivo.Visible      := dtmOrcamentos.OrcamentoCancelado;
  sbnTextoMotivoCancelamento.Visible      := dtmOrcamentos.OrcamentoCancelado;
  mmoTextoMotivoCancelamento.Visible      := dtmOrcamentos.OrcamentoCancelado;

  sbnAtendimento.Enabled :=    (dtmOrcamentos.qryOrcamentoscodigo.asinteger <> 0) and
                               (dtmOrcamentos.qryorcamentossituacao.asString ='A') and
                               ((dtmOrcamentos.qryorcamentoscliente.asinteger <> 0) or
                                (trim(dtmOrcamentos.qryOrcamentosnome.asString) <> ''));

  flkVendedor.readonly :=
   not dtmOrcamentos.qryProcuraClientevendedor.isnull and
   not parsistema.PermitirAlterarVendedordoCliente;

  if flkVendedor.readonly then
    sbnVendedor.enabled := false;

  if dtmOrcamentos.qryQualidade_Vendacor.asstring<>'' then
  begin
    dtxCorQualificacaoVenda.color := StringtoColor(dtmOrcamentos.qryQualidade_Vendacor.asstring);
    dtxCorQualificacaoVenda.font.color := StringtoColor(dtmOrcamentos.qryQualidade_Vendacor.asstring);
  end
  else
  begin
    dtxCorQualificacaoVenda.color := clBtnFace;
    dtxCorQualificacaoVenda.font.color := clBtnFace;
  end;


  if dtmOrcamentos.qryOrcamentossituacao.asString = 'A' then
    dtxSituacao.Font.Color := clGreen
  else
    dtxSituacao.Font.Color := clBlack;

  sbnAcionarTelaFormacaoPrecoVenda2.enabled := not sbnsalvar.enabled;

  sbnImportarExcel.enabled := ((dtmOrcamentos.qryorcamentoscliente.asinteger <> 0) or
                                (trim(dtmOrcamentos.qryOrcamentosnome.asString) <> ''));

end;

procedure TfrmOrcamentos.sbnTextoMotivoCancelamentoClick(Sender: TObject);
begin
  inherited;
  if (sbnTextoMotivoCancelamento.caption = '+') then
  begin
    sbnTextoMotivoCancelamento.caption := '-';
    mmoTextoMotivoCancelamento.bringtofront;
  end
  else
  begin
    sbnTextoMotivoCancelamento.caption := '+';
    mmoTextoMotivoCancelamento.sendtoback;
  end;

end;

function TfrmOrcamentos.PodeIncluirProduto: boolean;
begin
  with dtmOrcamentos do
  begin
    if PodeAlterarCampos then
    begin
      result := true;
      if qryorcamentosvendedor.isnull then
      begin
        MensagemAviso('O vendedor não foi informado.');
        flkvendedor.setfocus;
        result:=false;
      end
      else
      if qryorcamentosnome.isnull and
         qryorcamentoscliente.isnull then
      begin
        MensagemAviso('O cliente não foi informado.');
        flkCliente.setfocus;
        result:=false;
      end;
    end;
   end;
end;

procedure TfrmOrcamentos.sbnImportarExcelClick(Sender: TObject);
