procedure TfrmOrcamentos.OperacaoPadrao(Value: array of Variant);
begin
  inherited;
  if Length(Value) > 0 then
  begin
    if Value[0] = 'Open' then
    begin
      dtmOrcamentos.RefazConsultaOrcamento(Value[1]);
      dtmOrcamentos.RecalcularPlanoOrcamentoPadrao;
      edfNumeroOrcamento.SetFocus;
    end
    else
    if Value[0] = 'Insert' then
    begin
      CtrlOn := false;
      InternoIncluir;
      dtmOrcamentos.qryProcuraCliente.parambyname('codigo').asString := VarToStr(Value[2]);
      dtmOrcamentos.qryProcuraCliente.parambyname('tipo').asString := VarToStr(Value[3]);
      flkcliente.Text := VarToStr(Value[2]);
      flkCliente.exist;
    end;

  end;

end;

procedure TfrmOrcamentos.sbnVisualizarSaldoTrocaClick(Sender: TObject);
begin
  inherited;
  edtSaldoTrocaEnter(self);
  if ParSistema.utilizarcreditotrocacontrato then
  begin
    dtmOrcamentos.AbrirDadosCreditoCliente;

    frmVisualizarSaldoTroca := TfrmVisualizarSaldoTroca.Create(frmVisualizarSaldoTroca,
                               dtmOrcamentos.TabelaSaldoCredito,
                               dtmOrcamentos.TabelaSaldoCreditoAtual);
    frmVisualizarSaldoTroca.ShowModal;
    if frmVisualizarSaldoTroca.ModalResult = mrOK then
    begin
      if (dtmOrcamentos.qryorcamentossituacao.asString = 'A') then
      begin
        if dtmOrcamentos.CreditoTroca <> dtmOrcamentos.SaldoCreditoAtual then
        begin
          dtmOrcamentos.SugerirCreditoTroca(false,true);
//          dtmOrcamentos.CalcularValorAVista;
//          PrecisaReCalcularParcelas := true;
        end;
      end;
    end;
    frmVisualizarSaldoTroca.Free;
    Application.BringToFront;
  end;

end;

procedure TfrmOrcamentos.edtSaldoTrocaEnter(Sender: TObject);
begin
  inherited;
  dtmOrcamentos.CreditoTrocaAnt := dtmOrcamentos.CreditoTroca;
end;

function TfrmOrcamentos.VerificarCreditoTroca(zerar,
  Atribuir: Boolean): Boolean;
begin
  result := true;
  if ParSistema.utilizarcreditotrocacontrato then
  begin
    dtmOrcamentos.AbrirDadosCreditoCliente;
    if dtmOrcamentos.ValidarCreditoTroca then
    begin
      if ((dtmOrcamentos.SaldoCreditoAtual<>0) and
          (dtmOrcamentos.CreditoTroca=0)) or
         ((dtmOrcamentos.SaldoCreditoAtual>0) and
          (dtmOrcamentos.CreditoTroca<dtmOrcamentos.SaldoCreditoAtual) and
          (dtmOrcamentos.CreditoTroca<dtmOrcamentos.TotalOrcamento)) then
      begin
        if dtmOrcamentos.SugerirCreditoTroca(true,atribuir) then
        begin
          edtSaldoTroca.SetFocus;
          result := atribuir;
        end
      end;
    end
    else
    begin
      if zerar then
        edtSaldoTroca.text := FormatarValor(0,2);
      edtSaldoTroca.SetFocus;
      result := false;
    end;
  end;
end;

function TfrmOrcamentos.GerarParcelasPlanoPadrao: Boolean;
begin
  result := false;
//  if VerificarCreditoTroca(false,true) then
  begin
    CalcularFinanciamento;
    Result := frmCalculoFinanciamento.calcularPlanoPadrao(dtmOrcamentos.ClientePlanoPadrao);
  end;
end;

