constructor TfrmOrcamentos.Create(AOwner: TComponent);
var
  CollItem: TtecControlItem;

begin
try
  dtmOrcamentos := TdtmOrcamentos.Create(Self);
  inherited;
  DataSet         := dtmOrcamentos.TabelaOrcamento;
  flkVendedor.Enabled := Not UsuarioLogin.Vendedor;
  flkVendedor.TabStop := flkVendedor.Enabled;
  if UsuarioLogin.Vendedor then begin
    CollItem := TtecControlItem(edfNumeroOrcamento.NoSetControls.Add);
    CollItem.Control := flkVendedor;
    dtmOrcamentos.VendedorDefault := UsuarioLogin.CodigoUsuario;
    dtxNomeVendedor.Width:= dtxNomeVendedor.Width + dtxNomeVendedor.Left - flkVendedor.Left;
    dtxNomeVendedor.Left := flkVendedor.Left;
    dtxNomeVendedor.BringToFront;
  end;
  pgcOrcamento.Pages[1].Tabvisible := ParSistema.ContratoComServico;
  TipoConsulta:= vocORCAMENTO;
  dbgProdutos.ColumnByName('filial').Visible := Not ParSistema.FiliaisIndependentes;
  pgcOrcamento.Pages[0].TabVisible := True;

//  pgcOrcamento.ActivePage:= tstServicos;

  dbgProdutos.ColumnByName('situacao_produto').Visible := ParSistema.VisualizarSituacaoProdutos;
  gbxSituacaoProdutos.Visible := ParSistema.VisualizarSituacaoProdutos;
  dbgProdutos.ColumnByName('valorgrade1').Visible := ParSistema.UsarGradesProdutos;
  dbgProdutos.ColumnByName('valorgrade2').Visible := ParSistema.UsarGradesProdutos;

  if dbgProdutos.ColumnbyName('quantidade').Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutos.ColumnbyName('quantidade').width := ParSistema.TamanhoMascaraQuantidade;

  if dbgProdutos.ColumnbyName('previsao').Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutos.ColumnbyName('previsao').Width := ParSistema.TamanhoMascaraQuantidade;

  if dbgProdutos.ColumnbyName('entrega').Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutos.ColumnbyName('entrega').Width := ParSistema.TamanhoMascaraQuantidade;

  if dbgProdutos.ColumnbyName('emestoque').Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutos.ColumnbyName('emestoque').Width := ParSistema.TamanhoMascaraQuantidade;

  pnlSaldoTroca.Enabled := ParSistema.utilizarcreditotrocacontrato;
  pnlServicos.Visible   := ParSistema.ContratoComServico;
  tstServicos.TabVisible  := ParSistema.ContratoComServico;

  pgcOrcamento.ActivePage:= tstProdutos;

  fraConsultaCargo.visible := parsistema.precosporcargo;
  lblCargo.visible := parsistema.precosporcargo;

  fraConsultaCargo.TipoPesquisa    := pesCARGOS;

  {Procedimentos para o cadastro de login no site}
  fraDadosLoginSite1.ClienteSite := dtmOrcamentos.GetCodigoCliente;
  fraDadosLoginSite1.TipoClienteSite := dtmOrcamentos.GetTipoCliente;
  fraDadosLoginSite1.NomeClienteSite        := dtmOrcamentos.GetNomeCliente;
  fraDadosLoginSite1.EmailClienteSite       := dtmOrcamentos.GetEmailCliente;
  fraDadosLoginSite1.TipoPessoaClienteSite  := dtmOrcamentos.GetTipoPessoa;
  fraDadosLoginSite1.PessoaNumeroClienteSite:= dtmOrcamentos.GetPessoaNumero;
  fraDadosLoginSite1.EditarFormulario := dtmOrcamentos.editarOrcamentos;
  dtmOrcamentos.qryUsuarios_Site := fraDadosLoginSite1.qryUsuarios_Site;
  dtmOrcamentos.OnScrollClientes := OnScrollClientes;

  {Procedimentos para o cadastro de contatos}
  fraAtendimentosDocumentos1.Documento := dtmOrcamentos.GetOrcamento;
  fraAtendimentosDocumentos1.TipoDocumento := dtmOrcamentos.GetTipoDocumento;

  fraConsultaCupom_Desconto.TipoPesquisa := pesCupons_Desconto;
  
  dtmOrcamentos.OnScrollClientes := OnScrollClientes;

  dtmOrcamentos.OnScrollLinhaColunaGrade := AfterScrollLinhaColunaGrade;

  if pgcOrcamento.ActivePageIndex <> 0 then
    pgcOrcamento.ActivePageIndex:= 0;

  self.ActiveControl := edfNumeroOrcamento;

  dbgProdutos.CampoSequencial := 'numero';



except
     on E: Exception do ShowMessage(E.Message);
end;

end;

destructor TfrmOrcamentos.Destroy;
begin
  dtmOrcamentos:=nil;
  inherited;
  frmOrcamentos:= nil;
end;

function TfrmOrcamentos.ExisteInformacao(Parametro: Integer; NomeCampo: String; Value: Variant): Boolean;
begin
  case TipoConsulta of
   vocORCAMENTO:       Result := dtmOrcamentos.ExisteOrcamento(NomeCampo, Value);
    vocCLIENTES:       Result := dtmOrcamentos.ExisteCliente(NomeCampo, Value);
    vocVENDEDOR:       Result := dtmOrcamentos.ExisteVendedor(NomeCampo, Value);
    vocFILIALMONTAGEM: Result := dtmOrcamentos.ExisteFilialMontagem(NomeCampo, Value);
  else                 Result := False;
  end
end;

procedure TfrmOrcamentos.flkClienteExit(Sender: TObject);
begin
  inherited;
  dtmOrcamentos.InputFormCustomer := Nenhum;
  if not vPressionadoGravar then
  begin
    if (dtmOrcamentos.qryorcamentos.state = dsinsert) or
       (dtmOrcamentos.qryOrcamentos.recordcount <> 0) then
    begin
      HabilitarControlesCliente(Trim(flkCliente.Text) = '');
      if flkCliente.Text = '' then
        dtmOrcamentos.qryProcuraClienteAfterOpen(dtmOrcamentos.qryProcuraCliente);
    end;

    if ((CodClienteAnt <> dtmOrcamentos.CodigoCliente) or
        (TipoClienteAnt <> dtmOrcamentos.TipoCliente)) or

        ((CodClienteAnt=0) and (TipoclienteAnt='') and
         (dtmOrcamentos.CodigoCliente<>0) and
         (dtmOrcamentos.TipoCliente<>'')) then
    begin
      if not dtmOrcamentos.ExibirFicha(ClassName) then
      begin
        if (dtmOrcamentos.qryOrcamentoscliente.asinteger <> 0) and sbnIncluirProduto.enabled then
        begin
          if dtmOrcamentos.qryProcuraClienteqtorcamentoemaberto.AsInteger>0 then
          begin
            MensagemAviso('ATENÇÃO: Cliente possui orçamentos em aberto!', ParSistema.Fechamento_da_tela_de_avisos_do_cliente_somente_com_mouse);
            sbnConsultaOrcamentos_.setfocus;
          end
          else
            sbnIncluirProdutoClick(nil);
        end;
      end
      else
      begin
        flkCliente.setfocus;
        flkCliente.selectall;
      end;
    end
    else
    if (dtmOrcamentos.qryOrcamentoscliente.asinteger <> 0) and sbnIncluirProduto.enabled then
      sbnIncluirProdutoClick(nil);
  end;
end;

procedure TfrmOrcamentos.edfNumeroOrcamentoExit(Sender: TObject);
begin
  inherited;
  HabilitarControlesCliente(Trim(flkCliente.Text) = '');
end;

procedure TfrmOrcamentos.HabilitarControlesCliente(Valor: Boolean);
begin
  if Valor then
  begin
    edtNomeCliente.BringToFront;
    edtNomeCliente.tabstop := true;
    edtNomeCliente.enabled := true;
  end
  else
  begin
    edtNomeCliente.SendToBack;
    edtNomeCliente.tabstop := false;
    edtNomeCliente.enabled := false;
//    fracgcoucpf1.rgbTipoPessoa.SetFocus;

  end;
//fraCGCCPF.edtCPFCNPJ.Tipo      := dtmOrcamentos.TipoPessoa;

           {
  if ((Valor) and (dtmOrcamentos.qryOrcamentoscodigo.IsNull)) then
  begin
    edtDDD1  .Text := '';
    edtFone1 .Text := '';
    edtRamal1.Text := '';
    edtDDD2  .Text := '';
    edtFone2 .Text := '';
    edtRamal2.Text := '';
  end;
  edtDDD1.ReadOnly   := Not Valor;
  edtFone1.ReadOnly  := Not Valor;
  edtRamal1.ReadOnly := Not Valor;

  edtDDD2.ReadOnly   := Not Valor;
  edtFone2.ReadOnly  := Not Valor;
  edtRamal2.ReadOnly := Not Valor;
}


//  fraCGCCPF.rbnFisica.Enabled    := Valor;
//  fraCGCCPF.rbnJuridica.Enabled  := Valor;
//  fraCGCCPF.edtCPFCNPJ.ReadOnly  := Not Valor;

end;

function TfrmOrcamentos.InternoExcluir: Boolean;
var
  Cancelar: Boolean;
  Msg: String;
begin
  Result:= inherited InternoExcluir;
  if Result then
  begin
    if ParSistema.ExclusaoOrcamento = exoCANCELAR then
      Cancelar:= True
    else
    begin
      if ParSistema.ExclusaoOrcamento = exoPERGUNTAR then begin
        Cancelar:= MensagemConfirmacao(ctCANCELARORCAMENTO) = smbCANCEL;
        if not Cancelar then begin
          Msg    := Format(ctCONFIRMEEXCLUIR, ['o(s) orçamento(s)']);
          Result := MensagemConfirmacao(Msg) = smbOk;
        end
      end else
      begin
        Cancelar:= False;
        Msg    := Format(ctCONFIRMEEXCLUIR, ['o(s) orçamento(s)']);
        Result := MensagemConfirmacao(Msg) = smbOk;
      end
    end;

    if Result then
    begin
      if Cancelar then
      begin
        dtmOrcamentos.TextoCancelamento := '';
        dtmOrcamentos.Abre(ctTabelasConsultaMotivos);
        frmMotivos := TfrmMotivos.Create(frmMotivos, 'Cancelamentos do orçamento', dtmOrcamentos.TabelaConsultaMotivos, true, parsistema.ObrigarDigitacaoaoExcluir);
        Result:= frmMotivos.ShowModal = mrOK;
        dtmOrcamentos.TextoCancelamento := frmMotivos.mmoTexto.text;
        frmMotivos.free;
      end;
      if Result then
        Result := dtmOrcamentos.ExcluirOrcamento(Cancelar);
    end;
  end;

  if pgcOrcamento.ActivePageIndex <> 0 then
    pgcOrcamento.ActivePageIndex:= 0;

  if result then
    fraAtendimentosDocumentos1.AbrirTabelaAtendimentosDocumentos(true);

end;

function TfrmOrcamentos.InternoGravar: Boolean;
begin
  Result:= inherited InternoGravar;

  if Result then
  begin
    if flkCliente.Text <> '' then
      Result:= flkCliente.Exist;

    if result then
    begin

      if Result then
        Result:= dtmOrcamentos.GravarOrcamento;

      {
      if dtmOrcamentos.qryPlanosOrcamentos.IsEmpty then
         result := GerarParcelasPlanoPadrao;
      }

      {
      if PrecisaReCalcularParcelas then
      begin
        if dtmOrcamentos.PlanoPadraoClienteSemParcelas then
        begin
          ContornaChuncho := false;
          Result := GerarParcelasPlanoPadrao;
          PrecisaReCalcularParcelas := False;
          ContornaChuncho:=true;
        end;

      end;

      if PrecisaReCalcularParcelas then
      begin
        MensagemAviso(ctRECALCULARPARCELAS);
        Result := False;
      end
      }
    end;


    if pgcOrcamento.ActivePageIndex <> 0 then
      pgcOrcamento.ActivePageIndex:= 0;

    if Result then
      edtDesconto.Enabled:= True;

    if flkVendedor.canfocus then
      flkVendedor.setfocus;
//    flkCliente.SetFocus;
  end;
end;

function TfrmOrcamentos.InternoIncluir: Boolean;
begin
  Result := inherited InternoIncluir;
  if CtrlOn then
  begin
    if dbgProdutos.Focused then
    begin
      if dtmOrcamentos.PodeAlterarCampos then
           Result:= IncluirEditarProdutosOrcamento(False)
      else Result:= False;
    end
    else if pgcOrcamento.ActivePageIndex=1 then //dbgServicos.Focused then
    begin
      if dtmOrcamentos.PodeAlterarCampos then
        Result:= IncluirEditarServicosOrcamento(False)
      else
        Result:= False;
    end
  end
  else
  begin
    if pgcOrcamento.ActivePageIndex <> 0 then
      pgcOrcamento.ActivePageIndex:= 0;
    Result:= dtmOrcamentos.IncluirOrcamento;
    if Result then
    begin
      if UsuarioLogin.Vendedor then
           flkCliente.SetFocus
      else flkVendedor.SetFocus;
    end
    else edfNumeroOrcamento.SetFocus;
  end;
  edtDesconto.Enabled:= False;
end;

function TfrmOrcamentos.InternoPesquisar(Titulo: String): Integer;
begin
  Result:= mrNone;
  with dtmOrcamentos do begin
    if CtrlOn then begin
      if (ActiveControl = flkCliente) and dtmOrcamentos.PodeAlterarCampos then begin
        Titulo      := ctCLIENTES;
        TipoConsulta:= vocCLIENTES
      end else if (ActiveControl = flkVendedor) and dtmOrcamentos.PodeAlterarCampos and not flkVendedor.readonly then
      begin
        Titulo      := ctVENDEDORES;
        TipoConsulta:= vocVENDEDOR
      end
      else if (ActiveControl = flkFilialMontagem) and dtmOrcamentos.PodeAlterarCampos then begin
        Titulo:= ctFILIAIS;
        TipoConsulta:= vocFILIALMONTAGEM;
      end
      else TipoConsulta:= vocNENHUM;
    end else begin
      Titulo      := ctOrcamentos;
      TipoConsulta:= vocORCAMENTO;
    end;

    if TipoConsulta <> vocNENHUM then begin
      AbreTabelasOrcamento(TipoConsulta);
      Result := inherited InternoPesquisar(Titulo);
      if Result = mrOK then
        SelecionaTabelasOrcamento(TipoConsulta);
      FechaTabelasConsulta(TipoConsulta);

      if TipoConsulta = vocORCAMENTO then
        edfNumeroOrcamentoExit(nil);

    end;
  end;
end;

function TfrmOrcamentos.JanelaPesquisa: TfrmConsultaBasica;
begin
  Jan := TfrmConsultaPorCampo.Create(nil);
  Jan.ConsultaInterativa := not (TipoConsulta in [vocORCAMENTO, vocCLIENTES]);
  Result := Jan;
end;

