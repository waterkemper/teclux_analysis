procedure TfrmOrcamentos.sbnIncluirPlanoClick(Sender: TObject);
begin
  inherited;
  if dtmOrcamentos.PodeAlterarCampos then
  begin
    if (dtmOrcamentos.TotalProdutos + dtmOrcamentos.TotalServicos = 0) then
      MensagemAviso(ctORCAMENTO_PRODUTOSERVICO)
    else
    if (dtmOrcamentos.qryOrcamentossituacao.AsString = 'A') and (Not dtmOrcamentos.qryorcamentos.ReadOnly) then
    begin
//      if VerificarCreditoTroca(false,true) then
      begin
        ContornaChuncho := True;
        try
          CalcularFinanciamento;
        finally
          ContornaChuncho := False;
        end
      end;
    end;
  end;
end;

procedure TfrmOrcamentos.CalcularFinanciamento;
var
  Parcelas: TResumosParcelas;
  TotalCalcular: Currency;
  ValorPrazo,
  TaxaJuros,
  Desconto: Real;
  plano : integer;
  mensagem: String;

begin
  inherited;
  mensagem := '';
  Parcelas := nil;
  if (dtmOrcamentos.qryorcamentossituacao.AsString = 'A') and (not dtmOrcamentos.qryOrcamentos.ReadOnly) then
  begin

    frmCalculoFinanciamento := TfrmCalculoFinanciamento(TfrmCalculoFinanciamento.Referencia);
    if Assigned(frmCalculoFinanciamento) then
      frmCalculoFinanciamento.SetFocus
    else
    begin
      TotalCalcular:= dtmOrcamentos.TotalProdutos + dtmOrcamentos.TotalServicos;

      if ((dtmOrcamentos.TotalOrcamento - dtmOrcamentos.CreditoTroca)<>0) then
      begin
        dtmOrcamentos.ResumoParcelas(Parcelas);
        frmCalculoFinanciamento := TfrmCalculoFinanciamento.Create(Owner, True);
        frmCalculoFinanciamento.OntecClose    := OnCloseCalculoFinanciamento;
        frmCalculoFinanciamento.DefinirValoresCalculo(PrecisaReCalcularParcelas,
                                                    TotalCalcular,
                                                    dtmOrcamentos.Frete,
                                                    dtmOrcamentos.Seguro,
                                                    dtmOrcamentos.Desconto,
                                                    dtmorcamentos.CreditoTroca,
                                                    0,
                                                    dtmOrcamentos.PlanoUtilizado,
                                                    dtmOrcamentos.DataEmissao,
                                                    dtmOrcamentos.EstadoFilialBase,
                                                    Parcelas,
                                                    nil, //Grupos,
                                                    nil, //Classes,
                                                    dtmOrcamentos.PermiteDesconto,
                                                    0);
        Parcelas := nil;
      end
      else
      begin
        if (ParSistema.PlanoVendaVista = 0) then
          MensagemAviso(ctNENHUMPLANOVENDAAVISTA)
        else
        begin
          PrecisaReCalcularParcelas := false;
          valorprazo := 0;
          taxajuros := 0;
          desconto := 0;
          plano := ParSistema.PlanoVendaVista;
          dtmOrcamentos.DefinirParcelas(Parcelas, valorprazo, taxajuros, desconto, plano, true);

          {
          if ParSistema.PermitirAlterarBrindenoContrato then
            if dtmOrcamentos.FSomenteBrindes and (dtmCadastroContratos.ValorICMSSubstTributaria = 0) then
              mensagem := ctPRODUTOCONTRATOBRINDE;
          }

          if mensagem='' then
            Mensagem := ctSALDOCOBERTOPORCREDITO;

          MensagemAviso(mensagem)

        end;
      end;
    end;
  end;
end;

procedure TfrmOrcamentos.OnCloseCalculoFinanciamento;
begin
  LerValoresCalculoFinanciamento;
end;

procedure TfrmOrcamentos.LerValoresCalculoFinanciamento;
{
var
  Parcelas, ParcContr: TResumosParcelas;
  ValorPrazo,
  TaxaJuros,
  Desconto: Real;
  Plano: Integer;
begin
  inherited;
  Plano:= 0;
  if not ContornaChuncho then begin
    frmCalculoFinanciamento := TfrmCalculoFinanciamento(TfrmCalculoFinanciamento.Referencia);
    if Assigned(frmCalculoFinanciamento) and
       frmCalculoFinanciamento.ResumosParcelas(Parcelas, ValorPrazo, TaxaJuros, Desconto, Plano)
    then begin
      dtmOrcamentos.ResumoParcelas(ParcContr);
      if Not ParcelasIdenticas(Parcelas, ParcContr) then begin
        dtmOrcamentos.DefinirParcelas(Parcelas, ValorPrazo, TaxaJuros, Desconto, Plano);
        PrecisaReCalcularParcelas := Plano = 0;
      end;
      Parcelas  := nil;
      ParcContr := nil;
    end
  end
end;

}

var
  Parcelas, ParcContr: TResumosParcelas;
  ValorPrazo,
  TaxaJuros,
  Desconto: Real;
  Plano: Integer;
begin
  inherited;
  if Not ContornaChuncho then
  begin
    frmCalculoFinanciamento := TfrmCalculoFinanciamento(TfrmCalculoFinanciamento.Referencia);
    Parcelas := nil;  ParcContr := nil;
    if dtmOrcamentos.PlanoPadraoClienteSemParcelas then
      plano := dtmOrcamentos.ClientePlanoPadrao
    else
      plano := 0;

    if Assigned(frmCalculoFinanciamento) and
       frmCalculoFinanciamento.ResumosParcelas(Parcelas, ValorPrazo, TaxaJuros, Desconto, Plano)
    then begin
      dtmOrcamentos.ResumoParcelas(ParcContr);
      if Not ParcelasIdenticas(Parcelas, ParcContr) or
        (dtmOrcamentos.CreditoTroca > 0) or
        PrecisaReCalcularParcelas  then
      begin
//      and (MensagemConfirmacao('Deseja alterar as parcelas do contrato?') = smbOK)
//      then begin
        dtmOrcamentos.DefinirParcelas(Parcelas, ValorPrazo, TaxaJuros, Desconto, Plano, true);
        PrecisaReCalcularParcelas := Plano = 0;
      end
      else
        PrecisaReCalcularParcelas := false;
      Parcelas  := nil;
      ParcContr := nil;
    end
  end
end;


procedure TfrmOrcamentos.Activate;
begin
  inherited;
  LerValoresCalculoFinanciamento;
end;

