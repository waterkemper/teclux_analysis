procedure TfrmOrcamentos.sbnEnviarOrcamentoClick(Sender: TObject);
begin
  inherited;
  frmEnviarEmail:= TfrmEnviarEmail.Create(frmEnviarEmail,ParSistema.Host, ParSistema.EmailEmpresa,'','Orçamento');

  try
    with frmEnviarEmail do
    begin
      Data   := dtmOrcamentos.DataServidor;
      Empresa:= PrimeiraLetraEmMaiuscula(dtmOrcamentos.NomeFilialBase);
      Msg    := dtmOrcamentos.MontarOrcamento;
      ObterAutorizacao := dtmOrcamentos.obterautorizacao_;
      vGerarAtendimento := true;
      OrigemEmail := Orcamento;
      ShowModal;

      if enviou then
      begin
        if parsistema.usaiteclux then
          dtmOrcamentos.GravarEmailOrcamento(mmoIntroducao.text, mmoConclusao.text, edtEmail.Text);

        with dtmOrcamentos do
        begin
          IncluirAtendimento_(
            qryOrcamentoscodigo.AsInteger,
            qryOrcamentoscliente.AsInteger,
            qryOrcamentostipocliente.AsString,
            EmailEnviado,
            'Orçamento '+ qryOrcamentoscodigo.AsString + ifthen(parsistema.usaiteclux,' envio de email agendado ', ' enviado para o email '+edtEmail.text) + chr(13) +
                          mmoIntroducao.text + char(13) +
                          mmotexto.text + char(13) +
                          mmoConclusao.text,
             nil,
            qryOrcamentosdescricaosituacao.asString
          );
        end;
      end;
    end;
  finally
    frmEnviarEmail.Free;
    fraAtendimentosDocumentos1.AbrirTabelaAtendimentosDocumentos(true);
  end;
  edfNumeroOrcamento.SetFocus;
end;

procedure TfrmOrcamentos.GravarLinhas;
var Contador: Integer; 
begin
 with dtmOrcamentos do begin
    qryProdutosOrcamentos.DisableControls;
    Contador:= 1;
    qryProdutosOrcamentos.First;
    while Not qryProdutosOrcamentos.Eof do begin
      qryProdutosOrcamentos.Edit;
      qryProdutosOrcamentosNumero.AsInteger := Contador;
      qryProdutosOrcamentos.Post;
      Inc(Contador);
      qryProdutosOrcamentos.Next;
    end;
    qryProdutosOrcamentos.EnableControls;
    qryProdutosOrcamentos.First;
  end;
end;

procedure TfrmOrcamentos.actHabilitarUpdate(Sender: TObject);
begin
  inherited;
  sbnExcluir.Enabled     := (dtmOrcamentos.Situacao = 'A');
  sbnIncluirPlano.Enabled:= dtmOrcamentos.HabilitarPlanos;
  sbnExcluirPlano.Enabled:= dtmOrcamentos.HabilitarPlanos;
  sbnCopia.Enabled       := not sbnSalvar.Enabled and dtmOrcamentos.HabilitarPlanos;
  sbnImprimir.Enabled    := not sbnSalvar.Enabled;
  sbnContrato.Enabled    := not sbnSalvar.Enabled and (dtmOrcamentos.Situacao = 'A');
  sbnEnviarOrcamento.Enabled  := (dtmOrcamentos.Situacao='A') and not sbnSalvar.Enabled;

  dtxCancelamento.Visible:= dtmOrcamentos.OrcamentoCancelado;
  dtxContrato.Visible    := not dtmOrcamentos.qryorcamentoscontrato.isnull;
  lblContrato.Visible    := dtxContrato.Visible;
  dtxMotivo.Visible      := dtmOrcamentos.OrcamentoCancelado;
  lblMotivo.Visible      := dtmOrcamentos.OrcamentoCancelado;

  sbnAtendimento.Enabled :=    (dtmOrcamentos.qryOrcamentoscodigo.asinteger <> 0) and
                               (dtmOrcamentos.qryorcamentossituacao.asString ='A') and
                               ((dtmOrcamentos.qryorcamentoscliente.asinteger <> 0) or
                                (trim(dtmOrcamentos.qryOrcamentosnome.asString) <> ''));

end;

procedure TfrmOrcamentos.edtNomeClienteExit(Sender: TObject);
begin
  inherited;
  dtmOrcamentos.qryProcuraClienteAfterOpen(dtmOrcamentos.qryProcuraCliente);

{
  if (dtmOrcamentos.qryOrcamentosnome.asstring <> '') and sbnIncluirProduto.Enabled then
    sbnIncluirProdutoClick(nil);
 }

end;

procedure TfrmOrcamentos.SelecionarOrcamento(Orcamento: String);
begin
  dtmOrcamentos.RefazConsultaOrcamento(Orcamento);
end;

procedure TfrmOrcamentos.OperacaoPadrao(Value: array of Variant);
begin
  inherited;
  if Length(Value) > 0 then
  begin
    if Value[0] = 'Open' then
    begin
      dtmOrcamentos.RefazConsultaOrcamento(Value[1]);
      dtmOrcamentos.RecalcularPlanoOrcamentoPadrao;
      edfNumeroOrcamento.SetFocus;
    end
    else
    if Value[0] = 'Insert' then
    begin
      CtrlOn := false;
      InternoIncluir;
      dtmOrcamentos.qryProcuraCliente.parambyname('codigo').asString := VarToStr(Value[2]);
      dtmOrcamentos.qryProcuraCliente.parambyname('tipo').asString := VarToStr(Value[3]);
      flkcliente.Text := VarToStr(Value[2]);
      flkCliente.exist;
    end;

  end;

end;

procedure TfrmOrcamentos.sbnVisualizarSaldoTrocaClick(Sender: TObject);
begin
  inherited;
  edtSaldoTrocaEnter(self);
  if ParSistema.utilizarcreditotrocacontrato then
  begin
    frmVisualizarSaldoTroca := TfrmVisualizarSaldoTroca.Create(frmVisualizarSaldoTroca,
                               dtmOrcamentos.TabelaSaldoCredito,
                               dtmOrcamentos.TabelaSaldoCreditoAtual);
    frmVisualizarSaldoTroca.ShowModal;
    if frmVisualizarSaldoTroca.ModalResult = mrOK then
    begin
      if (dtmOrcamentos.qryorcamentossituacao.asString = 'A') then
      begin
        if dtmOrcamentos.CreditoTroca <> dtmOrcamentos.SaldoCreditoAtual then
        begin
          dtmOrcamentos.SugerirCreditoTroca(false,true);
//          dtmOrcamentos.CalcularValorAVista;
//          PrecisaReCalcularParcelas := true;
        end;
      end;
    end;
    frmVisualizarSaldoTroca.Free;
    Application.BringToFront;
  end;

end;

procedure TfrmOrcamentos.edtSaldoTrocaEnter(Sender: TObject);
begin
  inherited;
  dtmOrcamentos.CreditoTrocaAnt := dtmOrcamentos.CreditoTroca;
end;

function TfrmOrcamentos.VerificarCreditoTroca(zerar,
  Atribuir: Boolean): Boolean;
begin
  result := true;
  if ParSistema.utilizarcreditotrocacontrato then
  begin
    dtmOrcamentos.AbrirDadosCreditoCliente;
    if dtmOrcamentos.ValidarCreditoTroca then
    begin
      if ((dtmOrcamentos.SaldoCreditoAtual<>0) and
          (dtmOrcamentos.CreditoTroca=0)) or
         ((dtmOrcamentos.SaldoCreditoAtual>0) and
          (dtmOrcamentos.CreditoTroca<dtmOrcamentos.SaldoCreditoAtual) and
          (dtmOrcamentos.CreditoTroca<dtmOrcamentos.TotalOrcamento)) then
      begin
        if dtmOrcamentos.SugerirCreditoTroca(true,atribuir) then
        begin
          edtSaldoTroca.SetFocus;
          result := atribuir;
        end
      end;
    end
    else
    begin
      if zerar then
        edtSaldoTroca.text := FormatarValor(0,2);
      edtSaldoTroca.SetFocus;
      result := false;
    end;
  end;
end;

function TfrmOrcamentos.GerarParcelasPlanoPadrao: Boolean;
begin
  result := false;
//  if VerificarCreditoTroca(false,true) then
  begin
    CalcularFinanciamento;
    Result := frmCalculoFinanciamento.calcularPlanoPadrao(dtmOrcamentos.ClientePlanoPadrao);
  end;
end;

