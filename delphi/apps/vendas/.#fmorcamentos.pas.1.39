procedure TfrmOrcamentos.OnScrollClientes(Sender: TObject);
begin
  fraDadosLoginSite1.AbrirTabelaCliente_Site(true);
  fraAtendimentosDocumentos1.AbrirTabelaAtendimentosDocumentos(true);
end;

procedure TfrmOrcamentos.sbnAtendimentoClick(Sender: TObject);
begin
  inherited;
  if dtmOrcamentos.qryOrcamentoscliente.AsInteger = 0 then
  begin
    dtmOrcamentos.CriarNovoCliente(true);
    dtmOrcamentos.AtribuirClientenoOrcamento;

  end;

  TfrmPrincipalBasico(Application.MainForm).MostrarFormRegistrado(['IncluirFollowupOrcamento',
                                                                   dtmOrcamentos.qryOrcamentoscliente.asinteger,
                                                                   dtmOrcamentos.qryOrcamentostipocliente.asString,
                                                                   'O',
                                                                   dtmorcamentos.Getorcamento,
                                                                   '',
                                                                   dtmorcamentos.qryOrcamentosdescricaosituacao.asString
                                                                   ],
                                                                   'TfrmCadastroAtendimento', True);
  vReabirAtendimentosPendente := true;

end;

procedure TfrmOrcamentos.FormActivate(Sender: TObject);
begin
  inherited;
  if vReabirAtendimentosPendente then
    fraAtendimentosDocumentos1.AbrirTabelaAtendimentosDocumentos(true);
    
end;

