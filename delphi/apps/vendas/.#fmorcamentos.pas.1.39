procedure TfrmOrcamentos.sbnCopiaClick(Sender: TObject);
begin
  inherited;
  dtmOrcamentos.GerarCopiaOrcamento;
  if pgcOrcamento.ActivePageIndex <> 0 then
    pgcOrcamento.ActivePageIndex:= 0;
  dbgPlanos.SetFocus;  
end;

procedure TfrmOrcamentos.KeyDown(var Key: Word; Shift: TShiftState);
begin
  inherited;
  if Shift = [] then
  begin
    case key of
      VK_SPACE: if (Shift = [ssCtrl]) and dbgPlanos.Focused and
                  not dtmOrcamentos.TabelaOrcamentoBloqueada then
                  dtmOrcamentos.SelecionarPlano;
      VK_F7: if not CtrlOn and sbnContrato.Enabled then
                 sbnContrato.Click;
      VK_F8: if not CtrlOn and sbnCopia.Enabled then
                 sbnCopia.Click;
      VK_F10: if not CtrlOn and sbnAtendimento.Enabled then
              begin
                 key := 0;
                 sbnAtendimento.click;
              end;
      VK_F11: if not CtrlOn and sbnImprimir.Enabled then
                 sbnImprimir.Click;
      VK_F12: if sbnEnviarOrcamento.Enabled then
                      sbnEnviarOrcamentoClick(nil);
    end
  end
  else
  if Shift = [ssCtrl] then
  begin
    if Key = VK_P then
      sbnIncluirPlanoClick(nil)
//      sbnParcelasClick(nil)
    else if Key = VK_T then
      sbnVisualizarSaldoTrocaClick(nil)
    else if Key = VK_O then
    begin
      pgcOrcamento.ActivePage:=tstProdutos;
      if(dbgProdutos.Enabled) then
      begin
        dbgProdutos.SetFocus;
        IncluirEditarProdutosOrcamento(False);
      end;
    end;
  end;

end;

