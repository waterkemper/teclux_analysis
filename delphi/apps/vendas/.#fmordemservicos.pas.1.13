end;

procedure TfrmOrdemServico.sbnParcelasClick(Sender: TObject);
begin
  inherited;
  if (dtmOrdemServico.TotalOrdemServico = 0) then
    MensagemAviso('Faz-se necessário a inclusão de um produto ou serviço antes de calcular as parcelas.')
  else if (dtmOrdemServico.SituacaoOrdemServico < scFATURADO) and (Not dtmOrdemServico.ReadOnly) then
  begin
    pgcOrdemServico.ActivePage := tstPlanodePagamento;
    if dbgParcelas.CanFocus then
      dbgParcelas.SetFocus;
    ContornaChuncho := True;
    try
      CalcularFinanciamento;
    finally
      ContornaChuncho := False;
    end
  end
end;

procedure TfrmOrdemServico.dbgServicosKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
    case Key of
    TeclaEditarRegistro : if dtmOrdemServico.PodeAlterarCampos then
                            IncluirEditarServicosOrdemServico(True);
    end;
end;

procedure TfrmOrdemServico.CalcularFinanciamento;
var
  Parcelas: TResumosParcelas;
  TotalCalcular: Currency;
//  x: vString;
begin
  inherited;
  Parcelas := nil;
//  x:= nil;
  if ((dtmOrdemServico.Situacao='O') or (dtmOrdemServico.Situacao='R')) and (not dtmOrdemServico.ReadOnly) then begin
    frmCalculoFinanciamento := TfrmCalculoFinanciamento(TfrmCalculoFinanciamento.Referencia);
    if Assigned(frmCalculoFinanciamento) then
      frmCalculoFinanciamento.SetFocus
    else
    begin
      dtmOrdemServico.EditarOrdemServico;
      TotalCalcular:= dtmOrdemServico.TotalOrdemServico;
      dtmOrdemServico.ResumoParcelas(Parcelas);
      frmCalculoFinanciamento := TfrmCalculoFinanciamento.Create(Owner, True);
      frmCalculoFinanciamento.OntecClose    := OnCloseCalculoFinanciamento;
      frmCalculoFinanciamento.DefinirValoresCalculo(PrecisaReCalcularParcelas,
                                                    TotalCalcular,
                                                    0,
                                                    0,
                                                    0,
                                                    0,
						    0,
                                                    dtmOrdemServico.PlanoUtilizado,
                                                    dtmOrdemServico.DataAbertura,
                                                    dtmordemservico.EstadoFilialBase,
                                                    Parcelas,
                                                    nil, //Grupos
                                                    nil, //Classes
                                                    true,
                                                    0);
      Parcelas := nil;
    end;
  end;
end;

procedure TfrmOrdemServico.LerValoresCalculoFinanciamento;
var
  Parcelas, ParcContr: TResumosParcelas;
  ValorPrazo,
  TaxaJuros,
  Desconto: Real;
  Plano: Integer;
begin
  inherited;
  Plano := 0;
  if Not ContornaChuncho then begin
    frmCalculoFinanciamento := TfrmCalculoFinanciamento(TfrmCalculoFinanciamento.Referencia);
    if Assigned(frmCalculoFinanciamento) and
       frmCalculoFinanciamento.ResumosParcelas(Parcelas, ValorPrazo, TaxaJuros, Desconto, Plano)
    then begin
      dtmOrdemServico.ResumoParcelas(ParcContr);
      if Not ParcelasIdenticas(Parcelas, ParcContr) then begin
//      and (MensagemConfirmacao('Deseja alterar as parcelas do contrato?') = smbOK)
//      then begin
        dtmOrdemServico.DefinirParcelas(Parcelas, ValorPrazo, TaxaJuros, Desconto, Plano);
        PrecisaReCalcularParcelas := Plano = 0;
      end;
      Parcelas  := nil;
      ParcContr := nil;
    end
  end
end;

procedure TfrmOrdemServico.OnActivateCalculoFinanciamento(var Calcular: Boolean;
  var Mercadoria, Frete, Seguro, DescontoContrato: Currency; var Plano: Integer;
  var Parcelas: TResumosParcelas; var Grupos: vstring);
begin
  Calcular         := false;
  Mercadoria       := dtmOrdemServico.TotalOrdemServico;
  Frete            := 0;
  Seguro           := 0;
  DescontoContrato := 0;//dtmOrdemServico.DescontoContrato;
  Plano            := dtmOrdemServico.PlanoUtilizado;
  Grupos           := nil;
  dtmOrdemServico.ResumoParcelas(Parcelas);
end;

procedure TfrmOrdemServico.OnCloseCalculoFinanciamento;
begin
  LerValoresCalculoFinanciamento;
end;

procedure TfrmOrdemServico.FormActivate(Sender: TObject);

begin
  inherited;
  LerValoresCalculoFinanciamento
end;

procedure TfrmOrdemServico.FormKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  inherited;
  if Shift = [ssCtrl] then
  begin
     if Key = VK_P then
         sbnParcelasClick(nil);
  end
  else if Shift = [] then
  begin
    case Key of
      VK_ESCAPE: AlterarEstadoBotoes;
      VK_F7    : if sbnImprimirOrdemServico.Enabled then
                    sbnImprimirOrdemServicoClick(nil);
      VK_F8    : if sbnImprimirRequisicao.Enabled then
                    sbnImprimirRequisicaoClick(nil);
      VK_F11   : if sbnAlterarSituacao.Enabled then
                    sbnAlterarSituacaoClick(nil);
      end;
  end;

end;

