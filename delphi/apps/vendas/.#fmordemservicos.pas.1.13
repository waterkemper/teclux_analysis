function TfrmOrdemServico.IncluirEquipamentosOS: boolean;
begin

end;

procedure TfrmOrdemServico.AcionaCadastroEquipamentosClientes(
  Editar: Boolean);
begin
  if (dtmordemservico.qryOrdemServicocliente.AsInteger <> 0) then
  begin
    frmCadastroEquipamentos:= TfrmCadastroEquipamentos.Create(frmCadastroEquipamentos);
    with frmCadastroEquipamentos do
    begin
     FecharaoGravar := true;
     DataSet:= dtmCadastroEquipamentos.qryEquipamentos;
     SetDataModulo(dtmCadastroEquipamentos);
     dtmCadastroEquipamentos.IncluirEquipamento(Editar);
     ShowModal;
     frmCadastroEquipamentos.free;
     //edtDescricao.SetFocus;
     Application.BringToFront;
     if frmCadastroEquipamentos.ModalResult = mrOK then
       dtmordemservico.AtribuirEquipamento;
    end;
  end
  else
    MensagemAviso('O cliente deve ser cadastrado antes!');
end;

procedure TfrmOrdemServico.rbpTipoLenteClick(Sender: TObject);
begin
  inherited;
with dtmordemservico do
  begin
    if not ReadOnly then
    begin
      if not (qryReceitaOculos.State in [dsedit,dsinsert]) then
         qryReceitaOculos.Edit;
      if not (qryOrdemServico.State in [dsedit, dsinsert]) then
          qryOrdemServico.Edit;
    end;
  end;
end;

procedure TfrmOrdemServico.AtualizaEquipamentosCliente;
var
  cliente: integer;
begin
  if ParSistema.ContratoComServico then
  begin
    if dtmordemservico.qryClientescodigo.AsInteger > 0 then
      cliente:= dtmordemservico.qryClientescodigo.AsInteger
    else
      cliente:=0;
    dtmCadastroEquipamentos.RefazConsultaEquipamentosClientes(cliente);
    dtmCadastroEquipamentos.Cliente:= dtmordemservico.qryClientescodigo.AsInteger;
    dtmCadastroEquipamentos.TabelaClientes:= dtmordemservico.qryClientes;
  end;
end;

procedure TfrmOrdemServico.ClientesAfterClose(Sender: TObject);
begin
  if (ParSistema.ContratoComServico) then
    dtmCadastroEquipamentos.FechaEquipamentosCliente;
end;

procedure TfrmOrdemServico.ClientesAfterPost(Sender: TObject);
begin
  if(ParSistema.ContratoComServico) then
    AtualizaEquipamentosCliente;
end;

procedure TfrmOrdemServico.ClientesOnScroll(Sender: TObject);
begin
  if(ParSistema.ContratoComServico) then
    AtualizaEquipamentosCliente;
end;

procedure TfrmOrdemServico.sbnIncluirEquipamentosClick(Sender: TObject);
begin
  inherited;
    AcionaCadastroEquipamentosClientes(False)
end;

function TfrmOrdemServico.GerarParcelasPlanoPadrao: Boolean;
begin
  CalcularFinanciamento;
  Result := frmCalculoFinanciamento.calcularPlanoPadrao(dtmordemservico.ClientePlanoPadrao);
end;

function TfrmOrdemServico.GerarParcelasVendaaVista: Boolean;
begin
  CalcularFinanciamento;
end;
procedure TfrmOrdemServico.dbgServicosDblClick(Sender: TObject);
begin
  inherited;
  if dtmOrdemServico.PodeAlterarCampos then
    IncluirEditarServicosOrdemServico(true)

end;

procedure TfrmOrdemServico.ReservarOrdemServico;
begin
  if MensagemConfirmacao(ctCONFIRMERESERVA) = smbOK then
  begin
    dtmordemservico.SituacaoOrdemServico := scRESERVADO;
    InternoGravar;
  end
end;

procedure TfrmOrdemServico.dbgProdutosDrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  inherited;
  if datacol <> 1 then
  begin
    if (dtmordemservico.QtdadeProdutos > 0) and (dtmordemservico.SituacaoOrdemServico > scRESERVADO) then begin
      if dtmordemservico.ProdutoCancelado then
      begin
        TDBGrid(Sender).Canvas.Brush.Color := clYellow;
        TDBGrid(Sender).Canvas.Font.Color := clBlack;
      end else if dtmordemservico.ProdutoNotaEmitida then
      begin
        TDBGrid(Sender).Canvas.Brush.Color := $007FAA55;
        TDBGrid(Sender).Canvas.Font.Color := clBlack;
      end else if dtmordemservico.IncluirNaNotaFiscal then
      begin
        TDBGrid(Sender).Canvas.Brush.Color := $00FFAA00;
        TDBGrid(Sender).Canvas.Font.Color := clBlack;
      end
    end;
    if (dtmordemservico.QtdadeProdutos > 0) and (dtmordemservico.SituacaoOrdemServico <= scRESERVADO) then begin
      if dtmordemservico.MarcarProdutoCopiar then
      begin
        TDBGrid(Sender).Canvas.Brush.Color := $000055FF;
        TDBGrid(Sender).Canvas.Font.Color := clBlack;
      end;
    end;
    TDBGrid(Sender).Canvas.Font.Style := [];
    TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
  end
  else
  begin
    if dbgProdutos.DataSource.DataSet.FieldByName('situacao_produto').AsString = 'A' then
      TDBGrid(Sender).Canvas.Font.Color := clGreen
    else
    if dbgProdutos.DataSource.DataSet.FieldByName('situacao_produto').AsString = 'P' then
      TDBGrid(Sender).Canvas.Font.Color := $000080FF
    else
    if dbgProdutos.DataSource.DataSet.FieldByName('situacao_produto').AsString = 'N' then
      TDBGrid(Sender).Canvas.Font.Color := clRed;

    TDBGrid(Sender).Canvas.Font.Style := [fsBold];
   TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
  end;

end;

end.
