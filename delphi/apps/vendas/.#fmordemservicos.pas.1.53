procedure TfrmOrdemServico.sbnParcelasClick(Sender: TObject);
begin
  inherited;
  if (dtmOrdemServico.TotalOrdemServico = 0) then
    MensagemAviso('Faz-se necessário a inclusão de um produto ou serviço antes de calcular as parcelas.')
  else if (dtmOrdemServico.SituacaoOrdemServico < scFATURADO) and (Not dtmOrdemServico.ReadOnly) then
  begin
    pgcOrdemServico.ActivePage := tstPlanodePagamento;


    if VerificarCreditoTroca(false,true) then
    begin
      if dbgParcelas.CanFocus then
        dbgParcelas.SetFocus;
      ContornaChuncho := True;
      try
        CalcularFinanciamento;
      finally
        ContornaChuncho := False;
      end
    end;




  end
end;

