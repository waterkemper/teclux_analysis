procedure TfrmOrdemServico.flkCodigoClienteEnter(Sender: TObject);
begin
  inherited;
  CodClienteAnt  := dtmOrdemServico.CodigoCliente;
  TipoClienteAnt := dtmOrdemServico.TipoCliente;
end;

procedure TfrmOrdemServico.flkCodigoClienteExit(Sender: TObject);
begin
  inherited;
  if Not Gravando and
    ((CodClienteAnt <> dtmOrdemServico.CodigoCliente) or
    (TipoClienteAnt <> dtmOrdemServico.TipoCliente)) and
    not UsuarioLogin.RestringirFichaCliente          and
    dtmOrdemServico.ClienteAtrasado
  then
    if MensagemConfirmacao(format(ctCLIENTEPOSSUIATRASO,[dtmOrdemServico.NomeCliente, 'parcelas em atraso'])) = smbOK then
      TfrmPrincipalBasico(Application.MainForm).MostrarFormRegistrado([dtmOrdemServico.CodigoCliente,
                                                                       dtmOrdemServico.TipoCliente], 'TfrmFichaFinanceira', True);

  dtmOrdemServico.AlertarAtualizacaoCadastroCliente(
  dtmOrdemServico.CodigoCliente,
  dtmOrdemServico.TipoCliente);



  if (dtmOrdemServico.TotalOrdemServico<>0) and
     (dtmordemservico.SituacaoOrdemServico < scFATURADO) then
   if not VerificarCreditoTroca(true,true) then
     PrecisaReCalcularParcelasOrdemServico := true;


end;

