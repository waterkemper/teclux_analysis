procedure TfrmOrdemServico.CalcularFinanciamento;
var
  Parcelas: TResumosParcelas;
  TotalCalcular: Currency;
  ValorPrazo,
  TaxaJuros,
  Desconto: Real;
  plano : integer;
  mensagem: String;

begin
  inherited;
  Parcelas := nil;
//  x:= nil;
  if ((dtmOrdemServico.Situacao='O') or (dtmOrdemServico.Situacao='R')) and (not dtmOrdemServico.ReadOnly) then begin
    frmCalculoFinanciamento := TfrmCalculoFinanciamento(TfrmCalculoFinanciamento.Referencia);
    if Assigned(frmCalculoFinanciamento) then
      frmCalculoFinanciamento.SetFocus
    else
    begin
      dtmOrdemServico.EditarOrdemServico;
      TotalCalcular:= dtmOrdemServico.TotalOrdemServico;

      if ((dtmordemservico.TotalOrdemServico - dtmordemservico.CreditoTroca)<>0) then
      begin

        dtmOrdemServico.ResumoParcelas(Parcelas);
        frmCalculoFinanciamento := TfrmCalculoFinanciamento.Create(Owner, True);
        frmCalculoFinanciamento.OntecClose    := OnCloseCalculoFinanciamento;
        frmCalculoFinanciamento.DefinirValoresCalculo(PrecisaReCalcularParcelasOrdemServico,
                                                    TotalCalcular,
                                                    0,
                                                    0,
                                                    0,
                                                    dtmordemservico.CreditoTroca,
						    0,
                                                    dtmOrdemServico.PlanoUtilizado,
                                                    dtmOrdemServico.DataAbertura,
                                                    dtmordemservico.EstadoFilialBase,
                                                    Parcelas,
                                                    nil, //Grupos
                                                    nil, //Classes
                                                    dtmordemservico.PermiteDesconto,
                                                    0);


        Parcelas := nil;
      end
      else
      begin

        if (ParSistema.PlanoVendaVista = 0) then
          MensagemAviso(ctNENHUMPLANOVENDAAVISTA)
        else
        begin
          PrecisaReCalcularParcelasOrdemServico := false;
          valorprazo := 0;
          taxajuros := 0;
          desconto := 0;
          plano := ParSistema.PlanoVendaVista;
          dtmordemservico.DefinirParcelas(Parcelas, valorprazo, taxajuros, desconto, plano);

          {
          if ParSistema.PermitirAlterarBrindenoContrato then
            if dtmordemservico.FSomenteBrindes and (dtmordemservico.ValorICMSSubstTributaria = 0) then
              mensagem := ctPRODUTOCONTRATOBRINDE;
          }

          if mensagem='' then
            Mensagem := ctSALDOCOBERTOPORCREDITO;

          MensagemAviso(mensagem)

        end;

      end;
    end;
  end;
end;

procedure TfrmOrdemServico.LerValoresCalculoFinanciamento;
var
  Parcelas, ParcContr: TResumosParcelas;
  ValorPrazo,
  TaxaJuros,
  Desconto: Real;
  Plano: Integer;
begin
  inherited;
  Plano := 0;
  if Not ContornaChuncho then begin
    frmCalculoFinanciamento := TfrmCalculoFinanciamento(TfrmCalculoFinanciamento.Referencia);
    if Assigned(frmCalculoFinanciamento) and
       frmCalculoFinanciamento.ResumosParcelas(Parcelas, ValorPrazo, TaxaJuros, Desconto, Plano)
    then begin
      dtmOrdemServico.ResumoParcelas(ParcContr);

      if Not ParcelasIdenticas(Parcelas, ParcContr) or
        (Desconto <> dtmordemservico.qryOrdemServicodesconto.AsCurrency) or
        (dtmordemservico.CreditoTroca > 0) or
        PrecisaReCalcularParcelasOrdemServico  then
      begin
        dtmOrdemServico.DefinirParcelas(Parcelas, ValorPrazo, TaxaJuros, Desconto, Plano);
        PrecisaReCalcularParcelasOrdemServico := Plano = 0;
      end;

      Parcelas  := nil;
      ParcContr := nil;
    end
  end
end;

procedure TfrmOrdemServico.OnActivateCalculoFinanciamento(var Calcular: Boolean;
  var Mercadoria, Frete, Seguro, DescontoContrato: Currency; var Plano: Integer;
  var Parcelas: TResumosParcelas; var Grupos: vstring);
begin
  Calcular         := false;
  Mercadoria       := dtmOrdemServico.TotalOrdemServico;
  Frete            := 0;
  Seguro           := 0;
  DescontoContrato := 0;//dtmOrdemServico.DescontoContrato;
  Plano            := dtmOrdemServico.PlanoUtilizado;
  Grupos           := nil;
  dtmOrdemServico.ResumoParcelas(Parcelas);
end;

procedure TfrmOrdemServico.OnCloseCalculoFinanciamento;
begin
  LerValoresCalculoFinanciamento;
end;

procedure TfrmOrdemServico.FormActivate(Sender: TObject);

begin
  inherited;
  LerValoresCalculoFinanciamento;

  if vReabirAtendimentosPendente then
    fraAtendimentosDocumentos1.AbrirTabelaAtendimentosDocumentos(true);

end;

procedure TfrmOrdemServico.FormKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  inherited;
  if Shift = [ssCtrl] then
  begin
     if Key = VK_P then
       sbnParcelasClick(nil)
     else
     if key = VK_T then
       sbnVisualizarSaldoTrocaClick(nil);
  end
  else if Shift = [] then
  begin
    case Key of
      VK_ESCAPE: AlterarEstadoBotoes;
      VK_F4   : begin
                    key :=0;
                    if sbnImprimirRequisicao.Enabled then
                      sbnImprimirRequisicaoClick(nil);
                end;
      VK_F7   : if sbnImprimirOrdemServico.Enabled then
                    sbnImprimirOrdemServicoClick(nil);

      VK_F8   : if sbnCopiarContrato.Enabled then
                sbnCopiarContratoClick(nil);

      VK_F10  : if not CtrlOn and sbnAtendimento.Enabled then
                begin
                  key := 0;
                  sbnAtendimento.click;
                end;

      VK_F11  : if sbnAlterarSituacao.Enabled then
                    sbnAlterarSituacaoClick(nil);
      VK_F12  : if sbnEnviarOrcamento.Enabled then
                 sbnEnviarOrcamentoClick(nil);

      VK_Return : begin

                    if (ActiveControl = edtSaldoTroca) then
                    begin
                      with dtmordemservico do
                      begin
                        if (edtSaldoTroca.ValorSemFormatacao>CreditoTrocaAnt) or
                           (edtSaldoTroca.ValorSemFormatacao>TotalordemServico) then
                        begin
                          CreditoTroca := edtSaldoTroca.ValorSemFormatacao;
                          if not ValidarCreditoTroca then
                          begin
                            Key:= 0;
                            creditotroca := CreditoTrocaAnt;
                            edtSaldoTroca.SetFocus;
                            edtsaldotroca.SelectAll;
                          end;
                        end;
                      end;
                    end;
                  end;
      end;
  end;

end;

