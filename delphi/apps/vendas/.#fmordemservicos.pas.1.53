{$R *.dfm}

{ TfrmOrdemServico }

constructor TfrmOrdemServico.Create(AOwner: TComponent);

{
var
  CollItem: TtecControlItem;
  }

begin
  dtmOrdemServico := TdtmOrdemServico.Create(Self, False);
//  if(ParSistema.ContratoComServico) then
//  dtmCadastroEquipamentos:= TdtmCadastroEquipamentos.Create(Self);
  inherited;
  //dtmOrdemServico.OnComplementarNota := ComplementarNota;
  dtmOrdemServico.Abre(ctVendaOrdemServico);
  DataSet := dtmOrdemServico.TabelaOrdemServico;
  dtmordemservico.OnScrollClientes:= ClientesOnScroll;
  dtmordemservico.AfterPostClientes:= ClientesAfterPost;
  dtmordemservico.AfterCloseClientes:=ClientesAfterClose;
  dtmordemservico.afterpostTipoEquipamento := afterpostTipoEquipamento;
//  dtmOrdemServico.VendedorDefault:=UsuarioLogin.CodigoUsuario;

  if UsuarioLogin.Vendedor then
  begin
//    CollItem := TtecControlItem(edfNumeroContrato.NoSetControls.Add);
//    CollItem.Control := flkVendedor;
    dtmordemservico.VendedorDefault := UsuarioLogin.CodigoUsuario;
    fraConsultaVendedor.dtxDescricao.width := fraConsultaVendedor.dtxDescricao.width +
                                        fraConsultaVendedor.dtxDescricao.left;
//    dtxNomeVendedor.Width := dtxNomeVendedor.Width + dtxNomeVendedor.Left - flkVendedor.Left;
    fraConsultaVendedor.dtxDescricao.left := fraConsultaVendedor.edfCodigo.Left;
    fraConsultaVendedor.dtxDescricao.BringToFront;
  end;


  pgcOrdemServico.ActivePage:= tstProdutos;
  if dtmOrdemServico.TipoEquipamento = 4 then
    pgcProdutoEqpto.ActivePage:= tstProdutoEmpresa
  else
    pgcProdutoEqpto.ActivePage:= tstEqptoCliente;
  dbgProdutos.ColumnByName('filial').Visible := Not ParSistema.FiliaisIndependentes;

  
  if dbgProdutos.ColumnByName('quantidade').Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutos.ColumnByName('quantidade').Width := ParSistema.TamanhoMascaraQuantidade;

  sbnComponentesMontagem.Visible := ParSistema.UsaProdutoComposto;
  tstReceitaOculos.TabVisible  := ParSistema.ANEXOCONTRATORECEITAOCULOS;

  dbgProdutos.ColumnByName('valorgrade1').Visible := ParSistema.UsarGradesProdutos;
  dbgProdutos.ColumnByName('valorgrade2').Visible := ParSistema.UsarGradesProdutos;

  dbgProdutos.CampoSequencial := 'numero';
  dtmordemservico.qryProdutosOrdemServico.After_Open := dbgProdutos.RefazerOrdenacaoSequencial;

  fraConsultaOrdemServico := TfraConsultaCodigo.Create(self);
  fraConsultaOrdemServico.Name := 'fraConsultaOrdemServico';
  fraConsultaOrdemServico.edfCodigo.MaxLength := 20;
  fraConsultaOrdemServico.edfCodigo.DataSource := fraConsultaOrdemServico.dsrProcuraOrdemServico;
  fraConsultaOrdemServico.edfCodigo.DataField := 'numero';
  fraConsultaOrdemServico.edfCodigo.Operacao := opPESQUISA;
  fraConsultaOrdemServico.AbrirTabelaProcura := false;
  fraConsultaOrdemServico.CondicoesdaConsulta := CondicoesdaConsultaOrdemServico;
  fraConsultaOrdemServico.TipoPesquisa := pesORDEMSERVICO;
  fraConsultaOrdemServico.OnFound := AtribuirDadosOrdemServicos;


  fraAtendimentosDocumentos1.Documento := dtmordemservico.GetNumeroOrdemServico;
  fraAtendimentosDocumentos1.TipoDocumento := dtmordemservico.GetTipoDocumento;

  pnlSaldoTroca.Visible := ParSistema.utilizarcreditotrocacontrato;

  fraConsultaVendedor.TipoPesquisa := pesVENDEDORES;



end;

destructor TfrmOrdemServico.Destroy;
begin
  dtmordemservico.DesbloquearOrdemServico;
  dtmOrdemServico:=nil;
  inherited;
  frmOrdemServico := nil;
end;

function TfrmOrdemServico.ExisteInformacao(Parametro: Integer;
  NomeCampo: String; Value: Variant): Boolean;
begin
  with dtmOrdemServico do
  begin
    if CtrlOn then
    begin
      case tipoconsulta of
        ctosFILIAISOS : Result := ExisteFilial(NomeCampo, Value);
        ctosCLIENTES  : Result := ExisteCliente(NomeCampo, Value);
        ctosEQPTOSOS  : begin
                          if dtmOrdemServico.CodigoCliente > 0 then
                          begin
                             Result := ExisteEquipamentoOS(NomeCampo, Value);
                          end
                          else
                          begin
                            MensagemAviso('Informe o cliente!');
                            Result:=false;
                          end;
                        end;
        ctosPRODUTOSOS: Result := ExisteProdutoOS(NomeCampo,Value);
        ctosCFPS      : Result := ExisteCFPS(NomeCampo, Value);
      else
        Result := False
      end
    end
    else if Parametro = 0 then
      Result := ExisteCliente(NomeCampo, Value)
    else
      Result := ExisteContrato(NomeCampo, Value);
  end;
end;

function TfrmOrdemServico.InternoExcluir: Boolean;
var
  CancelarCtrOrcado: Boolean;
begin
  Result:=False;
  if CtrlOn then
  begin
    if dbgProdutos.Focused then
    begin
      if (dtmOrdemServico.SituacaoOrdemServico < scFATURADO ) and (not dtmOrdemServico.ReadOnly) then
      begin
        Result := dtmOrdemServico.ExcluirProdutoOrdemServico;
        if Result then
        begin
           dtmOrdemServico.CalcularTotais;
//          dtmOrdemServico.CalcularValorTotalProdutos;
          dtmOrdemServico.CalcularValorAVista;
          PrecisaReCalcularParcelasOrdemServico := True
        end
      end
    end
    else if dbgServicos.Focused then
    begin
      if (dtmOrdemServico.SituacaoOrdemServico < scFATURADO) and (not dtmOrdemServico.ReadOnly) then
      begin
        Result := dtmOrdemServico.ExcluirServicoOrdemServico;
        if Result then
        begin
          dtmOrdemServico.CalcularTotais;
//          dtmOrdemServico.CalcularValorTotalServicos;
          dtmOrdemServico.CalcularValorAVista;
          PrecisaReCalcularParcelasOrdemServico := True
        end
      end
    end
  end
  else if ((dtmOrdemServico.SituacaoOrdemServico < scFATURADO)
           and (not dtmOrdemServico.ReadOnly)) or (dtmOrdemServico.SituacaoOrdemServico = scFATURADO) then
  begin
    frmMotivos := nil;
    Result := True;
    CancelarCtrOrcado := False;
    if (dtmOrdemServico.SituacaoOrdemServico in [scORCADO, scRESERVADO, scFATURADO]) then
    begin
      dtmOrdemServico.AbreTabelasConsulta(ctosMotivos);
      frmMotivos := TfrmMotivos.Create(frmMotivos, 'Cancelamentos de OS', dtmOrdemServico.TabelaConsultaMotivos);
      Result := frmMotivos.ShowModal = mrOK;
    end;
    try
      if Result then
      begin
        Result := dtmOrdemServico.ExcluirOrdemServico;
        if Result then
        begin
          Result := inherited InternoExcluir;
          PrecisaReCalcularParcelasOrdemServico := False
        end;
      end
    finally
      if (dtmOrdemServico.SituacaoOrdemServico in [scRESERVADO, scFATURADO]) or CancelarCtrOrcado then
      begin
        frmMotivos.Free;
        SetFocus;
        dtmOrdemServico.FechaTabelasConsulta(ctosMotivos)
      end
    end
  end else
    Result := False;
  CtrlOn:= False;

  if result then
    fraAtendimentosDocumentos1.AbrirTabelaAtendimentosDocumentos(true);

end;

function TfrmOrdemServico.InternoGravar: Boolean;
var
  CupomEmitido,
  ErroCupom: Boolean;
  FormaPagamento: Integer;
  ValorPagoDinheiro: Currency;
  Frm: TForm;
  Msg: String;
  vRetorno : TModalResult;
begin

  vReabirAtendimentosPendente := true;

  result := true;

  if inherited InternoGravar then
  begin
    Gravando := True;
    try
      vRetorno := mrNo;
      if dtmordemservico.ehGarantia or dtmordemservico.eHCortesia then
      begin
        if not dtmordemservico.qryParcelas.IsEmpty then
        begin
          vRetorno := MensagemSimNaoOpcaoCancelar('A ordem de serviço se refere a uma cortesia ou garantia aprovada. Eliminar as parcelas?','',True);

          case vretorno of
            mrYes    : dtmordemservico.ApagarParcelas;
            mrNo     : ;
            mrCancel : exit;
          end;
        end;
      end;

      {
      else
      begin
      }

        if ActiveControl = dbgProdutos then
          PrecisaReCalcularParcelasOrdemServico := (TotalProdutosAnt <> dtmOrdemServico.TotalProdutos) or
                                       (TotalIPIAnt      <> dtmordemservico.TotalIPI) or
                                        PrecisaReCalcularParcelasOrdemServico;

        if ActiveControl = dbgServicos then
          PrecisaReCalcularParcelasOrdemServico := (TotalServicosAnt <> dtmOrdemServico.TotalServicos) or
                                       (TotalIPIAnt      <> dtmordemservico.TotalIPI) or
                                        PrecisaReCalcularParcelasOrdemServico;

        result := VerificarCreditoTroca(false,true);

        if result then
        begin

          if ((PrecisaReCalcularParcelasOrdemServico) and (dtmordemservico.qryOrdemServicoplano.AsInteger > 0)) or dtmordemservico.PlanoPadraoClienteSemParcelas then
          begin
            ContornaChuncho := false;
            Result := GerarParcelasPlanoPadrao;
            PrecisaReCalcularParcelasOrdemServico := False;
            ContornaChuncho:=true;
          end;

          if ((PrecisaReCalcularParcelasOrdemServico) and not (dtmordemservico.PlanoPadraoClienteSemParcelas)) then
          begin
            MensagemAviso(ctRECALCULARPARCELAS);
            Result := False
          end
          else if ((PrecisaReCalcularParcelasOrdemServico) and (dtmOrdemServico.SituacaoOrdemServico >= scFATURADO)) then
          begin
            MensagemAviso(ctRECALCULARPARCELAS);
            Result := False
          end
        end;

        if result then
        begin
          Result := dtmOrdemServico.GravarOrdemServico(ErroCupom, CupomEmitido,
                                                       FormaPagamento, Msg,
                                                       ValorPagoDinheiro);
        end;

//    end;

    finally
      Gravando := False;
    end
  end
  else
    Result := False;

  if vReabirAtendimentosPendente then
    fraAtendimentosDocumentos1.AbrirTabelaAtendimentosDocumentos(true);

end;

function TfrmOrdemServico.InternoIncluir: Boolean;
begin
  Result:= inherited InternoIncluir;
  if not CtrlOn then
  begin
    if Result then
    begin
      dtmOrdemServico.IncluirOrdemServico;
      flkCodigoCliente.SetFocus;
    end
  end
  else
  begin
    if pgcOrdemServico.ActivePageIndex=0 then //dbgProdutos.Focused) then
    begin
      if dtmOrdemServico.PodeAlterarCampos then
        Result:= IncluirEditarProdutosOrdemServico(False)
      else
        Result:= False;
    end
    else if pgcOrdemServico.ActivePageIndex=1 then //dbgServicos.Focused then
    begin
      if dtmOrdemServico.PodeAlterarCampos then
        Result:= IncluirEditarServicosOrdemServico(False)
      else
        Result:= False;
    end
  end
end;

function TfrmOrdemServico.PermitirProcura: Boolean;
begin
  Result := True;
  if CtrlOn then
  begin
    if flkEquipamentoOS.focused then
    begin
      if dtmOrdemServico.CodigoCliente>0 then
         TipoConsulta := ctosEQPTOSOS
      else
      begin
        Result:=false;
        MensagemAviso('Informe o cliente!');
      end
    end
    else if flkCodigoCliente.Focused then
      TipoConsulta := ctosCLIENTES
    else if flkProduto.Focused then
      TipoConsulta := ctosPRODUTOSOS
    else if flkCFPS.Focused then
      TipoConsulta := ctosCFPS;
  end
  else
  begin
    TipoConsulta := ctosORDEMSERVICO;
    //dtmOrdemServico.AbreTabelasConsulta(ctosCLIENTES);
    //Titulo := ctstrCONTRATOS;
  end;
end;

function TfrmOrdemServico.InternoPesquisar(Titulo: String): Integer;
begin
  if not CtrlOn then
     fraconsultaordemservico.InternoPesquisar('Ordem de Serviço')
  else
  begin
    Result := mrNone;
    if PermitirProcura then
    begin
      with dtmOrdemServico do
      begin
        if not CtrlOn then
        begin
          AbreTabelasConsulta(ctosCLIENTES);
          Titulo := 'OS';
        end
        else
          AbreTabelasConsulta(TipoConsulta);

        Result:= Inherited InternoPesquisar(Titulo);
        if Result = mrOK then
        begin
          SelecionaTabelasConsulta(tipoConsulta);
          if TipoConsulta = ctosORDEMSERVICO then
            flkProduto.Exist;
        end;
        FechaTabelasConsulta(tipoConsulta);
      end;
    end;
  end;
end;

function TfrmOrdemServico.JanelaPesquisa: TfrmConsultaBasica;
begin
  Jan := TfrmConsultaPorCampo.Create(nil);
  Jan.ConsultaInterativa := Not (TipoConsulta in [ctosCLIENTES,ctosPRODUTOSOS]) and CtrlOn;
  Jan.UsarParametrosDaTabela := not (TipoConsulta in [ctosPRODUTOSOS, ctosEQPTOSOS, ctosCFPS]);
  Result := Jan
end;

