function TfrmOrdemServico.GerarParcelasPlanoPadrao: Boolean;
begin
  CalcularFinanciamento;

  if ((dtmordemservico.TotalOrdemServico - dtmordemservico.CreditoTroca)<>0) then
  begin
    if dtmordemservico.ClientePlanoPadrao <> 0 then
    begin
      result := false;
      if assigned(frmCalculoFinanciamento) then
        Result := frmCalculoFinanciamento.calcularPlanoPadrao(dtmordemservico.ClientePlanoPadrao);

    end
    else
    if dtmordemservico.qryOrdemServicoPlano.asinteger <> 0 then
    begin
      result := false;
      if assigned(frmCalculoFinanciamento) then
        Result := frmCalculoFinanciamento.calcularPlanoPadrao(dtmordemservico.qryOrdemServicoPlano.asinteger);

    end
    else
    begin
      result := false;
      MensagemErro('Nenhum plano definido para o cálculo');
    end;
  end;

end;

function TfrmOrdemServico.GerarParcelasVendaaVista: Boolean;
begin
  CalcularFinanciamento;
end;
