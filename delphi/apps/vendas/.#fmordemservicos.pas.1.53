procedure TfrmOrdemServico.sbnVisualizarSaldoTrocaClick(Sender: TObject);
begin
  inherited;
  edtSaldoTrocaEnter(self);
  if ParSistema.utilizarcreditotrocacontrato then
  begin
    dtmordemservico.AbrirDadosCreditoCliente;

    frmVisualizarSaldoTroca := TfrmVisualizarSaldoTroca.Create(frmVisualizarSaldoTroca,
                               dtmordemservico.TabelaSaldoCredito,
                               dtmordemservico.TabelaSaldoCreditoAtual);
                               
    frmVisualizarSaldoTroca.ShowModal;
    if frmVisualizarSaldoTroca.ModalResult = mrOK then
    begin
      if dtmordemservico.CreditoTroca <> dtmordemservico.SaldoCreditoAtual then
      begin
        dtmordemservico.SugerirCreditoTroca(false,true);
        dtmordemservico.CalcularValorAVista;
        PrecisaReCalcularParcelasOrdemServico := true;
      end;
    end;
    frmVisualizarSaldoTroca.Free;
    Application.BringToFront;
  end;

end;

function TfrmOrdemServico.VerificarCreditoTroca(zerar,
  Atribuir: Boolean): Boolean;
begin
  result := true;
//  pgcContratos.ActivePage := tstGeral;  // CAUSA PERDA DE FOCO EM DIVERSAS SITUAÇÕES
  if ParSistema.utilizarcreditotrocacontrato then
  begin
    dtmOrdemServico.AbrirDadosCreditoCliente;
    if dtmOrdemServico.ValidarCreditoTroca then
    begin
      if ((dtmOrdemServico.SaldoCreditoAtual<>0) and
          (dtmOrdemServico.CreditoTroca=0)) or
         ((dtmOrdemServico.SaldoCreditoAtual>0) and
          (dtmOrdemServico.CreditoTroca<dtmOrdemServico.SaldoCreditoAtual) and
          (dtmOrdemServico.CreditoTroca<dtmOrdemServico.Totalordemservico)) {or
         ((dtmOrdemServico.SaldoCreditoAtual<0) and
          (dtmOrdemServico.CreditoTroca>dtmOrdemServico.SaldoCreditoAtual))} then
      begin
        if dtmOrdemServico.SugerirCreditoTroca(true,atribuir) then
        begin
          dtmOrdemServico.CalcularValorAVista;
          pgcOrdemServico.ActivePage := tstPlanodePagamento;
          edtSaldoTroca.SetFocus;
          result := atribuir;
        end
      end;
    end
    else
    begin
     if zerar then
       edtSaldoTroca.text := FormatarValor(0,2);
     pgcOrdemServico.ActivePage := tstPlanodePagamento;
     edtSaldoTroca.SetFocus;
     result := false;
    end;
  end;

end;

procedure TfrmOrdemServico.edtSaldoTrocaEnter(Sender: TObject);
begin
  inherited;
  dtmOrdemServico.CreditoTrocaAnt := dtmOrdemServico.CreditoTroca;
end;

procedure TfrmOrdemServico.edtSaldoTrocaExit(Sender: TObject);
begin
  inherited;
  {
  if dtmOrdemServico.CreditoTroca <> dtmOrdemServico.CreditoTrocaAnt then
  begin
    dtmOrdemServico.CalcularValorAVista;
    dtmCadastroContratos.PrecisaReCalcularParcelas := true;
  end;
  }

end;

end.
