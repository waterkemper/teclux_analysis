function TfrmOrdemServico.IncluirEditarProdutosOrdemServico(Editar: Boolean): Boolean;
begin
  frmProdutosOrdemServico := TfrmProdutosOrdemServico.Create(frmProdutosOrdemServico);

  if Editar then Result := dtmOrdemServico.EditarProdutosOrdemServico
  else           Result := dtmOrdemServico.IncluirProdutosOrdemServico;

  if Result then
    Result := frmProdutosOrdemServico.ShowModal = mrOK;
  frmProdutosOrdemServico.Free;
  dtmOrdemServico.CalcularTotais;
  SetFocus;
end;

function TfrmOrdemServico.IncluirEditarServicosOrdemServico(Editar: Boolean): Boolean;
begin
  frmCadastroServicosOrdemServico := TfrmCadastroServicosOrdemServico.Create(frmCadastroServicosOrdemServico);
  if Editar and not dtmOrdemServico.qryOrdemServico.IsEmpty then
    Result := dtmOrdemServico.EditarServicosOrdemServico
  else
    Result := dtmOrdemServico.IncluirServicosOrdemServico(False);
    
  if Result then
    Result := frmCadastroServicosOrdemServico.ShowModal = mrOK;
  frmCadastroServicosOrdemServico.Free;
  dtmOrdemServico.CalcularTotais;
  SetFocus;
end;

