  4 :     pgcProdutoEqpto.ActivePage := tstProdutoEmpresa;
  end;
end;

procedure TfrmOrdemServico.sbnCopiarProdutosClick(Sender: TObject);
begin
  inherited;
  CopiarProdutosContratos;
end;

procedure TfrmOrdemServico.CopiarProdutosContratos;
begin
  frmCopiarProdutosContratos := TfrmCopiarProdutosContratos.Create(frmCopiarProdutosContratos,UsuarioLogin.AlterarPrecoContrato, dtmordemservico);
  frmCopiarProdutosContratos.edfNumeroContratoCopia.DataSource := dtmordemservico.dsrContratoCopia;
  frmCopiarProdutosContratos.dtxSituacao.DataSource := dtmordemservico.dsrContratoCopia;
  frmCopiarProdutosContratos.dtxEmissao.DataSource := dtmordemservico.dsrContratoCopia;
  frmCopiarProdutosContratos.dtxFaturamento.DataSource := dtmordemservico.dsrContratoCopia;
  frmCopiarProdutosContratos.dtxCliente.DataSource := dtmordemservico.dsrContratoCopia;
  frmCopiarProdutosContratos.dtxCPF.DataSource := dtmordemservico.dsrContratoCopia;
  frmCopiarProdutosContratos.dbgProdutos.DataSource := dtmordemservico.dsrContratoCopia;
  frmCopiarProdutosContratos.dbgProdutos.DataSource := dtmordemservico.dsrProdutosContratoCopia;

  try
    if frmCopiarProdutosContratos.ShowModal = mrOK then
      dtmordemservico.IncluirProdutosContratoCopia;
  finally
    frmCopiarProdutosContratos.Free;
    dtmordemservico.CalcularTotais;
//    dtmordemservico.CalcularValorTotalProdutos;
    dtmordemservico.CalcularTotais;
//    fraEnderecoEntrega.ReadOnly := Not dtmordemservico.ExisteEntrega;
//    flkFilialMontagem.ReadOnly  := Not dtmordemservico.ExisteMontagem;
    PrecisaReCalcularParcelasOrdemServico   := (TotalProdutosAnt <> dtmordemservico.TotalProdutos) or
                                   (TotalIPIAnt      <> dtmordemservico.TotalIPI) or
                                   PrecisaReCalcularParcelasOrdemServico;

//    dtmordemservico.MontarListaGruposClasses(Grupos, Classes);
    SetFocus;
  end;

end;

procedure TfrmOrdemServico.sbnCopiarContratoClick(Sender: TObject);
begin
  inherited;
  if dtmordemservico.qryOrdemServico.Active then
    if dtmordemservico.CopiarContrato then
    begin
      dtmordemservico.CalcularTotais;
//      dtmordemservico.CalcularValorTotalProdutos;
      PrecisaReCalcularParcelasOrdemServico := True
    end;
end;

procedure TfrmOrdemServico.sbnEnviarOrcamentoClick(Sender: TObject);
var
EmailContato:string;
begin
  inherited;

  if (ParSistema.UsaitecLUX) then
    EmailContato:= dtmOrdemServico.qryContatosemail.AsString
  else
     EmailContato:= UsuarioLogin.Email;

  frmEnviarEmail:= TfrmEnviarEmail.Create(frmEnviarEmail,UsuarioLogin.HostSmtp,
                                          EmailContato,
                                          dtmOrdemServico.qryContatoscontato.AsString, 'Ordem de Serviço');

  try
    with frmEnviarEmail do
    begin
      Data        := dtmOrdemServico.DataServidor;
      Empresa     := PrimeiraLetraEmMaiuscula(dtmOrdemServico.NomeFilialBase);
      Msg         := MontarOrcamento(dtmordemservico.qryOrdemServico,
                                                     dtmordemservico.qryProdutosOrdemServico,
                                                     dtmordemservico.qryServicosOrdemServico);
      ShowModal;
    end;
  finally
    frmEnviarEmail.Free;
  end;

  edfNumero.SetFocus;
end;

