procedure TfrmOrdemServico.dbgProdutosKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;

  if (Shift = [ssCtrl]) and (Key = VK_Space) then begin
    if dbgProdutos.SelectedIndex = dbgProdutos.ColumnByName('brinde').Index then
      dtmordemservico.MarcarProdutosBrinde(false,false)
    else
    begin
      if (dtmordemservico.SituacaoOrdemServico > scRESERVADO) and
        Not (dtmordemservico.ProdutoNotaEmitida
         or dtmordemservico.ProdutoCancelado)
      then begin
        dtmordemservico.IncluirNaNotaFiscal := Not dtmordemservico.IncluirNaNotaFiscal;
        dbgProdutos.Invalidate
      end else begin
        if dtmordemservico.SituacaoOrdemServico = scORCADO then
          dtmordemservico.MarcarProdutoCopiar:= not dtmordemservico.MarcarProdutoCopiar
        else if dtmordemservico.SituacaoOrdemServico = scRESERVADO then
          if not dtmordemservico.Alterado or (dtmordemservico.RegistrosMarcados > 0) then
            dtmordemservico.MarcarProdutoCopiar:= not dtmordemservico.MarcarProdutoCopiar
          else
            MensagemAviso('O Produto não pode ser selecionado para cópia,' + #10#13 + 'estando o Contrato em edição.');
      end
    end;
  end else if (Key = VK_F2) then
  begin
    if dtmOrdemServico.PodeAlterarCampos then
    begin
      if (Shift = [ssCtrl]) then
        IncluirEditarProdutosOrdemServico(True)
      else if (Shift = [ssCtrl, ssAlt]) then
        IncluirEditarProdutosOrdemServico(True);
    end;
  end else if (key = VK_F9) then
   if Shift = [ssCtrl] then
      sbnComponentesMontagem.Click;
end;

