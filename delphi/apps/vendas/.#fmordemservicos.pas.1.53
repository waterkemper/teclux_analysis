procedure TfrmOrdemServico.ReservarOrdemServico;
begin
  if MensagemConfirmacao(ctCONFIRMERESERVA) = smbOK then
  begin
    dtmordemservico.SituacaoOrdemServico := scRESERVADO;
    InternoGravar;
  end
end;

procedure TfrmOrdemServico.dbgProdutosDrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  inherited;
  if datacol <> 1 then
  begin
    if (dtmordemservico.QtdadeProdutos > 0) and (dtmordemservico.SituacaoOrdemServico > scRESERVADO) then begin
      if dtmordemservico.ProdutoCancelado then
      begin
        TDBGrid(Sender).Canvas.Brush.Color := clYellow;
        TDBGrid(Sender).Canvas.Font.Color := clBlack;
      end else if dtmordemservico.ProdutoNotaEmitida then
      begin
        TDBGrid(Sender).Canvas.Brush.Color := $007FAA55;
        TDBGrid(Sender).Canvas.Font.Color := clBlack;
      end else if dtmordemservico.IncluirNaNotaFiscal then
      begin
        TDBGrid(Sender).Canvas.Brush.Color := $00FFAA00;
        TDBGrid(Sender).Canvas.Font.Color := clBlack;
      end
    end;
    if (dtmordemservico.QtdadeProdutos > 0) and (dtmordemservico.SituacaoOrdemServico <= scRESERVADO) then begin
      if dtmordemservico.MarcarProdutoCopiar then
      begin
        TDBGrid(Sender).Canvas.Brush.Color := $000055FF;
        TDBGrid(Sender).Canvas.Font.Color := clBlack;
      end;
    end;
    TDBGrid(Sender).Canvas.Font.Style := [];
    TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
  end
  else
  begin
    if dbgProdutos.DataSource.DataSet.FieldByName('situacao_produto').AsString = 'A' then
      TDBGrid(Sender).Canvas.Font.Color := clGreen
    else
    if dbgProdutos.DataSource.DataSet.FieldByName('situacao_produto').AsString = 'P' then
      TDBGrid(Sender).Canvas.Font.Color := $000080FF
    else
    if dbgProdutos.DataSource.DataSet.FieldByName('situacao_produto').AsString = 'N' then
      TDBGrid(Sender).Canvas.Font.Color := clRed;

    TDBGrid(Sender).Canvas.Font.Style := [fsBold];
   TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
  end;





end;

procedure TfrmOrdemServico.AfterPostTipoEquipamento(Sender: TObject);
begin
  case dtmordemservico.qryOrdemServicotipoequipamento.asinteger of
