procedure TfrmOrdemServico.AtribuirEquipamento;
begin
  if not (dtmordemservico.qryOrdemServico.State in [dsedit,dsinsert]) then
    dtmordemservico.qryOrdemServico.Edit;
  dtmordemservico.qryOrdemServicoequipamento.AsString := frmCadastroEquipamentoslocal.dtmCadastroEquipamentos.qryEquipamentoscodigo.AsString;
  flkEquipamentoOS.Exist;

end;

procedure TfrmOrdemServico.dbgServicosDrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  inherited;
  if (dtmordemservico.QtdadeServicos > 0) and (dtmordemservico.SituacaoOrdemServico > scRESERVADO) then
  begin
    if dtmordemservico.ServicoCancelado then
    begin
      TDBGrid(Sender).Canvas.Brush.Color := clYellow;
      TDBGrid(Sender).Canvas.Font.Color := clBlack;
    end;
  end;
  TDBGrid(Sender).Canvas.Font.Style := [];
  TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
end;

procedure TfrmOrdemServico.AtribuirDadosOrdemServicos;
begin
  with dtmordemservico do
  begin
    qryOrdemServico.parambyname('numero').asstring := fraConsultaOrdemServico.qryConsultaordemserviconumero.asstring;
    qryOrdemServico.macrobyname('CondicaodaConsulta').asstring := ' and c.numero = '+quotedstr(fraConsultaOrdemServico.qryConsultaordemserviconumero.asstring);
    qryOrdemServico.close;
    qryOrdemServico.open;
    qryOrdemServico.macrobyname('CondicaodaConsulta').asstring := '';
  end;
end;

procedure TfrmOrdemServico.CondicoesdaConsultaOrdemServico;
var
  vEquipamento: String;

begin
  vEquipamento := quotedstr(dtmordemservico.qryordemservico.parambyname('numero').asstring);
  if fraConsultaOrdemServico.vEncontradoMultiplosRegistros then
    fraConsultaOrdemServico.qryConsultaClientes.MacroByName('CondicaodaConsulta').AsString := ' and exists (select ct.numero ' +
                                                                                              ' from contratos ct left join produtos p on ct.produto = p.codigo ' +
                                                                                              ' where ct.cliente = v.codigo ' +
                                                                                              ' and ct.tipocliente = v.tipo '+
                                                                                              ' and coalesce(ct.os,false) ' +
                                                                                              ' and (ct.equipamento = '+vequipamento + ' or p.codigovisual = '+vequipamento+ 'or ct.numero = '+vequipamento+')'+
                                                                                              ' limit 1) '
  else
    fraConsultaOrdemServico.qryConsultaClientes.MacroByName('CondicaodaConsulta').AsString := ' and exists (select ct.numero ' +
                                                                                              ' from contratos ct ' +
                                                                                              ' where ct.cliente = v.codigo ' +
                                                                                              ' and ct.tipocliente = v.tipo '+
                                                                                              ' and coalesce(ct.os,false) ' +
                                                                                              ' limit 1) ';
  if fraConsultaOrdemServico.qryConsultaClientes.recordcount > 1 then
  begin
    if fraConsultaOrdemServico.vEncontradoMultiplosRegistros then
    begin
      fraConsultaOrdemServico.qryConsultaEquipamentosClientes.MacroByName('CondicaodaConsulta').AsString := ' exists (select ct.numero ' +
                                                                                                ' from contratos ct  ' +
                                                                                                ' where ct.equipamento = ec.equipamento ' +
                                                                                                ' and ct.cliente = '+fraConsultaOrdemServico.qryConsultaClientescodigo.asstring +
                                                                                                ' and ct.tipocliente = '+quotedstr(fraConsultaOrdemServico.qryConsultaClientestipoorig.asstring) +
                                                                                                ' and coalesce(ct.os,false) ' +
                                                                                                ' and (ct.equipamento = '+vequipamento +' or ct.numero = '+vequipamento+')'+
                                                                                                ' limit 1) ';

      fraConsultaOrdemServico.qryConsultaEquipamentosClientes.MacroByName('CondicaodaConsultaCT').AsString :=
                                                                                                ' ct.cliente = '+fraConsultaOrdemServico.qryConsultaClientescodigo.asstring +
                                                                                                ' and ct.tipocliente = '+quotedstr(fraConsultaOrdemServico.qryConsultaClientestipoorig.asstring) +
                                                                                                ' and (p.codigovisual = '+vequipamento + 'or ct.numero = '+vequipamento+')';

    end
    else
    begin
      fraConsultaOrdemServico.qryConsultaEquipamentosClientes.MacroByName('CondicaodaConsulta').AsString := ' exists (select ct.numero ' +
                                                                                                ' from contratos ct ' +
                                                                                                ' where ct.equipamento = ec.equipamento ' +
                                                                                                ' and ct.cliente = '+fraConsultaOrdemServico.qryConsultaClientescodigo.asstring +
                                                                                                ' and ct.tipocliente = '+quotedstr(fraConsultaOrdemServico.qryConsultaClientestipoorig.asstring) +
                                                                                                ' and coalesce(ct.os,false) ' +
                                                                                                ' limit 1) ';

      fraConsultaOrdemServico.qryConsultaEquipamentosClientes.MacroByName('CondicaodaConsultaCT').AsString :=
                                                                                                ' ct.cliente = '+fraConsultaOrdemServico.qryConsultaClientescodigo.asstring +
                                                                                                ' and ct.tipocliente = '+quotedstr(fraConsultaOrdemServico.qryConsultaClientestipoorig.asstring);

    end;
  end
  else
  begin
    if fraConsultaOrdemServico.vEncontradoMultiplosRegistros then
    begin
      fraConsultaOrdemServico.qryConsultaEquipamentosClientes.MacroByName('CondicaodaConsulta').AsString := ' exists (select ct.numero ' +
                                                                                                ' from contratos ct ' +
                                                                                                ' where ct.equipamento = ec.equipamento ' +
                                                                                                ' and coalesce(ct.os,false) ' +
                                                                                                ' and (ct.equipamento = '+vequipamento +' or ct.numero = '+vequipamento+')'+
                                                                                                ' limit 1) ';

      fraConsultaOrdemServico.qryConsultaEquipamentosClientes.MacroByName('CondicaodaConsultaCT').AsString := ' (p.codigovisual = '+vequipamento + 'or ct.numero = '+vequipamento+')';
    end
    else
    begin
      fraConsultaOrdemServico.qryConsultaEquipamentosClientes.MacroByName('CondicaodaConsulta').AsString := ' exists (select ct.numero ' +
                                                                                                ' from contratos ct' +
                                                                                                ' where ct.equipamento = ec.equipamento ' +
                                                                                                ' and coalesce(ct.os,false) ' +
                                                                                                ' limit 1) ';
      fraConsultaOrdemServico.qryConsultaEquipamentosClientes.MacroByName('CondicaodaConsultaCT').AsString := ' p.codigovisual is not null';
    end;
  end;

end;

