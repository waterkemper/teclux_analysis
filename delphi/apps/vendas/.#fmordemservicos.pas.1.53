procedure TfrmOrdemServico.edfNumeroFound(Found: Boolean);
begin
  inherited;
  {
  if Found then
  begin
  }

    if dtmordemservico.qryOrdemServico.recordcount >= 1 then
    begin
      if dtmordemservico.qryOrdemServico.recordcount > 1 then
      begin
        fraConsultaOrdemServico.vEncontradoMultiplosRegistros := true;
        if fraConsultaOrdemServico.InternoPesquisar('Ordem de Serviço') <> mrOK then
          edfNumero.clear;
      end;
    end;

    fraConsultaOrdemServico.qryconsultaclientes.close;
    fraConsultaOrdemServico.qryConsultaEquipamentosClientes.close;
    fraConsultaOrdemServico.vEncontradoMultiplosRegistros := false;

    dtmOrdemServico.RefazConsultaProdutosEntregar;
    if dtmOrdemServico.SituacaoOrdemServico = scNOTAPARCIAL then
        AlterarEstadoBotoes;
    flkCodigoCliente.Exist;
    flkProduto.Exist;
    if rgpTipoEquipamento.ItemIndex=3 then
      pgcProdutoEqpto.ActivePage:=tstProdutoEmpresa
    else
      pgcProdutoEqpto.ActivePage:=tstEqptoCliente;
  //end;

end;

procedure TfrmOrdemServico.sbnImprimirOrdemServicoClick(Sender: TObject);
begin
  inherited;
  ImprimirOrdemServico;
end;


procedure TfrmOrdemServico.ImprimirOrdemServico;
var
  CarnesAbertas, ImprimirContrato: Boolean;
begin

(*
 frmConfirmarImpressaoNoContrato := TfrmConfirmarImpressaoNoContrato.Create(frmConfirmarImpressaoNoContrato, True, True , True, False, False, 2);

 frmConfirmarImpressaoNoContrato.IntervaloCarnes := dtmordemservico.IntervaloCarnes;
 frmConfirmarImpressaoNoContrato.IntervaloCarnesAbertas:= dtmordemservico.IntervaloCarnesAbertas;
 frmConfirmarImpressaoNoContrato.ckbImprimirCarneAbertas.Enabled := frmConfirmarImpressaoNoContrato.IntervaloCarnesAbertas<>nil;

 try
    if frmConfirmarImpressaoNoContrato.ShowModal = mrOK then
    begin
      if frmConfirmarImpressaoNoContrato.Contrato then
        dtmOrdemServico.ImprimirOrdemServico;

       if frmConfirmarImpressaoNoContrato.Carne then
          dtmordemservico.ImprimirDuplicatas(frmConfirmarImpressaoNoContrato.Sequencia)
       else
       if frmConfirmarImpressaoNoContrato.CarneAbertas then
          dtmordemservico.ImprimirDuplicatas(frmConfirmarImpressaoNoContrato.Sequencia);

    end
  finally
//    frmConfirmarImpressaoNoContrato.Free;
  end
  
*)



  if ((Length(dtmOrdemServico.IntervaloCarnesAbertas)>0)) then
    CarnesAbertas:= True
  else
    CarnesAbertas:= False;

  if (ParSistema.SoImprimirFaturados) then
    if (dtmOrdemServico.SituacaoOrdemServico > scRESERVADO) then
      ImprimirContrato:= True
    else
      ImprimirContrato:= False
  else
    ImprimirContrato:= True;

  frmConfirmarImpressaoNoContrato := TfrmConfirmarImpressaoNoContrato.Create(frmConfirmarImpressaoNoContrato, ImprimirContrato, True, (dtmOrdemServico.SituacaoOrdemServico > scRESERVADO),
                                                         (CarnesAbertas), True, 2);

  frmConfirmarImpressaoNoContrato.IntervaloCarnes:= dtmOrdemServico.IntervaloCarnes;
  frmConfirmarImpressaoNoContrato.IntervaloCarnesAbertas:= dtmOrdemServico.IntervaloCarnesAbertas;
  frmConfirmarImpressaoNoContrato.ckbImprimirCarneAbertas.Enabled := frmConfirmarImpressaoNoContrato.IntervaloCarnesAbertas<>nil;

  try
    frmConfirmarImpressaoNoContrato.ShowModal;
    if frmConfirmarImpressaoNoContrato.ModalResult = mrOK then
    begin
      if frmConfirmarImpressaoNoContrato.Contrato then
        dtmOrdemServico.ImprimirOrdemServico
        {
      else
      if frmConfirmarImpressaoNoContrato.ContratoMeiaPagina then
        dtmOrdemServico.ImprimirContrato(dbgProdutos.Ordenacao, true)};

      if frmConfirmarImpressaoNoContrato.Carne then
        dtmOrdemServico.ImprimirCarne(frmConfirmarImpressaoNoContrato.Sequencia)
      else
      if frmConfirmarImpressaoNoContrato.CarneAbertas then
        dtmOrdemServico.ImprimirCarne(frmConfirmarImpressaoNoContrato.Sequencia);

      if frmConfirmarImpressaoNoContrato.Boleto then
        dtmOrdemServico.ImprimirBoleto(frmConfirmarImpressaoNoContrato.Sequencia);

      if frmConfirmarImpressaoNoContrato.ckbEnviarPDFBoletoViaEmail.Checked then
        dtmOrdemServico.EnviarPDFBoletoViaEmail(frmConfirmarImpressaoNoContrato.Sequencia);

      if frmConfirmarImpressaoNoContrato.Saldo then
        dtmOrdemServico.ImprimirSaldo;

      if frmConfirmarImpressaoNoContrato.etiquetasListacasamento then
        dtmOrdemServico.ImprimirEtiquetasListaCasamento;
    end
  finally

//   if assigned(frmConfirmarImpressaoNoContrato) then
//      frmConfirmarImpressaoNoContrato.Free;
  end

end;

procedure TfrmOrdemServico.sbnAlterarSituacaoClick(Sender: TObject);
var
  Frm: TForm;

begin
  inherited;
 case dtmOrdemServico.SituacaoOrdemServico of
    scORCADO: ReservarOrdemServico;
    scRESERVADO,
    scFATURADO,
    scNOTAPARCIAL:
    begin
      if VerificarCreditoTroca(true,true) then
      begin
        dtmordemservico.DocumentosFiscaisOrdemServico;

        Frm := TfrmOperacoesContratos.Referencia;
        if Assigned(Frm)  then
          TfrmOperacoesContratos(Frm).RefazConsulta;
      end;
    end;
 end;
end;

procedure TfrmOrdemServico.DocumentosFiscaisOrdemServico;
var
  UsuarioAut: TtecUsuarios;
  PodeImprimirNota,
  ErroCupom,
  NotaFiscalVinculada: Boolean;
  FormaPagamento: Integer;
  ValorPagoDinheiro: Currency;
  Frm: TForm;
  Msg: String;
  SituacaoAtual : TtecSituacaoContrato;
begin
  PodeImprimirNota:= False;
  if UsuarioLogin.EmissorNotaFiscal then
    PodeImprimirNota:= True
  else
  begin
    UsuarioAut := dtmOrdemServico.ObterAutorizacao(taLOGIN, ctIMPRIMIRNOTAFISCAL, ctEMISSORNOTAFISCAL);
    try
      if Assigned(UsuarioAut) then
      begin
        if not UsuarioAut.EmissorNotaFiscal then
        begin
          PodeImprimirNota := False;
          MensagemAviso(Format(ctUSUARIONAOAUTORIZADO, ['imprimir nota fiscal.']));
        end
        else
          PodeImprimirNota:= True;
      end;
    finally
      UsuarioAut.Free
    end
  end;
  if PodeImprimirNota then
  begin
    if MensagemConfirmacao(ctCONFIRMEIMPRESSAODOCUMENTOSFISCAIS) = smbok then
    begin
      if Assigned(ECFPadrao) then
        NotaFiscalVinculada := (ParSistema.NotaFiscalVinculada = tnfOBRIGATORIA) or
                               ((ParSistema.NotaFiscalVinculada = tnfOPCIONAL) and
                               (MensagemConfirmacao(ctCONFIRMAEMISSAONOTASCONTRATO) = smbOK))
      else
        NotaFiscalVinculada := False;
      SituacaoAtual := dtmOrdemServico.SituacaoOrdemServico;
      dtmOrdemServico.SituacaoOrdemServico := scNOTAFISCAL;
      dtmOrdemServico.MarcarTodosOsProdutos;
      try
        if Not dtmOrdemServico.GravarOrdemServico(ErroCupom, NotaFiscalVinculada,
                                                  FormaPagamento, Msg, ValorPagoDinheiro)
        then
        begin
          dtmOrdemServico.VoltarSituacaoOrdemServico(SituacaoAtual);
          dtmOrdemServico.CancelarAlteracoesOrdemServico;
        end
        else
        begin
         Frm := TfrmDevolucaoMercadorias.Referencia;
          if Assigned(Frm) then
            TfrmDevolucaoMercadorias(Frm).ReFazConsultaCliente([dtmOrdemServico.NumeroOrdemServico]);
          Frm := TfrmOperacoesContratos.Referencia;
          if Assigned(Frm)  then
            TfrmOperacoesContratos(Frm).RefazConsulta;
        end;
        AlterarEstadoBotoes;
      except
        dtmOrdemServico.RefazConsultaOrdemServico;
        AlterarEstadoBotoes;
        raise
      end
    end
  end;
end;

procedure TfrmOrdemServico.AlterarEstadoBotoes;
begin
  inherited;
  sbnAlterarSituacao.Caption := vstrAlterarSituacaoOrdemServico[dtmordemservico.SituacaoOrdemServico] + ' F11';
  dtmOrdemServico.RefazConsultaProdutosEntregar;
  if dtmOrdemServico.Bloqueado then
    sbnAlterarSituacao.Enabled := False
  else if dtmOrdemServico.Alterado then
    sbnAlterarSituacao.Enabled  := false
  else if dtmOrdemServico.SituacaoOrdemServico = scORCADO then
    sbnAlterarSituacao.Enabled  := True
  else if ((dtmOrdemServico.SituacaoOrdemServico in [scRESERVADO,scFATURADO])) and dtmOrdemServico.PermiteEmitirNota then
    sbnAlterarSituacao.Enabled  := True
  else if dtmOrdemServico.SituacaoOrdemServico = scNOTAPARCIAL then
    sbnAlterarSituacao.Enabled  := True
  else
    sbnAlterarSituacao.Enabled  := False;
  sbnAlterarSituacao.Hint     := vstrHintSituacaoOrdemServico[dtmOrdemServico.SituacaoOrdemServico];

  sbnExcluir.Enabled          := (dtmOrdemServico.SituacaoOrdemServico <= scFATURADO) and
                                 Not (dtmOrdemServico.Bloqueado or dtmOrdemServico.Alterado);
  sbnImprimirOrdemServico.Enabled := (dtmOrdemServico.SituacaoOrdemServico < scCANCELADO) and not sbnSalvar.Enabled;
  sbnImprimirRequisicao.Enabled := (dtmOrdemServico.SituacaoOrdemServico <= scFATURADO) and (dtmordemservico.Equipamento <> '') and not sbnSalvar.Enabled;
  {sbnEnviarOrcamento.Enabled  := (dtmCadastroContratos.SituacaoContrato <= scFATURADO) and not sbnSalvar.Enabled and
                                 (dtmCadastroContratos.ContratosRecordCount > 0);}

  sbnCopiarProdutos.Visible := (dtmordemservico.SituacaoOrdemServico < scFATURADO) or
                               (dtmordemservico.SituacaoOrdemServico = scNENHUM);

  sbnCopiarContrato.Enabled   := (dtmordemservico.SituacaoOrdemServico <= scRESERVADO) and
                                 not dtmordemservico.ContratoInserindo and
                                 not dtmordemservico.InseriuProduto and (dtmordemservico.ContratosRecordCount > 0);

  sbnEnviarOrcamento.Enabled  := (dtmordemservico.SituacaoOrdemServico <= scFATURADO) and not sbnSalvar.Enabled and
                                 (dtmordemservico.qryOrdemServico.RecordCount > 0);

end;

