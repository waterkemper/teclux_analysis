function TfrmOrdemServico.TabelaDePesquisa: TZDataSet;
begin
//  Result := inherited TabelaDePesquisa;
    with dtmOrdemServico do
      case TipoConsulta of
        ctosORDEMSERVICO : Result := ConsultaOrdemServico;
        ctosFILIAISOS    : Result := ConsultaFiliais;
        ctosCLIENTES     : Result := ConsultaClientes;
        ctosEQPTOSOS     : Result := ConsultaEqptoOS;
        ctosPRODUTOSOS   : Result := ConsultaProdutosOS;
        ctosCFPS         : Result := ConsultaCFPS;
      else
        Result:=nil;
      end;
end;

