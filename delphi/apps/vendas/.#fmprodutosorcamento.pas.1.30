{ TfrmProdutosOrcamento }

procedure TfrmProdutosOrcamento.actHabilitarControlesUpdate(Sender: TObject);
begin
  inherited;
  lblPromocao.Visible := dtmOrcamentos.ProdutoEmPromocao;
  lblPrecoNormal.Visible          := dtmOrcamentos.ProdutoEmPromocao;
  dtxPrecoProduto.Visible          := dtmOrcamentos.ProdutoEmPromocao;
  pnlGradeProdutos.enabled := not (dtmOrcamentos.qryProdutosOrcamentos.state in [dsinsert]);
end;

constructor TfrmProdutosOrcamento.Create(AOwner: TComponent);
begin
  inherited;

  if (ParSistema.ValordaQuantidade > 0) then
  begin
    Self.ActiveControl:=flkCodigoProduto;
    flkCodigoProduto.SelectAll;
  end
  else
  begin
    Self.ActiveControl := edtQuantidade;
//    edtQuantidade.SetFocus;
    edtQuantidade.SelectAll;
  end;
  
  DataSet := dtmOrcamentos.TabelaProdutosOrcamento;
  sbnAlterarPreco.Visible := ParSistema.PermiteAlterarPreco;
  pnlDesconto.Visible     := sbnAlterarPreco.Visible and UsuarioLogin.AlterarPrecoContrato;
  rgpMontagem.Enabled     := dtmOrcamentos.ProdutoMontavel;
  flkVendedor.Enabled     := not UsuarioLogin.Vendedor;
  if UsuarioLogin.Vendedor then begin
    dtxNomeVendedor.Width := dtxNomeVendedor.Width + dtxNomeVendedor.Left - flkVendedor.Left;

    dtxNomeVendedor.Left  := flkVendedor.Left;

    dtxNomeVendedor.BringToFront;

  end;

  if ParSistema.SoVisualizarEstoqueDeposito then

    gbxDepositos.Caption := ctDEPOSITOS

  else gbxDepositos.Caption := ctFILIAIS;

  gbxDepositos.Visible := not ParSistema.FiliaisIndependentes;
  dbgDepositos.Visible      := not ParSistema.FiliaisIndependentes;

  gbxFilial.Visible    := not ParSistema.FiliaisIndependentes;

  dbgSimilares.Columns[2].Visible := ParSistema.UsarGradesProdutos;

  dbgSimilares.Columns[3].Visible := ParSistema.UsarGradesProdutos;
  if not ParSistema.UsarGradesProdutos then
    dbgsimilares.Columns[1].Width := dbgsimilares.Columns[1].Width+
                                     dbgsimilares.Columns[2].Width+
                                     dbgsimilares.Columns[3].Width;
  dtmOrcamentos.OnScrollLinhaColunaGradeSimilares := AfterScrollLinhaColunaGradeSimilares;

(*
  if parsistema.PermitirProdutoAlfanumerico then
  begin
    flkCodigoProduto.LocateParameters := 'produtovisual,codigobarras';
    flkCodigoProduto.LookupParameters := 'produtovisual,codigobarras';
    flkCodigoProduto.Lookupfield   := 'produtovisual';
    flkCodigoProduto.DataField     := 'produtovisual';
    if parsistema.PesquisaPadraoProdutoCodigoBarras then
    begin
      flkCodigoProduto.LookupQueryParameter := 'codigobarras';
      flkCodigoProduto.LocateQueryParameter := 'codigobarras';
    end
    else
    begin
      flkCodigoProduto.LookupQueryParameter := 'produtovisual';
      flkCodigoProduto.LocateQueryParameter := 'produtovisual';
    end;
  end
  else
  begin
    flkCodigoProduto.LocateParameters := 'produto,codigobarras';
    flkCodigoProduto.LookupParameters := 'produto,codigobarras';
    flkCodigoProduto.Lookupfield   := 'produto';
    flkCodigoProduto.DataField     := 'produto';
    if parsistema.PesquisaPadraoProdutoCodigoBarras then
    begin
      flkCodigoProduto.LookupQueryParameter := 'codigobarras';
      flkCodigoProduto.LocateQueryParameter := 'codigobarras';
    end
    else
    begin
      flkCodigoProduto.LookupQueryParameter := 'produto';
      flkCodigoProduto.LocateQueryParameter := 'produto';
    end;
  end;
*)

  gbxProduto.Caption := uppercase(flkCodigoProduto.FParameterLabel);

  if dbgDepositos.Columns[1].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgDepositos.Columns[1].Width := ParSistema.TamanhoMascaraQuantidade;

  if dbgSimilares.Columns[4].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgSimilares.Columns[4].Width := ParSistema.TamanhoMascaraQuantidade;
  if dbgSimilares.Columns[5].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgSimilares.Columns[5].Width := ParSistema.TamanhoMascaraQuantidade;

  if dbgProdutosorcamentos.ColumnbyName('quantidade').Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutosorcamentos.ColumnbyName('quantidade').width := ParSistema.TamanhoMascaraQuantidade;

//  dbgProdutos.ColumnByName('valorgrade1').Visible := ParSistema.UsarGradesProdutos;
//  dbgProdutos.ColumnByName('valorgrade2').Visible := ParSistema.UsarGradesProdutos;
//  dtmOrcamentos.OnScrollLinhaColunaGrade2 := AfterScrollLinhaColunaGrade;

  dtmOrcamentos.ConsultaExecutada:= False;

  flkCodigoProduto.exist;

  tstObservacoesVenda.TabVisible := trim(dtmOrcamentos.qryProcuraProdutoobservacoesvenda.asstring)<>'';
  tstPrecosCargos.TabVisible := ParSistema.PrecosporCargo;

  if tstObservacoesVenda.TabVisible then
    pgcExtraProdutos.TabIndex := 0
  else
    pgcExtraProdutos.TabIndex := 1;

  tabObservacoesVendaNaoSetado :=  trim(dtmOrcamentos.qryProcuraProdutoobservacoesvenda.asstring)<>'';

  pgcExtraProdutos.OwnerDraw := true;

  //dbgEstoque.ColumnByName('filial').visible := UsuarioLogin.GerenteEstoque;
  dbgEstoque.ColumnByName('customedio').visible := UsuarioLogin.GerenteEstoque;
  dbgEstoque.ColumnByName('precosemicms').visible := UsuarioLogin.GerenteEstoque;
  dbgEstoque.ColumnByName('precocomicms').visible := UsuarioLogin.GerenteEstoque;
  dbgEstoque.ColumnByName('valorultimacompra').visible := UsuarioLogin.GerenteEstoque;
  dbgEstoque.ColumnByName('ultimacompra_com_icms').visible := UsuarioLogin.GerenteEstoque;

  tstFornecedores.tabvisible := UsuarioLogin.GerenteEstoque;

end;


destructor TfrmProdutosOrcamento.Destroy;
begin
  inherited;
  frmProdutosOrcamento := nil;
end;

procedure TfrmProdutosOrcamento.edtDescricaoPrecoVendaExit(Sender: TObject);
begin
  inherited;
  edtDescricaoPrecoVenda.Enabled := False;
end;

procedure TfrmProdutosOrcamento.edtPrecoExit(Sender: TObject);
begin
  inherited;
  edtPreco.SendToBack;
end;

function TfrmProdutosOrcamento.ExisteInformacao(Parametro: Integer;
         NomeCampo: String; Value: Variant): Boolean;
begin
  case TipoConsulta of
         vocPRODUTO: Result := dtmOrcamentos.ExisteProduto(NomeCampo, Value);
          vocFILIAL: Result := dtmOrcamentos.ExisteFilialProduto(NomeCampo, Value);
 vocVENDEDORPRODUTO: Result := dtmOrcamentos.ExisteVendedor(NomeCampo, Value);
               else  Result := False
  end;
end;

procedure TfrmProdutosOrcamento.flkCodigoProdutoExit(Sender: TObject);
begin
  inherited;
  rgpMontagem.Enabled := dtmOrcamentos.ProdutoMontavel;
  if pnldesconto.Visible then
    if not edtdesconto.Focused and not parsistema.GravarProdutoContratoAutomaticamente then
      edtdesconto.SetFocus;
end;

procedure TfrmProdutosOrcamento.flkCodigoProdutoMessage(var Msg: String);
begin
  inherited;
  Msg := 'Produto não foi encontrado. Verifique se:'        + #13#10 +
         '- está cadastrado no estoque desta filial ou'     + #13#10 +
         '- está com o preço de venda diferente de zero ou' + #13#10 +
         '- já está incluído no orçamento.'
end;

procedure TfrmProdutosOrcamento.flkReservaMessage(var Msg: String);
begin
  inherited;
  Msg := 'A reserva não foi encontrada. Verifique se: ' + #13#10 +
         '- a reserva existe ou' + #13#10 +

         '- já foi finalizada ou' + #13#10 +

         '- item/filial pertencem a reserva ou' + #13#10 +

         '- vendedor que fez a reserva é o mesmo que está vendendo.'

end;

function TfrmProdutosOrcamento.InternoExcluir: Boolean;
begin
  Result:= inherited InternoExcluir;
  if Result then
    Result := dtmOrcamentos.ExcluirProdutoOrcamento;
end;

function TfrmProdutosOrcamento.InternoGravar: Boolean;
var
  Editando: Boolean;
begin
  Editando:= dtmOrcamentos.EditandoProdutosOrcamentos;
  Result := inherited InternoGravar;
  if Result then
    Result := dtmOrcamentos.GravarProdutoOrcamento;
    if Result and not Editando then begin
      if ParSistema.AbrirConsultaAutomaticamente then begin
        InternoIncluir;
        CtrlOn:= True;
        TipoConsulta:= vocPRODUTO;
        InternoPesquisar('Produtos');
      end;
    end;
end;

function TfrmProdutosOrcamento.InternoIncluir: Boolean;
begin
  try
//    dbgProdutos.dataSource := nil;
    Result:= inherited InternoIncluir;
    if Result then begin
      flkCodigoProduto.setfocus;
      flkCodigoProduto.selectall;
      Result := dtmOrcamentos.IncluirProdutosOrcamento;
      if (ParSistema.ValordaQuantidade > 0) then
        flkCodigoProduto.SetFocus
      else
        edtQuantidade.SetFocus;
    end
  finally
//     dbgProdutos.dataSource := dtmOrcamentos.dsrProdutosOrcamentos;
  end;
end;

function TfrmProdutosOrcamento.InternoPesquisar(Titulo: String): Integer;
{
var
  parametroAnterior, locateanterior: String;
  }

begin
  Result := mrNONE;
  if CtrlOn then begin
    if ActiveControl = flkFilial then begin
      TipoConsulta := vocFILIAL;
      Titulo:= ctFILIAIS;
    end
    else if ActiveControl = flkCodigoProduto then begin
      TipoConsulta := vocPRODUTO;
      Titulo:= ctPRODUTO;
    end
    else if ActiveControl = flkVendedor then begin
      TipoConsulta := vocVENDEDORPRODUTO;
      Titulo := ctVENDEDORES;
    end;
  end
  else
    TipoConsulta:= vocNENHUM;

  if TipoConsulta <> vocNENHUM then
  begin
    dtmOrcamentos.AbreTabelasOrcamento(TipoConsulta);

    dtmOrcamentos.ConsultaExecutada:= False;
    Result := inherited InternoPesquisar(Titulo);

    if Result = mrOK then
    begin
      if tipoconsulta = vocPRODUTO then
      begin
        if ParSistema.GravarProdutoContratoAutomaticamente then
        begin
          if dtmOrcamentos.SelecionarProdutoContratoConsulta then
          begin
            flkCodigoProduto.Exist;
            flkcodigoproduto.Modified := true;
            flkCodigoProduto.DoExit;

            if not dtmOrcamentos.ConsultaExecutada then
            begin
              if dtmOrcamentos.SelecionarProdutoContratoConsulta then
              flkCodigoProdutoFound(true);
            end;
            InternoGravar;
          end
        end
        else
        begin
          if not dtmOrcamentos.ConsultaExecutada then
          begin
            if dtmOrcamentos.SelecionarProdutoContratoConsulta then
            begin
              flkCodigoProdutoFound(true);
              InternoGravar;
            end;
          end;
        end;
      end
      else
        dtmOrcamentos.SelecionaTabelasOrcamento(TipoConsulta);

    end;
    dtmOrcamentos.FechaTabelasConsulta(TipoConsulta);
  end
end;

function TfrmProdutosOrcamento.JanelaPesquisa: TfrmConsultaBasica;
begin
  Result := TfrmConsultaPorCampo.Create(nil);
  TfrmConsultaPorCampo(Result).ConsultaInterativa := ((TipoConsulta <> vocPRODUTO) or
                                                      ((TipoConsulta = vocPRODUTO) and
                                                        ParSistema.UsarConsultaInterativa));
  TfrmConsultaPorCampo(Result).UsarParametrosDaTabela := False;
end;

procedure TfrmProdutosOrcamento.sbnAlterarPrecoClick(Sender: TObject);
var
  UsuarioAut: TtecUsuarios;
  AlterarPreco: Boolean;
begin
  inherited;
  if UsuarioLogin.AlterarPrecoContrato then
    AlterarPreco := True
  else begin
    try
      UsuarioAut := dtmOrcamentos.ObterAutorizacao(taLOGIN, ctALTERARPRECOVENDA, ctAUTORIZADO);
      try
        if Assigned(UsuarioAut) then
          AlterarPreco := UsuarioAut.AlterarPrecoContrato
        else begin
          AlterarPreco := False;
          MensagemAviso(Format(ctUSUARIOSEMCADASTRO, ['']))
        end
      finally
        if Assigned(UsuarioAut) then
          UsuarioAut.Free;
      end
    except
      AlterarPreco := False
    end
  end;
  if AlterarPreco then begin
    edtPreco.BringToFront;
    edtPreco.SetFocus;
    edtDescricaoPrecoVenda.Enabled := True;
  end else begin
    MensagemAviso(Format(ctUSUARIONAOAUTORIZADO, [ctMODIFICAPRECO]));
    if Assigned(ActiveControl) then
         ActiveControl.SetFocus
    else edtQuantidade.SetFocus
  end
end;

procedure TfrmProdutosOrcamento.sbnConsultaFilialClick(Sender: TObject);
begin
  inherited;
  CtrlOn:= True;
  flkFilial.SetFocus;
  InternoPesquisar('')
end;

procedure TfrmProdutosOrcamento.sbnConsultaProdutoClick(Sender: TObject);
begin
  inherited;
  CtrlOn:= True;
  flkCodigoProduto.SetFocus;
  InternoPesquisar('')
end;

function TfrmProdutosOrcamento.TabelaDePesquisa: TZDataSet;
begin
  case TipoConsulta of
         vocPRODUTO: Result := dtmOrcamentos.TabelaConsultaProdutos;
          vocFILIAL: Result := dtmOrcamentos.TabelaConsultaFilialProduto;
 vocVENDEDORPRODUTO: Result := dtmOrcamentos.TabelaConsultaVendedores;
               else  Result := nil;
  end;
end;

procedure TfrmProdutosOrcamento.flkFilialMessage(var Msg: String);
begin
  inherited;
  Msg := 'Filial inválida. Verifique se:'        + #13#10 +
         '- está cadastrada ou'     + #13#10 +
         '- está inativa ou' + #13#10 +
         '- se o produto já está incluído no orçamento com a mesma filial.'
end;

procedure TfrmProdutosOrcamento.KeyDown(var Key: Word; Shift: TShiftState);
begin
  case key of
    VK_Return: if Shift = [] then
               begin
                 if ((ActiveControl = flkCodigoProduto) and (ParSistema.GravarProdutoContratoAutomaticamente)) then
                 begin
                   inherited;
                   if InternoGravar then
                   begin
                     flkCodigoProduto.setfocus;
                     flkCodigoProduto.selectall;
                   end;
                 end
                 else
                 if ActiveControl = flkVendedor then
                 begin
                   if sbnSalvar.Enabled then
                     InternoGravar;
                 end
                 else
                   inherited;
               end;
    else inherited;
  end



end;


procedure TfrmProdutosOrcamento.sbnProcurarVendedorClick(Sender: TObject);
begin
  inherited;
  CtrlOn:= True;
  flkVendedor.SetFocus;
  InternoPesquisar('')
end;

procedure TfrmProdutosOrcamento.AfterScrollLinhaColunaGradeSimilares(
  Sender: TObject);
begin
  dbgSimilares.Columns[2].Title.Caption := dtmOrcamentos.LinhadaGradeSimilares;
  dbgSimilares.Columns[3].Title.Caption := dtmOrcamentos.ColunadaGradeSimilares;
end;

procedure TfrmProdutosOrcamento.dbgSimilaresDblClick(Sender: TObject);
begin
  inherited;
  dtmOrcamentos.TrocaProdutoOrcamentoporSimilar;
end;

procedure TfrmProdutosOrcamento.FormShow(Sender: TObject);
begin
  inherited;

//  dbgProdutosOrcamentonws.dataSource := dtmOrcamentos.dsrProdutosOrcamentos;

  if (dtmOrcamentos.IncluindoProdutosOrcamentos) and
      ParSistema.AbrirConsultaAutomaticamente then
    sbnConsultaProdutoClick(self);
end;

procedure TfrmProdutosOrcamento.flkCodigoProdutoKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  gbxProduto.Caption := uppercase(flkCodigoProduto.FParameterLabel);
end;

procedure TfrmProdutosOrcamento.edtQuantidadeKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  case key of
    VK_return :
    {bloqueado a linha abaixo devido ao fato que ao voltar do produto para a
     quantidade, mesmo alterando a quantidade o valor fica 1 pois
     esta editando e n?incluindo}
//      if dtmCadastroContratos.IncluindoProdutosContratos then
        flkCodigoProduto.ConfirmarQuantidade := true;
  end;

end;

procedure TfrmProdutosOrcamento.flkCodigoProdutoFound(Found: Boolean);
begin
  inherited;
  if found and not dtmOrcamentos.ConsultaExecutada then
  begin
    if ParSistema.ProdutoVendaFutura then
    begin
      if not dtmOrcamentos.ValidarProdutosContratos then
        edtQuantidade.SetFocus;
    end
    else
      dtmOrcamentos.SelecionarProdutoContratoProcura;
  end;

  if parsistema.GravarProdutoContratoAutomaticamente then
  begin
    flkCodigoProduto.setfocus;
    flkCodigoProduto.SelectAll;
  end
  else
  if pnldesconto.Visible then
  begin
    edtdesconto.SetFocus;
    edtdesconto.selectall;
  end;

end;

procedure TfrmProdutosOrcamento.flkCodigoProdutoEnter(Sender: TObject);
begin
  inherited;
  TipoConsulta := vocPRODUTO;
end;

procedure TfrmProdutosOrcamento.flkFilialEnter(Sender: TObject);
begin
  inherited;
  TipoConsulta := vocFILIAL

end;

procedure TfrmProdutosOrcamento.flkFilialFound(Found: Boolean);
begin
  inherited;
  if found then
    dtmOrcamentos.SelecionarFilialContratoProcura;

end;

procedure TfrmProdutosOrcamento.sbnVisualizarFotoClick(Sender: TObject);
begin
  inherited;
  AcionarTelaVisualizarImageURL(self, dtmOrcamentos.GetProduto);
end;

