unit fmprodutosordemservico;

interface

uses
  //CLX
  SysUtils, Types, Classes, Graphics, Controls, Forms, Dialogs, Windows,
  StdCtrls, ExtCtrls, Buttons, DBCtrls, Mask, ComCtrls, {Qete,}
  //Biblio
  ctconstantes,
  //Componentes
  cpdbtext, cpnumero, cpdbfindcontrols, cpdbradiogroup,
  //Terceiros
  ZQuery,
  //Repositorio
  fmcadastropadrao, fmconsultabasica,
  cptexto, ActnList, Grids, DBGrids, cpdbgrid, cpdbdata, ToolWin, cpdbmemo;

type
  TfrmProdutosOrdemServico = class(TfrmCadastroPadrao)
    flkCodigoProduto: TtecDBFindLookup;
    edtQuantidade: TDBEditNumero;
    dtxUnidade: TtecDBText;
    dtxDescricaoProduto: TtecDBText;
    edtPreco: TDBEditNumero;
    flkFilial: TtecDBFindLookup;
    dtxNomeFilial: TtecDBText;
    sbnConsultaProduto: TSpeedButton;
    sbnConsultaFilial: TSpeedButton;
    pnlFundoJanela: TPanel;
    gbxFundoJanela: TGroupBox;
    dtxPrecoProduto: TtecDBText;
    sbnAlterarPreco: TSpeedButton;
    edtDescricaoPrecoVenda: TDBEditTexto;
    dtxEmEstoque: TtecDBText;
    dbgDepositos: TtecDBGrid;
    aclHabilitar: TActionList;
    actHabilitarControles: TAction;
    dtxNomeVendedor: TtecDBText;
    sbnProcurarVendedor: TSpeedButton;
    edtInclusao: TDBEditData;
    dtxCodigoBarras: TtecDBText;
    gbxData: TGroupBox;
    gbxProduto: TGroupBox;
    gbxFilial: TGroupBox;
    gbxQuantidade: TGroupBox;
    gbxEmEstoque: TGroupBox;
    gbxVendedor: TGroupBox;
    gbxDepositos: TGroupBox;
    flkVendedor: TtecDBFindLookup;
    gbxXPed: TGroupBox;
    edtXPed: TDBEditTexto;
    gbxNItemPed: TGroupBox;
    edtnItemPed: TDBEditNumero;
    gbxProdCliente: TGroupBox;
    edtProduto: TDBEditTexto;
    gbxPartNumber: TGroupBox;
    edtPN: TDBEditNumero;
    gbxFinalidade: TGroupBox;
    edtFinalidade: TDBEditTexto;
    GroupBox1: TGroupBox;
    lblPrecoNormal: TLabel;
    lblPromocao: TLabel;
    lblPrecoProduto: TLabel;
    lblDescricaoPreco: TLabel;
    lblDecricaoAlteracaoPreco: TLabel;
    dtxPrecoNormal: TtecDBText;
    dtxDescricaoPreco: TtecDBText;
    pnlDesconto: TPanel;
    lbldesconto: TLabel;
    edtdesconto: TDBEditNumero;
    rgpBrinde: TtecDBRadioGroup;
    rbnBrindeSIM: TtecRadioButton;
    rbnBrindeNAO: TtecRadioButton;
    rgpMontagem: TtecDBRadioGroup;
    rbnMontagemSIM: TtecRadioButton;
    rbnMontagemNAO: TtecRadioButton;
    rgpMonstruario: TtecDBRadioGroup;
    rbnMonstruarioSIM: TtecRadioButton;
    rbnMonstruarioNAO: TtecRadioButton;
    rgbEntrega: TtecDBRadioGroup;
    Label1: TLabel;
    rbnEntregaSIM: TtecRadioButton;
    rbnEntregaNAO: TtecRadioButton;
    edtDias: TDBEditTexto;
    gbxExibicaoPrecos: TGroupBox;
    gbxUltimaVenda: TGroupBox;
    gbxDataUltimaVenda: TGroupBox;
    dtxDataUltimaVenda: TtecDBText;
    gbxValorUltimaVenda: TGroupBox;
    dtxValorUltimaVenda: TtecDBText;
    gbxUltimoOrcamento: TGroupBox;
    gbxDataUltimoOrcamento: TGroupBox;
    dtxDataUltimoOrcamento: TtecDBText;
    gbxValorUltimoOrcamento: TGroupBox;
    dtxValorUltimoOrcamento: TtecDBText;
    gbxPrecodoCliente: TGroupBox;
    gbxPrecoCliente: TGroupBox;
    dtxPrecoAtualdoCliente: TtecDBText;
    gbxAlteracaoValornoCliente: TGroupBox;
    dtxAlteracaoPrecoCliente: TtecDBText;
    GroupBox2: TGroupBox;
    GroupBox3: TGroupBox;
    dtxPrecoNormalCliente: TtecDBText;
    pgcExtraProdutos: TPageControl;
    tstProdutosSimilares: TTabSheet;
    bvlProdutosSimilares: TBevel;
    dbgSimilares: TtecDBGrid;
    tstModelodeProdutos: TTabSheet;
    dbgModelos: TtecDBGrid;
    mmoObservacaoModelo: TtecDBMemo;
    gbxReserva: TGroupBox;
    sbnConsultaReserva: TSpeedButton;
