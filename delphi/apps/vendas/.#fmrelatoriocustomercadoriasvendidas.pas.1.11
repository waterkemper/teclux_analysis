constructor Tfrmrelatoriocustomercadoriasvendidas.Create(
  Aowner: Tcomponent);
begin
  dtmrelatoriocustoMercadoriasVendidas := TdtmrelatoriocustoMercadoriasVendidas.Create(Self);
  inherited;
  dtmrelatoriocustoMercadoriasVendidas.Abre(ctTabelas);
  edtDataInicial.Text := DateToStr(PrimeiroDiaMesPassado(0));
  edtDataFinal.Text := DateToStr(DataLocal);

  fraSelecaoAleatoriaRegioes.CampoParaLista := 'codigo';
  fraSelecaoAleatoriaRegioes.qrySelecaoAleatoria.Open;
  with fraSelecaoAleatoriaRegioes do
  begin
    ConsultaSelecaoAleatoria := TfraConsultaCodigo.Create(self);
    ConsultaSelecaoAleatoria.Name := 'fraConsultaSelecaoAleatoriaRegioes';
    ConsultaSelecaoAleatoria.edfCodigo.MaxLength := 4;
    ConsultaSelecaoAleatoria.edfCodigo.DataSource := dsrSelecaoAleatoria;
    ConsultaSelecaoAleatoria.edfCodigo.DataField := 'codigo';
    ConsultaSelecaoAleatoria.edfCodigo.Operacao := opATRIBUICAO;
    ConsultaSelecaoAleatoria.edfCodigo.LookupSource := ConsultaSelecaoAleatoria.dsrProcuraRegioes;
    ConsultaSelecaoAleatoria.edfCodigo.LookupQueryParameter := 'Codigo';
    ConsultaSelecaoAleatoria.edfCodigo.LookupField := 'Codigo';
    ConsultaSelecaoAleatoria.AbrirTabelaProcura := false;
//    ConsultaSelecaoAleatoria.CondicoesdaConsulta := CondicoesFluxoGramasOperacoes;
    ConsultaSelecaoAleatoria.TipoPesquisa := pesRegioes;
    ConsultaSelecaoAleatoria.OnFound := AtribuirDadosRegioes;
  end;

  ObterLista(dtmrelatoriocustoMercadoriasVendidas.ListaConceitos, clbConceitos);

  fraConsultaFornecedor.qryProcuraCliente.ParamByName('NaoConsiderarTipoCliente').asBoolean := false;
  fraConsultaFornecedor.TipoPesquisa := pesFORNECEDORES;
  fraConsultaFornecedor.TipoCliente := 'F';
  fraConsultaFornecedor.Tipovfornecedor := 'F';

end;

destructor Tfrmrelatoriocustomercadoriasvendidas.Destroy;
begin
  dtmrelatoriocustoMercadoriasVendidas:=nil;
  inherited;
  frmrelatoriocustoMercadoriasVendidas:=nil;
end;

function Tfrmrelatoriocustomercadoriasvendidas.ExisteInformacao(
  Parametro: Integer; NomeCampo: String; Value: Variant): Boolean;
begin
  with dtmrelatoriocustomercadoriasvendidas do
    case tipoPesquisa of
      rvITEMPRODUTOSINICIAL,
      rvITEMPRODUTOSFINAL    : result := ExisteItemProdutos(NomeCampo, Value);
      rvGRUPOPRODUTOSINICIAL,
      rvGRUPOPRODUTOSFINAL   : result := ExisteGrupoProdutos(NomeCampo, Value);
      rvPRODUTOSINICIAL,
      rvPRODUTOSFINAL        : result := ExisteProdutos(NomeCampo, Value);
      rvCLASSESINICIAL,
      rvCLASSESFINAL         : result := ExisteClasses(NomeCampo, Value);
      rvCLIENTESINICIAL,
      rvCLIENTESFINAL        : result := ExisteCliente(NomeCampo, Value);
    else
      result := false;
    end;
end;

procedure Tfrmrelatoriocustomercadoriasvendidas.InternoImpressao;
begin
  inherited;
  MontaPesquisa;
end;

function Tfrmrelatoriocustomercadoriasvendidas.InternoPesquisar(
  Titulo: String): Integer;
begin
  Result := mrNone;
  if ActiveControl is TtecFindCustom then
  begin
   if CtrlOn then
   begin
    if ActiveControl=edfItemProdutoInicial then
      TipoPesquisa := rvITEMPRODUTOSINICIAL
    else if ActiveControl=edfItemProdutoFinal then
      TipoPesquisa := rvITEMPRODUTOSFINAL
    else if ActiveControl=edfGrupoProdutoInicial then
      TipoPesquisa := rvGRUPOPRODUTOSINICIAL
    else if ActiveControl=edfGrupoProdutoFinal then
      TipoPesquisa := rvGRUPOPRODUTOSFINAL
    else if ActiveControl=edfProdutoInicial then
      TipoPesquisa := rvPRODUTOSINICIAL
    else if ActiveControl=edfProdutoFinal then
      TipoPesquisa := rvPRODUTOSFINAL
    else if ActiveControl=edfClasseInicial then
      TipoPesquisa := rvCLASSESINICIAL
    else if ActiveControl=edfClasseFinal then
      TipoPesquisa := rvCLASSESFINAL
    else if ActiveControl = edfClienteInicial then
      TipoPesquisa := rvCLIENTESINICIAL
    else if ActiveControl = edfClienteFinal then
      TipoPesquisa := rvCLIENTESFINAL;
    with dtmrelatoriocustomercadoriasvendidas do
    begin
       AbreTabelaPesquisa(TipoPesquisa);
       Result:= inherited InternoPesquisar(Titulo);
       if Result = mrOK then
         Selecionar(TipoPesquisa);
       FechaTabelaPesquisa(TipoPesquisa);
    end;
   end;
  end;
end;

function Tfrmrelatoriocustomercadoriasvendidas.JanelaPesquisa: TfrmConsultaBasica;
var
  Jan: TfrmConsultaPorCampo;

begin
  Jan := TfrmConsultaPorCampo.Create(nil);
  Jan.ConsultaInterativa := Not (TipoPesquisa in [rvCLIENTESINICIAL, rvCLIENTESFINAL,

                                                  rvITEMPRODUTOSINICIAL, rvITEMPRODUTOSFINAL,

                                                  rvPRODUTOSINICIAL, rvPRODUTOSFINAL]) and CtrlOn;

  Jan.UsarParametrosDaTabela := False;

  Result := Jan

end;

procedure Tfrmrelatoriocustomercadoriasvendidas.MontaPesquisa;
begin
  if ValidarCamposSelecao then begin
    with dtmrelatoriocustomercadoriasvendidas do
    begin
      ParametroCabecalho :='';
      DataInicial        := edtDataInicial.Text;
      DataFinal          := edtDataFinal.Text;
      Filial            := fraListaFiliais1.ListaSelecionada;
      GrupoFilial       := fraListaGruposFiliais1.ListaSelecionada;
      if GrupoFilial<>'' then
        ParametroCabecalho:=ParametroCabecalho+' Grupo de Filiais: '+GrupoFilial
      else
      if Filial<>'' then
        ParametroCabecalho:=ParametroCabecalho+' Filiais: '+Filial;
      MontarFiltroConceitos(clbConceitos);
      ListadeRegioes := fraSelecaoAleatoriaRegioes.StringSelecionada; 
      ParametroSelecaoProdutos   := rgpSelecaoProduto.ItemIndex;
      ParametroCodigoItemInicial := edfItemProdutoInicial.Text;
      ParametroCodigoItemFinal   := edfItemProdutoFinal.Text;
      ParametroCodigoInicial     := edfProdutoInicial.Text;
      ParametroCodigoFinal       := edfProdutoFinal.Text;
      ParametroGrupoInicial      := edfGrupoProdutoInicial.Text;
      ParametroGrupoFinal        := edfGrupoProdutoFinal.Text;
      ParametroClasseInicial     := edfClasseInicial.Text;
      ParametroClasseFinal       := edfClasseFinal.Text;
      ParametroSelecaoClientes   := rgpSelecaoClientes.ItemIndex;
      ParametroClienteInicial    := edfClienteInicial.Text;
      ParametroClienteFinal      := edfClienteFinal.Text;

      ParametroFornecedor(fraConsultaFornecedor.qryProcuraClientecodigo.asString, fraConsultaFornecedor.qryProcuraClientetipo.asString);

      ProdutoEmLinha     := ckbProdutoEmLinha.checked;
      ProdutoForadeLinha := ckbProdutoForadeLinha.checked;
      ProdutoComMontagem := ckbProdutoComMontagem.Checked;
      ProdutoSemMontagem := ckbProdutoSemMontagem.Checked;
      ProdutoBrinde      := ckbProdutoBrinde.Checked;
      ProdutoNaoBrinde   := ckbProdutoNaoBrinde.Checked;
      ListarVendas       := ckbListarVendas.Checked;
      ListarDevolucoesdoPeriodo  := ckbListarDevolucoesdoPeriodo.Checked;
      ListarDevolucoesAnteriores  := ckbListarDevolucoesAnteriores.Checked;
      MostrarPlanos      := ckbMostrarPlanos.Checked;
      TipodeResumo       := rgpTipodeResumo.ItemIndex;
      Resumo             := rgpResumo.ItemIndex;
      AgruparGrupoFilial := ckbAgruparGrupoFilial.Checked;
      AgruparFilial      := ckbAgruparFilial.Checked;
      AgruparConceito    := ckbAgruparConceitos.checked;
      AgruparCliente     := ckbAgruparCliente.Checked;
      Ordenacao          := rgpOrdenacao.ItemIndex;
      Totalizacao        := rgpTotalizacao.ItemIndex;
      MontarSQL;
      MontaDatas;
      MontarOrdenacao;
      qryrelatoriocustomercvendidas.Open;
      if not (qryrelatoriocustomercvendidas.IsEmpty) then
       ImprimirRelatorio('CUSTO DE MERCADORIAS VENDIDAS')
      else
       MensagemAviso(Format(ctNENHUMREGISTROENCONTRADO,['Registro']));
    end;
  end;
end;

function Tfrmrelatoriocustomercadoriasvendidas.TabelaDePesquisa: TZdataSet;
begin
  with dtmrelatoriocustomercadoriasvendidas do
    case TipoPesquisa of
             rvITEMPRODUTOSINICIAL,
             rvITEMPRODUTOSFINAL  : Result := ConsultaItemProdutos;
             rvGRUPOPRODUTOSINICIAL,
             rvGRUPOPRODUTOSFINAL : Result := ConsultaGrupoProdutos;
             rvCLASSESINICIAL,
             rvCLASSESFINAL       : Result := ConsultaClasses;
             rvPRODUTOSINICIAL,
             rvPRODUTOSFINAL      : Result := ConsultaProdutos;
             rvCLIENTESINICIAL,
             rvCLIENTESFINAL      : Result := ConsultaClientes;
    else
             Result:= nil;
    end;
end;

function Tfrmrelatoriocustomercadoriasvendidas.ValidarCamposSelecao: Boolean;
begin
 Result:=(ckbProdutoEmLinha.Checked or ckbProdutoForadeLinha.Checked) and
         (ckbProdutoComMontagem.Checked or ckbProdutoSemMontagem.Checked) and
         (ckbProdutoBrinde.Checked or ckbProdutoNaoBrinde.Checked);
 if Result then
 begin
  Result:=(ckbListarVendas.Checked or
           ckbListarDevolucoesdoPeriodo.Checked or
           ckbListarDevolucoesAnteriores.Checked);
  if Result then
  begin
   Result := (edtDataInicial.DataValida and edtDataFinal.DataValida);
   if Result then
   begin
    if (not dataembranco(edtDataInicial.text) and not dataembranco(edtDataFinal.text)) then
      Result:=StrToDate(edtDataInicial.Text) <= StrToDate(edtDataFinal.Text);
    if result then
    begin
      Result:=(not dataembranco(edtDataInicial.text) or not dataembranco(edtDataFinal.text));
      if Result then
      Result := OperadorTernario((Trim(edfItemProdutoInicial.Text) <> ''), edfItemProdutoInicial.Exist, True) and
                OperadorTernario((Trim(edfProdutoInicial.Text) <> ''), edfProdutoInicial.Exist, True) and
                OperadorTernario((Trim(edfGrupoProdutoInicial.text) <> ''), edfGrupoProdutoInicial.Exist, True) and
                OperadorTernario((Trim(edfClasseInicial.Text) <> ''), edfClasseInicial.Exist, True)
      else
      begin
       MensagemAviso(ctPARAMETROSINEXISTENTES);
       edtDataInicial.SetFocus;
      end;
    end
    else
    begin
      MensagemAviso(ctDTINICIALMAIORDTFINAL);
      edtDataInicial.SetFocus;
    end;
   end;
  end
  else
  begin
   MensagemAviso(ctPARAMETROSINEXISTENTES);
   ckbListarVendas.SetFocus;
  end;
 end
 else
 begin
   MensagemAviso(ctPARAMETROSINEXISTENTES);
   ckbProdutoEmLinha.SetFocus;
 end;
end;

