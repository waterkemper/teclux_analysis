    procedure ckbFechadasClick(Sender: TObject);
    procedure FormShow(Sender: TObject);
    procedure ckbGarantiaClick(Sender: TObject);
  private
    { Private declarations }
  protected
   TipoConsulta: TtecOrdemServicoTipoConsulta;
   procedure InternoImpressao; override;
   function  ValidarCamposSelecao: Boolean;
