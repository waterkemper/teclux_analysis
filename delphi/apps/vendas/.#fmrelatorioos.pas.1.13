  dmrelatorioos, ctconstantes, clparametrossistema,
  fmconsultabasica, fmconsultaporcampo, zquery, biblio, frconsulta,
  frconsultacodigo, ToolWin, ComCtrls, AdvListV, DBAdvLst, AdvCombo,
  Lucombo, dblucomb, AdvDBComboBox, slstbox, dbslstbox, paramchklist,
  AdvEdit, advlued, dbadvle, DBLup2, clisted, BtnListB,
  paramlst, ColListb, ColCombo, dblookup, Grids, DBGrids, lpLstBox,
  frlistatiposAtendimentos;

type
  TfrmRelatorioOS = class(TFrmRelatorioPadrao)
    gbxPeriodoAbertura: TGroupBox;
    lblVencimentoInicial: TLabel;
    edtDataInicialAbertura: TEditData;
    lblVencimentoFinal: TLabel;
    edtDataFinalAbertura: TEditData;
    gbxPeriodoFechamento: TGroupBox;
    lblInicioFechamento: TLabel;
    edtDataInicialFechamento: TEditData;
    lblFimFechamento: TLabel;
    edtDataFinalFechamento: TEditData;
    ckbCustoMedio: TCheckBox;
    rgpTipoRelatorio: TRadioGroup;
    gbxCliente: TGroupBox;
    gbxFiliais: TGroupBox;
    fraConsultaFilial: TfraConsultaCodigo;
    fraConsultaCliente: TfraConsultaCodigo;
    rgpTipoEquipamento: TGroupBox;
    ckbNovoCliente: TCheckBox;
    ckbUsadoCliente: TCheckBox;
    ckbAtivoFixo: TCheckBox;
    ckbEstoque: TCheckBox;
    gbxGarantiaCortesia: TGroupBox;
    ckbGarantia: TCheckBox;
    ckbCortesia: TCheckBox;
    cmbLogicalGarantia: TComboBox;
    gbxSituacaoGarantia: TGroupBox;
    ckbGarantiaAprovada: TCheckBox;
    ckbGarantiaReprovada: TCheckBox;
    ckbNaoDefinida: TCheckBox;
    gbxEquipamento: TGroupBox;
    fraConsultaEquipamento: TfraConsultaCodigo;
    gbxSituacao: TGroupBox;
    ckbReservado: TCheckBox;
    ckbNotaParcial: TCheckBox;
    ckbCancelado: TCheckBox;
    ckbNotaFiscal: TCheckBox;
    ckbOrcado: TCheckBox;
    fraListatiposatendimentos: TfraListatiposatendimentos;
    GroupBox2: TGroupBox;
    ckbComAtendimento: TCheckBox;
    ckbSemAtendimento: TCheckBox;
