      inherited qryLista: TtecQuery
        Sql.Strings = (
          'select cast('#39'Registro'#39' as varchar(50)) as CAMPODESCRICAO, '
          '           cast('#39'Registro'#39' as varchar(50)) as CAMPO,'
          '          cast('#39'Desc'#39' as varchar) as TIPO'
          'UNION ALL'
          'select cast('#39'Pedido Cliente'#39' as varchar(50)) as CAMPODESCRICAO, '
          '           cast('#39'PedidoCliente'#39' as varchar(50)) as CAMPO,'
          '          cast('#39'Asc'#39' as varchar) as TIPO'
          'UNION ALL'
          'select cast('#39'Contrato'#39' as varchar(50)) as CAMPODESCRICAO, '
          '           cast('#39'CONTRATO'#39' as varchar(50)) as CAMPO,'
          '          cast('#39'Asc'#39' as varchar) as TIPO'
          'UNION ALL'
          'select cast('#39'Faturamento'#39' as varchar(50)) as CAMPODESCRICAO, '
          '           cast('#39'FATURAMENTO'#39' as varchar(50)) as CAMPO,'
          '          cast('#39'Asc'#39' as varchar) as TIPO'
          'UNION ALL'
          'select cast('#39'Data'#39' as varchar(50)) as CAMPODESCRICAO, '
          '           cast('#39'DATA'#39' as varchar(50)) as CAMPO,'
          '          cast('#39'Desc'#39' as varchar) as TIPO'
          'UNION ALL'
          'select cast('#39'Produto'#39' as varchar(50)) as CAMPODESCRICAO, '
          '           cast('#39'PRODUTO'#39' as varchar(50)) as CAMPO,'
          '          cast('#39'Asc'#39' as varchar) as TIPO'
          'UNION ALL'
          
            'select cast('#39'Descri'#231#227'o Produto'#39' as varchar(50)) as CAMPODESCRICA' +
            'O, '
          '           cast('#39'DESCRICAO'#39' as varchar(50)) as CAMPO,'
          '          cast('#39'Asc'#39' as varchar) as TIPO'
          'UNION ALL'
          
            'select cast('#39'Produto Cliente'#39' as varchar(50)) as CAMPODESCRICAO,' +
            ' '
          '           cast('#39'PRODUTO_CLIENTE'#39' as varchar(50)) as CAMPO,'
          '          cast('#39'Asc'#39' as varchar) as TIPO'
          'UNION ALL'
          'select cast('#39'Pre'#231'o Venda'#39' as varchar(50)) as CAMPODESCRICAO, '
          '           cast('#39'TOTALPRECOVENDA'#39' as varchar(50)) as CAMPO,'
          '          cast('#39'Asc'#39' as varchar) as TIPO')
      end
    end
