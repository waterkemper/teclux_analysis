end;

procedure TfrmTrocaMercadorias.dbgProdutosKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if (Key = VK_F2) then
    if (Shift = [ssCtrl]) then
      IncluirEditarProdutosContrato(True)
    else if (Shift = [ssCtrl, ssAlt]) then
      IncluirEditarProdutosContrato(True)
end;

