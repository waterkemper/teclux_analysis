{ TfrmTrocaMercadorias }

procedure TfrmTrocaMercadorias.actHabilitarBotoesUpdate(Sender: TObject);
begin
  inherited;
  HabilitarBotoes;
  ExibirNovosValores(nil);
end;

procedure TfrmTrocaMercadorias.AfterScrollContratosClientes(Sender: TObject);
begin
end;

constructor TfrmTrocaMercadorias.Create(AOwner: TComponent);
begin
  dtmTrocaMercadorias:= TdtmTrocaMercadorias.Create(Self);
  inherited;
  DataSet:= dtmTrocaMercadorias.TabelaContrato;
  dtmTrocaMercadorias.Abre(ctVendaTabelaCadastroContrato);
  pgcTrocaMercadorias.ActivePageIndex := 0;
  pgcVendedor.ActivePage        := tstVendedor;
  pgcProdutosParcelas.ActivePage:= tstProdutos;
  dtmTrocaMercadorias.AfterScrollContratosClientes:= AfterScrollContratosClientes;
  dtmTrocaMercadorias.OnScrollLinhaColunaGrade := AfterScrollLinhaColunaGrade;
  dbgProdutosContratos.Columns[2].Visible := ParSistema.UsarGradesProdutos;
  dbgProdutosContratos.Columns[3].Visible := ParSistema.UsarGradesProdutos;

  pgcTrocaMercadorias.ActivePage := tstPreSelecao;

  flkVendedor.Enabled := Not UsuarioLogin.Vendedor;
  if UsuarioLogin.Vendedor then begin
    dtmTrocaMercadorias.VendedorDefault := UsuarioLogin.CodigoUsuario;
    dtxNomeVendedor.Width := dtxNomeVendedor.Width + dtxNomeVendedor.Left - flkVendedor.Left;
    dtxNomeVendedor.Left := flkVendedor.Left;
    dtxNomeVendedor.BringToFront;
  end;

  dbgProdutos.Columns[1].Visible := Not ParSistema.FiliaisIndependentes;
  dbgProdutos.Columns[4].Visible := ParSistema.UsarGradesProdutos;
  dbgProdutos.Columns[5].Visible := ParSistema.UsarGradesProdutos;
  
  dbgProdutos.ColumnByName('reserva').Visible := not parsistema.IncluirOrcamentonosItensdaTroca;

  dtmTrocaMercadorias.OnScrollLinhaColunaGrade := AfterScrollLinhaColunaGrade;
  dbgProdutosContratos.SelectedIndex := 10;

  if dbgProdutosContratos.Columns[6].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutosContratos.Columns[6].Width := ParSistema.TamanhoMascaraQuantidade;
  if dbgProdutosContratos.Columns[7].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutosContratos.Columns[7].Width := ParSistema.TamanhoMascaraQuantidade;
  if dbgProdutosContratos.Columns[8].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutosContratos.Columns[8].Width := ParSistema.TamanhoMascaraQuantidade;
  if dbgProdutosContratos.Columns[10].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutosContratos.Columns[10].Width := ParSistema.TamanhoMascaraQuantidade;
  if dbgProdutosContratos.Columns[11].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutosContratos.Columns[11].Width := ParSistema.TamanhoMascaraQuantidade;

  if dbgProdutosaTrocar.Columns[6].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutosaTrocar.Columns[6].Width := ParSistema.TamanhoMascaraQuantidade;

  if dbgProdutos.ColumnByName('quantidade').Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutos.ColumnByName('quantidade').Width := ParSistema.TamanhoMascaraQuantidade;

  if dbgProdutosNotasPag.Columns[2].Width < ParSistema.TamanhoMascaraQuantidade then
    dbgProdutosNotasPag.Columns[2].Width := ParSistema.TamanhoMascaraQuantidade;

  pgcProdutosNotas.ActivePage := tstProdutosEntradaseSaidas;
  dtmTrocaMercadorias.ExibirNovosValores := ExibirNovosValores;

  dbgServicos.visible := parsistema.contratocomservico;
  self.activecontrol :=  edfCliente;

end;

procedure TfrmTrocaMercadorias.dbgParcelasContratosKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
{
  if Shift = [ssCtrl] then begin
    case Key of
      TeclaEditarRegistro : if dtmTrocaMercadorias.PodeAlterarParcela then
                              AcionaCadastroParcelas(True);
      TeclaInserirRegistro: AcionaCadastroParcelas(False);
    end;
  end;
 G}
end;

procedure TfrmTrocaMercadorias.dbgProdutosContratosDrawColumnCell(
  Sender: TObject; const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  if not TDBGrid(Sender).DataSource.DataSet.IsEmpty then
  begin
    if (TDBGrid(Sender).DataSource.DataSet.FieldByName('quantidade').AsCurrency =
        TDBGrid(Sender).DataSource.DataSet.FieldByName('cancelado').AsCurrency) then
        TDBGrid(Sender).Canvas.Brush.Color := $FFCB97;

    if TDBGrid(Sender).DataSource.DataSet.FieldByName('brinde').AsBoolean then
        TDBGrid(Sender).Canvas.Brush.Color := $7DBEFF;

    if (TDBGrid(Sender).DataSource.DataSet.FieldByName('devolver').AsCurrency > 0) then begin
      TDBGrid(Sender).Canvas.Brush.Color := clInfoBk;
      if TDBGrid(Sender).DataSource.DataSet.FieldByName('defeito').AsBoolean then
           TDBGrid(Sender).Canvas.Font.Color := clRed
      else TDBGrid(Sender).Canvas.Font.Color := clBlack;
    end;
    TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
  end;
end;

destructor TfrmTrocaMercadorias.Destroy;
begin
  dtmTrocaMercadorias:=nil;
  inherited;
  frmTrocaMercadorias := nil;
end;

procedure TfrmTrocaMercadorias.edfClienteFound(Found: Boolean);
begin
  inherited;
  if Found then
    if not dtmTrocaMercadorias.ReFazConsultaContratosPorCliente then
    begin
        if pgcProdutosParcelas.ActivePage = tstParcelas then
           pgcProdutosParcelas.ActivePage := tstProdutos;
        dbgContratosPorCliente.SetFocus;
        case dtmTrocaMercadorias.TipoClienteSelecao[1] of
         'C': lblClienteContrato.Caption:= 'Cliente';
         'F': lblClienteContrato.Caption:= 'Fornecedor';
         'L': lblClienteContrato.Caption:= 'Filial';
        end;
    end;
end;

function TfrmTrocaMercadorias.ExisteInformacao(Parametro: Integer; NomeCampo: String; Value: Variant): Boolean;
begin
  Result := False;
  if CtrlOn then
    case TipoConsulta of
      ctcCLIENTESTROCA : Result:= dtmTrocaMercadorias.ExisteCliente(nomecampo, value);
      ctcCLIENTES      : Result := dtmTrocaMercadorias.ExisteCliente(NomeCampo, Value);
      ctcVENDEDOR      : Result := dtmTrocaMercadorias.ExisteVendedores(NomeCampo, Value);
    end;
end;

procedure TfrmTrocaMercadorias.HabilitarBotoes;
begin
  with dtmTrocaMercadorias do begin
    pnlParcelas.Visible       := (pgcProdutosParcelas.ActivePage = tstProdutos);
    sbnExcluir.Enabled        := (NrContratos > 0);
    sbnFichaFinanceira.Enabled:= (CodigoCliente > 0);
//    sbnExcluirParcela.Enabled := PodeAlterarParcela;
//    sbnReter.Enabled          := PodeReterValor;

    lblDefeito.Visible        := Qtde_A_Devolver > 0;
    tstDadosNotasPag.TabVisible  := TemProdutoImprimirNotaDevolucao or
                                    (TemProdutoImprimirNotaCompra and
                                     not dtmTrocaMercadorias.ProdutoaTrocarIgualTotalProdutos)
  end;
end;
{
function TfrmTrocaMercadorias.InternoCancelar: Boolean;
begin
  inherited internocancelar;
  pgcProdutosNotas.ActivePageIndex    := 0;
  pgcTrocaMercadorias.ActivePageIndex := 0;
  pgcVendedor.ActivePageIndex         := 0;
  pgcprodutosparcelas.ActivePageIndex := 0;
  dtmTrocaMercadorias.ReFazConsultaTabelas;
  Result:= False;
end;
}
function TfrmTrocaMercadorias.InternoExcluir: Boolean;
begin
  result := false;
  if CtrlOn then
    if dbgProdutos.Focused then
      Result := ExcluirProduto
    else
    if dbgProdutosaTrocar.Focused then
      Result := ExcluirProdutoaTrocar;
  CtrlOn:= False;
end;

function TfrmTrocaMercadorias.InternoGravar: Boolean;
var
  Usuario           : TtecUsuarios;
  Frm: TForm;
  NroCtr: vString;
begin
  Result:= inherited InternoGravar;
  if result then
  begin
    result := dtmTrocaMercadorias.ValidarContrato(true);

    if result then
    begin
      if dtmTrocaMercadorias.ValidarProdutosContratosTroca then
      begin
        if MensagemConfirmacao(ctCONFIRMADEVOLUCAOMERCADORIA) = smbOK  then
        begin
          if UsuarioLogin.TrocaProduto then
          begin
            Usuario:= dtmTrocaMercadorias.ObterAutorizacao(taSENHA);
            dtmTrocaMercadorias.CodigoUsuarioAutorizacao:= Usuario.CodigoUsuario;
          end
          else
          begin
            Usuario:= dtmTrocaMercadorias.ObterAutorizacao(taLOGIN, ctTROCAPRODUTO, ctAUTORIZADO);
            dtmTrocaMercadorias.CodigoUsuarioAutorizacao:= Usuario.CodigoUsuario;
          end;
          try
            if Assigned(Usuario) and Usuario.TrocaProduto then
            begin
              with dtmTrocaMercadorias do
              begin
                result := GravarContrato;
                if Result then
                begin

                  result := GravarDevolucaoMercadoria;

                  if result then
                  begin
                    if parsistema.IncluirOrcamentonosItensdaTroca then
                    begin

                      Frm := TfrmOrcamentos.Referencia;
                      if NumeroContratoouOrcamento<>'' then
                      begin
                        if Assigned(Frm) then
                          TfrmOrcamentos(Frm).SelecionarOrcamento(NumeroContratoouOrcamento)
                        else
                          TfrmPrincipalBasico(Application.MainForm).MostrarFormRegistrado([NumeroContratoouOrcamento], 'TfrmOrcamentos', True);
                      end

                    end
                    else
                    begin
                      if (NumeroContratoTroca<>'') then
                      begin
                         SetLength(NroCtr, length(NroCtr)+1);
                         NroCtr[length(NroCtr)-1] := NumeroContratoTroca;
                      end;

                      if FaturarContrato then
                        Faturar;

                      Frm := Tfrmcadastrocontratos.Referencia;
                      if NumeroContratoouOrcamento<>'' then
                      begin
                        if Assigned(Frm) then
                          TfrmCadastroContratos(Frm).SelecionarContrato(NumeroContratoouOrcamento)
                        else
                          TfrmPrincipalBasico(Application.MainForm).MostrarFormRegistrado([NumeroContratoouOrcamento], 'TfrmCadastroContratos', True);
                      end
                      else
                      begin
                        Frm := Tfrmcadastrocontratos.Referencia;
                        if Assigned(Frm) then
                          TfrmCadastroContratos(Frm).SelecionarContrato(NroCtr)
                      end;

                      Frm := TfrmVendasaVista.Referencia;
                      if Assigned(Frm) then
                        TFrmVendasaVista(Frm).ReFazVendaVista(NroCtr);
                      Frm := TfrmOperacoesContratos.Referencia;
                      if Assigned(Frm) then
                        TfrmOperacoesContratos(Frm).RefazConsulta;
                    end;
                  end;

                  pgcProdutosNotas.ActivePageIndex    := 0;
                  pgcTrocaMercadorias.ActivePageIndex := 0;
                  pgcVendedor.ActivePageIndex         := 0;
                  pgcprodutosparcelas.ActivePageIndex := 0;
                end;
              end;
            end
            else
              MensagemAviso(ctUSUARIOSEMPERMISSAO);
          finally
            Usuario.Free;
          end;
        end;
      end
      else
        MensagemErro(ctTROCASEMPRODUTO);
    end;
  end;
end;

function TfrmTrocaMercadorias.InternoPesquisar(Titulo: String): Integer;
var
 TeclaEnter : word;
begin
  Result := mrNone;
  if CtrlOn then begin
    if PesquisaHabilitada                   then begin
      if ActiveControl is TtecFindCustom then
      begin
        dtmTrocaMercadorias.AbrirTabelas(TipoConsulta);
        Result := inherited InternoPesquisar(Titulo);
        if Result = mrOK then
        begin
          dtmTrocaMercadorias.Selecionar(tipoConsulta);
          if tipoconsulta = ctcCLIENTES then
          begin
            TeclaEnter := VK_Return;
            KeyDown(TeclaEnter,[]);
          end;
        end;
        dtmTrocaMercadorias.FecharTabelas(tipoConsulta);
      end;
    end
  end;
end;

function TfrmTrocaMercadorias.JanelaPesquisa: TfrmConsultaBasica;
begin
  Jan := TfrmConsultaPorCampo.Create(nil);
  Jan.ConsultaInterativa := Not (TipoConsulta in [ctcCLIENTES, ctcCLIENTESTROCA]) and CtrlOn;
  Jan.UsarParametrosDaTabela := false;
  Result := Jan
end;

procedure TfrmTrocaMercadorias.KeyDown(var Key: Word; Shift: TShiftState);
begin
  inherited;
  case key of
    VK_Delete: if dbgImpostosProdutos.Focused then
                  Key:= MAXWORD
                else
                if dbgProdutosaTrocar.Focused then
                  sbnExcluirProdutoaTrocarClick(self)
                else
                if dbgProdutos.Focused then
                  sbnExcluirProdutoClick(self);

    VK_ESCAPE: begin
                  pgcProdutosNotas.ActivePageIndex    := 0;
                  pgcTrocaMercadorias.ActivePageIndex := 0;
                  pgcVendedor.ActivePageIndex         := 0;
                  pgcprodutosparcelas.ActivePageIndex := 0;
                  dtmTrocaMercadorias.ReFazConsultaTabelas;
                end;//InternoCancelar;
    VK_D     : if (Shift = [ssCtrl]) then
                begin
                  if pgcTrocaMercadorias.ActivePageIndex = 0 then
                  begin
                    if lblDefeito.Visible then
                      dtmTrocaMercadorias.SetarProdutoComDefeito;
                  end
                  else
                    dtmTrocaMercadorias.SetarProdutoComDefeitoTroca;
                end;
    VK_R     : if (Shift = [ssCtrl]) and sbnReter.Enabled     then sbnReter.Click;
    VK_F2    : if (Shift = []) and sbnFichaFinanceira.Enabled then sbnFichaFinanceira.Click;
//    VK_F7    : if (Shift = []) and sbnExcluirParcial.Enabled  then sbnExcluirParcial.Click; XX-Jander
  end;
end;

procedure TfrmTrocaMercadorias.mmoObservacoesKeyPress(Sender: TObject; var Key: Char);
begin
  Key:= UpCase(Key);
end;

