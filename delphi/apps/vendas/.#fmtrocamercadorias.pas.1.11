  InternoIncluir;
  GravarLinhas;
end;

function TfrmTrocaMercadorias.IncluirEditarProdutosaTrocar(
  Editar: Boolean): Boolean;
begin
  if dtmTrocaMercadorias.dsrContratos.dataset.fieldbyname('cliente').AsString = '' then
    MensagemAviso(ctCLIENTENAOINFORMADO)
  else
  begin
    frmCadastroProdutosTroca := TfrmCadastroProdutosTroca.Create(frmCadastroProdutostroca);
    if Editar then
      Result := dtmTrocaMercadorias.EditarProdutosaTrocar
    else
      Result := dtmTrocaMercadorias.IncluirProdutosaTrocar;

    if Result then
      Result := frmCadastroProdutosTroca.ShowModal = mrOK;

    frmCadastroProdutosTroca.Free;
    SetFocus;
  end;
end;

