function TfrmTrocaMercadorias.PesquisaHabilitada: Boolean;
begin
  Result:= False;
  if (CtrlOn) and ((ActiveControl is TtecDBEditFind) or
                   (ActiveControl is TtecDBFindLookup))  then
  begin
    if edfCliente.Focused then
      TipoConsulta := ctcCLIENTESTROCA
    else if flkCodigoCliente.Focused then
      Tipoconsulta := ctcCLIENTES
    else if flkVendedor.Focused then
      Tipoconsulta := ctcVENDEDOR;
    Result:= True;
  end;
end;

procedure TfrmTrocaMercadorias.sbnIncluirProdutoClick(Sender: TObject);
begin
  inherited;
  CtrlOn := True;
  dbgProdutos.SetFocus;
  InternoIncluir;
  GravarLinhasProdutosContratos;
end;

function TfrmTrocaMercadorias.InternoIncluir: Boolean;
begin
  Result := inherited InternoIncluir;
  if CtrlOn then
   if dbgProdutos.Focused then
     Result := IncluirEditarProdutosContrato(False)
   else
   if dbgProdutosaTrocar.Focused then
     Result := IncluirEditarProdutosaTrocar(False)
end;

function TfrmTrocaMercadorias.IncluirEditarProdutosContrato(
  Editar: Boolean): Boolean;
begin
  frmCadastroProdutosContratoTroca := TfrmCadastroProdutosContratoTroca.Create(frmCadastroProdutosContratoTroca);

  if Editar then
    Result := dtmTrocaMercadorias.EditarProdutosContrato
  else
    Result := dtmTrocaMercadorias.IncluirProdutosContrato;

  if Result then
    Result := frmCadastroProdutosContratoTroca.ShowModal = mrOK;

  frmCadastroProdutosContratoTroca.Free;
  dtmTrocaMercadorias.CalcularValorTotalProdutos;
  dtmTrocaMercadorias.CalcularValorAVista;
  SetFocus;
end;

procedure TfrmTrocaMercadorias.pgcTrocaMercadoriasChange(Sender: TObject);
begin
  inherited;
  if pgcTrocaMercadorias.ActivePage = tstDefinicaodaTroca then
  begin
    flkCodigoCliente.SetFocus;
    if parsistema.IncluirOrcamentonosItensdaTroca then
      dtmTrocaMercadorias.IncluirOrcamento
    else
    begin
      if dtmTrocaMercadorias.TabelaContrato.state = dsbrowse then
        dtmTrocaMercadorias.IncluirContrato;
    end;
    dtmTrocaMercadorias.CalcularValorTotalProdutosaTrocar;
  end;
end;

