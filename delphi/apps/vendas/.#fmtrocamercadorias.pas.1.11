procedure TfrmTrocaMercadorias.edfClienteEnter(Sender: TObject);
begin
  inherited;
  CodClienteSelecaoAnt := dtmTrocaMercadorias.CodigoClienteSelecao;
  TipoClienteSelecaoAnt := dtmTrocaMercadorias.TipoClienteSelecao;
end;

procedure TfrmTrocaMercadorias.edfClienteExit(Sender: TObject);
begin
  inherited;
  if ((CodClienteSelecaoAnt <> dtmTrocaMercadorias.CodigoClienteSelecao) or
      (TipoClienteSelecaoAnt <> dtmTrocaMercadorias.TipoClienteSelecao)) or
      ((CodClienteSelecaoAnt=0) and (TipoclienteSelecaoAnt='') and
       (dtmTrocaMercadorias.CodigoClienteSelecao<>0) and
       (dtmTrocaMercadorias.TipoClienteSelecao<>'')) then
   dtmTrocaMercadorias.ExibirFichaSelecao(ClassName);
end;
procedure TfrmTrocaMercadorias.flkCodigoClienteEnter(Sender: TObject);
begin
  inherited;
  CodClienteAnt := dtmTrocaMercadorias.CodigoCliente;
  TipoClienteAnt := dtmTrocaMercadorias.TipoCliente;
end;

procedure TfrmTrocaMercadorias.flkCodigoClienteExit(Sender: TObject);
begin
  inherited;
  if ((CodClienteAnt<>CodClienteSelecaoAnt) and
      (TipoClienteAnt<>TipoClienteSelecaoAnt)) or
     ((CodClienteSelecaoAnt=0) and
      (TipoClienteSelecaoAnt='')) then
  begin
    if ((CodClienteAnt <> dtmTrocaMercadorias.Codigocliente) or
        (TipoClienteAnt <> dtmTrocaMercadorias.Tipocliente)) or
        ((CodClienteAnt=0) and (TipoclienteAnt='') and
         (dtmTrocaMercadorias.CodigoCliente<>0) and
         (dtmTrocaMercadorias.TipoCliente<>'')) then
     dtmTrocaMercadorias.ExibirFicha(classname);
  end;
end;

//-------------------------------- Carlos 18/12/2006 ----------------
procedure TfrmTrocaMercadorias.GravarLinhas;
var Contador: Integer;
begin
 with dtmTrocaMercadorias do begin
    qryProdutosTrocados.DisableControls;
    Contador:= 1;
    qryProdutosTrocados.First;
    while Not qryProdutosTrocados.Eof do begin
      qryProdutosTrocados.Edit;
      qryProdutosTrocadosNumeracao.AsInteger := Contador;
      qryProdutosTrocados.Post;
      Inc(Contador);
        qryProdutosTrocados.Next;
    end;
    qryProdutosTrocados.EnableControls;
  end;
end;


procedure TfrmTrocaMercadorias.GravarLinhasProdutosContratos;
var Contador: Integer;
begin
 with dtmTrocaMercadorias do begin
    dsrProdutosContratos.dataset.DisableControls;
    Contador:= 1;
    dsrProdutosContratos.dataset.First;
    while Not dsrProdutosContratos.dataset.Eof do begin
      dsrProdutosContratos.dataset.Edit;
      dsrProdutosContratos.dataset.fieldbyname('Numero').AsInteger := Contador;
      dsrProdutosContratos.dataset.Post;
      Inc(Contador);
      dsrProdutosContratos.dataset.Next;
    end;
    dsrProdutosContratos.dataset.EnableControls;
  end;
end;

procedure TfrmTrocaMercadorias.dbgImpostosProdutosDrawColumnCell(
  Sender: TObject; const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  inherited;
  with dtmTrocaMercadorias do begin
      if (qryCalculosProdutostipo.asstring = 'TOTAL ICMS') or
         (qryCalculosProdutostipo.asstring = 'TOTAL IPI') or
         (qryCalculosProdutostipo.asstring = 'TOTAL ISS') then
      begin
        TDBGrid(Sender).Canvas.Font.Style := [fsBold];
        if not (gdSelected in State) then
          TDBGrid(Sender).Canvas.Brush.Color := TColor(strtoint(parsistema.CorZebradoRelatorio));
      end
      else TDBGrid(Sender).Canvas.Font.Style := []
  end;
  TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);

end;

procedure TfrmTrocaMercadorias.dbgServicosDrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  inherited;

  if not TDBGrid(Sender).DataSource.DataSet.IsEmpty then
  begin
    if (TDBGrid(Sender).DataSource.DataSet.FieldByName('quantidade').AsCurrency =
        TDBGrid(Sender).DataSource.DataSet.FieldByName('cancelado').AsCurrency) then
        TDBGrid(Sender).Canvas.Brush.Color := $FFCB97;

    if (TDBGrid(Sender).DataSource.DataSet.FieldByName('devolver').AsCurrency > 0) then
    begin
      TDBGrid(Sender).Canvas.Brush.Color := clInfoBk;
      TDBGrid(Sender).Canvas.Font.Color := clBlack;
    end;
    TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
  end;

end;

procedure TfrmTrocaMercadorias.dbgServicosKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if key = VK_Return then
    if dbgServicos.SelectedField = dtmTrocaMercadorias.qryServicosContratosdevolver then
    begin
      pgcVendedor.ActivePage := tstValoresNovosPagos;
      ExibirNovosValores(nil);
    end
end;


procedure TfrmTrocaMercadorias.ckbDevolverTodosClick(Sender: TObject);
begin
  inherited;
  dtmTrocaMercadorias.DevolverTodosProdutos(not ckbDevolverTodos.Checked)
end;

end.
