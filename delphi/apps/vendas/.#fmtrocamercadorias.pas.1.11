function TfrmTrocaMercadorias.TabelaDePesquisa: TZDataSet;
begin
  case TipoConsulta of
    ctcCLIENTESTROCA, ctcCLIENTES : Result := dtmTrocaMercadorias.ConsultaCliente;
    ctcVENDEDOR: Result := dtmTrocaMercadorias.TabelaConsultaVendedores;
  else
    Result := Nil
  end
end;

procedure TfrmTrocaMercadorias.ExibirNovosValores;
begin
  if pgcVendedor.ActivePage = tstValoresNovosPagos then begin
    with dtmTrocaMercadorias do begin
      edtAVista.Text     := FormatarValor(ValorProdutos {ValorVista + ValorDesconto},2);

      edtValorServicos.Text := FormatarValor(ValorServicos, 2);
      edtValorImpostoRetido.text := FormatarValor(ValorImpostoRetido, 2);
      edtValorIPI.text := FormatarValor(ValorIPI, 2);
      edticmsvalorst.text := FormatarValor(valoricmssubstituicao, 2);

      edtDesconto.Text   := FormatarValor(ValorDesconto,2);
      edtFreteSeguro.Text:= FormatarValor(ValorFrete + ValorSeguro,2);

      edtAcrescimo.Text  := FormatarValor(ValorAcrescimo,2);
      edtCreditoTroca.Text := FormatarValor(ValorCreditoTroca,2);
      edtTotal.Text      := FormatarValor(ValorPrazo,2);

      edtPago.Text       := FormatarValor(PagoVencto,2);
      edtDevolver.Text   := FormatarValor(Abs(DevolvePagto),2);

(*
      if ContratoAVista then begin
        edtPago.Text       := FormatarValor(PagoReal,2);
        edtDevolver.Text   := FormatarValor(Abs(DevolvePagto),2);
      end
      else begin
        edtPago.Text       := FormatarValor(PagoVencto,2);
        edtDevolver.Text   := FormatarValor(Abs(DevolveVencto),2);
      end;
*)      

      edtcredito.Text       := FormatarValor(PagoCreditoTroca,2);
      edtCreditoDevolver.Text   := FormatarValor(Abs(DevolveCreditoTroca),2);

(*      if not ContratoAVista then edtPago.Text       := FormatarValor(PagoVencto,2)
      else                       edtPago.Text       := FormatarValor(PagoReal,2);
      if not ContratoAVista then edtDevolver.Text   := FormatarValor(Abs(DevolveVencto),2)
      else                       edtDevolver.Text   := FormatarValor(Abs(DevolvePagto),2)
*)  end;
  end;
end;

