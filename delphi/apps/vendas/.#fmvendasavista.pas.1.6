  edtDDD1.ReadOnly := False;
  edtFone1.ReadOnly := False;
  edtRamal1.ReadOnly := False;
  edtDDD2.ReadOnly := False;
  edtFone2.ReadOnly := False;
  edtRamal2.ReadOnly := False;
end;

