    Sql.Strings = (
      'select lc.codigo as NumeroLista,'
      '       lc.nome_noivo,'
      '       lc.nome_noiva,'
      '       lc.data,'
      '       plc.produto,'
      '       p.codigovisual as produtovisual,'
      '       p.descricao as descricaoproduto,'
      ''
      '       plc.quantidade as QtdadeLista,'
      ''
      '      (select sum(pc.quantidade-COALESCE(pc.cancelado,0))'
      '       from produtoscontratos pc'
      '            join contratos ct'
      '            on pc.contrato = ct.numero'
      '       where pc.contrato = ct.numero'
      '         and pc.listacasamento = plc.lista'
      '         AND ct.situacao in ('#39'P'#39','#39'N'#39','#39'F'#39')'
      '         AND pc.produto = plc.produto) as qtdevendida,'
      ''
      '       estoques_preco(plc.produto, :FilialPreco) as preco,'
      ''
      '       (select sum(pc.quantidade - coalesce(pc.cancelado,0))'
      '        from produtoscontratos pc'
      '             join contratos ct'
      '             on pc.contrato = ct.numero'
      '        where pc.listacasamento = lc.codigo'
      '          and pc.produto = plc.produto'
      '          and (pc.quantidade - coalesce(pc.cancelado,0))>0'
      '          and ct.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39')'
      '       ) as QtdadeContrato,'
      ''
      
        '       (select sum(((pc.quantidade - coalesce(pc.cancelado,0)) *' +
        ' pc.precovenda)'
      '                     - coalesce(pc.desconto,0)'
      '                     - coalesce(pc.valordescontoitem,0)'
      '                     + coalesce(pc.acrescimo,0)'
      '                     + coalesce(pc.frete,0)'
      '                     + coalesce(pc.seguro,0))'
      '        from produtoscontratos pc'
      '             join contratos ct'
      '             on pc.contrato = ct.numero'
      '        where pc.listacasamento = lc.codigo'
      '          and pc.produto = plc.produto'
      '          and (pc.quantidade - coalesce(pc.cancelado,0))>0'
      '          and ct.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39')'
      '       ) as PrecoContrato'
      ''
      'from listascasamento lc'
      '     join produtoslistacasamento plc on lc.codigo = plc.lista'
      '     join produtos p on plc.produto = p.codigo'
      ''
      ''
      'where true'
      ''
      '%SQL'
      ''
      'order by lc.data, lc.codigo, p.descricao, p.codigo'
      ''
      ''
      '/*'
      'lc.data between :datainicial and :datafinal'
      '*/'
      '')
