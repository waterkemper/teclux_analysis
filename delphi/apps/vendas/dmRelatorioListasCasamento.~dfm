    Macros = <
      item
        DataType = ftUnknown
        Name = 'SQL'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select lc.codigo as NumeroLista,'
      '       plc.produto,'
      '       pc.contrato,'
      '       ct.nome as nomeclientecontrato,'
      '       ct.situacao as SituacaoContrato,'
      '       pc.filial,'
      
        '       pc.quantidade - coalesce(pc.cancelado,0) as QtdadeContrat' +
        'o,'
      ''
      
        '       ((pc.quantidade - coalesce(pc.cancelado,0)) * pc.precoven' +
        'da)'
      '       - coalesce(pc.desconto,0)'
      '       - coalesce(pc.valordescontoitem,0)'
      '       + coalesce(pc.acrescimo,0)'
      '       + coalesce(pc.frete,0)'
      '       + coalesce(pc.seguro,0) as Preco'
      ''
      ''
      'from listascasamento lc'
      '     join produtoslistacasamento plc on lc.codigo = plc.lista'
      '          join produtoscontratos pc'
      '               join contratos ct on pc.contrato = ct.numero'
      '                    and ct.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39')'
      ''
      '          on plc.lista = pc.listacasamento'
      '          and plc.produto = pc.produto'
      ''
      '          join produtos p'
      '          on plc.produto = p.codigo'
      ''
      'where true'
      '  %SQL'
      '  and (pc.quantidade - coalesce(pc.cancelado,0)) > 0'
      ''
      ''
      'order by lc.data, lc.codigo, p.descricao, p.codigo'
      ''
      '/*'
      'lc.data between :datainicial and :datafinal'
      '*/'
      '')
