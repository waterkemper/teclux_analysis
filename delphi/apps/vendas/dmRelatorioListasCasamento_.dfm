  object qryRelatorioListaCasamento: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select lc.numero as NumeroLista,'
      '       lc.nome_noivo,'
      '       lc.nome_noiva,'
      '       lc.data,'
      '       plc.produto,'
      '       p.codigovisual as produtovisual,'
      '       p.descricao as descricaoproduto,'
      ''
      '       plc.quantidade as QtdadeLista,'
      '       plc.qtdevendida,'
      ''
      '       pc.contrato,'
      '       ct.situacao as SituacaoContrato,'
      '       pc.filial,'
      '       pc.quantidade QtdadeContrato,'
      ''
      '       df.situacao as SituacaoDadoFiscal,'
      '       n.numero as NumeroNota,'
      '       n.serie as Serie,'
      '       n.filial as filialnota,'
      ''
      '       c.numero as NumeroCupom,'
      '       c.maquina,'
      '       c.intervensao,'
      ''
      '       pdf.quantidade as QtdadeNota'
      ''
      'from listascasamento lc'
      '     join produtoslistacasamento plc on lc.codigo = plc.lista'
      '          join produtoscontratos pc'
      '               join contratos ct on pc.contrato = ct.numero'
      '                    left join dadosfiscais df'
      
        '                              left join notas n on n.dadofiscal ' +
        '= df.numero'
      
        '                              left join cupons c on c.dadofiscal' +
        ' = df.numero'
      '                    on df.contrato = ct.numero'
      '                    and ct.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39')'
      ''
      '                    left join produtosdadosfiscais pdf'
      '                    on df.numero = pdf.dadofiscal'
      '                    and pc.produto = pdf.produto'
      ''
      ''
      '          on plc.lista = pc.listacasamento'
      '          and plc.produto = pc.produto'
      ''
      '          join produtos p'
      '          on plc.produto = p.codigo'
      ''
      'where lc.data between :datainicial and :datafinal'
      ''
      'order by lc.data, lc.numero'
      ''
      'desc limit 200')
    RequestLive = False
    Left = 88
    Top = 96
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
