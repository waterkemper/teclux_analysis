        '                                                                ' +
        '   (m2.filial = e.filial)'
      '                                                        )'
      '                      ),0)'
      
        '       as emestoque, (select c.composto from caracteristicas c w' +
        'here c.codigo = p.caracteristica) as composto'
      'from produtos p, estoques e'
      'where (p.codigo = :codigo) and (e.filial = :filial)     '
      '           and (p.codigo = e.produto) '
      '/*        Preenchido em RunTime      */     '
      '           and (p.inativo is null)           '
      '           and (0 <=   coalesce((select m.emestoque'
      '                                     from movimentos m'
      
        '                                     where m.numero = (select ma' +
        'x(m2.numero)'
      
        '                                                                ' +
        '     from movimentos m2'
      
        '                                                                ' +
        '     where (m2.produto = p.codigo) and'
      
        '                                                                ' +
        '                (m2.filial = e.filial)'
      
        '                                                                ' +
        '     )'
      '                                   ),0))')
