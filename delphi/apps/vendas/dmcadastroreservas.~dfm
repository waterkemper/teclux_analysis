      'select p.descricao,'
      
        '         (select g.descricao from grades g, caracteristicas c wh' +
        'ere g.codigo = c.grade1 and c.codigo = p.caracteristica) as linh' +
        'a,'
      
        '         (select g.descricao from grades g, caracteristicas c wh' +
        'ere g.codigo = c.grade2 and c.codigo = p.caracteristica) as colu' +
        'na,'
      '         p.valorgrade1,'
      '         p.valorgrade2,'
      '         p.codigo,'
      '         e.filial,'
      '         coalesce((select m.emestoque'
      '                       from movimentos m'
      '                        where m.numero = (select max(m2.numero)'
      
        '                                                        from mov' +
        'imentos m2'
      
        '                                                        where (m' +
