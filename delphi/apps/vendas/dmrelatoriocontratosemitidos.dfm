  object qryImprimirContratosDadosFiscais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '; select   dadosfiscais.filialemissao,'
      '           dadosfiscais.serie,'
      '           dadosfiscais.numeronota,'
      '           c.maquina,'
      '           c.intervensao,'
      '           c.numero as numerocupom          '
      '  from'
      '  ('
      '  select dadosfiscais.*,'
      '            n.serie,'
      '            n.numero as numeronota'
      '  from'
      '   ('
      '    select  df.numero, df.filialemissao'
      
        '    from contratos ct left join dadosfiscais df on ct.numero=df.' +
        'contrato  /* NECESSARIO P/ O FAST */'
      '    where ct.numero=:contrato'
      
        '   ) as dadosfiscais left join notas n on dadosfiscais.numero=n.' +
        'dadofiscal'
      
        '  ) as dadosfiscais left join cupons c on dadosfiscais.numero=c.' +
        'dadofiscal'
      'order by dadosfiscais.numero')
    RequestLive = False
    Left = 304
    Top = 168
    ParamData = <
      item
        DataType = ftString
        Name = 'contrato'
        ParamType = ptUnknown
        Value = '0'
      end>
    object qryImprimirContratosDadosFiscaisserie: TStringField
      FieldName = 'serie'
      Size = 3
    end
    object qryImprimirContratosDadosFiscaisnumeronota: TIntegerField
      FieldName = 'numeronota'
      DisplayFormat = '0'
    end
    object qryImprimirContratosDadosFiscaismaquina: TIntegerField
      FieldName = 'maquina'
      DisplayFormat = '0'
    end
    object qryImprimirContratosDadosFiscaisintervensao: TIntegerField
      FieldName = 'intervensao'
      DisplayFormat = '0'
    end
    object qryImprimirContratosDadosFiscaisnumerocupom: TIntegerField
      FieldName = 'numerocupom'
      DisplayFormat = '0'
    end
    object qryImprimirContratosDadosFiscaisfilialemissao: TIntegerField
      FieldName = 'filialemissao'
    end
  end
  object qryImprimirContratos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterScroll = qryImprimirContratosAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WherePeriodoFaturamento'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Wherefiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Clientes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereAgentes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereAnalistaCredito'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereTipoContrato'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereContratoNaoEstornado'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereLimitePagamento'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereVendaaVistaouPrazo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereComObservacoes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereFiltroObservacoes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListaItemProdutos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListaProdutos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListaGrupos'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListaClasses'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListaMarcas'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListaCondicionalPromocoes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Ordenacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select contratos.*,'
      
        '       notas_notasdocontrato_f_s_n(contratos.numero) as FilialSe' +
        'rieNumero,'
      '       (select sum(p.valorpagto)'
      '        from parcelas p'
      
        #9'where p.contrato=contratos.numero and (p.tipopagto is null or p' +
        '.tipopagto='#39'B'#39')) as totalpago'
      'from'
      '('
      'select contratos.*,'
      '       fv.nome as nomefilialvenda,'
      '       fgf.grupo as grupofilialvenda,'
      '       gf.descricao as nomegrupofilialvenda'
      'from'
      '('
      'select distinct'
      '  ct.numero,'
      #9'ct.filialvenda,'
      #9'ct.faturamento,'
      #9'ct.cliente,'
      #9'ct.tipocliente,'
      #9'ct.nome as nomecliente,'
      '  ct.valorprazo as totalvencto,'
      '  ct.vendedor,'
      
        '  (select u.nome from usuarios u where u.codigo = ct.vendedor) a' +
        's nomevendedor,'
      
        '  cast(coalesce(ct.consideracoes,'#39' '#39')||coalesce(ct.montagemobs,'#39 +
        ' '#39') as varchar(1000)) as observacoes'
      'from ((contratos ct'
      '      join vfornecedores vf'
      '      on ct.cliente = vf.codigo and'
      '         ct.tipocliente = vf.tipo)'
      ''
      '      join (produtoscontratos pc'
      
        '           join (produtos p left join promocoes pro on p.promoca' +
        'o = pro.codigo)'
      '                 join (((caracteristicas c'
      '                      join grupos g'
      '                      on g.codigo = c.grupo)'
      '                      join classes cl'
      '                      on cl.codigo = c.classe)'
      '                      join marcas m'
      '                      on m.codigo = c.marca)'
      '                 on p.caracteristica = c.codigo'
      '            on pc.produto = p.codigo)'
      '      on ct.numero = pc.contrato)'
      ''
      'where ct.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39') '
      '  and ct.origem is null'
      
        '  and case when ct.os then ct.tipoequipamento in (1,2) and not (' +
        'coalesce(ct.os_garantia,false) and ct.os_garantia_status='#39'A'#39') an' +
        'd not coalesce(ct.os_cortesia,false) else true end'
      ''
      '      %WherePeriodoFaturamento'
      '      %Wherefiliais'
      '      %Clientes'
      '      %WhereAgentes'
      '      %WhereAnalistaCredito'
      '      %WhereTipoContrato'
      '      %WhereContratoNaoEstornado'
      '      %WhereLimitePagamento'
      '      %WhereVendaaVistaouPrazo'
      '      %WhereComObservacoes'
      '      %WhereFiltroObservacoes'
      ''
