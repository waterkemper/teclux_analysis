    0 : frVariables['Titulo']:= 'CONTRATOS EMITIDOS - Parcelas Nao Quitadas';
    1 : frVariables['Titulo']:= 'CONTRATOS EMITIDOS - Entrada/Venda a Vista nao Quitada';
    2 : frVariables['Titulo']:= 'CONTRATOS EMITIDOS - Quitados';
    3 : frVariables['Titulo']:= 'CONTRATOS EMITIDOS';
  end;

//  frpImprimirContratosEmitidosSemParcelas.DesignReport;

  if NaoListarParcelas then
    ImprimirRelatoriofast(null, FParametroCabecalho, MPadrao, FResumo,
