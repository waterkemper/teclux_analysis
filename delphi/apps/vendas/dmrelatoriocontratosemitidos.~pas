end;

procedure Tdtmrelatoriocontratosemitidos.SetDataFinal(const Value: String);
begin
  if not DataEmBranco(Value) then
  begin
    FDataFinal := Value;
    if FDataInicial='' then
      FDataInicial:=FDataFinal;
  end
  else FDataFinal := FDataInicial;
  MontaDatas;
end;

procedure Tdtmrelatoriocontratosemitidos.SetFiliais(const Value: String);
