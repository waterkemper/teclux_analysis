function Tdtmrelatoriocontratosemitidos.GetListaAgentes: TStrings;
begin
  FListaAgentes:= TStringList.Create;
  qryAgentes.Open;
  while not qryAgentes.Eof do
  begin
    FListaAgentes.AddObject(qryAgentesdescricao.AsString, Pointer(qryAgentescodigo.AsInteger));
    qryAgentes.Next;
  end;
  qryAgentes.Close;
  Result := FListaAgentes;
end;

function Tdtmrelatoriocontratosemitidos.GetListaAnalistaCredito: TStrings;
begin
  FListaAnalistaCredito:= TStringList.Create;
