procedure Tdtmrelatoriocontratosemitidos.MontarOrdenacao;
var
Ordenacao: String;
begin
  Ordenacao:='';
  if FAgruparGrupoFilial then
    Ordenacao:=Ordenacao+', nomegrupofilialvenda, grupofilialvenda ';
  if FAgruparFilial then
    Ordenacao:=Ordenacao+', nomefilialvenda, filialvenda ';
  case FOrdenacao of
  0 : Ordenacao:=Ordenacao+', faturamento, nomecliente, cliente, tipocliente, numero';
  1 : Ordenacao:=Ordenacao+', cliente, tipocliente, numero';
  2 : Ordenacao:=Ordenacao+', nomecliente, cliente, tipocliente, numero';
  end;
  qryImprimirContratos.MacroByName('Ordenacao').AsString := 'Order by '+copy(Ordenacao,2,length(Ordenacao)-1);
end;

