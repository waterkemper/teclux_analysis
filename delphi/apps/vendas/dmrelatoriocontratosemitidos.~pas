procedure Tdtmrelatoriocontratosemitidos.SetContratoComObservacoes(
  const Value: Boolean);
begin
  fContratoComObservacoes := Value;
  if fContratoComObservacoes then
  begin
    qryImprimirContratos.macroByName('WhereComObservacoes').asString := 'and (ct.consideracoes is not null or ct.montagemobs is not null)';
    FParametroCabecalho:=FParametroCabecalho+' - Somente com observações '
  end
  else
    qryImprimirContratos.macroByName('WhereComObservacoes').asString := '';
end;

procedure Tdtmrelatoriocontratosemitidos.SetFiltroObservacoes(
  const Value: String);
var
  vCondicao : String;
begin
  fFiltroObservacoes := Value;
  if (fFiltroObservacoes <> '') then
  begin

    if ComSemObs then

      qryImprimirContratos.macroByName('WhereFiltroObservacoes').asString :=
        ' and ((to_ascii(coalesce(ct.consideracoes,''''),''latin1'') not ilike to_ascii(''%'+fFiltroObservacoes+'%'',''latin1'')) and '+
        ' (to_ascii(coalesce(ct.montagemobs,''''),''latin1'') not ilike to_ascii(''%'+fFiltroObservacoes+'%'',''latin1'')))'

    else

      qryImprimirContratos.macroByName('WhereFiltroObservacoes').asString :=
          ' and ((to_ascii(ct.consideracoes,''latin1'') ilike to_ascii(''%'+fFiltroObservacoes+'%'',''latin1'')) or '+
          ' (to_ascii(ct.montagemobs,''latin1'')  ilike to_ascii(''%'+fFiltroObservacoes+'%'',''latin1'')))';

    FParametroCabecalho:=FParametroCabecalho+' - Observações: '+fFiltroObservacoes;
  end
  else
    qryImprimirContratos.macroByName('WhereFiltroObservacoes').asString := '';
end;

