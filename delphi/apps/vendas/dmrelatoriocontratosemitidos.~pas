  else
    ImprimirRelatoriofast(null, FParametroCabecalho, MPadrao, FResumo,
                       [frpImprimirContratosEmitidos, frpImprimirContratosEmitidosResumo], false, self.owner);

end;


procedure Tdtmrelatoriocontratosemitidos.MontaDatas;
const
SQL = 'and ct.faturamento between %s and %s';
begin
  if FDataFinal<>'' then
  begin
    qryImprimirContratos.MacroByName('WherePeriodoFaturamento').AsString := format(SQL,[quotedstr(FDataInicial),quotedstr(FDataFinal)]);
    FParametroCabecalho:=FParametroCabecalho+' Entre: '+FDataInicial+' e '+FDataFinal;
  end
  else
    qryImprimirContratos.MacroByName('WherePeriodoFaturamento').AsString := '';
end;

procedure Tdtmrelatoriocontratosemitidos.SetAgentes(const Value: String);
begin
  if (Value <> '') then
   qryImprimirContratos.MacroByName('WhereAgentes').AsString := Format(FiltroAgente,[Value])
  else
   qryImprimirContratos.MacroByName('WhereAgentes').AsString := '';
end;

