procedure Tdtmrelatoriocontratosemitidos.SetGrupoFiliais(
  const Value: String);
begin
  FGrupoFiliais := Value;
  if (Value <> '') then
  begin
    if ParSistema.RelatorioSomenteFiliaisAutorizadas then
     qryImprimirContratos.MacroByName('WhereFiliais').AsString :=
       qryImprimirContratos.MacroByName('WhereFiliais').AsString+
       Format(FiltroGrupoFilial,[Value])
    else
     qryImprimirContratos.MacroByName('WhereFiliais').AsString := Format(FiltroGrupoFilial,[Value]);
  end;
end;

procedure Tdtmrelatoriocontratosemitidos.SetTipo(const Value: Integer);
begin
  FTipo := Value;
  case FTipo of
     0 : begin
           qryImprimirContratos.macrobyname('WhereTipoContrato').asstring := ' and (select count(*) from parcelas p where p.contrato=ct.numero and p.datapagto is null) > 0';
           qryImprimirContratosParcelas.macrobyname('WhereTipoParcelas').AsString :=' and p.datapagto is null';
         end;
     1 : begin
           qryImprimirContratos.macrobyname('WhereTipoContrato').asstring :=
          ' and (select count(*)'+
                 ' from parcelas p where p.contrato=ct.numero and'+
                ' p.datavencto <= ct.faturamento and'+
                                     ' p.datapagto is null)>0';
           qryImprimirContratosParcelas.macrobyname('WhereTipoParcelas').AsString :=
           ' and (p.datavencto <= ct.faturamento) and p.datapagto is null';
         end;
     2 : begin
           qryImprimirContratos.macrobyname('WhereTipoContrato').asstring :=
           'and not exists (select p.contrato '+
           '                from parcelas p '+
           '                where p.contrato = ct.numero and '+
           '                      p.datapagto is null) ';
           qryImprimirContratosParcelas.macrobyname('WhereTipoParcelas').AsString := '';
         end;
     3 : begin
           qryImprimirContratos.macrobyname('WhereTipoContrato').asstring := '';
           qryImprimirContratosParcelas.macrobyname('WhereTipoParcelas').AsString := '';
         end;
  end;
  if FDataQuitacaoFinal<>'' then
    qryImprimirContratos.macrobyname('WhereContratonaoestornado').asstring :=
   ' and (coalesce((select count(*) from parcelas p where '+
   '(p.contrato = ct.numero and ((p.tipopagto in (''E'',''J'') and p.datapagto<='+quotedstr(FDataQuitacaoFinal)+')'+
   'or (p.tipopagto in (''D'',''C'',''P'',''X'') and p.deventrada<='+quotedstr(FDataQuitacaoFinal)+'))) ),0)'+
   '<> (select count(*) from parcelas p where p.contrato=ct.numero))'
  else
    qryImprimirContratos.macrobyname('WhereContratonaoestornado').asstring :=
   ' and (coalesce((select count(*) from parcelas p where '+
   '(p.contrato = ct.numero and ((p.tipopagto in (''E'',''J'') and p.datapagto<='+quotedstr(FDatafinal)+')'+
   'or (p.tipopagto in (''D'',''C'',''P'',''X'') and p.deventrada<='+quotedstr(FDatafinal)+'))) ),0)'+
   '<> (select count(*) from parcelas p where p.contrato=ct.numero))';
end;

