procedure TdtmRelatorioContratosPendentes.Selecionar(
  TipoPesquisa: TtecRelatorioVendas);
begin
  case TipoPesquisa of
  rvITEMPRODUTOS    : RefazConsulta(qryitemProdutos, [0], [qryConsultaItemProdutoscodigo.AsVariant]);
  rvPRODUTOS        : RefazConsulta(qryProdutos, [0], [qryConsultaProdutoscodigo.AsVariant]);
  rvGRUPOPRODUTOS   : RefazConsulta(qryGrupoProdutos, [0], [qryConsultaGrupoProdutoscodigo.AsVariant]);
  rvCLASSES         : RefazConsulta(qryClasses, [0], [qryConsultaClassescodigo.AsVariant]);
  rvFORNECEDORES    : RefazConsulta(qryFornecedores, [0],[qryConsultaFornecedorescodigo.AsVariant]);
  end;
end;

procedure TdtmRelatorioContratosPendentes.SetClasseProdutos(const Value: String);
begin
  if (value <> '') then begin
    qryContratosPendentes.macrobyname('WhereClasses').asstring:= ' and ((Select count(*) From produtos p, caracteristicas c ' + #10#13 +
                                                 '                       Where (pc.produto = p.codigo)       and'    + #10#13 +
                                                 '                             (p.caracteristica = c.codigo) and'    + #10#13 +
                                                 '                             (c.classe = ' + QuotedStr(Value) + ')) > 0)';
    FParametroCabecalho:= FParametroCabecalho + ' Classe: ' + Value;
  end
  else qryContratosPendentes.macrobyname('WhereClasses').asstring:= '';
end;

procedure TdtmRelatorioContratosPendentes.SetFiliais(const Value: String);
begin
  FFiliais := Value;
  if value <> '' then  qryContratosPendentes.macrobyname('WhereFilial').asstring:= Format(FiltroFilial,[Value])
  else                 qryContratosPendentes.macrobyname('WhereFilial').asstring:= '';
end;

procedure TdtmRelatorioContratosPendentes.SetFornecedor(const Value: String);
begin
  if value<>'' then begin
    qryContratosPendentes.macrobyname('WhereProdutosFornecedores').asstring:= ' and ((Select count(*) From produtos p, caracteristicas c'      + #10#13 +
                                                    '                       Where (pc.produto = p.codigo)       and' + #10#13  +
                                                    '                             (p.caracteristica = c.codigo) and' + #10#13  +
                                                    '                             (c.codigo in (Select fp.caracteristica From  fornecedoresprodutos fp Where (fp.fornecedor = ' + Value + ')))) > 0)';
    FParametroCabecalho:= FParametroCabecalho + ' Fornecedor: ' + Value;
  end
  else qryContratosPendentes.macrobyname('WhereProdutosFornecedores').asstring:= '';
end;

procedure TdtmRelatorioContratosPendentes.SetGrupoFiliais(const Value: String);
begin
  FGrupoFiliais := Value;
  if value <> '' then
  begin
    if ParSistema.RelatorioSomenteFiliaisAutorizadas then
      qryContratosPendentes.macrobyname('WhereGrupoFilial').asstring:=
        qryContratosPendentes.macrobyname('WhereGrupoFilial').asstring+
        Format(FiltroGrupoFilial,[Value])
    else
      qryContratosPendentes.macrobyname('WhereGrupoFilial').asstring:=
        Format(FiltroGrupoFilial,[Value])
  end
  else
    qryContratosPendentes.macrobyname('WhereGrupoFilial').asstring:= '';
end;

