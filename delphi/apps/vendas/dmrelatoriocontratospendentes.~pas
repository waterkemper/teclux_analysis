function TdtmRelatorioContratosPendentes.ExisteItemProdutos(campo, codigo: string): boolean;
const
  SQL = 'Where (to_asci((p.%s) ilike Maiusculo(''%s%s''))';
begin
  qryConsultaItemProdutos.Sql[03]:= Format(SQL, [Campo, ANSIUpperCase(codigo), '%']);
  qryConsultaItemProdutos.Open;
  Result := (qryConsultaItemProdutos.RecordCount > 0);
end;

function TdtmRelatorioContratosPendentes.ExisteProdutos(campo, codigo: string): boolean;
const
  SQL = 'Where (Maiusculo(c.%s) ilike Maiusculo(''%s%s''))';
begin
  qryConsultaProdutos.Sql[03]:= Format(SQL, [Campo, ANSIUpperCase(codigo), '%']);
  qryConsultaProdutos.Open;
