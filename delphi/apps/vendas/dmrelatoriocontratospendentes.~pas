procedure TdtmRelatorioContratosPendentes.frpProdutosPendentesBeforePrint(Memo: TStringList; View: TfrView);
begin
  inherited;
  if (View.Name = 'fpvLogo') then
  begin
   if FileExists(LogotipoFilialBase) then
    try TfrPictureView(View).Picture.LoadFromFile(LogotipoFilialBase) except end;
  end
  else
  if TColor(strtoint(parsistema.CorZebradoRelatorio))<>TColor(clnone) then
   if (View.Name = 'mmoZebrado') then
    if (frpContratosPendentes.Dictionary.Variables.Variable['LINHA'] MOD 2)=0 then
      frpContratosPendentes.FindObject('mmoZebrado').FillColor := TColor(strtoint(parsistema.CorZebradoRelatorio))
    else
      frpContratosPendentes.FindObject('mmoZebrado').FillColor := clnone;
end;


