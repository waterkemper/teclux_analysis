procedure TdtmRelatorioContratosPendentes.qryContratosPendentesAfterOpen(
  DataSet: TDataSet);
var
 NumeroContrato, UltimoContratoAlterado : String;
begin
  inherited;
  qryContratosPendentes.First;
  NumeroContrato := '';
  UltimoContratoAlterado := '';
  while not qryContratosPendentes.Eof do
  begin
    if qryContratosPendentescontrato.AsString = NumeroContrato then
    begin

      if (NumeroContrato<>UltimocontratoAlterado) or
         (UltimoContratoAlterado='') then
      begin
        qryContratosPendentes.Prior;
        qryContratosPendentes.edit;
        qryContratosPendentesdiferenciar.AsBoolean := false;
        qryContratosPendentes.post;
        qryContratosPendentes.Next;
      end;
      qryContratosPendentes.edit;
      qryContratosPendentesdiferenciar.AsBoolean := false;
      qryContratosPendentes.post;

      if NumeroContrato<>UltimocontratoAlterado then
        UltimoContratoAlterado := NumeroContrato;
    end;
    NumeroContrato := qryContratosPendentescontrato.AsString;
    qryContratosPendentes.Next;
  end;

end;

procedure TdtmRelatorioContratosPendentes.SetPendentes(
  const Value: Boolean);
begin
  FPendentes := Value;
  qryContratosPendentes.Sql.Text := qryContratosPendentesCabecalho.Sql.Text;
  if FPendentes and FPendentesCancelados then
    qryContratosPendentes.Sql.text := qryContratosPendentes.Sql.Text +
                                      qryPendentes.Sql.Text +' union all '+
                                      qryPendentesCancelados.Sql.Text
  else
    if FPendentes then
    begin
      FParametroCabecalho := FParametroCabecalho + ' Somente Pendentes';
      qryContratosPendentes.Sql.text := qryContratosPendentes.Sql.Text +
                                      qryPendentes.Sql.Text
    end
    else
    begin
      FParametroCabecalho := FParametroCabecalho + ' Somente Cancelados';
      qryContratosPendentes.Sql.text := qryContratosPendentes.Sql.Text +
                                      qryPendentesCancelados.Sql.Text;
    end;

  qryContratosPendentes.Sql.Text := qryContratosPendentes.Sql.Text +
                                    qryContratosPendentesRodape.Sql.Text;
end;

function TdtmRelatorioContratosPendentes.AbrirConsulta: Boolean;
begin
  ReFazConsulta(qryContratosPendentes,[],[]);
  result := not qryContratosPendentes.IsEmpty;
end;

procedure TdtmRelatorioContratosPendentes.ZMonitor1MonitorEvent(Sql,
  Result: String);
var
 Listar : TStringList;
begin
  inherited;
  Listar := tStringlist.create;
  if fileexists('c:\log_pendentes.sql') then
    Listar.loadfromfile('c:\log_pendentes.sql');
  Listar.add('');
  Listar.add(sql);
  Listar.add(result);
  listar.savetofile('c:\log_pendentes.sql');
  listar.free;
end;

end.
