  Const
  // Filtros
  FiltroFilial      = ' and ( ct.filialvenda in (%s)) ' + #13#10;
  FiltroGrupoFilial = ' and ( ct.filialvenda in (Select filial ' + #13#10 +
                                               'From filiaisgruposfiliais fgf ' + #13#10 +
                                               'Where fgf.grupo in (%s))) ';
  WhereDuvidandooFuturo =
  ' and  ((ct.situacao in (''F'',''P'')) or                            '+
  '      (ct.situacao = ''N'' and (((Select count(*)                   '+
  '                                From dadosfiscais df                '+
  '                                Where df.data > :datasituacao       '+
  '                                  and df.contrato = ct.numero) +    '+
  '                               (select count(*)                     '+
  '                                from contratosdevolvidos cd         '+
  '                                where cd.contrato = ct.numero       '+
  '                                  and cd.devolucao > :datasituacao  '+
  '                                  and cd.situacao = ''F'' and cd.produto=pc.produto          '+
  '                                  and cd.tipo=''D'')) > 0)) or      '+
  '     (ct.situacao = ''C'' and ((Select count(*)                     '+
  '                              From contratosdevolvidos cd           '+
  '                              Where cd.devolucao > :datasituacao    '+
  '                                and cd.contrato = ct.numero         '+
  '                                and cd.situacao =''F''  and cd.produto=pc.produto            '+
  '                                and cd.tipo = ''D'') > 0)))         ';

  WhereDuvidandooFuturo_Cancelado =
  ' and (ct.situacao = ''C'' and ((Select count(*)                     '+
  '                              From contratosdevolvidos cd           '+
  '                              Where cd.devolucao > :datasituacao    '+
  '                                and cd.contrato = ct.numero         '+
  '                                and cd.situacao =''F''   and cd.produto=pc.produto           '+
  '                                and cd.tipo = ''D'') > 0))          ';


  WhereConfirmandooPresenteeAfirmandooPassado =
  ' and ( ((ct.situacao in (''N'',''P'')) and ((pc.quantidade - ((Select coalesce(sum(pdf.quantidade),0)           '+
  '                                                               From produtosdadosfiscais pdf, dadosfiscais df   '+
  '                                                               Where pdf.dadofiscal = df.numero                 '+
  '						        and df.data <= :datasituacao                               '+
  '							and df.contrato = ct.numero                                '+
  '							and pdf.produto = pc.produto) +                            '+
  '					              (select coalesce(sum(cd.quantidade),0)                       '+
  '						       from contratosdevolvidos cd                                 '+
  '						       where cd.contrato = ct.numero                               '+
  '						         and cd.devolucao <= :datasituacao                         '+
  '							 and cd.produto = pc.produto                               '+
  '							 and cd.situacao=''F''                                     '+
  '							 and cd.tipo=''D''))) > 0)) or                             '+
  '       ((ct.situacao in (''F'',''C'')) and ((pc.quantidade - (Select coalesce(sum(cd.quantidade),0)                 '+
  '                                                          From contratosdevolvidos cd                           '+
  '                                                          Where cd.contrato = ct.numero                         '+
  '						       and cd.devolucao <= :datasituacao                           '+
  '						       and cd.produto = pc.produto                                 '+
  '						       and cd.situacao = ''F''                                     '+
  '						       and cd.tipo=''D'')) > 0)))                                  ';

  WhereConfirmandooPresenteeAfirmandooPassado_Cancelado =
  ' and   ((ct.situacao in (''F'',''C'')) and ((pc.quantidade - (Select coalesce(sum(cd.quantidade),0)             '+
  '                                                          From contratosdevolvidos cd                           '+
  '                                                          Where cd.contrato = ct.numero                         '+
  '						       and cd.devolucao <= :datasituacao                           '+
  '						       and cd.produto = pc.produto                                 '+
  '						       and cd.situacao = ''F''                                     '+
  '						       and cd.tipo=''D'')) > 0))                                   ';


