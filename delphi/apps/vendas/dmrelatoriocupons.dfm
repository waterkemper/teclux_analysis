  object qryVendas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'FILIAL'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DATA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'VENDEDOR'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      
        '/*data hora cupom fiscal codigo produto quantidade R$ unitario R' +
        '$ total N'#186' do Funcion'#225'rio*/'
      ';'
      'SELECT *'
      'FROM'
      '('
      'SELECT det.coo,'
      '       det.dt_ini     as datahora,'
      '       case when  dic.num_item = (select max(dic2.num_item)'
      '                                  from dadositemcupom dic2'
      '                                  where dic2.filial = dic.filial'
      
        '                                    and dic2.num_usu = dic.num_u' +
        'su'
      '                                    and dic2.cro = dic.cro'
      '                                    and dic2.coo = dic.coo'
      
        '                                    and dic2.num_fab = dic.num_f' +
        'ab'
      
        '                                    and dic2.ind_canc <> '#39'S'#39') th' +
        'en det.vl_tot'
      '       else 0.00 end as valortotal,'
      ''
      '       dic.cod_item   as produto,'
      '       dic.desc_item  as descricaoproduto,'
      '       dic.num_item   as sequencia,'
      '       dic.qtde_item  as quantidade,'
      '       dic.vl_unit    as valorunitario,'
      '       dic.qtde_item * dic.vl_unit as vl_tot_item,'
      ''
      
        '       round(coalesce(( - dic.vl_tot_item *  case when det.tp_de' +
        'scto = '#39'V'#39' then det.sub_descto end / det.sub_docto'
      
        '                        + dic.vl_tot_item *  case when det.tp_ac' +
        'res = '#39'V'#39' then det.sub_acres   end / det.sub_docto),0),2) as des' +
        'cacres,'
      ''
      '       (select df.vendedor'
      '        from dadosfiscais df'
      '        where df.filialvenda = det.filial'
      '          and df.numero = (select c.dadofiscal'
      '                           from cupons c'
      '                           where c.maquina = det.num_usu'
      '                             and c.intervensao = det.cro'
      '                             and c.numero = det.coo'
      
        '                             and c.numeroserie = det.num_fab)) a' +
        's vendedor,'
      '       (select u.nome'
      '        from usuarios u'
      '        where u.codigo =( select df.vendedor'
      '                          from dadosfiscais df'
      '                          where df.filialvenda = det.filial'
      '                            and df.numero = (select c.dadofiscal'
      '                                             from cupons c'
      
        '                                             where c.maquina = d' +
        'et.num_usu'
      
        '                                               and c.intervensao' +
        ' = det.cro'
      
        '                                               and c.numero = de' +
        't.coo'
      
        '                                               and c.numeroserie' +
        ' = det.num_fab))) as nomevendedor'
      ''
      ''
      'FROM detalhecupom det'
      '     join dadositemcupom dic'
      '     on det.filial = dic.filial'
      '     and det.num_usu = dic.num_usu'
      '     and det.cro = dic.cro'
      '     and det.coo = dic.coo'
      '     and dic.num_fab = det.num_fab'
      'WHERE det.canc <> '#39'S'#39
      '  and dic.ind_canc <> '#39'S'#39
      ''
      '%FILIAL'
      '%DATA'
      ''
      'ORDER BY vendedor, det.dt_ini, det.coo, dic.num_item'
      ') AS t'
      'WHERE true'
      '%VENDEDOR')
    RequestLive = False
    Left = 40
    Top = 24
