    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';SELECT * FROM'
      '('
      'Select'
      '       n.serie,'
      '       n.numero as nota,'
      '       c.maquina,'
      '       c.intervensao,'
      '       c.numero as cupom,'
      '       ct.numero as contrato,'
      '       df.data,'
      '       ct.cliente,'
      '       ct.nome as nomecliente,'
      '       df.filialvenda,'
      '       f.nome as nomefilialvenda,'
      '       pdf.produto,'
      '       pdf.filial,'
      
        '       cast(p.descricao||'#39' '#39'||coalesce(p.valorgrade1,'#39#39')||'#39' '#39'||c' +
        'oalesce(p.valorgrade2,'#39#39') as varchar) as descricao,'
      '       pdf.quantidade,'
      '       pdf.precovenda'
      
        'From dadosfiscais df      left join notas n on df.numero = n.dad' +
        'ofiscal'
      
        '                          left join cupons c on df.numero = c.da' +
        'dofiscal,'
      
        '     contratos ct, produtosdadosfiscais pdf, produtos p, filiais' +
        ' f'
      'Where df.contrato = ct.numero'
      '      and (df.data between :datainicial  and :datafinal)'
      '      and (df.data<>ct.faturamento) '
      '     /*             Filial                                */'
      '     /*             Grupo Filial                     */'
      '      and (pdf.dadofiscal = df.numero)'
      '     /*             Itens Produtos                 */'
      '     /*             Produtos                          */'
      '     /*             Grupos                             */'
      '     /*             Classes                            */'
      ''
      '    and (p.codigo = pdf.produto)'
      '    and (df.filialvenda = f.codigo)'
      '    and not coalesce(df.notavinculada,false)'
      ') AS nf'
      
        'ORDER BY nf.FilialVenda, UPPER(TO_ASCII(nf.nomecliente,'#39'LATIN1'#39')' +
        '),'
      
        '         nf.Cliente, to_number(nf.Contrato,'#39'99999999999999999999' +
        #39'), nf.produto')
