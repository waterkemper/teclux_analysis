  object qryRenegociacoes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      
        'select fgf.grupo as grupofilialvenda, gf.descricao as nomegrupof' +
        'ilialvenda,'
      '       ct.filialvenda, f.nome as nomefilialvenda,      '
      '       ct.cliente, ct.tipocliente, ct.nome, ct.vendedor, '
      '       (select v.nome '
      '        from usuarios v'
      '        where v.codigo = ct.vendedor) as nomevendedor,'
      '       ct.numero as original,'
      '       ct.faturamento as faturamento_original,'
      '       (select sum(p.valorvencto)'
      '        from parcelas p  '
      '        where p.contrato = ct.numero and'
      '              p.datapagto is null) as totalvalorvencto_original,'
      '       (select count(*)'
      '        from parcelas p  '
      '        where p.contrato = ct.numero and'
      '              p.datapagto is null) as qtparcelas_original,'
      '       renegociados.*'
      
        'from (contratos ct join (filiais f left join (filiaisgruposfilia' +
        'is fgf join gruposfiliais gf on fgf.grupo = gf.codigo)  '
      
        '                                                                ' +
        '      on f.codigo = fgf.filial) '
      
        '                                   on ct.filialvenda = f.codigo)' +
        ','
      '('
      'select ct.numero as atual, ct.primogenito, ct.renegociacao,'
      '       (select sum(p.valorvencto)'
      '        from parcelas p  '
      '        where p.contrato = ct.numero and'
      '              p.datapagto is null) as totalvalorvencto_atual,'
      '       (select count(*)'
      '        from parcelas p  '
      '        where p.contrato = ct.numero and'
      '              p.datapagto is null) as qtparcelas_atual'
      '  '
      '  '
      'from contratos ct'
      'where ct.numero in (select max(numero)'
      '                      from contratos'
      
        '                      where  renegociacao between (:datainicial)' +
        ' and (:datafinal) and'
      '                             primogenito is not null'
      ''
      '                       /* filiais */'
      '                      /* agentes */'
      '                     /* conceitos */'
      '                    /* usuarios */'
      ''
      '                      group by primogenito)'
      ') as renegociados'
      '  where renegociados.primogenito = ct.numero'
      'order by renegociacao')
    RequestLive = False
    Left = 360
    Top = 128
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
    object qryRenegociacoescliente: TIntegerField
      FieldName = 'cliente'
    end
    object qryRenegociacoestipocliente: TStringField
      FieldName = 'tipocliente'
      Size = 1
    end
    object qryRenegociacoesnome: TStringField
      FieldName = 'nome'
      Size = 40
    end
    object qryRenegociacoesvendedor: TIntegerField
      FieldName = 'vendedor'
    end
    object qryRenegociacoesnomevendedor: TStringField
      FieldName = 'nomevendedor'
      Size = 50
    end
    object qryRenegociacoesoriginal: TStringField
      FieldName = 'original'
    end
    object qryRenegociacoesfaturamento_original: TDateField
      FieldName = 'faturamento_original'
    end
    object qryRenegociacoestotalvalorvencto_original: TFloatField
      FieldName = 'totalvalorvencto_original'
    end
    object qryRenegociacoesqtparcelas_original: TLargeintField
      FieldName = 'qtparcelas_original'
    end
    object qryRenegociacoesatual: TStringField
      FieldName = 'atual'
    end
    object qryRenegociacoesprimogenito: TStringField
      FieldName = 'primogenito'
    end
    object qryRenegociacoesrenegociacao: TDateField
      FieldName = 'renegociacao'
    end
    object qryRenegociacoestotalvalorvencto_atual: TFloatField
      FieldName = 'totalvalorvencto_atual'
    end
    object qryRenegociacoesqtparcelas_atual: TLargeintField
      FieldName = 'qtparcelas_atual'
    end
    object qryRenegociacoesgrupofilialvenda: TIntegerField
      FieldName = 'grupofilialvenda'
    end
    object qryRenegociacoesnomegrupofilialvenda: TStringField
      FieldName = 'nomegrupofilialvenda'
      Size = 30
    end
    object qryRenegociacoesfilialvenda: TIntegerField
      FieldName = 'filialvenda'
    end
    object qryRenegociacoesnomefilialvenda: TStringField
      FieldName = 'nomefilialvenda'
      Size = 40
    end
  end
