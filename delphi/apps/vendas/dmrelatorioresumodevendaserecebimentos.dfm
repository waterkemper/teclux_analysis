      ''
      ''
      '        /*'
      '        sum(case when p.tipopagto = '#39'T'#39' then'
      '        p.valorvencto else 0.00 end) as creditotroca'
      '        */'
      ''
      ''
      
        '  From (contratos ct join (parcelas p join (filiais f join (fili' +
        'aisgruposfiliais fgf join gruposfiliais gf on fgf.grupo = gf.cod' +
        'igo) on f.codigo = fgf.filial) on coalesce(p.devfilial,p.filialp' +
        'agto) = f.codigo)'
      '                               on ct.numero = p.contrato)'
      '    Where  (ct.numero not in (Select c.origem'
      '                            From contratos c'
      
        #9#9#9'    Where (ct.numero = c.origem) and (c.faturamento <=:datafi' +
        'nal)))'
      
        '      and case when ct.os then ct.tipoequipamento in (1,2) and n' +
        'ot (coalesce(ct.os_garantia,false) and ct.os_garantia_status='#39'A'#39 +
        ') and not coalesce(ct.os_cortesia,false) else true end'
      ''
      '%Estornos_do_Mes_Mesmo_dia_Periodo'
      '%Filial_Devolucao'
      '%Agentes'
      '%Conceitos'
      '%Cliente'
      '          and  (ct.faturamento < :DataInicialMes)'
      '          and  (p.tipopagto is not null)'
      
        '          and  (case when p.tipopagto in ('#39'E'#39','#39'J'#39') then (p.datap' +
        'agto between (:DataInicialMes) and (:DataFinal))'
      
        '                            else (p.deventrada between (:DataIni' +
        'cialMes) and (:DataFinal))'
      '                   end)'
      
        '  Group by gf.descricao, fgf.grupo, f.nome, p.devfilial, p.filia' +
        'lpagto'
