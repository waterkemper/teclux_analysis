      '        0.00 as estorno_receb_a_vista,'
      '        0.00 as estorno_receb_a_prazo,'
      '        0.00 as estorno_receb_entrada,'
      ''
      #9'0.00 as acum_estorno_receb_a_vista,'
      '        0.00 as acum_estorno_receb_a_prazo,'
      '        0.00 as acum_estorno_receb_entrada,'
      '        0.00 as acum_estorno_receb_juros,'
      '        0.00 as acum_estorno_receb_desconto,'
      ''
      '        sum((case when (Select count(*) From parcelas p'
      '                          Where (p.contrato = ct.numero) and'
      
        '                                      (p.datavencto > ct.faturam' +
        'ento)) = 0 then p.valorvencto'
      '              else 0.00'
      '         end)) as acum_fora_receb_a_vista,'
      '        sum((case when (Select count(*) From parcelas p'
      '                          Where (p.contrato = ct.numero) and'
      
        '                                      (p.datavencto > ct.faturam' +
        'ento)) = 0 then 0.00'
      
        '                          else (case when (p.datavencto > ct.fat' +
        'uramento) then p.valorvencto'
      '                                   else 0.00'
      '                  end)'
      '         end)) as acum_fora_receb_a_prazo,'
      '        sum((case when (Select count(*) From parcelas p'
      '                          Where (p.contrato = ct.numero) and'
      
        '                                     (p.datavencto > ct.faturame' +
        'nto)) = 0 then 0.00'
      
        '             else (case when (p.datavencto <= ct.faturamento) th' +
        'en p.valorvencto'
      '                        else 0.00'
      '                   end)'
      '        end)) as acum_fora_receb_entrada,'
      
        '        sum((case when (((p.tipopagto in ('#39'E'#39','#39'J'#39')) and (p.datap' +
        'agto >=:DataInicialMes)) or ((p.tipopagto in ('#39'D'#39','#39'C'#39','#39'P'#39','#39'X'#39')) ' +
        'and (p.datapagto >=:DataInicialMes) and (p.datapagto = p.deventr' +
        'ada))) then p.valorvencto'
      '                         else 0.00'
      '         end)) as acum_estorno_fora_saldo,'
      #9'0.00 as receb_a_vista,'
      #9'0.00 as receb_a_prazo,'
      #9'0.00 as receb_entrada,'
