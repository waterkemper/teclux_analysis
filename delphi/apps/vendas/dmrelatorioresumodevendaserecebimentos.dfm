      end>
    Sql.Strings = (
      '(  Select resultado.* From ('
      '%Inicio_das_Vendas_por_Contrato'
      '  ('
      '  Select'
      '      cast('#39'1 - Vendas'#39' as varchar) as periodo,'
      '      ct.filialvenda as filial,'
      '      fgf.grupo as grupofilial,'
      '      f.nome as nomefilial,'
      '      gf.descricao as nomegrupofilial,'
      ''
      '      sum((case when (Select count(*) From parcelas p'
      '                  where (p.contrato = ct.numero) and'
      
        '                            (p.datavencto > ct.faturamento)) = 0' +
        ' then ct.valorprazo'
      '            else  0.00'
      '       end)) as venda_a_vista,'
      ''
      '       sum((case when (Select count(*) From parcelas p'
      '                   Where (p.contrato = ct.numero) and'
      
        '                              (p.datavencto > ct.faturamento)) =' +
        ' 0 then 0.00'
      '             else  ct.valorprazo'
      '        end)) as venda_a_prazo,'
      ''
      '        sum((case when (Select count(*) From parcelas p'
      
        '                                                     Where (p.co' +
        'ntrato = ct.numero) and'
      
        '                                                                ' +
        ' (p.datavencto > ct.faturamento)) = 0 then 0.00'
      '              else (Select sum(p.valorvencto) From parcelas p'
      
        '                                                                ' +
        ' Where (p.contrato = ct.numero) and'
      
        '                                                                ' +
        '            (p.datavencto <= ct.faturamento))'
      '         end)) as venda_entrada,'
      ''
      '        0.00 as estorno_venda_a_vista,'
      '        0.00 as estorno_venda_a_prazo,'
      '        0.00 as estorno_venda_entrada,'
      ''
      #9'0.00 as acum_venda_a_vista,'
      #9'0.00 as acum_venda_a_prazo,'
      #9'0.00 as acum_venda_entrada,'
      ''
      #9'0.00 as acum_estorno_venda_a_vista,'
      '        0.00 as acum_estorno_venda_a_prazo,'
      '        0.00 as acum_estorno_venda_entrada,'
      ''
      #9'0.00 as estorno_receb_a_vista,'
      #9'0.00 as estorno_receb_a_prazo,'
      #9'0.00 as estorno_receb_entrada,'
      ''
      #9'0.00 as acum_estorno_receb_a_vista,'
      '        0.00 as acum_estorno_receb_a_prazo,'
      '        0.00 as acum_estorno_receb_entrada,'
      '        0.00 as acum_estorno_receb_juros,'
      '        0.00 as acum_estorno_receb_desconto,'
      ''
      ''
      '        0.00 as acum_fora_receb_a_vista,'
      '        0.00 as acum_fora_receb_a_prazo,'
      '        0.00 as acum_fora_receb_entrada,'
      '        0.00 as acum_estorno_fora_saldo,'
      ''
      '        0.00 as receb_a_vista,'
      #9'0.00 as receb_a_prazo,'
      #9'0.00 as receb_entrada,'
      '        0.00 as receb_juros,'
      '        0.00 as receb_desconto,'
      ''
      #9'0.00 as acum_receb_a_vista,'
      #9'0.00 as acum_receb_a_prazo,'
      #9'0.00 as acum_receb_entrada,'
      '        0.00 as acum_receb_juros,'
      '        0.00 as acum_receb_desconto,'
      ''
      '        0.00 as estorno_receb_juros,'
      '        0.00 as estorno_receb_desconto,'
      ''
      '  0.00 as receb_creditotroca,'
      '  0.00 as estorno_receb_creditotroca,'
      ''
      '  - sum(ct.creditotroca) as creditotroca'
      ''
      
        '  From (contratos ct join (filiais f join (filiaisgruposfiliais ' +
        'fgf join gruposfiliais gf on fgf.grupo = gf.codigo) on f.codigo ' +
        '= fgf.filial) on ct.filialvenda = f.codigo)'
      '  Where (ct.faturamento between (:datainicial) and (:datafinal))'
      '          and    ct.origem is null'
      
        '          and case when ct.os then ct.tipoequipamento in (1,2) a' +
        'nd not (coalesce(ct.os_garantia,false) and ct.os_garantia_status' +
        '='#39'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      ''
      '  %Vendas_Mesmo_dia_Periodo'
      '  %Filial_Venda'
      '  %Agentes'
      '  %Conceito'
      '  %Cliente'
      '  Group by gf.descricao, fgf.grupo, f.nome, ct.filialvenda'
      '  )'
      'union all'
      '  ('
      '  Select'
      '        cast('#39'1 - Vendas'#39' as varchar)  as periodo,'
      '        ct.filialvenda as filial,'
      '        fgf.grupo as grupofilial,'
      '        f.nome as nomefilial,'
      '        gf.descricao as nomegrupofilial,'
      '        0.00 as venda_a_vista,'
      '        0.00 as venda_a_prazo,'
      '        0.00 as venda_entrada,'
      ''
      '      0.00 as estorno_venda_a_vista,'
      '      0.00 as estorno_venda_a_prazo,'
      '      0.00 as estorno_venda_entrada,'
      ''
      '        sum((case when (Select count(*) From parcelas p'
      
        '                                                             Whe' +
        're (p.contrato = ct.numero) and'
      
        '                                                                ' +
        '         (p.datavencto > ct.faturamento)) = 0 then ct.valorprazo'
      '                          else  0.00'
      '                  end)) as acum_venda_a_vista,'
      '        sum((case when (Select count(*) From parcelas p'
      
        '                                                             Whe' +
        're (p.contrato = ct.numero) and'
      
        '                                                                ' +
        '        (p.datavencto > ct.faturamento)) = 0 then 0.00'
      '                          else  ct.valorprazo'
      '                 end)) as acum_venda_a_prazo,'
      '        sum((case when (Select count(*) From parcelas p'
      
        '                                                             Whe' +
        're (p.contrato = ct.numero) and'
      
        '                                                                ' +
        '        (p.datavencto > ct.faturamento)) = 0 then 0.00'
      
        '                          else (Select sum(p.valorvencto) From p' +
        'arcelas p'
      
        '                                                                ' +
        '             Where (p.contrato = ct.numero) and'
      
        '                                                                ' +
        '                         (p.datavencto <= ct.faturamento))'
      '                  end)) as acum_venda_entrada,'
      ''
      #9'0.00 as acum_estorno_venda_a_vista,'
      '        0.00 as acum_estorno_venda_a_prazo,'
      '        0.00 as acum_estorno_venda_entrada,'
      ''
      '        0.00 as estorno_receb_a_vista,'
      #9'0.00 as estorno_receb_a_prazo,'
      #9'0.00 as estorno_receb_entrada,'
      ''
      #9'0.00 as acum_estorno_receb_a_vista,'
      #9'0.00 as acum_estorno_receb_a_prazo,'
      '        0.00 as acum_estorno_receb_entrada,'
      '        0.00 as acum_estorno_receb_juros,'
      '        0.00 as acum_estorno_receb_desconto,'
      ''
      '        0.00 as acum_fora_receb_a_vista,'
      '        0.00 as acum_fora_receb_a_prazo,'
      '        0.00 as acum_fora_receb_entrada,'
      '        0.00 as acum_estorno_fora_saldo,'
      ''
      #9'0.00 as receb_a_vista,'
      #9'0.00 as receb_a_prazo,'
      #9'0.00 as receb_entrada,'
      '        0.00 as receb_juros,'
      '        0.00 as receb_desconto,'
      #9'0.00 as acum_receb_a_vista,'
      #9'0.00 as acum_receb_a_prazo,'
      #9'0.00 as acum_receb_entrada,'
      ''
      '        0.00 as acum_receb_juros,'
      '        0.00 as acum_receb_desconto,'
      '        0.00 as estorno_receb_juros,'
      '        0.00 as estorno_receb_desconto,'
      ''
      '  0.00 as receb_creditotroca,'
      '  0.00 as estorno_receb_creditotroca,'
      '  0.00 as creditotroca'
      ''
      
        '  From (contratos ct join (filiais f join (filiaisgruposfiliais ' +
        'fgf join gruposfiliais gf on fgf.grupo = gf.codigo) on f.codigo ' +
        '= fgf.filial) on ct.filialvenda = f.codigo)'
      
        '  Where (ct.faturamento between (:DataInicialMes) and (:DataFina' +
        'l))'
      
        '   and case when ct.os then ct.tipoequipamento in (1,2) and not ' +
        '(coalesce(ct.os_garantia,false) and ct.os_garantia_status='#39'A'#39') a' +
        'nd not coalesce(ct.os_cortesia,false) else true end'
      ''
      '%Vendas_Mesmo_dia_Periodo'
      '%Filial_Venda'
      '%Agentes'
      '%Conceito'
      '%Cliente'
      '          and    ct.origem is null'
      '  Group by gf.descricao, fgf.grupo, f.nome, ct.filialvenda'
      ''
      ''
      '  )'
      '%Final_das_Vendas_por_Contrato'
      '%union_all_Vendas_por_Frente_de_Caixa'
      '%Inicio_das_Vendas_por_Frente_de_Caixa'
      '  ('
      '    Select'
      '    cast('#39'1 - Vendas'#39' as varchar) as periodo,'
      '    df.filialvenda as filial,'
      '    fgf.grupo as grupofilial,'
      '    f.nome as nomefilial,'
      '    gf.descricao as nomegrupofilial,'
      '    sum(df.valortotal) as venda_a_vista,'
      '    0.00 as venda_a_prazo,'
      '    0.00 as venda_entrada,'
      '      0.00 as estorno_venda_a_vista,'
      '      0.00 as estorno_venda_a_prazo,'
      '      0.00 as estorno_venda_entrada,'
      ''
      '      0.00 as acum_venda_a_vista,'
      '      0.00 as acum_venda_a_prazo,'
      '      0.00 as acum_venda_entrada,'
      ''
      #9'0.00 as acum_estorno_venda_a_vista,'
      '        0.00 as acum_estorno_venda_a_prazo,'
      '        0.00 as acum_estorno_venda_entrada,'
      ''
      '      0.00 as estorno_receb_a_vista,'
      '      0.00 as estorno_receb_a_prazo,'
      '      0.00 as estorno_receb_entrada,'
      ''
      '      0.00 as acum_estorno_receb_a_vista,'
      '      0.00 as acum_estorno_receb_a_prazo,'
      '      0.00 as acum_estorno_receb_entrada,'
      '      0.00 as acum_estorno_receb_juros,'
      '      0.00 as acum_estorno_receb_desconto,'
      ''
      '      0.00 as acum_fora_receb_a_vista,'
      '      0.00 as acum_fora_receb_a_prazo,'
      '      0.00 as acum_fora_receb_entrada,'
      '      0.00 as acum_estorno_fora_saldo,'
      '      0.00 as receb_a_vista,'
      '      0.00 as receb_a_prazo,'
      '      0.00 as receb_entrada,'
      '      0.00 as receb_juros,'
      '      0.00 as receb_desconto,'
      ''
      #9'0.00 as acum_receb_a_vista,'
      #9'0.00 as acum_receb_a_prazo,'
      #9'0.00 as acum_receb_entrada,'
      ''
      '      0.00 as acum_receb_juros,'
      '      0.00 as acum_receb_desconto,'
      '      0.00 as estorno_receb_juros,'
      '      0.00 as estorno_receb_desconto,'
      ''
      '      0.00 as receb_creditotroca,'
      '      0.00 as estorno_receb_creditotroca,'
      '      - sum(df.creditotroca) as creditotroca'
      ''
      
        '  From (dadosfiscais df join (filiais f join (filiaisgruposfilia' +
        'is fgf join gruposfiliais gf on fgf.grupo = gf.codigo) on f.codi' +
        'go = fgf.filial) on df.filialvenda = f.codigo)'
      
        '  Where (df.data between (:datainicial) and (:datafinal)) and df' +
        '.contrato is null'
      '          and df.situacao='#39'N'#39
      
        '          and (eHNotaFiscalSaidaVenda(df.codigofiscal) or mod(df' +
        '.codigofiscal,1000) in (929))'
      ''
      '    and not coalesce(df.notavinculada,false)'
      ''
      '  %Filial_Venda'
      '  %Agentes'
      '  %Conceito'
      '  %Cliente'
      '  Group by gf.descricao, fgf.grupo, f.nome, df.filialvenda'
      '  )'
      '   union all'
      '  ('
      '    Select'
      '    cast('#39'1 - Vendas'#39' as varchar) as periodo,'
      '    df.filialvenda as filial,'
      '    fgf.grupo as grupofilial,'
      '    f.nome as nomefilial,'
      '    gf.descricao as nomegrupofilial,'
      '    0.00 as venda_a_vista,'
      '    0.00 as venda_a_prazo,'
      '    0.00 as venda_entrada,'
      '      0.00 as estorno_venda_a_vista,'
      '      0.00 as estorno_venda_a_prazo,'
      '      0.00 as estorno_venda_entrada,'
      ''
      '    sum(df.valortotal) as acum_venda_a_vista,'
      '      0.00 as acum_venda_a_prazo,'
      '      0.00 as acum_venda_entrada,'
      ''
      #9'0.00 as acum_estorno_venda_a_vista,'
      '        0.00 as acum_estorno_venda_a_prazo,'
      '        0.00 as acum_estorno_venda_entrada,'
      ''
      '      0.00 as estorno_receb_a_vista,'
      '      0.00 as estorno_receb_a_prazo,'
      '      0.00 as estorno_receb_entrada,'
      ''
      '      0.00 as acum_estorno_receb_a_vista,'
      '      0.00 as acum_estorno_receb_a_prazo,'
      '      0.00 as acum_estorno_receb_entrada,'
      '      0.00 as acum_estorno_receb_juros,'
      '      0.00 as acum_estorno_receb_desconto,'
      ''
      '      0.00 as acum_fora_receb_a_vista,'
      '      0.00 as acum_fora_receb_a_prazo,'
      '      0.00 as acum_fora_receb_entrada,'
      '      0.00 as acum_estorno_fora_saldo,'
      '      0.00 as receb_a_vista,'
      '      0.00 as receb_a_prazo,'
      '      0.00 as receb_entrada,'
      '      0.00 as receb_juros,'
      '      0.00 as receb_desconto,'
      #9'0.00 as acum_receb_a_vista,'
      #9'0.00 as acum_receb_a_prazo,'
      #9'0.00 as acum_receb_entrada,'
      ''
      '      0.00 as acum_receb_juros,'
      '      0.00 as acum_receb_desconto,'
      '      0.00 as estorno_receb_juros,'
      '      0.00 as estorno_receb_desconto,'
      ''
      '      0.00 as receb_creditotroca,'
      '      0.00 as estorno_receb_creditotroca,'
      ''
      '      0.00 as creditotroca'
      ''
      
        'From (dadosfiscais df join (filiais f join (filiaisgruposfiliais' +
        ' fgf join gruposfiliais gf on fgf.grupo = gf.codigo) on f.codigo' +
        ' = fgf.filial) on df.filialvenda = f.codigo)'
      
        'Where (df.data between (:DataInicialMes) and (:DataFinal)) and d' +
        'f.contrato is null'
      '  and df.situacao='#39'N'#39
      
        '  and (eHNotaFiscalSaidaVenda(df.codigofiscal) or mod(df.codigof' +
        'iscal,1000) in (929))'
      '  and not coalesce(df.notavinculada,false)              '
      ''
      '%Filial_Venda'
      '%Agentes'
      '%Conceito'
      '%Cliente'
      '  Group by gf.descricao, fgf.grupo, f.nome, df.filialvenda'
      ''
      '  )'
      '%Final_das_Vendas_por_Frente_de_Caixa'
      '%union_all_Estornos_do_Mes'
      '%Inicio_Estornos_do_Mes'
      '  ('
      '  Select'
      '        cast('#39'2 - Estornos do Mes'#39' as varchar) as periodo,'
      '        coalesce(p.devfilial,p.filialpagto) as filial,'
      '        fgf.grupo as grupofilial,'
      '        f.nome as nomefilial,'
      '        gf.descricao as nomegrupofilial,'
      '        0.00 as venda_a_vista,'
      '        0.00 as venda_a_prazo,'
      '        0.00 as venda_entrada,'
      '      0.00 as estorno_venda_a_vista,'
      '      0.00 as estorno_venda_a_prazo,'
      '      0.00 as estorno_venda_entrada,'
      ''
      '        0.00 as acum_venda_a_vista,'
      '        0.00 as acum_venda_a_prazo,'
      '        0.00 as acum_venda_entrada,'
      ''
      #9'0.00 as acum_estorno_venda_a_vista,'
      '        0.00 as acum_estorno_venda_a_prazo,'
      '        0.00 as acum_estorno_venda_entrada,'
      ''
      '        sum((case when (Select count(*)'
      #9'                From parcelas p2'
      '                        Where (p2.contrato = ct.numero) and'
      
        '                              (p2.datavencto > ct.faturamento)) ' +
        '= 0 then p.valorvencto else 0.00'
      '             end)) as estorno_receb_a_vista,'
      ''
      '        sum((case when (Select count(*)'
      #9'                From parcelas p2'
      '                        Where (p2.contrato = ct.numero) and'
      
        '                              (p2.datavencto > ct.faturamento)) ' +
        '= 0 then 0.00  else'
      
        #9#9#9'      (case when (p.datavencto > ct.faturamento) then p.valor' +
        'vencto  else 0.00 end)'
      '         end)) as estorno_receb_a_prazo,'
      ''
      '        sum((case when (Select count(*) From parcelas p2'
      '                        Where (p2.contrato = ct.numero) and'
      
        '                              (p2.datavencto > ct.faturamento)) ' +
        '= 0 then 0.00 else'
      
        #9#9#9'      (case when (p.datavencto <= ct.faturamento) then p.valo' +
        'rvencto'
      '                                  else 0.00'
      '                          end)'
      '         end)) as estorno_receb_entrada,'
      ''
      '        0.00 as acum_estorno_receb_a_vista,'
      '        0.00 as acum_estorno_receb_a_prazo,'
      '        0.00 as acum_estorno_receb_entrada,'
      '        0.00 as acum_estorno_receb_juros,'
      '        0.00 as acum_estorno_receb_desconto,'
      ''
      '        0.00 as acum_fora_receb_a_vista,'
      '        0.00 as acum_fora_receb_a_prazo,'
      '        0.00 as acum_fora_receb_entrada,'
      '        0.00 as acum_estorno_fora_saldo,'
      #9'0.00 as receb_a_vista,'
      #9'0.00 as receb_a_prazo,'
      #9'0.00 as receb_entrada,'
      '        0.00 as receb_juros,'
      '        0.00 as receb_desconto,'
      #9'0.00 as acum_receb_a_vista,'
      #9'0.00 as acum_receb_a_prazo,'
      #9'0.00 as acum_receb_entrada,'
      ''
      '        0.00 as acum_receb_juros,'
      '        0.00 as acum_receb_desconto,'
      ''
      
        '        sum((case when (p.valorvencto < p.valorpagto) then p.val' +
        'orpagto - p.valorvencto'
      '                  else 0.00'
      '         end)) as estorno_receb_juros,'
      ''
      
        '         sum((case when (p.valorvencto > p.valorpagto) then p.va' +
        'lorpagto - p.valorvencto'
      '                   else 0.00'
      '          end)) as estorno_receb_desconto,'
      ''
      '          /*'
      '      sum(case when p.tipopagto = '#39'T'#39' then'
      '        p.valorvencto else 0.00 end) as receb_creditotroca'
      '        */'
      ''
      '        0.00 as receb_creditotroca,'
      ''
      '       - sum(case when p.tipopagto = '#39'T'#39' then'
      
        '          p.valorvencto else 0.00 end) as estorno_receb_creditot' +
        'roca,'
      ''
      '       0.00 as creditotroca'
      ''
      
        '  From (contratos ct join (parcelas p join (filiais f  join (fil' +
        'iaisgruposfiliais fgf left join gruposfiliais gf on fgf.grupo = ' +
        'gf.codigo) on f.codigo = fgf.filial) on coalesce(p.devfilial,p.f' +
        'ilialpagto) = f.codigo)'
      '                                on ct.numero = p.contrato)'
      '  Where  (ct.numero not in (Select c.origem'
      '                            From contratos c'
      
        #9#9#9'    Where (ct.numero = c.origem) and (c.faturamento <=:datafi' +
        'nal)))'
      
        '   and case when ct.os then ct.tipoequipamento in (1,2) and not ' +
        '(coalesce(ct.os_garantia,false) and ct.os_garantia_status='#39'A'#39') a' +
        'nd not coalesce(ct.os_cortesia,false) else true end'
      ''
      '%Estornos_do_Mes_Mesmo_dia_Periodo'
      '%Filial_Devolucao'
      '%Agentes'
      '%Conceitos'
      '%Cliente'
      '        and (ct.faturamento >= :datainicial)'
      '        and (p.tipopagto is not null)'
      
        '        and (case when p.tipopagto in ('#39'E'#39','#39'J'#39') then (p.datapagt' +
        'o between(:datainicial) and (:datafinal))'
      
        '                         else (p.deventrada between(:datainicial' +
        ') and (:datafinal))'
      '                end)'
      
        '  Group by gf.descricao, fgf.grupo, f.nome, p.devfilial, p.filia' +
        'lpagto'
      '  )'
      '  union all'
      '  ('
      '  Select'
      '        cast('#39'2 - Estornos do Mes'#39' as varchar) as periodo,'
      '        coalesce(p.devfilial,p.filialpagto) as filial,'
      '        fgf.grupo as grupofilial,'
      '        f.nome as nomefilial,'
      '        gf.descricao as nomegrupofilial,'
      '        0.00 as venda_a_vista,'
      '        0.00 as venda_a_prazo,'
      '        0.00 as venda_entrada,'
      ''
      '        sum((case when (Select count(*)'
      #9'                From parcelas p2'
      '                        Where (p2.contrato = ct.numero) and'
      
        '                              (p2.datavencto > ct.faturamento)) ' +
        '= 0 then p.valorvencto else 0.00'
      '             end)) as estorno_venda_a_vista,'
      ''
      '        sum((case when (Select count(*)'
      #9'                From parcelas p2'
      '                        Where (p2.contrato = ct.numero) and'
      
        '                              (p2.datavencto > ct.faturamento)) ' +
        '= 0 then 0.00  else'
      
        #9#9#9'      (case when (p.datavencto > ct.faturamento) then p.valor' +
        'vencto  else 0.00 end)'
      '         end)) as estorno_venda_a_prazo,'
      ''
      '        sum((case when (Select count(*) From parcelas p2'
      '                        Where (p2.contrato = ct.numero) and'
      
        '                              (p2.datavencto > ct.faturamento)) ' +
        '= 0 then 0.00 else'
      
        #9#9#9'      (case when (p.datavencto <= ct.faturamento) then p.valo' +
        'rvencto'
      '                                  else 0.00'
      '                          end)'
      '         end)) as estorno_venda_entrada,'
      '        0.00 as acum_venda_a_vista,'
      '        0.00 as acum_venda_a_prazo,'
      '        0.00 as acum_venda_entrada,'
      ''
      #9'0.00 as acum_estorno_venda_a_vista,'
      '        0.00 as acum_estorno_venda_a_prazo,'
      '        0.00 as acum_estorno_venda_entrada,'
      ''
      #9'0.00 as estorno_receb_a_vista,'
      '        0.00 as estorno_receb_a_prazo,'
      #9'0.00 as estorno_receb_entrada,'
      ''
      #9'0.00 as acum_estorno_receb_a_vista,'
      '        0.00 as acum_estorno_receb_a_prazo,'
      '        0.00 as acum_estorno_receb_entrada,'
      '        0.00 as acum_estorno_receb_juros,'
      '        0.00 as acum_estorno_receb_desconto,'
      ''
      '        0.00 as acum_fora_receb_a_vista,'
      '        0.00 as acum_fora_receb_a_prazo,'
      '        0.00 as acum_fora_receb_entrada,'
      '        0.00 as acum_estorno_fora_saldo,'
      #9'0.00 as receb_a_vista,'
      #9'0.00 as receb_a_prazo,'
      #9'0.00 as receb_entrada,'
