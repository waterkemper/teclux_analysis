      '        0.00 as estorno_receb_a_prazo,'
      '        0.00 as estorno_receb_entrada,'
      ''
      '        sum((case when (Select count(*) From parcelas p'
      
        '                                    Where (p.contrato = ct.numer' +
        'o) and'
      
        '                                                (p.datavencto > ' +
        'ct.faturamento)) = 0 then p.valorvencto'
      '                         else 0.00'
      '                 end)) as acum_estorno_receb_a_vista,'
      '        sum((case when (Select count(*) From parcelas p'
      
        '                                   Where (p.contrato = ct.numero' +
        ') and'
      
        '                                               (p.datavencto > c' +
        't.faturamento)) = 0 then 0.00'
      
        '                        else (case when (p.datavencto > ct.fatur' +
        'amento) then p.valorvencto'
      '                                         else 0.00'
      '                                 end)'
      '              end)) as acum_estorno_receb_a_prazo,'
      '        sum((case when (Select count(*) From parcelas p'
      
        '                                    Where (p.contrato = ct.numer' +
        'o) and'
      
        '                                                (p.datavencto > ' +
        'ct.faturamento)) = 0 then 0.00'
      
        '                          else (case when (p.datavencto <= ct.fa' +
        'turamento) then p.valorvencto'
      '                                           else 0.00'
      '                                   end)'
      '                end)) as acum_estorno_receb_entrada,'
      ''
      
        '        sum((case when (p.valorvencto < p.valorpagto) then p.val' +
        'orpagto - p.valorvencto'
      '                  else 0.00'
      '         end)) as acum_estorno_receb_juros,'
      ''
      
        '         sum((case when (p.valorvencto > p.valorpagto) then p.va' +
        'lorpagto - p.valorvencto'
      '                   else 0.00'
      '          end)) as acum_estorno_receb_desconto,'
      ''
      '        0.00 as acum_fora_receb_a_vista,'
      '        0.00 as acum_fora_receb_a_prazo,'
      '        0.00 as acum_fora_receb_entrada,'
      '        0.00 as acum_estorno_fora_saldo,'
      #9'      0.00 as receb_a_vista,'
      #9'      0.00 as receb_a_prazo,'
      #9'      0.00 as receb_entrada,'
      '        0.00 as receb_juros,'
