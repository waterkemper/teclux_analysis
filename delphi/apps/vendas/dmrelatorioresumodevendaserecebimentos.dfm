      #9'0.00 as acum_receb_a_vista,'
      #9'0.00 as acum_receb_a_prazo,'
      #9'0.00 as acum_receb_entrada,'
      ''
      '        0.00 as acum_receb_juros,'
      '        0.00 as acum_receb_desconto,'
      '        0.00 as estorno_receb_juros,'
      '        0.00 as estorno_receb_desconto,'
      ''
      '        0.00 as receb_creditotroca,'
