  object qryConsultaClientes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select v.nome,'
      '       formatar_cpf_cnpj(v.pessoanumero) as pessoanumero,'
      '       v.estado,'
      '       c.nome as nomecidade,'
      '       v.codigo,'
      '       v.civil,'
      '       v.tipo as tipoorig,'
      '       cast(case when v.tipo = '#39'F'#39' then '#39'Fornecedor'#39
      '                       when v.tipo = '#39'C'#39' then '#39'Cliente'#39
      '               end as varchar) as tipo'
      'From   vfornecedores v, cidades c'
      
        'where (v.tipo <> '#39'L'#39') and (v.estado = c.estado) and (v.cidade = ' +
        'c.codigo)'
      'and false'
      'Order By UPPER(TO_ASCII(v.nome,'#39'LATIN1'#39'))')
    RequestLive = False
    Left = 58
    Top = 340
    object qryConsultaClientesnome: TStringField
      DisplayLabel = 'Nome'
      FieldName = 'nome'
      Size = 40
    end
    object qryConsultaClientespessoanumero: TStringField
      DisplayLabel = 'CPF/CGC'
      FieldName = 'pessoanumero'
      Size = 18
    end
    object qryConsultaClientesnomecidade: TStringField
      DisplayLabel = 'Cidade'
