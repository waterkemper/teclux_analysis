      item
        DataType = ftString
        Name = 'union_all_Recebimentos_por_Frente_de_Caixa'
        ParamType = ptUnknown
        Value = 'union all'
      end
      item
        DataType = ftUnknown
        Name = 'Inicio_Recebimentos_por_Frente_de_Caixa'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Final_Recebimentos_por_Frente_de_Caixa'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '(  Select resultado.* From ('
      '%Inicio_das_Vendas_por_Contrato'
      '('
      'Select'
      '    cast('#39'1 - Vendas'#39' as varchar(100)) as periodo,'
      '    ct.filialvenda as filial,'
      '    fgf.grupo as grupofilial,'
      '    f.nome as nomefilial,'
      '    gf.descricao as nomegrupofilial,'
      '    ct.cliente,'
      '    ct.tipocliente,'
      '    ct.nome as nomecliente,'
      '    ct.faturamento as data,'
      '    ct.numero as contrato,'
      '    cast(null as varchar(7)) as parcela,'
      '    cast('#39' '#39' as varchar) as tipopagto,'
      ''
      '    (case when (Select count(*) From parcelas p'
      '                where (p.contrato = ct.numero) and'
      
        '                          (p.datavencto > ct.faturamento)) = 0 t' +
        'hen ct.valorprazo'
      '          else  0.00'
      '     end) as venda_a_vista,'
      ''
      '     (case when (Select count(*) From parcelas p'
      '                 Where (p.contrato = ct.numero) and'
      
        '                            (p.datavencto > ct.faturamento)) = 0' +
        ' then 0.00'
      '           else  ct.valorprazo'
      '      end) as venda_a_prazo,'
      ''
      '      (case when (Select count(*) From parcelas p'
      
        '                                                   Where (p.cont' +
        'rato = ct.numero) and'
      
        '                                                               (' +
        'p.datavencto > ct.faturamento)) = 0 then 0.00'
      '            else (Select sum(p.valorvencto) From parcelas p'
      
        '                                                               W' +
        'here (p.contrato = ct.numero) and'
      
        '                                                                ' +
        '          (p.datavencto <= ct.faturamento))'
      '       end) as venda_entrada,'
      ''
      
        '      (ct.valorvista /*- coalesce((select sum(quantidade*valorse' +
        'rvico)'
      
        '                                         from servicoscontratos ' +
        'sc'
      
        '                                         Where sc.contrato=ct.nu' +
        'mero),0)*/ -'
      #9#9#9#9#9'     coalesce(ct.frete,0)-'
      #9#9#9#9#9'     coalesce(ct.seguro,0)+'
      #9#9#9#9#9'     coalesce(ct.desconto,0) +'
      '               coalesce((select sum(pc.valordescontoitem)'
      '                   from produtoscontratos pc'
      '                   where pc.contrato = ct.numero),0)'
      '               ) as mercadorias,'
      ''
      '      - (coalesce(ct.desconto,0) +'
      '         coalesce((select sum(pc.valordescontoitem)'
      '                   from produtoscontratos pc'
      
        '                   where pc.contrato = ct.numero),0)) as descont' +
        'omercadorias,'
      
        '      (coalesce(ct.frete,0)+coalesce(ct.seguro,0)+(ct.valorprazo' +
        '-ct.valorvista)) as acrescimomercadorias,'
      ''
      '      0.00 as estorno_receb_a_vista,'
      '      0.00 as estorno_receb_a_prazo,'
      '      0.00 as estorno_receb_entrada,'
      ''
      '      0.00 as saldo,'
      ''
      '      0.00 as estorno_fora_receb_a_vista,'
      '      0.00 as estorno_fora_receb_a_prazo,'
      '      0.00 as estorno_fora_receb_entrada,'
      '      0.00 as forasaldo,'
      ''
      '      0.00 as prestacao,'
      '      0.00 as juro,'
      '      0.00 as desconto,'
      '      - ct.creditotroca as creditotroca'
      ''
      
        'From (contratos ct join (filiais f join (filiaisgruposfiliais fg' +
        'f join gruposfiliais gf on fgf.grupo = gf.codigo) on f.codigo = ' +
        'fgf.filial) on ct.filialvenda = f.codigo)'
      'Where (ct.faturamento between (:datainicial) and (:datafinal))'
      '        and    ct.origem is null'
      
        '        and case when ct.os then ct.tipoequipamento in (1,2) and' +
        ' not (coalesce(ct.os_garantia,false) and ct.os_garantia_status='#39 +
        'A'#39') and not coalesce(ct.os_cortesia,false) else true end'
      ''
      '%Vendas_Mesmo_dia_Periodo'
      '%Filial_Venda'
      '%Agentes'
      '%Conceito'
      '%Cliente'
      ')'
      '%Final_das_Vendas_por_Contrato'
      '%union_all_Vendas_por_Frente_de_Caixa'
      '%Inicio_das_Vendas_por_Frente_de_Caixa'
      '('
      'Select'
      '    cast('#39'1 - Vendas'#39' as varchar(100)) as periodo,'
      '    df.filialvenda as filial,'
      '    fgf.grupo as grupofilial,'
      '    f.nome as nomefilial,'
      '    gf.descricao as nomegrupofilial,'
      '    df.cliente,'
      '    df.tipocliente,'
      
        '    coalesce((select coalesce(vf.razao,vf.nome) from vfornecedor' +
        'es vf where vf.codigo = df.cliente and vf.tipo=df.tipocliente),c' +
        'ast('#39'FRENTE DE CAIXA'#39' as varchar)) as nomecliente,'
      '    df.data,'
      '    cast(null as varchar(20)) as contrato,'
      '    cast(null as varchar(7)) as parcela,'
      '    cast(null as varchar) as tipopagto,'
      '    df.valortotal as venda_a_vista,'
      '    0.00 as venda_a_prazo,'
      '    0.00 as venda_entrada,'
      
        '    (df.valortotal-coalesce((select sum(sdf.quantidade*sdf.valor' +
        'servico)'
      '                             from servicosdadosfiscais sdf'
      
        '                             Where sdf.dadofiscal=df.numero),0)-' +
        'coalesce(df.valorfrete,0)-coalesce(df.seguro,0)+coalesce(df.desc' +
        'onto,0)+coalesce(df.descontoitem,0)) as mercadorias,'
      
        '    -(coalesce(df.desconto,0) + coalesce(df.descontoitem,0)) as ' +
        'descontomercadorias,'
      
        '    (coalesce(df.valorfrete,0)+coalesce(df.seguro,0)+(df.valorto' +
        'tal-df.valorvista)) as acrescimomercadorias,'
      ''
      '      0.00 as estorno_receb_a_vista,'
      '      0.00 as estorno_receb_a_prazo,'
      '      0.00 as estorno_receb_entrada,'
      ''
      '      0.00 as saldo,'
      ''
      '      0.00 as estorno_fora_receb_a_vista,'
      '      0.00 as estorno_fora_receb_a_prazo,'
      '      0.00 as estorno_fora_receb_entrada,'
      '      0.00 as forasaldo,'
      ''
      '      0.00 as prestacao,'
      '      0.00 as juro,'
      '      0.00 as desconto,'
      '      - df.creditotroca as creditotroca'
      ''
      
        'From (dadosfiscais df join (filiais f join (filiaisgruposfiliais' +
        ' fgf join gruposfiliais gf on fgf.grupo = gf.codigo) on f.codigo' +
        ' = fgf.filial) on df.filialvenda = f.codigo)'
      
        'Where (df.data between (:datainicial) and (:datafinal)) and df.c' +
        'ontrato is null'
      '          and df.situacao='#39'N'#39
      ''
      
        '          and (eHNotaFiscalSaidaVenda(df.codigofiscal) or mod(df' +
        '.codigofiscal,1000) in (929))'
      '       '
      '  and not coalesce(df.notavinculada,false)'
      ''
      '%Filial_Venda'
      '%Agentes'
      '%Conceito'
      '%Cliente'
      ')'
      '%Final_das_Vendas_por_Frente_de_Caixa'
      '%union_all_Estornos_do_Mes'
      '%Inicio_Estornos_do_Mes'
      '('
      'Select'
      '      cast('#39'2 - Estornos do Mes'#39' as varchar(100)) as periodo,'
      '      coalesce(p.devfilial,p.filialpagto) as filial,'
      '      fgf.grupo as grupofilial,'
      '      f.nome as nomefilial,'
      '      gf.descricao as nomegrupofilial,'
      '      ct.cliente,'
      '      ct.tipocliente,'
      '      ct.nome as nomecliente,'
      '      ct.faturamento as data,'
      '      ct.numero as contrato,'
      '      p.parcelaorigem as parcela,'
      '      cast(p.tipopagto as varchar) as tipopagto,'
      '      0.00 as venda_a_vista,'
      '      0.00 as venda_a_prazo,'
      '      0.00 as venda_entrada,'
      '      0.00 as mercadorias,'
      '      0.00 as descontomercadorias,'
      '      0.00 as acrescimomercadorias,'
      '      (case when (Select count(*) From parcelas p'
      
        '                                                   Where (p.cont' +
        'rato = ct.numero) and'
      
        '                                                               (' +
        'p.datavencto > ct.faturamento)) = 0 then p.valorvencto'
      '                else 0.00'
      '       end) as estorno_receb_a_vista,'
      '      (case when (Select count(*) From parcelas p'
      
        '                                                   Where (p.cont' +
        'rato = ct.numero) and'
      
        '                                                              (p' +
        '.datavencto > ct.faturamento)) = 0 then 0.00'
      
        '                else (case when (p.datavencto > ct.faturamento) ' +
        'then p.valorvencto'
      '                                 else 0.00'
      '                         end)'
      '       end) as estorno_receb_a_prazo,'
      '      (case when (Select count(*) From parcelas p'
      
        '                                                   Where (p.cont' +
        'rato = ct.numero) and'
      
        '                                                              (p' +
        '.datavencto > ct.faturamento)) = 0 then 0.00'
      
        '               else (case when (p.datavencto <= ct.faturamento) ' +
        'then p.valorvencto'
      '                                else 0.00'
      '                        end)'
      '       end) as estorno_receb_entrada,'
      '      (case when p.tipopagto in ('#39'E'#39','#39'J'#39') then p.valorvencto'
      '                else 0.00'
      '       end) as saldo,'
      ''
      '      0.00 as estorno_fora_receb_a_vista,'
      '      0.00 as estorno_fora_receb_a_prazo,'
      '      0.00 as estorno_fora_receb_entrada,'
      '      0.00 as forasaldo,'
      ''
      '      0.00 as prestacao,'
      '      0.00 as juro,'
      '      0.00 as desconto,'
      ''
      '      case when p.tipopagto = '#39'T'#39' then'
      '      p.valorvencto else 0.00 end as creditotroca'
      ''
      ''
      
        'From (contratos ct join (parcelas p join (filiais f  join (filia' +
        'isgruposfiliais fgf left join gruposfiliais gf on fgf.grupo = gf' +
        '.codigo) on f.codigo = fgf.filial) on coalesce(p.devfilial,p.fil' +
        'ialpagto) = f.codigo)'
      '                              on ct.numero = p.contrato)'
      '  Where  (ct.numero not in (Select c.origem'
      '                            From contratos c'
      
        #9#9#9'    Where (ct.numero = c.origem) and (c.faturamento <=:datafi' +
        'nal)))'
      
        '   and case when ct.os then ct.tipoequipamento in (1,2) and not ' +
        '(coalesce(ct.os_garantia,false) and ct.os_garantia_status='#39'A'#39') a' +
        'nd not coalesce(ct.os_cortesia,false) else true end'
      ''
      '%Estornos_do_Mes_Mesmo_dia_Periodo'
      '%Filial_Devolucao'
      '%Agentes'
      '%Conceitos'
      '%Cliente'
      '      and (ct.faturamento >= :datainicial)'
      '      and (p.tipopagto is not null)'
      
        '      and (case when p.tipopagto in ('#39'E'#39','#39'J'#39') then (p.datapagto ' +
        'between(:datainicial) and (:datafinal))'
      
        '                       else (p.deventrada between(:datainicial) ' +
        'and (:datafinal))'
      '              end)'
      ')'
      '%Final_Estornos_no_Mes'
      '%union_all_Estornos_Fora_do_Mes'
      '%Inicio_Estornos_Fora_do_Mes'
      '('
      'Select'
      
        '      cast('#39'3 - Estornos Fora do Mes'#39' as varchar(100)) as period' +
        'o,'
      '      coalesce(p.devfilial,p.filialpagto) as filial,'
      '      fgf.grupo as grupofilial,'
      '      f.nome as nomefilial,'
      '      gf.descricao as nomegrupofilial,'
      '      ct.cliente,'
      '      ct.tipocliente,'
      '      ct.nome as nomecliente,'
      '      ct.faturamento as data,'
      '      ct.numero as contrato,'
      '      p.parcelaorigem as parcela,'
      '      cast(p.tipopagto as varchar) as tipopagto,'
      '      0.00 as venda_a_vista,'
      '      0.00 as venda_a_prazo,'
      '      0.00 as venda_entrada,'
      '      0.00 as mercadorias,'
      '      0.00 as descontomercadorias,'
      '      0.00 as acrescimomercadorias,'
      '      0.00 as estorno_receb_a_vista,'
      '      0.00 as estorno_receb_a_prazo,'
      '      0.00 as estorno_receb_entrada,'
      '      0.00 as saldo,'
      ''
      '      (case when (Select count(*) From parcelas p'
      '                  Where (p.contrato = ct.numero) and'
      
        '                             (p.datavencto > ct.faturamento)) = ' +
        '0 then p.valorvencto'
      '            else 0.00'
      '       end) as estorno_fora_receb_a_vista,'
      '      (case when (Select count(*) From parcelas p'
      '                  Where (p.contrato = ct.numero) and'
      
        '                             (p.datavencto > ct.faturamento)) = ' +
        '0 then 0.00'
      
        '            else (case when (p.datavencto > ct.faturamento) then' +
        ' p.valorvencto'
      '                             else 0.00'
      '                  end)'
      '       end) as estorno_fora_receb_a_prazo,'
      '      (case when (Select count(*) From parcelas p'
      '                 Where (p.contrato = ct.numero) and'
      
        '                            (p.datavencto > ct.faturamento)) = 0' +
        ' then 0.00'
      
        '           else (case when (p.datavencto <= ct.faturamento) then' +
        ' p.valorvencto'
      '                            else 0.00'
      '                 end)'
      '      end) as estorno_fora_receb_entrada,'
      
        '      (case when (((p.tipopagto in ('#39'E'#39','#39'J'#39')) and (p.datapagto >' +
        '= :datainicialmes)) or ((p.tipopagto in ('#39'D'#39','#39'C'#39','#39'P'#39','#39'X'#39')) and (' +
        'p.datapagto >= :datainicialmes) and (p.datapagto = p.deventrada)' +
        ')) then p.valorvencto'
      '               else 0.00'
      '       end) as forasaldo,'
      ''
      '      0.00 as prestacao,'
      '      0.00 as juro,'
      '      0.00 as desconto,'
      ''
      '      case when p.tipopagto = '#39'T'#39' then'
      '        p.valorvencto else 0.00 end as creditotroca'
      ''
      ''
      
        'From (contratos ct join (parcelas p join (filiais f join (filiai' +
        'sgruposfiliais fgf join gruposfiliais gf on fgf.grupo = gf.codig' +
        'o) on f.codigo = fgf.filial) on coalesce(p.devfilial,p.filialpag' +
        'to) = f.codigo)'
      '                             on ct.numero = p.contrato)'
      '    Where  (ct.numero not in (Select c.origem'
      '                            From contratos c'
      
        #9#9#9'    Where (ct.numero = c.origem) and (c.faturamento <=:datafi' +
        'nal)))'
      
        '     and case when ct.os then ct.tipoequipamento in (1,2) and no' +
        't (coalesce(ct.os_garantia,false) and ct.os_garantia_status='#39'A'#39')' +
        ' and not coalesce(ct.os_cortesia,false) else true end'
      ''
      '%Estornos_do_Mes_Mesmo_dia_Periodo'
      '%Filial_Devolucao'
      '%Agentes'
      '%Conceitos'
      '%Cliente'
      '        and  (ct.faturamento < :datainicialmes)'
      '        and  (p.tipopagto is not null)'
      
        '        and  (case when p.tipopagto in ('#39'E'#39','#39'J'#39') then (p.datapag' +
        'to between (:datainicial) and (:datafinal))'
      
        '                          else (p.deventrada between (:datainici' +
        'al) and (:datafinal))'
      '                 end)'
      ')'
      '%Final_Estornos_Fora_do_Mes'
      '%union_all_Recebimentos_por_Contrato'
      '%Inicio_Recebimentos_por_Contrato'
      '('
      'Select'
      '      cast('#39'4 - Recebimentos'#39' as varchar(100)) as periodo,'
      '      p.filialpagto as filial,'
      '      fgf.grupo as grupofilial,'
      '      f.nome as nomefilial,'
      '      gf.descricao as nomegrupofilial,'
      '      ct.cliente,'
      '      ct.tipocliente,'
      '      ct.nome as nomecliente,'
      '      p.datapagto as data,'
      '      ct.numero as contrato,'
      '      p.parcelaorigem as parcela,'
      
        '      case when p.formapagamento = '#39'T'#39' then p.formapagamento els' +
        'e cast(p.tipopagto as varchar) end as tipopagto,'
      '      0.00 as venda_a_vista,'
      '      0.00 as venda_a_prazo,'
      '      0.00 as venda_entrada,'
      '      0.00 as mercadorias,'
      '      0.00 as descontomercadorias,'
      '      0.00 as acrescimomercadorias,'
      '      0.00 as estorno_receb_a_vista,'
      '      0.00 as estorno_receb_a_prazo,'
      '      0.00 as estorno_receb_entrada,'
      '      0.00 as saldo,'
      ''
      '      0.00 as estorno_fora_receb_a_vista,'
      '      0.00 as estorno_fora_receb_a_prazo,'
      '      0.00 as estorno_fora_receb_entrada,'
      '      0.00 as forasaldo,'
      ''
      '      p.valorvencto as prestacao,'
      
        '      (case when (p.valorvencto < p.valorpagto) then p.valorpagt' +
        'o - p.valorvencto'
      '                else 0.00'
      '       end) as juro,'
      ''
      
        '       (case when (p.valorvencto > p.valorpagto) then p.valorpag' +
        'to - p.valorvencto'
      '                 else 0.00'
      '        end) as desconto,'
      ''
      '     - case when p.formapagamento = '#39'T'#39' then'
      '        p.valorvencto else 0.00 end as creditotroca'
      ''
      
        'From (contratos ct join (parcelas p join (filiais f  join (filia' +
        'isgruposfiliais fgf join gruposfiliais gf on fgf.grupo=gf.codigo' +
        ') on f.codigo=fgf.filial) on p.filialpagto=f.codigo)'
      '                             on ct.numero=p.contrato)'
      'Where (ct.situacao in ('#39'C'#39','#39'F'#39','#39'N'#39','#39'P'#39'))'
      
        '  and case when ct.os then ct.tipoequipamento in (1,2) and not (' +
        'coalesce(ct.os_garantia,false) and ct.os_garantia_status='#39'A'#39') an' +
        'd not coalesce(ct.os_cortesia,false) else true end'
      ''
      '%Filial_Pagamento'
      '%Agentes'
      '%Conceito'
      '%Cliente'
      '    and (p.datapagto between(:dataInicial) and (:dataFinal))'
      '    and (p.tipopagto is null)'
      '    and (ct.faturamento <=:datafinal)'
      
        '    and (ct.numero not in (Select c.origem From contratos c Wher' +
        'e (ct.numero = c.origem) and (c.faturamento <= (:datafinal))))'
      ')'
      '%Final_Recebimentos_por_Contrato'
      '%union_all_Recebimentos_por_Frente_de_Caixa'
      '%Inicio_Recebimentos_por_Frente_de_Caixa'
      '('
      'Select'
      '      cast('#39'4 - Recebimentos'#39' as varchar(100)) as periodo,'
      '      df.filialvenda as filial,'
      '      fgf.grupo as grupofilial,'
      '      f.nome as nomefilial,'
      '      gf.descricao as nomegrupofilial,'
      '      df.cliente,'
      '      df.tipocliente,'
      
        '      coalesce((select coalesce(vf.razao,vf.nome) from vforneced' +
        'ores vf where vf.codigo = df.cliente and vf.tipo=df.tipocliente)' +
        ',cast('#39'FRENTE DE CAIXA'#39' as varchar)) as nomecliente,'
      '      df.data,'
      '      cast(null as varchar(20)) as contrato,'
      '      cast(null as varchar(7)) as parcela,'
      
        '      case when coalesce(df.creditotroca,0)<>0 then cast('#39'T'#39' as ' +
        'varchar) else cast(null as varchar) end as tipopagto,'
      '      0.00 as venda_a_vista,'
      '      0.00 as venda_a_prazo,'
      '      0.00 as venda_entrada,'
      '      0.00 as mercadorias,'
      '      0.00 as descontomercadorias,'
      '      0.00 as acrescimomercadorias,'
      '      0.00 as estorno_receb_a_vista,'
      '      0.00 as estorno_receb_a_prazo,'
      '      0.00 as estorno_receb_entrada,'
      '      0.00 as saldo,'
      ''
      '      0.00 as estorno_fora_receb_a_vista,'
      '      0.00 as estorno_fora_receb_a_prazo,'
      '      0.00 as estorno_fora_receb_entrada,'
      '      0.00 as forasaldo,'
      ''
      '      df.valortotal as prestacao,'
      '      0.00 as juro,'
      '      0.00 as desconto,'
      '      - df.creditotroca as creditotroca'
      '      /*'
      '      (df.valortotal - df.valorvista) as juro,'
      
        '      - coalesce(df.desconto,0)+coalesce(df.descontoitem,0) as d' +
        'esconto'
      '      */'
      ''
      ''
      
        'From (dadosfiscais df join (filiais f join (filiaisgruposfiliais' +
        ' fgf join gruposfiliais gf on fgf.grupo = gf.codigo) on f.codigo' +
        ' = fgf.filial) on df.filialvenda = f.codigo)'
      
        'Where (df.data between (:datainicial) and (:datafinal)) and df.c' +
        'ontrato is null'
      '          and df.situacao='#39'N'#39'                         '
      
        '      and (eHNotaFiscalSaidaVenda(df.codigofiscal) or mod(df.cod' +
        'igofiscal,1000) in (929))              '
      '              '
      '  and not coalesce(df.notavinculada,false)'
      ''
      '%Filial_Venda'
      '%Agentes'
      '%Conceito'
      '%Cliente'
      ')'
      '%Final_Recebimentos_por_Frente_de_Caixa'
      ') as resultado'
      
        'Order By resultado.nomefilial, resultado.filial, resultado.perio' +
        'do, resultado.nomecliente, resultado.cliente, to_number(resultad' +
        'o.contrato,'#39'99999999999999999999'#39') )')
    RequestLive = True
    Left = 187
    Top = 24
    ParamData = <
      item
        DataType = ftString
        Name = 'datainicial'
        ParamType = ptUnknown
        Value = #39'2018-01-01'#39
      end
      item
        DataType = ftString
        Name = 'datafinal'
        ParamType = ptUnknown
        Value = #39'2018-01-31'#39
      end
      item
        DataType = ftString
        Name = 'datainicialmes'
        ParamType = ptUnknown
        Value = #39'2018-01-31'#39
      end>
