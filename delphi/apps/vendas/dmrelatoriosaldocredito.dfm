  object qrySaldosCredito: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qrySaldosCreditoCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftString
        Name = 'Filtros'
        ParamType = ptUnknown
        Value = 'and false'
      end>
    Sql.Strings = (
      'Select pt.tipo,'
      '       pt.data,'
      '       pt.cliente,'
      '       pt.tipocliente,'
      '       cast(vf.nome as varchar(60)) as nomecliente,'
      '       pt.produto,'
      
        '       (select p.descricao from produtos p where p.codigo = pt.p' +
        'roduto) as DescricaoProduto,'
      
        '       (Select grupo from(select * from (Select p.codigo, c.grup' +
        'o from caracteristicas c, produtos p where c.codigo = p.caracter' +
        'istica)as temp)as temp2 where codigo = pt.produto)as Grupo,'
      
        '       (Select Classe from(select * from (Select p.codigo, c.cla' +
        'sse from caracteristicas c, produtos p where c.codigo = p.caract' +
        'eristica)as temp)as temp2 where codigo = pt.produto)as Classe,'
      '       pt.filial,'
      '       pt.contrato,'
      '       pt.valor,'
      '       pt.saldo,'
      '       (select pt2.saldo'
      '          from produtostrocados pt2'
      '            where pt2.cliente = pt.cliente'
      
        '            order by pt2.data desc, pt2.numero desc limit 1) as ' +
        'SaldoAtualCliente,'
      
        '       (case when pt.tipo = '#39'E'#39' then pt.valor else -pt.valor end' +
        ') as SaldoTotal,'
      ''
      '       cast(0 as numeric) as saldofinal,'
      '       pt.referencia,'
      '       pt.usuario,'
      
        '       (Select u.nome from usuarios u where u.codigo = pt.usuari' +
        'o) as usuarios,'
      '       pt.usuarioautorizacao,'
      
        '       (Select u.nome from usuarios u where u.codigo = pt.usuari' +
        'oautorizacao) as NomeUsuariosAutorizacao,'
      '       pt.evento,'
      
        '       (select e.descricao from eventos e where e.codigo = pt.ev' +
        'ento) as DescricaoEvento'
      ''
      'from produtostrocados pt'
      '     left join vfornecedores vf'
      '     on pt.cliente = vf.codigo and pt.tipocliente = vf.tipo'
      ''
      'WHERE true'
      '%Filtros'
      'order by pt.cliente, pt.tipocliente, pt.data')
    RequestLive = False
    Left = 40
    Top = 16
