    Macros = <>
    Sql.Strings = (
      ';SELECT * FROM'
      '('
      'select'
      '             grupofilialvenda,'
      '             nomegrupofilialvenda,'
      '             filialvenda,'
      '             nomefilialvenda,'
      '             mesvencto, mesvenctorelatorio, ordemsubtotal,'
      '             sum(VenctoMesBase) as VenctoMesBase,'
      '             sum(AVistaMesBase) as aVistaMesBase,'
      '             sum(EntradaMesBase) as EntradaMesBase,'
      '             sum(aPrazoMesBase) as aPrazoMesBase,'
      '             sum(VenctoMesAnterior) as VenctoMesAnterior,'
      '             sum(PagtoMesBase) as PagtoMesBase,'
      '             sum(jurosMesBase) as JurosMesBase'
      'from'
      '('
      
        'select     case when :AgruparGrupoFilial   then   fgf.grupo     ' +
        '  else   null    end as grupofilialvenda,'
      
        '             case when :AgruparGrupoFilial   then   gf.descricao' +
        '  else   null    end as nomegrupofilialvenda,'
      
        '             case when :AgruparFilial           then   ct.filial' +
        'venda  else   null   end as filialvenda,'
      
        '             case when :AgruparFilial           then   f.nome   ' +
        '        else  null   end as nomefilialvenda,'
      ''
      
        '             case When  to_char(p.datavencto, '#39'YYYY/MM'#39')<:MesBas' +
        'eSaldo then'
      '                cast('#39' Antes'#39' as varchar) else'
      
        '             (case when to_char(p.datavencto, '#39'YYYY/MM'#39')>:MesBas' +
        'eDepois then'
      '                cast('#39'Depois'#39' as varchar) else'
      '              to_char(p.datavencto, '#39'YYYY/MM'#39') end)'
      '             end  as mesvencto,'
      ''
      
        '             case When  to_char(p.datavencto, '#39'YYYY/MM'#39')<:MesBas' +
        'eSaldo then'
      '                cast('#39' Antes'#39' as varchar) else'
      
        '             (case when to_char(p.datavencto, '#39'YYYY/MM'#39')>:MesBas' +
        'eDepois then'
      
        '                cast('#39'Depois'#39' as varchar) else to_char(p.dataven' +
        'cto, '#39'MM/YYYY'#39') end)'
      '             end  as mesvenctorelatorio,'
      ''
      
        '              case When  to_char(p.datavencto, '#39'YYYY/MM'#39')>:MesBa' +
        'se then'
      '                 '#39'2'#39' else '#39'1'#39
      '              end  as ordemsubtotal,'
      ''
      
        '             case when to_char(ct.faturamento, '#39'YYYY/MM'#39')=:MesBa' +
        'se then'
      '                 p.valorvencto else 0'
      '             end  as VenctoMesBase,'
      ''
      '             case when (select count(*) from parcelas p where'
      '                        p.contrato = ct.numero and'
      
        '                        p.datavencto > ct.faturamento)=0 and to_' +
        'char(ct.faturamento, '#39'YYYY/MM'#39')=:MesBase then'
      '                           p.valorvencto'
      '                        else 0'
      '             end as aVistaMesBase,'
      ''
      '             case when (select count(*) from parcelas p where'
      '                                 p.contrato = ct.numero and'
      
        '                                p.datavencto > ct.faturamento)=0' +
        ' and to_char(ct.faturamento, '#39'YYYY/MM'#39')=:MesBase then 0 else'
      
        '                        case when (p.datavencto <= ct.faturament' +
        'o) and to_char(ct.faturamento, '#39'YYYY/MM'#39')=:MesBase then'
      '                              p.valorvencto else 0 end'
      '              end as EntradaMesBase,'
      '             case when (select count(*) from parcelas p where'
      '                                 p.contrato = ct.numero and'
      
        '                                p.datavencto > ct.faturamento)=0' +
        ' and to_char(ct.faturamento, '#39'YYYY/MM'#39')=:MesBase then 0 else'
      
        '                        case when (p.datavencto > ct.faturamento' +
        ') and to_char(ct.faturamento, '#39'YYYY/MM'#39')=:MesBase then'
      '                              p.valorvencto else 0 end'
      '              end as aPrazoMesBase,'
      
        '             case when to_char(ct.faturamento, '#39'YYYY/MM'#39')<:MesBa' +
        'se and'
      
        #9'         (p.datapagto is null or to_char(p.datapagto, '#39'YYYY/MM'#39 +
        ')>=:MesBase) then'
      '                 p.valorvencto else 0'
      '             end  as VenctoMesAnterior,'
      ''
      '           /* RECEBIMENTOS DO MES BASE */'
      
        '           case when to_char(p.datapagto, '#39'YYYY/MM'#39')=:MesBase th' +
        'en'
      '               p.valorvencto else 0'
      '           end as PagtoMesBase,'
      ''
      
        '           case when to_char(p.datapagto, '#39'YYYY/MM'#39')=:MesBase th' +
        'en'
      '               p.valorpagto-p.valorvencto else 0'
      '           end as JurosMesBase'
      ''
      'from ((contratos ct  join parcelas p on ct.numero=p.contrato)'
      
        '                     join  (filiais f  join (filiaisgruposfiliai' +
        's fgf join gruposfiliais gf on fgf.grupo=gf.codigo)'
      
        '                                                                ' +
        '                   on f.codigo=fgf.filial)'
      
        '                                           on ct.filialvenda=f.c' +
        'odigo)'
      'where  /* ct.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39') */'
      '  to_char(ct.faturamento, '#39'YYYY/MM'#39')<= :MesBase AND'
      
        '  (ct.faturamento >= coalesce(f.inicioatividades,cast('#39'01/01/190' +
        '0'#39' as date)))'
      '/*   Wherefiliais               */'
      '/*   WhereAgentes         */'
      '/*   WhereTipodeContrato   */'
      ''
      '    and ((p.datapagto is null) or'
      '         ((p.tipopagto is null) or'
      
        '          ((p.tipopagto in ('#39'E'#39','#39'J'#39') and to_char(p.datapagto,'#39'YY' +
        'YY/MM'#39')>:MesBase) or'
      
        '           (p.tipopagto in ('#39'D'#39','#39'C'#39','#39'P'#39','#39'X'#39','#39'R'#39') and  to_char(p.' +
        'deventrada,'#39'YYYY/MM'#39')>:MesBase))))'
      '    and (case when p.tipopagto not in ('#39'P'#39','#39'X'#39') then'
      '         (not exists (select p2.numero'
      #9'              from parcelas p2'
      #9#9'      where p2.contrato = ct.numero and'
      #9#9'            p2.tipopagto in ('#39'P'#39','#39'X'#39') and'
      '                            p2.datavencto = p.datavencto'
      #9#9#9'    ))'
      '         else true end)'
      '    and (case when (ct.situacao = '#39'C'#39') then'
      
        '          (exists (select cd.contrato from contratosdevolvidos c' +
        'd where cd.contrato = ct.numero and cd.tipo='#39'D'#39'))'
      '         else true end)'
      ') as situacao'
      
        'group by nomegrupofilialvenda, grupofilialvenda, nomefilialvenda' +
        ', filialvenda, ordemsubtotal, mesvencto, mesvenctorelatorio'
      ''
      ') AS sr'
      ''
      
        'ORDER BY UPPER(TO_ASCII(sr.NomeGrupoFilialVenda,'#39'LATIN1'#39')), sr.G' +
        'rupoFilialVenda,'
      
        '         UPPER(TO_ASCII(sr.NomeFilialVenda,'#39'LATIN1'#39')), sr.Filial' +
        'Venda,'
      '         sr.OrdemSubtotal, sr.MesVencto, sr.MesVenctoRelatorio')
    RequestLive = False
    Left = 352
    Top = 80
