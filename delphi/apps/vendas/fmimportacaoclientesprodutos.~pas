  OpenDialog1.InitialDir := ExtractFileDir(application.ExeName);
  if OpenDialog1.Execute then
  begin
    lblArquivoClientes.Caption := OpenDialog1.FileName;
      arqINI.WriteString('Importacao', 'Clientes', OpenDialog1.FileName);
      arqINI.UpdateFile;
  end;
end;

procedure TfrmImportacaoClientesProdutos.sbnImportarDadosClick(
  Sender: TObject);
var
  lista: TStringList;
begin
  inherited;
  if (trim(fClientes) <> '') and
     FileExists(fClientes) then
  begin
    lista := TStringList.Create;
    try
      lista.LoadFromFile(fClientes);
      InicializarProgressBar(lista.Count);
      ImportarClientes(lista);
    finally
      lista.Free;
    end;
  end;

  if (trim(fProdutos) <> '') and
     FileExists(fProdutos) then
  begin
    lista := TStringList.Create;
    try
      lista.LoadFromFile(fProdutos);
      InicializarProgressBar(lista.Count);
      ImportarProdutos(lista);
    finally
      lista.Free;
    end;
  end;

  if (trim(fEstoques) <> '') and
     FileExists(fEstoques) then
  begin
    lista := TStringList.Create;
    try
      lista.LoadFromFile(fEstoques);
      InicializarProgressBar(lista.Count);
      ImportarEstoques(lista);
    finally
      lista.Free;
    end;
  end;
{CLX_TO_VCL  proImportacao.Caption := '';}
end;

