function NumerodalinhanoTexto(Arquivo: TStrings; texto: String; ExibirMsg: Boolean = True):integer;
var
 a, idx: integer;
 encontrou: Boolean;
begin
  Result := -1;
  encontrou := false;
//  idx := -1;
  for a := Arquivo.Count - 1 downto 0 do begin
    Idx := Pos(ANSIUpperCase(texto), ANSIUpperCase(Arquivo[a]));
    if Idx > 0 then
    begin
      encontrou := true;
      result := a;
      break
    end
  end;

  if ExibirMsg then
    if not encontrou then
      MensagemErro('Texto: '+ANSIUpperCase(texto)+' não encontrado.');
end;

