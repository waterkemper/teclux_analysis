  else
  if codigo = 1    then result := '1 - Subcontratação'
  else
  if codigo = 2    then result := '2 - Redespacho'
  else
  if codigo = 3    then result := '3 - Redespacho Intermediário'
  else
  if codigo = 4    then result := '4 - Serviço Vinculado a Multimodal';
end;


