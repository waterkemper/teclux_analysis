      FS3Storage := TS3Storage.create(parsistema.Publickey_s3, parsistema.PrivateKey_s3);
      theStream := TMemoryStream.Create;
      theThread := TS3Thread.Create('GETFILE', parsistema.Bucket_s3, url, theStream, FS3Storage, true);
      theThread.OnTerminate := ThreadDone;
      theThread.Resume;
    finally
      theStream := nil;
    end;


    memStream.Position := 0;
    vehPNG := ehPNG;
    memStream.Position := 0;

    try
      if vehPNG  then
      begin
        PNG := TPNGObject.Create;
        PNG.LoadFromStream(memStream);

        if ConverterParaBMP then
        begin
          BMP := TBitmap.Create;
          BMP.Assign(PNG);
          im.Picture.Assign(BMP)
        end
        else
          im.Picture.Assign(PNG);
      end
      else
      begin
        jpegimg   := TJPEGImage.Create;
        jpegimg.LoadFromStream(memStream);
        if ConverterParaBMP then
        begin
          BMP := TBitmap.Create;
          BMP.Assign(jpegimg);
          im.Picture.Assign(BMP);
        end
        else
          im.Picture.Assign(jpegimg);
      end;

    finally
      memStream.Free;
      if converterparaBMP then
        BMP.Free;

      IF vehPNG THEN
        PNG.free
      else
        jpegimg.Free;
    end;
end;
*)


procedure ConvertBMP_JPG(xFile: string; Quality : Integer );

var

  BMP: TBitmap;

  JPG: TJPegImage;

begin

  if ExtractFileExt(xFile) <> '.bmp' then

  begin

    ShowMessage('Formato diferente de bmp'+#13+

   'Formato atual : ' + ExtractFileExt(xFile));

    Exit;

  end;

  BMP := TBitmap.Create;

  try

    BMP.LoadFromFile(xFile);

    JPG := TJPegImage.Create;

    try

     JPG.CompressionQuality := Quality;

     JPG.Assign(BMP);

     JPG.SaveToFile(ChangeFileExt(xFile, '.jpg'));

    finally

     FreeAndNil(JPG);

    end;

   finally

     FreeAndNil(BMP);

   end;

end;

Function FileIsOpen(const FileName : TFileName) : Boolean;
begin
  Result := False;
  try
    With TFileStream.Create( FileName, fmOpenread or fmShareExclusive)
    do Free;
  except
    Result := True;
  end;
end;

function ValorObjetoArquivoIni(Conteudo: TMemoField; Secao, parametro: String; DataType:  TFieldType; manter: boolean): variant;
begin
  result := null;
  if (secao<>'') and (parametro<>'') then
  begin

    if not assigned(vConteudo) then
    begin
      vConteudo := TStringList.create;
      v_NomeArquivoIni := TMemIniFile.Create('');
      vConteudo.assign(Conteudo);
      v_NomeArquivoIni.SetStrings(vConteudo);
    end;

    if v_NomeArquivoIni.SectionExists(secao) then
    begin
      case dataType of
       ftInteger : result := v_NomeArquivoIni.ReadInteger(Secao, parametro, 0);
       ftBoolean : result := v_NomeArquivoIni.ReadBool(Secao, parametro, false);
       ftDateTime : result := v_NomeArquivoIni.ReadDateTime(Secao, parametro, 0);
      end;
    end;

    if not manter then
    begin
      vConteudo.free;
      v_NomeArquivoIni.free;
      vConteudo := nil;
      v_NomeArquivoIni := nil;
    end;

  end;
end;

procedure LimparTabela(ds: TZDataSet; Inversa: boolean);
begin
  if ds.Active then
  begin
    ds.disablecontrols;
    if Inversa then
    begin
      ds.last;
      while not ds.bof do
        ds.delete;
    end
    else
    begin
      ds.First;
      while not ds.eof do
        ds.delete;
    end;
    ds.enablecontrols;
  end;
end;


procedure AtribuirDados(ds: TZDataset;
                            Chaves: array of TField;
                            Valores: array of Variant;

                            CamposCondicao: Array of TField;
                            ValoresCamposCondicao: Array of Variant;
                            CondicaoCamposCondicao: Array of String;

                            DesligarControles: Boolean = true;
                            SomenteRegistroAtual: Boolean = false;

                            OrdenacaoChave : STring = '';
                            OrdenacaoAnterior : STring = '');
var
  a, nsort : Integer;
  RegistroAtual: TBookMark;
  ControlesJaDesabilitados : Boolean;
  vContinuar : Boolean;



  function ExisteDiferencadeChave: boolean;
  var
    a: Integer;
  begin

    result := false;
    for a := 0 to High(Chaves) do
    begin

      if (Chaves[a].dataType in [ftlargeint, ftString]) then
      begin
        if Chaves[a].asstring <> Valores[a] then
        begin
          result := true;
          break;
        end;
      end
      else
      begin

        if (Chaves[a].Value<>null) then
        begin
          if VarToStr(Chaves[a].Value) <> Valores[a] then
          begin
            result := true;
            break;
          end;
        end
        else
        begin
          if Chaves[a].Value <> Valores[a] then
          begin
            result := true;
            break;
          end;
        end;

      end;
    end;

  end;

begin
  if High(Chaves) <> High(Valores) then
    raise Exception.Create('Parâmetros "Chaves" e "Valores" estão com tamanhos diferentes.')
  else
  begin
    RegistroAtual := ds.GetBookmark;

    ControlesJaDesabilitados := ds.ControlsDisabled;

    nsort := TZDataset(ds).SqlBuffer.SortFieldCount;
    TZDataset(ds).SqlBuffer.SortFieldCount := 0;

    if not ControlesJaDesabilitados then
      if DesligarControles then
        ds.DisableControls;

    if not SomenteRegistroAtual then
      ds.First;


    while not ds.Eof or (ds.state = dsinsert) do
    begin
      vContinuar := true;

      if High(CamposCondicao) > -1 then
      begin
        for a:=0 to High(CamposCondicao) do
        begin
          if CondicaoCamposCondicao[a]='=' then
          begin
            if not (VarToStr(CamposCondicao[a].value) = VarToStr(ValoresCamposCondicao[a])) then
            begin
              vcontinuar := false;
              break;
            end;

          end
          else
          if CondicaoCamposCondicao[a]='>=' then
          begin
            if not (VarToStr(CamposCondicao[a].value) >= VarToStr(ValoresCamposCondicao[a])) then
            begin
              vcontinuar := false;
              break;
            end;
          end
          else
          if CondicaoCamposCondicao[a]='<=' then
          begin
            if not (VarToStr(CamposCondicao[a].value) <= VarToStr(ValoresCamposCondicao[a])) then
            begin
              vcontinuar := false;
              break;
            end;
          end
          else
          if CondicaoCamposCondicao[a]='<>' then
          begin
            if not (VarToStr(CamposCondicao[a].value) <> VarToStr(ValoresCamposCondicao[a])) then
            begin
              vcontinuar := false;
              break;
            end;
          end
          else
          if CondicaoCamposCondicao[a]='False' then
          begin
            if CamposCondicao[a].asboolean then
            begin
              vcontinuar := false;
              break;
            end;
          end
          else
          if CondicaoCamposCondicao[a]='True' then
          begin
            if not CamposCondicao[a].asboolean then
            begin
              vcontinuar := false;
              break;
            end;
          end;

        end;
      end;

      if vcontinuar and
         ExisteDiferencadeChave then
      begin

        ds.Edit;
        for a := 0 to High(Chaves) do
        begin
          case Chaves[a].dataType of
            ftlargeint, ftString :
            begin
              if Valores[a] = null then
                Chaves[a].clear
              else
                Chaves[a].AsSTring := Valores[a];
            end;
          else
            Chaves[a].Value := Valores[a];
          end;
        end;

        if (ds.state in [dsinsert, dsedit]) then
          ds. Post;
      end;

      if SomenteRegistroAtual or (ds.state=dsinsert) then
        break
      else
        ds.Next;

    end;

    TZDataset(ds).SqlBuffer.SortFieldCount := nsort;
    TZDataset(ds).SqlBuffer.SortRestore;

    ds.GotoBookmark(RegistroAtual);
    ds.FreeBookmark(RegistroAtual);

    if not ControlesJaDesabilitados then
      if DesligarControles then
        ds.EnableControls;
  end;

end;

procedure AtribuirDados(ds: TClientDataset;
