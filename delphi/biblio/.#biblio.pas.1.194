function MensagemSimNaoOpcaoCancelarmmo(mensagem, NomeOpcaoExtra: String;
         ExibirBotaoCancelar: boolean = true;
         DescricaoOpcaoSim : String = '&Sim';
         DescricaoOpcaoNao : String = '&Não';
         msgtexto: String = '';
         DigitarTexto: boolean = false): TModalResult;
begin
  frmMensagemSimNaoOpcaoCancelammo := TfrmMensagemSimNaoOpcaoCancelammo.Create(frmMensagemSimNaoOpcaoCancelammo);
  frmMensagemSimNaoOpcaoCancelammo.btnCancelar.Visible := ExibirBotaoCancelar;
  frmMensagemSimNaoOpcaoCancelammo.lblMensagem.caption := mensagem;
  DigitarTextommo := DigitarTexto;

  if NomeOpcaoExtra = '' then
    frmMensagemSimNaoOpcaoCancelammo.btnOpcao.Visible := false
  else
    frmMensagemSimNaoOpcaoCancelammo.btnOpcao.caption := NomeOpcaoExtra;

  frmMensagemSimNaoOpcaoCancelammo.btnSim.Caption := DescricaoOpcaoSim;
  frmMensagemSimNaoOpcaoCancelammo.btnNao.Caption := DescricaoOpcaoNao;
  frmMensagemSimNaoOpcaoCancelammo.mmoMensagem.Text := msgtexto;

  if DigitarTexto then
  begin
    frmMensagemSimNaoOpcaoCancelammo.mmoMensagem.readonly := false;
    frmMensagemSimNaoOpcaoCancelammo.mmoMensagem.color := clWindow;
    frmMensagemSimNaoOpcaoCancelammo.gbxMensagemmmo.Caption := 'Observações';
  end
  else
  begin
    frmMensagemSimNaoOpcaoCancelammo.mmoMensagem.readonly := true;
    frmMensagemSimNaoOpcaoCancelammo.mmoMensagem.color := clBtnFace;
    frmMensagemSimNaoOpcaoCancelammo.gbxMensagemmmo.Caption := '';
  end;

  frmMensagemSimNaoOpcaoCancelammo.AjustarTamanhos;
  frmMensagemSimNaoOpcaoCancelammo.ShowModal;
  vTextoJanelaMensagem := frmMensagemSimNaoOpcaoCancelammo.mmoMensagem.text;
  result := frmMensagemSimNaoOpcaoCancelammo.ModalResult;
  frmMensagemSimNaoOpcaoCancelammo.Free;

end;


function ModuloDisponivel(Nome: String): Boolean;
var
  lstPacotes: TStringList;
  Idx: Integer;
begin
  Idx := ListaModulos.IndexOf(strDisponiveis);
  if Idx = -1 then
    Result := False
  else begin
    lstPacotes := TStringList(ListaModulos.Objects[Idx]);
    Result := lstPacotes.IndexOf(LowerCase(Nome)) > -1
  end
end;

function ModuloEmUSo(Nome: String): Boolean;
begin
  Result := ModulosCarregados.IndexOf(LowerCase(Nome)) > -1;
end;

function TeclaEnterOuReturn(tecla: Word):Boolean;
begin
  Result := (tecla = VK_Return);
end;

function Trocar(Texto, OQue, PeloQue: AnsiString): AnsiString;
Var Anterior,
    Posicao:  Integer;
begin

   Posicao := Pos(OQue,Texto);
   While (Posicao <> 0) do
   begin
      Texto := Copy(Texto,1,Posicao-1) +
               PeloQue +
               Copy(Texto,Posicao+Length(OQue),10000);
      Anterior := Posicao;
      Posicao := Pos(OQue,Copy(Texto,Posicao+Length(PeloQue),10000));
      If Posicao <> 0 Then
         Posicao := Posicao+Anterior+Length(PeloQue)-1;
   end;
   Result := Texto;
end;

function Trocar(Texto: TStringList; OQue, PeloQue: AnsiString): TStringList;
var
  i: integer;
begin
  for i:=0 to Texto.Count -1 do
    Texto[i] := Trocar(Texto[i], Oque, PeloQue);
  result := Texto;
end;

function CalcularValorParcela(DataVencto,DataPagto: TDateTime; ValorVencto: real; Taxa:Real; Desconto: Boolean = false):real;
var NrDias: Integer;
begin
  NrDias := DaysBetween(DataVencto,DataPagto);
  if (DataVencto < DataPagto) then
     Result := SimpleRoundTo((ValorVencto + (ValorVencto * (NrDias * (Taxa / 30)) / 100)),-2)
  else begin
    if ((DataVencto > DataPagto) and Desconto) then
      Result := SimpleRoundTo((ValorVencto - (ValorVencto * (NrDias * (Taxa / 30)) / 100)),-2)
    else
      Result := SimpleRoundTo(ValorVencto,-2);
  end;
end;

function CalcularJurosParcela(DataVencto,DataPagto: TDateTime; ValorVencto: real; Taxa:Real):Real;
var NrDias, NrMeses, DiaVencto, DiaPagto,
    MesPagto, AnoPagto: Integer;
    DataFracao: TDateTime;
    JurosMes, JurosFracao: real;
begin
  DiaVencto:= DayOf(DataVencto);
  DiaPagto := DayOf(DataPagto);
  MesPagto := MonthOf(DataPagto);
  AnoPagto := YearOf(DataPagto);
  NrMeses  := MonthsBetween(DataVencto,DataPagto);
  if NrMeses = 0 then
    NrMeses := 1;
  try
    DataFracao := StrToDate(IntToStr(DiaVencto)+'/'+inttostr(MesPagto)+'/'+inttostr(AnoPagto));
  except
    if (MesPagto = 2) and (DiaVencto > 28) then
      DiaVencto := 28
    else
      DiaVencto:= DiaVencto - 1;
    DataFracao := StrToDate(IntToStr(DiaVencto)+'/'+inttostr(MesPagto)+'/'+inttostr(AnoPagto));
  end;
  NrDias     := DaysBetween(DataPagto,DataFracao);
  if DataPagto > DataFracao then
  begin
    NrMeses:= NrMeses + 1;
    JurosMes    := truncar((ValorVencto * (NrMeses * Taxa) / 100),2);
  end
  else
    JurosMes    := truncar((ValorVencto * (NrMeses * Taxa) / 100),2);
    //SimpleRoundTo((ValorVencto * (NrMeses * Taxa) / 100),-2);
  Result:= JurosMes;
end;

function CalcularTotalJuros(DataVencto,DataPagto: TDateTime; TaxaJuros:Real):Real;
var NrDias, NrMeses, DiaVencto, DiaPagto,
    MesPagto, AnoPagto: Integer;
    DataFracao: TDateTime;
begin
  DiaVencto:= DayOf(DataVencto);
  DiaPagto := DayOf(DataPagto);
  MesPagto := MonthOf(DataPagto);
  AnoPagto := YearOf(DataPagto);
  NrMeses  := MonthsBetween(DataVencto,DataPagto);
  if NrMeses = 0 then
    NrMeses := 1;
  DataFracao := StrToDate(IntToStr(DiaVencto)+'/'+inttostr(MesPagto)+'/'+inttostr(AnoPagto));
  NrDias     := DaysBetween(DataPagto,DataFracao);
  if DataPagto > DataFracao then
    NrMeses:= NrMeses + 1;
  Result:= NrMeses*TaxaJuros;
end;

function CalcularMultaParcela(ValorVencto: real; Taxa:Real):Real;
begin
  Result := SimpleRoundTo((ValorVencto * (Taxa  / 100)),-2);
end;

function SomarDia(Data: TDateTime; NrDias: Integer; Tipo: Char): TDateTime;
var
  NovaData: TDateTime;
  Dia,Mes,Ano: Word;
  DiaNoMes: Word;
begin
  if ((NrDias mod 30) = 0) then begin
    if Tipo = 'S' then NovaData:= IncMonth(Data,NrDias div 30) // S = Incrementa trinta e trinta dias - Mes cheio
    else               NovaData:= IncDay(Data,NrDias);         // N = Incrementa dia a dia
  end
  else
    NovaData:= IncDay(Data,NrDias);
  DecodeDate(NovaData,Ano,Mes,Dia);
  DiaNoMes:= DaysInAMonth(Ano,Mes); // Numero de dias do mes especificado.
  if Dia > DiaNoMes then
    Dia:= DiaNoMes;
    SomarDia:= EncodeDate(Ano,Mes,Dia);
//  SomarDia:= EncodeDateTime(Ano,Mes,Dia,0,0,0,0);
end;

function DataEmBranco(Data: String): Boolean;
begin
  Result := (Data = '  ' + {DateSeparator} '/' + '  ' + {DateSeparator} '/' + '    ') or
            (Data = '  ' + {DateSeparator} '/' + '    ') or
            (Data = '');
end;

function DiaMesemBranco(Data: String): Boolean;
begin
  Result := (Data = '  ' + {DateSeparator} '/' + '  ') or
            (Data = '');
end;


function MesAnoEmBranco(Data: String): Boolean;
begin
  Result := (Data = '  ' + {DateSeparator} '/' + '    ') or
            (Data = '  ' + {DateSeparator} '/') or
            (Data = {DateSeparator} '/' + '    ') or
            (Data = '');
end;

function EPrimeiroeUltimodiadoMes(Data1, Data2: String): Boolean;
var
Dia,Mes,Ano: Word;
begin
  DecodeDate(strtodate(Data2), Ano,Mes,Dia);
  Result := ((copy(Data1,1,2)='01') and
             (copy(Data1,4,7)=copy(Data2,4,7))) and
             (Dia=DaysInAMonth(Ano,Mes));
end;

function FormatarDataBanco(Valor: String): String;
begin
  Result :=   Copy(Valor,7,4) + '-'
            + Copy(Valor,4,2) + '-'
            + Copy(Valor,1,2);
end;

function FormatarTimeStamp(DataHora: String): TDateTime;
var
 Ano, Mes, Dia, Hora, Min, Seg : Word;
begin
  Ano := strtoint(copy(DataHora,1,4));
  Mes := strtoint(copy(DataHora,6,2));
  Dia := strtoint(copy(DataHora,9,2));
  Hora := strtoint(copy(DataHora,12,2));
  Min := strtoint(copy(DataHora,15,2));
  Seg := strtoint(copy(DataHora,18,2));

  result := encodedatetime(Ano, Mes, Dia, Hora, Min, Seg, 0);

end;

function FormatarTimeStampz(DataHora: TDateTime): String;
begin
  if parsistema.horario_de_verao then
//    result := trim(formatdatetime('YYYY-MM-DD',DataServidor))+ 'T17:25:16'{+ timetostr(incminute(HoraServidor))}+ '-02:00'
    result := trim(formatdatetime('YYYY-MM-DD',DataHora))+ 'T' + timetostr(incminute(DataHora))+ '-02:00'
  else
    result := trim(formatdatetime('YYYY-MM-DD',DataHora))+ 'T' + timetostr(incminute(DataHora))+ '-03:00';
end;

function FormatarValor(Valor: Extended; Decimal: Integer): String;
var
  I: Integer;
  Dec: String;
begin
  Dec:= '';
  for i := 1 to Decimal do
    Dec := Dec + '0';
  Result:= FormatFloat('#0,' + ThousandSeparator + Dec, Valor);
end;

function FormatarQuantidade(Valor: Extended): String;
var
  milhar, decimal: String;
begin
  milhar  := trocar(copy(ParSistema.MascaraQuantidade,1,
                     pos(',',ParSistema.MascaraQuantidade)),'.','');
  decimal := copy(ParSistema.MascaraQuantidade,
             pos(',',ParSistema.MascaraQuantidade)+1,
             (length(ParSistema.MascaraQuantidade)-
               pos(',',ParSistema.MascaraQuantidade)));
  if (pos('.',ParSistema.MascaraQuantidade)<>0) then
    result := FormatFloat(milhar +
                          ThousandSeparator +
                          decimal, Valor)
  else
  if (milhar<>'') and (decimal<>'') then
    result := trocar(FormatFloat(milhar +
                               ThousandSeparator +
                               decimal, Valor),'.','')
  else
  if ParSistema.MascaraQuantidade<>'' then
    result := FormatFloat(ParSistema.MascaraQuantidade, Valor)
  else
    result := floattostr(valor);
end;

function FormatarQuantidadeFloat(Valor: Extended): Extended;
begin
  if FormatarQuantidade(Valor)<>'' then
    result :=  strtofloat(FormatarQuantidade(Valor))
  else
    result := valor;
end;

function MesExtenso(Mes: Word): String;
begin
  case Mes of
    1: Result:= 'Janeiro';
    2: Result:= 'Fevereiro';
    3: Result:= 'Março';
    4: Result:= 'Abril';
    5: Result:= 'Maio';
    6: Result:= 'Junho';
    7: Result:= 'Julho';
    8: Result:= 'Agosto';
    9: Result:= 'Setembro';
   10: Result:= 'Outubro';
   11: Result:= 'Novembro';
   12: Result:= 'Dezembro';
  end;
end;

function DataExtenso(Data: TDateTime): String;
var
 Dia,Mes,Ano: Word;
begin
 DecodeDate(data, Ano, Mes, Dia);
 result := format('%2.2d', [Dia])+' de '+MesExtenso(Mes)+' de '+inttostr(Ano);
end;


function FormatStringOut(S: String; Align,Ch: Char; N: Integer; milhar:boolean = false): String;
var
  Width, BPos, EPos, i,j,k: Integer;

begin
  Result := S;
  if (Align <> 'C') and (Align <> 'R') and (Align <> 'L') then
    Align := 'L';
  Width := N;
  if Length(Result) < Width then begin
    EPos := Width - Length(Result);
    if Align = 'L' then
      for BPos := 1 to Epos do
        Result := Result + Ch
    else if Align = 'R' then
      for BPos := 1 to Epos do
        Result :=  Ch + Result
    else if Align = 'C' then begin
      for BPos := 1 to (Epos div 2) do
         Result :=  Ch + Result;
      if Odd(EPos) then
        for BPos := 1 to (Epos div 2) + 1 do
          Result := Result + Ch
      else
        for BPos := 1 to (Epos div 2) do
          Result := Result + Ch;
    end
  end else if Length(Result) > Width then
    Result := Copy(Result, 1, Width);

  j:=0;
  k:=0;
  if milhar then
  begin
    for i:=1 to length(result) do
    begin
      if result[i]<>'' then
        inc(j);

      if (j-k) mod 3 = 0 then
      begin
        inc(j);
        inc(k);
        if j < length(result) then
          insert('.',result,j);
      end;
    end;
  end;
end;

function Multiplo(Valor: Currency; Divisor: Real): Currency;
Var
  Resto: Real;
begin
  if Divisor > 0 then begin
    Resto:= Valor - (Divisor * Int(Valor / Divisor));
    if Resto > 0 then Valor:= Valor + Divisor - Resto;
  end;
  Result:= Valor;
end;

function MontarIntervaloData(Campo, DataInicial, DataFinal: String; Cast: Boolean = False): String;
Var
  Data_1, Data_2: String;
begin
  if not Cast then
  begin
    Data_1:= 'and (' + Campo + ' = ';
    Data_2:= 'and (' + Campo + ' between (';
  end
  else
  begin
    Data_1:= 'and (CAST(' + Campo + ' AS DATE) = ';
    Data_2:= 'and (CAST(' + Campo + ' AS DATE) between (';
  end;

  if not DataEmBranco(DataInicial) then begin
    if DataEmBranco(DataFinal) then
        Result:= Data_1 + QuotedStr(DataInicial) + ')'
    else
        Result:= Data_2 + QuotedStr(DataInicial) + ') and (' + QuotedStr(DataFinal) + '))'
  end
  else begin
    if not DataEmBranco(DataFinal) then
        Result:= Data_1 + QuotedStr(DataFinal) + ')'
    else Result:= '';
  end;
end;

function MontarIntervaloDataMI(Campo, DataInicial, DataFinal: String; Cast: Boolean = False): String;
Var
  Data_inicial, Data_final, Datas: String;
begin
  if not Cast then
  begin
    Data_inicial := 'and (' + Campo + ' <= ';
    Data_final := 'and (' + Campo + ' >= ';
    Datas := 'and (' + Campo + ' between (';
  end
  else
  begin
    Data_inicial := 'and (CAST(' + Campo + ' AS DATE) <= ';
    Data_final := 'and (CAST(' + Campo + ' AS DATE) >= ';
    Datas := 'and (CAST(' + Campo + ' AS DATE) between (';
  end;

  if not DataEmBranco(DataInicial) then begin
    if DataEmBranco(DataFinal) then
        Result:= Data_inicial + QuotedStr(DataInicial) + ')'
    else
        Result:= Datas + QuotedStr(DataInicial) + ') and (' + QuotedStr(DataFinal) + '))'
  end
  else
  begin
    if not DataEmBranco(DataFinal) then
        Result:= Data_final + QuotedStr(DataFinal) + ')'
    else
       Result:= '';
  end;
end;



function MontarIntervaloValor(Campo, ValorInicial, ValorFinal: String; Cast: Boolean = False): String;
Var
  ValorInicial_1, ValorFinal_1, Valor_2: String;
begin
  if not Cast then
  begin
    ValorInicial_1:= 'and (' + Campo + ' >= ';
    ValorFinal_1:= 'and (' + Campo + ' <= ';
    Valor_2:= 'and (' + Campo + ' between (';
  end
  else
  begin
    ValorInicial_1:= 'and (CAST(' + Campo + ' AS numeric) >= ';
    ValorFinal_1:= 'and (CAST(' + Campo + ' AS numeric) <= ';
    Valor_2:= 'and (CAST(' + Campo + ' AS numeric) between (';
  end;

  if ValorInicial<>'' then
  begin
    if ValorFinal='' then
      Result:= ValorInicial_1 + trocar(trocar(ValorInicial,'.',''),',','.') + ')'
    else
      Result:= Valor_2 + trocar(trocar(ValorInicial,'.',''),',','.') + ') and (' + trocar(trocar(ValorFinal,'.',''),',','.') + '))'
  end
  else
  begin

    if ValorFinal<>'' then
      Result:= ValorFinal_1 + trocar(trocar(ValorFinal,'.',''),',','.') + ')'
    else
      Result:= '';

  end;
end;

Function MOntarEnumerado(Campo: String; Param: Array of Boolean; Valores: Array of String): String;
var
  i : integer;
begin
  result := '';
  if High(Param) <> High(Valores) then
    raise Exception.Create(ctERRORREFAZCONSULTA)
  else
  begin
    for i := 0 to High(Param) do
    begin
      if Param[i] then
        result := result + QuotedStr(Valores[i]) + ', ';
    end;

    if result <> '' then
    begin
      delete(result, length(result)-1, 1);
      result := ' and '+campo + ' in ('+ result + ')';
    end;
  end;
end;

function MontarListaString(conjuncao: String; Listas: Array of String): String;
var
  i : integer;
begin
  result := '';

  for i := 0 to High(Listas) do
  begin
    if Listas[i]<>'' then
    begin
      if result <> '' then
        result := result + conjuncao + chr(13);

      result := result + ' (' + Listas[i] + ') '
    end;
  end;

end;

Function Extenso(Valor: Real;         {Retorna o Valor por extenso}
                                      {conforme definido em linha }
                 Precisao:       Byte;
                 MoedaSingular:  String;
                 MoedaPlural:    String;
                 FracaoSingular: String;
                 FracaoPlural:   String;
                 Filler:         Char;
             Var Linha:          T_Extenso): Byte;

Var CodErro: Byte;

  Procedure Hifenar(Var Linha,Restante: String;   {Hifena LINHA na POSICAO, re-}
                        Posicao:        Byte);    {tornando o RESTANTE da linha}

  Const Vogais = ['A','E','I','O','U','a','e','i','o','u'];
        LNS    = ['L','N','S','l','n','s'];
        DNRS   = ['D','N','R','S','d','n','r','s'];
        CLN    = ['C','L','N','c','l','n'];

  Var   CHMenosUm, CH: Char;  Consoantes: set of char;
        CHMaisUm:      Char;  NB, MaisUm: Byte;
        NrBrancos:     Byte;  NrSpaces:   Byte;
        PH:            Byte;  Hifenado:   Boolean;
        PosBrancos:    Byte;

      procedure Hifen;
      begin
         if Posicao < PH then
              NrSpaces:= 0
         else NrSpaces:= Posicao-PH;
         if Linha[PH] = ' ' then begin
           if (Posicao >= PH) then
             Inc(NrSpaces)
         end
         else Insert('-',Linha,PH);
         Hifenado:= True;
      end; {Hifen}

  Begin
     If Posicao >= Length(Linha) Then Begin             {Hifenacao desnecessaria}
        Restante:= '';
        Exit;
     End;
     Consoantes:= ['A'..'Z'] + ['a'..'z'] - Vogais;
     PH:= Posicao+1;                                          {Posicao do carac-}
     NrSpaces:= 0;      Hifenado:= False;                     {ter de hifenacao }
     Repeat
        CHMenosUm:= Linha[PH-1];
        CH       := Linha[PH];
        if ((PH+1) > Length(Linha)) then
             CHMaisUm := ' '
        else CHMaisUm := Linha[PH+1];
        If CH = ' ' Then Begin
           Hifen; Delete(Linha,PH,1);
        End
        Else If (CH in Vogais+Consoantes) and
                (CHMenosUm <> ' ') and (PH <> Posicao+1)
             Then If CH in Vogais
                  Then Begin
                     If CHMenosUm = CH Then Hifen;                       {Vogais}
                  End Else
                     If CHMenosUm = CH                               {Consoantes}
                     Then Hifen
                     Else If CHMenosUm in Vogais Then Begin
                             If CHMaisUm in Vogais
                             Then Hifen
                             Else If CHMaisUm <> CH Then Case CHMaisUm of
                                 'r','R': If not (CH in LNS)  Then Hifen;
                                 'l','L': If not (CH in DNRS) Then Hifen;
                                 'h','H': If CH      in CLN   Then Hifen;
                                  End;
                          End
                          Else If not (CH in ['h','H']) Then Case CH of
                              'l','L': If CHMenosUm in DNRS Then Hifen;
                              'r','R': If CHMenosUm in LNS  Then Hifen;
                                  Else Hifen;
                                  End;
        Dec(PH);
     Until Hifenado;

     NrBrancos:= PosOcor(' ',Copy(Linha,1,Posicao),0);    {Alinhamento do extenso}
                                                          {a direita,  com inser-}
     For NB:= NrBrancos downto 1 do Begin                 {cao de  brancos      }
         If NrSpaces mod NrBrancos >= NB
         Then MaisUm:= 1 Else MaisUm:= 0;
         Insert(IncSt(' ',NrSpaces div NrBrancos + MaisUm), Linha, PosOcor(' ',Linha,NB));
     End;
     If NrBrancos = 0 Then Begin            {Nao ha como distribuir  os  brancos}
        Dec(Posicao,NrSpaces);              {para alinhar a direita. Se possivel}
        If Posicao <= NrSpaces Then Begin   {espaceja a palavra sozinha.        }
           NrBrancos:= NrSpaces div Posicao;
           If Linha[Posicao] in [',','.'] Then PH:= Posicao-2
                                          Else PH:= Posicao-1;
           PosBrancos:= 2;
           For NB:= 1 to PH do Begin
             Insert(IncSt(' ',NrBrancos),Linha,PosBrancos);
             Inc(Posicao,NrBrancos);
             Inc(PosBrancos,NrBrancos+1);
           End;
        End;
     End;
     Restante:= Copy(Linha,Posicao+1,255);
     Linha:= Copy(Linha,1,Posicao);
  End; {Hifenar}

  Procedure MontarLinhas;
  Var IL:       Byte;
  Begin
     CodErro:= 0;
     With Linha do Begin
        For IL:= 2 to 4 do ExtLinha[IL]:= '';
        For IL:= 1 to 4 do If Length(ExtLinha[IL]) > ExtTamLinha[IL] Then
          If (IL = 4) or (ExtTamLinha[IL+1] = 0)
          Then CodErro:= 1                                     {Extenso truncado}
          Else Hifenar(ExtLinha[IL],ExtLinha[IL+1],ExtTamLinha[IL]);
        For IL:= 1 to 4 do Begin                          {Preenche  os  espacos}
            Insert(IncSt(Filler,255),ExtLinha[IL],255);   {restantes das  linhas}
            ExtLinha[IL]:=  Copy(ExtLinha[IL],1,ExtTamLinha[IL]);      {do extenso com filler}
        End;
     End;
  End; {MontarLinhas}

  Function SemVirgula(Centena: Integer): Boolean;    {A centena será sem vírgu-}
  Var ComVirgula: Boolean;                           {la  se  for  menor do que}
      CT:         Integer;                           {100 ou se for uma centena}
  Begin                                              {inteira: 100, 200 .. 900 }
     If Centena in [1..99] Then SemVirgula:= True
                           Else Begin
                              ComVirgula:= True;
                              For CT:= 1 to 9 do
                                 If Centena = 100 * CT
                                 Then ComVirgula:= False;
                              SemVirgula:= not ComVirgula;
                           End;
  End; {SemVirgula}

  Procedure GerarExtenso;                 {A geração do extenso é  efetuada con-}
  Var Centena:    Integer;                {siderando-se a  parte inteira e deci-}
      Dezena:     Byte;                   {mal do número separadamente (loop com}
      DG, PT:     Byte;                   {PT).  Para  cada  parte,  gera-se  um}
      Digitos:    Array[1..3] of Byte;    {string  no formato 999999999999, isto}
      Estenso:    String Absolute Linha;  {é,  com bilhões,  milhões, milhares e}
      Milhar:     Array[2..4] of Integer; {centenas,  determina-se qual o milhar}
      MI, ML:     Byte;                   {inicial que  o string  contém  (MI) e}
      NrDec:      Byte;                   {faz-se um loop de MI até 4,  gerando-}
      NrInt:      Byte;                   {se  o extenso  dos dígitos existentes}
      Numero:     String[15];             {dentro de cada centena.              }
      SemFracao:  Boolean;
      StrDecimal: String[15];
      StrInteiro: String[15];

      const Unidades: array[1..19] of string[9] =
                      ('UM',         'DOIS',     'TRÊS',    'QUATRO',   'CINCO',
                       'SEIS',       'SETE',     'OITO',    'NOVE',     'DEZ',
                       'ONZE',       'DOZE',     'TREZE',   'QUATORZE', 'QUINZE',
                       'DEZESSEIS', 'DEZESSETE', 'DEZOITO', 'DEZENOVE');
            Dezenas:  array[2..9] of string[9] =
                      ('VINTE',    'TRINTA',  'QUARENTA', 'CINQUENTA',
                       'SESSENTA', 'SETENTA', 'OITENTA',  'NOVENTA');
            Centenas: array[1..9] of string[12] =
                       ('CENTO',       'DUZENTOS',   'TREZENTOS',
                       'QUATROCENTOS', 'QUINHENTOS', 'SEISCENTOS',
                       'SETECENTOS',   'OITOCENTOS', 'NOVECENTOS');

            Letra:    array[1..2] of Char = ('B','M');
            TresZeros = '000';
            SeisZeros = '000000';
            SoUM      = '001';
  Begin
     NrInt:= Precisao shr 4;                  NrDec:= Precisao and $0F;
     if NrInt > 12 then NrInt:= 12;           {Máximo CENTENA DE BILH+O}

     StrInteiro:= FormatFloat(IncSt('0',NrInt + NrDec),Valor*100);
//                  FStr(Valor,(NrInt + NrDec) shl 4 + 1);
     StrDecimal:= IncSt('0',12-NrDec) + Copy(StrInteiro,NrInt+1,NrDec);
     StrInteiro:= IncSt('0',12-NrInt) + Copy(StrInteiro,1,      NrInt);
     Estenso := '';

     for PT:= 1 to 2 do begin
         if PT = 1 then begin Numero:= StrInteiro;               {Parte Inteira}
                              MI:= 5 - (NrInt + 2) div 3; end
                   else begin Numero:= StrDecimal;               {Parte Decimal}
                              MI:= 5 - (NrDec + 2) div 3; end;

         SemFracao:= ((PT = 2) and (NrDec <= 3)) or      {SemFracao e Milhar são}
           (StrDecimal = IncSt('0',Length(StrDecimal))); {usados para ver se co-}
         For ML:= MI+1 to 4 do Begin                     {loca-se "E" ou "," de-}
             For DG:= 1 to 3 do                          {pois de bilhões, etc. }
                 Digitos[DG]:= Ord(Numero[3*(ML-1)+DG]) and $0F;
             Milhar[ML]:= 100 * Digitos[1] + 10 * Digitos[2] + Digitos[3];
         End;

         For ML:= MI to 4 do Begin
             For DG:= 1 to 3 do                                 {Dígitos da cen-}
                 Digitos[DG]:= Ord(Numero[3*(ML-1)+DG]) and $0F;{tena atual     }

             Centena:= 100 * Digitos[1] + 10 * Digitos[2] + Digitos[3];
             If Centena = 100
             Then Estenso:= Estenso + ' CEM'
             Else Begin
                If Digitos[1] > 0
                Then Estenso:= Estenso + ' ' + Centenas[Digitos[1]];
                Dezena:= 10 * Digitos[2] + Digitos[3];
                Case Dezena of
                01..19: Estenso:= Estenso + ' E ' + Unidades[Dezena];
                20..99: Begin
                           Estenso:= Estenso + ' E ' + Dezenas[Digitos[2]];
                           If Digitos[3] > 0
                           Then Estenso:= Estenso + ' E ' + Unidades[Digitos[3]];
                        End;
                End;
             End;

             Case ML of
             1,2: If Centena > 0 Then Begin
                     Estenso:= Estenso + ' ' + Letra[ML] + 'ILH';
                     If Centena = 1 Then Estenso:= Estenso + 'ÃO'
                                    Else Estenso:= Estenso + 'ÕES';
                  End;
             3:   If Centena > 0 Then Estenso:= Estenso + ' MIL';
             End;

             If Centena > 0 Then Case ML of
             1: If (Copy(Numero,4,9) = SeisZeros + SoUm) or
                   (SemFracao and ((SemVirgula(Milhar[2]) and
                                              (Copy(Numero, 7,6) = SeisZeros)) or
                                   (SemVirgula(Milhar[3]) and
                                              (Copy(Numero, 4,3) = TresZeros) and
                                              (Copy(Numero,10,3) = TresZeros)) or
                                   (SemVirgula(Milhar[4]) and
                                              (Copy(Numero, 4,6) = SeisZeros))))
                 Then Estenso:= Estenso + ' E'
                 Else If Copy(Numero,4,9) = SeisZeros + TresZeros
                      Then Estenso:= Estenso + ' DE'
                      Else Estenso:= Estenso + ',';
             2: If (Copy(Numero,7,6) = TresZeros + SoUm) or
                   (SemFracao and ((SemVirgula(Milhar[3]) and
                                              (Copy(Numero,10,3) = TresZeros)) or
                                   (SemVirgula(Milhar[4]) and
                                              (Copy(Numero, 7,3) = TresZeros))))
                 Then Estenso:= Estenso + ' E'
                 Else If Copy(Numero,7,6) = SeisZeros
                      Then Estenso:= Estenso + ' DE'
                      Else Estenso:= Estenso + ',';
             3: If (Copy(Numero,10,3) = SoUm) or
                   (SemFracao and SemVirgula(Milhar[4]))
                 Then Estenso:= Estenso + ' E'
                 Else If Copy(Numero,10,3) <> TresZeros
                      Then Estenso:= Estenso + ',';
             End;
         End;

         If Numero <> SeisZeros + SeisZeros
         Then If PT = 1 Then Begin
                 If Numero = SeisZeros + TresZeros + SoUm
                 Then Estenso:= Estenso + ' ' + MoedaSingular
                 Else Estenso:= Estenso + ' ' + MoedaPlural;
                 If StrDecimal <> SeisZeros + SeisZeros
                 Then Estenso:= Estenso + ' E';
              End
              Else If Numero = SeisZeros + TresZeros + SoUm
                   Then Estenso:= Estenso + ' ' + FracaoSingular
                   Else Estenso:= Estenso + ' ' + FracaoPlural;
     End;
     If Copy(Estenso,1,3) = ' E ' Then Delete(Estenso,1,3)
                                  Else Delete(Estenso,1,1);
     Estenso:= Trocar(Estenso,' E E ',' E ');
     Estenso:= Trocar(Estenso,', E ', ', ');
  End; {GerarExtenso}

begin {Extenso}
   if MoedaSingular  = '' then MoedaSingular := 'REAL';
   if MoedaPlural    = '' then MoedaPlural   := 'REAIS';
   if FracaoSingular = '' then FracaoSingular:= 'CENTAVO';
   if FracaoPlural   = '' then FracaoPlural  := 'CENTAVOS';
   Valor:= Abs(Valor);    GerarExtenso;
   MontarLinhas;          Extenso:= CodErro;
end; {Extenso}

function RetornarDataPassada(Anos, Meses: string): TDateTime;
var
  Mes,Ano: Integer;

  function CalcularData(meses, anos: integer): TDateTime;
  begin
    Result := IncMonth((IncYear(Today, Anos)), Meses);
  end;

  function calcularMeses(data: TDateTime): integer;
  begin
    Result := MonthsBetween(Today, Data);
  end;

begin
  if (Meses = '') then
       Mes := 0
  else Mes := -StrToInt(Meses);

  if (Anos = '') then
       Ano:= 0
  else Ano := -StrToInt(Anos);

  try
    Result := CalcularData(Mes,Ano)
  except
    Result := Today;
  end;
end;

function ConverterTipoParcela(Tipo: Char): Integer;
begin                                  {Usado no pacote "IMÓVEIS" para retornar}
  Result:= Ord(Tipo) - $40;            {o tipo da parcela 'A', 'B', 'C', etc...}
end;                                   {como '1', '2', '3', etc...             }

function FormatarFone(DDD, Numero: String): String;
var
  Res: String;
  Tam: Integer;
begin
  Res:= '';
  if DDD <> '' then
    Res:= '(' + DDD + ') ';
  if (Numero <> '') then begin
    Tam:= Length(Numero);
    if Tam = 7 then
      Res:= Res + Copy(Numero,1,3) + '-' + Copy(Numero,4,4)
    else if Tam = 8 then
      Res:= Res + Copy(Numero,1,4) + '-' + Copy(Numero,5,4)
    else if Tam = 9 then
      Res:= Res + Copy(Numero,1,5) + '-' + Copy(Numero,6,4)
    else
      Res:= '';
  end;
  Result:= Res;
end;

function ProximoMultiplo(num, multiplo: integer) : integer;
begin
  if num mod multiplo = 0 then
    result := num
  else
  begin
    result := num + multiplo;

    while result <> 0 do
    begin
      if result mod multiplo = 0 then
        break
      else
        result := result - 1;
    end;
  end;

end;

function FormatarCEP(Numero: String): String;
begin
  Insert('-',Numero,6);
  Result:= Numero;
end;

function FormatarCEP2(Numero: String): String;
begin

  Insert('-',Numero,6);
  Insert('.',Numero,3);
  Result:= Numero;
end;


