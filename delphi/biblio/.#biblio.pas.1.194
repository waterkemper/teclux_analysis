                if Valores[a] = null then
                 Chaves[a].clear
                else
                 Chaves[a].AsSTring := Valores[a];
              end;
            else
              Chaves[a].Value := Valores[a];
            end;
          ds.Post;
        end;
        ds.Next;
      end;

      TZDataset(ds).SqlBuffer.SortFieldCount := nsort;
      TZDataset(ds).SqlBuffer.SortRestore;

      ds.GotoBookmark(RegistroAtual);
      ds.FreeBookmark(RegistroAtual);

      if not ControlesJaDesabilitados then
        if DesligarControles then
          ds.EnableControls;
    end;
  end;
end;

procedure AtribuirVariaveisFastReport4(VarName: String; var Value: Variant);
begin
  if VarName = 'RAZAOFILIALBASE' then
    Value := fRazaoFilialBase
  else if VarName = 'ENDERECO_BAIRRO' then
    Value :=  fRuaFilialBase+ ' - '+fBairroFilialBase
  else if VarName = 'CEP_CIDADE_UF' then
    Value :=  FormatarCEP(fCEPFilialBase)+'  '+fCidadeFilialBase+ '  '+ fEstadoFilialBase
  else if VarName = 'CIDADE_UF' then
    Value := fCidadeFilialBase+ '  '+ fEstadoFilialBase
  else if VarName = 'DATA' then
    Value :=  FormatDateTime('DD/MM/YYYY',date())
  else if VarName = 'CordoZebrado' then
    Value :=  strtoint(parsistema.CorZebradoRelatorio)
  else if VarName = 'FoneFilialBase' then
    Value := FormatarFone(fDDDFilialBase,fFoneFilialBase)
  else if VarName = 'CNPJ' then
    Value := FormatarCPFouCGC(FCNPJFilialBase)
  else if VarName = 'InscricaoMunicipal' then
    Value := FInscricaoMunicipalFilialBase;

end;

procedure LimparCampos(ds: TZDataset;
                           Campos: array of TField;
                           DesligarControles: Boolean = true);
var
  a: Integer;
  RegistroAtual: TBookMark;
  ControlesJaDesabilitados : Boolean;
begin
  RegistroAtual := ds.GetBookmark;

  ControlesJaDesabilitados := ds.ControlsDisabled;

  if not ControlesJaDesabilitados then
    if DesligarControles then
      ds.DisableControls;

  ds.First;
  while not ds.Eof do
  begin
    ds.edit;
    for a := 0 to High(Campos) do
      Campos[a].clear;
    ds.post;
    ds.next;
  end;

  ds.GotoBookmark(RegistroAtual);
  ds.FreeBookmark(RegistroAtual);

  if not ControlesJaDesabilitados then
    if DesligarControles then
      ds.EnableControls;
end;

function PosM(Oque, Noque, Ignorar: String): Boolean;
var
 i: integer;
begin

  result := false;

  for i:=1 to length(Oque) do
  begin
    result := (Oque[i] = Ignorar) or (Oque[i] = Noque[i]);

    if not result then
      break;

  end;

end;


function SomarValores(ds: TZDataset; Campos: array of TField;
                          CamposCondicao: Array of TField;
                          ValoresCamposCondicao: Array of String;
                          CondicaoCamposCondicao: Array of String): Real;
var
  a: Integer;
  RegistroAtual: TBookMark;
  ControlesJaDesabilitados : Boolean;
  vContinuar : Boolean;
begin
  result := 0;
  if ds.active then
  begin

    RegistroAtual := ds.GetBookmark;
    ControlesJaDesabilitados := ds.ControlsDisabled;
    if not ControlesJaDesabilitados then
      ds.DisableControls;

    ds.First;
    while not ds.Eof do
    begin
      vContinuar := true;

      if High(CamposCondicao) > -1 then
      begin

        for a:=0 to High(CamposCondicao) do
        begin
          if CondicaoCamposCondicao[a]='=' then
          begin
            if not (VarToStr(CamposCondicao[a].value) = VarToStr(ValoresCamposCondicao[a])) then
            begin
              vcontinuar := false;
              break;
            end;
          end
          else
          if CondicaoCamposCondicao[a]='>=' then
          begin
            if not (VartoStr(CamposCondicao[a].value) >= VarToStr(ValoresCamposCondicao[a])) then
            begin
              vcontinuar := false;
              break;
            end;
          end
          else
          if CondicaoCamposCondicao[a]='<=' then
          begin
            if not (VarToStr(CamposCondicao[a].value) <= VarToStr(ValoresCamposCondicao[a])) then
            begin
              vcontinuar := false;
              break;
            end;
          end
          else
          if CondicaoCamposCondicao[a]='<>' then
          begin
            if not (VarToStr(CamposCondicao[a].value) <> VarToStr(ValoresCamposCondicao[a])) then
            begin
              vcontinuar := false;
              break;
            end;
          end
          else
          if CondicaoCamposCondicao[a]='False' then
          begin
            if CamposCondicao[a].asboolean then
            begin
              vcontinuar := false;
              break;
            end;
          end
          else
          if CondicaoCamposCondicao[a]='True' then
          begin
            if not CamposCondicao[a].asboolean then
            begin
              vcontinuar := false;
              break;
            end;
          end;
        end;
      end;

      if vcontinuar then
      begin

        for a := 0 to High(Campos) do
        begin
          if (Campos[a]<>nil) then
          begin
            if not Campos[a].IsNull then
              result := result + Campos[a].value;
          end
          else
            result := result + 1;
        end;
      end;

      ds.Next;
    end;
    ds.GotoBookmark(RegistroAtual);
    ds.FreeBookmark(RegistroAtual);

    if not ControlesJaDesabilitados then
      ds.EnableControls;

  end;
end;



procedure ShowProcessando(Mensagem: String = '');
begin
  if mensagem = '' then
  begin
    if Assigned(frmProcessando) then
    begin
      frmProcessando.Close;
      frmProcessando.free;
    end;
  end
  else
  begin
    if not Assigned(frmProcessando) then
      frmProcessando := TfrmProcessando.Create(Application);

    frmProcessando.Mensagem := Mensagem;
    frmProcessando.Show;
    Application.ProcessMessages;
  end;
end;

procedure EsperarTempoIndicado(Tempo: String);
var
  vTempos : String;
  vTempo : tTime;
begin
  vTempos:= InputBox('Input Box', 'Prompt', Tempo);
  vtempo := strtotime(vTempos);
  incSecond(vtempo, ffilialbase);
  while vTempo > time() do
end;

procedure ReFazConsultaPorNome(ds: TZDataset; Param: array of String;
  Valores: array of Variant);
var
  a: Integer;
begin
  if High(Param) <> High(Valores) then
    raise Exception.Create(ctERRORREFAZCONSULTA)
  else begin
    ds.Close;
    ds.DisableControls;
    for a := 0 to High(Param) do begin
      ds.ParamByName(Param[a]).Clear;
      ds.ParamByName(Param[a]).Value := Valores[a];
    end;
    ds.enablecontrols;
    ds.Open;
  end
end;

procedure IniciarTempo(var vTempo: DWORD);
begin
  vTempo := Ticks64;
end;

function TempoAtual : DWORD;
begin
  result := Ticks64;
end;

function TempoEsgotado(vTempoInicial: DWORD; TempoLImite: DWORD = 15000): boolean;
begin
  if  (TempoAtual >= vTempoInicial) and ((TempoAtual - vTempoInicial) < TempoLImite) then
    result := false
  else
    result := true;
end;





