constructor TTempo_Thread.Create({aHandle,}aTempo:DWord);
begin
  inherited Create(false);
  FreeOnTerminate := true;
{  Handle_Form     := aHandle;}
  Tempo           := aTempo;
  TempoExpirado := false;
end;


procedure TTempo_Thread.Execute;
  function TempoAtual : DWord;
  begin
    result := GetTickCount;
  end;
begin
    While (TempoAtual >= Tempo_Ini) and ((TempoAtual - Tempo_Ini) < Tempo) do
      Sleep(1);

    TempoExpirado := true;
end;



function ExistsNode(stFilePath, Node: String): Boolean;
var
  vXML: IXMLDocument;
  vNode : IXMLNode;
begin
  vXML := TXmlDocument.Create(stFilePath);  //declarado com a String
//  vxml.LoadFromFile(stFilePath);
//  vXML.Active := true;

  vNode := vXML.DocumentElement.ChildNodes.FindNode(Node);
  result := (vNode <> nil);

end;

function ValidateObj(Obj: TObject): boolean;
type
PPVmt = ^PVmt;
PVmt = ^TVmt;
TVmt = record
SelfPtr : TClass;
Other : array[0..17] of pointer;
end;
var
Vmt: PVmt;
begin
Result := true;
if Assigned(Obj) then
try
Vmt := PVmt(Obj.ClassType);
Dec(Vmt);
if Obj.ClassType <> Vmt.SelfPtr then
Result := false;
except
Result := false;
end;
end;

function UTF8Decode_(const S: UTF8String): WideString;
begin
  result := utf8decode(S);
  if result = '' then
    result := S;
end;



function StreamToString(Stream: TStream): string;
var
  ms: TMemoryStream;
begin
  Result := '';
  ms := TMemoryStream.Create;
  try
    ms.LoadFromStream(Stream);
    SetString(Result, PChar(ms.memory), ms.Size);
  finally
    ms.Free;
  end;
end;


function LoadFileToAnsiStr(const FileName: TFileName): AnsiString;
var
 FileStream : TFileStream;
begin
 FileStream:= TFileStream.Create(FileName, fmOpenRead or fmShareDenyWrite);
 try
   if FileStream.Size>0 then
   begin
    SetLength(Result, FileStream.Size);
    FileStream.Read(Pointer(Result)^, FileStream.Size);
   end;
  finally
   FileStream.Free;
  end;
end;

procedure DeslocarRegistroParaCima(Tabela: TtecQuery; NomeCampoSequencial: String);
var
  RegistroSendoDeslocado: TBookMark;

begin

   if not (Tabela.ReadOnly) then
   begin
     RegistroSendoDeslocado := Tabela.GetBookmark;
     Tabela.Prior;
     if not Tabela.Bof and not (Tabela.RecordCount=1) then
     begin
       Tabela.Edit;
       Tabela.FieldByName(NomeCampoSequencial).AsInteger :=
         Tabela.FieldByName(NomeCampoSequencial).AsInteger + 1;
       Tabela.Post;

       Tabela.GotoBookmark(RegistroSendoDeslocado);
       Tabela.Edit;
       Tabela.FieldByName(NomeCampoSequencial).AsInteger :=
         Tabela.FieldByName(NomeCampoSequencial).AsInteger - 1;
       Tabela.Post;
     end;
     Tabela.FreeBookmark(RegistroSendoDeslocado);
     Tabela.sortbyfield(NomeCampoSequencial);
   end;

end;

procedure DeslocarRegistroParaBaixo(Tabela: TtecQuery; NomeCampoSequencial: String);
var
  RegistroSendoDeslocado: TBookMark;

begin

   if not (Tabela.ReadOnly) then
   begin

     RegistroSendoDeslocado := Tabela.GetBookmark;

     Tabela.next;
     if not Tabela.eof and not (Tabela.RecordCount=1) then
     begin
       Tabela.Edit;
       Tabela.FieldByName(NomeCampoSequencial).AsInteger :=
         Tabela.FieldByName(NomeCampoSequencial).AsInteger - 1;
       Tabela.Post;

       Tabela.GotoBookmark(RegistroSendoDeslocado);
       Tabela.Edit;
       Tabela.FieldByName(NomeCampoSequencial).AsInteger :=
         Tabela.FieldByName(NomeCampoSequencial).AsInteger + 1;
       Tabela.Post;
     end;
     Tabela.FreeBookmark(RegistroSendoDeslocado);
     Tabela.sortbyfield(NomeCampoSequencial);
   end;

end;

function SalvarImagemSistema(Imagem: TClipboard): boolean;
var
  Image1 : TImage;
  arquivo : String;
begin
  try

    Image1 := TImage.create(nil);
    Image1.Picture.Bitmap.Assign(Imagem);

    arquivo := ExtractFilePath(Application.ExeName) + 'Saidas';
    if not DirectoryExists(arquivo) then
      if not CreateDir(arquivo) then
      raise Exception.Create('Impossível criar o diretório ' + arquivo);

    arquivo := ExtractFilePath(Application.ExeName) + 'Saidas\Captura_da_Tela';
    if not DirectoryExists(arquivo) then
      if not CreateDir(arquivo) then
      raise Exception.Create('Impossível criar o diretório ' + arquivo);

    arquivo := ExtractFilePath(Application.ExeName) + 'Saidas\Captura_da_Tela\'+formatDateTime('yyyy-mm-dd', now());
    if not DirectoryExists(arquivo) then
      if not CreateDir(arquivo) then
      raise Exception.Create('Impossível criar o diretório ' + arquivo);

    arquivo := arquivo+'\'+formatDateTime('yyyy-mm-dd_hh-nn-ss', now())+'.bmp';

    Image1.Picture.bitmap.savetofile(arquivo);
    ConvertBMP_JPG(arquivo, 100);
    DeleteFile(arquivo);

  finally
    MensagemAutoClose('Aviso','A imagem da tela foi registrada com sucesso!',3);
  end;

end;


Procedure OrdenarGrid(Sender: TObject; Acol: Integer);
begin
  if Sender is TDBAdvGrid  then
  begin
    if TDBAdvGrid(sender).SortSettings.Column = ACol then
    begin

      if TDBAdvGrid(sender).SortSettings.Direction = sdAscending then
      begin
        TDBAdvGrid(sender).SortSettings.Direction := sdDescending;
        TtecQuery(TDBAdvGrid(sender).DataSource.DataSet).SQLBuffer.SortType := ZSqlItems.stDescending;

        TtecQuery(TDBAdvGrid(sender).DataSource.DataSet).SortInverse;
        TDBAdvGrid(sender).SortSettings.Column := ACol;

      end
      else
      begin

        TDBAdvGrid(sender).SortSettings.Direction := sdAscending;
        TtecQuery(TDBAdvGrid(sender).DataSource.DataSet).SQLBuffer.SortType := ZSqlItems.stNone;
        TtecQuery(TDBAdvGrid(sender).DataSource.DataSet).sortclear;
        TDBAdvGrid(sender).SortSettings.Column := -1;

      end;


    end
    else
    begin

      TDBAdvGrid(sender).SortSettings.Direction := sdAscending;
      TtecQuery(TDBAdvGrid(sender).DataSource.DataSet).SQLBuffer.SortType := ZSqlItems.stAscending;
      TtecQuery(TDBAdvGrid(sender).DataSource.DataSet).SortByField(TDBAdvGrid(sender).FieldAtColumn[ACol].FieldName);
      TDBAdvGrid(sender).SortSettings.Column := ACol;

    end;

  end;
end;


function SortCustomClientDataSet(DataSet: TCustomClientDataSet;
  const FieldName: String): Boolean;
var
  i: Integer;
  IndexDefs: TIndexDefs;
  IndexName: String;
  IndexOptions: TIndexOptions;
  Field: TField;
begin
Result := False;
Field := DataSet.Fields.FindField(FieldName);
//If invalid field name, exit.
if Field = nil then Exit;
//if invalid field type, exit.
if (Field is TObjectField) or (Field is TBlobField) or
  (Field is TAggregateField) or (Field is TVariantField)
   or (Field is TBinaryField) then Exit;
//Get IndexDefs and IndexName using RTTI
if IsPublishedProp(DataSet, 'IndexDefs') then
  IndexDefs := GetObjectProp(DataSet, 'IndexDefs') as TIndexDefs
else
  Exit;
if IsPublishedProp(DataSet, 'IndexName') then
  IndexName := GetStrProp(DataSet, 'IndexName')
else
  Exit;
//Ensure IndexDefs is up-to-date
IndexDefs.Update;
//If an ascending index is already in use,
//switch to a descending index
if IndexName = FieldName + '__IdxA'
then
  begin
    IndexName := FieldName + '__IdxD';
    IndexOptions := [ixDescending];
  end
else
  begin
    IndexName := FieldName + '__IdxA';
    IndexOptions := [];
  end;
//Look for existing index
for i := 0 to Pred(IndexDefs.Count) do
begin
  if IndexDefs[i].Name = IndexName then
    begin
      Result := True;
      Break
    end;  //if
end; // for
//If existing index not found, create one
if not Result then
    begin
      DataSet.AddIndex(IndexName, FieldName, IndexOptions);
      Result := True;
    end; // if not
//Set the index
SetStrProp(DataSet, 'IndexName', IndexName);
end;

function SortClientDataSet(ClientDataSet: TClientDataSet;
         const FieldName: String;
         Descending: Boolean
         ): Boolean;
var
  i: Integer;
  NewIndexName: String;
  IndexOptions: TIndexOptions;
  Field: TField;
begin
  Result := False;
  Field := ClientDataSet.Fields.FindField(FieldName);
  //If invalid field name, exit.
  if Field = nil then
    Exit;

  //if invalid field type, exit.
  if (Field is TObjectField) or
     (Field is TBlobField) or
     (Field is TAggregateField) or
     (Field is TVariantField) or
     (Field is TBinaryField) then
    Exit;

  //Get IndexDefs and IndexName using RTTI
  //Ensure IndexDefs is up-to-date
  ClientDataSet.IndexDefs.Update;
  //If an ascending index is already in use,
  //switch to a descending index

  if descending then
  begin
    NewIndexName := FieldName + '__IdxD';
    IndexOptions := [ixDescending];
  end
  else
  begin
    NewIndexName := FieldName + '__IdxA';
    IndexOptions := [];
  end;
                       {
  if ClientDataSet.IndexName = FieldName + '__IdxA'
  then
  begin
    NewIndexName := FieldName + '__IdxD';
    IndexOptions := [ixDescending];
  end
  else
  begin
    NewIndexName := FieldName + '__IdxA';
    IndexOptions := [];
  end;
  }

  //Look for existing index
  for i := 0 to Pred(ClientDataSet.IndexDefs.Count) do
  begin
    if ClientDataSet.IndexDefs[i].Name = NewIndexName then
    begin
      Result := True;
      Break
    end;  //if
  end; // for

  //If existing index not found, create one
  if not Result then
  begin

    ClientDataSet.AddIndex(NewIndexName,
        FieldName, IndexOptions);
    Result := True;
  end; // if not

  //Set the index
  ClientDataSet.IndexName := NewIndexName;
end;



procedure CarregarModulos(NaoCarregar: array of string);
var
  a, b, IdxPac, IdxMod: Integer;
  ModuloHandle: HMODULE;
  lstPac, lstModulos: TStringList;
  NomeArq, NomeArqs, NomePacs: String;
begin
  Notificar(NotificacaoSplash, Format(ctPREPARARCARREGARPACOTES, [Application.Title]));
  lstModulos := TStringList(ListaModulos.Objects[ListaModulos.IndexOf(strDisponiveis)]);
  ModulosCarregados.Clear;
  for a := 0 to lstModulos.Count - 1 do
    ModulosCarregados.Add(lstModulos[a]);
  for a := 0 to High(NaoCarregar) do begin
    IdxPac := ModulosCarregados.IndexOf(NaoCarregar[a]);
    if IdxPac > -1 then
      ModulosCarregados.Delete(IdxPac);
  end;
  for a := 1 to ListaModulos.Count - 1 do begin
    lstPac := TStringList(ListaModulos.Objects[a]);
    IdxMod := ModulosCarregados.IndexOf(ListaModulos[a]);
    if (IdxMod = -1) and (lstPac.Count > 0) then begin
      IdxPac := ModulosCarregados.IndexOf(lstPac[0]);
      if IdxPac = -1 then
        for b := 1 to lstPac.Count - 1 do begin
          IdxPac := ModulosCarregados.IndexOf(lstPac[b]);
          if (IdxPac > -1) then begin
            ModulosCarregados.Add(ListaModulos[a]);
            break
          end
        end
    end
  end;
  lstModulos := TStringList(ListaModulos.Objects[ListaModulos.IndexOf(strDisponiveis)]);
  for a := 0 to ModulosCarregados.Count - 1 do begin
{$ifdef LINUX}
    NomeArq := ExtractFilePath(Application.ExeName)+'bpl'+ModulosCarregados[a]+'k.so';
{$else}
    NomeArq := ExtractFilePath(Application.ExeName)+ModulosCarregados[a]+'.bpl';
{$endif}
    if FileExists(NomeArq) then begin
      Notificar(NotificacaoSplash, Format(ctCARREGANDOPACOTES, [ModulosCarregados[a], Application.Title]));
//      application.ProcessMessages;
      ModuloHandle := LoadPackage(NomeArq);
      if ModuloHandle > 0 then
        ModulosCarregados.Objects[a] := TObject(ModuloHandle)
    end else begin
      IdxMod := lstModulos.IndexOf(ModulosCarregados[a]);
      if IdxMod > -1 then
        lstModulos.Delete(IdxMod);
      NomePacs := NomePacs + ANSIUpperCase(ModulosCarregados[a]) + ',';
      NomeArqs := NomeArqs + ANSIUpperCase(NomeArq) + ','+#13#10;
    end
  end;
  a := 0;
  while a < ModulosCarregados.Count - 1 do
    if ModulosCarregados.Objects[a] = nil then
      ModulosCarregados.Delete(a)
    else
      Inc(a);
  if NomeArqs <> '' then begin
    Delete(NomeArqs, Length(NomeArqs) , 1);
    MensagemErro(Format(ctERROTECSOFTLOCALPACOTES, [NomePacs, NOmeArqs]))
  end
end;


procedure DeleteLineBreaksArquivo(Arquivo: string);
var
  Source, SourceEnd: PChar;
  t1, t2: TextFile;
  v : String;
begin
  AssignFile(t1,ExtractFilePath(Arquivo)+'temp.txt');
  Rewrite(t1);

  AssignFile(t2, Arquivo);
  Reset(t2);

  while not Eof(t2) do
  begin
    Readln(t2, v);
    Write(t1,  DeleteLineBreaks(v)+chr(10));
  end;
  Close(t1);
  Close(t2);

  if FileExists(Arquivo) then
    DeleteFile(Arquivo);

  CopyFileTo(ExtractFilePath(Arquivo)+'temp.txt',Arquivo);

  if FileExists(ExtractFilePath(Arquivo)+'temp.txt') then
    DeleteFile(ExtractFilePath(Arquivo)+'temp.txt');

End;

function DeleteLineBreaks(s: string): string;
var
   Source, SourceEnd: PChar;
begin
   Source := Pointer(S) ;
   SourceEnd := Source + Length(S) ;
   while Source < SourceEnd do
   begin
     case Source^ of
       #10: Source^ := #32;
       #13: Source^ := #32;
     end;
     Inc(Source) ;
   end;
   Result := S;
End;

function LerConteudoArquivo(Arquivo: String): String;
var   arq: TextFile; { declarando a variável "arq" do tipo arquivo texto }
    linha: string;
begin
  result := '';
  AssignFile(arq, Arquivo);
  Reset(arq);   // [ 3 ] Abre o arquivo texto para leitura

  if (IOResult <> 0) // verifica o resultado da operação de abertura
     then mensagemerro('Erro na abertura do arquivo !!!')
  else
  begin
// [ 11 ] verifica se o ponteiro de arquivo atingiu a marca de final de arquivo
         while (not eof(arq)) do
         begin
           readln(arq, linha); // [ 6 ] Lê uma linha do arquivo
           result := result + linha
         end;

         CloseFile(arq); // [ 8 ] Fecha o arquivo texto aberto
       end;

end;



function EnviarEmail_(HostSMTP, Usuario, senha, PortaSMTP,
             origem, Destino, Assunto, CorpoMensagem, empresa : String;
             smtprequerssl : Boolean;
             ListaAnexos: TStringList;
             Compactar: Boolean = false): Boolean;
var
  idSMTP1: TIdSMTP;
  idmessage1: TIdMessage;
  textomsg: TidText;
  IdSSL: TIdSSLIOHandlerSocketOpenSSL;
  i: integer;
begin
  Result := true;

  try
    idSMTP1 := TIdSMTP.create(nil);
    idmessage1 := TIdMessage.create(nil);

    // configura servidor SMTP
    idSMTP1.Host :=  LowerCase(HostSMTP); //'smtp.gmail.com';
    idSMTP1.Username := Usuario; //'minhaconta@gmail.com';
    idSMTP1.Password := Senha; //'minhasenha';
//      idSMTP1.ConnectTimeout := 20000;
    idSMTP1.ConnectTimeout := 3000;
    idSMTP1.ReadTimeout := 30000;

    // configurações adicionais servidor SMTP com autenticação
    with idSMTP1 do
    begin
      port := StrToInt(PortaSMTP); //465;
      IdSSL := nil;

      if smtprequerssl then
      begin
        try
          IdSSL := TIdSSLIOHandlerSocketOpenSSL.Create( nil );
          IdSMTP1.IOHandler := IdSSL;
          UseTLS := utUseImplicitTLS;
        except
          on E: Exception do
          begin
             IOHandler := TIdIOHandler.MakeDefaultIOHandler( nil );
             UseTLS := utNoTLSSupport;
          end;
        end;
      end
      else
      begin
        IOHandler := TIdIOHandler.MakeDefaultIOHandler( nil );
        UseTLS := utNoTLSSupport;
      end;

      if Assigned(IdSSL) then
      begin
        IdSSL.SSLOptions.Method := sslvSSLv23;
        IdSSL.SSLOptions.Mode := sslmClient;
      end;

    end;

    idSMTP1.AuthType := satDefault;
    idSMTP1.MailAgent:= 'tecLUX';

    // configurando mensagem
    with idmessage1 do
    begin
      idmessage1.Clear;
      idmessage1.CharSet:='iso-8859-1';
      idmessage1.Encoding := MeMIME;
      idmessage1.ContentType:='multipart/related'   ;
      idmessage1.from.address := LowerCase(origem); //'meu_email@gmail.com';  // e-mail do remetente
      Organization := Empresa;
      Date                      := DataHoraLocal;
      Priority                  := mpNormal;

      if ListaAnexos <> nil then
      begin
      {
        if Compactar then
        begin

        end
        else
        begin
        }
          for i:=0 to ListaAnexos.count -1 do
            TIdAttachmentFile.Create(MessageParts, ListaAnexos[i]);
            
//        end;
      end;

    end;


    // e-mail destinatario                                      |
    idmessage1.recipients.emailaddresses := LowerCase(Destino); //'detinatario@dominio.com.br';

    // Assunto (titulo E-mail)
    idmessage1.subject := Assunto;

    // Corpo da Mensagem (use aqui um HTML ou texto que deseja enviar
    // juntamente com a mensagem.
    textomsg := TIdText.Create(idmessage1.MessageParts);
//      textomsg.Body.Text := MontarEmail;
    textomsg.ContentType := 'text/html';
    textomsg.Body.text := CorpoMensagem;

    try
      idSMTP1.Connect;

      idSMTP1.Authenticate;
      idSMTP1.send(idmessage1);
      idSMTP1.Disconnect;
    except
      on E: Exception do
      begin
        result := false;
        MensagemAviso(e.Message, false)
      end;
    end;


  finally

    idmessage1.Free;
    idSSL.Free;
    IdSMTP1.Free;
  end;


end;

