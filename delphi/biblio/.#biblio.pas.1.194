function PeriodoMeses(Inicio, Fim: String): Integer;
// Inicio e Fim: formato AAAA/MM
begin
 Delete(Inicio,5,1);
 Delete(Fim,5,1);
 Result := StrToInt(Fim) - StrToInt(Inicio) + 1;
end;

function PrimeiraMaiuscula(Campo: String): String;
begin
  Result:= Copy(ANSIUpperCase(Campo),1,1) + Copy(Campo,2,Length(Campo));
end;

Function fCheckEmail(Email : String): Boolean;
   var {sintaxe: nome@provedor.com.br ou outros}
   s: String;
   EPos: Integer;
begin
   EPos:= pos('@',Email);
   if Epos > 1 then
      begin
         s:= copy(EMail,Epos+1,Length(Email));
         if (pos('.',s)> 1) and (pos('.',s)< length(s)) then
             Result := true
           else Result := False;
      end
     else
       Result := False;
End;{Verifica se é um endereço de email válido}


function ListaStringEmailValido(Listastr: String; var ListaEmailValidos: String; ExibirMsg: boolean = true): Boolean;
var
 i : integer;
 Lista : TStringList;
begin
  result := true;
  Lista := TStringList.Create;

  ExtractStrings([';'], [], PChar(Listastr), Lista);

  try

    ListaEmailValidos := '';

    for i:=0 to Lista.count-1 do
    begin
      result := EmailValido(trim(lista[i]), ExibirMsg);

      if not result then
      begin
        ListaEmailValidos := '';
        break;
      end
      else
      begin

        if trim(lista[i])<>'' then
        begin
          ListaEmailValidos := ListaEmailValidos + lowercase(trim(lista[i]));
          if i <> Lista.count-1 then
            ListaEmailValidos := ListaEmailValidos + ';'
        end;

      end;
    end;

  finally
    Lista.free;
  end;

end;



