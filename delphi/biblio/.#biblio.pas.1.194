function UltimoDiaMesAnterior(Data: TDateTime): TDateTime;
begin
  try
    Result := IncMonth(Data, -1);
    Result := EncodeDate(YearOf(Result),
                         MonthOf(Result),
                         DaysInAMonth(YearOf(Result), MonthOf(Result))
                         );
  except
    Result := Data;
  end;
end;

function PrimeiroDiaMesAnterior(Data: TDateTime): TDateTime;
begin
  try
    Result := IncMonth(Data, -1);
    Result := EncodeDate(YearOf(Result),
                         MonthOf(Result),
                         1);
  except
    Result := Data;
  end;
end;


function PrimeiroDiaMes(Data: TDateTime): TDateTime;
begin
  try
    Result:= EncodeDate(YearOf(Data), MonthOf(Data), 1);
  except
    Result := Data;
  end;
end;


function UltimoDiaMes(Data: TDateTime): TDateTime;
begin
  try
    Result := EncodeDate(YearOf(Data),
                         MonthOf(Data),
                         DaysInAMonth(YearOf(Data), MonthOf(Data))
                         );
  except
    Result := Data;
  end;
end;

function RoundToD(x: Extended; d: Integer): Extended;
var
  n: Extended;
begin
  n := IntPower(10, d);
  x := x * n;
  Result := (Int(x) + Int(Frac(x) * 2)) / n;
end;

function TruncarInteiro(Valor: Real; NrCasas:byte): integer;
var
  s:String;
  i,t:integer;
begin
  s := Trim(CurrToStr(Valor));
  t := Length(s);
  i := Pos(',',s);
  if (i < t) and (i > 0) then
    Delete(s,i+NrCasas,t-i);
  result := StrToint(Trim(s));
end;

function Truncar(Valor: Real; Nrcasas: byte): currency;
var
  s:String;
  i,t:integer;
begin
  s := Trim(CurrToStr(Valor));
  t := Length(s);
  i := Pos(',',s);
  if (i < t) and (i > 0) then
    Delete(s,i+1+NrCasas,t-i);
  result := StrToCurr(Trim(s));
  (*
  t := Length(s);
  for i := 1 to t do roundto

  pot := power(10,NrCasas);
  a:= trunc(pot * Valor);
  result := trunc(pot * Valor)/pot;
  *)
end;

function TruncarMultiplo(Valor: Real; Multiplo: Integer): currency;
var
  deci,int,
  decimal: Currency;
  ResultDec, vir : Integer;
  Resdec, ResInt,ResFinal : String;
  DecimalMaior: Boolean;
begin
  DecimalMaior:= True;
  deci:= Truncar(Valor,1);
  int:= Truncar(Valor,0);
  Decimal:= deci - int;
  ResDec:= Copy((Currtostr(Decimal)),3,1);
  ResINt:= currtostr(int);
  if ResDec = '' then
    ResDec:= '0';
  ResultDec:= strtoint(ResDec);
  vir:= Pos(',',currtostr(Valor));
  if (ResultDec < Multiplo) then
    DecimalMaior:= False;

  if (ResultDec < (Multiplo/2)) then
  begin
    while not ((ResultDec mod Multiplo) = 0) do
    begin
      Dec(ResultDec);
    end;
  end
  else
  begin
    while not ((ResultDec mod Multiplo) = 0) do
    begin
      inc(ResultDec);
    End;
  end;

  if not DecimalMaior then
  begin
//    int:= int+1;
    ResFinal:= ResInt+','+inttostr(ResultDec);
    Result:= strtocurr(ResFinal);
  end
  else
  begin
    ResFinal:= Copy(currtostr(valor),0,(vir-1));
    Result:= strtocurr(ResFInal)+1;;
  end;
end;

{$IFDEF MSWINDOWS}

function ExecAndWait(const FileName, Params: string;
  const WindowState: Word): boolean;
var
  SUInfo: TStartupInfo;
  ProcInfo: TProcessInformation;
  CmdLine: string;
begin
  { Coloca o nome do arquivo entre aspas. Isto é necessário devido
    aos espaços contidos em nomes longos }
  CmdLine := '"' + Filename + '"' + Params;
  FillChar(SUInfo, SizeOf(SUInfo), #0);
  with SUInfo do  begin
    cb := SizeOf(SUInfo);
    dwFlags := STARTF_USESHOWWINDOW;
    wShowWindow := WindowState;
  end;
  Result := CreateProcess(nil, PChar(CmdLine), nil, nil, false,
    CREATE_NEW_CONSOLE or NORMAL_PRIORITY_CLASS, nil,
    PChar(ExtractFilePath(Filename)), SUInfo, ProcInfo);

  { Aguarda até ser finalizado }
  if Result then begin
    WaitForSingleObject(ProcInfo.hProcess, INFINITE);
    { Libera os Handles }
    CloseHandle(ProcInfo.hProcess);
    CloseHandle(ProcInfo.hThread);
  end;
end;

function CreateProcessSimple(comando: string): boolean;
var
  StartInfo : TStartupInfo;
  ProcInfo : TProcessInformation;
begin
    { fill with known state }
  FillChar(StartInfo,SizeOf(TStartupInfo),#0);
  FillChar(ProcInfo,SizeOf(TProcessInformation),#0);
  StartInfo.cb := SizeOf(TStartupInfo);
  Result := CreateProcess(nil, PChar(comando), nil, nil, False,
              NORMAL_PRIORITY_CLASS, nil, nil, StartInfo, ProcInfo);
    { check to see if successful }
  if Result then
        //may or may not be needed. Usually wait for child processes
 //     if Wait then
    WaitForSingleObject(ProcInfo.hProcess, INFINITE);
  {else
    begin
      MensagemAviso('Unable to run '+ProgramName);
     end;
  }
  CloseHandle(ProcInfo.hProcess);
  CloseHandle(ProcInfo.hThread);
end;
{$ENDIF}

function DiaDaSemana(Data: TDateTime; Abreviado: Boolean = False): String;
begin
  if Abreviado then
    case DayOfWeek(Data) of
      1: Result:= 'Dom';
      2: Result:= 'Seg';
      3: Result:= 'Ter';
      4: Result:= 'Qua';
      5: Result:= 'Qui';
      6: Result:= 'Sex';
      7: Result:= 'Sáb';
    end
  else
    case DayOfWeek(Data) of
      1: Result:= 'Domingo';
      2: Result:= 'Segunda-feira';
      3: Result:= 'Terça-feira';
      4: Result:= 'Quarta-feira';
      5: Result:= 'Quinta-feira';
      6: Result:= 'Sexta-feira';
      7: Result:= 'Sábado';
    end;
end;

function Centralizar(Texto: String; Tamanho: Integer): String;
var
  EPos, BPos: Integer;
begin
  Result := Texto;
  if Length(Result) < Tamanho then
  begin
    EPos := Tamanho - Length(Result);
    for BPos := 1 to (Epos div 2) do
       Result :=  ' ' + Result;
    if Odd(EPos) then
      for BPos := 1 to (Epos div 2) + 1 do
        Result := Result + ' '
    else
      for BPos := 1 to (Epos div 2) do
        Result := Result + ' ';
  end else if Length(Result) > Tamanho then
    Result := Copy(Result, 1, Tamanho)
end;

function NovoCodigoBarras(Produto: String): String;

  Procedure CalcularDigCodBarras(Var CBarras: Comp);
  Var Campo:       String[13];               {Ean-8/Ean-13    }
      I, Fator:    Byte;                     {Padrao Americano}
      Valor, Erro: Integer;
      Somatorio:   LongInt;
  Begin
    Somatorio:= 0;
    Fator    := 3;
    Campo    := FloatToStr(CBarras);
    For I:= 12 downto 1 do
    Begin
      Val(Campo[I],Valor,Erro);
      Valor:= Valor * Fator;
      Somatorio:= Somatorio + Valor;
      If Fator = 3 Then
        Fator:= 1
      Else
        Fator:= 3;
    End;
    Somatorio:= 10 - (Somatorio mod 10);
    If Somatorio = 10 Then
      Somatorio:= 0;
    CBarras:= Int(CBarras / 10) * 10 + Somatorio;
  End;

var
  NovoCodigo: String;
  NovoCBarra: Comp;
  CodErro: Integer;
begin
  result := '';
  NovoCodigo := '2' + preencheString(Produto,'0',12);
  Val(NovoCodigo,NovoCBarra,CodErro);
  CalcularDigCodBarras(NovoCBarra);
  Result := FloatToStr(NovoCBarra);
end;

function ValidarEAN13(Codigo: String): Boolean;
Var //Campo:       String[13];               {Ean-8/Ean-13    }
    I, Fator:    Byte;                     {Padrao Americano}
    Valor,
    Erro,
    Somatorio: Integer;
begin
  if Length(Codigo) <> 13 then
    Result := False
  else
  begin
    Somatorio:= 0;
    Fator    := 3;
//    Campo    := FloatToStr(CBarras);
    for I:= 12 downto 1 do
    begin
      Val(Codigo[I],Valor,Erro);
      Valor:= Valor * Fator;
      Somatorio:= Somatorio + Valor;
      if Fator = 3 then
        Fator:= 1
      else
        Fator:= 3;
    end;
    Somatorio:= 10 - (Somatorio mod 10);
    if Somatorio = 10 then
      Somatorio:= 0;
    //CBarras:= Int(CBarras / 10) * 10 + Somatorio;
    Result := Codigo[13] = IntToStr(Somatorio);
  end;
end;



function ValidarUPC_A(Codigo: String): Boolean;
Var ND:        byte;
    Soma:      integer;
    Digito:    array[0..12] of Byte;
    Numero:    string[12] absolute Digito;
    NrDigitos: byte       absolute Digito;

{------------------ http://eletronicos.hsw.uol.com.br/codigos-de-barras-upc.htm}
begin

   Result:= Length(Codigo) = 12;                     {Padrão UPC tem 12 dígitos}

   if Result then begin
     Numero:= Codigo;
     for ND:= 1 to NrDigitos do                {Conversão de ASCII para números}
         Digito[ND]:= Digito[ND] and $0F;

                                {Soma-se o valor de todos os dígitos em posições
                                 ímpares e  multiplica-se  por 3 (três) e acres-
                                 centa-se todos os dígitos em posições pares}
     Soma:= 3 * (Digito[1] + Digito[3] + Digito[5] +
                 Digito[7] + Digito[9] + Digito[11]) +

                 Digito[2] + Digito[4] + Digito[6] +
                 Digito[8] + Digito[10];

                                     {O dígito verificador é o número que quando
                                      adicionado à soma, seja múltiplo de 10}
     Result:= Digito[12] = (10 - Soma mod 10) mod 10;
  end;
end; {CalcularDigitoUPC_A}



function Modulo11(Numero: string;             {Retorna o dígito  verificador de}
                  Pesos:  string;             {número calculado pelo  módulo 11}
                  ComX:   boolean): char;     {conforme os Pesos atribuídos.   }
                                              {Se  ComX for  "true",  retornará}
                                              {'X' se o resto da divisão for 10}
Var ND, NP:    byte;
    Soma:      integer;
    Digito:    array[0..50] of Byte;
    Number:    string[50] absolute Digito;
    NrDigitos: byte       absolute Digito;

    Peso:      array[0..50] of byte;
    Weight:    String[50] absolute Peso;
    NrPesos:   byte       absolute Peso;

Begin
   Number:= Numero;                            {Conversão de ASCII para números}
   for ND:= 1 to NrDigitos do
       Digito[ND]:= Digito[ND] and $0F;

   Weight:= Pesos;
   for NP:= 1 to NrPesos do
       Peso[NP]:= Peso[NP] and $0F;

   NP  := NrPesos;
   ND  := NrDigitos;
   Soma:= 0;
   while ND > 0 do begin
      Soma:= Soma + Digito[ND] * Peso[NP];
                    Dec(ND);     Dec(NP);
      if NP = 0 then NP:= NrPesos;
   end;

   if ComX and (Soma mod 11 in [0, 1])
   then case Soma mod 11 of
           0: Result:= '0';
           1: Result:= 'X';
        end
   else Modulo11:= chr(((11-Soma mod 11) mod 10) or $30);       {o $30 converte}
End; {Modulo11}                                                 {em ASCII      }



function Modulo10(Numero: string;             {Retorna o dígito  verificador de}
                  Pesos:  string): char;      {número calculado pelo  módulo 10}
                                              {conforme os Pesos atribuídos.   }
Var ND, NP:    byte;
    Soma:      integer;
    Digito:    array[0..50] of Byte;
    Number:    string[50] absolute Digito;
    NrDigitos: byte       absolute Digito;

    Peso:      array[0..50] of byte;
    Weight:    String[50] absolute Peso;
    NrPesos:   byte       absolute Peso;


Begin
   Number:= Numero;                            {Conversão de ASCII para números}
   for ND:= 1 to NrDigitos do
       Digito[ND]:= Digito[ND] and $0F;

   Weight:= Pesos;
   for NP:= 1 to NrPesos do
       Peso[NP]:= Peso[NP] and $0F;

   NP  := NrPesos;
   ND  := NrDigitos;
   Soma:= 0;
   while ND > 0 do begin
      Inc(Soma,(Digito[ND] * Peso[NP]) div 10 +
               (Digito[ND] * Peso[NP]) mod 10);
                Dec(ND);     Dec(NP);
       if NP = 0 then NP:= NrPesos;
   End;
   Modulo10:=  chr((10 - Soma mod 10) mod 10 or $30);           {o $30 converte}
end; {Modulo10}                                                 {em ASCII      }

function Modulo11(valor:String; X: Boolean): String;
var
  Soma: integer;
  Contador, Peso, Digito: integer;
begin
  Soma := 0;
  Peso := 2;
  for Contador := Length(Valor) downto 1 do
  begin
    Soma := Soma + (StrToInt(Valor[Contador]) * Peso);
    if Peso < 9 then
      Peso := Peso + 1
    else
      Peso := 2;
  end;
  Digito := 11 - (Soma mod 11);
  Result := IntToStr(Digito);
  if (Digito > 9) then
    if X then
      Result := 'X'
    else
      Result := '0';
end;

function Concatenarstring(String1, String2, separador: String): String;
begin
if (string1<>'') and (string2<>'') then
  result := string1 + separador + string2
else
if (string1<>'') and (string2='') then
  result := string1
else
if (string1='') and (string2<>'') then
  result := string2
else
if (string1='') and (string2='') then
  result := '';
end;

function FormatarNroNFe(Numero: String): String;
begin
  Numero := preencheString(Numero,'0',9,False);
  Insert('.',Numero,7); Insert('.',Numero,4);
  Result := Numero;
end;

