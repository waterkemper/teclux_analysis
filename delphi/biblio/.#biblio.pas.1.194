function Explode(Separador, Linha: String): TStringList;
var
  p: integer;
begin
  Result := TStringList.Create;
  p := Pos(separador, Linha);
  while (p > 0) do
  begin
    Result.Add(Copy(Linha, 1, p-1));
    Delete(Linha, 1, p + Length(separador) - 1);
    p := Pos(separador, Linha);
  end;
  
  if (Linha <> '') then
    Result.Add(Linha);
end;

procedure RestaurarFoco;
begin
  Application.BringToFront;

  if Assigned( Screen.ActiveForm ) then
  //  QWidget_setActiveWindow(Screen.ActiveForm.Handle); CLX_TO_VCL

end;


function TagControls(Texto: String; Controle: byte = 1): String; {1 - Converter  2 - Reverter}
var
 j: integer;
 vStringRetorno, vStringTag : String;
begin
  vStringRetorno := '';
  vStringTag := '';
  for j:=1 to length(texto) do
  begin
    case controle of
    1: begin
         if (ord(texto[j]) in [0..31]) then
           vStringRetorno := vStringRetorno + '<ctr'+inttostr(ord(texto[j]))+'>'
         else
         if (texto[j]=';') then
           vStringRetorno := vStringRetorno + '<ctr'+inttostr(ord(texto[j]))+'>'
         else
           vStringRetorno := vStringRetorno + texto[j];
       end;
    2: begin
         if (texto[j]='<') or (vStringTag<>'') then
           vStringTag := vStringTag + texto[j]
         else
           vStringRetorno := vStringRetorno + texto[j];

         if texto[j]='>' then
         begin
           vStringRetorno := vStringRetorno+ chr(strtoint(somentenumero(vStringTag)));
           vStringTag := '';
         end;
       end;
    end;
  end;
  result :=  vStringRetorno;
end;


function CriticarCPF(Numero: String; ExibirMsg: Boolean): Boolean;
Var Texto:     Array[1..11] of Byte;
    Digito,ND: Byte;
    CPF:       Int64;
begin
   CPF := StrToInt64(Numero);
   for ND:=11 downto 1 do Begin
      Texto[ND] := CPF mod 10;
      CPF := CPF div 10;
   end;

   Digito := (10 * Texto[01] + 9 * Texto[02] + 8 * Texto[03] +
               7 * Texto[04] + 6 * Texto[05] + 5 * Texto[06] +
               4 * Texto[07] + 3 * Texto[08] + 2 * Texto[09]) mod 11;

   If Digito in [0,1] Then
      Digito := 0
   Else
      Digito := 11 - Digito;

   If Digito = Texto[10] Then Begin
      Digito := (11 * Texto[01] + 10 * Texto[02] + 9 * Texto[03] +
                  8 * Texto[04] +  7 * Texto[05] + 6 * Texto[06] +
                  5 * Texto[07] +  4 * Texto[08] + 3 * Texto[09] +
                  2 * Texto[10]) mod 11;
      If Digito in [0,1] Then
         Digito := 0
      Else
         Digito := 11 - Digito;
      If Digito = Texto[11] Then
         Result := True
      Else Begin
         if ExibirMsg then
           MensagemAviso('CPF Inválido !');
         Result := False;
      End;
   End
   Else Begin
      if ExibirMsg then
        MensagemAviso('CPF Inválido !');
      Result := False;
   End;
End;

function Aleatorio(Data: TDateTime; NumeroNota: String): Integer;
var
  vAnoMes : String;
  vNumeroNota : String;
begin
  vAnoMes := FormatDateTime('YYMM',DAta);
  vNumeroNota := preencheString(NumeroNota,'0',9,false);
  if monthof(Data) mod 2 = 0 then
    vNumeroNota := vAnoMes[1] + vNumeroNota[6] +
                   vAnoMes[2] + vNumeroNota[7] +
                   vAnoMes[3] + vNumeroNota[8] +
                   vAnoMes[4] + vNumeroNota[9]

  else
    vNumeroNota := vNumeroNota[6] + vAnoMes[1] +
                   vNumeroNota[7] + vAnoMes[2] +
                   vNumeroNota[8] + vAnoMes[3] +
                   vNumeroNota[9] + vAnoMes[4];

  result := StrtoInt(vNumeroNota);

end;

function GetCharFromVirtualKey(Key: Word): string;
var
  keyboardState: TKeyboardState;
  asciiResult: Integer;
begin
  GetKeyboardState(keyboardState) ;
  SetLength(Result, 2) ;
  asciiResult := ToAscii(key, MapVirtualKey(key, 0), keyboardState, @Result[1], 0) ;
  case asciiResult of
    0: Result := '';
    1: SetLength(Result, 1) ;
    2: ;
  else
    Result := '';
  end;
end;

function CriticarCNPJ(Numero: String; ExibirMsg: Boolean): Boolean;
Var Texto:     Array[1..14] of Byte;
    Digito,ND: Byte;
    CNPJ:      Int64;
Begin
   CNPJ := StrToInt64(Numero);
   For ND:=14 downto 1 do Begin
      Texto[ND] := CNPJ mod 10;
      CNPJ := CNPJ div 10;
   End;
   Digito := (5 * Texto[01] + 4 * Texto[02] + 3 * Texto[03] +
              2 * Texto[04] + 9 * Texto[05] + 8 * Texto[06] +
              7 * Texto[07] + 6 * Texto[08] + 5 * Texto[09] +
              4 * Texto[10] + 3 * Texto[11] + 2 * Texto[12]) mod 11;
   If Digito in [0,1] Then
      Digito := 0
   Else
      Digito := 11 - Digito;
   If Digito = Texto[13] Then Begin
      Digito := (6 * Texto[01] + 5 * Texto[02] + 4 * Texto[03] +
                 3 * Texto[04] + 2 * Texto[05] + 9 * Texto[06] +
                 8 * Texto[07] + 7 * Texto[08] + 6 * Texto[09] +
                 5 * Texto[10] + 4 * Texto[11] + 3 * Texto[12] +
                 2 * Texto[13]) mod 11;
      If Digito in [0,1] Then
         Digito := 0
      Else
         Digito := 11 - Digito;
      If Digito = Texto[14] Then
         Result := True
      Else Begin
         if ExibirMsg then
           MensagemAviso('CNPJ Inválido !');
         Result := False;
      End;
   End
   Else Begin
      if ExibirMsg then
        MensagemAviso('CNPJ Inválido !');
      Result := False;
   End;
End;

{--------------------- Retorna um string[TAMANHO] com TITULO [C]entrado, à [E]squerda ou
                       à [D]ireita com  os espaços restantes completados com CARACTER}
Function CenDirEsq(Titulo: string; Tamanho: integer; Caracter: char; Como: char): String;
var Size: integer;
begin
   case Como of
      'C'{entrado}: begin                                          {O título é truncado,}
                       Titulo   := Copy(Titulo,1,Tamanho);         {se necessário       }
                       Size     := Length(Titulo);
                       CenDirEsq:= IncSt(Caracter,(Tamanho-Size) div 2) + Titulo +
                                   IncSt(Caracter,Tamanho-((Tamanho-Size) div 2 + Size));
                    end;
      'D'{ireito}:  begin
                       while Length(Titulo) > Tamanho do           {O título é truncado,}
                          Delete(Titulo,1,1);                      {se necessário       }
                       Size     := Length(Titulo);
                       CenDirEsq:= IncSt(Caracter,Tamanho-Size) + Titulo;
                    end;
      'E'{squerdo}: begin                                          {O título é truncado,}
                       Titulo   := Copy(Titulo,1,Tamanho);         {se necessário       }
                       Size     := Length(Titulo);
                       CenDirEsq:= Titulo + IncSt(Caracter,Tamanho-Size);
                    end;
       else         CenDirEsq:= Copy(Titulo,1,Tamanho);
   end;
end; {CenDirEsq}


{---------------------------------------- Implementação de VAL como função Comp}
function FCVal(Campo: string): Comp;
var Erro:  Integer;
    Valor: Comp;
begin
   Val(Campo,Valor,Erro);
   if Erro = 0 then FCVal:= Valor
               else FCVal:= 0;
end; {FCVal}


{------------------------------------- Implementação de VAL como função LongInt}
function FLVal(Campo: string): LongInt;
var Erro:  Integer;
    Valor: LongInt;
begin
   Val(Campo,Valor,Erro);
   if Erro = 0 then FLVal:= Valor
               else FLVal:= 0;
end; {FLVal}


{---------------- Converte Valor num string de acordo com  MODO: $TC, onde T é o
                  tamanho do string e se C for 1,  os brancos  serão convertidos
                  para zeros}
function FStr(Valor: Comp; Modo: Byte): string;

var StrNro:      string[15];
    Maximo:      Comp;
    ND, Tamanho: byte;
begin
   Tamanho:= Modo shr 4;
   if Tamanho > 0 then begin                {Se foi especificado  o tamanho e o}
      Maximo:= 9;                           {VALOR não couber no campo, ele se-}
      for ND:= 2 to Tamanho do              {rá preenchido com asteriscos      }
          Maximo:= 10 * Maximo + 9;
      if Valor > Maximo then begin
         FStr:= IncSt('*',Tamanho);    Exit;
      end;
   end;

   if (Modo and $08 = $08) and (Valor = 0)             {Se  o  valor  for zero,}
   then FStr:= IncSt(' ', Tamanho)                     {deverá retornar brancos}
   else begin
      Str(Valor:Tamanho:0,StrNro);
      if Modo and $01 = $01 then StrNro:= Trocar(StrNro,' ','0');
      FStr:= StrNro;
   end;
end; {FStr}


{-------------------------------- Retorna um string com N caracteres do tipo Ch}
function IncSt(Ch: Char; N:  Integer): string;
var Campo: string;
    NC:    Integer;
begin
   Campo:= '';
   for NC:= 1 to N do
       Campo:= Campo + Ch;
   IncSt:= Campo;
end;


{-------------------------- Retorna a posição em Origem correspondente à N-ésima
                            ocorrência  de SubStr, ou,   se N  for zero, o nº de
                            ocorrências de SubStr em Origem}
Function PosOcor(SubStr: String; Origem: String; N: Integer): Integer;
Var NrOcor: Integer;
    OffSet: Integer;
    PC:     Integer;
Begin
   NrOcor:= 0;
   If Length(SubStr) > 0 then Begin                   {Só pesquisará Origem se}
      OffSet:= 0;                                     {SubStr não for nulo    }
      PC    := Pos(SubStr,Copy(Origem,OffSet+1,Length(Origem)));
      While PC > 0 do Begin
         Inc(NrOcor);
         If NrOcor = N then Begin                      {Se encontrou a N-ésima}
            PosOcor:= OffSet + PC;                     {ocorrência,  retorna a}
            Exit;                                      {sua posição           }
         End;
         Inc(OffSet,PC+Length(SubStr)-1);              {Deslocamento do OffSet}
         PC:= Pos(SubStr,Copy(Origem,OffSet+1,Length(Origem)));   {para pesquisa         }
      End;
   End;
   If N = 0 then PosOcor:= NrOcor             {Se N for zero,  retorna o nº de}
            Else PosOcor:= 0;                 {ocorrências,  senão,  a N-ésima}
End; {PosOcor}                                {ocorrência procurada não existe}

function CtrlIsOn : Boolean;
var
   State : TKeyboardState;
begin
   GetKeyboardState(State) ;
   Result := ((State[vk_Control] And 128) <> 0) ;
end;

function ShiftIsOn : Boolean;
var
   State : TKeyboardState;
begin
   GetKeyboardState(State) ;
   Result := ((State[vk_Shift] and 128) <> 0) ;
end;

function AltIsOn : Boolean;
var
   State : TKeyboardState;
begin
   GetKeyboardState(State) ;
   Result := ((State[vk_Menu] and 128) <> 0) ;
end;


{$IFDEF MSWINDOWS}

procedure SetDefaultPrinter(PrinterName: String);
var
 I: Integer;
 Device : PChar;
 Driver : Pchar;
 Port : Pchar;
 HdeviceMode: Thandle;
 aPrinter : TPrinter;
begin
 Printer.PrinterIndex := -1;
 getmem(Device, 255);
 getmem(Driver, 255);
 getmem(Port, 255);
 aPrinter := TPrinter.create;
 for I := 0 to Printer.printers.Count-1 do
 begin
 if Printer.printers[i] = PrinterName then
 begin
 aprinter.printerindex := i;
 aPrinter.getprinter
 (device, driver, port, HdeviceMode);
 StrCat(Device, ',');
 StrCat(Device, Driver );
 StrCat(Device, Port );
 WriteProfileString('windows', 'device', Device);
 StrCopy( Device, 'windows' );
 SendMessage(HWND_BROADCAST, WM_WININICHANGE,
 0, Longint(@Device));
 end;
 end;
 Freemem(Device, 255);
 Freemem(Driver, 255);
 Freemem(Port, 255);
 aPrinter.Free;
end;

procedure SetDefaultPrinter2(NewDefPrinter: string);
var
  ResStr: array[0..255] of Char;
begin
  StrPCopy(ResStr, NewdefPrinter);
  WriteProfileString('windows', 'device', ResStr);
  StrCopy(ResStr, 'windows');
  SendMessage(HWND_BROADCAST, WM_WININICHANGE, 0, Longint(@ResStr));
end;

