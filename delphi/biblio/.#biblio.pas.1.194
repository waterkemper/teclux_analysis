function limpaFloat(valor:String):String;
begin
  Result := valor;
  Result := Trocar(Result, '.', '');
  Result := Trocar(Result, 'R', '');
  Result := Trocar(Result, '$', '');
end;

function IfThen_(AValue: Boolean; const ATrue: Boolean; const AFalse: Boolean): Boolean;
begin
  if AValue then
    Result := ATrue
  else
    Result := AFalse;
end;

function IfThen_(AValue: Boolean; const ATrue: String; const AFalse: String): String;
begin
  if AValue then
    Result := ATrue
  else
    Result := AFalse;
end;


function preencheString(Text, Caracter:String;Tamanho:Integer; LadoDireiro:Boolean = True):String;
var
  s : String;
  i : Integer;
begin
  s := '';
//  i := 0;
  if Length(Text) > Tamanho then
    Text := copy(Text, 0 , Tamanho);

  Tamanho := Tamanho - Length(Text);
  for i := 0 to Tamanho-1 do
    s := s+Caracter;
  if LadoDireiro then
    Text := Text+s
  else
    Text := s+Text;
  Result := Text;
end;

function cortaPreencheString(Text, Caracter: String; Tamanho: Integer; LadoDireito: Boolean = True): String;
begin
  if length(text) > tamanho then
    Result := Copy(Text,Length(text)-tamanho+1,Length(text))
  else
    Result := preencheString(Text,Caracter,Tamanho,LadoDireito);
end;

{$IFDEF MSWINDOWS}
function BlockInput(Bloquear: Boolean): Boolean;
var
  xBlockInput : function(Block : BOOL) : BOOL; stdcall;
  LibHandle : tHandle;
begin
  if LoadLibrary('USER32.DLL') = 0 then
    Exit;
  LibHandle := GetModuleHandle('USER32.DLL'); { Pega o handle da DLL }
  if LibHandle = 0 then { Se 0 não pegou o Handle, falhou }
    Exit;
  xBlockInput := GetProcAddress(LibHandle, 'BlockInput'); {Procura a função}
  if @xBlockInput = nil then
    Exit;
  xBlockInput(Bloquear); // Disable Keyboard & mouse
end;

function ProcessoExiste(ExeFileName: String): Boolean;
const
  PROCESS_TERMINATE=$0001;
var
  ContinueLoop: BOOL;
  FSnapshotHandle: THandle;
  FProcessEntry32: TProcessEntry32{declarar Uses Tlhelp32};
begin
  result := false;

  FSnapshotHandle := CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
  FProcessEntry32.dwSize := Sizeof(FProcessEntry32);
  ContinueLoop := Process32First(FSnapshotHandle,FProcessEntry32);

  while integer(ContinueLoop) <> 0 do
  begin
    if ((UpperCase(ExtractFileName(FProcessEntry32.szExeFile)) = UpperCase(ExeFileName)) or
       (UpperCase(FProcessEntry32.szExeFile) = UpperCase(ExeFileName))) then
    begin
      Result := true;
      exit;
    end;
    ContinueLoop := Process32Next(FSnapshotHandle,FProcessEntry32);
  end;
  CloseHandle(FSnapshotHandle);
end;

function KillTask(ExeFileName: string): Integer;
const
  PROCESS_TERMINATE = $0001;
var
  ContinueLoop: BOOL;
  FSnapshotHandle: THandle;
  FProcessEntry32: TProcessEntry32;
begin

  Result := 0;
  FSnapshotHandle := CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
  FProcessEntry32.dwSize := SizeOf(FProcessEntry32);
  ContinueLoop := Process32First(FSnapshotHandle, FProcessEntry32);
  while Integer(ContinueLoop) <> 0 do
  begin
    if ((UpperCase(ExtractFileName(FProcessEntry32.szExeFile)) =
      UpperCase(ExeFileName)) or (UpperCase(FProcessEntry32.szExeFile) =
      UpperCase(ExeFileName))) then
      Result := Integer(TerminateProcess(
                        OpenProcess(PROCESS_TERMINATE,
                                    BOOL(0),
                                    FProcessEntry32.th32ProcessID),
                                    0));
     ContinueLoop := Process32Next(FSnapshotHandle, FProcessEntry32);
  end;
  CloseHandle(FSnapshotHandle);
  
end;



