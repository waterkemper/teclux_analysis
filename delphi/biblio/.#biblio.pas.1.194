procedure MensagemAutoClose(const ACaption, APrompt: string; DuracaoEmSegundos: Integer);
var
  Form: TForm;
  Prompt: TLabel;
  DialogUnits: TPoint;
  ButtonTop, ButtonWidth, ButtonHeight: Integer;
  ButtonClose : TButton;
  nX, Lines: Integer;
  vTempoInicial : DWORD;
  Fechar : Boolean;
  Util : TUtil;

  function GetAveCharSize(Canvas: TCanvas): TPoint;
    var
      I: Integer;
      Buffer: array[0..51] of Char;
    begin
      for I := 0 to 25 do Buffer[I]          := Chr(I + Ord('A'));
      for I := 0 to 25 do Buffer[I + 26]    := Chr(I + Ord('a'));
      GetTextExtentPoint(Canvas.Handle, Buffer, 52, TSize(Result));
      Result.X := Result.X div 52;
    end;


begin
  Form       := TForm.Create(Application);
  util := TUtil.create();

  Lines   := 0;

  For nX := 1 to Length(APrompt) do
     if APrompt[nX]=#13 then Inc(Lines);

  with Form do
    try
      Font.Name:='Arial';     //mcg
      Font.Size:=10;          //mcg
      Font.Style:=[fsBold];
      Canvas.Font    := Font;
      DialogUnits    := GetAveCharSize(Canvas);
      //BorderStyle    := bsDialog;
      BorderStyle    := bsToolWindow;
      FormStyle         := fsStayOnTop;
      BorderIcons      := [biSystemMenu];
      Caption          := ACaption;
      ClientWidth    := MulDiv(Screen.Width div 4, DialogUnits.X, 4);
      ClientHeight    := MulDiv(23 + (Lines*10), DialogUnits.Y, 8) + 20;
      Position          := poScreenCenter;

      AutoSize       := True;

      Prompt             := TLabel.Create(Form);
      with Prompt do
      begin
        Parent          := Form;
        AutoSize       := True;
        Left             := MulDiv(8, DialogUnits.X, 4);
        Top             := MulDiv(8, DialogUnits.Y, 8);
        Caption       := APrompt;
      end;

      ButtonClose := TButton.create(Form);
      with ButtonClose do
      begin
        Parent := Form;
        Caption := 'Fechar';
        modalresult :=  mrOK;
        OnClick := Util.OnClick;
        left := prompt.width div 2;
        top := prompt.top + 30;
      end;

      Form.Width := Prompt.Width+Prompt.Left+50;  //mcg fix

//      TCloseQueryEvent

      OnCloseQuery := Util.fCloseQuery;

      Show;
      Application.ProcessMessages;
    finally

      Util.vCanClose := False;
      IniciarTempo(vTempoInicial);
      repeat
        Application.processmessages;
        Caption          := ACaption + format(' | Fechando em: %s segundos', [inttostr( ( ((DuracaoEmSegundos * 1000) - (TempoAtual - vTempoInicial)) div 1000) )]);
//        ButtonClose.caption := 'Fechar '+inttostr(TempoAtual);
//       Sleep(DuracaoEmSegundos*1000);
      until
        TempoEsgotado(vTempoInicial, (DuracaoEmSegundos * 1000) ) or Util.vCanClose;

      Form.Free;
    end;
end;

