function LowLevelKeyboardProc(nCode: integer; wParam: WPARAM; lParam: LPARAM):
  LRESULT; stdcall;
type
  PKBDLLHOOKSTRUCT = ^TKBDLLHOOKSTRUCT;
  TKBDLLHOOKSTRUCT = record
    vkCode: cardinal;
    scanCode: cardinal;
    flags: cardinal;
    time: cardinal;
    dwExtraInfo: Cardinal;
  end;

  PKeyboardLowLevelHookStruct = ^TKeyboardLowLevelHookStruct;
  TKeyboardLowLevelHookStruct = TKBDLLHOOKSTRUCT;
const
  LLKHF_ALTDOWN = $20;
var
  hs: PKeyboardLowLevelHookStruct;
  ctrlDown: boolean;
begin

  if nCode = HC_ACTION then
  begin

    hs := PKeyboardLowLevelHookStruct(lParam);
    ctrlDown := GetAsyncKeyState(VK_CONTROL) and $8000 <> 0;
    {
    if (hs^.vkCode = VK_ESCAPE) and ctrlDown then
      Exit;
      }

    if (hs^.vkCode = VK_TAB) and ((hs^.flags and LLKHF_ALTDOWN) <> 0) then
      result := 1
    else
      result := CallNextHookEx(0, nCode, wParam, lParam);

      {
    if (hs^.vkCode = VK_ESCAPE) and ((hs^.flags and LLKHF_ALTDOWN) <> 0) then
      Exit;
    if (hs^.vkCode = VK_LWIN) or (hs^.vkCode = VK_RWIN) then
      Exit;
      }

  end;

//    result := CallNextHookEx(0, nCode, wParam, lParam);

end;

function ListadeTitulosdaTabela(Tabela:TDataSet): TStringList;
var i: integer;
  vLista : TStringList;
begin
  vLista := tStringList.create;
  i:=0;
  for i:=0 to tabela.fieldcount -1 do
  begin
    if tabela.fields[i].Visible then
        vLista.append(tabela.fields[i].displaylabel);
  end;
  result := vLista;
end;

function ListaCamposdaTabela(Tabela:TDataSet): TStringList;
var i: integer;
  vLista : TStringList;
begin
  vLista := tStringList.create;
  i:=0;
  for i:=0 to tabela.fieldcount -1 do
  begin
    if tabela.fields[i].Visible then
        vLista.append(tabela.fields[i].fieldname);
  end;
  result := vLista;
end;

procedure SetReadOnlyFields(Table:TDataSet; ReadOnlyValue:Boolean);
var
i: integer;
begin
  for i:=0 to Table.fieldcount -1 do
  begin
    if Table.fields[i].readOnly <> ReadOnlyValue then
      Table.fields[i].readOnly := ReadOnlyValue;
  end
end;

procedure ExportarTabelaLinear(Tabela:TDataSet);
var
  RegistroAtual: TBookMark;
  vExcelExport : TExcelExport;
  vcontrolsDisabled: Boolean;

begin
  if (MensagemConfirmacao('Os dados serão exportados para o Excel. Confirma?') = smbOk) then
  begin
    try
      RegistroAtual := Tabela.GetBookmark;
      vExcelExport := TExcelExport.create(nil);
      vExcelExport.StyleColumnWidth := cwAutoFit;
      vcontrolsDisabled := Tabela.ControlsDisabled;
      if not vcontrolsDisabled then
        tabela.DisableControls;

      vExcelExport.Dataset := Tabela;
      vExcelExport.ExportDataset(ListaCamposdaTabela(Tabela), ListadeTitulosdaTabela(tabela));

      if not vcontrolsDisabled then
        tabela.enableControls;

    finally
      vExcelExport.free;
      tabela.GotoBookmark(RegistroAtual);
      tabela.FreeBookmark(RegistroAtual);
    end;
  end;
end;

function RetornarLista(Tabela:TtecQuery; NomedoCampo: TField; CampoMarcado: TField; IgnorarDuplicadas: boolean): String;
var
  vControlsDisabled: Boolean;
  vRegistroAtual: TBookmark;
  vLista: String;
begin
  vLista := ', ';
  if Tabela.active then
  begin

    vControlsDisabled := Tabela.ControlsDisabled;
    vRegistroAtual := Tabela.GetBookmark;
    if not vControlsDisabled then
      Tabela.DisableControls;
    Tabela.First;
    while not tabela.Eof do
    begin
      if ((CampoMarcado = nil) or
          ((CampoMarcado <> nil) and Tabela.fieldbyname(CampoMarcado.FieldName).asboolean)) and
         (Tabela.fieldbyname(NomedoCampo.FieldName).asstring<>'') then
      begin
        if IgnorarDuplicadas then
        begin
          if Tabela.fieldbyname(NomedoCampo.FieldName).datatype = ftString then
          begin
            if pos(', '+quotedstr(Tabela.fieldbyname(NomedoCampo.FieldName).asstring) + ', ', vLista)=0 then
              vLista := vLista + quotedstr(Tabela.fieldbyname(NomedoCampo.FieldName).asstring) + ', '
          end
          else
            if pos(', '+Tabela.fieldbyname(NomedoCampo.FieldName).asstring + ', ', vLista)=0 then
              vLista := vLista + Tabela.fieldbyname(NomedoCampo.FieldName).asstring + ', '
        end
        else
        begin
          if Tabela.fieldbyname(NomedoCampo.FieldName).datatype = ftString then
            vLista := vLista + quotedstr(Tabela.fieldbyname(NomedoCampo.FieldName).asstring) + ', '
          else
            vLista := vLista + Tabela.fieldbyname(NomedoCampo.FieldName).asstring + ', ';
        end;
      end;
      Tabela.Next;
    end;

    Tabela.GotoBookmark(vRegistroAtual);
    tabela.FreeBookmark(vRegistroAtual);

    if not vControlsDisabled then
      Tabela.EnableControls;

    if vLista <> ', ' then
    begin
      delete(vLista,1,2);
      delete(vLista,length(vLista)-1, 2);
    end
    else
      vLista := '';

  end;
  result := vLista;
end;

function RetornarListaTString(Tabela:TtecQuery; NomedoCampo: TField; CampoMarcado: TField; IgnorarDuplicadas: boolean): TStringList;
var
  vControlsDisabled: Boolean;
  vRegistroAtual: TBookmark;
  vLista: String;
  vListaS: tStringList;
begin
  vLista := ', ';
