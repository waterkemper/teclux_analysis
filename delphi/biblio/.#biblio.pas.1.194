          BMP.Assign(jpegimg);
          im.Picture.Assign(BMP);
        end
        else
          im.Picture.Assign(jpegimg);
      end;

    finally
      memStream.Free;
      if converterparaBMP then
        BMP.Free;

      IF vehPNG THEN
        PNG.free
      else
        jpegimg.Free;
    end;
end;



