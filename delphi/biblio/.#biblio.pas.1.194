function ParcelasIdenticas(parcelas1, Parcelas2: TResumosParcelas): Boolean;
var
  a: Integer;
begin
  if High(Parcelas1) <> High(parcelas2) then
    Result := False
  else begin
    Result := True;
    for a := 0 to High(Parcelas1) do
      if (Parcelas1[a].Parcelas <> Parcelas2[a].Parcelas) or
         (Parcelas1[a].Vencimento <> Parcelas2[a].Vencimento) or
         (Parcelas1[a].Valor <> Parcelas2[a].Valor) or
         (Parcelas1[a].FormaPagamento <> Parcelas2[a].FormaPagamento) or
         (Parcelas1[a].TipoRecebimento <> Parcelas2[a].TipoRecebimento)
      then begin
        Result := False;
        break
      end
  end
end;

