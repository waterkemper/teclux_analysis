function EmailValido(Campo:String; ExibirMsg: boolean = true): Boolean;
var
  I: Integer;
  vCampo : String;
begin
  Result:= False;
  if Campo <> '' then
  begin
    vCampo := trim(campo);
    I:= Pos('@',vCampo);

    if I > 1 then
    begin
      vCampo := copy(vCampo,I+1,Length(vCampo));
      if (pos('.',vCampo)> 1) and (pos('.',vCAmpo)< length(vCampo)) then
         Result := true
      else Result := False;
    end;

    if result then
      result := IsValidEmail(campo);

    if result then
      result := ValidaEMail(pchar(campo));

    if not Result and ExibirMsg then
      MensagemAviso(format(ctsEMAILINVALIDO, [Campo]));
  end
  else
    Result:= True;

end;


function IsValidEmail(const Value: string): Boolean;
  function CheckAllowed(const s: string): Boolean;
  var
    i: Integer;
  begin
    Result := False;
    for i := 1 to Length(s) do
      if not(s[i] in ['a' .. 'z', 'A' .. 'Z', '0' .. '9', '_', '-', '.']) then
        Exit;
    Result := true;
  end;
var
  i: Integer;
  NamePart, ServerPart: string;
begin
  Result := False;

  i := Pos('@', Value);
  if i = 0 then
    Exit;

  NamePart := Copy(Value, 1, i - 1);
  ServerPart := Copy(Value, i + 1, Length(Value));

  if (Length(NamePart) = 0) or ((Length(ServerPart) < 5)) then
    Exit;

  i := Pos('.', ServerPart);

  if (i = 0) or (i > (Length(ServerPart) - 2)) then
    Exit;


  Result := CheckAllowed(NamePart) and CheckAllowed(ServerPart);


end;


Function ValidaEMail(const EMailIn: PChar):Boolean;
const
  CaraEsp: array[1..40] of string[1] =
  ( '!','#','$','%','¨','&','*',
  '(',')','+','=','§','¬','¢','¹','²',
  '³','£','´','`','ç','Ç',',',';',':',
  '<','>','~','^','?','/','','|','[',']','{','}',
  'º','ª','°');
var
  i,cont   : integer;
  EMail    : ShortString;
begin
  EMail := EMailIn;
  Result := True;
  cont := 0;
  if EMail <> '' then
    if (Pos('@', EMail)<>0) and (Pos('.', EMail)<>0) then    // existe @ .
    begin
      if (Pos('@', EMail)=1) or (Pos('@', EMail)= Length(EMail)) or (Pos('.', EMail)=1) or (Pos('.', EMail)= Length(EMail)) or (Pos(' ', EMail)<>0) then
        Result := False
      else                                   // @ seguido de . e vice-versa
        if (abs(Pos('@', EMail) - Pos('.', EMail)) = 1) then
          Result := False
        else
          begin
            for i := 1 to 40 do            // se existe Caracter Especial
              if Pos(CaraEsp[i], EMail)<>0 then
                Result := False;
            for i := 1 to length(EMail) do
            begin                                 // se existe apenas 1 @
              if EMail[i] = '@' then
                cont := cont + 1;                    // . seguidos de .
              if (EMail[i] = '.') and (EMail[i+1] = '.') then
                Result := false;
            end;
                                   // . no f, 2ou+ @, . no i, - no i, _ no i
            if (cont >=2) or ( EMail[length(EMail)]= '.' )
              or ( EMail[1]= '.' ) or ( EMail[1]= '_' )
              or ( EMail[1]= '-' )  then
                Result := false;
                                            // @ seguido de COM e vice-versa
            if (abs(Pos('@', EMail) - Pos('.com', EMail)) = 1) then
              Result := False;
                                              // @ seguido de - e vice-versa
            if (abs(Pos('@', EMail) - Pos('-', EMail)) = 1) then
              Result := False;
{
                                              // @ seguido de _ e vice-versa
            if (abs(Pos('@', EMail) - Pos('_', EMail)) = 1) then
              Result := False;
}
          end;
    end
    else
      Result := False;
end;


function DataHoraLocal: TDateTime;
begin
  Result := Now;
end;

function MesAno(Data:String): String;
var
  Mes, Ano: String;
begin
  Ano := IntToStr(YearOf(StrToDate(Data)));
  Mes := IntToStr(MonthOf(StrToDate(Data)));
  if Length(Mes) = 1 then
    Mes := '0' + Mes;
  Result :=  Ano + Mes;
end;

function OperadorTernario(Valor, ResultadoVerdadeiro, ResultadoFalso: Boolean): Boolean;
begin
  if Valor then Result:= ResultadoVerdadeiro else Result:= ResultadoFalso;
end;

procedure MarcarLista(Lista: TCheckListBox; Marcar: Boolean);
var
  cnt: Integer;
begin
  for cnt:= 0 to Lista.Items.Count - 1 do
    Lista.Checked[cnt]:= Marcar;
end;

function RetiraAcento(Campo: String): String;
var
  NC: Integer;
begin
  for NC:= 1 to Length(Campo) do begin
    case Campo[NC] of
      'Á','À','Ã','Â' : Campo[NC]:= 'A';
      'á','à','ã','â' : Campo[NC]:= 'a';
      'É','È','Ê'     : Campo[NC]:= 'E';
      'é','è','ê'     : Campo[NC]:= 'e';
      'Í','Ì','Î'     : Campo[NC]:= 'I';
      'í','ì','î'     : Campo[NC]:= 'i';
      'Ó','Ò','Õ','Ô' : Campo[NC]:= 'O';
      'ó','ò','õ','ô' : Campo[NC]:= 'o';
      'Ú','Ù'         : Campo[NC]:= 'U';
      'ú','ù'         : Campo[NC]:= 'u';
      'Ç'             : Campo[NC]:= 'C';
      'ç'             : Campo[NC]:= 'c';
    end;
  end;
  RetiraAcento:= Campo;
end;

function RetiraCaracteresEspeciais(Campo: String): String;
var
  NC: Integer;
begin
  for NC:= 1 to Length(Campo) do begin
    case Campo[NC] of
      '(',')','''','<','>' : Campo[NC]:= ' ';
    end;
  end;
  RetiraCaracteresEspeciais:= Campo;
end;

function SomenteNumero(Campo: String; RetornaZeroQdoVazio: boolean = false): String;
var
  nc: integer;
  NovoCampo: String;
begin
  for nc:=1 to length(campo) do
  begin
   if isnumeric(campo[nc]) then
    NovoCampo := NovoCampo+campo[nc]
  end;
  Result := NovoCampo;

  if RetornaZeroQdoVazio then
    if Result = '' then
      result := '0';
end;

function RetiraZeroaEsquerda(Campo: String): String;
var
  nc: integer;
  NovoCampo: String;
begin
  for nc:=1 to length(campo) do
  begin
   if campo[nc]<>'0' then
   begin
    NovoCampo := copy(campo,nc,length(campo));
    break;
   end
  end;
  Result := NovoCampo;

end;

function SomenteNumeroF(Campo: String): String;
var
  nc: integer;
  NovoCampo: String;
begin
  for nc:=1 to length(campo) do
  begin
   if isnumeric(campo[nc]) or (campo[nc] in [',','.']) then
    NovoCampo := NovoCampo+campo[nc]
  end;
  Result := NovoCampo;
end;

function isAlpha(caracter: char): Boolean;
begin
   result := caracter in ['A'..'Z', 'a'..'z'];
end;

function PossuiSomenteNumero(Campo: String):Boolean;
var
  i: Integer;
begin
{
  for i:=1 to length(Campo) do
  begin
    if (IsNumeric(Campo[i])) or (Campo[i] = ',') or (Campo[i] = '.') then
      Result:= True
    else
    begin
      Result:= False;
      break;
    end;
  end;
}
  i := Length(Campo);
  Result := i > 0;
  if Result then
  begin
    while (i > 0) and (IsNumeric(Campo[i]) or (Campo[i] = ',') or (Campo[i] = '.')) do
      Dec(i);
    Result := i = 0;
  end;
end;

function PossuiSomenteNumeroInteiro(Campo: String):Boolean;
var
  i: Integer;
begin
  i := Length(Campo);
  Result := i > 0;
  if Result then
  begin
    while (i > 0) and (IsNumeric(Campo[i])) do
      Dec(i);
    Result := i = 0;
  end;
end;

function PossuiSomente(Campo, valor: String):Boolean;
var
  i: Integer;
begin
  i := Length(Campo);
  Result := i > 0;
  if Result then
  begin
    while (i > 0) and (Campo[i]=valor) do
      Dec(i);
    Result := i = 0;
  end;
end;

function eHInteger(valor: String): boolean;
var
  vValor: int64;
begin
  result := false;
  vValor := strtoint64(valor);
  if (vvalor >= -2147483647) and
     (vValor <= 2147483647) then
   result := true;

end;


function PossuiNumero(Campo: String): Boolean;
var
  nc: integer;
begin
{  result := false;
  for nc:=1 to length(campo) do
  begin
   if isnumeric(campo[nc]) then
   begin
    result := true;
    break;
   end;
  end;
}
  nc := Length(Campo);
  Result := nc > 0;
  if Result then
  begin
    while (nc > 0) and not IsNumeric(campo[nc]) do
      Dec(nc);
    Result := nc > 0;
  end;
end;

type

  TtecException = class
  public
    procedure Excecoes(Sender: TObject; E: Exception);
  end;

var
  tecExcpetion: TtecException;

{ TtecException }

procedure TtecException.Excecoes(Sender: TObject; E: Exception);
var
  PosError,i: Integer;
  msg : String;
begin
  PosError:= Pos('ERROR', E.Message);
  if PosError > 0 then
    E.Message:= TrimLeft(Copy(E.Message,PosError + 6,Length(E.Message)));

  if Pos('Operação cancelada! A quantidade em ESTOQUE ficará negativa para o produto',
         E.Message) > 0 then
  begin
    for i:=1 to Length(E.Message) do
    begin
      if copy(E.Message,i,1)='.' then
      begin
        msg := msg+'.';
        break;
      end
      else
        msg := msg + copy(E.Message,i,1);

      if copy(E.Message,i,1)='!' then
        msg := msg + chr(13);
    end;
    MensagemErro(msg);
  end
  else
  if Pos('violates foreign key', E.Message) > 0 then
  begin
// Mensagem enviada por servidores FEDORA
    if Pos('delete', E.Message) > 0 then
      MensagemErro(ctERROINTREFVIOLADA)
    else
      MensagemErro(ctERROINTREFVIOLADAINSERT + #13#10 + E.Message);
  end
  else
  if Pos('referential integrity violation - key in', E.Message) > 0 then
// Mensagem enviada por servidores REDHAT e CONECTIVA
    MensagemErro(ctERROINTREFVIOLADA)
  else
  if Pos('permission denied', E.Message) > 0 then
    MensagemErro(ctERROPERMISSAONEGADA)
  else
  if (pos('Field',E.Message) > 0) and
     (pos('not found',E.Message) > 0) then
  begin
    msg := trocar(E.Message,'Field','Campo');
    msg := trocar(msg,'not found', 'não existe');
    MensagemErro(msg)
  end
  else
  if (pos('is not a valid date and time',E.Message) >0) then
  begin
    msg := trocar(E.message, 'is not a valid date and time', 'não é uma data válida');
    MensagemErro(msg);
  end
  else
  if (pos('is not a valid time',E.Message) >0) then
  begin
    msg := trocar(E.message, 'is not a valid time', 'não é uma hora válida');
    MensagemErro(msg);
  end
  else
  if (pos('The allowed range is',E.Message) >0) then
  begin
    msg := trocar(E.message, 'is not a valid value for field', 'não é um valor válido para o campo');
    msg := trocar(msg, 'The allowed range is', 'O valor permitido está entre');
    msg := trocar(msg, 'to', 'e');
    MensagemErro(msg);
  end
  else
  begin
    Application.ShowException(E);
    if (E is EAccessViolation) or (E is EHeapException) or (E is EOutOfMemory) then begin
      MensagemErro('O tecLUX será finalizado.');
      Application.Terminate
    end
  end
end;

procedure SetarActivePage(AForm: TForm);
var
  cnt: Integer;

  procedure SetarPage(AComp: TComponent);
  var
    cnt, i : Integer;
  begin

    if (AComp is TtecPageControl) and
       (TtecPageControl(AComp).visible) then
    begin

       for i:=0 to TtecPageControl(AComp).pagecount-1 do
         if TtecPageControl(AComp).pages[i].tabvisible then
         begin
           TtecPageControl(AComp).tabindex := i;
           break;
         end;

    end
    else
    if (AComp is TPageControl) and
       (TPageControl(AComp).visible) then
    begin

       for i:=0 to TPageControl(AComp).pagecount-1 do
         if TPageControl(AComp).pages[i].tabvisible then
         begin
           TPageControl(AComp).tabindex := i;
           break;
         end;

    end
    else
      for cnt := 0 to AComp.ComponentCount - 1 do
        SetarPage(AComp.Components[cnt]);

  end;

begin

  for cnt := 0 to AForm.ComponentCount - 1 do
    SetarPage(AForm.Components[cnt]);

end;

procedure Dimensionar(AForm: TForm; Pos: TPosition; KeepSize: Boolean = False);
const
  DivisorEscala = 90;

  procedure DimensionarGrid(AComp: TComponent; Escala: Real);
  var
    cnt, col : Integer;
  begin
    if AComp is TDbGrid then
      for col := 0 to TDbGrid(AComp).Columns.Count - 1 do
        TDbGrid(AComp).Columns.Items[col].Width := Round(TDbGrid(AComp).Columns.Items[col].Width * Escala / DivisorEscala)
    else
      for cnt := 0 to AComp.ComponentCount - 1 do
          DimensionarGrid(AComp.Components[cnt], Escala);
  end;

const
{$IFNDEF LINUX}
  ADJUST_FONT_NAME  = 'arial';
{$ELSE}
  ADJUST_FONT_NAME  = 'helvetica';
{$ENDIF}
  DesignWidth = 1024;
var
  Escala: Real;
  cnt: Integer;
begin
  if not KeepSize then
    if Screen.Width < DesignWidth then
    begin
      AForm.Scaled := True;
      AForm.AutoScroll := False;
      Escala := Screen.Width / DesignWidth * 100;
      AForm.ScaleBy(Trunc(Escala), DivisorEscala);
      for cnt := 0 to AForm.ComponentCount - 1 do
        DimensionarGrid(AForm.Components[cnt], Escala);
    end;
//  AForm.Color := clBtnFace;
    AForm.Color := clBtnFace;

  if AForm.WindowState = wsNormal then
{$IFNDEF LINUX}
    //AForm.Position := Pos;
{$ELSE}
    if (AForm.FormStyle = fsMDIChild) and Assigned(Application.MainForm) then begin
      AForm.Position := poDesigned;
      AForm.Top := (Application.MainForm.CLientHeight - AForm.Height - 38) div 2;
      AForm.Left := (Application.MainForm.ClientWidth div 2)- (AForm.Width div 2);
    end else if AForm.FormStyle = fsNormal then begin
      AForm.Position := poDesigned;
      AForm.Top := (Screen.Height - AForm.Height) div 2;
      AForm.Left := (Screen.Width div 2)- (AForm.Width div 2);
    end;
{$ENDIF}

  AForm.Font.Name := ADJUST_FONT_NAME;
  Aform.Top := Aform.Top - 25;


//  AForm.ClientHeight := AForm.Height + 20;
//  AForm.ClientWidth := AForm.Width + 20;

//  AForm.ParentFont := True;
end;


procedure AutoSizeDBGrid(const xDBGrid: TDBGrid);
var
  I, TotalWidht, VarWidth, QtdTotalColuna : Integer;
  xColumn : TColumn;
begin
// Largura total de todas as colunas antes de redimensionar
  TotalWidht := 0;
// Como dividir todo o espaço extra na grade
  VarWidth := 0;
// Quantas colunas devem ser auto-redimensionamento
  QtdTotalColuna := xDBGrid.Columns.count;

  {
  for I := 0 to -1 + xDBGrid.Columns.Count do
  begin
    TotalWidht := TotalWidht + xDBGrid.Columns[I].Width;
    if xDBGrid.Columns[I].Field.Tag <> 0 then
      Inc(QtdTotalColuna);
  end;
  }

// Adiciona 1px para a linha de separador de coluna
  if dgColLines in xDBGrid.Options then
    TotalWidht := TotalWidht + xDBGrid.Columns.Count;

// Adiciona a largura da coluna indicadora
  if dgIndicator in xDBGrid.Options then
    TotalWidht := TotalWidht + IndicatorWidth;

// width vale "Left"
  VarWidth :=  xDBGrid.ClientWidth - TotalWidht;


// Da mesma forma distribuir VarWidth para todas as colunas auto-resizable
  if QtdTotalColuna > 0 then
    VarWidth := varWidth div QtdTotalColuna;

  for I := 0 to -1 + xDBGrid.Columns.Count do
  begin
    xColumn := xDBGrid.Columns[I];
//    if xColumn.Field.Tag <> 0 then
    begin
      xColumn.Width := xColumn.Width + VarWidth;
      if xColumn.Width < xColumn.Field.DisplayWidth then
        xColumn.Width := xColumn.Field.DisplayWidth;
    end;
  end;
end;

procedure DestruirFormulario(AForm: TForm);
var
  i: integer;
  nome: TComponent;

  procedure DestruirFrame(AFrame: TFrame);
  var
  i: integer;
  nome: TComponent;
  begin
    try
      try
      for i := AFrame.ComponentCount-1 downto 0  do
      begin
        Nome := Aframe.Components[i];
        if copy(nome.Name,1,3)='fra' then
          DestruirFrame(tframe(Nome))
        else
//        if nome.name='frmConsultaPorCampo' then
        if pos('frmConsultaPorCampo',nome.name)<>0 then
          DestruirFormulario(tform(nome))
        else
        begin
          if assigned(nome) then
            FreeAndNil(nome);
        end;
      end;
    except
      DestruirFrame(Aframe);
    end;
    finally
      if assigned(AFrame) then
        freeandnil(AFrame);
    end;
  end;

begin
  try
  try
    for i := AForm.ComponentCount-1 downto 0  do
    begin
      Nome := Aform.Components[i];
      if copy(nome.Name,1,3)='fra' then
        DestruirFrame(tframe(Nome))
      else
      begin
        if assigned(nome) then
          FreeAndNil(nome);
      end;
    end;
  except
    DestruirFormulario(Aform);
  end;
  finally
    if assigned(AForm) then
      AForm := nil;
  end;

end;

