    windows.MessageBox(Screen.ActiveForm.Handle, PMsg, PChar(ctERRO), MB_OK+MB_DEFBUTTON2+MB_TASKMODAL)

  end
  else
  begin
    //SetFocus(QWidget_winId(Screen.Forms[0].Handle)); CLX_TO_VCL
    SetFocus(Screen.Forms[0].Handle);

    Application.ProcessMessages;
    //windows.MessageBox(QWidget_winId(Screen.Forms[0].Handle), PMsg, PChar(ctERRO), MB_OK+MB_DEFBUTTON2+MB_TASKMODAL);
    //windows.MessageBox(QWidget_winId(Screen.Forms[0].Handle), PMsg, PChar(ctERRO), MB_OK+MB_DEFBUTTON2+MB_TASKMODAL); CLX_TO_VCL
    windows.MessageBox(Screen.Forms[0].Handle, PMsg, PChar(ctERRO), MB_OK+MB_DEFBUTTON2+MB_TASKMODAL);

  end;
  FreeMem(PMsg, Length(Msg)+1);
  Result := smbOK
{$ENDIF }
end;

function MensagemSimNaoOpcaoCancelar(mensagem, NomeOpcaoExtra: String;
         ExibirBotaoCancelar: boolean = true;
         DescricaoOpcaoSim : String = '&Sim';
         DescricaoOpcaoNao : String = '&Não';
         EnabledOpcaoSim : boolean = true;
         EnabledOpcaoNao: boolean = true;
         EnabledOpcaoExtra: boolean = true): TModalResult;
begin
  try
    frmMensagemSimNaoOpcaoCancela := TfrmMensagemSimNaoOpcaoCancela.Create(frmMensagemSimNaoOpcaoCancela);
    frmMensagemSimNaoOpcaoCancela.ModalResult := mrNone;
    frmMensagemSimNaoOpcaoCancela.btnCancelar.Visible := ExibirBotaoCancelar;
    frmMensagemSimNaoOpcaoCancela.lblMensagem.caption := mensagem;
    if NomeOpcaoExtra = '' then
      frmMensagemSimNaoOpcaoCancela.btnOpcao.Visible := false
    else
    begin
      frmMensagemSimNaoOpcaoCancela.btnOpcao.caption := NomeOpcaoExtra;
      frmMensagemSimNaoOpcaoCancela.btnOpcao.enabled := EnabledOpcaoExtra;
    end;


    frmMensagemSimNaoOpcaoCancela.btnSim.Caption := DescricaoOpcaoSim;
    frmMensagemSimNaoOpcaoCancela.btnSim.enabled := EnabledOpcaoSim;

    frmMensagemSimNaoOpcaoCancela.btnNao.Caption := DescricaoOpcaoNao;
    frmMensagemSimNaoOpcaoCancela.btnNao.enabled := EnabledOpcaoNao;

    frmMensagemSimNaoOpcaoCancela.AjustarTamanhos;

    frmMensagemSimNaoOpcaoCancela.ShowModal;
    result := frmMensagemSimNaoOpcaoCancela.ModalResult;
  finally
    frmMensagemSimNaoOpcaoCancela.Free;
    frmMensagemSimNaoOpcaoCancela := nil;

  end;
end;

function MensagemSimNaoOpcaoCancelarmmoXML(mensagem: String;
                                     arquivoxml: String): TModalResult ;
begin
  frmMensagemSimNaoOpcaoCancelammoxml := TfrmMensagemSimNaoOpcaoCancelammoxml.Create(frmMensagemSimNaoOpcaoCancelammoxml);
  frmMensagemSimNaoOpcaoCancelammoxml.lblMensagem.caption := mensagem;
