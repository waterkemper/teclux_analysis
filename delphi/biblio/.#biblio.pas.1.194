function CarregarModulos(Modulos: TStringList; PacotesBasicos: Boolean): Boolean;
var
  a,
  Poschar: Integer;
  Modulo, strModulos: String;
  lstPac: TStringList;

begin
  Result := True;
  ListaModulos := TStringList.Create;
  for a := 0 to Modulos.Count - 1 do begin
    strModulos := Modulos[a];
    Poschar := Pos('=', strModulos);
    Modulo := Copy(strModulos, 1, Poschar - 1);
    delete(strModulos, 1, Poschar);

    if Modulo='disponiveis' then
    begin
      if PacotesBasicos then
         strModulos := 'tecsoft6,automacao,repositorio'
      else
      begin
        if pos('repositorio', strModulos)=0 then
          strModulos := 'repositorio,' + strModulos;
      end;
    end;

    lstPac := TStringList.Create;
    while strModulos <> '' do begin
      Poschar := Pos(',', strModulos);
      if Poschar = 0 then begin
        lstPac.Add(strModulos);
        strModulos := ''
      end else begin
        lstPac.Add(Trim(Copy(strModulos, 1, Poschar - 1)));
        Delete(strModulos, 1, Poschar);
      end
    end;
    ListaModulos.AddObject(Modulo, lstPac)
  end;
  if ListaModulos.IndexOf(strDisponiveis) = -1 then begin
    Result := False;
    ListaModulos.AddObject(strDisponiveis, TStringList.Create)
  end;
end;

procedure LiberarModulos;
begin
  while ModulosCarregados.Count > 0 do
    LiberarModulos(ModulosCarregados[0]);
end;

procedure LiberarModulos(Pacote: String); overload;
var
  Pos: Integer;
  Modulo: HMODULE;
begin
  Pos := ModulosCarregados.IndexOf(Pacote);
  if Pos > -1 then begin
    Modulo := HMODULE(ModulosCarregados.Objects[Pos]);
    UnloadPackage(Modulo);
    ModulosCarregados.Delete(Pos);
  end
end;

function MensagemAviso(const Msg: WideString; BloquearTeclado: Boolean = false): TMessageButton;
{$IFDEF MSWINDOWS }
var
  Res: Integer;
  PMsg: PChar;
{$ENDIF }
begin
{$IFDEF LINUX }
  Result := Application.MessageBox(Msg, ctAVISO, [smbOK], smsWarning)
{$ELSE}
  PMsg := AllocMem(Length(Msg)+1);
  PMsg := StrPCopy(PMsg,  Msg);

  if BloquearTeclado then
    HC_KEYBOARD_Handle := SetWindowsHookEx(WH_KEYBOARD, @KeyboardProc, 0, GetCurrentThreadId);

  if Assigned(Screen.ActiveForm) then begin
//    SetFocus(QWidget_winId(Screen.ActiveForm.Handle)); CLX_TO_VCL
    SetFocus(Screen.ActiveForm.Handle);


    Application.ProcessMessages;
//    Res:= windows.MessageBox(QWidget_winId(Screen.ActiveForm.Handle), PMsg, PChar(ctAVISO), MB_OK+MB_TASKMODAL) CLX_TO_VCL
    Res:= windows.MessageBox(Screen.ActiveForm.Handle, PMsg, PChar(ctAVISO), {MB_OK+}MB_TASKMODAL)

  end else begin
//    SetFocus(QWidget_winId(Screen.Forms[0].Handle)); CLX_TO_VCL
    SetFocus(Screen.Forms[0].Handle);

    Application.ProcessMessages;
//    Res:= windows.MessageBox(QWidget_winId(Screen.Forms[0].Handle), PMsg, PChar(ctAVISO), MB_OK+MB_TASKMODAL); CLX_TO_VCL
    Res:= windows.MessageBox(Screen.Forms[0].Handle, PMsg, PChar(ctAVISO), {MB_OK+}MB_TASKMODAL);

  end;
  FreeMem(PMsg, Length(Msg)+1);

  if BloquearTeclado then
  begin
   keybd_event(VK_ESCAPE, 0, KEYEVENTF_KEYUP, 0);
   UnhookWindowsHookEx(HC_KEYBOARD_Handle);
  end;

//  if Res = MB_OK then

  if Res = IDOK then
    Result := smbOK
  else
    Result := smbCancel
{$ENDIF }
end;


procedure PlaySound(vparent: TWinControl);
begin
  if FileExists(ExtractFilePath(Application.ExeName) + 'alerta.mp3') then
  begin
    if not assigned(vMediaPlayer) then
    begin
      vMediaPlayer := MPlayer.TMediaPlayer.Create(Application);
      vMediaPlayer.Parent := Application.mainform;
      vMediaPlayer.TimeFormat := tfMilliseconds;
      vMediaPlayer.EndPos := 3000;
//      vMediaPlayer.wait := false;
      vMediaPlayer.name := 'MPlay';
      vMediaPlayer.left := 5;
      vMediaPlayer.TOP := 5;
      vMediaPlayer.Hide;

    end;

    vMediaPlayer.FileName := ExtractFilePath(Application.ExeName) + 'alerta.mp3';

    vMediaPlayer.open;
    vMediaPlayer.Play;
//    sleep(24000);
//    vMediaPlayer.destroy;

  end;

end;

