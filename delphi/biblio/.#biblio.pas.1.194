type TTempo_Thread = class(TThread)
       private
         Tempo_Ini:DWord;
         Handle_Form :DWord;
         fTempoExpirado: boolean;
         fTempo: DWord;
         procedure SetTempo(const Value: DWord);
       public

         constructor Create({aHandle,} aTempo:DWord);
         procedure Execute; override;
         property TempoExpirado: boolean read fTempoExpirado write fTempoExpirado;
         property Tempo: DWord read fTempo write SetTempo;
end;

