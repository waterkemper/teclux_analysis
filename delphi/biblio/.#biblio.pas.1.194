begin
  if Assigned(AForm) then
    AForm.SetFocus
  else
    Application.MainForm.SetFocus;
end;

{$IFDEF MSWINDOWS }
function MouseShowCursor(
  const Show: boolean): boolean;
var
  I: integer;
begin
  I := ShowCursor(LongBool(true));
  if Show then
  begin
    Result := I >= 0;
    while I < 0 do
    begin
      Result := ShowCursor(LongBool(true)) >= 0;
      Inc(I);
    end;
  end else
  begin
    Result := I < 0;
    while I >= 0 do
    begin
      Result := ShowCursor(LongBool(false)) < 0;
      Dec(I);
    end;
  end;
end;
{$ENDIF }

function FormExists(MetaClass: String): TForm;
var
  cnt: Integer;
begin
  Result := nil;
  for cnt := 0 to Screen.FormCount - 1 do
    if UpperCase(Screen.Forms[cnt].ClassName) = UpperCase(MetaClass) then
    begin
      Result := Screen.Forms[cnt];
      result.BringToFront;
//      result.ActiveControl.SetFocus;

      if Screen.Forms[cnt].WindowState = wsMinimized then
        Screen.Forms[cnt].WindowState := wsNormal;
      Break;
    end;
end;

