  begin

    vControlsDisabled := Tabela.ControlsDisabled;
    vRegistroAtual := Tabela.GetBookmark;
    if not vControlsDisabled then
      Tabela.DisableControls;
    Tabela.First;
    while not tabela.Eof do
    begin
      if ((CampoMarcado = nil) or
          ((CampoMarcado <> nil) and Tabela.fieldbyname(CampoMarcado.FieldName).asboolean)) and
         (Tabela.fieldbyname(NomedoCampo.FieldName).asstring<>'') then
      begin
        if IgnorarDuplicadas then
        begin
          if Tabela.fieldbyname(NomedoCampo.FieldName).datatype = ftString then
          begin
            if pos(', '+quotedstr(Tabela.fieldbyname(NomedoCampo.FieldName).asstring) + ', ', vLista)=0 then
            begin
              vLista := vLista + quotedstr(Tabela.fieldbyname(NomedoCampo.FieldName).asstring) + ', ';
              vListaS.append(Tabela.fieldbyname(NomedoCampo.FieldName).asstring);
            end;
          end
          else
            if pos(', '+Tabela.fieldbyname(NomedoCampo.FieldName).asstring + ', ', vLista)=0 then
            begin
              vLista := vLista + Tabela.fieldbyname(NomedoCampo.FieldName).asstring + ', ';
              vListaS.append(Tabela.fieldbyname(NomedoCampo.FieldName).asstring);
            end;
        end
        else
        begin
          if Tabela.fieldbyname(NomedoCampo.FieldName).datatype = ftString then
          begin
            vLista := vLista + quotedstr(Tabela.fieldbyname(NomedoCampo.FieldName).asstring) + ', ';
            vListaS.append(Tabela.fieldbyname(NomedoCampo.FieldName).asstring);
          end
          else
          begin
            vLista := vLista + Tabela.fieldbyname(NomedoCampo.FieldName).asstring + ', ';
            vListaS.append(Tabela.fieldbyname(NomedoCampo.FieldName).asstring);
          end;
        end;
      end;
      Tabela.Next;
    end;

    Tabela.GotoBookmark(vRegistroAtual);
    tabela.FreeBookmark(vRegistroAtual);

    if not vControlsDisabled then
      Tabela.EnableControls;

  end;
  result := vListaS;
end;

function ExisteDiferenca(QueryOrigem, QueryDestino: TtecQuery;
     Todos: Boolean = True;
     DesligarControlesOrigem: Boolean = True;
     DesligarControlesDestino: Boolean = True;
     CompareIfReadOnly: Boolean = True): boolean;
var
  a: Integer;
  ControlesJaDesabilitadosOrigem,
  ControlesJaDesabilitadosDestino : Boolean;
begin
  result := false;

  try

    ControlesJaDesabilitadosOrigem := QueryOrigem.ControlsDisabled;
    if not ControlesJaDesabilitadosOrigem then
     if DesligarControlesOrigem then
       QueryOrigem.DisableControls;

    ControlesJaDesabilitadosDestino := QueryDestino.ControlsDisabled;
    if not ControlesJaDesabilitadosDestino then
     if DesligarControlesDestino then
       QueryDestino.DisableControls;

    if QueryOrigem.RecordCount <> 0 then
    begin
      if todos then
        QueryOrigem.First;

      while not QueryOrigem.Eof do
      begin

        for a := 0 to QueryOrigem.FieldCount - 1 do
        begin
          if (QueryDestino.FindField(QueryOrigem.fields[a].fieldname)<>nil) then
          begin
            if (CompareIfReadOnly or not QueryDestino.FindField(QueryOrigem.fields[a].fieldname).readonly) then
            begin

              if QueryOrigem.Fields[a].IsNull then
                result := not QueryDestino.FindField(QueryOrigem.fields[a].fieldname).isnull
              else
              begin

                case QueryOrigem.Fields[a].datatype of

                  ftBoolean  : result := QueryDestino.FindField(QueryOrigem.fields[a].fieldname).IsNull or
                                        (QueryDestino.FindField(QueryOrigem.fields[a].fieldname).AsBoolean <> QueryOrigem.Fields[a].AsBoolean);
                  ftLargeint,
                  ftString,
                  ftDate,
                  ftDateTime : result :=  QueryDestino.FindField(QueryOrigem.fields[a].fieldname).IsNull or
                                         (QueryDestino.FindField(QueryOrigem.fields[a].fieldname).AsString <> QueryOrigem.Fields[a].AsString);

                else
                  result := QueryDestino.FindField(QueryOrigem.fields[a].fieldname).IsNull or
                            (QueryDestino.FindField(QueryOrigem.fields[a].fieldname).value <> QueryOrigem.Fields[a].value);
                end;
              end;
            end;
          end;

          if result then
            break;

        end;

        if todos and not result then
          QueryOrigem.Next
        else
          break;
      end;
    end;

    if not ControlesJaDesabilitadosOrigem then
      if DesligarControlesOrigem then
        QueryOrigem.EnableControls;

    if not ControlesJaDesabilitadosDestino then
      if DesligarControlesDestino then
        QueryDestino.EnableControls;

  except
  
  end;

end;

function CopiaRegistros_(QueryOrigem, QueryDestino: TtecQuery;
     Todos: Boolean = True;
     DesligarControlesOrigem: Boolean = True;
     DesligarControlesDestino: Boolean = True;
     CopyIfReadOnly: Boolean = True;
     EditarRegistro: boolean = false;
     VeficarSeCamposIguais: boolean = true): boolean;
var
  a: Integer;
  ControlesJaDesabilitadosOrigem,
  ControlesJaDesabilitadosDestino : Boolean;
begin
  result := true;

  try

    ControlesJaDesabilitadosOrigem := QueryOrigem.ControlsDisabled;
    if not ControlesJaDesabilitadosOrigem then
     if DesligarControlesOrigem then
       QueryOrigem.DisableControls;

    ControlesJaDesabilitadosDestino := QueryDestino.ControlsDisabled;
    if not ControlesJaDesabilitadosDestino then
     if DesligarControlesDestino then
       QueryDestino.DisableControls;

    if QueryOrigem.RecordCount <> 0 then
    begin
      if todos then
        QueryOrigem.First;

      while not QueryOrigem.Eof do
      begin

        if EditarRegistro and not todos then
          QueryDestino.edit
        else
          QueryDestino.Append;

        for a := 0 to QueryOrigem.FieldCount - 1 do
        begin

          if (VeficarSeCamposIguais and
             (QueryDestino.FindField(QueryOrigem.fields[a].fieldname)<>nil) and
             (QueryOrigem.fields[a].fieldname = QueryDestino.fields[a].fieldname)) or

             not VeficarSeCamposIguais then
          begin

            if (CopyIfReadOnly or not QueryDestino.Fields[a].readonly) then
            begin

              if QueryOrigem.Fields[a].IsNull then
                QueryDestino.Fields[a].clear
              else
              begin

                case QueryOrigem.Fields[a].datatype of
                  ftBoolean  : begin
                                 if (QueryDestino.Fields[a].AsBoolean <> QueryOrigem.Fields[a].AsBoolean) or
                                    QueryDestino.Fields[a].IsNull then
                                   QueryDestino.Fields[a].AsBoolean := QueryOrigem.Fields[a].AsBoolean;

                               end;
                  ftLargeint,
                  ftString,
                  ftDate,
                  ftDateTime : begin
                                 if QueryDestino.Fields[a].AsString <> QueryOrigem.Fields[a].AsString then
                                   QueryDestino.Fields[a].AsString := QueryOrigem.Fields[a].AsString;
                               end;
                else
                  if QueryDestino.Fields[a].value <> QueryOrigem.Fields[a].value then
                    QueryDestino.Fields[a].value := QueryOrigem.Fields[a].value;
                end;
              end;
            end;
          end;
        end;

        QueryDestino.post;

        if todos then
          QueryOrigem.Next
        else
          break;
      end;
    end;

    if not ControlesJaDesabilitadosOrigem then
      if DesligarControlesOrigem then
        QueryOrigem.EnableControls;

    if not ControlesJaDesabilitadosDestino then
      if DesligarControlesDestino then
        QueryDestino.EnableControls;

  except
    result := false;
  end;

end;


function CopiaRegistrosPorNome(QueryOrigem, QueryDestino: TtecQuery;
     Todos: Boolean = True;
     DesligarControlesOrigem: Boolean = True;
     DesligarControlesDestino: Boolean = True;
     CopyIfReadOnly: Boolean = True;
     EditarRegistro: boolean = false;
     VeficarSeCamposIguais: boolean = true;
     GravarTabelaDestino: Boolean = true): boolean;
var
  a: Integer;
  ControlesJaDesabilitadosOrigem,
  ControlesJaDesabilitadosDestino : Boolean;
begin
  result := true;

  try

    ControlesJaDesabilitadosOrigem := QueryOrigem.ControlsDisabled;
    if not ControlesJaDesabilitadosOrigem then
     if DesligarControlesOrigem then
       QueryOrigem.DisableControls;

    ControlesJaDesabilitadosDestino := QueryDestino.ControlsDisabled;
    if not ControlesJaDesabilitadosDestino then
     if DesligarControlesDestino then
       QueryDestino.DisableControls;

    if QueryOrigem.RecordCount <> 0 then
    begin
      if todos then
        QueryOrigem.First;

      while not QueryOrigem.Eof do
      begin

        if EditarRegistro and not todos then
          QueryDestino.edit
        else
          QueryDestino.Append;

        for a := 0 to QueryOrigem.FieldCount - 1 do
        begin

          if (VeficarSeCamposIguais and
             (QueryDestino.FindField(QueryOrigem.fields[a].fieldname)<>nil)) or

             not VeficarSeCamposIguais then
          begin

            if (CopyIfReadOnly or not QueryDestino.Fields[a].readonly) then
            begin

              if QueryOrigem.Fields[a].IsNull then
                QueryDestino.FieldByName(QueryOrigem.fields[a].fieldname).clear
              else
              begin

                case QueryOrigem.Fields[a].datatype of
                  ftBoolean  : begin
                                 if (QueryDestino.FieldByName(QueryOrigem.fields[a].fieldname).AsBoolean <> QueryOrigem.Fields[a].AsBoolean) or
                                    QueryDestino.FieldByName(QueryOrigem.fields[a].fieldname).IsNull then
                                   QueryDestino.FieldByName(QueryOrigem.fields[a].fieldname).AsBoolean := QueryOrigem.Fields[a].AsBoolean;

                               end;
                  ftLargeint,
                  ftString,
                  ftDate,
                  ftDateTime : begin
                                 if QueryDestino.FieldByName(QueryOrigem.fields[a].fieldname).AsString <> QueryOrigem.Fields[a].AsString then
                                   QueryDestino.FieldByName(QueryOrigem.fields[a].fieldname).AsString := QueryOrigem.Fields[a].AsString;
                               end;
                else
                  if QueryDestino.FieldByName(QueryOrigem.fields[a].fieldname).value <> QueryOrigem.Fields[a].value then
                    QueryDestino.FieldByName(QueryOrigem.fields[a].fieldname).value := QueryOrigem.Fields[a].value;
                end;
              end;
            end;

          end;
        end;

        if GravarTabelaDestino then
          QueryDestino.post;

        if todos then
          QueryOrigem.Next
        else
          break;
      end;
    end;

    if not ControlesJaDesabilitadosOrigem then
      if DesligarControlesOrigem then
        QueryOrigem.EnableControls;

    if not ControlesJaDesabilitadosDestino then
      if DesligarControlesDestino then
        QueryDestino.EnableControls;

  except
    result := false;
  end;

end;


function LocalizarValoresDuplicados(Tabela:TtecQuery; ListadeCampos: array of TField): Boolean;
var
  TabelaTemp : TtecQuery;
  Lista: TStringList;
  i, j, k: integer;
begin
  result := false;
  Lista := TStringList.create;

  TabelaTemp := TtecQuery.Create(nil);
  TabelaTemp.Database := Tabela.Database;
  TabelaTemp.Sql.Text := Tabela.Sql.Text;
  Tabelatemp.CachedUpdates := true;
  TabelaTemp.RequestLive := true;

  TabelaTemp.open;
  CopiaRegistros_(Tabela, TabelaTemp);
  {
  qryVerificarFilialBase := TtecQuery.Create(nil);
  qryVerificarFilialBase.Database := dtmTecSoft.Database;
  SQL := Format(VerificarFilialBaseSQL, [inttostr(GetFilialBase)]);
  qryVerificarFilialBase.Sql.Text := SQL;
  qryVerificarFilialBase.Open;
   }

  Tabela.first;
  while not Tabela.eof do
  begin

    j := Tabela.recno;
    TabelaTemp.recno := j;
    Tabela.first;
    while not Tabela.eof do
    begin

      if tabela.recno <> TabelaTemp.recno then
      begin

        result := true;
        for k := 0 to High(ListadeCampos) do
        begin
          if tabela.fieldbyname(TField(ListadeCampos[k]).fieldname).value <>
             tabelatemp.fieldbyname(TField(ListadeCampos[k]).fieldname).value then
          begin
            result := false;
            break;
          end;
        end;

      end;

      if result then
        break;
        
      Tabela.next;

    end;
    
    if result then
      break;

    Tabela.recno := TabelaTemp.recno;
    Tabela.next;
  end;

end;


function RetornarLista(Tabela:TtecQuery; ListadeCampos: array of TField; CampoMarcado: TField = nil; IgnorarDuplicadas: boolean = false): String;
var
  vControlsDisabled: Boolean;
  vRegistroAtual: TBookmark;
  vLista: String;

  function LIstadeCamposPossuiDados: boolean;
  var
    a: Integer;
  begin
    result := true;
    for a := 0 to High(ListadeCampos) do
    begin
      if ListadeCampos[a].asvariant = null then
      begin
        result := false;
        break;
      end;
    end;
  end;

  function ValoresdaListadeCampos: String;
  var
    a: Integer;
  begin
    result := '';
    for a := 0 to High(ListadeCampos) do
    begin
      if ListadeCampos[a].datatype = ftstring then
        result := result + quotedstr(ListadeCampos[a].asString) +', '
      else
        result := result + ListadeCampos[a].asString +', ';
    end;

    delete(result,length(result)-1, 2);
    result := '(' + result + ')';

  end;



begin
  vLista := ',';
  vControlsDisabled := Tabela.ControlsDisabled;
  vRegistroAtual := Tabela.GetBookmark;
  if not vControlsDisabled then
    Tabela.DisableControls;
  Tabela.First;
  while not tabela.Eof do
  begin

    if ((CampoMarcado = nil) or
        ((CampoMarcado <> nil) and Tabela.fieldbyname(CampoMarcado.FieldName).asboolean)) and
        ListadeCamposPossuiDados then
    begin
      if ignorarduplicadas then
      begin
        if pos(','+ValoresdaListadeCampos + ',', vLista)=0 then
          vLista := vLista + ValoresdaListadeCampos + ',';
      end
      else
        vLista := vLista + ValoresdaListadeCampos + ',';
    end;

    Tabela.Next;

  end;

  Tabela.GotoBookmark(vRegistroAtual);
  tabela.FreeBookmark(vRegistroAtual);

  if not vControlsDisabled then
    Tabela.EnableControls;


  if vLista <> ',' then
  begin
    delete(vLista,1,1);
    delete(vLista,length(vLista), 1);
  end
  else
    vLista := '';


  result := vLista;
end;

procedure SetFieldsReadOnly(Tabela:TtecQuery; Valor: Boolean);
var
i: integer;
begin
  for i:=0 to Tabela.fieldcount-1 do
    Tabela.fields[i].readonly := Valor;
end;

function VerificarTeclaEsc: boolean;
var
  State  :  TKeyboardState;
begin
   result := true;
   Application.ProcessMessages;
   if GetKeyState(VK_Escape) > 0 then
   begin
     State[VK_Escape] := 0;         {if it's on, turn it off}
     SetKeyboardState(State);     {actually set the new state}
     Application.ProcessMessages;
     if MensagemConfirmacao('Deseja interromper a operação?') =  smbOK then
       result := false;
   end;
end;

procedure TrimAppMemorySize;
var
  MainHandle : THandle;
begin
  try
   MainHandle := OpenProcess(PROCESS_ALL_ACCESS, false, GetCurrentProcessID) ;
   SetProcessWorkingSetSize(MainHandle, $FFFFFFFF, $FFFFFFFF) ;
   CloseHandle(MainHandle) ;
  except
  end;
  Sleep(500);
  Application.ProcessMessages;
end;


function eHNotaFiscalSaidaDevolucao(CodigoFiscal: integer; ST: boolean = false): boolean;
begin
    if ST then
      result := (CodigoFiscal mod 1000  = 410) or  // Devolução de compra para industrialização em operação com mercadoria sujeita ao regime de substituição tributária
                (CodigoFiscal mod 1000  = 411) or  // Devolução de compra para comercialização em operação com mercadoria sujeita ao regime de substituição tributária
                (CodigoFiscal mod 1000  = 412) or  // Devolução de bem do ativo imobilizado, em operação com mercadoria sujeita ao regime de substituição tributária
                (CodigoFiscal mod 1000  = 413)     // Devolução de mercadoria destinada ao uso ou consumo, em operação com mercadoria sujeita ao regime de substituição tributária

    else
      result := (CodigoFiscal mod 1000  = 201) or  // Devolução de compra para industrialização
                (CodigoFiscal mod 1000  = 202) or  // Devolução de compra para comercialização

                (CodigoFiscal mod 1000  = 205) or  // Anulação de valor relativo a aquisição de serviço de comunicação
                (CodigoFiscal mod 1000  = 206) or  // Anulação de valor relativo a aquisição de serviço de transporte
                (CodigoFiscal mod 1000  = 207) or  // Anulação de valor relativo à compra de energia elétrica
                (CodigoFiscal mod 1000  = 208) or  // Devolução de mercadoria recebida em transferência para industrialização
                (CodigoFiscal mod 1000  = 209) or  // Devolução de mercadoria recebida em transferência para comercialização
                (CodigoFiscal mod 1000  = 210) or  // Devolução de compra para utilização na prestação de serviço

                (CodigoFiscal mod 1000  = 410) or  // Devolução de compra para industrialização em operação com mercadoria sujeita ao regime de substituição tributária
                (CodigoFiscal mod 1000  = 411) or  // Devolução de compra para comercialização em operação com mercadoria sujeita ao regime de substituição tributária
                (CodigoFiscal mod 1000  = 412) or  // Devolução de bem do ativo imobilizado, em operação com mercadoria sujeita ao regime de substituição tributária
                (CodigoFiscal mod 1000  = 413) or  // Devolução de mercadoria destinada ao uso ou consumo, em operação com mercadoria sujeita ao regime de substituição tributária

                (CodigoFiscal mod 1000  = 553) or  // Devolução de compra de bem para o ativo imobilizado
                (CodigoFiscal mod 1000  = 555) or  // Devolução de bem do ativo imobilizado de terceiro, recebido para uso no estabelecimento
                (CodigoFiscal mod 1000  = 556) or  // Devolução de compra de material de uso ou consumo
                (CodigoFiscal mod 1000  = 902) or  // Retorno de mercadoria utilizada na industrialização por encomenda
                (CodigoFiscal mod 1000  = 903) or  //Retorno de mercadoria recebida para industrialização e não aplicada no referido processo
                (CodigoFiscal mod 1000  = 913) ;   //Retorno de mercadoria recebida para demonstração
end;

procedure BloquearTeclado(bloquear: boolean = true);
begin
  if Bloquear then
    HC_KEYBOARD_Handle := SetWindowsHookEx(WH_KEYBOARD, @KeyboardProc, 0, GetCurrentThreadId)
  else
    UnhookWindowsHookEx(HC_KEYBOARD_Handle);
end;


procedure bloquearUSB;
var
  reg : TRegistry;
begin
  reg := TRegistry.create;
  with reg do
  begin

     RootKey := HKEY_LOCAL_MACHINE;

     {
     usbuhci
     usbscan
     usbprint
     usbohci
     usbhub
     usbehci
     usbcir
     usbccgp
     usb_rndisx
     UsbStor
     }

     if OpenKey('\SYSTEM\CurrentControlSet\Services\usbcir',false) then
     begin
        reg.WriteInteger('Start',4);//quatro bloqueia
        reg.WriteString('ImagePath','_system32\DRIVERS\usbcir.sys');//caminho do arquivo que o windows usa para montar a unidade usb
     end;
     CloseKey;
 end;
end;

Procedure desbloquearUSB;
var
 reg : Tregistry;
begin
  reg := TRegistry.Create;
  with reg do begin
     RootKey := HKEY_LOCAL_MACHINE;
     if OpenKey('\SYSTEM\CurrentControlSet\Services\usbcir',false) then begin
        reg.WriteInteger('Start',3);//tres desbloqueia
        reg.WriteString('ImagePath','system32\DRIVERS\usbcir.sys');//caminho do arquivo que o windows usa para montar a unidade usb
     end;

  end;

end;

procedure EmptyKeyQueue;
var Msg: TMsg;
begin
while PeekMessage(Msg, 0, WM_KEYFIRST, WM_KEYLAST, PM_REMOVE or PM_NOYIELD) do;
end;


Procedure ClearKeyBoardBuffer(Handle:THandle);
var
 MyMgs :TMsg;
 NoMessages : Boolean;
begin
 repeat
//   if KeyBoardNotEnabled then EnableKeyBoard;
   NoMessages := not PeekMessage(MyMgs, Handle,WM_KEYFIRST,WM_KEYLAST,PM_REMOVE);
  until NoMessages = True
end;

function StringdaLista(camposmarcados: TStringList; SeparadordeCampo, DelimitadordeCampo: String): String;
var i : integer;
begin
  result := '';

  for i:=0 to CamposMarcados.Count -1 do
  begin
    if i<>0 then
      result := result + DelimitadordeCampo;
    result := result + SeparadordeCampo + camposmarcados.Strings[i] + SeparadordeCampo
  end;

end;


