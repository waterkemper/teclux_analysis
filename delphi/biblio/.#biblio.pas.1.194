function HexToDec(Valor: String): Integer;
var
  a, Qtde: Integer;
  val: Integer;
begin
  Result := 0;
  Qtde   := Length(Valor);
  for a := 1 to Qtde do begin
    case Valor[a] of
      '0'..'9': Val := StrToInt(Valor[a]);
      'A','a':  Val := 10;
      'B','b':  Val := 11;
      'C','c':  Val := 12;
      'D','d':  Val := 13;
      'E','e':  Val := 14;
      'F','f':  Val := 15;
    else
      Val := 0;
    end;
    Result := Result + Floor(Power(16, Qtde - a)) * Val;
  end
end;

var
  StartKey: Integer;

const
  MultKey  = 7;
  AddKey   = 11;

{$R-} {$Q-}
function Criptografar(Valor: String): String;
var
  I : Byte;
  Str: String;
  Nro: Integer;
begin
  StartKey := 5;
  Result   := '';
  for I := 1 to Length(Valor) do begin
    Result := Result + CHAR(Byte(Valor[I]) xor (StartKey shr 8));
    StartKey := (Byte(Result[I]) + StartKey) * MultKey + AddKey;
  end;
  Str := '';
  for i := 1 to Length(Result) do begin
    Nro := Ord(Result[i]);
    Str := Str + Format('%2.2X', [Nro]);
  end;
  Result := Str;
end;

// Retorna o valor do percentual sonbre o valor total.
function ValorDoPercentualSobreTotal(ValorTotal, Percentual:Double):Double;
var
  dvalor : Double;
begin
  dvalor := (ValorTotal*Percentual)/100;
  dvalor := dvalor *100;
  dvalor := Round(dvalor);
  dvalor := dvalor/100;
  Result := dvalor;
end;

// Retorna o percentual do valor sobre o valor total
function PercentualDoValorSobreTotal(ValorTotal, Valor:Double):Double;
var
  dvalor : Double;
begin
  if (ValorTotal<>0) then
  begin
    dValor := (Valor*100)/ValorTotal;
    dvalor := dvalor*100;
    dvalor := Round(dValor);
    dvalor := dvalor/100;
    Result := dvalor;
  end
  else Result := 0;
end;

function PercentualMarkup(NovoValor, ValorAntigo: Double):Double;
begin
  if valorantigo <> 0 then
  begin
    result := ((NovoValor/ValorAntigo) - 1) * 100;
    result := result * 100;
    result := Round(result);
    result := result / 100;
  end
  else
    result := 0;

end;

// Retorna o valor total do valor pelo percentual.
function TotalDoValorPeloPercentual(Valor, Percential : Double):Double;
var
  dvalor : Double;
begin
  if (Percential<>0) then
  begin
    dValor := (Valor*100)/Percential;
    dvalor := dvalor*100;
    dvalor := Round(dValor);
    dvalor := dvalor/100;
    Result := dvalor;
  end
  else Result :=0;
end;

function RatearValores(ValoraRatear, ValorDivisor, ValorMultiplicador: Double; NCasasArredondamento: integer): Double;
begin
  if ValorMultiplicador <> ValorDivisor then
  begin

    if ValorDivisor <> 0 then
      result := ValoraRatear * ValorMultiplicador / ValorDivisor
    else
      result := 0;

    if result <> 0 then
      if NCasasArredondamento <> 0 then
        result := roundto(result, -NCasasArredondamento);
  end
  else
    result := ValoraRatear;

end;

function Descriptografar(Valor: String): String;
var
  I : Byte;
  Str: String;
begin
  Str := '';
  I := 1;
  while I < Length(Valor) do begin
    Str := Str + Chr(HexToDec(Valor[I] + Valor[I + 1]));
    Inc(I, 2);
  end;
  Valor := Str;
  StartKey := 5;
  Result   := '';
  for I := 1 to Length(Valor) do begin
    Result := Result + CHAR(Byte(Valor[I]) xor (StartKey shr 8));
    StartKey := (Byte(Valor[I]) + StartKey) * MultKey + AddKey;
  end;
end;
