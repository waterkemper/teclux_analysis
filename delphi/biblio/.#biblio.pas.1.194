          begin
            if not (VarToStr(CamposCondicao[a].value) = VarToStr(ValoresCamposCondicao[a])) then
            begin
              vcontinuar := false;
              break;
            end;

          end
          else
          if CondicaoCamposCondicao[a]='>=' then
          begin
            if not (VarToStr(CamposCondicao[a].value) >= VarToStr(ValoresCamposCondicao[a])) then
            begin
              vcontinuar := false;
              break;
            end;
          end
          else
          if CondicaoCamposCondicao[a]='<=' then
          begin
            if not (VarToStr(CamposCondicao[a].value) <= VarToStr(ValoresCamposCondicao[a])) then
            begin
              vcontinuar := false;
              break;
            end;
          end
          else
          if CondicaoCamposCondicao[a]='<>' then
          begin
            if not (VarToStr(CamposCondicao[a].value) <> VarToStr(ValoresCamposCondicao[a])) then
            begin
              vcontinuar := false;
              break;
            end;
          end
          else
          if CondicaoCamposCondicao[a]='False' then
          begin
            if CamposCondicao[a].asboolean then
            begin
              vcontinuar := false;
              break;
            end;
          end
          else
          if CondicaoCamposCondicao[a]='True' then
          begin
            if not CamposCondicao[a].asboolean then
            begin
              vcontinuar := false;
              break;
            end;
          end;

        end;
      end;

      if vcontinuar and
         ExisteDiferencadeChave then
      begin

        ds.Edit;
        for a := 0 to High(Chaves) do
        begin
          case Chaves[a].dataType of
            ftlargeint, ftString :
            begin
              if Valores[a] = null then
                Chaves[a].clear
              else
                Chaves[a].AsSTring := Valores[a];
            end;
          else
            Chaves[a].Value := Valores[a];
          end;
        end;

        if (ds.state in [dsinsert, dsedit]) then
          ds. Post;
      end;

      if SomenteRegistroAtual or (ds.state=dsinsert) then
        break
      else
        ds.Next;

    end;

//    TZDataset(ds).SqlBuffer.SortFieldCount := nsort;
//    TZDataset(ds).SqlBuffer.SortRestore;

    ds.GotoBookmark(RegistroAtual);
    ds.FreeBookmark(RegistroAtual);

    if not ControlesJaDesabilitados then
      if DesligarControles then
        ds.EnableControls;
  end;

end;

procedure AtualizarClientDataSet_to_TTecQuery(Origem: TClientDataSet; Destino: tTecQuery);
var
 i,j, vrecno: integer;
begin
//  if origem.Modified then
  try

    vrecno := Destino.recno;

    origem.first;
    while not origem.eof do
    begin

      for i := 0 to Origem.fieldcount-1 do
      begin
        if origem.fields[i].Value <>
           origem.fields[i].OldValue then
        begin
          Destino.recno := origem.RecNo;
          {
          if (destino.FindField(origem.fields[i].fieldname)<> nil) and
             (destino.FieldByname(origem.fields[i].fieldname).value <> origem.fields[i].value) then
          begin
            Destino.edit;
            case origem.fields[i].datatype of
              ftString, ftUnknown, ftLargeint : Destino.fieldbyname(origem.fields[i].fieldname).AsString := origem.fields[i].asString;
              ftInteger, ftSmallint : Destino.fieldbyname(origem.fields[i].fieldname).asinteger := origem.fields[i].asInteger;
              ftVariant : Destino.fieldbyname(origem.fields[i].fieldname).value := origem.fields[i].value;
              ftDateTime : Destino.fieldbyname(origem.fields[i].fieldname).AsDateTime := origem.fields[i].asDatetime;
              ftCurrency : Destino.fieldbyname(origem.fields[i].fieldname).asCurrency := origem.fields[i].asCurrency;
              ftBoolean  : Destino.fieldbyname(origem.fields[i].fieldname).asBoolean := origem.fields[i].asBoolean;
            end;
            Destino.post;
          end;
          }
          Destino.Edit;
          for j := 0 to Destino.fieldcount-1 do
          begin

            if (Origem.Findfield(Destino.fields[j].FieldName)<>nil) and
               (Destino.fields[j].value <> Origem.FieldByName(Destino.fields[j].FieldName).value) then
              Destino.fields[j].value := Origem.FieldByName(Destino.fields[j].FieldName).value;
          end;

          break;
        end;
      end;

      if Destino.State = dsedit then
        Destino.Post;

      origem.Next;
    end;

  finally
    Destino.RecNo := vRecno;
  end;

end;



function ShellExecuteAndWait(Operation, FileName, Parameter, Directory: String; Show: Word; bWait: Boolean): Longint;
var
  bOK: Boolean;
  Info: TShellExecuteInfo;
begin
  FillChar(Info, SizeOf(Info), Chr(0));
  Info.cbSize := SizeOf(Info);
  Info.fMask := SEE_MASK_NOCLOSEPROCESS;
  Info.lpVerb := PChar(Operation);
  Info.lpFile := PChar(FileName);
  Info.lpParameters := PChar(Parameter);
  Info.lpDirectory := PChar(Directory);
  Info.nShow := Show;
  bOK := Boolean(ShellExecuteEx(@Info));
  if bOK then
  begin
    if bWait then
    begin
      while WaitForSingleObject(Info.hProcess, 100) = WAIT_TIMEOUT do
        Application.ProcessMessages;
      bOK := GetExitCodeProcess(Info.hProcess, DWORD(Result));
    end
    else
      Result := 0;
  end;
  if not bOK then
    Result := -1;
end;

procedure ExecFile(F: String);
var
r: String;
begin
// ShellExecuteAndWait('open', PChar(F), pchar(''), Pchar(extractfilepath(F)), SW_SHOWNORMAL, true);

// case ShellExecute(application.handle, '', {'open',} PChar(F), nil, Pchar(extractfilepath(F)), SW_SHOWNORMAL) of
 case ShellExecute(application.handle, 'open', PChar(F), nil, nil, SW_SHOW) of
  ERROR_FILE_NOT_FOUND: r := 'arquivo não encontrado'; //'The specified file was not found.';
  ERROR_PATH_NOT_FOUND: r := 'caminho não encontrado'; //'The specified path was not found.';
  ERROR_BAD_FORMAT: r := 'arquivo inválido'; // 'The .EXE file is invalid (non-Win32 .EXE or error in .EXE image).';
  SE_ERR_ACCESSDENIED: r := 'o programa não tem direito para acessar o arquivo/programa requisitado'; //'Windows 95 only: The operating system denied access to the specified file.';
  SE_ERR_ASSOCINCOMPLETE: r := 'arquivo requisitado não possui associação definida'; //'The filename association is incomplete or invalid.';
  SE_ERR_DDEBUSY: r := 'The DDE transaction could not be completed because other DDE transactions were being processed.';
  SE_ERR_DDEFAIL: r := 'The DDE transaction failed.';
  SE_ERR_DDETIMEOUT: r := 'The DDE transaction could not be completed because the request timed out.';
  SE_ERR_DLLNOTFOUND: r := 'Windows 95 only: The specified dynamic-link library was not found.';
  SE_ERR_NOASSOC: r := 'arquivo requisitado não possui associação definida'; //'There is no application associated with the given filename extension.';
  SE_ERR_OOM: r := 'Windows 95 only: There was not enough memory to complete the operation.';
  SE_ERR_SHARE: r := 'A sharing violation occurred.';
 else
  Exit;
 end;

 ShowMessage(r);

end;


procedure AtribuirDataSource(objeto: tcomponent; DataSource: TtecDataSource);
var
  i: integer;
  comp : tcomponent;
  PropInfo: PPropInfo;

begin
  for i:= 0 to objeto.ComponentCount -1 do
  begin
    comp := objeto.components[i];

    if (comp.InheritsFrom(TFrame))  then
      AtribuirDataSource(comp, DataSource);

    PropInfo := GetPropInfo(comp.ClassInfo, 'DataSource');

    if PropInfo <> nil then
    begin
    end;

  end;
end;

procedure SalvarDadosnoArquivo(Arquivo, conteudo: String);
var
  ArquivoText: TextFile;
begin
  AssignFile(ArquivoText,Arquivo);

  if (not FileExists(Arquivo)) then
    Rewrite(ArquivoText);

  Append(ArquivoText);
  Write(ArquivoText, conteudo);
  Write(ArquivoText, chr(13));

  CloseFile(ArquivoText);
end;

function DadosdaFilial(nomedocampo: string; codigofilial: integer): variant;
begin
  if assigned(qryDadosFilial_) then
  begin
    if qryDadosFilial_.locate('codigo', codigofilial, []) then
       result := qryDadosFilial_.fieldbyname(nomedocampo).asvariant;
  end;
end;

function GravarDadosdaFilial(nomedocampo: string; codigofilial: integer; ValordoCampo : Variant): boolean;
begin
  if assigned(qryDadosFilial_) then
  begin
    if qryDadosFilial_.locate('codigo', codigofilial, []) then
    begin
      if qryDadosFilial_.fieldByName(nomedocampo).asVariant <> ValordoCampo then
      begin
        qryDadosFilial_.edit;
        qryDadosFilial_.fieldByName(nomedocampo).asVariant := ValordoCampo;
        qryDadosFilial_.post;
        qryDadosFilial_.transaction.commit;
        qryDadosFilial_.applyupdates;
        qryDadosFilial_.commitupdates;
      end;
    end;
  end;
end;


function GravarArquivoxml(Caminho, Texto: String; Salvar: boolean = true): boolean;
var
  Response: TStringStream;
  v_Arq_temp : TStrings;
  vString : String;
begin
  result := true;
  try
    vString := StringReplace(Texto,#$D,'',[rfReplaceAll]);
    vString := StringReplace(vString,#$A,'',[rfReplaceAll]);
    vString := StringReplace(vString,#9,'',[rfReplaceAll]);
    vString := trim(vString);

    Response := TStringStream.Create(vString);

    {NO ACTIVE DOCUMENT}

    if not assigned(Docxml) then
      Docxml := TXMLDocument.Create(application.MainForm);

    try

      Docxml.LoadFromStream(Response);
      if not Docxml.active then
      begin
        result := false;
        MensagemErro('Erro na leitura do conteúdo do formato xml');
      end;

      if Salvar then
        docxml.SaveToFile(caminho);
      Response.free;
    except

      if Salvar or not result then
      begin
        result := false;
        v_Arq_temp := TStringList.create;
        v_Arq_temp.Append(Texto);
        v_Arq_temp.SaveToFile(ChangeFileExt(caminho,'.txt'));
        v_Arq_temp.free;
      end;

    end;

  except

    result := false;
  end;

end;


procedure AtribuirDados(ds: TClientDataSet;
                            Chaves: array of TField;
                            Valores: array of Variant;
                            DesligarControles: Boolean = true);
var
  a, nsort : Integer;
  RegistroAtual: TBookMark;
  ControlesJaDesabilitados : Boolean;

  function ExisteDiferencadeChave: boolean;
  var
    a: Integer;
  begin
    result := false;
    for a := 0 to High(Chaves) do
    begin
      if Chaves[a].Value <> Valores[a] then
      begin
        result := true;
        break;
      end;
    end;
  end;

begin
  if ds.active then
  begin
    if High(Chaves) <>
       High(Valores) then

      raise Exception.Create('Parâmetros "Chaves" e "Valores" estão com tamanhos diferentes.')

    else
    begin

      RegistroAtual := ds.GetBookmark;

//      nsort := DS.SqlBuffer.SortFieldCount;
//      TZDataset(ds).SqlBuffer.SortFieldCount := 0;

      ControlesJaDesabilitados := ds.ControlsDisabled;

      if not ControlesJaDesabilitados then
        if DesligarControles then
          ds.DisableControls;

      ds.First;
      while not ds.Eof do
      begin
        if ExisteDiferencadeChave then
        begin
          ds.Edit;
          for a := 0 to High(Chaves) do
            case Chaves[a].dataType of
              ftlargeint, ftString :
              begin
                if Valores[a] = null then
                 Chaves[a].clear
                else
                 Chaves[a].AsSTring := Valores[a];
              end;
            else
              Chaves[a].Value := Valores[a];
            end;
          ds.Post;
        end;
        ds.Next;
      end;

//      TZDataset(ds).SqlBuffer.SortFieldCount := nsort;
//      TZDataset(ds).SqlBuffer.SortRestore;

      ds.GotoBookmark(RegistroAtual);
      ds.FreeBookmark(RegistroAtual);

      if not ControlesJaDesabilitados then
        if DesligarControles then
          ds.EnableControls;
    end;
  end;
end;


