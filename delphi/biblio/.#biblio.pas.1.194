function FormatarCPFouCGC(Numero: String): String;
var
  Tam: Integer;
  Res: String;
begin
  Res:= '';
  Tam:= Length(Numero);
  if Tam = 11 then
    Res:= Copy(Numero, 1,3) + '.' +
          Copy(Numero, 4,3) + '.' +
          Copy(Numero, 7,3) + '-' +
          Copy(Numero,10,2)
  else if Tam = 14 then
    Res:= Copy(Numero, 1,2) + '.' +
          Copy(Numero, 3,3) + '.' +
          Copy(Numero, 6,3) + '/' +
          Copy(Numero, 9,4) + '-' +
          Copy(Numero,13,2)
  else
    Res:= '';
  Result:= Res;
end;

function DescricaoLabelCliente(Tipo: Char): String;
begin
  case Tipo of
    'C': Result:= 'Cliente';
    'F': Result:= 'Fornecedor';
    'L': Result:= 'Filial';
  end;
end;

function PrimeiraLetraEmMaiuscula(Nome: String): String;
var
  X : Integer;
  Lista : Array[0..4] of String[03];

  function NaoAchaPreposicao(Palavra : String): Boolean;
  var
    x : Integer;
  begin
    Result := True;
    for x := 0 to 4 do begin
      if (LowerCase(Trim(Palavra)) = Lista[x]) then
        Result := False;
    end;
  end;

begin
  Nome:= TrimRight(Nome);
  if Nome <> '' then begin
    Result := LowerCase(Nome);
    Lista[0] := 'das'; Lista[1] := 'dos' ;
    Lista[2] := 'de';  Lista[3] := 'do' ;
    Lista[4] := 'da';
    Result := UpCase(Result[1]) + Copy(Result, 2, Length(Result));
    for x := 2 to Length(Nome)-1 do begin
      if Nome[x] in [#32,'.'] then
        if Copy(Nome,x+1,1) <> 'e' then
         if NaoAchaPreposicao(Copy(Nome,x+1,3)) then
           Result := Copy(Result, 1, x) + UpCase(Result[x+1]) + Copy(Result, x+2, Length(Result));
    end;
  end;
end;

function UltimoDiaMesPassado(Meses: Integer): TDateTime;
begin
  try
    Result := IncMonth(Today, -Meses);
    Result := EncodeDate(YearOf(Result),
                         MonthOf(Result),
                         DaysInAMonth(YearOf(Result), MonthOf(Result))
                         );
  except
    Result := Today;
  end;
end;

function UltimoDiaMesPassado(Meses: Integer; Data: TDateTime): TDateTime;
begin
  try
    Result := IncMonth(Data, -Meses);
    Result := EncodeDate(YearOf(Result),
                         MonthOf(Result),
                         DaysInAMonth(YearOf(Result), MonthOf(Result))
                         );
  except
    Result := Data;
  end;
end;

function PrimeiroDiaMesPassado(Meses: Integer): TDateTime;
begin
  try
    Result := IncMonth(Today, -Meses);
    Result := EncodeDate(YearOf(Result),
                         MonthOf(Result),
                         01
                         );
  except
    Result := Today;
  end;
end;

function PrimeiroDiaMesPassado(Meses: Integer; Data: TDateTime): TDateTime; overload;
begin
  try
    Result := IncMonth(Data, -Meses);
    Result := EncodeDate(YearOf(Result),
                         MonthOf(Result),
                         01
                         );
  except
    Result := Data;
  end;
end;

function PrimeiroDiaAno(Ano: integer): TDateTime;
begin
  try
    Result := EncodeDate(Ano,
                         01,
                         01
                         );
  except

  end;
end;

function UltimoDiaAno(Ano: integer): TDateTime;
begin
  try
    Result := EncodeDate(Ano,
                         12,
                         31
                         );
  except

  end;
end;


function SemanaPassada(Data: TDateTime): TDateTime;
begin
  try
    Result := IncWeek(Data, -1);
  except
    Result := Today;
  end;
end;

function ConverteValor(valor:string):string;
var ind:integer;
begin
  for ind:= 1 to length(valor) do
    if valor[ind] = ',' then valor[ind]:= '.';
  result := valor;
end;

function Converte(Key:Char):Char;
begin
  if Key = '.' then
       Converte:= ','
  else Converte:= Key;
end;

function VerificaOcorrencia(Valor: String; const Inicio, Fim: Integer; Tokens: Array of Char): Boolean;
var
  cnt, ctk: Integer;
  str: String;
begin
  Result := False;
  if (High(Tokens) >= 0) and (Length(Valor) >= Inicio) then
  begin
    if Fim = 0  then
      Result := IsDelimiter(Tokens, Valor[Inicio], 1)
    else
    begin
      str := Copy(Valor, Inicio, Fim);
      ctk := 0;
      for cnt := 1 to Length(str) do
        if IsDelimiter(Tokens, str[cnt], 1) then
          Inc(ctk);
      Result := (ctk = Length(str));
    end;
  end;
end;

