procedure TtecParametrosSistema.setMascaraQuantidade(const Value: String);
{
var
  i: integer;
  mascara : String;
  }
begin
{
  Mascara := Trim(Value);
  for i := 1 to length(mascara) do
  begin
    if not (mascara[i] in ['0',',','.']) then
      mascara[i] := '0';
  end;
  if (Mascara = '') or (Mascara = '0') then
    Mascara := '0,';
  Flist[ctMascaraQuantidade].AsString := mascara;
  }
  Flist[ctMascaraQuantidade].AsString := value;
end;

function TtecParametrosSistema.getMascaraQuantidadeGrade: String;
var
 i: integer;
 mascara: string;
begin
  mascara := MascaraQuantidade;
  Fmascaraquantidadegrade:='';
  for i:=1 to length(mascara) do
  begin
   if (mascara[i]=',') then
     Fmascaraquantidadegrade := Fmascaraquantidadegrade + '.'
   else
      if (mascara[i]='.') then
        Fmascaraquantidadegrade := Fmascaraquantidadegrade + ','
      else
       Fmascaraquantidadegrade := Fmascaraquantidadegrade + mascara[i];
  end;
  result := Fmascaraquantidadegrade;

end;

