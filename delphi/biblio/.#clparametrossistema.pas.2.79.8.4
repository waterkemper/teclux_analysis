function TtecParametrosSistema.Ler: Integer;
var
  Ind: Integer;
  ParSis: TtecParametroSistema;
begin
  if Assigned(FDatabase) then begin
    qryPar.Database := FDatabase;
    qryPar.Open;
    Excluir;
    try
      while Not qryPar.Eof do begin
        Ind := FList.IndexOf(qryPar.Fields[1].AsString);
        if Ind > -1 then
          FList.Item[Ind].IncluirFilial(qryPar.Fields[2].AsString, qryPar.Fields[3].AsInteger)
        else begin
          ParSis := TtecParametroSistema.Create(qryPar.Fields[0].AsInteger,
                                                qryPar.Fields[1].AsString,
                                                qryPar.Fields[2].AsString,
                                                qryPar.Fields[3].AsInteger);
          FList.Add(ParSis);
        end;
        qryPar.Next
      end;
      Result := cttecPARSIS_NOERROR;
    finally
      qryPar.Close
    end;

    try
      qryMascaras.Database := FDatabase;
      qryMascaras.Open;
      qryMascaras.First;
      ParSistema.MascaraContabil[1].Clear;
      ParSistema.MascaraContabil[2].Clear;
      ParSistema.MascaraBancos[1].Clear;
      ParSistema.MascaraBancos[2].Clear;
      while not qryMascaras.Eof do
      begin
        if qryMascaras.fieldbyname('tipo').asstring = 'C' then
        begin
          ParSistema.MascaraContabil[1].Add(qryMascaras.fieldbyname('nivel').AsString);
          ParSistema.MascaraContabil[2].Add(qryMascaras.fieldbyname('mascara').AsString+';1;_');
        end
        else
        if qryMascaras.fieldbyname('tipo').asstring = 'B' then
        begin
          ParSistema.MascaraBancos[1].Add(qryMascaras.fieldbyname('nivel').AsString);
          ParSistema.MascaraBancos[2].Add(qryMascaras.fieldbyname('mascara').AsString+';1;_');
        end;
        qryMascaras.Next;
      end;


    finally
      qryMascaras.Close;
    end;

    frVariables['MascaraQuantidade'] := ParSistema.MascaraQuantidadeGrade;

    case PrecoUnitarioCasasDecimais of
      2: frVariables['MascaraPrecoUnitarioCasasDecimais'] := '###,###,##0.00';
      3: frVariables['MascaraPrecoUnitarioCasasDecimais'] := '###,###,##0.000';
      4: frVariables['MascaraPrecoUnitarioCasasDecimais'] := '###,###,##0.0000';
      5: frVariables['MascaraPrecoUnitarioCasasDecimais'] := '###,###,##0.00000';
      6: frVariables['MascaraPrecoUnitarioCasasDecimais'] := '###,###,##0.000000';
      7: frVariables['MascaraPrecoUnitarioCasasDecimais'] := '###,###,##0.0000000';
      8: frVariables['MascaraPrecoUnitarioCasasDecimais'] := '###,###,##0.00000000';
    end;

  end else begin
    FErro := cttecPARSIS_ERROR_DATABASE_NOT_DEFINED;
    Result := FErro;
  end;

end;

procedure TtecParametrosSistema.Salvar;
var
  a, b: Integer;
  SQL,
  ValorParametro,
  Parametro: String;
  Filiais: TtecFiliaisModificadas;
  FilialAnt: Integer;
begin
  SQL := '';
  FilialAnt := Filial;
  qryUpdate.Database := FDatabase;
  qryUpdate.Sql.Clear;
  for a := 0 to FList.Count - 1 do
  begin
    Filiais := nil;
    FList.Item[a].Modificado(Filiais);

    for b := 0 to High(Filiais) do
    begin
      FList.Item[a].PorFilial := Filiais[b].Filial;
      if Filiais[b].tipo = cmMODIFICADO then
      begin
//        if (FList.Item[a].AsString = '') or (FList.Item[a].AsString = '0') or (ANSIUpperCase(FList.Item[a].AsString) = 'FALSE') then

        if (FList.Item[a].AsString = '') or (ANSIUpperCase(FList.Item[a].AsString) = 'FALSE') then
          ValorParametro := ''
        else
          ValorParametro := 'valor = ''' + FList.Item[a].AsString + '''';

        Parametro      := '(parametro = ' + IntToSTr(FList.Item[a].Codigo) + ')';
        if Filiais[b].Filial = -1 then
          Parametro := Parametro + ' and (filial is null)'
        else
          Parametro := Parametro + ' and (filial = ' + IntToStr(Filiais[b].Filial) + ')';

        if ValorParametro = '' then
          SQL := SQL + Format(SQLDelete, [Parametro])
        else
          SQL := SQL + Format(SQLUpdate, [ValorParametro, Parametro]);

      end else begin
        if Filiais[b].Filial = -1 then
          ValorParametro := IntToSTr(FList.Item[a].Codigo) + ', null, ''' + FList.Item[a].AsString + ''''
        else
          ValorParametro := IntToSTr(FList.Item[a].Codigo) + ', ' + IntToStr(Filiais[b].Filial) + ', ''' + FList.Item[a].AsString + '''';
        SQL := SQL + Format(SQLInsert, [ValorParametro]);
      end;
      qryUpdate.Sql.Append(SQL);
      SQL := '';
    end;
    if High(Filiais) > -1 then
      FList.Item[a].PorFilial := FilialAnt;
  end;

  if qryUpdate.Sql.Count > 0 then
  begin
    qryUpdate.ExecSql;
    qryUpdate.Transaction.Commit;
    for a := 0 to FList.Count - 1 do
      FList.Item[a].Inalterado;
  end;

end;


