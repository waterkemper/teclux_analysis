{ TtecParametroSistema }

constructor TtecParametroSistema.Create(Cod: Integer; NomePar, Valor: String; Filial: Integer);
begin
  inherited Create;
  FCodigo    := Cod;
  FNome      := NomePar;
  FPorFilial := -1;
  FFilial    := TList.Create;
  if Valor <> '' then
    FFilial.Add(TtecValorParametroFilial.Create(Filial, Valor));
end;

destructor TtecParametroSistema.Destroy;
begin
  while FFilial.Count > 0 do begin
    TtecValorParametroFilial(FFilial.Items[0]).Free;
    FFilial.Delete(0);
  end;
  FFilial.Free;
  inherited;
end;

procedure TtecParametroSistema.ExcluirFilial(Filial: Integer);
var
  a: Integer;
begin
  a := 0;
  while  a < FFilial.Count do
    if TtecValorParametroFilial(FFilial.Items[a]).Filial = Filial then begin
      TtecValorParametroFilial(FFilial.Items[a]).Free;
      FFilial.Delete(a);
      break
    end else
      Inc(a)
end;

function TtecParametroSistema.getAsBoolean: Boolean;
begin
  try
//    Result := StrToBool(AsString)

    if LowerCase(AsString) = 'true'  then
      result := true
    else
      result := false;
        
  except
    Result := False
  end
end;

function TtecParametroSistema.getAsDatetime: TDateTime;
begin
  try
    Result := StrToDateTime(AsString)
  except
    Result := StrToDateTime('01/01/1900')
  end
end;

function TtecParametroSistema.GetAsInteger: Integer;
begin
  try
    Result := StrToInt(AsString)
  except
    Result := 0
  end
end;

function TtecParametroSistema.GetAsReal: Real;
begin
  try
    Result := StrToFloat(AsString)
  except
    Result := 0
  end
end;

function TtecParametroSistema.getAsString: String;
var
  a: Integer;
begin
  Result := '';
  for a := 0 to FFilial.Count -1 do
    if TtecValorParametroFilial(FFilial.Items[a]).Filial = PorFilial then begin
      Result := TtecValorParametroFilial(FFilial.Items[a]).Valor;
      break;
    end;
  if ValorGlobal and (a >= FFilial.Count) then
    for a := 0 to FFilial.Count -1 do
      if TtecValorParametroFilial(FFilial.Items[a]).Filial = -1 then begin
        Result := TtecValorParametroFilial(FFilial.Items[a]).Valor;
        break;
      end
end;

procedure TtecParametroSistema.Inalterado;
var
  a: Integer;
  Valor: String;
begin
  for a := 0 to FFilial.Count - 1 do begin
    Valor := TtecValorParametroFilial(FFilial.Items[a]).Valor;
    if (Valor = '') or (Valor = '0') or (Valor = 'False') then begin
      TtecValorParametroFilial(FFilial.Items[a]).Free;
      FFilial.Items[a] := nil;
    end
  end;
  a := 0;
  while a < FFilial.Count do begin
    if Assigned(FFilial.Items[a]) then begin
      TtecValorParametroFilial(FFilial.Items[a]).Modificado := cmINALTERADO;
      Inc(a)
    end else
      FFilial.Delete(a)
  end
end;

procedure TtecParametroSistema.IncluirFilial(Valor: String; Filial: Integer);
begin
  FFilial.Add(TtecValorParametroFilial.Create(Filial, Valor));
end;

procedure TtecParametroSistema.Modificado(var Filiais: TtecFiliaisModificadas);
var
  a, b: Integer;
begin
  b := 0;
  for a := 0 to FFilial.Count -1 do
    if (TtecValorParametroFilial(FFilial.Items[a]).Modificado = cmMODIFICADO) or
       (TtecValorParametroFilial(FFilial.Items[a]).Modificado = CMINCLUIDO) then begin
      SetLength(Filiais, b + 1);
      Filiais[b].Filial    := TtecValorParametroFilial(FFilial.Items[a]).Filial;
      Filiais[b].tipo      := TtecValorParametroFilial(FFilial.Items[a]).Modificado;
      Inc(b);
    end
end;

procedure TtecParametroSistema.setAsBoolean(const Value: Boolean);
begin
  try
    AsString := BoolToStr(Value, True)
  except
    AsString := ''
  end
end;

procedure TtecParametroSistema.setAsDatetime(const Value: TDateTime);
begin
  try
    AsString := DateTimeToStr(Value)
  except
    AsString := ''
  end
end;

procedure TtecParametroSistema.setAsInteger(const Value: Integer);
begin
  try
    AsString := IntToStr(Value)
  except
    AsString := ''
  end
end;

procedure TtecParametroSistema.setAsReal(const Value: Real);
begin
  try
    AsString := FloatToStr(Value)
  except
    AsString := ''
  end
end;

procedure TtecParametroSistema.setAsString(const Value: String);
var
  a: Integer;
  NaoExiste: Boolean;
  Valor: String;
begin
  Valor := Trim(Value);
  NaoExiste := True;
  for a := 0 to FFilial.Count - 1 do
    if TtecValorParametroFilial(FFilial.Items[a]).Filial = PorFilial then begin
      TtecValorParametroFilial(FFilial.Items[a]).Valor := Valor;
      NaoExiste := False
    end;
  if NaoExiste and (Valor <> '') and (Valor <> '0') and (Valor <> 'False') then begin
    FFilial.Add(TtecValorParametroFilial.Create);
    TtecValorParametroFilial(FFilial.Items[FFilial.Count-1]).Incluir(PorFilial, Valor);
  end
end;

{ TtecParametrosSistemaList }

function TtecParametrosSistemaList.Add(Item: TtecParametroSistema): Integer;
begin
  Result := inherited AddObject(Item.Nome, Item)
end;

procedure TtecParametrosSistemaList.ApagarFilial(Filial: Integer);
var
  a: Integer;
begin
  for a := 0 to Count - 1 do
    Item[a].ExcluirFilial(Filial);
end;

function TtecParametrosSistemaList.GetItem(Index: Integer): TtecParametroSistema;
begin
  if (0 <= Index) and (Index < Count) then
    Result := TtecParametroSistema(Objects[Index])
  else
    Result := nil;
end;

function TtecParametrosSistemaList.GetItemByName(Nome: String): TtecParametroSistema;
var
  Ind: Integer;
  Str: String;
begin
  Ind := IndexOf(Nome);
  if Ind = -1 then
  begin
    if Filial<>0 then
    begin
      Str := Format('O parâmetro ''%s'' não está definido no sistema. Entre em contato com o suporte', [Nome]);
      MensagemErro(Str);
    end;  
    Result := TtecParametroSistema.Create(0, '', '', 0);
  end else
    Result := TtecParametroSistema(Objects[Ind]);

  Result.ValorGlobal := ValorGlobal;
  Result.PorFilial := Filial
end;

procedure TtecParametrosSistemaList.setFilial(const Value: Integer);
var
  a: Integer;
begin
  FFilial := Value;
  for a := 0 to Count - 1 do
    Item[a].PorFilial := FFilial
end;

{ TtecValorParametroFilial }

constructor TtecValorParametroFilial.Create;
begin
  inherited Create;
  FModificado := cmINALTERADO;
end;

constructor TtecValorParametroFilial.Create(Filial: Integer; Valor: String);
begin
  inherited Create;
  FFilial     := Filial;
  FValor      := Valor;
  FModificado := cmINALTERADO;
end;

procedure TtecValorParametroFilial.Incluir(Filial: Integer; Valor: String);
begin
  FFilial     := Filial;
  FValor      := Valor;
  FModificado := cmINCLUIDO;
end;

procedure TtecValorParametroFilial.setValor(const Value: String);
begin
  if FValor <> Value then begin
    FValorPrevio := FValor;
    FValor := Value;
    if FModificado <> cmINCLUIDO then
      FModificado := cmMODIFICADO;
  end
end;

