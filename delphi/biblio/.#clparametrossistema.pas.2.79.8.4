//  ParametrosContas = 'select * from parametroscontas limit 1';

  ParametrosSistemasSQL =
'select pf.parametro as codigo,'+#10#13+
'       (select p.descricao'+#10#13+
'       from parametros p'+#10#13+
'       where p.codigo = pf.parametro) as parametro,'+#10#13+
'       valor,'+#10#13+
'       case when filial is null'+#10#13+
'            then -1'+#10#13+
'            else filial'+#10#13+
'       end as filial'+#10#13+
'from parametrosfiliais pf'+#10#13+
'union '+#10#13+
'select p.codigo, '+#10#13+
'       p.descricao as parametro,'+#10#13+
'       cast(null as varchar) as valor, '+#10#13+
