type

  TtecValorParametroFilial = class
  private
    FFilial: Integer;
    FValor: String;
    procedure setValor(const Value: String);
  protected
    FModificado: TtecCampoModificado;
    FValorPrevio: String;
  public
    constructor Create(Filial: Integer; Valor: String); overload;
    constructor Create; overload;
    procedure Incluir(Filial: Integer; Valor: String);
    property Filial: Integer read FFilial write FFilial;
    property Modificado: TtecCampoModificado read FModificado write FModificado;
    property Valor: String read FValor write setValor;
  end;

var
  qryPar, qryUpdate, qryMascaras {, qryParametrosContas}: TtecQuery;

constructor TtecParametrosSistema.Create;
begin
 inherited Create;
 FErro     := 0;
 FDatabase := nil;
 FList     := TtecParametrosSistemaList.Create;
 MascaraContabil[1] := tstringlist.create;
 MascaraContabil[2] := tstringlist.create;
 MascaraBancos[1] := tstringlist.create;
 MascaraBancos[2] := tstringlist.create;
end;

destructor TtecParametrosSistema.Destroy;
begin
  while FList.Count > 0 do begin
    FList.Objects[0].Free;
    FList.Delete(0);
  end;
  FList.Free;
  inherited;
end;

function TtecParametrosSistema.getAgencia: Integer;
begin
  Result := FList[ctAGENCIA].AsInteger;
end;

procedure TtecParametrosSistema.Excluir;
begin
  while 0 < FList.Count do begin
    FList.Item[0].Free;
    FList.Delete(0)
  end
end;

procedure TtecParametrosSistema.ExcluirFilial;
begin
  qryUpdate.Database := FDatabase;
  qryUpdate.Sql.Clear;
  qryUpdate.Sql.Append('delete from parametrosfiliais where filial = ' + IntToStr(Filial));
  qryUpdate.ExecSql;
  qryUpdate.Transaction.Commit;
  FList.ApagarFilial(Filial);
end;

