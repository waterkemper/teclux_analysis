function TtecParametrosSistema.getExclusaoNotaAvulsa: TtecEXCLUSAONOTAAVULSA;
var
  Tipo: String;
begin
  Tipo := FList[ctEXCLUSAO_NOTAAVULSA].AsString;
  if Tipo = 'E' then
    Result := exnEXCLUIR
  else if Tipo = 'C' then
    Result := exnCANCELAR
  else if Tipo = 'P' then
    Result := exnPERGUNTAR
  else
    Result := exnNENHUMA;
end;

procedure TtecParametrosSistema.setExclusaoNotaAvulsa(
  const Value: TtecEXCLUSAONOTAAVULSA);
begin
  if Value = exnEXCLUIR then
    FList[ctEXCLUSAO_NOTAAVULSA].AsString := 'E'
  else if Value = exnCANCELAR then
    FList[ctEXCLUSAO_NOTAAVULSA].AsString := 'C'
  else if Value = exnPERGUNTAR then
    FList[ctEXCLUSAO_NOTAAVULSA].AsString := 'P'
end;

