procedure catAtendimentos(LstAtend: TStrings);
var
  a: byte;
begin
  if Not Assigned(LstAtend) then
    LstAtend := TStringList.Create;
  for a := 0 to catctMaxAtendimentos - 1 do
    LstAtend.Add(catctAtendimentos[a])
end;

procedure catManutencoes(LstManutencoes: TStrings);
var
  a: Integer;
begin
  if Not Assigned(LstManutencoes) then
    LstManutencoes := TStringList.Create;
  for a := 0 to catctMaxManutencoes - 1 do
    LstManutencoes.Add(catctManutencoes[a])
end;

