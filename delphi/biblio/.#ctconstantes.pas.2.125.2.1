  if Not Assigned(LstSituacoes) then
    LstSituacoes := TStringList.Create;
  for a := 0 to catctMaxSituacoes - 1 do
    LstSituacoes.Add(catctSituacoes[a])
end;

//**************** Modulo tecContabil **************************

procedure cblTipoConta(LstTipoContas: TStrings);
var
  a: TtecTipoConta;
begin
  if Not Assigned(LstTipoContas) then
    LstTipoContas := TStringList.Create;
  for a := tcANALITICA to tcSINTETICA  do
    LstTipoContas.Add(cblctTipoConta[a])
end;





end.
