procedure TtecECF.AtualizarTotalizadorGeral(Arquivo: String);
var
  ArqECF: TIniFile;
begin
  ArqECF := TIniFile.Create(Arquivo);
  try
    if ArqECF.SectionExists(Codigo) then
    begin
      ArqECF.WriteString(Codigo, 'gt', Criptografar(FloatToStr(TotalizadorGeral)));
      ArqECF.UpdateFile;
    end;
    SalvarECFs(StrToInt(Codigo), TotalizadorGeral);
  finally
    ArqECF.Free
  end;
end;

