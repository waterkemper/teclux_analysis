function TtecECF.IndiceRecebimentoNaoFiscal(Registrador: String; var Maior: Integer): String;
{
var
  a: Integer;
  }
begin
  {
  Result := -1;
  Maior  := High(FRecebimentosNaoFiscais) + 1;
  for a := 0 to High(FRecebimentosNaoFiscais) do
  begin
    if ANSIUpperCase(Registrador) = FRecebimentosNaoFiscais[a] then
    begin
      Result := a + 1;
      break
    end;
  end;
  }
  try
    if Registrador = 'R$' then
      result := AchaCNFDescricao(Registrador, True).Indice;
  except
  end;

  try
    if result = '' then
      result := AchaCNFDescricao('Reais', True).Indice;
  except
  end;

  if result = '' then
    MensagemAviso(format('Indice recebimento não fiscal ''%s'' nao encontrado',[Registrador]));
end;

