      //Desconto – ISSQN
      SetLength(DetalhesReducaoZ, Length(DetalhesReducaoZ) + 1);
      DetalhesReducaoZ[Length(DetalhesReducaoZ) - 1].TipoTotalizadorParcial := 'DS';
      DetalhesReducaoZ[Length(DetalhesReducaoZ) - 1].aliquota               := 0.00;
      DetalhesReducaoZ[Length(DetalhesReducaoZ) - 1].ValorAcumulado         := 0.00 {não esta presente};

      //Acréscimo – ICMS
      SetLength(DetalhesReducaoZ, Length(DetalhesReducaoZ) + 1);
      DetalhesReducaoZ[Length(DetalhesReducaoZ) - 1].TipoTotalizadorParcial := 'AT';
