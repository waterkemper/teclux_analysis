function TtecECF.SalvarFormasPagamentoECF(
  TipoOperacaoECF: TTecTipoOperacaoECF; FormaPagto: String='';
  Valor: Currency=0): boolean;
var
 i: integer;
begin
  try
    result := false;
    with ArqIniDadosECF[TipoOperacaoECF] do
    begin
      case TipoOperacaoECF of
        TEfetuaPagamento :
        begin
          WriteInteger ('FormasPagamento'+inttostr(SequenciaFormaPagto), 'NUM_ITEM' , SequenciaFormaPagto);
          WriteString  ('FormasPagamento'+IntToStr(SequenciaFormaPagto), 'COO' , Cupom);
          WriteString  ('FormasPagamento'+inttostr(SequenciaFormaPagto), 'CCF' , NumCCF); // Número do Contador de Cupom Fiscal relativo ao respectivo Cupom Fiscal emitido
          WriteString  ('FormasPagamento'+inttostr(SequenciaFormaPagto), 'MP',  FormadePagamentoConfigurada(FormaPagto));            // Descrição do totalizador parcial de meio de pagamento
          WriteFloat   ('FormasPagamento'+inttostr(SequenciaFormaPagto), 'VL_PAGTO', Valor);            // Valor do pagamento efetuado, com duas casas decimais
          WriteString  ('FormasPagamento'+inttostr(SequenciaFormaPagto), 'IND_EST', 'N'); // Informar "S" ou "N", conforme tenha ocorrido ou não, o estorno do pagamento, ou “P” para estorno parcial do pagamento
          WriteFloat   ('FormasPagamento'+inttostr(SequenciaFormaPagto), 'VL_EST', 0.00);
          FSequenciaFormaPagto := FSequenciaFormaPagto + 1;
          updatefile;
          result := true;
        end;

        TNaoFiscalCompleto :
        begin
          WriteInteger ('FormasPagamento', 'NUM_ITEM' , 1);
          WriteString  ('FormasPagamento', 'CCO'      , NumCOO); // Número do Contador de Cupom Fiscal relativo ao respectivo Cupom Fiscal emitido
          WriteString  ('FormasPagamento', 'GNF'      , NumGNF); // Número do Contador Geral Não Fiscal relativo ao respectivo Comprovante Não Fiscal emitido
          WriteString  ('FormasPagamento', 'MP'       , FormadePagamentoConfigurada(FormaPagto));            // Descrição do totalizador parcial de meio de pagamento
          WriteFloat   ('FormasPagamento', 'VL_PAGTO' , Valor);            // Valor do pagamento efetuado, com duas casas decimais
          WriteString  ('FormasPagamento', 'IND_EST'  , 'N'); // Informar "S" ou "N", conforme tenha ocorrido ou não, o estorno do pagamento, ou “P” para estorno parcial do pagamento
          WriteFloat   ('FormasPagamento', 'VL_EST'   , 0.00);
          updatefile;
          result := true;
        end;

        TCancelaCupom :
        begin
          i := 0;
          while true do
          begin
            i := i + 1;
            if SectionExists('FormasPagamento'+inttostr(i)) then
            begin
              WriteString  ('FormasPagamento'+inttostr(i), 'IND_EST', 'S'); // Informar "S" ou "N", conforme tenha ocorrido ou não, o estorno do pagamento, ou “P” para estorno parcial do pagamento
              WriteFloat   ('FormasPagamento'+inttostr(i), 'VL_EST',
                 ReadFloat('FormasPagamento'+inttostr(i), 'VL_PAGTO', 0.00));
            end
            else
              break;
          end;
          updatefile;
          result := true;
        end;
      end;
    end;
  except
    on E: Exception do TrataErros(E);
  end;
end;

