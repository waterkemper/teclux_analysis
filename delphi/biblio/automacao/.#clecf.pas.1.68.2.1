procedure TtecECF.LerFormasPagamento;

  procedure VerificaFormasPagamento;
  var
    Count, total: Integer;
  begin
    total := FormasPagamento.Count;
    SetLength(FFormasPagamento, total);
    for count := 0 to total - 1 do
    begin
      FFormasPagamento[count].indice := FormasPagamento[count].Indice;
      FFormasPagamento[count].descricao := FormasPagamento[count].Descricao;
    end;
  end;

  procedure ProgramaFormasPagto;
  var
    a: Integer;
    Descricao: String;
  begin
    inherited CarregaFormasPagamento;
    for a := Low(ECF_FORMA_PAGTO) to High(ECF_FORMA_PAGTO) do
    begin

      if AchaFPGDescricao(FormadePagamentoConfigurada(ECF_FORMA_PAGTO[a])) = nil then
      begin
        Descricao := FormadePagamentoConfigurada(ECF_FORMA_PAGTO[a]);
        try
          inherited ProgramaFormaPagamento(Descricao);
        except
          FErro := true;
          MensagemAviso('Forma de Pagamento: ' + Descricao + ' não programada!');
          Break;
        end;
      end;

    end;
    VerificaFormasPagamento;
  end;

  procedure MontaRecebimentosNaoFiscal;
  var
    Count, totalNaoFiscal, a: Integer;
    Descricao: String;
  begin
    inherited CarregaComprovantesNaoFiscais;
    for a := Low(ECF_CNF) to High(ECF_CNF) do
    begin
      Descricao := ECF_CNF[a].descricao;
      try
        if AchaCNFDescricao(Descricao, True) = nil then
          inherited ProgramaComprovanteNaoFiscal(Descricao, ECF_CNF[a].tipo);
      except
        //MensagemAviso('Comprovante NÃO Fiscal: ' + ECF_CNF[a].descricao + ' não programado!')
      end;
    end;
    totalNaoFiscal := ComprovantesNaoFiscais.Count;
    {
    SetLength(FRecebimentosNaoFiscais, totalNaoFiscal);
    for count := 0 to totalNaoFiscal - 1 do
      FRecebimentosNaoFiscais[count] := AnsiUpperCase(ComprovantesNaoFiscais[count].Descricao);
      }
  end;


begin
  inherited;
  ProgramaFormasPagto;
  if Not Erro then
    MontaRecebimentosNaoFiscal;
  FErro := False;
end;

