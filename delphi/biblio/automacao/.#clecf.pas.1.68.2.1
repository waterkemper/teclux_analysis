function TtecECF.GetArqIniDadosECF(TipoOperacaoECF: TTecTipoOperacaoECF): TMemIniFile;
var
  vSerieMaquina,
  vIntervencao,
  vNumCupom,
  vNomeArquivo,
  vNewNomeArquivo : String;
  vArqini : tStringList;
begin
                                  {

  TTecTipoOperacaoECF = (TAbreCupom, TCancelaCupom, TSubtotalizaCupom, TFechaCupom,
                         TVendeItem, TCancelaItem,
                         TCupomVinculado, TNaoFiscalCompleto, TRelatorioGerencial,
                         TEfetuaPagamento);
                         }


  if not assigned(FArqIniDadosECF) or (TipoOperacaoECF = TAbreCupom)  then
  begin

    vSerieMaquina := SerieMaquina;
    if vgravandocupomvinculado then
      vNumCupom := preencheString(inttostr(vCOORef), '0', 6, false)
    else
      vNumCupom := Cupom;

    vIntervencao := Intervencao;

    vNomeArquivo := ExtractFilePath(Application.ExeName) + 'PAF-ECF';

    if not DirectoryExists(vNomeArquivo) then
      if not CreateDir(vNomeArquivo) then
      raise Exception.Create('Impossível criar o diretório '+vNomeArquivo);

    vNewNomeArquivo := vNomeArquivo+'\'+vSerieMaquina+'_'+vIntervencao+'_'+vNumCupom + '_'+formatdatetime('yyyy-MM-DD hh_mm', now())+'.txt';
    vNomeArquivo := vNomeArquivo+'\'+vSerieMaquina+'_'+vIntervencao+'_'+vNumCupom+'.txt';

    FArqIniDadosECF := TMemIniFile.Create(vNomeArquivo);

    if FileExists(vNomeArquivo) then
    begin
      vArqini := TStringList.Create;
      vArqini.LoadFromFile(vNomeArquivo);

      if (TipoOperacaoECF = TAbreCupom) then
      begin
        vArqini.SaveToFile(vNewNomeArquivo);
        deletefile(vNomeArquivo);
        FreeAndNil(fArqIniDadosECF);
        FArqIniDadosECF := TMemIniFile.Create(vNomeArquivo);
      end;
      {
      else
        FArqIniDadosECF.SetStrings(vArqini); desnecessario visto que o arquivo ja foi carregado na memoria no TMemIniFile.Create}

      vArqini.Free;
    end;


  end;
{
  if FArqIniDadosECF.FileName = '' then
  begin
    vSerieMaquina := self.SerieMaquina;
    vNumCupom := self.Cupom;
    vArquivoCupomFiscal := vSerieMaquina+'_'+vNumCupom+'.txt';
    if FileExists(vArquivoCupomFiscal) then
    begin
      vArqini := TStringList.Create;
      vArqini.LoadFromFile(vArquivoCupomFiscal);
      FArqIniDadosECF.SetStrings(vArqini);
      vArqini.Free;
    end;
  end;
}
  Result := FArqIniDadosECF;
end;

