function TtecECF.SalvarDadosCupom(TipoOperacaoECF: TTecTipoOperacaoECF;
          CGC_CPF: String = ''; Nome: String = '';
          HeDesconto: Boolean = false; Desc_ou_Acresc: Currency = 0): Boolean;
begin
  try
    result := false;
    with ArqIniDadosECF[TipoOperacaoECF] do
    begin
      case TipoOperacaoECF of
        TAbreCupom :
        begin
          WriteString  ('CupomFiscal', 'NUM_FAB'      , SerieMaquina);
  //        WriteString  ('CupomFiscal', 'MF_ADICIONAL' , self.MFAdicional);
  //        WriteString  ('CupomFiscal', 'MODELO_ECF'   , self.SubModeloECF);
          WriteString  ('CupomFiscal', 'NUM_USU'      , NumeroMaquina);
          WriteString  ('CupomFiscal', 'CCF'          , ECFPadrao.NumCCF);
          WriteString  ('CupomFiscal', 'CRO'          , NumCRO);
          WriteString  ('CupomFiscal', 'COO'          , Cupom);
          WriteDateTime('CupomFiscal', 'DT_INI'       , ECFPadrao.DataHora);
          WriteInteger ('CupomFiscal', 'CRZ'          , IfThen(NumeroReducoes<>'',StrToInt(NumeroReducoes)+1,0));
          WriteString  ('CupomFiscal', 'NOME_CLI'     , Nome);
          WriteString  ('CupomFiscal', 'CNPJ_CPF'     , CGC_CPF);
          WriteString  ('CupomFiscal', 'CANC'         , 'N');

          FSequenciaItem := 0;
          FSequenciaFormaPagto := 0;
  //        FSequenciaDemaisDoctosECF := 0;
          UpdateFile;
          result := true;
        end;

        TCancelaCupom :
        begin
          WriteString  ('CupomFiscal', 'CANC'         , 'S');
          UpdateFile;
          result := true;
        end;

        TSubtotalizaCupom :
        begin
          if Desc_ou_Acresc < 0 then
            WriteFloat ('CupomFiscal', 'SUB_DOCTO'    , ECFPadrao.Subtotal+abs(Desc_ou_Acresc))
          else
            WriteFloat ('CupomFiscal', 'SUB_DOCTO'    , ECFPadrao.Subtotal-Desc_ou_Acresc);
          WriteFloat   ('CupomFiscal', 'SUB_DESCTO'   , ifthen((Desc_ou_Acresc<0), abs(Desc_ou_Acresc), 0));
          WriteString  ('CupomFiscal', 'TP_DESCTO'    , 'V');
          WriteFloat   ('CupomFiscal', 'SUB_ACRES'    , ifthen((Desc_ou_Acresc>0), Desc_ou_Acresc,0));
          WriteString  ('CupomFiscal', 'TP_ACRES'     , 'V');

          WriteFloat    ('CupomFiscal' , 'VL_TOT'    ,
              (ReadFloat ('CupomFiscal', 'SUB_DOCTO' , 0) -
               ReadFloat ('CupomFiscal', 'SUB_DESCTO', 0) +
               ReadFloat ('CupomFiscal', 'SUB_ACRES' , 0)));

          WriteFloat   ('CupomFiscal', 'VL_CA'   , 0); {não trabalhado com esta funcionalidade}
          WriteString  ('CupomFiscal', 'ORDEM_DA', 'D'); {não trabalhado com esta funcionalidade}
          UpdateFile;
          result := true;
        end;

        TFechaCupom: result := SalvarDadosECFLocal;

      end;
    end;
  except
    on E: Exception do TrataErros(E);
  end;
end;


function TtecECF.SalvarDadosItemCupom(TipoOperacaoECF: TTecTipoOperacaoECF;
               codigo: String = ''; descricao: String = ''; unidade: String = '';
               quantidade: Currency = 0; preco: Currency = 0; desconto: Currency = 0;
               tributo: String = ''; producaopropria: Boolean = false;
               NumItemCancelado: Integer = 0): boolean;
var
  teste,
  trib,
  indic : string;
  aliq,salva: Double;
begin
  try
    result := false;
    with ArqIniDadosECF[TipoOperacaoECF] do
    begin
      case TipoOperacaoECF of
        TVendeItem :
        begin
          WriteInteger('ItemCupomFiscal'+inttostr(SequenciaItem),'NUM_ITEM'   , SequenciaItem); // Número do item registrado no documento
          WriteString ('ItemCupomFiscal'+inttostr(SequenciaItem),'COD_ITEM'   , codigo);        // Código do produto ou serviço registrado no documento
          WriteString ('ItemCupomFiscal'+inttostr(SequenciaItem),'DESC_ITEM'  , descricao);     // Descrição do produto ou serviço constante no Cupom Fiscal
          WriteFloat  ('ItemCupomFiscal'+inttostr(SequenciaItem),'QTDE_ITEM'  , quantidade);    // Quantidade comercializada, sem a separação das casas decimais
          WriteString ('ItemCupomFiscal'+inttostr(SequenciaItem),'UN_MED'     , unidade);       // Unidade de medida
          WriteFloat  ('ItemCupomFiscal'+inttostr(SequenciaItem),'VL_UNIT'    , preco);         // Valor unitário do produto ou serviço, sem a separação das casas decimais.
          WriteFloat  ('ItemCupomFiscal'+inttostr(SequenciaItem),'DESCTO_ITEM', desconto);      // Valor  do desconto  incidente sobre o valor do item, com duas casas decimais.
          WriteFloat  ('ItemCupomFiscal'+inttostr(SequenciaItem),'ACRES_ITEM', 0.00);          // Valor do acréscimo incidente sobre o valor do item, com duas casas decimais.
          WriteFloat  ('ItemCupomFiscal'+inttostr(SequenciaItem),'VL_TOT_ITEM',
                                                                      Truncar((quantidade*preco) - desconto,2)); //Valor total líquido do item, com duas casas decimais.
          {Verificar se o retorno esta de acordo com a tabela reducoeszdetalhes}

          if PossuiNumero(tributo) then
          begin
            trib := tributo;    //juvenil
            indic:= ECFPadrao.AchaICMSAliquota(tributo).Indice;
            aliq := ECFPadrao.AchaICMSAliquota(trib).Aliquota;
            salva:=aliq;
            tipo:=ECFPadrao.AchaICMSAliquota(salva).Tipo;
            WriteFloat('ItemCupomFiscal'+inttostr(SequenciaItem), 'ALIQ_ICMS', salva);
            if preencheString(SomenteNumero(indic),'0',2,False) = '00' then
              WriteString ('ItemCupomFiscal'+inttostr(SequenciaItem),'COD_TOT_PARC' ,
                       '01' +
                       tipo +
                       Trocar(FormatFloat('00.00',aliq),',','')) //Código do totalizador relativo ao produto ou serviço conforme tabela abaixo.
            else
              WriteString ('ItemCupomFiscal'+inttostr(SequenciaItem),'COD_TOT_PARC' ,
                       preencheString(SomenteNumero(indic),'0',2,False) +
                       tipo +
                       Trocar(FormatFloat('00.00',aliq),',','')); //Código do totalizador relativo ao produto ou serviço conforme tabela abaixo.

          end
          else
          begin
            WriteFloat('ItemCupomFiscal'+inttostr(SequenciaItem), 'ALIQ_ICMS', 0);
            WriteString ('ItemCupomFiscal'+inttostr(SequenciaItem),'COD_TOT_PARC' ,
                     copy(tributo,1,1)+'1')
          end;

          WriteString ('ItemCupomFiscal'+inttostr(SequenciaItem),'IND_CANC', 'N');
          WriteFloat  ('ItemCupomFiscal'+inttostr(SequenciaItem),'QTDE_CANC', 0.00); //não utilizada // Quantidade cancelada, no caso de cancelamento parcial de item, sem a separação das casas decimais.
          WriteFloat  ('ItemCupomFiscal'+inttostr(SequenciaItem),'VL_CANC_ACRES', 0.00); //não utilizada // Valor do cancelamento de acréscimo no item
          WriteString ('ItemCupomFiscal'+inttostr(SequenciaItem),'IAT', ifthen(ecfpadrao.Arredonda,'A','T')); // Indicador de Arredondamento ou Truncamento relativo à regra de cálculo do valor total líquido do item, sendo “T”  para truncamento ou “A” para arredondamento
          WriteString ('ItemCupomFiscal'+inttostr(SequenciaItem),'IPPT', ifthen(producaopropria,'P','T')); // Indicador de Produção Própria ou de Terceiro relativo à mercadoria, sendo “P” para mercadoria de produção própria ou “T” para mercadoria produzida por terceiros
          WriteInteger('ItemCupomFiscal'+inttostr(SequenciaItem),'QTDE_DECIMAL', ECFPadrao.DecimaisQtd ); // Parâmetro de número de casas decimais da quantidade
          WriteInteger('ItemCupomFiscal'+inttostr(SequenciaItem),'VL_DECIMAL', ECFPadrao.DecimaisPreco ); // Parâmetro de número de casas decimais de valor unitário
          FSequenciaItem := FSequenciaItem + 1;
          updatefile;
          result := true;
        end;

        TCancelaItem :
        begin
          WriteString ('ItemCupomFiscal'+inttostr(NumItemCancelado),'IND_CANC', 'S');
  //        WriteFloat  ('ItemCupomFiscal'+inttostr(SequenciaItem),'QTDE_CANC', 0.00);
          UpdateFile;
          result := true;
        end;

      end;
    end;
  except
    on E: Exception do TrataErros(E);
  end;
end;

