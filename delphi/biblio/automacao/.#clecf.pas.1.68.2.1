function TtecECF.FormadePagamentoConfigurada(Descricao: String): String;
begin
  result := Descricao;

  if assigned(qryMeiosdePagamentoECF) then
    if qryMeiosdePagamentoECF.Active then
      if qryMeiosdePagamentoECF.recordcount<>0 then
      begin
        if qryMeiosdePagamentoECF.locate('descricaomeiodepagamento', Descricao, []) then
        begin
          if not qryMeiosdePagamentoECF.FieldByName('descricaoecf').isnull then
            result := qryMeiosdePagamentoECF.FieldByName('descricaoecf').asString;
        end;
      end;
end;

