procedure TtecECF.CancelarCupom;
var
  SalvarInf : Boolean;
  vNumCupom : integer;
begin
  if ImpressoraBloqueada then
    MensagemErro(ctECFBLOQUEADA)
  else
  begin
    try
      try
        vGravandoCupomVinculado := false;
        vCOORef := 0;
        with ArqIniDadosECF[TCancelaCupom] do
        begin
          if SectionExists('DemaisDoctosECF') then
            vCOORef := ReadInteger('DemaisDoctosECF', 'COOREF', 0);
        end;

        inherited CancelaCupom;

        if vCOORef <> 0 then
        begin
          fErro := not SalvarDemaisDoctosECF(TCancelaCupom, vCOORef);
          if not FErro then
            FErro := not SalvarDadosECFLocal;

          if not ferro then
          begin
            try
              vGravandoCupomVinculado := true;
              ferro := not SalvarDadosCupom(TCancelaCupom);
              if not ferro then
                FErro := not SalvarFormasPagamentoECF(TCancelaCupom);

              if not ferro then
                FErro := not SalvarDadosECFLocal;
            finally
              vGravandoCupomVinculado := false;
            end;
          end;
        end
        else
        begin
          ferro := not SalvarDadosCupom(TCancelaCupom);
          if not ferro then
            FErro := not SalvarFormasPagamentoECF(TCancelaCupom);

          if not ferro then
            FErro := not SalvarDadosECFLocal;
        end;

      except
        on E: Exception do TrataErros(E)
      end;
    finally
      FreeAndNil(fArqIniDadosECF);
    end;
  end;

end;

