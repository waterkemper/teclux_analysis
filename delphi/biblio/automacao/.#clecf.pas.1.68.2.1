function TtecECF.ConverteAliquota(Valor: String): String;
var
  Tributo: String;
  idx, PosVirg: Integer;
begin
  Result := '00';
  Tributo := '';
  repeat
    PosVirg := Pos(',', Valor);
    Delete(Valor, PosVirg, 1);
  until PosVirg = 0;
  for idx := 1 to Length(Valor) do
    Tributo := Tributo + Valor[idx];
  if Length(Tributo) = 1 then
    Tributo := '0' + Tributo;
  for idx := Length(Tributo)+1 to 4 do
    Tributo := Tributo + '0';
  for idx := 0 to High(FAliquotas) do
    if FAliquotas[idx] = Tributo then begin
      Result := IntToStr(idx+1);
      Preencher(2, 0, '0', Result);
      Break;
    end
end;

function TtecECF.ConverteFormaPagto(Valor: String; IndInicial: Integer): String;
var
  a: Integer;
begin
  Result := '01';
{  for a := 0 to High(FFormasPagamento) do
    if UpperCase(FFormasPagamento[a]) = UpperCase(Trim(Valor)) then begin
      Result := IntToStr(a + IndInicial);
      Preencher(2, 0, '0', Result);
      Break;
    end
}
  for a := Low(FFormasPagamento) to High(FFormasPagamento) do
    if RetiraAcento(UpperCase(trim(FFormasPagamento[a].descricao))) = RetiraAcento(UpperCase(trim(Valor))) then
    begin
      Result := FFormasPagamento[a].Indice;
      Break;
    end;
end;

