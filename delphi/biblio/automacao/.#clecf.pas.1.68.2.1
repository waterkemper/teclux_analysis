      DetalhesReducaoZ[Length(DetalhesReducaoZ) - 1].ValorAcumulado         := AIni.ReadFloat('OutrasICMS','TotalNaoTributado', 0);

      // Substituição Tributária – ISSQN
      SetLength(DetalhesReducaoZ, Length(DetalhesReducaoZ) + 1);
      DetalhesReducaoZ[Length(DetalhesReducaoZ) - 1].TipoTotalizadorParcial := 'FS1';
      DetalhesReducaoZ[Length(DetalhesReducaoZ) - 1].aliquota               := 0.00;
      DetalhesReducaoZ[Length(DetalhesReducaoZ) - 1].ValorAcumulado         := 0.00;  {não esta presente}

      // Isento – ISSQN
      SetLength(DetalhesReducaoZ, Length(DetalhesReducaoZ) + 1);
      DetalhesReducaoZ[Length(DetalhesReducaoZ) - 1].TipoTotalizadorParcial := 'IS1';
      DetalhesReducaoZ[Length(DetalhesReducaoZ) - 1].aliquota               := 0.00;
      DetalhesReducaoZ[Length(DetalhesReducaoZ) - 1].ValorAcumulado         := 0.00 {não esta presente};

      // Não-incidência – ISSQN
      SetLength(DetalhesReducaoZ, Length(DetalhesReducaoZ) + 1);
      DetalhesReducaoZ[Length(DetalhesReducaoZ) - 1].TipoTotalizadorParcial := 'NS1';
      DetalhesReducaoZ[Length(DetalhesReducaoZ) - 1].aliquota               := 0.00;
      DetalhesReducaoZ[Length(DetalhesReducaoZ) - 1].ValorAcumulado         := 0.00 {não esta presente};

      //Operações Não Fiscais
      SetLength(DetalhesReducaoZ, Length(DetalhesReducaoZ) + 1);
      DetalhesReducaoZ[Length(DetalhesReducaoZ) - 1].TipoTotalizadorParcial := 'OPNF';
      DetalhesReducaoZ[Length(DetalhesReducaoZ) - 1].aliquota               := 0.00;
      DetalhesReducaoZ[Length(DetalhesReducaoZ) - 1].ValorAcumulado         := AIni.ReadFloat('Totalizadores','TotalNaoFiscal', 0);

      //Desconto – ICMS
      SetLength(DetalhesReducaoZ, Length(DetalhesReducaoZ) + 1);
