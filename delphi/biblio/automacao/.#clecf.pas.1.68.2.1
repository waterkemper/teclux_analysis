procedure TtecECF.RelatorioGerencial(Texto: TStringList);
var
  Lin   : Integer ;
  SL    : TStringList ;
begin
  VerificaInconsistenciaCCF;
  MaxLinhasBuffer := 3;
  try
    SL := TStringList.Create;
    for lin := 0 to texto.Count -1 do
    begin
      SL.Append(texto[lin]);
      if (((Lin mod 350) = 0) and (lin <> 0)) or (lin = texto.count -1)  then
      begin
        try
          inherited RelatorioGerencial(SL);
          FErro := not SalvarDemaisDoctosECF(TRelatorioGerencial);
        except
          on E: Exception do TrataErros(E)
        end;
        SL.Clear;
      end ;
    end;
  finally
    SL.Free;
  end;

end;

function TtecECF.GerarDadosReducaoZAnterior: TTecReducoesZ;
var
 i,j: integer;
 Sequencia : Byte;
 Indice    : String;
 Aliquota  : Double;
 valiquotaduplicada:Boolean;
 AIni : TMemIniFile ;
 AStringList : TStringList ;
 Resp  : String ;

 V1 : String;
begin

  ECFPadrao.DataHoraReducaoZ := ECFPadrao.DataHora;
  V1 := ecfpadrao.Data;
  Resp := ECFPadrao.DadosUltimaReducaoZ ;
  AStringList := TStringList.Create ;
  AIni := TMemIniFile.Create( 'DadosUltimaReducaoZ.ini' ) ;
  try
    AStringList.Text := Resp;
    AIni.SetStrings(AStringList);

    with result do
    begin
      Numerofabricacao := ECFPadrao.SerieMaquina;
      MFadicional      := ECFPadrao.MFAdicional;
      ModeloECF        := ECFPadrao.SubModelo;
      Numerousuario    := StrToInt(ECFPadrao.NumeroMaquina);
      CRZ              := AIni.ReadInteger('ECF','NumCRZ', 0);
      COO              := AIni.ReadInteger('ECF','NumCOO', 0);
      CRO              := AIni.ReadInteger('ECF','NumCRO', 0);
      Datamovimento    := AIni.ReadDateTime('ECF','DataMovimento', 0);
      Dataemissao      := ECFPadrao.DataHoraReducaoZ;
      Horaemissao      := ECFPadrao.DataHoraReducaoZ;
      VendaBrutaDiaria := AIni.ReadFloat('Totalizadores','VendaBruta', 0);
      ParametroincidenciaISSQN := ECFPadrao.IncidenciaDescontoISSQN;
      for i:=0 to Aliquotas.Count - 1 do
      begin
        valiquotaduplicada := false;
        for j:=0 to Length(DetalhesReducaoZ) -1 do
        begin
           if  DetalhesReducaoZ[j].aliquota = aliquotas[i].Aliquota then
           begin
              DetalhesReducaoZ[j].ValorAcumulado := DetalhesReducaoZ[j].ValorAcumulado + aliquotas[i].Total;
              valiquotaduplicada := true;
            end;
        end;

        if not valiquotaduplicada then
        begin
            SetLength(DetalhesReducaoZ, Length(DetalhesReducaoZ) + 1);

            if preencheString(SomenteNumero(Aliquotas[i].Indice),'0',2,False)='00' then
                DetalhesReducaoZ[Length(DetalhesReducaoZ) - 1].TipoTotalizadorParcial :=
                '01'+
                Aliquotas[i].Tipo +
                Trocar(FormatFloat('00.00',Aliquotas[i].Aliquota),',','')
             else
                DetalhesReducaoZ[Length(DetalhesReducaoZ) - 1].TipoTotalizadorParcial :=
                  preencheString(SomenteNumero(Aliquotas[i].Indice),'0',2,False) +
                  Aliquotas[i].Tipo +
                  Trocar(FormatFloat('00.00',Aliquotas[i].Aliquota),',','');

             DetalhesReducaoZ[Length(DetalhesReducaoZ) - 1].aliquota       := aliquotas[i].Aliquota;
             DetalhesReducaoZ[Length(DetalhesReducaoZ) - 1].ValorAcumulado :=
             AIni.ReadFloat('Aliquotas',DetalhesReducaoZ[Length(DetalhesReducaoZ) - 1].TipoTotalizadorParcial, 0);
        end;
      end;

      // Substituição Tributária – ICMS
      SetLength(DetalhesReducaoZ, Length(DetalhesReducaoZ) + 1);
      DetalhesReducaoZ[Length(DetalhesReducaoZ) - 1].TipoTotalizadorParcial := 'F1';
      DetalhesReducaoZ[Length(DetalhesReducaoZ) - 1].aliquota               := 0.00;
