  Valor, Obs: String);
var
  vRegistrador : string;
  vFormaPagto : string;
begin
  Ferro := false;
  VerificaInconsistenciaCCF;
  try
    vregistrador := registrador;
    Registrador := AchaCNFDescricao(Registrador).Indice;
  except
    FErro := true;
    FMensagem := 'identificador CNF '+vRegistrador+' não esta cadastrado'
