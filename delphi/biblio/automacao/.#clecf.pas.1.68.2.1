      formaPagto  := AchaFPGDescricao(FormadePagamentoConfigurada(FormaPagto)).Indice;
    except
      FErro := true;
      FMensagem := 'forma de pagamento '+vFormaPagto+' não esta cadastrada'
    end;
  end;

  if not ferro then
  begin
    try
      NaoFiscalCompleto(Registrador, StrToFloat(Valor), FormadePagamentoConfigurada(FormaPagto), Obs);
      Ferro := not SalvarDemaisDoctosECF(TNaoFiscalCompleto);
