procedure TtecECF.RelatorioGerencial(Texto: array of String; nvias: integer);
var
  Relatorio: TStringList;
  a: Integer;
  Lin   : Integer ;
  SL    : TStringList ;

begin
  VerificaInconsistenciaCCF;
  MaxLinhasBuffer := 3;

  SL := TStringList.Create;
  try
    for Lin:=Low(Texto) to high(Texto) do
    begin
      SL.Append(Texto[Lin]);
      if (((Lin mod 350) = 0) and (lin <> 0)) or (lin = high(Texto)) then
      begin
        try
          inherited RelatorioGerencial(SL, nvias);
          FErro := not SalvarDemaisDoctosECF(TRelatorioGerencial);
        except
          on E: Exception do TrataErros(E)
        end;
        SL.Clear;
      end ;
    end;
  finally
    SL.Free;
  end;
end;

