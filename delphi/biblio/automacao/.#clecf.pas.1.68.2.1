function TtecECF.AtivarECF(Arquivo, Porta, ECF_ini: String;Iniciando:Boolean=true): Boolean;
var
  ArqECF: TIniFile;
  ECF_Serie, ECF_Marca, ECF_Tipo, ECF_MF,
  ECF_Maquina, ECF_CNIEE, ECF_SubModelo,ECF_MINAS_LEGAL,ECF_CUPOM_MANIA,ECF_PARAIBA_LEGAL,ECF_NOTA_LEGAL_DF{,
  ECF_GT,
  ECF_CRO}: String;
  i,
  ECF_Modelo: Integer;
  ProcurarECF: Boolean;
begin
  Result := False;
  if (Porta <> '') then
  begin
    if FileExists(Arquivo) then
    begin
      if not Assigned(ECFPadrao) then
        ECFPadrao := TtecECF.Create(nil);
      if not ECFPadrao.Ativo then
      begin
        IF Porta='USB' then
          ECFPadrao.PortaSerial :=Porta
        else
          ECFPadrao.PortaSerial := 'COM'+Porta;
        if FVelocidadePorta<>'' then
          ECFPadrao.Device.Baud:= strtoint(FVelocidadePorta);
{        else
          ECFPadrao.Device.Baud:= 9600;}

      end;
      ArqECF := TIniFile.Create(Arquivo);
      try
        i := 1;
        ProcurarECF := ECF_ini = '';
        repeat
          ECFPadrao.Codigo := IntToStr(i);
          if ArqECF.SectionExists(ECFPadrao.Codigo) then
          begin
            ECF_Modelo  := ArqECF.ReadInteger(ECFPadrao.Codigo,'modelo' , -1);
            ECF_Serie   := ArqECF.ReadString(ECFPadrao.Codigo, 'serie'  , '');
            ECF_Maquina := ArqECF.ReadString(ECFPadrao.Codigo, 'maquina', '');
            ECF_Marca   := ArqECF.ReadString(ECFPadrao.Codigo, 'marca', '');
            ECF_Tipo    := ArqECF.ReadString(ECFPadrao.Codigo, 'tipo', '');
            ECF_MF      := ArqECF.ReadString(ECFPadrao.Codigo, 'MF', '');
            ECF_CNIEE   := ArqECF.ReadString(ECFPadrao.Codigo, 'CNIEE', '');
            ECF_SubModelo := ArqECF.ReadString(ECFPadrao.Codigo, 'SubModelo', '');
            ECF_MINAS_LEGAL :=ArqECF.ReadString(ECFPadrao.Codigo, 'MinasLegal','false');
            ECF_CUPOM_MANIA :=ArqECF.ReadString(ECFPadrao.Codigo, 'CupomMania','false');
            ECF_PARAIBA_LEGAL :=ArqECF.ReadString(ECFPadrao.Codigo, 'ParaibaLegal','false');
            ECF_NOTA_LEGAL_DF :=ArqECF.ReadString(ECFPadrao.Codigo, 'NotaLegalDF','false');

{            ECF_GT      := ArqECF.ReadString(ECF_Codigo, 'gt'     , '');
            ECF_CRO     := ArqECF.ReadString(ECF_Codigo, 'cro'    , '');
}

            if (ProcurarECF) or
               (not ProcurarECF and (ECF_ini = ECFPadrao.Codigo)) then
            begin
              try
                if ECFPadrao.Ativo then
                  ECFPadrao.Desativar;

                ECFPadrao.ModeloInt := ECF_Modelo;
                ECFPadrao.ReTentar := False;

                if FVelocidadePorta<>'' then
                  ECFPadrao.Device.Baud:= strtoint(FVelocidadePorta);
{                else
                  ECFPadrao.Device.Baud:= 9600;}

                ECFPadrao.Ativar;
                ECFPadrao.ReTentar := True;
                Result := ECF_Serie = Criptografar(ECFPadrao.SerieMaquina);
                if not Result then
                begin
                  ECFPadrao.Desativar;
                  ProcurarECF := True;
                end;
              except
                if not ProcurarECF then    // CASO DEFINIDO NO INI E NAO ATIVOU
                  i := 0;                  // VOLTA AO INICIO DO ARQUIVO,
                ProcurarECF := not Result; // ATIVANDO A PROCURA PELO ECF CONECTADO
              end;
            end;
          end;
          if (i = ctLimiteECFs) and not ProcurarECF then
          begin
            ProcurarECF := not ProcurarECF;
            i := 0;
          end;
          Inc(i);
        until ((i = ctLimiteECFs) and ProcurarECF) or Result;
      finally
        ArqECF.Free;
      end;
    end
    else
      MensagemAviso('Arquivo de configuração "'+ Arquivo +'" não existe!');
  end
  else
    MensagemAviso('Porta de acesso ao ECF não configurada!');;
  if Result then
  begin
    ECFPadrao.SerieConfigurada  := Descriptografar(ECF_Serie);
    ECFPadrao.NumeroConfigurado := Descriptografar(ECF_Maquina);
    ECFPadrao.marca             := Descriptografar(ECF_Marca);
    ECFPadrao.tipo              := Descriptografar(ECF_Tipo);
    ECFPadrao.MFAdicional       := Descriptografar(ECF_MF);
    ECFPadrao.CNIEE             := Descriptografar(ECF_CNIEE);
    ECFPadrao.SubModelo         := Descriptografar(ECF_SubModelo);
    ECFPadrao.InfoRodapeCupom.MinasLegal:=ECF_MINAS_LEGAL='547061F4';
    ECFPadrao.InfoRodapeCupom.CupomMania:=ECF_CUPOM_MANIA='547061F4';
    ECFPadrao.InfoRodapeCupom.ParaibaLegal:=ECF_PARAIBA_LEGAL='547061F4';
    ECFPadrao.InfoRodapeCupom.NotaLegalDF.Imprimir:=ECF_NOTA_LEGAL_DF='547061F4';
    ECFPadrao.OnAntesCancelaCupom := AntesCancelaCupom;
    ECFPadrao.OnDepoisCancelaCupom := DepoisCancelaCupom;
  end
  else
  begin
   if Assigned(ECFPadrao) then
   begin
     if Iniciando then
     begin
       ECFPadrao.FinalizarImpressora;
       FreeAndNil(ECFPadrao);
     end;
   end;
   MensagemAviso('Não foi possível ativar o ECF!');
  end;

  if result then
  begin

    qryMeiosdePagamentoECF := TtecQuery.Create(nil);
    qryMeiosdePagamentoECF.Database := parsistema.Database;
    qryMeiosdePagamentoECF.sql.text := format(' Select mpe.*, mp.descricao as descricaomeiodepagamento '+
                                              ' from meiosdepagamentoecf mpe '+
                                              ' join meiosdepagamento mp '+
                                              ' on mpe.meiodepagamento = mp.codigo '+
                                              ' where ecf = %s', [ECF_ini]);
    qryMeiosdePagamentoECF.Open;

  end;
end;

function TtecECF.VerificarGT(Arquivo: String;Iniciando:Boolean=true): Boolean;
var
  ArqECF: TIniFile;
  gt, gtarq: String;
  cro, croarq: Integer;
  teste : string;

begin
  Result := true; 
//  teste := Criptografar(FloatToStr(150));
{
  Result := False;
  ArqECF := TIniFile.Create(Arquivo);
  try
    if ArqECF.SectionExists(Codigo) then
    begin
      gt := FloatToStr(TotalizadorGeral);
      gtarq := Descriptografar(ArqECF.ReadString(Codigo, 'gt', '0'));
      Result := gt = gtarq;  // COMPARA O GT DO ECF COM O DO ARQUIVO
      if not Result then  // CASO SEJA DIFERENTE
      begin
        cro := strToInt(Intervencao);
        croarq := StrToInt(Descriptografar(ArqECF.ReadString(Codigo, 'cro', '0')));
        if cro > croarq then
        begin  // VERIFICA SE HOUVE INCREMENTO DO CRO(INTERVENCAO TECNICA) E ATUALIZA O ARQUIVO
          ArqECF.WriteString(Codigo, 'gt', Criptografar(FloatToStr(TotalizadorGeral)));
          ArqECF.WriteString(Codigo, 'cro', Criptografar(FloatToStr(cro)));
          ArqECF.UpdateFile;
          Result := True;
        end;
      end;
    end;
  finally
    ArqECF.Free
  end;
  if not Result and Assigned(ECFPadrao) then
  begin
    if Iniciando then
    begin
      ECFPadrao.FinalizarImpressora;
      FreeAndNil(ECFPadrao);
    end;
    MensagemAviso('Não foi possível ativar o ECF!' + sLineBreak +
                  'O valor do GT não confere e não houve incremento do CRO!');
  end;
 }
end;


