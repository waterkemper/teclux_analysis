  paisTomador (integer, optional): Código pais Banco central ,
razaoSocialTomador (string): Razao social Tomador stringMax. Length:60,
  telefoneTomador (integer, optional): Telefone tomador ,
  ufTomador (string, optional): Unidade Federativa Tomador stringMin. Length:2Max. Length:2,

}

  end;

end;

constructor TTecNotaFiscalEletronica.Create({AOwner: TComponent;} DataBase: TtecDatabase = nil);
{
var
 i : integer;
 cfg: TOAuth2Config;
 }
begin
{  inherited create(AOwner);}




  if assigned(DataBase) then
    CriarListaErro(DataBase);

  self.pDataBase := DataBase;

  self.DiretorioEnvio       := fNFeDirEnvio;
  self.DiretorioEnviado     := fNFeDirEnviados;
  self.DiretorioRetorno     := fNFeDirRetorno;
  self.DiretorioCompartilha := fNfeDirCompartilha;
  self.DiretorioErros       := fNfeDirErros;

  self.DiretorioEnvioNFSe    := fNFSeDirEnvio;
  self.DiretorioRetornoNFSe  := fNFSeDirRetorno;
  self.DiretorioErroNFSe     := fNFSeDirErro;

  self.Executavel           := fNFeExecNFe;

  self.SituacaoImpressaoDanfe := Nenhuma;

  {
  self.objHTTP := TIdHTTP.Create;
  self.objHTTP.Request.UserAgent := 'Mozilla/3.0 (compatible; POAuth2)';
  self.FClient := TIndyHttpClient.Create(self.objHTTP);
  cfg.TokenEndPoint := furlauth_nfse;
  self.FOAuthClient := TOAuth2Client.Create(cfg, self.FClient);
  }
  self.ExibirMsgNfe := true;
  {
  self.FSendStream := TMemoryStream.Create;
  self.FReceiveStream := TMemoryStream.Create;
  self.FIdLog := TIdLogStream.Create(nil);
  self.FIdLog.SendStream := FSendStream;
  self.FIdLog.ReceiveStream := FReceiveStream;
  self.FIdLog.FreeStreams := false;
  self.objHTTP.Intercept := FIdLog;
  self.FIdLog.Active := true;

  }


end;

function TTecNotaFiscalEletronica.ValorRetornoXML_DentroTag(ArqRetorno,
  TagSuperior, Tag: String): String;
var
  Linha,
  Conteudo: String;
  PosI_Superior,PosI, PosF: Integer;
  Arq: TextFile;
begin
  Result := '';
  try
    CopiaTemporaria(FDirRetorno,ArqRetorno);
    AssignFile(Arq, FDirRetorno+nfe_temp);
    FileMode := 0;
    Reset(Arq);
    repeat
      Readln(Arq, Linha);
      Conteudo := Conteudo + Linha;
    until Eof(Arq);
    CloseFile(Arq);
    DeleteFile(FDirRetorno+nfe_temp)
  except
    on E: Exception do MensagemAviso_(E.Message + ' ErroLeituraRetornoXML!'+
                                     sLineBreak + ArqRetorno, false, ExibirMsgNFe)
  end;
  PosI_Superior   := Pos('<'+TagSuperior ,Conteudo)+Length(TagSuperior)+1;

  PosI := PosEx('<'+Tag+'>',Conteudo,PosI_Superior)+Length(Tag)+2;
  PosF := PosEx('</'+Tag+'>',Conteudo,PosI_Superior);
  if(PosI_Superior=Length(TagSuperior)+1) then //tag nao encontrada
    Result:=''
  else
    Result := Copy(Conteudo,PosI,PosF-PosI)

end;

function TTecNotaFiscalEletronica.GerarCartaCorrecao(Nfe, Sequencia, Texto,Orgao,Ambiente,Cnpj: String;Codigo: Integer;var Protocolo,DataHoraProcessamento: String): Boolean;
var
  Linha,
  MsgErro,
  ArqEnvio,
  ArqRetorno,
  ArqErro,
  Status,
  Motivo,
  XCondUso: String;
  ArqResp: TextFile;

  XMLDocument: IXMLDocument;

begin

  ArqEnvio   := FDirEnvio   + NFe + '-' + Sequencia + '-env-cce.xml';
  ArqRetorno := FDirRetorno + NFe + '-' + Sequencia + '-ret-env-cce.xml';
  ArqErro    := FDirRetorno + NFe + '-' + Sequencia + '-ret-env-cce.err';
  try

//    ShowProcessando;
//    MensagemAviso_('Iniciando envio da Carta de Correção da NF-e!'+chr(13)+FDirEnvio+nfe_temp+CHR(13)+ArqEnvio);

    if FileExists(ArqEnvio) then
      DeleteFile(ArqEnvio);
    if FileExists(ArqErro) then
      DeleteFile(ArqErro);

    //GERA O ARQUIVO DA CARTA
    AssignFile(xml, FDirEnvio+nfe_temp);
    Rewrite(xml);
    Write(xml, '<?xml version="1.0" encoding="UTF-8"?>');
    AbreTag('envEvento', ['versao','xmlns'],
                       ['1.00',
                        'http://www.portalfiscal.inf.br/nfe']);
    TagCompleta('idLote',IntToStr(Codigo));
    AbreTag('evento', ['versao','xmlns'],
                       ['1.00',
                        'http://www.portalfiscal.inf.br/nfe']);
    AbreTag('infEvento', ['Id'],
                       ['ID110110'+Nfe+preencheString(Sequencia,'0',2,false)]);
    TagCompleta('cOrgao',Orgao);
    TagCompleta('tpAmb',Ambiente);
    TagCompleta('CNPJ',Cnpj);
    TagCompleta('chNFe', NFe);
//    DataHoraProcessamento:=trim(formatdatetime('YYYY-MM-DD',now))+ 'T'+ trim(formatdatetime('HH:MM:SS',incminute(now, -60)))+'-03:00';
    TagCompleta('dhEvento',DataHoraProcessamento);
    TagCompleta('tpEvento','110110');
    TagCompleta('nSeqEvento',Sequencia);
    TagCompleta('verEvento','1.00');
    AbreTag('detEvento',['versao'],['1.00']);
    TagCompleta('descEvento','Carta de Correcao',false,false);
    TagCompleta('xCorrecao',Texto,false,false);

    XCondUso:='A Carta de Correcao e disciplinada pelo paragrafo 1o-A do art. 7o do Convenio S/N, de 15 de dezembro de 1970 e pode ser utilizada ';
    XCondUso:=XCondUso+'para regularizacao de erro ocorrido na emissao de documento fiscal, desde que o erro nao esteja relacionado com: ';
    XCondUso:=XCondUso+'I - as variaveis que determinam o valor do imposto tais como: base de calculo, aliquota, diferenca de preco, quantidade, valor da operacao ou ';
    XCondUso:=XCondUso+'da prestacao; II - a correcao de dados cadastrais que implique mudanca do remetente ou do destinatario; III - a data de emissao ou de saida.';
//    Write(xml,'<xCondUso>' + trim(xCondUso) + '</xCondUso>');
    TagCompleta('xCondUso',XCondUso,false,false);
    FechaTag('detEvento');
    FechaTag('infEvento');
    FechaTag('evento');
    FechaTag('envEvento');
    CloseFile(xml);

    {
    if not fileexists(FDirEnvio+nfe_temp) then
      mensagemerro(FDirEnvio+nfe_temp + ' não gravado')
    else
    begin
      ShowProcessando;
      MensagemAviso_('Arquivo '+FDirEnvio+nfe_temp + ' existente' +CHR(13)+'a renomear' + ArqEnvio);
    end;


    ShowProcessando('Esperando retorno do  envio da Carta de Correção da NF-e! Origem: '+chr(13)+
                   FDirEnvio+nfe_temp + chr(13)+
                   ' Destino '+ArqEnvio) ;

    IniciarTempo(vTempoInicial);
    }

    RenameFile(FDirEnvio+nfe_temp,ArqEnvio);

    repeat until FileExists(ArqRetorno) or  FileExists(ArqErro);


  except
    on E: Exception do MensagemAviso_(E.Message + 'CartaCorrecaoNFe!' +
                                     sLineBreak + ArqEnvio, false, ExibirMsgNFe)
  end;

  {
  if TempoEsgotado(vTempoInicial) then
  begin
    mensagemerro('A tentativa de renomear o arquivo: '+FDirEnvio+nfe_temp+' para o destino '+ArqEnvio+' falhou');
    result := false;
  end
  else
  begin
    result := true;
    }


    if not (FileExists(ArqRetorno) or FileExists(ArqErro)) then
    begin
      result := false;
      MensagemAviso_('Arquivo de retorno inexistente', false, ExibirMsgNFe);
    end;


{  end;

  if result then
  begin
  }

    Sleep(delay);
    Result := FileExists(ArqRetorno);

    if not Result then  // Exibe msg erro com o conteudo do arquivo de erro
    begin
      try
        CopiaTemporaria(FDirRetorno,ArqErro);
        AssignFile(ArqResp,FDirRetorno+nfe_temp);
        FileMode := 0;
        Reset(ArqResp);
        MsgErro := '';
        while not Eof(ArqResp) do
        begin
          Readln(ArqResp, Linha);
          MsgErro := MsgErro + Linha + sLineBreak
        end;
        CloseFile(ArqResp);
        DeleteFile(FDirRetorno+nfe_temp);
      except
        on E: Exception do MensagemAviso_(E.Message + 'RetornoCartaCorrecaoNFe!' +
                                         sLineBreak + ArqErro, false, ExibirMsgNFe)
      end;
      MensagemErro_(MsgErro, ExibirMsgNFe, ArqErro)
    end
    else  // busca o numero do procolo de cancelamento
    begin
      try

      XMLDocument := TXmlDocument.Create(ArqRetorno);
      XMLDocument.Active := true;

      if XMLDocument.DocumentElement.ChildNodes.FindNode('retEvento')
                                    .ChildNodes.FindNode('infEvento')<> nil then
      begin
        with XMLDocument.DocumentElement.ChildNodes.FindNode('retEvento')
                                    .ChildNodes.FindNode('infEvento') do
        begin

          Status := ChildNodes.FindNode('cStat').Text;
          Motivo := ChildNodes.FindNode('xMotivo').Text;

          if ChildNodes.FindNode('nProt') <> nil then
            Protocolo := ChildNodes.FindNode('nProt').Text;

        end;

      end;

//      Protocolo := ValorRetornoXML(ArqRetorno, 'nProt', Status, Motivo, ExibirMsgNFe);
      Result := Protocolo <> '';
      if not Result then
      begin

        MsgErro := 'Erro na captura do protocolo da carta de correção!';
        if (Status <> '') and (Motivo <> '') then
          MsgErro := MsgErro + sLineBreak + 'Status: ' + Status + ' - ' + Motivo;

        MensagemErro_(MsgErro, ExibirMsgNFe, ArqRetorno)

      end
      else
        result := CompartilharXMLCartaCorrecao(nfe,preencheString(Sequencia,'0',2,false));

      finally
//        XMLDocument.free;
      end;
    end;
{  end;}
end;

function TTecNotaFiscalEletronica.CompartilharXMLCartaCorrecao(Nfe,Sequencia: String): Boolean;
var
  Dir,
  CaminhoNFe, vArquivo: String;
begin
  Result := True;

  vArquivo := '\' + NFe + '_' + Sequencia + '-procEventoNFe.xml';
  CaminhoNFe := FDirEnviado + FormatDateTime('yyyymm',now) + vArquivo ;


  if not DirectoryExists(FDirCompartilha) then
  begin
    if not CreateDir(FDirCompartilha) then
    begin
      result := false;
      raise Exception.Create('Impossível criar o diretório ' + FDirCompartilha);
    end;
  end;

  Dir := FDirCompartilha+FormatDateTime('yyyy',now);
  if not DirectoryExists(Dir) then
  begin
    if not CreateDir(Dir) then
    begin
      result := false;
      raise Exception.Create('Impossível criar o diretório ' + Dir);
    end;
  end;

  Dir := Dir + '\' + FormatDateTime('mm',now);
  if not DirectoryExists(Dir) then
  begin
    if not CreateDir(Dir) then
    begin
      result := false;
      raise Exception.Create('Impossível criar o diretório ' + Dir);
    end;
  end;

  Dir := Dir + '\' + FormatDateTime('dd',now);
  if not DirectoryExists(Dir) then
  begin
    if not CreateDir(Dir) then
    begin
      result := false;
      raise Exception.Create('Impossível criar o diretório ' + Dir);
    end;
  end;

  try


    if FileExists(dir + vArquivo) then
      DeleteFile(dir + vArquivo);

    Sleep(delay);

    if FileExists(CaminhoNFe) then
      CopyFileTo(CaminhoNFe,dir + vArquivo)

  except
    on E: Exception do
    begin
      result := false;
      MensagemAviso_(E.Message + 'Erro compartilhando arquivo da Carta de Correção da NFe.' +
                                       sLineBreak + CaminhoNFe, false, ExibirMsgNFe);
    end;
  end;

  if result then
  begin
    NomedoArquivoCompartilhado := dir + vArquivo;
    GerarPDFCartaCorrecao(NomedoArquivoCompartilhado);
  end
  else
    NomedoArquivoCompartilhado := '';

end;

function TTecNotaFiscalEletronica.ImprimirCartaCorrecao(ChaveNota, Sequencia, EmailDestinatario, NumVias, Logo, Impressora,Filial,Serie,Numero: String; Visualizar: Boolean; Emissao,EmissaoNota: TDateTime; Executavel: String;
          DataBase: TTecDataBase): Boolean;

var
  Caminho, CaminhoNota,
  Processo, Dir: String;
  vxmlnfe : tStringList;
  qryxmlnfe : TTecQuery;

  Function Buscarxmlnfecc: TMemoField;
  begin
    qryxmlnfe := TTecQuery.create(nil);
    qryxmlnfe.Database := DataBase;

      qryxmlnfe.Sql.text := 'select cc.xmlnfecc from cartas_correcao cc where cc.codigo = '+
                            '(select max(cc.codigo) from cartas_correcao cc where cc.chv_nfe = '+ quotedstr(ChaveNota) + ')';

    qryxmlnfe.open;
    result := TMemoField(qryxmlnfe.fields[0]);
  end;

  Function Buscarxmlnfe: TMemoField;
  begin
    qryxmlnfe := TTecQuery.create(nil);
    qryxmlnfe.Database := DataBase;
      qryxmlnfe.Sql.text := 'select df.xmlnfe from dadosfiscais df where df.numero = '+
                            '(select n.dadofiscal from notas n where n.filial = '+filial+' and n.Serie = '+quotedstr(serie)+' and n.numero ='+numero+')';
    qryxmlnfe.open;

    if qryxmlnfe.recordcount = 1 then
      result := TMemoField(qryxmlnfe.fields[0])
    else
    begin
      qryxmlnfe.Sql.text := 'select np.xmlnfe from notaspag np where coalesce(np.permitirimprimir,false) and np.filial = '+filial+' and np.Serie = '+quotedstr(serie)+' and np.numero ='+numero;
      qryxmlnfe.open;
      result := TMemoField(qryxmlnfe.fields[0]);
    end;
  end;


begin
//  42120979863213000105550040000292461912240697_01-procEventoNFe.xml
  Caminho := FDirCompartilha + FormatDateTime('yyyy',Emissao)  + '\' +
                               FormatDateTime('mm'  ,Emissao)  + '\' +
                               FormatDateTime('dd'  ,Emissao)  + '\' +
                               ChaveNota                       + '_' +
                               Sequencia                       + '-procEventoNFe.xml';

  result := FileExists(Caminho);
  if NOT result then
  begin
    vxmlnfe := tStringList.create;
    vxmlnfe.Assign(Buscarxmlnfecc);

    if vxmlnfe.Count <> 0 then
    begin

      if not DirectoryExists(FDirCompartilha) then
        if not CreateDir(FDirCompartilha) then
        begin
          result := false;
          raise Exception.Create('Impossível criar o diretório ' + FDirCompartilha);
        end;

      Dir := FDirCompartilha+FormatDateTime('yyyy',Emissao);
      if not DirectoryExists(Dir) then
        if not CreateDir(Dir) then
        begin
          result := false;
          raise Exception.Create('Impossível criar o diretório ' + Dir);
        end;

      Dir := Dir + '\' + FormatDateTime('mm',Emissao);
      if not DirectoryExists(Dir) then
        if not CreateDir(Dir) then
        begin
          result := false;
          raise Exception.Create('Impossível criar o diretório ' + Dir);
        end;

      Dir := Dir + '\' + FormatDateTime('dd',Emissao);
      if not DirectoryExists(Dir) then
        if not CreateDir(Dir) then
        begin
          result := false;
          raise Exception.Create('Impossível criar o diretório ' + Dir);
        end;

      vxmlnfe.SaveToFile(Caminho);
      result := true;
    end;
    qryxmlnfe.free;
    vxmlnfe.free;

  end;

  if result then
  begin
    CaminhoNota := FDirCompartilha + FormatDateTime('yyyy',EmissaoNota)  + '\' +
                                     FormatDateTime('mm'  ,EmissaoNota)  + '\' +
                                     FormatDateTime('dd'  ,EmissaoNota)  + '\nfeProc' +
                                     preencheString(Filial,'0',2,False) +
                                     preencheString(Serie, '0',2,False) +
                                     preencheString(Numero,'0',9,False)+'.xml';

    result := FileExists(CaminhoNota);
    if result then
    begin
      if ValorRetornoXML(CaminhoNota, 'NFe', ExibirMsgNFe)='' then
      begin
        result := false;
        MensagemErro('O conteúdo da NFe '+CaminhoNota + ' este incoerente com o esperado.'+chr(13)+
                     'A tag ''NFe'' não foi encontrada.');
      end;
    end
    else
    begin
      vxmlnfe := tStringList.create;
      vxmlnfe.Assign(Buscarxmlnfe);

      if vxmlnfe.Count <> 0 then
      begin

        if not DirectoryExists(FDirCompartilha) then
          if not CreateDir(FDirCompartilha) then
          begin
            result := false;
            raise Exception.Create('Impossível criar o diretório ' + FDirCompartilha);
          end;

        Dir := FDirCompartilha+FormatDateTime('yyyy',EmissaoNota);
        if not DirectoryExists(Dir) then
          if not CreateDir(Dir) then
          begin
            result := false;
            raise Exception.Create('Impossível criar o diretório ' + Dir);
          end;

        Dir := Dir + '\' + FormatDateTime('mm',EmissaoNota);
        if not DirectoryExists(Dir) then
          if not CreateDir(Dir) then
          begin
            result := false;
            raise Exception.Create('Impossível criar o diretório ' + Dir);
          end;

        Dir := Dir + '\' + FormatDateTime('dd',EmissaoNota);
        if not DirectoryExists(Dir) then
          if not CreateDir(Dir) then
          begin
            result := false;
            raise Exception.Create('Impossível criar o diretório ' + Dir);
          end;

        vxmlnfe.SaveToFile(CaminhoNota);
        result := true;
      end;
      qryxmlnfe.free;
      vxmlnfe.free;

    end;
  end;

  if result then
  begin
    Processo := ' Copias=' + NumVias + ' Tipo=cce ';
    if Trim(Impressora) <> '' then
      Processo := Processo + ' Impressora="' + Impressora + '"';
    if Visualizar then
      Processo := Processo + ' Visualizar=1';

    Result := CreateProcessSimple(Executavel + ' arquivo=' + '"'+Caminho+'"' + ' NFe=' + '"' + CaminhoNota + '" '  + Processo)
  end;

end;

function TTecNotaFiscalEletronica.EnviarEmailCarta(origem, Destino, NrNota, Serie, Filial,
                              NomeFilial, RazaoFilial, CNPJFilial, DDDFilial, FoneFilial,
                              DDDFaxFilial, FaxFilial, NomeUsuario, PortaSMTP, HostSMTP,
                              Usuario, Senha,ChaveNota,Sequencia: String; DataEmissao: TDateTime;
                              AutenticarSmtp: Boolean): Boolean;
var
  vAssunto : String;

  function MontarEmail: TStringList;
  var
  html : TStringList;
  begin
    Html:= TStringList.Create;
    with html do
    begin
      Append('<HTML>');
      Append('<HEAD>');
      Append('<TITLE> NFe ' + FormatarNroNFe(NrNota) + ' - ' + NomeFilial + '</TITLE>');
      Append('<META NAME="Author" CONTENT="tecSOFT-tecLUX">');
      Append('</HEAD>');
      Append('<BODY>');
      Append('<b>Seguem dados da Carta de correção da NFe anexa:</b>');
      Append('<br>');
      Append('<table border="1" width="736" height="212">');
      Append('<tr>');
      Append('<td width="175" height="26"><b>Número da NF</b></td>');
      Append('<td width="561" height="26">' +FormatarNroNFe(NrNota) + '</td>');
      Append('</tr>');
      Append('<tr>');
      Append('<td width="175" height="26"><b>Série</b></td>');
      Append('<td width="561" height="26">' + preencheString(Serie,'0',3,False) + '</td>');
      Append('</tr>');
      Append('<tr>');
      Append('<td width="175" height="26"><b>Razão Social</b></td>');
      Append('<td width="561" height="26">' + RazaoFilial + '</td>');
      Append('</tr>');
      Append('<tr>');
      Append('<td width="175" height="26"><b>CNPJ/CPF</b></td>');
      Append('<td width="561" height="26">' + CNPJFilial + '</td>');
      Append('</tr>');
      Append('<tr>');
      Append('<td width="175" height="26"><b>Telefone</b></td>');
      Append('<td width="561" height="26">' + FormatarFone(DDDFilial,FoneFilial) + '</td>');
      Append('</tr>');
      Append('<tr>');
      Append('<td width="175" height="26"><b>Data da Emissão</b></td>');
      Append('<td width="561" height="26">' + FormatDateTime('dd/mm/yyyy',DataEmissao) + '</td>');
      Append('</tr>');
      Append('<tr>');
      Append('<td width="175" height="26"><b>Emitente</b></td>');
      Append('<td width="561" height="26">' + RazaoFilial + '</td>');
      Append('</tr>');
      Append('</table>');
      Append('<br>');
      {Append('<b>Att.</b>');
      Append('<br>');
      Append('<br>');
      retirado para gama
      Append(NomeUsuario+'<br>');}
      Append(NomeFilial+'<br>');
      Append(FormatarFone(DDDFilial, FoneFilial)+'<br>');
      Append(FormatarFone(DDDFaxFilial, FaxFilial)+'<br>');
      Append('<br>');
      Append(Parsistema.Textos_finais_nas_NFs_cartas_e_boletos_anexados_via_email.text);
      {Append(LowerCase(origem)+'<br>');}

      Append('</BODY>');
      Append('</HTML>')
    end;
    Result := html
  end;

var
  smtp: TIdSMTP;
  MsgEmail: TIdMessage;
  anex: TIdAttachment;
  Html, Texto: TIdText;
  anexo, vanexoGerado: String;
  vListaAnexos : tStringList;
begin
  Result := False;
  Anexo  := FDirCompartilha + FormatDateTime('yyyy', DataEmissao)  + '\' +
                               FormatDateTime('mm'  ,DataEmissao)  + '\' +
                               FormatDateTime('dd'  ,DataEmissao)  + '\' +
                               ChaveNota                       + '_' +
                               Sequencia                       + '-procEventoNFe.xml';


  if not fileExists(Anexo) then
    result := false
  else
    result := true;

  if not result then
    MensagemAviso_(format('Carta de correção da Nfe  ''%s'' não econtrada',[Anexo]), false, ExibirMsgNFe);

  if result then
  begin
    vAnexoGerado := GerarPDFCartaCorrecao(anexo);

    vListaAnexos := TStringList.create;
    
    if FileExists(vAnexoGerado+'.xml') then
      vListaAnexos.Append(vAnexoGerado+'.xml');

    if FileExists(vAnexoGerado+'.pdf') then
      vListaAnexos.Append(vAnexoGerado+'.pdf');

    vAssunto := 'Envio da Carta de Correcao de NFe(xml) - Emitente: ' + NomeFilial +
                                     ' - N.Doc: ' + FormatarNroNFe(NrNota) +
                                     ' - Série: ' + preencheString(Serie,'0',3,False);

    result := EnviarEmail_(HostSMTP, Usuario, senha, PortaSMTP,
             origem, Destino, vAssunto, MontarEmail.text, RazaoFilial,
             usuariologin.smtprequerssl, vListaAnexos);

  end;
end;




function TTecNotaFiscalEletronica.GetExecutavels: String;
begin
  Result := fExecutavels
end;

procedure TTecNotaFiscalEletronica.SetExecutavels(const Value: String);
begin
  fExecutavels := Value;
  fProcessos := copy(fExecutavels, LastDelimiter('\',fExecutavels)+1,Length(fExecutavels));
  fDiretorioExecs := copy(fExecutavels,1, LastDelimiter('\',fExecutavels));
  if not ProcessoExiste(fProcessos) then
  begin
    ExecutarProcesso(fExecutavels,'', fDiretorioExecs, 0);
    Sleep(delay);
  end;


end;

function TTecNotaFiscalEletronica.GetDiretorioEnvioNFSe: String;
begin
  Result := FDirEnvioNFSe
