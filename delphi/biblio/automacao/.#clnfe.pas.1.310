procedure TTecNotaFiscalEletronica.CriarListaErro(DataBase: TtecDatabase);
begin
  if not assigned(qryListaErros) then
  begin
    qryListaErros := TTecQuery.Create(nil);
    qryListaErros.Database := DataBase;
    qryListaErros.RequestLive := true;
    qrylistaerros.CachedUpdates := true;
    qryListaErros.Sql.Text := sqlErros;
    qryListaErros.Open;
    qrylistaerros.FieldByName('localizacao').DisplayWidth := 35;
    qrylistaerros.FieldByName('localizacao').DisplayLabel := 'LOCALIZAÇÃO';

    qrylistaerros.FieldByName('camponfe').DisplayWidth := 15;
    qrylistaerros.FieldByName('camponfe').DisplayLabel := 'CAMPO NFE';

    qrylistaerros.FieldByName('descricaocamponfe').DisplayWidth := 25;
    qrylistaerros.FieldByName('descricaocamponfe').DisplayLabel := 'DESCRIÇÃO';

    qrylistaerros.FieldByName('valorCamponfe').DisplayWidth := 20;
    qrylistaerros.FieldByName('valorCamponfe').DisplayLabel := 'VALOR';

    qrylistaerros.FieldByName('descricaoerro').DisplayWidth := 40;
    qrylistaerros.FieldByName('descricaoerro').DisplayLabel := 'DESCRIÇÃO DO ERRO';

    qrylistaErros.Delete;
  end;

  LimparTabela(qrylistaErros);

end;

function nfe_temp: String;
begin
  result := 'nfe_'+inttostr(PIDOriginal)+'.tmp'; // ARQUIVO TEMPORARIO PARA LEITURA
end;

function TTecNotaFiscalEletronica.Getnfse_temp: String;
begin
  result := 'nfse_'+inttostr(PIDOriginal)+'.tmp'; // ARQUIVO TEMPORARIO PARA LEITURA
end;

    {
procedure TTecNotaFiscalEletronica.IniciarTempo(vTempoInicial);
begin
  vTempoInicial := Ticks64;
end;
}


{
function TTecNotaFiscalEletronica.TempoEsgotado(vTempoInicial)(TempoLImite: DWORD = 15000): boolean;
  function TempoAtual : DWORD;
  begin
    result := Ticks64;
  end;
begin
  if  (TempoAtual >= vTempoInicial) and ((TempoAtual - vTempoInicial) < TempoLImite) then
    result := false
  else
    result := true;
end;
}


function TTecNotaFiscalEletronica.GetDiretorioErros: String;
begin
  result := FDirErros;
end;

