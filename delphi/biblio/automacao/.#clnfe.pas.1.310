function MensagemAviso_(const Msg: WideString; BloquearTeclado: Boolean = false; ExibirMsgNFe: boolean = false): TMessageButton;
function MensagemErro_(const Msg: WideString; ExibirMsgNFe: boolean = false; CaminhoArquivo: String = ''): TMessageButton;

function ValorRetornoXML(ArqRetorno, Tag: String; ExibirMsgNFe: boolean): String; overload;
function  ValorRetornoXML(ArqRetorno, Tag: String;
                            var Status, Motivo: String; ExibirMsgNFe: boolean): String; overload;

function nfe_temp: String;
procedure CopiaTemporaria(Diretorio, Arquivo: String);

function DistribuicaoDFe(AOwner: TComponent; qryTabelaProcessamento: ttecquery;
         var vMsg: String;
         var vPararProcessamento: boolean;
         var pPassosDistribuicao: TTecPassosDistribuicao;
         qryFiliais: ttecquery;
         AchNFe: String = '';
         tipo: String = 'NFE'): Boolean;

function DistribuicaoDFeCienciaOPeracao(AOwner: TComponent; qryNSU: ttecquery;
         var vMsg: String;
         var vPararProcessamento: boolean;
         var pPassosDistribuicao: TTecPassosDistribuicao;
         qryFiliais: ttecquery;
         tipo: String = 'NFE'): Boolean;

procedure AbreTag_(Nome: String); overload;
procedure AbreTag_(Nome: String; Atributos: Array of String; Valores: Array of String); overload;

procedure TagCompleta_(Nome, Valor: String; Validar: Boolean = True; Maiusculas: Boolean = True; Opcional: boolean = false); overload;
procedure TagCompleta_(Nome: String; Valor:  Extended; Decimais: Integer; Opcional: boolean = false); overload;
procedure TagCompleta_(Nome: String; Valor: TDatetime; Formato: String); overload;
procedure FechaTag_(Nome: String);
function FormatarValorNFe(Formato: String; Valor: Extended): String;


implementation

Uses
  Forms, IniFiles, StrUtils,
  ACBrNFSeNotasFiscais, pcnEnvEventoNFe, {XMLDoc, XMLIntf,} ZPgSqlQuery;

{ TTecNotaFiscalEletronica }

procedure TTecNotaFiscalEletronica.AbreTag(Nome: String);
begin
  if not Validando {or AnularValidando} then
    Write(xml, '<' + Nome + '>')

end;

procedure TTecNotaFiscalEletronica.AbreTag(Nome: String; Atributos,
  Valores: array of String);
var
  i : Integer;
  Reg : String;

begin
  Reg := '<' + Nome;
  for i:=0 to High(Atributos) do
    Reg := Reg + ' ' + Atributos[i] + ' = "' + Valores[i] + '"';
  Reg := Reg + '>';

  if not Validando {or AnularValidando} then
    Write(xml, Reg)
end;

function TTecNotaFiscalEletronica.MontaArquivoPedidoCancelamento(NFe, Protocolo, Justificativa, Ambiente, Orgao, Cnpj, DataHoraProcessamento: String;
                                              var ProtocoloCanc: String):String;
begin



    AssignFile(xml, FDirEnvio+nfe_temp);
    Rewrite(xml);
//    Write(xml, '<?xml version="1.0" encoding="UTF-8"?>');

    AbreTag('envEvento', ['versao','xmlns'],
                       ['1.00',
                        'http://www.portalfiscal.inf.br/nfe']);
      TagCompleta('idLote',Protocolo);
      AbreTag('evento',['versao'],['1.00']);
        AbreTag('infEvento',['Id'], ['ID'+'110111'+Nfe+'01']);
          TagCompleta('cOrgao',Orgao);
          TagCompleta('tpAmb',Ambiente);
          TagCompleta('CNPJ',Cnpj);
          TagCompleta('chNFe', NFe);
          TagCompleta('dhEvento', DataHoraProcessamento);
          TagCompleta('tpEvento','110111');
          TagCompleta('nSeqEvento','1');
          TagCompleta('verEvento','1.00');

          AbreTag('detEvento',['versao'],['1.00']);
          TagCompleta('descEvento','Cancelamento',false,false);
          TagCompleta('nProt',Protocolo);
          TagCompleta('xJust',Justificativa);
          FechaTag('detEvento');

        FechaTag('infEvento');
      FechaTag('evento');
    FechaTag('envEvento');

    CloseFile(xml);

end;

function TTecNotaFiscalEletronica.Recuperar_CancelarNfe(NFe, Protocolo, Justificativa, Ambiente, Orgao, Cnpj, DataHoraProcessamento: String;
                                              var ProtocoloCanc: String): Boolean;
var
  Linha,
  MsgErro,
  ArqEnvio,
  ArqRetorno,
  ArqErro,
  Status,
  Motivo: String;
  ArqResp: TextFile;

  vEmissao : TDateTime;

begin
  ArqEnvio    := FDiretorioProcessamento + NFe + '-env-canc.xml';
  try
    if FileExists(ArqEnvio) then
      DeleteFile(ArqEnvio);

    MontaArquivoPedidoCancelamento(Nfe, Protocolo, Justificativa, Ambiente, Orgao, Cnpj, DataHoraProcessamento, ProtocoloCanc);

    repeat until RenameFile(FDirEnvio+nfe_temp,ArqEnvio);
  except
    on E: Exception do MensagemAviso_(E.Message + 'CancelamentoNFe!' +
                                     sLineBreak + ArqEnvio, false, ExibirMsgNFe)
  end;
end;




function TTecNotaFiscalEletronica.CancelarNfe(NFe, Protocolo, Justificativa, Ambiente, Orgao, Cnpj, DataHoraProcessamento: String;
                                              var ProtocoloCanc: String): Boolean;
var
  Linha,
  MsgErro,
  ArqEnvio,
  ArqRetorno,
  ArqErro,
  Status,
  Motivo: String;
  ArqResp: TextFile;

  vEmissao : TDateTime;

begin

  ArqEnvio   := FDirEnvio   + NFe + '-env-canc.xml';
  ArqRetorno := FDirRetorno + NFe + '-ret-env-canc.xml';
  ArqErro    := FDirRetorno + NFe + '-ret-env-canc.err';
  try
    if FileExists(ArqEnvio) then
      DeleteFile(ArqEnvio);
    if FileExists(ArqErro) then
      DeleteFile(ArqErro);

    MontaArquivoPedidoCancelamento(Nfe,Protocolo,Justificativa,Ambiente,Orgao, Cnpj, DataHoraProcessamento, ProtocoloCanc);

    repeat until RenameFile(FDirEnvio+nfe_temp,ArqEnvio);
  except
    on E: Exception do MensagemAviso_(E.Message + 'CancelamentoNFe!' +
                                     sLineBreak + ArqEnvio, false, ExibirMsgNFe)
  end;
  repeat
  until FileExists(ArqRetorno) or
        FileExists(ArqErro);
  Sleep(delay);
  Result := FileExists(ArqRetorno);
  if not Result then  // Exibe msg erro com o conteudo do arquivo de erro
  begin
    try
      CopiaTemporaria(FDirRetorno,ArqErro);
      AssignFile(ArqResp,FDirRetorno+nfe_temp);
      FileMode := 0;
      Reset(ArqResp);
      MsgErro := '';
      while not Eof(ArqResp) do
      begin
        Readln(ArqResp, Linha);
        MsgErro := MsgErro + Linha + sLineBreak
      end;
      CloseFile(ArqResp);
      DeleteFile(FDirRetorno+nfe_temp);
    except
      on E: Exception do MensagemAviso_(E.Message + 'RetornoCancelamentoNFe!' +
                                       sLineBreak + ArqErro, false, ExibirMsgNFe)
    end;
    MensagemErro_(MsgErro, ExibirMsgNFe, ArqErro)
  end
  else  // busca o numero do procolo de cancelamento
  begin
    ProtocoloCanc := ValorRetornoXML(ArqRetorno, 'nProt', Status, Motivo, ExibirMsgNfe);
    Result := ProtocoloCanc <> '';
    if not Result then
    begin
      MsgErro := 'Erro na captura do protocolo de cancelamento!';
      if (Status <> '') and (Motivo <> '') then
        MsgErro := MsgErro + sLineBreak + 'Status: ' + Status + ' - ' + Motivo;
      MensagemErro_(MsgErro, ExibirMsgNFe, ArqRetorno)
    end
    else
      result := CompartilharXMLCancelamento(nfe, true,now);
  end;
end;

function TTecNotaFiscalEletronica.ConsultarContribuinte(
  Identificacao: String): Boolean;
begin
  Result := False
end;

function TTecNotaFiscalEletronica.ConsultarSituacaoLote(Recibo: String;
  var Protocolo, status, DataHoraProcessamento: String; Ambiente: String; SomenteRetorno: Boolean = False): Boolean;
var
  Linha,
  MsgErro,
  ArqEnvioSitLote,
  ArqRetorno,
  ArqErro,
  StatusLote,
  MotivoLote,
  StatusNFe,
  MotivoNFe: String;
  ArqResp: TextFile;
{  Tentativas: Integer;}
  ArqINI: TIniFile;
  ArquivodeRetornoouErroProcessado : Boolean;

  ProtocoloCancelamento : String;


  procedure BuscarProtocoloNFe;
  var
    Linha,
    Conteudo: String;
    PosI, PosF: Integer;
    Arq: TextFile;
  begin
    Sleep(delay);
    try
      CopiaTemporaria(FDirRetorno,ArqRetorno);
      AssignFile(Arq, FDirRetorno+nfe_temp);
      FileMode := 0;
      Reset(Arq);
      repeat
        Readln(Arq, Linha);
        Conteudo := Conteudo + Linha;
      until Eof(Arq);
      CloseFile(Arq);
      DeleteFile(FDirRetorno+nfe_temp)
    except
      on E: Exception do MensagemAviso_(E.Message + 'ErroBuscarProtocoloNFe!' +
                                       sLineBreak + ArqRetorno, false, ExibirMsgNFe)
    end;
    PosI := Pos('<cStat>' ,Conteudo)+7;
    PosF := Pos('</cStat>',Conteudo);
    StatusLote := Copy(Conteudo,PosI,PosF-PosI);
    Delete(Conteudo,PosI-7,PosF-PosI+15);
    PosI := Pos('<xMotivo>' ,Conteudo)+9;
    PosF := Pos('</xMotivo>',Conteudo);
    MotivoLote := Copy(Conteudo,PosI,PosF-PosI);
    Delete(Conteudo,PosI-9,PosF-PosI+19);

    if pos('<protNFe',Conteudo) > 0 then
    begin
      PosI := Pos('<nProt>',Conteudo)+7;
      PosF := Pos('</nProt>',Conteudo);
      Protocolo := Copy(Conteudo,PosI,PosF-PosI);

      PosI := Pos('<dhRecbto>',Conteudo)+10;
      PosF := Pos('</dhRecbto>',Conteudo);
      DataHoraProcessamento := trocar(Copy(Conteudo,PosI,PosF-PosI),'T',' ');

      PosI := Pos('<cStat>' ,Conteudo)+7;
      PosF := Pos('</cStat>',Conteudo);
      StatusNFe := Copy(Conteudo,PosI,PosF-PosI);
      PosI := Pos('<xMotivo>' ,Conteudo)+9;
      PosF := Pos('</xMotivo>',Conteudo);
      MotivoNFe := Copy(Conteudo,PosI,PosF-PosI)
    end
  end;

  function VerificaProtocoloNFe : boolean;
  begin
    result := false;
    BuscarProtocoloNFe;

    if (StatusLote <> nfeLoteEmProcessamento) or (protocolo='') then
    begin
      status := StatusNFe;
      Result := Protocolo <> '';
      if not Result then
      begin
        MsgErro := 'Erro no processo de consulta do protocolo!';
        if StatusLote <> '' then
          MsgErro := MsgErro + sLineBreak + 'Status Lote: ' + StatusLote + ' - ' + MotivoLote;
        if StatusNFe <> '' then
          MsgErro := MsgErro + sLineBreak + 'Status NFe : ' + StatusNFe  + ' - ' + MotivoNFe;
        MensagemAviso_(MsgErro, false, ExibirMsgNFe)
      end
      else
      if StatusLote = nfeUsoDenegado then
      begin
        Result := false;
        MsgErro := 'A nota fiscal esta denegada!';
        if StatusLote <> '' then
          MsgErro := MsgErro + sLineBreak + 'Status Lote: ' + StatusLote + ' - ' + MotivoLote;
        if StatusNFe <> '' then
          MsgErro := MsgErro + sLineBreak + 'Status NFe : ' + StatusNFe  + ' - ' + MotivoNFe;
        MensagemAviso_(MsgErro, false, ExibirMsgNFe)
      end;
    end
  end;

begin
  Result     := False;

  ArqEnvioSitLote   := FDirEnvio   + Recibo + '-ped-rec.xml';
  ArqRetorno := FDirRetorno + Recibo + '-pro-rec.xml';
  ArqErro    := FDirRetorno + Recibo + '-pro-rec.err';

  StatusNFe  := '';
  StatusLote := nfeLoteEmProcessamento;
  MotivoNFe  := '';
  MotivoLote := '';
  MsgErro    := '';
  ArquivodeRetornoouErroProcessado := false;
{  Tentativas := 0;}

  sleep(delay);

  while true do
  begin
    IniciarTempo(vTempoInicial);
    repeat

      if (FileExists(ArqRetorno) and
         (FileDateToDateTime(FileAge(ArqRetorno)) >= vDataHoraLote)) or

        (FileExists(ArqErro) and
         (FileDateToDateTime(FileAge(ArqErro)) >= vDataHoraLote)) then

      begin
        if FileExists(ArqRetorno) then
          result := VerificaProtocoloNFe
        else
        if FileExists(ArqErro) then
        begin

          // result := consultarSituacaoNFe(fChaveNFe, fAmbiente, Protocolo, status, ProtocoloCancelamento, DataHoraProcessamento, MotivoNFe);
          //if not result then
          begin
            try
              CopiaTemporaria(FDirRetorno,ArqErro);
              AssignFile(ArqResp,FDirRetorno+nfe_temp);
              FileMode := 0;
              Reset(ArqResp);
              MsgErro := '';
              while not Eof(ArqResp) do
              begin
                Readln(ArqResp, Linha);
                MsgErro := MsgErro + Linha + sLineBreak
              end;
              CloseFile(ArqResp);
              DeleteFile(FDirRetorno+nfe_temp);
            except
              on E: Exception do MensagemAviso_(E.Message + 'LerRetornoSituaçãoLote!' +
                                               sLineBreak + ArqErro, false, ExibirMsgNFe)
            end;
            MensagemErro_(MsgErro, ExibirMsgNFe, ArqErro);
            result := false;
          end;

        end;

        ArquivodeRetornoouErroProcessado := true;

      end;
    until result or TempoEsgotado(vTempoInicial) or ArquivodeRetornoouErroProcessado;

    {
    if not result and not ArquivodeRetornoouErroProcessado then
    begin
      if not (MensagemConfirmacao('Arquivo de retorno '+ ArqRetorno +' não retornado.'+ sLineBreak +
                              'Deseja continuar tentando?') = smbOK) then
        break;
    end
    else}
      break;

  end;

  if not result and not ArquivodeRetornoouErroProcessado then
  begin

    while true do
    begin
      result := false;

      if FileExists(ArqEnvioSitLote) then
        DeleteFile(ArqEnvioSitLote);

      if FileExists(ArqRetorno) then
        DeleteFile(ArqRetorno);

      if FileExists(ArqErro) then
        DeleteFile(ArqErro);

      try
        AssignFile(xml, FDirEnvio+nfe_temp);
        Rewrite(xml);
        Write(xml, '<?xml version="1.0" encoding="UTF-8"?>');
        {
        AbreTag('consReciNFe', ['xmlns:xsi','xmlns:xsd','versao','xmlns'],
                               ['http://www.w3.org/2001/XMLSchema-instance',
                                'http://www.w3.org/2001/XMLSchema', '4.00',
                                'http://www.portalfiscal.inf.br/nfe']);
                                }
        AbreTag('consReciNFe', ['versao','xmlns'],
                               ['4.00',
                                'http://www.portalfiscal.inf.br/nfe']);

        TagCompleta('tpAmb',Ambiente);
        TagCompleta('nRec', Recibo);
        FechaTag('consReciNFe');
        CloseFile(xml);
        repeat until RenameFile(FDirEnvio+nfe_temp, ArqEnvioSitLote);

      except
        on E: Exception do MensagemAviso_(E.Message + 'ConsultarSituçãoLoteNFe!' +
                                         sLineBreak + ArqEnvioSitLote, false, ExibirMsgNFe)
      end;

      IniciarTempo(vTempoInicial);

      ArquivodeRetornoouErroProcessado := false;

      repeat
        Application.ProcessMessages;

        if (FileExists(ArqRetorno) and
           (FileDateToDateTime(FileAge(ArqRetorno)) >= vDataHoraLote)) or

          (FileExists(ArqErro) and
           (FileDateToDateTime(FileAge(ArqErro)) >= vDataHoraLote)) then

        begin
          if FileExists(ArqRetorno) then
          begin
            result := VerificaProtocoloNFe;
            ArquivodeRetornoouErroProcessado := true;
          end
          else
          if FileExists(ArqErro) then
          begin
          {
            if consultarSituacaoNFe(fChaveNFe, fAmbiente, Protocolo, status, ProtocoloCancelamento, DataHoraProcessamento, MotivoNFe) then
              continue;

            if not result then}
            begin
              try
                CopiaTemporaria(FDirRetorno,ArqErro);
                AssignFile(ArqResp,FDirRetorno+nfe_temp);
                FileMode := 0;
                Reset(ArqResp);
                MsgErro := '';
                while not Eof(ArqResp) do
                begin
                  Readln(ArqResp, Linha);
                  MsgErro := MsgErro + Linha + sLineBreak
                end;
                CloseFile(ArqResp);
                DeleteFile(FDirRetorno+nfe_temp);
              except
                on E: Exception do MensagemAviso_(E.Message + 'LerRetornoSituaçãoLote!' +
                                                 sLineBreak + ArqErro, false, ExibirMsgNFe)
              end;
              MensagemErro_(MsgErro, ExibirMsgNFe, ArqErro);
              result := false;
              ArquivodeRetornoouErroProcessado := true;
            end;

          end;
        end;

      until result or TempoEsgotado(vTempoInicial) or ArquivodeRetornoouErroProcessado;

      if not result and not ArquivodeRetornoouErroProcessado then
      begin
         if exibirmsgnfe then
         begin
           if not (MensagemConfirmacao('Arquivo de retorno '+ ArqRetorno +' não retornado.'+ sLineBreak +
                                'Deseja continuar tentando?') = smbOK) then
             break;
         end
         else
           break;
      end
      else
        break;
    end;
  end;

end;


function TTecNotaFiscalEletronica.ConsultarSituacaoNFe(
  var NFe: String; Ambiente: String; var Protocolo, status, StatusRetConsSitNFe,
  ProtocoloCancelamento, DataHoraProcessamento, MotivoNFe: String; regerar: Boolean = False): Boolean;
var
  Linha,
  MsgErro,
  ArqEnvio,
  ArqRetorno,
  ArqErro,
  Retorno,
  StatusGeral : String;
  ArqResp: TextFile;
  PosI, PosF: Integer;


begin

  ArqEnvio   := FDirEnvio   + NFe + '-ped-sit.xml';
  ArqRetorno := FDirRetorno + NFe + '-sit.xml';
  ArqErro    := FDirRetorno + NFe + '-sit.err';


  ConteudoProtNFe_consSitNFe := '';

  try
    if FileExists(ArqEnvio) then
      DeleteFile(ArqEnvio);
    if FileExists(ArqErro) then
      DeleteFile(ArqErro);
    AssignFile(xml, FDirEnvio+nfe_temp);
    Rewrite(xml);
    Write(xml, '<?xml version="1.0" encoding="UTF-8"?>');
    {
    AbreTag('consSitNFe', ['xmlns:xsi','xmlns:xsd','versao','xmlns'],
                           ['http://www.w3.org/2001/XMLSchema-instance',
                            'http://www.w3.org/2001/XMLSchema', '4.00',
                            'http://www.portalfiscal.inf.br/nfe']);
                            }
    AbreTag('consSitNFe', ['versao','xmlns'],
                           ['4.00',
                            'http://www.portalfiscal.inf.br/nfe']);

    TagCompleta('tpAmb',Ambiente);
    TagCompleta('xServ','CONSULTAR');
    TagCompleta('chNFe',NFe);
    FechaTag('consSitNFe');
    CloseFile(xml);
    repeat until RenameFile(FDirEnvio+nfe_temp,ArqEnvio);
  except
    on E: Exception do MensagemAviso_(E.Message + 'ConsultarSituaçãoNFe!' +
                                     sLineBreak + ArqEnvio, false, ExibirMsgNFe)
  end;

  IniciarTempo(vTempoInicial);

  repeat
  until FileExists(ArqRetorno) or
        FileExists(ArqErro) or TempoEsgotado(vTempoInicial);

  {Esperar 2 segundos para não dar erro concorrente entre aplicativos uninfe e erp}
  IniciarTempo(vTempoInicial);
  repeat
  until TempoEsgotado(vTempoInicial,2000);

  if not (FileExists(ArqRetorno) or
          FileExists(ArqErro)) then
  begin
    if ExibirMsgNFe then
      MensagemErro_('Esgotado o tempo limite de espera da consulta da situação. Verifique suas configurações');
 end;

//  sleep(delay);
  Result := FileExists(ArqRetorno);

  if not Result then
  begin
    if FileExists(ArqErro) then
    begin

      try
        CopiaTemporaria(FDirRetorno,ArqErro);
        AssignFile(ArqResp,FDirRetorno+nfe_temp);
        FileMode := 0;
        Reset(ArqResp);
        MsgErro := '';
        while not Eof(ArqResp) do
        begin
          Readln(ArqResp, Linha);
          MsgErro := MsgErro + Linha + sLineBreak
        end;
        CloseFile(ArqResp);
        DeleteFile(FDirRetorno+nfe_temp)
      except
        on E: Exception do MensagemAviso_(E.Message + 'InterpretarResposta!' +
                                         sLineBreak + ArqErro, false, ExibirMsgNFe)
      end;
      MensagemErro_(MsgErro, ExibirMsgNFe, ArqErro)
    end;
  end
  else
  begin
    //Verficar Existencia de protocolo
    //Verificar Existencia de protocolo de cancelamento
    Protocolo := ValorRetornoXML(ArqRetorno, 'nProt', ExibirMsgNfe);

    ProtocoloCancelamento := ValorRetornoXML_DentroTag(ArqRetorno,'infCanc','nProt');

    if (ProtocoloCancelamento = '') then
      if ValorRetornoXML(ArqRetorno, 'procEventoNFe', ExibirMsgNfe) <> '' then
        if ValorRetornoXML(ArqRetorno, 'evento', ExibirMsgNfe) <> '' then
           if ValorRetornoXML(ArqRetorno, 'retEvento', ExibirMsgNfe) <> '' then
              ProtocoloCancelamento := ValorRetornoProtocoloCancelamento(ArqRetorno);

    StatusRetConsSitNFe := ValorRetornoXML(ArqRetorno, 'cStat', ExibirMsgNfe);
    status := ValorRetornoXML_DentroTag(ArqRetorno,'protNFe','cStat');
    DataHoraProcessamento := ValorRetornoXML_DentroTag(ArqRetorno,'protNFe','dhRecbto');
    MotivoNfe := ValorRetornoXML_DentroTag(ArqRetorno,'protNFe','xMotivo');

                    (*
    statusGeral := ValorRetornoXML(ArqRetorno,'cStat');
    if statusgeral = '613' then {Ouve o envio porem com outro codigo que difere devido a mes/ano forma de envio: contigencia/normal.}
    begin                    {Neste caso o procedimento é capturar a chave contida no sefaz a assunir a ela}
      Nfe := VAlorRetornoXML(ArqREtorno, 'chNFe');
      ConsultarSituacaoNFe(Nfe, Ambiente, Protocolo, status, ProtocoloCancelamento, DataHoraProcessamento, MotivoNFe, regerar);
    end;
    *)

    try
      CopiaTemporaria(FDirRetorno,ArqRetorno);
      AssignFile(ArqResp,FDirRetorno+nfe_temp);
      FileMode := 0;
      Reset(ArqResp);
      ConteudoProtNFe_consSitNFe := '';
      while not Eof(ArqResp) do
      begin
        Readln(ArqResp, Linha);
        retorno := retorno + Linha
      end;
      CloseFile(ArqResp);
      DeleteFile(FDirRetorno+nfe_temp)
    except
      on E: Exception do MensagemAviso_(E.Message + 'Erro na Leitura da situação da NFe!' +
                                       sLineBreak + ArqRetorno, false, ExibirMsgNFe)
    end;
    PosI := Pos('<protNFe', retorno);
    PosF := Pos('</protNFe>', retorno);
    if PosF <> 0 then
      PosF := Pos('</protNFe>', retorno)+10;

    ConteudoProtNFe_consSitNFe := Copy(retorno,PosI,PosF-PosI);



  end
end;


{
class procedure TTecNotaFiscalEletronica.DiretorioEnvio(Valor: String);
var
  Barra: Integer;
begin
  FDirEnvio := Valor;
  Barra     := Length(FDirEnvio);
  if (Barra > 0) and (Valor[Barra] <> '\') then
    FDirEnvio := FDirEnvio + '\';
end;

class function TTecNotaFiscalEletronica.DiretorioEnvio: String;
begin
  Result := FDirEnvio;
end;

class procedure TTecNotaFiscalEletronica.DiretorioRetorno(Valor: String);
var
  Barra: Integer;
begin
  FDirRetorno := Valor;
  Barra       := Length(FDirRetorno);
  if (Barra > 0) and (Valor[Barra] <> '\') then
    FDirRetorno := FDirRetorno + '\';
end;

class function TTecNotaFiscalEletronica.DiretorioRetorno: String;
begin
  Result := FDirRetorno;
end;
}
function TTecNotaFiscalEletronica.CompartilharXML(Nfe, Recibo,
  Filial, Serie, Numero: String; Emissao: TDateTime; NumLote: String = ''): Boolean;
var
  Dir,
  CaminhoNFe,
  CaminhoProtocolo,
  Conteudo,
  Retorno,
  Linha,
  ArqEnvio : String;
  PosI, PosF: Integer;

  Arq: TextFile;
begin
  Result := True;
  CaminhoNFe := FDirEnviado + FormatDateTime('yyyymm', Emissao) + '\' + NFe + '-nfe.xml';
  if Recibo<>''then
    CaminhoProtocolo := FDirRetorno + Recibo + '-pro-rec.xml'
  else
    CaminhoProtocolo := FDirRetorno + preencheString(NumLote,'0',15,False) + '-pro-rec.xml';


  if not DirectoryExists(FDirCompartilha) then
    if not CreateDir(FDirCompartilha) then
    begin
      result := false;
      raise Exception.Create('Impossível criar o diretório ' + FDirCompartilha);
    end;

  Dir := FDirCompartilha+FormatDateTime('yyyy',Emissao);
  if not DirectoryExists(Dir) then
    if not CreateDir(Dir) then
    begin
      result := false;
      raise Exception.Create('Impossível criar o diretório ' + Dir);
    end;

  Dir := Dir + '\' + FormatDateTime('mm',Emissao);
  if not DirectoryExists(Dir) then
    if not CreateDir(Dir) then
    begin
      result := false;
      raise Exception.Create('Impossível criar o diretório ' + Dir);
    end;

  Dir := Dir + '\' + FormatDateTime('dd',Emissao);
  if not DirectoryExists(Dir) then
    if not CreateDir(Dir) then
    begin
      result := false;
      raise Exception.Create('Impossível criar o diretório ' + Dir);
    end;

  if result then
  begin
    try
      CopiaTemporaria(FDirEnvio,CaminhoNFe);
      AssignFile(Arq,FDirEnvio+nfe_temp);
      FileMode := 0;
      Reset(Arq);
      Conteudo := '';
      while not Eof(Arq) do
      begin
        Readln(Arq, Linha);
        Conteudo := Conteudo + Linha
      end;
      CloseFile(Arq);
      DeleteFile(FDirEnvio+nfe_temp)
    except
      on E: Exception do
      begin
         MensagemAviso_(E.Message + 'ErroLeituraNFe!' +
                                       sLineBreak + CaminhoNFe, false, ExibirMsgNFe);
         result := false;
      end;
    end;
    PosF := Pos('<NFe',Conteudo);
    Delete(Conteudo,1 ,PosF-1);
    Retorno := Conteudo;
  end;

  if result then
  begin
    try
      CopiaTemporaria(FDirRetorno,CaminhoProtocolo);
      AssignFile(Arq,FDirRetorno+nfe_temp);
      FileMode := 0;
      Reset(Arq);
      Conteudo := '';
      while not Eof(Arq) do
      begin
        Readln(Arq, Linha);
        Conteudo := Conteudo + Linha
      end;
      CloseFile(Arq);
      DeleteFile(FDirRetorno+nfe_temp)
    except
      on E: Exception do
      begin
        MensagemAviso_(E.Message + 'ErroLeituraProtocolo!' +
                                       sLineBreak + CaminhoProtocolo, false, ExibirMsgNFe);
        result := false;
      end;
    end;
  end;

  if result then
  begin
    try
      PosI := Pos('<protNFe', Conteudo);
      PosF := Pos('</protNFe>', Conteudo);
      if PosF <> 0 then
        PosF := Pos('</protNFe>', Conteudo)+10;

      Retorno := Retorno + Copy(Conteudo,PosI,PosF-PosI);

      ArqEnvio := Dir + '\nfeProc' + preencheString(Filial,'0',2,False) +
                                     preencheString(Serie, '0',2,False) +
                                     preencheString(Numero,'0',9,False) + '.xml';

      if FileExists(ArqEnvio) then
        DeleteFile(ArqEnvio);

      AssignFile(xml, ArqEnvio);
      Rewrite(xml);

      Write(xml, '<?xml version="1.0" encoding="UTF-8"?>');

      AbreTag('nfeProc', ['versao','xmlns'],
                         ['4.00',
                          'http://www.portalfiscal.inf.br/nfe']);

      Write(xml,Retorno);

      FechaTag('nfeProc');
      CloseFile(xml);

    except
      on E: Exception do
      begin
        MensagemAviso_(E.Message + 'Erro na gravação do protocolo no arquivo xml!' +
                                       sLineBreak + CaminhoProtocolo, false, ExibirMsgNFe);
        result := false;
      end;
    end;
  end;

  if result then
  begin
    NomedoArquivoCompartilhado := ArqEnvio;
    GerarPDF(ArqEnvio);
  end
  else
    NomedoArquivoCompartilhado := '';

end;

function TTecNotaFiscalEletronica.CompartilharXML_Recuperado(Nfe, Recibo,
  Filial, Serie, Numero: String; Emissao: TDateTime; Esperar: boolean = false;
  Protocolo: String = ''): Boolean;
var
  Dir,
  CaminhoNFe, CaminhoprocNFe,
  CaminhoNFeProcessamento,
  CaminhoNFeErro,
  CaminhoProtocolo,
  Conteudo,
  Retorno,
  Linha,
  ArqEnvio : String;
  PosI, PosF: Integer;
  Arq : TExtFile;

  function CopiarArquivoCompartilhado: boolean;
  begin
    result := true;

    try
     if(not CopyFileTo(CaminhoprocNFe,ArqEnvio)) then
        result := false;
    except
      on E: Exception do
      begin
        result := false;
        MensagemAviso_(E.Message + 'ErroLeituraNFe!' + sLineBreak + CaminhoprocNFe, false, ExibirMsgNFe);
      end;
    end;



  end;


  function GravarProtNfeArquivoCompartilhado(ArquivoOrigem: String): boolean;
  begin
    result := true;

    try
      CopiaTemporaria(FDirEnvio,ArquivoOrigem);
      AssignFile(Arq,FDirEnvio+nfe_temp);
      FileMode := 0;
      Reset(Arq);
      while not Eof(Arq) do
      begin
        Readln(Arq, Linha);
        Conteudo := Conteudo + Linha
      end;
      CloseFile(Arq);
      DeleteFile(FDirEnvio+nfe_temp)

    except
      on E: Exception do
      begin
        result := false;
        MensagemAviso_(E.Message + 'Erro de Leitura da NFe!' + sLineBreak + ArquivoOrigem, false, ExibirMsgNFe)
      end;
    end;

    try
      PosF := Pos('<NFe',Conteudo);
      Delete(Conteudo,1 ,PosF-1);
      Retorno := Conteudo;
    except
      on E: Exception do
      begin
        result := false;
        MensagemAviso_(E.Message + format('Erro de Leitura da NFe! PosF %', [inttostr(PosF)]) + sLineBreak + ArquivoOrigem, false, ExibirMsgNFe);
      end;
    end;


    try
     if ConteudoProtNFe_consSitNFe='' then
       ConteudoProtNFe_consSitNFe :=

       '<protNFe versao="2.00"'+
	         'xmlns="http://www.portalfiscal.inf.br/nfe">'+
		'<infProt Id="ID'+protocolo+'">'+
			'<tpAmb>1</tpAmb>'+
			'<verAplic>SVRS20140603082605</verAplic>'+
			'<chNFe>'+Nfe+'</chNFe>'+
			'<dhRecbto>'+formatdatetime('yyyy-mm-dd',emissao)+'T'+formatdatetime('hh-nn-ss',emissao)+'</dhRecbto>'+
			'<nProt>'+protocolo+'</nProt>'+
			'<digVal>6ErMsdmqMEPif5ZtGtCqCok2H3I=</digVal>'+
			'<cStat>100</cStat>'+
			'<xMotivo>Autorizado o uso da NF-e</xMotivo>'+
		'</infProt>'+
	'</protNFe>';



      Retorno := Retorno + ConteudoProtNFe_consSitNFe;


      AssignFile(xml, CaminhoprocNFe);
      Rewrite(xml);
      Write(xml, '<?xml version="1.0" encoding="UTF-8"?>');
      AbreTag('nfeProc', ['versao','xmlns'],
                         ['4.00',
                          'http://www.portalfiscal.inf.br/nfe']);

      Write(xml,Retorno);
      FechaTag('nfeProc');
      CloseFile(xml);

      CopiarArquivoCompartilhado;
    except
      on E: Exception do
      begin
        result := false;
        MensagemAviso_(E.Message + 'ErroLeituraNFe!' + sLineBreak + CaminhoprocNFe, false, ExibirMsgNFe)
      end;
    end;

  end;


begin
  Result := true;

  CaminhoNFe := FDirEnviado + FormatDateTime('yyyymm', Emissao) + '\' + NFe + '-nfe.xml';
  CaminhoprocNFe := FDirEnviado + FormatDateTime('yyyymm', Emissao) + '\' + NFe + '-procNFe.xml';

  CaminhoNFeProcessamento := FDiretorioProcessamento + NFe + '-nfe.xml';
  CaminhoNFeErro :=  DiretorioErros + NFe + '-nfe.xml';  {quando reenviada a nota e volta duplicidade vai para a pasta erro assinada pelo uninfe, porém não é erro pois o protocolo foi recuperado}


  if not DirectoryExists(FDirCompartilha) then
    if not CreateDir(FDirCompartilha) then
    raise Exception.Create('Impossível criar o diretório ' + FDirCompartilha);

  Dir := FDirEnviado + FormatDateTime('yyyymm', Emissao);
  if not DirectoryExists(Dir) then
    if not CreateDir(Dir) then
    raise Exception.Create('Impossível criar o diretório ' + Dir);

  Dir := FDirCompartilha+FormatDateTime('yyyy',Emissao);
  if not DirectoryExists(Dir) then
    if not CreateDir(Dir) then
    raise Exception.Create('Impossível criar o diretório ' + Dir);

  Dir := Dir + '\' + FormatDateTime('mm',Emissao);
  if not DirectoryExists(Dir) then
    if not CreateDir(Dir) then
    raise Exception.Create('Impossível criar o diretório ' + Dir);

  Dir := Dir + '\' + FormatDateTime('dd',Emissao);
  if not DirectoryExists(Dir) then
    if not CreateDir(Dir) then
    raise Exception.Create('Impossível criar o diretório ' + Dir);


  ArqEnvio := Dir + '\nfeProc' + preencheString(Filial,'0',2,False) +
                               preencheString(Serie, '0',2,False) +
                               preencheString(Numero,'0',9,False) + '.xml';

  if(FileExists(ArqEnvio)) then
    DeleteFile(ArqEnvio);

//      MensagemAviso_('IniciarTempo');
           {
  if regerar then
  begin
    repeat
    until FileExists(CaminhoNFe);
  end;
  }

  IniciarTempo(vTempoInicial);

//      MensagemAviso_('fim IniciarTempo');


  repeat
    {
    if FileExists(CaminhoprocNFe)  then
    begin
      result := CopiarArquivoCompartilhado;
      if not result then
         MensagemAviso_('Erro na copia do arquivo ''CaminhoprocNFe'' '+ CaminhoprocNFe, false, ExibirMsgNFe);

    end
    else
    if FileExists(CaminhoNFe) then
    begin
      result := GravarProtNfeArquivoCompartilhado(CaminhoNFe);
      if not result then
         MensagemAviso_('Erro na copia do arquivo ''CaminhoNFe'' '+ CaminhoNFe, false, ExibirMsgNFe);

    end
    else
    if FileExists(CaminhoNFeProcessamento) then
    begin
      try
        if (not CopyFileTo(CaminhoNFeProcessamento,CaminhoNFe)) then
          result := false;

        repeat
          result := FileExists(CaminhoNFe)
        until result;

        if result then
          GravarProtNfeArquivoCompartilhado(CaminhoNFe);

        if not result then
          MensagemAviso_('Erro na copia do arquivo ''CaminhoNFeProcessamento'' '+ CaminhoNFeProcessamento, false, ExibirMsgNFe);

      except
        on E: Exception do MensagemAviso_(E.Message + 'Erro Leitura NFe!' +
                                         sLineBreak + CaminhonfeErro, false, ExibirMsgNFe)
      end;
    end
    else
    }
    if FileExists(CaminhonfeErro)  then
    begin
      try
        if (not CopyFileTo(CaminhonfeErro,CaminhoNFe)) then


         result := false;

        repeat
          result := FileExists(CaminhoNFe)
        until result;

        if result then
          GravarProtNfeArquivoCompartilhado(CaminhoNFe);

        if not result then
          MensagemAviso_('Erro na copia do arquivo ''CaminhonfeErro'' '+ CaminhonfeErro, false, ExibirMsgNFe);

      except
        on E: Exception do MensagemAviso_(E.Message + 'Erro Leitura NFe!' +
                                         sLineBreak + CaminhonfeErro, false, ExibirMsgNFe)
      end;
    end
    else

      result := false;

  until TempoEsgotado(vTempoInicial)  or result or not esperar;

  if result then
  begin
    NomedoArquivoCompartilhado := ArqEnvio;
    GerarPDF(ArqEnvio);
  end
  else
    NomedoArquivoCompartilhado := '';



end;



function TTecNotaFiscalEletronica.EnviarNFe(ChaveNFe: String;                // ENVIO JA FOI FEITO,
                                            var NumLote: String;             // A FUNCAO ANALISA OS ARQUIVOS DE RETORNO
                                            var NumRecibo: String): Boolean; // DO LOTE E DO RECIBO
var
  ArqErro,
  ArqRetorno,
  Linha,
  MsgErro,
  StatusLote,
  MotivoLote : String;

  ArqResp: TextFile;
  ArquivodeRetornoouErroProcessado : Boolean;
begin
  result := false;
  ArqRetorno := FDirRetorno + ChaveNFe + '-num-lot.xml';
  ArqErro    := FDirRetorno + ChaveNFe + '-nfe.err';

  ArquivodeRetornoouErroProcessado := false;

  Sleep(delay);


  while true do
  begin
    IniciarTempo(vTempoInicial);

    repeat
//      Application.ProcessMessages;

      if FileExists(ArqRetorno) or
         FileExists(ArqErro) then
      begin
        if FileExists(ArqRetorno) then
        begin
          NumLote := ValorRetornoXML(ArqRetorno, 'NumeroLoteGerado', ExibirMsgNfe);
          vDataHoraLote := FileDateToDateTime(FileAge(ArqRetorno));
          Result := NumLote <> '';
          if not Result then
            MensagemErro_('Erro na captura do lote: O número lote não foi retornado pelo Sefaz. Função EnviarNFe.', ExibirMsgNFe);
        end
        else
        if FileExists(ArqErro) then
        begin
          Result := False;
          try
            CopiaTemporaria(FDirRetorno,ArqErro);
            AssignFile(ArqResp,FDirRetorno+nfe_temp);
            FileMode := 0;
            Reset(ArqResp);
            MsgErro := '';
            while not Eof(ArqResp) do
            begin
              Readln(ArqResp, Linha);
              MsgErro := MsgErro + Linha + sLineBreak
            end;
            CloseFile(ArqResp);
            DeleteFile(FDirRetorno+nfe_temp)
          except
            on E: Exception do MensagemAviso_(E.Message + 'ErroEnvioNFe!' +
                                             sLineBreak + ArqErro, false, ExibirMsgNFe)
          end;
          MensagemErro_(MsgErro, ExibirMsgNFe, ArqErro)

        end;

        ArquivodeRetornoouErroProcessado := true;

      end;
    until result or TempoEsgotado(vTempoInicial) or ArquivodeRetornoouErroProcessado;

    if not result and not ArquivodeRetornoouErroProcessado then
    begin
      if exibirmsgnfe then
      begin
        if not (MensagemConfirmacao('Erro na captura do lote: Arquivo de retorno '+ ArqRetorno +' não retornado.'+ sLineBreak +
                                'Deseja continuar tentando?') = smbOK) then
          break;
      end
      else
        break;

    end
    else
      break;
  end;

  if Result then
  begin
    result := false;

    ArquivodeRetornoouErroProcessado := false;
    ArqRetorno := FDirRetorno + preencheString(NumLote,'0',15,False) + '-rec.xml';
//    ArqRetorno := FDirRetorno + preencheString(NumLote,'0',15,False) + '-pro-rec.xml';
    ArqErro    := FDirRetorno + preencheString(NumLote,'0',15,False) + '-rec.err';
//    ArqErro    := FDirRetorno + preencheString(NumLote,'0',15,False) + '-pro-rec.err';

    while true do
    begin
      Sleep(delay);
      IniciarTempo(vTempoInicial);

      repeat
//        Application.ProcessMessages;

        if (FileExists(ArqRetorno) and
           (FileDateToDateTime(FileAge(ArqRetorno)) >= vDataHoraLote)) or

          (FileExists(ArqErro) and
           (FileDateToDateTime(FileAge(ArqErro)) >= vDataHoraLote)) then

        begin
          if FileExists(ArqRetorno) then
          begin

            NumRecibo := ValorRetornoXML(ArqRetorno, 'nRec', ExibirMsgNfe);
            StatusLote := ValorRetornoXML(ArqRetorno, 'cStat', ExibirMsgNfe);
            MotivoLote := ValorRetornoXML(ArqRetorno, 'xMotivo', ExibirMsgNfe);

            Result := NumRecibo <> '';
            if not Result then
              MensagemErro_('Erro na captura do número do recibo do lote: não retornado pelo Sefaz. Status: '+StatusLote+' Motivo: '+MotivoLote,
                 ExibirMsgNFe, ArqRetorno);

          end
          else
          if FileExists(ArqErro) then
          begin
            result := false;
            try
              CopiaTemporaria(FDirRetorno,ArqErro);
              AssignFile(ArqResp,FDirRetorno+nfe_temp);
              FileMode := 0;
              Reset(ArqResp);
              MsgErro := '';
              while not Eof(ArqResp) do
              begin
                Readln(ArqResp, Linha);
                MsgErro := MsgErro + Linha + sLineBreak
              end;
              CloseFile(ArqResp);
              DeleteFile(FDirRetorno+nfe_temp)
            except
              on E: Exception do MensagemAviso_(E.Message + 'ErroRetornoReciboNFe!' +
                                               sLineBreak + ArqErro, false, ExibirMsgNFe)
            end;
            MensagemErro_(MsgErro, ExibirMsgNFe, ArqErro)
          end;

          ArquivodeRetornoouErroProcessado := true;

        end;
      until result or TempoEsgotado(vTempoInicial) or ArquivodeRetornoouErroProcessado;

      if   not result and not ArquivodeRetornoouErroProcessado then
      begin
        if exibirmsgnfe then
        begin
          if not (MensagemConfirmacao('Erro na captura do número do recibo do lote: '+chr(13)+
                                      'Arquivo de retorno '+ ArqRetorno +' não retornado.'+ sLineBreak +
                                      'Deseja continuar tentando?') = smbOK) then
            break;
        end
        else break;

      end
      else
        break;
    end;
  end;
end;



function TTecNotaFiscalEletronica.EnviarNFCe(ChaveNFe: String;                // ENVIO JA FOI FEITO,
                                            var NumLote: String;             // A FUNCAO ANALISA OS ARQUIVOS DE RETORNO
                                            var NumRecibo: String;
                                            var ProtocoloNFe: String;
                                            var Status: String;
                                            var xMotivo: String;
                                            var DataHoraProcessamento: String;
                                            PermitirContingencia: Boolean
                                            ): TtecRetornoEnvioNFCe; // DO LOTE E DO RECIBO
var
  ArqErro,
  ArqRetorno,
  Linha,
  MsgErro {,

  StatusLote,
  MotivoLote} : String;
  ArqResp: TextFile;
  ArquivodeRetornoouErroProcessado : Boolean;
  botao : TModalResult;

  XMLDocument: IXMLDocument;
begin
  result := Aguardar;
  ArqRetorno := FDirRetorno + ChaveNFe + '-num-lot.xml';
  ArqErro    := FDirRetorno + ChaveNFe + '-nfe.err';

  ArquivodeRetornoouErroProcessado := false;

//Sleep(delay);

  while true do
  begin
    IniciarTempo(vTempoInicial);
    repeat

      if FileExists(ArqRetorno) or
         FileExists(ArqErro) then
      begin

        if FileExists(ArqRetorno) then
        begin
          NumLote := ValorRetornoXML(ArqRetorno, 'NumeroLoteGerado', ExibirMsgNfe);
          vDataHoraLote := FileDateToDateTime(FileAge(ArqRetorno));
          if NumLote = '' then
          begin
            Result := Erro;
            if usuariologin.suporte then
              MensagemErro_('Erro na captura do lote: O número lote não foi retornado pelo Sefaz. Função EnviarNFCe.', ExibirMsgNFe, ArqRetorno);
          end
          else
            result := ArquivosRetornados;

        end
        else
        if FileExists(ArqErro) then
        begin
          Result := Erro;
          try
            CopiaTemporaria(FDirRetorno,ArqErro);
            AssignFile(ArqResp,FDirRetorno+nfe_temp);
            FileMode := 0;
            Reset(ArqResp);
            MsgErro := '';
            while not Eof(ArqResp) do
            begin
              Readln(ArqResp, Linha);
              MsgErro := MsgErro + Linha + sLineBreak
            end;
            CloseFile(ArqResp);
            DeleteFile(FDirRetorno+nfe_temp)
          except
            on E: Exception do MensagemAviso_(E.Message + 'Função EnviarNFCe!' +
                                             sLineBreak + ArqErro, false, ExibirMsgNFe)
          end;

//          MensagemErro(MsgErro)
        end;

        ArquivodeRetornoouErroProcessado := true;

      end;

    until TempoNFCeEsgotado or ArquivodeRetornoouErroProcessado;


    if (((result<>Erro) and not ArquivodeRetornoouErroProcessado) or //tempo
        (result = Erro)) and PermitirContingencia then
    begin

      if usuariologin.suporte then
      begin

        if result = erro then
          botao := MensagemSimNaoOpcaoCancelarmmo('Erro na captura do lote: Arquivo de erro '+ ArqErrO +' foi retornado. Deseja entrar em modo de contingência off line?',
                                                   'Reiniciar o UNINFE', false, 'Aguardar', 'Entrar em Contingência', msgErro)
        else
          botao := MensagemSimNaoOpcaoCancelarmmo('Erro na captura do lote: Arquivo de retorno '+ ArqRetorno +' não retornado.', 'Reiniciar o UNINFE', false, 'Aguardar', 'Entrar em Contingência',
                                                  'Excedeu-se o limite de espera de '+inttostr(parsistema.TempoEsperaNFCe)+' segundos. '+ sLineBreak +
                                                  'Deseja continuar aguardando o retorno do arquivo ou entrar em modo de contingência off line?');


        if botao = mrNO then
        begin
          result := EntraremContingencia;
          break;
        end
        else
        if botao = mrOK THEN
          ReiniciarUNINFE;

      end
      else
      begin

        result := EntraremContingencia;
        break;

      end;

    end
    else
      break;
  end;

  if Result = ArquivosRetornados then
  begin

    result := Aguardar;

    ArquivodeRetornoouErroProcessado := false;
    {NFC-e deverá "Enviar a NFC-e utilizando o processo síncrono}
    {Ver configurações no UNINFE}

    ArqRetorno := FDirRetorno + preencheString(NumLote,'0',15,False) + '-pro-rec.xml';
    ArqErro    := FDirRetorno + preencheString(NumLote,'0',15,False) + '-pro-rec.err';

    {no modo assíncrono retorna os -rec.xml contendo o número do recbio }

    {

Manual de Orientação do Contribuinte
Anexo I – Leiaute e Regras de Validação da NF-e e da NFC-e
Versão 7.00 – Novembro de 2020


Acesso BD NFE (Chave: Modelo, UF, CNPJ/CPF Emitente, Série, Número):
– NF-e já cadastrada e não Cancelada/Denegada

Observação 1: Na resposta assíncrona, a SEFAZ pode devolver o nREC –
Número do Recibo do Lote caso tenha condições.

Observação 2: A critério da UF, no caso do DigestValue ser igual a NF-e
autorizada, poderá retornar o protocolo de Autorização. (NT 2018.005 v1.30
/ NT 2018.001 v1.10)


    }

{
    ArqRetorno := FDirRetorno + preencheString(NumLote,'0',15,False) + '-rec.xml';
    ArqErro    := FDirRetorno + preencheString(NumLote,'0',15,False) + '-rec.err';
}


    while true do
    begin

      Sleep(delay);
      IniciarTempo(vTempoInicial);

      repeat

        if (FileExists(ArqRetorno) and
           (FileDateToDateTime(FileAge(ArqRetorno)) >= vDataHoraLote)) or

          (FileExists(ArqErro) and
           (FileDateToDateTime(FileAge(ArqErro)) >= vDataHoraLote)) then

        begin
          if FileExists(ArqRetorno) then
          begin

//            NumRecibo  := ValorRetornoXML(ArqRetorno, 'nRec', ExibirMsgNfe); {retorna vazio...}

            try

              XMLDocument := TXmlDocument.Create(ArqRetorno);
              XMLDocument.Active := true;


              if XMLDocument.DocumentElement.ChildNodes.FindNode('protNFe')
                                            .ChildNodes.FindNode('infProt')<> nil then
              begin
                with XMLDocument.DocumentElement.ChildNodes.FindNode('protNFe')
                                            .ChildNodes.FindNode('infProt') do
                begin

                  if ChildNodes.FindNode('cStat') <> nil then
                    Status := ChildNodes.FindNode('cStat').Text;

                  if ChildNodes.FindNode('xMotivo') <> nil then
                    xMotivo := ChildNodes.FindNode('xMotivo').Text;

                  if ChildNodes.FindNode('dhRecbto') <> nil then
                    DataHoraProcessamento := ChildNodes.FindNode('dhRecbto').text;

                  if ChildNodes.FindNode('nProt') <> nil then
                    ProtocoloNFe := ChildNodes.FindNode('nProt').Text;

                  if ChildNodes.FindNode('nRec') <> nil then
                    NumRecibo := ChildNodes.FindNode('nRec').Text;  {Tentando...porém segundo as regras acima na nfce poderá não retornar de acordo com a UF}


                end;

              end;

              if ProtocoloNFe = '' then
              begin

                result := Erro;
                MsgErro := 'Erro na captura do protocolo da NFC-e! ';

                if (Status <> '') and (xMotivo <> '') then
                  MsgErro := MsgErro + sLineBreak + 'Status: ' + Status + ' - ' + xMotivo;

                MensagemErro_(MsgErro, ExibirMsgNFe, ArqRetorno);

              end
              else
                result := ArquivosRetornados;

            finally
      //        XMLDocument.free;
            end;





            {
            StatusLote := ValorRetornoXML(ArqRetorno, 'cStat', ExibirMsgNfe);
            MotivoLote := ValorRetornoXML(ArqRetorno, 'xMotivo', ExibirMsgNfe);




            Conforme observações acima o modo síncrono não retorna o nrec ou o arquivo '-rec.xml', somente o '-pro-rec.xml' contendo já diretamente o
            número do protocolo

            if NumRecibo = '' then
            begin
              Result := Erro;
              if usuariologin.suporte then
                MensagemErro_('Erro na captura do número do recibo do lote: não retornado pelo Sefaz. Status: '+StatusLote+' Motivo: '+MotivoLote, ExibirMsgNFe, ArqRetorno);
            end
            else

            }



          end
          else
          if FileExists(ArqErro) then
          begin
            result := Erro;
            try
              CopiaTemporaria(FDirRetorno,ArqErro);
              AssignFile(ArqResp,FDirRetorno+nfe_temp);
              FileMode := 0;
              Reset(ArqResp);
              MsgErro := '';
              while not Eof(ArqResp) do
              begin
                Readln(ArqResp, Linha);
                MsgErro := MsgErro + Linha + sLineBreak
              end;
              CloseFile(ArqResp);
              DeleteFile(FDirRetorno+nfe_temp)
            except
              on E: Exception do MensagemAviso_(E.Message + 'ErroRetornoReciboNFe!' +
                                               sLineBreak + ArqErro, false, ExibirMsgNFe)
            end;
//            MensagemErro(MsgErro)
          end;

          ArquivodeRetornoouErroProcessado := true;

        end;
      until TempoEsgotado(vTempoInicial) or ArquivodeRetornoouErroProcessado;

      if (((result<>Erro) and not ArquivodeRetornoouErroProcessado) or //tempo
         (result = Erro)) and PermitirContingencia then
      begin
        if usuariologin.suporte then
        begin
          if result = erro then
            botao := MensagemSimNaoOpcaoCancelarmmo('Erro na captura do número do recibo do lote:'+chr(13)+
                                                     'Arquivo de erro '+ ArqErrO +' foi retornado. Deseja entrar em modo de contingência off line?',
                                                     'Reiniciar o UNINFE', false, 'Aguardar', 'Entrar em Contingência', msgErro)
          else
            botao := MensagemSimNaoOpcaoCancelarmmo('Erro na captura do número do recibo do lote:'+chr(13)+
                                                    'Arquivo de retorno '+ ArqRetorno +' não retornado.', 'Reiniciar o UNINFE', false, 'Aguardar', 'Entrar em Contingência',
                                                    'Excedeu-se o limite de espera de '+inttostr(parsistema.TempoEsperaNFCe)+' segundos. '+ sLineBreak +
                                                    'Deseja continuar aguardando o retorno do arquivo ou entrar em modo de contingência off line?');


          if botao = mrNO then
          begin
            result := EntraremContingencia;
            break;
          end
          else
          if botao = mrOK then
            ReiniciarUNINFE;

        end
        else
        begin
          result := EntraremContingencia;
          break;
        end;

      end
      else
        break;

    end;
  end;

end;



{
