procedure TTecNotaFiscalEletronica.SetTipo_de_Emissao_UniNfe(
  const Value: String);
var
  ArqRetorno, ArqUniNfeConfig : String;
  xmlconf: TextFile;
  ArquivoCFG: TIniFile;
  vDataHora : TDateTime;
  vDataHoraInicialContingenciaNFCe : String;
  vtpEmisConfigurado : String;
begin
  try

    vDataHora := vDataHoraServidor;
    {
    ArqRetorno := FDirRetorno + 'uninfe-ret-alt-con.xml';
    ArqUniNfeConfig := Trocar(FDirEnvio,'Envio\','UniNfeConfig.xml');

    if FileExists(ArqUniNfeConfig) then
      vtpEmisConfigurado := ValorRetornoXML(ArqUniNfeConfig, 'tpEmis');
    }

    fTipo_de_Emissao_UniNfe := Value;

    {
    if Value <> vtpEmisConfigurado then
    begin
      AssignFile(xmlconf, FDirEnvio+nfeconf_temp);
      Rewrite(xmlconf);
      Write(xmlconf, '<?xml version="1.0" encoding="UTF-8"?>');
      write(xmlconf, '<altConfUniNFe>');
      write(xmlconf, '<tpEmis>'+value+'</tpEmis>');
      write(xmlconf, '</altConfUniNFe>');

      CloseFile(xmlconf);
      RenameFile(FDirEnvio+nfeconf_temp,FDirEnvio +'uninfe-alt-con.xml');

      repeat
      until FileExists(ArqRetorno) and
            not FileIsOpen(ArqRetorno) and
           (FileDateToDateTime(FileAge(ArqRetorno)) >= vDataHora);
    end;
    }

    if (Value='9') then
      parsistema.DataHoraInicialContingenciaNFCe := datetimetostr(vdatahoraservidor)
    else
    if (Value='1') then
      parsistema.DataHoraInicialContingenciaNFCe := '';

    if FileExists(NomeArquivoCFG) then
    begin
      try
        ArquivoCFG := TIniFile.Create(NomeArquivoCFG);

        vDataHoraInicialContingenciaNFCe := ArquivoCFG.ReadString('NFCe','DataHoraInicialContingenciaNFCe', '');

        if vDataHoraInicialContingenciaNFCe <> parsistema.DataHoraInicialContingenciaNFCe then
        begin
          ArquivoCFG.WriteString('NFCe','DataHoraInicialContingenciaNFCe', parsistema.DataHoraInicialContingenciaNFCe);
          ArquivoCFG.WriteString('NFCe','RazaoContingenciaNFCe', parsistema.RazaoContingenciaNFCe);
          ArquivoCFG.UpdateFile;
        end;

      finally
        ArquivoCFG.Free;
      end;
    end;
  except
      on E: Exception do MensagemAviso_(E.Message + 'Erro troca forma emissão.' +
                                       sLineBreak + ArqRetorno, false, ExibirMsgNFe)
  end;
end;

function TTecNotaFiscalEletronica.TempoNFCeEsgotado(nTempos: integer = 1): boolean;
  function TempoAtual : DWORD;
  begin
    result := Ticks64;
  end;
begin
  if  (TempoAtual >= vTempoInicial) and ((TempoAtual - vTempoInicial) < ((parsistema.TempoEsperaNFCe*1000)*nTempos)) then
    result := false
  else
    result := true;
end;

function TTecNotaFiscalEletronica.ConsultarSituacaoLoteNFCe(Recibo, Lote: String;
  var Protocolo, Status, DataHoraProcessamento: String; Ambiente: String;
  SomenteRetorno: Boolean): TtecRetornoEnvioNFCe;
var
  Linha,
  MsgErro,
  ArqEnvioSitLote,
  ArqRetorno,
  ArqErro,
  StatusLote,
  MotivoLote,
  StatusNFe,
  MotivoNFe: String;
  ArqResp: TextFile;
{  Tentativas: Integer;}
  ArqINI: TIniFile;
  ArquivodeRetornoouErroProcessado : Boolean;
  ProtocoloCancelamento : String;
  botao : TModalResult;

  procedure BuscarProtocoloNFCe;
  var
    Linha,
    Conteudo: String;
    PosI, PosF: Integer;
    Arq: TextFile;
  begin
    Sleep(delay);
    try
      CopiaTemporaria(FDirRetorno,ArqRetorno);
      AssignFile(Arq, FDirRetorno+nfe_temp);
      FileMode := 0;
      Reset(Arq);
      repeat
        Readln(Arq, Linha);
        Conteudo := Conteudo + Linha;
      until Eof(Arq);
      CloseFile(Arq);
      DeleteFile(FDirRetorno+nfe_temp)
    except
      on E: Exception do MensagemAviso_(E.Message + 'ErroBuscarProtocoloNFe!' +
                                       sLineBreak + ArqRetorno, false, ExibirMsgNFe)
    end;
    PosI := Pos('<cStat>' ,Conteudo)+7;
    PosF := Pos('</cStat>',Conteudo);
    StatusLote := Copy(Conteudo,PosI,PosF-PosI);
    Delete(Conteudo,PosI-7,PosF-PosI+15);
    PosI := Pos('<xMotivo>' ,Conteudo)+9;
    PosF := Pos('</xMotivo>',Conteudo);
    MotivoLote := Copy(Conteudo,PosI,PosF-PosI);
    Delete(Conteudo,PosI-9,PosF-PosI+19);

    if pos('<protNFe',Conteudo) > 0 then
    begin
      PosI := Pos('<nProt>',Conteudo)+7;
      PosF := Pos('</nProt>',Conteudo);
      Protocolo := Copy(Conteudo,PosI,PosF-PosI);

      PosI := Pos('<dhRecbto>',Conteudo)+10;
      PosF := Pos('</dhRecbto>',Conteudo);
      DataHoraProcessamento := trocar(Copy(Conteudo,PosI,PosF-PosI),'T',' ');

      PosI := Pos('<cStat>' ,Conteudo)+7;
      PosF := Pos('</cStat>',Conteudo);
      StatusNFe := Copy(Conteudo,PosI,PosF-PosI);
      PosI := Pos('<xMotivo>' ,Conteudo)+9;
      PosF := Pos('</xMotivo>',Conteudo);
      MotivoNFe := Copy(Conteudo,PosI,PosF-PosI)
    end
  end;

  function VerificaProtocoloNFCe : boolean;
  begin
    result := false;
    BuscarProtocoloNFCe;

    if (StatusLote <> nfeLoteEmProcessamento) or (protocolo='') then
    begin
      status := StatusNFe;
      Result := Protocolo <> '';
      if not Result then
      begin
        MsgErro := 'Erro no processo de consulta do protocolo!';
        if StatusLote <> '' then
          MsgErro := MsgErro + sLineBreak + 'Status Lote: ' + StatusLote + ' - ' + MotivoLote;
        if StatusNFe <> '' then
          MsgErro := MsgErro + sLineBreak + 'Status NFe : ' + StatusNFe  + ' - ' + MotivoNFe;
        MensagemAviso_(MsgErro, false, ExibirMsgNFe)
      end
      else
      if StatusLote = nfeUsoDenegado then
      begin
        Result := false;
        MsgErro := 'A nota fiscal esta denegada!';
        if StatusLote <> '' then
          MsgErro := MsgErro + sLineBreak + 'Status Lote: ' + StatusLote + ' - ' + MotivoLote;
        if StatusNFe <> '' then
          MsgErro := MsgErro + sLineBreak + 'Status NFe : ' + StatusNFe  + ' - ' + MotivoNFe;
        MensagemAviso_(MsgErro, false, ExibirMsgNFe)
      end;
    end
  end;

begin
//sleep(delay);

  while true do
  begin

    Result     := Aguardar;

    ArqEnvioSitLote   := FDirEnvio   + Recibo + '-ped-rec.xml';
    ArqRetorno := FDirRetorno + Recibo + '-pro-rec.xml';
    ArqErro    := FDirRetorno + Recibo + '-pro-rec.err';

    StatusNFe  := '';
    StatusLote := nfeLoteEmProcessamento;
    MotivoNFe  := '';
    MotivoLote := '';
    MsgErro    := '';
    ArquivodeRetornoouErroProcessado := false;

    while true do
    begin
      IniciarTempo(vTempoInicial);
      repeat
        if (FileExists(ArqRetorno) and
           (FileDateToDateTime(FileAge(ArqRetorno)) >= vDataHoraLote)) or

          (FileExists(ArqErro) and
           (FileDateToDateTime(FileAge(ArqErro)) >= vDataHoraLote)) then

        begin
          if FileExists(ArqRetorno) then
          begin
            if VerificaProtocoloNFCe then
              result := ArquivosRetornados
            else
              result := Erro;
          end
          else
          if FileExists(ArqErro) then
          begin
            try
              CopiaTemporaria(FDirRetorno,ArqErro);
              AssignFile(ArqResp,FDirRetorno+nfe_temp);
              FileMode := 0;
              Reset(ArqResp);
              MsgErro := '';
              while not Eof(ArqResp) do
              begin
                Readln(ArqResp, Linha);
                MsgErro := MsgErro + Linha + sLineBreak
              end;
              CloseFile(ArqResp);
              DeleteFile(FDirRetorno+nfe_temp);

            except
              on E: Exception do MensagemAviso_(E.Message + 'LerRetornoSituaçãoLote!' +
                                               sLineBreak + ArqErro, false, ExibirMsgNFe)
            end;

//            MensagemErro(MsgErro);
            result := Erro;

          end;

          ArquivodeRetornoouErroProcessado := true;

        end;
      until TempoNFCeEsgotado or ArquivodeRetornoouErroProcessado;
        break;
    end;


    if (result = Aguardar) and not ArquivodeRetornoouErroProcessado then
    begin

      while true do
      begin

        if FileExists(ArqEnvioSitLote) then
          DeleteFile(ArqEnvioSitLote);

        if FileExists(ArqRetorno) then
          DeleteFile(ArqRetorno);

        if FileExists(ArqErro) then
          DeleteFile(ArqErro);

        try
          AssignFile(xml, FDirEnvio+nfe_temp);
          Rewrite(xml);
          Write(xml, '<?xml version="1.0" encoding="UTF-8"?>');
          AbreTag('consReciNFe', ['versao','xmlns'],
                                 ['4.00',
                                  'http://www.portalfiscal.inf.br/nfe']);

          TagCompleta('tpAmb',Ambiente);
          TagCompleta('nRec', Recibo);
          FechaTag('consReciNFe');
          CloseFile(xml);
          repeat until RenameFile(FDirEnvio+nfe_temp, ArqEnvioSitLote);

        except
          on E: Exception do MensagemAviso_(E.Message + 'ConsultarSituçãoLoteNFe!' +
                                           sLineBreak + ArqEnvioSitLote, false, ExibirMsgNFe)
        end;

        IniciarTempo(vTempoInicial);

        ArquivodeRetornoouErroProcessado := false;

        repeat

          if (FileExists(ArqRetorno) and
             (FileDateToDateTime(FileAge(ArqRetorno)) >= vDataHoraLote)) or

            (FileExists(ArqErro) and
             (FileDateToDateTime(FileAge(ArqErro)) >= vDataHoraLote)) then

          begin

            if FileExists(ArqRetorno) then
            begin
              if VerificaProtocoloNFCe then
                result := ArquivosRetornados
              else
                result := Erro;

            end
            else
            if FileExists(ArqErro) then
            begin
              try
                CopiaTemporaria(FDirRetorno,ArqErro);
                AssignFile(ArqResp,FDirRetorno+nfe_temp);
                FileMode := 0;
                Reset(ArqResp);
                MsgErro := '';
                while not Eof(ArqResp) do
                begin
                  Readln(ArqResp, Linha);
                  MsgErro := MsgErro + Linha + sLineBreak
                end;
                CloseFile(ArqResp);
                DeleteFile(FDirRetorno+nfe_temp);
              except
                on E: Exception do MensagemAviso_(E.Message + 'LerRetornoSituaçãoLote!' +
                                                 sLineBreak + ArqErro, false, ExibirMsgNFe)
              end;
//              MensagemErro(MsgErro);
              result := Erro;
            end;
            ArquivodeRetornoouErroProcessado := true;
          end;

        until TempoNFCeEsgotado or ArquivodeRetornoouErroProcessado;
          break;
      end;

    end;

    if ((result<>Erro) and not ArquivodeRetornoouErroProcessado) or (result = erro) then
    begin
      if usuariologin.suporte then
      begin
        if result = erro then
          botao := MensagemSimNaoOpcaoCancelarmmo('Arquivo de erro '+ ArqErro +' foi retornado. Deseja entrar em modo de contingência off line?',
                                                   'Reiniciar o UNINFE', false, 'Aguardar', 'Entrar em Contingência', msgErro)


        else
          botao := MensagemSimNaoOpcaoCancelarmmo('Arquivo de retorno '+ ArqRetorno +' não retornado.'
                                         , 'Reiniciar o UNINFE', false, 'Aguardar', 'Entrar em Contingência',
                                         'Excedeu-se o limite de espera de '+inttostr(parsistema.TempoEsperaNFCe)+' segundos. '+ sLineBreak +
                                         'Deseja continuar aguardando o retorno do arquivo ou entrar em modo de contingência off line?');
        if botao = mrNO then
        begin
          result := EntraremContingencia;
          break;
        end
        else
        if botao = mrOK then
          ReiniciarUNINFE;

      end
      else
      begin
        result := EntraremContingencia;
        break;
      end;
    end
    else
      break;
  end;
end;

function TTecNotaFiscalEletronica.Getnfeconf_temp: String;
begin
  result := 'nfeconf_'+inttostr(PIDOriginal)+'.tmp'; // ARQUIVO TEMPORARIO PARA LEITURA
end;

function TTecNotaFiscalEletronica.VerificarStatusServicoNFCe(
  Ambiente: String): TtecRetornoEnvioNFCe;
var
  Linha,
  MsgErro,
  DataTHora,
  ArqEnvio,
  ArqRetorno,
  ArqErro: String;
  ArqResp: TextFile;
  DataHora: TDateTime;
  botao : TmodalResult;
  vResult : Boolean;
begin  // AAAAMMDDTHHMMSS-ped-sta.xml

  result := Aguardar;

  DataHora   := DataHoraLocal;
  DataTHora  := FormatDateTime('yyyymmdd',DataHora) + 'T' + FormatDateTime('hhnnss',DataHora);
  ArqEnvio   := FDirEnvio   + DataTHora   + '-ped-sta.xml';
  ArqRetorno := FDirRetorno + DataTHora   + '-sta.xml';
  ArqErro    := FDirRetorno + DataTHora   + '-sta.err';

  try
    if FileExists(ArqEnvio) then
      DeleteFile(ArqEnvio);
    if FileExists(ArqErro) then
      DeleteFile(ArqErro);
    AssignFile(xml, FDirEnvio+nfe_temp);
    Rewrite(xml);
    Write(xml, '<?xml version="1.0" encoding="UTF-8"?>');
    {
    AbreTag('consStatServ', ['xmlns:xsi','xmlns:xsd','versao','xmlns'],
                            ['http://www.w3.org/2001/XMLSchema-instance',
                             'http://www.w3.org/2001/XMLSchema', '4.00',
                             'http://www.portalfiscal.inf.br/nfe']);
                             }

    AbreTag('consStatServ', ['versao','xmlns'],
                            ['4.00', 'http://www.portalfiscal.inf.br/nfe']);
    TagCompleta('tpAmb',Ambiente);
    TagCompleta('cUF','42'); // CODIGO DO ESTADO "SC" NO CADASTRO DO IBGE
    TagCompleta('xServ','STATUS');
    FechaTag('consStatServ');
    CloseFile(xml);
    repeat until RenameFile(FDirEnvio+nfe_temp,ArqEnvio);

  except
    on E: Exception do MensagemAviso_(E.Message + 'VerificarStatusServiçoNFe!' +
                                     sLineBreak + ArqEnvio, false, ExibirMsgNFe)
  end;


  while true do
  begin
    IniciarTempo(vTempoInicial);

    repeat
    until FileExists(ArqRetorno) or
          FileExists(ArqErro) or
          TempoNFCeEsgotado(2);


    if FileExists(ArqRetorno) or FileExists(ArqErro) then
    begin
      vResult := FileExists(ArqRetorno);

      if not vResult then
      begin
{        if TempoNFCeEsgotado(2) then
        begin  retirado pois fica em loop ao reiniciaar o tempo...}
          try
            CopiaTemporaria(FDirRetorno,ArqErro);
            AssignFile(ArqResp,FDirRetorno+nfe_temp);
            FileMode := 0;
            Reset(ArqResp);
            MsgErro := '';
            while not Eof(ArqResp) do
            begin
              Readln(ArqResp, Linha);
              MsgErro := MsgErro + Linha + sLineBreak
            end;
            CloseFile(ArqResp);
            DeleteFile(FDirRetorno+nfe_temp);

          except
            on E: Exception do MensagemAviso_(E.Message + 'InterpretarRespostaStatus!' +
                                             sLineBreak + ArqErro, false, ExibirMsgNFe)
          end;

          result := Erro;
  //        MensagemErro(MsgErro)

          if usuariologin.suporte then
          begin
            botao := MensagemSimNaoOpcaoCancelarmmo('Arquivo de erro '+ ArqErro +' retornado. O serviço esta fora de operação.'+ sLineBreak +
                                                       'Deseja continuar aguardando o retorno do arquivo ou entrar em modo de contingência off line?',
                                                       'Reiniciar o UNINFE', true, 'Aguardar', 'Entrar em Contingência',
                                                       MsgErro);
            if botao = mrNO then
            begin
              result := EntraremContingencia;
              break
            end
            else
            if botao = mrcancel then
              break
            else
            if botao = mrOK then
              ReiniciarUNINFE
          end
          else
          begin
            result := EntraremContingencia;
            break
          end;

        {
        end;
        }

      end
      else
      begin
        Result := TesteValidacaoOK;
        break;
      end;
    end
    else
{    if TempoNFCeEsgotado(2) then}
    begin
      result := EntraremContingencia;
      {
      botao := MensagemSimNaoOpcaoCancelarmmo('Arquivo de retorno '+ ArqRetorno +' não retornado.'
                                     , '', false, 'Aguardar', 'Cancelar',
                                     'Excedeu-se o limite de espera de '+inttostr(parsistema.TempoEsperaNFCe)+' segundos. '+ sLineBreak +
                                     'Verifique se o UNINFE esta ativo. ' + sLineBreak +
                                     'Deseja continuar aguardando o retorno do arquivo?'
                                     );
      if (botao = mrNO) or (botao = mrCancel) then
      }
        break;

    end;

  end;
end;

function TTecNotaFiscalEletronica.RetornoValidacaoAssinatura: Boolean;
var
  ArqErro,
  ArqRetorno,
  Linha,
  MsgErro: String;
  ArqResp: TextFile;
  ArquivodeRetornoouErroProcessado : Boolean;
  botao : TModalResult;
  vcStat, vxMotivo : String;
begin
  result := false;
  ArqRetorno := FDirRetorno + fChaveNFe + '-nfe-ret.xml';
  ArqErro    := FDirRetorno + fChaveNFe + '-nfe-ret.err';

  ArquivodeRetornoouErroProcessado := false;

//  Sleep(delay);

  while true do
  begin
    IniciarTempo(vTempoInicial);
    repeat
      if FileExists(ArqRetorno) or
         FileExists(ArqErro) then
      begin
        if FileExists(ArqRetorno) then
        begin
          vcStat := ValorRetornoXML(ArqRetorno, 'cStat', ExibirMsgNFe);
          vxMotivo := ValorRetornoXML(ArqRetorno, 'xMotivo', ExibirMsgNFe);
          result := vcStat = '1';
          if not result then
          begin
            if vcStat = '2' then
              MensagemErro_('Ocorreu um erro ao assinar o XML', ExibirMsgNFe, ArqRetorno)
            else
            if (vcStat = '3') or (vcStat = '4') then
              MensagemErro_('Ocorreu um erro ao validar o XML', ExibirMsgNFe, ArqRetorno)
          end;
        end
        else
        if FileExists(ArqErro) then
        begin
          Result := false;
          try
            CopiaTemporaria(FDirRetorno,ArqErro);
            AssignFile(ArqResp,FDirRetorno+nfe_temp);
            FileMode := 0;
            Reset(ArqResp);
            MsgErro := '';
            while not Eof(ArqResp) do
            begin
              Readln(ArqResp, Linha);
              MsgErro := MsgErro + Linha + sLineBreak
            end;
            CloseFile(ArqResp);
            DeleteFile(FDirRetorno+nfe_temp)
          except
            on E: Exception do MensagemAviso_(E.Message + 'Função EnviarNFCe!' +
                                             sLineBreak + ArqErro, false, ExibirMsgNFe)
          end;
          MensagemErro_('O arquivo de erro '+ ArqErro +' foi retornado na assinatura da NF.'+ sLineBreak +  MsgErro, ExibirMsgNFe, ArqErro)
        end;

        ArquivodeRetornoouErroProcessado := true;

      end;
    until TempoNFCeEsgotado or ArquivodeRetornoouErroProcessado;

    if (not result) and not ArquivodeRetornoouErroProcessado then
    begin
      botao := MensagemSimNaoOpcaoCancelarmmo('Arquivo de confirmação da assinatura '+ ArqRetorno +' não retornado.', '', false, 'Aguardar', 'Cancelar',
                                              'Excedeu-se o limite de espera de '+inttostr(parsistema.TempoEsperaNFCe)+' segundos. '+ sLineBreak +
                                              'Deseja continuar aguardando a confirmação da assinatura?');
      if botao = mrNO then
      begin
        result := false;
        break;
      end
      else
      if botao = mrOK then
        ReiniciarUNINFE;

    end
    else
      break;
  end;
end;

function TTecNotaFiscalEletronica.ValorRetornoProtocoloCancelamento(ArqRetorno: String): String;
var
  Linha,
  Conteudo: String;
  PosI_Superior,PosI, PosF: Integer;
  Arq: TextFile;

 { vArqXml : txmldocument;
  Node : IXMLNode;
  }
  ACBrNFe1 : TACBrNFe;
  i: integer;
begin
  result := '';
  try
    ACBrNFe1 := TACBrNFe.create(nil);
    ACBrNFe1.EventoNFe.LerXML(ArqRetorno);
    for i:=0 to ACBrNFe1.EventoNFe.Evento.Count-1 do
    begin
      if ACBrNFe1.EventoNFe.Evento.Items[i].RetInfEvento.tpEvento = teCancelamento then
        result := ACBrNFe1.EventoNFe.Evento.Items[i].RetInfEvento.nProt;
    end;
  finally
    ACBrNFe1.free;
  end;

end;


                            (*
function GerarNotaEletronica_(qryDadosFiscais,
                              qryDadosFiscaisRef,
                              qryProdutosDadosFiscais,
                              qryProdutosDadosFiscaisCompostos,
                              qryServicosDadosFiscais,
                              qryVenctosDadosFiscais,
                              qryVolumesDadosFiscais,
                              qryLacresDadosFiscais,
                              qryImportacoes,
                              qryAdicoes : TtecQuery;
                              SerieSugestao, Tipo: String;
                              qryCupons: TTecQuery = nil;
                              Regerando: boolean = false;
                              qryContatos: TTecQuery = nil;
                              qryTotaisRecebimentos: TTecQuery = nil;
                              Procedimento : TtecProcedimento = Enviar;
                              Validando : Boolean = false;
                              qryContratos : TtecQuery = nil;
                              qryNotas : TtecQuery = nil;
                              qrymovimentos : TtecQuery = nil): Boolean;
var
  ChaveAcesso, LoteNFe, ReciboNFe, ProtocoloNFe, status, DataHoraProcessamento: String;

  function CondicaoGerarNfe: boolean;
  begin
    result := true;
    if qryContratos<>nil then
    begin
      result := (qryContratos.fieldbyname('situacao').asString = 'F') or
                (qryContratos.fieldbyname('situacao').asString = 'N') or
                (qryContratos.fieldbyname('situacao').asString = 'P');

    end;
  end;

  Function SituacaoContrato: String;
  begin
    result := 'N';
    if qryContratos<>nil then
      result := qryContratos.fieldbyname('situacao').asString;
  end;

  procedure SetarInformacoesDadosFiscais;
  begin
    qryDadosFiscais.Edit;
    qryDadosFiscais.fieldbyname('nrdocumento').AsInteger   := qryNotas.fieldbyname('numero').AsInteger;

    if qryDadosFiscais.fieldbyname('modelodocto').IsNull then
      qryDadosFiscais.fieldbyname('modelodocto').AsString  := '55';

    qryDadosFiscais.fieldbyname('infcomplementar'). asString := qryDadosFiscais.fieldbyname('observacoes').AsString + ' ' +
                                                                qryDadosFiscais.fieldbyname('observacoesicmssubstituido').AsString;

    if (fregimetributario = 1) and //simples
       (parsistema.obsnfeClientesnoSimples <> '') then
      qryDadosFiscais.fieldbyname('infcomplementar').AsString := qryDadosFiscais.fieldbyname('infcomplementar').AsString +
                                                                parsistema.obsnfeClientesnoSimples;
    qryDadosFiscais.fieldbyname('codaleatorio').AsInteger  := Aleatorio(qryDadosFiscais.fieldbyname('data').AsDateTime, qryDadosFiscais.fieldbyname('nrdocumento').asString);


    qryDadosFiscais.fieldbyname('versaolayout').AsCurrency := 3.10;
    { 0 – pagamento à vista   1 – pagamento à prazo     2 - outros }
    qryDadosFiscais.fieldbyname('formapagto').AsInteger    := 2;
    { 1-Retrato/ 2-Paisagem }
    qryDadosFiscais.fieldbyname('formatodanfe').AsInteger  := 1;
    {1-Normal/ 2-Contingência}
    qryDadosFiscais.fieldbyname('formaemissao').AsInteger  := fNFeTipoEmissao;

    ChaveAcesso := copy(fCodigoCidadeIBGEFilialBase,1,2)+                       // 2
                   FormatDateTime('YYMM',qryDadosFiscais.fieldbyname('data').AsDateTime)+      // 4
  //                                   ifthen(NFeAmbiente=2,'99999999000198',preencheString(CNPJFilialBase,'0',14,false))+  // 14
                   preencheString(fCNPJFilialBase,'0',14,false)+  // 14
                   preencheString(qryDadosFiscais.fieldbyname('modelodocto').AsString,'0',2,false)+ // 2
                   preencheString(SerieSugestao,'0',3,false)+                  // 3
                   preencheString(qryDadosFiscais.fieldbyname('nrdocumento').Asstring,'0',9,false) + // 9
                   qryDadosFiscais.fieldbyname('formaemissao').Asstring + // 1
                   preencheString(qryDadosFiscais.fieldbyname('codaleatorio').Asstring,'0',8,false); //8

    qryDadosFiscais.fieldbyname('digchaveacesso').AsString := Modulo11(ChaveAcesso);
    qryDadosFiscais.fieldbyname('chv_nfe').AsString := ChaveAcesso + qryDadosFiscais.fieldbyname('digchaveacesso').AsString;

  //             modulo11(ChaveAcesso,'98765432',false);

    {1 - PRODUÇÃO 2 - HOMOLOGAÇÃO}
    qryDadosFiscais.fieldbyname('ambiente').AsInteger      := fNFeAmbiente;// '2';

    {1 - normal 2 - compelementar}
    {if qryDadosFiscaisdadofiscalcomplementar.AsInteger=0 then
       qryDadosFiscaisfinalidadenf.AsInteger  := 1
    else
       qryDadosFiscaisfinalidadenf.AsInteger  := 2;}
    qryDadosFiscais.fieldbyname('finalidadenf').AsInteger  := 1;
    qryDadosFiscais.fieldbyname('procemissao').AsString    := '0';
    qryDadosFiscais.fieldbyname('versaoteclux').AsString   := fVersaoTecLUX;

    NFe.Executavel           := fNFeExecNFe;
    NFe.DiretorioEnvioNFSe    := fNFSeDirEnvio;
    NFe.DiretorioRetornoNFSe  := fNFSeDirRetorno;

    NFe.DiretorioEnvio       := fNFeDirEnvio;
    NFe.DiretorioEnviado     := fNFeDirEnviados;
    NFe.DiretorioRetorno     := fNFeDirRetorno;
    NFe.DiretorioCompartilha := fNfeDirCompartilha;

        // EMITENTE
    NFe.Emit_Documento := fCNPJFilialBase;
    NFe.Emit_Nome      := fRazaoFilialBase;
    NFe.Emit_Rua       := fRuaSemNumeroFilialBase;
    NFe.Emit_Nro       := fNumeroFilialBase;
    NFe.Emit_Compl     := fComplementoFilialBase;
    NFe.Emit_Bairro    := fBairroFilialBase;
    NFe.Emit_CodMun    := fCodigoCidadeIBGEFilialBase;
    NFe.Emit_Mun       := fCidadeFilialBase;
    NFe.Emit_UF        := fEstadoFilialBase;
    NFe.Emit_CEP       := fCEPFilialBase;
    NFe.Emit_Fone      := fDDDFilialBase+fFoneFilialBase;
    NFe.Emit_IE        := fInscricaoEstadualFilialBase;
    NFe.Emit_IM        := fInscricaoMunicipalFilialBase;
    NFe.Emit_CNAE      := fCNAEFiscalFilialBase;
    NFe.Emit_CRT       := fRegimeTributario;

    // DESTINATARIO

    if (SituacaoContrato[1] in ['N', 'P']) then
    begin
      NFe.Dest_TipoPessoa := qryDadosFiscais.fieldbyname('pessoatipo').AsString;
      NFe.Dest_Documento := qryDadosFiscais.fieldbyname('pessoanumero').AsString;
      NFe.Dest_Nome      := qryDadosFiscais.fieldbyname('nome').AsString;

      NFe.Dest_Rua       := qryDadosFiscais.fieldbyname('rua').AsString;
      NFe.Dest_Nro       := qryDadosFiscais.fieldbyname('endnumero').AsString;
      NFe.Dest_Compl     := qryDadosFiscais.fieldbyname('endcomplemento').AsString;
      NFe.Dest_Bairro    := qryDadosFiscais.fieldbyname('nomebairro').AsString;
      NFe.Dest_CodMun    := qryDadosFiscais.fieldbyname('cidadeibge').AsString;
      NFe.Dest_Mun       := qryDadosFiscais.fieldbyname('nomecidade').AsString;
      NFe.Dest_UF        := qryDadosFiscais.fieldbyname('estado').AsString;
      NFe.Dest_CEP       := qryDadosFiscais.fieldbyname('cep').AsString;
      NFe.Dest_CodPais   := qryDadosFiscais.fieldbyname('pais').AsInteger;
      NFe.Dest_Pais      := qryDadosFiscais.fieldbyname('nomepais').AsString;

      if (qryDadosFiscais.fieldbyname('foneddd').AsString <> '') and
         (qryDadosFiscais.fieldbyname('fonenumero').AsString <> '') then
        NFe.Dest_Fone      := qryDadosFiscais.fieldbyname('foneddd').AsString+qryDadosFiscais.fieldbyname('fonenumero').AsString
     else
        NFe.Dest_Fone      := '';

      NFe.Dest_IE        := qryDadosFiscais.fieldbyname('documento').AsString;
      NFe.Dest_ISUF      := qryDadosFiscais.fieldbyname('iesubsttributario').AsString;

      // ENTREGA
      NFe.Entrega_Documento := qryDadosFiscais.fieldbyname('localentrega_cnpj').AsString;
      NFe.Entrega_Rua       := qryDadosFiscais.fieldbyname('localentrega_rua').AsString;
      NFe.Entrega_Nro       := qryDadosFiscais.fieldbyname('localentrega_numero').AsString;
      NFe.Entrega_Compl     := qryDadosFiscais.fieldbyname('localentrega_complemento').AsString;
      NFe.Entrega_Bairro    := qryDadosFiscais.fieldbyname('localentrega_nomebairro').AsString;
      NFe.Entrega_CodMun    := qryDadosFiscais.fieldbyname('localentrega_cidadeibge').AsString;
      NFe.Entrega_Mun       := qryDadosFiscais.fieldbyname('localentrega_nomecidade').AsString;
      NFe.Entrega_UF        := qryDadosFiscais.fieldbyname('localentrega_estado').AsString;
    end
    else
    begin
      NFe.Dest_TipoPessoa := qryContratos.FieldByName('pessoatipo').AsString;
      NFe.Dest_Documento := qryContratos.FieldByName('pessoanumero').AsString;
      NFe.Dest_Nome      := qryContratos.FieldByName('nome').AsString;
      NFe.Dest_Rua       := qryContratos.FieldByName('rua').AsString;
      NFe.Dest_Nro       := qryContratos.FieldByName('endnumero').AsString;
      NFe.Dest_Compl     := qryContratos.FieldByName('endcomplemento').AsString;

      if qryContratos.FieldByName('estado').AsString = '.' then
      begin
        NFe.Dest_CodPais := qryContratos.FieldByName('codigoibgecidadedest').AsInteger;
        NFe.Dest_Pais  := qryContratos.FieldByName('nomecidade').AsString;
        NFe.Dest_Mun  := qryContratos.FieldByName('nomebairro').AsString;
        NFe.Dest_Bairro := '';
        NFe.Dest_CodMun := '';
        NFe.Dest_CEP := '';
      end
      else
      begin
        NFe.Dest_CodPais  := 1058;
        NFe.Dest_Pais := 'Brasil';
        NFe.Dest_Mun := qryContratos.FieldByName('nomecidade').AsString;
        NFe.Dest_Bairro := qryContratos.FieldByName('nomebairro').AsString;
        NFe.Dest_CodMun := qryContratos.FieldByName('codigoibgecidadedest').AsString;
        NFe.Dest_CEP := qryContratos.FieldByName('cep').AsString;
      end;
      NFe.Dest_UF        := qryContratos.FieldByName('estado').AsString;
      if (qryContratos.FieldByName('foneddd').AsString<>'') and
         (qryContratos.FieldByName('fonenumero').AsString<>'') then
         NFe.Dest_Fone      := qryContratos.FieldByName('foneddd').AsString+qryContratos.FieldByName('fonenumero').AsString
      else
         NFe.Dest_Fone := '';

      NFe.Dest_IE        := qryContratos.FieldByName('iddocumento').AsString;
//        NFe.Dest_ISUF      := qryDadosFiscais.fieldbyname('iesubsttributario').AsString;

      // ENTREGA
      NFe.Entrega_Documento := qryContratos.FieldByName('pessoanumero').AsString;
      NFe.Entrega_Rua       := qryContratos.FieldByName('entrua').AsString;
      NFe.Entrega_Nro       := qryContratos.FieldByName('entnumero').AsString;
      NFe.Entrega_Compl     := qryContratos.FieldByName('entcomplemento').AsString;
      NFe.Entrega_Bairro    := qryContratos.FieldByName('nomebairroentrega').AsString;
      NFe.Entrega_CodMun    := qryContratos.FieldByName('codigoibgecidadeentrega').AsString;
      NFe.Entrega_Mun       := qryContratos.FieldByName('nomecidadeentrega').AsString;
      NFe.Entrega_UF        := qryContratos.FieldByName('entestado').AsString;
    end;
    nfe.Validando := Validando;
  end;

begin
  if CondicaoGerarNfe then
  begin
    InstanciarNFE;
    NFE.CriarListaErro(TtecDatabase(qryDadosFiscais.Database));
    if not Validando then
      SetarInformacoesDadosFiscais;

    try
      try
        if not Validando then
        begin
          ShowProcessando('Gerando o arquivo da NF-e!');
          Sleep(500);
        end;

        Result := NFe.GerarNFe(qryDadosFiscais,nil,qryProdutosDadosFiscais, qryProdutosDadosFiscaisCompostos,
                     qryServicosDadosFiscais, qryVenctosDadosFiscais,qryVolumesDadosFiscais,
                     nil,nil,nil,SerieSugestao,'S',qryCupons, false, qrycontatos );

        if Result and not Validando then
        begin
          {
          if (TipoContratoServico in [ComServico, SoServico]) then
          begin
          }

            if fNFeTipoEmissao in [1,3] then
            begin
              ShowProcessando;
              ShowProcessando('Verificando status do serviço NF-e!');
              Sleep(500);
              Result := NFe.VerificarStatusServico(IntToStr(fNFeAmbiente));
              if Result then
              begin
                ShowProcessando;
                ShowProcessando('Processando o arquivo de envio da NF-e!');
                Sleep(500);
                Result := NFe.EnviarNFe(ChaveAcesso + qryDadosFiscais.FieldByName('digchaveacesso').AsString, LoteNFe, ReciboNFe);
                if Result then
                begin
                  qryDadosFiscais.Edit;
                  qryDadosFiscais.FieldByName('numlotenfe').AsString   := LoteNFe;
                  qryDadosFiscais.FieldByName('numrecibonfe').AsString := ReciboNFe;
                  qryDadosFiscais.Post;
                  Result := perpetrar_([qryDadosFiscais]);
                  if Result then
                  begin
                    ShowProcessando;
                    ShowProcessando('Consultando o arquivo de retorno da NF-e!');
                    Sleep(500);
                    Result := NFe.ConsultarSituacaoLote(ReciboNFe, ProtocoloNFe, status, DataHoraProcessamento, IntToStr(fNFeAmbiente));
                    if Result then
                    begin
                      qryDadosFiscais.Edit;
                      qryDadosFiscais.FieldByName('numprotocolonfe').AsString := ProtocoloNFe;
                      qryDadosFiscais.FieldByName('statusnfe').AsString := status;
                      qryDadosFiscais.FieldByName('dhprocnfe').Asdatetime := FormatarTimeStamp(DataHoraProcessamento);
                      qryDadosFiscais.Post;

                      if (qryDadosFiscais.FieldByName('statusnfe').AsString = '301') or
                         (qryDadosFiscais.FieldByName('statusnfe').AsString = '302') then
                      begin
                        LimparCampos(qryProdutosDadosFiscais, [qryProdutosDadosFiscais.fieldbyname('movimento')]);
                        qryDadosFiscais.Edit;
                        qryDadosFiscais.FieldByName('situacao').AsString := 'D';
                        qryDadosFiscais.Post;

//                        VoltarSituacaoContrato(SituacaoAtual, false);

                        LimparTabela(qrymovimentos);
                        Result := Perpetrar_([qryProdutosDadosFiscais, qryMovimentos, qrycontratos, qryDadosFiscais]);
                        MensagemAviso_('Nota fiscal em uso denegado.');
                      end
                      else
                      begin

                        Result := Perpetrar_([qryDadosFiscais]);

                        if Result then
                        begin

                          ShowProcessando;
                          ShowProcessando('Gerando o arquivo de compartilhamento da NF-e!');
                          Sleep(500);
                          NFe.CompartilharXML(ChaveAcesso+qryDadosFiscais.fieldbyname('digchaveacesso').AsString,
                                              ReciboNFe, qryDadosFiscais.fieldbyname('filialemissao').AsString,
                                              SerieSugestao, qryDadosFiscais.fieldbyname('nrdocumento').AsString,
                                              qryDadosFiscais.fieldbyname('data').AsDateTime);
                          ShowProcessando;

                          if not fNFeVisualizarDANFE then
                            MensagemAviso_('Impressão da Nota Fiscal será iniciada.')
                          else
                            NFe.ImprimirDanfe({ChaveAcesso+qryDadosFiscaisdigchaveacesso.AsString,}
                                              qryDadosFiscais.fieldbyname('filialemissao').AsString,
                                              SerieSugestao,
                                              qryDadosFiscais.fieldbyname('nrdocumento').AsString,
                                              qryDadosFiscais.fieldbyname('localentrega_cep').AsString,
                                              qryDadosFiscais.fieldbyname('email').AsString,
                                              IntToStr(fNFeNVias), fNFeLogotipoDANFE,
                                              ParSistema.NomeImpressoraNotaMercadorias, fNFeVisualizarDANFE,
                                              qryDadosFiscais.fieldbyname('data').AsDateTime,
                                              qryProdutosDadosFiscais,
                                              fNFeExecDANFE);

                          ShowProcessando;
                          if (qryDadosFiscais.fieldbyname('email').AsString <> '')      and
                             (UsuarioLogin.PortaSmpt        <> '')      and
                             (UsuarioLogin.HostSmtp         <> '')      and
                             (UsuarioLogin.Email            <> '')      and
                             (UsuarioLogin.SenhaEmail       <> '')      and
                             EmailValido(qryDadosFiscais.fieldbyname('email').AsString) then
                          begin
                            ShowProcessando('Enviando email para o cliente');
                            try
                              if not NFe.EnviarEmail(UsuarioLogin.Email,qryDadosFiscais.fieldbyname('email').AsString,
                                                  qryDadosFiscais.fieldbyname('nrdocumento').AsString, SerieSugestao, IntToStr(fFilialBase),
                                                  fNomeFilialBase, fRazaoFilialBase, fCNPJFilialBase, fDDDFilialBase, fFoneFilialBase,
                                                  fDDDFaxFilialBase, fFaxFilialBase, UsuarioLogin.NomeUsuario, UsuarioLogin.PortaSMPT,
                                                  UsuarioLogin.HostSMTP, UsuarioLogin.UsuarioEmail, UsuarioLogin.SenhaEmail,
                                                  qryDadosFiscais.fieldbyname('data').AsDateTime, qryDadosFiscais.fieldbyname('valortotal').AsCurrency,
                                                  UsuarioLogin.AutenticarSMTP, qryDadosFiscais.fieldbyname('data').AsDateTime) then
                                    MensagemAviso_('Ocorreu um erro inesperado no envio do email')
                            finally
                                  ShowProcessando;
                            end;
                          end;

                        end
                        else
                          ShowProcessando;

                      end;
                    end
                    else
                      ShowProcessando;
                  end
                  else
                    showProcessando;
                end
                else
                  ShowProcessando;
              end
              else
                ShowProcessando;

            end;

            {
          end
          else
          begin
            ShowProcessando;
            ShowProcessando('NFS-e gerada com sucesso !');
            Sleep(1000);
            ShowProcessando;
          end;
          }

        end;
      except
         on E : Exception do
         begin
            MensagemAviso_(E.ClassName + 'erro na emissão da NFE: ' + E.Message);
            Result := False;
         end;
      end;
    finally
      FreeAndNil(NFe); //NFe.Free;
    end;



  end;
end;

                              *)
class function TTecNotaFiscalEletronica.GerarPDF(ArqXml: String): String;
var
  NFeRTXT: TNFeRTXT;
  ACBrNFe1: TACBrNFe;
  DANFE1 :  TACBrNFeDANFERL;
  sFile : String;

{  ACBrNFSe1: TACBrNFSe;
  ACBrNFSeDANFSeRL1: TACBrNFSeDANFSeRL;
  }

begin
  sFile := '';
  if fileExists(ArqXml) then
  begin
    (*
    if ftipoemissaonfeservico = Florianopolis_SoftPlan then
    begin
      ACBrNFSeDANFSeRL1 := TACBrNFSeDANFSeRL.create(nil);
      ACBrNFSeDANFSeRL1.PathPDF := ExtractFilePath(ArqXml);
      ACBrNFSeDANFSeRL1.Logo := fNFeLogotipoDANFE;

      ACBrNFSe1 := TACBrNFSe.create(nil);

      ACBrNFSe1.NotasFiscais.Clear;
      ACBrNFSe1.NotasFiscais.LoadFromFile(Arqxml);
      ACBrNFSe1.DANFSE := ACBrNFSeDANFSeRL1;

      sFile := ACBrNFSe1.DANFSE.PathPDF +
                       StringReplace(ACBrNFSe1.NotasFiscais.Items[0].NFSe.InfID.ID,'NFSe', '', [rfIgnoreCase])
                       + '-nfse';

      if not FileExists(sFile+'.xml') then
        CopyFileTo(ArqXml,sFile+'.xml');

//      if parsistema.gerarArquivopdfnfe then
        if not FileExists(sFile+'.pdf') then
          ACBrNFSe1.NotasFiscais.ImprimirPDF;

      DANFE1.free;
      ACBrNFe1.free;


    end
    else
    begin
    *)

      DANFE1 := TACBrNFeDANFERL.create(nil);
      DANFE1.PathPDF := ExtractFilePath(ArqXml);
      DANFE1.Logo := fNFeLogotipoDANFE;


      ACBrNFe1 := TACBrNFe.create(nil);

      ACBrNFe1.NotasFiscais.Clear;
      //tenta TXT
      ACBrNFe1.NotasFiscais.Add;

    //  if not Assigned(NFeRTXT) then
        NFeRTXT := TNFeRTXT.Create(ACBrNFe1.NotasFiscais.Items[0].NFe);

    //  NFeRTXT.ConteudoArquivo
      NFeRTXT.CarregarArquivo(ArqXml);

      if NFeRTXT.LerTxt then
         NFeRTXT.Free
      else
      begin
         NFeRTXT.Free;

         //tenta XML
         ACBrNFe1.NotasFiscais.Clear;
         try
            ACBrNFe1.NotasFiscais.LoadFromFile(ArqXml);
         except
            on E: Exception do
            begin
              ShowMessage(E.Message);
              exit;
            end;
         end;

      end;

//      ACBrNFe1.NotasFiscais.Clear;
//      ACBrNFe1.NotasFiscais.LoadFromFile(ArqXml);
      ACBrNFe1.DANFE := DANFE1;

      sFile := ACBrNFe1.DANFE.PathPDF +
                       StringReplace(ACBrNFe1.NotasFiscais.Items[0].NFe.infNFe.ID,'NFe', '', [rfIgnoreCase])
                       + '-nfe';

      if not FileExists(sFile+'.xml') then
        CopyFileTo(ArqXml,sFile+'.xml');

      if parsistema.gerarArquivopdfnfe then
        if not FileExists(sFile+'.pdf') then
          ACBrNFe1.NotasFiscais.ImprimirPDF;

      DANFE1.free;
      ACBrNFe1.free;

    {end;}

  end;

  result := sFile;

end;

function TTecNotaFiscalEletronica.GerarPDFCartaCorrecao(
  ArqXml: String): String;
var
  ACBrNFe1: TACBrNFe;
  DANFE1 :  TACBrNFeDANFERL;
  sFile : String;
begin
  sFile := '';
  if fileExists(ArqXml) then
  begin
    DANFE1 := TACBrNFeDANFERL.create(nil);
    DANFE1.PathPDF := ExtractFilePath(ArqXml);
    DANFE1.Logo := fNFeLogotipoDANFE;

    ACBrNFe1 := TACBrNFe.create(nil);
//    ACBrNFe1.EventoNFe.Clear;
    ACBrNFe1.EventoNFe.LerXML(ArqXml);

    ACBrNFe1.DANFE := DANFE1;

    sFile := StringReplace(ACBrNFe1.EventoNFe.Evento[0].InfEvento.id,'ID', '', [rfIgnoreCase]);

//    insert('_', sFile, length(sFile)-1);
    sFile := sFile + '-procEventoNFe';
    sFile := ACBrNFe1.DANFE.PathPDF + sFile;

    if not FileExists(sFile+'.xml') then
      CopyFileTo(ArqXml,sFile+'.xml');

    if parsistema.gerarArquivopdfnfe then
      if not FileExists(sFile+'.pdf') then
        ACBrNFe1.DANFE.ImprimirEVENTOPDF;

    DANFE1.free;
    ACBrNFe1.free;
  end;

  result := sFile;

end;

function MensagemAviso_(const Msg: WideString;
  BloquearTeclado, ExibirMsgNFe: Boolean): TMessageButton;
begin
  if ExibirMsgNFe then
    result := MensagemAviso(msg, BloquearTeclado);
end;

function MensagemErro_(
  const Msg: WideString;
  ExibirMsgNFe: Boolean;
  CaminhoArquivo: String): TMessageButton;
begin

  result := smbIgnore;

  if ExibirMsgNFe then
    if MensagemSimNaoOpcaoCancelarmmoxml(Msg, CaminhoArquivo) = mrOK then
      result := smbOK

//    result := MensagemErro(msg);

end;

function DistribuicaoDFe(AOwner: TComponent; qryTabelaProcessamento: ttecquery;
          var vmsg: String;
          var vPararProcessamento: boolean;
          var pPassosDistribuicao: TTecPassosDistribuicao;
          qryFiliais: ttecquery;
          AchNFe: String = '';
          Tipo: String = 'NFE'): Boolean;

var
  Linha,
  MsgErro,
  ArqEnvio,
  ArqRetorno,
  ArqRetornoDFE,
  ArqRetornoDFE2,

  ArqRetornoprocNFe,
  ArqRetornoprocNFe2,
  ArqRetornoprocNFe3,

  ArqErro,
  Retorno,
  StatusGeral : String;
  ArqResp: TextFile;
  PosI, PosF: Integer;

//  vXMLDoc: TXMLDocument;
  vXMLloteDistDFeInt, vXMLresNFE: IXMLDocument;
//  infNo :IXMLNodeList;

  stPath, stPathDFe: String;

  Node_loteDistDFeInt, NodePai, NodeFilho, NodeNeto : IXMLNode;
  codigo: String;
//  nome2 : olestr;

  vcStat,
  vXcStat,
  vdhResp,
  vultNSU, vNSU_, maxNSU_ : String;

  vTempoInicial : DWORD;

  i,j,k: integer;

  vConteudoArq : tStringList;
  vqryNSU, vqryNSUXML : TTecQuery;


              procedure GravarNSU(eHoxml : Boolean);
              begin

                if (assigned(vqryNSU)) and
                   (vqryNSU.state in ([dsedit, dsinsert])) then
                begin
                  vqryNSU.post;
                  vqryNSU.Transaction.Commit;

                  if tipo = 'CTE' then
                  begin

                    if not assigned(vqryNSUXML) then
                    begin
                      vqryNSUXML := ttecquery.Create(nil);
                      vqryNSUXML.Database := qryTabelaProcessamento.Database;
                      vqryNSUXML.Transaction := qryTabelaProcessamento.Transaction;
                      vqryNSUXML.RequestLive := true;
                    end;

                    vqryNSUXML.Sql.text := format('select cnpj, nsu, tipo, xmlnfe, xmleveciencia '+
                       ' from nsus where nsus.cnpj = %s and nsus.nsu = %s and nsus.tipo = %s ',
                       [quotedstr(qryTabelaProcessamento.FieldByName('cnpj').asString),
                       quotedstr(vNSU_),
                       quotedstr(tipo)]);

                    vqryNSUXML.close;
                    vqryNSUXML.open;

                    if vqryNSUXML.recordcount = 1 then
                    begin
                      vqryNSUXML.edit;

                      if eHoxml then
                        vqryNSUXML.fieldbyname('xmlnfe').asString := vXMLresNFE.XML.Text
                      else
                        vqryNSUXML.fieldbyname('xmleveciencia').asString := vXMLresNFE.XML.Text;

                      vqryNSUXML.post;

                      vqryNSUXML.Transaction.Commit;
                    end;

                  end
                  else
                  if tipo = 'NFE' then
                  begin

                    if not assigned(vqryNSUXML) then
                    begin
                      vqryNSUXML := ttecquery.Create(nil);
                      vqryNSUXML.Database := qryTabelaProcessamento.Database;
                      vqryNSUXML.Transaction := qryTabelaProcessamento.Transaction;
                      vqryNSUXML.RequestLive := true;
                    end;

                    vqryNSUXML.Sql.text := format('select cnpj, nsu, tipo, xmlnfe, xmleveciencia '+
                       ' from nsus where nsus.cnpj = %s and nsus.nsu = %s and nsus.tipo = %s ',
                       [quotedstr(qryTabelaProcessamento.FieldByName('cnpj').asString),
                       quotedstr(vNSU_),
                       quotedstr(tipo)]);

                    vqryNSUXML.close;
                    vqryNSUXML.open;

                    if vqryNSUXML.recordcount = 1 then
                    begin
                      vqryNSUXML.edit;

                      if eHoxml then
                        vqryNSUXML.fieldbyname('xmlnfe').asString := vXMLresNFE.XML.Text
                      else

                        if vXMLresNFE.XML.Text<>'' then
                          vqryNSUXML.fieldbyname('xmleveciencia').asString := vXMLresNFE.XML.Text;


                      vqryNSUXML.post;

                      vqryNSUXML.Transaction.Commit;
                    end;

                  end;
                end;
              end;

              procedure Ler_loteDistDFeInt;
              var
              i: integer;
              begin

                stPath := ArqRetorno;
                CoInitialize(nil);
                vXMLloteDistDFeInt := TXmlDocument.Create(ArqRetorno);//declarado com a String
  //              vXMLloteDistDFeInt.LoadFromFile(ArqRetorno);

                try

  //                vXMLloteDistDFeInt.FileName:=stPath;
                  vXMLloteDistDFeInt.Active:=true;

                  Node_loteDistDFeInt := vXMLloteDistDFeInt.DocumentElement.ChildNodes.FindNode('loteDistDFeInt');  {?????????}

                  if Node_loteDistDFeInt <> nil then
                  begin
                    Node_loteDistDFeInt.ChildNodes.First;

                    for i := 0 to Node_loteDistDFeInt.ChildNodes.Count - 1 do
                    begin

                      if vPararProcessamento then
                        break;

                      vNSU_ := Node_loteDistDFeInt.ChildNodes[i].AttributeNodes['NSU'].Text;

                      if maxNSU_ = '' then
                        maxNSU_ := vNSU_;

                      if (AchNFe = '') then {quando a verificação não é pela ciencia da operação}
                      begin
                        qryTabelaProcessamento.edit;
                        if tipo = 'NFE' then
                          qryTabelaProcessamento.fieldbyname('nsu').asString := vNSU_
                        else
                        if tipo = 'CTE' then
                          qryTabelaProcessamento.fieldbyname('nsucte').asString := vNSU_;

                        qryTabelaProcessamento.post;
                      end;

                      case pPassosDistribuicao of

                      opDistribuicaoDFe:
                        vmsg := format('Capturando dados do NSU %s do arquivo de distribuição... Filial %s',
                               [tipo + ' ' +inttostr(strtoint(vNSU_))+' de um total de '+inttostr(strtoint(maxNSU_)),
                                qryTabelaProcessamento.fieldbyname('codigo').asString]);

                      opDistribuicaoDFeCienciaOPeracao,
                      opVarificacaoNSUFaltantes:
                        vmsg := format('Capturando dados do NSU %s do arquivo de distribuição... Filial %s',
                               [tipo + ' ' + inttostr(qryTabelaProcessamento.recno)+'/'+inttostr(qryTabelaProcessamento.recordcount),
                                qryTabelaProcessamento.fieldbyname('codigo').asString]);


                      end;



                      Application.ProcessMessages;

                      if not assigned(vqryNSU) then
                      begin
                        vqryNSU := ttecquery.Create(nil);
                        vqryNSU.Database := qryTabelaProcessamento.Database;
                        vqryNSU.Transaction := qryTabelaProcessamento.Transaction;
                        vqryNSU.RequestLive := true;
                      end;

                      vqryNSU.Sql.text := format('select cnpj,'+
                         ' nsu, chnfe, cnpjemitente, xnome, ie, dhemi, tpnf, vnf, digval, '+
                         ' dhrecbto, nprot, csitnfe, tipoxmlretorno, tipo '+
                         ' from nsus where nsus.cnpj = %s and nsus.nsu = %s and nsus.tipo = %s ',
                         [quotedstr(qryTabelaProcessamento.FieldByName('cnpj').asString),
                         quotedstr(vNSU_),
                         quotedstr(tipo)]);
                      vqryNSU.open;

                      if vqryNSU.recordcount = 0 then
                        vqryNSU.Append
                      else
                        vqryNSU.edit;

                      if (AchNFe = '') then {quando a verificação não é pela ciencia da operação}
                        vqryNSU.fieldbyname('cnpj').asString := qryTabelaProcessamento.fieldbyname('cnpj').asString ;

                      vqryNSU.fieldbyname('nsu').asString := vNSU_;
                      vqryNSU.fieldbyname('tipo').asString := tipo;


                      if tipo = 'NFE' then
                      begin
                        ArqREtornoDfe := FDirRetorno + '\dfe\' + qryTabelaProcessamento.fieldbyname('cnpj').asString + '-' + vNSU_ + '-nfe.xml';
                        ArqREtornoDfe2 := FDirRetorno + '\dfe\' + qryTabelaProcessamento.fieldbyname('cnpj').asString + '-' + vNSU_ + '-procNFe.xml';
                      end
                      else
                      if tipo = 'CTE' then
                      begin
                        ArqREtornoDfe := FDirRetorno + '\dfe\' + qryTabelaProcessamento.fieldbyname('cnpj').asString + '-' + vNSU_ + '-procCTe.xml';
                        ArqREtornoDfe2 := ArqREtornoDfe;
                      end;

                      IniciarTempo(vTempoInicial);
                      repeat
                      until FileExists(ArqRetornoDFe) or FileExists(ArqRetornoDFe2) or  TempoEsgotado(vTempoInicial, 100) or vPararProcessamento;

                      {Esperar 2 segundos para não dar erro concorrente entre aplicativos uninfe e erp}
                      {
                      IniciarTempo(vTempoInicial);
                      repeat
                      until TempoEsgotado(vTempoInicial,2000);
                      }
                           {
                            DE FATO EXISTEM 'BURACOS NOS DSUS ....melhor não interromper o processo
                      if not FileExists(ArqRetornoDFE) then
                        MensagemErro('Esgotado o tempo limite de espera da consulta no sefaz. Aguardando o arquivo '+
                                      ArqRetornoDFE);

                            }

                      Result := FileExists(ArqRetornoDFE) or FileExists(ArqRetornoDFE2);

                      if Result then
                      begin

                        if FileExists(ArqRetornoDFE2) then
                          stPathDFe := ArqRetornoDFe2
                        else
                        if FileExists(ArqRetornoDFE) then
                          stPathDFe := ArqRetornoDFe;


                        CoInitialize(nil);
                        vXMLresNFE := TXmlDocument.Create(stPathDFe);//declarado com a String
      //                  CoUninitialize;


                        try

                          vXMLresNFE.FileName:=stPathDFe;
                          vXMLresNFE.Active:=true;

                          if vXMLresNFE <> nil then
                          begin
                            if tipo = 'NFE' then
                            begin
                              if FileExists(ArqRetornoDFE) then
                              begin
                                vqryNSU.fieldbyname('chnfe').asString := vXMLresNFE.DocumentElement.ChildNodes.FindNode('chNFe').Text;
//                                vqryNSU.fieldbyname('cnpj').asString := vXMLresNFE.DocumentElement.ChildNodes.FindNode('CNPJ').Text

                                IF vXMLresNFE.DocumentElement.ChildNodes.FindNode('CNPJ') <> NIL THEN
                                  vqryNSU.fieldbyname('cnpjemitente').asString := vXMLresNFE.DocumentElement.ChildNodes.FindNode('CNPJ').Text
                                ELSE
                                IF vXMLresNFE.DocumentElement.ChildNodes.FindNode('CPF') <> NIL THEN
                                  vqryNSU.fieldbyname('cnpjemitente').asString := vXMLresNFE.DocumentElement.ChildNodes.FindNode('CPF').Text;

                                vqryNSU.fieldbyname('xnome').asString := vXMLresNFE.DocumentElement.ChildNodes.FindNode('xNome').Text;
                                vqryNSU.fieldbyname('ie').asString := vXMLresNFE.DocumentElement.ChildNodes.FindNode('IE').Text;
                                vqryNSU.fieldbyname('dhemi').asString := vXMLresNFE.DocumentElement.ChildNodes.FindNode('dhEmi').Text;
                                vqryNSU.fieldbyname('tpnf').asString := vXMLresNFE.DocumentElement.ChildNodes.FindNode('tpNF').Text;
                                vqryNSU.fieldbyname('vnf').asString := trocar(vXMLresNFE.DocumentElement.ChildNodes.FindNode('vNF').Text,'.',',');
                                vqryNSU.fieldbyname('digval').asString := vXMLresNFE.DocumentElement.ChildNodes.FindNode('digVal').Text;
                                vqryNSU.fieldbyname('dhrecbto').asString := vXMLresNFE.DocumentElement.ChildNodes.FindNode('dhRecbto').Text;
                                vqryNSU.fieldbyname('nprot').asString := vXMLresNFE.DocumentElement.ChildNodes.FindNode('nProt').Text;

                                {percebeu-se que nos ctes não é retornado CSitNFe... usei o cStat...}
    //                            if vXMLresNFE.ChildNodes.FindNode('cSitNFe').Text <> '' then

                                vqryNSU.fieldbyname('csitnfe').asString := vXMLresNFE.DocumentElement.ChildNodes.FindNode('cSitNFe').Text;
                                vqryNSU.fieldbyname('tipoxmlretorno').asString := 'resNFe';
    (*
                                else
                                if vXMLresNFE.ChildNodes.FindNode('cStat').Text = '100' then  {nomal}
                                  vqryNSU.fieldbyname('csitnfe').asString := '1'
                                else
                                if (vXMLresNFE.ChildNodes.FindNode('cStat').Text = '301') or   {denegada}
                                   (vXMLresNFE.ChildNodes.FindNode('cStat').Text = '302') or
                                   (vXMLresNFE.ChildNodes.FindNode('cStat').Text = '303') then
                                  vqryNSU.fieldbyname('csitnfe').asString := '2'
                                else
                                  vqryNSU.fieldbyname('csitnfe').asString := '3'; {cancelada}
                                  *)

                                GravarNSU(False);


                              end
                              else
                              if FileExists(ArqRetornoDFE2) then
                              begin

                                vqryNSU.fieldbyname('chnfe').asString :=
                                   vXMLresNFE.DocumentElement.ChildNodes.FindNode('protNFe').
                                                              ChildNodes.FindNode('infProt').
                                                              ChildNodes.FindNode('chNFe').Text;



                                vqryNSU.fieldbyname('cnpj').asString :=
                                   vXMLresNFE.DocumentElement.ChildNodes.FindNode('NFe').
                                                              ChildNodes.FindNode('infNFe').
                                                              ChildNodes.FindNode('dest').
                                                              ChildNodes.FindNode('CNPJ').Text;

                                IF vXMLresNFE.DocumentElement.ChildNodes.FindNode('NFe').
                                                              ChildNodes.FindNode('infNFe').
                                                              ChildNodes.FindNode('emit').
                                                              ChildNodes.FindNode('CNPJ') <> NIL THEN

                                vqryNSU.fieldbyname('cnpjemitente').asString :=
                                   vXMLresNFE.DocumentElement.ChildNodes.FindNode('NFe').
                                                              ChildNodes.FindNode('infNFe').
                                                              ChildNodes.FindNode('emit').
                                                              ChildNodes.FindNode('CNPJ').Text

                                ELSE
                                IF vXMLresNFE.DocumentElement.ChildNodes.FindNode('NFe').
                                                              ChildNodes.FindNode('infNFe').
                                                              ChildNodes.FindNode('emit').
                                                              ChildNodes.FindNode('CPF') <> NIL THEN
                                  vqryNSU.fieldbyname('cnpjemitente').asString := vXMLresNFE.DocumentElement.ChildNodes.FindNode('NFe').
                                                              ChildNodes.FindNode('infNFe').
                                                              ChildNodes.FindNode('emit').
                                                              ChildNodes.FindNode('CPF').Text;



                                vqryNSU.fieldbyname('xnome').asString :=
                                   vXMLresNFE.DocumentElement.ChildNodes.FindNode('NFe').
                                                              ChildNodes.FindNode('infNFe').
                                                              ChildNodes.FindNode('emit').
                                                              ChildNodes.FindNode('xNome').Text;



                                vqryNSU.fieldbyname('ie').asString :=
                                   vXMLresNFE.DocumentElement.ChildNodes.FindNode('NFe').
                                                              ChildNodes.FindNode('infNFe').
                                                              ChildNodes.FindNode('emit').
                                                              ChildNodes.FindNode('IE').Text;



                                vqryNSU.fieldbyname('dhemi').asString :=
                                   vXMLresNFE.DocumentElement.ChildNodes.FindNode('NFe').
                                                              ChildNodes.FindNode('infNFe').
                                                              ChildNodes.FindNode('ide').
                                                              ChildNodes.FindNode('dhEmi').text;

                                vqryNSU.fieldbyname('tpnf').asString :=
                                   vXMLresNFE.DocumentElement.ChildNodes.FindNode('NFe').
                                                              ChildNodes.FindNode('infNFe').
                                                              ChildNodes.FindNode('ide').
                                                              ChildNodes.FindNode('tpNF').text;

                                vqryNSU.fieldbyname('vnf').asString :=
                                   trocar(

                                   vXMLresNFE.DocumentElement.ChildNodes.FindNode('NFe').
                                                              ChildNodes.FindNode('infNFe').
                                                              ChildNodes.FindNode('total').
                                                              ChildNodes.FindNode('ICMSTot').
                                                              ChildNodes.FindNode('vNF').text, '.',',');

                                vqryNSU.fieldbyname('digval').asString :=
                                   vXMLresNFE.DocumentElement.ChildNodes.FindNode('protNFe').
                                                              ChildNodes.FindNode('infProt').
                                                              ChildNodes.FindNode('digVal').Text;

                                vqryNSU.fieldbyname('dhrecbto').asString :=
                                    vXMLresNFE.DocumentElement.ChildNodes.FindNode('protNFe').
                                                              ChildNodes.FindNode('infProt').
                                                              ChildNodes.FindNode('dhRecbto').Text;

                                vqryNSU.fieldbyname('nprot').asString :=
                                    vXMLresNFE.DocumentElement.ChildNodes.FindNode('protNFe').
                                                              ChildNodes.FindNode('infProt').
                                                              ChildNodes.FindNode('nProt').Text;

                                {percebeu-se que no -procCTE não é retornado CSitNFe... usei o cStat...}
    //                            if vXMLresNFE.ChildNodes.FindNode('cSitNFe').Text <> '' then
    //                              vqryNSU.fieldbyname('csitnfe').asString := vXMLresNFE.ChildNodes.FindNode('cSitNFe').Text
    //                            else


                                if vXMLresNFE.DocumentElement.ChildNodes.FindNode('protNFe').
                                                              ChildNodes.FindNode('infProt').
                                                              ChildNodes.FindNode('cStat').Text = '100' then  {nomal}
                                  vqryNSU.fieldbyname('csitnfe').asString := '1'
                                else
                                if (vXMLresNFE.DocumentElement.ChildNodes.FindNode('protNFe').
                                                              ChildNodes.FindNode('infProt').
                                                              ChildNodes.FindNode('cStat').Text = '301') or   {denegada}
                                   (vXMLresNFE.DocumentElement.ChildNodes.FindNode('protNFe').
                                                              ChildNodes.FindNode('infProt').
                                                              ChildNodes.FindNode('cStat').Text = '302') or
                                   (vXMLresNFE.DocumentElement.ChildNodes.FindNode('protNFe').
                                                              ChildNodes.FindNode('infProt').
                                                              ChildNodes.FindNode('cStat').Text = '303') then
                                  vqryNSU.fieldbyname('csitnfe').asString := '2'
                                else
                                  vqryNSU.fieldbyname('csitnfe').asString := '3'; {cancelada}

                                vqryNSU.fieldbyname('tipoxmlretorno').asString := 'resNFe';

                                GravarNSU(True);
                              end;

                            end
                            else
                            if tipo = 'CTE' then
                            begin

                              vqryNSU.fieldbyname('chnfe').asString :=
                                 vXMLresNFE.DocumentElement.ChildNodes.FindNode('protCTe').
                                                            ChildNodes.FindNode('infProt').
                                                            ChildNodes.FindNode('chCTe').Text;
                                                    {
                              vqryNSU.fieldbyname('cnpj').asString :=
                                 vXMLresNFE.DocumentElement.ChildNodes.FindNode('CTe').
                                                            ChildNodes.FindNode('infCte').
                                                            ChildNodes.FindNode('dest').
                                                            ChildNodes.FindNode('CNPJ').Text;
                                                            }

                              if vXMLresNFE.DocumentElement.ChildNodes.FindNode('CTe').
                                                            ChildNodes.FindNode('infCte').
                                                            ChildNodes.FindNode('emit').
                                                            ChildNodes.FindNode('CNPJ') <> nil then
                                vqryNSU.fieldbyname('cnpjemitente').asString :=
                                 vXMLresNFE.DocumentElement.ChildNodes.FindNode('CTe').
                                                            ChildNodes.FindNode('infCte').
                                                            ChildNodes.FindNode('emit').
                                                            ChildNodes.FindNode('CNPJ').Text
                              else
                              if vXMLresNFE.DocumentElement.ChildNodes.FindNode('CTe').
                                                            ChildNodes.FindNode('infCte').
                                                            ChildNodes.FindNode('emit').
                                                            ChildNodes.FindNode('CPF') <> nil then
                              vqryNSU.fieldbyname('cnpjemitente').asString :=
                                 vXMLresNFE.DocumentElement.ChildNodes.FindNode('CTe').
                                                            ChildNodes.FindNode('infCte').
                                                            ChildNodes.FindNode('emit').
                                                            ChildNodes.FindNode('CPF').Text;


                              vqryNSU.fieldbyname('xnome').asString :=
                                 vXMLresNFE.DocumentElement.ChildNodes.FindNode('CTe').
                                                            ChildNodes.FindNode('infCte').
                                                            ChildNodes.FindNode('emit').
                                                            ChildNodes.FindNode('xNome').Text;



                              vqryNSU.fieldbyname('ie').asString :=
                                 vXMLresNFE.DocumentElement.ChildNodes.FindNode('CTe').
                                                            ChildNodes.FindNode('infCte').
                                                            ChildNodes.FindNode('emit').
                                                            ChildNodes.FindNode('IE').Text;



                              vqryNSU.fieldbyname('dhemi').asString :=
                                 vXMLresNFE.DocumentElement.ChildNodes.FindNode('CTe').
                                                            ChildNodes.FindNode('infCte').
                                                            ChildNodes.FindNode('ide').
                                                            ChildNodes.FindNode('dhEmi').text;

                              vqryNSU.fieldbyname('tpnf').asString :=
                                 vXMLresNFE.DocumentElement.ChildNodes.FindNode('CTe').
                                                            ChildNodes.FindNode('infCte').
                                                            ChildNodes.FindNode('ide').
                                                            ChildNodes.FindNode('tpCTe').text;

                              vqryNSU.fieldbyname('vnf').asString :=
                                 trocar(

                                 vXMLresNFE.DocumentElement.ChildNodes.FindNode('CTe').
                                                            ChildNodes.FindNode('infCte').
                                                            ChildNodes.FindNode('vPrest').
                                                            ChildNodes.FindNode('vTPrest').text, '.',',');

                              vqryNSU.fieldbyname('digval').asString :=
                                 vXMLresNFE.DocumentElement.ChildNodes.FindNode('protCTe').
                                                            ChildNodes.FindNode('infProt').
                                                            ChildNodes.FindNode('digVal').Text;

                              vqryNSU.fieldbyname('dhrecbto').asString :=
                                  vXMLresNFE.DocumentElement.ChildNodes.FindNode('protCTe').
                                                            ChildNodes.FindNode('infProt').
                                                            ChildNodes.FindNode('dhRecbto').Text;

                              vqryNSU.fieldbyname('nprot').asString :=
                                  vXMLresNFE.DocumentElement.ChildNodes.FindNode('protCTe').
                                                            ChildNodes.FindNode('infProt').
                                                            ChildNodes.FindNode('nProt').Text;

                              {percebeu-se que no -procCTE não é retornado CSitNFe... usei o cStat...}
  //                            if vXMLresNFE.ChildNodes.FindNode('cSitNFe').Text <> '' then
  //                              vqryNSU.fieldbyname('csitnfe').asString := vXMLresNFE.ChildNodes.FindNode('cSitNFe').Text
  //                            else


                              if vXMLresNFE.DocumentElement.ChildNodes.FindNode('protCTe').
                                                            ChildNodes.FindNode('infProt').
                                                            ChildNodes.FindNode('cStat').Text = '100' then  {nomal}
                                vqryNSU.fieldbyname('csitnfe').asString := '1'
                              else
                              if (vXMLresNFE.DocumentElement.ChildNodes.FindNode('protCTe').
                                                            ChildNodes.FindNode('infProt').
                                                            ChildNodes.FindNode('cStat').Text = '301') or   {denegada}
                                 (vXMLresNFE.DocumentElement.ChildNodes.FindNode('protCTe').
                                                            ChildNodes.FindNode('infProt').
                                                            ChildNodes.FindNode('cStat').Text = '302') or
                                 (vXMLresNFE.DocumentElement.ChildNodes.FindNode('protCTe').
                                                            ChildNodes.FindNode('infProt').
                                                            ChildNodes.FindNode('cStat').Text = '303') then
                                vqryNSU.fieldbyname('csitnfe').asString := '2'
                              else
                                vqryNSU.fieldbyname('csitnfe').asString := '3'; {cancelada}

                              vqryNSU.fieldbyname('tipoxmlretorno').asString := 'resCTe';

                              GravarNSU(True);

                            end;



                          end;

                        except
                           on e:exception do
                           begin
                             result := False;

                             SalvarDadosnoArquivo(vArquivoLogSefaz, 'Filial ' + qryTabelaProcessamento.fieldByName('codigo').asString + ' Problemas ao ler o Tag 1' + #13 +
                                'Mensagem Original = '+e.Message);

                             Abort;
                           end;
                        end;


                      end
                      else
                      begin

                        if tipo = 'NFE' then
                        begin
                          ArqREtornoDfe := FDirRetorno + '\dfe\' + qryTabelaProcessamento.fieldbyname('cnpj').asString + '-' + vNSU_ + '-eve.xml';
                          ArqREtornoDfe2 := FDirRetorno + '\dfe\' + qryTabelaProcessamento.fieldbyname('cnpj').asString + '-' + vNSU_ + '-procEventoNFe.xml';

                        end
                        else
                        if tipo = 'CTE' then
                        begin
                          ArqREtornoDfe := FDirRetorno + '\dfe\' + qryTabelaProcessamento.fieldbyname('cnpj').asString + '-' + vNSU_ + '-procEventoCTe.xml';
                          ArqREtornoDfe2 := ArqREtornoDfe;

                        end;

                        IniciarTempo(vTempoInicial);
                        repeat
                        until FileExists(ArqRetornoDFe) or FileExists(ArqRetornoDFe2) or TempoEsgotado(vTempoInicial,5000) or vPararProcessamento;

                        Result := FileExists(ArqRetornoDFE) or FileExists(ArqRetornoDFE2);

                        if result then
                        begin

                          if FileExists(ArqRetornoDFE2) then
                            stPathDFe := ArqRetornoDFe2
                          else
                          if FileExists(ArqRetornoDFE) then
                            stPathDFe := ArqRetornoDFe;

                          CoInitialize(nil);
  //                        vXMLresNFE.Active:=false;
                          vXMLresNFE := TXmlDocument.Create(stPathDFe);//declarado com a String
                          vXMLresNFE.LoadFromFile(stPathDFe);
      //                    CoUninitialize;


                          try

                            vXMLresNFE.FileName:=stPathDFe;

                            vXMLresNFE.Active:=true;

                            if vXMLresNFE <> nil then
                            begin

                              vqryNSU.fieldbyname('tipoxmlretorno').asString := 'resEvento';

                              if tipo = 'NFE' then
                              begin
                                if FileExists(ArqRetornoDFE) then
                                begin

                                  if vXMLresNFE.DocumentElement.ChildNodes.FindNode('chNFe')<> nil then
                                    vqryNSU.fieldbyname('chnfe').asString := vXMLresNFE.DocumentElement.ChildNodes.FindNode('chNFe').Text;

                                  if vXMLresNFE.DocumentElement.ChildNodes.FindNode('dhRecbto') <> nil then
                                    vqryNSU.fieldbyname('dhrecbto').asString := vXMLresNFE.DocumentElement.ChildNodes.FindNode('dhRecbto').Text;

                                  if vXMLresNFE.DocumentElement.ChildNodes.FindNode('nProt') <> nil then
                                    vqryNSU.fieldbyname('nprot').asString := vXMLresNFE.DocumentElement.ChildNodes.FindNode('nProt').Text;

                                  vqryNSU.post;
                                  vqryNSU.Transaction.Commit;
                                end
                                else
                                if FileExists(ArqRetornoDFE2) then
                                begin
                                  if (vXMLresNFE.DocumentElement.ChildNodes.FindNode('retEvento').ChildNodes.FindNode('infEvento').ChildNodes.FindNode('tpEvento')<>nil) and

                                    (
                                     (vXMLresNFE.DocumentElement.ChildNodes.FindNode('retEvento').
                                                                 ChildNodes.FindNode('infEvento').
                                                                 ChildNodes.FindNode('tpEvento').Text = '210200') or {Confirmação da Operação}

                                     (vXMLresNFE.DocumentElement.ChildNodes.FindNode('retEvento').
                                                                 ChildNodes.FindNode('infEvento').
                                                                 ChildNodes.FindNode('tpEvento').Text = '210210') or {Ciência da operação}

                                     (vXMLresNFE.DocumentElement.ChildNodes.FindNode('retEvento').
                                                                 ChildNodes.FindNode('infEvento').
                                                                 ChildNodes.FindNode('tpEvento').Text = '210220') or {Desconhecimento da Operação}

                                     (vXMLresNFE.DocumentElement.ChildNodes.FindNode('retEvento').
                                                                 ChildNodes.FindNode('infEvento').
                                                                 ChildNodes.FindNode('tpEvento').Text = '210240') or { Operação não Realizada}

                                     (vXMLresNFE.DocumentElement.ChildNodes.FindNode('retEvento').
                                                                 ChildNodes.FindNode('infEvento').
                                                                 ChildNodes.FindNode('tpEvento').Text = '610130') or { Comprovante de entrega CTe }

                                     (vXMLresNFE.DocumentElement.ChildNodes.FindNode('retEvento').
                                                                 ChildNodes.FindNode('infEvento').
                                                                 ChildNodes.FindNode('tpEvento').Text = '610131') or { Comprovante Cancelamento de entrega CTe }

                                     (vXMLresNFE.DocumentElement.ChildNodes.FindNode('retEvento').
                                                                 ChildNodes.FindNode('infEvento').
                                                                 ChildNodes.FindNode('tpEvento').Text = '110110') or { Carta de Correção }

                                     (vXMLresNFE.DocumentElement.ChildNodes.FindNode('retEvento').
                                                                 ChildNodes.FindNode('infEvento').
                                                                 ChildNodes.FindNode('tpEvento').Text = '110111')   { Cancelamento }

                                     ) then
                                  begin

                                    if (vXMLresNFE.DocumentElement.ChildNodes.FindNode('retEvento').ChildNodes.FindNode('infEvento').ChildNodes.FindNode('chNFe')<>nil) then
                                      vqryNSU.fieldbyname('chnfe').asString := vXMLresNFE.DocumentElement.ChildNodes.FindNode('retEvento').
                                                                                                          ChildNodes.FindNode('infEvento').
                                                                                                          ChildNodes.FindNode('chNFe').Text;

                                    if (vXMLresNFE.DocumentElement.ChildNodes.FindNode('retEvento').ChildNodes.FindNode('infEvento').ChildNodes.FindNode('dhRegEvento')<>nil) then
                                      vqryNSU.fieldbyname('dhrecbto').asString := vXMLresNFE.DocumentElement.ChildNodes.FindNode('retEvento').
                                                                                                        ChildNodes.FindNode('infEvento').
                                                                                                        ChildNodes.FindNode('dhRegEvento').Text;

                                    if (vXMLresNFE.DocumentElement.ChildNodes.FindNode('retEvento').ChildNodes.FindNode('infEvento').ChildNodes.FindNode('nProt')<>nil) then
                                      vqryNSU.fieldbyname('nprot').asString := vXMLresNFE.DocumentElement.ChildNodes.FindNode('retEvento').
                                                                                                        ChildNodes.FindNode('infEvento').
                                                                                                        ChildNodes.FindNode('nProt').Text;
                                    GravarNSU(false);

                                  end;
                                end;
                              end
                              else
                              if tipo = 'CTE' then
                              begin
                                if vXMLresNFE.DocumentElement.ChildNodes.FindNode('eventoCTe').ChildNodes.FindNode('infEvento').ChildNodes.FindNode('chCTe')<>nil then

                                vqryNSU.fieldbyname('chnfe').asString :=
                                  vXMLresNFE.DocumentElement.ChildNodes.FindNode('eventoCTe').ChildNodes.FindNode('infEvento').ChildNodes.FindNode('chCTe').text;

                                if vXMLresNFE.DocumentElement.ChildNodes.FindNode('eventoCTe').ChildNodes.FindNode('infEvento').ChildNodes.FindNode('dhEvento')<>nil then
                                  vqryNSU.fieldbyname('dhrecbto').asString :=
                                    vXMLresNFE.DocumentElement.ChildNodes.FindNode('eventoCTe').ChildNodes.FindNode('infEvento').ChildNodes.FindNode('dhEvento').Text;

                                if vXMLresNFE.DocumentElement.ChildNodes.FindNode('retEventoCTe').ChildNodes.FindNode('infEvento').ChildNodes.FindNode('nProt')<>nil then
                                  vqryNSU.fieldbyname('nprot').asString :=
                                    vXMLresNFE.DocumentElement.ChildNodes.FindNode('retEventoCTe').ChildNodes.FindNode('infEvento').ChildNodes.FindNode('nProt').Text;

                                GravarNSU(false);

                              end;


                            end;


                          except
                             on e:exception do
                             begin
                               result := false;
                               SalvarDadosnoArquivo(vArquivoLogSefaz, 'Filial ' + qryTabelaProcessamento.fieldByName('codigo').asString + ' Problemas ao ler o Tag 2' + #13 +
                                'Mensagem Original = '+e.Message);
                               Abort;
                             end;
                          end;

                        end
                        else
                        begin
                          {
                          vqryNSU.fieldbyname('tipoxmlretorno').asString := 'Aguardando...';
                          vqryNSU.post;
                          vqryNSU.Transaction.Commit;
                          }
                          result := true; {atenção para casos em que o arquivo nao vem, melhor cortar para não ficar um furo no NSU}
                        end;
                      end;


                    end;
                  end;

                except
                   on e:exception do
                   begin
                     result := false;
                     SalvarDadosnoArquivo(vArquivoLogSefaz, 'Filial ' + qryTabelaProcessamento.fieldByName('codigo').asString + ' Problemas ao ler o Tag 3' + #13 +
                                'Mensagem Original = '+e.Message);
                     Abort;
                   end;
                end;
              end;

   Procedure SalvarCStatFilial(pFilial: Integer; pStat, pXStat, pdhResp: String);
   begin

     if qryFiliais <> nil then
     begin
       if qryFiliais.locate('codigo', pFilial, []) then
       begin
         if tipo = 'NFE' then
         begin
           qryFiliais.edit;
           qryFiliais.fieldbyname('nsu_dhrecbto').asString := pdhResp;
           qryFiliais.fieldbyname('nsu_cstat').asString := pStat;
           qryFiliais.fieldbyname('nsu_cstat_motivo').asString := pXStat;
           qryFiliais.post;

         end
         else
         if tipo = 'CTE' then
         begin
           qryFiliais.edit;
           qryFiliais.fieldbyname('nsucte_dhrecbto').asString := pdhResp;
           qryFiliais.fieldbyname('nsucte_cstat').asString := pStat;
           qryFiliais.fieldbyname('nsucte_cstat_motivo').asString := pXStat;
           qryFiliais.post;

         end;

         qryFiliais.Transaction.Commit;
       end;
     end;
   end;

begin
  result := true;


  case pPassosDistribuicao of
    opVarificacaoNSUFaltantes : qryTabelaProcessamento.first;
  end;

  while not qryTabelaProcessamento.eof do
  begin

    if vPararProcessamento then
      break;


    if (pPassosDistribuicao = opDistribuicaoDFeCienciaOPeracao) or // passando o AchNFe
       (pPassosDistribuicao = opVarificacaoNSUFaltantes) or // passando a qryTabelaProcessamento (qryNSUS_Faltantes) e qryFiliais para gravação ultnsu, cstat...
       (pPassosDistribuicao = opDistribuicaoDFe) then // passando como ryTabelaProcessamento a qryFiliais para gravação ultnsu, cstat...

    begin

      fdirenvio := trocar(FNFeDirEnvio, FCNPJFilialBase, qryTabelaProcessamento.fieldbyname('cnpj').asString);
      FDirRetorno := trocar(fnfedirretorno, FCNPJFilialBase, qryTabelaProcessamento.fieldbyname('cnpj').asString);

      maxNSU_ := '-1';

      if (pPassosDistribuicao = opDistribuicaoDFe) then
      begin
        if tipo = 'NFE' then
        begin
          if (qryTabelaProcessamento.FieldByName('maxNSU_sefaz').AsString<>'') then
            maxNSU_ := qryTabelaProcessamento.FieldByName('maxNSU_sefaz').AsString;
        end
        else
        if tipo = 'CTE' then
        begin
          if (qryTabelaProcessamento.FieldByName('maxNSUCTE_sefaz').AsString<>'') then
            maxNSU_ := qryTabelaProcessamento.FieldByName('maxNSUCTE_sefaz').AsString;
        end;
      end;

      while true do
      begin

        if vPararProcessamento then
          break;

        if pPassosDistribuicao = opDistribuicaoDFe then
          vmsg := 'Gerando arquivo de distribuição... filial ' +  qryTabelaProcessamento.Fieldbyname('codigo').asString + ' ' + tipo
        else
          vmsg := 'Gerando arquivo de distribuição... filial ' +  qryTabelaProcessamento.Fieldbyname('codigo').asString + ' ' + tipo + ' '+
                  inttostr(qryTabelaProcessamento.recno)+'/'+inttostr(qryTabelaProcessamento.recordcount);

        Application.ProcessMessages;



        if tipo = 'NFE' then
        begin
          ArqEnvio   := FDirEnvio   + '\' + qryTabelaProcessamento.fieldbyname('cnpj').asString + '-con-dist-dfe.xml';
          ArqRetorno := FDirRetorno + '\' + qryTabelaProcessamento.fieldbyname('cnpj').asString + '-dist-dfe.xml';
          ArqRetornoDFE := FDirRetorno + '\dfe\' + qryTabelaProcessamento.fieldbyname('cnpj').asString;
          ArqRetornoDFE2 := ArqRetornoDFE;
          ArqRetornoprocNFe := FDirRetorno + '\dfe\' + AchNFe + '-procNFe.xml';
          ArqRetornoprocNFe2 := ArqRetornoprocNFe;

          ArqRetornoprocNFe3 := FDirRetorno + '\dfe\' +  qryTabelaProcessamento.fieldbyname('cnpj').asString+'-'+qryTabelaProcessamento.fieldbyname('nsu').asString+'-procNFe.xml';

          ArqErro    := FDirRetorno + '\' + qryTabelaProcessamento.fieldbyname('cnpj').asString + '-con-dist-dfe.err';
        end
        else
        if tipo = 'CTE' then
        begin
          ArqEnvio   := FDirEnvio   + '\' + qryTabelaProcessamento.fieldbyname('cnpj').asString + '-con-dist-dfecte.xml';
          ArqRetorno := FDirRetorno + '\' + qryTabelaProcessamento.fieldbyname('cnpj').asString + '-dist-dfecte.xml';
          ArqRetornoDFE := FDirRetorno + '\dfe\' + qryTabelaProcessamento.fieldbyname('cnpj').asString;
          ArqRetornoDFE2 := ArqRetornoDFE;

          ArqRetornoprocNFe := FDirRetorno + '\dfe\' + AchNFe + '-procCTe.xml';
          ArqRetornoprocNFe2 := FDirRetorno + '\dfe\' +  qryTabelaProcessamento.fieldbyname('cnpj').asString+'-'+qryTabelaProcessamento.fieldbyname('nsu').asString+'-procCTe.xml';
          ArqRetornoprocNFe3 := ArqRetornoprocNFe2;


          ArqErro    := FDirRetorno + '\' + qryTabelaProcessamento.fieldbyname('cnpj').asString + '-con-dist-dfecte.err';
        end;



        try
          if FileExists(ArqEnvio) then
            DeleteFile(ArqEnvio);

          if FileExists(ArqRetorno) then
            DeleteFile(ArqRetorno);

          if FileExists(ArqErro) then
            DeleteFile(ArqErro);

          AssignFile(xml, FDirEnvio+nfe_temp);
          Rewrite(xml);
          Write(xml, '<?xml version="1.0" encoding="UTF-8"?>');

          if tipo = 'NFE' then
            AbreTag_('distDFeInt', ['versao','xmlns'],
                               ['1.01',
                                'http://www.portalfiscal.inf.br/nfe'])
          else
          if tipo = 'CTE' then
            AbreTag_('distDFeInt', ['versao','xmlns'],
                               ['1.00',
                                'http://www.portalfiscal.inf.br/cte']);

          TagCompleta_('tpAmb',inttostr(FNFeAmbiente));
          TagCompleta_('cUFAutor', inttostr(CodigoUF_IBGE(qryTabelaProcessamento.fieldbyname('estado').asString)));
          TagCompleta_('CNPJ',qryTabelaProcessamento.fieldbyname('cnpj').asString);


          if (pPassosDistribuicao = opVarificacaoNSUFaltantes) then
          begin
            AbreTag_('consNSU');
              if tipo = 'NFE' then
                TagCompleta_('NSU', preencheString(qryTabelaProcessamento.FieldByName('nsu').asstring, '0', 15, false))
              else
              if tipo = 'CTE' then
                TagCompleta_('NSU', preencheString(qryTabelaProcessamento.FieldByName('nsu').asstring, '0', 15, false));

            FechaTag_('consNSU');

          end
          else
          if (pPassosDistribuicao = opDistribuicaoDFeCienciaOPeracao) then
          begin
            AbreTag_('consChNFe');
              TagCompleta_('chNFe', AchNFe);
            FechaTag_('consChNFe');
          end
          else
          begin
            AbreTag_('distNSU');
              if tipo = 'NFE' then
                TagCompleta_('ultNSU', preencheString(qryTabelaProcessamento.FieldByName('nsu').asstring, '0', 15, false))
              else
              if tipo = 'CTE' then
                TagCompleta_('ultNSU', preencheString(qryTabelaProcessamento.FieldByName('nsucte').asstring, '0', 15, false));

            FechaTag_('distNSU');
          end;

          FechaTag_('distDFeInt');
          CloseFile(xml);

//          DeleteFiles(ExtractFilePath(FDirEnvio)+'ArquivoTemp\'+ExtractFilename(ArqEnvio));
//          repeat until CopyFileTo(FDirEnvio+nfe_temp, ExtractFilePath(FDirEnvio)+'ArquivoTemp\'+ExtractFilename(ArqEnvio), true);
          repeat until RenameFile(FDirEnvio+nfe_temp,ArqEnvio);

        except
          on E: Exception do
          begin
            SalvarDadosnoArquivo(vArquivoLogSefaz, 'Arquivo '+ ArqEnvio + E.Message);
          end;
        end;


        if pPassosDistribuicao = opDistribuicaoDFe then
          vmsg := 'Aguardando arquivo de distribuição... filial ' +  qryTabelaProcessamento.Fieldbyname('codigo').asString + ' ' + tipo
        else
          vmsg := 'Aguardando arquivo de distribuição... filial ' +  qryTabelaProcessamento.Fieldbyname('codigo').asString + ' ' + tipo + ' '+
                  inttostr(qryTabelaProcessamento.recno)+'/'+inttostr(qryTabelaProcessamento.recordcount);

        Application.ProcessMessages;

        IniciarTempo(vTempoInicial);

        repeat
        until FileExists(ArqRetorno) or
              FileExists(ArqErro) or TempoEsgotado(vTempoInicial, 10000) or vPararProcessamento;

        {Esperar 2 segundos para não dar erro concorrente entre aplicativos uninfe e erp}

        IniciarTempo(vTempoInicial);
        repeat
        until TempoEsgotado(vTempoInicial,8000);

        if not (FileExists(ArqRetorno) or
                FileExists(ArqErro)) then
        begin
//          if not vPararProcessamento then
//            MensagemErro('Esgotado o tempo limite de espera da consulta no sefaz. Verifique suas configurações');
          SalvarDadosnoArquivo(vArquivoLogSefaz, 'Filial ' + qryTabelaProcessamento.fieldbyname('codigo').asString + ' Esgotado o tempo limite de espera da consulta no sefaz. Verifique suas configurações');
          break;
        end;


        Result := FileExists(ArqRetorno);

        if not Result then
        begin
          if FileExists(ArqErro) then
          begin

            try
              CopiaTemporaria(FDirRetorno,ArqErro);
              AssignFile(ArqResp,FDirRetorno+nfe_temp);
              FileMode := 0;
              Reset(ArqResp);
              MsgErro := '';
              while not Eof(ArqResp) do
              begin
                Readln(ArqResp, Linha);
                MsgErro := MsgErro + Linha + sLineBreak
              end;
              CloseFile(ArqResp);
              DeleteFile(FDirRetorno+nfe_temp)
            except
              on E: Exception do
              begin
                SalvarDadosnoArquivo(vArquivoLogSefaz, 'Arquivo '+ ArqEnvio + E.Message);
                {MensagemAviso(E.Message + 'InterpretarResposta!' + sLineBreak + ArqErro)}
              end;
            end;
            SalvarDadosnoArquivo(vArquivoLogSefaz, 'Filial ' + qryTabelaProcessamento.fieldByName('codigo').asString + ' ' +MsgErro);
//            MensagemErro(MsgErro);
            break;

          end

        end
        else
        begin

          {a variavel abaixo refere-se a ciencia da operação de NFe (não de CTe) e verificação de nsus que estão 'resNFe porém sem o xml}
//          if  AchNFe = '' then

          if (pPassosDistribuicao = opDistribuicaoDFe) or
             (pPassosDistribuicao = opVarificacaoNSUFaltantes) then
          begin

            vcStat  := ValorRetornoXML(ArqRetorno, 'cStat', false);
            vXcStat := ValorRetornoXML(ArqRetorno, 'xMotivo', false);
            vdhResp := ValorRetornoXML(ArqRetorno, 'dhResp', false);
            vultNSU := ValorRetornoXML(ArqRetorno, 'ultNSU', false);
            maxNSU_  := ValorRetornoXML(ArqRetorno, 'maxNSU', false);


            if vcStat <> '138' then
            begin

              SalvarDadosnoArquivo(vArquivoLogSefaz, 'Filial ' + qryTabelaProcessamento.fieldByName('codigo').asString + ' Status ' + vcstat + 'Nenhum documento encontrado');

              if (vcStat = '137') or (vcStat = '656') then
              begin
                SalvarCStatFilial(qryTabelaProcessamento.fieldbyname('codigo').asInteger, vcStat, vXcStat, vdhResp);
//                vPararProcessamento := true; {Para o processamento devido a um consumo excessivo, retornará em 1 hora qdo 656 é penalizado }
                exit;
              end;

            end
            else
            begin
              if (pPassosDistribuicao = opDistribuicaoDFe) then
              begin

                qryTabelaProcessamento.edit;
                if tipo = 'NFE' then
                begin
                  qryTabelaProcessamento.fieldbyname('maxnsu_sefaz').asString := maxNSU_;
                  qryTabelaProcessamento.fieldbyname('nsu_dhrecbto').asString := vdhResp;
                end
                else
                if tipo = 'CTE' then
                begin
                  qryTabelaProcessamento.fieldbyname('maxnsucte_sefaz').asString := maxNSU_;
                  qryTabelaProcessamento.fieldbyname('nsucte_dhrecbto').asString := vdhResp;
                end;

                qryTabelaProcessamento.post;
                qryTabelaProcessamento.Transaction.Commit;
              end;

              Ler_loteDistDFeInt;

//              if (strtoint(vNSU_) >= strtoint(maxNSU)) or not result or (qryFiliais<>nil) then
              if (strtoint(vNSU_) >= strtoint(maxNSU_)) or not result or (pPassosDistribuicao = opVarificacaoNSUFaltantes) then
                break;
            end;

          end
          else
          if (pPassosDistribuicao = opDistribuicaoDFeCienciaOPeracao) then
          begin
            (* NÃO EXISTE A SITUAÇÃO ABAIXO
            {Aqui somente pelo evento de ciencia da operação qdo nfe}
            Result := FileExists(ArqRetornoprocNFe) or FileExists(ArqRetornoprocNFe2) or FileExists(ArqRetornoprocNFe3);
            if result then
            begin

              try
                vConteudoArq := tstringlist.create;
                if FileExists(ArqRetornoprocNFe2) then
                  vConteudoArq.LoadFromFile(ArqRetornoprocNFe2)
                else
                if FileExists(ArqRetornoprocNFe3) then
                  vConteudoArq.LoadFromFile(ArqRetornoprocNFe3)
                else
                if FileExists(ArqRetornoprocNFe) then
                  vConteudoArq.LoadFromFile(ArqRetornoprocNFe);

                {qrynsu passado como qryfiliais }
                qryTabelaProcessamento.edit;
                qryTabelaProcessamento.fieldbyname('xmlnfe').asString := vConteudoArq.text;

                {
                if tipo = 'NFE' then
                  qryTabelaProcessamento.fieldbyname('tipoxmlretorno').asString := 'resNFe'
                else
                if tipo = 'CTE' then
                  qryTabelaProcessamento.fieldbyname('tipoxmlretorno').asString := 'resCTe';
                }

                qryTabelaProcessamento.post;

                qryTabelaProcessamento.Transaction.Commit;

              finally
                vConteudoArq.free;
              end;

            end
            else
            begin
            *)


              vcStat  := ValorRetornoXML(ArqRetorno, 'cStat', false);
              vXcStat := ValorRetornoXML(ArqRetorno, 'xMotivo', false);
              vdhResp := ValorRetornoXML(ArqRetorno, 'dhResp', false);
              vultNSU := ValorRetornoXML(ArqRetorno, 'ultNSU', false);
              maxNSU_  := ValorRetornoXML(ArqRetorno, 'maxNSU', false);


              if vcStat = '653' then //NFE CANCELADA
              begin
                {qrynsu passado como qryfiliais }
                qryTabelaProcessamento.edit;
                qryTabelaProcessamento.fieldbyname('csitnfe').asString := '3'; //Cancelada
                qryTabelaProcessamento.post;
                qryTabelaProcessamento.Transaction.Commit;
              end
              else
              {Visto que é informado uma chave da nfe/cte o documento atual pode vir com outro número de NSU}
              begin
                if vcStat <> '138' then
                begin
                  if vcStat = '632' then   //Solicitacao fora de prazo, a NF-e nao esta mais disponivel para download
                  begin
                    qryTabelaProcessamento.edit;
                    qryTabelaProcessamento.fieldbyname('csitnfe').asString := 'N';
                    qryTabelaProcessamento.post;
                    qryTabelaProcessamento.Transaction.Commit;
                  end
                  else
                  if vcStat = '217' then   //Rejeicao: NF-e inexistente para a chave de acesso informada
                  begin
                    qryTabelaProcessamento.edit;
                    qryTabelaProcessamento.fieldbyname('csitnfe').asString := 'I'; //Cancelada
                    qryTabelaProcessamento.post;
                    qryTabelaProcessamento.Transaction.Commit;
//                    break;
                  end
                  else
                  if (vcStat = '137') or (vcStat = '656') then
                  begin
                    result := false; {NÃO PARAR O PROCESSAMENTO QUANDO 137 POR NSU/NFE 20 por hora...os outros passos devem continuar}

                    if (vcStat = '656') then   {Aqui se for penalizado...deve parar 1 hora}
                      SalvarCStatFilial(qryTabelaProcessamento.fieldbyname('codigo').asInteger, vcStat, vXcStat, vdhResp);

//                      vPararProcessamento := true; {Para o processamento devido a um consumo excessivo, retornará em 1 hora qdo 656 é penalizado }
                    exit;
                  end;

                end
                else
                begin

                  {início novo número da nsu}
                    Ler_loteDistDFeInt;
                    {qrynsu passado como qryfiliais }

                    if assigned(vqryNSU) then
                      if vqryNSU.fieldbyname('nsu').asString <> qryTabelaProcessamento.fieldbyname('nsu').asString then
                      begin
                        qryTabelaProcessamento.edit;
                        qryTabelaProcessamento.fieldbyname('tipoxmlretorno').asString := 'resEvento'; {estava resNFe o novo NSU da função Ler_loteDistDFeInt ficará resNFe}
                        qryTabelaProcessamento.post;
                        qryTabelaProcessamento.Transaction.Commit;
                      end;
                end;

              {final novo número da nsu}
              end;
{            end;}

            break;
          end;
        end;
      end;
    end;

    if pPassosDistribuicao = opVarificacaoNSUFaltantes then
      qryTabelaProcessamento.next
    else
      break;

  end;
end;



function DistribuicaoDFeCienciaOPeracao(AOwner: TComponent; qryNSU: ttecquery;
         var vMsg: String;
         var vPararProcessamento: boolean;
         var pPassosDistribuicao: TTecPassosDistribuicao;
         qryFiliais: ttecquery;
         tipo: String = 'NFE'): boolean;
var
  XMLDocument: IXMLDocument;
  Node_envEvento, Node_evento, Node_infEvento, Node_detEvento: IXMLNode;

  vXMLEveCiencia: IXMLDocument;
  vReenviarCienciaOperacao : Boolean;
  vCienciaOperacaoForadoPrazo10dias : Boolean;

  ArqEnvio,
  ArqRetorno,
  ArqErro : String;

  vTempoInicial : DWORD;
  vConteudoArq : tStringList;
  vqryNSU : TTecQuery;

begin
  result := true;

  qryNSU.First;
  while not qryNSU.Eof do
  begin
    if vPararProcessamento then
      break;

    if (qrynsu.FieldByName('xmlnfe').isnull and (tipo='NFE')) { or
       (qrynsu.FieldByName('xmlnfe').isnull and (tipo='CTE')) } then
    begin
      vReenviarCienciaOperacao := False;
      vCienciaOperacaoForadoPrazo10dias := False;

      if not qryNSU.FieldByName('xmleveciencia').isnull then
      begin
        try

          vReenviarCienciaOperacao := true;
          vCienciaOperacaoForadoPrazo10dias := false;

          if not assigned(vXMLEveCiencia) THEN
            vXMLEveCiencia := TXMLDocument.Create(AOwner);

          vXMLEveCiencia.xml.text :=  qryNSU.FieldByName('xmleveciencia').asString;
          vXMLEveCiencia.active := true;

          if (vXMLEveCiencia.ChildNodes.FindNode('retEnvEvento')<>nil) and
             (vXMLEveCiencia.DocumentElement.ChildNodes.FindNode('retEvento')<>nil) then
          begin

             vReenviarCienciaOperacao :=
               vXMLEveCiencia.DocumentElement.ChildNodes.FindNode('retEvento').
                                      ChildNodes.FindNode('infEvento').
                                      ChildNodes.FindNode('cStat').Text <> '135'; {Evento registrado e vinculado a NF-e}

             if vReenviarCienciaOperacao then  //Se já fora emitido e enviar novamente ocorrerá uma duplicidade de evento, não precisa reenviar
                                               //só precisa consChNfe para baixar o xml
                vReenviarCienciaOperacao := not

                 ((vXMLEveCiencia.DocumentElement.ChildNodes.FindNode('retEvento').
                                        ChildNodes.FindNode('infEvento').
                                        ChildNodes.FindNode('cStat').Text = '573') and  //duplicidade de evento

                  (vXMLEveCiencia.DocumentElement.ChildNodes.FindNode('retEvento').
                                        ChildNodes.FindNode('infEvento').
                                        ChildNodes.FindNode('tpEvento').Text = '210210')); //Ciência da operação



{
Solução Abaixo : Quando estiver vinculando o evento da Ciência da Operação e já ultrapassar o seu prazo definido, terá que vincular qualquer outro tipo de evento que ainda esteja dentro do prazo estipulado pela sefaz.

Ciencia da operacao : 10 dias
Confirmação da operacao : 180 dias
Desconhecimento da operacao : 180 dias
Operação não realizada: 180 dias (esta se dá por uma nota de devolução}


             vCienciaOperacaoForadoPrazo10dias :=
               vXMLEveCiencia.DocumentElement.ChildNodes.FindNode('retEvento').
                                      ChildNodes.FindNode('infEvento').
                                      ChildNodes.FindNode('cStat').Text = '596'; {Rejeicao: Evento apresentado apos o prazo permitido para o evento: [10 dias]}

             if vCienciaOperacaoForadoPrazo10dias then
               vCienciaOperacaoForadoPrazo10dias := not

                 ((vXMLEveCiencia.DocumentElement.ChildNodes.FindNode('retEvento').
                                        ChildNodes.FindNode('infEvento').
                                        ChildNodes.FindNode('cStat').Text = '573') and  //duplicidade de evento

                  (vXMLEveCiencia.DocumentElement.ChildNodes.FindNode('retEvento').
                                        ChildNodes.FindNode('infEvento').
                                        ChildNodes.FindNode('tpEvento').Text = '210200')); //confirmação da operação

             if vReenviarCienciaOperacao or vCienciaOperacaoForadoPrazo10dias then
               SalvarDadosnoArquivo(vArquivoLogSefaz, vXMLEveCiencia.xml.text);

          end
          else
          begin
            if (qryNSU.findfield('diasdiferenca')<>nil) and
               (qryNSU.findfield('diasdiferenca').asinteger > 10) then
            begin
              vReenviarCienciaOperacao := false;
              vCienciaOperacaoForadoPrazo10dias := true;
            end
          end;

        finally

          vXMLEveCiencia.active := false;
          vXMLEveCiencia.XML.clear;
        end;

      end
      else
        vReenviarCienciaOperacao := True;

      if vReenviarCienciaOperacao or vCienciaOperacaoForadoPrazo10dias then
      begin
        fdirenvio := trocar(FNFeDirEnvio, FCNPJFilialBase, qryNSU.fieldbyname('cnpj').asString);
        FDirRetorno := trocar(fnfedirretorno, FCNPJFilialBase, qryNSU.fieldbyname('cnpj').asString);

        if vCienciaOperacaoForadoPrazo10dias then
        begin
          ArqEnvio   := FDirEnvio   + '\' + qryNSU.FieldByName('chnfe').asString + '-210200-01-ped-eve.xml';
          ArqRetorno := FDirRetorno + '\' + qryNSU.FieldByName('chnfe').asString + '-210200-01-eve.xml';
          ArqErro    := FDirRetorno + '\' + qryNSU.FieldByName('chnfe').asString + '-210200-01-eve.err';
        end
        else
        begin
          ArqEnvio   := FDirEnvio   + '\' + qryNSU.FieldByName('chnfe').asString + '-210210-01-ped-eve.xml';
          ArqRetorno := FDirRetorno + '\' + qryNSU.FieldByName('chnfe').asString + '-210210-01-eve.xml';
          ArqErro    := FDirRetorno + '\' + qryNSU.FieldByName('chnfe').asString + '-210210-01-eve.err';
        end;

        CoInitialize(nil);
        XMLDocument := TXMLDocument.Create(AOwner);
        try

          XMLDocument.Active := True;
          XMLDocument.Version := '1.0';
          XMLDocument.Encoding := 'UTF-8';


          // Criando a RAIZ
//        Raiz := xmldoc.AddChild('consSitNFe', 'http://www.portalfiscal.inf.br/nfe');
          if tipo='NFE' then
            Node_envEvento := XMLDocument.AddChild('envEvento', 'http://www.portalfiscal.inf.br/nfe')
          else
          if tipo='CTE' then
            Node_envEvento := XMLDocument.AddChild('envEvento', 'http://www.portalfiscal.inf.br/cte');

//          Node_envEvento.SetAttributeNS('xmlns', '', 'http://www.portalfiscal.inf.br/nfe');
          Node_envEvento.Attributes['versao'] := '1.00';

          Node_envEvento.AddChild('idLote');
          Node_envEvento.ChildValues['idLote'] := '000000000000001';

          Node_evento := Node_envEvento.AddChild('evento');
          if tipo='NFE' then
            Node_evento.SetAttributeNS('xmlns', '', 'http://www.portalfiscal.inf.br/nfe')
          else
          if tipo='CTE' then
            Node_evento.SetAttributeNS('xmlns', '', 'http://www.portalfiscal.inf.br/cte');

          Node_evento.Attributes['versao'] := '1.00';

          Node_infEvento := Node_evento.AddChild('infEvento');

            if vCienciaOperacaoForadoPrazo10dias then
              Node_infEvento.Attributes['Id'] := 'ID210200' + qryNSU.FieldByName('chnfe').asString + '01'
            else
              Node_infEvento.Attributes['Id'] := 'ID210210' + qryNSU.FieldByName('chnfe').asString + '01';


            Node_infEvento.AddChild('cOrgao');
            Node_infEvento.ChildValues['cOrgao'] := '91';

            Node_infEvento.AddChild('tpAmb');
            Node_infEvento.ChildValues['tpAmb'] := FNFeAmbiente;

            Node_infEvento.AddChild('CNPJ');
            Node_infEvento.ChildValues['CNPJ'] := qryNSU.FieldByName('cnpj').asString;

            Node_infEvento.AddChild('chNFe');
            Node_infEvento.ChildValues['chNFe'] := qryNSU.FieldByName('chnfe').asString;

            Node_infEvento.AddChild('dhEvento');
            Node_infEvento.ChildValues['dhEvento'] := FormatarTimeStampz(vdatahoraservidor);

            Node_infEvento.AddChild('tpEvento');
            if vCienciaOperacaoForadoPrazo10dias then
              Node_infEvento.ChildValues['tpEvento'] := '210200'
            else
              Node_infEvento.ChildValues['tpEvento'] := '210210';

            Node_infEvento.AddChild('nSeqEvento');
            Node_infEvento.ChildValues['nSeqEvento'] := '1';

            Node_infEvento.AddChild('verEvento');
            Node_infEvento.ChildValues['verEvento'] := '1.00';

            Node_detEvento := Node_infEvento.AddChild('detEvento');
            Node_detEvento.Attributes['versao'] := '1.00';

            Node_detEvento.AddChild('descEvento');
            if vCienciaOperacaoForadoPrazo10dias then
              Node_detEvento.ChildValues['descEvento'] := 'Confirmacao da Operacao'
            else
              Node_detEvento.ChildValues['descEvento'] := 'Ciencia da Operacao';

          XMLDocument.SaveToFile(ArqEnvio);

          Application.ProcessMessages;

          IniciarTempo(vTempoInicial);

          repeat
          until FileExists(ArqRetorno) or
                FileExists(ArqErro) or TempoEsgotado(vTempoInicial,5000) or vPararProcessamento ;

          {Esperar 2 segundos para não dar erro concorrente entre aplicativos uninfe e erp}


          IniciarTempo(vTempoInicial);
          repeat
          until TempoEsgotado(vTempoInicial,4000);


          if not (FileExists(ArqRetorno) or
                  FileExists(ArqErro)) then
          begin
//            if not vPararProcessamento then
//              MensagemErro('Esgotado o tempo limite de espera da consulta no sefaz. Aguardando o arquivo ' + ArqRetorno);
             SalvarDadosnoArquivo(vArquivoLogSefaz, 'Filial ' + qryNSU.fieldByName('codigo').asString + ' Esgotado o tempo limite de espera da consulta no sefaz. Verifique suas configurações' + ArqRetorno);
//             break;
          end;

          Result := FileExists(ArqRetorno);

          if not Result then
          begin
            if FileExists(ArqErro) then
            begin
              try
                vConteudoArq := tstringlist.create;
                vConteudoArq.loadfromfile(ArqErro);
                SalvarDadosnoArquivo(vArquivoLogSefaz, vConteudoArq.text);
//                MensagemErro(vConteudoArq.text);

              finally
                vConteudoArq.free;
              end;

            end;
          end
          else
          begin

            try
              vConteudoArq := tstringlist.create;
              vConteudoArq.LoadFromFile(arqRetorno);

              qryNSU.edit;
              qryNSU.fieldbyname('xmleveciencia').asString := vConteudoArq.text;
              qryNSU.post;

              qryNSU.Transaction.Commit;


              {
              vqryNSU := TTecQuery.Create(aOwner);
              vqryNSU.Database := qrynsu.Database;
              vqryNSU.Transaction := qrynsu.Transaction;
//              vqryNSU.CachedUpdates := true;
              vqryNSU.RequestLive := true;


              vqryNSU.Sql.text := format('select cnpjFilial, nsu, xmleveciencia from nsus where cnpjfilial = %s and nsu = %s ',
                                         [quotedstr(qryNSU.FieldByName('cnpjfilial').asString),
                                          quotedstr(qryNSU.FieldByName('nsu').asString)]);
              vqryNSU.open;

              if vqryNSU.recordcount = 1 then
              begin
                vqryNSU.edit;
//                vqryNSU.fieldbyname('xmleveciencia').asString := vConteudoArq.text;
                tmemofield(vqryNSU.fieldbyname('xmleveciencia')).LoadFromFile(ArqRetorno);
                vqryNSU.post;
              end;
              vqryNSU.Transaction.Commit;
              }



            finally
              vConteudoArq.free;
//              vqryNSU.free;
            end;

          end;

        except
           on e:exception do
           begin
             result := false;

             SalvarDadosnoArquivo(vArquivoLogSefaz, 'Filial ' + qryNSU.fieldByName('codigo').asString + ' Problemas ao ler o Tag 4' + #13 +
              'Mensagem Original = '+e.Message);
             Abort;
           end;
        end;
      end;

      if not qryNSU.FieldByName('xmleveciencia').isnull then
        result := DistribuicaoDFe(AOwner, qrynsu,
                        vMsg,
                        vPararProcessamento,
                        pPassosDistribuicao,
                        qryFiliais,
                        qryNSU.FieldByName('chnfe').asString,
                        qryNSU.fieldbyName('tipo').asString);

    end;

    if not result then
//      if MensagemConfirmacao('Continuar a atualização das NFEs ?') = smbCancel then
        break;


    qryNSU.next;
    vmsg := 'Ciência da Operação ou Confirmação de NSU pendentes '+inttostr(qryNSU.recno)+'/'+inttostr(qryNSU.recordcount);

    Application.ProcessMessages;

  end;
end;



procedure AbreTag_(Nome: String);
begin
  Write(xml, '<' + Nome + '>')
end;

procedure AbreTag_(Nome: String; Atributos,
  Valores: array of String);
var
  i : Integer;
  Reg : String;

begin
  Reg := '<' + Nome;
  for i:=0 to High(Atributos) do
    Reg := Reg + ' ' + Atributos[i] + ' = "' + Valores[i] + '"';
  Reg := Reg + '>';
  Write(xml, Reg)
end;


procedure TagCompleta_(Nome, Valor: String; Validar: Boolean = True; Maiusculas: Boolean = True; Opcional: boolean = false);
var
  a: Integer;
begin

  if validar then
    if ((nome='IE') or
        (Nome='IEST')) and (SomenteNumero(Valor)='') then
      valor := '';

  valor := RetiraAcento(valor);
  if Maiusculas then
    valor := UpperCase(valor);
  valor := Trocar(Trocar(Trocar(Trocar(Trocar(Trocar(Valor,
                                                     sLineBreak,' '),
                                                     '<','&lt;'),
                                                     '>','&gt;'),
                                                     '&','&amp;'),
                                                     '"','&quot;'),
                                                     '''','&#39;');
  for a := 1 to Length(Valor) do
    if not (valor[a] in [#$20..#$7F])  // de space ate "vazio" na tabela ASCII
    then valor[a]:= '.';

  if not (opcional and ((valor='') or (valor='0'))) then
    Write(xml, '<' + Nome + '>' + trim(Valor) + '</' + Nome + '>')

end;


procedure TagCompleta_(Nome: String;
  Valor: Extended; Decimais: Integer; Opcional: boolean);
var
  ValorS: String;
begin
  if Decimais = 2 then
    ValorS := FormatarValorNFe('0.00',Valor)
  else if Decimais = 3 then
    ValorS := FormatarValorNFe('0.000',Valor)
  else if Decimais = 4 then
    ValorS := FormatarValorNFe('0.0000',Valor)
  else if Decimais = 10 then
    ValorS := FormatarValorNFe('0.0000000000',Valor);

  if not (Opcional and (valor=0)) then
    Write(xml, '<' + Nome + '>' + ValorS + '</' + Nome + '>')
end;

procedure TagCompleta_(Nome: String;
  Valor: TDatetime; Formato: String);
var
  ValorS: String;
begin
  ValorS := FormatDateTime(Formato,Valor);
  Write(xml, '<' + Nome + '>' + ValorS + '</' + Nome + '>')
end;


procedure FechaTag_(Nome: String);
begin
  Write(xml, '</' + Nome + '>')
end;

procedure TTecNotaFiscalEletronica.ReadStreams;
var
  sent, recv: string;
begin

  if FSendStream <> nil then
  begin
    if FSendStream.Size > 0 then begin
      SetLength(sent, FSendStream.Size);
      FSendStream.Position := 0;
      FSendStream.Read(sent[1], FSendStream.Size);
      SalvarDadosnoArquivo(vArquivoLogNFSe, 'Send -> '+sent);
    end;
  end;

  if FReceiveStream <> nil then
  begin
    if FReceiveStream.Size > 0 then begin
      SetLength(recv, FReceiveStream.Size);
      FReceiveStream.Position := 0;
      FReceiveStream.Read(recv[1], FReceiveStream.Size);
      SalvarDadosnoArquivo(vArquivoLogNFSe, 'Receive -> '+recv);
    end;
  end;
    
end;

function TTecNotaFiscalEletronica.GetDiretorioErroNFSe: String;
begin
  Result := FDirErroNFSe
end;

procedure TTecNotaFiscalEletronica.SetDiretorioErroNFSe(
  const Value: String);
var
  Barra: Integer;
begin
  FDirErroNFSe := Value;
  Barra       := Length(FDirErroNFSe);
  if (Barra > 0) and (Value[Barra] <> '\') then
    FDirErroNFSe := FDirErroNFSe + '\'
end;



function TTecNotaFiscalEletronica.InfomrmacoesNFSEPalhoca(Notas, qryNotas, Servicos: TTecQuery; JustificativaCancelamento: String): Boolean;
begin

    Local := 'Nota Fiscal Serviço - Palhoça';

    if JustificativaCancelamento <> '' then
    begin
      AbreTag('nfse');
        AbreTag('nf');
          TagCompleta('numero', qryNotas.fieldbyname('numero').asString, false, false, false);
          TagCompleta('serie_nfse', {somentenumero(}trocar(qrynotas.fieldbyname('serie').asString, '*',''){)}, false, false, false);
          TagCompleta('situacao', 'C', false, false, false);
          TagCompleta('observacao', trim(Copy(justificativaCancelamento + ' ' + Notas.FieldByName('infcomplementar').AsString,1,1000)), true, true, true);
       FechaTag('nf');

       AbreTag('prestador');
         TagCompleta('cpfcnpj', preencheString(SomenteNumero(FEmit_Documento),'0',14,False), false, false, false);
         TagCompleta('cidade',  FEmit_CodMun, false, false, false);
       FechaTag('prestador');

      FechaTag('nfse');

    end
    else
    begin

      AbreTag('nfse');

  {     if (fNFSeAmbiente = 2) or Validando then   //homologação
         TagCompleta('nfse_teste', '1', false, false, false);}

       TagCompleta('identificador', notas.fieldbyname('numero').asString, false, false, false);

       AbreTag('rps');
        TagCompleta('nro_recibo_provisorio', qrynotas.fieldbyname('numero').asString, false, false, false);
        TagCompleta('serie_recibo_provisorio', {somentenumero(}trocar(qrynotas.fieldbyname('serie').asString, '*',''){)}, false, false, false);
        TagCompleta('data_emissao_recibo_provisorio', formatDatetime('dd/mm/yyyy',Notas.FieldByName('datahoraemissao').AsDateTime), false, false, false);
        TagCompleta('hora_emissao_recibo_provisorio', formatDatetime('hh:MM:ss',Notas.FieldByName('datahoraemissao').AsDateTime), false, false, false);
       FechaTag('rps');

       AbreTag('nf');
        TagCompleta('serie_nfse', {somentenumero(}trocar(qrynotas.fieldbyname('serie').asString, '*',''){)}, false, false, false);
        TagCompleta('data_fato_gerador', formatDatetime('dd/mm/yyyy',Notas.FieldByName('datahoraemissao').AsDateTime), false, false, false);


        if JustificativaCancelamento<>'' then
        begin
          TagCompleta('numero', qryNotas.fieldbyname('numero').asString, false, false, false);
          TagCompleta('situacao', 'C', false, false, false);

        end;

        TagCompleta('valor_total', notas.fieldbyname('valorservicos').AsCurrency, 2, False, true);
        TagCompleta('valor_desconto', notas.fieldbyname('desconto').AsCurrency, 2, False, true);
        TagCompleta('valor_ir', notas.FieldByName('irretido').AsCurrency, 2, False, true);
        TagCompleta('valor_inss', notas.FieldByName('inssretido').AsCurrency, 2, False, true);
        TagCompleta('valor_contribuicao_social', notas.fieldbyname('csllretido').AsCurrency, 2, False, true);
        TagCompleta('valor_rps',0, 2, False, true);
        TagCompleta('valor_pis', notas.FieldByName('pisretido').AsCurrency, 2, False, true);
        TagCompleta('valor_cofins', notas.fieldbyname('cofinsretido').AsCurrency, 2, False, true);

        if JustificativaCancelamento<>'' then
          TagCompleta('observacao', trim(Copy(justificativaCancelamento + ' ' + Notas.FieldByName('infcomplementar').AsString,1,1000)), true, true, true)
        else
          TagCompleta('observacao', trim(Copy(Notas.FieldByName('infcomplementar').AsString,1,1000)), true, true, true);
        
       FechaTag('nf');

       AbreTag('prestador');
         TagCompleta('cpfcnpj', preencheString(SomenteNumero(FEmit_Documento),'0',14,False), false, false, false);
         TagCompleta('cidade',  FEmit_CodMun, false, false, false);
       FechaTag('prestador');

       AbreTag('tomador');

         if (FDest_TipoPessoa = 'F') and HeUnidadeFederacao(FDest_UF) then
         begin
           TagCompleta('tipo',  'F', false, false, false);
           TagCompleta('cpfcnpj',  preencheString(SomenteNumero(FDest_Documento),'0',11,False), false, false, false);
         end
         else
         if HeUnidadeFederacao(FDest_UF) then
         begin
           TagCompleta('tipo', 'J', false, false, false);
           TagCompleta('cpfcnpj', preencheString(SomenteNumero(FDest_Documento),'0',14,False), false, false, false );
           TagCompleta('ie', SomenteNumero(FDest_IE), false, false, false );
         end
         else
         begin
           TagCompleta('tipo', 'E', false, false, false);
           TagCompleta('identificador', SomenteNumero(FDest_Documento), false, false, false)
         end;
         TagCompleta('nome_razao_social',  copy(FDest_Nome,1,100));

         if HeUnidadeFederacao(FDest_UF) then
         begin
           TagCompleta('sobrenome_nome_fantasia',  copy(FDest_Nome,1,100));
           TagCompleta('logradouro',   FDest_Rua);
           TagCompleta('email',  notas.fieldbyname('email').AsString, true, false);
           if FDest_Nro<>'' then
              TagCompleta('numero_residencia',    FDest_Nro, false);
           TagCompleta('complemento', FDest_Compl, true, true, true);
           TagCompleta('ponto_referencia','');
           TagCompleta('bairro',FDest_Bairro);
           TagCompleta('cidade', FDest_CodMun);
         end
         else
         begin
           TagCompleta('cidade', copy(FDest_Mun,1,100), false, false, false);
           TagCompleta('estado',   'EX');
           TagCompleta('pais',FDest_Pais);
           TagCompleta('cpfcnpj', '', false, false, false );
           TagCompleta('ie', '', false, false, false );
           TagCompleta('logradouro',   FDest_Rua);
           TagCompleta('email',  notas.fieldbyname('email').AsString, true, false);
           if FDest_Nro<>'' then
              TagCompleta('numero_residencia',    FDest_Nro, false);
           TagCompleta('complemento', FDest_Compl, true, true, true);
           TagCompleta('ponto_referencia','');
           TagCompleta('bairro',FDest_Bairro);

         end;

         TagCompleta('cep',  preencheString(FDest_CEP,'0',8,False));

         TagCompleta('ddd_fone_comercial', notas.fieldbyname('foneddd').asString, false, false, false);
         TagCompleta('fone_comercial', notas.fieldbyname('fonenumero').asString, false, false, false);

         TagCompleta('ddd_fone_residencial', notas.fieldbyname('foneddd').asString, false, false, false);
         TagCompleta('fone_residencial', notas.fieldbyname('fonenumero').asString, false, false, false);

         TagCompleta('ddd_fax', notas.fieldbyname('foneddd').asString, false, false, false);
         TagCompleta('fone_fax', notas.fieldbyname('fonenumero').asString, false, false, false);

       FechaTag('tomador');

       AbreTag('itens');
         Servicos.First;
         while not servicos.Eof do
         begin

           AbreTag('lista');
             TagCompleta('tributa_municipio_prestador', 'S',  false, false, false);
             TagCompleta('codigo_local_prestacao_servico',  FEmit_CodMun, false, false, false);
             TagCompleta('unidade_codigo', '1', false, false, false);
             TagCompleta('unidade_quantidade', servicos.fieldbyname('quantidade').asstring);
             TagCompleta('unidade_valor_unitario', servicos.fieldbyname('valorservico').AsCurrency,2, False, true);
             TagCompleta('codigo_item_lista_servico', somentenumero(servicos.fieldbyname('codigolcp116').asstring));
             TagCompleta('descritivo', copy(servicos.fieldbyname('descricao').asstring,1,1000));
             TagCompleta('aliquota_item_lista_servico', servicos.fieldbyname('aliquotaissqn').AsCurrency,2, False, true);
             TagCompleta('situacao_tributaria', servicos.fieldbyname('cstissqn').asstring);
             TagCompleta('valor_tributavel', (servicos.fieldbyname('quantidade').asFloat * servicos.fieldbyname('valorservico').AsCurrency), 2, False, true);

             if Servicos.FieldByName('reterissqn').AsBoolean then
               TagCompleta('valor_issrf', Servicos.FieldByName('valorissqn').AsCurrency,2)
             else
               TagCompleta('valor_issrf',0,2, False, true);

           FechaTag('lista');

           servicos.next;

         end;
       FechaTag('itens');
      FechaTag('nfse');
    end;
end;

function TTecNotaFiscalEletronica.ConteudomsgNodeXmlNFSe(Texto: String): Variant;
var
  Response: TStringStream;
  auxDocxml: IXMLDocument;
  a: integer;
  Node_a : IXMLNode;
begin
  Response := TStringStream.Create(StringReplace(Texto,#$A,'',[rfReplaceAll]));
  auxDocxml := TXMLDocument.Create(nil);

  try
    auxDocxml.LoadFromStream(Response);

    case ftipoemissaonfeservico of

      Florianopolis_SoftPlan:
      begin
        if (auxDocxml.DocumentElement.ChildNodes.FindNode('message')<>nil) then
          result := auxDocxml.DocumentElement.ChildNodes.FindNode('message').Text;
      end;

      Palhoca_IPM:
      begin
        if (auxDocxml.DocumentElement.ChildNodes.FindNode('mensagem').childnodes.findnode('codigo')<>nil) then
          result := auxDocxml.DocumentElement.ChildNodes.FindNode('mensagem').childnodes.findnode('codigo').Text;
      end;
    end;
  except
    result := false;
    result := Texto;
  end;

end;



function TTecNotaFiscalEletronica.ConsultarSituacaoLoteNfse(qryDadosFiscais, qryNotas: ttecQuery;
   Capturar_Somente_status_NFPSe: Boolean = false): Boolean;
var
  json: TJson;
  val: TJsonValue;
  vId : double;
  vCMCPrestador, fArqEnvioNFSe,  vRetornoHTTPPost, erro : String;
  vValidandoAux: Boolean;

begin

  if Capturar_Somente_status_NFPSe then
  begin
    if (qryDadosFiscais.FieldByName('numprotocolonfse').AsString <> '') or

      ( (qryNotas.FieldByName('numero').AsString <> '') and
        (qryNotas.FieldByName('serie').AsString <> '') and
        (DadosdaFilial('aedffatura', qryDadosFiscais.fieldbyname('filialemissao').asinteger))) then
    begin

      fArqEnvioNFSe := ArqEnvioConsultaNFSe(qryDadosFiscais,qryNotas);
      if FileExists(fArqEnvioNFSe) then
        DeleteFile(fArqEnvioNFSe);

      AssignFile(xml, FDirEnvioNFSe+nfse_temp);
      Rewrite(xml);

      try

        vValidandoAux := Validando;
        Validando := False;

        AbreTag('nfse');
         AbreTag('pesquisa');
           if (qryDadosFiscais.FieldByName('numprotocolonfse').AsString <> '') then
             TagCompleta('codigo_autenticidade', qryDadosFiscais.FieldByName('numprotocolonfse').AsString, false, false, false)
           else
           begin
             TagCompleta('numero', qryNotas.FieldByName('numero').AsString, false, false, false);
             TagCompleta('serie_nfse', StringReplace(qryNotas.FieldByName('serie').AsString, '*','', [rfReplaceAll]) , false, false, false);
             TagCompleta('cadastro', (DadosdaFilial('aedffatura', qryDadosFiscais.fieldbyname('filialemissao').asinteger)), false, false, false);
           end;
         FechaTag('pesquisa');
        FechaTag('nfse');

        try

          CloseFile(xml);
          RenameFile(FDirEnvioNFSe+nfse_temp,fArqEnvioNFSe);

          InstanciarObjetosNFPS(qryDadosFiscais.fieldbyname('filialemissao').asinteger);

          {
          if DadosdaFilial('senhacertificadodigital', qryDadosFiscais.fieldbyname('filialemissao').asinteger) <> null then
          begin
            if not assigned(ACBrDFe) then
              ACBrDFe := TACBrDFe.create(nil);

            ACBrDFe.SSL.ArquivoPFX := fCertificadoDigitalNFSe;
            ACBrDFe.SSL.senha := DadosdaFilial('senhacertificadodigital', qryDadosFiscais.fieldbyname('filialemissao').asinteger);
            ACBrDFe.Configuracoes.Geral.SSLLib := libWinCrypt;
            XMLStr := tstringlist.create;
            XMLUTF8_ := LerConteudoArquivo(farqEnvioNFSe);
            XMLUTF8 := ConverteXMLtoUTF8(XMLUTF8_);
            XMLAss := ACBrDFe.SSL.Assinar(XMLUTF8, 'nfse', 'itens');

            XMLStr.Clear;
            XMLStr.Text := XMLAss;
            XMLStr.SaveToFile(farqEnvioNFSe);
            XMLStr.Free;
          end;
          }

          objFORM.AddFile('f1', farqEnvioNFSe , 'plain/text');

          result := true;


          try
            vRetornoHTTPPost := objHTTP.Post(DadosdaFilial('site_nfse', qryDadosFiscais.fieldbyname('filialemissao').asinteger), objFORM);
          except
            on E:Exception do
              begin
                result := false;
                if Pos('404' , E.Message) > 0 then
                  E.Message := 'URL não encontrada ('+ DadosdaFilial('site_nfse', qryDadosFiscais.fieldbyname('filialemissao').asinteger)+')';

                MensagemErro('Erro: ' + E.Message);
              end;
          end;

          objFORM.free;

          if result then
          begin
            GravarArquivoxml(ArqRetornoNFSe(qryDadosFiscais, qryNotas), vRetornoHTTPPost, false);

            result := RetornoCamposNFPSe(qryDadosFiscais, qryNotas, false);

            if result and not Validando then
              result := GravarArquivoxml(ArqRetornoNFSe(qryDadosFiscais,qryNotas), vRetornoHTTPPost, true);

            if result  and not Validando then
              NomedoArquivoCompartilhado := ArqRetornoNFSe(qryDadosFiscais, qryNotas)
            else
              NomedoArquivoCompartilhado := '';

            if not result then
               MensagemErro(Format('Erro: %s', [Retorno_Mensagem_Codigo]))
          end
          else
          begin
            GravarArquivoxml(ArqErroRetornoNFSe(qryDadosFiscais, qrynotas), vRetornoHTTPPost);
            erro :=  ConteudomsgNodeXmlNFSe(vRetornoHTTPPost);

            if erro = '' then
              erro := vRetornoHTTPPost;

            MensagemErro(Format('Erro: %s', [erro]))
          end;

        except
          on E: Exception do
          begin
            result := false;
            MensagemErro(Format('Error: %s', [E.Message]));
          end;
        end;

      finally
        Validando := vValidandoAux;
      end;

    end
    else
    begin
      result := false;
      MensagemErro('Impossível capturar o Status da NFPSe sem o codigo de verificação ou Numero, série e AEDF!');
    end;
  end
  else
  begin

    result := RetornoCamposNFPSe(qryDadosFiscais, qryNotas);

    if not result then
    begin


      case ftipoemissaonfeservico of

        Florianopolis_SoftPlan :
        begin

          InstanciarObjetosNFPs(qryDadosFiscais.fieldbyname('filialemissao').Asinteger);

          res := FOAuthClient.Get('/api/v1/consultas/notas/identificacao/'+qryDadosFiscais.fieldbyname('numero').AsString+'?pagina=1');

          if res.Code = HTTP_OK then
          begin

            SalvarDadosToken(qryDadosFiscais.fieldbyname('filialemissao').AsInteger);

            if res.ContentType = 'application/json' then
            begin
              json := TJson.Create;
              try
                json.Parse(res.Body);
                val := json.GetValue('id',1);
                if val.Kind = JVKNumber then begin
                  vId := json.Output.Numbers[val.Index];
                end;

                val := json.GetValue('cmcPrestador',1);
                if val.Kind = JVKString then begin
                  vCMCPrestador := string(json.Output.Strings[val.Index]);
                end;

              finally
                json.Free;
              end;

              res := FOAuthClient.Get('/api/v1/consultas/notas/xml/'+ floattostr(vId)+'/'+vCMCPrestador);
              if res.Code = HTTP_OK then
              begin
                GravarArquivoxml(ArqRetornoNFSe(qryDadosFiscais, qryNotas), res.Body, false );
                result := RetornoCamposNFPSe(qryDadosFiscais, qryNotas);
                if result then
                  GravarArquivoxml(ArqRetornoNFSe(qryDadosFiscais, qryNotas), res.Body, true);

                if result then
                  NomedoArquivoCompartilhado := ArqRetornoNFSe(qryDadosFiscais, qryNotas)
                else
                  NomedoArquivoCompartilhado := '';

              end;
            end;

          end
          else
          begin
            result := false;
            MensagemErro(Format('Erro (%d): %s', [res.Code, res.Body]));
          end;
        end;

        Palhoca_IPM :
        begin

          {Não existe uma consulta por identificador, nem por recibo provisório neste caso,
           somente um reenvio do xml onde acusa a duplicidade do identificador informando o
           o nr do protocolo para depois capturar a situação da nota. Este passo vai ocorrer
           no reenvio da nota no controle de notas eletronicas, porém ao exluir diretamente
           nas notas avulsas será necessário tentar reenviar a nfse, sendo:
           . se a nota existir captura o protocolo
           . se der erro no envio, acredita-se que nem enviada foi

           A consulta para verificação é somente pelo numprotocolonfse}


           {MUDANÇA NA SITUAÇÃO ACIMA....AGORA EXISTE TAMBÉM A PESQUISA POR NÚMERO, SÉRIE E CADASTRO ECONÔMICO}

          if (qryDadosFiscais.FieldByName('numprotocolonfse').AsString <> '') or

             ((qryNotas.FieldByName('numero').AsString <> '') and
              (qryNotas.FieldByName('serie').AsString <> '') and
              (DadosdaFilial('aedffatura', qryDadosFiscais.fieldbyname('filialemissao').asinteger))) then
            result := ConsultarSituacaoLoteNfse(qryDadosFiscais, qryNotas, true);

        end;

      end;
    end;

  end;

end;

function TTecNotaFiscalEletronica.InstanciarObjetosNFPs(Filial: integer): boolean;
var
  msg_erro : string;
begin
  case ftipoemissaonfeservico of

     Palhoca_IPM :
     (*
     begin

        if not assigned(self.objHTTP) then
        begin
          self.objHTTP := TIdHTTP.Create;
          self.objHTTP.Request.UserAgent := 'Mozilla/3.0 (compatible; POAuth2)';
        end;

        if not assigned(self.FClient) then
          self.FClient := TIndyHttpClient.Create(self.objHTTP);

        cfg.TokenEndPoint := DadosdaFilial('urlauth_nfse', filial);


        if not assigned(self.FOAuthClient) then
        begin
          self.FOAuthClient := TOAuth2Client.Create(cfg, self.FClient);
          FOAuthClient.GrantType := gtPassword;

//          if DadosdaFilial('AccessToken', filial) <> null then
          begin
            if not assigned(FOAuthClient.AccessToken) then
              FOAuthClient.AccessToken := TOAuth2Token.Create;
                                              {
            FOAuthClient.AccessToken.AccessToken := DadosdaFilial('AccessToken', filial);
            FOAuthClient.AccessToken.RefreshToken := DadosdaFilial('RefreshToken', filial);
            FOAuthClient.AccessToken.ExpiresIn := DadosdaFilial('ExpiresIn', filial);
            FOAuthClient.AccessToken.TokenType := DadosdaFilial('TokenType', filial);

            FOAuthClient.AccessToken.MacKey := DadosdaFilial('MacKey', filial);
            FOAuthClient.AccessToken.MacAlgorithm := DadosdaFilial('MacAlgorithm', filial);
            FOAuthClient.Scope := DadosdaFilial('scope', filial);
            }

          end;
        end;


        FOAuthClient.Site := DadosdaFilial('site_nfse', filial);

        FOAuthClient.UserName := DadosdaFilial('usuario_nfse', filial);
        FOAuthClient.PassWord := uppercase(md5_(DadosdaFilial('senha_nfse', filial)));
//        FOAuthClient.ClientId := DadosdaFilial('client_id_nfse', filial);
//        FOAuthClient.ClientSecret := DadosdaFilial('client_secret_nfse', filial);


        if not assigned(self.FSendStream) then
          self.FSendStream := TMemoryStream.Create;

        if not assigned(self.FReceiveStream) then
          self.FReceiveStream := TMemoryStream.Create;

        if not assigned(self.FIdLog) then
          self.FIdLog := TIdLogStream.Create(nil);

        self.FIdLog.SendStream := FSendStream;
        self.FIdLog.ReceiveStream := FReceiveStream;
        self.FIdLog.FreeStreams := false;
        self.objHTTP.Intercept := FIdLog;
        self.FIdLog.Active := true;


        // 1) solicitar token
        FSendStream.Clear;
        FReceiveStream.Clear;

        FClient.Username := DadosdaFilial('usuario_nfse', filial);
        FClient.Password := DadosdaFilial('senha_nfse', filial);

     end;
     *)

     begin

        msg_erro := '';

        if DadosdaFilial('usuario_nfse', filial) = Null then
          msg_erro := msg_erro + '- Campo LOGIN é obrigatório.'+#13;

        if DadosdaFilial('senha_nfse', filial) = Null then
          msg_erro := msg_erro + '- Campo SENHA é obrigatório.'+#13;

        if DadosdaFilial('site_nfse', filial) = Null then
          msg_erro := msg_erro + '- Campo SITE é obrigatório.'+#13;

        if DadosdaFilial('codigotom', filial) = Null then
          msg_erro := msg_erro + '- Campo codigodimob (codigotom) é obrigatório.'+#13;




          {
        if (trim(farqEnvioNFSe) = '') then
          msg_erro := msg_erro + '- Campo arquivo é obrigatório.'+#13;

        if ((msg_erro = '') and  (not FileExists(farqEnvioNFSe))) then
          msg_erro := msg_erro + '- Arquivo não encontrado:'+ #13 + farqEnvioNFSe + #13;
          }

        if (msg_erro = '') then
        begin

          {-- Objeto necessário para envio quando for utilizar uma URL com HTTPS - INI --}
          {
          objSSL := TIdSSLIOHandlerSocketOpenSSL.Create(nil);
          objSSL.Port := 0;
          objSSL.DefaultPort := 0;
          objSSL.SSLOptions.Method := sslvSSLv3;
          objSSL.SSLOptions.Mode := sslmUnassigned;
          objSSL.SSLOptions.VerifyMode := [];
          objSSL.SSLOptions.VerifyDepth := 0;
          }
//          objSSL.sslOPtions.CertFile := 'C:\Clientes\certificado_sha.cer';
//          objSSL.sslOPtions.KeyFile := '123456';
//          objSSL.sslOPtions.RootCertFile := 'certificado_sha.cer';
          



          {-- FIM --}

          objHTTP := TIdHTTP.Create(nil);
//          objHTTP.IOHandler := objSSL;
          objHTTP.AllowCookies := true;
//          objHTTP.ProxyParams.BasicAuthentication := false;
//          objHTTP.ProxyParams.ProxyPort := 0;
          objHTTP.Request.ContentLength := -1;
//          objHTTP.Request.ContentType :=  'multipart/form-data';
          objHTTP.Request.Accept := 'text/html, */*';

//          objHTTP.Request.Clear;
          objHTTP.Request.BasicAuthentication:= true;
          objHTTP.Request.UserName := DadosdaFilial('usuario_nfse', filial);
          objHTTP.Request.Password := DadosdaFilial('senha_nfse', filial);

//          objHTTP.Request.BasicAuthentication := false;
          objHTTP.Request.UserAgent := 'Mozilla/3.0 (compatible; Indy Library)';
          objHTTP.HTTPOptions := [hoForceEncodeParams];

          objFORM  := TIdMultiPartFormDataStream.Create;
          objFORM.clear;
          objFORM.AddFormField('username', DadosdaFilial('usuario_nfse', filial));
          objFORM.AddFormField('password', DadosdaFilial('senha_nfse', filial));

//          objFORM.AddFormField('login', DadosdaFilial('usuario_nfse', filial));
//          objFORM.AddFormField('senha', DadosdaFilial('senha_nfse', filial));

//          objFORM.AddFormField('cidade', DadosdaFilial('codigotom', filial));


//          objFORM.AddFile('f1', farqEnvioNFSe , 'plain/text');

{

          try
            retorno.Text := objHTTP.Post(url.Text, objFORM);
          except
            on E:Exception do
              begin
                if Pos('404' , E.Message) > 0 then
                  E.Message := 'URL não encontrada ('+ url.Text+')';

                showmessage('Erro: ' + E.Message);
              end;
          end;

          FreeAndNil(objFORM);
          FreeAndNil(objSSL);
          FreeAndNil(objHTTP);
          }
        end
        else
          MensagemErro(msg_erro);

     end;


     Florianopolis_SoftPlan :
     begin

        if not assigned(self.objHTTP) then
        begin
          self.objHTTP := TIdHTTP.Create;
          self.objHTTP.Request.UserAgent := 'Mozilla/3.0 (compatible; POAuth2)';
        end;

        if not assigned(self.FClient) then
          self.FClient := TIndyHttpClient.Create(self.objHTTP);

        cfg.TokenEndPoint := DadosdaFilial('urlauth_nfse', filial);
      //        furlauth_nfse;


        if not assigned(self.FOAuthClient) then
        begin
          self.FOAuthClient := TOAuth2Client.Create(cfg, self.FClient);
          FOAuthClient.GrantType := gtPassword;

          if DadosdaFilial('AccessToken', filial) <> null then
          begin
            if not assigned(FOAuthClient.AccessToken) then
              FOAuthClient.AccessToken := TOAuth2Token.Create;

            FOAuthClient.AccessToken.AccessToken := DadosdaFilial('AccessToken', filial);
            FOAuthClient.AccessToken.RefreshToken := DadosdaFilial('RefreshToken', filial);
            FOAuthClient.AccessToken.ExpiresIn := DadosdaFilial('ExpiresIn', filial);
            FOAuthClient.AccessToken.TokenType := DadosdaFilial('TokenType', filial);

            FOAuthClient.AccessToken.MacKey := DadosdaFilial('MacKey', filial);
            FOAuthClient.AccessToken.MacAlgorithm := DadosdaFilial('MacAlgorithm', filial);
            FOAuthClient.Scope := DadosdaFilial('scope', filial);

          end;
        end;

        FOAuthClient.Site := DadosdaFilial('site_nfse', filial);
        //fsite_nfse;

        FOAuthClient.UserName := DadosdaFilial('usuario_nfse', filial);
        //fusuario_nfse;
        FOAuthClient.PassWord := uppercase(md5_(DadosdaFilial('senha_nfse', filial)));
        //uppercase(md5_(fsenha_nfse));
        FOAuthClient.ClientId := DadosdaFilial('client_id_nfse', filial);
        //fclient_id_nfse;
        FOAuthClient.ClientSecret := DadosdaFilial('client_secret_nfse', filial);
        //fclient_secret_nfse;


        if not assigned(self.FSendStream) then
          self.FSendStream := TMemoryStream.Create;

        if not assigned(self.FReceiveStream) then
          self.FReceiveStream := TMemoryStream.Create;

        if not assigned(self.FIdLog) then
          self.FIdLog := TIdLogStream.Create(nil);

        self.FIdLog.SendStream := FSendStream;
        self.FIdLog.ReceiveStream := FReceiveStream;
        self.FIdLog.FreeStreams := false;
        self.objHTTP.Intercept := FIdLog;
        self.FIdLog.Active := true;


        // 1) solicitar token
        FSendStream.Clear;
        FReceiveStream.Clear;

        FClient.Username := FOAuthClient.ClientId;
        FClient.Password := FOAuthClient.ClientSecret;

     end;

  end;

end;


class function TTecNotaFiscalEletronica.ChaveNFPSe(qryDadosFiscais, qryNotas: TTecQuery): String;
begin
  if qryNotas <> nil then
  begin

    Result := Copy(qryDadosFiscais.FieldByName('cidadeIBGE').asstring,1,2) +
              FormatDateTime('yymm', qryDadosFiscais.FieldByName('data').asDateTime) +
              somentenumero(DadosdaFilial('cnpj', qryDadosFiscais.fieldbyname('filialemissao').asInteger))+
              preencheString(qryDadosFiscais.FieldByName('ModeloDocto').AsString,'0',2,False) +

              trocar(preencheString(qryNotas.fieldbyname('serie').asString,'0',3,False),'*','_') +

              preencheString(qryDadosFiscais.FieldByName('nrdocumento').AsString,'0',9,False) +
              trim(qryDadosFiscais.FieldByName('formaemissao').AsString);

    if trim(qryDadosFiscais.FieldByName('numprotocolonfse').AsString) <> '' then
      result := trim(result) + preencheString(qryNotas.fieldbyname('numero').asString,'0',9,False)
      {
    else
    if self.numeroSerie_NFPSe<>'' then
      result := trim(result) + preencheString(self.numeroSerie_NFPSe,'0',9,False)
      }
    else
      result := trim(result) + preencheString(qryDadosFiscais.fieldbyname('nrdocumento').asString,'0',9,False);
  end
  else
  begin
    Result := Copy(qryDadosFiscais.FieldByName('cidadeIBGE').asstring,1,2) +
              FormatDateTime('yymm', qryDadosFiscais.FieldByName('data').asDateTime) +

              somentenumero(qryDadosFiscais.fieldbyname('cnpj').asString)+

              preencheString(qryDadosFiscais.FieldByName('ModeloDocto').AsString,'0',2,False) +

              trocar(preencheString(qryDadosFiscais.fieldbyname('serie').asString,'0',3,False),'*','_') +

              preencheString(qryDadosFiscais.FieldByName('nrdocumento').AsString,'0',9,False) +
              trim(qryDadosFiscais.FieldByName('formaemissao').AsString);

    if trim(qryDadosFiscais.FieldByName('numprotocolonfse').AsString) <> '' then
      result := trim(result) + preencheString(qryDadosFiscais.fieldbyname('nrdocumento').asString,'0',9,False);
  end;

//  fChaveNFe := result;
end;

function TTecNotaFiscalEletronica.ArqRetornoNFSe(qryDadosFiscais, qryNotas: TTecQuery): String;
begin
  result  := FDirREtornoNFSe +  ChaveNFPSe(qryDadosFiscais, qryNotas) + '-nfse_assinado.xml';
end;


procedure TTecNotaFiscalEletronica.SalvarDadosToken(filial: integer);
begin
  GravarDadosdaFilial('AccessToken', filial, FOAuthClient.AccessToken.AccessToken);
  GravarDadosdaFilial('RefreshToken', filial, FOAuthClient.AccessToken.RefreshToken);
  GravarDadosdaFilial('ExpiresIn', filial, FOAuthClient.AccessToken.ExpiresIn);
  GravarDadosdaFilial('TokenType', filial, FOAuthClient.AccessToken.TokenType);

  GravarDadosdaFilial('MacKey', filial, FOAuthClient.AccessToken.MacKey);
  GravarDadosdaFilial('MacAlgorithm', filial, FOAuthClient.AccessToken.MacAlgorithm);
  GravarDadosdaFilial('scope', filial, FOAuthClient.Scope);
end;

function TTecNotaFiscalEletronica.RetornoCamposNFPSe(qryDadosFiscais, qryNotas: TTecQuery;
                                EhDadoFiscal: Boolean = True): boolean;

var
  vChildNode: IXMLNodeList;
begin
  result := false;
  case ftipoemissaonfeservico of

    Florianopolis_SoftPlan :
    begin
      if assigned(Docxml) and
         (Docxml.DocumentElement.ChildNodes.FindNode('identificacao')<>nil) and
         (Docxml.DocumentElement.ChildNodes.FindNode('identificacao').Text = qryDadosFiscais.fieldbyname('numero').asString) then
      begin
        codigoVerificacao_NFPSe := Docxml.DocumentElement.ChildNodes.FindNode('codigoVerificacao').Text;
        numeroSerie_NFPSe := Docxml.DocumentElement.ChildNodes.FindNode('numeroSerie').Text;
        status_NFPSe := Docxml.DocumentElement.ChildNodes.FindNode('statusNFPSe').Text;
        DataHoraProcessamento_NFPSe := trocar(Docxml.DocumentElement.ChildNodes.FindNode('dataProcessamento').Text,'T',' ');
        DataEmissao_NFPSe := trocar(Docxml.DocumentElement.ChildNodes.FindNode('dataEmissao').Text,'T',' ');
        dataCancelamento_NFPSe := '';

        if Docxml.DocumentElement.ChildNodes.FindNode('dataCancelamento') <> nil then
          dataCancelamento_NFPSe := trocar(Docxml.DocumentElement.ChildNodes.FindNode('dataCancelamento').Text,'T',' ');

        result := true;
      end;
    end;

    Palhoca_IPM :
    begin
      if assigned(Docxml) then
      begin

        {Arquivo Simplificado}

        if ( (Docxml.DocumentElement.ChildNodes.FindNode('numero_nfse')<>nil) and
             (Docxml.DocumentElement.ChildNodes.FindNode('serie_nfse')<>nil) and
             (Docxml.DocumentElement.ChildNodes.FindNode('numero_nfse').Text = qryNotas.fieldbyname('numero').asString) and
             (Docxml.DocumentElement.ChildNodes.FindNode('serie_nfse').Text = qryNotas.fieldbyname('serie').asString)

             {and eHDadofiscal}) or

           ((Docxml.DocumentElement.ChildNodes.FindNode('cod_verificador_autenticidade')<>nil) and
            (Docxml.DocumentElement.ChildNodes.FindNode('cod_verificador_autenticidade').Text =
                   qryDadosFiscais.FieldByName('numprotocolonfse').AsString) {and not eHDadofiscal}) then

          vChildNode := Docxml.DocumentElement.ChildNodes

       else
       if (Docxml.DocumentElement.ChildNodes.FindNode('nf')<>nil) then
       begin

          if

          ((Docxml.DocumentElement.ChildNodes.FindNode('nf').ChildNodes.FindNode('numero_nfse')<>nil) and
           (Docxml.DocumentElement.ChildNodes.FindNode('nf').ChildNodes.FindNode('serie_nfse')<>nil) and
           (Docxml.DocumentElement.ChildNodes.FindNode('nf').ChildNodes.FindNode('numero_nfse').Text = qryNotas.fieldbyname('numero').asString) and
           (Docxml.DocumentElement.ChildNodes.FindNode('nf').ChildNodes.FindNode('serie_nfse').Text = qryNotas.fieldbyname('serie').asString)


            {PROBLEMA: ESTAMOS INFORMANDO SERIE 3 E O SISTEMA ESTA RETORNANDO SEMPRE 1]
            {qryNotas.fieldbyname('serie').asString)}
            {SETADO SERIE=1 NAS TABELAS NOTA E SERIES FILIAIS}

             {and eHDadofiscal}) or

          ((Docxml.DocumentElement.ChildNodes.FindNode('nf').ChildNodes.FindNode('cod_verificador_autenticidade')<>nil) and
           (Docxml.DocumentElement.ChildNodes.FindNode('nf').ChildNodes.FindNode('cod_verificador_autenticidade').Text =
                   qryDadosFiscais.FieldByName('numprotocolonfse').AsString) {and not eHDadofiscal}) then

           vChildNode := Docxml.DocumentElement.ChildNodes.FindNode('nf').ChildNodes;
       end;

       if vChildNode <> nil then
       begin
         with vChildNode do
         begin

          codigoVerificacao_NFPSe := FindNode('cod_verificador_autenticidade').Text;

          numeroSerie_NFPSe := FindNode('numero_nfse').Text;
          Serie_NFPSe := FindNode('serie_nfse').Text;
          link_nfse := FindNode('link_nfse').Text;

          if FindNode('situacao_codigo_nfse')<> nil then  {só retorna quando for uma consulta por cod_verificador_autenticidade ou serie e numero}
            status_NFPSe := FindNode('situacao_codigo_nfse').Text;   {Código da situação da NFS-e (1-Emitida, 2-Cancelada)}

          DataHoraProcessamento_NFPSe := formatdatetime('yyyy/mm/dd',strtodate(FindNode('data_nfse').Text)) + ' ' +
                                         FindNode('hora_nfse').Text;

          DataEmissao_NFPSe := DataHoraProcessamento_NFPSe;
          dataCancelamento_NFPSe := '';

  //        if Docxml.ChildNodes.FindNode('dataCancelamento') <> nil then
          if status_NFPSe = '2' then  //
             dataCancelamento_NFPSe :=  formatdatetime('yyyy/mm/dd hh:MM:ss', DataHoraLocal);  //não existe esta informação

          Retorno_Mensagem_Codigo := '';
          if FindNode('mensagem')<>nil then
            if FindNode('mensagem').ChildNodes.findNode('codigo')<> nil then
            Retorno_Mensagem_Codigo :=  FindNode('mensagem').ChildNodes.findNode('codigo').text;

          result := true;

//          if Validando then
            if Retorno_Mensagem_Codigo <> '' then
               result := (Retorno_Mensagem_Codigo = '00001 - Sucesso')
            else
               result := (status_NFPSe = '1') or //incluida
                         (status_NFPSe = '2'); //cancelada



              {
              result := (pos('285', Retorno_Mensagem_Codigo)<>0) or
                        (pos('209', Retorno_Mensagem_Codigo)<>0);
                        }
         end;
       end




        (*
        if ((Docxml.DocumentElement.ChildNodes.FindNode('identificador')<>nil) and
            (Docxml.DocumentElement.ChildNodes.FindNode('identificador').Text = DadoFiscal) and eHDadofiscal) or

           ((Docxml.DocumentElement.ChildNodes.FindNode('cod_verificador_autenticidade')<>nil) and
            (Docxml.DocumentElement.ChildNodes.FindNode('cod_verificador_autenticidade').Text = DadoFiscal) and not eHDadofiscal) then
        begin

          codigoVerificacao_NFPSe := Docxml.DocumentElement.ChildNodes.FindNode('cod_verificador_autenticidade').Text;

          numeroSerie_NFPSe := Docxml.DocumentElement.ChildNodes.FindNode('numero_nfse').Text;
          Serie_NFPSe := Docxml.DocumentElement.ChildNodes.FindNode('serie_nfse').Text;
          link_nfse := Docxml.DocumentElement.ChildNodes.FindNode('link_nfse').Text;

          if Docxml.DocumentElement.ChildNodes.FindNode('situacao_codigo_nfse')<> nil then  {só retorna quando for uma consulta por cod_verificador_autenticidade ou serie e numero}
            status_NFPSe := Docxml.DocumentElement.ChildNodes.FindNode('situacao_codigo_nfse').Text;   {Código da situação da NFS-e (1-Emitida, 2-Cancelada)}

          DataHoraProcessamento_NFPSe := formatdatetime('yyyy/mm/dd',strtodate(Docxml.DocumentElement.ChildNodes.FindNode('data_nfse').Text)) + ' ' +
                                         Docxml.DocumentElement.ChildNodes.FindNode('hora_nfse').Text;

          DataEmissao_NFPSe := DataHoraProcessamento_NFPSe;
          dataCancelamento_NFPSe := '';

  //        if Docxml.ChildNodes.FindNode('dataCancelamento') <> nil then
          if status_NFPSe = '2' then  //
             dataCancelamento_NFPSe :=  formatdatetime('yyyy/mm/dd hh:MM:ss', DataHoraLocal);  //não existe esta informação

          Retorno_Mensagem_Codigo := '';
          if Docxml.DocumentElement.ChildNodes.FindNode('mensagem').ChildNodes.findNode('codigo')<> nil then
            Retorno_Mensagem_Codigo :=  Docxml.DocumentElement.ChildNodes.FindNode('mensagem').ChildNodes.findNode('codigo').text;

          result := true;

          if Validando then
            if Retorno_Mensagem_Codigo <> '' then
              result := (pos('285', Retorno_Mensagem_Codigo)<>0) or (pos('209', Retorno_Mensagem_Codigo)<>0);

        end
        *)
        else
//        if validando or (fNFSeAmbiente = 2) then
        begin
          result := false;
          Retorno_Mensagem_Codigo := '';

          if Docxml.DocumentElement.ChildNodes.FindNode('mensagem')<>nil then
            if Docxml.DocumentElement.ChildNodes.FindNode('mensagem').ChildNodes.findNode('codigo')<> nil then
              Retorno_Mensagem_Codigo :=  Docxml.DocumentElement.ChildNodes.FindNode('mensagem').ChildNodes.findNode('codigo').text;

//          if Validando then
            if Retorno_Mensagem_Codigo <> '' then
              result := (Retorno_Mensagem_Codigo = '00001 - Sucesso');

              {
              result := (pos('285', Retorno_Mensagem_Codigo)<>0) or
                        (pos('209', Retorno_Mensagem_Codigo)<>0);
              }

        end;
      end;
    end;
  end;

end;

function TTecNotaFiscalEletronica.CancelarNFPSe(qryDadosFiscais,
  qryNotas, qryServicos: tTecQuery; Justificativa: String): Boolean;
var
  XMLStr : tStringlist;
  XMLUTF8, XMLUTF8_,  XMLAss, erro, farqEnvioCancelamentoNFSe, fArqRetornoCancelamentoNFSe, fArqErroCancelamentoNFSe  : String;

  vRetornoHTTPPost : String;

begin

  farqEnvioCancelamentoNFSe := ArqEnvioCancelamentoNFSe(qryDadosFiscais,qryNotas);

  if FileExists(fArqEnvioCancelamentoNFSe) then
    DeleteFile(fArqEnvioCancelamentoNFSe);

  AssignFile(xml, FDirEnvioNFSe+nfse_temp);
  Rewrite(xml);

  Local := 'Cancelamento Nota Fiscal Serviço - Florianópolis';

  case ftipoemissaonfeservico of

    Florianopolis_SoftPlan:
    begin


      try
        try


            AbreTag('xmlCancelamentoNfpse');

              TagCompleta('motivoCancelamento', copy(Justificativa,1,120));

              if qryDadosFiscais.FieldByName('ambientenfs').AsString = '1' then {produção}
                TagCompleta('nuAedf', DadosdaFilial('aedffatura', qryDadosFiscais.fieldbyname('filialemissao').asinteger))
              else
                TagCompleta('nuAedf', copy(somentenumero(fInscricaoMunicipalFilialBase), 1, length(somentenumero(fInscricaoMunicipalFilialBase))-1));

              TagCompleta('nuNotaFiscal', qryNotas.fieldbyname('numero').asString, false, false, false);
              TagCompleta('codigoVerificacao', qryDadosFiscais.fieldbyname('numprotocolonfse').asString, false, false, false);

            FechaTag('xmlCancelamentoNfpse');



          CloseFile(xml);
          RenameFile(FDirEnvioNFSe+nfse_temp,fArqEnvioCancelamentoNFSe);

          InstanciarObjetosNFPS(qryDadosFiscais.fieldbyname('filialemissao').asinteger);

          if not assigned(ACBrDFe) then
            ACBrDFe := TACBrDFe.create(nil);

          ACBrDFe.SSL.ArquivoPFX := fCertificadoDigitalNFSe;

          ACBrDFe.SSL.NumeroSerie := DadosdaFilial('numeroseriecertificadodigital', qryDadosFiscais.fieldbyname('filialemissao').asinteger);
          ACBrDFe.SSL.senha := DadosdaFilial('senhacertificadodigital', qryDadosFiscais.fieldbyname('filialemissao').asinteger);

          {
          ACBrDFe.SSL.SSLCryptLib := cryWinCrypt;
          ACBrDFe.SSL.SSLHttpLib := httpWinHttp;
          ACBrDFe.SSL.SSLXmlSignLib := xsMsXml;
          }

          ACBrDFe.Configuracoes.Geral.SSLLib := libWinCrypt;
          XMLStr := tstringlist.create;
          XMLUTF8_ := LerConteudoArquivo(fArqEnvioCancelamentoNFSe);
          XMLUTF8 := ConverteXMLtoUTF8(XMLUTF8_);
          XMLAss := ACBrDFe.SSL.Assinar(XMLUTF8, 'xmlCancelamentoNfpse', 'codigoVerificacao');
          XMLStr.Clear;
          XMLStr.Text := XMLAss;
          XMLStr.SaveToFile(farqEnvioCancelamentoNFSe);
          XMLStr.Free;

          res := FOAuthClient.Post('/api/v1/cancelamento/notas/cancela', farqEnvioCancelamentoNFSe);

          if res.Code = HTTP_OK then
          begin
            fArqRetornoCancelamentoNFSe := ArqRetornoCancelamentoNFSe(qryDadosFiscais, qryNotas);
            GravarArquivoxml(fArqRetornoCancelamentoNFSe, res.Body, false);
            SalvarDadosToken(qryDadosFiscais.fieldbyname('filialemissao').asinteger);
            result := RetornoCamposCancelamentoNFPSe(qryDadosFiscais.fieldbyname('numero').asString);

            if result then
              result := GravarArquivoxml(fArqRetornoCancelamentoNFSe, res.Body, true);

            if result then
              NomedoArquivoCompartilhado := fArqRetornoCancelamentoNFSe
            else
              NomedoArquivoCompartilhado := '';

          end
          else
          begin
            fArqErroCancelamentoNFSe := ArqErroCancelamentoNFSe(qryDadosFiscais,qryNotas);
            GravarArquivoxml(fArqErroCancelamentoNFSe, res.Body);
            result := false;
            erro :=  ConteudomsgNodeXmlNFSe(res.Body);
            if erro = '' then
              erro := res.Body;

            MensagemErro(Format('Erro (%d): %s', [res.Code, erro]))

          end;

        except
          on E: Exception do
          begin
            result := false;
            MensagemErro(Format('Error: %s', [E.Message]));

          end;
        end;

      finally
        ReadStreams;
      end;
    end;

    Palhoca_IPM:
    begin
      InfomrmacoesNFSEPalhoca(qryDadosFiscais, qryNotas, qryServicos, Justificativa);
      try

        try

          CloseFile(xml);
          RenameFile(FDirEnvioNFSe+nfse_temp,fArqEnvioCancelamentoNFSe);

          InstanciarObjetosNFPS(qryDadosFiscais.fieldbyname('filialemissao').asinteger);
          {
          if DadosdaFilial('senhacertificadodigital', notas.fieldbyname('filialemissao').asinteger) <> null then
          begin
            if not assigned(ACBrDFe) then
              ACBrDFe := TACBrDFe.create(nil);

            ACBrDFe.SSL.ArquivoPFX := fCertificadoDigitalNFSe;
            ACBrDFe.SSL.senha := DadosdaFilial('senhacertificadodigital', notas.fieldbyname('filialemissao').asinteger);
            ACBrDFe.Configuracoes.Geral.SSLLib := libWinCrypt;
            XMLStr := tstringlist.create;
            XMLUTF8_ := LerConteudoArquivo(farqEnvioNFSe);
            XMLUTF8 := ConverteXMLtoUTF8(XMLUTF8_);
            XMLAss := ACBrDFe.SSL.Assinar(XMLUTF8, 'nfse', 'itens');

            XMLStr.Clear;
            XMLStr.Text := XMLAss;
            XMLStr.SaveToFile(farqEnvioNFSe);
            XMLStr.Free;
          end;
          }

          objFORM.AddFile('f1', fArqEnvioCancelamentoNFSe , 'plain/text');

          result := true;


          try
            vRetornoHTTPPost := objHTTP.Post(DadosdaFilial('site_nfse', qryDadosFiscais.fieldbyname('filialemissao').asinteger), objFORM);
          except
            on E:Exception do
              begin
                result := false;
                if Pos('404' , E.Message) > 0 then
                  E.Message := 'URL não encontrada ('+ DadosdaFilial('site_nfse', qryDadosFiscais.fieldbyname('filialemissao').asinteger)+')';

                MensagemErro('Erro: ' + E.Message);
              end;
          end;

          objFORM.free;

          fArqRetornoCancelamentoNFSe := ArqRetornoCancelamentoNFSe(qryDadosFiscais, qryNotas);

          if result then
          begin

            GravarArquivoxml(fArqRetornoCancelamentoNFSe, vRetornoHTTPPost, false);

            NFe.status_NFPSe := '';

            result := RetornoCamposNFPSe(qryDadosFiscais, qryNotas);

            if result and not Validando then
              result := GravarArquivoxml(fArqRetornoCancelamentoNFSe, vRetornoHTTPPost, true);

            if result  and not Validando then
              NomedoArquivoCompartilhado := fArqRetornoCancelamentoNFSe
            else
              NomedoArquivoCompartilhado := '';

            if not result then
            begin
//              GravarArquivoxml(fArqRetornoCancelamentoNFSe, vRetornoHTTPPost);
              erro :=  ConteudomsgNodeXmlNFSe(vRetornoHTTPPost);

              if erro = '' then
                erro := vRetornoHTTPPost;

//              MensagemErro(Format('Erro: %s', [RetRetorno_Mensagem_Codigo]))
              MensagemErro(Format('Erro: %s', [erro]));
            end;



          end
          else
          begin
            GravarArquivoxml(fArqRetornoCancelamentoNFSe, vRetornoHTTPPost);
            erro :=  ConteudomsgNodeXmlNFSe(vRetornoHTTPPost);

            if erro = '' then
              erro := vRetornoHTTPPost;

            MensagemErro(Format('Erro: %s', [erro]))
          end;

          if result then
            if (ftipoemissaonfeservico = Palhoca_IPM) then
               if NFe.status_NFPSe = '' then   {o status não é retornado na inclusão no webservice, somente pela numero de autenticidade ou numero e serie + login e senha}
                  Result := NFe.ConsultarSituacaoLoteNfse(qryDadosFiscais,qryNotas, true);


        except
          on E: Exception do
          begin
            result := false;
            MensagemErro(Format('Error: %s', [E.Message]));
          end;
        end;

      finally
        ReadStreams;
      end;
    end;
  end;

end;

function TTecNotaFiscalEletronica.ArqEnvioNFSe(qryDadosFiscais,
  qryNotas: TTecQuery): String;
begin
  result  := FDirEnvioNFSe +  ChaveNFPSe(qryDadosFiscais, qryNotas) + '-nfse.xml';
end;

function TTecNotaFiscalEletronica.ArqEnvioCancelamentoNFSe(qryDadosFiscais,
  qryNotas: TTecQuery): String;
begin
  result  := FDirEnvioNFSe +  ChaveNFPSe(qryDadosFiscais, qryNotas) + 'cancelamento-nfse.xml';
end;

function TTecNotaFiscalEletronica.ArqRetornoCancelamentoNFSe(
  qryDadosFiscais, qryNotas: TTecQuery): String;
begin
  result  := FDirREtornoNFSe +  ChaveNFPSe(qryDadosFiscais, qryNotas) + 'cancelamento-nfse_assinado.xml';
end;

function TTecNotaFiscalEletronica.RetornoCamposCancelamentoNFPSe(
  DadoFiscal: String): boolean;
begin
  result := false;

  if assigned(Docxml) and
     (Docxml.DocumentElement.ChildNodes.FindNode('identificacao')<>nil) and
     (Docxml.DocumentElement.ChildNodes.FindNode('identificacao').Text = DadoFiscal) then
  begin
    codigoVerificacao_NFPSe := Docxml.DocumentElement.ChildNodes.FindNode('codigoVerificacao').Text;
    numeroSerie_NFPSe := Docxml.DocumentElement.ChildNodes.FindNode('numeroSerie').Text;
    status_NFPSe := Docxml.DocumentElement.ChildNodes.FindNode('statusNFPSe').Text;
    DataHoraProcessamento_NFPSe := trocar(Docxml.DocumentElement.ChildNodes.FindNode('dataProcessamento').Text,'T',' ');
    DataEmissao_NFPSe := trocar(Docxml.DocumentElement.ChildNodes.FindNode('dataEmissao').Text,'T',' ');
    dataCancelamento_NFPSe := trocar(Docxml.DocumentElement.ChildNodes.FindNode('dataCancelamento').Text,'T',' ');

    result := true;
  end

end;

function TTecNotaFiscalEletronica.ArqErroCancelamentoNFSe(qryDadosFiscais,
  qryNotas: TTecQuery): String;
begin
  result  := FDirErroNFSe + ChaveNFPSe(qryDadosFiscais, qryNotas) + 'cancelamento-nfse_erro.xml';
end;

function TTecNotaFiscalEletronica.ArqErroRetornoNFSe(qryDadosFiscais,
  qryNotas: TTecQuery): String;
begin
  result  := FDirErroNFSe + ChaveNFPSe(qryDadosFiscais, qryNotas) + '-nfse_erro.xml';
end;


procedure TTecNotaFiscalEletronica.ReiniciarUNINFE;
begin

//  fExecutavel := Value;
//  fProcesso := copy(fExecutavel, LastDelimiter('\',fExecutavel)+1,Length(fExecutavel));
//  fDiretorioExec := copy(fExecutavel,1, LastDelimiter('\',fExecutavel));
  if ProcessoExiste(fProcesso) then
  begin
    KillTask(fExecutavel);
    Sleep(delay);

    if not ProcessoExiste(fProcesso) then
    begin
      ExecutarProcesso(fExecutavel,'', fDiretorioExec, 0);
      Sleep(delay);
    end;

  end;
end;

function TTecNotaFiscalEletronica.GetValidando: Boolean;
begin
  result := fValidando;
end;

procedure TTecNotaFiscalEletronica.SetValidando(const Value: Boolean);
begin
  fValidando := Value;
end;

function TTecNotaFiscalEletronica.ArqEnvioConsultaNFSe(qryDadosFiscais,
  qryNotas: TTecQuery): String;
begin
  result  := FDirEnvioNFSe +  ChaveNFPSe(qryDadosFiscais, qryNotas) + '-consulta_nfse.xml';
end;

function TTecNotaFiscalEletronica.ehnotafiscalentradadevolucao(
  codigofiscal: integer; DataBase: TtecDatabase): boolean;

var
  qryConsulta: TTecQuery;
begin

  try
    result := false;
    qryConsulta := TTecQuery.Create(nil);
    qryConsulta.Database := DataBase;

    qryConsulta.Sql.Text := 'select ehnotafiscalentradadevolucao('+inttostr(codigofiscal)+') as ehnotafiscalentradadevolucao ';
    qryConsulta.open;

    result := qryConsulta.fieldbyname('ehnotafiscalentradadevolucao').asBoolean;
  finally
    qryConsulta.free;
  end;
end;

function TTecNotaFiscalEletronica.GetinfIntermed(
  qryDadosFiscais: TTecQuery): TinfIntermed;
begin
  if not assigned(finfIntermed) then
    finfIntermed := tinfIntermed.create;

  result := finfIntermed;

  finfIntermed.Atribuir(qryDadosFiscais);

end;

destructor TTecNotaFiscalEletronica.Destroy;
begin
  if assigned(finfIntermed) then
  begin
    finfIntermed.free;
    finfIntermed := nil;
  end;

  inherited;
end;

function TTecNotaFiscalEletronica.GetcBenef(pCodigodoProduto, pEmit_CRT,
  pEmit_UF, pCST, pCSOSN, pCodigoFiscal: String): String;
begin

  qrycaracteristicas_cbenef.ParamByName('pCodigodoProduto').asString := pCodigodoProduto;
  qrycaracteristicas_cbenef.ParamByName('pEmit_CRT').asString := pEmit_CRT;
  qrycaracteristicas_cbenef.ParamByName('pEmit_UF').asString := pEmit_UF;
  qrycaracteristicas_cbenef.ParamByName('pCST').asString := pCST;
  qrycaracteristicas_cbenef.ParamByName('pCSOSN').asString := pCSOSN;
  qrycaracteristicas_cbenef.ParamByName('pCodigoFiscal').asString := pCodigoFiscal;


  qrycaracteristicas_cbenef.close;
  qrycaracteristicas_cbenef.open;

  fcBenef := qrycaracteristicas_cbenef.fieldbyname('cbenef').asString;

  result := fcBenef;

end;

function TTecNotaFiscalEletronica.Getqrycaracteristicas_cbenef: TTEcQuery;
begin
  if not assigned(fqrycaracteristicas_cbenef) then
  begin
    fqrycaracteristicas_cbenef := TTecQuery.Create(nil);
    fqrycaracteristicas_cbenef.Database := pDataBase;

    fqrycaracteristicas_cbenef.Sql.Text :=
      'select Codigo_cBenef(:pCodigodoProduto, :pEmit_CRT, :pEmit_UF, :pCST, :pCSOSN, :pCodigoFiscal) as cbenef';
  end;

  Result := fqrycaracteristicas_cbenef;
end;

{ TinfIntermed }


procedure TinfIntermed.Atribuir(qryDadosFiscais: TTecQuery);
begin


  if not assigned(qryMarketPlace) then
  begin
    qryMarketPlace := TTecQuery.Create(nil);
    qryMarketPlace.Database := qryDadosFiscais.DataBase;

    qryMarketPlace.Sql.Text :=

    '   select mk.cnpj_intermediador,                 '+
    '          mk.nomevendedor_marketplace            '+
    '   from pedidos_site p_s                         '+
    '        join marketplace mk                      '+
    '        on p_s.codigo_marketplace = mk.codigo    '+
    '   where p_s.contrato = :contrato                  ';
	
	//qryMarketPlace.Sql.Text :='select 1 where false and cast(1 as varchar)=:contrato';

  end;


  if qryDadosFiscais.FindField('contrato')<>nil then
  begin
    if qryMarketPlace.parambyname('contrato').assTring <>
       qryDadosFiscais.FindField('contrato').asString then
    begin
      qryMarketPlace.parambyname('contrato').assTring := qryDadosFiscais.FindField('contrato').asString;
      qryMarketPlace.close;
      qryMarketPlace.open;

      if qryMarketPlace.IsEmpty then
      begin
        cnpj := '';
        idCadIntTran := '';
        indIntermed := '0';
      end
      else
      begin
        cnpj := qryMarketPlace.fieldByname('cnpj_intermediador').asString;
        idCadIntTran := qryMarketPlace.fieldByname('nomevendedor_marketplace').asString;
        indIntermed := '1';
        if cnpj='' then
          MensagemErro_('CNPJ do intermediador não cadastrado na tabela MarketPlace', true);

        if idCadIntTran='' then
          MensagemErro_('Nome do Vendedor MarketPlace não cadastrado na tabela MarketPlace', true);


      end;


    end;
  end
  else
  begin
    cnpj := '';
    idCadIntTran := '';
    indIntermed := '0';
  end;

end;

destructor TinfIntermed.Destroy;
begin
  if assigned(fqryMarketPlace) then
    fqryMarketPlace := nil;

  inherited;
end;

function TinfIntermed.GetCNPJ: String;
begin
  Result := fCNPJ;
end;

function TinfIntermed.GetidCadIntTran: String;
begin
  Result := fidCadIntTran;
end;

function TinfIntermed.GetindIntermed: STring;
begin
  Result := findIntermed;
end;

initialization
// GerarNotaEletronica :=  GerarNotaEletronica_;

end.
