function TTecNotaFiscalEletronica.ImprimirDanfe({NFe,}Filial, Serie, Numero, CepEntrega,
  EmailDestinatario, NumVias, Logo, Impressora: String; Visualizar: Boolean; Emissao: TDateTime;
  Produtos: TTecQuery; Executavel: String; Procedimento : TtecProcedimento;
  TipoNota: String; ValorTroco: Currency;
  ViaOperacoes: Boolean;
  modelodoctofiscal: String): Boolean;
var
  Caminho,
  Processo, Dir: String;
  vxmlnfe : tStringList;
  qryxmlnfe : TTecQuery;

  ACBrNFe1: TACBrNFe;
  DANFE1 :  TACBrNFeDANFERL;
  DANFEFR : TACBrNFeDANFEFR;

  sFile : String;


  Function Buscarxmlnfe(tipo: String): TMemoField;
  begin
    qryxmlnfe := TTecQuery.create(nil);
    qryxmlnfe.Database := Produtos.DataBase;
    if tipo = 'S' then
      qryxmlnfe.Sql.text := 'select df.xmlnfe from dadosfiscais df where df.numero = '+
                            '(select n.dadofiscal from notas n where n.filial = '+filial+' and n.Serie = '+quotedstr(serie)+' and n.numero ='+numero+')'
    else
      qryxmlnfe.Sql.text := 'select np.xmlnfe from notaspag np where coalesce(np.permitirimprimir,false) and np.filial = '+filial+' and np.Serie = '+quotedstr(serie)+' and np.numero ='+numero;

    qryxmlnfe.open;
    result := TMemoField(qryxmlnfe.fields[0]);
  end;

begin

  SituacaoImpressaoDanfe := Nenhuma;

  result := false;

  if (fFormaemissao = '1') or (Procedimento = Enviar) then
    Caminho := FDirCompartilha + FormatDateTime('yyyy',Emissao)  + '\' +
                                 FormatDateTime('mm'  ,Emissao)  + '\' +
                                 FormatDateTime('dd'  ,Emissao)  + '\nfeProc' +
                                 preencheString(Filial,'0',2,False) +
                                 preencheString(Serie, '0',2,False) +
                                 preencheString(Numero,'0',9,False)
  else
    Caminho := StringReplace(FDirEnvio, '\Envio\','\Validar\', [rfReplaceAll, rfIgnoreCase])+'Validado\'+fChaveNFe+'-nfe';

  result := FileExists(Caminho+'.xml');
  if result then
  begin
    if ValorRetornoXML(Caminho+'.xml', 'NFe', ExibirMsgNfe)='' then
      result := false;
  end
  else
  begin
    vxmlnfe := tStringList.create;
    vxmlnfe.Assign(Buscarxmlnfe(TipoNota));

    if vxmlnfe.Count <> 0 then
    begin

      if not DirectoryExists(FDirCompartilha) then
        if not CreateDir(FDirCompartilha) then
        begin
          result := false;
          raise Exception.Create('Impossível criar o diretório ' + FDirCompartilha);
        end;

      Dir := FDirCompartilha+FormatDateTime('yyyy',Emissao);
      if not DirectoryExists(Dir) then
        if not CreateDir(Dir) then
        begin
          result := false;
          raise Exception.Create('Impossível criar o diretório ' + Dir);
        end;

      Dir := Dir + '\' + FormatDateTime('mm',Emissao);
      if not DirectoryExists(Dir) then
        if not CreateDir(Dir) then
        begin
          result := false;
          raise Exception.Create('Impossível criar o diretório ' + Dir);
        end;

      Dir := Dir + '\' + FormatDateTime('dd',Emissao);
      if not DirectoryExists(Dir) then
        if not CreateDir(Dir) then
        begin
          result := false;
          raise Exception.Create('Impossível criar o diretório ' + Dir);
        end;

      vxmlnfe.SaveToFile(Caminho+'.xml');
      result := true;
    end;
    qryxmlnfe.free;
    vxmlnfe.free;

  end;

  if result then
  begin
//    GerarPDF(Caminho+'.xml');

  //  Caminho := FDirEnviado + FormatDateTime('yyyymm',Emissao)  + '\' + NFe;  // VERSAO 1 DO uniDANFE
    Processo := ' Copias=' + NumVias;

    {
    if fSimplificada then
      Processo := Processo + ' t=ds';
      }

    if (Trim(Impressora) <> 'selecionar') {and (Trim(Impressora)<>'')} then
    begin
      if Printer.Printers.IndexOf(Impressora) = -1 then
      begin
         SelecionarImpressora(Impressora,'N');

         if (Trim(Impressora)<>'') then
           Parsistema.NomeImpressoraNotaMercadorias := Impressora;

      end;



      if (Trim(Impressora)<>'') then
        Processo := Processo + ' m=1 i="' + Impressora + '"';

    end
    else
    begin
      if modelodoctofiscal = '65' then
        SelecionarImpressora(Impressora,'NFCe',false)
      else
        SelecionarImpressora(Impressora,'N',false);

      if (Trim(Impressora)<>'') and (Trim(Impressora) <> 'selecionar') then
          Processo := Processo + ' m=1 i="' + Impressora + '"';
    end;

    if Visualizar then
      Processo := Processo + ' Visualizar=1'
    else
      Processo := Processo + ' Visualizar=0';


  {  if (Trim(CepEntrega)         <> '') or
       ((Trim(EmailDestinatario) <> '') and
        EmailValido(EmailDestinatario)) then
    begin
  }
  //    AssignFile(xml, Caminho + '-nfedanfe.xml');  // VERSAO 1 DO uniDANFE
      AssignFile(xml, Caminho + 'danfe.xml');
  //    AssignFile(xml, Caminho + '.xml');
      Rewrite(xml);
      Write(xml, '<?xml version="1.0" encoding="UTF-8"?>');
//      AbreTag('outrasInfDANFe');
      AbreTag('OutrasInf');


      if Logo <> '' then
//        if not fSimplificada then
           TagCompleta('logotipo', Logo);

//      TagCompleta('contrato', '1234567890', false);
//      TagCompleta('vendedor', '1234 - FULANO DE TAL', false);


  //    TagCompleta('geraridentificacaoemitente','1');
  //    TagCompleta('casasdecimaispeso','2');
  //    TagCompleta('imprimirvalidademedicamento','0');
  //    TagCompleta('poweredby','tecLUX / tecSOFT Tecnologia em Sistemas',False);
  //    TagCompleta('poweredsite','www.tecsoft.com.br',False);
  //    TagCompleta('titulocolunalivre','remover');

      if Trim(CepEntrega) <> '' then
        TagCompleta('ceplocalentrega',preencheString(CepEntrega,'0',8, False));
      if (Trim(EmailDestinatario) <> '') and EmailValido(EmailDestinatario, false) then
        TagCompleta('emaildest',      LowerCase(EmailDestinatario),False);


//      if (Produtos <> nil) and (not Produtos.IsEmpty) and (Produtos.FindField('localizacao') <> nil) then
      if (Produtos <> nil) and (Produtos.recordcount<>0) and (Produtos.FindField('localizacao') <> nil) then
      begin
        AbreTag('produtos');
        Produtos.First;
        while not Produtos.Eof do
        begin
          if Produtos.FieldByName('localizacao').AsString <> '' then
          begin
            AbreTag('produto'+Produtos.fieldbyname('numero').AsString);
            TagCompleta('aux_localizacao', Produtos.fieldbyname('localizacao').AsString,False);
            FechaTag('produto'+Produtos.fieldbyname('numero').AsString);
          end;
          Produtos.Next;
        end;
        FechaTag('produtos');
      end;

      if ValorTroco <> 0 then
        TagCompleta('troco', ValorTroco,2);

//      FechaTag('outrasInfDANFe');
      FechaTag('OutrasInf');


      CloseFile(xml);
  //  end;
    {$IFDEF MSWINDOWS }
    //Result := CreateProcessSimple('C:\unimake\uninfe\unidanfe.exe arquivo=' + Processo);
  {  Result := CreateProcessSimple('C:\unimake\uninfe\unidanfe.exe arquivo=' +
                                  '"'+Caminho+'-nfe.xml"' + Processo)}

     if fsimplificada then
     begin
      {
      DANFE1 := TACBrNFeDANFERL.create(nil);
      DANFE1.PathPDF := ExtractFilePath(caminho);
      Danfe1.TipoDANFE := tiSimplificado;
      DANFE1.Logo := fNFeLogotipoDANFE;
      }

      DANFEFR := TACBrNFeDANFEFR.create(nil);

//      DANFEFR.PathPDF := ExtractFilePath(caminho);
      DanfeFR.TipoDANFE := tiSimplificado;
      DanfeFR.ExibeResumoCanhoto := true;
      DanfeFR.ExibeCampoFatura := False;
      DanfeFR.ExibeDadosDocReferenciados := False;
      DanfeFR.ExibeTotalTributosItem := false;
      DanfeFR.ExibeDadosISSQN := false;

      DanfeFR.MargemInferior := 0;
      DanfeFR.MargemSuperior := 0;
      DanfeFR.MargemEsquerda := 0;
      DanfeFR.MargemDireita := 0;

      if fNFeNVias <> 0 then
        DanfeFR.NumCopias := fNFeNVias
      else
        DanfeFR.NumCopias := 1;

      if Trim(Impressora) <> '' then
         DANFEFR.Impressora :=  Trim(Impressora);

      DANFEFR.MostraPreview := Visualizar;

      if ViaOperacoes then
        DANFEFR.MostraSetup := False
      else
        DANFEFR.MostraSetup := true;

//      DANFEFR.Logo := fNFeLogotipoDANFE;
      DanfeFR.FastFile := ExtractFilePath(Application.ExeName) + 'DANFeSimplificado_.fr3';

      ACBrNFe1 := TACBrNFe.create(nil);
      ACBrNFe1.NotasFiscais.Clear;
      ACBrNFe1.NotasFiscais.LoadFromFile(caminho+'.xml');
//      ACBrNFe1.DANFE := DANFE1;

      ACBrNFe1.DANFE := DANFEFR;

      ACBrNFe1.DANFE.ImprimirDANFE;

//    ACBrNFe1.NotasFiscais.Imprimir;

//    ACBrNFe1.NotasFiscais.ImprimirResumido;

//      DANFE1.free;
      DANFEFR.free;
      ACBrNFe1.free;

     end
     else
       Result := CreateProcessSimple(Executavel + ' arquivo=' +
                                    '"'+Caminho+'.xml"' + Processo);

     if result then
     begin
       if (fFormaemissao = '1') or (Procedimento = Enviar) then
         SituacaoImpressaoDanfe := ImpressoNormal
       else
         SituacaoImpressaoDanfe := ImpressoContingencia;
     end;

    {$ENDIF }
  end;
end;

function TTecNotaFiscalEletronica.InutilizarNFe(NFe, Justificativa, Ambiente, UF, CNPJ, modelo, serie, numero: String;
                         var ProtocoloCanc: String): Boolean;
var
  Linha,
  MsgErro,
  ArqEnvio,
  ArqRetorno,
  ArqErro,
  Status,
  Motivo: String;
  ArqResp: TextFile;

begin
  ArqEnvio   := FDirEnvio   + NFe + '-ped-inu.xml';
  ArqRetorno := FDirRetorno + NFe + '-inu.xml';
  ArqErro    := FDirRetorno + NFe + '-inu.err';
  try
    if FileExists(ArqEnvio) then
      DeleteFile(ArqEnvio);
    if FileExists(ArqErro) then
      DeleteFile(ArqErro);
    AssignFile(xml, FDirEnvio+nfe_temp);
    Rewrite(xml);
    Write(xml, '<?xml version="1.0" encoding="UTF-8"?>');

    AbreTag('inutNFe', ['versao','xmlns'],
                       ['4.00',
                        'http://www.portalfiscal.inf.br/nfe']);

    AbreTag('infInut',['Id'],['ID' + Nfe]);
    TagCompleta('tpAmb', Ambiente);
    TagCompleta('xServ', 'INUTILIZAR');
    TagCompleta('cUF', UF);
    TagCompleta('ano', FormatDateTime('YY',date()));
    TagCompleta('CNPJ', preencheString(somentenumero(CNPJ),'0',14,False));
    TagCompleta('mod', preencheString(modelo,'0',2,False));
    TagCompleta('serie', Serie);
    TagCompleta('nNFIni',Numero);
    TagCompleta('nNFFin',Numero);

    TagCompleta('xJust', Justificativa);
    FechaTag('infInut');
    FechaTag('inutNFe');
    CloseFile(xml);
    repeat until RenameFile(FDirEnvio+nfe_temp,ArqEnvio);
  except
    on E: Exception do MensagemAviso_(E.Message + 'InutilizacaoNFe!' +
                                     sLineBreak + ArqEnvio, false, ExibirMsgNFe)
  end;
  repeat
  until FileExists(ArqRetorno) or
        FileExists(ArqErro);

  Result := FileExists(ArqRetorno);
  if not Result then
  begin
    try
      CopiaTemporaria(FDirRetorno,ArqErro);
      AssignFile(ArqResp,FDirRetorno+nfe_temp);
      FileMode := 0;
      Reset(ArqResp);
      MsgErro := '';
      while not Eof(ArqResp) do
      begin
        Readln(ArqResp, Linha);
        MsgErro := MsgErro + Linha + sLineBreak
      end;
      CloseFile(ArqResp);
      DeleteFile(FDirRetorno+nfe_temp);
    except
      on E: Exception do MensagemAviso_(E.Message + 'RetornoInutilizacaoNFe!' +
                                       sLineBreak + ArqErro, false, ExibirMsgNFe)
    end;
    MensagemErro_(MsgErro, ExibirMsgNFe, ArqErro)
  end
  else
  begin
    ProtocoloCanc := ValorRetornoXML(ArqRetorno, 'nProt', Status, Motivo, ExibirMsgNfe);
    Result := ProtocoloCanc <> '';
    if not Result then
    begin
      MsgErro := 'Erro na captura do protocolo de inutilizacao!';
      if (Status <> '') and (Motivo <> '') then
        MsgErro := MsgErro + sLineBreak + 'Status: ' + Status + ' - ' + Motivo;
      MensagemErro_(MsgErro, ExibirMsgNFe, ArqRetorno)
    end
    else
      CompartilharXMLCancelamento(nfe, false,now);
  end;

end;



procedure TTecNotaFiscalEletronica.SetDiretorioEnviado(
  const Value: String);
var
  Barra: Integer;
begin
  FDirEnviado := Value;
  Barra     := Length(FDirEnviado);
  if (Barra > 0) and (Value[Barra] <> '\') then
    FDirEnviado := FDirEnviado + '\';

  //SET DIRETORIO EMPROCESSAMENTO, NECESSARIO PARA RECRIACAO DOS XMLS DE DISTRIBUICAO
  FDiretorioProcessamento:= Trocar(FDirEnviado,'Autorizados','EmProcessamento');
end;

procedure TTecNotaFiscalEletronica.SetDiretorioEnvio(const Value: String);
var
  Barra: Integer;
begin
  FDirEnvio := Value;
  Barra     := Length(FDirEnvio);
  if (Barra > 0) and (Value[Barra] <> '\') then
    FDirEnvio := FDirEnvio + '\'
end;

procedure TTecNotaFiscalEletronica.SetDiretorioRetorno(
  const Value: String);
var
  Barra: Integer;
begin
  FDirRetorno := Value;
  Barra       := Length(FDirRetorno);
  if (Barra > 0) and (Value[Barra] <> '\') then
    FDirRetorno := FDirRetorno + '\'
end;

procedure TTecNotaFiscalEletronica.TagCompleta(Nome, Valor: String; Validar: Boolean = True; Maiusculas: Boolean = True; Opcional: boolean = false);
var
  a: Integer;
begin

  if validar then
    if ((nome='IE') or
        (Nome='IEST')) and (SomenteNumero(Valor)='') then
      valor := '';

  valor := RetiraAcento(valor);
  if Maiusculas then
    valor := UpperCase(valor);
  valor := Trocar(Trocar(Trocar(Trocar(Trocar(Trocar(Valor,
                                                     sLineBreak,' '),
                                                     '<','&lt;'),
                                                     '>','&gt;'),
                                                     '&','&amp;'),
                                                     '"','&quot;'),
                                                     '''','&#39;');
  for a := 1 to Length(Valor) do
    if not (valor[a] in [#$20..#$7F])  // de space ate "vazio" na tabela ASCII
    then valor[a]:= '.';

  if not Validando {or AnularValidando} then
  begin
    if not (opcional and ((valor='') or (valor='0'))) then
      Write(xml, '<' + Nome + '>' + trim(Valor) + '</' + Nome + '>')
  end
  else
   if validar then
     if not (opcional and ((valor='') or (valor='0'))) then
       ValidarTag(Nome, Valor);

end;


procedure TTecNotaFiscalEletronica.TagCompleta(Nome: String;
  Valor: Extended; Decimais: Integer; Opcional: boolean; DecimalPointisComma: Boolean);
var
  ValorS: String;
begin
  if Decimais = 2 then
    ValorS := FormatarValorNFe('0.00',Valor)
  else if Decimais = 3 then
    ValorS := FormatarValorNFe('0.000',Valor)
  else if Decimais = 4 then
    ValorS := FormatarValorNFe('0.0000',Valor)
  else if Decimais = 10 then
    ValorS := FormatarValorNFe('0.0000000000',Valor);

  if DecimalPointisComma then
    ValorS := Trocar(ValorS, '.', ',');

  if not Validando {or AnularValidando} then
    if not (Opcional and (valor=0)) then
      Write(xml, '<' + Nome + '>' + ValorS + '</' + Nome + '>')
end;

procedure TTecNotaFiscalEletronica.TagCompleta(Nome: String;
  Valor: TDatetime; Formato: String);
var
  ValorS: String;
begin
  ValorS := FormatDateTime(Formato,Valor);

  if not Validando {or AnularValidando} then
    Write(xml, '<' + Nome + '>' + ValorS + '</' + Nome + '>')
end;

function ValorRetornoXML(ArqRetorno, Tag: String; ExibirMsgNfe: boolean): String;
var
  Linha,
  Conteudo: String;
  PosI, PosF: Integer;
  Arq: TextFile;
begin
  Result := '';
  try
    CopiaTemporaria(FDirRetorno,ArqRetorno);
    AssignFile(Arq, FDirRetorno+nfe_temp);
    FileMode := 0;
    Reset(Arq);
    repeat
      Readln(Arq, Linha);
      Conteudo := Conteudo + Linha;
    until Eof(Arq);
    CloseFile(Arq);
    DeleteFile(FDirRetorno+nfe_temp)
  except
    on E: Exception do MensagemAviso_(E.Message + ' ErroLeituraRetornoXML!'+
                                     sLineBreak + ArqRetorno, false, ExibirMsgNFe )
  end;
  PosI := Pos('<'+Tag+'>',Conteudo)+Length(Tag)+2;
  PosF := Pos('</'+Tag+'>',Conteudo);
  Result := Copy(Conteudo,PosI,PosF-PosI)
end;

function TTecNotaFiscalEletronica.VerificarStatusServico(Ambiente: String): Boolean;
var
  Linha,
  MsgErro,
  DataTHora,
  ArqEnvio,
  ArqRetorno,
  ArqErro: String;
  ArqResp: TextFile;
  DataHora: TDateTime;
  botao : TmodalResult;
begin  // AAAAMMDDTHHMMSS-ped-sta.xml

  DataHora   := DataHoraLocal;
  DataTHora  := FormatDateTime('yyyymmdd',DataHora) + 'T' + FormatDateTime('hhnnss',DataHora);
  ArqEnvio   := FDirEnvio   + DataTHora   + '-ped-sta.xml';
  ArqRetorno := FDirRetorno + DataTHora   + '-sta.xml';
  ArqErro    := FDirRetorno + DataTHora   + '-sta.err';

  try
    if FileExists(ArqEnvio) then
      DeleteFile(ArqEnvio);
    if FileExists(ArqErro) then
      DeleteFile(ArqErro);
    AssignFile(xml, FDirEnvio+nfe_temp);
    Rewrite(xml);
    Write(xml, '<?xml version="1.0" encoding="UTF-8"?>');
    {
    AbreTag('consStatServ', ['xmlns:xsi','xmlns:xsd','versao','xmlns'],
                            ['http://www.w3.org/2001/XMLSchema-instance',
                             'http://www.w3.org/2001/XMLSchema', '4.00',
                             'http://www.portalfiscal.inf.br/nfe']);
                             }

    AbreTag('consStatServ', ['versao','xmlns'],
                            ['4.00', 'http://www.portalfiscal.inf.br/nfe']);
    TagCompleta('tpAmb',Ambiente);
    TagCompleta('cUF','42'); // CODIGO DO ESTADO "SC" NO CADASTRO DO IBGE
    TagCompleta('xServ','STATUS');
    FechaTag('consStatServ');
    CloseFile(xml);
    repeat until RenameFile(FDirEnvio+nfe_temp,ArqEnvio);

  except
    on E: Exception do MensagemAviso_(E.Message + 'VerificarStatusServiçoNFe!' +
                                     sLineBreak + ArqEnvio, false, ExibirMsgNFe)
  end;


  while true do
  begin
    IniciarTempo(vTempoInicial);

    repeat
    until FileExists(ArqRetorno) or
          FileExists(ArqErro) or
          TempoEsgotado(vTempoInicial);


    if FileExists(ArqRetorno) or FileExists(ArqErro) then
    begin
      Result := FileExists(ArqRetorno);

      if not Result then
      begin
        try
          CopiaTemporaria(FDirRetorno,ArqErro);
          AssignFile(ArqResp,FDirRetorno+nfe_temp);
//          FileMode := 0;
          Reset(ArqResp);
          MsgErro := '';
          while not Eof(ArqResp) do
          begin
            Readln(ArqResp, Linha);
            MsgErro := MsgErro + Linha + sLineBreak
          end;
          CloseFile(ArqResp);
          DeleteFile(FDirRetorno+nfe_temp);
          break;
        except
          on E: Exception do MensagemAviso_(E.Message + 'InterpretarRespostaStatus!' +
                                           sLineBreak + ArqErro, false, ExibirMsgNFe)
        end;
        MensagemErro_(MsgErro, ExibirMsgNFe, ArqErro)
      end
      else
        break;
    end
    else
    if TempoEsgotado(vTempoInicial) then
    begin
      result := false;

      botao := MensagemSimNaoOpcaoCancelarmmo('Arquivo de retorno '+ ArqRetorno +' não retornado.'
                                     , 'Reiniciar o UNINFE', false, 'Aguardar', 'Cancelar',
                                     'Excedeu-se o limite de espera de '+inttostr(parsistema.TempoEsperaNFCe)+' segundos. '+ sLineBreak +
                                     'Verifique se o UNINFE esta ativo. '+ sLineBreak +
                                     'Deseja continuar aguardando o retorno do arquivo?'
                                     );
      if botao = mrNO then
        break
      else
      if botao = mrOK then
        ReiniciarUNINFE;


    end;

  end;
end;

function TTecNotaFiscalEletronica.GetDiretorioCompartilha: String;
begin
  Result := FDirCompartilha
end;

procedure TTecNotaFiscalEletronica.SetDiretorioCompartilha(
  const Value: String);
var
  Barra: Integer;
begin
  FDirCompartilha := Value;
  Barra           := Length(FDirCompartilha);
  if (Barra > 0) and (Value[Barra] <> '\') then
    FDirCompartilha := FDirCompartilha + '\'
end;


{
function TTecNotaFiscalEletronica.EnviarEmail(Msg: TStringList; Assunto, origem,
  Destino, Empresa, PortaSMTP, HostSMTP, UsuarioEmail, SenhaEmail,
  Filial, Serie, Numero: String; AutenticarSMTP: Boolean; Emissao: TDateTime): Boolean;
var
  anexo, vAnexoGerado : String;
  vListaAnexos : tStringList;

begin
  Result := False;
  if (ftipoemissaonfeservico in [Florianopolis_SoftPlan, Palhoca_IPM]) then
    vAnexoGerado := trocar(nfe.NomedoArquivoCompartilhado, '.xml', '')
  else
  begin
    Anexo  := FDirCompartilha + FormatDateTime('yyyy',Emissao) + '\' +
                                FormatDateTime('mm'  ,Emissao) + '\' +
                                FormatDateTime('dd'  ,Emissao) + '\' +
                                'nfeProc' + preencheString(Filial,'0',2,False) +
                                            preencheString(Serie ,'0',2,False) +
                                            preencheString(Numero,'0',9,False)+'.xml';
    vAnexoGerado := GerarPDF(anexo);

  end;

  vListaAnexos := TStringList.create;

  if FileExists(vAnexoGerado+'.xml') then
    vListaAnexos.Append(vAnexoGerado+'.xml');

  if FileExists(vAnexoGerado+'.pdf') then
    vListaAnexos.Append(vAnexoGerado+'.pdf');


  result := EnviarEmail_(HostSMTP, UsuarioEmail, SenhaEmail, PortaSMTP,
               origem, Destino, Assunto,
               ConcatenarHTML('</body>', msg.Text, Parsistema.Textos_finais_nas_NFs_cartas_e_boletos_anexados_via_email.Text),
               Empresa,
               usuariologin.smtprequerssl, vListaAnexos);

end;
}

function TTecNotaFiscalEletronica.EnviarEmail(origem, Destino,
  NrNota, Serie, Filial, Contrato, NomeFilial, RazaoFilial, CNPJFilial, DDDFilial,
  FoneFilial, DDDFaxFilial, FaxFilial, NomeUsuario, PortaSMTP, HostSMTP,
  Usuario, Senha: String; DataEmissao: TDateTime; ValorTotal: Currency;
  AutenticarSmtp: Boolean; Emissao: TDateTime;
  vListaBoletos: TStringList = nil;
  SomenteBoleto: Boolean = false;
  DadosdoContrato: boolean = false;
  SomenteNFPSe: Boolean = false;
  SomenteXML: Boolean = false): Boolean;

  function MontarEmail: TStringList;
  var
  html : TStringList;
  begin
    Html:= TStringList.Create;
    with html do
    begin
      Append('<HTML>');
      Append('<HEAD>');
      Append('<meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1" />');
      Append('<TITLE> NFe ' + FormatarNroNFe(NrNota) + ' - ' + NomeFilial + '</TITLE>');
      Append('<META NAME="Author" CONTENT="tecSOFT-tecLUX">');
      Append('</HEAD>');
      Append('<BODY>');
      Append('<b>Seguem dados da NFe anexa:</b>');
      Append('<br>');
      Append('<table border="1" width="736" height="212">');
      if DadosdoContrato then
      begin
        if NrNota<>'' then
        begin

          Append('<tr>');
          Append('<td width="175" height="26"><b>Número da NF</b></td>');
          Append('<td width="561" height="26">' +FormatarNroNFe(NrNota) + '</td>');
          Append('</tr>');

          Append('<tr>');
          Append('<td width="175" height="26"><b>Série</b></td>');
          Append('<td width="561" height="26">' + preencheString(Serie,'0',3,False) + '</td>');
          Append('</tr>');


        end;

        Append('<tr>');
        Append('<td width="175" height="26"><b>Número do Contrato</b></td>');
        Append('<td width="561" height="26">' +Contrato + '</td>');
        Append('</tr>');




      end
      else
      begin
        Append('<tr>');
        Append('<td width="175" height="26"><b>Número da NF</b></td>');
        Append('<td width="561" height="26">' +FormatarNroNFe(NrNota) + '</td>');
        Append('</tr>');

        Append('<tr>');
        Append('<td width="175" height="26"><b>Série</b></td>');
        Append('<td width="561" height="26">' + preencheString(Serie,'0',3,False) + '</td>');
        Append('</tr>');
      end;

      Append('<tr>');
      Append('<td width="175" height="26"><b>Razão Social</b></td>');
      Append('<td width="561" height="26">' + RazaoFilial + '</td>');
      Append('</tr>');
      Append('<tr>');
      Append('<td width="175" height="26"><b>CNPJ/CPF</b></td>');
      Append('<td width="561" height="26">' + CNPJFilial + '</td>');
      Append('</tr>');
      Append('<tr>');
      Append('<td width="175" height="26"><b>Telefone</b></td>');
      Append('<td width="561" height="26">' + FormatarFone(DDDFilial,FoneFilial) + '</td>');
      Append('</tr>');
      Append('<tr>');
      Append('<td width="175" height="26"><b>Data da Emissão</b></td>');
      Append('<td width="561" height="26">' + FormatDateTime('dd/mm/yyyy',DataEmissao) + '</td>');
      Append('</tr>');

      Append('<tr>');
      Append('<td width="175" height="26"><b>Emitente</b></td>');
      Append('<td width="561" height="26">' + RazaoFilial + '</td>');
      Append('</tr>');

      Append('<tr>');
      Append('<td width="175" height="26"><b>Valor Total</b></td>');
      Append('<td width="561" height="26">R$ ' + FormatarValor(ValorTotal,2) + '</td>');
      Append('</tr>');

      Append('</table>');
      Append('<br>');
      {Append('<b>Att.</b>');
      Append('<br>');
      Append('<br>');
      retirado para gama
      Append(NomeUsuario+'<br>');}
      Append(NomeFilial+'<br>');
      Append(FormatarFone(DDDFilial, FoneFilial)+'<br>');
      Append(FormatarFone(DDDFaxFilial, FaxFilial)+'<br>');
      {Append(LowerCase(origem)+'<br>');}
      Append('<br>');
      Append(Parsistema.Textos_finais_nas_NFs_cartas_e_boletos_anexados_via_email.Text);
      Append('</BODY>');
      Append('</HTML>')
    end;
    Result := html
  end;

var
  anexo, vAnexoGerado, vAssunto : String;
  vListaAnexos : tStringList;
begin
  Result := False;

  vListaAnexos := TStringList.create;

  try

    if not SomenteBoleto then
    begin

      if {(ftipoemissaonfeservico in [Florianopolis_SoftPlan, Palhoca_IPM])} SomenteNFPSe then
        anexo := nfe.NomedoArquivoCompartilhado
      else
        Anexo  := FDirCompartilha + FormatDateTime('yyyy',DataEmissao) + '\' +
                                  FormatDateTime('mm'  ,DataEmissao) + '\' +
                                  FormatDateTime('dd'  ,DataEmissao) + '\' +
                                  'nfeProc' + preencheString(Filial,'0',2,False) +
                                              preencheString(Serie ,'0',2,False) +
                                              preencheString(NrNota,'0',9,False)+'.xml' ;
      if not fileExists(Anexo) then
        result := false
      else
        result := true;

      if not result then
        MensagemAviso_(format('Nfe ''%s'' não econtrada',[Anexo]), false, ExibirMsgNFe);

      if result then
      begin
        if {(ftipoemissaonfeservico in [Florianopolis_SoftPlan, Palhoca_IPM])} SomenteNFPSe then
        begin
          vAnexoGerado := trocar(nfe.NomedoArquivoCompartilhado, '.xml', '');

          vAssunto := 'Envio da NFPSe(xml) - Emitente: ' + NomeFilial +
                      ' - N.Doc: ' + FormatarNroNFe(NrNota) +
                      ' - Série: ' + preencheString(Serie,'0',3,False);
        end
        else
        begin
          vAnexoGerado := GerarPDF(anexo);
          vAssunto := 'Envio da NFe(xml) - Emitente: ' + NomeFilial +
                      ' - N.Doc: ' + FormatarNroNFe(NrNota) +
                      ' - Série: ' + preencheString(Serie,'0',3,False);


        end;


        if FileExists(vAnexoGerado+'.xml') then
          vListaAnexos.Append(vAnexoGerado+'.xml');

        if not SomenteXML then
          if FileExists(vAnexoGerado+'.pdf') then
            vListaAnexos.Append(vAnexoGerado+'.pdf');
      end;

    end
    else
    begin
      if DadosdoContrato then
      begin
          if NrNota <> '' then

            vAssunto := 'Envio do Boleto do Contrato  - Emitente: ' + NomeFilial +
                        ' NF/Série'+FormatarNroNFe(NrNota)+'/'+preencheString(Serie,'0',3,False)+' - Contrato: ' + Contrato
          else

            vAssunto := 'Envio do Boleto do Contrato  - Emitente: ' + NomeFilial +
                        ' - Contrato: ' + Contrato;

      end
      else
      begin
        if {(ftipoemissaonfeservico in [Florianopolis_SoftPlan, Palhoca_IPM])} SomenteNFPSe then
          vAssunto := 'Envio do Boleto NFPSe(xml) - Emitente: ' + NomeFilial +
                      ' - N.Doc: ' + FormatarNroNFe(NrNota) +
                      ' - Série: ' + preencheString(Serie,'0',3,False)
        else
          vAssunto := 'Envio do Boleto NFe(xml) - Emitente: ' + NomeFilial +
                      ' - N.Doc: ' + FormatarNroNFe(NrNota) +
                      ' - Série: ' + preencheString(Serie,'0',3,False);
      end;
    end;

    if vListaBoletos <> nil then
      vListaAnexos.AddStrings(TSTrings(vListaBoletos));

//    vListaAnexos.Clear;
      
    result := EnviarEmail_(HostSMTP, Usuario, senha, PortaSMTP,
                 origem, Destino, vAssunto,

                 MontarEmail.Text,

                 fNomeFilialBase,
                 usuariologin.smtprequerssl, vListaAnexos);

  finally
    vListaAnexos.free;
  end;

end;

function ValorRetornoXML(ArqRetorno, Tag: String;
  var Status, Motivo: String; ExibirMsgNfe: boolean): String;
var
  Linha,
  Conteudo: String;
  PosI, PosF: Integer;
  Arq: TextFile;
begin
  Result := '';
  try
    CopiaTemporaria(FDirRetorno,ArqRetorno);


    AssignFile(Arq, FDirRetorno+nfe_temp);
    FileMode := 0;

    Reset(Arq);
    repeat
      Readln(Arq, Linha);
      Conteudo := Conteudo + Linha;
    until Eof(Arq);


    CloseFile(Arq);
    DeleteFile(FDirRetorno+nfe_temp)
  except
    on E: Exception do MensagemAviso_(E.Message + ' ErroLeituraRetornoXML!'+
                                     sLineBreak + ArqRetorno, false, ExibirMsgNFe)
  end;

  PosI   := Pos('<cStat>' ,Conteudo)+7;
  PosF   := Pos('</cStat>',Conteudo);
  Status := Copy(Conteudo,PosI,PosF-PosI);

  PosI   := Pos('<xMotivo>' ,Conteudo)+10;
  PosF   := Pos('</xMotivo>',Conteudo);
  Motivo := Copy(Conteudo,PosI,PosF-PosI);

  PosI := Pos('<'+Tag+'>' ,Conteudo)+Length(Tag)+2;
  PosF := Pos('</'+Tag+'>',Conteudo);
  Result := Copy(Conteudo,PosI,PosF-PosI)

end;

procedure CopiaTemporaria(Diretorio, Arquivo: String);
begin
  if FileExists(Diretorio+nfe_temp) then
    DeleteFile(Diretorio+nfe_temp);
  CopyFileTo(Arquivo,Diretorio+nfe_temp)
end;

function TTecNotaFiscalEletronica.GetExecutavel: String;
begin
  Result := fExecutavel
end;

class procedure TTecNotaFiscalEletronica.SetExecutavel(const Value: String);
begin
  fExecutavel := Value;
  fProcesso := copy(fExecutavel, LastDelimiter('\',fExecutavel)+1,Length(fExecutavel));
  fDiretorioExec := copy(fExecutavel,1, LastDelimiter('\',fExecutavel));
  if not ProcessoExiste(fProcesso) then
  begin
    ExecutarProcesso(fExecutavel,'', fDiretorioExec, 0);
    Sleep(delay);
  end;
end;

function TTecNotaFiscalEletronica.CompartilharXMLCancelamento(Nfe: String; Cancelamento: boolean;Data_Cancelamento: TDateTime): Boolean;
var
  Dir,
  CaminhoNFe, vArquivo, vArquivoInutJaEnviado: String;

begin
{
  ArqEnvio   := FDirEnvio   + NFe + '-env-canc.xml';
  ArqRetorno := FDirRetorno + NFe + '-ret-env-canc.xml';
  ArqErro    := FDirRetorno + NFe + '-ret-env-canc.err';
  }



  Result := True;
  {
  if Cancelamento then
    vArquivo := '\' + NFe + '-procCancNFe.xml'
  else
    vArquivo := '\' + NFe + '-procInutNFe.xml';
  }

  if Cancelamento then
    vArquivo := '\' + NFe + '_110111_01-procEventoNFe.xml'
  else
  begin
    vArquivo := '\' + NFe + '-procInutNFe.xml';
    vArquivoInutJaEnviado := FDirRetorno + NFe + '-inu.xml'; {Qdó a inutiliação foi feita em outra base, TecSoft -> Lirio Mimoso em 24/05/2017 dá erro pois não volta o atrquivo -procInutNFe.xml}
  end;

  if not DirectoryExists(FDirCompartilha) then
    if not CreateDir(FDirCompartilha) then
    begin
      result := false;
      raise Exception.Create('Impossível criar o diretório ' + FDirCompartilha);
    end;

  Dir := FDirCompartilha+FormatDateTime('yyyy',Data_Cancelamento);
  if not DirectoryExists(Dir) then
    if not CreateDir(Dir) then
    begin
      result := false;
      raise Exception.Create('Impossível criar o diretório ' + Dir);
    end;

  Dir := Dir + '\' + FormatDateTime('mm',Data_Cancelamento);
  if not DirectoryExists(Dir) then
    if not CreateDir(Dir) then
    begin
      result := false;
      raise Exception.Create('Impossível criar o diretório ' + Dir);
    end;

  Dir := Dir + '\' + FormatDateTime('dd',Data_Cancelamento);
  if not DirectoryExists(Dir) then
    if not CreateDir(Dir) then
    begin
      result := false;
      raise Exception.Create('Impossível criar o diretório ' + Dir);
    end;

  try
    CaminhoNFe := FDirEnviado + FormatDateTime('yyyymm', Data_Cancelamento) + vArquivo ;
    if FileExists(CaminhoNFe) then
    begin
      if FileExists(dir + vArquivo) then
        DeleteFile(dir + vArquivo);

      Sleep(delay);
      if FileExists(CaminhoNFe) then
        CopyFileTo(CaminhoNFe,dir + vArquivo)
    end
    else
    begin
      if not Cancelamento then
      begin
        vArquivo := vArquivoInutJaEnviado;

        CaminhoNFe := FDirEnviado + FormatDateTime('yyyymm', Data_Cancelamento) + vArquivo;
        if FileExists(dir + vArquivo) then
          DeleteFile(dir + vArquivo);

        Sleep(delay);
        if FileExists(CaminhoNFe) then
          CopyFileTo(CaminhoNFe,dir + vArquivo)
      end;
    end;


  except
    on E: Exception do
    begin
      result := false;
      MensagemAviso_(E.Message + 'Erro compartilhando cancelamento da NFe.' + sLineBreak + CaminhoNFe, false, ExibirMsgNFe);
    end;
  end;

  if result then
    NomedoArquivoCompartilhado := dir + vArquivo
  else
    NomedoArquivoCompartilhado := '';


end;

procedure TTecNotaFiscalEletronica.ValidarTag(Nome, Valor: String);
begin
  if Validando then
  begin
    if (nome = 'numprotocolonfe') then
    begin
      if valor = '' then
      begin
        qryListaErros.append;
        qryListaErros.fieldbyname('localizacao').asstring := local;
        qryListaErros.fieldbyname('camponfe').asstring := 'NumeroNFe';
        qryListaErros.fieldbyname('descricaocamponfe').asstring := 'Número do Protocolo da NFe';
        qryListaErros.fieldbyname('valorCamponfe').asstring := Valor;
        qrylistaerros.fieldbyname('descricaoerro').asstring := 'O nr do protocolo não pode ser nulo para NFe. Transmita ou cancele a NFe ';
        qrylistaErros.post;
      end;
    end
    else
    if (nome = 'fone') then
    begin
      if not ((length(Valor) >= 6) and (length(Valor) <= 14)) then
      begin
        qryListaErros.append;
        qryListaErros.fieldbyname('localizacao').asstring := local;
        qryListaErros.fieldbyname('camponfe').asstring := Nome;
        qryListaErros.fieldbyname('descricaocamponfe').asstring := 'Telefone (DDD + Fone)';
        qryListaErros.fieldbyname('valorCamponfe').asstring := Valor;
        qrylistaerros.fieldbyname('descricaoerro').asstring := 'Tamanho deve estar entre 6 e 14 caracteres';
        qrylistaErros.post;
      end;
    end
    else
    if (Nome = 'xLgr') or (Nome = 'logradouroTomador') then
    begin
      if  (trim(Valor)='') then
      begin
        qryListaErros.append;
        qryListaErros.fieldbyname('localizacao').asstring := local;
        qryListaErros.fieldbyname('camponfe').asstring := Nome;
        qryListaErros.fieldbyname('descricaocamponfe').asstring := 'Nome da rua';
        qryListaErros.fieldbyname('valorCamponfe').asstring := Valor;
        qrylistaerros.fieldbyname('descricaoerro').asstring := 'preenchimento obrigatório';
        qrylistaErros.post;
      end
      else
      if (length(trim(valor))>60) or (length(trim(valor))<2) then
      begin
        qryListaErros.append;
        qryListaErros.fieldbyname('localizacao').asstring := local;
        qryListaErros.fieldbyname('camponfe').asstring := Nome;
