begin
  FExeDANFE := Valor;
end;

class function TTecNotaFiscalEletronica.ExecutavelUniDANFE: String;
begin
  Result := FExeDANFE;
end;
}
procedure TTecNotaFiscalEletronica.FechaTag(Nome: String);
begin
  if not Validando {or AnularValidando} then
    Write(xml, '</' + Nome + '>')
end;

function FormatarValorNFe(Formato: String;
  Valor: Extended): String;
begin
  Result := trocar(FormatFloat(Formato, Valor),',','.')
end;

function TTecNotaFiscalEletronica.VendaInterEstadual: boolean;
begin
  result := not (FDest_UF=FEmit_UF) and HeUnidadeFederacao(FDest_UF);
end;

