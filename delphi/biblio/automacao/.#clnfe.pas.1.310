  function ReferenciadaCupomFiscal: boolean;
  begin
    result := false;
    Referenciadas.first;
    while not Referenciadas.eof do
    begin
      if (Referenciadas.findfield('numerocupom')<>nil) and
         (Referenciadas.findfield('numerocupom').asinteger<>0) then
        result := true
      else
      begin
        result := false;
        break;
      end;
      Referenciadas.next;
    end;
  end;

  function eHDevolucaoCompraForaEstadoVinculadaaCupom: Boolean;
  begin
    result := false;
    if (tipo = 'E') then
      if VendaInterEstadual then
        if Referenciadas<>nil then
          if ReferenciadaCupomFiscal then
            if ehnotafiscalentradadevolucao(Notas.fieldbyname('codigofiscal').asinteger, TtecDatabase(notas.database)) then
              result := true;
  end;



  function DadosVendedor: String;
  begin
    result := '';
    if notas.findfield('vendedor') <> nil then
      if notas.fieldbyname('vendedor').asInteger <> 0 then
        result := notas.fieldbyname('vendedor').asString + ' - ' +
                  ValorCampodaTabela_('usuarios', ['codigo'],
                        [notas.fieldbyname('vendedor').asString],
                        ['nome'])[0];

    if notas.findfield('contrato') <> nil then
      if notas.fieldbyname('contrato').asString <> '' then
         result := trim(result + ' CT ' + notas.fieldbyname('contrato').asString);

  end;

  function ComplementoProduto(produto: String): String;
  begin
    result := '';
    if not assigned(qryCaracteristicas) then
    begin
      qryCaracteristicas := TTecQuery.Create(nil);
      qryCaracteristicas.Database := Notas.DataBase;
    end;

    qryCaracteristicas.Sql.Text := 'select case when c.emitecomplemento then c.complemento else cast(null as varchar(1000)) end as complemento, c.anvisa '+
                                   ' from caracteristicas c where c.codigo = (select p.caracteristica from produtos p where p.codigo = :produto)';

    qryCaracteristicas.parambyname('produto').assTring := '0';
    if produto <> '' then
      qryCaracteristicas.parambyname('produto').assTring := produto;

    qryCaracteristicas.open;


    if (Tipo = 'S') and
       (produtos.FindField('pn')<>nil) and
       (Produtos.FieldByName('pn').AsString <> '') and
       parsistema.controlesvoltadosparaindustria then
      result := 'Item ' + Copy(Produtos.FieldByName('pn').AsString,1,60)
    else
    if (Produtos.FindField('codigovisual')<>nil) and
       (Produtos.FieldByName('codigovisual').asstring<>'')  then
      result := 'Item ' +  Copy(Produtos.FieldByName('codigovisual').AsString,1,60)
    else
    if (Produtos.FindField('produtovisual')<>nil) and
       (Produtos.FieldByName('produtovisual').asstring<>'') then
      result := 'Item ' + Copy(Produtos.FieldByName('produtovisual').AsString,1,60)
    else
      result := 'Item ' + Copy(Produtos.FieldByName('produto').AsString,1,60);


    if qryCaracteristicas.fieldbyName('complemento').asString<> '' then
//    begin
      result := trim(trim(result)+ ' '+qryCaracteristicas.fieldbyName('complemento').asString);
      {
      if qryCaracteristicas.fieldbyName('anvisa').asString<>'' then
        result := result + ' MS - ' + qryCaracteristicas.fieldbyName('anvisa').asString;
        }
//    end;
    {
    else
      if qryCaracteristicas.fieldbyName('anvisa').asString<>'' then
        result := result + ' MS - ' + qryCaracteristicas.fieldbyName('anvisa').asString
      else
        result := '';
        }
  end;


  function Unidade(composto : boolean = false): String;
  begin
    if composto then
    begin
      if (compostos.findfield('unidadenf')<>nil) and (compostos.fieldbyname('unidadenf').asString<>'') then
        result := Copy(compostos.fieldbyname('unidadenf').asString,1,6)
      else
        result := Copy(compostos.fieldbyname('unidade').asString,1,6);
    end
    else
    begin
      if (Produtos.findfield('unidadenf')<>nil) and (Produtos.fieldbyname('unidadenf').asString<>'') then
        result := Copy(Produtos.fieldbyname('unidadenf').asString,1,6)
      else
        result := Copy(Produtos.fieldbyname('unidade').asString,1,6);
    end;
  end;

  function ehDevolucaoImportacao(tabela: TTecQuery): boolean;
  begin
    result := false;
    if (Notas.FieldByName('finalidadenf').AsString = '4') and
       ((tabela.fieldbyname('codigofiscal').asinteger div 1000) = 7) then
      result := true;
  end;


  function VendaConsumidorFinal: boolean;
  begin

    result := (Notas.FindField('vendaconsumidorfinal')<>nil) and
               Notas.FieldByName('vendaconsumidorfinal').AsBoolean;

    if result  then
    begin
      if (Notas.findfield('responsaveldifal')<>nil) then
        result := not (VendaInterEstadual  and
                       Notas.FieldByName('clientecontribicms').asboolean and
                       Notas.fieldbyname('responsaveldifal').asBoolean);
    end;

  end;

  Function f_IndFinal: Boolean; {Indicador de consumidor final}
  begin
    result := not Notas.FieldByName('clientecontribicms').asboolean or
                 (Notas.FieldByName('ambiente').AsString = '2') or
                  VendaConsumidorFinal or
                 (Notas.FieldByName('codigofiscal').AsString='5929')
  end;


  Function eHImportacao: boolean;
  begin
    result := false;
    if notas.FindField('ndi')<>nil then
      result := not notas.fieldbyname('ndi').IsNull;
  end;

  Function TipoNota: TTectipoemissaonfeservico;
  var Ok: boolean;
  begin
    vProvedor := '';
    result := Eletronica_Conujugada;

    if ftipoemissaonfeservico = Eletronica_Conujugada then
      result := Eletronica_Conujugada
    else
    if (servicos <> nil) and (servicos.recordcount <> 0) and (tipo='S') then
    begin
      result := Inexistente;
      if ftipoemissaonfeservico = Palhoca_IPM then
        result := Palhoca_IPM
      else
      if ftipoemissaonfeservico = Florianopolis_SoftPlan then
        result := Florianopolis_SoftPlan
      else
      if ftipoemissaonfeservico = Eletronica_Betha_Sistemas then
        result := Eletronica_Betha_Sistemas
      else
      begin
{        vProvedor := CodCidadeToProvedor(StrToIntDef(Emit_CodMun , 0));  esta função estava na unti pnfsConversao do acbr antigo porme hoje ninguem usa esta funcionalidade de emissao de nfe eletronica de servico}
        if vProvedor <> '' then
        begin
          result := Outras;
          if not Assigned(ACBrNFSe) then
          begin
            ACBrNFSe := TACBrNFSe.create(ACBrNFSe);
            (*
            {$IFDEF ACBrNFSeOpenSSL}
              ACBrNFSe1.Configuracoes.Certificados.Certificado := edtCaminho.Text;
              ACBrNFSe1.Configuracoes.Certificados.Senha       := edtSenha.Text;
            {$ELSE}
              ACBrNFSe1.Configuracoes.Certificados.NumeroSerie := edtNumSerie.Text;
            {$ENDIF}
            *)

            ACBrNFSe.Configuracoes.Arquivos.AdicionarLiteral:=True;
            ACBrNFSe.Configuracoes.Arquivos.EmissaoPathNFSe:=True;
//            ACBrNFSe.Configuracoes.Arquivos.PastaMensal:=False;  //True;
            ACBrNFSe.Configuracoes.Arquivos.PathCan:='C:\Unimake\UniNFSe\log';
            ACBrNFSe.Configuracoes.Arquivos.PathNFSe:='C:\Unimake\UniNFSe\log';
            ACBrNFSe.Configuracoes.Arquivos.Salvar:=True;
//            ACBrNFSe.Configuracoes.Certificados.AssinaRPS := false;

            //PathMensal:=ACBrNFSe1.Configuracoes.Arquivos.GetPathNFSe(0);

//            ACBrNFSe.Configuracoes.Geral.PathSchemas := 'C:\Unimake\UniNFSe\schemas\NFSe\BETHA';
            ACBrNFSe.Configuracoes.Geral.Salvar      := true;
//            ACBrNFSe.Configuracoes.Geral.PathSalvar  := FDirEnvioNFSe;

//            ACBrNFSe.Configuracoes.WebServices.CodigoMunicipio := StrToIntDef(FEmit_CodMun, 0);
            ACBrNFSe.Configuracoes.WebServices.Ambiente        := StrToTpAmb(Ok, Notas.FieldByName('ambientenfs').AsString);
            ACBrNFSe.Configuracoes.WebServices.Visualizar      := false;

            {
            ACBrNFSe.Configuracoes.WebServices.SenhaWeb        := edtSenhaWeb.Text;
            ACBrNFSe.Configuracoes.WebServices.UserWeb         := edtUserWeb.Text;
            ACBrNFSe1.Configuracoes.WebServices.ProxyHost := edtProxyHost.Text;
            ACBrNFSe1.Configuracoes.WebServices.ProxyPort := edtProxyPorta.Text;
            ACBrNFSe1.Configuracoes.WebServices.ProxyUser := edtProxyUser.Text;
            ACBrNFSe1.Configuracoes.WebServices.ProxyPass := edtProxySenha.Text;
            }

//            ACBrNFSe.Configuracoes.WebServices.SetConfigMunicipio(ACBrNFSe.Configuracoes.Geral.PathSchemas);

            {
           if ACBrNFSe1.DANFSe <> nil then
            begin
             ACBrNFSe1.DANFSe.Logo       := edtLogoMarca.Text;
             ACBrNFSe1.DANFSe.PrestLogo  := edtPrestLogo.Text;
             ACBrNFSe1.DANFSe.Prefeitura := edtPrefeitura.Text;
            end;
            }

          end;
        end;
      end;
      if result = Inexistente then
        MensagemErro_('Tipo de nota fiscal eletrônica de serviço não especificada.', ExibirMsgNFe)
    end;


  end;

  function Data: TDateTime;
  begin
    if Tipo = 'S' then
      data := Notas.FieldByName('data').AsDateTime
    else
      data := Notas.FieldByName('emissao').AsDateTime;
  end;

  function ChaveNFe: String;
  begin
    if regerando then
      result := Notas.FieldByName('chv_nfe').AsString
    else
    begin
      if  Notas.FindField('NrDocumento')<>nil then
        Result := Copy(FEmit_CodMun,1,2) +
                  FormatDateTime('yymm', data) +
                  preencheString(Trocar(Trocar(Trocar(FEmit_Documento,'.',''),'/',''),'-',''),'0',14,False) +
                  preencheString(Notas.FieldByName('ModeloDocto').AsString,'0',2,False) +
                  preencheString(SerieSugestao,'0',3,False) +
                  preencheString(Notas.FieldByName('NrDocumento').AsString,'0',9,False) +
                  Notas.FieldByName('formaemissao').AsString +
                  preencheString(Notas.FieldByName('CodAleatorio').AsString,'0',8,False) +
                  Notas.FieldByName('DigChaveAcesso').AsString
      else
        result := Copy(FEmit_CodMun,1,2) +
                  FormatDateTime('yymm', data) +
                  preencheString(Trocar(Trocar(Trocar(FEmit_Documento,'.',''),'/',''),'-',''),'0',14,False) +
                  preencheString(Notas.FieldByName('ModeloDocto').AsString,'0',2,False) +
                  preencheString(SerieSugestao,'0',3,False) +
                  preencheString(Notas.FieldByName('numero').AsString,'0',9,False) +
                  Notas.FieldByName('formaemissao').AsString +
                  preencheString(Notas.FieldByName('CodAleatorio').AsString,'0',8,False) +
                  Notas.FieldByName('DigChaveAcesso').AsString;
    end;
    fChaveNFe := result;
  end;


  function DirEnvio: String;
  begin
    if (fFormaEmissao = '1') or (Procedimento = Enviar) then
      result := FDirEnvio
    else
    if fFormaEmissao = '9' then
//      result := trocar(FDirEnvio,'Envio','Validar');
      result := StringReplace(FDirEnvio, '\Envio','\Validar', [rfReplaceAll, rfIgnoreCase]);

  end;

  function ArqEnvio: String;
  begin
    if regerando then
      ArqEnvio    := FDiretorioProcessamento + ChaveNFe + '-nfe.xml'
    else
      ArqEnvio := DirEnvio  + ChaveNFe + '-nfe.xml'
  end;

  function ArqErro: String;
  begin
    ArqErro  := FDirRetorno + ChaveNFe + '-nfe.err';
  end;

  procedure InfomrmacoesNFSEFlorianopolis;
  begin


        Local := 'Nota Fiscal Serviço - Florianópolis';
        AbreTag('xmlProcessamentoNfpse');
          TagCompleta('bairroTomador', copy(FDest_Bairro,1,60));
          TagCompleta('baseCalculo', notas.fieldbyname('issqnbasecalculo').AsCurrency, 2);
          TagCompleta('baseCalculoSubstituicao', 0.00, 2, false);
          TagCompleta('cfps',  Notas.FieldByName('cfps').AsString);

          if HeUnidadeFederacao(FDest_UF) then
            TagCompleta('codigoMunicipioTomador', FDest_CodMun, true, true, true);

          TagCompleta('codigoPostalTomador',  preencheString(FDest_CEP,'0',8, False));
          TagCompleta('complementoEnderecoTomador', FDest_Compl, true, true, true);

          TagCompleta('dadosAdicionais', trim(Copy(Notas.FieldByName('infcomplementar').AsString,1,600)), true, true, true);
          TagCompleta('dataEmissao', Notas.FieldByName('data').AsDateTime, 'yyyy-mm-dd');


//          TagCompleta('emailTomador',  uppercase(contatos.fieldbyname('email').AsString), true, false);
          TagCompleta('emailTomador',  notas.fieldbyname('email').AsString, true, false);



//          TagCompleta('emailTomador', 'souza123@gmsail.com');

         { Com este número talvez será possível recuperar a NFSe caso necessário}
         TagCompleta('identificacao', notas.fieldbyname('numero').asString, false, false, false);

// identificacao (string, optional): Identificação da requisição. stringMin. Length:1Max. Length:10,

{          identificacao  ??? }


//          TagCompleta('identificacao',  '001', False);

          if (FDest_TipoPessoa = 'F') then
          begin
            if HeUnidadeFederacao(FDest_UF) then
              TagCompleta('identificacaoTomador',  preencheString(SomenteNumero(FDest_Documento),'0',11,False))
            else
              TagCompleta('identificacaoTomador', '', false);  //coneudo vazio
          end
          else
          begin
            if HeUnidadeFederacao(FDest_UF) then
              TagCompleta('identificacaoTomador', preencheString(SomenteNumero(FDest_Documento),'0',14,False))
            else
              TagCompleta('identificacaoTomador', '', false);  //coneudo vazio
          end;

          TagCompleta('inscricaoMunicipalTomador', notas.fieldbyname('inscricaomunicipal').asstring, true, true, true);

          AbreTag('itensServico');
            Servicos.First;
            while not servicos.Eof do
            begin
              AbreTag('itemServico');
                TagCompleta('aliquota', (servicos.fieldbyname('aliquotaissqn').AsCurrency/100),2);

                if servicos.fieldbyname('aliquotaissqn').AsCurrency <> 0 then
                  TagCompleta('baseCalculo', (servicos.fieldbyname('quantidade').asFloat *
                                              servicos.fieldbyname('valorservico').AsCurrency), 2)
                else
                  TagCompleta('baseCalculo', 0.00, 2);

                TagCompleta('cst', servicos.fieldbyname('cstissqn').asstring);
                TagCompleta('descricaoServico', copy(servicos.fieldbyname('descricao').asstring,1,60));
                TagCompleta('idCNAE', servicos.fieldbyname('idcnae').asstring);
                TagCompleta('quantidade', servicos.fieldbyname('quantidade').asstring);
                TagCompleta('valorTotal', (servicos.fieldbyname('valorservico').AsCurrency * servicos.fieldbyname('quantidade').asinteger), 2);
                TagCompleta('valorUnitario', servicos.fieldbyname('valorservico').AsCurrency,2);
              FechaTag('itemServico');

              servicos.next;
            end;
          FechaTag('itensServico');

          TagCompleta('logradouroTomador',   copy(FDest_Rua,1,60));

          if not HeUnidadeFederacao(FDest_UF) then
            TagCompleta('nomeMunicipioTomador',   copy(FDest_Mun,1,60), true, true, false);

          { O AEDF para homologação é o número do CMC (Ex.: 4454729) sem o último digito (digito verificador), ou seja, 445472 }
          if Notas.FieldByName('ambientenfs').AsString = '1' then {produção}
            TagCompleta('numeroAEDF', DadosdaFilial('aedffatura', notas.fieldbyname('filialemissao').asinteger))
          else
            TagCompleta('numeroAEDF', copy(somentenumero(Emit_IM), 1, length(somentenumero(Emit_IM))-1));

          TagCompleta('numeroEnderecoTomador',    copy(FDest_Nro,1,9), false, true, true);
          TagCompleta('paisTomador',IntToStr(FDest_CodPais), true, true, true);
          TagCompleta('razaoSocialTomador',  copy(FDest_Nome,1,60));


          {
          contatos.first;
          if not contatos.isempty and
            (contatos.fieldbyname('foneddd').AsString<>'') and
            (contatos.fieldbyname('fonenumero').asstring<>'') then
              TagCompleta('telefoneTomador', somentenumero(contatos.fieldbyname('foneddd').AsString)+somentenumero(contatos.fieldbyname('fonenumero').asstring), true, true, true);
              }

          if dest_fone<>'' then
              TagCompleta('telefoneTomador', dest_fone, true, true, true);

          if HeUnidadeFederacao(FDest_UF) then
            TagCompleta('ufTomador',   FDest_UF, true, true, true);

            {
          else
            TagCompleta('ufTomador',   'EX', true, true, true);
            }

          TagCompleta('valorISSQN', notas.fieldbyname('valorissqn').AsCurrency, 2);
          TagCompleta('valorISSQNSubstituicao', 0.00, 2, false);
          TagCompleta('valorTotalServicos', notas.fieldbyname('valorservicos').AsCurrency, 2);

        FechaTag('xmlProcessamentoNfpse');


  end;


  procedure InformacoesNotaFiscalEletronica;

    procedure IdentificacaoNotaFiscalEletronica;
    begin
      AbreTag('ide');
      TagCompleta('cUF',     Copy(FEmit_CodMun,1,2));
      TagCompleta('cNF',     preencheString(Notas.FieldByName('CodAleatorio').AsString,'0',8,False));

      if (notas.findfield('cancelamentonfforaprazolegal')<>nil) and
          notas.fieldbyname('cancelamentonfforaprazolegal').asboolean then
        TagCompleta('natOp', '999 - Estorno de NF-e não cancelada no prazo legal')
      else
      begin
        if (Notas.FieldByName('finalidadenf').AsString<>'2') then { Complementar }
          TagCompleta('natOp',   Copy(Notas.FieldByName('Natureza').AsString, 0, 60))
        else
          TagCompleta('natOp',   Copy('2-NF Complementar ' + Notas.FieldByName('Natureza').AsString, 0, 60));
      end;

//      TagCompleta('indPag',  Notas.FieldByName('FormaPagto').AsString); {RETIRADO 4.0}
      TagCompleta('mod',     Notas.FieldByName('ModeloDocto').AsString);
      TagCompleta('serie',   SerieSugestao);

      if Notas.findfield('NrDocumento')<>nil then
        TagCompleta('nNF',     Notas.FieldByName('NrDocumento').AsString)
      else
        TagCompleta('nNF',     Notas.FieldByName('numero').AsString);

      if Notas.FieldByName('datahoraemissao').AsString <> '' then
        TagCompleta('dhEmi', FormatarTimeStampz(Notas.FieldByName('datahoraemissao').AsDateTime));

      if (Notas.FieldByName('hsaient').AsString <> '') and (notas.FieldByName('modelodocto').asstring='55') then  {este dados para o modelo 65 NFce não deve ser informado}
        TagCompleta('dhSaiEnt', FormatarTimeStampz(Notas.FieldByName('hsaient').AsDateTime));

      if Tipo = 'S'
      then TagCompleta('tpNF',    '1')  // 0 - entrada  1 - saída
      else TagCompleta('tpNF',    '0'); // 0 - entrada  1 - saída

      { codigo fiscal
       no estado
       1 entrada
       5 saida
       fora
       2 entrada
       6 saida
       exterior
       3 entrada
       7 saida
      }

      //se for nota vinculada a cupom, sempre é 1 - jr
      if (FDest_UF=FEmit_UF) or
         ((Tipo='E') and ((Referenciadas<>nil) and (referenciadas.RecordCount=0))) or
         (fModeloDoctoFiscal='65') or
         (Notas.FieldByName('codigofiscal').AsString='5929') or
         (eHDevolucaoCompraForaEstadoVinculadaaCupom) then
        TagCompleta('idDest', '1')
      else
      if HeUnidadeFederacao(FDest_UF) then
        TagCompleta('idDest', '2')
      else
        TagCompleta('idDest', '3');


      TagCompleta('cMunFG',  FEmit_CodMun);
	  if(fModeloDoctoFiscal='65') then
		TagCompleta('tpImp','4')
	  else
		TagCompleta('tpImp',   Notas.FieldByName('formatodanfe').AsString);
      TagCompleta('tpEmis',  Notas.FieldByName('formaemissao').AsString);
      TagCompleta('cDV',     Notas.FieldByName('digchaveacesso').AsString);
      TagCompleta('tpAmb',   Notas.FieldByName('ambiente').AsString);

      {
      if ehDevolucaoImportacao(notas) then
        TagCompleta('finNFe',  '3')
      else
      }
        TagCompleta('finNFe',  Notas.FieldByName('finalidadenf').AsString);

      if fModeloDoctoFiscal='65' then
        TagCompleta('indFinal', '1')
      else
      begin
        {
        sempre que não for contribuinte de icms a venda é pra consumidor final
        if Notas.FindField('vendaconsumidorfinal')<>nil then
        begin
          if Notas.FieldByName('vendaconsumidorfinal').AsBoolean then
            TagCompleta('indFinal', '1')
          else
            TagCompleta('indFinal', '0');
        end
        else}

        //SEMPRE QUE NÃO (EU DISSE NÃO) FOR CONTRIBUINTE DE ICMS, OBRIGATORIAMENTE TEM QE IR A TAG INDFINAL=1

        if not Notas.FieldByName('clientecontribicms').asboolean or
              (Notas.FieldByName('ambiente').AsString = '2') or
              VendaConsumidorFinal or
              eHDevolucaoCompraForaEstadoVinculadaaCupom or
              (Notas.FieldByName('codigofiscal').AsString='5929') then
          TagCompleta('indFinal', '1')
        else
          TagCompleta('indFinal', '0');

      end;


{
      0=Não se aplica (por exemplo, Nota Fiscal complementar ou de ajuste);
      1=Operação presencial;
      2=Operação não presencial, pela Internet;
      3=Operação não presencial, Teleatendimento;
      4=NFC-e em operação com entrega a domicílio;
      5=Operação presencial, fora do estabelecimento; (incluído NT2016.002)
      9=Operação não presencial, outros.
}

      vIndPres := '';
      if (eHDevolucaoCompraForaEstadoVinculadaaCupom) then
        vIndPres := '1'   // operação é presencial
      else
      if Notas.FindField('indPres')<>nil then
        vIndPres := Notas.FieldByName('indPres').AsString
      else
        vIndPres := '0';  //0=Não se aplica (por exemplo, Nota Fiscal complementar ou de ajuste);

      TagCompleta('indPres', vIndPres);

        {

        0=Operação sem intermediador (em site ou plataforma
        própria)
        1=Operação em site ou plataforma de terceiros
        (intermediadores/marketplace)
        * Considera-se intermediador/marketplace os prestadores
        de serviços e de negócios referentes às transações
        comerciais ou de prestação de serviços intermediadas,
        realizadas por pessoas jurídicas inscritas no Cadastro
        Nacional de Pessoa Jurídica - CNPJ ou pessoas físicas
        inscritas no Cadastro de Pessoa Física - CPF, ainda que não
        inscritas no cadastro de contribuintes do ICMS.
        * Considera-se site/plataforma própria as vendas que não
        foram intermediadas (por marketplace), como venda em
        site próprio, teleatendimento.
        (Criado na NT 2020.006)

      indIntermed
        }


{
   Se Informado indicativo de presença, tag: indPres, IGUAL a 2, 3, 4 ou 9 - Obrigatório
    o preenchimento do campo Indicativo do Intermediador (tag: indIntermed)
}


      if (vIndPres = '2') or
         (vIndPres = '3') or
         (vIndPres = '4') or
         (vIndPres = '9') then

        {

        0=Operação sem intermediador (em site ou plataforma
        própria)

        1=Operação em site ou plataforma de terceiros
        (intermediadores/marketplace)
        * Considera-se intermediador/marketplace os prestadores
        de serviços e de negócios referentes às transações
        comerciais ou de prestação de serviços intermediadas,
        realizadas por pessoas jurídicas inscritas no Cadastro
        Nacional de Pessoa Jurídica - CNPJ ou pessoas físicas
        inscritas no Cadastro de Pessoa Física - CPF, ainda que não
        inscritas no cadastro de contribuintes do ICMS.
        * Considera-se site/plataforma própria as vendas que não
        foram intermediadas (por marketplace), como venda em
        site próprio, teleatendimento.
        (Criado na NT 2020.006)
        }
       TagCompleta('indIntermed', infIntermed[notas].indIntermed );


      TagCompleta('procEmi', Notas.FieldByName('procemissao').AsString);
      TagCompleta('verProc', Notas.FieldByName('versaoteclux').AsString);

      if (Notas.FieldByName('formaemissao').AsInteger in [2,3,4]) and (fModeloDoctoFiscal='55') then  // CONTINGENCIA NFE
      begin

        TagCompleta('dhCont', FormatarTimeStampz(strtodatetime(ParSistema.DataHoraInicialContingencia)));
        TagCompleta('xJust', parsistema.RazaoContingencia);
      end
      else
      if (Notas.FieldByName('formaemissao').AsInteger in [2,5,9]) and (fModeloDoctoFiscal='65') then //CONTINGENCIA SCAN
      begin
        TagCompleta('dhCont', FormatarTimeStampz(notas.fieldbyname('dhcont').asDateTime));
        TagCompleta('xJust', notas.fieldbyname('xjustcont').asString);
      end;


      Local := 'Identificação NFE REF.';
      if ((Referenciadas <> nil) and (Referenciadas.RecordCount > 0)) or
         ((Cupons        <> nil) and (cupons.recordcount > 0       )) then
      begin

//          AbreTag('NFref');

          if ((Referenciadas <> nil) and (Referenciadas.RecordCount > 0)) then
          begin
            Referenciadas.First;
            while not Referenciadas.Eof do
            begin

              AbreTag('NFref');

              if Referenciadas.Name = 'qryDadosFiscaisRef' then
              begin
                if not Referenciadas.FieldByName('NumeroNFe').IsNull then  // NFe
                begin
                  if Referenciadas.Findfield('numprotocolonfe')<> nil then
                    if trim(Referenciadas.FieldByName('numprotocolonfe').AsString)='' then
                    begin
                      local := 'NFe Referenciada: ' + Referenciadas.FieldByName('NumeroNF').AsString;
                      ValidarTag('numprotocolonfe', '');
                    end;

                  TagCompleta('refNFe', Referenciadas.FieldByName('NumeroNFe').AsString)
                end
                else
                if not Referenciadas.FieldByName('NumeroNF').IsNull then // NF normal
                begin
                  AbreTag('refNF');
                  TagCompleta('cUF',  Copy(Referenciadas.FieldByName('cidadeibge').AsString,1,2));

                  TagCompleta('AAMM', Referenciadas.FieldByName('data').AsDateTime,'yymm');
                  TagCompleta('CNPJ', preencheString(SomenteNumero(Referenciadas.FieldByName('pessoanumero').AsString),'0',14,False));
      //            TagCompleta('mod',  preencheString(Referenciadas.FieldByName('ModeloDocto').AsString,'0',2,False));
                  TagCompleta('mod',  Referenciadas.FieldByName('ModeloDocto').AsString);

                  if not Referenciadas.FieldByName('serie').IsNull and PossuiSomenteNumero(Referenciadas.FieldByName('serie').Asstring)  then
                    TagCompleta('serie', inttoStr(Referenciadas.FieldByName('serie').Asinteger))
                  else
                    TagCompleta('serie', '0');

                  TagCompleta('nNF', Referenciadas.FieldByName('NumeroNF').AsString);
                  FechaTag('refNF')
                end
                else
                if (Referenciadas.Findfield('numerocupom')<>nil) and
                   (not Referenciadas.Fieldbyname('numerocupom').isNull) then
                begin
                  AbreTag('refECF');
                  TagCompleta('mod',  '2D');
                  TagCompleta('nECF', Referenciadas.fieldbyname('maquina').AsString);
                  TagCompleta('nCOO', Referenciadas.fieldbyname('numerocupom').AsString);
                  FechaTag('refECF')
                end;
              end
              else
              if (Referenciadas.Name = 'qryNotaEntradaRef') or
                 (Referenciadas.Name = 'qryNotaRef') then
              begin
                if not Referenciadas.FieldByName('NumeroNFe').IsNull then  // NFe
                begin


                  if Referenciadas.Findfield('numprotocolonfe')<> nil then
                    if (Referenciadas.Findfield('verificarnumprotocolonfe')<> nil) and
                       (Referenciadas.FieldByName('verificarnumprotocolonfe').asBoolean) then
                      if trim(Referenciadas.FieldByName('numprotocolonfe').AsString)='' then
                      begin
                        local := 'NFe Referenciada: ' + Referenciadas.FieldByName('NumeroNFe').AsString;
                        ValidarTag('numprotocolonfe', '');
                      end;


                  TagCompleta('refNFe', Referenciadas.FieldByName('NumeroNFe').AsString)

                end
                else                                                         // NF normal
                if (Referenciadas.Findfield('NumeroNF')<>nil) and
                   (not Referenciadas.FieldByName('NumeroNF').isNull) then
                begin

                  AbreTag('refNF');
                  TagCompleta('cUF',  Copy(Referenciadas.FieldByName('cidadeibge').AsString,1,2));
                  TagCompleta('AAMM', Referenciadas.FieldByName('data').AsDateTime,'yymm');
                  TagCompleta('CNPJ', preencheString(SomenteNumero(Referenciadas.FieldByName('pessoanumero').AsString),'0',14,False));
      //            TagCompleta('mod',  preencheString(Referenciadas.FieldByName('ModeloDocto').AsString,'0',2,False));
                  TagCompleta('mod',  Referenciadas.FieldByName('ModeloDocto').AsString );
                  if not Referenciadas.FieldByName('serie').IsNull and PossuiSomenteNumero(Referenciadas.FieldByName('serie').Asstring)  then
                    TagCompleta('serie', inttostr(Referenciadas.FieldByName('serie').Asinteger))
                  else
                    TagCompleta('serie', '0');

                  TagCompleta('nNF', Referenciadas.FieldByName('NumeroNF').AsString);
                  FechaTag('refNF')
                end
                else
                if (Referenciadas.Findfield('numerocupom')<>nil) and
                   (not Referenciadas.FieldByName('numerocupom').isNull) then
                begin
                  AbreTag('refECF');
                  TagCompleta('mod',  '2D');
                  TagCompleta('nECF', Referenciadas.fieldbyname('maquina').AsString);
                  TagCompleta('nCOO', Referenciadas.fieldbyname('numerocupom').AsString);
                  FechaTag('refECF');
                end;

              end;
              FechaTag('NFref');
              Referenciadas.next;
            end;
          end;

          if ((Cupons <> nil) and (cupons.recordcount >0)) then
          begin
            Cupons.first;
            while not cupons.eof do
            begin
              AbreTag('NFref');
              AbreTag('refECF');
              TagCompleta('mod',  '2D');
              TagCompleta('nECF', cupons.fieldbyname('maquina').AsString);
              TagCompleta('nCOO', cupons.fieldbyname('numero').AsString);
              FechaTag('refECF');
              FechaTag('NFref');
              Cupons.next;
            end;
          end;

//          FechaTag('NFref');
          //Referenciadas.Next;   acredito que só se referencie a uma. Gedovar 09/06/2011
        //end
      end;

      FechaTag('ide')
    end;

    procedure IdentificacaoEmitente;
    begin
      AbreTag('emit');

{      if Notas.FieldByName('ambiente').AsString = '2' then // 1 – Produção / 2 - Homologação
      begin
        if HeUnidadeFederacao(FDest_UF) then
          TagCompleta('CNPJ', '99999999000191')
        else
          TagCompleta('CNPJ', '');  //coneudo vazio
        TagCompleta('xNome', 'NF-E EMITIDA EM AMBIENTE DE HOMOLOGACAO - SEM VALOR FISCAL');
      end
      else
      begin}
        TagCompleta('CNPJ', preencheString(SomenteNumero(FEmit_Documento),'0',14,False));
        TagCompleta('xNome',     FEmit_Nome);
{      end;}

//        TagCompleta('xFant',     Notas.FieldByName('').AsString);
      AbreTag('enderEmit');
      TagCompleta('xLgr',    FEmit_Rua);
      TagCompleta('nro',     FEmit_Nro);

      if trim(FEmit_Compl) <> '' then
        TagCompleta('xCpl',  Copy(trim(FEmit_Compl),1,60));

      TagCompleta('xBairro', Copy(FEmit_Bairro,1,60));

      TagCompleta('cMun',    FEmit_CodMun);
      TagCompleta('xMun',    FEmit_Mun);
      TagCompleta('UF',      FEmit_UF);

      TagCompleta('CEP', preencheString(FEmit_CEP,'0',8,false));

      TagCompleta('cPais',   '1058');
      TagCompleta('xPais',   'Brasil');

      if (trim(FEmit_Fone) <> '') and PossuiNumero(trim(FEmit_Fone)) then
        TagCompleta('fone',  trim(somentenumero(FEmit_Fone)));
      FechaTag('enderEmit');


      {
0=Emissão de NF-e com aplicativo do contribuinte;
1=Emissão de NF-e avulsa pelo Fisco;
2=Emissão de NF-e avulsa, pelo contribuinte com seu
certificado digital, através do site do Fisco;
3=Emissão NF-e pelo contribuinte com aplicativo
fornecido pelo Fisco.
      }
      if Notas.FieldByName('ProcEmissao').AsInteger in [0,2,3] then
          TagCompleta('IE', preencheString(trocar(trocar(trocar(FEmit_IE,'.',''),'-',''),'/',''), ' ', 14, true));

      if FEmit_IEST <> '' then
        TagCompleta('IEST', preencheString(trocar(trocar(trocar(FEmit_IEST,'.',''),'-',''),'/',''), ' ', 14, true));

      if {(Produtos <> nil) and (not Produtos.IsEmpty) and} (Servicos <> nil) and (not Servicos.IsEmpty) then
      begin
        if Emit_IM <> '' then
          TagCompleta('IM', Emit_IM);

        if Emit_CNAE <> '' then
          TagCompleta('CNAE',  Emit_CNAE)
      end;

      TagCompleta('CRT',   inttostr(fEMIT_CRT));
      FechaTag('emit')
    end;

    procedure IdentificacaoDestinatario;
    begin

      if (fModeloDoctoFiscal = '55') or
         ((fModeloDoctoFiscal = '65') and (FDest_Nome<>'')) then
      begin

        AbreTag('dest');

        if Notas.FieldByName('ambiente').AsString = '2' then // 1 – Produção / 2 - Homologação
        begin
          if HeUnidadeFederacao(FDest_UF) or (FDest_UF='') then
            TagCompleta('CNPJ', '99999999000191')
          else
            TagCompleta('idEstrangeiro', Dest_IE);

          TagCompleta('xNome', 'NF-E EMITIDA EM AMBIENTE DE HOMOLOGACAO - SEM VALOR FISCAL');
        end
        else
        begin
          if (FDest_TipoPessoa = 'F') then
          begin
            if HeUnidadeFederacao(FDest_UF) then
              TagCompleta('CPF',  preencheString(SomenteNumero(FDest_Documento),'0',11,False))
            else
              TagCompleta('idEstrangeiro', Dest_IE);
          end
          else
          begin
            if HeUnidadeFederacao(FDest_UF) then
              TagCompleta('CNPJ', preencheString(SomenteNumero(FDest_Documento),'0',14,False))
            else
              TagCompleta('idEstrangeiro', Dest_IE)
          end;

              {
          if (Notas.FindField('entnomedestinatario')<>nil) and
             (Notas.FindField('entnomedestinatario').AsString<>'') then
             TagCompleta('xNome',  Notas.FindField('entnomedestinatario').AsString)
          else
          }
             TagCompleta('xNome',  FDest_Nome);
        end;

        if (fModeloDoctoFiscal = '55') OR

           ((fModeloDoctoFiscal = '65') AND
            ((Notas.FindField('indPres')<>nil) AND (Notas.FieldByName('indPres').AsString = '4')) AND  //4=NFC-e em operação com entrega a domicílio;
             not vendainterestadual ) then
        begin

          AbreTag('enderDest');

          TagCompleta('xLgr',   FDest_Rua);

          if FDest_Nro='' then
            TagCompleta('nro',    '.', false)
          else
            TagCompleta('nro',    FDest_Nro, false);

          if trim(FDest_Compl) <> '' then
            TagCompleta('xCpl',  Copy(trim(FDest_Compl),1,60));

          if HeUnidadeFederacao(FDest_UF) then
          begin
            TagCompleta('xBairro', Copy(FDest_Bairro,1,60));
            TagCompleta('cMun', FDest_CodMun);
            TagCompleta('xMun', FDest_Mun);
            TagCompleta('UF',   FDest_UF)
          end
          else
          begin
            TagCompleta('xBairro','EXT',false);
            TagCompleta('cMun', '9999999');
            TagCompleta('xMun', 'EXTERIOR');
            TagCompleta('UF',   'EX')
          end;
          if FDest_CEP <> '' then
            TagCompleta('CEP',  preencheString(FDest_CEP,'0',8,False));

          if FDest_CodPais > 0 then
            TagCompleta('cPais',IntToStr(FDest_CodPais));

          if FDest_Pais <> ''then
            TagCompleta('xPais',FDest_Pais);

          if (trim(FDest_Fone) <> '') and PossuiNumero(trim(FDest_Fone)) then
            TagCompleta('fone', trim(somentenumero(FDest_Fone)));

          FechaTag('enderDest');
        end;


        //9=Não Contribuinte, que pode ou não possuir Inscrição Estadual no Cadastro de Contribuintes do ICMS;
        //Nota 2: No caso de operação com o Exterior informar indIEDest=9 e não informar a tag IE do destinatário;

        if not HeUnidadeFederacao(FDest_UF) or
          (Notas.FieldByName('modelodocto').AsString = '65') or    //NFCe
          (Notas.FieldByName('ambiente').AsString = '2') then
          TagCompleta('indIEDest', '9')
        else
      {
      Informado destinatário como Contribuinte Isento de Inscrição Estadual (indIEDest=2-ISENTO) em UF que não permite esta situação, conforme abaixo:
      - AM, BA, CE, GO, MG, MS, MT, PE, RN, SE, SP
      Exceção 1: Esta regra de validação não se aplica quando houver destaque do ICMS-ST (campo vICMSST) em pelo menos um item da NF-e.
      Exceção 2: Esta regra de validação não se aplica quando houver informação do ICMS-ST retido anteriormente (campo vICMSSTRet) em pelo menos um item da NF-e.
      Exceção 3: A regra de validação não se aplica, em produção, para Nota Fiscal com data de emissão anterior a 01/07/2016.
      }


		//aqui tinha um OR VendaConsumidorFinal .. que não faz sentido tirado em 28/12 - JR.
        if (not Notas.FieldByName('clientecontribicms').asboolean) 	then
        begin
          TagCompleta('indIEDest', '9');
          if (FDest_IE <> '') and (FDest_TipoPessoa='J') then
            TagCompleta('IE', preencheString(trocar(trocar(trocar(FDest_IE,'.',''),'-',''),'/',''),' ', 14, true ), true);
        end
        else
        if Notas.FieldByName('clientecontribicms').asboolean {and (FDest_TipoPessoa = 'J')} and (FDest_IE<>'') then    //1=Contribuinte ICMS (informar a IE do destinatário);
                                                                                       // Temos casos em que a pessoa e fisica e tem ie!! na Zita!! em 15/03/2018.... Gedovar
        begin
          TagCompleta('indIEDest', '1');
          TagCompleta('IE', preencheString(trocar(trocar(trocar(FDest_IE,'.',''),'-',''),'/',''),' ', 14, true ), true);
        end
        ELSE
        begin
          if ((FDest_IE = '') and (pos(FDest_UF, 'AM,BA,CE,GO,MG,MS,PE,RN,SE,SP,TO')=0) and (FDest_TipoPessoa = 'J')) then
            TagCompleta('indIEDest', '2')
        end;

        if FDest_ISUF <> '' then
          TagCompleta('ISUF', FDest_ISUF);

        FechaTag('dest')
      end;

    end;


    procedure IdentificacaoRetirada;
    begin
      if (FRetirada_Documento <> '') and
         (FRetirada_Rua       <> '') and
         (FRetirada_Nro       <> '') and
//         (FRetirada_Compl <> '') and
         (FRetirada_Bairro    <> '') and
         (FRetirada_Mun       <> '') and
         (FRetirada_CodMun    <> '') and
         (FRetirada_UF        <> '') then
      begin
        AbreTag('retirada');
        TagCompleta('CNPJ', preencheString(SomenteNumero(FRetirada_Documento),'0',14,False));

        TagCompleta('xLgr',   Copy(FRetirada_Rua,1,60));

        if trim(Copy(FRetirada_Nro,1,60))='' then
          TagCompleta('nro',    '.', false)
        else
          TagCompleta('nro',    Copy(FRetirada_Nro,1,60), false);

        if trim(FRetirada_Compl) <> '' then
          TagCompleta('xCpl', Copy(trim(FRetirada_Compl),1,60));
        if HeUnidadeFederacao(FRetirada_UF) then
        begin
          TagCompleta('xBairro',Copy(FRetirada_Bairro,1,60));
          TagCompleta('cMun', FRetirada_CodMun);
          TagCompleta('xMun', Copy(FRetirada_Mun,1,60));
          TagCompleta('UF',   FRetirada_UF);
        end
        else
        begin
          TagCompleta('xBairro','EXT',false);
          TagCompleta('cMun', '9999999');
          TagCompleta('xMun', 'EXTERIOR');
          TagCompleta('UF',   'EX')
        end;
        FechaTag('retirada')
      end
    end;

    procedure IdentificacaoEntrega;
    begin
      if (FEntrega_Documento <> '') and
//         (FEntrega_Nome      <> '') and
         (FEntrega_Rua       <> '') and
         (FEntrega_Nro       <> '') and
//         (FEntrega_Compl <> '') and
         (FEntrega_Bairro    <> '') and
         (FEntrega_Mun       <> '') and
         (FEntrega_CodMun    <> '') and
         (FEntrega_UF        <> '') and
         (FEntrega_CEP       <> '') then
      begin
        AbreTag('entrega');


        if (FDest_TipoPessoa = 'F') then
          TagCompleta('CPF',  preencheString(SomenteNumero(FEntrega_Documento),'0',11,False))
        else
          TagCompleta('CNPJ', preencheString(SomenteNumero(FEntrega_Documento),'0',14,False));

        if FEntrega_Nome <> '' then
          TagCompleta('xNome',  copy(FEntrega_Nome,1,60));

        TagCompleta('xLgr',   Copy(FEntrega_Rua,1,60));

        if trim(Copy(FEntrega_Nro,1,60))='' then
          TagCompleta('nro',    '.', false)
        else
          TagCompleta('nro',    Copy(FEntrega_Nro,1,60), false);

        if trim(FEntrega_Compl) <> '' then
          TagCompleta('xCpl', Copy(trim(FEntrega_Compl),1,60));
          
        if HeUnidadeFederacao(FEntrega_UF) then
        begin
          TagCompleta('xBairro',Copy(FEntrega_Bairro,1,60));
          TagCompleta('cMun', FEntrega_CodMun);
          TagCompleta('xMun', Copy(FEntrega_Mun,1,60));
          TagCompleta('UF',   FEntrega_UF);
          TagCompleta('CEP',  preencheString(FEntrega_CEP,'0',8,False));
{
          if FDest_CodPais > 0 then
            TagCompleta('cPais',IntToStr(FDest_CodPais));

          if FDest_Pais <> ''then
            TagCompleta('xPais',FDest_Pais);

          if (trim(FDest_Fone) <> '') and PossuiNumero(trim(FDest_Fone)) then
            TagCompleta('fone', trim(somentenumero(FDest_Fone)));


          CEP
          cPais
          xPais

          fone
          email
          IE
}

        end
        else
        begin
          TagCompleta('xBairro','EXT',false);
          TagCompleta('cMun', '9999999');
          TagCompleta('xMun', 'EXTERIOR');
          TagCompleta('UF',   'EX')


        end;
        FechaTag('entrega')
      end
    end;

    procedure IdentificacaoAutorizacaoObterXML;
    begin

      if not assigned(qrySignatarios) then
      begin
        qrySignatarios := TTecQuery.Create(nil);
        qrySignatarios.Database := Notas.DataBase;
      end;

      qrySignatarios.Sql.Text := 'select s.cpf from Signatarios s where (length(s.cpf)=11 or length(s.cpf)=14) and s.ind_resp_nfe=''S''';
      qrySignatarios.open;
      if qrySignatarios.recordcount<>0 then
      begin
        AbreTag('autXML');
        qrySignatarios.first;
        while not qrySignatarios.eof do
        begin
          if length(qrySignatarios.fieldbyname('cpf').asString)=11 then
            TagCompleta('CPF', preencheString(qrySignatarios.fieldbyname('cpf').asString, '0', 11, false), false, false, false)
          else
            TagCompleta('CNPJ', preencheString(qrySignatarios.fieldbyname('cpf').asString, '0', 14, false), false, false, false);
          qrySignatarios.next
        end;
        FechaTag('autXML');
      end;


    end;


              {
    <xNome> – Razão Social ou Nome do Expedidor/Recebedor.
<CEP> – CEP.
<cPais> – Código do País.
<xPais> – Nome do País.
<fone> – Telefone.
<email> – Endereço de E-mail do Expedidor/Recebedor.
<IE> –Inscrição Estadual do estabelecimento Expedidor/Recebedor.
}



    procedure Detalhamento;
    var
      nItem: Integer;
      vlocal_aux : String;
      vDespesasAcessorias : Currency;

    begin
      nItem := 0;

//      GuardarRegistroAtual(Produtos, True);
      if ((Produtos <> nil) and (Produtos.RecordCount > 0)) then
      begin
        try
          Produtos.First;
          while not Produtos.Eof do
          begin
            if vComplementoProdutos <> '' then
              vComplementoProdutos := trim(vComplementoProdutos) + ' '+ComplementoProduto(Produtos.FieldByName('produto').AsString)
            else
              vComplementoProdutos := ComplementoProduto(Produtos.FieldByName('produto').AsString);

            if (Tipo = 'S') and
               Produtos.FieldByName('composto').AsBoolean and   //  PRODUTOS COMPOSTOS
               ((Produtos.FieldByName('discriminarcomposto').AsString = 'S') or
                ((Produtos.FieldByName('discriminarcomposto').AsString = 'C') and
                 (Produtos.FieldByName('discriminarpreco').AsBoolean))) then
            begin
              Compostos.First;
              while not Compostos.Eof do
              begin
                if Produtos.FieldByName('produto').AsString = Compostos.FieldByName('composto').AsString then
                begin

                  local := 'Detalhamento do ítem composto: '+Copy(Compostos.FieldByName('pn').AsString,1,60);

                  Inc(nItem);
                  AbreTag('det', ['nItem'], [IntToStr(nItem)]);
                  AbreTag('prod');
                  TagCompleta('cProd',    Copy(Compostos.FieldByName('pn').AsString,1,60));

                  if trim(somentenumero(Compostos.FieldByName('tribcodigoean').AsString))='' then
                    TagCompleta('cEAN', 'SEM GTIN')
                  else
                    TagCompleta('cEAN', somentenumero(Compostos.FieldByName('tribcodigoean').AsString));


                  if (fambiente = '2') and (nitem=1) then // 1 – Produção / 2 - Homologação
                    TagCompleta('xProd', 'NOTA FISCAL EMITIDA EM AMBIENTE DE HOMOLOGACAO - SEM VALOR FISCAL')
                  else
                    TagCompleta('xProd',    Copy(Compostos.FieldByName('descricao').AsString,1,120));

                  TagCompleta('NCM',    Compostos.FieldByName('classificacaofiscal').AsString);

                  if (Compostos.Findfield('CEST')<>nil) and (Compostos.FieldByName('CEST').AsString<>'') then
                    TagCompleta('CEST',    somentenumero(Compostos.FieldByName('CEST').AsString));

                  if (cBenef[Compostos.FieldByName('componente').AsString,
                            inttostr(FEmit_CRT), //
                            FEmit_UF,
                            Compostos.FieldByName('incidencia').AsString,
                            Compostos.FieldByName('csosn').AsString,
                            Compostos.FieldByName('codigofiscal').AsString]<>'') then
                     TagCompleta('cBenef', fcBenef);

                  if Compostos.FieldByName('extipi').AsString <> '' then
                    TagCompleta('EXTIPI', Compostos.FieldByName('extipi').AsString);


                  TagCompleta('CFOP',      Compostos.FieldByName('codigofiscal').AsString);
                  TagCompleta('uCom',     Unidade(true));
                  TagCompleta('qCom',     Compostos.FieldByName('quantidade').AsCurrency,4);
                  TagCompleta('vUnCom',   Compostos.FieldByName('precovenda').Asfloat,10);
                  TagCompleta('vProd',    roundto(Compostos.FieldByName('quantidade').AsCurrency * Compostos.FieldByName('precovenda').Asfloat,-2),2);

                  if trim(somentenumero(Compostos.FieldByName('tribcodigoean').AsString))='' then
                    TagCompleta('cEANTrib', 'SEM GTIN')
                  else
                    TagCompleta('cEANTrib', somentenumero(Compostos.FieldByName('tribcodigoean').AsString));


                  TagCompleta('uTrib',    Copy(Compostos.FieldByName('tribunidade').AsString,1,6));
                  TagCompleta('qTrib',    Compostos.FieldByName('tribquantidade').AsCurrency,4);
                  TagCompleta('vUnTrib',  Compostos.FieldByName('tribunitario').Asfloat,10);
                  if Compostos.FieldByName('frete').AsCurrency > 0 then
                    TagCompleta('vFrete', Compostos.FieldByName('frete').AsCurrency,2);
                  if Compostos.FieldByName('seguro').AsCurrency > 0 then
                    TagCompleta('vSeg',   Compostos.FieldByName('seguro').AsCurrency,2);

                  if (Compostos.FieldByName('desconto').AsCurrency +
                      Compostos.FieldByName('valordescontoitem').AsCurrency) > 0 then
                    TagCompleta('vDesc',  Compostos.FieldByName('desconto').AsCurrency +
                                          Compostos.FieldByName('valordescontoitem').AsCurrency, 2);

                  vDespesasAcessorias := Compostos.FieldByName('despesasacessorias').AsCurrency +
                                         Compostos.FieldByName('acrescimo').AsCurrency;

                  if (compostos.findfield('vICMSSTRetDesp')<>nil) {and (tipo = 'S')} then
                     vDespesasAcessorias := vDespesasAcessorias + compostos.fieldbyname('vICMSSTRetDesp').ascurrency;

                     (*
                  if (compostos.findfield('valoripi')<>nil) and
                     { eHNotaFiscalSaidaDevolucao(compostos.FieldByName('codigofiscal').AsInteger) and}
                     not ContribuinteIPI {and (tipo = 'S')} then
                     vDespesasAcessorias := vDespesasAcessorias + compostos.fieldbyname('valoripi').ascurrency;
                     *)

                  if ehDevolucaoImportacao(compostos) then
                    vDespesasAcessorias := vDespesasAcessorias + Compostos.FieldByName('icmsvalor').AsCurrency;

                  if (vDespesasAcessorias  > 0 )then
                    TagCompleta('vOutro',  vDespesasAcessorias, 2);

                  TagCompleta('indTot',  '1');


                  if (Compostos.FindField('fci')<>nil) and
                     (Compostos.FieldByName('fci').AsString<>'') then
                    TagCompleta('nFCI', Compostos.FieldByName('fci').AsString);

                  FechaTag('prod');

                  local := 'Detalhamento do ítem composto: '+trim(Copy(Compostos.FieldByName('pn').AsString,1,60))+ ' - ICMS';
                  if (Compostos.FieldByName('incidencia').AsString <> '')  or
                     (Compostos.FieldByName('ipicst').AsString <> '')      or
                     ((Compostos.FindField('IIValor')<>nil) and (importacoes <> nil))  or
                     (Compostos.FieldByName('piscst').AsString <> '')      or
                     (Compostos.FieldByName('cofinscst').AsString <> '')   or
                     (Compostos.FieldByName('csosn').AsString <> '')   then
                  begin
                    AbreTag('imposto');

                    if (Compostos.FindField('valorimpostonacional')<>nil) and
                       (Compostos.FindField('valorimpostoimportado')<>nil) then
                      TagCompleta('vTotTrib',  (Compostos.FieldByName('valorimpostonacional').AsCurrency +
                                                Compostos.FieldByName('valorimpostoimportado').AsCurrency),2);

                    AbreTag('ICMS');

                    if (FEmit_CRT in [2,3]) then { Regime Tributário 2: Simples Excedente 3: Normal}
                    begin

                      {
                       codigo | valor |                                   descricao
                      --------+-------+-------------------------------------------------------------------------------
                            1 | 00    | Tributada integralmente}
                      if (Compostos.FieldByName('incidencia').AsString = ctTRIBUTADA) then
                      begin

                        AbreTag('ICMS00');
                        TagCompleta('orig',  Compostos.FieldByName('origem').AsString);
                        TagCompleta('CST',   Compostos.FieldByName('incidencia').AsString);
                        TagCompleta('modBC', Compostos.FieldByName('ICMSModalidade').AsString);

                        if Compostos.FieldByName('aliquotaicms').AsCurrency >= 0 then
                        begin
                          TagCompleta('vBC',   Compostos.FieldByName('icmsbasecalculo').AsCurrency,2);

                          if (Compostos.FieldByName('icmsbasecalculo').AsCurrency = 0) and
                             (Notas.FieldByName('finalidadenf').AsString<>'2') then
                          begin
                            TagCompleta('pICMS', 0,2);
                            TagCompleta('vICMS', 0,2);
//                            TagCompleta('pFCP', 0,2, true);
//                            TagCompleta('vFCP',0,2, true);
                          end
                          else
                          begin
                            TagCompleta('pICMS', Compostos.FieldByName('aliquotaicms').AsCurrency,2);
                            TagCompleta('vICMS', Compostos.FieldByName('icmsvalor').AsCurrency,2);
                          end;


                        end
                        else
                        begin
                          TagCompleta('vBC',   0,2);
                          TagCompleta('pICMS', 0,2);
                          TagCompleta('vICMS', 0,2);
//                          TagCompleta('pFCP', 0,2, true);
//                          TagCompleta('vFCP',0,2, true);
                        end;

                        if Compostos.FieldByName('pFCP').AsCurrency <> 0 then
                        begin
                          TagCompleta('pFCP', Compostos.FieldByName('pFCP').AsCurrency,2);
                          TagCompleta('vFCP', Compostos.FieldByName('vFCP').AsCurrency,2);
                        end;

                        FechaTag('ICMS00')
                      end
                      else
    {
                       codigo | valor |                                   descricao
                      --------+-------+-------------------------------------------------------------------------------
                            2 | 10    | Tributada e com cobrança do ICMS por substituição tributária
    }
                      if (Compostos.FieldByName('incidencia').AsString = ctTRIBUTADASUBSTITUICAO) then
                      begin
                        AbreTag('ICMS10');
                        TagCompleta('orig',    Compostos.FieldByName('origem').AsString);
                        TagCompleta('CST',     Compostos.FieldByName('incidencia').AsString);
                        TagCompleta('modBC',   Compostos.FieldByName('ICMSModalidade').AsString);

                        if Compostos.FieldByName('aliquotaicms').AsCurrency >= 0 then
                        begin
                          TagCompleta('vBC',   Compostos.FieldByName('icmsbasecalculo').AsCurrency,2);

                          if (Compostos.FieldByName('icmsbasecalculo').AsCurrency = 0) and
                             (Notas.FieldByName('finalidadenf').AsString<>'2') then
                          begin
                            TagCompleta('pICMS', 0,2);
                            TagCompleta('vICMS', 0,2);
//                            TagCompleta('vBCFCP', 0,2);
//                            TagCompleta('pFCP', 0,2, true);
//                            TagCompleta('vFCP',0,2, true);


                          end
                          else
                          begin
                            TagCompleta('pICMS', Compostos.FieldByName('aliquotaicms').AsCurrency,2);
                            TagCompleta('vICMS', Compostos.FieldByName('icmsvalor').AsCurrency,2);
                          end;
                        end
                        else
                        begin
                          TagCompleta('vBC',   0,2);
                          TagCompleta('pICMS', 0,2);
                          TagCompleta('vICMS', 0,2);
//                          TagCompleta('vBCFCP', 0,2);
//                          TagCompleta('pFCP', 0,2);
//                          TagCompleta('vFCP',0,2);
                        end;

                        if Compostos.FieldByName('pFCP').AsCurrency <> 0 then
                        begin
                          TagCompleta('vBCFCP', Compostos.FieldByName('vBCFCP').AsCurrency,2);
                          TagCompleta('pFCP', Compostos.FieldByName('pFCP').AsCurrency,2);
                          TagCompleta('vFCP', Compostos.FieldByName('vFCP').AsCurrency,2);
                        end;

                        TagCompleta('modBCST', Compostos.FieldByName('ICMSModSubst').AsString);

                        if Compostos.FieldByName('fatorsubstituicao').AsCurrency > 1 then
                          TagCompleta('pMVAST', truncar((Compostos.FieldByName('fatorsubstituicao').AsCurrency - 1) * 100,2),2)
                        else
                          TagCompleta('pMVAST', 0.00, 2);

                        if Compostos.FieldByName('pRedBCST').AsCurrency > 0 then
                          TagCompleta('pRedBCST', Compostos.FieldByName('pRedBCST').AsCurrency,2)
                        else
                          TagCompleta('pRedBCST', 0.00, 2);

                        TagCompleta('vBCST',   Compostos.FieldByName('ICMSBaseCalculoST').AsCurrency,2);
                        TagCompleta('pICMSST', Compostos.FieldByName('AliquotaICMSST').AsCurrency,2);
                        TagCompleta('vICMSST', Compostos.FieldByName('IcmsValorST').AsCurrency,2);

                        if Compostos.FieldByName('pFCPST').AsCurrency <> 0 then
                        begin
                          TagCompleta('vBCFCPST', Compostos.FieldByName('vBCFCPST').AsCurrency,2);
                          TagCompleta('pFCPST', Compostos.FieldByName('pFCPST').AsCurrency,2);
                          TagCompleta('vFCPST', Compostos.FieldByName('vFCPST').AsCurrency,2);
                        end;

                        FechaTag('ICMS10')
                      end
                      else
    {
                       codigo | valor |                                   descricao
                      --------+-------+-------------------------------------------------------------------------------
                            3 | 20    | Com redução de base de cálculo
    }
                      if (Compostos.FieldByName('incidencia').AsString = ctREDUCAOBASE) then
                      begin
                        AbreTag('ICMS20');
                        TagCompleta('orig',   Compostos.FieldByName('origem').AsString);
                        TagCompleta('CST',    Compostos.FieldByName('incidencia').AsString);
                        TagCompleta('modBC',  Compostos.FieldByName('ICMSModalidade').AsString);
                        TagCompleta('pRedBC', Compostos.FieldByName('percentualreducaobase').AsCurrency,2);

                        if Compostos.FieldByName('aliquotaicms').AsCurrency >= 0 then
                        begin
                          TagCompleta('vBC',   Compostos.FieldByName('icmsbasecalculo').AsCurrency,2);

                          if (Compostos.FieldByName('icmsbasecalculo').AsCurrency = 0) and
                             (Notas.FieldByName('finalidadenf').AsString<>'2') then
                          begin
                            TagCompleta('pICMS', 0,2);
                            TagCompleta('vICMS', 0,2);
//                            TagCompleta('vBCFCP', 0,2);
//                            TagCompleta('pFCP', 0,2);
//                            TagCompleta('vFCP',0,2);

                          end
                          else
                          begin
                            TagCompleta('pICMS', Compostos.FieldByName('aliquotaicms').AsCurrency,2);
                            TagCompleta('vICMS', Compostos.FieldByName('icmsvalor').AsCurrency,2);
                          end;
                        end
                        else
                        begin
                          TagCompleta('vBC',   0,2);
                          TagCompleta('pICMS', 0,2);
                          TagCompleta('vICMS', 0,2);
//                          TagCompleta('vBCFCP', 0,2);
//                          TagCompleta('pFCP', 0,2);
//                          TagCompleta('vFCP',0,2);
                        end;

                        if Compostos.FieldByName('pFCP').AsCurrency <> 0 then
                        begin
                          TagCompleta('vBCFCP', Compostos.FieldByName('vBCFCP').AsCurrency,2);
                          TagCompleta('pFCP', Compostos.FieldByName('pFCP').AsCurrency,2);
                          TagCompleta('vFCP', Compostos.FieldByName('vFCP').AsCurrency,2);
                        end;


                        FechaTag('ICMS20')
                      end
                      else
    {
                       codigo | valor |                                   descricao
                      --------+-------+-------------------------------------------------------------------------------
                            4 | 30    | Isenta ou não tributada e com cobrança do ICMS por substituição tributária
    }
                      if (Compostos.FieldByName('incidencia').AsString = ctISENTASUBSTITUICAO) then
                      begin
                        AbreTag('ICMS30');
                        TagCompleta('orig',    Compostos.FieldByName('origem').AsString);
                        TagCompleta('CST',     Compostos.FieldByName('incidencia').AsString);
                        TagCompleta('modBCST', Compostos.FieldByName('ICMSModSubst').AsString);

                       if Compostos.FieldByName('fatorsubstituicao').AsCurrency > 1 then
                          TagCompleta('pMVAST', truncar((Compostos.FieldByName('fatorsubstituicao').AsCurrency - 1) * 100,2),2)
                        else
                          TagCompleta('pMVAST', 0.00, 2);

                        if Compostos.FieldByName('pRedBCST').AsCurrency > 0 then
                          TagCompleta('pRedBCST', Compostos.FieldByName('pRedBCST').AsCurrency,2);
                        TagCompleta('vBCST',   Compostos.FieldByName('ICMSBaseCalculoST').AsCurrency,2);
                        TagCompleta('pICMSST', Compostos.FieldByName('AliquotaICMSST').AsCurrency,2);
                        TagCompleta('vICMSST', Compostos.FieldByName('IcmsValorST').AsCurrency,2);

                        if Compostos.FieldByName('pFCPST').AsCurrency <> 0 then
                        begin
                          TagCompleta('vBCFCPST', Compostos.FieldByName('vBCFCPST').AsCurrency,2);
                          TagCompleta('pFCPST', Compostos.FieldByName('pFCPST').AsCurrency,2);
                          TagCompleta('vFCPST', Compostos.FieldByName('vFCPST').AsCurrency,2);
                        end;

                        FechaTag('ICMS30')
                      end
                      else
    {
                       codigo | valor |                                   descricao
                      --------+-------+-------------------------------------------------------------------------------
                            5 | 40    | Isenta
                            6 | 41    | Não tributada
                            7 | 50    | Suspensão
    }
                      if ((Compostos.FieldByName('incidencia').AsString = ctISENTA) or
                          (Compostos.FieldByName('incidencia').AsString = ctNAOTRIBUTADA) or
                          (Compostos.FieldByName('incidencia').AsString = ctSUSPENSAO)) then
                      begin
                        AbreTag('ICMS40');
                        TagCompleta('orig', Compostos.FieldByName('origem').AsString);
                        TagCompleta('CST',  Compostos.FieldByName('incidencia').AsString);
                        FechaTag('ICMS40')
                      end
                      else
    {
                       codigo | valor |                                   descricao
                      --------+-------+-------------------------------------------------------------------------------
                            8 | 51    | Diferimento
    }
                      if (Compostos.FieldByName('incidencia').AsString = ctDIFERIMENTO) then
                      begin
                        AbreTag('ICMS51');
                        TagCompleta('orig',   Compostos.FieldByName('origem').AsString);
                        TagCompleta('CST',    Compostos.FieldByName('incidencia').AsString);
                        TagCompleta('modBC',  Compostos.FieldByName('ICMSModalidade').AsString);
                        if Compostos.FieldByName('percentualreducaobase').AsCurrency > 0 then
                          TagCompleta('pRedBC', Compostos.FieldByName('percentualreducaobase').AsCurrency,2);

                        if Compostos.FieldByName('icmsbasecalculo').AsCurrency > 0 then
                          TagCompleta('vBC',    Compostos.FieldByName('icmsbasecalculo').AsCurrency,2);

                        if Compostos.FieldByName('aliquotaicms').AsCurrency  > 0 then
                        begin
                          if (Compostos.FieldByName('icmsbasecalculo').AsCurrency = 0) and
                             (Notas.FieldByName('finalidadenf').AsString<>'2') then
                            TagCompleta('pICMS', 0,2)
                          else
                            TagCompleta('pICMS', Compostos.FieldByName('aliquotaicms').AsCurrency,2);
                        end;

                        if Compostos.FieldByName('vicmsop').AsCurrency > 0 then
                        begin
                          TagCompleta('vICMSOp', Compostos.FieldByName('vicmsop').AsCurrency,2);
                          TagCompleta('pDif',  Compostos.FieldByName('pdif').AsCurrency,4);
                          TagCompleta('vICMSDif', Compostos.FieldByName('vicmsdif').AsCurrency, 2);
                          TagCompleta('vICMS',  Compostos.FieldByName('icmsvalor').AsCurrency,2);

                          if Compostos.FieldByName('pFCP').AsCurrency <> 0 then
                          begin
                            TagCompleta('vBCFCP', Compostos.FieldByName('vBCFCP').AsCurrency,2);
                            TagCompleta('pFCP', Compostos.FieldByName('pFCP').AsCurrency,2);
                            TagCompleta('vFCP', Compostos.FieldByName('vFCP').AsCurrency,2);
                          end;

                        end;
                        FechaTag('ICMS51')
                      end
                      else
    {
                       codigo | valor |                                   descricao
                      --------+-------+-------------------------------------------------------------------------------
                            9 | 60    | ICMS cobrado anteriormente por substituição tributária
    }

                      if (Compostos.FieldByName('incidencia').AsString = ctCOBRADOSUSTITUICAO) and
                         (FEmit_CRT in [2,3])  then { Regime Tributário 2: Simples Excedente 3: Normal}
                      begin
                        AbreTag('ICMS60');
                        TagCompleta('orig',    Compostos.FieldByName('origem').AsString);
                        TagCompleta('CST',     Compostos.FieldByName('incidencia').AsString);
                        TagCompleta('vBCSTRet',   Compostos.FieldByName('vBCSTRet').AsCurrency,2);
                        TagCompleta('pST',   Compostos.FieldByName('pST').AsCurrency,2);

                        if not f_IndFinal then {não é consumidor final}
                          TagCompleta('vICMSSubstituto', 0,2);

                        TagCompleta('vICMSSTRet', Compostos.FieldByName('vICMSSTRet').AsCurrency,2);

                        if Compostos.FieldByName('pFCPSTRet').AsCurrency <> 0 then
                        begin
                          TagCompleta('vBCFCPSTRet', Compostos.FieldByName('vBCFCPSTRet').AsCurrency,2);
                          TagCompleta('pFCPSTRet', Compostos.FieldByName('pFCPSTRet').AsCurrency,2);
                          TagCompleta('vFCPSTRet', Compostos.FieldByName('vFCPSTRet').AsCurrency,2);
                        end;
                        FechaTag('ICMS60')
                      end
                      else
    {
                       codigo | valor |                                   descricao
                      --------+-------+-------------------------------------------------------------------------------
                           10 | 70    | Com redução de base de cálculo e cobrança do ICMS por substituição tributária
    }

                      if (Compostos.FieldByName('incidencia').AsString = ctREDUCAOBASESUBSTITUICAO) then
                      begin
                        AbreTag('ICMS70');
                        TagCompleta('orig',    Compostos.FieldByName('origem').AsString);
                        TagCompleta('CST',     Compostos.FieldByName('incidencia').AsString);
                        TagCompleta('modBC',   Compostos.FieldByName('ICMSModalidade').AsString);
                        if Compostos.FieldByName('percentualreducaobase').AsCurrency > 0 then
                          TagCompleta('pRedBC', Compostos.FieldByName('percentualreducaobase').AsCurrency,2);

                        if Compostos.FieldByName('aliquotaicms').AsCurrency >= 0 then
                        begin
                          TagCompleta('vBC',   Compostos.FieldByName('icmsbasecalculo').AsCurrency,2);

                          if (Compostos.FieldByName('icmsbasecalculo').AsCurrency = 0) and
                             (Notas.FieldByName('finalidadenf').AsString<>'2') then
                          begin
                            TagCompleta('pICMS', 0,2);
                            TagCompleta('vICMS', 0,2);
//                            TagCompleta('vBCFCP', 0,2);
//                            TagCompleta('pFCP', 0,2);
//                            TagCompleta('vFCP',0,2);

                          end
                          else
                          begin
                            TagCompleta('pICMS', Compostos.FieldByName('aliquotaicms').AsCurrency,2);
                            TagCompleta('vICMS', Compostos.FieldByName('icmsvalor').AsCurrency,2);

                          end;
                        end
                        else
                        begin
                          TagCompleta('vBC',   0,2);
                          TagCompleta('pICMS', 0,2);
                          TagCompleta('vICMS', 0,2);
//                          TagCompleta('vBCFCP', 0,2);
//                          TagCompleta('pFCP', 0,2);
//                          TagCompleta('vFCP',0,2);
                        end;

                        if Compostos.FieldByName('pFCP').AsCurrency <> 0 then
                        begin
                          TagCompleta('vBCFCP', Compostos.FieldByName('vBCFCP').AsCurrency,2);
                          TagCompleta('pFCP', Compostos.FieldByName('pFCP').AsCurrency,2);
                          TagCompleta('vFCP', Compostos.FieldByName('vFCP').AsCurrency,2);
                        end;



                        TagCompleta('modBCST', Compostos.FieldByName('ICMSModSubst').AsString);

                       if Compostos.FieldByName('fatorsubstituicao').AsCurrency > 1 then
                          TagCompleta('pMVAST', truncar((Compostos.FieldByName('fatorsubstituicao').AsCurrency - 1) * 100,2),2)
                        else
                          TagCompleta('pMVAST', 0.00, 2);

                        if Compostos.FieldByName('pRedBCST').AsCurrency > 0 then
                          TagCompleta('pRedBCST', Compostos.FieldByName('pRedBCST').AsCurrency,2);

                        TagCompleta('vBCST',   Compostos.FieldByName('ICMSBaseCalculoST').AsCurrency,2);
                        TagCompleta('pICMSST', Compostos.FieldByName('AliquotaICMSST').AsCurrency,2);
                        TagCompleta('vICMSST', Compostos.FieldByName('IcmsValorST').AsCurrency,2);

                        if Compostos.FieldByName('pFCPST').AsCurrency <> 0 then
                        begin
                          TagCompleta('vBCFCPST', Compostos.FieldByName('vBCFCPST').AsCurrency,2);
                          TagCompleta('pFCPST', Compostos.FieldByName('pFCPST').AsCurrency,2);
                          TagCompleta('vFCPST', Compostos.FieldByName('vFCPST').AsCurrency,2);
                        end;

                        FechaTag('ICMS70')
                      end
                      else
    {
                       codigo | valor |                                   descricao
                      --------+-------+-------------------------------------------------------------------------------
                           11 | 90    | Outros
    }
                      if (Compostos.FieldByName('incidencia').AsString = ctOUTROS) then
                      begin
                        AbreTag('ICMS90');
                        TagCompleta('orig',   Compostos.FieldByName('origem').AsString);
                        TagCompleta('CST',    Compostos.FieldByName('incidencia').AsString);
                        TagCompleta('modBC',  Compostos.FieldByName('ICMSModalidade').AsString);

                        if Compostos.FieldByName('aliquotaicms').AsCurrency >= 0 then
                        begin
                          TagCompleta('vBC',   Compostos.FieldByName('icmsbasecalculo').AsCurrency,2);

                          if (Compostos.FieldByName('icmsbasecalculo').AsCurrency = 0) and
                             (Notas.FieldByName('finalidadenf').AsString<>'2') then
                          begin

                            if Compostos.FieldByName('percentualreducaobase').AsCurrency > 0 then
                               TagCompleta('pRedBC', Compostos.FieldByName('percentualreducaobase').AsCurrency,2);

                            TagCompleta('pICMS', 0,2);
                            TagCompleta('vICMS', 0,2);
//                            TagCompleta('vBCFCP', 0,2);
//                            TagCompleta('pFCP', 0,2);
//                            TagCompleta('vFCP',0,2);

                          end
                          else
                          begin
                            if Compostos.FieldByName('percentualreducaobase').AsCurrency > 0 then
                              TagCompleta('pRedBC', Compostos.FieldByName('percentualreducaobase').AsCurrency,2);
                            TagCompleta('pICMS', Compostos.FieldByName('aliquotaicms').AsCurrency,2);
                            TagCompleta('vICMS', Compostos.FieldByName('icmsvalor').AsCurrency,2);

                          end;
                        end
                        else
                        begin
                          TagCompleta('vBC',   0,2);
                          if Compostos.FieldByName('percentualreducaobase').AsCurrency > 0 then
                            TagCompleta('pRedBC', Compostos.FieldByName('percentualreducaobase').AsCurrency,2);
                          TagCompleta('pICMS', 0,2);
                          TagCompleta('vICMS', 0,2);
//                          TagCompleta('vBCFCP', 0,2);
//                          TagCompleta('pFCP', 0,2);
//                          TagCompleta('vFCP',0,2);
                        end;

                        if Compostos.FieldByName('pFCP').AsCurrency <> 0 then
                        begin
                          TagCompleta('vBCFCP', Compostos.FieldByName('vBCFCP').AsCurrency,2);
                          TagCompleta('pFCP', Compostos.FieldByName('pFCP').AsCurrency,2);
                          TagCompleta('vFCP', Compostos.FieldByName('vFCP').AsCurrency,2);
                        end;





                        TagCompleta('modBCST', Compostos.FieldByName('ICMSModSubst').AsString);

                       if Compostos.FieldByName('fatorsubstituicao').AsCurrency > 1 then
                          TagCompleta('pMVAST', truncar((Compostos.FieldByName('fatorsubstituicao').AsCurrency - 1) * 100,2),2)
                        else
                          TagCompleta('pMVAST', 0.00, 2);

                        if Compostos.FieldByName('pRedBCST').AsCurrency > 0 then
                          TagCompleta('pRedBCST', Compostos.FieldByName('pRedBCST').AsCurrency,2);

                        TagCompleta('vBCST',   Compostos.FieldByName('ICMSBaseCalculoST').AsCurrency,2);
                        TagCompleta('pICMSST', Compostos.FieldByName('AliquotaICMSST').AsCurrency,2);
                        TagCompleta('vICMSST', Compostos.FieldByName('IcmsValorST').AsCurrency,2);

                        if Compostos.FieldByName('pFCPST').AsCurrency <> 0 then
                        begin
                          TagCompleta('vBCFCPST', Compostos.FieldByName('vBCFCPST').AsCurrency,2);
                          TagCompleta('pFCPST', Compostos.FieldByName('pFCPST').AsCurrency,2);
                          TagCompleta('vFCPST', Compostos.FieldByName('vFCPST').AsCurrency,2);
                        end;

                        FechaTag('ICMS90')
                      end
                      else
                      if (Compostos.FieldByName('incidencia').AsString = '') then
                        ValidarTag('CST','');

                    end
                    else
                    if (FEmit_CRT = 1) { Regime Tributário 1: Simples} then
                    begin

                      if(Compostos.FieldByName('csosn').AsString = '101') then {com Permissão de crédito}
                      begin
                        {aqui e agora}
                        AbreTag('ICMSSN101');
                        TagCompleta('orig',    Compostos.FieldByName('origem').AsString);
                        TagCompleta('CSOSN',   Compostos.FieldByName('csosn').AsString);
                        TagCompleta('pCredSN', Compostos.FieldByName('pCredSN').AsCurrency,2);
                        TagCompleta('vCredICMSSN', Compostos.FieldByName('vCredICMSSN').AsCurrency,2);
                        FechaTag('ICMSSN101');
                      end
                      else
                      if ((Compostos.FieldByName('csosn').AsString = '102') or  {Tributada pelo Simples Nacional sem permissão de crédito}
                          (Compostos.FieldByName('csosn').AsString = '103') or  {Isenção do ICMS no Simples Nacional para faixa de receita bruta}
                          (Compostos.FieldByName('csosn').AsString = '300') or  {imune}
                          (Compostos.FieldByName('csosn').AsString = '400')) then {não tributada pelo simples nacional}
                      begin
                        AbreTag('ICMSSN102');
                        TagCompleta('orig',    Compostos.FieldByName('origem').AsString);
                        TagCompleta('CSOSN',   Compostos.FieldByName('csosn').AsString);
                        FechaTag('ICMSSN102');
                      end
                      else
                      if (Compostos.FieldByName('csosn').AsString = '201') then {Tributada pelo Simples Nacional com permissão de crédito e com cobrança do ICMS por substituição tributária}
                      begin
                        AbreTag('ICMSSN201');
                        TagCompleta('orig',    Compostos.FieldByName('origem').AsString);
                        TagCompleta('CSOSN',   Compostos.FieldByName('csosn').AsString);

                        TagCompleta('modBCST', Compostos.FieldByName('ICMSModSubst').AsString);

                        if Compostos.FieldByName('fatorsubstituicao').AsCurrency > 1 then
                           TagCompleta('pMVAST', truncar((Compostos.FieldByName('fatorsubstituicao').AsCurrency - 1) * 100,2),2)
                        else
                          TagCompleta('pMVAST', 0.00, 2);

                        if Compostos.FieldByName('pRedBCST').AsCurrency > 0 then
                           TagCompleta('pRedBCST', Compostos.FieldByName('pRedBCST').AsCurrency,2);

                        TagCompleta('vBCST',   Compostos.FieldByName('ICMSBaseCalculoST').AsCurrency,2);
                        TagCompleta('pICMSST', Compostos.FieldByName('AliquotaICMSST').AsCurrency,2);
                        TagCompleta('vICMSST', Compostos.FieldByName('IcmsValorST').AsCurrency,2);

                        if Compostos.FieldByName('pFCPST').AsCurrency <> 0 then
                        begin
                          TagCompleta('vBCFCPST', Compostos.FieldByName('vBCFCPST').AsCurrency,2);
                          TagCompleta('pFCPST', Compostos.FieldByName('pFCPST').AsCurrency,2);
                          TagCompleta('vFCPST', Compostos.FieldByName('vFCPST').AsCurrency,2);
                        end;

                        TagCompleta('pCredSN', Compostos.FieldByName('pCredSN').AsCurrency,2);
                        TagCompleta('vCredICMSSN', Compostos.FieldByName('vCredICMSSN').AsCurrency,2);

                        FechaTag('ICMSSN201');
                      end
                      else
                      if ((Compostos.FieldByName('csosn').AsString = '202') or    {Tributada pelo Simples Nacional sem permissão de crédito e com cobrança do ICMS por substituição tributária}
                          (Compostos.FieldByName('csosn').AsString = '203')) then {Isenção do ICMS no Simples Nacional para faixa de receita bruta e com cobrança do ICMS por substituição tributária}
                      begin
                        AbreTag('ICMSSN202');
                        TagCompleta('orig',    Compostos.FieldByName('origem').AsString);
                        TagCompleta('CSOSN',   Compostos.FieldByName('csosn').AsString);

                        TagCompleta('modBCST', Compostos.FieldByName('ICMSModSubst').AsString);

                        if Compostos.FieldByName('fatorsubstituicao').AsCurrency > 1 then
                           TagCompleta('pMVAST', truncar((Compostos.FieldByName('fatorsubstituicao').AsCurrency - 1) * 100,2),2)
                        else
                          TagCompleta('pMVAST', 0.00, 2);

                        if Compostos.FieldByName('pRedBCST').AsCurrency > 0 then
                           TagCompleta('pRedBCST', Compostos.FieldByName('pRedBCST').AsCurrency,2);

                        TagCompleta('vBCST',   Compostos.FieldByName('ICMSBaseCalculoST').AsCurrency,2);
                        TagCompleta('pICMSST', Compostos.FieldByName('AliquotaICMSST').AsCurrency,2);
                        TagCompleta('vICMSST', Compostos.FieldByName('IcmsValorST').AsCurrency,2);

                        if Compostos.FieldByName('pFCPST').AsCurrency <> 0 then
                        begin
                          TagCompleta('vBCFCPST', Compostos.FieldByName('vBCFCPST').AsCurrency,2);
                          TagCompleta('pFCPST', Compostos.FieldByName('pFCPST').AsCurrency,2);
                          TagCompleta('vFCPST', Compostos.FieldByName('vFCPST').AsCurrency,2);
                        end;

                        FechaTag('ICMSSN202');

                      end
                      else
                      if (Compostos.FieldByName('csosn').AsString = '500') then {ICMS cobrado anteriormente por substituição tributária (substituído) ou por antecipação}
                      begin
                        AbreTag('ICMSSN500');
                        TagCompleta('orig',    Compostos.FieldByName('origem').AsString);
                        TagCompleta('CSOSN',     Compostos.FieldByName('csosn').AsString);
                        TagCompleta('vBCSTRet',   Compostos.FieldByName('vBCSTRet').AsCurrency,2);
                        TagCompleta('pST',   Compostos.FieldByName('pST').AsCurrency,2);

                        if not f_IndFinal then {não é consumidor final}
                           TagCompleta('vICMSSubstituto', 0,2);
                        TagCompleta('vICMSSTRet', Compostos.FieldByName('vICMSSTRet').AsCurrency,2);



                        if Compostos.FieldByName('pFCPSTRet').AsCurrency <> 0 then
                        begin
                          TagCompleta('vBCFCPSTRet', Compostos.FieldByName('vBCFCPSTRet').AsCurrency,2);
                          TagCompleta('pFCPSTRet', Compostos.FieldByName('pFCPSTRet').AsCurrency,2);
                          TagCompleta('vFCPSTRet', Compostos.FieldByName('vFCPSTRet').AsCurrency,2);
                        end;

                        FechaTag('ICMSSN500')
                      end
                      else
                      if (Compostos.FieldByName('csosn').AsString = '900') then {Outros}
                      begin

                        AbreTag('ICMSSN900');
                        TagCompleta('orig',    Compostos.FieldByName('origem').AsString);
                        TagCompleta('CSOSN',   Compostos.FieldByName('csosn').AsString);

                        TagCompleta('modBC',  Compostos.FieldByName('ICMSModalidade').AsString);
                        TagCompleta('vBC',    Compostos.FieldByName('icmsbasecalculo').AsCurrency,2);

                        TagCompleta('pRedBC', Compostos.FieldByName('percentualreducaobase').AsCurrency,2);

                        if (Compostos.FieldByName('icmsbasecalculo').AsCurrency = 0) and
                           (Notas.FieldByName('finalidadenf').AsString<>'2') then
                          TagCompleta('pICMS', 0,2)
                        else
                          TagCompleta('pICMS', Compostos.FieldByName('aliquotaicms').AsCurrency,2);

                        TagCompleta('vICMS',  Compostos.FieldByName('icmsvalor').AsCurrency,2);


                        TagCompleta('modBCST', Compostos.FieldByName('ICMSModSubst').AsString);

                        if Compostos.FieldByName('fatorsubstituicao').AsCurrency > 1 then
                           TagCompleta('pMVAST', truncar((Compostos.FieldByName('fatorsubstituicao').AsCurrency - 1) * 100,2),2)
                        else
                          TagCompleta('pMVAST', 0.00, 2);

                        if Compostos.FieldByName('pRedBCST').AsCurrency > 0 then
                           TagCompleta('pRedBCST', Compostos.FieldByName('pRedBCST').AsCurrency,2);

                        TagCompleta('vBCST',   Compostos.FieldByName('ICMSBaseCalculoST').AsCurrency,2);
                        TagCompleta('pICMSST', Compostos.FieldByName('AliquotaICMSST').AsCurrency,2);
                        TagCompleta('vICMSST', Compostos.FieldByName('IcmsValorST').AsCurrency,2);

                        if Compostos.FieldByName('pFCPST').AsCurrency <> 0 then
                        begin
                          TagCompleta('vBCFCPST', Compostos.FieldByName('vBCFCPST').AsCurrency,2);
                          TagCompleta('pFCPST', Compostos.FieldByName('pFCPST').AsCurrency,2);
                          TagCompleta('vFCPST', Compostos.FieldByName('vFCPST').AsCurrency,2);
                        end;

                        TagCompleta('pCredSN', Compostos.FieldByName('pCredSN').AsCurrency,2);
                        TagCompleta('vCredICMSSN', Compostos.FieldByName('vCredICMSSN').AsCurrency,2);

                        FechaTag('ICMSSN900');

                      end
                      else
                      if (Compostos.FieldByName('csosn').AsString = '') then
                         ValidarTag('CSOSN','');

                    end;

                    FechaTag('ICMS');


                    local := 'Detalhamento do ítem composto: '+trim(Copy(Compostos.FieldByName('pn').AsString,1,60))+ ' - IPI';

                    if (Compostos.FieldByName('IPICST').AsString <> '')  and (ContribuinteIPI or (not contribuinteIPI and eHImportacao)) {and
                       (FEmit_CRT in [2,3])}  then { Regime Tributário 2: Simples Excedente 3: Normal}
                    begin
                      AbreTag('IPI');
        {                    TagCompleta('clEnq', Compostos.FieldByName('').AsString);
                        TagCompleta('CNPJProd', Compostos.FieldByName('').AsString);
                        TagCompleta('cSelo', Compostos.FieldByName('').AsString);
                        TagCompleta('qSelo', Compostos.FieldByName('').AsString);
        }             TagCompleta('cEnq', Copy(Compostos.FieldByName('enquadramento').AsString,1,3));
                      if (Compostos.FieldByName('IPICST').AsString = '00') or
                         (Compostos.FieldByName('IPICST').AsString = '49') or
                         (Compostos.FieldByName('IPICST').AsString = '50') or
                         (Compostos.FieldByName('IPICST').AsString = '99') then
                      begin
                        AbreTag('IPITrib');
                        TagCompleta('CST',   Compostos.FieldByName('ipicst').AsString);
                        TagCompleta('vBC',   Compostos.FieldByName('ipibasecalculo').AsCurrency,2);
      //                      TagCompleta('qUnid', Compostos.FieldByName('').AsCurrency,4);
      //                      TagCompleta('vUnid', Compostos.FieldByName('').AsCurrency,4);
                        TagCompleta('pIPI',  Compostos.FieldByName('aliquotaipi').AsCurrency,2);
                        TagCompleta('vIPI',  Compostos.FieldByName('valoripi').AsCurrency,2);
                        FechaTag('IPITrib')
                      end
                      else
                      if (Compostos.FieldByName('IPICST').AsString = '01') or
                         (Compostos.FieldByName('IPICST').AsString = '02') or
                         (Compostos.FieldByName('IPICST').AsString = '03') or
                         (Compostos.FieldByName('IPICST').AsString = '04') or
                         (Compostos.FieldByName('IPICST').AsString = '05') or
                         (Compostos.FieldByName('IPICST').AsString = '51') or
                         (Compostos.FieldByName('IPICST').AsString = '52') or
                         (Compostos.FieldByName('IPICST').AsString = '53') or
                         (Compostos.FieldByName('IPICST').AsString = '54') or
                         (Compostos.FieldByName('IPICST').AsString = '55') then
                      begin
                        AbreTag('IPINT');
                        TagCompleta('CST', Compostos.FieldByName('ipicst').AsString);
                        FechaTag('IPINT')
                      end;
                      FechaTag('IPI')
                    end;


                    if ((Compostos.FindField('IIValor')<>nil) and (importacoes<>nil)) then
                    begin
                      AbreTag('II');
                      TagCompleta('vBC',      Compostos.FieldByName('iibasecalculo').AsCurrency,2);
                      TagCompleta('vDespAdu', Compostos.FieldByName('iidespaduaneira').AsCurrency,2);
                      TagCompleta('vII',      Compostos.FieldByName('iivalor').AsCurrency,2);
                      TagCompleta('vIOF',     Compostos.FieldByName('iiIOF').AsCurrency,2);
                      FechaTag('II')
                    end;

                    AbreTag('PIS');
                    local := 'Detalhamento do ítem composto: '+trim(Copy(Compostos.FieldByName('pn').AsString,1,60))+ ' - PIS';
                    if (Compostos.FieldByName('PISCST').AsString = '01') or
                       (Compostos.FieldByName('PISCST').AsString = '02') then
                    begin
                      AbreTag('PISAliq');
                      TagCompleta('CST',  Compostos.FieldByName('piscst').AsString);
                      TagCompleta('vBC',  Compostos.FieldByName('pisbasecalculo').AsCurrency,2);

                      if Compostos.FieldByName('pisbasecalculo').AsCurrency <> 0 then
                        TagCompleta('pPIS', Compostos.FieldByName('pisaliquota').AsCurrency,2)
                      else
                        TagCompleta('pPIS', 0.00, 2);

                      TagCompleta('vPIS', Compostos.FieldByName('pisvalor').AsCurrency,2);
                      FechaTag('PISAliq')
                    end
                    else
                    if (Compostos.FieldByName('PISCST').AsString = '03') then
                    begin
                      {Código não preparado para esta modalidade}
                      AbreTag('PISQtde');
                      TagCompleta('CST',  Compostos.FieldByName('piscst').AsString);
      //              TagCompleta('vBCProd', Compostos.FieldByName('').AsCurrency,4);
      //              TagCompleta('vAliqProd', Compostos.FieldByName('').AsCurrency,4);
                      TagCompleta('vPIS', Compostos.FieldByName('pisvalor').AsCurrency,2);
                      FechaTag('PISQtde')
                    end
                    else
                    if (Compostos.FieldByName('PISCST').AsString = '04') or
                       (Compostos.FieldByName('PISCST').AsString = '06') or
                       (Compostos.FieldByName('PISCST').AsString = '07') or
                       (Compostos.FieldByName('PISCST').AsString = '08') or
                       (Compostos.FieldByName('PISCST').AsString = '09') then
                    begin
                      AbreTag('PISNT');
                      TagCompleta('CST', Compostos.FieldByName('piscst').AsString);
                      FechaTag('PISNT')
                    end
                    else
                    if (Compostos.FieldByName('PISCST').AsString = '99') or
                        {codigo não presentes na nfe ainda: ficam como 99}
                        (compostos.FieldByName('piscst').AsString = '05') or
                        (compostos.FieldByName('piscst').AsString = '49') or
                        (compostos.FieldByName('piscst').AsString = '50') or
                        (compostos.FieldByName('piscst').AsString = '51') or
                        (compostos.FieldByName('piscst').AsString = '52') or
                        (compostos.FieldByName('piscst').AsString = '53') or
                        (compostos.FieldByName('piscst').AsString = '54') or
                        (compostos.FieldByName('piscst').AsString = '55') or
                        (compostos.FieldByName('piscst').AsString = '56') or
                        (compostos.FieldByName('piscst').AsString = '60') or
                        (compostos.FieldByName('piscst').AsString = '61') or
                        (compostos.FieldByName('piscst').AsString = '62') or
                        (compostos.FieldByName('piscst').AsString = '63') or
                        (compostos.FieldByName('piscst').AsString = '64') or
                        (compostos.FieldByName('piscst').AsString = '65') or
                        (compostos.FieldByName('piscst').AsString = '66') or
                        (compostos.FieldByName('piscst').AsString = '67') or
                        (compostos.FieldByName('piscst').AsString = '70') or
                        (compostos.FieldByName('piscst').AsString = '71') or
                        (compostos.FieldByName('piscst').AsString = '72') or
                        (compostos.FieldByName('piscst').AsString = '73') or
                        (compostos.FieldByName('piscst').AsString = '74') or
                        (compostos.FieldByName('piscst').AsString = '75') or
                        (compostos.FieldByName('piscst').AsString = '98') then
                    begin
                      AbreTag('PISOutr');
                      TagCompleta('CST',  Compostos.FieldByName('piscst').AsString);
                      TagCompleta('vBC',  Compostos.FieldByName('pisbasecalculo').AsCurrency,2);

                      if Compostos.FieldByName('pisbasecalculo').AsCurrency <> 0 then
                        TagCompleta('pPIS', Compostos.FieldByName('pisaliquota').AsCurrency,2)
                      else
                        TagCompleta('pPIS', 0.00, 2);

      //              TagCompleta('qBCProd', Compostos.FieldByName('').AsCurrency,4);
      //              TagCompleta('vAliqProd', Compostos.FieldByName('').AsCurrency,4);
                      TagCompleta('vPIS', Compostos.FieldByName('pisvalor').AsCurrency,2);
                      FechaTag('PISOutr')
                    end
                    else
                    if (Compostos.FieldByName('PISCST').AsString = '') then
                      ValidarTag('CST','');

                    FechaTag('PIS');
                    // PIS ST ?

                    local := 'Detalhamento do ítem composto: '+trim(Copy(Compostos.FieldByName('pn').AsString,1,60))+ ' - COFINS';
                    AbreTag('COFINS');
                    if (Compostos.FieldByName('COFINSCST').AsString = '01') or
                       (Compostos.FieldByName('COFINSCST').AsString = '02') then
                    begin
                      AbreTag('COFINSAliq');
                      TagCompleta('CST',     Compostos.FieldByName('cofinscst').AsString);
                      TagCompleta('vBC',     Compostos.FieldByName('cofinsbasecalculo').AsCurrency,2);

                      if Compostos.FieldByName('cofinsbasecalculo').AsCurrency <> 0 then
                        TagCompleta('pCOFINS', Compostos.FieldByName('cofinsaliquota').AsCurrency,2)
                      else
                        TagCompleta('pCOFINS', 0.00, 2);

                      TagCompleta('vCOFINS', Compostos.FieldByName('cofinsvalor').AsCurrency,2);
                      FechaTag('COFINSAliq')
                    end
                    else
                    if (Compostos.FieldByName('COFINSCST').AsString = '03') then
                    begin
                      {Código não preparado para esta modalidade}
                      AbreTag('COFINSQtde');
                      TagCompleta('CST',     Compostos.FieldByName('cofinscst').AsString);
      //              TagCompleta('qBCProd', Compostos.FieldByName('').AsCurrency,4);
      //              TagCompleta('vAliqProd', Compostos.FieldByName('').AsCurrency,4);
                      TagCompleta('vCOFINS', Compostos.FieldByName('cofinsvalor').AsCurrency,2);
                      FechaTag('COFINSQtde')
                    end
                    else
                    if (Compostos.FieldByName('COFINSCST').AsString = '04') or
                       (Compostos.FieldByName('COFINSCST').AsString = '06') or
                       (Compostos.FieldByName('COFINSCST').AsString = '07') or
                       (Compostos.FieldByName('COFINSCST').AsString = '08') or
                       (Compostos.FieldByName('COFINSCST').AsString = '09') then
                    begin
                      AbreTag('COFINSNT');
                      TagCompleta('CST', Compostos.FieldByName('cofinscst').AsString);
                      FechaTag('COFINSNT')
                    end
                    else
                    if (Compostos.FieldByName('COFINSCST').AsString = '99') or
                        {codigo não presentes na nfe ainda: ficam como 99}
                        (compostos.FieldByName('cofinscst').AsString = '05') or
                        (compostos.FieldByName('cofinscst').AsString = '49') or
                        (compostos.FieldByName('cofinscst').AsString = '50') or
                        (compostos.FieldByName('cofinscst').AsString = '51') or
                        (compostos.FieldByName('cofinscst').AsString = '52') or
                        (compostos.FieldByName('cofinscst').AsString = '53') or
                        (compostos.FieldByName('cofinscst').AsString = '54') or
                        (compostos.FieldByName('cofinscst').AsString = '55') or
                        (compostos.FieldByName('cofinscst').AsString = '56') or
                        (compostos.FieldByName('cofinscst').AsString = '60') or
                        (compostos.FieldByName('cofinscst').AsString = '61') or
                        (compostos.FieldByName('cofinscst').AsString = '62') or
                        (compostos.FieldByName('cofinscst').AsString = '63') or
                        (compostos.FieldByName('cofinscst').AsString = '64') or
                        (compostos.FieldByName('cofinscst').AsString = '65') or
                        (compostos.FieldByName('cofinscst').AsString = '66') or
                        (compostos.FieldByName('cofinscst').AsString = '67') or
                        (compostos.FieldByName('cofinscst').AsString = '70') or
                        (compostos.FieldByName('cofinscst').AsString = '71') or
                        (compostos.FieldByName('cofinscst').AsString = '72') or
                        (compostos.FieldByName('cofinscst').AsString = '73') or
                        (compostos.FieldByName('cofinscst').AsString = '74') or
                        (compostos.FieldByName('cofinscst').AsString = '75') or
                        (compostos.FieldByName('cofinscst').AsString = '98') then
                    begin
                      AbreTag('COFINSOutr');
                      TagCompleta('CST',     Compostos.FieldByName('cofinscst').AsString);
                      TagCompleta('vBC',     Compostos.FieldByName('cofinsbasecalculo').AsCurrency,2);

                      if Compostos.FieldByName('cofinsbasecalculo').AsCurrency <> 0 then
                        TagCompleta('pCOFINS', Compostos.FieldByName('cofinsaliquota').AsCurrency,2)
                      else
                        TagCompleta('pCOFINS', 0.00, 2);


      //              TagCompleta('qBCProd', Compostos.FieldByName('').AsCurrency,4);
      //              TagCompleta('vAliqProd', Compostos.FieldByName('').AsCurrency,4);
                      TagCompleta('vCOFINS', Compostos.FieldByName('cofinsvalor').AsCurrency,2);
                      FechaTag('COFINSOutr')
                    end
                    else
                    if (Compostos.FieldByName('COFINSCST').AsString = '') then
                      ValidarTag('CST','');

                    FechaTag('COFINS')
                  end;

                  // Esperando definição se simples também se enquadra
//                  if (FEmit_CRT in [2,3]) then { Regime Tributário 2: Simples Excedente 3: Normal}
//                  begin
                    { esta opção esperando definição se entra ou nao o regime simples }

                    (*
                    if VendaInterEstadual and
                       VendaConsumidorFinal and (not Notas.FieldByName('clientecontribicms').asboolean or
                                                    (Notas.FieldByName('clientecontribicms').asboolean and
                                                     ((Notas.findfield('responsaveldifal')<>nil) and Notas.fieldbyname('responsaveldifal').asBoolean)
													                                             AND (compostos.fieldbyname('icmsvalorst').ascurrency=0))) and
                      (tipo='S') and
                      (Notas.FieldByName('modelodocto').asString <> '65')

                    then
                    *)



                        if (Compostos.FindField('vICMSUFDest')  <> nil) and
                           (Compostos.FindField('vFCPUFDest')   <> nil) and
                           (Compostos.FindField('vICMSUFRemet') <> nil) then

                          if (not Compostos.FieldByName('vICMSUFDest').isnull) or
                             (not Compostos.FieldByName('vFCPUFDest').isnull) or
                             (not Compostos.FieldByName('vICMSUFRemet').isnull) then

                          begin
                            AbreTag('ICMSUFDest');
                              TagCompleta('vBCUFDest',   Compostos.FieldByName('vBCUFDest').AsCurrency, 2);
                              TagCompleta('vBCFCPUFDest', Compostos.FieldByName('vBCFCPUFDest').AsCurrency, 2);
                              TagCompleta('pFCPUFDest', Compostos.FieldByName('pFCPUFDest').AsCurrency, 2);
                              TagCompleta('pICMSUFDest', Compostos.FieldByName('pICMSUFDest').AsCurrency, 2);
                              TagCompleta('pICMSInter', Compostos.FieldByName('pICMSInter').AsCurrency, 2);
                              TagCompleta('pICMSInterPart', Compostos.FieldByName('pICMSInterPart').AsCurrency, 2);
                              TagCompleta('vFCPUFDest', Compostos.FieldByName('vFCPUFDest').AsCurrency, 2);
                              TagCompleta('vICMSUFDest',   Compostos.FieldByName('vICMSUFDest').AsCurrency, 2);
                              TagCompleta('vICMSUFRemet',   Compostos.FieldByName('vICMSUFRemet').AsCurrency, 2);
                            FechaTag('ICMSUFDest');
                          end;


//                  end;


                  // COFINS ST

                  FechaTag('imposto');

                  (*
                  if not ContribuinteIPI and
                     (Notas.FieldByName('finalidadenf').AsString='4') and
                     ((Notas.FieldByName('valoripi').AsCurrency) <> 0) then  {qdo devolução e não contribuinte de ipi}
                  begin
                    TagCompleta('vIPI',    Notas.FieldByName('valoripi').AsCurrency,2)

                    AbreTag('impostoDevol');
                      if qryProdutosquantidadenotaorigem

                      pDevol
                      IPI
                      vIPIDevol

                    FechaTag('impostoDevol');
                  end;

                  *)


        {          if not Compostos.FieldByName('observacoes').IsNull then
                    TagCompleta('infAdProd', Compostos.FieldByName('observacoes').AsString);
                  end;
        }
                  FechaTag('det');
                end;
                Compostos.Next;
              end;
            end
            else
            begin
              Inc(nItem);
              AbreTag('det', ['nItem'], [IntToStr(nItem)]);
              AbreTag('prod');

              eHComplementarSemProduto := False;

              if (Tipo = 'S') and
                 (produtos.FindField('pn')<>nil) and
                 (Produtos.FieldByName('pn').AsString <> '') and
                 parsistema.controlesvoltadosparaindustria then
              begin
                TagCompleta('cProd',  Copy(Produtos.FieldByName('pn').AsString,1,60));
                vlocal_aux := 'Detalhamento do ítem: '+Copy(Produtos.FieldByName('pn').AsString,1,60);
              end
              else
              begin
                if (Produtos.FindField('codigovisual')<>nil) and
                   (Produtos.FieldByName('codigovisual').asstring<>'')  then
                begin
                  TagCompleta('cProd',    Copy(Produtos.FieldByName('codigovisual').AsString,1,60));
                  vlocal_aux := 'Detalhamento do ítem: '+trim(Copy(Produtos.FieldByName('codigovisual').AsString,1,60));
                end
                else
                if (Produtos.FindField('produtovisual')<>nil) and
                   (Produtos.FieldByName('produtovisual').asstring<>'') then
                begin
                  TagCompleta('cProd',    Copy(Produtos.FieldByName('produtovisual').AsString,1,60));
                  vlocal_aux := 'Detalhamento do ítem: '+trim(Copy(Produtos.FieldByName('produtovisual').AsString,1,60));
                end
                else
                if (Produtos.FindField('produto')<>nil) and
                   (Produtos.FieldByName('produto').asstring<>'') then
                begin
                  TagCompleta('cProd',    Copy(Produtos.FieldByName('produto').AsString,1,60));
                  vlocal_aux := 'Detalhamento do ítem: '+trim(Copy(Produtos.FieldByName('produto').AsString,1,60));
                end;

                (*
                else  // caso for utilizar a opção abaixo deverá cadastrar um produto e indicar em parametros pois a chave é dadofiscal,produto,numero
                      // não podendo ter uma produto null 
                if (notas.fieldByName('finalidadenf').asString = '2') then {è Complementar e não tem produto}
                begin
                  eHComplementarSemProduto := True;
                  TagCompleta('cProd', 'CFOP'+Produtos.FieldByName('codigofiscal').AsString);
                  vlocal_aux := 'Detalhamento do ítem: '+trim(Copy('CFOP'+Produtos.FieldByName('codigofiscal').AsString,1,60));
                end;

                *)


              end;

              local := vlocal_aux;

              if trim(somentenumero(Produtos.FieldByName('tribcodigoean').AsString))='' then
                TagCompleta('cEAN', 'SEM GTIN')
              else
                TagCompleta('cEAN', somentenumero(Produtos.FieldByName('tribcodigoean').AsString));
  
              if notas.FindField('TagAdPedNFE')<>nil then
              begin
                if notas.Fieldbyname('TagAdPedNFE').AsBoolean then
                begin
                  if (fambiente = '2') and (nitem=1) then // 1 – Produção / 2 - Homologação
                     TagCompleta('xProd', 'NOTA FISCAL EMITIDA EM AMBIENTE DE HOMOLOGACAO - SEM VALOR FISCAL')
                  else
                  begin
                    if (Produtos.FindField('descricaonanf')<>nil) and
                       (Produtos.FieldByName('descricaonanf').AsString<>'') then
                        TagCompleta('xProd',    Copy(Produtos.FieldByName('descricaonanf').AsString,1,120), true, false)
                      else
                        TagCompleta('xProd',    Copy(Produtos.FieldByName('descricaoproduto').AsString,1,120), true, false);
                  end;
                end
                else
                begin
                  if (fambiente = '2') and (nitem=1) then // 1 – Produção / 2 - Homologação
                     TagCompleta('xProd', 'NOTA FISCAL EMITIDA EM AMBIENTE DE HOMOLOGACAO - SEM VALOR FISCAL')
                  else
                  begin
                    if (Produtos.FindField('descricaonanf')<>nil) and
                       (Produtos.FieldByName('descricaonanf').AsString<>'') then
                      TagCompleta('xProd',    Copy(Produtos.FieldByName('descricaonanf').AsString,1,120))
                    else
                      TagCompleta('xProd',    Copy(Produtos.FieldByName('descricaoproduto').AsString,1,120));
                  end;
                end;
              end
              else
              begin
                if (fambiente = '2') and (nitem=1) then // 1 – Produção / 2 - Homologação
                   TagCompleta('xProd', 'NOTA FISCAL EMITIDA EM AMBIENTE DE HOMOLOGACAO - SEM VALOR FISCAL')
                else
                begin
                  if (Produtos.FindField('descricaonanf') <> nil) and
                     (Produtos.FieldByName('descricaonanf').AsString <> '')

                                       // KRAH-ICE - Como havia o termo 'RESISTORES DE FIO' e 'RESISTOR DE FIO',
                                       //            resolveu-se padronizar em 'RESISTOR DE FIO'
                  then if UpperCase(Produtos.FieldByName('descricaonanf').AsString) <> 'RESISTOR DE FIO'
                       then TagCompleta('xProd',Copy(Produtos.FieldByName('descricaonanf').   AsString,1,120))
                       else TagCompleta('xProd',Copy(Produtos.FieldByName('descricaonanf').   AsString,1,120) + ' ' +
                                                Copy(Produtos.FieldByName('descricaoproduto').AsString,1,120))
                  else
                    TagCompleta('xProd',    Copy(Produtos.FieldByName('descricaoproduto').AsString,1,120));
                end;
              end;

              if eHComplementarSemProduto then
                TagCompleta('NCM',    '00')
              else
                TagCompleta('NCM',    Produtos.FieldByName('classificacaofiscal').AsString);

              if (produtos.FindField('CEST')<>nil) and (produtos.FieldByName('CEST').AsString<>'') then
                TagCompleta('CEST',   somentenumero(produtos.FieldByName('CEST').AsString));

              if (cBenef[Produtos.FieldByName('produto').AsString,
                        inttostr(FEmit_CRT), //
                        FEmit_UF,
                        produtos.FieldByName('incidencia').AsString,
                        produtos.FieldByName('csosn').AsString,
                        Produtos.FieldByName('codigofiscal').AsString]<>'') then
                 TagCompleta('cBenef', fcBenef);

              if Produtos.FieldByName('extipi').AsString <> '' then
                TagCompleta('EXTIPI', Produtos.FieldByName('extipi').AsString);


              TagCompleta('CFOP',     Produtos.FieldByName('codigofiscal').AsString);
              TagCompleta('uCom',     Unidade(false));
              TagCompleta('qCom',     Produtos.FieldByName('quantidade').AsCurrency,4);
              if (Tipo = 'S') then
                TagCompleta('vUnCom',   Produtos.FieldByName('precovenda').Asfloat,10)
              else
                TagCompleta('vUnCom',   Produtos.FieldByName('precounitario').Asfloat,10);

              if (Tipo = 'S') then
              begin
                if (notas.fieldByName('finalidadenf').asString <> '2') or
                   ((Produtos.FieldByName('quantidade').AsCurrency<>0) and
                    (Produtos.FieldByName('precovenda').Asfloat<>0)) then
                  TagCompleta('vProd',    roundto(Produtos.FieldByName('quantidade').AsCurrency * Produtos.FieldByName('precovenda').Asfloat,-2),2)
                else                                                                        
                  TagCompleta('vProd',    roundto(Produtos.FieldByName('vprod').Asfloat,-2),2);
              end
              else
                TagCompleta('vProd',    Produtos.FieldByName('quantidade').AsCurrency * Produtos.FieldByName('precounitario').Asfloat,2);

              if trim(somentenumero(Produtos.FieldByName('tribcodigoean').AsString))='' then
                TagCompleta('cEANTrib', 'SEM GTIN')
              else
                TagCompleta('cEANTrib', somentenumero(Produtos.FieldByName('tribcodigoean').AsString));

              TagCompleta('uTrib',    Copy(Produtos.FieldByName('tribunidade').AsString,1,6));
              TagCompleta('qTrib',    Produtos.FieldByName('tribquantidade').AsCurrency,4);
              TagCompleta('vUnTrib',  Produtos.FieldByName('tribunitario').Asfloat,10);
              if Produtos.FieldByName('frete').AsCurrency > 0 then
                TagCompleta('vFrete', Produtos.FieldByName('frete').AsCurrency,2);
              if Produtos.FieldByName('seguro').AsCurrency > 0 then
                TagCompleta('vSeg',   Produtos.FieldByName('seguro').AsCurrency,2);

              if (Produtos.FieldByName('desconto').AsCurrency +
                  Produtos.FieldByName('valordescontoitem').AsCurrency)> 0 then
                TagCompleta('vDesc',  Produtos.FieldByName('desconto').AsCurrency +
                                      Produtos.FieldByName('valordescontoitem').AsCurrency,2);

              vDespesasAcessorias :=  produtos.FieldByName('despesasacessorias').AsCurrency +
                                      produtos.FieldByName('acrescimo').AsCurrency;

              if produtos.FindField('iivalor')<>nil then
                vDespesasAcessorias := vDespesasAcessorias + produtos.FieldByName('iivalor').AsCurrency;

              if (produtos.findfield('vICMSSTRetDesp')<>nil) {and (tipo = 'S')} then
                 vDespesasAcessorias := vDespesasAcessorias + produtos.fieldbyname('vICMSSTRetDesp').ascurrency;

                 (*
              if (produtos.findfield('valoripi')<>nil) and
                 { eHNotaFiscalSaidaDevolucao(produtos.FieldByName('codigofiscal').AsInteger) and}
                 not ContribuinteIPI {and (tipo = 'S')} then
                 vDespesasAcessorias := vDespesasAcessorias + produtos.fieldbyname('valoripi').ascurrency;
                 *)


              if ehDevolucaoImportacao(produtos) then
                 vDespesasAcessorias := vDespesasAcessorias + produtos.FieldByName('icmsvalor').AsCurrency;

              if (vDespesasAcessorias  > 0 )then
                TagCompleta('vOutro',  vDespesasAcessorias, 2);

              TagCompleta('indTot',  '1');

              if (Importacoes <> nil) and (Importacoes.RecordCount > 0) then
              begin
                AbreTag('DI');
                TagCompleta('nDI',         Importacoes.FieldByName('numero').AsString);
                TagCompleta('dDI',         Importacoes.FieldByName('data').asDateTime, 'yyy-mm-dd');
                TagCompleta('xLocDesemb',  Importacoes.FieldByName('localdesembaraco').AsString);
                TagCompleta('UFDesemb',    Importacoes.FieldByName('UFdesembaraco').AsString);
                TagCompleta('dDesemb',     Importacoes.FieldByName('datadesembaraco').AsDateTime, 'yyy-mm-dd');

                TagCompleta('tpViaTransp', Importacoes.FieldByName('tpviatransp').AsString);
                TagCompleta('vAFRMM',      Importacoes.FieldByName('vAFRMM').AsCurrency,2);
                TagCompleta('tpIntermedio', Importacoes.FieldByName('tpIntermedio').AsString);
                TagCompleta('CNPJ', Importacoes.FieldByName('cnpjadquirente').AsString);
                TagCompleta('UFTerceiro', Importacoes.FieldByName('ufadquirente').AsString);

                TagCompleta('cExportador', Importacoes.FieldByName('exportador').AsString);

                if (Adicoes <> nil)          and
                   (Adicoes.Active)          and
                   (Adicoes.RecordCount > 0) and
                   (Adicoes.Locate('numero', Produtos.FieldByName('adicao').AsInteger, [])) then
                begin
                  AbreTag('adi');
                  TagCompleta('nAdicao',   Produtos.FieldByName('adicao').AsString);
                  TagCompleta('nSeqAdic',  Produtos.FieldByName('nSeqAdicao').AsString);
                  TagCompleta('cFabricante', Adicoes.FieldByName('fabricante').AsString);
                  FechaTag('adi')
                end;

                FechaTag('DI')
              end;


              if (Tipo = 'S') then
              begin
                if ParSistema.ControlesVoltadosparaIndustria then
                begin
                  if notas.FindField('TagAdPedNFE')<>nil then
                  begin
                    if notas.Fieldbyname('TagAdPedNFE').AsBoolean then
                    begin
                      if produtos.FieldByName('pedidocliente').AsString<>'' then
                      begin
                        TagCompleta('xPed', produtos.FieldByName('pedidocliente').AsString);
                        TagCompleta('nItemPed', '10');
                      end;
                    end;
                  end;
                end
                else
                begin
                  if (produtos.FindField('xPed')<>nil) and
                     (produtos.FieldByName('xPed').AsString<>'') then
                  begin
                    TagCompleta('xPed', produtos.FieldByName('xPed').AsString);
                    if produtos.FieldByName('nItemPed').AsString<>'' then
                      TagCompleta('nItemPed', produtos.FieldByName('nItemPed').AsString);
                  end;
                end
              end;

              if (produtos.FindField('fci')<>nil) and
                 (produtos.FieldByName('fci').AsString<>'') then
                TagCompleta('nFCI', produtos.FieldByName('fci').AsString);


              if (produtos.FindField('lote')<>nil) and
                 (produtos.FieldByName('lote').AsString<>'') then
              begin
                AbreTag('rastro');

                TagCompleta('nLote', produtos.FieldByName('nrlote').AsString);
                TagCompleta('qLote', Produtos.FieldByName('quantidade').AsCurrency,3);
                TagCompleta('dFab',  produtos.FieldByName('fabricacao').AsDateTime, 'yyyy-mm-dd');
                TagCompleta('dVal',  produtos.FieldByName('validade').AsDateTime, 'yyyy-mm-dd');

                FechaTag('rastro');
              end;

              FechaTag('prod');

              if (Produtos.FieldByName('incidencia').AsString <> '')  or
                 (Produtos.FieldByName('ipicst').AsString <> '')      or
                 ((Produtos.FindField('IIValor')<>nil) and (importacoes<>nil))  or
                 (Produtos.FieldByName('piscst').AsString <> '')      or
                 (Produtos.FieldByName('cofinscst').AsString <> '')   or
                 (Produtos.FieldByName('csosn').AsString <> '')     then
              begin
                AbreTag('imposto');

                if (produtos.FindField('valorimpostonacional')<>nil) and
                   (produtos.FindField('valorimpostoimportado')<>nil) then
                  TagCompleta('vTotTrib',  (produtos.FieldByName('valorimpostonacional').AsCurrency +
                                            produtos.FieldByName('valorimpostoimportado').AsCurrency),2);

                AbreTag('ICMS');
                local := vlocal_aux+' - ICMS';
                {
                 codigo | valor |                                   descricao
                --------+-------+-------------------------------------------------------------------------------
                      1 | 00    | Tributada integralmente}
                if (Produtos.FieldByName('incidencia').AsString = ctTRIBUTADA) and
                  (FEmit_CRT in [2,3])  then { Regime Tributário 2: Simples Excedente 3: Normal}
                begin
                  AbreTag('ICMS00');
                  TagCompleta('orig',  Produtos.FieldByName('origem').AsString);
                  TagCompleta('CST',   Produtos.FieldByName('incidencia').AsString);
                  TagCompleta('modBC', Produtos.FieldByName('ICMSModalidade').AsString);
                  if Produtos.FieldByName('aliquotaicms').AsCurrency >= 0 then
                  begin
                    TagCompleta('vBC',   Produtos.FieldByName('icmsbasecalculo').AsCurrency,2);

                    if (Produtos.FieldByName('icmsbasecalculo').AsCurrency = 0) and
                       (Notas.FieldByName('finalidadenf').AsString<>'2')  then
                    begin
                      TagCompleta('pICMS', 0,2);
                      TagCompleta('vICMS', 0,2);
//                      TagCompleta('pFCP', 0,2);
//                      TagCompleta('vFCP', 0,2);
                    end
                    else
                    begin
                      TagCompleta('pICMS', Produtos.FieldByName('aliquotaicms').AsCurrency,2);
                      TagCompleta('vICMS', Produtos.FieldByName('icmsvalor').AsCurrency,2);
                    end;

                  end
                  else
                  begin
                    TagCompleta('vBC',   0,2);
                    TagCompleta('pICMS', 0,2);
                    TagCompleta('vICMS', 0,2);
//                    TagCompleta('pFCP', 0,2);
//                    TagCompleta('vFCP', 0,2);
                  end;

                  if Produtos.FieldByName('pFCP').AsCurrency <> 0 then
                  begin
                    TagCompleta('pFCP', Produtos.FieldByName('pFCP').AsCurrency,2);
                    TagCompleta('vFCP', Produtos.FieldByName('vFCP').AsCurrency,2);
                  end;

                  FechaTag('ICMS00')
                end
                else
{
                     codigo | valor |                                   descricao
                    --------+-------+-------------------------------------------------------------------------------
                          2 | 10    | Tributada e com cobrança do ICMS por substituição tributária
}
                if (Produtos.FieldByName('incidencia').AsString = ctTRIBUTADASUBSTITUICAO) and
                   (FEmit_CRT in [2,3])  then { Regime Tributário 2: Simples Excedente 3: Normal}

                begin
                  AbreTag('ICMS10');
                  TagCompleta('orig',    Produtos.FieldByName('origem').AsString);
                  TagCompleta('CST',     Produtos.FieldByName('incidencia').AsString);
                  TagCompleta('modBC',   Produtos.FieldByName('ICMSModalidade').AsString);

                  if Produtos.FieldByName('aliquotaicms').AsCurrency >= 0 then
                  begin
                    TagCompleta('vBC',   Produtos.FieldByName('icmsbasecalculo').AsCurrency,2);

                    if (Produtos.FieldByName('icmsbasecalculo').AsCurrency = 0) and
                       (Notas.FieldByName('finalidadenf').AsString<>'2')  then
                    begin
                      TagCompleta('pICMS', 0,2);
                      TagCompleta('vICMS', 0,2);
//                      TagCompleta('vBCFCP', 0,2);
//                      TagCompleta('pFCP', 0,2);
//                      TagCompleta('vFCP', 0,2);
                    end
                    else
                    begin
                      TagCompleta('pICMS', Produtos.FieldByName('aliquotaicms').AsCurrency,2);
                      TagCompleta('vICMS', Produtos.FieldByName('icmsvalor').AsCurrency,2);
                    end;

                  end
                  else
                  begin
                    TagCompleta('vBC',   0,2);
                    TagCompleta('pICMS', 0,2);
                    TagCompleta('vICMS', 0,2);
//                    TagCompleta('vBCFCP', 0,2);
//                    TagCompleta('pFCP', 0,2);
//                    TagCompleta('vFCP', 0,2);
                  end;

                  if Produtos.FieldByName('pFCP').AsCurrency <> 0 then
                  begin
                    TagCompleta('vBCFCP', Produtos.FieldByName('vBCFCP').AsCurrency,2);
                    TagCompleta('pFCP', Produtos.FieldByName('pFCP').AsCurrency,2);
                    TagCompleta('vFCP', Produtos.FieldByName('vFCP').AsCurrency,2);
                  end;


                  TagCompleta('modBCST', Produtos.FieldByName('ICMSModSubst').AsString);

                  if produtos.FieldByName('fatorsubstituicao').AsCurrency > 1 then
                     TagCompleta('pMVAST', truncar((produtos.FieldByName('fatorsubstituicao').AsCurrency - 1) * 100,2),2)
                  else
                     TagCompleta('pMVAST', 0.00, 2);

                  if produtos.FieldByName('pRedBCST').AsCurrency > 0 then
                     TagCompleta('pRedBCST', produtos.FieldByName('pRedBCST').AsCurrency,2);

                  TagCompleta('vBCST',   Produtos.FieldByName('ICMSBaseCalculoST').AsCurrency,2);
                  TagCompleta('pICMSST', Produtos.FieldByName('AliquotaICMSST').AsCurrency,2);
                  TagCompleta('vICMSST', Produtos.FieldByName('IcmsValorST').AsCurrency,2);

                  if Produtos.FieldByName('pFCPST').AsCurrency <> 0 then
                  begin
                    TagCompleta('vBCFCPST', Produtos.FieldByName('vBCFCPST').AsCurrency,2);
                    TagCompleta('pFCPST', Produtos.FieldByName('pFCPST').AsCurrency,2);
                    TagCompleta('vFCPST', Produtos.FieldByName('vFCPST').AsCurrency,2);
                  end;

                  FechaTag('ICMS10')
                end
                else
{
                     codigo | valor |                                   descricao
                    --------+-------+-------------------------------------------------------------------------------
                          3 | 20    | Com redução de base de cálculo
}

                if (Produtos.FieldByName('incidencia').AsString = ctREDUCAOBASE) and
                  (FEmit_CRT in [2,3])  then { Regime Tributário 2: Simples Excedente 3: Normal}
                begin
                  AbreTag('ICMS20');
                  TagCompleta('orig',   Produtos.FieldByName('origem').AsString);
                  TagCompleta('CST',    Produtos.FieldByName('incidencia').AsString);
                  TagCompleta('modBC',  Produtos.FieldByName('ICMSModalidade').AsString);
                  TagCompleta('pRedBC', Produtos.FieldByName('percentualreducaobase').AsCurrency,2);

                  if Produtos.FieldByName('aliquotaicms').AsCurrency >= 0 then
                  begin
                    TagCompleta('vBC',   Produtos.FieldByName('icmsbasecalculo').AsCurrency,2);

                    if (Produtos.FieldByName('icmsbasecalculo').AsCurrency = 0) and
                       (Notas.FieldByName('finalidadenf').AsString<>'2')  then
                    begin
                      TagCompleta('pICMS', 0,2);
                      TagCompleta('vICMS', 0,2);
//                      TagCompleta('vBCFCP', 0,2);
//                      TagCompleta('pFCP', 0,2);
//                      TagCompleta('vFCP', 0,2);
                    end
                    else
                    begin
                      TagCompleta('pICMS', Produtos.FieldByName('aliquotaicms').AsCurrency,2);
                      TagCompleta('vICMS', Produtos.FieldByName('icmsvalor').AsCurrency,2);

                    end;

                  end
                  else
                  begin
                    TagCompleta('vBC',   0,2);
                    TagCompleta('pICMS', 0,2);
                    TagCompleta('vICMS', 0,2);
//                    TagCompleta('vBCFCP', 0,2);
//                    TagCompleta('pFCP', 0,2);
//                    TagCompleta('vFCP', 0,2);
                  end;

                  if Produtos.FieldByName('pFCP').AsCurrency <> 0 then
                  begin
                    TagCompleta('vBCFCP', Produtos.FieldByName('vBCFCP').AsCurrency,2);
                    TagCompleta('pFCP', Produtos.FieldByName('pFCP').AsCurrency,2);
                    TagCompleta('vFCP', Produtos.FieldByName('vFCP').AsCurrency,2);
                  end;

                  FechaTag('ICMS20')
                end
                else



{
                     codigo | valor |                                   descricao
                    --------+-------+-------------------------------------------------------------------------------
                          4 | 30    | Isenta ou não tributada e com cobrança do ICMS por substituição tributária
}
                if (Produtos.FieldByName('incidencia').AsString = ctISENTASUBSTITUICAO) and
                   (FEmit_CRT in [2,3])  then { Regime Tributário 2: Simples Excedente 3: Normal}
                begin
                  AbreTag('ICMS30');
                  TagCompleta('orig',    Produtos.FieldByName('origem').AsString);
                  TagCompleta('CST',     Produtos.FieldByName('incidencia').AsString);
                  TagCompleta('modBCST', Produtos.FieldByName('ICMSModSubst').AsString);
                  if produtos.FieldByName('fatorsubstituicao').AsCurrency > 1 then
                    TagCompleta('pMVAST', truncar((produtos.FieldByName('fatorsubstituicao').AsCurrency - 1) * 100,2),2)
                  else
                    TagCompleta('pMVAST', 0.00, 2);

                  if produtos.FieldByName('pRedBCST').AsCurrency > 0 then
                     TagCompleta('pRedBCST', produtos.FieldByName('pRedBCST').AsCurrency,2);

                  TagCompleta('vBCST',   Produtos.FieldByName('ICMSBaseCalculoST').AsCurrency,2);
                  TagCompleta('pICMSST', Produtos.FieldByName('AliquotaICMSST').AsCurrency,2);
                  TagCompleta('vICMSST', Produtos.FieldByName('IcmsValorST').AsCurrency,2);

                  if Produtos.FieldByName('pFCPST').AsCurrency <> 0 then
                  begin
                    TagCompleta('vBCFCPST', Produtos.FieldByName('vBCFCPST').AsCurrency,2);
                    TagCompleta('pFCPST', Produtos.FieldByName('pFCPST').AsCurrency,2);
                    TagCompleta('vFCPST', Produtos.FieldByName('vFCPST').AsCurrency,2);
                  end;

                  FechaTag('ICMS30')
                end
                else
{
                     codigo | valor |                                   descricao
                    --------+-------+-------------------------------------------------------------------------------
                          5 | 40    | Isenta
                          6 | 41    | Não tributada
                          7 | 50    | Suspensão
}
                if ((Produtos.FieldByName('incidencia').AsString = ctISENTA) or
                    (Produtos.FieldByName('incidencia').AsString = ctNAOTRIBUTADA) or
                    (Produtos.FieldByName('incidencia').AsString = ctSUSPENSAO)) and
                   (FEmit_CRT in [2,3])  then { Regime Tributário 2: Simples Excedente 3: Normal}
                begin
                  AbreTag('ICMS40');
                  TagCompleta('orig', Produtos.FieldByName('origem').AsString);
                  TagCompleta('CST',  Produtos.FieldByName('incidencia').AsString);
                  FechaTag('ICMS40')
                end
                else
{
                     codigo | valor |                                   descricao
                    --------+-------+-------------------------------------------------------------------------------
                          8 | 51    | Diferimento
}

                if (Produtos.FieldByName('incidencia').AsString = ctDIFERIMENTO) and
                   (FEmit_CRT in [2,3])  then { Regime Tributário 2: Simples Excedente 3: Normal}
                begin
                  AbreTag('ICMS51');
                  TagCompleta('orig',   Produtos.FieldByName('origem').AsString);
                  TagCompleta('CST',    Produtos.FieldByName('incidencia').AsString);
                  TagCompleta('modBC',  Produtos.FieldByName('ICMSModalidade').AsString);
                  if Produtos.FieldByName('percentualreducaobase').AsCurrency > 0 then
                    TagCompleta('pRedBC', Produtos.FieldByName('percentualreducaobase').AsCurrency,2);

                  if Produtos.FieldByName('icmsbasecalculo').AsCurrency > 0 then
                    TagCompleta('vBC',    Produtos.FieldByName('icmsbasecalculo').AsCurrency,2);
                  if Produtos.FieldByName('aliquotaicms').AsCurrency > 0 then
                  begin
                    if (Produtos.FieldByName('icmsbasecalculo').AsCurrency = 0) and
                       (Notas.FieldByName('finalidadenf').AsString<>'2')  then
                      TagCompleta('pICMS', 0,2)
                    else
                      TagCompleta('pICMS', Produtos.FieldByName('aliquotaicms').AsCurrency,2);
                  end;

                  if Produtos.FieldByName('vicmsop').AsCurrency > 0 then
                  begin
                    TagCompleta('vICMSOp', Produtos.FieldByName('vicmsop').AsCurrency,2);
                    TagCompleta('pDif',  Produtos.FieldByName('pdif').AsCurrency,4);
                    TagCompleta('vICMSDif', Produtos.FieldByName('vicmsdif').AsCurrency, 2);
                    TagCompleta('vICMS',  Produtos.FieldByName('icmsvalor').AsCurrency,2);

                    if Produtos.FieldByName('pFCP').AsCurrency <> 0 then
                    begin
                      TagCompleta('vBCFCP', Produtos.FieldByName('vBCFCP').AsCurrency,2);
                      TagCompleta('pFCP', Produtos.FieldByName('pFCP').AsCurrency,2);
                      TagCompleta('vFCP', Produtos.FieldByName('vFCP').AsCurrency,2);
                    end;

                  end;

                  FechaTag('ICMS51')
                end
                else

{
                     codigo | valor |                                   descricao
                    --------+-------+-------------------------------------------------------------------------------
                          9 | 60    | ICMS cobrado anteriormente por substituição tributária
}

                if (Produtos.FieldByName('incidencia').AsString = ctCOBRADOSUSTITUICAO) and
                   (FEmit_CRT in [2,3])  then { Regime Tributário 2: Simples Excedente 3: Normal}
                begin
                  AbreTag('ICMS60');
                  TagCompleta('orig',    Produtos.FieldByName('origem').AsString);
                  TagCompleta('CST',     Produtos.FieldByName('incidencia').AsString);
                  TagCompleta('vBCSTRet',   Produtos.FieldByName('vBCSTRet').AsCurrency,2);
                  TagCompleta('pST',   Produtos.FieldByName('pST').AsCurrency,2);

                  if not f_IndFinal then {não é consumidor final}
                    TagCompleta('vICMSSubstituto', 0,2);

                  TagCompleta('vICMSSTRet', Produtos.FieldByName('vICMSSTRet').AsCurrency,2);


                  if Produtos.FieldByName('pFCPSTRet').AsCurrency <> 0 then
                  begin
                    TagCompleta('vBCFCPSTRet', Produtos.FieldByName('vBCFCPSTRet').AsCurrency,2);
                    TagCompleta('pFCPSTRet', Produtos.FieldByName('pFCPSTRet').AsCurrency,2);
                    TagCompleta('vFCPSTRet', Produtos.FieldByName('vFCPSTRet').AsCurrency,2);
                  end;

                  FechaTag('ICMS60')

                end
                else
{
                     codigo | valor |                                   descricao
                    --------+-------+-------------------------------------------------------------------------------
                         10 | 70    | Com redução de base de cálculo e cobrança do ICMS por substituição tributária
}

                if (Produtos.FieldByName('incidencia').AsString = ctREDUCAOBASESUBSTITUICAO) and
                   (FEmit_CRT in [2,3])  then { Regime Tributário 2: Simples Excedente 3: Normal}
                begin
                  AbreTag('ICMS70');
                  TagCompleta('orig',    Produtos.FieldByName('origem').AsString);
                  TagCompleta('CST',     Produtos.FieldByName('incidencia').AsString);
                  TagCompleta('modBC',   Produtos.FieldByName('ICMSModalidade').AsString);
                  if Produtos.FieldByName('percentualreducaobase').AsCurrency > 0 then
                    TagCompleta('pRedBC', Produtos.FieldByName('percentualreducaobase').AsCurrency,2);

                  if Produtos.FieldByName('aliquotaicms').AsCurrency >= 0 then
                  begin
                    TagCompleta('vBC',   Produtos.FieldByName('icmsbasecalculo').AsCurrency,2);

                    if (Produtos.FieldByName('icmsbasecalculo').AsCurrency = 0) and
                       (Notas.FieldByName('finalidadenf').AsString<>'2')  then
                    begin
                      TagCompleta('pICMS', 0,2);
                      TagCompleta('vICMS', 0,2);
//                      TagCompleta('vBCFCP', 0,2);
//                      TagCompleta('pFCP', 0,2);
//                      TagCompleta('vFCP', 0,2);
                    end
                    else
                    begin
                      TagCompleta('pICMS', Produtos.FieldByName('aliquotaicms').AsCurrency,2);
                      TagCompleta('vICMS', Produtos.FieldByName('icmsvalor').AsCurrency,2);
                    end;

                  end
                  else
                  begin
                    TagCompleta('vBC',   0,2);
                    TagCompleta('pICMS', 0,2);
                    TagCompleta('vICMS', 0,2);
//                    TagCompleta('vBCFCP', 0,2);
//                    TagCompleta('pFCP', 0,2);
//                    TagCompleta('vFCP', 0,2);
                  end;

                  if Produtos.FieldByName('pFCP').AsCurrency <> 0 then
                  begin
                    TagCompleta('vBCFCP', Produtos.FieldByName('vBCFCP').AsCurrency,2);
                    TagCompleta('pFCP', Produtos.FieldByName('pFCP').AsCurrency,2);
                    TagCompleta('vFCP', Produtos.FieldByName('vFCP').AsCurrency,2);
                  end;

                  TagCompleta('modBCST', Produtos.FieldByName('ICMSModSubst').AsString);

                  if produtos.FieldByName('fatorsubstituicao').AsCurrency > 1 then
                     TagCompleta('pMVAST', truncar((produtos.FieldByName('fatorsubstituicao').AsCurrency - 1) * 100,2),2)
                   else
                     TagCompleta('pMVAST', 0.00, 2);

                  if produtos.FieldByName('pRedBCST').AsCurrency > 0 then
                     TagCompleta('pRedBCST', produtos.FieldByName('pRedBCST').AsCurrency,2);

                  TagCompleta('vBCST',   Produtos.FieldByName('ICMSBaseCalculoST').AsCurrency,2);
                  TagCompleta('pICMSST', Produtos.FieldByName('AliquotaICMSST').AsCurrency,2);
                  TagCompleta('vICMSST', Produtos.FieldByName('IcmsValorST').AsCurrency,2);

                  if Produtos.FieldByName('pFCPST').AsCurrency <> 0 then
                  begin
                    TagCompleta('vBCFCPST', Produtos.FieldByName('vBCFCPST').AsCurrency,2);
                    TagCompleta('pFCPST', Produtos.FieldByName('pFCPST').AsCurrency,2);
                    TagCompleta('vFCPST', Produtos.FieldByName('vFCPST').AsCurrency,2);
                  end;  

                  FechaTag('ICMS70')
                end
                else
{
                     codigo | valor |                                   descricao
                    --------+-------+-------------------------------------------------------------------------------
                         11 | 90    | Outros
}
                if (Produtos.FieldByName('incidencia').AsString = ctOUTROS) and
                   (FEmit_CRT in [2,3])  then { Regime Tributário 2: Simples Excedente 3: Normal}
                begin
                  AbreTag('ICMS90');
                  TagCompleta('orig',   Produtos.FieldByName('origem').AsString);
                  TagCompleta('CST',    Produtos.FieldByName('incidencia').AsString);
                  TagCompleta('modBC',  Produtos.FieldByName('ICMSModalidade').AsString);


                  if Produtos.FieldByName('aliquotaicms').AsCurrency >= 0 then
                  begin
                    TagCompleta('vBC',   Produtos.FieldByName('icmsbasecalculo').AsCurrency,2);

                    if (Produtos.FieldByName('icmsbasecalculo').AsCurrency = 0) and
                       (Notas.FieldByName('finalidadenf').AsString<>'2')  then
                    begin
                      if Produtos.FieldByName('percentualreducaobase').AsCurrency > 0 then
                         TagCompleta('pRedBC', Produtos.FieldByName('percentualreducaobase').AsCurrency,2);
                      TagCompleta('pICMS', 0,2);
                      TagCompleta('vICMS', 0,2);
//                      TagCompleta('vBCFCP', 0,2);
//                      TagCompleta('pFCP', 0,2);
//                      TagCompleta('vFCP', 0,2);
                    end
                    else
                    begin
                      if Produtos.FieldByName('percentualreducaobase').AsCurrency > 0 then
                         TagCompleta('pRedBC', Produtos.FieldByName('percentualreducaobase').AsCurrency,2);
                      TagCompleta('pICMS', Produtos.FieldByName('aliquotaicms').AsCurrency,2);
                      TagCompleta('vICMS', Produtos.FieldByName('icmsvalor').AsCurrency,2);
                    end;


                  end
                  else
                  begin
                    TagCompleta('vBC',   0,2);
                    if Produtos.FieldByName('percentualreducaobase').AsCurrency > 0 then
                       TagCompleta('pRedBC', Produtos.FieldByName('percentualreducaobase').AsCurrency,2);
                    TagCompleta('pICMS', 0,2);
                    TagCompleta('vICMS', 0,2);
//                    TagCompleta('vBCFCP', 0,2);
//                    TagCompleta('pFCP', 0,2);
//                    TagCompleta('vFCP', 0,2);
                  end;

                  if Produtos.FieldByName('pFCP').AsCurrency <> 0 then
                  begin
                    TagCompleta('vBCFCP', Produtos.FieldByName('vBCFCP').AsCurrency,2);
                    TagCompleta('pFCP', Produtos.FieldByName('pFCP').AsCurrency,2);
                    TagCompleta('vFCP', Produtos.FieldByName('vFCP').AsCurrency,2);
                  end;




                  TagCompleta('modBCST', Produtos.FieldByName('ICMSModSubst').AsString);

                  if produtos.FieldByName('fatorsubstituicao').AsCurrency > 1 then
                     TagCompleta('pMVAST', truncar((produtos.FieldByName('fatorsubstituicao').AsCurrency - 1) * 100,2),2)
                  else
                     TagCompleta('pMVAST', 0.00, 2);

                  if produtos.FieldByName('pRedBCST').AsCurrency > 0 then
                     TagCompleta('pRedBCST', produtos.FieldByName('pRedBCST').AsCurrency,2);

                  TagCompleta('vBCST',   Produtos.FieldByName('ICMSBaseCalculoST').AsCurrency,2);
                  TagCompleta('pICMSST', Produtos.FieldByName('AliquotaICMSST').AsCurrency,2);
                  TagCompleta('vICMSST', Produtos.FieldByName('IcmsValorST').AsCurrency,2);

                  if Produtos.FieldByName('pFCPST').AsCurrency <> 0 then
                  begin
                    TagCompleta('vBCFCPST', Produtos.FieldByName('vBCFCPST').AsCurrency,2);
                    TagCompleta('pFCPST', Produtos.FieldByName('pFCPST').AsCurrency,2);
                    TagCompleta('vFCPST', Produtos.FieldByName('vFCPST').AsCurrency,2);
                  end;

                  FechaTag('ICMS90')
                end
                else
                if (Produtos.FieldByName('incidencia').AsString = '') and
                   (FEmit_CRT in [2,3])  then { Regime Tributário 2: Simples Excedente 3: Normal}
                  ValidarTag('CST','')
                else
                if (FEmit_CRT = 1) and { Regime Tributário 1: Simples}
                   (Produtos.FieldByName('csosn').AsString = '101') then {com Permissão de crédito}
                begin
                  AbreTag('ICMSSN101');
                  TagCompleta('orig',    Produtos.FieldByName('origem').AsString);
                  TagCompleta('CSOSN',   Produtos.FieldByName('csosn').AsString);
                  TagCompleta('pCredSN', Produtos.FieldByName('pCredSN').AsCurrency,2);
                  TagCompleta('vCredICMSSN', Produtos.FieldByName('vCredICMSSN').AsCurrency,2);
                  FechaTag('ICMSSN101');
                end
                else
                if (FEmit_CRT = 1) and { Regime Tributário 1: Simples}
                   ((Produtos.FieldByName('csosn').AsString = '102') or  {Tributada pelo Simples Nacional sem permissão de crédito}
                    (Produtos.FieldByName('csosn').AsString = '103') or  {Isenção do ICMS no Simples Nacional para faixa de receita bruta}
                    (Produtos.FieldByName('csosn').AsString = '300') or  {imune}
                    (Produtos.FieldByName('csosn').AsString = '400')) then {não tributada pelo simples nacional}
                begin
                  AbreTag('ICMSSN102');
                  TagCompleta('orig',    Produtos.FieldByName('origem').AsString);
                  TagCompleta('CSOSN',   Produtos.FieldByName('csosn').AsString);
                  FechaTag('ICMSSN102');
                end
                else
                if (FEmit_CRT = 1) and { Regime Tributário 1: Simples}
                   (Produtos.FieldByName('csosn').AsString = '201') then {Tributada pelo Simples Nacional com permissão de crédito e com cobrança do ICMS por substituição tributária}
                begin
                  AbreTag('ICMSSN201');
                  TagCompleta('orig',    Produtos.FieldByName('origem').AsString);
                  TagCompleta('CSOSN',   Produtos.FieldByName('csosn').AsString);

                  TagCompleta('modBCST', Produtos.FieldByName('ICMSModSubst').AsString);

                  if Produtos.FieldByName('fatorsubstituicao').AsCurrency > 1 then
                     TagCompleta('pMVAST', truncar((Produtos.FieldByName('fatorsubstituicao').AsCurrency - 1) * 100,2),2)
                  else
                     TagCompleta('pMVAST', 0.00, 2);

                  if Produtos.FieldByName('pRedBCST').AsCurrency > 0 then
                     TagCompleta('pRedBCST', Produtos.FieldByName('pRedBCST').AsCurrency,2);

                  TagCompleta('vBCST',   Produtos.FieldByName('ICMSBaseCalculoST').AsCurrency,2);
                  TagCompleta('pICMSST', Produtos.FieldByName('AliquotaICMSST').AsCurrency,2);
                  TagCompleta('vICMSST', Produtos.FieldByName('IcmsValorST').AsCurrency,2);

                  if Produtos.FieldByName('pFCPST').AsCurrency <> 0 then
                  begin
                    TagCompleta('vBCFCPST', Produtos.FieldByName('vBCFCPST').AsCurrency,2);
                    TagCompleta('pFCPST', Produtos.FieldByName('pFCPST').AsCurrency,2);
                    TagCompleta('vFCPST', Produtos.FieldByName('vFCPST').AsCurrency,2);
                  end;

                  TagCompleta('pCredSN', Produtos.FieldByName('pCredSN').AsCurrency,2);
                  TagCompleta('vCredICMSSN', Produtos.FieldByName('vCredICMSSN').AsCurrency,2);

                  FechaTag('ICMSSN201');
                end
                else
                if (FEmit_CRT = 1) and { Regime Tributário 1: Simples}
                   ((Produtos.FieldByName('csosn').AsString = '202') or    {Tributada pelo Simples Nacional sem permissão de crédito e com cobrança do ICMS por substituição tributária}
                    (Produtos.FieldByName('csosn').AsString = '203')) then {Isenção do ICMS no Simples Nacional para faixa de receita bruta e com cobrança do ICMS por substituição tributária}
                begin
                  AbreTag('ICMSSN202');
                  TagCompleta('orig',    Produtos.FieldByName('origem').AsString);
                  TagCompleta('CSOSN',   Produtos.FieldByName('csosn').AsString);

                  TagCompleta('modBCST', Produtos.FieldByName('ICMSModSubst').AsString);

                  if Produtos.FieldByName('fatorsubstituicao').AsCurrency > 1 then
                     TagCompleta('pMVAST', truncar((Produtos.FieldByName('fatorsubstituicao').AsCurrency - 1) * 100,2),2)
                  else
                     TagCompleta('pMVAST', 0.00, 2);

                  if Produtos.FieldByName('pRedBCST').AsCurrency > 0 then
                     TagCompleta('pRedBCST', Produtos.FieldByName('pRedBCST').AsCurrency,2);

                  TagCompleta('vBCST',   Produtos.FieldByName('ICMSBaseCalculoST').AsCurrency,2);
                  TagCompleta('pICMSST', Produtos.FieldByName('AliquotaICMSST').AsCurrency,2);
                  TagCompleta('vICMSST', Produtos.FieldByName('IcmsValorST').AsCurrency,2);

                  if Produtos.FieldByName('pFCPST').AsCurrency <> 0 then
                  begin
                    TagCompleta('vBCFCPST', Produtos.FieldByName('vBCFCPST').AsCurrency,2);
                    TagCompleta('pFCPST', Produtos.FieldByName('pFCPST').AsCurrency,2);
                    TagCompleta('vFCPST', Produtos.FieldByName('vFCPST').AsCurrency,2);
                  end;

                  FechaTag('ICMSSN202');

                end
                else
                if (FEmit_CRT = 1) and { Regime Tributário 1: Simples}
                   (Produtos.FieldByName('csosn').AsString = '500') then {ICMS cobrado anteriormente por substituição tributária (substituído) ou por antecipação}
                begin
                  AbreTag('ICMSSN500');
                  TagCompleta('orig',    Produtos.FieldByName('origem').AsString);
                  TagCompleta('CSOSN',     Produtos.FieldByName('csosn').AsString);
                  TagCompleta('vBCSTRet',   Produtos.FieldByName('vBCSTRet').AsCurrency,2);
                  TagCompleta('pST',   Produtos.FieldByName('pST').AsCurrency,2);

                  if not f_IndFinal then {não é consumidor final}
                    TagCompleta('vICMSSubstituto', 0,2);

                  TagCompleta('vICMSSTRet', Produtos.FieldByName('vICMSSTRet').AsCurrency,2);

                  if Produtos.FieldByName('pFCPSTRet').AsCurrency <> 0 then
                  begin
                    TagCompleta('vBCFCPSTRet', Produtos.FieldByName('vBCFCPSTRet').AsCurrency,2);
                    TagCompleta('pFCPSTRet', Produtos.FieldByName('pFCPSTRet').AsCurrency,2);
                    TagCompleta('vFCPSTRet', Produtos.FieldByName('vFCPSTRet').AsCurrency,2);
                  end;

                  FechaTag('ICMSSN500')
                end
                else
                if (FEmit_CRT = 1) and { Regime Tributário 1: Simples}
                   (Produtos.FieldByName('csosn').AsString = '900') then {Outros}
                begin

                  AbreTag('ICMSSN900');
                  TagCompleta('orig',    Produtos.FieldByName('origem').AsString);
                  TagCompleta('CSOSN',   Produtos.FieldByName('csosn').AsString);

                  TagCompleta('modBC',  Produtos.FieldByName('ICMSModalidade').AsString);
                  TagCompleta('vBC',    Produtos.FieldByName('icmsbasecalculo').AsCurrency,2);

                  if Produtos.FieldByName('percentualreducaobase').AsCurrency > 0 then
                    TagCompleta('pRedBC', Produtos.FieldByName('percentualreducaobase').AsCurrency,2);

                  if (Produtos.FieldByName('icmsbasecalculo').AsCurrency = 0) and
                     (Notas.FieldByName('finalidadenf').AsString<>'2')  then
                    TagCompleta('pICMS', 0,2)
                  else
                    TagCompleta('pICMS', Produtos.FieldByName('aliquotaicms').AsCurrency,2);

                  TagCompleta('vICMS',  Produtos.FieldByName('icmsvalor').AsCurrency,2);


                  TagCompleta('modBCST', Produtos.FieldByName('ICMSModSubst').AsString);

                  if Produtos.FieldByName('fatorsubstituicao').AsCurrency > 1 then
                     TagCompleta('pMVAST', truncar((Produtos.FieldByName('fatorsubstituicao').AsCurrency - 1) * 100,2),2)
                  else
                     TagCompleta('pMVAST', 0.00, 2);

                  if Produtos.FieldByName('pRedBCST').AsCurrency > 0 then
                     TagCompleta('pRedBCST', Produtos.FieldByName('pRedBCST').AsCurrency,2);

                  TagCompleta('vBCST',   Produtos.FieldByName('ICMSBaseCalculoST').AsCurrency,2);
                  TagCompleta('pICMSST', Produtos.FieldByName('AliquotaICMSST').AsCurrency,2);
                  TagCompleta('vICMSST', Produtos.FieldByName('IcmsValorST').AsCurrency,2);

                  if Produtos.FieldByName('pFCPST').AsCurrency <> 0 then
                  begin
                    TagCompleta('vBCFCPST', Produtos.FieldByName('vBCFCPST').AsCurrency,2);
                    TagCompleta('pFCPST', Produtos.FieldByName('pFCPST').AsCurrency,2);
                    TagCompleta('vFCPST', Produtos.FieldByName('vFCPST').AsCurrency,2);
                  end;

                  TagCompleta('pCredSN', Produtos.FieldByName('pCredSN').AsCurrency,2);
                  TagCompleta('vCredICMSSN', Produtos.FieldByName('vCredICMSSN').AsCurrency,2);

                  FechaTag('ICMSSN900');

                end
                else
                if (Produtos.FieldByName('incidencia').AsString = '') and
                   (FEmit_CRT = 1)  then { Regime Tributário 1: Simples}
                  ValidarTag('CSOSN','');

                FechaTag('ICMS');


                local := vlocal_aux+' - IPI';

               // if ((FEmit_CRT in [2,3]) or (Produtos.FieldByName('valoripi').AsCurrency>0)) then { Regime Tributário 2: Simples Excedente 3: Normal}
                begin
                  if (Produtos.FieldByName('IPICST').AsString <> '')

                       and (  ContribuinteIPI
                               or (not contribuinteIPI and
                                   (
                                    eHImportacao
                                    or ( not ((Notas.FieldByName('finalidadenf').AsString)='4')
                                         and ((Notas.FieldByName('valoripi').AsCurrency) <> 0))

                                   )) ) then




                  begin
                    AbreTag('IPI');
      {                    TagCompleta('clEnq', Produtos.FieldByName('').AsString);
                      TagCompleta('CNPJProd', Produtos.FieldByName('').AsString);
                      TagCompleta('cSelo', Produtos.FieldByName('').AsString);
                      TagCompleta('qSelo', Produtos.FieldByName('').AsString);
      }             TagCompleta('cEnq', Copy(Produtos.FieldByName('enquadramento').AsString,1,3));
                    if (Produtos.FieldByName('IPICST').AsString = '00') or
                       (Produtos.FieldByName('IPICST').AsString = '49') or
                       (Produtos.FieldByName('IPICST').AsString = '50') or
                       (Produtos.FieldByName('IPICST').AsString = '99') then
                    begin
                      AbreTag('IPITrib');
                      TagCompleta('CST',   Produtos.FieldByName('ipicst').AsString);
                      TagCompleta('vBC',   Produtos.FieldByName('ipibasecalculo').AsCurrency,2);
    //                      TagCompleta('qUnid', Produtos.FieldByName('').AsCurrency,4);
    //                      TagCompleta('vUnid', Produtos.FieldByName('').AsCurrency,4);
                      TagCompleta('pIPI',  Produtos.FieldByName('aliquotaipi').AsCurrency,2);
                      TagCompleta('vIPI',  Produtos.FieldByName('valoripi').AsCurrency,2);
                      FechaTag('IPITrib')
                    end
                    else
                    if (Produtos.FieldByName('IPICST').AsString = '01') or
                       (Produtos.FieldByName('IPICST').AsString = '02') or
                       (Produtos.FieldByName('IPICST').AsString = '03') or
                       (Produtos.FieldByName('IPICST').AsString = '04') or
                       (Produtos.FieldByName('IPICST').AsString = '05') or
                       (Produtos.FieldByName('IPICST').AsString = '51') or
                       (Produtos.FieldByName('IPICST').AsString = '52') or
                       (Produtos.FieldByName('IPICST').AsString = '53') or
                       (Produtos.FieldByName('IPICST').AsString = '54') or
                       (Produtos.FieldByName('IPICST').AsString = '55') then
                    begin
                      AbreTag('IPINT');
                      TagCompleta('CST', Produtos.FieldByName('ipicst').AsString);
                      FechaTag('IPINT')
                    end;
                    FechaTag('IPI')
                  end;
                end;

                if ((Produtos.FindField('IIValor')<>nil) and (importacoes<>nil)) then
                begin
                  AbreTag('II');
                  TagCompleta('vBC',      Produtos.FieldByName('iibasecalculo').AsCurrency,2);
                  TagCompleta('vDespAdu', Produtos.FieldByName('iidespaduaneira').AsCurrency,2);
                  TagCompleta('vII',      Produtos.FieldByName('iivalor').AsCurrency,2);
                  TagCompleta('vIOF',     Produtos.FieldByName('iiIOF').AsCurrency,2);
                  FechaTag('II')
                end;

                local := vlocal_aux+' - PIS';
                AbreTag('PIS');
                if (Produtos.FieldByName('PISCST').AsString = '01') or
                   (Produtos.FieldByName('PISCST').AsString = '02') then
                begin
                  AbreTag('PISAliq');
                  TagCompleta('CST',  Produtos.FieldByName('piscst').AsString);
                  TagCompleta('vBC',  Produtos.FieldByName('pisbasecalculo').AsCurrency,2);

                  if Produtos.FieldByName('pisbasecalculo').AsCurrency <> 0 then
                    TagCompleta('pPIS', Produtos.FieldByName('pisaliquota').AsCurrency,2)
                  else
                    TagCompleta('pPIS', 0.00, 2);

                  TagCompleta('vPIS', Produtos.FieldByName('pisvalor').AsCurrency,2);
                  FechaTag('PISAliq')
                end
                else
                if (Produtos.FieldByName('PISCST').AsString = '03') then
                begin
                  {Código não preparado para esta modalidade}
                  AbreTag('PISQtde');
                  TagCompleta('CST',  Produtos.FieldByName('piscst').AsString);
  //              TagCompleta('vBCProd', Produtos.FieldByName('').AsCurrency,4);
  //              TagCompleta('vAliqProd', Produtos.FieldByName('').AsCurrency,4);
                  TagCompleta('vPIS', Produtos.FieldByName('pisvalor').AsCurrency,2);
                  FechaTag('PISQtde')
                end
                else
                if (Produtos.FieldByName('PISCST').AsString = '04') or
                   (Produtos.FieldByName('PISCST').AsString = '06') or
                   (Produtos.FieldByName('PISCST').AsString = '07') or
                   (Produtos.FieldByName('PISCST').AsString = '08') or
                   (Produtos.FieldByName('PISCST').AsString = '09') then
                begin
                  AbreTag('PISNT');
                  TagCompleta('CST', Produtos.FieldByName('piscst').AsString);
                  FechaTag('PISNT')
                end
                else
                if (Produtos.FieldByName('PISCST').AsString = '99') or
                    {codigo não presentes na nfe ainda: ficam como 99}
                    (produtos.FieldByName('piscst').AsString = '05') or
                    (produtos.FieldByName('piscst').AsString = '49') or
                    (produtos.FieldByName('piscst').AsString = '50') or
                    (produtos.FieldByName('piscst').AsString = '51') or
                    (produtos.FieldByName('piscst').AsString = '52') or
                    (produtos.FieldByName('piscst').AsString = '53') or
                    (produtos.FieldByName('piscst').AsString = '54') or
                    (produtos.FieldByName('piscst').AsString = '55') or
                    (produtos.FieldByName('piscst').AsString = '56') or
                    (produtos.FieldByName('piscst').AsString = '60') or
                    (produtos.FieldByName('piscst').AsString = '61') or
                    (produtos.FieldByName('piscst').AsString = '62') or
                    (produtos.FieldByName('piscst').AsString = '63') or
                    (produtos.FieldByName('piscst').AsString = '64') or
                    (produtos.FieldByName('piscst').AsString = '65') or
                    (produtos.FieldByName('piscst').AsString = '66') or
                    (produtos.FieldByName('piscst').AsString = '67') or
                    (produtos.FieldByName('piscst').AsString = '70') or
                    (produtos.FieldByName('piscst').AsString = '71') or
                    (produtos.FieldByName('piscst').AsString = '72') or
                    (produtos.FieldByName('piscst').AsString = '73') or
                    (produtos.FieldByName('piscst').AsString = '74') or
                    (produtos.FieldByName('piscst').AsString = '75') or
                    (produtos.FieldByName('piscst').AsString = '98') then

                begin
                  AbreTag('PISOutr');
                  TagCompleta('CST',  Produtos.FieldByName('piscst').AsString);
                  TagCompleta('vBC',  Produtos.FieldByName('pisbasecalculo').AsCurrency,2);

                  if Produtos.FieldByName('pisbasecalculo').AsCurrency <> 0 then
                    TagCompleta('pPIS', Produtos.FieldByName('pisaliquota').AsCurrency,2)
                  else
                    TagCompleta('pPIS', 0.00, 2);

  //              TagCompleta('qBCProd', Produtos.FieldByName('').AsCurrency,4);
  //              TagCompleta('vAliqProd', Produtos.FieldByName('').AsCurrency,4);
                  TagCompleta('vPIS', Produtos.FieldByName('pisvalor').AsCurrency,2);
                  FechaTag('PISOutr')
                end
                else
                if (Produtos.FieldByName('PISCST').AsString = '') then
                  ValidarTag('CST','');

                FechaTag('PIS');
                // PIS ST ?

                local := vlocal_aux+' - COFINS';
                AbreTag('COFINS');
                if (Produtos.FieldByName('COFINSCST').AsString = '01') or
                   (Produtos.FieldByName('COFINSCST').AsString = '02') then
                begin
                  AbreTag('COFINSAliq');
                  TagCompleta('CST',     Produtos.FieldByName('cofinscst').AsString);
                  TagCompleta('vBC',     Produtos.FieldByName('cofinsbasecalculo').AsCurrency,2);

                  if Produtos.FieldByName('cofinsbasecalculo').AsCurrency <> 0 then
                    TagCompleta('pCOFINS', Produtos.FieldByName('cofinsaliquota').AsCurrency,2)
                  else
                    TagCompleta('pCOFINS', 0.00, 2);

                  TagCompleta('vCOFINS', Produtos.FieldByName('cofinsvalor').AsCurrency,2);
                  FechaTag('COFINSAliq')
                end
                else
                if (Produtos.FieldByName('COFINSCST').AsString = '03') then
                begin
                  AbreTag('COFINSQtde');
                  TagCompleta('CST',     Produtos.FieldByName('cofinscst').AsString);
  //              TagCompleta('qBCProd', Produtos.FieldByName('').AsCurrency,4);
  //              TagCompleta('vAliqProd', Produtos.FieldByName('').AsCurrency,4);
                  TagCompleta('vCOFINS', Produtos.FieldByName('cofinsvalor').AsCurrency,2);
                  FechaTag('COFINSQtde')
                end
                else
                if (Produtos.FieldByName('COFINSCST').AsString = '04') or
                   (Produtos.FieldByName('COFINSCST').AsString = '06') or
                   (Produtos.FieldByName('COFINSCST').AsString = '07') or
                   (Produtos.FieldByName('COFINSCST').AsString = '08') or
                   (Produtos.FieldByName('COFINSCST').AsString = '09') then
                begin
                  AbreTag('COFINSNT');
                  TagCompleta('CST', Produtos.FieldByName('cofinscst').AsString);
                  FechaTag('COFINSNT')
                end
                else
                if (Produtos.FieldByName('COFINSCST').AsString = '99') or
                    {codigo não presentes na nfe ainda: ficam como 99}
                    (produtos.FieldByName('cofinscst').AsString = '05') or
                    (produtos.FieldByName('cofinscst').AsString = '49') or
                    (produtos.FieldByName('cofinscst').AsString = '50') or
                    (produtos.FieldByName('cofinscst').AsString = '51') or
                    (produtos.FieldByName('cofinscst').AsString = '52') or
                    (produtos.FieldByName('cofinscst').AsString = '53') or
                    (produtos.FieldByName('cofinscst').AsString = '54') or
                    (produtos.FieldByName('cofinscst').AsString = '55') or
                    (produtos.FieldByName('cofinscst').AsString = '56') or
                    (produtos.FieldByName('cofinscst').AsString = '60') or
                    (produtos.FieldByName('cofinscst').AsString = '61') or
                    (produtos.FieldByName('cofinscst').AsString = '62') or
                    (produtos.FieldByName('cofinscst').AsString = '63') or
                    (produtos.FieldByName('cofinscst').AsString = '64') or
                    (produtos.FieldByName('cofinscst').AsString = '65') or
                    (produtos.FieldByName('cofinscst').AsString = '66') or
                    (produtos.FieldByName('cofinscst').AsString = '67') or
                    (produtos.FieldByName('cofinscst').AsString = '70') or
                    (produtos.FieldByName('cofinscst').AsString = '71') or
                    (produtos.FieldByName('cofinscst').AsString = '72') or
                    (produtos.FieldByName('cofinscst').AsString = '73') or
                    (produtos.FieldByName('cofinscst').AsString = '74') or
                    (produtos.FieldByName('cofinscst').AsString = '75') or
                    (produtos.FieldByName('cofinscst').AsString = '98') then
                begin
                  AbreTag('COFINSOutr');
                  TagCompleta('CST',     Produtos.FieldByName('cofinscst').AsString);
                  TagCompleta('vBC',     Produtos.FieldByName('cofinsbasecalculo').AsCurrency,2);

                  if Produtos.FieldByName('cofinsbasecalculo').AsCurrency <> 0 then
                    TagCompleta('pCOFINS', Produtos.FieldByName('cofinsaliquota').AsCurrency,2)
                  else
                    TagCompleta('pCOFINS', 0.00, 2);

  //              TagCompleta('qBCProd', Produtos.FieldByName('').AsCurrency,4);
  //              TagCompleta('vAliqProd', Produtos.FieldByName('').AsCurrency,4);
                  TagCompleta('vCOFINS', Produtos.FieldByName('cofinsvalor').AsCurrency,2);
                  FechaTag('COFINSOutr')
                end
                else
                if (Produtos.FieldByName('COFINSCST').AsString = '') then
                  ValidarTag('CST','');

                FechaTag('COFINS')
              end;

              // Esperando definição se simples também se enquadra
//              if (FEmit_CRT in [2,3]) then { Regime Tributário 2: Simples Excedente 3: Normal}
//              begin
                { esta opção esperando definição se entra ou nao o regime simples }

                (*
                if VendaInterEstadual and
                   VendaConsumidorFinal and (not Notas.FieldByName('clientecontribicms').asboolean or
                                                (Notas.FieldByName('clientecontribicms').asboolean and
                                                 ((Notas.findfield('responsaveldifal')<>nil) and Notas.fieldbyname('responsaveldifal').asBoolean)
												                                             and (produtos.fieldbyname('icmsvalorst').ascurrency=0))) and
                  (tipo='S') and
                  (Notas.FieldByName('modelodocto').asString <> '65')                then
                  *)


                      if (Produtos.Findfield('vICMSUFDest')<>nil) and
                         (Produtos.Findfield('vFCPUFDest')<>nil) and
                         (Produtos.Findfield('vICMSUFRemet')<>nil) then

                        if (not Produtos.FieldByName('vICMSUFDest').isnull) or
                           (not Produtos.FieldByName('vFCPUFDest').isnull) or
                           (not Produtos.FieldByName('vICMSUFRemet').isnull) then
                        begin
                          AbreTag('ICMSUFDest');
                            TagCompleta('vBCUFDest',   Produtos.FieldByName('vBCUFDest').AsCurrency, 2);
                            TagCompleta('vBCFCPUFDest', Produtos.FieldByName('vBCFCPUFDest').AsCurrency, 2);
                            TagCompleta('pFCPUFDest', Produtos.FieldByName('pFCPUFDest').AsCurrency, 2);
                            TagCompleta('pICMSUFDest', Produtos.FieldByName('pICMSUFDest').AsCurrency, 2);
                            TagCompleta('pICMSInter', Produtos.FieldByName('pICMSInter').AsCurrency, 2);
                            TagCompleta('pICMSInterPart', Produtos.FieldByName('pICMSInterPart').AsCurrency, 2);
                            TagCompleta('vFCPUFDest', Produtos.FieldByName('vFCPUFDest').AsCurrency, 2);
                            TagCompleta('vICMSUFDest',   Produtos.FieldByName('vICMSUFDest').AsCurrency, 2);
                            TagCompleta('vICMSUFRemet',   Produtos.FieldByName('vICMSUFRemet').AsCurrency, 2);
                          FechaTag('ICMSUFDest');
                        end;

//              end;

              FechaTag('imposto');

              if not ContribuinteIPI and
                 (Notas.FieldByName('finalidadenf').AsString='4') and
                 ((Notas.FieldByName('valoripi').AsCurrency) <> 0) then  {qdo devolução e não contribuinte de ipi}
              begin
{                TagCompleta('vIPI', Notas.FieldByName('valoripi').AsCurrency,2);}

                AbreTag('impostoDevol');

                  if (Produtos.Findfield('quantidadenotaorigem')<>nil) and
                     (Produtos.FieldByName('quantidadenotaorigem').asCurrency<>0) then
                     TagCompleta('pDevol',  roundto(((Produtos.FieldByName('quantidade').AsCurrency * 100)/
                                                     Produtos.FieldByName('quantidadenotaorigem').asCurrency), 2), 2)
                  else
                     TagCompleta('pDevol',  100, 2);

                  AbreTag('IPI');
                    TagCompleta('vIPIDevol', Produtos.FieldByName('valoripi').AsCurrency,2);
                  FechaTag('IPI');

                FechaTag('impostoDevol');
              end;


              if not validando then
              begin

                vInfadProd := '';
                if (notas.FindField('TagAdPedNFE')<>nil) then
                begin
                  if notas.Fieldbyname('TagAdPedNFE').AsBoolean then
                  begin
//                    AbreTag('infAdProd');

                      if (Produtos.FindField('fci') <> nil) and
                         (Produtos.Fieldbyname('fci').AsString <> '') then

                        vInfadProd :=
                                  'FCI '+Produtos.Fieldbyname('fci').AsString +
                                  '<![CDATA[<id item="' +
                                   Trocar(Trocar(
                                                 Produtos.FieldByName('produtocliente').AsString,
                                                 '.',''),' ','') +
                                  '" ped="' + Produtos.FieldByName('pedidocliente').AsString +
                                  '"/><div uM="' + Unidade(false) + '"/>' + ']]>'
{
                        Write(xml, 'FCI '+Produtos.Fieldbyname('fci').AsString +
                                  '<![CDATA[<id item="' +
                                   Trocar(Trocar(
                                                 Produtos.FieldByName('produtocliente').AsString,
                                                 '.',''),' ','') +
                                  '" ped="' + Produtos.FieldByName('pedidocliente').AsString +
                                  '"/><div uM="' + Unidade(false) + '"/>' + ']]>')
}

                      else
                        vInfadProd :=
                                  '<![CDATA[<id item="' +
                                   Trocar(Trocar(
                                                 Produtos.FieldByName('produtocliente').AsString,
                                                 '.',''),' ','') +
                                  '" ped="' + Produtos.FieldByName('pedidocliente').AsString +
                                  '"/><div uM="' + Unidade(false) + '"/>' + ']]>';

{
                        Write(xml, '<![CDATA[<id item="' +
                                   Trocar(Trocar(
                                                 Produtos.FieldByName('produtocliente').AsString,
                                                 '.',''),' ','') +
                                  '" ped="' + Produtos.FieldByName('pedidocliente').AsString +
                                  '"/><div uM="' + Unidade(false) + '"/>' + ']]>');
}

//                    FechaTag('infAdProd');

                  end
                  else
                  begin
                    if (Produtos.FindField('fci') <> nil) and
                       (Produtos.Fieldbyname('fci').AsString <> '') then
                    begin
//                      AbreTag('infAdProd');
                      vInfadProd := 'FCI '+Produtos.Fieldbyname('fci').AsString;
//                      Write(xml, 'FCI '+Produtos.Fieldbyname('fci').AsString);
//                      FechaTag('infAdProd');
                    end;
                  end;
                end
                else
                begin
                  if (Produtos.FindField('fci') <> nil) and
                     (Produtos.Fieldbyname('fci').AsString <> '') then
                  begin
//                    AbreTag('infAdProd');
                    vInfadProd := 'FCI '+Produtos.Fieldbyname('fci').AsString;
//                    Write(xml, 'FCI '+Produtos.Fieldbyname('fci').AsString);
//                    FechaTag('infAdProd');
                  end;
                end;

                if (produtos.FindField('lote')<>nil) and
                   (produtos.FieldByName('lote').AsString<>'') then
                begin

                  vInfadProd := trim(vInfadProd + ' ' +
                                     format('Lote: %s Fab.: %s Data Validade: %s',
                                     [produtos.FieldByName('nrlote').AsString,
                                      FormatDateTime('dd-MM-yyyy', produtos.FieldByName('fabricacao').AsDateTime),
                                      FormatDateTime('dd-MM-yyyy', produtos.FieldByName('validade').AsDateTime)]));

                end;

                if vInfadProd<>'' then
                begin
                  AbreTag('infAdProd');
                  Write(xml, vInfadProd);
                  FechaTag('infAdProd');
                end;
                
              end;

              FechaTag('det');
            end;
            Produtos.Next;
          end;
        finally
          Produtos.First
  //        VoltarRegistroAtual(Produtos);
        end;
      end;
{=======================  SERVIÇOS ==========================================}

      if ((Servicos <> nil) and (Servicos.RecordCount > 0)) then
      begin
        try
          Servicos.First;
          while not Servicos.Eof do
          begin
            Inc(nItem);
            AbreTag('det', ['nItem'], [IntToStr(nItem)]);
            AbreTag('prod');

            TagCompleta('cProd',    Copy(Servicos.FieldByName('servico').AsString,1,60));
            vlocal_aux := 'Detalhamento do ítem de Serviço: '+trim(Copy(Servicos.FieldByName('servico').AsString,1,60));

            local := vlocal_aux;

            TagCompleta('cEAN', ''(*Servicos.FieldByName('codigoEAN').AsString*));

            if (fambiente = '2') and (nitem=1) then // 1 – Produção / 2 - Homologação
               TagCompleta('xProd', 'NOTA FISCAL EMITIDA EM AMBIENTE DE HOMOLOGACAO - SEM VALOR FISCAL')
            else
               TagCompleta('xProd',    Copy(Servicos.FieldByName('descricao').AsString,1,120));

            TagCompleta('NCM',    '00');

            { TagCompleta('EXTIPI', Servicos.FieldByName('extipi').AsString); não incluir a TAG}

            TagCompleta('CFOP',     Servicos.FieldByName('codigofiscal').AsString);

            TagCompleta('uCom',     'UN');
            TagCompleta('qCom',     Servicos.FieldByName('quantidade').AsCurrency,4);
            TagCompleta('vUnCom',   Servicos.FieldByName('valorservico').Asfloat,10);

            TagCompleta('vProd',    roundto(Servicos.FieldByName('quantidade').AsCurrency * Servicos.FieldByName('valorservico').Asfloat,-2),2);

            TagCompleta('cEANTrib', '');

            TagCompleta('uTrib',    'UN');

            TagCompleta('qTrib',    Servicos.FieldByName('quantidade').AsCurrency,4);

            TagCompleta('vUnTrib',  Servicos.FieldByName('valorservico').Asfloat,10);

            {
            if Servicos.FieldByName('frete').AsCurrency > 0 then
              TagCompleta('vFrete', Servicos.FieldByName('frete').AsCurrency,2);

            if Servicos.FieldByName('seguro').AsCurrency > 0 then
              TagCompleta('vSeg',   Servicos.FieldByName('seguro').AsCurrency,2);

            if Servicos.FieldByName('desconto').AsCurrency > 0 then
              TagCompleta('vDesc',  Servicos.FieldByName('desconto').AsCurrency,2);


            if Servicos.FindField('iivalor')<>nil then
            begin
              if (Servicos.FieldByName('despesasacessorias').AsCurrency +
                  Servicos.FieldByName('iivalor').AsCurrency +
                  Servicos.FieldByName('acrescimo').AsCurrency) > 0 then
                TagCompleta('vOutro',  Servicos.FieldByName('despesasacessorias').AsCurrency +
                                       Servicos.FieldByName('iivalor').AsCurrency +
                                       Servicos.FieldByName('acrescimo').AsCurrency, 2);
            end
            else
            begin
              if (Servicos.FieldByName('despesasacessorias').AsCurrency +
                  Servicos.FieldByName('acrescimo').AsCurrency) > 0 then
                TagCompleta('vOutro',  Servicos.FieldByName('despesasacessorias').AsCurrency +
                                       Servicos.FieldByName('acrescimo').AsCurrency ,2);
            end;
            }

            TagCompleta('indTot',  '1');

            FechaTag('prod');

            AbreTag('imposto');


{         ============  ISSQN  ==============}

            local := vlocal_aux+' - ISSQN';
            AbreTag('ISSQN');
            if Servicos.FieldByName('valorissqn').AsCurrency <> 0 then
              TagCompleta('vBC',     Servicos.FieldByName('quantidade').AsCurrency * Servicos.FieldByName('valorservico').AsCurrency, 2)
            else
              TagCompleta('vBC',     0, 2);

            TagCompleta('vAliq', Servicos.FieldByName('aliquotaissqn').AsCurrency,2);
            TagCompleta('vISSQN', Servicos.FieldByName('valorissqn').AsCurrency,2);
            TagCompleta('cMunFG',  FEmit_CodMun);
//            TagCompleta('cListServ',  somentenumero(Servicos.FieldByName('codigolcp116').AsString));
            TagCompleta('cListServ',  Servicos.FieldByName('codigolcp116').AsString);

{
N – NORMAL;
R – RETIDA;
S –SUBSTITUTA;
I – ISENTA. (v.2.0)
}

{ ELIMINADO
            if Servicos.FieldByName('reterissqn').AsBoolean then
              TagCompleta('cSitTrib',  'R')
            else
            if (Servicos.FieldByName('valorissqn').AsCurrency=0) then
              TagCompleta('cSitTrib',  'I')
            else
              TagCompleta('cSitTrib',  'N');
}

            FechaTag('ISSQN');


            local := vlocal_aux+' - PIS ';
            AbreTag('PIS');

            if (Servicos.FieldByName('PISCST').AsString = '01') or
               (Servicos.FieldByName('PISCST').AsString = '02') then
            begin
              AbreTag('PISAliq');
              TagCompleta('CST',  Servicos.FieldByName('piscst').AsString);
              TagCompleta('vBC',  Servicos.FieldByName('pisbasecalculo').AsCurrency,2);

              if Servicos.FieldByName('pisbasecalculo').AsCurrency <> 0 then
                TagCompleta('pPIS', Servicos.FieldByName('aliquotapis').AsCurrency,2)
              else
                TagCompleta('pPIS', 0.00, 2);

              TagCompleta('vPIS', Servicos.FieldByName('pisvalor').AsCurrency,2);
              FechaTag('PISAliq')
            end
            else
            if (Servicos.FieldByName('PISCST').AsString = '03') then
            begin
              {Código não preparado para esta modalidade}
              AbreTag('PISQtde');
              TagCompleta('CST',  Servicos.FieldByName('piscst').AsString);
//              TagCompleta('vBCProd', Servicos.FieldByName('').AsCurrency,4);
//              TagCompleta('vAliqProd', Servicos.FieldByName('').AsCurrency,4);
              TagCompleta('vPIS', Servicos.FieldByName('pisvalor').AsCurrency,2);
              FechaTag('PISQtde')
            end
            else
            if (Servicos.FieldByName('PISCST').AsString = '04') or
               (Servicos.FieldByName('PISCST').AsString = '06') or
               (Servicos.FieldByName('PISCST').AsString = '07') or
               (Servicos.FieldByName('PISCST').AsString = '08') or
               (Servicos.FieldByName('PISCST').AsString = '09') then
            begin
              AbreTag('PISNT');
              TagCompleta('CST', Servicos.FieldByName('piscst').AsString);
              FechaTag('PISNT')
            end
            else
            if (Servicos.FieldByName('PISCST').AsString = '99') or
                {codigo não presentes na nfe ainda: ficam como 99}
                (Servicos.FieldByName('piscst').AsString = '05') or
                (Servicos.FieldByName('piscst').AsString = '49') or
                (Servicos.FieldByName('piscst').AsString = '50') or
                (Servicos.FieldByName('piscst').AsString = '51') or
                (Servicos.FieldByName('piscst').AsString = '52') or
                (Servicos.FieldByName('piscst').AsString = '53') or
                (Servicos.FieldByName('piscst').AsString = '54') or
                (Servicos.FieldByName('piscst').AsString = '55') or
                (Servicos.FieldByName('piscst').AsString = '56') or
                (Servicos.FieldByName('piscst').AsString = '60') or
                (Servicos.FieldByName('piscst').AsString = '61') or
                (Servicos.FieldByName('piscst').AsString = '62') or
                (Servicos.FieldByName('piscst').AsString = '63') or
                (Servicos.FieldByName('piscst').AsString = '64') or
                (Servicos.FieldByName('piscst').AsString = '65') or
                (Servicos.FieldByName('piscst').AsString = '66') or
                (Servicos.FieldByName('piscst').AsString = '67') or
                (Servicos.FieldByName('piscst').AsString = '70') or
                (Servicos.FieldByName('piscst').AsString = '71') or
                (Servicos.FieldByName('piscst').AsString = '72') or
                (Servicos.FieldByName('piscst').AsString = '73') or
                (Servicos.FieldByName('piscst').AsString = '74') or
                (Servicos.FieldByName('piscst').AsString = '75') or
                (Servicos.FieldByName('piscst').AsString = '98') then

            begin
              AbreTag('PISOutr');
              TagCompleta('CST',  Servicos.FieldByName('piscst').AsString);
              TagCompleta('vBC',  Servicos.FieldByName('pisbasecalculo').AsCurrency,2);

              if Servicos.FieldByName('pisbasecalculo').AsCurrency <> 0 then
                TagCompleta('pPIS', Servicos.FieldByName('aliquotapis').AsCurrency,2)
              else
                TagCompleta('pPIS', 0.00, 2);

//              TagCompleta('qBCProd', Servicos.FieldByName('').AsCurrency,4);
//              TagCompleta('vAliqProd', Servicos.FieldByName('').AsCurrency,4);
              TagCompleta('vPIS', Servicos.FieldByName('pisvalor').AsCurrency,2);
              FechaTag('PISOutr')
            end
            else
            if (Servicos.FieldByName('PISCST').AsString = '') then
              ValidarTag('CST','');

            FechaTag('PIS');
            // PIS ST ?

            local := vlocal_aux+' - COFINS';
            AbreTag('COFINS');
            if (Servicos.FieldByName('COFINSCST').AsString = '01') or
               (Servicos.FieldByName('COFINSCST').AsString = '02') then
            begin
              AbreTag('COFINSAliq');
              TagCompleta('CST',     Servicos.FieldByName('cofinscst').AsString);
              TagCompleta('vBC',     Servicos.FieldByName('cofinsbasecalculo').AsCurrency,2);

              if Servicos.FieldByName('cofinsbasecalculo').AsCurrency <> 0 then
                TagCompleta('pCOFINS', Servicos.FieldByName('aliquotacofins').AsCurrency,2)
              else
                TagCompleta('pCOFINS', 0.00, 2);

              TagCompleta('vCOFINS', Servicos.FieldByName('cofinsvalor').AsCurrency,2);
              FechaTag('COFINSAliq')
            end
            else
            if (Servicos.FieldByName('COFINSCST').AsString = '03') then
            begin
              AbreTag('COFINSQtde');
              TagCompleta('CST',     Servicos.FieldByName('cofinscst').AsString);
//              TagCompleta('qBCProd', Servicos.FieldByName('').AsCurrency,4);
//              TagCompleta('vAliqProd', Servicos.FieldByName('').AsCurrency,4);
              TagCompleta('vCOFINS', Servicos.FieldByName('cofinsvalor').AsCurrency,2);
              FechaTag('COFINSQtde')
            end
            else
            if (Servicos.FieldByName('COFINSCST').AsString = '04') or
               (Servicos.FieldByName('COFINSCST').AsString = '06') or
               (Servicos.FieldByName('COFINSCST').AsString = '07') or
               (Servicos.FieldByName('COFINSCST').AsString = '08') or
               (Servicos.FieldByName('COFINSCST').AsString = '09') then
            begin
              AbreTag('COFINSNT');
              TagCompleta('CST', Servicos.FieldByName('cofinscst').AsString);
              FechaTag('COFINSNT')
            end
            else
            if (Servicos.FieldByName('COFINSCST').AsString = '99') or
                {codigo não presentes na nfe ainda: ficam como 99}
                (Servicos.FieldByName('cofinscst').AsString = '05') or
                (Servicos.FieldByName('cofinscst').AsString = '49') or
                (Servicos.FieldByName('cofinscst').AsString = '50') or
                (Servicos.FieldByName('cofinscst').AsString = '51') or
                (Servicos.FieldByName('cofinscst').AsString = '52') or
                (Servicos.FieldByName('cofinscst').AsString = '53') or
                (Servicos.FieldByName('cofinscst').AsString = '54') or
                (Servicos.FieldByName('cofinscst').AsString = '55') or
                (Servicos.FieldByName('cofinscst').AsString = '56') or
                (Servicos.FieldByName('cofinscst').AsString = '60') or
                (Servicos.FieldByName('cofinscst').AsString = '61') or
                (Servicos.FieldByName('cofinscst').AsString = '62') or
                (Servicos.FieldByName('cofinscst').AsString = '63') or
                (Servicos.FieldByName('cofinscst').AsString = '64') or
                (Servicos.FieldByName('cofinscst').AsString = '65') or
                (Servicos.FieldByName('cofinscst').AsString = '66') or
                (Servicos.FieldByName('cofinscst').AsString = '67') or
                (Servicos.FieldByName('cofinscst').AsString = '70') or
                (Servicos.FieldByName('cofinscst').AsString = '71') or
                (Servicos.FieldByName('cofinscst').AsString = '72') or
                (Servicos.FieldByName('cofinscst').AsString = '73') or
                (Servicos.FieldByName('cofinscst').AsString = '74') or
                (Servicos.FieldByName('cofinscst').AsString = '75') or
                (Servicos.FieldByName('cofinscst').AsString = '98') then
            begin
              AbreTag('COFINSOutr');
              TagCompleta('CST',     Servicos.FieldByName('cofinscst').AsString);
              TagCompleta('vBC',     Servicos.FieldByName('cofinsbasecalculo').AsCurrency,2);

              if Servicos.FieldByName('cofinsbasecalculo').AsCurrency <> 0 then
                TagCompleta('pCOFINS', Servicos.FieldByName('aliquotacofins').AsCurrency,2)
              else
                TagCompleta('pCOFINS', 0.00, 2);

//              TagCompleta('qBCProd', Servicos.FieldByName('').AsCurrency,4);
//              TagCompleta('vAliqProd', Servicos.FieldByName('').AsCurrency,4);
              TagCompleta('vCOFINS', Servicos.FieldByName('cofinsvalor').AsCurrency,2);
              FechaTag('COFINSOutr')
            end
            else
            if (Servicos.FieldByName('COFINSCST').AsString = '') then
              ValidarTag('CST','');

            FechaTag('COFINS');


            FechaTag('imposto');

            FechaTag('det');

            Servicos.Next;

          end;
        finally
          Servicos.First
  //        VoltarRegistroAtual(Produtos);
        end;
      end;


    end;

    procedure ValoresTotais;
    var
      vDespesasAcessorias : Currency;
      vValorImpostoRetido : Currency;
    begin
      AbreTag('total');

      AbreTag('ICMSTot');
      TagCompleta('vBC',     Notas.FieldByName('baseicms').AsCurrency,2);
      TagCompleta('vICMS',   Notas.FieldByName('valoricms').AsCurrency,2);
      TagCompleta('vICMSDeson',   0,2);

      if Tipo = 'S' then
      begin
       //JR  14/01/2016 - VENDA ESTADUAL NAO DEVE GERAR .. CONFIRMAR ORDEM DAS TAGS
      // Esperando definição se simples também se enquadra
//       if (FEmit_CRT in [2,3]) then { Regime Tributário 2: Simples Excedente 3: Normal}
        (*
        if VendaInterEstadual and
           VendaConsumidorFinal and (not Notas.FieldByName('clientecontribicms').asboolean or
                                        (Notas.FieldByName('clientecontribicms').asboolean and
                                         ((Notas.findfield('responsaveldifal')<>nil) and Notas.fieldbyname('responsaveldifal').asBoolean))) and
          (tipo='S') and
          (Notas.FieldByName('modelodocto').asString <> '65')  {and  (fEmit_Crt <> 1)}
        then
        *)

        (*
        if (Notas.Findfield('vFCP')<>nil) then
//          if (notas.FieldByName('vFCP').asCurrency<>0) then
            TagCompleta('vFCP',   Notas.FieldByName('vFCP').AsCurrency,2);
            *)



        if (Notas.Findfield('vICMSUFDest')<>nil) and
           (Notas.Findfield('vFCPUFDest')<>nil) and
           (Notas.Findfield('vICMSUFRemet')<>nil) then

          if(notas.FieldByName('vICMSUFDest').asCurrency<>0) or
            (notas.FieldByName('vFCPUFDest').asCurrency<>0) or
            (notas.FieldByName('vICMSUFRemet').asCurrency<>0) then
          begin
            TagCompleta('vFCPUFDest',   Notas.FieldByName('vFCPUFDest').AsCurrency,2);
            TagCompleta('vICMSUFDest',   Notas.FieldByName('vICMSUFDest').AsCurrency,2);
            TagCompleta('vICMSUFRemet',   Notas.FieldByName('vICMSUFRemet').AsCurrency,2);
          end;

//        if (Notas.Findfield('vFCP')<>nil) then
//          if (notas.FieldByName('vFCP').asCurrency<>0) then
            TagCompleta('vFCP',   Notas.FieldByName('vFCP').AsCurrency,2);



        TagCompleta('vBCST',   Notas.FieldByName('totalbaseicmssubstituicao').AsCurrency,2);
        TagCompleta('vST',     Notas.FieldByName('totalvaloricmssubstituicao').AsCurrency,2);

//        if (Notas.Findfield('vFCPST')<>nil) then
//          if (notas.FieldByName('vFCPST').asCurrency<>0) then
            TagCompleta('vFCPST',   Notas.FieldByName('vFCPST').AsCurrency,2);

//        if (Notas.Findfield('vFCPSTRet')<>nil) then
//          if (notas.FieldByName('vFCPSTRet').asCurrency<>0) then
            TagCompleta('vFCPSTRet',   Notas.FieldByName('vFCPSTRet').AsCurrency,2);

      end
      else
      begin
//        if (Notas.Findfield('vFCP')<>nil) then
//          if (notas.FieldByName('vFCP').asCurrency<>0) then
            TagCompleta('vFCP',   Notas.FieldByName('vFCP').AsCurrency,2);

        TagCompleta('vBCST',   Notas.FieldByName('baseicmssubstituicao').AsCurrency,2);
        TagCompleta('vST',     Notas.FieldByName('valoricmssubstituicao').AsCurrency,2);

//        if (Notas.Findfield('vFCPST')<>nil) then
//          if (notas.FieldByName('vFCPST').asCurrency<>0) then
            TagCompleta('vFCPST',   Notas.FieldByName('vFCPST').AsCurrency,2);

//        if (Notas.Findfield('vFCPSTRet')<>nil) then
//          if (notas.FieldByName('vFCPSTRet').asCurrency<>0) then
            TagCompleta('vFCPSTRet',   Notas.FieldByName('vFCPSTRet').AsCurrency,2);

      end;

      if Tipo = 'S' then
      begin
        TagCompleta('vProd',   Notas.FieldByName('valorprodutos').AsCurrency,2);
        TagCompleta('vFrete',  Notas.FieldByName('valorfrete').AsCurrency,2)
      end
      else
      begin
        TagCompleta('vProd',   Notas.FieldByName('valorprodutos').AsCurrency,2);
        TagCompleta('vFrete',  Notas.FieldByName('freteinterno').AsCurrency,2)
      end;

      TagCompleta('vSeg',    Notas.FieldByName('seguro').AsCurrency,2);

      if Notas.FindField('descontoitem')<>nil then
        TagCompleta('vDesc',   Notas.FieldByName('desconto').AsCurrency + Notas.FieldByName('descontoitem').AsCurrency, 2)
      else
        TagCompleta('vDesc',   Notas.FieldByName('desconto').AsCurrency,2);

      TagCompleta('vII',     Notas.FieldByName('totalimportacao').AsCurrency,2);

//      if (ContribuinteIPI or (not contribuinteIPI and eHImportacao)) then
      if (ContribuinteIPI or (not contribuinteIPI and (eHImportacao
                                    or ( not ((Notas.FieldByName('finalidadenf').AsString)='4')
                                         and ((Notas.FieldByName('valoripi').AsCurrency) <> 0))
                                   ))) then



        TagCompleta('vIPI',    Notas.FieldByName('valoripi').AsCurrency,2)
      else
        TagCompleta('vIPI',  0,2);

      if not ContribuinteIPI and (Notas.FieldByName('finalidadenf').AsString='4') then  {qdo devolução e não contribuinte de ipi}
        TagCompleta('vIPIDevol',    Notas.FieldByName('valoripi').AsCurrency,2)
      else
        TagCompleta('vIPIDevol',  0,2);


      TagCompleta('vPIS',    Notas.FieldByName('totalvalorpis').AsCurrency,2);
      TagCompleta('vCOFINS', Notas.FieldByName('totalvalorcofins').AsCurrency,2);


      if Tipo = 'S' then
      begin

        vDespesasAcessorias := Notas.FieldByName('despesasacessorias').AsCurrency +
                               Notas.FieldByName('acrescimofinanceiro').AsCurrency;

       if ehDevolucaoImportacao(notas) then
          vDespesasAcessorias := vDespesasAcessorias + Notas.FieldByName('valoricms').AsCurrency;

        if (notas.findfield('vICMSSTRetDesp')<>nil) {and (tipo = 'S')} then
          vDespesasAcessorias := vDespesasAcessorias + notas.fieldbyname('vICMSSTRetDesp').ascurrency;

          (*
        if (notas.findfield('valoripi')<>nil) and
           {eHNotaFiscalSaidaDevolucao(notas.FieldByName('codigofiscal').AsInteger) and}
           not ContribuinteIPI {and (tipo = 'S')} then
           vDespesasAcessorias := vDespesasAcessorias + notas.fieldbyname('valoripi').ascurrency;
           *)

        TagCompleta('vOutro',  vDespesasAcessorias, 2);
                       {
        if not validando then
          TagCompleta('vNF',     Notas.FieldByName('valortotal').AsCurrency-1,2)
        else            }
          TagCompleta('vNF',     Notas.FieldByName('valortotal').AsCurrency,2);

        if Notas.findfield('valortotalimpostoibt')<>nil then
          TagCompleta('vTotTrib', Notas.FieldByName('valortotalimpostoibt').AsCurrency,2);
      end
      else
      begin

        vDespesasAcessorias := Notas.FieldByName('despesasacessorias').AsCurrency +
                               Notas.FieldByName('acrescimo').AsCurrency;

        if (notas.findfield('vICMSSTRetDesp')<>nil) {and (tipo = 'S')} then
          vDespesasAcessorias := vDespesasAcessorias + notas.fieldbyname('vICMSSTRetDesp').ascurrency;
                               (*
        if (notas.findfield('valoripi')<>nil) and
           {eHNotaFiscalSaidaDevolucao(notas.FieldByName('codigofiscal').AsInteger) and}
           not ContribuinteIPI {and (tipo = 'S')} then
           vDespesasAcessorias := vDespesasAcessorias + notas.fieldbyname('valoripi').ascurrency;
           *)

        TagCompleta('vOutro',  vDespesasAcessorias, 2);


        TagCompleta('vNF',     Notas.FieldByName('valornota').AsCurrency,2);
      end;


      FechaTag('ICMSTot');


      { =============== ISSQN ===============}    {AQUI E AGORA}

      if (servicos <> nil) and (servicos.recordcount <> 0) then
      begin
        AbreTag('ISSQNtot');

        TagCompleta('vServ',   Notas.FieldByName('valorservicos').AsCurrency,2);
        TagCompleta('vBC',     Notas.FieldByName('issqnbasecalculo').AsCurrency,2);
        TagCompleta('vISS',    Notas.FieldByName('valorISSQN').AsCurrency,2);
        TagCompleta('vPIS',    Notas.FieldByName('totalvalorpis_servicos').AsCurrency,2);
        TagCompleta('vCOFINS', Notas.FieldByName('totalvalorcofins_servicos').AsCurrency,2);
        TagCompleta('dCompet', Notas.FieldByName('datahoraemissao').AsDateTime, 'yyyymmdd');

        FechaTag('ISSQNtot');
      end;


      if ((Notas.FindField('irretido')    <> nil) and
          (Notas.FieldByName('irretido').AsCurrency     > 0)) or
         ((Notas.FindField('cofinsretido') <> nil) and
          (Notas.FieldByName('cofinsretido').AsCurrency > 0)) or
         ((Notas.FindField('pisretido')   <> nil) and
          (Notas.FieldByName('pisretido').AsCurrency    > 0)) or
         ((Notas.FindField('csllretido') <> nil)  and
          (Notas.FieldByName('csllretido').AsCurrency   > 0)) or

         ((qryRetencoes <> nil) and
          (qryRetencoes.recordcount <> 0)) then
      begin
        AbreTag('retTrib');


        vValorImpostoRetido := 0;
        vRetencoes := 0;

        if ((Notas.FindField('pisretido')    <> nil) and
            (Notas.FieldByName('pisretido').AsCurrency    > 0)) then
          vValorImpostoRetido := Notas.FieldByName('pisretido').AsCurrency;

        if qryRetencoes.locate('descricao', 'PIS', []) then
          vValorImpostoRetido := vValorImpostoRetido + qryRetencoes.fieldbyname('valorimpostoretido').asCurrency;

        vRetencoes := vRetencoes + vValorImpostoRetido;
        vSTringRetencoes := 'RETENÇÕES:';

        if vValorImpostoRetido <> 0 then
        begin
          TagCompleta('vRetPIS', vValorImpostoRetido,2);
          vSTringRetencoes := vSTringRetencoes + ' PIS '+formatfloat('###,##0.00', vValorImpostoRetido);
        end;


        vValorImpostoRetido := 0;
        if ((Notas.FindField('cofinsretido') <> nil) and
            (Notas.FieldByName('cofinsretido').AsCurrency > 0)) then
          vValorImpostoRetido := Notas.FieldByName('cofinsretido').AsCurrency;

        if qryRetencoes.locate('descricao', 'COFINS', []) then
          vValorImpostoRetido := vValorImpostoRetido + qryRetencoes.fieldbyname('valorimpostoretido').asCurrency;

        vRetencoes := vRetencoes + vValorImpostoRetido;
        if vValorImpostoRetido <> 0 then
        begin
          TagCompleta('vRetCOFINS', vValorImpostoRetido,2);
          vSTringRetencoes := vSTringRetencoes + ' COFINS '+formatfloat('###,##0.00', vValorImpostoRetido);
        end;



        vValorImpostoRetido := 0;
        if ((Notas.FindField('csllretido') <> nil) and
            (Notas.FieldByName('csllretido').AsCurrency > 0)) then
          vValorImpostoRetido := Notas.FieldByName('csllretido').AsCurrency;

        if qryRetencoes.locate('descricao', 'CSLL', []) then
          vValorImpostoRetido := vValorImpostoRetido + qryRetencoes.fieldbyname('valorimpostoretido').asCurrency;

        vRetencoes := vRetencoes + vValorImpostoRetido;
        if vValorImpostoRetido <> 0 then
        BEGIN
          TagCompleta('vRetCSLL', vValorImpostoRetido,2);
          vSTringRetencoes := vSTringRetencoes + ' CSLL '+formatfloat('###,##0.00', vValorImpostoRetido);
        end;



        vValorImpostoRetido := 0;
        if qryRetencoes.locate('descricao', 'BC IRRF', []) then
          vValorImpostoRetido := vValorImpostoRetido + qryRetencoes.fieldbyname('valorimpostoretido').asCurrency;

        vRetencoes := vRetencoes + vValorImpostoRetido;
        if vValorImpostoRetido <> 0 then
        begin
          TagCompleta('vBCIRRF', vValorImpostoRetido,2);
          vSTringRetencoes := vSTringRetencoes + ' BC IRRF '+formatfloat('###,##0.00', vValorImpostoRetido);
        end;



        vValorImpostoRetido := 0;
        if ((Notas.FindField('irretido') <> nil) and
            (Notas.FieldByName('irretido').AsCurrency > 0)) then
          vValorImpostoRetido := Notas.FieldByName('irretido').AsCurrency;

        if qryRetencoes.locate('descricao', 'IRRF', []) then
          vValorImpostoRetido := vValorImpostoRetido + qryRetencoes.fieldbyname('valorimpostoretido').asCurrency;

        vRetencoes := vRetencoes + vValorImpostoRetido;
        if vValorImpostoRetido <> 0 then
        begin
          TagCompleta('vIRRF', vValorImpostoRetido,2);
          vSTringRetencoes := vSTringRetencoes + ' IRRF '+formatfloat('###,##0.00', vValorImpostoRetido);
        end;


        vValorImpostoRetido := 0;
        if qryRetencoes.locate('descricao', 'BC Prev Social', []) then
          vValorImpostoRetido := vValorImpostoRetido + qryRetencoes.fieldbyname('valorimpostoretido').asCurrency;

        vRetencoes := vRetencoes + vValorImpostoRetido;
        if vValorImpostoRetido <> 0 then
        begin
          TagCompleta('vBCRetPrev', vValorImpostoRetido,2);
          vSTringRetencoes := vSTringRetencoes + ' BC Prev '+formatfloat('###,##0.00', vValorImpostoRetido);
        end;


        vValorImpostoRetido := 0;
        if qryRetencoes.locate('descricao', 'Prev Social', []) then
          vValorImpostoRetido := vValorImpostoRetido + qryRetencoes.fieldbyname('valorimpostoretido').asCurrency;

        vRetencoes := vRetencoes + vValorImpostoRetido;
        if vValorImpostoRetido <> 0 then
        begin
          TagCompleta('vRetPrev', vValorImpostoRetido,2);
          vSTringRetencoes := vSTringRetencoes + ' Prev '+formatfloat('###,##0.00', vValorImpostoRetido);
        end;

        if vSTringRetencoes='RETENÇÕES:' then
           vSTringRetencoes := '';

        FechaTag('retTrib')
      end;

      FechaTag('total')
    end;

    procedure InformacoesTransporte;
    begin
      AbreTag('transp');

      if (fModeloDoctoFiscal='65') {or
         (Notas.FieldByName('codigofiscal').AsString='5929')} or
         (Notas.FieldByName('frete').AsString='') OR
         {((Tipo = 'S') and  (Notas.FieldByName('valorfrete').AsCurrency = 0)) or}
         ((Tipo <> 'S') and  (Notas.FieldByName('freteinterno').AsCurrency = 0)) or
         (notas.FieldByName('finalidadenf').asString = '2') //complementar
      then
        TagCompleta('modFrete', '9')   //sem frete
      else
      if Notas.FieldByName('frete').AsString = '1' then
        TagCompleta('modFrete', '0')  //conta emitente
      else
        TagCompleta('modFrete', '1');  //conta do destinatario

      if Notas.FieldByName('fornecedortransporte').AsString <> '' then
      begin
        AbreTag('transporta');

        if Notas.FieldByName('transportadora_cnpj').AsString <> '' then
        begin
          if length(Notas.FieldByName('transportadora_cnpj').AsString)=14 then
            TagCompleta('CNPJ', preencheString(SomenteNumero(Notas.FieldByName('transportadora_cnpj').AsString),'0',14,False))
          else
            TagCompleta('CPF', preencheString(SomenteNumero(Notas.FieldByName('transportadora_cnpj').AsString),'0',11,False));
        end;

        if Notas.FieldByName('transportadora_nome').AsString <> '' then
          TagCompleta('xNome',  Copy(Notas.FieldByName('transportadora_nome').AsString,1,60));

        if Notas.FieldByName('transportadora_ie').AsString <> '' then
          TagCompleta('IE', preencheString(Copy(trocar(trocar(trocar(Notas.FieldByName('transportadora_ie').AsString,'.',''),'-',''),'/',''),1,14), ' ', 14, true));

        if Notas.FieldByName('transportadora_rua').AsString <> '' then
          TagCompleta('xEnder', Copy(Notas.FieldByName('transportadora_rua').AsString,1,60));
        if Notas.FieldByName('transportadora_nomecidade').AsString <> '' then
          TagCompleta('xMun',   Copy(Notas.FieldByName('transportadora_nomecidade').AsString,1,60));
        if Notas.FieldByName('transportadora_estado').AsString <> '' then
          TagCompleta('UF',     Notas.FieldByName('transportadora_estado').AsString);
        FechaTag('transporta')
      end;
      // retTransp ?
      if ((Notas.FindField('placa')             <> nil) and
          (Notas.FieldByName('placa').AsString       <> '')) and
         ((Notas.FindField('estadoplaca')       <> nil) and
          (Notas.FieldByName('estadoplaca').AsString <> '')) then
      begin
        AbreTag('veicTransp');
        TagCompleta('placa',  Copy(Notas.FieldByName('placa').AsString,1,8));
        TagCompleta('UF',     Notas.FieldByName('estadoplaca').AsString);
        if Notas.FieldByName('transportadora_rntc').AsString <> '' then
          TagCompleta('RNTC', Notas.FieldByName('transportadora_rntc').AsString);
        FechaTag('veicTransp')
      end;
      // reboque ?
      if (Volumes <> nil) and (Volumes.RecordCount > 0) then
      begin
        Volumes.First;
        while not Volumes.Eof do
        begin
          AbreTag('vol');
          if Volumes.FieldByName('volumes').AsCurrency > 0 then
            TagCompleta('qVol',  Volumes.FieldByName('volumes').AsString);
          if Volumes.FieldByName('especietransporte').AsString <> '' then
            TagCompleta('esp',   Copy(Volumes.FieldByName('especietransporte').AsString,1,60));
          if Volumes.FieldByName('marca').AsString <> ''then
            TagCompleta('marca', Copy(Volumes.FieldByName('marca').AsString,1,60));
          if Volumes.FieldByName('numeracao').AsString <> '' then
            TagCompleta('nVol',  Copy(Volumes.FieldByName('numeracao').AsString,1,60));
          if Volumes.FieldByName('pesoliquido').AsCurrency > 0 then
            TagCompleta('pesoL', Volumes.FieldByName('pesoliquido').AsCurrency,3);
          if Volumes.FieldByName('pesobruto').AsCurrency > 0 then
            TagCompleta('pesoB', Volumes.FieldByName('pesobruto').AsCurrency,3);
          if (Lacres <> nil) and (Lacres.RecordCount > 0) then
          begin
            Lacres.First;
            while not Lacres.Eof do
            begin
              if Lacres.FieldByName('codigovolume').AsInteger = Volumes.FieldByName('codigo').AsInteger then
              begin
                AbreTag('lacres');
                TagCompleta('nLacre', Copy(Lacres.FieldByName('lacre').AsString,1,60));
                FechaTag('lacres');
                Lacres.Next
              end
            end
          end;
          FechaTag('vol');
          Volumes.Next
        end
      end;
      FechaTag('transp')
    end;

    procedure DadosCobranca;
    var
      vVlrDesconto : Currency;
    begin
      vVlrDesconto := 0;
      if fModeloDoctoFiscal<>'65' then //NFC-e
        if (Venctos <> nil) and (venctos.RecordCount > 0) and
           (((Tipo ='S') and (Notas.FieldByName('valortotal').AsCurrency > 0)) or
            ((Tipo ='E') and (Notas.FieldByName('valornota').AsCurrency > 0))) then
        begin
          AbreTag('cobr');
          AbreTag('fat');

          if Notas.findfield('NrDocumento')<>nil then
            TagCompleta('nFat',     Notas.FieldByName('NrDocumento').AsString)
          else
            TagCompleta('nFat',     Notas.FieldByName('numero').AsString);

          vVlrDesconto := 0;
          if Notas.FindField('descontoitem')<>nil then
            if (Notas.FieldByName('desconto').AsCurrency + Notas.FieldByName('descontoitem').AsCurrency) > 0 then
              vVlrDesconto := Notas.FieldByName('desconto').AsCurrency + Notas.FieldByName('descontoitem').AsCurrency
          else
            if Notas.FieldByName('desconto').AsCurrency > 0 then
              vVlrDesconto := Notas.FieldByName('desconto').AsCurrency;

          if Tipo = 'S' then
            TagCompleta('vOrig', Notas.FieldByName('valortotal').AsCurrency + vVlrDesconto - vRetencoes,2)
          else
            TagCompleta('vOrig', Notas.FieldByName('valornota').AsCurrency + vVlrDesconto,2);

//          if vVlrDesconto > 0 then
            TagCompleta('vDesc', vVlrDesconto, 2);

          if Tipo ='S' then
            TagCompleta('vLiq',  Notas.FieldByName('valortotal').AsCurrency - vRetencoes ,2)
          else
            TagCompleta('vLiq',  Notas.FieldByName('valornota').AsCurrency,2);

          FechaTag('fat');
          Venctos.First;
          while not Venctos.Eof do
          begin
            AbreTag('dup');
            TagCompleta('nDup',  preencheString(Venctos.FieldByName('numero').AsString,'0',3, false));
            TagCompleta('dVenc', Venctos.FieldByName('datavencto').AsDateTime, 'yyyy-mm-dd');
            TagCompleta('vDup',  Venctos.FieldByName('valorvencto').AsCurrency,2);
            FechaTag('dup');
            Venctos.Next
          end;
          FechaTag('cobr')
        end
    end;


    procedure DadosCobrancaNFCe;
    begin
//      if fModeloDoctoFiscal='65' then //NFC-e
      AbreTag('pag');

        if (Notas.FieldByName('finalidadenf').AsString = '2') or  //complementar
           (Notas.FieldByName('finalidadenf').AsString = '3') or  //ajuste
           (Notas.FieldByName('finalidadenf').AsString = '4') then //devolução
        begin
          AbreTag('detPag');
            TagCompleta('tPag', '90');  //sempagamento

            if Tipo = 'S' then
                        //904	Rejeição: Informado indevidamente campo valor de pagamento
              TagCompleta('vPag',     0 {Notas.FieldByName('valortotal').AsCurrency},2)
            else
                          //904	Rejeição: Informado indevidamente campo valor de pagamento
              TagCompleta('vPag',     0 {Notas.FieldByName('valornota').AsCurrency},2);

          FechaTag('detPag');
        end
        else
        if (qryTotaisRecebimentos <> nil) and
           (qryTotaisRecebimentos.recordcount <> 0) then
        begin
          qryTotaisRecebimentos.first;
          while not qryTotaisRecebimentos.eof do
          begin

              AbreTag('detPag');

                if qryTotaisRecebimentos.fieldbyname('tiporecebimento').asString = 'D' then
                  TagCompleta('tPag', '01')  //dinheiro
                else
                if qryTotaisRecebimentos.fieldbyname('tiporecebimento').asString = 'C' then
                  TagCompleta('tPag', '03')  //credito
                else
                if qryTotaisRecebimentos.fieldbyname('tiporecebimento').asString = 'B' then
                  TagCompleta('tPag', '04')  //debito
                else
                if qryTotaisRecebimentos.fieldbyname('tiporecebimento').asString = 'H' then
                  TagCompleta('tPag', '02')  //cheque
                else
                if qryTotaisRecebimentos.fieldbyname('tiporecebimento').asString = 'T' then
                  TagCompleta('tPag', '05')  //credito loja
                else
                begin
                  TagCompleta('tPag', '99');  //outros
                  TagCompleta('xPag', 'Outros');
                end;

                TagCompleta('vPag', qryTotaisRecebimentos.FieldByName('valorlancto').AsCurrency,2);

                if (qryTotaisRecebimentos.findField('bandeiraoperadora')<>nil) and
                   (qryTotaisRecebimentos.findField('cnpjcredenciadora')<>nil) and
                   (qryTotaisRecebimentos.findField('nrautorizacaocartao')<>nil) then
                begin
                  if (qryTotaisRecebimentos.fieldbyname('bandeiraoperadora').asString<>'') and
                     (qryTotaisRecebimentos.fieldbyname('cnpjcredenciadora').asString<>'') and
                     (qryTotaisRecebimentos.fieldbyname('nrautorizacaocartao').asString<>'') then
                  begin
                    AbreTag('card');

                      if qryTotaisRecebimentos.fieldbyname('nrautorizacaocartao').asString <> '' then
                        TagCompleta('tpIntegra', '1')
                      else
                        TagCompleta('tpIntegra', '2');

           {Informar o CNPJ da instituição de pagamento, adquirente ou subadquirente.
            Caso o pagamento seja processado pelo intermediador da transação,
            informar o CNPJ deste (Atualizado na NT 2020.006)}

                      TagCompleta('CNPJ', qryTotaisRecebimentos.fieldbyname('cnpjcredenciadora').asString);
                      TagCompleta('tBand', qryTotaisRecebimentos.fieldbyname('bandeiraoperadora').asString);
                      TagCompleta('cAut', qryTotaisRecebimentos.fieldbyname('nrautorizacaocartao').asString);
//                      TagCompleta('vTroco', 0);

                    FechaTag('card');
                  end;
                end;

              FechaTag('detPag');
            qryTotaisRecebimentos.next;
          end;
        end
        else
        begin
          AbreTag('detPag');
            TagCompleta('tPag', '99');  //outros
            TagCompleta('xPag', 'Outros');

            if Tipo = 'S' then
              TagCompleta('vPag',     Notas.FieldByName('valortotal').AsCurrency,2)
            else
              TagCompleta('vPag',     Notas.FieldByName('valornota').AsCurrency,2);

          FechaTag('detPag');
        end;
        TagCompleta('vTroco', 0,2);
      FechaTag('pag');
    end;

    procedure infIntermed_;
    begin

      if (vIndPres = '2') or
         (vIndPres = '3') or
         (vIndPres = '4') or
         (vIndPres = '9') then
      begin

        with infIntermed[notas] do
        begin
          if indIntermed = '1' then
          begin
            AbreTag('infIntermed');
              TagCompleta('CNPJ', CNPJ );
              TagCompleta('idCadIntTran', idCadIntTran);
            FechaTag('infIntermed');
          end;
        end;
      end;
    end;

    procedure InformacoesAdicionais;
    var
      vInfComplementar: String;
      vpercTrib: Currency;

    begin

      if (notas.FindField('notaparcial')<>nil) and
          notas.Fieldbyname('notaparcial').AsBoolean then
        vInfComplementar := 'NOTA PARCIAL ' + sLineBreak;

      vInfComplementar := vInfComplementar + Copy(Notas.FieldByName('infcomplementar').AsString,1,5000);

      if  (Tipo = 'S') AND
          ((Notas.findfield('acrescimofinanceiro')<>nil) and
          (Notas.FieldByName('acrescimofinanceiro').AsCurrency<>0)) then
        vInfComplementar := vInfComplementar +
         ' O valor de R$ ' + FormatarValor(Notas.FieldByName('acrescimofinanceiro').AsCurrency,2) +
         ' referente ao acréscimo financeiro, esta incluido no campo outras despesas';

      if  (Tipo = 'S') AND
          ((Notas.findfield('desconto_cashback')<>nil) and
          (Notas.FieldByName('desconto_cashback').AsCurrency<>0)) then
        vInfComplementar := vInfComplementar +
         ' O valor de R$ ' + FormatarValor(Notas.FieldByName('desconto_cashback').AsCurrency,2) +
         ' referente a desconto de CashBack';


      if  (Tipo = 'E') AND
          ((Notas.findfield('acrescimo')<>nil) and
          (Notas.FieldByName('acrescimo').AsCurrency<>0)) then
        vInfComplementar := vInfComplementar +
         ' O valor de R$ ' + FormatarValor(Notas.FieldByName('acrescimo').AsCurrency,2) +
         ' referente ao acréscimo financeiro, esta incluido no campo outras despesas';

       if vSTringRetencoes <> '' then
       begin
         vInfComplementar := vInfComplementar + chr(13) + vSTringRetencoes;
       end;

      if ((Notas.findfield('valortotalimpostoibt')<>nil) and
          (Notas.FieldByName('valortotalimpostoibt').AsCurrency<>0)) and
          (Notas.FieldByName('finalidadenf').AsString<>'2') then
      begin
        vPercTrib := roundto(Notas.FieldByName('valortotalimpostoibt').AsCurrency / Notas.FieldByName('valortotal').AsCurrency * 100, -2);
        vInfComplementar := vInfComplementar +
                            'Trib Aprox R$ '+FormatarValor(Notas.FieldByName('valorimpostonacional').AsCurrency - Notas.FieldByName('valorimpostoestadual').AsCurrency,2) + ' Federal R$ '
                             + FormatarValor(Notas.FieldByName('valorimpostoestadual').AsCurrency,2) + ' Estadual ' + sLineBreak +
                             'Fonte: IBPT/FECOMERCIO ' +'        '+Produtos.FieldByName('chaveibpt').AsString;
      end;

      if (notas.findfield('ItensNumeroSeries')<>nil) then
        vInfComplementar := vInfComplementar + ' ' + notas.findfield('ItensNumeroSeries').asString;

      if vComplementoProdutos <> '' then
        vInfComplementar := vInfComplementar + vComplementoProdutos;

      if parsistema.ExibirVendedornaNFE then
      begin
        if DadosVendedor<>'' then

          if vInfComplementar <> '' then
            vInfComplementar := vInfComplementar + chr(13) + DadosVendedor
          else
            vInfComplementar := DadosVendedor;
      end;

      if (Trim(vInfComplementar)<>'') then
      begin
        AbreTag('infAdic');
        TagCompleta('infCpl', Copy(vInfComplementar,1,5000));
        FechaTag('infAdic')
      end

    end;

    procedure ComercioExterior;
    begin
      if (Tipo ='S') and
         (Notas.FieldByName('exportacoes_ufembarque').AsString    <> '') and
         (Notas.FieldByName('exportacoes_localembarque').AsString <> '') then
      begin
        AbreTag('exporta');
        TagCompleta('UFSaidaPais',   Notas.FieldByName('exportacoes_ufembarque').AsString);
        TagCompleta('xLocExporta', Copy(Notas.FieldByName('exportacoes_localembarque').AsString,1,60));
        FechaTag('exporta')
      end
    end;

    procedure InformacaoResponsavelTecnico;
    begin
      AbreTag('infRespTec');
        TagCompleta('CNPJ', '85280642000144');
        TagCompleta('xContato', 'LÚCIO WATERKEMPER');
        TagCompleta('email', 'lucio@tecsoft.com.br');
        TagCompleta('fone', '04830252861');
      FechaTag('infRespTec');
    end;



  begin

    Local := 'Identificação NFE';
    IdentificacaoNotaFiscalEletronica;  //B01

    local := 'Emitente';
    IdentificacaoEmitente;  //C01

    local := 'Destinatário';
    IdentificacaoDestinatario;  //E01

    local := 'Local de retirada';
    IdentificacaoRetirada;

    local := 'Local de entrega';
    IdentificacaoEntrega;

    local := 'Autorização para obter XML';
    IdentificacaoAutorizacaoObterXML;

    local := 'Detalhamento dos ítens';
    Detalhamento;

    local := 'Totalização';
    ValoresTotais;

    local := 'Transporte';
    InformacoesTransporte;

    local := 'Cobrança';
    DadosCobranca;

    local := 'Cobrança NFC-e';
    DadosCobrancaNFCe;

    local := 'Grupo de Informações do Intermediador da Transação';
    infIntermed_;

    local := 'Adicionais';
    InformacoesAdicionais;

    local := 'Comércio exterior';
    ComercioExterior;

    Local := 'Responsável técnico';
    InformacaoResponsavelTecnico;

    local := '';

    FechaTag('infNFe')
  end;

  procedure IniciarNFe;
  begin
    if notas.FieldByName('numprotocolonfe').asstring = '' then
    begin
      notas.Edit;

      if not ((Notas.FieldByName('formaemissao').asstring='9') and
              (Notas.FieldByName('modelodocto').asstring='65')) or
              notas.FieldByName('datahoraemissao').isnull then
        notas.FieldByName('datahoraemissao').AsDateTime := vdatahoraservidor;

      notas.FieldByName('hSaiEnt').AsDateTime := vdatahoraservidor;
//      notas.Post;
    end;

    Case TipoNota of
      Eletronica_Conujugada:
      begin

        if FileExists(ArqEnvio) then
          DeleteFile(ArqEnvio);
        if FileExists(ArqErro) then
          DeleteFile(ArqErro);

        AssignFile(xml, DirEnvio+nfe_temp);
        Rewrite(xml);

        Write(xml, '<?xml version="1.0" encoding="UTF-8"?>');

        AbreTag('NFe', ['xmlns'],
                       ['http://www.portalfiscal.inf.br/nfe']);

        AbreTag('infNFe', ['versao','Id'], ['4.00','NFe' + ChaveNFe]);
        InformacoesNotaFiscalEletronica; //A01
      end;

      Outras:
      begin

        with ACBrNFSe do
        begin
          with NotasFiscais do
          begin
            Clear;
            NumeroLote:='1';
            Transacao := True;
            with NotasFiscais.Add.NFSe do
            begin
              IdentificacaoRps.Numero := FormatFloat('#########0', Notas.FieldByName('NrDocumento').AsInteger);
              // Para o provedor ISS.NET em ambiente de Homologação mudar a série para '8'
              IdentificacaoRps.Serie := SerieSugestao;
              // TnfseTipoRPS = ( trRPS, trNFConjugada, trCupom );
              IdentificacaoRps.Tipo := trRPS;
              DataEmissao := Date;
              // TnfseNaturezaOperacao = ( noTributacaoNoMunicipio, noTributacaoForaMunicipio, noIsencao, noImune, noSuspensaDecisaoJudicial, noSuspensaProcedimentoAdministrativo );
//              NaturezaOperacao := noTributacaoNoMunicipio;
              // NaturezaOperacao := noTributacaoNoMunicipio51;
              // TnfseRegimeEspecialTributacao = ( retNenhum, retMicroempresaMunicipal, retEstimativa, retSociedadeProfissionais, retCooperativa, retMicroempresarioIndividual, retMicroempresarioEmpresaPP );
              // RegimeEspecialTributacao := retNenhum;
              RegimeEspecialTributacao := retMicroempresaMunicipal;

              // TnfseSimNao = ( snSim, snNao );
              if ( FEmit_CRT = 1) then
                OptanteSimplesNacional := snSim
              else
                OptanteSimplesNacional := snNao;

              // TnfseSimNao = ( snSim, snNao );
              IncentivadorCultural := snSim;

              {1 - PRODUÇÃO 2 - HOMOLOGAÇÃO}
              if Notas.FieldByName('ambientenfs').AsString = '1' then
                // TnfseSimNao = ( snSim, snNao );
                // snSim = Ambiente de Produção
                // snNao = Ambiente de Homologação
                Producao := snSim
              else
                Producao := snNao;

              // TnfseStatusRPS = ( srNormal, srCancelado );
              Status := srNormal;

              // Somente Os provedores Betha, FISSLex e SimplISS permitem incluir no RPS
              // a TAG: OutrasInformacoes os demais essa TAG é gerada e preenchida pelo
              // WebService do provedor.
              if (vProvedor = 'Betha') or
                 (vProvedor = 'FISSLex') or
                 (vProvedor = 'SimplISS') then
                OutrasInformacoes := Notas.FieldByName('infcomplementar').AsString;

              Servico.Valores.ValorServicos          := notas.fieldbyname('valorservicos').AsCurrency;

              if Notas.FieldByName('issqnbasecalculo').AsCurrency <> 0 then
                Servico.Valores.ValorDeducoes        := notas.fieldbyname('valorservicos').AsCurrency - Notas.FieldByName('issqnbasecalculo').AsCurrency
              else
                Servico.Valores.ValorDeducoes        := 0.00;

              Servico.Valores.ValorPis               := Notas.FieldByName('totalvalorpis_servicos').AsCurrency;
              Servico.Valores.ValorCofins            := Notas.FieldByName('totalvalorcofins_servicos').AsCurrency;
              Servico.Valores.ValorInss              := 0.00;
              Servico.Valores.ValorIr                := 0.00;
              Servico.Valores.ValorCsll              := 0.00;


              // TnfseSituacaoTributaria = ( stRetencao, stNormal, stSubstituicao );
              // stRetencao = snSim
              // stNormal   = snNao

              // Neste exemplo não temos ISS Retido ( stNormal = Não )
              // Logo o valor do ISS Retido é igual a zero.

              if Servicos.FieldByName('reterissqn').AsBoolean then
              begin
                Servico.Valores.IssRetido              := stRetencao;
                Servico.Valores.ValorIssRetido         := Notas.FieldByName('valorISSQN').AsCurrency;
              end
              else
              begin
                Servico.Valores.IssRetido              := stNormal;
                Servico.Valores.ValorIssRetido         := 0.00;
              end;

              Servico.Valores.OutrasRetencoes        := 0.00;
              Servico.Valores.DescontoIncondicionado := 0.00;
              Servico.Valores.DescontoCondicionado   := 0.00;

              Servico.Valores.BaseCalculo := Notas.FieldByName('issqnbasecalculo').AsCurrency;
                                            {Servico.Valores.ValorServicos -
                                             Servico.Valores.ValorDeducoes -
                                             Servico.Valores.DescontoIncondicionado;}

              // No caso do provedor Ginfes devemos informar a aliquota já dividida por 100
              // para outros provedores devemos informar por exemplo 3, mas ao fazer o calculo
              // do valor do ISS devemos dividir por 100

              if vprovedor = 'Ginfes' then
                Servico.Valores.Aliquota    := Servicos.FieldByName('aliquotaissqn').AsCurrency/100
              else
                Servico.Valores.Aliquota    := Servicos.FieldByName('aliquotaissqn').AsCurrency;

              // Valor do ISS calculado multiplicando-se a base de calculo pela aliquota
              // ValorISS := Servico.Valores.BaseCalculo * Servico.Valores.Aliquota;

              // A função RoundTo5 é usada para arredondar valores, sendo que o segundo
              // parametro se refere ao numero de casas decimais.
              // exemplos: RoundTo5(50.532, -2) ==> 50.53
              // exemplos: RoundTo5(50.535, -2) ==> 50.54
              // exemplos: RoundTo5(50.536, -2) ==> 50.54

              Servico.Valores.ValorIss       := Notas.FieldByName('valorISSQN').AsCurrency;

              Servico.Valores.ValorLiquidoNfse := Servico.Valores.ValorServicos -
                                                 Servico.Valores.ValorPis -
                                                 Servico.Valores.ValorCofins -
                                                 Servico.Valores.ValorInss -
                                                 Servico.Valores.ValorIr -
                                                 Servico.Valores.ValorCsll -
                                                 Servico.Valores.OutrasRetencoes -
                                                 Servico.Valores.ValorIssRetido -
                                                 Servico.Valores.DescontoIncondicionado -
                                                 Servico.Valores.DescontoCondicionado;

              Servico.ItemListaServico         := Servicos.FieldByName('servico').AsString;

              // Para o provedor ISS.NET em ambiente de Homologação
              // o Codigo CNAE tem que ser '6511102'
              // Servico.CodigoCnae                := '123'; // Informação Opcional
              // Servico.CodigoTributacaoMunicipio := '118879';
              Servico.Discriminacao             := Servicos.FieldByName('descricao').AsString;

              // Para o provedor ISS.NET em ambiente de Homologação
              // o Codigo do Municipio tem que ser '999'
              Servico.CodigoMunicipio := FEmit_CodMun;

              // Informar A Exigibilidade ISS para fintelISS [1/2/3/4/5/6/7]
              Servico.ExigibilidadeISS := exiExigivel;

              // Informar para Saatri
              Servico.CodigoPais := 1058; // Brasil
              Servico.MunicipioIncidencia := StrToIntDef(FEmit_CodMun, 0);

             // Somente o provedor SimplISS permite infomar mais de 1 serviço
              with Servico.ItemServico.Add do
              begin
                Descricao     := Servicos.FieldByName('descricao').AsString;
                Quantidade    := Servicos.FieldByName('quantidade').Asinteger;
                ValorUnitario := Servicos.FieldByName('valorservico').Asfloat;
              end;

              Prestador.Cnpj               := preencheString(SomenteNumero(FEmit_Documento),'0',14,False);
              if Emit_IM <> '' then
                Prestador.InscricaoMunicipal := Emit_IM;

              // Para o provedor ISSDigital deve-se informar também:
              //Prestador.Senha        := 'senha';
              //Prestador.FraseSecreta := 'frase secreta';
              //Prestador.cUF          := 33;

              PrestadorServico.Endereco.CodigoMunicipio := FEmit_CodMun;
              PrestadorServico.RazaoSocial := FEmit_Nome;

              if (FDest_TipoPessoa = 'F') then
              begin
                if HeUnidadeFederacao(FDest_UF) then
                  Tomador.IdentificacaoTomador.CpfCnpj := preencheString(SomenteNumero(FDest_Documento),'0',11,False)
               else
                  Tomador.IdentificacaoTomador.CpfCnpj := '';
              end
              else
              begin
                if HeUnidadeFederacao(FDest_UF) then
                  Tomador.IdentificacaoTomador.CpfCnpj := preencheString(SomenteNumero(FDest_Documento),'0',14,False)
                else
                  Tomador.IdentificacaoTomador.CpfCnpj := '';
              end;

              if notas.fieldbyname('inscricaomunicipal').asstring<> '' then
                Tomador.IdentificacaoTomador.InscricaoMunicipal := notas.fieldbyname('inscricaomunicipal').asstring;

              Tomador.RazaoSocial := FDest_Nome;

              Tomador.Endereco.Endereco        := FDest_Rua;
              Tomador.Endereco.Numero          := FDest_Nro;
              Tomador.Endereco.Complemento     := FDest_Compl;
              Tomador.Endereco.Bairro          := FDest_Bairro;

              Tomador.Endereco.CodigoMunicipio := FDest_CodMun;

              if HeUnidadeFederacao(FDest_UF) then
                Tomador.Endereco.UF :=   FDest_UF
              else
                Tomador.Endereco.UF := 'EX';

              Tomador.Endereco.CEP             := preencheString(FDest_CEP,'0',8,False);
              //Provedor Equiplano é obrigatório o pais e IE
              Tomador.Endereco.xPais           := 'BRASIL';
              Tomador.IdentificacaoTomador.InscricaoEstadual := FDest_IE;

              Tomador.Contato.Telefone := contatos.fieldbyname('email').AsString;
              Tomador.Contato.Email    := contatos.fieldbyname('foneddd').AsString+contatos.fieldbyname('fonenumero').asstring;

              (* Usando quando houver um intermediario na prestação do serviço
              IntermediarioServico.RazaoSocial        := 'razao';
              IntermediarioServico.CpfCnpj            := '00000000000';
              IntermediarioServico.InscricaoMunicipal := '12547478';
              *)

              (* Usando quando o serviço for uma obra
              ConstrucaoCivil.CodigoObra := '88888';
              ConstrucaoCivil.Art        := '433';
              *)


//              Items[0].SaveToFile;
//              Gerarlote(StrToInt('1'));
//              WebServices.Gera(1);
//                GerarRPS;
                WebServices.Geralote(1);
//              WebServices.EnviaSincrono('1');
            end;
          end;
        end;
      end;

      Eletronica_Betha_Sistemas:
      begin
        fArqEnvioNFSe := ArqEnvioNFSe(notas,qryNotas);

        if FileExists(fArqEnvioNFSe) then
          DeleteFile(fArqEnvioNFSe);

        AssignFile(xml, FDirEnvioNFSe+nfse_temp);
        Rewrite(xml);

        Write(xml, '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>');

        AbreTag('InfRequisicao', ['xmlns', 'xmlns:dsig'],
                       ['http://nfe.pmf.sc.gov.br/nfse/versao?tipo=xsd-2_0',
                        'http://www.w3.org/2000/09/xmldsig#']);

          TagCompleta('Versao','2.0');
          TagCompleta('TipoSistema','1');
          TagCompleta('Identificacao', Notas.fieldbyname('numero').asstring);
          AbreTag('AEDF');
            TagCompleta('AEDF', aedffatura);
            TagCompleta('TipoAedf', 'FATURA');
          FechaTag('AEDF');
          TagCompleta('DataEmissao', Notas.FieldByName('data').AsDateTime, 'yyyy-mm-dd');
          TagCompleta('CFPS',  Notas.FieldByName('cfps').AsString);

          AbreTag('DadosServico');
            AbreTag('ItemServico');
              Servicos.First;
              while not servicos.Eof do
              begin
                TagCompleta('IdCNAE', servicos.fieldbyname('cnae').asstring);
                TagCompleta('CodigoAtividade', servicos.fieldbyname('codigoatividade').asstring);
                TagCompleta('DescricaoServico', servicos.fieldbyname('descricao').asstring);
                TagCompleta('CST', servicos.fieldbyname('cstissqn').asstring);
                TagCompleta('Aliquota', (servicos.fieldbyname('aliquotaissqn').AsCurrency/100),4);
                TagCompleta('ValorUnitario', servicos.fieldbyname('valorservico').AsCurrency,2);
                TagCompleta('Quantidade', servicos.fieldbyname('quantidade').asstring);
                TagCompleta('ValorTotal', (servicos.fieldbyname('valorservico').AsCurrency * servicos.fieldbyname('quantidade').asinteger), 2);
                servicos.next;
              end;
            FechaTag('ItemServico');

            TagCompleta('BaseCalculo', notas.fieldbyname('issqnbasecalculo').AsCurrency, 2);
            TagCompleta('ValorISSQN', notas.fieldbyname('valorissqn').AsCurrency, 2);
            TagCompleta('ValorTotalServicos', notas.fieldbyname('valorservicos').AsCurrency, 2);
          FechaTag('DadosServico');

          AbreTag('Tomador');
            AbreTag('IdentificacaoTomador');
              AbreTag('DocIdTomador');
                AbreTag('CPFCNPJ');

                  if (FDest_TipoPessoa = 'F') then
                  begin
                    if HeUnidadeFederacao(FDest_UF) then
                      TagCompleta('CPF',  preencheString(SomenteNumero(FDest_Documento),'0',11,False))
                    else
                      TagCompleta('CPF', '', false);  //coneudo vazio
                  end
                  else
                  begin
                    if HeUnidadeFederacao(FDest_UF) then
                      TagCompleta('CNPJ', preencheString(SomenteNumero(FDest_Documento),'0',14,False))
                    else
                      TagCompleta('CNPJ', '', false);  //coneudo vazio
                  end;

                FechaTag('CPFCNPJ');
              FechaTag('DocIdTomador');

              if notas.fieldbyname('inscricaomunicipal').asstring<> '' then
                TagCompleta('InscricaoMunicipal', notas.fieldbyname('inscricaomunicipal').asstring);

            FechaTag('IdentificacaoTomador');
            TagCompleta('RazaoSocial',  FDest_Nome);
            AbreTag('Endereco');
              TagCompleta('Logradouro',   FDest_Rua);

              if FDest_Nro<>'' then
                TagCompleta('NumeroEndereco',    FDest_Nro, false);

              TagCompleta('Bairro',FDest_Bairro);

              AbreTag('Municipio');
                TagCompleta('CodigoMunicipio', FDest_CodMun);
              FechaTag('Municipio');

              AbreTag('CodigoPostal');
                TagCompleta('CEP',  preencheString(FDest_CEP,'0',8,False));
              FechaTag('CodigoPostal');

              if HeUnidadeFederacao(FDest_UF) then
                TagCompleta('UF',   FDest_UF)
              else
                TagCompleta('UF',   'EX');

            FechaTag('Endereco');

            contatos.first;
            if not contatos.isempty and
              (contatos.fieldbyname('email').AsString<>'') and
              (contatos.fieldbyname('fonenumero').asstring<>'') then
            begin
              AbreTag('Contato');
                TagCompleta('Email',  contatos.fieldbyname('email').AsString);
                TagCompleta('Telefone', somentenumero(contatos.fieldbyname('foneddd').AsString)+somentenumero(contatos.fieldbyname('fonenumero').asstring));
              FechaTag('Contato');
            end;
          FechaTag('Tomador');
        FechaTag('InfRequisicao');
      end;

      Florianopolis_SoftPlan:
      begin

        fArqEnvioNFSe := ArqEnvioNFSe(notas,qryNotas);
        if FileExists(fArqEnvioNFSe) then
          DeleteFile(fArqEnvioNFSe);

        AssignFile(xml, FDirEnvioNFSe+nfse_temp);
        Rewrite(xml);

        InfomrmacoesNFSEFlorianopolis;
      end;

      Palhoca_IPM:
      begin

        fArqEnvioNFSe := ArqEnvioNFSe(notas,qryNotas);
        if FileExists(fArqEnvioNFSe) then
          DeleteFile(fArqEnvioNFSe);

        AssignFile(xml, FDirEnvioNFSe+nfse_temp);
        Rewrite(xml);

        InfomrmacoesNFSEPalhoca(Notas, qryNotas, servicos); 


      end;

    end;
  end;

  function FinalizarNfe: Boolean;
  var
    vRetornoHTTPPost : String;

    json: TJson;
    val: TJsonValue;


  begin
    result := true;

    Case TipoNota of
      Eletronica_Conujugada:
      begin
        FechaTag('NFe');
        CloseFile(xml);
        RenameFile(DirEnvio+nfe_temp,ArqEnvio);
      end;

      Eletronica_Betha_Sistemas:
      begin
        CloseFile(xml);
        RenameFile(FDirEnvioNFSe+nfse_temp,fArqEnvioNFSe);
      end;

      Florianopolis_SoftPlan:
      begin
        try

          try

            CloseFile(xml);
            RenameFile(FDirEnvioNFSe+nfse_temp,fArqEnvioNFSe);
            InstanciarObjetosNFPS(notas.fieldbyname('filialemissao').asinteger);
            if not assigned(ACBrDFe) then
              ACBrDFe := TACBrDFe.create(nil);
            ACBrDFe.SSL.ArquivoPFX := fCertificadoDigitalNFSe;
            ACBrDFe.SSL.senha := DadosdaFilial('senhacertificadodigital', notas.fieldbyname('filialemissao').asinteger);
            ACBrDFe.Configuracoes.Geral.SSLLib := libWinCrypt;
            XMLStr := tstringlist.create;
            XMLUTF8_ := LerConteudoArquivo(farqEnvioNFSe);
            XMLUTF8 := ConverteXMLtoUTF8(XMLUTF8_);
            XMLAss := ACBrDFe.SSL.Assinar(XMLUTF8, 'xmlProcessamentoNfpse', 'valorTotalServicos');

            XMLStr.Clear;
            XMLStr.Text := XMLAss;
            XMLStr.SaveToFile(farqEnvioNFSe);
            XMLStr.Free;

            res := FOAuthClient.Post(DadosdaFilial('urlprocessamento_normal', notas.fieldbyname('filialemissao').asinteger), farqEnvioNFSe);

            if res.Code = HTTP_OK then
            begin
              GravarArquivoxml(ArqRetornoNFSe(notas, qryNotas), res.Body, false);
              SalvarDadosToken(notas.fieldbyname('filialemissao').asinteger);
              result := RetornoCamposNFPSe(notas, qryNotas);

              if result then
                result := GravarArquivoxml(ArqRetornoNFSe(notas,qryNotas), res.Body, true);

              if result then
                NomedoArquivoCompartilhado := ArqRetornoNFSe(notas, qryNotas)
              else
                NomedoArquivoCompartilhado := '';

            end
            else
            begin
              GravarArquivoxml(ArqErroRetornoNFSe(notas, qrynotas), res.Body);
              result := false;
              erro :=  ConteudomsgNodeXmlNFSe(res.Body);
              if erro = '' then
                erro := res.Body;

              MensagemErro(Format('Erro (%d): %s', [res.Code, erro]))

            end;

          except
            on E: Exception do
            begin
              result := false;
              MensagemErro(Format('Error: %s', [E.Message]));

            end;
          end;

        finally
          ReadStreams;
        end;

      end;

      Palhoca_IPM:

      (*
      begin
        try

          try

            CloseFile(xml);
            RenameFile(FDirEnvioNFSe+nfse_temp,fArqEnvioNFSe);
            InstanciarObjetosNFPS(notas.fieldbyname('filialemissao').asinteger);
            {
            if not assigned(ACBrDFe) then
              ACBrDFe := TACBrDFe.create(nil);
            ACBrDFe.SSL.ArquivoPFX := fCertificadoDigitalNFSe;
            ACBrDFe.SSL.senha := DadosdaFilial('senhacertificadodigital', notas.fieldbyname('filialemissao').asinteger);
            ACBrDFe.Configuracoes.Geral.SSLLib := libWinCrypt;
            XMLStr := tstringlist.create;
            XMLUTF8_ := LerConteudoArquivo(farqEnvioNFSe);
            XMLUTF8 := ConverteXMLtoUTF8(XMLUTF8_);
            XMLAss := ACBrDFe.SSL.Assinar(XMLUTF8, 'xmlProcessamentoNfpse', 'valorTotalServicos');

            XMLStr.Clear;
            XMLStr.Text := XMLAss;
            XMLStr.SaveToFile(farqEnvioNFSe);
            XMLStr.Free;
            }

            res := FOAuthClient.Post(DadosdaFilial('site_nfse', notas.fieldbyname('filialemissao').asinteger), farqEnvioNFSe);

            if res.Code = HTTP_OK then
            begin
              GravarArquivoxml(ArqRetornoNFSe(notas, qryNotas), res.Body, false);
  //            SalvarDadosToken(notas.fieldbyname('filialemissao').asinteger);
              result := RetornoCamposNFPSe(notas.fieldbyname('numero').asString);

              if result then
                result := GravarArquivoxml(ArqRetornoNFSe(notas,qryNotas), res.Body, true);

              if result then
                NomedoArquivoCompartilhado := ArqRetornoNFSe(notas, qryNotas)
              else
                NomedoArquivoCompartilhado := '';

            end
            else
            begin
              GravarArquivoxml(ArqErroRetornoNFSe(notas, qrynotas), res.Body);
              result := false;
              erro :=  ConteudomsgNodeXmlNFSe(res.Body);
              if erro = '' then
                erro := res.Body;

              MensagemErro(Format('Erro (%d): %s', [res.Code, erro]))

            end;

          except
            on E: Exception do
            begin
              result := false;
              MensagemErro(Format('Error: %s', [E.Message]));

            end;
          end;

        finally
          ReadStreams;
        end;

      end;
      *)


      begin
        try

          try

            CloseFile(xml);
            RenameFile(FDirEnvioNFSe+nfse_temp,fArqEnvioNFSe);

            InstanciarObjetosNFPS(notas.fieldbyname('filialemissao').asinteger);

            if DadosdaFilial('senhacertificadodigital', notas.fieldbyname('filialemissao').asinteger) <> null then
            begin
              if not assigned(ACBrDFe) then
                ACBrDFe := TACBrDFe.create(nil);

              ACBrDFe.SSL.ArquivoPFX := fCertificadoDigitalNFSe;
              ACBrDFe.SSL.senha := DadosdaFilial('senhacertificadodigital', notas.fieldbyname('filialemissao').asinteger);
              ACBrDFe.Configuracoes.Geral.SSLLib := libWinCrypt;
              XMLStr := tstringlist.create;
              XMLUTF8_ := LerConteudoArquivo(farqEnvioNFSe);
              XMLUTF8 := ConverteXMLtoUTF8(XMLUTF8_);
              XMLAss := ACBrDFe.SSL.Assinar(XMLUTF8, 'nfse', 'itens');

              XMLStr.Clear;
              XMLStr.Text := XMLAss;
              XMLStr.SaveToFile(farqEnvioNFSe);
              XMLStr.Free;
            end;

//            objFORM.AddFile('f1', farqEnvioNFSe , 'plain/text');
            
//            objFORM.Clear;
            objFORM.AddFile('f1', farqEnvioNFSe , 'text/xml');


            result := true;


            try
              vRetornoHTTPPost := objHTTP.Post(DadosdaFilial('site_nfse', notas.fieldbyname('filialemissao').asinteger), objFORM);
            except
              on E:Exception do
                begin
                  result := false;
                  if Pos('404' , E.Message) > 0 then
                    E.Message := 'URL não encontrada ('+ DadosdaFilial('site_nfse', notas.fieldbyname('filialemissao').asinteger)+')';

                  MensagemErro('Erro: ' + E.Message);
                end;
            end;

            objFORM.free;

            if (vRetornoHTTPPost<>'') and
               (copy(trim(vRetornoHTTPPost),1,1)='{') //Saber se é JSON

               then
            begin
              json := TJson.Create;
              try
                json.Parse(vRetornoHTTPPost);
                val := json.GetValue('code',1);

                if (val.Kind = JVKNumber) then
                  if json.Output.Numbers[val.Index]=401 then
                  begin
                     result := false;
                     MensagemErro('Não foi possível conectar ao webservice: Acesso Negado!')
                  end;
              finally
                json.Free;
              end;
            end
            else
            if vRetornoHTTPPost='' then
            begin
              //Uma possibilidade
              result := false;
              MensagemErro('Nenhum retorno ao postar a informação.')
            end;

            if result then
            begin

              result := GravarArquivoxml(ArqRetornoNFSe(notas,qryNotas), vRetornoHTTPPost, true);


              if result then
                result := RetornoCamposNFPSe(notas, qryNotas);

              if result then
                NomedoArquivoCompartilhado := ArqRetornoNFSe(notas, qryNotas)
              else
                NomedoArquivoCompartilhado := '';

              if not result then
                 MensagemErro(Format('Erro: %s', [Retorno_Mensagem_Codigo]))
            end
            else
            begin
              GravarArquivoxml(ArqErroRetornoNFSe(notas, qrynotas), vRetornoHTTPPost);
              erro :=  ConteudomsgNodeXmlNFSe(vRetornoHTTPPost);

              if erro = '' then
                erro := vRetornoHTTPPost;

              MensagemErro(Format('Erro: %s', [erro]))
            end;

          except
            on E: Exception do
            begin
              result := false;
              MensagemErro(Format('Error: %s', [E.Message]));
            end;
          end;

        finally
          ReadStreams;
        end;

      end;

    end;
  end;



begin
  self.pDataBase := TtecDatabase(Notas.DataBase);
  
  vComplementoProdutos := '';

  fAmbiente := Notas.FieldByName('ambiente').AsString;
  fModeloDoctoFiscal := Notas.FieldByName('modelodocto').AsString;
  fFormaEmissao := Notas.FieldByName('formaemissao').asString;

  Result := True;
  try
    if not Validando then
    begin

      IniciarNFe;
      result := FinalizarNFe;

    end
    else
    begin
      Case TipoNota of
        Eletronica_Conujugada: InformacoesNotaFiscalEletronica; //A01
        Florianopolis_SoftPlan: InfomrmacoesNFSEFlorianopolis;
        Palhoca_IPM: InfomrmacoesNFSEPalhoca(Notas, qryNotas, servicos);
      end;

      result := qryListaErros.IsEmpty;
      if not result then
      begin
        Notas.Transaction.Rollback;
        frmMensagemGridNfe := TfrmMensagemGridNfe.Create(frmMensagemGridNfe);
        frmMensagemGridNfe.dsrListaErros.DataSet := qryListaErros;
        frmMensagemGridNfe.ShowModal;
      end;

      {
      if result then
      begin

        Case TipoNota of
          Palhoca_IPM: begin
                         try
                           AnularValidando := true;
                           IniciarNFe;
                         finally
                           AnularValidando := False;
                         end;

                         FinalizarNFe;
                       end;
        end;

      end;
      }


    end;
  except
    on E: Exception do
    begin
      MensagemAviso_(E.ClassName + 'erro na emissão da NFE: ' + E.Message, false, ExibirMsgNFe);
      Result := False
    end
  end

end;

