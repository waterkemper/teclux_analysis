const
  delay = 1000;  // TEMPO DE ESPERA PARA LIBERAÇÃO DO ARQUIVO DE RETORNO OU ERRO PELO UNINFE

  {----- CONSTANTES QUE REPRESENTAM O RESULTADO DO PROCESSAMENTO DA SOLICITAÇÃO -----}
  nfeAutorizado             = '100';  ///  Autorizado o uso da NF-e
  nfeCancelamentoHomologado = '101';  ///  Cancelamento de NF-e homologado
  nfeInutilizacaoHomilogado = '102';  ///  Inutilização de número homologado
  nfeLoteRecebidoComSucesso = '103';  ///  Lote recebido com sucesso
  nfeLoteProcessado         = '104';  ///  Lote processado
  nfeLoteEmProcessamento    = '105';  ///  Lote em processamento
  nfeLoteNaoLocalizado      = '106';  ///  Lote não localizado
  nfeServicoEmOperacao      = '107';  ///  Serviço em Operação
  nfeServicoParadoMomento   = '108';  ///  Serviço Paralisado Momentaneamente (curto prazo)
  nfeServicoParadoSemPrev   = '109';  ///  Serviço Paralisado sem Previsão
  nfeUsoDenegado            = '110';  ///  Uso Denegado
  nfeCadastroUmaOcorrencia  = '111';  ///  Consulta cadastro com uma ocorrência
  nfeCadastroMaisOcorrencia = '112';  ///  Consulta cadastro com mais de uma ocorrência

  sqlErros = ' select cast(null as varchar(100)) as localizacao,       '+
