  vTtecRetornoEnvioNFCe: TtecRetornoEnvioNFCe;


  FDirEnvio,
  FDirEnviado,
  FDirRetorno,
  fDirErros,
  FDirCompartilha,
  FDirEnvioNFSe,
  FDirRetornoNFSe,
  FDirErroNFSe : String;

  xml: TextFile;
  vDataHoraServidor : function : TDateTime;
  Nfe: TTecNotaFiscalEletronica;

  ValorCampodaTabela_: function (NomedaTabela: String; Chaves: array of String;
                                 Valores: array of Variant;
                                 CamposaRetornar: array of String;
                                 Condicao: String = ''
                                 ): TVariantArray;

  (*
  GerarNotaEletronica: function (qryDadosFiscais,
                              qryDadosFiscaisRef,
                              qryProdutosDadosFiscais,
                              qryProdutosDadosFiscaisCompostos,
                              qryServicosDadosFiscais,
                              qryVenctosDadosFiscais,
                              qryVolumesDadosFiscais,
                              qryLacresDadosFiscais,
                              qryImportacoes,
                              qryAdicoes : TtecQuery;
                              SerieSugestao, Tipo: String;
                              qryCupons: TTecQuery = nil;
                              Regerando: boolean = false;
                              qryContatos: TTecQuery = nil;
                              qryTotaisRecebimentos: TTecQuery = nil;
