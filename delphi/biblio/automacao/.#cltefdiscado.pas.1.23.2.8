function TtecTEFDiscado.ExecutarOperacao(TipoOperacao: TtecTEFOperacao; QtdadeCartoes: Integer): Boolean;
var
//  CodigoErro: TtecErroTEF;
  Texto: String;
begin
  if Assigned(frmMsg) then
    frmMsg.Free;
  NovoNumeroSequencia;
  TipoOperacaoGlobal:=TipoOperacao;
  if TipoOperacao = sopCARTAO then
  begin

    if assigned(ECFPadrao) then
      result := TEFPadrao.CRT( fValorTransacao ,'02', ECFPadrao.NumCOO)
    else
    begin
      tefpadrao.ComprovanteOK := false;
      result := TEFPadrao.CRT( fValorTransacao ,'02', '');
    end;

    (*
    HeaderEnviado := 'CRT';
//    Result := PreencherRequesicao(HeaderEnviado, ['003-000 = ' + ValorTransacao, '777-777 = TESTE REDECARD']);
    Result := PreencherRequesicao(HeaderEnviado, ['003-000 = ' + ValorTransacao]);
    *)

  end
  else if TipoOperacao = sopCHEQUE then
  begin
    if assigned(ECFPadrao) then
      result := TEFPadrao.CHQ( fValorTransacao ,'03', ECFPadrao.NumCOO)
    else
      result := TEFPadrao.CHQ( fValorTransacao ,'03', '')

    {
    HeaderEnviado := 'CHQ';
    Result := PreencherRequesicao(HeaderEnviado, ['003-000 = ' + ValorTransacao]);
    }

  end
  else if TipoOperacao = sopADMIN then
  begin
    ECFPadrao.FecharRelatorioGerencial;
//      ECFPadrao.FechaNaoFiscal;
    HeaderEnviado := 'ADM';
    Result := PreencherRequesicao(HeaderEnviado, []);
  end
  else
    Result := False;

  if Result and not ((TipoOperacao = sopCARTAO) or (TipoOperacao = sopCHEQUE)) then
  begin
    if EsperandoRespostaTEF then
    begin
      if InterpretarResposta(False) then
      begin
        if QtdadeCartoes > 0 then
        begin
          SetLength(FFormasPagto, QtdadeCartoes);
          FFormasPagto[QtdadeCartoes - 1].NomeRede       := NomeRede;
          FFormasPagto[QtdadeCartoes - 1].Valor          := FValorTransacao;
        end;

        if HeaderEnviado = 'ADM' then
          if assigned(ECFPadrao) then
            if ECFPadrao.CupomAberto then
              ECFPadrao.CancelarCupom
            else
              ECFPadrao.FecharRelatorioGerencial;

        FValorParcialCartoes := FValorParcialCartoes + FValorTransacao;
        if FQtdadeComprovantes = 0 then
        begin
          if TextoOperador <> '' then
            MensagemAviso(TextoOperador);
          ApagarArquivo(FDirResp+NomeArq);
          Result := False;  // Nao deve haver impressao de cupom qdo campo28 = 0, talvez result := not header = 'ADM'
        end else if (HeaderEnviado = 'CRT') and (Abs(ValorTotalCartoes - FValorParcialCartoes) >= 0.01) then
        begin    // CASO NAO SEJA A ULTIMA TRANSACAO
          Texto := TextoOperador;
          if Texto <> '' then
          begin
{            frmMsg := TfrmMensagemTemporizada.Create(Screen.ActiveForm, Texto);
            frmMsg.Show;
            frmMsg.SetFocus;
}           ExibirMensagemTemporizada;
            Application.ProcessMessages;
          end;
          Result := ConfirmaTransacao;
        end else
        begin
          if TextoOperador <> '' then
          begin
{            frmMsg := TfrmMensagemTemporizada.Create(Screen.ActiveForm, TextoOperador);
            frmMsg.Show;
            frmMsg.SetFocus;
}           ExibirMensagemTemporizada;
            Application.ProcessMessages
          end;
        end;
      end else
      begin
        if Assigned(Screen.Forms[0]) then
        begin
          Screen.Forms[0].BringToFront;
          Screen.Forms[0].SetFocus;
        end;
        if (CodErro in [etNenhum, etTransacaoNegada]) and (TextoOperador <> '') then
          MensagemAviso(TextoOperador);
{
        CodigoErro := CodErro;
        if (CodigoErro > 3) then //eh necessario fazer a verificacao caso o coderro seja 3, para mostrar mensagem com o valor o campo 030
          NaoConfirmaVendaOuImpressao;
        ApagarArquivo(FDirResp+NomeArq);
        if CodigoErro = 4 then
          MensagemErro('A quantidade de parcelas definida no contrato para pagamento com cartão'+sLineBreak+
                       'não é igual a quantidade efetivada na transação TEF.')
        else if CodigoErro = 5 then
          MensagemErro('A operação efetivada no TEF não esta condizente'+sLineBreak+
                       'com a forma de pagamento definida nas parcelas.');
}
        Result := False;
      end;
    end else
      MensagemAviso('TEF não esta atívo');
  end;
end;

