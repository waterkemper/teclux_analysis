procedure TtecTEFDiscado.ComandaECF(Operacao: TACBrTEFDOperacaoECF;
  Resp: TACBrTEFDResp; var RetornoECF: Integer);
Var
   Est : TACBrECFEstado ;
   P   : Integer;
   Linha, CodFPG : String ;
   ValorFPG : Double ;

begin

//  Memo1.Lines.Add('ComandaECF: '+GetEnumName( TypeInfo(TACBrTEFDOperacaoECF),
//                                              integer(Operacao) ));

  Sleep(1);
  try
    if assigned(ECFPadrao) then
      Est := ECFPadrao.Estado;

    case Operacao of
      opeAbreGerencial :
      begin
        if assigned(ECFPadrao) then
           ECFPadrao.AbreRelatorioGerencial ;  {ok}
      end;

      opeCancelaCupom :
      begin
         if assigned(ECFPadrao) and ((Est = estNaoFiscal) or ECFPadrao.vNaoFiscalAberto) then
             ECFPadrao.CancelarNaoFiscal
         else
         if assigned(ECFPadrao) then
             ECFPadrao.CancelarCupom;
      end;

      opeFechaCupom :
      begin
         if assigned(ECFPadrao) and ((Est = estNaoFiscal) or ECFPadrao.vNaoFiscalAberto) then
            ECFPadrao.FechaNaoFiscal    {ok}
         else
         if assigned(ECFPadrao) then
         begin
//            ECFPadrao.ControlePorta := True;
            ECFPadrao.FinalizarCupom('','',Tefpadrao.MensagemCupom);
         end;
      end;

      opeSubTotalizaCupom :
      begin
         if assigned(ECFPadrao) and (Est = estNaoFiscal) then
            ECFPadrao.SubtotalizaNaoFiscal( 0, '') {ok não salva nenhuma informçaõ}
         else
         if assigned(ECFPadrao) then
            ECFPadrao.TotalizaCupom('$', FloatToStr((tefpadrao.ValorDesconto*-1)+tefpadrao.ValorAcrescimo));
      end;

      opeFechaGerencial, opeFechaVinculado :
      begin
        if assigned(ECFPadrao) then
          ECFPadrao.FecharRelatorioGerencial;
      end;

      opePulaLinhas :
      begin
          if assigned(ECFPadrao) then
          begin
            ECFPadrao.PulaLinhas( ECFPadrao.LinhasEntreCupons );
            ECFPadrao.CortaPapel( True );
          end;
          Sleep(2000);
      end;

      opeImprimePagamentos :
      begin
        if Est = estNaoFiscal then
        begin
          if tefpadrao.ValorPagoDinheiro<>0 then
          begin
            if assigned(ECFPadrao) then
              ecfpadrao.PagamentoNaoFiscal('Dinheiro', tefpadrao.ValorPagoDinheiro,  false);

            tefpadrao.TotalPago := tefpadrao.TotalPago + tefpadrao.ValorPagoDinheiro;
          end;

          if tefpadrao.ValorCreditoTroca<>0 then
          begin
            if assigned(ECFPadrao) then
              ecfpadrao.PagamentoNaoFiscal('Credito Troca', tefpadrao.ValorCreditoTroca,  false);

            tefpadrao.TotalPago := tefpadrao.TotalPago + tefpadrao.ValorCreditoTroca;
          end;

          if tefpadrao.ValorPagocheque<>0 then
          begin
            if assigned(ECFPadrao) then
              ecfpadrao.PagamentoNaoFiscal('Cheque',tefpadrao.ValorPagocheque);

            tefpadrao.TotalPago := tefpadrao.TotalPago + tefpadrao.ValorPagocheque;
          end;
        end
        else
        begin
          if tefpadrao.ValorPagoDinheiro<>0 then
          begin
            if assigned(ECFPadrao) then
              ecfpadrao.PagamentoCupom('DINHEIRO',floattostr(tefpadrao.ValorPagoDinheiro));

            tefpadrao.TotalPago := tefpadrao.TotalPago + tefpadrao.ValorPagoDinheiro;
          end;

          if tefpadrao.ValorCreditoTroca<>0 then
          begin
            if assigned(ECFPadrao) then
              ecfpadrao.PagamentoCupom('CREDITO TROCA',floattostr(tefpadrao.ValorCreditoTroca));

            tefpadrao.TotalPago := tefpadrao.TotalPago + tefpadrao.ValorCreditoTroca;
          end;

          if tefpadrao.ValorPagocheque<>0 then
          begin
            if assigned(ECFPadrao) then
              ecfpadrao.PagamentoCupom('CHEQUE',floattostr(tefpadrao.ValorPagocheque));

            tefpadrao.TotalPago := tefpadrao.TotalPago + tefpadrao.ValorPagocheque;
          end;
        end;
      end;
    end;

    if assigned(ECFPadrao) and ECFPadrao.Erro then
        RetornoECF := 0
      else
        RetornoECF := 1 ;

  except
    RetornoECF := 0 ;
  end;

  if Assigned(ECFPadrao) then
    ECFPadrao.AtualizarTotalizadorGeral(NomeArquivoECFs);

  Sleep(1);
end;

procedure TtecTEFDiscado.ComandaECFAbreVinculado(COO, IndiceECF: String;
  Valor: Double; var RetornoECF: Integer);
begin
  if assigned(ECFPadrao) then
  begin
    Sleep(1);
    try
       EcfPadrao.IniciarVinculado('CARTAO', 'Cartao', floattostr(Valor), COO);
      if ECFPadrao.Erro then
        RetornoECF := 0
      else
        RetornoECF := 1 ;
    except
       RetornoECF := 0 ;
    end;
    Sleep(1);
  end
  else
    RetornoECF := 1 ;
end;


