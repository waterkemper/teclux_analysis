function TtecTEFDiscado.CancelarTransacao(NSU, NomeRede, Hora, Data: String; Valor: Currency; MDI: Boolean): Boolean;
var
//  Msg: String;
  a: Integer;
//  SerieOK,
  Sair: Boolean;
begin
{  SerieOK := ECFPadrao.ImpressoraConfiguradaIgualConectada;
  while ECFPadrao.Erro or Not SerieOK do begin
    if ECFPadrao.Erro then
      Msg := 'Aguardando impressora fiscal'+sLineBreak+'Erro: '+ECFPadrao.Mensagem
    else if Not SerieOK then
      Msg := 'Aguardando impressora fiscal'+sLineBreak+'Erro: '+
             Format(ctERROSERIEECFDIFERENTE, ['', ECFPadrao.SerieMaquina, ECFPadrao.NumeroMaquina]);
    if Assigned(frmMsg) then
      frmMsg.Mensagem := Msg
    else if MDI then
      frmMsg := TfrmMensagemTemporizada.Create(Screen.ActiveForm, Msg);
    frmMsg.Fechar:= False;
    frmMsg.Show;
    frmMsg.SetFocus;
    Application.ProcessMessages;
    SerieOK := ECFPadrao.ImpressoraConfiguradaIgualConectada;
  end;
  if Assigned(frmMsg) then begin
    frmMsg.Fechar := True;
    frmMsg.Close;
    Application.ProcessMessages
  end;
}
  HeaderEnviado := 'CNC';
  NovoNumeroSequencia;
  Result := PreencherRequesicao(HeaderEnviado, ['003-000 = ' + ValorTransacao,
                                                '010-000 = ' + NomeRede,
                                                '012-000 = ' + NSU,
                                                '022-000 = ' + Data,
                                                '023-000 = ' + Hora]);
  if Result and EsperandoRespostaTEF then
    if InterpretarResposta(False) then
    begin
      Sair := False;
      if FQtdadeComprovantes = 0 then
      begin
        if TextoOperador <> '' then
          MensagemAviso(TextoOperador);
        if TextoCliente <> '' then
          MensagemAviso(TextoCliente);
        ApagarArquivo(FDirResp+NomeArq);
      end else
      begin
        BlockInput(True);
        try
          ECFPadrao.CancelarCupom;
          ECFPadrao.FecharRelatorioGerencial;
//          ECFPadrao.FechaNaoFiscal;
          if TextoOperador <> '' then
          begin
{            if MDI then
              frmMsg := TfrmMensagemTemporizada.Create(Screen.ActiveForm, TextoOperador)
            else
              frmMsg.Mensagem := TextoOperador;
            frmMsg.Show;
            frmMsg.SetFocus;
}           ExibirMensagemTemporizada;
          end;
          repeat
            for a := 0 to ParSistema.QtdeViaTEFDiscado - 1 do
            begin
              ECFPadrao.RelatorioGerencial(FComprovante[0], 1);
              if ECFPadrao.Erro then
                break
              else if ParSistema.QtdeViaTEFDiscado > a then
                ECFPadrao.RelatorioGerencial([sLineBreak+sLineBreak+sLineBreak+sLineBreak+sLineBreak],1);
            end;
            if Not ECFPadrao.Erro then
              ECFPadrao.FecharRelatorioGerencial;
            if ECFPadrao.Erro then
            begin
              repeat
                try
                  if ECFPadrao.CupomAberto then
                    ECFPadrao.CancelarCupom;
                  ECFPadrao.FecharRelatorioGerencial;
//                  ECFPadrao.FechaNaoFiscal;
                except
                  if ECFPadrao.Erro then
                  begin
                    BlockInput(False);
                    if MensagemConfirmacao(ECFPadrao.Mensagem + sLineBreak + ctTEFIMPRIMIRNOVAMENTE) <> smbOK then
                    begin
                      sleep(2000);
                      Sair := True;
                    end;
                    BlockInput(True);
                  end
                end
              until (Not ECFPadrao.Erro) or Sair;
              if Sair then
              begin
//                ECFPadrao.FecharRelatorioGerencial;
//                ECFPadrao.FechaNaoFiscal;
                Result := False;
                if Assigned(frmMsg) then
                  frmMsg.Free;
                if NaoConfirmaVendaOuImpressao then
                begin
                  BlockInput(False);
                  MensagemAviso(Mensagem);
                  BlockInput(True);
                  ApagarArquivo(FDirResp+NomeArq);
                end
              end
            end else
            begin
              Result := ConfirmaTransacao;
              Sair   := True;
              if Assigned(frmMsg) then
                frmMsg.Free;
            end
          until Sair;
        finally
          BlockInput(False)
        end
      end
    end else
    begin
      Result := False;
      if TextoOperador <> '' then
        MensagemAviso(TextoOperador);
      NaoConfirmaVendaOuImpressao;
      ApagarArquivo(FDirResp+NomeArq);
    end
end;

procedure TtecTEFDiscado.CancelarUltimaTransacaoPendente;
var
  Str, Valor: String;
  NSUStr, ValorStr: String;
begin
  if FileExists(DirExec + 'tectef.tmp') then begin //and Not FileExists(FDirResp+NomeArq) then begin
    if FileExists(FDirResp+NomeArq) then
      DeleteFile(FDirResp+NomeArq);
      ApagarArquivo(FDirResp+NomeArq);
    CopyFileTo(DirExec + 'tectef.tmp', FDirResp+NomeArq);
    DeleteFile(DirExec + 'tectef.tmp');
  end;
  if FileExists(FDirResp+NomeArq) then begin
    InterpretarResposta(True);
    if FStatusTransacao_ = '0' then begin
      NSUStr   := NSU;
      ValorStr := ValorTransacao;
      HeaderEnviado := 'NCN';
      NovoNumeroSequencia;
      PreencherRequesicao(HeaderEnviado, ['010-000 = ' + NomeRede,
                                          '012-000 = ' + NSU,
                                          '027-000 = ' + Finalizacao]);
    end;
    DeleteFile(FDirResp+NomeArq);
    ApagarArquivo(FDirResp+NomeArq);
    DeleteFile(DirExec + 'tectef.tmp');
    if FStatusTransacao_ = '0' then begin
      BlockInput(True);
      try
        if Assigned(ECFPadrao) then
          if ECFPadrao.CupomAberto then
            ECFPadrao.CancelarCupom;
//          else begin
            ECFPadrao.FecharRelatorioGerencial;
//            ECFPadrao.FechaNaoFiscal;
//          end
      finally
        BlockInput(False)
      end;
      Str := 'Cancelada a transação:'+ sLineBreak +
             'Rede:  ' + NomeRede + sLineBreak +
             'NSU:   ' + NSUStr;
      if ValorStr <> '' then begin
        Valor := ValorStr;
        Insert(',', Valor, Length(Valor) - 1);
        Str := Str + sLineBreak + 'Valor: ' + FloatToStrF(StrToCurr(Valor), ffCurrency, 15, 2);;
      end;
      MensagemAviso(Str);
    end
  end
end;

