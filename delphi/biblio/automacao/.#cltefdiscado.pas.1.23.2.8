                MensagemAviso(Mensagem);
                BlockInput(True);
                ApagarArquivoResposta;
              end
            end
          end
        else
        begin
          if NaoConfirmaVendaOuImpressao then
          begin
            BlockInput(False);
            MensagemAviso(Mensagem);
            BlockInput(True);
            ApagarArquivoResposta;
          end;
          ECFPadrao.FinalizarVinculado;
          Sair := True;
        end;
      end
    until Sair;
    if Assigned(frmMsg) then
      frmMsg.Free;
    BlockInput(False);

  end;
end;

procedure TtecTEFDiscado.InterpretaLinha(Valor: String; SomenteLerArq: Boolean; var NroLinha: Integer);
var
  CodCampo: String;
  ComplementoCod: Integer;
  ValorCampo: String;
begin
  if trim(Valor) <> '' then
  begin
    CodCampo       := Copy(Valor, 1, 3);
    ComplementoCod := StrToInt(Copy(Valor, 5, 3));
    Delete(Valor, 1, 10);
    ValorCampo := TrimRight(Valor);
    if CodCampo = ctCODIGO000 then
    begin
      if SomenteLerArq then
        FHeader := ValorCampo
      else if ValorCampo <> HeaderEnviado then
        CodErro := etHeader
    end else if CodCampo = ctCODIGO001 then begin
      FIdentificacao_ := ValorCampo;
      if FIdentificacao_ <> NroSeq then
      begin
        CodErro := etIdentificacao;
  //      ErroNroSeq := true;
      end;
    end else if CodCampo = ctCODIGO002 then begin
      FDocumentoFiscalVinculado := ValorCampo
    end else if CodCampo = ctCODIGO003 then begin
      if (SomenteLerArq or (HeaderEnviado = 'ADM')) and (ValorCampo <> '') then
      begin
        Insert(',', ValorCampo, Length(ValorCampo) - 1);
        ValorTransacao := ValorCampo
      end
    end else if CodCampo = ctCODIGO004 then begin
      if ValorCampo = '0' then
        FMoeda := 'Real'
      else if ValorCampo = '1' then
        FMoeda := 'Dolar'
    end else if CodCampo = ctCODIGO005 then begin
      FCMC7 := ValorCampo
    end else if CodCampo = ctCODIGO006 then begin
      FTipoPessoa := ValorCampo[1]
    end else if CodCampo = ctCODIGO007 then begin
      FDocumentoPessoa := ValorCampo
    end else if CodCampo = ctCODIGO008 then begin
      FDataCheque := ValorCampo
    end else if CodCampo = ctCODIGO009 then begin
      FStatusTransacao_ := ValorCampo;
      if ValorCampo <> '0' then
        CodErro := etTransacaoNegada
    end else if CodCampo = ctCODIGO010 then
      FNomeRede := ValorCampo
    else if CodCampo = ctCODIGO011 then
    begin
      FTipoTransacao_ := StrToInt(Trim(ValorCampo));
      //if HeaderEnviado = 'CRT' then begin
      //  if (FStatusTransacao = '0') and Not FrenteCaixa then begin
      //    if FTipoTransacaoPermitida = 10 then begin
      //      if Not (FTipoTransacao in [10,12]) then
      //        CodErro := 5
      //    end else if FTipoTransacaoPermitida = 11 then begin
      //      if Not (FTipoTransacao in [10,11,12]) then
      //        CodErro := 5
      //    end else if FTipoTransacaoPermitida = 20 then begin
      //      if Not (FTipoTransacao in [20, 21, 23, 24, 25]) then
      //        CodErro := 5
      //    end else if FTipoTransacaoPermitida = 40 then begin
      //      if FTipoTransacao <> 40 then //if Not (FTipoTransacao in [22, 40]) then
      //        CodErro := 5
      //    end else  if FTipoTransacaoPermitida = 0 then
      //      if Not (FTipoTransacao in [20, 21, 23, 24, 25]) then
      //        CodErro := 5
      //  end
      //end
    end else if CodCampo = ctCODIGO012 then
      FNSU := ValorCampo
    else if CodCampo = ctCODIGO013 then
      FAutorizacaoTransacao := ValorCampo
{    else if CodCampo = ctCODIGO014 then
      FLoteTransacao := ValorCampo
    else if CodCampo = ctCODIGO015 then
      FDataHoraTransacaoHost := StrToDateTime(ValorCampo)
    else if CodCampo = ctCODIGO016 then
      FDataHoraTransacaoLocal := StrToDateTime(ValorCampo)
}
    else if CodCampo = ctCODIGO017 then
      FTipoParcelamento := StrToInt(Trim(ValorCampo))
//    else if CodCampo = ctCODIGO018 then begin
//      FQtdadeParcelas := StrToInt(Trim(ValorCampo));
//      if FQtdadeParcelas > 0 then begin
//        SetLength(FParcelas , FQtdadeComprovantes);
//        SetLength(FParcelas[FQtdadeComprovantes - 1], FQtdadeParcelas);
//      end
      //if (CodErro = 0) and Not FrenteCaixa then begin
      //  if (FTipoTransacao = 10{in [10, 12]}) and (CredQtdadeParcelasPermitidas <> 1) and (HeaderEnviado = 'CRT') then
      //    CodErro := 4
      //  else if (FTipoTransacao = 11) and (FTipoParcelamento = 0) and
      //          (FQtdadeParcelas <> CredQtdadeParcelasPermitidas)
      //  then
      //    CodErro := 4
      //  else if (FTipoTransacao in [{20, }21, 23, 24, 25]) and (FQtdadeParcelas <> 1) then
      //    CodErro := 4
      //  else if (FTipoTransacao = 22) and (FQtdadeParcelas <> DebQtdadeParcelasPermitidas) then
      //    CodErro := 4
      //end
    else if CodCampo = ctCODIGO022 then
      FDataTransacao := ValorCampo
    else if CodCampo = ctCODIGO023 then
      FHoraTransacao := ValorCampo
    else if CodCampo = ctCODIGO024 then
      FDataPreDatado := ValorCampo
    else if CodCampo = ctCODIGO025 then
      FNroTransacaoCancelada := ValorCampo
    else if CodCampo = ctCODIGO026 then
      FDataTransacaoCancelada := ValorCampo
    else if CodCampo = ctCODIGO027 then
      FFinalizacao := ValorCampo
    else if CodCampo = ctCODIGO028 then
    begin
      FQtdadeLinhasComprovante := StrToInt(Trim(ValorCampo));
      if FQtdadeLinhasComprovante > 0 then
      begin
        Inc(FQtdadeComprovantes);
        SetLength(FComprovante, FQtdadeComprovantes);
        SetLength(FComprovante[FQtdadeComprovantes - 1], FQtdadeLinhasComprovante);
      end
    end else if CodCampo = ctCODIGO029 then
    begin
      if FQtdadeLinhasComprovante = NroLinha then
      begin
        FQtdadeLinhasComprovante := NroLinha + 1;
        SetLength(FComprovante[FQtdadeComprovantes - 1], FQtdadeLinhasComprovante);
      end;
      FComprovante[FQtdadeComprovantes-1][NroLinha] := Copy(ValorCampo, 2, Length(ValorCampo)-2);
      if FComprovante[FQtdadeComprovantes-1][NroLinha] = '' then
        FComprovante[FQtdadeComprovantes-1][NroLinha] := ' ';
      Inc(NroLinha)
    end else if CodCampo = ctCODIGO030 then
      FTextoOperador := ValorCampo
    else if CodCampo = ctCODIGO031 then
      FTextoCliente := ValorCampo
    else if CodCampo = ctCODIGO040 then
      FAdministradora := ValorCampo;
  end;
end;

function TtecTEFDiscado.InterpretarResposta(SomenteLerArq: Boolean): Boolean;
var
  ArqResp: Text;
  Valor: String;
  NroLinha: Integer;

  procedure CapturarParcelas;
  var
    CodCampo: String;
    ComplementoCod: Integer;
    ValorCampo: String;
  begin
    Reset(ArqResp);
    repeat
      Readln(ArqResp,Valor);

      CodCampo       := Copy(Valor, 1, 3);
      ComplementoCod := StrToInt(Copy(Valor, 5, 3));
      Delete(Valor, 1, 10);
      ValorCampo := TrimRight(Valor);

      if CodCampo = ctCODIGO019 then
        FParcelas[FQtdadeComprovantes-1][ComplementoCod-1].DataVencto := ValorCampo
      else
      if CodCampo = ctCODIGO020 then
      begin
        Insert(',',ValorCampo,length(ValorCampo)-1);
        FParcelas[FQtdadeComprovantes-1][ComplementoCod-1].Valor := StrToFloat(ValorCampo);
      end
      else
      if CodCampo = ctCODIGO021 then
        FParcelas[FQtdadeComprovantes-1][ComplementoCod-1].NSU := ValorCampo;

    until Eof(ArqResp);
  end;

begin
  repeat
    CodErro := etNenhum;
    try
      AssignFile(ArqResp, FDirResp+NomeArq);
      Append(ArqResp);
      Writeln(ArqResp, ' ');
      Flush(ArqResp);
      Reset(ArqResp);
      FTextoOperador := '';
      FTextoCliente := '';
      NroLinha := 0;
      repeat
        Readln(ArqResp, Valor);
        InterpretaLinha(Valor, SomenteLerArq, NroLinha);
      until Eof(ArqResp);
//      if FQtdadeParcelas > 0 then
//        CapturarParcelas;
      CloseFile(ArqResp);
    except
      on E: Exception do MensagemAviso(E.Message + 'InterpretarResposta!');
    end;
    if SomenteLerArq then
      Result := True
    else begin
      Result := CodErro = etNenhum;
      if not Result then
        ApagarArquivo(FDirResp+NomeArq);
//      repeat until EsperandoRespostaTEF; end
    end;
  until Result or (CodErro <> etIdentificacao);
end;

function TtecTEFDiscado.Mensagem: String;
begin
  Result := 'Cancelada a transação:'+ sLineBreak +
            'Rede:  ' + NomeRede + sLineBreak +
            'NSU:   ' + NSU;
  if FValorTransacao <> 0 then
    Result := Result + sLineBreak + 'Valor: ' + FloatToStrF(FValorTransacao, ffCurrency, 15, 2);
end;

function TtecTEFDiscado.NaoConfirmaVendaOuImpressao: Boolean;
begin
  GerenciadorAtivo(True);
  HeaderEnviado := 'NCN';
  NovoNumeroSequencia;
  Result := PreencherRequesicao(HeaderEnviado,['010-000 = ' + NomeRede,
                                               '012-000 = ' + NSU,
                                               '027-000 = ' + Finalizacao]);
end;

procedure TtecTEFDiscado.NovoNumeroSequencia;
begin
  DateTimeToString(NroSeq, 'mdhnszzz', Now);
  NroSeq := Copy(NroSeq, 1, 10);
end;

function TtecTEFDiscado.PreencherRequesicao(Req: String; DadosReq: array of String): Boolean;
var
  a: Integer;
  ArqReq: Text;
begin
  if FileExists(FDirResp+NomeArqSts) then
    DeleteFile(FDirResp+NomeArqSts);
  if FileExists(FDirReq+NomeArqTemp) then
    DeleteFile(FDirReq+NOmeArqTemp);
  if FileExists(FDirReq+NomeArq) then
    DeleteFile(FDirReq+NomeArq);
  try
    AssignFile(ArqReq, FDirReq+NomeArqTemp);
    Rewrite(ArqReq);
    Writeln(ArqReq, '000-000 = '+Req);
    Writeln(ArqReq, '001-000 = '+NroSeq);
    for a := Low(DadosReq) to High(DadosReq) do
            Writeln(ArqReq, DadosReq[a]);
    Writeln(ArqReq, '999-999 = 0');
    CloseFile(ArqReq);
  except
    on E: Exception do MensagemAviso(E.Message + 'PreencherRequisicao!');
  end;
  repeat
  until FileExists(FDirReq+NomeArqTemp);
  repeat
  until RenameFile(FDirReq+NomeArqTemp, FDirReq+NomeArq);
  Result := EsperandoConfirmacaoTEF;
end;

procedure TtecTEFDiscado.setValorTotalCartoes(const Value: Real);
begin
  FValorTotalCartoes   := Value;
end;

procedure TtecTEFDiscado.setValorTransacao(const Value: String);
var
  PosVirg: Integer;
begin
  FValorTransacao    := StrToFloat(Value);
  FValorTransacaoStr := Value;
  PosVirg            := Pos(',', FValorTransacaoStr);
  if PosVirg = 0 then
    FValorTransacaoStr := FValorTransacaoStr + '00'
  else begin
    Delete(FValorTransacaoStr, PosVirg, 1);
    if PosVirg = Length(FValorTransacaoStr) then
      FValorTransacaoStr := FValorTransacaoStr + '0';
  end
end;

procedure TtecTEFDiscado.InfoECF(Operacao: TACBrTEFDInfoECF;
  var RetornoECF: String);
var
   ASubTotal: Currency;
begin
   Sleep(1);
   try
      if assigned(ecfpadrao) then
        if not ecfpadrao.Ativo then
           ecfpadrao.Ativar ;
   except
      { Para CliSiTEF ou V&SPague aplique o IF abaixo em sua aplicação, que
        permite saber se o Cupom foi concluido mesmo com o ECF desligado }

      if (not tefpadrao.TEF.Inicializado) and   { Está na inicialização ? }
         (Operacao = ineEstadoECF) and          { Quer Saber o estado do ECF ? (mas se chegou aqui é pq o ECF já está com problemas) }
         (tefpadrao.GPAtual in [gpCliSiTef,gpVeSPague]) then
      begin
         { Leia o último Documento Gravado no seu Banco de Dados, e verifique
           se o Cupom já foi finalizado,ou se já foi aberto um CCD ou Gerencial...
           Exemplo:

           Documento.Le(0);

           if (Documento.Finalizado) or (pos(Documento.Denominacao,'CC|RG') > 0) then
              RetornoECF := 'R'
           else
              RetornoECF := 'O' ;
         }

         //RetornoECF := 'O';    // Executará CancelarTransacoesPendentes;
         RetornoECF := 'R';    // Executará ConfirmarESolicitarImpressaoTransacoesPendentes;
         exit ;
      end ;

      raise ;
   end;

   case Operacao of
     ineSubTotal :
       begin
       { VER O VALOR CORRETO SE NÃO FOR ECF }
         if assigned(ecfpadrao) then
         begin
           ASubTotal := ecfpadrao.Subtotal;
           ASubTotal := ASubTotal -
                        tefpadrao.TotalPago +
                        tefpadrao.ValorAcrescimo -
                        tefpadrao.ValorDesconto;
         end
         else
         begin
           ASubTotal := tefPadrao.fValorTransacao -
                        tefpadrao.TotalPago {+
                        tefpadrao.ValorAcrescimo -
                        tefpadrao.ValorDesconto};  //neste caso fValortransacao ja esta com acrescimo e desconto

         end;

         RetornoECF := FloatToStr( ASubTotal ) ;
       end;

     ineTotalAPagar :
     begin

       if (tefpadrao.ValorPagoDinheiro {+
           tefpadrao.ValorCreditoTroca +
           tefpadrao.ValorPagocheque}) <>0 then
         RetornoECF := floattostr(tefpadrao.ValorPagoDinheiro {+ tefpadrao.ValorCreditoTroca + tefpadrao.ValorPagocheque})
       else
         RetornoECF := '0';

     end;

     ineEstadoECF :
       begin
         if assigned(ecfpadrao) then
         begin
           Case ecfpadrao.Estado of
             estLivre     : RetornoECF := 'L' ;
             estVenda     : RetornoECF := 'V' ;
             estPagamento : RetornoECF := 'P' ;
             estRelatorio : RetornoECF := 'R' ;
             estNaoFiscal : RetornoECF := 'N' ;
           else
             RetornoECF := 'O' ;
           end;
         end
         else
         begin
           if TefPadrao.comprovanteOK then
             RetornoECF := 'L'
           else
             RetornoECF := 'N' ;  //setando o estado como Nao Fiscal quando sem ECF
         end;
       end;
   end;
   Sleep(1);
end;

procedure TtecTEFDiscado.ComandaECFSubtotaliza(DescAcre: Double;
  var RetornoECF: Integer);
Var
   Est : TACBrECFEstado ;
//   MeuAcresDesc : Double ;
begin
  Sleep(1);
//  Memo1.Lines.Add('ComandaECFSubtotaliza: DescAcre: ' + FormatFloat('0.00',DescAcre) );

//  MeuAcresDesc := StringToFloatDef( edValorDescAcre.Text, 0 );
  {VERIFICAR A SITUACAO DO SUBTOTALIZA SEM ECF}
  try
    if assigned(ECFPadrao) then
      Est := ECFPadrao.Estado;


    if Est = estNaoFiscal then
    begin
      if assigned(ECFPadrao) then
        ECFPadrao.SubtotalizaNaoFiscal( DescAcre {+ MeuAcresDesc} ) {Rever}  {Aqui não fiscal}
    end
    else
    begin
//     ECFPadrao.SubtotalizaCupom( DescAcre {+ MeuAcresDesc}, 'Projeto ACBr|http://acbr.sf.net' );
       if assigned(ECFPadrao) then
         ECFPadrao.TotalizaCupom('', floattostr(DescAcre + tefpadrao.ValorAcrescimo - tefpadrao.ValorDesconto));

    { Remove o Desconto pois já foi aplicado, caso contrário iria influenciar o
      retorno de ineSubTotal }
//    edValorDescAcre.Text := '0,00';
      tefpadrao.ValorDesconto := 0;
      tefpadrao.ValorAcrescimo := 0;
    end;

    if assigned(ECFPadrao) and ECFPadrao.Erro then
      RetornoECF := 0
    else
      RetornoECF := 1 ;
  except
    RetornoECF := 0 ;
  end;
  Sleep(1);
end;

procedure TtecTEFDiscado.ComandaECFPagamento(IndiceECF: String;
  Valor: Double; var RetornoECF: Integer);
var
   Est : TACBrECFEstado ;
begin
  Sleep(1);
  try
//     Memo1.Lines.Add( 'ComandaECFPagamento, IndiceECF: '+IndiceECF+
//        ' Valor: '+FormatFloat('0.00',Valor) );

     if assigned(ECFPadrao) then
       Est := ECFPadrao.Estado;

     if Est = estNaoFiscal then
     begin
        if assigned(ECFPadrao) then
          ECFPadrao.PagamentoNaoFiscal('CARTAO', Valor);
        {nao fiscal nao incrementa o ecfpadrao.totalpago, portanto utilizarei estas variaveis para guardar o total ***** VERIFICAR ****}
        if assigned(ECFPadrao) then
        begin
          if not ECFPadrao.Erro then
            tefpadrao.TotalPago := TEFPadrao.totalpago + Valor;
        end
        else
          tefpadrao.TotalPago := TEFPadrao.totalpago + Valor;

     end
     else
     begin
//        ECFPadrao.EfetuaPagamento(IndiceECF, Valor);
        if assigned(ECFPadrao) then
          ECFPadrao.PagamentoCupom('CARTAO', floattostr(Valor));

        if assigned(ECFPadrao) then
        begin
          if not ECFPadrao.Erro then
            tefpadrao.TotalPago := TEFPadrao.totalpago + Valor;
        end
        else
          tefpadrao.TotalPago := TEFPadrao.totalpago + Valor;
     end;

    if assigned(ECFPadrao) and ECFPadrao.Erro then
      RetornoECF := 0
    else
      RetornoECF := 1 ;
  except
     RetornoECF := 0 ;
  end;
  Sleep(1);
end;

procedure TtecTEFDiscado.MudaEstadoResp(EstadoResp: TACBrTEFDRespEstado);
//const
     {
  VISA: array [0 .. 4] of string =
    ('VISA Crédito'
    , 'VISA Electron'
    , 'VISA Crediário'
    , 'VISA Electron'
    , 'VISA Parcelado Loja');
  MASTERCARD: array [0 .. 1] of string = ('MASTERCARD', 'MAESTRO');
  AMERICAN = 'AMEX';
  SOROCRED = 'SOROCRED';
      }
begin
  case EstadoResp of
    respConcluida :
    begin
      TefPadrao.TipoTransacao_    := TEFPadrao.Resp.TipoTransacao;
      TefPadrao.Administradora    := TEFPadrao.Resp.NomeAdministradora;
      TefPadrao.StatusTransacao_  := TEFPadrao.Resp.StatusTransacao;
      TefPadrao.DataTransacao     := FormatDateTime('DD/MM/YYYY', Tefpadrao.Resp.DataHoraTransacaoComprovante);
      TefPadrao.HoraTransacao     := FormatDateTime('HH:MM:SS', Tefpadrao.Resp.DataHoraTransacaoComprovante);
      TEfPadrao.NomeRede          := TefPadrao.resp.Rede;
      TEfPadrao.NSU               := TefPadrao.resp.NSU;

{      TEfPadrao.cnpjcredenciadora := TefPadrao.resp.NFCeSAT.CNPJCredenciadora;}

//      TEfPadrao.cnpjcredenciadora := Credenciadora

//      TEfPadrao.bandeiraoperadora :=

      {
      if MatchText(TEFPadrao.Resp.NomeAdministradora, VISA) then
        TEfPadrao.bandeiraoperadora := '01'

      else if MatchText(TEFPadrao.Resp.NomeAdministradora, MASTERCARD) then
        TEfPadrao.bandeiraoperadora := '02'
      else if TEFPadrao.Resp.NomeAdministradora = AMERICAN then
        TEfPadrao.bandeiraoperadora := '03'
      else if TEFPadrao.Resp.NomeAdministradora = SOROCRED then
        TEfPadrao.bandeiraoperadora := '04'
      else
        TEfPadrao.bandeiraoperadora := '99';
      }
      {TEfPadrao.bandeiraoperadora := TefPadrao.resp.NFCeSAT.Bandeira;}

      TEfPadrao.nrautorizacaocartao := TefPadrao.resp.NSU;{TefPadrao.resp.NFCeSAT.autorizacao;}

      if tefpadrao.Resp.QtdParcelas = 0 then
        TefPadrao.QtdadeParcelas   := 1
      else
        TefPadrao.QtdadeParcelas   := tefpadrao.Resp.QtdParcelas;

      TefPadrao.TipoParcelamento := tefpadrao.Resp.TipoParcelamento;  {0 - loja  1 - adm}

      TefPadrao.ComprovanteOK := true;


    end;
  end;
end;

procedure TtecTEFDiscado.AntesCancelarTransacao(
  RespostaPendente: TACBrTEFDResp);
var
   Est: TACBrECFEstado;
begin
   if assigned(ecfpadrao) then
   begin
     Est := ecfpadrao.Estado;

     case Est of
        estVenda, estPagamento :
  //        ecfpadrao.CancelaCupom;
          ECFPadrao.CancelarCupom;

        estRelatorio :
  //         ecfpadrao.FechaRelatorio;
          ECFPadrao.FecharRelatorioGerencial;
     else
        if not ( Est in [estLivre, estDesconhecido, estNaoInicializada] ) then
  //         ecfpadrao.CorrigeEstadoErro( False ) ;
          ecfpadrao.CorrigeEstadoDeErro( False );
     end;
   end;

   
end;

