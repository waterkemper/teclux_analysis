function TtecTEFDiscado.FormatarValor(Valor: String): String;
var
  PosVirg: Integer;
begin
  Result := Valor;
  PosVirg := Pos(',', Result);
  if PosVirg = 0 then
    Result := Result + '00'
  else begin
    Delete(Result, PosVirg, 1);
    if PosVirg = Length(Result) then
      Result := Result + '0';
  end
end;

