procedure TtecTEFDiscado.ComandaECFImprimeVia(
  TipoRelatorio: TACBrTEFDTipoRelatorio; Via: Integer;
  ImagemComprovante: TStringList; var RetornoECF: Integer);
begin
  Sleep(1);
(*
  Memo1.Lines.Add( 'tefpadraoComandaECFImprimeVia, Tipo: '+
     IfThen(TipoRelatorio = trGerencial, 'trGerencial','trVinculado') +
     ' Via: '+IntToStr(Via) );
  Memo1.Lines.AddStrings( ImagemComprovante );
  *)

  { *** Se estiver usando ACBrECF... Lembre-se de configurar ***
    ecfpadrao.MaxLinhasBuffer   := 3; // Os homologadores permitem no máximo
                                     // Impressao de 3 em 3 linhas
    ecfpadrao.LinhasEntreCupons := 7; // (ajuste conforme o seu ECF)

    NOTA: ACBrECF nao possui comando para imprimir a 2a via do CCD }

  {AQUI SERÁ GUARDADO O COMPROVANTE }
  try
     case TipoRelatorio of
       trGerencial :
         if assigned(ecfpadrao) then
           ecfpadrao.LinhaRelatorioGerencial( ImagemComprovante.Text )
         else
            ComandaECFImprimeViaNFCe(Via,ImagemComprovante);
       trVinculado :
         if assigned(ecfpadrao) then
           ecfpadrao.LinhaCupomVinculado( ImagemComprovante.Text )   {aqui e agora}
         else
            ComandaECFImprimeViaNFCe(Via,ImagemComprovante);

     end;

    if assigned(ecfpadrao) and ECFPadrao.Erro then
      RetornoECF := 0
    else
      RetornoECF := 1 ;

  except
     RetornoECF := 0 ;
  end;
  Sleep(1);
end;

procedure TtecTEFDiscado.ApagarArquivo(NomeArq: String);
begin
  if FileExists(NomeArq) then begin
      DeleteFile(DirExec + 'tectef.tmp');
      DeleteFile(NomeArq);
  end
//    RenameFile(NomeArq,NomeArq+NroSeq);
end;

procedure TtecTEFDiscado.ApagarArquivoResposta;
begin
  ApagarArquivo(FDirResp+NomeArq);
end;

