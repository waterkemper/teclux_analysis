function TtecTEFDiscado.EsperandoArquivo(Arq: String; ComTimeOut: Boolean): Boolean;
const
  MaxTimeout = 7000;
var
  TimeOut, TimeOut1: Comp;
begin
  TimeOut := Clock + MaxTimeout;
  repeat
   Result := FileExists(Arq);
   TimeOut1 := Clock;
  until Result or ((TimeOut1 > TimeOut) and ComTimeOut);
end;

function TtecTEFDiscado.EsperandoConfirmacaoTEF: Boolean;
var
  ArqResp: Text;
  Valor: String;
  NroLinha: Integer;
begin
  repeat
    Result := EsperandoArquivo(FDirResp+NomeArqSts, True);
    if Result then begin
      CodErro := etNenhum;
      try
        //MensagemAviso('passou');
        sleep(500);
        AssignFile(ArqResp, FDirResp+NomeArqSts);
        Reset(ArqResp);
        FTextoOperador := '';
        FTextoCliente := '';
        NroLinha := 0;
        repeat
          Readln(ArqResp, Valor);
          InterpretaLinha(Valor, False, NroLinha);
        until Eof(ArqResp);
        CloseFile(ArqResp);
        Result := CodErro = etNenhum;
        if Result then
          DeleteFile(FDirResp+NomeArqSts)
      except
        on E: Exception do MensagemAviso(E.Message + 'EsperandoConfirmacao!');
      end;
    end else
      break
  until Result;
end;

