function TtecTEFDiscado.ImprimirCupom(var CupomEmitido: Boolean; PagarDinheiro: Currency;
  DadosFornec, FormaPagto: String; QtdadeCartoes: Integer): Boolean;
var
  a{, b}: Integer;
  Sair,
  Confirmado: Boolean;
//  NroCupom: String;
  TipoPagamento:String;
begin

  Result := True;
  
  if assigned(ECFPadrao) then
  begin
    Sair   := False;
    BlockInput(True);
    repeat
      if TipoOperacaoGlobal = sopCARTAO then
        TipoPagamento:='CARTAO'
      else if (TipoOperacaoGlobal = sopCHEQUE) then
        TipoPagamento:='CHEQUE';

      if Not (CupomEmitido or ECFPadrao.CupomAberto) then
      begin
        for a := 0 to QtdadeComprovantes - 1 do begin
          ECFPadrao.RelatorioGerencial(FComprovante[a], 2);  //CupomVinculadoTef(CupomFiscal, TipoPagamento, FormasPagto[a].Valor, Comprovante[a], ParSistema.QtdeViaTEFDiscado); //RelatorioGerencial(Comprovante[a]);
          if ECFPadrao.Erro then
            break;
          Application.ProcessMessages;
        end;
        if Not ECFPadrao.Erro then begin
          ECFPadrao.FecharRelatorioGerencial;
          if Not ECFPadrao.Erro then begin
            Result := ConfirmaTransacao;
            Sair := True;
          end
        end
      end else
      begin
        if PagarDinheiro > 0 then
          repeat
           ECFPadrao.PagamentoCupom('Dinheiro', FloatToStr(PagarDinheiro));
            if ECFPadrao.Erro then
            begin
              BlockInput(False);
              if biblio.MensagemConfirmacao(ECFPadrao.Mensagem + sLineBreak + ctTEFIMPRIMIRNOVAMENTE) <> smbOK then
              begin
                sleep(2000);
                Sair := True;
                Result := False
              end;
              BlockInput(True);
            end
          until Sair or (Not ECFPadrao.Erro);
        if Not ECFPadrao.Erro then
        begin
          a := 0;
          repeat
              ECFPadrao.PagamentoCupom(TipoPagamento{FormasPagto[a].NomeRede}, FloatToStr(FormasPagto[a].Valor));
            if ECFPadrao.Erro then
            begin
              BlockInput(False);
              if biblio.MensagemConfirmacao(ECFPadrao.Mensagem + sLineBreak + ctTEFIMPRIMIRNOVAMENTE) <> smbOK then
              begin
                sleep(2000);
                Sair := True;
                Result := False
              end;
              BlockInput(True);
            end else
              INc(a);
          until Sair or ((Not ECFPadrao.Erro) and (a >= QtdadeCartoes));
        end;
        if Not ECFPadrao.Erro then
          repeat
            if ECFPadrao.CupomAberto then
              ECFPadrao.FinalizarCupom(TipoPagamento{FormasPagto[QtdadeCartoes-1].NomeRede}, FloatToStr(ValorTotalCartoes), DadosFornec);
            if ECFPadrao.Erro then
            begin
              BlockInput(False);
              if biblio.MensagemConfirmacao(ECFPadrao.Mensagem + sLineBreak + ctTEFIMPRIMIRNOVAMENTE) <> smbOK then
              begin
                sleep(2000);
                Sair := True;
                Result := False
              end;
              BlockInput(True);
            end
          until Sair or (Not ECFPadrao.Erro);
