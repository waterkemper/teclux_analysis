                    repeat;
                      ECFPadrao.RelatorioGerencial(Comprovante[a],1);
                      if ECFPadrao.Erro then
                      begin
                        BlockInput(False);
                        if biblio.MensagemConfirmacao(ECFPadrao.Mensagem + sLineBreak + ctTEFIMPRIMIRNOVAMENTE) = smbOK then
                        begin
                          BlockInput(True);
                          sleep(2000);
                          Sair := false;
                          Result := False
                        end;
                      end
                      else
                        Sair := True;
                    until
                      Sair or (Not ECFPadrao.Erro);
                  end;
                end
            until Sair or (Not ECFPadrao.Erro);
            Application.ProcessMessages;
          end;
  (*          if Not ECFPadrao.Erro then
              repeat
                //if FormaPagto = '' then
  //              ECFPadrao.CupomVinculado(CupomFiscal, TipoPagamento, FormasPagto[a].Valor, FormasPagto[a], ParSistema.QtdeViaTEFDiscado);
                ECFPadrao.IniciarVinculado(TipoPagamento{FormasPagto[a].NomeRede}, FloatToStrF(FormasPagto[a].Valor, ffNumber, 15, 2), CupomFiscal);
                //else
                //  ECFPadrao.IniciarVinculado(FormaPagto, ValorTransacao, NroCupom);
                if ECFPadrao.Erro then
                begin
                  BlockInput(False);
                  if biblio.MensagemConfirmacao(ECFPadrao.Mensagem + sLineBreak + ctTEFIMPRIMIRNOVAMENTE) <> smbOK then
                  begin
                    sleep(2000);
                    Sair := True;
                    Result := False
                  end;
                  BlockInput(True);
                end
              until Sair or (Not ECFPadrao.Erro);
            Application.ProcessMessages;
            if Not ECFPadrao.Erro then
            begin
              CupomEmitido := False;
              if ParSistema.QtdeViaTEFDiscado = 1 then
              begin
  //              GerenciadorAtivo(true);
                ECFPadrao.ImprimirVinculado(Comprovante[a]);
                if ECFPadrao.Erro then
                  break;
                Application.ProcessMessages;
              end else
                for b := 1 to ParSistema.QtdeViaTEFDiscado do begin
  //                GerenciadorAtivo(true);
                  ECFPadrao.ImprimirVinculado(Comprovante[a]);
                  Application.ProcessMessages;
                  if ECFPadrao.Erro then
                    break
                  else if ParSistema.QtdeViaTEFDiscado > b then begin
  //                  GerenciadorAtivo(true);
                    ECFPadrao.ImprimirVinculado([sLineBreak+sLineBreak+sLineBreak+sLineBreak+sLineBreak+sLineBreak]);
                    Sleep(5000);
                  end;
                end;
              if Not ECFPadrao.Erro then
                ECFPadrao.FinalizarVinculado;
            end
          end;
  *)
        end;
        if ECFPadrao.Erro then begin
          if Sair and NaoConfirmaVendaOuImpressao then
          begin
            BlockInput(False);
            MensagemAviso(Mensagem);
            ApagarArquivoResposta;
          end
        end else
        begin
          Result := ConfirmaTransacao;
          Sair   := True;
        end
      end;

      if ECFPadrao.Erro and Not Sair then
      begin
        Result := False;
        BlockInput(False);
        Confirmado := biblio.MensagemConfirmacao(ECFPadrao.Mensagem + sLineBreak + ctTEFIMPRIMIRNOVAMENTE) = smbOK;
        BlockInput(True);
        if Confirmado then
          if CupomEmitido then
            ECFPadrao.FinalizarVinculado
          else
          begin
            repeat
              if ECFPadrao.CupomAberto then
                ECFPadrao.CancelarCupom
              else
              begin
  //              ECFPadrao.FechaNaoFiscal;
