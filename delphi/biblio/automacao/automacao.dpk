package automacao;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  tecsoft6,
  ACBr_Serial,
  ACBr_TEFD,
  frx,
  frx7,
  frxe7,
  frxDB7,
  RLibWinD7vcl,
  rtl,
  ACBr_synapse,
  dclIndyProtocols70,
  dclIndyCore70,
  TMSD7,
  tmsexd7,
  ACBr_NFSe,
  ACBr_NFeDanfeFR,
  ACBr_NFeDanfeRL,
  ACBr_NFe;

contains
  cltextprinter in 'cltextprinter.pas',
  clecf in 'clecf.pas',
  terminal in 'terminal.pas',
  rgautomacao in 'rgautomacao.pas',
  cttef in 'cttef.pas',
  cltefdedicado in 'cltefdedicado.pas',
  cltefdiscado in 'cltefdiscado.pas',
  clbackuptefdiscado in 'clbackuptefdiscado.pas',
  bbtefdedicado in 'bbtefdedicado.pas',
  climpressorachequepadrao in 'climpressorachequepadrao.pas',
  climpressorachequetsp in 'climpressorachequetsp.pas',
  climpressorachequebematech in 'climpressorachequebematech.pas',
  fmmensagemtemporizada in '..\fmmensagemtemporizada.pas' {frmMensagemTemporizada},
  ctepson in 'ctepson.pas',
  fmmensagemgridnfe in 'fmmensagemgridnfe.pas' {frmMensagemGridNFE},
  uLkJSON in '..\terceiros\uLkJSON.pas',
  ProcNFeBuilder in 'ProcNFeBuilder.pas',
  NFePrintValidator in 'NFePrintValidator.pas';

end.
