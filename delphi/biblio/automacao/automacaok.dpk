package automacaok;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS OFF}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$SONAME 'automacao'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  tecsoftk,
  baseclx,
  dataclx,
  visualclx,
  visualdbclx,
  ACBrComum,
  ACBrSerial;

contains
  bbecf_mecaf in 'bbecf_mecaf.pas',
  clecf_bematech in 'clecf_bematech.pas',
  clecf_mecaf in 'clecf_mecaf.pas',
  cltextwriter in 'cltextwriter.pas',
  bbecf_bematech in 'bbecf_bematech.pas',
  ctepson in 'ctepson.pas',
  clecf in 'clecf.pas',
  terminal in 'terminal.pas',
  ctbematech in 'ctbematech.pas',
  cltextprinter in 'cltextprinter.pas',
  bbtefdedicado in 'bbtefdedicado.pas',
  cltefdedicado in 'cltefdedicado.pas',
  cttef in 'cttef.pas',
  climpressorachequebematech in 'climpressorachequebematech.pas',
  climpressorachequepadrao in 'climpressorachequepadrao.pas',
  climpressorachequetsp in 'climpressorachequetsp.pas',
  bbecf_daruma in 'bbecf_daruma.pas',
  clecf_daruma in 'clecf_daruma.pas',
  ctdaruma in 'ctdaruma.pas',
  clecf_elgin in 'clecf_elgin.pas',
  bbecf_elgin in 'bbecf_elgin.pas',
  ctelgin in 'ctelgin.pas',
  clecf_sweda in 'clecf_sweda.pas',
  clnfe in 'clnfe.pas',
  clecf_epson in 'clecf_epson.pas',
  fmmensagemtemporizada in '../fmmensagemtemporizada.pas' {frmMensagemTemporizada};

end.
