function TtecFinanceira.Fator(Taxa: Real; Dias: Integer; JurosSimples: Boolean): Real;
                                       {Retorna  o fator de  juros a ser multiplicado}
                                       {pelo valor de prestacoes em atraso           }
var FatorMes: Real;
begin
   Taxa:= Taxa / 100;

   if JurosSimples
   then FatorMes:= 1 + (Dias div 30) * Taxa         {Juros Simples}
   else FatorMes:= Power(1 + Taxa, Dias div 30);    {Juros Compostos}

   Fator:= 100 * (FatorMes + ((Dias mod 30) * Taxa / 30));
End;

function TtecFinanceira.CalcularDesctos(ValorVencto: Currency; DataVencto, DataPagto: TDateTime): Currency;
var
  Taxa    : Real;
begin
  Taxa := Power(1 + (Descontos / 100), 1/30);
  CalcularDesctos:= (ValorVencto / Power(Taxa, DaysBetween(DataVencto,DataPagto))) -
                     ValorVencto;
end;

