function TtecFinanceira.TaxaDiaria(TaxaJuros:Real): Real;
begin
  TaxaDiaria:= Power(1 + (TaxaJuros / 100), (1 / 30));
end;

function TtecFinanceira.TaxaAcumulada(DataVencto  :TDateTime;
                                      DataCalculo :TDateTime;
                                      NP          :Integer;
                                      Intervalo   :Integer;
                                      Juros       :Real;
                                      TaxaInicial: Real = 0):Real;
// DataCalculo: Data base para o calculo do financiamneto.
// DataVencto : Data vencimento da primeira parcela da ocorrência.
// NP         : Numero de Parcelas em determinada ocorrência.
// Intervalo  : Intervalo entre as parcelas.
// TaxaJuros  : Taxa de juros cobrado no plano de pagamento.
var
  DataAux: TDateTime;
  I    : Integer;
begin
  Result:= TaxaInicial;
  for I:= 1 to NP do begin
    DataAux:= SomarDia(DataVencto,Intervalo * (I-1),'S');
    Result := Result + 1/(Power(TaxaDiaria(Juros),DaysBetween(DataAux,DataCalculo)));
  end;
end;

function TtecFinanceira.ValorPresente(DataCalculo :TDateTime;
                                      NP          :Integer;
                                      DataVencto  :TDateTime;
                                      ValorVencto :Real;
                                      Intervalo   :Integer;
                                      TaxaJuros   :Real;
                                      ValorInicial:Real = 0):Real;
// DataCalculo: Data base para o calculo do financiamneto.
// NP         : Numero de Parcelas em determinada ocorrência.
// DataVencto : Data vencimento da primeira parcela da ocorrência.
// ValorVencto: Dalor vencimento da parcela em questão.
// Intervalo  : Intervalo entre as parcelas.
// TaxaJuros  : Taxa de juros cobrado no plano de pagamento.
var
  Valor      : Real;
  J,NrDias : Integer;

begin
  Valor:= ValorInicial;
  for J:= 1 to NP do begin
    NrDias:= DaysBetween(SomarDia(DataVencto, Intervalo * (J-1),'S'), DataCalculo);
    Valor:= Valor + RoundTo(ValorVencto / Power(TaxaDiaria(TaxaJuros),NrDias),-2);
  end;
  Result:= RoundTo(Valor,-2);
end;


procedure TtecFinanceira.ArredondaValores(TabCalculo     :TtecQuery;
                                          NP             :TIntegerField;
                                          ValorVencto    :TFloatField;
                                          Arredondamento :Real;
                                          Percorrer      :Boolean = True);
// TabCalculo     : Tabela referente ao calculo Financiamento.
// NP             : Numero de Parcelas em determinada ocorrência.
// ValorVencto    : Dalor vencimento da parcela em questão.
// Arredondamento : Numero de casas a ser arredondado.
// Percorrer      : False quando usado todos os planos.
Var
  I,J             : Integer;
  Pos             : TBookmark;
  ValorArredondado: Real;
  begin
  ValorArredondado:= 0;
  if Percorrer then begin
    Pos:= TabCalculo.GetBookmark;
//    TabCalculo.DisableControls;
    try
      TabCalculo.First;
      for I:= 1 to TabCalculo.RecordCount do begin
        ValorArredondado:= ValorVencto.AsFloat;
//        if (not DiaFixo or (I > 1)) then
          for J:= 1 to NP.AsInteger do 
            if (Arredondamento <> 0) then begin
               ValorArredondado:= Multiplo(ValorVencto.AsFloat,Arredondamento);
//               ValorArredondado:= (Int((ValorVencto.AsFloat * 100) / Power(10,Arredondamento) + 0.99999)
//                                        * Power(10,Arredondamento)) / 100;
//               Break;
            end;
//        end;
        if (ValorArredondado > 0) then begin
          TabCalculo.Edit;
          ValorVencto.AsFloat:= ValorArredondado;
          TabCalculo.Post;
        end;
        TabCalculo.Next;
      end;
    finally
      TabCalculo.GotoBookmark(Pos);
      TabCalculo.FreeBookmark(Pos);
//      TabCalculo.EnableControls;
    end;
  end
  else begin
    for J:= 1 to NP.AsInteger do begin
      if (Arredondamento <> 0) then begin
        ValorArredondado:= Multiplo(ValorVencto.AsFloat,Arredondamento);
//        ValorArredondado:= Int(ValorVencto.AsFloat / Power(0.1,Arredondamento) + 0.99999)
//                               * Power(0.1,Arredondamento);
        Break;
      end;
    end;
    if (ValorArredondado > 0) then begin
      TabCalculo.Edit;
      ValorVencto.AsFloat:= ValorArredondado;
      TabCalculo.Post;
    end;
  end;
end;

procedure TtecFinanceira.LerParametros;
begin
    DiasAtraso1       := ParSistema.DiasAtraso1;
    DiasAtraso2       := ParSistema.DiasAtraso2;
    PercentualMultas1 := ParSistema.PercentualAtrasoMultas1;
    PercentualMultas2 := ParSistema.PercentualAtrasoMultas2;
    TaxaJuros1        := ParSistema.PercentualAtrasoJuros1;
    TaxaJuros2        := ParSistema.PercentualAtrasoJuros2;
    Juros             := ParSistema.TaxaJuros;
    JurosSimples      := ParSistema.UtilizarJurosSimples;
    Descontos         := ParSistema.DescontoPagAntecipado;
end;

