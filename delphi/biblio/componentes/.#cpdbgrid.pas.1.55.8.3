function TtecDBGrid.ListadeCampos(Grid: TtecDBGrid): TStringList;
var i: integer;
  vLista : TStringList;
  v_nCol : integer;
begin
  vLista := tStringList.create;
  i:=0;

  v_nCol := 1;
  if (dgIndicator in Options) then
    v_nCol := 2;

  for i:=0 to (grid.ColCount - v_nCol) do
  begin
    if grid.Columns[i].Visible then
      if grid.Columns[i].fieldname <> '' then
        vLista.append(grid.Columns[i].fieldname);
  end;
  result := vLista;
end;

