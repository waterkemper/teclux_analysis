function TtecDBGrid.ColumnByName(const ColumnName: String): TColumn;
var
 i: integer;
 CampoExistente, mensagemexibida: Boolean;

 procedure mensagemdeerro;
 begin
   MensagemErro('O campo '+quotedstr(ColumnName)+' da tabela '+quotedstr(self.DataSource.DataSet.Name)+' não existe.'+#10#13+
                'Por favor! entre em contato com o suporte.' );
 end;

begin
  CampoExistente := false;
  mensagemexibida := false;
  for i:=0 to self.ColCount-1 do
  begin
    try
      if self.Columns[i].FieldName = ColumnName then
      begin
        result := self.Columns[i];
        CampoExistente := true;
        break;
      end;
    except
      MensagemdeErro;
      mensagemexibida := false;
    end;
  end;

  if not CampoExistente and not mensagemexibida then
  begin
    MensagemdeErro;
    abort;
  end;
end;



