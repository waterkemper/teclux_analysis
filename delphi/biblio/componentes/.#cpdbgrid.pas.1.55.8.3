function TtecDBGrid.GetSTDdefaultRowHeight: integer;
var CanvFont:TFont;
begin
   CanvFont:=Canvas.font;
   try
     Canvas.Font := Font;
     REsult := Canvas.TextHeight('Wg') + 3;
     if dgRowLines in Options then
       Inc(REsult, GridLineWidth);
   finally
     Canvas.font:=CanvFont;
   end;
end;

