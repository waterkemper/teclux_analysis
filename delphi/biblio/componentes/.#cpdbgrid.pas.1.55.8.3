type

{ TtecMemoEditor }

  TtecMemoEditor = class(TCustomForm)
  private
    FMemo: TDBMemo;
    FFieldSource: TDataSource;
  public
    constructor CreateNew(AOwner: TComponent; Dummy: Integer = 0); override;
    destructor Destroy; override;
    property MemoField: TDBMemo read FMemo;
  end;


constructor TtecMemoEditor.CreateNew(AOwner: TComponent; Dummy: Integer);
begin
  inherited;
  BorderStyle := bsSizeToolWin;
  FFieldSource := TDataSource.Create(Self);
  FFieldSource.DataSet := TtecDBGrid(AOwner).DataSource.DataSet;
  FMemo := TDBMemo.Create(Self);
  FMemo.DataSource := FFieldSource;
  FMemo.Parent := Self;
  FMemo.Align := alClient;
  FMemo.Visible := True;
end;

destructor TtecMemoEditor.Destroy;
begin
  FFieldSource.Free;
  FMemo.Free;
  inherited;
end;

{ TtecDBGrid }

procedure TtecDBGrid.SetDoubleRowColor(const Value: Boolean);
begin
  if FDoubleRowColor <> Value then
  begin
    FDoubleRowColor := Value;
    Invalidate;
  end;
end;

function TtecDBGrid.GetCheckImage(F: TField): TBitmap;
begin
  if F.IsNull then
    Result := FCheckImages[0].Bitmap
  else
  if F.Value then
    Result := FCheckImages[2].Bitmap
  else
    Result := FCheckImages[1].Bitmap;
end;

constructor TtecDBGrid.Create(AOwner: TComponent);
begin
  inherited;
  parent := TWinControl(AOwner);
  FRowWrap := 60;
  FInCheckTitle:=false;
  FCheckTitle:=true;
  FTitleMinHeight:=100;
  FFixedCols:=0;
  FCellHeights:=100;
  FStrippedRows:=0;
  FStrippedColor:=$00F4F7F4;
  FLines3dV:=c3dNONE;
  Font.Size := 7;
  TitleFont.Size := 7;
  TGrid(self).DefaultRowHeight := 50;

  FDataLink              := TFieldDataLink.Create;
  FDataLink.Control      := Self;
//  FDataLink.OnDataChange := DataChange;
//  FDataLink.OnUpdateData := UpdateData;



end;

procedure TtecDBGrid.Loaded;
var
  cnt: Integer;
begin
  inherited;
  CellHeights:=cellHeights;

  FCheckValues[0] := 'NULL';
  FCheckValues[1] := 'FALSE';
  FCheckValues[2] := 'TRUE';
  for cnt := 0 to High(FCheckImages) do
  begin
    FCheckImages[cnt] := TPicture.Create;
    FCheckImages[cnt].Bitmap.LoadFromResourceName(HInstance, FCheckValues[cnt]);
  end;
  for cnt := 0 to Columns.Count - 1 do
    if Assigned(Columns.Items[cnt].Field) then
      if (Columns.Items[cnt].Field.DataType in [ftGraphic, ftMemo]) then
       begin
         FLargeRows := True;
         Break;
       end;
end;

procedure TtecDBGrid.DrawColumnCell(const Rect: TRect; DataCol: Integer;
  Column: TColumn; State: TGridDrawState);

Const
 CtrlState : array[Boolean] of Integer = (DFCS_BUTTONCHECK,DFCS_BUTTONCHECK or DFCS_CHECKED);

var
  CheckBoxRectangle : TRect;
  Text: WideString;
  R: TRect;
  vcorAnterior : Tcolor;

begin
  inherited;

    if not (csDesigning in ComponentState) then
    begin

//    if not (csDesigning in ComponentState) then
      if ExibirNumerodaLinha {and (Column.Index = 0)} then
      begin
//        Canvas.Font.Color := clBlack;
        vcorAnterior := Canvas.Brush.Color;
        canvas.Brush.Color := clbtnface;
//        FixedColor := clbtnface;
        Canvas.TextOut(self.Left -1 {+ 2}, Rect.Top+1, Inttostr(datasource.dataset.recno)+' '); // linha atual
//        Canvas.FillRect(Rect);

//        DefaultDrawColumnCell(Rect, DataCol, Column, State);
        canvas.Brush.Color :=vcorAnterior;

      end;
    
     if FDoubleRowColor then
     begin
        if (datasource.dataset.recno MOD 2)<>0 then
        begin
          if not (gdSelected in State) then
          begin
            if (Canvas.Brush.Color = clwindow) or {(Canvas.Brush.Color = clbtnface) or}
               (TColorRef(Canvas.Brush.Color) = TColorRef(strtoint(parsistema.CorZebradoRelatorio))) then
            begin
              Canvas.Brush.Color := TColorRef(strtoint(parsistema.CorZebradoRelatorio));
              {
              if FixedCols<>0 then
                FixedColor := TColorRef(strtoint(parsistema.CorZebradoRelatorio))
                }
            end;

            if (Canvas.font.Color = clBlack) or
               (Canvas.font.color = cldefault) then
              Canvas.Font.Color  := clBlack;

            if column.FieldName <> '' then
              DefaultDrawColumnCell(Rect, DataCol, Column, State);
          end
          else
          begin

          end;
        end;
     end;
{
      if (FDoubleRowColor) then
        if not Odd(DataSource.DataSet.RecNo) then
          if not (gdSelected in State) then
          begin
            if Enabled then
              Canvas.Brush.Color := clActiveMidlight
            else
              Canvas.Brush.Color := clDisabledLight;
            Canvas.FillRect(Rect);
            DefaultDrawDataCell(Rect, Column.Field, State);
          end;
}
      if (FLargeRows) then
      begin
         if DefaultRowHeight <> FRowWrap then
           DefaultRowHeight := FRowWrap;
      end;

      if Assigned(Column.Field) then
          case Column.Field.DataType of
            ftBoolean:
                      begin
                      {
                        Canvas.Pen.Style := psClear;
                        Canvas.FillRect(Rect);
                        Canvas.Draw((Rect.Right + Rect.Left - 10) div 2,
                                    (Rect.Top + Rect.Bottom - 10) div 2,
                                     GetCheckImage(Column.Field));
                                     }



                         Self.Canvas.FillRect(Rect);
                         CheckBoxRectangle.Left := Rect.Left + 2;
                         CheckBoxRectangle.Right := Rect.Right - 2;
                         CheckBoxRectangle.Top := Rect.Top + 2;
                         CheckBoxRectangle.Bottom := Rect.Bottom - 2;
                         DrawFrameControl(Self.Canvas.Handle,
                              CheckBoxRectangle,
                              DFC_BUTTON,
                              CtrlState[Column.Field.AsBoolean]);

                      end;
            ftGraphic:
                      begin
                        Canvas.Pen.Style := psClear;
                        Canvas.FillRect(Rect);
                        with TPicture.Create do
                        begin
                          Assign(Column.Field);
                          Bitmap.TransparentMode := tmFixed;
                          Canvas.StretchDraw(Rect, Bitmap);
                          Free;
                        end;
                      end;
               ftMemo:
                      begin
                        Column.ButtonStyle := cbsEllipsis;
                        Canvas.Pen.Style := psClear;
                        Canvas.FillRect(Rect);
                        Text := Column.field.Value;
                        { CLX_TO_VCL
                        QPainter_drawText(Canvas.Handle, @Rect,
                                          Ord(AlignmentFlags_WordBreak) ,
                                          PWideString(@Text), -1, nil, nil);

                         DrawText(Canvas.Handle, @Rect,
                                          Ord(AlignmentFlags_WordBreak) ,
                                          PWideString(@Text), -1, nil, nil);
                         }


                      end;
               ftString:
                      begin
                        if (Column.Field.FieldKind <> fklookup) then
                          if FLarge then
                          begin
                            with self do
                            begin
//                              if DataCol = 1 then { Verifica se é a 2ª coluna}
                              begin

                               CopyRect(R, Rect);
                                Canvas.FillRect(Rect);
                               { Ajusta limite para Quebrar o texto, neste caso, verifica a largura da coluna}
                               R.Right := R.BottomRight.X;
                               { desenha o texto na "área" determinada em "R" }
                               DrawText(Canvas.Handle, PChar(Column.Field.AsString), StrLen(PChar(Column.Field.AsString)), R,
                               AlignFlags[Column.alignment] );
                              end;
                            end;
{


                            self.Canvas.FillRect(Rect);
                            if Column.field.AsString<>'' then
                              Text := Column.field.Value
                            else Text := '';
                            }

//                          Self.Canvas.FillRect(Rect);

                          CheckBoxRectangle := Rect;

//                          Dec(CheckBoxRectangle.Bottom,0);

                          self.Canvas.Font.Color := clBlack;

                          DrawText(Handle,
                                   PChar(Text), length(Text), CheckBoxRectangle, DT_WORDBREAK or DT_LEFT  or DT_NOPREFIX);

      //DrawText(Acanvas.Handle, PChar(Text), Length(Text), DREct,
        // AlignFlags[Alignment] or RTL[ARightToLeft] or dt_WORDBREAK or DT_CALCRECT);




                        { CLX_TO_VCL
                            QPainter_drawText(Canvas.Handle, @Rect,
                                              Ord(AlignmentFlags_WordBreak) ,
                                              PWideString(@Text), -1, nil, nil);
                        }                      
                          end;
                      end;
      end;
    end
    else
      DefaultDrawDataCell(Rect, Column.Field, State);


end;

function TtecDBGrid.CanEditShow: Boolean;
var
  Rect: TRect;
  {CheckBoxRectangle : TRect;}

begin
  if Assigned(SelectedField) then
  begin
    Rect := CellRect(Col, Row);
    case SelectedField.DataType of
      ftBoolean:
                begin
                  Result := False;
                  Canvas.Draw((Rect.Right + Rect.Left - 10) div 2,
                              (Rect.Top + Rect.Bottom - 10) div 2,
                              GetCheckImage(SelectedField)
                             );

{
                         Self.Canvas.FillRect(Rect);
                         CheckBoxRectangle.Left := Rect.Left + 2;
                         CheckBoxRectangle.Right := Rect.Right - 2;
                         CheckBoxRectangle.Top := Rect.Top + 2;
                         CheckBoxRectangle.Bottom := Rect.Bottom - 2;
                         DrawFrameControl(Self.Canvas.Handle,
                              CheckBoxRectangle,
                              DFC_BUTTON,
                              CtrlState[Column.Field.AsBoolean]);
}


                end;
      ftGraphic: Result := False;
    else
      Result := inherited CanEditShow;
    end;
  end
  else
     Result := inherited CanEditShow;
end;

procedure TtecDBGrid.EditButtonClick;
var
  Rect: TRect;
begin
  inherited;
  if Assigned(SelectedField) then
  begin
    case SelectedField.DataType of
     ftMemo: with TtecMemoEditor.CreateNew(Self) do
             begin
               Rect := CellRect(Col, Row);
               MemoField.DataField := SelectedField.FieldName;
               Left := Rect.Left;
               Top := Rect.Bottom;
               ShowModal;
               Free;
             end;
    else
     with TtecMemoEditor.CreateNew(Self) do
     begin
       Rect := CellRect(Col, Row);
       MemoField.DataField := SelectedField.FieldName;
       Left := Rect.Left;
       Top := Rect.Bottom;
       ShowModal;
       SelectedField.Text :=  MemoField.Text;
       Free;

     end;
    end;
  end;
  
end;

procedure TtecDBGrid.DoEnter;
begin
  if (dgEditing in Options) then
  begin
    if EditorMode then
      EditorMode := False;
    SetFocus;
  end;
 inherited;
end;

procedure TtecDBGrid.KeyDown(var Key: Word; Shift: TShiftState);
var
  KeyDownEvent: TKeyEvent;
//  vSalvarArquivoXLS : TSaveDialog;
  vExcelExport : TExcelExport;
  vcontrolsDisabled: Boolean;
  RegistroAtual: TbookMark;
  i: integer;
  vGrid, vGridVerificacao :TtecDBGrid;
begin
  if (CtrlOn or (Shift = [ssCtrl])) and (key = VK_X) then
  begin
//    vSalvarArquivoXLS := TSaveDialog.create(nil);
//    vSalvarArquivoXLS.filter := '*.xls';
//    if vSalvarArquivoXLS.execute then
    begin
      if (GridAssociado = nil) and (DataSourceAssociado = nil) then
      begin
        if (MensagemConfirmacao('Os dados desta grade serão exportados para o Excel. Confirma?') = smbOk) then
        begin
          try
            RegistroAtual := TtecQuery(DataSource.DataSet).GetBookmark;
            vExcelExport := TExcelExport.create(nil);
            vExcelExport.StyleColumnWidth := cwAutoFit;
            vcontrolsDisabled := dataSource.dataset.ControlsDisabled;
            {
            if not vcontrolsDisabled then
              datasource.dataset.DisableControls;
              }


            vExcelExport.Dataset := self.dataSource.dataset;
            vExcelExport.ExportDataset(ListadeCampos(self), ListadeTitulos(self));

            if not vcontrolsDisabled then
              datasource.dataset.enableControls;

          finally
            vExcelExport.free;
            TtecQuery(DataSource.DataSet).GotoBookmark(RegistroAtual);
            TtecQuery(DataSource.DataSet).FreeBookmark(RegistroAtual);
            if assigned(OnFinalizeOperation) then
              OnFinalizeOperation;
          end;
        end;
      end
      else
      begin
        if (MensagemConfirmacao('Os dados desta grade e associadas serão exportados para o Excel. Confirma?') = smbOk) then
        begin
          try

            RegistroAtual := TtecQuery(DataSource.DataSet).GetBookmark;
            vExcelExport := TExcelExport.create(nil);
            vExcelExport.StyleColumnWidth := cwAutoFit;
//            vcontrolsDisabled := dataSource.dataset.ControlsDisabled;

            {
            if not vcontrolsDisabled then
              datasource.dataset.DisableControls;
              }


            i:= 0;
            vGrid := self;
            vGridVerificacao := self;

            while true do
            begin
            //  vgrid.dataSource.dataset.DisableControls;
              vExcelExport.DataSets[i] := vgrid.dataSource.dataset;
              vExcelExport.lstCampos[i] := vGrid.listadeCampos(vGrid);
              vExcelExport.lstTitulos[i] := vGrid.listadeTitulos(vGrid);

              if vgrid.DataSourceAssociado <> nil then
              begin
                i := i + 1;
              //  vgrid.dataSourceAssociado.dataset.DisableControls;
                vExcelExport.DataSets[i] := vgrid.dataSourceAssociado.dataset;
                vExcelExport.lstCampos[i] := vGrid.listadeCampostabela(vgrid.dataSourceAssociado.dataset);
                vExcelExport.lstTitulos[i] := vGrid.listadeTitulosTabela(vgrid.dataSourceAssociado.dataset);
              end;

              if (vgrid.gridassociado = nil) or (vGrid.gridAssociado = vGridVerificacao) then
                break
              else
              begin
//                vGridVerificacao := vGrid;
                vGrid := vgrid.gridassociado;
              end;

              i := i + 1;
            end;

            vExcelExport.ExportDatasets;

//            if not vcontrolsDisabled then
//              datasource.dataset.enableControls;

          finally

            vExcelExport.free;
            TtecQuery(DataSource.DataSet).GotoBookmark(RegistroAtual);
            TtecQuery(DataSource.DataSet).FreeBookmark(RegistroAtual);

            (*
            i:= 0;
            vGrid := self;
            vGridVerificacao := self;

            while true do
            begin
              vgrid.dataSource.dataset.enableControls;

              if vgrid.DataSourceAssociado <> nil then
                vgrid.dataSourceAssociado.dataset.enableControls;

              if (vgrid.gridassociado = nil)  or (vGrid.gridAssociado = vGridVerificacao) then
                break
              else
              begin
//                vGridVerificacao := vGrid;
                vGrid := vgrid.gridassociado;
              end;

              i := i + 1;
            end;

//            GridAssociado := nil;
            *)

            if assigned(OnFinalizeOperation) then
              OnFinalizeOperation;

          end;
        end;

      end;
    end;

  end
  else
  case Key of
  {
    vk_space  :
    begin
      case self.Columns[Selectedindex].Field.DataType of
        ftBoolean : begin
                      self.Columns[Selectedindex].Field.AsBoolean := not self.Columns[Selectedindex].Field.AsBoolean;
                      key := 0;
                    end;
      end;
    end;
  }
    VK_Delete : begin
                 if (DataLink.DataSet.RecordCount > 0) and
                   (Not TZDataset(DataLink.DataSet).ReadOnly) and
                   (Not ReadOnly) then
                 begin
                   if (Shift = [ssCtrl]) and
                      (not (TZDataset(DataLink.DataSet).State in [dsedit, dsinsert])) then
                   begin
                     if assigned(fOnDelete) then
                       fOnDelete
                     else
                     if CanDelete then
                     begin
                       if (dgConfirmDelete in Options) then
                       begin
                         if (MensagemConfirmacao(Format(ctCONFIRMEEXCLUIR, [MsgDelete])) = smbOk) then
                         begin
                           DataLink.DataSet.Delete;
                           SetFocus;
                         end;
                       end
                       else
                       begin
                         DataLink.DataSet.Delete;
                         SetFocus;
                       end;
                     end;
                   end
                   else
                   begin
                    if not self.Columns[Selectedindex].Field.ReadOnly and
                       not self.Columns[Selectedindex].readonly then
                    begin
                      DataLink.DataSet.Edit;
                      self.Columns[Selectedindex].Field.Clear;
                      inherited KeyDown(Key, Shift);
                    end;
                   end;
                 end;
    end;
  else
//    CloseHint;

    KeyDownEvent := OnKeyDown;
    if Assigned(KeyDownEvent) then
      KeyDownEvent(Self, Key, Shift);

    if not Datalink.Active or not CanGridAcceptKey(Key, Shift) then
      Exit;

    with Datalink.DataSet do
      if ssCtrl in Shift then begin
        case Key of
//          {$ifndef LINUX} vk_LEFT {$else}VK_LEFT{$endif}:
        VK_LEFT:
            if FixedCols > 0 then begin
              SelectedIndex := CalcLeftColumn - IndicatorOffset;
              Exit;
            end;
        end
      end
      else begin
        case Key of
          vk_space  :
          begin
            case self.Columns[Selectedindex].Field.DataType of
              ftBoolean : begin
                            SaveBoolean();
                            //self.Columns[Selectedindex].Field.AsBoolean := not self.Columns[Selectedindex].Field.AsBoolean;
                            key := 0;
                          end;
            end;
          end;

          VK_LEFT:
//          {$ifndef LINUX} vk_LEFT {$else}VK_LEFT{$endif}:
            if (FixedCols > 0) and not (dgRowSelect in Options) then begin
              if SelectedIndex <= CalcLeftColumn - IndicatorOffset then
                Exit;
            end;
//          {$ifndef LINUX} vk_HOME {$else}VK_HOME{$endif}:
          VK_HOME:
            if (FixedCols > 0) and (ColCount <> IndicatorOffset + 1) and
              not (dgRowSelect in Options) then
            begin
              SelectedIndex := CalcLeftColumn - IndicatorOffset;
              Exit;
            end;
        else
          case key of
            VK_TAB: begin
                      if State in [dsedit,dsinsert] then
                      begin
                        if (self.Columns[SelectedIndex].Field.Required) and
                           (self.Columns[SelectedIndex].Field.IsNull) then
                          key :=0
                        else
                        begin
                          if EditandoCelula then
                          begin
                            key := VK_Return;
                            if PostOnEnter then
                              EditandoCelula := false;
                            inherited KeyDown(Key, Shift);

                            key := VK_TAB;
                            inherited KeyDown(Key, Shift);

                          end
                          else
                            key := 0;
                            
//                          if PostOnEnter then
//                             post;
//                          SelectedIndex := SelectedIndex + 1;
//                          inherited KeyDown(Key, Shift);

{                          if Assigned(KeyDownEvent) then
                            KeyDownEvent(Self, Key, Shift);}
{                          inherited KeyDown(Key, Shift);
                          key := VK_TAB;
                          inherited KeyDown(Key, Shift);}
                        end;
                      end
                      else
                      begin
                        if CanNotInsertFromGrid and
                           (recno = recordcount) then
                        begin
//                          cancel;
                          edit;
                          key := 0;
                        end;

{                        key := VK_Enter;
                        if State in [dsedit,dsinsert] then
                          if PostOnEnter then
                             post;}
//                        SelectedIndex := SelectedIndex - 1;
//                        key := VK_TAB;
//                        inherited KeyDown(Key, Shift);
                      end;
                    end;
            VK_UP,
            VK_DOWN : begin
                         if (State in [dsedit,dsinsert]) and postonsetUpDown and not CanNotInsertFromGrid then
                         begin
                           if Assigned(onpost) then
                             fonpost
                           else
                             post;
                         end
                         else
                         if (State in [dsedit, dsinsert]) and not postonsetUpDown and CanClickWhenEditing then
                           key := 0
                         else
                         if (State in [dsedit]) and postonsetUpDown then
                         begin
                           if Assigned(onpost) then
                             fonpost
                           else
                             post;
                         end
                         else
                         if (CanNotInsertFromGrid and
                             (recno = recordcount) and
                             (key = VK_DOWN)) then
                           key := 0
                         else
                         begin
                           if (Shift = [ssAlt]) then
                           begin
                             case key of
                               VK_UP : DeslocarRegistroParaCima;
                               VK_DOWN : DeslocarRegistroParaBaixo;
                             end;
                             key := 0;
                           end;
                         end;
                       end;
            VK_PRIOR,
            VK_NEXT: begin
                            if State in [dsedit,dsinsert] then
                              key :=0
                          end;
            VK_Return: begin
                            if State in [dsedit,dsinsert] then
                              if PostOnEnter then
                              begin
                                if Assigned(onpost) then
                                  fonpost
                                else
                                 post;
                              end;
                        end;
          end;
        end
      end;
     OnKeyDown := nil;

    try
      inherited KeyDown(Key, Shift);
    finally
      OnKeyDown := KeyDownEvent;
    end;
  end;

end;


